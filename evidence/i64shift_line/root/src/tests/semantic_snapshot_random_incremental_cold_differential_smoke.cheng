const
    DifferentialSeed: int64 = 8420731
    DifferentialSeedCount: int32 = 30
    DifferentialTransitionCount: int32 = 30
    DifferentialDocumentCountN: int32 = 4
    DifferentialEventOpen: int32 = 1
    DifferentialEventChange: int32 = 2
    DifferentialEventClose: int32 = 3
    DifferentialCategoryInitial: int32 = 1
    DifferentialCategorySameNameSameArity: int32 = 2
    DifferentialCategoryBody: int32 = 3
    DifferentialCategorySignature: int32 = 4
    DifferentialCategoryImportCall: int32 = 5
    DifferentialCategoryDelete: int32 = 6
    DifferentialCategoryReopen: int32 = 7
    DifferentialCategoryInvalid: int32 = 8
    DifferentialCategoryRepair: int32 = 9
    DifferentialCategoryRename: int32 = 10
    DifferentialCategoryAdd: int32 = 11

type
    DifferentialEditEvent =
        eventKind: int32
        category: int32
        documentIndex: int32
        clientVersion: int64
        valid: bool
        text: str

    DifferentialColdCsgReceipt =
        sourceBundleCid: layout.FixedBytes32
        canonicalGraphCid: layout.FixedBytes32
        predecessorReceiptCid: layout.FixedBytes32
        admissionReceiptCid: layout.FixedBytes32
        missingFactBitmap: int32
        admissionBlocked: bool
        cidTamperRejected: bool
        dependencyTamperApplicable: bool
        dependencyTamperRejected: bool
        admissionDependencyProofTamperRejected: bool

fn RequiredCidEnv(name: str): layout.FixedBytes32 =
    let raw = os.GetEnv(name)
    let parsed = layout.FixedBytes32FromHex(raw)
    assert(IsOk(parsed), Fmt"semantic snapshot differential: invalid CID env {name}")
    let cid = Value(parsed)
    assert(!layout.FixedBytes32Equal(cid, layout.FixedBytes32()),
           Fmt"semantic snapshot differential: zero CID env {name}")
    return cid

fn CurrentExecution(): execution.CompilerExecutionIdentity =
    let identity = execution.CompilerExecutionIdentityMake(
        "semantic-snapshot-random-incremental-cold-differential",
        RequiredCidEnv("CHENG_SNAPSHOT_DIFF_COMPILER_SOURCE_BUNDLE_CID"),
        RequiredCidEnv("CHENG_SNAPSHOT_DIFF_MATERIALIZER_CID"),
        RequiredCidEnv("CHENG_SNAPSHOT_DIFF_GRAMMAR_CID"),
        RequiredCidEnv("CHENG_SNAPSHOT_DIFF_COMPILER_SOURCE_CLOSURE_CID"),
        RequiredCidEnv("CHENG_SNAPSHOT_DIFF_DRIVER_CID"),
        RequiredCidEnv("CHENG_SNAPSHOT_DIFF_TOOLCHAIN_CID"),
        RequiredCidEnv("CHENG_SNAPSHOT_DIFF_COMMAND_CID"),
        "arm64-apple-darwin")
    assert(IsOk(identity), Error(identity))
    return Value(identity)

fn CurrentUniverse(
        compilerExecution: execution.CompilerExecutionIdentity):
        compiler_world.CompilerLocalUniverse =
    var universe: compiler_world.CompilerLocalUniverse
    var noExtraEntries: compiler_world.CompilerUniverseManifestEntry[]
    var err: str
    assert(compiler_world.CompilerLocalUniverseBuildForChannelWithManifestEntriesInto(
               universe,
               err,
               "stable",
               compilerExecution.sourceBundleRaw32,
               RequiredCidEnv("CHENG_SNAPSHOT_DIFF_COMPILER_CSG_ROOT_CID"),
               RequiredCidEnv("CHENG_SNAPSHOT_DIFF_COMPILER_EXPORT_SURFACE_CID"),
               layout.FixedBytes32(),
               noExtraEntries), err)
    return universe

fn NextRandom(state: var int64): int32 =
    state = (state * int64(48271)) % int64(2147483647)
    return Int32(state)

fn HelperTextNamed(
        bodyValue: int32,
        boolOverload: bool,
        functionName: str,
        dependentName: str,
        includeMain: bool): str =
    var secondType = "str"
    if boolOverload:
        secondType = "bool"
    var out = strutil.Join([
        Fmt"fn {functionName}(value: int32): int32 =\n",
        Fmt"    return value + {bodyValue}\n\n",
        Fmt"fn TextValue(value: {secondType}): int32 =\n",
        "    return 2\n\n",
        "fn Shared(): int32 =\n",
        Fmt"    return {bodyValue}\n",
    ], "")
    if includeMain:
        out = strutil.Join([
            out,
            "\nfn Main(): int32 =\n",
            Fmt"    return {dependentName}(7)\n",
        ], "")
    return out

fn MainTextNamed(
        useAlternate: bool,
        invalid: bool,
        selectedFunctionName: str): str =
    let importAlias = "helper"
    var selectedFunction = selectedFunctionName
    if useAlternate:
        selectedFunction = "Shared"
    var callLine = "    return 7\n"
    if selectedFunction == "Shared":
        callLine = Fmt"    let selectedValue = {importAlias}.{selectedFunction}()\n    return selectedValue\n"
    else:
        callLine = Fmt"    let selectedValue = {importAlias}.{selectedFunction}(7)\n    return selectedValue\n"
    if invalid:
        callLine = Fmt"    let selectedValue = {importAlias}.{selectedFunction}())\n    return selectedValue\n"
    return strutil.Join([
        "import pkg/helper\n\n",
        "fn Main(): int32 =\n",
        callLine,
    ], "")

fn BridgeText(functionName: str, invalid: bool): str =
    var callLine =
        Fmt"    return helper.{functionName}(value)\n"
    if invalid:
        callLine =
            Fmt"    return helper.{functionName}(value))\n"
    return strutil.Join([
        "import pkg/helper\n\n",
        "fn Forward(value: int32): int32 =\n",
        callLine,
    ], "")

fn ExtraText(bodyValue: int32): str =
    return strutil.Join([
        "fn Extra(): int32 =\n",
        Fmt"    return {bodyValue}\n",
    ], "")

fn NMainText(useAlternate: bool, invalid: bool): str =
    var callLine = strutil.Join([
        "    let forwarded = bridge.Forward(7)\n",
        "    let extraValue = extra.Extra()\n",
        "    return forwarded + extraValue\n",
    ], "")
    if useAlternate:
        callLine = strutil.Join([
            "    let forwarded = bridge.Forward(9)\n",
            "    let extraValue = extra.Extra()\n",
            "    return forwarded + extraValue\n",
        ], "")
    if invalid:
        callLine = strutil.Join([
            "    let forwarded = bridge.Forward(9))\n",
            "    let extraValue = extra.Extra()\n",
            "    return forwarded + extraValue\n",
        ], "")
    return strutil.Join([
        "import pkg/bridge\n",
        "import pkg/extra\n\n",
        "fn Main(): int32 =\n",
        callLine,
    ], "")

fn DocumentCountForSeed(seedIndex: int32): int32 =
    if seedIndex < 10:
        return 1
    if seedIndex < 20:
        return 2
    return DifferentialDocumentCountN

fn SeedValue(seedIndex: int32): int64 =
    return DifferentialSeed + int64(seedIndex) * int64(104729)

fn ScheduleDocumentText(
        documentCount: int32,
        documentIndex: int32,
        bodyValue: int32,
        boolOverload: bool,
        functionName: str,
        dependentName: str,
        useAlternate: bool,
        invalid: bool): str =
    if documentCount == 1:
        return HelperTextNamed(
            bodyValue, boolOverload, functionName,
            dependentName, true)
    if documentIndex == 0:
        return HelperTextNamed(
            bodyValue, boolOverload, functionName,
            functionName, false)
    if documentCount == 2:
        return MainTextNamed(
            useAlternate, invalid, dependentName)
    if documentIndex == 1:
        return BridgeText(dependentName, invalid)
    if documentIndex == 2:
        return ExtraText(bodyValue + 100)
    return NMainText(useAlternate, invalid)

fn AppendScheduleEvent(
        events: var DifferentialEditEvent[],
        eventKind: int32,
        category: int32,
        documentIndex: int32,
        clientVersions: var int64[],
        valid: bool,
        text: str) =
    var event: DifferentialEditEvent
    event.eventKind = eventKind
    event.category = category
    event.documentIndex = documentIndex
    if eventKind == DifferentialEventClose:
        event.clientVersion = clientVersions[documentIndex]
    else:
        clientVersions[documentIndex] =
            clientVersions[documentIndex] + int64(1)
        event.clientVersion = clientVersions[documentIndex]
    event.valid = valid
    event.text = text
    add(events, event)

fn BuildSchedule(seedIndex: int32): DifferentialEditEvent[] =
    let documentCount = DocumentCountForSeed(seedIndex)
    let seed = SeedValue(seedIndex)
    var randomState = seed
    var bodyValue = 3 + NextRandom(randomState) % 17
    var boolOverload: bool
    var functionName = "Resolve"
    var dependentName = "Resolve"
    var useAlternate: bool
    var events: DifferentialEditEvent[]
    var clientVersions: int64[]
    setLen(clientVersions, documentCount)
    for documentIndex in 0..<documentCount:
        var category = DifferentialCategoryAdd
        if documentIndex == 0:
            category = DifferentialCategorySameNameSameArity
        elif documentIndex == documentCount - 1:
            category = DifferentialCategoryInitial
        AppendScheduleEvent(
            events, DifferentialEventOpen, category,
            documentIndex, clientVersions, true,
            ScheduleDocumentText(
                documentCount, documentIndex, bodyValue,
                boolOverload, functionName, dependentName,
                useAlternate, false))
    var cycle: int32
    while events.len < DifferentialTransitionCount:
        let phase = cycle % 9
        let dependencyDocument = documentCount == 1 ? 0 : 1
        let entryDocument = documentCount - 1
        let removableDocument =
            documentCount == DifferentialDocumentCountN ? 2 : 0
        if phase == 0:
            bodyValue = bodyValue + 1 + NextRandom(randomState) % 13
            AppendScheduleEvent(
                events, DifferentialEventChange,
                DifferentialCategoryBody, 0, clientVersions, true,
                ScheduleDocumentText(
                    documentCount, 0, bodyValue, boolOverload,
                    functionName, dependentName, useAlternate, false))
        elif phase == 1:
            boolOverload = !boolOverload
            AppendScheduleEvent(
                events, DifferentialEventChange,
                DifferentialCategorySignature, 0,
                clientVersions, true,
                ScheduleDocumentText(
                    documentCount, 0, bodyValue, boolOverload,
                    functionName, dependentName, useAlternate, false))
        elif phase == 2:
            useAlternate = !useAlternate
            AppendScheduleEvent(
                events, DifferentialEventChange,
                DifferentialCategoryImportCall, entryDocument,
                clientVersions, true,
                ScheduleDocumentText(
                    documentCount, entryDocument, bodyValue,
                    boolOverload, functionName, dependentName,
                    useAlternate, false))
        elif phase == 3:
            functionName =
                functionName == "Resolve" ? "Compute" : "Resolve"
            AppendScheduleEvent(
                events, DifferentialEventChange,
                DifferentialCategoryRename, 0,
                clientVersions, false,
                ScheduleDocumentText(
                    documentCount, 0, bodyValue, boolOverload,
                    functionName, dependentName, useAlternate, false))
        elif phase == 4:
            dependentName = functionName
            AppendScheduleEvent(
                events, DifferentialEventChange,
                DifferentialCategoryRepair, dependencyDocument,
                clientVersions, true,
                ScheduleDocumentText(
                    documentCount, dependencyDocument, bodyValue,
                    boolOverload, functionName, dependentName,
                    useAlternate, false))
        elif phase == 5:
            AppendScheduleEvent(
                events, DifferentialEventClose,
                DifferentialCategoryDelete, removableDocument,
                clientVersions, false, "")
        elif phase == 6:
            bodyValue = bodyValue + 1 + NextRandom(randomState) % 17
            AppendScheduleEvent(
                events, DifferentialEventOpen,
                DifferentialCategoryReopen, removableDocument,
                clientVersions, true,
                ScheduleDocumentText(
                    documentCount, removableDocument, bodyValue,
                    boolOverload, functionName, dependentName,
                    useAlternate, false))
        elif phase == 7:
            AppendScheduleEvent(
                events, DifferentialEventChange,
                DifferentialCategoryInvalid, entryDocument,
                clientVersions, false,
                ScheduleDocumentText(
                    documentCount, entryDocument, bodyValue,
                    boolOverload, functionName, dependentName,
                    useAlternate, true))
        else:
            AppendScheduleEvent(
                events, DifferentialEventChange,
                DifferentialCategoryRepair, entryDocument,
                clientVersions, true,
                ScheduleDocumentText(
                    documentCount, entryDocument, bodyValue,
                    boolOverload, functionName, dependentName,
                    useAlternate, false))
        cycle = cycle + 1
    return events

fn AppendTranscriptText(out: var layout.ByteBuf, value: str) =
    layout.ByteBufAppendByte(out, (value.len >> 24) & 255)
    layout.ByteBufAppendByte(out, (value.len >> 16) & 255)
    layout.ByteBufAppendByte(out, (value.len >> 8) & 255)
    layout.ByteBufAppendByte(out, value.len & 255)
    for index in 0..<value.len:
        layout.ByteBufAppendByte(out, Int32(value[index]) & 255)

fn ScheduleCid(seed: int64, events: DifferentialEditEvent[]):
        layout.FixedBytes32 =
    var bytes = layout.ByteBufInit(4096)
    AppendTranscriptText(
        bytes, "cheng.semantic_snapshot.random_incremental_cold_differential")
    AppendTranscriptText(bytes, strings.Int64ToStr(seed))
    AppendTranscriptText(bytes, strings.Int64ToStr(int64(events.len)))
    for index in 0..<events.len:
        let event = events[index]
        AppendTranscriptText(bytes, strings.Int64ToStr(int64(index)))
        AppendTranscriptText(bytes, strings.Int64ToStr(int64(event.eventKind)))
        AppendTranscriptText(bytes, strings.Int64ToStr(int64(event.category)))
        AppendTranscriptText(
            bytes, strings.Int64ToStr(int64(event.documentIndex)))
        AppendTranscriptText(bytes, strings.Int64ToStr(event.clientVersion))
        AppendTranscriptText(bytes, event.valid ? "valid" : "invalid")
        AppendTranscriptText(bytes, event.text)
    let out = hash256.Sha256Fixed(layout.ByteBufView(bytes))
    layout.ByteBufFree(bytes)
    return out

fn ValidateSchedule(
        seedIndex: int32,
        events: DifferentialEditEvent[]) =
    let documentCount = DocumentCountForSeed(seedIndex)
    var categoryCounts: int32[12]
    for index in 0..<events.len:
        let event = events[index]
        assert(event.eventKind >= DifferentialEventOpen &&
               event.eventKind <= DifferentialEventClose &&
               event.category > 0 && event.category < categoryCounts.len &&
               event.documentIndex >= 0 &&
               event.documentIndex < documentCount &&
               event.clientVersion > int64(0),
               "semantic snapshot differential: invalid generated event")
        categoryCounts[event.category] =
            categoryCounts[event.category] + 1
        if event.eventKind != DifferentialEventClose:
            assert(event.text != "",
                   "semantic snapshot differential: generated source absent")
    for category in DifferentialCategorySameNameSameArity..
            DifferentialCategoryRepair:
        assert(categoryCounts[category] > 0,
               Fmt"semantic snapshot differential: category {category} absent")
    assert(categoryCounts[DifferentialCategoryRename] > 0 &&
           events.len == DifferentialTransitionCount,
           "semantic snapshot differential: generated schedule shape drift")
    if documentCount > 1:
        assert(categoryCounts[DifferentialCategoryInitial] == 1,
               "semantic snapshot differential: entry add absent")
    if documentCount == DifferentialDocumentCountN:
        assert(categoryCounts[DifferentialCategoryAdd] == 2,
               "semantic snapshot differential: N-file add coverage absent")
    var invalidCount: int32
    var closeCount: int32
    for eventIndex in 0..<events.len:
        if !events[eventIndex].valid:
            invalidCount = invalidCount + 1
        if events[eventIndex].eventKind == DifferentialEventClose:
            closeCount = closeCount + 1
    assert(invalidCount >= 3 && closeCount >= 2,
           "semantic snapshot differential: rejection/remove coverage absent")

fn CurrentVersionPublished(
        workspace: lsp.LspWorkspace,
        sourceVersion: int64): bool =
    let snapshotIndex = workspace.snapshotStore.core.publishedIndex
    return snapshotIndex >= 0 &&
        snapshotIndex < workspace.snapshotStore.core.states.len &&
        snapshotIndex < workspace.snapshotStore.core.sourceVersions.len &&
        workspace.snapshotStore.core.currentSourceVersion == sourceVersion &&
        workspace.snapshotStore.core.sourceVersions[snapshotIndex] ==
            sourceVersion &&
        workspace.snapshotStore.core.states[snapshotIndex] ==
            snapshot_core.SemanticSnapshotStatePublished

fn CurrentVersionRejected(
        workspace: lsp.LspWorkspace,
        sourceVersion: int64): bool =
    let last = workspace.snapshotStore.core.states.len - 1
    return last >= 0 &&
        last < workspace.snapshotStore.core.sourceVersions.len &&
        workspace.snapshotStore.core.currentSourceVersion == sourceVersion &&
        workspace.snapshotStore.core.sourceVersions[last] == sourceVersion &&
        workspace.snapshotStore.core.states[last] ==
            snapshot_core.SemanticSnapshotStateRejected

fn IsContentModified(ok: bool, err: str): bool =
    return !ok && strings.StrContains(err, "content modified")

fn AllSixContentModified(
        workspace: var lsp.LspWorkspace,
        uri: str): bool =
    var err: str
    var definition: lsp.LspExactDefinitionResult
    if !IsContentModified(
            lsp.LspWorkspaceExactDefinitionInto(
                workspace, uri, 3, 20, definition, err), err):
        return false
    err = ""
    var references: lsp.LspExactReferencesResult
    if !IsContentModified(
            lsp.LspWorkspaceExactReferencesInto(
                workspace, uri, 3, 20, true, references, err), err):
        return false
    err = ""
    var rename: lsp.LspExactRenameResult
    if !IsContentModified(
            lsp.LspWorkspaceExactRenameInto(
                workspace, uri, 3, 20, "ResolveRenamed", rename, err), err):
        return false
    err = ""
    var hover: lsp.LspExactHoverResult
    if !IsContentModified(
            lsp.LspWorkspaceExactHoverInto(
                workspace, uri, 3, 20, hover, err), err):
        return false
    err = ""
    var completion: lsp.LspExactCompletionResult
    if !IsContentModified(
            lsp.LspWorkspaceExactCompletionInto(
                workspace, uri, 3, 18, completion, err), err):
        return false
    err = ""
    var diagnostics: lsp.LspExactDiagnosticsResult
    return IsContentModified(
        lsp.LspWorkspaceExactDiagnosticsInto(
            workspace, uri, diagnostics, err), err)

fn UnpublishedReturnsNoOldSemanticResult(
        workspace: var lsp.LspWorkspace,
        uri: str,
        sourceVersion: int64): bool =
    var err: str
    var definition: lsp.LspExactDefinitionResult
    if !IsContentModified(
            lsp.LspWorkspaceExactDefinitionInto(
                workspace, uri, 3, 20, definition, err), err):
        return false
    err = ""
    var references: lsp.LspExactReferencesResult
    if !IsContentModified(
            lsp.LspWorkspaceExactReferencesInto(
                workspace, uri, 3, 20, true, references, err), err):
        return false
    err = ""
    var rename: lsp.LspExactRenameResult
    if !IsContentModified(
            lsp.LspWorkspaceExactRenameInto(
                workspace, uri, 3, 20,
                "ResolveRenamed", rename, err), err):
        return false
    err = ""
    var hover: lsp.LspExactHoverResult
    if !IsContentModified(
            lsp.LspWorkspaceExactHoverInto(
                workspace, uri, 3, 20, hover, err), err):
        return false
    err = ""
    var completion: lsp.LspExactCompletionResult
    if !IsContentModified(
            lsp.LspWorkspaceExactCompletionInto(
                workspace, uri, 3, 18, completion, err), err):
        return false
    err = ""
    var diagnostics: lsp.LspExactDiagnosticsResult
    if lsp.LspWorkspaceExactDiagnosticsInto(
           workspace, uri, diagnostics, err):
        return diagnostics.receipt.rejected &&
            diagnostics.receipt.sourceVersion == sourceVersion
    return strings.StrContains(err, "content modified")

fn ApplyEvent(
        workspace: var lsp.LspWorkspace,
        event: DifferentialEditEvent,
        uris: str[],
        currentTexts: var str[],
        openStates: var bool[],
        clientVersions: var int64[],
        sourceVersion: var int64,
        err: var str): bool =
    let uri = uris[event.documentIndex]
    if event.eventKind == DifferentialEventOpen:
        if !lsp.LspWorkspaceDidOpenInto(
               workspace, uri, event.clientVersion,
               event.text, sourceVersion, err):
            return false
        currentTexts[event.documentIndex] = event.text
        openStates[event.documentIndex] = true
        clientVersions[event.documentIndex] = event.clientVersion
        return true
    if event.eventKind == DifferentialEventChange:
        var change: lsp.LspContentChange
        change.rangePresent = true
        for byteIndex in 0..<currentTexts[event.documentIndex].len:
            if currentTexts[event.documentIndex][byteIndex] == '\n':
                change.endLine = change.endLine + 1
                change.endCharacter = 0
            else:
                change.endCharacter = change.endCharacter + 1
        change.rangeLengthPresent = false
        change.text = event.text
        if !lsp.LspWorkspaceDidChangeInto(
               workspace, uri, event.clientVersion,
               [change], sourceVersion, err):
            return false
        currentTexts[event.documentIndex] = event.text
        clientVersions[event.documentIndex] = event.clientVersion
        return true
    if event.eventKind == DifferentialEventClose:
        if !lsp.LspWorkspaceDidCloseInto(
               workspace, uri, sourceVersion, err):
            return false
        openStates[event.documentIndex] = false
        return true
    err = "semantic snapshot differential: unknown generated event"
    return false

fn RunSourceHashCacheTamperAttack(
        workspace: var lsp.LspWorkspace,
        uri: str,
        currentText: str,
        attackClientVersion: int64,
        expectedSourceVersion: int64,
        err: var str): bool =
    var documentIndex: int32 = -1
    for index in 0..<workspace.documents.len:
        if workspace.documents[index].uri == uri:
            documentIndex = index
    if documentIndex < 0 ||
       workspace.documents[documentIndex].sourceHashBlockStatesMirror.len <= 0:
        err = "semantic snapshot differential: production source hash cache absent"
        return false
    let originalMirror =
        workspace.documents[documentIndex].sourceHashBlockStatesMirror[0]
    workspace.documents[documentIndex].sourceHashBlockStatesMirror[0] =
        originalMirror ^ int64(1)
    var change: lsp.LspContentChange
    change.rangePresent = true
    for byteIndex in 0..<currentText.len:
        if currentText[byteIndex] == '\n':
            change.endLine = change.endLine + 1
            change.endCharacter = 0
        else:
            change.endCharacter = change.endCharacter + 1
    change.text = currentText
    var attackVersion: int64
    var attackErr: str
    let accepted = lsp.LspWorkspaceDidChangeInto(
        workspace, uri, attackClientVersion,
        [change], attackVersion, attackErr)
    workspace.documents[documentIndex].sourceHashBlockStatesMirror[0] =
        originalMirror
    if accepted || attackVersion != int64(0) ||
       workspace.snapshotStore.core.currentSourceVersion !=
           expectedSourceVersion ||
       !strings.StrContains(attackErr, "cache is corrupt"):
        err = Fmt"semantic snapshot differential: production cache tamper accepted={accepted} attack_version={attackVersion} current_version={workspace.snapshotStore.core.currentSourceVersion} attack_error={attackErr}"
        return false
    err = ""
    return true

fn FirstResolvedCallTypedNodePosition(
        csg: var compiler_csg.CompilerCsg): int32 =
    let calls = csg.semanticGraph.resolvedCallTable
    if calls.sourceIndexes.len <= 0:
        return -1
    let producerSource = calls.sourceIndexes[0]
    let parserNodeId = calls.originParserNodeIds[0]
    let typedFunctionRow = calls.functionIndexes[0]
    if typedFunctionRow < 0 ||
       typedFunctionRow >=
           csg.semanticGraph.typedIrTable.functionNodeStart.len:
        return -1
    let start =
        csg.semanticGraph.typedIrTable.functionNodeStart[
            typedFunctionRow]
    let count =
        csg.semanticGraph.typedIrTable.functionNodeCount[
            typedFunctionRow]
    if csg.semanticGraph.typedIrTable.functionSourceIndexes[
           typedFunctionRow] != producerSource:
        return -1
    for nodePosition in start..<start + count:
        if csg.typedIr.nodes2_opKinds[nodePosition] ==
               texpr.TypedExprIrOpCallExpr &&
           arenamod.ArenaArrayInt32Get(
               csg.typedIr.arena,
               csg.typedIr.nodes2_originParserNodeIds,
               nodePosition) == parserNodeId:
            return nodePosition
    return -1

fn BuildIndependentColdCsgReceipt(
        workspace: var lsp.LspWorkspace,
        workspaceRoot: str,
        sourcePaths: str[],
        modulePaths: str[],
        texts: str[],
        out: var DifferentialColdCsgReceipt,
        err: var str): bool =
    var plan: system_link_plan.SystemLinkPlanStub
    if !system_link_plan.SystemLinkPlanBuildImmutableSourceOverlayInto(
           workspaceRoot, workspaceRoot, "pkg", "arm64-apple-darwin",
           sourcePaths[sourcePaths.len - 1],
           sourcePaths, modulePaths, texts,
           plan, err):
        return false
    var sourceReceipt: compiler_csg.PortableSourceIdentityReceipt
    if !compiler_csg.PortableSourceIdentityReceiptMakeInto(
           plan.sourceClosurePaths.len,
           plan.importEdges.len,
           plan.unresolvedImportCount,
           plan.packageId,
           plan.ownerModulePaths[plan.sourceBundleEntrySourceIndex],
           plan.sourceBundleCidValue,
           plan.sourceBundleEntrySourceCid,
           plan.sourceBundleImportGraphCid,
           sourceReceipt,
           err):
        return false
    var overrides: compiler_csg.CompilerCsgSourceText[]
    for index in 0..<sourcePaths.len:
        var override: compiler_csg.CompilerCsgSourceText
        override.sourcePath = sourcePaths[index]
        override.modulePath = modulePaths[index]
        override.text = texts[index]
        add(overrides, override)
    var csg: compiler_csg.CompilerCsg
    if !compiler_csg.BuildCompilerCsgConsumePortableReceiptWithOverridesInto(
           csg, err, plan, sourceReceipt, "", "", overrides):
        return false
    if !compiler_csg.CompilerCsgOwnPortableArtifactStrictValidateInto(
           csg, err):
        compiler_csg.CompilerCsgTerminalRelease(csg)
        return false
    var cidAttack = compiler_csg.CompilerCsgClone(csg)
    cidAttack.sourceBundleCid.data[0] =
        uint8(cidAttack.sourceBundleCid.data[0] ^ uint8(1))
    var attackErr: str
    let cidTamperRejected =
        !compiler_csg.CompilerCsgOwnPortableArtifactStrictValidateInto(
            cidAttack, attackErr)
    compiler_csg.CompilerCsgTerminalRelease(cidAttack)
    if !cidTamperRejected:
        compiler_csg.CompilerCsgTerminalRelease(csg)
        err = "semantic snapshot differential: source CID tamper accepted"
        return false
    let dependencyTamperApplicable =
        csg.semanticGraph.importEdgeTable.targetSourceIndex.len > 0
    var dependencyTamperRejected: bool
    if dependencyTamperApplicable:
        var dependencyAttack = compiler_csg.CompilerCsgClone(csg)
        dependencyAttack.semanticGraph.importEdgeTable.targetSourceIndex[0] = -1
        attackErr = ""
        dependencyTamperRejected =
            !compiler_csg.CompilerCsgOwnPortableArtifactStrictValidateInto(
                dependencyAttack, attackErr)
        compiler_csg.CompilerCsgTerminalRelease(dependencyAttack)
        if !dependencyTamperRejected:
            compiler_csg.CompilerCsgTerminalRelease(csg)
            err = "semantic snapshot differential: dependency tamper accepted after source CID tamper rejected"
            return false
    elif sourcePaths.len != 1:
        compiler_csg.CompilerCsgTerminalRelease(csg)
        err = "semantic snapshot differential: multi-file dependency proof row absent"
        return false
    var predecessor: production.SemanticSnapshotCompilerPredecessorReceipt
    if !production.SemanticSnapshotCompilerPredecessorReceiptMakeInto(
           csg, workspace.compilerUniverse, workspace.compilerExecution,
           predecessor, err):
        compiler_csg.CompilerCsgTerminalRelease(csg)
        return false
    var admission: snapshot_builder.CompilerSnapshotProductionAdmissionReceipt
    if !snapshot_builder.CompilerSnapshotProductionAdmissionAssessInto(
           csg, workspace.snapshotStore.core.currentSourceVersion,
           admission, err):
        compiler_csg.CompilerCsgTerminalRelease(csg)
        return false
    if admission.missingDependencyProofCount != 0 ||
       admission.missingFactBitmap != 381 ||
       admission.missingSourceInterfaceCount != sourcePaths.len ||
       admission.missingSymbolInterfaceCount !=
           admission.missingSymbolDeclarationInterfaceCount +
           admission.missingSymbolGenericInterfaceCount +
           admission.missingSymbolAnnotationTargetBindingCount ||
       layout.FixedBytes32Equal(
           admission.functionInterfaceRequiredDomainCid,
           layout.FixedBytes32()) ||
       admission.missingFunctionInterfaceCount !=
           admission.reachableFunctionCount ||
       admission.missingFunctionOwnerIdentityCount !=
           admission.reachableFunctionCount ||
       admission.missingFunctionParameterTypeCount != 0 ||
       admission.missingFunctionParameterOwnershipCount != 0 ||
       admission.missingFunctionReturnTypeCount != 0 ||
       admission.missingFunctionGenericIdentityCount != 0 ||
       admission.missingFunctionSourceBindingCount != 0 ||
       admission.missingReferenceProofCount !=
           admission.resolvedCallCount ||
       admission.missingReferenceParserNodeIdentityCount != 0 ||
       admission.missingReferenceOwnerFunctionIdentityCount != 0 ||
       admission.missingReferenceSpanCount != 0 ||
       admission.missingReferenceTargetDeclarationIdentityCount != 0 ||
       admission.missingReferenceTargetSymbolCidCount != 0 ||
       admission.missingReferenceResultTypeIdCount != 0 ||
       admission.missingReferenceResultOwnershipProofCount != 0 ||
       admission.lexicalScopeRequiredCount !=
           admission.parserLexicalScopeCount +
           admission.typedLexicalScopeCount ||
       admission.missingLexicalScopeProofCount !=
           admission.lexicalScopeRequiredCount ||
       admission.missingParserLexicalScopeIdentityCount != 0 ||
       admission.missingTypedLexicalScopeIdentityCount != 0 ||
       admission.missingStatementLexicalScopeUseCount != 0 ||
       admission.missingLexicalScopeBridgeCount !=
           admission.typedLexicalScopeCount ||
       admission.missingLexicalScopeOwnerDeclarationIdentityCount <= 0 ||
       admission.missingLexicalScopeOwnerDeclarationIdentityCount >
           admission.parserLexicalScopeCount ||
       admission.missingLexicalScopeOwnerFunctionIdentityCount != 0 ||
       admission.missingLexicalScopeSpanCount !=
           admission.lexicalScopeRequiredCount ||
       admission.missingLexicalScopeVisibleSymbolProofCount !=
           admission.lexicalScopeRequiredCount ||
       admission.diagnosticProducerKindCount != 5 ||
       admission.diagnosticCompletionRequiredCount !=
           sourcePaths.len * 5 ||
       admission.diagnosticProducedRowCount != 0 ||
       admission.missingDiagnosticCompletionCount !=
           admission.diagnosticCompletionRequiredCount ||
       admission.missingDiagnosticSourceIdentityCount != 0 ||
       admission.missingDiagnosticProducerKindCount != 0 ||
       admission.missingDiagnosticSpanIdentityCount != 0 ||
       admission.missingDiagnosticParserNodeIdentityCount != 0 ||
       admission.missingDiagnosticOwnerDeclarationIdentityCount != 0 ||
       admission.missingDiagnosticProofCount !=
           admission.diagnosticCompletionRequiredCount ||
       (admission.missingFactBitmap & 1) != 1 ||
       (admission.missingFactBitmap & 4) != 4 ||
       (admission.missingFactBitmap & 8) != 8 ||
       (admission.missingFactBitmap & 16) != 16 ||
       (admission.missingFactBitmap & 32) != 32 ||
       (admission.missingFactBitmap & 64) != 64 ||
       (admission.missingFactBitmap & 256) != 256 ||
       layout.FixedBytes32Equal(
           admission.referenceRequiredDomainCid,
           layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(
           admission.referenceProofCid,
           layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           admission.lexicalScopeRequiredDomainCid,
           layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(
           admission.lexicalScopeProofCid,
           layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           admission.diagnosticRequiredDomainCid,
           layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(
           admission.diagnosticProofCid,
           layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           admission.dependencyProofCid, layout.FixedBytes32()):
        compiler_csg.CompilerCsgTerminalRelease(csg)
        err = "semantic snapshot differential: source-interface/dependency/diagnostic admission ledger drift"
        return false
    if admission.resolvedCallCount <= 0:
        compiler_csg.CompilerCsgTerminalRelease(csg)
        err = "semantic snapshot differential: reference mutation domain is empty"
        return false
    var referenceNodeAttack = compiler_csg.CompilerCsgClone(csg)
    referenceNodeAttack.semanticGraph.resolvedCallTable.originParserNodeIds[0] =
        referenceNodeAttack.parserNormalizedExprReceipt.sourceSidecars[
            referenceNodeAttack.semanticGraph.resolvedCallTable.sourceIndexes[
                0]].nodeKinds.len
    var referenceNodeAttackAdmission: snapshot_builder.CompilerSnapshotProductionAdmissionReceipt
    attackErr = ""
    if snapshot_builder.CompilerSnapshotProductionAdmissionAssessInto(
           referenceNodeAttack,
           workspace.snapshotStore.core.currentSourceVersion,
           referenceNodeAttackAdmission, attackErr):
        compiler_csg.CompilerCsgTerminalRelease(referenceNodeAttack)
        compiler_csg.CompilerCsgTerminalRelease(csg)
        err = "semantic snapshot differential: reference parser node mutation survived"
        return false
    compiler_csg.CompilerCsgTerminalRelease(referenceNodeAttack)
    let firstResolvedCallNode =
        FirstResolvedCallTypedNodePosition(csg)
    if sourcePaths.len <= 1 || firstResolvedCallNode < 0:
        compiler_csg.CompilerCsgTerminalRelease(csg)
        err = "semantic snapshot differential: multi-file resolved-call mutation domain missing"
        return false
    var callDeclarationDeleteAttack =
        compiler_csg.CompilerCsgClone(csg)
    arenamod.ArenaArrayInt32Set(
        callDeclarationDeleteAttack.typedIr.arena,
        callDeclarationDeleteAttack.typedIr.nodes2_callDeclarationIndexes,
        firstResolvedCallNode,
        -1)
    var callDeclarationDeleteAdmission: snapshot_builder.CompilerSnapshotProductionAdmissionReceipt
    attackErr = ""
    if snapshot_builder.CompilerSnapshotProductionAdmissionAssessInto(
           callDeclarationDeleteAttack,
           workspace.snapshotStore.core.currentSourceVersion,
           callDeclarationDeleteAdmission,
           attackErr):
        compiler_csg.CompilerCsgTerminalRelease(
            callDeclarationDeleteAttack)
        compiler_csg.CompilerCsgTerminalRelease(csg)
        err = "semantic snapshot differential: deleted callDeclaration row survived"
        return false
    compiler_csg.CompilerCsgTerminalRelease(
        callDeclarationDeleteAttack)
    let callDeclarationIndex =
        texpr.TypedExprIrCallDeclarationBuildIndex(csg.typedIr)
    let firstCallDeclarationRow =
        arenamod.ArenaArrayInt32Get(
            csg.typedIr.arena,
            csg.typedIr.nodes2_callDeclarationIndexes,
            firstResolvedCallNode)
    if callDeclarationIndex == nil ||
       callDeclarationIndex.callDeclarationKinds.len <= 1 ||
       firstCallDeclarationRow < 0:
        compiler_csg.CompilerCsgTerminalRelease(csg)
        err = "semantic snapshot differential: callDeclaration swap domain missing"
        return false
    var callDeclarationSwapAttack =
        compiler_csg.CompilerCsgClone(csg)
    let swappedCallDeclarationRow =
        firstCallDeclarationRow == 0 ? 1 : 0
    arenamod.ArenaArrayInt32Set(
        callDeclarationSwapAttack.typedIr.arena,
        callDeclarationSwapAttack.typedIr.nodes2_callDeclarationIndexes,
        firstResolvedCallNode,
        swappedCallDeclarationRow)
    var callDeclarationSwapAdmission: snapshot_builder.CompilerSnapshotProductionAdmissionReceipt
    attackErr = ""
    if snapshot_builder.CompilerSnapshotProductionAdmissionAssessInto(
           callDeclarationSwapAttack,
           workspace.snapshotStore.core.currentSourceVersion,
           callDeclarationSwapAdmission,
           attackErr):
        compiler_csg.CompilerCsgTerminalRelease(
            callDeclarationSwapAttack)
        compiler_csg.CompilerCsgTerminalRelease(csg)
        err = "semantic snapshot differential: swapped callDeclaration row survived"
        return false
    compiler_csg.CompilerCsgTerminalRelease(
        callDeclarationSwapAttack)
    var crossSourceCallDeclarationAttack =
        compiler_csg.CompilerCsgClone(csg)
    let crossSourceIndex =
        texpr.TypedExprIrCallDeclarationBuildIndex(
            crossSourceCallDeclarationAttack.typedIr)
    if crossSourceIndex == nil ||
       firstCallDeclarationRow >=
           crossSourceIndex.callDeclarationProducerSourceIndexes.len:
        compiler_csg.CompilerCsgTerminalRelease(
            crossSourceCallDeclarationAttack)
        compiler_csg.CompilerCsgTerminalRelease(csg)
        err = "semantic snapshot differential: cross-source callDeclaration domain missing"
        return false
    let originalTargetProducerSource =
        crossSourceIndex.callDeclarationProducerSourceIndexes[
            firstCallDeclarationRow]
    crossSourceIndex.callDeclarationProducerSourceIndexes[
        firstCallDeclarationRow] =
            originalTargetProducerSource == 0 ? 1 : 0
    var crossSourceCallDeclarationAdmission: snapshot_builder.CompilerSnapshotProductionAdmissionReceipt
    attackErr = ""
    if snapshot_builder.CompilerSnapshotProductionAdmissionAssessInto(
           crossSourceCallDeclarationAttack,
           workspace.snapshotStore.core.currentSourceVersion,
           crossSourceCallDeclarationAdmission,
           attackErr):
        compiler_csg.CompilerCsgTerminalRelease(
            crossSourceCallDeclarationAttack)
        compiler_csg.CompilerCsgTerminalRelease(csg)
        err = "semantic snapshot differential: cross-source callDeclaration row survived"
        return false
    compiler_csg.CompilerCsgTerminalRelease(
        crossSourceCallDeclarationAttack)
    if admission.parserLexicalScopeCount <= 0 ||
       admission.typedLexicalScopeCount <= 0 ||
       admission.statementLexicalScopeUseCount <= 0:
        compiler_csg.CompilerCsgTerminalRelease(csg)
        err = "semantic snapshot differential: lexical scope mutation domain is empty"
        return false
    var lexicalScopeParentAttack = compiler_csg.CompilerCsgClone(csg)
    lexicalScopeParentAttack.parserNormalizedExprReceipt.sourceSidecars[
        0].declarationLexicalScopeParentIds[0] = 0
    var lexicalScopeParentAttackAdmission: snapshot_builder.CompilerSnapshotProductionAdmissionReceipt
    attackErr = ""
    if snapshot_builder.CompilerSnapshotProductionAdmissionAssessInto(
           lexicalScopeParentAttack,
           workspace.snapshotStore.core.currentSourceVersion,
           lexicalScopeParentAttackAdmission,
           attackErr):
        compiler_csg.CompilerCsgTerminalRelease(
            lexicalScopeParentAttack)
        compiler_csg.CompilerCsgTerminalRelease(csg)
        err = "semantic snapshot differential: parser lexical scope parent mutation survived"
        return false
    compiler_csg.CompilerCsgTerminalRelease(lexicalScopeParentAttack)
    var sourceInterfaceCountAttack = admission
    sourceInterfaceCountAttack.missingSourceInterfaceCount =
        sourceInterfaceCountAttack.missingSourceInterfaceCount - 1
    attackErr = ""
    if snapshot_builder.CompilerSnapshotProductionAdmissionReceiptStrictValidateInto(
           csg, sourceInterfaceCountAttack, attackErr):
        compiler_csg.CompilerCsgTerminalRelease(csg)
        err = "semantic snapshot differential: caller cleared source-interface authority count"
        return false
    var sourceInterfaceProofAttack = admission
    sourceInterfaceProofAttack.sourceInterfaceProofCid =
        admission.dependencyProofCid
    attackErr = ""
    if snapshot_builder.CompilerSnapshotProductionAdmissionReceiptStrictValidateInto(
           csg, sourceInterfaceProofAttack, attackErr):
        compiler_csg.CompilerCsgTerminalRelease(csg)
        err = "semantic snapshot differential: caller injected source-interface proof"
        return false
    var symbolInterfaceProofAttack = admission
    symbolInterfaceProofAttack.symbolInterfaceProofCid =
        admission.dependencyProofCid
    attackErr = ""
    if snapshot_builder.CompilerSnapshotProductionAdmissionReceiptStrictValidateInto(
           csg, symbolInterfaceProofAttack, attackErr):
        compiler_csg.CompilerCsgTerminalRelease(csg)
        err = "semantic snapshot differential: caller injected Symbol-interface proof"
        return false
    var symbolDeclarationCountAttack = admission
    symbolDeclarationCountAttack.missingSymbolDeclarationInterfaceCount =
        symbolDeclarationCountAttack.missingSymbolDeclarationInterfaceCount - 1
    attackErr = ""
    if snapshot_builder.CompilerSnapshotProductionAdmissionReceiptStrictValidateInto(
           csg, symbolDeclarationCountAttack, attackErr):
        compiler_csg.CompilerCsgTerminalRelease(csg)
        err = "semantic snapshot differential: caller cleared Symbol declaration authority count"
        return false
    var functionInterfaceProofAttack = admission
    functionInterfaceProofAttack.functionInterfaceProofCid =
        admission.dependencyProofCid
    attackErr = ""
    if snapshot_builder.CompilerSnapshotProductionAdmissionReceiptStrictValidateInto(
           csg, functionInterfaceProofAttack, attackErr):
        compiler_csg.CompilerCsgTerminalRelease(csg)
        err = "semantic snapshot differential: caller injected Function-interface proof"
        return false
    var functionOwnerCountAttack = admission
    functionOwnerCountAttack.missingFunctionOwnerIdentityCount =
        functionOwnerCountAttack.missingFunctionOwnerIdentityCount - 1
    attackErr = ""
    if snapshot_builder.CompilerSnapshotProductionAdmissionReceiptStrictValidateInto(
           csg, functionOwnerCountAttack, attackErr):
        compiler_csg.CompilerCsgTerminalRelease(csg)
        err = "semantic snapshot differential: caller cleared Function owner identity count"
        return false
    var functionRequiredDomainAttack = admission
    functionRequiredDomainAttack.functionInterfaceRequiredDomainCid.data[0] =
        uint8(
            functionRequiredDomainAttack.functionInterfaceRequiredDomainCid.data[
                0] ^ uint8(1))
    attackErr = ""
    if snapshot_builder.CompilerSnapshotProductionAdmissionReceiptStrictValidateInto(
           csg, functionRequiredDomainAttack, attackErr):
        compiler_csg.CompilerCsgTerminalRelease(csg)
        err = "semantic snapshot differential: caller changed Function required domain"
        return false
    var typedNodeProofAttack = admission
    typedNodeProofAttack.typedNodeProofCid =
        admission.dependencyProofCid
    attackErr = ""
    if snapshot_builder.CompilerSnapshotProductionAdmissionReceiptStrictValidateInto(
           csg, typedNodeProofAttack, attackErr):
        compiler_csg.CompilerCsgTerminalRelease(csg)
        err = "semantic snapshot differential: caller injected TypedNode proof"
        return false
    var typedNodeRequiredCountAttack = admission
    typedNodeRequiredCountAttack.typedNodeRequiredCount =
        typedNodeRequiredCountAttack.typedNodeRequiredCount - 1
    attackErr = ""
    if snapshot_builder.CompilerSnapshotProductionAdmissionReceiptStrictValidateInto(
           csg, typedNodeRequiredCountAttack, attackErr):
        compiler_csg.CompilerCsgTerminalRelease(csg)
        err = "semantic snapshot differential: caller cleared TypedNode required domain"
        return false
    var referenceDomainAttack = admission
    referenceDomainAttack.referenceRequiredDomainCid.data[0] =
        uint8(referenceDomainAttack.referenceRequiredDomainCid.data[0] ^
              uint8(1))
    attackErr = ""
    if snapshot_builder.CompilerSnapshotProductionAdmissionReceiptStrictValidateInto(
           csg, referenceDomainAttack, attackErr):
        compiler_csg.CompilerCsgTerminalRelease(csg)
        err = "semantic snapshot differential: caller changed reference required domain"
        return false
    var referenceProofAttack = admission
    referenceProofAttack.referenceProofCid.data[0] =
        uint8(referenceProofAttack.referenceProofCid.data[0] ^ uint8(1))
    attackErr = ""
    if snapshot_builder.CompilerSnapshotProductionAdmissionReceiptStrictValidateInto(
           csg, referenceProofAttack, attackErr):
        compiler_csg.CompilerCsgTerminalRelease(csg)
        err = "semantic snapshot differential: caller changed reference proof"
        return false
    var referenceTargetCountAttack = admission
    referenceTargetCountAttack.missingReferenceTargetSymbolCidCount = 1
    attackErr = ""
    if snapshot_builder.CompilerSnapshotProductionAdmissionReceiptStrictValidateInto(
           csg, referenceTargetCountAttack, attackErr):
        compiler_csg.CompilerCsgTerminalRelease(csg)
        err = "semantic snapshot differential: caller restored reference SymbolCid gap"
        return false
    var referenceResultTypeCountAttack = admission
    referenceResultTypeCountAttack.missingReferenceResultTypeIdCount = 1
    attackErr = ""
    if snapshot_builder.CompilerSnapshotProductionAdmissionReceiptStrictValidateInto(
           csg, referenceResultTypeCountAttack, attackErr):
        compiler_csg.CompilerCsgTerminalRelease(csg)
        err = "semantic snapshot differential: caller restored resolved-call result TypeId gap"
        return false
    var referenceResultOwnershipCountAttack = admission
    referenceResultOwnershipCountAttack.missingReferenceResultOwnershipProofCount =
        1
    attackErr = ""
    if snapshot_builder.CompilerSnapshotProductionAdmissionReceiptStrictValidateInto(
           csg, referenceResultOwnershipCountAttack, attackErr):
        compiler_csg.CompilerCsgTerminalRelease(csg)
        err = "semantic snapshot differential: caller restored resolved-call ownership gap"
        return false
    var lexicalScopeDomainAttack = admission
    lexicalScopeDomainAttack.lexicalScopeRequiredDomainCid.data[0] =
        uint8(
            lexicalScopeDomainAttack.lexicalScopeRequiredDomainCid.data[0] ^
            uint8(1))
    attackErr = ""
    if snapshot_builder.CompilerSnapshotProductionAdmissionReceiptStrictValidateInto(
           csg, lexicalScopeDomainAttack, attackErr):
        compiler_csg.CompilerCsgTerminalRelease(csg)
        err = "semantic snapshot differential: caller changed lexical scope required domain"
        return false
    var lexicalScopeProofAttack = admission
    lexicalScopeProofAttack.lexicalScopeProofCid =
        admission.lexicalScopeRequiredDomainCid
    attackErr = ""
    if snapshot_builder.CompilerSnapshotProductionAdmissionReceiptStrictValidateInto(
           csg, lexicalScopeProofAttack, attackErr):
        compiler_csg.CompilerCsgTerminalRelease(csg)
        err = "semantic snapshot differential: caller injected lexical scope proof"
        return false
    var lexicalScopeBridgeCountAttack = admission
    lexicalScopeBridgeCountAttack.missingLexicalScopeBridgeCount =
        lexicalScopeBridgeCountAttack.missingLexicalScopeBridgeCount - 1
    attackErr = ""
    if snapshot_builder.CompilerSnapshotProductionAdmissionReceiptStrictValidateInto(
           csg, lexicalScopeBridgeCountAttack, attackErr):
        compiler_csg.CompilerCsgTerminalRelease(csg)
        err = "semantic snapshot differential: caller cleared lexical scope bridge gap"
        return false
    var diagnosticDomainAttack = admission
    diagnosticDomainAttack.diagnosticRequiredDomainCid.data[0] =
        uint8(
            diagnosticDomainAttack.diagnosticRequiredDomainCid.data[0] ^
            uint8(1))
    attackErr = ""
    if snapshot_builder.CompilerSnapshotProductionAdmissionReceiptStrictValidateInto(
           csg, diagnosticDomainAttack, attackErr):
        compiler_csg.CompilerCsgTerminalRelease(csg)
        err = "semantic snapshot differential: caller changed diagnostic required domain"
        return false
    var diagnosticProofAttack = admission
    diagnosticProofAttack.diagnosticProofCid =
        admission.diagnosticRequiredDomainCid
    attackErr = ""
    if snapshot_builder.CompilerSnapshotProductionAdmissionReceiptStrictValidateInto(
           csg, diagnosticProofAttack, attackErr):
        compiler_csg.CompilerCsgTerminalRelease(csg)
        err = "semantic snapshot differential: caller injected empty diagnostic proof"
        return false
    var diagnosticCompletionCountAttack = admission
    diagnosticCompletionCountAttack.missingDiagnosticCompletionCount =
        diagnosticCompletionCountAttack.missingDiagnosticCompletionCount - 1
    attackErr = ""
    if snapshot_builder.CompilerSnapshotProductionAdmissionReceiptStrictValidateInto(
           csg, diagnosticCompletionCountAttack, attackErr):
        compiler_csg.CompilerCsgTerminalRelease(csg)
        err = "semantic snapshot differential: caller cleared diagnostic completion gap"
        return false
    var admissionAttack = admission
    admissionAttack.dependencyProofCid.data[0] =
        uint8(admissionAttack.dependencyProofCid.data[0] ^ uint8(1))
    attackErr = ""
    let admissionDependencyProofTamperRejected =
        !snapshot_builder.CompilerSnapshotProductionAdmissionReceiptStrictValidateInto(
            csg, admissionAttack, attackErr)
    if !admissionDependencyProofTamperRejected:
        compiler_csg.CompilerCsgTerminalRelease(csg)
        err = "semantic snapshot differential: admission dependency proof tamper accepted"
        return false
    var receipt: DifferentialColdCsgReceipt
    receipt.sourceBundleCid = csg.sourceBundleCid
    receipt.canonicalGraphCid = csg.canonicalGraphCid
    receipt.predecessorReceiptCid = predecessor.receiptCid
    receipt.admissionReceiptCid = admission.receiptCid
    receipt.missingFactBitmap = admission.missingFactBitmap
    receipt.admissionBlocked = admission.admissionBlocked
    receipt.cidTamperRejected = cidTamperRejected
    receipt.dependencyTamperApplicable = dependencyTamperApplicable
    receipt.dependencyTamperRejected = dependencyTamperRejected
    receipt.admissionDependencyProofTamperRejected =
        admissionDependencyProofTamperRejected
    out = receipt
    compiler_csg.CompilerCsgTerminalRelease(csg)
    err = ""
    return true

fn DerivedColdSessionCid(
        sourceVersion: int64,
        transcriptCid: layout.FixedBytes32): layout.FixedBytes32 =
    var bytes = layout.ByteBufInit(128)
    AppendTranscriptText(bytes, "cheng.semantic_snapshot.cold_oracle_session")
    AppendTranscriptText(bytes, strings.Int64ToStr(sourceVersion))
    layout.ByteBufAppendFixed32(bytes, transcriptCid)
    let out = hash256.Sha256Fixed(layout.ByteBufView(bytes))
    layout.ByteBufFree(bytes)
    return out

fn CurrentPayloadIndex(workspace: lsp.LspWorkspace): int32 =
    let snapshotIndex = workspace.snapshotStore.core.publishedIndex
    if snapshotIndex < 0 ||
       snapshotIndex >= workspace.snapshotStore.payloadIndexesBySnapshot.len:
        return -1
    return workspace.snapshotStore.payloadIndexesBySnapshot[snapshotIndex]

@borrows
fn BindDocuments(
        workspace: var lsp.LspWorkspace,
        workspaceRoot: str,
        uris: str[],
        sourcePaths: str[],
        modulePaths: str[],
        err: var str): bool =
    for index in 0..<uris.len:
        if !lsp.LspWorkspaceBindDocumentCompilerIdentityInto(
               workspace, uris[index], workspaceRoot, workspaceRoot,
               "pkg", "arm64-apple-darwin", sourcePaths[index],
               modulePaths[index], index == modulePaths.len - 1, err):
            return false
    return true

fn ReleaseColdWithFailure(
        cold: var lsp.LspWorkspace,
        failure: str,
        err: var str): bool =
    var releaseErr: str
    assert(lsp.LspWorkspaceReleaseInto(cold, releaseErr),
           Fmt"semantic snapshot differential: cold release failed {releaseErr}")
    err = failure
    return false

fn ComparePublishedWithIndependentCold(
        workspace: var lsp.LspWorkspace,
        workspaceRoot: str,
        uris: str[],
        sourcePaths: str[],
        modulePaths: str[],
        currentTexts: str[],
        openStates: bool[],
        clientVersions: int64[],
        sourceVersion: int64,
        transcriptCid: layout.FixedBytes32,
        eventIndex: int32,
        err: var str): bool =
    var cold: lsp.LspWorkspace
    if !lsp.LspWorkspaceInitInto(
           DerivedColdSessionCid(sourceVersion, transcriptCid),
           workspace.compilerUniverse, workspace.compilerExecution,
           cold, err) ||
       !BindDocuments(
           cold, workspaceRoot, uris, sourcePaths, modulePaths, err):
        return false
    var coldVersion: int64
    for index in 0..<uris.len:
        if !lsp.LspWorkspaceDidOpenInto(
               cold, uris[index], clientVersions[index],
               currentTexts[index], coldVersion, err):
            return ReleaseColdWithFailure(cold, err, err)
    for index in 0..<uris.len:
        if !openStates[index]:
            if !lsp.LspWorkspaceDidCloseInto(
                   cold, uris[index], coldVersion, err):
                return ReleaseColdWithFailure(cold, err, err)
    if !CurrentVersionPublished(cold, coldVersion):
        err = Fmt"semantic snapshot differential: independent cold snapshot unpublished event={eventIndex} blocked={cold.candidateBlockedReason}"
        return ReleaseColdWithFailure(cold, err, err)
    if !production.SemanticSnapshotProductionStoreStrictValidateInto(
           workspace.snapshotStore, err) ||
       !production.SemanticSnapshotProductionStoreStrictValidateInto(
           cold.snapshotStore, err):
        return ReleaseColdWithFailure(cold, err, err)
    let incrementalPayload = CurrentPayloadIndex(workspace)
    let coldPayload = CurrentPayloadIndex(cold)
    if incrementalPayload < 0 || coldPayload < 0:
        err = "semantic snapshot differential: published payload mapping missing"
        return ReleaseColdWithFailure(cold, err, err)
    let incrementalIdentity =
        workspace.snapshotStore.payloadIdentities[incrementalPayload]
    let incrementalBinding =
        workspace.snapshotStore.payloadBindings[incrementalPayload]
    let incrementalValidation =
        workspace.snapshotStore.payloadValidations[incrementalPayload]
    let incrementalTables =
        workspace.snapshotStore.payloadTables[incrementalPayload]
    let coldTables = cold.snapshotStore.payloadTables[coldPayload]
    var projectedColdFacts: compiler_facts.CompilerFactBundle
    if !compiler_facts.CompilerFactsFromSemanticSnapshotInto(
           coldTables,
           incrementalIdentity,
           incrementalBinding,
           incrementalValidation,
           incrementalTables.predecessorReceiptCid,
           workspace.snapshotStore.payloadPackageIds[incrementalPayload],
           projectedColdFacts,
           err):
        return ReleaseColdWithFailure(cold, err, err)
    let semanticMatch =
        layout.FixedBytes32Equal(
            incrementalIdentity.sourceBundleCid,
            cold.snapshotStore.payloadIdentities[
                coldPayload].sourceBundleCid) &&
        layout.FixedBytes32Equal(
            incrementalTables.declarations.tableCid,
            coldTables.declarations.tableCid) &&
        layout.FixedBytes32Equal(
            workspace.snapshotStore.payloadFactsRootCids[
                incrementalPayload],
            cold.snapshotStore.payloadFactsRootCids[coldPayload]) &&
        layout.FixedBytes32Equal(
            workspace.snapshotStore.payloadCargoCids[incrementalPayload],
            cold.snapshotStore.payloadCargoCids[coldPayload]) &&
        projectedColdFacts.factCount ==
            workspace.snapshotStore.payloadCompilerFactCounts[
                incrementalPayload] &&
        layout.FixedBytes32Equal(
            projectedColdFacts.projectionCid,
            workspace.snapshotStore.payloadCompilerFactProjectionCids[
                incrementalPayload])
    if !semanticMatch:
        err = Fmt"semantic snapshot differential: incremental/cold mismatch event={eventIndex} source_bundle={layout.FixedBytes32Hex(incrementalIdentity.sourceBundleCid)} cold_source_bundle={layout.FixedBytes32Hex(cold.snapshotStore.payloadIdentities[coldPayload].sourceBundleCid)} decl_table={layout.FixedBytes32Hex(incrementalTables.declarations.tableCid)} cold_decl_table={layout.FixedBytes32Hex(coldTables.declarations.tableCid)} csg={layout.FixedBytes32Hex(workspace.snapshotStore.payloadFactsRootCids[incrementalPayload])} cold_csg={layout.FixedBytes32Hex(cold.snapshotStore.payloadFactsRootCids[coldPayload])} compiler_fact={layout.FixedBytes32Hex(workspace.snapshotStore.payloadCompilerFactProjectionCids[incrementalPayload])} cold_compiler_fact={layout.FixedBytes32Hex(projectedColdFacts.projectionCid)}"
        return ReleaseColdWithFailure(cold, err, err)
    os.WriteLine(os.Get_stdout(), Fmt"semantic_snapshot_random_incremental_cold_match event_index={eventIndex} source_version={sourceVersion} source_bundle={layout.FixedBytes32Hex(incrementalIdentity.sourceBundleCid)} decl_table={layout.FixedBytes32Hex(incrementalTables.declarations.tableCid)} canonical_csg={layout.FixedBytes32Hex(workspace.snapshotStore.payloadFactsRootCids[incrementalPayload])} cargo={layout.FixedBytes32Hex(workspace.snapshotStore.payloadCargoCids[incrementalPayload])} compiler_fact_projection={layout.FixedBytes32Hex(projectedColdFacts.projectionCid)}")
    if !lsp.LspWorkspaceReleaseInto(cold, err):
        return false
    err = ""
    return true

fn ExactIncrementalPlanFromProductionFactsInto(
        previousTables: snapshot_schema.CsgCompilerSnapshotTables,
        previousIdentity: snapshot_core.PortableSemanticSnapshotIdentity,
        previousBinding: snapshot_core.LocalSourceVersionBinding,
        previousValidation: snapshot_core.SemanticSnapshotValidationReceipt,
        currentFacts: incremental.SemanticSnapshotIncrementalPrebuildFacts,
        out: var incremental.SemanticSnapshotIncrementalPrebuildPlan,
        err: var str): bool =
    return incremental.SemanticSnapshotIncrementalPrebuildPlanBuildInto(
        previousTables, previousIdentity, previousBinding,
        previousValidation, currentFacts, out, err)

fn EnvInt32(name: str, defaultValue: int32): int32 =
    let raw = os.GetEnv(name)
    if raw == "":
        return defaultValue
    var value: int32
    let consumed = parseutils.ParseInt32(raw, value)
    assert(consumed == raw.len,
           Fmt"semantic snapshot differential: invalid integer env {name}")
    return value

fn EmitScheduleManifest(): int32 =
    var transitionCount: int32
    var oneFileCount: int32
    var twoFileCount: int32
    var nFileCount: int32
    for seedIndex in 0..<DifferentialSeedCount:
        let seed = SeedValue(seedIndex)
        let documentCount = DocumentCountForSeed(seedIndex)
        let events = BuildSchedule(seedIndex)
        ValidateSchedule(seedIndex, events)
        let transcriptCid = ScheduleCid(seed, events)
        let repeatedEvents = BuildSchedule(seedIndex)
        let repeatedCid = ScheduleCid(seed, repeatedEvents)
        assert(layout.FixedBytes32Equal(transcriptCid, repeatedCid),
               "semantic snapshot differential: PRNG transcript is nondeterministic")
        let cacheKey =
            incremental.SemanticSnapshotFunctionFragmentCacheKey(
                transcriptCid, transcriptCid, transcriptCid,
                transcriptCid, transcriptCid, transcriptCid,
                transcriptCid)
        let cachePath =
            cache_store.SemanticSnapshotFunctionFragmentCachePath(
                "/tmp/cheng-semantic-snapshot-random-contract",
                cacheKey)
        assert(strings.StrContains(
                   cachePath, layout.FixedBytes32Hex(cacheKey)),
               "semantic snapshot differential: cache identity path drift")
        transitionCount = transitionCount + events.len
        if documentCount == 1:
            oneFileCount = oneFileCount + 1
        elif documentCount == 2:
            twoFileCount = twoFileCount + 1
        else:
            nFileCount = nFileCount + 1
        os.WriteLine(os.Get_stdout(), Fmt"semantic_snapshot_random_incremental_contract_seed seed_index={seedIndex} seed={seed} document_count={documentCount} transition_count={events.len} transcript_cid={layout.FixedBytes32Hex(transcriptCid)} exact_plan_api=1 fragment_cache_api=1")
    assert(transitionCount ==
               DifferentialSeedCount * DifferentialTransitionCount &&
           oneFileCount == 10 && twoFileCount == 10 &&
           nFileCount == 10,
           "semantic snapshot differential: aggregate schedule coverage drift")
    os.WriteLine(os.Get_stdout(), Fmt"semantic_snapshot_random_incremental_contract_manifest seed_count={DifferentialSeedCount} transition_count_per_seed={DifferentialTransitionCount} total_transition_count={transitionCount} one_file_seed_count={oneFileCount} two_file_seed_count={twoFileCount} n_file_seed_count={nFileCount} add_change_remove_rename=1 cross_module_interface=1 exact_rebuild_read_set_required=1 cold_csg_compiler_fact_each_transition=1 object_runtime_key_boundaries=1 cache_tamper_hard_fail=1")
    return 0

fn RunSeed(seedIndex: int32): int32 =
    let workspaceBase = os.GetEnv("CHENG_SNAPSHOT_DIFF_WORKSPACE")
    assert(workspaceBase != "",
           "semantic snapshot differential: workspace env missing")
    let workspaceRoot = strutil.Join([
        workspaceBase, "/seed-", strings.IntToStr(seedIndex)], "")
    let sourceRoot = strutil.Join([workspaceRoot, "/src"], "")
    let documentCount = DocumentCountForSeed(seedIndex)
    let seed = SeedValue(seedIndex)
    var sourcePaths: str[]
    var modulePaths: str[]
    if documentCount == 1:
        add(sourcePaths, strutil.Join([sourceRoot, "/main.cheng"], ""))
        add(modulePaths, "pkg/main")
    else:
        add(sourcePaths, strutil.Join([sourceRoot, "/helper.cheng"], ""))
        add(modulePaths, "pkg/helper")
        if documentCount == DifferentialDocumentCountN:
            add(sourcePaths, strutil.Join([sourceRoot, "/bridge.cheng"], ""))
            add(modulePaths, "pkg/bridge")
            add(sourcePaths, strutil.Join([sourceRoot, "/extra.cheng"], ""))
            add(modulePaths, "pkg/extra")
        add(sourcePaths, strutil.Join([sourceRoot, "/main.cheng"], ""))
        add(modulePaths, "pkg/main")
    var uris: str[]
    for sourceIndex in 0..<sourcePaths.len:
        add(uris, strutil.Join(["file://", sourcePaths[sourceIndex]], ""))
    os.MkdirAll(sourceRoot, 493)
    os.WriteFile(
        strutil.Join([workspaceRoot, "/cheng-package.toml"], ""),
        "disk manifest bytes must not feed the immutable overlay\n")
    for index in 0..<sourcePaths.len:
        os.WriteFile(
            sourcePaths[index],
            "disk source bytes must not feed the semantic snapshot\n")

    let events = BuildSchedule(seedIndex)
    ValidateSchedule(seedIndex, events)
    let transcriptCid = ScheduleCid(seed, events)
    let repeatedEvents = BuildSchedule(seedIndex)
    let repeatedCid = ScheduleCid(seed, repeatedEvents)
    assert(layout.FixedBytes32Equal(transcriptCid, repeatedCid),
           "semantic snapshot differential: PRNG transcript is nondeterministic")
    os.WriteLine(os.Get_stdout(), Fmt"semantic_snapshot_random_incremental_cold_transcript seed_index={seedIndex} seed={seed} document_count={documentCount} event_count={events.len} transcript_cid={layout.FixedBytes32Hex(transcriptCid)} body=1 signature=1 import_call=1 delete=1 reopen=1 rename=1 add=1 same_name_same_arity=1 invalid=1 repair=1 exact_plan=1 exact_read_set=1 fragment_cache=1 cid_tamper=1 dependency_tamper=1 cache_tamper=1 cold_csg_compiler_fact_each_transition=1 object_runtime_key_boundaries=1")

    let compilerExecution = CurrentExecution()
    var workspace: lsp.LspWorkspace
    var err: str
    assert(lsp.LspWorkspaceInitInto(
               RequiredCidEnv("CHENG_SNAPSHOT_DIFF_WORKSPACE_SESSION_CID"),
               CurrentUniverse(compilerExecution), compilerExecution,
               workspace, err), err)
    assert(BindDocuments(
               workspace, workspaceRoot, uris,
               sourcePaths, modulePaths, err), err)
    var initialColdTexts: str[]
    for sourceIndex in 0..<documentCount:
        add(initialColdTexts, events[sourceIndex].text)
    var initialCold: DifferentialColdCsgReceipt
    if !BuildIndependentColdCsgReceipt(
           workspace, workspaceRoot, sourcePaths, modulePaths,
           initialColdTexts, initialCold, err):
        os.WriteLine(os.Get_stdout(), Fmt"semantic_snapshot_random_incremental_cold_differential_status=red seed_index={seedIndex} seed={seed} event_index=-1 source_version=0 reason=cold_full_build_failed transcript_cid={layout.FixedBytes32Hex(transcriptCid)} cold_error={err}")
        assert(lsp.LspWorkspaceReleaseInto(workspace, err), err)
        return 1
    let initialAdmissionBlocked = initialCold.admissionBlocked ? 1 : 0
    let initialCidTamperRejected = initialCold.cidTamperRejected ? 1 : 0
    let initialDependencyTamperApplicable =
        initialCold.dependencyTamperApplicable ? 1 : 0
    let initialDependencyTamperRejected =
        initialCold.dependencyTamperRejected ? 1 : 0
    let initialAdmissionDependencyProofTamperRejected =
        initialCold.admissionDependencyProofTamperRejected ? 1 : 0
    os.WriteLine(os.Get_stdout(), Fmt"semantic_snapshot_random_incremental_cold_preflight source_bundle={layout.FixedBytes32Hex(initialCold.sourceBundleCid)} canonical_csg={layout.FixedBytes32Hex(initialCold.canonicalGraphCid)} predecessor={layout.FixedBytes32Hex(initialCold.predecessorReceiptCid)} admission={layout.FixedBytes32Hex(initialCold.admissionReceiptCid)} admission_blocked={initialAdmissionBlocked} missing_fact_bitmap={initialCold.missingFactBitmap} cid_tamper_rejected={initialCidTamperRejected} dependency_tamper_applicable={initialDependencyTamperApplicable} dependency_tamper_rejected={initialDependencyTamperRejected} admission_dependency_proof_tamper_rejected={initialAdmissionDependencyProofTamperRejected}")
    var currentTexts: str[]
    var openStates: bool[]
    var clientVersions: int64[]
    setLen(currentTexts, documentCount)
    setLen(openStates, documentCount)
    setLen(clientVersions, documentCount)
    var sourceVersion: int64
    var semanticMatchCount: int32
    for eventIndex in 0..<events.len:
        let event = events[eventIndex]
        let csgWallBefore = workspace.metrics.compilerCsgBuildWallNs
        assert(ApplyEvent(
                   workspace, event, uris, currentTexts,
                   openStates, clientVersions, sourceVersion, err), err)
        assert(sourceVersion == int64(eventIndex + 1),
               Fmt"semantic snapshot differential: source version drift event={eventIndex} version={sourceVersion}")
        if eventIndex == 0:
            assert(RunSourceHashCacheTamperAttack(
                       workspace, uris[0], currentTexts[0], int64(2),
                       sourceVersion, err), err)
            os.WriteLine(os.Get_stdout(), Fmt"semantic_snapshot_random_incremental_cold_cache_attack event_index={eventIndex} source_version={sourceVersion} production_source_hash_cache_tamper_rejected=1")
        if eventIndex < documentCount - 1:
            assert(!CurrentVersionPublished(workspace, sourceVersion),
                   "semantic snapshot differential: incomplete source set published")
            continue
        if event.category == DifferentialCategoryBody &&
           workspace.metrics.compilerCsgBuildWallNs > csgWallBefore:
            var coldReceipt: DifferentialColdCsgReceipt
            let coldBuilt = BuildIndependentColdCsgReceipt(
                workspace, workspaceRoot, sourcePaths, modulePaths,
                currentTexts, coldReceipt, err)
            let coldBuiltFlag = coldBuilt ? 1 : 0
            os.WriteLine(os.Get_stdout(), Fmt"semantic_snapshot_random_incremental_cold_differential_status=red seed_index={seedIndex} seed={seed} document_count={documentCount} event_index={eventIndex} source_version={sourceVersion} reason=lsp_full_compiler_csg_rebuild_observed event_category=body compiler_csg_wall_before_ns={csgWallBefore} compiler_csg_wall_after_ns={workspace.metrics.compilerCsgBuildWallNs} exact_incremental_plan_status=not_wired fragment_cache_status=not_wired cold_built={coldBuiltFlag} transcript_cid={layout.FixedBytes32Hex(transcriptCid)}")
            assert(coldBuilt && coldReceipt.cidTamperRejected &&
                   (!coldReceipt.dependencyTamperApplicable ||
                    coldReceipt.dependencyTamperRejected),
                   "semantic snapshot differential: full rebuild RED lacks cold authority")
            assert(lsp.LspWorkspaceReleaseInto(workspace, err), err)
            return 1
        if !event.valid:
            let allContentModified = AllSixContentModified(
                workspace, uris[uris.len - 1])
            let rejectedFlag = CurrentVersionRejected(
                workspace, sourceVersion) ? 1 : 0
            if !CurrentVersionRejected(workspace, sourceVersion) ||
               !allContentModified:
                let modifiedFlag = allContentModified ? 1 : 0
                os.WriteLine(os.Get_stdout(), Fmt"semantic_snapshot_random_incremental_cold_differential_status=red seed_index={seedIndex} seed={seed} event_index={eventIndex} source_version={sourceVersion} reason=invalid_edit_contract_failed rejected={rejectedFlag} all_six_content_modified={modifiedFlag} transcript_cid={layout.FixedBytes32Hex(transcriptCid)}")
                assert(lsp.LspWorkspaceReleaseInto(workspace, err), err)
                return 1
            os.WriteLine(os.Get_stdout(), Fmt"semantic_snapshot_random_incremental_cold_rejection event_index={eventIndex} source_version={sourceVersion} rejected=1 all_six_content_modified=1")
            continue
        if !CurrentVersionPublished(workspace, sourceVersion):
            var coldReceipt: DifferentialColdCsgReceipt
            let coldBuilt = BuildIndependentColdCsgReceipt(
                workspace, workspaceRoot, sourcePaths, modulePaths,
                currentTexts, coldReceipt, err)
            let noOldResults = UnpublishedReturnsNoOldSemanticResult(
                workspace, uris[uris.len - 1], sourceVersion)
            let rejectedFlag = CurrentVersionRejected(
                workspace, sourceVersion) ? 1 : 0
            let noOldFlag = noOldResults ? 1 : 0
            let coldBuiltFlag = coldBuilt ? 1 : 0
            var coldSourceBundle: str
            var coldCanonicalCsg: str
            var coldPredecessor: str
            var coldAdmission: str
            var coldMissingFactBitmap: int32 = -1
            var coldAdmissionBlocked: int32
            var coldCidTamperRejected: int32
            var coldDependencyTamperApplicable: int32
            var coldDependencyTamperRejected: int32
            if coldBuilt:
                coldSourceBundle = layout.FixedBytes32Hex(
                    coldReceipt.sourceBundleCid)
                coldCanonicalCsg = layout.FixedBytes32Hex(
                    coldReceipt.canonicalGraphCid)
                coldPredecessor = layout.FixedBytes32Hex(
                    coldReceipt.predecessorReceiptCid)
                coldAdmission = layout.FixedBytes32Hex(
                    coldReceipt.admissionReceiptCid)
                coldMissingFactBitmap = coldReceipt.missingFactBitmap
                if coldReceipt.admissionBlocked:
                    coldAdmissionBlocked = 1
                if coldReceipt.cidTamperRejected:
                    coldCidTamperRejected = 1
                if coldReceipt.dependencyTamperApplicable:
                    coldDependencyTamperApplicable = 1
                if coldReceipt.dependencyTamperRejected:
                    coldDependencyTamperRejected = 1
            os.WriteLine(os.Get_stdout(), Fmt"semantic_snapshot_random_incremental_cold_differential_status=red seed_index={seedIndex} seed={seed} event_index={eventIndex} source_version={sourceVersion} reason=published_snapshot_missing rejected={rejectedFlag} no_old_results={noOldFlag} cold_built={coldBuiltFlag} cold_source_bundle={coldSourceBundle} cold_canonical_csg={coldCanonicalCsg} cold_predecessor={coldPredecessor} cold_admission={coldAdmission} cold_missing_fact_bitmap={coldMissingFactBitmap} cold_admission_blocked={coldAdmissionBlocked} cid_tamper_rejected={coldCidTamperRejected} dependency_tamper_applicable={coldDependencyTamperApplicable} dependency_tamper_rejected={coldDependencyTamperRejected} completed_stage_bitmap={workspace.candidateAdmissionCompletedStageBitmap} missing_fact_bitmap={workspace.candidateAdmissionMissingFactBitmap} transcript_cid={layout.FixedBytes32Hex(transcriptCid)} blocked_reason={workspace.candidateBlockedReason} cold_error={err}")
            assert(CurrentVersionRejected(workspace, sourceVersion) &&
                   noOldResults && coldBuilt &&
                   coldReceipt.cidTamperRejected &&
                   (!coldReceipt.dependencyTamperApplicable ||
                    coldReceipt.dependencyTamperRejected),
                   "semantic snapshot differential: first RED evidence incomplete")
            assert(lsp.LspWorkspaceReleaseInto(workspace, err), err)
            return 1
        if !ComparePublishedWithIndependentCold(
               workspace, workspaceRoot, uris, sourcePaths, modulePaths,
               currentTexts, openStates, clientVersions, sourceVersion,
               transcriptCid, eventIndex, err):
            os.WriteLine(os.Get_stdout(), Fmt"semantic_snapshot_random_incremental_cold_differential_status=red seed_index={seedIndex} seed={seed} event_index={eventIndex} source_version={sourceVersion} reason=incremental_cold_semantic_mismatch transcript_cid={layout.FixedBytes32Hex(transcriptCid)} error={err}")
            assert(lsp.LspWorkspaceReleaseInto(workspace, err), err)
            return 1
        semanticMatchCount = semanticMatchCount + 1
    os.WriteLine(os.Get_stdout(), Fmt"semantic_snapshot_random_incremental_cold_differential_status=red seed_index={seedIndex} seed={seed} event_index={events.len} source_version={sourceVersion} reason=object_runtime_oracle_not_bound semantic_match_count={semanticMatchCount} object_bytes_cid= runtime_result_cid= transcript_cid={layout.FixedBytes32Hex(transcriptCid)}")
    assert(lsp.LspWorkspaceReleaseInto(workspace, err), err)
    return 1

fn main(): int32 =
    let mode = os.GetEnv("CHENG_SNAPSHOT_DIFF_MODE")
    if mode == "manifest":
        return EmitScheduleManifest()
    let seedStart = EnvInt32("CHENG_SNAPSHOT_DIFF_SEED_START", 20)
    let seedCount = EnvInt32("CHENG_SNAPSHOT_DIFF_SEED_COUNT", 5)
    assert(seedStart >= 0 && seedCount > 0 &&
           seedStart <= DifferentialSeedCount &&
           seedCount <= DifferentialSeedCount - seedStart,
           "semantic snapshot differential: seed batch out of range")
    for offset in 0..<seedCount:
        let rc = RunSeed(seedStart + offset)
        if rc != 0:
            return rc
    return 0
