fn R14PhaseNamesM(): str[] =
    return ["system_link_plan",
            "compiler_csg",
            "lowering_plan"]

fn main(): int32 =
    let names = R14PhaseNamesM()
    if names.len != 3:
        return 10
    if names[1] != "WRONG":
        return 12
    echo("r14_seqlit_return_mutant unexpectedly ok")
    return 0
