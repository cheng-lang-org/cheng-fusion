module tests/compiler_csg_manual_consume_lowering_bridge_smoke

@manual_consume(target=target, source=source)
fn ManualConsumeReplace(
        target: var int32[],
        source: int32[]) =
    target = source

fn main() =
    var target: int32[]
    add(target, 11)
    var source: int32[]
    add(source, 22)
    add(source, 33)
    ManualConsumeReplace(target, source)
    assert(target.len == 2, "manual-consume target length")
    assert(target[0] == 22 && target[1] == 33,
           "manual-consume target payload")
    echo("manual_consume_runtime_semantics=ok")
    echo("compiler_csg_manual_consume_lowering_bridge_smoke: ok")
