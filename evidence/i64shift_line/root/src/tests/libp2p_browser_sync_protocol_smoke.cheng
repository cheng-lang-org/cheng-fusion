import std/system
import cheng/apps/libp2p_browser/sync_protocol as sync

fn fail(code: int32, msg: str): int32 =
    echo(msg)
    return code

fn main(): int32 =
    var nav = sync.BrowserSyncNavigate("https://ex.test/a", 3)
    let wire = sync.BrowserSyncEncode(nav)
    if wire.len <= 0:
        return fail(1, "encode nav")
    var decoded: sync.BrowserSyncMessage
    if !sync.BrowserSyncDecode(wire, decoded):
        return fail(2, "decode nav")
    if decoded.kind != sync.BrowserSyncKindNavigate:
        return fail(3, "kind")
    if decoded.url != "https://ex.test/a":
        return fail(4, "url")
    if decoded.epoch != 3:
        return fail(5, "epoch")
    var input = sync.BrowserSyncInput("q", "a;b|c", "https://ex.test/a", 3)
    let inputWire = sync.BrowserSyncEncode(input)
    if inputWire.len <= 0:
        return fail(6, "encode input")
    var inputDecoded: sync.BrowserSyncMessage
    if !sync.BrowserSyncDecode(inputWire, inputDecoded):
        return fail(7, "decode input")
    if inputDecoded.fieldId != "q" || inputDecoded.value != "a;b|c":
        echo(inputDecoded.value)
        return fail(8, "input payload")
    if sync.BrowserSyncDecode("NOPE", decoded):
        return fail(9, "bad magic")
    if sync.BrowserSyncDecode("CLB1;9;0;0;;0;;0;;0;0;0;", decoded):
        return fail(10, "bad kind")
    echo("libp2p_browser_sync_protocol_smoke ok")
    return 0
