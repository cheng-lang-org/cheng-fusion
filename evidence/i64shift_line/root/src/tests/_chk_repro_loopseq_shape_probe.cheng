import std/system as system

# Case probe 5: which ingredient makes a loop-grown local seq survive its scope?
#
# Case probe 4 established: straight-line `str[]` locals are released, a
# `str[]` grown inside a `while` leaks one block, and an explicit `= []`
# fixes it.  This run separates the three candidate ingredients -- loop vs
# straight line, managed vs unmanaged element, one growth vs many -- so the
# compiler-side fix targets the right predicate instead of the whole seq class.
#
# Exit code packs one base-8 digit per worker; every delta is taken ACROSS the
# worker call in `main`.
#   digit0  int32[] + while, 8 adds            (unmanaged element, loop)
#   digit1  str[]   + while, 1 add             (managed element, single add)
#   digit2  str[]   + for-range, 8 adds
#   digit3  str[]   + 1 add before + 1 in loop
#   digit4  str[]   + while, 8 adds, then `= []`   (control: expect 0)
#   digit5  int32[] + while, 8 adds, then `= []`   (control: expect 0)

var probeSink: int32

fn WorkerIntLoop(count: int32): int32 =
    var values: int32[]
    var i: int32
    while i < count:
        add(values, i)
        i = i + 1
    return values.len + values[count - 1]

fn WorkerStrLoopOnce(seed: int32): int32 =
    var names: str[]
    var i: int32
    while i < 1:
        add(names, Fmt"s{Int32(seed)}")
        i = i + 1
    return names.len + names[0].len

fn WorkerStrForRange(seed: int32): int32 =
    var names: str[]
    for i in 0..<8:
        add(names, Fmt"f{Int32(seed)}-{Int32(i)}")
    return names.len + names[7].len

fn WorkerStrBeforeAndInLoop(seed: int32): int32 =
    var names: str[]
    add(names, Fmt"b{Int32(seed)}")
    var i: int32
    while i < 1:
        add(names, Fmt"c{Int32(seed)}")
        i = i + 1
    return names.len + names[1].len

fn WorkerStrLoopExplicit(seed: int32): int32 =
    var names: str[]
    var i: int32
    while i < 8:
        add(names, Fmt"e{Int32(seed)}-{Int32(i)}")
        i = i + 1
    let observed = names.len + names[7].len
    names = []
    return observed

fn WorkerIntLoopExplicit(count: int32): int32 =
    var values: int32[]
    var i: int32
    while i < count:
        add(values, i)
        i = i + 1
    let observed = values.len + values[count - 1]
    values = []
    return observed

fn Digit(value: int64, weight: int64): int64 =
    if value < 0:
        return 7 * weight
    if value > 6:
        return 6 * weight
    return value * weight

fn main(): int32 =
    var acc: int32
    let b0 = system.MemLiveAllocations()
    acc = acc + WorkerIntLoop(8)
    let d0 = system.MemLiveAllocations() - b0
    let b1 = system.MemLiveAllocations()
    acc = acc + WorkerStrLoopOnce(acc + 3)
    let d1 = system.MemLiveAllocations() - b1
    let b2 = system.MemLiveAllocations()
    acc = acc + WorkerStrForRange(acc + 5)
    let d2 = system.MemLiveAllocations() - b2
    let b3 = system.MemLiveAllocations()
    acc = acc + WorkerStrBeforeAndInLoop(acc + 7)
    let d3 = system.MemLiveAllocations() - b3
    let b4 = system.MemLiveAllocations()
    acc = acc + WorkerStrLoopExplicit(acc + 11)
    let d4 = system.MemLiveAllocations() - b4
    let b5 = system.MemLiveAllocations()
    acc = acc + WorkerIntLoopExplicit(8)
    let d5 = system.MemLiveAllocations() - b5
    probeSink = acc
    if acc <= 0:
        return 99
    let packed = Digit(d0, 1) +
                 Digit(d1, 8) +
                 Digit(d2, 64) +
                 Digit(d3, 512) +
                 Digit(d4, 4096) +
                 Digit(d5, 32768)
    return int32(packed)
