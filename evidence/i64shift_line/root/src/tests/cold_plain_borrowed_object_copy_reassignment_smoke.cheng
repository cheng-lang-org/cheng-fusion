type GatePlainBorrowedPair =
    left: int32
    right: int32

@borrows
fn GatePlainBorrowedPairNext(
        value: GatePlainBorrowedPair):
        GatePlainBorrowedPair =
    var out: GatePlainBorrowedPair
    out.left = value.left + 1
    out.right = value.right
    return out

@borrows
fn GatePlainBorrowedPairFold(
        start: GatePlainBorrowedPair,
        steps: int32): GatePlainBorrowedPair =
    var current = start
    var index: int32
    while index < steps:
        current = GatePlainBorrowedPairNext(current)
        index = index + 1
    return current

fn main(): int32 =
    var start: GatePlainBorrowedPair
    start.left = 10
    start.right = 20
    let result = GatePlainBorrowedPairFold(start, 3)
    if result.left != 13:
        return 1
    if result.right != 20:
        return 2
    return 0
