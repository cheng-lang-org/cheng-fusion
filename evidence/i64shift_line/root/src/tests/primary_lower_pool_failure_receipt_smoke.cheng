import std/rawbytes as rawbytes
import cheng/core/backend/primary_object_plan as primary
import cheng/core/backend2/backend2_frag_codec as codec

fn main(): int32 =
    var error: primary.PrimaryObjectError
    error.functionName = "failure-receipt"
    error.functionSourcePath = "/workspace/failure.cheng"
    var payload = primary.PrimaryLowerPoolFailureReceiptEncode(error)
    if !primary.PrimaryLowerPoolFailureReceiptPrevalidate(payload):
        return 1
    let decoded = primary.PrimaryLowerPoolFailureReceiptDecode(payload)
    if !primary.PrimaryLowerPoolFailureReceiptEquivalent(error, decoded):
        return 2

    var oldHeader = rawbytes.BytesAlloc(payload.len + 4)
    rawbytes.BytesCopyRangeInto(oldHeader, 0, payload, 0, 4)
    codec.Backend2CodecPutU32(oldHeader, 4, 1)
    rawbytes.BytesCopyRangeInto(oldHeader, 8, payload, 4, payload.len - 4)
    if primary.PrimaryLowerPoolFailureReceiptPrevalidate(oldHeader):
        return 3

    let truncated = rawbytes.BytesSliceView(payload, 0, payload.len - 1)
    var trailing = rawbytes.BytesAlloc(payload.len + 1)
    rawbytes.BytesCopyRangeInto(trailing, 0, payload, 0, payload.len)
    rawbytes.BytesSet(trailing, payload.len, 0x5a)
    if primary.PrimaryLowerPoolFailureReceiptPrevalidate(truncated) ||
       primary.PrimaryLowerPoolFailureReceiptPrevalidate(trailing):
        return 4

    codec.Backend2CodecPutU32(payload, 4, 43)
    if primary.PrimaryLowerPoolFailureReceiptPrevalidate(payload):
        return 5
    rawbytes.BytesFree(payload)
    rawbytes.BytesFree(oldHeader)
    rawbytes.BytesFree(trailing)
    echo("primary_lower_pool_failure_receipt_smoke ok")
    return 0
