# DePIN inference pipeline protocol smoke(binary frame validation).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/protocols/depin/inference_pipeline_protocol

fn depinProtocolSmokeWriteI64LE(buf: var Bytes, offset: int32, value: int64) =
    BytesSet(buf, offset, int32(value & int64(255)))
    BytesSet(buf, offset + 1, int32((value >> 8) & int64(255)))
    BytesSet(buf, offset + 2, int32((value >> 16) & int64(255)))
    BytesSet(buf, offset + 3, int32((value >> 24) & int64(255)))
    BytesSet(buf, offset + 4, int32((value >> 32) & int64(255)))
    BytesSet(buf, offset + 5, int32((value >> 40) & int64(255)))
    BytesSet(buf, offset + 6, int32((value >> 48) & int64(255)))
    BytesSet(buf, offset + 7, int32((value >> 56) & int64(255)))

fn depinProtocolSmokeFrame(kind: int64): Bytes =
    var frame: Bytes = BytesAlloc(depinInferenceWireFrameBytes)
    depinProtocolSmokeWriteI64LE(frame, 0, int64(depinInferenceWireFrameMagic))
    depinProtocolSmokeWriteI64LE(frame, 8, kind)
    depinProtocolSmokeWriteI64LE(frame, 16, int64(101))
    depinProtocolSmokeWriteI64LE(frame, 24, int64(0))
    depinProtocolSmokeWriteI64LE(frame, 32, int64(201))
    depinProtocolSmokeWriteI64LE(frame, 40, int64(202))
    depinProtocolSmokeWriteI64LE(frame, 48, int64(203))
    depinProtocolSmokeWriteI64LE(frame, 56, int64(204))
    depinProtocolSmokeWriteI64LE(frame, 64, int64(301))
    depinProtocolSmokeWriteI64LE(frame, 72, int64(0))
    depinProtocolSmokeWriteI64LE(frame, 80, int64(0))
    depinProtocolSmokeWriteI64LE(frame, 88, int64(401))
    depinProtocolSmokeWriteI64LE(frame, 96, int64(0))
    depinProtocolSmokeWriteI64LE(frame, 104, int64(501))
    depinProtocolSmokeWriteI64LE(frame, 112, int64(601))
    if kind == int64(depinInferenceWireFrameKindResponse):
        depinProtocolSmokeWriteI64LE(frame, 72, int64(302))
        depinProtocolSmokeWriteI64LE(frame, 80, int64(303))
        depinProtocolSmokeWriteI64LE(frame, 96, int64(304))
    return frame

fn main(): int32 =
    let requestFrame = depinProtocolSmokeFrame(int64(depinInferenceWireFrameKindRequest))
    let requestValidate = depinInferenceValidateWireFrameBytes(requestFrame)
    if IsErr(requestValidate):
        return 1

    let responseFrame = depinProtocolSmokeFrame(int64(depinInferenceWireFrameKindResponse))
    let responseValidate = depinInferenceValidateWireFrameBytes(responseFrame)
    if IsErr(responseValidate):
        return 2

    var badMagic = depinProtocolSmokeFrame(int64(depinInferenceWireFrameKindRequest))
    depinProtocolSmokeWriteI64LE(badMagic, 0, int64(7))
    let badMagicValidate = depinInferenceValidateWireFrameBytes(badMagic)
    if IsOk(badMagicValidate):
        return 3

    var badResponse = depinProtocolSmokeFrame(int64(depinInferenceWireFrameKindResponse))
    depinProtocolSmokeWriteI64LE(badResponse, 96, int64(0))
    let badResponseValidate = depinInferenceValidateWireFrameBytes(badResponse)
    if IsOk(badResponseValidate):
        return 4

    let handlerFrame = DepinInferencePipelineHandleFrameBytes(requestFrame)
    if IsErr(handlerFrame):
        return 5

    let badHandlerFrame = DepinInferencePipelineHandleFrameBytes(badMagic)
    if IsOk(badHandlerFrame):
        return 6

    echo(" depin_inference_pipeline_protocol_smoke ok")
    return 0
