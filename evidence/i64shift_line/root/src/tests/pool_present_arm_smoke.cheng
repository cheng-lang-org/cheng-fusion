# pool_present_arm_smoke.cheng — sm1 线 2026-09-13
# 目标:池化接收路径(BACKEND_JOBS>=2)的 schedule present 臂(非空已封 field-17)
# 测试覆盖缺口。触发面 = 嵌套 Fmt 插值产生的托管 str 临时(与
# cold_nested_fmt_interpolation_smoke 同族,P1 probe10 实测该族 helper body 为
# sealed=1 owner>0 unit>0 的 present 臂),2 个 body 保证池化批真实接线。
# 契约:托管串值往返正确时 run rc=0,否则 rc=1。
# 注:托管串只在比较中消费;更富形态(let 绑定调用结果作实参、int-only Fmt
# 第二 helper、同 helper 双调用)会撞借用门控/CSGC cargo admission/所有权生产
# 三处既有非预校验门,见 .rebuild/sm1_line/REPORT.md,F0/F1/F2。
fn presentWrap(name: str, ordinal: int32): str =
    return Fmt"outer={Fmt\"inner={name}-{ordinal}\"}"

fn main(): int32 =
    let wrapped = presentWrap("asset", 7)
    if wrapped == "outer=inner=asset-7":
        echo("pool_present_arm=pass")
        return 0
    echo("pool_present_arm=fail")
    return 1
