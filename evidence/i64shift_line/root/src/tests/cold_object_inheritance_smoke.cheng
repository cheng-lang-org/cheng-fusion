type
    ColdInheritanceBase =
        inheritedValue: int32 = 3

    ColdImplicitDerived = of ColdInheritanceBase
        localValue: int32 = 7

    ColdExplicitDerived = object of ColdInheritanceBase
        localValue: int32 = 11

    ColdRefDerived = ref object of ColdInheritanceBase
        localValue: int32 = 13

fn main(): int32 =
    if sizeof(ColdInheritanceBase) != 8:
        return 1
    if sizeof(ColdImplicitDerived) != 16:
        return 2
    if sizeof(ColdExplicitDerived) != 16:
        return 3

    var implicitValue: ColdImplicitDerived
    if implicitValue.inheritedValue != 3:
        return 4
    if implicitValue.localValue != 7:
        return 5
    implicitValue.inheritedValue = 19
    implicitValue.localValue = 23
    if implicitValue.inheritedValue != 19 ||
       implicitValue.localValue != 23:
        return 6

    var explicitValue: ColdExplicitDerived
    if explicitValue.inheritedValue != 3 ||
       explicitValue.localValue != 11:
        return 7

    let refValue = new(ColdRefDerived)
    if refValue == nil:
        return 8
    if refValue.inheritedValue != 3:
        return 9
    if refValue.localValue != 13:
        return 10
    refValue.inheritedValue = 29
    refValue.localValue = 31
    if refValue.inheritedValue != 29 ||
       refValue.localValue != 31:
        return 11
    return 0
