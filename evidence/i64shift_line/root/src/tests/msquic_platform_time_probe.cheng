import cheng/quic/platform/time as qtime

@importc("cheng_monotime_ns")
fn msquicPlatformTimeProbeMonoTimeNs(): int64

fn main(): int32 =
    let direct0 = msquicPlatformTimeProbeMonoTimeNs() / 1000000
    let q0 = qtime.MsQuicPlatformNowMsForProbe()
    let direct1 = msquicPlatformTimeProbeMonoTimeNs() / 1000000
    let q1 = qtime.MsQuicPlatformNowMsForProbe()
    echo(Fmt" msquic_platform_time_probe direct0={direct0} q0={q0} direct1={direct1} q1={q1}")
    assert(direct0 > int64(0), " msquic platform time: direct0")
    assert(direct1 >= direct0, " msquic platform time: direct order")
    assert(q0 > int64(0), " msquic platform time: q0")
    assert(q1 >= q0, " msquic platform time: q order")
    return 0
