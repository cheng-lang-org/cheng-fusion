type
    ColdWrongCliConfig =
        command: str
        model: str
        cwd: str
        resume: bool
        resumeSessionId: str
        profile: str
        configOverrides: str[]
        addDirs: str[]
        images: str[]
        parseError: str

fn ColdWrongCliConfigTouch(): int32 =
    var cfg: ColdWrongCliConfig
    cfg.command = "exec"
    cfg.profile = "default"
    if cfg.command != "exec":
        return 1
    return 0
