import std/seqs as seqs

fn main(): int32 =
    var values: str[] = ["alpha", "beta", "gamma"]
    values[1] = "delta"
    if values.len != 3 || values[0] != "alpha" ||
       values[1] != "delta" || values[2] != "gamma":
        return 1

    seqs.SetLen(values, 2)
    if values.len != 2 || values[0] != "alpha" || values[1] != "delta":
        return 2

    seqs.SetLen(values, 4)
    if values.len != 4 || values[0] != "alpha" || values[1] != "delta":
        return 3
    if len(values[2]) != 0 || len(values[3]) != 0:
        return 4

    values[2] = "epsilon"
    values[3] = "zeta"
    if values[2] != "epsilon" || values[3] != "zeta":
        return 5

    seqs.SetLen(values, 1)
    seqs.SetLen(values, 3)
    if values.len != 3 || values[0] != "alpha":
        return 6
    if len(values[1]) != 0 || len(values[2]) != 0:
        return 7
    seqs.SetLen(values, -1)
    if values.len != 0:
        return 8
    return 0

main()
