import cheng/core/runtime/browser_provider as provider
import std/result

fn main(): int32 =
    assert(provider.BitBrowserDefaultLocalApiPort == 54345, " bitbrowser provider: default api port")

    let bodyRes = provider.BitBrowserOpenRequestJson("profile-1")
    assert(IsOk(bodyRes), " bitbrowser provider: request body")
    assert(Value(bodyRes) == "{\"id\":\"profile-1\"}", " bitbrowser provider: request body value")

    let escapedBodyRes = provider.BitBrowserOpenRequestJson("profile\"x")
    assert(IsOk(escapedBodyRes), " bitbrowser provider: escaped request body")
    assert(Value(escapedBodyRes) == "{\"id\":\"profile\\\"x\"}", " bitbrowser provider: escaped request body value")

    let emptyBodyRes = provider.BitBrowserOpenRequestJson("")
    assert(IsErr(emptyBodyRes), " bitbrowser provider: empty profile hard fail")

    let okJson = "{\"success\":true,\"data\":{\"ws\":\"ws://127.0.0.1:54321/devtools/browser/session\",\"http\":\"http://127.0.0.1:54321\",\"driver\":\"/tmp/chromedriver\",\"coreVersion\":\"118\"}}"
    let sessionRes = provider.BitBrowserSessionFromOpenResponse("profile-1", okJson)
    assert(IsOk(sessionRes), " bitbrowser provider: parse open response")
    let session = Value(sessionRes)
    assert(provider.BrowserSessionReady(session), " bitbrowser provider: session ready")
    assert(session.provider == provider.BrowserProviderBitBrowser, " bitbrowser provider: provider")
    assert(session.profileId == "profile-1", " bitbrowser provider: profile")
    assert(session.wsUrl == "ws://127.0.0.1:54321/devtools/browser/session", " bitbrowser provider: ws")
    assert(session.httpDebugAddress == "http://127.0.0.1:54321", " bitbrowser provider: http")
    assert(session.debugPort == 54321, " bitbrowser provider: port")
    assert(session.driverPath == "/tmp/chromedriver", " bitbrowser provider: driver")
    assert(session.coreVersion == "118", " bitbrowser provider: core")

    let missingWs = "{\"success\":true,\"data\":{\"http\":\"http://127.0.0.1:54321\"}}"
    let missingWsRes = provider.BitBrowserSessionFromOpenResponse("profile-1", missingWs)
    assert(IsErr(missingWsRes), " bitbrowser provider: missing ws hard fail")

    let remoteWs = "{\"success\":true,\"data\":{\"ws\":\"ws://10.0.0.2:54321/devtools/browser/session\",\"http\":\"http://10.0.0.2:54321\"}}"
    let remoteWsRes = provider.BitBrowserSessionFromOpenResponse("profile-1", remoteWs)
    assert(IsErr(remoteWsRes), " bitbrowser provider: remote ws hard fail")

    let failedOpen = "{\"success\":false,\"data\":{\"ws\":\"ws://127.0.0.1:54321/devtools/browser/session\",\"http\":\"http://127.0.0.1:54321\"}}"
    let failedOpenRes = provider.BitBrowserSessionFromOpenResponse("profile-1", failedOpen)
    assert(IsErr(failedOpenRes), " bitbrowser provider: unsuccessful open hard fail")

    echo(" browser_provider_bitbrowser_smoke ok")
    return 0
