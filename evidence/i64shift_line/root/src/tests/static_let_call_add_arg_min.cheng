# let-bound call result used in a later call argument as `c0 + v1`.
fn leaf(x: int32, y: int32): int32 =
    return x + y

fn mid(a: int32, b: int32): int32 =
    var acc: int32
    acc = a
    let v1 = acc + b
    let c0 = leaf(acc, v1)
    let c1 = leaf(c0 + v1, b)
    acc = acc + c0 - c1
    return acc

fn main(): int32 =
    return mid(3, 7)
