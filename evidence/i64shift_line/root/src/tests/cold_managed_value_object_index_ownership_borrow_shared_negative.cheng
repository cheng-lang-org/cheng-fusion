type ColdManagedIndexBorrowSharedRecord =
    key: str

type ColdManagedIndexBorrowSharedBox =
    records: ColdManagedIndexBorrowSharedRecord[]

fn ColdManagedIndexBorrowSharedClear(
        records: var ColdManagedIndexBorrowSharedRecord[]) =
    records = []

fn main(): int32 =
    let box = ColdManagedIndexBorrowSharedBox()
    var records = box.records
    ColdManagedIndexBorrowSharedClear(records)
    return 0
