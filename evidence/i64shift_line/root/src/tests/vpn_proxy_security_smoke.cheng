import std/result
import cheng/http3/frame as http3
import cheng/qpack/min as qpack
import cheng/quic/msquicruntime as qruntime
import cheng/apps/vpn_proxy/vpn_proxy_main as vpn
import cheng/hysteria2/hysteria2_protocol as hy2

fn headerValue(fields: qpack.QpackHeaderField[], name: str): str =
    for i in 0..<fields.len:
        if fields[i].name == name:
            return fields[i].value
    return ""

fn main(): int32 =
    assert(vpn.VpnProxySha256Hex("abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
           " vpn proxy security sha256 vector")
    assert(vpn.VpnProxyConstantTimeAsciiEq("same", "same"),
           " vpn proxy security constant time equal")
    assert(!vpn.VpnProxyConstantTimeAsciiEq("same", "same2"),
           " vpn proxy security constant time length")
    assert(!vpn.VpnProxyConstantTimeAsciiEq("same", "sane"),
           " vpn proxy security constant time content")
    assert(vpn.VpnProxyAuthMatches("secret-token",
                                    "",
                                    "930bbdc51b6aed5c2a5678fd6e28dee7a05e8a4b643cfc0b4427c3efb86c0d94"),
           " vpn proxy security auth hash matches")
    assert(!vpn.VpnProxyAuthMatches("wrong-token",
                                     "",
                                     "930bbdc51b6aed5c2a5678fd6e28dee7a05e8a4b643cfc0b4427c3efb86c0d94"),
           " vpn proxy security auth hash rejects")

    var settings = qruntime.initMsQuicSettings()
    assert(IsOk(vpn.VpnProxyRequireNo0Rtt(settings)),
           " vpn proxy security default no 0rtt")
    settings.allow0Rtt = true
    let zeroRttRes: Result[bool] = vpn.VpnProxyRequireNo0Rtt(settings)
    assert(IsErr(zeroRttRes), " vpn proxy security rejects 0rtt")
    assert(ErrorText(zeroRttRes) == "vpn proxy: 0-rtt disabled",
           " vpn proxy security rejects 0rtt text")

    let masqRes: Result[Bytes] = hy2.Hysteria2EncodeMasqueradeResponseFrame(200, "ok")
    assert(IsOk(masqRes), " vpn proxy security masquerade encode")
    let frameRes: Result[http3.Http3FrameDecoded] = http3.Http3DecodeFrame(Value(masqRes), 0)
    assert(IsOk(frameRes), " vpn proxy security masquerade frame")
    assert(Value(frameRes).frame.kind == http3.Http3FrameHeaders,
           " vpn proxy security masquerade headers")
    let fieldsRes = http3.Http3DecodeHeadersFramePayload(Value(frameRes).frame.payload)
    assert(IsOk(fieldsRes), " vpn proxy security masquerade qpack")
    assert(headerValue(Value(fieldsRes).fields, ":status") == "200",
           " vpn proxy security masquerade status")
    assert(headerValue(Value(fieldsRes).fields, "content-length") == "2",
           " vpn proxy security masquerade length")

    echo(" vpn_proxy_security_smoke ok")
    return 0
