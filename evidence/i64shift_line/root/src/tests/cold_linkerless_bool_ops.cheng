module cold_linkerless_bool_ops

fn test_and(): int32 =
    let a: bool = true
    let b: bool = false
    let r1: bool = a && b
    if r1 != false:
        return 1
    let r2: bool = a && true
    if r2 != true:
        return 2
    let r3: bool = false && false
    if r3 != false:
        return 3
    return 0

fn test_or(): int32 =
    let a: bool = true
    let b: bool = false
    let r1: bool = a || b
    if r1 != true:
        return 1
    let r2: bool = b || false
    if r2 != false:
        return 2
    let r3: bool = b || true
    if r3 != true:
        return 3
    return 0

fn test_not(): int32 =
    let a: bool = true
    let r1: bool = !a
    if r1 != false:
        return 1
    let b: bool = false
    let r2: bool = !b
    if r2 != true:
        return 2
    let r3: bool = !!a
    if r3 != true:
        return 3
    return 0

fn test_mixed(): int32 =
    let a: bool = true
    let b: bool = false
    let r1: bool = a && !b
    if r1 != true:
        return 1
    let r2: bool = !a || b
    if r2 != false:
        return 2
    let r3: bool = !(a && b)
    if r3 != true:
        return 3
    return 0

fn main(): int32 =
    let r1 = test_and()
    if r1 != 0:
        return r1
    let r2 = test_or()
    if r2 != 0:
        return 10 + r2
    let r3 = test_not()
    if r3 != 0:
        return 20 + r3
    let r4 = test_mixed()
    if r4 != 0:
        return 30 + r4
    return 0

main()
