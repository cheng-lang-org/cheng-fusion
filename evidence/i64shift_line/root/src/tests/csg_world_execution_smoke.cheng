# CSG world B-chain integration smoke:
#   produce -> validate (+ negatives) -> materialize -> execute 1200 ticks
#   -> derived grasp success, COM rise, determinism (double run), and the
#   support-removal intervention from a checkpoint.
import cheng/game/csg/schema
import cheng/game/csg/validation
import cheng/game/csg/producer
import cheng/game/csg/materializer
import cheng/game/csg/execution
import cheng/game/csg/numerics
import cheng/game/world3d
import cheng/game/rope3d
import cheng/game/physics3d
import std/strings as strings
import std/math as m

fn fmtMm(x: float64): str =
    let scaled: int32 = int32(m.roundFloat(x * 1000.0))
    var neg: bool = scaled < 0
    var mag: int32 = scaled
    if neg:
        mag = 0 - mag
    let intPart: int32 = mag / 1000
    let fracPart: int32 = mag % 1000
    var outStr: str = ""
    if neg:
        outStr = "-"
    outStr = outStr + strings.IntToStr(intPart) + "." + strings.CloneStrRange(strings.IntToStr(fracPart + 1000), 1, 3)
    return outStr

# Runs the full chain for `ticks` ticks; returns nothing, fills outputs.
fn runChain(ticks: int32, finalCid: var str, chainCid: var str,
            comStart: var float64, comEnd: var float64,
            graspOk: var int32, graspFail: var int32): bool =
    var facts: schema.CsgWorldFacts = producer.CsgProducerBuildClimbScene()
    var verdict = validation.CsgValidateFacts(facts)
    if verdict.statusCode != validation.CsgValidOk:
        echo("FAIL validation status=" + strings.IntToStr(verdict.statusCode))
        return false
    var w: world3d.World3d
    var mp: materializer.CsgMaterializerMapping
    var err: str = ""
    if !materializer.CsgMaterialize(facts, w, mp, err):
        echo("FAIL materialize: " + err)
        return false
    if !World3dValid(w):
        echo("FAIL world valid")
        return false
    var st: execution.CsgExecutionState
    execution.CsgExecutionInit(st, facts, w, mp.partSlot, mp.ropeNodeSlot)
    # settle into the hang first, then measure the climb from there
    var sI: int32 = 0
    while sI < 120:
        let _settle = execution.CsgExecutionTick(st, facts)
        sI = sI + 1
    comStart = World3dComZ(st.w)
    var i: int32 = 0
    while i < ticks - 120:
        var receipt = execution.CsgExecutionTick(st, facts)
        if receipt.statusCode != physics3d.Physics3dStatusOk:
            echo("rejected at tick=" + strings.Int64ToStr(receipt.tick) + " status=" + strings.IntToStr(receipt.statusCode) + " residMm=" + fmtMm(receipt.maxResidualMm))
            var dbgI: int32 = 0
            while dbgI < st.w.conCount:
                if st.w.conActive[dbgI] == 1:
                    let aS = st.w.conA[dbgI]
                    let bS = st.w.conB[dbgI]
                    let dx = st.w.bodyPx[bS] - st.w.bodyPx[aS]
                    let dy = st.w.bodyPy[bS] - st.w.bodyPy[aS]
                    let dz = st.w.bodyPz[bS] - st.w.bodyPz[aS]
                    let d = numerics.CsgSqrt(dx * dx + dy * dy + dz * dz)
                    echo("con" + strings.IntToStr(dbgI) + " kind=" + strings.IntToStr(st.w.conKind[dbgI]) + " d_mm=" + fmtMm(d * 1000.0) + " rest_mm=" + fmtMm(st.w.conRest[dbgI] * 1000.0) + " tgt_mm=" + fmtMm(st.w.conTarget[dbgI] * 1000.0))
                dbgI = dbgI + 1
            return false
        i = i + 1
    comEnd = World3dComZ(st.w)
    var ev: int32 = 0
    while ev < st.eventCount:
        echo("ev t=" + strings.Int64ToStr(execution.CsgExecutionEventTickAt(st, ev)) + " kind=" + strings.IntToStr(execution.CsgExecutionEventKindAt(st, ev)))
        ev = ev + 1
    finalCid = Fmt"{World3dCid(st.w)}"
    chainCid = Fmt"{st.chainCid}"
    graspOk = st.graspOkCount
    graspFail = st.graspFailCount
    echo("steps=" + strings.Int64ToStr(st.stepCount) + " rejected=" + strings.IntToStr(st.rejectedCount) + " graspOk=" + strings.IntToStr(graspOk) + " graspFail=" + strings.IntToStr(graspFail) + " comRiseMm=" + fmtMm((comEnd - comStart) * 1000.0))
    return true

fn main(): int32 =
    # negatives first: tampered facts must be rejected with precise codes
    var bad: schema.CsgWorldFacts = producer.CsgProducerBuildClimbScene()
    bad.partMassKg[0] = 0.0 - 1.0
    var badVerdict = validation.CsgValidateFacts(bad)
    if badVerdict.statusCode != validation.CsgValidBadMass:
        echo("FAIL negative mass expected 3 got " + strings.IntToStr(badVerdict.statusCode))
        return 1
    var bad2: schema.CsgWorldFacts = producer.CsgProducerBuildClimbScene()
    bad2.actionKind[0] = 99
    var badVerdict2 = validation.CsgValidateFacts(bad2)
    if badVerdict2.statusCode != validation.CsgValidUnknownActionKind:
        echo("FAIL negative action expected 12 got " + strings.IntToStr(badVerdict2.statusCode))
        return 1
    # positive chain, run twice for determinism
    var cidA: str = ""
    var chainA: str = ""
    var comStartA: float64 = 0.0
    var comEndA: float64 = 0.0
    var okA: int32 = 0
    var failA: int32 = 0
    if !runChain(2400, cidA, chainA, comStartA, comEndA, okA, failA):
        return 1
    var cidB: str = ""
    var chainB: str = ""
    var comStartB: float64 = 0.0
    var comEndB: float64 = 0.0
    var okB: int32 = 0
    var failB: int32 = 0
    if !runChain(2400, cidB, chainB, comStartB, comEndB, okB, failB):
        return 1
    if cidA != cidB:
        echo("FAIL determinism world cid")
        return 1
    if chainA != chainB:
        echo("FAIL determinism chain cid")
        return 1
    if okA < 1:
        echo("FAIL expected at least one grasp ok")
        return 1
    if comEndA - comStartA < 0.3:
        echo("FAIL expected early rise, got " + fmtMm((comEndA - comStartA) * 1000.0) + "mm")
        return 1
    echo("PASS csg world execution smoke")
    return 0
