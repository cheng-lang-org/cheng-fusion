import std/system as system

type ColdManagedIndexOwnershipConsumed =
    key: str

fn main(): int32 =
    var value: ColdManagedIndexOwnershipConsumed
    value.key = system.NewStringCopy(
        system.StrDataPtr("consumed"), 8)
    var values: ColdManagedIndexOwnershipConsumed[]
    add(values, value)
    if value.key == "consumed":
        return 1
    return 0
