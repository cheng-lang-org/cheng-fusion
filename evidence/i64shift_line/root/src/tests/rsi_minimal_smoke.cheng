# 纯 std 最小语料 (编译器域 C1 候选面, 2026-09-08 冻结):
# 零 csg_core/ecs/kernel 依赖 —— pure_driver (kernel 闭包子集) 的
# 确定性可编面。注: 当前 C1 档 0 由 types.RsiCompilerCorpusRel(0)=
# src/tests/physics2d_determinism_smoke.cheng 定义 (唯一开放档);
# 本文件待 kernel 战役清墙后重新冻结/接线, 语料 CID 由 gate/cdomain
# 每次实测记入事实。
import std/strings as strings

fn main(): int32 =
    var total: int64
    for i in range(200):
        total = total + int64(i * i)
    let text = strings.Int64ToStr(total)
    assert(len(text) > 0, "rsi minimal: total rendered")
    # 值敏感语义锚: 输出计算结果哈希 (2026-09-09 强化)——空输出指纹无法
    # 区分静默错译 (跳过计算仍 rc0 空输出), 补 echo 使指纹绑定计算值。
    echo(strings.Sha256(text))
    return 0
