# Runtime self-check driver for
# src/core/runtime/production_held_exec_event_issuer.cheng.
#
# The issuer ships CsgCoreProductionHeldExecEventIssuerSelfCheckInto, a
# monolithic self-check that never ran because cheng_cold requires --in to
# live inside the package root and no entry file existed. This file is that
# entry: it re-executes every arm through the issuer's public API so each
# arm gets its own PASS/FAIL line with evidence, then runs the issuer's own
# SelfCheckInto as the gold arm. rc=0 iff every arm passes; rc=1 otherwise.
#
# No mocks, no fixtures from outside: all identities are built here from the
# provider's own CsgCoreProductionHeldExecProviderIdentityCid (real stat-
# shaped identity, same construction the issuer's self-check uses).

import std/os
import std/strings
import std/strutils as strutil
import cheng/core/runtime/production_held_exec_provider as held_exec_provider
import cheng/core/runtime/production_held_exec_event_issuer as issuer

const
    csgHeldExecIssuerMainCidNonce: str =
        "sha256:0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a"
    csgHeldExecIssuerMainCidCapability: str =
        "sha256:0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b"
    csgHeldExecIssuerMainCidAuthority: str =
        "sha256:0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c"
    csgHeldExecIssuerMainCidChild: str =
        "sha256:0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d"
    csgHeldExecIssuerMainCidLauncherBytes: str =
        "sha256:0e0e0e0e0e0e0e0e0e0e0e0e0e0e0e0e0e0e0e0e0e0e0e0e0e0e0e0e0e0e0e0e"
    csgHeldExecIssuerMainCidLauncherAnchor: str =
        "sha256:0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f"
    csgHeldExecIssuerMainCidLauncherImmutable: str =
        "sha256:1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a"
    csgHeldExecIssuerMainCidLauncherToken: str =
        "sha256:1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b"
    csgHeldExecIssuerMainCidBinaryBytes: str =
        "sha256:1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c"
    csgHeldExecIssuerMainCidBinaryAnchor: str =
        "sha256:1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d"
    csgHeldExecIssuerMainCidBinaryImmutable: str =
        "sha256:1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e"
    csgHeldExecIssuerMainCidBinaryToken: str =
        "sha256:1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f"
    csgHeldExecIssuerMainCidArgv: str =
        "sha256:2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a"
    csgHeldExecIssuerMainCidEnvironment: str =
        "sha256:2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b"
    csgHeldExecIssuerMainCidPlan: str =
        "sha256:2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c"
    csgHeldExecIssuerMainCidProof: str =
        "sha256:2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d"
    csgHeldExecIssuerMainCidAdmission: str =
        "sha256:2e2e2e2e2e2e2e2e2e2e2e2e2e2e2e2e2e2e2e2e2e2e2e2e2e2e2e2e2e2e2e2e"
    csgHeldExecIssuerMainCidCommand: str =
        "sha256:2f2f2f2f2f2f2f2f2f2f2f2f2f2f2f2f2f2f2f2f2f2f2f2f2f2f2f2f2f2f2f2f"
    csgHeldExecIssuerMainCidInputSet: str =
        "sha256:3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a"
    csgHeldExecIssuerMainCidOutputContract: str =
        "sha256:3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b"

# Real stat-shaped identity fixture: every scalar is a concrete observed
# value, and heldDescriptorIdentityCid is derived through the provider's own
# identity hash — the same construction the issuer's self-check uses.
fn csgHeldExecIssuerMainIdentity(
        inode: uint64,
        bytesCid: str,
        anchorCid: str,
        immutableCid: str,
        tokenCid: str): held_exec_provider.CsgCoreProductionHeldExecIdentity =
    var out: held_exec_provider.CsgCoreProductionHeldExecIdentity
    out.device = uint64(9)
    out.inode = inode
    out.mode = 32841
    out.linkCount = uint64(1)
    out.size = int64(4096)
    out.ownerUid = uint64(0)
    out.ownerGid = uint64(0)
    out.mtimeSec = int64(1700000000)
    out.mtimeNsec = int64(31)
    out.ctimeSec = int64(1700000001)
    out.ctimeNsec = int64(37)
    out.bytesCid = bytesCid
    out.externalAnchorCid = anchorCid
    out.immutableReceiptCid = immutableCid
    out.heldDescriptorTokenCid = tokenCid
    out.heldDescriptorIdentityCid =
        held_exec_provider.CsgCoreProductionHeldExecProviderIdentityCid(out)
    return out

fn csgHeldExecIssuerMainPrint(
        name: str,
        ok: bool,
        evidence: str): int32 =
    var verdict: str
    if ok:
        verdict = "PASS"
    else:
        verdict = "FAIL"
    os.WriteLine(os.Get_stdout(), strutil.Join(
        [name, " ", verdict, " | ", evidence], ""))
    if ok:
        return 0
    return 1

fn main(): int32 =
    var failures: int32 = 0
    var err: str
    err = ""

    var launcherIdentity = csgHeldExecIssuerMainIdentity(
        uint64(41),
        csgHeldExecIssuerMainCidLauncherBytes,
        csgHeldExecIssuerMainCidLauncherAnchor,
        csgHeldExecIssuerMainCidLauncherImmutable,
        csgHeldExecIssuerMainCidLauncherToken)
    var binaryIdentity = csgHeldExecIssuerMainIdentity(
        uint64(43),
        csgHeldExecIssuerMainCidBinaryBytes,
        csgHeldExecIssuerMainCidBinaryAnchor,
        csgHeldExecIssuerMainCidBinaryImmutable,
        csgHeldExecIssuerMainCidBinaryToken)

    var params: issuer.CsgCoreProductionHeldExecEventIssuerParams
    params.sessionGeneration = uint64(7)
    params.sessionNonceCid =
        strings.CloneStr(csgHeldExecIssuerMainCidNonce)
    params.sessionCapabilityCid =
        strings.CloneStr(csgHeldExecIssuerMainCidCapability)
    params.providerAuthorityCid =
        strings.CloneStr(csgHeldExecIssuerMainCidAuthority)
    params.launcherHeldDescriptorIdentityCid =
        strings.CloneStr(launcherIdentity.heldDescriptorIdentityCid)
    params.binaryHeldDescriptorIdentityCid =
        strings.CloneStr(binaryIdentity.heldDescriptorIdentityCid)
    params.childProcessIdentityCid =
        strings.CloneStr(csgHeldExecIssuerMainCidChild)
    params.executableObjectCid =
        strings.CloneStr(binaryIdentity.bytesCid)
    params.argvCid = strings.CloneStr(csgHeldExecIssuerMainCidArgv)
    params.environmentCid =
        strings.CloneStr(csgHeldExecIssuerMainCidEnvironment)
    params.planReceiptCid =
        strings.CloneStr(csgHeldExecIssuerMainCidPlan)
    params.proofCid = strings.CloneStr(csgHeldExecIssuerMainCidProof)
    params.admissionReceiptCid =
        strings.CloneStr(csgHeldExecIssuerMainCidAdmission)
    params.executionMethod = strings.CloneStr(
        held_exec_provider.CsgCoreProductionHeldExecLinuxMethod)

    # arm01: zero-valued params must be refused with e_params.
    var badParams: issuer.CsgCoreProductionHeldExecEventIssuerParams
    var issuerBad: issuer.CsgCoreProductionHeldExecEventIssuer
    let ok01 =
        !issuer.CsgCoreProductionHeldExecEventIssuerInitInto(
            badParams, issuerBad, err) &&
        err == issuer.CsgCoreProductionHeldExecEventIssuerErrParams
    failures = failures + csgHeldExecIssuerMainPrint(
        "arm01_invalid_params_refused", ok01,
        strutil.Join(["err=", strings.CloneStr(err)], ""))

    # Shared negative issuer: valid init, never successfully issued.
    var issuerNeg: issuer.CsgCoreProductionHeldExecEventIssuer
    if !issuer.CsgCoreProductionHeldExecEventIssuerInitInto(
           params, issuerNeg, err):
        failures = failures + csgHeldExecIssuerMainPrint(
            "arm02_missing_evidence_refused", false,
            strutil.Join(
                ["init_unexpectedly_failed err=",
                 strings.CloneStr(err)], ""))
        failures = failures + csgHeldExecIssuerMainPrint(
            "arm03_mismatch_evidence_refused", false, "blocked_by_arm02")
        failures = failures + csgHeldExecIssuerMainPrint(
            "arm04_pre_admission_read_refused", false, "blocked_by_arm02")
    else:
        var eventNeg: held_exec_provider.CsgCoreProductionHeldExecEvent
        # arm02: uncollected evidence refused, issuer state untouched.
        var missingEvidence: issuer.CsgCoreProductionHeldExecStepEvidence
        let ok02 =
            !issuer.CsgCoreProductionHeldExecEventIssuerIssueNextInto(
                issuerNeg, missingEvidence, eventNeg, err) &&
            err ==
                issuer.CsgCoreProductionHeldExecEventIssuerErrEvidenceMissing &&
            issuerNeg.issuedCount == 0
        failures = failures + csgHeldExecIssuerMainPrint(
            "arm02_missing_evidence_refused", ok02,
            strutil.Join(
                ["err=", strings.CloneStr(err), " issuedCount=",
                 strings.IntToStr(issuerNeg.issuedCount)], ""))
        # arm03: evidence contradicting the frozen step-1 pattern refused.
        var mismatchEvidence: issuer.CsgCoreProductionHeldExecStepEvidence
        mismatchEvidence.collected = true
        mismatchEvidence.heldDescriptorExecutionObserved = true
        let ok03 =
            !issuer.CsgCoreProductionHeldExecEventIssuerIssueNextInto(
                issuerNeg, mismatchEvidence, eventNeg, err) &&
            err ==
                issuer.CsgCoreProductionHeldExecEventIssuerErrEvidenceMismatch &&
            issuerNeg.issuedCount == 0
        failures = failures + csgHeldExecIssuerMainPrint(
            "arm03_mismatch_evidence_refused", ok03,
            strutil.Join(
                ["err=", strings.CloneStr(err), " issuedCount=",
                 strings.IntToStr(issuerNeg.issuedCount)], ""))
        # arm04: any pre-admission input read refuses the event.
        var readEvidence: issuer.CsgCoreProductionHeldExecStepEvidence
        readEvidence.collected = true
        readEvidence.inputReadCountBeforeAdmission = int64(1)
        let ok04 =
            !issuer.CsgCoreProductionHeldExecEventIssuerIssueNextInto(
                issuerNeg, readEvidence, eventNeg, err) &&
            err ==
                issuer.CsgCoreProductionHeldExecEventIssuerErrEvidenceMismatch &&
            issuerNeg.issuedCount == 0
        failures = failures + csgHeldExecIssuerMainPrint(
            "arm04_pre_admission_read_refused", ok04,
            strutil.Join(
                ["err=", strings.CloneStr(err), " issuedCount=",
                 strings.IntToStr(issuerNeg.issuedCount)], ""))

    # arm05: full evidence-complete seven-event chain; per step assert
    # sequence increments, previousEventCid linkage, eventCid recomputation
    # and pairwise distinctness of adjacent eventCids.
    var issuerPos: issuer.CsgCoreProductionHeldExecEventIssuer
    var receipt: held_exec_provider.CsgCoreProductionHeldExecReceipt
    var chainReady = false
    if !issuer.CsgCoreProductionHeldExecEventIssuerInitInto(
           params, issuerPos, err):
        failures = failures + csgHeldExecIssuerMainPrint(
            "arm05_seven_event_chain", false,
            strutil.Join(
                ["init_unexpectedly_failed err=",
                 strings.CloneStr(err)], ""))
    else:
        receipt.schema = strings.CloneStr(
            held_exec_provider.CsgCoreProductionHeldExecProviderSchema)
        receipt.platform = strings.CloneStr(
            held_exec_provider.CsgCoreProductionHeldExecLinux)
        receipt.executionMethod = strings.CloneStr(
            held_exec_provider.CsgCoreProductionHeldExecLinuxMethod)
        receipt.executionScope = strings.CloneStr(
            held_exec_provider.CsgCoreProductionHeldExecScopeMilestones)
        receipt.sessionGeneration = params.sessionGeneration
        receipt.sessionNonceCid =
            strings.CloneStr(params.sessionNonceCid)
        receipt.sessionCapabilityCid =
            strings.CloneStr(params.sessionCapabilityCid)
        receipt.activationOrdinal = uint64(1)
        receipt.providerAuthorityCid =
            strings.CloneStr(params.providerAuthorityCid)
        receipt.launcherIdentity = launcherIdentity
        receipt.binaryIdentity = binaryIdentity
        receipt.childProcessIdentityCid =
            strings.CloneStr(params.childProcessIdentityCid)
        receipt.workload.executionScope = receipt.executionScope
        receipt.workload.commandCid =
            strings.CloneStr(csgHeldExecIssuerMainCidCommand)
        receipt.workload.inputSetCid =
            strings.CloneStr(csgHeldExecIssuerMainCidInputSet)
        receipt.workload.outputContractCid =
            strings.CloneStr(csgHeldExecIssuerMainCidOutputContract)
        receipt.workload.executableObjectCid =
            strings.CloneStr(params.executableObjectCid)
        receipt.workload.argvCid = strings.CloneStr(params.argvCid)
        receipt.workload.environmentCid =
            strings.CloneStr(params.environmentCid)
        receipt.workload.planReceiptCid =
            strings.CloneStr(params.planReceiptCid)
        receipt.workload.proofCid =
            strings.CloneStr(params.proofCid)
        receipt.workload.admissionReceiptCid =
            strings.CloneStr(params.admissionReceiptCid)
        var chainOk = true
        var lastCid: str
        lastCid = ""
        for step in 1..<8:
            var event: held_exec_provider.CsgCoreProductionHeldExecEvent
            var evidence: issuer.CsgCoreProductionHeldExecStepEvidence
            evidence.collected = true
            if step >= 4:
                evidence.admissionReceiptClosed = true
            if step >= 5:
                evidence.heldDescriptorExecutionObserved = true
                evidence.executionReleaseObserved = true
            if step == 7:
                evidence.outputPublicationObserved = true
            var stepOk = true
            if !issuer.CsgCoreProductionHeldExecEventIssuerIssueNextInto(
                   issuerPos, evidence, event, err):
                stepOk = false
            elif event.sequence != step ||
                 event.previousEventCid != lastCid ||
                 event.eventCid !=
                     held_exec_provider.CsgCoreProductionHeldExecProviderEventCid(
                         event) ||
                 event.eventCid == lastCid:
                stepOk = false
            if !stepOk:
                chainOk = false
            failures = failures + csgHeldExecIssuerMainPrint(
                strutil.Join(["arm05_step", strings.IntToStr(step)], ""),
                stepOk,
                strutil.Join(
                    ["seq=", strings.IntToStr(event.sequence),
                     " prevMatch+recomputed+distinct checked",
                     " eventCid=", strings.CloneStr(event.eventCid),
                     " err=", strings.CloneStr(err)], ""))
            if stepOk:
                lastCid = strings.CloneStr(event.eventCid)
                if step == 1:
                    receipt.activated = event
                elif step == 2:
                    receipt.launcherHeld = event
                elif step == 3:
                    receipt.binaryHeld = event
                elif step == 4:
                    receipt.zeroReadAdmitted = event
                elif step == 5:
                    receipt.heldExecStarted = event
                elif step == 6:
                    receipt.childObserved = event
                else:
                    receipt.consumed = event
        if chainOk &&
           issuer.CsgCoreProductionHeldExecEventIssuerComplete(issuerPos):
            chainReady = true
        failures = failures + csgHeldExecIssuerMainPrint(
            "arm05_seven_event_chain", chainReady,
            strutil.Join(
                ["issuedCount=",
                 strings.IntToStr(issuerPos.issuedCount)], ""))

    if !chainReady:
        failures = failures + csgHeldExecIssuerMainPrint(
            "arm06_receipt_consumer_gold_validate", false,
            "blocked_by_arm05")
        failures = failures + csgHeldExecIssuerMainPrint(
            "arm07_eighth_event_refused", false, "blocked_by_arm05")
        failures = failures + csgHeldExecIssuerMainPrint(
            "arm08_tampered_link_rejected", false, "blocked_by_arm05")
    else:
        # arm06: the issued chain passes the frozen consumer unchanged.
        receipt.eventStreamCid =
            held_exec_provider.CsgCoreProductionHeldExecProviderEventStreamCid(
                receipt)
        receipt.complete = true
        receipt.singleConsumptionProven = true
        receipt.receiptCid =
            held_exec_provider.CsgCoreProductionHeldExecProviderReceiptCid(
                receipt)
        let ok06 =
            held_exec_provider.CsgCoreProductionHeldExecProviderReceiptStrictValidateInto(
                receipt, err)
        failures = failures + csgHeldExecIssuerMainPrint(
            "arm06_receipt_consumer_gold_validate", ok06,
            strutil.Join(
                ["eventStreamCid=",
                 strings.CloneStr(receipt.eventStreamCid),
                 " receiptCid=", strings.CloneStr(receipt.receiptCid),
                 " err=", strings.CloneStr(err)], ""))
        # arm07: an eighth event is refused once the chain is complete.
        var doneEvidence: issuer.CsgCoreProductionHeldExecStepEvidence
        doneEvidence.collected = true
        doneEvidence.admissionReceiptClosed = true
        doneEvidence.heldDescriptorExecutionObserved = true
        doneEvidence.executionReleaseObserved = true
        doneEvidence.outputPublicationObserved = true
        var eventDone: held_exec_provider.CsgCoreProductionHeldExecEvent
        let ok07 =
            !issuer.CsgCoreProductionHeldExecEventIssuerIssueNextInto(
                issuerPos, doneEvidence, eventDone, err) &&
            err == issuer.CsgCoreProductionHeldExecEventIssuerErrComplete
        failures = failures + csgHeldExecIssuerMainPrint(
            "arm07_eighth_event_refused", ok07,
            strutil.Join(["err=", strings.CloneStr(err)], ""))
        # arm08: a corrupted chain link is rejected by the frozen consumer
        # with e_event_chain.
        receipt.binaryHeld.previousEventCid =
            strings.CloneStr(csgHeldExecIssuerMainCidNonce)
        let ok08 =
            !held_exec_provider.CsgCoreProductionHeldExecProviderReceiptStrictValidateInto(
                receipt, err) &&
            err == held_exec_provider.CsgCoreProductionHeldExecErrEventChain
        failures = failures + csgHeldExecIssuerMainPrint(
            "arm08_tampered_link_rejected", ok08,
            strutil.Join(["err=", strings.CloneStr(err)], ""))

    # arm09 (gold): the issuer's own monolithic self-check passes end to end.
    let ok09 =
        issuer.CsgCoreProductionHeldExecEventIssuerSelfCheckInto(err) &&
        err == ""
    failures = failures + csgHeldExecIssuerMainPrint(
        "arm09_issuer_selfcheck_into_gold", ok09,
        strutil.Join(["err=", strings.CloneStr(err)], ""))

    if failures == 0:
        os.WriteLine(os.Get_stdout(), "selfcheck_result PASS failures=0")
        return 0
    os.WriteLine(os.Get_stdout(), strutil.Join(
        ["selfcheck_result FAIL failures=",
         strings.IntToStr(failures)], ""))
    return 1
