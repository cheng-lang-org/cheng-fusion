# web_clipboard_runtime_smoke.cheng
# Runtime proof for the clipboard substrate on the WebWindow model (pure Cheng,
# no FFI): init-empty -> write -> read roundtrip -> overwrite-last-wins.
# Backs the clipboard provider family in the ts-csg runtime closure decision
# table (domDocumentProvider decls; host-bridge FFI path is separate).
import std/strutils as strutil
import cheng/core/runtime/web_runtime as web

fn smokeFail(label: str): int32 =
    echo(strutil.Join(["web clipboard substrate smoke failed: ", label], ""))
    return 1

fn main(): int32 =
    var window: web.WebWindow
    web.WebWindowInit(window)

    var out: str = ""
    if !web.WebClipboardReadText(window, out):
        return smokeFail("initial empty read")
    if out != "":
        return smokeFail("initial clipboard not empty")

    if !web.WebClipboardWriteText(window, "did-123"):
        return smokeFail("write text")
    if !web.WebClipboardReadText(window, out):
        return smokeFail("read after write")
    if out != "did-123":
        return smokeFail("roundtrip payload")

    if !web.WebClipboardWriteText(window, "second-write"):
        return smokeFail("overwrite write")
    if !web.WebClipboardReadText(window, out):
        return smokeFail("read after overwrite")
    if out != "second-write":
        return smokeFail("overwrite last-wins")

    echo("web clipboard substrate smoke ok")
    return 0
