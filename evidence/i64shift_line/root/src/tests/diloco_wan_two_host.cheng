# D8 two-host DiLoCo: local inner SGD, QUIC for protocol only,
# outer step copies delta blobs then token-weighted merge.
# Replay hash must match the published modelRef.blobCid.

import std/result
import std/os
import std/cmdline as cmdline
import std/times as times
import std/rawbytes as rawbytes
import std/strings as strings
import cheng/std/bytes_layout as layout
import cheng/libp2p/core/types
import cheng/DiLoCo/core/diloco as core
import cheng/DiLoCo/artifact/store as astore
import cheng/DiLoCo/train/codec as codec
import cheng/DiLoCo/train/inner_step as inner
import cheng/DiLoCo/train/outer_merge as outer
import cheng/DiLoCo/host/diloco_host
import cheng/DiLoCo/host/diloco_client
import cheng/DiLoCo/protocol/wire
import cheng/DiLoCo/tests/support

const
    SmokeIn: int32 = 4
    SmokeOut: int32 = 2
    SmokeInnerSteps: int32 = 4
    SmokeShardBytes: int32 = 64
    SmokeLrNum: int32 = 1
    SmokeLrDen: int32 = 2
    SmokeSamples: int32 = 3

fn die(msg: str): int32 =
    echo(msg)
    return 1

fn waitFile(path: str, timeoutMs: int32): bool =
    var waited: int32 = 0
    while waited < timeoutMs:
        if os.FileExists(path):
            return true
        os.SleepMs(50)
        waited = waited + 50
    return false

@borrows
fn putParams(store: var astore.DiLoCoArtifactStore,
             jobBundleCid: layout.FixedBytes32,
             values: int32[]): Result[core.DiLoCoArtifactRef] =
    var packed = rawbytes.EmptyBytes()
    let packRes = codec.DiLoCoTrainPackI32Fill(packed, values)
    if IsErr(packRes):
        return Err[core.DiLoCoArtifactRef](Error(packRes))
    var artifactRef = core.DiLoCoArtifactRef()
    let putRes = astore.DiLoCoArtifactStorePutFill(artifactRef, store, jobBundleCid, packed, SmokeShardBytes)
    if IsErr(putRes):
        return Err[core.DiLoCoArtifactRef](Error(putRes))
    return Ok[core.DiLoCoArtifactRef](artifactRef)

@borrows
fn loadParams(store: astore.DiLoCoArtifactStore,
              artifactRef: core.DiLoCoArtifactRef): Result[int32[]] =
    var bytes = rawbytes.EmptyBytes()
    let getRes = astore.DiLoCoArtifactStoreGetFill(bytes, store, artifactRef)
    if IsErr(getRes):
        return Err[int32[]](Error(getRes))
    var values: int32[]
    let unpackRes = codec.DiLoCoTrainUnpackI32Fill(values, bytes)
    if IsErr(unpackRes):
        return Err[int32[]](Error(unpackRes))
    return Ok[int32[]](values)

fn fillShardA(xs: var int32[], ys: var int32[]) =
    xs = []
    ys = []
    for s in 0..<SmokeSamples:
        add(xs, 1000)
        add(xs, 0)
        add(xs, 0)
        add(xs, 0)
        add(ys, 1000)
        add(ys, 0)

fn fillShardB(xs: var int32[], ys: var int32[]) =
    xs = []
    ys = []
    for s in 0..<SmokeSamples:
        add(xs, 0)
        add(xs, 1000)
        add(xs, 0)
        add(xs, 0)
        add(ys, 0)
        add(ys, 1000)

fn runLeader(storeDir: str, port: int32, readyPath: str): int32 =
    var store = astore.DiLoCoArtifactStore()
    let initRes = astore.DiLoCoArtifactStoreInitFill(store, storeDir)
    if IsErr(initRes):
        return die(Error(initRes))
    let jobBundleCid = support.DiLoCoTestJobBundleCid("diloco-wan-d8")
    var leaderPeer: types.Libp2pPeerId
    leaderPeer.value = support.DiLoCoTestJobBundleCid("diloco-wan-d8-leader")
    var zeros: int32[]
    let zeroRes = inner.DiLoCoLinearZerosFill(zeros, SmokeOut, SmokeIn)
    if IsErr(zeroRes):
        return die(Error(zeroRes))
    let modelPut = putParams(store, jobBundleCid, zeros)
    if IsErr(modelPut):
        return die(Error(modelPut))
    let optPut = putParams(store, jobBundleCid, zeros)
    if IsErr(optPut):
        return die(Error(optPut))

    var node = diloco_host.DiLoCoHostInit("diloco.wan.leader")
    var openedJob = core.DiLoCoJob()
    var genesis = core.DiLoCoGlobalVersion()
    let openRes = core.DiLoCoOpenJobFill(openedJob,
                                           genesis,
                                           node.state,
                                           jobBundleCid,
                                           2,
                                           SmokeInnerSteps,
                                           60,
                                           Value(modelPut),
                                           Value(optPut))
    if IsErr(openRes):
        return die(Error(openRes))
    var cohort = core.DiLoCoCohort()
    let joinL = core.DiLoCoJoinCohortFill(cohort, node.state, jobBundleCid, leaderPeer)
    if IsErr(joinL):
        return die(Error(joinL))

    var xs: int32[]
    var ys: int32[]
    fillShardA(xs, ys)
    var wA: int32[]
    var dA: int32[]
    let t0 = times.MonotimeMs()
    let innerA = inner.DiLoCoInnerSgdLinearFill(wA, dA, zeros, xs, ys, SmokeSamples, SmokeInnerSteps,
                                                 SmokeOut, SmokeIn, SmokeLrNum, SmokeLrDen)
    let innerMs = times.MonotimeMs() - t0
    if IsErr(innerA):
        return die(Error(innerA))
    let deltaPut = putParams(store, jobBundleCid, dA)
    if IsErr(deltaPut):
        return die(Error(deltaPut))
    let leaderDeltaRef = Value(deltaPut)
    let optDeltaPut = putParams(store, jobBundleCid, zeros)
    if IsErr(optDeltaPut):
        return die(Error(optDeltaPut))
    let leaderOptRef = Value(optDeltaPut)
    let tokens: int32 = SmokeSamples * SmokeInnerSteps
    diloco_host.DiLoCoHostEnableAutoLeader(node,
                                             jobBundleCid,
                                             leaderPeer,
                                             leaderDeltaRef,
                                             leaderOptRef,
                                             SmokeSamples,
                                             tokens,
                                             SmokeInnerSteps,
                                             tokens,
                                             1)

    let serveRes = diloco_host.DiLoCoHostServeWindowNamed(node,
                                                            "0.0.0.0",
                                                            port,
                                                            "localhost",
                                                            readyPath,
                                                            5,
                                                            -1)
    if IsErr(serveRes):
        return die(Error(serveRes))

    let tOuter0 = times.MonotimeMs()
    var commit = core.DiLoCoMergeCommit()
    var version = core.DiLoCoGlobalVersion()
    let mergeRes = outer.DiLoCoOuterMergeAndPublishFill(commit,
                                                          version,
                                                          store,
                                                          node.state,
                                                          jobBundleCid,
                                                          leaderPeer,
                                                          SmokeShardBytes)
    let outerMs = times.MonotimeMs() - tOuter0
    if IsErr(mergeRes):
        return die(Error(mergeRes))

    var base: int32[]
    let baseLoad = loadParams(store, genesis.modelRef)
    if IsErr(baseLoad):
        return die(Error(baseLoad))
    base = Value(baseLoad)
    var leaderDelta: int32[]
    let dLoad = loadParams(store, leaderDeltaRef)
    if IsErr(dLoad):
        return die(Error(dLoad))
    leaderDelta = Value(dLoad)
    var workerDelta: int32[]
    var foundWorker: bool
    foundWorker = false
    for i in 0..<node.state.deltas.len:
        if types.Libp2pPeerIdEqual(node.state.deltas[i].publisherPeerId, leaderPeer):
            continue
        let wLoad = loadParams(store, node.state.deltas[i].modelDeltaRef)
        if IsErr(wLoad):
            return die(Error(wLoad))
        workerDelta = Value(wLoad)
        foundWorker = true
    if !foundWorker:
        return die("diloco_wan_two_host: worker delta missing")
    var flat: int32[]
    for p in 0..<leaderDelta.len:
        add(flat, leaderDelta[p])
    for p in 0..<workerDelta.len:
        add(flat, workerDelta[p])
    var tokenCounts: int32[]
    add(tokenCounts, tokens)
    add(tokenCounts, tokens)
    var replayed: int32[]
    let replayRes = outer.DiLoCoOuterWeightedDeltaFill(replayed, base, flat, tokenCounts, 2)
    if IsErr(replayRes):
        return die(Error(replayRes))
    var replayBytes = rawbytes.EmptyBytes()
    let packReplay = codec.DiLoCoTrainPackI32Fill(replayBytes, replayed)
    if IsErr(packReplay):
        return die(Error(packReplay))
    let replayCid = core.DiLoCoArtifactBytesCid(replayBytes)
    if !layout.FixedBytes32Equal(replayCid, version.modelRef.blobCid):
        return die("diloco_wan_two_host: replay cid mismatch")

    echo(strings.ConcatStr("diloco_wan_receipt inner_ms=", strings.IntToStr(int32(innerMs))))
    echo(strings.ConcatStr("diloco_wan_receipt outer_ms=", strings.IntToStr(int32(outerMs))))
    echo(strings.ConcatStr("diloco_wan_receipt merge_blob=", layout.FixedBytes32Hex(version.modelRef.blobCid)))
    echo(strings.ConcatStr("diloco_wan_receipt replay_blob=", layout.FixedBytes32Hex(replayCid)))
    echo("diloco_wan_receipt ok")
    return 0

fn runWorker(storeDir: str, host: str, port: int32, xferWait: str, xferDone: str): int32 =
    var store = astore.DiLoCoArtifactStore()
    let initRes = astore.DiLoCoArtifactStoreInitFill(store, storeDir)
    if IsErr(initRes):
        return die(Error(initRes))
    let jobBundleCid = support.DiLoCoTestJobBundleCid("diloco-wan-d8")
    var workerPeer: types.Libp2pPeerId
    workerPeer.value = support.DiLoCoTestJobBundleCid("diloco-wan-d8-worker")

    var joinReq = wire.DiLoCoJoinCohortRequest()
    joinReq.jobBundleCid = jobBundleCid
    joinReq.peerId = workerPeer
    let joinRes = diloco_client.DiLoCoJoinCohortRequestNamed(share(host), port, "localhost", joinReq)
    if IsErr(joinRes):
        return die(Error(joinRes))

    var leaseReq = wire.DiLoCoFetchLeaseRequest()
    leaseReq.jobBundleCid = jobBundleCid
    leaseReq.peerId = workerPeer
    let rtt0 = times.MonotimeMs()
    let leaseRes = diloco_client.DiLoCoFetchLeaseRequestNamed(share(host), port, "localhost", leaseReq)
    let rttMs = times.MonotimeMs() - rtt0
    if IsErr(leaseRes):
        return die(Error(leaseRes))
    let lease = Value(leaseRes).lease
    if lease.innerStepBudget != SmokeInnerSteps:
        return die("diloco_wan_two_host: lease budget")

    var zeros: int32[]
    let zeroRes = inner.DiLoCoLinearZerosFill(zeros, SmokeOut, SmokeIn)
    if IsErr(zeroRes):
        return die(Error(zeroRes))
    var xs: int32[]
    var ys: int32[]
    fillShardB(xs, ys)
    var wB: int32[]
    var dB: int32[]
    let t0 = times.MonotimeMs()
    let innerB = inner.DiLoCoInnerSgdLinearFill(wB, dB, zeros, xs, ys, SmokeSamples, SmokeInnerSteps,
                                                 SmokeOut, SmokeIn, SmokeLrNum, SmokeLrDen)
    let innerMs = times.MonotimeMs() - t0
    if IsErr(innerB):
        return die(Error(innerB))
    let deltaPut = putParams(store, jobBundleCid, dB)
    if IsErr(deltaPut):
        return die(Error(deltaPut))
    let workerDeltaRef = Value(deltaPut)
    let optDeltaPut = putParams(store, jobBundleCid, zeros)
    if IsErr(optDeltaPut):
        return die(Error(optDeltaPut))
    let workerOptRef = Value(optDeltaPut)
    os.WriteFile(xferWait, layout.FixedBytes32Hex(workerDeltaRef.blobCid))
    if !waitFile(xferDone, 120000):
        return die("diloco_wan_two_host: xfer timeout")

    var barrierReq = wire.DiLoCoReportInnerStepDoneRequest()
    barrierReq.jobBundleCid = jobBundleCid
    barrierReq.peerId = workerPeer
    let barrierRes = diloco_client.DiLoCoReportInnerStepDoneRequestNamed(share(host), port, "localhost", barrierReq)
    if IsErr(barrierRes):
        return die(Error(barrierRes))

    let tokens: int32 = SmokeSamples * SmokeInnerSteps
    var deltaReq = wire.DiLoCoSubmitOuterDeltaRequest()
    deltaReq.jobBundleCid = jobBundleCid
    deltaReq.baseVersionCid = lease.baseVersionCid
    deltaReq.outerStep = lease.outerStep
    deltaReq.publisherPeerId = workerPeer
    deltaReq.modelDeltaRef = workerDeltaRef
    deltaReq.optimizerDeltaRef = workerOptRef
    deltaReq.sampleCount = SmokeSamples
    deltaReq.tokenCount = tokens
    deltaReq.innerStepCount = SmokeInnerSteps
    deltaReq.weightNumerator = tokens
    deltaReq.weightDenominator = 1
    let deltaRes = diloco_client.DiLoCoSubmitOuterDeltaRequestNamed(share(host), port, "localhost", deltaReq)
    if IsErr(deltaRes):
        return die(Error(deltaRes))

    var statusReq = wire.DiLoCoFetchStepStatusRequest()
    statusReq.jobBundleCid = jobBundleCid
    let statusRes = diloco_client.DiLoCoFetchStepStatusRequestNamed(share(host), port, "localhost", statusReq)
    if IsErr(statusRes):
        return die(Error(statusRes))
    if Value(statusRes).status.contributionCount != 2:
        return die("diloco_wan_two_host: contribution count")

    echo(strings.ConcatStr("diloco_wan_receipt inner_ms=", strings.IntToStr(int32(innerMs))))
    echo(strings.ConcatStr("diloco_wan_receipt rtt_ms=", strings.IntToStr(int32(rttMs))))
    echo("diloco_wan_worker ok")
    return 0

fn main(): int32 =
    var role: str
    if !cmdline.ReadFirstFlagValue("--role", role):
        return die("diloco_wan_two_host: --role missing")
    var storeDir: str
    if !cmdline.ReadFirstFlagValue("--store-dir", storeDir):
        return die("diloco_wan_two_host: --store-dir missing")
    let port = cmdline.ReadInt32FlagOrDefault("--port", 18447)
    if role == "leader":
        var readyPath: str
        if !cmdline.ReadFirstFlagValue("--ready-path", readyPath):
            return die("diloco_wan_two_host: --ready-path missing")
        return runLeader(storeDir, port, readyPath)
    if role == "worker":
        var host: str
        if !cmdline.ReadFirstFlagValue("--host", host):
            return die("diloco_wan_two_host: --host missing")
        var xferWait: str
        if !cmdline.ReadFirstFlagValue("--xfer-wait", xferWait):
            return die("diloco_wan_two_host: --xfer-wait missing")
        var xferDone: str
        if !cmdline.ReadFirstFlagValue("--xfer-done", xferDone):
            return die("diloco_wan_two_host: --xfer-done missing")
        return runWorker(storeDir, host, port, xferWait, xferDone)
    return die("diloco_wan_two_host: unknown role")
