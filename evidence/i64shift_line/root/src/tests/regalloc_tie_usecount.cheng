# regalloc tie-break fixture (axis-W 阶段1 gate).
# Two locals x and y with EQUAL read useCount in a single-block, no-call, cbr=0
# body. Both pass the residency qualification gate (entry-block dominance, non-
# param, width!=0, firstWrite<firstRead, no in-range call, cbr<=2). With K=2 the
# resident set is {x, y} (rank0, rank1); with K=1 the tie-break (useCount desc,
# slot asc) must pick the lower slot as rank0. A tie-break drift would silently
# ship a different rank0 under K=1 vs the K=2 rank0 — this fixture nails it.
# Pure scalar + control flow + return (no assert/echo) for x86_64 emit maturity.

fn tieBody(): int32 =
    var x: int32
    var y: int32
    x = x + 1
    y = y + 1
    x = x + 1
    y = y + 1
    return x + y

fn main(): int32 =
    let r = tieBody()
    if r != 4:
        return 1
    return 0
