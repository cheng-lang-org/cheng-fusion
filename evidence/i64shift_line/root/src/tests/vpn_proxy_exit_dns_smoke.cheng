import std/result
import std/rawbytes
import cheng/apps/vpn_proxy/vpn_proxy_exit_dns as exitdns

fn writeQuestion(resp: Bytes, qtype: int32): int32 =
    var offset: int32 = 12
    let qname: Bytes = BytesFromString("example")
    BytesSet(resp, offset, 7)
    offset = offset + 1
    for i in 0..<BytesLen(qname):
        BytesSet(resp, offset, BytesGet(qname, i))
        offset = offset + 1
    let qtld: Bytes = BytesFromString("com")
    BytesSet(resp, offset, 3)
    offset = offset + 1
    for i in 0..<BytesLen(qtld):
        BytesSet(resp, offset, BytesGet(qtld, i))
        offset = offset + 1
    BytesSet(resp, offset, 0)
    BytesSet(resp, offset + 1, (qtype >> 8) & 255)
    BytesSet(resp, offset + 2, qtype & 255)
    BytesSet(resp, offset + 3, 0)
    BytesSet(resp, offset + 4, 1)
    return offset + 5

fn writeAnswerHeader(resp: Bytes,
                     offset: int32,
                     rrType: int32,
                     ttl: int32,
                     rdLen: int32): int32 =
    BytesSet(resp, offset, 192)
    BytesSet(resp, offset + 1, 12)
    BytesSet(resp, offset + 2, (rrType >> 8) & 255)
    BytesSet(resp, offset + 3, rrType & 255)
    BytesSet(resp, offset + 4, 0)
    BytesSet(resp, offset + 5, 1)
    BytesSet(resp, offset + 6, (ttl >> 24) & 255)
    BytesSet(resp, offset + 7, (ttl >> 16) & 255)
    BytesSet(resp, offset + 8, (ttl >> 8) & 255)
    BytesSet(resp, offset + 9, ttl & 255)
    BytesSet(resp, offset + 10, (rdLen >> 8) & 255)
    BytesSet(resp, offset + 11, rdLen & 255)
    return offset + 12

fn buildResponseA(queryId: int32,
                  flagsHi: int32,
                  flagsLo: int32,
                  answerCount: int32,
                  withCname: bool,
                  aTtl: int32): Bytes =
    # Question: example.com A IN; answers reference the question name via
    # compression pointer 0xC00C. Optional CNAME record precedes the A record.
    var answerBytes: int32 = 16
    if withCname:
        answerBytes = answerBytes + 14
    let total: int32 = 12 + 17 + answerBytes
    var resp: Bytes = BytesAlloc(total)
    BytesSet(resp, 0, (queryId >> 8) & 255)
    BytesSet(resp, 1, queryId & 255)
    BytesSet(resp, 2, flagsHi)
    BytesSet(resp, 3, flagsLo)
    BytesSet(resp, 4, 0)
    BytesSet(resp, 5, 1)
    BytesSet(resp, 6, 0)
    BytesSet(resp, 7, answerCount)
    BytesSet(resp, 8, 0)
    BytesSet(resp, 9, 0)
    BytesSet(resp, 10, 0)
    BytesSet(resp, 11, 0)
    var offset: int32 = writeQuestion(resp, 1)
    if withCname:
        BytesSet(resp, offset, 192)
        BytesSet(resp, offset + 1, 12)
        BytesSet(resp, offset + 2, 0)
        BytesSet(resp, offset + 3, 5)
        BytesSet(resp, offset + 4, 0)
        BytesSet(resp, offset + 5, 1)
        BytesSet(resp, offset + 6, 0)
        BytesSet(resp, offset + 7, 0)
        BytesSet(resp, offset + 8, 0)
        BytesSet(resp, offset + 9, 60)
        BytesSet(resp, offset + 10, 0)
        BytesSet(resp, offset + 11, 2)
        BytesSet(resp, offset + 12, 192)
        BytesSet(resp, offset + 13, 12)
        offset = offset + 14
    offset = writeAnswerHeader(resp, offset, 1, aTtl, 4)
    BytesSet(resp, offset, 93)
    BytesSet(resp, offset + 1, 184)
    BytesSet(resp, offset + 2, 216)
    BytesSet(resp, offset + 3, 34)
    return resp

fn buildResponseAaaa(queryId: int32,
                     flagsHi: int32,
                     flagsLo: int32,
                     answerCount: int32,
                     ttl: int32): Bytes =
    let total: int32 = 12 + 17 + 28
    var resp: Bytes = BytesAlloc(total)
    BytesSet(resp, 0, (queryId >> 8) & 255)
    BytesSet(resp, 1, queryId & 255)
    BytesSet(resp, 2, flagsHi)
    BytesSet(resp, 3, flagsLo)
    BytesSet(resp, 4, 0)
    BytesSet(resp, 5, 1)
    BytesSet(resp, 6, 0)
    BytesSet(resp, 7, answerCount)
    BytesSet(resp, 8, 0)
    BytesSet(resp, 9, 0)
    BytesSet(resp, 10, 0)
    BytesSet(resp, 11, 0)
    var offset: int32 = writeQuestion(resp, 28)
    offset = writeAnswerHeader(resp, offset, 28, ttl, 16)
    BytesSet(resp, offset, 38)
    BytesSet(resp, offset + 1, 7)
    BytesSet(resp, offset + 2, 248)
    BytesSet(resp, offset + 3, 176)
    BytesSet(resp, offset + 4, 64)
    BytesSet(resp, offset + 5, 6)
    BytesSet(resp, offset + 6, 8)
    BytesSet(resp, offset + 7, 10)
    BytesSet(resp, offset + 8, 0)
    BytesSet(resp, offset + 9, 0)
    BytesSet(resp, offset + 10, 0)
    BytesSet(resp, offset + 11, 0)
    BytesSet(resp, offset + 12, 0)
    BytesSet(resp, offset + 13, 0)
    BytesSet(resp, offset + 14, 32)
    BytesSet(resp, offset + 15, 14)
    return resp

fn main(): int32 =
    assert(exitdns.VpnProxyExitDnsHostIsIpv4Literal("8.8.8.8"), " ipv4 literal accept")
    assert(exitdns.VpnProxyExitDnsHostIsIpv4Literal("255.255.255.255"), " ipv4 literal max accept")
    assert(exitdns.VpnProxyExitDnsHostIsIpv4Literal("0.0.0.0"), " ipv4 literal zero accept")
    assert(!exitdns.VpnProxyExitDnsHostIsIpv4Literal("256.1.1.1"), " ipv4 literal overflow reject")
    assert(!exitdns.VpnProxyExitDnsHostIsIpv4Literal("01.2.3.4"), " ipv4 literal leading zero reject")
    assert(!exitdns.VpnProxyExitDnsHostIsIpv4Literal("chatgpt.com"), " domain reject")
    assert(!exitdns.VpnProxyExitDnsHostIsIpv4Literal("1.2.3"), " short literal reject")
    assert(!exitdns.VpnProxyExitDnsHostIsIpv4Literal("1.2.3.4.5"), " long literal reject")
    assert(!exitdns.VpnProxyExitDnsHostIsIpv4Literal(""), " empty literal reject")

    let queryRes: Result[Bytes] = exitdns.VpnProxyExitDnsBuildQuery(4660, "example.com", 1)
    assert(!IsErr(queryRes), " build query ok")
    let query: Bytes = Value(queryRes)
    assert(BytesLen(query) == 29, " query length")
    assert(BytesGet(query, 0) == 18, " query id hi")
    assert(BytesGet(query, 1) == 52, " query id lo")
    assert(BytesGet(query, 2) == 1, " query rd flag")
    assert(BytesGet(query, 5) == 1, " query qdcount")
    assert(BytesGet(query, 12) == 7, " query first label len")
    assert(BytesGet(query, 13) == 101, " query first label byte")
    assert(BytesGet(query, 20) == 3, " query second label len")
    assert(BytesGet(query, 24) == 0, " query name terminator")
    assert(BytesGet(query, 26) == 1, " query qtype a")
    assert(BytesGet(query, 28) == 1, " query qclass in")
    let query6Res: Result[Bytes] = exitdns.VpnProxyExitDnsBuildQuery(4660, "example.com", 28)
    assert(!IsErr(query6Res), " build query aaaa ok")
    let query6: Bytes = Value(query6Res)
    assert(BytesGet(query6, 25) == 0, " query aaaa qtype hi")
    assert(BytesGet(query6, 26) == 28, " query aaaa qtype lo")

    let emptyLabelRes: Result[Bytes] = exitdns.VpnProxyExitDnsBuildQuery(1, "bad..domain", 1)
    assert(IsErr(emptyLabelRes), " empty label reject")
    let emptyDomainRes: Result[Bytes] = exitdns.VpnProxyExitDnsBuildQuery(1, "", 1)
    assert(IsErr(emptyDomainRes), " empty domain reject")
    let badQtypeRes: Result[Bytes] = exitdns.VpnProxyExitDnsBuildQuery(1, "example.com", 15)
    assert(IsErr(badQtypeRes), " unsupported qtype reject")

    let plainResp: Bytes = buildResponseA(4660, 129, 128, 1, false, 300)
    let plainRes: Result[exitdns.VpnProxyExitDnsAnswer] = exitdns.VpnProxyExitDnsParseAnswer(plainResp, 4660, 1)
    assert(!IsErr(plainRes), " parse plain answer ok")
    assert(Value(plainRes).ipText == "93.184.216.34", " parse plain ip")
    assert(Value(plainRes).ttlSeconds == 300, " parse plain ttl")

    let aaaaResp: Bytes = buildResponseAaaa(4660, 129, 128, 1, 120)
    let aaaaRes: Result[exitdns.VpnProxyExitDnsAnswer] = exitdns.VpnProxyExitDnsParseAnswer(aaaaResp, 4660, 28)
    assert(!IsErr(aaaaRes), " parse aaaa answer ok")
    assert(Value(aaaaRes).ipText == "2607:f8b0:4006:80a:0:0:0:200e", " parse aaaa ip")
    assert(Value(aaaaRes).ttlSeconds == 120, " parse aaaa ttl")
    let wrongFamilyRes: Result[exitdns.VpnProxyExitDnsAnswer] = exitdns.VpnProxyExitDnsParseAnswer(aaaaResp, 4660, 1)
    assert(IsErr(wrongFamilyRes), " parse wrong qtype reject")

    let cnameResp: Bytes = buildResponseA(4660, 129, 128, 2, true, 7200)
    let cnameRes: Result[exitdns.VpnProxyExitDnsAnswer] = exitdns.VpnProxyExitDnsParseAnswer(cnameResp, 4660, 1)
    assert(!IsErr(cnameRes), " parse cname chain ok")
    assert(Value(cnameRes).ipText == "93.184.216.34", " parse cname chain ip")
    assert(Value(cnameRes).ttlSeconds == 3600, " parse ttl capped")

    let idMismatchRes: Result[exitdns.VpnProxyExitDnsAnswer] = exitdns.VpnProxyExitDnsParseAnswer(plainResp, 4661, 1)
    assert(IsErr(idMismatchRes), " parse id mismatch reject")

    let queryEchoResp: Bytes = buildResponseA(4660, 1, 0, 1, false, 300)
    let queryEchoRes: Result[exitdns.VpnProxyExitDnsAnswer] = exitdns.VpnProxyExitDnsParseAnswer(queryEchoResp, 4660, 1)
    assert(IsErr(queryEchoRes), " parse non answer reject")

    let truncatedResp: Bytes = buildResponseA(4660, 131, 128, 1, false, 300)
    let truncatedRes: Result[exitdns.VpnProxyExitDnsAnswer] = exitdns.VpnProxyExitDnsParseAnswer(truncatedResp, 4660, 1)
    assert(IsErr(truncatedRes), " parse truncated reject")

    let servfailResp: Bytes = buildResponseA(4660, 129, 130, 1, false, 300)
    let servfailRes: Result[exitdns.VpnProxyExitDnsAnswer] = exitdns.VpnProxyExitDnsParseAnswer(servfailResp, 4660, 1)
    assert(IsErr(servfailRes), " parse rcode reject")

    let noAnswerResp: Bytes = buildResponseA(4660, 129, 128, 0, false, 300)
    let noAnswerRes: Result[exitdns.VpnProxyExitDnsAnswer] = exitdns.VpnProxyExitDnsParseAnswer(noAnswerResp, 4660, 1)
    assert(IsErr(noAnswerRes), " parse no answers reject")

    let nowNs: int64 = int64(1000000000)
    assert(exitdns.VpnProxyExitDnsCacheLookup("chatgpt.com", 1, nowNs) == "", " cache miss before store")
    exitdns.VpnProxyExitDnsCacheStore("chatgpt.com", 1, "104.18.32.47", 60, nowNs)
    assert(exitdns.VpnProxyExitDnsCacheLookup("chatgpt.com", 1, nowNs) == "104.18.32.47", " cache hit after store")
    assert(exitdns.VpnProxyExitDnsCacheLookup("chatgpt.com", 28, nowNs) == "", " cache qtype isolated")
    exitdns.VpnProxyExitDnsCacheStore("chatgpt.com", 28, "2607:f8b0:4006:80a:0:0:0:200e", 60, nowNs)
    assert(exitdns.VpnProxyExitDnsCacheLookup("chatgpt.com", 28, nowNs) == "2607:f8b0:4006:80a:0:0:0:200e",
           " cache aaaa hit after store")
    assert(exitdns.VpnProxyExitDnsCacheLookup("chatgpt.com", 1, nowNs + int64(59) * int64(1000000000)) == "104.18.32.47",
           " cache hit before expiry")
    assert(exitdns.VpnProxyExitDnsCacheLookup("chatgpt.com", 1, nowNs + int64(61) * int64(1000000000)) == "",
           " cache miss after expiry")
    exitdns.VpnProxyExitDnsCacheStore("zero.ttl.example", 1, "1.2.3.4", 0, nowNs)
    assert(exitdns.VpnProxyExitDnsCacheLookup("zero.ttl.example", 1, nowNs) == "", " zero ttl not cached")
    assert(exitdns.VpnProxyExitDnsCacheCount() == 2, " cache count after stores")

    let cfgPreferredRes: Result[str] = exitdns.VpnProxyExitDnsServerFromSources("9.9.9.9",
                                                                                "nameserver 1.1.1.1\n")
    assert(!IsErr(cfgPreferredRes), " resolver config preferred ok")
    assert(Value(cfgPreferredRes) == "9.9.9.9", " resolver config preferred value")
    let cfgBadRes: Result[str] = exitdns.VpnProxyExitDnsServerFromSources("dns.google", "")
    assert(IsErr(cfgBadRes), " resolver config non literal reject")
    let resolvRes: Result[str] = exitdns.VpnProxyExitDnsServerFromSources("",
                                                                          "# comment\nnameserver 2001:19f0:300:1704::6\nnameserver  108.61.10.10\n")
    assert(!IsErr(resolvRes), " resolv conf parse ok")
    assert(Value(resolvRes) == "108.61.10.10", " resolv conf skips ipv6 picks ipv4")
    let resolvNoneRes: Result[str] = exitdns.VpnProxyExitDnsServerFromSources("", "search localdomain\n")
    assert(IsErr(resolvNoneRes), " resolver missing reject")

    assert(!exitdns.VpnProxyExitDnsConfigured(), " resolver unconfigured by default")
    let configureRes: Result[bool] = exitdns.VpnProxyExitDnsConfigure("108.61.10.10")
    assert(!IsErr(configureRes), " resolver configure ok")
    assert(exitdns.VpnProxyExitDnsConfigured(), " resolver configured")
    assert(exitdns.VpnProxyExitDnsConfiguredServer() == "108.61.10.10", " resolver configured value")
    let configureBadRes: Result[bool] = exitdns.VpnProxyExitDnsConfigure("not-an-ip")
    assert(IsErr(configureBadRes), " resolver configure reject non literal")

    echo(" vpn_proxy_exit_dns_smoke ok")
    return 0
