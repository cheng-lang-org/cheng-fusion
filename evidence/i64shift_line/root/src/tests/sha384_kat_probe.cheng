# SHA-384 known-answer probe: sha384Digest("abc") must equal
# cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7
import std/system
import std/result
import std/rawbytes
import std/strutils as strutil
import std/crypto/sha384 as sha384m
import std/crypto/rsa as rsacrypto

fn toHex(data: Bytes): str =
    var out: str = ""
    for i in 0..<BytesLen(data):
        out = strutil.Join([out, rsacrypto.rsaHexDigit(int32(BytesGet(data, i) >> 4))], "")
        out = strutil.Join([out, rsacrypto.rsaHexDigit(int32(BytesGet(data, i) & 0x0f))], "")
    return out

fn main(): int32 =
    let d: Bytes = sha384m.sha384Digest(BytesFromString("abc"))
    echo(strutil.Join(["sha384(abc)=", BytesToHex(d)], ""))
    let empty: Bytes = sha384m.sha384Digest(BytesFromString(""))
    echo(strutil.Join(["sha384(empty)=", BytesToHex(empty)], ""))
    # 多块输入（200 字节 = 2 块）与 MGF1 尺寸量级
    let big: Bytes = BytesAlloc(200)
    for i in 0..<200:
        BytesSet(big, i, int32(i & 0xff))
    let bigd: Bytes = sha384m.sha384Digest(big)
    echo(strutil.Join(["sha384(200B)=", BytesToHex(bigd)], ""))
    return 0
