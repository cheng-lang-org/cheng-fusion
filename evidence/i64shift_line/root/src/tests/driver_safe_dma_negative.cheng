@profile("driver_safe")
import std/driver_safe as ds

fn ReadDeviceOwnedPayload(dev: ds.DmaBufferDevice[int32]): int32 =
    return dev.payload

fn main(): int32 =
    let cpu = ds.DmaBufferForCpu[int32](uint64(1), 4, 7)
    let dev = ds.DmaHandToDevice[int32](cpu)
    return ReadDeviceOwnedPayload(dev)
