type
    ManagedAggregate =
        text: str
        numbers: int32[]

    ManagedAggregateOwner =
        payload: ManagedAggregate

var managedAggregateGlobal: ManagedAggregate

fn installBorrowedAggregate(): int32 =
    var owner: ManagedAggregateOwner
    owner.payload.text = Fmt"managed-inline-borrowed-{41}"
    add(owner.payload.numbers, 41)
    # This is legal Cheng.  The fixture remains RED only while descriptor-driven
    # recursive share-store is missing; the final semantic oracle is run_green.
    managedAggregateGlobal = owner.payload
    owner.payload.text = Fmt"managed-inline-replaced-{99}"
    owner.payload.numbers = []
    if managedAggregateGlobal.text != "managed-inline-borrowed-41":
        return 1
    if managedAggregateGlobal.numbers.len != 1 ||
       managedAggregateGlobal.numbers[0] != 41:
        return 2
    return 0

fn main(): int32 =
    let rc = installBorrowedAggregate()
    if rc != 0:
        return rc
    if managedAggregateGlobal.text != "managed-inline-borrowed-41":
        return 3
    if managedAggregateGlobal.numbers.len != 1 ||
       managedAggregateGlobal.numbers[0] != 41:
        return 4
    managedAggregateGlobal = managedAggregateGlobal
    if managedAggregateGlobal.text != "managed-inline-borrowed-41":
        return 5
    return 0
