import std/cmdline
import cheng/core/ir/function_source_slice_index as fslice

const
    InputOrderReverse = 1
    InputOrderZigzag = 2

fn expectedFunctionIndex(rowIndex: int32,
                         functionCount: int32,
                         inputOrder: int32): int32 =
    if inputOrder == InputOrderReverse:
        return functionCount - 1 - rowIndex
    if inputOrder == InputOrderZigzag:
        if rowIndex % 2 == 0:
            return rowIndex / 2
        return functionCount - 1 - rowIndex / 2
    panic("function source slice index smoke: unknown input order")

fn exprCountForRow(rowIndex: int32): int32 =
    return rowIndex % 3 + 1

fn scopeCountForRow(rowIndex: int32): int32 =
    return rowIndex % 2 + 1

fn statementCountForRow(rowIndex: int32): int32 =
    return rowIndex % 4 + 1

fn appendSingleSourceRows(index: var fslice.FunctionSourceSliceIndex,
                          functionCount: int32,
                          inputOrder: int32,
                          totalExprCount: var int32,
                          totalScopeCount: var int32,
                          totalStatementCount: var int32) =
    var exprStart: int32
    var scopeStart: int32 = 1
    var statementStart: int32
    for rowIndex in 0..<functionCount:
        var row: fslice.FunctionSourceSliceRow
        row.sourceIndex = 0
        row.functionIndex = expectedFunctionIndex(
            rowIndex, functionCount, inputOrder)
        row.exprStart = exprStart
        row.exprCount = exprCountForRow(rowIndex)
        row.scopeStart = scopeStart
        row.scopeCount = scopeCountForRow(rowIndex)
        row.statementStart = statementStart
        row.statementCount = statementCountForRow(rowIndex)
        var parents: int32[]
        setLen(parents, row.scopeCount)
        for offset in 0..<row.scopeCount:
            if offset == 0:
                parents[offset] = 0
            else:
                parents[offset] = row.scopeStart + offset - 1
        fslice.FunctionSourceSliceIndexAppendValidatedFunctionRow(
            index, row, parents)
        exprStart = exprStart + row.exprCount
        scopeStart = scopeStart + row.scopeCount
        statementStart = statementStart + row.statementCount
        totalExprCount = totalExprCount + row.exprCount
        totalScopeCount = totalScopeCount + row.scopeCount
        totalStatementCount = totalStatementCount + row.statementCount

fn requireSingleSourceRows(index: var fslice.FunctionSourceSliceIndex,
                           functionCount: int32,
                           inputOrder: int32) =
    assert(fslice.FunctionSourceSliceIndexSourceStart(index, 0) == 0,
           "function source slice index smoke: source start")
    assert(fslice.FunctionSourceSliceIndexSourceCount(index, 0) ==
           functionCount,
           "function source slice index smoke: source count")
    var exprStart: int32
    var scopeStart: int32 = 1
    var statementStart: int32
    for sourceFunctionOrdinal in 0..<functionCount:
        let rowIndex =
            fslice.FunctionSourceSliceIndexRowForSourceFunctionOrdinal(
                index, 0, sourceFunctionOrdinal)
        assert(rowIndex == sourceFunctionOrdinal,
               "function source slice index smoke: O(1) source row")
        let row = fslice.FunctionSourceSliceIndexGetRow(index, rowIndex)
        assert(row.sourceIndex == 0 &&
               row.functionIndex == expectedFunctionIndex(
                   rowIndex, functionCount, inputOrder),
               "function source slice index smoke: function identity")
        assert(row.exprStart == exprStart &&
               row.scopeStart == scopeStart &&
               row.statementStart == statementStart,
               "function source slice index smoke: contiguous ranges")
        exprStart = exprStart + row.exprCount
        scopeStart = scopeStart + row.scopeCount
        statementStart = statementStart + row.statementCount

fn requireByteLedger(index: var fslice.FunctionSourceSliceIndex,
                     functionCount: int32,
                     sourceCount: int32) =
    let ledger = fslice.FunctionSourceSliceIndexByteLedgerBuild(index)
    let expectedBase = int64(functionCount) * int64(16)
    let expectedIncremental = int64(functionCount) * int64(16) +
                              int64(sourceCount) * int64(8)
    assert(ledger.functionRowCount == functionCount &&
           ledger.sourceCount == sourceCount,
           "function source slice index smoke: ledger row counts")
    assert(ledger.baseLiveBytes == expectedBase &&
           ledger.incrementalLiveBytes == expectedIncremental &&
           ledger.incrementalLiveBytes ==
               fslice.FunctionSourceSliceIndexExpectedIncrementalLiveBytes(
                   functionCount, sourceCount) &&
           ledger.totalLiveBytes == expectedBase + expectedIncremental,
           "function source slice index smoke: 16F+8S incremental bytes")
    assert(ledger.baseRetainedBytes >= ledger.baseLiveBytes &&
           ledger.incrementalRetainedBytes >=
               ledger.incrementalLiveBytes &&
           ledger.totalRetainedBytes == ledger.baseRetainedBytes +
                                        ledger.incrementalRetainedBytes,
           "function source slice index smoke: retained byte ledger")

fn runSingleSource(functionCount: int32, inputOrder: int32) =
    var index = fslice.FunctionSourceSliceIndexInit(1, functionCount)
    var totalExprCount: int32
    var totalScopeCount: int32
    var totalStatementCount: int32
    appendSingleSourceRows(index, functionCount, inputOrder,
                           totalExprCount, totalScopeCount,
                           totalStatementCount)
    fslice.FunctionSourceSliceIndexSeal(index)
    assert(fslice.FunctionSourceSliceIndexContentCertificateMatches(index),
           "function source slice index smoke: sealed certificate")
    let firstExprCount = index.exprCounts[0]
    index.exprCounts[0] = firstExprCount + 1
    assert(!fslice.FunctionSourceSliceIndexContentCertificateMatches(index),
           "function source slice index smoke: row mutation certificate")
    index.exprCounts[0] = firstExprCount
    assert(fslice.FunctionSourceSliceIndexContentCertificateMatches(index),
           "function source slice index smoke: restored certificate")
    requireSingleSourceRows(index, functionCount, inputOrder)
    fslice.FunctionSourceSliceIndexRequireParentValidationComplete(index)
    assert(index.functionRowAppendVisitCount == functionCount &&
           index.exprCommitVisitCount == totalExprCount &&
           index.scopeCommitVisitCount == totalScopeCount &&
           index.statementCommitVisitCount == totalStatementCount &&
           index.scopeParentValidationVisitCount == totalScopeCount,
           "function source slice index smoke: exact visit counters")
    requireByteLedger(index, functionCount, 1)

    let retainedBeforeReset =
        fslice.FunctionSourceSliceIndexByteLedgerBuild(index)
    fslice.FunctionSourceSliceIndexReset(index)
    let afterReset = fslice.FunctionSourceSliceIndexByteLedgerBuild(index)
    assert(afterReset.totalLiveBytes == int64(0) &&
           afterReset.baseRetainedBytes ==
               retainedBeforeReset.baseRetainedBytes &&
           afterReset.incrementalRetainedBytes ==
               retainedBeforeReset.incrementalRetainedBytes &&
           !index.sealed && !index.released,
           "function source slice index smoke: reset retains capacity")
    var resetExprCount: int32
    var resetScopeCount: int32
    var resetStatementCount: int32
    appendSingleSourceRows(index, functionCount, inputOrder,
                           resetExprCount, resetScopeCount,
                           resetStatementCount)
    fslice.FunctionSourceSliceIndexSeal(index)
    assert(fslice.FunctionSourceSliceIndexContentCertificateMatches(index),
           "function source slice index smoke: reset certificate")
    fslice.FunctionSourceSliceIndexRelease(index)
    let afterRelease = fslice.FunctionSourceSliceIndexByteLedgerBuild(index)
    assert(afterRelease.totalLiveBytes == int64(0) &&
           afterRelease.totalRetainedBytes == int64(0) &&
           index.released,
           "function source slice index smoke: release drops capacity")

fn appendTwoSourceRow(index: var fslice.FunctionSourceSliceIndex,
                      sourceIndex: int32,
                      functionIndex: int32,
                      exprStart: int32,
                      scopeStart: int32,
                      statementStart: int32) =
    var row: fslice.FunctionSourceSliceRow
    row.sourceIndex = sourceIndex
    row.functionIndex = functionIndex
    row.exprStart = exprStart
    row.exprCount = 1
    row.scopeStart = scopeStart
    row.scopeCount = 1
    row.statementStart = statementStart
    row.statementCount = 1
    var parents: int32[] = [0]
    fslice.FunctionSourceSliceIndexAppendValidatedFunctionRow(
        index, row, parents)

fn runTwoSourceRanges() =
    var index = fslice.FunctionSourceSliceIndexInit(2, 3)
    appendTwoSourceRow(index, 0, 9, 0, 1, 0)
    appendTwoSourceRow(index, 0, 3, 1, 2, 1)
    appendTwoSourceRow(index, 1, 7, 0, 1, 0)
    fslice.FunctionSourceSliceIndexSeal(index)
    assert(fslice.FunctionSourceSliceIndexSourceStart(index, 0) == 0 &&
           fslice.FunctionSourceSliceIndexSourceCount(index, 0) == 2 &&
           fslice.FunctionSourceSliceIndexSourceStart(index, 1) == 2 &&
           fslice.FunctionSourceSliceIndexSourceCount(index, 1) == 1 &&
           fslice.FunctionSourceSliceIndexRowForSourceFunctionOrdinal(
               index, 1, 0) == 2,
           "function source slice index smoke: two source O(1) ranges")
    fslice.FunctionSourceSliceIndexRequireParentValidationComplete(index)
    requireByteLedger(index, 3, 2)
    fslice.FunctionSourceSliceIndexRelease(index)

fn runEmptySourceRanges() =
    var index = fslice.FunctionSourceSliceIndexInit(4, 2)
    appendTwoSourceRow(index, 1, 5, 0, 1, 0)
    appendTwoSourceRow(index, 3, 7, 0, 1, 0)
    fslice.FunctionSourceSliceIndexSeal(index)
    assert(fslice.FunctionSourceSliceIndexSourceStart(index, 0) == 0 &&
           fslice.FunctionSourceSliceIndexSourceCount(index, 0) == 0 &&
           fslice.FunctionSourceSliceIndexSourceStart(index, 1) == 0 &&
           fslice.FunctionSourceSliceIndexSourceCount(index, 1) == 1 &&
           fslice.FunctionSourceSliceIndexSourceStart(index, 2) == 1 &&
           fslice.FunctionSourceSliceIndexSourceCount(index, 2) == 0 &&
           fslice.FunctionSourceSliceIndexSourceStart(index, 3) == 1 &&
           fslice.FunctionSourceSliceIndexSourceCount(index, 3) == 1,
           "function source slice index smoke: empty source ranges")
    fslice.FunctionSourceSliceIndexRequireParentValidationComplete(index)
    requireByteLedger(index, 2, 4)
    fslice.FunctionSourceSliceIndexRelease(index)

fn runPositive() =
    runSingleSource(1, InputOrderReverse)
    runSingleSource(2, InputOrderReverse)
    runSingleSource(1024, InputOrderReverse)
    runSingleSource(1024, InputOrderZigzag)
    runTwoSourceRanges()
    runEmptySourceRanges()
    echo("function_source_slice_index_smoke ok")

fn appendFailureBase(index: var fslice.FunctionSourceSliceIndex) =
    var row: fslice.FunctionSourceSliceRow
    row.sourceIndex = 0
    row.functionIndex = 0
    row.exprCount = 1
    row.scopeStart = 1
    row.scopeCount = 2
    row.statementCount = 1
    var parents: int32[] = [0, 1]
    fslice.FunctionSourceSliceIndexAppendValidatedFunctionRow(
        index, row, parents)

fn runOverlapFailure() =
    var index = fslice.FunctionSourceSliceIndexInit(1, 2)
    appendFailureBase(index)
    var row: fslice.FunctionSourceSliceRow
    row.sourceIndex = 0
    row.functionIndex = 1
    row.exprStart = 1
    row.exprCount = 1
    row.scopeStart = 2
    row.scopeCount = 1
    row.statementStart = 1
    row.statementCount = 1
    var parents: int32[] = [0]
    fslice.FunctionSourceSliceIndexAppendValidatedFunctionRow(
        index, row, parents)

fn runGapFailure() =
    var index = fslice.FunctionSourceSliceIndexInit(1, 2)
    appendFailureBase(index)
    var row: fslice.FunctionSourceSliceRow
    row.sourceIndex = 0
    row.functionIndex = 1
    row.exprStart = 1
    row.exprCount = 1
    row.scopeStart = 4
    row.scopeCount = 1
    row.statementStart = 1
    row.statementCount = 1
    var parents: int32[] = [0]
    fslice.FunctionSourceSliceIndexAppendValidatedFunctionRow(
        index, row, parents)

fn runOutOfBoundsFailure() =
    var index = fslice.FunctionSourceSliceIndexInit(1, 1)
    appendFailureBase(index)
    fslice.FunctionSourceSliceIndexSeal(index)
    let unexpected = fslice.FunctionSourceSliceIndexRowForSourceFunctionOrdinal(
        index, 0, 1)
    assert(unexpected < 0,
           "function source slice index smoke: out-of-bounds accepted")

fn runDriftFailure() =
    var index = fslice.FunctionSourceSliceIndexInit(1, 1)
    appendFailureBase(index)
    setLen(index.exprCounts, 0)
    fslice.FunctionSourceSliceIndexRequireValid(index)

fn runParentOrderFailure() =
    var index = fslice.FunctionSourceSliceIndexInit(1, 1)
    var row: fslice.FunctionSourceSliceRow
    row.sourceIndex = 0
    row.functionIndex = 0
    row.exprCount = 1
    row.scopeStart = 1
    row.scopeCount = 2
    row.statementCount = 1
    var parents: int32[] = [0, 2]
    fslice.FunctionSourceSliceIndexAppendValidatedFunctionRow(
        index, row, parents)

fn runIncompleteSealFailure() =
    var index = fslice.FunctionSourceSliceIndexInit(1, 2)
    appendFailureBase(index)
    fslice.FunctionSourceSliceIndexSeal(index)

fn runRangeOverflowFailure() =
    var index = fslice.FunctionSourceSliceIndexInit(1, 1)
    var row: fslice.FunctionSourceSliceRow
    row.sourceIndex = 0
    row.functionIndex = 0
    row.exprStart = 2147483647
    row.exprCount = 1
    row.scopeStart = 1
    var parents: int32[]
    fslice.FunctionSourceSliceIndexAppendValidatedFunctionRow(
        index, row, parents)

fn runIncompleteParentValidationFailure() =
    var index = fslice.FunctionSourceSliceIndexInit(1, 1)
    appendFailureBase(index)
    index.parentValidationRowCursor = 0
    index.scopeParentValidationVisitCount = 0
    fslice.FunctionSourceSliceIndexSeal(index)

fn runDuplicateParentValidationFailure() =
    var index = fslice.FunctionSourceSliceIndexInit(1, 2)
    appendFailureBase(index)
    index.parentValidationRowCursor = 0
    var duplicate: fslice.FunctionSourceSliceRow
    duplicate.sourceIndex = 0
    duplicate.functionIndex = 1
    duplicate.exprStart = 1
    duplicate.exprCount = 1
    duplicate.scopeStart = 3
    duplicate.scopeCount = 1
    duplicate.statementStart = 1
    duplicate.statementCount = 1
    var parents: int32[] = [0]
    fslice.FunctionSourceSliceIndexAppendValidatedFunctionRow(
        index, duplicate, parents)

fn main(argc: int32, argv: str*): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    let mode = cmdline.ParamStr(1)
    if len(mode) == 0:
        runPositive()
        return 0
    if mode == "overlap":
        runOverlapFailure()
    elif mode == "gap":
        runGapFailure()
    elif mode == "out-of-bounds":
        runOutOfBoundsFailure()
    elif mode == "drift":
        runDriftFailure()
    elif mode == "parent-order":
        runParentOrderFailure()
    elif mode == "incomplete-seal":
        runIncompleteSealFailure()
    elif mode == "range-overflow":
        runRangeOverflowFailure()
    elif mode == "incomplete-parent-validation":
        runIncompleteParentValidationFailure()
    elif mode == "duplicate-parent-validation":
        runDuplicateParentValidationFailure()
    else:
        panic("function source slice index smoke: unknown mode")
    return 0
