import cheng/core/backend/lowering_plan as lower
import cheng/core/backend2/backend2_lower_stmt as b2stmt

fn main(): int32 =
    var lowering: lower.LoweringPlanStub
    var irFunction: lower.PrimaryObjectIrFunction
    var c0: int32
    var c1: int32
    var c2: int32
    var c3: int32
    var c4: int32
    var c5: int32
    var c6: int32
    var c7: int32
    let body = b2stmt.B2PrimaryBuildBodyIrFromTypedStatements(
        lowering, 0, irFunction,
        c0, c1, c2, c3, c4, c5, c6, c7)
    return body.ops.len
