import std/strutils as strutil
import std/result
import std/os as os
import std/cmdline as cmdline
import core/tooling/host_ops as hostops

@borrows
fn trace(root: str, line: str) =
    let path: str = "artifacts/tmp/spawn_echo_trace.log"
    let prev: str = os.ReadFile(path)
    os.WriteFile(path, prev + line + "\n")

fn main(): int32 =
    let role: str = cmdline.ReadFlagOrDefault("--role", "")
    let root: str = os.GetCurrentDir()
    if role == "child":
        puts("child-line-1")
        return 0
    trace(root, "T0-main-entered")
    let selfPath: str = cmdline.ProgramName()
    trace(root, "T1-self=" + selfPath)
    let spawnRes = hostops.SpawnFile(root, "spawn_echo_child", selfPath,
                                     ["--role:child"], [], root)
    if IsErr(spawnRes):
        trace(root, "T2-spawn-err=" + Error(spawnRes))
        return 1
    trace(root, "T2-spawn-ok")
    var proc = Value(spawnRes)
    let waitRes: hostops.LoggedRun = hostops.SpawnedProcessWaitLogged(root, proc, 10,
                                                                      "artifacts/tmp/spawn_echo_child.log")
    trace(root, "T3-child-exit=" + IntToStr(waitRes.exitCode))
    trace(root, "T4-child-output=[" + waitRes.output + "]")
    puts("parent-after-spawn")
    trace(root, "T5-done")
    return 0
