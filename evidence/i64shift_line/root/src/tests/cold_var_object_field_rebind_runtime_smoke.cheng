import std/system as system

type
    ColdVarObjectFieldRebindSource =
        text: str

fn ColdVarObjectFieldRebind(source: var ColdVarObjectFieldRebindSource): int32 =
    var localText = source.text
    if localText == "":
        let replacement = "local"
        if replacement != "":
            localText = replacement
    if source.text == "":
        if localText != "local":
            return 1
    elif localText != source.text:
        return 3
    if source.text != "caller":
        return 2
    return 0

fn main(): int32 =
    var source = ColdVarObjectFieldRebindSource(
        text: system.NewStringCopy(system.StrDataPtr("caller"), 6))
    let result = ColdVarObjectFieldRebind(source)
    if result != 0:
        return result
    if source.text != "caller":
        return 4
    source.text = ""
    return 0
