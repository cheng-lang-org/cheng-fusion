import std/system
import std/result
import cheng/core/lang/intern as langintern

type
    InternIndexStructuralSnapshot =
        keys: str[]
        vals: int32[]
        states: int32[]
        occupied: int32[]
        mask: uint64
        used: int32
        emptyId: langintern.InternId

@borrows
fn CaptureIndexStructuralSnapshot(
        pool: langintern.InternPool): InternIndexStructuralSnapshot =
    var out: InternIndexStructuralSnapshot
    for i in 0..<pool.indexVals.len:
        if pool.indexStates[i] == 1:
            let keyResult = langintern.LookupInternOwnedCopy(
                pool, pool.indexVals[i])
            assert(IsOk(keyResult), "intern snapshot: occupied key lookup")
            add(out.keys, Value(keyResult))
        else:
            add(out.keys, "")
    for i in 0..<pool.indexVals.len:
        add(out.vals, pool.indexVals[i])
    for i in 0..<pool.indexStates.len:
        add(out.states, pool.indexStates[i])
    for i in 0..<pool.indexOccupied.len:
        add(out.occupied, pool.indexOccupied[i])
    out.mask = pool.indexMask
    out.used = pool.indexUsed
    out.emptyId = pool.emptyId
    return out

@borrows
fn IndexStructuralSnapshotExact(
        pool: langintern.InternPool,
        expected: InternIndexStructuralSnapshot): bool =
    if pool.indexVals.len != expected.keys.len ||
       pool.indexVals.len != expected.vals.len ||
       pool.indexStates.len != expected.states.len ||
       pool.indexOccupied.len != expected.occupied.len ||
       pool.indexMask != expected.mask ||
       pool.indexUsed != expected.used ||
       pool.emptyId != expected.emptyId:
        return false
    for i in 0..<expected.keys.len:
        if pool.indexStates[i] == 1:
            let keyResult = langintern.LookupInternOwnedCopy(
                pool, pool.indexVals[i])
            if !IsOk(keyResult) || Value(keyResult) != expected.keys[i]:
                return false
        elif expected.keys[i] != "":
            return false
    for i in 0..<expected.vals.len:
        if pool.indexVals[i] != expected.vals[i]:
            return false
    for i in 0..<expected.states.len:
        if pool.indexStates[i] != expected.states[i]:
            return false
    for i in 0..<expected.occupied.len:
        if pool.indexOccupied[i] != expected.occupied[i]:
            return false
    return true

@borrows
fn IndependentPayloadBytes(pool: langintern.InternPool): int64 =
    var total: int64
    for id in 0..<langintern.InternPoolCount(pool):
        let textResult: Result[str] = langintern.LookupIntern(pool, id)
        assert(IsOk(textResult), "intern payload: independent lookup")
        total = total + Int64(len(textResult.value))
    return total

@borrows
fn AssertPayloadLedger(pool: langintern.InternPool,
                       expected: int64,
                       context: str) =
    let actual = langintern.InternPoolLogicalPayloadBytes(pool)
    let independent = IndependentPayloadBytes(pool)
    assert(actual == expected, context)
    assert(actual == independent, "intern payload: ledger differs from independent sum")

fn main() =
    var pool = langintern.InternPoolNew()
    AssertPayloadLedger(pool, Int64(0), "intern payload: new pool")
    let pristineIndex = CaptureIndexStructuralSnapshot(pool)
    var pristineProbe: langintern.InternLookupProbe
    assert(langintern.FindInternIdWithProbe(pool, "", pristineProbe) ==
               langintern.InvalidInternId() &&
           pristineProbe.queryCount == Int64(1) &&
           pristineProbe.emptyLookupCount == Int64(1) &&
           pristineProbe.bucketLookupCount == Int64(0) &&
           pristineProbe.linearTextScanStepCount == Int64(0) &&
           langintern.InternPoolCount(pool) == 0 &&
           langintern.InternPoolLogicalPayloadBytes(pool) == Int64(0) &&
           IndexStructuralSnapshotExact(pool, pristineIndex),
           "intern find: absent empty is read-only")

    let alphaId = langintern.Intern(pool, "alpha")
    assert(alphaId == 0, "intern payload: first unique id")
    AssertPayloadLedger(pool, Int64(5), "intern payload: first unique")

    let alphaDuplicateId = langintern.Intern(pool, "alpha")
    assert(alphaDuplicateId == alphaId, "intern payload: duplicate id")
    assert(langintern.InternPoolCount(pool) == 1, "intern payload: duplicate count")
    AssertPayloadLedger(pool, Int64(5), "intern payload: duplicate unchanged")

    let emptyId = langintern.Intern(pool, "")
    let emptyDuplicateId = langintern.Intern(pool, "")
    assert(emptyId == emptyDuplicateId, "intern payload: duplicate empty id")
    assert(langintern.InternPoolCount(pool) == 2, "intern payload: unique empty count")
    AssertPayloadLedger(pool, Int64(5), "intern payload: empty contributes zero")

    let betaId = langintern.Intern(pool, "beta-42")
    assert(betaId == 2, "intern payload: second nonempty id")
    AssertPayloadLedger(pool, Int64(12), "intern payload: multiple unique")

    let findCountBefore = langintern.InternPoolCount(pool)
    let findBytesBefore = langintern.InternPoolLogicalPayloadBytes(pool)
    let findIndexBefore = CaptureIndexStructuralSnapshot(pool)
    var findProbe: langintern.InternLookupProbe
    assert(langintern.FindInternIdWithProbe(pool, "alpha", findProbe) == alphaId,
           "intern find: existing id")
    assert(langintern.FindInternIdWithProbe(pool, "missing", findProbe) ==
               langintern.InvalidInternId(),
           "intern find: missing id")
    assert(langintern.FindInternIdWithProbe(pool, "", findProbe) == emptyId,
           "intern find: empty id")
    assert(findProbe.queryCount == Int64(3) &&
           findProbe.bucketLookupCount == Int64(2) &&
           findProbe.emptyLookupCount == Int64(1) &&
           findProbe.linearTextScanStepCount == Int64(0),
           "intern find: structured probe")
    assert(langintern.InternPoolCount(pool) == findCountBefore &&
           langintern.InternPoolLogicalPayloadBytes(pool) == findBytesBefore &&
           IndexStructuralSnapshotExact(pool, findIndexBefore),
           "intern find: pool and index unchanged")

    var largePool = langintern.InternPoolNew()
    var largeKeys: str[]
    let largeCount: int32 = 4096
    for i in 0..<largeCount:
        let key = Fmt"lookup-key-{i}"
        add(largeKeys, strings.CloneStr(key))
        assert(langintern.Intern(largePool, key) == i,
               "intern find: large insert id")
    let largeEmptyId = langintern.Intern(largePool, "")
    assert(largeEmptyId == largeCount, "intern find: large empty id")
    let largePoolCountBefore = langintern.InternPoolCount(largePool)
    let largePoolBytesBefore =
        langintern.InternPoolLogicalPayloadBytes(largePool)
    let largeIndexBefore = CaptureIndexStructuralSnapshot(largePool)
    var largeProbe: langintern.InternLookupProbe
    for i in 0..<largeCount:
        assert(langintern.FindInternIdWithProbe(
                   largePool, largeKeys[i], largeProbe) == i,
               "intern find: large hit")
    for i in 0..<largeCount:
        let missingKey = Fmt"missing-key-{i}"
        assert(langintern.FindInternIdWithProbe(
                   largePool, missingKey, largeProbe) ==
                       langintern.InvalidInternId(),
               "intern find: large miss")
    assert(langintern.FindInternIdWithProbe(largePool, "", largeProbe) ==
               largeEmptyId,
           "intern find: large empty")
    let expectedBucketLookups = Int64(largeCount) * Int64(2)
    assert(largeProbe.queryCount == expectedBucketLookups + Int64(1) &&
           largeProbe.bucketLookupCount == expectedBucketLookups &&
           largeProbe.emptyLookupCount == Int64(1) &&
           largeProbe.linearTextScanStepCount == Int64(0),
           "intern find: large lookup work is linear")
    assert(langintern.InternPoolCount(largePool) == largePoolCountBefore &&
           langintern.InternPoolLogicalPayloadBytes(largePool) ==
               largePoolBytesBefore &&
           IndexStructuralSnapshotExact(largePool, largeIndexBefore),
           "intern find: large query state unchanged")
    langintern.InternPoolRelease(largePool)

    var cloned = langintern.InternPoolClone(pool)
    assert(langintern.InternPoolCount(cloned) == langintern.InternPoolCount(pool),
           "intern payload: clone count")
    AssertPayloadLedger(cloned, Int64(12), "intern payload: clone exact")
    let clonedAlphaId = langintern.Intern(cloned, "alpha")
    let clonedEmptyId = langintern.Intern(cloned, "")
    assert(clonedAlphaId == alphaId && clonedEmptyId == emptyId,
           "intern payload: clone preserves duplicate ids")
    AssertPayloadLedger(cloned, Int64(12), "intern payload: clone duplicates unchanged")

    let originalOnlyId = langintern.Intern(pool, "original-only")
    assert(originalOnlyId == 3, "intern payload: original independent id")
    AssertPayloadLedger(pool, Int64(25), "intern payload: original independent growth")
    AssertPayloadLedger(cloned, Int64(12), "intern payload: clone unaffected by original")

    let cloneOnlyId = langintern.Intern(cloned, "clone-only")
    assert(cloneOnlyId == 3, "intern payload: clone independent id")
    AssertPayloadLedger(cloned, Int64(22), "intern payload: clone independent growth")
    AssertPayloadLedger(pool, Int64(25), "intern payload: original unaffected by clone")

    let beforeReleaseIndexCount = langintern.InternPoolCount(pool)
    let beforeReleaseIndexBytes = langintern.InternPoolLogicalPayloadBytes(pool)
    langintern.InternPoolReleaseIndex(pool)
    assert(langintern.InternPoolCount(pool) == beforeReleaseIndexCount,
           "intern payload: release index preserves count")
    assert(langintern.FindInternId(pool, "alpha") ==
               langintern.InvalidInternId() &&
           langintern.FindInternId(pool, "") == emptyId,
           "intern find: released index preserves only empty id lookup")
    AssertPayloadLedger(pool, beforeReleaseIndexBytes,
                        "intern payload: release index preserves payload")

    langintern.InternPoolReset(pool)
    assert(langintern.InternPoolCount(pool) == 0, "intern payload: reset count")
    AssertPayloadLedger(pool, Int64(0), "intern payload: reset clears ledger")

    let reuseId = langintern.Intern(pool, "reuse")
    let reuseDuplicateId = langintern.Intern(pool, "reuse")
    let reuseEmptyId = langintern.Intern(pool, "")
    assert(reuseId == 0 && reuseDuplicateId == reuseId && reuseEmptyId == 1,
           "intern payload: reset reuse ids")
    AssertPayloadLedger(pool, Int64(5), "intern payload: reset reuse exact")

    langintern.InternPoolRelease(pool)
    assert(langintern.InternPoolCount(pool) == 0, "intern payload: release count")
    AssertPayloadLedger(pool, Int64(0), "intern payload: release clears ledger")

    langintern.InternPoolRelease(cloned)
    assert(langintern.InternPoolCount(cloned) == 0, "intern payload: clone release count")
    AssertPayloadLedger(cloned, Int64(0), "intern payload: clone release clears ledger")

    echo("intern_pool_payload_bytes_smoke ok")
