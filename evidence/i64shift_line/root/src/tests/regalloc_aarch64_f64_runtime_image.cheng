import cheng/core/ir/core_types as ir
import cheng/core/backend/regalloc_single_pass as alloc
import cheng/core/backend/regalloc_production_emitter as emitter
import cheng/core/backend/regalloc_production_artifacts as artifacts
import cheng/core/backend/codegen_contract as contract
import cheng/core/lang/typed_expr as texpr
import std/strings
import cheng/core/backend/regalloc_aarch64_adapter as rega64

fn newBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    body.typeArenaArtifactCid.data[0] = uint8(1)
    return body

fn makeSlot(id: int32,
            typeKind: int32,
            sizeBytes: int32,
            alignBytes: int32,
            parameter: bool,
            paramOrdinal: int32,
            placeKind: int32): ir.LocalSlot =
    var slot: ir.LocalSlot
    slot.id = id
    slot.name = "runtime_f64"
    slot.typeKind = typeKind
    slot.stackOffset = 16 + id * 16
    if parameter:
        slot.stackOffset = 0 - 1 - paramOrdinal
    slot.sizeBytes = sizeBytes
    slot.alignBytes = alignBytes
    ir.BodyIRApplyLocalSlotDefaultProof(slot)
    slot.placeKind = placeKind
    return slot

fn appendReturn(body: var ir.BodyIR,
                slotIndex: int32,
                typeKind: int32): int32 =
    var term: ir.BodyTerm
    ir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = slotIndex
    add(term.operands, typeKind)
    return ir.BodyIRAppendTerm(body, term)

fn appendVoidReturn(body: var ir.BodyIR): int32 =
    var term: ir.BodyTerm
    ir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = -1
    return ir.BodyIRAppendTerm(body, term)

fn buildCmpBody(conditionKind: int32): ir.BodyIR =
    var body = newBody()
    add(body.localSlots, makeSlot(
        0, ir.LocalF64Tag, 8, 8, true, 0,
        ir.BodyPlaceStackValueTag))
    add(body.localSlots, makeSlot(
        1, ir.LocalF64Tag, 8, 8, true, 1,
        ir.BodyPlaceStackValueTag))
    add(body.localSlots, makeSlot(
        2, ir.LocalI32Tag, 4, 4, false, -1,
        ir.BodyPlaceStackValueTag))
    var compare: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(compare)
    compare.kind = ir.BodyOpCmpTag
    compare.target = 2
    add(compare.operands, conditionKind)
    add(compare.operands, 0)
    add(compare.operands, 1)
    add(body.ops, compare)
    let termIndex = appendReturn(body, 2, ir.LocalI32Tag)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn buildLocalStoreBody(): ir.BodyIR =
    var body = newBody()
    add(body.localSlots, makeSlot(
        0, ir.LocalF64Tag, 8, 8, true, 0,
        ir.BodyPlaceStackValueTag))
    add(body.localSlots, makeSlot(
        1, ir.LocalF64Tag, 8, 8, true, 1,
        ir.BodyPlaceStackValueTag))
    add(body.localSlots, makeSlot(
        2, ir.LocalF64Tag, 8, 8, false, -1,
        ir.BodyPlaceStackValueTag))
    add(body.localSlots, makeSlot(
        3, ir.LocalF64Tag, 8, 8, false, -1,
        ir.BodyPlaceStackValueTag))
    var copy: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(copy)
    copy.kind = ir.BodyOpStoreLocalTag
    copy.target = 2
    add(copy.operands, 0)
    add(body.ops, copy)
    var addOp: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(addOp)
    addOp.kind = ir.BodyOpBinOpTag
    addOp.target = 3
    add(addOp.operands, ir.LocalF64Tag)
    add(addOp.operands, int32(texpr.TypedExprIrOpF64Add))
    add(addOp.operands, 2)
    add(addOp.operands, 1)
    add(body.ops, addOp)
    let termIndex = appendReturn(body, 3, ir.LocalF64Tag)
    let _ = ir.BodyIRAppendBlock(body, 0, 2, termIndex)
    return body

fn buildFieldStoreBody(): ir.BodyIR =
    var body = newBody()
    add(body.localSlots, makeSlot(
        0, ir.LocalPtrTag, 8, 8, true, 0,
        ir.BodyPlaceStackValueTag))
    add(body.localSlots, makeSlot(
        1, ir.LocalF64Tag, 8, 8, true, 1,
        ir.BodyPlaceStackValueTag))
    var store: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(store)
    store.kind = ir.BodyOpFieldStoreTag
    store.target = 0
    add(store.operands, 0)
    add(store.operands, 1)
    add(store.operands, 8)
    add(store.operands, 8)
    add(body.ops, store)
    let termIndex = appendVoidReturn(body)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn buildIndexedStoreBody(): ir.BodyIR =
    var body = newBody()
    add(body.localSlots, makeSlot(
        0, ir.LocalAggregateTag, 64, 8, true, 0,
        ir.BodyPlaceParamAddressTag))
    add(body.localSlots, makeSlot(
        1, ir.LocalF64Tag, 8, 8, true, 1,
        ir.BodyPlaceStackValueTag))
    add(body.localSlots, makeSlot(
        2, ir.LocalI32Tag, 4, 4, true, 2,
        ir.BodyPlaceStackValueTag))
    var store: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(store)
    store.kind = ir.BodyOpIndexedStoreTag
    store.target = 0
    add(store.operands, 0)
    add(store.operands, 1)
    add(store.operands, 2)
    add(store.operands, 8)
    add(body.ops, store)
    let termIndex = appendVoidReturn(body)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn buildConstBody(bits: uint64): ir.BodyIR =
    var body = newBody()
    add(body.localSlots, makeSlot(
        0, ir.LocalF64Tag, 8, 8, false, -1,
        ir.BodyPlaceStackValueTag))
    let chunk = uint64(65536)
    let chunk2 = chunk * chunk
    let chunk3 = chunk2 * chunk
    var constant: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(constant)
    constant.kind = ir.BodyOpLoadConstTag
    constant.target = 0
    add(constant.operands, ir.LocalF64Tag)
    add(constant.operands, int32(bits % chunk))
    add(constant.operands, int32((bits / chunk) % chunk))
    add(constant.operands, int32((bits / chunk2) % chunk))
    add(constant.operands, int32((bits / chunk3) % chunk))
    add(body.ops, constant)
    let termIndex = appendReturn(body, 0, ir.LocalF64Tag)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn buildIdentityBody(): ir.BodyIR =
    var body = newBody()
    add(body.localSlots, makeSlot(
        0, ir.LocalF64Tag, 8, 8, true, 0,
        ir.BodyPlaceStackValueTag))
    let termIndex = appendReturn(body, 0, ir.LocalF64Tag)
    let _ = ir.BodyIRAppendBlock(body, 0, 0, termIndex)
    return body

fn buildCallClobberBody(): ir.BodyIR =
    var body = newBody()
    add(body.localSlots, makeSlot(
        0, ir.LocalF64Tag, 8, 8, true, 0,
        ir.BodyPlaceStackValueTag))
    for carrierIndex in 0..<5:
        add(body.localSlots, makeSlot(
            1 + carrierIndex, ir.LocalI64Tag, 8, 8, false, -1,
            ir.BodyPlaceStackValueTag))
    add(body.localSlots, makeSlot(
        6, ir.LocalF64Tag, 8, 8, false, -1,
        ir.BodyPlaceStackValueTag))
    add(body.localSlots, makeSlot(
        7, ir.LocalI64Tag, 8, 8, false, -1,
        ir.BodyPlaceStackValueTag))
    for carrierIndex in 0..<5:
        var carrier: ir.BodyOp
        ir.BodyIRApplyBodyOpDefaultProof(carrier)
        carrier.kind = ir.BodyOpLoadConstTag
        carrier.target = 1 + carrierIndex
        add(carrier.operands, ir.LocalI64Tag)
        add(carrier.operands, int32(37 + carrierIndex))
        add(body.ops, carrier)
    var call: ir.CallOp
    ir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = "regalloc_raw_f64_identity"
    call.resultSlot = 6
    call.resultPassKind = ir.BodyCallPassStackValueTag
    call.relocWordOffset = -1
    add(call.argSlots, 0)
    add(call.argPassKinds, ir.BodyCallPassStackValueTag)
    add(call.argAbiSizes, 8)
    add(body.callSequence, call)
    var callOp: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(callOp)
    callOp.kind = ir.BodyOpCallTag
    callOp.target = 6
    add(callOp.operands, 0)
    add(body.ops, callOp)
    for carrierIndex in 0..<5:
        var consumeCarrier: ir.BodyOp
        ir.BodyIRApplyBodyOpDefaultProof(consumeCarrier)
        consumeCarrier.kind = ir.BodyOpBinOpTag
        consumeCarrier.target = 7
        add(consumeCarrier.operands, ir.LocalI64Tag)
        add(consumeCarrier.operands, int32(texpr.TypedExprIrOpI64Add))
        add(consumeCarrier.operands, 1 + carrierIndex)
        add(consumeCarrier.operands, 1 + carrierIndex)
        add(body.ops, consumeCarrier)
    let termIndex = appendReturn(body, 6, ir.LocalF64Tag)
    let _ = ir.BodyIRAppendBlock(body, 0, 11, termIndex)
    return body

fn emitFunction(name: str, body: var ir.BodyIR): bool =
    var noCalls: str[]
    var noData: str[]
    var emission = emitter.RegallocProductionEmitFunction(
        "arm64-apple-darwin",
        body, name, 0, noCalls, noData,
        0, artifacts.RegallocProductionFunctionKindNormal)
    if !emission.valid ||
       emission.recipes.functionWords.len <= 0 ||
       emission.recipes.functionRelocs.len != 0:
        return false
    echo(".p2align 2")
    echo(Fmt".globl _{name}")
    echo(Fmt"_{name}:")
    for wordIndex in 0..<emission.recipes.functionWords.len:
        echo(Fmt"    .long {strings.IntToStr(emission.recipes.functionWords[wordIndex])}")
    return true

fn emitCallClobberFunction(name: str, body: var ir.BodyIR): bool =
    var callTargets: str[] = ["_regalloc_raw_f64_identity"]
    var noData: str[]
    var emission = emitter.RegallocProductionEmitFunction(
        "arm64-apple-darwin",
        body, name, 0, callTargets, noData,
        0, artifacts.RegallocProductionFunctionKindNormal)
    if !emission.valid ||
       emission.recipes.functionWords.len <= 0 ||
       emission.recipes.functionRelocs.len != 1 ||
       emission.recipes.functionRelocs[0].kind !=
           contract.RegallocA64RelocCall26:
        return false
    var spillCount: int32
    var reloadCount: int32
    var clobberCount: int32
    for actionIndex in 0..<emission.plan.actions.len:
        let kind = emission.plan.actions[actionIndex].kind
        if kind == alloc.RegallocValueActionSpillCall:
            spillCount = spillCount + 1
        elif kind == alloc.RegallocValueActionReloadCall:
            reloadCount = reloadCount + 1
        elif kind == alloc.RegallocValueActionCallClobber:
            clobberCount = clobberCount + 1
    echo(Fmt"# regalloc_call_clobber_actions spill={spillCount} reload={reloadCount} clobber={clobberCount}")
    if spillCount != 1 || reloadCount != 1 || clobberCount != 1:
        return false
    echo(".p2align 2")
    echo(Fmt".globl _{name}")
    echo(Fmt"_{name}:")
    let reloc = emission.recipes.functionRelocs[0]
    for wordIndex in 0..<emission.recipes.functionWords.len:
        if wordIndex == reloc.wordIndex:
            echo(Fmt"    bl {reloc.targetSymbol}")
        else:
            echo(Fmt"    .long {strings.IntToStr(emission.recipes.functionWords[wordIndex])}")
    return true

fn main(): int32 =
    # B1: codegen unit composition root (dispatch fails closed without registration)
    if !rega64.RegallocA64CodegenUnitRegister():
        return 90
    echo(".text")
    var conditions: int32[] = [
        ir.BodyCondF64EqTag, ir.BodyCondF64NeTag,
        ir.BodyCondF64LtTag, ir.BodyCondF64LeTag,
        ir.BodyCondF64GtTag, ir.BodyCondF64GeTag]
    var names: str[] = [
        "regalloc_raw_f64_eq", "regalloc_raw_f64_ne",
        "regalloc_raw_f64_lt", "regalloc_raw_f64_le",
        "regalloc_raw_f64_gt", "regalloc_raw_f64_ge"]
    for index in 0..<conditions.len:
        var body = buildCmpBody(conditions[index])
        if !emitFunction(names[index], body):
            return 10 + index
    var localBody = buildLocalStoreBody()
    if !emitFunction("regalloc_raw_f64_local", localBody):
        return 20
    var fieldBody = buildFieldStoreBody()
    if !emitFunction("regalloc_raw_f64_field", fieldBody):
        return 21
    var indexedBody = buildIndexedStoreBody()
    if !emitFunction("regalloc_raw_f64_index", indexedBody):
        return 22
    var nanBody = buildConstBody(uint64(9221120237041090626))
    if !emitFunction("regalloc_raw_f64_const_nan", nanBody):
        return 23
    var negativeZeroBody = buildConstBody(uint64(9223372036854775808))
    if !emitFunction("regalloc_raw_f64_const_negative_zero",
                     negativeZeroBody):
        return 24
    var infinityBody = buildConstBody(uint64(9218868437227405312))
    if !emitFunction("regalloc_raw_f64_const_infinity", infinityBody):
        return 25
    var subnormalBody = buildConstBody(uint64(1))
    if !emitFunction("regalloc_raw_f64_const_subnormal", subnormalBody):
        return 26
    var identityBody = buildIdentityBody()
    if !emitFunction("regalloc_raw_f64_identity", identityBody):
        return 27
    var callClobberBody = buildCallClobberBody()
    if !emitCallClobberFunction(
            "regalloc_raw_f64_call_clobber", callClobberBody):
        return 28
    return 0
