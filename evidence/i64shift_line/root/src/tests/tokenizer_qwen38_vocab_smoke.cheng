# tokenizer_qwen38_vocab_smoke.cheng - W13 Qwen3.8 vocab adaptation gate smoke.
#
# 1) Special-token id constants are checked against the real Qwen/Qwen3.8-27B
#    config values (image 248056 / video 248057 / vision_start 248053 /
#    vision_end 248054 / bos==eos 248044) and against Qwen38VocabSize bounds.
# 2) The real build-generated qwen25 fixture is loaded and must be REJECTED
#    by Qwen38TokenizerValidateVocab -- first proven well-formed at header
#    level (so the rejection is attributable to the vocab count alone), then
#    asserted against the exact mismatch error text.
# 3) A minimal synthetic 28-byte header with vocabCount=248320 must be
#    ACCEPTED.
#    *** FORMAT FIXTURE, NOT MODEL DATA ***: those 28 bytes are hand-built
#    strictly per the documented bin header layout ("TOK1" magic, version 1,
#    counts, placeholder contentHash=0). The header-level check cannot verify
#    the section rolling hash without the full vocab/merge/special body,
#    which a header-only fixture intentionally does not carry. No real
#    Qwen3.8 vocab bytes exist here; acceptance proves header math only.
#    Real-vocab coverage lands together with the real Qwen3.8 tokenizer
#    fixture in a later W13 step.
# 4) Gate negatives on synthetic headers: truncated buffer / bad magic /
#    bad version / zero vocabCount / off-by-one vocabCount are each rejected
#    with their exact error strings.

import std/result
import std/os
import std/rawbytes
import std/strings
import std/strutils as strutil
import cheng/inference/tokenizer as tok
import cheng/inference/tokenizer_qwen38 as q38

fn appendI32LE(b: var rawbytes.BytesBuilder, v: int32) =
    rawbytes.BytesBuilderAppendByte(b, v & 255)
    rawbytes.BytesBuilderAppendByte(b, (v >> 8) & 255)
    rawbytes.BytesBuilderAppendByte(b, (v >> 16) & 255)
    rawbytes.BytesBuilderAppendByte(b, (v >> 24) & 255)

fn appendI64LE(b: var rawbytes.BytesBuilder, v: int64) =
    var x: int64 = v
    for i in 0..<8:
        rawbytes.BytesBuilderAppendByte(b, int32(x & int64(255)))
        x = x >> 8

# FORMAT FIXTURE (see file header comment): minimal legal bin header, built
# byte-by-byte from the documented little-endian layout.
fn syntheticQwen38HeaderBytes(vocabCount: int32, magic: int32, version: int32): rawbytes.Bytes =
    var b: rawbytes.BytesBuilder = rawbytes.BytesBuilderNew(28)
    appendI32LE(b, magic)
    appendI32LE(b, version)
    appendI32LE(b, vocabCount)
    appendI32LE(b, 0)
    appendI32LE(b, 0)
    appendI64LE(b, int64(0))
    return rawbytes.BytesBuilderFinish(b)

fn main(): int32 =
    // 1. special token id constants match the real config, table-checked.
    assert(q38.Qwen38VocabSize == 248320, " tokenizer_qwen38_vocab_smoke: Qwen38VocabSize")
    assert(q38.Qwen38ImageTokenId == 248056, " tokenizer_qwen38_vocab_smoke: image token id")
    assert(q38.Qwen38VideoTokenId == 248057, " tokenizer_qwen38_vocab_smoke: video token id")
    assert(q38.Qwen38VisionStartTokenId == 248053, " tokenizer_qwen38_vocab_smoke: vision_start token id")
    assert(q38.Qwen38VisionEndTokenId == 248054, " tokenizer_qwen38_vocab_smoke: vision_end token id")
    assert(q38.Qwen38BosTokenId == 248044, " tokenizer_qwen38_vocab_smoke: bos token id")
    assert(q38.Qwen38EosTokenId == 248044, " tokenizer_qwen38_vocab_smoke: eos token id")
    assert(q38.Qwen38ImageTokenId >= 0 && q38.Qwen38ImageTokenId < q38.Qwen38VocabSize &&
           q38.Qwen38VideoTokenId >= 0 && q38.Qwen38VideoTokenId < q38.Qwen38VocabSize &&
           q38.Qwen38VisionStartTokenId >= 0 && q38.Qwen38VisionStartTokenId < q38.Qwen38VocabSize &&
           q38.Qwen38VisionEndTokenId >= 0 && q38.Qwen38VisionEndTokenId < q38.Qwen38VocabSize &&
           q38.Qwen38BosTokenId >= 0 && q38.Qwen38BosTokenId < q38.Qwen38VocabSize &&
           q38.Qwen38EosTokenId >= 0 && q38.Qwen38EosTokenId < q38.Qwen38VocabSize,
           " tokenizer_qwen38_vocab_smoke: special ids within vocab bounds")

    // 2. real qwen25 fixture: healthy loader input, rejected by the qwen3.8 gate.
    let fixturePath = "artifacts/tokenizer/qwen25/tokenizer_qwen25.bin"
    let loadRes = tok.TokenizerLoad(strings.CloneStr(fixturePath))
    assert(IsOk(loadRes), " tokenizer_qwen38_vocab_smoke: qwen25 fixture loads under stock runtime")
    let stockTok = Value(loadRes)
    assert(stockTok.vocabOffset.len > 256, " tokenizer_qwen38_vocab_smoke: qwen25 fixture non-empty")

    let bytesRes = os.ReadFileBytesResult(fixturePath)
    assert(IsOk(bytesRes), " tokenizer_qwen38_vocab_smoke: read qwen25 fixture bytes")
    let buf: rawbytes.Bytes = Value(bytesRes)

    let hdrRes = q38.Qwen38TokenizerHeaderCheck(buf)
    assert(IsOk(hdrRes), " tokenizer_qwen38_vocab_smoke: qwen25 header itself is well-formed")
    let q25Hdr = Value(hdrRes)
    assert(q25Hdr.vocabCount != q38.Qwen38VocabSize,
           " tokenizer_qwen38_vocab_smoke: qwen25 vocabCount really differs from qwen3.8")

    let valRes = q38.Qwen38TokenizerValidateVocab(buf)
    assert(IsErr(valRes), " tokenizer_qwen38_vocab_smoke: qwen25 fixture rejected")
    let wantMismatch: str = strutil.Join(["qwen38 tokenizer: vocab size mismatch: expected ",
                                          strings.IntToStr(q38.Qwen38VocabSize), " got ",
                                          strings.IntToStr(q25Hdr.vocabCount)], "")
    assert(Error(valRes) == wantMismatch,
           " tokenizer_qwen38_vocab_smoke: exact vocab mismatch error")

    // 3. synthetic 248320 header (FORMAT FIXTURE, see file header): accepted.
    let goodBytes: rawbytes.Bytes = syntheticQwen38HeaderBytes(q38.Qwen38VocabSize, 0x314b4f54, 1)
    let goodHdrRes = q38.Qwen38TokenizerHeaderCheck(goodBytes)
    assert(IsOk(goodHdrRes), " tokenizer_qwen38_vocab_smoke: synthetic header parses")
    let goodHdr = Value(goodHdrRes)
    assert(goodHdr.vocabCount == q38.Qwen38VocabSize && goodHdr.mergeCount == 0 &&
           goodHdr.specialCount == 0 && goodHdr.contentHash == int64(0),
           " tokenizer_qwen38_vocab_smoke: synthetic header fields roundtrip")
    let goodValRes = q38.Qwen38TokenizerValidateVocab(goodBytes)
    assert(IsOk(goodValRes), " tokenizer_qwen38_vocab_smoke: synthetic 248320 header accepted")

    // 4. gate negatives, each with its exact error string.
    let truncBytes: rawbytes.Bytes = rawbytes.BytesSliceView(goodBytes, 0, 27)
    let truncRes = q38.Qwen38TokenizerValidateVocab(truncBytes)
    assert(IsErr(truncRes) && Error(truncRes) == "qwen38 tokenizer: truncated header",
           " tokenizer_qwen38_vocab_smoke: truncated header rejected")

    let badMagicBytes: rawbytes.Bytes = syntheticQwen38HeaderBytes(q38.Qwen38VocabSize, 0x314b4f55, 1)
    let badMagicRes = q38.Qwen38TokenizerValidateVocab(badMagicBytes)
    assert(IsErr(badMagicRes) && Error(badMagicRes) == "qwen38 tokenizer: bad magic",
           " tokenizer_qwen38_vocab_smoke: bad magic rejected")

    let badVerBytes: rawbytes.Bytes = syntheticQwen38HeaderBytes(q38.Qwen38VocabSize, 0x314b4f54, 2)
    let badVerRes = q38.Qwen38TokenizerValidateVocab(badVerBytes)
    assert(IsErr(badVerRes) && Error(badVerRes) == "qwen38 tokenizer: bad version",
           " tokenizer_qwen38_vocab_smoke: bad version rejected")

    let zeroVocabBytes: rawbytes.Bytes = syntheticQwen38HeaderBytes(0, 0x314b4f54, 1)
    let zeroVocabRes = q38.Qwen38TokenizerValidateVocab(zeroVocabBytes)
    assert(IsErr(zeroVocabRes) && Error(zeroVocabRes) == "qwen38 tokenizer: bad counts",
           " tokenizer_qwen38_vocab_smoke: zero vocabCount rejected")

    let offByOneBytes: rawbytes.Bytes = syntheticQwen38HeaderBytes(248319, 0x314b4f54, 1)
    let offByOneRes = q38.Qwen38TokenizerValidateVocab(offByOneBytes)
    let wantOffByOne: str = strutil.Join(["qwen38 tokenizer: vocab size mismatch: expected ",
                                          strings.IntToStr(q38.Qwen38VocabSize), " got 248319"], "")
    assert(IsErr(offByOneRes) && Error(offByOneRes) == wantOffByOne,
           " tokenizer_qwen38_vocab_smoke: off-by-one vocabCount rejected")

    // 5. file-level entry point: synthetic fixture accepted, missing file is
    //    a literal error. goodBytes is consumed by the write, so this runs
    //    after every direct-bytes use above.
    let tmpDir: str = os.GetEnvDefault("TMPDIR", "/tmp")
    let tmpPath: str = strutil.Join([strings.CloneStr(tmpDir), "/tokenizer_qwen38_vocab_smoke_header.bin"], "")
    let writeRes = os.WriteFileBytesResult(strings.CloneStr(tmpPath), goodBytes)
    assert(IsOk(writeRes), " tokenizer_qwen38_vocab_smoke: write synthetic fixture")
    let fileRes = q38.Qwen38TokenizerValidateVocabFile(strings.CloneStr(tmpPath))
    assert(IsOk(fileRes) && Value(fileRes).vocabCount == q38.Qwen38VocabSize,
           " tokenizer_qwen38_vocab_smoke: file-level validate accepts synthetic fixture")
    assert(os.RemoveFile(strings.CloneStr(tmpPath)), " tokenizer_qwen38_vocab_smoke: cleanup synthetic fixture")
    let missingRes = q38.Qwen38TokenizerValidateVocabFile(
        strutil.Join([strings.CloneStr(tmpDir), "/tokenizer_qwen38_vocab_smoke_missing.bin"], ""))
    assert(IsErr(missingRes) && Error(missingRes) == "qwen38 tokenizer: fixture file not found",
           " tokenizer_qwen38_vocab_smoke: missing fixture rejected")

    echo(" tokenizer_qwen38_vocab_smoke ok")
    return 0
