# Runtime verification for the pause-backpressure slice of
# docs/video-seek-scrub-blueprint.md (§7.4 "暂停不停流" / §S8), added to
# web_scene_media_network_bridge.cheng: webSceneMediaEsPaused +
# WebSceneMediaEsSetPaused/WebSceneMediaEsPaused gating WebSceneMediaEsStreamLoop and
# WebSceneMediaEsPrefetchTick. Real QUIC client against a real media_moq_publisher_main
# process serving the real hgs_faststart ES fixture — no mocked network, no faked gate:
# every "no network happened while paused" assertion below is proven by an independent,
# paused-unaware oracle (the sink's own capture counter, and the S4 block cache's own
# Get() miss/hit — not a paused-aware assertion the gate itself could rubber-stamp).
#
# The host FIFO sink (cheng_scene_media_es_sink_frame) and diag hook (cheng_host_es_diag)
# are the same desktop-only C stub used by the S5 prefetch-tick check
# (host_stub/es_prefetch_test_host_stub.c, linked in via --provider-objects, unmodified —
# it always reports "FIFO full" after exactly one captured frame, which is enough to
# observe whether a StreamLoop tick actually delivered anything).
#
# Asserts, in order:
#   1. WebSceneMediaEsOpen succeeds against the real publisher.
#   2. WebSceneMediaEsPaused() defaults to false (module-load state sanity).
#   3. An UNPAUSED StreamLoop tick dials and delivers exactly one frame (captured==1,
#      frameIdx==0) — the pre-pause baseline this test's later "unchanged" checks diff
#      against.
#   4. SetPaused(true) flips the getter.
#   5. A PAUSED StreamLoop tick returns 8 and changes NEITHER the sink's captured count
#      NOR the pump cursor — no dial, no fetch happened (not just "returned an error
#      code" — the sink's own counter is the independent witness).
#   6. A PAUSED PrefetchTick call returns 4 and the target GOP (frame 120) is STILL a
#      cache miss afterward — proves no network fetch and no cache write happened while
#      paused (the miss/hit state is the independent witness, not a paused-aware flag).
#   7. SetPaused(false) flips the getter back.
#   8. An UNPAUSED StreamLoop tick resumes (rc==0, captured count increments to 2) from
#      the SAME cursor with no redial (WebSceneMediaEsDialedPort() unchanged) — pause is
#      backpressure, not teardown.
#   9. An UNPAUSED PrefetchTick call now actually fetches (rc==1) and the target GOP
#      becomes a real cache hit whose byte length matches the independent python oracle
#      (946127 bytes, same ground truth media_moq_es_prefetch_tick_check_main.cheng
#      uses) — contrast with #6 proves the earlier paused call was the reason nothing
#      was cached, not a pre-existing miss the test would have hit either way.
# Any failure prints a reason and exits nonzero; success prints "ALL OK" and exits 0.

import std/os
import std/rawbytes
import std/strutils as strutil
import std/cmdline as cmdline
import cheng/core/runtime/web_scene_media_network_bridge as media_bridge
import cheng/core/runtime/web_scene_media_block_cache as blockcache

@importc("cheng_test_es_sink_first_frame_idx")
fn chengTestEsSinkFirstFrameIdx(): int32

@importc("cheng_test_es_sink_captured")
fn chengTestEsSinkCaptured(): int32

fn fail(msg: str): int32 =
    os.WriteLine(os.Get_stdout(), strutil.Join(["FAIL: ", msg], ""))
    return 1

fn main(): int32 =
    var hostRaw: str
    let hasHost: bool = cmdline.ReadFirstFlagValue("--host", hostRaw)
    let host: str = if hasHost: hostRaw else: "127.0.0.1"
    let port: int32 = cmdline.ReadInt32FlagOrDefault("--port", 38000)
    var rootRaw: str
    let hasRoot: bool = cmdline.ReadFirstFlagValue("--root", rootRaw)
    if !hasRoot:
        return fail("missing --root")
    let targetGop: int32 = 120
    let oracleGopLen: int32 = 946127

    if !blockcache.WebSceneMediaBlockCacheInit(rootRaw):
        return fail(strutil.Join(["Init(root) failed: ", rootRaw], ""))

    # 1. Open against the real publisher.
    if !media_bridge.WebSceneMediaEsOpen(host, port):
        return fail(strutil.Join(["es_open failed: ", media_bridge.WebSceneMediaEsLastError()], ""))
    let assetCid: str = media_bridge.WebSceneMediaEsAssetCid()
    if assetCid.len == 0:
        return fail("asset_cid empty after open")
    let dialedPortBefore: int32 = media_bridge.WebSceneMediaEsDialedPort()
    os.WriteLine(os.Get_stdout(), "step1_open_ok")

    # 2. Default state must be unpaused.
    if media_bridge.WebSceneMediaEsPaused():
        return fail("WebSceneMediaEsPaused() defaulted to true")
    os.WriteLine(os.Get_stdout(), "step2_default_unpaused_ok")

    # 3. Baseline: one unpaused tick dials and delivers frame 0.
    let baseRc: int32 = media_bridge.WebSceneMediaEsStreamLoop()
    if baseRc != 0:
        return fail(strutil.Join(["baseline StreamLoop unexpected rc=", IntToStr(baseRc)], ""))
    if chengTestEsSinkCaptured() != 1:
        return fail(strutil.Join(["baseline captured=", IntToStr(chengTestEsSinkCaptured()), " want=1"], ""))
    if chengTestEsSinkFirstFrameIdx() != 0:
        return fail(strutil.Join(["baseline first frameIdx=", IntToStr(chengTestEsSinkFirstFrameIdx()), " want=0"], ""))
    let cursorBeforePause: int32 = media_bridge.WebSceneMediaEsPumpCursor()
    os.WriteLine(os.Get_stdout(), "step3_baseline_delivered_ok")

    # 4. Pause.
    media_bridge.WebSceneMediaEsSetPaused(true)
    if !media_bridge.WebSceneMediaEsPaused():
        return fail("WebSceneMediaEsPaused() did not flip to true after SetPaused(true)")
    os.WriteLine(os.Get_stdout(), "step4_paused_ok")

    # 5. Paused StreamLoop must no-op: distinct rc, zero new sink deliveries, cursor frozen.
    let pausedLoopRc: int32 = media_bridge.WebSceneMediaEsStreamLoop()
    if pausedLoopRc != 8:
        return fail(strutil.Join(["paused StreamLoop rc=", IntToStr(pausedLoopRc), " want=8"], ""))
    if chengTestEsSinkCaptured() != 1:
        return fail(strutil.Join(["paused StreamLoop changed sink captured to ",
                                   IntToStr(chengTestEsSinkCaptured()), " want=1 (unchanged — no dial/fetch)"], ""))
    if media_bridge.WebSceneMediaEsPumpCursor() != cursorBeforePause:
        return fail(strutil.Join(["paused StreamLoop moved cursor: got=", IntToStr(media_bridge.WebSceneMediaEsPumpCursor()),
                                   " want=", IntToStr(cursorBeforePause)], ""))
    os.WriteLine(os.Get_stdout(), "step5_paused_stream_loop_noop_ok")

    # 6. Paused PrefetchTick must no-op: distinct rc, target GOP still an independent miss.
    let pausedPrefetchRc: int32 = media_bridge.WebSceneMediaEsPrefetchTick(8)
    if pausedPrefetchRc != 4:
        return fail(strutil.Join(["paused PrefetchTick rc=", IntToStr(pausedPrefetchRc), " want=4"], ""))
    let missDuringPause = blockcache.WebSceneMediaBlockCacheGet(assetCid, targetGop)
    if IsOk(missDuringPause):
        return fail(strutil.Join(["paused PrefetchTick wrote cache for GOP ", IntToStr(targetGop),
                                   " — should have been a no-op"], ""))
    os.WriteLine(os.Get_stdout(), "step6_paused_prefetch_tick_noop_ok")

    # 7. Unpause.
    media_bridge.WebSceneMediaEsSetPaused(false)
    if media_bridge.WebSceneMediaEsPaused():
        return fail("WebSceneMediaEsPaused() did not flip to false after SetPaused(false)")
    os.WriteLine(os.Get_stdout(), "step7_unpaused_ok")

    # 8. Unpaused StreamLoop resumes: real tick, sink captures again, no redial.
    let resumeLoopRc: int32 = media_bridge.WebSceneMediaEsStreamLoop()
    if resumeLoopRc != 0:
        return fail(strutil.Join(["resume StreamLoop unexpected rc=", IntToStr(resumeLoopRc)], ""))
    if chengTestEsSinkCaptured() != 2:
        return fail(strutil.Join(["resume StreamLoop sink captured=", IntToStr(chengTestEsSinkCaptured()), " want=2"], ""))
    if media_bridge.WebSceneMediaEsDialedPort() != dialedPortBefore:
        return fail(strutil.Join(["resume redialed a different port: got=", IntToStr(media_bridge.WebSceneMediaEsDialedPort()),
                                   " want=", IntToStr(dialedPortBefore)], ""))
    os.WriteLine(os.Get_stdout(), "step8_resume_stream_loop_delivered_ok")

    # 9. Unpaused PrefetchTick actually fetches and caches — contrast with step 6.
    let resumePrefetchRc: int32 = media_bridge.WebSceneMediaEsPrefetchTick(8)
    if resumePrefetchRc != 1:
        return fail(strutil.Join(["resume PrefetchTick rc=", IntToStr(resumePrefetchRc), " want=1"], ""))
    let hitAfterResume = blockcache.WebSceneMediaBlockCacheGet(assetCid, targetGop)
    if IsErr(hitAfterResume):
        return fail(strutil.Join(["resume PrefetchTick did not cache GOP ", IntToStr(targetGop), ": ", Error(hitAfterResume)], ""))
    let gotLen: int32 = BytesLen(Value(hitAfterResume))
    if gotLen != oracleGopLen:
        return fail(strutil.Join(["GOP ", IntToStr(targetGop), " byte length mismatch: got=", IntToStr(gotLen),
                                   " oracle=", IntToStr(oracleGopLen)], ""))
    os.WriteLine(os.Get_stdout(), "step9_resume_prefetch_tick_fetched_ok")

    os.WriteLine(os.Get_stdout(), "ALL OK")
    return 0
