module cold_linkerless_nested_call

fn add(a: int32, b: int32): int32 =
    return a + b

fn sub(a: int32, b: int32): int32 =
    return a - b

fn mul(a: int32, b: int32): int32 =
    return a * b

fn compute(a: int32, b: int32, c: int32, d: int32): int32 =
    let s1 = add(a, b)
    let s2 = sub(c, d)
    return mul(s1, s2)

fn deep1(x: int32): int32 =
    return deep2(x + 1)

fn deep2(x: int32): int32 =
    return deep3(x * 2)

fn deep3(x: int32): int32 =
    return x + 10

fn identity(x: int32): int32 =
    return identityInner(x)

fn identityInner(x: int32): int32 =
    return x

fn test_basic(): int32 =
    let r = compute(10, 5, 20, 8)
    if r != 180:
        return 1
    return 0

fn test_deep(): int32 =
    let r = deep1(5)
    if r != 22:
        return 1
    return 0

fn test_identity(): int32 =
    let r = identity(42)
    if r != 42:
        return 1
    return 0

fn test_multi_arg(): int32 =
    let r = compute(1, 2, 10, 3)
    if r != 21:
        return 1
    return 0

fn main(): int32 =
    let r1 = test_basic()
    if r1 != 0:
        return r1
    let r2 = test_deep()
    if r2 != 0:
        return 10 + r2
    let r3 = test_identity()
    if r3 != 0:
        return 20 + r3
    let r4 = test_multi_arg()
    if r4 != 0:
        return 30 + r4
    return 0

main()
