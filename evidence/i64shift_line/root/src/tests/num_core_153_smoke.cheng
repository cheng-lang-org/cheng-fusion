import std/result
import std/strings
import std/strutils as strutil
import cheng/inference/kernel as infer
import cheng/inference/kernel_ir as kir
import cheng/inference/model_executor as mexec
import cheng/inference/paged_kv_cache as pkv

fn mk(shape: int32[], scale: int32, data: int32[]): infer.TensorQ =
    var out: infer.TensorQ
    let r = infer.TensorFromDataFill(out, shape, scale, data)
    assert(IsOk(r), " num153: mk")
    return out

fn main(): int32 =
    let scale: int32 = 1000

    # --- step 0: InferenceIntSqrt (Newton integer sqrt) ---
    assert(infer.InferenceIntSqrt(int64(64)) == int64(8), " num153: isqrt(64)==8")
    assert(infer.InferenceIntSqrt(int64(12500000)) == int64(3535), " num153: isqrt(12500000)==3535")
    assert(infer.InferenceIntSqrt(int64(0)) == int64(0), " num153: isqrt(0)==0")
    assert(infer.InferenceIntSqrt(int64(1)) == int64(1), " num153: isqrt(1)==1")

    # --- step 1: RmsNorm sqrt (both sites), input=[3.0,4.0] weight=[1,1] eps=0 ---
    # true rms=sqrt((9+16)/2)=3.5355 -> [3/3.5355, 4/3.5355]=[848,1131] (was [240,320])
    var kirOut: infer.TensorQ
    assert(IsOk(kir.KernelIrRmsNormCpuFill(kirOut, mk([2], scale, [3000, 4000]), mk([2], scale, [1000, 1000]), 0)),
           " num153: kir rmsnorm ok")
    assert(kirOut.data[0] == 848 && kirOut.data[1] == 1131, " num153: kir rmsnorm value [848,1131]")
    var mexOut: infer.TensorQ
    assert(IsOk(mexec.ModelExecutorRmsNormRowsFill(mexOut, mk([1, 2], scale, [3000, 4000]), mk([2], scale, [1000, 1000]), 0)),
           " num153: mexec rmsnorm ok")
    assert(mexOut.data[0] == 848 && mexOut.data[1] == 1131, " num153: mexec rmsnorm value [848,1131]")

    # --- step 2: per-head scaled-dot-product softmax paged attention ---
    # keys [1,0]/[0,1]/[1,1] values [10,0]/[0,20]/[30,40] query [1,1], headDim=2
    # -> softmax(1/sqrt2 * dot) weighted values = [18,25] (was hardmax [30,40])
    let cacheRes = pkv.PagedKVInit(2, 2, 2, 1000, 1000)
    assert(IsOk(cacheRes), " num153: pkv init")
    var cache = Value(cacheRes)
    var seq = pkv.PagedKVSequenceInit(7)
    assert(IsOk(pkv.PagedKVAppendToken(cache, seq, mk([2], scale, [1000, 0]), mk([2], scale, [10, 0]))), " num153: append0")
    assert(IsOk(pkv.PagedKVAppendToken(cache, seq, mk([2], scale, [0, 1000]), mk([2], scale, [0, 20]))), " num153: append1")
    assert(IsOk(pkv.PagedKVAppendToken(cache, seq, mk([2], scale, [1000, 1000]), mk([2], scale, [30, 40]))), " num153: append2")
    var attnOut: infer.TensorQ
    assert(IsOk(pkv.PagedKVAttentionQueryFill(attnOut, cache, seq, mk([2], scale, [1000, 1000]), cache.keyDim, 1)),
           " num153: paged attention ok")
    assert(attnOut.data[0] == 18 && attnOut.data[1] == 25, " num153: paged softmax attention [18,25]")

    # --- step 4: matmul/dense delayed division (int64 accumulate, round once) ---
    # three 0.14*0.01=0.0014 products sum to 0.0042 -> 4 (per-item rounding gave 3)
    var mmOut: infer.TensorQ
    assert(IsOk(infer.MatMul2dFill(mmOut, mk([1, 3], scale, [140, 140, 140]), mk([3, 1], scale, [10, 10, 10]))),
           " num153: matmul ok")
    assert(mmOut.data[0] == 4, " num153: matmul delayed-div ==4")
    var dnOut: infer.TensorQ
    assert(IsOk(infer.DenseFill(dnOut, mk([1, 3], scale, [140, 140, 140]), mk([1, 3], scale, [10, 10, 10]), mk([1], scale, [5]))),
           " num153: dense ok")
    assert(dnOut.data[0] == 9, " num153: dense delayed-div + bias seed ==9")

    echo(" num_core_153_smoke ok")
    return 0
