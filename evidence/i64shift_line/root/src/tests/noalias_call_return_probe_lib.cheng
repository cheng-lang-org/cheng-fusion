type
    ProbeBox =
        value: int32
    ProbeStats =
        applied: bool
        count: int32
    ProbeReport =
        box: ProbeBox
        stats: ProbeStats

fn ProbeVoidNoArg() =
    return

fn ProbeTouchBox(box: var ProbeBox) =
    box.value = 7
    return

fn ProbeTouchTwo(box: var ProbeBox,
                 stats: var ProbeStats) =
    box.value = 7
    stats.applied = true
    stats.count = 3
    return

fn ProbeMakeReport(box: ProbeBox): ProbeReport =
    var report: ProbeReport
    report.box = box
    report.stats.applied = true
    report.stats.count = 3
    return report
