import cheng/core/runtime/web_scene_computer_use as cu

fn main(): int32 =
    var err: str
    if cu.WebSceneComputerUseAdmit(
           "Click", "external-publish", false, err):
        return 1
    if err != cu.WebSceneComputerUseErrConfirmationRequired:
        return 2
    if !cu.WebSceneComputerUseAdmit(
           "Click", "external-publish", true, err):
        return 3
    if !cu.WebSceneComputerUseAdmit("Click", "search", false, err):
        return 4
    if cu.WebSceneComputerUseAdmit("Screenshot", "search", true, err):
        return 5
    if err != cu.WebSceneComputerUseErrActionKind:
        return 6
    if !cu.WebSceneComputerUseRequiresConfirmation("payment"):
        return 7
    if cu.WebSceneComputerUseRequiresConfirmation("search"):
        return 8
    if !cu.WebSceneComputerUseAdmit("SetText", "filter", false, err):
        return 9
    if !cu.WebSceneComputerUseAdmit("Select", "filter", false, err):
        return 10
    return 0
