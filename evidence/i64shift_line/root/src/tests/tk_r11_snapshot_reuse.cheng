type
    R11Snapshot =
        path: str
        sha256: str
        device: str
        inode: str

    R11Task =
        kind: str
        modulePath: str
        snapshot: R11Snapshot

fn R11ReadSnapshot(path: str, out: var R11Snapshot): bool =
    out.sha256 = Fmt"sha-{path}"
    out.path = path
    out.device = "16777232"
    out.inode = "4242"
    return true

fn R11Build(moduleCount: int32, tasks: var R11Task[]): bool =
    tasks = []
    var compilerSnapshot: R11Snapshot
    if !R11ReadSnapshot("compiler.bin", compilerSnapshot):
        return false
    for i in 0..<moduleCount:
        var task: R11Task
        task.kind = "source"
        task.modulePath = Fmt"mod_{i}"
        task.snapshot = compilerSnapshot
        add(tasks, task)
    var generatedTask: R11Task
    generatedTask.kind = "darwin_syscall"
    generatedTask.modulePath = "darwin_syscall_provider"
    generatedTask.snapshot = compilerSnapshot
    add(tasks, generatedTask)
    return true

fn main(): int32 =
    var tasks: R11Task[]
    if !R11Build(2, tasks):
        return 10
    if tasks.len != 3:
        return 11
    if tasks[0].snapshot.sha256 != "sha-compiler.bin":
        return 12
    if tasks[1].snapshot.path != "compiler.bin":
        return 13
    if tasks[2].snapshot.sha256 != "sha-compiler.bin":
        return 14
    if tasks[2].snapshot.inode != "4242":
        return 15
    echo(Fmt"r11_snapshot ok n={tasks.len} a={tasks[0].snapshot.sha256} b={tasks[1].snapshot.path} g={tasks[2].snapshot.sha256}/{tasks[2].snapshot.inode}")
    return 0
