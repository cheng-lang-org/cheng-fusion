    let glyphCount = hostGlyphBatch.len / scene.WebSceneGlyphSdfGlyphHostStrideI32
    let runCount = hostRunBatch.len / scene.WebSceneGlyphSdfRunHostStrideI32
    let runGlyphCount = hostRunGlyphBatch.len / scene.WebSceneGlyphSdfRunGlyphHostStrideI32
    if glyphCount <= 0 || runCount <= 0 || runGlyphCount <= 0:
