fn __csg_scene_ensure_route_runtime_ready(routeIndex: int32): bool =
    if routeIndex < 0 || routeIndex >= 46:
        return false
    while __csgSceneRouteRuntimeReady.len < 46:
        add(__csgSceneRouteRuntimeReady, 0)
    while __csgSceneRouteRuntimeStateVersions.len < 46:
        add(__csgSceneRouteRuntimeStateVersions, -1)
    let currentStateVersion = scene.WebSceneRouteStateVersion(__csgSceneGraph, routeIndex)
    if __csgSceneRouteRuntimeReady[routeIndex] != 0 && __csgSceneRouteRuntimeStateVersions[routeIndex] == currentStateVersion:
        return true
    __csgSceneBuildStep = 75000 + routeIndex
    let viewportWidth = __csg_scene_viewport_width()
    let viewportHeight = __csg_scene_viewport_height()
    if !scene.WebSceneApplyRouteLayoutToPaintOps(__csgSceneGraph, routeIndex, viewportWidth, viewportHeight):
        return false
    # rebuilt paintOps make every cached command span for this route stale;
    # invalidation lives HERE, fused to the rebuild, not in distant callers
    if !scene.WebSceneInvalidateLayerCachesForRoute(__csgSceneGraph, routeIndex):
        return false
    __csgSceneBuildStep = 76000 + routeIndex
    if !scene.WebSceneApplyCssVariantRulesToPaintOps(__csgSceneGraph, routeIndex):
        return false
    if scene.WebSceneGlyphAtlasRunCount(__csgSceneGlyphAtlas) > 0:
        __csgSceneBuildStep = 77000 + routeIndex
        if !scene.WebSceneGlyphAtlasHydratePrecomputedGlyphMetadataForRoute(__csgSceneGraph, __csgSceneGlyphAtlas, routeIndex):
            return false
    if scene.WebSceneGlyphAtlasGlyphCount(__csgSceneGlyphAtlas) > 0:
        __csgSceneBuildStep = 78000 + routeIndex
        if !scene.WebSceneRefreshStateTextGlyphRunsForRoute(__csgSceneGraph, __csgSceneGlyphAtlas, routeIndex):
            return false
        __csgSceneGlyphSdfAtlasUploaded = false
    __csgSceneBuildStep = 79000 + routeIndex
    __csgSceneRouteRuntimeReady[routeIndex] = 1
    __csgSceneRouteRuntimeStateVersions[routeIndex] = scene.WebSceneRouteStateVersion(__csgSceneGraph, routeIndex)
    # facts-driven relayout stomps runtime paint projections (M2 titles,
    # typed input values); raise the flag so the next sync tick replays them
    __csgSceneRuntimeRebuiltRoutePlusOne = routeIndex + 1
    return true

