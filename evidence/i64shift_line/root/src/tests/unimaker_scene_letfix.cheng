@exportc("cheng_app_debug_publish_content_location_close_probe")
fn cheng_app_debug_publish_content_location_close_probe(): int32 =
    if !__csg_scene_build():
        return -1
    let publishRoute = scene.WebSceneFindRouteIndex(__csgSceneGraph, "publish_content")
    let selectorRoute = scene.WebSceneFindRouteIndex(__csgSceneGraph, "publish_selector")
    if publishRoute < 0 || selectorRoute < 0:
        return -2
    if !scene.WebSceneSetActiveRouteByIndex(__csgSceneGraph, publishRoute):
        return -3
    if !__csg_scene_ensure_route_runtime_ready(publishRoute):
        return -4
    __csg_scene_apply_route_enter_effects(publishRoute)
    if scene.WebSceneStateValueForRef(__csgSceneGraph, "locationMessage").len <= 0:
        return -5
    if !__csg_scene_ensure_route_runtime_ready(publishRoute):
        return -6
    var chosenEdge: int32
    var chosenCenterY: int32
    chosenEdge = -1
    chosenCenterY = 2147483647
    var edgeIndex: int32
    while edgeIndex < __csgSceneRouteEdgeNodeIds.len:
        if __csgSceneRouteEdgeSourceRouteIndexes[edgeIndex] == publishRoute && __csgSceneRouteEdgeTargetRouteIndexes[edgeIndex] == selectorRoute:
            let centerY = cheng_app_debug_route_edge_hit_center_y(edgeIndex)
            if centerY >= 0 && centerY < chosenCenterY:
                chosenCenterY = centerY
                chosenEdge = edgeIndex
        edgeIndex = edgeIndex + 1
    if chosenEdge < 0:
        return -7
    let hitNode = cheng_app_debug_route_edge_hit_node(chosenEdge)
    if hitNode <= 0:
        return -8
    let hitTarget = scene.WebSceneFindRouteTargetForNode(__csgSceneGraph, publishRoute, hitNode)
    if hitTarget != selectorRoute:
        return -9
    let applyStatus = __csg_scene_apply_route_to_node(hitNode)
    if applyStatus <= 0:
        if __csgSceneLastRouteApplyStatus < 0:
            return __csgSceneLastRouteApplyStatus
        return -100
    if scene.WebSceneActiveRouteIndex(__csgSceneGraph) != selectorRoute:
        return -15
    return 1

