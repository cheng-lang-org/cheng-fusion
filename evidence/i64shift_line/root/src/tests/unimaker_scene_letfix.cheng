    if fromRoute == 34:
        backTarget = 35
    if fromRoute == 35:
        backTarget = 0
    if fromRoute == 36:
        backTarget = 0
    if fromRoute == 37:
        backTarget = 0
    if fromRoute == 38:
        backTarget = 0
    if fromRoute == 39:
        backTarget = 20
    if fromRoute == 40:
        backTarget = 20
    if fromRoute == 41:
        backTarget = 20
    if fromRoute == 42:
        backTarget = 35
    if fromRoute == 43:
        backTarget = 35
    if fromRoute == 44:
        backTarget = 35
    if fromRoute == 45:
        backTarget = 35
    if fromRoute == 26 && scene.WebSceneStrStartsWith(scene.WebSceneStateValueForRef(__csgSceneGraph, "chatId"), "group:"):
        backTarget = 37
    if backTarget < 0 || backTarget == fromRoute:
        return 0
    # Home overlays (search/sort/sidebar/channel) share the home nodes and
    # are driven by a toggle state, not a separate scene graph. Reset that
    # toggle so re-tapping the icon toggles the right way and the logical
    # state matches the (prewarmed, overlay-free) home_default paint the
    # direct cut below presents. The target route was prewarmed with the
    # overlay off, so a plain index change + cache invalidation shows clean
    # home WITHOUT a ready=[] full reset (that traps in ensure on device).
    if fromRoute == 11:
        if !scene.WebSceneSetStateValue(__csgSceneGraph, "showSearch", ""):
            return 0
    if fromRoute == 12:
        if !scene.WebSceneSetStateValue(__csgSceneGraph, "showSortMenu", ""):
            return 0
    if fromRoute == 13:
        if !scene.WebSceneSetStateValue(__csgSceneGraph, "sidebarOpen", ""):
            return 0
    if fromRoute == 14:
        if !scene.WebSceneSetStateValue(__csgSceneGraph, "showTabSettings", ""):
            return 0
    scene.WebSceneClearDirty(__csgSceneGraph)
    if !scene.WebSceneSetActiveRouteByIndex(__csgSceneGraph, backTarget):
        return 0
    # direct cut, not a from->to transition frame: when needs_frame settles
    # mid-animation the transition sticks and composites both routes' layers
    # (back from a detail showed home + stale fragments). ensure rebuilds the
    # target paintOps if it was not prewarmed; invalidating its compositor
    # caches forces a clean re-render from the correct paintOps next present.
    if !__csg_scene_ensure_route_runtime_ready(backTarget):
        return 0
    if !scene.WebSceneInvalidateLayerCachesForRoute(__csgSceneGraph, backTarget):
        return 0
    __csgSceneHasPendingTransitionFrame = false
    __csgSceneHasPendingDirtyFrame = false
    __csgSceneRendered = false
    return 1

