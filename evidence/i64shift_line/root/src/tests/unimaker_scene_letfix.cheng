fn __m2FindContentIndexById(items: DistributedContent[], id: str): int32 =
    if id.len == 0:
        return -1
    for i in 0..<items.len:
        if items[i].id == id:
            return i
    return -1


@borrows
fn __m2DedupeContentsById(items: DistributedContent[]): DistributedContent[] =
    var out: DistributedContent[]
    var i = 0
    while i < items.len:
        let item = items[i]
        let existingIndex = __m2FindContentIndexById(out, item.id)
        if existingIndex < 0:
            add(out, share(item))
        elif item.timestamp > out[existingIndex].timestamp:
            out[existingIndex] = item
        i = i + 1
    return out


@borrows
fn __m2MergeDistributedContents(rawNext: DistributedContent[]): bool =
    let next = __m2DedupeContentsById(rawNext)
    if next.len <= 0:
        __m2DebugContentsLen = __m2Contents.len
        return false
    var rebuilt: DistributedContent[]
    var changed = false
    var i = 0
    while i < next.len:
        let incoming = next[i]
        let existingIndex = __m2FindContentIndexById(__m2Contents, incoming.id)
        if existingIndex >= 0 || incoming.tombstoned:
            changed = true
        if !incoming.tombstoned:
            add(rebuilt, share(incoming))
        i = i + 1
    i = 0
    while i < __m2Contents.len:
        let existing = __m2Contents[i]
        if __m2FindContentIndexById(next, existing.id) < 0:
            add(rebuilt, share(existing))
        i = i + 1
    if rebuilt.len != __m2Contents.len:
        changed = true
    if rebuilt.len > 0:
        if __m2Contents.len <= 0 || rebuilt[0].id != __m2Contents[0].id:
            changed = true
    __m2Contents = rebuilt
    __m2DebugContentsLen = __m2Contents.len
    return changed


@borrows
fn __m2ApplyDistributedContentsJson(raw: str): bool =
    let parsed = json.ParseJsonSafe(raw)
    if !parsed.success:
        return false
    __m2EnsureContents()
    let itemsNode = __m2DistributedContentItemsNode(parsed.value)
    if itemsNode.kind != json.JArray:
        return false
    var next: DistributedContent[]
    var maxTimestamp = int64(0)
    var i = 0
    while i < itemsNode.a.len:
        var c: DistributedContent
        if !__m2DistributedContentFromJson(itemsNode.a[i], c):
            return false
        if c.timestamp > maxTimestamp:
            maxTimestamp = c.timestamp
        add(next, c)
        i = i + 1
    let changed = __m2MergeDistributedContents(next)
    __m2Ready = true
    if !changed:
        return true
    if maxTimestamp > int64(0):
        __m2NowMs = maxTimestamp + int64(3600000)
        jsSetNowMs(__m2NowMs)
    __m2TitlesPrimed = false
    __m2HasSelectedContent = false
    __m2LastDetailSig = ""
    __home_dirty = true
    return true


