                    return false
                if !scene.WebSceneUpdateLocalMediaPlaybackSlot(__csgSceneGraph, "unimaker.truth.video.slot.15.4452", mediaSource, mediaMime, mediaKind):
                    return false
                __csgSceneMediaUploadDone = false
            if !scene.WebSceneSetNodePropValue(__csgSceneGraph, 15, 4451, "src", mediaSource):
                return false
            if !scene.WebSceneSetNodePropValue(__csgSceneGraph, 15, 4452, "src", mediaSource):
                return false
    __m2LastDetailSig = detailSig
    __csgSceneGlyphSdfAtlasUploaded = false
    __csgSceneRendered = false
    return true


