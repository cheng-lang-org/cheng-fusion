fn __csg_scene_asset_read_i32(data: rawbytes.Bytes, cursor: var int32, out: var int32): bool =
    let offset: int32 = cursor
    if offset < 0 || offset + 4 > rawbytes.BytesLen(data):
        return false
    let b0 = rawbytes.BytesGet(data, offset) & 255
    let b1 = rawbytes.BytesGet(data, offset + 1) & 255
    let b2 = rawbytes.BytesGet(data, offset + 2) & 255
    let b3 = rawbytes.BytesGet(data, offset + 3) & 255
    out = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
    cursor = offset + 4
    return true

fn __csg_scene_asset_read_i64(data: rawbytes.Bytes, cursor: var int32, out: var int64): bool =
    let offset: int32 = cursor
    if offset < 0 || offset + 8 > rawbytes.BytesLen(data):
        return false
    var value: int64
    value = int64(rawbytes.BytesGet(data, offset) & 255)
    value = value + (int64(rawbytes.BytesGet(data, offset + 1) & 255) << 8)
    value = value + (int64(rawbytes.BytesGet(data, offset + 2) & 255) << 16)
    value = value + (int64(rawbytes.BytesGet(data, offset + 3) & 255) << 24)
    value = value + (int64(rawbytes.BytesGet(data, offset + 4) & 255) << 32)
    value = value + (int64(rawbytes.BytesGet(data, offset + 5) & 255) << 40)
    value = value + (int64(rawbytes.BytesGet(data, offset + 6) & 255) << 48)
    value = value + (int64(rawbytes.BytesGet(data, offset + 7) & 255) << 56)
    out = value
    cursor = offset + 8
    return true

fn __csg_scene_asset_read_string(data: rawbytes.Bytes, cursor: var int32, out: var str): bool =
    let offset: int32 = cursor
    if offset < 0 || offset + 4 > rawbytes.BytesLen(data):
        return false
    let b0 = rawbytes.BytesGet(data, offset) & 255
    let b1 = rawbytes.BytesGet(data, offset + 1) & 255
    let b2 = rawbytes.BytesGet(data, offset + 2) & 255
    let b3 = rawbytes.BytesGet(data, offset + 3) & 255
    let byteCount = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
    let stringOffset = offset + 4
    if byteCount < 0 || stringOffset + byteCount > rawbytes.BytesLen(data):
        return false
    let view = rawbytes.BytesSliceView(data, stringOffset, byteCount)
    out = rawbytes.BytesToString(view)
    cursor = stringOffset + byteCount
    return true

fn __csg_scene_asset_read_header_value(data: rawbytes.Bytes, cursor: var int32, expected: int32): bool =
    var actual: int32
    if !__csg_scene_asset_read_i32(data, cursor, actual):
        return false
    return actual == expected

fn __csg_scene_asset_tuple_after(routeIndex: int32, nodeId: int32, ordinal: int32, previousRouteIndex: int32, previousNodeId: int32, previousOrdinal: int32): bool =
    if previousRouteIndex < 0:
        return true
    if routeIndex > previousRouteIndex:
        return true
    if routeIndex < previousRouteIndex:
        return false
    if nodeId > previousNodeId:
        return true
    if nodeId < previousNodeId:
        return false
    return ordinal > previousOrdinal

fn __csg_scene_asset_loaded_node_exists(routeIndex: int32, nodeId: int32, nodeCursor: var int32): bool =
    if routeIndex < 0 || nodeId <= 0 || nodeCursor < 0:
        return false
    let nodeCount = scene.WebSceneNodeCount(__csgSceneGraph)
    while nodeCursor < nodeCount:
        let currentRouteIndex = scene.WebSceneNodeRouteIndexAt(__csgSceneGraph, nodeCursor)
        let currentNodeId = scene.WebSceneNodeIdAt(__csgSceneGraph, nodeCursor)
        if currentRouteIndex == routeIndex && currentNodeId == nodeId:
            return true
        if currentRouteIndex > routeIndex:
            return false
        if currentRouteIndex == routeIndex && currentNodeId > nodeId:
            return false
        nodeCursor = nodeCursor + 1
    return false

fn __csg_scene_asset_loaded_svg_paint_exists(routeIndex: int32, nodeId: int32, ordinal: int32, paintCursor: var int32): bool =
    if routeIndex < 0 || nodeId <= 0 || ordinal < 0 || paintCursor < 0:
        return false
    let paintCount = scene.WebScenePaintCount(__csgSceneGraph)
    while paintCursor < paintCount:
        let currentRouteIndex = scene.WebScenePaintRouteIndexAt(__csgSceneGraph, paintCursor)
        let currentNodeId = scene.WebScenePaintNodeIdAt(__csgSceneGraph, paintCursor)
        let currentOrdinal = scene.WebScenePaintOrdinalAt(__csgSceneGraph, paintCursor)
        if currentRouteIndex == routeIndex && currentNodeId == nodeId && currentOrdinal == ordinal:
            return scene.WebScenePaintKindAt(__csgSceneGraph, paintCursor) == scene.WebScenePaintSvgIcon
        if currentRouteIndex > routeIndex:
            return false
        if currentRouteIndex == routeIndex && currentNodeId > nodeId:
            return false
        if currentRouteIndex == routeIndex && currentNodeId == nodeId && currentOrdinal > ordinal:
            return false
        paintCursor = paintCursor + 1
    return false

