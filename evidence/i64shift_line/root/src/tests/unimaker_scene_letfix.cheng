    var m0 = ""
    if idx0 >= 0:
        m0 = __m2ContentMediaSource(shown[idx0].media, shown[idx0].mediaItems, shown[idx0].coverMedia)
    if idx0 >= 0:
        __m2DebugTitleLen = t0.len
        __m2DebugMediaLen = m0.len
        __m2DebugMediaKind = __m2ContentMediaKind(shown[idx0].f_type)
        if __m2IsLocalMediaSource(m0):
            __m2DebugMediaIsLocal = 1
    __m2RebindChanged = false
    if !__m2TitlesPrimed:
        __m2RebindChanged = true
    if t0 != __m2LastTitle0:
        __m2RebindChanged = true
    if l0 != __m2LastLocation0:
        __m2RebindChanged = true
    if an0 != __m2LastAuthorName0:
        __m2RebindChanged = true
    if m0 != __m2LastMedia0:
        __m2RebindChanged = true
    if __m2RebindChanged:
        __m2DebugRebindChanged = 1
    if !__m2RebindChanged:
        # identical to what is already on screen: no paint, no glyph
        # re-append, and crucially no rendered=false (no churned frame)
        return true
    if !scene.WebSceneApplyTextControlPaintValue(__csgSceneGraph, 0, 111, t0):
        return false
    if !scene.WebSceneRefreshTextInputGlyphRun(__csgSceneGraph, __csgSceneGlyphAtlas, 0, 111):
