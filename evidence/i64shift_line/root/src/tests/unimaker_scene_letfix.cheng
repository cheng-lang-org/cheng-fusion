@borrows
fn __csg_scene_debug_state_condition_real_witness(routeIndex: int32, conditionRef: str, conditionExpected: str): str =
    if conditionRef.len == 0:
        return scene.WebSceneStateConditionWitnessValue(conditionExpected)
    let needle = strings.ConcatStr("set:", strings.ConcatStr(conditionRef, "="))
    var handlerIndex = 0
    let handlerCount = scene.WebSceneEventHandlerCount(__csgSceneGraph)
    while handlerIndex < handlerCount:
        let handlerNodeId = scene.WebSceneEventHandlerNodeAt(__csgSceneGraph, handlerIndex)
        if scene.WebSceneNodeBelongsToRoute(__csgSceneGraph, routeIndex, handlerNodeId):
            let effect = scene.WebSceneEventHandlerEffectAt(__csgSceneGraph, handlerIndex)
            var segStart = 0
            while segStart <= effect.len:
                var segStop = segStart
                while segStop < effect.len && effect[segStop] != ';':
                    segStop = segStop + 1
                let segment = strings.SliceBytes(effect, segStart, segStop - segStart)
                if scene.WebSceneStrStartsWith(segment, needle):
                    let value = strings.SliceBytes(segment, needle.len, segment.len - needle.len)
                    if value.len > 0 && value != "true" && value != "false" && value != "null" && value != "undefined":
                        return strFromBytesCopy(StrDataPtr(value), len(value))
                if segStop >= effect.len:
                    segStart = effect.len + 1
                else:
                    segStart = segStop + 1
        handlerIndex = handlerIndex + 1
    return scene.WebSceneStateConditionWitnessValue(conditionExpected)

fn __csg_scene_debug_prepare_route_edge(edgeIndex: int32): int32 =
    if !__csg_scene_build():
        return -1
    if edgeIndex < 0 || edgeIndex >= __csgSceneRouteEdgeNodeIds.len:
        return -2
    let source = __csgSceneRouteEdgeSourceRouteIndexes[edgeIndex]
    let nodeId = __csgSceneRouteEdgeNodeIds[edgeIndex]
    if !scene.WebSceneSetActiveRouteByIndex(__csgSceneGraph, source):
        return -3
    if !scene.WebSceneNodeBelongsToRoute(__csgSceneGraph, source, nodeId):
        return -411
    var stateGuard: int32
    while scene.WebSceneNodeHiddenByStateCondition(__csgSceneGraph, source, nodeId):
        if stateGuard >= 16:
            return -4124
        let conditionNode = scene.WebSceneFindUnsatisfiedStateConditionNode(__csgSceneGraph, source, nodeId)
        if conditionNode <= 0:
            return -4121
        let conditionRef = scene.WebSceneNodeConditionalStateRefAt(__csgSceneGraph, source, conditionNode)
        let conditionExpected = scene.WebSceneNodeConditionalStateValueAt(__csgSceneGraph, source, conditionNode)
        let conditionWitness = __csg_scene_debug_state_condition_real_witness(source, conditionRef, conditionExpected)
        if conditionRef.len == 0 || conditionWitness.len == 0:
            return -4123
        if !scene.WebSceneSetStateValue(__csgSceneGraph, conditionRef, conditionWitness):
            return -4123
        stateGuard = stateGuard + 1
    if scene.WebSceneNodeHiddenByDisplayNone(__csgSceneGraph, source, nodeId):
        return -4122
    if scene.WebSceneNodeIsDisabledNativeControl(__csgSceneGraph, source, nodeId):
        return -413
    if scene.WebSceneNodeHasPointerEventsNoneState(__csgSceneGraph, source, nodeId):
        return -414
    if !scene.WebSceneNodePointerEventsEnabled(__csgSceneGraph, source, nodeId):
        return -41
    if !__csg_scene_ensure_route_runtime_ready(source):
        return -415
    return 1

@exportc("cheng_app_debug_route_edge_hit_node")
fn cheng_app_debug_route_edge_hit_node(edgeIndex: int32): int32 =
    let prepared = __csg_scene_debug_prepare_route_edge(edgeIndex)
    if prepared < 0:
