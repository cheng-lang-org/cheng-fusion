fn __csg_scene_clear_media_surface_prepare_receipts() =
    __csgSceneMediaSurfacePrepareStatuses = []
    __csgSceneMediaSurfacePrepareKinds = []
    __csgSceneMediaSurfacePrepareSurfaces = []
    __csgSceneMediaSurfacePrepareProviders = []
    __csgSceneMediaSurfacePrepareSlotHashes = []
    __csgSceneMediaSurfacePrepareAssetHashes = []
    __csgSceneMediaSurfacePrepareManifestHashes = []
    __csgSceneMediaSurfacePreparePosterHashes = []
    __csgSceneMediaSurfacePrepareWidths = []
    __csgSceneMediaSurfacePrepareHeights = []

fn __csg_scene_record_media_surface_prepare(status: int32, mediaSurfaceCommands: var scene.WebSceneMediaSurfaceCommandBuffer, index: int32, mediaSurfaceCommandCount: int32): bool =
    if index < 0 || index >= mediaSurfaceCommandCount:
        return false
    add(__csgSceneMediaSurfacePrepareStatuses, status)
    add(__csgSceneMediaSurfacePrepareKinds, scene.WebSceneMediaSurfaceKindCodeAt(mediaSurfaceCommands, index))
    add(__csgSceneMediaSurfacePrepareSurfaces, scene.WebSceneMediaSurfaceKindHostCode(scene.WebSceneMediaSurfaceSurfaceKindAt(mediaSurfaceCommands, index)))
    add(__csgSceneMediaSurfacePrepareProviders, scene.WebSceneMediaSurfaceTextureProviderHostCode(scene.WebSceneMediaSurfaceTextureProviderAt(mediaSurfaceCommands, index)))
    add(__csgSceneMediaSurfacePrepareWidths, scene.WebSceneMediaSurfaceWidthAt(mediaSurfaceCommands, index))
    add(__csgSceneMediaSurfacePrepareHeights, scene.WebSceneMediaSurfaceHeightAt(mediaSurfaceCommands, index))
    add(__csgSceneMediaSurfacePrepareSlotHashes, scene.WebSceneResourceIdHash31(scene.WebSceneMediaSurfaceSlotIdAt(mediaSurfaceCommands, index)))
    add(__csgSceneMediaSurfacePrepareAssetHashes, scene.WebSceneResourceIdHash31(scene.WebSceneMediaSurfaceAssetCidAt(mediaSurfaceCommands, index)))
    add(__csgSceneMediaSurfacePrepareManifestHashes, scene.WebSceneResourceIdHash31(scene.WebSceneMediaSurfaceManifestCidAt(mediaSurfaceCommands, index)))
    add(__csgSceneMediaSurfacePreparePosterHashes, scene.WebSceneResourceIdHash31(scene.WebSceneMediaSurfacePosterCidAt(mediaSurfaceCommands, index)))
    return true

fn __csg_scene_prepare_media_surface_textures(mediaSurfaceCommands: var scene.WebSceneMediaSurfaceCommandBuffer, mediaSurfaceCommandCount: int32, width: int32, height: int32): bool =
    var mediaSurfaceIndex: int32
    while mediaSurfaceIndex < mediaSurfaceCommandCount:
        let slotId = scene.WebSceneMediaSurfaceSlotIdAt(mediaSurfaceCommands, mediaSurfaceIndex)
        let assetCid = scene.WebSceneMediaSurfaceAssetCidAt(mediaSurfaceCommands, mediaSurfaceIndex)
        let manifestCid = scene.WebSceneMediaSurfaceManifestCidAt(mediaSurfaceCommands, mediaSurfaceIndex)
        let posterCid = scene.WebSceneMediaSurfacePosterCidAt(mediaSurfaceCommands, mediaSurfaceIndex)
        if slotId.len == 0 || assetCid.len == 0 || manifestCid.len == 0 || posterCid.len == 0:
            let ignoredInvalidReceipt = __csg_scene_record_media_surface_prepare(10, mediaSurfaceCommands, mediaSurfaceIndex, mediaSurfaceCommandCount)
            ignoredInvalidReceipt
            __csgSceneLastMediaSurfaceStatus = 10
            return false
        let slotIdRaw: cstring = strToCStringTemp(slotId)
        let assetCidRaw: cstring = strToCStringTemp(assetCid)
        let manifestCidRaw: cstring = strToCStringTemp(manifestCid)
        let posterCidRaw: cstring = strToCStringTemp(posterCid)
        let peerHost = scene.WebSceneMediaSurfacePeerHostAt(mediaSurfaceCommands, mediaSurfaceIndex)
        let peerPort = scene.WebSceneMediaSurfacePeerPortAt(mediaSurfaceCommands, mediaSurfaceIndex)
        let peerHostRaw: cstring = strToCStringTemp(peerHost)
        let kindCode = scene.WebSceneMediaSurfaceKindCodeAt(mediaSurfaceCommands, mediaSurfaceIndex)
        let surfaceKindHostCode = scene.WebSceneMediaSurfaceKindHostCode(scene.WebSceneMediaSurfaceSurfaceKindAt(mediaSurfaceCommands, mediaSurfaceIndex))
        let textureProviderHostCode = scene.WebSceneMediaSurfaceTextureProviderHostCode(scene.WebSceneMediaSurfaceTextureProviderAt(mediaSurfaceCommands, mediaSurfaceIndex))
        let playbackState = scene.WebSceneMediaSurfacePlaybackStateAt(mediaSurfaceCommands, mediaSurfaceIndex)
        if __csg_mobile_host_prepare_media_surface_texture(kindCode, surfaceKindHostCode, textureProviderHostCode, slotIdRaw, assetCidRaw, manifestCidRaw, posterCidRaw, width, height, peerHostRaw, peerPort, playbackState) != 1:
            let ignoredPrepareFailReceipt = __csg_scene_record_media_surface_prepare(10, mediaSurfaceCommands, mediaSurfaceIndex, mediaSurfaceCommandCount)
            ignoredPrepareFailReceipt
            __csgSceneLastMediaSurfaceStatus = 10
            return false
        if !__csg_scene_record_media_surface_prepare(1, mediaSurfaceCommands, mediaSurfaceIndex, mediaSurfaceCommandCount):
            __csgSceneLastMediaSurfaceStatus = 10
            return false
        mediaSurfaceIndex = mediaSurfaceIndex + 1
    return true

fn __csg_scene_prepare_route_media_surface_textures_only(routeIndex: int32, width: int32, height: int32): bool =
    var mediaSurfaceCommands: scene.WebSceneMediaSurfaceCommandBuffer
    if !scene.WebSceneBuildRouteMediaSurfaceCommands(__csgSceneGraph, routeIndex, mediaSurfaceCommands):
        __csgSceneLastMediaSurfaceStatus = 10
        return false
    let mediaSurfaceCommandCount = scene.WebSceneMediaSurfaceCommandCount(mediaSurfaceCommands)
    if mediaSurfaceCommandCount <= 0:
        return true
    if !scene.WebSceneMediaSurfaceCommandBufferAllValid(mediaSurfaceCommands):
        __csgSceneLastMediaSurfaceStatus = 10
        return false
    if !__csg_scene_prepare_media_surface_textures(mediaSurfaceCommands, mediaSurfaceCommandCount, width, height):
        return false
    return true

fn __csg_scene_clear_media_surface_overlay(width: int32, height: int32): bool =
    rawbytes.BytesFree(__csgSceneMediaSurfaceCommandBytes)
    __csgSceneLastMediaSurfaceBatchBytes = 0
    if __csg_mobile_host_present_media_surface_commands(nil, 0, scene.WebSceneMediaSurfaceHostStrideI32, width, height) != 1:
        __csgSceneLastMediaSurfaceStatus = 10
        return false
    return true

fn __csg_scene_prepare_active_route_media_surfaces(activeRoute: int32, width: int32, height: int32): bool =
    var mediaSurfaceCommands: scene.WebSceneMediaSurfaceCommandBuffer
    __csgSceneLastMediaSurfaceStatus = 0
    __csg_scene_clear_media_surface_prepare_receipts()
    if !scene.WebSceneBuildRouteMediaSurfaceCommands(__csgSceneGraph, activeRoute, mediaSurfaceCommands):
        __csgSceneLastMediaSurfaceStatus = 10
        let ignoredClearBuildFail = __csg_scene_clear_media_surface_overlay(width, height)
        ignoredClearBuildFail
        return false
    let mediaSurfaceCommandCount = scene.WebSceneMediaSurfaceCommandCount(mediaSurfaceCommands)
    __csgSceneLastMediaSurfaceCommandCount = mediaSurfaceCommandCount
    __csgSceneLastMediaSurfaceBatchStride = scene.WebSceneMediaSurfaceHostStrideI32
    if mediaSurfaceCommandCount <= 0:
        if !__csg_scene_clear_media_surface_overlay(width, height):
            return true
        return true
    let mediaSurfaceBatchBytes = mediaSurfaceCommandCount * scene.WebSceneMediaSurfaceHostStrideI32 * 4
    if !__csg_scene_ensure_media_surface_command_bytes(mediaSurfaceBatchBytes):
        __csgSceneLastMediaSurfaceStatus = 10
        let ignoredClearEnsureFail = __csg_scene_clear_media_surface_overlay(width, height)
        ignoredClearEnsureFail
        return false
    if !scene.WebSceneEncodeMediaSurfaceCommandHostBatchBytes(mediaSurfaceCommands, __csgSceneMediaSurfaceCommandBytes):
        __csgSceneLastMediaSurfaceStatus = 10
        let ignoredClearEncodeFail = __csg_scene_clear_media_surface_overlay(width, height)
        ignoredClearEncodeFail
        return false
    if !__csg_scene_prepare_media_surface_textures(mediaSurfaceCommands, mediaSurfaceCommandCount, width, height):
        let ignoredClearPrepareFail = __csg_scene_clear_media_surface_overlay(width, height)
        ignoredClearPrepareFail
        return false
    __csgSceneLastMediaSurfaceBatchBytes = mediaSurfaceBatchBytes
    # incremental upload: identical batch for the same route/viewport was
    # already presented — re-sending is pure GL waste (heat loop two)
    var mediaSig = activeRoute * 31 + width * 7 + height * 3 + mediaSurfaceCommandCount * 131
    var sigByte = 0
    while sigByte < mediaSurfaceBatchBytes:
        mediaSig = mediaSig * 31 + rawbytes.BytesGet(__csgSceneMediaSurfaceCommandBytes, sigByte)
        if mediaSig < 0:
            mediaSig = 0 - mediaSig
        sigByte = sigByte + 1
    if __csgSceneMediaUploadSig == mediaSig && __csgSceneMediaUploadDone:
        return true
    __csgSceneMediaUploadSig = mediaSig
    __csgSceneMediaUploadDone = true
    if __csg_mobile_host_present_media_surface_commands(__csgSceneMediaSurfaceCommandBytes.data, mediaSurfaceCommandCount, scene.WebSceneMediaSurfaceHostStrideI32, width, height) != 1:
        __csgSceneLastMediaSurfaceStatus = 10
        let ignoredClearPresentFail = __csg_scene_clear_media_surface_overlay(width, height)
        ignoredClearPresentFail
        return false
    return true

fn __csg_scene_present_compositor_frame(frame: var scene.WebSceneCompositorFrame, width: int32, height: int32): bool =
    let layerCount = scene.WebSceneCompositorLayerCount(frame)
    let commandCount = scene.WebSceneCompositorGpuCommandCount(frame)
    if layerCount <= 0:
        return false
    let layerBatchBytes = layerCount * scene.WebSceneCompositorHostLayerStrideI32 * 4
    if !__csg_scene_ensure_compositor_layer_bytes(layerBatchBytes):
        return false
    if !scene.WebSceneEncodeCompositorFrameLayersHostBatchBytes(frame, __csgSceneCompositorLayerBytes):
        return false
    if commandCount > 0:
        let commandBatchBytes = commandCount * scene.WebSceneGpuHostBatchStrideI32 * 4
        if !__csg_scene_ensure_gpu_command_bytes(commandBatchBytes):
            return false
        if !scene.WebSceneEncodeCompositorFrameCommandsHostBatchBytes(frame, __csgSceneGpuCommandBytes):
            return false
        __csgSceneLastGpuBatchBytes = commandBatchBytes
    else:
        rawbytes.BytesFree(__csgSceneGpuCommandBytes)
        __csgSceneLastGpuBatchBytes = 0
    if commandCount > 0:
        if !__csg_scene_upload_image_atlas():
            return false
        if !__csg_scene_upload_svg_display_list_atlas():
            return false
        if !__csg_scene_upload_glyph_sdf_atlas():
            return false
    __csgSceneLastGpuCommandCount = commandCount
    __csgSceneLastCompositorLayerCount = layerCount
    __csgSceneLastCompositorLayerBatchBytes = layerBatchBytes
    __csgSceneLastCompositorLayerBatchStride = scene.WebSceneCompositorHostLayerStrideI32
    __csg_mobile_host_present_compositor_frame(__csgSceneCompositorLayerBytes.data, layerCount, scene.WebSceneCompositorHostLayerStrideI32, __csgSceneGpuCommandBytes.data, commandCount, scene.WebSceneGpuHostBatchStrideI32, width, height)
    return true

fn __csg_scene_present_transition_frame(): bool =
    if !__csgSceneHasPendingTransitionFrame:
        return false
    let commandCount = scene.WebSceneCompositorGpuCommandCount(__csgSceneTransitionFrame)
    let layerCount = scene.WebSceneCompositorLayerCount(__csgSceneTransitionFrame)
    __csgSceneLastTransitionPresentGpuCommandCount = commandCount
    __csgSceneLastTransitionPresentLayerCount = layerCount
    let activeRoute = scene.WebSceneActiveRouteIndex(__csgSceneGraph)
    let viewportWidth = __csg_scene_viewport_width()
    let viewportHeight = __csg_scene_viewport_height()
    if !__csg_scene_prepare_active_route_media_surfaces(activeRoute, viewportWidth, viewportHeight):
        return false
    if !__csg_scene_present_compositor_frame(__csgSceneTransitionFrame, viewportWidth, viewportHeight):
        return false
    __csgSceneHasPendingTransitionFrame = false
    return true

fn __csg_scene_present_dirty_frame(): bool =
    if !__csgSceneHasPendingDirtyFrame:
        return false
    let commandCount = scene.WebSceneCompositorGpuCommandCount(__csgSceneDirtyFrame)
    let layerCount = scene.WebSceneCompositorLayerCount(__csgSceneDirtyFrame)
    __csgSceneLastDirtyPresentGpuCommandCount = commandCount
    __csgSceneLastDirtyPresentLayerCount = layerCount
    let activeRoute = scene.WebSceneActiveRouteIndex(__csgSceneGraph)
    let viewportWidth = __csg_scene_viewport_width()
    let viewportHeight = __csg_scene_viewport_height()
    if !__csg_scene_prepare_active_route_media_surfaces(activeRoute, viewportWidth, viewportHeight):
        return false
    if !__csg_scene_present_compositor_frame(__csgSceneDirtyFrame, viewportWidth, viewportHeight):
        return false
    __csgSceneHasPendingDirtyFrame = false
    scene.WebSceneClearDirty(__csgSceneGraph)
    return true

fn __csg_scene_present_active_route(): bool =
    __csgSceneBuildStep = 80000
    if !__csg_scene_build():
        return false
    let activeRoute = scene.WebSceneActiveRouteIndex(__csgSceneGraph)
    __csgSceneBuildStep = 81000 + activeRoute
    if !__csg_scene_ensure_route_runtime_ready(activeRoute):
        return false
    __csgSceneBuildStep = 82000 + activeRoute
    if !__csg_scene_prime_route_layer_caches(activeRoute):
        return false
    __csgSceneBuildStep = 83000 + activeRoute
    let viewportWidth = __csg_scene_viewport_width()
    let viewportHeight = __csg_scene_viewport_height()
    # Media surfaces are now GPU commands in the same paint order as DOM
    # content, so textures must be prepared before the compositor frame is
    # built. Missing media is a real render failure and must surface here.
    let mediaSurfacePrepared = __csg_scene_prepare_active_route_media_surfaces(activeRoute, viewportWidth, viewportHeight)
    if !mediaSurfacePrepared:
        return false
    __csgSceneMediaPrimeStage = 2
    var routeFrame: scene.WebSceneCompositorFrame
    __csgSceneBuildStep = 84000 + activeRoute
    if !scene.WebSceneBuildCompositorFrameForRouteWithFullAtlases(__csgSceneGraph, activeRoute, __csgSceneImageAtlas, __csgSceneSvgAtlas, __csgSceneGlyphAtlas, routeFrame):
        __csgSceneBuildStep = 84500 + activeRoute
        return false
    if scene.WebSceneCompositorLayerCount(routeFrame) <= 0:
        __csgSceneBuildStep = 84600 + activeRoute
        return false
    __csgSceneBuildStep = 85000 + activeRoute
    __csg_mobile_host_trace_step(975001)
    if !__csg_scene_present_compositor_frame(routeFrame, viewportWidth, viewportHeight):
        return false
    return true

fn __csg_scene_apply_route_edge_index(edgeIndex: int32): bool =
    if !__csg_scene_build():
        return false
    if edgeIndex < 0 || edgeIndex >= __csgSceneRouteEdgeNodeIds.len:
        return false
    let fromRoute = scene.WebSceneActiveRouteIndex(__csgSceneGraph)
    if !__csg_scene_ensure_route_runtime_ready(fromRoute):
        return false
    let targetRouteIndex = __csgSceneRouteEdgeTargetRouteIndexes[edgeIndex]
    if !__csg_scene_ensure_route_runtime_ready(targetRouteIndex):
        return false
    scene.WebSceneClearDirty(__csgSceneGraph)
    if !scene.WebSceneApplyRouteEdge(__csgSceneGraph, __csgSceneRouteEdgeNodeIds[edgeIndex]):
        return false
    let toRoute = scene.WebSceneActiveRouteIndex(__csgSceneGraph)
    if !__csg_scene_refresh_transition_stats(fromRoute, toRoute):
        return false
    __csgSceneLastDirtyCount = scene.WebSceneDirtyCount(__csgSceneGraph)
    __csgSceneRendered = false
    return true
    return false

fn __csg_scene_clear_transition_stats() =
    __csgSceneLastTransitionReuseCount = 0
    __csgSceneLastTransitionReplaceCount = 0
    __csgSceneLastTransitionDropCount = 0
    __csgSceneLastTransitionGpuCommandCount = 0
    __csgSceneLastTransitionPresentGpuCommandCount = 0
    __csgSceneLastTransitionPresentLayerCount = 0
    __csgSceneHasPendingTransitionFrame = false
    scene.WebSceneCompositorFrameInit(__csgSceneTransitionFrame)

@borrows
fn __csg_scene_event_hit_target_for_node(routeIndex: int32, nodeId: int32, eventName: str): bool =
    if eventName.len == 0:
        return false
    if !scene.WebSceneNodePointerEventsEnabled(__csgSceneGraph, routeIndex, nodeId):
        return false
    return scene.WebSceneFindEventHandlerForNodeEvent(__csgSceneGraph, routeIndex, nodeId, eventName) >= 0

@borrows
fn __csg_scene_event_hit_target_ancestor(routeIndex: int32, nodeId: int32, eventName: str): int32 =
    if nodeId <= 0 || eventName.len == 0:
        return -1
    var current = nodeId
    var steps: int32
    while current > 0:
        if __csg_scene_event_hit_target_for_node(routeIndex, current, eventName):
            return current
        current = scene.WebSceneFindNodeParentId(__csgSceneGraph, current)
        steps = steps + 1
        if steps > __csgSceneGraph.nodes.len:
            return -1
    return 0

fn __csg_scene_route_hit_target_ancestor(routeIndex: int32, nodeId: int32): int32 =
    if nodeId <= 0:
        return -1
    var current = nodeId
    var steps: int32
    while current > 0:
        if scene.WebSceneFindRouteTargetForNode(__csgSceneGraph, routeIndex, current) >= 0:
            return current
        current = scene.WebSceneFindNodeParentId(__csgSceneGraph, current)
        steps = steps + 1
        if steps > __csgSceneGraph.nodes.len:
            return -1
    return 0

fn __csg_scene_text_input_ancestor(routeIndex: int32, nodeId: int32): int32 =
    if nodeId <= 0:
        return -1
    var current = nodeId
    var steps: int32
    while current > 0:
        if scene.WebSceneNodeAcceptsTextInput(__csgSceneGraph, routeIndex, current):
            return current
        current = scene.WebSceneFindNodeParentId(__csgSceneGraph, current)
        steps = steps + 1
        if steps > __csgSceneGraph.nodes.len:
            return -1
    return 0

fn __csg_scene_text_input_descendant(routeIndex: int32, rootNodeId: int32): int32 =
    # Indexed short-circuit: WebSceneFindUniqueTextInputDescendant scans only
    # the route's few text-input nodes (K3 index) instead of every scene node,
    # returning the identical unique target (or 0 when none / ambiguous / root).
    return scene.WebSceneFindUniqueTextInputDescendant(__csgSceneGraph, routeIndex, rootNodeId)

fn __csg_scene_layout_box_contains_point_milli(boxIndex: int32, routeIndex: int32, xMilli: int32, yMilli: int32): bool =
    if boxIndex < 0 || boxIndex >= __csgSceneGraph.layoutBoxes.len:
        return false
    if __csgSceneGraph.layoutBoxes[boxIndex].routeIndex != routeIndex:
        return false
    if !__csgSceneGraph.layoutBoxes[boxIndex].visible:
        return false
    if __csgSceneGraph.layoutBoxes[boxIndex].width <= 0 || __csgSceneGraph.layoutBoxes[boxIndex].height <= 0:
        return false
    let left = __csgSceneGraph.layoutBoxes[boxIndex].x * 1000
    let top = __csgSceneGraph.layoutBoxes[boxIndex].y * 1000
    let right = (__csgSceneGraph.layoutBoxes[boxIndex].x + __csgSceneGraph.layoutBoxes[boxIndex].width) * 1000
    let bottom = (__csgSceneGraph.layoutBoxes[boxIndex].y + __csgSceneGraph.layoutBoxes[boxIndex].height) * 1000
    return xMilli >= left && xMilli < right && yMilli >= top && yMilli < bottom

fn __csg_scene_layout_box_accepts_pointer(routeIndex: int32, boxIndex: int32): bool =
    if boxIndex < 0 || boxIndex >= __csgSceneGraph.layoutBoxes.len:
        return false
    let nodeId = __csgSceneGraph.layoutBoxes[boxIndex].nodeId
    if !scene.WebSceneNodeBelongsToRoute(__csgSceneGraph, routeIndex, nodeId):
        return false
