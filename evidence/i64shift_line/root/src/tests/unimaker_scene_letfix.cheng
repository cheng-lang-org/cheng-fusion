fn __csg_scene_state_snapshot_json(): str =
    if !__csg_scene_build():
        return ""
    var root = json.NewJObject()
    var states = json.NewJObject()
    json.JsonSetFieldStr(root, "schema", "cheng.scene.state_snapshot.v1")
    json.JsonSetFieldStr(root, "routeState", __csg_scene_route_id_for_index(scene.WebSceneActiveRouteIndex(__csgSceneGraph)))
    var i: int32
    while i < __csg_scene_state_snapshot_ref_count():
        let stateRef = __csg_scene_state_snapshot_ref_at(i)
        if stateRef.len > 0:
            json.JsonSetFieldStr(states, __csg_cu_clone_str(stateRef), scene.WebSceneStateValueForRef(__csgSceneGraph, stateRef))
        i = i + 1
    json.JsonSetField(root, "states", states)
    return json.JsonStringify(root)

@borrows
fn __csg_scene_restore_snapshot_state(states: json.JsonNode, stateRef: str): bool =
    if states.kind != json.JObject || stateRef.len == 0:
        return false
    let valueNode = json.JsonGetField(states, stateRef)
    if valueNode.kind == json.JNull:
        return true
    var value: str
    if !json.JsonNodeTryGetStr(valueNode, value):
        return false
    return scene.WebSceneSeedStateValue(__csgSceneGraph, stateRef, value)

fn __csg_scene_restore_text_input_bindings_for_route(routeIndex: int32): bool =
    if routeIndex < 0:
        return true
    var i: int32
    while i < __csg_scene_state_snapshot_ref_count():
        let stateRef = __csg_scene_state_snapshot_ref_at(i)
        if stateRef.len > 0:
            let nodeId = scene.WebSceneFindTextInputNodeForStateRef(__csgSceneGraph, routeIndex, stateRef)
            if nodeId > 0:
                let value = scene.WebSceneStateValueForRef(__csgSceneGraph, stateRef)
                if !scene.WebSceneSetNodePropValue(__csgSceneGraph, routeIndex, nodeId, "value", value):
                    return false
                if !scene.WebSceneApplyTextControlPaintValue(__csgSceneGraph, routeIndex, nodeId, value):
                    return false
                if !scene.WebSceneRefreshTextInputGlyphRun(__csgSceneGraph, __csgSceneGlyphAtlas, routeIndex, nodeId):
                    return false
                __csgSceneGlyphSdfAtlasUploaded = false
        i = i + 1
    return true

fn __csg_scene_restore_state_snapshot_json(snapshotText: str): bool =
    if !__csg_scene_build():
        return false
    let parsed = json.ParseJsonSafe(snapshotText)
    if !parsed.success:
        return false
    var schema: str
    if !json.JsonTryGetStr(parsed.value, "schema", schema) || schema != "cheng.scene.state_snapshot.v1":
        return false
    let states = json.JsonGetField(parsed.value, "states")
    if states.kind != json.JObject:
        return false
    scene.WebSceneClearDirty(__csgSceneGraph)
    var i: int32
    while i < __csg_scene_state_snapshot_ref_count():
        if !__csg_scene_restore_snapshot_state(states, __csg_scene_state_snapshot_ref_at(i)):
            return false
        i = i + 1
    if !__csg_scene_restore_text_input_bindings_for_route(scene.WebSceneActiveRouteIndex(__csgSceneGraph)):
        return false
