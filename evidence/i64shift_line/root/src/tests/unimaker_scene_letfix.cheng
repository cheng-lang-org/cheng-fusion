        if !scene.WebSceneSetStateValue(__csgSceneGraph, "resolvedVideoSrc", mediaSource):
            return false
        if !scene.WebSceneSetStateValue(__csgSceneGraph, "resolvedHiResSrc", ""):
            return false
        if !scene.WebSceneSetStateValue(__csgSceneGraph, "hiResReady", "false"):
            return false
        if detailMediaSourceChanged:
            if !scene.WebSceneSetStateValue(__csgSceneGraph, "isVideoPlaying", "false"):
                return false
        if !scene.WebSceneSetStateValue(__csgSceneGraph, "videoLoadState", "ready"):
            return false
    else:
        if scene.WebSceneStateValueForRef(__csgSceneGraph, "resolvedVideoSrc") != "":
            detailMediaStateChanged = true
        if scene.WebSceneStateValueForRef(__csgSceneGraph, "resolvedHiResSrc") != "":
            detailMediaStateChanged = true
        if scene.WebSceneStateValueForRef(__csgSceneGraph, "hiResReady") != "false":
            detailMediaStateChanged = true
        if scene.WebSceneStateValueForRef(__csgSceneGraph, "isVideoPlaying") != "false":
            detailMediaStateChanged = true
        if scene.WebSceneStateValueForRef(__csgSceneGraph, "videoLoadState") != "idle":
            detailMediaStateChanged = true
        if !scene.WebSceneSetStateValue(__csgSceneGraph, "resolvedVideoSrc", ""):
            return false
        if !scene.WebSceneSetStateValue(__csgSceneGraph, "resolvedHiResSrc", ""):
            return false
        if !scene.WebSceneSetStateValue(__csgSceneGraph, "hiResReady", "false"):
            return false
        if !scene.WebSceneSetStateValue(__csgSceneGraph, "isVideoPlaying", "false"):
            return false
        if !scene.WebSceneSetStateValue(__csgSceneGraph, "videoLoadState", "idle"):
            return false
    if detailMediaStateChanged:
        if !__csg_scene_invalidate_route_runtime(activeRoute):
            return false
        if !__csg_scene_ensure_route_runtime_ready(activeRoute):
            return false
    if activeRoute == 15:
        if !__m2ApplyTextNode(15, 4483, title):
            return false
        if !__m2ApplyTextNode(15, 4485, body):
            return false
        if !__m2ApplyTextNode(15, 4492, location):
