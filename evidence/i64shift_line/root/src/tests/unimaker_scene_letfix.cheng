@borrows
@borrow_result
fn __csg_scene_file_picker_part(effect: str, ordinal: int32): str =
    let prefix = "file-picker:"
    if !scene.WebSceneStrStartsWith(effect, prefix):
        return ""
    let rest = strings.SliceBytes(effect, len(prefix), len(effect) - len(prefix))
    var partStart: int32
    var partOrdinal: int32
    var i: int32
    while i <= len(rest):
        if i == len(rest):
            if partOrdinal == ordinal:
                return strings.SliceBytes(rest, partStart, i - partStart)
            return ""
        if strings.SliceBytes(rest, i, 1) == ":":
            if partOrdinal == ordinal:
                return strings.SliceBytes(rest, partStart, i - partStart)
            partOrdinal = partOrdinal + 1
            partStart = i + 1
        i = i + 1
    return ""

@borrows
@borrow_result
fn __csg_scene_file_picker_ref(effect: str): str =
    return __csg_scene_file_picker_part(effect, 0)

@borrows
@borrow_result
fn __csg_scene_file_picker_kind(effect: str): str =
    return __csg_scene_file_picker_part(effect, 1)

@borrows
@borrow_result
fn __csg_scene_file_picker_result_mode(effect: str): str =
    return __csg_scene_file_picker_part(effect, 2)

@borrows
@borrow_result
fn __csg_scene_file_picker_result_state_ref(effect: str): str =
    return __csg_scene_file_picker_part(effect, 3)

