    __m2DebugFirstCategoryContent = 0
    if __m2Contents.len > 0 && __m2Contents[0].publishCategory == "content":
        __m2DebugFirstCategoryContent = 1
    let idx0 = __m2FindContentIndexById(shown, "content-1784858242603-tp9r3l")
