    if !scene.WebSceneApplyTextControlPaintValue(__csgSceneGraph, 0, 124, l0):
        return false
    if !scene.WebSceneRefreshTextInputGlyphRun(__csgSceneGraph, __csgSceneGlyphAtlas, 0, 124):
        return false
    if !scene.WebSceneApplyTextControlPaintValue(__csgSceneGraph, 0, 119, an0):
        return false
    if !scene.WebSceneRefreshTextInputGlyphRun(__csgSceneGraph, __csgSceneGlyphAtlas, 0, 119):
        return false
    if idx0 >= 0:
        let mediaKind0 = __m2ContentMediaKind(shown[idx0].f_type)
        if mediaKind0 > 0 && __m2IsLocalMediaSource(m0):
            if !scene.WebSceneUpdateLocalMediaPlaybackSlot(__csgSceneGraph, "unimaker.truth.video.slot.0.104", m0, __m2ContentMimeForKind(mediaKind0), mediaKind0):
                return false
            __csgSceneMediaUploadDone = false
    __m2LastTitle0 = t0
    __m2LastLocation0 = l0
    __m2LastAuthorName0 = an0
    __m2LastMedia0 = m0
    __m2TitlesPrimed = true
    __csgSceneGlyphSdfAtlasUploaded = false
    # rebind is incremental (paint values + glyph runs in place, caches
    # invalidated by the writer); a full refresh would rebuild from facts
    # and stomp these very titles
    __csgSceneHasPendingTransitionFrame = false
    __csgSceneHasPendingDirtyFrame = false
