fn __cht_video_slot_kind(slotIndex: int32): int32 =
    if slotIndex < 0 || slotIndex >= __csgSceneGraph.mediaPlaybackSlots.len:
        return 0
    let assetIndex = scene.WebSceneFindMediaAssetIndex(__csgSceneGraph, __csgSceneGraph.mediaPlaybackSlots[slotIndex].assetFactId)
    if assetIndex < 0 || assetIndex >= __csgSceneGraph.mediaAssets.len:
        return 0
    return __csgSceneGraph.mediaAssets[assetIndex].kindCode



fn __cht_video_slot_index(handle: int64): int32 =
    if !__csg_scene_build():
        return -1
    let activeRoute = scene.WebSceneActiveRouteIndex(__csgSceneGraph)
    if activeRoute < 0:
        return -1
    var desired = int32(handle) - 1
    if desired < 0:
        desired = 0
    var ordinal: int32
    for slotIndex in 0..<__csgSceneGraph.mediaPlaybackSlots.len:
        if __csgSceneGraph.mediaPlaybackSlots[slotIndex].routeIndex == activeRoute && __cht_video_slot_kind(slotIndex) == 1:
            if ordinal == desired:
                return slotIndex
            ordinal = ordinal + 1
    return -1



fn __cht_video_mark_media_dirty() =
    __csgSceneMediaUploadDone = false
    __csgSceneRendered = false



fn __cht_video_sync_es_pause(actionKind: str) =
    if actionKind == "Play":
        media_bridge.WebSceneMediaEsSetPaused(false)
    elif actionKind == "Pause":
        media_bridge.WebSceneMediaEsSetPaused(true)



fn __cht_video_apply_control(handle: int64, actionKind: str): bool =
    let slotIndex = __cht_video_slot_index(handle)
    if slotIndex < 0:
        return false
    let slotId = __csgSceneGraph.mediaPlaybackSlots[slotIndex].slotId
    let state = __csgSceneGraph.mediaPlaybackSlots[slotIndex].playbackState
    if scene.WebSceneApplyMediaControl(__csgSceneGraph, slotId, actionKind):
        __cht_video_mark_media_dirty()
        __cht_video_sync_es_pause(actionKind)
        return true
    if actionKind == "Play":
        if state != scene.WebSceneMediaPlaybackClosed:
            return false
        if !scene.WebSceneApplyMediaControl(__csgSceneGraph, slotId, "OpenAsset"):
            return false
        if !scene.WebSceneApplyMediaControl(__csgSceneGraph, slotId, "Play"):
            return false
        __cht_video_mark_media_dirty()
        __cht_video_sync_es_pause(actionKind)
        return true
    return false




fn chengVideoSetMuted(handle: int64, muted: bool): void =
    handle
    muted
    return



fn chengVideoPaused(handle: int64): bool =
    let slotIndex = __cht_video_slot_index(handle)
    if slotIndex < 0:
        return true
    let state = __csgSceneGraph.mediaPlaybackSlots[slotIndex].playbackState
    return !(state == scene.WebSceneMediaPlaybackPlaying || state == scene.WebSceneMediaPlaybackSeeked)



fn chengVideoPlaySlot(handle: int64): void =
