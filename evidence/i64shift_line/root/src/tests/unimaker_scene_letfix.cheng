    __m2DebugRebindApplied = 1
    return true


fn __m2ConsumeRebuiltRoute(): int32 =
    if __csgSceneRuntimeRebuiltRoutePlusOne == 0:
        return -1
    let rebuiltRoute = __csgSceneRuntimeRebuiltRoutePlusOne - 1
    __csgSceneRuntimeRebuiltRoutePlusOne = 0
    if __csgSceneFocusedTextNodeId <= 0:
        return rebuiltRoute
    if __csgSceneFocusedTextRouteIndex != rebuiltRoute:
        return rebuiltRoute
    if __csgSceneFocusedTextReplayRouteIndex != __csgSceneFocusedTextRouteIndex:
        return rebuiltRoute
    if __csgSceneFocusedTextReplayNodeId != __csgSceneFocusedTextNodeId:
        return rebuiltRoute
    # replay the typed value the facts-driven relayout stomped back
    let replayValue = __csgSceneFocusedTextReplayValue
    if !scene.WebSceneSetNodePropValue(__csgSceneGraph, __csgSceneFocusedTextRouteIndex, __csgSceneFocusedTextNodeId, "value", replayValue):
        return -1
    scene.WebSceneApplyTextControlPaintValue(__csgSceneGraph, __csgSceneFocusedTextRouteIndex, __csgSceneFocusedTextNodeId, replayValue)
    scene.WebSceneRefreshTextInputGlyphRun(__csgSceneGraph, __csgSceneGlyphAtlas, __csgSceneFocusedTextRouteIndex, __csgSceneFocusedTextNodeId)
    __csgSceneGlyphSdfAtlasUploaded = false
    return rebuiltRoute


fn __m2ObserveRouteApply() =
    if __csgSceneLastRouteApplyStatus != 1:
        return
    if __m2RouteApplyObserved && __m2LastRouteApplyNodeSeen == __csgSceneLastRouteApplyNode && __m2LastRouteApplyFromSeen == __csgSceneLastRouteApplyFrom && __m2LastRouteApplyToSeen == __csgSceneLastRouteApplyTo:
        return
    __m2RouteApplyObserved = true
    __m2LastRouteApplyNodeSeen = __csgSceneLastRouteApplyNode
    __m2LastRouteApplyFromSeen = __csgSceneLastRouteApplyFrom
    __m2LastRouteApplyToSeen = __csgSceneLastRouteApplyTo
    if __csgSceneLastRouteApplyTo == 0:
        __m2TitlesPrimed = false
        __home_dirty = true
    if __csgSceneLastRouteApplyTo == 15:
        if __csgSceneLastRouteApplyFrom == 0:
            if !__m2SelectHomeCardNode(__csgSceneLastRouteApplyNode):
                __csgSceneLastStatus = 9
                return
        __m2LastDetailSig = ""
    return


fn __m2SyncTick() =
    if !__csgSceneInitialized:
        return
    __m2NowMs = __m2NowMs + int64(16)
    jsSetNowMs(__m2NowMs)
    # rebind targets route-0 nodes; syncing from any route is safe and
    # keeps the list live under overlays (sort sheet) exactly like React
    __m2EnsureContents()
    __m2ObserveRouteApply()
    let sq = scene.WebSceneStateValueForRef(__csgSceneGraph, "searchQuery")
    if sq != __home_searchQuery:
        setSearchQuery(sq)
    let st = scene.WebSceneStateValueForRef(__csgSceneGraph, "sortType")
    if st != "" && st != __home_sortType:
        setSortType(st)
    let category = scene.WebSceneStateValueForRef(__csgSceneGraph, "activeCategory")
    if category != "" && category != __home_activeCategory:
        setActiveCategory(category)
    let distanceValue = scene.WebSceneStateValueForRef(__csgSceneGraph, "distanceValue")
    if distanceValue != "":
        let parsedDistanceValue = __csg_scene_parse_positive_int(distanceValue)
        if parsedDistanceValue >= 0 && int64(parsedDistanceValue) != __home_distanceValue:
            setDistanceValue(int64(parsedDistanceValue))
    let distanceMax = scene.WebSceneStateValueForRef(__csgSceneGraph, "distanceMax")
    if distanceMax != "":
        let parsedDistanceMax = __csg_scene_parse_positive_int(distanceMax)
        if parsedDistanceMax >= 0 && int64(parsedDistanceMax) != __home_distanceMax:
            setDistanceMax(int64(parsedDistanceMax))
    let m2RebuiltRoute = __m2ConsumeRebuiltRoute()
    let m2ForceRebind = m2RebuiltRoute == 0
    if m2ForceRebind:
        # a facts-driven rebuild stomped the card paint back to defaults;
        # drop the primed flag so the next rebind re-writes the real titles
        __m2TitlesPrimed = false
    if homeTakeDirty() || m2ForceRebind:
        if !__m2RebindHomeList():
            __csgSceneLastStatus = 9
    if m2RebuiltRoute == 15:
        __m2LastDetailSig = ""
    if !__m2RebindActiveDetail():
        __csgSceneLastStatus = 9


