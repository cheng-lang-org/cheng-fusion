fn __csg_scene_request_event_to_node(nodeId: int32): int32 =
    if nodeId <= 0:
        return 0
    if __csgScenePendingEventNode > 0 || __csgScenePendingRouteNode > 0:
        return 0
    __csgScenePendingEventNode = nodeId
    __csgSceneLastEventHitNodeId = nodeId
    __csgSceneLastEventHitStatus = 2
    __csgSceneLastEventApplyStatus = 2
    __csgSceneRendered = false
    return 1

fn __csg_scene_commit_pending_event(): int32 =
    if __csgScenePendingEventNode <= 0:
        return 0
    let nodeId = __csgScenePendingEventNode
    __csgScenePendingEventNode = 0
    return __csg_scene_apply_event_to_node(nodeId)

fn __csg_scene_apply_key_event_to_node(nodeId: int32, eventName: str, eventKey: str): int32 =
    __csgSceneLastEventHitNodeId = nodeId
