fn __cht_compiled_effect_segment(effect: str): str =
    if scene.WebSceneStrStartsWith(effect, "compiled:"):
        return effect
    if scene.WebSceneStrStartsWith(effect, "invoke:"):
        return effect
    var start = 0
    while start <= effect.len:
        var stop = start
        while stop < effect.len && effect[stop] != ';':
            stop = stop + 1
        let segment = strings.SliceBytes(effect, start, stop - start)
        if scene.WebSceneStrStartsWith(segment, "compiled:"):
            return segment
        if scene.WebSceneStrStartsWith(segment, "invoke:"):
            return segment
        if stop >= effect.len:
            return ""
        start = stop + 1
    return ""


@borrows
fn __cht_apply_checked(graph: var scene.WebSceneGraph, effect: str): int32 =
    let segment = __cht_compiled_effect_segment(effect)
    if segment.len == 0:
        return 0
    return __cht_apply(graph, segment)
