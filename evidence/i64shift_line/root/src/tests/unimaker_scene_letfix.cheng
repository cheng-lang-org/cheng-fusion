@borrows
fn __csg_scene_frame_digest_fold(seed: int64, layerWords: int32[], commandWords: int32[]): int32 =
    var h: int64 = seed
    h = scene.WebSceneHashInt64(h, layerWords.len)
    for i in 0..<layerWords.len:
        h = scene.WebSceneHashInt64(h, layerWords[i])
    h = scene.WebSceneHashInt64(h, commandWords.len)
    for i in 0..<commandWords.len:
        h = scene.WebSceneHashInt64(h, commandWords[i])
    return Int32(h)

fn __csg_scene_frame_digest_block_fold(seed: int64, routeIndex: int32): int32 =
    var h: int64 = seed
    h = scene.WebSceneHashInt64(h, routeIndex)
    h = scene.WebSceneHashInt64(h, scene.WebSceneLastCssFailCode())
    h = scene.WebSceneHashInt64(h, scene.WebSceneLastCssFailPropertyCode())
    h = scene.WebSceneHashInt64(h, scene.WebSceneLastCssFailNodeId())
    h = scene.WebSceneHashInt64(h, scene.WebSceneLastCssFailRouteIndex())
    h = scene.WebSceneHashInt64(h, scene.WebSceneLastLayoutFailCode())
    return Int32(h)

fn __csg_scene_frame_digest_record_block(routeIndex: int32) =
    __csgSceneLastFrameDigestHi = __csg_scene_frame_digest_block_fold(int64(40503), routeIndex)
    __csgSceneLastFrameDigestLo = __csg_scene_frame_digest_block_fold(int64(2654435761), routeIndex)

@exportc("cheng_app_debug_compute_frame_digest")
fn cheng_app_debug_compute_frame_digest(routeIndex: int32): int32 =
    __csgSceneLastFrameDigestHi = 0
    __csgSceneLastFrameDigestLo = 0
    __csgSceneLastFrameDigestBlockStep = 0
    if !__csg_scene_build():
        __csgSceneLastFrameDigestBlockStep = 1
        return 0
    if routeIndex < 0 || routeIndex >= scene.WebSceneRouteCount(__csgSceneGraph):
        return 0
    if !scene.WebSceneSetActiveRouteByIndex(__csgSceneGraph, routeIndex):
        return 0
    if !__csg_scene_ensure_route_runtime_ready(routeIndex):
        __csgSceneLastFrameDigestBlockStep = 2
        __csg_scene_frame_digest_record_block(routeIndex)
        return 2
    __csg_scene_apply_route_enter_effects(routeIndex)
    if !__csg_scene_prime_route_layer_caches(routeIndex):
        __csgSceneLastFrameDigestBlockStep = 3
        __csg_scene_frame_digest_record_block(routeIndex)
        return 2
    var routeFrame: scene.WebSceneCompositorFrame
    if !scene.WebSceneBuildCompositorFrameForRouteWithFullAtlases(__csgSceneGraph, routeIndex, __csgSceneImageAtlas, __csgSceneSvgAtlas, __csgSceneGlyphAtlas, routeFrame):
        __csgSceneLastFrameDigestBlockStep = 4
        __csg_scene_frame_digest_record_block(routeIndex)
        return 2
    var layerWords: int32[]
    var commandWords: int32[]
    if !scene.WebSceneEncodeCompositorFrameHostBatch(routeFrame, layerWords, commandWords):
        __csgSceneLastFrameDigestBlockStep = 5
        __csg_scene_frame_digest_record_block(routeIndex)
        return 2
    __csgSceneLastFrameDigestHi = __csg_scene_frame_digest_fold(int64(216613626), layerWords, commandWords)
    __csgSceneLastFrameDigestLo = __csg_scene_frame_digest_fold(int64(2166136261), layerWords, commandWords)
    __csgSceneLastFrameDigestBlockStep = 100
    return 1

@exportc("cheng_app_debug_frame_digest_block_step")
fn cheng_app_debug_frame_digest_block_step(): int32 =
    return __csgSceneLastFrameDigestBlockStep

