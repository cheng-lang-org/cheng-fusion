@borrows
@borrow_result
fn __csg_scene_effect_part_after_prefix(effect: str, prefix: str, ordinal: int32): str =
    if !scene.WebSceneStrStartsWith(effect, prefix):
        return ""
    let rest = strings.SliceBytes(effect, len(prefix), len(effect) - len(prefix))
    var partStart: int32
    var partOrdinal: int32
    var i: int32
    while i <= len(rest):
        if i == len(rest):
            if partOrdinal == ordinal:
                return strings.SliceBytes(rest, partStart, i - partStart)
            return ""
        if strings.SliceBytes(rest, i, 1) == ":":
            if partOrdinal == ordinal:
                return strings.SliceBytes(rest, partStart, i - partStart)
            partOrdinal = partOrdinal + 1
            partStart = i + 1
        i = i + 1
    return ""

@borrows
fn __csg_scene_str_less(left: str, right: str): bool =
    var i: int32
    while i < left.len && i < right.len:
        if left[i] < right[i]:
            return true
        if left[i] > right[i]:
            return false
        i = i + 1
    return left.len < right.len

@borrows
fn __csg_scene_str_ends_with(value: str, suffix: str): bool =
    if suffix.len > value.len:
        return false
    return strings.SliceBytes(value, value.len - suffix.len, suffix.len) == suffix

@borrows
fn __csg_scene_resolve_chat_peer_id(chatId: str): str =
    let trimmed = scene.WebSceneTrimAsciiWhitespace(chatId)
    if scene.WebSceneStrStartsWith(trimmed, "dm:"):
        return scene.WebSceneTrimAsciiWhitespace(strings.SliceBytes(trimmed, 3, trimmed.len - 3))
    if scene.WebSceneStrStartsWith(trimmed, "group:"):
        return ""
    if __csg_scene_str_ends_with(trimmed, ":group"):
        return scene.WebSceneTrimAsciiWhitespace(strings.SliceBytes(trimmed, 0, trimmed.len - 6))
    return trimmed

@borrows
fn __csg_scene_resolve_chat_group_id(chatId: str): str =
    let trimmed = scene.WebSceneTrimAsciiWhitespace(chatId)
    if scene.WebSceneStrStartsWith(trimmed, "group:"):
        return scene.WebSceneTrimAsciiWhitespace(strings.SliceBytes(trimmed, 6, trimmed.len - 6))
    if __csg_scene_str_ends_with(trimmed, ":group"):
        return scene.WebSceneTrimAsciiWhitespace(strings.SliceBytes(trimmed, 0, trimmed.len - 6))
    return trimmed

fn __csg_scene_resolve_synccast_room_id(chatIdRef: str, isGroupRef: str, localPeerIdRef: str): str =
    let chatId = scene.WebSceneStateValueForRef(__csgSceneGraph, chatIdRef)
    let isGroupRaw = scene.WebSceneStateValueForRef(__csgSceneGraph, isGroupRef)
    if isGroupRaw != "true":
        let remotePeerId = __csg_scene_resolve_chat_peer_id(chatId)
        let localPeerId = scene.WebSceneTrimAsciiWhitespace(scene.WebSceneStateValueForRef(__csgSceneGraph, localPeerIdRef))
        if remotePeerId.len == 0:
            return scene.WebSceneTrimAsciiWhitespace(chatId)
        if localPeerId.len == 0:
            return strings.ConcatStr("dm-", remotePeerId)
        if __csg_scene_str_less(localPeerId, remotePeerId):
            return strings.ConcatStr(strings.ConcatStr(strings.ConcatStr("dm-", localPeerId), "-"), remotePeerId)
        return strings.ConcatStr(strings.ConcatStr(strings.ConcatStr("dm-", remotePeerId), "-"), localPeerId)
    let gid = scene.WebSceneTrimAsciiWhitespace(__csg_scene_resolve_chat_group_id(chatId))
    if gid.len > 0:
        return gid
    return scene.WebSceneTrimAsciiWhitespace(chatId)

fn __csg_scene_apply_synccast_result(resultText: str, roomStateRef: str, statusHintRef: str, successHint: str, failureHint: str): int32 =
    let parsed = json.ParseJsonSafe(resultText)
    if !parsed.success:
        return -1
    var ok: bool
    if !json.JsonTryGetBool(parsed.value, "ok", ok) || !ok:
        let errorText = failureHint
        if errorText.len == 0:
            return 1
        if !scene.WebSceneSetStateValue(__csgSceneGraph, statusHintRef, errorText):
            return -1
        return 1
    let stateNode = json.JsonGetField(parsed.value, "state")
    let roomNode = json.JsonGetField(stateNode, "room")
    let roomText = json.JsonStringify(roomNode)
    var nextRoomState = "null"
    if roomText.len > 0:
        nextRoomState = roomText
    if !scene.WebSceneSetStateValue(__csgSceneGraph, roomStateRef, nextRoomState):
        return -1
    if successHint.len > 0:
        if !scene.WebSceneSetStateValue(__csgSceneGraph, statusHintRef, successHint):
            return -1
    return 1

fn __csg_scene_apply_synccast_effect(effect: str): int32 =
    if scene.WebSceneStrStartsWith(effect, "synccast_control:"):
        let op = __csg_scene_effect_part_after_prefix(effect, "synccast_control:", 0)
        let chatIdRef = __csg_scene_effect_part_after_prefix(effect, "synccast_control:", 1)
        let isGroupRef = __csg_scene_effect_part_after_prefix(effect, "synccast_control:", 2)
        let localPeerIdRef = __csg_scene_effect_part_after_prefix(effect, "synccast_control:", 3)
        let roomStateRef = __csg_scene_effect_part_after_prefix(effect, "synccast_control:", 4)
        let statusHintRef = __csg_scene_effect_part_after_prefix(effect, "synccast_control:", 5)
        if !(op == "play" || op == "pause") || chatIdRef.len == 0 || isGroupRef.len == 0 || localPeerIdRef.len == 0 || roomStateRef.len == 0 || statusHintRef.len == 0:
            return -1
        let roomId = __csg_scene_resolve_synccast_room_id(chatIdRef, isGroupRef, localPeerIdRef)
        if roomId.len == 0:
            return 1
        var successHint = "已同步播放"
        if op == "pause":
            successHint = "已同步暂停"
        return __csg_scene_apply_synccast_result(chengSocialSynccastControl(roomId, op), roomStateRef, statusHintRef, successHint, "同步控制失败，请检查网络连接")
    if scene.WebSceneStrStartsWith(effect, "synccast_refresh:"):
        let chatIdRef = __csg_scene_effect_part_after_prefix(effect, "synccast_refresh:", 0)
        let isGroupRef = __csg_scene_effect_part_after_prefix(effect, "synccast_refresh:", 1)
        let localPeerIdRef = __csg_scene_effect_part_after_prefix(effect, "synccast_refresh:", 2)
        let roomStateRef = __csg_scene_effect_part_after_prefix(effect, "synccast_refresh:", 3)
        let statusHintRef = __csg_scene_effect_part_after_prefix(effect, "synccast_refresh:", 4)
        if chatIdRef.len == 0 || isGroupRef.len == 0 || localPeerIdRef.len == 0 || roomStateRef.len == 0 || statusHintRef.len == 0:
            return -1
        let roomId = __csg_scene_resolve_synccast_room_id(chatIdRef, isGroupRef, localPeerIdRef)
        if roomId.len == 0:
            return 1
        return __csg_scene_apply_synccast_result(chengSocialSynccastRefresh(roomId), roomStateRef, statusHintRef, "", "")
    return 0

fn __csg_scene_apply_region_policy_refresh(effect: str): int32 =
    let prefix = "region_policy_refresh:"
    let regionPolicyRef = __csg_scene_effect_part_after_prefix(effect, prefix, 0)
    let policyGroupIdRef = __csg_scene_effect_part_after_prefix(effect, prefix, 1)
    let isDomesticRef = __csg_scene_effect_part_after_prefix(effect, prefix, 2)
    if regionPolicyRef.len == 0 || policyGroupIdRef.len == 0 || isDomesticRef.len == 0:
        return -1
    let resultText = chengRegionPolicyRefresh()
    let parsed = json.ParseJsonSafe(resultText)
    if !parsed.success:
        return -1
    var ok: bool
    if !json.JsonTryGetBool(parsed.value, "ok", ok) || !ok:
        return -1
    let policyNode = json.JsonGetField(parsed.value, "policy")
    var policyGroupId: str
    var isDomestic: bool
    if !json.JsonTryGetStr(policyNode, "policyGroupId", policyGroupId):
        return -1
    if !json.JsonTryGetBool(policyNode, "isDomestic", isDomestic):
        return -1
    let policyText = json.JsonStringify(policyNode)
    if policyText.len == 0:
        return -1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, regionPolicyRef, policyText):
        return -1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, policyGroupIdRef, policyGroupId):
        return -1
    var domesticText = "false"
    if isDomestic:
        domesticText = "true"
    if !scene.WebSceneSetStateValue(__csgSceneGraph, isDomesticRef, domesticText):
        return -1
    return 1

fn __csg_scene_apply_asset_action_submit(effect: str): int32 =
    let prefix = "asset_action_submit:"
    let stateRef = __csg_scene_effect_part_after_prefix(effect, prefix, 0)
    let amountRef = __csg_scene_effect_part_after_prefix(effect, prefix, 1)
    let targetRef = __csg_scene_effect_part_after_prefix(effect, prefix, 2)
    let domesticRef = __csg_scene_effect_part_after_prefix(effect, prefix, 3)
    let balanceRef = __csg_scene_effect_part_after_prefix(effect, prefix, 4)
    let ledgerRef = __csg_scene_effect_part_after_prefix(effect, prefix, 5)
    let errorRef = __csg_scene_effect_part_after_prefix(effect, prefix, 6)
    let hintRef = __csg_scene_effect_part_after_prefix(effect, prefix, 7)
    if stateRef.len == 0 || amountRef.len == 0 || targetRef.len == 0 || domesticRef.len == 0 || balanceRef.len == 0 || ledgerRef.len == 0 || errorRef.len == 0 || hintRef.len == 0:
        return -1
    let stateText = scene.WebSceneStateValueForRef(__csgSceneGraph, stateRef)
    let stateParsed = json.ParseJsonSafe(stateText)
    if !stateParsed.success:
        return 0
    var asset: str
    var action: str
    if !json.JsonTryGetStr(stateParsed.value, "asset", asset) || asset.len == 0:
        return 0
    if !json.JsonTryGetStr(stateParsed.value, "action", action) || action.len == 0:
        return 0
    let amountText = scene.WebSceneTrimAsciiWhitespace(scene.WebSceneStateValueForRef(__csgSceneGraph, amountRef))
    var amount: float64
    if !scene.WebSceneParseFloatPrefix(amountText, amount) || amount <= 0.0:
        if !scene.WebSceneSetStateValue(__csgSceneGraph, errorRef, "请输入有效金额"):
            return -1
        return 1
    let domesticText = scene.WebSceneStateValueForRef(__csgSceneGraph, domesticRef)
    let isDomestic = domesticText == "true"
    var commitTarget: str
    if action == "recharge":
        if asset == "points" && !isDomestic:
            if !scene.WebSceneSetStateValue(__csgSceneGraph, errorRef, "境外账号仅支持充值 RWAD"):
                return -1
            return 1
        if asset == "rwad":
            if !scene.WebSceneSetStateValue(__csgSceneGraph, errorRef, "RWAD 余额以链上为准，不支持本地充值。"):
                return -1
            return 1
    else:
        let target = scene.WebSceneTrimAsciiWhitespace(scene.WebSceneStateValueForRef(__csgSceneGraph, targetRef))
        if asset == "points" && !isDomestic && target.len < 6:
            if !scene.WebSceneSetStateValue(__csgSceneGraph, errorRef, "请输入有效的目标地址或 PeerId"):
                return -1
            return 1
        if (asset == "rwad" || (asset == "points" && isDomestic)) && target.len > 0 && target.len < 6:
            if !scene.WebSceneSetStateValue(__csgSceneGraph, errorRef, "请输入有效的目标地址或 PeerId"):
                return -1
            return 1
        if asset == "points":
            var balance: float64
            if !scene.WebSceneParseFloatPrefix(scene.WebSceneStateValueForRef(__csgSceneGraph, balanceRef), balance):
                balance = 0.0
            if balance < amount:
                if !scene.WebSceneSetStateValue(__csgSceneGraph, errorRef, "积分余额不足"):
                    return -1
                return 1
        commitTarget = target
    var reqNode = json.NewJObject()
    json.JsonSetFieldStr(reqNode, "asset", asset)
    json.JsonSetFieldStr(reqNode, "action", action)
    json.JsonSetFieldStr(reqNode, "amount", amountText)
    json.JsonSetFieldStr(reqNode, "target", commitTarget)
    json.JsonSetFieldStr(reqNode, "isDomestic", domesticText)
    let resultText = chengProfileAssetActionSubmit(json.JsonStringify(reqNode))
    let resultParsed = json.ParseJsonSafe(resultText)
    if !resultParsed.success:
        return -1
    var ok: bool
    if !json.JsonTryGetBool(resultParsed.value, "ok", ok):
        return -1
    if !ok:
        var pending: bool
        if json.JsonTryGetBool(resultParsed.value, "pending", pending) && pending:
            var pendingHint: str
            if json.JsonTryGetStr(resultParsed.value, "hint", pendingHint) && pendingHint.len > 0:
                if !scene.WebSceneSetStateValue(__csgSceneGraph, hintRef, pendingHint):
                    return -1
            if !scene.WebSceneSetStateValue(__csgSceneGraph, errorRef, ""):
                return -1
            return 1
        var errText: str
        if !json.JsonTryGetStr(resultParsed.value, "error", errText) || errText.len == 0:
            errText = "转账提交失败，请稍后重试。"
        if !scene.WebSceneSetStateValue(__csgSceneGraph, errorRef, errText):
            return -1
        if !scene.WebSceneSetStateValue(__csgSceneGraph, hintRef, ""):
            return -1
        return 1
    var newBalance: str
    if json.JsonTryGetStr(resultParsed.value, "pointsBalance", newBalance) && newBalance.len > 0:
        if !scene.WebSceneSetStateValue(__csgSceneGraph, balanceRef, newBalance):
            return -1
    let ledgerNode = json.JsonGetField(resultParsed.value, "ledger")
    if ledgerNode.kind == json.JArray:
        let ledgerText = json.JsonStringify(ledgerNode)
        if ledgerText.len > 0:
            if !scene.WebSceneSetStateValue(__csgSceneGraph, ledgerRef, ledgerText):
                return -1
    var doneHint: str
    if json.JsonTryGetStr(resultParsed.value, "hint", doneHint):
        if !scene.WebSceneSetStateValue(__csgSceneGraph, hintRef, doneHint):
            return -1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, stateRef, ""):
        return -1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, amountRef, ""):
        return -1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, targetRef, ""):
        return -1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, errorRef, ""):
        return -1
    return 1

fn __csg_scene_apply_profile_peer_id_refresh(effect: str): int32 =
    let prefix = "profile_peer_id_refresh:"
    let peerIdRef = __csg_scene_effect_part_after_prefix(effect, prefix, 0)
    if peerIdRef.len == 0:
        return -1
    let resultText = chengProfilePeerIdRefresh()
    let parsed = json.ParseJsonSafe(resultText)
    if !parsed.success:
        return -1
    var ok: bool
    if !json.JsonTryGetBool(parsed.value, "ok", ok) || !ok:
        return 0
    var peerIdText: str
    if !json.JsonTryGetStr(parsed.value, "peerId", peerIdText):
        return -1
    let peerIdTrimmed = scene.WebSceneTrimAsciiWhitespace(peerIdText)
    if peerIdTrimmed.len == 0:
        return 0
    if !scene.WebSceneSetStateValue(__csgSceneGraph, peerIdRef, peerIdTrimmed):
        return -1
    return 1

fn __csg_scene_location_timeout_for_mode(mode: str): int32 =
    if mode == "publish":
        return 20000
    return 15000

fn __csg_scene_location_max_age_for_mode(mode: str): int32 =
    if mode == "publish":
        return 90000
    return 0

@borrows
@borrow_result
fn __csg_scene_effect_segment_with_prefix(effect: str, prefix: str): str =
    var segStart: int32
    var i: int32
    while i <= len(effect):
        if i == len(effect):
            if scene.WebSceneStrStartsWith(strings.SliceBytes(effect, segStart, i - segStart), prefix):
                return strings.SliceBytes(effect, segStart, i - segStart)
            return ""
        if strings.SliceBytes(effect, i, 1) == ";":
            if scene.WebSceneStrStartsWith(strings.SliceBytes(effect, segStart, i - segStart), prefix):
                return strings.SliceBytes(effect, segStart, i - segStart)
            segStart = i + 1
        i = i + 1
    return ""

@borrows
@borrow_result
fn __csg_scene_effect_strip_guard_segments(effect: str): str =
    var start: int32
    while start < len(effect):
        var end = start
        while end < len(effect) && strings.SliceBytes(effect, end, 1) != ";":
            end = end + 1
        let seg = strings.SliceBytes(effect, start, end - start)
        if !scene.WebSceneStrStartsWith(seg, "guard_state:") && !scene.WebSceneStrStartsWith(seg, "guard_key:"):
            return strings.SliceBytes(effect, start, len(effect) - start)
        if end >= len(effect):
            return ""
        start = end + 1
    return ""

@borrows
fn __csg_scene_effect_is_native_intercepted(effect: str): bool =
    let core = __csg_scene_effect_strip_guard_segments(effect)
    if scene.WebSceneStrStartsWith(core, "external-publish:"):
        return true
    if scene.WebSceneStrStartsWith(core, "file-picker:"):
        return true
    if scene.WebSceneStrStartsWith(core, "content_location_open:"):
        return true
    if scene.WebSceneStrStartsWith(core, "location_capture:"):
        return true
    if scene.WebSceneStrStartsWith(core, "social_group_create_selected:"):
        return true
    if scene.WebSceneStrStartsWith(core, "synccast_control:") || scene.WebSceneStrStartsWith(core, "synccast_refresh:"):
        return true
    if scene.WebSceneStrStartsWith(core, "region_policy_refresh:"):
        return true
    if scene.WebSceneStrStartsWith(core, "profile_peer_id_refresh:"):
        return true
    if scene.WebSceneStrStartsWith(core, "node_contents_refresh:"):
        return true
    if scene.WebSceneStrStartsWith(core, "rwad_nfc_receive_toggle:"):
        return true
    if scene.WebSceneStrStartsWith(core, "clear_published_contents:"):
        return true
    if scene.WebSceneStrStartsWith(core, "content_delete:"):
        return true
    if scene.WebSceneStrStartsWith(core, "profile_bio_did_create:"):
        return true
    if scene.WebSceneStrStartsWith(core, "profile_bio_did_open_entry:"):
        return true
    if scene.WebSceneStrStartsWith(core, "profile_bio_did_import:"):
        return true
    if scene.WebSceneStrStartsWith(core, "trading_refresh:"):
        return true
    if scene.WebSceneStrStartsWith(core, "asset_action_submit:"):
        return true
    return false

fn __csg_scene_capture_location_for_segment(segment: str): int32 =
    let prefix = "location_capture:"
    let mode = __csg_scene_effect_part_after_prefix(segment, prefix, 0)
    let previewRef = __csg_scene_effect_part_after_prefix(segment, prefix, 1)
    let statusRef = __csg_scene_effect_part_after_prefix(segment, prefix, 2)
    let messageRef = __csg_scene_effect_part_after_prefix(segment, prefix, 3)
    let openModalRef = __csg_scene_effect_part_after_prefix(segment, prefix, 4)
    let nameRef = __csg_scene_effect_part_after_prefix(segment, prefix, 5)
    if mode.len == 0 || previewRef.len == 0 || statusRef.len == 0 || messageRef.len == 0:
        return -2
    if openModalRef.len > 0:
        if !scene.WebSceneSetStateValue(__csgSceneGraph, openModalRef, "true"):
            return -2
    let timeoutMs = __csg_scene_location_timeout_for_mode(mode)
    let maxAgeMs = __csg_scene_location_max_age_for_mode(mode)
    let result = chengCaptureLocation(timeoutMs, maxAgeMs, previewRef, statusRef, messageRef)
    if scene.WebSceneStrStartsWith(result, "ok:"):
        let label = strings.SliceBytes(result, 3, result.len - 3)
        if !scene.WebSceneSetStateValue(__csgSceneGraph, previewRef, label):
            return -2
        if !scene.WebSceneSetStateValue(__csgSceneGraph, statusRef, "ready"):
            return -2
        if messageRef != previewRef:
            if !scene.WebSceneSetStateValue(__csgSceneGraph, messageRef, ""):
                return -2
        if nameRef.len > 0:
            let existingName = scene.WebSceneTrimAsciiWhitespace(scene.WebSceneStateValueForRef(__csgSceneGraph, nameRef))
            if existingName.len == 0:
                if !scene.WebSceneSetStateValue(__csgSceneGraph, nameRef, label):
                    return -2
        return 1
    if scene.WebSceneStrStartsWith(result, "err:"):
        let code = __csg_scene_effect_part_after_prefix(result, "err:", 0)
        let msg = __csg_scene_effect_part_after_prefix(result, "err:", 1)
        if code.len > 0:
            if !scene.WebSceneSetStateValue(__csgSceneGraph, statusRef, code):
                return -2
        if msg.len > 0:
            if !scene.WebSceneSetStateValue(__csgSceneGraph, messageRef, msg):
                return -2
        return -1
    return 0

fn __csg_scene_apply_route_enter_effects(routeIndex: int32): int32 =
    if routeIndex == 28:
        return __csg_scene_capture_location_for_segment("location_capture:publish:locationMessage:locationStatus:locationMessage")
    if routeIndex == 29:
        return __csg_scene_capture_location_for_segment("location_capture:publish:locationMessage:locationStatus:locationMessage")
    if routeIndex == 30:
        return __csg_scene_capture_location_for_segment("location_capture:publish:locationMessage:locationStatus:locationMessage")
    if routeIndex == 31:
        return __csg_scene_capture_location_for_segment("location_capture:publish:locationMessage:locationStatus:locationMessage")
    if routeIndex == 32:
        return __csg_scene_capture_location_for_segment("location_capture:publish:locationMessage:locationStatus:locationMessage")
    if routeIndex == 33:
        return __csg_scene_capture_location_for_segment("location_capture:publish:locationMessage:locationStatus:locationMessage")
    if routeIndex == 34:
        return __csg_scene_capture_location_for_segment("location_capture:publish:locationMessage:locationStatus:locationMessage")
    if routeIndex == 42:
        return __csg_scene_capture_location_for_segment("location_capture:publish:locationMessage:locationStatus:locationMessage")
    if routeIndex == 43:
        return __csg_scene_capture_location_for_segment("location_capture:publish:locationMessage:locationStatus:locationMessage")
    if routeIndex == 44:
        return __csg_scene_capture_location_for_segment("location_capture:publish:locationMessage:locationStatus:locationMessage")
    if routeIndex == 45:
        return __csg_scene_capture_location_for_segment("location_capture:publish:locationMessage:locationStatus:locationMessage")
    if routeIndex == 37:
        return __csg_scene_apply_nodes_route_enter_refresh()
    return 0

fn __csg_scene_peer_id_from_state_ref(refName: str): str =
    let raw = scene.WebSceneStateValueForRef(__csgSceneGraph, refName)
    let parsed = json.ParseJsonSafe(raw)
    if parsed.success:
        var peerId: str
        if json.JsonTryGetStr(parsed.value, "peerId", peerId):
            return scene.WebSceneTrimAsciiWhitespace(peerId)
    return scene.WebSceneTrimAsciiWhitespace(raw)

fn __csg_scene_apply_node_contents_refresh(effect: str): int32 =
    let prefix = "node_contents_refresh:"
    let ownerRef = __csg_scene_effect_part_after_prefix(effect, prefix, 0)
    let contentsRef = __csg_scene_effect_part_after_prefix(effect, prefix, 1)
    let loadingRef = __csg_scene_effect_part_after_prefix(effect, prefix, 2)
    let errorRef = __csg_scene_effect_part_after_prefix(effect, prefix, 3)
    if ownerRef.len == 0 || contentsRef.len == 0 || loadingRef.len == 0 || errorRef.len == 0:
        return -1
    let peerId = __csg_scene_peer_id_from_state_ref(ownerRef)
    if peerId.len == 0:
        if !scene.WebSceneSetStateValue(__csgSceneGraph, contentsRef, "[]"):
            return -1
        if !scene.WebSceneSetStateValue(__csgSceneGraph, loadingRef, "false"):
            return -1
        return 1
    let resultText = chengNodeContentsRefresh(peerId, true)
    let parsed = json.ParseJsonSafe(resultText)
    if !parsed.success:
        return -1
    var ok: bool
    if !json.JsonTryGetBool(parsed.value, "ok", ok):
        return -1
    if !ok:
        var errorText: str
        if !json.JsonTryGetStr(parsed.value, "error", errorText):
            errorText = "node_contents_refresh_failed"
        if !scene.WebSceneSetStateValue(__csgSceneGraph, errorRef, errorText):
            return -1
        if !scene.WebSceneSetStateValue(__csgSceneGraph, loadingRef, "false"):
            return -1
        return 1
    let itemsNode = json.JsonGetField(parsed.value, "items")
    if itemsNode.kind != json.JArray:
        return -1
    let itemsText = json.JsonStringify(itemsNode)
    if itemsText.len == 0:
        return -1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, contentsRef, itemsText):
        return -1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, loadingRef, "false"):
        return -1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, errorRef, ""):
        return -1
    return 1

fn __csg_scene_rwad_wallet_from_wallets_ref(walletsRef: str): str =
    let raw = scene.WebSceneStateValueForRef(__csgSceneGraph, walletsRef)
    let parsed = json.ParseJsonSafe(raw)
    if !parsed.success || parsed.value.kind != json.JArray:
        return ""
    for i in 0..<parsed.value.a.len:
        let item = parsed.value.a[i]
        var chain: str
        if !json.JsonTryGetStr(item, "chain", chain):
            continue
        if scene.WebSceneTrimAsciiWhitespace(chain) != "rwad":
            continue
        var address: str
        if json.JsonTryGetStr(item, "address", address):
            return scene.WebSceneTrimAsciiWhitespace(address)
    return ""

fn __csg_scene_rwad_nfc_hint_for_error(errorText: str, settingsOpened: bool): str =
    let normalized = scene.WebSceneTrimAsciiWhitespace(errorText)
    if normalized == "nfc_wallet_intercepted" && settingsOpened:
        return "检测到系统钱包拦截，已为你打开 NFC 支付设置，请将默认支付应用切换后重试"
    if (normalized == "nfc_disabled" || normalized == "nfc_unavailable") && settingsOpened:
        return "检测到 NFC 未开启，已为你打开系统 NFC 设置，请开启后返回重试"
    if scene.WebSceneStrStartsWith(normalized, "bridge_method_unavailable"):
        return "当前平台暂不支持 NFC 授权转账"
    if normalized == "rwad_wallet_not_found" || normalized == "transfer_identity_unavailable" || normalized == "missing_required_field":
        return "未找到本机 PeerId 身份，请先等待节点初始化完成。"
    if normalized == "nfc_unavailable":
        return "设备不支持 NFC 或当前不可用"
    if normalized == "nfc_disabled":
        return "NFC 未开启，请先在系统设置中打开 NFC"
    if normalized == "nfc_scan_cancelled":
        return "已取消 NFC 扫描"
    if normalized == "nfc_tag_untrusted":
        return "NFC 标签校验失败，请使用已绑定标签"
    if normalized == "nfc_auth_timeout":
        return "NFC 授权超时，请重试"
    if normalized == "nfc_wallet_intercepted":
        return "检测到交通卡/钱包拦截 NFC，请关闭交通卡快捷呼起或切换默认支付应用后重试"
    if normalized == "nfc_peer_not_ready":
        return "未读取到收款方，请让对方先开启 NFC 收款模式后再碰一碰"
    if normalized == "nfc_peer_self_transfer_denied":
        return "收款地址与当前钱包相同，请使用另一台手机收款"
    if normalized == "invalid_cbor_payload" || normalized == "field_type_mismatch" || normalized == "native_proxy_unavailable" || normalized == "native_bridge_not_ready":
        return "NFC 授权协议错误，请升级应用后重试"
    if normalized == "unsupported_platform" || normalized == "native_platform_required" || normalized == "bridge_method_unavailable":
        return "当前平台暂不支持 NFC 授权转账"
    if normalized.len == 0:
        return "设备不支持 NFC 或当前不可用"
    return strings.ConcatStr("RWAD 转账失败: ", normalized)

fn __csg_scene_apply_rwad_nfc_receive_toggle(effect: str): int32 =
    let prefix = "rwad_nfc_receive_toggle:"
    let peerIdRef = __csg_scene_effect_part_after_prefix(effect, prefix, 0)
    let walletsRef = __csg_scene_effect_part_after_prefix(effect, prefix, 1)
    let activeRef = __csg_scene_effect_part_after_prefix(effect, prefix, 2)
    let busyRef = __csg_scene_effect_part_after_prefix(effect, prefix, 3)
    let expiresRef = __csg_scene_effect_part_after_prefix(effect, prefix, 4)
    let hintRef = __csg_scene_effect_part_after_prefix(effect, prefix, 5)
    if peerIdRef.len == 0 || walletsRef.len == 0 || activeRef.len == 0 || busyRef.len == 0 || expiresRef.len == 0 || hintRef.len == 0:
        return -1
    if scene.WebSceneStateValueForRef(__csgSceneGraph, busyRef) == "true":
        return 1
    var walletId = scene.WebSceneTrimAsciiWhitespace(scene.WebSceneStateValueForRef(__csgSceneGraph, peerIdRef))
    if walletId.len == 0:
        walletId = __csg_scene_rwad_wallet_from_wallets_ref(walletsRef)
    if walletId.len == 0:
        if !scene.WebSceneSetStateValue(__csgSceneGraph, hintRef, "未找到本机 PeerId 身份，请先等待节点初始化完成。"):
            return -1
        return 1
    let active = scene.WebSceneStateValueForRef(__csgSceneGraph, activeRef) == "true"
    let resultText = chengRwadNfcReceiveToggle(walletId, active)
    let parsed = json.ParseJsonSafe(resultText)
    if !parsed.success:
        return -1
    var ok: bool
    if !json.JsonTryGetBool(parsed.value, "ok", ok):
        return -1
    if ok:
        if active:
            if !scene.WebSceneSetStateValue(__csgSceneGraph, activeRef, "false"):
                return -1
            if !scene.WebSceneSetStateValue(__csgSceneGraph, expiresRef, "0"):
                return -1
            if !scene.WebSceneSetStateValue(__csgSceneGraph, hintRef, "NFC 收款模式已关闭"):
                return -1
        else:
            var expiresAt: int64
            if !json.JsonTryGetInt64(parsed.value, "expiresAt", expiresAt):
                expiresAt = 0
            if !scene.WebSceneSetStateValue(__csgSceneGraph, activeRef, "true"):
                return -1
            if !scene.WebSceneSetStateValue(__csgSceneGraph, expiresRef, strings.Int64ToStr(expiresAt)):
                return -1
            if !scene.WebSceneSetStateValue(__csgSceneGraph, hintRef, "NFC 收款模式已开启，请让对方手机贴近读取收款地址"):
                return -1
        if !scene.WebSceneSetStateValue(__csgSceneGraph, busyRef, "false"):
            return -1
        return 1
    var errorText: str
    if !json.JsonTryGetStr(parsed.value, "error", errorText):
        errorText = "nfc_unavailable"
    var settingsOpened: bool
    if !json.JsonTryGetBool(parsed.value, "settingsOpened", settingsOpened):
        settingsOpened = false
    let hint = __csg_scene_rwad_nfc_hint_for_error(errorText, settingsOpened)
    if !scene.WebSceneSetStateValue(__csgSceneGraph, hintRef, hint):
        return -1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, busyRef, "false"):
        return -1
    return 1

@borrows
fn __csg_scene_json_int64_field(node: json.JsonNode, key: str): int64 =
    var value: int64
    if json.JsonTryGetInt64(node, key, value):
        return value
    return 0

@borrows
fn __csg_scene_clear_published_hint(snapshotNode: json.JsonNode, status: str): str =
    if status == "running":
        let progressNode = json.JsonGetField(snapshotNode, "progress")
        let total = __csg_scene_json_int64_field(progressNode, "total")
        let completed = __csg_scene_json_int64_field(progressNode, "completed")
        if total > 0:
            return strings.ConcatStr(strings.ConcatStr(strings.ConcatStr("后台并行下架中 ", strings.Int64ToStr(completed)), " / "), strings.ConcatStr(strings.Int64ToStr(total), " 条内容..."))
        return "后台正在检查已发布内容..."
    if status == "failed":
        var errorText: str
        if json.JsonTryGetStr(snapshotNode, "error", errorText) && errorText.len > 0:
            return errorText
        return "全网下架失败"
    let resultNode = json.JsonGetField(snapshotNode, "result")
    let requested = __csg_scene_json_int64_field(resultNode, "requested")
    let tombstonedRemote = __csg_scene_json_int64_field(resultNode, "tombstonedRemote")
    let reclaimedAssets = __csg_scene_json_int64_field(resultNode, "reclaimedAssets")
    var hint = strings.ConcatStr(strings.ConcatStr(strings.ConcatStr("已向全网下架 ", strings.Int64ToStr(tombstonedRemote)), " / "), strings.ConcatStr(strings.Int64ToStr(requested), " 条内容"))
    if reclaimedAssets > 0:
        hint = strings.ConcatStr(hint, strings.ConcatStr(strings.ConcatStr("，回收 ", strings.Int64ToStr(reclaimedAssets)), " 个媒体资产"))
    let failedIdsNode = json.JsonGetField(resultNode, "failedIds")
    var failedCount: int64
    if failedIdsNode.kind == json.JArray:
        failedCount = int64(failedIdsNode.a.len)
    if failedCount > 0:
        hint = strings.ConcatStr(hint, strings.ConcatStr(strings.ConcatStr("，还有 ", strings.Int64ToStr(failedCount)), " 条下架失败"))
    return hint

fn __csg_scene_apply_clear_published_contents(effect: str): int32 =
    let prefix = "clear_published_contents:"
    let peerIdRef = __csg_scene_effect_part_after_prefix(effect, prefix, 0)
    let jobRef = __csg_scene_effect_part_after_prefix(effect, prefix, 1)
    let clearingRef = __csg_scene_effect_part_after_prefix(effect, prefix, 2)
    let hintRef = __csg_scene_effect_part_after_prefix(effect, prefix, 3)
    if peerIdRef.len == 0 || jobRef.len == 0 || clearingRef.len == 0 || hintRef.len == 0:
        return -1
    let peerId = scene.WebSceneTrimAsciiWhitespace(scene.WebSceneStateValueForRef(__csgSceneGraph, peerIdRef))
    if peerId.len == 0:
        if !scene.WebSceneSetStateValue(__csgSceneGraph, hintRef, "未找到本机 PeerId 身份，请先等待节点初始化完成。"):
            return -1
        if !scene.WebSceneSetStateValue(__csgSceneGraph, clearingRef, "false"):
            return -1
        return 1
    let resultText = chengClearPublishedContents(peerId)
    let parsed = json.ParseJsonSafe(resultText)
    if !parsed.success:
        return -1
    var ok: bool
    if !json.JsonTryGetBool(parsed.value, "ok", ok):
        return -1
    if !ok:
        var errorText: str
        if !json.JsonTryGetStr(parsed.value, "error", errorText) || errorText.len == 0:
            errorText = "全网下架失败"
        if !scene.WebSceneSetStateValue(__csgSceneGraph, hintRef, errorText):
            return -1
        if !scene.WebSceneSetStateValue(__csgSceneGraph, clearingRef, "false"):
            return -1
        return 1
    let snapshotNode = json.JsonGetField(parsed.value, "snapshot")
    if snapshotNode.kind != json.JObject:
        return -1
    let snapshotText = json.JsonStringify(snapshotNode)
    if snapshotText.len == 0:
        return -1
    var status: str
    if !json.JsonTryGetStr(snapshotNode, "status", status):
        status = "succeeded"
    var clearingText = "false"
    if status == "running":
        clearingText = "true"
    var hintText: str
    if !json.JsonTryGetStr(parsed.value, "hint", hintText):
        hintText = __csg_scene_clear_published_hint(snapshotNode, status)
    if hintText.len == 0:
        hintText = __csg_scene_clear_published_hint(snapshotNode, status)
    if !scene.WebSceneSetStateValue(__csgSceneGraph, jobRef, snapshotText):
        return -1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, clearingRef, clearingText):
        return -1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, hintRef, hintText):
        return -1
    return 1

fn __csg_scene_apply_content_delete(effect: str): int32 =
    let prefix = "content_delete:"
    let contentRef = __csg_scene_effect_part_after_prefix(effect, prefix, 0)
    let busyRef = __csg_scene_effect_part_after_prefix(effect, prefix, 1)
    let messageRef = __csg_scene_effect_part_after_prefix(effect, prefix, 2)
    let closeRouteId = __csg_scene_effect_part_after_prefix(effect, prefix, 3)
    if contentRef.len == 0 || busyRef.len == 0 || messageRef.len == 0 || closeRouteId.len == 0:
        return -1
    if scene.WebSceneStateValueForRef(__csgSceneGraph, busyRef) == "true":
        return 1
    let contentText = scene.WebSceneStateValueForRef(__csgSceneGraph, contentRef)
    if contentText.len == 0:
        if !scene.WebSceneSetStateValue(__csgSceneGraph, messageRef, "content_not_found"):
            return -1
        return 1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, busyRef, "true"):
        return -1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, messageRef, ""):
        return -1
    let resultText = chengContentDelete(contentText, "确认下架这条发布内容？相关视频资产会一起回收。")
    let parsed = json.ParseJsonSafe(resultText)
    if !parsed.success:
        return -1
    var ok: bool
    if !json.JsonTryGetBool(parsed.value, "ok", ok):
        return -1
    if !ok:
        var errorText: str
        if !json.JsonTryGetStr(parsed.value, "error", errorText) || errorText.len == 0:
            errorText = "content_delete_failed"
        if !scene.WebSceneSetStateValue(__csgSceneGraph, messageRef, errorText):
            return -1
        if !scene.WebSceneSetStateValue(__csgSceneGraph, busyRef, "false"):
            return -1
        return 1
    var confirmed: bool
    if json.JsonTryGetBool(parsed.value, "confirmed", confirmed) && !confirmed:
        if !scene.WebSceneSetStateValue(__csgSceneGraph, busyRef, "false"):
            return -1
        return 1
    var reclaimedAssets: int64
    if !json.JsonTryGetInt64(parsed.value, "reclaimedAssets", reclaimedAssets):
        reclaimedAssets = 0
    var message = "已下架"
    if reclaimedAssets > 0:
        message = strings.ConcatStr(strings.ConcatStr("已下架，回收 ", strings.Int64ToStr(reclaimedAssets)), " 个媒体资产")
    if !scene.WebSceneSetStateValue(__csgSceneGraph, messageRef, message):
        return -1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, busyRef, "false"):
        return -1
    if !scene.WebSceneSetActiveRouteById(__csgSceneGraph, closeRouteId):
        return -1
    return 1

fn __csg_scene_apply_profile_bio_did_create(effect: str): int32 =
    let prefix = "profile_bio_did_create:"
    let busyRef = __csg_scene_effect_part_after_prefix(effect, prefix, 0)
    let hintRef = __csg_scene_effect_part_after_prefix(effect, prefix, 1)
    let didTextRef = __csg_scene_effect_part_after_prefix(effect, prefix, 2)
    let peerIdRef = __csg_scene_effect_part_after_prefix(effect, prefix, 3)
    let backupRef = __csg_scene_effect_part_after_prefix(effect, prefix, 4)
    let recoverySheetRef = __csg_scene_effect_part_after_prefix(effect, prefix, 5)
    let backupSheetRef = __csg_scene_effect_part_after_prefix(effect, prefix, 6)
    if busyRef.len == 0 || hintRef.len == 0 || didTextRef.len == 0 || peerIdRef.len == 0 || backupRef.len == 0 || recoverySheetRef.len == 0 || backupSheetRef.len == 0:
        return -1
    if scene.WebSceneStateValueForRef(__csgSceneGraph, busyRef) == "true":
        return 1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, busyRef, "true"):
        return -1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, hintRef, ""):
        return -1
    let resultText = chengProfileBioDidCreate()
    let parsed = json.ParseJsonSafe(resultText)
    if !parsed.success:
        return -1
    var ok: bool
    if !json.JsonTryGetBool(parsed.value, "ok", ok):
        return -1
    if !ok:
        var errorText: str
        if !json.JsonTryGetStr(parsed.value, "error", errorText) || errorText.len == 0:
            errorText = "device_did_create_failed"
        if !scene.WebSceneSetStateValue(__csgSceneGraph, hintRef, errorText):
            return -1
        if !scene.WebSceneSetStateValue(__csgSceneGraph, busyRef, "false"):
            return -1
        return 1
    var didText: str
    if !json.JsonTryGetStr(parsed.value, "did", didText) || didText.len == 0:
        return -1
    var peerId: str
    if !json.JsonTryGetStr(parsed.value, "peerId", peerId) || peerId.len == 0:
        return -1
    var recoveryPayload: str
    if !json.JsonTryGetStr(parsed.value, "recoveryPayload", recoveryPayload):
        recoveryPayload = ""
    if !scene.WebSceneSetStateValue(__csgSceneGraph, didTextRef, didText):
        return -1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, peerIdRef, peerId):
        return -1
    if recoveryPayload.len > 0:
        if !scene.WebSceneSetStateValue(__csgSceneGraph, backupRef, recoveryPayload):
            return -1
        if !scene.WebSceneSetStateValue(__csgSceneGraph, backupSheetRef, "true"):
            return -1
    else:
        if !scene.WebSceneSetStateValue(__csgSceneGraph, backupSheetRef, "false"):
            return -1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, recoverySheetRef, "false"):
        return -1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, hintRef, "DID 已创建"):
        return -1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, busyRef, "false"):
        return -1
    return 1

fn __csg_scene_apply_profile_bio_did_open_entry(effect: str): int32 =
    let prefix = "profile_bio_did_open_entry:"
    let hintRef = __csg_scene_effect_part_after_prefix(effect, prefix, 0)
    let didTextRef = __csg_scene_effect_part_after_prefix(effect, prefix, 1)
    let backupRef = __csg_scene_effect_part_after_prefix(effect, prefix, 2)
    let backupSheetRef = __csg_scene_effect_part_after_prefix(effect, prefix, 3)
    let recoveryInputRef = __csg_scene_effect_part_after_prefix(effect, prefix, 4)
    let recoverySheetRef = __csg_scene_effect_part_after_prefix(effect, prefix, 5)
    if hintRef.len == 0 || didTextRef.len == 0 || backupRef.len == 0 || backupSheetRef.len == 0 || recoveryInputRef.len == 0 || recoverySheetRef.len == 0:
        return -1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, hintRef, ""):
        return -1
    let didTextValue = strutil.Strip(scene.WebSceneStateValueForRef(__csgSceneGraph, didTextRef))
    if didTextValue.len > 0:
        let payload = strutil.Strip(scene.WebSceneStateValueForRef(__csgSceneGraph, backupRef))
        if payload.len > 0:
            if !scene.WebSceneSetStateValue(__csgSceneGraph, backupRef, payload):
                return -1
            if !scene.WebSceneSetStateValue(__csgSceneGraph, backupSheetRef, "true"):
                return -1
        else:
            if !scene.WebSceneSetStateValue(__csgSceneGraph, hintRef, "当前浏览器没有恢复文本，请重新创建 DID"):
                return -1
        return 1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, recoveryInputRef, ""):
        return -1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, recoverySheetRef, "true"):
        return -1
    return 1

fn __csg_scene_apply_profile_bio_did_import(effect: str): int32 =
    let prefix = "profile_bio_did_import:"
    let busyRef = __csg_scene_effect_part_after_prefix(effect, prefix, 0)
    let hintRef = __csg_scene_effect_part_after_prefix(effect, prefix, 1)
    let didTextRef = __csg_scene_effect_part_after_prefix(effect, prefix, 2)
    let peerIdRef = __csg_scene_effect_part_after_prefix(effect, prefix, 3)
    let recoveryInputRef = __csg_scene_effect_part_after_prefix(effect, prefix, 4)
    let recoverySheetRef = __csg_scene_effect_part_after_prefix(effect, prefix, 5)
    let backupRef = __csg_scene_effect_part_after_prefix(effect, prefix, 6)
    if busyRef.len == 0 || hintRef.len == 0 || didTextRef.len == 0 || peerIdRef.len == 0 || recoveryInputRef.len == 0 || recoverySheetRef.len == 0 || backupRef.len == 0:
        return -1
    if scene.WebSceneStateValueForRef(__csgSceneGraph, busyRef) == "true":
        return 1
    let recoveryInput = strutil.Strip(scene.WebSceneStateValueForRef(__csgSceneGraph, recoveryInputRef))
    if recoveryInput.len == 0:
        if !scene.WebSceneSetStateValue(__csgSceneGraph, hintRef, "device_did_recovery_required"):
            return -1
        return 1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, busyRef, "true"):
        return -1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, hintRef, ""):
        return -1
    let resultText = chengProfileBioDidImport(recoveryInput)
    let parsed = json.ParseJsonSafe(resultText)
    if !parsed.success:
        return -1
    var ok: bool
    if !json.JsonTryGetBool(parsed.value, "ok", ok):
        return -1
    if !ok:
        var errorText: str
        if !json.JsonTryGetStr(parsed.value, "error", errorText) || errorText.len == 0:
            errorText = "device_did_import_failed"
        if !scene.WebSceneSetStateValue(__csgSceneGraph, hintRef, errorText):
            return -1
        if !scene.WebSceneSetStateValue(__csgSceneGraph, busyRef, "false"):
            return -1
        return 1
    var didText: str
    if !json.JsonTryGetStr(parsed.value, "did", didText) || didText.len == 0:
        return -1
    var peerId: str
    if !json.JsonTryGetStr(parsed.value, "peerId", peerId) || peerId.len == 0:
        return -1
    var recoveryPayload: str
    if !json.JsonTryGetStr(parsed.value, "recoveryPayload", recoveryPayload):
        recoveryPayload = ""
    if !scene.WebSceneSetStateValue(__csgSceneGraph, didTextRef, didText):
        return -1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, peerIdRef, peerId):
        return -1
    if recoveryPayload.len > 0:
        if !scene.WebSceneSetStateValue(__csgSceneGraph, backupRef, recoveryPayload):
            return -1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, recoverySheetRef, "false"):
        return -1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, hintRef, "DID 已恢复"):
        return -1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, busyRef, "false"):
        return -1
    return 1

fn __csg_scene_apply_trading_refresh(effect: str): int32 =
    let prefix = "trading_refresh:"
    let selectedPairRef = __csg_scene_effect_part_after_prefix(effect, prefix, 0)
    let intervalRef = __csg_scene_effect_part_after_prefix(effect, prefix, 1)
    let loadingRef = __csg_scene_effect_part_after_prefix(effect, prefix, 2)
    let dexHealthRef = __csg_scene_effect_part_after_prefix(effect, prefix, 3)
    let loadErrorRef = __csg_scene_effect_part_after_prefix(effect, prefix, 4)
    let pairsRef = __csg_scene_effect_part_after_prefix(effect, prefix, 5)
    let candlesRef = __csg_scene_effect_part_after_prefix(effect, prefix, 6)
    let orderBookRef = __csg_scene_effect_part_after_prefix(effect, prefix, 7)
    let tradesRef = __csg_scene_effect_part_after_prefix(effect, prefix, 8)
    let updatedAtRef = __csg_scene_effect_part_after_prefix(effect, prefix, 9)
    if selectedPairRef.len == 0 || intervalRef.len == 0 || loadingRef.len == 0 || dexHealthRef.len == 0 || loadErrorRef.len == 0 || pairsRef.len == 0 || candlesRef.len == 0 || orderBookRef.len == 0 || tradesRef.len == 0 || updatedAtRef.len == 0:
        return -1
    if scene.WebSceneStateValueForRef(__csgSceneGraph, loadingRef) == "true":
        return 1
    let pairText = scene.WebSceneStateValueForRef(__csgSceneGraph, selectedPairRef)
    let intervalText = scene.WebSceneStateValueForRef(__csgSceneGraph, intervalRef)
    if pairText.len == 0 || intervalText.len == 0:
        return -1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, loadingRef, "true"):
        return -1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, loadErrorRef, ""):
        return -1
    let resultText = chengTradingRefresh(pairText, intervalText)
    let parsed = json.ParseJsonSafe(resultText)
    if !parsed.success:
        return -1
    var ok: bool
    if !json.JsonTryGetBool(parsed.value, "ok", ok):
        return -1
    if !ok:
        var errorText: str
        if !json.JsonTryGetStr(parsed.value, "error", errorText) || errorText.len == 0:
            errorText = "行情暂时不可用，请稍后重试。"
        if !scene.WebSceneSetStateValue(__csgSceneGraph, dexHealthRef, "offline"):
            return -1
        if !scene.WebSceneSetStateValue(__csgSceneGraph, loadErrorRef, errorText):
            return -1
        if !scene.WebSceneSetStateValue(__csgSceneGraph, loadingRef, "false"):
            return -1
        return 1
    let nextPair = json.JsonGetField(parsed.value, "pair")
    if nextPair.kind == json.JObject:
        let nextPairText = json.JsonStringify(nextPair)
        if nextPairText.len > 0 && !scene.WebSceneSetStateValue(__csgSceneGraph, selectedPairRef, nextPairText):
            return -1
    let nextPairs = json.JsonGetField(parsed.value, "pairs")
    if nextPairs.kind == json.JArray:
        let nextPairsText = json.JsonStringify(nextPairs)
        if nextPairsText.len > 0 && !scene.WebSceneSetStateValue(__csgSceneGraph, pairsRef, nextPairsText):
            return -1
    let nextCandles = json.JsonGetField(parsed.value, "candles")
    if nextCandles.kind == json.JArray:
        let nextCandlesText = json.JsonStringify(nextCandles)
        if nextCandlesText.len > 0 && !scene.WebSceneSetStateValue(__csgSceneGraph, candlesRef, nextCandlesText):
            return -1
    let nextOrderBook = json.JsonGetField(parsed.value, "orderBook")
    if nextOrderBook.kind == json.JObject:
        let nextOrderBookText = json.JsonStringify(nextOrderBook)
        if nextOrderBookText.len > 0 && !scene.WebSceneSetStateValue(__csgSceneGraph, orderBookRef, nextOrderBookText):
            return -1
    let nextTrades = json.JsonGetField(parsed.value, "trades")
    if nextTrades.kind == json.JArray:
        let nextTradesText = json.JsonStringify(nextTrades)
        if nextTradesText.len > 0 && !scene.WebSceneSetStateValue(__csgSceneGraph, tradesRef, nextTradesText):
            return -1
    var updatedAt: int64
    if json.JsonTryGetInt64(parsed.value, "updatedAt", updatedAt):
        if !scene.WebSceneSetStateValue(__csgSceneGraph, updatedAtRef, strings.Int64ToStr(updatedAt)):
            return -1
    var dexHealth: str
    if !json.JsonTryGetStr(parsed.value, "dexHealth", dexHealth) || dexHealth.len == 0:
        dexHealth = "live"
    var loadError: str
    if !json.JsonTryGetStr(parsed.value, "loadError", loadError):
        loadError = ""
    if !scene.WebSceneSetStateValue(__csgSceneGraph, dexHealthRef, dexHealth):
        return -1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, loadErrorRef, loadError):
        return -1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, loadingRef, "false"):
        return -1
    return 1

@borrows
fn __csg_scene_static_item_for_peer(routeIndex: int32, peerId: str, fieldName: str): str =
    if routeIndex < 0 || peerId.len == 0 || fieldName.len == 0:
        return ""
    let propName = strings.ConcatStr("data-csg-static-item-", fieldName)
    for i in 0..<__csgSceneGraph.props.len:
        if __csgSceneGraph.props[i].routeIndex != routeIndex:
            continue
        if __csgSceneGraph.props[i].propName != "data-csg-static-array":
            continue
        if __csgSceneGraph.props[i].propValue != "filteredNodes":
            continue
        let nodeId = __csgSceneGraph.props[i].nodeId
        let itemPeerId = scene.WebSceneNodePropValue(__csgSceneGraph, routeIndex, nodeId, "data-csg-static-item-peerId")
        if itemPeerId == peerId:
            return scene.WebSceneNodePropValue(__csgSceneGraph, routeIndex, nodeId, propName)
    return ""

fn __csg_scene_peer_display_name(routeIndex: int32, peerId: str): str =
    let nickname = __csg_scene_static_item_for_peer(routeIndex, peerId, "nickname")
    if nickname.len > 0:
        return strFromBytesCopy(StrDataPtr(nickname), len(nickname))
    let domain = __csg_scene_static_item_for_peer(routeIndex, peerId, "domain")
    if domain.len > 0:
        return strFromBytesCopy(StrDataPtr(domain), len(domain))
    if peerId.len > 4:
        let tailRef = strings.SliceBytes(peerId, peerId.len - 4, 4)
        return strFromBytesCopy(StrDataPtr(tailRef), len(tailRef))
    return strFromBytesCopy(StrDataPtr(peerId), len(peerId))

fn __csg_scene_social_group_name(routeIndex: int32, selectedPeers: var str[]): str =
    var out: str
    var i: int32
    while i < selectedPeers.len && i < 3:
        let part = __csg_scene_peer_display_name(routeIndex, selectedPeers[i])
        if part.len > 0:
            if out.len > 0:
                out = strings.ConcatStr(out, ", ")
            out = strings.ConcatStr(out, part)
        i = i + 1
    return out

fn __csg_scene_social_group_payload(routeIndex: int32, selectedPeers: var str[]): str =
    if selectedPeers.len <= 0:
        return ""
    var peersNode = json.NewJArray()
    var peerIdsNode = json.NewJArray()
    for i in 0..<selectedPeers.len:
        let peerId = selectedPeers[i]
        if peerId.len == 0:
            return ""
        var peerNode = json.NewJObject()
        json.JsonSetFieldStr(peerNode, "peerId", peerId)
        json.JsonSetFieldStr(peerNode, "name", __csg_scene_peer_display_name(routeIndex, peerId))
        let avatar = __csg_scene_static_item_for_peer(routeIndex, peerId, "avatar")
        if avatar.len > 0:
            json.JsonSetFieldStr(peerNode, "avatar", avatar)
        let domain = __csg_scene_static_item_for_peer(routeIndex, peerId, "domain")
        if domain.len > 0:
            json.JsonSetFieldStr(peerNode, "domain", domain)
        json.JsonAdd(peersNode, peerNode)
        json.JsonAddStr(peerIdsNode, peerId)
    let groupName = __csg_scene_social_group_name(routeIndex, selectedPeers)
    var meta = json.NewJObject()
    json.JsonSetFieldStr(meta, "source", "unimaker.tab_nodes.create_group")
    json.JsonSetFieldStr(meta, "name", groupName)
    json.JsonSetField(meta, "members", peerIdsNode)
    json.JsonSetField(meta, "peers", peersNode)
    return json.JsonStringify(meta)

fn __csg_scene_apply_social_group_create(activeRoute: int32): int32 =
    var selectedPeers: str[]
    if !scene.WebSceneParseJsonStringArrayState(scene.WebSceneStateValueForRef(__csgSceneGraph, "selectedPeerIds"), selectedPeers):
        if !scene.WebSceneSetStateValue(__csgSceneGraph, "nativeError", "selectedPeerIds parse failed"):
            return -1
        return 1
    if selectedPeers.len < 1:
        return 0
    let payload = __csg_scene_social_group_payload(activeRoute, selectedPeers)
    if payload.len == 0:
        if !scene.WebSceneSetStateValue(__csgSceneGraph, "nativeError", "group payload build failed"):
            return -1
        return 1
    let resultText = chengSocialGroupsCreate(payload)
    let parsed = json.ParseJsonSafe(resultText)
    if !parsed.success:
        if !scene.WebSceneSetStateValue(__csgSceneGraph, "nativeError", resultText):
            return -1
        return 1
    var ok: bool
    if !json.JsonTryGetBool(parsed.value, "ok", ok) || !ok:
        var errorText: str
        if !json.JsonTryGetStr(parsed.value, "error", errorText) || errorText.len == 0:
            errorText = "创建群聊失败"
        if !scene.WebSceneSetStateValue(__csgSceneGraph, "nativeError", errorText):
            return -1
        return 1
    var groupId: str
    if !json.JsonTryGetStr(parsed.value, "groupId", groupId) || groupId.len == 0:
        if !scene.WebSceneSetStateValue(__csgSceneGraph, "nativeError", "创建群聊失败"):
            return -1
        return 1
    let groupName = __csg_scene_social_group_name(activeRoute, selectedPeers)
    var createdName: str
    if !json.JsonTryGetStr(parsed.value, "name", createdName) || createdName.len == 0:
        createdName = groupName
    if createdName.len == 0:
        createdName = share(groupId)
    if !scene.WebSceneSetStateValue(__csgSceneGraph, "nativeError", ""):
        return -1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, "chatId", strings.ConcatStr("group:", groupId)):
        return -1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, "chatName", createdName):
        return -1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, "chatAvatar", ""):
        return -1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, "isGroup", "true"):
        return -1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, "showSocialExtensions", "false"):
        return -1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, "showMorePanel", "false"):
        return -1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, "morePanelPage", "0"):
        return -1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, "selectMode", "false"):
        return -1
    if !scene.WebSceneSetStateValue(__csgSceneGraph, "selectedPeerIds", "[]"):
        return -1
    if !scene.WebSceneSetActiveRouteById(__csgSceneGraph, "node_thread"):
        return -1
    return 1

fn __csg_scene_sync_video_click_media_control(activeRoute: int32, nodeId: int32, effect: str): int32 =
    if activeRoute < 0 || nodeId <= 0:
        return 0
    if !scene.WebSceneStrContains(effect, "handleVideo"):
        return 0
    let slotIndex = scene.WebSceneFindMediaPlaybackSlotIndexForNodeOrAncestor(__csgSceneGraph, activeRoute, nodeId)
    if slotIndex < 0:
        return 0
    let currentState = __csgSceneGraph.mediaPlaybackSlots[slotIndex].playbackState
    let playing = scene.WebSceneStateValueForRef(__csgSceneGraph, "isVideoPlaying") == "true"
    if playing:
        if currentState == scene.WebSceneMediaPlaybackPlaying || currentState == scene.WebSceneMediaPlaybackSeeked:
            return 1
        if currentState == scene.WebSceneMediaPlaybackClosed:
            let openStatus = scene.WebSceneApplyMediaControlForNode(__csgSceneGraph, activeRoute, nodeId, "OpenAsset", true)
            if openStatus < 0:
                return -1
        let playStatus = scene.WebSceneApplyMediaControlForNode(__csgSceneGraph, activeRoute, nodeId, "Play", true)
        if playStatus < 0:
            return -1
        __csgSceneMediaUploadDone = false
        __csgSceneRendered = false
        return 1
    if currentState == scene.WebSceneMediaPlaybackPaused || currentState == scene.WebSceneMediaPlaybackClosed:
        return 1
    let pauseStatus = scene.WebSceneApplyMediaControlForNode(__csgSceneGraph, activeRoute, nodeId, "Pause", true)
    if pauseStatus < 0:
        return -1
    __csgSceneMediaUploadDone = false
    __csgSceneRendered = false
    return 1

fn __csg_scene_apply_event_to_node(nodeId: int32): int32 =
    __csgSceneLastEventHitNodeId = nodeId
    let activeRoute = scene.WebSceneActiveRouteIndex(__csgSceneGraph)
    __csgSceneLastEventHitStatus = 1
    let m2HomeLocationStatus = __m2OpenHomeCardLocationNode(nodeId)
    if m2HomeLocationStatus < 0:
        __csgSceneLastEventApplyStatus = -8
        return -1
    if m2HomeLocationStatus > 0:
        __csgSceneLastEventApplyStatus = 4
        __csgSceneLastTouchHitIndex = -1
        return 1
    let computerUseSettingsStatus = __csg_cu_apply_computer_use_settings_click(activeRoute, nodeId)
    if computerUseSettingsStatus < 0:
        __csgSceneLastEventApplyStatus = -4
        return -1
    if computerUseSettingsStatus > 0:
        __csgSceneLastEventApplyStatus = 3
        __csgSceneLastTouchHitIndex = -1
        __csgSceneRendered = false
        return 1
    let computerUseChatStatus = __csg_cu_apply_chat_send(activeRoute, nodeId)
    if computerUseChatStatus < 0:
        __csgSceneLastEventApplyStatus = -3
        return -1
    if computerUseChatStatus > 0:
        __csgSceneLastEventApplyStatus = 2
        __csgSceneLastTouchHitIndex = -1
        return 1
    let __chtHidx = scene.WebSceneFindEventHandlerForNodeEvent(__csgSceneGraph, activeRoute, nodeId, "click")
    if __chtHidx >= 0:
        let __chtEffect = scene.WebSceneEventHandlerEffectAt(__csgSceneGraph, __chtHidx)
        if !__csg_scene_effect_is_native_intercepted(__chtEffect) && scene.WebSceneEventEffectGuardsPass(__csgSceneGraph, __chtEffect):
            let __chtStatus = __cht_apply_checked(__csgSceneGraph, __chtEffect)
            if __chtStatus < 0:
                __csgSceneLastEventApplyStatus = -1
                return -1
            if __chtStatus > 0:
                __csgSceneLastEventApplyStatus = 1
                if !__csg_scene_refresh_effect_dirty_frame(nodeId):
                    __csgSceneLastEventApplyStatus = -2
                    return -1
                let __videoSyncStatus = __csg_scene_sync_video_click_media_control(activeRoute, nodeId, __chtEffect)
                if __videoSyncStatus < 0:
                    __csgSceneLastEventApplyStatus = -7
                    return -1
                __csgSceneLastTouchHitIndex = -1
                return 1
    let __pubHidx = scene.WebSceneFindEventHandlerForNodeEvent(__csgSceneGraph, activeRoute, nodeId, "click")
    if __pubHidx >= 0:
        let __pubEffectRaw = scene.WebSceneEventHandlerEffectAt(__csgSceneGraph, __pubHidx)
        if !scene.WebSceneEventEffectGuardsPass(__csgSceneGraph, __pubEffectRaw):
            __csgSceneLastEventApplyStatus = 1
            __csgSceneLastTouchHitIndex = -1
            return 1
        let __pubEffect = __csg_scene_effect_strip_guard_segments(__pubEffectRaw)
        if scene.WebSceneStrStartsWith(__pubEffect, "external-publish:"):
            let __pubLocSeg = __csg_scene_effect_segment_with_prefix(__pubEffect, "location_capture:")
            var __pubLocReady: bool
            __pubLocReady = true
            if __pubLocSeg.len > 0:
                let __pubStatusRef = __csg_scene_effect_part_after_prefix(__pubLocSeg, "location_capture:", 2)
                __pubLocReady = scene.WebSceneStateValueForRef(__csgSceneGraph, __pubStatusRef) == "ready"
                if !__pubLocReady:
                    let __pubCapStatus = __csg_scene_capture_location_for_segment(__pubLocSeg)
                    if __pubCapStatus == -2:
                        __csgSceneLastEventApplyStatus = -1
                        return -1
                    __pubLocReady = scene.WebSceneStateValueForRef(__csgSceneGraph, __pubStatusRef) == "success"
            if __pubLocReady:
                let __pubPublishSeg = __csg_scene_effect_segment_with_prefix(__pubEffect, "external-publish:")
                let __pubKind = __csg_scene_effect_part_after_prefix(__pubPublishSeg, "external-publish:", 0)
                let __pubSelectedMediaPath = __csg_scene_first_string_array_item(scene.WebSceneStateValueForRef(__csgSceneGraph, "mediaFiles"))
                let __pubLocationHint = scene.WebSceneStateValueForRef(__csgSceneGraph, "locationMessage")
                chengPublish(__pubSelectedMediaPath, __pubKind, __pubLocationHint)
            __csgSceneLastEventApplyStatus = 1
            if !__csg_scene_refresh_effect_dirty_frame(nodeId):
                __csgSceneLastEventApplyStatus = -2
                return -1
            __csgSceneLastTouchHitIndex = -1
            return 1
        if scene.WebSceneStrStartsWith(__pubEffect, "file-picker:"):
            let __pickerRef = __csg_scene_file_picker_ref(__pubEffect)
            let __pickerKind = __csg_scene_file_picker_kind(__pubEffect)
            let __pickerResultMode = __csg_scene_file_picker_result_mode(__pubEffect)
            let __pickerResultStateRef = __csg_scene_file_picker_result_state_ref(__pubEffect)
            if __pickerRef.len == 0 || __pickerKind.len == 0:
                __csgSceneLastEventApplyStatus = -1
                return -1
            chengOpenFilePicker(__pickerRef, __pickerKind, __pickerResultMode, __pickerResultStateRef)
            __csgSceneLastEventApplyStatus = 1
            __csgSceneLastTouchHitIndex = -1
            return 1
        if scene.WebSceneStrStartsWith(__pubEffect, "content_location_open:"):
            let __contentRef = __csg_scene_effect_part_after_prefix(__pubEffect, "content_location_open:", 0)
            if __contentRef.len == 0:
                __csgSceneLastEventApplyStatus = -1
                return -1
            var __contentLocationPayload = scene.WebSceneStateValueForRef(__csgSceneGraph, __contentRef)
            if strutil.Strip(__contentLocationPayload).len == 0:
                __contentLocationPayload = __csg_scene_static_content_location_payload(activeRoute, nodeId)
            let __contentLocationStatus = chengOpenContentLocation(__contentLocationPayload)
            if __contentLocationStatus <= 0:
                __csgSceneLastEventApplyStatus = -1
                return -1
            __csgSceneLastEventApplyStatus = 1
            __csgSceneLastTouchHitIndex = -1
            return 1
        if scene.WebSceneStrStartsWith(__pubEffect, "location_capture:"):
            let __locCaptureStatus = __csg_scene_capture_location_for_segment(__pubEffect)
            if __locCaptureStatus == -2:
                __csgSceneLastEventApplyStatus = -1
                return -1
            __csgSceneLastEventApplyStatus = 1
            if !__csg_scene_refresh_effect_dirty_frame(nodeId):
                __csgSceneLastEventApplyStatus = -2
                return -1
            __csgSceneLastTouchHitIndex = -1
            return 1
        if scene.WebSceneStrStartsWith(__pubEffect, "social_group_create_selected:"):
            scene.WebSceneClearDirty(__csgSceneGraph)
            let __groupStatus = __csg_scene_apply_social_group_create(activeRoute)
            if __groupStatus < 0:
                __csgSceneLastEventApplyStatus = -1
                return -1
            if __groupStatus > 0:
                __csgSceneLastEventApplyStatus = 1
                if !__csg_scene_refresh_effect_dirty_frame(nodeId):
                    __csgSceneLastEventApplyStatus = -2
                    return -1
                __csgSceneLastTouchHitIndex = -1
                return 1
        if scene.WebSceneStrStartsWith(__pubEffect, "synccast_control:") || scene.WebSceneStrStartsWith(__pubEffect, "synccast_refresh:"):
            scene.WebSceneClearDirty(__csgSceneGraph)
            let __synccastStatus = __csg_scene_apply_synccast_effect(__pubEffect)
            if __synccastStatus < 0:
                __csgSceneLastEventApplyStatus = -1
                return -1
            if __synccastStatus > 0:
                __csgSceneLastEventApplyStatus = 1
                if !__csg_scene_refresh_effect_dirty_frame(nodeId):
                    __csgSceneLastEventApplyStatus = -2
                    return -1
                __csgSceneLastTouchHitIndex = -1
                return 1
        if scene.WebSceneStrStartsWith(__pubEffect, "region_policy_refresh:"):
            scene.WebSceneClearDirty(__csgSceneGraph)
            let __regionPolicyStatus = __csg_scene_apply_region_policy_refresh(__pubEffect)
            if __regionPolicyStatus < 0:
