fn __csg_scene_debug_refresh_text_commands(): bool =
    __csgSceneDebugTextCommandWords = []
    __csgSceneDebugTextCommandTextLens = []
    __csgSceneDebugTextCommandSourceIndexes = []
    __csgSceneDebugTextCommandRouteIndex = -1
    __csgSceneDebugTextCommandRefreshStatus = 0
    if !__csg_scene_build():
        __csgSceneDebugTextCommandRefreshStatus = 1
        return false
    let activeRoute = scene.WebSceneActiveRouteIndex(__csgSceneGraph)
    if activeRoute < 0:
        __csgSceneDebugTextCommandRefreshStatus = 2
        return false
    if !__csg_scene_ensure_route_runtime_ready(activeRoute):
        __csgSceneDebugTextCommandRefreshStatus = 3
        return false
    var frame: scene.WebSceneCompositorFrame
    if !scene.WebSceneBuildCompositorFrameForRouteWithFullAtlases(__csgSceneGraph, activeRoute, __csgSceneImageAtlas, __csgSceneSvgAtlas, __csgSceneGlyphAtlas, frame):
        __csgSceneDebugTextCommandRefreshStatus = 4
        return false
    var layerWords: int32[]
    var commandWords: int32[]
    if !scene.WebSceneEncodeCompositorFrameHostBatch(frame, layerWords, commandWords):
        __csgSceneDebugTextCommandRefreshStatus = 5
        return false
    let commandCount = scene.WebSceneCompositorGpuCommandCount(frame)
    if commandWords.len != commandCount * scene.WebSceneGpuHostBatchStrideI32:
        __csgSceneDebugTextCommandRefreshStatus = 6
        return false
    var commandIndex: int32
    while commandIndex < commandCount:
        let base = commandIndex * scene.WebSceneGpuHostBatchStrideI32
        if commandWords[base] == scene.WebSceneGpuFillText:
            var wordOffset: int32
            while wordOffset < scene.WebSceneGpuHostBatchStrideI32:
                add(__csgSceneDebugTextCommandWords, commandWords[base + wordOffset])
                wordOffset = wordOffset + 1
            add(__csgSceneDebugTextCommandTextLens, scene.WebSceneCompositorGpuCommandTextAt(frame, commandIndex).len)
            add(__csgSceneDebugTextCommandSourceIndexes, commandIndex)
        commandIndex = commandIndex + 1
    __csgSceneDebugTextCommandRouteIndex = activeRoute
    return true

