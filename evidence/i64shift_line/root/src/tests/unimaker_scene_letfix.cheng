fn __csg_scene_kv_digit(ch: str): int32 =
    if ch == "0":
        return 0
    if ch == "1":
        return 1
    if ch == "2":
        return 2
    if ch == "3":
        return 3
    if ch == "4":
        return 4
    if ch == "5":
        return 5
    if ch == "6":
        return 6
    if ch == "7":
        return 7
    if ch == "8":
        return 8
    if ch == "9":
        return 9
    return 0 - 1

fn __csg_scene_parse_positive_int(text: str): int32 =
    let n = len(text)
    if n <= 0 || n > 9:
        return 0 - 1
    var value: int32
    var i: int32
    while i < n:
        let digit = __csg_scene_kv_digit(strings.SliceBytes(text, i, 1))
        if digit < 0:
            return 0 - 1
        value = value * 10 + digit
        i = i + 1
    return value

@borrows
@borrow_result
fn __csg_scene_find_kv_value(text: str, marker: str): str =
    let textLen = len(text)
    let markerLen = len(marker)
    var i: int32
    while i + markerLen <= textLen:
        var prevOk = false
        if i == 0:
            prevOk = true
        else:
            let prev = strings.SliceBytes(text, i - 1, 1)
            if prev == "\n" || prev == ";":
                prevOk = true
        if prevOk:
            if strings.SliceBytes(text, i, markerLen) == marker:
                let start = i + markerLen
                var end: int32
                end = start
                while end < textLen:
                    let ch = strings.SliceBytes(text, end, 1)
                    if ch == "\n" || ch == "\r" || ch == ";" || ch == "&":
                        return strings.SliceBytes(text, start, end - start)
                    end = end + 1
                return strings.SliceBytes(text, start, end - start)
        i = i + 1
    return ""

@borrows
@borrow_result
fn __csg_scene_find_route_state_in_kv(text: str): str =
    let marker = "route_state="
    let textLen = len(text)
    let markerLen = len(marker)
    var i: int32
    while i + markerLen <= textLen:
        var prevOk = false
        if i == 0:
            prevOk = true
        else:
            let prev = strings.SliceBytes(text, i - 1, 1)
            if prev == "\n" || prev == ";":
                prevOk = true
        if prevOk:
            if strings.SliceBytes(text, i, markerLen) == marker:
                let start = i + markerLen
                var end: int32
                end = start
                while end < textLen:
                    let ch = strings.SliceBytes(text, end, 1)
                    if ch == "\n" || ch == "\r" || ch == ";" || ch == "&":
                        return strings.SliceBytes(text, start, end - start)
                    end = end + 1
                return strings.SliceBytes(text, start, end - start)
        i = i + 1
    return ""

@borrows
@borrow_result
fn __csg_scene_find_route_state_in_json(text: str): str =
    let marker = "\"route_state\":\""
    let textLen = len(text)
    let markerLen = len(marker)
    var i: int32
    while i + markerLen <= textLen:
        if strings.SliceBytes(text, i, markerLen) == marker:
            let start = i + markerLen
            var end: int32
            end = start
            while end < textLen:
                if strings.SliceBytes(text, end, 1) == "\"":
                    return strings.SliceBytes(text, start, end - start)
                end = end + 1
            return ""
        i = i + 1
    return ""

fn __csg_scene_launch_route_or_default(defaultRoute: str): str =
    if !__csgSceneLaunchArgsSet:
        let ownedDefault: str = defaultRoute
        return ownedDefault
    if __csgSceneLaunchArgsInvalid || len(__csgSceneLaunchRouteState) == 0:
        return ""
    return strFromBytesCopy(StrDataPtr(__csgSceneLaunchRouteState), len(__csgSceneLaunchRouteState))

