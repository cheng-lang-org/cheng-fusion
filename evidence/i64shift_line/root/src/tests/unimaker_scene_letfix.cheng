@importc("cheng_monotime_ns")
fn __asyncHostMonotimeNs(): int64

fn __asyncRecvTryAck(side: int32, streamId: int64, ackLen: int32): int32 =
    return social.WebSceneSocialRecvTryAck(side, streamId, ackLen)

fn __asyncSendSide(): int32 =
    return social.WebSceneSocialSendSide()

fn __asyncSendStream(): int64 =
    return social.WebSceneSocialSendStream()

type ChengAsyncFrame =
    active: bool
    kind: int32
    seg: int32
    deadlineMs: int32
    waitKind: int32
    side: int32
    streamId: int64
    ackLen: int32

var __asyncFrames: ChengAsyncFrame[8]
# Monotonic ms clock: __asyncNowMs = (hostMonotimeNs - baseNs)/1e6, recomputed each pump.
# Integer-ms domain (int32 stores/compares correctly on the cold backend).
var __asyncNowMs: int32
var __asyncBaseNs: int64
var __asyncClockStarted: bool

fn __asyncFrameAlloc(): int32 =
    var i: int32
    i = 0
    while i < 8:
        if !__asyncFrames[i].active:
            return i
        i = i + 1
    return -1

# real wall-clock awaitable: deadline = now + ms, polled by the pump. Allocates a
# free frame for the given handler kind. setTimeout(fn,ms) lowers to this call.
fn __asyncRegisterDeferred(kind: int32, ms: int32) =
    let f = __asyncFrameAlloc()
    if f < 0:
        return
    __asyncFrames[f].kind = kind
    __asyncFrames[f].seg = 1
    __asyncFrames[f].waitKind = 0
    __asyncFrames[f].deadlineMs = __asyncNowMs + ms
    __asyncFrames[f].active = true

fn __asyncRegisterRecvDone(kind: int32, side: int32, streamId: int64, ackLen: int32, timeoutMs: int32) =
    let f = __asyncFrameAlloc()
    if f < 0:
        return
    __asyncFrames[f].kind = kind
    __asyncFrames[f].seg = 1
    __asyncFrames[f].waitKind = 1
    __asyncFrames[f].side = side
    __asyncFrames[f].streamId = streamId
    __asyncFrames[f].ackLen = ackLen
    __asyncFrames[f].deadlineMs = __asyncNowMs + timeoutMs
    __asyncFrames[f].active = true

fn __asyncFrameReady(frameIdx: int32): bool =
    if __asyncFrames[frameIdx].waitKind == 1:
        # real QUIC recv done-signal: the peer's ack frame arrived, OR the ceiling
        # deadline elapsed (honest timeout — never a fake-complete).
        if __asyncRecvTryAck(__asyncFrames[frameIdx].side, __asyncFrames[frameIdx].streamId, __asyncFrames[frameIdx].ackLen) >= 1:
            return true
        return __asyncNowMs >= __asyncFrames[frameIdx].deadlineMs
    return __asyncNowMs >= __asyncFrames[frameIdx].deadlineMs

fn __asyncAnyActive(): bool =
    var i: int32
    i = 0
    while i < 8:
        if __asyncFrames[i].active:
            return true
        i = i + 1
    return false

# resume dispatch: switch on the frame kind, run the handler's deferred effect.
fn __asyncResume(frameIdx: int32) =
    let k = __asyncFrames[frameIdx].kind
    if k == 4:
        chtInline_52d8610721e39bb7bdb174d5__resume()
        return
    if k == 1:
        chtInline_2ad366e8a5abc8919d900ee1__resume()
        return
    if k == 2:
        chtInline_950eec963f409d57fccaa433__resume()
        return
    if k == 3:
        chtInline_a102c7c0f4d93e8fd2b51cb6__resume()
        return
    k

# pump: sample the host monotonic clock into __asyncNowMs (real wall-clock ms),
# resume any frame whose ms deadline is met. Single-threaded render-thread poll.
fn __asyncPump() =
    if !__asyncClockStarted:
        __asyncBaseNs = __asyncHostMonotimeNs()
        __asyncClockStarted = true
    __asyncNowMs = int32((__asyncHostMonotimeNs() - __asyncBaseNs) / int64(1000000))
    var i: int32
    i = 0
    while i < 8:
        if __asyncFrames[i].active:
            if __asyncFrameReady(i):
                __asyncFrames[i].active = false
                __asyncResume(i)
        i = i + 1

@exportc("cheng_app_tick")
fn cheng_app_tick(appId: uint64, deltaTime: float) =
    appId
    deltaTime
    if __csgScenePaused:
        return
    # async continuation pump: sample wall-clock + resume ready frames before any
    # early-return path below can skip the frame.
    __asyncPump()
    __csgSceneM2SyncedInRouteCommit = false
    if __csgScenePendingRouteNode > 0:
        __csgSceneTopApplyStatus = __csg_scene_commit_pending_route()
        if __csgSceneTopApplyStatus < 0:
            __csgSceneLastStatus = 3
            return
    if __csgScenePendingEventNode > 0:
        __csgSceneEventRequestStatus = __csg_scene_commit_pending_event()
        if __csgSceneEventRequestStatus < 0:
            __csgSceneLastStatus = 7
            return
    __csgSceneTickCount = __csgSceneTickCount + 1
    if __csgSceneTickCount % 512 == 0:
        __csg_mobile_host_trace_step(900000 + __csgSceneBuildStep % 100000)
        __csg_mobile_host_trace_step(910000 + __csgSceneNfPrewarm % 10000)
        __csg_mobile_host_trace_step(920000 + __csgSceneNfInk % 10000)
        __csg_mobile_host_trace_step(930000 + __csgSceneNfQi % 10000)
        __csg_mobile_host_trace_step(940000 + __csgSceneNfMedia % 10000)
        __csg_mobile_host_trace_step(950000 + __csgSceneNfUnrendered % 10000)
    # Defer the launch ink until the first home build+present has landed
    # (__csgSceneRendered). The ~1s home build blocks this single render
    # thread, so if the ink launched first it would play, THEN the build
    # would freeze the screen after it (the visible stutter). Building
    # first lets the build run under the Android launch splash; the ink
    # then plays over the ready home with no mid-sequence freeze.
    if __csgSceneInkLaunchRequested && !__csgSceneInkLaunchDone && __csgSceneRendered:
        __csgSceneInkLaunchDone = true
        ink.WebInkOverlayLaunch(__csgSceneViewportWidth, __csgSceneViewportHeight, __csgSceneInkSeed)
    var inkPhase = ink.WebInkOverlayPresentPhaseTake()
    if inkPhase == 0 && __csgSceneRendered:
        inkPhase = ink.WebInkQiPresentPhase()
    if inkPhase == 1 || inkPhase == 3:
        let _inkTicked = ink.WebInkOverlayTick()
        let inkFieldW = ink.WebInkOverlayFieldGridW()
        if inkFieldW > 0:
            __csg_mobile_host_upload_ink_field(ink.WebInkOverlayFieldData(), inkFieldW, ink.WebInkOverlayFieldGridH())
        __csg_mobile_host_set_ink_fade(ink.WebInkOverlayFadePermille())
        __csg_mobile_host_present_overlay_refresh(__csgSceneViewportWidth, __csgSceneViewportHeight)
        return
    if inkPhase == 2:
        let _inkWarmTick = ink.WebInkOverlayTick()
        let inkWarmFieldW = ink.WebInkOverlayFieldGridW()
        if inkWarmFieldW > 0:
            __csg_mobile_host_upload_ink_field(ink.WebInkOverlayFieldData(), inkWarmFieldW, ink.WebInkOverlayFieldGridH())
        __csg_mobile_host_set_ink_fade(ink.WebInkOverlayFadePermille())
    if !__csgSceneM2SyncedInRouteCommit:
        __m2SyncTick()
    __nodesSyncTick()
    if __csgSceneRendered:
        if !scene.WebSceneHasActiveRouteMediaPlayback(__csgSceneGraph):
            # K3 progressive prewarm, heat-ordered: home family first so the
            # routes a user touches in the first seconds are warm immediately
            if __csgScenePrewarmCursor < __csgScenePrewarmLimit:
                # module slots only: cold miscompiles branch-local `let` of a
                # call result and poisons following statements (4th form)
                __csgScenePrewarmRoute = __csg_scene_prewarm_route_at(__csgScenePrewarmCursor)
                __csgScenePrewarmCursor = __csgScenePrewarmCursor + 1
                __csgScenePrewarmOk = __csg_scene_ensure_route_runtime_ready(__csgScenePrewarmRoute)
        return
    if __csgSceneHasPendingTransitionFrame:
        if !__csg_scene_present_transition_frame():
            __csgSceneLastStatus = 4
            return
        __csgSceneLastStatus = 0
        __csgSceneRendered = false
        return
    if __csgSceneHasPendingDirtyFrame:
        if !__csg_scene_present_dirty_frame():
            __csgSceneLastStatus = 5
            return
        __csgSceneLastStatus = 0
        __csgSceneRendered = true
        return
    if !__csg_scene_present_active_route():
        if __csgSceneLastStatus == 0:
            __csgSceneLastStatus = 2
        return
    __csgSceneLastStatus = 0
    __csgSceneRendered = true

@exportc("cheng_app_needs_frame")
# frame-source counters: every needs_frame=1 origin must prove it
# terminates (gui-framework contract); read via debug export 9001..9005
var __csgSceneNfPrewarm: int32
var __csgSceneNfInk: int32
var __csgSceneNfQi: int32
var __csgSceneNfMedia: int32
var __csgSceneNfUnrendered: int32

@exportc("cheng_app_debug_frame_source")
fn cheng_app_debug_frame_source(which: int32): int32 =
    if which == 1:
        return __csgSceneNfPrewarm
    if which == 2:
        return __csgSceneNfInk
    if which == 3:
        return __csgSceneNfQi
    if which == 4:
        return __csgSceneNfMedia
    if which == 5:
        return __csgSceneNfUnrendered
    return -1

fn cheng_app_needs_frame(appId: uint64): int32 =
    appId
    if __csgScenePaused:
        return 0
    if __csgScenePendingRouteNode > 0:
        return 1
    if __csgScenePendingEventNode > 0:
        return 1
    if __asyncAnyActive():
        return 1
    if __csgScenePrewarmCursor < __csgScenePrewarmLimit:
        __csgSceneNfPrewarm = __csgSceneNfPrewarm + 1
        return 1
    if ink.WebInkOverlayActive():
        __csgSceneNfInk = __csgSceneNfInk + 1
        return 1
    if ink.WebInkQiActive():
        __csgSceneNfQi = __csgSceneNfQi + 1
        return 1
    if scene.WebSceneHasActiveRouteMediaPlayback(__csgSceneGraph):
        __csgSceneNfMedia = __csgSceneNfMedia + 1
        return 1
    if __csgSceneMediaPrimeStage == 1:
        # home is up; one more frame to prime the deferred media surfaces
        return 1
    if __csgSceneRendered:
        return 0
    __csgSceneNfUnrendered = __csgSceneNfUnrendered + 1
    return 1

@exportc("cheng_app_on_touch")
fn cheng_app_on_touch(appId: uint64, action: int32, pointerId: int32, x: float, y: float) =
    appId
    action
    pointerId
    x
    y
    panic("cheng_app_on_touch float ABI is disabled for mobile routes; use cheng_app_on_touch_milli")

@exportc("cheng_app_on_touch_milli")
fn cheng_app_on_touch_milli(appId: uint64, action: int32, pointerId: int32, xMilli: int32, yMilli: int32) =
    appId
    pointerId
    if action == 0:
        # Any real interaction owns the render thread now; stop idle prewarm
        # so a background route build cannot queue ahead of user input.
        __csgScenePrewarmCursor = __csgScenePrewarmLimit
        if __csgSceneInkLaunchRequested:
            ink.WebInkQiSpawn(xMilli / 1000, yMilli / 1000)
        # pruned single-pass arbitration (K1): same winner the up will use
        __csg_scene_top_interaction(xMilli, yMilli)
        var downNodeId = __csgSceneTopNode
        if downNodeId < 0:
            __csgSceneLastStatus = 3
            return
        if downNodeId > 0 && __csgSceneTopKind > 0:
            __csgSceneLastActiveNodeId = downNodeId
            let downRoute = scene.WebSceneActiveRouteIndex(__csgSceneGraph)
            if scene.WebSceneNodeHasCssVariantRule(__csgSceneGraph, downRoute, downNodeId):
                # incremental :active — node-scoped variant over the baseline
                if !scene.WebSceneSetNodeInteractionState(__csgSceneGraph, downRoute, downNodeId, false, true, false):
                    __csgSceneLastStatus = 6
                    return
                if !scene.WebSceneApplyCssVariantRulesForNode(__csgSceneGraph, downRoute, downNodeId):
                    __csgSceneLastStatus = 6
                    return
                __csgSceneRendered = false
                __csgSceneLastStatus = 0
        let downEventRoute = scene.WebSceneActiveRouteIndex(__csgSceneGraph)
        var touchStartNodeId: int32
        if downNodeId > 0:
            touchStartNodeId = __csg_scene_event_hit_target_ancestor(downEventRoute, downNodeId, "touchStart")
        else:
            touchStartNodeId = __csg_scene_find_event_hit_target_node(xMilli, yMilli, "touchStart")
        if touchStartNodeId < 0:
            __csgSceneLastStatus = 7
            return
        if touchStartNodeId > 0:
            let touchStartStatus = __csg_scene_apply_pointer_event_to_node(touchStartNodeId, "touchStart", xMilli, yMilli)
            if touchStartStatus < 0:
                __csgSceneLastStatus = 7
                return
            __csgSceneLastStatus = 0
        var pointerDownNodeId: int32
        if downNodeId > 0:
            pointerDownNodeId = __csg_scene_event_hit_target_ancestor(downEventRoute, downNodeId, "pointerDown")
        else:
            pointerDownNodeId = __csg_scene_find_event_hit_target_node(xMilli, yMilli, "pointerDown")
        if pointerDownNodeId < 0:
            __csgSceneLastStatus = 7
            return
        if pointerDownNodeId > 0:
            __csgSceneLastActiveNodeId = pointerDownNodeId
            let pointerDownStatus = __csg_scene_apply_pointer_event_to_node(pointerDownNodeId, "pointerDown", xMilli, yMilli)
            if pointerDownStatus < 0:
                __csgSceneLastStatus = 7
                return
            if pointerDownStatus > 0:
                __csgSceneLastStatus = 0
                return
        return
    if action == 2:
        if __csgSceneInkLaunchRequested:
            ink.WebInkQiOnTouchMove(xMilli / 1000, yMilli / 1000)
        let moveActiveNodeId = __csgSceneLastActiveNodeId
        if moveActiveNodeId > 0:
            let moveRoute = scene.WebSceneActiveRouteIndex(__csgSceneGraph)
            let moveNodeId = __csg_scene_event_hit_target_ancestor(moveRoute, moveActiveNodeId, "pointerMove")
            if moveNodeId < 0:
                __csgSceneLastStatus = 7
                return
            if moveNodeId > 0:
                let pointerMoveStatus = __csg_scene_apply_pointer_event_to_node(moveNodeId, "pointerMove", xMilli, yMilli)
                if pointerMoveStatus < 0:
                    __csgSceneLastStatus = 7
                    return
                if pointerMoveStatus > 0:
                    __csgSceneLastStatus = 0
                    return
        return
    if action == 3:
        if __csgSceneInkLaunchRequested:
            ink.WebInkQiOnTouchEnd()
        let cancelNodeId = __csgSceneLastActiveNodeId
        __csgSceneLastActiveNodeId = -1
        if cancelNodeId > 0:
            let cancelRoute = scene.WebSceneActiveRouteIndex(__csgSceneGraph)
