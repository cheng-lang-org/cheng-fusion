    var l0 = ""
    if idx0 >= 0:
        l0 = __m2ContentLocationLabel(shown[idx0].locationHint, shown[idx0].location.public.country, shown[idx0].location.public.province, shown[idx0].location.public.city, shown[idx0].location.public.district, shown[idx0].location.public.displayLevel)
    var an0 = ""
