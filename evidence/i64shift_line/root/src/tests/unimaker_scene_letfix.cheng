@exportc("cheng_app_debug_box_probe")
fn cheng_app_debug_box_probe(xMilli: int32, yMilli: int32, field: int32): int32 =
    if !__csg_scene_build():
        return -999
    let activeRoute = scene.WebSceneActiveRouteIndex(__csgSceneGraph)
    let boxStart = scene.WebSceneBoxRangeStart(__csgSceneGraph, activeRoute)
    var boxIndex = scene.WebSceneBoxRangeEnd(__csgSceneGraph, activeRoute) - 1
    while boxIndex >= boxStart:
        if __csg_scene_layout_box_contains_point_milli(boxIndex, activeRoute, xMilli, yMilli):
            if !__csg_scene_layout_box_accepts_pointer(activeRoute, boxIndex):
                boxIndex = boxIndex - 1
                continue
            let boxNodeId = __csgSceneGraph.layoutBoxes[boxIndex].nodeId
            if field == 0:
                return boxNodeId
            if field == 1:
                return __csgSceneGraph.layoutBoxes[boxIndex].x
            if field == 2:
                return __csgSceneGraph.layoutBoxes[boxIndex].y
            if field == 3:
                return __csgSceneGraph.layoutBoxes[boxIndex].width
            if field == 4:
                return __csgSceneGraph.layoutBoxes[boxIndex].height
            let eventNode = __csg_scene_event_hit_target_ancestor(activeRoute, boxNodeId, "click")
            let routeNode = __csg_scene_route_hit_target_ancestor(activeRoute, boxNodeId)
            if eventNode != 0 && eventNode != routeNode:
                return eventNode
            if routeNode != 0:
                return routeNode
            if eventNode != 0:
                return eventNode
            return -1
        boxIndex = boxIndex - 1
    return 0

@exportc("cheng_app_debug_node_box")
fn cheng_app_debug_node_box(nodeId: int32, field: int32): int32 =
    if !__csg_scene_build():
        return -999
    let activeRoute = scene.WebSceneActiveRouteIndex(__csgSceneGraph)
    if !__csg_scene_ensure_route_runtime_ready(activeRoute):
        return -998
    if field == 0:
        return scene.WebSceneRuntimeLayoutBoxXForNode(__csgSceneGraph, activeRoute, nodeId)
    if field == 1:
        return scene.WebSceneRuntimeLayoutBoxYForNode(__csgSceneGraph, activeRoute, nodeId)
    if field == 2:
        return scene.WebSceneRuntimeLayoutBoxWidthForNode(__csgSceneGraph, activeRoute, nodeId)
    if field == 3:
        return scene.WebSceneRuntimeLayoutBoxHeightForNode(__csgSceneGraph, activeRoute, nodeId)
    if field == 4:
        # DIAGNOSTIC (2026-07-11 render/hit-test misalignment probe): count how many
        # graph.layoutBoxes entries exist for this node in the active route. >1 means
        # this node was recorded more than once by the layout pass -- paint reads the
        # FIRST such entry (WebLayoutFindBestBoxIndex / WebSceneFindRuntimeLayoutBoxIndex,
        # forward scan) while real touch hit-testing (__csg_scene_top_interaction /
        # cheng_app_debug_box_probe) resolves by point containment, effectively favoring
        # the LAST entry. A duplicate directly explains paint/hit-test divergence.
        var dupCount: int32
        for dupIndex in 0..<__csgSceneGraph.layoutBoxes.len:
            if __csgSceneGraph.layoutBoxes[dupIndex].routeIndex == activeRoute && __csgSceneGraph.layoutBoxes[dupIndex].nodeId == nodeId:
                dupCount = dupCount + 1
        return dupCount
    if field == 5:
        # DIAGNOSTIC: y of the LAST matching graph.layoutBoxes entry (paint-order
        # topmost), i.e. what real point-based hit-testing would resolve to if the
        # touch point falls inside it. Compare against field==1 (forward-first y, what
        # paint currently uses) -- if they differ, that delta is the render offset.
        var lastY: int32 = -2147483647
        for dupIndex in 0..<__csgSceneGraph.layoutBoxes.len:
            if __csgSceneGraph.layoutBoxes[dupIndex].routeIndex == activeRoute && __csgSceneGraph.layoutBoxes[dupIndex].nodeId == nodeId:
                lastY = __csgSceneGraph.layoutBoxes[dupIndex].y
        return lastY
    return 0

