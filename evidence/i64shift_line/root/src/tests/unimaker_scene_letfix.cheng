fn __m2PointInNodePadded(routeIndex: int32, nodeId: int32, xMilli: int32, yMilli: int32, padX: int32, padY: int32): bool =
    if nodeId <= 0:
        return false
    let x = scene.WebSceneRuntimeLayoutBoxXForNode(__csgSceneGraph, routeIndex, nodeId)
    let y = scene.WebSceneRuntimeLayoutBoxYForNode(__csgSceneGraph, routeIndex, nodeId)
    let w = scene.WebSceneRuntimeLayoutBoxWidthForNode(__csgSceneGraph, routeIndex, nodeId)
    let h = scene.WebSceneRuntimeLayoutBoxHeightForNode(__csgSceneGraph, routeIndex, nodeId)
    if w <= 0 || h <= 0 || x <= -2147480000 || y <= -2147480000:
        return false
    let left = (x - padX) * 1000
    let top = (y - padY) * 1000
    let right = (x + w + padX) * 1000
    let bottom = (y + h + padY) * 1000
    return xMilli >= left && xMilli < right && yMilli >= top && yMilli < bottom


