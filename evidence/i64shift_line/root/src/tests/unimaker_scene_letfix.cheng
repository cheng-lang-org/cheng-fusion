fn __csg_scene_keyboard_view_restore_pan() =
    if __csgSceneKeyboardContentPan == 0:
        return
    let route = __csgSceneKeyboardPanRoute
    let cl = scene.WebSceneContentLayerId(route)
    let ox = scene.WebSceneLayerOffsetX(__csgSceneGraph, route, cl)
    let oy = scene.WebSceneLayerOffsetY(__csgSceneGraph, route, cl)
    let restored = scene.WebSceneSetLayerOffset(__csgSceneGraph, route, cl, ox, oy + __csgSceneKeyboardContentPan)
    if restored:
        __csgSceneKeyboardContentPan = 0
        __csgSceneKeyboardPanRoute = -1

fn __csg_scene_clear_text_input_focus() =
    __csg_scene_keyboard_view_restore_pan()
    __csgSceneFocusedTextRouteIndex = -1
    __csgSceneFocusedTextNodeId = -1
    __csgSceneFocusedTextReplayRouteIndex = -1
    __csgSceneFocusedTextReplayNodeId = -1
    __csgSceneFocusedTextReplayValue = ""

fn __csg_scene_keyboard_inset_parse(valueText: str): int32 =
    var parsed: int32
    var index: int32
    while index < valueText.len:
        let ch = valueText[index]
        if ch < '0' || ch > '9':
            return 0
        parsed = parsed * 10 + (int32(ch) - int32('0'))
        index = index + 1
    return parsed

fn __csg_scene_lift_focused_for_inset(insetLogical: int32) =
    __csg_scene_keyboard_view_restore_pan()
    if insetLogical <= 0:
        return
    if __csgSceneFocusedTextNodeId <= 0:
        return
    let routeIndex = scene.WebSceneActiveRouteIndex(__csgSceneGraph)
    if routeIndex != __csgSceneFocusedTextRouteIndex:
        return
    let layerId = scene.WebSceneFindNodeLayerId(__csgSceneGraph, __csgSceneFocusedTextNodeId)
    if layerId != scene.WebSceneContentLayerId(routeIndex):
        return
    let boxY = scene.WebSceneRuntimeLayoutBoxYForNode(__csgSceneGraph, routeIndex, __csgSceneFocusedTextNodeId)
    let boxHeight = scene.WebSceneRuntimeLayoutBoxHeightForNode(__csgSceneGraph, routeIndex, __csgSceneFocusedTextNodeId)
    if boxHeight < 0 || boxY <= -2147483647:
        return
    let scrollY = scene.WebSceneRouteContentScrollY(__csgSceneGraph, routeIndex)
    let viewportHeight = scene.WebSceneCurrentViewportHeight(__csgSceneGraph)
    let visibleBottom = viewportHeight - insetLogical
    if visibleBottom <= 0:
        return
    let screenBottom = boxY + boxHeight - scrollY
    if screenBottom <= visibleBottom:
        return
    let nextScrollY = scrollY + (screenBottom - visibleBottom) + 8
    let scrollMax = scene.WebSceneRouteContentScrollMax(__csgSceneGraph, routeIndex)
    if nextScrollY <= scrollMax:
        if !scene.WebSceneSetContentScrollY(__csgSceneGraph, routeIndex, nextScrollY):
            return
        return
    if !scene.WebSceneSetContentScrollY(__csgSceneGraph, routeIndex, scrollMax):
        return
    let overPan = nextScrollY - scrollMax
    let cl = scene.WebSceneContentLayerId(routeIndex)
    let cx = scene.WebSceneLayerOffsetX(__csgSceneGraph, routeIndex, cl)
    let cy = scene.WebSceneLayerOffsetY(__csgSceneGraph, routeIndex, cl)
    if scene.WebSceneSetLayerOffset(__csgSceneGraph, routeIndex, cl, cx, cy - overPan):
        __csgSceneKeyboardContentPan = overPan
        __csgSceneKeyboardPanRoute = routeIndex

fn __csg_scene_scroll_focused_into_keyboard_view(valueText: str) =
    let insetLogical = __csg_scene_keyboard_inset_parse(valueText)
    __csgSceneKeyboardInsetActive = insetLogical
    __csg_scene_lift_focused_for_inset(insetLogical)

