fn __csg_scene_viewport_width(): int32 =
    if __csgSceneViewportWidth <= 0:
        return 390
    return __csgSceneViewportWidth

fn __csg_scene_viewport_height(): int32 =
    if __csgSceneViewportHeight <= 0:
        return 844
    return __csgSceneViewportHeight

fn __csg_scene_invalidate_viewport_runtime(): bool =
    __csgSceneRouteRuntimeReady = []
    __csgSceneRouteRuntimeStateVersions = []
    __csgSceneRendered = false
    __csgSceneHasPendingTransitionFrame = false
    __csgSceneHasPendingDirtyFrame = false
    scene.WebSceneCompositorFrameInit(__csgSceneTransitionFrame)
    scene.WebSceneCompositorFrameInit(__csgSceneDirtyFrame)
    if __csgSceneInitialized:
        if !scene.WebSceneInvalidateAllLayerCaches(__csgSceneGraph):
            return false
    return true

