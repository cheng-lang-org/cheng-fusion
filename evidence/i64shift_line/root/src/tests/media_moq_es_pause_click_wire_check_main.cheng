# Runtime verification for the CLICK-DISPATCH wiring slice of
# docs/video-seek-scrub-blueprint.md (§7.4/§S8 "暂停不停流"): closes the gap the pause
# backpressure gateway commit (webSceneMediaEsPaused + WebSceneMediaEsSetPaused/Paused in
# web_scene_media_network_bridge.cheng) left open on purpose — that gateway had ZERO
# production callers ("compiled: 替代通路零生产者" per the blueprint). The wiring this test
# proves: __cht_video_sync_es_pause (added to the CHT chengVideoPlay/chengVideoPause/
# chengVideoPlaySlot/chengVideoPauseSlot bridges in
# ts-csg/scripts/scene-runtime-smoke-source.mjs) calls WebSceneMediaEsSetPaused right after
# scene.WebSceneApplyMediaControl(..., "Play"|"Pause") succeeds — the SAME two production
# functions the generated __cht_video_apply_control calls, in the SAME order, gated by the
# SAME success check (SetPaused is only reached when the state-machine transition actually
# happened, exactly like the generated code — never called on a rejected/no-op control).
#
# This test does not re-drive DOM hit-testing / __cht_apply's effect-string dispatch (that
# generic CSG click→handler plumbing predates this slice and is exercised elsewhere,
# unchanged by it); it drives the two real halves this slice actually connects — the
# scene media state machine and the ES network gateway — through the literal call sequence
# __cht_video_apply_control performs, against a real QUIC client and a real
# media_moq_publisher_main process (no mocked network, no faked gate), so "pump went silent"
# is proven by independent, pause-unaware oracles: the sink's own capture counter and the S4
# block cache's own Get() miss/hit (same methodology as
# media_moq_es_pause_backpressure_check_main.cheng, which proved the gateway itself; this
# test proves the click reaches it).
#
# Asserts, in order (mirrors one video card's real interaction: tap once from closed/paused
# state, tap again to pause, tap a third time to resume):
#   1. WebSceneMediaEsOpen succeeds against the real publisher; scene graph media slot starts
#      Closed (module + fixture load state sanity, matches a freshly opened content-detail
#      card before the first tap).
#   2. CLICK 1 ("播放" tap on a closed slot): scene.WebSceneApplyMediaControl(slotId, "Play")
#      correctly REJECTS (closed-state guard, same branch __cht_video_apply_control's
#      fallback exists for) — proves the test fixture reproduces the real guard, not a
#      fabricated always-succeeds stub. The fallback OpenAsset+Play sequence then succeeds
#      (playbackState -> Playing) and the mirrored sync call leaves the pump UNPAUSED
#      (WebSceneMediaEsPaused()==false) — an unpaused StreamLoop tick dials and delivers.
#   3. CLICK 2 ("暂停" tap): scene.WebSceneApplyMediaControl(slotId, "Pause") succeeds
#      (playbackState -> Paused) and the mirrored sync call flips WebSceneMediaEsSetPaused
#      TRUE — the click-dispatch SetPaused flip.
#   4. Pump silence: a StreamLoop tick after click 2 returns 8 and leaves the sink's captured
#      count AND pump cursor unchanged (no dial, no fetch); a PrefetchTick call returns 4 and
#      the target GOP stays an independent cache miss — the click's Pause reached the pump.
#   5. CLICK 3 ("播放" tap, resume): scene.WebSceneApplyMediaControl(slotId, "Play") succeeds
#      from Paused (not Closed, so the primary branch — not the OpenAsset fallback — fires)
#      and the mirrored sync call flips WebSceneMediaEsSetPaused back to FALSE.
#   6. Resume continuity ("游标不脏"): a StreamLoop tick after click 3 delivers (rc==0, sink
#      captured increments) from the SAME dialed port as click 1 (WebSceneMediaEsDialedPort
#      unchanged — no redial, no cursor reset) and a PrefetchTick call now actually fetches
#      (rc==1) with the target GOP becoming a real cache hit matching the independent python
#      oracle byte length — contrast with step 4 proves click 2's pause, not a pre-existing
#      miss, was why nothing was cached in between.
# Any failure prints a reason and exits nonzero; success prints "ALL OK" and exits 0.

import std/os
import std/rawbytes
import std/strutils as strutil
import std/cmdline as cmdline
import cheng/core/runtime/web_scene_runtime as scene
import cheng/core/runtime/web_scene_media_network_bridge as media_bridge
import cheng/core/runtime/web_scene_media_block_cache as blockcache

@importc("cheng_test_es_sink_first_frame_idx")
fn chengTestEsSinkFirstFrameIdx(): int32

@importc("cheng_test_es_sink_captured")
fn chengTestEsSinkCaptured(): int32

fn fail(msg: str): int32 =
    os.WriteLine(os.Get_stdout(), strutil.Join(["FAIL: ", msg], ""))
    return 1

# Mirrors ts-csg/scripts/scene-runtime-smoke-source.mjs's generated
# __cht_video_sync_es_pause(actionKind): the exact glue this slice added to the CHT video
# bridges. Real assertions call the two real production functions (scene.WebSceneApplyMediaControl,
# media_bridge.WebSceneMediaEsSetPaused) directly below in the same gated order — this helper
# is inlined at each call site rather than abstracted, so the test reads as the same sequence
# a click produces.
fn main(): int32 =
    var hostRaw: str
    let hasHost: bool = cmdline.ReadFirstFlagValue("--host", hostRaw)
    let host: str = if hasHost: hostRaw else: "127.0.0.1"
    let port: int32 = cmdline.ReadInt32FlagOrDefault("--port", 38000)
    var rootRaw: str
    let hasRoot: bool = cmdline.ReadFirstFlagValue("--root", rootRaw)
    if !hasRoot:
        return fail("missing --root")
    # GOP 60 (not 120) is the real target here: WebSceneMediaEsPrefetchTick scans forward
    # from currentGopStart+1 for the NEXT flagged keyframe (web_scene_media_network_bridge
    # .cheng:1049-1055), not a fixed frame-count stride, and the real `maitian` fixture's
    # keyframe table is [0,60,120,180,240,300] (60-frame GOPs, count=333, fps=60 — see
    # docs/video-seek-scrub-blueprint.md §1.1's own independently-measured table for this
    # exact asset). From a fresh cursor=0 the first keyframe strictly ahead is 60, so that
    # is the GOP the pump actually fetches — not 120. oracleGopLen=288606 is that GOP's
    # real byte length, independently computed + cross-checked against a from-scratch
    # binary parse (byte-identical fixture, sha256 137a100c...d7874fd) by
    # src/tests/moqidx_oracle_dump_main.cheng (prints `gop startFrame=60 offset=310161
    # len=288606`, run under artifacts/backend_driver/cheng — a separate toolchain from the
    # stage3 compiler this checker itself runs under). The prior targetGop=120/
    # oracleGopLen=946127 pair was copy-pasted from a DIFFERENT, older fixture
    # (f6eb23a7e's 675-frame/30fps/120-frame-GOP asset) and never updated for the real
    # `maitian` asset this test actually serves — a test-oracle drift, not a production
    # regression (WebSceneMediaEsPrefetchTick's own scan logic is unchanged since f6eb23a7e).
    let targetGop: int32 = 60
    let oracleGopLen: int32 = 288606
    let slotId: str = "click.wire.slot.video"

    if !blockcache.WebSceneMediaBlockCacheInit(rootRaw):
        return fail(strutil.Join(["Init(root) failed: ", rootRaw], ""))

    # --- Step 1: open ES + build a minimal real scene graph media slot (Closed). ---
    if !media_bridge.WebSceneMediaEsOpen(host, port):
        return fail(strutil.Join(["es_open failed: ", media_bridge.WebSceneMediaEsLastError()], ""))
    let assetCid: str = media_bridge.WebSceneMediaEsAssetCid()
    if assetCid.len == 0:
        return fail("asset_cid empty after open")
    let dialedPortAfterOpen: int32 = media_bridge.WebSceneMediaEsDialedPort()

    var graph: scene.WebSceneGraph
    scene.WebSceneGraphInit(graph)
    if !scene.WebSceneAddRouteExpectedIndex(graph, "click_wire_content_detail", 1, 1, 0):
        return fail("WebSceneAddRouteExpectedIndex failed")
    if !scene.WebSceneAddLayer(graph, 0, 1, "content", 0):
        return fail("WebSceneAddLayer failed")
    if !scene.WebSceneAddNode(graph, 0, 1, 0, 2, "div", "", 1):
        return fail("WebSceneAddNode(root) failed")
    if !scene.WebSceneAddNode(graph, 0, 2, 1, 2, "video", "", 1):
        return fail("WebSceneAddNode(video) failed")

    var asset: scene.WebSceneMediaAsset
    asset.assetFactId = "click.wire.asset.video"
    asset.assetCid = "cid-click-wire-video"
    asset.bundleCid = "bundle-click-wire-video"
    asset.mime = "video/mp4"
    asset.kindCode = 1
    asset.durationMs = "12000"
    asset.codec = "avc1.64001f"
    asset.posterCid = "poster-click-wire-video"
    asset.initSegmentCid = "init-click-wire-video"
    asset.initSegmentByteLength = 65536
    asset.keyframeIndex = "0:0,2400:98304"
    asset.transport = "moq"
    asset.fecScheme = "raptorq-v1"
    asset.contentSignature = "sig-click-wire-video"
    asset.catalogCid = "catalog-click-wire-video"
    asset.catalogKey = "click-wire/catalog"
    asset.rebuildTemplateCid = "rebuild-click-wire-video"
    asset.rebuildTemplateKey = "click-wire/rebuild"
    asset.objectTargetBytes = 262144
    asset.sourceBlockBytes = 65536
    asset.objectCount = 2
    asset.dropletCount = 3
    if !scene.WebSceneAddMediaAsset(graph, asset):
        return fail("WebSceneAddMediaAsset failed")

    var slot: scene.WebSceneMediaPlaybackSlot
    slot.slotId = slotId
    slot.assetFactId = "click.wire.asset.video"
    slot.assetCid = "cid-click-wire-video"
    slot.manifestCid = "manifest-click-wire-video"
    slot.nodeTemplate = "csg.web.scene.node.0.2"
    slot.routeIndex = 0
    slot.nodeId = 2
    slot.providerKind = "media-decode-provider"
    slot.stateRef = "media:click.wire.slot.video"
    slot.decodeProvider = "macos-videotoolbox-codec-provider"
    slot.textureProvider = "metal-surface-texture-provider"
    slot.audioProvider = "macos-coreaudio-provider"
    slot.objectFit = "cover"
    if !scene.WebSceneAddMediaPlaybackSlot(graph, slot):
        return fail("WebSceneAddMediaPlaybackSlot failed")
    if scene.WebSceneMediaSlotPlaybackState(graph, slotId) != scene.WebSceneMediaPlaybackClosed:
        return fail("fixture slot did not start Closed")

    var control: scene.WebSceneMediaControlAction
    control.slotId = slotId
    control.payloadSchema = "unimaker.media.lifecycle.runtime.v1"
    control.dispatch = "event-queue"
    control.guard = "assetCid:cid-click-wire-video"
    control.trace = "trace.click-wire.open"
    control.actionKind = "OpenAsset"
    if !scene.WebSceneAddMediaControlAction(graph, control):
        return fail("AddMediaControlAction(OpenAsset) failed")
    control.actionKind = "Play"
    control.trace = "trace.click-wire.play"
    if !scene.WebSceneAddMediaControlAction(graph, control):
        return fail("AddMediaControlAction(Play) failed")
    control.actionKind = "Pause"
    control.trace = "trace.click-wire.pause"
    if !scene.WebSceneAddMediaControlAction(graph, control):
        return fail("AddMediaControlAction(Pause) failed")
    os.WriteLine(os.Get_stdout(), "step1_open_and_fixture_ok")

    # --- Step 2: CLICK 1 — tap "播放" on a closed slot (cold start, matches
    # __cht_video_apply_control's OpenAsset-fallback branch), then the mirrored sync call. ---
    if scene.WebSceneApplyMediaControl(graph, slotId, "Play"):
        return fail("Play from Closed unexpectedly succeeded (fixture does not reproduce the real guard)")
    if !scene.WebSceneApplyMediaControl(graph, slotId, "OpenAsset"):
        return fail("fallback OpenAsset failed")
    if !scene.WebSceneApplyMediaControl(graph, slotId, "Play"):
        return fail("fallback Play failed")
    if scene.WebSceneMediaSlotPlaybackState(graph, slotId) != scene.WebSceneMediaPlaybackPlaying:
        return fail("slot state did not reach Playing after click 1")
    media_bridge.WebSceneMediaEsSetPaused(false)
    if media_bridge.WebSceneMediaEsPaused():
        return fail("click 1 (Play) left the pump paused")
    let click1LoopRc: int32 = media_bridge.WebSceneMediaEsStreamLoop()
    if click1LoopRc != 0:
        return fail(strutil.Join(["click1 StreamLoop unexpected rc=", IntToStr(click1LoopRc)], ""))
    if chengTestEsSinkCaptured() != 1:
        return fail(strutil.Join(["click1 captured=", IntToStr(chengTestEsSinkCaptured()), " want=1"], ""))
    if chengTestEsSinkFirstFrameIdx() != 0:
        return fail(strutil.Join(["click1 first frameIdx=", IntToStr(chengTestEsSinkFirstFrameIdx()), " want=0"], ""))
    let cursorAfterClick1: int32 = media_bridge.WebSceneMediaEsPumpCursor()
    os.WriteLine(os.Get_stdout(), "step2_click1_play_from_closed_ok")

    # --- Step 3: CLICK 2 — tap "暂停" (SetPaused flip). ---
    if !scene.WebSceneApplyMediaControl(graph, slotId, "Pause"):
        return fail("Pause from Playing failed")
    if scene.WebSceneMediaSlotPlaybackState(graph, slotId) != scene.WebSceneMediaPlaybackPaused:
        return fail("slot state did not reach Paused after click 2")
    media_bridge.WebSceneMediaEsSetPaused(true)
    if !media_bridge.WebSceneMediaEsPaused():
        return fail("click 2 (Pause) did not flip WebSceneMediaEsPaused() to true")
    os.WriteLine(os.Get_stdout(), "step3_click2_pause_setpaused_true_ok")

    # --- Step 4: pump silence while paused (independent witnesses). ---
    let pausedLoopRc: int32 = media_bridge.WebSceneMediaEsStreamLoop()
    if pausedLoopRc != 8:
        return fail(strutil.Join(["paused StreamLoop rc=", IntToStr(pausedLoopRc), " want=8"], ""))
    if chengTestEsSinkCaptured() != 1:
        return fail(strutil.Join(["paused StreamLoop changed sink captured to ",
                                   IntToStr(chengTestEsSinkCaptured()), " want=1 (unchanged)"], ""))
    if media_bridge.WebSceneMediaEsPumpCursor() != cursorAfterClick1:
        return fail(strutil.Join(["paused StreamLoop moved cursor: got=", IntToStr(media_bridge.WebSceneMediaEsPumpCursor()),
                                   " want=", IntToStr(cursorAfterClick1)], ""))
    let pausedPrefetchRc: int32 = media_bridge.WebSceneMediaEsPrefetchTick(8)
    if pausedPrefetchRc != 4:
        return fail(strutil.Join(["paused PrefetchTick rc=", IntToStr(pausedPrefetchRc), " want=4"], ""))
    let missDuringPause = blockcache.WebSceneMediaBlockCacheGet(assetCid, targetGop)
    if IsOk(missDuringPause):
        return fail(strutil.Join(["paused PrefetchTick wrote cache for GOP ", IntToStr(targetGop),
                                   " — should have been a no-op"], ""))
    os.WriteLine(os.Get_stdout(), "step4_pump_silent_while_paused_ok")

    # --- Step 5: CLICK 3 — tap "播放" again to resume (SetPaused flips back). ---
    if !scene.WebSceneApplyMediaControl(graph, slotId, "Play"):
        return fail("Play from Paused failed")
    if scene.WebSceneMediaSlotPlaybackState(graph, slotId) != scene.WebSceneMediaPlaybackPlaying:
        return fail("slot state did not return to Playing after click 3")
    media_bridge.WebSceneMediaEsSetPaused(false)
    if media_bridge.WebSceneMediaEsPaused():
        return fail("click 3 (Play) did not flip WebSceneMediaEsPaused() back to false")
    os.WriteLine(os.Get_stdout(), "step5_click3_resume_setpaused_false_ok")

    # --- Step 6: resume continuity — same connection, no cursor reset ("游标不脏"). ---
    let resumeLoopRc: int32 = media_bridge.WebSceneMediaEsStreamLoop()
    if resumeLoopRc != 0:
        return fail(strutil.Join(["resume StreamLoop unexpected rc=", IntToStr(resumeLoopRc)], ""))
    if chengTestEsSinkCaptured() != 2:
        return fail(strutil.Join(["resume StreamLoop sink captured=", IntToStr(chengTestEsSinkCaptured()), " want=2"], ""))
    if media_bridge.WebSceneMediaEsDialedPort() != dialedPortAfterOpen:
        return fail(strutil.Join(["resume redialed a different port: got=", IntToStr(media_bridge.WebSceneMediaEsDialedPort()),
                                   " want=", IntToStr(dialedPortAfterOpen)], ""))
    let resumePrefetchRc: int32 = media_bridge.WebSceneMediaEsPrefetchTick(8)
    if resumePrefetchRc != 1:
        return fail(strutil.Join(["resume PrefetchTick rc=", IntToStr(resumePrefetchRc), " want=1"], ""))
    let hitAfterResume = blockcache.WebSceneMediaBlockCacheGet(assetCid, targetGop)
    if IsErr(hitAfterResume):
        return fail(strutil.Join(["resume PrefetchTick did not cache GOP ", IntToStr(targetGop), ": ", Error(hitAfterResume)], ""))
    let gotLen: int32 = BytesLen(Value(hitAfterResume))
    if gotLen != oracleGopLen:
        return fail(strutil.Join(["GOP ", IntToStr(targetGop), " byte length mismatch: got=", IntToStr(gotLen),
                                   " oracle=", IntToStr(oracleGopLen)], ""))
    os.WriteLine(os.Get_stdout(), "step6_resume_continuity_ok")

    os.WriteLine(os.Get_stdout(), "ALL OK")
    return 0
