# web_canvas_to_blob_png_smoke.cheng
# Runtime proof for the canvas.toBlob PNG encoder substrate.
# Structural self-validation (signature / IHDR / chunk CRCs / stored-block
# decompression / adler32 / pixel round-trip) + hex dump for the external
# zlib oracle in the harness command.
import std/rawbytes
import std/strutils as strutil
import cheng/core/runtime/web_canvas_export_runtime as canvaspng

fn smokeFail(label: str): int32 =
    echo(strutil.Join(["canvas png smoke failed: ", label], ""))
    return 1

fn main(): int32 =
    let width: int32 = 3
    let height: int32 = 2
    let stride: int32 = width * 4
    var px: rawbytes.Bytes = rawbytes.BytesAlloc(width * height * 4)
    # distinct byte pattern incl. 0x00 and 0xFF edges
    var i: int32 = 0
    while i < px.len:
        rawbytes.BytesSet(px, i, (i * 37 + 11) & 255)
        i = i + 1

    var png: rawbytes.Bytes = canvaspng.WebCanvasToBlobPng(width, height, px)
    let rowStride: int32 = stride + 1
    let rawLen: int32 = height * rowStride
    let nBlocks: int32 = ((rawLen - 1) / 65535) + 1
    let zlen: int32 = 2 + nBlocks * 5 + rawLen + 4
    let expectTotal: int32 = 8 + 25 + (12 + zlen) + 12
    if png.len != expectTotal:
        return smokeFail("total length")
    if rawbytes.BytesGet(png, 0) != 0x89 || rawbytes.BytesGet(png, 1) != 0x50:
        return smokeFail("signature")

    # IHDR fields
    if rawbytes.BytesGet(png, 16) != 0 || rawbytes.BytesGet(png, 20) != 0:
        return smokeFail("dims high bytes")
    if rawbytes.BytesGet(png, 24) != 8 || rawbytes.BytesGet(png, 25) != 6:
        return smokeFail("bit depth / color type")
    let ihdrCrc: uint32 = canvaspng.PngCrc32Range(png, 12, 29)
    if rawbytes.BytesGet(png, 29) != Int32((ihdrCrc >> 24) & UInt32(255)):
        return smokeFail("IHDR crc")

    # IDAT crc over type+payload
    let idatCrcPos: int32 = 37 + zlen + 4
    let idatCrc: uint32 = canvaspng.PngCrc32Range(png, 37, idatCrcPos)
    if rawbytes.BytesGet(png, idatCrcPos) != Int32((idatCrc >> 24) & UInt32(255)):
        return smokeFail("IDAT crc")

    # walk stored blocks, reassemble logical stream, verify adler + pixels
    var adlerA: uint32 = UInt32(1)
    var adlerB: uint32 = UInt32(0)
    var logical: int32 = 0
    var src: int32 = 43
    while logical < rawLen:
        let header: int32 = rawbytes.BytesGet(png, src)
        let lenLo: int32 = rawbytes.BytesGet(png, src + 1)
        let lenHi: int32 = rawbytes.BytesGet(png, src + 2)
        let nlenLo: int32 = rawbytes.BytesGet(png, src + 3)
        let nlenHi: int32 = rawbytes.BytesGet(png, src + 4)
        let take: int32 = lenLo + lenHi * 256
        let nlen: int32 = nlenLo + nlenHi * 256
        if (65535 - take) != nlen:
            return smokeFail("stored NLEN complement")
        let isFinal: int32 = logical + take >= rawLen
        if header != isFinal:
            return smokeFail("stored block final bit")
        src = src + 5
        var k: int32 = 0
        while k < take:
            let row: int32 = logical / rowStride
            let off: int32 = logical % rowStride
            let v: int32 = rawbytes.BytesGet(png, src)
            if off == 0:
                if v != 0:
                    return smokeFail("filter byte nonzero")
            else:
                if v != rawbytes.BytesGet(px, row * stride + off - 1):
                    return smokeFail("pixel round-trip")
            adlerA = (adlerA + UInt32(v)) % UInt32(65521)
            adlerB = (adlerB + adlerA) % UInt32(65521)
            src = src + 1
            logical = logical + 1
            k = k + 1
    let storedAdler: int32 = (rawbytes.BytesGet(png, src) << 24) | (rawbytes.BytesGet(png, src + 1) << 16) | (rawbytes.BytesGet(png, src + 2) << 8) | rawbytes.BytesGet(png, src + 3)
    let adlerExpect: uint32 = (adlerB << 16) | adlerA
    if storedAdler != Int32(adlerExpect):
        return smokeFail("adler32")

    # IEND crc
    let iendTypePos: int32 = idatCrcPos + 4 + 4
    let iendCrc: uint32 = canvaspng.PngCrc32Range(png, iendTypePos, iendTypePos + 4)
    if rawbytes.BytesGet(png, iendTypePos + 4) != Int32((iendCrc >> 24) & UInt32(255)):
        return smokeFail("IEND crc")

    # mismatched pixel buffer must hard-fail to empty
    var short: rawbytes.Bytes = rawbytes.BytesAlloc(4)
    var bad: rawbytes.Bytes = canvaspng.WebCanvasToBlobPng(width, height, short)
    if bad.len != 0:
        return smokeFail("mismatched rgba must return empty")

    # hex dump for the external zlib oracle
    var hex: str = ""
    i = 0
    while i < png.len:
        let b: int32 = rawbytes.BytesGet(png, i)
        let hi: int32 = (b >> 4) & 15
        let lo: int32 = b & 15
        var h1: str = "0"
        var h2: str = "0"
        if hi == 10:
            h1 = "a"
        if hi == 11:
            h1 = "b"
        if hi == 12:
            h1 = "c"
        if hi == 13:
            h1 = "d"
        if hi == 14:
            h1 = "e"
        if hi == 15:
            h1 = "f"
        if lo == 10:
            h2 = "a"
        if lo == 11:
            h2 = "b"
        if lo == 12:
            h2 = "c"
        if lo == 13:
            h2 = "d"
        if lo == 14:
            h2 = "e"
        if lo == 15:
            h2 = "f"
        if hi < 10:
            h1 = IntToStr(hi)
        if lo < 10:
            h2 = IntToStr(lo)
        hex = ConcatStr(hex, ConcatStr(h1, h2))
        i = i + 1
    echo(ConcatStr("PNGHEX:", hex))
    echo("canvas png smoke ok")
    return 0
