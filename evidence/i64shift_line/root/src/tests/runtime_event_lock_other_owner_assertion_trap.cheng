import std/thread

@importc("cheng_host_pipe_runtime")
fn cheng_host_pipe_runtime(fds: var int32[2]): int32

@importc("cheng_host_read_runtime")
fn cheng_host_read_runtime(
    fd: int32,
    data: var uint8,
    count: int32): int64

@importc("cheng_host_write_runtime")
fn cheng_host_write_runtime(
    fd: int32,
    data: var uint8,
    count: int32): int64

@importc("cheng_native_runtime_event_lock_bridge")
fn runtimeEventLock(): void

@importc("cheng_native_runtime_event_assert_owner_bridge")
fn runtimeEventAssertOwner(): void

@importc("cheng_native_runtime_event_unlock_bridge")
fn runtimeEventUnlock(): void

type
    OtherOwnerAssertionCtx =
        heldPipe: int32[2]
        releasePipe: int32[2]

var otherOwnerAssertionCtx: OtherOwnerAssertionCtx

fn eventWrite(fd: int32) =
    var token: uint8 = uint8(1)
    assert(cheng_host_write_runtime(fd, token, 1) == int64(1),
           " runtime event lock other-owner: event write")

fn eventRead(fd: int32) =
    var token: uint8
    assert(cheng_host_read_runtime(fd, token, 1) == int64(1),
           " runtime event lock other-owner: event read")
    assert(token == uint8(1),
           " runtime event lock other-owner: event token")

fn OtherOwnerAssertionHolder() =
    runtimeEventLock()
    runtimeEventAssertOwner()
    eventWrite(otherOwnerAssertionCtx.heldPipe[1])
    eventRead(otherOwnerAssertionCtx.releasePipe[0])
    runtimeEventUnlock()

fn main(): int32 =
    assert(cheng_host_pipe_runtime(otherOwnerAssertionCtx.heldPipe) == 0,
           " runtime event lock other-owner: held pipe")
    assert(cheng_host_pipe_runtime(otherOwnerAssertionCtx.releasePipe) == 0,
           " runtime event lock other-owner: release pipe")

    let holder = thread.StartFn(OtherOwnerAssertionHolder)
    eventRead(otherOwnerAssertionCtx.heldPipe[0])
    runtimeEventAssertOwner()
    eventWrite(otherOwnerAssertionCtx.releasePipe[1])
    let _ = thread.JoinThread(holder)
    return 91
