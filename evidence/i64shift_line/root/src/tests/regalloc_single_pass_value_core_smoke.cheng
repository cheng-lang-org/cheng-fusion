import cheng/core/ir/core_types as ir
import cheng/core/backend/regalloc_single_pass as alloc
import cheng/std/bytes_layout as layout

fn newBody(): ir.BodyIR =
    let parsed = layout.FixedBytes32FromHex(
        "7777777777777777777777777777777777777777777777777777777777777777")
    assert(parsed.ok, " regalloc value core: TypeArena CID fixture invalid")
    var body = ir.BodyIRNew()
    assert(ir.BodyIRBindTypeArenaArtifactCid(body, parsed.value),
           " regalloc value core: TypeArena CID binding failed")
    return body

fn makeI32Slot(id: int32, parameter: bool): ir.LocalSlot =
    var slot: ir.LocalSlot
    slot.id = id
    slot.name = "value"
    slot.typeKind = ir.LocalI32Tag
    slot.stackOffset = 16 + id * 8
    if parameter:
        slot.stackOffset = -1
    slot.sizeBytes = 4
    slot.alignBytes = 4
    ir.BodyIRApplyLocalSlotDefaultProof(slot)
    return slot

fn appendCopy(body: var ir.BodyIR, target: int32, source: int32) =
    var op: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = ir.BodyOpCopyLocalTag
    op.target = target
    add(op.operands, source)
    add(body.ops, op)

fn appendCall(body: var ir.BodyIR,
              resultSlot: int32,
              argSlot: int32) =
    var call: ir.CallOp
    ir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = "regalloc_call_target"
    call.resultSlot = resultSlot
    call.resultPassKind = ir.BodyCallPassStackValueTag
    call.relocWordOffset = -1
    add(call.argSlots, argSlot)
    add(call.argPassKinds, ir.BodyCallPassStackValueTag)
    add(call.argAbiSizes, 4)
    add(body.callSequence, call)
    var op: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = ir.BodyOpCallTag
    op.target = resultSlot
    add(op.operands, body.callSequence.len - 1)
    add(body.ops, op)

fn appendReturn(body: var ir.BodyIR, slotIndex: int32): int32 =
    var term: ir.BodyTerm
    ir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = slotIndex
    add(term.operands, ir.LocalI32Tag)
    return ir.BodyIRAppendTerm(body, term)

fn buildCrossCallBody(): ir.BodyIR =
    var body = newBody()
    add(body.localSlots, makeI32Slot(0, true))
    add(body.localSlots, makeI32Slot(1, false))
    appendCall(body, 1, 0)
    let returnTerm = appendReturn(body, 0)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, returnTerm)
    return body

fn buildPressureBody(): ir.BodyIR =
    var body = newBody()
    add(body.localSlots, makeI32Slot(0, true))
    add(body.localSlots, makeI32Slot(1, true))
    add(body.localSlots, makeI32Slot(2, false))
    add(body.localSlots, makeI32Slot(3, false))
    appendCopy(body, 2, 1)
    appendCopy(body, 3, 2)
    let returnTerm = appendReturn(body, 0)
    let _ = ir.BodyIRAppendBlock(body, 0, 2, returnTerm)
    return body

fn callerOnlyConstraints(): alloc.RegallocTargetConstraints =
    var out = alloc.RegallocTargetConstraintsInit()
    add(out.registerUniverse, 0)
    add(out.registerUniverse, 1)
    add(out.allocatableCallerRegs, 1)
    add(out.reservedRegs, 0)
    add(out.callClobberRegs, 0)
    add(out.callClobberRegs, 1)
    add(out.fixedArgRegs, 0)
    out.fixedResultReg = 0
    out.fixedReturnReg = 0
    add(out.gprTypeKinds, ir.LocalI32Tag)
    add(out.gprTypeKinds, ir.LocalPtrTag)
    add(out.gprTypeKinds, ir.LocalI64Tag)
    return out

fn contains(values: var int32[], expected: int32): bool =
    for i in 0..<values.len:
        if values[i] == expected:
            return true
    return false

fn actionIndex(plan: var alloc.RegallocSinglePassValuePlan,
               kind: int32): int32 =
    for i in 0..<plan.actions.len:
        if plan.actions[i].kind == kind:
            return i
    return -1

fn proofHash(): str =
    return "1111111111111111111111111111111111111111111111111111111111111111"

fn emptyProofHash(): str =
    return "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"

fn consumePlan(plan: var alloc.RegallocSinglePassValuePlan,
               symbolName: str): bool =
    if !alloc.RegallocSinglePassValuePlanBeginEmissionSymbol(
           plan, symbolName, 0,
           (plan.actions.len + 1) * 4):
        return false
    for ordinal in 0..<plan.actions.len:
        var action: alloc.RegallocValueAction
        var ticket: alloc.RegallocValueActionTicket
        if !alloc.RegallocSinglePassValuePlanActionAt(
               plan, ordinal, action, ticket) ||
           action.consumerOrdinal != ordinal:
            return false
        let bindingKind =
            alloc.RegallocSinglePassValueActionBindingKind(action.kind)
        var acked: bool
        if bindingKind == alloc.RegallocValueBindingStructural:
            acked = alloc.RegallocSinglePassValuePlanAck(
                plan, ticket, 0, 0, emptyProofHash())
        else:
            acked = alloc.RegallocSinglePassValuePlanAck(
                plan, ticket, ordinal * 4, 4, proofHash())
        if !acked || !alloc.RegallocSinglePassValuePlanValidate(plan):
            return false
    return alloc.RegallocSinglePassValuePlanSealEmissionSymbol(
               plan, proofHash()) &&
           alloc.RegallocSinglePassValuePlanFinalize(plan) &&
           alloc.RegallocSinglePassValuePlanValidate(plan)

fn testA64Constraints(): int32 =
    let constraints = alloc.RegallocTargetConstraintsA64Darwin()
    if constraints.registerUniverse.len != 31 ||
       constraints.registerUniverse[0] != 0 ||
       constraints.registerUniverse[30] != 30:
        return 11
    for reg in 0..<constraints.registerUniverse.len:
        if constraints.registerUniverse[reg] != reg:
            return 11
    if constraints.allocatableCallerRegs.len != 7 ||
       constraints.allocatableCallerRegs[0] != 9 ||
       constraints.allocatableCallerRegs[6] != 15:
        return 12
    if constraints.allocatableCalleeRegs.len != 4 ||
       constraints.allocatableCalleeRegs[0] != 19 ||
       constraints.allocatableCalleeRegs[3] != 22:
        return 13
    if constraints.fixedArgRegs.len != 8 ||
       constraints.fixedResultReg != 0 ||
       constraints.fixedSretReg != 8 ||
       constraints.sretShiftsFixedArgs ||
       constraints.fixedReturnReg != 0 ||
       !contains(constraints.reservedRegs, 18) ||
       !contains(constraints.reservedRegs, 29) ||
       !contains(constraints.callClobberRegs, 30):
        return 14
    return 0

fn testX64LinuxConstraints(): int32 =
    let constraints = alloc.RegallocTargetConstraintsX64Linux()
    if constraints.registerUniverse.len != 16 ||
       constraints.allocatableCallerRegs.len != 1 ||
       constraints.allocatableCallerRegs[0] != 10 ||
       constraints.allocatableCalleeRegs.len != 5 ||
       constraints.allocatableCalleeRegs[0] != 3 ||
       constraints.allocatableCalleeRegs[4] != 15 ||
       constraints.fixedArgRegs.len != 6 ||
       constraints.fixedArgRegs[0] != 7 ||
       constraints.fixedArgRegs[1] != 6 ||
       constraints.fixedArgRegs[2] != 2 ||
       constraints.fixedArgRegs[3] != 1 ||
       constraints.fixedArgRegs[4] != 8 ||
       constraints.fixedArgRegs[5] != 9 ||
       constraints.fixedResultReg != 0 ||
       constraints.fixedSretReg != 7 ||
       !constraints.sretShiftsFixedArgs ||
       constraints.fixedReturnReg != 0 ||
       constraints.parallelCopyScratchReg != 11 ||
       constraints.packedStackArgs ||
       !contains(constraints.reservedRegs, 4) ||
       !contains(constraints.reservedRegs, 11) ||
       !contains(constraints.callClobberRegs, 10):
        return 15
    return 0

fn testCalleeSavedCrossCall(): int32 =
    var body = buildCrossCallBody()
    var constraints = alloc.RegallocTargetConstraintsA64Darwin()
    var first = alloc.RegallocSinglePassValuePlanBuildDecoded(
        body, constraints)
    var second = alloc.RegallocSinglePassValuePlanBuildDecoded(
        body, constraints)
    if !first.valid || !first.frozen ||
       !alloc.RegallocSinglePassValuePlanValidate(first) ||
       !alloc.RegallocSinglePassValuePlanEquivalent(first, second):
        return 21
    if first.valueAssignedRegs.len <= 0 ||
       first.valueAssignedRegs[0] != 19 ||
       (first.usedCalleeMask & (int64(1) << 19)) == 0:
        return 22
    if actionIndex(first, alloc.RegallocValueActionSpillCall) >= 0 ||
       actionIndex(first, alloc.RegallocValueActionReloadCall) >= 0:
        return 23
    if !consumePlan(first, "callee_saved_cross_call"):
        return 25
    return 0

fn testCallerSavedSpillReload(): int32 =
    var body = buildCrossCallBody()
    var constraints = callerOnlyConstraints()
    var plan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        body, constraints)
    if !plan.valid || !plan.frozen ||
       !alloc.RegallocSinglePassValuePlanValidate(plan):
        return 31
    let spillIndex = actionIndex(plan, alloc.RegallocValueActionSpillCall)
    let reloadIndex = actionIndex(plan, alloc.RegallocValueActionReloadCall)
    if spillIndex < 0 || reloadIndex <= spillIndex ||
       plan.actions[reloadIndex].relatedActionOrdinal != spillIndex ||
       plan.actions[spillIndex].sourceReg != 1 ||
       plan.actions[reloadIndex].targetReg != 1:
        return 32
    plan.actions[reloadIndex].relatedActionOrdinal = -1
    if alloc.RegallocSinglePassValuePlanValidate(plan) || plan.valid ||
       plan.errorCode != alloc.RegallocValuePlanErrorActionShape:
        return 33
    return 0

fn testTemporarySpillReload(): int32 =
    var body = buildPressureBody()
    var constraints = callerOnlyConstraints()
    var plan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        body, constraints)
    if !plan.valid || !plan.frozen ||
       !alloc.RegallocSinglePassValuePlanValidate(plan):
        return 41
    let spillIndex = actionIndex(
        plan, alloc.RegallocValueActionSpillTemporary)
    let restoreIndex = actionIndex(
        plan, alloc.RegallocValueActionRestoreTemporary)
    if spillIndex < 0 || restoreIndex <= spillIndex ||
       plan.actions[restoreIndex].relatedActionOrdinal != spillIndex ||
       actionIndex(plan, alloc.RegallocValueActionReloadOperand) < 0 ||
       actionIndex(plan, alloc.RegallocValueActionStoreDef) < 0:
        return 42
    return 0

fn testFixedConstraintHardFails(): int32 =
    var body = buildCrossCallBody()
    var overlap = alloc.RegallocTargetConstraintsA64Darwin()
    overlap.fixedSretReg = 0
    var overlapPlan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        body, overlap)
    if overlapPlan.valid ||
       overlapPlan.errorCode != alloc.RegallocValuePlanErrorFixedConflict:
        return 51
    var uncategorized = alloc.RegallocTargetConstraintsInit()
    add(uncategorized.registerUniverse, 5)
    uncategorized.fixedReturnReg = 5
    add(uncategorized.gprTypeKinds, ir.LocalI32Tag)
    var uncategorizedPlan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        body, uncategorized)
    if uncategorizedPlan.valid ||
       uncategorizedPlan.errorCode !=
           alloc.RegallocValuePlanErrorConstraintShape:
        return 52
    var fixedArgAllocatable =
        alloc.RegallocTargetConstraintsA64Darwin()
    fixedArgAllocatable.fixedArgRegs[0] = 9
    var fixedArgPlan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        body, fixedArgAllocatable)
    if fixedArgPlan.valid ||
       fixedArgPlan.errorCode != alloc.RegallocValuePlanErrorFixedConflict:
        return 53
    var fixedResultAllocatable =
        alloc.RegallocTargetConstraintsA64Darwin()
    fixedResultAllocatable.fixedResultReg = 9
    var fixedResultPlan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        body, fixedResultAllocatable)
    if fixedResultPlan.valid ||
       fixedResultPlan.errorCode != alloc.RegallocValuePlanErrorFixedConflict:
        return 54
    return 0

fn testCanonicalLayoutAuthority(): int32 =
    var body = buildCrossCallBody()
    if !alloc.RegallocSinglePassBodyIrCanonicalIngressValid(body):
        return 61
    body.localSlots[0].sizeBytes = 8
    if alloc.RegallocSinglePassBodyIrCanonicalIngressValid(body):
        return 62
    body = buildCrossCallBody()
    body.localSlots[0].alignBytes = 8
    if alloc.RegallocSinglePassBodyIrCanonicalIngressValid(body):
        return 63
    body = buildCrossCallBody()
    body.localSlots[0].id = 1
    if alloc.RegallocSinglePassBodyIrCanonicalIngressValid(body):
        return 64
    body = buildCrossCallBody()
    body.localSlots[0].typeKind = ir.LocalAggregateTag
    body.localSlots[0].sizeBytes = 16
    body.localSlots[0].alignBytes = 8
    if !alloc.RegallocSinglePassBodyIrCanonicalIngressValid(body):
        return 65
    body.localSlots[0].sizeBytes = 18
    if alloc.RegallocSinglePassBodyIrCanonicalIngressValid(body):
        return 66
    body = buildCrossCallBody()
    body.localSlots[0].typeKind = ir.LocalStrTag
    body.localSlots[0].sizeBytes = 24
    body.localSlots[0].alignBytes = 8
    if !alloc.RegallocSinglePassBodyIrCanonicalIngressValid(body):
        return 67
    body.localSlots[0].sizeBytes = 16
    if alloc.RegallocSinglePassBodyIrCanonicalIngressValid(body):
        return 68
    return 0

fn main(): int32 =
    let aarch64Code = testA64Constraints()
    if aarch64Code != 0:
        return aarch64Code
    let x8664Code = testX64LinuxConstraints()
    if x8664Code != 0:
        return x8664Code
    let calleeCode = testCalleeSavedCrossCall()
    if calleeCode != 0:
        return calleeCode
    let callerCode = testCallerSavedSpillReload()
    if callerCode != 0:
        return callerCode
    let temporaryCode = testTemporarySpillReload()
    if temporaryCode != 0:
        return temporaryCode
    let fixedCode = testFixedConstraintHardFails()
    if fixedCode != 0:
        return fixedCode
    return testCanonicalLayoutAuthority()
