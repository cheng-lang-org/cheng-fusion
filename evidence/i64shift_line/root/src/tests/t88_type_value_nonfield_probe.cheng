# Namespace resolution negative probe: once named-field syntax resolves the
# head to an object type, an unknown field is a hard error. The same-named
# value declaration must not receive this call as a fallback.

type
    Pair =
        left: int32
        right: int32

fn Pair(value: int32): int32 =
    return value + 40

fn main(): int32 =
    let valueCall = Pair(value: 2)
    if valueCall != 42:
        return 1
    return 0
