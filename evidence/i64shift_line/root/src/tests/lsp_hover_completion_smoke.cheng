# Hover/completion wire smoke. Exact SymbolId lookup, scope visibility and
# compiler type facts are covered by the semantic-snapshot LSP gate.

import std/os
import cheng/core/tooling/lsp_protocol as lsp

fn AssertCompletionKind(kind: lsp.CompletionItemKind,
                        expected: int32,
                        label: str) =
    let item = lsp.LspMakeCompletionItem(
        label, kind, "compiler-owned", "", "", "", label)
    assert(int32(item.kind) == expected && item.label == label &&
           item.detail == "compiler-owned" && item.insertText == label,
           Fmt"lsp hover completion: wire item drift for {label}")

fn main() =
    AssertCompletionKind(lsp.CikFunction, 3, "FunctionSymbol")
    AssertCompletionKind(lsp.CikField, 5, "FieldSymbol")
    AssertCompletionKind(lsp.CikVariable, 6, "VariableSymbol")
    AssertCompletionKind(lsp.CikModule, 9, "ModuleSymbol")
    AssertCompletionKind(lsp.CikConstant, 21, "ConstantSymbol")
    AssertCompletionKind(lsp.CikStruct, 22, "TypeSymbol")
    os.WriteLine(os.Get_stdout(), "lsp_hover_completion_smoke: ok")
