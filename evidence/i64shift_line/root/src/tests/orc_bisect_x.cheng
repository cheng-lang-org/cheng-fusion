# ORC bisect X: which argument shape triggers the exit-time crash?
#   X1 local-str arg into Err[T]() constructor across return
#   X2 borrow-expression arg (r.err.msg) into Err[T]()
#   X3 inline construction, single function, heap str

import std/os
import std/system
import std/rawbytes
import std/result
import std/strings as strings

fn MakeFromLocal(s: str): Result[bool] =
    return Err[bool](s)

fn MakeInline(): Result[bool] =
    let own = strings.CloneStr("inline boom")
    return Err[bool](own)

fn ReadMissing(): Result[Bytes] =
    return os.ReadFileBytesResult("/tmp/orc_x_missing.bin")

fn main(): int32 =
    let mode = os.GetEnv("ORC_X_MODE")
    if mode == "X1":
        let s = strings.CloneStr("local boom")
        let r = MakeFromLocal(s)
        if !r.ok:
            os.WriteLine(os.Get_stderr(), "X1 err held")
        echo("X1 done")
        return 0
    if mode == "X2":
        let rr = ReadMissing()
        if !rr.ok:
            let r2 = MakeFromLocal(rr.err.msg)
            if !r2.ok:
                os.WriteLine(os.Get_stderr(), "X2 err held")
        echo("X2 done")
        return 0
    if mode == "X3":
        let r3 = MakeInline()
        if !r3.ok:
            os.WriteLine(os.Get_stderr(), "X3 err held")
        echo("X3 done")
        return 0
    echo("no mode")
    return 0
