import cheng/core/lang/parser

fn Rejects(source: str): bool =
    var declarations: parser.NormalizedFunctionDecl[]
    var err: str
    return !parser.ParserReadNormalizedFunctionDecls(
        source, declarations, err)

fn main(): int32 =
    let validSource = """
@manual_consume(target=target, source=source)
fn Commit(target: var int32[], source: int32[]): int32 =
    return source.len
"""
    var declarations: parser.NormalizedFunctionDecl[]
    var err: str
    assert(parser.ParserReadNormalizedFunctionDecls(
               validSource, declarations, err),
           Fmt"manual consume positive parse failed: {err}")
    assert(declarations.len == 1,
           "manual consume positive declaration count")
    let declaration = declarations[0]
    assert(declaration.manualConsumePresent,
           "manual consume effect missing")
    assert(declaration.manualConsumeFunctionDeclarationRow >= 0,
           "manual consume function declaration row missing")
    assert(declaration.manualConsumeTargetParameterOrdinal == 0 &&
           declaration.manualConsumeSourceParameterOrdinal == 1,
           "manual consume parameter ordinal mismatch")
    assert(declaration.manualConsumeTargetParameterDeclarationRow >= 0 &&
           declaration.manualConsumeSourceParameterDeclarationRow >= 0 &&
           declaration.manualConsumeTargetParameterDeclarationRow !=
               declaration.manualConsumeSourceParameterDeclarationRow,
           "manual consume parameter declaration identity mismatch")
    assert(parser.ParserNormalizedFunctionManualConsumeIdentityValid(
               declaration),
           "manual consume identity digest invalid")
    let flags = parser.ParserNormalizedFunctionAnnotationFlags(declaration)
    assert(flags == parser.ParserFunctionAnnotationManualConsume &&
           parser.ParserNormalizedFunctionAnnotationFlagsValid(flags),
           "manual consume annotation flags invalid")

    assert(Rejects("""
@manual_consume(target=target)
fn Missing(target: var int32[], source: int32[]): int32 =
    return source.len
"""), "manual consume missing key survived")
    assert(Rejects("""
@manual_consume(target=target, target=source)
fn Duplicate(target: var int32[], source: int32[]): int32 =
    return source.len
"""), "manual consume duplicate key survived")
    assert(Rejects("""
@manual_consume(source=source, target=target)
fn Swapped(target: var int32[], source: int32[]): int32 =
    return source.len
"""), "manual consume key order swap survived")
    assert(Rejects("""
@manual_consume(target=target, source=target)
fn Self(target: var int32[], source: int32[]): int32 =
    return source.len
"""), "manual consume same formal survived")
    assert(Rejects("""
@manual_consume(target=target, other=source)
fn UnknownKey(target: var int32[], source: int32[]): int32 =
    return source.len
"""), "manual consume unknown key survived")
    assert(Rejects("""
@manual_consume(target="target", source=source)
fn NonIdentifier(target: var int32[], source: int32[]): int32 =
    return source.len
"""), "manual consume non-identifier survived")
    assert(Rejects("""
@manual_consume(target=target, source=missing)
fn MissingFormal(target: var int32[], source: int32[]): int32 =
    return source.len
"""), "manual consume missing formal survived")
    assert(Rejects("""
@manual_consume(target=target, source=source)
@manual_consume(target=target, source=source)
fn DuplicateEffect(target: var int32[], source: int32[]): int32 =
    return source.len
"""), "manual consume duplicate effect survived")
    assert(Rejects("""
@manual_consumes(target=target, source=source)
fn UnknownAnnotation(target: var int32[], source: int32[]): int32 =
    return source.len
"""), "manual consume unknown annotation survived")
    assert(Rejects("""
@borrows
@manual_consume(target=target, source=source)
fn BorrowThenConsume(target: var int32[], source: int32[]): int32 =
    return source.len
"""), "manual consume after borrows survived")
    assert(Rejects("""
@manual_consume(target=target, source=source)
@borrows
fn ConsumeThenBorrow(target: var int32[], source: int32[]): int32 =
    return source.len
"""), "borrows after manual consume survived")

    var mutated = declaration
    let functionDeclarationRow =
        mutated.manualConsumeFunctionDeclarationRow
    mutated.manualConsumeFunctionDeclarationRow =
        functionDeclarationRow + 1
    assert(!parser.ParserNormalizedFunctionManualConsumeIdentityValid(
               mutated),
           "manual consume wrong owner row survived")
    mutated.manualConsumeFunctionDeclarationRow = functionDeclarationRow
    let targetParameterDeclarationRow =
        mutated.manualConsumeTargetParameterDeclarationRow
    mutated.manualConsumeTargetParameterDeclarationRow =
        targetParameterDeclarationRow + 1
    assert(!parser.ParserNormalizedFunctionManualConsumeIdentityValid(
               mutated),
           "manual consume wrong parameter row survived")
    mutated.manualConsumeTargetParameterDeclarationRow =
        targetParameterDeclarationRow
    let targetParameterOrdinal =
        mutated.manualConsumeTargetParameterOrdinal
    mutated.manualConsumeTargetParameterOrdinal =
        targetParameterOrdinal + 1
    assert(!parser.ParserNormalizedFunctionManualConsumeIdentityValid(
               mutated),
           "manual consume wrong ordinal survived")
    mutated.manualConsumeTargetParameterOrdinal = targetParameterOrdinal
    mutated.manualConsumePresent = false
    assert(!parser.ParserNormalizedFunctionManualConsumeIdentityValid(
               mutated),
           "manual consume deleted effect survived")

    echo("parser_manual_consume_positive=1")
    echo("parser_manual_consume_surface_mutations_rejected=11")
    echo("parser_manual_consume_identity_mutations_rejected=4")
    echo("parser_manual_consume_annotation_smoke: ok")
    return 0
