import cheng/moq/moq_fountain as mf
import std/rawbytes
import std/times
import std/os as os

fn main(): int32 =
    let payload = BytesAlloc(1024)
    var droplets: mf.MoqFountainDroplet[]
    droplets = []
    let t0 = times.MonotimeMs()
    var i: int32
    for i in i..<5750:
        var indexes: int32[]
        indexes = []
        add(indexes, i)
        let key = mf.MoqFountainSourceDropletKey("bundlecid-bundlecid-bundlecid-bundlecid-bundlecid-bundlecid-01234567", 3, i)
        let cid = mf.MoqFountainSha256HexBytes(payload)
        let droplet = mf.MoqFountainDroplet(objectIndex: 3,
                                            dropletIndex: i,
                                            kindCode: 1,
                                            key: key,
                                            peerId: "peer-x",
                                            cid: cid,
                                            degree: 1,
                                            blockIndexes: indexes,
                                            payload: payload)
        add(droplets, droplet)
    let t1 = times.MonotimeMs()
    os.WriteFile("/tmp/droplet_bench.txt", IntToStr(t1 - t0))
    return droplets.len - 5750
