import std/os as os
import std/rawbytes
import cheng/core/csg_core/json_canonical as canonical

@borrows
fn smokeFail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

fn expectCanonical(input: str, expected: str, message: str): int32 =
    let result = canonical.CsgCoreJsonCanonicalize(input)
    if !result.ok:
        os.WriteLine(os.Get_stderr(), result.error)
        return smokeFail(message)
    if result.value != expected:
        os.WriteLine(os.Get_stderr(), result.value)
        return smokeFail(message)
    return 0

fn expectSame(left: str, right: str, message: str): int32 =
    let a = canonical.CsgCoreJsonCanonicalize(left)
    if !a.ok:
        os.WriteLine(os.Get_stderr(), a.error)
        return smokeFail(message)
    let b = canonical.CsgCoreJsonCanonicalize(right)
    if !b.ok:
        os.WriteLine(os.Get_stderr(), b.error)
        return smokeFail(message)
    if a.value != b.value:
        os.WriteLine(os.Get_stderr(), a.value)
        os.WriteLine(os.Get_stderr(), b.value)
        return smokeFail(message)
    return 0

fn expectFails(input: str, message: str): int32 =
    let result = canonical.CsgCoreJsonCanonicalize(input)
    if result.ok:
        return smokeFail(message)
    return 0

fn expectError(input: str, expected: str, message: str): int32 =
    let result = canonical.CsgCoreJsonCanonicalize(input)
    if result.ok || result.error != expected:
        if result.error.len > 0:
            os.WriteLine(os.Get_stderr(), result.error)
        return smokeFail(message)
    return 0

@borrows
fn invalidUtf8Json(bytes: int32[]): str =
    var out = rawbytes.BytesAlloc(bytes.len + 8)
    let prefix = rawbytes.BytesFromString("{\"s\":\"")
    let suffix = rawbytes.BytesFromString("\"}")
    rawbytes.BytesCopyRangeInto(
        out, 0, prefix, 0, rawbytes.BytesLen(prefix))
    for i in 0..<bytes.len:
        rawbytes.BytesSet(out, 6 + i, bytes[i])
    rawbytes.BytesCopyRangeInto(
        out, 6 + bytes.len,
        suffix, 0, rawbytes.BytesLen(suffix))
    let text = rawbytes.BytesToString(out)
    if text.len != bytes.len + 8:
        rawbytes.BytesFree(out)
        panic("json_smoke_invalid_utf8_text_allocation_failed")
    rawbytes.BytesFree(out)
    return text

@borrows
fn expectInvalidUtf8(bytes: int32[], message: str): int32 =
    let result =
        canonical.CsgCoreJsonCanonicalize(
            invalidUtf8Json(bytes))
    if result.ok || result.error != "invalid_utf8":
        if result.error.len > 0:
            os.WriteLine(os.Get_stderr(), result.error)
        return smokeFail(message)
    return 0

@borrows
fn expectValidUtf8(bytes: int32[], message: str): int32 =
    let input = invalidUtf8Json(bytes)
    let result = canonical.CsgCoreJsonCanonicalize(input)
    if !result.ok || result.value != input:
        if result.error.len > 0:
            os.WriteLine(os.Get_stderr(), result.error)
        return smokeFail(message)
    return 0

fn nestedArray(depth: int32): str =
    var bytes = rawbytes.BytesAlloc(depth + depth + 1)
    for i in 0..<depth:
        rawbytes.BytesSet(bytes, i, int32('['))
    rawbytes.BytesSet(bytes, depth, int32('0'))
    for i in 0..<depth:
        rawbytes.BytesSet(bytes, depth + 1 + i, int32(']'))
    let out = rawbytes.BytesToString(bytes)
    if out.len != depth + depth + 1:
        rawbytes.BytesFree(bytes)
        panic("json_smoke_nested_array_allocation_failed")
    rawbytes.BytesFree(bytes)
    return out

fn flatArray(count: int32): str =
    var bytes = rawbytes.BytesAlloc(count + count + 1)
    rawbytes.BytesSet(bytes, 0, int32('['))
    for i in 0..<count:
        rawbytes.BytesSet(bytes, 1 + i + i, int32('0'))
        if i + 1 < count:
            rawbytes.BytesSet(bytes, 2 + i + i, int32(','))
    rawbytes.BytesSet(bytes, count + count, int32(']'))
    let out = rawbytes.BytesToString(bytes)
    if out.len != count + count + 1:
        rawbytes.BytesFree(bytes)
        panic("json_smoke_flat_array_allocation_failed")
    rawbytes.BytesFree(bytes)
    return out

@borrows
fn textWithBytes(
        prefixText: str,
        middle: int32[],
        suffixText: str): str =
    let total = prefixText.len + middle.len + suffixText.len
    var out = rawbytes.BytesAlloc(total)
    let prefix = rawbytes.BytesFromString(prefixText)
    let suffix = rawbytes.BytesFromString(suffixText)
    rawbytes.BytesCopyRangeInto(
        out, 0, prefix, 0, rawbytes.BytesLen(prefix))
    for i in 0..<middle.len:
        rawbytes.BytesSet(out, prefixText.len + i, middle[i])
    rawbytes.BytesCopyRangeInto(
        out,
        prefixText.len + middle.len,
        suffix,
        0,
        rawbytes.BytesLen(suffix))
    let text = rawbytes.BytesToString(out)
    if text.len != total:
        rawbytes.BytesFree(out)
        panic("json_smoke_text_with_bytes_allocation_failed")
    rawbytes.BytesFree(out)
    return text

fn repeatedByte(value: int32, count: int32): str =
    var bytes = rawbytes.BytesAlloc(count)
    for i in 0..<count:
        rawbytes.BytesSet(bytes, i, value)
    let out = rawbytes.BytesToString(bytes)
    if out.len != count:
        rawbytes.BytesFree(bytes)
        panic("json_smoke_repeated_byte_allocation_failed")
    rawbytes.BytesFree(bytes)
    return out

@borrows
fn expectQuote(input: str, expected: str, message: str): int32 =
    let result = canonical.CsgCoreJsonQuoteChecked(input)
    if !result.ok:
        os.WriteLine(os.Get_stderr(), result.error)
        return smokeFail(message)
    if result.value != expected:
        os.WriteLine(os.Get_stderr(), result.value)
        return smokeFail(message)
    return 0

@borrows
fn expectQuoteError(
        input: str,
        expected: str,
        message: str): int32 =
    let result = canonical.CsgCoreJsonQuoteChecked(input)
    if result.ok || result.error != expected:
        if result.error.len > 0:
            os.WriteLine(os.Get_stderr(), result.error)
        return smokeFail(message)
    return 0

@borrows
fn expectIdempotent(input: str, message: str): int32 =
    let first = canonical.CsgCoreJsonCanonicalize(input)
    if !first.ok:
        os.WriteLine(os.Get_stderr(), first.error)
        return smokeFail(message)
    let second = canonical.CsgCoreJsonCanonicalize(first.value)
    if !second.ok || second.value != first.value:
        if second.error.len > 0:
            os.WriteLine(os.Get_stderr(), second.error)
        return smokeFail(message)
    return 0

fn expectDenseQuote(): int32 =
    let source = repeatedByte(0, 8192)
    let quoted = canonical.CsgCoreJsonQuoteChecked(source)
    if !quoted.ok || quoted.value.len != 49154:
        if quoted.error.len > 0:
            os.WriteLine(os.Get_stderr(), quoted.error)
        return smokeFail("dense control quote mismatch")
    let canonicalized =
        canonical.CsgCoreJsonCanonicalize(quoted.value)
    if !canonicalized.ok || canonicalized.value != quoted.value:
        if canonicalized.error.len > 0:
            os.WriteLine(os.Get_stderr(), canonicalized.error)
        return smokeFail("dense control quote was not canonical")
    return 0

fn quotedRepeatedByte(value: int32, count: int32): str =
    if count < 0 || count > 2147483645:
        panic("json_smoke_quoted_repeated_byte_size_invalid")
    var bytes = rawbytes.BytesAlloc(count + 2)
    rawbytes.BytesSet(bytes, 0, int32('"'))
    for i in 0..<count:
        rawbytes.BytesSet(bytes, i + 1, value)
    rawbytes.BytesSet(bytes, count + 1, int32('"'))
    let out = rawbytes.BytesToString(bytes)
    if out.len != count + 2:
        rawbytes.BytesFree(bytes)
        panic("json_smoke_quoted_repeated_byte_allocation_failed")
    rawbytes.BytesFree(bytes)
    return out

fn expectInputLimitSuccess(): int32 =
    let limit = canonical.CsgCoreJsonInputByteLimit()
    let input =
        quotedRepeatedByte(int32('a'), limit - 2)
    let result = canonical.CsgCoreJsonCanonicalize(input)
    if !result.ok || result.value.len != limit:
        if result.error.len > 0:
            os.WriteLine(os.Get_stderr(), result.error)
        return smokeFail("JSON input limit rejected exact maximum")
    return 0

fn expectInputLimitFailure(): int32 =
    let input =
        repeatedByte(
            0,
            canonical.CsgCoreJsonInputByteLimit() + 1)
    let result = canonical.CsgCoreJsonCanonicalize(input)
    if result.ok || result.error != "json_input_too_large":
        if result.error.len > 0:
            os.WriteLine(os.Get_stderr(), result.error)
        return smokeFail("JSON input limit accepted maximum plus one")
    return 0

fn expectNumberLimit(): int32 =
    let limit = canonical.CsgCoreJsonNumberByteLimit()
    let maximum = repeatedByte(int32('1'), limit)
    let accepted = canonical.CsgCoreJsonCanonicalize(maximum)
    if !accepted.ok:
        os.WriteLine(os.Get_stderr(), accepted.error)
        return smokeFail("JSON number limit rejected exact maximum")
    let oversized = repeatedByte(int32('1'), limit + 1)
    let rejected = canonical.CsgCoreJsonCanonicalize(oversized)
    if rejected.ok || rejected.error != "json_number_too_long":
        if rejected.error.len > 0:
            os.WriteLine(os.Get_stderr(), rejected.error)
        return smokeFail("JSON number limit accepted maximum plus one")
    return 0

fn expectOutputLimitSuccess(): int32 =
    let limit = canonical.CsgCoreJsonOutputByteLimit()
    let count = (limit - 2) / 6
    let source = repeatedByte(0, count)
    let result = canonical.CsgCoreJsonQuoteChecked(source)
    if !result.ok || result.value.len != 2 + count * 6:
        if result.error.len > 0:
            os.WriteLine(os.Get_stderr(), result.error)
        return smokeFail("JSON output limit rejected maximum escaped string")
    return 0

fn expectOutputLimitFailure(): int32 =
    let limit = canonical.CsgCoreJsonOutputByteLimit()
    let count = (limit - 2) / 6 + 1
    let source = repeatedByte(0, count)
    let result = canonical.CsgCoreJsonQuoteChecked(source)
    if result.ok || result.error != "json_output_limit_exceeded":
        if result.error.len > 0:
            os.WriteLine(os.Get_stderr(), result.error)
        return smokeFail("JSON output limit accepted escaped overflow")
    return 0

fn main(): int32 =
    if expectSame("{\"b\":2,\"a\":1}", "{\"a\":1,\"b\":2}", "field order canonical mismatch") != 0:
        return 1
    if expectCanonical("{\"z\":{\"b\":2,\"a\":1},\"a\":0}", "{\"a\":0,\"z\":{\"a\":1,\"b\":2}}", "nested object canonical mismatch") != 0:
        return 1
    if expectCanonical("{\"a\":[3,1,2]}", "{\"a\":[3,1,2]}", "array order changed") != 0:
        return 1
    if expectCanonical("{\"s\":\"a\\\"b\\\\c\\/d\\ne\\rf\\t\"}", "{\"s\":\"a\\\"b\\\\c/d\\ne\\rf\\t\"}", "string escape canonical mismatch") != 0:
        return 1
    if expectCanonical("{\"s\":\"\\b\\f\"}", "{\"s\":\"\\b\\f\"}", "backspace/form-feed escape mismatch") != 0:
        return 1
    if expectCanonical("{\"s\":\"\\u0000\"}", "{\"s\":\"\\u0000\"}", "NUL escape mismatch") != 0:
        return 1
    if expectCanonical("{\"n\":-0}", "{\"n\":0}", "negative zero canonical mismatch") != 0:
        return 1
    if expectCanonical("{\"s\":\"\\u0041\"}", "{\"s\":\"A\"}", "unicode escape mismatch") != 0:
        return 1
    if expectCanonical(
           "{\"s\":\"\\ud83d\\ude00\"}",
           textWithBytes("{\"s\":\"", [240, 159, 152, 128], "\"}"),
           "unicode surrogate pair mismatch") != 0:
        return 1
    if expectError("{\"s\":\"\\ud800\"}", "invalid_surrogate_pair", "isolated high surrogate accepted") != 0:
        return 1
    if expectError("{\"s\":\"\\udc00\"}", "isolated_low_surrogate", "isolated low surrogate accepted") != 0:
        return 1
    if expectError("{\"s\":\"\\ud800\\u0041\"}", "invalid_surrogate_pair", "invalid surrogate pair accepted") != 0:
        return 1
    if expectError("{\"s\":\"\\u00g0\"}", "invalid_unicode_escape", "invalid unicode hex accepted") != 0:
        return 1
    if expectError("{\"a\":1,\"\\u0061\":2}", "duplicate_object_key", "escaped duplicate key accepted") != 0:
        return 1
    if expectError("{\"s\":\"\n\"}", "raw_control_in_string", "raw control char should fail") != 0:
        return 1
    if expectCanonical(
           "{\"\\u00e9\":1,\"z\":2}",
           textWithBytes("{\"z\":2,\"", [195, 169], "\":1}"),
           "unsigned UTF-8 key order mismatch") != 0:
        return 1
    if expectQuote(
           textWithBytes("", [0, 8, 12, 31], ""),
           "\"\\u0000\\b\\f\\u001f\"",
           "checked quote control escaping mismatch") != 0:
        return 1
    if expectQuoteError(
           textWithBytes("", [255], ""),
           "invalid_utf8",
           "checked quote accepted invalid UTF-8") != 0:
        return 1
    if expectCanonical("{\"n\":1.5}", "{\"n\":1.5}", "decimal fraction canonical mismatch") != 0:
        return 1
    if expectCanonical("{\"n\":1e-06}", "{\"n\":1e-6}", "lowercase exponent canonical mismatch") != 0:
        return 1
    if expectCanonical("{\"n\":1.5E+10}", "{\"n\":1.5e10}", "uppercase signed exponent canonical mismatch") != 0:
        return 1
    if expectCanonical("{\"n\":1000000.0}", "{\"n\":1e6}", "whole-valued float canonical mismatch") != 0:
        return 1
    if expectCanonical("{\"n\":-0.5}", "{\"n\":-0.5}", "negative fraction canonical mismatch") != 0:
        return 1
    if expectCanonical("{\"n\":-0.0}", "{\"n\":0}", "fractional negative zero canonical mismatch") != 0:
        return 1
    if expectSame("{\"n\":1}", "{\"n\":1.0}", "integer and float identity mismatch") != 0:
        return 1
    if expectSame("{\"n\":1e0}", "{\"n\":1E+00}", "exponent spelling identity mismatch") != 0:
        return 1
    if expectSame("{\"n\":100}", "{\"n\":1.00e2}", "coefficient identity mismatch") != 0:
        return 1
    if expectSame("{\"n\":0.001}", "{\"n\":1e-3}", "decimal shift identity mismatch") != 0:
        return 1
    if expectFails("{\"n\":1.}", "trailing-dot number should fail") != 0:
        return 1
    if expectFails("{\"n\":1e}", "bare exponent marker should fail") != 0:
        return 1
    if expectFails("{\"n\":.5}", "leading-dot number should fail") != 0:
        return 1
    if expectInvalidUtf8([255], "invalid UTF-8 lead accepted") != 0:
        return 1
    if expectInvalidUtf8([194, 32], "invalid UTF-8 continuation accepted") != 0:
        return 1
    if expectInvalidUtf8([192, 128], "overlong UTF-8 accepted") != 0:
        return 1
    if expectInvalidUtf8([237, 160, 128], "UTF-8 surrogate accepted") != 0:
        return 1
    if expectInvalidUtf8([244, 144, 128, 128], "UTF-8 above U+10FFFF accepted") != 0:
        return 1
    if expectValidUtf8([194, 128], "valid two-byte UTF-8 rejected") != 0:
        return 1
    if expectValidUtf8([224, 160, 128], "valid three-byte UTF-8 rejected") != 0:
        return 1
    if expectValidUtf8([244, 143, 191, 191], "valid four-byte UTF-8 rejected") != 0:
        return 1
    if expectIdempotent(" { \"b\" : [3,2,1], \"a\" : \"\\u0041\" } ", "canonical JSON was not idempotent") != 0:
        return 1
    if expectCanonical(flatArray(8192), flatArray(8192), "wide JSON linear emitter mismatch") != 0:
        return 1
    if expectDenseQuote() != 0:
        return 1
    if canonical.CsgCoreJsonQuote("A") != "\"A\"":
        return smokeFail("public JSON quote wrapper mismatch")
    if expectInputLimitSuccess() != 0:
        return 1
    if expectInputLimitFailure() != 0:
        return 1
    if expectNumberLimit() != 0:
        return 1
    if expectOutputLimitSuccess() != 0:
        return 1
    if expectOutputLimitFailure() != 0:
        return 1
    if expectError(nestedArray(257), "json_nesting_too_deep", "deep JSON did not fail deterministically") != 0:
        return 1
    if expectError(flatArray(2097152), "json_node_limit_exceeded", "JSON node budget was not enforced") != 0:
        return 1
    os.WriteLine(os.Get_stdout(), "csg_core_json_canonical_smoke ok")
    return 0
