import std/cmdline as cmdline
import std/system

type ProbeCell =
    value: int64

fn variantOrcCycle(iterations: int32,
                   outAlloc: var int64, outFree: var int64, outLive: var int64,
                   outRetain: var int64, outRelease: var int64): int64 =
    let a = system.memAllocCount()
    let f = system.memFreeCount()
    let l = system.memLiveCount()
    let rt = system.memRetainCount()
    let rl = system.memReleaseCount()
    var checksum: int64 = int64(0)
    for i in 0..<iterations:
        let cell = new(ProbeCell)
        if cell == nil:
            panic("orc cycle: alloc failed")
        cell.value = int64(i)
        memRetain(cell)
        if memRefCount(cell) != 2:
            panic("orc cycle: retain did not raise the refcount")
        checksum = checksum + cell.value
        memRelease(cell)
        if memRefCount(cell) != 1:
            panic("orc cycle: release did not lower the refcount")
        system.free(cell)
    outAlloc = system.memAllocCount() - a
    outFree = system.memFreeCount() - f
    outLive = system.memLiveCount() - l
    outRetain = system.memRetainCount() - rt
    outRelease = system.memReleaseCount() - rl
    return checksum

fn main(argc: int32, argv: str*): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    var a: int64 = int64(0)
    var f: int64 = int64(0)
    var l: int64 = int64(0)
    var rt: int64 = int64(0)
    var rl: int64 = int64(0)
    let checksum = variantOrcCycle(5000, a, f, l, rt, rl)
    echo(Fmt"cycle_alloc={a} cycle_free={f} cycle_live={l} cycle_retain={rt} cycle_release={rl} checksum={checksum}")
    return 0
