# tests for ES8311 + CO5300 + BQ27220
import "src/mosaico/frame.cheng" as frame
import "src/mosaico/es8311.cheng" as es
import "src/mosaico/co5300.cheng" as co
import "src/mosaico/bq27220.cheng" as bq

fn CaseEs8311InitGolden(): int32 =
    var buf: uint8[frame.FrameCap]
    var n = 0
    n = es.BuildRecordInitSeq(buf, n)
    if n != 8:
        return 1
    if frame.FrameGet8(buf, n, 0) != 0x01:
        return 2
    if frame.FrameGet8(buf, n, 1) != 0x80:
        return 4
    return 0

fn CaseEs8311MuteAndPolicy(): int32 =
    var buf: uint8[frame.FrameCap]
    var n = 0
    n = es.BuildMuteSeq(buf, n)
    if n != 4:
        return 1
    # PA must be off before codec rail stage and on at PwrPaOn
    if es.PaLevelFor(es.PwrCodecRailOn) != 0:
        return 2
    if es.PaLevelFor(es.PwrPaOn) != 1:
        return 4
    # codec rail level follows stage
    if es.CodecRailLevelFor(es.PwrSysRailOn) != 0:
        return 8
    if es.CodecRailLevelFor(es.PwrPaOn) != 1:
        return 16
    return 0

fn CaseCo5300Window(): int32 =
    var buf: uint8[frame.FrameCap]
    var n = 0
    n = co.BuildWindowSeq(buf, n, 0, 0, 479, 479)
    if n != 11:
        return 1
    if frame.FrameGet8(buf, n, 0) != 0x2A:
        return 2
    if frame.FrameGet16Be(buf, n, 1) != 0:
        return 4
    if frame.FrameGet16Be(buf, n, 3) != 479:
        return 8
    if frame.FrameGet8(buf, n, 5) != 0x2B:
        return 16
    return 0

fn CaseCo5300Tile(): int32 =
    var buf: uint8[frame.FrameCap]
    var n = 0
    n = co.BuildTileChunk(buf, n, 0, 0xF800, 0x0000)
    if n != 32:
        return 1
    if frame.FrameGet16Be(buf, n, 0) != 0xF800:
        return 2
    if frame.FrameGet16Be(buf, n, 30) != 0xF800:
        return 4
    # row 8 enters stripe B (colorB = black)
    var buf2: uint8[frame.FrameCap]
    var n2 = 0
    n2 = co.BuildTileChunk(buf2, n2, 8, 0xF800, 0x0000)
    if frame.FrameGet16Be(buf2, n2, 2) != 0:
        return 8
    return 0

fn CaseCo5300Wake(): int32 =
    var buf: uint8[frame.FrameCap]
    var n = co.BuildWakeSeq(buf, 0)
    if n != 3:
        return 1
    if frame.FrameGet8(buf, n, 0) != 0x01 or frame.FrameGet8(buf, n, 1) != 0x11:
        return 2
    return 0

# BQ27220 register frames are big-endian pairs
fn CaseBq27220Parsers(): int32 =
    var vbuf: uint8[frame.FrameCap]
    var vn = 0
    vn = frame.FramePut16Be(vbuf, vn, 3700)
    if bq.VoltageMvFrom(vbuf, vn) != 3700:
        return 1
    var cbuf: uint8[frame.FrameCap]
    var cn = 0
    cn = frame.FramePut16Be(cbuf, cn, 0xFB50 - 65536 + 65536)
    # -1200 mA as u16 two's complement = 65536-1200 = 64336 = 0xFB50
    if bq.CurrentMaFrom(cbuf, cn) != -1200:
        return 2
    var sbuf: uint8[frame.FrameCap]
    var sn = 0
    sn = frame.FramePut16Be(sbuf, sn, 87)
    if bq.SocPercentFrom(sbuf, sn) != 87:
        return 4
    sn = frame.FramePut16Be(sbuf, sn, 250)
    if bq.SocPercentFrom(sbuf, sn) != 100:
        return 8
    var tbuf: uint8[frame.FrameCap]
    var tn = 0
    tn = frame.FramePut16Be(tbuf, tn, 2955)
    if bq.TempTenthsKFrom(tbuf, tn) != 2955:
        return 16
    return 0

fn main(): int32 =
    var fails = 0
    fails = fails | (CaseEs8311InitGolden() << 0)
    fails = fails | ((CaseEs8311MuteAndPolicy() & 0x3F) << 4)
    fails = fails | ((CaseCo5300Window() & 0x3F) << 10)
    fails = fails | ((CaseCo5300Tile() & 0x1F) << 16)
    fails = fails | (CaseCo5300Wake() << 21)
    fails = fails | ((CaseBq27220Parsers() & 0xFF) << 24)
    return fails
