import std/system
import std/buffer
import std/strings

@borrows
fn probeLen(text: str): int32 =
    let owned = strings.CloneStr(text)
    return len(owned)

fn main() =
    var out = buffer.NewByteBuffer()
    buffer.AppendByte(out, 98)
    buffer.AppendByte(out, 101)
    buffer.AppendByte(out, 116)
    buffer.AppendByte(out, 97)
    let s = buffer.FinishString(out)
    echo(Fmt"direct len={s.len}")
    echo(Fmt"probe len={probeLen(s)}")
    echo(Fmt"literal probe len={probeLen(\"beta\")}")
    echo("repro_finishstr done")
