import std/os as os
import std/rawbytes
import std/strings
import std/strutils
import cheng/core/csg_core/csgc
import cheng/core/csg_core/json_field as field
import cheng/core/csg_core/merkle_store_codec
import cheng/core/csg_core/merkle_transaction_receipt as receipt_codec
import cheng/core/csg_core/merkle_transaction_request

const
    Cid1: str = "sha256:1111111111111111111111111111111111111111111111111111111111111111"
    Cid2: str = "sha256:2222222222222222222222222222222222222222222222222222222222222222"
    Cid3: str = "sha256:3333333333333333333333333333333333333333333333333333333333333333"
    Cid4: str = "sha256:4444444444444444444444444444444444444444444444444444444444444444"
    Cid5: str = "sha256:5555555555555555555555555555555555555555555555555555555555555555"
    Cid6: str = "sha256:6666666666666666666666666666666666666666666666666666666666666666"
    Cid7: str = "sha256:7777777777777777777777777777777777777777777777777777777777777777"
    Cid8: str = "sha256:8888888888888888888888888888888888888888888888888888888888888888"
    Cid9: str = "sha256:9999999999999999999999999999999999999999999999999999999999999999"
    CidA: str = "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    CidB: str = "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
    CidC: str = "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
    CidD: str = "sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
    UpperCid: str = "sha256:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
    StoreIdentityCid: str = "sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"
    SealedContentCid: str = "sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
    CarrierCid: str = "sha256:1010101010101010101010101010101010101010101010101010101010101010"
    ProjectionCid: str = "sha256:2020202020202020202020202020202020202020202020202020202020202020"
    ProofCid: str = "sha256:3030303030303030303030303030303030303030303030303030303030303030"
    ArtifactClosureCid: str = "sha256:4040404040404040404040404040404040404040404040404040404040404040"

fn fail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

fn bindPlanRoot(
        value: var
            receipt_codec.CsgCoreMerkleTransactionReceipt) =
    var plan: merkle_transaction_request.CsgCoreMerkleTransactionPlan
    plan.requestCid = strings.CloneStr(value.requestCid)
    plan.beforeHeadCid =
        strings.CloneStr(value.beforeHeadCid)
    plan.beforeManifestCid =
        strings.CloneStr(value.beforeManifestCid)
    plan.beforeCsgcDirectoryCid =
        strings.CloneStr(value.beforeCsgcDirectoryCid)
    plan.beforeFactsRoot =
        strings.CloneStr(value.beforeFactsRoot)
    plan.beforeDagRootCid =
        strings.CloneStr(value.beforeDagRootCid)
    plan.beforeFactCount = value.beforeFactCount
    plan.afterCsgcDirectoryCid =
        strings.CloneStr(value.afterCsgcDirectoryCid)
    plan.afterFactsRoot =
        strings.CloneStr(value.afterFactsRoot)
    plan.afterDagRootCid =
        strings.CloneStr(value.afterDagRootCid)
    plan.afterFactCount = value.afterFactCount
    plan.invalidationCid =
        strings.CloneStr(value.invalidationCid)
    for i in 0..<value.plannedOperationKinds.len:
        add(
            plan.operationKinds,
            value.plannedOperationKinds[i])
        add(
            plan.operationFactKeys,
            strings.CloneStr(
                value.plannedOperationFactKeys[i]))
        add(
            plan.operationCids,
            strings.CloneStr(value.operationCids[i]))
    var computed =
        merkle_transaction_request.CsgCoreMerkleTransactionPlanRoot(
            plan)
    if !computed.ok:
        panic(strings.CloneStr(computed.error))
    value.planRoot = strings.CloneStr(computed.planRoot)
    merkle_transaction_request.CsgCoreMerkleTransactionPlanRootFree(
        computed)

@borrows
fn fixture():
        receipt_codec.CsgCoreMerkleTransactionReceipt =
    var out: receipt_codec.CsgCoreMerkleTransactionReceipt
    out.schema = "csg_core::v1"
    out.generation = 2
    out.requestCid = Cid2
    out.beforeHeadCid = Cid1
    out.beforeManifestCid = Cid3
    out.afterManifestCid = Cid4
    out.beforeCsgcDirectoryCid = Cid9
    out.afterCsgcDirectoryCid = CidA
    out.beforeFactsRoot = Cid5
    out.afterFactsRoot = Cid6
    out.beforeDagRootCid = Cid7
    out.afterDagRootCid = Cid8
    out.beforeFactCount = 2
    out.afterFactCount = 3
    out.invalidationCid = Cid9
    // durable bindings validated by
    // merkle_transaction_receipt.cheng:440-450
    out.beforeStoreIdentity = StoreIdentityCid
    out.sealedBeforeContentCid = SealedContentCid
    out.semanticCarrierCid = CarrierCid
    out.projectionReceiptCid = ProjectionCid
    out.proofCid = ProofCid
    out.artifactClosureCid = ArtifactClosureCid
    // single replace model required by
    // merkle_transaction_receipt.cheng:451-453
    out.plannedOperationKinds = [int32(3)]
    out.plannedOperationFactKeys = ["id:a"]
    out.operationCids = [CidB]
    out.reachableNewNodeCids = [CidC, CidD]
    bindPlanRoot(out)
    return out

@borrows
fn sameStrings(left: str[], right: str[]): bool =
    if left.len != right.len:
        return false
    for i in 0..<left.len:
        if left[i] != right[i]:
            return false
    return true

@borrows
fn sameInt32s(left: int32[], right: int32[]): bool =
    if left.len != right.len:
        return false
    for i in 0..<left.len:
        if left[i] != right[i]:
            return false
    return true

@borrows
fn cloneLines(lines: str[]): str[] =
    var out: str[]
    for i in 0..<lines.len:
        add(out, strings.CloneStr(lines[i]))
    return out

@borrows
fn reverseLines(lines: str[]): str[] =
    var out: str[]
    for offset in 0..<lines.len:
        add(
            out,
            strings.CloneStr(
                lines[lines.len - 1 - offset]))
    return out

@borrows
fn lineIndex(
        lines: str[],
        wantedKind: str,
        wantedIndex: str): int32 =
    for i in 0..<lines.len:
        let kind = field.CsgCoreJsonKind(lines[i])
        if !kind.found || kind.value != wantedKind:
            continue
        if wantedIndex.len == 0:
            return i
        let index =
            field.CsgCoreJsonTopStringField(
                lines[i], "index")
        if index.found && index.value == wantedIndex:
            return i
    return -1

@borrows
fn bytesCopy(
        bytes: rawbytes.Bytes,
        count: int32): rawbytes.Bytes =
    if count < 0 || count > rawbytes.BytesLen(bytes):
        return rawbytes.BytesAlloc(0)
    var out = rawbytes.BytesAlloc(count)
    for i in 0..<count:
        rawbytes.BytesSet(
            out, i, rawbytes.BytesGet(bytes, i))
    return out

@borrows
fn expectReceiptError(
        value:
            receipt_codec.CsgCoreMerkleTransactionReceipt,
        expected: str,
        label: str): int32 =
    var encoded =
        receipt_codec.CsgCoreMerkleTransactionReceiptEncode(
            value)
    if encoded.ok:
        rawbytes.BytesFree(encoded.bytes)
        return fail(
            strings.ConcatStr(
                label, ": invalid receipt accepted"))
    if !strings.StrContains(encoded.error, expected):
        os.WriteLine(os.Get_stderr(), encoded.error)
        return fail(
            strings.ConcatStr(label, ": wrong error"))
    return 0

@borrows
fn expectMalformedLines(
        lines: str[],
        expected: str,
        label: str): int32 =
    var cargo =
        csgc.CsgCoreCsgcEncodeCanonicalLines(lines)
    if !cargo.ok:
        os.WriteLine(os.Get_stderr(), cargo.error)
        return fail(
            strings.ConcatStr(
                label, ": malformed fixture is not CSGC"))
    var decoded =
        receipt_codec.CsgCoreMerkleTransactionReceiptDecode(
            cargo.bytes)
    rawbytes.BytesFree(cargo.bytes)
    if decoded.ok:
        rawbytes.BytesFree(decoded.bytes)
        return fail(
            strings.ConcatStr(
                label, ": malformed receipt accepted"))
    if !strings.StrContains(decoded.error, expected):
        os.WriteLine(os.Get_stderr(), decoded.error)
        return fail(
            strings.ConcatStr(label, ": wrong error"))
    return 0

@borrows
fn expectMalformedBytes(
        bytes: rawbytes.Bytes,
        expected: str,
        label: str): int32 =
    var decoded =
        receipt_codec.CsgCoreMerkleTransactionReceiptDecode(
            bytes)
    if decoded.ok:
        rawbytes.BytesFree(decoded.bytes)
        return fail(
            strings.ConcatStr(
                label, ": malformed receipt accepted"))
    if !strings.StrContains(decoded.error, expected):
        os.WriteLine(os.Get_stderr(), decoded.error)
        return fail(
            strings.ConcatStr(label, ": wrong error"))
    return 0

fn expectReceiptResourceLimits(): int32 =
    let operationLimit =
        receipt_codec.CsgCoreMerkleTransactionReceiptOperationLimit()
    let nodeLimit =
        receipt_codec.CsgCoreMerkleTransactionReceiptReachableNodeLimit()
    let lineLimit =
        receipt_codec.CsgCoreMerkleTransactionReceiptLineLimit()
    if lineLimit != operationLimit + nodeLimit + 1:
        return fail("receipt line limit is not exact")

    var duplicateAtLimit = fixture()
    setLen(duplicateAtLimit.operationCids, operationLimit)
    for i in 0..<duplicateAtLimit.operationCids.len:
        duplicateAtLimit.operationCids[i] = CidA
    if expectReceiptError(
           duplicateAtLimit,
           "operation_duplicate",
           "operation duplicate at exact limit") != 0:
        return 1

    var operationOverflow = fixture()
    setLen(
        operationOverflow.operationCids,
        operationLimit + 1)
    if expectReceiptError(
           operationOverflow,
           "operation_count_limit_exceeded",
           "operation count maximum plus one") != 0:
        return 1

    var nodeOverflow = fixture()
    setLen(
        nodeOverflow.reachableNewNodeCids,
        nodeLimit + 1)
    if expectReceiptError(
           nodeOverflow,
           "reachable_node_count_limit_exceeded",
           "reachable node count maximum plus one") != 0:
        return 1
    return 0

fn main(): int32 =
    let source = fixture()
    var first =
        receipt_codec.CsgCoreMerkleTransactionReceiptEncode(
            source)
    var repeated =
        receipt_codec.CsgCoreMerkleTransactionReceiptEncode(
            source)
    if !first.ok || !repeated.ok:
        return fail("transaction receipt encode failed")
    if first.factCount != 4 ||
       first.cid != repeated.cid ||
       !rawbytes.BytesEqual(first.bytes, repeated.bytes) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           first.cid):
        return fail("transaction receipt is not deterministic")
    if rawbytes.BytesLen(first.bytes) < 64 ||
       rawbytes.BytesGet(first.bytes, 0) != 67 ||
       rawbytes.BytesGet(first.bytes, 1) != 83 ||
       rawbytes.BytesGet(first.bytes, 2) != 71 ||
       rawbytes.BytesGet(first.bytes, 3) != 67 ||
       rawbytes.BytesGet(first.bytes, 4) != 64 ||
       rawbytes.BytesGet(first.bytes, 5) != 0 ||
       rawbytes.BytesGet(first.bytes, 6) != 0 ||
       rawbytes.BytesGet(first.bytes, 7) != 0:
        return fail("transaction receipt did not use unique CSGC")
    for i in 20..<64:
        if rawbytes.BytesGet(first.bytes, i) != 0:
            return fail("transaction receipt reserved header is nonzero")

    var decoded =
        receipt_codec.CsgCoreMerkleTransactionReceiptDecode(
            first.bytes)
    if !decoded.ok ||
       decoded.cid != first.cid ||
       decoded.factCount != first.factCount ||
         !rawbytes.BytesEqual(decoded.bytes, first.bytes) ||
         decoded.receipt.generation != int64(2) ||
         decoded.receipt.requestCid != Cid2 ||
         decoded.receipt.planRoot != source.planRoot ||
         decoded.receipt.beforeHeadCid != Cid1 ||
       decoded.receipt.beforeManifestCid != Cid3 ||
       decoded.receipt.afterManifestCid != Cid4 ||
       decoded.receipt.beforeCsgcDirectoryCid != Cid9 ||
       decoded.receipt.afterCsgcDirectoryCid != CidA ||
       decoded.receipt.beforeFactsRoot != Cid5 ||
       decoded.receipt.afterFactsRoot != Cid6 ||
       decoded.receipt.beforeDagRootCid != Cid7 ||
       decoded.receipt.afterDagRootCid != Cid8 ||
       decoded.receipt.beforeFactCount != 2 ||
       decoded.receipt.afterFactCount != 3 ||
       decoded.receipt.invalidationCid != Cid9 ||
       decoded.receipt.beforeStoreIdentity !=
           StoreIdentityCid ||
       decoded.receipt.sealedBeforeContentCid !=
           SealedContentCid ||
       decoded.receipt.semanticCarrierCid !=
           CarrierCid ||
       decoded.receipt.projectionReceiptCid !=
           ProjectionCid ||
       decoded.receipt.proofCid != ProofCid ||
       decoded.receipt.artifactClosureCid !=
           ArtifactClosureCid ||
       !sameInt32s(
           decoded.receipt.plannedOperationKinds,
           [int32(3)]) ||
       !sameStrings(
           decoded.receipt.plannedOperationFactKeys,
           ["id:a"]) ||
       !sameStrings(
           decoded.receipt.operationCids,
           [CidB]) ||
       !sameStrings(
           decoded.receipt.reachableNewNodeCids,
           [CidC, CidD]):
        return fail("transaction receipt binding roundtrip failed")
    var reencoded =
        receipt_codec.CsgCoreMerkleTransactionReceiptEncode(
            decoded.receipt)
    if !reencoded.ok ||
       reencoded.cid != first.cid ||
       !rawbytes.BytesEqual(
           reencoded.bytes, first.bytes):
        return fail("transaction receipt reencode changed bytes")

    let physicalLines =
        csgc.CsgCoreCsgcDecodeLines(first.bytes)
    if !physicalLines.ok ||
       physicalLines.lines.len != first.factCount:
        return fail("transaction receipt CSGC read failed")
    var reversedCargo =
        csgc.CsgCoreCsgcEncodeCanonicalLines(
            reverseLines(physicalLines.lines))
    if !reversedCargo.ok ||
       !rawbytes.BytesEqual(
           reversedCargo.bytes, first.bytes):
        return fail("receipt fact input order changed CSGC")
    var reversedDecoded =
        receipt_codec.CsgCoreMerkleTransactionReceiptDecode(
            reversedCargo.bytes)
    if !reversedDecoded.ok ||
       reversedDecoded.cid != first.cid:
        return fail("reordered receipt facts changed binding")

    // two distinct replace operations cross the admission of
    // merkle_transaction_receipt.cheng:451-453
    var twoOperationReceipt = fixture()
    twoOperationReceipt.plannedOperationKinds =
        [int32(2), int32(3)]
    twoOperationReceipt.plannedOperationFactKeys =
        ["id:a", "id:b"]
    twoOperationReceipt.operationCids = [CidB, CidA]
    bindPlanRoot(twoOperationReceipt)
    if expectReceiptError(
           twoOperationReceipt,
           "single_replace_binding_invalid",
           "two-operation receipt crossed single replace admission") != 0:
        return 1

    var replacedOperation = fixture()
    replacedOperation.operationCids = [CidA]
    bindPlanRoot(replacedOperation)
    var replacedOperationCargo =
        receipt_codec.CsgCoreMerkleTransactionReceiptEncode(
            replacedOperation)
    if !replacedOperationCargo.ok ||
       replacedOperationCargo.cid == first.cid ||
       rawbytes.BytesEqual(
           replacedOperationCargo.bytes, first.bytes):
        return fail("replaced operation CID was not committed")

    // operation kind outside 1..3 rejected by
    // merkle_transaction_receipt.cheng:326-331
    var badOperationKind = fixture()
    badOperationKind.plannedOperationKinds = [int32(4)]
    if expectReceiptError(
           badOperationKind,
           "operation_kind_invalid",
           "noncanonical operation kind crossed admission") != 0:
        return 1

    var badSchema = fixture()
    badSchema.schema = "csg_core::other"
    if expectReceiptError(
           badSchema,
           "schema_invalid",
           "bad schema") != 0:
        return 1
    var uppercaseCid = fixture()
    uppercaseCid.beforeHeadCid = UpperCid
    if expectReceiptError(
           uppercaseCid,
           "before_head_cid_invalid",
           "uppercase CID") != 0:
        return 1
    var duplicateOperation = fixture()
    duplicateOperation.operationCids = [CidA, CidA]
    if expectReceiptError(
           duplicateOperation,
           "operation_duplicate",
           "duplicate operation") != 0:
        return 1
    // invalid durable binding CID rejected by
    // merkle_transaction_receipt.cheng:440-450
    var badDurableBinding = fixture()
    badDurableBinding.artifactClosureCid =
        "sha256:ZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZ"
    if expectReceiptError(
           badDurableBinding,
           "durable_binding_invalid",
           "invalid durable binding") != 0:
        return 1
    // invalid plan root CID rejected by
    // merkle_transaction_receipt.cheng:435-438
    var badPlanRoot = fixture()
    badPlanRoot.planRoot = ""
    if expectReceiptError(
           badPlanRoot,
           "plan_root_invalid",
           "bad plan root") != 0:
        return 1
    // planned tuple length crossing operation count rejected by
    // merkle_transaction_receipt.cheng:416-420
    var badPlanShape = fixture()
    badPlanShape.plannedOperationKinds = [int32(3), int32(3)]
    if expectReceiptError(
           badPlanShape,
           "planned_operation_shape_invalid",
           "bad planned operation shape") != 0:
        return 1
    // nonpositive fact count rejected by
    // merkle_transaction_receipt.cheng:383-385
    var badFactCount = fixture()
    badFactCount.beforeFactCount = 0
    if expectReceiptError(
           badFactCount,
           "fact_count_invalid",
           "nonpositive fact count") != 0:
        return 1
    if expectReceiptResourceLimits() != 0:
        return 1
    var noopReceipt = fixture()
    noopReceipt.afterManifestCid =
        strings.CloneStr(noopReceipt.beforeManifestCid)
    noopReceipt.afterCsgcDirectoryCid =
        strings.CloneStr(
            noopReceipt.beforeCsgcDirectoryCid)
    noopReceipt.afterFactsRoot =
        strings.CloneStr(noopReceipt.beforeFactsRoot)
    noopReceipt.afterDagRootCid =
        strings.CloneStr(noopReceipt.beforeDagRootCid)
    noopReceipt.afterFactCount =
        noopReceipt.beforeFactCount
    noopReceipt.plannedOperationKinds = []
    noopReceipt.plannedOperationFactKeys = []
    noopReceipt.operationCids = []
    noopReceipt.reachableNewNodeCids = []
    bindPlanRoot(noopReceipt)
    if expectReceiptError(
           noopReceipt,
           "zero_operation_not_publishable",
           "same-state zero operation manufactured generation") != 0:
        return 1
    var invalidNoop = noopReceipt
    invalidNoop.afterFactsRoot = Cid6
    if expectReceiptError(
           invalidNoop,
           "noop_transition_invalid",
           "mutating no-op receipt") != 0:
        return 1
    var badFactCountTransition = fixture()
    badFactCountTransition.afterFactCount = 2
    if expectReceiptError(
           badFactCountTransition,
           "fact_count_transition_mismatch",
           "operation fact count mismatch") != 0:
        return 1
    var unchangedOperationState = fixture()
    unchangedOperationState.afterManifestCid =
        strings.CloneStr(
            unchangedOperationState.beforeManifestCid)
    unchangedOperationState.afterCsgcDirectoryCid =
        strings.CloneStr(
            unchangedOperationState.beforeCsgcDirectoryCid)
    unchangedOperationState.afterFactsRoot =
        strings.CloneStr(
            unchangedOperationState.beforeFactsRoot)
    unchangedOperationState.afterDagRootCid =
        strings.CloneStr(
            unchangedOperationState.beforeDagRootCid)
    unchangedOperationState.afterFactCount =
        unchangedOperationState.beforeFactCount
    unchangedOperationState.plannedOperationKinds =
        [int32(2)]
    unchangedOperationState.plannedOperationFactKeys =
        ["id:a"]
    unchangedOperationState.operationCids = [CidB]
    unchangedOperationState.reachableNewNodeCids = []
    bindPlanRoot(unchangedOperationState)
    if expectReceiptError(
           unchangedOperationState,
           "state_binding_unchanged",
           "operation with unchanged state") != 0:
        return 1
    var reboundManifest = fixture()
    reboundManifest.afterManifestCid = CidD
    var reboundManifestEncoded =
        receipt_codec.CsgCoreMerkleTransactionReceiptEncode(
            reboundManifest)
    if !reboundManifestEncoded.ok ||
       reboundManifestEncoded.cid == first.cid ||
       rawbytes.BytesEqual(
           reboundManifestEncoded.bytes, first.bytes):
        return fail("after manifest was not bound by receipt CID")
    var zeroGeneration = fixture()
    zeroGeneration.generation = 0
    if expectReceiptError(
           zeroGeneration,
           "generation_invalid",
           "zero generation") != 0:
        return 1
    var overflowGeneration = fixture()
    overflowGeneration.generation = int64(9223372036854775807)
    if expectReceiptError(
           overflowGeneration,
           "generation_invalid",
           "overflow generation") != 0:
        return 1
    var unsortedNodes = fixture()
    unsortedNodes.reachableNewNodeCids = [CidD, CidC]
    if expectReceiptError(
           unsortedNodes,
           "reachable_nodes_not_sorted",
           "unsorted reachable nodes") != 0:
        return 1
    var duplicateNodes = fixture()
    duplicateNodes.reachableNewNodeCids = [CidC, CidC]
    if expectReceiptError(
           duplicateNodes,
           "reachable_node_duplicate",
           "duplicate reachable node") != 0:
        return 1
    let headerIndex = lineIndex(
        physicalLines.lines,
        "csg.merkle.transaction_receipt",
        "")
    let secondNodeIndex = lineIndex(
        physicalLines.lines,
        "csg.merkle.transaction_reachable_new_node",
        "1")
    if headerIndex < 0 || secondNodeIndex < 0:
        return fail("receipt canonical facts missing")

    var extraFieldLines = cloneLines(physicalLines.lines)
    let header = extraFieldLines[headerIndex]
    extraFieldLines[headerIndex] =
        strings.ConcatStr(
            strings.CloneStrRange(
                header, 0, header.len - 1),
            ",\"unexpected\":\"x\"}")
    if expectMalformedLines(
           extraFieldLines,
           "header_non_canonical",
           "extra header field") != 0:
        return 1

    var countMismatchLines = cloneLines(physicalLines.lines)
    countMismatchLines[headerIndex] =
        strutils.Replace(
            countMismatchLines[headerIndex],
            "\"operation_count\":\"1\"",
            "\"operation_count\":\"2\"")
    if expectMalformedLines(
           countMismatchLines,
           "count_mismatch",
           "operation count mismatch") != 0:
        return 1

    var duplicateNodeLines = cloneLines(physicalLines.lines)
    duplicateNodeLines[secondNodeIndex] =
        strutils.Replace(
            duplicateNodeLines[secondNodeIndex],
            CidD,
            CidC)
    if expectMalformedLines(
           duplicateNodeLines,
           "reachable_node_duplicate",
           "duplicate node fact") != 0:
        return 1

    var unsortedNodeLines = cloneLines(physicalLines.lines)
    unsortedNodeLines[secondNodeIndex] =
        strutils.Replace(
            unsortedNodeLines[secondNodeIndex],
            CidD,
            CidB)
    if expectMalformedLines(
           unsortedNodeLines,
           "reachable_nodes_not_sorted",
           "unsorted node fact") != 0:
        return 1

    var duplicateFieldLines = cloneLines(physicalLines.lines)
    duplicateFieldLines[headerIndex] =
        strings.ConcatStr(
            strings.CloneStrRange(
                header, 0, header.len - 1),
            ",\"schema\":\"csg_core::v1\"}")
    var duplicateFieldCargo =
        csgc.CsgCoreCsgcEncodeCanonicalLines(
            duplicateFieldLines)
    if duplicateFieldCargo.ok:
        var duplicateFieldDecoded =
            receipt_codec.CsgCoreMerkleTransactionReceiptDecode(
                duplicateFieldCargo.bytes)
        rawbytes.BytesFree(duplicateFieldCargo.bytes)
        if duplicateFieldDecoded.ok:
            rawbytes.BytesFree(duplicateFieldDecoded.bytes)
            return fail("duplicate receipt field accepted")

    var nonzeroReserved =
        bytesCopy(first.bytes, rawbytes.BytesLen(first.bytes))
    rawbytes.BytesSet(nonzeroReserved, 20, 1)
    if expectMalformedBytes(
           nonzeroReserved,
           "nonzero_reserved_header",
           "nonzero reserved header") != 0:
        return 1
    rawbytes.BytesFree(nonzeroReserved)

    var truncated =
        bytesCopy(
            first.bytes,
            rawbytes.BytesLen(first.bytes) - 1)
    if expectMalformedBytes(
           truncated,
           "body_size_mismatch",
           "truncated receipt") != 0:
        return 1
    rawbytes.BytesFree(truncated)

    os.WriteLine(os.Get_stdout(), first.cid)
    os.WriteLine(
        os.Get_stdout(),
        "csg_core_merkle_transaction_receipt_smoke ok")
    rawbytes.BytesFree(reboundManifestEncoded.bytes)
    rawbytes.BytesFree(replacedOperationCargo.bytes)
