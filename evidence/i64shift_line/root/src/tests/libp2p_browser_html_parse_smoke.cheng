import std/system
import cheng/core/runtime/web_runtime as web
import cheng/apps/libp2p_browser/html_parse as htmlparse

fn main(): int32 =
    let src = "<!doctype html><!--c--><html><head><link rel=\"stylesheet\" href=\"/app.css\"><style>body{color:#111}</style><title>T</title></head><body><h1>Hello</h1><p>a &amp; b</p><form><input id=\"q\" name=\"q\" type=\"text\" value=\"hi\"></form><select id=\"s\"><option value=\"a\">A</option></select><a id=\"n\" href=\"/next\">next</a><br><img src=\"x.png\" alt=\"i\"></body></html>"
    var document: web.WebDocument
    web.WebDocumentInit(document)
    if !htmlparse.HtmlParseDocument(src, document):
        echo(htmlparse.HtmlParseError())
        return 1
    if web.WebDocumentNodeCount(document) < 10:
        return 2
    let css = htmlparse.HtmlParseCss()
    if css.len < 8:
        return 3
    let links = htmlparse.HtmlParseLinks()
    if links.len < 7:
        echo(links)
        return 10
    var emptyDoc: web.WebDocument
    web.WebDocumentInit(emptyDoc)
    if htmlparse.HtmlParseDocument("", emptyDoc):
        return 9
    echo("libp2p_browser_html_parse_smoke ok")
    return 0
