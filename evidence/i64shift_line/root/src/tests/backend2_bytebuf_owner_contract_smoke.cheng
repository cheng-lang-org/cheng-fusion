import cheng/std/bytes_layout as layout
import std/rawbytes as rawbytes
import std/result

fn main(): int32 =
    var nextCapacity: int32
    if !layout.ByteBufCheckedGrowCapacity(64, 65, nextCapacity) ||
       nextCapacity != 128:
        return 1
    if !layout.ByteBufCheckedGrowCapacity(
           1073741824, 2147483647, nextCapacity) ||
       nextCapacity != 2147483647:
        return 2
    if layout.ByteBufCheckedGrowCapacity(-1, 64, nextCapacity) ||
       layout.ByteBufCheckedGrowCapacity(64, -1, nextCapacity):
        return 3

    var buf = layout.ByteBufInit(64)
    for index in 0..<8192:
        layout.ByteBufAppendByte(buf, index & 255)
    if layout.ByteBufLen(buf) != 8192:
        layout.ByteBufFree(buf)
        return 4
    var copied = layout.ByteBufToBytes(buf)
    if copied.len != 8192 ||
       rawbytes.BytesGet(copied, 0) != 0 ||
       rawbytes.BytesGet(copied, 4097) != 1 ||
       rawbytes.BytesGet(copied, 8191) != 255:
        rawbytes.BytesFree(copied)
        layout.ByteBufFree(buf)
        return 5
    rawbytes.BytesFree(copied)
    layout.ByteBufFree(buf)
    if layout.ByteBufLen(buf) != 0:
        return 6

    let fixedRes = layout.FixedBytes32FromHex(
        "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
    if IsErr(fixedRes):
        return 7
    let fixed = Value(fixedRes)
    var fixedBuf = layout.ByteBufInit(64)
    for index in 0..<63:
        layout.ByteBufAppendByte(fixedBuf, 0xa5)
    layout.ByteBufAppendFixed32(fixedBuf, fixed)
    layout.ByteBufAppendByte(fixedBuf, 0x5a)
    if layout.ByteBufLen(fixedBuf) != 96:
        layout.ByteBufFree(fixedBuf)
        return 8
    var fixedCopied = layout.ByteBufToBytes(fixedBuf)
    for index in 0..<63:
        if rawbytes.BytesGet(fixedCopied, index) != 0xa5:
            rawbytes.BytesFree(fixedCopied)
            layout.ByteBufFree(fixedBuf)
            return 9
    for index in 0..<32:
        if rawbytes.BytesGet(fixedCopied, 63 + index) != index:
            rawbytes.BytesFree(fixedCopied)
            layout.ByteBufFree(fixedBuf)
            return 10
    if rawbytes.BytesGet(fixedCopied, 95) != 0x5a:
        rawbytes.BytesFree(fixedCopied)
        layout.ByteBufFree(fixedBuf)
        return 11
    rawbytes.BytesFree(fixedCopied)
    layout.ByteBufFree(fixedBuf)

    for round in 0..<262144:
        let validRes = layout.FixedBytes32FromHex(
            "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
        if IsErr(validRes) ||
           !layout.FixedBytes32Equal(Value(validRes), fixed):
            return 12
        let invalidRes = layout.FixedBytes32FromHex(
            "g00102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
        if IsOk(invalidRes):
            return 13
    echo("BACKEND2_BYTEBUF_OWNER_OK")
    return 0

main()
