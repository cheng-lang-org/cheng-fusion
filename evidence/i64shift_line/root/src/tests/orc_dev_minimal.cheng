# minimal probe for dev-compiler plain-copy check
import std/system

type
    Pair =
        a: int32
        b: int32

fn MakePair(x: int32, y: int32): Pair =
    var p: Pair
    p.a = x
    p.b = y
    return p

fn main(): int32 =
    let p = MakePair(1, 2)
    var q: Pair = p
    echo("q ok")
    return 0
