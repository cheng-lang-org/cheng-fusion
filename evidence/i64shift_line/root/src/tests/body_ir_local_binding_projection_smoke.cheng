import cheng/core/backend/primary_object_plan as primary
import cheng/core/backend/lowering_plan as lower
import cheng/core/backend2/backend2_frag_codec as codec
import cheng/core/backend2/backend2_lower_slots as backend2slots
import cheng/core/ir/core_types as coreir
import cheng/core/lang/typed_expr as texpr
import cheng/std/bytes_layout as layout
import std/os as os
import std/rawbytes as rawbytes
import std/result

const
    cleanupIntentColumnCount: int32 = 47
    cleanupScheduleColumnCount: int32 = 27
    cleanupReplayColumnCount: int32 = 3

fn typeArenaCid(): layout.FixedBytes32 =
    let parsed = layout.FixedBytes32FromHex(
        "5151515151515151515151515151515151515151515151515151515151515151")
    assert(IsOk(parsed), "local binding projection: TypeArena CID")
    return Value(parsed)

fn appendSlot(
        body: var coreir.BodyIR,
        projection: var coreir.BodyIRLocalBindingValueDefinitionProjection,
        slotId: int32,
        definitionRow: int32) =
    var slot: coreir.LocalSlot
    coreir.BodyIRApplyLocalSlotDefaultProof(slot)
    slot.id = slotId
    slot.typeKind = coreir.LocalI32Tag
    slot.stackOffset = 16 + slotId * 8
    slot.sizeBytes = 4
    slot.alignBytes = 4
    add(body.localSlots, slot)
    coreir.BodyIRAppendUnboundLocalBindingValueDefinitionRow(body, slotId)
    coreir.BodyIRBindLocalBindingValueDefinitionRow(
        body, projection, slotId, definitionRow)

fn buildBody(): coreir.BodyIR =
    var body = coreir.BodyIRNew()
    assert(coreir.BodyIRBindTypeArenaArtifactCid(body, typeArenaCid()),
           "local binding projection: TypeArena bind")
    coreir.BodyIRBindLocalBindingValueDefinitionDomain(body, 100, 4)
    var projection =
        coreir.BodyIRLocalBindingValueDefinitionProjectionNew(body)
    appendSlot(body, projection, 0, 100)
    appendSlot(body, projection, 1, 102)
    appendSlot(body, projection, 2, 103)
    var ownershipKinds: int32[]
    add(ownershipKinds, int32(coreir.OwnPlain))
    add(ownershipKinds, int32(coreir.OwnPlain))
    add(ownershipKinds, int32(coreir.OwnPlain))
    coreir.BodyIRFreezeEntryDefinitionOwnershipKinds(body, ownershipKinds)
    return body

fn canonicalEmptyCleanupAuthorityBytes(): int32 =
    let intentFixedBytes = 32 + 2 * 4 + 4 * 32 + 5 * 4
    let scheduleFixedBytes = 2 * 4 + 2 * 32
    let replayFixedBytes = 2 * 4 + 32
    return 4 + intentFixedBytes + cleanupIntentColumnCount * 4 +
           scheduleFixedBytes + cleanupScheduleColumnCount * 4 +
           replayFixedBytes + cleanupReplayColumnCount * 4

fn entryDefinitionTagOffset(payload: rawbytes.Bytes): int32 =
    let trailingTypeArenaAtomBytes: int32 = 4 + 32
    let canonicalEmptyExternCapabilityBytes: int32 = 280
    # sealed + three ownership rows + three semantic rows + no parameters +
    # immutable domain start/count + three binding rows.
    let entryDefinitionBytes: int32 =
        4 + 4 + (4 + 3 * 4) + (4 + 3 * 4) + 4 + 4 + 4 +
        (4 + 3 * 4)
    let offset = payload.len - trailingTypeArenaAtomBytes -
        canonicalEmptyCleanupAuthorityBytes() -
        canonicalEmptyExternCapabilityBytes - entryDefinitionBytes
    assert(offset >= 8, "local binding projection: tag15 offset")
    var cursor = offset
    assert(codec.Backend2CodecReadU32(payload, cursor) == 15,
           "local binding projection: tag15 missing")
    return offset

fn cloneBytes(payload: rawbytes.Bytes): rawbytes.Bytes =
    return rawbytes.BytesSlice(payload, 0, payload.len)

fn deleteWordAt(payload: rawbytes.Bytes, offset: int32): rawbytes.Bytes =
    assert(offset >= 0 && offset <= payload.len - 4,
           "local binding projection: delete offset")
    var out = rawbytes.BytesAlloc(payload.len - 4)
    rawbytes.BytesCopyRangeInto(out, 0, payload, 0, offset)
    rawbytes.BytesCopyRangeInto(
        out, offset, payload, offset + 4, payload.len - offset - 4)
    return out

fn primaryPrevalidateMutationsReject(payload: rawbytes.Bytes) =
    let tagOffset = entryDefinitionTagOffset(payload)
    let domainStartOffset = tagOffset + 44
    let domainCountOffset = tagOffset + 48
    let secondBindingRowOffset = tagOffset + 60
    let thirdBindingRowOffset = tagOffset + 64

    var oldMagic = cloneBytes(payload)
    codec.Backend2CodecPutU32(oldMagic, 0, 0x42424955)
    assert(!primary.PrimaryLowerPoolBodyIrPayloadPrevalidate(oldMagic),
           "local binding projection: old magic accepted")

    var startDrift = cloneBytes(payload)
    codec.Backend2CodecPutU32(startDrift, domainStartOffset, 101)
    assert(!primary.PrimaryLowerPoolBodyIrPayloadPrevalidate(startDrift),
           "local binding projection: start drift accepted")

    var countDrift = cloneBytes(payload)
    codec.Backend2CodecPutU32(countDrift, domainCountOffset, 3)
    assert(!primary.PrimaryLowerPoolBodyIrPayloadPrevalidate(countDrift),
           "local binding projection: count drift accepted")

    var duplicate = cloneBytes(payload)
    codec.Backend2CodecPutU32(duplicate, secondBindingRowOffset, 100)
    assert(!primary.PrimaryLowerPoolBodyIrPayloadPrevalidate(duplicate),
           "local binding projection: duplicate row accepted")

    var outside = cloneBytes(payload)
    codec.Backend2CodecPutU32(outside, thirdBindingRowOffset, 104)
    assert(!primary.PrimaryLowerPoolBodyIrPayloadPrevalidate(outside),
           "local binding projection: outside row accepted")

    var missingStart = deleteWordAt(payload, domainStartOffset)
    var missingDomain = deleteWordAt(missingStart, domainStartOffset)
    assert(!primary.PrimaryLowerPoolBodyIrPayloadPrevalidate(missingDomain),
           "local binding projection: missing domain accepted")

@borrows
fn exactIndexedHelpersRejectMissingTypedAuthority(
        body: coreir.BodyIR,
        projection:
            var coreir.BodyIRLocalBindingValueDefinitionProjection) =
    var lowering: lower.LoweringPlanStub
    var typedFn: texpr.TypedExprIrFunction
    var rootSlot: int32
    var headerOffset: int32
    var elemKind: int32
    var elemSize: int32
    var indexNode: int32
    var fixedArray: bool
    assert(!primary.PrimaryBodyIrIndexedLvalueIdentityExact(
               body, projection, lowering, typedFn,
               0, 0, 0, rootSlot, headerOffset, elemKind,
               elemSize, indexNode, fixedArray),
           "local binding projection: primary accepted missing TypedExpr authority")
    assert(!backend2slots.PrimaryBodyIrIndexedLvalueIdentityExact(
               body, projection, lowering, typedFn,
               0, 0, 0, rootSlot, headerOffset, elemKind,
               elemSize, indexNode, fixedArray),
           "local binding projection: backend2 accepted missing TypedExpr authority")

fn main(): int32 =
    let negativeMode = os.GetEnv("CHENG_LOCAL_BINDING_PROJECTION_NEGATIVE")
    var body = buildBody()
    if negativeMode == "duplicate_bind":
        var projection =
            coreir.BodyIRLocalBindingValueDefinitionProjectionNew(body)
        coreir.BodyIRLocalBindingValueDefinitionProjectionSync(
            body, projection)
        coreir.BodyIRBindLocalBindingValueDefinitionRow(
            body, projection, 1, 100)
        panic("local binding projection: duplicate bind accepted")
    if negativeMode == "outside_bind":
        var projection =
            coreir.BodyIRLocalBindingValueDefinitionProjectionNew(body)
        coreir.BodyIRLocalBindingValueDefinitionProjectionSync(
            body, projection)
        coreir.BodyIRBindLocalBindingValueDefinitionRow(
            body, projection, 1, 104)
        panic("local binding projection: outside bind accepted")
    if negativeMode == "domain_drift":
        var projection =
            coreir.BodyIRLocalBindingValueDefinitionProjectionNew(body)
        body.localBindingValueDefinitionDomainStart = 101
        coreir.BodyIRLocalBindingValueDefinitionProjectionSync(
            body, projection)
        panic("local binding projection: domain drift accepted")

    var projection =
        coreir.BodyIRLocalBindingValueDefinitionProjectionNew(body)
    coreir.BodyIRLocalBindingValueDefinitionProjectionSync(body, projection)
    assert(coreir.BodyIRLocalSlotForBindingValueDefinitionRow(
               body, projection, 100) == 0 &&
           coreir.BodyIRLocalSlotForBindingValueDefinitionRow(
               body, projection, 101) == -1 &&
           coreir.BodyIRLocalSlotForBindingValueDefinitionRow(
               body, projection, 102) == 1 &&
           coreir.BodyIRLocalSlotForBindingValueDefinitionRow(
               body, projection, 103) == 2,
           "local binding projection: exact O(1) lookup")
    exactIndexedHelpersRejectMissingTypedAuthority(body, projection)
    var payload = codec.Backend2BodyIrEncode(body)
    assert(primary.PrimaryLowerPoolBodyIrPayloadPrevalidate(payload),
           "local binding projection: primary prevalidate")
    primaryPrevalidateMutationsReject(payload)
    rawbytes.BytesFree(payload)
    return 0
