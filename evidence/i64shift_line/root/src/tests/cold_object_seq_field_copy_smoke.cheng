type
    Body =
        values: int32[]

fn readCopied(items: Body[]): int32 =
    let body = items[0]
    if body.values.len <= 0:
        return -1
    return body.values[0]

fn main(): int32 =
    var body: Body
    add(body.values, 42)
    var items: Body[]
    add(items, body)
    if readCopied(items) != 42:
        return 1
    return 0
