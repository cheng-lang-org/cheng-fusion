# Text render probe (F-b): draws the alphabet, digits and punctuation on
# a rendered frame and writes it out for visual inspection; asserts the
# overlay actually landed by counting white-ish pixels in the caption band.
import cheng/game/csg/schema
import cheng/game/csg/producer
import cheng/game/csg/materializer
import cheng/game/world3d
import cheng/game/cinema/camera
import cheng/game/render/cpu_raster as raster
import cheng/game/render/character
import cheng/game/render/text
import std/os
import std/rawbytes
import std/strings as strings

const
    OutDir = "artifacts/csg_world_video/d1_probe"

@borrows
fn countBright(rgba: uint8[], lo: int32): int32 =
    var n: int32 = 0
    var i: int32 = 0
    while i < rgba.len / 4:
        let r: int32 = int32(rgba[i * 4])
        let g: int32 = int32(rgba[i * 4 + 1])
        let b: int32 = int32(rgba[i * 4 + 2])
        if r >= lo:
            if g >= lo:
                if b >= lo:
                    n = n + 1
        i = i + 1
    return n

fn main(): int32 =
    var facts: schema.CsgWorldFacts = producer.CsgProducerBuildClimbScene()
    var w: world3d.World3d
    var mp: materializer.CsgMaterializerMapping
    var err: str = ""
    if !materializer.CsgMaterialize(facts, w, mp, err):
        echo("FAIL materialize")
        return 1
    var partRoles: int32[]
    setLen(partRoles, 0)
    var ri: int32 = 0
    while ri < facts.partRole.len:
        add(partRoles, facts.partRole[ri])
        ri = ri + 1
    var camA = camera.CinemaCameraLookAt(-4.6, 3.2, 1.7, 0.0, 0.8, 1.35, 950.0, 1280, 720)
    var t: raster.RasterTarget
    t = raster.RasterMake(1280, 720)
    raster.RasterGround(t, camA)
    raster.RasterWallFace(t, camA, 0.5, -2.0, 2.0, 0.0, 4.0)
    character.RenderRope(t, camA, w)
    character.RenderCharacter(t, camA, w, partRoles)
    text.RasterText(t, 340, 640, 3, "THE ASCENT - A CLIMB IN 6 HOLDS", 240, 240, 220)
    text.RasterText(t, 40, 40, 2, "SHOT 1: THE WALL", 255, 255, 255)
    raster.RasterWritePpm(t, OutDir + "/text_probe.ppm")
    var bright: int32 = 0
    var bi: int32 = 0
    while bi < rawbytes.BytesLen(t.frame.bgra) / 4:
        let b: int32 = rawbytes.BytesGet(t.frame.bgra, bi * 4)
        let g: int32 = rawbytes.BytesGet(t.frame.bgra, bi * 4 + 1)
        let r: int32 = rawbytes.BytesGet(t.frame.bgra, bi * 4 + 2)
        if b >= 180:
            if g >= 180:
                if r >= 180:
                    bright = bright + 1
        bi = bi + 1
    echo("bright overlay pixels=" + strings.IntToStr(bright))
    if bright < 1500:
        echo("FAIL text overlay too small")
        return 1
    echo("PASS text render probe")
    return 0
