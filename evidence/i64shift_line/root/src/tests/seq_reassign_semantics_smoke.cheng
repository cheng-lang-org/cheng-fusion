import std/os as os
import std/system
import std/strformat

# Minimal probe: does `seq = []` reassignment release the previous storage?
# If yes, live allocations and RSS stay flat across the loop; if the old
# buffer leaks per iteration, both climb by ~16KB per iteration.
fn main(): int32 =
    var buf: int32[]
    var i: int32
    i = 0
    while i < 30000:
        setLen(buf, 4096)
        buf[0] = i
        if i % 10000 == 0:
            echo(Fmt"iter={i} live={system.MemLiveAllocations()} rss={os.ProcessRssBytes()}")
        buf = []
        i = i + 1
    setLen(buf, 4096)
    buf[0] = 7
    echo(Fmt"final live={system.MemLiveAllocations()} rss={os.ProcessRssBytes()}")
    return 0
