import std/os as os
import std/strings
import cheng/core/csg_core/jsonl
import cheng/core/csg_core/validator as csg

@borrows
fn smokeFail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

@borrows
fn smokeExpect(cond: bool, message: str): int32 =
    if !cond:
        return smokeFail(message)
    return 0

@borrows
fn smokePrintErrors(result: csg.CsgCoreValidationResult) =
    os.WriteLine(os.Get_stderr(), csg.CsgCoreValidationReportJson(result))
    for i in 0..<result.errors.len:
        os.WriteLine(os.Get_stderr(), result.errors[i])

fn main(): int32 =
    let schemaFact = "{\"features\":[\"core-facts\"],\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}"
    let moduleFact = "{\"id\":\"mod_main\",\"kind\":\"csg.module\",\"path\":\"main.ts\",\"sha256\":\"sha256:abc\"}"

    var minimalLines: str[]
    add(minimalLines, strings.CloneStr(schemaFact))
    add(minimalLines, strings.CloneStr(moduleFact))
    let minimalResult = csg.CsgCoreValidateFactLines(minimalLines, csg.CsgCoreModeStrict)
    if smokeExpect(minimalResult.valid, "minimal strict facts should validate") != 0:
        smokePrintErrors(minimalResult)
        return 1
    if smokeExpect(minimalResult.complete, "minimal strict facts should be complete") != 0:
        return 1
    if smokeExpect(minimalResult.factCount == 2, "minimal fact count mismatch") != 0:
        return 1
    if smokeExpect(minimalResult.standard == "csg_core::v1",
                   "minimal standard mismatch") != 0:
        return 1
    if smokeExpect(minimalResult.schema == "csg_core",
                   "minimal schema mismatch") != 0:
        return 1
    if smokeExpect(minimalResult.schemaNamespace == "csg_core::v1",
                   "minimal schema namespace mismatch") != 0:
        return 1
    if smokeExpect(minimalResult.runtimeRequirementCount == 0,
                   "minimal runtime requirement count mismatch") != 0:
        return 1
    if smokeExpect(
           minimalResult.runtimeRequirementsStatus ==
               csg.CsgCoreRuntimeRequirementsSatisfied,
           "minimal runtime requirements status mismatch") != 0:
        return 1
    let minimalRoot = minimalResult.factsRoot
    if smokeExpect(minimalRoot == "sha256:96cd287810b31addea6d5a031d9ed50f17bdf09a0c46d42c2b91501c66cd6ede",
                   "minimal canonical root mismatch") != 0:
        return 1
    let minimalText = strings.ConcatStr(strings.ConcatStr(schemaFact, "\n"), strings.ConcatStr(moduleFact, "\n"))
    let minimalJsonlLines = jsonl.CsgCoreJsonlSplitLines(minimalText)
    let minimalJsonlResult = csg.CsgCoreValidateFactLines(minimalJsonlLines, csg.CsgCoreModeStrict)
    if smokeExpect(minimalJsonlResult.valid, "minimal JSONL text should validate") != 0:
        return 1
    if smokeExpect(minimalJsonlResult.factsRoot == minimalRoot,
                   "minimal JSONL root mismatch") != 0:
        return 1

    let unknownFieldModule =
        "{\"id\":\"mod_main\",\"kind\":\"csg.module\",\"path\":\"main.ts\",\"semanticAlias\":true,\"sha256\":\"sha256:abc\"}"
    var unknownFieldLines: str[]
    add(unknownFieldLines, strings.CloneStr(schemaFact))
    add(unknownFieldLines, unknownFieldModule)
    let unknownFieldResult =
        csg.CsgCoreProductionAdmitFactLines(
            unknownFieldLines)
    if smokeExpect(
           !unknownFieldResult.valid &&
           !unknownFieldResult.complete &&
           unknownFieldResult.factsRoot.len == 0,
           "production facts must reject unknown top-level fields") != 0:
        return 1

    let redundantCompleteModule =
        "{\"complete\":true,\"id\":\"mod_main\",\"kind\":\"csg.module\",\"path\":\"main.ts\",\"sha256\":\"sha256:abc\"}"
    var redundantCompleteLines: str[]
    add(redundantCompleteLines, strings.CloneStr(schemaFact))
    add(redundantCompleteLines, redundantCompleteModule)
    let redundantCompleteResult =
        csg.CsgCoreProductionAdmitFactLines(
            redundantCompleteLines)
    if smokeExpect(
           !redundantCompleteResult.valid &&
           !redundantCompleteResult.complete &&
           redundantCompleteResult.factsRoot.len == 0,
           "production facts must reject redundant complete=true") != 0:
        return 1

    let duplicateFeatureSchema =
        "{\"features\":[\"core-facts\",\"core-facts\"],\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}"
    var duplicateFeatureLines: str[]
    add(duplicateFeatureLines, duplicateFeatureSchema)
    add(duplicateFeatureLines, strings.CloneStr(moduleFact))
    let duplicateFeatureResult =
        csg.CsgCoreProductionAdmitFactLines(
            duplicateFeatureLines)
    if smokeExpect(
           !duplicateFeatureResult.valid &&
           duplicateFeatureResult.factsRoot.len == 0,
           "production schema must reject duplicate features") != 0:
        return 1

    let reorderedFeatureSchema =
        "{\"features\":[\"runtime-closure\",\"core-facts\"],\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}"
    var reorderedFeatureLines: str[]
    add(reorderedFeatureLines, reorderedFeatureSchema)
    add(reorderedFeatureLines, strings.CloneStr(moduleFact))
    let reorderedFeatureResult =
        csg.CsgCoreProductionAdmitFactLines(
            reorderedFeatureLines)
    if smokeExpect(
           !reorderedFeatureResult.valid &&
           reorderedFeatureResult.factsRoot.len == 0,
           "production schema must reject reordered features") != 0:
        return 1

    let unknownFeatureSchema =
        "{\"features\":[\"future-feature\"],\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}"
    var unknownFeatureLines: str[]
    add(unknownFeatureLines, unknownFeatureSchema)
    add(unknownFeatureLines, strings.CloneStr(moduleFact))
    let unknownFeatureResult =
        csg.CsgCoreProductionAdmitFactLines(
            unknownFeatureLines)
    if smokeExpect(
           !unknownFeatureResult.valid &&
           unknownFeatureResult.factsRoot.len == 0,
           "production schema must reject unknown features") != 0:
        return 1

    let cTranslationUnitFact =
        "{\"functionCount\":0,\"id\":\"tu\",\"kind\":\"csg_dialect::c::translation_unit\",\"module\":\"m\",\"path\":\"m.c\",\"target\":\"arm64-apple-darwin\"}"
    var missingDialectFeatureLines: str[]
    add(missingDialectFeatureLines, strings.CloneStr(schemaFact))
    add(missingDialectFeatureLines, strings.CloneStr(cTranslationUnitFact))
    let missingDialectFeature =
        csg.CsgCoreProductionAdmitFactLines(
            missingDialectFeatureLines)
    if smokeExpect(
           !missingDialectFeature.valid &&
           missingDialectFeature.factsRoot.len == 0,
           "production schema must declare every observed fact family") != 0:
        return 1
    let extraRuntimeFeatureSchema =
        "{\"features\":[\"core-facts\",\"runtime-closure\"],\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}"
    var extraRuntimeFeatureLines: str[]
    add(extraRuntimeFeatureLines, extraRuntimeFeatureSchema)
    add(extraRuntimeFeatureLines, strings.CloneStr(moduleFact))
    let extraRuntimeFeature =
        csg.CsgCoreProductionAdmitFactLines(
            extraRuntimeFeatureLines)
    if smokeExpect(
           !extraRuntimeFeature.valid &&
           extraRuntimeFeature.factsRoot.len == 0,
           "production schema must not declare unobserved fact families") != 0:
        return 1
    let canonicalCFeatureSchema =
        "{\"features\":[\"core-facts\",\"runtime-closure\",\"csg_dialect::c\"],\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}"
    var canonicalCFeatureLines: str[]
    add(canonicalCFeatureLines, canonicalCFeatureSchema)
    add(canonicalCFeatureLines, strings.CloneStr(cTranslationUnitFact))
    let canonicalCFeature =
        csg.CsgCoreProductionAdmitFactLines(
            canonicalCFeatureLines)
    if smokeExpect(
           canonicalCFeature.valid && canonicalCFeature.complete,
           "production schema must admit the unique observed feature set") != 0:
        smokePrintErrors(canonicalCFeature)
        return 1

    let functionWithoutParameters =
        "{\"id\":\"f\",\"kind\":\"csg.function\",\"name\":\"f\",\"returnType\":\"void\",\"symbol\":\"s\"}"
    var functionWithoutParametersLines: str[]
    add(functionWithoutParametersLines, strings.CloneStr(schemaFact))
    add(functionWithoutParametersLines, functionWithoutParameters)
    let functionWithoutParametersResult =
        csg.CsgCoreProductionAdmitFactLines(
            functionWithoutParametersLines)
    if smokeExpect(
           !functionWithoutParametersResult.valid &&
           functionWithoutParametersResult.factsRoot.len == 0,
           "empty function parameters must use the unique [] encoding") != 0:
        return 1
    let functionWithEmptyParameters =
        "{\"id\":\"f\",\"kind\":\"csg.function\",\"name\":\"f\",\"parameters\":[],\"returnType\":\"void\",\"symbol\":\"s\"}"
    var functionWithEmptyParametersLines: str[]
    add(functionWithEmptyParametersLines, strings.CloneStr(schemaFact))
    add(functionWithEmptyParametersLines, functionWithEmptyParameters)
    let functionWithEmptyParametersResult =
        csg.CsgCoreProductionAdmitFactLines(
            functionWithEmptyParametersLines)
    if smokeExpect(
           functionWithEmptyParametersResult.valid &&
           functionWithEmptyParametersResult.complete,
           "canonical empty function parameters were rejected") != 0:
        smokePrintErrors(functionWithEmptyParametersResult)
        return 1
    let functionWithNullParameters =
        "{\"id\":\"f\",\"kind\":\"csg.function\",\"name\":\"f\",\"parameters\":null,\"returnType\":\"void\",\"symbol\":\"s\"}"
    var functionWithNullParametersLines: str[]
    add(functionWithNullParametersLines, strings.CloneStr(schemaFact))
    add(functionWithNullParametersLines, functionWithNullParameters)
    let functionWithNullParametersResult =
        csg.CsgCoreProductionAdmitFactLines(
            functionWithNullParametersLines)
    if smokeExpect(
           !functionWithNullParametersResult.valid &&
           functionWithNullParametersResult.factsRoot.len == 0,
           "null function parameters crossed production admission") != 0:
        return 1
    let functionWithUnknownParameterField =
        "{\"id\":\"f\",\"kind\":\"csg.function\",\"name\":\"f\",\"parameters\":[{\"name\":\"x\",\"semanticAlias\":true,\"type\":\"i32\"}],\"returnType\":\"void\",\"symbol\":\"s\"}"
    var functionWithUnknownParameterFieldLines: str[]
    add(functionWithUnknownParameterFieldLines, strings.CloneStr(schemaFact))
    add(functionWithUnknownParameterFieldLines,
        functionWithUnknownParameterField)
    let functionWithUnknownParameterFieldResult =
        csg.CsgCoreProductionAdmitFactLines(
            functionWithUnknownParameterFieldLines)
    if smokeExpect(
           !functionWithUnknownParameterFieldResult.valid &&
           functionWithUnknownParameterFieldResult.factsRoot.len == 0,
           "unknown nested parameter field crossed production admission") != 0:
        return 1

    let symbolWithUnknownLocField =
        "{\"id\":\"s\",\"kind\":\"csg.symbol\",\"loc\":{\"column\":0,\"file\":\"m.cheng\",\"line\":1,\"semanticAlias\":true},\"name\":\"s\",\"symbolKind\":\"fn\"}"
    var symbolWithUnknownLocFieldLines: str[]
    add(symbolWithUnknownLocFieldLines, strings.CloneStr(schemaFact))
    add(symbolWithUnknownLocFieldLines, symbolWithUnknownLocField)
    let symbolWithUnknownLocFieldResult =
        csg.CsgCoreProductionAdmitFactLines(
            symbolWithUnknownLocFieldLines)
    if smokeExpect(
           !symbolWithUnknownLocFieldResult.valid &&
           symbolWithUnknownLocFieldResult.factsRoot.len == 0,
           "unknown nested loc field crossed production admission") != 0:
        return 1

    let unsupportedFact = "{\"code\":\"unsupported_jsx\",\"id\":\"unsupported_one\",\"kind\":\"csg.unsupported\",\"message\":\"unsupported jsx\"}"
    var unsupportedLines: str[]
    add(unsupportedLines, strings.CloneStr(schemaFact))
    add(unsupportedLines, strings.CloneStr(moduleFact))
    add(unsupportedLines, unsupportedFact)
    let unsupportedResult = csg.CsgCoreValidateFactLines(unsupportedLines, csg.CsgCoreModeStrict)
    if smokeExpect(!unsupportedResult.valid, "strict unsupported fact should fail") != 0:
        return 1
    if smokeExpect(!unsupportedResult.complete, "unsupported fact must make report incomplete") != 0:
        return 1
    if smokeExpect(unsupportedResult.unsupportedCount == 1, "unsupported count mismatch") != 0:
        return 1
    let unsupportedSandbox = csg.CsgCoreValidateFactLines(unsupportedLines, csg.CsgCoreModeSandbox)
    if smokeExpect(unsupportedSandbox.valid, "sandbox unsupported fact should validate structurally") != 0:
        return 1
    if smokeExpect(!unsupportedSandbox.complete, "sandbox unsupported fact must stay incomplete") != 0:
        return 1

    let runtimeRequirementFact = "{\"id\":\"runtime_node\",\"kind\":\"csg.runtime_requirement\",\"name\":\"node\",\"requirementKind\":\"host_runtime\",\"runtime\":\"node\",\"source\":\"fixture\"}"
    let runtimeSchemaFact =
        "{\"features\":[\"core-facts\",\"runtime-closure\"],\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}"
    var runtimeRequirementLines: str[]
    add(runtimeRequirementLines, runtimeSchemaFact)
    add(runtimeRequirementLines, runtimeRequirementFact)
    let strictRuntimeRequirement =
        csg.CsgCoreValidateFactLines(
            runtimeRequirementLines, csg.CsgCoreModeStrict)
    if smokeExpect(!strictRuntimeRequirement.valid,
                   "strict runtime requirement should fail") != 0:
        return 1
    if smokeExpect(!strictRuntimeRequirement.complete,
                   "strict runtime requirement must be incomplete") != 0:
        return 1
    if smokeExpect(strictRuntimeRequirement.factsRoot.len == 0,
                   "strict runtime requirement must not emit facts root") != 0:
        return 1
    let sandboxRuntimeRequirement =
        csg.CsgCoreValidateFactLines(
            runtimeRequirementLines, csg.CsgCoreModeSandbox)
    if smokeExpect(sandboxRuntimeRequirement.valid,
                   "sandbox runtime requirement should validate structurally") != 0:
        return 1
    if smokeExpect(!sandboxRuntimeRequirement.complete,
                   "sandbox runtime requirement must stay incomplete") != 0:
        return 1
    if smokeExpect(sandboxRuntimeRequirement.runtimeRequirementCount == 1,
                   "sandbox runtime requirement count mismatch") != 0:
        return 1
    if smokeExpect(
           sandboxRuntimeRequirement.runtimeRequirementsStatus ==
               csg.CsgCoreRuntimeRequirementsOpen,
           "sandbox runtime requirements status mismatch") != 0:
        return 1
    if smokeExpect(sandboxRuntimeRequirement.factsRoot.len > 0,
                   "sandbox runtime requirement should expose quarantined root") != 0:
        return 1

    let explicitIncompleteFact = "{\"complete\":false,\"id\":\"mod_incomplete\",\"kind\":\"csg.module\",\"path\":\"incomplete.ts\",\"sha256\":\"sha256:def\"}"
    var explicitIncompleteLines: str[]
    add(explicitIncompleteLines, strings.CloneStr(schemaFact))
    add(explicitIncompleteLines, explicitIncompleteFact)
    let strictIncomplete =
        csg.CsgCoreValidateFactLines(
            explicitIncompleteLines, csg.CsgCoreModeStrict)
    if smokeExpect(!strictIncomplete.valid &&
                   strictIncomplete.factsRoot.len == 0,
                   "strict incomplete facts must not emit root") != 0:
        return 1
    let strictIncompleteReport =
        csg.CsgCoreValidationReportJson(strictIncomplete)
    if smokeExpect(!strings.strContains(
                       strictIncompleteReport,
                       "\"facts_root\""),
                   "strict incomplete report must omit facts_root") != 0:
        return 1
    let sandboxIncomplete =
        csg.CsgCoreValidateFactLines(
            explicitIncompleteLines, csg.CsgCoreModeSandbox)
    if smokeExpect(sandboxIncomplete.valid &&
                   !sandboxIncomplete.complete &&
                   sandboxIncomplete.factsRoot.len > 0,
                   "sandbox incomplete facts contract mismatch") != 0:
        return 1

    let tombstoneFact = "{\"id\":\"sym_0422_unsupported_node\",\"impact_scope\":\"dead_code_or_unreachable\",\"kind\":\"csg_core::tombstone\",\"original_text_hash\":\"sha256:abc\",\"reason\":\"unsupported_prototype_mutation\",\"schema\":\"csg_core\",\"source_span\":{\"col\":4,\"file\":\"pkg://npm/lodash/index.ts\",\"line\":12}}"
    var tombstoneLines: str[]
    add(tombstoneLines, strings.CloneStr(schemaFact))
    add(tombstoneLines, strings.CloneStr(moduleFact))
    add(tombstoneLines, tombstoneFact)
    let strictTombstone = csg.CsgCoreValidateFactLines(tombstoneLines, csg.CsgCoreModeStrict)
    if smokeExpect(!strictTombstone.valid, "strict tombstone should fail") != 0:
        return 1
    if smokeExpect(!strictTombstone.complete, "strict tombstone should be incomplete") != 0:
        return 1

    let sandboxTombstone = csg.CsgCoreValidateFactLines(tombstoneLines, csg.CsgCoreModeSandbox)
    if smokeExpect(sandboxTombstone.valid, "sandbox tombstone should validate structurally") != 0:
        return 1
    if smokeExpect(!sandboxTombstone.complete, "sandbox tombstone must stay incomplete") != 0:
        return 1
    if smokeExpect(sandboxTombstone.tombstoneCount == 1, "sandbox tombstone count mismatch") != 0:
        return 1
    let tombstoneRoot = sandboxTombstone.factsRoot
    if smokeExpect(tombstoneRoot == "sha256:f670c63ca95dead7cae6d0e5e28908d40162872c0fd6b350c668359455062dac",
                   "tombstone canonical root mismatch") != 0:
        return 1
    let tombstoneWithUnknownSpanField =
        "{\"id\":\"sym_0422_unsupported_node\",\"impact_scope\":\"dead_code_or_unreachable\",\"kind\":\"csg_core::tombstone\",\"original_text_hash\":\"sha256:abc\",\"reason\":\"unsupported_prototype_mutation\",\"schema\":\"csg_core\",\"source_span\":{\"col\":4,\"file\":\"pkg://npm/lodash/index.ts\",\"line\":12,\"semanticAlias\":true}}"
    var tombstoneWithUnknownSpanFieldLines: str[]
    add(tombstoneWithUnknownSpanFieldLines, strings.CloneStr(schemaFact))
    add(tombstoneWithUnknownSpanFieldLines,
        tombstoneWithUnknownSpanField)
    let tombstoneWithUnknownSpanFieldResult =
        csg.CsgCoreValidateFactLines(
            tombstoneWithUnknownSpanFieldLines,
            csg.CsgCoreModeSandbox)
    if smokeExpect(
           !tombstoneWithUnknownSpanFieldResult.valid &&
           tombstoneWithUnknownSpanFieldResult.factsRoot.len == 0,
           "unknown nested source_span field crossed validation") != 0:
        return 1

    var missingSchemaLines: str[]
    add(missingSchemaLines, strings.CloneStr(moduleFact))
    let missingSchema = csg.CsgCoreValidateFactLines(missingSchemaLines, csg.CsgCoreModeStrict)
    if smokeExpect(!missingSchema.valid, "missing schema should fail") != 0:
        return 1

    let badModuleFact = "{\"id\":\"mod_bad\",\"kind\":\"csg.module\",\"path\":\"bad.ts\"}"
    var badModuleLines: str[]
    add(badModuleLines, strings.CloneStr(schemaFact))
    add(badModuleLines, badModuleFact)
    let badModule = csg.CsgCoreValidateFactLines(badModuleLines, csg.CsgCoreModeStrict)
    if smokeExpect(!badModule.valid, "missing module sha256 should fail") != 0:
        return 1

    let nonStringIdFact = "{\"id\":7,\"kind\":\"csg.module\",\"path\":\"bad.ts\",\"sha256\":\"sha256:abc\"}"
    var nonStringIdLines: str[]
    add(nonStringIdLines, strings.CloneStr(schemaFact))
    add(nonStringIdLines, nonStringIdFact)
    let nonStringId = csg.CsgCoreValidateFactLines(nonStringIdLines, csg.CsgCoreModeStrict)
    if smokeExpect(!nonStringId.valid, "non-string id should fail") != 0:
        return 1

    var duplicateLines: str[]
    add(duplicateLines, strings.CloneStr(schemaFact))
    add(duplicateLines, strings.CloneStr(moduleFact))
    add(duplicateLines, "{\"id\":\"mod_main\",\"kind\":\"csg.module\",\"path\":\"other.ts\",\"sha256\":\"sha256:def\"}")
    let duplicateId = csg.CsgCoreValidateFactLines(duplicateLines, csg.CsgCoreModeStrict)
    if smokeExpect(!duplicateId.valid, "duplicate id should fail") != 0:
        return 1

    let report = csg.CsgCoreValidationReportJson(sandboxTombstone)
    if smokeExpect(strings.strContains(report, "\"standard\":\"csg_core::v1\""), "report should contain canonical standard") != 0:
        return 1
    if smokeExpect(strings.strContains(report, "\"schema\":\"csg_core\""), "report should contain canonical schema") != 0:
        return 1
    if smokeExpect(strings.strContains(report, "\"schema_namespace\":\"csg_core::v1\""), "report should contain canonical schema namespace") != 0:
        return 1
    if smokeExpect(strings.strContains(report, "\"profiles\":["), "report should contain profiles") != 0:
        return 1
    if smokeExpect(strings.strContains(report, "\"profile_set_cid\":\"sha256:"), "report should contain profile_set_cid") != 0:
        return 1
    if smokeExpect(strings.strContains(report, "\"facts_root\":\"sha256:"), "report should contain facts_root") != 0:
        return 1
    if smokeExpect(strings.strContains(report, "\"complete\":false"), "report should contain complete=false") != 0:
        return 1
    if smokeExpect(strings.strContains(report, "\"tombstone_count\":1"), "report should contain tombstone_count") != 0:
        return 1
    if smokeExpect(strings.strContains(report, "\"runtime_requirement_count\":0"), "report should contain runtime requirement count") != 0:
        return 1
    if smokeExpect(strings.strContains(report, "\"runtime_requirements_status\":\"satisfied\""), "report should contain runtime requirements status") != 0:
        return 1
    if smokeExpect(!strings.strContains(report, "factsRoot") &&
                   !strings.strContains(report, "profileSetCid") &&
                   !strings.strContains(report, "planRoot"),
                   "report must reject legacy camelCase fields") != 0:
        return 1

    os.WriteLine(os.Get_stdout(), "csg_core_pure_validate_smoke ok")
    return 0
