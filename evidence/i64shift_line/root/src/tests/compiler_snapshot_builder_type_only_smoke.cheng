import std/strings as strings
import std/strutils as strutils

fn TypeOnlyCloneLines(lines: str[]): str[] =
    var out: str[]
    for row in 0..<lines.len:
        add(out, lines[row])
    return out

fn TypeOnlyIntArrayJson(values: int32[]): str =
    var parts: str[]
    for row in 0..<values.len:
        add(parts, strings.IntToStr(values[row]))
    return strings.ConcatStr(
        strings.ConcatStr("[", strutils.Join(parts, ",")), "]")

fn TypeOnlyCidArrayJson(values: layout.FixedBytes32[]): str =
    var parts: str[]
    for row in 0..<values.len:
        add(parts, strings.ConcatStr(
            strings.ConcatStr(
                "\"sha256:",
                layout.FixedBytes32Hex(values[row])),
            "\""))
    return strings.ConcatStr(
        strings.ConcatStr("[", strutils.Join(parts, ",")), "]")

fn TypeOnlyReplaceField(
        line: str,
        key: str,
        oldRaw: str,
        newRaw: str): str =
    let prefix =
        strings.ConcatStr(strings.ConcatStr("\"", key), "\":")
    let oldField = strings.ConcatStr(prefix, oldRaw)
    let newField = strings.ConcatStr(prefix, newRaw)
    let out = strutils.Replace(line, oldField, newField)
    assert(out != line,
           strings.ConcatStr(
               "compiler snapshot builder type-only smoke: field replacement missed ",
               key))
    return out

fn TypeOnlyWireLinesStrictValid(lines: str[]): bool =
    return validator.CsgCoreValidateFactLines(
               lines, validator.CsgCoreModeStrict).valid

fn TypeOnlyAnnotationScaleCloneInto(
        base: var schema.CsgCompilerSnapshotTables,
        annotationCount: int32,
        out: var schema.CsgCompilerSnapshotTables,
        err: var str): bool =
    if annotationCount < 2 ||
       base.parserSidecars.annotationProducerSourceIds.len != 1 ||
       base.annotationTargets.sourceIds.len != 1:
        err = " compiler snapshot builder type-only smoke: annotation scale base invalid"
        return false
    out = schema.CsgCompilerSnapshotTablesClone(base)
    let sourceId =
        out.parserSidecars.annotationProducerSourceIds[0]
    let nameTokenId =
        out.parserSidecars.annotationNameTokenIds[0]
    let targetTokenId =
        out.parserSidecars.annotationTargetTokenIds[0]
    let annotationSpanId =
        out.parserSidecars.annotationSpanIds[0]
    let rootCursor =
        out.parserSidecars.annotationArgRootIds.len
    let targetParserDeclaration =
        out.annotationTargets.targetParserDeclarationRows[0]
    let targetSymbolId =
        out.annotationTargets.targetSymbolIds[0]
    let targetDeclId =
        out.annotationTargets.targetDeclIds[0]
    let targetDeclKeyCid =
        out.annotationTargets.targetDeclKeyCids[0]
    for row in 1..<annotationCount:
        add(out.parserSidecars.annotationProducerSourceIds,
            sourceId)
        add(out.parserSidecars.annotationSourceLocalRows, row)
        add(out.parserSidecars.annotationNameTokenIds, nameTokenId)
        add(out.parserSidecars.annotationTargetTokenIds,
            targetTokenId)
        add(out.parserSidecars.annotationSpanIds, annotationSpanId)
        add(out.parserSidecars.annotationArgRootStarts, rootCursor)
        add(out.parserSidecars.annotationArgRootCounts, 0)
        add(out.parserSidecars.annotationIdentityCids,
            layout.FixedBytes32())
        var identityCid: layout.FixedBytes32
        if !schema.CsgCompilerParserAnnotationIdentityCidInto(
               out, row, identityCid, err):
            return false
        out.parserSidecars.annotationIdentityCids[row] =
            identityCid
        add(out.annotationTargets.sourceIds, sourceId)
        add(out.annotationTargets.parserAnnotationRows, row)
        add(out.annotationTargets.targetTokenIds, targetTokenId)
        add(out.annotationTargets.targetParserDeclarationRows,
            targetParserDeclaration)
        add(out.annotationTargets.targetSymbolIds, targetSymbolId)
        add(out.annotationTargets.targetDeclIds, targetDeclId)
        add(out.annotationTargets.targetDeclKeyCids, targetDeclKeyCid)
    err = ""
    return true

fn TypeOnlyAnnotationWireScaleStrictValidate(
        base: var schema.CsgCompilerSnapshotTables,
        scaled: var schema.CsgCompilerSnapshotTables,
        err: var str): bool =
    var cargo =
        snapshot_cargo.CsgCompilerSnapshotCargoBuild(base)
    if !cargo.ok:
        err = cargo.error
        return false
    var lines = TypeOnlyCloneLines(cargo.canonicalLines)
    let parserLine = int32(7)
    let targetLine = int32(11)
    lines[parserLine] = TypeOnlyReplaceField(
        lines[parserLine],
        "annotationProducerSourceIds",
        TypeOnlyIntArrayJson(
            base.parserSidecars.annotationProducerSourceIds),
        TypeOnlyIntArrayJson(
            scaled.parserSidecars.annotationProducerSourceIds))
    lines[parserLine] = TypeOnlyReplaceField(
        lines[parserLine],
        "annotationSourceLocalRows",
        TypeOnlyIntArrayJson(
            base.parserSidecars.annotationSourceLocalRows),
        TypeOnlyIntArrayJson(
            scaled.parserSidecars.annotationSourceLocalRows))
    lines[parserLine] = TypeOnlyReplaceField(
        lines[parserLine],
        "annotationNameTokenIds",
        TypeOnlyIntArrayJson(
            base.parserSidecars.annotationNameTokenIds),
        TypeOnlyIntArrayJson(
            scaled.parserSidecars.annotationNameTokenIds))
    lines[parserLine] = TypeOnlyReplaceField(
        lines[parserLine],
        "annotationTargetTokenIds",
        TypeOnlyIntArrayJson(
            base.parserSidecars.annotationTargetTokenIds),
        TypeOnlyIntArrayJson(
            scaled.parserSidecars.annotationTargetTokenIds))
    lines[parserLine] = TypeOnlyReplaceField(
        lines[parserLine],
        "annotationSpanIds",
        TypeOnlyIntArrayJson(
            base.parserSidecars.annotationSpanIds),
        TypeOnlyIntArrayJson(
            scaled.parserSidecars.annotationSpanIds))
    lines[parserLine] = TypeOnlyReplaceField(
        lines[parserLine],
        "annotationArgRootStarts",
        TypeOnlyIntArrayJson(
            base.parserSidecars.annotationArgRootStarts),
        TypeOnlyIntArrayJson(
            scaled.parserSidecars.annotationArgRootStarts))
    lines[parserLine] = TypeOnlyReplaceField(
        lines[parserLine],
        "annotationArgRootCounts",
        TypeOnlyIntArrayJson(
            base.parserSidecars.annotationArgRootCounts),
        TypeOnlyIntArrayJson(
            scaled.parserSidecars.annotationArgRootCounts))
    lines[parserLine] = TypeOnlyReplaceField(
        lines[parserLine],
        "annotationIdentityCids",
        TypeOnlyCidArrayJson(
            base.parserSidecars.annotationIdentityCids),
        TypeOnlyCidArrayJson(
            scaled.parserSidecars.annotationIdentityCids))
    lines[targetLine] = TypeOnlyReplaceField(
        lines[targetLine],
        "sourceIds",
        TypeOnlyIntArrayJson(base.annotationTargets.sourceIds),
        TypeOnlyIntArrayJson(scaled.annotationTargets.sourceIds))
    lines[targetLine] = TypeOnlyReplaceField(
        lines[targetLine],
        "parserAnnotationRows",
        TypeOnlyIntArrayJson(
            base.annotationTargets.parserAnnotationRows),
        TypeOnlyIntArrayJson(
            scaled.annotationTargets.parserAnnotationRows))
    lines[targetLine] = TypeOnlyReplaceField(
        lines[targetLine],
        "targetTokenIds",
        TypeOnlyIntArrayJson(
            base.annotationTargets.targetTokenIds),
        TypeOnlyIntArrayJson(
            scaled.annotationTargets.targetTokenIds))
    lines[targetLine] = TypeOnlyReplaceField(
        lines[targetLine],
        "targetParserDeclarationRows",
        TypeOnlyIntArrayJson(
            base.annotationTargets.targetParserDeclarationRows),
        TypeOnlyIntArrayJson(
            scaled.annotationTargets.targetParserDeclarationRows))
    lines[targetLine] = TypeOnlyReplaceField(
        lines[targetLine],
        "targetSymbolIds",
        TypeOnlyIntArrayJson(
            base.annotationTargets.targetSymbolIds),
        TypeOnlyIntArrayJson(
            scaled.annotationTargets.targetSymbolIds))
    lines[targetLine] = TypeOnlyReplaceField(
        lines[targetLine],
        "targetDeclIds",
        TypeOnlyIntArrayJson(
            base.annotationTargets.targetDeclIds),
        TypeOnlyIntArrayJson(
            scaled.annotationTargets.targetDeclIds))
    lines[targetLine] = TypeOnlyReplaceField(
        lines[targetLine],
        "targetDeclKeyCids",
        TypeOnlyCidArrayJson(
            base.annotationTargets.targetDeclKeyCids),
        TypeOnlyCidArrayJson(
            scaled.annotationTargets.targetDeclKeyCids))
    let validation =
        validator.CsgCoreValidateFactLines(
            lines, validator.CsgCoreModeStrict)
    snapshot_cargo.CsgCompilerSnapshotCargoRelease(cargo)
    if !validation.valid:
        err = validation.errors.len > 0 ?
            validation.errors[0] :
            " compiler snapshot builder type-only smoke: wire annotation scale validation failed"
        return false
    err = ""
    return true

fn TypeOnlyAnnotationWireMutationsReject(
        tables: var schema.CsgCompilerSnapshotTables,
        err: var str): bool =
    var cargo =
        snapshot_cargo.CsgCompilerSnapshotCargoBuild(tables)
    if !cargo.ok:
        err = cargo.error
        return false
    let targetLine = int32(11)
    let parserLine = int32(7)
    var missing = TypeOnlyCloneLines(cargo.canonicalLines)
    missing[targetLine] = TypeOnlyReplaceField(
        missing[targetLine], "sourceIds",
        TypeOnlyIntArrayJson(tables.annotationTargets.sourceIds),
        "[]")
    missing[targetLine] = TypeOnlyReplaceField(
        missing[targetLine], "parserAnnotationRows",
        TypeOnlyIntArrayJson(
            tables.annotationTargets.parserAnnotationRows),
        "[]")
    missing[targetLine] = TypeOnlyReplaceField(
        missing[targetLine], "targetTokenIds",
        TypeOnlyIntArrayJson(
            tables.annotationTargets.targetTokenIds),
        "[]")
    missing[targetLine] = TypeOnlyReplaceField(
        missing[targetLine], "targetParserDeclarationRows",
        TypeOnlyIntArrayJson(
            tables.annotationTargets.targetParserDeclarationRows),
        "[]")
    missing[targetLine] = TypeOnlyReplaceField(
        missing[targetLine], "targetSymbolIds",
        TypeOnlyIntArrayJson(
            tables.annotationTargets.targetSymbolIds),
        "[]")
    missing[targetLine] = TypeOnlyReplaceField(
        missing[targetLine], "targetDeclIds",
        TypeOnlyIntArrayJson(
            tables.annotationTargets.targetDeclIds),
        "[]")
    missing[targetLine] = TypeOnlyReplaceField(
        missing[targetLine], "targetDeclKeyCids",
        TypeOnlyCidArrayJson(
            tables.annotationTargets.targetDeclKeyCids),
        "[]")
    if TypeOnlyWireLinesStrictValid(missing):
        snapshot_cargo.CsgCompilerSnapshotCargoRelease(cargo)
        err = " compiler snapshot builder type-only smoke: wire missing annotation target accepted"
        return false
    var duplicate = TypeOnlyCloneLines(cargo.canonicalLines)
    let sourceId = tables.annotationTargets.sourceIds[0]
    let parserRow = tables.annotationTargets.parserAnnotationRows[0]
    let targetTokenId = tables.annotationTargets.targetTokenIds[0]
    let targetParserDeclaration =
        tables.annotationTargets.targetParserDeclarationRows[0]
    let targetSymbolId =
        tables.annotationTargets.targetSymbolIds[0]
    let targetDeclId = tables.annotationTargets.targetDeclIds[0]
    let targetDeclKeyCid =
        tables.annotationTargets.targetDeclKeyCids[0]
    duplicate[targetLine] = TypeOnlyReplaceField(
        duplicate[targetLine], "sourceIds",
        TypeOnlyIntArrayJson(tables.annotationTargets.sourceIds),
        TypeOnlyIntArrayJson([sourceId, sourceId]))
    duplicate[targetLine] = TypeOnlyReplaceField(
        duplicate[targetLine], "parserAnnotationRows",
        TypeOnlyIntArrayJson(
            tables.annotationTargets.parserAnnotationRows),
        TypeOnlyIntArrayJson([parserRow, parserRow]))
    duplicate[targetLine] = TypeOnlyReplaceField(
        duplicate[targetLine], "targetTokenIds",
        TypeOnlyIntArrayJson(
            tables.annotationTargets.targetTokenIds),
        TypeOnlyIntArrayJson([targetTokenId, targetTokenId]))
    duplicate[targetLine] = TypeOnlyReplaceField(
        duplicate[targetLine], "targetParserDeclarationRows",
        TypeOnlyIntArrayJson(
            tables.annotationTargets.targetParserDeclarationRows),
        TypeOnlyIntArrayJson([
            targetParserDeclaration,
            targetParserDeclaration]))
    duplicate[targetLine] = TypeOnlyReplaceField(
        duplicate[targetLine], "targetSymbolIds",
        TypeOnlyIntArrayJson(
            tables.annotationTargets.targetSymbolIds),
        TypeOnlyIntArrayJson([targetSymbolId, targetSymbolId]))
    duplicate[targetLine] = TypeOnlyReplaceField(
        duplicate[targetLine], "targetDeclIds",
        TypeOnlyIntArrayJson(
            tables.annotationTargets.targetDeclIds),
        TypeOnlyIntArrayJson([targetDeclId, targetDeclId]))
    duplicate[targetLine] = TypeOnlyReplaceField(
        duplicate[targetLine], "targetDeclKeyCids",
        TypeOnlyCidArrayJson(
            tables.annotationTargets.targetDeclKeyCids),
        TypeOnlyCidArrayJson([targetDeclKeyCid, targetDeclKeyCid]))
    if TypeOnlyWireLinesStrictValid(duplicate):
        snapshot_cargo.CsgCompilerSnapshotCargoRelease(cargo)
        err = " compiler snapshot builder type-only smoke: wire duplicate annotation target accepted"
        return false
    var wrong = TypeOnlyCloneLines(cargo.canonicalLines)
    var wrongSymbolId: int32 = -1
    for symbolId in 0..<tables.symbols.symbolCids.len:
        if symbolId != targetSymbolId:
            wrongSymbolId = symbolId
            break
    if wrongSymbolId < 0:
        snapshot_cargo.CsgCompilerSnapshotCargoRelease(cargo)
        err = " compiler snapshot builder type-only smoke: wire wrong target fixture missing"
        return false
    wrong[targetLine] = TypeOnlyReplaceField(
        wrong[targetLine], "targetSymbolIds",
        TypeOnlyIntArrayJson(
            tables.annotationTargets.targetSymbolIds),
        TypeOnlyIntArrayJson([wrongSymbolId]))
    if TypeOnlyWireLinesStrictValid(wrong):
        snapshot_cargo.CsgCompilerSnapshotCargoRelease(cargo)
        err = " compiler snapshot builder type-only smoke: wire wrong annotation target accepted"
        return false
    var wrongDeclKey = TypeOnlyCloneLines(cargo.canonicalLines)
    var attackedDeclKeys: layout.FixedBytes32[]
    for row in 0..<tables.annotationTargets.targetDeclKeyCids.len:
        add(attackedDeclKeys,
            tables.annotationTargets.targetDeclKeyCids[row])
    attackedDeclKeys[0].data[0] =
        uint8(Int32(attackedDeclKeys[0].data[0]) ^ 1)
    wrongDeclKey[targetLine] = TypeOnlyReplaceField(
        wrongDeclKey[targetLine], "targetDeclKeyCids",
        TypeOnlyCidArrayJson(
            tables.annotationTargets.targetDeclKeyCids),
        TypeOnlyCidArrayJson(attackedDeclKeys))
    if TypeOnlyWireLinesStrictValid(wrongDeclKey):
        snapshot_cargo.CsgCompilerSnapshotCargoRelease(cargo)
        err = " compiler snapshot builder type-only smoke: wire annotation DeclKeyCid flip accepted"
        return false
    var ambiguous = TypeOnlyCloneLines(cargo.canonicalLines)
    var declarationSpans: int32[]
    for row in 0..<
            tables.parserSidecars.declarationSpanIds.len:
        add(declarationSpans,
            tables.parserSidecars.declarationSpanIds[row])
    var ambiguousSpans: int32[]
    for row in 0..<declarationSpans.len:
        add(ambiguousSpans, declarationSpans[row])
    let anchorSpanId =
        tables.tokens.spanIds[targetTokenId]
    var ambiguousDeclaration: int32 = -1
    for declarationRow in 0..<ambiguousSpans.len:
        if declarationRow != targetParserDeclaration &&
           tables.parserSidecars.declarationProducerSourceIds[
               declarationRow] == sourceId:
            ambiguousDeclaration = declarationRow
            break
    if ambiguousDeclaration < 0:
        snapshot_cargo.CsgCompilerSnapshotCargoRelease(cargo)
        err = " compiler snapshot builder type-only smoke: wire ambiguous target fixture missing"
        return false
    ambiguousSpans[ambiguousDeclaration] = anchorSpanId
    ambiguous[parserLine] = TypeOnlyReplaceField(
        ambiguous[parserLine], "declarationSpanIds",
        TypeOnlyIntArrayJson(declarationSpans),
        TypeOnlyIntArrayJson(ambiguousSpans))
    let ambiguityRejected =
        !TypeOnlyWireLinesStrictValid(ambiguous)
    snapshot_cargo.CsgCompilerSnapshotCargoRelease(cargo)
    if !ambiguityRejected:
        err = " compiler snapshot builder type-only smoke: wire ambiguous annotation target accepted"
        return false
    err = ""
    return true

fn TypeOnlyAnnotationScaleAndMutationsStrictValidate(
        tables: var schema.CsgCompilerSnapshotTables,
        err: var str): bool =
    if tables.annotationTargets.sourceIds.len != 1 ||
       tables.annotationTargets.parserAnnotationRows[0] != 0 ||
       tables.annotationTargets.targetTokenIds[0] !=
           tables.parserSidecars.annotationTargetTokenIds[0]:
        err = " compiler snapshot builder type-only smoke: builder annotation target projection missing"
        return false
    let scaleCount = int32(4096)
    var scaled: schema.CsgCompilerSnapshotTables
    if !TypeOnlyAnnotationScaleCloneInto(
           tables, scaleCount, scaled, err) ||
       !schema.CsgCompilerAnnotationTargetsStrictValidateInto(
           scaled, err) ||
       !TypeOnlyAnnotationWireScaleStrictValidate(
           tables, scaled, err) ||
       !TypeOnlyAnnotationWireMutationsReject(tables, err):
        return false
    var missing =
        schema.CsgCompilerSnapshotTablesClone(tables)
    missing.annotationTargets =
        schema.CsgCompilerAnnotationTargetTable()
    if schema.CsgCompilerAnnotationTargetsStrictValidateInto(
           missing, err):
        err = " compiler snapshot builder type-only smoke: missing annotation target accepted"
        return false
    var duplicate =
        schema.CsgCompilerSnapshotTablesClone(tables)
    add(duplicate.annotationTargets.sourceIds,
        duplicate.annotationTargets.sourceIds[0])
    add(duplicate.annotationTargets.parserAnnotationRows,
        duplicate.annotationTargets.parserAnnotationRows[0])
    add(duplicate.annotationTargets.targetTokenIds,
        duplicate.annotationTargets.targetTokenIds[0])
    add(duplicate.annotationTargets.targetParserDeclarationRows,
        duplicate.annotationTargets.targetParserDeclarationRows[0])
    add(duplicate.annotationTargets.targetSymbolIds,
        duplicate.annotationTargets.targetSymbolIds[0])
    add(duplicate.annotationTargets.targetDeclIds,
        duplicate.annotationTargets.targetDeclIds[0])
    add(duplicate.annotationTargets.targetDeclKeyCids,
        duplicate.annotationTargets.targetDeclKeyCids[0])
    if schema.CsgCompilerAnnotationTargetsStrictValidateInto(
           duplicate, err):
        err = " compiler snapshot builder type-only smoke: duplicate annotation target accepted"
        return false
    var wrong =
        schema.CsgCompilerSnapshotTablesClone(tables)
    let targetSymbolId =
        wrong.annotationTargets.targetSymbolIds[0]
    var wrongSymbolId: int32 = -1
    for symbolId in 0..<wrong.symbols.symbolCids.len:
        if symbolId != targetSymbolId:
            wrongSymbolId = symbolId
            break
    if wrongSymbolId < 0:
        err = " compiler snapshot builder type-only smoke: wrong annotation target fixture missing"
        return false
    wrong.annotationTargets.targetSymbolIds[0] = wrongSymbolId
    if schema.CsgCompilerAnnotationTargetsStrictValidateInto(
           wrong, err):
        err = " compiler snapshot builder type-only smoke: wrong annotation target accepted"
        return false
    var wrongDeclKey =
        schema.CsgCompilerSnapshotTablesClone(tables)
    wrongDeclKey.annotationTargets.targetDeclKeyCids[0].data[0] =
        uint8(
            Int32(
                wrongDeclKey.annotationTargets.targetDeclKeyCids[
                    0].data[0]) ^ 1)
    if schema.CsgCompilerAnnotationTargetsStrictValidateInto(
           wrongDeclKey, err):
        err = " compiler snapshot builder type-only smoke: annotation DeclKeyCid flip accepted"
        return false
    var ambiguous =
        schema.CsgCompilerSnapshotTablesClone(tables)
    let targetParserDeclaration =
        ambiguous.annotationTargets.targetParserDeclarationRows[0]
    let targetTokenId =
        ambiguous.annotationTargets.targetTokenIds[0]
    let anchorSpanId =
        ambiguous.tokens.spanIds[targetTokenId]
    var ambiguousDeclaration: int32 = -1
    for declarationRow in 0..<
            ambiguous.parserSidecars.declarationKinds.len:
        if declarationRow != targetParserDeclaration &&
           ambiguous.parserSidecars.declarationProducerSourceIds[
               declarationRow] ==
               ambiguous.annotationTargets.sourceIds[0]:
            ambiguousDeclaration = declarationRow
            break
    if ambiguousDeclaration < 0:
        err = " compiler snapshot builder type-only smoke: ambiguous annotation fixture missing"
        return false
    ambiguous.parserSidecars.declarationSpanIds[
        ambiguousDeclaration] = anchorSpanId
    if schema.CsgCompilerAnnotationTargetsStrictValidateInto(
           ambiguous, err):
        err = " compiler snapshot builder type-only smoke: ambiguous annotation target accepted"
        return false
    echo(Fmt"compiler_snapshot_builder_type_only_annotation_scale_count={scaleCount}")
    echo("compiler_snapshot_builder_type_only_annotation_mutations_rejected=1")
    err = ""
    return true

fn TypeOnlyBuildCsg(
        root: str,
        sourcePath: str,
        sourceText: str,
        csg: var compiler_csg.CompilerCsg,
        err: var str): bool =
    let request = creq.CompilerRequestNew(
        root,
        sourcePath,
        chengpath.PathJoin(
            root,
            "artifacts/compiler_snapshot_builder/type_only.o"),
        "arm64-apple-darwin",
        creq.EmitObj,
        "")
    var plan: slplan.SystemLinkPlanStub
    if !slplan.BuildSystemLinkPlanStub(root, request, plan, err):
        return false
    let sourceBundle = slplan.SystemLinkPlanSourceBundleCid(plan)
    if IsErr(sourceBundle):
        err = Error(sourceBundle)
        return false
    let entrySourceIndex = plan.sourceBundleEntrySourceIndex
    if entrySourceIndex < 0 ||
       entrySourceIndex >= plan.ownerModulePaths.len:
        err = " compiler snapshot builder type-only smoke: entry source identity missing"
        return false
    var sourceReceipt: compiler_csg.PortableSourceIdentityReceipt
    if !compiler_csg.PortableSourceIdentityReceiptMakeInto(
            plan.sourceClosurePaths.len,
            plan.importEdges.len,
            plan.unresolvedImportCount,
            plan.packageId,
            plan.ownerModulePaths[entrySourceIndex],
            Value(sourceBundle),
            slplan.SystemLinkPlanSourceBundleEntrySourceCid(plan),
            slplan.SystemLinkPlanSourceBundleImportGraphCid(plan),
            sourceReceipt,
            err):
        return false
    return compiler_csg.BuildCompilerCsgConsumePortableReceiptInto(
        csg, err, plan, sourceReceipt)

fn TypeOnlyCurrentFactsInto(
        csg: var compiler_csg.CompilerCsg,
        tables: var schema.CsgCompilerSnapshotTables,
        sourceText: str,
        out: var incremental.SemanticSnapshotIncrementalPrebuildFacts,
        err: var str): bool =
    var eventState: semantic_snapshot.WorkspaceSourceEventState
    if !semantic_snapshot.WorkspaceSourceEventStateInitInto(
            csg.sourceBundleCid, eventState, err):
        return false
    var sourceVersion: int64
    let documentCid = tables.sources.documentCids[0]
    if !semantic_snapshot.WorkspaceSourceEventAcceptInto(
            eventState,
            semantic_snapshot.SemanticSourceEventOpen,
            documentCid,
            int64(0),
            sourceVersion,
            err) ||
       !semantic_snapshot.WorkspaceSourceEventAcceptInto(
            eventState,
            semantic_snapshot.SemanticSourceEventChange,
            documentCid,
            int64(1),
            sourceVersion,
            err):
        return false
    var input: incremental.SemanticSnapshotIncrementalPrebuildInput
    input.worldHeadCid = csg.canonicalGraphCid
    input.compilerCid = csg.graphCid
    input.sourceBundleCid = csg.sourceBundleCid
    input.frontEndReceiptCid =
        csg.parserNormalizedExprReceipt.envelope.receiptRaw32
    add(input.documentCids, documentCid)
    add(input.sourceProducerIndexes, 0)
    add(input.sourceTexts, sourceText)
    add(input.sourceInterfaceCids,
        tables.sources.interfaceCids[0])
    return incremental.SemanticSnapshotIncrementalPrebuildFactsMakeInto(
        eventState, input, out, err)

fn TypeOnlyPreviousPlanInto(
        current: incremental.SemanticSnapshotIncrementalPrebuildFacts,
        previous: var schema.CsgCompilerSnapshotTables,
        plan: var incremental.SemanticSnapshotIncrementalPrebuildPlan,
        err: var str): bool =
    previous = schema_smoke.BuildSnapshot()
    var cargo = snapshot_cargo.CsgCompilerSnapshotCargoBuild(previous)
    if !cargo.ok:
        err = cargo.error
        return false
    var eventState: semantic_snapshot.WorkspaceSourceEventState
    var sourceVersion: int64
    if !semantic_snapshot.WorkspaceSourceEventStateInitInto(
            current.workspaceSessionCid, eventState, err) ||
       !semantic_snapshot.WorkspaceSourceEventAcceptInto(
            eventState,
            semantic_snapshot.SemanticSourceEventOpen,
            previous.sources.documentCids[0],
            int64(0),
            sourceVersion,
            err):
        snapshot_cargo.CsgCompilerSnapshotCargoRelease(cargo)
        return false
    var identity: semantic_snapshot.PortableSemanticSnapshotIdentity
    var binding: semantic_snapshot.LocalSourceVersionBinding
    var validation: semantic_snapshot.SemanticSnapshotValidationReceipt
    if !semantic_snapshot.PortableSemanticSnapshotIdentityMakeInto(
            current.worldHeadCid,
            previous.sources.contentCids[0],
            current.compilerCid,
            previous.sources.interfaceCids[0],
            cargo.factsRootCid,
            identity,
            err) ||
       !semantic_snapshot.LocalSourceVersionBindingMakeInto(
            eventState, identity, binding, err):
        snapshot_cargo.CsgCompilerSnapshotCargoRelease(cargo)
        return false
    var queryIndex: query_projection.SemanticSnapshotQueryIndex
    if !query_projection.SemanticSnapshotQueryIndexBuildInto(
            previous,
            binding.sourceVersion,
            identity.csgRootCid,
            queryIndex,
            err):
        snapshot_cargo.CsgCompilerSnapshotCargoRelease(cargo)
        return false
    let valid =
        semantic_snapshot.SemanticSnapshotValidationReceiptMakeInto(
            binding,
            identity,
            cargo.proofRoots.parserRootCid,
            cargo.proofRoots.typeRootCid,
            cargo.proofRoots.ownershipRootCid,
            cargo.proofRoots.callRootCid,
            cargo.proofRoots.layoutRootCid,
            cargo.proofRoots.dependencyRootCid,
            cargo.proofRoots.readSetRootCid,
            cargo.proofRoots.reachabilityRootCid,
            cargo.proofRoots.lifecycleRootCid,
            queryIndex.rootCid,
            validation,
            err) &&
        incremental.SemanticSnapshotIncrementalPrebuildPlanBuildInto(
            previous,
            identity,
            binding,
            validation,
            current,
            plan,
            err)
    snapshot_cargo.CsgCompilerSnapshotCargoRelease(cargo)
    return valid

fn TypeOnlySnapshotProjectionInto(
        csg: var compiler_csg.CompilerCsg,
        sourceText: str,
        sourceInterfaceCid: layout.FixedBytes32,
        tables: var schema.CsgCompilerSnapshotTables,
        outSourceInterfaceCids: var layout.FixedBytes32[],
        err: var str): bool =
    if csg.parserNormalizedExprReceipt.sourceSidecars.len != 1 ||
       csg.semanticGraph.sourceTable.modulePaths.len != 1 ||
       csg.semanticGraph.importEdgeTable.ownerSourceIndex.len != 0:
        err = " compiler snapshot builder type-only smoke: CSG source shape invalid"
        return false
    var documentCid: layout.FixedBytes32
    let modulePath = csg.semanticGraph.sourceTable.modulePaths[0]
    if !compiler_world.CompilerWorldDocumentCidInto(
            csg.packageId, modulePath, documentCid, err):
        return false
    var sourceRow: builder.CompilerSnapshotCanonicalSourceRow
    sourceRow.documentCid = documentCid
    sourceRow.producerSourceIndex = 0
    sourceRow.modulePath = modulePath
    sourceRow.contentCid =
        csg.parserNormalizedExprReceipt.sourceSidecars[
            0].sourceContentRaw32
    var sourceRows: builder.CompilerSnapshotCanonicalSourceRow[]
    add(sourceRows, sourceRow)
    var completeTexts: str[]
    var completeSpans: builder.CompilerSnapshotCanonicalSpanInput[]
    if !builder.CompilerSnapshotParserTablesBuildInto(
            csg.parserNormalizedExprReceipt.sourceSidecars,
            sourceRows,
            completeTexts,
            completeSpans,
            csg.parserNormalizedExprReceipt.envelope.receiptRaw32,
            tables,
            err):
        return false
    if !layout.FixedBytes32Equal(
            tables.sources.interfaceCids[0],
            layout.FixedBytes32()):
        err = " compiler snapshot builder type-only smoke: parser skeleton source interface prefilled"
        return false
    tables.sources.interfaceCids[0] = sourceInterfaceCid
    var current: incremental.SemanticSnapshotIncrementalPrebuildFacts
    if !TypeOnlyCurrentFactsInto(
            csg, tables, sourceText, current, err):
        return false
    var previous: schema.CsgCompilerSnapshotTables
    var plan: incremental.SemanticSnapshotIncrementalPrebuildPlan
    if !TypeOnlyPreviousPlanInto(
            current, previous, plan, err):
        return false
    var graphReceipt: builder.CompilerSnapshotGraphProjectionReceipt
    if !builder.CompilerSnapshotGraphFactsProduceAndProjectInto(
            tables,
            csg,
            previous,
            current,
            plan,
            graphReceipt,
            err) ||
       graphReceipt.admissionBlocked:
        if err == "":
            err = " compiler snapshot builder type-only smoke: graph admission blocked"
        return false
    var typeReceipt: builder.CompilerSnapshotTypeProjectionReceipt
    if !builder.CompilerSnapshotTypeFunctionSignatureTablesProjectWithReceiptInto(
            tables,
            csg.parserNormalizedExprReceipt.sourceSidecars,
            csg,
            typeReceipt,
            err) ||
       typeReceipt.admissionBlocked ||
       !builder.CompilerSnapshotTypeFunctionSignatureProjectionStrictValidateInto(
            tables,
            csg.parserNormalizedExprReceipt.sourceSidecars,
            csg,
            err):
        if err == "":
            err = " compiler snapshot builder type-only smoke: Type projection blocked"
        return false
    return schema.CsgCompilerSourceInterfaceCidsInto(
        tables, outSourceInterfaceCids, err)

fn TypeOnlySnapshotBuildInto(
        csg: var compiler_csg.CompilerCsg,
        sourceText: str,
        tables: var schema.CsgCompilerSnapshotTables,
        err: var str): bool =
    var provisionalTables: schema.CsgCompilerSnapshotTables
    var expectedSourceInterfaceCids: layout.FixedBytes32[]
    if !TypeOnlySnapshotProjectionInto(
           csg,
           sourceText,
           csg.typeArena.artifactRaw32,
           provisionalTables,
           expectedSourceInterfaceCids,
           err) ||
       expectedSourceInterfaceCids.len != 1:
        if err == "":
            err = " compiler snapshot builder type-only smoke: source interface producer cardinality invalid"
        return false
    provisionalTables = schema.CsgCompilerSnapshotTables()
    var replaySourceInterfaceCids: layout.FixedBytes32[]
    if !TypeOnlySnapshotProjectionInto(
           csg,
           sourceText,
           expectedSourceInterfaceCids[0],
           tables,
           replaySourceInterfaceCids,
           err) ||
       replaySourceInterfaceCids.len != 1 ||
       !layout.FixedBytes32Equal(
            replaySourceInterfaceCids[0],
            expectedSourceInterfaceCids[0]) ||
       !layout.FixedBytes32Equal(
            tables.sources.interfaceCids[0],
            expectedSourceInterfaceCids[0]):
       if err == "":
            err = " compiler snapshot builder type-only smoke: source interface fixed point mismatch"
        return false
    # This fixture promotes the parser skeleton into an admitted cargo at the
    # first synthetic source event.
    tables.semanticEpoch = 1
    return schema.CsgCompilerSnapshotTablesStrictValidateInto(
        tables, err)

fn TypeOnlyPortableIdentityReplayStrictValidateInto(
        tables: var schema.CsgCompilerSnapshotTables,
        err: var str): bool =
    var sourceInterfaceCids: layout.FixedBytes32[]
    if !schema.CsgCompilerSourceInterfaceCidsInto(
            tables, sourceInterfaceCids, err) ||
       sourceInterfaceCids.len != tables.sources.interfaceCids.len:
        if err == "":
            err = " compiler snapshot builder type-only smoke: portable source interface replay shape mismatch"
        return false
    for sourceId in 0..<sourceInterfaceCids.len:
        if !layout.FixedBytes32Equal(
               sourceInterfaceCids[sourceId],
               tables.sources.interfaceCids[sourceId]):
            err = " compiler snapshot builder type-only smoke: portable source interface CID replay mismatch"
            return false
    var fragmentCids: layout.FixedBytes32[]
    if !schema.CsgCompilerFunctionFragmentCidsInto(
            tables, fragmentCids, err) ||
       fragmentCids.len != 0:
        if err == "":
            err = " compiler snapshot builder type-only smoke: zero-function fragment set is not empty"
        return false
    var typeSymbolCount: int32
    for symbolId in 0..<tables.symbols.symbolCids.len:
        var expectedSymbolCid: layout.FixedBytes32
        var expectedInterfaceCid: layout.FixedBytes32
        if !schema.CsgCompilerSymbolRowCidInto(
                tables, symbolId, expectedSymbolCid, err) ||
           !schema.CsgCompilerSymbolInterfaceCidInto(
                tables, symbolId, expectedInterfaceCid, err) ||
           !layout.FixedBytes32Equal(
                expectedSymbolCid,
                tables.symbols.symbolCids[symbolId]) ||
           !layout.FixedBytes32Equal(
                expectedInterfaceCid,
                tables.symbols.interfaceCids[symbolId]):
            if err == "":
                err = " compiler snapshot builder type-only smoke: portable Symbol CID replay mismatch"
            return false
        if tables.symbols.symbolKinds[symbolId] ==
               schema.CsgCompilerSymbolType:
            typeSymbolCount = typeSymbolCount + 1
    for typeId in 0..<tables.types.typeCids.len:
        var expectedTypeCid: layout.FixedBytes32
        var expectedTraitProofCid: layout.FixedBytes32
        if !schema.CsgCompilerTypeTraitProofCidInto(
                tables, typeId, expectedTraitProofCid, err) ||
           !schema.CsgCompilerTypeRowCidInto(
                tables, typeId, expectedTypeCid, err) ||
           !layout.FixedBytes32Equal(
                expectedTraitProofCid,
                tables.types.traitProofCids[typeId]) ||
           !layout.FixedBytes32Equal(
                expectedTypeCid,
                tables.types.typeCids[typeId]):
            if err == "":
                err = " compiler snapshot builder type-only smoke: portable Type CID replay mismatch"
            return false
    if typeSymbolCount != 2:
        err = " compiler snapshot builder type-only smoke: portable Type Symbol domain mismatch"
        return false
    err = ""
    return true

fn TypeOnlyZeroFunctionDomainReject(stage: str): bool =
    echo(Fmt"compiler_snapshot_builder_type_only_zero_function_reject_stage={stage}")
    return false

fn TypeOnlyZeroFunctionDomainPollutionStrictValidate(
        ir: var texpr.TypedExprIr): bool =
    if !texpr.TypedExprIrZeroFunctionDomainStrictValidate(ir):
        return TypeOnlyZeroFunctionDomainReject("baseline")

    add(ir.functions2_functionNameIds, 0)
    let functionRejected =
        !texpr.TypedExprIrZeroFunctionDomainStrictValidate(ir)
    setLen(ir.functions2_functionNameIds, 0)
    if !functionRejected:
        return TypeOnlyZeroFunctionDomainReject("function")

    add(ir.scopes2_kinds, parser.NormalizedScopeRoot)
    let scopeRejected =
        !texpr.TypedExprIrZeroFunctionDomainStrictValidate(ir)
    setLen(ir.scopes2_kinds, 0)
    if !scopeRejected:
        return TypeOnlyZeroFunctionDomainReject("scope")

    add(ir.statements2_sourcePathIds, 0)
    let statementRejected =
        !texpr.TypedExprIrZeroFunctionDomainStrictValidate(ir)
    setLen(ir.statements2_sourcePathIds, 0)
    if !statementRejected:
        return TypeOnlyZeroFunctionDomainReject("statement")

    add(ir.nodes2_sourcePathIds, 0)
    let nodeRejected =
        !texpr.TypedExprIrZeroFunctionDomainStrictValidate(ir)
    setLen(ir.nodes2_sourcePathIds, 0)
    if !nodeRejected:
        return TypeOnlyZeroFunctionDomainReject("node")

    ir.valueDefinitions_exactTypeIds.len = 1
    let definitionRejected =
        !texpr.TypedExprIrZeroFunctionDomainStrictValidate(ir)
    ir.valueDefinitions_exactTypeIds.len = 0
    if !definitionRejected:
        return TypeOnlyZeroFunctionDomainReject("definition")

    ir.valueDefinitionGroups_definitionRows.len = 1
    let groupRejected =
        !texpr.TypedExprIrZeroFunctionDomainStrictValidate(ir)
    ir.valueDefinitionGroups_definitionRows.len = 0
    if !groupRejected:
        return TypeOnlyZeroFunctionDomainReject("definition_group")

    ir.valueExprTransactionNodeStart = 1
    let transactionRejected =
        !texpr.TypedExprIrZeroFunctionDomainStrictValidate(ir)
    ir.valueExprTransactionNodeStart = 0
    if !transactionRejected:
        return TypeOnlyZeroFunctionDomainReject("transaction_node_start")

    ir.valueExprTransactionProducerSourceIndex = 0
    let transactionProducerRejected =
        !texpr.TypedExprIrZeroFunctionDomainStrictValidate(ir)
    ir.valueExprTransactionProducerSourceIndex = -1
    if !transactionProducerRejected:
        return TypeOnlyZeroFunctionDomainReject("transaction_producer")

    add(ir.valueExprTransactionDefinitionGroupRootNodeIndexes, 0)
    let argRootRejected =
        !texpr.TypedExprIrZeroFunctionDomainStrictValidate(ir)
    setLen(ir.valueExprTransactionDefinitionGroupRootNodeIndexes, 0)
    if !argRootRejected:
        return TypeOnlyZeroFunctionDomainReject("transaction_group_root")

    add(ir.valueExprCallMetaOriginParserNodeIds, 0)
    let callMetaRejected =
        !texpr.TypedExprIrZeroFunctionDomainStrictValidate(ir)
    setLen(ir.valueExprCallMetaOriginParserNodeIds, 0)
    if !callMetaRejected:
        return TypeOnlyZeroFunctionDomainReject("call_metadata")

    add(ir.localBindingNameIndexBucketHeads, -1)
    let localIndexRejected =
        !texpr.TypedExprIrZeroFunctionDomainStrictValidate(ir)
    setLen(ir.localBindingNameIndexBucketHeads, 0)
    if !localIndexRejected:
        return TypeOnlyZeroFunctionDomainReject("local_binding_index")

    ir.localBindingNameIndexSealed = true
    let localIndexSealRejected =
        !texpr.TypedExprIrZeroFunctionDomainStrictValidate(ir)
    ir.localBindingNameIndexSealed = false
    if !localIndexSealRejected:
        return TypeOnlyZeroFunctionDomainReject("local_binding_index_seal")

    add(ir.statementFunctionIndexBucketHeads, -1)
    let statementFunctionIndexRejected =
        !texpr.TypedExprIrZeroFunctionDomainStrictValidate(ir)
    setLen(ir.statementFunctionIndexBucketHeads, 0)
    if !statementFunctionIndexRejected:
        return TypeOnlyZeroFunctionDomainReject("statement_function_index")

    add(ir.statementFnBindingIndexEntryBindingNames, "poison")
    let statementBindingIndexRejected =
        !texpr.TypedExprIrZeroFunctionDomainStrictValidate(ir)
    setLen(ir.statementFnBindingIndexEntryBindingNames, 0)
    if !statementBindingIndexRejected:
        return TypeOnlyZeroFunctionDomainReject("statement_binding_index")

    add(ir.paramRefIndexEntryNodeIndexes, 0)
    let paramIndexRejected =
        !texpr.TypedExprIrZeroFunctionDomainStrictValidate(ir)
    setLen(ir.paramRefIndexEntryNodeIndexes, 0)
    if !paramIndexRejected:
        return TypeOnlyZeroFunctionDomainReject("param_index")

    add(ir.originParserNodeStack, 0)
    let originStackRejected =
        !texpr.TypedExprIrZeroFunctionDomainStrictValidate(ir)
    setLen(ir.originParserNodeStack, 0)
    if !originStackRejected:
        return TypeOnlyZeroFunctionDomainReject("origin_stack")

    var coldStatement: texpr.TypedExprColdCsgStatementRow
    add(ir.coldCsgStatementRows, coldStatement)
    let coldStatementRejected =
        !texpr.TypedExprIrZeroFunctionDomainStrictValidate(ir)
    setLen(ir.coldCsgStatementRows, 0)
    if !coldStatementRejected:
        return TypeOnlyZeroFunctionDomainReject("cold_statement")

    ir.nodesTailBlockStartNodeIndex = 1
    let nodeTailRejected =
        !texpr.TypedExprIrZeroFunctionDomainStrictValidate(ir)
    ir.nodesTailBlockStartNodeIndex = 0
    return nodeTailRejected

fn TypeOnlyExactGenericLayoutAuthorityStrictValidate(
        csg: var compiler_csg.CompilerCsg,
        sidecar:
            var parser_receipt.ParserCanonicalSourceSidecar,
        err: var str): bool =
    var pairDeclaration: int32 = -1
    var pairListDeclaration: int32 = -1
    for declarationRow in 0..<sidecar.declarationKinds.len:
        if sidecar.declarationKinds[declarationRow] !=
               Int32(parser.ParserDeclarationType):
            continue
        let nameToken = sidecar.declarationNameTokenIds[
            declarationRow]
        if nameToken < 0 || nameToken >= sidecar.tokenValues.len:
            err = " compiler snapshot builder type-only smoke: exact layout declaration token missing"
            return false
        if sidecar.tokenValues[nameToken] == "Pair":
            pairDeclaration = declarationRow
        elif sidecar.tokenValues[nameToken] == "PairList":
            pairListDeclaration = declarationRow
    if pairDeclaration < 0 || pairListDeclaration < 0:
        err = " compiler snapshot builder type-only smoke: exact generic layout declarations missing"
        return false
    var pairLayoutCount: int32
    var pairListLayoutCount: int32
    for row in 0..<csg.layoutDiagnosticCompletions.exactLayoutDeclarationSourceLocalRows.len:
        let declarationRow =
            csg.layoutDiagnosticCompletions.exactLayoutDeclarationSourceLocalRows[row]
        if declarationRow == pairDeclaration:
            pairLayoutCount = pairLayoutCount + 1
        elif declarationRow == pairListDeclaration:
            pairListLayoutCount = pairListLayoutCount + 1
            if csg.layoutDiagnosticCompletions.exactLayoutSizeBytes[row] != 16 ||
               csg.layoutDiagnosticCompletions.exactLayoutAlignBytes[row] != 8:
                err = " compiler snapshot builder type-only smoke: concrete generic instantiation layout drift"
                return false
    if pairLayoutCount != 0 || pairListLayoutCount != 1:
        err = " compiler snapshot builder type-only smoke: generic layout presence drift"
        return false
    var attack = compiler_csg.CompilerCsgClone(csg)
    let exactIndex =
        attack.typedIr.exactLayoutIndexSourceStarts[0] +
        pairDeclaration
    let row = attack.typedIr.typeLayoutNames.len
    add(attack.typedIr.typeLayoutSourcePaths,
        csg.semanticGraph.sourceTable.sourcePaths[0])
    add(attack.typedIr.typeLayoutNames, "Pair")
    add(attack.typedIr.typeLayoutSizeBytes, 4)
    add(attack.typedIr.typeLayoutAlignBytes, 4)
    add(attack.typedIr.typeLayoutFieldCounts, 0)
    add(attack.typedIr.typeLayoutProducerSourceIndexes, 0)
    add(attack.typedIr.typeLayoutDeclarationSourceLocalRows,
        pairDeclaration)
    add(attack.typedIr.typeLayoutBuiltinKinds,
        Int32(texpr.TypedExprLayoutBuiltinNone))
    attack.typedIr.exactLayoutTypeDeclarationRows[
        exactIndex] = row
    let rejected =
        !compiler_csg.
            CompilerCsgLayoutDiagnosticCompletionStrictValidateInto(
                attack, err)
    compiler_csg.CompilerCsgReleaseBackendInputPayload(attack)
    if !rejected:
        err = " compiler snapshot builder type-only smoke: fabricated generic 4/4 layout accepted"
        return false
    err = ""
    return true

fn TypeOnlyLayoutFieldStrictMutationsReject(err: var str): bool =
    var fixture = schema_smoke.BuildSnapshot()
    let scalarTypeId = fixture.layouts.typeIds[0]
    var objectTypeId: int32 = -1
    for typeId in 0..<fixture.types.typeCids.len:
        if typeId != scalarTypeId:
            objectTypeId = typeId
            break
    if objectTypeId < 0 ||
       fixture.functions.symbolIds.len != 1 ||
       fixture.symbols.symbolCids.len != 2:
        err = " compiler snapshot builder type-only smoke: layout Field fixture domain missing"
        return false
    let declaringSymbolId = fixture.functions.symbolIds[0]
    var fieldSymbolId: int32 = -1
    for symbolId in 0..<fixture.symbols.symbolCids.len:
        if symbolId != declaringSymbolId:
            fieldSymbolId = symbolId
            break
    if fieldSymbolId < 0:
        err = " compiler snapshot builder type-only smoke: layout Field Symbol fixture missing"
        return false
    fixture.types.typeKinds[objectTypeId] =
        schema.CsgCompilerTypeObject
    fixture.types.declSymbolIds[objectTypeId] =
        declaringSymbolId
    fixture.types.argStarts[objectTypeId] =
        fixture.types.argTypeIds.len
    fixture.types.argCounts[objectTypeId] = 1
    add(fixture.types.argTypeIds, scalarTypeId)
    add(fixture.types.argNameTextIds,
        fixture.symbols.nameTextIds[fieldSymbolId])
    fixture.symbols.symbolKinds[declaringSymbolId] =
        schema.CsgCompilerSymbolType
    fixture.symbols.typeIds[declaringSymbolId] =
        objectTypeId
    fixture.symbols.symbolKinds[fieldSymbolId] =
        schema.CsgCompilerSymbolField
    fixture.symbols.ownerSymbolIds[fieldSymbolId] =
        declaringSymbolId
    fixture.symbols.typeIds[fieldSymbolId] = scalarTypeId
    fixture.layouts.typeIds[0] = objectTypeId
    fixture.layouts.sizeBytes[0] = 4
    fixture.layouts.alignBytes[0] = 4
    fixture.layouts.fieldStarts[0] = 0
    fixture.layouts.fieldCounts[0] = 1
    fixture.layoutFields.layoutIds = [0]
    fixture.layoutFields.fieldSymbolIds = [fieldSymbolId]
    fixture.layoutFields.typeIds = [scalarTypeId]
    fixture.layoutFields.offsetBytes = [0]
    fixture.layoutFields.sizeBytes = [4]
    fixture.layoutFields.alignBytes = [4]
    var exactLayoutCid: layout.FixedBytes32
    if !schema.CsgCompilerLayoutRowCidInto(
           fixture, 0, exactLayoutCid, err):
        return false
    fixture.layouts.layoutCids[0] = exactLayoutCid
    if !schema.CsgCompilerSnapshotLayoutsStrictValidateInto(
           fixture, err):
        return false
    var replay =
        schema.CsgCompilerSnapshotTablesClone(fixture)
    if !schema.CsgCompilerSnapshotLayoutsStrictValidateInto(
           replay, err) ||
       replay.layoutFields.layoutIds[0] !=
           fixture.layoutFields.layoutIds[0] ||
       replay.layoutFields.fieldSymbolIds[0] !=
           fixture.layoutFields.fieldSymbolIds[0] ||
       replay.layoutFields.typeIds[0] !=
           fixture.layoutFields.typeIds[0] ||
       replay.layoutFields.offsetBytes[0] !=
           fixture.layoutFields.offsetBytes[0] ||
       replay.layoutFields.sizeBytes[0] !=
           fixture.layoutFields.sizeBytes[0] ||
       replay.layoutFields.alignBytes[0] !=
           fixture.layoutFields.alignBytes[0] ||
       !layout.FixedBytes32Equal(
           replay.layouts.layoutCids[0],
           fixture.layouts.layoutCids[0]):
        if err == "":
            err = " compiler snapshot builder type-only smoke: layout Field portable replay drift"
        return false
    var symbolAttack =
        schema.CsgCompilerSnapshotTablesClone(fixture)
    symbolAttack.layoutFields.fieldSymbolIds[0] =
        declaringSymbolId
    if schema.CsgCompilerSnapshotLayoutsStrictValidateInto(
           symbolAttack, err):
        err = " compiler snapshot builder type-only smoke: layout Field Symbol mutation accepted"
        return false
    var typeAttack =
        schema.CsgCompilerSnapshotTablesClone(fixture)
    typeAttack.layoutFields.typeIds[0] = objectTypeId
    if schema.CsgCompilerSnapshotLayoutsStrictValidateInto(
           typeAttack, err):
        err = " compiler snapshot builder type-only smoke: layout Field TypeId mutation accepted"
        return false
    var offsetAttack =
        schema.CsgCompilerSnapshotTablesClone(fixture)
    offsetAttack.layoutFields.offsetBytes[0] = 1
    if schema.CsgCompilerSnapshotLayoutsStrictValidateInto(
           offsetAttack, err):
        err = " compiler snapshot builder type-only smoke: layout Field offset mutation accepted"
        return false
    var cidAttack =
        schema.CsgCompilerSnapshotTablesClone(fixture)
    cidAttack.layouts.layoutCids[0].data[0] =
        uint8(
            Int32(
                cidAttack.layouts.layoutCids[
                    0].data[0]) ^ 1)
    if schema.CsgCompilerSnapshotLayoutsStrictValidateInto(
           cidAttack, err):
        err = " compiler snapshot builder type-only smoke: layout Field CID mutation accepted"
        return false
    err = ""
    return true

fn main() =
    let root = chengpath.PathCurrentDir()
    let sourcePath = chengpath.PathJoin(
        root,
        "src/tests/compiler_snapshot_builder_type_only_fixture.cheng")
    let sourceText = chengpath.ReadTextFile(root, sourcePath)
    assert(sourceText != "",
           "compiler snapshot builder type-only smoke: source missing")
    var csg: compiler_csg.CompilerCsg
    var err: str
    assert(TypeOnlyBuildCsg(
               root, sourcePath, sourceText, csg, err),
           Fmt"compiler snapshot builder type-only smoke: CSG failed {err}")
    assert(csg.semanticGraph.sourceTable.sourcePaths.len == 1 &&
           csg.semanticGraph.reachableFunctionTable.functionNames.len == 0 &&
           csg.semanticGraph.typedIrTable.functionNames.len == 0 &&
           csg.typedIr.functions2_functionNameIds.len == 0 &&
           csg.parserNormalizedExprReceipt.sourceSidecars.len == 1 &&
           csg.parserNormalizedExprReceipt.sourceSidecars[
               0].functionIndexes.len == 0 &&
           csg.typeArena != nil &&
           csg.typeArena.typeCount > 0 &&
           csg.typedIrRoundCount == 0 &&
           csg.typedIrRebuildSourceCount == 0 &&
           csg.nodes.len == 2 &&
           csg.nodeCount == 2 &&
           csg.nodes[0].nodeKind ==
               compiler_csg.CompilerCsgNodeKindPackage &&
           csg.nodes[1].nodeKind ==
               compiler_csg.CompilerCsgNodeKindModule &&
           csg.edges.len == 1 &&
           csg.edgeCount == 1,
           "compiler snapshot builder type-only smoke: zero-function authority missing")
    assert(csg.typedIr.localBindingNameIndexSealed,
           "compiler snapshot builder type-only smoke: compacted local-binding index is not sealed")
    csg.typedIr.localBindingNameIndexSealed = false
    let zeroFunctionDomainStrict =
        TypeOnlyZeroFunctionDomainPollutionStrictValidate(csg.typedIr)
    csg.typedIr.localBindingNameIndexSealed = true
    assert(zeroFunctionDomainStrict,
           "compiler snapshot builder type-only smoke: zero-function side-domain residue accepted")
    echo("compiler_snapshot_builder_type_only_csg=1")
    assert(TypeOnlyExactGenericLayoutAuthorityStrictValidate(
               csg,
               csg.parserNormalizedExprReceipt.sourceSidecars[0],
               err),
           Fmt"compiler snapshot builder type-only smoke: exact generic layout validation failed {err}")
    var tables: schema.CsgCompilerSnapshotTables
    assert(TypeOnlySnapshotBuildInto(
               csg, sourceText, tables, err),
           Fmt"compiler snapshot builder type-only smoke: snapshot failed {err}")
    assert(TypeOnlyAnnotationScaleAndMutationsStrictValidate(
               tables, err),
           Fmt"compiler snapshot builder type-only smoke: annotation target validation failed {err}")
    assert(TypeOnlyPortableIdentityReplayStrictValidateInto(
               tables, err),
           Fmt"compiler snapshot builder type-only smoke: portable replay failed {err}")
    assert(TypeOnlyLayoutFieldStrictMutationsReject(err),
           Fmt"compiler snapshot builder type-only smoke: layout Field replay/mutation failed {err}")
    echo("compiler_snapshot_builder_type_only_layout_field_replay=1")
    echo("compiler_snapshot_builder_type_only_layout_field_mutations_rejected=1")
    assert(tables.functions.symbolIds.len == 0 &&
           tables.parserSidecars.functionIndexes.len == 0 &&
           tables.symbols.symbolCids.len == 5 &&
           tables.declarations.declIds.len == 5 &&
           tables.types.typeCids.len > 0 &&
           tables.lexicalScopes.sourceIds.len == 1 &&
           tables.lexicalScopes.parentScopeIds[0] == -1 &&
           tables.lexicalScopes.visibleCounts[0] == 5 &&
           tables.lexicalScopes.visibleSymbolIds.len == 5 &&
           tables.layouts.layoutCids.len == 0 &&
           tables.layoutFields.layoutIds.len == 0 &&
           tables.readSet.readerFunctionIds.len == 0 &&
           tables.diagnostics.codeTextIds.len == 0,
           "compiler snapshot builder type-only smoke: non-function tables missing")
    var sourceInterfaceAttack =
        schema.CsgCompilerSnapshotTablesClone(tables)
    sourceInterfaceAttack.sources.interfaceCids[0].data[0] =
        uint8(
            Int32(
                sourceInterfaceAttack.sources.interfaceCids[
                    0].data[0]) ^ 1)
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(
               sourceInterfaceAttack, err),
           "compiler snapshot builder type-only smoke: source interface CID mutation accepted")
    var lexicalVisibilityRemapAttack =
        schema.CsgCompilerSnapshotTablesClone(tables)
    lexicalVisibilityRemapAttack.lexicalScopes.visibleSymbolIds[1] =
        lexicalVisibilityRemapAttack.lexicalScopes.visibleSymbolIds[0]
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(
               lexicalVisibilityRemapAttack, err),
           "compiler snapshot builder type-only smoke: lexical visibility remap accepted")
    var typeDeclarationCount: int32
    var sourceConstDeclarationCount: int32
    for declarationRow in 0..<
            tables.parserSidecars.declarationKinds.len:
        let kind =
            tables.parserSidecars.declarationKinds[declarationRow]
        if kind != Int32(parser.ParserDeclarationType) &&
           kind != Int32(parser.ParserDeclarationLocal):
            continue
        assert(tables.parserSidecars.declarationLexicalScopeIds[
                   declarationRow] >= 0 &&
               tables.parserSidecars.declarationFunctionRows[
                   declarationRow] == -1,
               "compiler snapshot builder type-only smoke: declaration scope drift")
        if kind == Int32(parser.ParserDeclarationType):
            typeDeclarationCount = typeDeclarationCount + 1
        elif !tables.parserSidecars.declarationMutableFlags[
                  declarationRow]:
            sourceConstDeclarationCount =
                sourceConstDeclarationCount + 1
    assert(typeDeclarationCount == 2 &&
           sourceConstDeclarationCount == 1,
           "compiler snapshot builder type-only smoke: Type/Const authority missing")
    var genericTypeIds: int32[]
    for typeId in 0..<tables.types.typeCids.len:
        if tables.types.typeKinds[typeId] ==
               schema.CsgCompilerTypeGenericParameter:
            add(genericTypeIds, typeId)
    var genericSymbolIds: int32[]
    var firstGenericSymbolId: int32 = -1
    var secondGenericSymbolId: int32 = -1
    for symbolId in 0..<tables.symbols.symbolCids.len:
        if tables.symbols.symbolKinds[symbolId] !=
               schema.CsgCompilerSymbolGenericParameter:
            continue
        add(genericSymbolIds, symbolId)
        let ordinal =
            tables.symbols.genericParameterOrdinals[symbolId]
        if ordinal == 0:
            firstGenericSymbolId = symbolId
        elif ordinal == 1:
            secondGenericSymbolId = symbolId
    assert(genericTypeIds.len == 2 &&
           genericSymbolIds.len == 2 &&
           firstGenericSymbolId >= 0 &&
           secondGenericSymbolId >= 0,
           "compiler snapshot builder type-only smoke: generic Type/Symbol domain missing")
    for offset in 0..<genericSymbolIds.len:
        let symbolId = genericSymbolIds[offset]
        let typeId = tables.symbols.typeIds[symbolId]
        assert(typeId >= 0 &&
               typeId < tables.types.typeCids.len &&
               tables.types.typeKinds[typeId] ==
                   schema.CsgCompilerTypeGenericParameter &&
               tables.types.genericParameterParserRows[typeId] ==
                   tables.symbols.genericParameterParserRows[symbolId],
               "compiler snapshot builder type-only smoke: generic Type parser identity drift")
    let firstConstraintStart =
        tables.symbols.genericConstraintStarts[firstGenericSymbolId]
    assert(tables.symbols.genericConstraintCounts[
               firstGenericSymbolId] == 1 &&
           tables.symbols.genericParameterDefaultTypeIds[
               firstGenericSymbolId] >= 0 &&
           tables.types.typeKinds[
               tables.symbols.genericConstraintTypeIds[
                   firstConstraintStart]] ==
               schema.CsgCompilerTypeScalar &&
           tables.types.typeKinds[
               tables.symbols.genericParameterDefaultTypeIds[
                   firstGenericSymbolId]] ==
               schema.CsgCompilerTypeScalar &&
           tables.symbols.genericConstraintCounts[
               secondGenericSymbolId] == 0 &&
           tables.symbols.genericParameterDefaultTypeIds[
               secondGenericSymbolId] ==
               tables.symbols.typeIds[firstGenericSymbolId],
           "compiler snapshot builder type-only smoke: generic constraint/default remap drift")
    var reorderedGenericCount: int32
    for arenaTypeId in 0..<csg.typeArena.typeCount:
        if arenamod.ArenaArrayInt32Get(
               csg.typeArena.arena,
               csg.typeArena.typeKinds,
               arenaTypeId) !=
               Int32(typearena.TypedExprStructuralTypeGenericParameter):
            continue
        let arenaGenericRow = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.genericSymbolIds,
            arenaTypeId)
        var parserRow: int32 = -1
        for candidateParserRow in 0..<
                tables.parserSidecars.typeGenericSymbolSourceLocalRows.len:
            if tables.parserSidecars.typeGenericSymbolProducerSourceIds[
                   candidateParserRow] == 0 &&
               tables.parserSidecars.typeGenericSymbolSourceLocalRows[
                   candidateParserRow] == arenaGenericRow:
                parserRow = candidateParserRow
                break
        var finalTypeId: int32 = -1
        for candidateTypeId in 0..<tables.types.typeCids.len:
            if tables.types.genericParameterParserRows[
                   candidateTypeId] == parserRow:
                finalTypeId = candidateTypeId
                break
        assert(parserRow >= 0 && finalTypeId >= 0,
               "compiler snapshot builder type-only smoke: generic arena/parser crosswalk missing")
        if finalTypeId != arenaTypeId:
            reorderedGenericCount = reorderedGenericCount + 1
    assert(reorderedGenericCount > 0,
           "compiler snapshot builder type-only smoke: generic Type reorder fixture did not reorder")
    var missingGenericBinding =
        schema.CsgCompilerSnapshotTablesClone(tables)
    missingGenericBinding.types.genericParameterParserRows[
        genericTypeIds[0]] = -1
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(
               missingGenericBinding, err),
           "compiler snapshot builder type-only smoke: missing generic Type binding accepted")
    var duplicateGenericBinding =
        schema.CsgCompilerSnapshotTablesClone(tables)
    duplicateGenericBinding.types.genericParameterParserRows[
        genericTypeIds[1]] =
            duplicateGenericBinding.types.genericParameterParserRows[
                genericTypeIds[0]]
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(
               duplicateGenericBinding, err),
           "compiler snapshot builder type-only smoke: duplicate generic Type binding accepted")
    var wrongGenericBinding =
        schema.CsgCompilerSnapshotTablesClone(tables)
    let firstParserRow =
        wrongGenericBinding.types.genericParameterParserRows[
            genericTypeIds[0]]
    wrongGenericBinding.types.genericParameterParserRows[
        genericTypeIds[0]] =
            wrongGenericBinding.types.genericParameterParserRows[
                genericTypeIds[1]]
    wrongGenericBinding.types.genericParameterParserRows[
        genericTypeIds[1]] = firstParserRow
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(
               wrongGenericBinding, err),
           "compiler snapshot builder type-only smoke: wrong generic Type binding accepted")
    echo("compiler_snapshot_builder_type_only_generic_identity=1")
    echo("compiler_snapshot_builder_type_only_generic_mutations_rejected=1")
    var tupleCount: int32
    var sequenceCount: int32
    var aliasCount: int32
    var tupleTypeId: int32 = -1
    for typeId in 0..<tables.types.typeCids.len:
        if tables.types.typeKinds[typeId] == schema.CsgCompilerTypeTuple:
            tupleCount = tupleCount + 1
            tupleTypeId = typeId
            assert(tables.types.argCounts[typeId] == 2,
                   "compiler snapshot builder type-only smoke: tuple layout missing")
        elif tables.types.typeKinds[typeId] ==
                 schema.CsgCompilerTypeSequence:
            sequenceCount = sequenceCount + 1
        elif tables.types.typeKinds[typeId] ==
                 schema.CsgCompilerTypeAlias:
            aliasCount = aliasCount + 1
    assert(tupleCount == 1 &&
           sequenceCount == 1 &&
           aliasCount == 2,
           "compiler snapshot builder type-only smoke: Type/Layout projection drift")
    assert(tupleTypeId >= 0,
           "compiler snapshot builder type-only smoke: tuple row missing")
    let tupleArgStart = tables.types.argStarts[tupleTypeId]
    assert(tables.types.argNameTextIds.len ==
               tables.types.argTypeIds.len &&
           tables.texts[
               tables.types.argNameTextIds[tupleArgStart]] == "left" &&
           tables.texts[
               tables.types.argNameTextIds[tupleArgStart + 1]] == "right",
           "compiler snapshot builder type-only smoke: tuple field identity missing")
    var tupleFieldRemapAttack =
        schema.CsgCompilerSnapshotTablesClone(tables)
    tupleFieldRemapAttack.types.argNameTextIds[tupleArgStart] =
        tables.types.argNameTextIds[tupleArgStart + 1]
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(
               tupleFieldRemapAttack, err),
           "compiler snapshot builder type-only smoke: tuple field identity remap accepted")
    var ghostFragment = schema.CsgCompilerSnapshotTablesClone(tables)
    add(ghostFragment.functions.fragmentCids,
        tables.types.typeCids[0])
    var ghostFragmentCids: layout.FixedBytes32[]
    assert(!schema.CsgCompilerFunctionFragmentCidsInto(
               ghostFragment, ghostFragmentCids, err),
           "compiler snapshot builder type-only smoke: ghost zero-function fragment accepted")
    var typeSymbolIds: int32[]
    for symbolId in 0..<tables.symbols.symbolCids.len:
        if tables.symbols.symbolKinds[symbolId] ==
               schema.CsgCompilerSymbolType:
            add(typeSymbolIds, symbolId)
    assert(typeSymbolIds.len == 2,
           "compiler snapshot builder type-only smoke: Type Symbol count drift")
    var symbolRemapAttack =
        schema.CsgCompilerSnapshotTablesClone(tables)
    var remapped = false
    for typeId in 0..<symbolRemapAttack.types.typeCids.len:
        if symbolRemapAttack.types.declSymbolIds[typeId] ==
               typeSymbolIds[0]:
            symbolRemapAttack.types.declSymbolIds[typeId] =
                typeSymbolIds[1]
            remapped = true
            break
    assert(remapped &&
           !schema.CsgCompilerSnapshotTablesStrictValidateInto(
               symbolRemapAttack, err),
           "compiler snapshot builder type-only smoke: local SymbolId remap escaped portable CID proof")
    var cargo = snapshot_cargo.CsgCompilerSnapshotCargoBuild(tables)
    assert(cargo.ok &&
           !layout.FixedBytes32Equal(
               cargo.proofRoots.typeRootCid,
               layout.FixedBytes32()) &&
           !layout.FixedBytes32Equal(
               cargo.proofRoots.layoutRootCid,
               layout.FixedBytes32()) &&
           !layout.FixedBytes32Equal(
               cargo.proofRoots.dependencyRootCid,
               layout.FixedBytes32()),
           Fmt"compiler snapshot builder type-only smoke: proof roots missing {cargo.error}")
    snapshot_cargo.CsgCompilerSnapshotCargoRelease(cargo)
    var coldCsg: compiler_csg.CompilerCsg
    assert(TypeOnlyBuildCsg(
               root, sourcePath, sourceText, coldCsg, err) &&
           layout.FixedBytes32Equal(
               csg.canonicalGraphCid,
               coldCsg.canonicalGraphCid) &&
           layout.FixedBytes32Equal(
               csg.graphCid,
               coldCsg.graphCid) &&
           layout.FixedBytes32Equal(
               csg.typeArena.artifactRaw32,
               coldCsg.typeArena.artifactRaw32) &&
           layout.FixedBytes32Equal(
               csg.parserNormalizedExprReceipt.envelope.receiptRaw32,
               coldCsg.parserNormalizedExprReceipt.envelope.receiptRaw32),
           "compiler snapshot builder type-only smoke: cold CSG drift")
    var coldTables: schema.CsgCompilerSnapshotTables
    assert(TypeOnlySnapshotBuildInto(
               coldCsg, sourceText, coldTables, err),
           Fmt"compiler snapshot builder type-only smoke: cold snapshot failed {err}")
    var coldCargo =
        snapshot_cargo.CsgCompilerSnapshotCargoBuild(coldTables)
    var warmCargo =
        snapshot_cargo.CsgCompilerSnapshotCargoBuild(tables)
    assert(coldCargo.ok &&
           warmCargo.ok &&
           layout.FixedBytes32Equal(
               coldCargo.factsRootCid,
               warmCargo.factsRootCid) &&
           layout.FixedBytes32Equal(
               coldCargo.proofRoots.typeRootCid,
               warmCargo.proofRoots.typeRootCid) &&
           layout.FixedBytes32Equal(
               coldCargo.proofRoots.layoutRootCid,
               warmCargo.proofRoots.layoutRootCid) &&
           layout.FixedBytes32Equal(
               coldCargo.proofRoots.dependencyRootCid,
               warmCargo.proofRoots.dependencyRootCid),
           "compiler snapshot builder type-only smoke: cold snapshot roots drift")
    snapshot_cargo.CsgCompilerSnapshotCargoRelease(coldCargo)
    snapshot_cargo.CsgCompilerSnapshotCargoRelease(warmCargo)
    echo("compiler_snapshot_builder_type_only_snapshot=1")
    echo("compiler_snapshot_builder_type_only_cold_equivalent=1")
