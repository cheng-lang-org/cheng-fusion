import std/result
import std/os
import std/strings
import std/strutils as strutil
import cheng/inference/kernel_ir as kir
import cheng/inference/model_graph as mg
import cheng/inference/hf_model_graph as hfgraph

# #15 真规模验证: 真 config.json -> 引擎图构建 逐字段对表探针 (纯 Cheng 断言)。
fn main(): int32 =
    let configPath = os.GetEnv("CHENG_PLANNER_CONFIG")
    if configPath == "":
        echo("probe_error=env CHENG_PLANNER_CONFIG not set")
        return 2
    let configRes = os.ReadFileResult(configPath)
    if IsErr(configRes):
        echo(strutil.Join(["probe_error=", Error(configRes)], ""))
        return 1
    let graphRes = hfgraph.HfModelGraphBuildDenseTransformerFromConfig(
        Value(configRes), "cid:model:qw-align-probe", kir.KernelDtypeBf16, mg.ModelQuantSchemeNone)
    if IsErr(graphRes):
        echo(strutil.Join(["probe_error=", Error(graphRes)], ""))
        return 1
    let graph = Value(graphRes)
    echo(strutil.Join(["architecture: ", graph.architecture], ""))
    echo(strutil.Join(["hidden_size: ", strings.IntToStr(graph.hiddenSize)], ""))
    echo(strutil.Join(["num_hidden_layers: ", strings.IntToStr(graph.layerCount)], ""))
    echo(strutil.Join(["num_attention_heads: ", strings.IntToStr(graph.attentionHeads)], ""))
    echo(strutil.Join(["num_key_value_heads: ", strings.IntToStr(graph.keyValueHeads)], ""))
    echo(strutil.Join(["head_dim: ", strings.IntToStr(graph.headDim)], ""))
    echo(strutil.Join(["rope_theta_x1000: ", strings.IntToStr(int32(graph.ropeTheta * 1000.0 / 1000000.0))], ""))
    var vocab: int32
    for i in 0..<graph.tensors.len:
        if graph.tensors[i].name == "logits":
            vocab = graph.tensors[i].shape[1]
    echo(strutil.Join(["vocab_size(logits): ", strings.IntToStr(vocab)], ""))
    echo(strutil.Join(["weights_count: ", strings.IntToStr(graph.weights.len)], ""))
    echo(strutil.Join(["ops_count: ", strings.IntToStr(graph.ops.len)], ""))
    var lmHeadTied = false
    for i in 0..<graph.ops.len:
        if graph.ops[i].opKind == mg.InferenceModelOpLmHead:
            if graph.ops[i].weightNames[0] == "model.embed_tokens.weight":
                lmHeadTied = true
    echo(strutil.Join(["tie_word_embeddings(lm_head==embed): ", strings.IntToStr(int32(lmHeadTied))], ""))
    var intermediate: int32
    for i in 0..<graph.weights.len:
        if graph.weights[i].tensorName == "model.layers.0.mlp.gate_proj.weight":
            intermediate = graph.weights[i].shape[0]
    echo(strutil.Join(["intermediate_size(gate_proj rows): ", strings.IntToStr(intermediate)], ""))
    # 纯 Cheng 断言: 与 Qwen2.5-0.5B config.json 期望值逐字段对表
    if graph.hiddenSize != 896: echo("MISMATCH hidden"); return 1
    if graph.layerCount != 24: echo("MISMATCH layers"); return 1
    if graph.attentionHeads != 14: echo("MISMATCH heads"); return 1
    if graph.keyValueHeads != 2: echo("MISMATCH kv_heads"); return 1
    if graph.headDim != 64: echo("MISMATCH head_dim"); return 1
    if vocab != 151936: echo("MISMATCH vocab"); return 1
    if !lmHeadTied: echo("MISMATCH tie_word_embeddings"); return 1
    if intermediate != 4864: echo("MISMATCH intermediate"); return 1
    if graph.ropeTheta < 999999.0 || graph.ropeTheta > 1000001.0: echo("MISMATCH rope_theta"); return 1
    echo("qw_config_align_probe ok")
    return 0
