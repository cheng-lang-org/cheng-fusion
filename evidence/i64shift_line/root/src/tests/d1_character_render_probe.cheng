# D1 character render probe: materialize the frozen climb scene, render
# the tick-0 hanging pose from three cameras with the A2 character
# appearance (sphere head, capsule torso/limbs, continuous rope) and
# assert the palette lands — skin/red/blue/rope pixels must all appear
# in the expected screen regions.
import cheng/game/csg/schema
import cheng/game/csg/producer
import cheng/game/csg/materializer
import cheng/game/world3d
import cheng/game/cinema/camera
import cheng/game/render/cpu_raster as raster
import cheng/game/render/character
import std/os
import std/strings as strings

const
    ProbeW = 1280
    ProbeH = 720
    OutDir = "artifacts/csg_world_video/d1_probe"

@borrows
fn countRange(rgb: uint8[], rLo: int32, rHi: int32, gLo: int32, gHi: int32, bLo: int32, bHi: int32): int32 =
    var n: int32 = 0
    var i: int32 = 0
    while i < rgb.len / 3:
        let r: int32 = int32(rgb[i * 3])
        let g: int32 = int32(rgb[i * 3 + 1])
        let b: int32 = int32(rgb[i * 3 + 2])
        if r >= rLo:
            if r <= rHi:
                if g >= gLo:
                    if g <= gHi:
                        if b >= bLo:
                            if b <= bHi:
                                n = n + 1
        i = i + 1
    return n

@borrows
fn renderCam(cam: camera.CinemaCamera, w: world3d.World3d, partRoles: int32[], path: str) =
    var t: raster.RasterTarget
    t = raster.RasterMake(ProbeW, ProbeH)
    raster.RasterGround(t, cam)
    raster.RasterWallFace(t, cam, 0.5, -2.0, 2.0, 0.0, 4.0)
    character.RenderRope(t, cam, w)
    character.RenderCharacter(t, cam, w, partRoles)
    raster.RasterWritePpm(t, path)

fn main(): int32 =
    os.MkdirAll(OutDir, 493)
    var facts: schema.CsgWorldFacts = producer.CsgProducerBuildClimbScene()
    var w: world3d.World3d
    var mp: materializer.CsgMaterializerMapping
    var err: str = ""
    if !materializer.CsgMaterialize(facts, w, mp, err):
        echo("FAIL materialize: " + err)
        return 1
    var partRoles: int32[]
    setLen(partRoles, 0)
    var ri: int32 = 0
    while ri < facts.partRole.len:
        add(partRoles, facts.partRole[ri])
        ri = ri + 1
    var camA = camera.CinemaCameraLookAt(-4.6, 3.2, 1.7, 0.0, 0.8, 1.35, 950.0, ProbeW, ProbeH)
    var camB = camera.CinemaCameraLookAt(3.0, 3.4, 1.5, 0.0, 0.85, 1.30, 1150.0, ProbeW, ProbeH)
    var camC = camera.CinemaCameraLookAt(-1.8, 3.4, 4.6, 0.0, 0.85, 1.20, 850.0, ProbeW, ProbeH)
    renderCam(camA, w, partRoles, OutDir + "/pose0_camA.ppm")
    renderCam(camB, w, partRoles, OutDir + "/pose0_camB.ppm")
    renderCam(camC, w, partRoles, OutDir + "/pose0_camC.ppm")
    # palette assertions on camA (read the streamed P6 back: 16-byte header)
    let ppm: str = os.ReadFile(OutDir + "/pose0_camA.ppm")
    var rgb: uint8[]
    setLen(rgb, (ppm.len - 16) / 1)
    var ci: int32 = 0
    while ci < ppm.len - 16:
        rgb[ci] = uint8(int32(ppm[16 + ci]) & 255)
        ci = ci + 1
    let red = countRange(rgb, 110, 230, 20, 90, 20, 90)
    let blue = countRange(rgb, 10, 50, 10, 52, 40, 90)
    let skin = countRange(rgb, 150, 240, 110, 200, 70, 160)
    let rope = countRange(rgb, 90, 190, 55, 130, 25, 80)
    echo("palette camA red=" + strings.IntToStr(red) + " blue=" + strings.IntToStr(blue) + " skin=" + strings.IntToStr(skin) + " rope=" + strings.IntToStr(rope))
    if red < 300:
        echo("FAIL red shirt pixels")
        return 1
    if blue < 300:
        echo("FAIL blue pants pixels")
        return 1
    if skin < 100:
        echo("FAIL skin head pixels")
        return 1
    if rope < 200:
        echo("FAIL rope pixels")
        return 1
    echo("PASS d1 character render probe")
    return 0
