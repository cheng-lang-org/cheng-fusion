type
    ScalarSequenceFields =
        flags: bool[]
        rows: int32[]
        enabled: bool
        digests: int64[]
        bytes: uint8[]

    ScalarSequenceRef = ref object
        rows: int32[]

fn CloneBoolSequence(values: bool[]): bool[] =
    var out: bool[]
    for index in 0..<values.len:
        add(out, values[index])
    return out

fn main(): int32 =
    var flags: bool[]
    add(flags, false)
    add(flags, true)
    var digests: int64[]
    add(digests, int64(0))
    add(digests, int64(0))
    var bytes: uint8[]
    add(bytes, uint8(0))
    var rows: int32[]
    var sourceRows: int32[]
    add(rows, 0)
    add(rows, 0)
    add(rows, 0)
    add(sourceRows, 0)
    add(sourceRows, 2)
    add(sourceRows, 1)
    var fields: ScalarSequenceFields
    fields.flags = [false, true]
    fields.flags = flags
    fields.flags = CloneBoolSequence(flags)
    fields.rows = rows
    fields.enabled = true
    fields.digests = digests
    fields.bytes = bytes
    fields.digests[0] = int64(23)
    fields.bytes[0] = uint8(9)
    for i in 0..<sourceRows.len:
        fields.rows[i] = sourceRows[i]
    let refFields = new(ScalarSequenceRef)
    refFields.rows = rows
    for i in 0..<sourceRows.len:
        refFields.rows[i] = sourceRows[i]
    if fields.digests[0] != int64(23):
        return 1
    if !fields.flags[1]:
        return 2
    if fields.flags[0]:
        return 3
    if !fields.enabled:
        return 7
    if fields.bytes[0] != uint8(9):
        return 4
    if fields.rows[0] != 0 || fields.rows[1] != 2 || fields.rows[2] != 1:
        return 5
    if refFields.rows[0] != 0 || refFields.rows[1] != 2 || refFields.rows[2] != 1:
        return 6
    return 0
