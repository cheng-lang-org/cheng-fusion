import std/strutils as strutil
import cheng/apps/vpn_proxy/vpn_proxy_config as config
import cheng/apps/vpn_proxy/vpn_proxy_routing as routing

fn exitCfg(name: str, host: str, port: int32, serverName: str): config.VpnProxyExitConfig =
    var out: config.VpnProxyExitConfig
    out.name = name
    out.host = host
    out.port = port
    out.serverName = serverName
    return out

fn seqLenView(cfgs: config.VpnProxyExitConfig[]): int32 =
    return cfgs.len

fn main(): int32 =
    let a: config.VpnProxyExitConfig = exitCfg("64", "64.176.84.12", 7443, "edge-64.internal")
    let b: config.VpnProxyExitConfig = exitCfg("dmit", "154.26.191.226", 7443, "edge-dmit.internal")
    var cfgs: config.VpnProxyExitConfig[]
    cfgs = [a, b]
    puts(strutil.Join(["literal-from-locals len=", IntToStr(cfgs.len)], ""))
    puts(strutil.Join(["callee view len=", IntToStr(seqLenView(cfgs))], ""))
    var states: routing.VpnProxyExitState[]
    states = routing.VpnProxyInitExitStates(cfgs)
    puts(strutil.Join(["init-from-var states len=", IntToStr(states.len)], ""))
    var states2: routing.VpnProxyExitState[]
    states2 = routing.VpnProxyInitExitStates([
        exitCfg("64", "64.176.84.12", 7443, "edge-64.internal"),
        exitCfg("dmit", "154.26.191.226", 7443, "edge-dmit.internal")
    ])
    puts(strutil.Join(["init-from-literal states len=", IntToStr(states2.len)], ""))
    if states2.len >= 1:
        var healthyText: str = "0"
        if states2[0].healthy:
            healthyText = "1"
        puts(strutil.Join(["state0 name=", states2[0].name, " healthy=", healthyText], ""))
    return 0
