import std/system
import std/strutils as strutil

fn main(): int32 =
    var round: int32
    while round < 30:
        var i: int64
        while i < 200000:
            var b: Bytes = BytesAlloc(4096)
            BytesFree(b)
            i = i + 1
        echo(strutil.Join(["round=", IntToStr(round)], ""))
        round = round + 1
    return 0
