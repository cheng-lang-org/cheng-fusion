import std/os
import std/strings
import std/system
import cheng/core/runtime/held_exec_identity
import cheng/core/runtime/production_held_exec_provider as provider

const
    sealPackageCid: str =
        "sha256:1111111111111111111111111111111111111111111111111111111111111111"
    sealCompilerRequestCid: str =
        "sha256:8888888888888888888888888888888888888888888888888888888888888888"

fn fail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

fn sealInput(): provider.CsgCoreProductionPreExecInput =
    var out: provider.CsgCoreProductionPreExecInput
    out.schemaVersion =
        provider.CsgCoreProductionPreExecInputSchemaVersion
    out.semanticCommand =
        provider.CsgCoreProductionPreExecInputCommandSystemLinkExec
    out.packageSourceRootIdentityCid = sealPackageCid
    out.canonicalModulePath = "app/main"
    out.outputRole =
        provider.CsgCoreProductionPreExecInputOutputBuildArtifact
    out.targetTriple = "x86_64-unknown-linux-gnu"
    out.emitKind = provider.CsgCoreProductionPreExecInputEmitExe
    out.reportRole = provider.CsgCoreProductionPreExecInputReportAbsent
    out.symbolVisibility =
        provider.CsgCoreProductionPreExecInputVisibilityPublic
    out.compileMode =
        provider.CsgCoreProductionPreExecInputCompileModeProduction
    out.backendKind = provider.CsgCoreProductionPreExecInputBackendPrimary
    out.jobCount = 1
    out.compilerRequestCid = sealCompilerRequestCid
    return out

fn main(): int32 =
    let input = sealInput()
    var envelope: str
    var heldBundleCid: str
    var err: str
    if !provider.CsgCoreProductionPreExecInputEncodeInto(
           input, envelope, heldBundleCid, err):
        return fail(strings.ConcatStr("encode failed: ", err))
    let bundleOwner = system.RuntimeHeldExecParentSealBundleOwner(
        envelope, heldBundleCid)
    os.WriteLine(
        os.Get_stdout(),
        strings.ConcatStr(
            "held_bundle_bytes=", strings.IntToStr(envelope.len)))
    os.WriteLine(
        os.Get_stdout(),
        strings.ConcatStr("held_bundle_cid=", heldBundleCid))
    let platform = held_exec_identity.ChengHeldExecIdentityPlatform()
    if platform != "linux-x86_64" && platform != "linux-aarch64" &&
       platform != "darwin-arm64":
        if bundleOwner != -1:
            return fail("unsupported platform did not fail closed")
        os.WriteLine(
            os.Get_stdout(),
            "csg_core_production_held_bundle_seal_smoke platform-hard-red ok")
        return 0
    if bundleOwner <= 0:
        return fail(strings.ConcatStr(
            platform, " sealed bundle creation failed"))
    if !system.RuntimeHeldExecBundleOwnerAbort(bundleOwner):
        return fail(strings.ConcatStr(
            platform, " sealed bundle owner abort failed"))
    os.WriteLine(
        os.Get_stdout(),
        strings.ConcatStr(
            "csg_core_production_held_bundle_seal_smoke ",
            strings.ConcatStr(platform, " ok")))
    return 0
