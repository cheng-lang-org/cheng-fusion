# probe_nolibc_concat.cheng — RUNTIME-LIBC-TRUNC / A1 探针(nolibc linux aarch64)
# codegen 对 `str + str` 发射 driver_c_str_concat_bridge(stack-value 传参, borrow 约定)。
# 若 nolibc impl 缺 @borrows 导致被调方按 owned 形参在出口释放 a/b,
# 则调用方持有的 acc 被提前 munmap: 下一轮拼接读取悬空页 -> SIGSEGV,
# 或赋值释放旧 acc 时 double-free。500 轮放大; 全绿则 rc=0。
fn main(): int32 =
    var acc = "ab"
    var i: int32
    while i < 500:
        acc = acc + "cd"
        i = i + 1
    echo("concat_loop_done")
    if acc.len == 1002:
        echo("probe_nolibc_concat ok")
        return 0
    echo("probe_nolibc_concat FAIL")
    return 1
