import cheng/core/csg_core/merkle_store as journal

fn main(): int32 =
    if !journal.ProductionTerminalJournalInitializeBeforeGuardianLoop():
        return 2
    var journalOwner: int32 = -1
    var err: str
    if journal.ProductionTerminalJournalBeginFromDurableClaimOwnerInto(
           -1, journalOwner, err):
        return 3
    if journalOwner != -1 || err.len == 0:
        return 4
    return 0
