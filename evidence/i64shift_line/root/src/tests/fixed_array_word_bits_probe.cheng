import std/system
import std/crypto/p256_fixed as pfix

type
    WordBox =
        limbs: int32[8]

fn main(argc: int32, argv: ptr): int32 =
    argc
    argv
    var box: WordBox
    box.limbs[0] = int32(uint32(0xfffffffe))
    box.limbs[1] = int32(uint32(0xffffffff))
    box.limbs[2] = int32(uint32(0xffffffff))
    let wordBase: uint64 = uint64(1) << uint64(32)
    assert(pfix.P256FixedWordToBitsU64(box.limbs[0]) == wordBase - uint64(2), "fixed_array_word_bits_probe: limb0")
    assert(pfix.P256FixedWordToBitsU64(box.limbs[1]) == wordBase - uint64(1), "fixed_array_word_bits_probe: limb1")
    assert(pfix.P256FixedWordToBitsU64(box.limbs[2]) == wordBase - uint64(1), "fixed_array_word_bits_probe: limb2")
    echo(" fixed_array_word_bits_probe ok")
    return 0
