import std/rawbytes
import std/crypto/sha256

type ColdPlainStoragePair =
    left: int32
    right: int32

type ColdPlainStorageNested =
    pair: ColdPlainStoragePair
    marker: int32

fn ColdPlainStorageLookup(
        source: ColdPlainStoragePair[],
        index: int32): ColdPlainStoragePair =
    return source[index]

fn ColdPlainStorageTypedOmitted(seed: int32): ColdPlainStoragePair =
    var out: ColdPlainStoragePair
    out.left = seed
    return out

fn ColdPlainStorageExplicit(seed: int32): ColdPlainStoragePair =
    var out: ColdPlainStoragePair =
        ColdPlainStoragePair(left: seed, right: seed + 2)
    return out

fn ColdPlainStorageBranch(
        selectLeft: bool,
        seed: int32): ColdPlainStoragePair =
    var out: ColdPlainStoragePair
    if selectLeft:
        out = ColdPlainStoragePair(
            left: seed,
            right: seed + 3)
    else:
        out = ColdPlainStoragePair(
            left: seed + 4,
            right: seed + 5)
    return out

fn ColdPlainStorageNestedValue(
        seed: int32): ColdPlainStorageNested =
    var out: ColdPlainStorageNested
    out.pair.left = seed
    out.marker = seed + 7
    return out

fn ColdPlainStorageLoop(seed: int32): ColdPlainStoragePair =
    var out: ColdPlainStoragePair
    for index in 0..<2:
        out = ColdPlainStoragePair(
            left: seed + index,
            right: seed + index + 8)
    return out

fn main(): int32 =
    var source: ColdPlainStoragePair[]
    add(source, ColdPlainStoragePair(left: 7, right: 11))
    var copied: ColdPlainStoragePair[]
    add(copied, source[0])
    let returned = ColdPlainStorageLookup(source, 0)
    let omitted = ColdPlainStorageTypedOmitted(13)
    let explicit = ColdPlainStorageExplicit(17)
    let branched = ColdPlainStorageBranch(false, 19)
    let nested = ColdPlainStorageNestedValue(29)
    let looped = ColdPlainStorageLoop(31)
    if copied.len != 1 ||
       copied[0].left != 7 ||
       copied[0].right != 11 ||
       returned.left != 7 ||
       returned.right != 11 ||
       omitted.left != 13 ||
       omitted.right != 0 ||
       explicit.left != 17 ||
       explicit.right != 19 ||
       branched.left != 23 ||
       branched.right != 24 ||
       nested.pair.left != 29 ||
       nested.pair.right != 0 ||
       nested.marker != 36 ||
       looped.left != 32 ||
       looped.right != 40:
        return 2
    let input: Bytes = BytesFromString("abc")
    var digest: Bytes = Sha256Digest(input)
    let valid: bool = BytesLen(digest) == 32
    BytesFree(digest)
    if valid:
        return 0
    return 1
