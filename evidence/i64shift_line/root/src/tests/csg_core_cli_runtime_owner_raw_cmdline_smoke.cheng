import std/cmdline as cmdline

fn main(argc: int32, argv: str*): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    assert(
        cmdline.RawParamEquals(1, "production-workload"),
        " csg CLI owner raw cmdline: envelope")
    assert(
        cmdline.RawParamEquals(2, "admit"),
        " csg CLI owner raw cmdline: command")
    assert(
        !cmdline.RawParamEquals(1, "validate"),
        " csg CLI owner raw cmdline: dev command isolation")
    cmdline.ClearCapturedCmdLine()
    assert(
        !cmdline.RawParamEquals(1, "admit"),
        " csg CLI owner raw cmdline: cleared state")
    return 0
