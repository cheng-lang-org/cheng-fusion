import std/system
import std/rawbytes
import std/crypto/sha256
import cheng/std/bytes_layout as layout

fn main(): int32 =
    var input = BytesFromString("abc")
    assert(BytesLen(input) == 3, " sha256 runtime: input len")
    assert(BytesGet(input, 0) == int32('a'), " sha256 runtime: input byte0")
    assert(BytesGet(input, 1) == int32('b'), " sha256 runtime: input byte1")
    assert(BytesGet(input, 2) == int32('c'), " sha256 runtime: input byte2")
    var digest = sha256.Sha256Digest(input)
    assert(BytesLen(digest) == 32, " sha256 runtime: digest len")
    assert(BytesGet(digest, 0) == 0xba, " sha256 runtime: digest byte0")
    assert(BytesGet(digest, 1) == 0x78, " sha256 runtime: digest byte1")
    assert(BytesGet(digest, 31) == 0xad, " sha256 runtime: digest byte31")
    let fixedRes: Result[layout.FixedBytes32] = layout.FixedBytes32FromBytes(digest)
    assert(IsOk(fixedRes), " sha256 runtime: fixed32 conversion")
    var state = BytesAlloc(32)
    sha256.StoreU32LE(state, 0, sha256.U32FromBytes(0x6a, 0x09, 0xe6, 0x67))
    sha256.StoreU32LE(state, 4, sha256.U32FromBytes(0xbb, 0x67, 0xae, 0x85))
    sha256.StoreU32LE(state, 8, sha256.U32FromBytes(0x3c, 0x6e, 0xf3, 0x72))
    sha256.StoreU32LE(state, 12, sha256.U32FromBytes(0xa5, 0x4f, 0xf5, 0x3a))
    sha256.StoreU32LE(state, 16, sha256.U32FromBytes(0x51, 0x0e, 0x52, 0x7f))
    sha256.StoreU32LE(state, 20, sha256.U32FromBytes(0x9b, 0x05, 0x68, 0x8c))
    sha256.StoreU32LE(state, 24, sha256.U32FromBytes(0x1f, 0x83, 0xd9, 0xab))
    sha256.StoreU32LE(state, 28, sha256.U32FromBytes(0x5b, 0xe0, 0xcd, 0x19))
    var block = BytesAlloc(64)
    BytesSet(block, 0, int32('a'))
    BytesSet(block, 1, int32('b'))
    BytesSet(block, 2, int32('c'))
    BytesSet(block, 3, 0x80)
    BytesSet(block, 63, 24)
    var kTable = BytesAlloc(256)
    for index in 0..<64:
        sha256.StoreU32LE(kTable, index * 4, sha256.K256(index))
    var schedule: int64[]
    setLen(schedule, 64)
    sha256.Sha256CompressBlockReuse(state, block, kTable, schedule)
    var reusedDigest = BytesAlloc(32)
    for index in 0..<8:
        sha256.SetU32BE(
            reusedDigest, index * 4,
            sha256.LoadU32LE(state, index * 4))
    for index in 0..<32:
        assert(BytesGet(reusedDigest, index) == BytesGet(digest, index),
               " sha256 runtime: reused block digest")
    BytesFree(reusedDigest)
    BytesFree(kTable)
    BytesFree(block)
    BytesFree(state)
    echo(" sha256_runtime_smoke ok")
    return 0
