# minimal probe 7: pure sret shape - constructor returns Result holding a
# fresh clone; nothing else. If this crashes at exit the defect is in the
# sret boundary itself, independent of argument shapes.
import std/system
import std/result
import std/strings as strings

fn MakeErr(msg: str): Result[bool] =
    return Err[bool](strings.CloneStr(msg))

fn main(): int32 =
    let r = MakeErr("pure sret probe")
    if !r.ok:
        echo("held")
    echo("done")
    return 0
