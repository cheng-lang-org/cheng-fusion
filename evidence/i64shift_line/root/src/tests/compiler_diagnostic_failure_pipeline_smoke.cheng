import std/cmdline as cmdline
import std/os
import std/os_host_process as hostos
import std/strutils as strutil
import std/system
import cheng/core/lang/parser
import cheng/core/lang/diagnostic_failure as failure
import cheng/core/csg_core/compiler_snapshot_cargo as cargo
import cheng/core/tooling/path as chengpath
import cheng/std/bytes_layout as layout

fn cloneFailure(source: var failure.DiagnosticFailureArtifact): failure.DiagnosticFailureArtifact =
    var out: failure.DiagnosticFailureArtifact
    var err: str
    assert(failure.DiagnosticFailureArtifactCloneInto(
               source, out, err), err)
    return out

fn releaseFailure(artifact: var failure.DiagnosticFailureArtifact) =
    var receipt: failure.DiagnosticFailureArtifactReleaseReceipt
    failure.DiagnosticFailureArtifactReleaseInto(artifact, receipt)

fn ownedDiagnosticCode(selector: int32): str =
    let suffix = selector == 1 ? "CSG" : "INVALID"
    return Fmt"CHENG-SNAPSHOT-COMPILER-{suffix}"

fn ownedDiagnosticMessage(id: int32): str =
    return Fmt"owned diagnostic message {id}"

fn runSelfMoveNegative() =
    var artifact: failure.DiagnosticFailureArtifact
    var err: str
    assert(failure.DiagnosticFailureArtifactSealParserLocalInto(
               "x", 0,
               failure.DiagnosticFailureAnchorSource,
               -1, -1, 0, 1, "self move",
               artifact, err), err)
    failure.DiagnosticFailureArtifactMoveInto(artifact, artifact)

fn selfMoveHardFails(): bool =
    let selfPath = cmdline.paramStr(0)
    if selfPath == "":
        return false
    var output: str
    var exitCode: int32
    hostos.ExecFileCaptureFill(
        selfPath,
        ["diagnostic-failure-self-move"],
        [],
        "",
        true,
        60,
        output,
        exitCode)
    return exitCode != 0 &&
           strutil.Contains(
               output,
               "artifact move source aliases destination descriptor")

fn main(): int32 =
    if cmdline.paramStr(1) == "diagnostic-failure-self-move":
        runSelfMoveNegative()
        return 71
    os.SetEnv("CHENG_STRICT_CALL_SYNTAX", "1")
    let fixturePath = chengpath.PathJoin(
        os.GetCurrentDir(),
        "src/tests/compiler_diagnostic_failure_malformed_fixture.cheng")
    let sourceText = os.ReadFile(fixturePath)
    assert(sourceText.len > 2,
           "diagnostic failure pipeline: fixture missing")

    var tree: parser.ParserValueExprTree
    var err: str
    assert(!parser.ParserValueExprReadTreeFromText(
               sourceText, tree, err),
           "diagnostic failure pipeline: malformed fixture parsed")
    var artifact: failure.DiagnosticFailureArtifact
    assert(parser.ParserValueExprTreeFailureArtifactMoveInto(
               tree, artifact, err), err)
    parser.ParserValueExprTreeRelease(tree)
    assert(tree == nil,
           "diagnostic failure pipeline: failure outcome not released")
    assert(failure.DiagnosticFailureArtifactStrictValidateInto(
               artifact, err), err)
    assert(artifact.producerKinds.len == 1 &&
           artifact.producerKinds[0] ==
               failure.DiagnosticFailureProducerParser &&
           artifact.anchorKinds[0] ==
               failure.DiagnosticFailureAnchorSpan &&
           artifact.spanStartBytes[0] == sourceText.len - 2 &&
           artifact.spanEndBytes[0] == sourceText.len - 1 &&
           artifact.severities[0] ==
               failure.DiagnosticFailureSeverityError &&
           artifact.producerSourceIndexes[0] == 0 &&
           artifact.producerSourceSnapshotCounts[0] == 1 &&
           artifact.producerSourceByteLengths[0] == sourceText.len &&
           layout.FixedBytes32Equal(
               artifact.producerDocumentCids[0],
               failure.DiagnosticFailureLocalDocumentCid(0)) &&
           layout.FixedBytes32Equal(
               artifact.producerContentCids[0],
               failure.DiagnosticFailureSourceContentCid(sourceText)) &&
           layout.FixedBytes32Equal(
               artifact.producerSourceIdentityReceiptCids[0],
               failure.DiagnosticFailureLocalSourceIdentityReceiptCid(
                   0, 1,
                   artifact.producerDocumentCids[0],
                   artifact.producerContentCids[0])),
           "diagnostic failure pipeline: exact parser identity split")

    let spaceCallSource =
        "fn identity(x: int32): int32 =\n    return x\n\nfn main(): int32 =\n    return identity 1\n"
    var spaceCallTree: parser.ParserValueExprTree
    assert(!parser.ParserValueExprReadTreeFromText(
               spaceCallSource, spaceCallTree, err),
           "diagnostic failure pipeline: strict SpaceCall parsed")
    var spaceCallArtifact: failure.DiagnosticFailureArtifact
    assert(parser.ParserValueExprTreeFailureArtifactMoveInto(
               spaceCallTree, spaceCallArtifact, err), err)
    parser.ParserValueExprTreeRelease(spaceCallTree)
    assert(spaceCallArtifact.anchorKinds[0] ==
               failure.DiagnosticFailureAnchorParserNode &&
           spaceCallArtifact.parserNodeIds[0] >= 0 &&
           spaceCallArtifact.ownerDeclarationSourceLocalRows[0] == -1 &&
           chengpath.TextSlice(
               spaceCallSource,
               spaceCallArtifact.spanStartBytes[0],
               spaceCallArtifact.spanEndBytes[0] -
                   spaceCallArtifact.spanStartBytes[0]) ==
               "identity 1" &&
           failure.DiagnosticFailureArtifactStrictValidateInto(
               spaceCallArtifact, err),
           "diagnostic failure pipeline: strict SpaceCall identity split")

    let multilineSpaceCallSource =
        "fn identity(x: int32): int32 =\n    return x\n\nfn main(): int32 =\n    let raw = \"\"\"\n        alpha\n        \"\"\"\n    return identity 1\n"
    var rewrittenSpaceCallSource: str
    var multilineCoordinateMap: parser.ParserSourceRewriteCoordinateMap
    assert(parser.ParserRewriteMultilineStringSourceTextWithCoordinateMap(
               multilineSpaceCallSource,
               rewrittenSpaceCallSource,
               multilineCoordinateMap,
               err),
           "diagnostic failure pipeline: multiline rewrite failed")
    var multilineSpaceCallTree: parser.ParserValueExprTree
    assert(!parser.ParserValueExprReadTreeFromText(
               rewrittenSpaceCallSource,
               multilineSpaceCallTree,
               err),
           "diagnostic failure pipeline: multiline strict SpaceCall parsed")
    var multilineSpaceCallArtifact: failure.DiagnosticFailureArtifact
    assert(parser.ParserValueExprTreeFailureArtifactMoveInto(
               multilineSpaceCallTree,
               multilineSpaceCallArtifact,
               err), err)
    parser.ParserValueExprTreeRelease(multilineSpaceCallTree)
    var parserNodeStart: int32
    var parserNodeEnd: int32
    assert(parser.ParserDiagnosticFailureAnchorSpanToOriginalInto(
               failure.DiagnosticFailureAnchorParserNode,
               multilineCoordinateMap,
               multilineSpaceCallSource,
               rewrittenSpaceCallSource,
               multilineSpaceCallArtifact.spanStartBytes[0],
               multilineSpaceCallArtifact.spanEndBytes[0],
               parserNodeStart,
               parserNodeEnd,
               err) &&
           chengpath.TextSlice(
               multilineSpaceCallSource,
               parserNodeStart,
               parserNodeEnd - parserNodeStart) == "identity 1",
           "diagnostic failure pipeline: parser-node rewrite span drift")
    var ownerStart: int32
    var ownerEnd: int32
    assert(parser.ParserDiagnosticFailureAnchorSpanToOriginalInto(
               failure.DiagnosticFailureAnchorOwnerDeclaration,
               multilineCoordinateMap,
               multilineSpaceCallSource,
               rewrittenSpaceCallSource,
               multilineSpaceCallArtifact.spanStartBytes[0],
               multilineSpaceCallArtifact.spanEndBytes[0],
               ownerStart,
               ownerEnd,
               err) &&
           ownerStart == parserNodeStart &&
           ownerEnd == parserNodeEnd,
           "diagnostic failure pipeline: owner rewrite span drift")
    var sourceStart: int32
    var sourceEnd: int32
    assert(parser.ParserDiagnosticFailureAnchorSpanToOriginalInto(
               failure.DiagnosticFailureAnchorSource,
               multilineCoordinateMap,
               multilineSpaceCallSource,
               rewrittenSpaceCallSource,
               multilineSpaceCallArtifact.spanStartBytes[0],
               multilineSpaceCallArtifact.spanEndBytes[0],
               sourceStart,
               sourceEnd,
               err) &&
           sourceStart == 0 &&
           sourceEnd == multilineSpaceCallSource.len,
           "diagnostic failure pipeline: source rewrite span drift")

    let identicalSource = "fn same() int32 =\n    return 1\n"
    let firstDocumentCid =
        failure.DiagnosticFailureLocalDocumentCid(0)
    let secondDocumentCid =
        failure.DiagnosticFailureLocalDocumentCid(1)
    let identicalContentCid =
        failure.DiagnosticFailureSourceContentCid(identicalSource)
    let sharedSourceReceiptCid =
        artifact.producerSourceIdentityReceiptCids[0]
    var firstSourceArtifact: failure.DiagnosticFailureArtifact
    var secondSourceArtifact: failure.DiagnosticFailureArtifact
    assert(failure.DiagnosticFailureArtifactSealParserPortableInto(
               identicalSource, 0, 2, sharedSourceReceiptCid,
               firstDocumentCid, identicalContentCid,
               failure.DiagnosticFailureAnchorSpan,
               -1, -1, 0, 2, "same source failure",
               firstSourceArtifact, err), err)
    assert(failure.DiagnosticFailureArtifactSealParserPortableInto(
               identicalSource, 1, 2, sharedSourceReceiptCid,
               secondDocumentCid, identicalContentCid,
               failure.DiagnosticFailureAnchorSpan,
               -1, -1, 0, 2, "same source failure",
               secondSourceArtifact, err), err)
    let producerDocumentCids =
        [firstDocumentCid, secondDocumentCid]
    let producerContentCids =
        [identicalContentCid, identicalContentCid]
    assert(!layout.FixedBytes32Equal(
               firstDocumentCid, secondDocumentCid) &&
           layout.FixedBytes32Equal(
               firstSourceArtifact.producerContentCids[0],
               secondSourceArtifact.producerContentCids[0]) &&
           failure.DiagnosticFailureArtifactPortableAuthorityStrictValidateInto(
               firstSourceArtifact,
               sharedSourceReceiptCid,
               producerDocumentCids,
               producerContentCids,
               err) &&
           failure.DiagnosticFailureArtifactPortableAuthorityStrictValidateInto(
               secondSourceArtifact,
               sharedSourceReceiptCid,
               producerDocumentCids,
               producerContentCids,
               err),
           "diagnostic failure pipeline: identical source authority split")
    var recomputedIndexAttack = cloneFailure(firstSourceArtifact)
    recomputedIndexAttack.producerSourceIndexes[0] = 1
    recomputedIndexAttack.proofCids[0] =
        failure.DiagnosticFailureRowProofCid(
            recomputedIndexAttack, 0)
    recomputedIndexAttack.receiptCid =
        failure.DiagnosticFailureReceiptCid(recomputedIndexAttack)
    assert(failure.DiagnosticFailureArtifactStrictValidateInto(
               recomputedIndexAttack, err) &&
           !failure.DiagnosticFailureArtifactPortableAuthorityStrictValidateInto(
               recomputedIndexAttack,
               sharedSourceReceiptCid,
               producerDocumentCids,
               producerContentCids,
               err),
           "diagnostic failure pipeline: recomputed source index attack survived")
    var recomputedDocumentAttack = cloneFailure(firstSourceArtifact)
    recomputedDocumentAttack.producerDocumentCids[0] =
        secondDocumentCid
    recomputedDocumentAttack.proofCids[0] =
        failure.DiagnosticFailureRowProofCid(
            recomputedDocumentAttack, 0)
    recomputedDocumentAttack.receiptCid =
        failure.DiagnosticFailureReceiptCid(
            recomputedDocumentAttack)
    assert(failure.DiagnosticFailureArtifactStrictValidateInto(
               recomputedDocumentAttack, err) &&
           !failure.DiagnosticFailureArtifactPortableAuthorityStrictValidateInto(
               recomputedDocumentAttack,
               sharedSourceReceiptCid,
               producerDocumentCids,
               producerContentCids,
               err),
           "diagnostic failure pipeline: recomputed document exchange survived")
    var recomputedContentAttack = cloneFailure(firstSourceArtifact)
    recomputedContentAttack.producerContentCids[0] =
        failure.DiagnosticFailureSourceContentCid(
            "different source bytes")
    recomputedContentAttack.proofCids[0] =
        failure.DiagnosticFailureRowProofCid(
            recomputedContentAttack, 0)
    recomputedContentAttack.receiptCid =
        failure.DiagnosticFailureReceiptCid(
            recomputedContentAttack)
    assert(failure.DiagnosticFailureArtifactStrictValidateInto(
               recomputedContentAttack, err) &&
           !failure.DiagnosticFailureArtifactPortableAuthorityStrictValidateInto(
               recomputedContentAttack,
               sharedSourceReceiptCid,
               producerDocumentCids,
               producerContentCids,
               err),
           "diagnostic failure pipeline: recomputed content exchange survived")
    var recomputedReceiptAttack = cloneFailure(firstSourceArtifact)
    recomputedReceiptAttack.producerSourceIdentityReceiptCids[0] =
        failure.DiagnosticFailureLocalSourceIdentityReceiptCid(
            1, 2, secondDocumentCid, identicalContentCid)
    recomputedReceiptAttack.proofCids[0] =
        failure.DiagnosticFailureRowProofCid(
            recomputedReceiptAttack, 0)
    recomputedReceiptAttack.receiptCid =
        failure.DiagnosticFailureReceiptCid(
            recomputedReceiptAttack)
    assert(failure.DiagnosticFailureArtifactStrictValidateInto(
               recomputedReceiptAttack, err) &&
           !failure.DiagnosticFailureArtifactPortableAuthorityStrictValidateInto(
               recomputedReceiptAttack,
               sharedSourceReceiptCid,
               producerDocumentCids,
               producerContentCids,
               err),
           "diagnostic failure pipeline: recomputed source receipt exchange survived")

    assert(failure.DiagnosticFailureArtifactPhysicalBufferCount(
               firstSourceArtifact) == 16 &&
           failure.DiagnosticFailureArtifactDynamicSequenceBytes(
               firstSourceArtifact, false) > Int64(0) &&
           failure.DiagnosticFailureArtifactDynamicSequenceBytes(
               firstSourceArtifact, true) >=
               failure.DiagnosticFailureArtifactDynamicSequenceBytes(
                   firstSourceArtifact, false) &&
           failure.DiagnosticFailureArtifactScalarBytes(
               firstSourceArtifact) ==
               Int64(sizeof(failure.DiagnosticFailureArtifact)),
           "diagnostic failure pipeline: lifecycle ledger split")
    var releasedArtifact = cloneFailure(firstSourceArtifact)
    var firstRelease: failure.DiagnosticFailureArtifactReleaseReceipt
    failure.DiagnosticFailureArtifactReleaseInto(
        releasedArtifact, firstRelease)
    assert(firstRelease.hadPayload &&
           firstRelease.sequenceCapacityBefore > Int64(0) &&
           firstRelease.logicalStringCountBefore == Int64(2) &&
           firstRelease.physicalFreeCount >= Int64(16) &&
           firstRelease.storageReleased &&
           failure.DiagnosticFailureArtifactReleased(releasedArtifact) &&
           failure.DiagnosticFailureArtifactPhysicalBufferCount(
               releasedArtifact) == 0 &&
           failure.DiagnosticFailureArtifactDynamicSequenceBytes(
               releasedArtifact, true) == Int64(0),
           "diagnostic failure pipeline: first release incomplete")
    var secondRelease: failure.DiagnosticFailureArtifactReleaseReceipt
    failure.DiagnosticFailureArtifactReleaseInto(
        releasedArtifact, secondRelease)
    assert(!secondRelease.hadPayload &&
           secondRelease.sequenceCapacityBefore == Int64(0) &&
           secondRelease.logicalStringCountBefore == Int64(0) &&
           secondRelease.physicalFreeCount == Int64(0) &&
           secondRelease.orcReleaseCount == Int64(0) &&
           secondRelease.storageReleased &&
           failure.DiagnosticFailureArtifactReleased(releasedArtifact),
           "diagnostic failure pipeline: second release is not idempotent")

    var partialInvalid: failure.DiagnosticFailureArtifact
    partialInvalid.schemaVersion =
        failure.DiagnosticFailureSchemaVersionLatest
    add(partialInvalid.codes, "partial")
    var partialRelease: failure.DiagnosticFailureArtifactReleaseReceipt
    failure.DiagnosticFailureArtifactReleaseInto(
        partialInvalid, partialRelease)
    assert(partialRelease.hadPayload &&
           partialRelease.sequenceCapacityBefore > Int64(0) &&
           partialRelease.logicalStringCountBefore == Int64(1) &&
           partialRelease.storageReleased &&
           failure.DiagnosticFailureArtifactReleased(partialInvalid),
           "diagnostic failure pipeline: partial-invalid release incomplete")

    var moveSource = cloneFailure(firstSourceArtifact)
    var moveDestination = cloneFailure(secondSourceArtifact)
    let moveReceipt = moveSource.receiptCid
    failure.DiagnosticFailureArtifactMoveInto(
        moveDestination, moveSource)
    assert(failure.DiagnosticFailureArtifactReleased(moveSource) &&
           failure.DiagnosticFailureArtifactStrictValidateInto(
               moveDestination, err) &&
           layout.FixedBytes32Equal(
               moveDestination.receiptCid, moveReceipt),
           "diagnostic failure pipeline: owning move split")
    var moveRelease: failure.DiagnosticFailureArtifactReleaseReceipt
    failure.DiagnosticFailureArtifactReleaseInto(
        moveDestination, moveRelease)

    var independentClone = cloneFailure(firstSourceArtifact)
    independentClone.messages[0] = "independent clone"
    independentClone.proofCids[0] =
        failure.DiagnosticFailureRowProofCid(
            independentClone, 0)
    independentClone.receiptCid =
        failure.DiagnosticFailureReceiptCid(independentClone)
    assert(firstSourceArtifact.messages[0] == "same source failure" &&
           independentClone.messages[0] == "independent clone" &&
           failure.DiagnosticFailureArtifactStrictValidateInto(
               independentClone, err),
           "diagnostic failure pipeline: clone storage is not independent")
    var independentRelease: failure.DiagnosticFailureArtifactReleaseReceipt
    failure.DiagnosticFailureArtifactReleaseInto(
        independentClone, independentRelease)

    var selfClone = cloneFailure(firstSourceArtifact)
    let selfCloneReceipt = selfClone.receiptCid
    assert(failure.DiagnosticFailureArtifactCloneInto(
               selfClone, selfClone, err) &&
           failure.DiagnosticFailureArtifactStrictValidateInto(
               selfClone, err) &&
           layout.FixedBytes32Equal(
               selfClone.receiptCid, selfCloneReceipt),
           "diagnostic failure pipeline: self clone split")
    var selfCloneRelease: failure.DiagnosticFailureArtifactReleaseReceipt
    failure.DiagnosticFailureArtifactReleaseInto(
        selfClone, selfCloneRelease)

    var sealDestination = cloneFailure(secondSourceArtifact)
    let sealDestinationReceipt = sealDestination.receiptCid
    let wrongContentCid =
        failure.DiagnosticFailureSourceContentCid(
            "wrong seal source bytes")
    assert(!failure.DiagnosticFailureArtifactSealParserPortableInto(
                identicalSource,
                0,
                2,
                sharedSourceReceiptCid,
                firstDocumentCid,
                wrongContentCid,
                failure.DiagnosticFailureAnchorSpan,
                -1,
                -1,
                0,
                2,
                "failed seal",
                sealDestination,
                err) &&
           layout.FixedBytes32Equal(
               sealDestination.receiptCid,
               sealDestinationReceipt) &&
           failure.DiagnosticFailureArtifactStrictValidateInto(
               sealDestination, err),
           "diagnostic failure pipeline: failed seal changed destination")
    var sealDestinationRelease: failure.DiagnosticFailureArtifactReleaseReceipt
    failure.DiagnosticFailureArtifactReleaseInto(
        sealDestination, sealDestinationRelease)

    var orcArtifact = cloneFailure(firstSourceArtifact)
    var ownedCode = ownedDiagnosticCode(1)
    var ownedMessage = ownedDiagnosticMessage(7)
    orcArtifact.codes[0] = ownedCode
    orcArtifact.messages[0] = ownedMessage
    ownedCode = ""
    ownedMessage = ""
    orcArtifact.proofCids[0] =
        failure.DiagnosticFailureRowProofCid(orcArtifact, 0)
    orcArtifact.receiptCid =
        failure.DiagnosticFailureReceiptCid(orcArtifact)
    assert(failure.DiagnosticFailureArtifactStrictValidateInto(
               orcArtifact, err),
           "diagnostic failure pipeline: owned string artifact invalid")
    var orcRelease: failure.DiagnosticFailureArtifactReleaseReceipt
    failure.DiagnosticFailureArtifactReleaseInto(
        orcArtifact, orcRelease)
    assert(orcRelease.logicalStringCountBefore == Int64(2) &&
           orcRelease.orcReleaseCount >= Int64(2) &&
           orcRelease.physicalFreeCount >= Int64(16) &&
           orcRelease.storageReleased,
           Fmt"diagnostic failure pipeline: codes/messages ORC release unproved strings={orcRelease.logicalStringCountBefore} releases={orcRelease.orcReleaseCount} frees={orcRelease.physicalFreeCount}")

    var preservedDestination = cloneFailure(secondSourceArtifact)
    let preservedReceipt = preservedDestination.receiptCid
    var invalidCloneSource = cloneFailure(firstSourceArtifact)
    invalidCloneSource.proofCids[0] = layout.FixedBytes32()
    assert(!failure.DiagnosticFailureArtifactCloneInto(
                invalidCloneSource, preservedDestination, err) &&
           layout.FixedBytes32Equal(
               preservedDestination.receiptCid, preservedReceipt) &&
           failure.DiagnosticFailureArtifactStrictValidateInto(
               preservedDestination, err),
           "diagnostic failure pipeline: failed clone changed destination")
    var invalidRelease: failure.DiagnosticFailureArtifactReleaseReceipt
    failure.DiagnosticFailureArtifactReleaseInto(
        invalidCloneSource, invalidRelease)
    var preservedRelease: failure.DiagnosticFailureArtifactReleaseReceipt
    failure.DiagnosticFailureArtifactReleaseInto(
        preservedDestination, preservedRelease)
    assert(selfMoveHardFails(),
           "diagnostic failure pipeline: self move did not hard-fail")

    var parserOwnedTree: parser.ParserValueExprTree
    assert(!parser.ParserValueExprReadTreeFromText(
               sourceText, parserOwnedTree, err),
           "diagnostic failure pipeline: parser owner fixture parsed")
    parser.ParserValueExprTreeRelease(parserOwnedTree)
    assert(parserOwnedTree == nil,
           "diagnostic failure pipeline: parser owner retained artifact")

    var firstCargo =
        cargo.CsgCompilerDiagnosticFailureCargoBuild(artifact)
    assert(firstCargo.ok, firstCargo.error)
    var structuralStandaloneCargo =
        cargo.CsgCompilerDiagnosticFailureCargoBuild(
            spaceCallArtifact)
    assert(!structuralStandaloneCargo.ok &&
           structuralStandaloneCargo.error ==
               " csg compiler diagnostic failure cargo: structural authority required",
           "diagnostic failure pipeline: structural cargo bypassed parser authority")
    var secondCargo =
        cargo.CsgCompilerDiagnosticFailureCargoBuild(artifact)
    assert(secondCargo.ok &&
           layout.FixedBytes32Equal(firstCargo.factsRootCid,
                                    secondCargo.factsRootCid) &&
           layout.FixedBytes32Equal(firstCargo.cargoCid,
                                    secondCargo.cargoCid),
           "diagnostic failure pipeline: cargo is not deterministic")
    let verified = cargo.CsgCompilerDiagnosticFailureCargoVerify(
        firstCargo.csgcBytes, firstCargo.factsRootCid)
    assert(verified.ok &&
           layout.FixedBytes32Equal(verified.cargoCid,
                                    firstCargo.cargoCid),
           verified.error)
    assert(firstCargo.canonicalLines.len == 2 &&
           firstCargo.canonicalLines[0] ==
               "{\"features\":[\"compiler_semantic_snapshot_failure\"],\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}",
           "diagnostic failure pipeline: failure family polluted accepted schema")

    var schemaMutation = cloneFailure(artifact)
    schemaMutation.schemaVersion = 0
    var schemaCargo =
        cargo.CsgCompilerDiagnosticFailureCargoBuild(schemaMutation)
    assert(!schemaCargo.ok,
           "diagnostic failure pipeline: old schema accepted")

    var deletionMutation = cloneFailure(artifact)
    deletionMutation.proofCids = []
    var deletionCargo =
        cargo.CsgCompilerDiagnosticFailureCargoBuild(deletionMutation)
    assert(!deletionCargo.ok,
           "diagnostic failure pipeline: deleted proof accepted")

    var exchangeMutation = cloneFailure(artifact)
    let originalStart = exchangeMutation.spanStartBytes[0]
    exchangeMutation.spanStartBytes[0] =
        exchangeMutation.spanEndBytes[0]
    exchangeMutation.spanEndBytes[0] = originalStart
    var exchangeCargo =
        cargo.CsgCompilerDiagnosticFailureCargoBuild(exchangeMutation)
    assert(!exchangeCargo.ok,
           "diagnostic failure pipeline: exchanged span accepted")

    var codeMutation = cloneFailure(artifact)
    codeMutation.codes[0] = "CHENG-MUTATED"
    var codeCargo =
        cargo.CsgCompilerDiagnosticFailureCargoBuild(codeMutation)
    assert(!codeCargo.ok,
           "diagnostic failure pipeline: code mutation accepted")

    var messageMutation = cloneFailure(artifact)
    messageMutation.messages[0] = "mutated parser failure"
    var messageCargo =
        cargo.CsgCompilerDiagnosticFailureCargoBuild(messageMutation)
    assert(!messageCargo.ok,
           "diagnostic failure pipeline: message mutation accepted")

    var proofMutation = cloneFailure(artifact)
    proofMutation.proofCids[0] = layout.FixedBytes32()
    var proofCargo =
        cargo.CsgCompilerDiagnosticFailureCargoBuild(proofMutation)
    assert(!proofCargo.ok,
           "diagnostic failure pipeline: proof mutation accepted")

    var severityMutation = cloneFailure(artifact)
    severityMutation.severities[0] = 2
    var severityCargo =
        cargo.CsgCompilerDiagnosticFailureCargoBuild(severityMutation)
    assert(!severityCargo.ok,
           "diagnostic failure pipeline: warning severity accepted")

    cargo.CsgCompilerDiagnosticFailureCargoRelease(schemaCargo)
    cargo.CsgCompilerDiagnosticFailureCargoRelease(deletionCargo)
    cargo.CsgCompilerDiagnosticFailureCargoRelease(exchangeCargo)
    cargo.CsgCompilerDiagnosticFailureCargoRelease(codeCargo)
    cargo.CsgCompilerDiagnosticFailureCargoRelease(messageCargo)
    cargo.CsgCompilerDiagnosticFailureCargoRelease(proofCargo)
    cargo.CsgCompilerDiagnosticFailureCargoRelease(severityCargo)
    cargo.CsgCompilerDiagnosticFailureCargoRelease(firstCargo)
    cargo.CsgCompilerDiagnosticFailureCargoRelease(secondCargo)
    releaseFailure(severityMutation)
    releaseFailure(proofMutation)
    releaseFailure(messageMutation)
    releaseFailure(codeMutation)
    releaseFailure(exchangeMutation)
    releaseFailure(deletionMutation)
    releaseFailure(schemaMutation)
    releaseFailure(recomputedReceiptAttack)
    releaseFailure(recomputedContentAttack)
    releaseFailure(recomputedDocumentAttack)
    releaseFailure(recomputedIndexAttack)
    releaseFailure(secondSourceArtifact)
    releaseFailure(firstSourceArtifact)
    releaseFailure(multilineSpaceCallArtifact)
    releaseFailure(spaceCallArtifact)
    releaseFailure(artifact)
    echo("compiler_diagnostic_failure_pipeline_smoke: ok")
    return 0
