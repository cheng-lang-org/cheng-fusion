import std/system as system

# D4 str-rebind probe: str local rebound each iteration (concat allocates a
# fresh buffer per iteration). Leak -> ~+1 block per round (or more, element
# buffers included).

var probeSink: int32

fn RepeatStrRebind(rounds: int32): int32 =
    var s: str = Fmt"seed"
    var r: int32
    while r < rounds:
        s = Fmt"{Int32(r)}-{s}"
        r = r + 1
    return s.len

fn main(): int32 =
    let before = system.MemLiveAllocations()
    let observed = RepeatStrRebind(400)
    let delta = system.MemLiveAllocations() - before
    probeSink = observed
    if observed <= 0:
        return 99
    if delta <= 0:
        return 0
    if delta > 63:
        return 63
    return int32(delta)
