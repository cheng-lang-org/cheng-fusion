import std/os as os
import std/strformat
import cheng/core/tooling/backend_driver_main as driver_main
import cheng/core/tooling/backend_driver_dispatch_min as dispatch_min

fn assertLowerBoundFixture(sourceText: int64,
                           csgGraph: int64,
                           exprLayer: int64,
                           typedFacts: int64,
                           typedIr: int64,
                           lowering: int64,
                           primary: int64,
                           provider: int64,
                           link: int64,
                           report: int64,
                           typedIrFunctions: int64,
                           sourceFiles: int64,
                           exclusiveExpected: int64,
                           consumeExpected: int64,
                           lowerBoundExpected: int64,
                           label: str) =
    var mainModel: driver_main.BackendDriverFullRssMemoryModel
    var dispatchModel: dispatch_min.BackendDriverDispatchMinFullRssMemoryModel
    var reason: str
    assert(driver_main.BackendDriverFullRssMemoryModelTryBuild(
               sourceText, csgGraph, exprLayer, typedFacts, typedIr,
               lowering, primary, provider, link, report,
               typedIrFunctions, sourceFiles, int64(1073741824),
               mainModel, reason),
           Fmt"{label} main TryBuild failed reason={reason}")
    assert(dispatch_min.BackendDriverDispatchMinFullRssMemoryModelTryBuild(
               sourceText, csgGraph, exprLayer, typedFacts, typedIr,
               lowering, primary, provider, link, report,
               typedIrFunctions, sourceFiles, int64(1073741824),
               dispatchModel, reason),
           Fmt"{label} dispatch TryBuild failed reason={reason}")
    assert(mainModel.exclusivePhaseLowerBoundBytes == exclusiveExpected,
           Fmt"{label} main exclusive expected={exclusiveExpected} actual={mainModel.exclusivePhaseLowerBoundBytes}")
    assert(dispatchModel.exclusivePhaseLowerBoundBytes == exclusiveExpected,
           Fmt"{label} dispatch exclusive expected={exclusiveExpected} actual={dispatchModel.exclusivePhaseLowerBoundBytes}")
    assert(mainModel.consumeWindowLowerBoundBytes == consumeExpected,
           Fmt"{label} main consume expected={consumeExpected} actual={mainModel.consumeWindowLowerBoundBytes}")
    assert(dispatchModel.consumeWindowLowerBoundBytes == consumeExpected,
           Fmt"{label} dispatch consume expected={consumeExpected} actual={dispatchModel.consumeWindowLowerBoundBytes}")
    assert(mainModel.modeledLowerBoundBytes == lowerBoundExpected,
           Fmt"{label} main lower bound expected={lowerBoundExpected} actual={mainModel.modeledLowerBoundBytes}")
    assert(dispatchModel.modeledLowerBoundBytes == lowerBoundExpected,
           Fmt"{label} dispatch lower bound expected={lowerBoundExpected} actual={dispatchModel.modeledLowerBoundBytes}")
    assert(mainModel.exclusivePhaseLowerBoundBytes <=
           mainModel.consumeWindowLowerBoundBytes,
           Fmt"{label} exclusive must be <= consume window")
    assert(mainModel.modeledLowerBoundBytes ==
           mainModel.consumeWindowLowerBoundBytes + mainModel.orcBytes,
           Fmt"{label} lower bound must be consume window plus ORC")
    assert(mainModel.modeledLowerBoundBytes <= os.CompileRssTheoryHardGateBytes(),
           Fmt"{label} theory lower bound must fit official 1GiB hard gate")
    assert(driver_main.BackendDriverCompileRssTheoryLowerBoundBytes(mainModel) ==
           lowerBoundExpected,
           Fmt"{label} main helper")
    assert(dispatch_min.BackendDriverDispatchMinCompileRssTheoryLowerBoundBytes(
               dispatchModel) == lowerBoundExpected,
           Fmt"{label} dispatch helper")

fn main(): int32 =
    # Fixture A: closed-form from SoA live sizes. lowering=100 dominates exclusive;
    # consume window keeps source+typedIr across lowering bind (102); ORC=48+64.
    assertLowerBoundFixture(int64(1), int64(1), int64(1), int64(1), int64(1),
                            int64(100), int64(1), int64(0), int64(0), int64(1),
                            int64(1), int64(1),
                            int64(100), int64(102), int64(214),
                            "fixture_a")
    # Fixture B: wall12-scale 2 functions / 1 file. CSG consume window is the
    # peak (source + graph + expr + facts + typed IR). Data lower bound 31812B.
    assertLowerBoundFixture(int64(428), int64(4480), int64(1920), int64(23800),
                            int64(1024), int64(2912), int64(1760), int64(0),
                            int64(0), int64(4160), int64(2), int64(1),
                            int64(31224), int64(31652), int64(31812),
                            "fixture_wall12_scale")
    return 0
