# web_platform_closure_runtime_smoke.cheng
# Proves the service-worker and geolocation runtime substrate compiles and runs:
# the two families the ts-csg provider table closes as
#   cheng/core/runtime/web_service_worker_runtime.register-lite
#   cheng/core/runtime/web_geolocation_provider.current-position
# Geolocation native bridges are satisfied locally via @exportc (deterministic
# test doubles); the service-worker module is pure Cheng and needs no host.
import std/strutils as strutil
import cheng/core/runtime/web_service_worker_runtime as sw
import cheng/core/runtime/web_geolocation_provider as geo

fn smokeFail(label: str): int32 =
    echo(strutil.Join(["web platform closure smoke failed: ", label], ""))
    return 1

@exportc("cheng_geolocation_check_permissions")
fn cheng_geolocation_check_permissions_smoke(): int32 =
    return 0

@exportc("cheng_geolocation_request_permissions")
fn cheng_geolocation_request_permissions_smoke(): int32 =
    return 0

@exportc("cheng_geolocation_get_current_position")
fn cheng_geolocation_get_current_position_smoke(): cstring =
    return "{\"lat\":31.2304,\"lng\":121.4737}"

fn main(): int32 =
    # --- geolocation: permission + real native-bridged position readback
    if !geo.WebGeolocationCheckPermissions():
        return smokeFail("geolocation check permissions")
    if !geo.WebGeolocationRequestPermissions():
        return smokeFail("geolocation request permissions")
    var pos: str = ""
    if !geo.WebGeolocationGetCurrentPosition(pos):
        return smokeFail("geolocation position read")
    if !strutil.Contains(pos, "31.2304"):
        return smokeFail("geolocation position payload")

    # --- service worker: register -> install -> activate -> fetch -> state -> unregister
    let registrationId: int32 = sw.WebServiceWorkerRegister("/", "/sw.js", 1, 1, 1, 0)
    if registrationId != 1:
        return smokeFail("service worker registration id")
    if !sw.WebServiceWorkerTriggerInstall(registrationId):
        return smokeFail("service worker install")
    if !sw.WebServiceWorkerTriggerActivate(registrationId):
        return smokeFail("service worker activate")
    var response: str = ""
    if !sw.WebServiceWorkerTriggerFetch(registrationId, "/feed.json", "GET", response):
        return smokeFail("service worker fetch dispatch")
    if response != "/feed.json":
        return smokeFail("service worker fetch response")
    var registration: sw.WebServiceWorkerRegistration
    if !sw.WebServiceWorkerGetState(registrationId, registration):
        return smokeFail("service worker get state")
    if registration.state != sw.WebSWActivated:
        return smokeFail("service worker activated state")
    if registration.scope != "/":
        return smokeFail("service worker scope")
    if !sw.WebServiceWorkerUnregister("/"):
        return smokeFail("service worker unregister")
    var stale: sw.WebServiceWorkerRegistration
    if sw.WebServiceWorkerGetState(registrationId, stale):
        return smokeFail("service worker stale registration visible")

    echo("web platform closure runtime smoke ok")
    return 0
