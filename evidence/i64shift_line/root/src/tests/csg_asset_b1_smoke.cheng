# CSG 资产管线 B1 冒烟: WAV/MP4 真实解析, 真值与 ffprobe/python 独立提取
# 一致 (fixtures.md 冻结); VFR/B帧/非零起始显式判定; 损坏输入拒绝。
# 用法: csg_asset_b1_smoke <fixturesDir>
import std/cmdline
import std/strings
import std/os
import std/rawbytes
import cheng/game/assets/media
import cheng/game/assets/import/mp4
import cheng/game/assets/import/reader

@borrows
fn loadFixture(dir: str, rel: str, bounds: reader.AssetReaderBounds): rawbytes.Bytes =
    var empty = rawbytes.EmptyBytes()
    var data = rawbytes.EmptyBytes()
    let path = Fmt"{dir}/{rel}"
    if !reader.AssetReaderLoadBounded(path, bounds, data):
        return empty
    return data

@borrows
fn findTrackByHandler(info: mp4.AssetMp4Info, handler: int32): int32 =
    for i in 0..<info.tracks.len:
        if info.tracks[i].handler == handler:
            return i
    return -1

@borrows
fn checkWav(dir: str) =
    var bounds = reader.AssetReaderBoundsFor("wav")
    var data = loadFixture(dir, "media/sample_440hz_2s.wav", bounds)
    assert(rawbytes.BytesLen(data) == 192078, "wav fixture loaded")

    var info: media.AssetWavInfo
    var err: str
    assert(media.AssetMediaParseWav(data, info, err), "wav parses: {err}")
    assert(info.audioFormat == 1, "wav PCM")
    assert(info.channels == 1, "wav channels")
    assert(info.sampleRate == 48000, "wav rate")
    assert(info.byteRate == 96000, "wav byte rate")
    assert(info.blockAlign == 2, "wav block align")
    assert(info.bitsPerSample == 16, "wav bits")
    assert(info.dataOffset == int64(78), "wav data offset")
    assert(info.dataLen == int64(192000), "wav data len")
    assert(info.extraChunks == 1, "wav extra chunk counted (LIST)")
    assert(info.durationMs == int64(2000), "wav duration 2s")

    # 负例: 坏魔数。
    var bad = rawbytes.BytesSlice(data, 0, rawbytes.BytesLen(data))
    rawbytes.BytesSet(bad, 0, 88)
    var err2: str
    assert(!media.AssetMediaParseWav(bad, info, err2), "bad magic rejected")
    # 负例: 截断 (data 块不完整)。
    var cut = rawbytes.BytesSlice(data, 0, 100)
    var err3: str
    assert(!media.AssetMediaParseWav(cut, info, err3), "truncated rejected")
    # 负例: 非 PCM (patch audioFormat=6)。
    var npcm = rawbytes.BytesSlice(data, 0, rawbytes.BytesLen(data))
    rawbytes.BytesSet(npcm, 20, 6)
    var err4: str
    assert(!media.AssetMediaParseWav(npcm, info, err4), "non-PCM rejected")
    rawbytes.BytesFree(bad)
    rawbytes.BytesFree(cut)
    rawbytes.BytesFree(npcm)
    rawbytes.BytesFree(data)

@borrows
fn checkMp4Cfr(dir: str) =
    var bounds = reader.AssetReaderBoundsFor("mp4")
    var data = loadFixture(dir, "media/sample_cfr_1s.mp4", bounds)
    assert(rawbytes.BytesLen(data) == 47243, "cfr fixture loaded")
    var info: mp4.AssetMp4Info
    var err: str
    assert(mp4.AssetMediaParseMp4(data, info, err), Fmt"cfr parse err: {err}")
    assert(info.timescale == 1000, "cfr mvhd timescale")
    assert(info.duration == int64(1000), "cfr mvhd duration 1s")
    assert(info.trackCount == 2, "cfr two tracks")

    let v = findTrackByHandler(info, mp4.AssetMediaHandlerVide())
    assert(v >= 0, "cfr vide track")
    let vt = info.tracks[v]
    assert(vt.sampleEntry == mp4.AssetMediaFourccAvc1(), "cfr avc1")
    assert(vt.sampleCount == 24, "cfr 24 frames")
    assert(vt.sttsEntries == 1, "cfr single stts entry")
    assert(vt.sttsTotalDuration == int64(12288), "cfr stts total")
    assert(vt.timebase == 12288, "cfr vide timebase 24fps*512")
    assert(vt.syncCount == 1, "cfr sync samples=1")
    assert(mp4.AssetMp4TrackHasInterFrames(vt), "cfr has P/B frames")
    assert(!mp4.AssetMp4TrackVariableFps(vt), "cfr not variable fps")

    let a = findTrackByHandler(info, mp4.AssetMediaHandlerSoun())
    assert(a >= 0, "cfr soun track")
    let at = info.tracks[a]
    assert(at.sampleEntry == mp4.AssetMediaFourccMp4a(), "cfr mp4a")
    assert(at.sampleCount == 45, "cfr 45 AAC frames")
    assert(at.timebase == 44100, "cfr audio timebase")
    assert(at.mediaDuration == int64(45124), "cfr audio duration incl priming")
    assert(!mp4.AssetMp4TrackNonZeroStart(at), "cfr starts at zero")
    rawbytes.BytesFree(data)

@borrows
fn checkMp4Vfr(dir: str) =
    var bounds = reader.AssetReaderBoundsFor("mp4")
    var data = loadFixture(dir, "media/sample_vfr_bframes.mp4", bounds)
    var info: mp4.AssetMp4Info
    var err: str
    assert(mp4.AssetMediaParseMp4(data, info, err), "vfr parses: {err}")
    assert(info.trackCount == 1, "vfr one track")
    let vt = info.tracks[0]
    assert(vt.sampleCount == 48, "vfr 48 frames")
    assert(vt.sttsEntries == 7, "vfr multiple delta groups in stts")
    assert(mp4.AssetMp4TrackVariableFps(vt), "vfr detected: must not force CFR")
    assert(mp4.AssetMp4TrackHasInterFrames(vt), "vfr has B/P frames")
    assert(info.duration == int64(2125), "vfr mvhd duration")
    rawbytes.BytesFree(data)

@borrows
fn checkMp4Offset(dir: str) =
    var bounds = reader.AssetReaderBoundsFor("mp4")
    var data = loadFixture(dir, "media/sample_offset_start.mp4", bounds)
    var info: mp4.AssetMp4Info
    var err: str
    assert(mp4.AssetMediaParseMp4(data, info, err), "offset parses: {err}")
    assert(info.duration == int64(1500), "offset mvhd duration 1.5s")
    let v = findTrackByHandler(info, mp4.AssetMediaHandlerVide())
    let a = findTrackByHandler(info, mp4.AssetMediaHandlerSoun())
    assert(v >= 0 && a >= 0, "offset both tracks")
    assert(mp4.AssetMp4TrackNonZeroStart(info.tracks[v]),
        "vide nonzero start via empty edit")
    assert(mp4.AssetMp4TrackNonZeroStart(info.tracks[a]),
        "soun nonzero start via empty edit")
    assert(info.tracks[v].elstFirstMediaTime == int64(-1), "vide first edit empty")
    assert(info.tracks[a].elstFirstMediaTime == int64(-1), "soun first edit empty")
    rawbytes.BytesFree(data)

@borrows
fn checkMp4Negative(dir: str) =
    var bounds = reader.AssetReaderBoundsFor("mp4")
    var data = loadFixture(dir, "media/sample_cfr_1s.mp4", bounds)
    # 截断: 只留 ftyp => 缺 moov 拒绝。
    var cut = rawbytes.BytesSlice(data, 0, 32)
    var info: mp4.AssetMp4Info
    var err: str
    assert(!mp4.AssetMediaParseMp4(cut, info, err), "missing moov rejected")
    # 破坏: 顶层 box 长度越界。
    var broken = rawbytes.BytesSlice(data, 0, rawbytes.BytesLen(data))
    rawbytes.BytesSet(broken, 34, 255)
    var err2: str
    assert(!mp4.AssetMediaParseMp4(broken, info, err2), "box overflow rejected")
    rawbytes.BytesFree(cut)
    rawbytes.BytesFree(broken)
    rawbytes.BytesFree(data)

fn main(): int32 =
    let argc = cmdline.paramCount()
    if argc < 1:
        echo("usage: csg_asset_b1_smoke <fixturesDir>")
        return 2
    let fixturesDir = Fmt"{cmdline.paramStr(1)}"
    checkWav(fixturesDir)
    checkMp4Cfr(fixturesDir)
    checkMp4Vfr(fixturesDir)
    checkMp4Offset(fixturesDir)
    checkMp4Negative(fixturesDir)
    echo("csg_asset_b1_smoke PASS")
    return 0
