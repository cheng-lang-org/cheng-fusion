type
    ParserIfExpressionChoice = enum
        ParserValueTokenLeftBracket
        ParserValueTokenRightBracket
        ParserValueTokenRightBrace

fn ChooseParserDelimiter(left: bool): ParserIfExpressionChoice =
    let tokenKind = if left: ParserValueTokenLeftBracket else: ParserValueTokenRightBrace
    let closeKind = if tokenKind == ParserValueTokenLeftBracket: ParserValueTokenRightBracket else: ParserValueTokenRightBrace
    return closeKind

fn main(): int32 =
    let left = ChooseParserDelimiter(true)
    let right = ChooseParserDelimiter(false)
    assert(left == ParserValueTokenRightBracket &&
           right == ParserValueTokenRightBrace,
           "parser if expression enum choice drift")
    return 0
