import std/os
import cheng/core/tooling/path as chengpath

fn CurrentDomainCount(text: str, needle: str): int32 =
    if needle.len == 0 || text.len < needle.len:
        return 0
    var count: int32
    let candidateCount = text.len - needle.len + 1
    for i in 0..<candidateCount:
        var matched = true
        for j in 0..<needle.len:
            if text[i + j] != needle[j]:
                matched = false
                break
        if matched:
            count = count + 1
    return count

fn main(): int32 =
    let root = os.GetCurrentDir()
    let source = chengpath.ReadTextFile(
        root, "src/core/tooling/csg_normalize.cheng")
    assert(source.len > 0,
           " csg normalize current domain: production source missing")
    assert(CurrentDomainCount(
               source,
               "cheng.compiler.csg.node.localfp") == 1,
           " csg normalize current domain: local fingerprint domain drifted")
    assert(CurrentDomainCount(
               source,
               "cheng.compiler.csg.node.normalized") == 1,
           " csg normalize current domain: normalized node domain drifted")
    assert(CurrentDomainCount(source, ".v2") == 0,
           " csg normalize current domain: version fragment survived")
    echo(" csg_normalize_current_domain_smoke ok")
    return 0
