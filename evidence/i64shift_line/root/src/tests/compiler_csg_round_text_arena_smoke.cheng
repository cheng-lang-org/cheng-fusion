import std/os
import std/system
import std/result
import cheng/core/tooling/compiler_request as creq
import cheng/core/tooling/path as chengpath
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/backend/system_link_plan as slplan
import cheng/core/lang/parser
import std/strutils as strutil

# Focused production contract for the PhaseArena round text store:
# a real CompilerCsgBuild must show
#   - zero spill and exactly one batch reset once rounds appended parts;
#   - peak bytes equal used bytes equal the exact sum of survivor part
#     lengths (the arena byte ledger and the CSV payload agree);
#   - every CSV part is plain decimal text (content survived the arena
#     round trip unchanged);
#   - all three CSVs carry the same round cardinality.
fn assertDecimalText(text: str, label: str) =
    assert(text.len > 0, strutil.Join([label, " empty part"], ""))
    for i in 0..<text.len:
        let ch = text[i]
        assert(ch >= '0' && ch <= '9',
               strutil.Join([label, " non-decimal part: ", text], ""))

fn csvPartBytes(csv: str, label: str): int32 =
    let parts = parser.ParserSplitChar(csv, ',')
    var total: int32
    for i in 0..<parts.len:
        assertDecimalText(parts[i], label)
        total = total + parts[i].len
    return total

fn main(): int32 =
    let workspaceRoot: str = chengpath.PathCurrentDir()
    let packageRoot: str = workspaceRoot
    let smokeLabel: str = os.GetEnvDefault("CHENG_SMOKE_LABEL", "host")
    let outDir: str = chengpath.PathJoin(workspaceRoot, strutil.Join(["artifacts/compiler_csg/", smokeLabel], ""))
    assert(chengpath.MkdirP(workspaceRoot, outDir), " round text arena: mkdir")
    let sourcePath: str = chengpath.PathJoin(packageRoot, "src/tests/typed_expr_fact_fixture.cheng")
    let outputPath: str = chengpath.PathJoin(outDir, "round_text_arena_fixture")
    let req = creq.CompilerRequestNew(
        packageRoot,
        sourcePath,
        outputPath,
        "arm64-apple-darwin",
        creq.EmitShared,
        ""
    )
    var linkPlan: slplan.SystemLinkPlanStub
    var err = ""
    assert(slplan.BuildSystemLinkPlanStub(workspaceRoot, req, linkPlan, err),
           " round text arena: link plan")
    let sourceBundleRes = slplan.SystemLinkPlanSourceBundleCid(linkPlan)
    assert(IsOk(sourceBundleRes), " round text arena: source bundle")
    let csgRes = ccsg.BuildCompilerCsg(linkPlan, Value(sourceBundleRes))
    assert(IsOk(csgRes), " round text arena: compiler csg")
    let csg = ccsg.CompilerCsgClone(Value(csgRes))

    assert(csg.roundTextArenaSpillCount == 0,
           " round text arena: spill must be zero under exact capacity")
    assert(csg.roundTextArenaResetCount == 1,
           " round text arena: exactly one batch reset after the round phase")
    assert(csg.roundTextArenaRetainedStoreBytes > 0,
           " round text arena: retained store ledger missing")
    assert(csg.roundTextArenaPeakBytes == csg.roundTextArenaUsedBytes,
           " round text arena: peak must equal used at the phase boundary")

    let msParts = parser.ParserSplitChar(csg.typedIrRoundBuildMsCsv, ',')
    let newParts = parser.ParserSplitChar(csg.typedIrRoundNewReachableCountCsv, ',')
    let buildParts = parser.ParserSplitChar(csg.typedIrRoundBuildCountCsv, ',')
    assert(msParts.len == newParts.len && newParts.len == buildParts.len,
           " round text arena: csv round cardinality drift")
    assert(msParts.len > 0, " round text arena: no rounds recorded")
    var expectedBytes = csvPartBytes(csg.typedIrRoundBuildMsCsv, "ms")
    expectedBytes = expectedBytes + csvPartBytes(csg.typedIrRoundNewReachableCountCsv, "new")
    expectedBytes = expectedBytes + csvPartBytes(csg.typedIrRoundBuildCountCsv, "build")
    assert(csg.roundTextArenaUsedBytes == expectedBytes,
           Fmt" round text arena: byte ledger mismatch arena={csg.roundTextArenaUsedBytes} csv={expectedBytes}")

    echo(Fmt"round_text_arena_used_bytes={csg.roundTextArenaUsedBytes}")
    echo(Fmt"round_text_arena_peak_bytes={csg.roundTextArenaPeakBytes}")
    echo(Fmt"round_text_arena_reset_count={csg.roundTextArenaResetCount}")
    echo(Fmt"round_text_arena_spill_count={csg.roundTextArenaSpillCount}")
    echo(Fmt"round_text_arena_retained_store_bytes={csg.roundTextArenaRetainedStoreBytes}")
    echo(Fmt"round_text_arena_round_count={msParts.len}")
    echo("COMPILER_CSG_ROUND_TEXT_ARENA_OK")
    return 0
