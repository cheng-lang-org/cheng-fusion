import std/result
import std/crypto/bigint as bigint

fn mk(flag: bool): result.Result[bigint.BigInt] =
    if flag:
        return result.Err[bigint.BigInt]("x")
    return result.Ok[bigint.BigInt](bigint.bigFromInt(3))

fn use(x: bigint.BigInt): int32 =
    return x.count

@borrows
fn check(data: str, flag: bool): result.Result[int32] =
    let xRes: result.Result[bigint.BigInt] = mk(flag)
    if result.IsErr(xRes):
        return result.Err[int32](result.Error(xRes))
    var x: bigint.BigInt = result.Value(xRes)
    if bigint.bigCmp(x, bigint.bigFromInt(5)) >= 0:
        return result.Err[int32]("too big")
    return result.Ok[int32](use(x))

fn main(): int32 =
    let r = check("a", true)
    return 0
