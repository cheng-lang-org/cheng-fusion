module tk_borrow_result_refroot_probe

type Session = ref object
    count: int32

type Ir =
    session: Session

@borrows
@borrow_result
fn GetSession(ir: Ir): Session =
    return ir.session

fn main(): int32 =
    var x: Ir
    x.session = new(Session)
    x.session.count = 3
    let s = GetSession(x)
    return s.count

main()
