import cheng/tests/cold_global_refine_plan as plan
import cheng/tests/cold_global_refine_user as user

fn main(): int32 =
    let first = plan.ColdGlobalRefinePlanInit()
    if first != 0:
        return first
    let second = user.ColdGlobalRefineUserTouch()
    if second != 0:
        return second + 10
    echo("cold_global_refine_smoke ok")
    return 0
