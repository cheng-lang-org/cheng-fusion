fn ReadInt32(items: int32[], index: int32): int32 =
    let value = items[index]
    return value

fn ReadBool(items: bool[], index: int32): bool =
    let value = items[index]
    return value

fn main(): int32 =
    var integers: int32[]
    add(integers, 16843008)
    var flags: bool[]
    add(flags, false)
    add(flags, true)

    # ReadInt32 and ReadBool deliberately have the same scalar frame shape.
    # The first call poisons all four bytes of the reused scalar slot; the
    # packed bool read must zero-extend its one-byte element into that slot.
    if ReadInt32(integers, 0) != 16843008:
        return 1
    if ReadBool(flags, 0):
        return 2
    if !ReadBool(flags, 1):
        return 3
    return 0
