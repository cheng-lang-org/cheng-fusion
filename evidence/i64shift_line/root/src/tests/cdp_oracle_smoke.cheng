# cdp_oracle_smoke.cheng - CDP DOM oracle test
# Fetches DOM from Chrome page and returns structured summary.

import cheng/core/runtime/cdp_client as cdp
import cheng/core/runtime/cdp_oracle_dom as oracle
import std/strings

fn main(): int32 =
    var summary: oracle.OracleDomSummary
    var err: str
    if !oracle.oracleFetchDomSummary(summary, err):
        # Try individual steps for debugging
        var conn = cdp.cdpTcpConnect(9222)
        if !cdp.cdpIsAlive(conn):
            return 1
        var pagesJson = cdp.cdpDiscoverPages(conn)
        cdp.cdpDisconnect(conn)
        if strings.len(pagesJson) > 0:
            return 2
        return 3
    
    # Successfully fetched and parsed DOM
    if summary.nodeCount > 0:
        return 0
    return 4
