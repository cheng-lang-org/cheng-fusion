import std/system

fn checkMode3(mode: int32): bool =
    return mode == 1 || mode == 2 || mode == 3

fn checkMode5(mode: int32): bool =
    return mode == 1 || mode == 2 || mode == 3 || mode == 4 || mode == 5

fn checkMultipleOr(mode: int32): int32 =
    if mode == 1 || mode == 2 || mode == 3: return 1
    return 0

fn main(): int32 =
    // Single-level || chain
    assert(checkMode3(1) == true, " mode3: 1")
    assert(checkMode3(2) == true, " mode3: 2")
    assert(checkMode3(3) == true, " mode3: 3")
    assert(checkMode3(4) == false, " mode3: 4")
    assert(checkMode3(0) == false, " mode3: 0")

    // Longer || chain
    assert(checkMode5(1) == true, " mode5: 1")
    assert(checkMode5(3) == true, " mode5: 3")
    assert(checkMode5(5) == true, " mode5: 5")
    assert(checkMode5(6) == false, " mode5: 6")

    // || in if condition
    assert(checkMultipleOr(2) == 1, " ifOr: 2")
    assert(checkMultipleOr(5) == 0, " ifOr: 5")

    echo(" cold_smoke_long_bool_chain ok")
    return 0
