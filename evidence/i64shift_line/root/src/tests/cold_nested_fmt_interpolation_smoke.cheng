fn nestedFmt(name: str, ordinal: int32): str =
    return Fmt"outer={Fmt\"inner={name}-{ordinal}\"}"

fn main() =
    let actual = nestedFmt("asset", 7)
    if actual == "outer=inner=asset-7":
        echo("cold_nested_fmt_interpolation=pass")
    else:
        echo("cold_nested_fmt_interpolation=fail")
