import std/atomic

var
    tkR4RefGlobalCount: atomic.I32

fn TkR4RefGlobalReset() =
    tkR4RefGlobalCount = nil

fn main(): int32 =
    if tkR4RefGlobalCount != nil:
        return 10
    tkR4RefGlobalCount = atomic.NewI32(7)
    if tkR4RefGlobalCount == nil:
        return 11
    TkR4RefGlobalReset()
    if tkR4RefGlobalCount != nil:
        return 12
    tkR4RefGlobalCount = atomic.NewI32(8)
    if tkR4RefGlobalCount == nil:
        return 13
    TkR4RefGlobalReset()
    if tkR4RefGlobalCount != nil:
        return 14
    TkR4RefGlobalReset()
    if tkR4RefGlobalCount != nil:
        return 15
    tkR4RefGlobalCount = atomic.NewI32(21)
    if tkR4RefGlobalCount == nil:
        return 16
    if atomic.LoadI32(tkR4RefGlobalCount) != 21:
        return 17
    echo("tk_r4_refglobal_nil ok")
    return 0
