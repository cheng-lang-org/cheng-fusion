    plan.regallocFunctionBodyIrSha256s = [
        Fmt"body-{suffix}"]
    plan.regallocFunctionSymbolByteStarts = [0]
    plan.regallocFunctionSymbolByteLengths = [4]
    plan.regallocFunctionSymbolBytesSha256s = [
        Fmt"symbol-{suffix}"]
    plan.regallocFunctionPlanSha256s = [
        Fmt"plan-{suffix}"]
    plan.regallocFunctionActionSemanticRootSha256s = [
        Fmt"action-semantic-{suffix}"]
    plan.regallocFunctionActionLedgerRootSha256s = [
        Fmt"action-ledger-{suffix}"]
    plan.regallocFunctionMachineFragmentRootSha256s = [
        Fmt"fragment-{suffix}"]
    plan.regallocFunctionAbiIngressRootSha256s = [
        Fmt"abi-{suffix}"]
    plan.regallocFunctionDebugProvenanceBound = [true]
    plan.regallocFunctionDebugFunctionIds = [1]
    plan.regallocFunctionDebugProvenanceSha256s = [
        Fmt"debug-{suffix}"]
    plan.regallocFunctionDebugMachineFragmentRootSha256s = [
        Fmt"debug-fragment-{suffix}"]
    plan.regallocFunctionDebugFragmentStarts = [0]
    plan.regallocFunctionDebugFragmentCounts = [1]
    plan.regallocDebugFragmentFunctionIndexes = [0]
    plan.regallocDebugFragmentOpIds = [1]
    plan.regallocDebugFragmentSyntheticKinds = [0]
    plan.regallocDebugFragmentSiteKinds = [1]
    plan.regallocDebugFragmentSiteIndexes = [0]
    plan.regallocDebugFragmentMachineOwnerKinds = [1]
    plan.regallocDebugFragmentMachineOwnerOrdinals = [0]
    plan.regallocDebugFragmentActionConsumerOrdinals = [0]
    plan.regallocDebugFragmentTextByteStarts = [0]
    plan.regallocDebugFragmentByteLengths = [4]
    plan.regallocDebugFragmentBytesSha256s = [
