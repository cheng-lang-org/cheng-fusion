    plan.streamedBuildAbortReason = Fmt"abort-{suffix}"
    plan.wordFillSchedule = "declaration_order"
    plan.wordFillMergeOrder = "declaration_order"
    plan.typedIrChengMemHeaderRcFieldType = "int32"
    plan.error.functionName = Fmt"Error{suffix}"
    plan.error.functionSourcePath =
        Fmt"/workspace/{suffix}/main.cheng"
    plan.error.bodyKind = "fixture"
    plan.error.typedIrKind = "fixture"
    plan.error.callTarget = Fmt"Target{suffix}"
    plan.error.callTargetSourcePath =
        Fmt"/workspace/{suffix}/target.cheng"
    plan.error.statementTrace = Fmt"statement-{suffix}"
    plan.error.paramTrace = Fmt"param-{suffix}"
    plan.error.bodyIrDetail.lastCallTarget =
