    plan.targetTriple = "arm64-apple-darwin"
    plan.actualPipelineStage = Fmt"primary-{suffix}"
    plan.actualBackendKind = "primary"
    plan.objectFormat = "macho64"
    plan.outputPath = Fmt"/workspace/{suffix}/main.o"
    plan.entryPath = Fmt"/workspace/{suffix}/main.cheng"
    plan.entrySymbol = "main"
    plan.entryFunctionSymbol = Fmt"_ChengMain{suffix}"
    plan.itemIds = [1]
    plan.symbolNames = [plan.entryFunctionSymbol]
    plan.symbolTypedFunctionIndexes = [0]
    plan.symbolNameIds = [0]
    plan.symbolRoles = [pobj.PrimaryObjectSymbolRoleTypedName]
    plan.symbolInterfaceCids = [layout.FixedBytes32()]
    plan.functionWordOffsets = [0]
    plan.functionWordCounts = [1]
    plan.functionBodyKinds = ["statement_sequence"]
    plan.functionStatementReturnModes = [1]
    plan.functionStatementReturnI32Values = [0]
    plan.functionStatementCallCounts = [0]
    plan.functionIrIndexes = [0]
    var bodyIR = coreir.BodyIRNew()
    var bodyOp: coreir.BodyOp
    bodyOp.operands = [1, 2]
    add(bodyIR.ops, bodyOp)
    add(plan.functionBodyIRs, bodyIR)
    plan.instructionWords = [1]
    plan.dataLabels = [Fmt"_data_{suffix}"]
    plan.dataPayloadTexts = [Fmt"payload-{suffix}"]
    plan.dataPayloadRawBytes = [1]
    plan.dataPayloadRawByteCounts = [1]
    plan.relocSourceItemIds = [1]
    plan.relocWordOffsets = [0]
    plan.relocTargetSymbols = [Fmt"_target_{suffix}"]
    plan.relocTargetDomainKinds = [coreir.BodyCallTargetDomainInvalidTag]
    plan.relocTargetRows = [-1]
    plan.relocTargetInterfaceCids = [layout.FixedBytes32()]
    plan.dataRelocSourceItemIds = [1]
    plan.dataRelocWordOffsets = [0]
    plan.dataRelocTargetSymbols = [Fmt"_data_target_{suffix}"]
    plan.bodyIREGraphReason = Fmt"egraph-{suffix}"
    plan.regallocFrozenSnapshotSinglePayloads = [
        Fmt"frozen-{suffix}"]
    plan.regallocEmissionLedgerSinglePayloads = [
        Fmt"ledger-{suffix}"]
    plan.regallocFunctionSymbols = [plan.entryFunctionSymbol]
    plan.regallocFunctionIrIndexes = [0]
    plan.regallocFunctionKinds = [
