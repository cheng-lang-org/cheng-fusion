    plan.error.bodyIrDetail.lastCallTargetSourcePath =
        Fmt"/workspace/{suffix}/last.cheng"
    plan.error.bodyIrDetail.firstZeroTargetSlotName =
        Fmt"targetSlot{suffix}"
    plan.error.bodyIrDetail.firstZeroBaseSlotName =
        Fmt"baseSlot{suffix}"
    plan.error.bodyIrDetail.firstZeroValueSlotName =
        Fmt"valueSlot{suffix}"
    plan.error.bodyIrDetail.firstZeroSlotDiag =
        Fmt"slotDiag{suffix}"
    plan.error.bodyIrDetail.firstZeroCallTarget =
        Fmt"ZeroTarget{suffix}"
    plan.error.bodyIrDetail.firstZeroCallDiag =
