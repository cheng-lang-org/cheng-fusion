    var secondaryError = plan.error
    secondaryError.functionName = Fmt"Secondary{suffix}"
    add(plan.errors, secondaryError)
    plan.missingReasons = [Fmt"missing-{suffix}"]
    plan.pipelineStage = "primary_release_fixture"
    plan.exportRootSymbols = [plan.entryFunctionSymbol]
    plan.symbolVisibility = "hidden"
    plan.debugSectionPlanReceipt.backendKind = "primary"
    plan.debugSectionPlanReceipt.packageId =
        Fmt"cheng/release/{suffix}"
    plan.debugSectionPlanReceipt.sourceIds = [0]
    plan.debugSectionPlanReceipt.sourceModulePaths = [
        Fmt"release/{suffix}/main"]
    plan.debugSectionPlanReceipt.sourceDocumentCids = [
        plan.debugSectionPlanReceipt.receiptCid]
    plan.debugSectionPlanReceipt.functionNames = [
        Fmt"Main{suffix}"]
    var functionRow: debugplan.DebugSectionPlanFunctionRow
    functionRow.functionSymbolName = plan.entryFunctionSymbol
    functionRow.plannedSymbolBytesSha256 =
        Fmt"planned-{suffix}"
    functionRow.bodyIrSha256 = Fmt"body-{suffix}"
    functionRow.frozenPlanSha256 = Fmt"frozen-{suffix}"
    functionRow.regallocPlanSha256 = Fmt"regalloc-{suffix}"
    functionRow.emissionLedgerSha256 = Fmt"emission-{suffix}"
    functionRow.actionSemanticRootSha256 =
        Fmt"semantic-{suffix}"
    functionRow.actionBindingRootSha256 =
        Fmt"binding-{suffix}"
    functionRow.machineFragmentRootSha256 =
        Fmt"machine-{suffix}"
    functionRow.abiIngressRootSha256 = Fmt"abi-{suffix}"
    functionRow.debugProvenanceSha256 =
        Fmt"provenance-{suffix}"
    functionRow.debugMachineFragmentRootSha256 =
        Fmt"debug-machine-{suffix}"
    add(plan.debugSectionPlanReceipt.functions, functionRow)
    var debugRow: debugplan.DebugSectionPlanRow
    debugRow.plannedBytesSha256 = Fmt"row-{suffix}"
    add(plan.debugSectionPlanReceipt.rows, debugRow)
    return plan

fn PrimaryObjectPlanReleaseMutationsRejected(): bool =
    var left = PrimaryObjectPlanReleaseFixture("left")
    var right = PrimaryObjectPlanReleaseFixture("right")
    var leftReceipt: pobj.PrimaryObjectPlanReleaseReceipt
    var rightReceipt: pobj.PrimaryObjectPlanReleaseReceipt
    pobj.PrimaryObjectPlanReleaseWithReceipt(left, leftReceipt)
    pobj.PrimaryObjectPlanReleaseWithReceipt(right, rightReceipt)
    var err: str
    if pobj.PrimaryObjectPlanReleaseReceiptConsumeStrictInto(
           left, rightReceipt, err):
        return false
    var missingColumnReceipt = leftReceipt
    missingColumnReceipt.releasedOwnedStorageColumnCount =
        missingColumnReceipt.releasedOwnedStorageColumnCount - 1
    if pobj.PrimaryObjectPlanReleaseReceiptConsumeStrictInto(
           left, missingColumnReceipt, err):
        return false
    var wrongBytesReceipt = leftReceipt
    wrongBytesReceipt.releasedBytes =
        wrongBytesReceipt.releasedBytes + int64(1)
    if pobj.PrimaryObjectPlanReleaseReceiptConsumeStrictInto(
           left, wrongBytesReceipt, err):
        return false
    var wrongTokenReceipt = leftReceipt
    wrongTokenReceipt.ownerToken.data[0] =
        uint8(Int32(wrongTokenReceipt.ownerToken.data[0]) ^ 1)
    if pobj.PrimaryObjectPlanReleaseReceiptConsumeStrictInto(
           left, wrongTokenReceipt, err):
        return false
    if !pobj.PrimaryObjectPlanReleaseReceiptConsumeStrictInto(
           left, leftReceipt, err):
        return false
    if pobj.PrimaryObjectPlanReleaseReceiptConsumeStrictInto(
           left, leftReceipt, err):
        return false
    return pobj.PrimaryObjectPlanReleaseReceiptConsumeStrictInto(
        right, rightReceipt, err)

fn main() =
    assert(pobj.PrimaryObjectPlanOwnedStorageColumnCount == 98,
           "primary release smoke: owned column schema drift")
    var allocatedBufferCount: int64
    var releasedBufferCount: int64
    var allocatedBytes: int64
    var releasedBytes: int64
    for iteration in 0..<1000:
        let suffix = strings.IntToStr(iteration)
        var plan = PrimaryObjectPlanReleaseFixture(suffix)
        let buffers =
            pobj.PrimaryObjectPlanRetainedBufferCount(plan)
        let bytes = pobj.PrimaryObjectPlanRetainedBytes(plan)
        assert(buffers > 0 && bytes > int64(0),
               "primary release smoke: fixture storage missing")
        allocatedBufferCount =
            allocatedBufferCount + int64(buffers)
        allocatedBytes = allocatedBytes + bytes
        var receipt: pobj.PrimaryObjectPlanReleaseReceipt
        pobj.PrimaryObjectPlanReleaseWithReceipt(plan, receipt)
        assert(receipt.storageReleased &&
               receipt.releasedOwnedStorageColumnCount ==
                   pobj.PrimaryObjectPlanOwnedStorageColumnCount &&
               receipt.releasedBufferCount == buffers &&
               receipt.releasedBytes == bytes &&
               pobj.PrimaryObjectPlanStorageReleased(plan) &&
               pobj.PrimaryObjectPlanRetainedBufferCount(plan) == 0 &&
               pobj.PrimaryObjectPlanRetainedBytes(plan) == int64(0),
               "primary release smoke: receipt mismatch")
        var err: str
        assert(
            pobj.PrimaryObjectPlanReleaseReceiptConsumeStrictInto(
                plan, receipt, err),
            err)
        releasedBufferCount =
            releasedBufferCount +
            int64(receipt.releasedBufferCount)
        releasedBytes = releasedBytes + receipt.releasedBytes
    assert(allocatedBufferCount == releasedBufferCount &&
           allocatedBytes == releasedBytes,
           "primary release smoke: alloc/release mismatch")
    assert(PrimaryObjectPlanReleaseMutationsRejected(),
           "primary release smoke: mutation accepted")
    echo("primary_object_plan_release_iterations=1000")
    echo("primary_object_plan_release_alloc_eq_release=1")
    echo("primary_object_plan_release_live=0")
    echo("primary_object_plan_release_mutations_rejected=1")
