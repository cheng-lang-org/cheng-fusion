import std/strings
import std/rawbytes
import std/os
import std/result
import cheng/game/assets/semantic_video/schema
import cheng/game/assets/semantic_video/writer
import cheng/game/assets/semantic_video/validator

# B1 提交路径 smoke：SvWriterEncode → SvWriterCommit 原子提交 → 落盘字节回读
# 与编码字节逐一相等 → validator 通过 → 损坏副本（最后一个非零字节翻转，
# csgc 分节 SHA-256 摘要必失配）必须被拒绝 → 清理临时产物。

@borrows
fn buildSet(): writer.SvLineSet =
    var set = writer.SvLineSetInit()
    var manifest: schema.SvManifestRec
    add(manifest.caps, strings.CloneStr(schema.SvCapCommonCore))
    let resCid = writer.SvContentCid("video-resource")
    add(manifest.resCid, strings.CloneStr(resCid))
    add(manifest.resLength, int64(1024))
    add(manifest.resType, strings.CloneStr("video_sample"))
    # cap 仅 common_core：不声明 world_execution，entrySnapshot 必须留空
    # （validator: hasWorld != (entrySnapshot.len>0) 即拒）。
    manifest.tbNum = 1
    manifest.tbDen = 90000
    manifest.timeStart = int64(0)
    manifest.timeEnd = int64(900000)
    let preLine = schema.SvManifestLine(manifest)
    manifest.contentId = strings.CloneStr(writer.SvContentCid(preLine))
    writer.SvAddManifest(set, manifest)

    var entity: schema.SvEntityRec
    entity.ns = strings.CloneStr("demo")
    entity.gen = int64(0)
    entity.num = 1
    entity.typeVer = strings.CloneStr("person@v1")
    entity.lifecycle = strings.CloneStr(schema.SvLifecycleActive)
    writer.SvAddEntity(set, entity)

    var observation: schema.SvObservationRec
    observation.obsId = strings.CloneStr("obs-0")
    observation.sensor = strings.CloneStr("cam-front")
    observation.srcTrack = strings.CloneStr("v:0")
    observation.sourceClass = strings.CloneStr(schema.SvSourceObserved)
    observation.method = strings.CloneStr("demux@v1")
    observation.tbNum = 1
    observation.tbDen = 90000
    observation.tickStart = int64(0)
    observation.tickEnd = int64(900000)
    writer.SvAddObservation(set, observation)
    return set

fn lastNonZeroByteIndex(bytes: rawbytes.Bytes): int32 =
    var i: int32 = rawbytes.BytesLen(bytes) - 1
    while i >= 0:
        if rawbytes.BytesGet(bytes, i) != 0:
            return i
        i = i - 1
    return -1

fn main(): int32 =
    var set = buildSet()
    let encoded = writer.SvWriterEncode(set)
    assert(encoded.ok, schema.SvCat(" encode: ", encoded.error))

    var target: str = ".scratch/t1/commit_sample.svblock"
    var corruptPath: str = ".scratch/t1/commit_sample.svblock.corrupt"
    let commitError = writer.SvWriterCommit(encoded.bytes, target)
    assert(commitError.len == 0, schema.SvCat(" commit: ", commitError))

    var readBack: Result[Bytes] = os.ReadFileBytesResult(target)
    assert(IsOk(readBack), " read back committed file")
    var fileBytes = Value(readBack)
    assert(rawbytes.BytesLen(fileBytes) == rawbytes.BytesLen(encoded.bytes),
        " byte length equal")
    assert(rawbytes.BytesEqual(fileBytes, encoded.bytes),
        " committed bytes equal encoded bytes")

    let fileValidation = validator.SvValidate(fileBytes)
    assert(fileValidation.ok,
        schema.SvCat(" validate readback: ", fileValidation.error))

    # 负例：BytesSlice 是真实拷贝，翻转最后一个非零字节后重写盘再读回验证拒绝。
    let flipIdx = lastNonZeroByteIndex(fileBytes)
    assert(flipIdx >= 0, " last non-zero byte exists")
    var corrupt = rawbytes.BytesSlice(fileBytes, 0, rawbytes.BytesLen(fileBytes))
    rawbytes.BytesSet(corrupt, flipIdx, 0)
    assert(!rawbytes.BytesEqual(corrupt, fileBytes), " corrupted differs")
    var writeErr: str
    let writeOk = os.WriteFileBytesStatus(corruptPath, corrupt, writeErr)
    assert(writeOk, schema.SvCat(" write corrupt: ", writeErr))
    var corruptRead: Result[Bytes] = os.ReadFileBytesResult(corruptPath)
    assert(IsOk(corruptRead), " read corrupt file")
    var corruptFromDisk = Value(corruptRead)
    let corruptValidation = validator.SvValidate(corruptFromDisk)
    assert(!corruptValidation.ok, " corrupt must be rejected")

    let _ = os.RemoveFile(target)
    let _ = os.RemoveFile(corruptPath)
    echo(" sv_b1_commit_smoke ok")
    return 0
