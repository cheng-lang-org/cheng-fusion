fn R24Trim(raw: str): str =
    return raw

fn R24Tag(raw: str): str =
    if raw.len > 3:
        return "long"
    return "short"

fn R24DeclName(lineRaw: str, genericPos: int32): int32 =
    let line = R24Trim(lineRaw)
    if line == "":
        return 1
    if line.len < 2:
        return 2
    let headRaw = R24Trim(line)
    var head: str
    if genericPos > 0:
        head = R24Tag(headRaw)
    else:
        head = headRaw
    let name = R24Trim(head)
    if name == "long":
        return 100 + name.len
    if name == "abcdef":
        return 200 + name.len
    if name == "short":
        return 300 + name.len
    return 900

fn R24HeadLen(lineRaw: str, genericPos: int32): int32 =
    let headRaw = R24Trim(lineRaw)
    var head: str
    if genericPos > 0:
        head = R24Tag(headRaw)
    else:
        head = headRaw
    return head.len

fn main(): int32 =
    if R24DeclName("", 1) != 1:
        return 10
    if R24DeclName("a", 1) != 2:
        return 11
    let live = R24DeclName("abcdef", 1)
    if live != 104:
        return 12
    let moved = R24DeclName("abcdef", 0)
    if moved != 206:
        return 13
    let liveShort = R24DeclName("ab", 1)
    if liveShort != 305:
        return 14
    let headLive = R24HeadLen("abcdef", 1)
    if headLive != 4:
        return 15
    let headMoved = R24HeadLen("abcdef", 0)
    if headMoved != 6:
        return 16
    let width = live + moved + liveShort + headLive + headMoved
    if width != 625:
        return 17
    echo("tk_r24_condmove ok live=104 moved=206 short=305 width=625")
    return 0
