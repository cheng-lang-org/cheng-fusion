import std/system as system

type
    TkR3Managed =
        tag: str
        n: int32

fn TkR3ManagedFill(seed: int32, out: var TkR3Managed): str =
    var next: TkR3Managed
    next.tag = strings.ConcatStr("he", "llo")
    next.n = seed
    out = next
    return next.tag

fn main(): int32 =
    var got: TkR3Managed
    let leaked = TkR3ManagedFill(3, got)
    os.WriteLine(os.Get_stdout(), leaked)
    return 0
