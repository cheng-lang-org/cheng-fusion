@profile("driver_safe")

type
    P =
        raw: uint64

type
    R =
        phys: P
        offset: uint64

type
    IoUInt8Ptr = uint8 *

@trusted_abi
fn MkR(): R =
    var out: R
    out.phys.raw = uint64(268435456)
    out.offset = uint64(5)
    return out

fn main(): int32 =
    let r = MkR()
    let addr = ptr(r.phys.raw + r.offset)
    *(IoUInt8Ptr(addr)) = uint8(74)
    return 0
