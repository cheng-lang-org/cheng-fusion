import std/os as os
import std/rawbytes
import std/strings
import cheng/core/csg_core/csgc
import cheng/core/csg_core/merkle_transaction_request as request

const
    RequestCidA: str = "sha256:1111111111111111111111111111111111111111111111111111111111111111"
    RequestCidB: str = "sha256:2222222222222222222222222222222222222222222222222222222222222222"
    RequestCidC: str = "sha256:3333333333333333333333333333333333333333333333333333333333333333"
    RequestCidD: str = "sha256:4444444444444444444444444444444444444444444444444444444444444444"
    RequestCidE: str = "sha256:5555555555555555555555555555555555555555555555555555555555555555"

@borrows
fn requestFact(key: str, cid: str): request.CsgCoreMerkleTransactionRequestFact =
    var out: request.CsgCoreMerkleTransactionRequestFact
    out.factKey = strings.CloneStr(key)
    out.factCid = strings.CloneStr(cid)
    return out

@borrows
fn requestDependency(sourceId: str, factKind: str, selector: str): request.CsgCoreMerkleTransactionRequestDependency =
    var out: request.CsgCoreMerkleTransactionRequestDependency
    out.providerSource = strings.CloneStr(sourceId)
    out.providerFactKind = strings.CloneStr(factKind)
    out.selector = strings.CloneStr(selector)
    return out

@borrows
fn requestReplacementA(reverse: bool): request.CsgCoreMerkleTransactionRequestReplacement =
    var out: request.CsgCoreMerkleTransactionRequestReplacement
    out.sourceId = "source-a"
    out.sourceCid = RequestCidA
    add(out.facts, requestFact("id:a", RequestCidB))
    add(out.facts, requestFact("id:z", RequestCidC))
    add(out.dependencies, requestDependency("source-b", "symbol", "selector-a"))
    add(out.dependencies, requestDependency("source-z", "type", "selector-z"))
    return out

fn requestReplacementB(): request.CsgCoreMerkleTransactionRequestReplacement =
    var out: request.CsgCoreMerkleTransactionRequestReplacement
    out.sourceId = "source-b"
    out.sourceCid = RequestCidD
    add(out.facts, requestFact("id:b", RequestCidE))
    return out

fn main(): int32 =
    var req: request.CsgCoreMerkleTransactionRequest
    req.expectedBeforeHeadCid = RequestCidE
    add(req.changedSources, "source-a")
    add(req.changedSources, "source-b")
    add(req.replacements, requestReplacementA(false))
    add(req.replacements, requestReplacementB())
    let first = request.CsgCoreMerkleTransactionRequestCid(req)
    if !first.ok:
        os.WriteLine(os.Get_stdout(), strings.ConcatStr("cid_err=", first.error))
        return 1
    let decoded = csgc.CsgCoreCsgcDecodeLines(first.bytes)
    if !decoded.ok:
        os.WriteLine(os.Get_stdout(), strings.ConcatStr("lines_err=", decoded.error))
        return 1
    os.WriteLine(os.Get_stdout(), strings.ConcatStr("lines=", strings.IntToStr(decoded.lines.len)))
    os.WriteLine(os.Get_stdout(), strings.ConcatStr("line0=[", strings.ConcatStr(decoded.lines[0], "]")))
    let typed = request.CsgCoreMerkleTransactionRequestDecode(first.bytes)
    if !typed.ok:
        os.WriteLine(os.Get_stdout(), strings.ConcatStr("typed_err=", typed.error))
        return 1
    os.WriteLine(os.Get_stdout(), "typed ok")
    return 0
