import cheng/tests/cold_global_refine_dep as dep

type
    ColdGlobalRefinePlan =
        item: dep.ColdGlobalRefineDep
        name: str

var
    coldGlobalRefinePlanGlobal: ColdGlobalRefinePlan

fn ColdGlobalRefinePlanInit(): int32 =
    var plan: ColdGlobalRefinePlan
    plan.item = dep.ColdGlobalRefineDepMake()
    plan.name = "plan"
    coldGlobalRefinePlanGlobal = plan
    if coldGlobalRefinePlanGlobal.item.second != "b":
        return 1
    if coldGlobalRefinePlanGlobal.name != "plan":
        return 2
    return 0
