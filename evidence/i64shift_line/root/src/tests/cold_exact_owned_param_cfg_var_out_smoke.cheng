type
    ColdExactOwnedParamCell = ref object
        value: int32

fn ColdExactOwnedParamIncrement(
        cell: var ColdExactOwnedParamCell) =
    cell.value = cell.value + 1

fn ColdExactOwnedParamInitialize(
        cell: var ColdExactOwnedParamCell) =
    cell = new(ColdExactOwnedParamCell)
    cell.value = 51

fn ColdExactOwnedDefaultInitializedUse(): int32 =
    var cell: ColdExactOwnedParamCell
    ColdExactOwnedParamInitialize(cell)
    if cell == nil:
        return -1
    return cell.value

fn ColdExactOwnedParamCfgUse(
        cell: ColdExactOwnedParamCell): int32 =
    ColdExactOwnedParamIncrement(cell)
    ColdExactOwnedParamIncrement(cell)
    if cell == nil:
        return -1
    if cell.value < 0:
        return cell.value
    return cell.value

fn main(): int32 =
    let cell = new(ColdExactOwnedParamCell)
    cell.value = 41
    if ColdExactOwnedParamCfgUse(share(cell)) != 43:
        return 11
    if ColdExactOwnedDefaultInitializedUse() != 51:
        return 12
    return 0
