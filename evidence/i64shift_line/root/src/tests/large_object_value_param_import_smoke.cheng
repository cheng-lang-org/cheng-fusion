import cheng/tests/large_object_value_param_import_helper as helper

fn main(): int32 =
    var p: helper.LargeImportGeP3
    p.y.v0 = int64(88)
    p.y.v1 = int64(102)
    if helper.LargeImportReadY0(p) != 88:
        return 1
    let q = helper.LargeImportCopy(p)
    if int32(q.y.v0) != 88:
        return 2
    if int32(q.y.v1) != 102:
        return 3
    var f: helper.LargeImportFe
    var g: helper.LargeImportFe
    f.v0 = int64(40)
    g.v0 = int64(2)
    if helper.LargeImportReadPair(f, g) != 42:
        return 4
    helper.LargeImportFillFe(p.y, int64(7))
    if int32(p.y.v0) != 7:
        return 5
    if int32(p.y.v1) != 8:
        return 6
    if helper.LargeImportReadValueParamThroughVar(p.y) != 7:
        return 7
    var xs: int32[]
    xs = [18, 2]
    if xs.len != 2:
        return 8
    if xs[0] != 18:
        return 9
    if xs[1] != 2:
        return 10
    return 0
