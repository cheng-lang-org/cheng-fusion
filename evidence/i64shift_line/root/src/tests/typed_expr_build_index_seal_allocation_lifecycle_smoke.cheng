import cheng/core/lang/typed_expr as texpr

fn AddDeclarations(index: var texpr.TypedExprBuildIndex) =
    texpr.TypedExprBuildIndexAddCallDeclaration(
        index, "/seal-allocation/entry.cheng", "leaf", [], ["int32"],
        "int32", texpr.TypedExprCallDeclarationFunction, "leaf")
    texpr.TypedExprBuildIndexAddCallDeclaration(
        index, "/seal-allocation/entry.cheng", "middle", [], ["int32"],
        "int32", texpr.TypedExprCallDeclarationFunction, "middle")
    texpr.TypedExprBuildIndexAddCallDeclaration(
        index, "/seal-allocation/entry.cheng", "main", [], [],
        "int32", texpr.TypedExprCallDeclarationFunction, "main")

fn main(): int32 =
    var first = texpr.TypedExprBuildIndexNew(8)
    assert(first != nil,
           "typed expr seal allocation lifecycle: first allocation failed")
    AddDeclarations(first)
    texpr.TypedExprBuildIndexSealCallDeclarations(first)

    let sealedPeer = texpr.TypedExprBuildIndexNew(8)
    assert(sealedPeer != nil,
           "typed expr seal allocation lifecycle: allocation after seal failed")
    texpr.TypedExprBuildIndexRelease(sealedPeer)
    texpr.TypedExprBuildIndexRelease(first)

    let releasedPeer = texpr.TypedExprBuildIndexNew(8)
    assert(releasedPeer != nil,
           "typed expr seal allocation lifecycle: allocation after release failed")
    texpr.TypedExprBuildIndexRelease(releasedPeer)
    echo("typed_expr_build_index_seal_allocation_lifecycle_smoke ok")
    return 0
