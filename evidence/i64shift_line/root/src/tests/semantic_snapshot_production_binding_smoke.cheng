@borrows
fn TestCid(label: str): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(label.len)
    for index in 0..<label.len:
        layout.ByteBufAppendByte(buf, Int32(label[index]) & 255)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn TestSha256(label: str): str =
    return layout.FixedBytes32Hex(TestCid(label))

@borrows
fn MakeDebugSectionPlanEvidence(
        bundle: debugfacts.DebugFactBundle):
        debugevidence.DebugEmissionPlanEvidence =
    var out: debugevidence.DebugEmissionPlanEvidence
    out.backendKind = "primary"
    out.symbolNames = ["_Main"]
    out.functionWordOffsets = [0]
    out.functionWordCounts = [1]
    out.frozenSnapshotPayloads = ["frozen"]
    out.emissionLedgerPayloads = ["ledger"]
    out.bodyIrSha256s = [TestSha256("debug-plan/body")]
    out.symbolByteStarts = [0]
    out.symbolByteLengths = [4]
    out.symbolBytesSha256s = [TestSha256("debug-plan/symbol-bytes")]
    out.planSha256s = [TestSha256("debug-plan/plan")]
    out.actionSemanticRootSha256s = [
        TestSha256("debug-plan/action-semantic")]
    out.actionBindingRootSha256s = [
        TestSha256("debug-plan/action-binding")]
    out.machineFragmentRootSha256s = [
        TestSha256("debug-plan/machine-root")]
    out.abiIngressRootSha256s = [
        TestSha256("debug-plan/abi-ingress")]
    add(out.debugProvenanceBound, true)
    out.debugFunctionIds = [0]
    out.debugProvenanceSha256s = [
        TestSha256("debug-plan/provenance")]
    out.debugMachineFragmentRootSha256s = [""]
    out.debugFragmentStarts = [0]
    out.debugFragmentCounts = [1]
    out.fragmentFunctionIndexes = [0]
    out.fragmentDebugOpIds = [0]
    out.fragmentSyntheticKinds = [0]
    out.fragmentSiteKinds = [0]
    out.fragmentSiteIndexes = [0]
    out.fragmentMachineOwnerKinds = [0]
    out.fragmentMachineOwnerOrdinals = [0]
    out.fragmentActionConsumerOrdinals = [0]
    out.fragmentTextByteStarts = [0]
    out.fragmentByteLengths = [4]
    out.fragmentBytesSha256s = [
        TestSha256("debug-plan/fragment-bytes")]
    assert(bundle.functionCount == 1 && bundle.debugOpCount == 1,
           " semantic snapshot production smoke: debug plan fixture shape")
    out.debugMachineFragmentRootSha256s[0] =
        debugevidence.DebugEmissionPlanEvidenceDebugMachineFragmentRootSha256(
            out, 0)
    return out

fn TestCidLess(left: layout.FixedBytes32,
               right: layout.FixedBytes32): bool =
    for index in 0..<layout.FixedBytes32Size:
        if left.data[index] != right.data[index]:
            return left.data[index] < right.data[index]
    return false

fn EntryText(): str =
    return "fn Main(): int32 =\n    return 7\n"

fn MakeExactDebugLowering(
        sourceBundleCid: layout.FixedBytes32): lower.LoweringPlanStub =
    var out: lower.LoweringPlanStub
    out.sourceBundleCid = sourceBundleCid
    out.typedIr.internPool = langintern.InternPoolNew()
    var node: texpr.TypedExprIrNode
    node.resultStructuralTypeId = -1
    node.nodeIndex = 0
    node.originParserNodeId = 2
    node.syntheticOriginKind = texpr.TypedExprSyntheticOriginNone
    node.sourcePath =
        "/tmp/semantic_snapshot_production_binding_smoke/src/main.cheng"
    node.functionName = "Main"
    node.lineNumber = 2
    node.opKind = texpr.TypedExprIrOpParamRef
    node.resultType = "int32"
    node.surfaceText = "7"
    node.literalText = "7"
    node.operand0NodeIndex = -1
    node.operand1NodeIndex = -1
    node.operand2NodeIndex = -1
    node.callDeclarationIndex = -1
    node.fieldOffsetBytes = -1
    node.fieldSizeBytes = -1
    node.fieldAlignBytes = -1
    node.elemSizeBytes = -1
    texpr.TypedExprIrAppendNode(out.typedIr, node)
    texpr.TypedExprIrAppendScope(
        out.typedIr, 0, -1, parser.NormalizedScopeRoot,
        -1, 0, 1, 1, 1, 10)
    var function: texpr.TypedExprIrFunction
    function.sourcePath =
        "/tmp/semantic_snapshot_production_binding_smoke/src/main.cheng"
    function.functionName = "Main"
    function.returnType = "int32"
    function.returnExpr = "return 7"
    function.signatureLineNumber = 1
    function.endLineNumber = 2
    function.bodyLineNumber = 2
    function.statementStart = 0
    function.statementCount = 0
    function.scopeStart = 0
    function.scopeCount = 1
    function.nodeStart = 0
    function.nodeCount = 1
    function.returnNodeIndex = 0
    function.resultExprClass = texpr.TypedExprExprBorrowed
    texpr.TypedExprIrAppendFunction(out.typedIr, function)
    return out

@borrows
fn AssertStoreCountsUnchanged(
        store: production.SemanticSnapshotProductionStore,
        coreCount: int32,
        payloadCount: int32,
        publishedIndex: int32,
        currentSourceVersion: int64) =
    assert(store.core.states.len == coreCount &&
           store.core.sourceVersions.len == coreCount &&
           store.core.bindingReceiptCids.len == coreCount &&
           store.core.semanticSnapshotCids.len == coreCount &&
           store.core.csgRootCids.len == coreCount &&
           store.core.validationReceiptCids.len == coreCount &&
           store.core.failureReceiptCids.len == coreCount &&
           store.core.borrowCounts.len == coreCount &&
           store.core.candidateIndex == -1 &&
           store.core.publishedIndex == publishedIndex &&
           store.core.currentSourceVersion == currentSourceVersion &&
           store.payloadIndexesBySnapshot.len == coreCount &&
           store.payloadStates.len == payloadCount &&
           store.payloadSnapshotIndexes.len == payloadCount &&
           store.payloadSourceVersions.len == payloadCount &&
           store.payloadBindingReceiptCids.len == payloadCount &&
           store.payloadSemanticSnapshotCids.len == payloadCount &&
           store.payloadFactsRootCids.len == payloadCount &&
           store.payloadCargoCids.len == payloadCount &&
           store.payloadCompilerFactProjectionCids.len == payloadCount &&
           store.payloadCompilerFactCounts.len == payloadCount &&
           store.payloadSemanticFactProjectionCids.len == payloadCount &&
           store.payloadSemanticFactCounts.len == payloadCount &&
           store.payloadDebugFactProjectionCids.len == payloadCount &&
           store.payloadDebugFactCounts.len == payloadCount &&
           store.payloadPackageIds.len == payloadCount &&
           store.payloadIdentities.len == payloadCount &&
           store.payloadBindings.len == payloadCount &&
           store.payloadValidations.len == payloadCount &&
           store.payloadTables.len == payloadCount &&
           store.payloadQueryProjections.len == payloadCount &&
           store.payloadQueryProjectionCids.len == payloadCount &&
           store.payloadQueryIndexCids.len == payloadCount &&
           store.payloadQueryIndexRootCids.len == payloadCount &&
           store.payloadDeclarationTableCids.len == payloadCount &&
           store.payloadCsgcBytes.len == payloadCount,
           " semantic snapshot production smoke: failed commit mutated store")

fn MakeCompilerCsg(root: str, err: var str): ccsg.CompilerCsg =
    let sourceDir = Fmt"{root}/src"
    let entryPath = Fmt"{sourceDir}/main.cheng"
    let entryText = EntryText()
    os.MkdirAll(sourceDir, 493)
    os.WriteFile(Fmt"{root}/cheng-package.toml",
                 "package_id = \"pkg://cheng/compiler\"\n")
    os.WriteFile(entryPath, entryText)
    let base = creq.CompilerRequestNew(share(root),
                                       entryPath,
                                       Fmt"{root}/out.o",
                                       "arm64-apple-darwin",
                                       creq.EmitObj,
                                       "")
    let request = creq.CompilerRequestWithExportRootSymbols(base, ["Main"])
    var plan: slplan.SystemLinkPlanStub
    assert(slplan.BuildSystemLinkPlanStub(root, request, plan, err), err)
    assert(slplan.SystemLinkPlanSourceBundleBindingValidInto(plan, err), err)
    var importGraphCid: layout.FixedBytes32
    assert(cworld.CompilerWorldPortableImportGraphCidInto(
               plan.packageId,
               plan.importEdges,
               plan.unresolvedImportCount,
               importGraphCid,
               err), err)
    var sourceReceipt: ccsg.PortableSourceIdentityReceipt
    assert(ccsg.PortableSourceIdentityReceiptMakeInto(
               plan.sourceClosurePaths.len,
               plan.importEdges.len,
               plan.unresolvedImportCount,
               plan.packageId,
               plan.ownerModulePaths[plan.sourceBundleEntrySourceIndex],
               plan.sourceBundleCidValue,
               cworld.CompilerWorldSourceRawBytesCid(entryText),
               importGraphCid,
               sourceReceipt,
               err), err)
    var csg: ccsg.CompilerCsg
    assert(ccsg.BuildCompilerCsgConsumePortableReceiptInto(
               csg, err, plan, sourceReceipt), err)
    assert(ccsg.CompilerCsgOwnPortableArtifactStrictValidateInto(
               csg, err), err)
    return csg

fn MakeUniverse(compilerSourceBundleCid: layout.FixedBytes32,
                err: var str): cworld.CompilerLocalUniverse =
    var universe: cworld.CompilerLocalUniverse
    var extraEntries: cworld.CompilerUniverseManifestEntry[]
    assert(cworld.CompilerLocalUniverseBuildForChannelWithManifestEntriesInto(
               universe,
               err,
               "stable",
               compilerSourceBundleCid,
               TestCid("snapshot-production/compiler-canonical-graph"),
               TestCid("snapshot-production/export-surface"),
               layout.FixedBytes32(),
               layout.FixedBytes32(),
               extraEntries),
           err)
    return universe

fn main() =
    var err: str
    var csg = MakeCompilerCsg(
        "/tmp/semantic_snapshot_production_binding_smoke", err)
    let compilerExecutionResult = execution.CompilerExecutionIdentityMake(
        "semantic-snapshot-production",
        TestCid("snapshot-production/compiler-source-bundle"),
        TestCid("snapshot-production/materializer"),
        TestCid("snapshot-production/grammar-obligations"),
        TestCid("snapshot-production/compiler-source-closure"),
        TestCid("snapshot-production/driver-bytes"),
        TestCid("snapshot-production/toolchain-manifest"),
        TestCid("snapshot-production/command-manifest"),
        "arm64-apple-darwin")
    assert(IsOk(compilerExecutionResult),
           " semantic snapshot production smoke: execution identity")
    var compilerExecution = Value(compilerExecutionResult)
    var universe = MakeUniverse(
        compilerExecution.sourceBundleRaw32, err)
    assert(csg.packageId != "" &&
           parser.ParserManifestNormalizePackageId(csg.packageId) ==
               csg.packageId,
           " semantic snapshot production smoke: noncanonical CSG package")
    assert(csg.sourceSnapshotCount > 0 &&
           csg.nodeCount == csg.nodes.len &&
           csg.edgeCount == csg.edges.len &&
           csg.sourceSnapshotCount ==
               csg.sourceIdentityReceipt.sourceSnapshotCount,
           Fmt" semantic snapshot production smoke: CSG count drift sources={csg.sourceSnapshotCount}/{csg.sourceIdentityReceipt.sourceSnapshotCount} nodes={csg.nodeCount}/{csg.nodes.len} edges={csg.edgeCount}/{csg.edges.len}")
    assert(!layout.FixedBytes32Equal(csg.sourceBundleCid,
                                     layout.FixedBytes32()) &&
           !layout.FixedBytes32Equal(csg.entrySourceCid,
                                     layout.FixedBytes32()) &&
           layout.FixedBytes32Equal(
               csg.entrySourceCid,
               csg.sourceIdentityReceipt.entrySourceCid),
           " semantic snapshot production smoke: CSG source identity drift")
    assert(!layout.FixedBytes32Equal(
               csg.parserNormalizedExprReceipt.envelope.receiptRaw32,
               layout.FixedBytes32()) &&
           !layout.FixedBytes32Equal(csg.graphCid,
                                     layout.FixedBytes32()) &&
           !layout.FixedBytes32Equal(csg.canonicalGraphCid,
                                     layout.FixedBytes32()),
           " semantic snapshot production smoke: CSG proof CID missing")
    assert(!layout.FixedBytes32Equal(
               csg.sourceBundleCid,
               compilerExecution.sourceBundleRaw32) &&
           !layout.FixedBytes32Equal(
               csg.canonicalGraphCid,
               universe.worldHead.csgRootCid),
           " semantic snapshot production smoke: compiler and source identities collapsed")
    var receipt: production.SemanticSnapshotCompilerPredecessorReceipt
    assert(production.SemanticSnapshotCompilerPredecessorReceiptMakeInto(
               csg, universe, compilerExecution, receipt, err),
           err)
    assert(production.SemanticSnapshotCompilerPredecessorReceiptStrictValidateInto(
               receipt, csg, universe, compilerExecution, err),
           err)

    let originalTransitionCid =
        layout.FixedBytes32Copy(csg.csgTransitionReceipt.receiptCid)
    csg.csgTransitionReceipt.receiptCid =
        TestCid("snapshot-production/tampered-transition")
    var rejectedReceipt: production.SemanticSnapshotCompilerPredecessorReceipt
    assert(!production.SemanticSnapshotCompilerPredecessorReceiptMakeInto(
                csg, universe, compilerExecution, rejectedReceipt, err),
           " semantic snapshot production smoke: transition mutation accepted")
    csg.csgTransitionReceipt.receiptCid = originalTransitionCid

    let originalSourceBundleCid =
        layout.FixedBytes32Copy(csg.sourceBundleCid)
    csg.sourceBundleCid = TestCid("snapshot-production/tampered-source")
    assert(!production.SemanticSnapshotCompilerPredecessorReceiptMakeInto(
                csg, universe, compilerExecution, rejectedReceipt, err),
           " semantic snapshot production smoke: source mutation accepted")
    csg.sourceBundleCid = originalSourceBundleCid

    let originalSourceSnapshotCount = csg.sourceSnapshotCount
    csg.sourceSnapshotCount = originalSourceSnapshotCount + 1
    assert(!production.SemanticSnapshotCompilerPredecessorReceiptMakeInto(
                csg, universe, compilerExecution, rejectedReceipt, err),
           " semantic snapshot production smoke: source count split accepted")
    csg.sourceSnapshotCount = originalSourceSnapshotCount

    let originalNodeCount = csg.nodeCount
    csg.nodeCount = originalNodeCount + 1
    assert(!production.SemanticSnapshotCompilerPredecessorReceiptMakeInto(
                csg, universe, compilerExecution, rejectedReceipt, err),
           " semantic snapshot production smoke: node shape split accepted")
    csg.nodeCount = originalNodeCount

    let originalManifestCid =
        layout.FixedBytes32Copy(universe.manifest.manifestCid)
    universe.manifest.manifestCid =
        TestCid("snapshot-production/tampered-manifest")
    assert(!production.SemanticSnapshotCompilerPredecessorReceiptMakeInto(
                csg, universe, compilerExecution, rejectedReceipt, err),
           " semantic snapshot production smoke: manifest mutation accepted")
    universe.manifest.manifestCid = originalManifestCid

    var mirrorUniverse = MakeUniverse(
        compilerExecution.sourceBundleRaw32, err)
    for entryIndex in 0..<mirrorUniverse.manifest.entries.len:
        if mirrorUniverse.manifest.entries[entryIndex].packageId ==
           "cheng/compiler":
            mirrorUniverse.manifest.entries[entryIndex].managedMirrorBundleCid =
                TestCid("snapshot-production/forged-mirror")
    mirrorUniverse.manifest.manifestCid =
        cworld.CompilerWorldHashUniverseManifest(
            mirrorUniverse.manifest.channel,
            mirrorUniverse.manifest.managedDependencyReceiptCid,
            mirrorUniverse.manifest.entries)
    mirrorUniverse.worldHead.manifestRootCid =
        mirrorUniverse.manifest.manifestCid
    mirrorUniverse.worldHead.headCid = cworld.CompilerWorldHashHead(
        mirrorUniverse.worldHead.universeId,
        mirrorUniverse.worldHead.channel,
        mirrorUniverse.worldHead.headEpoch,
        mirrorUniverse.worldHead.prevHeadCid,
        mirrorUniverse.worldHead.manifestRootCid,
        mirrorUniverse.worldHead.csgRootCid,
        mirrorUniverse.worldHead.compilerPkgCid,
        mirrorUniverse.worldHead.stdPkgCid,
        mirrorUniverse.worldHead.runtimePkgCid,
        mirrorUniverse.worldHead.signature)
    assert(!production.SemanticSnapshotCompilerPredecessorReceiptMakeInto(
                csg, mirrorUniverse, compilerExecution, rejectedReceipt, err),
           " semantic snapshot production smoke: mirror split accepted")

    let mismatchedExecutionResult =
        execution.CompilerExecutionIdentityMake(
            "semantic-snapshot-production",
            TestCid("snapshot-production/other-source-bundle"),
            TestCid("snapshot-production/materializer"),
            TestCid("snapshot-production/grammar-obligations"),
            TestCid("snapshot-production/compiler-source-closure"),
            TestCid("snapshot-production/driver-bytes"),
            TestCid("snapshot-production/toolchain-manifest"),
            TestCid("snapshot-production/command-manifest"),
            "arm64-apple-darwin")
    assert(IsOk(mismatchedExecutionResult),
           " semantic snapshot production smoke: mismatched identity")
    var mismatchedExecution = Value(mismatchedExecutionResult)
    assert(!production.SemanticSnapshotCompilerPredecessorReceiptMakeInto(
                csg, universe, mismatchedExecution, rejectedReceipt, err),
           " semantic snapshot production smoke: execution source split accepted")

    let originalExecutionCid =
        layout.FixedBytes32Copy(compilerExecution.executionRaw32)
    compilerExecution.executionRaw32 =
        TestCid("snapshot-production/tampered-execution")
    assert(!production.SemanticSnapshotCompilerPredecessorReceiptMakeInto(
                csg, universe, compilerExecution, rejectedReceipt, err),
           " semantic snapshot production smoke: execution mutation accepted")
    compilerExecution.executionRaw32 = originalExecutionCid

    var secondReceipt: production.SemanticSnapshotCompilerPredecessorReceipt
    assert(production.SemanticSnapshotCompilerPredecessorReceiptMakeInto(
               csg, universe, compilerExecution, secondReceipt, err),
           err)
    assert(layout.FixedBytes32Equal(receipt.receiptCid,
                                    secondReceipt.receiptCid),
           " semantic snapshot production smoke: nondeterministic receipt")

    let originalReceiptCid =
        layout.FixedBytes32Copy(secondReceipt.receiptCid)
    secondReceipt.receiptCid =
        TestCid("snapshot-production/tampered-predecessor")
    assert(!production.SemanticSnapshotCompilerPredecessorReceiptStrictValidateInto(
                secondReceipt, csg, universe, compilerExecution, err),
           " semantic snapshot production smoke: predecessor mutation accepted")
    secondReceipt.receiptCid = originalReceiptCid
    let originalCompilerPackageCid =
        layout.FixedBytes32Copy(secondReceipt.compilerPackageCid)
    secondReceipt.compilerPackageCid =
        TestCid("snapshot-production/tampered-compiler-package")
    assert(!production.SemanticSnapshotCompilerPredecessorReceiptStrictValidateInto(
                secondReceipt, csg, universe, compilerExecution, err),
           " semantic snapshot production smoke: predecessor field accepted")
    secondReceipt.compilerPackageCid = originalCompilerPackageCid

    var eventState: snapshot.WorkspaceSourceEventState
    let workspaceSessionCid = TestCid("snapshot-production/workspace-session")
    assert(snapshot.WorkspaceSourceEventStateInitInto(
               workspaceSessionCid, eventState, err), err)
    var store: production.SemanticSnapshotProductionStore
    assert(production.SemanticSnapshotProductionStoreInitInto(
               workspaceSessionCid, store, err), err)
    var sourceVersion: int64
    var documentCid: layout.FixedBytes32
    assert(cworld.CompilerWorldDocumentCidInto(
               "pkg", "pkg/main", documentCid, err), err)
    assert(production.SemanticSnapshotProductionAcceptSourceEventInto(
               eventState, store, snapshot.SemanticSourceEventOpen,
               documentCid, int64(1),
               sourceVersion, err), err)
    assert(sourceVersion == int64(1),
           " semantic snapshot production smoke: source version split")
    var tables: schema.CsgCompilerSnapshotTables
    tables.schemaVersion = schema.CsgCompilerSnapshotSchemaVersionLatest
    tables.semanticEpoch = sourceVersion
    tables.predecessorReceiptCid = receipt.receiptCid
    tables.texts = ["Main", "fn Main", "function", "int32",
                    "pkg/main", "pkg/main::Main"]
    tables.sources.documentCids = [
        layout.FixedBytes32Copy(documentCid)]
    tables.sources.modulePathTextIds = [4]
    tables.sources.contentCids = [
        schema.CsgCompilerSourceContentCid(EntryText())]
    tables.sources.interfaceCids = [TestCid("snapshot-production/interface")]
    tables.spans.sourceIds = [0, 0, 0]
    tables.spans.startBytes = [0, 5, 6]
    tables.spans.endBytes = [4, 10, 9]
    tables.spans.startLines = [0, 1, 1]
    tables.spans.startColumns = [0, 0, 1]
    tables.spans.endLines = [0, 2, 1]
    tables.spans.endColumns = [4, 0, 4]
    tables.parserNodes.sourceIds = [0, 0, 0]
    tables.parserNodes.producerNodeIds = [0, 1, 2]
    tables.parserNodes.parentNodeIds = [-1, 0, 0]
    tables.parserNodes.kinds = [1, 2, 3]
    tables.parserNodes.spanIds = [0, 1, 2]
    tables.parserNodes.childStarts = [0, 2, 2]
    tables.parserNodes.childCounts = [2, 0, 0]
    tables.parserNodes.childNodeIds = [1, 2]
    tables.parserNodes.genericStarts = [0, 1, 1]
    tables.parserNodes.genericCounts = [1, 0, 0]
    tables.parserNodes.bindingResolutionKinds = [0, 0, 0]
    tables.parserNodes.bindingDeclarationSourceLocalRows = [-1, -1, -1]
    tables.parserNodes.bindingPatternSourceLocalRows = [-1, -1, -1]
    tables.tokens.sourceIds = [0]
    tables.tokens.sourceLocalRows = [0]
    tables.tokens.lexicalParentTokenIds = [-1]
    tables.tokens.spanIds = [0]
    tables.tokens.kinds = [1]
    tables.tokens.valueTextIds = [0]
    tables.parserSidecars.sourceIds = [0]
    tables.parserSidecars.producerSourceIndexes = [0]
    tables.parserSidecars.parserInputCids = [
        TestCid("snapshot-production/parser-input")]
    tables.parserSidecars.sidecarCids = [
        TestCid("snapshot-production/parser-sidecar")]
    tables.parserSidecars.declarationLexicalScopeProducerSourceIds = [0]
    tables.parserSidecars.declarationLexicalScopeSourceLocalRows = [0]
    tables.parserSidecars.declarationLexicalScopeKinds = [1]
    tables.parserSidecars.declarationLexicalScopeParentIds = [-1]
    tables.parserSidecars.declarationLexicalScopeOwnerDeclarationIds = [-1]
    tables.parserSidecars.declarationProducerSourceIds = [0]
    tables.parserSidecars.declarationSourceLocalRows = [0]
    tables.parserSidecars.declarationKinds = [3]
    tables.parserSidecars.declarationNameTokenIds = [0]
    tables.parserSidecars.declarationOwnerIds = [-1]
    tables.parserSidecars.declarationLexicalScopeIds = [0]
    tables.parserSidecars.declarationFunctionRows = [0]
    tables.parserSidecars.declarationTypeSyntaxRootIds = [-1]
    tables.parserSidecars.declarationDefaultStatementRootRows = [-1]
    tables.parserSidecars.declarationSpanIds = [0]
    tables.parserSidecars.declarationNameSpanIds = [0]
    tables.parserSidecars.declarationMutableFlags = [false]
    tables.parserSidecars.declarationExportedFlags = [true]
    tables.parserSidecars.rootNodeIds = [0]
    tables.parserSidecars.genericSpanIds = [0]
    tables.parserSidecars.callEventNodeIds = [2]
    tables.parserSidecars.statementRootNodeIds = [0]
    tables.parserSidecars.statementRootRoles = [2]
    tables.parserSidecars.statementRootAnchorTokenIds = [0]
    tables.parserSidecars.statementRootBindingDeclarationStarts = [-1]
    tables.parserSidecars.statementRootBindingDeclarationCounts = [0]
    tables.parserSidecars.statementRootAnchorLines = [0]
    tables.parserSidecars.statementRootAnchorColumns = [0]
    tables.parserSidecars.statementRootEndLines = [0]
    tables.parserSidecars.statementRootEndColumns = [4]
    tables.parserSidecars.functionIndexes = [0]
    tables.parserSidecars.functionNameTextIds = [0]
    tables.parserSidecars.functionNameSurfaceKinds = [
        declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier]
    let functionNameProofCid =
        TestCid("snapshot-production/function-name-proof")
    tables.parserSidecars.functionNameProofCids = [
        layout.FixedBytes32Copy(functionNameProofCid)]
    tables.parserSidecars.functionSignatureLineNumbers = [1]
    tables.parserSidecars.functionDeclarationSpanIds = [0]
    tables.parserSidecars.functionDeclarationHeaderCids = [
        TestCid("snapshot-production/declaration-header")]
    tables.parserSidecars.functionDeclarationPathCids = [
        TestCid("snapshot-production/declaration-path")]
    tables.parserSidecars.functionNameSpanIds = [0]
    tables.parserSidecars.functionBodySpanIds = [0]
    add(tables.parserSidecars.functionAnnotationFlags,
        schema.CsgCompilerFunctionAnnotationThreadBoundary)
    tables.types.typeCids = [layout.FixedBytes32(), layout.FixedBytes32()]
    tables.types.producerTypeArenaIds = [0, -1]
    tables.types.canonicalTextIds = [3, 1]
    tables.types.typeKinds = [schema.CsgCompilerTypeScalar,
                              schema.CsgCompilerTypeFunction]
    tables.types.scalarKinds = [schema.CsgCompilerScalarInt32, 0]
    tables.types.declSymbolIds = [-1, -1]
    tables.types.elementTypeIds = [-1, 0]
    tables.types.arrayLengths = [-1, -1]
    tables.types.argStarts = [0, 0]
    tables.types.argCounts = [0, 0]
    tables.types.constArgStarts = [0, 0]
