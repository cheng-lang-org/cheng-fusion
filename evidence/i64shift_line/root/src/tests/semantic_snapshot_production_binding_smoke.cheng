            schema.CsgCompilerTraitProofBuiltin]
        tables.types.traitProofCids = [signatureTraitProofCid,
                                       scalarTraitProofCid]
        tables.types.traitPremiseStarts = [0, 1]
        tables.types.traitPremiseCounts = [1, 0]
        tables.types.traitPremiseTypeIds = [1]
        # [phaseB-enum-schema] Zero variant rows in the swapped order too.
        tables.types.variantStarts = [0, 0]
        tables.types.variantCounts = [0, 0]
        scalarTypeId = 1
        signatureTypeId = 0
    var declarationCandidates: declaration.SemanticSnapshotDeclarationCandidateStore
    declaration.SemanticSnapshotDeclarationCandidateStoreInitInto(
        declarationCandidates)
    let declarationPackageId = parser.ParserOwnedText("pkg")
    let declarationModulePath = parser.ParserOwnedText("pkg/main")
    let declarationModuleCanonicalName =
        parser.ParserOwnedText("pkg/main")
    let declarationFunctionCanonicalName =
        parser.ParserOwnedText("Main")
    var moduleCandidateIndex: int32
    assert(declaration.SemanticSnapshotDeclarationCandidateAppendInto(
               declarationCandidates,
               share(declarationPackageId),
               share(declarationModulePath),
               layout.FixedBytes32Copy(documentCid), "",
               -1, declaration.SemanticSnapshotDeclarationKindModule,
               declaration.SemanticSnapshotDeclarationNameSurfaceModulePath,
               declarationModuleCanonicalName,
               layout.FixedBytes32Copy(documentCid),
               layout.FixedBytes32Copy(documentCid),
               layout.FixedBytes32(), 0, 0, moduleCandidateIndex, err), err)
    var functionCandidateIndex: int32
    assert(declaration.SemanticSnapshotDeclarationCandidateAppendInto(
               declarationCandidates,
               declarationPackageId,
               declarationModulePath,
               layout.FixedBytes32Copy(documentCid), "",
               moduleCandidateIndex,
               declaration.SemanticSnapshotDeclarationKindFunction,
               declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
               declarationFunctionCanonicalName,
               layout.FixedBytes32Copy(functionNameProofCid),
               layout.FixedBytes32Copy(signatureTypeCid),
               layout.FixedBytes32(), 0, 4, functionCandidateIndex, err), err)
    var declarationTable: declaration.SemanticSnapshotDeclarationTable
    var declarationMapping: declaration.SemanticSnapshotDeclarationMappingReceipt
    assert(declaration.SemanticSnapshotDeclarationTableSealInto(
               declarationCandidates, declarationTable,
               declarationMapping, err), err)
    tables.declarations = declarationTable
    let moduleDeclId =
        declarationMapping.producerCandidateToDeclIds[moduleCandidateIndex]
    let functionDeclId =
        declarationMapping.producerCandidateToDeclIds[functionCandidateIndex]
    var moduleSymbolId: int32
    var functionSymbolId: int32
    if TestCidLess(
           tables.declarations.declKeyCids[moduleDeclId],
           tables.declarations.declKeyCids[functionDeclId]):
        moduleSymbolId = 0
        functionSymbolId = 1
    else:
        moduleSymbolId = 1
        functionSymbolId = 0
    tables.symbols.declIds[moduleSymbolId] = moduleDeclId
    tables.symbols.declKeyCids[moduleSymbolId] =
        tables.declarations.declKeyCids[moduleDeclId]
    tables.symbols.declarationHeaderCids[moduleSymbolId] =
        TestCid("snapshot-production/module-declaration-header")
    tables.symbols.declarationPathCids[moduleSymbolId] =
        TestCid("snapshot-production/module-declaration-path")
    tables.symbols.nameTextIds[moduleSymbolId] = 4
    tables.symbols.qualifiedNameTextIds[moduleSymbolId] = 4
    tables.symbols.symbolKinds[moduleSymbolId] =
        schema.CsgCompilerSymbolModule
    tables.symbols.typeIds[moduleSymbolId] = -1
    tables.symbols.ownerSymbolIds[moduleSymbolId] = -1
    tables.symbols.functionIds[moduleSymbolId] = -1
    tables.symbols.exportedFlags[moduleSymbolId] = false
    tables.symbols.declIds[functionSymbolId] = functionDeclId
    tables.symbols.declKeyCids[functionSymbolId] =
        tables.declarations.declKeyCids[functionDeclId]
    tables.symbols.declarationHeaderCids[functionSymbolId] =
        TestCid("snapshot-production/declaration-header")
    tables.symbols.declarationPathCids[functionSymbolId] =
        TestCid("snapshot-production/declaration-path")
    tables.symbols.nameTextIds[functionSymbolId] = 0
    tables.symbols.nameSpanIds[functionSymbolId] = 0
    tables.symbols.nameTokenIds[functionSymbolId] = 0
    tables.symbols.qualifiedNameTextIds[functionSymbolId] = 5
    tables.symbols.symbolKinds[functionSymbolId] =
        schema.CsgCompilerSymbolFunction
    tables.symbols.typeIds[functionSymbolId] = signatureTypeId
    tables.symbols.declarationSpanIds[functionSymbolId] = 0
    tables.symbols.ownerSymbolIds[functionSymbolId] = moduleSymbolId
    tables.symbols.functionIds[functionSymbolId] = 0
    tables.symbols.exportedFlags[functionSymbolId] = true
    tables.functions.symbolIds[0] = functionSymbolId
    tables.lexicalScopes.visibleSymbolIds[0] = functionSymbolId
    tables.debugOps.symbolIds[0] = functionSymbolId
    tables.references.ownerSymbolIds[0] = functionSymbolId
    tables.references.targetSymbolIds[0] = functionSymbolId
    tables.calls.calleeSymbolIds[0] = functionSymbolId
    tables.calls.resultTypeIds[0] = scalarTypeId
    tables.layouts.typeIds[0] = scalarTypeId
    tables.typedNodes.typeIds[0] = scalarTypeId
    for symbolId in 0..<tables.symbols.symbolCids.len:
        var rowSymbolCid: layout.FixedBytes32
        assert(schema.CsgCompilerSymbolRowCidInto(
                   tables, symbolId, rowSymbolCid, err), err)
        tables.symbols.symbolCids[symbolId] = rowSymbolCid
    let symbolCid = tables.symbols.symbolCids[functionSymbolId]
    tables.calls.targetDeclIds[0] = functionDeclId
    tables.calls.targetDeclKeyCids[0] =
        tables.symbols.declKeyCids[functionSymbolId]
    tables.calls.targetSymbolCids[0] =
        layout.FixedBytes32Copy(symbolCid)
    var layoutCid: layout.FixedBytes32
    assert(schema.CsgCompilerLayoutRowCidInto(
               tables, 0, layoutCid, err), err)
    tables.layouts.layoutCids[0] = layoutCid
    for symbolId in 0..<tables.symbols.interfaceCids.len:
        var rowInterfaceCid: layout.FixedBytes32
        assert(schema.CsgCompilerSymbolInterfaceCidInto(
                   tables, symbolId, rowInterfaceCid, err), err)
        tables.symbols.interfaceCids[symbolId] = rowInterfaceCid
    let interfaceCid = tables.symbols.interfaceCids[functionSymbolId]
    tables.functions.interfaceCids[0] =
        layout.FixedBytes32Copy(interfaceCid)
    var sourceInterfaceCids: layout.FixedBytes32[]
    assert(schema.CsgCompilerSourceInterfaceCidsInto(
               tables, sourceInterfaceCids, err), err)
    tables.sources.interfaceCids = sourceInterfaceCids
    assert(schema.CsgCompilerReadSetPreimageCidInto(
               symbolCid,
               tables.readSet.targetDomainKinds,
               tables.readSet.targetPortableKeyCids,
               tables.readSet.observedValueCids,
               0,
               0,
               readSetPreimageCid,
               err), err)
    tables.functions.readSetPreimageCids[0] = readSetPreimageCid
    assert(schema.CsgCompilerReadSetReverseBuildInto(tables, err), err)
    var callOwnershipProofCid: layout.FixedBytes32
    assert(schema.CsgCompilerCallResultOwnershipProofCidInto(
               tables, 0, callOwnershipProofCid, err), err)
    tables.calls.resultOwnershipProofCids[0] = callOwnershipProofCid
    var ownershipProofCid: layout.FixedBytes32
    assert(schema.CsgCompilerTypedNodeOwnershipProofCidInto(
               tables, 0, ownershipProofCid, err), err)
    tables.typedNodes.ownershipProofCids[0] = ownershipProofCid
    var sendProofCid: layout.FixedBytes32
    assert(schema.CsgCompilerTypedNodeSendProofCidInto(
               tables, 0, sendProofCid, err), err)
    tables.typedNodes.sendProofCids[0] = sendProofCid
    var syncProofCid: layout.FixedBytes32
    assert(schema.CsgCompilerTypedNodeSyncProofCidInto(
               tables, 0, syncProofCid, err), err)
    tables.typedNodes.syncProofCids[0] = syncProofCid
    var shareProofCid: layout.FixedBytes32
    assert(schema.CsgCompilerTypedNodeShareProofCidInto(
               tables, 0, shareProofCid, err), err)
    tables.typedNodes.shareProofCids[0] = shareProofCid
    var fragmentCid: layout.FixedBytes32
    assert(schema.CsgCompilerFunctionFragmentCidInto(
               tables, 0, fragmentCid, err), err)
    tables.functions.fragmentCids[0] = fragmentCid
    var sourceDocument: query_projection.SemanticSnapshotSourceDocument
    sourceDocument.uri =
        "file:///tmp/semantic_snapshot_production_binding_smoke/src/main.cheng"
    sourceDocument.documentCid =
        layout.FixedBytes32Copy(documentCid)
    sourceDocument.contentCid = tables.sources.contentCids[0]
    sourceDocument.text = EntryText()
    sourceDocument.clientVersion = int64(1)
    sourceDocument.open = true
    var sourceDocuments = [sourceDocument]
    var candidate: production.SemanticSnapshotProductionCandidate
    assert(production.SemanticSnapshotProductionCandidateMakeInto(
               receipt, csg, universe, compilerExecution, eventState,
               tables, sourceDocuments, candidate, err), err)
    assert(layout.FixedBytes32Equal(
               candidate.queryProjection.queryIndex.declarationTableCid,
               tables.declarations.tableCid) &&
           candidate.queryProjection.queryIndex.symbolDeclIds.len == 2 &&
           candidate.queryProjection.queryIndex.symbolDeclIds[
               functionSymbolId] ==
               functionDeclId &&
           layout.FixedBytes32Equal(
               candidate.queryProjection.queryIndex.symbolDeclKeyCids[
                   functionSymbolId],
               tables.declarations.declKeyCids[functionDeclId]),
           " semantic snapshot production smoke: declaration projection split")
    assert(!layout.FixedBytes32Equal(candidate.identity.csgRootCid,
                                     csg.canonicalGraphCid),
           " semantic snapshot production smoke: compiler graph reused as CSG root")
    var factBundle: facts.CompilerFactBundle
    assert(facts.CompilerFactsFromSemanticSnapshotInto(
               candidate.tables, candidate.identity, candidate.binding,
               candidate.validation, candidate.predecessor.receiptCid,
               csg.packageId, factBundle, err), err)
    assert(factBundle.sourceVersion == int64(1) &&
           factBundle.factCount == 16 &&
           layout.FixedBytes32Equal(factBundle.bindingReceiptCid,
                                    candidate.binding.bindingReceiptCid) &&
           layout.FixedBytes32Equal(factBundle.semanticSnapshotCid,
                                    candidate.identity.semanticSnapshotCid) &&
           layout.FixedBytes32Equal(factBundle.csgRootCid,
                                    candidate.identity.csgRootCid),
           " semantic snapshot production smoke: CompilerFact binding drift")
    var exactReferenceCount: int32
    var exactSymbolCount: int32
    var exactOwnershipCount: int32
    var exactTypeDefCount: int32
    var exactTypeDeclarationCount: int32
    var exactConcurrencyCount: int32
    var exactConcurrencyDeclarationCount: int32
    var exactFunctionSpanCount: int32
    var exactLexicalScopeCount: int32
    var exactExportSurfaceCount: int32
    for factIndex in 0..<factBundle.facts.len:
        let fact = factBundle.facts[factIndex]
        if fact.kind == facts.FactKindSymbol:
            exactSymbolCount = exactSymbolCount + 1
            if fact.symbolFact.symbolId == functionSymbolId:
                assert(fact.symbolFact.declId == functionDeclId &&
                       layout.FixedBytes32Equal(
                           fact.symbolFact.declKeyCid,
                           tables.declarations.declKeyCids[functionDeclId]) &&
                       layout.FixedBytes32Equal(
                           fact.symbolFact.declarationTableCid,
                           tables.declarations.tableCid),
                       " semantic snapshot production smoke: function declaration projection drift")
            else:
                assert(fact.symbolFact.symbolId == moduleSymbolId &&
                       fact.symbolFact.declId == moduleDeclId &&
                       layout.FixedBytes32Equal(
                           fact.symbolFact.declKeyCid,
                           tables.declarations.declKeyCids[moduleDeclId]) &&
                       layout.FixedBytes32Equal(
                           fact.symbolFact.declarationTableCid,
                           tables.declarations.tableCid),
                       " semantic snapshot production smoke: module declaration projection drift")
        elif fact.kind == facts.FactKindReference:
            exactReferenceCount = exactReferenceCount + 1
            assert(fact.referenceFact.rowId == 0 &&
                   fact.referenceFact.targetSymbolId == functionSymbolId &&
                   fact.referenceFact.targetDeclId == functionDeclId &&
                   fact.referenceFact.ownerFunctionId == 0 &&
                   fact.referenceFact.ownerSymbolId == functionSymbolId &&
                   fact.referenceFact.ownerDeclId == functionDeclId &&
                   fact.referenceFact.referenceKind ==
                       schema.CsgCompilerReferenceCall &&
                   layout.FixedBytes32Equal(
                       fact.referenceFact.ownerSymbolCid,
                       tables.symbols.symbolCids[functionSymbolId]) &&
                   layout.FixedBytes32Equal(
                       fact.referenceFact.targetSymbolCid,
                       tables.symbols.symbolCids[functionSymbolId]) &&
                   layout.FixedBytes32Equal(
                       fact.referenceFact.targetDeclKeyCid,
                       tables.declarations.declKeyCids[functionDeclId]) &&
                   layout.FixedBytes32Equal(
                       fact.referenceFact.ownerDeclKeyCid,
                       tables.declarations.declKeyCids[functionDeclId]) &&
                   layout.FixedBytes32Equal(
                       fact.referenceFact.declarationTableCid,
                       tables.declarations.tableCid),
                   " semantic snapshot production smoke: reference projection drift")
        elif fact.kind == facts.FactKindOwnership:
            exactOwnershipCount = exactOwnershipCount + 1
            assert(fact.ownershipFact.typedNodeId == 0 &&
                   fact.ownershipFact.functionId == 0 &&
                   fact.ownershipFact.functionSymbolId ==
                       functionSymbolId &&
                   fact.ownershipFact.functionDeclId == functionDeclId &&
                   fact.ownershipFact.typeId == scalarTypeId &&
                   layout.FixedBytes32Equal(
                       fact.ownershipFact.functionSymbolCid,
                       tables.symbols.symbolCids[functionSymbolId]) &&
                   layout.FixedBytes32Equal(
                       fact.ownershipFact.functionDeclKeyCid,
                       tables.declarations.declKeyCids[functionDeclId]) &&
                   layout.FixedBytes32Equal(
                       fact.ownershipFact.declarationTableCid,
                       tables.declarations.tableCid),
                   " semantic snapshot production smoke: ownership projection drift")
        elif fact.kind == facts.FactKindTypeDef:
            exactTypeDefCount = exactTypeDefCount + 1
            assert(layout.FixedBytes32Equal(
                       fact.typeDefFact.declarationTableCid,
                       tables.declarations.tableCid),
                   " semantic snapshot production smoke: type declaration table drift")
            if fact.typeDefFact.declarationPresent:
                exactTypeDeclarationCount = exactTypeDeclarationCount + 1
                assert(fact.typeDefFact.declSymbolId >= 0 &&
                       fact.typeDefFact.declId >= 0 &&
                       !layout.FixedBytes32Equal(
                           fact.typeDefFact.declSymbolCid,
                           layout.FixedBytes32()) &&
                       !layout.FixedBytes32Equal(
                           fact.typeDefFact.declKeyCid,
                           layout.FixedBytes32()),
                       " semantic snapshot production smoke: type declaration projection drift")
            else:
                assert(fact.typeDefFact.declSymbolId == -1 &&
                       fact.typeDefFact.declId == -1 &&
                       layout.FixedBytes32Equal(
                           fact.typeDefFact.declSymbolCid,
                           layout.FixedBytes32()) &&
                       layout.FixedBytes32Equal(
                           fact.typeDefFact.declKeyCid,
                           layout.FixedBytes32()),
                       " semantic snapshot production smoke: type declaration absence drift")
        elif fact.kind == facts.FactKindConcurrency:
            exactConcurrencyCount = exactConcurrencyCount + 1
            assert(layout.FixedBytes32Equal(
                       fact.concurrencyFact.declarationTableCid,
                       tables.declarations.tableCid),
                   " semantic snapshot production smoke: concurrency declaration table drift")
            if fact.concurrencyFact.declarationPresent:
                exactConcurrencyDeclarationCount =
                    exactConcurrencyDeclarationCount + 1
                assert(fact.concurrencyFact.symbolId ==
                           functionSymbolId &&
                       fact.concurrencyFact.declId == functionDeclId &&
                       layout.FixedBytes32Equal(
                           fact.concurrencyFact.declKeyCid,
                           tables.declarations.declKeyCids[functionDeclId]),
                       " semantic snapshot production smoke: concurrency declaration projection drift")
            else:
                assert(fact.concurrencyFact.symbolId == -1 &&
                       fact.concurrencyFact.declId == -1 &&
                       layout.FixedBytes32Equal(
                           fact.concurrencyFact.declKeyCid,
                           layout.FixedBytes32()),
                       " semantic snapshot production smoke: concurrency declaration absence drift")
        elif fact.kind == facts.FactKindFunctionSpan:
            exactFunctionSpanCount = exactFunctionSpanCount + 1
            assert(fact.functionSpanFact.declId == functionDeclId &&
                   layout.FixedBytes32Equal(
                       fact.functionSpanFact.declKeyCid,
                       tables.declarations.declKeyCids[functionDeclId]) &&
                   layout.FixedBytes32Equal(
                       fact.functionSpanFact.declarationTableCid,
                       tables.declarations.tableCid) &&
                   layout.FixedBytes32Equal(
                       fact.functionSpanFact.bodyContentCid,
                       tables.functions.bodyContentCids[0]) &&
                   layout.FixedBytes32Equal(
                       fact.functionSpanFact.interfaceCid,
                       tables.functions.interfaceCids[0]) &&
                   layout.FixedBytes32Equal(
                       fact.functionSpanFact.readSetPreimageCid,
                       tables.functions.readSetPreimageCids[0]),
                   " semantic snapshot production smoke: function prebuild facts drift")
        elif fact.kind == facts.FactKindLexicalScope:
            exactLexicalScopeCount = exactLexicalScopeCount + 1
            assert(fact.lexicalScopeFact.visibleSymbolIds.len == 1 &&
                   fact.lexicalScopeFact.visibleSymbolIds[0] ==
                       functionSymbolId &&
                   fact.lexicalScopeFact.visibleDeclIds.len == 1 &&
                   fact.lexicalScopeFact.visibleDeclIds[0] == functionDeclId &&
                   fact.lexicalScopeFact.visibleDeclKeyCids.len == 1 &&
                   layout.FixedBytes32Equal(
                       fact.lexicalScopeFact.visibleDeclKeyCids[0],
                       tables.declarations.declKeyCids[functionDeclId]) &&
                   layout.FixedBytes32Equal(
                       fact.lexicalScopeFact.declarationTableCid,
                       tables.declarations.tableCid),
                   " semantic snapshot production smoke: lexical declaration projection drift")
        elif fact.kind == facts.FactKindExportSurface:
            exactExportSurfaceCount = exactExportSurfaceCount + 1
            assert(fact.exportSurfaceFact.exportedSymbolIds.len == 1 &&
                   fact.exportSurfaceFact.exportedSymbolIds[0] ==
                       functionSymbolId &&
                   fact.exportSurfaceFact.exportedDeclIds.len == 1 &&
                   fact.exportSurfaceFact.exportedDeclIds[0] == functionDeclId &&
                   fact.exportSurfaceFact.exportedDeclKeyCids.len == 1 &&
                   layout.FixedBytes32Equal(
                       fact.exportSurfaceFact.exportedDeclKeyCids[0],
                       tables.declarations.declKeyCids[functionDeclId]) &&
                   layout.FixedBytes32Equal(
                       fact.exportSurfaceFact.declarationTableCid,
                       tables.declarations.tableCid),
                   " semantic snapshot production smoke: export declaration projection drift")
    assert(exactSymbolCount == 2 && exactReferenceCount == 1 &&
           exactOwnershipCount == 1 &&
           exactTypeDefCount == 2 && exactTypeDeclarationCount == 0 &&
           exactConcurrencyCount == 5 &&
           exactConcurrencyDeclarationCount == 1 &&
           exactFunctionSpanCount == 1 && exactLexicalScopeCount == 1 &&
           exactExportSurfaceCount == 1,
           " semantic snapshot production smoke: CompilerFact row coverage drift")

    var attackedFactBundle: facts.CompilerFactBundle
    let originalReferenceOwnerFunctionId =
        candidate.tables.references.ownerFunctionIds[0]
    candidate.tables.references.ownerFunctionIds[0] =
        candidate.tables.functions.symbolIds.len
    assert(!facts.CompilerFactsFromSemanticSnapshotInto(
                candidate.tables, candidate.identity, candidate.binding,
                candidate.validation, candidate.predecessor.receiptCid,
                csg.packageId, attackedFactBundle, err),
           " semantic snapshot production smoke: reference owner declaration attack survived")
    candidate.tables.references.ownerFunctionIds[0] =
        originalReferenceOwnerFunctionId

    let originalFunctionSymbolId = candidate.tables.functions.symbolIds[0]
    candidate.tables.functions.symbolIds[0] =
        candidate.tables.symbols.symbolCids.len
    assert(!facts.CompilerFactsFromSemanticSnapshotInto(
                candidate.tables, candidate.identity, candidate.binding,
                candidate.validation, candidate.predecessor.receiptCid,
                csg.packageId, attackedFactBundle, err),
           " semantic snapshot production smoke: function declaration attack survived")
    candidate.tables.functions.symbolIds[0] = originalFunctionSymbolId

    let originalVisibleSymbolId =
        candidate.tables.lexicalScopes.visibleSymbolIds[0]
    candidate.tables.lexicalScopes.visibleSymbolIds[0] =
        candidate.tables.symbols.symbolCids.len
    assert(!facts.CompilerFactsFromSemanticSnapshotInto(
                candidate.tables, candidate.identity, candidate.binding,
                candidate.validation, candidate.predecessor.receiptCid,
                csg.packageId, attackedFactBundle, err),
           " semantic snapshot production smoke: lexical declaration attack survived")
    candidate.tables.lexicalScopes.visibleSymbolIds[0] =
        originalVisibleSymbolId

    let originalExportedSymbolDeclId =
        candidate.tables.symbols.declIds[functionSymbolId]
    candidate.tables.symbols.declIds[functionSymbolId] =
        declarationMapping.producerCandidateToDeclIds[moduleCandidateIndex]
    assert(!facts.CompilerFactsFromSemanticSnapshotInto(
                candidate.tables, candidate.identity, candidate.binding,
                candidate.validation, candidate.predecessor.receiptCid,
                csg.packageId, attackedFactBundle, err),
           " semantic snapshot production smoke: export declaration attack survived")
    candidate.tables.symbols.declIds[functionSymbolId] =
        originalExportedSymbolDeclId

    let originalOwnershipFunctionId =
        candidate.tables.typedNodes.functionIds[0]
    candidate.tables.typedNodes.functionIds[0] =
        candidate.tables.functions.symbolIds.len
    assert(!facts.CompilerFactsFromSemanticSnapshotInto(
                candidate.tables, candidate.identity, candidate.binding,
                candidate.validation, candidate.predecessor.receiptCid,
                csg.packageId, attackedFactBundle, err),
           " semantic snapshot production smoke: ownership function declaration attack survived")
    candidate.tables.typedNodes.functionIds[0] = originalOwnershipFunctionId

    let originalScalarDeclSymbolId =
        candidate.tables.types.declSymbolIds[scalarTypeId]
    candidate.tables.types.declSymbolIds[scalarTypeId] =
        candidate.tables.symbols.symbolCids.len
    assert(!facts.CompilerFactsFromSemanticSnapshotInto(
                candidate.tables, candidate.identity, candidate.binding,
                candidate.validation, candidate.predecessor.receiptCid,
                csg.packageId, attackedFactBundle, err),
           " semantic snapshot production smoke: type declaration authority attack survived")
    candidate.tables.types.declSymbolIds[scalarTypeId] =
        originalScalarDeclSymbolId

    var semanticFactBundle: semfacts.SemanticFactBundle
    assert(semfacts.SemanticFactsFromSemanticSnapshotInto(
               candidate.tables, candidate.identity, candidate.binding,
               candidate.validation, candidate.predecessor.receiptCid,
               csg.packageId, semanticFactBundle, err), err)
    assert(semanticFactBundle.sourceVersion == int64(1) &&
           semanticFactBundle.factCount == 3 &&
           layout.FixedBytes32Equal(semanticFactBundle.csgRootCid,
                                    candidate.identity.csgRootCid),
           " semantic snapshot production smoke: SemanticFact binding drift")
    var exactCallCount: int32
    var exactResolvedTypeCount: int32
    var exactLayoutCount: int32
    var exactLayoutDeclarationCount: int32
    var exactLayoutFieldCount: int32
    for factIndex in 0..<semanticFactBundle.facts.len:
        let fact = semanticFactBundle.facts[factIndex]
        if fact.kind == semfacts.SemanticFactKindCallGraph:
            exactCallCount = exactCallCount + 1
            assert(fact.callGraphEdgeFact.referenceId == 0 &&
                   fact.callGraphEdgeFact.callerFunctionId == 0 &&
                   fact.callGraphEdgeFact.callerSymbolId ==
                       functionSymbolId &&
                   fact.callGraphEdgeFact.calleeSymbolId ==
                       functionSymbolId &&
                   fact.callGraphEdgeFact.callerDeclId == functionDeclId &&
                   fact.callGraphEdgeFact.calleeDeclId == functionDeclId &&
                   fact.callGraphEdgeFact.resultTypeId == scalarTypeId &&
                   fact.callGraphEdgeFact.resultOwnershipKind ==
                       schema.CsgCompilerOwnershipUnmanaged &&
                   layout.FixedBytes32Equal(
                       fact.callGraphEdgeFact.callerSymbolCid,
                       tables.symbols.symbolCids[functionSymbolId]) &&
                   layout.FixedBytes32Equal(
                       fact.callGraphEdgeFact.callerDeclKeyCid,
                       tables.declarations.declKeyCids[functionDeclId]) &&
                   layout.FixedBytes32Equal(
                       fact.callGraphEdgeFact.calleeDeclKeyCid,
                       tables.declarations.declKeyCids[functionDeclId]) &&
                   layout.FixedBytes32Equal(
                       fact.callGraphEdgeFact.declarationTableCid,
                       tables.declarations.tableCid),
                   " semantic snapshot production smoke: call projection drift")
        elif fact.kind == semfacts.SemanticFactKindResolvedType:
            exactResolvedTypeCount = exactResolvedTypeCount + 1
            assert(fact.resolvedTypeFact.typedNodeId == 0 &&
                   fact.resolvedTypeFact.functionId == 0 &&
                   fact.resolvedTypeFact.functionSymbolId ==
                       functionSymbolId &&
                   fact.resolvedTypeFact.functionDeclId == functionDeclId &&
                   fact.resolvedTypeFact.typeId == scalarTypeId &&
                   fact.resolvedTypeFact.ownershipKind ==
                       schema.CsgCompilerOwnershipUnmanaged &&
                   layout.FixedBytes32Equal(
                       fact.resolvedTypeFact.functionSymbolCid,
                       tables.symbols.symbolCids[functionSymbolId]) &&
                   layout.FixedBytes32Equal(
                       fact.resolvedTypeFact.functionDeclKeyCid,
                       tables.declarations.declKeyCids[functionDeclId]) &&
                   layout.FixedBytes32Equal(
                       fact.resolvedTypeFact.declarationTableCid,
                       tables.declarations.tableCid),
                   " semantic snapshot production smoke: type projection drift")
        elif fact.kind == semfacts.SemanticFactKindLayout:
            exactLayoutCount = exactLayoutCount + 1
            assert(fact.layoutFact.layoutId == 0 &&
                   fact.layoutFact.typeId == scalarTypeId &&
                   fact.layoutFact.sizeBytes == 4 &&
                   fact.layoutFact.alignBytes == 4 &&
                   layout.FixedBytes32Equal(
                       fact.layoutFact.declarationTableCid,
                       tables.declarations.tableCid),
                   " semantic snapshot production smoke: layout projection drift")
            if fact.layoutFact.declarationPresent:
                exactLayoutDeclarationCount =
                    exactLayoutDeclarationCount + 1
                assert(fact.layoutFact.declSymbolId >= 0 &&
                       fact.layoutFact.declId >= 0 &&
                       !layout.FixedBytes32Equal(
                           fact.layoutFact.declSymbolCid,
                           layout.FixedBytes32()) &&
                       !layout.FixedBytes32Equal(
                           fact.layoutFact.declKeyCid,
                           layout.FixedBytes32()),
                       " semantic snapshot production smoke: layout type declaration projection drift")
            else:
                assert(fact.layoutFact.declSymbolId == -1 &&
                       fact.layoutFact.declId == -1 &&
                       layout.FixedBytes32Equal(
                           fact.layoutFact.declSymbolCid,
                           layout.FixedBytes32()) &&
                       layout.FixedBytes32Equal(
                           fact.layoutFact.declKeyCid,
                           layout.FixedBytes32()),
                       " semantic snapshot production smoke: layout type declaration absence drift")
        elif fact.kind == semfacts.SemanticFactKindLayoutField:
            exactLayoutFieldCount = exactLayoutFieldCount + 1
            let symbolId = fact.layoutFieldFact.fieldSymbolId
            assert(symbolId >= 0 &&
                   fact.layoutFieldFact.fieldDeclId ==
                       tables.symbols.declIds[symbolId] &&
                   layout.FixedBytes32Equal(
                       fact.layoutFieldFact.fieldDeclKeyCid,
                       tables.symbols.declKeyCids[symbolId]) &&
                   layout.FixedBytes32Equal(
                       fact.layoutFieldFact.declarationTableCid,
                       tables.declarations.tableCid),
                   " semantic snapshot production smoke: layout field declaration projection drift")
    assert(exactCallCount == 1 && exactResolvedTypeCount == 1 &&
           exactLayoutCount == 1 && exactLayoutDeclarationCount == 0 &&
           exactLayoutFieldCount == 0,
           " semantic snapshot production smoke: SemanticFact row coverage drift")

    var attackedSemanticFactBundle: semfacts.SemanticFactBundle
    let originalTypedNodeFunctionId =
        candidate.tables.typedNodes.functionIds[0]
    candidate.tables.typedNodes.functionIds[0] =
        candidate.tables.functions.symbolIds.len
    assert(!semfacts.SemanticFactsFromSemanticSnapshotInto(
                candidate.tables, candidate.identity, candidate.binding,
                candidate.validation, candidate.predecessor.receiptCid,
                csg.packageId, attackedSemanticFactBundle, err),
           " semantic snapshot production smoke: resolved type function declaration attack survived")
    candidate.tables.typedNodes.functionIds[0] = originalTypedNodeFunctionId

    let originalLayoutFieldCount = candidate.tables.layouts.fieldCounts[0]
    candidate.tables.layouts.fieldCounts[0] = 1
    assert(!semfacts.SemanticFactsFromSemanticSnapshotInto(
                candidate.tables, candidate.identity, candidate.binding,
                candidate.validation, candidate.predecessor.receiptCid,
                csg.packageId, attackedSemanticFactBundle, err),
           " semantic snapshot production smoke: layout field declaration attack survived")
    candidate.tables.layouts.fieldCounts[0] = originalLayoutFieldCount

    let originalCallerFunctionId =
        candidate.tables.calls.callerFunctionIds[0]
    candidate.tables.calls.callerFunctionIds[0] =
        candidate.tables.functions.symbolIds.len
    assert(!semfacts.SemanticFactsFromSemanticSnapshotInto(
                candidate.tables, candidate.identity, candidate.binding,
                candidate.validation, candidate.predecessor.receiptCid,
                csg.packageId, attackedSemanticFactBundle, err),
           " semantic snapshot production smoke: call caller declaration attack survived")
    candidate.tables.calls.callerFunctionIds[0] = originalCallerFunctionId

    let originalCalleeSymbolId = candidate.tables.calls.calleeSymbolIds[0]
    candidate.tables.calls.calleeSymbolIds[0] =
        candidate.tables.symbols.symbolCids.len
    assert(!semfacts.SemanticFactsFromSemanticSnapshotInto(
                candidate.tables, candidate.identity, candidate.binding,
                candidate.validation, candidate.predecessor.receiptCid,
                csg.packageId, attackedSemanticFactBundle, err),
           " semantic snapshot production smoke: call callee declaration attack survived")
    candidate.tables.calls.calleeSymbolIds[0] = originalCalleeSymbolId

    candidate.tables.types.declSymbolIds[scalarTypeId] =
        candidate.tables.symbols.symbolCids.len
    assert(!semfacts.SemanticFactsFromSemanticSnapshotInto(
                candidate.tables, candidate.identity, candidate.binding,
                candidate.validation, candidate.predecessor.receiptCid,
                csg.packageId, attackedSemanticFactBundle, err),
           " semantic snapshot production smoke: layout type declaration authority attack survived")
    candidate.tables.types.declSymbolIds[scalarTypeId] =
        originalScalarDeclSymbolId

    var debugFactBundle: debugfacts.DebugFactBundle
    assert(debugfacts.DebugFactsFromSemanticSnapshotInto(
               candidate.tables, candidate.identity, candidate.binding,
               candidate.validation, candidate.predecessor.receiptCid,
               csg.packageId, debugFactBundle, err), err)
    assert(debugFactBundle.sourceVersion == int64(1) &&
           debugFactBundle.factCount == 5 &&
           debugFactBundle.debugOpCount == 1 &&
           layout.FixedBytes32Equal(debugFactBundle.bindingReceiptCid,
                                    candidate.binding.bindingReceiptCid) &&
           layout.FixedBytes32Equal(debugFactBundle.semanticSnapshotCid,
                                    candidate.identity.semanticSnapshotCid) &&
           layout.FixedBytes32Equal(debugFactBundle.csgRootCid,
                                    candidate.identity.csgRootCid),
           " semantic snapshot production smoke: DebugFact binding drift")
    var exactDebugOpCount: int32
    var exactDebugSymbolCount: int32
    for factIndex in 0..<debugFactBundle.facts.len:
        let fact = debugFactBundle.facts[factIndex]
        if fact.kind == debugfacts.DebugFactKindOperation:
            exactDebugOpCount = exactDebugOpCount + 1
            assert(fact.operationFact.debugOpId == 0 &&
                   fact.operationFact.typedNodeId == 0 &&
                   fact.operationFact.functionId == 0 &&
                   fact.operationFact.functionSymbolId ==
                       functionSymbolId &&
                   fact.operationFact.symbolId == functionSymbolId &&
                   fact.operationFact.spanId == 2 &&
                   fact.operationFact.opKind == 1,
                   " semantic snapshot production smoke: DebugOp projection drift")
        elif fact.kind == debugfacts.DebugFactKindSymbol:
            exactDebugSymbolCount = exactDebugSymbolCount + 1
            if fact.symbolFact.symbolId == moduleSymbolId:
                assert(fact.symbolFact.declId == moduleDeclId &&
                       fact.symbolFact.symbolKind ==
                           schema.CsgCompilerSymbolModule &&
                       fact.symbolFact.typeId == -1 &&
                       fact.symbolFact.ownerSymbolId == -1 &&
                       fact.symbolFact.functionId == -1 &&
                       fact.symbolFact.declarationSpanId == -1 &&
                       fact.symbolFact.startByte == 0 &&
                       fact.symbolFact.endByte == 0 &&
                       fact.symbolFact.startLine == 0 &&
                       fact.symbolFact.startColumn == 0 &&
                       fact.symbolFact.endLine == 0 &&
                       fact.symbolFact.endColumn == 0 &&
                       layout.FixedBytes32Equal(
                           fact.symbolFact.declKeyCid,
                           tables.declarations.declKeyCids[moduleDeclId]),
                       " semantic snapshot production smoke: implicit module DebugSymbol drift")
            else:
                assert(fact.symbolFact.symbolId == functionSymbolId &&
                       fact.symbolFact.declId == functionDeclId &&
                       fact.symbolFact.symbolKind ==
                           schema.CsgCompilerSymbolFunction &&
                       fact.symbolFact.typeId == signatureTypeId &&
                       fact.symbolFact.ownerSymbolId == moduleSymbolId &&
                       fact.symbolFact.functionId == 0 &&
                       fact.symbolFact.declarationSpanId == 0 &&
                       layout.FixedBytes32Equal(
                           fact.symbolFact.declKeyCid,
                           tables.declarations.declKeyCids[functionDeclId]),
                       " semantic snapshot production smoke: function DebugSymbol drift")
    assert(exactDebugOpCount == 1 && exactDebugSymbolCount == 2,
           " semantic snapshot production smoke: DebugFact row coverage drift")

    var attackedInterfaces = candidate.tables.sources.interfaceCids
    let originalTableInterface =
        layout.FixedBytes32Copy(attackedInterfaces[0])
    attackedInterfaces[0] = TestCid("snapshot-production/attacked-table")
    candidate.tables.sources.interfaceCids = attackedInterfaces
    assert(!production.SemanticSnapshotProductionCandidateStrictValidateInto(
                candidate, csg, universe, compilerExecution, err),
           " semantic snapshot production smoke: mutated tables accepted")
    attackedInterfaces[0] = originalTableInterface
    candidate.tables.sources.interfaceCids = attackedInterfaces

    let rejectedCoreCount = store.core.states.len
    let rejectedPayloadCount = store.payloadStates.len
    let rejectedPublishedIndex = store.core.publishedIndex
    let rejectedCurrentSourceVersion = store.core.currentSourceVersion
    var rejectedCommitIndex: int32
    let originalProjectionText = candidate.queryProjection.documents[0].text
    candidate.queryProjection.documents[0].text =
        "fn Main(): int32 =\n    return 8\n"
    assert(!production.SemanticSnapshotProductionStageCandidateInto(
                store, candidate, csg, universe, compilerExecution,
                rejectedCommitIndex, err),
           " semantic snapshot production smoke: text attack committed")
    AssertStoreCountsUnchanged(store, rejectedCoreCount,
                               rejectedPayloadCount,
                               rejectedPublishedIndex,
                               rejectedCurrentSourceVersion)
    assert(rejectedCommitIndex == -1,
           " semantic snapshot production smoke: failed text publish index")
    candidate.queryProjection.documents[0].text = originalProjectionText
    let originalProjectionContentCid =
        layout.FixedBytes32Copy(
            candidate.queryProjection.documents[0].contentCid)
    candidate.queryProjection.documents[0].contentCid =
        TestCid("snapshot-production/forged-projection-content")
    assert(!production.SemanticSnapshotProductionStageCandidateInto(
                store, candidate, csg, universe, compilerExecution,
                rejectedCommitIndex, err),
           " semantic snapshot production smoke: content CID attack committed")
    AssertStoreCountsUnchanged(store, rejectedCoreCount,
                               rejectedPayloadCount,
                               rejectedPublishedIndex,
                               rejectedCurrentSourceVersion)
    assert(rejectedCommitIndex == -1,
           " semantic snapshot production smoke: failed content publish index")
    candidate.queryProjection.documents[0].contentCid =
        originalProjectionContentCid
    let originalQueryIndexCid =
        layout.FixedBytes32Copy(
            candidate.queryProjection.queryIndex.indexCid)
    candidate.queryProjection.queryIndex.indexCid =
        TestCid("snapshot-production/forged-query-index")
    assert(!production.SemanticSnapshotProductionStageCandidateInto(
                store, candidate, csg, universe, compilerExecution,
                rejectedCommitIndex, err),
           " semantic snapshot production smoke: query index attack committed")
    AssertStoreCountsUnchanged(store, rejectedCoreCount,
                               rejectedPayloadCount,
                               rejectedPublishedIndex,
                               rejectedCurrentSourceVersion)
    assert(rejectedCommitIndex == -1,
           " semantic snapshot production smoke: failed index publish index")
    candidate.queryProjection.queryIndex.indexCid = originalQueryIndexCid
    let originalQueryIndexRootCid =
        layout.FixedBytes32Copy(
            candidate.queryProjection.queryIndex.rootCid)
    candidate.validation.queryIndexRootCid =
        TestCid("snapshot-production/forged-validation-query-root")
    assert(!production.SemanticSnapshotProductionStageCandidateInto(
                store, candidate, csg, universe, compilerExecution,
                rejectedCommitIndex, err),
           " semantic snapshot production smoke: validation query root attack committed")
    AssertStoreCountsUnchanged(store, rejectedCoreCount,
                               rejectedPayloadCount,
                               rejectedPublishedIndex,
                               rejectedCurrentSourceVersion)
    candidate.validation.queryIndexRootCid = originalQueryIndexRootCid
    let originalProjectionCid =
        layout.FixedBytes32Copy(candidate.queryProjection.projectionCid)
    candidate.queryProjection.projectionCid =
        TestCid("snapshot-production/forged-query-projection")
    assert(!production.SemanticSnapshotProductionStageCandidateInto(
                store, candidate, csg, universe, compilerExecution,
                rejectedCommitIndex, err),
           " semantic snapshot production smoke: projection attack committed")
    AssertStoreCountsUnchanged(store, rejectedCoreCount,
                               rejectedPayloadCount,
                               rejectedPublishedIndex,
                               rejectedCurrentSourceVersion)
    assert(rejectedCommitIndex == -1,
           " semantic snapshot production smoke: failed projection publish index")
    candidate.queryProjection.projectionCid = originalProjectionCid

    let originalProjectedDeclId =
        candidate.queryProjection.queryIndex.symbolDeclIds[
            functionSymbolId]
    candidate.queryProjection.queryIndex.symbolDeclIds[
        functionSymbolId] =
        declarationMapping.producerCandidateToDeclIds[moduleCandidateIndex]
    assert(!production.SemanticSnapshotProductionStageCandidateInto(
                store, candidate, csg, universe, compilerExecution,
                rejectedCommitIndex, err),
           " semantic snapshot production smoke: SymbolId/DeclId attack committed")
    AssertStoreCountsUnchanged(store, rejectedCoreCount,
                               rejectedPayloadCount,
                               rejectedPublishedIndex,
                               rejectedCurrentSourceVersion)
    candidate.queryProjection.queryIndex.symbolDeclIds[
        functionSymbolId] =
        originalProjectedDeclId
    let originalDeclarationTableCid =
        layout.FixedBytes32Copy(candidate.tables.declarations.tableCid)
    candidate.tables.declarations.tableCid =
        TestCid("snapshot-production/forged-declaration-table")
    assert(!production.SemanticSnapshotProductionStageCandidateInto(
                store, candidate, csg, universe, compilerExecution,
                rejectedCommitIndex, err),
           " semantic snapshot production smoke: declaration table CID attack committed")
    AssertStoreCountsUnchanged(store, rejectedCoreCount,
                               rejectedPayloadCount,
                               rejectedPublishedIndex,
                               rejectedCurrentSourceVersion)
    candidate.tables.declarations.tableCid = originalDeclarationTableCid
    let originalOwnerDeclId =
        candidate.tables.declarations.ownerDeclIds[functionDeclId]
    candidate.tables.declarations.ownerDeclIds[functionDeclId] = -1
    assert(!production.SemanticSnapshotProductionStageCandidateInto(
                store, candidate, csg, universe, compilerExecution,
                rejectedCommitIndex, err),
           " semantic snapshot production smoke: declaration owner attack committed")
    AssertStoreCountsUnchanged(store, rejectedCoreCount,
                               rejectedPayloadCount,
                               rejectedPublishedIndex,
                               rejectedCurrentSourceVersion)
    candidate.tables.declarations.ownerDeclIds[functionDeclId] =
        originalOwnerDeclId
    let originalDeclarationType =
        layout.FixedBytes32Copy(
            candidate.tables.declarations.portableSignatureTypeExpressionCids[
                functionDeclId])
    candidate.tables.declarations.portableSignatureTypeExpressionCids[
        functionDeclId] = TestCid("snapshot-production/forged-declaration-type")
    assert(!production.SemanticSnapshotProductionStageCandidateInto(
                store, candidate, csg, universe, compilerExecution,
                rejectedCommitIndex, err),
           " semantic snapshot production smoke: declaration type attack committed")
    AssertStoreCountsUnchanged(store, rejectedCoreCount,
                               rejectedPayloadCount,
                               rejectedPublishedIndex,
                               rejectedCurrentSourceVersion)
    candidate.tables.declarations.portableSignatureTypeExpressionCids[
        functionDeclId] = originalDeclarationType
    let originalNameProof =
        layout.FixedBytes32Copy(
            candidate.tables.declarations.parserValidatedNameProofCids[
                functionDeclId])
    candidate.tables.declarations.parserValidatedNameProofCids[
        functionDeclId] = TestCid("snapshot-production/forged-name-proof")
    assert(!production.SemanticSnapshotProductionStageCandidateInto(
                store, candidate, csg, universe, compilerExecution,
                rejectedCommitIndex, err),
           " semantic snapshot production smoke: name proof attack committed")
    AssertStoreCountsUnchanged(store, rejectedCoreCount,
                               rejectedPayloadCount,
                               rejectedPublishedIndex,
                               rejectedCurrentSourceVersion)
    candidate.tables.declarations.parserValidatedNameProofCids[
        functionDeclId] = originalNameProof

    var stagedIndex: int32
    assert(production.SemanticSnapshotProductionStageCandidateInto(
               store, candidate, csg, universe, compilerExecution,
               stagedIndex, err), err)
    assert(stagedIndex == 0 && store.core.publishedIndex == -1 &&
