               predecessorBorrowCount,
           " semantic snapshot production smoke: wrong predecessor version mutated")
    assert(!production.SemanticSnapshotProductionStorePinPublishedPredecessorInto(
                store, sourceVersion, pin, err) &&
           store.core.borrowCounts[publishedIndex] ==
               predecessorBorrowCount,
           " semantic snapshot production smoke: active predecessor output mutated")
    let predecessorPayloadIndex =
        store.payloadIndexesBySnapshot[publishedIndex]
    store.payloadIndexesBySnapshot[publishedIndex] = -1
    assert(!production.SemanticSnapshotProductionStorePinPublishedPredecessorInto(
                store, sourceVersion, predecessorPin, err) &&
           !predecessorPin.active &&
           store.core.borrowCounts[publishedIndex] ==
               predecessorBorrowCount,
           " semantic snapshot production smoke: predecessor index attack pinned")
    store.payloadIndexesBySnapshot[publishedIndex] =
        predecessorPayloadIndex
    let predecessorSourceVersion =
        store.core.sourceVersions[publishedIndex]
    store.core.sourceVersions[publishedIndex] = sourceVersion
    assert(!production.SemanticSnapshotProductionStorePinPublishedPredecessorInto(
                store, sourceVersion, predecessorPin, err) &&
           !predecessorPin.active &&
           store.core.borrowCounts[publishedIndex] ==
               predecessorBorrowCount,
           " semantic snapshot production smoke: predecessor version attack pinned")
    store.core.sourceVersions[publishedIndex] =
        predecessorSourceVersion
    let predecessorQueryIndexCid =
        layout.FixedBytes32Copy(store.payloadQueryIndexCids[0])
    store.payloadQueryIndexCids[0] =
        TestCid("snapshot-production/predecessor-query-index-attack")
    assert(!production.SemanticSnapshotProductionStorePinPublishedPredecessorInto(
                store, sourceVersion, predecessorPin, err) &&
           !predecessorPin.active &&
           store.core.borrowCounts[publishedIndex] ==
               predecessorBorrowCount,
           " semantic snapshot production smoke: predecessor query root attack pinned")
    store.payloadQueryIndexCids[0] = predecessorQueryIndexCid
    let predecessorQueryIndexRootCid =
        layout.FixedBytes32Copy(store.payloadQueryIndexRootCids[0])
    store.payloadQueryIndexRootCids[0] =
        TestCid("snapshot-production/predecessor-query-root-attack")
    assert(!production.SemanticSnapshotProductionStorePinPublishedPredecessorInto(
                store, sourceVersion, predecessorPin, err) &&
           !predecessorPin.active &&
           store.core.borrowCounts[publishedIndex] ==
               predecessorBorrowCount,
           " semantic snapshot production smoke: predecessor query Merkle root attack pinned")
    store.payloadQueryIndexRootCids[0] = predecessorQueryIndexRootCid
    let predecessorValidationBindingCid =
        layout.FixedBytes32Copy(
            store.payloadValidations[0].bindingReceiptCid)
    store.payloadValidations[0].bindingReceiptCid =
        TestCid("snapshot-production/predecessor-validation-attack")
    assert(!production.SemanticSnapshotProductionStorePinPublishedPredecessorInto(
                store, sourceVersion, predecessorPin, err) &&
           !predecessorPin.active &&
           store.core.borrowCounts[publishedIndex] ==
               predecessorBorrowCount,
           " semantic snapshot production smoke: predecessor validation attack pinned")
    store.payloadValidations[0].bindingReceiptCid =
        predecessorValidationBindingCid
    let predecessorCargoByte =
        rawbytes.BytesGet(store.payloadCsgcBytes[0], 0)
    rawbytes.BytesSet(
        store.payloadCsgcBytes[0], 0, predecessorCargoByte ^ 1)
    assert(!production.SemanticSnapshotProductionStorePinPublishedPredecessorInto(
                store, sourceVersion, predecessorPin, err) &&
           !predecessorPin.active &&
           store.core.borrowCounts[publishedIndex] ==
               predecessorBorrowCount,
           " semantic snapshot production smoke: predecessor cargo attack pinned")
    rawbytes.BytesSet(
        store.payloadCsgcBytes[0], 0, predecessorCargoByte)
    let predecessorSourceContentCid =
        layout.FixedBytes32Copy(
            store.payloadTables[0].sources.contentCids[0])
    store.payloadTables[0].sources.contentCids[0] =
        TestCid("snapshot-production/predecessor-table-attack")
    assert(!production.SemanticSnapshotProductionStorePinPublishedPredecessorInto(
                store, sourceVersion, predecessorPin, err) &&
           !predecessorPin.active &&
           store.core.borrowCounts[publishedIndex] ==
               predecessorBorrowCount,
           " semantic snapshot production smoke: predecessor table attack pinned")
    store.payloadTables[0].sources.contentCids[0] =
        predecessorSourceContentCid
    let predecessorCompilerFactCid =
        layout.FixedBytes32Copy(
            store.payloadCompilerFactProjectionCids[0])
    store.payloadCompilerFactProjectionCids[0] =
        TestCid("snapshot-production/predecessor-compiler-fact-attack")
    assert(!production.SemanticSnapshotProductionStorePinPublishedPredecessorInto(
                store, sourceVersion, predecessorPin, err) &&
           !predecessorPin.active &&
           store.core.borrowCounts[publishedIndex] ==
               predecessorBorrowCount,
           " semantic snapshot production smoke: predecessor CompilerFact attack pinned")
    store.payloadCompilerFactProjectionCids[0] =
        predecessorCompilerFactCid
    let predecessorSemanticFactCid =
        layout.FixedBytes32Copy(
            store.payloadSemanticFactProjectionCids[0])
    store.payloadSemanticFactProjectionCids[0] =
        TestCid("snapshot-production/predecessor-semantic-fact-attack")
    assert(!production.SemanticSnapshotProductionStorePinPublishedPredecessorInto(
                store, sourceVersion, predecessorPin, err) &&
           !predecessorPin.active &&
           store.core.borrowCounts[publishedIndex] ==
               predecessorBorrowCount,
           " semantic snapshot production smoke: predecessor SemanticFact attack pinned")
    store.payloadSemanticFactProjectionCids[0] =
        predecessorSemanticFactCid
    let predecessorDebugFactCid =
        layout.FixedBytes32Copy(
            store.payloadDebugFactProjectionCids[0])
    store.payloadDebugFactProjectionCids[0] =
        TestCid("snapshot-production/predecessor-debug-fact-attack")
    assert(!production.SemanticSnapshotProductionStorePinPublishedPredecessorInto(
                store, sourceVersion, predecessorPin, err) &&
           !predecessorPin.active &&
           store.core.borrowCounts[publishedIndex] ==
               predecessorBorrowCount,
           " semantic snapshot production smoke: predecessor DebugFact attack pinned")
    store.payloadDebugFactProjectionCids[0] =
        predecessorDebugFactCid
    store.core.borrowCounts[publishedIndex] = 2147483647
    assert(!production.SemanticSnapshotProductionStorePinPublishedPredecessorInto(
                store, sourceVersion, predecessorPin, err) &&
           !predecessorPin.active &&
           store.core.borrowCounts[publishedIndex] == 2147483647,
           " semantic snapshot production smoke: predecessor borrow overflow mutated")
    store.core.borrowCounts[publishedIndex] = predecessorBorrowCount
    assert(production.SemanticSnapshotProductionStorePinPublishedPredecessorInto(
               store, sourceVersion, predecessorPin, err), err)
    assert(predecessorPin.corePin.sourceVersion == int64(1) &&
           predecessorPin.payloadIndex == 0 &&
           layout.FixedBytes32Equal(
               predecessorPin.factsRootCid,
               store.payloadFactsRootCids[0]) &&
           layout.FixedBytes32Equal(
               predecessorPin.declarationTableCid,
               store.payloadDeclarationTableCids[0]) &&
           store.core.borrowCounts[publishedIndex] ==
               predecessorBorrowCount + 1,
           " semantic snapshot production smoke: predecessor pin split")
    assert(production.SemanticSnapshotProductionAcceptSourceEventInto(
               eventState, store, snapshot.SemanticSourceEventClose,
               documentCid, int64(-1),
               sourceVersion, err), err)
    assert(sourceVersion == int64(3),
           " semantic snapshot production smoke: close version split")
    var candidate2: production.SemanticSnapshotProductionCandidate
    sourceDocuments[0].clientVersion = int64(2)
    sourceDocuments[0].open = false
    tables.semanticEpoch = sourceVersion
    assert(production.SemanticSnapshotProductionCandidateMakeInto(
               receipt, csg, universe, compilerExecution, eventState,
               tables, sourceDocuments, candidate2, err), err)
    var stagedIndex2: int32
    assert(production.SemanticSnapshotProductionStageCandidateInto(
               store, candidate2, csg, universe, compilerExecution,
               stagedIndex2, err), err)
    var candidateBlockedPredecessorPin: production.SemanticSnapshotProductionPin
    assert(!production.SemanticSnapshotProductionStorePinPublishedPredecessorInto(
                store, sourceVersion, candidateBlockedPredecessorPin, err) &&
           !candidateBlockedPredecessorPin.active &&
           store.core.borrowCounts[publishedIndex] ==
               predecessorBorrowCount + 1,
           " semantic snapshot production smoke: staged predecessor pin mutated")
    var publishedIndex2: int32
    var reclaimSnapshotIndex2: int32
    production.SemanticSnapshotProductionCommitCandidateInto(
        store, stagedIndex2, publishedIndex2, reclaimSnapshotIndex2)
    assert(publishedIndex2 == 1 &&
           reclaimSnapshotIndex2 == -1 &&
           store.core.states[publishedIndex] ==
               snapshot.SemanticSnapshotStateRetired &&
           store.core.states[publishedIndex2] ==
               snapshot.SemanticSnapshotStatePublished,
           " semantic snapshot production smoke: version publish isolation")
    assert(production.SemanticSnapshotProductionPinnedSymbolIdentityInto(
               store, pin, functionSymbolId,
               pinnedSymbolCid, pinnedSourceId,
               pinnedSpanId, pinnedTypeId, pinnedSymbolKind, err), err)
    assert(pin.corePin.sourceVersion == int64(1) &&
           layout.FixedBytes32Equal(pinnedSymbolCid, publishedSymbolCid),
           " semantic snapshot production smoke: old pin changed version")
    var oldPinnedDebugFactBundle: debugfacts.DebugFactBundle
    assert(production.SemanticSnapshotProductionPinnedDebugFactsInto(
               store, pin, oldPinnedDebugFactBundle, err), err)
    assert(oldPinnedDebugFactBundle.sourceVersion == int64(1) &&
           layout.FixedBytes32Equal(
               oldPinnedDebugFactBundle.projectionCid,
               debugFactBundle.projectionCid),
           " semantic snapshot production smoke: old DebugFact pin changed version")
    var oldPinnedQueryProjection: query_projection.SemanticSnapshotQueryProjection
    assert(production.SemanticSnapshotProductionPinnedQueryProjectionInto(
               store, pin, oldPinnedQueryProjection, err), err)
    assert(oldPinnedQueryProjection.sourceVersion == int64(1) &&
           oldPinnedQueryProjection.documents[0].clientVersion == int64(1) &&
           oldPinnedQueryProjection.documents[0].open,
           " semantic snapshot production smoke: old query pin changed version")
    var predecessorQueryProjection: query_projection.SemanticSnapshotQueryProjection
    assert(production.SemanticSnapshotProductionPinnedQueryProjectionInto(
               store, predecessorPin, predecessorQueryProjection, err), err)
    assert(predecessorQueryProjection.sourceVersion == int64(1) &&
           layout.FixedBytes32Equal(
               predecessorQueryProjection.projectionCid,
               oldPinnedQueryProjection.projectionCid),
           " semantic snapshot production smoke: predecessor payload changed after commit")
    var forgedPin = pin
    forgedPin.payloadIndex =
        store.payloadIndexesBySnapshot[publishedIndex2]
    assert(!production.SemanticSnapshotProductionPinnedSymbolIdentityInto(
                store, forgedPin, functionSymbolId,
                pinnedSymbolCid, pinnedSourceId,
                pinnedSpanId, pinnedTypeId, pinnedSymbolKind, err),
           " semantic snapshot production smoke: forged payload row accepted")
    var rejectedDebugFactBundle: debugfacts.DebugFactBundle
    assert(!production.SemanticSnapshotProductionPinnedDebugFactsInto(
                store, forgedPin, rejectedDebugFactBundle, err),
           " semantic snapshot production smoke: forged DebugFact pin accepted")
    var currentPin: production.SemanticSnapshotProductionPin
    assert(production.SemanticSnapshotProductionStorePinCurrentInto(
               store, currentPin, err), err)
    assert(currentPin.corePin.sourceVersion == int64(3),
           " semantic snapshot production smoke: current pin version split")
    var currentQueryProjection: query_projection.SemanticSnapshotQueryProjection
    assert(production.SemanticSnapshotProductionPinnedQueryProjectionInto(
               store, currentPin, currentQueryProjection, err), err)
    assert(currentQueryProjection.sourceVersion == int64(3) &&
           currentQueryProjection.documents[0].clientVersion == int64(2) &&
           !currentQueryProjection.documents[0].open &&
           !layout.FixedBytes32Equal(
               currentQueryProjection.projectionCid,
               oldPinnedQueryProjection.projectionCid) &&
           !layout.FixedBytes32Equal(
               currentQueryProjection.queryIndex.indexCid,
               oldPinnedQueryProjection.queryIndex.indexCid),
           " semantic snapshot production smoke: current query version reused")
    var currentDebugFactBundle: debugfacts.DebugFactBundle
    assert(production.SemanticSnapshotProductionPinnedDebugFactsInto(
               store, currentPin, currentDebugFactBundle, err), err)
    assert(currentDebugFactBundle.sourceVersion == int64(3) &&
           !layout.FixedBytes32Equal(
               currentDebugFactBundle.projectionCid,
               oldPinnedDebugFactBundle.projectionCid),
           " semantic snapshot production smoke: current DebugFact version reused")
    assert(production.SemanticSnapshotProductionPinnedSymbolIdentityInto(
               store, currentPin, functionSymbolId,
               pinnedSymbolCid, pinnedSourceId,
               pinnedSpanId, pinnedTypeId, pinnedSymbolKind, err), err)
    assert(layout.FixedBytes32Equal(pinnedSymbolCid, publishedSymbolCid),
           " semantic snapshot production smoke: current SymbolId drift")
    assert(production.SemanticSnapshotProductionStoreReleasePinInto(
               store, predecessorPin, err), err)
    assert(store.core.states[publishedIndex] ==
               snapshot.SemanticSnapshotStateRetired &&
           store.core.borrowCounts[publishedIndex] == 1,
           " semantic snapshot production smoke: predecessor release skipped active pin")
    assert(production.SemanticSnapshotProductionStoreReleasePinInto(
               store, pin, err), err)
    assert(store.core.states[publishedIndex] ==
               snapshot.SemanticSnapshotStateReleased &&
           store.payloadIndexesBySnapshot[publishedIndex] == -1 &&
           store.payloadStates[0] ==
               production.SemanticSnapshotProductionPayloadReleased &&
           store.payloadTables[0].symbols.symbolCids.len == 0 &&
           store.payloadQueryProjections[0].documents.len == 0 &&
           layout.FixedBytes32Equal(
               store.payloadQueryProjectionCids[0], layout.FixedBytes32()) &&
           layout.FixedBytes32Equal(
               store.payloadQueryIndexCids[0], layout.FixedBytes32()) &&
           layout.FixedBytes32Equal(
               store.payloadQueryIndexRootCids[0],
               layout.FixedBytes32()) &&
           layout.FixedBytes32Equal(
               store.payloadDeclarationTableCids[0],
               layout.FixedBytes32()),
           " semantic snapshot production smoke: old payload retained")
    assert(!production.SemanticSnapshotProductionStoreReleasePinInto(
                store, pin, err),
           " semantic snapshot production smoke: double pin release accepted")
    assert(production.SemanticSnapshotProductionStoreReleasePinInto(
               store, currentPin, err), err)
    assert(production.SemanticSnapshotProductionAcceptSourceEventInto(
               eventState, store, snapshot.SemanticSourceEventOpen,
               documentCid, int64(3),
               sourceVersion, err), err)
    assert(sourceVersion == int64(4),
           " semantic snapshot production smoke: reopen version split")
    sourceDocuments[0].clientVersion = int64(3)
    sourceDocuments[0].open = true
    var candidate3: production.SemanticSnapshotProductionCandidate
    tables.semanticEpoch = sourceVersion
    assert(production.SemanticSnapshotProductionCandidateMakeInto(
               receipt, csg, universe, compilerExecution, eventState,
               tables, sourceDocuments, candidate3, err), err)
    var stagedIndex3: int32
    assert(production.SemanticSnapshotProductionStageCandidateInto(
               store, candidate3, csg, universe, compilerExecution,
               stagedIndex3, err), err)
    var publishedIndex3: int32
    var reclaimSnapshotIndex3: int32
    production.SemanticSnapshotProductionCommitCandidateInto(
        store, stagedIndex3, publishedIndex3, reclaimSnapshotIndex3)
    assert(publishedIndex3 == 2 &&
           reclaimSnapshotIndex3 == publishedIndex2 &&
           store.core.states[publishedIndex2] ==
               snapshot.SemanticSnapshotStateReleased &&
           store.payloadIndexesBySnapshot[publishedIndex2] == 1 &&
           store.payloadStates[1] ==
               production.SemanticSnapshotProductionPayloadPendingReclaim &&
           rawbytes.BytesLen(store.payloadCsgcBytes[1]) > 0 &&
           store.payloadTables[1].symbols.symbolCids.len > 0,
           " semantic snapshot production smoke: commit reclaimed old payload")
    assert(production.SemanticSnapshotProductionStoreStrictValidateInto(
               store, err), err)
    assert(production.SemanticSnapshotProductionStoreReclaimSnapshotInto(
               store, reclaimSnapshotIndex3, err), err)
    assert(store.payloadIndexesBySnapshot[publishedIndex2] == -1 &&
           store.payloadStates[1] ==
               production.SemanticSnapshotProductionPayloadReleased &&
           rawbytes.BytesLen(store.payloadCsgcBytes[1]) == 0 &&
           store.payloadTables[1].symbols.symbolCids.len == 0,
           " semantic snapshot production smoke: independent reclaim drift")
    var candidate4: production.SemanticSnapshotProductionCandidate
    tables.semanticEpoch = sourceVersion
    assert(production.SemanticSnapshotProductionCandidateMakeInto(
               receipt, csg, universe, compilerExecution, eventState,
               tables, sourceDocuments, candidate4, err), err)
    var cancelledStageIndex: int32
    assert(production.SemanticSnapshotProductionStageCandidateInto(
               store, candidate4, csg, universe, compilerExecution,
               cancelledStageIndex, err), err)
    let cancelledPayloadIndex =
        store.payloadIndexesBySnapshot[cancelledStageIndex]
    assert(production.SemanticSnapshotProductionAcceptSourceEventInto(
               eventState, store, snapshot.SemanticSourceEventChange,
               documentCid, int64(4),
               sourceVersion, err), err)
    assert(sourceVersion == int64(5) &&
           store.core.states[cancelledStageIndex] ==
               snapshot.SemanticSnapshotStateCancelled &&
           store.payloadIndexesBySnapshot[cancelledStageIndex] == -1 &&
           store.payloadStates[cancelledPayloadIndex] ==
               production.SemanticSnapshotProductionPayloadReleased &&
           rawbytes.BytesLen(
               store.payloadCsgcBytes[cancelledPayloadIndex]) == 0,
           " semantic snapshot production smoke: cancelled stage retained")
    var cancelledGapPredecessorPin: production.SemanticSnapshotProductionPin
    assert(production.SemanticSnapshotProductionStorePinPublishedPredecessorInto(
               store, sourceVersion, cancelledGapPredecessorPin, err), err)
    assert(cancelledGapPredecessorPin.corePin.sourceVersion == int64(4) &&
           store.core.candidateIndex == -1,
           " semantic snapshot production smoke: cancelled gap predecessor split")
    assert(production.SemanticSnapshotProductionStoreReleasePinInto(
               store, cancelledGapPredecessorPin, err), err)
    production.SemanticSnapshotProductionCandidateRelease(candidate)
    production.SemanticSnapshotProductionCandidateRelease(candidate2)
    production.SemanticSnapshotProductionCandidateRelease(candidate3)
    production.SemanticSnapshotProductionCandidateRelease(candidate4)
    assert(production.SemanticSnapshotProductionStoreStrictValidateInto(
               store, err), err)
    assert(production.SemanticSnapshotProductionStoreReleaseInto(
               store, err), err)
    declaration.SemanticSnapshotDeclarationTableReleaseInto(
        tables.declarations)
    os.WriteLine(os.Get_stdout(),
                 "semantic_snapshot_production_binding_smoke: ok")
