    var scalarTypeId: int32
    var signatureTypeId: int32 = 1
    if TestCidLess(signatureTypeCid, scalarTypeCid):
        tables.types.typeCids = [
            layout.FixedBytes32Copy(signatureTypeCid), scalarTypeCid]
        tables.types.producerTypeArenaIds = [-1, 0]
