        add(sortedManagedFlags, false)
        add(sortedManagedFlags, false)
        tables.types.managedFlags = sortedManagedFlags
        var sortedSendFlags: bool[]
        add(sortedSendFlags, false)
        add(sortedSendFlags, true)
        tables.types.sendFlags = sortedSendFlags
        var sortedSyncFlags: bool[]
        add(sortedSyncFlags, false)
        add(sortedSyncFlags, true)
        tables.types.syncFlags = sortedSyncFlags
        tables.types.traitConclusionKinds = [
