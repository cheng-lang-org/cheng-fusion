# Loopback QUIC bulk-transfer CPU bench — client half.
# Dials, receives the server's single payload, prints elapsed wall time so an
# external harness can compute throughput (KB/s) — pure per-packet CPU cost
# on loopback (RTT ~= 0), no MoQ/media layer involved.
import std/system
import std/cmdline as cmdline
import std/rawbytes
import std/strings
import std/strutils as strutil
import std/times
import cheng/libp2p/core/types
import cheng/libp2p/transports/quic_transport

fn main(): int32 =
    let port = cmdline.ReadInt32FlagOrDefault("--port", -1)
    assert(port > 0, " quicframe_bench_client: port")
    let startMs = times.MonotimeMs()
    let recvRes = quic_transport.Libp2pQuicRecvPayloadOnce("127.0.0.1",
                                                             port,
                                                             types.Libp2pProtocolSync)
    let endMs = times.MonotimeMs()
    assert(recvRes.ok, " quicframe_bench_client: recv failed")
    let n = rawbytes.BytesLen(recvRes.value)
    echo(strutil.Join(["quicframe_bench_client bytes=", IntToStr(n),
                        " elapsed_ms=", Int64ToStr(endMs - startMs)], ""))
    return 0
