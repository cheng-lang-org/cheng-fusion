import std/strutils as strutil
import std/os
import cheng/core/backend/system_link_exec as sexec
import cheng/core/backend/system_link_exec_runtime as runtime
import cheng/core/tooling/compiler_request as creq

fn main(): int32 =
    assert(sexec.SystemLinkExecPathHasSegmentSuffix(
               "/tmp/cheng/src/core/tooling/backend_driver_dispatch_min.cheng",
               "src/core/tooling/backend_driver_dispatch_min.cheng"),
           "system link current receipt: exact entry suffix rejected")
    assert(!sexec.SystemLinkExecPathHasSegmentSuffix(
                "/tmp/cheng/src/core/tooling/not_backend_driver_dispatch_min.cheng",
                "src/core/tooling/backend_driver_dispatch_min.cheng"),
           "system link current receipt: non-segment suffix accepted")
    var plan: sexec.SystemLinkExecPlan
    assert(!sexec.SystemLinkExecLinuxPassBCurrentReceiptRequest(
                "/tmp/cheng",
                plan),
           "system link current receipt: empty plan accepted")
    let savedNoHandoff =
        os.GetEnv("CHENG_NO_BACKEND_DRIVER_HANDOFF")
    os.SetEnv("CHENG_NO_BACKEND_DRIVER_HANDOFF", "1")
    plan.compilerEntrySource =
        "/tmp/cheng/src/core/tooling/backend_driver_dispatch_min.cheng"
    plan.requestEmitKind = creq.EmitExe
    plan.systemLinkPlan.emitKind = creq.EmitExe
    plan.systemLinkPlan.targetTriple =
        "x86_64-unknown-linux-gnu"
    plan.systemLinkPlan.outputPath =
        "/tmp/cheng/artifacts/bootstrap/compiler_main.direct.next"
    plan.compileReceipt.runtimeProviderSet =
        ["cheng/core/runtime"]
    assert(sexec.SystemLinkExecLinuxPassBCurrentReceiptRequest(
               "/tmp/cheng",
               plan),
           "system link current receipt: exact pass-B request rejected")
    plan.systemLinkPlan.outputPath =
        "/tmp/cheng/artifacts/bootstrap/compiler_main.direct.next.other"
    assert(!sexec.SystemLinkExecLinuxPassBCurrentReceiptRequest(
                "/tmp/cheng",
                plan),
           "system link current receipt: output identity suffix drift accepted")
    os.SetEnv("CHENG_NO_BACKEND_DRIVER_HANDOFF",
              savedNoHandoff)
    var result: runtime.SystemLinkExecRuntimeResult
    var report: str
    var err: str
    assert(!runtime.SystemLinkExecRuntimeLinuxPassBCurrentReceiptReportInto(
                report,
                err,
                "/tmp/cheng",
                plan,
                result) &&
           len(report) == 0 &&
           strutil.Contains(err, "request mismatch"),
           "system link current receipt: non-request did not hard-fail")
    echo("system_link_exec_current_receipt_authority_smoke=ok")
    return 0
