# RSA-PSS(SHA256) aarch64 verify probe.
# 目标：在 aarch64-linux-android 真机上定位 TLS 1.3 客户端验证 RSA 证书
# CertificateVerify 的缺口。内嵌 openssl 生成的固定 RSA-2048 测试密钥与签名：
#   1. pkcs8 私钥 DER（openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048）
#   2. PKCS#1 公钥 DER（openssl rsa -RSAPublicKey_out）
#   3. openssl 生成的 RSA-PSS(SHA256, saltlen=32) 签名（openssl dgst -sha256
#      -sigopt rsa_padding_mode:pss -sigopt rsa_pss_saltlen:32 -sign）
# 验证链：cheng 签名 → cheng 自验；openssl 签名 → cheng 验签（交叉验证）；
# 篡改签名 → 必须拒绝。rc 区分各失败点。
import std/system
import std/result
import std/rawbytes
import std/strutils as strutil
import std/crypto/rsa as rsacrypto

fn probePkcs8Hex(): str =
    return ""

fn probePubPk1Hex(): str =
    return ""

fn probeMsgHex(): str =
    return "6368656e6720727361207073732070726f6265206d6573736167650a"

fn probeOpensslSigHex(): str =
    return ""

# openssl dgst -sha384 -sigopt rsa_padding_mode:pss -sigopt rsa_pss_saltlen:48
fn probeOpensslSig384Hex(): str =
    return ""

fn main(): int32 =
    echo("rsa_pss_aarch64_verify_probe: start")
    let pk8Res: Result[Bytes] = rsacrypto.rsaHexDecode(probePkcs8Hex())
    if IsErr(pk8Res):
        echo(strutil.Join(["probe: hex decode pkcs8 err=", ErrorText(pk8Res)], ""))
        return 10
    let pk8: Bytes = Value(pk8Res)
    let pubRes: Result[Bytes] = rsacrypto.rsaHexDecode(probePubPk1Hex())
    if IsErr(pubRes):
        echo(strutil.Join(["probe: hex decode public err=", ErrorText(pubRes)], ""))
        return 11
    let pubPk1: Bytes = Value(pubRes)
    let msgRes: Result[Bytes] = rsacrypto.rsaHexDecode(probeMsgHex())
    if IsErr(msgRes):
        echo(strutil.Join(["probe: hex decode msg err=", ErrorText(msgRes)], ""))
        return 12
    let msg: Bytes = Value(msgRes)
    let ossSigRes: Result[Bytes] = rsacrypto.rsaHexDecode(probeOpensslSigHex())
    if IsErr(ossSigRes):
        echo(strutil.Join(["probe: hex decode sig err=", ErrorText(ossSigRes)], ""))
        return 13
    let opensslSig: Bytes = Value(ossSigRes)
    echo(strutil.Join(["probe: hex ok pkcs8_len=", IntToStr(BytesLen(pk8)),
                       " pub_len=", IntToStr(BytesLen(pubPk1)),
                       " msg_len=", IntToStr(BytesLen(msg)),
                       " oss_sig_len=", IntToStr(BytesLen(opensslSig))], ""))

    var nBytes: Bytes
    var eBytes: Bytes
    let pubParseRes: Result[bool] = rsacrypto.rsaBigPublicKeyBytesInto(pubPk1, nBytes, eBytes)
    if IsErr(pubParseRes):
        echo(strutil.Join(["probe: public key parse err=", ErrorText(pubParseRes)], ""))
        return 20
    echo(strutil.Join(["probe: public key ok n_len=", IntToStr(BytesLen(nBytes)),
                       " e_len=", IntToStr(BytesLen(eBytes))], ""))

    let sigRes: Result[Bytes] = rsacrypto.rsaBigSignPssBytes(pk8, msg, false)
    if IsErr(sigRes):
        echo(strutil.Join(["probe: cheng pss sign err=", ErrorText(sigRes)], ""))
        return 30
    let chengSig: Bytes = Value(sigRes)
    if BytesLen(chengSig) <= 0 || BytesLen(chengSig) > 256:
        echo(strutil.Join(["probe: cheng pss sign bad len=", IntToStr(BytesLen(chengSig))], ""))
        return 31
    echo(strutil.Join(["probe: cheng pss sign ok len=", IntToStr(BytesLen(chengSig))], ""))

    let selfRes: Result[bool] = rsacrypto.rsaVerifyPssBytes(nBytes, eBytes, msg, chengSig, false)
    if IsErr(selfRes):
        echo(strutil.Join(["probe: cheng self verify err=", ErrorText(selfRes)], ""))
        return 40
    if ! Value(selfRes):
        echo("probe: cheng self verify false")
        return 41
    echo("probe: cheng self verify ok")

    let crossRes: Result[bool] = rsacrypto.rsaVerifyPssBytes(nBytes, eBytes, msg, opensslSig, false)
    if IsErr(crossRes):
        echo(strutil.Join(["probe: openssl sig verify err=", ErrorText(crossRes)], ""))
        return 50
    if ! Value(crossRes):
        echo("probe: openssl sig verify false")
        return 51
    echo("probe: openssl sig verify ok")

    # SHA-384 PSS 臂（scheme 0x0805，cipher 为 SHA384 族时服务端 CertificateVerify 用它）
    let sig384Res: Result[Bytes] = rsacrypto.rsaHexDecode(probeOpensslSig384Hex())
    if IsErr(sig384Res):
        echo("probe: hex decode sig384 err")
        return 52
    let opensslSig384: Bytes = Value(sig384Res)
    let cross384Res: Result[bool] = rsacrypto.rsaVerifyPssBytes(nBytes, eBytes, msg, opensslSig384, true)
    if IsErr(cross384Res):
        echo(strutil.Join(["probe: openssl sig384 verify err=", ErrorText(cross384Res)], ""))
        return 53
    if ! Value(cross384Res):
        echo("probe: openssl sig384 verify false")
        return 54
    echo("probe: openssl sig384 verify ok")
    let sign384Res: Result[Bytes] = rsacrypto.rsaBigSignPssBytes(pk8, msg, true)
    if IsErr(sign384Res):
        echo(strutil.Join(["probe: cheng pss384 sign err=", ErrorText(sign384Res)], ""))
        return 55
    let self384Res: Result[bool] = rsacrypto.rsaVerifyPssBytes(nBytes, eBytes, msg, Value(sign384Res), true)
    if IsErr(self384Res):
        echo(strutil.Join(["probe: cheng self384 verify err=", ErrorText(self384Res)], ""))
        return 56
    if ! Value(self384Res):
        echo("probe: cheng self384 verify false")
        return 57
    echo("probe: cheng pss384 sign+self verify ok")

    var badSig: Bytes = BytesAlloc(BytesLen(opensslSig))
    for i in 0..<BytesLen(opensslSig):
        BytesSet(badSig, i, BytesGet(opensslSig, i))
    BytesSet(badSig, 0, BytesGet(opensslSig, 0) ^ 0x01)
    let badRes: Result[bool] = rsacrypto.rsaVerifyPssBytes(nBytes, eBytes, msg, badSig, false)
    if IsErr(badRes):
        echo("probe: tampered sig rejected (err)")
    else:
        if Value(badRes):
            echo("probe: tampered sig ACCEPTED")
            return 60
        echo("probe: tampered sig rejected (false)")

    echo("rsa_pss_aarch64_verify_probe ok")
    return 0
