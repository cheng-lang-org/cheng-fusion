type
    ColdExactUniqueBorrowOverwriteBox =
        values: str[]

fn ColdExactUniqueBorrowOverwriteSwap(values: var str[]) =
    let first = values[0]
    values[0] = values[1]
    values[1] = first

fn main(): int32 =
    var box = ColdExactUniqueBorrowOverwriteBox()
    add(box.values, "right")
    add(box.values, "left")
    var values = box.values
    box = ColdExactUniqueBorrowOverwriteBox()
    ColdExactUniqueBorrowOverwriteSwap(values)
    return 0
