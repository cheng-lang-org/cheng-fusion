import std/multiformats/multibase as mb

fn main(): int32 =
    if mb.base32zValue('y') != 0:
        return 1
    if mb.base32zValue('r') != 4:
        return 2
    if mb.base32zValue('z') != 23:
        return 3
    if mb.base32zValue('9') != 31:
        return 4
    if mb.base32zValue('A') != -1:
        return 5
    return 0
