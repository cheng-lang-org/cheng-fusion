import std/system

fn ColdBorrowRootWrite(value: var str) =
    value = "updated"

@borrows
@borrow_result
fn ColdBorrowRootView(value: var str): str =
    return value

fn ColdBorrowRootRelay(value: var str): int32 =
    ColdBorrowRootWrite(value)
    let borrowed = ColdBorrowRootView(value)
    if borrowed != "updated":
        return 11
    return len(borrowed)

fn main(): int32 =
    var value: str
    if ColdBorrowRootRelay(value) != 7:
        return 12
    if value != "updated":
        return 13
    echo("cold_borrow_result_var_root_after_var_out=pass")
    return 0
