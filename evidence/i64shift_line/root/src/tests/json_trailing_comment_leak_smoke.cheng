# bail=709/707 //-注释词法泄漏根修回归夹具 (族 E, w12b-eE)。
#
# 根因: Cheng 词法只认 '#' 做行内尾随注释 (parser.cheng:2702 ParserStripLineComment,
# quote-aware 逐字符只匹配 '#')。"//" 不是语言承认的注释符; "代码 // 注释" 这种写法里的
# "// 注释" 原样残留进 stmt.surfaceText, typed_expr.cheng:22658 顶层 '+' 文本切分
# (TypedExprFindTopLevelTextToken) 把注释一起切进右操作数, 下游按文本找值槽的解析器在
# "4  // skip 4 hex digits" 这坨垃圾文本上失败, 求值槽落空 (-1), 最终落
# primary_object_plan.cheng 的 709 (rhs 纯标量/字面量) 或 707 (rhs 含调用) 兜底出口——
# 707/709 是同一 "// 注释泄漏进顶层 + 切分右操作数" 机制在两种不同 RHS 形状下的表现,
# 不是两个独立缺陷 (案卷 2.3 节已交叉核对)。
#
# 已根修两处 (json.cheng, 逐字节改 "//" 注释符为 "#", 未改动任何其它字符):
#   :790 jsonParseRawString  `scanPos = scanPos + 4  // skip 4 hex digits`   (触发 709)
#   :533 jsonPrettyStringifiedLenDepth
#        `total = total + jsonQuotedLen(node.okeys[i]) + 2  // ": "`         (触发 707)
#
# 本夹具用与两处修复行逐字节同形的独立最小函数做机制级回归 (不依赖 json.cheng 本身,
# 因为 jsonParseRawString 模块私有不可跨模块调用, 而任何 import std/json 目前都会因
# json.cheng 内其它三个与本族无关的 pre-existing 缺口——jsonParseArray bail=801 failCode=4
# 非构造器返回值 / jsonParseValue bail=93 前向声明桩误判 / JsonNode 类型关联的
# jsonStringifiedLenDepth+jsonWriteNodeDepth+panicCString 反而随之被强制纳入闭包——
# 导致整个 --emit:exe 编译失败, rc=2, 与本次 "//" 注释修复无关, 已实测复现留证,
# 详见 scratchpad/w12b-eE-evidence.md)。
#
# json.cheng:790/:533 本身的修复已用两套独立证据钉死 (完整命令与输出见
# scratchpad/w12b-eE-evidence.md):
#   1) unimaker_compat_ffi 真实 feed 闭包 census: missing 23→22 (jsonParseRawString 消失);
#   2) json.cheng 单文件 --emit:obj 全量 census: 19→17 (两函数同时消失), 且把 :533 单独
#      改回 "//" 会精确重现 707 (17→18, 命中同一 jsonPrettyStringifiedLenDepth/:533),
#      验证了修复与故障的一一对应 (mutation 验真);
#   3) 隔离树内把 jsonParseRawString 直接接成程序入口 (同模块可见性下真跑),
#      对含转义引号 (\") 与 \u 十六进制转义的字符串解出正确值 (a"bABC), exit 0;
#      故意改期望值验证非重言 (exit 2), 修复前该 main 编译期直接 bail=709 (rc=2)。

fn advanceScalar(x: int32): int32 =
    var scanPos: int32 = x
    scanPos = scanPos + 4  # skip 4 hex digits (与 json.cheng:790 逐字节同形)
    return scanPos

fn quotedLenStub(keyLen: int32): int32 =
    return keyLen

fn advanceWithCall(total: int32, keyLen: int32): int32 =
    var t: int32 = total
    t = t + quotedLenStub(keyLen) + 2  # ": " (与 json.cheng:533 逐字节同形: call+字面量+尾随注释)
    return t

fn expect(cond: bool, code: int32): int32 =
    if !cond:
        return code
    return 0

fn main(): int32 =
    # 与 :790 同形: 局部标量 "x = x + 字面量  # 注释" (原先是 "//", 触发 709)。
    if expect(advanceScalar(10) == 14, 1) != 0:
        return 1
    if expect(advanceScalar(0) == 4, 2) != 0:
        return 2

    # 与 :533 同形: "total = total + call(...) + 字面量  # 注释" (原先是 "//", 触发 707,
    # 因为 RHS 顶层第一个 '+' 之后紧跟一次调用, primary_object_plan 判定走的是含调用分支)。
    if expect(advanceWithCall(0, 5) == 7, 3) != 0:
        return 3
    if expect(advanceWithCall(100, 12) == 114, 4) != 0:
        return 4

    return 0
