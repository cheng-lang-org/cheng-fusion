import cheng/core/lang/intern as langintern

type IdWrap[T] = Wrap(ids: langintern.InternId[]) | Scalar(v: T)

fn main(): int32 =
    let e: IdWrap[int32] = Wrap([4, 5])
    match e:
        Wrap(ids) =>
            if ids.len != 2:
                return 21
            return ids[0] + ids[1] - 9
        Scalar(v) =>
            return v

main()
