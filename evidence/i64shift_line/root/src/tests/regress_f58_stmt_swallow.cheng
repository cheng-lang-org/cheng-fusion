# regress_f58_stmt_swallow — form58 / T7 巨函数规模枚举吞语句回归
#
# 来源案卷:
#   - cheng-f24/diag_T7/repro_verbatim.cheng（整段誊抄 parser.cheng
#     ParserAppendMemberCallExprsLine3；依赖函数仅保签名）
#   - cheng-f24/diag_F58/REPORT_F58.md（根因定谳与断言口径）
#
# 缺陷: TypedExprIrAppendLocalDeclStatementsForScope 对裸枚举常量 RHS
# (`var directKind = NormalizedExprSurfaceCallNone`) 定型失败后 continue
# 丢 LocalDecl；深层 else 又不被 unrepresented-repair 补回 → 栈槽无 #0
# 初始化就被 ==None/!=None 比较读取。
#
# 根修: continue 前补 TypedExprLookupEnumConstType 三行（form58）。
#
# 断言口径（静态反汇编，不需运行产物）:
#   1) 定位目标函数 ParserAppendMemberCallExprsLine3
#   2) 找同时有 #0x3(Importc)/#0x1(Local) 条件写的栈槽 = directKind
#   3) 该槽在两处比较 ldr 之前须有无条件 mov #0 / str 初始化
#   PASS = 有 #0 初始化；FAIL = 缺失（提示 form58 未回灌）
#
# 本夹具自包含，无 f24 绝对路径依赖。

type
    ParsedSourceKind = enum
        ParsedOrdinarySource

    ParserExternalPackageRoot =
        packageId: str
        packageRoot: str
        channel: str

    ImportEdge =
        ownerModulePath: str
        targetModulePath: str
        targetSourcePath: str
        targetSourcePathLen: int32
        targetSourcePathFirstCode: int32
        targetSourcePathLastCode: int32
        targetSourcePathDotCount: int32
        targetSourcePathHash: int32
        targetProfileIndex: int32
        importAlias: str
        qualifier: str
        allowsUnqualifiedCall: bool
        resolved: bool

    NormalizedExprKind = enum
        NormalizedExprIf
        NormalizedExprRange
        NormalizedExprComprehension
        NormalizedExprStrFormat
        NormalizedExprResultIntrinsic
        NormalizedExprCall
        NormalizedExprTry
        NormalizedExprDefaultInit
        NormalizedExprConstructor
        NormalizedExprReturn
        NormalizedExprAssign
        NormalizedExprIfStmt
        NormalizedExprElifStmt
        NormalizedExprElseStmt
        NormalizedExprForStmt
        NormalizedExprMatchStmt
        NormalizedExprCaseStmt
        NormalizedExprWhileStmt

    NormalizedExprDetailKind = enum
        NormalizedExprDetailNone
        NormalizedExprDetailIfKeyword
        NormalizedExprDetailIfTernary
        NormalizedExprDetailTryPostfixQuestion
        NormalizedExprDetailRangeInclusive
        NormalizedExprDetailRangeExclusive
        NormalizedExprDetailComprehensionList
        NormalizedExprDetailStrFormatLiteral
        NormalizedExprDetailStrFormatCall
        NormalizedExprDetailResultOk
        NormalizedExprDetailResultErr
        NormalizedExprDetailResultValue
        NormalizedExprDetailResultError
        NormalizedExprDetailResultIsOk
        NormalizedExprDetailResultIsErr
        NormalizedExprDetailResultErrorInfoOf

    NormalizedExprSurfaceCallKind = enum
        NormalizedExprSurfaceCallNone
        NormalizedExprSurfaceCallLocal
        NormalizedExprSurfaceCallExternal
        NormalizedExprSurfaceCallImportc
        NormalizedExprSurfaceCallMember

    NormalizedExprCallReason = enum
        NormalizedExprCallReasonNone
        NormalizedExprCallReasonUnknownQualifiedTarget
        NormalizedExprCallReasonShadowedQualifiedTarget
        NormalizedExprCallReasonAmbiguousExternalTarget
        NormalizedExprCallReasonAmbiguousQualifiedTarget
        NormalizedExprCallReasonUnknownExternalTarget
        NormalizedExprCallReasonUnknownCallTarget

    NormalizedExpr =
        exprId: str
        sourcePath: str
        lineNumber: int32
        columnNumber: int32
        endLineNumber: int32
        endColumnNumber: int32
        kind: NormalizedExprKind
        detailKind: NormalizedExprDetailKind
        surfaceText: str
        callSurfaceKind: NormalizedExprSurfaceCallKind
        callResolved: bool
        callReason: NormalizedExprCallReason
        callQualifier: str
        callCallee: str
        callTarget: str
        callTargetSourcePath: str
        callTargetImportc: bool
        callPrefixStyle: bool
        callArgCount: int32
        callArgsText: str

    NormalizedExprLookupBucket =
        sourcePathLen: int32
        sourcePathFirstCode: int32
        sourcePathLastCode: int32
        lineNumber: int32
        columnNumber: int32
        kindCode: int32
        detailCode: int32
        surfaceLen: int32
        surfaceFirstCode: int32
        surfaceLastCode: int32
        head: int32
        pad: int32

    NormalizedExprLookupKey =
        sourcePathLen: int32
        sourcePathFirstCode: int32
        sourcePathLastCode: int32
        lineNumber: int32
        columnNumber: int32
        kindCode: int32
        detailCode: int32
        surfaceLen: int32
        surfaceFirstCode: int32
        surfaceLastCode: int32

    NormalizedExprLookup =
        slots: int32[]
        buckets: NormalizedExprLookupBucket[]

    NormalizedExprLayer =
        sourceCount: int32
        exprs: NormalizedExpr[]
        exprNext: int32[]
        questionResidualCount: int32
        exprLookup: NormalizedExprLookup

    NormalizedExprLayerKindCounts =
        exprCount: int32
        ifCount: int32
        rangeCount: int32
        comprehensionCount: int32
        strFormatCount: int32
        resultIntrinsicCount: int32
        callCount: int32
        tryCount: int32
        defaultInitCount: int32
        constructorCount: int32
        returnCount: int32
        assignCount: int32
        ifStmtCount: int32
        elifStmtCount: int32
        elseStmtCount: int32
        forStmtCount: int32
        matchStmtCount: int32
        caseStmtCount: int32
        whileStmtCount: int32

    ParsedSourceStub =
        workspaceRoot: str
        packageRoot: str
        packageId: str
        entrySourcePath: str
        sourcePath: str
        moduleStem: str
        syntaxTag: str
        sourceKind: ParsedSourceKind
        ownerModulePaths: str[]
        importEdges: ImportEdge[]
        orderedClosureSourcePaths: str[]
        normalizedExprLayer: NormalizedExprLayer
        hasCompilerTopLevel: bool
        mainFunctionPresent: bool
        unresolvedImportCount: int32

    NormalizedFunctionDecl =
        name: str
        lineIndex: int32
        importc: bool
        explicitExportName: str
        surfaceKeyword: str
        ffiMapPtrArg: int32
        ffiMapLenArg: int32
        ffiOutPtrArgs: str
        abiInternal: bool
        ffiOwnedResultPresent: bool
        ffiOwnedResultFree: str

    NormalizedTypeDecl =
        name: str
        refObject: bool

    NormalizedExprCallProfile =
        sourcePath: str
        ownerModulePath: str
        text: str
        lines: str[]
        decls: NormalizedFunctionDecl[]
        typeDecls: NormalizedTypeDecl[]
        importcCallNames: str[]
        localCallNames: str[]
        importEdges: ImportEdge[]
        maxQualifiedCallDepth: int32

    NormalizedExprResolvedCallTarget =
        sourcePath: str
        importc: bool
        reason: NormalizedExprCallReason

    ParserImportedTargetLookup =
        targetProfileIndex: int32
        reason: NormalizedExprCallReason

    ParserTextSeqCacheEntry =
        profileIndex: int32
        items: str[]

    ParserQualifiedTextSeqCacheEntry =
        profileIndex: int32
        prefix: str
        items: str[]

    ParserTextLookupKey =
        keyLen: int32
        firstCode: int32
        lastCode: int32
        dotCount: int32
        textHash: int32

    ParserTextLookupBucket =
        keyLen: int32
        firstCode: int32
        lastCode: int32
        dotCount: int32
        textHash: int32
        items: str[]

    ParserTextLookup =
        slots: int32[]
        buckets: ParserTextLookupBucket[]
        totalCount: int32

    ParserSourcePathIndexEntry =
        sourcePath: str
        profileIndex: int32

    ParserSourcePathIndexBucket =
        keyLen: int32
        firstCode: int32
        lastCode: int32
        dotCount: int32
        sourcePathHash: int32
        items: ParserSourcePathIndexEntry[]

    ParserSourcePathIndexLookup =
        slots: int32[]
        buckets: ParserSourcePathIndexBucket[]

type
    ParserProfileCallLookupCacheEntry =
        localLookup: ParserTextLookup
        importcLookup: ParserTextLookup

# ---- 同签名 stub (誊抄铁律: 依赖函数只保证签名/类型一致, 逻辑内容不
# 影响本次要测的 codegen 现象 —— 目标函数自身的巨函数/嵌套 for+break/
# 深层 if-elif 栈布局才是变量, helper 内部逻辑不是) ----

@borrows
fn ParserQuoteIsEscaped(textRaw: str, indexRaw: int32): bool =
    return false

fn ParserIsIdentChar(ch: char): bool =
    let digit = ch >= '0' && ch <= '9'
    let upper = ch >= 'A' && ch <= 'Z'
    let lower = ch >= 'a' && ch <= 'z'
    return digit || upper || lower || ch == '_'

fn ParserPreviousTokenIsDeclKeyword(lineRaw: str, stopExclusive: int32): bool =
    return false

fn ParserSkipInlineSpaces(lineRaw: str, start: int32): int32 =
    return start

@borrows
fn ParserTextSliceFast(text: str, startRaw: int32, countRaw: int32): str =
    return share(text)

fn ParserCallExprUsesDedicatedNormalization(callNameRaw: str): bool =
    return false

fn ParserConcat3(a: str, b: str, c: str): str =
    return a

fn ParserQualifiedTargetQualifierChainExact(target: str): str =
    return target

fn ParserQualifiedTargetShadowReasonExact(currentProfile: NormalizedExprCallProfile,
                                            lineNumber: int32,
                                            target: str): NormalizedExprCallReason =
    return NormalizedExprCallReasonNone

fn ParserMatchKnownCallSurfaceTextBorrowed3(localCallLookup: var ParserTextLookup,
                                             externalCallLookup: var ParserTextLookup,
                                             importcCallLookup: var ParserTextLookup,
                                             callName: str,
                                             qualifiedCallName: str,
                                             dottedCallName: str): str =
    return ""

fn ParserResolvedCallTargetEmpty(): NormalizedExprResolvedCallTarget =
    var t: NormalizedExprResolvedCallTarget
    return t

fn ParserQualifiedTargetRootQualifierExact(target: str): str =
    return target

fn ParserProfileHasImportQualifier(profile: NormalizedExprCallProfile, qualifierRaw: str): bool =
    return false

fn ParserResolveCallTarget(currentProfile: NormalizedExprCallProfile,
                             profiles: NormalizedExprCallProfile[],
                             profileIndexLookup: ParserSourcePathIndexLookup,
                             profileCallLookupCache: var ParserProfileCallLookupCacheEntry[],
                             detailKind: NormalizedExprSurfaceCallKind,
                             targetRaw: str,
                             calleeRaw: str): NormalizedExprResolvedCallTarget =
    var t: NormalizedExprResolvedCallTarget
    return t

fn ParserCallSurfaceFromOpenParen(lineRaw: str,
                                    openPos: int32,
                                    callArgsTextOut: var str,
                                    callArgCountOut: var int32,
                                    endColumnOut: var int32): bool =
    callArgsTextOut = ""
    callArgCountOut = 0
    endColumnOut = -1
    return false

fn NormalizedExprLayerAppendCall(layer: var NormalizedExprLayer,
                                   sourcePath: str,
                                   lineNumber: int32,
                                   columnNumber: int32,
                                   surfaceText: str,
                                   callSurfaceKind: NormalizedExprSurfaceCallKind,
                                   callResolved: bool,
                                   callReason: NormalizedExprCallReason,
                                   callQualifier: str,
                                   callCallee: str,
                                   callTarget: str,
                                   callTargetSourcePath: str,
                                   callTargetImportc: bool,
                                   callArgsText: str,
                                   callArgCount: int32,
                                   callPrefixStyle: bool,
                                   endColumnNumberRaw: int32) =
    layer.sourceCount = layer.sourceCount + 1

fn ParserCallNameIsBuiltinCallee(callNameRaw: str): bool =
    return false

fn ParserImportEdgeTargetProfileIndex(edge: ImportEdge,
                                        profileIndexLookup: ParserSourcePathIndexLookup): int32 =
    return edge.targetProfileIndex

@borrows
fn ParserNormalizePath(pathRaw: str): str =
    return share(pathRaw)

fn ParserResolveUnqualifiedExternalCallTarget(currentProfile: NormalizedExprCallProfile,
                                                profiles: NormalizedExprCallProfile[],
                                                profileIndexLookup: ParserSourcePathIndexLookup,
                                                profileCallLookupCache: var ParserProfileCallLookupCacheEntry[],
                                                calleeRaw: str): NormalizedExprResolvedCallTarget =
    var t: NormalizedExprResolvedCallTarget
    return t

# ---- 目标函数: parser.cheng:5222-5527 一字不改整段誊抄 ----

fn ParserAppendMemberCallExprsLine3(sourcePath: str,
                                      lineNumber: int32,
                                      lineRaw: str,
                                      localCallLookup: var ParserTextLookup,
                                      externalCallLookup: var ParserTextLookup,
                                      importcCallLookup: var ParserTextLookup,
                                      currentProfile: NormalizedExprCallProfile,
                                      profiles: NormalizedExprCallProfile[],
                                      profileIndexLookup: ParserSourcePathIndexLookup,
                                      profileCallLookupCache: var ParserProfileCallLookupCacheEntry[],
                                      layer: var NormalizedExprLayer) =
    var knownCount: int32 = localCallLookup.totalCount
    knownCount = knownCount + externalCallLookup.totalCount
    knownCount = knownCount + importcCallLookup.totalCount
    knownCount = knownCount + currentProfile.localCallNames.len
    knownCount = knownCount + currentProfile.importcCallNames.len
    if knownCount <= 0:
        return
    var i: int32
    var inString = false
    var inChar = false
    while i < lineRaw.len:
        let ch = lineRaw[i]
        if !inChar:
            if ch == Char(34):
                if !ParserQuoteIsEscaped(lineRaw, i):
                    inString = !inString
                    i = i + 1
                    continue
        if !inString:
            if ch == Char(39):
                if !ParserQuoteIsEscaped(lineRaw, i):
                    inChar = !inChar
                    i = i + 1
                    continue
        if inString:
            i = i + 1
            continue
        if inChar:
            i = i + 1
            continue
        if ch == Char(35):
            break
        if !ParserIsIdentChar(ch):
            i = i + 1
            continue
        let start = i
        var stop = i
        while stop < lineRaw.len:
            if !ParserIsIdentChar(lineRaw[stop]):
                break
            stop = stop + 1
        if ParserPreviousTokenIsDeclKeyword(lineRaw, start):
            i = stop
            continue
        let nextPos = ParserSkipInlineSpaces(lineRaw, stop)
        var hasCallParen = false
        if nextPos < lineRaw.len:
            hasCallParen = lineRaw[nextPos] == '('
        if !hasCallParen:
            i = stop
            continue
        let callName = ParserTextSliceFast(lineRaw, start, stop - start)
        if ParserCallExprUsesDedicatedNormalization(callName):
            i = stop
            continue
        var qualifierStart: int32 = -1
        var qualifierStop: int32 = -1
        var dottedStart: int32 = start
        if start > 1:
            let prevDotPos: int32 = start - 1
            if lineRaw[prevDotPos] == '.':
                qualifierStop = prevDotPos
                qualifierStart = prevDotPos
                while qualifierStart > 0:
                    let prevPos = qualifierStart - 1
                    if !ParserIsIdentChar(lineRaw[prevPos]):
                        break
                    qualifierStart = prevPos
                dottedStart = qualifierStart
                var scanningQualifierChain = true
                while scanningQualifierChain:
                    if dottedStart <= 1:
                        scanningQualifierChain = false
                    else:
                        let prevDot = dottedStart - 1
                        if lineRaw[prevDot] != '.':
                            scanningQualifierChain = false
                        else:
                            var prevStart = prevDot
                            while prevStart > 0:
                                let prevPos = prevStart - 1
                                if !ParserIsIdentChar(lineRaw[prevPos]):
                                    break
                                prevStart = prevPos
                            if prevStart < prevDot:
                                dottedStart = prevStart
                            else:
                                scanningQualifierChain = false
        var dottedCallName = callName
        var qualifiedCallName = callName
        var qualifierText = ""
        if qualifierStart >= 0:
            if qualifierStop > qualifierStart:
                qualifierText = ParserTextSliceFast(lineRaw, qualifierStart, qualifierStop - qualifierStart)
                qualifiedCallName = ParserConcat3(qualifierText, ".", callName)
        if dottedStart < start:
            dottedCallName = ParserTextSliceFast(lineRaw, dottedStart, stop - dottedStart)
            qualifierText = ParserQualifiedTargetQualifierChainExact(dottedCallName)
        if dottedCallName != callName:
            let shadowReason = ParserQualifiedTargetShadowReasonExact(currentProfile,
                                                                        lineNumber,
                                                                        dottedCallName)
            let matchedKnownCall = ParserMatchKnownCallSurfaceTextBorrowed3(localCallLookup,
                                                                             externalCallLookup,
                                                                             importcCallLookup,
                                                                             callName,
                                                                             qualifiedCallName,
                                                                             dottedCallName)
            var appendUnresolved = false
            var appendResolvedExternal = false
            var resolvedExternalTarget = ParserResolvedCallTargetEmpty()
            if shadowReason != NormalizedExprCallReasonNone:
                appendUnresolved = true
            if matchedKnownCall == "" && shadowReason == NormalizedExprCallReasonNone:
                let rootQualifier = ParserQualifiedTargetRootQualifierExact(dottedCallName)
                let qualifierIsImport = ParserProfileHasImportQualifier(currentProfile, rootQualifier)
                if qualifierIsImport:
                    resolvedExternalTarget = ParserResolveCallTarget(currentProfile,
                                                                      profiles,
                                                                      profileIndexLookup,
                                                                      profileCallLookupCache,
                                                                      NormalizedExprSurfaceCallExternal,
                                                                      dottedCallName,
                                                                      callName)
                    if resolvedExternalTarget.sourcePath != "":
                        appendResolvedExternal = true
                    else:
                        appendUnresolved = true
                else:
                    appendUnresolved = true
            if appendResolvedExternal || appendUnresolved:
                var reasonText = NormalizedExprCallReasonUnknownQualifiedTarget
                if shadowReason != NormalizedExprCallReasonNone:
                    reasonText = shadowReason
                var unresolvedSurfaceKind = NormalizedExprSurfaceCallMember
                if appendResolvedExternal:
                    reasonText = NormalizedExprCallReasonNone
                    unresolvedSurfaceKind = NormalizedExprSurfaceCallExternal
                elif resolvedExternalTarget.reason != NormalizedExprCallReasonNone:
                    reasonText = resolvedExternalTarget.reason
                    if ParserProfileHasImportQualifier(currentProfile, ParserQualifiedTargetRootQualifierExact(dottedCallName)):
                        unresolvedSurfaceKind = NormalizedExprSurfaceCallExternal
                elif shadowReason == NormalizedExprCallReasonNone &&
                     ParserProfileHasImportQualifier(currentProfile, ParserQualifiedTargetRootQualifierExact(dottedCallName)):
                    unresolvedSurfaceKind = NormalizedExprSurfaceCallExternal
                var callArgsText = ""
                var callArgCount: int32
                var endColumnNumber: int32 = -1
                let callSurfaceOk = ParserCallSurfaceFromOpenParen(lineRaw,
                                                                     nextPos,
                                                                     callArgsText,
                                                                     callArgCount,
                                                                     endColumnNumber)
                let _ = callSurfaceOk
                NormalizedExprLayerAppendCall(layer,
                                                sourcePath,
                                                lineNumber,
                                                start + 1,
                                                dottedCallName,
                                                unresolvedSurfaceKind,
                                                appendResolvedExternal,
                                                reasonText,
                                                qualifierText,
                                                callName,
                                                dottedCallName,
                                                resolvedExternalTarget.sourcePath,
                                                resolvedExternalTarget.importc,
                                                callArgsText,
                                                callArgCount,
                                                false,
                                                endColumnNumber)
        else:
            var directKind = NormalizedExprSurfaceCallNone
            var directImportc = false
            for importcIndex in 0..<currentProfile.importcCallNames.len:
                if currentProfile.importcCallNames[importcIndex] == callName:
                    directKind = NormalizedExprSurfaceCallImportc
                    directImportc = true
                    break
            if directKind == NormalizedExprSurfaceCallNone:
                for localIndex in 0..<currentProfile.localCallNames.len:
                    if currentProfile.localCallNames[localIndex] == callName:
                        directKind = NormalizedExprSurfaceCallLocal
                        break
            if directKind != NormalizedExprSurfaceCallNone:
                var callArgsText = ""
                var callArgCount: int32
                var endColumnNumber: int32 = -1
                let callSurfaceOk = ParserCallSurfaceFromOpenParen(lineRaw,
                                                                     nextPos,
                                                                     callArgsText,
                                                                     callArgCount,
                                                                     endColumnNumber)
                let _ = callSurfaceOk
                NormalizedExprLayerAppendCall(layer,
                                                sourcePath,
                                                lineNumber,
                                                start + 1,
                                                callName,
                                                directKind,
                                                true,
                                                NormalizedExprCallReasonNone,
                                                "",
                                                callName,
                                                callName,
                                                sourcePath,
                                                directImportc,
                                                callArgsText,
                                                callArgCount,
                                                false,
                                                endColumnNumber)
            elif !ParserCallNameIsBuiltinCallee(callName):
                var directExternalMatchCount: int32
                var directExternalSourcePath = ""
                var directExternalImportc = false
                for edgeIndex in 0..<currentProfile.importEdges.len:
                    let edge = currentProfile.importEdges[edgeIndex]
                    if !edge.resolved || !edge.allowsUnqualifiedCall:
                        continue
                    var targetProfileIndex = ParserImportEdgeTargetProfileIndex(edge, profileIndexLookup)
                    if targetProfileIndex < 0:
                        let normalizedTargetPath = ParserNormalizePath(edge.targetSourcePath)
                        for profileScan in 0..<profiles.len:
                            if ParserNormalizePath(profiles[profileScan].sourcePath) == normalizedTargetPath:
                                targetProfileIndex = profileScan
                                break
                    if targetProfileIndex < 0 || targetProfileIndex >= profiles.len:
                        continue
                    let targetProfile = profiles[targetProfileIndex]
                    var targetHasImportc = false
                    var targetHasLocal = false
                    for importcIndex in 0..<targetProfile.importcCallNames.len:
                        if targetProfile.importcCallNames[importcIndex] == callName:
                            targetHasImportc = true
                            break
                    for localIndex in 0..<targetProfile.localCallNames.len:
                        if targetProfile.localCallNames[localIndex] == callName:
                            targetHasLocal = true
                            break
                    if !targetHasImportc && !targetHasLocal:
                        continue
                    directExternalMatchCount = directExternalMatchCount + 1
                    directExternalSourcePath = targetProfile.sourcePath
                    directExternalImportc = targetHasImportc
                let externalTarget = ParserResolveUnqualifiedExternalCallTarget(currentProfile,
                                                                                 profiles,
                                                                                 profileIndexLookup,
                                                                                 profileCallLookupCache,
                                                                                 callName)
                if directExternalMatchCount > 0 ||
                   externalTarget.sourcePath != "" ||
                   externalTarget.reason != NormalizedExprCallReasonUnknownExternalTarget:
                    var externalResolved = externalTarget.sourcePath != ""
                    var externalReason = externalTarget.reason
                    var externalSourcePath = externalTarget.sourcePath
                    var externalImportc = externalTarget.importc
                    if directExternalMatchCount == 1:
                        externalResolved = true
                        externalReason = NormalizedExprCallReasonNone
                        externalSourcePath = directExternalSourcePath
                        externalImportc = directExternalImportc
                    elif directExternalMatchCount > 1:
                        externalResolved = false
                        externalReason = NormalizedExprCallReasonAmbiguousExternalTarget
                        externalSourcePath = ""
                        externalImportc = false
                    var callArgsText = ""
                    var callArgCount: int32
                    var endColumnNumber: int32 = -1
                    let callSurfaceOk = ParserCallSurfaceFromOpenParen(lineRaw,
                                                                         nextPos,
                                                                         callArgsText,
                                                                         callArgCount,
                                                                         endColumnNumber)
                    let _ = callSurfaceOk
                    NormalizedExprLayerAppendCall(layer,
                                                    sourcePath,
                                                    lineNumber,
                                                    start + 1,
                                                    callName,
                                                    NormalizedExprSurfaceCallExternal,
                                                    externalResolved,
                                                    externalReason,
                                                    "",
                                                    callName,
                                                    callName,
                                                    externalSourcePath,
                                                    externalImportc,
                                                    callArgsText,
                                                    callArgCount,
                                                    false,
                                                    endColumnNumber)
        i = stop
    return

fn main(): int32 =
    var localCallLookup: ParserTextLookup
    var externalCallLookup: ParserTextLookup
    var importcCallLookup: ParserTextLookup
    var currentProfile: NormalizedExprCallProfile
    var profiles: NormalizedExprCallProfile[]
    var profileIndexLookup: ParserSourcePathIndexLookup
    var profileCallLookupCache: ParserProfileCallLookupCacheEntry[]
    var layer: NormalizedExprLayer
    currentProfile.localCallNames = ["foo"]
    ParserAppendMemberCallExprsLine3("repro.cheng",
                                       1,
                                       "foo(1)",
                                       localCallLookup,
                                       externalCallLookup,
                                       importcCallLookup,
                                       currentProfile,
                                       profiles,
                                       profileIndexLookup,
                                       profileCallLookupCache,
                                       layer)
    return layer.sourceCount
main()
