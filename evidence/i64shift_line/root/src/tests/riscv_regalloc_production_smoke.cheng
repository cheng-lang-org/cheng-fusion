import cheng/core/backend/regalloc_production_artifacts as artifacts
import cheng/core/backend/regalloc_production_emitter as emitter
import cheng/core/backend/regalloc_single_pass as alloc
import cheng/core/backend/regalloc_riscv_adapter as riscvadapter
import cheng/core/backend/codegen_contract as contract
import cheng/core/backend/riscv64_encode as rv
import cheng/core/backend/elf_riscv64_writer as elf64
import cheng/core/backend/elf_riscv32_writer as elf32
import cheng/core/backend/object_buffer as obuf
import cheng/core/backend/object_symbols as osym
import cheng/core/backend/object_relocs as orel
import cheng/core/backend/target_matrix as tmat
import cheng/core/ir/core_types as ir
import cheng/core/lang/typed_expr as texpr
import cheng/std/bytes_layout as layout
import std/rawbytes

@borrows
fn specOpcode(word: uint32): uint32 =
    return word & uint32(127)

@borrows
fn specFunct3(word: uint32): uint32 =
    return (word >> 12) & uint32(7)

@borrows
fn specFpFmt(word: uint32): uint32 =
    return (word >> 25) & uint32(3)

@borrows
fn u8At(buf: rawbytes.Bytes, off: int32): int32 =
    return rawbytes.BytesGet(buf, off) & 255

@borrows
fn u16le(buf: rawbytes.Bytes, off: int32): int32 =
    return u8At(buf, off) | (u8At(buf, off + 1) << 8)

@borrows
fn u32le(buf: rawbytes.Bytes, off: int32): int32 =
    return u8At(buf, off) | (u8At(buf, off + 1) << 8) | (u8At(buf, off + 2) << 16) | (u8At(buf, off + 3) << 24)

fn rvIntegerConstReturnBody(): ir.BodyIR =
    let parsed = layout.FixedBytes32FromHex(
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
    assert(parsed.ok, " riscv integer: TypeArena CID invalid")
    var body = ir.BodyIRNew()
    assert(ir.BodyIRBindTypeArenaArtifactCid(body, parsed.value),
           " riscv integer: TypeArena CID bind failed")
    var slot: ir.LocalSlot
    slot.id = 0
    slot.name = "result"
    slot.typeKind = ir.LocalI32Tag
    slot.stackOffset = 16
    slot.sizeBytes = 4
    slot.alignBytes = 4
    ir.BodyIRApplyLocalSlotDefaultProof(slot)
    add(body.localSlots, slot)
    var ownershipKinds: int32[]
    add(ownershipKinds, int32(ir.OwnInvalid))
    ir.BodyIRFreezeEntryDefinitionOwnershipKinds(body, ownershipKinds)
    var op: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = ir.BodyOpLoadConstTag
    op.target = 0
    add(op.operands, ir.LocalI32Tag)
    add(op.operands, 42)
    add(body.ops, op)
    var term: ir.BodyTerm
    ir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = 0
    add(term.operands, ir.LocalI32Tag)
    let termIndex = ir.BodyIRAppendTerm(body, term)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    ir.BodyIRControlFlowBegin(body, 0)
    ir.BodyIRControlFlowBindBlockScope(body, 0, 0)
    var noSuccessors: int32[]
    var noEdges: int32[]
    ir.BodyIRControlFlowBindTermSuccessors(
        body, 0, noSuccessors, noEdges)
    ir.BodyIRControlFlowSeal(body)
    return body

fn rvIntegerAddBranchBody(): ir.BodyIR =
    let parsed = layout.FixedBytes32FromHex(
        "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")
    assert(parsed.ok, " riscv add-branch: TypeArena CID invalid")
    var body = ir.BodyIRNew()
    assert(ir.BodyIRBindTypeArenaArtifactCid(body, parsed.value),
           " riscv add-branch: TypeArena CID bind failed")
    var i: int32
    for i in 0..<4:
        var slot: ir.LocalSlot
        slot.id = i
        slot.name = "v"
        slot.typeKind = ir.LocalI32Tag
        slot.stackOffset = 16 + i * 8
        slot.sizeBytes = 4
        slot.alignBytes = 4
        ir.BodyIRApplyLocalSlotDefaultProof(slot)
        add(body.localSlots, slot)
    var ownershipKinds: int32[]
    for i in 0..<body.localSlots.len:
        add(ownershipKinds, int32(ir.OwnInvalid))
    ir.BodyIRFreezeEntryDefinitionOwnershipKinds(body, ownershipKinds)
    var c0: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(c0)
    c0.kind = ir.BodyOpLoadConstTag
    c0.target = 0
    add(c0.operands, ir.LocalI32Tag)
    add(c0.operands, 40)
    add(body.ops, c0)
    var c1: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(c1)
    c1.kind = ir.BodyOpLoadConstTag
    c1.target = 1
    add(c1.operands, ir.LocalI32Tag)
    add(c1.operands, 2)
    add(body.ops, c1)
    var addOp: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(addOp)
    addOp.kind = ir.BodyOpBinOpTag
    addOp.target = 2
    add(addOp.operands, ir.LocalI32Tag)
    add(addOp.operands, int32(texpr.TypedExprIrOpI32Add))
    add(addOp.operands, 0)
    add(addOp.operands, 1)
    add(body.ops, addOp)
    var cZero: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(cZero)
    cZero.kind = ir.BodyOpLoadConstTag
    cZero.target = 3
    add(cZero.operands, ir.LocalI32Tag)
    add(cZero.operands, 0)
    add(body.ops, cZero)
    var cbr: ir.BodyTerm
    ir.BodyIRApplyBodyTermDefaultProof(cbr)
    cbr.kind = ir.BodyTermCbrTag
    cbr.conditionKind = ir.BodyCondLocalNonZeroTag
    cbr.resultSlot = 0
    cbr.lhsSlot = 0
    cbr.rhsSlot = -1
    cbr.trueBlock = 1
    cbr.falseBlock = 2
    let entryTerm = ir.BodyIRAppendTerm(body, cbr)
    var retAdd: ir.BodyTerm
    ir.BodyIRApplyBodyTermDefaultProof(retAdd)
    retAdd.kind = ir.BodyTermReturnTag
    retAdd.resultSlot = 2
    add(retAdd.operands, ir.LocalI32Tag)
    let addTerm = ir.BodyIRAppendTerm(body, retAdd)
    var retZero: ir.BodyTerm
    ir.BodyIRApplyBodyTermDefaultProof(retZero)
    retZero.kind = ir.BodyTermReturnTag
    retZero.resultSlot = 3
    add(retZero.operands, ir.LocalI32Tag)
    let zeroTerm = ir.BodyIRAppendTerm(body, retZero)
    let _ = ir.BodyIRAppendBlock(body, 0, 2, entryTerm)
    let _ = ir.BodyIRAppendBlock(body, 2, 1, addTerm)
    let _ = ir.BodyIRAppendBlock(body, 3, 1, zeroTerm)
    ir.BodyIRControlFlowBegin(body, 0)
    ir.BodyIRControlFlowBindBlockScope(body, 0, 0)
    ir.BodyIRControlFlowBindBlockScope(body, 1, 0)
    ir.BodyIRControlFlowBindBlockScope(body, 2, 0)
    var cbrSucc: int32[]
    add(cbrSucc, 1)
    add(cbrSucc, 2)
    var cbrEdges: int32[]
    add(cbrEdges, ir.BodyControlEdgeNormal)
    add(cbrEdges, ir.BodyControlEdgeNormal)
    ir.BodyIRControlFlowBindTermSuccessors(body, 0, cbrSucc, cbrEdges)
    var noSuccessors: int32[]
    var noEdges: int32[]
    ir.BodyIRControlFlowBindTermSuccessors(body, 1, noSuccessors, noEdges)
    ir.BodyIRControlFlowBindTermSuccessors(body, 2, noSuccessors, noEdges)
    ir.BodyIRControlFlowSeal(body)
    return body

fn rvIntegerDirectCallBody(): ir.BodyIR =
    let parsed = layout.FixedBytes32FromHex(
        "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc")
    assert(parsed.ok, " riscv call: TypeArena CID invalid")
    var body = ir.BodyIRNew()
    assert(ir.BodyIRBindTypeArenaArtifactCid(body, parsed.value),
           " riscv call: TypeArena CID bind failed")
    for slotIndex in 0..<3:
        var slot: ir.LocalSlot
        ir.BodyIRApplyLocalSlotDefaultProof(slot)
        slot.id = slotIndex
        slot.name = "call_value"
        slot.typeKind = ir.LocalI32Tag
        slot.stackOffset = 16 + slotIndex * 8
        slot.sizeBytes = 4
        slot.alignBytes = 4
        add(body.localSlots, slot)
    var entryOwnershipKinds: int32[]
    for _ in 0..<body.localSlots.len:
        add(entryOwnershipKinds, int32(ir.OwnInvalid))
    ir.BodyIRFreezeEntryDefinitionOwnershipKinds(
        body, entryOwnershipKinds)
    for argIndex in 0..<2:
        var valueOp: ir.BodyOp
        ir.BodyIRApplyBodyOpDefaultProof(valueOp)
        valueOp.kind = ir.BodyOpLoadConstTag
        valueOp.target = argIndex
        add(valueOp.operands, ir.LocalI32Tag)
        add(valueOp.operands, 40 + argIndex)
        let _ = ir.BodyIRAppendOp(body, valueOp)
    var call: ir.CallOp
    ir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = "non_authoritative_surface_spelling"
    call.targetSourcePath = "src/tests/riscv_exact_target.cheng"
    call.resultSlot = 2
    call.resultPassKind = ir.BodyCallPassStackValueTag
    call.semanticCallExprNodeIndex = 71
    call.relocWordOffset = -1
    for argIndex in 0..<2:
        add(call.argSlots, argIndex)
        add(call.argPassKinds, ir.BodyCallPassStackValueTag)
        add(call.argAbiSizes, 4)
    add(body.callSequence, call)
    var callOp: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(callOp)
    callOp.kind = ir.BodyOpCallTag
    callOp.target = 2
    add(callOp.operands, 0)
    let _ = ir.BodyIRAppendOp(body, callOp)
    var term: ir.BodyTerm
    ir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = 2
    add(term.operands, ir.LocalI32Tag)
    let termIndex = ir.BodyIRAppendTerm(body, term)
    let blockIndex = ir.BodyIRAppendBlock(
        body, 0, body.ops.len, termIndex)
    ir.BodyIRControlFlowBegin(body, 9)
    ir.BodyIRControlFlowBindBlockScope(body, blockIndex, 0)
    var noSuccessors: int32[]
    var noEdges: int32[]
    ir.BodyIRControlFlowBindTermSuccessors(
        body, termIndex, noSuccessors, noEdges)
    ir.BodyIRControlFlowBindCallTarget(
        body, 0, ir.BodyCallTargetDomainFunctionTag, 17,
        parsed.value)
    ir.BodyIRControlFlowSeal(body)
    return body

fn rvWordsToText(words: int32[]): rawbytes.Bytes =
    var out = obuf.ObjectBufferInit(words.len * 4 + 16)
    for i in 0..<words.len:
        obuf.ObjectBufferWriteU32LE(out, uint64(uint32(words[i])))
    return obuf.ObjectBufferTakeBytes(out)

fn rvScanForbiddenRv64Only(words: int32[]): bool =
    for i in 0..<words.len:
        let insn = uint32(words[i])
        let op = specOpcode(insn)
        let f3 = specFunct3(insn)
        if (op == uint32(0x03) || op == uint32(0x23)) && f3 == uint32(3):
            return true
        if op == uint32(0x1B) || op == uint32(0x3B):
            return true
        if op == uint32(0x53) && specFpFmt(insn) == uint32(1):
            return true
    return false

fn buildText(words: uint32[]): rawbytes.Bytes =
    var out = obuf.ObjectBufferInit(16)
    for i in 0..<words.len:
        obuf.ObjectBufferWriteU32LE(out, uint64(words[i]))
    return obuf.ObjectBufferTakeBytes(out)

fn main(): int32 =
    # B1: codegen unit composition root (dispatch fails closed without registration)
    if !riscvadapter.RegallocRiscvCodegenUnitRegister():
        return 90
    assert(artifacts.RegallocProductionTargetUsesCanonicalRegalloc(
               artifacts.RegallocProductionTargetRv64Linux),
           " rv64 canonical")
    assert(artifacts.RegallocProductionTargetUsesCanonicalRegalloc(
               artifacts.RegallocProductionTargetRv64Bare),
           " rv64 bare canonical")
    assert(artifacts.RegallocProductionTargetUsesCanonicalRegalloc(
               artifacts.RegallocProductionTargetEsp32S31),
           " s31 canonical")
    assert(artifacts.RegallocProductionTargetUsesCanonicalRegalloc(
               artifacts.RegallocProductionTargetEsp32S31Alias),
           " s31 alias canonical")
    assert(artifacts.RegallocProductionTargetUsesCanonicalRegalloc(
               artifacts.RegallocProductionTargetRv32Linux),
           " rv32 linux canonical")
    assert(artifacts.RegallocProductionTargetUsesCanonicalRegalloc(
               artifacts.RegallocProductionTargetRv32Bare),
           " rv32 bare canonical")
    assert(tmat.TargetIsLinuxRv64("riscv64-unknown-linux-gnu"), "triple")
    assert(tmat.TargetIsLinuxRv32("riscv32-unknown-linux-gnu"), "rv32 linux")
    assert(tmat.TargetIsRv32Bare("riscv32-unknown-none-elf"), "rv32 bare")
    assert(tmat.TargetIsRv32("riscv32-unknown-linux-gnu"), "rv32")
    assert(tmat.TargetIsEsp32S31("riscv32-esp32s31-none-elf"), "s31")
    assert(tmat.TargetIsRv32("riscv32-esp32s31-none-elf"), "s31 is rv32")
    assert(tmat.TargetPrimaryObjectFormat("riscv64-unknown-linux-gnu") == "elf",
           " rv64 format")
    assert(tmat.TargetPrimaryObjectFormat("riscv32-unknown-linux-gnu") == "elf",
           " rv32 format")
    assert(tmat.TargetPrimaryObjectFormat("riscv32-esp32s31-none-elf") == "elf",
           " s31 format")

    var constraints64 = alloc.RegallocTargetConstraintsRv64()
    assert(constraints64.fixedSretReg == 10, " rv64 sret a0")
    assert(constraints64.parallelCopyScratchReg == 5, " rv64 scratch t0")
    assert(!constraints64.packedStackArgs, " rv64 packed")
    var constraints32 = alloc.RegallocTargetConstraintsRv32()
    assert(constraints32.fixedSretReg == 10, " rv32 sret a0")
    assert(constraints32.parallelCopyScratchReg == 5, " rv32 scratch t0")

    var emptyBody = ir.BodyIRNew()
    var emptyPlan: alloc.RegallocSinglePassValuePlan
    var emptyRecipes = riscvadapter.RegallocRiscvPrepareFunctionActionRecipes(
        emptyBody, emptyPlan, 64)
    assert(!emptyRecipes.valid, " empty plan must hard-fail")

    var noCallTargets64: str[]
    var noDataTargets64: str[]
    var emptyBody64 = ir.BodyIRNew()
    var emptyEmit = emitter.RegallocProductionEmitFunction(
        artifacts.RegallocProductionTargetRv64Linux,
        emptyBody64, "main", 0, noCallTargets64, noDataTargets64,
        0, artifacts.RegallocProductionFunctionKindNormal)
    assert(!emptyEmit.valid, " empty body emit invalid")
    assert(emptyEmit.errorCode !=
               emitter.RegallocProductionEmitTargetUnsupported,
           " riscv64 must be a canonical production target")
    assert(emptyEmit.errorCode ==
               emitter.RegallocProductionEmitPlanInvalid,
           " empty body is plan-invalid not target-unsupported")

    var noCallTargets32: str[]
    var noDataTargets32: str[]
    var emptyBody32 = ir.BodyIRNew()
    var emptyEmit32 = emitter.RegallocProductionEmitFunction(
        artifacts.RegallocProductionTargetEsp32S31,
        emptyBody32, "main", 0, noCallTargets32, noDataTargets32,
        0, artifacts.RegallocProductionFunctionKindNormal)
    assert(!emptyEmit32.valid, " empty esp32 emit invalid")
    assert(emptyEmit32.errorCode !=
               emitter.RegallocProductionEmitTargetUnsupported,
           " esp32s31 must be a canonical production target")

    var noCallTargetsRv32: str[]
    var noDataTargetsRv32: str[]
    var emptyBodyRv32 = ir.BodyIRNew()
    var emptyEmitRv32 = emitter.RegallocProductionEmitFunction(
        artifacts.RegallocProductionTargetRv32Linux,
        emptyBodyRv32, "main", 0, noCallTargetsRv32, noDataTargetsRv32,
        0, artifacts.RegallocProductionFunctionKindNormal)
    assert(!emptyEmitRv32.valid, " empty rv32 emit invalid")
    assert(emptyEmitRv32.errorCode !=
               emitter.RegallocProductionEmitTargetUnsupported,
           " rv32 linux must be a canonical production target")

    let xlen64 = 64
    let xlen32 = 32
    let rd = 10
    let rs1 = 11
    let rs2 = 12
    let addi = rv.RvEncAddiForXlen(xlen64, rd, rs1, 42)
    assert(addi.ok, addi.err.msg)
    assert(specOpcode(addi.value) == uint32(19), "addi opcode")
    let add = rv.RvEncAddForXlen(xlen64, rd, rs1, rs2)
    assert(add.ok, add.err.msg)
    let jalr = rv.RvEncJalrForXlen(xlen64, 0, 1, 0)
    assert(jalr.ok, jalr.err.msg)
    let lui = rv.RvEncLuiForXlen(xlen64, rd, 1)
    assert(lui.ok, lui.err.msg)
    assert(specOpcode(lui.value) == uint32(55), "lui opcode")
    let bne = rv.RvEncBneForXlen(xlen32, rd, 0, int64(8))
    assert(bne.ok, bne.err.msg)
    assert(specOpcode(bne.value) == uint32(99), "bne opcode")
    assert(specFunct3(bne.value) == uint32(1), "bne funct3")
    let ld32 = rv.RvEncLdForXlen(xlen32, rd, rs1, 0)
    assert(!ld32.ok, "ld must reject XLEN=32")
    let addw32 = rv.RvEncAddwForXlen(xlen32, rd, rs1, rs2)
    assert(!addw32.ok, "addw must reject XLEN=32")

    var words64: uint32[]
    add(words64, addi.value)
    add(words64, add.value)
    add(words64, jalr.value)
    var text64 = buildText(words64)
    defer:
        rawbytes.BytesFree(text64)
    var syms64 = osym.ObjectSymbolsInit()
    assert(osym.ObjectSymbolsAddDefined(
               syms64, "main", 0, int64(0), int64(12), true) == 0,
           " rv64 symbol")
    var relocs64 = orel.ObjectRelocsInit()
    let obj64Res = elf64.ElfRv64TextObjectBytes(text64, syms64, relocs64)
    assert(obj64Res.ok, obj64Res.err.msg)
    var obj64 = obj64Res.value
    defer:
        rawbytes.BytesFree(obj64)
    assert(u8At(obj64, 0) == 0x7F, "elf64 mag0")
    assert(u8At(obj64, 4) == 2, "elf64 class")
    assert(u8At(obj64, 5) == 1, "elf64 data")
    assert(u16le(obj64, 18) == 243, "elf64 em_riscv")

    let addi32 = rv.RvEncAddiForXlen(xlen32, rd, rs1, 42)
    assert(addi32.ok, addi32.err.msg)
    let add32 = rv.RvEncAddForXlen(xlen32, rd, rs1, rs2)
    assert(add32.ok, add32.err.msg)
    let beq32 = rv.RvEncBeqForXlen(xlen32, rd, 0, int64(8))
    assert(beq32.ok, beq32.err.msg)
    let jalr32 = rv.RvEncJalrForXlen(xlen32, 0, 1, 0)
    assert(jalr32.ok, jalr32.err.msg)
    var words32: uint32[]
    add(words32, addi32.value)
    add(words32, add32.value)
    add(words32, beq32.value)
    add(words32, jalr32.value)
    var text32 = buildText(words32)
    defer:
        rawbytes.BytesFree(text32)
    var i = 0
    while i + 4 <= rawbytes.BytesLen(text32):
        let insn = uint32(u32le(text32, i))
        let op = specOpcode(insn)
        let f3 = specFunct3(insn)
        if op == uint32(0x03) || op == uint32(0x23):
            assert(f3 != uint32(3), "rv32 text must not contain ld/sd")
        assert(op != uint32(0x1B), "rv32 text must not contain OP-IMM-32")
        assert(op != uint32(0x3B), "rv32 text must not contain OP-32")
        if op == uint32(0x53):
            assert(specFpFmt(insn) != uint32(1), "rv32 text must not contain fmt=D")
        i = i + 4
    var syms32 = osym.ObjectSymbolsInit()
    assert(osym.ObjectSymbolsAddDefined(
               syms32, "main", 0, int64(0), int64(16), true) == 0,
           " rv32 symbol")
    var relocs32 = orel.ObjectRelocsInit()
    let obj32Res = elf32.ElfRv32TextObjectBytes(text32, syms32, relocs32)
    assert(obj32Res.ok, obj32Res.err.msg)
    var obj32 = obj32Res.value
    defer:
        rawbytes.BytesFree(obj32)
    assert(u8At(obj32, 0) == 0x7F, "elf32 mag0")
    assert(u8At(obj32, 4) == 1, "elf32 class")
    assert(u8At(obj32, 5) == 1, "elf32 data")
    assert(u16le(obj32, 18) == 243, "elf32 em_riscv")
    assert(u32le(obj32, 36) == (1 | 2), "elf32 e_flags rvc|single")

    var relocs32int = orel.ObjectRelocsInit()
    let obj32intRes = elf32.ElfRv32IntegerTextObjectBytes(
        text32, syms32, relocs32int)
    assert(obj32intRes.ok, obj32intRes.err.msg)
    var obj32int = obj32intRes.value
    defer:
        rawbytes.BytesFree(obj32int)
    assert(u8At(obj32int, 4) == 1, "rv32 elf32 class")
    assert(u16le(obj32int, 18) == 243, "rv32 em_riscv")
    assert(u32le(obj32int, 36) == 0, "rv32 integer e_flags")

    var constBody = rvIntegerConstReturnBody()
    let hashA = alloc.RegallocSinglePassBodyIrIngressSha256(constBody)
    let hashB = alloc.RegallocSinglePassBodyIrIngressSha256(constBody)
    echo(Fmt"step=hash-stable equal={hashA == hashB} a={hashA} b={hashB}")
    var constCall: str[]
    var constData: str[]
    echo("step=const-emit")
    var constEmit = emitter.RegallocProductionEmitFunction(
        artifacts.RegallocProductionTargetRv64Linux,
        constBody, "main", 0, constCall, constData,
        0, artifacts.RegallocProductionFunctionKindNormal)
    echo(Fmt"step=ingress-fields blocks={constBody.blocks.len} terms={constBody.terms.len} slots={constBody.localSlots.len} slot0id={constBody.localSlots[0].id} slot0kind={constBody.localSlots[0].typeKind} slot0size={constBody.localSlots[0].sizeBytes} slot0align={constBody.localSlots[0].alignBytes} frameReady={constBody.frameMetricsReady} frameBytes={constBody.frameBytes} frameStack={constBody.frameStackByteCount} prologue={constBody.framePrologueWordCount} restore={constBody.frameRestoreWordCount} debugReq={constBody.debugProvenanceRequired} debugComplete={constBody.debugProvenanceComplete} debugOps={constBody.debugOpIdsByOpIndex.len} debugTerms={constBody.debugOpIdsByTermIndex.len} x64Ready={constBody.x64StackLayoutReady} x64Block={constBody.x64BlockStartReady} x64Slot={constBody.x64SlotReadCnt.len} x64Start={constBody.x64BlockByteStart.len} layoutLhs={constBody.layoutLhsElide.len} storeElide={constBody.layoutStoreElide.len} copyElide={constBody.layoutCopySrcElide.len} cmpFuse={constBody.layoutCmpFuse.len} cbrFuse={constBody.layoutCbrFuse.len}")
    let hashC = alloc.RegallocSinglePassBodyIrIngressSha256(constBody)
    echo(Fmt"step=hash-after equal_plan={hashC == constEmit.plan.bodyIrIngressSha256} c={hashC} plan={constEmit.plan.bodyIrIngressSha256}")
    echo(Fmt"step=const-after valid={constEmit.valid} err={constEmit.errorCode} recipe_valid={constEmit.recipes.valid} recipe={constEmit.recipes.errorCode} recipe_detail={constEmit.recipes.errorDetail} recipe_words={constEmit.recipes.functionWords.len} frags={constEmit.recipes.machineFragments.len} plan={constEmit.plan.errorCode} plan_valid={constEmit.plan.valid} plan_frozen={constEmit.plan.frozen} match={alloc.RegallocSinglePassValuePlanMatchesBodyIrIngress(constBody, constEmit.plan)} words={constEmit.recipes.functionWords.len} emit_detail={constEmit.errorDetail} actions={constEmit.plan.actions.len}")
    var fragI: int32
    for fragI in 0..<constEmit.recipes.machineFragments.len:
        let frag = constEmit.recipes.machineFragments[fragI]
        echo(Fmt"frag i={fragI} start={frag.wordStart} count={frag.wordCount} owner={frag.ownerKind} action={frag.actionConsumerOrdinal} site={frag.siteKind} ir={frag.irKind} brW={frag.branchWordIndices.len} brB={frag.branchByteOffsets.len}")
    var actI: int32
    for actI in 0..<constEmit.plan.actions.len:
        let act = constEmit.plan.actions[actI]
        echo(Fmt"act i={actI} kind={act.kind} place={act.placement} op={act.opIndex} term={act.termIndex} cons={act.consumerOrdinal}")
    var x86Body = rvIntegerConstReturnBody()
    var x86Call: str[]
    var x86Data: str[]
    var x86Emit = emitter.RegallocProductionEmitFunction(
        artifacts.RegallocProductionTargetX64Linux,
        x86Body, "main", 0, x86Call, x86Data,
        0, artifacts.RegallocProductionFunctionKindNormal)
    echo(Fmt"step=x86-const valid={x86Emit.valid} err={x86Emit.errorCode} recipe_valid={x86Emit.recipes.valid} recipe_words={x86Emit.recipes.functionWords.len} match={alloc.RegallocSinglePassValuePlanMatchesBodyIrIngress(x86Body, x86Emit.plan)}")
    if !constEmit.valid || constEmit.recipes.functionWords.len <= 0:
        echo("const-return production emit failed")
        return 30
    var constText = rvWordsToText(constEmit.recipes.functionWords)
    defer:
        rawbytes.BytesFree(constText)
    var constSyms = osym.ObjectSymbolsInit()
    assert(osym.ObjectSymbolsAddDefined(
               constSyms, "main", 0, int64(0),
               int64(constEmit.recipes.functionWords.len * 4), true) == 0,
           " const symbol")
    var constRelocs = orel.ObjectRelocsInit()
    let constObjRes = elf64.ElfRv64TextObjectBytes(
        constText, constSyms, constRelocs)
    assert(constObjRes.ok, constObjRes.err.msg)
    var constObj = constObjRes.value
    defer:
        rawbytes.BytesFree(constObj)
    assert(u8At(constObj, 4) == 2, "const elf64 class")
    assert(u16le(constObj, 18) == 243, "const elf64 em")

    var addBody64 = rvIntegerAddBranchBody()
    var addCall64: str[]
    var addData64: str[]
    echo("step=add-emit-64")
    var addEmit64 = emitter.RegallocProductionEmitFunction(
        artifacts.RegallocProductionTargetRv64Linux,
        addBody64, "main", 0, addCall64, addData64,
        0, artifacts.RegallocProductionFunctionKindNormal)
    echo(Fmt"step=add-after-64 valid={addEmit64.valid} err={addEmit64.errorCode} recipe={addEmit64.recipes.errorCode} recipe_detail={addEmit64.recipes.errorDetail} plan={addEmit64.plan.errorCode} words={addEmit64.recipes.functionWords.len}")
    if !addEmit64.valid || addEmit64.recipes.functionWords.len <= 0:
        echo("add-branch rv64 production emit failed")
        return 31
    var addText64 = rvWordsToText(addEmit64.recipes.functionWords)
    defer:
        rawbytes.BytesFree(addText64)
    var addSyms64 = osym.ObjectSymbolsInit()
    assert(osym.ObjectSymbolsAddDefined(
               addSyms64, "main", 0, int64(0),
               int64(addEmit64.recipes.functionWords.len * 4), true) == 0,
           " add64 symbol")
    var addRelocs64 = orel.ObjectRelocsInit()
    let addObj64Res = elf64.ElfRv64TextObjectBytes(
        addText64, addSyms64, addRelocs64)
    assert(addObj64Res.ok, addObj64Res.err.msg)
    var addObj64 = addObj64Res.value
    defer:
        rawbytes.BytesFree(addObj64)
    assert(u8At(addObj64, 4) == 2, "add64 elf class")
    assert(u16le(addObj64, 18) == 243, "add64 em")

    var addBody32 = rvIntegerAddBranchBody()
    var addCall32: str[]
    var addData32: str[]
    echo("step=add-emit-32")
    var addEmit32 = emitter.RegallocProductionEmitFunction(
        artifacts.RegallocProductionTargetEsp32S31,
        addBody32, "main", 0, addCall32, addData32,
        0, artifacts.RegallocProductionFunctionKindNormal)
    echo(Fmt"step=add-after-32 valid={addEmit32.valid} err={addEmit32.errorCode} recipe={addEmit32.recipes.errorCode} recipe_detail={addEmit32.recipes.errorDetail} plan={addEmit32.plan.errorCode} words={addEmit32.recipes.functionWords.len}")
    if !addEmit32.valid || addEmit32.recipes.functionWords.len <= 0:
        echo("add-branch rv32 production emit failed")
        return 32
    if rvScanForbiddenRv64Only(addEmit32.recipes.functionWords):
        echo("rv32 production words contain forbidden RV64-only encoding")
        return 33
    var addText32 = rvWordsToText(addEmit32.recipes.functionWords)
    defer:
        rawbytes.BytesFree(addText32)
    var addSyms32 = osym.ObjectSymbolsInit()
    assert(osym.ObjectSymbolsAddDefined(
               addSyms32, "main", 0, int64(0),
               int64(addEmit32.recipes.functionWords.len * 4), true) == 0,
           " add32 symbol")
    var addRelocs32 = orel.ObjectRelocsInit()
    let addObj32Res = elf32.ElfRv32TextObjectBytes(
        addText32, addSyms32, addRelocs32)
    assert(addObj32Res.ok, addObj32Res.err.msg)
    var addObj32 = addObj32Res.value
    defer:
        rawbytes.BytesFree(addObj32)
    assert(u8At(addObj32, 4) == 1, "add32 elf class")
    assert(u16le(addObj32, 18) == 243, "add32 em")
    assert(u32le(addObj32, 36) == (1 | 2), "add32 e_flags")

    var callBody64 = rvIntegerDirectCallBody()
    var callTargets64: str[]
    add(callTargets64, "exact_materialized_callee")
    var callData64: str[]
    var callEmit64 = emitter.RegallocProductionEmitFunction(
        artifacts.RegallocProductionTargetRv64Linux,
        callBody64, "caller", 0, callTargets64, callData64,
        9, artifacts.RegallocProductionFunctionKindNormal)
    echo(Fmt"step=call-after-64 valid={callEmit64.valid} err={callEmit64.errorCode} detail={callEmit64.errorDetail} recipe={callEmit64.recipes.errorCode} recipe_detail={callEmit64.recipes.errorDetail} words={callEmit64.recipes.functionWords.len} actions={callEmit64.plan.actions.len}")
    if !callEmit64.valid:
        for actionIndex in 0..<callEmit64.plan.actions.len:
            let action = callEmit64.plan.actions[actionIndex]
            echo(Fmt"call-act i={actionIndex} kind={action.kind} place={action.placement} op={action.opIndex} call={action.callOrdinal} fixed={action.fixedKind} fact={action.factIndex} src={action.sourceReg} dst={action.targetReg}")
    assert(callEmit64.valid, "riscv direct call production emit")
    assert(callEmit64.recipes.functionRelocs.len == 1,
           "riscv direct call relocation count")
    let callReloc = callEmit64.recipes.functionRelocs[0]
    assert(callReloc.kind ==
               contract.RegallocMachineRelocRiscvCall &&
           callReloc.callOrdinal == 0 &&
           callReloc.opIndex == 2 &&
           callReloc.targetDomain ==
               callBody64.callTargetDomainKinds[0] &&
           callReloc.targetRow == callBody64.callTargetRows[0] &&
           layout.FixedBytes32Equal(
               callReloc.targetInterfaceCid,
               callBody64.callTargetInterfaceCids[0]) &&
           callReloc.targetSymbol == "exact_materialized_callee" &&
           callReloc.wordIndex >= 0 &&
           callReloc.wordIndex <
               callEmit64.recipes.functionWords.len - 1,
           "riscv direct call relocation identity")
    var callRecipeIndex: int32 = -1
    for recipeIndex in 0..<callEmit64.recipes.recipes.len:
        if callEmit64.recipes.recipes[recipeIndex].relocs.len == 1 &&
           callEmit64.recipes.recipes[recipeIndex].relocs[0].kind ==
               contract.RegallocMachineRelocRiscvCall:
            callRecipeIndex = recipeIndex
    var callFragmentIndex: int32 = -1
    for fragmentIndex in 0..<callEmit64.recipes.machineFragments.len:
        let fragment = callEmit64.recipes.machineFragments[fragmentIndex]
        for relocIndex in 0..<fragment.relocs.len:
            if fragment.relocs[relocIndex].kind ==
                   contract.RegallocMachineRelocRiscvCall:
                callFragmentIndex = fragmentIndex
    assert(callRecipeIndex >= 0 && callFragmentIndex >= 0,
           "riscv call recipe and fragment identity")
    let recipeCallReloc =
        callEmit64.recipes.recipes[callRecipeIndex].relocs[0]
    let fragmentCallReloc =
        callEmit64.recipes.machineFragments[callFragmentIndex].relocs[0]
    assert(recipeCallReloc.targetDomain == callReloc.targetDomain &&
           recipeCallReloc.targetRow == callReloc.targetRow &&
           layout.FixedBytes32Equal(
               recipeCallReloc.targetInterfaceCid,
               callReloc.targetInterfaceCid) &&
           fragmentCallReloc.targetDomain == callReloc.targetDomain &&
           fragmentCallReloc.targetRow == callReloc.targetRow &&
           layout.FixedBytes32Equal(
               fragmentCallReloc.targetInterfaceCid,
               callReloc.targetInterfaceCid) &&
           callBody64.callSequence[0].targetSymbol ==
               "non_authoritative_surface_spelling" &&
           callReloc.targetSymbol == "exact_materialized_callee" &&
           callReloc.targetRow == 17,
           "riscv call three-copy exact identity and payload projection")
    let expectedAuipc = int32(int64(rv.rv64EncAuipc(1, 0)))
    let expectedJalr = rv.RvEncJalrForXlen(64, 1, 1, 0)
    assert(expectedJalr.ok &&
           callEmit64.recipes.functionWords[
               callReloc.wordIndex] == expectedAuipc &&
           callEmit64.recipes.functionWords[
               callReloc.wordIndex + 1] ==
               int32(int64(expectedJalr.value)),
           "riscv direct call AUIPC JALR pair")
    callEmit64.recipes.functionWords[callReloc.wordIndex] = 1
    let corruptedProof =
        artifacts.RegallocProductionMachineRecipeProofBuild(
            callEmit64.plan, callEmit64.recipes)
    assert(!corruptedProof.valid,
           "riscv direct call AUIPC mutation rejected")
    callEmit64.recipes.functionWords[callReloc.wordIndex] = expectedAuipc

    let exactDomain =
        callEmit64.recipes.functionRelocs[0].targetDomain
    callEmit64.recipes.functionRelocs[0].targetDomain = exactDomain + 1
    let domainDriftProof =
        artifacts.RegallocProductionMachineRecipeProofBuild(
            callEmit64.plan, callEmit64.recipes)
    assert(!domainDriftProof.valid,
           "riscv call target domain drift rejected")
    callEmit64.recipes.functionRelocs[0].targetDomain = exactDomain

    let exactRow = callEmit64.recipes.functionRelocs[0].targetRow
    callEmit64.recipes.functionRelocs[0].targetRow = exactRow + 1
    let rowDriftProof =
        artifacts.RegallocProductionMachineRecipeProofBuild(
            callEmit64.plan, callEmit64.recipes)
    assert(!rowDriftProof.valid,
           "riscv call target row drift rejected")
    callEmit64.recipes.functionRelocs[0].targetRow = exactRow

    let exactCidByte =
        callEmit64.recipes.functionRelocs[0].targetInterfaceCid.data[0]
    callEmit64.recipes.functionRelocs[0].targetInterfaceCid.data[0] =
        uint8(Int32(exactCidByte) ^ 1)
    let cidDriftProof =
        artifacts.RegallocProductionMachineRecipeProofBuild(
            callEmit64.plan, callEmit64.recipes)
    assert(!cidDriftProof.valid,
           "riscv call target interface CID drift rejected")
    callEmit64.recipes.functionRelocs[0].targetInterfaceCid.data[0] =
        exactCidByte

    callEmit64.recipes.functionRelocs[0].targetSymbol =
        "wrong_payload_name"
    let payloadDriftProof =
        artifacts.RegallocProductionMachineRecipeProofBuild(
            callEmit64.plan, callEmit64.recipes)
    assert(!payloadDriftProof.valid,
           "riscv call linker payload drift rejected")
    callEmit64.recipes.functionRelocs[0].targetSymbol =
        "exact_materialized_callee"

    callEmit64.recipes.functionRelocs[0].kind =
        contract.RegallocA64RelocPage21
    callEmit64.recipes.functionRelocs[0].callOrdinal = -1
    callEmit64.recipes.functionRelocs[0].subIndex = 0
    callEmit64.recipes.machineFragments[
        callFragmentIndex].relocs[0].kind =
            contract.RegallocA64RelocPage21
    callEmit64.recipes.machineFragments[
        callFragmentIndex].relocs[0].callOrdinal = -1
    callEmit64.recipes.machineFragments[
        callFragmentIndex].relocs[0].subIndex = 0
    callEmit64.recipes.recipes[callRecipeIndex].relocs[0].kind =
        contract.RegallocA64RelocPage21
    callEmit64.recipes.recipes[
        callRecipeIndex].relocs[0].callOrdinal = -1
    callEmit64.recipes.recipes[
        callRecipeIndex].relocs[0].subIndex = 0
    let nonCallIdentityProof =
        artifacts.RegallocProductionMachineRecipeProofBuild(
            callEmit64.plan, callEmit64.recipes)
    assert(!nonCallIdentityProof.valid,
           "non-call relocation semantic identity rejected")

    var badIdentityBody = rvIntegerDirectCallBody()
    badIdentityBody.callTargetRows[0] = -1
    assert(!ir.BodyIRControlFlowShapeValid(badIdentityBody),
           "riscv direct call target row mutation rejected")

    echo("riscv_regalloc_production_smoke=pass")
    return 0
