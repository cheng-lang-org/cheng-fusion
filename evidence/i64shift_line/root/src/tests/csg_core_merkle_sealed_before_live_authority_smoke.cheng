import std/os as os
import cheng/std/bytes_layout as layout
import cheng/core/csg_core/merkle_admission as admission

fn fail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

fn main(): int32 =
    let schema =
        "{\"features\":[\"core-facts\"],\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}"
    let moduleBefore =
        "{\"id\":\"mod_a\",\"kind\":\"csg.module\",\"path\":\"a.cheng\",\"sha256\":\"sha256:aaa\"}"
    let moduleAfter =
        "{\"id\":\"mod_a\",\"kind\":\"csg.module\",\"path\":\"b.cheng\",\"sha256\":\"sha256:bbb\"}"
    let symbolBefore =
        "{\"id\":\"sym_a\",\"kind\":\"csg.symbol\",\"name\":\"A\",\"symbolKind\":\"fn\"}"
    let symbolAfter =
        "{\"id\":\"sym_a\",\"kind\":\"csg.symbol\",\"name\":\"B\",\"symbolKind\":\"fn\"}"
    let beforeFacts = [schema, moduleBefore, symbolBefore]

    let issueA = admission.CsgCoreMerkleSealBeforeAuthority(
        beforeFacts, moduleAfter, "id:mod_a")
    let issueB = admission.CsgCoreMerkleSealBeforeAuthority(
        beforeFacts, symbolAfter, "id:sym_a")
    if !issueA.ok || !issueB.ok ||
       layout.FixedBytes32Equal(
           issueA.bindingDigest, issueB.bindingDigest):
        return fail("sealed before issue failed")

    var swapped = issueA.live
    swapped.authenticator = issueB.live.authenticator
    let swappedClaim =
        admission.CsgCoreMerkleSealedBeforeClaim(swapped)
    if swappedClaim.ok || swapped.ownerId != 0 ||
       swapped.generation != 0 || swapped.kind != 0:
        return fail("A/B token swap was accepted")

    var liveA = issueA.live
    var staleLive = issueA.live
    let claimA = admission.CsgCoreMerkleSealedBeforeClaim(liveA)
    if !claimA.ok || liveA.ownerId != 0 ||
       liveA.generation != 0 || liveA.kind != 0:
        return fail("live A claim failed")
    let duplicateClaim =
        admission.CsgCoreMerkleSealedBeforeClaim(staleLive)
    if duplicateClaim.ok || staleLive.ownerId != 0 ||
       staleLive.generation != 0 || staleLive.kind != 0:
        return fail("stale live copy was accepted")

    var liveB = issueB.live
    let claimB = admission.CsgCoreMerkleSealedBeforeClaim(liveB)
    if !claimB.ok:
        return fail("live B claim failed")
    let projectionB =
        admission.CsgCoreMerkleSealedBeforeClaimedProjection(
            claimB.claimed, claimB.bindingDigest)
    let claimedBindingB =
        admission.CsgCoreMerkleSealedBeforeClaimedBinding(
            claimB.claimed)
    if !projectionB.ok || !claimedBindingB.ok ||
       !layout.FixedBytes32Equal(
           claimedBindingB.bindingDigest, claimB.bindingDigest) ||
       projectionB.projection.beforePhysicalOrdinal < 0 ||
       projectionB.projection.summary.beforeFactCount != 3:
        return fail("claimed B projection failed")
    var sealedCandidateB =
        admission.CsgCoreMerkleSealBeforeContent(beforeFacts)
    var deltaCandidateB =
        admission.CsgCoreMerkleAdmitReplaceFromSealedBeforeContent(
            sealedCandidateB, symbolAfter, "id:sym_a")
    var candidateB: admission.CsgCoreMerkleSealedBeforeReadCandidate
    candidateB.sealedBeforeContentCid = sealedCandidateB.contentCid
    candidateB.beforeFactsRoot = sealedCandidateB.dag.factsRoot
    candidateB.beforeDagRootCid = sealedCandidateB.dag.dagRootCid
    candidateB.beforeSubgraphCid = sealedCandidateB.dag.subgraphCid
    candidateB.beforeFactCount = sealedCandidateB.dag.factCount
    candidateB.beforeCsgcDirectoryCid =
        sealedCandidateB.csgcDirectoryCid
    candidateB.beforeCsgcObjectCid = sealedCandidateB.csgcObjectCid
    candidateB.schemaFact = sealedCandidateB.schemaFact
    candidateB.queryKey = deltaCandidateB.queryKey
    candidateB.beforePhysicalOrdinal =
        projectionB.projection.beforePhysicalOrdinal
    candidateB.validatorKind = "csg.symbol"
    candidateB.replacementScope = projectionB.projection.replacementScope
    candidateB.replacementCount = 1
    candidateB.beforeFact = deltaCandidateB.beforeFact
    candidateB.afterFact = deltaCandidateB.afterFact
    candidateB.proof = deltaCandidateB.proof
    candidateB.replay = deltaCandidateB.replay
    var claimedB = claimB.claimed
    let readB = admission.CsgCoreMerkleSealedBeforeClaimedOpenRead(
        claimedB, claimB.bindingDigest, candidateB)
    if !readB.ok || claimedB.ownerId != 0 ||
       readB.beforePhysicalOrdinal !=
           projectionB.projection.beforePhysicalOrdinal:
        return fail("claimed B open read failed")

    let wrongJoin =
        admission.CsgCoreMerkleSealedBeforeClaimedProjection(
            claimA.claimed, claimB.bindingDigest)
    if wrongJoin.ok:
        return fail("A/B binding swap was accepted")
    var poisonedClaimA = claimA.claimed
    let poisonLoser =
        admission.CsgCoreMerkleSealedBeforeClaimedPoison(
            poisonedClaimA)
    if poisonLoser.ok || poisonedClaimA.ownerId != 0:
        return fail("stale claimed token was accepted")

    var readingB = readB.reading
    var staleReadingB = readB.reading
    let poisonedB =
        admission.CsgCoreMerkleSealedBeforeReadPoison(readingB)
    let poisonedBAgain =
        admission.CsgCoreMerkleSealedBeforeReadPoison(staleReadingB)
    if !poisonedB.ok || !poisonedB.winner ||
       !poisonedB.terminal || !poisonedB.poisoned ||
       poisonedB.terminalLoser || poisonedBAgain.ok ||
       staleReadingB.ownerId != 0:
        return fail("poison terminal race contract failed")

    let reissuedB = admission.CsgCoreMerkleSealBeforeAuthority(
        beforeFacts, symbolAfter, "id:sym_a")
    if !reissuedB.ok ||
       reissuedB.live.ownerId != issueB.live.ownerId ||
       reissuedB.live.generation <= issueB.live.generation:
        return fail("same binding did not reuse its terminal row")
    var reissuedLiveB = reissuedB.live
    let reissuedClaimB =
        admission.CsgCoreMerkleSealedBeforeClaim(reissuedLiveB)
    if !reissuedClaimB.ok:
        return fail("reissued B claim failed")
    var reissuedClaimedB = reissuedClaimB.claimed
    let reissuedPoisonB =
        admission.CsgCoreMerkleSealedBeforeClaimedPoison(
            reissuedClaimedB)
    if !reissuedPoisonB.ok || !reissuedPoisonB.winner ||
       !reissuedPoisonB.terminal || !reissuedPoisonB.poisoned:
        return fail("reissued B poison failed")

    var priorGeneration: int32
    for reuseIndex in 0..<129:
        let reused = admission.CsgCoreMerkleSealBeforeAuthority(
            beforeFacts, moduleAfter, "id:mod_a")
        if !reused.ok || reused.live.generation <= priorGeneration:
            return fail("129-slot reuse issue failed")
        let reusedGeneration = reused.live.generation
        if reusedGeneration <= priorGeneration:
            return fail("generation did not advance on reuse")
        priorGeneration = reusedGeneration
        var reusedLive = reused.live
        let reusedClaim =
            admission.CsgCoreMerkleSealedBeforeClaim(reusedLive)
        if !reusedClaim.ok:
            return fail("reused live claim failed")
        let reusedProjection =
            admission.CsgCoreMerkleSealedBeforeClaimedProjection(
                reusedClaim.claimed,
                reusedClaim.bindingDigest)
        if !reusedProjection.ok ||
           reusedProjection.projection.beforePhysicalOrdinal < 0:
            return fail("reused projection failed")
        var reusedClaimed = reusedClaim.claimed
        let reusedPoison =
            admission.CsgCoreMerkleSealedBeforeClaimedPoison(
                reusedClaimed)
        if !reusedPoison.ok || !reusedPoison.winner ||
           !reusedPoison.terminal || !reusedPoison.poisoned ||
           reusedPoison.terminalLoser:
            return fail("reused poison failed")

    return 0
