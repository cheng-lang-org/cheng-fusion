import std/system as system
import cheng/core/tooling/held_output_fd as heldfd

fn main(): int32 =
    var ledger: system.RuntimeAllocationLedgerSessionCapability
    if !system.RuntimeAllocationLedgerSessionOwnerBegin(
           uint64(1073741824), ledger):
        return 1
    let generation = ledger.generation
    if !heldfd.HeldOutputFdRegistryInitializeBeforeWorkload():
        return 2
    let closed = system.RuntimeAllocationLedgerSessionOwnerClose(ledger)
    if !closed.ok || !closed.receipt.complete ||
       closed.receipt.active || !closed.receipt.closed ||
       closed.receipt.capabilityGeneration != generation ||
       closed.receipt.ownerGeneration != generation ||
       closed.receipt.backingLimit != uint64(1073741824) ||
       closed.receipt.liveBackingBytes !=
           closed.receipt.controlPlaneBackingBytes ||
       closed.receipt.liveMappedVirtualBytes != uint64(0) ||
       closed.receipt.liveAllocationCount != uint64(0) ||
       closed.receipt.liveMappingCount != uint64(0) ||
       closed.receipt.liveHandleCount != uint64(0) ||
       !closed.receipt.rawManagedPointerAbaProven ||
       !closed.receipt.recursiveLockProven:
        return 3
    if ledger.handle != uint64(0) ||
       ledger.generation != uint64(0) ||
       ledger.nonce0 != uint64(0) ||
       ledger.nonce1 != uint64(0):
        return 4
    return 0
