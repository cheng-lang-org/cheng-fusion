import std/system
import std/hashmaps as hashmaps

type
    ReproBox5 = ref object
        m: hashmaps.HashMapStrInt

fn reproRoundtrip5(b: var ReproBox5) =
    var wrapper = b.m
    b.m = hashmaps.HashMapStrInt()
    b.m = wrapper

fn main() =
    var b: ReproBox5 = new(ReproBox5)
    hashmaps.HashMapStrIntInitInPlace(b.m, 64)
    reproRoundtrip5(b)
    echo("repro_orc_boxfield_c5 ok")
