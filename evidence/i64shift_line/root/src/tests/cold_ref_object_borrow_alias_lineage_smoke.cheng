type
    ColdRefObjectAliasLineageCell =
        value: int32

    ColdRefObjectAliasLineageInner = ref object
        cell: ColdRefObjectAliasLineageCell

    ColdRefObjectAliasLineageOuter = ref object
        inner: ColdRefObjectAliasLineageInner

fn ColdRefObjectAliasLineageRead(
        cell: var ColdRefObjectAliasLineageCell): int32 =
    return cell.value

fn ColdRefObjectAliasLineageWrite(
        cell: var ColdRefObjectAliasLineageCell) =
    cell.value = 89

fn ColdRefObjectAliasLineageMutate(
        out: var ColdRefObjectAliasLineageOuter): bool =
    var inner = out.inner
    let before = inner.cell.value
    if before != 0:
        return false
    ColdRefObjectAliasLineageWrite(inner.cell)
    let after = ColdRefObjectAliasLineageRead(inner.cell)
    return after == 89

fn main(): int32 =
    var out = new(ColdRefObjectAliasLineageOuter)
    out.inner = new(ColdRefObjectAliasLineageInner)
    if !ColdRefObjectAliasLineageMutate(out):
        return 1
    if out.inner.cell.value != 89:
        return 2
    return 0
