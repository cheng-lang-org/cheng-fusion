# C4b-1 验证: arena runtime 换底后 (1) 语义等价 (2) 大 arena ≥1MB 继承 mmap
# 分级, ArenaRelease 真还 OS。
import std/os as os
import cheng/core/runtime/arena as arenamod

@importc("cheng_mm_free_count")
fn amFreeCount(): int64

fn semantics(): int32 =
    var a = arenamod.ArenaInit(32, 8)
    let first = arenamod.ArenaAllocBytes(a, 3)
    if arenamod.ArenaBytesOffset(first) != 0:
        return 1
    arenamod.ArenaSetByte(a, first, 0, 7)
    arenamod.ArenaSetByte(a, first, 1, 9)
    if arenamod.ArenaGetByte(a, first, 0) != 7:
        return 2
    if arenamod.ArenaGetByte(a, first, 1) != 9:
        return 3
    let second = arenamod.ArenaAllocBytesAligned(a, 5, 4)
    if arenamod.ArenaBytesOffset(second) != 4:
        return 4
    if arenamod.ArenaUsed(a) != 9:
        return 5
    arenamod.ArenaReset(a)
    if arenamod.ArenaUsed(a) != 0:
        return 6
    let zeroed = arenamod.ArenaAllocZeroBytes(a, 2)
    if arenamod.ArenaGetByte(a, zeroed, 0) != 0:
        return 7
    var arr = arenamod.ArenaArrayInt32Init()
    arenamod.ArenaArrayInt32Add(a, arr, 100)
    arenamod.ArenaArrayInt32Add(a, arr, 200)
    arenamod.ArenaArrayInt32Add(a, arr, 300)
    if arenamod.ArenaArrayInt32Get(a, arr, 0) != 100:
        return 8
    if arenamod.ArenaArrayInt32Get(a, arr, 2) != 300:
        return 9
    arenamod.ArenaArrayInt32Set(a, arr, 1, 250)
    if arenamod.ArenaArrayInt32Get(a, arr, 1) != 250:
        return 10
    # grow 跨越: 填到触发 arena grow (realloc 路径)
    var big = arenamod.ArenaArrayInt32Init()
    for i in 0..<64:
        arenamod.ArenaArrayInt32Add(a, big, i * 3)
    if arenamod.ArenaArrayInt32Get(a, big, 63) != 189:
        return 11
    arenamod.ArenaRelease(a)
    return 0

fn rssReturn(): int32 =
    # 8 轮 x 8MB arena (≥1MB → mmap 分级): Release 即 munmap, RSS 增长 <16MB
    let rssStart = os.ProcessRssBytes()
    let freeStart = amFreeCount()
    for round in 0..<8:
        var a = arenamod.ArenaInit(8388608, 8)
        let blk = arenamod.ArenaAllocBytes(a, 8388600)
        # 逐页触写确保驻留
        var off: int32 = 0
        while off < 8388600:
            arenamod.ArenaSetByte(a, blk, off, 7)
            off = off + 4096
        arenamod.ArenaRelease(a)
    if amFreeCount() - freeStart < int64(8):
        return 21
    let growth = os.ProcessRssBytes() - rssStart
    if growth > int64(16777216):
        return 20
    return 0

fn main(): int32 =
    let s = semantics()
    if s != 0:
        return s
    return rssReturn()
