import std/cmdline as cmdline
import cheng/std/bytes_layout as layout
import cheng/core/analysis/ownership_drop_ir as odir

fn cidAssert(ok: bool, message: str) =
    if !ok:
        panic(message)

fn buildCanonicalCidFixture(
        ir: var odir.OwnershipDropIr,
        analysis: var odir.OwnershipDropAnalysis) =
    odir.OwnershipDropIrInit(ir)
    let root = odir.OwnershipDropRootScopeId(ir)
    let leafA = odir.OwnershipDropRegisterLeafType(
        ir, "CidLeafA", 501)
    let leafB = odir.OwnershipDropRegisterLeafType(
        ir, "CidLeafB", 502)
    var fieldTypes: int32[]
    add(fieldTypes, leafA)
    add(fieldTypes, leafB)
    let _ = odir.OwnershipDropRegisterAggregateType(
        ir, "CidPair", 503, fieldTypes)
    let entry = odir.OwnershipDropAddBlock(ir, root)
    odir.OwnershipDropSetEntryBlock(ir, entry)
    let exitBlock = odir.OwnershipDropAddBlock(ir, root)
    var cleanup: int32[]
    var defers: int32[]
    let _ = odir.OwnershipDropAddEdge(
        ir,
        entry,
        exitBlock,
        odir.OwnershipDropEdgeReturn,
        -1,
        cleanup,
        defers)
    odir.OwnershipDropAnalyzeCanonical(ir, analysis)

fn runCanonicalCidPositive() =
    var ir: odir.OwnershipDropIr
    var analysis: odir.OwnershipDropAnalysis
    buildCanonicalCidFixture(ir, analysis)
    cidAssert(
        odir.OwnershipDropIrCidSchemaFieldCount() == 12 &&
        odir.OwnershipDropAnalysisCidSchemaFieldCount() == 12,
        "ownership drop CID smoke: schema field count")
    let irCid = odir.OwnershipDropIrCanonicalCid(ir)
    let irCidRepeated = odir.OwnershipDropIrCanonicalCid(ir)
    let analysisCid =
        odir.OwnershipDropAnalysisCanonicalCid(ir, analysis)
    let analysisCidRepeated =
        odir.OwnershipDropAnalysisCanonicalCid(ir, analysis)
    cidAssert(
        layout.FixedBytes32Equal(irCid, irCidRepeated) &&
        layout.FixedBytes32Equal(
            analysisCid, analysisCidRepeated) &&
        !layout.FixedBytes32Equal(irCid, layout.FixedBytes32()) &&
        !layout.FixedBytes32Equal(
            analysisCid, layout.FixedBytes32()) &&
        !layout.FixedBytes32Equal(irCid, analysisCid),
        "ownership drop CID smoke: repeated computation drift")

    ir.types[0].name = "CidLeafAChanged"
    let fieldMutatedCid = odir.OwnershipDropIrCanonicalCid(ir)
    cidAssert(
        !layout.FixedBytes32Equal(irCid, fieldMutatedCid),
        "ownership drop CID smoke: UTF-8 field mutation ignored")
    ir.types[0].name = "CidLeafA"

    let firstFieldType = ir.typeFieldTypeIds[0]
    ir.typeFieldTypeIds[0] = ir.typeFieldTypeIds[1]
    ir.typeFieldTypeIds[1] = firstFieldType
    let orderMutatedCid = odir.OwnershipDropIrCanonicalCid(ir)
    cidAssert(
        !layout.FixedBytes32Equal(irCid, orderMutatedCid),
        "ownership drop CID smoke: sequence order mutation ignored")
    let swappedFieldType = ir.typeFieldTypeIds[0]
    ir.typeFieldTypeIds[0] = ir.typeFieldTypeIds[1]
    ir.typeFieldTypeIds[1] = swappedFieldType

    analysis.fixedPointSteps = analysis.fixedPointSteps + 1
    let analysisFieldMutatedCid =
        odir.OwnershipDropAnalysisCanonicalCid(ir, analysis)
    cidAssert(
        !layout.FixedBytes32Equal(
            analysisCid, analysisFieldMutatedCid),
        "ownership drop CID smoke: analysis field mutation ignored")
    echo("ownership_drop_ir_cid ok deterministic=1 mutations=3")

fn runCanonicalCidTruncated() =
    var ir: odir.OwnershipDropIr
    var analysis: odir.OwnershipDropAnalysis
    buildCanonicalCidFixture(ir, analysis)
    setLen(ir.typeFieldTypeIds, ir.typeFieldTypeIds.len - 1)
    let _ = odir.OwnershipDropIrCanonicalCid(ir)
    panic("ownership drop CID smoke: truncated CSR accepted")

fn runCanonicalCidUnconverged() =
    var ir: odir.OwnershipDropIr
    var analysis: odir.OwnershipDropAnalysis
    buildCanonicalCidFixture(ir, analysis)
    analysis.converged = false
    let _ = odir.OwnershipDropAnalysisCanonicalCid(ir, analysis)
    panic("ownership drop CID smoke: unconverged analysis accepted")

fn runCanonicalCidAnalysisReleased() =
    var ir: odir.OwnershipDropIr
    var analysis: odir.OwnershipDropAnalysis
    buildCanonicalCidFixture(ir, analysis)
    analysis.storageReleased = true
    let _ = odir.OwnershipDropAnalysisCanonicalCid(ir, analysis)
    panic("ownership drop CID smoke: released analysis accepted")

fn runCanonicalCidIrReleased() =
    var ir: odir.OwnershipDropIr
    var analysis: odir.OwnershipDropAnalysis
    buildCanonicalCidFixture(ir, analysis)
    ir.storageReleased = true
    let _ = odir.OwnershipDropIrCanonicalCid(ir)
    panic("ownership drop CID smoke: released IR accepted")

fn main(argc: int32, argv: str*): int32 =
    argc
    argv
    cmdline.CaptureCmdLine(argc, argv)
    let mode = cmdline.ParamStr(1)
    if mode == "positive-cid":
        runCanonicalCidPositive()
    elif mode == "cid-truncated":
        runCanonicalCidTruncated()
    elif mode == "cid-unconverged":
        runCanonicalCidUnconverged()
    elif mode == "cid-analysis-released":
        runCanonicalCidAnalysisReleased()
    elif mode == "cid-ir-released":
        runCanonicalCidIrReleased()
    else:
        panic("ownership drop CID smoke: unknown mode")
    return 0
