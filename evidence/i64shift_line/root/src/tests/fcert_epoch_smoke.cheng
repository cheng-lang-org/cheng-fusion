# fcert_epoch_smoke.cheng (tag fe4): epoch-aware finality certificate.
#
# Four committee members derive keys via keyPairFromSeedEpoch with epochs
# alternating 0/1/0/1 (members 1/3 epoch0, members 2/4 epoch1) and sign one
# fixed 32-byte payload under their own epoch. With f=1 the quorum bar is
# 2f+1 = 3 valid votes. Assertions, all exact:
#   S1 all four mixed-epoch votes -> QuorumCheck(minEpoch=0) Ok(true)
#   S2 only votes of members 1+2  -> QuorumCheck Err "quorum not reached"
#   S3 one tampered signature     -> FcertAddEntry Err "bad signature"
#   S4 votes 1+2 at minEpoch=1    -> QuorumCheck Err (epoch gate + quorum)
#   S5 same voter cid twice       -> FcertAddEntry Err (duplicate)

import std/os
import std/system
import std/rawbytes
import cheng/std/bytes_layout as layout
import cheng/libp2p/crypto/ed25519/ed25519 as ed
import cheng/chain/finality_certificate_epoch as fcerte

fn HexToBytes(h: str): Bytes =
    let n: int32 = h.len / 2
    var out = BytesAlloc(n)
    var i: int32
    while i < n:
        var hi: int32 = 0
        var lo: int32 = 0
        let c1: int32 = BytesFromHexChar(osSliceStr(h, i * 2, i * 2))
        let c2: int32 = BytesFromHexChar(osSliceStr(h, i * 2 + 1, i * 2 + 1))
        hi = c1
        lo = c2
        BytesSet(out, i, hi * 16 + lo)
        i = i + 1
    return out

fn BytesFromHexChar(c: str): int32 =
    if c == "0":
        return 0
    if c == "1":
        return 1
    if c == "2":
        return 2
    if c == "3":
        return 3
    if c == "4":
        return 4
    if c == "5":
        return 5
    if c == "6":
        return 6
    if c == "7":
        return 7
    if c == "8":
        return 8
    if c == "9":
        return 9
    if c == "a" or c == "A":
        return 10
    if c == "b" or c == "B":
        return 11
    if c == "c" or c == "C":
        return 12
    if c == "d" or c == "D":
        return 13
    if c == "e" or c == "E":
        return 14
    if c == "f" or c == "F":
        return 15
    return 0

# fixed 32-byte payload in CkptTag style: marker byte at [0], rest zero
fn Fe4MsgTag(b: int32): Bytes =
    var raw = BytesAlloc(32)
    BytesSet(raw, 0, b)
    return raw

fn main(): int32 =
    var rc: int32 = 0

    # four member seeds: RFC 8032 TEST1/TEST2 + two fixed hex seeds
    let seed1 = HexToBytes("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
    let seed2 = HexToBytes("4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb")
    let seed3 = HexToBytes("c5aa8df43f9f837bedb7442f31dcb7b166d38535076f094b85ce3a2e0b4458f7")
    let seed4 = HexToBytes("3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c")

    # members 1/3 sign under epoch 0, members 2/4 under epoch 1
    let kp1 = ed.keyPairFromSeedEpoch(seed1, 0)
    if !kp1.ok:
        return 1
    let kp2 = ed.keyPairFromSeedEpoch(seed2, 1)
    if !kp2.ok:
        return 1
    let kp3 = ed.keyPairFromSeedEpoch(seed3, 0)
    if !kp3.ok:
        return 1
    let kp4 = ed.keyPairFromSeedEpoch(seed4, 1)
    if !kp4.ok:
        return 1
    let pk1: Bytes = kp1.value.publicKey.data
    let priv1: Bytes = kp1.value.privateKey.data
    let pk2: Bytes = kp2.value.publicKey.data
    let priv2: Bytes = kp2.value.privateKey.data
    let pk3: Bytes = kp3.value.publicKey.data
    let priv3: Bytes = kp3.value.privateKey.data
    let pk4: Bytes = kp4.value.publicKey.data
    let priv4: Bytes = kp4.value.privateKey.data

    # voter cid = sha-less commitment to the pubkey bytes (pk is 32 bytes)
    let cid1res = layout.FixedBytes32FromBytes(pk1)
    if !cid1res.ok:
        return 1
    let cid2res = layout.FixedBytes32FromBytes(pk2)
    if !cid2res.ok:
        return 1
    let cid3res = layout.FixedBytes32FromBytes(pk3)
    if !cid3res.ok:
        return 1
    let cid4res = layout.FixedBytes32FromBytes(pk4)
    if !cid4res.ok:
        return 1
    let cid1 = cid1res.value
    let cid2 = cid2res.value
    let cid3 = cid3res.value
    let cid4 = cid4res.value

    # fixed 32-byte payload; every member signs these exact bytes
    let msg = Fe4MsgTag(7)
    let phRes = layout.FixedBytes32FromBytes(msg)
    if !phRes.ok:
        return 1
    let payloadHash = phRes.value

    let s1res = ed.signEd25519RawEpoch(priv1, msg, 0)
    if !s1res.ok:
        return 1
    let sig1: Bytes = s1res.value
    let s2res = ed.signEd25519RawEpoch(priv2, msg, 1)
    if !s2res.ok:
        return 1
    let sig2: Bytes = s2res.value
    let s3res = ed.signEd25519RawEpoch(priv3, msg, 0)
    if !s3res.ok:
        return 1
    let sig3: Bytes = s3res.value
    let s4res = ed.signEd25519RawEpoch(priv4, msg, 1)
    if !s4res.ok:
        return 1
    let sig4: Bytes = s4res.value

    var committee: Bytes[]
    add(committee, pk1)
    add(committee, pk2)
    add(committee, pk3)
    add(committee, pk4)

    # --- S1: all four mixed-epoch votes reach quorum at minEpoch=0 ---
    var cert1: fcerte.EpochCert
    cert1.height = Int64(400)
    cert1.payloadHash = payloadHash
    let a11 = fcerte.FcertAddEntry(cert1, cid1, pk1, msg, sig1, 0)
    if !a11.ok or !a11.value:
        os.WriteLine(os.Get_stderr(), "s1: vote member1 rejected")
        rc = rc + 1
    let a12 = fcerte.FcertAddEntry(cert1, cid2, pk2, msg, sig2, 1)
    if !a12.ok or !a12.value:
        os.WriteLine(os.Get_stderr(), "s1: vote member2 rejected")
        rc = rc + 1
    let a13 = fcerte.FcertAddEntry(cert1, cid3, pk3, msg, sig3, 0)
    if !a13.ok or !a13.value:
        os.WriteLine(os.Get_stderr(), "s1: vote member3 rejected")
        rc = rc + 1
    let a14 = fcerte.FcertAddEntry(cert1, cid4, pk4, msg, sig4, 1)
    if !a14.ok or !a14.value:
        os.WriteLine(os.Get_stderr(), "s1: vote member4 rejected")
        rc = rc + 1
    let q1 = fcerte.FcertQuorumCheck(cert1, committee, 1, 0)
    if !q1.ok or !q1.value:
        os.WriteLine(os.Get_stderr(), "s1: four mixed-epoch votes failed quorum")
        rc = rc + 1

    # --- S2: only members 1+2 -> below 2f+1, exact quorum error text ---
    var cert2: fcerte.EpochCert
    cert2.height = Int64(401)
    cert2.payloadHash = payloadHash
    let a21 = fcerte.FcertAddEntry(cert2, cid1, pk1, msg, sig1, 0)
    if !a21.ok or !a21.value:
        os.WriteLine(os.Get_stderr(), "s2: vote member1 rejected")
        rc = rc + 1
    let a22 = fcerte.FcertAddEntry(cert2, cid2, pk2, msg, sig2, 1)
    if !a22.ok or !a22.value:
        os.WriteLine(os.Get_stderr(), "s2: vote member2 rejected")
        rc = rc + 1
    let q2 = fcerte.FcertQuorumCheck(cert2, committee, 1, 0)
    if q2.ok:
        os.WriteLine(os.Get_stderr(), "s2: two-vote cert reached quorum")
        rc = rc + 1
    else:
        if !(q2.err.msg == "quorum not reached"):
            os.WriteLine(os.Get_stderr(), "s2: wrong error text")
            rc = rc + 1

    # --- S3: tampered signature refused at admission ---
    var cert3: fcerte.EpochCert
    cert3.height = Int64(402)
    cert3.payloadHash = payloadHash
    let badSig = BytesSlice(sig1, 0, sig1.len)
    BytesSet(badSig, 0, (BytesGet(badSig, 0) + 1) % 256)
    let a31 = fcerte.FcertAddEntry(cert3, cid1, pk1, msg, badSig, 0)
    if a31.ok:
        os.WriteLine(os.Get_stderr(), "s3: tampered signature admitted")
        rc = rc + 1
    else:
        if !(a31.err.msg == "bad signature"):
            os.WriteLine(os.Get_stderr(), "s3: wrong error text")
            rc = rc + 1

    # --- S4: minEpoch=1 gates member1's epoch0 vote; both gates reject ---
    var cert4: fcerte.EpochCert
    cert4.height = Int64(403)
    cert4.payloadHash = payloadHash
    let a41 = fcerte.FcertAddEntry(cert4, cid1, pk1, msg, sig1, 0)
    if !a41.ok or !a41.value:
        os.WriteLine(os.Get_stderr(), "s4: vote member1 rejected")
        rc = rc + 1
    let a42 = fcerte.FcertAddEntry(cert4, cid2, pk2, msg, sig2, 1)
    if !a42.ok or !a42.value:
        os.WriteLine(os.Get_stderr(), "s4: vote member2 rejected")
        rc = rc + 1
    let q4 = fcerte.FcertQuorumCheck(cert4, committee, 1, 1)
    if q4.ok:
        os.WriteLine(os.Get_stderr(), "s4: epoch-gated cert passed")
        rc = rc + 1

    # --- S5: duplicate voter cid refused on second admission ---
    var cert5: fcerte.EpochCert
    cert5.height = Int64(404)
    cert5.payloadHash = payloadHash
    let a51 = fcerte.FcertAddEntry(cert5, cid1, pk1, msg, sig1, 0)
    if !a51.ok or !a51.value:
        os.WriteLine(os.Get_stderr(), "s5: first vote rejected")
        rc = rc + 1
    let a52 = fcerte.FcertAddEntry(cert5, cid1, pk1, msg, sig1, 0)
    if a52.ok:
        os.WriteLine(os.Get_stderr(), "s5: duplicate vote admitted")
        rc = rc + 1

    if rc == 0:
        echo("fcert_epoch_smoke fe4 ok")
    return rc
