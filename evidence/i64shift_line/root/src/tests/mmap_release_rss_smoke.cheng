# C4 mmap 分级回归夹具: 大块 (≥1MB) runtime malloc 走 mmap, free 即 munmap
# 真还 OS。16 轮 x 8MB malloc+free (逐页触写确保真驻留) = 128MB 流量, RSS
# 增长必须 <16MB (单活跃块量级); 旧 malloc pool 行为 (free 不还 OS) 会累积
# ~128MB — 该断言即 freed-but-not-returned 回归的哨兵。
# 实测 (2026-07-03, commit 735b00c31): 峰值 RSS 14.2MB, rc=0。
import std/os as os

type
    MmapSmokeU8Ptr = uint8 *

@importc("cheng_malloc")
fn mmapSmokeMalloc(size: int32): ptr

@importc("cheng_free")
fn mmapSmokeFree(p: ptr)

@importc("cheng_mm_free_count")
fn mmapSmokeFreeCount(): int64

fn mmapSmokeTouchPages(base: ptr, size: int32) =
    var off: int32 = 0
    while off < size:
        *(MmapSmokeU8Ptr(ptr(uint64(base) + uint64(off)))) = uint8(7)
        off = off + 4096

fn main(): int32 =
    let rssStart = os.ProcessRssBytes()
    let freeStart = mmapSmokeFreeCount()
    for round in 0..<16:
        let p = mmapSmokeMalloc(8388608)
        if p == nil:
            return 1
        mmapSmokeTouchPages(p, 8388608)
        mmapSmokeFree(p)
    let growth = os.ProcessRssBytes() - rssStart
    if mmapSmokeFreeCount() - freeStart < int64(16):
        # 16 次 free 必须全记账 (registry-checked 真释放)
        return 11
    if growth > int64(16777216):
        # 驻留增长超单活跃块级 = munmap 归还失效 (freed-not-returned 回归)
        return 10
    return 0
