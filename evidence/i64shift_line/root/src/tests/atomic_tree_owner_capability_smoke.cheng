import std/atomic
import std/cmdline
import std/os
import std/rawbytes
import std/strings
import std/thread

const atomicTreeOwnerConcurrentWorkers: int32 = 4

var
    atomicTreeOwnerConcurrentNextWorker: atomic.I32
    atomicTreeOwnerConcurrentReady: atomic.I32
    atomicTreeOwnerConcurrentDone: atomic.I32
    atomicTreeOwnerConcurrentParent: str
    atomicTreeOwnerConcurrentRows: int32[]
    atomicTreeOwnerConcurrentReceiptValid: int32[]

fn RequireFlag(name: str): str =
    var value: str
    assert(cmdline.readFlagValue(name, value) && value.len > 0,
           "atomic tree owner smoke: required flag missing")
    return value

fn MakeRecord(seed: int32): rawbytes.Bytes =
    var out = rawbytes.BytesAlloc(os.AtomicTreeOwnerFixedRecordBytes)
    assert(rawbytes.BytesLen(out) == os.AtomicTreeOwnerFixedRecordBytes,
           "atomic tree owner smoke: record allocation failed")
    for row in 0..<os.AtomicTreeOwnerFixedRecordBytes:
        rawbytes.BytesSet(out, row, (seed + row) & 255)
    return out

fn AtomicTreeOwnerConcurrentBarrier() =
    os.CsgCurrentHeadLeaseRegistryLock()
    let _ = atomic.AddI32(atomicTreeOwnerConcurrentReady, 1)
    os.CsgCurrentHeadLeaseRegistryNotifyAll()
    while atomic.LoadI32(atomicTreeOwnerConcurrentReady) <
          atomicTreeOwnerConcurrentWorkers:
        let epoch = os.CsgCurrentHeadLeaseRegistryEpoch()
        os.CsgCurrentHeadLeaseRegistryUnlock()
        os.CsgCurrentHeadLeaseRegistryWait(epoch)
        os.CsgCurrentHeadLeaseRegistryLock()
    os.CsgCurrentHeadLeaseRegistryUnlock()

fn AtomicTreeOwnerConcurrentWorker() =
    let worker = atomic.FetchAddI32(
        atomicTreeOwnerConcurrentNextWorker, 1)
    assert(worker >= 0 && worker < atomicTreeOwnerConcurrentWorkers,
           "atomic tree owner smoke: concurrent worker row invalid")
    let workerParent = os.JoinPath(
        atomicTreeOwnerConcurrentParent,
        strings.ConcatStr(
            "concurrent-parent-", strings.IntToStr(worker)))
    let workerFinal = strings.ConcatStr(
        "concurrent-root-", strings.IntToStr(worker))
    let workerOpen = os.AtomicTreeOpenVerifiedExclusiveOrAbsent(
        workerParent, workerFinal)
    assert(IsOk(workerOpen), Error(workerOpen))
    let workerAbsent = Value(workerOpen)
    assert(workerAbsent.kind == os.AtomicTreeExclusiveAbsent,
           "atomic tree owner smoke: concurrent root was not absent")
    var source = workerAbsent.tree
    AtomicTreeOwnerConcurrentBarrier()

    var owner: os.AtomicTreeOwner
    var err: str
    assert(os.AtomicTreeOwnerBeginFromExclusiveAbsent(
               source, owner, err), err)
    assert(source == uint64(0),
           "atomic tree owner smoke: concurrent source was not cleared")
    var record = MakeRecord(131 + worker)
    var terminal = MakeRecord(211 + worker)
    defer:
        rawbytes.BytesFree(record)
        rawbytes.BytesFree(terminal)

    var staleBeforeAppend = owner
    assert(os.AtomicTreeOwnerAppendFixed(owner, 0, record, err), err)
    assert(!os.AtomicTreeOwnerAppendFixed(
               staleBeforeAppend, 1, record, err),
           "atomic tree owner smoke: concurrent stale append succeeded")
    assert(os.AtomicTreeOwnerSealTerminal(owner, 1, terminal, err), err)
    var terminalReplay = owner
    assert(!os.AtomicTreeOwnerAppendFixed(owner, 2, record, err),
           "atomic tree owner smoke: concurrent terminal reopened")

    var receipt: os.AtomicTreeOwnerCloseReceipt
    assert(os.AtomicTreeOwnerCloseInto(owner, receipt, err), err)
    assert(os.AtomicTreeOwnerIsEmpty(owner),
           "atomic tree owner smoke: concurrent close source live")
    assert(os.AtomicTreeOwnerCloseReceiptValid(receipt) &&
           receipt.recordCount == 2 && receipt.terminalRow == 1 &&
           receipt.retainedBytes == Int64(1024),
           "atomic tree owner smoke: concurrent receipt invalid")
    var duplicateReceipt: os.AtomicTreeOwnerCloseReceipt
    assert(!os.AtomicTreeOwnerCloseInto(
               terminalReplay, duplicateReceipt, err),
           "atomic tree owner smoke: concurrent close replay succeeded")
    atomicTreeOwnerConcurrentRows[worker] = receipt.row
    atomicTreeOwnerConcurrentReceiptValid[worker] = 1
    let _ = atomic.AddI32(atomicTreeOwnerConcurrentDone, 1)

fn main(): int32 =
    let parent = RequireFlag("--parent")
    let finalName = RequireFlag("--final")
    assert(os.AtomicTreeOwnerRegistryInitializeBeforeWorkload(),
           "atomic tree owner smoke: registry init failed")

    let openResult = os.AtomicTreeOpenVerifiedExclusiveOrAbsent(
        parent, finalName)
    assert(IsOk(openResult), Error(openResult))
    let absent = Value(openResult)
    assert(absent.kind == os.AtomicTreeExclusiveAbsent,
           "atomic tree owner smoke: expected absent root")
    var absentTree = absent.tree
    var staleAbsentTree = absentTree
    var owner: os.AtomicTreeOwner
    var err: str
    assert(os.AtomicTreeOwnerBeginFromExclusiveAbsent(
               absentTree, owner, err), err)
    assert(absentTree == uint64(0),
           "atomic tree owner smoke: absent source was not cleared")
    var staleTransaction = os.AtomicTreeBeginFromExclusiveAbsent(
        staleAbsentTree, ".atomic-tree-owner-stale")
    assert(IsErr(staleTransaction),
           "atomic tree owner smoke: copied absent handle remained live")
    assert(IsErr(os.AtomicTreeClose(staleAbsentTree)),
           "atomic tree owner smoke: copied absent handle closed twice")
    assert(!os.AtomicTreeOwnerIsEmpty(owner),
           "atomic tree owner smoke: owner issue returned empty")

    var staleBeforeMove = owner
    var movedOwner: os.AtomicTreeOwner
    assert(os.AtomicTreeOwnerMove(owner, movedOwner, err), err)
    assert(os.AtomicTreeOwnerIsEmpty(owner),
           "atomic tree owner smoke: move did not clear source")
    assert(movedOwner.generation == staleBeforeMove.generation + 1 &&
           movedOwner.owner == staleBeforeMove.owner + 1,
           "atomic tree owner smoke: move token did not rotate")

    var record0 = MakeRecord(11)
    var record1 = MakeRecord(37)
    var terminalRecord = MakeRecord(91)
    var shortRecord = rawbytes.BytesAlloc(
        os.AtomicTreeOwnerFixedRecordBytes - 1)
    defer:
        rawbytes.BytesFree(record0)
        rawbytes.BytesFree(record1)
        rawbytes.BytesFree(terminalRecord)
        rawbytes.BytesFree(shortRecord)

    assert(!os.AtomicTreeOwnerAppendFixed(
               staleBeforeMove, 0, record0, err),
           "atomic tree owner smoke: stale copied owner appended")
    let beforeShort = movedOwner
    assert(!os.AtomicTreeOwnerAppendFixed(
               movedOwner, 0, shortRecord, err) &&
           movedOwner.row == beforeShort.row &&
           movedOwner.generation == beforeShort.generation &&
           movedOwner.owner == beforeShort.owner,
           "atomic tree owner smoke: short record changed authority")
    assert(!os.AtomicTreeOwnerAppendFixed(
               movedOwner, 1, record1, err),
           "atomic tree owner smoke: missing row accepted")

    var staleBeforeAppend0 = movedOwner
    assert(os.AtomicTreeOwnerAppendFixed(
               movedOwner, 0, record0, err), err)
    assert(movedOwner.generation == staleBeforeAppend0.generation + 1 &&
           movedOwner.owner == staleBeforeAppend0.owner + 1,
           "atomic tree owner smoke: append token did not rotate")
    assert(!os.AtomicTreeOwnerAppendFixed(
               staleBeforeAppend0, 1, record1, err),
           "atomic tree owner smoke: pre-append token replay succeeded")
    let beforeReplay = movedOwner
    assert(!os.AtomicTreeOwnerAppendFixed(
               movedOwner, 0, record0, err) &&
           movedOwner.generation == beforeReplay.generation &&
           movedOwner.owner == beforeReplay.owner,
           "atomic tree owner smoke: durable row replay changed authority")

    assert(os.AtomicTreeOwnerAppendFixed(
               movedOwner, 1, record1, err), err)
    var read0: rawbytes.Bytes
    var read1: rawbytes.Bytes
    defer:
        rawbytes.BytesFree(read0)
        rawbytes.BytesFree(read1)
    assert(os.AtomicTreeOwnerReadFixed(
               movedOwner, 0, read0, err) &&
           rawbytes.BytesEqual(read0, record0),
           "atomic tree owner smoke: row0 stable read mismatch")
    assert(os.AtomicTreeOwnerReadFixed(
               movedOwner, 1, read1, err) &&
           rawbytes.BytesEqual(read1, record1),
           "atomic tree owner smoke: row1 stable read mismatch")
    assert(!os.AtomicTreeOwnerReadFixed(
               movedOwner, 2, read1, err),
           "atomic tree owner smoke: missing stable row accepted")

    var staleBeforeTerminal = movedOwner
    assert(os.AtomicTreeOwnerSealTerminal(
               movedOwner, 2, terminalRecord, err), err)
    assert(movedOwner.generation == staleBeforeTerminal.generation + 1 &&
           movedOwner.owner == staleBeforeTerminal.owner + 1,
           "atomic tree owner smoke: terminal token did not rotate")
    assert(!os.AtomicTreeOwnerSealTerminal(
               staleBeforeTerminal, 2, terminalRecord, err),
           "atomic tree owner smoke: stale terminal replay succeeded")
    let terminalAuthority = movedOwner
    assert(!os.AtomicTreeOwnerAppendFixed(
               movedOwner, 3, record0, err),
           "atomic tree owner smoke: append after terminal succeeded")
    assert(!os.AtomicTreeOwnerSealTerminal(
               movedOwner, 3, terminalRecord, err) &&
           movedOwner.generation == terminalAuthority.generation &&
           movedOwner.owner == terminalAuthority.owner,
           "atomic tree owner smoke: terminal reopen changed authority")
    var terminalRead: rawbytes.Bytes
    defer:
        rawbytes.BytesFree(terminalRead)
    assert(os.AtomicTreeOwnerReadFixed(
               movedOwner, 2, terminalRead, err) &&
           rawbytes.BytesEqual(terminalRead, terminalRecord),
           "atomic tree owner smoke: terminal stable read mismatch")

    var closeReplay = movedOwner
    var receipt: os.AtomicTreeOwnerCloseReceipt
    assert(os.AtomicTreeOwnerCloseInto(movedOwner, receipt, err), err)
    assert(os.AtomicTreeOwnerIsEmpty(movedOwner),
           "atomic tree owner smoke: close did not clear owner")
    assert(os.AtomicTreeOwnerCloseReceiptValid(receipt) &&
           receipt.recordCount == 3 && receipt.terminalRow == 2 &&
           receipt.retainedBytes == Int64(1536),
           "atomic tree owner smoke: close receipt invalid")
    var duplicateReceipt: os.AtomicTreeOwnerCloseReceipt
    assert(!os.AtomicTreeOwnerCloseInto(
               closeReplay, duplicateReceipt, err),
           "atomic tree owner smoke: double close succeeded")
    var mutatedReceipt = receipt
    mutatedReceipt.recordCount = mutatedReceipt.recordCount + 1
    assert(!os.AtomicTreeOwnerCloseReceiptValid(mutatedReceipt),
           "atomic tree owner smoke: count mutation accepted")

    let reopenResult = os.AtomicTreeOpenVerifiedExclusiveOrAbsent(
        parent, finalName)
    assert(IsOk(reopenResult), Error(reopenResult))
    let opened = Value(reopenResult)
    assert(opened.kind == os.AtomicTreeExclusiveOpened,
           "atomic tree owner smoke: terminal root disappeared")
    var openedTree = opened.tree
    var reopenedOwner: os.AtomicTreeOwner
    assert(!os.AtomicTreeOwnerBeginFromExclusiveAbsent(
               openedTree, reopenedOwner, err) &&
           os.AtomicTreeOwnerIsEmpty(reopenedOwner),
           "atomic tree owner smoke: terminal root reopened")
    assert(IsOk(os.AtomicTreeClose(openedTree)),
           "atomic tree owner smoke: opened root close failed")

    setLen(atomicTreeOwnerConcurrentRows,
           atomicTreeOwnerConcurrentWorkers)
    setLen(atomicTreeOwnerConcurrentReceiptValid,
           atomicTreeOwnerConcurrentWorkers)
    atomicTreeOwnerConcurrentNextWorker = atomic.NewI32(0)
    atomicTreeOwnerConcurrentReady = atomic.NewI32(0)
    atomicTreeOwnerConcurrentDone = atomic.NewI32(0)
    atomicTreeOwnerConcurrentParent = strings.CloneStr(parent)
    assert(atomicTreeOwnerConcurrentNextWorker != nil &&
           atomicTreeOwnerConcurrentReady != nil &&
           atomicTreeOwnerConcurrentDone != nil,
           "atomic tree owner smoke: concurrent atomics unavailable")
    for worker in 0..<atomicTreeOwnerConcurrentWorkers:
        let workerParent = os.JoinPath(
            parent,
            strings.ConcatStr(
                "concurrent-parent-", strings.IntToStr(worker)))
        os.CreateDir(workerParent)

    let worker0 = thread.StartFn(AtomicTreeOwnerConcurrentWorker)
    let worker1 = thread.StartFn(AtomicTreeOwnerConcurrentWorker)
    let worker2 = thread.StartFn(AtomicTreeOwnerConcurrentWorker)
    let worker3 = thread.StartFn(AtomicTreeOwnerConcurrentWorker)
    assert(thread.JoinThread(worker0) && thread.JoinThread(worker1) &&
           thread.JoinThread(worker2) && thread.JoinThread(worker3),
           "atomic tree owner smoke: concurrent join failed")
    assert(atomic.LoadI32(atomicTreeOwnerConcurrentNextWorker) ==
               atomicTreeOwnerConcurrentWorkers &&
           atomic.LoadI32(atomicTreeOwnerConcurrentDone) ==
               atomicTreeOwnerConcurrentWorkers,
           "atomic tree owner smoke: concurrent workers incomplete")
    for left in 0..<atomicTreeOwnerConcurrentWorkers:
        assert(atomicTreeOwnerConcurrentRows[left] >= 0 &&
               atomicTreeOwnerConcurrentReceiptValid[left] == 1,
               "atomic tree owner smoke: concurrent result invalid")
        for right in (left + 1)..<atomicTreeOwnerConcurrentWorkers:
            assert(atomicTreeOwnerConcurrentRows[left] !=
                       atomicTreeOwnerConcurrentRows[right],
                   "atomic tree owner smoke: concurrent row reused")

    echo("atomic_tree_owner_capability=PASS mutations=14 records=3 retained_bytes=1536 concurrent_workers=4 concurrent_records=8")
    return 0
