type
    R10Task =
        kind: str
        closureCid: str
        cacheKey: str
        cacheObjectPath: str
        cacheBindingPath: str

fn R10CacheKey(module: str, cid: str): str =
    return Fmt"{module}-{cid}"

fn R10Join(dir: str, name: str): str =
    return Fmt"{dir}/{name}"

fn R10Build(tasks: var R10Task[]): bool =
    tasks = []
    let generatedModule = "darwin_syscall_provider"
    let generatedClosureCid = "cid7"
    let generatedCacheKey = R10CacheKey(generatedModule, generatedClosureCid)
    var generatedTask: R10Task
    generatedTask.kind = "darwin_syscall"
    generatedTask.closureCid = generatedClosureCid
    generatedTask.cacheKey = generatedCacheKey
    generatedTask.cacheObjectPath = R10Join("cachedir", Fmt"{generatedCacheKey}.o")
    generatedTask.cacheBindingPath = R10Join("cachedir", Fmt"{generatedCacheKey}.binding.txt")
    add(tasks, generatedTask)
    return true

fn main(): int32 =
    var tasks: R10Task[]
    if !R10Build(tasks):
        return 10
    if tasks.len != 1:
        return 11
    if tasks[0].cacheKey != "darwin_syscall_provider-cid7":
        return 12
    if tasks[0].cacheObjectPath != "cachedir/darwin_syscall_provider-cid7.o":
        return 13
    if tasks[0].cacheBindingPath != "cachedir/darwin_syscall_provider-cid7.binding.txt":
        return 14
    echo(Fmt"r10_genkey ok key={tasks[0].cacheKey} obj={tasks[0].cacheObjectPath} bind={tasks[0].cacheBindingPath}")
    return 0
