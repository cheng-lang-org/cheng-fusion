import std/result
import std/os
import std/rawbytes as rawbytes
import std/strings
import cheng/std/bytes_layout as layout
import cheng/apps/chain_node/cheng_node as node
import cheng/apps/chain_node/cheng_node_state as state
import cheng/apps/chain_node/cheng_node_domains as cdomain
import cheng/DiLoCo/train/codec as dcodec
import cheng/DiLoCo/train/inner_step as dinner
import cheng/apps/unimaker/unimaker_edge_types as evotypes
import std/strutils as strutil

fn runOracleSmoke(core: var node.ChengNode) =
    let oracleRes = node.ChengNodeOracleSubmitFixtureRound(core, int64(22))
    assert(IsOk(oracleRes), "cheng_node stage4 smoke: oracle submit")
    let oracleQueryRes = node.ChengNodeOracleQueryText(core, "BTC/USD", true)
    assert(IsOk(oracleQueryRes), "cheng_node stage4 smoke: oracle query")
    let oracleQueryText = Value(oracleQueryRes)
    assert(strings.StrContains(oracleQueryText, "pair_key=BTC/USD"),
           "cheng_node stage4 smoke: oracle pair key")
    assert(strings.StrContains(oracleQueryText, "round_id=22"),
           "cheng_node stage4 smoke: oracle round")
    assert(strings.StrContains(oracleQueryText, "found=1"),
           "cheng_node stage4 smoke: oracle found")
    assert(strings.StrContains(oracleQueryText, "delta_count=1"),
           "cheng_node stage4 smoke: oracle delta")
    let oracleIndexRes = node.ChengNodeKeyedQueryText(core, "oracle", "pair", "BTC/USD", false)
    assert(IsOk(oracleIndexRes), "cheng_node stage4 smoke: oracle index query")
    assert(strings.StrContains(Value(oracleIndexRes), "payload_kind=oracle_pair_state"),
           "cheng_node stage4 smoke: oracle payload kind")

fn dilocoTinyBatchFill(xs: var int32[], ys: var int32[], flip: bool) =
    for s in 0..<3:
        if flip:
            add(xs, 0)
            add(xs, 1000)
            add(xs, 0)
            add(ys, 0)
            add(ys, 1000)
        else:
            add(xs, 1000)
            add(xs, 0)
            add(xs, 0)
            add(ys, 1000)
            add(ys, 0)

@borrows
fn dilocoZerosPayload(): rawbytes.Bytes =
    var zeros: int32[]
    for i in 0..<8:
        add(zeros, 0)
    var packedBytes = rawbytes.EmptyBytes()
    let packRes = dcodec.DiLoCoTrainPackI32Fill(packedBytes, zeros)
    assert(IsOk(packRes), "cheng_node stage4 smoke: pack zeros")
    return packedBytes

@borrows
fn dilocoRealDeltaPayload(flip: bool): rawbytes.Bytes =
    var base: int32[]
    for i in 0..<8:
        add(base, 0)
    var xs: int32[]
    var ys: int32[]
    dilocoTinyBatchFill(xs, ys, flip)
    var wOut: int32[]
    var deltaOut: int32[]
    let sgdRes = dinner.DiLoCoInnerSgdLinearFill(wOut, deltaOut, base, xs, ys, 3, 4, 2, 3, 1, 2)
    assert(IsOk(sgdRes), "cheng_node stage4 smoke: real inner sgd")
    var packedBytes = rawbytes.EmptyBytes()
    let packRes = dcodec.DiLoCoTrainPackI32Fill(packedBytes, deltaOut)
    assert(IsOk(packRes), "cheng_node stage4 smoke: pack delta")
    return packedBytes

fn runDilocoSmoke(core: var node.ChengNode): str =
    let jobKey = "job-alpha"
    let tmpRoot = os.GetEnvDefault("CHENG_TASK_TMPDIR", "/tmp")
    let storeRoot = strutil.Join([tmpRoot, "/evomap-diloco-artifacts"], "")
    let attachRes = cdomain.ChengNodeDilocoAttachArtifactStore(core.diloco, storeRoot)
    assert(IsOk(attachRes), "cheng_node stage4 smoke: diloco attach store")
    assert(IsOk(node.ChengNodeDilocoOpenJob(core, strings.CloneStr(jobKey), 2, 4, 60, dilocoZerosPayload(), dilocoZerosPayload())),
           "cheng_node stage4 smoke: diloco open")
    assert(IsOk(node.ChengNodeDilocoJoinCohort(core, strings.CloneStr(jobKey), "peer-alpha")),
           "cheng_node stage4 smoke: diloco join alpha")
    assert(IsOk(node.ChengNodeDilocoJoinCohort(core, strings.CloneStr(jobKey), "peer-bravo")),
           "cheng_node stage4 smoke: diloco join bravo")
    assert(IsOk(node.ChengNodeDilocoFetchLease(core, strings.CloneStr(jobKey), "peer-alpha")),
           "cheng_node stage4 smoke: diloco lease alpha")
    assert(IsOk(node.ChengNodeDilocoFetchLease(core, strings.CloneStr(jobKey), "peer-bravo")),
           "cheng_node stage4 smoke: diloco lease bravo")
    assert(IsOk(node.ChengNodeDilocoReportBarrier(core, strings.CloneStr(jobKey), "peer-alpha")),
           "cheng_node stage4 smoke: diloco barrier alpha")
    assert(IsOk(node.ChengNodeDilocoReportBarrier(core, strings.CloneStr(jobKey), "peer-bravo")),
           "cheng_node stage4 smoke: diloco barrier bravo")
    assert(IsOk(node.ChengNodeDilocoSubmitOuterDelta(core, strings.CloneStr(jobKey), "peer-alpha", 128, 256, 4, 1, 2, dilocoRealDeltaPayload(false), dilocoZerosPayload())),
           "cheng_node stage4 smoke: diloco delta alpha")
    assert(IsOk(node.ChengNodeDilocoSubmitOuterDelta(core, strings.CloneStr(jobKey), "peer-bravo", 96, 192, 4, 1, 2, dilocoRealDeltaPayload(true), dilocoZerosPayload())),
           "cheng_node stage4 smoke: diloco delta bravo")
    assert(IsOk(node.ChengNodeDilocoPublishMerge(core, strings.CloneStr(jobKey), "peer-alpha")),
           "cheng_node stage4 smoke: diloco merge")
    let dilocoStatusRes = node.ChengNodeDilocoStatusText(core, strings.CloneStr(jobKey))
    assert(IsOk(dilocoStatusRes), "cheng_node stage4 smoke: diloco status")
    let dilocoStatus = Value(dilocoStatusRes)
    assert(strings.StrContains(dilocoStatus, "job_current_outer_step=1"),
           "cheng_node stage4 smoke: diloco outer step")
    assert(strings.StrContains(dilocoStatus, "lineage_count=2"),
           "cheng_node stage4 smoke: diloco lineage")
    assert(strings.StrContains(dilocoStatus, "lease_count=2"),
           "cheng_node stage4 smoke: diloco lease count")
    let dilocoJobQueryRes = node.ChengNodeKeyedQueryText(core, "diloco_job", "job", strings.CloneStr(jobKey), false)
    assert(IsOk(dilocoJobQueryRes), "cheng_node stage4 smoke: diloco job query")
    assert(strings.StrContains(Value(dilocoJobQueryRes), "payload_kind=diloco_job_state"),
           "cheng_node stage4 smoke: diloco job payload")
    let dilocoCohortQueryRes = node.ChengNodeKeyedQueryText(core, "diloco_cohort", "cohort", strings.CloneStr(jobKey), false)
    assert(IsOk(dilocoCohortQueryRes), "cheng_node stage4 smoke: diloco cohort query")
    assert(strings.StrContains(Value(dilocoCohortQueryRes), "found=1"),
           "cheng_node stage4 smoke: diloco cohort found")
    let leaseAlphaKey = strutil.Join([strings.CloneStr(jobKey), "/", cdomain.ChengNodeDilocoPeerTextFromSeed("peer-alpha")], "")
    let dilocoLeaseQueryRes = node.ChengNodeKeyedQueryText(core, "diloco_lease", "lease", leaseAlphaKey, false)
    assert(IsOk(dilocoLeaseQueryRes), "cheng_node stage4 smoke: diloco lease query")
    assert(strings.StrContains(Value(dilocoLeaseQueryRes), "payload_kind=diloco_lease_state"),
           "cheng_node stage4 smoke: diloco lease payload")
    return jobKey

fn runEvoMapSmoke(core: var node.ChengNode): str =
    let didText = "did:cheng:stage4"
    let peerText = "peer-stage4"
    let deviceText = "linux-stage4"
    let taskId = "evomap-task-1"
    assert(IsOk(node.ChengNodeEvoMapUpsertAgent(core, strings.CloneStr(didText), strings.CloneStr(peerText), strings.CloneStr(deviceText))),
           "cheng_node stage4 smoke: evomap agent")
    let taskKeywords = ["agent", "memory"]
    let emptyContext: layout.FixedBytes32[]
    assert(IsOk(node.ChengNodeEvoMapAnchorTask(core,
                                                 strings.CloneStr(peerText),
                                                 strings.CloneStr(taskId),
                                                 "capture memory and publish",
                                                 taskKeywords,
                                                 emptyContext)),
           "cheng_node stage4 smoke: evomap task")
    let capsuleKeywordsA = ["hello", "world"]
    let emptyParents: layout.FixedBytes32[]
    assert(IsOk(node.ChengNodeEvoMapAnchorCapsule(core,
                                                    strings.CloneStr(didText),
                                                    strings.CloneStr(peerText),
                                                    strings.CloneStr(deviceText),
                                                    evotypes.UnimakerEventUserInput,
                                                    strings.CloneStr(taskId),
                                                    "first event",
                                                    capsuleKeywordsA,
                                                    emptyParents,
                                                    evotypes.UnimakerEdgeKindCausedBy,
                                                    int64(1700000000),
                                                    "",
                                                    "",
                                                    "")),
           "cheng_node stage4 smoke: evomap capsule a")
    var parentCids: layout.FixedBytes32[]
    parentCids = []
    add(parentCids, core.evomap.capsules[0].capsuleCid)
    let capsuleKeywordsB = ["result", "tool"]
    assert(IsOk(node.ChengNodeEvoMapAnchorCapsule(core,
                                                    strings.CloneStr(didText),
                                                    strings.CloneStr(peerText),
                                                    strings.CloneStr(deviceText),
                                                    evotypes.UnimakerEventToolResult,
                                                    strings.CloneStr(taskId),
                                                    "second event",
                                                    capsuleKeywordsB,
                                                    parentCids,
                                                    evotypes.UnimakerEdgeKindUsefulFor,
                                                    int64(1700000001),
                                                    "task_planning",
                                                    "memory_first_then_capture",
                                                    "result")),
           "cheng_node stage4 smoke: evomap capsule b")
    let evoStatus = node.ChengNodeEvoMapStatusText(core)
    assert(strings.StrContains(evoStatus, "agent_count=1"),
           "cheng_node stage4 smoke: evomap agent count")
    assert(strings.StrContains(evoStatus, "task_count=1"),
           "cheng_node stage4 smoke: evomap task count")
    assert(strings.StrContains(evoStatus, "capsule_count=2"),
           "cheng_node stage4 smoke: evomap capsule count")
    let evomapAgentQueryRes = node.ChengNodeKeyedQueryText(core, "evomap", "agent", strings.CloneStr(peerText), false)
    assert(IsOk(evomapAgentQueryRes), "cheng_node stage4 smoke: evomap agent query")
    assert(strings.StrContains(Value(evomapAgentQueryRes), "payload_kind=evomap_agent_hello"),
           "cheng_node stage4 smoke: evomap agent payload")
    let evomapTaskQueryRes = node.ChengNodeKeyedQueryText(core, "evomap", "task", strings.CloneStr(taskId), false)
    assert(IsOk(evomapTaskQueryRes), "cheng_node stage4 smoke: evomap task query")
    assert(strings.StrContains(Value(evomapTaskQueryRes), "payload_kind=evomap_task"),
           "cheng_node stage4 smoke: evomap task payload")
    let capsuleKey = layout.FixedBytes32Hex(core.evomap.capsules[1].capsuleCid)
    let evomapCapsuleQueryRes = node.ChengNodeKeyedQueryText(core, "evomap", "capsule", capsuleKey, false)
    assert(IsOk(evomapCapsuleQueryRes), "cheng_node stage4 smoke: evomap capsule query")
    assert(strings.StrContains(Value(evomapCapsuleQueryRes), "payload_kind=evomap_capsule"),
           "cheng_node stage4 smoke: evomap capsule payload")
    return capsuleKey

fn runPersistenceSmoke(core: var node.ChengNode,
                         rootSeed: str,
                         jobKey: str,
                         capsuleKey: str) =
    let statePath = "/tmp/cheng_node_oracle_diloco_evomap.state"
    let writeRes = state.ChengNodeWriteState(strings.CloneStr(statePath), core)
    assert(IsOk(writeRes), "cheng_node stage4 smoke: write state")
    var loaded: node.ChengNode
    let loadRes = state.ChengNodeLoadStateInto(loaded, strings.CloneStr(statePath), strings.CloneStr(rootSeed))
    assert(IsOk(loadRes), "cheng_node stage4 smoke: load state")

    let loadedOracleRes = node.ChengNodeOracleQueryText(loaded, "BTC/USD", false)
    assert(IsOk(loadedOracleRes), "cheng_node stage4 smoke: loaded oracle")
    assert(strings.StrContains(Value(loadedOracleRes), "round_id=22"),
           "cheng_node stage4 smoke: loaded oracle round")
    let loadedDilocoRes = node.ChengNodeDilocoStatusText(loaded, jobKey)
    assert(IsOk(loadedDilocoRes), "cheng_node stage4 smoke: loaded diloco")
    assert(strings.StrContains(Value(loadedDilocoRes), "job_current_outer_step=2"),
           "cheng_node stage4 smoke: loaded diloco outer step")
    let loadedEvoStatus = node.ChengNodeEvoMapStatusText(loaded)
    assert(strings.StrContains(loadedEvoStatus, "capsule_count=2"),
           "cheng_node stage4 smoke: loaded evomap capsule count")
    let loadedCapsuleQueryRes = node.ChengNodeKeyedQueryText(loaded, "evomap", "capsule", capsuleKey, false)
    assert(IsOk(loadedCapsuleQueryRes), "cheng_node stage4 smoke: loaded capsule query")
    assert(strings.StrContains(Value(loadedCapsuleQueryRes), "found=1"),
           "cheng_node stage4 smoke: loaded capsule found")

fn main(): int32 =
    let rootSeed = "cheng-node-stage4-smoke-root"
    let nodeRes = node.ChengNodeInit(strings.CloneStr(rootSeed))
    assert(IsOk(nodeRes), "cheng_node stage4 smoke: init")
    var core = Value(nodeRes)

    runOracleSmoke(core)
    let jobKey = runDilocoSmoke(core)
    let capsuleKey = runEvoMapSmoke(core)
    runPersistenceSmoke(core, strings.CloneStr(rootSeed), jobKey, capsuleKey)
    echo(" cheng_node_oracle_diloco_evomap_smoke ok")
    return 0
