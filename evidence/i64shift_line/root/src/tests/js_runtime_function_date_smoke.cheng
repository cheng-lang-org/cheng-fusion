import cheng/core/runtime/js_runtime as jsrt

fn runFunctionDispatchSmoke(): int32 =
    if !jsrt.jsRegisterChengFn(1):
        return 1
    var fnValue: jsrt.JsFunction
    jsrt.JsFunctionInit(fnValue, "argCount")
    jsrt.JsFunctionSetBodyKind(fnValue, jsrt.JsBodyKindChengFn)
    jsrt.JsFunctionSetChengFn(fnValue, 1)

    var thisValue: jsrt.JsValue
    jsrt.JsValueInitUndefined(thisValue)
    var args: jsrt.JsValue[]
    var first: jsrt.JsValue
    jsrt.JsValueInitInt32(first, 10)
    add(args, first)

    var out: jsrt.JsValue
    if !jsrt.jsCallFunction(fnValue, thisValue, args, out):
        return 2
    if !jsrt.JsValueIsInt32(out):
        return 3
    if jsrt.JsValueInt32(out) != 1:
        return 4
    return 0

fn runDateSmoke(): int32 =
    if jsrt.JsDateConstructorFromMs(Int64(1234)) != Int64(1234):
        return 10
    return 0

fn main(): int32 =
    var code = runFunctionDispatchSmoke()
    if code != 0:
        echo(Fmt"FAIL runFunctionDispatchSmoke: {code}")
        return code
    code = runDateSmoke()
    if code != 0:
        echo(Fmt"FAIL runDateSmoke: {code}")
        return code
    echo(" js_runtime_function_date_assertions=dispatch/date")
    echo(" js_runtime_function_date_smoke ok")
    return 0
