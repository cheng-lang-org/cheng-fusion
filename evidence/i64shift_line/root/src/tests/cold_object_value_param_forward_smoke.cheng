import std/rawbytes

fn ColdForwardInner(b: Bytes): int32 =
    return BytesLen(b)

fn ColdForwardGetInner(b: Bytes, idx: int32): int32 =
    return BytesGet(b, idx)

fn ColdForwardOuter(b: Bytes): int32 =
    return ColdForwardInner(b)

fn ColdForwardGetOuter(b: Bytes, idx: int32): int32 =
    return ColdForwardGetInner(b, idx)

fn ColdForwardLoad3(data: Bytes, offset: int32): int64 =
    let b0: int64 = int64(BytesGet(data, offset))
    let b1: int64 = int64(BytesGet(data, offset + 1))
    let b2: int64 = int64(BytesGet(data, offset + 2))
    return b0 | (b1 << 8) | (b2 << 16)

fn ColdForwardLoad4(data: Bytes, offset: int32): int64 =
    let b0: int64 = int64(BytesGet(data, offset))
    let b1: int64 = int64(BytesGet(data, offset + 1))
    let b2: int64 = int64(BytesGet(data, offset + 2))
    let b3: int64 = int64(BytesGet(data, offset + 3))
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)

fn ColdForwardLoadOuter(data: Bytes): int32 =
    let a: int64 = ColdForwardLoad4(data, 0)
    let c: int64 = ColdForwardLoad3(data, 4) << 6
    if a <= int64(0) || c <= int64(0):
        return 1
    return 0

fn main(): int32 =
    var b: Bytes
    b = BytesAlloc(32)
    BytesSet(b, 0, 88)
    BytesSet(b, 31, 102)
    if ColdForwardInner(b) != 32:
        return 1
    if ColdForwardOuter(b) != 32:
        return 2
    if ColdForwardGetInner(b, 31) != 102:
        return 3
    if ColdForwardGetOuter(b, 31) != 102:
        return 4
    for i in 1..<31:
        BytesSet(b, i, 102)
    if ColdForwardLoadOuter(b) != 0:
        return 5
    return 0
