# CF Origin RSA-2048 证书链 aarch64 验证探针。
# 复现 Android 手机对 RSA 证书 full handshake 失败的客户端路径：
# TLS 1.3 客户端收到服务器 CertificateVerify(RSA-PSS-SHA256, scheme 0x0804)
# 后的验证 = x509ParseCertificate(叶) → publicKey.kind==Rsa → rsaVerifyPssBytes。
# 本探针内嵌真实部署材料（公钥部分，无私钥）：
#   1. CF Origin 叶证书 DER（dosg:/tmp/cf-cert.der，RSA-2048，*.unimaker.fun）
#   2. CF Origin CA 根证书 DER（dosg:/tmp/cf-root.der）
#   3. 叶公钥 RSAPublicKey(PKCS#1) DER（openssl 从叶证书导出，独立对照）
#   4. dosg 上用 cf-key.pk8 对固定消息做的 openssl RSA-PSS(SHA256, saltlen=32)
#      签名（与服务器 CertificateVerify 同型）
# 验证链：叶解析 → kind/modulus 对拍 → openssl 签名验签（CV 同型）→
# x509VerifyChain(leaf, [], [root]) 全链验证。rc 区分各失败点。
import std/system
import std/result
import std/rawbytes
import std/strutils as strutil
import std/crypto/rsa as rsacrypto
import std/tls/x509 as x509

fn probeCertHex(): str =
    return ""

fn probeRootHex(): str =
    return ""

fn probePubPk1Hex(): str =
    return ""

fn probeSigHex(): str =
    return ""

# openssl dgst -sha384 -sigopt rsa_padding_mode:pss -sigopt rsa_pss_saltlen:48
# （dosg 上用 cf-key.pk8 对同一消息签出，scheme 0x0805 同型）
fn probeSig384Hex(): str =
    return ""

fn main(): int32 =
    echo("rsa_cf_chain_aarch64_probe: start")
    let certRes: Result[Bytes] = rsacrypto.rsaHexDecode(probeCertHex())
    if IsErr(certRes):
        echo("probe: hex decode cert err")
        return 10
    let certDer: Bytes = Value(certRes)
    let rootRes: Result[Bytes] = rsacrypto.rsaHexDecode(probeRootHex())
    if IsErr(rootRes):
        echo("probe: hex decode root err")
        return 11
    let rootDer: Bytes = Value(rootRes)
    let pubRes: Result[Bytes] = rsacrypto.rsaHexDecode(probePubPk1Hex())
    if IsErr(pubRes):
        echo("probe: hex decode pub err")
        return 12
    let pubPk1: Bytes = Value(pubRes)
    let sigRes: Result[Bytes] = rsacrypto.rsaHexDecode(probeSigHex())
    if IsErr(sigRes):
        echo("probe: hex decode sig err")
        return 13
    let opensslSig: Bytes = Value(sigRes)
    let msg: Bytes = BytesFromString("cheng cf origin pss probe message\n")
    echo(strutil.Join(["probe: hex ok cert_len=", IntToStr(BytesLen(certDer)),
                       " root_len=", IntToStr(BytesLen(rootDer)),
                       " pub_len=", IntToStr(BytesLen(pubPk1)),
                       " msg_len=", IntToStr(BytesLen(msg)),
                       " sig_len=", IntToStr(BytesLen(opensslSig))], ""))

    var leaf: x509.X509Certificate
    x509.initX509CertificateInto(leaf)
    let leafRes: Result[bool] = x509.x509ParseCertificateInto(leaf, certDer)
    if IsErr(leafRes):
        echo(strutil.Join(["probe: leaf parse err=", ErrorText(leafRes)], ""))
        return 20
    if leaf.publicKey.kind != x509.X509KeyRsa:
        echo(strutil.Join(["probe: leaf key kind not rsa kind=", IntToStr(int32(leaf.publicKey.kind))], ""))
        return 21
    if BytesLen(leaf.publicKey.rsaN) != 256:
        echo(strutil.Join(["probe: leaf rsaN bad len=", IntToStr(BytesLen(leaf.publicKey.rsaN))], ""))
        return 22
    echo(strutil.Join(["probe: leaf parse ok rsaN_len=", IntToStr(BytesLen(leaf.publicKey.rsaN)),
                       " rsaE_len=", IntToStr(BytesLen(leaf.publicKey.rsaE))], ""))

    var refN: Bytes
    var refE: Bytes
    let refRes: Result[bool] = rsacrypto.rsaBigPublicKeyBytesInto(pubPk1, refN, refE)
    if IsErr(refRes):
        echo(strutil.Join(["probe: reference pub parse err=", ErrorText(refRes)], ""))
        return 23
    if ! BytesEqual(leaf.publicKey.rsaN, refN):
        echo("probe: leaf rsaN != reference rsaN")
        return 24
    if ! BytesEqual(leaf.publicKey.rsaE, refE):
        echo("probe: leaf rsaE != reference rsaE")
        return 25
    echo("probe: leaf public key matches reference")

    let cvRes: Result[bool] = rsacrypto.rsaVerifyPssBytes(leaf.publicKey.rsaN, leaf.publicKey.rsaE, msg, opensslSig, false)
    if IsErr(cvRes):
        echo(strutil.Join(["probe: cf openssl pss verify err=", ErrorText(cvRes)], ""))
        return 30
    if ! Value(cvRes):
        echo("probe: cf openssl pss verify false")
        return 31
    echo("probe: cf openssl pss verify ok (certverify analog)")

    # SHA-384 PSS 臂（scheme 0x0805 同型：cipher 为 SHA384 族时的服务端 CV）
    let sig384Res: Result[Bytes] = rsacrypto.rsaHexDecode(probeSig384Hex())
    if IsErr(sig384Res):
        echo("probe: hex decode sig384 err")
        return 32
    let cv384Res: Result[bool] = rsacrypto.rsaVerifyPssBytes(leaf.publicKey.rsaN, leaf.publicKey.rsaE, msg, Value(sig384Res), true)
    if IsErr(cv384Res):
        echo(strutil.Join(["probe: cf openssl pss384 verify err=", ErrorText(cv384Res)], ""))
        return 33
    if ! Value(cv384Res):
        echo("probe: cf openssl pss384 verify false")
        return 34
    echo("probe: cf openssl pss384 verify ok")

    var inter: x509.X509CertList
    x509.initX509CertListInto(inter)
    var roots: x509.X509CertList
    x509.initX509CertListInto(roots)
    let pinRes: Result[bool] = x509.x509CertListAddDer(roots, rootDer)
    if IsErr(pinRes):
        echo(strutil.Join(["probe: root add err=", ErrorText(pinRes)], ""))
        return 40
    let chainRes: Result[bool] = x509.x509VerifyChain(leaf, inter, roots, 1789948800)
    if IsErr(chainRes):
        echo(strutil.Join(["probe: chain verify err=", Error(chainRes)], ""))
        return 41
    if ! Value(chainRes):
        echo("probe: chain verify false")
        return 42
    echo("probe: chain verify ok")

    echo("rsa_cf_chain_aarch64_probe ok")
    return 0
