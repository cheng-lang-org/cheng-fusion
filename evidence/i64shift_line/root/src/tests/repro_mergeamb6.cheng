import std/result
import std/crypto/bigint as bigint

fn check(deep: bool): int32 =
    let xRes: result.Result[bigint.BigInt] = result.Ok[bigint.BigInt](bigint.bigFromInt(3))
    var x: bigint.BigInt
    x = result.Value(xRes)
    if deep:
        bigint.bigNormalize(x)
    return x.count

fn main(): int32 =
    return check(true)
