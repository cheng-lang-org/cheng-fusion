# D1 工件仓 smoke: DiLoCoArtifactRef <-> 真字节。
# 覆盖 (断言失败即非零 abort, 末行 "ok" 才打印):
#   (1) put 两份相同张量 -> 同一 blobCid, entry 去重
#   (2) get 回读字节 == 写入字节 (逐字节)
#   (3) 改一字节 -> 不同 blobCid
#   (4) 磁盘页篡改一字节 -> get 哈希漂移 Err 硬错
#   (5) 未知 blobCid get -> miss Err (无兜底)
#   (6) ref.payloadLen 漂移 -> get Err
#   (7) 全程仅本地 os 文件 API, 零网络

import std/result
import std/os
import std/rawbytes as rawbytes
import cheng/std/bytes_layout as layout
import cheng/chain/lsmr_types as lt
import cheng/DiLoCo/core/diloco as core
import cheng/DiLoCo/artifact/store as astore

fn DiLoCoArtifactStoreSmokeBundleCid(label: str): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(96)
    layout.ByteBufAppendBytes(buf, rawbytes.BytesFromString("cheng.diloco.artifact.store.smoke.job"))
    layout.ByteBufAppendBytes(buf, rawbytes.BytesFromString(label))
    return lt.FixedCidFromBuf(buf)

fn buildTensorPayload(seedByte: int32, count: int32): rawbytes.Bytes =
    var out = rawbytes.BytesAlloc(count)
    for i in 0..<count:
        rawbytes.BytesSet(out, i, (seedByte + i * 31) % 251)
    return out

@borrows
fn flipOneByte(src: rawbytes.Bytes, flipIdx: int32): rawbytes.Bytes =
    var out = rawbytes.BytesAlloc(rawbytes.BytesLen(src))
    for i in 0..<rawbytes.BytesLen(src):
        rawbytes.BytesSet(out, i, rawbytes.BytesGet(src, i))
    rawbytes.BytesSet(out, flipIdx, (rawbytes.BytesGet(src, flipIdx) + 1) % 256)
    return out

fn main(): int32 =
    let rootDir = os.GetEnvDefault("TMPDIR", "/tmp") + "/cheng_diloco_artifact_store_smoke"
    if os.DirExists(rootDir):
        os.RemoveDir(rootDir)
    var store = astore.DiLoCoArtifactStore()
    let initRes = astore.DiLoCoArtifactStoreInitFill(store, rootDir)
    assert(initRes.ok, " diloco artifact store smoke: init")
    let bundleCid = DiLoCoArtifactStoreSmokeBundleCid("d1")

    # ---- (1)(2) 相同张量两份 -> 同一 blobCid; get 字节一致 ----
    var refA = core.DiLoCoArtifactRef()
    var payloadA = buildTensorPayload(7, 256)
    let putARes = astore.DiLoCoArtifactStorePutFill(refA, store, bundleCid, payloadA, 64)
    assert(putARes.ok, " diloco artifact store smoke: put A")
    assert(refA.payloadLen == 256, " diloco artifact store smoke: ref A payload len")
    let validateRes = core.DiLoCoArtifactRefValidate(refA)
    assert(validateRes.ok, " diloco artifact store smoke: ref A validate")

    var refB = core.DiLoCoArtifactRef()
    var payloadA2 = buildTensorPayload(7, 256)
    let putBRes = astore.DiLoCoArtifactStorePutFill(refB, store, bundleCid, payloadA2, 64)
    assert(putBRes.ok, " diloco artifact store smoke: put B (same bytes)")
    assert(layout.FixedBytes32Equal(refA.blobCid, refB.blobCid),
        " diloco artifact store smoke: identical tensors same blob cid")
    assert(astore.DiLoCoArtifactStoreFindEntry(store, refA.blobCid) == 0,
        " diloco artifact store smoke: entry dedup")
    assert(store.entries.len == 1, " diloco artifact store smoke: single entry")

    var got = rawbytes.EmptyBytes()
    let getRes = astore.DiLoCoArtifactStoreGetFill(got, store, refA)
    assert(getRes.ok, " diloco artifact store smoke: get A")
    assert(rawbytes.BytesEqual(got, payloadA), " diloco artifact store smoke: get bytes equal")

    # ---- (3) 改一字节 -> 不同 blobCid, 新页落盘 ----
    var payloadFlip = flipOneByte(payloadA, 7)
    var refC = core.DiLoCoArtifactRef()
    let putCRes = astore.DiLoCoArtifactStorePutFill(refC, store, bundleCid, payloadFlip, 64)
    assert(putCRes.ok, " diloco artifact store smoke: put C (one byte flipped)")
    assert(!layout.FixedBytes32Equal(refC.blobCid, refA.blobCid),
        " diloco artifact store smoke: flipped byte different blob cid")
    assert(store.entries.len == 2, " diloco artifact store smoke: two entries")
    assert(store.storeHash != int64(0), " diloco artifact store smoke: store hash nonzero")

    # ---- (4) 磁盘页篡改一字节 -> get 哈希漂移硬错 ----
    let victimPath = astore.DiLoCoArtifactStoreBlobPath(rootDir, refA.blobCid)
    var tampered = flipOneByte(payloadA, 100)
    let writeTamperRes = os.WriteFileBytesResult(victimPath, tampered)
    assert(writeTamperRes.ok, " diloco artifact store smoke: tamper write")
    var gotTampered = rawbytes.EmptyBytes()
    let tamperGetRes = astore.DiLoCoArtifactStoreGetFill(gotTampered, store, refA)
    assert(IsErr(tamperGetRes), " diloco artifact store smoke: tampered page get must fail")

    # ---- (5) 未知 blobCid -> miss 硬错 (无磁盘兜底) ----
    var ghostRef = refA
    ghostRef.blobCid = core.DiLoCoArtifactAuxCid(bundleCid, refA.blobCid, "cheng.diloco.artifact.store.smoke.ghost")
    var gotGhost = rawbytes.EmptyBytes()
    let ghostGetRes = astore.DiLoCoArtifactStoreGetFill(gotGhost, store, ghostRef)
    assert(IsErr(ghostGetRes), " diloco artifact store smoke: unknown blob get must fail")

    # ---- (6) payloadLen 漂移 -> get 硬错 ----
    var driftRef = refC
    driftRef.payloadLen = driftRef.payloadLen - 1
    var gotDrift = rawbytes.EmptyBytes()
    let driftGetRes = astore.DiLoCoArtifactStoreGetFill(gotDrift, store, driftRef)
    assert(IsErr(driftGetRes), " diloco artifact store smoke: len drift get must fail")

    # ---- done 口径: 引用过的 ref 都能取出与 CID 一致的字节 ----
    let resolvableRes = astore.DiLoCoArtifactStoreRefResolvable(store, refC)
    assert(resolvableRes.ok, " diloco artifact store smoke: ref C resolvable")

    echo(" diloco_artifact_store_smoke ok")
    return 0
