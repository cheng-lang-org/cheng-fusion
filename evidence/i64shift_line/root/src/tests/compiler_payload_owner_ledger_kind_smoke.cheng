import std/os
import cheng/core/runtime/arena as arenamod
import cheng/core/tooling/compiler_payload_lifecycle as lifecycle

fn CompilerPayloadOwnerLedgerKindCycle(
        outcome: int32) =
    var arena = arenamod.ArenaInitDefault(8192)
    let retainedBytes =
        int64(arenamod.ArenaCapacity(arena))
    var state: lifecycle.CompilerPayloadLifecycle
    lifecycle.CompilerPayloadLifecycleBegin(
        state,
        lifecycle.CompilerPayloadKindSystemLinkOwnerLedger,
        retainedBytes,
        1)
    lifecycle.CompilerPayloadLifecycleBorrowForConsumer(state)
    lifecycle.CompilerPayloadLifecycleReturnConsumerBorrow(state)
    lifecycle.CompilerPayloadLifecycleMoveToConsumer(state)
    arenamod.ArenaRelease(arena)
    var physicalRelease: lifecycle.CompilerPayloadPhysicalReleaseReceipt
    physicalRelease.releasedBufferCount = 1
    physicalRelease.releasedBytes = retainedBytes
    physicalRelease.storageReleased =
        arena.basePtr == nil &&
        arena.capacityBytes == 0
    lifecycle.CompilerPayloadLifecyclePrepareTerminal(state)
    var receipt: lifecycle.CompilerPayloadLifecycleReceipt
    lifecycle.CompilerPayloadLifecycleEnd(
        state,
        outcome,
        physicalRelease,
        receipt)
    assert(
        lifecycle.CompilerPayloadLifecycleReceiptClosed(receipt) &&
        receipt.outcome == outcome &&
        receipt.allocated == int64(1) &&
        receipt.released == int64(1) &&
        receipt.live == int64(0) &&
        receipt.allocatedBytes == retainedBytes &&
        receipt.releasedBytes == retainedBytes &&
        receipt.liveBytes == int64(0) &&
        receipt.retained == int64(1) &&
        receipt.borrowReturnCount == int64(1) &&
        receipt.ownerTransferCount == int64(1) &&
        receipt.physicalBufferCount == 1 &&
        receipt.physicalFreeCount == int64(1) &&
        receipt.storageReleased &&
        receipt.ledgerStorageReleased,
        " compiler payload owner ledger kind receipt")

fn main() =
    for cycle in 0..<1000:
        CompilerPayloadOwnerLedgerKindCycle(
            lifecycle.CompilerPayloadOutcomeSuccess)
        CompilerPayloadOwnerLedgerKindCycle(
            lifecycle.CompilerPayloadOutcomeDiagnostic)
    os.WriteLine(
        os.Get_stdout(),
        "compiler_payload_owner_ledger_kind ok cycles=2000 live=0 live_bytes=0")
