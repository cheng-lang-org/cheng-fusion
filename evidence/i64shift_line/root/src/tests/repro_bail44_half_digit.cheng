import std/strings
import cheng/core/runtime/arena as arenamod

type
    BigIntLite =
        limbs: int64[]
        count: int32

fn reproWordToU64(w: int64): int64 =
    return w

fn reproHalfDigitCount(a: var BigIntLite): int64 =
    if a.count <= 0:
        return 0
    let top = reproWordToU64(a.limbs[a.count - 1])
    return top

fn main() =
    var b: BigIntLite
    b.count = 1
    add(b.limbs, 42L)
    let _ = reproHalfDigitCount(b)
