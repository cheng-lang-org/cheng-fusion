import std/result
import cheng/core/lang/parser as parser
import cheng/core/tooling/compiler_parser_receipt as receiptmod
import cheng/core/tooling/compiler_stage_receipt as stagereceipt
import cheng/std/bytes_layout as layout

fn ImportOriginSource(): str =
    return "import std/result as resultx\nimport libp2p/[crypto,transport]\n\ntype Only =\n    value: int32\n"

fn BuildImportOriginSidecar(): receiptmod.ParserCanonicalSourceSidecar =
    var identities: receiptmod.ParserNormalizedExprFunctionIdentity[]
    var declarations: parser.NormalizedFunctionDecl[]
    var out: receiptmod.ParserCanonicalSourceSidecar
    var err: str
    assert(receiptmod.ParserCanonicalSourceSidecarBuildFromSourceInto(
               0,
               ImportOriginSource(),
               false,
               identities,
               declarations,
               out,
               err),
           Fmt"import origin sidecar build failed {err}")
    assert(receiptmod.ParserCanonicalSourceSidecarStrictValidateInto(
               out, err),
           Fmt"import origin sidecar strict failed {err}")
    return out

fn CheckImportOriginProjection() =
    let sidecar = BuildImportOriginSidecar()
    assert(sidecar.importOrigins.importDeclarationSourceLocalRows.len == 2 &&
           sidecar.importOrigins.importItemSourceLocalRows.len == 3 &&
           sidecar.importOrigins.importModuleTokenIds.len == 6,
           "import origin SoA count mismatch")
    assert(sidecar.importOrigins.importDeclarationSourceLocalRows[0] == 0 &&
           sidecar.importOrigins.importDeclarationSourceLocalRows[1] == 1 &&
           sidecar.importOrigins.importItemSourceLocalRows[0] == 0 &&
           sidecar.importOrigins.importItemSourceLocalRows[1] == 1 &&
           sidecar.importOrigins.importItemSourceLocalRows[2] == 2,
           "import origin source-local rows mismatch")
    assert(receiptmod.ParserCanonicalSourceSidecarImportTargetPathEquals(
               sidecar, 0, "std/result") &&
           receiptmod.ParserCanonicalSourceSidecarImportTargetPathEquals(
               sidecar, 1, "libp2p/crypto") &&
           receiptmod.ParserCanonicalSourceSidecarImportTargetPathEquals(
               sidecar, 2, "libp2p/transport") &&
           !receiptmod.ParserCanonicalSourceSidecarImportTargetPathEquals(
               sidecar, 0, "std/results"),
           "import origin canonical target mismatch")
    assert(sidecar.importOrigins.importItemAliasTokenIds[0] >= 0 &&
           sidecar.importOrigins.importItemAliasTokenIds[1] == -1 &&
           sidecar.importOrigins.importItemAliasTokenIds[2] == -1 &&
           sidecar.importOrigins.importItemPrefixTokenCounts[0] == 0 &&
           sidecar.importOrigins.importItemPrefixTokenCounts[1] == 1 &&
           sidecar.importOrigins.importItemPrefixTokenCounts[2] == 1,
           "import origin alias/group discriminator mismatch")
    let clone = receiptmod.ParserCanonicalSourceSidecarClone(sidecar)
    var cloneErr: str
    assert(receiptmod.ParserCanonicalSourceSidecarStrictValidateInto(
               clone, cloneErr) &&
           layout.FixedBytes32Equal(
               clone.sidecarRaw32, sidecar.sidecarRaw32),
           "import origin clone/hash mismatch")
    echo("parser_import_origin_rows=2,3,6")
    echo("parser_import_origin_projection=1")

fn CheckImportOriginMutationsRejected() =
    let sidecar = BuildImportOriginSidecar()
    var err: str
    var aliasDeleted =
        receiptmod.ParserCanonicalSourceSidecarClone(sidecar)
    aliasDeleted.importOrigins.importItemAliasTokenIds[0] = -1
    assert(!receiptmod.ParserCanonicalSourceSidecarSealInto(
                aliasDeleted, err),
           "deleted import alias accepted")
    var tokenSubstituted =
        receiptmod.ParserCanonicalSourceSidecarClone(sidecar)
    tokenSubstituted.importOrigins.importModuleTokenIds[0] =
        tokenSubstituted.importOrigins.importModuleTokenIds[2]
    err = ""
    assert(!receiptmod.ParserCanonicalSourceSidecarSealInto(
                tokenSubstituted, err),
           "substituted import module token accepted")
    var tokenReordered =
        receiptmod.ParserCanonicalSourceSidecarClone(sidecar)
    let firstToken = tokenReordered.importOrigins.importModuleTokenIds[0]
    tokenReordered.importOrigins.importModuleTokenIds[0] =
        tokenReordered.importOrigins.importModuleTokenIds[1]
    tokenReordered.importOrigins.importModuleTokenIds[1] = firstToken
    err = ""
    assert(!receiptmod.ParserCanonicalSourceSidecarSealInto(
                tokenReordered, err),
           "reordered import module tokens accepted")
    var spanExpanded =
        receiptmod.ParserCanonicalSourceSidecarClone(sidecar)
    spanExpanded.importOrigins.importItemSpanIds[0] =
        spanExpanded.importOrigins.importDeclarationSpanIds[0]
    err = ""
    assert(!receiptmod.ParserCanonicalSourceSidecarSealInto(
                spanExpanded, err),
           "expanded import item span accepted")
    var groupedPrefixDrift =
        receiptmod.ParserCanonicalSourceSidecarClone(sidecar)
    groupedPrefixDrift.importOrigins.importModuleTokenIds[
        groupedPrefixDrift.importOrigins.importItemModuleTokenStarts[2]] =
        groupedPrefixDrift.importOrigins.importModuleTokenIds[0]
    err = ""
    assert(!receiptmod.ParserCanonicalSourceSidecarSealInto(
                groupedPrefixDrift, err),
           "grouped import prefix drift accepted")
    var emptyModuleValue =
        receiptmod.ParserCanonicalSourceSidecarClone(sidecar)
    let moduleTokenId =
        emptyModuleValue.importOrigins.importModuleTokenIds[0]
    emptyModuleValue.tokenValues[moduleTokenId] = ""
    err = ""
    assert(!receiptmod.ParserCanonicalSourceSidecarSealInto(
                emptyModuleValue, err),
           "empty import module token value accepted")
    var slashValueDrift =
        receiptmod.ParserCanonicalSourceSidecarClone(sidecar)
    let firstModuleTokenId =
        slashValueDrift.importOrigins.importModuleTokenIds[0]
    slashValueDrift.tokenValues[firstModuleTokenId + 1] = "x"
    err = ""
    assert(!receiptmod.ParserCanonicalSourceSidecarSealInto(
                slashValueDrift, err),
           "import slash value drift accepted")
    var aliasKeywordDrift =
        receiptmod.ParserCanonicalSourceSidecarClone(sidecar)
    let aliasTokenId =
        aliasKeywordDrift.importOrigins.importItemAliasTokenIds[0]
    aliasKeywordDrift.tokenValues[aliasTokenId - 1] = "az"
    err = ""
    assert(!receiptmod.ParserCanonicalSourceSidecarSealInto(
                aliasKeywordDrift, err),
           "import alias keyword drift accepted")
    echo("parser_import_origin_mutations_rejected=1")

fn ZeroFunctionSource(): str =
    return "type Only =\n    value: int32\n"

fn ZeroFunctionPredecessor(): layout.FixedBytes32 =
    var out: layout.FixedBytes32
    out.data[0] = uint8(1)
    return out

fn GhostFunctionSource(): str =
    return "fn ghost(): int32 =\n    return 1\n"

fn GhostFunctionIdentity():
        receiptmod.ParserNormalizedExprFunctionIdentity =
    return receiptmod.ParserNormalizedExprFunctionIdentityMake(
        0,
        0,
        "/workspace/ghost.cheng",
        "app/ghost",
        "ghost",
        1,
        2)

fn GhostFunctionAccumulator():
        receiptmod.ParserNormalizedExprReceiptAccumulator =
    var sourcePaths: str[]
    add(sourcePaths, "/workspace/ghost.cheng")
    var ownerModulePaths: str[]
    add(ownerModulePaths, "app/ghost")
    var importEdges: parser.ImportEdge[]
    let accumulatorRes =
        receiptmod.ParserNormalizedExprReceiptAccumulatorInit(
            ZeroFunctionPredecessor(),
            sourcePaths,
            ownerModulePaths,
            importEdges,
            1)
    assert(IsOk(accumulatorRes),
           Fmt"ghost-function accumulator failed {Error(accumulatorRes)}")
    return Value(accumulatorRes)

fn ObserveGhostFunctionSource(
        accumulator: var receiptmod.ParserNormalizedExprReceiptAccumulator) =
    var identities: receiptmod.ParserNormalizedExprFunctionIdentity[]
    add(identities, GhostFunctionIdentity())
    var declarations: parser.NormalizedFunctionDecl[]
    var err: str
    assert(parser.ParserReadNormalizedFunctionDecls(
               GhostFunctionSource(), declarations, err),
           Fmt"ghost-function declarations failed {err}")
    let observeRes =
        receiptmod.ParserNormalizedExprReceiptObserveSourceText(
            accumulator,
            0,
            GhostFunctionSource(),
            false,
            identities,
            declarations)
    assert(IsOk(observeRes),
           Fmt"ghost-function source observe failed {Error(observeRes)}")

fn BuildNonzeroFunctionReceipt():
        receiptmod.ParserNormalizedExprReceipt =
    var accumulator = GhostFunctionAccumulator()
    ObserveGhostFunctionSource(accumulator)
    var layer: parser.NormalizedExprLayer
    var err: str
    assert(parser.ParserReadNormalizedExprLayerFromText(
               "/workspace/ghost.cheng",
               GhostFunctionSource(),
               layer,
               err),
           Fmt"ghost-function layer failed {err}")
    let identity = GhostFunctionIdentity()
    assert(IsOk(receiptmod.ParserNormalizedExprReceiptObserveFunction(
                    accumulator, layer, identity)) &&
           IsOk(
               receiptmod.ParserNormalizedExprReceiptVerifyObservedFunction(
                   accumulator, layer, identity)),
           "ghost-function observe/verify failed")
    var reachable: bool[]
    add(reachable, true)
    let receiptRes =
        receiptmod.ParserNormalizedExprReceiptFinalize(
            accumulator, reachable)
    assert(IsOk(receiptRes),
           Fmt"ghost-function finalize failed {Error(receiptRes)}")
    let out = Value(receiptRes)
    assert(IsOk(receiptmod.ParserNormalizedExprReceiptVerify(out)),
           "ghost-function receipt verify failed")
    return out

fn CheckZeroFunctionReceipt() =
    var sourcePaths: str[]
    add(sourcePaths, "/workspace/type_only.cheng")
    var ownerModulePaths: str[]
    add(ownerModulePaths, "app/type_only")
    var importEdges: parser.ImportEdge[]
    let accumulatorRes =
        receiptmod.ParserNormalizedExprReceiptAccumulatorInit(
            ZeroFunctionPredecessor(),
            sourcePaths,
            ownerModulePaths,
            importEdges,
            0)
    assert(IsOk(accumulatorRes),
           Fmt"zero-function accumulator failed {Error(accumulatorRes)}")
    var accumulator = Value(accumulatorRes)
    var identities: receiptmod.ParserNormalizedExprFunctionIdentity[]
    var declarations: parser.NormalizedFunctionDecl[]
    let observeRes =
        receiptmod.ParserNormalizedExprReceiptObserveSourceText(
            accumulator,
            0,
            ZeroFunctionSource(),
            false,
            identities,
            declarations)
    assert(IsOk(observeRes),
           Fmt"zero-function source observe failed {Error(observeRes)}")
    var reachable: bool[]
    let receiptRes =
        receiptmod.ParserNormalizedExprReceiptFinalize(
            accumulator, reachable)
    assert(IsOk(receiptRes),
           Fmt"zero-function finalize failed {Error(receiptRes)}")
    let zeroReceipt = Value(receiptRes)
    assert(zeroReceipt.functionCount == Int64(0) &&
           zeroReceipt.verifiedFunctionCount == Int64(0) &&
           IsOk(receiptmod.ParserNormalizedExprReceiptVerify(
               zeroReceipt)),
           "zero-function receipt verify failed")
    var forged =
        receiptmod.ParserNormalizedExprReceiptClone(zeroReceipt)
    add(forged.sourceSidecars[0].functionIndexes, 0)
    var sealErr: str
    assert(!receiptmod.ParserCanonicalSourceSidecarSealInto(
                forged.sourceSidecars[0], sealErr),
           "zero-function ghost function sidecar accepted")
    var unreachableAccumulator = GhostFunctionAccumulator()
    ObserveGhostFunctionSource(unreachableAccumulator)
    var unreachable: bool[]
    add(unreachable, false)
    let unreachableReceiptRes =
        receiptmod.ParserNormalizedExprReceiptFinalize(
            unreachableAccumulator, unreachable)
    assert(IsErr(unreachableReceiptRes),
           "real unreachable function produced a zero-function receipt")
    let nonzeroReceipt = BuildNonzeroFunctionReceipt()
    var zeroForged =
        receiptmod.ParserNormalizedExprReceiptClone(nonzeroReceipt)
    zeroForged.functionCount = Int64(0)
    zeroForged.verifiedFunctionCount = Int64(0)
    for countIndex in 0..<zeroForged.envelope.countKeys.len:
        if zeroForged.envelope.countKeys[countIndex] == "function_count":
            zeroForged.envelope.countValues[countIndex] = Int64(0)
    let forgedEnvelopeRes = stagereceipt.CompilerStageReceiptMake(
        zeroForged.envelope.stageKind,
        zeroForged.envelope.laneKind,
        zeroForged.envelope.producerIdentity,
        zeroForged.envelope.predecessorRaw32,
        zeroForged.envelope.artifactRaw32,
        zeroForged.envelope.countKeys,
        zeroForged.envelope.countValues)
    assert(IsOk(forgedEnvelopeRes),
           Fmt"zero-forged envelope failed {Error(forgedEnvelopeRes)}")
    zeroForged.envelope = Value(forgedEnvelopeRes)
    assert(IsOk(stagereceipt.CompilerStageReceiptVerify(
                    zeroForged.envelope)) &&
           IsErr(receiptmod.ParserNormalizedExprReceiptVerify(
               zeroForged)),
           "independent zero-function verify accepted executable domains")
    echo("parser_zero_function_receipt=1")

fn main() =
    CheckImportOriginProjection()
    CheckImportOriginMutationsRejected()
    CheckZeroFunctionReceipt()
    echo("compiler_parser_import_origin_receipt_smoke: ok")
