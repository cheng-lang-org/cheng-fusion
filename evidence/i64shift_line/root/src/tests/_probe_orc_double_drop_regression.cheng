# ORC double-drop regression fixture (round 95 root cause).
# Failing shape: cross-module by-value managed str argument + Err return +
# scope-exit drop -> the argument's str is released twice (registry_miss).
# Passing shape (p5): single-hop LOCAL by-value str param + Err return.
# Expected after the fix: both paths print 'after iserr=1' and exit 0.
import std/os
import std/strings
import std/result
import std/cmdline

fn localHop(s: str): result.Result[uint64] =
    return result.Err[uint64](strings.CloneStr("x"))

fn main(): int32 =
    let localR = localHop(cmdline.ParamStr(1))
    if result.IsErr(localR):
        echo("local_path ok")
    let r = os.ReadFileBytesResult(cmdline.ParamStr(1))
    echo("after iserr=" + strings.IntToStr(int32(result.IsErr(r))))
    return 0
