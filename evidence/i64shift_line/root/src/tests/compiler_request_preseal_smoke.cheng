import std/result
import cheng/core/tooling/compiler_request as creq
import cheng/core/backend/system_link_exec as sexec
import cheng/std/bytes_layout as layout

fn main(): int32 =
    let root = "/workspace"
    var request = creq.CompilerRequestNew(
        share(root),
        "src/main.cheng",
        "/tmp/cheng-request-preseal.o",
        "arm64-apple-darwin",
        creq.EmitObj,
        "")
    request.backendKind = creq.CompilerBackend2
    request.jobCount = 4
    request = creq.CompilerRequestWithProviderObjectPaths(
        request,
        ["/tmp/provider-a.o", "/tmp/provider-b.o"])
    request = creq.CompilerRequestWithRuntimeProviderBundle(
        request,
        "/tmp/runtime-provider.bundle")
    creq.CompilerRequestSeal(request)
    var parsed = request
    assert(parsed.backendKind == creq.CompilerBackend2,
           "compiler request preseal: backend kind")
    assert(parsed.jobCount == 4,
           "compiler request preseal: job count")
    assert(parsed.emitKind == creq.EmitObj,
           "compiler request preseal: emit kind")
    assert(parsed.providerObjectPaths.len == 2,
           "compiler request preseal: provider paths")
    assert(parsed.runtimeProviderBundle ==
               "/tmp/runtime-provider.bundle",
           "compiler request preseal: runtime provider")
    assert(parsed.sealed &&
           !layout.FixedBytes32Equal(
               parsed.backendRequestActionCid,
               layout.FixedBytes32()) &&
           !layout.FixedBytes32Equal(
               parsed.backendRequestCid,
               layout.FixedBytes32()) &&
           creq.CompilerRequestStrictValidateSealed(parsed),
           "compiler request preseal: seal")

    var tampered = share(parsed)
    tampered.jobCount = tampered.jobCount + 1
    assert(!creq.CompilerRequestStrictValidateSealed(tampered),
           "compiler request preseal: tampered jobs accepted")
    let tamperedPlanRes =
        sexec.BuildSystemLinkExecPlan(share(root), tampered)
    assert(IsErr(tamperedPlanRes) &&
           Error(tamperedPlanRes) ==
               "system link exec: compiler request is not sealed",
           "compiler request preseal: formal builder accepted tampered seal")

    var rebuilt =
        creq.CompilerRequestWithMode(parsed, "production")
    assert(!rebuilt.sealed &&
           layout.FixedBytes32Equal(
               rebuilt.backendRequestActionCid,
               layout.FixedBytes32()) &&
           layout.FixedBytes32Equal(
               rebuilt.backendRequestCid,
               layout.FixedBytes32()),
           "compiler request preseal: mutation retained stale seal")
    assert(!creq.CompilerRequestStrictValidateSealed(rebuilt),
           "compiler request preseal: unsealed mutation validated")
    let unsealedPlanRes =
        sexec.BuildSystemLinkExecPlan(share(root), share(rebuilt))
    assert(IsErr(unsealedPlanRes) &&
           Error(unsealedPlanRes) ==
               "system link exec: compiler request is not sealed",
           "compiler request preseal: formal builder accepted unsealed request")
    creq.CompilerRequestSeal(rebuilt)
    assert(creq.CompilerRequestStrictValidateSealed(rebuilt),
           "compiler request preseal: reseal")

    let invalidBackendRes =
        creq.CompilerBackendKindFromText("other")
    assert(IsErr(invalidBackendRes),
           "compiler request preseal: invalid backend accepted")

    let backend2Res = creq.CompilerBackendKindFromText("backend2")
    let jobsRes = creq.CompilerRequestBackendJobsFromText("4")
    assert(!IsErr(backend2Res) &&
           Value(backend2Res) == creq.CompilerBackend2 &&
           !IsErr(jobsRes) &&
           Value(jobsRes) == 4,
           "compiler request preseal: canonical value parser")

    var defaultBackend = creq.CompilerRequestNew(
        root,
        "src/main.cheng",
        "/tmp/cheng-request-preseal-default.o",
        "arm64-apple-darwin",
        creq.EmitExe,
        "")
    creq.CompilerRequestSeal(defaultBackend)
    assert(defaultBackend.backendKind ==
               creq.CompilerBackendPrimary &&
           defaultBackend.jobCount == 1 &&
           creq.CompilerRequestStrictValidateSealed(defaultBackend),
           "compiler request preseal: default authority")
    echo("compiler_request_preseal=1")
    return 0
