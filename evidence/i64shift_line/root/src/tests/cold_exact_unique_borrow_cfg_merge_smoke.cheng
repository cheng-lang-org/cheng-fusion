@borrows
fn MarkFive(index: int32,
            first: var bool[],
            second: var bool[],
            third: var bool[],
            fourth: var bool[],
            fifth: var bool[]): bool =
    first[index] = true
    second[index] = true
    third[index] = true
    fourth[index] = true
    fifth[index] = true
    return true

fn SetMergedText(out: var str, value: str): bool =
    out = value
    return true

fn RewriteMergedText(out: var str, chooseLeft: bool): bool =
    if chooseLeft:
        if !SetMergedText(out, "left"):
            return false
    else:
        if !SetMergedText(out, "right"):
            return false
    out = "done"
    return true

fn main(): int32 =
    var first: bool[]
    var second: bool[]
    var third: bool[]
    var fourth: bool[]
    var fifth: bool[]
    setLen(first, 1)
    setLen(second, 1)
    setLen(third, 1)
    setLen(fourth, 1)
    setLen(fifth, 1)
    for index in 0..<1:
        if !MarkFive(
                index, first, second, third, fourth, fifth):
            return 1
    if !first[0] || !second[0] || !third[0] ||
       !fourth[0] || !fifth[0]:
        return 2
    var mergedText = "start"
    if !RewriteMergedText(mergedText, true) ||
       mergedText != "done":
        return 3
    if !RewriteMergedText(mergedText, false) ||
       mergedText != "done":
        return 4
    return 0
