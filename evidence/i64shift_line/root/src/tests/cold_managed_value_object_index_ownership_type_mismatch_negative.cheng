import std/system as system

type ColdManagedIndexOwnershipSource =
    key: str

type ColdManagedIndexOwnershipTarget =
    key: str

fn main(): int32 =
    var sourceValue: ColdManagedIndexOwnershipSource
    sourceValue.key = system.NewStringCopy(
        system.StrDataPtr("source"), 6)
    var source: ColdManagedIndexOwnershipSource[]
    add(source, sourceValue)

    var target: ColdManagedIndexOwnershipTarget[]
    add(target, source[0])
    return 0
