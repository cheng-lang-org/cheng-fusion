fn LabeledBlockBreakValue(): int32 =
    var value: int32
    block outer:
        for i in range(0, 5):
            if i == 2:
                value = 7
                break outer
        else:
            value = 99
    return value

fn CompletedForElseValue(): int32 =
    var value: int32
    for i in range(0, 3):
        value = value + i
    else:
        value = value + 10
    return value

fn BrokenForSkipsElseValue(): int32 =
    var value: int32
    for i in range(0, 4):
        if i == 2:
            break
        value = value + 1
    else:
        value = 99
    return value

fn ContinueCrossesBlockValue(): int32 =
    var value: int32
    for i in range(0, 4):
        block localScope:
            if i == 1:
                continue
            value = value + i
    return value

fn NestedLabelTargetsExactBlockValue(): int32 =
    var value: int32
    block outer:
        block inner:
            value = 3
            break outer
        value = 99
    return value + 4

fn InlineBlockBreakValue(): int32 =
    var value: int32
    block done: value = 5; break done; value = 99
    return value

fn UnlabeledBlockScopeValue(): int32 =
    var value: int32
    block:
        value = 4
    return value + 1

fn UnlabeledBlockInlineValue(): int32 =
    var value: int32
    block: value = 6
    return value

fn UnlabeledBlockBreakTargetsLoopValue(): int32 =
    var value: int32
    for i in range(0, 5):
        block:
            if i == 2:
                value = i
                break
        value = value + 10
    return value

fn CompletedWhileElseFromLeftExitValue(): int32 =
    var i: int32
    var value: int32
    while i < 3 && value < 100:
        value = value + i
        i = i + 1
    else:
        value = value + 10
    return value

fn CompletedWhileElseFromRightExitValue(): int32 =
    var i: int32
    var value: int32 = 100
    while i < 3 && value < 100:
        i = i + 1
    else:
        value = value + 7
    return value

fn CompletedNegatedWhileElseValue(): int32 =
    var i: int32
    while !(i >= 3):
        i = i + 1
    else:
        i = i + 8
    return i

fn BrokenWhileSkipsElseValue(): int32 =
    var i: int32
    var value: int32
    while i < 4:
        if i == 2:
            break
        value = value + 1
        i = i + 1
    else:
        value = 99
    return value

fn main(): int32 =
    if LabeledBlockBreakValue() != 7:
        return 1
    if CompletedForElseValue() != 13:
        return 2
    if BrokenForSkipsElseValue() != 2:
        return 3
    if ContinueCrossesBlockValue() != 5:
        return 4
    if NestedLabelTargetsExactBlockValue() != 7:
        return 5
    if InlineBlockBreakValue() != 5:
        return 6
    if CompletedWhileElseFromLeftExitValue() != 13:
        return 7
    if CompletedWhileElseFromRightExitValue() != 107:
        return 8
    if CompletedNegatedWhileElseValue() != 11:
        return 9
    if BrokenWhileSkipsElseValue() != 2:
        return 10
    if UnlabeledBlockScopeValue() != 5:
        return 11
    if UnlabeledBlockInlineValue() != 6:
        return 12
    if UnlabeledBlockBreakTargetsLoopValue() != 2:
        return 13
    return 0
