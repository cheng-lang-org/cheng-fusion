# tests for BMI270 builder/parser/shake detector
import "src/mosaico/frame.cheng" as frame
import "src/mosaico/bmi270.cheng" as bmi

fn CaseInitGolden(): int32 =
    var buf: uint8[frame.FrameCap]
    var n = 0
    n = bmi.BuildInitSeq(buf, n)
    if n != 6:
        return 1
    if frame.FrameGet8(buf, n, 0) != 0x7C:
        return 2
    if frame.FrameGet8(buf, n, 1) != 0x0E:
        return 4
    if frame.FrameGet8(buf, n, 4) != 0x42:
        return 8
    return 0

# raw s16 LE sample: +16384 LSB = +1 g at +-2g range -> mg approx via 61/1000
fn CaseAccelParse(): int32 =
    var buf: uint8[frame.FrameCap]
    var n = 0
    # x = 16384 (1g) -> 16384*61/1000 = 999 mg; y = -8192 -> -499; z = 0
    n = frame.FramePut16Le(buf, n, 16384)
    n = frame.FramePut16Le(buf, n, -8192 & 0xFFFF)
    n = frame.FramePut16Le(buf, n, 0)
    if n != 6:
        return 1
    let packed = bmi.PackAccelMgFrom(buf, n, 0)
    if packed < 0:
        return 2
    let x = bmi.UnpackAxis(packed, 0)
    let y = bmi.UnpackAxis(packed, 1)
    let z = bmi.UnpackAxis(packed, 2)
    if x != 999:
        return 4
    if y != -499:
        return 8
    if z != 0:
        return 16
    return 0

# shake sequence: quiet, three excursions inside window, then fire once
fn RunShakeSeq(mags: var int32[16], count: int32): int32 =
    var st = bmi.ShakeInitState()
    var firedCount = 0
    var i = 0
    while i < count:
        let r = bmi.ShakeStep(st, mags[i])
        st = bmi.ShakeStateOf(r)
        firedCount = firedCount + bmi.ShakeFiredOf(r)
        i = i + 1
    return firedCount * 100 + (st & 3)

fn CaseShakeFires(): int32 =
    var seq: int32[16]
    seq[0] = 200
    seq[1] = 1900
    seq[2] = 300
    seq[3] = 2100
    seq[4] = 250
    seq[5] = 2400
    let r = RunShakeSeq(seq, 6)
    let fired = r / 100
    let endPhase = r % 100
    if fired != 1:
        return 1
    if endPhase != 2:
        # after firing the machine must be cooling (phase value 2)
        return 4
    return 0

fn CaseShakeQuietStaysArmed(): int32 =
    var seq: int32[16]
    seq[0] = 100
    seq[1] = 150
    seq[2] = 120
    seq[3] = 90
    let r = RunShakeSeq(seq, 4)
    if r != 0:
        return 1
    return 0

fn main(): int32 =
    var fails = 0
    fails = fails | (CaseInitGolden() << 0)
    fails = fails | (CaseAccelParse() << 5)
    fails = fails | ((CaseShakeFires() & 0x1F) << 10)
    fails = fails | ((CaseShakeQuietStaysArmed() & 0x1F) << 15)
    return fails
