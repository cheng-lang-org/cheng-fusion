import std/system as system

# D4 isolate: bind-release vs concat-temp.
# Case A: s = t  (rebind from another str; t built once per round by Fmt).
#   leak per round = bind-release gap (old s buffer not freed).
# Case B: s = Fmt"{Int32(r)}-{s}"  (concat rebind, known >=1/round).
# rounds=50; exit = 10000 + bucketA + bucketB*100 would overflow bucket math;
# instead run them in SEPARATE binaries via the CASE env-free two-file split.
# This file = Case A only. Exact count (<63 cap at rounds=50).

var probeSink: int32

fn RepeatAssign(rounds: int32): int32 =
    var t: str = Fmt"tt"
    var s: str = Fmt"ss"
    var acc: int32
    var r: int32
    while r < rounds:
        t = Fmt"t{Int32(r)}"
        s = t
        acc = acc + s.len
        r = r + 1
    return acc

fn main(): int32 =
    let before = system.MemLiveAllocations()
    let observed = RepeatAssign(50)
    let delta = system.MemLiveAllocations() - before
    probeSink = observed
    if observed <= 0:
        return 99
    if delta <= 0:
        return 0
    if delta > 199:
        return 199
    return int32(delta)
