# R12 Lane B: Result construction lowering regression fixture.
# Each constructor lowers via PrimaryBodyIrAppendResultConstruct (no Ok/Err
# call ordinal): 64B aggregate, ok-flag@0, value@aligned, errcode@tail,
# errmsg@tail+8, full sret copy. Byte layout verified by objdump and matches
# the IsErr/Value/Error projections (round-trip closed).
import std/result

fn ResultConstructOkStr(s: str): Result[str] =
    return Ok[str](s)

fn ResultConstructErrStr(m: str): Result[str] =
    return Err[str](m)

fn ResultConstructOkI32(v: int32): Result[int32] =
    return Ok[int32](v)

fn ResultConstructOkBool(b: bool): Result[bool] =
    return Ok[bool](b)
