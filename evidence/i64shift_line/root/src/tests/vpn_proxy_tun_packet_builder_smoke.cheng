import std/rawbytes as rawbytes
import cheng/apps/vpn_proxy/vpn_proxy_tun_dataplane as tun

fn put8(buf: var rawbytes.Bytes, idx: int32, value: int32) =
    rawbytes.BytesSet(buf, idx, value & 255)

fn put16(buf: var rawbytes.Bytes, idx: int32, value: int32) =
    put8(buf, idx, (value >> 8) & 255)
    put8(buf, idx + 1, value & 255)

fn put32(buf: var rawbytes.Bytes, idx: int32, value: int32) =
    put8(buf, idx, (value >> 24) & 255)
    put8(buf, idx + 1, (value >> 16) & 255)
    put8(buf, idx + 2, (value >> 8) & 255)
    put8(buf, idx + 3, value & 255)

fn ipv4Base(proto: int32, totalLen: int32): rawbytes.Bytes =
    var out: rawbytes.Bytes = rawbytes.BytesAlloc(totalLen)
    put8(out, 0, tun.VpnTunIpv4VersionIhl)
    put16(out, 2, totalLen)
    put8(out, 8, 64)
    put8(out, 9, proto)
    put8(out, 12, 10)
    put8(out, 13, 8)
    put8(out, 14, 0)
    put8(out, 15, 2)
    put8(out, 16, 198)
    put8(out, 17, 18)
    put8(out, 18, 0)
    put8(out, 19, 2)
    return out

fn tcpSynPacketToFakeHost(fakeHost: int32): rawbytes.Bytes =
    var out: rawbytes.Bytes = ipv4Base(tun.VpnTunProtoTcp, 40)
    put8(out, 18, (fakeHost >> 8) & 255)
    put8(out, 19, fakeHost & 255)
    put16(out, 20, 40000)
    put16(out, 22, 443)
    put32(out, 24, 1000)
    put8(out, 32, tun.VpnTunTcpHeaderNoOptions)
    put8(out, 33, 2)
    return out

fn tcpSynPacket(): rawbytes.Bytes =
    return tcpSynPacketToFakeHost(2)

fn tcpPayloadPacket(seq: int32, text: str): rawbytes.Bytes =
    let payload: rawbytes.Bytes = rawbytes.BytesFromString(text)
    let payloadLen: int32 = rawbytes.BytesLen(payload)
    var out: rawbytes.Bytes = ipv4Base(tun.VpnTunProtoTcp, 40 + payloadLen)
    put16(out, 20, 40000)
    put16(out, 22, 443)
    put32(out, 24, seq)
    put32(out, 28, 2)
    put8(out, 32, tun.VpnTunTcpHeaderNoOptions)
    put8(out, 33, tun.VpnTunTcpFlagsPshAck)
    if payloadLen > 0:
        rawbytes.BytesCopyInto(out, 40, payload)
    return out

fn tcpAckPacket(seq: int32, ack: int32): rawbytes.Bytes =
    var out: rawbytes.Bytes = ipv4Base(tun.VpnTunProtoTcp, 40)
    put16(out, 20, 40000)
    put16(out, 22, 443)
    put32(out, 24, seq)
    put32(out, 28, ack)
    put8(out, 32, tun.VpnTunTcpHeaderNoOptions)
    put8(out, 33, tun.VpnTunTcpFlagsAck)
    return out

fn tcpFinPacket(seq: int32, ack: int32): rawbytes.Bytes =
    var out: rawbytes.Bytes = ipv4Base(tun.VpnTunProtoTcp, 40)
    put16(out, 20, 40000)
    put16(out, 22, 443)
    put32(out, 24, seq)
    put32(out, 28, ack)
    put8(out, 32, tun.VpnTunTcpHeaderNoOptions)
    put8(out, 33, 17)
    return out

fn udpPacket(): rawbytes.Bytes =
    var out: rawbytes.Bytes = ipv4Base(tun.VpnTunProtoUdp, 31)
    put16(out, 20, 50000)
    put16(out, 22, 53)
    put16(out, 24, 11)
    put8(out, 28, int32('d'))
    put8(out, 29, int32('n'))
    put8(out, 30, int32('s'))
    return out

fn fakeDnsQueryPacketFor(qtype: int32,
                         sourcePort: int32,
                         queryId: int32): rawbytes.Bytes =
    var out: rawbytes.Bytes = ipv4Base(tun.VpnTunProtoUdp, 63)
    put16(out, 20, sourcePort)
    put16(out, 22, 53)
    put16(out, 24, 43)
    put16(out, 28, queryId)
    put16(out, 32, 1)
    put8(out, 40, 3)
    put8(out, 41, int32('g'))
    put8(out, 42, int32('r'))
    put8(out, 43, int32('s'))
    put8(out, 44, 10)
    put8(out, 45, int32('d'))
    put8(out, 46, int32('b'))
    put8(out, 47, int32('a'))
    put8(out, 48, int32('n'))
    put8(out, 49, int32('k'))
    put8(out, 50, int32('c'))
    put8(out, 51, int32('l'))
    put8(out, 52, int32('o'))
    put8(out, 53, int32('u'))
    put8(out, 54, int32('d'))
    put8(out, 55, 2)
    put8(out, 56, int32('c'))
    put8(out, 57, int32('n'))
    put8(out, 58, 0)
    put16(out, 59, qtype)
    put16(out, 61, 1)
    return out

fn fakeDnsQueryPacket(): rawbytes.Bytes =
    return fakeDnsQueryPacketFor(tun.VpnTunDnsQtypeA, 50001, 4660)

fn validIpv4Checksum(packet: rawbytes.Bytes): bool =
    return tun.VpnTunChecksumFold(tun.VpnTunChecksumBytes(packet, 0, 20)) == 0

fn validTcpChecksum(packet: rawbytes.Bytes): bool =
    let tcpLen: int32 = rawbytes.BytesLen(packet) - 20
    let sum: int64 = tun.VpnTunPseudoHeaderChecksum(packet, tun.VpnTunProtoTcp, tcpLen) +
                     tun.VpnTunChecksumBytes(packet, 20, tcpLen)
    return tun.VpnTunChecksumFold(sum) == 0

fn validUdpChecksum(packet: rawbytes.Bytes): bool =
    let udpLen: int32 = rawbytes.BytesLen(packet) - 20
    let sum: int64 = tun.VpnTunPseudoHeaderChecksum(packet, tun.VpnTunProtoUdp, udpLen) +
                     tun.VpnTunChecksumBytes(packet, 20, udpLen)
    return tun.VpnTunChecksumFold(sum) == 0

fn main(): int32 =
    var runtime: tun.VpnTunRuntime
    tun.VpnTunInitRuntime(runtime)

    let syn: rawbytes.Bytes = tcpSynPacket()
    var decision: tun.VpnTunPacketDecision
    assert(tun.VpnTunDecidePacket(runtime, syn, "www.google.com", decision),
           " tun packet builder syn decision")
    assert(decision.action == tun.VpnTunPacketTcpOpen, " tun packet builder open action")

    let synAck: rawbytes.Bytes = tun.VpnTunBuildTcpSynAck(runtime, syn)
    var parsedSynAck: tun.VpnTunIpv4Packet
    assert(tun.VpnTunParseIpv4(synAck, parsedSynAck), " tun packet builder parse synack")
    assert(parsedSynAck.srcPort == 443, " tun packet builder synack src port")
    assert(parsedSynAck.dstPort == 40000, " tun packet builder synack dst port")
    assert(parsedSynAck.tcpFlags == tun.VpnTunTcpFlagsSynAck, " tun packet builder synack flags")
    assert(parsedSynAck.tcpAck == 1001, " tun packet builder synack ack")
    assert(parsedSynAck.tcpSeq == 1, " tun packet builder synack seq")
    assert(tun.VpnTunReadU16BE(synAck, 10) != 0, " tun packet builder ip checksum")
    assert(tun.VpnTunReadU16BE(synAck, 36) != 0, " tun packet builder tcp checksum")
    assert(validIpv4Checksum(synAck), " tun packet builder synack ip checksum valid")
    assert(validTcpChecksum(synAck), " tun packet builder synack tcp checksum valid")

    var duplicateSynDecision: tun.VpnTunPacketDecision
    assert(tun.VpnTunDecidePacket(runtime, syn, "www.google.com", duplicateSynDecision),
           " tun packet builder duplicate syn decision")
    assert(duplicateSynDecision.action == tun.VpnTunPacketTcpSynRetransmit,
           " tun packet builder duplicate syn retransmit action")
    let synAckRetransmit: rawbytes.Bytes = tun.VpnTunBuildTcpSynAckRetransmit(runtime, syn)
    var parsedSynAckRetransmit: tun.VpnTunIpv4Packet
    assert(tun.VpnTunParseIpv4(synAckRetransmit, parsedSynAckRetransmit),
           " tun packet builder parse synack retransmit")
    assert(parsedSynAckRetransmit.tcpFlags == tun.VpnTunTcpFlagsSynAck,
           " tun packet builder synack retransmit flags")
    assert(parsedSynAckRetransmit.tcpAck == 1001,
           " tun packet builder synack retransmit ack")
    assert(parsedSynAckRetransmit.tcpSeq == 1,
           " tun packet builder synack retransmit seq stable")
    assert(validIpv4Checksum(synAckRetransmit),
           " tun packet builder synack retransmit ip checksum valid")
    assert(validTcpChecksum(synAckRetransmit),
           " tun packet builder synack retransmit tcp checksum valid")

    let payload: rawbytes.Bytes = rawbytes.BytesFromString("ok")
    let payloadPacket: rawbytes.Bytes = tun.VpnTunBuildTcpPayload(runtime, syn, payload)
    var parsedPayload: tun.VpnTunIpv4Packet
    assert(tun.VpnTunParseIpv4(payloadPacket, parsedPayload), " tun packet builder parse payload")
    assert(parsedPayload.payloadLen == 2, " tun packet builder payload len")
    assert(parsedPayload.tcpSeq == 2, " tun packet builder payload seq after syn")
    assert(validIpv4Checksum(payloadPacket), " tun packet builder payload ip checksum valid")
    assert(validTcpChecksum(payloadPacket), " tun packet builder payload tcp checksum valid")
    assert(rawbytes.BytesGet(tun.VpnTunPacketPayload(payloadPacket), 0) == int32('o'),
           " tun packet builder payload byte")

    let clientPayload: rawbytes.Bytes = tcpPayloadPacket(1001, "hello")
    var firstPayloadDecision: tun.VpnTunPacketDecision
    assert(tun.VpnTunDecidePacket(runtime, clientPayload, "www.google.com", firstPayloadDecision),
           " tun packet builder client payload decision")
    assert(firstPayloadDecision.action == tun.VpnTunPacketTcpPayload,
           " tun packet builder first client payload action")
    assert(firstPayloadDecision.payloadSkip == 0,
           " tun packet builder first client payload no skip")
    let duplicatePayload: rawbytes.Bytes = tcpPayloadPacket(1001, "hello")
    var duplicateDecision: tun.VpnTunPacketDecision
    assert(tun.VpnTunDecidePacket(runtime, duplicatePayload, "www.google.com", duplicateDecision),
           " tun packet builder duplicate payload decision")
    assert(duplicateDecision.action == tun.VpnTunPacketTcpAck,
           " tun packet builder duplicate payload only ack")
    let overlapPayload: rawbytes.Bytes = tcpPayloadPacket(1003, "llo!")
    var overlapDecision: tun.VpnTunPacketDecision
    assert(tun.VpnTunDecidePacket(runtime, overlapPayload, "www.google.com", overlapDecision),
           " tun packet builder overlap payload decision")
    assert(overlapDecision.action == tun.VpnTunPacketTcpPayload,
           " tun packet builder overlap payload action")
    assert(overlapDecision.payloadSkip == 3,
           " tun packet builder overlap payload skip")
    let overlapNewBytes: rawbytes.Bytes = tun.VpnTunPacketPayloadFrom(overlapPayload, overlapDecision.payloadSkip)
    assert(rawbytes.BytesLen(overlapNewBytes) == 1,
           " tun packet builder overlap new len")
    assert(rawbytes.BytesGet(overlapNewBytes, 0) == int32('!'),
           " tun packet builder overlap new byte")

    let retransmitAck: rawbytes.Bytes = tcpAckPacket(1007, 2)
    var retransmitDecision: tun.VpnTunPacketDecision
    assert(tun.VpnTunDecidePacket(runtime, retransmitAck, "www.google.com", retransmitDecision),
           " tun packet builder retransmit ack decision")
    assert(retransmitDecision.action == tun.VpnTunPacketTcpAck,
           " tun packet builder retransmit ack action")
    let retransmitPacket: rawbytes.Bytes = tun.VpnTunBuildTcpRetransmit(runtime, retransmitAck)
    var parsedRetransmit: tun.VpnTunIpv4Packet
    assert(tun.VpnTunParseIpv4(retransmitPacket, parsedRetransmit),
           " tun packet builder parse retransmit")
    assert(parsedRetransmit.tcpSeq == 2, " tun packet builder retransmit seq")
    assert(parsedRetransmit.payloadLen == 2, " tun packet builder retransmit len")
    assert(rawbytes.BytesGet(tun.VpnTunPacketPayload(retransmitPacket), 0) == int32('o'),
           " tun packet builder retransmit byte")
    assert(validTcpChecksum(retransmitPacket), " tun packet builder retransmit checksum valid")

    let serverAck: rawbytes.Bytes = tcpAckPacket(1007, 4)
    var serverAckDecision: tun.VpnTunPacketDecision
    assert(tun.VpnTunDecidePacket(runtime, serverAck, "www.google.com", serverAckDecision),
           " tun packet builder server ack decision")
    let emptyRetransmit: rawbytes.Bytes = tun.VpnTunBuildTcpRetransmit(runtime, serverAck)
    assert(rawbytes.BytesLen(emptyRetransmit) == 0,
           " tun packet builder retransmit empty after ack")

    let finPacket: rawbytes.Bytes = tcpFinPacket(1007, 4)
    var finDecision: tun.VpnTunPacketDecision
    assert(tun.VpnTunDecidePacket(runtime, finPacket, "www.google.com", finDecision),
           " tun packet builder fin decision")
    assert(finDecision.action == tun.VpnTunPacketTcpClose,
           " tun packet builder fin close action")
    assert(runtime.stats.activeSessions == 1,
           " tun packet builder fin keeps session for server close")
    let finAck: rawbytes.Bytes = tun.VpnTunBuildTcpAck(runtime, finPacket)
    var parsedFinAck: tun.VpnTunIpv4Packet
    assert(tun.VpnTunParseIpv4(finAck, parsedFinAck), " tun packet builder parse fin ack")
    assert(parsedFinAck.tcpFlags == tun.VpnTunTcpFlagsAck,
           " tun packet builder fin ack flags")
    assert(parsedFinAck.tcpAck == 1008, " tun packet builder fin ack seq consumed")
    let serverFin: rawbytes.Bytes = tun.VpnTunBuildTcpFin(runtime, finPacket)
    var parsedServerFin: tun.VpnTunIpv4Packet
    assert(tun.VpnTunParseIpv4(serverFin, parsedServerFin), " tun packet builder parse server fin")
    assert(parsedServerFin.tcpFlags == tun.VpnTunTcpFlagsFinAck,
           " tun packet builder server fin flags")
    assert(parsedServerFin.tcpSeq == 4, " tun packet builder server fin seq")
    assert(parsedServerFin.tcpAck == 1008, " tun packet builder server fin ack")
    assert(tun.VpnTunDropSessionForPacket(runtime, finPacket),
           " tun packet builder explicit session drop")
    assert(runtime.stats.activeSessions == 0,
           " tun packet builder session removed after both sides close")

    let udp: rawbytes.Bytes = udpPacket()
    let udpReply: rawbytes.Bytes = tun.VpnTunBuildUdpResponse(udp, rawbytes.BytesFromString("rs"))
    var parsedUdp: tun.VpnTunIpv4Packet
    assert(tun.VpnTunParseIpv4(udpReply, parsedUdp), " tun packet builder parse udp")
    assert(parsedUdp.proto == tun.VpnTunProtoUdp, " tun packet builder udp proto")
    assert(parsedUdp.srcPort == 53, " tun packet builder udp src port")
    assert(parsedUdp.dstPort == 50000, " tun packet builder udp dst port")
    assert(tun.VpnTunReadU16BE(udpReply, 26) != 0, " tun packet builder udp checksum")
    assert(validIpv4Checksum(udpReply), " tun packet builder udp ip checksum valid")
    assert(validUdpChecksum(udpReply), " tun packet builder udp checksum valid")

    let httpsDnsQuery: rawbytes.Bytes = fakeDnsQueryPacketFor(tun.VpnTunDnsQtypeHttps, 50002, 22136)
    let httpsDnsReply: rawbytes.Bytes = tun.VpnTunMaybeBuildDnsResponse(runtime, httpsDnsQuery)
    assert(rawbytes.BytesLen(httpsDnsReply) > 0, " tun fake dns https nodata reply")
    var parsedHttpsDns: tun.VpnTunIpv4Packet
    assert(tun.VpnTunParseIpv4(httpsDnsReply, parsedHttpsDns), " tun fake dns https parse")
    assert(parsedHttpsDns.proto == tun.VpnTunProtoUdp, " tun fake dns https proto")
    assert(parsedHttpsDns.srcPort == 53, " tun fake dns https src port")
    assert(parsedHttpsDns.dstPort == 50002, " tun fake dns https dst port")
    assert(tun.VpnTunReadU16BE(httpsDnsReply, 28) == 22136,
           " tun fake dns https id")
    assert(tun.VpnTunReadU16BE(httpsDnsReply, 30) == tun.VpnTunDnsResponseFlagsNoError,
           " tun fake dns https flags")
    assert(tun.VpnTunReadU16BE(httpsDnsReply, 34) == 0,
           " tun fake dns https nodata answer count")
    assert(validIpv4Checksum(httpsDnsReply), " tun fake dns https ip checksum valid")
    assert(validUdpChecksum(httpsDnsReply), " tun fake dns https udp checksum valid")

    let dnsQuery: rawbytes.Bytes = fakeDnsQueryPacket()
    let fakeDnsReply: rawbytes.Bytes = tun.VpnTunMaybeBuildDnsResponse(runtime, dnsQuery)
    assert(rawbytes.BytesLen(fakeDnsReply) > 0, " tun fake dns reply")
    var parsedFakeDns: tun.VpnTunIpv4Packet
    assert(tun.VpnTunParseIpv4(fakeDnsReply, parsedFakeDns), " tun fake dns parse")
    assert(rawbytes.BytesGet(fakeDnsReply, 0) == tun.VpnTunIpv4VersionIhl,
           " tun fake dns ipv4 version ihl")
    assert(parsedFakeDns.proto == tun.VpnTunProtoUdp, " tun fake dns proto")
    assert(parsedFakeDns.srcPort == 53, " tun fake dns src port")
    assert(parsedFakeDns.dstPort == 50001, " tun fake dns dst port")
    assert(tun.VpnTunReadU16BE(fakeDnsReply, 28) == 4660,
           " tun fake dns id")
    assert(tun.VpnTunReadU16BE(fakeDnsReply, 30) == tun.VpnTunDnsResponseFlagsNoError,
           " tun fake dns flags")
    assert(tun.VpnTunReadU16BE(fakeDnsReply, 34) == 1,
           " tun fake dns answer count")
    assert(rawbytes.BytesGet(fakeDnsReply, 63) == tun.VpnTunDnsCompressedQuestionName,
           " tun fake dns answer name pointer")
    assert(rawbytes.BytesGet(fakeDnsReply, 64) == tun.VpnTunDnsQuestionOffset12,
           " tun fake dns answer name offset")
    assert(tun.VpnTunReadU16BE(fakeDnsReply, 65) == tun.VpnTunDnsQtypeA,
           " tun fake dns answer qtype")
    assert(tun.VpnTunReadU16BE(fakeDnsReply, 73) == 4,
           " tun fake dns answer rdlen")
    assert(tun.VpnTunReadU32BE(fakeDnsReply, 75) == tun.VpnTunFakeIpForHost(10),
           " tun fake dns answer ip")
    assert(validIpv4Checksum(fakeDnsReply), " tun fake dns ip checksum valid")
    assert(validUdpChecksum(fakeDnsReply), " tun fake dns udp checksum valid")
    let fakeSyn: rawbytes.Bytes = tcpSynPacketToFakeHost(10)
    var fakeDecision: tun.VpnTunPacketDecision
    assert(tun.VpnTunDecidePacket(runtime, fakeSyn, "", fakeDecision),
           " tun fake dns target decision")
    assert(fakeDecision.action == tun.VpnTunPacketTcpOpen,
           " tun fake dns target open")
    assert(fakeDecision.targetHost == "grs.dbankcloud.cn",
           " tun fake dns target exact domain")

    let exportedDomains: str = tun.VpnTunFakeDnsExportDomains(runtime)
    assert(len(exportedDomains) > 0, " tun fake dns export nonempty")
    var restartedRuntime: tun.VpnTunRuntime
    tun.VpnTunInitRuntime(restartedRuntime)
    let restoredCount: int32 = tun.VpnTunFakeDnsImportDomains(restartedRuntime, exportedDomains)
    assert(restoredCount == 1, " tun fake dns restore count")
    var restoredDecision: tun.VpnTunPacketDecision
    assert(tun.VpnTunDecidePacket(restartedRuntime, fakeSyn, "", restoredDecision),
           " tun fake dns restored target decision")
    assert(restoredDecision.action == tun.VpnTunPacketTcpOpen,
           " tun fake dns restored target open")
    assert(restoredDecision.targetHost == "grs.dbankcloud.cn",
           " tun fake dns restored target exact domain")

    let unknownFakeSyn: rawbytes.Bytes = tcpSynPacketToFakeHost(99)
    var unknownFakeDecision: tun.VpnTunPacketDecision
    assert(tun.VpnTunDecidePacket(runtime, unknownFakeSyn, "", unknownFakeDecision),
           " tun fake dns unknown fake-ip decision")
    assert(unknownFakeDecision.action == tun.VpnTunPacketTcpOpen,
           " tun fake dns unknown fake-ip opens rst path")
    assert(len(unknownFakeDecision.targetHost) == 0,
           " tun fake dns unknown fake-ip target empty")

    echo(" vpn_proxy_tun_packet_builder_smoke ok")
    return 0
