# Minimal aarch64-linux-android stdio FILE* miscompile reproduction.
#
# os.WriteLine(os.Get_stderr(), "x") exercises the exact crash path:
#   writeLine -> write -> osWriteAllRaw -> c_fwrite (cheng_fwrite) ->
#   cheng_safe_write_stream(stream) -> libc_fwrite/libc_fflush(safe).
#
# On darwin arm64 this prints "x" and exits 0. On aarch64-linux-android the
# cold backend miscompiles the FILE* flow and SIGSEGVs in fflush (fault 0x59).
#
# Also writes a regular-file marker so on-device success/failure is observable
# even though stderr itself may be the thing that crashes.
#
# New test-only file; does not modify any existing main-workspace source.

import std/os

fn main(): int32 =
    let _ = os.WriteFileResult("/data/local/tmp/moq/stdio_probe_before.txt", "before\n")
    os.WriteLine(os.Get_stderr(), "stderr-line-x")
    os.WriteLine(os.Get_stdout(), "stdout-line-y")
    let _2 = os.WriteFileResult("/data/local/tmp/moq/stdio_probe_after.txt", "after ALL_OK\n")
    return 0
