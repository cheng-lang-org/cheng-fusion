import std/os as os
import std/rawbytes
import std/strings
import std/system
import cheng/core/csg_core/csgc
import cheng/core/csg_core/csgc_mapped_reader as mapped_reader
import cheng/core/csg_core/merkle_builder
import cheng/core/csg_core/merkle_dag
import cheng/core/csg_core/merkle_manifest_verifier

const
    Standard: str = "csg_core::v1"
    BaseProfile: str = "csg_core"
    SourceId: str = "source:manifest-closure"

@borrows
fn fail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

@borrows
fn contains(text: str, wanted: str): bool =
    if wanted.len == 0:
        return true
    if wanted.len > text.len:
        return false
    for start in 0..<(text.len - wanted.len + 1):
        var equal = true
        for i in 0..<wanted.len:
            if text[start + i] != wanted[i]:
                equal = false
                break
        if equal:
            return true
    return false

@borrows
fn makeSource(
        schemaFact: str,
        symbolFact: str,
        sourceCid: str):
        merkle_builder.CsgCoreMerkleBuilderSource =
    var out: merkle_builder.CsgCoreMerkleBuilderSource
    out.sourceId = strings.CloneStr(SourceId)
    out.sourceCid = strings.CloneStr(sourceCid)
    out.facts = [
        strings.CloneStr(schemaFact),
        strings.CloneStr(symbolFact)
    ]
    return out

@borrows
fn object(
        kind: str,
        index: int32,
        cid: str,
        bytes: rawbytes.Bytes):
        merkle_manifest_verifier.CsgCoreMerkleManifestObject =
    var out: merkle_manifest_verifier.CsgCoreMerkleManifestObject
    out.kind = strings.CloneStr(kind)
    out.index = index
    out.cid = strings.CloneStr(cid)
    out.bytes = bytes
    return out

@borrows
fn closureObjects(
        closure: merkle_builder.CsgCoreMerkleBuilderResult,
        canonicalCsgc: rawbytes.Bytes):
        merkle_manifest_verifier.CsgCoreMerkleManifestObject[] =
    var out: merkle_manifest_verifier.CsgCoreMerkleManifestObject[]
    add(
        out,
        object(
            merkle_manifest_verifier.CsgCoreMerkleManifestCanonicalCsgcObjectKind(),
            0,
            closure.manifest.csgcObjectCid,
            canonicalCsgc))
    for i in 0..<closure.partitions.len:
        add(
            out,
            object(
                merkle_manifest_verifier.CsgCoreMerkleManifestPartitionFactsObjectKind(),
                i,
                closure.partitions[i].cid,
                closure.partitions[i].bytes))
    for i in 0..<closure.memberships.len:
        add(
            out,
            object(
                merkle_manifest_verifier.CsgCoreMerkleManifestMembershipObjectKind(),
                i,
                closure.memberships[i].cid,
                closure.memberships[i].bytes))
    for i in 0..<closure.nodeSegments.len:
        let nodeCid =
            merkle_dag.CsgCoreMerkleNodeRecordCid(
                closure.nodeSegments[i].nodes[0])
        add(
            out,
            object(
                merkle_manifest_verifier.CsgCoreMerkleManifestNodeObjectKind(),
                i,
                nodeCid,
                closure.nodeSegments[i].bytes))
    for i in 0..<closure.dependencyCargo.consumerShards.len:
        add(
            out,
            object(
                merkle_manifest_verifier.CsgCoreMerkleManifestDependencyConsumerObjectKind(),
                i,
                closure.dependencyCargo.consumerShards[i].cid,
                closure.dependencyCargo.consumerShards[i].bytes))
    for i in 0..<closure.dependencyCargo.providerShards.len:
        add(
            out,
            object(
                merkle_manifest_verifier.CsgCoreMerkleManifestDependencyProviderObjectKind(),
                i,
                closure.dependencyCargo.providerShards[i].cid,
                closure.dependencyCargo.providerShards[i].bytes))
    add(
        out,
        object(
            merkle_manifest_verifier.CsgCoreMerkleManifestSummaryObjectKind(),
            0,
            closure.summary.cid,
            closure.summary.bytes))
    for i in 0..<closure.queryCargo.shards.len:
        add(
            out,
            object(
                merkle_manifest_verifier.CsgCoreMerkleManifestQueryShardObjectKind(),
                i,
                closure.queryCargo.shards[i].cid,
                closure.queryCargo.shards[i].bytes))
    return out

fn main(): int32 =
    let schemaFact =
        "{\"features\":[\"core-facts\"],\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}"
    let symbolFact =
        "{\"file\":\"pkg://cheng/manifest/main.cheng\",\"id\":\"symbol:manifest\",\"kind\":\"csg.symbol\",\"name\":\"manifest\",\"symbol\":\"manifest\",\"symbolKind\":\"fn\"}"
    let sourceDag =
        merkle_dag.CsgCoreMerkleBuild(
            [schemaFact, symbolFact])
    if !sourceDag.ok:
        return fail("manifest source DAG fixture failed")
    let source =
        makeSource(
            schemaFact,
            symbolFact,
            sourceDag.subgraphCid)
    var closure =
        merkle_builder.CsgCoreMerkleBuildClosure(
            Standard,
            [BaseProfile],
            [source],
            [])
    if !closure.ok || !closure.admission.ok:
        let error = strings.CloneStr(closure.error)
        merkle_builder.CsgCoreMerkleBuilderFree(closure)
        return fail(
            strings.ConcatStr(
                "manifest closure fixture failed: ",
                error))
    let canonicalCsgc =
        csgc.CsgCoreCsgcEncodeCanonicalLines(
            [schemaFact, symbolFact])
    if !canonicalCsgc.ok:
        merkle_builder.CsgCoreMerkleBuilderFree(closure)
        return fail("manifest closure csgc fixture failed")
    let objects = closureObjects(closure, canonicalCsgc.bytes)
    let memoryAudit =
        merkle_manifest_verifier.CsgCoreMerkleManifestAuditReferencedObjects(
            closure.manifestArtifact.bytes,
            objects)
    var expectedObjectWireBytes: int64
    var expectedLargestTemporaryArtifactBytes =
        int64(rawbytes.BytesLen(
            closure.manifestArtifact.bytes))
    for i in 0..<objects.len:
        let objectWireBytes =
            int64(rawbytes.BytesLen(objects[i].bytes))
        expectedObjectWireBytes =
            expectedObjectWireBytes + objectWireBytes
        if objectWireBytes >
           expectedLargestTemporaryArtifactBytes:
            expectedLargestTemporaryArtifactBytes =
                objectWireBytes
    let expectedManifestWireBytes =
        int64(rawbytes.BytesLen(
            closure.manifestArtifact.bytes))
    let expectedResidentInputArtifactBytes =
        expectedManifestWireBytes + expectedObjectWireBytes
    let expectedPeakLiveArtifactBytes =
        expectedResidentInputArtifactBytes +
        expectedLargestTemporaryArtifactBytes
    let overBudget =
        merkle_manifest_verifier.CsgCoreMerkleManifestAuditReferencedObjectsWithLimit(
            closure.manifestArtifact.bytes,
            objects,
            expectedPeakLiveArtifactBytes - int64(1))
    let verified =
        merkle_manifest_verifier.CsgCoreMerkleManifestVerifyReferencedObjects(
            closure.manifestArtifact.cid,
            closure.manifestArtifact.bytes,
            objects)
    var stagedState: merkle_manifest_verifier.CsgCoreMerkleManifestStagedState
    var stagedReader: mapped_reader.CsgCoreCsgcMappedReader
    var stagedOwner: system.RuntimeAllocationLedgerSessionCapability
    let stagedFinal =
        merkle_manifest_verifier.CsgCoreMerkleManifestStagedFinalize(
            stagedState, stagedReader, stagedOwner)
    var failure: str
    if stagedFinal.ok || stagedFinal.totalHeapBounded ||
       stagedFinal.readerAuthorityProven ||
       stagedFinal.allocationReceiptVerified ||
       stagedFinal.receiptCidRecomputed ||
       stagedFinal.nativeExecutionIdentityProven ||
       stagedFinal.executionReceiptBound ||
       stagedFinal.allocationLedgerProven ||
       stagedFinal.productionReady ||
       stagedFinal.allocationReceiptCid.len != 0 ||
       stagedFinal.nativeExecutionIdentityCid.len != 0 ||
       stagedFinal.executionAdmissionReceiptCid.len != 0 ||
       !contains(stagedFinal.hardRed,
                 "cli_preallocation_owner_manifest_policy_binding_and_native_execution_identity_required"):
        failure = "manifest staged final receipt self-reference accepted"
    elif !memoryAudit.ok:
        failure = "manifest memory accounting rejected"
    elif memoryAudit.manifestWireBytes !=
             expectedManifestWireBytes ||
         memoryAudit.objectWireBytes !=
             expectedObjectWireBytes ||
         memoryAudit.residentInputArtifactBytes !=
             expectedResidentInputArtifactBytes:
        failure = "manifest memory input accounting mismatch"
    elif memoryAudit.largestTemporaryArtifactBytes !=
             expectedLargestTemporaryArtifactBytes ||
         memoryAudit.peakLiveArtifactBytes !=
             expectedPeakLiveArtifactBytes:
        failure = "manifest memory peak accounting mismatch"
    elif !memoryAudit.fullInventoryResident ||
         !memoryAudit.reencodeOverlapsFullInventory ||
         !memoryAudit.admissionOverlapsFullInventory ||
         memoryAudit.totalHeapBounded ||
         !contains(
             memoryAudit.hardRed,
             "store_staged_mapped_reader_and_bounded_semantic_admission_required"):
        failure = "manifest batch memory HARD_RED missing"
    elif memoryAudit.requiredReaderInterface !=
             merkle_manifest_verifier.CsgCoreMerkleManifestVerifierRequiredReaderInterface() ||
         !contains(
             memoryAudit.requiredReaderInterface,
             "feed_typed_object_once") ||
         !contains(
             memoryAudit.requiredReaderInterface,
             "finalize_after_complete_inventory"):
        failure = "manifest staged reader interface missing"
    elif overBudget.ok ||
         !contains(
             overBudget.error,
             "peak_live_wire_limit_exceeded"):
        failure = "manifest peak memory limit accepted"
    elif verified.ok:
        failure =
            "unbounded manifest verifier accepted production closure"
    elif !contains(
             verified.error,
             "merkle_manifest_memory_hard_red"):
        failure =
            "unbounded manifest verifier returned wrong error"

    rawbytes.BytesFree(canonicalCsgc.bytes)
    merkle_builder.CsgCoreMerkleBuilderFree(closure)
    if failure.len > 0:
        return fail(failure)
    os.WriteLine(
        os.Get_stdout(),
        "csg_core_merkle_manifest_closure_smoke hard_red ok")
    return 0
