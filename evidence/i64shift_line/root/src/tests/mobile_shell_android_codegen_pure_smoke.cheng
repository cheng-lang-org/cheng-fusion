    # 秒发 real-CID wiring (publish_cid_pipeline slice 2): a video publish must run the
    # production chunker pipeline BEFORE enqueue and embed the real content-addressed
    # ids into the post's extra — the post json handed to socialPublishEnqueue is the
    # CID-enriched finalPostJson, and any pipeline failure aborts the publish loudly.
    assert(strings.StrContains(activity, "private fun chengPublishCidIngestForVideo(media: ChengPublishMediaPayload, klass: Class<*>, instance: Any): JSONObject"),
           "mobile shell android pure: publish bridge has video CID ingest helper")
    assert(strings.StrContains(activity, "nativePublishCidIngest(media.localPath, posterFile.absolutePath, receiptsStore.absolutePath, taskId, contentId, ownerPeerId, durationMs, codecMime)"),
           "mobile shell android pure: publish bridge calls native CID pipeline with real video/poster paths")
    assert(strings.StrContains(activity, "chengPublishExtractPosterJpeg(media.localPath, posterFile)") &&
           strings.StrContains(activity, "retriever.getFrameAtTime(0L, MediaMetadataRetriever.OPTION_CLOSEST_SYNC)") &&
           strings.StrContains(activity, "bitmap.compress(android.graphics.Bitmap.CompressFormat.JPEG, 92, out)"),
           "mobile shell android pure: publish poster is a real frame extracted from the selected video")
    assert(strings.StrContains(activity, "android.media.MediaExtractor()") &&
           strings.StrContains(activity, "publish_cid_codec_probe_failed"),
           "mobile shell android pure: publish CID ingest probes the real video codec mime (no guessed codec)")
    let cidIngestIdx: int32 = smokeStrIndexOf(activity, "val cidResult = chengPublishCidIngestForVideo(media, klass, instance)", 0)
    assert(cidIngestIdx > 0 && cidIngestIdx < publishEnqueueInvokeIdx,
           "mobile shell android pure: video CID ingest runs before socialPublishEnqueue")
    assert(strings.StrContains(activity, "extraObj.put(\"assetCid\", cids.getString(\"assetCid\"))") &&
           strings.StrContains(activity, "extraObj.put(\"manifestCid\", cids.getString(\"manifestCid\"))") &&
           strings.StrContains(activity, "extraObj.put(\"posterCid\", cids.getString(\"posterCid\"))"),
           "mobile shell android pure: publish post extra embeds the three real CIDs")
