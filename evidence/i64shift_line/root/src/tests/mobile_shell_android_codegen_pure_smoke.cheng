    // Y-axis hit-test root-fix: requireSurfaceWidth/Height must derive from the
    // SurfaceHolder's own authoritative frame (holder.surfaceFrame), not from
    // resources.displayMetrics.widthPixels/heightPixels, which can silently
    // under-report the true edge-to-edge height (portrait nav-bar inset affects
    // height only, never width) and desync touch's phys->logical divisor from
    // the render's actual GLES viewport scale on the Y axis.
    assert(strings.StrContains(activity, "val w = holder.surfaceFrame.width()"),
           "mobile shell android pure: requireSurfaceWidth derives from surfaceFrame")
    assert(strings.StrContains(activity, "val h = holder.surfaceFrame.height()"),
           "mobile shell android pure: requireSurfaceHeight derives from surfaceFrame (y-size, not x-size)")
    assert(!strings.StrContains(activity, "resources.displayMetrics.widthPixels"),
           "mobile shell android pure: no displayMetrics width clamp left in surface sizing")
    assert(!strings.StrContains(activity, "resources.displayMetrics.heightPixels"),
           "mobile shell android pure: no displayMetrics height clamp left in surface sizing")
    // S6 (video-seek-scrub-blueprint.md §1.3/§S6, task #14 CSG payload 贯通): the JNI Seek
    // dispatch now forwards a video-kind numeric payload to the decoder-level whole-file
    // seek target — cheng_host_video_seek previously had zero callers anywhere in this
    // generated source (mirrors the Harmony host's seek_epoch-gated entry).
    assert(strings.StrContains(host, "cheng_host_video_seek(1, (int32_t)seekMsParsed)"),
           "mobile shell android pure: JNI media action forwards video Seek to cheng_host_video_seek")
    assert(strings.StrContains(host, "receipt_kind == 1 && strcmp(actionRaw, \"Seek\") == 0"),
