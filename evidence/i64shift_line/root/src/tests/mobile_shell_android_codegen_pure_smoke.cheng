import std/strings
import cheng/core/tooling/mobile_shell_codegen as mshell

fn smokeStrIndexOf(text: str, sub: str, fromIndex: int32): int32 =
    let n: int32 = len(text)
    let m: int32 = len(sub)
    if m <= 0 || fromIndex < 0:
        return -1
    var i: int32 = fromIndex
    while i + m <= n:
        var j: int32 = 0
        while j < m && text[i + j] == sub[j]:
            j = j + 1
        if j == m:
            return i
        i = i + 1
    return -1

fn main(): int32 =
    var opts: mshell.MobileShellOptions
    opts.rootDir = "/tmp"
    opts.outDir = "/tmp/cheng_mobile_shell_android_codegen_pure"
    opts.appId = "org.cheng.smoke"
    opts.appName = "ChengSmoke"
    opts.libName = "cheng_smoke_app"
    opts.runtimeMode = "r2c_native_gui_v1"
    opts.runtimeContractPath = ""
    opts.runtimeBundlePath = ""
    opts.routeState = "home_default"
    opts.emitAndroid = true
    opts.emitIos = false
    opts.emitHarmony = false

    let launchKv: str = mshell.MobileShellLaunchArgsKvText("home_default",
                                                           "r2c_native_gui_v1",
                                                           "mobile_shell_runtime_contract_v1.json",
                                                           "runtime/mobile_shell_runtime_contract_payload.json",
                                                           "runtime/mobile_shell_runtime_bundle_payload.json")
    let launchJson: str = mshell.MobileShellLaunchArgsJsonText("home_default",
                                                               "r2c_native_gui_v1",
                                                               "mobile_shell_runtime_contract_v1.json",
                                                               "runtime/mobile_shell_runtime_contract_payload.json",
                                                               "runtime/mobile_shell_runtime_bundle_payload.json")
    let manifest: str = mshell.MobileShellAndroidManifest(opts)
    let activity: str = mshell.MobileShellAndroidActivity(opts)
    let gradle: str = mshell.MobileShellAndroidAppBuildGradle(opts)
    let cmake: str = mshell.MobileShellAndroidCmake(opts)
    let host: str = mshell.MobileShellAndroidHostSource(opts)
    let appExports: str = mshell.MobileShellJsonAppExportsText()

    assert(strings.StrContains(launchKv, "route_state=home_default"),
