type
    SystemLinkPlanStub =
        browserBridgeObjectPath: str

@borrows
@borrow_result
fn SystemLinkPlanBrowserBridgeObjectPath(plan: SystemLinkPlanStub): str =
    return plan.browserBridgeObjectPath

fn main(): int32 =
    var plan: SystemLinkPlanStub
    plan.browserBridgeObjectPath = "bridge.o"
    let value = SystemLinkPlanBrowserBridgeObjectPath(plan)
    if value != "bridge.o":
        return 1
    return 0
