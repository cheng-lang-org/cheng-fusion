# RFC 8032 epoch-1 smoke: standard base-point convention produces the
# official public keys for TEST1/TEST2 seeds; sign/verify self-consistent;
# cross-epoch verification refused. Epoch-0 legacy path untouched.

import std/os
import std/system
import std/rawbytes
import cheng/libp2p/crypto/ed25519/ed25519 as ed
import cheng/libp2p/crypto/types as ctypes

@borrows
fn HexToBytes(h: str): Bytes =
    let n: int32 = h.len / 2
    var out = BytesAlloc(n)
    var i: int32
    while i < n:
        var hi: int32 = 0
        var lo: int32 = 0
        let c1: int32 = BytesFromHexChar(osSliceStr(h, i * 2, i * 2))
        let c2: int32 = BytesFromHexChar(osSliceStr(h, i * 2 + 1, i * 2 + 1))
        hi = c1
        lo = c2
        BytesSet(out, i, hi * 16 + lo)
        i = i + 1
    return out

@borrows
fn BytesFromHexChar(c: str): int32 =
    if c == "0":
        return 0
    if c == "1":
        return 1
    if c == "2":
        return 2
    if c == "3":
        return 3
    if c == "4":
        return 4
    if c == "5":
        return 5
    if c == "6":
        return 6
    if c == "7":
        return 7
    if c == "8":
        return 8
    if c == "9":
        return 9
    if c == "a" or c == "A":
        return 10
    if c == "b" or c == "B":
        return 11
    if c == "c" or c == "C":
        return 12
    if c == "d" or c == "D":
        return 13
    if c == "e" or c == "E":
        return 14
    if c == "f" or c == "F":
        return 15
    return 0

@borrows
fn ToHex(b: Bytes): str =
    var outS: str = ""
    var i: int32
    while i < b.len:
        let byteVal: int32 = BytesGet(b, i)
        let hi: int32 = byteVal / 16
        let lo: int32 = byteVal % 16
        outS = outS + osSliceStr("0123456789abcdef", hi, hi)
        outS = outS + osSliceStr("0123456789abcdef", lo, lo)
        i = i + 1
    return outS

@borrows
fn BytesEqual(a: Bytes, b: Bytes): bool =
    if a.len != b.len:
        return false
    var i: int32
    while i < a.len:
        if BytesGet(a, i) != BytesGet(b, i):
            return false
        i = i + 1
    return true

@borrows
fn HexEq(b: Bytes, h: str): bool =
    let n: int32 = h.len / 2
    if b.len != n:
        return false
    var i: int32
    while i < n:
        let want: int32 = BytesFromHexChar(osSliceStr(h, i * 2, i * 2)) * 16 + BytesFromHexChar(osSliceStr(h, i * 2 + 1, i * 2 + 1))
        if BytesGet(b, i) != want:
            return false
        i = i + 1
    return true

fn main(): int32 =
    var rc: int32 = 0

    # TEST1: seed -> official pub (RFC 8032), empty message
    let seed1 = HexToBytes("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
    let kp1 = ed.keyPairFromSeedEpoch(seed1, 1)
    if !kp1.ok:
        return 1
    let pub1: Bytes = kp1.value.publicKey.data
    if !HexEq(pub1, "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"):
        os.WriteLine(os.Get_stderr(), "pub1=" + ToHex(pub1))
        os.WriteLine(os.Get_stderr(), "TEST1 epoch1 pubkey mismatch")
        rc = rc + 1

    # sign empty msg, verify under epoch 1
    let msgEmpty = BytesAlloc(0)
    let s1 = ed.signEd25519RawEpoch(kp1.value.privateKey.data, msgEmpty, 1)
    if !s1.ok:
        return 1
    if !ed.verifyEd25519Epoch(kp1.value.publicKey.data, msgEmpty, s1.value, 1):
        os.WriteLine(os.Get_stderr(), "TEST1 epoch1 verify failed")
        rc = rc + 1
    # byte-exact cross-check against independent implementation (RFC 8032)
    if !HexEq(s1.value, "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b"):
        os.WriteLine(os.Get_stderr(), "TEST1 signature not byte-identical to official")
        rc = rc + 1
    # cross-epoch: epoch1 signature must NOT verify under epoch0
    if ed.verifyEd25519Epoch(kp1.value.publicKey.data, msgEmpty, s1.value, 0):
        os.WriteLine(os.Get_stderr(), "cross-epoch verify accepted")
        rc = rc + 1

    # TEST2: seed -> official pub, single byte 0x72 message
    let seed2 = HexToBytes("4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb")
    let kp2 = ed.keyPairFromSeedEpoch(seed2, 1)
    if !kp2.ok:
        return 1
    let pub2: Bytes = kp2.value.publicKey.data
    if !HexEq(pub2, "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c"):
        os.WriteLine(os.Get_stderr(), "TEST2 epoch1 pubkey mismatch")
        rc = rc + 1
    var msg72 = BytesAlloc(1)
    BytesSet(msg72, 0, 0x72)
    let s2 = ed.signEd25519RawEpoch(kp2.value.privateKey.data, msg72, 1)
    if !s2.ok:
        return 1
    if !ed.verifyEd25519Epoch(kp2.value.publicKey.data, msg72, s2.value, 1):
        if !HexEq(s2.value, "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00"):
            os.WriteLine(os.Get_stderr(), "TEST2 signature not byte-identical")
            rc = rc + 1
        os.WriteLine(os.Get_stderr(), "TEST2 epoch1 verify failed")
        rc = rc + 1

    # epoch-0 legacy path unchanged: pub differs from epoch1, self-consistent
    let kp0 = ed.keyPairFromSeedEpoch(seed1, 0)
    if !kp0.ok:
        return 1
    if HexEq(kp0.value.publicKey.data, "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"):
        os.WriteLine(os.Get_stderr(), "epoch0 pub unexpectedly standard")
        rc = rc + 1
    let s0 = ed.signEd25519RawEpoch(kp0.value.privateKey.data, msgEmpty, 0)
    if !s0.ok:
        return 1
    if !ed.verifyEd25519Epoch(kp0.value.publicKey.data, msgEmpty, s0.value, 0):
        os.WriteLine(os.Get_stderr(), "epoch0 self-verify failed")
        rc = rc + 1
    # legacy wrappers still work (zero drift on existing identities)
    let kpLegacy = ed.keyPairFromSeed(seed1)
    if !kpLegacy.ok:
        return 1
    let pubL: Bytes = kpLegacy.value.publicKey.data
    let pub0: Bytes = kp0.value.publicKey.data
    if !BytesEqual(pubL, pub0):
        os.WriteLine(os.Get_stderr(), "legacy wrapper drift")
        rc = rc + 1

    if rc == 0:
        echo("rfc8032_epoch1_smoke ok")
    return rc
