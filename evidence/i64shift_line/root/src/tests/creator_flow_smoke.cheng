# creator flow smoke: fund -> submit -> challenge/slash -> resubmit ->
# settle split, with conservation across the whole lifecycle.
# Slash is stake/10 = 100; reward bp 200 -> challenger 2, burn 3, safety 95.

import std/os
import std/system
import cheng/std/bytes_layout as layout
import cheng/apps/rwad/rwad_settlement as ssm
import cheng/chain/rwad_bridge_contract as brg
import cheng/apps/rwad/rwad_creator_flow as cff

fn Tag(b: int32): layout.FixedBytes32 =
    var raw = BytesAlloc(32)
    BytesSet(raw, 0, b)
    let res = layout.FixedBytes32FromBytes(raw)
    return res.value

fn main(): int32 =
    var rc: int32 = 0
    var st = ssm.SsmInit()

    let sponsor = Tag(20)
    let challenger = Tag(21)
    let cRes = ssm.SsmCredit(st, sponsor, Int64(1200))
    if !cRes.ok:
        return 1

    var flow: cff.CreatorFlow
    flow.campaignCid = Tag(30)
    flow.creatorCid = Tag(31)
    flow.platformCid = Tag(32)

    let f1 = cff.FlowFund(st, flow, sponsor, Int64(1000), Int64(5000))
    if !f1.ok:
        os.WriteLine(os.Get_stderr(), "first fund failed")
        rc = rc + 1
    let f2 = cff.FlowFund(st, flow, sponsor, Int64(100), Int64(5000))
    if f2.ok:
        os.WriteLine(os.Get_stderr(), "double fund accepted")
        rc = rc + 1
    if ssm.SsmBalanceOf(st, sponsor) != 200:
        os.WriteLine(os.Get_stderr(), "sponsor debit wrong after fund")
        rc = rc + 1

    var entries: brg.BridgeEntry[]
    var e1: brg.BridgeEntry
    e1.accountCid = Tag(41)
    e1.amount = Int64(60)
    add(entries, e1)
    var e2: brg.BridgeEntry
    e2.accountCid = Tag(42)
    e2.amount = Int64(40)
    add(entries, e2)
    let sub1 = cff.FlowSubmitUsageBatch(st, flow, entries, Tag(33), Int64(100), Int64(1000))
    if !sub1.ok:
        os.WriteLine(os.Get_stderr(), "submit failed")
        rc = rc + 1

    let badC = cff.FlowChallenge(st, flow, challenger, false)
    if !badC.ok or badC.value:
        os.WriteLine(os.Get_stderr(), "invalid challenge semantics wrong")
        rc = rc + 1

    let goodC = cff.FlowChallenge(st, flow, challenger, true)
    if !goodC.ok or !goodC.value:
        os.WriteLine(os.Get_stderr(), "valid challenge failed")
        rc = rc + 1
    # slash 100 at bp200 -> challenger reward 2, burn 3, safety 95
    if ssm.SsmBalanceOf(st, challenger) != 2:
        os.WriteLine(os.Get_stderr(), "challenge reward mismatch (expect 2)")
        rc = rc + 1
    if st.pools.burnBucket != 3 or st.pools.safetyFund != 95:
        os.WriteLine(os.Get_stderr(), "slash split pools mismatch")
        rc = rc + 1

    # settle while challenged must fail
    let earlySettle = cff.FlowSettle(st, flow, 8000)
    if earlySettle.ok:
        os.WriteLine(os.Get_stderr(), "settle on challenged accepted")
        rc = rc + 1

    # resubmit after challenge, settle 80/20 over remaining 900
    let sub2 = cff.FlowSubmitUsageBatch(st, flow, entries, Tag(34), Int64(3000), Int64(10))
    if !sub2.ok:
        os.WriteLine(os.Get_stderr(), "resubmit failed")
        rc = rc + 1
    let settle = cff.FlowSettle(st, flow, 8000)
    if !settle.ok:
        os.WriteLine(os.Get_stderr(), "settle failed")
        rc = rc + 1
    if ssm.SsmBalanceOf(st, flow.creatorCid) != 720:
        os.WriteLine(os.Get_stderr(), "creator cut mismatch (expect 720)")
        rc = rc + 1
    if ssm.SsmBalanceOf(st, flow.platformCid) != 180:
        os.WriteLine(os.Get_stderr(), "platform cut mismatch (expect 180)")
        rc = rc + 1

    # conservation: 1200 == sponsor remainder 200 + challenger 2
    #   + pools 98 + creator 720 + platform 180
    let sponsorEnd: int64 = ssm.SsmBalanceOf(st, sponsor)
    let poolsTotal: int64 = st.pools.burnBucket + st.pools.safetyFund
    if sponsorEnd + 2 + poolsTotal + 720 + 180 != 1200:
        os.WriteLine(os.Get_stderr(), "lifecycle conservation broken")
        rc = rc + 1

    if rc == 0:
        echo("creator_flow_smoke ok")
    return rc
