import cheng/tests/cold_cross_module_object_layout_wrong as wrong
import cheng/tests/cold_cross_module_object_layout_plan as exec_plan
import cheng/tests/cold_cross_module_object_layout_config as config

fn main(): int32 =
    let touch = wrong.ColdWrongCliConfigTouch()
    if touch != 0:
        return 99
    var args: str[]
    add(args, "gpt-5")
    add(args, "/tmp/rust-csg-cross-module-plan")
    var p = exec_plan.ColdCrossModulePlanParse(args)
    let rc = config.ColdCrossModulePlanConfigCheck(p)
    if rc != 0:
        return rc
    echo("cold_cross_module_object_layout_smoke ok")
    return 0
