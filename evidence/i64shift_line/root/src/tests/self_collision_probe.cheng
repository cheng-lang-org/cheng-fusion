# Self-collision and static-obstacle contact probe (contact extension
# preflight). Case A: two dynamic balls approach head-on at 0.5 m/s each;
# the sphere-sphere contact must split the separation 0.5/0.5 by inverse
# mass, quench the approaching relative normal velocity (e = 0) and keep
# every post-contact distance >= 0.95 * radius sum (no interpenetration).
# Case B: a dynamic ball with 1 m/s runs into a static (infinite mass,
# World3dBodyStatic) ball; the dynamic ball must stop at the pushed-out
# position with the inward normal velocity quenched while the static ball
# keeps its position bitwise unchanged.
# Frame traces are buffered during stepping (no string work inside the
# physics loop) and printed after each experiment finishes.
import cheng/game/world3d
import cheng/game/contacts3d
import cheng/game/physics3d
import cheng/game/csg/numerics
import std/math as m
import std/strings as strings

fn fmtQ(x: float64): str =
    let scaled: int32 = int32(m.roundFloat(x * 1000.0))
    var neg: bool = scaled < 0
    var mag: int32 = scaled
    if neg:
        mag = 0 - mag
    let intPart: int32 = mag / 1000
    let fracPart: int32 = mag % 1000
    var outStr: str = ""
    if neg:
        outStr = "-"
    outStr = outStr + strings.IntToStr(intPart) + "." + strings.CloneStrRange(strings.IntToStr(fracPart + 1000), 1, 3)
    return outStr

fn echoFrameA(i: int32, dist: float64, approach: float64) =
    echo("A frame i=" + strings.IntToStr(i) + " dist_mm=" + fmtQ(dist * 1000.0) + " approach_mms=" + fmtQ(approach * 1000.0))

fn echoFrameB(i: int32, dist: float64, vn: float64) =
    echo("B frame i=" + strings.IntToStr(i) + " dist_mm=" + fmtQ(dist * 1000.0) + " vn_mms=" + fmtQ(vn * 1000.0))

# Experiment A: head-on dynamic pair. Both balls (r = 0.05) start 0.4 m
# apart at z = 2.0 and close at a 1 m/s relative rate; the contact pass
# must stop the approach without letting the center distance dip below
# 0.95 * radius sum.
fn expSelfCollision(): bool =
    var w: world3d.World3d
    World3dReset(w, int64(31))
    let _a = World3dSpawnBody(w, -0.2, 0.0, 2.0, 1.0, 0.05, world3d.World3dBodyDynamic)
    let _b = World3dSpawnBody(w, 0.2, 0.0, 2.0, 1.0, 0.05, world3d.World3dBodyDynamic)
    w.bodyVx[0] = 0.5
    w.bodyVx[1] = 0.0 - 0.5
    let rSum: float64 = 0.10
    var traceI: int32[]
    var traceDist: float64[]
    var traceApproach: float64[]
    var sawContact: bool = false
    var firstContact: int32 = -1
    var minDist: float64 = 1000000000.0
    var finalDist: float64 = 0.0
    var finalApproach: float64 = 0.0
    var rejected: int32 = -1
    var i: int32 = 0
    while i < 120:
        var rcpt = physics3d.Physics3dStep(w, "probe:selfpair")
        if rcpt.statusCode != physics3d.Physics3dStatusOk:
            rejected = i
            break
        let dx = w.bodyPx[1] - w.bodyPx[0]
        let dy = w.bodyPy[1] - w.bodyPy[0]
        let dz = w.bodyPz[1] - w.bodyPz[0]
        let dist = numerics.CsgSqrt(dx * dx + dy * dy + dz * dz)
        let nX = dx / dist
        let approach = (w.bodyVx[0] - w.bodyVx[1]) * nX
        if rcpt.contactCount > 0:
            if !sawContact:
                firstContact = i
            sawContact = true
        if dist < minDist:
            minDist = dist
        finalDist = dist
        finalApproach = approach
        add(traceI, i)
        add(traceDist, dist)
        add(traceApproach, approach)
        i = i + 1
    var k: int32 = 0
    while k < traceI.len:
        if traceI[k] + 1 >= firstContact:
            if traceI[k] <= firstContact + 3:
                echoFrameA(traceI[k], traceDist[k], traceApproach[k])
        k = k + 1
    if rejected >= 0:
        echo("A FAIL step rejected i=" + strings.IntToStr(rejected))
        return false
    if !sawContact:
        echo("A FAIL no sphere-sphere contact detected")
        return false
    echo("A minDist_mm=" + fmtQ(minDist * 1000.0) + " limit_mm=" + fmtQ(0.95 * rSum * 1000.0) + " finalDist_mm=" + fmtQ(finalDist * 1000.0) + " finalApproach_mms=" + fmtQ(finalApproach * 1000.0))
    if minDist < 0.95 * rSum:
        echo("A FAIL interpenetration below 0.95 * radius sum")
        return false
    if finalApproach > 0.05:
        echo("A FAIL balls still approaching after contact")
        return false
    return true

# Experiment B: dynamic ball hits a static (infinite mass) ball. The
# dynamic ball must stop at the pushed-out position with the inward normal
# velocity quenched; the static ball's position must stay bitwise
# unchanged.
fn expStaticObstacle(): bool =
    var w: world3d.World3d
    World3dReset(w, int64(32))
    # 1 mm surface gap: the 1 m/s impact must land within a tick or two,
    # before gravity drops the ball past the static sphere's equator
    let _a = World3dSpawnBody(w, -0.101, 0.0, 2.0, 1.0, 0.05, world3d.World3dBodyDynamic)
    let _b = World3dSpawnBody(w, 0.0, 0.0, 2.0, 0.0, 0.05, world3d.World3dBodyStatic)
    w.bodyVx[0] = 1.0
    let rSum: float64 = 0.10
    let staticPx: float64 = w.bodyPx[1]
    let staticPy: float64 = w.bodyPy[1]
    let staticPz: float64 = w.bodyPz[1]
    var traceI: int32[]
    var traceDist: float64[]
    var traceVn: float64[]
    var sawContact: bool = false
    var firstContact: int32 = -1
    var minDist: float64 = 1000000000.0
    var finalDist: float64 = 0.0
    var finalVn: float64 = 0.0
    var rejected: int32 = -1
    var i: int32 = 0
    while i < 100:
        var rcpt = physics3d.Physics3dStep(w, "probe:staticob")
        if rcpt.statusCode != physics3d.Physics3dStatusOk:
            rejected = i
            break
        let dx = w.bodyPx[0] - w.bodyPx[1]
        let dy = w.bodyPy[0] - w.bodyPy[1]
        let dz = w.bodyPz[0] - w.bodyPz[1]
        let dist = numerics.CsgSqrt(dx * dx + dy * dy + dz * dz)
        let nX = dx / dist
        let vn = w.bodyVx[0] * nX
        if rcpt.contactCount > 0:
            if !sawContact:
                firstContact = i
            sawContact = true
        if dist < minDist:
            minDist = dist
        finalDist = dist
        finalVn = vn
        add(traceI, i)
        add(traceDist, dist)
        add(traceVn, vn)
        i = i + 1
    var k: int32 = 0
    while k < traceI.len:
        if traceI[k] + 1 >= firstContact:
            if traceI[k] <= firstContact + 3:
                echoFrameB(traceI[k], traceDist[k], traceVn[k])
        k = k + 1
    if rejected >= 0:
        echo("B FAIL step rejected i=" + strings.IntToStr(rejected))
        return false
    if !sawContact:
        echo("B FAIL no dynamic-vs-static contact detected")
        return false
    let drift = m.absFloat(w.bodyPx[1] - staticPx) + m.absFloat(w.bodyPy[1] - staticPy) + m.absFloat(w.bodyPz[1] - staticPz)
    echo("B minDist_mm=" + fmtQ(minDist * 1000.0) + " limit_mm=" + fmtQ(0.95 * rSum * 1000.0) + " finalDist_mm=" + fmtQ(finalDist * 1000.0) + " finalVn_mms=" + fmtQ(finalVn * 1000.0) + " staticDrift_mm=" + fmtQ(drift * 1000.0))
    if minDist < 0.95 * rSum:
        echo("B FAIL interpenetration below 0.95 * radius sum")
        return false
    if drift != 0.0:
        echo("B FAIL static body moved")
        return false
    if finalVn < 0.0 - 0.05:
        echo("B FAIL dynamic ball still moving into the static ball")
        return false
    return true

fn main(): int32 =
    contacts3d.Contacts3dSelfCollisionSet(1)
    let selfOk = expSelfCollision()
    let staticOk = expStaticObstacle()
    echo("audit selfOk=" + strings.IntToStr(int32(selfOk)) + " staticOk=" + strings.IntToStr(int32(staticOk)))
    if selfOk:
        if staticOk:
            echo("PASS self collision probe")
            return 0
    echo("FAIL self collision probe")
    return 1
