# libp2p P3 收尾片: 撤销新鲜度网络腿 — 请求方 (B) 客户端 exe (正典 §11.6 P3 先取撤销闭环)。
# B 真两进程之另一: 空库空 TOFU 从一个 channelId 出发, 真 UDP dial 应答方 A → 拉签名 head →
# 【接受前先取撤销】: 对 head.signerPubKey 发 REVOKE_REQ 从网络拉撤销状态 → 入本地撤销库 →
#   revoked=true 即拒收该 head (不落 TOFU, B 库零污染); revoked=false 才 TofuAdmit 接受。
#
# 用法: --port <bound> --store-root <B dir> --channel-id-hex <hex> --expect <clean|revoked>
#       [--prior-epoch E]

import std/system
import std/result
import std/cmdline as cmdline
import std/rawbytes as rawbytes
import cheng/std/bytes_layout as layout
import cheng/libp2p/protocols/cas_source/channel_head/head_codec as head
import cheng/libp2p/protocols/cas_source/channel_head/tofu as tofu
import cheng/libp2p/protocols/cas_source/channel_head/authz_store as authzstore
import cheng/libp2p/host/host_quic as hq
import std/strutils as strutil
import std/strings as strings

fn tofuEpochFor(storeRoot: str, channelIdHex: str): int64 =
    var loadRes = tofu.TofuLoad(storeRoot)
    if IsErr(loadRes):
        return int64(-1)
    let look = tofu.TofuLookup(Value(loadRes), channelIdHex)
    if !look.found:
        return int64(-1)
    return look.epoch

fn main(): int32 =
    let port = cmdline.ReadInt32FlagOrDefault("--port", -1)
    let storeRoot = cmdline.ReadFlagOrDefault("--store-root", "")
    let channelIdHex = cmdline.ReadFlagOrDefault("--channel-id-hex", "")
    let expect = cmdline.ReadFlagOrDefault("--expect", "clean")
    let priorEpoch = int64(cmdline.ReadInt32FlagOrDefault("--prior-epoch", -1))
    assert(port > 0, " client: --port required")
    assert(storeRoot != "", " client: --store-root required")
    assert(channelIdHex != "", " client: --channel-id-hex required")

    let cidRes = layout.FixedBytes32FromHex(channelIdHex)
    assert(cidRes.ok, " client: channel-id-hex 非 32B hex: " + Error(cidRes))
    let channelId = cidRes.value

    # ---- ① 拉 head (decode 自证绑定 + 真 ed25519 验签 + 请求绑定 三重在 FetchCasHead 内) ----
    var record: head.ChannelHeadRecord
    let fetchHeadRes = hq.Libp2pHostQuicFetchCasHead("127.0.0.1", port, "localhost", channelId, record)
    assert(fetchHeadRes.ok, " ① 拉 head: " + Error(fetchHeadRes))
    let signerFixed = layout.FixedBytes32FromBytes(record.signerPubKey).value

    let beforeEpoch = tofuEpochFor(storeRoot, channelIdHex)

    # ---- ② 先取撤销 (接受前): 对 head signer 从网络拉撤销状态 → 入本地库 ----
    var revoked = false
    let fetchRevRes = hq.Libp2pHostQuicFetchRevocation("127.0.0.1", port, "localhost", storeRoot, channelId, signerFixed, revoked)
    assert(fetchRevRes.ok, " ② FetchRevocation: " + Error(fetchRevRes))

    if expect == "revoked":
        assert(revoked, " revoked 场景: FetchRevocation 必须 revoked=true (网络找到撤销记录)")
        # 网络拉到的撤销记录已入本地库 (先取撤销判据)
        assert(authzstore.AuthzRevocationExists(storeRoot, channelId, record.signerPubKey), " revoked: 本地撤销库已有该 (channel,signer) [网络拉取落地]")
        # 拒收 head: 不落 TOFU, B 库零污染
        let afterEpoch = tofuEpochFor(storeRoot, channelIdHex)
        assert(afterEpoch == beforeEpoch, " revoked 零污染: TOFU epoch 未动 (before=" + strings.Int64ToStr(beforeEpoch) + " after=" + strings.Int64ToStr(afterEpoch) + ")")
        assert(afterEpoch == priorEpoch, " revoked 零污染: TOFU epoch == prior (" + strings.Int64ToStr(priorEpoch) + ")")
        echo(strutil.Join([" cas_revoke client REVOKED ok (先取撤销拒收 head) signer=", rawbytes.BytesToHex(record.signerPubKey)], ""))
        echo(" cas_revoke_client ok")
        return 0

    # ---- clean 场景: 未撤销 → TofuAdmit 接受 ----
    assert(!revoked, " clean 场景: FetchRevocation 必须 revoked=false (网络无撤销记录/miss)")
    var admitRes = tofu.TofuAdmit(storeRoot, record.channelId, record.signerPubKey, record.epoch)
    assert(admitRes.ok, " ③ TofuAdmit (未撤销 → 接受): " + Error(admitRes))
    let admittedEpoch = tofuEpochFor(storeRoot, channelIdHex)
    assert(admittedEpoch == record.epoch, " ③ TOFU 落库 epoch == head epoch (" + strings.Int64ToStr(admittedEpoch) + ")")
    echo(strutil.Join([" cas_revoke client CLEAN ok (未撤销 → 接受) epoch=", strings.Int64ToStr(record.epoch)], ""))
    echo(" cas_revoke_client ok")
    return 0
