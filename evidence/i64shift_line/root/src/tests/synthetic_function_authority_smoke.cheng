import cheng/std/bytes_layout as layout
import cheng/core/runtime/arena as arenamod
import cheng/core/backend/provider_export_identity_receipt as peir
import cheng/core/backend/provider_export_identity_import as peii
import cheng/core/backend/synthetic_function_authority as sfa

fn fixtureCid(seed: int32): layout.FixedBytes32 =
    var out: layout.FixedBytes32
    for index in 0..<32:
        out.data[index] = uint8((seed + index * 29) & 255)
    return out

fn fixtureProviderReceipt(): peir.ProviderExportIdentityReceipt =
    var receipt = peir.ProviderExportIdentityReceiptInit(256)
    let provider0 = peir.ProviderExportIdentityReceiptAppendProvider(
        receipt, fixtureCid(1), fixtureCid(2), fixtureCid(3))
    assert(provider0 == 0,
           " synthetic authority smoke: provider0 row")
    assert(peir.ProviderExportIdentityReceiptAppendExport(
        receipt, provider0, 7, 11, 13, 17,
        fixtureCid(4), fixtureCid(5),
        peir.ProviderExportContractRoleSetCmdLine,
        "任意_set") == 0,
        " synthetic authority smoke: set export")
    assert(peir.ProviderExportIdentityReceiptAppendExport(
        receipt, provider0, 8, 11, 19, 23,
        fixtureCid(6), fixtureCid(7),
        peir.ProviderExportContractRoleRegisterLineMap,
        "ß_line") == 1,
        " synthetic authority smoke: line export")
    let provider1 = peir.ProviderExportIdentityReceiptAppendProvider(
        receipt, fixtureCid(8), fixtureCid(9), fixtureCid(10))
    assert(provider1 == 1,
           " synthetic authority smoke: provider1 row")
    assert(peir.ProviderExportIdentityReceiptAppendExport(
        receipt, provider1, 31, 29, 31, 37,
        fixtureCid(11), fixtureCid(12),
        peir.ProviderExportContractRoleProfileFlush,
        "任意_flush") == 2,
        " synthetic authority smoke: flush export")
    var err: str
    assert(peir.ProviderExportIdentityReceiptSealInto(receipt, err), err)
    return receipt

fn fixtureProviderActualSet(): peii.ProviderExportIdentityActualSet =
    var actuals = peii.ProviderExportIdentityActualSetInit(128)
    assert(peii.ProviderExportIdentityActualSetAppend(
        actuals, 1, fixtureCid(8), fixtureCid(9), fixtureCid(10)) == 0,
        " synthetic authority smoke: actual provider1")
    assert(peii.ProviderExportIdentityActualSetAppend(
        actuals, 0, fixtureCid(1), fixtureCid(2), fixtureCid(3)) == 1,
        " synthetic authority smoke: actual provider0")
    var err: str
    assert(peii.ProviderExportIdentityActualSetSealInto(actuals, err), err)
    return actuals

fn fixtureProviderImport(): peii.ProviderExportIdentityImportReceipt =
    var source = fixtureProviderReceipt()
    var actuals = fixtureProviderActualSet()
    var imported: peii.ProviderExportIdentityImportReceipt
    var err: str
    assert(peii.ProviderExportIdentityImportBuildInto(
               source, actuals, imported, err), err)
    assert(peii.ProviderExportIdentityImportStrictValidateInto(
               imported, err), err)
    peir.ProviderExportIdentityReceiptRelease(source)
    peii.ProviderExportIdentityActualSetRelease(actuals)
    return imported

@borrows
fn fixtureAuthority(
        provider: peii.ProviderExportIdentityImportReceipt):
        sfa.SyntheticFunctionAuthority =
    var authority = sfa.SyntheticFunctionAuthorityInit(256)
    var err: str
    assert(sfa.SyntheticFunctionAuthorityAppendEntryBridge(
        authority, fixtureCid(40), 101, fixtureCid(41),
        fixtureCid(42), fixtureCid(43), provider, err) == 0, err)
    assert(sfa.SyntheticFunctionAuthorityAppendEntryBridge(
        authority, fixtureCid(50), 202, fixtureCid(51),
        fixtureCid(52), fixtureCid(53), provider, err) == 1, err)
    assert(sfa.SyntheticFunctionAuthoritySealInto(authority, err), err)
    assert(sfa.SyntheticFunctionAuthorityStrictValidateInto(
               authority, err), err)
    return authority

@borrows
fn expectAuthorityInvalid(
        authority: sfa.SyntheticFunctionAuthority,
        expected: str) =
    var err: str
    assert(!sfa.SyntheticFunctionAuthorityStrictValidateInto(
               authority, err),
           " synthetic authority smoke: mutation accepted")
    assert(err == expected,
           " synthetic authority smoke: wrong mutation reason: " + err)

@borrows
fn appendRejections(
        provider: peii.ProviderExportIdentityImportReceipt,
        mutations: var int32) =
    var authority = sfa.SyntheticFunctionAuthorityInit(256)
    var err: str
    assert(sfa.SyntheticFunctionAuthorityAppendEntryBridge(
        authority, layout.FixedBytes32(), 1, fixtureCid(2),
        fixtureCid(3), fixtureCid(4), provider, err) == -1 &&
        err == " synthetic function authority: source or target identity invalid",
        " synthetic authority smoke: zero source artifact accepted: " + err)
    mutations = mutations + 1
    sfa.SyntheticFunctionAuthorityRelease(authority)

    var incomplete = fixtureProviderImport()
    incomplete.sourceActualSetCid = layout.FixedBytes32()
    var incompleteAuthority = sfa.SyntheticFunctionAuthorityInit(256)
    assert(sfa.SyntheticFunctionAuthorityAppendEntryBridge(
        incompleteAuthority, fixtureCid(65), 5, fixtureCid(66),
        fixtureCid(67), fixtureCid(68), incomplete, err) == -1 &&
        err == " provider export identity import: source cid invalid",
        " synthetic authority smoke: unverified actual set accepted: " + err)
    mutations = mutations + 1
    sfa.SyntheticFunctionAuthorityRelease(incompleteAuthority)
    peii.ProviderExportIdentityImportRelease(incomplete)

    var ambiguous = fixtureProviderImport()
    arenamod.ArenaArrayInt32Set(
        ambiguous.arena, ambiguous.roleKinds, 0,
        peir.ProviderExportContractRoleRegisterLineMap)
    var ambiguousAuthority = sfa.SyntheticFunctionAuthorityInit(256)
    assert(sfa.SyntheticFunctionAuthorityAppendEntryBridge(
        ambiguousAuthority, fixtureCid(82), 13, fixtureCid(83),
        fixtureCid(84), fixtureCid(85), ambiguous, err) == -1 &&
        err == " provider export identity import: role row invalid",
        " synthetic authority smoke: invalid role projection accepted: " + err)
    mutations = mutations + 1
    sfa.SyntheticFunctionAuthorityRelease(ambiguousAuthority)
    peii.ProviderExportIdentityImportRelease(ambiguous)

@borrows
fn strictMutations(
        provider: peii.ProviderExportIdentityImportReceipt,
        mutations: var int32) =
    var owner = fixtureAuthority(provider)
    arenamod.ArenaArrayInt32Set(
        owner.arena, owner.callOwnerFunctionRows, 0, 1)
    expectAuthorityInvalid(
        owner, " synthetic function authority: call identity invalid")
    mutations = mutations + 1
    sfa.SyntheticFunctionAuthorityRelease(owner)

    var source = fixtureAuthority(provider)
    arenamod.ArenaArrayInt32Set(
        source.arena, source.callProviderRows, 2, 0)
    expectAuthorityInvalid(
        source, " synthetic function authority: source call mismatch")
    mutations = mutations + 1
    sfa.SyntheticFunctionAuthorityRelease(source)

    var producer = fixtureAuthority(provider)
    producer.callProducerFactCids[0] = layout.FixedBytes32()
    expectAuthorityInvalid(
        producer, " synthetic function authority: provider call mismatch")
    mutations = mutations + 1
    sfa.SyntheticFunctionAuthorityRelease(producer)

    var functionCid = fixtureAuthority(provider)
    functionCid.functionCids[1].data[0] = uint8(
        int32(functionCid.functionCids[1].data[0]) ^ 1)
    expectAuthorityInvalid(
        functionCid, " synthetic function authority: function cid mismatch")
    mutations = mutations + 1
    sfa.SyntheticFunctionAuthorityRelease(functionCid)

    var authorityCid = fixtureAuthority(provider)
    authorityCid.authorityCid.data[0] = uint8(
        int32(authorityCid.authorityCid.data[0]) ^ 1)
    expectAuthorityInvalid(
        authorityCid, " synthetic function authority: authority cid mismatch")
    mutations = mutations + 1
    sfa.SyntheticFunctionAuthorityRelease(authorityCid)

    var targetTriple = fixtureAuthority(provider)
    targetTriple.functionTargetTripleCids[0].data[0] = uint8(
        int32(targetTriple.functionTargetTripleCids[0].data[0]) ^ 1)
    expectAuthorityInvalid(
        targetTriple, " synthetic function authority: function cid mismatch")
    mutations = mutations + 1
    sfa.SyntheticFunctionAuthorityRelease(targetTriple)

    var abiProfile = fixtureAuthority(provider)
    abiProfile.functionAbiProfileCids[0].data[0] = uint8(
        int32(abiProfile.functionAbiProfileCids[0].data[0]) ^ 1)
    expectAuthorityInvalid(
        abiProfile, " synthetic function authority: function cid mismatch")
    mutations = mutations + 1
    sfa.SyntheticFunctionAuthorityRelease(abiProfile)

    var providerReceipt = fixtureAuthority(provider)
    providerReceipt.functionProviderReceiptCids[0].data[0] = uint8(
        int32(providerReceipt.functionProviderReceiptCids[0].data[0]) ^ 1)
    expectAuthorityInvalid(
        providerReceipt,
        " synthetic function authority: function cid mismatch")
    mutations = mutations + 1
    sfa.SyntheticFunctionAuthorityRelease(providerReceipt)

    var providerActualSet = fixtureAuthority(provider)
    providerActualSet.functionProviderActualSetCids[0].data[0] = uint8(
        int32(providerActualSet.functionProviderActualSetCids[0].data[0]) ^ 1)
    expectAuthorityInvalid(
        providerActualSet,
        " synthetic function authority: function cid mismatch")
    mutations = mutations + 1
    sfa.SyntheticFunctionAuthorityRelease(providerActualSet)

    var providerImport = fixtureAuthority(provider)
    providerImport.functionProviderImportReceiptCids[0].data[0] = uint8(
        int32(providerImport.functionProviderImportReceiptCids[0].data[0]) ^ 1)
    expectAuthorityInvalid(
        providerImport,
        " synthetic function authority: function cid mismatch")
    mutations = mutations + 1
    sfa.SyntheticFunctionAuthorityRelease(providerImport)

    var sourceTypedRow = fixtureAuthority(provider)
    arenamod.ArenaArrayInt32Set(
        sourceTypedRow.arena,
        sourceTypedRow.functionSourceEntryTypedRows,
        0, 102)
    expectAuthorityInvalid(
        sourceTypedRow, " synthetic function authority: source call mismatch")
    mutations = mutations + 1
    sfa.SyntheticFunctionAuthorityRelease(sourceTypedRow)

@borrows
fn moveAndRelease(
        provider: peii.ProviderExportIdentityImportReceipt,
        mutations: var int32,
        retainedBuffersOut: var int32,
        retainedBytesOut: var int64) =
    var source = fixtureAuthority(provider)
    var occupied = fixtureAuthority(provider)
    var err: str
    assert(!sfa.SyntheticFunctionAuthorityMoveInto(
               occupied, source, err) &&
           err == " synthetic function authority: move output owns storage",
           " synthetic authority smoke: occupied output accepted: " + err)
    assert(sfa.SyntheticFunctionAuthorityStrictValidateInto(source, err), err)
    mutations = mutations + 1
    sfa.SyntheticFunctionAuthorityRelease(occupied)

    var moved: sfa.SyntheticFunctionAuthority
    assert(sfa.SyntheticFunctionAuthorityMoveInto(moved, source, err), err)
    assert(sfa.SyntheticFunctionAuthorityStorageReleased(source),
           " synthetic authority smoke: move source retained storage")
    var sourceRelease: sfa.SyntheticFunctionAuthorityReleaseReceipt
    assert(!sfa.SyntheticFunctionAuthorityReleaseWithReceipt(
               source, sourceRelease),
           " synthetic authority smoke: moved source released twice")
    mutations = mutations + 1

    let retainedBuffers =
        sfa.SyntheticFunctionAuthorityRetainedBufferCount(moved)
    let retainedBytes =
        sfa.SyntheticFunctionAuthorityRetainedBytes(moved)
    assert(retainedBuffers ==
               sfa.SyntheticFunctionAuthorityOwnedStorageColumnCount &&
           retainedBytes > 0,
           " synthetic authority smoke: retained ledger invalid")
    var released: sfa.SyntheticFunctionAuthorityReleaseReceipt
    assert(sfa.SyntheticFunctionAuthorityReleaseWithReceipt(
               moved, released),
           " synthetic authority smoke: release failed")
    assert(released.releasedOwnedStorageColumnCount ==
               sfa.SyntheticFunctionAuthorityOwnedStorageColumnCount &&
           released.releasedBufferCount == retainedBuffers &&
           released.releasedBytes == retainedBytes &&
           released.storageReleased &&
           sfa.SyntheticFunctionAuthorityStorageReleased(moved),
           " synthetic authority smoke: release ledger mismatch")
    assert(sfa.SyntheticFunctionAuthorityConsumeReleaseReceipt(
               moved, released),
           " synthetic authority smoke: release receipt rejected")
    assert(!sfa.SyntheticFunctionAuthorityConsumeReleaseReceipt(
               moved, released),
           " synthetic authority smoke: release receipt consumed twice")
    mutations = mutations + 1
    retainedBuffersOut = retainedBuffers
    retainedBytesOut = retainedBytes

fn main() =
    var provider = fixtureProviderImport()
    var mutations: int32
    appendRejections(provider, mutations)
    strictMutations(provider, mutations)

    var authority = fixtureAuthority(provider)
    assert(sfa.SyntheticFunctionAuthorityFunctionCount(authority) == 2 &&
           sfa.SyntheticFunctionAuthorityCallRowCount(authority) == 8,
           " synthetic authority smoke: multi-row shape invalid")
    assert(!layout.FixedBytes32Equal(
               authority.functionCids[0], authority.functionCids[1]),
           " synthetic authority smoke: distinct rows share function cid")
    assert(arenamod.ArenaArrayInt32Get(
               authority.arena, authority.callProviderRows, 0) == 0 &&
           arenamod.ArenaArrayInt32Get(
               authority.arena, authority.callProviderExportRows, 0) == 0 &&
           arenamod.ArenaArrayInt32Get(
               authority.arena, authority.callProviderRows, 3) == 1 &&
           arenamod.ArenaArrayInt32Get(
               authority.arena, authority.callProviderExportRows, 3) == 2,
           " synthetic authority smoke: provider coordinates not exact")
    let authorityCidText = layout.FixedBytes32Hex(authority.authorityCid)
    var appendErr: str
    assert(sfa.SyntheticFunctionAuthorityAppendEntryBridge(
        authority, fixtureCid(90), 303, fixtureCid(91),
        fixtureCid(92), fixtureCid(93), provider,
        appendErr) == -1 &&
        appendErr ==
            " synthetic function authority: append state invalid",
        " synthetic authority smoke: sealed authority mutated")
    mutations = mutations + 1
    sfa.SyntheticFunctionAuthorityRelease(authority)

    var retainedBuffers: int32
    var retainedBytes: int64
    moveAndRelease(
        provider, mutations, retainedBuffers, retainedBytes)
    echo("synthetic_function_authority_ok functions=2 calls=8 mutations=" +
         IntToStr(mutations) +
         " authority_cid=" + authorityCidText +
         " retained_buffers=" + IntToStr(retainedBuffers) +
         " retained_bytes=" + Int64ToStr(retainedBytes))
    peii.ProviderExportIdentityImportRelease(provider)
