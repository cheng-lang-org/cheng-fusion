import std/os
import std/system
import std/strformat
import std/seqs as seqs
import cheng/core/runtime/arena as arenamod
import cheng/core/lang/parser
import cheng/core/tooling/compiler_payload_lifecycle as lifecycle

fn lifecycleReceiptValid(
        receipt: lifecycle.CompilerPayloadLifecycleReceipt,
        outcome: int32,
        retainedBytes: int64,
        physicalBufferCount: int32): bool =
    return receipt.outcome == outcome &&
           receipt.allocated == int64(1) &&
           receipt.released == int64(1) &&
           receipt.live == int64(0) &&
           receipt.allocatedBytes == retainedBytes &&
           receipt.releasedBytes == retainedBytes &&
           receipt.liveBytes == int64(0) &&
           receipt.retained == int64(0) &&
           receipt.ownerTransferCount == int64(0) &&
           receipt.borrowReturnCount == int64(0) &&
           receipt.physicalBufferCount == physicalBufferCount &&
           receipt.physicalFreeCount == int64(physicalBufferCount) &&
           receipt.storageReleased &&
           receipt.ledgerStorageReleased &&
           receipt.ledgerStorageReleasedBufferCount > 0 &&
           receipt.ledgerStorageReleasedBytes > int64(0)

fn lifecycleRunOnce(outcome: int32): bool =
    var arena = arenamod.ArenaInitDefault(4096)
    let _ = arenamod.ArenaAllocBytes(arena, 128)
    var rowIndexes: int32[]
    var rowParents: int32[]
    seqs.setLen(rowIndexes, 32)
    seqs.setLen(rowParents, 32)
    for rowIndex in 0..<32:
        rowIndexes[rowIndex] = rowIndex
        rowParents[rowIndex] = rowIndex - 1
    let retainedBytes =
        int64(arena.capacityBytes) +
        int64(rowIndexes.cap) * int64(sizeof(int32)) +
        int64(rowParents.cap) * int64(sizeof(int32))
    let physicalBufferCount = int32(3)
    if retainedBytes <= int64(0):
        return false

    var state: lifecycle.CompilerPayloadLifecycle
    var receipt: lifecycle.CompilerPayloadLifecycleReceipt
    lifecycle.CompilerPayloadLifecycleBegin(
        state,
        lifecycle.CompilerPayloadKindFocusedTest,
        retainedBytes,
        physicalBufferCount)
    lifecycle.CompilerPayloadLifecyclePrepareTerminal(state)
    # An unrelated allocator free between prepare and payload release cannot
    # satisfy or perturb the payload-local physical receipt.
    var unrelatedRows: int32[]
    seqs.setLen(unrelatedRows, 8)
    seqs.freeSeq(unrelatedRows)
    arenamod.ArenaRelease(arena)
    seqs.freeSeq(rowIndexes)
    seqs.freeSeq(rowParents)
    var physicalRelease: lifecycle.CompilerPayloadPhysicalReleaseReceipt
    physicalRelease.releasedBufferCount = physicalBufferCount
    physicalRelease.releasedBytes = retainedBytes
    physicalRelease.storageReleased =
        arena.basePtr == nil &&
        arena.capacityBytes == 0 &&
        rowIndexes.cap == 0 &&
        rowParents.cap == 0
    lifecycle.CompilerPayloadLifecycleEnd(
        state, outcome, physicalRelease, receipt)
    return lifecycleReceiptValid(
        receipt, outcome, retainedBytes, physicalBufferCount)

fn lifecycleRunProductionHandoff(): bool =
    var arena = arenamod.ArenaInitDefault(4096)
    let _ = arenamod.ArenaAllocBytes(arena, 128)
    let retainedBytes = int64(arena.capacityBytes)
    var state: lifecycle.CompilerPayloadLifecycle
    var receipt: lifecycle.CompilerPayloadLifecycleReceipt
    lifecycle.CompilerPayloadLifecycleBegin(
        state,
        lifecycle.CompilerPayloadKindCompilerCsg,
        retainedBytes,
        1)
    lifecycle.CompilerPayloadLifecycleBorrowForConsumer(state)
    lifecycle.CompilerPayloadLifecyclePrepareTerminal(state)
    lifecycle.CompilerPayloadLifecycleReturnConsumerBorrow(state)
    lifecycle.CompilerPayloadLifecycleMoveToConsumer(state)
    lifecycle.CompilerPayloadLifecycleBorrowForTerminalConsumer(state)
    lifecycle.CompilerPayloadLifecycleReturnTerminalConsumerBorrow(state)
    arenamod.ArenaRelease(arena)
    var physicalRelease: lifecycle.CompilerPayloadPhysicalReleaseReceipt
    physicalRelease.releasedBufferCount = 1
    physicalRelease.releasedBytes = retainedBytes
    physicalRelease.storageReleased =
        arena.basePtr == nil && arena.capacityBytes == 0
    lifecycle.CompilerPayloadLifecycleEnd(
        state,
        lifecycle.CompilerPayloadOutcomeSuccess,
        physicalRelease,
        receipt)
    return receipt.allocated == int64(1) &&
           receipt.released == int64(1) &&
           receipt.live == int64(0) &&
           receipt.allocatedBytes == retainedBytes &&
           receipt.releasedBytes == retainedBytes &&
           receipt.liveBytes == int64(0) &&
           receipt.retained == int64(2) &&
           receipt.borrowReturnCount == int64(2) &&
           receipt.ownerTransferCount == int64(1) &&
           receipt.storageReleased &&
           receipt.ledgerStorageReleased &&
           receipt.ledgerStorageReleasedBufferCount > 0 &&
           receipt.ledgerStorageReleasedBytes > int64(0)

fn parserTerminalReleaseFailureAndRepeat(): bool =
    var layer: parser.NormalizedExprLayer
    seqs.setLen(layer.exprs, 2)
    seqs.setLen(layer.exprNext, 2)
    seqs.setLen(layer.scopes, 1)
    seqs.setLen(layer.exprLookup.slots, 8)
    seqs.setLen(layer.exprLookup.buckets, 1)
    layer.exprs[0].sourcePath = "stale.cheng"
    var err: str
    if parser.ParserReadNormalizedExprLayerFromText(
            "", "", layer, err) ||
       !parser.NormalizedExprLayerStorageReleased(layer):
        return false

    seqs.setLen(layer.exprs, 1)
    seqs.setLen(layer.exprNext, 1)
    var first: parser.NormalizedExprLayerTerminalReleaseReceipt
    parser.NormalizedExprLayerTerminalReleaseWithReceipt(
        layer, first)
    var second: parser.NormalizedExprLayerTerminalReleaseReceipt
    parser.NormalizedExprLayerTerminalReleaseWithReceipt(
        layer, second)
    return first.releasedBufferCount == 2 &&
           first.releasedBytes > int64(0) &&
           first.storageReleased &&
           second.releasedBufferCount == 0 &&
           second.releasedBytes == int64(0) &&
           second.storageReleased &&
           parser.NormalizedExprLayerStorageReleased(layer)

fn lifecycleRunNegative(mode: str): int32 =
    var arena = arenamod.ArenaInitDefault(4096)
    let _ = arenamod.ArenaAllocBytes(arena, 128)
    let retainedBytes = int64(arena.capacityBytes)
    var state: lifecycle.CompilerPayloadLifecycle
    var receipt: lifecycle.CompilerPayloadLifecycleReceipt
    lifecycle.CompilerPayloadLifecycleBegin(
        state,
        lifecycle.CompilerPayloadKindFocusedTest,
        retainedBytes,
        1)
    var physicalRelease: lifecycle.CompilerPayloadPhysicalReleaseReceipt
    if mode == "missing_prepare":
        arenamod.ArenaRelease(arena)
        physicalRelease.releasedBufferCount = 1
        physicalRelease.releasedBytes = retainedBytes
        physicalRelease.storageReleased = true
        lifecycle.CompilerPayloadLifecycleEnd(
            state,
            lifecycle.CompilerPayloadOutcomeDiagnostic,
            physicalRelease,
            receipt)
    elif mode == "duplicate_prepare":
        lifecycle.CompilerPayloadLifecyclePrepareTerminal(state)
        lifecycle.CompilerPayloadLifecyclePrepareTerminal(state)
    elif mode == "storage_not_released":
        lifecycle.CompilerPayloadLifecyclePrepareTerminal(state)
        physicalRelease.releasedBufferCount = 1
        physicalRelease.releasedBytes = retainedBytes
        physicalRelease.storageReleased = false
        lifecycle.CompilerPayloadLifecycleEnd(
            state,
            lifecycle.CompilerPayloadOutcomeEarlyReturn,
            physicalRelease,
            receipt)
    elif mode == "physical_free_missing":
        lifecycle.CompilerPayloadLifecyclePrepareTerminal(state)
        arenamod.ArenaRelease(arena)
        physicalRelease.releasedBufferCount = 0
        physicalRelease.releasedBytes = int64(0)
        physicalRelease.storageReleased = true
        lifecycle.CompilerPayloadLifecycleEnd(
            state,
            lifecycle.CompilerPayloadOutcomeCancel,
            physicalRelease,
            receipt)
    elif mode == "physical_bytes_mismatch":
        lifecycle.CompilerPayloadLifecyclePrepareTerminal(state)
        arenamod.ArenaRelease(arena)
        physicalRelease.releasedBufferCount = 1
        physicalRelease.releasedBytes = retainedBytes - int64(1)
        physicalRelease.storageReleased = true
        lifecycle.CompilerPayloadLifecycleEnd(
            state,
            lifecycle.CompilerPayloadOutcomeCancel,
            physicalRelease,
            receipt)
    elif mode == "duplicate_end":
        lifecycle.CompilerPayloadLifecyclePrepareTerminal(state)
        arenamod.ArenaRelease(arena)
        physicalRelease.releasedBufferCount = 1
        physicalRelease.releasedBytes = retainedBytes
        physicalRelease.storageReleased = true
        lifecycle.CompilerPayloadLifecycleEnd(
            state,
            lifecycle.CompilerPayloadOutcomeSuccess,
            physicalRelease,
            receipt)
        lifecycle.CompilerPayloadLifecycleEnd(
            state,
            lifecycle.CompilerPayloadOutcomeSuccess,
            physicalRelease,
            receipt)
    elif mode == "invalid_outcome":
        lifecycle.CompilerPayloadLifecyclePrepareTerminal(state)
        arenamod.ArenaRelease(arena)
        physicalRelease.releasedBufferCount = 1
        physicalRelease.releasedBytes = retainedBytes
        physicalRelease.storageReleased = true
        lifecycle.CompilerPayloadLifecycleEnd(
            state, 99, physicalRelease, receipt)
    else:
        return 91
    return 92

fn main(): int32 =
    let negativeMode = os.GetEnv("CHENG_COMPILER_PAYLOAD_NEGATIVE")
    if negativeMode != "":
        return lifecycleRunNegative(negativeMode)

    if !lifecycleRunOnce(lifecycle.CompilerPayloadOutcomeSuccess):
        return 1
    if !lifecycleRunOnce(lifecycle.CompilerPayloadOutcomeDiagnostic):
        return 2
    if !lifecycleRunOnce(lifecycle.CompilerPayloadOutcomeCancel):
        return 3
    if !lifecycleRunOnce(lifecycle.CompilerPayloadOutcomeEarlyReturn):
        return 4
    if !lifecycleRunOnce(lifecycle.CompilerPayloadOutcomeCacheReuse):
        return 5
    if !lifecycleRunProductionHandoff():
        return 6
    if !parserTerminalReleaseFailureAndRepeat():
        return 7

    let allocBefore = system.memAllocCount()
    let freeBefore = system.memFreeCount()
    let liveBefore = system.memLiveCount()
    for iteration in 0..<1000:
        if !lifecycleRunOnce(lifecycle.CompilerPayloadOutcomeSuccess):
            return 10
    let allocDelta = system.memAllocCount() - allocBefore
    let freeDelta = system.memFreeCount() - freeBefore
    if allocDelta <= int64(0) ||
       allocDelta != freeDelta ||
       system.memLiveCount() != liveBefore:
        os.WriteLine(
            os.Get_stderr(),
            Fmt"compiler_payload_lifecycle_unbalanced alloc={allocDelta} free={freeDelta} live_before={liveBefore} live_after={system.memLiveCount()}")
        return 11

    os.WriteLine(
        os.Get_stdout(),
        "compiler_payload_lifecycle ok paths=7 cycles=1000 ledger_live=0 alloc_free_balanced=1 arena_seq_index_released=1 managed_ledger_strings_released=1 primary_handoff_borrow_move_release=1 parser_terminal_release=1")
    return 0
