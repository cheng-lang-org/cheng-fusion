# regalloc out-of-interval 6-arg call fixture (axis-W 阶段1, 判官3 修正案).
# Single-block body (so the no-call gate does NOT apply; the per-slot interval
# test does: a call disqualifies a resident candidate only if the call lies in
# [firstWrite, maxRef]). `early` is written then last-read in `before = early+1`
# BEFORE the 6-arg call, so the call is outside early's live interval -> early
# stays resident-eligible. The 6-arg call uses R9 for arg idx5. Proves R9-as-arg6
# is byte-safe when the call is outside the resident interval (caller-saved R9
# is flushed by the call, but the resident value is already dead there).
# Pure scalar + call + control flow (no assert/echo) for x86_64 emit maturity.

fn sixArgCallee(a1: int32, a2: int32, a3: int32, a4: int32, a5: int32, a6: int32): int32 =
    return a1 + a2 + a3 + a4 + a5 + a6

fn callerBody(): int32 =
    var early: int32
    early = early + 5
    let before: int32 = early + 1
    var r: int32 = sixArgCallee(1, 2, 3, 4, 5, 6)
    return before + r

fn main(): int32 =
    let r = callerBody()
    if r != 27:
        return 1
    return 0
