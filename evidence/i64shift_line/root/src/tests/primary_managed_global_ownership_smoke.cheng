import std/system
import cheng/tests/primary_managed_global_ownership_support as ownershipSupport

type
    ManagedOwner =
        text: str
        numbers: int32[]

var managedGlobalText: str
var managedGlobalNumbers: int32[]

fn ownedText(seed: int32): str =
    return Fmt"managed-global-owned-{seed}"

fn ownedNumbers(seed: int32): int32[] =
    var values: int32[]
    add(values, seed)
    add(values, seed + 1)
    add(values, seed + 2)
    return values

fn emptyText(): str =
    var value: str
    return value

fn emptyNumbers(): int32[] =
    var values: int32[]
    return values

fn textMatches(seed: int32): bool =
    let expected = Fmt"managed-global-owned-{seed}"
    return managedGlobalText == expected

fn numbersMatch(seed: int32): bool =
    return managedGlobalNumbers.len == 3 &&
           managedGlobalNumbers[0] == seed &&
           managedGlobalNumbers[1] == seed + 1 &&
           managedGlobalNumbers[2] == seed + 2

# A direct managed call result is Owned.  The global store must move it and
# mark the local result consumed instead of retaining or bit-copying it.
fn installOwnedCallResults(seed: int32) =
    managedGlobalText = ownedText(seed)
    managedGlobalNumbers = ownedNumbers(seed)

# Same name/arity overloads imported from another module must preserve exact
# CallExpr identity and their distinct Owned result types through both backends.
fn installImportedOverloadedCallResults(seed: int32) =
    let wideSeed: int64 = int64(seed)
    managedGlobalText = ownershipSupport.ManagedValue(seed)
    managedGlobalNumbers = ownershipSupport.ManagedValue(wideSeed)

fn importedTextMatches(seed: int32): bool =
    let expected = Fmt"managed-global-imported-{seed}"
    return managedGlobalText == expected

# A FieldGet is Borrowed.  Both globals must retain/share before the owner is
# overwritten and before this function exits.
fn installBorrowedFields(seed: int32): int32 =
    var owner: ManagedOwner
    owner.text = ownedText(seed)
    owner.numbers = ownedNumbers(seed)

    let retainBeforeShare: int64 = memRetainCount()
    managedGlobalText = owner.text
    managedGlobalNumbers = owner.numbers
    if memRetainCount() <= retainBeforeShare:
        return 1
    if !textMatches(seed) || !numbersMatch(seed):
        return 2

    owner.text = ownedText(seed + 1000)
    owner.numbers = ownedNumbers(seed + 1000)
    if !textMatches(seed) || !numbersMatch(seed):
        return 3
    return 0

fn clearManagedGlobals() =
    managedGlobalText = emptyText()
    managedGlobalNumbers = emptyNumbers()

fn runOwnershipCycle(seed: int32): int32 =
    installOwnedCallResults(seed)
    if !textMatches(seed) || !numbersMatch(seed):
        return 10

    let releaseBeforeBorrowedOverwrite: int64 = memReleaseCount()
    let borrowedRc = installBorrowedFields(seed + 10)
    if borrowedRc != 0:
        return 20 + borrowedRc
    if memReleaseCount() <= releaseBeforeBorrowedOverwrite:
        return 24
    if !textMatches(seed + 10) || !numbersMatch(seed + 10):
        return 25

    # Self-assignment aliases the old global.  Retain must happen before the
    # old value is released, so both values remain valid.
    managedGlobalText = managedGlobalText
    managedGlobalNumbers = managedGlobalNumbers
    if !textMatches(seed + 10) || !numbersMatch(seed + 10):
        return 30

    # A second Owned overwrite must release the shared values and consume the
    # new call results exactly once.
    let releaseBeforeOwnedOverwrite: int64 = memReleaseCount()
    installOwnedCallResults(seed + 20)
    if memReleaseCount() <= releaseBeforeOwnedOverwrite:
        return 31
    if !textMatches(seed + 20) || !numbersMatch(seed + 20):
        return 32

    installImportedOverloadedCallResults(seed + 30)
    if !importedTextMatches(seed + 30) || !numbersMatch(seed + 30):
        return 33

    # Empty managed call results exercise the same move-store path and must
    # release the previous non-empty globals.
    let releaseBeforeClear: int64 = memReleaseCount()
    clearManagedGlobals()
    if memReleaseCount() <= releaseBeforeClear:
        return 40
    if managedGlobalText.len != 0 || managedGlobalNumbers.len != 0:
        return 41
    return 0

fn main(): int32 =
    # Warm once so process-global/runtime one-time allocations cannot make the
    # closed-cycle leak assertion depend on initialization order.
    let warmRc = runOwnershipCycle(100)
    if warmRc != 0:
        return warmRc
    let liveAfterWarm: int64 = memLiveCount()

    let allocBefore: int64 = memAllocCount()
    let freeBefore: int64 = memFreeCount()
    let repeatRc = runOwnershipCycle(200)
    if repeatRc != 0:
        return 50 + repeatRc
    let allocDelta: int64 = memAllocCount() - allocBefore
    let freeDelta: int64 = memFreeCount() - freeBefore
    if allocDelta != freeDelta:
        return 90
    if memLiveCount() != liveAfterWarm:
        return 91
    echo("primary_managed_global_ownership_smoke ok")
    return 0
