import std/rawbytes

type
    NestedSequenceElementOwner =
        bytes: rawbytes.Bytes[]

fn main(): int32 =
    var owner: NestedSequenceElementOwner
    add(owner.bytes, rawbytes.BytesAlloc(4))
    add(owner.bytes, rawbytes.BytesAlloc(8))
    rawbytes.BytesSet(owner.bytes[0], 0, 73)
    if rawbytes.BytesGet(owner.bytes[0], 0) != 73:
        return 1

    rawbytes.BytesFree(owner.bytes[0])
    if rawbytes.BytesLen(owner.bytes[0]) != 0:
        return 2
    if rawbytes.BytesLen(owner.bytes[1]) != 8:
        return 3

    rawbytes.BytesFree(owner.bytes[1])
    if rawbytes.BytesLen(owner.bytes[1]) != 0:
        return 4
    echo("cold_nested_sequence_element_var_identity_smoke ok")
    return 0
