import std/result
import cheng/core/tooling/compiler_world as cworld
import cheng/std/bytes_layout as layout

fn main(): int32 =
    var err: str
    var documentCid: layout.FixedBytes32
    assert(cworld.CompilerWorldDocumentCidInto(
               "pkg", "pkg/main", documentCid, err), err)
    let expected = layout.FixedBytes32FromHex(
        "4b8cb75870a15280d4e095e019859d0640e8ad40f76b751c7dc466e13b9a5401")
    assert(IsOk(expected) &&
           layout.FixedBytes32Equal(documentCid, Value(expected)),
           "compiler document identity: KAT drift")

    var repeated: layout.FixedBytes32
    assert(cworld.CompilerWorldDocumentCidInto(
               "pkg", "pkg/main", repeated, err) &&
           layout.FixedBytes32Equal(documentCid, repeated),
           "compiler document identity: unstable CID")
    var distinct: layout.FixedBytes32
    assert(cworld.CompilerWorldDocumentCidInto(
               "pkg", "pkg/helper", distinct, err) &&
           !layout.FixedBytes32Equal(documentCid, distinct),
           "compiler document identity: module collision")

    var rejected: layout.FixedBytes32
    assert(!cworld.CompilerWorldDocumentCidInto(
                "pkg://pkg", "pkg/main", rejected, err),
           "compiler document identity: URI package accepted")
    assert(!cworld.CompilerWorldDocumentCidInto(
                " pkg ", "pkg/main", rejected, err),
           "compiler document identity: padded package accepted")
    assert(!cworld.CompilerWorldDocumentCidInto(
                "pkg", "foreign/main", rejected, err),
           "compiler document identity: foreign module accepted")
    assert(!cworld.CompilerWorldDocumentCidInto(
                "pkg", "pkg/./main", rejected, err),
           "compiler document identity: dot segment accepted")
    assert(!cworld.CompilerWorldDocumentCidInto(
                "pkg", "pkg//main", rejected, err),
           "compiler document identity: empty segment accepted")
    assert(cworld.CompilerWorldDocumentCidInto(
               "cheng", "std/io", rejected, err) &&
           cworld.CompilerWorldDocumentCidInto(
               "cheng", "runtime/orc", rejected, err),
           "compiler document identity: builtin ownership rejected")
    echo("compiler_world_document_identity_smoke: ok")
    return 0
