import std/strutils as strutil
import std/result
import std/net/transports/tcp_syscall as tcp
import cheng/apps/vpn_proxy/vpn_proxy_listen as listen

fn checkListen(label: str, host: str, port: int32) =
    let res: Result[tcp.TcpListenerHandle] = tcp.TcpListen4(host, port)
    if IsErr(res):
        puts(strutil.Join([label, " err=", ErrorText(res)], ""))
        return
    var listener: tcp.TcpListenerHandle = Value(res)
    puts(strutil.Join([label, " ok fd=", IntToStr(listener.fd)], ""))
    tcp.TcpListenerClose(listener)

fn main(): int32 =
    checkListen("listen_literal", "127.0.0.1", 18099)
    let parsedRes: Result[listen.VpnProxyListenAddress] = listen.VpnProxyParseListenAddress("127.0.0.1:18100")
    if IsErr(parsedRes):
        puts(strutil.Join(["parse_err ", ErrorText(parsedRes)], ""))
        return 1
    let parsed: listen.VpnProxyListenAddress = Value(parsedRes)
    puts(strutil.Join(["parsed_host=[", parsed.host, "] port=", IntToStr(parsed.port), "]"], ""))
    checkListen("listen_parsed", parsed.host, parsed.port)
    return 0
