type
    Holder =
        items: int32[]

fn writeAtReturn(items: var int32[], offset: int32, value: int32): int32 =
    items[offset] = value
    return offset + 1

fn writeVia(items: var int32[]): int32 =
    let next = writeAtReturn(items, 1, 42)
    return next

fn main(): int32 =
    var holder: Holder
    add(holder.items, 0)
    add(holder.items, 0)
    let next = writeVia(holder.items)
    if next != 2:
        return 2
    if holder.items[1] != 42:
        return 1
    return 0
