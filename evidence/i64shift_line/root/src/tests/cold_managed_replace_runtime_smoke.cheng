import std/system as system

type
    ManagedReplaceRuntimeRef = ref object
        marker: int32

fn ClearManagedRef(target: var ManagedReplaceRuntimeRef) =
    target = nil

fn ReplaceManagedRef(
    target: var ManagedReplaceRuntimeRef,
    marker: int32
) =
    var next = new(ManagedReplaceRuntimeRef)
    next.marker = marker
    target = next

fn SelfAssignManagedRef(target: var ManagedReplaceRuntimeRef) =
    target = target

fn main(): int32 =
    let allocBefore = system.memAllocCount()
    let freeBefore = system.memFreeCount()
    let liveBefore = system.memLiveCount()
    system.memDiagReset()

    var value = new(ManagedReplaceRuntimeRef)
    value.marker = 11
    if system.memAllocCount() - allocBefore != 1:
        return 1
    if system.memFreeCount() != freeBefore:
        return 2
    if system.memLiveCount() - liveBefore != 1:
        return 3
    if system.memRefCount(value) != 1:
        return 4

    SelfAssignManagedRef(value)
    if value == nil || value.marker != 11:
        return 5
    if system.memRetainCount() != 0 ||
       system.memReleaseCount() != 0 ||
       system.memFreeCount() != freeBefore ||
       system.memRefCount(value) != 1:
        return 6

    ReplaceManagedRef(value, 22)
    if value == nil || value.marker != 22:
        return 7
    if system.memAllocCount() - allocBefore != 2 ||
       system.memFreeCount() - freeBefore != 1 ||
       system.memLiveCount() - liveBefore != 1 ||
       system.memRetainCount() != 0 ||
       system.memReleaseCount() != 1 ||
       system.memRefCount(value) != 1:
        return 8

    ReplaceManagedRef(value, 33)
    if value == nil || value.marker != 33:
        return 9
    if system.memAllocCount() - allocBefore != 3 ||
       system.memFreeCount() - freeBefore != 2 ||
       system.memLiveCount() - liveBefore != 1 ||
       system.memRetainCount() != 0 ||
       system.memReleaseCount() != 2 ||
       system.memRefCount(value) != 1:
        return 10

    ClearManagedRef(value)
    if value != nil:
        return 11
    if system.memAllocCount() - allocBefore != 3 ||
       system.memFreeCount() - freeBefore != 3 ||
       system.memLiveCount() != liveBefore ||
       system.memRetainCount() != 0 ||
       system.memReleaseCount() != 3:
        return 12

    ClearManagedRef(value)
    if value != nil ||
       system.memFreeCount() - freeBefore != 3 ||
       system.memLiveCount() != liveBefore ||
       system.memRetainCount() != 0 ||
       system.memReleaseCount() != 3:
        return 13
    return 0
