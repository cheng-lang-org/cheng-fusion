import cheng/core/tooling/artifact_paths as artifactpaths

fn main(): int32 =
    let stage3 = artifactpaths.ArtifactStage3Path("/tmp/cheng-root")
    assert(stage3 ==
               "/tmp/cheng-root/artifacts/bootstrap/cheng.stage3",
           "bootstrap stage3 artifact path: canonical path mismatch")
    echo("bootstrap_stage3_artifact_path_smoke ok")
    return 0
