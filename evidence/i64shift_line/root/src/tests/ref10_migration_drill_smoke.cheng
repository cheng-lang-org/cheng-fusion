# ref10 migration drill: the full step-2/3 lifecycle on one stage.
#   epoch0 world -> governed floor raise to 1 -> old identities refused,
#   re-keyed epoch1 identities admitted -> mixed certificate reaches
#   quorum only through post-line votes; a stale-only vote cannot.

import std/os
import std/system
import std/rawbytes
import cheng/std/bytes_layout as layout
import cheng/libp2p/crypto/ed25519/ed25519 as ed
import cheng/apps/rwad/rwad_gov_epoch as gov
import cheng/chain/finality_certificate_epoch as fce

fn HexCharVal(c: str): int32 =
    if c == "0":
        return 0
    if c == "1":
        return 1
    if c == "2":
        return 2
    if c == "3":
        return 3
    if c == "4":
        return 4
    if c == "5":
        return 5
    if c == "6":
        return 6
    if c == "7":
        return 7
    if c == "8":
        return 8
    if c == "9":
        return 9
    if c == "a" or c == "A":
        return 10
    if c == "b" or c == "B":
        return 11
    if c == "c" or c == "C":
        return 12
    if c == "d" or c == "D":
        return 13
    if c == "e" or c == "E":
        return 14
    if c == "f" or c == "F":
        return 15
    return 0

fn HexToBytes(h: str): Bytes =
    let n: int32 = h.len / 2
    var out = BytesAlloc(n)
    var i: int32
    while i < n:
        let hi: int32 = HexCharVal(osSliceStr(h, i * 2, i * 2))
        let lo: int32 = HexCharVal(osSliceStr(h, i * 2 + 1, i * 2 + 1))
        BytesSet(out, i, hi * 16 + lo)
        i = i + 1
    return out

fn Tag(b: int32): layout.FixedBytes32 =
    var raw = BytesAlloc(32)
    BytesSet(raw, 0, b)
    let res = layout.FixedBytes32FromBytes(raw)
    return res.value

fn main(): int32 =
    var rc: int32 = 0
    var book: gov.GovEpochBook
    let gi = gov.GovInit(book, 0)
    if !gi.ok:
        return 1

    let seed1 = HexToBytes("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
    let seed2 = HexToBytes("4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb")
    let seed3 = HexToBytes("c5aa8df43f9f837bedb7442f31dcb7b166d38535076f094b85ce3a2e0b4458f7")
    let seed4 = HexToBytes("3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c")
    let kpA = ed.keyPairFromSeedEpoch(seed1, 0)
    let kpB = ed.keyPairFromSeedEpoch(seed2, 0)
    let kpC = ed.keyPairFromSeedEpoch(seed3, 0)
    let kpD = ed.keyPairFromSeedEpoch(seed4, 0)
    if !kpA.ok or !kpB.ok or !kpC.ok or !kpD.ok:
        return 1
    let cidA = Tag(60)
    let cidB = Tag(61)
    let cidC = Tag(62)
    let cidD = Tag(63)
    let aA = gov.GovAcceptIdentity(book, 0)
    if !aA.ok:
        return 1

    # pre-line epoch0 world: all four vote, quorum reached (f=1 -> 3)
    # signing message IS the payload-hash bytes (quorum check derives it)
    var msg = layout.FixedBytes32ToBytes(Tag(90))
    
    var cert0: fce.EpochCert
    cert0.height = Int64(100)
    cert0.payloadHash = Tag(90)
    let sA0 = ed.signEd25519RawEpoch(kpA.value.privateKey.data, msg, 0)
    let sB0 = ed.signEd25519RawEpoch(kpB.value.privateKey.data, msg, 0)
    let sC0 = ed.signEd25519RawEpoch(kpC.value.privateKey.data, msg, 0)
    let sD0 = ed.signEd25519RawEpoch(kpD.value.privateKey.data, msg, 0)
    if !sA0.ok or !sB0.ok or !sC0.ok or !sD0.ok:
        return 1
    let eA = fce.FcertAddEntry(cert0, cidA, kpA.value.publicKey.data, msg, sA0.value, 0)
    if !eA.ok:
        os.WriteLine(os.Get_stderr(), "drill: add A failed")
        rc = rc + 1
    let eB = fce.FcertAddEntry(cert0, cidB, kpB.value.publicKey.data, msg, sB0.value, 0)
    if !eB.ok:
        rc = rc + 1
    let eC = fce.FcertAddEntry(cert0, cidC, kpC.value.publicKey.data, msg, sC0.value, 0)
    if !eC.ok:
        rc = rc + 1
    let eD = fce.FcertAddEntry(cert0, cidD, kpD.value.publicKey.data, msg, sD0.value, 0)
    if !eD.ok:
        rc = rc + 1
    var pubs: Bytes[]
    add(pubs, kpA.value.publicKey.data)
    add(pubs, kpB.value.publicKey.data)
    add(pubs, kpC.value.publicKey.data)
    add(pubs, kpD.value.publicKey.data)
    let q0 = fce.FcertQuorumCheck(cert0, pubs, 1, 0)
    if !q0.ok:
        os.WriteLine(os.Get_stderr(), "drill: pre-line quorum failed")
        rc = rc + 1

    let up = gov.GovSetMinEpoch(book, 1, Int64(1712345678901))
    if !up.ok:
        return 1
    let forced = gov.GovIsForced(book)
    if !forced:
        os.WriteLine(os.Get_stderr(), "floor raised but not forced")
        rc = rc + 1
    let oldId = gov.GovAcceptIdentity(book, 0)
    if oldId.ok:
        os.WriteLine(os.Get_stderr(), "epoch0 identity accepted past line")
        rc = rc + 1
    let newId = gov.GovAcceptIdentity(book, 1)
    if !newId.ok:
        os.WriteLine(os.Get_stderr(), "epoch1 identity refused past line")
        rc = rc + 1

    # re-key three members to epoch1 (dual-registration window)
    let kpA1 = ed.keyPairFromSeedEpoch(seed1, 1)
    let kpB1 = ed.keyPairFromSeedEpoch(seed2, 1)
    let kpC1 = ed.keyPairFromSeedEpoch(seed3, 1)
    if !kpA1.ok or !kpB1.ok or !kpC1.ok:
        return 1

    var msg91 = layout.FixedBytes32ToBytes(Tag(91))
    # post-line certificate: three epoch1 votes clear quorum under
    # minEpoch=1; D still votes with its stale epoch0 key and must not count.
    var cert1: fce.EpochCert
    cert1.height = Int64(101)
    cert1.payloadHash = Tag(91)
    let sA1 = ed.signEd25519RawEpoch(kpA1.value.privateKey.data, msg91, 1)
    let sB1 = ed.signEd25519RawEpoch(kpB1.value.privateKey.data, msg91, 1)
    let sC1 = ed.signEd25519RawEpoch(kpC1.value.privateKey.data, msg91, 1)
    if !sA1.ok or !sB1.ok or !sC1.ok:
        return 1
    let nA = fce.FcertAddEntry(cert1, cidA, kpA1.value.publicKey.data, msg91, sA1.value, 1)
    if !nA.ok:
        rc = rc + 1
    let nB = fce.FcertAddEntry(cert1, cidB, kpB1.value.publicKey.data, msg91, sB1.value, 1)
    if !nB.ok:
        rc = rc + 1
    let nC = fce.FcertAddEntry(cert1, cidC, kpC1.value.publicKey.data, msg91, sC1.value, 1)
    if !nC.ok:
        rc = rc + 1
    let nD = fce.FcertAddEntry(cert1, cidD, kpD.value.publicKey.data, msg, sD0.value, 0)
    if !nD.ok:
        rc = rc + 1
    # after re-keying the committee roster carries the NEW epoch1 keys for
    # A/B/C; D never rotated so its old key stays on the roster.
    var pubs1: Bytes[]
    add(pubs1, kpA1.value.publicKey.data)
    add(pubs1, kpB1.value.publicKey.data)
    add(pubs1, kpC1.value.publicKey.data)
    add(pubs1, kpD.value.publicKey.data)
    let q1 = fce.FcertQuorumCheck(cert1, pubs1, 1, 1)
    if !q1.ok:
        os.WriteLine(os.Get_stderr(), "post-line mixed quorum failed (3x e1 valid)")
        rc = rc + 1

    # a certificate carried by the single stale epoch0 vote alone cannot pass
    var cert2: fce.EpochCert
    cert2.height = Int64(102)
    cert2.payloadHash = Tag(92)
    let oD = fce.FcertAddEntry(cert2, cidD, kpD.value.publicKey.data, msg, sD0.value, 0)
    if !oD.ok:
        rc = rc + 1
    let q2 = fce.FcertQuorumCheck(cert2, pubs, 1, 1)
    if q2.ok:
        os.WriteLine(os.Get_stderr(), "stale-only certificate passed the line")
        rc = rc + 1

    if rc == 0:
        echo("ref10_migration_drill_smoke ok")
    return rc
