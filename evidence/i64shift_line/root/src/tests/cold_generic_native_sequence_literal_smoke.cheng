import std/system

fn coldGenericNativeSequenceLiteral[T](first: T, second: T): T[] =
    return [first, second]

fn coldGenericNativeSequenceAdd[T](first: T, second: T, third: T): T[] =
    var values: T[] = [first, second]
    add(values, third)
    return values

fn coldGenericNativeSequenceStore[T](first: T, replacement: T): T[] =
    var values: T[] = [first]
    values[0] = replacement
    return values

fn main(): int32 =
    let ints: int32[] = coldGenericNativeSequenceLiteral[int32](7, 11)
    if ints.len != 2 || ints[0] != 7 || ints[1] != 11:
        return 1
    let texts: str[] = coldGenericNativeSequenceLiteral[str]("native", "sequence")
    if texts.len != 2 || texts[0] != "native" || texts[1] != "sequence":
        return 2
    let extendedInts: int32[] = coldGenericNativeSequenceAdd[int32](3, 5, 8)
    if extendedInts.len != 3 || extendedInts[2] != 8:
        return 3
    let extendedTexts: str[] = coldGenericNativeSequenceAdd[str]("a", "b", "c")
    if extendedTexts.len != 3 || extendedTexts[2] != "c":
        return 4
    let storedInts: int32[] = coldGenericNativeSequenceStore[int32](13, 21)
    if storedInts.len != 1 || storedInts[0] != 21:
        return 5
    let storedTexts: str[] = coldGenericNativeSequenceStore[str]("old", "new")
    if storedTexts.len != 1 || storedTexts[0] != "new":
        return 6
    return 0

main()
