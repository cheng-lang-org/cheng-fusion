import std/cmdline

fn writeEmpty(out: var str) =
    out = ""

fn main(argc: int32, argv: ptr): int32 =
    cmdline.CaptureCmdLine(argc, argv)

    var value: str
    writeEmpty(value)
    assert(value.len == 0 && StrDataPtr(value) == nil,
           "empty string did not materialize as the canonical zero record")

    value = cmdline.ParamStr(0)
    assert(value.len > 0,
           "real argv ingress did not produce an owned string")
    writeEmpty(value)
    assert(value.len == 0 && StrDataPtr(value) == nil,
           "owned-to-empty replacement did not release and canonicalize")

    writeEmpty(value)
    var second: str
    second = value
    assert(second.len == 0 && StrDataPtr(second) == nil,
           "canonical empty string was not reusable")
    echo("COLD_EMPTY_STRING_MANAGED_STORE_OK")
    return 0
