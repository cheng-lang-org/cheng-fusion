import cheng/core/lang/parser as parser

const FixturePath: str = "/tmp/parser_structured_exact_slice/main.cheng"

fn FixtureText(): str =
    return "fn First(value: int32): int32 =\n    var result: int32 = value\n    if result > 0:\n        defer:\n            result = result + 1\n        return result\n    return result\n\nfn Second(limit: int32): int32 =\n    var total: int32\n    while total < limit:\n        total = total + 1\n    return total\n"

fn ExactRawSlice(full: var parser.NormalizedExprLayer,
                 lineStart: int32,
                 lineEnd: int32): parser.NormalizedExprLayer =
    var out: parser.NormalizedExprLayer
    out.sourceCount = 1
    out.valueExprTree = parser.ParserValueExprTreeBorrow(full.valueExprTree)
    out.valueExprTreeBorrowLease = true
    for exprIndex in 0..<full.exprs.len:
        if full.exprs[exprIndex].lineNumber >= lineStart &&
           full.exprs[exprIndex].lineNumber <= lineEnd:
            var cloned = parser.NormalizedExprClone(full.exprs[exprIndex])
            parser.NormalizedExprLayerAppendExisting(out, cloned)
    return out

fn main() =
    var err: str
    var full: parser.NormalizedExprLayer
    assert(parser.ParserReadNormalizedExprLayerFromText(
               FixturePath, FixtureText(), full, err),
           Fmt"parser structured exact slice: full parse {err}")
    var facts: parser.ParserStructuredSourceFacts
    assert(parser.ParserStructuredSourceFactsBuildFromLayer(
               full, 13, facts, err),
           Fmt"parser structured exact slice: exact facts {err}")
    var firstSlice: parser.ParserStructuredSourceSlice
    assert(parser.ParserStructuredSourceFactsSliceBuildFromLayer(
               facts, full, 1, 7, firstSlice, err),
           Fmt"parser structured exact slice: first slice {err}")
    for sourceStatementOrdinal in 0..<facts.seeds.len:
        assert(facts.seeds[sourceStatementOrdinal].statementOrdinal ==
                   sourceStatementOrdinal,
               "parser structured exact slice: source statement identity mutated")
    var firstLayer = ExactRawSlice(full, 1, 7)
    assert(firstLayer.scopes.len == 0 &&
           parser.ParserStructuredSourceSliceRemapExistingLayer(
               firstSlice, firstLayer, err),
           Fmt"parser structured exact slice: first remap {err}")
    var firstStructuredCount: int32
    for exprIndex in 0..<firstLayer.exprs.len:
        let expr = firstLayer.exprs[exprIndex]
        assert(expr.lexicalScopeId >= 0 &&
               expr.lexicalScopeId < firstLayer.scopes.len,
               "parser structured exact slice: first scope range")
        if parser.ParserNormalizedExprKindIsSidecarStructured(expr.kind):
            assert(expr.statementOrdinal == firstStructuredCount,
                   "parser structured exact slice: first statement order")
            firstStructuredCount = firstStructuredCount + 1
    assert(firstStructuredCount == firstSlice.sourceStatementOrdinals.len &&
           firstLayer.scopes.len == firstSlice.sourceScopeIds.len,
           "parser structured exact slice: first coverage")
    var secondSlice: parser.ParserStructuredSourceSlice
    assert(parser.ParserStructuredSourceFactsSliceBuildFromLayer(
               facts, full, 9, 13, secondSlice, err),
           Fmt"parser structured exact slice: second slice {err}")
    var secondLayer = ExactRawSlice(full, 9, 13)
    assert(parser.ParserStructuredSourceSliceRemapExistingLayer(
               secondSlice, secondLayer, err),
           Fmt"parser structured exact slice: second remap {err}")
    assert(firstSlice.sourceScopeIds.len > 1 &&
           secondSlice.sourceScopeIds.len > 1 &&
           firstSlice.sourceScopeIds[0] == 0 &&
           secondSlice.sourceScopeIds[0] == 0 &&
           firstSlice.sourceScopeIds[1] != secondSlice.sourceScopeIds[1],
           "parser structured exact slice: function scope identity collapsed")
    var duplicateLayer = ExactRawSlice(full, 1, 7)
    assert(!parser.ParserStructuredSourceSliceAppendToLayer(
               firstSlice, duplicateLayer, err),
           "parser structured exact slice: duplicate structured append survived")
    parser.NormalizedExprLayerReset(duplicateLayer)
    parser.NormalizedExprLayerReset(firstLayer)
    parser.NormalizedExprLayerReset(secondLayer)
    parser.ParserStructuredSourceSliceReset(firstSlice)
    parser.ParserStructuredSourceSliceReset(secondSlice)
    parser.ParserStructuredSourceFactsReset(facts)
    parser.NormalizedExprLayerReset(full)
    echo("parser_structured_exact_slice_single_authority=1")
    echo("parser_structured_exact_slice_smoke: ok")
