import cheng/core/backend/regalloc_single_pass as alloc

fn makeMove(sourceLocation: int32,
            sourceReg: int32,
            sourceStackSlot: int32,
            targetLocation: int32,
            targetReg: int32,
            targetStackSlot: int32,
            ordinal: int32,
            requiresEdgeSplit: bool): alloc.RegallocValueAction =
    var action: alloc.RegallocValueAction
    action.consumerOrdinal = ordinal
    action.kind = alloc.RegallocValueActionEdgeParallelCopy
    action.placement = alloc.RegallocValuePlacementEdge
    action.position = 7
    action.blockIndex = 1
    action.opIndex = -1
    action.termIndex = -1
    action.factIndex = -1
    action.valueId = ordinal * 2
    action.otherValueId = ordinal * 2 + 1
    action.sourceLocation = sourceLocation
    action.targetLocation = targetLocation
    action.sourceReg = sourceReg
    action.targetReg = targetReg
    action.sourceStackSlot = sourceStackSlot
    action.targetStackSlot = targetStackSlot
    action.scratchReg = -1
    action.targetMemoryHome =
        targetLocation == alloc.RegallocValueLocationStack
    action.sourceBlock = 1
    action.targetBlock = 2
    action.edgeIndex = 3
    action.requiresEdgeSplit = requiresEdgeSplit
    action.parallelGroup = 7
    action.parallelOrdinal = ordinal
    action.relatedActionOrdinal = -1
    action.fixedOrdinal = -1
    action.passKind = -1
    action.callOrdinal = -1
    action.outgoingStackArgIndex = -1
    action.outgoingStackByteOffset = -1
    action.semanticStart = -1
    action.semanticEnd = -1
    action.semanticRegister = -1
    action.encodedValue = ordinal
    return action

fn makeRegisterMove(sourceReg: int32,
                    targetReg: int32,
                    ordinal: int32,
                    requiresEdgeSplit: bool): alloc.RegallocValueAction =
    return makeMove(
        alloc.RegallocValueLocationRegister, sourceReg, -1,
        alloc.RegallocValueLocationRegister, targetReg, -1,
        ordinal, requiresEdgeSplit)

fn makeRegisterState(): int32[] =
    var out: int32[]
    for reg in 0..<31:
        add(out, 1000 + reg)
    return out

fn makeStackState(count: int32): int32[] =
    var out: int32[]
    for slot in 0..<count:
        add(out, 2000 + slot)
    return out

fn readSource(registers: var int32[],
              stacks: var int32[],
              action: alloc.RegallocValueAction): int32 =
    if action.sourceLocation == alloc.RegallocValueLocationRegister:
        return registers[action.sourceReg]
    return stacks[action.sourceStackSlot]

fn writeTarget(registers: var int32[],
               stacks: var int32[],
               action: alloc.RegallocValueAction,
               value: int32) =
    if action.targetLocation == alloc.RegallocValueLocationRegister:
        registers[action.targetReg] = value
    else:
        stacks[action.targetStackSlot] = value

fn sameObservableState(leftRegisters: var int32[],
                       rightRegisters: var int32[],
                       leftStacks: var int32[],
                       rightStacks: var int32[]): bool =
    if leftRegisters.len != rightRegisters.len ||
       leftStacks.len != rightStacks.len:
        return false
    for reg in 0..<leftRegisters.len:
        if reg != 16 && leftRegisters[reg] != rightRegisters[reg]:
            return false
    for slot in 0..<leftStacks.len:
        if leftStacks[slot] != rightStacks[slot]:
            return false
    return true

fn expandedSequenceValid(raw: var alloc.RegallocValueAction[],
                         expanded: var alloc.RegallocValueAction[],
                         stackSlotCount: int32): bool =
    var initialRegisters = makeRegisterState()
    var expectedRegisters = makeRegisterState()
    var actualRegisters = makeRegisterState()
    var initialStacks = makeStackState(stackSlotCount)
    var expectedStacks = makeStackState(stackSlotCount)
    var actualStacks = makeStackState(stackSlotCount)
    for rawIndex in 0..<raw.len:
        let value = readSource(initialRegisters, initialStacks, raw[rawIndex])
        writeTarget(expectedRegisters, expectedStacks, raw[rawIndex], value)
    var scratchLive = false
    var scratchSaveOrdinal: int32 = -1
    for actionIndex in 0..<expanded.len:
        let action = expanded[actionIndex]
        if action.consumerOrdinal != actionIndex ||
           action.parallelOrdinal != actionIndex ||
           action.parallelGroup != 7 ||
           action.placement != alloc.RegallocValuePlacementEdge ||
           action.position != 7 ||
           action.sourceBlock != 1 || action.targetBlock != 2 ||
           action.edgeIndex != 3 || raw.len <= 0 ||
           action.requiresEdgeSplit != raw[0].requiresEdgeSplit:
            return false
        if action.kind == alloc.RegallocValueActionParallelScratchSave:
            if scratchLive || action.scratchReg != 16 ||
               action.targetLocation !=
                   alloc.RegallocValueLocationRegister ||
               action.targetReg != 16 ||
               action.relatedActionOrdinal >= 0:
                return false
            scratchLive = true
            scratchSaveOrdinal = actionIndex
        elif action.kind ==
             alloc.RegallocValueActionParallelScratchRestore:
            if !scratchLive || action.scratchReg != 16 ||
               action.sourceLocation !=
                   alloc.RegallocValueLocationRegister ||
               action.sourceReg != 16 ||
               action.relatedActionOrdinal != scratchSaveOrdinal:
                return false
            scratchLive = false
            scratchSaveOrdinal = -1
        elif action.kind == alloc.RegallocValueActionEdgeParallelCopy:
            if action.scratchReg >= 0 ||
               action.relatedActionOrdinal >= 0 ||
               (action.sourceLocation ==
                    alloc.RegallocValueLocationRegister &&
                action.sourceReg == 16) ||
               (action.targetLocation ==
                    alloc.RegallocValueLocationRegister &&
                action.targetReg == 16):
                return false
        else:
            return false
        let value = readSource(actualRegisters, actualStacks, action)
        writeTarget(actualRegisters, actualStacks, action, value)
    if scratchLive:
        return false
    return sameObservableState(
        expectedRegisters, actualRegisters,
        expectedStacks, actualStacks)

fn rawSequentialIsWrong(raw: var alloc.RegallocValueAction[],
                        stackSlotCount: int32): bool =
    var initialRegisters = makeRegisterState()
    var expectedRegisters = makeRegisterState()
    var sequentialRegisters = makeRegisterState()
    var initialStacks = makeStackState(stackSlotCount)
    var expectedStacks = makeStackState(stackSlotCount)
    var sequentialStacks = makeStackState(stackSlotCount)
    for actionIndex in 0..<raw.len:
        let expectedValue = readSource(
            initialRegisters, initialStacks, raw[actionIndex])
        writeTarget(
            expectedRegisters, expectedStacks,
            raw[actionIndex], expectedValue)
        let sequentialValue = readSource(
            sequentialRegisters, sequentialStacks, raw[actionIndex])
        writeTarget(
            sequentialRegisters, sequentialStacks,
            raw[actionIndex], sequentialValue)
    return !sameObservableState(
        expectedRegisters, sequentialRegisters,
        expectedStacks, sequentialStacks)

fn testTwoCycle(): int32 =
    var raw: alloc.RegallocValueAction[]
    add(raw, makeRegisterMove(9, 10, 0, true))
    add(raw, makeRegisterMove(10, 9, 1, true))
    var constraints = alloc.RegallocTargetConstraintsA64Darwin()
    if constraints.parallelCopyScratchReg != 16:
        return 10
    var first = alloc.RegallocParallelCopyExpand(constraints, raw, 0)
    var second = alloc.RegallocParallelCopyExpand(constraints, raw, 0)
    if !first.valid || first.actions.len != 3 ||
       !alloc.RegallocParallelCopyExpansionEquivalent(first, second) ||
       !rawSequentialIsWrong(raw, 0) ||
       !expandedSequenceValid(raw, first.actions, 0):
        return 11
    if first.actions[0].kind !=
           alloc.RegallocValueActionParallelScratchSave ||
       first.actions[0].sourceReg != 9 ||
       first.actions[1].kind !=
           alloc.RegallocValueActionEdgeParallelCopy ||
       first.actions[1].sourceReg != 10 ||
       first.actions[1].targetReg != 9 ||
       first.actions[2].kind !=
           alloc.RegallocValueActionParallelScratchRestore ||
       first.actions[2].sourceReg != 16 ||
       first.actions[2].targetReg != 10 ||
       first.actions[2].relatedActionOrdinal != 0:
        return 12
    for actionIndex in 0..<first.actions.len:
        if !first.actions[actionIndex].requiresEdgeSplit:
            return 13
    return 0

fn testThreeCycle(): int32 =
    var raw: alloc.RegallocValueAction[]
    add(raw, makeRegisterMove(9, 10, 0, false))
    add(raw, makeRegisterMove(10, 11, 1, false))
    add(raw, makeRegisterMove(11, 9, 2, false))
    var constraints = alloc.RegallocTargetConstraintsA64Darwin()
    var expanded = alloc.RegallocParallelCopyExpand(constraints, raw, 0)
    if !expanded.valid || expanded.actions.len != 4 ||
       !rawSequentialIsWrong(raw, 0) ||
       !expandedSequenceValid(raw, expanded.actions, 0):
        return 21
    if expanded.actions[0].kind !=
           alloc.RegallocValueActionParallelScratchSave ||
       expanded.actions[1].sourceReg != 11 ||
       expanded.actions[1].targetReg != 9 ||
       expanded.actions[2].sourceReg != 10 ||
       expanded.actions[2].targetReg != 11 ||
       expanded.actions[3].kind !=
           alloc.RegallocValueActionParallelScratchRestore ||
       expanded.actions[3].targetReg != 10:
        return 22
    return 0

fn testAcyclicChain(): int32 =
    var raw: alloc.RegallocValueAction[]
    add(raw, makeRegisterMove(9, 10, 0, false))
    add(raw, makeRegisterMove(10, 11, 1, false))
    var constraints = alloc.RegallocTargetConstraintsA64Darwin()
    var expanded = alloc.RegallocParallelCopyExpand(constraints, raw, 0)
    if !expanded.valid || expanded.actions.len != 2 ||
       !expandedSequenceValid(raw, expanded.actions, 0):
        return 31
    if expanded.actions[0].kind !=
           alloc.RegallocValueActionEdgeParallelCopy ||
       expanded.actions[0].sourceReg != 10 ||
       expanded.actions[0].targetReg != 11 ||
       expanded.actions[1].sourceReg != 9 ||
       expanded.actions[1].targetReg != 10:
        return 32
    return 0

fn testStackRegisterCycleAndNoOp(): int32 =
    var raw: alloc.RegallocValueAction[]
    add(raw, makeMove(
        alloc.RegallocValueLocationStack, -1, 0,
        alloc.RegallocValueLocationRegister, 9, -1,
        0, false))
    add(raw, makeMove(
        alloc.RegallocValueLocationRegister, 9, -1,
        alloc.RegallocValueLocationStack, -1, 0,
        1, false))
    var constraints = alloc.RegallocTargetConstraintsA64Darwin()
    var expanded = alloc.RegallocParallelCopyExpand(constraints, raw, 1)
    if !expanded.valid || expanded.actions.len != 3 ||
       !rawSequentialIsWrong(raw, 1) ||
       !expandedSequenceValid(raw, expanded.actions, 1):
        return 41
    if expanded.actions[0].kind !=
           alloc.RegallocValueActionParallelScratchSave ||
       expanded.actions[0].sourceStackSlot != 0 ||
       expanded.actions[1].sourceReg != 9 ||
       expanded.actions[1].targetStackSlot != 0 ||
       expanded.actions[2].kind !=
           alloc.RegallocValueActionParallelScratchRestore ||
       expanded.actions[2].targetReg != 9:
        return 42
    var noOp: alloc.RegallocValueAction[]
    add(noOp, makeMove(
        alloc.RegallocValueLocationStack, -1, 0,
        alloc.RegallocValueLocationStack, -1, 0,
        0, false))
    var noOpExpansion = alloc.RegallocParallelCopyExpand(
        constraints, noOp, 1)
    if !noOpExpansion.valid || noOpExpansion.actions.len != 0:
        return 43
    return 0

fn testInvalidShapesAndScratch(): int32 =
    var differentStacks: alloc.RegallocValueAction[]
    add(differentStacks, makeMove(
        alloc.RegallocValueLocationStack, -1, 0,
        alloc.RegallocValueLocationStack, -1, 1,
        0, false))
    var constraints = alloc.RegallocTargetConstraintsA64Darwin()
    var stackFailure = alloc.RegallocParallelCopyExpand(
        constraints, differentStacks, 2)
    if stackFailure.valid ||
       stackFailure.errorCode != alloc.RegallocValuePlanErrorParallelCopy:
        return 51
    var cycle: alloc.RegallocValueAction[]
    add(cycle, makeRegisterMove(9, 10, 0, false))
    add(cycle, makeRegisterMove(10, 9, 1, false))
    var missingReserved = alloc.RegallocTargetConstraintsA64Darwin()
    var filteredReserved: int32[]
    for i in 0..<missingReserved.reservedRegs.len:
        if missingReserved.reservedRegs[i] != 16:
            add(filteredReserved, missingReserved.reservedRegs[i])
    missingReserved.reservedRegs = filteredReserved
    var reservedFailure = alloc.RegallocParallelCopyExpand(
        missingReserved, cycle, 0)
    if reservedFailure.valid ||
       reservedFailure.errorCode !=
           alloc.RegallocValuePlanErrorConstraintOverlap:
        return 52
    var fixedScratch = alloc.RegallocTargetConstraintsA64Darwin()
    fixedScratch.fixedResultReg = 16
    var fixedFailure = alloc.RegallocParallelCopyExpand(
        fixedScratch, cycle, 0)
    if fixedFailure.valid ||
       fixedFailure.errorCode != alloc.RegallocValuePlanErrorFixedConflict:
        return 53
    var wrongScratch = alloc.RegallocTargetConstraintsA64Darwin()
    wrongScratch.parallelCopyScratchReg = 17
    var wrongFailure = alloc.RegallocParallelCopyExpand(
        wrongScratch, cycle, 0)
    if wrongFailure.valid ||
       wrongFailure.errorCode != alloc.RegallocValuePlanErrorConstraintShape:
        return 54
    return 0

fn main(): int32 =
    let twoCycle = testTwoCycle()
    if twoCycle != 0:
        return twoCycle
    let threeCycle = testThreeCycle()
    if threeCycle != 0:
        return threeCycle
    let chain = testAcyclicChain()
    if chain != 0:
        return chain
    let stackMix = testStackRegisterCycleAndNoOp()
    if stackMix != 0:
        return stackMix
    return testInvalidShapesAndScratch()
