# unimaker pay smoke: a payment intent raised on the UniMaker side flows
# through the adapter into the RWAD kernel, gets ordered, certified, and
# confirmed by a stateless light client - the DoD-1 path end to end.

import std/os
import std/system
import std/rawbytes
import std/crypto/sha512 as sha512
import cheng/std/bytes_layout as layout
import cheng/chain/dag_ordering as dord
import cheng/chain/committee_vote as cvt
import cheng/chain/finality_certificate as fcert
import cheng/apps/rwad/rwad_serial_state_machine as serial
import cheng/apps/unimaker/unimaker_rwad_pay as upay

fn CidTag(b: int32, salt: int32): layout.FixedBytes32 =
    var raw = BytesAlloc(32)
    BytesSet(raw, 0, b)
    BytesSet(raw, 1, salt)
    let res = layout.FixedBytes32FromBytes(raw)
    return res.value

fn Owner(b: int32): layout.FixedBytes32 =
    return CidTag(b, 0)

fn main(): int32 =
    var rc: int32 = 0
    let epoch: int32 = 33
    let round: int32 = 8

    let sk0 = BytesFromHex("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
    let sk1 = BytesFromHex("4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb")
    let sk2 = BytesFromHex("c5aa8df43f9f837bedb7442f31dcb7b166d38535076f094b85ce3a2e0b4458f7")
    let sk3 = BytesFromHex("3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c")

    var v0 = cvt.CommitteeDraw(sk0, 100, 100, epoch, round)
    var v1 = cvt.CommitteeDraw(sk1, 100, 100, epoch, round)
    var v2 = cvt.CommitteeDraw(sk2, 100, 100, epoch, round)
    var v3 = cvt.CommitteeDraw(sk3, 100, 100, epoch, round)
    if !v0.ok or !v1.ok or !v2.ok or !v3.ok:
        return 1
    var members: cvt.CommitteeMember[]
    add(members, v0.value)
    add(members, v1.value)
    add(members, v2.value)
    add(members, v3.value)

    # wallet top-up (bridge/oracle sourced) so the UniMaker wallet holds a
    # live note; the adapter itself never mints.
    var m = serial.RwadStateMachineInit("unimaker-pay")
    let topUp = serial.RwadStateMachineApplyMint(m, Int64(1), serial.RwadMintTxMake(Owner(9), Int64(500)))
    if !topUp.accepted:
        os.WriteLine(os.Get_stderr(), "top-up mint failed")
        return 1

    # UniMaker raises a 120-unit payment intent against its tracked note
    var intent: upay.UnimakerPayIntent
    intent.payerNoteId = topUp.primaryNoteId
    intent.payerCid = Owner(9)
    intent.payeeCid = Owner(10)
    intent.amount = Int64(120)
    let receipt = upay.UnimakerPayApply(m, intent, Int64(2))
    if !receipt.accepted:
        os.WriteLine(os.Get_stderr(), "unimaker payment rejected")
        rc = rc + 1
    if receipt.payerBalanceAfter != 380 or receipt.payeeBalanceAfter != 120:
        os.WriteLine(os.Get_stderr(), "receipt balances wrong")
        rc = rc + 1

    # zero-amount intent rejected at the adapter boundary
    var badIntent: upay.UnimakerPayIntent
    badIntent.payerNoteId = topUp.primaryNoteId
    badIntent.payerCid = Owner(9)
    badIntent.payeeCid = Owner(10)
    badIntent.amount = 0
    let badReceipt = upay.UnimakerPayApply(m, badIntent, Int64(3))
    if badReceipt.accepted:
        os.WriteLine(os.Get_stderr(), "zero payment accepted")
        rc = rc + 1

    # the payment event enters the DAG, gets ordered, and is certified
    var view = dord.DagOrderView()
    let zero = layout.FixedBytes32()
    dord.DagOrderPush(view, CidTag(1, 3), zero, false, zero, false, 1, Int64(1), 0)
    dord.DagOrderPush(view, CidTag(2, 3), CidTag(1, 3), true, zero, false, 1, Int64(2), 0)
    var seq: layout.FixedBytes32[]
    let orc = dord.DagOrderCommitSequence(view, seq)
    if orc != 0 or seq.len != 2:
        os.WriteLine(os.Get_stderr(), "ordering failed")
        rc = rc + 1

    var buf = BytesAlloc(seq.len * 32)
    var i: int32
    while i < seq.len:
        let b = layout.FixedBytes32ToBytes(seq[i])
        var k: int32
        while k < 32:
            BytesSet(buf, i * 32 + k, BytesGet(b, k))
            k = k + 1
        i = i + 1
    let d = sha512.Sha512Digest(buf)
    BytesFree(buf)
    let seqHash = layout.FixedBytes32FromBytes(BytesSlice(d, 0, 32))

    var votes: cvt.SignedVote[]
    var pks: Bytes[]
    i = 0
    while i < members.len:
        let vres = cvt.CommitteeSignVote(members[i], seqHash.value)
        if vres.ok:
            add(votes, vres.value)
            add(pks, members[i].pk)
        i = i + 1
    var vp: Bytes[]
    var vs: Bytes[]
    i = 0
    while i < votes.len:
        add(vp, votes[i].voterPk)
        add(vs, votes[i].sig)
        i = i + 1
    let cert = fcert.FcertCreate(seqHash.value, epoch, round, vp, vs)
    if !cert.ok:
        rc = rc + 1
    else:
        let vf = fcert.FcertVerify(cert.value, pks, 1)
        if !vf.ok:
            os.WriteLine(os.Get_stderr(), "light client confirmation failed")
            rc = rc + 1

    if rc == 0:
        echo("unimaker_pay_smoke ok")
    return rc
