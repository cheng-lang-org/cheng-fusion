type
    ColdExactUniqueBorrowOpenElifBox =
        values: str[]

fn ColdExactUniqueBorrowOpenElifSwap(values: var str[]) =
    let first = values[0]
    values[0] = values[1]
    values[1] = first

fn main(): int32 =
    var box = ColdExactUniqueBorrowOpenElifBox()
    add(box.values, "right")
    add(box.values, "left")
    var values = box.values
    let selector = 1
    if selector == 0:
        return 11
    elif selector == 1:
        ColdExactUniqueBorrowOpenElifSwap(values)
    else:
        return 12
    if box.values.len != 2 ||
       box.values[0] != "left" ||
       box.values[1] != "right":
        return 13
    return 0
