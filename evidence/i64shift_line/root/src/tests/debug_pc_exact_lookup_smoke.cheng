import std/os
import std/rawbytes
import std/strings
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/backend/debug_emission_plan_evidence as planevidence
import cheng/core/backend/debug_emission_receipt as receipt
import cheng/core/backend/debug_relocatable_object_evidence as objectevidence
import cheng/core/backend/debug_facts as debug
import cheng/core/backend/line_map as linemap
import cheng/core/backend/macho_object_writer as macho
import cheng/core/backend/object_buffer as obuf
import cheng/core/backend/object_relocs as orel
import cheng/core/backend/object_symbols as osym
import cheng/core/backend/semantic_snapshot_debug_binding_receipt as bindingreceipt
import cheng/core/ir/core_types as coreir

fn TestCid(label: str): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(label.len)
    for index in 0..<label.len:
        layout.ByteBufAppendByte(buf, int32(label[index]) & 255)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn BytesSha256(value: rawbytes.Bytes): str =
    return layout.FixedBytes32Hex(
        hash256.Sha256Fixed(layout.ByteSpanFromBytes(value)))

fn CloneBytes(value: rawbytes.Bytes): rawbytes.Bytes =
    var out = rawbytes.BytesAlloc(rawbytes.BytesLen(value))
    for index in 0..<rawbytes.BytesLen(value):
        rawbytes.BytesSet(out, index, rawbytes.BytesGet(value, index))
    return out

fn BuildText(): rawbytes.Bytes =
    var out = obuf.ObjectBufferInit(12)
    obuf.ObjectBufferWriteU32LE(out, uint64(0x94000000))
    obuf.ObjectBufferWriteU32LE(out, uint64(0xd503201f))
    obuf.ObjectBufferWriteU32LE(out, uint64(0xd65f03c0))
    return obuf.ObjectBufferTakeBytes(out)

fn BuildFacts(): debug.DebugFactBundle =
    let documentCid = TestCid("pc-exact/document")
    let declKeyCid = TestCid("pc-exact/decl-key")
    let symbolCid = TestCid("pc-exact/symbol")
    var out: debug.DebugFactBundle
    out.sourceVersion = int64(1)
    out.packageId = "pkg://cheng/debug-pc-exact"
    out.predecessorReceiptCid = TestCid("pc-exact/predecessor")
    out.bindingReceiptCid = TestCid("pc-exact/binding")
    out.semanticSnapshotCid = TestCid("pc-exact/snapshot")
    out.worldHeadCid = TestCid("pc-exact/world")
    out.compilerCid = TestCid("pc-exact/compiler")
    out.sourceBundleCid = TestCid("pc-exact/source-bundle")
    out.csgRootCid = TestCid("pc-exact/csg-root")
    out.validationReceiptCid = TestCid("pc-exact/validation")
    out.declarationTableCid = TestCid("pc-exact/declaration-table")
    out.sourceCount = 1
    out.spanCount = 3
    out.typeCount = 1
    out.declarationCount = 1
    out.symbolCount = 1
    out.functionCount = 1
    out.typedNodeCount = 1
    out.debugOpCount = 1

    var functionFact: debug.DebugFact
    functionFact.kind = debug.DebugFactKindFunction
    functionFact.functionFact.functionId = 0
    functionFact.functionFact.typedFunctionIndex = 0
    functionFact.functionFact.declId = 0
    functionFact.functionFact.symbolId = 0
    functionFact.functionFact.sourceId = 0
    functionFact.functionFact.declarationSpanId = 0
    functionFact.functionFact.bodySpanId = 1
    functionFact.functionFact.documentCid = documentCid
    functionFact.functionFact.declKeyCid = declKeyCid
    functionFact.functionFact.symbolCid = symbolCid
    functionFact.functionFact.interfaceCid =
        TestCid("pc-exact/interface")
    functionFact.functionFact.fragmentCid =
        TestCid("pc-exact/function-fragment")
    functionFact.functionFact.modulePath = "pkg/main"
    functionFact.functionFact.functionName = "Main"
    functionFact.functionFact.qualifiedName = "pkg/main::Main"
    functionFact.functionFact.bodyStartByte = 0
    functionFact.functionFact.bodyEndByte = 12
    functionFact.functionFact.bodyStartLine = 0
    functionFact.functionFact.bodyStartColumn = 0
    functionFact.functionFact.bodyEndLine = 2
    functionFact.functionFact.bodyEndColumn = 1
    add(out.facts, functionFact)

    var operationFact: debug.DebugFact
    operationFact.kind = debug.DebugFactKindOperation
    operationFact.operationFact.debugOpId = 0
    operationFact.operationFact.typedNodeId = 0
    operationFact.operationFact.typedIrNodeIndex = 0
    operationFact.operationFact.originParserNodeId = 0
    operationFact.operationFact.syntheticOriginKind = 0
    operationFact.operationFact.spanAuthorityKind = 1
    operationFact.operationFact.functionId = 0
    operationFact.operationFact.functionDeclId = 0
    operationFact.operationFact.functionSymbolId = 0
    operationFact.operationFact.symbolDeclId = 0
    operationFact.operationFact.symbolId = 0
    operationFact.operationFact.sourceId = 0
    operationFact.operationFact.spanId = 2
    operationFact.operationFact.opKind = 1
    operationFact.operationFact.typedOpKind = 1
    operationFact.operationFact.typeId = 0
    operationFact.operationFact.ownershipKind = 1
    operationFact.operationFact.documentCid = documentCid
    operationFact.operationFact.functionDeclKeyCid = declKeyCid
    operationFact.operationFact.functionSymbolCid = symbolCid
    operationFact.operationFact.symbolDeclKeyCid = declKeyCid
    operationFact.operationFact.symbolCid = symbolCid
    operationFact.operationFact.modulePath = "pkg/main"
    operationFact.operationFact.startByte = 0
    operationFact.operationFact.endByte = 4
    operationFact.operationFact.startLine = 1
    operationFact.operationFact.startColumn = 0
    operationFact.operationFact.endLine = 1
    operationFact.operationFact.endColumn = 4
    add(out.facts, operationFact)

    var symbolFact: debug.DebugFact
    symbolFact.kind = debug.DebugFactKindSymbol
    symbolFact.symbolFact.symbolId = 0
    symbolFact.symbolFact.declId = 0
    symbolFact.symbolFact.sourceId = 0
    symbolFact.symbolFact.declarationSpanId = 0
    symbolFact.symbolFact.symbolKind = 1
    symbolFact.symbolFact.typeId = 0
    symbolFact.symbolFact.ownerSymbolId = -1
    symbolFact.symbolFact.functionId = 0
    symbolFact.symbolFact.documentCid = documentCid
    symbolFact.symbolFact.declKeyCid = declKeyCid
    symbolFact.symbolFact.symbolCid = symbolCid
    symbolFact.symbolFact.interfaceCid =
        functionFact.functionFact.interfaceCid
    symbolFact.symbolFact.modulePath = "pkg/main"
    symbolFact.symbolFact.name = "Main"
    symbolFact.symbolFact.qualifiedName = "pkg/main::Main"
    symbolFact.symbolFact.startByte = 0
    symbolFact.symbolFact.endByte = 4
    symbolFact.symbolFact.startLine = 0
    symbolFact.symbolFact.startColumn = 0
    symbolFact.symbolFact.endLine = 0
    symbolFact.symbolFact.endColumn = 4
    symbolFact.symbolFact.exported = true
    add(out.facts, symbolFact)

    out.factCount = out.facts.len
    out.declarationIdentityCid =
        debug.DebugFactBundleDeclarationIdentityCid(out)
    out.projectionCid = debug.DebugFactBundleProjectionCid(out)
    return out

fn BuildBinding(
        facts: debug.DebugFactBundle):
        bindingreceipt.SemanticSnapshotDebugBindingReceipt =
    var out: bindingreceipt.SemanticSnapshotDebugBindingReceipt
    out.sourceVersion = facts.sourceVersion
    out.snapshotIndex = 0
    out.payloadIndex = 0
    out.predecessorReceiptCid = facts.predecessorReceiptCid
    out.bindingReceiptCid = facts.bindingReceiptCid
    out.semanticSnapshotCid = facts.semanticSnapshotCid
    out.worldHeadCid = facts.worldHeadCid
    out.compilerCid = facts.compilerCid
    out.sourceBundleCid = facts.sourceBundleCid
    out.csgRootCid = facts.csgRootCid
    out.validationReceiptCid = facts.validationReceiptCid
    out.declarationTableCid = facts.declarationTableCid
    out.declarationIdentityCid = facts.declarationIdentityCid
    out.compilerFactProjectionCid =
        TestCid("pc-exact/compiler-projection")
    out.debugFactProjectionCid = facts.projectionCid
    out.loweringBridgeRootCid =
        TestCid("pc-exact/lowering-bridge")
    out.typedFunctionCount = facts.functionCount
    out.typedNodeCount = facts.typedNodeCount
    out.receiptCid =
        bindingreceipt.SemanticSnapshotDebugBindingReceiptCid(out)
    return out

fn BuildPlan(
        backendKind: str,
        text: rawbytes.Bytes):
        planevidence.DebugEmissionPlanEvidence =
    let hash0 = strings.Sha256("pc-exact/hash-0")
    let hash1 = strings.Sha256("pc-exact/hash-1")
    let fragment0 = rawbytes.BytesSliceView(text, 0, 4)
    let fragment1 = rawbytes.BytesSliceView(text, 8, 4)
    var out: planevidence.DebugEmissionPlanEvidence
    out.backendKind = backendKind
    out.symbolNames = ["_Main"]
    out.functionWordOffsets = [0]
    out.functionWordCounts = [3]
    out.frozenSnapshotPayloads = ["pc-exact/frozen"]
    out.emissionLedgerPayloads = ["pc-exact/ledger"]
    out.bodyIrSha256s = [hash0]
    out.symbolByteStarts = [0]
    out.symbolByteLengths = [12]
    out.symbolBytesSha256s = [BytesSha256(text)]
    out.planSha256s = [hash1]
    out.actionSemanticRootSha256s = [hash0]
    out.actionBindingRootSha256s = [hash1]
    out.machineFragmentRootSha256s = [hash0]
    out.abiIngressRootSha256s = [hash1]
    add(out.debugProvenanceBound, true)
    out.debugFunctionIds = [0]
    out.debugProvenanceSha256s = [hash0]
    out.debugMachineFragmentRootSha256s = [""]
    out.debugFragmentStarts = [0]
    out.debugFragmentCounts = [2]
    out.fragmentFunctionIndexes = [0, 0]
    out.fragmentDebugOpIds = [0, -1]
    out.fragmentSyntheticKinds = [
        coreir.BodyDebugSyntheticNone,
        coreir.BodyDebugSyntheticCleanup]
    out.fragmentSiteKinds = [0, 0]
    out.fragmentSiteIndexes = [0, 1]
    out.fragmentMachineOwnerKinds = [0, 0]
    out.fragmentMachineOwnerOrdinals = [0, 1]
    out.fragmentActionConsumerOrdinals = [0, 1]
    out.fragmentTextByteStarts = [0, 8]
    out.fragmentByteLengths = [4, 4]
    out.fragmentBytesSha256s = [
        BytesSha256(fragment0), BytesSha256(fragment1)]
    out.debugMachineFragmentRootSha256s[0] =
        planevidence.DebugEmissionPlanEvidenceDebugMachineFragmentRootSha256(
            out, 0)
    return out

fn BuildQuery(
        objectReceipt: receipt.DebugObjectEmissionReceipt,
        byteOffset: int32): linemap.LineMapPcQuery =
    let loadedAddress = int64(1048576)
    var out: linemap.LineMapPcQuery
    out.objectSectionIndex = objectReceipt.textSectionIndex
    out.loadedTextSectionAddress = loadedAddress
    out.crashPc = loadedAddress + int64(byteOffset)
    out.objectFileByteOffset =
        objectReceipt.textSectionFileOffset + byteOffset
    out.expectedFunctionId = 0
    out.expectedObjectSymbolTableIndex =
        objectReceipt.functions[0].objectSymbolTableIndex
    return out

fn main() =
    var err: str
    var facts = BuildFacts()
    assert(debug.DebugFactBundleStrictValidateInto(facts, err), err)
    let binding = BuildBinding(facts)
    assert(bindingreceipt.SemanticSnapshotDebugBindingReceiptValidateFactsInto(
               binding, facts, err), err)

    var text = BuildText()
    defer:
        rawbytes.BytesFree(text)
    var symbols = osym.ObjectSymbolsInit()
    assert(osym.ObjectSymbolsAddDefined(
               symbols, "_Main", 0, int64(0), int64(12), true) == 0,
           "pc exact: symbol fixture")
    var relocs = orel.ObjectRelocsInit()
    assert(orel.ObjectRelocsAdd(
               relocs, 0, int64(0), 0,
               orel.ObjectRelocBranch26, int64(0), true) == 0,
           "pc exact: relocation fixture")
    let objectResult = macho.MachOTextObjectBytes(text, symbols, relocs)
    assert(objectResult.ok, objectResult.err.msg)
    var objectBytes = objectResult.value
    defer:
        rawbytes.BytesFree(objectBytes)
    let objectCid = hash256.Sha256Fixed(
        layout.ByteSpanFromBytes(objectBytes))

    var primaryPlan = BuildPlan("primary", text)
    var parsedObject: objectevidence.DebugRelocatableObjectEvidence
    assert(objectevidence.DebugRelocatableObjectEvidenceBuildInto(
               objectBytes, primaryPlan.symbolNames,
               primaryPlan.symbolByteStarts,
               primaryPlan.symbolByteLengths,
               parsedObject, err), err)
    let writerTextSectionFileOffset =
        parsedObject.textSectionFileOffset
    var primaryReceipt: receipt.DebugObjectEmissionReceipt
    assert(receipt.DebugObjectEmissionReceiptBuildInto(
               facts, primaryPlan, objectCid,
               writerTextSectionFileOffset, objectBytes,
               primaryReceipt, err), err)
    assert(primaryReceipt.relocationCount == 1 &&
           primaryReceipt.relocationTableFileOffset > 0,
           "pc exact: relocation evidence missing")

    var backend2Plan = BuildPlan("backend2", text)
    var backend2Receipt: receipt.DebugObjectEmissionReceipt
    assert(receipt.DebugObjectEmissionReceiptBuildInto(
               facts, backend2Plan, objectCid,
               writerTextSectionFileOffset, objectBytes,
               backend2Receipt, err), err)

    let foundQuery = BuildQuery(primaryReceipt, 1)
    var primaryLookup: linemap.LineMapPcLookup
    assert(linemap.LineMapPcLookupFromValidatedDebugReceiptInto(
               binding, primaryReceipt, facts, primaryPlan,
               objectCid, primaryReceipt.textSectionFileOffset,
               objectBytes, foundQuery, primaryLookup, err), err)
    assert(primaryLookup.found &&
           primaryLookup.backendKind == "primary" &&
           primaryLookup.debugOpId == 0 &&
           primaryLookup.functionId == 0 &&
           primaryLookup.functionSymbolId ==
               facts.facts[0].functionFact.symbolId &&
           primaryLookup.functionDeclId ==
               facts.facts[0].functionFact.declId &&
           layout.FixedBytes32Equal(
               primaryLookup.functionDeclKeyCid,
               facts.facts[0].functionFact.declKeyCid) &&
           primaryLookup.sourceVersion == facts.sourceVersion &&
           layout.FixedBytes32Equal(
               primaryLookup.csgRootCid, facts.csgRootCid) &&
           primaryLookup.relocationCount == 1,
           "pc exact: primary exact join")

    let backend2Query = BuildQuery(backend2Receipt, 1)
    var backend2Lookup: linemap.LineMapPcLookup
    assert(linemap.LineMapPcLookupFromValidatedDebugReceiptInto(
               binding, backend2Receipt, facts, backend2Plan,
               objectCid, backend2Receipt.textSectionFileOffset,
               objectBytes, backend2Query, backend2Lookup, err) &&
           backend2Lookup.found &&
           backend2Lookup.backendKind == "backend2" &&
           backend2Lookup.debugOpId == primaryLookup.debugOpId &&
           backend2Lookup.functionDeclId ==
               primaryLookup.functionDeclId &&
           layout.FixedBytes32Equal(
               backend2Lookup.functionDeclKeyCid,
               primaryLookup.functionDeclKeyCid), err)

    let gapQuery = BuildQuery(primaryReceipt, 4)
    var notFound: linemap.LineMapPcLookup
    assert(linemap.LineMapPcLookupFromValidatedDebugReceiptInto(
               binding, primaryReceipt, facts, primaryPlan,
               objectCid, primaryReceipt.textSectionFileOffset,
               objectBytes, gapQuery, notFound, err) &&
           !notFound.found &&
           notFound.notFoundKind == linemap.LineMapPcNotFoundGap,
           "pc exact: gap address guessed")

    let syntheticQuery = BuildQuery(primaryReceipt, 8)
    assert(linemap.LineMapPcLookupFromValidatedDebugReceiptInto(
               binding, primaryReceipt, facts, primaryPlan,
               objectCid, primaryReceipt.textSectionFileOffset,
               objectBytes, syntheticQuery, notFound, err) &&
           !notFound.found &&
           notFound.notFoundKind ==
               linemap.LineMapPcNotFoundMissingDebugOp,
           "pc exact: synthetic fragment borrowed a DebugOp")

    var crossFunctionQuery = foundQuery
    crossFunctionQuery.expectedFunctionId = 1
    assert(!linemap.LineMapPcLookupFromValidatedDebugReceiptInto(
               binding, primaryReceipt, facts, primaryPlan,
               objectCid, primaryReceipt.textSectionFileOffset,
               objectBytes, crossFunctionQuery, notFound, err),
           "pc exact: cross-function PC accepted")

    var staleVersion = binding
    staleVersion.sourceVersion = staleVersion.sourceVersion + int64(1)
    staleVersion.receiptCid =
        bindingreceipt.SemanticSnapshotDebugBindingReceiptCid(
            staleVersion)
    assert(!linemap.LineMapPcLookupFromValidatedDebugReceiptInto(
               staleVersion, primaryReceipt, facts, primaryPlan,
               objectCid, primaryReceipt.textSectionFileOffset,
               objectBytes, foundQuery, notFound, err),
           "pc exact: stale sourceVersion accepted")

    var staleRoot = binding
    staleRoot.csgRootCid = TestCid("pc-exact/stale-root")
    staleRoot.receiptCid =
        bindingreceipt.SemanticSnapshotDebugBindingReceiptCid(staleRoot)
    assert(!linemap.LineMapPcLookupFromValidatedDebugReceiptInto(
               staleRoot, primaryReceipt, facts, primaryPlan,
               objectCid, primaryReceipt.textSectionFileOffset,
               objectBytes, foundQuery, notFound, err),
           "pc exact: stale CSG root accepted")

    var wrongRelocation = CloneBytes(objectBytes)
    defer:
        rawbytes.BytesFree(wrongRelocation)
    rawbytes.BytesSet(
        wrongRelocation, primaryReceipt.relocationTableFileOffset,
        rawbytes.BytesGet(
            wrongRelocation,
            primaryReceipt.relocationTableFileOffset) + 4)
    let wrongRelocationCid = hash256.Sha256Fixed(
        layout.ByteSpanFromBytes(wrongRelocation))
    assert(!linemap.LineMapPcLookupFromValidatedDebugReceiptInto(
               binding, primaryReceipt, facts, primaryPlan,
               wrongRelocationCid,
               primaryReceipt.textSectionFileOffset,
               wrongRelocation, foundQuery, notFound, err),
           "pc exact: wrong relocation accepted")

    var wrongAddend = CloneBytes(objectBytes)
    defer:
        rawbytes.BytesFree(wrongAddend)
    rawbytes.BytesSet(
        wrongAddend, primaryReceipt.textSectionFileOffset,
        rawbytes.BytesGet(
            wrongAddend, primaryReceipt.textSectionFileOffset) + 1)
    let wrongAddendCid = hash256.Sha256Fixed(
        layout.ByteSpanFromBytes(wrongAddend))
    assert(!linemap.LineMapPcLookupFromValidatedDebugReceiptInto(
               binding, primaryReceipt, facts, primaryPlan,
               wrongAddendCid,
               primaryReceipt.textSectionFileOffset,
               wrongAddend, foundQuery, notFound, err),
           "pc exact: wrong relocation addend accepted")

    var overlapPlan = primaryPlan
    overlapPlan.fragmentTextByteStarts[1] = 2
    let overlapBytes = rawbytes.BytesSliceView(text, 2, 4)
    overlapPlan.fragmentBytesSha256s[1] = BytesSha256(overlapBytes)
    overlapPlan.debugMachineFragmentRootSha256s[0] =
        planevidence.DebugEmissionPlanEvidenceDebugMachineFragmentRootSha256(
            overlapPlan, 0)
    var overlapReceipt: receipt.DebugObjectEmissionReceipt
    assert(receipt.DebugObjectEmissionReceiptBuildInto(
               facts, overlapPlan, objectCid,
               primaryReceipt.textSectionFileOffset,
               objectBytes, overlapReceipt, err), err)
    assert(!linemap.LineMapPcLookupFromValidatedDebugReceiptInto(
               binding, overlapReceipt, facts, overlapPlan,
               objectCid, overlapReceipt.textSectionFileOffset,
               objectBytes, foundQuery, notFound, err),
           "pc exact: overlapping fragment ranges accepted")

    var offsetAttack = foundQuery
    offsetAttack.objectFileByteOffset =
        offsetAttack.objectFileByteOffset + 1
    assert(!linemap.LineMapPcLookupFromValidatedDebugReceiptInto(
               binding, primaryReceipt, facts, primaryPlan,
               objectCid, primaryReceipt.textSectionFileOffset,
               objectBytes, offsetAttack, notFound, err),
           "pc exact: inconsistent final PC/object addend accepted")

    os.WriteLine(
        os.Get_stdout(), "debug_pc_exact_primary_object=1")
    os.WriteLine(
        os.Get_stdout(), "debug_pc_exact_backend2_object=1")
    os.WriteLine(
        os.Get_stdout(), "debug_pc_exact_runtime_lookup=1")
    os.WriteLine(
        os.Get_stdout(), "debug_pc_exact_attacks=pass")
