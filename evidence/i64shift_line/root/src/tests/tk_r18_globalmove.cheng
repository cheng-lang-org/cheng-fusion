var
    r18ActiveRoot: str

fn R18Normalize(raw: str): str =
    return raw

fn R18WorkspaceRoot(p: str): int32 =
    return p.len

fn R18Core(raw: str): int32 =
    let packageRoot: str = R18Normalize(raw)
    r18ActiveRoot = packageRoot
    return R18WorkspaceRoot(packageRoot)

fn main(): int32 =
    let n = R18Core("abc")
    if n != 3:
        return 10
    echo("r18 ok")
    return 0
