import std/cmdline
import std/os
import std/rawbytes
import std/result
import std/strings
import std/strutils as strutil
import cheng/std/bytes_layout as layout
import cheng/core/tooling/path as chengpath
import cheng/core/tooling/compiler_request as creq
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/tooling/compiler_world as cworld
import cheng/core/lang/parser
import cheng/core/backend/system_link_plan as slplan

fn CidEvidenceJoin(parts: str[]): str =
    return strutil.Join(parts, "")

fn CidEvidenceJsonString(value: str): str =
    assert(value != "", "CID evidence: empty JSON string")
    for index in 0..<value.len:
        let ch = value[index]
        assert(Int32(ch) >= 32 && Int32(ch) != 127 &&
               ch != '"' && ch != '\\',
               "CID evidence: JSON string requires escaping")
    return CidEvidenceJoin(["\"", value, "\""])

@borrows
fn CidEvidenceWriteDisk(root: str,
                        relativePath: str,
                        text: str) =
    let absolute = chengpath.PathJoin(root, relativePath)
    let parent = chengpath.PathParentDir(absolute)
    if parent != "":
        os.MkdirAll(parent, 493)
    os.WriteFile(absolute, text)

@borrows
fn CidEvidencePushRelative(files: var str[],
                           relativePath: str) =
    add(files, strings.CloneStr(relativePath))

@borrows
fn CidEvidenceWriteRolesRec(artifactRoot: str,
                            roles: str[],
                            values: str[],
                            index: int32,
                            files: var str[]) =
    if index >= roles.len || index >= values.len:
        return
    let roleOwned = strings.CloneStr(roles[index])
    let valueOwned = strings.CloneStr(values[index])
    let rel = CidEvidenceArtifactRelativePath(share(roleOwned))
    CidEvidenceWriteDisk(artifactRoot, share(rel), share(valueOwned))
    CidEvidencePushRelative(files, share(rel))
    CidEvidenceWriteRolesRec(
        artifactRoot, roles, values, index + 1, files)

@borrows
fn CidEvidenceSourceReceiptReport(
        receipt: ccsg.PortableSourceIdentityReceipt): str =
    return CidEvidenceJoin([
        "source_snapshot_count=", strings.IntToStr(receipt.sourceSnapshotCount), "\n",
        "import_edge_count=", strings.IntToStr(receipt.importEdgeCount), "\n",
        "unresolved_import_count=", strings.IntToStr(receipt.unresolvedImportCount), "\n",
        "source_package_id_cid=",
        layout.FixedBytes32Hex(receipt.sourcePackageIdCid), "\n",
        "entry_module_path_cid=",
        layout.FixedBytes32Hex(receipt.entryModulePathCid), "\n",
        "source_bundle_cid=",
        layout.FixedBytes32Hex(receipt.sourceBundleCid), "\n",
        "entry_source_cid=",
        layout.FixedBytes32Hex(receipt.entrySourceCid), "\n",
        "import_graph_cid=",
        layout.FixedBytes32Hex(receipt.importGraphCid), "\n",
        "receipt_cid=", layout.FixedBytes32Hex(receipt.receiptCid)])

fn CidEvidencePortableReceiptForPlan(
        plan: var slplan.SystemLinkPlanStub,
        sourcePath: str,
        outReceipt: var ccsg.PortableSourceIdentityReceipt,
        err: var str): bool =
    if plan.sourceBundleEntrySourceIndex < 0 ||
       plan.sourceBundleEntrySourceIndex >= plan.ownerModulePaths.len:
        err = "CID evidence: portable receipt entry index"
        return false
    let sourceReadRes = os.ReadFileResult(sourcePath)
    if IsErr(sourceReadRes):
        err = Error(sourceReadRes)
        return false
    var importGraphCid: layout.FixedBytes32
    if !cworld.CompilerWorldPortableImportGraphCidInto(
            plan.packageId,
            plan.importEdges,
            plan.unresolvedImportCount,
            importGraphCid,
            err):
        return false
    return ccsg.PortableSourceIdentityReceiptMakeInto(
        plan.sourceClosurePaths.len,
        plan.importEdges.len,
        plan.unresolvedImportCount,
        plan.packageId,
        plan.ownerModulePaths[plan.sourceBundleEntrySourceIndex],
        plan.sourceBundleCidValue,
        cworld.CompilerWorldSourceRawBytesCid(Value(sourceReadRes)),
        importGraphCid,
        outReceipt,
        err)

fn CidEvidenceAtomicTraceRoles(): str[] =
    return [
        "consume_first_graph_after",
        "consume_first_graph_before",
        "consume_first_output_after",
        "consume_first_output_before",
        "consume_first_plan_after",
        "consume_first_plan_before",
        "consume_first_stderr",
        "consume_first_stdout",
        "consume_rehash_graph_after",
        "consume_rehash_graph_before",
        "consume_rehash_output_after",
        "consume_rehash_output_before",
        "consume_rehash_plan_after",
        "consume_rehash_plan_before",
        "consume_rehash_stderr",
        "consume_rehash_stdout",
        "consume_second_graph_after",
        "consume_second_graph_before",
        "consume_second_output_after",
        "consume_second_output_before",
        "consume_second_plan_after",
        "consume_second_plan_before",
        "consume_second_stderr",
        "consume_second_stdout"]

@borrows
fn CidEvidenceArtifactRelativePath(role: str): str =
    if role == "binding_report":
        return "artifacts/binding-report.kv"
    if role == "compile_receipt":
        return "artifacts/compile-receipt.kv"
    if role == "csg_sidecar":
        return "artifacts/csg-sidecar.kv"
    if role == "output":
        return "artifacts/output.bin"
    if role == "semantic_receipt":
        return "artifacts/semantic-receipt.kv"
    if role == "source_receipt":
        return "artifacts/source-receipt.kv"
    if role == "consume_trace":
        return "artifacts/consume-trace.json"
    return CidEvidenceJoin(["artifacts/", share(role), ".bin"])

fn CidEvidenceAtomicPlanReport(
        plan: var slplan.SystemLinkPlanStub): str =
    if slplan.SystemLinkPlanExecutionPayloadRetainedItemCount(plan) <= 0:
        return ""
    return slplan.SystemLinkPlanStubReport(plan)

@borrows
fn CidEvidenceAtomicReceiptReport(
        receipt: ccsg.PortableSourceIdentityReceipt): str =
    if layout.FixedBytes32Equal(
            receipt.receiptCid, layout.FixedBytes32()):
        return ""
    return CidEvidenceSourceReceiptReport(receipt)

fn CidEvidenceAtomicOutputReport(csg: var ccsg.CompilerCsg): str =
    if csg.nodes.len <= 0:
        return ""
    return ccsg.CompilerCsgReport(csg)

@borrows
fn CidEvidenceAtomicInput(caseRoot: str,
                          plan: var slplan.SystemLinkPlanStub,
                          receipt: var ccsg.PortableSourceIdentityReceipt,
                          err: var str): bool =
    let sourcePath = chengpath.PathJoin(caseRoot, "src/main.cheng")
    let request = creq.CompilerRequestNew(
        strings.CloneStr(caseRoot),
        share(sourcePath),
        chengpath.PathJoin(caseRoot, "atomic.o"),
        "x86_64-unknown-linux-gnu",
        creq.EmitObj,
        "")
    if !slplan.BuildSystemLinkPlanStub(
            strings.CloneStr(caseRoot), request, plan, err):
        return false
    return CidEvidencePortableReceiptForPlan(
        plan, sourcePath, receipt, err)

@borrows
fn CidEvidenceAtomicTraceProjection(
        roles: str[],
        values: str[],
        firstExitCode: int32,
        secondExitCode: int32,
        rehashExitCode: int32): str =
    assert(roles.len == values.len,
           "CID evidence: atomic trace column mismatch")
    var out = "{"
    for roleIndex in 0..<roles.len:
        if roleIndex > 0:
            out = CidEvidenceJoin([out, ","])
        out = CidEvidenceJoin([
            out,
            CidEvidenceJsonString(
                CidEvidenceJoin([share(roles[roleIndex]), "_sha256"])),
            ":",
            CidEvidenceJsonString(strings.Sha256(values[roleIndex]))])
    out = CidEvidenceJoin([
        out,
        ",\"first_exit_code\":", strings.IntToStr(firstExitCode),
        ",\"rehash_attack_exit_code\":", strings.IntToStr(rehashExitCode),
        ",\"schema\":\"cheng.cid.csg_atomic_consume_trace\"",
        ",\"second_exit_code\":", strings.IntToStr(secondExitCode),
        "}"])
    return out

@borrows
fn CidEvidenceAtomicTrace(
        roles: str[],
        values: str[],
        firstExitCode: int32,
        secondExitCode: int32,
        rehashExitCode: int32): str =
    let projection = CidEvidenceAtomicTraceProjection(
        roles,
        values,
        firstExitCode,
        secondExitCode,
        rehashExitCode)
    var out = "{"
    for roleIndex in 0..<roles.len:
        if roleIndex > 0:
            out = CidEvidenceJoin([out, ","])
        out = CidEvidenceJoin([
            out,
            CidEvidenceJsonString(
                CidEvidenceJoin([share(roles[roleIndex]), "_sha256"])),
            ":",
            CidEvidenceJsonString(strings.Sha256(values[roleIndex]))])
    return CidEvidenceJoin([
        out,
        ",\"first_exit_code\":", strings.IntToStr(firstExitCode),
        ",\"manifest_sha256\":\"", strings.Sha256(projection), "\"",
        ",\"rehash_attack_exit_code\":", strings.IntToStr(rehashExitCode),
        ",\"schema\":\"cheng.cid.csg_atomic_consume_trace\"",
        ",\"second_exit_code\":", strings.IntToStr(secondExitCode),
        "}\n"])

@borrows
fn CidEvidenceAtomicConsumeArtifacts(
        caseRoot: str,
        artifactRoot: str,
        files: var str[]): Result[bool] =
    var firstPlan: slplan.SystemLinkPlanStub
    var firstReceipt: ccsg.PortableSourceIdentityReceipt
    var err = ""
    if !CidEvidenceAtomicInput(
            caseRoot, firstPlan, firstReceipt, err):
        return Err[bool](err)
    let firstPlanBefore = CidEvidenceAtomicPlanReport(firstPlan)
    let firstGraphBefore = CidEvidenceAtomicReceiptReport(firstReceipt)
    let firstOutputBefore = ""
    var firstOut: ccsg.CompilerCsg
    if !ccsg.BuildCompilerCsgConsumePortableReceiptInto(
            firstOut, err, firstPlan, firstReceipt):
        return Err[bool](err)
    let firstPlanAfter = CidEvidenceAtomicPlanReport(firstPlan)
    let firstGraphAfter = CidEvidenceAtomicReceiptReport(firstReceipt)
    let firstOutputAfter = CidEvidenceAtomicOutputReport(firstOut)
    if firstPlanBefore == "" || firstGraphBefore == "" ||
       firstPlanAfter != "" || firstGraphAfter != "" ||
       firstOutputAfter == "" || firstOutputAfter == firstOutputBefore:
        return Err[bool]("CID evidence: first atomic consume state transition")

    let secondPlanBefore = CidEvidenceAtomicPlanReport(firstPlan)
    let secondGraphBefore = CidEvidenceAtomicReceiptReport(firstReceipt)
    let secondOutputBefore = CidEvidenceAtomicOutputReport(firstOut)
    err = ""
    if ccsg.BuildCompilerCsgConsumePortableReceiptInto(
            firstOut, err, firstPlan, firstReceipt):
        return Err[bool]("CID evidence: second atomic consume succeeded")
    if err == "":
        return Err[bool]("CID evidence: second atomic consume error missing")
    let secondErr = err
    let secondPlanAfter = CidEvidenceAtomicPlanReport(firstPlan)
    let secondGraphAfter = CidEvidenceAtomicReceiptReport(firstReceipt)
    let secondOutputAfter = CidEvidenceAtomicOutputReport(firstOut)
    if secondPlanBefore != secondPlanAfter ||
       secondGraphBefore != secondGraphAfter ||
       secondOutputBefore != secondOutputAfter:
        return Err[bool]("CID evidence: second consume changed state")

    var rehashPlan: slplan.SystemLinkPlanStub
    var rehashReceipt: ccsg.PortableSourceIdentityReceipt
    err = ""
    if !CidEvidenceAtomicInput(
            caseRoot, rehashPlan, rehashReceipt, err):
        return Err[bool](err)
    var mutatedBytes = layout.FixedBytes32ToBytes(
        rehashPlan.sourceBundleCidValue)
    if rawbytes.BytesGet(mutatedBytes, 0) == 255:
        rawbytes.BytesSet(mutatedBytes, 0, 0)
    else:
        rawbytes.BytesSet(
            mutatedBytes, 0, rawbytes.BytesGet(mutatedBytes, 0) + 1)
    let mutatedRes = layout.FixedBytes32FromBytes(mutatedBytes)
    if IsErr(mutatedRes):
        return Err[bool]("CID evidence: mutated source bundle cid")
    let mutatedSourceBundleCid = Value(mutatedRes)
    rehashPlan.sourceBundleCidValue =
        layout.FixedBytes32Copy(mutatedSourceBundleCid)
    rehashPlan.sourceBundleBindingSeal =
        slplan.SystemLinkPlanComputeSourceBundleBindingSeal(
            rehashPlan.packageId,
            rehashPlan.workspaceRoot,
            rehashPlan.packageRoot,
            rehashPlan.externalPackageRoots,
            rehashPlan.sourceBundleEntrySourceIndex,
            rehashPlan.sourceBundleCidValue,
            rehashPlan.sourceBundleEntrySourceCid,
            rehashPlan.sourceBundleImportGraphCid,
            rehashPlan.sourceBundleIdentityPaths,
            rehashPlan.sourceClosurePaths,
            rehashPlan.ownerModulePaths,
            rehashPlan.importEdges,
            rehashPlan.unresolvedImportCount)
    if !ccsg.PortableSourceIdentityReceiptMakeInto(
            rehashPlan.sourceClosurePaths.len,
            rehashPlan.importEdges.len,
            rehashPlan.unresolvedImportCount,
            rehashPlan.packageId,
            rehashPlan.ownerModulePaths[
                rehashPlan.sourceBundleEntrySourceIndex],
            mutatedSourceBundleCid,
            rehashPlan.sourceBundleEntrySourceCid,
            rehashPlan.sourceBundleImportGraphCid,
            rehashReceipt,
            err):
        return Err[bool](err)
    let rehashPlanBefore = CidEvidenceAtomicPlanReport(rehashPlan)
    let rehashGraphBefore = CidEvidenceAtomicReceiptReport(rehashReceipt)
    let rehashOutputBefore = ""
    var rehashOut: ccsg.CompilerCsg
    err = ""
    if ccsg.BuildCompilerCsgConsumePortableReceiptInto(
            rehashOut, err, rehashPlan, rehashReceipt):
        return Err[bool]("CID evidence: coordinated rehash consume succeeded")
    if err == "":
        return Err[bool]("CID evidence: coordinated rehash error missing")
    let rehashErr = err
    let rehashPlanAfter = CidEvidenceAtomicPlanReport(rehashPlan)
    let rehashGraphAfter = CidEvidenceAtomicReceiptReport(rehashReceipt)
    let rehashOutputAfter = CidEvidenceAtomicOutputReport(rehashOut)
    if rehashPlanBefore == firstPlanBefore ||
       rehashGraphBefore == firstGraphBefore ||
       rehashPlanBefore != rehashPlanAfter ||
       rehashGraphBefore != rehashGraphAfter ||
       rehashOutputBefore != rehashOutputAfter:
        return Err[bool]("CID evidence: coordinated rehash atomic rejection")

    var roles = CidEvidenceAtomicTraceRoles()
    var values = [
        firstGraphAfter,
        firstGraphBefore,
        firstOutputAfter,
        firstOutputBefore,
        firstPlanAfter,
        firstPlanBefore,
        "",
        "",
        rehashGraphAfter,
        rehashGraphBefore,
        rehashOutputAfter,
        rehashOutputBefore,
        rehashPlanAfter,
        rehashPlanBefore,
        rehashErr,
        "",
        secondGraphAfter,
        secondGraphBefore,
        secondOutputAfter,
        secondOutputBefore,
        secondPlanAfter,
        secondPlanBefore,
        secondErr,
        ""]
    assert(roles.len == values.len,
           "CID evidence: atomic role/value count")
    CidEvidenceWriteRolesRec(artifactRoot, roles, values, 0, files)
    let trace = CidEvidenceAtomicTrace(roles, values, 0, 1, 1)
    let traceRel = CidEvidenceArtifactRelativePath("consume_trace")
    CidEvidenceWriteDisk(artifactRoot, share(traceRel), share(trace))
    CidEvidencePushRelative(files, share(traceRel))
    ccsg.CompilerCsgReleaseBackendInputPayload(firstOut)
    return Ok[bool](true)

fn main(): int32 =
    var caseId = ""
    var caseRoot = ""
    var artifactRoot = ""
    var compiledOutput = ""
    var evidencePrefix = ""
    if !cmdline.readFlagValue("--case", caseId) ||
       !cmdline.readFlagValue("--case-root", caseRoot) ||
       !cmdline.readFlagValue("--artifact-root", artifactRoot) ||
       !cmdline.readFlagValue("--compiled-output", compiledOutput) ||
       !cmdline.readFlagValue("--evidence-prefix", evidencePrefix):
        os.WriteLine(os.Get_stderr(), "CID evidence: missing required flag")
        return 2
    if caseId == "" || caseRoot == "" || artifactRoot == "" ||
       compiledOutput == "" || evidencePrefix == "":
        os.WriteLine(os.Get_stderr(), "CID evidence: empty required flag")
        return 2
    if caseId != "csg-atomic-consume":
        os.WriteLine(os.Get_stderr(), "CID evidence: specialized case required")
        return 17
    var files: str[]
    let result = CidEvidenceAtomicConsumeArtifacts(caseRoot, artifactRoot, files)
    if IsErr(result):
        os.WriteLine(os.Get_stderr(), Error(result))
        return 1
    return 0
