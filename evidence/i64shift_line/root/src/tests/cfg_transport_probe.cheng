import std/strings
import cheng/apps/vpn_proxy/vpn_proxy_config as config
import cheng/apps/vpn_proxy/vpn_proxy_routing as routing
import cheng/apps/vpn_proxy/vpn_proxy_main as vpn
import cheng/core/tooling/path as chengpath

fn main(): int32 =
    let text: str = chengpath.ReadTextFile("/Users/lbcheng/cheng-lang/scratchpad", "emucfg.json")
    if len(text) <= 0:
        echo("READ-FAIL")
        return 2
    let parseRes: Result[config.VpnProxyConfig] = config.VpnProxyParseConfigTextForTest(text)
    assert(!IsErr(parseRes), " cfg parse")
    var cfg: config.VpnProxyConfig
    cfg = Value(parseRes)
    echo("parsed-transport=")
    echo(cfg.exits[0].transport)
    let states: vpn.VpnProxyExitState[] = routing.VpnProxyInitExitStatesWithClientCertificate(cfg.exits, false)
    echo("state-count=")
    echo(IntToStr(Int32(len(states))))
    echo("state-transport=")
    echo(vpn.VpnProxyExitTransportText(states[0].cfg))
    return 0
