import std/os
import std/strutils as strutil
import cheng/core/backend/system_link_plan as slplan
import cheng/core/lang/parser
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/tooling/compiler_request as creq
import std/bytes_layout as layout

type
    CidAttackPlanSnapshot =
        entryPath: str
        buildEntryPath: str
        moduleStem: str
        packageId: str
        workspaceRoot: str
        packageRoot: str
        sourceBundleCid: layout.FixedBytes32
        sourceBundleBindingSeal: layout.FixedBytes32
        sourceBundleEntrySourceIndex: int32
        importEdgeCount: int32
        unresolvedImportCount: int32
        buildSourceUnitCount: int32
        externalPackageRoots: parser.ParserExternalPackageRoot[]
        sourceBundleIdentityPaths: str[]
        sourceClosurePaths: str[]
        ownerModulePaths: str[]
        importEdges: parser.ImportEdge[]
        runtimeTargets: str[]
        exprLayer: parser.NormalizedExprLayer

fn CidAttackCloneTexts(items: str[]): str[] =
    var out: str[]
    for itemIndex in 0..<items.len:
        add(out, items[itemIndex])
    return out

fn CidAttackCloneImportEdges(items: parser.ImportEdge[]): parser.ImportEdge[] =
    var out: parser.ImportEdge[]
    for edgeIndex in 0..<items.len:
        add(out, items[edgeIndex])
    return out

fn CidAttackCloneOverrides(
        items: ccsg.CompilerCsgSourceText[]): ccsg.CompilerCsgSourceText[] =
    var out: ccsg.CompilerCsgSourceText[]
    for itemIndex in 0..<items.len:
        var item: ccsg.CompilerCsgSourceText
        item.sourcePath = items[itemIndex].sourcePath
        item.modulePath = items[itemIndex].modulePath
        item.text = items[itemIndex].text
        add(out, item)
    return out

fn CidAttackProvider(sourcePath: str,
                     modulePath: str,
                     text: str): ccsg.CompilerCsgSourceText =
    var out: ccsg.CompilerCsgSourceText
    out.sourcePath = sourcePath
    out.modulePath = modulePath
    out.text = text
    return out

fn CidAttackSnapshot(plan: var slplan.SystemLinkPlanStub): CidAttackPlanSnapshot =
    var out: CidAttackPlanSnapshot
    out.entryPath = plan.entryPath
    out.buildEntryPath = plan.buildEntryPath
    out.moduleStem = plan.moduleStem
    out.packageId = plan.packageId
    out.workspaceRoot = plan.workspaceRoot
    out.packageRoot = plan.packageRoot
    out.sourceBundleCid = plan.sourceBundleCidValue
    out.sourceBundleBindingSeal = plan.sourceBundleBindingSeal
    out.sourceBundleEntrySourceIndex = plan.sourceBundleEntrySourceIndex
    out.importEdgeCount = plan.importEdgeCount
    out.unresolvedImportCount = plan.unresolvedImportCount
    out.buildSourceUnitCount = plan.buildSourceUnitCount
    out.externalPackageRoots =
        parser.ParserExternalPackageRootsClone(plan.externalPackageRoots)
    out.sourceBundleIdentityPaths =
        CidAttackCloneTexts(plan.sourceBundleIdentityPaths)
    out.sourceClosurePaths = CidAttackCloneTexts(plan.sourceClosurePaths)
    out.ownerModulePaths = CidAttackCloneTexts(plan.ownerModulePaths)
    out.importEdges = CidAttackCloneImportEdges(plan.importEdges)
    out.runtimeTargets = CidAttackCloneTexts(plan.runtimeTargets)
    out.exprLayer = parser.NormalizedExprLayerClone(plan.exprLayer)
    return out

fn CidAttackAssertTextsEqual(left: str[],
                              right: str[],
                              label: str) =
    assert(left.len == right.len,
           Fmt"cid identity attack: {label} length changed")
    for itemIndex in 0..<left.len:
        assert(left[itemIndex] == right[itemIndex],
               Fmt"cid identity attack: {label} row changed index={itemIndex}")

fn CidAttackAssertExternalRootsEqual(
        left: parser.ParserExternalPackageRoot[],
        right: parser.ParserExternalPackageRoot[],
        label: str) =
    assert(left.len == right.len,
           Fmt"cid identity attack: {label} length changed")
    for rootIndex in 0..<left.len:
        assert(slplan.SystemLinkPlanExternalRootEqual(left[rootIndex],
                                                      right[rootIndex]),
               Fmt"cid identity attack: {label} row changed index={rootIndex}")

fn CidAttackAssertImportEdgesEqual(left: parser.ImportEdge[],
                                    right: parser.ImportEdge[],
                                    label: str) =
    assert(left.len == right.len,
           Fmt"cid identity attack: {label} length changed")
    for edgeIndex in 0..<left.len:
        assert(slplan.SystemLinkPlanImportEdgeEqual(left[edgeIndex],
                                                    right[edgeIndex]),
               Fmt"cid identity attack: {label} row changed index={edgeIndex}")

fn CidAttackAssertExprLayerEqual(left: var parser.NormalizedExprLayer,
                                 right: var parser.NormalizedExprLayer,
                                 label: str) =
    assert(left.sourceCount == right.sourceCount &&
           left.questionResidualCount == right.questionResidualCount &&
           left.exprs.len == right.exprs.len &&
           left.exprNext.len == right.exprNext.len &&
           left.scopes.len == right.scopes.len &&
           left.exprLookup.slots.len == right.exprLookup.slots.len &&
           left.exprLookup.buckets.len == right.exprLookup.buckets.len &&
           left.valueExprTree == right.valueExprTree,
           Fmt"cid identity attack: {label} shape changed")
    for exprIndex in 0..<left.exprs.len:
        let a = left.exprs[exprIndex]
        let b = right.exprs[exprIndex]
        assert(a.exprId == b.exprId &&
               a.sourcePath == b.sourcePath &&
               a.lineNumber == b.lineNumber &&
               a.columnNumber == b.columnNumber &&
               a.endLineNumber == b.endLineNumber &&
               a.endColumnNumber == b.endColumnNumber &&
               a.kind == b.kind && a.detailKind == b.detailKind &&
               a.surfaceText == b.surfaceText &&
               a.callSurfaceKind == b.callSurfaceKind &&
               a.callResolved == b.callResolved &&
               a.callReason == b.callReason &&
               a.callQualifier == b.callQualifier &&
               a.callCallee == b.callCallee &&
               a.callTarget == b.callTarget &&
               a.callTargetSourcePath == b.callTargetSourcePath &&
               a.callTargetImportc == b.callTargetImportc &&
               a.callPrefixStyle == b.callPrefixStyle &&
               a.callArgCount == b.callArgCount &&
               a.callArgsText == b.callArgsText &&
               a.valueExprCallNodeIndex == b.valueExprCallNodeIndex &&
               a.callArgValueRootStart == b.callArgValueRootStart &&
               a.callArgValueRootCount == b.callArgValueRootCount &&
               a.valueExprRootNodeIndex == b.valueExprRootNodeIndex &&
               a.valueExprSpanStart == b.valueExprSpanStart &&
               a.valueExprSpanEnd == b.valueExprSpanEnd &&
               a.valueExprStatementRole == b.valueExprStatementRole &&
               a.lexicalScopeId == b.lexicalScopeId &&
               a.suiteScopeId == b.suiteScopeId &&
               a.statementOrdinal == b.statementOrdinal &&
               a.lexicalOrdinal == b.lexicalOrdinal &&
               a.deferOwnerStatementOrdinal == b.deferOwnerStatementOrdinal,
               Fmt"cid identity attack: {label} expr changed index={exprIndex}")
    for nextIndex in 0..<left.exprNext.len:
        assert(left.exprNext[nextIndex] == right.exprNext[nextIndex],
               Fmt"cid identity attack: {label} next changed index={nextIndex}")
    for scopeIndex in 0..<left.scopes.len:
        let a = left.scopes[scopeIndex]
        let b = right.scopes[scopeIndex]
        assert(a.sourcePath == b.sourcePath &&
               a.scopeId == b.scopeId &&
               a.sourceScopeId == b.sourceScopeId &&
               a.parentScopeId == b.parentScopeId &&
               a.kind == b.kind &&
               a.ownerStatementOrdinal == b.ownerStatementOrdinal &&
               a.lexicalOrdinal == b.lexicalOrdinal &&
               a.indentColumn == b.indentColumn &&
               a.startLineNumber == b.startLineNumber &&
               a.startColumnNumber == b.startColumnNumber &&
               a.endLineNumber == b.endLineNumber &&
               a.endColumnNumber == b.endColumnNumber,
               Fmt"cid identity attack: {label} scope changed index={scopeIndex}")
    for slotIndex in 0..<left.exprLookup.slots.len:
        assert(left.exprLookup.slots[slotIndex] ==
                   right.exprLookup.slots[slotIndex],
               Fmt"cid identity attack: {label} lookup slot changed index={slotIndex}")
    for bucketIndex in 0..<left.exprLookup.buckets.len:
        let a = left.exprLookup.buckets[bucketIndex]
        let b = right.exprLookup.buckets[bucketIndex]
        assert(a.sourcePathLen == b.sourcePathLen &&
               a.sourcePathFirstCode == b.sourcePathFirstCode &&
               a.sourcePathLastCode == b.sourcePathLastCode &&
               a.lineNumber == b.lineNumber &&
               a.columnNumber == b.columnNumber &&
               a.kindCode == b.kindCode &&
               a.detailCode == b.detailCode &&
               a.surfaceLen == b.surfaceLen &&
               a.surfaceFirstCode == b.surfaceFirstCode &&
               a.surfaceLastCode == b.surfaceLastCode &&
               a.head == b.head && a.pad == b.pad,
               Fmt"cid identity attack: {label} lookup bucket changed index={bucketIndex}")

fn CidAttackAssertPlanUnchanged(plan: var slplan.SystemLinkPlanStub,
                                 snapshot: var CidAttackPlanSnapshot,
                                 label: str) =
    assert(plan.entryPath == snapshot.entryPath &&
           plan.buildEntryPath == snapshot.buildEntryPath &&
           plan.moduleStem == snapshot.moduleStem &&
           plan.packageId == snapshot.packageId &&
           plan.workspaceRoot == snapshot.workspaceRoot &&
           plan.packageRoot == snapshot.packageRoot &&
           plan.sourceBundleCid.ok &&
           layout.FixedBytes32Equal(plan.sourceBundleCid.value,
                                    snapshot.sourceBundleCid) &&
           layout.FixedBytes32Equal(plan.sourceBundleCidValue,
                                    snapshot.sourceBundleCid) &&
           layout.FixedBytes32Equal(plan.sourceBundleBindingSeal,
                                    snapshot.sourceBundleBindingSeal) &&
           plan.sourceBundleEntrySourceIndex ==
               snapshot.sourceBundleEntrySourceIndex &&
           plan.importEdgeCount == snapshot.importEdgeCount &&
           plan.unresolvedImportCount == snapshot.unresolvedImportCount &&
           plan.buildSourceUnitCount == snapshot.buildSourceUnitCount,
           Fmt"cid identity attack: {label} scalar plan state changed")
    CidAttackAssertExternalRootsEqual(plan.externalPackageRoots,
                                      snapshot.externalPackageRoots,
                                      Fmt"{label} external roots")
    CidAttackAssertTextsEqual(plan.sourceBundleIdentityPaths,
                              snapshot.sourceBundleIdentityPaths,
                              Fmt"{label} identity")
    CidAttackAssertTextsEqual(plan.sourceClosurePaths,
                              snapshot.sourceClosurePaths,
                              Fmt"{label} closure")
    CidAttackAssertTextsEqual(plan.ownerModulePaths,
                              snapshot.ownerModulePaths,
                              Fmt"{label} owners")
    CidAttackAssertImportEdgesEqual(plan.importEdges,
                                    snapshot.importEdges,
                                    Fmt"{label} import edges")
    CidAttackAssertTextsEqual(plan.runtimeTargets,
                              snapshot.runtimeTargets,
                              Fmt"{label} runtime targets")
    CidAttackAssertExprLayerEqual(plan.exprLayer,
                                  snapshot.exprLayer,
                                  Fmt"{label} expr layer")

fn CidAttackAssertOverridesEqual(
        left: ccsg.CompilerCsgSourceText[],
        right: ccsg.CompilerCsgSourceText[],
        label: str) =
    assert(left.len == right.len,
           Fmt"cid identity attack: {label} override length changed")
    for itemIndex in 0..<left.len:
        assert(left[itemIndex].sourcePath == right[itemIndex].sourcePath &&
               left[itemIndex].modulePath == right[itemIndex].modulePath &&
               left[itemIndex].text == right[itemIndex].text,
               Fmt"cid identity attack: {label} override changed index={itemIndex}")

fn CidAttackReject(plan: var slplan.SystemLinkPlanStub,
                    sourceBundleCid: layout.FixedBytes32,
                    entryPathOverride: str,
                    entryTextOverride: str,
                    overrides: var ccsg.CompilerCsgSourceText[],
                    expectedReason: str,
                    label: str) =
    var snapshot = CidAttackSnapshot(plan)
    let overrideSnapshot = CidAttackCloneOverrides(overrides)
    var out: ccsg.CompilerCsg
    out.packageId = "cid-attack-out-sentinel"
    out.nodeCount = 81
    out.edgeCount = 82
    out.sourceSnapshotCount = 83
    out.sourceTextCapturedBytes = int64(84)
    var err: str
    assert(!ccsg.BuildCompilerCsgConsumeWithOverridesInto(out,
                                                          err,
                                                          plan,
                                                          sourceBundleCid,
                                                          entryPathOverride,
                                                          entryTextOverride,
                                                          overrides),
           Fmt"cid identity attack: {label} unexpectedly succeeded")
    assert(strutil.Contains(err, expectedReason),
           Fmt"cid identity attack: {label} wrong rejection err={err}")
    CidAttackAssertPlanUnchanged(plan, snapshot, label)
    CidAttackAssertOverridesEqual(overrides, overrideSnapshot, label)
    assert(out.packageId == "cid-attack-out-sentinel" &&
           out.nodeCount == 81 && out.edgeCount == 82 &&
           out.sourceSnapshotCount == 83 &&
           out.sourceTextCapturedBytes == int64(84) &&
           out.nodes.len == 0 && out.edges.len == 0 &&
           out.typedIr.functions2_functionNameIds.len == 0,
           Fmt"cid identity attack: {label} published partial output")
    parser.NormalizedExprLayerReset(snapshot.exprLayer)
    echo(Fmt"cid_identity_attack_rejected={label}")

fn CidAttackBuildPlan(root: str,
                      plan: var slplan.SystemLinkPlanStub,
                      sourceBundleCid: var layout.FixedBytes32,
                      entryText: var str) =
    let sourceDir = Fmt"{root}/src"
    let dependencyRoot = Fmt"{root}/certified-dependency"
    let entryPath = Fmt"{sourceDir}/main.cheng"
    let helperPath = Fmt"{sourceDir}/helper.cheng"
    let emptyPath = Fmt"{sourceDir}/empty.cheng"
    os.MkdirAll(sourceDir, 493)
    os.MkdirAll(Fmt"{dependencyRoot}/src", 493)
    os.WriteFile(Fmt"{root}/cheng-package.toml",
                 "package_id = \"pkg://cheng/compiler_csg_cid_identity_attack\"\n")
    os.WriteFile(Fmt"{dependencyRoot}/cheng-package.toml",
                 "package_id = \"pkg://cheng/compiler-csg-cid-identity-attack-dependency\"\n")
    entryText = strutil.Join(
        ["import cheng/compiler_csg_cid_identity_attack/helper as helper\n\n",
         "import cheng/compiler_csg_cid_identity_attack/empty as empty\n\n",
         "fn Root(): int32 =\n",
         "    return helper.Value()\n"],
        "")
    os.WriteFile(entryPath, entryText)
    os.WriteFile(helperPath,
                 "fn Value(): int32 =\n    return 7\n")
    os.WriteFile(emptyPath, "")
    assert(os.FileExists(entryPath) &&
           os.FileExists(helperPath) &&
           os.FileExists(emptyPath) &&
           parser.ParserSourceExists(entryPath) &&
           parser.ParserSourceExists(emptyPath),
           Fmt"cid identity attack: fixture file existence contract entry={os.FileExists(entryPath)}/{parser.ParserSourceExists(entryPath)} helper={os.FileExists(helperPath)}/{parser.ParserSourceExists(helperPath)} empty={os.FileExists(emptyPath)}/{parser.ParserSourceExists(emptyPath)}")
    let requestBase = creq.CompilerRequestNew(root,
                                              entryPath,
                                              Fmt"{root}/out.o",
                                              "arm64-apple-darwin",
                                              creq.EmitObj,
                                              "")
    let request = creq.CompilerRequestWithExportRootSymbols(requestBase,
                                                             ["Root"])
    var externalPackageRoots: parser.ParserExternalPackageRoot[]
    add(externalPackageRoots,
        parser.ParserExternalPackageRootCertifiedNew(
            "cheng/compiler-csg-cid-identity-attack-dependency",
            "cheng/compiler-csg-cid-identity-attack-dependency",
            dependencyRoot))
    var err: str
    assert(slplan.BuildSystemLinkPlanStubWithExternalPackageRoots(root,
                                                                  request,
                                                                  externalPackageRoots,
                                                                  plan,
                                                                  err),
           Fmt"cid identity attack: fixture plan failed err={err}")
    assert(slplan.SystemLinkPlanSourceBundleBindingValidInto(plan, err),
           Fmt"cid identity attack: fixture binding invalid err={err}")
    assert(plan.sourceBundleCid.ok,
           "cid identity attack: fixture cid unavailable")
    sourceBundleCid = plan.sourceBundleCid.value
    assert(plan.externalPackageRoots.len > 0 &&
           plan.sourceBundleIdentityPaths.len > 2 &&
           plan.sourceClosurePaths.len > 2 &&
           plan.ownerModulePaths.len == plan.sourceClosurePaths.len &&
           plan.importEdges.len > 0 &&
           plan.sourceBundleEntrySourceIndex >= 0,
           Fmt"cid identity attack: fixture did not exercise sealed graph payload external={plan.externalPackageRoots.len} identities={plan.sourceBundleIdentityPaths.len} closure={plan.sourceClosurePaths.len} owners={plan.ownerModulePaths.len} edges={plan.importEdges.len} entry={plan.sourceBundleEntrySourceIndex}")

fn main(): int32 =
    let root = "/tmp/compiler_csg_cid_identity_attack_smoke"
    var plan: slplan.SystemLinkPlanStub
    var sourceBundleCid: layout.FixedBytes32
    var entryText: str
    CidAttackBuildPlan(root, plan, sourceBundleCid, entryText)
    var entryForgeryProvider = CidAttackProvider(
        plan.entryPath,
        plan.ownerModulePaths[plan.sourceBundleEntrySourceIndex],
        entryText)
    var entryForgeryProviders = [entryForgeryProvider]
    CidAttackReject(plan,
                    sourceBundleCid,
                    Fmt"{root}/src/forged-entry.cheng",
                    "",
                    entryForgeryProviders,
                    "entry override disagrees with sealed entry identity",
                    "entry path forgery")

    var forgedModuleProvider = CidAttackProvider(
        plan.entryPath,
        "cheng/compiler_csg_cid_identity_attack/forged-owner",
        entryText)
    var forgedModuleProviders = [forgedModuleProvider]
    CidAttackReject(plan,
                    sourceBundleCid,
                    "",
                    "",
                    forgedModuleProviders,
                    "source text provider module disagrees with sealed owner",
                    "provider module forgery")

    var outsideProvider: ccsg.CompilerCsgSourceText
    outsideProvider.sourcePath = Fmt"{root}/src/outside-closure.cheng"
    outsideProvider.modulePath =
        "cheng/compiler_csg_cid_identity_attack/outside-closure"
    outsideProvider.text = "fn Outside(): int32 =\n    return 9\n"
    var outsideProviders = [outsideProvider]
    CidAttackReject(plan,
                    sourceBundleCid,
                    "",
                    "",
                    outsideProviders,
                    "source text provider outside sealed closure",
                    "outside closure provider")

    var duplicateProviderA = CidAttackProvider(
        plan.entryPath,
        plan.ownerModulePaths[plan.sourceBundleEntrySourceIndex],
        entryText)
    var duplicateProviderB = CidAttackProvider(
        plan.entryPath,
        plan.ownerModulePaths[plan.sourceBundleEntrySourceIndex],
        entryText)
    var duplicateProviders = [duplicateProviderA, duplicateProviderB]
    CidAttackReject(plan,
                    sourceBundleCid,
                    "",
                    "",
                    duplicateProviders,
                    "source text has multiple providers",
                    "duplicate provider")

    var tamperedSourceBundleCid = sourceBundleCid
    tamperedSourceBundleCid.data[0] =
        uint8(tamperedSourceBundleCid.data[0] ^ uint8(1))
    var cidTamperProviders: ccsg.CompilerCsgSourceText[]
    CidAttackReject(plan,
                    tamperedSourceBundleCid,
                    "",
                    "",
                    cidTamperProviders,
                    "independent source bundle cid disagrees",
                    "source bundle cid tamper")

    let helperPath = Fmt"{root}/src/helper.cheng"
    os.WriteFile(helperPath,
                 "fn Value(): int32 =\n    return 8\n")
    var changedFileProviders: ccsg.CompilerCsgSourceText[]
    CidAttackReject(plan,
                    sourceBundleCid,
                    "",
                    "",
                    changedFileProviders,
                    "portable binding exact text mismatch",
                    "post-plan source change")
    os.WriteFile(helperPath,
                 "fn Value(): int32 =\n    return 7\n")

    # 末腿暂等 core valueExprTree 权威层修复: 当前 valid consume 挂在
    # 「parser value expr: dedicated call fact unavailable callee=helper.Value」。
    # 该缺陷由另一路修 cold 后端, 此处不改断言、不绕修; 修复落地后本腿应直接转绿。
    var noOverrides: ccsg.CompilerCsgSourceText[]
    var out: ccsg.CompilerCsg
    var err: str
    assert(ccsg.BuildCompilerCsgConsumeWithOverridesInto(out,
                                                         err,
                                                         plan,
                                                         sourceBundleCid,
                                                         "",
                                                         "",
                                                         noOverrides),
           Fmt"cid identity attack: valid consume failed err={err}")
    assert(layout.FixedBytes32Equal(plan.sourceBundleBindingSeal,
                                    layout.FixedBytes32()) &&
           plan.sourceBundleEntrySourceIndex == -1 &&
           plan.externalPackageRoots.len == 0 &&
           plan.sourceBundleIdentityPaths.len == 0 &&
           plan.sourceClosurePaths.len == 0 &&
           plan.ownerModulePaths.len == 0 &&
           plan.importEdges.len == 0 &&
           plan.runtimeTargets.len == 0 &&
           plan.exprLayer.exprs.len == 0 &&
           plan.exprLayer.exprNext.len == 0 &&
           plan.exprLayer.exprLookup.slots.len == 0 &&
           plan.exprLayer.exprLookup.buckets.len == 0 &&
           out.nodes.len > 0 && out.typedIr.functions2_functionNameIds.len > 0,
           "cid identity attack: successful consume retained sealed payload")
    ccsg.CompilerCsgReleaseBackendInputPayload(out)
    echo(" compiler_csg_cid_identity_attack_smoke ok")
    return 0
