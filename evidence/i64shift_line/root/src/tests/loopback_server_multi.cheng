import std/cmdline as cmdline
import std/result
import cheng/apps/vpn_proxy/vpn_proxy_exit_dns as exitdns
import cheng/apps/vpn_proxy/vpn_proxy_listen as listen
import cheng/apps/vpn_proxy/vpn_proxy_main as vpnproxy

fn main(argc: int32, argv: str*): int32 =
    argc
    argv
    cmdline.CaptureCmdLine(argc, argv)
    var configPath: str = "server-loopback-open-smoke.json"
    if cmdline.ParamCount() >= 1:
        configPath = cmdline.ParamStr(1)
    let configRes: Result[vpnproxy.VpnProxyConfig] = vpnproxy.VpnProxyLoadConfig(configPath)
    if IsErr(configRes):
        vpnproxy.VpnProxyPrintErr(ErrorText(configRes))
        return 1
    let config: vpnproxy.VpnProxyConfig = Value(configRes)
    var identity: vpnproxy.VpnProxyLoadedIdentity
    if !vpnproxy.VpnProxyLoadFixedServerIdentityInto(identity):
        return 1
    let dnsConfigureRes: Result[bool] = exitdns.VpnProxyExitDnsConfigure("108.61.10.10")
    if IsErr(dnsConfigureRes):
        vpnproxy.VpnProxyPrintErr(ErrorText(dnsConfigureRes))
        return 1
    let listenParsedRes: Result[listen.VpnProxyListenAddress] = listen.VpnProxyParseListenAddress("127.0.0.1:17443")
    if IsErr(listenParsedRes):
        vpnproxy.VpnProxyPrintErr(ErrorText(listenParsedRes))
        return 1
    let listenParsed: listen.VpnProxyListenAddress = Value(listenParsedRes)
    return vpnproxy.VpnProxyExitRunLoop("", 0, config, identity, listenParsed.host, listenParsed.port)
