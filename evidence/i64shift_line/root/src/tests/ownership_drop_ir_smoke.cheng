fn runConditionalOwnershipDefer() =
    var ir: odir.OwnershipDropIr
    odir.OwnershipDropIrInit(ir)
    let root = odir.OwnershipDropRootScopeId(ir)
    let resourceType = odir.OwnershipDropRegisterLeafType(ir, "DeferredConditional", 77)
    let placeId = odir.OwnershipDropAddPlace(ir, resourceType, odir.Owned, root)
    let drop = odir.OwnershipDropRegisterDeferEffect(ir,
                                                     root,
                                                     odir.DeferEffectDropPlace,
                                                     placeId,
                                                     -1)
    let entry = odir.OwnershipDropAddBlock(ir, root)
    odir.OwnershipDropSetEntryBlock(ir, entry)
    odir.OwnershipDropAppendInitialize(ir, entry, placeId)
    let left = odir.OwnershipDropAddBlock(ir, root)
    odir.OwnershipDropAppendActivateDefer(ir, left, drop)
    let right = odir.OwnershipDropAddBlock(ir, root)
    let join = odir.OwnershipDropAddBlock(ir, root)
    let exitBlock = odir.OwnershipDropAddBlock(ir, root)
    addSameScopeEdge(ir, entry, left, odir.OwnershipDropEdgeNormal)
    addSameScopeEdge(ir, entry, right, odir.OwnershipDropEdgeNormal)
    addSameScopeEdge(ir, left, join, odir.OwnershipDropEdgeNormal)
    addSameScopeEdge(ir, right, join, odir.OwnershipDropEdgeNormal)
    var cleanup: int32[]
    add(cleanup, placeId)
    var defers: int32[]
    add(defers, drop)
    let edgeId = odir.OwnershipDropAddEdge(ir,
                                           join,
                                           exitBlock,
                                           odir.OwnershipDropEdgeReturn,
                                           -1,
                                           cleanup,
                                           defers)
    var analysis: odir.OwnershipDropAnalysis
    odir.OwnershipDropAnalyze(ir, analysis)
    var activeFound: bool
    var fallbackFound: bool
    var guardFlagId = -1
    let actionCount = odir.OwnershipDropAnalysisEdgeActionCount(analysis,
                                                                edgeId)
    for ordinal in 0..<actionCount:
        let action = odir.OwnershipDropAnalysisEdgeAction(analysis,
                                                          edgeId,
                                                          ordinal)
        if action.kind == odir.CleanupActionDropPlace &&
           action.guardDeferId == drop:
            let projection = odir.OwnershipDropProjectActionCondition(
                ir,
                analysis,
                action)
            if guardFlagId >= 0 &&
               guardFlagId != projection.guardFlagId:
                panic("ownership drop smoke: conditional guard identity drift")
            guardFlagId = projection.guardFlagId
            if projection.guardNegated:
                fallbackFound = true
            else:
                activeFound = true
    smokeAssert(activeFound && fallbackFound && guardFlagId > 0,
                "ownership drop smoke: conditional ownership guard missing")

