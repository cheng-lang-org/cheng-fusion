fn runManualConditionalJoin() =
    var ir: odir.OwnershipDropIr
    odir.OwnershipDropIrInit(ir)
    let root = odir.OwnershipDropRootScopeId(ir)
    let resourceType =
        odir.OwnershipDropRegisterLeafType(
            ir, "ManualConditionalJoin", 91)
    let target =
        odir.OwnershipDropAddPlace(
            ir, resourceType, odir.ExternalVarBorrow, root)
    let leftSource =
        odir.OwnershipDropAddPlace(
            ir, resourceType, odir.Owned, root)
    let joinSource =
        odir.OwnershipDropAddPlace(
            ir, resourceType, odir.Owned, root)
    odir.OwnershipDropBindEntryDefinition(
        ir, target,
        odir.OwnershipDropDefinitionDomainEntrySlot, 100)
    odir.OwnershipDropBindEntryDefinition(
        ir, leftSource,
        odir.OwnershipDropDefinitionDomainEntrySlot, 101)
    odir.OwnershipDropBindEntryDefinition(
        ir, joinSource,
        odir.OwnershipDropDefinitionDomainEntrySlot, 102)
    let entry = odir.OwnershipDropAddBlock(ir, root)
    odir.OwnershipDropSetEntryBlock(ir, entry)
    let left = odir.OwnershipDropAddBlock(ir, root)
    let leftTransfer =
        odir.OwnershipDropAppendManualConsumeTransfer(
            ir, left, target, leftSource, 0,
            odir.OwnershipDropDefinitionDomainEntrySlot, 100,
            odir.OwnershipDropDefinitionDomainEntrySlot, 101,
            odir.OwnershipDropDefinitionDomainManualConsumePostCall, 0)
    let right = odir.OwnershipDropAddBlock(ir, root)
    let join = odir.OwnershipDropAddBlock(ir, root)
    let joinTransfer =
        odir.OwnershipDropAppendManualConsumeTransfer(
            ir, join, target, joinSource, 1,
            odir.OwnershipDropDefinitionDomainManualConsumePostCall, 0,
            odir.OwnershipDropDefinitionDomainEntrySlot, 102,
            odir.OwnershipDropDefinitionDomainManualConsumePostCall, 1)
    addSameScopeEdge(
        ir, entry, left, odir.OwnershipDropEdgeNormal)
    addSameScopeEdge(
        ir, entry, right, odir.OwnershipDropEdgeNormal)
    addSameScopeEdge(
        ir, left, join, odir.OwnershipDropEdgeNormal)
    addSameScopeEdge(
        ir, right, join, odir.OwnershipDropEdgeNormal)
    # The join terminal must close with an explicit return edge: the engine
    # has no implicit terminal release. The cleanup inventory must be the
    # exact declaration-ordered scope inventory (target, leftSource,
    # joinSource); LIFO application then releases the external borrow view
    # (target) after dropping the still-owned leftSource the untaken left
    # arm never consumed, while the already-moved joinSource is a no-op.
    let exitBlock = odir.OwnershipDropAddBlock(ir, root)
    var cleanup: int32[]
    add(cleanup, target)
    add(cleanup, leftSource)
    add(cleanup, joinSource)
    var defers: int32[]
    odir.OwnershipDropAddEdge(ir,
                              join,
                              exitBlock,
                              odir.OwnershipDropEdgeReturn,
                              -1,
                              cleanup,
                              defers)
    var analysis: odir.OwnershipDropAnalysis
    odir.OwnershipDropAnalyzeCanonical(ir, analysis)
    smokeAssert(
        analysis.converged &&
        analysis.opActionCounts[leftTransfer] == 0 &&
        analysis.opActionCounts[joinTransfer] == 0,
        "ownership drop smoke: conditional manual join")

fn runManualLoopBackedge() =
    var ir: odir.OwnershipDropIr
    odir.OwnershipDropIrInit(ir)
    let root = odir.OwnershipDropRootScopeId(ir)
    let resourceType =
        odir.OwnershipDropRegisterLeafType(
            ir, "ManualLoopBackedge", 92)
    let target =
        odir.OwnershipDropAddPlace(
            ir, resourceType, odir.ExternalVarBorrow, root)
    let source =
        odir.OwnershipDropAddPlace(
            ir, resourceType, odir.Owned, root)
    odir.OwnershipDropBindEntryDefinition(
        ir, target,
        odir.OwnershipDropDefinitionDomainEntrySlot, 200)
    let entry = odir.OwnershipDropAddBlock(ir, root)
    odir.OwnershipDropSetEntryBlock(ir, entry)
    let header = odir.OwnershipDropAddBlock(ir, root)
    let initialize =
        odir.OwnershipDropAppendInitialize(
            ir, header, source)
    odir.OwnershipDropBindOpDefinitionAuthority(
        ir, initialize,
        odir.DefinitionOriginTypedExpr, 300,
        odir.OwnershipDropDefinitionDomainBodyOp,
        initialize, odir.Owned)
    odir.OwnershipDropBindOpDefinitionCoordinate(
        ir, initialize,
        odir.OwnershipDropDefinitionDomainBodyOp,
        initialize)
    let transfer =
        odir.OwnershipDropAppendManualConsumeTransfer(
            ir, header, target, source, 1,
            odir.OwnershipDropDefinitionDomainEntrySlot, 200,
            odir.OwnershipDropDefinitionDomainBodyOp, initialize,
            odir.OwnershipDropDefinitionDomainManualConsumePostCall, 1)
    let latch = odir.OwnershipDropAddBlock(ir, root)
    addSameScopeEdge(
        ir, entry, header, odir.OwnershipDropEdgeNormal)
    addSameScopeEdge(
        ir, header, latch, odir.OwnershipDropEdgeNormal)
    addSameScopeEdge(
        ir, latch, header, odir.OwnershipDropEdgeLoopBack)
    var analysis: odir.OwnershipDropAnalysis
    odir.OwnershipDropAnalyzeCanonical(ir, analysis)
    smokeAssert(
        analysis.converged &&
        analysis.fixedPointSteps > ir.blocks.len &&
        analysis.opActionCounts[transfer] == 0,
        "ownership drop smoke: manual loop backedge")

fn runManualConditionalWrongRow() =
    var ir: odir.OwnershipDropIr
    odir.OwnershipDropIrInit(ir)
    let root = odir.OwnershipDropRootScopeId(ir)
    let resourceType =
        odir.OwnershipDropRegisterLeafType(
            ir, "ManualConditionalWrong", 93)
    let target =
        odir.OwnershipDropAddPlace(
            ir, resourceType, odir.ExternalVarBorrow, root)
    let leftSource =
        odir.OwnershipDropAddPlace(
            ir, resourceType, odir.Owned, root)
    let joinSource =
        odir.OwnershipDropAddPlace(
            ir, resourceType, odir.Owned, root)
    odir.OwnershipDropBindEntryDefinition(
        ir, target,
        odir.OwnershipDropDefinitionDomainEntrySlot, 400)
    odir.OwnershipDropBindEntryDefinition(
        ir, leftSource,
        odir.OwnershipDropDefinitionDomainEntrySlot, 401)
    odir.OwnershipDropBindEntryDefinition(
        ir, joinSource,
        odir.OwnershipDropDefinitionDomainEntrySlot, 402)
    let entry = odir.OwnershipDropAddBlock(ir, root)
    odir.OwnershipDropSetEntryBlock(ir, entry)
    let left = odir.OwnershipDropAddBlock(ir, root)
    let _ = odir.OwnershipDropAppendManualConsumeTransfer(
        ir, left, target, leftSource, 0,
        odir.OwnershipDropDefinitionDomainEntrySlot, 400,
        odir.OwnershipDropDefinitionDomainEntrySlot, 401,
        odir.OwnershipDropDefinitionDomainManualConsumePostCall, 0)
    let right = odir.OwnershipDropAddBlock(ir, root)
    let join = odir.OwnershipDropAddBlock(ir, root)
    let _ = odir.OwnershipDropAppendManualConsumeTransfer(
        ir, join, target, joinSource, 1,
        odir.OwnershipDropDefinitionDomainManualConsumePostCall, 1,
        odir.OwnershipDropDefinitionDomainEntrySlot, 402,
        odir.OwnershipDropDefinitionDomainManualConsumePostCall, 1)
    addSameScopeEdge(
        ir, entry, left, odir.OwnershipDropEdgeNormal)
    addSameScopeEdge(
        ir, entry, right, odir.OwnershipDropEdgeNormal)
    addSameScopeEdge(
        ir, left, join, odir.OwnershipDropEdgeNormal)
    addSameScopeEdge(
        ir, right, join, odir.OwnershipDropEdgeNormal)
    var analysis: odir.OwnershipDropAnalysis
    odir.OwnershipDropAnalyzeCanonical(ir, analysis)
    panic("ownership drop smoke: unreachable manual row accepted")

fn runUnknownOwnership() =
    var ir: odir.OwnershipDropIr
    odir.OwnershipDropIrInit(ir)
    let root = odir.OwnershipDropRootScopeId(ir)
    let resourceType = odir.OwnershipDropRegisterLeafType(ir, "Resource", 77)
    odir.OwnershipDropAddPlace(ir, resourceType, odir.OwnershipUnknown, root)
    panic("ownership drop smoke: unknown ownership accepted")

fn runUnknownType() =
    var ir: odir.OwnershipDropIr
    odir.OwnershipDropIrInit(ir)
    let root = odir.OwnershipDropRootScopeId(ir)
    odir.OwnershipDropAddPlace(ir, 99, odir.Owned, root)
    panic("ownership drop smoke: unknown type accepted")

fn runUnknownEdge() =
    var ir: odir.OwnershipDropIr
    odir.OwnershipDropIrInit(ir)
    let root = odir.OwnershipDropRootScopeId(ir)
    let entry = odir.OwnershipDropAddBlock(ir, root)
    odir.OwnershipDropSetEntryBlock(ir, entry)
    let exitBlock = odir.OwnershipDropAddBlock(ir, root)
    var cleanup: int32[]
    var defers: int32[]
    odir.OwnershipDropAddEdge(ir,
                              entry,
                              exitBlock,
                              odir.OwnershipDropEdgeUnknown,
                              -1,
                              cleanup,
                              defers)
    panic("ownership drop smoke: unknown edge accepted")

fn runUnknownUnreachableOp() =
    var ir: odir.OwnershipDropIr
    odir.OwnershipDropIrInit(ir)
    let root = odir.OwnershipDropRootScopeId(ir)
    let resourceType = odir.OwnershipDropRegisterLeafType(ir, "UnreachableOp", 77)
    let placeId = odir.OwnershipDropAddPlace(ir, resourceType, odir.Owned, root)
    let entry = odir.OwnershipDropAddBlock(ir, root)
    odir.OwnershipDropSetEntryBlock(ir, entry)
    let unreachable = odir.OwnershipDropAddBlock(ir, root)
    let opIndex = odir.OwnershipDropAppendInitialize(ir, unreachable, placeId)
    var op = ir.ops[opIndex]
    op.kind = odir.OwnershipDropOpUnknown
    ir.ops[opIndex] = op
    var analysis: odir.OwnershipDropAnalysis
    odir.OwnershipDropAnalyze(ir, analysis)
    panic("ownership drop smoke: unknown unreachable op accepted")

fn runMalformedUnreachableOp() =
    var ir: odir.OwnershipDropIr
    odir.OwnershipDropIrInit(ir)
    let root = odir.OwnershipDropRootScopeId(ir)
    let resourceType = odir.OwnershipDropRegisterLeafType(ir, "MalformedOp", 77)
    let placeId = odir.OwnershipDropAddPlace(ir, resourceType, odir.Owned, root)
    let entry = odir.OwnershipDropAddBlock(ir, root)
    odir.OwnershipDropSetEntryBlock(ir, entry)
    let unreachable = odir.OwnershipDropAddBlock(ir, root)
    let opIndex = odir.OwnershipDropAppendInitialize(ir, unreachable, placeId)
    var op = ir.ops[opIndex]
    op.otherPlaceId = placeId
    ir.ops[opIndex] = op
    var analysis: odir.OwnershipDropAnalysis
    odir.OwnershipDropAnalyze(ir, analysis)
    panic("ownership drop smoke: malformed unreachable op accepted")

fn runMalformedUnreachableBlock() =
    var ir: odir.OwnershipDropIr
    odir.OwnershipDropIrInit(ir)
    let root = odir.OwnershipDropRootScopeId(ir)
    let entry = odir.OwnershipDropAddBlock(ir, root)
    odir.OwnershipDropSetEntryBlock(ir, entry)
    let unreachable = odir.OwnershipDropAddBlock(ir, root)
    var block = ir.blocks[unreachable]
    block.opStart = 1
    ir.blocks[unreachable] = block
    var analysis: odir.OwnershipDropAnalysis
    odir.OwnershipDropAnalyze(ir, analysis)
    panic("ownership drop smoke: malformed unreachable block accepted")

fn runUnknownUnreachableEdge() =
    var ir: odir.OwnershipDropIr
    odir.OwnershipDropIrInit(ir)
    let root = odir.OwnershipDropRootScopeId(ir)
    let entry = odir.OwnershipDropAddBlock(ir, root)
    odir.OwnershipDropSetEntryBlock(ir, entry)
    let unreachableFrom = odir.OwnershipDropAddBlock(ir, root)
    let unreachableTo = odir.OwnershipDropAddBlock(ir, root)
    let edgeId = addSameScopeEdge(ir,
                                  unreachableFrom,
                                  unreachableTo,
                                  odir.OwnershipDropEdgeNormal)
    var edge = ir.edges[edgeId]
    edge.kind = odir.OwnershipDropEdgeUnknown
    ir.edges[edgeId] = edge
    var analysis: odir.OwnershipDropAnalysis
    odir.OwnershipDropAnalyze(ir, analysis)
    panic("ownership drop smoke: unknown unreachable edge accepted")

fn runMalformedUnreachableEdge() =
    var ir: odir.OwnershipDropIr
    odir.OwnershipDropIrInit(ir)
    let root = odir.OwnershipDropRootScopeId(ir)
    let entry = odir.OwnershipDropAddBlock(ir, root)
    odir.OwnershipDropSetEntryBlock(ir, entry)
    let unreachableFrom = odir.OwnershipDropAddBlock(ir, root)
    let unreachableTo = odir.OwnershipDropAddBlock(ir, root)
    let edgeId = addSameScopeEdge(ir,
                                  unreachableFrom,
                                  unreachableTo,
                                  odir.OwnershipDropEdgeNormal)
    var edge = ir.edges[edgeId]
    edge.cleanupPlaceStart = 1
    ir.edges[edgeId] = edge
    var analysis: odir.OwnershipDropAnalysis
    odir.OwnershipDropAnalyze(ir, analysis)
    panic("ownership drop smoke: malformed unreachable edge accepted")

fn main(argc: int32, argv: str*): int32 =
    argc
    argv
    cmdline.CaptureCmdLine(argc, argv)
    let mode = cmdline.ParamStr(1)
    if mode == "cleanup-missing":
        runCleanupMissing()
    elif mode == "cleanup-duplicate":
        runCleanupDuplicate()
    elif mode == "terminal-leak":
        runTerminalLeak()
    elif mode == "duplicate-drop":
        runDuplicateDrop()
    elif mode == "var-borrow-escape":
        runVarBorrowEscape()
    elif mode == "var-borrow-alias":
        runVarBorrowAlias()
    elif mode == "var-borrow-owner-read":
        runVarBorrowOwnerRead()
    elif mode == "var-borrow-owner-write":
        runVarBorrowOwnerWrite()
    elif mode == "rc-borrow-owner-write":
        runRcBorrowOwnerWrite()
    elif mode == "overwrite-invalidates-rc":
        runOverwriteInvalidatesRcBorrow()
    elif mode == "rc-return-missing-owner":
        runRcReturnMissingOwner()
    elif mode == "missing-owned-return-authority":
        runMissingOwnedReturnAuthority()
    elif mode == "defer-double-drop":
        runDeferDoubleDrop()
    elif mode == "duplicate-defer":
        runDuplicateDefer()
    elif mode == "defer-inventory-missing":
        runDeferInventoryMissing()
    elif mode == "defer-inventory-order":
        runDeferInventoryOrder()
    elif mode == "positive-conditional-ownership-defer":
        runConditionalOwnershipDefer()
    elif mode == "panic-defer":
        runPanicDefer()
    elif mode == "unknown-defer":
        runUnknownDefer()
    elif mode == "unknown-ownership":
        runUnknownOwnership()
    elif mode == "unknown-type":
        runUnknownType()
    elif mode == "unknown-edge":
        runUnknownEdge()
    elif mode == "unknown-unreachable-op":
        runUnknownUnreachableOp()
    elif mode == "malformed-unreachable-op":
        runMalformedUnreachableOp()
    elif mode == "malformed-unreachable-block":
        runMalformedUnreachableBlock()
    elif mode == "unknown-unreachable-edge":
        runUnknownUnreachableEdge()
    elif mode == "malformed-unreachable-edge":
        runMalformedUnreachableEdge()
    elif mode == "manual-conditional-wrong-row":
        runManualConditionalWrongRow()
    elif mode == "positive-diamond":
        runDiamondConditionalDrop()
    elif mode == "positive-loop":
        runLoopFixedPoint()
        runManualLoopBackedge()
    elif mode == "positive-manual-conditional":
        runManualConditionalJoin()
        runManualLoopBackedge()
    elif mode == "positive-return-terminal":
        runReturnEdgeIsTerminal()
    elif mode == "positive-scopes":
        runStructuredScopeCleanup()
    elif mode == "positive-drop-plans":
        runPartialAndFullDropPlans()
        runConditionalAggregateDrop()
    elif mode == "positive-borrows":
        runBorrowKinds()
    elif mode == "positive-overwrite":
        runExactOwnedReturnAuthority()
        runOverwritePlans()
        runConditionalOverwritePlan()
        runCapturedAggregateOverwritePlan()
    elif mode == "positive-defers":
        runDeferEffects()
        runConditionalOwnershipDefer()
    elif mode == "positive-release":
        runManualConditionalJoin()
        runManualLoopBackedge()
        runPhysicalStorageRelease()
        echo("ownership_drop_release ok alloc_free_live=0")
    elif len(mode) != 0:
        panic("ownership drop smoke: unknown mode")
    else:
        runPositive()
    return 0
