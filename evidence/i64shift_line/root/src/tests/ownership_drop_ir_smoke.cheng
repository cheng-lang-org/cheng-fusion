fn buildVarBorrow(ir: var odir.OwnershipDropIr,
                  outRoot: var int32,
                  outOwner: var int32,
                  outViewA: var int32,
                  outViewB: var int32,
                  outEntry: var int32) =
    odir.OwnershipDropIrInit(ir)
    outRoot = odir.OwnershipDropRootScopeId(ir)
    let ownerType = odir.OwnershipDropRegisterLeafType(ir, "Owner", 77)
    let scalarType = odir.OwnershipDropRegisterLeafType(ir, "int32", 0)
    outOwner = odir.OwnershipDropAddPlace(ir, ownerType, odir.Owned, outRoot)
    outViewA = odir.OwnershipDropAddPlace(ir, scalarType, odir.VarBorrow, outRoot)
    outViewB = odir.OwnershipDropAddPlace(ir, scalarType, odir.VarBorrow, outRoot)
    outEntry = odir.OwnershipDropAddBlock(ir, outRoot)
    odir.OwnershipDropSetEntryBlock(ir, outEntry)
    odir.OwnershipDropAppendInitialize(ir, outEntry, outOwner)
    odir.OwnershipDropAppendVarBorrow(ir, outEntry, outOwner, outViewA, 3)

