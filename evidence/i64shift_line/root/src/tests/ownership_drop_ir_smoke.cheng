import std/cmdline as cmdline
import std/strings as strings
import cheng/core/analysis/ownership_drop_ir as odir

fn smokeAssert(ok: bool, message: str) =
    if !ok:
        panic(message)

fn addSameScopeEdge(ir: var odir.OwnershipDropIr,
                    fromBlock: int32,
                    toBlock: int32,
                    kind: odir.OwnershipDropEdgeKind): int32 =
    var cleanup: int32[]
    var defers: int32[]
    return odir.OwnershipDropAddEdge(ir,
                                     fromBlock,
                                     toBlock,
                                     kind,
                                     -1,
                                     cleanup,
                                     defers)

fn assertAction(action: odir.OwnershipDropCleanupAction,
                kind: odir.OwnershipDropCleanupActionKind,
                actionId: int32,
                placeId: int32,
                fieldOrdinal: int32,
                dropGlueId: int32,
                conditionKind: odir.OwnershipDropConditionKind,
                conditionFlagId: int32) =
    smokeAssert(action.kind == kind, "ownership drop smoke: action kind")
    smokeAssert(action.actionId == actionId, "ownership drop smoke: action id")
    smokeAssert(action.placeId == placeId, "ownership drop smoke: action place")
    smokeAssert(action.fieldOrdinal == fieldOrdinal, "ownership drop smoke: action field")
    smokeAssert(action.dropGlueId == dropGlueId, "ownership drop smoke: action glue")
    smokeAssert(action.conditionKind == conditionKind,
                "ownership drop smoke: action condition")
    smokeAssert(action.conditionFlagId == conditionFlagId,
                "ownership drop smoke: action condition flag")
    smokeAssert(!action.conditionNegated &&
                action.conditionOtherKind == odir.DropConditionAlways &&
                action.conditionOtherFlagId == -1 &&
                !action.conditionOtherNegated,
                "ownership drop smoke: action has unexpected second condition")

fn assertEdgeAction(analysis: var odir.OwnershipDropAnalysis,
                    edgeId: int32,
                    ordinal: int32,
                    kind: odir.OwnershipDropCleanupActionKind,
                    actionId: int32,
                    placeId: int32,
                    fieldOrdinal: int32,
                    dropGlueId: int32,
                    conditionKind: odir.OwnershipDropConditionKind,
                    conditionFlagId: int32) =
    assertAction(odir.OwnershipDropAnalysisEdgeAction(analysis, edgeId, ordinal),
                 kind,
                 actionId,
                 placeId,
                 fieldOrdinal,
                 dropGlueId,
                 conditionKind,
                 conditionFlagId)

fn assertOpAction(analysis: var odir.OwnershipDropAnalysis,
                  opIndex: int32,
                  ordinal: int32,
                  kind: odir.OwnershipDropCleanupActionKind,
                  placeId: int32,
                  fieldOrdinal: int32,
                  dropGlueId: int32) =
    assertAction(odir.OwnershipDropAnalysisOpAction(analysis, opIndex, ordinal),
                 kind,
                 0,
                 placeId,
                 fieldOrdinal,
                 dropGlueId,
                 odir.DropConditionAlways,
                 -1)

@borrows
fn conditionValue(kind: odir.OwnershipDropConditionKind,
                  action: odir.OwnershipDropCleanupAction,
                  wholeInitialized: bool,
                  field0Initialized: bool,
                  field1Initialized: bool): bool =
    if kind == odir.DropConditionAlways:
        return true
    if kind == odir.DropConditionPlaceInitialized ||
       kind == odir.DropConditionCapturedOldPlace:
        return wholeInitialized
    if kind == odir.DropConditionFieldInitialized ||
       kind == odir.DropConditionCapturedOldField:
        if action.fieldOrdinal == 0:
            return field0Initialized
        if action.fieldOrdinal == 1:
            return field1Initialized
    panic("ownership drop smoke: unsupported condition evaluator")
    return false

@borrows
fn actionRunsForAggregate(action: odir.OwnershipDropCleanupAction,
                          wholeInitialized: bool,
                          field0Initialized: bool,
                          field1Initialized: bool): bool =
    var first = conditionValue(action.conditionKind,
                               action,
                               wholeInitialized,
                               field0Initialized,
                               field1Initialized)
    if action.conditionNegated:
        first = !first
    var second = conditionValue(action.conditionOtherKind,
                                action,
                                wholeInitialized,
                                field0Initialized,
                                field1Initialized)
    if action.conditionOtherNegated:
        second = !second
    return first && second

fn analysesEqual(lhs: var odir.OwnershipDropAnalysis,
                 rhs: var odir.OwnershipDropAnalysis): bool =
    if lhs.fixedPointSteps != rhs.fixedPointSteps ||
       lhs.converged != rhs.converged ||
       lhs.cleanupActions.len != rhs.cleanupActions.len ||
       lhs.blockInputs.len != rhs.blockInputs.len ||
       lhs.blockOutputs.len != rhs.blockOutputs.len ||
       lhs.opActionStarts.len != rhs.opActionStarts.len ||
       lhs.edgeActionStarts.len != rhs.edgeActionStarts.len:
        return false
    for i in 0..<lhs.opActionStarts.len:
        if lhs.opActionStarts[i] != rhs.opActionStarts[i] ||
           lhs.opActionCounts[i] != rhs.opActionCounts[i]:
            return false
    for i in 0..<lhs.edgeActionStarts.len:
        if lhs.edgeActionStarts[i] != rhs.edgeActionStarts[i] ||
           lhs.edgeActionCounts[i] != rhs.edgeActionCounts[i]:
            return false
    for i in 0..<lhs.cleanupActions.len:
        let a = lhs.cleanupActions[i]
        let b = rhs.cleanupActions[i]
        if a.edgeId != b.edgeId ||
           a.opIndex != b.opIndex ||
           a.kind != b.kind ||
           a.actionId != b.actionId ||
           a.placeId != b.placeId ||
           a.otherPlaceId != b.otherPlaceId ||
           a.fieldOrdinal != b.fieldOrdinal ||
           a.typeId != b.typeId ||
           a.dropGlueId != b.dropGlueId ||
           a.returnSnapshotGlueId != b.returnSnapshotGlueId ||
           a.returnSnapshotGlueSymbol != b.returnSnapshotGlueSymbol ||
           a.conditionKind != b.conditionKind ||
           a.conditionFlagId != b.conditionFlagId ||
           a.conditionNegated != b.conditionNegated ||
           a.conditionOtherKind != b.conditionOtherKind ||
           a.conditionOtherFlagId != b.conditionOtherFlagId ||
           a.conditionOtherNegated != b.conditionOtherNegated ||
           a.guardDeferId != b.guardDeferId ||
           a.guardDeferNegated != b.guardDeferNegated ||
           a.definitionOriginKind != b.definitionOriginKind ||
           a.definitionOriginId != b.definitionOriginId ||
           a.sourceDefinitionDomain != b.sourceDefinitionDomain ||
           a.sourceDefinitionRow != b.sourceDefinitionRow ||
           a.sourceOwnership != b.sourceOwnership ||
           a.consumeActionRow != b.consumeActionRow:
            return false
    for blockId in 0..<lhs.blockInputs.len:
        let lhsInput = lhs.blockInputs[blockId]
        let rhsInput = rhs.blockInputs[blockId]
        let lhsOutput = lhs.blockOutputs[blockId]
        let rhsOutput = rhs.blockOutputs[blockId]
        if lhsInput.reached != rhsInput.reached ||
           lhsOutput.reached != rhsOutput.reached ||
           lhsInput.placeStateMasks.len != rhsInput.placeStateMasks.len ||
           lhsOutput.placeStateMasks.len != rhsOutput.placeStateMasks.len:
            return false
        for placeIndex in 0..<lhsInput.placeStateMasks.len:
            if lhsInput.placeStateMasks[placeIndex] != rhsInput.placeStateMasks[placeIndex] ||
               lhsInput.placeManagedProducerOpIds[placeIndex] !=
                   rhsInput.placeManagedProducerOpIds[placeIndex] ||
               lhsInput.borrowSourcePlaceIds[placeIndex] != rhsInput.borrowSourcePlaceIds[placeIndex] ||
               lhsInput.borrowProjectionTokens[placeIndex] != rhsInput.borrowProjectionTokens[placeIndex] ||
               lhsInput.escapeMasks[placeIndex] != rhsInput.escapeMasks[placeIndex]:
                return false
        for placeIndex in 0..<lhsOutput.placeStateMasks.len:
            if lhsOutput.placeStateMasks[placeIndex] != rhsOutput.placeStateMasks[placeIndex] ||
               lhsOutput.placeManagedProducerOpIds[placeIndex] !=
                   rhsOutput.placeManagedProducerOpIds[placeIndex] ||
               lhsOutput.borrowSourcePlaceIds[placeIndex] != rhsOutput.borrowSourcePlaceIds[placeIndex] ||
               lhsOutput.borrowProjectionTokens[placeIndex] != rhsOutput.borrowProjectionTokens[placeIndex] ||
               lhsOutput.escapeMasks[placeIndex] != rhsOutput.escapeMasks[placeIndex]:
                return false
        for fieldIndex in 0..<lhsInput.fieldStateMasks.len:
            if lhsInput.fieldStateMasks[fieldIndex] != rhsInput.fieldStateMasks[fieldIndex]:
                return false
        for fieldIndex in 0..<lhsOutput.fieldStateMasks.len:
            if lhsOutput.fieldStateMasks[fieldIndex] != rhsOutput.fieldStateMasks[fieldIndex]:
                return false
        for deferIndex in 0..<lhsInput.deferActiveMasks.len:
            if lhsInput.deferActiveMasks[deferIndex] != rhsInput.deferActiveMasks[deferIndex] ||
               lhsOutput.deferActiveMasks[deferIndex] != rhsOutput.deferActiveMasks[deferIndex]:
                return false
    if lhs.conditionFlags.len != rhs.conditionFlags.len ||
       lhs.flagTransitions.len != rhs.flagTransitions.len:
        return false
    for i in 0..<lhs.conditionFlags.len:
        let a = lhs.conditionFlags[i]
        let b = rhs.conditionFlags[i]
        if a.flagId != b.flagId ||
           a.kind != b.kind ||
           a.placeId != b.placeId ||
           a.fieldOrdinal != b.fieldOrdinal ||
           a.deferId != b.deferId ||
           a.initialValue != b.initialValue:
            return false
    for i in 0..<lhs.flagTransitions.len:
        let a = lhs.flagTransitions[i]
        let b = rhs.flagTransitions[i]
        if a.originKind != b.originKind ||
           a.originId != b.originId ||
           a.flagId != b.flagId ||
           a.setValue != b.setValue ||
           a.afterActions != b.afterActions:
            return false
    return true

fn runDiamondConditionalDrop(): int32 =
    var ir: odir.OwnershipDropIr
    odir.OwnershipDropIrInit(ir)
    let root = odir.OwnershipDropRootScopeId(ir)
    let resourceType = odir.OwnershipDropRegisterLeafType(ir, "DiamondResource", 77)
    let placeId = odir.OwnershipDropAddPlace(ir, resourceType, odir.Owned, root)
    let entry = odir.OwnershipDropAddBlock(ir, root)
    odir.OwnershipDropSetEntryBlock(ir, entry)
    let left = odir.OwnershipDropAddBlock(ir, root)
    let initializeOp = odir.OwnershipDropAppendInitialize(ir, left, placeId)
    let right = odir.OwnershipDropAddBlock(ir, root)
    let join = odir.OwnershipDropAddBlock(ir, root)
    let exitBlock = odir.OwnershipDropAddBlock(ir, root)
    addSameScopeEdge(ir, entry, left, odir.OwnershipDropEdgeNormal)
    addSameScopeEdge(ir, entry, right, odir.OwnershipDropEdgeNormal)
    addSameScopeEdge(ir, left, join, odir.OwnershipDropEdgeNormal)
    addSameScopeEdge(ir, right, join, odir.OwnershipDropEdgeNormal)
    var cleanup: int32[]
    add(cleanup, placeId)
    var defers: int32[]
    let returnEdge = odir.OwnershipDropAddEdge(ir,
                                               join,
                                               exitBlock,
                                               odir.OwnershipDropEdgeReturn,
                                               -1,
                                               cleanup,
                                               defers)
    odir.OwnershipDropFinalize(ir)
    var first: odir.OwnershipDropAnalysis
    odir.OwnershipDropAnalyze(ir, first)
    smokeAssert(first.converged, "ownership drop smoke: diamond converged")
    smokeAssert(odir.OwnershipDropAnalysisInputInitState(first,
                                                        join,
                                                        placeId) == odir.ConditionallyInitialized,
                "ownership drop smoke: diamond conditional init")
    smokeAssert(odir.OwnershipDropAnalysisEdgeActionCount(first, returnEdge) == 1,
                "ownership drop smoke: diamond action count")
    assertEdgeAction(first,
                     returnEdge,
                     0,
                     odir.CleanupActionDropPlace,
                     0,
                     placeId,
                     -1,
                     77,
                     odir.DropConditionPlaceInitialized,
                     placeId)
    let conditionAction = odir.OwnershipDropAnalysisEdgeAction(first, returnEdge, 0)
    let flag = first.conditionFlags[conditionAction.conditionFlagId - 1]
    smokeAssert(flag.kind == odir.ConditionFlagPlaceInitialized &&
                flag.placeId == placeId &&
                !flag.initialValue,
                "ownership drop smoke: stable place flag descriptor")
    var sawSet: bool
    var sawClear: bool
    for i in 0..<first.flagTransitions.len:
        let transition = first.flagTransitions[i]
        if transition.flagId != flag.flagId:
            continue
        if transition.originKind == odir.FlagOriginOp &&
           transition.originId == initializeOp &&
           transition.setValue &&
           transition.afterActions:
            sawSet = true
        if transition.originKind == odir.FlagOriginEdge &&
           transition.originId == returnEdge &&
           !transition.setValue &&
           transition.afterActions:
            sawClear = true
    smokeAssert(sawSet && sawClear,
                "ownership drop smoke: place flag set/clear plan")
    var second: odir.OwnershipDropAnalysis
    odir.OwnershipDropAnalyze(ir, second)
    smokeAssert(analysesEqual(first, second),
                "ownership drop smoke: deterministic replay")
    return first.fixedPointSteps

fn runLoopFixedPoint(): int32 =
    var ir: odir.OwnershipDropIr
    odir.OwnershipDropIrInit(ir)
    let root = odir.OwnershipDropRootScopeId(ir)
    let resourceType = odir.OwnershipDropRegisterLeafType(ir, "LoopResource", 88)
    let placeId = odir.OwnershipDropAddPlace(ir, resourceType, odir.Owned, root)
    let entry = odir.OwnershipDropAddBlock(ir, root)
    odir.OwnershipDropSetEntryBlock(ir, entry)
    let header = odir.OwnershipDropAddBlock(ir, root)
    let body = odir.OwnershipDropAddBlock(ir, root)
    odir.OwnershipDropAppendInitialize(ir, body, placeId)
    odir.OwnershipDropAppendDrop(ir, body, placeId)
    let exitBlock = odir.OwnershipDropAddBlock(ir, root)
    addSameScopeEdge(ir, entry, header, odir.OwnershipDropEdgeNormal)
    addSameScopeEdge(ir, header, body, odir.OwnershipDropEdgeNormal)
    addSameScopeEdge(ir, body, header, odir.OwnershipDropEdgeLoopBack)
    var cleanup: int32[]
    add(cleanup, placeId)
    var defers: int32[]
    odir.OwnershipDropAddEdge(ir,
                              header,
                              exitBlock,
                              odir.OwnershipDropEdgeReturn,
                              -1,
                              cleanup,
                              defers)
    var analysis: odir.OwnershipDropAnalysis
    odir.OwnershipDropAnalyze(ir, analysis)
    smokeAssert(analysis.converged, "ownership drop smoke: loop converged")
    smokeAssert(analysis.fixedPointSteps > ir.blocks.len,
                "ownership drop smoke: loop required requeue")
    smokeAssert(odir.OwnershipDropAnalysisInputInitState(analysis,
                                                        header,
                                                        placeId) == odir.Uninitialized,
                "ownership drop smoke: loop lattice closed state")
    return analysis.fixedPointSteps

fn runReturnEdgeIsTerminal() =
    var ir: odir.OwnershipDropIr
    odir.OwnershipDropIrInit(ir)
    let root = odir.OwnershipDropRootScopeId(ir)
    let resourceType =
        odir.OwnershipDropRegisterLeafType(ir, "ReturnTerminal", 89)
    let placeId =
        odir.OwnershipDropAddPlace(ir, resourceType, odir.Owned, root)
    let entry = odir.OwnershipDropAddBlock(ir, root)
    odir.OwnershipDropSetEntryBlock(ir, entry)
    let continuation = odir.OwnershipDropAddBlock(ir, root)
    odir.OwnershipDropAppendUseRead(ir, continuation, placeId)
    var cleanup: int32[]
    add(cleanup, placeId)
    var defers: int32[]
    let returnEdge = odir.OwnershipDropAddEdge(
        ir,
        entry,
        continuation,
        odir.OwnershipDropEdgeReturn,
        -1,
        cleanup,
        defers)
    var analysis: odir.OwnershipDropAnalysis
    odir.OwnershipDropAnalyze(ir, analysis)
    smokeAssert(analysis.converged &&
                !analysis.blockInputs[continuation].reached &&
                odir.OwnershipDropAnalysisEdgeActionCount(
                    analysis,
                    returnEdge) == 0,
                "ownership drop smoke: return edge reached continuation")

fn runStructuredScopeCleanup() =
    var ir: odir.OwnershipDropIr
    odir.OwnershipDropIrInit(ir)
    let root = odir.OwnershipDropRootScopeId(ir)
    let child = odir.OwnershipDropAddScope(ir, root)
    let resourceType = odir.OwnershipDropRegisterLeafType(ir, "ScopedResource", 73)
    let outerPlace = odir.OwnershipDropAddPlace(ir,
                                                resourceType,
                                                odir.Owned,
                                                root)
    let innerPlace = odir.OwnershipDropAddPlace(ir,
                                                resourceType,
                                                odir.Owned,
                                                child)
    let entry = odir.OwnershipDropAddBlock(ir, root)
    odir.OwnershipDropSetEntryBlock(ir, entry)
    odir.OwnershipDropAppendInitialize(ir, entry, outerPlace)
    let childBlock = odir.OwnershipDropAddBlock(ir, child)
    odir.OwnershipDropAppendInitialize(ir, childBlock, innerPlace)
    let afterBreak = odir.OwnershipDropAddBlock(ir, root)
    let exitBlock = odir.OwnershipDropAddBlock(ir, root)
    addSameScopeEdge(ir, entry, childBlock, odir.OwnershipDropEdgeNormal)
    var breakCleanup: int32[]
    add(breakCleanup, innerPlace)
    var breakDefers: int32[]
    let breakEdge = odir.OwnershipDropAddEdge(ir,
                                              childBlock,
                                              afterBreak,
                                              odir.OwnershipDropEdgeBreak,
                                              -1,
                                              breakCleanup,
                                              breakDefers)
    var returnCleanup: int32[]
    add(returnCleanup, outerPlace)
    var returnDefers: int32[]
    let returnEdge = odir.OwnershipDropAddEdge(ir,
                                               afterBreak,
                                               exitBlock,
                                               odir.OwnershipDropEdgeReturn,
                                               -1,
                                               returnCleanup,
                                               returnDefers)
    var analysis: odir.OwnershipDropAnalysis
    odir.OwnershipDropAnalyze(ir, analysis)
    smokeAssert(odir.OwnershipDropAnalysisEdgeActionCount(analysis,
                                                         breakEdge) == 1,
                "ownership drop smoke: child scope cleanup")
    assertEdgeAction(analysis,
                     breakEdge,
                     0,
                     odir.CleanupActionDropPlace,
                     0,
                     innerPlace,
                     -1,
                     73,
                     odir.DropConditionAlways,
                     -1)
    smokeAssert(odir.OwnershipDropAnalysisEdgeActionCount(analysis,
                                                         returnEdge) == 1,
                "ownership drop smoke: root scope cleanup")
    assertEdgeAction(analysis,
                     returnEdge,
                     0,
                     odir.CleanupActionDropPlace,
                     0,
                     outerPlace,
                     -1,
                     73,
                     odir.DropConditionAlways,
                     -1)

fn registerAggregate(ir: var odir.OwnershipDropIr,
                     outResourceA: var int32,
                     outResourceB: var int32): int32 =
    outResourceA = odir.OwnershipDropRegisterLeafType(ir, "ResourceA", 101)
    outResourceB = odir.OwnershipDropRegisterLeafType(ir, "ResourceB", 102)
    var fields: int32[]
    add(fields, outResourceA)
    add(fields, outResourceB)
    return odir.OwnershipDropRegisterAggregateType(ir, "Aggregate", 200, fields)

fn runPartialAndFullDropPlans() =
    var partialIr: odir.OwnershipDropIr
    odir.OwnershipDropIrInit(partialIr)
    let partialRoot = odir.OwnershipDropRootScopeId(partialIr)
    var resourceA: int32
    var resourceB: int32
    let aggregateType = registerAggregate(partialIr, resourceA, resourceB)
    let partialPlace = odir.OwnershipDropAddPlace(partialIr,
                                                  aggregateType,
                                                  odir.Owned,
                                                  partialRoot)
    let partialEntry = odir.OwnershipDropAddBlock(partialIr, partialRoot)
    odir.OwnershipDropSetEntryBlock(partialIr, partialEntry)
    odir.OwnershipDropAppendInitializeField(partialIr, partialEntry, partialPlace, 0)
    let partialDropOp = odir.OwnershipDropAppendDrop(partialIr,
                                                     partialEntry,
                                                     partialPlace)
    let partialExit = odir.OwnershipDropAddBlock(partialIr, partialRoot)
    var partialCleanup: int32[]
    add(partialCleanup, partialPlace)
    var partialDefers: int32[]
    let partialReturn = odir.OwnershipDropAddEdge(partialIr,
                                                  partialEntry,
                                                  partialExit,
                                                  odir.OwnershipDropEdgeReturn,
                                                  -1,
                                                  partialCleanup,
                                                  partialDefers)
    var partialAnalysis: odir.OwnershipDropAnalysis
    odir.OwnershipDropAnalyze(partialIr, partialAnalysis)
    smokeAssert(odir.OwnershipDropAnalysisOpActionCount(partialAnalysis,
                                                        partialDropOp) == 1,
                "ownership drop smoke: partial plan action count")
    assertOpAction(partialAnalysis,
                   partialDropOp,
                   0,
                   odir.CleanupActionDropField,
                   partialPlace,
                   0,
                   101)
    smokeAssert(odir.OwnershipDropAnalysisEdgeActionCount(partialAnalysis,
                                                         partialReturn) == 0,
                "ownership drop smoke: partial cleanup no double drop")

    var fullIr: odir.OwnershipDropIr
    odir.OwnershipDropIrInit(fullIr)
    let fullRoot = odir.OwnershipDropRootScopeId(fullIr)
    var fullResourceA: int32
    var fullResourceB: int32
    let fullAggregateType = registerAggregate(fullIr, fullResourceA, fullResourceB)
    let fullPlace = odir.OwnershipDropAddPlace(fullIr,
                                               fullAggregateType,
                                               odir.Owned,
                                               fullRoot)
    let fullEntry = odir.OwnershipDropAddBlock(fullIr, fullRoot)
    odir.OwnershipDropSetEntryBlock(fullIr, fullEntry)
    odir.OwnershipDropAppendInitializeField(fullIr, fullEntry, fullPlace, 0)
    odir.OwnershipDropAppendInitializeField(fullIr, fullEntry, fullPlace, 1)
    let fullExit = odir.OwnershipDropAddBlock(fullIr, fullRoot)
    var fullCleanup: int32[]
    add(fullCleanup, fullPlace)
    var fullDefers: int32[]
    let fullReturn = odir.OwnershipDropAddEdge(fullIr,
                                               fullEntry,
                                               fullExit,
                                               odir.OwnershipDropEdgeReturn,
                                               -1,
                                               fullCleanup,
                                               fullDefers)
    var fullAnalysis: odir.OwnershipDropAnalysis
    odir.OwnershipDropAnalyze(fullIr, fullAnalysis)
    smokeAssert(odir.OwnershipDropAnalysisEdgeActionCount(fullAnalysis,
                                                         fullReturn) == 1,
                "ownership drop smoke: full aggregate one glue")
    assertEdgeAction(fullAnalysis,
                     fullReturn,
                     0,
                     odir.CleanupActionDropPlace,
                     0,
                     fullPlace,
                     -1,
                     200,
                     odir.DropConditionAlways,
                     -1)

fn runConditionalAggregateDrop() =
    var ir: odir.OwnershipDropIr
    odir.OwnershipDropIrInit(ir)
    let root = odir.OwnershipDropRootScopeId(ir)
    var resourceA: int32
    var resourceB: int32
    let aggregateType = registerAggregate(ir, resourceA, resourceB)
    let placeId = odir.OwnershipDropAddPlace(ir, aggregateType, odir.Owned, root)
    let entry = odir.OwnershipDropAddBlock(ir, root)
    odir.OwnershipDropSetEntryBlock(ir, entry)
    let left = odir.OwnershipDropAddBlock(ir, root)
    odir.OwnershipDropAppendInitializeField(ir, left, placeId, 0)
    let right = odir.OwnershipDropAddBlock(ir, root)
    let join = odir.OwnershipDropAddBlock(ir, root)
    odir.OwnershipDropAppendInitializeField(ir, join, placeId, 1)
    let exitBlock = odir.OwnershipDropAddBlock(ir, root)
    addSameScopeEdge(ir, entry, left, odir.OwnershipDropEdgeNormal)
    addSameScopeEdge(ir, entry, right, odir.OwnershipDropEdgeNormal)
    addSameScopeEdge(ir, left, join, odir.OwnershipDropEdgeNormal)
    addSameScopeEdge(ir, right, join, odir.OwnershipDropEdgeNormal)
    var cleanup: int32[]
    add(cleanup, placeId)
    var defers: int32[]
    let returnEdge = odir.OwnershipDropAddEdge(ir,
                                               join,
                                               exitBlock,
                                               odir.OwnershipDropEdgeReturn,
                                               -1,
                                               cleanup,
                                               defers)
    var analysis: odir.OwnershipDropAnalysis
    odir.OwnershipDropAnalyze(ir, analysis)
    smokeAssert(odir.OwnershipDropAnalysisOutputInitState(analysis,
                                                         join,
                                                         placeId) == odir.ConditionallyInitialized,
                "ownership drop smoke: conditional aggregate state")
    smokeAssert(odir.OwnershipDropAnalysisEdgeActionCount(analysis,
                                                         returnEdge) == 3,
                "ownership drop smoke: full-partial exclusive plan")
    let wholeDrop = odir.OwnershipDropAnalysisEdgeAction(analysis, returnEdge, 0)
    let field1Drop = odir.OwnershipDropAnalysisEdgeAction(analysis, returnEdge, 1)
    let field0Drop = odir.OwnershipDropAnalysisEdgeAction(analysis, returnEdge, 2)
    smokeAssert(wholeDrop.kind == odir.CleanupActionDropPlace &&
                wholeDrop.dropGlueId == 200 &&
                wholeDrop.conditionKind == odir.DropConditionPlaceInitialized &&
                wholeDrop.conditionFlagId > 0 &&
                !wholeDrop.conditionNegated,
                "ownership drop smoke: conditional whole aggregate glue")
    smokeAssert(field1Drop.kind == odir.CleanupActionDropField &&
                field1Drop.fieldOrdinal == 1 &&
                field1Drop.dropGlueId == 102 &&
                field1Drop.conditionKind == odir.DropConditionAlways &&
                field1Drop.conditionOtherKind == odir.DropConditionPlaceInitialized &&
                field1Drop.conditionOtherFlagId == wholeDrop.conditionFlagId &&
                field1Drop.conditionOtherNegated,
                "ownership drop smoke: field1 and not whole")
    smokeAssert(field0Drop.kind == odir.CleanupActionDropField &&
                field0Drop.fieldOrdinal == 0 &&
                field0Drop.dropGlueId == 101 &&
                field0Drop.conditionKind == odir.DropConditionFieldInitialized &&
                field0Drop.conditionFlagId > ir.places.len &&
                field0Drop.conditionOtherKind == odir.DropConditionPlaceInitialized &&
                field0Drop.conditionOtherFlagId == wholeDrop.conditionFlagId &&
                field0Drop.conditionOtherNegated,
                "ownership drop smoke: field0 and not whole")
    let wholeFlag = odir.OwnershipDropAnalysisConditionFlag(analysis,
                                                            wholeDrop.conditionFlagId)
    let field0Flag = odir.OwnershipDropAnalysisConditionFlag(analysis,
                                                             field0Drop.conditionFlagId)
    smokeAssert(wholeFlag.kind == odir.ConditionFlagPlaceInitialized &&
                wholeFlag.placeId == placeId &&
                field0Flag.kind == odir.ConditionFlagFieldInitialized &&
                field0Flag.placeId == placeId &&
                field0Flag.fieldOrdinal == 0,
                "ownership drop smoke: dual condition IDs resolve exactly")
    smokeAssert(actionRunsForAggregate(wholeDrop, true, true, true) &&
                !actionRunsForAggregate(field1Drop, true, true, true) &&
                !actionRunsForAggregate(field0Drop, true, true, true),
                "ownership drop smoke: full path runs only whole glue")
    smokeAssert(!actionRunsForAggregate(wholeDrop, false, false, true) &&
                actionRunsForAggregate(field1Drop, false, false, true) &&
                !actionRunsForAggregate(field0Drop, false, false, true),
                "ownership drop smoke: partial path runs initialized fields only")

fn runBorrowKinds() =
    var rcIr: odir.OwnershipDropIr
    odir.OwnershipDropIrInit(rcIr)
    let rcRoot = odir.OwnershipDropRootScopeId(rcIr)
    let resourceType = odir.OwnershipDropRegisterLeafType(rcIr, "RcResource", 77)
    let owner = odir.OwnershipDropAddPlace(rcIr, resourceType, odir.Owned, rcRoot)
    let view = odir.OwnershipDropAddPlace(rcIr,
                                         resourceType,
                                         odir.RcBorrowedValue,
                                         rcRoot)
    let entry = odir.OwnershipDropAddBlock(rcIr, rcRoot)
    odir.OwnershipDropSetEntryBlock(rcIr, entry)
    odir.OwnershipDropAppendInitialize(rcIr, entry, owner)
    odir.OwnershipDropAppendRcBorrow(rcIr, entry, owner, view)
    odir.OwnershipDropAppendUseRead(rcIr, entry, owner)
    odir.OwnershipDropAppendUseRead(rcIr, entry, view)
    let exitBlock = odir.OwnershipDropAddBlock(rcIr, rcRoot)
    var cleanup: int32[]
    add(cleanup, owner)
    add(cleanup, view)
    var defers: int32[]
    let returnEdge = odir.OwnershipDropAddEdge(rcIr,
                                               entry,
                                               exitBlock,
                                               odir.OwnershipDropEdgeReturn,
                                               view,
                                               cleanup,
                                               defers)
    var rcAnalysis: odir.OwnershipDropAnalysis
    odir.OwnershipDropAnalyze(rcIr, rcAnalysis)
    smokeAssert(odir.OwnershipDropAnalysisEdgeActionCount(rcAnalysis,
                                                         returnEdge) == 2,
                "ownership drop smoke: RC borrowed return actions")
    assertEdgeAction(rcAnalysis,
                     returnEdge,
                     0,
                     odir.CleanupActionRetainRcBorrowedReturn,
                     0,
                     view,
                     -1,
                     0,
                     odir.DropConditionAlways,
                     -1)

    assertEdgeAction(rcAnalysis,
                     returnEdge,
                     1,
                     odir.CleanupActionDropPlace,
                     0,
                     owner,
                     -1,
                     77,
                     odir.DropConditionAlways,
                     -1)
    smokeAssert(odir.OwnershipDropAnalysisInputBorrowCount(rcIr,
                                                          rcAnalysis,
                                                          exitBlock,
                                                          owner) == 0,
                "ownership drop smoke: RC loan closed")

    var varIr: odir.OwnershipDropIr
    odir.OwnershipDropIrInit(varIr)
    let varRoot = odir.OwnershipDropRootScopeId(varIr)
    let ownerType = odir.OwnershipDropRegisterLeafType(varIr, "VarOwner", 91)
    let scalarType = odir.OwnershipDropRegisterLeafType(varIr, "int32", 0)
    let varOwner = odir.OwnershipDropAddPlace(varIr, ownerType, odir.Owned, varRoot)
    let scalarView = odir.OwnershipDropAddPlace(varIr,
                                                scalarType,
                                                odir.VarBorrow,
                                                varRoot)
    let varEntry = odir.OwnershipDropAddBlock(varIr, varRoot)
    odir.OwnershipDropSetEntryBlock(varIr, varEntry)
    odir.OwnershipDropAppendInitialize(varIr, varEntry, varOwner)
    odir.OwnershipDropAppendVarBorrow(varIr,
                                      varEntry,
                                      varOwner,
                                      scalarView,
                                      7)
    odir.OwnershipDropAppendUseRead(varIr, varEntry, scalarView)
    odir.OwnershipDropAppendUseWrite(varIr, varEntry, scalarView)
    let endBorrowBlock = odir.OwnershipDropAddBlock(varIr, varRoot)
    odir.OwnershipDropAppendEndVarBorrow(varIr, endBorrowBlock, scalarView)
    let varExit = odir.OwnershipDropAddBlock(varIr, varRoot)
    addSameScopeEdge(varIr,
                     varEntry,
                     endBorrowBlock,
                     odir.OwnershipDropEdgeNormal)
    var varCleanup: int32[]
    add(varCleanup, varOwner)
    add(varCleanup, scalarView)
    var varDefers: int32[]
    let varReturn = odir.OwnershipDropAddEdge(varIr,
                                              endBorrowBlock,
                                              varExit,
                                              odir.OwnershipDropEdgeReturn,
                                              -1,
                                              varCleanup,
                                              varDefers)
    var varAnalysis: odir.OwnershipDropAnalysis
    odir.OwnershipDropAnalyze(varIr, varAnalysis)
    smokeAssert(varAnalysis.blockInputs[endBorrowBlock].borrowProjectionTokens[scalarView - 1] == 7,
                "ownership drop smoke: var projection token")
    smokeAssert(odir.OwnershipDropAnalysisEdgeActionCount(varAnalysis,
                                                         varReturn) == 1,
                "ownership drop smoke: var borrow is not retained")
    assertEdgeAction(varAnalysis,
                     varReturn,
                     0,
                     odir.CleanupActionDropPlace,
                     0,
                     varOwner,
                     -1,
                     91,
                     odir.DropConditionAlways,
                     -1)

fn runExactOwnedReturnAuthority() =
    var ir: odir.OwnershipDropIr
    odir.OwnershipDropIrInit(ir)
    let root = odir.OwnershipDropRootScopeId(ir)
    let resourceType =
        odir.OwnershipDropRegisterLeafType(ir, "ExactReturn", 911)
    odir.OwnershipDropSetTypeReturnSnapshotPolicy(
        ir,
        resourceType,
        odir.ReturnSnapshotRetain,
        1911,
        "exact_return_retain")
    let value = odir.OwnershipDropAddPlace(
        ir, resourceType, odir.Owned, root)
    let entry = odir.OwnershipDropAddBlock(ir, root)
    odir.OwnershipDropSetEntryBlock(ir, entry)
    odir.OwnershipDropAppendInitialize(ir, entry, value)
    let exitBlock = odir.OwnershipDropAddBlock(ir, root)
    var cleanupIds: int32[]
    add(cleanupIds, value)
    var deferIds: int32[]
    let edgeId = odir.OwnershipDropAddEdge(
        ir,
        entry,
        exitBlock,
        odir.OwnershipDropEdgeReturn,
        value,
        cleanupIds,
        deferIds)
    odir.OwnershipDropBindReturnDefinitionAuthority(
        ir,
        edgeId,
        7101,
        7102,
        odir.Owned,
        odir.OwnershipDropDefinitionDomainBodyOp,
        8101)
    var analysis: odir.OwnershipDropAnalysis
    odir.OwnershipDropAnalyze(ir, analysis)
    let action = odir.OwnershipDropAnalysisEdgeAction(
        analysis, edgeId, 0)
    let projection = odir.OwnershipDropProjectReturnSnapshot(
        ir, analysis, action)
    smokeAssert(projection.kind == odir.ReturnSnapshotRetain &&
                projection.resultExprNodeIndex == 7101 &&
                projection.resultValueDefinitionRow == 7102 &&
                projection.resultOwnership == odir.Owned &&
                projection.sourceDefinitionDomain ==
                    odir.OwnershipDropDefinitionDomainBodyOp &&
                projection.sourceDefinitionRow == 8101 &&
                action.definitionOriginKind ==
                    odir.DefinitionOriginTypedExpr &&
                action.definitionOriginId == 7102 &&
                action.sourceDefinitionDomain ==
                    odir.OwnershipDropDefinitionDomainBodyOp &&
                action.sourceDefinitionRow == 8101,
                "ownership drop smoke: exact owned return authority")

fn runMissingOwnedReturnAuthority() =
    var ir: odir.OwnershipDropIr
    odir.OwnershipDropIrInit(ir)
    let root = odir.OwnershipDropRootScopeId(ir)
    let resourceType =
        odir.OwnershipDropRegisterLeafType(ir, "MissingReturnAuthority", 912)
    odir.OwnershipDropSetTypeReturnSnapshotPolicy(
        ir,
        resourceType,
        odir.ReturnSnapshotRetain,
        1912,
        "missing_return_authority_retain")
    let value = odir.OwnershipDropAddPlace(
        ir, resourceType, odir.Owned, root)
    let entry = odir.OwnershipDropAddBlock(ir, root)
    odir.OwnershipDropSetEntryBlock(ir, entry)
    odir.OwnershipDropAppendInitialize(ir, entry, value)
    let exitBlock = odir.OwnershipDropAddBlock(ir, root)
    var cleanupIds: int32[]
    add(cleanupIds, value)
    var deferIds: int32[]
    let _ = odir.OwnershipDropAddEdge(
        ir,
