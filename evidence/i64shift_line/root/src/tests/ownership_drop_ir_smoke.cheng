    panic("ownership drop smoke: missing owned return authority accepted")

fn runOverwritePlans() =
    var ir: odir.OwnershipDropIr
    odir.OwnershipDropIrInit(ir)
    let root = odir.OwnershipDropRootScopeId(ir)
    let resourceType = odir.OwnershipDropRegisterLeafType(ir, "OverwriteResource", 94)
    let target = odir.OwnershipDropAddPlace(ir, resourceType, odir.Owned, root)
    let source = odir.OwnershipDropAddPlace(ir, resourceType, odir.Owned, root)
    let view = odir.OwnershipDropAddPlace(ir,
                                         resourceType,
                                         odir.RcBorrowedValue,
                                         root)
    let entry = odir.OwnershipDropAddBlock(ir, root)
    odir.OwnershipDropSetEntryBlock(ir, entry)
    odir.OwnershipDropAppendInitialize(ir, entry, target)
    odir.OwnershipDropAppendRcBorrow(ir, entry, target, view)
    let selfOp = odir.OwnershipDropAppendRetainedAssign(ir, entry, target, target)
    odir.OwnershipDropBindOpDefinitionAuthority(
        ir,
        selfOp,
        odir.DefinitionOriginTypedExpr,
        7001,
        odir.OwnershipDropDefinitionDomainBodyOp,
        8001,
        odir.Owned)
    let aliasOp = odir.OwnershipDropAppendRetainedAssign(ir, entry, target, view)
    odir.OwnershipDropBindOpDefinitionAuthority(
        ir,
        aliasOp,
        odir.DefinitionOriginTypedExpr,
        7002,
        odir.OwnershipDropDefinitionDomainBodyOp,
        8002,
        odir.RcBorrowedValue)
    odir.OwnershipDropAppendEndRcBorrow(ir, entry, view)
    odir.OwnershipDropAppendInitialize(ir, entry, source)
    let moveOverwriteOp = odir.OwnershipDropAppendMove(ir, entry, source, target)
    odir.OwnershipDropBindOpDefinitionAuthority(
        ir,
        moveOverwriteOp,
        odir.DefinitionOriginTypedExpr,
        7003,
        odir.OwnershipDropDefinitionDomainBodyOp,
        8003,
        odir.Owned)
    let exitBlock = odir.OwnershipDropAddBlock(ir, root)
    var cleanup: int32[]
    add(cleanup, target)
    add(cleanup, source)
    add(cleanup, view)
    var defers: int32[]
    odir.OwnershipDropAddEdge(ir,
                              entry,
                              exitBlock,
                              odir.OwnershipDropEdgeReturn,
                              -1,
                              cleanup,
                              defers)
    var analysis: odir.OwnershipDropAnalysis
    odir.OwnershipDropAnalyze(ir, analysis)
    smokeAssert(odir.OwnershipDropAnalysisOpActionCount(analysis, selfOp) == 3,
                "ownership drop smoke: self retained overwrite plan")
    let selfRetain = odir.OwnershipDropAnalysisOpAction(analysis, selfOp, 0)
    let selfStore = odir.OwnershipDropAnalysisOpAction(analysis, selfOp, 1)
    let selfDrop = odir.OwnershipDropAnalysisOpAction(analysis, selfOp, 2)
    smokeAssert(selfRetain.kind == odir.CleanupActionRetainValue &&
                selfRetain.placeId == target &&
                selfRetain.otherPlaceId == target &&
                selfRetain.definitionOriginKind ==
                    odir.DefinitionOriginTypedExpr &&
                selfRetain.definitionOriginId == 7001 &&
                selfRetain.sourceDefinitionDomain ==
                    odir.OwnershipDropDefinitionDomainBodyOp &&
                selfRetain.sourceDefinitionRow == 8001 &&
                selfRetain.sourceOwnership == odir.Owned &&
                selfRetain.consumeActionRow == -1,
                "ownership drop smoke: self retain first")
    smokeAssert(selfStore.definitionOriginKind ==
                    odir.DefinitionOriginTypedExpr &&
                selfStore.definitionOriginId == 7001 &&
                selfStore.sourceDefinitionDomain ==
                    odir.OwnershipDropDefinitionDomainBodyOp &&
                selfStore.sourceDefinitionRow == 8001 &&
                selfStore.sourceOwnership == odir.Owned &&
                selfStore.consumeActionRow == -1 &&
                selfDrop.definitionOriginKind ==
                    odir.DefinitionOriginCanonicalSyntheticAction &&
                selfDrop.definitionOriginId == selfDrop.consumeActionRow &&
                selfDrop.sourceDefinitionDomain ==
                    0 &&
                selfDrop.sourceDefinitionRow == -1 &&
                selfDrop.sourceOwnership == odir.Owned,
                "ownership drop smoke: retained authority chain")
    smokeAssert(selfStore.kind == odir.CleanupActionStoreOwned &&
                selfStore.actionId == selfOp + 1,
                "ownership drop smoke: self store second")
    smokeAssert(selfDrop.kind == odir.CleanupActionDropPlace &&
                selfDrop.actionId == selfOp + 1 &&
                selfDrop.dropGlueId == 94,
                "ownership drop smoke: self old-value drop third")
    smokeAssert(odir.OwnershipDropAnalysisOpActionCount(analysis, aliasOp) == 3,
                "ownership drop smoke: borrowed alias overwrite plan")
    let aliasRetain = odir.OwnershipDropAnalysisOpAction(analysis, aliasOp, 0)
    let aliasStore = odir.OwnershipDropAnalysisOpAction(analysis, aliasOp, 1)
    let aliasDrop = odir.OwnershipDropAnalysisOpAction(analysis, aliasOp, 2)
    smokeAssert(aliasRetain.kind == odir.CleanupActionRetainValue &&
                aliasRetain.placeId == view &&
                aliasRetain.otherPlaceId == target,
                "ownership drop smoke: borrowed alias retain first")
    smokeAssert(aliasStore.kind == odir.CleanupActionStoreOwned &&
                aliasStore.actionId == aliasOp + 1,
                "ownership drop smoke: borrowed alias store second")
    smokeAssert(aliasDrop.kind == odir.CleanupActionDropPlace &&
                aliasDrop.actionId == aliasOp + 1,
                "ownership drop smoke: borrowed alias drop old third")
    smokeAssert(odir.OwnershipDropAnalysisOpActionCount(analysis,
                                                       moveOverwriteOp) == 2,
                "ownership drop smoke: move overwrite plan")
    smokeAssert(odir.OwnershipDropAnalysisOpAction(analysis,
                                                  moveOverwriteOp,
                                                  0).kind == odir.CleanupActionDropPlace,
                "ownership drop smoke: move overwrite drops old")
    let moveStore = odir.OwnershipDropAnalysisOpAction(analysis,
                                                       moveOverwriteOp,
                                                       1)
    smokeAssert(moveStore.kind == odir.CleanupActionStoreMove &&
                moveStore.placeId == target &&
                moveStore.otherPlaceId == source,
                "ownership drop smoke: move overwrite stores source")

fn runConditionalOverwritePlan() =
    var ir: odir.OwnershipDropIr
    odir.OwnershipDropIrInit(ir)
    let root = odir.OwnershipDropRootScopeId(ir)
    let resourceType = odir.OwnershipDropRegisterLeafType(ir,
                                                          "ConditionalOverwrite",
                                                          95)
    let source = odir.OwnershipDropAddPlace(ir, resourceType, odir.Owned, root)
    let target = odir.OwnershipDropAddPlace(ir, resourceType, odir.Owned, root)
    let entry = odir.OwnershipDropAddBlock(ir, root)
    odir.OwnershipDropSetEntryBlock(ir, entry)
    odir.OwnershipDropAppendInitialize(ir, entry, source)
    let left = odir.OwnershipDropAddBlock(ir, root)
    odir.OwnershipDropAppendInitialize(ir, left, target)
    let right = odir.OwnershipDropAddBlock(ir, root)
    let join = odir.OwnershipDropAddBlock(ir, root)
    let overwriteOp = odir.OwnershipDropAppendRetainedAssign(ir,
                                                              join,
                                                              target,
                                                              source)
    let exitBlock = odir.OwnershipDropAddBlock(ir, root)
    addSameScopeEdge(ir, entry, left, odir.OwnershipDropEdgeNormal)
    addSameScopeEdge(ir, entry, right, odir.OwnershipDropEdgeNormal)
    addSameScopeEdge(ir, left, join, odir.OwnershipDropEdgeNormal)
    addSameScopeEdge(ir, right, join, odir.OwnershipDropEdgeNormal)
    var cleanup: int32[]
    add(cleanup, source)
    add(cleanup, target)
    var defers: int32[]
    odir.OwnershipDropAddEdge(ir,
                              join,
                              exitBlock,
                              odir.OwnershipDropEdgeReturn,
                              -1,
                              cleanup,
                              defers)
    var analysis: odir.OwnershipDropAnalysis
    odir.OwnershipDropAnalyze(ir, analysis)
    smokeAssert(odir.OwnershipDropAnalysisOpActionCount(analysis,
                                                       overwriteOp) == 3,
                "ownership drop smoke: conditional overwrite plan")
    let oldDrop = odir.OwnershipDropAnalysisOpAction(analysis, overwriteOp, 2)
    smokeAssert(oldDrop.kind == odir.CleanupActionDropPlace &&
                oldDrop.actionId == overwriteOp + 1 &&
                oldDrop.conditionKind == odir.DropConditionCapturedOldPlace &&
                oldDrop.conditionFlagId == overwriteOp + 1,
                "ownership drop smoke: captured old condition")
    var sawTargetSet: bool
    for i in 0..<analysis.flagTransitions.len:
        let transition = analysis.flagTransitions[i]
        if transition.originKind == odir.FlagOriginOp &&
           transition.originId == overwriteOp &&
           transition.setValue &&
           transition.afterActions &&
           analysis.conditionFlags[transition.flagId - 1].placeId == target:
            sawTargetSet = true
    smokeAssert(sawTargetSet,
                "ownership drop smoke: overwrite flag transition after actions")

fn runCapturedAggregateOverwritePlan() =
    var ir: odir.OwnershipDropIr
    odir.OwnershipDropIrInit(ir)
    let root = odir.OwnershipDropRootScopeId(ir)
    var resourceA: int32
    var resourceB: int32
    let aggregateType = registerAggregate(ir, resourceA, resourceB)
    let source = odir.OwnershipDropAddPlace(ir, aggregateType, odir.Owned, root)
    let target = odir.OwnershipDropAddPlace(ir, aggregateType, odir.Owned, root)
    let entry = odir.OwnershipDropAddBlock(ir, root)
    odir.OwnershipDropSetEntryBlock(ir, entry)
    odir.OwnershipDropAppendInitialize(ir, entry, source)
    let fullBranch = odir.OwnershipDropAddBlock(ir, root)
    odir.OwnershipDropAppendInitializeField(ir, fullBranch, target, 0)
    odir.OwnershipDropAppendInitializeField(ir, fullBranch, target, 1)
    let partialBranch = odir.OwnershipDropAddBlock(ir, root)
    odir.OwnershipDropAppendInitializeField(ir, partialBranch, target, 0)
    let join = odir.OwnershipDropAddBlock(ir, root)
    let overwriteOp = odir.OwnershipDropAppendRetainedAssign(ir,
                                                              join,
                                                              target,
                                                              source)
    let exitBlock = odir.OwnershipDropAddBlock(ir, root)
    addSameScopeEdge(ir, entry, fullBranch, odir.OwnershipDropEdgeNormal)
    addSameScopeEdge(ir, entry, partialBranch, odir.OwnershipDropEdgeNormal)
    addSameScopeEdge(ir, fullBranch, join, odir.OwnershipDropEdgeNormal)
    addSameScopeEdge(ir, partialBranch, join, odir.OwnershipDropEdgeNormal)
    var cleanup: int32[]
    add(cleanup, source)
    add(cleanup, target)
    var defers: int32[]
    odir.OwnershipDropAddEdge(ir,
                              join,
                              exitBlock,
                              odir.OwnershipDropEdgeReturn,
                              -1,
                              cleanup,
                              defers)
    var analysis: odir.OwnershipDropAnalysis
    odir.OwnershipDropAnalyze(ir, analysis)
    smokeAssert(odir.OwnershipDropAnalysisOpActionCount(analysis,
                                                       overwriteOp) == 5,
                "ownership drop smoke: captured aggregate overwrite plan")
    let wholeDrop = odir.OwnershipDropAnalysisOpAction(analysis, overwriteOp, 2)
    let field1Drop = odir.OwnershipDropAnalysisOpAction(analysis, overwriteOp, 3)
    let field0Drop = odir.OwnershipDropAnalysisOpAction(analysis, overwriteOp, 4)
    smokeAssert(wholeDrop.kind == odir.CleanupActionDropPlace &&
                wholeDrop.dropGlueId == 200 &&
                wholeDrop.conditionKind == odir.DropConditionCapturedOldPlace &&
                wholeDrop.conditionFlagId == overwriteOp + 1,
                "ownership drop smoke: captured whole aggregate glue")
    smokeAssert(field1Drop.kind == odir.CleanupActionDropField &&
                field1Drop.conditionKind == odir.DropConditionCapturedOldField &&
                field1Drop.conditionOtherKind == odir.DropConditionCapturedOldPlace &&
                field1Drop.conditionOtherNegated &&
                field1Drop.conditionFlagId == overwriteOp + 1 &&
                field1Drop.conditionOtherFlagId == overwriteOp + 1,
                "ownership drop smoke: captured field1 and not whole")
    smokeAssert(field0Drop.kind == odir.CleanupActionDropField &&
                field0Drop.conditionKind == odir.DropConditionAlways &&
                field0Drop.conditionOtherKind == odir.DropConditionCapturedOldPlace &&
                field0Drop.conditionOtherNegated,
                "ownership drop smoke: captured field0 and not whole")
    smokeAssert(actionRunsForAggregate(wholeDrop, true, true, true) &&
                !actionRunsForAggregate(field1Drop, true, true, true) &&
                !actionRunsForAggregate(field0Drop, true, true, true),
                "ownership drop smoke: captured full runs only whole glue")
    smokeAssert(!actionRunsForAggregate(wholeDrop, false, true, false) &&
                !actionRunsForAggregate(field1Drop, false, true, false) &&
                actionRunsForAggregate(field0Drop, false, true, false),
                "ownership drop smoke: captured partial runs initialized fields")

fn runConditionalDeferEffect() =
    var ir: odir.OwnershipDropIr
    odir.OwnershipDropIrInit(ir)
    let root = odir.OwnershipDropRootScopeId(ir)
    let neutral = odir.OwnershipDropRegisterDeferEffect(ir,
                                                        root,
                                                        odir.DeferEffectNoOwnership,
                                                        -1,
                                                        -1)
    let entry = odir.OwnershipDropAddBlock(ir, root)
    odir.OwnershipDropSetEntryBlock(ir, entry)
    let left = odir.OwnershipDropAddBlock(ir, root)
    odir.OwnershipDropAppendActivateDefer(ir, left, neutral)
    let right = odir.OwnershipDropAddBlock(ir, root)
    let join = odir.OwnershipDropAddBlock(ir, root)
    let exitBlock = odir.OwnershipDropAddBlock(ir, root)
    addSameScopeEdge(ir, entry, left, odir.OwnershipDropEdgeNormal)
    addSameScopeEdge(ir, entry, right, odir.OwnershipDropEdgeNormal)
    addSameScopeEdge(ir, left, join, odir.OwnershipDropEdgeNormal)
    addSameScopeEdge(ir, right, join, odir.OwnershipDropEdgeNormal)
    var cleanup: int32[]
    var defers: int32[]
    add(defers, neutral)
    let returnEdge = odir.OwnershipDropAddEdge(ir,
                                               join,
                                               exitBlock,
                                               odir.OwnershipDropEdgeReturn,
                                               -1,
                                               cleanup,
                                               defers)
    var analysis: odir.OwnershipDropAnalysis
    odir.OwnershipDropAnalyze(ir, analysis)
    smokeAssert(odir.OwnershipDropAnalysisEdgeActionCount(analysis,
                                                         returnEdge) == 1,
                "ownership drop smoke: conditional defer action")
    let action = odir.OwnershipDropAnalysisEdgeAction(analysis, returnEdge, 0)
    smokeAssert(action.kind == odir.CleanupActionDefer &&
                action.actionId == neutral &&
                action.conditionKind == odir.DropConditionDeferActive &&
                action.conditionFlagId > 0,
                "ownership drop smoke: conditional defer flag")

fn runDeferEffects() =
    var ir: odir.OwnershipDropIr
    odir.OwnershipDropIrInit(ir)
    let root = odir.OwnershipDropRootScopeId(ir)
    let resourceType = odir.OwnershipDropRegisterLeafType(ir, "DeferredResource", 66)
    let placeId = odir.OwnershipDropAddPlace(ir, resourceType, odir.Owned, root)
    let entry = odir.OwnershipDropAddBlock(ir, root)
    odir.OwnershipDropSetEntryBlock(ir, entry)
    odir.OwnershipDropAppendInitialize(ir, entry, placeId)
    let neutral = odir.OwnershipDropRegisterDeferEffect(ir,
                                                        root,
                                                        odir.DeferEffectNoOwnership,
                                                        -1,
                                                        -1)
    let drop = odir.OwnershipDropRegisterDeferEffect(ir,
                                                     root,
                                                     odir.DeferEffectDropPlace,
                                                     placeId,
                                                     -1)
    let readCapture = odir.OwnershipDropRegisterDeferEffect(ir,
                                                            root,
                                                            odir.DeferEffectUseRead,
                                                            placeId,
                                                            -1)
    odir.OwnershipDropAppendActivateDefer(ir, entry, neutral)
    let dropActivateOp = odir.OwnershipDropAppendActivateDefer(ir, entry, drop)
    odir.OwnershipDropAppendActivateDefer(ir, entry, readCapture)
    let exitBlock = odir.OwnershipDropAddBlock(ir, root)
    var cleanup: int32[]
    add(cleanup, placeId)
    var defers: int32[]
    add(defers, readCapture)
    add(defers, drop)
    add(defers, neutral)
    let returnEdge = odir.OwnershipDropAddEdge(ir,
                                               entry,
                                               exitBlock,
                                               odir.OwnershipDropEdgeReturn,
                                               -1,
                                               cleanup,
                                               defers)
    var analysis: odir.OwnershipDropAnalysis
    odir.OwnershipDropAnalyze(ir, analysis)
    smokeAssert(odir.OwnershipDropAnalysisEdgeActionCount(analysis,
                                                         returnEdge) == 4,
                "ownership drop smoke: defer action count")
    assertEdgeAction(analysis,
                     returnEdge,
                     0,
                     odir.CleanupActionDefer,
                     readCapture,
                     -1,
                     -1,
                     0,
                     odir.DropConditionAlways,
                     -1)
    assertEdgeAction(analysis,
                     returnEdge,
                     1,
                     odir.CleanupActionDefer,
                     drop,
                     -1,
                     -1,
                     0,
                     odir.DropConditionAlways,
                     -1)
    runConditionalDeferEffect()
    var dropFlagId = -1
    for i in 0..<analysis.conditionFlags.len:
        if analysis.conditionFlags[i].kind == odir.ConditionFlagDeferActive &&
           analysis.conditionFlags[i].deferId == drop:
            dropFlagId = analysis.conditionFlags[i].flagId
    smokeAssert(dropFlagId > 0, "ownership drop smoke: defer flag descriptor")
    var sawDeferSet: bool
    var sawDeferClear: bool
    for i in 0..<analysis.flagTransitions.len:
        let transition = analysis.flagTransitions[i]
        if transition.flagId != dropFlagId:
            continue
        if transition.originKind == odir.FlagOriginOp &&
           transition.originId == dropActivateOp &&
           transition.setValue &&
           transition.afterActions:
            sawDeferSet = true
        if transition.originKind == odir.FlagOriginEdge &&
           transition.originId == returnEdge &&
           !transition.setValue &&
           transition.afterActions:
            sawDeferClear = true
    smokeAssert(sawDeferSet && sawDeferClear,
                "ownership drop smoke: defer flag set/clear plan")
    assertEdgeAction(analysis,
                     returnEdge,
                     2,
                     odir.CleanupActionDropPlace,
                     0,
                     placeId,
                     -1,
                     66,
                     odir.DropConditionAlways,
                     -1)
    assertEdgeAction(analysis,
                     returnEdge,
                     3,
                     odir.CleanupActionDefer,
                     neutral,
                     -1,
                     -1,
                     0,
                     odir.DropConditionAlways,
                     -1)

fn assertPhysicalReleaseReceipt(
        receipt: var odir.OwnershipDropStorageReleaseReceipt,
        expectedOwnedSoaColumnCount: int32,
        requireManagedString: bool,
        requireManagedStringPhysicalFree: bool) =
    smokeAssert(
        odir.OwnershipDropStorageReleaseReceiptClosed(
            receipt, expectedOwnedSoaColumnCount),
        "ownership drop smoke: release receipt did not close")
    smokeAssert(
        receipt.releasedOwnedSoaColumnCount ==
            expectedOwnedSoaColumnCount &&
        receipt.releasedSequenceInstanceCount >=
            expectedOwnedSoaColumnCount &&
        receipt.sequenceAllocCount > 0 &&
        receipt.sequenceAllocCount == receipt.sequenceFreeCount &&
        receipt.sequenceLiveCount == 0 &&
        receipt.releasedSequenceBytes > int64(0) &&
        receipt.liveSequenceBytes == int64(0) &&
        receipt.managedStringPhysicalFreeCount <=
            receipt.managedStringOwnedReleaseCount &&
        receipt.managedStringLiveReferenceCount == 0,
        "ownership drop smoke: alloc/free/live receipt mismatch")
    if requireManagedString:
        smokeAssert(
            receipt.releasedManagedStringValueCount > 0 &&
            receipt.releasedManagedStringBytes > int64(0),
            "ownership drop smoke: managed string release missing")
    if requireManagedStringPhysicalFree:
        smokeAssert(
            receipt.managedStringOwnedReleaseCount > 0 &&
            receipt.managedStringPhysicalFreeCount > 0,
            "ownership drop smoke: managed string physical free missing")

fn runPhysicalStorageRelease() =
    var ir: odir.OwnershipDropIr
    odir.OwnershipDropIrInit(ir)
    let root = odir.OwnershipDropRootScopeId(ir)
    # The IR rows must own their managed strings outright: Fmt yields a
    # non-owned view (flags=0), so the physical-free receipt only counts
    # when the fixture hands the register helpers an explicit owned clone.
    # The row stores are ownership moves, so the later accessor check must
    # compare against an independent copy, not the moved-from local.
    let expectedGlueSymbol =
        strings.CloneStr(Fmt"release_resource_retain_{root}")
    let resourceName = strings.CloneStr(Fmt"ReleaseResource{root}")
    let resourceType =
        odir.OwnershipDropRegisterLeafType(ir, resourceName, 177)
    let snapshotGlueSymbol = strings.CloneStr(expectedGlueSymbol)
    odir.OwnershipDropSetTypeReturnSnapshotPolicy(
        ir,
        resourceType,
        odir.ReturnSnapshotRetain,
        277,
        snapshotGlueSymbol)
    let value =
        odir.OwnershipDropAddPlace(ir, resourceType, odir.Owned, root)
    let entry = odir.OwnershipDropAddBlock(ir, root)
    odir.OwnershipDropSetEntryBlock(ir, entry)
    odir.OwnershipDropAppendInitialize(ir, entry, value)
    let exitBlock = odir.OwnershipDropAddBlock(ir, root)
    var cleanupIds: int32[]
    add(cleanupIds, value)
    var deferIds: int32[]
    let returnEdge = odir.OwnershipDropAddEdge(
        ir,
        entry,
        exitBlock,
        odir.OwnershipDropEdgeReturn,
        value,
        cleanupIds,
        deferIds)
    odir.OwnershipDropBindReturnDefinitionAuthority(
        ir,
        returnEdge,
        9101,
        9102,
        odir.Owned,
        odir.OwnershipDropDefinitionDomainBodyOp,
        9103)
    var analysis: odir.OwnershipDropAnalysis
    odir.OwnershipDropAnalyze(ir, analysis)
    smokeAssert(
        analysis.converged &&
        odir.OwnershipDropAnalysisEdgeActionCount(
            analysis, returnEdge) > 0,
        "ownership drop smoke: release fixture analysis missing")
    let retainedAction =
        odir.OwnershipDropAnalysisEdgeAction(analysis, returnEdge, 0)
    let retainedFlag =
        odir.OwnershipDropAnalysisConditionFlag(analysis, 1)
    let transitionCount =
        odir.OwnershipDropAnalysisFlagTransitionCount(analysis)
    smokeAssert(
        transitionCount > 0,
        "ownership drop smoke: release fixture transition missing")
    let retainedTransition =
        odir.OwnershipDropAnalysisFlagTransition(analysis, 0)
    var analysisReceipt: odir.OwnershipDropStorageReleaseReceipt
    odir.OwnershipDropAnalysisRelease(analysis, analysisReceipt)
    assertPhysicalReleaseReceipt(
        analysisReceipt,
        odir.OwnershipDropAnalysisOwnedSoaColumnCount(),
        true,
        false)
    smokeAssert(
        odir.OwnershipDropAnalysisStorageReleased(analysis),
        "ownership drop smoke: analysis header not released")
    var irReceipt: odir.OwnershipDropStorageReleaseReceipt
    odir.OwnershipDropIrRelease(ir, irReceipt)
    assertPhysicalReleaseReceipt(
        irReceipt,
        odir.OwnershipDropIrOwnedSoaColumnCount(),
        true,
        true)
    smokeAssert(
        odir.OwnershipDropIrStorageReleased(ir),
        "ownership drop smoke: ir header not released")
    smokeAssert(
        retainedAction.returnSnapshotGlueSymbol == expectedGlueSymbol &&
        retainedAction.returnSnapshotGlueId == 277 &&
        retainedFlag.flagId == 1 &&
        retainedFlag.kind == odir.ConditionFlagPlaceInitialized &&
        retainedTransition.flagId > 0,
        "ownership drop smoke: accessor result did not outlive owner release")

fn runPositive() =
    let diamondSteps = runDiamondConditionalDrop()
    let loopSteps = runLoopFixedPoint()
    runReturnEdgeIsTerminal()
    runStructuredScopeCleanup()
    runPartialAndFullDropPlans()
    runConditionalAggregateDrop()
    runBorrowKinds()
    runOverwritePlans()
    runConditionalOverwritePlan()
    runCapturedAggregateOverwritePlan()
    runDeferEffects()
    runConditionalOwnershipDefer()
    runPhysicalStorageRelease()
    smokeAssert(diamondSteps > 0 && loopSteps > 0,
                "ownership drop smoke: fixed-point step count")
    echo("ownership_drop_ir ok deterministic=1")

fn newOwnedResource(ir: var odir.OwnershipDropIr,
                    outRoot: var int32,
                    outPlace: var int32,
                    outEntry: var int32) =
    odir.OwnershipDropIrInit(ir)
    outRoot = odir.OwnershipDropRootScopeId(ir)
    let resourceType = odir.OwnershipDropRegisterLeafType(ir, "Resource", 77)
    outPlace = odir.OwnershipDropAddPlace(ir, resourceType, odir.Owned, outRoot)
    outEntry = odir.OwnershipDropAddBlock(ir, outRoot)
    odir.OwnershipDropSetEntryBlock(ir, outEntry)

