# Joint angle limit probe: a skeletal joint limit is a distance band between
# the bones it connects, so a knee is hip-ankle ConDistMax + ConDistMin over
# the existing two-body constraint table (no new columns, no CID change).
#   case 1 ConDistMax: the leg hangs slightly bent at 0.69 m (inside the
#     0.7 m limit, all constraints satisfied at t=0); gravity opens the bend
#     and the max limit catches it: final distance in [0.60, 0.72] m and the
#     last second stays <= 0.72 m. (A straight 1.0 m start would enter the
#     solve 0.3 m outside the limit; the PBD velocity update converts that
#     first-tick projection into an unphysical inward kick, and a deep-fold
#     release whips past the boundary into the solver's tuck attractor, so
#     the release starts just inside the limit like a servo-taught joint.)
#   case 2 ConDistMin: steady upward pull on the ankle folds the chain toward
#     the hip; the 0.3 m min limit props it open, final distance in
#     [0.28, 0.36] m and never crushed below 0.28 m
import cheng/game/world3d
import cheng/game/physics3d
import cheng/game/csg/numerics
import std/math as m
import std/strings as strings

fn fmtMm(x: float64): str =
    let scaled: int32 = int32(m.roundFloat(x * 1000.0))
    var neg: bool = scaled < 0
    var mag: int32 = scaled
    if neg:
        mag = 0 - mag
    let intPart: int32 = mag / 1000
    let fracPart: int32 = mag % 1000
    var outStr: str = ""
    if neg:
        outStr = "-"
    outStr = outStr + strings.IntToStr(intPart) + "." + strings.CloneStrRange(strings.IntToStr(fracPart + 1000), 1, 3)
    return outStr

# case 1: hip static at (0, 0, 2), leg hanging slightly bent below it: knee
# (0.361902, 0, 1.655), ankle (0, 0, 1.31) — both 0.5 m joints satisfied,
# hip-ankle 0.69 m just inside the 0.7 m limit. Gravity opens the bend and
# the ConDistMax catches the opening at millimetre penetration, then holds
# the press at 0.7 m. Everything stays above the z=0 ground plane.
fn caseDistMax(): bool =
    var w: world3d.World3d
    World3dReset(w, int64(21))
    let hip = World3dSpawnBody(w, 0.0, 0.0, 2.0, 0.0, 0.02, world3d.World3dBodyStatic)
    let knee = World3dSpawnBody(w, 0.361902, 0.0, 1.655, 1.0, 0.02, world3d.World3dBodyDynamic)
    let ankle = World3dSpawnBody(w, 0.0, 0.0, 1.31, 1.0, 0.02, world3d.World3dBodyDynamic)
    let _c1 = World3dAddConstraint(w, hip, knee, 0.5, world3d.World3dConJoint)
    let _c2 = World3dAddConstraint(w, knee, ankle, 0.5, world3d.World3dConJoint)
    let _c3 = World3dAddConstraint(w, hip, ankle, 0.7, world3d.World3dConDistMax)
    var i: int32 = 0
    var d: float64 = 0.69
    var lateMax: float64 = 0.0
    while i < 960:
        var r = physics3d.Physics3dStep(w, "case:distmax")
        if r.statusCode != physics3d.Physics3dStatusOk:
            echo("FAIL distmax step rejected at i=" + strings.IntToStr(i) + " resid_mm=" + fmtMm(r.maxResidualMm))
            return false
        let dx = w.bodyPx[ankle] - w.bodyPx[hip]
        let dy = w.bodyPy[ankle] - w.bodyPy[hip]
        let dz = w.bodyPz[ankle] - w.bodyPz[hip]
        d = numerics.CsgSqrt(dx * dx + dy * dy + dz * dz)
        if i >= 720:
            if d > lateMax:
                lateMax = d
        i = i + 1
    echo("case distmax final_hip_ankle_m=" + fmtMm(d) + " last1s_max_m=" + fmtMm(lateMax))
    if d > 0.72:
        return false
    if d < 0.60:
        return false
    if lateMax > 0.72:
        return false
    return true

# case 2: same chain pre-bent in the x-z plane below a hip at (0, 0, 2)
# (knee off the hip-ankle line, all constraints satisfied at t=0); a steady
# 40 N controller pull on the ankle aimed at the hip folds it toward the hip
# and the 0.3 m ConDistMin props it open.
fn caseDistMin(): bool =
    var w: world3d.World3d
    World3dReset(w, int64(22))
    let hip = World3dSpawnBody(w, 0.0, 0.0, 2.0, 0.0, 0.02, world3d.World3dBodyStatic)
    let knee = World3dSpawnBody(w, 0.3, 0.0, 1.6, 1.0, 0.02, world3d.World3dBodyDynamic)
    let ankle = World3dSpawnBody(w, 0.6, 0.0, 1.2, 1.0, 0.02, world3d.World3dBodyDynamic)
    let _c1 = World3dAddConstraint(w, hip, knee, 0.5, world3d.World3dConJoint)
    let _c2 = World3dAddConstraint(w, knee, ankle, 0.5, world3d.World3dConJoint)
    let _c3 = World3dAddConstraint(w, hip, ankle, 0.3, world3d.World3dConDistMin)
    var i: int32 = 0
    var minD: float64 = 2.0
    var d: float64 = 1.0
    while i < 720:
        let gdx = w.bodyPx[hip] - w.bodyPx[ankle]
        let gdy = w.bodyPy[hip] - w.bodyPy[ankle]
        let gdz = w.bodyPz[hip] - w.bodyPz[ankle]
        let gn = numerics.CsgSqrt(gdx * gdx + gdy * gdy + gdz * gdz)
        physics3d.Physics3dAddForce(w, ankle, 40.0 * gdx / gn, 40.0 * gdy / gn, 40.0 * gdz / gn)
        var r = physics3d.Physics3dStep(w, "case:distmin")
        if r.statusCode != physics3d.Physics3dStatusOk:
            echo("FAIL distmin step rejected at i=" + strings.IntToStr(i) + " resid_mm=" + fmtMm(r.maxResidualMm))
            return false
        let dx = w.bodyPx[ankle] - w.bodyPx[hip]
        let dy = w.bodyPy[ankle] - w.bodyPy[hip]
        let dz = w.bodyPz[ankle] - w.bodyPz[hip]
        d = numerics.CsgSqrt(dx * dx + dy * dy + dz * dz)
        if d < minD:
            minD = d
        i = i + 1
    echo("case distmin final_hip_ankle_m=" + fmtMm(d) + " min_hip_ankle_m=" + fmtMm(minD))
    if d > 0.36:
        return false
    if d < 0.28:
        return false
    if minD < 0.25:
        return false
    return true

fn main(): int32 =
    if !caseDistMax():
        echo("FAIL caseDistMax")
        return 1
    if !caseDistMin():
        echo("FAIL caseDistMin")
        return 1
    echo("PASS phys limit probe")
    return 0
