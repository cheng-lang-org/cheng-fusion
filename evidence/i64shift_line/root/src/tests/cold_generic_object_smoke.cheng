module cold_generic_object_smoke
import std/result

type Res[T] =
    ok: bool
    value: T

fn identity[T](x: T): T =
    return x

fn makeOk[T](value: T): Res[T] =
    var out: Res[T]
    out.ok = true
    out.value = value
    return out

fn main(): int32 =
    let v = identity(42)
    if v != 42:
        return 1
    let r = makeOk[int32](42)
    if !r.ok:
        return 2
    if r.value != 42:
        return 3
    var s: result.Result[int32]
    s.ok = true
    s.value = 99
    if !s.ok:
        return 4
    if s.value != 99:
        return 5
    return 0

main()
