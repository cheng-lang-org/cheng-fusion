# T87 sret var-assign guard
# Tests that `var p: T; p = mk()` sets up x8 sret correctly on the caller side.
# This fixture is designed to catch the pure-frontend path where Assign statements
# with aggregate/string RHS fall through to the text path and miss sret setup.

type Pair = object
    a: int32
    b: int32

fn makePair(): Pair =
    return Pair{a: 40, b: 2}

fn makePairArg(x: int32): Pair =
    return Pair{a: x, b: 2}

fn makeStr(): str =
    return "hello"

fn varAssignAggregate(): int32 =
    var p: Pair
    p = makePair()
    if p.a != 40:
        return 1
    if p.b != 2:
        return 2
    return 0

fn varAssignAggregateWithArg(): int32 =
    var p: Pair
    p = makePairArg(7)
    if p.a != 7:
        return 3
    if p.b != 2:
        return 4
    return 0

fn varAssignString(): int32 =
    var s: str
    s = makeStr()
    if s.len != 5:
        return 5
    return 0

fn main(): int32 =
    let r1 = varAssignAggregate()
    if r1 != 0:
        return r1
    let r2 = varAssignAggregateWithArg()
    if r2 != 0:
        return r2
    let r3 = varAssignString()
    if r3 != 0:
        return r3
    return 0
