import std/system as system
import std/strings

type
    ColdManagedExactValuePayload =
        name: str
        tags: str[]

    ColdManagedExactFieldOwner = ref object
        payload: ColdManagedExactValuePayload

fn ColdManagedExactRefObjectFieldExercise(): int32 =
    let allocBefore = system.memAllocCount()
    let freeBefore = system.memFreeCount()
    let liveBefore = system.memLiveCount()
    let retainBefore = system.memRetainCount()
    let releaseBefore = system.memReleaseCount()

    var owner = new(ColdManagedExactFieldOwner)
    owner.payload.name = system.NewStringCopy(
        system.StrDataPtr("owner-name"), "owner-name".len)
    var tag = system.NewStringCopy(
        system.StrDataPtr("owner-tag"), "owner-tag".len)
    add(owner.payload.tags, tag)
    if owner.payload.name != "owner-name" ||
       owner.payload.tags.len != 1 ||
       owner.payload.tags[0] != "owner-tag":
        return 1

    owner = nil
    let allocDelta = system.memAllocCount() - allocBefore
    let freeDelta = system.memFreeCount() - freeBefore
    let retainDelta = system.memRetainCount() - retainBefore
    let releaseDelta = system.memReleaseCount() - releaseBefore
    if allocDelta <= int64(0) || allocDelta != freeDelta:
        echo(strings.ConcatStr(
            "cold_managed_exact_ref_object_field_alloc_delta=",
            strings.Int64ToStr(allocDelta)))
        echo(strings.ConcatStr(
            "cold_managed_exact_ref_object_field_free_delta=",
            strings.Int64ToStr(freeDelta)))
        echo(strings.ConcatStr(
            "cold_managed_exact_ref_object_field_retain_delta=",
            strings.Int64ToStr(retainDelta)))
        echo(strings.ConcatStr(
            "cold_managed_exact_ref_object_field_release_delta=",
            strings.Int64ToStr(releaseDelta)))
        return 2
    if system.memLiveCount() != liveBefore:
        return 3
    if retainDelta != int64(0):
        return 4
    if releaseDelta != freeDelta:
        return 5
    return 0

fn main(): int32 =
    let result = ColdManagedExactRefObjectFieldExercise()
    if result != 0:
        return result
    echo("cold_managed_exact_ref_object_field=PASS")
    return 0
