import std/system
import std/result
import std/rawbytes
import std/crypto/chacha20poly1305 as aead

const
    rfcKey = "808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f"
    rfcNonce = "070000004041424344454647"
    rfcAad = "50515253c0c1c2c3c4c5c6c7"
    rfcPlain = "4c616469657320616e642047656e746c656d656e206f662074686520636c617373206f66202739393a204966204920636f756c64206f6666657220796f75206f6e6c79206f6e652074697020666f7220746865206675747572652c2073756e73637265656e20776f756c642062652069742e"
    rfcCipher = "d31a8d34648e60db7b86afbc53ef7ec2a4aded51296e08fea9e2b5a736ee62d63dbea45e8ca9671282fafb69da92728b1a71de0a9e060b2905d6a5b67ecd3b3692ddbd7f2d778b8c9803aee328091b58fab324e4fad675945585808b4831d7bc3ff4def08e4b7a9de576d26586cec64b6116"
    rfcTag = "1ae10b594f09e26a7e902ecbd0600691"

fn hexVal(c: int32): int32 =
    if c >= 48 && c <= 57:
        return c - 48
    if c >= 97 && c <= 102:
        return c - 87
    if c >= 65 && c <= 70:
        return c - 55
    Assert(false, "hexToBytes: invalid hex character")
    return 0

fn hexToBytes(s: str): Bytes =
    let raw: Bytes = BytesFromString(s)
    let n: int32 = BytesLen(raw)
    Assert(n % 2 == 0, "hexToBytes: odd length")
    let out: Bytes = BytesAlloc(n / 2)
    for i in 0..<(n / 2):
        BytesSet(out, i, hexVal(BytesGet(raw, 2 * i)) * 16 + hexVal(BytesGet(raw, 2 * i + 1)))
    return out

fn BytesEqual(a: Bytes, b: Bytes): bool =
    if BytesLen(a) != BytesLen(b):
        return false
    for i in 0..<BytesLen(a):
        if BytesGet(a, i) != BytesGet(b, i):
            return false
    return true

fn main(): int32 =
    let keyBytes: Bytes = hexToBytes(rfcKey)
    let nonceBytes: Bytes = hexToBytes(rfcNonce)
    let aad: Bytes = hexToBytes(rfcAad)
    let plain: Bytes = hexToBytes(rfcPlain)
    let expectedCipher: Bytes = hexToBytes(rfcCipher)
    let expectedTag: Bytes = hexToBytes(rfcTag)

    let keyRes: Result[aead.ChaChaPolyKey] = aead.intoChaChaPolyKey(keyBytes)
    if IsErr(keyRes):
        echo(ErrorText(keyRes))
        return 1
    let nonceRes: Result[aead.ChaChaPolyNonce] = aead.intoChaChaPolyNonce(nonceBytes)
    if IsErr(nonceRes):
        echo(ErrorText(nonceRes))
        return 1

    let key: aead.ChaChaPolyKey = Value(keyRes)
    let nonce: aead.ChaChaPolyNonce = Value(nonceRes)
    var tag: aead.ChaChaPolyTag
    let encRes: Result[bool] = aead.encrypt(key, nonce, tag, plain, aad)
    if IsErr(encRes):
        echo(ErrorText(encRes))
        return 1
    if ! BytesEqual(plain, expectedCipher):
        echo("chacha20poly1305_rfc8439_smoke cipher mismatch")
        return 1
    if ! BytesEqual(tag.data, expectedTag):
        echo("chacha20poly1305_rfc8439_smoke tag mismatch")
        return 1

    let decRes: Result[bool] = aead.decrypt(key, nonce, tag, plain, aad)
    if IsErr(decRes):
        echo(ErrorText(decRes))
        return 1
    let expectedPlain: Bytes = hexToBytes(rfcPlain)
    if ! BytesEqual(plain, expectedPlain):
        echo("chacha20poly1305_rfc8439_smoke decrypt mismatch")
        return 1

    echo("chacha20poly1305_rfc8439_smoke ok")
    return 0
