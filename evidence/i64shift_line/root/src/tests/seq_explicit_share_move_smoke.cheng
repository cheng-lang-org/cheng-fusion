import std/system
import std/seqs as seqs

fn main(): int32 =
    var shared: str[]
    add(shared, "left")
    add(shared, "right")
    if memRefCount(shared.buffer) != 1:
        return 1

    var alias: str[] = share(shared)
    if alias.buffer != shared.buffer ||
       memRefCount(shared.buffer) != 2:
        return 2
    seqs.freeSeqStrRelease(shared)
    if shared.len != 0 || shared.cap != 0 || shared.buffer != nil:
        return 3
    if alias.len != 2 || alias[0] != "left" || alias[1] != "right" ||
       memRefCount(alias.buffer) != 1:
        return 4
    seqs.freeSeqStrRelease(alias)
    if alias.len != 0 || alias.cap != 0 || alias.buffer != nil:
        return 5

    var source: int32[]
    add(source, 7)
    add(source, 11)
    var moved: int32[] = source
    if moved.len != 2 || moved[0] != 7 || moved[1] != 11:
        return 6
    source = []
    add(source, 13)
    if source.len != 1 || source[0] != 13:
        return 7
    seqs.chengSeqFreeTyped[int32](moved)
    if moved.len != 0 || moved.cap != 0 || moved.buffer != nil:
        return 8
    seqs.chengSeqFreeTyped[int32](source)
    if source.len != 0 || source.cap != 0 || source.buffer != nil:
        return 9
    return 0
