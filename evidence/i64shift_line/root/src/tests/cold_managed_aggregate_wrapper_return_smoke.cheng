import std/os as os
import std/strings

type
    ManagedAggregateWrapper =
        ok: bool
        text: str
        errors: str[]

    ManagedLiteralRow =
        text: str
        marker: int32

fn managedAggregateBase(): ManagedAggregateWrapper =
    var out: ManagedAggregateWrapper
    out.ok = true
    out.text = "base"
    add(out.errors, "first")
    return out

fn managedAggregateWrapper(): ManagedAggregateWrapper =
    var out = managedAggregateBase()
    if out.ok:
        add(out.errors, "second")
    return out

fn main(): int32 =
    let value = managedAggregateWrapper()
    if !value.ok ||
       value.text != "base" ||
       value.errors.len != 2:
        return 1
    var row: ManagedLiteralRow
    row.text = strings.CloneStr("literal-owned")
    row.marker = 73
    let rows = [row]
    if rows.len != 1:
        return 2
    if row.text != "literal-owned" || row.marker != 73:
        return 3
    os.WriteLine(
        os.Get_stdout(),
        "cold_managed_aggregate_wrapper_return_smoke ok")
    return 0
