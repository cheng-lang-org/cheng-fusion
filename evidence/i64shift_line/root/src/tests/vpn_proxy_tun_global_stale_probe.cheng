import std/rawbytes as rawbytes
import cheng/apps/vpn_proxy/vpn_proxy_tun_dataplane as tun
import cheng/apps/vpn_proxy/vpn_proxy_tun_policy as tunpolicy

fn validTcpChecksum(packet: rawbytes.Bytes): bool =
    let tcpLen: int32 = rawbytes.BytesLen(packet) - 20
    let sum: int64 = tun.VpnTunPseudoHeaderChecksum(packet, tun.VpnTunProtoTcp, tcpLen) +
                     tun.VpnTunChecksumBytes(packet, 20, tcpLen)
    return tun.VpnTunChecksumFold(sum) == 0

fn main(): int32 =
    var runtime: tun.VpnTunRuntime
    tun.VpnTunInitRuntime(runtime)
    tun.VpnTunSetRouteMode(runtime, tunpolicy.VpnProxyTunRouteModeGlobal)

    # client 192.168.43.66:41234 -> stale fake 198.18.123.210:443, seq=1000, SYN
    var syn: rawbytes.Bytes = rawbytes.BytesAlloc(40)
    rawbytes.BytesSet(syn, 0, 69)
    rawbytes.BytesSet(syn, 2, 0)
    rawbytes.BytesSet(syn, 3, 40)
    rawbytes.BytesSet(syn, 8, 64)
    rawbytes.BytesSet(syn, 9, 6)
    rawbytes.BytesSet(syn, 12, 192)
    rawbytes.BytesSet(syn, 13, 168)
    rawbytes.BytesSet(syn, 14, 43)
    rawbytes.BytesSet(syn, 15, 66)
    rawbytes.BytesSet(syn, 16, 198)
    rawbytes.BytesSet(syn, 17, 18)
    rawbytes.BytesSet(syn, 18, 123)
    rawbytes.BytesSet(syn, 19, 210)
    rawbytes.BytesSet(syn, 20, 161)
    rawbytes.BytesSet(syn, 21, 18)
    rawbytes.BytesSet(syn, 22, 1)
    rawbytes.BytesSet(syn, 23, 187)
    rawbytes.BytesSet(syn, 24, 0)
    rawbytes.BytesSet(syn, 25, 0)
    rawbytes.BytesSet(syn, 26, 3)
    rawbytes.BytesSet(syn, 27, 232)
    rawbytes.BytesSet(syn, 32, 80)
    rawbytes.BytesSet(syn, 33, 2)

    var decision: tun.VpnTunPacketDecision
    if !tun.VpnTunDecidePacket(runtime, syn, "", decision):
        echo("probe fail: decide false")
        return 1
    echo("decide action=")
    echo(IntToStr(decision.action))
    echo("transport=")
    echo(IntToStr(decision.transport))
    echo("sessions=")
    echo(IntToStr(tun.VpnTunSessionsCount()))

    let synAck: rawbytes.Bytes = tun.VpnTunBuildTcpSynAck(runtime, syn)
    echo("synack len=")
    echo(IntToStr(rawbytes.BytesLen(synAck)))
    var parsedSa: tun.VpnTunIpv4Packet
    if !tun.VpnTunParseIpv4(synAck, parsedSa):
        echo("probe fail: synack unparseable")
        return 1
    echo("sa flags=")
    echo(IntToStr(parsedSa.tcpFlags))
    echo("sa seq=")
    echo(IntToStr(parsedSa.tcpSeq))
    echo("sa ack=")
    echo(IntToStr(parsedSa.tcpAck))
    if validTcpChecksum(synAck):
        echo("sa tcpck-valid=1")
    else:
        echo("sa tcpck-valid=0")

    var retrDecision: tun.VpnTunPacketDecision
    let _ = tun.VpnTunDecidePacket(runtime, syn, "", retrDecision)
    echo("retrans action=")
    echo(IntToStr(retrDecision.action))

    # pure ACK: seq=1001 ack=2
    var ackPkt: rawbytes.Bytes = rawbytes.BytesAlloc(40)
    rawbytes.BytesSet(ackPkt, 0, 69)
    rawbytes.BytesSet(ackPkt, 2, 0)
    rawbytes.BytesSet(ackPkt, 3, 40)
    rawbytes.BytesSet(ackPkt, 8, 64)
    rawbytes.BytesSet(ackPkt, 9, 6)
    rawbytes.BytesSet(ackPkt, 12, 192)
    rawbytes.BytesSet(ackPkt, 13, 168)
    rawbytes.BytesSet(ackPkt, 14, 43)
    rawbytes.BytesSet(ackPkt, 15, 66)
    rawbytes.BytesSet(ackPkt, 16, 198)
    rawbytes.BytesSet(ackPkt, 17, 18)
    rawbytes.BytesSet(ackPkt, 18, 123)
    rawbytes.BytesSet(ackPkt, 19, 210)
    rawbytes.BytesSet(ackPkt, 20, 161)
    rawbytes.BytesSet(ackPkt, 21, 18)
    rawbytes.BytesSet(ackPkt, 22, 1)
    rawbytes.BytesSet(ackPkt, 23, 187)
    rawbytes.BytesSet(ackPkt, 24, 0)
    rawbytes.BytesSet(ackPkt, 25, 0)
    rawbytes.BytesSet(ackPkt, 26, 3)
    rawbytes.BytesSet(ackPkt, 27, 233)
    rawbytes.BytesSet(ackPkt, 28, 0)
    rawbytes.BytesSet(ackPkt, 29, 0)
    rawbytes.BytesSet(ackPkt, 30, 0)
    rawbytes.BytesSet(ackPkt, 31, 2)
    rawbytes.BytesSet(ackPkt, 32, 80)
    rawbytes.BytesSet(ackPkt, 33, 16)
    var ackDecision: tun.VpnTunPacketDecision
    let _ = tun.VpnTunDecidePacket(runtime, ackPkt, "", ackDecision)
    echo("ack action=")
    echo(IntToStr(ackDecision.action))

    # ClientHello-like payload PSH|ACK seq=1001 ack=2 len=5
    var chPkt: rawbytes.Bytes = rawbytes.BytesAlloc(45)
    rawbytes.BytesSet(chPkt, 0, 69)
    rawbytes.BytesSet(chPkt, 2, 0)
    rawbytes.BytesSet(chPkt, 3, 45)
    rawbytes.BytesSet(chPkt, 8, 64)
    rawbytes.BytesSet(chPkt, 9, 6)
    rawbytes.BytesSet(chPkt, 12, 192)
    rawbytes.BytesSet(chPkt, 13, 168)
    rawbytes.BytesSet(chPkt, 14, 43)
    rawbytes.BytesSet(chPkt, 15, 66)
    rawbytes.BytesSet(chPkt, 16, 198)
    rawbytes.BytesSet(chPkt, 17, 18)
    rawbytes.BytesSet(chPkt, 18, 123)
    rawbytes.BytesSet(chPkt, 19, 210)
    rawbytes.BytesSet(chPkt, 20, 161)
    rawbytes.BytesSet(chPkt, 21, 18)
    rawbytes.BytesSet(chPkt, 22, 1)
    rawbytes.BytesSet(chPkt, 23, 187)
    rawbytes.BytesSet(chPkt, 24, 0)
    rawbytes.BytesSet(chPkt, 25, 0)
    rawbytes.BytesSet(chPkt, 26, 3)
    rawbytes.BytesSet(chPkt, 27, 233)
    rawbytes.BytesSet(chPkt, 28, 0)
    rawbytes.BytesSet(chPkt, 29, 0)
    rawbytes.BytesSet(chPkt, 30, 0)
    rawbytes.BytesSet(chPkt, 31, 2)
    rawbytes.BytesSet(chPkt, 32, 80)
    rawbytes.BytesSet(chPkt, 33, 24)
    rawbytes.BytesSet(chPkt, 40, 104)
    rawbytes.BytesSet(chPkt, 41, 101)
    rawbytes.BytesSet(chPkt, 42, 108)
    rawbytes.BytesSet(chPkt, 43, 108)
    rawbytes.BytesSet(chPkt, 44, 111)
    var chDecision: tun.VpnTunPacketDecision
    let _ = tun.VpnTunDecidePacket(runtime, chPkt, "", chDecision)
    echo("ch action=")
    echo(IntToStr(chDecision.action))
    echo("ch transport=")
    echo(IntToStr(chDecision.transport))
    echo("ch hostlen=")
    echo(IntToStr(len(chDecision.targetHost)))
    echo(" vpn_proxy_tun_global_stale_probe done")
    return 0
