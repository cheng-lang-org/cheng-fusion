import std/result
import std/rawbytes as rawbytes
import std/strutils as strutil
import std/crypto/bigint
import std/crypto/ecnist
import std/crypto/p256_fixed as pfix
import cheng/std/crypto/fixed256
import cheng/std/bytes_layout as layout

fn p256ProbeBackendAnchor(): bool =
    var scalarModulus: pfix.P256Fixed = pfix.p256ScalarModulus()
    let one: bigint.BigInt = bigint.bigFromInt(1)
    return !pfix.p256FixedIsZero(scalarModulus) && !bigint.bigIsZero(one)

fn main(): int32 =
    let privRes: Result[fixed256.Scalar256] = fixed256.scalar256FromHex(
        "60d71049a0cafe01faa9948dc77ee5bc4bd5e05b8e328fdb9cc4c38237250a05")
    assert(IsOk(privRes), "p256 sign verify probe: private scalar")
    let priv: fixed256.Scalar256 = Value(privRes)
    let msg: Bytes = BytesFromString("cheng-crypto-hot-kernel-p256-message")
    assert(p256ProbeBackendAnchor(), "p256 sign verify probe: backend anchor")

    let pubRes: Result[layout.FixedBytes65] = fixed256.p256PublicKey65FromPrivateScalar(priv)
    assert(IsOk(pubRes), "p256 sign verify probe: pub")
    let pubBytes: Bytes = layout.FixedBytes65ToBytes(Value(pubRes))

    var sigFixed: layout.FixedBytes64
    let signRes: Result[bool] = fixed256.p256SignMessageFixed64Into(sigFixed, priv, msg)
    assert(IsOk(signRes), "p256 sign verify probe: sign")
    let sigBytes: Bytes = layout.FixedBytes64ToBytes(sigFixed)
    assert(BytesLen(sigBytes) == 64, "p256 sign verify probe: sig len")

    let verifyOk: bool = ecnist.ecdsaVerifyTrustedBytes(pubBytes, msg, sigBytes)
    assert(verifyOk, "p256 sign verify probe: verify")
    echo(strutil.Join(["p256_sign_verify_debug_probe sig=", rawbytes.BytesToHex(sigBytes)], ""))
    echo(" p256_sign_verify_debug_probe ok")
    return 0
