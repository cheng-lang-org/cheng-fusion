import cheng/core/ir/phase_arena as phase

# Attack: after an exact survivor transfer (rehome), a saved copy of the
# source row is dead. Using it must hard-fail instead of aliasing the
# survivor.
fn main(): int32 =
    var store: phase.PhaseArenaStore
    phase.PhaseArenaStoreInit(store, 2, 64, 4)
    var scratch = phase.PhaseArenaStoreOpenArena(store, 1, 32, 2)
    var keep = phase.PhaseArenaStoreOpenArena(store, 2, 32, 2)
    var text = phase.PhaseArenaStoreStrPut(store, scratch, "move-me")
    var staleCopy = text
    let moved = phase.PhaseArenaStoreRehome(store, scratch, text, keep)
    if !phase.PhaseArenaStoreStrEqual(store, keep, moved, "move-me"):
        return 2
    if phase.PhaseArenaStoreStrEqual(store, scratch, staleCopy, "move-me"):
        return 0
    return 1
