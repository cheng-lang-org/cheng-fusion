import cheng/std/bytes_layout as layout
import cheng/core/csg_core/compiler_snapshot_schema as schema

fn ManualConsumeSchemaSmokeCid(seed: uint8): layout.FixedBytes32 =
    var out: layout.FixedBytes32
    out.data[0] = seed
    return out

fn ManualConsumeSchemaSmokeFixtureInto(
        tables: var schema.CsgCompilerSnapshotTables) =
    tables.schemaVersion =
        schema.CsgCompilerSnapshotSchemaVersionLatest
    tables.semanticEpoch = int64(1)

    add(tables.functions.typedFunctionIndexes, 0)
    add(tables.functions.symbolIds, 0)
    add(tables.functions.bodySpanIds, 0)
    add(
        tables.functions.annotationFlags,
        schema.CsgCompilerFunctionAnnotationManualConsume)
    add(tables.functions.manualConsumeTargetParameterSymbolIds, 1)
    add(tables.functions.manualConsumeSourceParameterSymbolIds, 2)
    add(
        tables.functions.manualConsumeEffectCids,
        layout.FixedBytes32())

    add(tables.parserSidecars.functionIndexes, 0)
    add(tables.parserSidecars.functionBodySpanIds, 0)
    add(
        tables.parserSidecars.functionAnnotationFlags,
        schema.CsgCompilerFunctionAnnotationManualConsume)
    add(
        tables.parserSidecars.functionManualConsumeTargetParameterOrdinals,
        0)
    add(
        tables.parserSidecars.functionManualConsumeTargetParameterDeclarationIds,
        1)
    add(
        tables.parserSidecars.functionManualConsumeSourceParameterOrdinals,
        1)
    add(
        tables.parserSidecars.functionManualConsumeSourceParameterDeclarationIds,
        2)

    add(
        tables.parserSidecars.declarationKinds,
        schema.CsgCompilerParserDeclarationFunction)
    add(
        tables.parserSidecars.declarationKinds,
        schema.CsgCompilerParserDeclarationParameter)
    add(
        tables.parserSidecars.declarationKinds,
        schema.CsgCompilerParserDeclarationParameter)
    add(tables.parserSidecars.declarationOwnerIds, -1)
    add(tables.parserSidecars.declarationOwnerIds, 0)
    add(tables.parserSidecars.declarationOwnerIds, 0)
    for row in 0..<3:
        add(
            tables.parserSidecars.declarationProducerSourceIds,
            0)
        add(
            tables.parserSidecars.declarationNameTokenIds,
            row)
        add(
            tables.parserSidecars.declarationNameSpanIds,
            row)
        add(
            tables.parserSidecars.declarationSpanIds,
            row)

    add(tables.symbols.declKeyCids,
        ManualConsumeSchemaSmokeCid(uint8(1)))
    add(tables.symbols.declKeyCids,
        ManualConsumeSchemaSmokeCid(uint8(2)))
    add(tables.symbols.declKeyCids,
        ManualConsumeSchemaSmokeCid(uint8(3)))
    add(
        tables.symbols.symbolKinds,
        schema.CsgCompilerSymbolFunction)
    add(
        tables.symbols.symbolKinds,
        schema.CsgCompilerSymbolParameter)
    add(
        tables.symbols.symbolKinds,
        schema.CsgCompilerSymbolParameter)
    add(tables.symbols.ownerSymbolIds, -1)
    add(tables.symbols.ownerSymbolIds, 0)
    add(tables.symbols.ownerSymbolIds, 0)
    for row in 0..<3:
        add(tables.symbols.sourceIds, 0)
        add(tables.symbols.nameTokenIds, row)
        add(tables.symbols.nameSpanIds, row)
        add(tables.symbols.declarationSpanIds, row)
    add(tables.symbols.typeIds, -1)
    add(tables.symbols.typeIds, 0)
    add(tables.symbols.typeIds, 1)

    add(tables.types.typeCids,
        ManualConsumeSchemaSmokeCid(uint8(4)))
    add(tables.types.typeCids,
        ManualConsumeSchemaSmokeCid(uint8(5)))
    add(tables.types.typeKinds, schema.CsgCompilerTypeBorrow)
    add(tables.types.typeKinds, schema.CsgCompilerTypeSequence)
    add(tables.types.elementTypeIds, 1)
    add(tables.types.elementTypeIds, -1)
    add(tables.types.managedFlags, false)
    add(tables.types.managedFlags, true)

fn main(): int32 =
    # [phaseB-enum-schema] v8 adds the enum variant payload CSR columns.
    assert(schema.CsgCompilerSnapshotSchemaVersionLatest == 8,
           "manual consume snapshot schema is not the unique latest version")
    assert(schema.CsgCompilerFunctionAnnotationManualConsume == 512,
           "manual consume annotation bit drifted")
    assert(schema.CsgCompilerFunctionAnnotationFlagsValid(
               schema.CsgCompilerFunctionAnnotationManualConsume),
           "manual consume annotation bit rejected")
    assert(!schema.CsgCompilerFunctionAnnotationFlagsValid(
               schema.CsgCompilerFunctionAnnotationBorrows |
               schema.CsgCompilerFunctionAnnotationManualConsume),
           "borrows/manual-consume conflict accepted")

    var empty: schema.CsgCompilerSnapshotTables
    empty.schemaVersion =
        schema.CsgCompilerSnapshotSchemaVersionLatest
    var effectCid: layout.FixedBytes32
    var err: str
    assert(!schema.CsgCompilerFunctionManualConsumeEffectCidInto(
               empty, 0, effectCid, err),
           "missing Function row produced a manual-consume effect")
    assert(err != "",
           "missing Function row rejection omitted diagnostic")

    var present: schema.CsgCompilerSnapshotTables
    ManualConsumeSchemaSmokeFixtureInto(present)
    var portableEffectCid: layout.FixedBytes32
    assert(schema.CsgCompilerFunctionManualConsumeEffectCidInto(
               present, 0, portableEffectCid, err),
           err)
    assert(!layout.FixedBytes32Equal(
               portableEffectCid, layout.FixedBytes32()),
           "manual-consume portable effect CID was empty")

    present.functions.manualConsumeEffectCids[0] =
        ManualConsumeSchemaSmokeCid(uint8(99))
    var replayedEffectCid: layout.FixedBytes32
    assert(schema.CsgCompilerFunctionManualConsumeEffectCidInto(
               present, 0, replayedEffectCid, err),
           err)
    assert(layout.FixedBytes32Equal(
               portableEffectCid, replayedEffectCid),
           "manual-consume portable effect CID contains itself")

    present.parserSidecars.functionBodySpanIds[0] = 1
    assert(!schema.CsgCompilerFunctionManualConsumeEffectCidInto(
               present, 0, replayedEffectCid, err),
           "manual-consume body-span drift was accepted")
    present.parserSidecars.functionBodySpanIds[0] = 0
    present.functions.typedFunctionIndexes[0] = 1
    assert(!schema.CsgCompilerFunctionManualConsumeEffectCidInto(
               present, 0, replayedEffectCid, err),
           "manual-consume typed Function drift was accepted")

    var absent: schema.CsgCompilerSnapshotTables
    ManualConsumeSchemaSmokeFixtureInto(absent)
    absent.functions.annotationFlags[0] = 0
    absent.functions.manualConsumeTargetParameterSymbolIds[0] = -1
    absent.functions.manualConsumeSourceParameterSymbolIds[0] = -1
    absent.functions.manualConsumeEffectCids[0] =
        layout.FixedBytes32()
    absent.parserSidecars.functionAnnotationFlags[0] = 0
    absent.parserSidecars.functionManualConsumeTargetParameterOrdinals[0] =
        -1
    absent.parserSidecars.functionManualConsumeTargetParameterDeclarationIds[
        0] = -1
    absent.parserSidecars.functionManualConsumeSourceParameterOrdinals[0] =
        -1
    absent.parserSidecars.functionManualConsumeSourceParameterDeclarationIds[
        0] = -1
    var absentEffectCid: layout.FixedBytes32
    assert(schema.CsgCompilerFunctionManualConsumeEffectCidInto(
               absent, 0, absentEffectCid, err),
           err)
    assert(layout.FixedBytes32Equal(
               absentEffectCid, layout.FixedBytes32()),
           "absent manual-consume relation produced an effect")
    absent.functions.manualConsumeTargetParameterSymbolIds[0] = 1
    assert(!schema.CsgCompilerFunctionManualConsumeEffectCidInto(
               absent, 0, absentEffectCid, err),
           "absent manual-consume Symbol poison was accepted")

    echo("compiler_snapshot_manual_consume_schema_version=7")
    echo("compiler_snapshot_manual_consume_annotation_bit=512")
    echo("compiler_snapshot_manual_consume_portable_self_cycle=0")
    echo("compiler_snapshot_manual_consume_typed_parser_body_span_join=1")
    echo("compiler_snapshot_manual_consume_absent_poison=1")
    echo("compiler_snapshot_manual_consume_schema_smoke: ok")
    return 0
