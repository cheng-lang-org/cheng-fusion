# 引号内冒号/引号内 "//" 变体: 验证 ParserStripLineCommentSlashAware 的
# quote-aware 扫描不会把字符串字面量里的 "//"(如 URL)或冒号误判成注释/语句边
# 界。控制头本身(含字符串字面量)与真实 // 续行注释共存于同一多行 if。

import std/system
import std/os as os
import std/strings

fn tag(n: int32): str =
    if n > 1:
        return "http://example.com:8080/path"
    return "none"

fn checkQuoted(n: int32): int32 =
    if tag(n) == "http://example.com:8080/path" &&
       // real comment: contains a colon too, must not confuse the join
       n > 1:
        return 1
    return 0

fn main() =
    let r1 = checkQuoted(1)
    os.WriteLine(os.GetStdout(), Fmt"r1={strings.IntToStr(r1)}")
    let r2 = checkQuoted(2)
    os.WriteLine(os.GetStdout(), Fmt"r2={strings.IntToStr(r2)}")
    if r1 == 0 && r2 == 1:
        os.WriteLine(os.GetStdout(), "PASS")
        exit(0)
    os.WriteLine(os.GetStdout(), "FAIL")
    exit(1)
