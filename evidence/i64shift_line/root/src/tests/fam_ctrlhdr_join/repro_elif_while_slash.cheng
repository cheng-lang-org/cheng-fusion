# elif / while 控制头续行中插 // 注释(无冒号变体)的联合 repro。三个函数各覆盖
# if 已在 repro_trailing_op_nocolon.cheng 验证, 这里补 elif 与 while。

import std/system
import std/os as os
import std/strings

fn isPositive(n: int32): bool =
    return n > 0

fn classify(n: int32): int32 =
    if n > 100:
        return 9
    elif isPositive(n) &&
         // still needs to be greater than one too
         n > 1:
        return 1
    return 0

fn sumWhile(startN: int32): int32 =
    var total: int32
    var i = startN
    while i > 0 &&
          // stop once total would exceed the cap
          total < 10:
        total = total + i
        i = i - 1
    return total

fn main() =
    let r1 = classify(1)
    os.WriteLine(os.GetStdout(), Fmt"r1={strings.IntToStr(r1)}")
    let r2 = classify(2)
    os.WriteLine(os.GetStdout(), Fmt"r2={strings.IntToStr(r2)}")
    let r3 = classify(0)
    os.WriteLine(os.GetStdout(), Fmt"r3={strings.IntToStr(r3)}")
    let r4 = sumWhile(3)
    os.WriteLine(os.GetStdout(), Fmt"r4={strings.IntToStr(r4)}")
    if r1 == 0 && r2 == 1 && r3 == 0 && r4 == 6:
        os.WriteLine(os.GetStdout(), "PASS")
        exit(0)
    os.WriteLine(os.GetStdout(), "FAIL")
    exit(1)
