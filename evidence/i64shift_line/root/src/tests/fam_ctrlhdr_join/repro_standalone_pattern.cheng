# 独立最小复现: 多行 if 控制头(首行 `if isPositive(n)` 以 ')' 收尾, 不含悬空
# 操作符/未闭合括号, 故不触发通用续行判定 TypedExprLineNeedsContinuation)在真正
# 的顶层冒号续行之前插入一条纯 `//` 注释行, 且注释文本恰好含冒号
# (`// note: ...`)。TypedExprIrAppendUnrepresentedTopLevelBodyStatements 的控制
# 头续行第二重兜底扫描分支(~20890, 控制头续行第 5 处 ParserStripLineComment
# 消费点)在本补丁前用只认 '#' 的 ParserStripLineComment 剥注释, 纯 '//' 注释行
# 剥不掉、原样当代码文本存活, 其内嵌冒号被顶层冒号扫描误判成"条件已闭合", 是
# 与已修复 4 处同构的同族缺陷, 本补丁已按 SlashAware 收口。
#
# 诚实边界(实测, 非猜测): 本仓库对 if/elif/while/let/var/call 这类关键字引导的
# 语句还存在一条独立的、更早生效的主路径(exprLayer/NormalizedExprLayer, 由
# parser.cheng 的 ParserJoinContinuationLines/ParserTrimmedCommentRange 驱动,
# 同样只认 '#'、未做 SlashAware 改造、不在本次任务授权范围内)。经 5 组构造 +
# CHENG_TYPED_IR_SCOPE_DEBUG 探针逐行核验, 凡是关键字引导的构造在本仓库当前
# 架构下都会先被该主路径处理(existingLineHasStatement=true), typed_expr.cheng
# 这条兜底续行分支被完全遮蔽、不参与最终取值——这份 repro 之所以仍能跑出静默
# 错值(见下方 r1), 错值来源就是被遮蔽的主路径, 不是本文件这条兜底分支, 所以
# mutation 验证(单独翻转本补丁)对这份 repro 不敏感, 如实记录、不裁剪成"看似
# 敏感"的假阳性 repro。留给下一波: 给 parser.cheng 的两处主路径消费点做同款
# SlashAware 收口后, 这份 repro 才会真正区分 fix 前后。
# 真跑到底 + 打印真实数值核对, 不用 assert/Fmt-bool。

import std/system
import std/os as os
import std/strings

fn isPositive(n: int32): bool =
    return n > 0

fn checkBig(n: int32): int32 =
    if isPositive(n)
       // note: still needs to be > 1 too
       && n > 1:
        return 1
    return 0

fn main() =
    let r1 = checkBig(1)
    os.WriteLine(os.GetStdout(), Fmt"r1={strings.IntToStr(r1)}")
    let r2 = checkBig(2)
    os.WriteLine(os.GetStdout(), Fmt"r2={strings.IntToStr(r2)}")
    let r3 = checkBig(0)
    os.WriteLine(os.GetStdout(), Fmt"r3={strings.IntToStr(r3)}")
    if r1 == 0 && r2 == 1 && r3 == 0:
        os.WriteLine(os.GetStdout(), "PASS")
        exit(0)
    os.WriteLine(os.GetStdout(), "FAIL")
    exit(1)
