import std/system
import std/os as os
import std/strings

fn isPositive(n: int32): bool =
    return n > 0

fn checkBigTrailNoColon(n: int32): int32 =
    if isPositive(n) &&
       // still needs to be greater than one too
       n > 1:
        return 1
    return 0

fn main() =
    let r1 = checkBigTrailNoColon(1)
    os.WriteLine(os.GetStdout(), Fmt"r1={strings.IntToStr(r1)}")
    let r2 = checkBigTrailNoColon(2)
    os.WriteLine(os.GetStdout(), Fmt"r2={strings.IntToStr(r2)}")
    let r3 = checkBigTrailNoColon(0)
    os.WriteLine(os.GetStdout(), Fmt"r3={strings.IntToStr(r3)}")
    if r1 == 0 && r2 == 1 && r3 == 0:
        os.WriteLine(os.GetStdout(), "PASS")
        exit(0)
    os.WriteLine(os.GetStdout(), "FAIL")
    exit(1)
