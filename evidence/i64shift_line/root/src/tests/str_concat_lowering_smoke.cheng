import std/os
import std/os_host_process as hostos
import std/strings
import std/strutils as strutil
import cheng/core/tooling/path as chengpath

fn main(): int32 =
    let root = os.GetCurrentDir()
    let compilerEnv = os.GetEnv("CHENG_SMOKE_COMPILER")
    var compilerRaw = "artifacts/bootstrap/cheng.stage3"
    if len(compilerEnv) > 0:
        compilerRaw = compilerEnv
    var driver = compilerRaw
    if !os.IsAbsolute(compilerRaw):
        driver = os.JoinPath(root, compilerRaw)
    let target = os.GetEnvDefault("CHENG_RUNTIME_LINK_TARGET", "arm64-apple-darwin")
    let outDir = chengpath.PathAbsolute(root, "artifacts/str_concat_lowering_smoke")
    let sourcePath = os.JoinPath(root, "src/tests/str_concat_lowering_fixture.cheng")
    assert(chengpath.MkdirP(root, outDir), " str concat lowering: mkdir")
    assert(os.FileExists(driver), " str concat lowering: compiler exists")
    let cleanupOutBin = os.JoinPath(outDir, "str_concat_lowering_probe")
    if chengpath.PathFileExists(cleanupOutBin):
        os.RemoveFile(cleanupOutBin)
    let cleanupReportPath = os.JoinPath(outDir, "str_concat_lowering_probe.compile.report.txt")
    if chengpath.PathFileExists(cleanupReportPath):
        os.RemoveFile(cleanupReportPath)
    let cleanupCompileLog = os.JoinPath(outDir, "str_concat_lowering_probe.compile.log")
    if chengpath.PathFileExists(cleanupCompileLog):
        os.RemoveFile(cleanupCompileLog)
    let outBin = os.JoinPath(outDir, "str_concat_lowering_probe")
    let exeReportPath = os.JoinPath(outDir, "str_concat_lowering_probe.compile.report.txt")
    let exeCompileLog = os.JoinPath(outDir, "str_concat_lowering_probe.compile.log")
    var compileArg0: str = "system-link-exec"
    var compileArg1: str = Fmt"--root:{root}"
    var compileArg2: str = Fmt"--in:{sourcePath}"
    var compileArg3: str = "--emit:exe"
    var compileArg4: str = Fmt"--target:{target}"
    var compileArg5: str = Fmt"--out:{outBin}"
    var compileArg6: str = Fmt"--report-out:{exeReportPath}"
    var compileWire: str = hostos.ArgvWire7(compileArg0,
                                            compileArg1,
                                            compileArg2,
                                            compileArg3,
                                            compileArg4,
                                            compileArg5,
                                            compileArg6)
    var emptyWire: str = hostos.ArgvWire0()
    var compileOut: str
    var compileRc: int32
    var workRoot: str = root
    hostos.ExecFileCaptureWire(driver, compileWire, emptyWire, workRoot, true, 0, compileOut, compileRc)
    os.WriteFile(exeCompileLog, compileOut)
    assert(compileRc == 0, " str concat lowering: exe compile rc")
    assert(os.FileExists(exeReportPath), " str concat lowering: report exists")
    let reportText = os.ReadFile(exeReportPath)
    assert(strings.StrContains(reportText, "direct_macho=1"),
           " str concat lowering: direct macho report")
    let nmOutBin = os.JoinPath(outDir, "str_concat_lowering_probe")
    var nmArg0: str = "-u"
    var nmWire: str = hostos.ArgvWire2(nmArg0, nmOutBin)
    var nmPath: str = "/usr/bin/nm"
    var symbolsText: str
    var symbolsRc: int32
    hostos.ExecFileCaptureWire(nmPath, nmWire, emptyWire, workRoot, true, 30, symbolsText, symbolsRc)
    assert(symbolsRc == 0, " str concat lowering: nm rc")
    if !strings.StrContains(symbolsText, "no symbols"):
        assert(strings.StrContains(symbolsText, "_cheng_strformat_fmt_bridge"),
               " str concat lowering: fmt bridge")
    assert(!strings.StrContains(symbolsText, "_driver_c_str_concat_bridge"),
           " str concat lowering: no binary concat bridge")
    let exeRunLog = os.JoinPath(outDir, "str_concat_lowering_probe.run.log")
    var runOutBin = os.JoinPath(outDir, "str_concat_lowering_probe")
    var runOut: str
    var runRc: int32
    hostos.ExecFileCaptureWire(runOutBin, emptyWire, emptyWire, workRoot, true, 0, runOut, runRc)
    os.WriteFile(exeRunLog, runOut)
    assert(runRc == 0, " str concat lowering: run rc")
    assert(strings.StrContains(runOut, " direct_concat_echo=alpha"),
           " str concat lowering: direct echo composite arg")
    assert(strings.StrContains(runOut, " str_concat_lowering_fixture ok"),
           " str concat lowering: runtime output")
    echo(" str_concat_lowering_smoke ok")
    return 0
