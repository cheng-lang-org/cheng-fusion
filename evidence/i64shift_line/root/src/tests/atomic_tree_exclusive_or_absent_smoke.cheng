import std/cmdline
import std/os
import std/rawbytes

fn RequiredFlag(name: str): str =
    var value: str
    assert(cmdline.readFlagValue(name, value) && len(value) > 0,
           "atomic tree exclusive smoke: required flag missing")
    return value

fn WaitForGo() =
    let first = os.C_fgetc(os.Get_stdin())
    let second = os.C_fgetc(os.Get_stdin())
    let newline = os.C_fgetc(os.Get_stdin())
    assert(first == 71 && second == 79 && newline == 10,
           "atomic tree exclusive smoke: invalid release token")

fn InstallAbsent(parent: str, staging: str, finalName: str) =
    let opened = os.AtomicTreeOpenVerifiedExclusiveOrAbsent(parent,
                                                             finalName)
    assert(IsOk(opened), Error(opened))
    let openResult = Value(opened)
    assert(openResult.kind == os.AtomicTreeExclusiveAbsent,
           "atomic tree exclusive smoke: expected ABSENT")
    var absent = openResult.tree
    var staleAbsent = absent
    let begun = os.AtomicTreeBeginFromExclusiveAbsent(absent, staging)
    assert(IsOk(begun), Error(begun))
    assert(absent == uint64(0),
           "atomic tree exclusive smoke: ABSENT handle not consumed")
    let staleBegin = os.AtomicTreeBeginFromExclusiveAbsent(
        staleAbsent,
        ".stale-absent")
    assert(IsErr(staleBegin),
           "atomic tree exclusive smoke: copied ABSENT handle accepted")
    var transaction = Value(begun)
    var staleTransaction = transaction
    var empty = rawbytes.EmptyBytes()
    assert(IsOk(os.AtomicTreeWriteExclusiveLeaseSync(transaction,
                                                      "marker",
                                                      empty)),
           "atomic tree exclusive smoke: lease write failed")
    let committed =
        os.AtomicTreeCommitExclusiveNoReplaceAndOpenVerified(transaction)
    assert(IsOk(committed), Error(committed))
    assert(transaction == uint64(0),
           "atomic tree exclusive smoke: transaction handle not consumed")
    assert(IsErr(os.AtomicTreeWriteExclusiveLeaseSync(staleTransaction,
                                                       "stale-marker",
                                                       empty)),
           "atomic tree exclusive smoke: stale transaction write accepted")
    assert(IsErr(os.AtomicTreeCommitExclusiveNoReplaceAndOpenVerified(
                     staleTransaction)),
           "atomic tree exclusive smoke: stale transaction commit accepted")
    assert(IsErr(os.AtomicTreeAbort(staleTransaction)),
           "atomic tree exclusive smoke: stale transaction abort accepted")
    assert(IsErr(os.AtomicTreeClose(staleTransaction)),
           "atomic tree exclusive smoke: stale transaction close accepted")
    let stable = Value(committed)
    assert(IsOk(os.AtomicTreeClose(stable)),
           "atomic tree exclusive smoke: committed close failed")

fn OpenInstalled(parent: str, finalName: str) =
    let opened = os.AtomicTreeOpenVerifiedExclusiveOrAbsent(parent,
                                                             finalName)
    assert(IsOk(opened), Error(opened))
    let openResult = Value(opened)
    assert(openResult.kind == os.AtomicTreeExclusiveOpened,
           "atomic tree exclusive smoke: expected OPENED")
    assert(IsOk(os.AtomicTreeClose(openResult.tree)),
           "atomic tree exclusive smoke: OPENED close failed")

fn RejectInvalid(parent: str, finalName: str) =
    let opened = os.AtomicTreeOpenVerifiedExclusiveOrAbsent(parent,
                                                             finalName)
    assert(IsErr(opened),
           "atomic tree exclusive smoke: invalid destination accepted")

fn HoldLease(parent: str, finalName: str) =
    let opened = os.AtomicTreeOpenVerifiedExclusiveOrAbsent(parent,
                                                             finalName)
    assert(IsOk(opened), Error(opened))
    let lease = Value(opened)
    echo("READY")
    let _ = os.C_fflush(os.Get_stdout())
    WaitForGo()
    assert(IsOk(os.AtomicTreeClose(lease.tree)),
           "atomic tree exclusive smoke: holder close failed")
    echo("RELEASED")

fn RejectContender(parent: str, finalName: str) =
    let opened = os.AtomicTreeOpenVerifiedExclusiveOrAbsent(parent,
                                                             finalName)
    assert(IsErr(opened),
           "atomic tree exclusive smoke: parent-wide contender accepted")
    echo("CONTENDED")

fn VerifyCrashRelease(parent: str, finalName: str) =
    let opened = os.AtomicTreeOpenVerifiedExclusiveOrAbsent(parent,
                                                             finalName)
    assert(IsOk(opened), Error(opened))
    let lease = Value(opened)
    assert(IsOk(os.AtomicTreeClose(lease.tree)),
           "atomic tree exclusive smoke: crash-released close failed")
    echo("CRASH_RELEASED")

fn main(argc: int32, argv: str*): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    let mode = RequiredFlag("--mode")
    let parent = RequiredFlag("--parent")
    let finalName = RequiredFlag("--final")
    if mode == "os-absent":
        InstallAbsent(parent, RequiredFlag("--staging"), finalName)
        echo("ATOMIC_TREE_OS_ABSENT_OK")
        return 0
    if mode == "os-opened":
        OpenInstalled(parent, finalName)
        echo("ATOMIC_TREE_OS_OPENED_OK")
        return 0
    if mode == "os-invalid":
        RejectInvalid(parent, finalName)
        echo("ATOMIC_TREE_OS_INVALID_OK")
        return 0
    if mode == "lease-holder":
        HoldLease(parent, finalName)
        return 0
    if mode == "lease-contender":
        RejectContender(parent, finalName)
        return 0
    if mode == "lease-crash-release":
        VerifyCrashRelease(parent, finalName)
        return 0
    assert(false, "atomic tree exclusive smoke: unknown mode")
    return 2
