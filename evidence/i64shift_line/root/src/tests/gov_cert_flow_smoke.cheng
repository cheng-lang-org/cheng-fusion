# governance cert flow smoke: a forced-line raise happens ONLY through a
# committee-signed motion; forged/insufficient votes cannot move the line.

import std/os
import std/system
import std/rawbytes
import cheng/std/bytes_layout as layout
import cheng/libp2p/crypto/ed25519/ed25519 as ed
import cheng/apps/rwad/rwad_gov_epoch as gov
import cheng/apps/rwad/rwad_gov_cert_flow as gcf

fn Tag(b: int32): layout.FixedBytes32 =
    var raw = BytesAlloc(32)
    BytesSet(raw, 0, b)
    let res = layout.FixedBytes32FromBytes(raw)
    return res.value

@borrows
fn HexCharVal(c: str): int32 =
    if c == "0":
        return 0
    if c == "1":
        return 1
    if c == "2":
        return 2
    if c == "3":
        return 3
    if c == "4":
        return 4
    if c == "5":
        return 5
    if c == "6":
        return 6
    if c == "7":
        return 7
    if c == "8":
        return 8
    if c == "9":
        return 9
    if c == "a" or c == "A":
        return 10
    if c == "b" or c == "B":
        return 11
    if c == "c" or c == "C":
        return 12
    if c == "d" or c == "D":
        return 13
    if c == "e" or c == "E":
        return 14
    if c == "f" or c == "F":
        return 15
    return 0

@borrows
fn HexToBytes(h: str): Bytes =
    let n: int32 = h.len / 2
    var out = BytesAlloc(n)
    var i: int32
    while i < n:
        let hi: int32 = HexCharVal(osSliceStr(h, i * 2, i * 2))
        let lo: int32 = HexCharVal(osSliceStr(h, i * 2 + 1, i * 2 + 1))
        BytesSet(out, i, hi * 16 + lo)
        i = i + 1
    return out

fn main(): int32 =
    var rc: int32 = 0
    var book: gov.GovEpochBook
    let gi = gov.GovInit(book, 0)
    if !gi.ok:
        return 1

    # committee keys: two epoch0 (legacy) + two already re-keyed to epoch1
    let seedA = HexToBytes("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
    let seedB = HexToBytes("4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb")
    let seedC = HexToBytes("c5aa8df43f9f837bedb7442f31dcb7b166d38535076f094b85ce3a2e0b4458f7")
    let seedD = HexToBytes("3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c")
    let kpA = ed.keyPairFromSeedEpoch(seedA, 0)
    let kpB = ed.keyPairFromSeedEpoch(seedB, 0)
    let kpC1 = ed.keyPairFromSeedEpoch(seedC, 1)
    let kpD1 = ed.keyPairFromSeedEpoch(seedD, 1)
    if !kpA.ok or !kpB.ok or !kpC1.ok or !kpD1.ok:
        return 1

    # committee roster: the four legitimate keys (mixed conventions)
    var committeePks: Bytes[]
    add(committeePks, kpA.value.publicKey.data)
    add(committeePks, kpB.value.publicKey.data)
    add(committeePks, kpC1.value.publicKey.data)
    add(committeePks, kpD1.value.publicKey.data)

    var motion = gcf.GcfMotionBytes(1, 500)
    if motion.len != 32 or BytesGet(motion, 0) != 0xA1 or BytesGet(motion, 1) != 1:
        os.WriteLine(os.Get_stderr(), "motion record malformed")
        rc = rc + 1
    # determinism of the motion record
    var motion2 = gcf.GcfMotionBytes(1, 500)
    var same: bool = true
    var i: int32
    while i < 32:
        if BytesGet(motion, i) != BytesGet(motion2, i):
            same = false
        i = i + 1
    if !same:
        os.WriteLine(os.Get_stderr(), "motion not deterministic")
        rc = rc + 1

    # only TWO votes sign the raise proposal: below 2f+1 for f=1 -> refused
    let sA = ed.signEd25519RawEpoch(kpA.value.privateKey.data, motion, 0)
    let sC = ed.signEd25519RawEpoch(kpC1.value.privateKey.data, motion, 1)
    if !sA.ok or !sC.ok:
        return 1
    var votes2: gcf.GcfVote[]
    var vA: gcf.GcfVote
    vA.pubKey = kpA.value.publicKey.data
    vA.sig = sA.value
    vA.epoch = 0
    add(votes2, vA)
    var vC: gcf.GcfVote
    vC.pubKey = kpC1.value.publicKey.data
    vC.sig = sC.value
    vC.epoch = 1
    add(votes2, vC)
    let lowQ = gcf.GcfApplyRaiseByQuorum(book, votes2, motion, committeePks, 1, 1, Int64(1000))
    if lowQ.ok:
        os.WriteLine(os.Get_stderr(), "raise applied without quorum")
        rc = rc + 1
    if book.minKeyEpoch != 0:
        os.WriteLine(os.Get_stderr(), "line moved without quorum")
        rc = rc + 1

    # forge a third vote with a WRONG key: still only two valid -> refused
    let kpFake = ed.keyPairFromSeedEpoch(HexToBytes("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"), 1)
    if !kpFake.ok:
        return 1
    let sFake = ed.signEd25519RawEpoch(kpFake.value.privateKey.data, motion, 1)
    if !sFake.ok:
        return 1
    var votes3: gcf.GcfVote[]
    var vA2: gcf.GcfVote
    vA2.pubKey = kpA.value.publicKey.data
    vA2.sig = sA.value
    vA2.epoch = 0
    add(votes3, vA2)
    var vC2: gcf.GcfVote
    vC2.pubKey = kpC1.value.publicKey.data
    vC2.sig = sC.value
    vC2.epoch = 1
    add(votes3, vC2)
    var vF: gcf.GcfVote
    vF.pubKey = kpFake.value.publicKey.data
    vF.sig = sFake.value
    vF.epoch = 1
    add(votes3, vF)
    let forged = gcf.GcfApplyRaiseByQuorum(book, votes3, motion, committeePks, 1, 1, Int64(1100))
    if forged.ok:
        os.WriteLine(os.Get_stderr(), "forged vote counted toward quorum")
        rc = rc + 1
    if book.minKeyEpoch != 0:
        os.WriteLine(os.Get_stderr(), "line moved by forged vote")
        rc = rc + 1

    # legitimate third vote from member B (epoch0 key): quorum reached
    let sB = ed.signEd25519RawEpoch(kpB.value.privateKey.data, motion, 0)
    if !sB.ok:
        return 1
    var votesOk: gcf.GcfVote[]
    var vA3: gcf.GcfVote
    vA3.pubKey = kpA.value.publicKey.data
    vA3.sig = sA.value
    vA3.epoch = 0
    add(votesOk, vA3)
    var vC3: gcf.GcfVote
    vC3.pubKey = kpC1.value.publicKey.data
    vC3.sig = sC.value
    vC3.epoch = 1
    add(votesOk, vC3)
    var vB: gcf.GcfVote
    vB.pubKey = kpB.value.publicKey.data
    vB.sig = sB.value
    vB.epoch = 0
    add(votesOk, vB)
    let applied = gcf.GcfApplyRaiseByQuorum(book, votesOk, motion, committeePks, 1, 1, Int64(1712345678901))
    if !applied.ok:
        os.WriteLine(os.Get_stderr(), "legitimate raise failed")
        rc = rc + 1
    if book.minKeyEpoch != 1:
        os.WriteLine(os.Get_stderr(), "floor not raised to 1")
        rc = rc + 1
    if book.activatedAtMs != Int64(1712345678901):
        os.WriteLine(os.Get_stderr(), "activation timestamp not bound")
        rc = rc + 1
    let forcedNow = gov.GovIsForced(book)
    if !forcedNow:
        os.WriteLine(os.Get_stderr(), "forced flag not set after raise")
        rc = rc + 1

    # mixed-convention committee in action: epoch0 and epoch1 signatures
    # both count under their own conventions once quorum is legitimate.
    let acceptOld = gov.GovAcceptIdentity(book, 0)
    if acceptOld.ok:
        os.WriteLine(os.Get_stderr(), "old identity accepted past line")
        rc = rc + 1
    let acceptNew = gov.GovAcceptIdentity(book, 1)
    if !acceptNew.ok:
        os.WriteLine(os.Get_stderr(), "new identity refused past line")
        rc = rc + 1

    if rc == 0:
        echo("gov_cert_flow_smoke ok")
    return rc
