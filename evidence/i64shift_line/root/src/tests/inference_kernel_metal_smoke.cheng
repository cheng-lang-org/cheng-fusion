import std/result
import std/os
import std/rawbytes
import cheng/inference/kernel as infer
import cheng/inference/kernel_ir as kir
import cheng/inference/device as device

fn makeTensor(shape: int32[], scale: int32, data: int32[]): infer.TensorQ =
    var out: infer.TensorQ
    let res = infer.TensorFromDataFill(out, shape, scale, data)
    assert(IsOk(res), " inference metal smoke: tensor")
    return out

fn assertTensorExact(tensor: infer.TensorQ, expected: int32[], label: str) =
    assert(tensor.data.len == expected.len, label)
    for i in 0..<expected.len:
        assert(tensor.data[i] == expected[i], label)

fn makePackedInt4Tensor(shape: int32[], scale: int32, values: int32[]): kir.KernelPackedInt4Tensor =
    let countRes = infer.TensorElementCount(shape)
    assert(IsOk(countRes), " inference metal smoke: int4 shape")
    assert(Value(countRes) == values.len, " inference metal smoke: int4 value count")
    let byteCount = values.len / 2 + values.len % 2
    var bytes = rawbytes.BytesAlloc(byteCount)
    assert(byteCount == 0 || bytes.data != nil, " inference metal smoke: int4 allocation")
    for i in 0..<values.len:
        assert(values[i] >= -8 && values[i] <= 7, " inference metal smoke: int4 range")
        var nibble = values[i]
        if nibble < 0:
            nibble = nibble + 16
        let byteIndex = i / 2
        let oldByte = rawbytes.BytesGet(bytes, byteIndex)
        if i % 2 == 0:
            rawbytes.BytesSet(bytes, byteIndex, (oldByte & 240) | (nibble & 15))
        else:
            rawbytes.BytesSet(bytes, byteIndex, (oldByte & 15) | ((nibble & 15) << 4))
    return kir.KernelPackedInt4Tensor(shape: shape, scale: scale, packed: bytes)

fn makeW4Afp8Tensor(shape: int32[], scale: int32, values: int32[]): kir.KernelW4Afp8Tensor =
    let countRes = infer.TensorElementCount(shape)
    assert(IsOk(countRes), " inference metal smoke: w4afp8 shape")
    assert(Value(countRes) == values.len, " inference metal smoke: w4afp8 value count")
    var bytes = rawbytes.BytesAlloc(values.len)
    assert(values.len == 0 || bytes.data != nil, " inference metal smoke: w4afp8 allocation")
    for i in 0..<values.len:
        assert(values[i] >= 0 && values[i] <= 255, " inference metal smoke: w4afp8 raw range")
        rawbytes.BytesSet(bytes, i, values[i])
    return kir.KernelW4Afp8Tensor(shape: shape, scale: scale, rawI8: bytes)

fn main(): int32 =
    let vectorProgram = kir.KernelIrVectorAddProgram(4, kir.KernelDtypeFp16, 1000)
    assert(IsOk(kir.KernelIrValidateProgram(vectorProgram)), " inference metal smoke: vector kernel ir")
    let a = makeTensor([4], 1000, [1000, 2000, -3000, 4000])
    let b = makeTensor([4], 1000, [10, 20, 30, 40])
    var addOut: infer.TensorQ
    let addRes = kir.KernelIrVectorAddCpuFill(addOut, a, b)
    assert(IsOk(addRes), " inference metal smoke: vector add oracle")
    assertTensorExact(addOut, [1010, 2020, -2970, 4040], " inference metal smoke: vector add value")

    let gemmProgram = kir.KernelIrGemmProgram(2, 2, 2, kir.KernelDtypeFp16, 1000)
    assert(IsOk(kir.KernelIrValidateProgram(gemmProgram)), " inference metal smoke: gemm kernel ir")
    let left = makeTensor([2, 2], 1000, [1000, 2000, 3000, 4000])
    let right = makeTensor([2, 2], 1000, [5000, 6000, 7000, 8000])
    var matmulOut: infer.TensorQ
    let matmulRes = kir.KernelIrMatMulCpuFill(matmulOut, left, right)
    assert(IsOk(matmulRes), " inference metal smoke: matmul oracle")
    assertTensorExact(matmulOut, [19000, 22000, 43000, 50000], " inference metal smoke: matmul value")

    let int4Program = kir.KernelIrGemmInt4WeightProgram(2, 3, 3, kir.KernelDtypeFp16, 1000, 1000)
    assert(IsOk(kir.KernelIrValidateProgram(int4Program)), " inference metal smoke: int4 gemm kernel ir")
    let int4Left = makeTensor([2, 3], 1000, [1000, 2000, -1000, 3000, -2000, 1000])
    var int4Right = makePackedInt4Tensor([3, 3], 1000, [1, -2, 3, 4, 0, -1, -3, 2, 1])
    assert(IsOk(kir.KernelIrPackedInt4TensorValidate(int4Right)),
           " inference metal smoke: int4 packed validate")
    var int4Out: infer.TensorQ
    let int4Res = kir.KernelIrGemmInt4WeightCpuFill(int4Out, int4Left, int4Right)
    assert(IsOk(int4Res), " inference metal smoke: int4 gemm oracle")
    assertTensorExact(int4Out, [12000, -4000, 0, -8000, -4000, 12000],
                      " inference metal smoke: int4 gemm value")
    let linearInt4Program = kir.KernelIrLinearOutInInt4WeightProgram(2, 2, 3, kir.KernelDtypeFp16, 1000, 1000)
    assert(IsOk(kir.KernelIrValidateProgram(linearInt4Program)),
           " inference metal smoke: linear int4 kernel ir")
    let linearInt4Left = makeTensor([2, 3], 1000, [1000, 2000, -1000, 3000, -2000, 1000])
    var linearInt4Right = makePackedInt4Tensor([2, 3], 1000, [1, -2, 3, 4, 0, -1])
    var linearInt4Out: infer.TensorQ
    let linearInt4Res = kir.KernelIrLinearOutInInt4WeightCpuFill(linearInt4Out, linearInt4Left, linearInt4Right)
    assert(IsOk(linearInt4Res), " inference metal smoke: linear int4 oracle")
    assertTensorExact(linearInt4Out, [-6000, 5000, 10000, 11000],
                      " inference metal smoke: linear int4 value")
    var badInt4Right = makePackedInt4Tensor([3, 3], 1000, [1, -2, 3, 4, 0, -1, -3, 2, 1])
    rawbytes.BytesSet(badInt4Right.packed, rawbytes.BytesLen(badInt4Right.packed) - 1,
                      rawbytes.BytesGet(badInt4Right.packed, rawbytes.BytesLen(badInt4Right.packed) - 1) | 128)
    assert(IsErr(kir.KernelIrPackedInt4TensorValidate(badInt4Right)),
           " inference metal smoke: int4 padding hard fail")
    let w4Program = kir.KernelIrLinearOutInW4Afp8WeightProgram(2, 2, 3, kir.KernelDtypeFp16, 1000, 1000, 1000)
    assert(IsOk(kir.KernelIrValidateProgram(w4Program)),
           " inference metal smoke: w4afp8 kernel ir")
    let w4Left = makeTensor([2, 3], 1000, [1000, 2000, -1000, 3000, -2000, 1000])
    let w4Right = makeW4Afp8Tensor([2, 3], 1000, [1, 254, 3, 4, 0, 255])
    let w4WeightScaleInv = makeTensor([2], 1000, [1000, 2000])
    let w4InputScale = makeTensor([1], 1000, [1000])
    var w4Out: infer.TensorQ
    let w4Res = kir.KernelIrLinearOutInW4Afp8WeightCpuFill(w4Out, w4Left, w4Right, w4WeightScaleInv, w4InputScale)
    assert(IsOk(w4Res), " inference metal smoke: w4afp8 oracle")
    assertTensorExact(w4Out, [-6000, 10000, 10000, 22000],
                      " inference metal smoke: w4afp8 value")
    let badW4Right = kir.KernelW4Afp8Tensor(shape: [2, 3], scale: 1000, rawI8: rawbytes.BytesSlice(w4Right.rawI8, 0, 2))
    assert(IsErr(kir.KernelIrW4Afp8TensorValidate(badW4Right)),
           " inference metal smoke: w4afp8 raw byte count hard fail")

    let rmsProgram = kir.KernelIrRmsNormProgram(2, kir.KernelDtypeFp16, 1000, 1)
    assert(IsOk(kir.KernelIrValidateProgram(rmsProgram)), " inference metal smoke: rmsnorm kernel ir")
    let input = makeTensor([2], 1000, [1000, 1000])
    let weight = makeTensor([2], 1000, [1000, 2000])
    var rmsOut: infer.TensorQ
    let rmsRes = kir.KernelIrRmsNormCpuFill(rmsOut, input, weight, 1)
    assert(IsOk(rmsRes), " inference metal smoke: rmsnorm oracle")
    assertTensorExact(rmsOut, [1000, 2000], " inference metal smoke: rmsnorm value")

    let metalRes = device.DeviceProbeMetal()
    assert(IsOk(metalRes), " inference metal smoke: metal probe")
    let metal = Value(metalRes)
    let fileRangePath = "/tmp/cheng_device_file_range_buffer_load_smoke.bin"
    if os.FileExists(fileRangePath):
        assert(os.RemoveFile(fileRangePath), " inference metal smoke: remove old range file")
    var fileRangeBytes = rawbytes.BytesAlloc(8)
    for i in 0..<8:
        rawbytes.BytesSet(fileRangeBytes, i, i * 19 + 7)
    assert(IsOk(os.WriteFileBytesResult(fileRangePath, fileRangeBytes)),
           " inference metal smoke: write range file")
    let fileRangeHash = device.DeviceHashFileRangePath(fileRangePath, int64(2), int64(4), 2)
    assert(IsOk(fileRangeHash), " inference metal smoke: file range hash")
    let fileRangeBuffer = device.DeviceBufferLogical(metal, int64(4), kir.KernelDtypeInt8, Value(fileRangeHash))
    let fileRangeReceipt = device.DeviceBuildVerifiedFileRangeBufferLoadReceipt(
        metal,
        fileRangeBuffer,
        fileRangePath,
        int64(2),
        int64(4),
        2
    )
    assert(IsOk(fileRangeReceipt), " inference metal smoke: file range buffer load receipt")
    assert(Value(fileRangeReceipt).schema == device.InferenceDeviceFileRangeBufferLoadReceiptSchema &&
           Value(fileRangeReceipt).status == device.InferenceDeviceBufferLoadStatusVerifiedLogical &&
           Value(fileRangeReceipt).sourceRangeHash == Value(fileRangeHash) &&
           Value(fileRangeReceipt).receiptHash == device.DeviceFileRangeBufferLoadReceiptHash(Value(fileRangeReceipt)),
           " inference metal smoke: file range buffer load receipt facts")
    assert(IsOk(device.DeviceValidateFileRangeBufferLoadReceipt(metal, fileRangeBuffer, Value(fileRangeReceipt))),
           " inference metal smoke: file range buffer load receipt validate")
    let metalFileRangeLoad = device.DeviceMetalLoadFileRangeBuffer(
        metal,
        fileRangePath,
        int64(2),
        int64(4),
        2,
        kir.KernelDtypeInt8
    )
    assert(IsOk(metalFileRangeLoad), " inference metal smoke: metal file range buffer load")
    assert(Value(metalFileRangeLoad).buffer.handle != uint64(0) &&
           Value(metalFileRangeLoad).buffer.logicalHash == Value(fileRangeHash) &&
           Value(metalFileRangeLoad).receipt.status == device.InferenceDeviceBufferLoadStatusMetalBufferLoaded &&
           Value(metalFileRangeLoad).receipt.deviceBufferHandle == Value(metalFileRangeLoad).buffer.handle &&
           Value(metalFileRangeLoad).receipt.sourceRangeHash == Value(fileRangeHash) &&
           Value(metalFileRangeLoad).receipt.receiptHash == device.DeviceFileRangeBufferLoadReceiptHash(Value(metalFileRangeLoad).receipt),
           " inference metal smoke: metal file range buffer load receipt facts")
    assert(IsOk(device.DeviceValidateFileRangeBufferLoadReceipt(
        metal,
        Value(metalFileRangeLoad).buffer,
        Value(metalFileRangeLoad).receipt
    )), " inference metal smoke: metal file range buffer load receipt validate")
    assert(IsErr(device.DeviceValidateFileRangeBufferLoadReceipt(
        metal,
        fileRangeBuffer,
        Value(metalFileRangeLoad).receipt
    )), " inference metal smoke: metal receipt requires provider handle")
    assert(IsOk(device.DeviceMetalReleaseBuffer(Value(metalFileRangeLoad).buffer)),
           " inference metal smoke: metal file range buffer release")

    let pageTable = device.DeviceBuildFileRangePageTableReceipt(
        metal,
        fileRangePath,
        int64(1),
        int64(6),
        int64(2),
        2
    )
    assert(IsOk(pageTable), " inference metal smoke: file range page table")
    let page1Hash = device.DeviceHashFileRangePath(fileRangePath, int64(3), int64(2), 2)
    assert(IsOk(page1Hash), " inference metal smoke: file range page hash")
    assert(Value(pageTable).schema == device.InferenceDeviceFileRangePageTableReceiptSchema &&
           Value(pageTable).pageCount == 3 &&
           Value(pageTable).pages.len == 3 &&
           Value(pageTable).pages[1].pageOrdinal == 1 &&
           Value(pageTable).pages[1].offsetBytes == int64(3) &&
           Value(pageTable).pages[1].byteCount == int64(2) &&
           Value(pageTable).pages[1].sourceRangeHash == Value(page1Hash) &&
           Value(pageTable).pageAggregateHash == device.DeviceFileRangePageAggregateHash(Value(pageTable).pages) &&
           Value(pageTable).receiptHash == device.DeviceFileRangePageTableReceiptHash(Value(pageTable)),
           " inference metal smoke: file range page table facts")
    assert(IsOk(device.DeviceValidateFileRangePageTableReceipt(metal, Value(pageTable))),
           " inference metal smoke: file range page table validate")
    assert(IsOk(device.DeviceValidateFileRangePageInTableReceipt(metal, Value(pageTable), 1)),
           " inference metal smoke: file range page table target page validate")
    let page1Load = device.DeviceMetalLoadFileRangePageBuffer(
        metal,
        Value(pageTable),
        1,
        kir.KernelDtypeInt8
    )
    assert(IsOk(page1Load), " inference metal smoke: metal page buffer load")
    assert(Value(page1Load).buffer.handle != uint64(0) &&
           Value(page1Load).buffer.sizeBytes == int64(2) &&
           Value(page1Load).buffer.logicalHash == Value(page1Hash) &&
           Value(page1Load).receipt.offsetBytes == int64(3) &&
           Value(page1Load).receipt.byteCount == int64(2) &&
           Value(page1Load).receipt.sourceRangeHash == Value(page1Hash),
           " inference metal smoke: metal page buffer facts")
    assert(IsOk(device.DeviceMetalReleaseBuffer(Value(page1Load).buffer)),
           " inference metal smoke: metal page buffer release")
    assert(IsErr(device.DeviceMetalLoadFileRangePageBuffer(
        metal,
        Value(pageTable),
        3,
        kir.KernelDtypeInt8
    )), " inference metal smoke: metal page buffer out of range hard fail")
    var badPageTable = Value(pageTable)
    badPageTable.pages[1].sourceRangeHash = badPageTable.pages[1].sourceRangeHash + int64(1)
    badPageTable.pages[1].pageHash = device.DeviceFileRangePageHash(badPageTable.pages[1])
    badPageTable.pageAggregateHash = device.DeviceFileRangePageAggregateHash(badPageTable.pages)
    badPageTable.receiptHash = device.DeviceFileRangePageTableReceiptHash(badPageTable)
    assert(IsErr(device.DeviceValidateFileRangePageTableReceipt(metal, badPageTable)),
           " inference metal smoke: file range page table content drift hard fail")

    let vectorBufferPath = "/tmp/cheng_device_vector_left_i32_buffer_smoke.bin"
    if os.FileExists(vectorBufferPath):
        assert(os.RemoveFile(vectorBufferPath), " inference metal smoke: remove old vector buffer file")
    var vectorFileBytes = rawbytes.BytesAlloc(24)
    assert(vectorFileBytes.data != nil, " inference metal smoke: vector buffer file allocation")
    device.DeviceWriteI32LE(vectorFileBytes, 4, 1000)
    device.DeviceWriteI32LE(vectorFileBytes, 8, 2000)
    device.DeviceWriteI32LE(vectorFileBytes, 12, -3000)
    device.DeviceWriteI32LE(vectorFileBytes, 16, 4000)
    assert(IsOk(os.WriteFileBytesResult(vectorBufferPath, vectorFileBytes)),
           " inference metal smoke: write vector buffer file")
    let vectorBufferLoad = device.DeviceMetalLoadFileRangeBufferChunked(
        metal,
        vectorBufferPath,
        int64(4),
        int64(16),
        5,
        kir.KernelDtypeI32
    )
    assert(IsOk(vectorBufferLoad), " inference metal smoke: vector left buffer load")
    assert(Value(vectorBufferLoad).receipt.chunkBytes == 5 &&
           Value(vectorBufferLoad).receipt.byteCount == int64(16),
           " inference metal smoke: vector left chunked receipt facts")
    var metalBufferAddOut: infer.TensorQ
    let metalBufferAddReceipt = device.DeviceMetalVectorAddBufferLeftFill(
        metalBufferAddOut,
        metal,
        vectorProgram,
        Value(vectorBufferLoad).buffer,
        Value(vectorBufferLoad).receipt,
        b
    )
    assert(IsOk(metalBufferAddReceipt), " inference metal smoke: vector add provider buffer launch")
    assertTensorExact(metalBufferAddOut, addOut.data,
        " inference metal smoke: vector add provider buffer value")
    assert(Value(metalBufferAddReceipt).status == device.InferenceDeviceKernelStatusLaunched &&
           Value(metalBufferAddReceipt).kernelHash == vectorProgram.kernelHash &&
           Value(metalBufferAddReceipt).inputHash > int64(0) &&
           Value(metalBufferAddReceipt).outputHash > int64(0) &&
           Value(metalBufferAddReceipt).elapsedNs > int64(0),
        " inference metal smoke: vector add provider buffer receipt facts")
    var badVectorBufferReceipt = Value(vectorBufferLoad).receipt
    badVectorBufferReceipt.sourceRangeHash = badVectorBufferReceipt.sourceRangeHash + int64(1)
    badVectorBufferReceipt.receiptHash = device.DeviceFileRangeBufferLoadReceiptHash(badVectorBufferReceipt)
    assert(IsErr(device.DeviceMetalVectorAddBufferLeftFill(
        metalBufferAddOut,
        metal,
        vectorProgram,
        Value(vectorBufferLoad).buffer,
        badVectorBufferReceipt,
        b
    )), " inference metal smoke: vector add provider buffer receipt drift hard fail")
    var badVectorChunkReceipt = Value(vectorBufferLoad).receipt
    badVectorChunkReceipt.chunkBytes = 8
    assert(IsErr(device.DeviceValidateFileRangeBufferLoadReceipt(
        metal,
        Value(vectorBufferLoad).buffer,
        badVectorChunkReceipt
    )), " inference metal smoke: vector chunk receipt hash hard fail")
    assert(IsOk(device.DeviceMetalReleaseBuffer(Value(vectorBufferLoad).buffer)),
           " inference metal smoke: vector left buffer release")

    let badRangeBuffer = device.DeviceBufferLogical(metal, int64(4), kir.KernelDtypeInt8, Value(fileRangeHash) + int64(1))
    assert(IsErr(device.DeviceBuildVerifiedFileRangeBufferLoadReceipt(
        metal,
        badRangeBuffer,
        fileRangePath,
        int64(2),
        int64(4),
        2
    )), " inference metal smoke: file range buffer hash hard fail")
    assert(IsErr(device.DeviceBuildVerifiedFileRangeBufferLoadReceipt(
        metal,
        fileRangeBuffer,
        fileRangePath,
        int64(2),
        int64(5),
        2
    )), " inference metal smoke: file range buffer size hard fail")
    var badFileRangeReceipt = Value(fileRangeReceipt)
    badFileRangeReceipt.sourceRangeHash = badFileRangeReceipt.sourceRangeHash + int64(1)
    badFileRangeReceipt.receiptHash = device.DeviceFileRangeBufferLoadReceiptHash(badFileRangeReceipt)
    assert(IsErr(device.DeviceValidateFileRangeBufferLoadReceipt(metal, fileRangeBuffer, badFileRangeReceipt)),
           " inference metal smoke: file range receipt hash drift hard fail")
    var fileRangeDrift = rawbytes.BytesAlloc(8)
    for i in 0..<8:
        rawbytes.BytesSet(fileRangeDrift, i, i * 19 + 7)
    rawbytes.BytesSet(fileRangeDrift, 3, rawbytes.BytesGet(fileRangeDrift, 3) ^ 1)
    assert(IsOk(os.WriteFileBytesResult(fileRangePath, fileRangeDrift)),
           " inference metal smoke: write drift range file")
    assert(IsErr(device.DeviceValidateFileRangeBufferLoadReceipt(metal, fileRangeBuffer, Value(fileRangeReceipt))),
           " inference metal smoke: file range content drift hard fail")
    let kernel = device.DeviceKernelFromKernelIr(metal, kir.KernelOpVectorAdd, vectorProgram.kernelHash)
    let launchRes = device.DeviceMetalLaunchKernel(metal, kernel, kir.KernelIrHashProgram(vectorProgram))
    assert(IsErr(launchRes), " inference metal smoke: generic launch must hard fail")

    let leftTensorLoad = device.DeviceMetalLoadTensorI32Buffer(metal, left)
    assert(IsOk(leftTensorLoad), " inference metal smoke: gemm left tensor buffer load")
    let rightTensorLoad = device.DeviceMetalLoadTensorI32Buffer(metal, right)
    assert(IsOk(rightTensorLoad), " inference metal smoke: gemm right tensor buffer load")
    let residentExpectedHash = device.DeviceTensorHash(matmulOut)
    assert(IsOk(residentExpectedHash), " inference metal smoke: resident gemm expected hash")
    var bufferGemmOut: infer.TensorQ
    let bufferGemmReceipt = device.DeviceMetalGemmBuffersFill(
        bufferGemmOut,
        metal,
        gemmProgram,
        Value(leftTensorLoad).buffer,
        Value(leftTensorLoad).receipt,
        Value(rightTensorLoad).buffer,
        Value(rightTensorLoad).receipt
    )
    assert(IsOk(bufferGemmReceipt), " inference metal smoke: buffer gemm host output launch")
    assertTensorExact(bufferGemmOut, matmulOut.data, " inference metal smoke: buffer gemm host output value")
    assert(Value(bufferGemmReceipt).status == device.InferenceDeviceKernelStatusLaunched &&
           Value(bufferGemmReceipt).kernelHash == gemmProgram.kernelHash &&
           Value(bufferGemmReceipt).inputHash > int64(0) &&
           Value(bufferGemmReceipt).outputHash == Value(residentExpectedHash) &&
           Value(bufferGemmReceipt).elapsedNs > int64(0),
        " inference metal smoke: buffer gemm host output receipt facts")
    let residentGemm = device.DeviceMetalGemmBuffersToBufferFill(
        metal,
        gemmProgram,
        Value(leftTensorLoad).buffer,
        Value(leftTensorLoad).receipt,
        Value(rightTensorLoad).buffer,
        Value(rightTensorLoad).receipt
    )
    assert(IsOk(residentGemm), " inference metal smoke: resident gemm launch")
    assert(Value(residentGemm).buffer.handle != uint64(0) &&
           Value(residentGemm).buffer.logicalHash == Value(residentExpectedHash) &&
           Value(residentGemm).receipt.status == device.InferenceDeviceKernelStatusLaunched &&
           Value(residentGemm).receipt.kernelHash == gemmProgram.kernelHash &&
           Value(residentGemm).receipt.inputHash == Value(bufferGemmReceipt).inputHash &&
           Value(residentGemm).receipt.outputHash == Value(residentExpectedHash) &&
           Value(residentGemm).receipt.elapsedNs > int64(0),
        " inference metal smoke: resident gemm receipt facts")
    assert(IsOk(device.DeviceMetalReleaseBuffer(Value(residentGemm).buffer)),
           " inference metal smoke: resident gemm output release")
    assert(IsOk(device.DeviceMetalReleaseBuffer(Value(leftTensorLoad).buffer)),
           " inference metal smoke: gemm left buffer release")
    assert(IsOk(device.DeviceMetalReleaseBuffer(Value(rightTensorLoad).buffer)),
           " inference metal smoke: gemm right buffer release")

    let linearInt4ExpectedHash = device.DeviceTensorHash(linearInt4Out)
    assert(IsOk(linearInt4ExpectedHash), " inference metal smoke: linear int4 expected hash")
    let linearInt4LeftLoad = device.DeviceMetalLoadTensorI32Buffer(metal, linearInt4Left)
    assert(IsOk(linearInt4LeftLoad), " inference metal smoke: linear int4 activation tensor buffer load")
    let linearInt4WeightLoad = device.DeviceMetalLoadRawTensorBytesBuffer(
        metal,
        kir.KernelDtypeInt4,
        linearInt4Right.shape,
        linearInt4Right.scale,
        linearInt4Right.packed
    )
    assert(IsOk(linearInt4WeightLoad), " inference metal smoke: linear int4 raw weight buffer load")
    var metalLinearInt4BufferOut: infer.TensorQ
    let metalLinearInt4BufferReceipt = device.DeviceMetalLinearOutInInt4WeightBuffersFill(
        metalLinearInt4BufferOut,
        metal,
        linearInt4Program,
        Value(linearInt4LeftLoad).buffer,
        Value(linearInt4LeftLoad).receipt,
        Value(linearInt4WeightLoad).buffer,
        Value(linearInt4WeightLoad).receipt
    )
    assert(IsOk(metalLinearInt4BufferReceipt), " inference metal smoke: linear int4 raw buffer launch")
    assertTensorExact(metalLinearInt4BufferOut, linearInt4Out.data,
        " inference metal smoke: linear int4 raw buffer value")
    assert(Value(metalLinearInt4BufferReceipt).status == device.InferenceDeviceKernelStatusLaunched &&
           Value(metalLinearInt4BufferReceipt).kernelHash == linearInt4Program.kernelHash &&
           Value(metalLinearInt4BufferReceipt).inputHash > int64(0) &&
           Value(metalLinearInt4BufferReceipt).outputHash == Value(linearInt4ExpectedHash) &&
           Value(metalLinearInt4BufferReceipt).elapsedNs > int64(0) &&
           Value(metalLinearInt4BufferReceipt).trace == "kernel_ir_facts->metal_linear_out_in_int4_buffers->host_output_receipt",
        " inference metal smoke: linear int4 raw buffer receipt facts")
    var badLinearInt4WeightReceipt = Value(linearInt4WeightLoad).receipt
    badLinearInt4WeightReceipt.rawBytesHash = badLinearInt4WeightReceipt.rawBytesHash + int64(1)
    badLinearInt4WeightReceipt.receiptHash = device.DeviceRawTensorBytesBufferLoadReceiptHash(badLinearInt4WeightReceipt)
    assert(IsErr(device.DeviceMetalLinearOutInInt4WeightBuffersFill(
        metalLinearInt4BufferOut,
        metal,
        linearInt4Program,
        Value(linearInt4LeftLoad).buffer,
        Value(linearInt4LeftLoad).receipt,
        Value(linearInt4WeightLoad).buffer,
        badLinearInt4WeightReceipt
    )), " inference metal smoke: linear int4 raw receipt drift hard fail")
    assert(IsOk(device.DeviceMetalReleaseBuffer(Value(linearInt4LeftLoad).buffer)),
           " inference metal smoke: linear int4 activation tensor buffer release")
    assert(IsOk(device.DeviceMetalReleaseBuffer(Value(linearInt4WeightLoad).buffer)),
           " inference metal smoke: linear int4 raw weight buffer release")

    let w4ExpectedHash = device.DeviceTensorHash(w4Out)
    assert(IsOk(w4ExpectedHash), " inference metal smoke: w4afp8 expected hash")
    let w4TensorLeftLoad = device.DeviceMetalLoadTensorI32Buffer(metal, w4Left)
    assert(IsOk(w4TensorLeftLoad), " inference metal smoke: w4afp8 activation tensor buffer load")
    let w4RawWeightLoad = device.DeviceMetalLoadRawTensorBytesBuffer(
        metal,
        kir.KernelDtypeInt8,
        w4Right.shape,
        w4Right.scale,
        w4Right.rawI8
    )
    assert(IsOk(w4RawWeightLoad), " inference metal smoke: w4afp8 raw weight tensor buffer load")
    let w4TensorWeightScaleLoad = device.DeviceMetalLoadTensorI32Buffer(metal, w4WeightScaleInv)
    assert(IsOk(w4TensorWeightScaleLoad), " inference metal smoke: w4afp8 weight scale tensor buffer load")
    let w4TensorInputScaleLoad = device.DeviceMetalLoadTensorI32Buffer(metal, w4InputScale)
    assert(IsOk(w4TensorInputScaleLoad), " inference metal smoke: w4afp8 input scale tensor buffer load")
    var metalW4TensorBufferOut: infer.TensorQ
    let metalW4TensorBufferReceipt = device.DeviceMetalLinearOutInW4Afp8TensorRawWeightScaleBuffersFill(
        metalW4TensorBufferOut,
        metal,
        w4Program,
        Value(w4TensorLeftLoad).buffer,
        Value(w4TensorLeftLoad).receipt,
        Value(w4RawWeightLoad).buffer,
        Value(w4RawWeightLoad).receipt,
        Value(w4TensorWeightScaleLoad).buffer,
        Value(w4TensorWeightScaleLoad).receipt,
        Value(w4TensorInputScaleLoad).buffer,
        Value(w4TensorInputScaleLoad).receipt
    )
    assert(IsOk(metalW4TensorBufferReceipt), " inference metal smoke: w4afp8 tensor raw buffer launch")
    assertTensorExact(metalW4TensorBufferOut, w4Out.data,
        " inference metal smoke: w4afp8 tensor raw buffer value")
