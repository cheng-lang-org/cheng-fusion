    assert(IsOk(pagedQueryTensorHash), " inference metal smoke: tensor i32 buffer hash")
    assert(Value(pagedQueryTensorLoad).buffer.handle != uint64(0) &&
           Value(pagedQueryTensorLoad).buffer.logicalHash == Value(pagedQueryTensorHash) &&
           Value(pagedQueryTensorLoad).receipt.schema == device.InferenceDeviceTensorBufferLoadReceiptSchema &&
           Value(pagedQueryTensorLoad).receipt.status == device.InferenceDeviceBufferLoadStatusMetalBufferLoaded &&
           Value(pagedQueryTensorLoad).receipt.deviceBufferHandle == Value(pagedQueryTensorLoad).buffer.handle &&
           Value(pagedQueryTensorLoad).receipt.tensorHash == Value(pagedQueryTensorHash) &&
           Value(pagedQueryTensorLoad).receipt.receiptHash == device.DeviceTensorBufferLoadReceiptHash(Value(pagedQueryTensorLoad).receipt),
           " inference metal smoke: tensor i32 buffer receipt facts")
    assert(IsOk(device.DeviceValidateTensorBufferLoadReceipt(
        metal,
        Value(pagedQueryTensorLoad).buffer,
        pagedQuery,
        Value(pagedQueryTensorLoad).receipt
    )), " inference metal smoke: tensor i32 buffer receipt validate")
    var badTensorReceipt = Value(pagedQueryTensorLoad).receipt
    badTensorReceipt.tensorDataHash = badTensorReceipt.tensorDataHash + int64(1)
    badTensorReceipt.receiptHash = device.DeviceTensorBufferLoadReceiptHash(badTensorReceipt)
    assert(IsErr(device.DeviceValidateTensorBufferLoadReceipt(
        metal,
        Value(pagedQueryTensorLoad).buffer,
        pagedQuery,
        badTensorReceipt
    )), " inference metal smoke: tensor i32 buffer receipt drift hard fail")
    assert(IsOk(device.DeviceMetalReleaseBuffer(Value(pagedQueryTensorLoad).buffer)),
           " inference metal smoke: tensor i32 buffer release")

    let pagedKeyPage0 = makeTensor([2, 2], 1000, [1000, 0, 0, 1000])
    let pagedKeyPage1 = makeTensor([2, 2], 1000, [2000, 0, 0, 2000])
    let pagedValuePage0 = makeTensor([2, 2], 1000, [10, 11, 20, 21])
    let pagedValuePage1 = makeTensor([2, 2], 1000, [30, 31, 40, 41])
    let metalTensorPageResident = device.DeviceMetalPagedAttentionTensorPageBuffersToBufferFill(
        metal,
        pagedProgram,
        pagedQuery,
        [pagedKeyPage0, pagedKeyPage1],
        [pagedValuePage0, pagedValuePage1],
        pagedTable
    )
    assert(IsOk(metalTensorPageResident),
        " inference metal smoke: tensor page-buffer resident paged attention launch")
    assertTensorExact(Value(metalTensorPageResident).output, [23, 24],
        " inference metal smoke: tensor page-buffer resident paged attention value")
    assert(Value(metalTensorPageResident).buffer.handle != uint64(0),
        " inference metal smoke: tensor page-buffer resident paged attention buffer handle")
    assert(Value(metalTensorPageResident).buffer.logicalHash == Value(metalTensorPageResident).receipt.outputHash,
        " inference metal smoke: tensor page-buffer resident paged attention buffer hash")
    assert(Value(metalTensorPageResident).receipt.status == device.InferenceDeviceKernelStatusLaunched,
        " inference metal smoke: tensor page-buffer resident paged attention status")
    assert(Value(metalTensorPageResident).receipt.kernelHash == pagedProgram.kernelHash,
        " inference metal smoke: tensor page-buffer resident paged attention kernel hash")
    assert(Value(metalTensorPageResident).receipt.inputHash > int64(0),
        " inference metal smoke: tensor page-buffer resident paged attention input hash")
    assert(Value(metalTensorPageResident).receipt.outputHash == Value(pagedExpectedHash),
        " inference metal smoke: tensor page-buffer resident paged attention output hash")
    assert(Value(metalTensorPageResident).receipt.trace == "kernel_ir_facts->tensor_metal_page_buffers->resident_output_buffer",
        " inference metal smoke: tensor page-buffer resident paged attention trace")
    assert(IsOk(device.DeviceMetalReleaseBuffer(Value(metalTensorPageResident).buffer)),
           " inference metal smoke: tensor page-buffer resident output release")
    let badTensorPagedTable = makeTensor([2], 1, [0, 7])
    assert(IsErr(device.DeviceMetalPagedAttentionTensorPageBuffersToBufferFill(
        metal,
        pagedProgram,
        pagedQuery,
        [pagedKeyPage0, pagedKeyPage1],
        [pagedValuePage0, pagedValuePage1],
        badTensorPagedTable
    )), " inference metal smoke: tensor page-buffer page ordinal hard fail")

    let pagedQueryPath = "/tmp/cheng_device_paged_attention_query_i32_buffer_smoke.bin"
    if os.FileExists(pagedQueryPath):
        assert(os.RemoveFile(pagedQueryPath), " inference metal smoke: remove old paged query file")
    var pagedQueryBytes = rawbytes.BytesAlloc(pagedQuery.data.len * 4 + 5)
    assert(pagedQueryBytes.data != nil, " inference metal smoke: paged query allocation")
    for i in 0..<pagedQuery.data.len:
        device.DeviceWriteI32LE(pagedQueryBytes, 4 + i * 4, pagedQuery.data[i])
    assert(IsOk(os.WriteFileBytesResult(pagedQueryPath, pagedQueryBytes)),
           " inference metal smoke: write paged query file")
    let pagedQueryLoad = device.DeviceMetalLoadFileRangeBuffer(
        metal,
        pagedQueryPath,
        int64(4),
        int64(pagedQuery.data.len * 4),
        4,
        kir.KernelDtypeI32
    )
    assert(IsOk(pagedQueryLoad), " inference metal smoke: paged query buffer load")
    let pagedKeysPath = "/tmp/cheng_device_paged_attention_keys_i32_buffer_smoke.bin"
    if os.FileExists(pagedKeysPath):
        assert(os.RemoveFile(pagedKeysPath), " inference metal smoke: remove old paged keys file")
    var pagedKeysBytes = rawbytes.BytesAlloc(pagedKeys.data.len * 4 + 7)
    assert(pagedKeysBytes.data != nil, " inference metal smoke: paged keys allocation")
    for i in 0..<pagedKeys.data.len:
        device.DeviceWriteI32LE(pagedKeysBytes, 3 + i * 4, pagedKeys.data[i])
    assert(IsOk(os.WriteFileBytesResult(pagedKeysPath, pagedKeysBytes)),
           " inference metal smoke: write paged keys file")
    let pagedKeysLoad = device.DeviceMetalLoadFileRangeBuffer(
        metal,
        pagedKeysPath,
        int64(3),
        int64(pagedKeys.data.len * 4),
        4,
        kir.KernelDtypeI32
    )
    assert(IsOk(pagedKeysLoad), " inference metal smoke: paged keys buffer load")
    let pagedValuesPath = "/tmp/cheng_device_paged_attention_values_i32_buffer_smoke.bin"
    if os.FileExists(pagedValuesPath):
        assert(os.RemoveFile(pagedValuesPath), " inference metal smoke: remove old paged values file")
    var pagedValuesBytes = rawbytes.BytesAlloc(pagedValues.data.len * 4 + 9)
    assert(pagedValuesBytes.data != nil, " inference metal smoke: paged values allocation")
    for i in 0..<pagedValues.data.len:
        device.DeviceWriteI32LE(pagedValuesBytes, 5 + i * 4, pagedValues.data[i])
    assert(IsOk(os.WriteFileBytesResult(pagedValuesPath, pagedValuesBytes)),
           " inference metal smoke: write paged values file")
    let pagedValuesLoad = device.DeviceMetalLoadFileRangeBuffer(
        metal,
        pagedValuesPath,
        int64(5),
        int64(pagedValues.data.len * 4),
        4,
        kir.KernelDtypeI32
    )
    assert(IsOk(pagedValuesLoad), " inference metal smoke: paged values buffer load")
    let pagedTablePath = "/tmp/cheng_device_paged_attention_table_i32_buffer_smoke.bin"
    if os.FileExists(pagedTablePath):
        assert(os.RemoveFile(pagedTablePath), " inference metal smoke: remove old paged table file")
    var pagedTableBytes = rawbytes.BytesAlloc(pagedTable.data.len * 4 + 6)
    assert(pagedTableBytes.data != nil, " inference metal smoke: paged table allocation")
    for i in 0..<pagedTable.data.len:
        device.DeviceWriteI32LE(pagedTableBytes, 2 + i * 4, pagedTable.data[i])
    assert(IsOk(os.WriteFileBytesResult(pagedTablePath, pagedTableBytes)),
           " inference metal smoke: write paged table file")
    let pagedTableLoad = device.DeviceMetalLoadFileRangeBuffer(
        metal,
        pagedTablePath,
        int64(2),
        int64(pagedTable.data.len * 4),
        4,
        kir.KernelDtypeI32
    )
    assert(IsOk(pagedTableLoad), " inference metal smoke: paged table buffer load")
    let metalPagedResidentResult = device.DeviceMetalPagedAttentionBuffersToBufferFill(
        metal,
        pagedProgram,
        Value(pagedQueryLoad).buffer,
        Value(pagedQueryLoad).receipt,
        Value(pagedKeysLoad).buffer,
        Value(pagedKeysLoad).receipt,
        Value(pagedValuesLoad).buffer,
        Value(pagedValuesLoad).receipt,
        Value(pagedTableLoad).buffer,
        Value(pagedTableLoad).receipt
    )
    assert(IsOk(metalPagedResidentResult),
        " inference metal smoke: paged attention resident output buffer launch")
    assertTensorExact(Value(metalPagedResidentResult).output, [23, 24],
        " inference metal smoke: paged attention resident output value")
    assert(Value(metalPagedResidentResult).buffer.handle != uint64(0) &&
           Value(metalPagedResidentResult).buffer.sizeBytes == int64(8) &&
           Value(metalPagedResidentResult).buffer.dtype == kir.KernelDtypeI32 &&
           Value(metalPagedResidentResult).buffer.logicalHash == Value(metalPagedResidentResult).receipt.outputHash &&
           Value(metalPagedResidentResult).receipt.status == device.InferenceDeviceKernelStatusLaunched &&
           Value(metalPagedResidentResult).receipt.kernelHash == pagedProgram.kernelHash &&
           Value(metalPagedResidentResult).receipt.inputHash > int64(0) &&
           Value(metalPagedResidentResult).receipt.outputHash > int64(0) &&
           Value(metalPagedResidentResult).receipt.elapsedNs > int64(0),
        " inference metal smoke: paged attention resident output buffer facts")
    assert(IsOk(device.DeviceMetalReleaseBuffer(Value(metalPagedResidentResult).buffer)),
           " inference metal smoke: paged attention resident output buffer release")
    var badPagedTableReceipt = Value(pagedTableLoad).receipt
    badPagedTableReceipt.sourceRangeHash = badPagedTableReceipt.sourceRangeHash + int64(1)
    badPagedTableReceipt.receiptHash = device.DeviceFileRangeBufferLoadReceiptHash(badPagedTableReceipt)
    assert(IsErr(device.DeviceMetalPagedAttentionBuffersToBufferFill(
        metal,
        pagedProgram,
        Value(pagedQueryLoad).buffer,
        Value(pagedQueryLoad).receipt,
        Value(pagedKeysLoad).buffer,
        Value(pagedKeysLoad).receipt,
        Value(pagedValuesLoad).buffer,
        Value(pagedValuesLoad).receipt,
        Value(pagedTableLoad).buffer,
        badPagedTableReceipt
    )), " inference metal smoke: paged resident output page table receipt drift hard fail")
    let badPagedTablePath = "/tmp/cheng_device_paged_attention_bad_table_i32_buffer_smoke.bin"
    if os.FileExists(badPagedTablePath):
        assert(os.RemoveFile(badPagedTablePath), " inference metal smoke: remove old bad paged table file")
    var badPagedTableBytes = rawbytes.BytesAlloc(8)
    assert(badPagedTableBytes.data != nil, " inference metal smoke: bad paged table allocation")
    device.DeviceWriteI32LE(badPagedTableBytes, 0, 0)
    device.DeviceWriteI32LE(badPagedTableBytes, 4, 7)
    assert(IsOk(os.WriteFileBytesResult(badPagedTablePath, badPagedTableBytes)),
           " inference metal smoke: write bad paged table file")
    let badPagedTableLoad = device.DeviceMetalLoadFileRangeBuffer(
        metal,
        badPagedTablePath,
        int64(0),
        int64(8),
        4,
        kir.KernelDtypeI32
    )
    assert(IsOk(badPagedTableLoad), " inference metal smoke: bad paged table buffer load")
    assert(IsErr(device.DeviceMetalPagedAttentionBuffersToBufferFill(
        metal,
        pagedProgram,
        Value(pagedQueryLoad).buffer,
        Value(pagedQueryLoad).receipt,
        Value(pagedKeysLoad).buffer,
        Value(pagedKeysLoad).receipt,
        Value(pagedValuesLoad).buffer,
        Value(pagedValuesLoad).receipt,
        Value(badPagedTableLoad).buffer,
        Value(badPagedTableLoad).receipt
    )), " inference metal smoke: paged resident output page ordinal hard fail")
    assert(IsOk(device.DeviceMetalReleaseBuffer(Value(badPagedTableLoad).buffer)),
           " inference metal smoke: bad paged table buffer release")
    assert(IsOk(device.DeviceMetalReleaseBuffer(Value(pagedTableLoad).buffer)),
           " inference metal smoke: paged table buffer release")
    assert(IsOk(device.DeviceMetalReleaseBuffer(Value(pagedValuesLoad).buffer)),
           " inference metal smoke: paged values buffer release")
    assert(IsOk(device.DeviceMetalReleaseBuffer(Value(pagedKeysLoad).buffer)),
           " inference metal smoke: paged keys buffer release")
    assert(IsOk(device.DeviceMetalReleaseBuffer(Value(pagedQueryLoad).buffer)),
           " inference metal smoke: paged query buffer release")

    echo(" inference_kernel_metal_smoke ok")
    return 0
