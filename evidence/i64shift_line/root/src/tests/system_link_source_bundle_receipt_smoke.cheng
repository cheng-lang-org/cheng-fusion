import std/strutils as strutil
import cheng/std/bytes_layout as layout
import cheng/core/backend/system_link_plan as slplan
import cheng/core/backend/system_link_exec as sexec
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/tooling/compiler_request as creq

fn SourceBundleReceiptRoot(): str =
    return "/tmp/system-link-source-bundle-receipt"

fn SourceBundleReceiptEntrySource(): str =
    return "/tmp/system-link-source-bundle-receipt/src/tests/entry.cheng"

fn SourceBundleReceiptEntryModule(): str =
    return "cheng/tests/entry"

fn SourceBundleReceiptFixture(
        receipt: var sexec.SystemLinkExecSourceBundleReceipt) =
    receipt = sexec.SystemLinkExecSourceBundleReceipt()
    receipt.entrySourceIndex = 0
    var sourceBundleCid: layout.FixedBytes32
    sourceBundleCid.data[0] = uint8(1)
    receipt.sourceBundleCid = sourceBundleCid
    var entrySourceCid: layout.FixedBytes32
    entrySourceCid.data[0] = uint8(7)
    receipt.entrySourceCid = entrySourceCid
    var importGraphCid: layout.FixedBytes32
    importGraphCid.data[0] = uint8(8)
    receipt.importGraphCid = importGraphCid
    var bindingSeal: layout.FixedBytes32
    bindingSeal.data[0] = uint8(2)
    receipt.bindingSeal = bindingSeal
    receipt.entryIdentitySeal =
        sexec.SystemLinkExecSourceBundleEntryIdentitySeal(
            "cheng",
            SourceBundleReceiptEntryModule(),
            receipt.sourceBundleCid,
            receipt.bindingSeal)
    receipt.sourceClosureCount = 1
    receipt.sourceIdentityCount = 1
    receipt.ownerModuleCount = 1
    receipt.importEdgeCount = 0
    receipt.unresolvedImportCount = 0
    var sourceReceipt: ccsg.PortableSourceIdentityReceipt
    var makeErr: str
    let makeOk = ccsg.PortableSourceIdentityReceiptMakeInto(
        receipt.sourceClosureCount,
        receipt.importEdgeCount,
        receipt.unresolvedImportCount,
        "cheng",
        SourceBundleReceiptEntryModule(),
        receipt.sourceBundleCid,
        receipt.entrySourceCid,
        receipt.importGraphCid,
        sourceReceipt,
        makeErr)
    assert(makeOk, makeErr)
    receipt.sourcePackageIdCid = sourceReceipt.sourcePackageIdCid
    receipt.entryModulePathCid = sourceReceipt.entryModulePathCid
    receipt.sourceIdentityReceiptCid = sourceReceipt.receiptCid
    receipt.receiptSeal =
        sexec.SystemLinkExecSourceBundleReceiptComputeSeal(receipt)

fn main(): int32 =
    var canonicalCsgCid: layout.FixedBytes32
    canonicalCsgCid.data[0] = uint8(11)
    var providers = ["runtime/core_runtime"]
    let objOutputDigest = sexec.SystemLinkExecCanonicalOutputDigest(
        creq.EmitObj,
        creq.CompilerSymbolVisibilityPublic(),
        "arm64-apple-darwin",
        providers,
        canonicalCsgCid)
    let exeOutputDigest = sexec.SystemLinkExecCanonicalOutputDigest(
        creq.EmitExe,
        creq.CompilerSymbolVisibilityPublic(),
        "arm64-apple-darwin",
        providers,
        canonicalCsgCid)
    let hiddenOutputDigest = sexec.SystemLinkExecCanonicalOutputDigest(
        creq.EmitObj,
        creq.CompilerSymbolVisibilityInternal(),
        "arm64-apple-darwin",
        providers,
        canonicalCsgCid)
    assert(!layout.FixedBytes32Equal(objOutputDigest, exeOutputDigest),
           " source bundle receipt: obj/exe canonical output collision")
    assert(!layout.FixedBytes32Equal(objOutputDigest, hiddenOutputDigest),
           " source bundle receipt: visibility canonical output collision")
    var sourceIdentityReceiptCid: layout.FixedBytes32
    sourceIdentityReceiptCid.data[0] = uint8(12)
    var semanticReceiptCid: layout.FixedBytes32
    semanticReceiptCid.data[0] = uint8(13)
    let sourceToCsgSeal = sexec.SystemLinkExecSourceToCsgBindingSeal(
        sourceIdentityReceiptCid,
        canonicalCsgCid,
        semanticReceiptCid)
    semanticReceiptCid.data[0] = uint8(14)
    let semanticTamperSeal = sexec.SystemLinkExecSourceToCsgBindingSeal(
        sourceIdentityReceiptCid,
        canonicalCsgCid,
        semanticReceiptCid)
    assert(!layout.FixedBytes32Equal(sourceToCsgSeal,
                                     semanticTamperSeal),
           " source bundle receipt: plan binding seal omitted semantic receipt")

    var semanticReceipt: sexec.CompileSemanticReceipt
    semanticReceipt.sourceIdentityReceiptCid = sourceIdentityReceiptCid
    semanticReceipt.canonicalCompilerCsgCid = canonicalCsgCid
    semanticReceipt.canonicalOutputDigest = objOutputDigest
    semanticReceipt.targetTripleCid.data[0] = uint8(15)
    semanticReceipt.bootstrapStageCid.data[0] = uint8(16)
    semanticReceipt.orderedProviderSetCid.data[0] = uint8(17)
    semanticReceipt.receiptCid =
        sexec.SystemLinkExecCompileSemanticReceiptCid(semanticReceipt)
    var semanticErr: str
    assert(sexec.SystemLinkExecCompileSemanticReceiptSelfValidateInto(
               semanticReceipt,
               semanticErr),
           Fmt" source bundle receipt: semantic self-validation failed err={semanticErr}")
    let semanticReport =
        sexec.SystemLinkExecCompileSemanticReceiptReport(semanticReceipt)
    var parsedSemanticReceipt: sexec.CompileSemanticReceipt
    let semanticParse =
        sexec.SystemLinkExecCompileSemanticReceiptFromReportText(
            semanticReport,
            parsedSemanticReceipt)
    assert(IsOk(semanticParse) && Value(semanticParse) &&
           layout.FixedBytes32Equal(parsedSemanticReceipt.receiptCid,
                                    semanticReceipt.receiptCid),
           " source bundle receipt: semantic report roundtrip drift")
    assert(IsErr(sexec.SystemLinkExecCompileSemanticReceiptFromReportText(
                     strutil.Join([semanticReport,
                                   "\nunknown_field=1"], ""),
                     parsedSemanticReceipt)),
           " source bundle receipt: semantic report accepted extra field")
    let semanticReordered = strutil.Replace(
        semanticReport,
        strutil.Join([
            "source_identity_receipt_cid=",
            layout.FixedBytes32Hex(sourceIdentityReceiptCid),
            "\ncanonical_compiler_csg_cid=",
            layout.FixedBytes32Hex(canonicalCsgCid)
        ], ""),
        strutil.Join([
            "canonical_compiler_csg_cid=",
            layout.FixedBytes32Hex(canonicalCsgCid),
            "\nsource_identity_receipt_cid=",
            layout.FixedBytes32Hex(sourceIdentityReceiptCid)
        ], ""))
    assert(IsErr(sexec.SystemLinkExecCompileSemanticReceiptFromReportText(
                     semanticReordered,
                     parsedSemanticReceipt)),
           " source bundle receipt: semantic report accepted reordered fields")
    let semanticDuplicateField = strutil.Replace(
        semanticReport,
        "canonical_compiler_csg_cid=",
        "source_identity_receipt_cid=")
    assert(IsErr(sexec.SystemLinkExecCompileSemanticReceiptFromReportText(
                     semanticDuplicateField,
                     parsedSemanticReceipt)),
           " source bundle receipt: semantic report accepted duplicate field")
    let semanticCidTamper = strutil.Replace(
        semanticReport,
        layout.FixedBytes32Hex(objOutputDigest),
        layout.FixedBytes32Hex(hiddenOutputDigest))
    assert(IsErr(sexec.SystemLinkExecCompileSemanticReceiptFromReportText(
                     semanticCidTamper,
                     parsedSemanticReceipt)),
           " source bundle receipt: semantic report accepted field mutation")

    var receipt: sexec.SystemLinkExecSourceBundleReceipt
    SourceBundleReceiptFixture(receipt)
    var err: str
    assert(sexec.SystemLinkExecSourceBundleReceiptValidInto(receipt, err) &&
           len(err) == 0,
           Fmt" source bundle receipt: valid fixture size={sexec.SystemLinkExecSourceBundleReceiptFixedLiveBytes()} err={err}")
    assert(sexec.SystemLinkExecSourceBundleReceiptFixedBytes == int64(312),
           " source bundle receipt: fixed byte count")
    assert(sexec.SystemLinkExecSourceBundleReceiptFixedLiveBytes() ==
               sexec.SystemLinkExecSourceBundleReceiptFixedBytes,
           " source bundle receipt: fixed ABI byte count")

    receipt.sourceIdentityCount = 2
    assert(!sexec.SystemLinkExecSourceBundleReceiptValidInto(receipt,
                                                             err) &&
           strutil.Contains(err, "column counts mismatch"),
           " source bundle receipt: count tamper")
    receipt.sourceIdentityCount = 1

    let sourceBundleCidByte = receipt.sourceBundleCid.data[0]
    receipt.sourceBundleCid.data[0] = uint8(3)
    assert(!sexec.SystemLinkExecSourceBundleReceiptValidInto(receipt, err) &&
           strutil.Contains(err, "scalar seal mismatch"),
           " source bundle receipt: cid tamper")
    receipt.sourceBundleCid.data[0] = sourceBundleCidByte

    let entryIdentitySealByte = receipt.entryIdentitySeal.data[0]
    receipt.entryIdentitySeal.data[0] = uint8(5)
    assert(!sexec.SystemLinkExecSourceBundleReceiptValidInto(receipt,
                                                             err) &&
           strutil.Contains(err, "scalar seal mismatch"),
           " source bundle receipt: entry seal tamper")
    receipt.entryIdentitySeal.data[0] = entryIdentitySealByte

    var plan: sexec.SystemLinkExecPlan
    plan.sourceBundleCid.data[0] = sourceBundleCidByte
    plan.sourceBundleReceipt = receipt
    plan.compilerEntrySource = SourceBundleReceiptEntrySource()
    plan.systemLinkPlan.workspaceRoot = SourceBundleReceiptRoot()
    plan.systemLinkPlan.packageRoot = SourceBundleReceiptRoot()
    plan.systemLinkPlan.packageId = "cheng"
    plan.systemLinkPlan.entryPath = SourceBundleReceiptEntrySource()
    plan.systemLinkPlan.buildEntryPath = SourceBundleReceiptEntrySource()
    plan.systemLinkPlan.moduleStem = SourceBundleReceiptEntryModule()
    var entryModulePath: str
    assert(sexec.SystemLinkExecPlanSourceBundleReceiptValidInto(
               plan,
               entryModulePath,
               err) &&
           entryModulePath == SourceBundleReceiptEntryModule() &&
           len(err) == 0,
           Fmt" source bundle receipt: plan binding err={err}")
    plan.sourceBundleCid.data[0] = uint8(4)
    assert(!sexec.SystemLinkExecPlanSourceBundleReceiptValidInto(
                plan,
                entryModulePath,
                err) &&
           strutil.Contains(err, "receipt/plan cid mismatch"),
           " source bundle receipt: plan cid tamper")
    plan.sourceBundleCid.data[0] = sourceBundleCidByte

    let otherEntry =
        "/tmp/system-link-source-bundle-receipt/src/tests/other.cheng"
    plan.compilerEntrySource = otherEntry
    plan.systemLinkPlan.entryPath = otherEntry
    plan.systemLinkPlan.buildEntryPath = otherEntry
    plan.systemLinkPlan.moduleStem = "cheng/tests/other"
    assert(!sexec.SystemLinkExecPlanSourceBundleReceiptValidInto(
                plan,
                entryModulePath,
                err) &&
           strutil.Contains(err, "entry identity mismatch"),
           " source bundle receipt: coordinated entry tamper")

    echo(" system_link_source_bundle_receipt_smoke ok")
    return 0
