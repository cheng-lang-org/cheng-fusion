# rwad_query_service_smoke (qs7): RWAD read-only query surface end to end.
# SsmState setup (credit 3000, escrow-lock 2000), wire encode/decode
# roundtrip for both kinds, query execution over live state, 35-byte
# truncation rejected, unsupported kind rejected, fixed 9-byte response.

import std/os
import std/system
import std/rawbytes
import cheng/std/bytes_layout as layout
import cheng/apps/rwad/rwad_settlement as ssm
import cheng/apps/rwad/rwad_query_service as qs
import cheng/apps/rwad/rwad_query_exec as qx

fn CidTag(b: int32): layout.FixedBytes32 =
    var raw = BytesAlloc(32)
    BytesSet(raw, 0, b)
    let res = layout.FixedBytes32FromBytes(raw)
    return res.value

fn main(): int32 =
    var rc: int32 = 0

    # state: payer holds 3000, locks 2000 into escrow CidTag(2)
    var st = ssm.SsmInit()
    let payer = CidTag(1)
    let escrowCid = CidTag(2)
    let cRes = ssm.SsmCredit(st, payer, Int64(3000))
    if !cRes.ok:
        os.WriteLine(os.Get_stderr(), "credit payer failed")
        return 1
    let lRes = ssm.SsmEscrowLock(st, escrowCid, payer, Int64(2000), Int64(0))
    if !lRes.ok:
        os.WriteLine(os.Get_stderr(), "escrow lock failed")
        return 1

    # case 1: balance request {kind=1, payer} encodes to 36 bytes,
    # decodes back with kind==1 and identical keyCid, executes to 1000
    var req1: qs.QueryRequest
    req1.kind = qs.QsKindBalance
    req1.keyCid = payer
    let wire1 = qs.QueryEncode(req1)
    if wire1.len != 36:
        os.WriteLine(os.Get_stderr(), "balance request wire len wrong")
        rc = rc + 1
    let dec1 = qs.QueryDecode(wire1)
    if !dec1.ok:
        os.WriteLine(os.Get_stderr(), "balance request decode failed")
        rc = rc + 1
    else:
        let got1 = dec1.value
        if got1.kind != 1:
            os.WriteLine(os.Get_stderr(), "balance request kind wrong")
            rc = rc + 1
        if !layout.FixedBytes32Equal(got1.keyCid, payer):
            os.WriteLine(os.Get_stderr(), "balance request key mismatch")
            rc = rc + 1
        let ex1 = qx.QueryExecute(st, got1)
        if !ex1.ok:
            os.WriteLine(os.Get_stderr(), "balance execute failed")
            rc = rc + 1
        else:
            if ex1.value != 1000:
                os.WriteLine(os.Get_stderr(), "balance value wrong")
                rc = rc + 1

    # case 2: escrow-locked request {kind=2, escrow} roundtrip -> 2000
    var req2: qs.QueryRequest
    req2.kind = qs.QsKindEscrowLocked
    req2.keyCid = escrowCid
    let wire2 = qs.QueryEncode(req2)
    let dec2 = qs.QueryDecode(wire2)
    if !dec2.ok:
        os.WriteLine(os.Get_stderr(), "escrow request decode failed")
        rc = rc + 1
    else:
        let got2 = dec2.value
        if got2.kind != 2:
            os.WriteLine(os.Get_stderr(), "escrow request kind wrong")
            rc = rc + 1
        if !layout.FixedBytes32Equal(got2.keyCid, escrowCid):
            os.WriteLine(os.Get_stderr(), "escrow request key mismatch")
            rc = rc + 1
        let ex2 = qx.QueryExecute(st, got2)
        if !ex2.ok:
            os.WriteLine(os.Get_stderr(), "escrow execute failed")
            rc = rc + 1
        else:
            if ex2.value != 2000:
                os.WriteLine(os.Get_stderr(), "escrow locked value wrong")
                rc = rc + 1

    # case 3: a 35-byte truncation of a valid request must decode Err
    var trunc35 = BytesAlloc(35)
    var i: int32
    while i < 35:
        BytesSet(trunc35, i, BytesGet(wire1, i))
        i = i + 1
    let decT = qs.QueryDecode(trunc35)
    if decT.ok:
        os.WriteLine(os.Get_stderr(), "truncated request accepted")
        rc = rc + 1

    # case 4: unsupported kind 9 must execute Err
    var bad9: qs.QueryRequest
    bad9.kind = 9
    bad9.keyCid = payer
    let ex9 = qx.QueryExecute(st, bad9)
    if ex9.ok:
        os.WriteLine(os.Get_stderr(), "kind 9 accepted")
        rc = rc + 1

    # case 5: response wire for (true, 1000): length 9, first byte 1
    let resp = qx.QueryResponseWire(true, Int64(1000))
    if resp.len != 9:
        os.WriteLine(os.Get_stderr(), "response wire len wrong")
        rc = rc + 1
    if BytesGet(resp, 0) != 1:
        os.WriteLine(os.Get_stderr(), "response ok byte wrong")
        rc = rc + 1

    if rc == 0:
        echo("rwad_query_service_smoke ok")
    return rc
