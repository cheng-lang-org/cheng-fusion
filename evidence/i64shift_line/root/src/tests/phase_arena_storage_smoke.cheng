import std/system
import cheng/core/ir/phase_arena as phase

fn main(): int32 =
    assert(sizeof(str) == 24,
           "phase arena storage smoke: Cheng str ABI must be 24 bytes")
    assert(sizeof(phase.PhaseArena) == 32,
           "phase arena storage smoke: legacy five-scalar ABI drift")

    let allocBefore = system.memAllocCount()
    let freeBefore = system.memFreeCount()
    let liveBefore = system.memLiveCount()
    let retainBefore = system.memRetainCount()
    let releaseBefore = system.memReleaseCount()

    var store: phase.PhaseArenaStore
    phase.PhaseArenaStoreInit(store, 2, 160, 8)
    let initAllocDelta = system.memAllocCount() - allocBefore
    let initLiveDelta = system.memLiveCount() - liveBefore
    var scratch = phase.PhaseArenaStoreOpenArena(store, 1, 96, 4)
    var survivorArena = phase.PhaseArenaStoreOpenArena(store, 2, 64, 4)

    let column = phase.PhaseArenaStoreReserveI32Column(store, scratch, 4)
    phase.PhaseArenaStoreI32ColumnSet(store, scratch, column, 0, 7)
    phase.PhaseArenaStoreI32ColumnSet(store, scratch, column, 1, -9)
    phase.PhaseArenaStoreI32ColumnSet(store, scratch, column, 2, 0x12345678)
    phase.PhaseArenaStoreI32ColumnSet(store, scratch, column, 3, -2147483647)
    assert(phase.PhaseArenaStoreI32ColumnGet(store, scratch, column, 0) == 7 &&
           phase.PhaseArenaStoreI32ColumnGet(store, scratch, column, 1) == -9 &&
           phase.PhaseArenaStoreI32ColumnGet(store, scratch, column, 2) == 0x12345678 &&
           phase.PhaseArenaStoreI32ColumnGet(store, scratch, column, 3) == -2147483647,
           "phase arena storage smoke: fixed i32 SoA")

    let internIds = phase.PhaseArenaStoreReserveInternIdColumn(
        store, scratch, 2)
    phase.PhaseArenaStoreInternIdSet(store, scratch, internIds, 0, 101)
    phase.PhaseArenaStoreInternIdSet(store, scratch, internIds, 1, 202)
    assert(phase.PhaseArenaStoreInternIdGet(store, scratch, internIds, 0) == 101 &&
           phase.PhaseArenaStoreInternIdGet(store, scratch, internIds, 1) == 202,
           "phase arena storage smoke: text uses intern ids")

    var bytes = phase.PhaseArenaStoreAllocRefAligned(store, scratch, 7, 8)
    phase.PhaseArenaStoreFill(store, scratch, bytes, 0xA5)
    phase.PhaseArenaStoreSetByte(store, scratch, bytes, 3, 0x3C)
    assert(phase.PhaseArenaStoreGetByte(store, scratch, bytes, 0) == 0xA5 &&
           phase.PhaseArenaStoreGetByte(store, scratch, bytes, 3) == 0x3C &&
           phase.PhaseArenaStoreGetByte(store, scratch, bytes, 6) == 0xA5,
           "phase arena storage smoke: byte storage")

    let before = phase.PhaseArenaStoreArenaReport(store, scratch)
    assert(before.arenaId == 1 && before.generation == 1 &&
           before.capacityBytes == 96 && before.usedBytes == 31 &&
           before.peakBytes == 31 && before.allocationCount == 3 &&
           before.liveAllocationCount == 3 && before.liveBytes == 31 &&
           before.survivorCount == 0 && before.survivorBytes == 0 &&
           before.resetCount == 0 && before.spillCount == 0 &&
           before.retainedStoreBytes == phase.PhaseArenaStoreRetainedBytes(store),
           "phase arena storage smoke: pre-rehome ledger")

    let survivor = phase.PhaseArenaStoreRehome(
        store, scratch, bytes, survivorArena)
    assert(!phase.PhaseArenaRefIsValid(bytes),
           "phase arena storage smoke: source ref invalidated")
    assert(phase.PhaseArenaStoreGetByte(store, survivorArena, survivor, 0) == 0xA5 &&
           phase.PhaseArenaStoreGetByte(store, survivorArena, survivor, 3) == 0x3C &&
           phase.PhaseArenaStoreGetByte(store, survivorArena, survivor, 6) == 0xA5,
           "phase arena storage smoke: survivor bytes")

    let afterRehome = phase.PhaseArenaStoreArenaReport(store, scratch)
    assert(afterRehome.liveAllocationCount == 2 &&
           afterRehome.liveBytes == 24 &&
           afterRehome.survivorCount == 1 &&
           afterRehome.survivorBytes == 7,
           "phase arena storage smoke: rehome ledger")

    let oldGeneration = scratch.generation
    phase.PhaseArenaStoreResetArena(store, scratch)
    assert(scratch.generation == oldGeneration + 1,
           "phase arena storage smoke: reset generation")
    let afterReset = phase.PhaseArenaStoreArenaReport(store, scratch)
    assert(afterReset.generation == 2 && afterReset.usedBytes == 0 &&
           afterReset.liveAllocationCount == 0 && afterReset.liveBytes == 0 &&
           afterReset.survivorCount == 0 && afterReset.survivorBytes == 0 &&
           afterReset.resetCount == 1 && afterReset.peakBytes == 31,
           "phase arena storage smoke: reset ledger")

    let nextColumn = phase.PhaseArenaStoreReserveI32Column(store, scratch, 2)
    phase.PhaseArenaStoreI32ColumnSet(store, scratch, nextColumn, 1, 91)
    assert(phase.PhaseArenaStoreI32ColumnGet(store, scratch, nextColumn, 1) == 91,
           "phase arena storage smoke: generation reuse")

    phase.PhaseArenaStoreCloseArena(store, scratch)
    phase.PhaseArenaStoreCloseArena(store, survivorArena)
    phase.PhaseArenaStoreDestroy(store)

    let allocDelta = system.memAllocCount() - allocBefore
    let freeDelta = system.memFreeCount() - freeBefore
    let liveDelta = system.memLiveCount() - liveBefore
    let retainDelta = system.memRetainCount() - retainBefore
    let releaseDelta = system.memReleaseCount() - releaseBefore
    assert(allocDelta == freeDelta,
           "phase arena storage smoke: ORC alloc/free imbalance")
    assert(liveDelta == 0,
           "phase arena storage smoke: ORC live allocation leak")
    echo(Fmt"phase_arena_orc_alloc_delta={allocDelta}")
    echo(Fmt"phase_arena_orc_free_delta={freeDelta}")
    echo(Fmt"phase_arena_orc_live_delta={liveDelta}")
    echo(Fmt"phase_arena_orc_init_alloc_delta={initAllocDelta}")
    echo(Fmt"phase_arena_orc_init_live_delta={initLiveDelta}")
    echo(Fmt"phase_arena_orc_retain_delta={retainDelta}")
    echo(Fmt"phase_arena_orc_release_delta={releaseDelta}")
    echo("PHASE_ARENA_STORAGE_OK")
    return 0
