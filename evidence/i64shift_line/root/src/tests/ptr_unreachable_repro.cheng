importc fn cheng_crypto_random_bytes(buf: ptr, len: int32): int32

fn DeadRandomFill(out: var int32[], n: int32): bool =
    let byteCount = n * 4
    for i in 0..<n:
        out[i] = 0
    if cheng_crypto_random_bytes(ptr(out), byteCount) != byteCount:
        return false
    return true

fn main(): int32 =
    var xs: int32[]
    setLen(xs, 2)
    if xs.len != 2:
        return 1
    return 0
