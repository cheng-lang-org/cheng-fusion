# 本地决策头冒烟 (任务 11 首切片 verify a-f)。
#
# 独立数值 oracle 对拍: 暴力参考实现与 decision_heads 的算法不同构 --
#   Choice 排列: O(n^2) 逐点支配 (c 入选/入并列集 <=> 无 j 严格支配 c,
#                或等值占先 j<c), 与实现的两遍扫描不同构
#   Score 排列:  计数法 (位置 = 严格更大数个数 + 等值占先数)
#   Score 加权:  无检查直和 (数值 oracle 只用于远离溢出域的向量;
#                溢出/边界域用倍增构造的期望值逐位断言 2^k/int64 上下界)
#
# a. Choice: 常规 argmax / 全并列 / 部分并列 / 负 logits / 单候选 / 空候选 no-match
# b. 置换等变性: 同一打分在候选置换后映射回原索引一致
# c. 候选数量变化: 增删候选不改变剩余候选间相对判定
# d. Noul: 阈值上下 / 恰等触发 (显式合同 >=) / 负值输入
# e. Score: 常规排列 / 全并列 / 含 0 与负分 / 权重和溢出显式拒绝 / 等级数 2..10 边界
# f. 批量结构: 多问题切片索引逐位正确 (含 0 问题、单问题边界) + 反例账拒绝

import std/strings
import std/result
import cheng/core/runtime/csg_decision_contract as dc
import cheng/inference/decision_heads as dh

# ---- 构造辅助 ----

fn smokeEmptyI32(): int32[] =
    var r: int32[]
    return r

fn smokeEmptyI64(): int64[] =
    var r: int64[]
    return r

fn smokePow2(exp: int32): int64 =
    var m: int64 = 1
    var i: int32 = 0
    while i < exp:
        m = m * 2
        i = i + 1
    return m

fn smokeI64Max(): int64 =
    let m = smokePow2(62)
    return (m - 1) + m

fn smokeI64Min(): int64 =
    let m = smokePow2(62)
    return (0 - m) - m

fn smokeLogits(data: int32[], scale: int32): dh.DecisionLogits =
    var out: dh.DecisionLogits
    out.data = data
    out.scale = scale
    return out

fn smokeArr1(a: int32): int32[] =
    var r: int32[]
    add(r, a)
    return r

fn smokeArr2(a: int32, b: int32): int32[] =
    var r: int32[]
    add(r, a)
    add(r, b)
    return r

fn smokeArr3(a: int32, b: int32, c: int32): int32[] =
    var r: int32[]
    add(r, a)
    add(r, b)
    add(r, c)
    return r

fn smokeArr4(a: int32, b: int32, c: int32, d: int32): int32[] =
    var r: int32[]
    add(r, a)
    add(r, b)
    add(r, c)
    add(r, d)
    return r

fn smokeArr5(a: int32, b: int32, c: int32, d: int32, e: int32): int32[] =
    var r: int32[]
    add(r, a)
    add(r, b)
    add(r, c)
    add(r, d)
    add(r, e)
    return r

fn smokeW1(a: int64): int64[] =
    var r: int64[]
    add(r, a)
    return r

fn smokeW2(a: int64, b: int64): int64[] =
    var r: int64[]
    add(r, a)
    add(r, b)
    return r

fn smokeW3(a: int64, b: int64, c: int64): int64[] =
    var r: int64[]
    add(r, a)
    add(r, b)
    add(r, c)
    return r

fn smokeW4(a: int64, b: int64, c: int64, d: int64): int64[] =
    var r: int64[]
    add(r, a)
    add(r, b)
    add(r, c)
    add(r, d)
    return r

# ---- 断言辅助 ----

fn smokeFail(label: str, detail: str) =
    echo("smoke FAIL " + label + " " + detail)
    assert(false, "smoke failed: " + label)

fn smokeAssertI32(label: str, got: int32, want: int32) =
    if got != want:
        echo("smoke FAIL " + label + " got=" + strings.IntToStr(got) + " want=" + strings.IntToStr(want))
    assert(got == want, "smoke i32: " + label)

fn smokeAssertI64(label: str, got: int64, want: int64) =
    assert(got == want, "smoke i64: " + label)

fn smokeAssertBool(label: str, got: bool, want: bool) =
    assert(got == want, "smoke bool: " + label)

fn smokeExpectOk(label: str, okFlag: bool, got: str) =
    if !okFlag:
        echo("smoke FAIL expect-ok " + label + " err=" + got)
        assert(false, "smoke expect-ok failed")
        return
    echo("smoke ok: " + label)

fn smokeExpectErr(label: str, expected: str, okFlag: bool, got: str) =
    if okFlag:
        echo("smoke FAIL expect-err: unexpected success " + label)
        assert(false, "smoke expected rejection")
        return
    if got != expected:
        echo("smoke FAIL err-mismatch " + label + " expected=" + expected + " got=" + got)
        assert(false, "smoke err mismatch")
        return
    echo("smoke reject ok: " + label + " -> " + got)

fn smokeChoice(label: str, logits: dh.DecisionLogits, start: int32, count: int32): dh.DecisionChoiceResult =
    let r = dh.DecisionHeadChoice(share(logits), start, count)
    if IsErr(r):
        smokeFail(label, "unexpected err: " + Error(r))
    return Value(r)

fn smokeScore(label: str, scores: int32[], weights: int64[], precision: int32): dh.DecisionScoreResult =
    let r = dh.DecisionHeadScore(scores, weights, precision)
    if IsErr(r):
        smokeFail(label, "unexpected err: " + Error(r))
    return Value(r)

# ---- 独立暴力 oracle (与实现算法不同构) ----

# 逐点支配: c 是受限 argmax (最小索引 tie-break) <=> 无 j 严格大于 data[c],
# 且无等值 j < c。首个不被支配者即实现必须返回的 chosen。
fn oracleChoiceFirst(logits: dh.DecisionLogits, start: int32, count: int32): int32 =
    var c: int32 = start
    while c < start + count:
        var beaten: bool = false
        var j: int32 = start
        while j < start + count:
            if logits.data[j] > logits.data[c]:
                beaten = true
            elif logits.data[j] == logits.data[c] && j < c:
                beaten = true
            j = j + 1
        if !beaten:
            return c
        c = c + 1
    return 0 - 1

# 并列成员数 = 仅不被严格支配的候选数 (等值占先条款只属于 chosen 选择,
# 不属于成员资格; 与实现的最大值两遍扫描不同构)。
fn oracleTieCount(logits: dh.DecisionLogits, start: int32, count: int32): int32 =
    var n: int32 = 0
    var c: int32 = start
    while c < start + count:
        var beaten: bool = false
        var j: int32 = start
        while j < start + count:
            if logits.data[j] > logits.data[c]:
                beaten = true
            j = j + 1
        if !beaten:
            n = n + 1
        c = c + 1
    return n

# 计数法排列: 等级 i 的位置 = 严格更大数个数 + 等值占先 (j<i) 个数。
fn oracleRanks(scores: int32[]): int32[] =
    let n: int32 = scores.len
    var out: int32[]
    for i in 0..<n:
        add(out, 0 - 1)
    var i: int32 = 0
    while i < n:
        var pos: int32 = 0
        var j: int32 = 0
        while j < n:
            if scores[j] > scores[i]:
                pos = pos + 1
            elif scores[j] == scores[i] && j < i:
                pos = pos + 1
            j = j + 1
        out[pos] = i
        i = i + 1
    return out

fn oracleWeighted(scores: int32[], weights: int64[]): int64 =
    var acc: int64 = 0
    for i in 0..<scores.len:
        acc = acc + int64(scores[i]) * weights[i]
    return acc

# ---- verify a: Choice ----

fn checkChoice() =
    echo("verify-a choice")
    let lA1 = smokeLogits(smokeArr3(3, 9, 4), 100)
    let ca1 = smokeChoice("a1", share(lA1), 0, 3)
    smokeAssertI32("a1 chosen", ca1.chosen, 1)
    smokeAssertBool("a1 tie", ca1.tie, false)
    smokeAssertBool("a1 noMatch", ca1.noMatch, false)
    smokeAssertI32("a1 tieCount", ca1.tieMembers.len, 1)
    smokeAssertI32("a1 oracle chosen", oracleChoiceFirst(share(lA1), 0, 3), ca1.chosen)
    smokeAssertI32("a1 oracle tie", oracleTieCount(share(lA1), 0, 3), ca1.tieMembers.len)

    let lA2 = smokeLogits(smokeArr3(7, 7, 7), 100)
    let ca2 = smokeChoice("a2", share(lA2), 0, 3)
    smokeAssertI32("a2 chosen", ca2.chosen, 0)
    smokeAssertBool("a2 tie", ca2.tie, true)
    smokeAssertI32("a2 tieCount", ca2.tieMembers.len, 3)
    for k in 0..<ca2.tieMembers.len:
        smokeAssertI32("a2 tieMember", ca2.tieMembers[k], k)
    smokeAssertI32("a2 oracle chosen", oracleChoiceFirst(share(lA2), 0, 3), ca2.chosen)
    smokeAssertI32("a2 oracle tie", oracleTieCount(share(lA2), 0, 3), ca2.tieMembers.len)

    let lA3 = smokeLogits(smokeArr5(5, 9, 2, 9, 1), 100)
    let ca3 = smokeChoice("a3", share(lA3), 0, 5)
    smokeAssertI32("a3 chosen", ca3.chosen, 1)
    smokeAssertBool("a3 tie", ca3.tie, true)
    smokeAssertI32("a3 tieCount", ca3.tieMembers.len, 2)
    smokeAssertI32("a3 tieMember0", ca3.tieMembers[0], 1)
    smokeAssertI32("a3 tieMember1", ca3.tieMembers[1], 3)
    smokeAssertI32("a3 oracle chosen", oracleChoiceFirst(share(lA3), 0, 5), ca3.chosen)
    smokeAssertI32("a3 oracle tie", oracleTieCount(share(lA3), 0, 5), ca3.tieMembers.len)

    let lA4 = smokeLogits(smokeArr3(-5, -2, -9), 100)
    let ca4 = smokeChoice("a4", share(lA4), 0, 3)
    smokeAssertI32("a4 chosen", ca4.chosen, 1)
    smokeAssertBool("a4 tie", ca4.tie, false)
    smokeAssertI32("a4 oracle chosen", oracleChoiceFirst(share(lA4), 0, 3), ca4.chosen)

    let lA5 = smokeLogits(smokeArr3(9, 3, 4), 100)
    let ca5 = smokeChoice("a5", share(lA5), 2, 1)
    smokeAssertI32("a5 chosen", ca5.chosen, 2)
    smokeAssertBool("a5 tie", ca5.tie, false)
    smokeAssertI32("a5 oracle chosen", oracleChoiceFirst(share(lA5), 2, 1), ca5.chosen)

    let ca6 = smokeChoice("a6 empty", share(lA5), 3, 0)
    smokeAssertBool("a6 noMatch", ca6.noMatch, true)
    smokeAssertI32("a6 chosen none", ca6.chosen, dc.CsgDecisionChosenNone)
    smokeAssertBool("a6 tie", ca6.tie, false)
    smokeAssertI32("a6 tieMembers len", ca6.tieMembers.len, 0)

    let rOOB = dh.DecisionHeadChoice(share(lA1), 1, 5)
    smokeExpectErr("a range oob", "InvalidOutput: decision head choice candidate range out of bounds", IsOk(rOOB), Error(rOOB))
    let rOOB2 = dh.DecisionHeadChoice(share(lA1), 4, 0)
    smokeExpectErr("a start oob", "InvalidOutput: decision head choice candidate range out of bounds", IsOk(rOOB2), Error(rOOB2))
    let badScale = smokeLogits(smokeArr3(1, 2, 3), 0)
    let rBS = dh.DecisionHeadChoice(share(badScale), 0, 3)
    smokeExpectErr("a scale invalid", "InvalidOutput: decision head logits scale not positive", IsOk(rBS), Error(rBS))
    echo("verify-a ok: argmax/tie/full-tie/negative/single/no-match + oracle cross-check")

# ---- verify b: 置换等变性 ----

fn checkPermutationEquivariance() =
    echo("verify-b permutation equivariance")
    # b1 含并列: 原 chosen = 1 (并列 {1,2} 取最小); 置换后必须映射回同一对象
    let lB1 = smokeLogits(smokeArr5(4, 8, 8, 6, 2), 100)
    let cb1 = smokeChoice("b1", share(lB1), 0, 5)
    smokeAssertI32("b1 chosen", cb1.chosen, 1)
    let permB = smokeArr5(3, 0, 4, 1, 2)
    var pdataB: int32[]
    for k in 0..<permB.len:
        add(pdataB, lB1.data[permB[k]])
    let lB1p = smokeLogits(pdataB, 100)
    let cb1p = smokeChoice("b1p", share(lB1p), 0, 5)
    smokeAssertI32("b1p chosen abs", cb1p.chosen, 3)
    smokeAssertI32("b1p mapped back", permB[cb1p.chosen], cb1.chosen)
    smokeAssertI32("b1p oracle chosen", oracleChoiceFirst(share(lB1p), 0, 5), cb1p.chosen)

    # b2 无并列
    let lB2 = smokeLogits(smokeArr5(4, 8, 1, 6, 2), 100)
    let cb2 = smokeChoice("b2", share(lB2), 0, 5)
    smokeAssertI32("b2 chosen", cb2.chosen, 1)
    let permB2 = smokeArr5(2, 4, 0, 3, 1)
    var pdataB2: int32[]
    for k in 0..<permB2.len:
        add(pdataB2, lB2.data[permB2[k]])
    let lB2p = smokeLogits(pdataB2, 100)
    let cb2p = smokeChoice("b2p", share(lB2p), 0, 5)
    smokeAssertI32("b2p chosen abs", cb2p.chosen, 4)
    smokeAssertI32("b2p mapped back", permB2[cb2p.chosen], cb2.chosen)
    smokeAssertI32("b2p oracle chosen", oracleChoiceFirst(share(lB2p), 0, 5), cb2p.chosen)
    echo("verify-b ok: permuted candidates map back to identical original objects (tie + no-tie)")

# ---- verify c: 候选数量变化 ----

fn checkCandidateCountChanges() =
    echo("verify-c candidate count changes")
    let lC = smokeLogits(smokeArr5(5, 9, 2, -100, 9), 100)
    let cDropTail = smokeChoice("c-drop-tail", share(lC), 0, 2)
    smokeAssertI32("c-drop-tail chosen", cDropTail.chosen, 1)
    let cDropHead = smokeChoice("c-drop-head", share(lC), 1, 2)
    smokeAssertI32("c-drop-head chosen", cDropHead.chosen, 1)
    let cAddNeg = smokeChoice("c-add-neg", share(lC), 0, 4)
    smokeAssertI32("c-add-neg chosen", cAddNeg.chosen, 1)
    let cAddTie = smokeChoice("c-add-tie", share(lC), 0, 5)
    smokeAssertBool("c-add-tie tie", cAddTie.tie, true)
    smokeAssertI32("c-add-tie chosen", cAddTie.chosen, 1)
    let cFull = smokeChoice("c-full", share(lC), 0, 5)
    smokeAssertI32("c-full tieCount", cFull.tieMembers.len, 2)
    # 新增更强候选: 剩余候选间相对判定不变, 新候选胜出
    let lC2 = smokeLogits(smokeArr4(5, 9, 2, 100), 100)
    let c2Keep = smokeChoice("c2-keep", share(lC2), 0, 3)
    smokeAssertI32("c2-keep chosen", c2Keep.chosen, 1)
    let c2New = smokeChoice("c2-new", share(lC2), 0, 4)
    smokeAssertI32("c2-new chosen", c2New.chosen, 3)
    echo("verify-c ok: add/remove candidates keeps relative verdict among remaining")

# ---- verify d: Noul 阈值边界 ----

fn checkNoul() =
    echo("verify-d noul threshold boundary")
    let nd1 = dh.DecisionHeadNoul(10, 5)
    smokeAssertBool("d above", nd1.fires, true)
    smokeAssertI32("d above echo value", nd1.value, 10)
    smokeAssertI32("d above echo threshold", nd1.threshold, 5)
    let nd2 = dh.DecisionHeadNoul(3, 5)
    smokeAssertBool("d below", nd2.fires, false)
    # 恰等触发 = 显式合同 (>=)
    let nd3 = dh.DecisionHeadNoul(5, 5)
    smokeAssertBool("d equal fires", nd3.fires, true)
    let nd4 = dh.DecisionHeadNoul(-7, -3)
    smokeAssertBool("d neg below", nd4.fires, false)
    let nd5 = dh.DecisionHeadNoul(-7, -9)
    smokeAssertBool("d neg above", nd5.fires, true)
    let nd6 = dh.DecisionHeadNoul(-3, -3)
    smokeAssertBool("d neg equal", nd6.fires, true)
    let nd7 = dh.DecisionHeadNoul(0, 0)
    smokeAssertBool("d zero equal", nd7.fires, true)
    echo("verify-d ok: above/below/equal(>=)/negative inputs all explicit")

# ---- verify e: Score ----

fn checkScore() =
    echo("verify-e score")
    # e1 常规排列 + 加权 oracle 对拍 (手算: ranks=[2,1,0,3], weighted=43)
    let oR1 = oracleRanks(smokeArr4(2, 5, 9, 1))
    let oW1 = oracleWeighted(smokeArr4(2, 5, 9, 1), smokeW4(int64(1), int64(2), int64(3), int64(4)))
    let s1 = smokeScore("e1", smokeArr4(2, 5, 9, 1), smokeW4(int64(1), int64(2), int64(3), int64(4)), 2)
    smokeAssertI32("e1 ranks len", s1.ranks.len, oR1.len)
    for i in 0..<s1.ranks.len:
        smokeAssertI32("e1 ranks elem", s1.ranks[i], oR1[i])
    smokeAssertI32("e1 ranks[0]", s1.ranks[0], 2)
    smokeAssertI32("e1 ranks[2]", s1.ranks[2], 0)
    smokeAssertI32("e1 ranks[3]", s1.ranks[3], 3)
    smokeAssertI64("e1 weighted oracle", s1.weighted.numer, oW1)
    smokeAssertI64("e1 weighted manual", s1.weighted.numer, int64(43))
    smokeAssertI32("e1 weighted precision", s1.weighted.precision, 2)

    # e2 全并列: 稳定小索引在前
    let oR2 = oracleRanks(smokeArr3(4, 4, 4))
    let s2 = smokeScore("e2", smokeArr3(4, 4, 4), smokeW3(int64(1), int64(1), int64(1)), 2)
    smokeAssertI32("e2 ranks len", s2.ranks.len, oR2.len)
    for i in 0..<s2.ranks.len:
        smokeAssertI32("e2 ranks elem", s2.ranks[i], oR2[i])
    smokeAssertI32("e2 ranks[0]", s2.ranks[0], 0)
    smokeAssertI32("e2 ranks[1]", s2.ranks[1], 1)
    smokeAssertI32("e2 ranks[2]", s2.ranks[2], 2)

    # e3 含 0 与负分: [0,-3,7,0] -> [2,0,3,1]
    let oR3 = oracleRanks(smokeArr4(0, -3, 7, 0))
    let s3 = smokeScore("e3", smokeArr4(0, -3, 7, 0), smokeW4(int64(1), int64(1), int64(1), int64(1)), 1)
    smokeAssertI32("e3 ranks len", s3.ranks.len, oR3.len)
    for i in 0..<s3.ranks.len:
        smokeAssertI32("e3 ranks elem", s3.ranks[i], oR3[i])
    smokeAssertI32("e3 ranks[0]", s3.ranks[0], 2)
    smokeAssertI32("e3 ranks[1]", s3.ranks[1], 0)
    smokeAssertI32("e3 ranks[2]", s3.ranks[2], 3)
    smokeAssertI32("e3 ranks[3]", s3.ranks[3], 1)

    # e4 权重负 / 精度越界 / 长度不匹配 显式拒绝
    let e4 = dh.DecisionHeadScore(smokeArr2(1, 2), smokeW2(int64(1), int64(0) - int64(1)), 2)
    smokeExpectErr("e4 negative weight", "InvalidOutput: decision head score weight negative", IsOk(e4), Error(e4))
    let e5a = dh.DecisionHeadScore(smokeArr2(1, 2), smokeW2(int64(1), int64(1)), 0)
    smokeExpectErr("e5 precision 0", "InvalidOutput: decision head score weight precision out of range", IsOk(e5a), Error(e5a))
    let e5b = dh.DecisionHeadScore(smokeArr2(1, 2), smokeW2(int64(1), int64(1)), 10)
    smokeExpectErr("e5 precision 10", "InvalidOutput: decision head score weight precision out of range", IsOk(e5b), Error(e5b))
    let e6 = dh.DecisionHeadScore(smokeArr3(1, 2, 3), smokeW2(int64(1), int64(1)), 2)
    smokeExpectErr("e6 weights length mismatch", "InvalidOutput: decision head score weights length mismatch", IsOk(e6), Error(e6))

    # e7 单项溢出 (2 * 2^62 = 2^63 > int64 上界)
    let e7 = dh.DecisionHeadScore(smokeArr2(2, 1), smokeW2(smokePow2(62), int64(1)), 2)
    smokeExpectErr("e7 term overflow", "InvalidOutput: decision head score term overflow", IsOk(e7), Error(e7))
    # e8 累计溢出 (2^62 + 2^62 = 2^63)
    let e8 = dh.DecisionHeadScore(smokeArr2(1, 1), smokeW2(smokePow2(62), smokePow2(62)), 2)
    smokeExpectErr("e8 sum overflow", "InvalidOutput: decision head score sum overflow", IsOk(e8), Error(e8))
    # e9 累计恰等上界: 2^62 + (2^62 - 1) = int64 上界, 必须 Ok
    let e9 = smokeScore("e9", smokeArr2(1, 1), smokeW2(smokePow2(62), smokePow2(62) - int64(1)), 2)
    smokeAssertI64("e9 boundary max", e9.weighted.numer, smokeI64Max())
    # e10 负向单项溢出 (-10^9 * 2^34 越下界)
    let e10 = dh.DecisionHeadScore(smokeArr2(-1000000000, 1), smokeW2(smokePow2(34), int64(1)), 2)
    smokeExpectErr("e10 negative term overflow", "InvalidOutput: decision head score term overflow", IsOk(e10), Error(e10))
    # e11 负向累计溢出
    let e11 = dh.DecisionHeadScore(smokeArr2(-2000000000, -2000000000), smokeW2(smokePow2(32), smokePow2(32)), 2)
    smokeExpectErr("e11 negative sum overflow", "InvalidOutput: decision head score sum overflow", IsOk(e11), Error(e11))
    # e12 恰等 int64 下界: int32 最小分 * 2^32 = -2^63 精确可表示, 必须 Ok
    let smin: int32 = 0 - 2147483647 - 1
    let e12 = smokeScore("e12", smokeArr2(smin, 5), smokeW2(smokePow2(32), int64(0)), 2)
    smokeAssertI64("e12 boundary min", e12.weighted.numer, smokeI64Min())

    # e13 等级数 2..10 边界
    let g2 = smokeScore("e-g2", smokeArr2(1, 2), smokeW2(int64(1), int64(1)), 2)
    smokeAssertI32("e-g2 ranks[0]", g2.ranks[0], 1)
    var g10s: int32[]
    var g10w: int64[]
    for i in 0..<dh.CsgScoreGradeCountMax:
        add(g10s, 9 - i)
        add(g10w, int64(1))
    let g10 = smokeScore("e-g10", g10s, g10w, 1)
    smokeAssertI32("e-g10 ranks len", g10.ranks.len, dh.CsgScoreGradeCountMax)
    smokeAssertI32("e-g10 ranks[0]", g10.ranks[0], 0)
    let gBad1 = dh.DecisionHeadScore(smokeArr1(5), smokeW1(int64(1)), 2)
    smokeExpectErr("e-grade1", "InvalidOutput: decision head score grade count out of range", IsOk(gBad1), Error(gBad1))
    var g11s: int32[]
    var g11w: int64[]
    for i in 0..<(dh.CsgScoreGradeCountMax + 1):
        add(g11s, i)
        add(g11w, int64(1))
    let gBad2 = dh.DecisionHeadScore(g11s, g11w, 2)
    smokeExpectErr("e-grade11", "InvalidOutput: decision head score grade count out of range", IsOk(gBad2), Error(gBad2))
    echo("verify-e ok: ranks/weighted oracle + overflow reject + int64 boundaries + grade 2..10")

# ---- verify f: 批量结构 ----

fn checkBatch() =
    echo("verify-f batch plan")
    # 共享池布局 (19 槽): q0 choice[0,4)=[5,9,2,7] noul@8=6 score[9,11)=[0,2]
    #                    q1 choice[12,15)=[9,9,9] noul@16=7 score[17,19)=[3,8]
    # 槽 11/15 未引用 (合法 slack, 索引账只登记引用段)
    var pool: int32[]
    add(pool, 5)
    add(pool, 9)
    add(pool, 2)
    add(pool, 7)
    add(pool, 0)
    add(pool, 0)
    add(pool, 0)
    add(pool, 0)
    add(pool, 6)
    add(pool, 0)
    add(pool, 2)
    add(pool, 0)
    add(pool, 9)
    add(pool, 9)
    add(pool, 9)
    add(pool, 0)
    add(pool, 7)
    add(pool, 3)
    add(pool, 8)
    let poolLogits = smokeLogits(pool, 1000)

    var wq0: int64[]
    add(wq0, int64(10))
    add(wq0, int64(40))
    var wq1: int64[]
    add(wq1, int64(100))
    add(wq1, int64(1))
    var plan = dh.DecisionBatchPlanNew(2)
    let qi0 = dh.DecisionBatchPlanAddQuestion(plan, 0, 4, 8, 6, 9, 2, wq0)
    let qi1 = dh.DecisionBatchPlanAddQuestion(plan, 12, 3, 16, 8, 17, 2, wq1)
    smokeAssertI32("f question index 0", qi0, 0)
    smokeAssertI32("f question index 1", qi1, 1)

    let pv = dh.DecisionBatchPlanValidate(share(plan), poolLogits.data.len)
    smokeExpectOk("f plan validate", IsOk(pv), Error(pv))
    let run = dh.DecisionBatchRun(share(poolLogits), share(plan))
    smokeExpectOk("f batch run", IsOk(run), Error(run))
    let outs = Value(run)
    smokeAssertI32("f outputs count", outs.choices.len, 2)
    smokeAssertI32("f noul outputs count", outs.nouls.len, 2)
    smokeAssertI32("f score outputs count", outs.scores.len, 2)

    # q0 与直连头逐位对拍
    let dq0 = smokeChoice("f q0 direct", share(poolLogits), 0, 4)
    smokeAssertI32("f q0 chosen", outs.choices[0].chosen, dq0.chosen)
    smokeAssertBool("f q0 tie", outs.choices[0].tie, dq0.tie)
    smokeAssertBool("f q0 noMatch", outs.choices[0].noMatch, dq0.noMatch)
    smokeAssertI32("f q0 tieCount", outs.choices[0].tieMembers.len, dq0.tieMembers.len)
    for k in 0..<dq0.tieMembers.len:
        smokeAssertI32("f q0 tieMember", outs.choices[0].tieMembers[k], dq0.tieMembers[k])
    smokeAssertI32("f q0 chosen abs", outs.choices[0].chosen, 1)
    smokeAssertI32("f q0 chosen value", poolLogits.data[outs.choices[0].chosen], 9)
    let dn0 = dh.DecisionHeadNoul(poolLogits.data[8], 6)
    smokeAssertBool("f q0 fires", outs.nouls[0].fires, dn0.fires)
    smokeAssertBool("f q0 fires true", outs.nouls[0].fires, true)
    let ds0 = smokeScore("f q0 direct score", smokeArr2(0, 2), smokeW2(int64(10), int64(40)), 2)
    smokeAssertI32("f q0 ranks len", outs.scores[0].ranks.len, ds0.ranks.len)
    for k in 0..<ds0.ranks.len:
        smokeAssertI32("f q0 ranks", outs.scores[0].ranks[k], ds0.ranks[k])
    smokeAssertI64("f q0 weighted", outs.scores[0].weighted.numer, ds0.weighted.numer)
    smokeAssertI64("f q0 weighted manual", outs.scores[0].weighted.numer, int64(80))

    # q1 与直连头逐位对拍
    let dq1 = smokeChoice("f q1 direct", share(poolLogits), 12, 3)
    smokeAssertI32("f q1 chosen", outs.choices[1].chosen, dq1.chosen)
    smokeAssertBool("f q1 tie", outs.choices[1].tie, true)
    smokeAssertI32("f q1 tieCount", outs.choices[1].tieMembers.len, 3)
    smokeAssertI32("f q1 chosen abs", outs.choices[1].chosen, 12)
    let dn1 = dh.DecisionHeadNoul(poolLogits.data[16], 8)
    smokeAssertBool("f q1 fires", outs.nouls[1].fires, dn1.fires)
    smokeAssertBool("f q1 fires false", outs.nouls[1].fires, false)
    let ds1 = smokeScore("f q1 direct score", smokeArr2(3, 8), smokeW2(int64(100), int64(1)), 2)
    smokeAssertI32("f q1 ranks len", outs.scores[1].ranks.len, ds1.ranks.len)
    for k in 0..<ds1.ranks.len:
        smokeAssertI32("f q1 ranks", outs.scores[1].ranks[k], ds1.ranks[k])
    smokeAssertI64("f q1 weighted", outs.scores[1].weighted.numer, ds1.weighted.numer)
    smokeAssertI64("f q1 weighted manual", outs.scores[1].weighted.numer, int64(308))

    # 0 问题边界
    let pEmpty = dh.DecisionBatchPlanNew(2)
    let pvE = dh.DecisionBatchPlanValidate(share(pEmpty), 19)
    smokeExpectOk("f empty validate", IsOk(pvE), Error(pvE))
    let runE = dh.DecisionBatchRun(share(poolLogits), share(pEmpty))
    smokeExpectOk("f empty run", IsOk(runE), Error(runE))
    let outsE = Value(runE)
    smokeAssertI32("f empty choices", outsE.choices.len, 0)
    smokeAssertI32("f empty nouls", outsE.nouls.len, 0)
    smokeAssertI32("f empty scores", outsE.scores.len, 0)

    # 单问题边界
    var wS: int64[]
    add(wS, int64(10))
    add(wS, int64(40))
    var pSingle = dh.DecisionBatchPlanNew(2)
    dh.DecisionBatchPlanAddQuestion(pSingle, 0, 4, 8, 6, 9, 2, wS)
    let runS = dh.DecisionBatchRun(share(poolLogits), share(pSingle))
    smokeExpectOk("f single run", IsOk(runS), Error(runS))
    let outsS = Value(runS)
    smokeAssertI32("f single choices", outsS.choices.len, 1)
    smokeAssertI32("f single chosen", outsS.choices[0].chosen, 1)
    smokeAssertI64("f single weighted", outsS.scores[0].weighted.numer, int64(80))

    # 反例账: 段重叠 (同一问题内 choice 与 score 重叠)
    var wOv: int64[]
    add(wOv, int64(10))
    add(wOv, int64(40))
    var pOv = dh.DecisionBatchPlanNew(2)
    dh.DecisionBatchPlanAddQuestion(pOv, 0, 4, 8, 6, 2, 2, wOv)
    let pvOv = dh.DecisionBatchPlanValidate(share(pOv), 19)
    smokeExpectErr("f overlap", "InvalidOutput: decision head batch plan slice overlap", IsOk(pvOv), Error(pvOv))
    let runOv = dh.DecisionBatchRun(share(poolLogits), share(pOv))
    smokeExpectErr("f overlap run", "InvalidOutput: decision head batch plan slice overlap", IsOk(runOv), Error(runOv))

    # 反例账: 越界
    var wOob: int64[]
    add(wOob, int64(10))
    add(wOob, int64(40))
    var pOob = dh.DecisionBatchPlanNew(2)
    dh.DecisionBatchPlanAddQuestion(pOob, 15, 10, 8, 6, 9, 2, wOob)
    let pvOob = dh.DecisionBatchPlanValidate(share(pOob), 19)
    smokeExpectErr("f oob", "InvalidOutput: decision head batch plan slice out of bounds", IsOk(pvOob), Error(pvOob))

    var wNOob: int64[]
    add(wNOob, int64(10))
    add(wNOob, int64(40))
    var pNOob = dh.DecisionBatchPlanNew(2)
    dh.DecisionBatchPlanAddQuestion(pNOob, 0, 4, 19, 6, 9, 2, wNOob)
    let pvNOob = dh.DecisionBatchPlanValidate(share(pNOob), 19)
    smokeExpectErr("f noul oob", "InvalidOutput: decision head batch plan slice out of bounds", IsOk(pvNOob), Error(pvNOob))

    # 反例账: score 段长越头值域
    var wG1: int64[]
    add(wG1, int64(10))
    var pG1 = dh.DecisionBatchPlanNew(2)
    dh.DecisionBatchPlanAddQuestion(pG1, 0, 4, 8, 6, 9, 1, wG1)
    let pvG1 = dh.DecisionBatchPlanValidate(share(pG1), 19)
    smokeExpectErr("f score count 1", "InvalidOutput: decision head batch plan score count out of range", IsOk(pvG1), Error(pvG1))

    # 反例账: 权重段越界 (scoreCount=2 但只登记 1 个权重)
    var wSl: int64[]
    add(wSl, int64(10))
    var pSl = dh.DecisionBatchPlanNew(2)
    dh.DecisionBatchPlanAddQuestion(pSl, 0, 4, 8, 6, 9, 2, wSl)
    let pvSl = dh.DecisionBatchPlanValidate(share(pSl), 19)
    smokeExpectErr("f weight slice oob", "InvalidOutput: decision head batch plan weight slice out of bounds", IsOk(pvSl), Error(pvSl))

    # 反例账: 列长不一致 (手工商 plan, scoreCount/scoreWeightStart 缺行)
    var pCol: dh.DecisionBatchPlan
    pCol.weightPrecision = 2
    pCol.weights = smokeEmptyI64()
    pCol.choiceStart = smokeEmptyI32()
    pCol.choiceCount = smokeEmptyI32()
    pCol.noulIndex = smokeEmptyI32()
    pCol.noulThreshold = smokeEmptyI32()
    pCol.scoreStart = smokeEmptyI32()
    pCol.scoreCount = smokeEmptyI32()
    pCol.scoreWeightStart = smokeEmptyI32()
    add(pCol.choiceStart, 0)
    add(pCol.choiceCount, 4)
    add(pCol.noulIndex, 8)
    add(pCol.noulThreshold, 6)
    add(pCol.scoreStart, 9)
    let pvCol = dh.DecisionBatchPlanValidate(share(pCol), 19)
    smokeExpectErr("f column mismatch", "InvalidOutput: decision head batch plan column length mismatch", IsOk(pvCol), Error(pvCol))

    # 反例账: 权重精度越界
    let pPrec = dh.DecisionBatchPlanNew(0)
    let pvPrec = dh.DecisionBatchPlanValidate(share(pPrec), 19)
    smokeExpectErr("f plan precision", "InvalidOutput: decision head batch plan weight precision out of range", IsOk(pvPrec), Error(pvPrec))
    echo("verify-f ok: multi-question slices bitwise-equal to direct heads; empty/single bounds; ledger rejections")

fn main(): int32 =
    checkChoice()
    checkPermutationEquivariance()
    checkCandidateCountChanges()
    checkNoul()
    checkScore()
    checkBatch()
    echo("decision_heads_smoke ok")
    return 0
