import std/strutils as strutil
import std/result
import std/os as os

const
    repAfInet = 2
    repAfInet6Linux = 10
    repAfInet6Bsd = 30
    repSockStream = 1

fn repErrno(): int32 =
    return os.UdpErrno()

fn repSocketOpenStream(isV6: bool): Result[int32] =
    if !isV6:
        let fd: int32 = os.UdpOpenSocket(repAfInet, repSockStream, 0)
        if fd < 0:
            return Err[int32](strutil.Join(["rep socket failed: ", IntToStr(repErrno())], ""))
        return Ok[int32](fd)
    let fdLinux: int32 = os.UdpOpenSocket(repAfInet6Linux, repSockStream, 0)
    if fdLinux >= 0:
        return Ok[int32](fdLinux)
    let fdBsd: int32 = os.UdpOpenSocket(repAfInet6Bsd, repSockStream, 0)
    if fdBsd >= 0:
        return Ok[int32](fdBsd)
    return Err[int32](strutil.Join(["rep ipv6 socket failed: ", IntToStr(repErrno())], ""))

fn repListen(host: str, port: int32, isV6: bool = false): Result[int32] =
    let openRes: Result[int32] = repSocketOpenStream(isV6)
    if IsErr(openRes):
        return Err[int32](Error(openRes))
    let fd: int32 = Value(openRes)
    let _ = os.UdpCloseFd(fd)
    return Ok[int32](fd)

fn RepListen(host: str, port: int32, isV6: bool = false): Result[int32] =
    return repListen(host, port, isV6)

fn main(): int32 =
    let r: Result[int32] = RepListen("127.0.0.1", 0, false)
    if IsErr(r):
        puts(strutil.Join(["RepListen(false) ERR=", ErrorText(r)], ""))
    else:
        puts(strutil.Join(["RepListen(false) ok fd=", IntToStr(Value(r))], ""))
    return 0
