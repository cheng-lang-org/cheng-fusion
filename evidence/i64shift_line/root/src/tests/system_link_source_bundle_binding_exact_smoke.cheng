import std/os
import std/strutils as strutil
import cheng/std/bytes_layout as layout
import cheng/core/lang/parser
import cheng/core/backend/system_link_plan as slplan
import cheng/core/tooling/path as chengpath
import cheng/core/tooling/compiler_world as cworld

fn AssertExactFileBinding() =
    let root = chengpath.PathCurrentDir()
    let sourcePath = chengpath.PathJoin(
        root,
        "src/tests/ordinary_zero_exit_fixture.cheng")
    var externalRoots: parser.ParserExternalPackageRoot[]
    var suppliedEdges: parser.ImportEdge[]
    var canonicalRoots: parser.ParserExternalPackageRoot[]
    var closurePaths: str[]
    var identityPaths: str[]
    var ownerModulePaths: str[]
    var importEdges: parser.ImportEdge[]
    var entrySourceIndex: int32
    var sourceBundleCid: layout.FixedBytes32
    var entrySourceCid: layout.FixedBytes32
    var importGraphCid: layout.FixedBytes32
    var bindingSeal: layout.FixedBytes32
    var err: str
    assert(slplan.SystemLinkPlanBuildSourceBundleBindingFromFilesInto(
               "cheng",
               root,
               root,
               externalRoots,
               [sourcePath],
               sourcePath,
               suppliedEdges,
               0,
               canonicalRoots,
               closurePaths,
               identityPaths,
               ownerModulePaths,
               importEdges,
               entrySourceIndex,
               sourceBundleCid,
               entrySourceCid,
               importGraphCid,
               bindingSeal,
               err),
           Fmt"source bundle exact smoke: real file binding failed {err}")
    assert(entrySourceIndex == 0 &&
           closurePaths.len == 1 &&
           identityPaths.len == 1 &&
           identityPaths[0] == "cheng/tests/ordinary_zero_exit_fixture" &&
           ownerModulePaths.len == 1 &&
           ownerModulePaths[0] == identityPaths[0] &&
           importEdges.len == 0 &&
           !layout.FixedBytes32Equal(entrySourceCid,
                                     layout.FixedBytes32()) &&
           !layout.FixedBytes32Equal(importGraphCid,
                                     layout.FixedBytes32()) &&
           !layout.FixedBytes32Equal(bindingSeal, layout.FixedBytes32()),
           "source bundle exact smoke: sealed columns mismatch")

    err = ""
    assert(!slplan.SystemLinkPlanBuildSourceBundleBindingFromFilesInto(
                "cheng",
                root,
                root,
                externalRoots,
                ["/definitely/missing/cid-source.cheng"],
                "/definitely/missing/cid-source.cheng",
                suppliedEdges,
                0,
                canonicalRoots,
                closurePaths,
                identityPaths,
                ownerModulePaths,
                importEdges,
                entrySourceIndex,
                sourceBundleCid,
                entrySourceCid,
                importGraphCid,
                bindingSeal,
                err) &&
           err != "",
           "source bundle exact smoke: missing source accepted")

fn AssertPureImportGraph() =
    let workspaceRoot = "/cid-exact-virtual"
    let packageRoot = "/cid-exact-virtual"
    let packageId = "cid-exact-virtual"
    var externalRoots: parser.ParserExternalPackageRoot[]
    var closurePaths = [
        "/cid-exact-virtual/src/main.cheng",
        "/cid-exact-virtual/src/lib.cheng"
    ]
    var ownerModulePaths = [
        "cid-exact-virtual/main",
        "cid-exact-virtual/lib"
    ]
    var sourceTexts = [
        "import cid-exact-virtual/lib\nfn main(): int32 =\n    return 0\n",
        "fn Value(): int32 =\n    return 7\n"
    ]
    var edges: parser.ImportEdge[]
    var unresolvedCount: int32
    var err: str
    assert(slplan.SystemLinkPlanRebuildImportEdgesFromTextsInto(
               workspaceRoot,
               packageRoot,
               packageId,
               externalRoots,
               closurePaths,
               ownerModulePaths,
               sourceTexts,
               0,
               edges,
               unresolvedCount,
               err),
           Fmt"source bundle exact smoke: pure graph failed {err}")
    assert(edges.len == 1 &&
           unresolvedCount == 0 &&
           edges[0].resolved &&
           edges[0].ownerModulePath == "cid-exact-virtual/main" &&
           edges[0].targetModulePath == "cid-exact-virtual/lib" &&
           edges[0].targetSourcePath ==
               "/cid-exact-virtual/src/lib.cheng",
           "source bundle exact smoke: pure graph row mismatch")

    var secondEdge = edges[0]
    secondEdge.targetModulePath = "cid-exact-virtual/other"
    secondEdge.importAlias = "other"
    var graphForward = [edges[0], secondEdge]
    var graphReverse = [secondEdge, edges[0]]
    var forwardCid: layout.FixedBytes32
    var reverseCid: layout.FixedBytes32
    assert(cworld.CompilerWorldPortableImportGraphCidInto(
               packageId,
               graphForward,
               0,
               forwardCid,
               err) &&
           cworld.CompilerWorldPortableImportGraphCidInto(
               packageId,
               graphReverse,
               0,
               reverseCid,
               err) &&
           layout.FixedBytes32Equal(forwardCid, reverseCid),
           Fmt"source bundle exact smoke: import graph order drift {err}")
    var duplicateGraph = [edges[0], edges[0]]
    assert(!cworld.CompilerWorldPortableImportGraphCidInto(
                packageId,
                duplicateGraph,
                0,
                reverseCid,
                err),
           "source bundle exact smoke: duplicate import graph accepted")
    assert(!cworld.CompilerWorldPortableImportGraphCidInto(
                packageId,
                edges,
                1,
                reverseCid,
                err),
           "source bundle exact smoke: unresolved import graph accepted")

    sourceTexts[0] = "fn main(): int32 =\n    return 0\n"
    err = ""
    assert(!slplan.SystemLinkPlanRebuildImportEdgesFromTextsInto(
                workspaceRoot,
                packageRoot,
                packageId,
                externalRoots,
                closurePaths,
                ownerModulePaths,
                sourceTexts,
                0,
                edges,
                unresolvedCount,
                err) &&
           err != "",
           "source bundle exact smoke: unreachable closure row accepted")

fn AssertPortableTextBinding() =
    let packageId = "cid-exact-portable"
    let entryModule = "cid-exact-portable/main"
    var modulePaths = [entryModule, "cid-exact-portable/lib"]
    var sourceTexts = [
        "import cid-exact-portable/lib\nfn main(): int32 =\n    return 0\n",
        ""
    ]
    var edge: parser.ImportEdge
    edge.ownerModulePath = entryModule
    edge.targetModulePath = "cid-exact-portable/lib"
    edge.targetSourcePath = "/root-a/src/lib.cheng"
    edge.targetProfileIndex = -1
    edge.qualifier = "lib"
    edge.allowsUnqualifiedCall = true
    edge.resolved = true
    var edges = [edge]
    var binding: slplan.SystemLinkPlanPortableSourceBinding
    var err: str
    assert(slplan.SystemLinkPlanPortableSourceBindingFromTextsInto(
               packageId,
               entryModule,
               modulePaths,
               sourceTexts,
               edges,
               binding,
               err),
           Fmt"source bundle exact smoke: portable text binding failed {err}")
    assert(binding.sourceCount == 2 &&
           binding.importEdgeCount == 1 &&
           !layout.FixedBytes32Equal(binding.sourceBundleCid,
                                     layout.FixedBytes32()) &&
           !layout.FixedBytes32Equal(binding.entrySourceCid,
                                     layout.FixedBytes32()) &&
           !layout.FixedBytes32Equal(binding.importGraphCid,
                                     layout.FixedBytes32()) &&
           !layout.FixedBytes32Equal(binding.bindingSeal,
                                     layout.FixedBytes32()) &&
           slplan.SystemLinkPlanPortableSourceBindingValidateTextsInto(
               binding,
               modulePaths,
               sourceTexts,
               edges,
               err),
           Fmt"source bundle exact smoke: portable binding validation failed {err}")

    var rootBEdge = edge
    rootBEdge.targetSourcePath = "/different-root/src/lib.cheng"
    var rootBEdges = [rootBEdge]
    var rootBBinding: slplan.SystemLinkPlanPortableSourceBinding
    assert(slplan.SystemLinkPlanPortableSourceBindingFromTextsInto(
               packageId,
               entryModule,
               modulePaths,
               sourceTexts,
               rootBEdges,
               rootBBinding,
               err) &&
           layout.FixedBytes32Equal(rootBBinding.sourceBundleCid,
                                    binding.sourceBundleCid) &&
           layout.FixedBytes32Equal(rootBBinding.entrySourceCid,
                                    binding.entrySourceCid) &&
           layout.FixedBytes32Equal(rootBBinding.importGraphCid,
                                    binding.importGraphCid) &&
           layout.FixedBytes32Equal(rootBBinding.bindingSeal,
                                    binding.bindingSeal),
           Fmt"source bundle exact smoke: portable binding retained physical root {err}")

    var mutatedTexts = [
        strutil.Join([sourceTexts[0], " "], ""),
        sourceTexts[1]
    ]
    assert(!slplan.SystemLinkPlanPortableSourceBindingValidateTextsInto(
                binding,
                modulePaths,
                mutatedTexts,
                edges,
                err),
           "source bundle exact smoke: source byte mutation accepted")
    var mutatedBinding: slplan.SystemLinkPlanPortableSourceBinding
    assert(slplan.SystemLinkPlanPortableSourceBindingFromTextsInto(
               packageId,
               entryModule,
               modulePaths,
               mutatedTexts,
               edges,
               mutatedBinding,
               err) &&
           !layout.FixedBytes32Equal(mutatedBinding.sourceBundleCid,
                                     binding.sourceBundleCid) &&
           !layout.FixedBytes32Equal(mutatedBinding.entrySourceCid,
                                     binding.entrySourceCid) &&
           !layout.FixedBytes32Equal(mutatedBinding.bindingSeal,
                                     binding.bindingSeal),
           Fmt"source bundle exact smoke: byte mutation preserved portable identity {err}")

    var missingTexts = [sourceTexts[0]]
    assert(!slplan.SystemLinkPlanPortableSourceBindingFromTextsInto(
                packageId,
                entryModule,
                modulePaths,
                missingTexts,
                edges,
                mutatedBinding,
                err),
           "source bundle exact smoke: missing exact source text accepted")

    var foreignModulePaths = ["other-package/main"]
    var foreignSourceTexts = ["fn main(): int32 =\n    return 0\n"]
    var noEdges: parser.ImportEdge[]
    assert(!slplan.SystemLinkPlanPortableSourceBindingFromTextsInto(
                packageId,
                foreignModulePaths[0],
                foreignModulePaths,
                foreignSourceTexts,
                noEdges,
                mutatedBinding,
                err),
           "source bundle exact smoke: foreign-package entry accepted")

    var graphMutation = edge
    graphMutation.importAlias = "other"
    graphMutation.qualifier = "other"
    graphMutation.allowsUnqualifiedCall = false
    var mutatedEdges = [graphMutation]
    assert(!slplan.SystemLinkPlanPortableSourceBindingFromTextsInto(
                packageId,
                entryModule,
                modulePaths,
                sourceTexts,
                mutatedEdges,
                mutatedBinding,
                err),
           "source bundle exact smoke: import graph mutation accepted")

    var zeroModulePaths = ["cid-exact-portable/zero"]
    var zeroSourceTexts = [""]
    var zeroEdges: parser.ImportEdge[]
    var zeroBinding: slplan.SystemLinkPlanPortableSourceBinding
    assert(slplan.SystemLinkPlanPortableSourceBindingFromTextsInto(
               packageId,
               zeroModulePaths[0],
               zeroModulePaths,
               zeroSourceTexts,
               zeroEdges,
               zeroBinding,
               err) &&
           !layout.FixedBytes32Equal(zeroBinding.sourceBundleCid,
                                     layout.FixedBytes32()) &&
           !layout.FixedBytes32Equal(zeroBinding.entrySourceCid,
                                     layout.FixedBytes32()),
           Fmt"source bundle exact smoke: zero-byte source rejected {err}")

    var sourcePathIdentities = ["/root-a/src/main.cheng"]
    var sourcePathTexts = ["fn main(): int32 =\n    return 0\n"]
    var sourcePathBinding: slplan.SystemLinkPlanPortableSourceBinding
    assert(slplan.SystemLinkPlanPortableSourceBindingFromTextsInto(
               packageId,
               sourcePathIdentities[0],
               sourcePathIdentities,
               sourcePathTexts,
               noEdges,
               sourcePathBinding,
               err),
           Fmt"source bundle exact smoke: canonical source-path domain rejected {err}")
    var nonCanonicalSourcePaths = ["/root-a/src/../src/main.cheng"]
    assert(!slplan.SystemLinkPlanPortableSourceBindingFromTextsInto(
                packageId,
                nonCanonicalSourcePaths[0],
                nonCanonicalSourcePaths,
                sourcePathTexts,
                noEdges,
                sourcePathBinding,
                err),
           "source bundle exact smoke: noncanonical source-path identity accepted")
    var mixedSourcePathIdentities = [sourcePathIdentities[0],
                                     "cid-exact-portable/lib"]
    var mixedSourcePathTexts = [sourcePathTexts[0], ""]
    # Per-row identity domains are independent: a canonical absolute
    # source-path row and an exact module row coexist (the root-out entry
    # + in-root std dependency shape is exactly this mix).
    assert(slplan.SystemLinkPlanPortableSourceBindingFromTextsInto(
               packageId,
               mixedSourcePathIdentities[0],
               mixedSourcePathIdentities,
               mixedSourcePathTexts,
               noEdges,
               sourcePathBinding,
               err),
           Fmt"source bundle exact smoke: per-row source-path/module identity rejected {err}")
    var mixedModuleIdentities = [entryModule, sourcePathIdentities[0]]
    assert(slplan.SystemLinkPlanPortableSourceBindingFromTextsInto(
               packageId,
               mixedModuleIdentities[0],
               mixedModuleIdentities,
               mixedSourcePathTexts,
               noEdges,
               sourcePathBinding,
               err),
           Fmt"source bundle exact smoke: per-row module/source-path identity rejected {err}")

fn AssertPortableImportNormalization() =
    let packageId = "cid-exact-portable"
    let entryModule = "cid-exact-portable/main"
    var compatibilityModules = [entryModule, "std/bytes_layout"]
    var compatibilityTexts = [
        "import cheng/std/bytes_layout\nfn main(): int32 =\n    return 0\n",
        "fn LayoutValue(): int32 =\n    return 1\n"
    ]
    var compatibilityEdge: parser.ImportEdge
    compatibilityEdge.ownerModulePath = entryModule
    compatibilityEdge.targetModulePath = "std/bytes_layout"
    compatibilityEdge.targetSourcePath = "/root-a/src/std/bytes_layout.cheng"
    compatibilityEdge.targetProfileIndex = -1
    compatibilityEdge.qualifier = "bytes_layout"
    compatibilityEdge.allowsUnqualifiedCall = true
    compatibilityEdge.resolved = true
    var compatibilityBinding: slplan.SystemLinkPlanPortableSourceBinding
    var err: str
    assert(slplan.SystemLinkPlanPortableSourceBindingFromTextsInto(
               packageId,
               entryModule,
               compatibilityModules,
               compatibilityTexts,
               [compatibilityEdge],
               compatibilityBinding,
               err),
           Fmt"source bundle exact smoke: compatibility import was not canonicalized {err}")

    var externalModules = [entryModule, "codex/shared/item"]
    var externalTexts = [
        "import cheng/codex/shared/item\nfn main(): int32 =\n    return 0\n",
        "fn ItemValue(): int32 =\n    return 2\n"
    ]
    var externalEdge = compatibilityEdge
    externalEdge.targetModulePath = "codex/shared/item"
    externalEdge.targetSourcePath = "/root-b/src/shared/item.cheng"
    externalEdge.qualifier = "item"
    var externalBinding: slplan.SystemLinkPlanPortableSourceBinding
    assert(slplan.SystemLinkPlanPortableSourceBindingFromTextsInto(
               packageId,
               entryModule,
               externalModules,
               externalTexts,
               [externalEdge],
               externalBinding,
               err),
           Fmt"source bundle exact smoke: external import alias was not canonicalized {err}")

    var ambiguousModules = [
        entryModule,
        "codex/shared/item",
        "rust/shared/item"
    ]
    var ambiguousTexts = [
        "import shared/item\nfn main(): int32 =\n    return 0\n",
        "fn CodexItem(): int32 =\n    return 3\n",
        "fn RustItem(): int32 =\n    return 4\n"
    ]
    assert(!slplan.SystemLinkPlanPortableSourceBindingFromTextsInto(
                packageId,
                entryModule,
                ambiguousModules,
                ambiguousTexts,
                [externalEdge],
                externalBinding,
                err) &&
           err != "",
           "source bundle exact smoke: ambiguous import suffix accepted")

fn main(): int32 =
    AssertExactFileBinding()
    AssertPureImportGraph()
    AssertPortableTextBinding()
    AssertPortableImportNormalization()
    echo("system_link_source_bundle_binding_exact_smoke ok")
    return 0
