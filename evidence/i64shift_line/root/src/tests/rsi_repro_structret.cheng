# 最小复现: struct 含 str 字段 + 函数按值返回 (批次五缩圈)
# 若 codegen 误编译存在, t.name 会为空/损坏 (标量 kind 幸存指纹)。
import std/strings as strings

type
    Thing =
        name: str
        kind: int32

fn makeThing(n: str, k: int32): Thing =
    var t: Thing
    t.name = strings.CloneStr(n)
    t.kind = k
    return t

fn main(): int32 =
    var t = makeThing("hello", 7)
    assert(t.name == "hello", "repro: name field corrupted")
    assert(t.kind == 7, "repro: kind field corrupted")
    echo(strings.IntToStr(t.kind))
    return 0
