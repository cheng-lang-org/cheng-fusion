type ColdVarValueShareBorrowed =
    left: int32
    right: int32

fn ColdVarValueShareBorrowedReject(
        value: var ColdVarValueShareBorrowed): int32 =
    let copied = share(value)
    return copied.left + copied.right

fn main(): int32 =
    var value = ColdVarValueShareBorrowed(left: 3, right: 5)
    return ColdVarValueShareBorrowedReject(value)
