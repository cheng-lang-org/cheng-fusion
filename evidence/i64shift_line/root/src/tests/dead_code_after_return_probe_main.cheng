fn deadTail(x: int32): int32 =
    if x > 0:
        return 7
    return 3
    # Statements after a top-level return are unreachable but legal: they must
    # parse (into a dead block nothing branches to), never leak to the outer
    # declaration parse.
    var leaked = 1
    leaked = leaked + 1
    if leaked > 99:
        return 99

fn main(): int32 =
    if deadTail(5) != 7:
        return 1
    if deadTail(-2) != 3:
        return 2
    return 0
