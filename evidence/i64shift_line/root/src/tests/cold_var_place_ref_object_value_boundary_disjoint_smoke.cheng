type
    ColdVarPlaceValueCell =
        value: int32

    ColdVarPlaceValueInner = ref object
        cell: ColdVarPlaceValueCell

    ColdVarPlaceValueOuter = ref object
        cell: ColdVarPlaceValueCell
        inner: ColdVarPlaceValueInner

fn ColdVarPlaceValueWrite(
        outerCell: var ColdVarPlaceValueCell,
        innerCell: var ColdVarPlaceValueCell) =
    outerCell.value = 41
    innerCell.value = 43

fn ColdVarPlaceValueMutate(
        out: var ColdVarPlaceValueOuter) =
    var inner = out.inner
    ColdVarPlaceValueWrite(
        out.cell,
        inner.cell)

fn main(): int32 =
    var out = new(ColdVarPlaceValueOuter)
    out.inner = new(ColdVarPlaceValueInner)
    ColdVarPlaceValueMutate(out)
    if out.cell.value != 41:
        return 41
    if out.inner.cell.value != 43:
        return 43
    return 0
