# T88: calls inside named aggregate-constructor fields belong to the LocalDecl
# value tree. They must execute exactly once and must not become standalone
# LetCall statements for the binding.

type
    Row =
        n: int32
        qualField: str
    Single =
        value: int32
    Inner =
        value: int32
    Outer =
        left: int32
        inner: Inner
        right: int32

var evaluationMarker: int32

fn PlainLookup(id: int32): str =
    if id == 1:
        return "alpha"
    if id == 2:
        return "beta"
    return "gamma"

fn Mark(step: int32): int32 =
    evaluationMarker = evaluationMarker * 10 + step
    return step * 10

fn TakeRow(row: Row): int32 =
    return row.n + len(row.qualField)

fn BuildRow(id2: int32): Row =
    let row = Row(
        n: 11,
        qualField: PlainLookup(id2),
    )
    return row

fn main(): int32 =
    let row = BuildRow(2)
    if row.n != 11:
        return 1
    if row.qualField != "beta":
        return 2

    evaluationMarker = 0
    let single = Single(value: Mark(1))
    if single.value != 10 || evaluationMarker != 1:
        return 3

    evaluationMarker = 0
    let nested = Outer(
        left: Mark(1),
        inner: Inner(value: Mark(2)),
        right: Mark(3),
    )
    if nested.left != 10 || nested.inner.value != 20 || nested.right != 30:
        return 4
    if evaluationMarker != 123:
        return 5

    evaluationMarker = 0
    let braced = Single { value: Mark(4) }
    if braced.value != 40 || evaluationMarker != 4:
        return 6

    let constructorArgument = TakeRow(Row(n: 3, qualField: PlainLookup(1)))
    if constructorArgument != 8:
        return 8
    return 0
