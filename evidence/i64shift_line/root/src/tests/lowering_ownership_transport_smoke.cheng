fn appendManagedReturnExact(body: var coreir.BodyIR,
                            resultSlot: int32,
                            sourceDefinitionRow: int32) =
    var term: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = coreir.BodyTermReturnTag
    term.resultSlot = resultSlot
    term.sourceDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    term.sourceDefinitionRow = sourceDefinitionRow
    add(body.terms, term)
    var block: coreir.BodyBlock
    block.id = 0
    block.opStart = 0
    block.opCount = body.ops.len
    block.termIndex = 0
    add(body.blocks, block)

fn appendManagedReturn(body: var coreir.BodyIR) =
    appendManagedReturnExact(body, 0, 0)

fn sealBodyAuthority(body: var coreir.BodyIR) =
    var entryOwnershipKinds: int32[]
    for slotId in 0..<body.localSlots.len:
        var ownership = coreir.OwnInvalid
        if body.localSlots[slotId].stackOffset < 0:
            ownership = coreir.OwnPlain
        add(entryOwnershipKinds, int32(ownership))
    coreir.BodyIRFreezeEntryDefinitionOwnershipKinds(
        body, entryOwnershipKinds)
    coreir.BodyIRControlFlowBegin(body, 3)
    for blockId in 0..<body.blocks.len:
        coreir.BodyIRControlFlowBindBlockScope(body, blockId, 0)
    for termIndex in 0..<body.terms.len:
        let term = body.terms[termIndex]
        var successors: int32[]
        var edgeKinds: int32[]
        var ownerBlockId: int32 = -1
        for blockId in 0..<body.blocks.len:
            if body.blocks[blockId].termIndex == termIndex:
                assert(ownerBlockId < 0,
                       "ownership transport: term owner duplicated")
                ownerBlockId = blockId
        assert(ownerBlockId >= 0,
               "ownership transport: term owner missing")
        if term.kind == coreir.BodyTermBrTag:
            add(successors, term.trueBlock)
            add(edgeKinds,
                if term.trueBlock <= ownerBlockId:
                    coreir.BodyControlEdgeLoopBack
                else:
                    coreir.BodyControlEdgeNormal)
        elif term.kind == coreir.BodyTermCbrTag:
            add(successors, term.trueBlock)
            add(edgeKinds,
                if term.trueBlock <= ownerBlockId:
                    coreir.BodyControlEdgeLoopBack
                else:
                    coreir.BodyControlEdgeNormal)
            add(successors, term.falseBlock)
            add(edgeKinds,
                if term.falseBlock <= ownerBlockId:
                    coreir.BodyControlEdgeLoopBack
                else:
                    coreir.BodyControlEdgeNormal)
        coreir.BodyIRControlFlowBindTermSuccessors(
            body, termIndex, successors, edgeKinds)
    for callIndex in 0..<body.callSequence.len:
        var interfaceCid = ownershipTypeArenaCid()
        if callIndex > 0:
            interfaceCid = ownershipBorrowedCallCid()
        coreir.BodyIRControlFlowBindCallTarget(
            body,
            callIndex,
            coreir.BodyCallTargetDomainFunctionTag,
            callIndex,
            interfaceCid)
    coreir.BodyIRControlFlowSeal(body)

fn requireBodyAccessValid(body: var coreir.BodyIR,
                          label: str) =
    var access = bodyaccess.BodyIrAccessDecode(body)
    if !bodyaccess.BodyIrAccessTableIsValid(access):
        panic(Fmt"ownership transport: {label} BodyIR access code={access.errorCode} site={access.errorSiteKind}:{access.errorSiteIndex} detail={access.errorDetail}")

fn managedReturnAuthorityBody(): coreir.BodyIR =
    var body = coreir.BodyIRNew()
    let typeArenaCid = ownershipTypeArenaCid()
    assert(coreir.BodyIRBindTypeArenaArtifactCid(
               body, typeArenaCid),
           "ownership transport: return BodyIR TypeArena CID")
    var slot: coreir.LocalSlot
    slot.id = 0
    slot.name = "managed_return"
    slot.typeKind = coreir.LocalStrTag
    slot.stackOffset = 0
    slot.sizeBytes = 24
    slot.alignBytes = 8
    coreir.BodyIRApplyLocalSlotDefaultProof(slot)
    add(body.localSlots, slot)
    assert(coreir.BodyIRBindLocalSlotTypeArenaProof(
               body,
               0,
               typeArenaCid,
               37,
               coreir.BodyManagedStorageManagedTag),
           "ownership transport: return slot TypeArena proof")
    return body

fn appendManagedDefinition(body: var coreir.BodyIR,
                           exprNodeIndex: int32): int32 =
    var call: coreir.CallOp
    coreir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = "_cheng_exact_managed_definition"
    call.resultSlot = 0
    call.resultPassKind = coreir.BodyCallPassSretResultTag
    call.resultOwnership = coreir.OwnMove
    call.resultExprNodeIndex = exprNodeIndex
    call.resultValueDefinitionRow = exprNodeIndex
    call.resultDefinitionOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    call.resultDefinitionOriginId = exprNodeIndex
    let callIndex = body.callSequence.len
    add(body.callSequence, call)
    var op: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = coreir.BodyOpCallTag
    op.target = 0
    op.valueDefSlot = 0
    op.valueDefExprNodeIndex = exprNodeIndex
    op.valueDefSemanticRow = exprNodeIndex
    op.valueDefOwnership = coreir.OwnMove
    op.valueDefOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    op.valueDefOriginId = exprNodeIndex
    add(op.operands, callIndex)
    let opId = body.ops.len
    add(body.ops, op)
    return opId

fn appendReturnTerm(body: var coreir.BodyIR,
                    sourceDefinitionRow: int32): int32 =
    var term: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = coreir.BodyTermReturnTag
    term.resultSlot = 0
    term.sourceDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    term.sourceDefinitionRow = sourceDefinitionRow
    let termId = body.terms.len
    add(body.terms, term)
    return termId

fn appendBranchTerm(body: var coreir.BodyIR,
                    targetBlockId: int32): int32 =
    var term: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = coreir.BodyTermBrTag
    term.trueBlock = targetBlockId
    let termId = body.terms.len
    add(body.terms, term)
    return termId

fn addConditionEntrySlot(body: var coreir.BodyIR): int32 =
    let slotId = body.localSlots.len
    var slot: coreir.LocalSlot
    slot.id = slotId
    slot.name = "condition_entry"
    slot.typeKind = coreir.LocalI32Tag
    slot.stackOffset = -1
    slot.sizeBytes = 4
    slot.alignBytes = 4
    coreir.BodyIRApplyLocalSlotDefaultProof(slot)
    add(body.localSlots, slot)
    assert(coreir.BodyIRBindLocalSlotTypeArenaProof(
               body,
               slotId,
               ownershipTypeArenaCid(),
               0,
               coreir.BodyManagedStorageUnmanagedTag),
           "ownership transport: condition entry TypeArena proof")
    return slotId

fn appendConditionalTerm(body: var coreir.BodyIR,
                         trueBlockId: int32,
                         falseBlockId: int32): int32 =
    let conditionSlot = addConditionEntrySlot(body)
    var term: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = coreir.BodyTermCbrTag
    term.conditionKind = coreir.BodyCondLocalNonZeroTag
    term.lhsSlot = conditionSlot
    term.trueBlock = trueBlockId
    term.falseBlock = falseBlockId
    let termId = body.terms.len
    add(body.terms, term)
    return termId

fn appendBodyBlock(body: var coreir.BodyIR,
                   opStart: int32,
                   opCount: int32,
                   termIndex: int32): int32 =
    var block: coreir.BodyBlock
    block.id = body.blocks.len
    block.opStart = opStart
    block.opCount = opCount
    block.termIndex = termIndex
    let blockId = block.id
    add(body.blocks, block)
    return blockId

fn runOwnedReturnPositive() =
    let transport =
        ownershipTransport(texpr.TypedExprExprOwned, 37)
    var body = callBody(coreir.BodyCallPassStackValueTag)
    var lowering = ownershipLoweringPlan()
    lower.LoweringBindManagedCallResultDefinition(
        body, lowering, transport, 19, 23, 0, 0)
    appendManagedReturn(body)
    sealBodyAuthority(body)
    requireBodyAccessValid(body, "owned return")
    cleanup.CleanupBodyIrManagedAuthorityFinalStrictValidate(body)

fn runLoopOwnedReturnPositive() =
    var body = managedReturnAuthorityBody()
    let definitionOpId = appendManagedDefinition(body, 41)
    let entryTermId = appendBranchTerm(body, 1)
    let loopTermId = appendConditionalTerm(body, 1, 2)
    let returnTermId = appendReturnTerm(body, definitionOpId)
    let _ = appendBodyBlock(body, 0, 1, entryTermId)
    let _ = appendBodyBlock(body, 1, 0, loopTermId)
    let _ = appendBodyBlock(body, 1, 0, returnTermId)
    sealBodyAuthority(body)
    requireBodyAccessValid(body, "loop return")
    cleanup.CleanupBodyIrManagedAuthorityFinalStrictValidate(body)

fn runSiblingReturnDefinitionNegative() =
    var body = managedReturnAuthorityBody()
    let definitionOpId = appendManagedDefinition(body, 43)
    let entryTermId = appendConditionalTerm(body, 1, 2)
    let ownedReturnTermId =
        appendReturnTerm(body, definitionOpId)
    let siblingReturnTermId =
        appendReturnTerm(body, definitionOpId)
    let _ = appendBodyBlock(body, 0, 0, entryTermId)
    let _ = appendBodyBlock(body, 0, 1, ownedReturnTermId)
    let _ = appendBodyBlock(body, 1, 0, siblingReturnTermId)
    sealBodyAuthority(body)
    cleanup.CleanupBodyIrManagedAuthorityFinalStrictValidate(body)

fn runAmbiguousReturnDefinitionNegative() =
    var body = managedReturnAuthorityBody()
    let firstDefinitionOpId =
        appendManagedDefinition(body, 47)
    let _ = appendManagedDefinition(body, 53)
    let entryTermId = appendConditionalTerm(body, 1, 2)
    let firstBranchTermId = appendBranchTerm(body, 3)
    let secondBranchTermId = appendBranchTerm(body, 3)
    let returnTermId =
        appendReturnTerm(body, firstDefinitionOpId)
    let _ = appendBodyBlock(body, 0, 0, entryTermId)
    let _ = appendBodyBlock(body, 0, 1, firstBranchTermId)
    let _ = appendBodyBlock(body, 1, 1, secondBranchTermId)
    let _ = appendBodyBlock(body, 2, 0, returnTermId)
    sealBodyAuthority(body)
    cleanup.CleanupBodyIrManagedAuthorityFinalStrictValidate(body)

fn runConsumedReturnDefinitionNegative() =
    var body = managedReturnAuthorityBody()
    let definitionOpId = appendManagedDefinition(body, 59)
    body.ops[definitionOpId].valueDefConsumeOpIndexPlusOne = 2
    body.ops[definitionOpId].consumeActionRow = 0
    var consumeOp: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(consumeOp)
    consumeOp.kind = coreir.BodyOpStoreLocalTag
    consumeOp.sourceDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    consumeOp.sourceDefinitionRow = definitionOpId
    consumeOp.consumeActionRow = 0
    add(body.ops, consumeOp)
    let returnTermId =
        appendReturnTerm(body, definitionOpId)
    let _ = appendBodyBlock(body, 0, 2, returnTermId)
    sealBodyAuthority(body)
    cleanup.CleanupBodyIrManagedAuthorityFinalStrictValidate(body)

fn runBorrowedReturnNegative() =
    let transport =
        ownershipTransport(texpr.TypedExprExprBorrowed, 37)
    var body = callBody(coreir.BodyCallPassStackValueTag)
    bindInitialOwnedDefinitionFixture(body)
    appendBorrowedCallFixture(body)
    var lowering = ownershipLoweringPlan()
    lower.LoweringBindManagedCallResultDefinition(
        body, lowering, transport, 19, 23, 1, 1)
    assert(coreir.BodyIRBindLocalSlotTypeArenaProof(
               body,
               0,
               ownershipTypeArenaCid(),
               37,
               coreir.BodyManagedStorageManagedTag),
           "ownership transport: borrowed owner slot TypeArena proof")
    appendManagedReturnExact(body, 1, 1)
    sealBodyAuthority(body)
    cleanup.CleanupBodyIrManagedAuthorityFinalStrictValidate(body)

fn runCallBodyDriftNegative() =
    let transport =
        ownershipTransport(texpr.TypedExprExprOwned, 37)
    var body = callBody(coreir.BodyCallPassStackValueTag)
    var lowering = ownershipLoweringPlan()
    lower.LoweringBindManagedCallResultDefinition(
        body, lowering, transport, 19, 23, 0, 0)
    body.callSequence[0].resultDefinitionOriginId = 24
    appendManagedReturn(body)
    sealBodyAuthority(body)
    cleanup.CleanupBodyIrManagedAuthorityFinalStrictValidate(body)

fn runCallSemanticRowDriftNegative() =
    let transport =
        ownershipTransport(texpr.TypedExprExprOwned, 37)
    var body = callBody(coreir.BodyCallPassStackValueTag)
    var lowering = ownershipLoweringPlan()
    lower.LoweringBindManagedCallResultDefinition(
        body, lowering, transport, 19, 23, 0, 0)
    body.callSequence[0].resultValueDefinitionRow = 12
    appendManagedReturn(body)
    sealBodyAuthority(body)
    cleanup.CleanupBodyIrManagedAuthorityFinalStrictValidate(body)

fn runBodySemanticRowDriftNegative() =
    let transport =
        ownershipTransport(texpr.TypedExprExprOwned, 37)
    var body = callBody(coreir.BodyCallPassStackValueTag)
    var lowering = ownershipLoweringPlan()
    lower.LoweringBindManagedCallResultDefinition(
        body, lowering, transport, 19, 23, 0, 0)
    body.ops[0].valueDefSemanticRow = 12
    appendManagedReturn(body)
    sealBodyAuthority(body)
    cleanup.CleanupBodyIrManagedAuthorityFinalStrictValidate(body)

fn canonicalOwnershipIr(
        ownership: odir.OwnershipClass,
        bindAuthority: bool): odir.OwnershipDropIr =
    var ir: odir.OwnershipDropIr
    odir.OwnershipDropIrInit(ir)
    let root = odir.OwnershipDropRootScopeId(ir)
    var dropGlueId: int32
    if ownership == odir.Owned:
        dropGlueId = 1
    let typeId = odir.OwnershipDropRegisterLeafType(
        ir, "canonical_transport_value", dropGlueId)
    let placeId = odir.OwnershipDropAddPlace(
        ir, typeId, ownership, root)
    let entry = odir.OwnershipDropAddBlock(ir, root)
    odir.OwnershipDropSetEntryBlock(ir, entry)
    let initializeOp =
        odir.OwnershipDropAppendInitialize(ir, entry, placeId)
    if bindAuthority:
        odir.OwnershipDropBindOpDefinitionAuthority(
            ir,
            initializeOp,
            odir.DefinitionOriginTypedExpr,
            23,
            odir.OwnershipDropDefinitionDomainBodyOp,
            0,
            odir.Owned)
    let exitBlock = odir.OwnershipDropAddBlock(ir, root)
    var cleanupIds: int32[]
    add(cleanupIds, placeId)
    var deferIds: int32[]
    let _ = odir.OwnershipDropAddEdge(
        ir,
        entry,
        exitBlock,
        odir.OwnershipDropEdgeReturn,
        -1,
        cleanupIds,
        deferIds)
    return ir

fn runCanonicalOwnershipPositive() =
    var managed = canonicalOwnershipIr(odir.Owned, true)
    var managedAnalysis: odir.OwnershipDropAnalysis
    odir.OwnershipDropAnalyzeCanonical(managed, managedAnalysis)
    assert(managedAnalysis.converged,
           "ownership transport: canonical managed analysis")
    var unmanaged = canonicalOwnershipIr(odir.Unmanaged, false)
    var unmanagedAnalysis: odir.OwnershipDropAnalysis
    odir.OwnershipDropAnalyzeCanonical(unmanaged, unmanagedAnalysis)
    assert(unmanagedAnalysis.converged,
           "ownership transport: canonical unmanaged analysis")

fn runCanonicalMissingAuthorityNegative() =
    var ir = canonicalOwnershipIr(odir.Owned, false)
    var analysis: odir.OwnershipDropAnalysis
    odir.OwnershipDropAnalyzeCanonical(ir, analysis)

fn requireHardFail(mode: str, diagnostic: str) =
    let result = hostos.ExecFileCapture(
        cmdline.ParamStr(0), [mode], [], "", true, 60)
    assert(os.ExecCmdResultExitCode(result) != 0 &&
           strutil.Contains(os.ExecCmdResultOutput(result), diagnostic),
           "ownership transport: hard-fail contract")

fn main(): int32 =
    let mode = cmdline.ParamStr(1)
    if mode == "owned-bind":
        assertBound(texpr.TypedExprExprOwned, coreir.OwnMove)
        os.WriteLine(os.GetStdout(), "lowering_ownership_owned_bind ok")
        return 0
    if mode == "borrowed-bind":
        assertBound(
            texpr.TypedExprExprBorrowed,
            coreir.OwnBorrowShared)
        os.WriteLine(os.GetStdout(), "lowering_ownership_borrowed_bind ok")
        return 0
    if mode == "owned-return-positive":
        runOwnedReturnPositive()
        os.WriteLine(os.GetStdout(), "lowering_ownership_owned_return ok")
        return 0
    if mode == "loop-return-positive":
        runLoopOwnedReturnPositive()
        os.WriteLine(os.GetStdout(), "lowering_ownership_loop_return ok")
        return 0
    if mode == "forward-sret":
        runForwardSretNegative()
        return 91
    if mode == "missing-proof":
        runMissingProofNegative()
        return 92
    if mode == "already-bound":
        runAlreadyBoundNegative()
        return 93
    if mode == "exact-node-mismatch":
        runExactTypedNodeMismatchNegative()
        return 100
    if mode == "semantic-row-out-of-range":
        runSemanticRowOutOfRangeNegative()
        return 101
    if mode == "semantic-row-duplicate":
        runSemanticRowDuplicateNegative()
        return 104
    if mode == "semantic-row-ordinal-drift":
        runSemanticRowOrdinalDriftNegative()
        return 105
    if mode == "canonical-missing":
        runCanonicalMissingAuthorityNegative()
        return 94
    if mode == "borrowed-return":
        runBorrowedReturnNegative()
        return 95
    if mode == "call-body-drift":
        runCallBodyDriftNegative()
        return 96
    if mode == "call-semantic-row-drift":
        runCallSemanticRowDriftNegative()
        return 102
    if mode == "body-semantic-row-drift":
        runBodySemanticRowDriftNegative()
        return 103
    if mode == "sibling-return-definition":
        runSiblingReturnDefinitionNegative()
        return 97
    if mode == "ambiguous-return-definition":
        runAmbiguousReturnDefinitionNegative()
        return 98
    if mode == "consumed-return-definition":
        runConsumedReturnDefinitionNegative()
        return 99
    assertBound(texpr.TypedExprExprOwned, coreir.OwnMove)
    assertBound(texpr.TypedExprExprBorrowed, coreir.OwnBorrowShared)
    assertStatementCollisionUsesExactTypedNode()
    assertPlanLifecycleTracksOwnershipTransport()
    runOwnedReturnPositive()
    runLoopOwnedReturnPositive()
    runCanonicalOwnershipPositive()
    requireHardFail(
        "forward-sret", "call result is not a local value definition")
    requireHardFail(
        "missing-proof", "exact semantic TypeId authority invalid")
    requireHardFail(
        "already-bound", "call result authority already bound")
    requireHardFail(
        "exact-node-mismatch", "managed call definition missing")
    requireHardFail(
        "semantic-row-out-of-range",
        "definition CSR identity invalid")
    requireHardFail(
        "semantic-row-duplicate",
        "definition CSR identity invalid")
    requireHardFail(
        "semantic-row-ordinal-drift",
        "definition CSR identity invalid")
    requireHardFail(
        "canonical-missing",
        "canonical managed definition authority missing")
    requireHardFail(
        "borrowed-return",
        "canonical BodyIR access authority invalid")
    requireHardFail(
        "call-body-drift",
        "canonical BodyIR access authority invalid")
    requireHardFail(
        "call-semantic-row-drift",
        "canonical BodyIR access authority invalid")
    requireHardFail(
        "body-semantic-row-drift",
        "canonical BodyIR access authority invalid")
    requireHardFail(
        "sibling-return-definition",
        "canonical BodyIR access authority invalid")
    requireHardFail(
        "ambiguous-return-definition",
        "canonical BodyIR access authority invalid")
    requireHardFail(
        "consumed-return-definition",
        "canonical BodyIR access authority invalid")
    os.WriteLine(os.GetStdout(), "lowering_ownership_transport_smoke ok")
    return 0
