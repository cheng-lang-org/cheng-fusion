fn ownershipTypeArenaCid(): layout.FixedBytes32 =
    let parsed = layout.FixedBytes32FromHex(
        "8888888888888888888888888888888888888888888888888888888888888888")
    assert(IsOk(parsed), "ownership transport: TypeArena CID fixture")
    return Value(parsed)

fn ownershipBorrowedCallCid(): layout.FixedBytes32 =
    let parsed = layout.FixedBytes32FromHex(
        "9999999999999999999999999999999999999999999999999999999999999999")
    assert(IsOk(parsed), "ownership transport: borrowed call CID fixture")
    return Value(parsed)

fn ownershipLoweringPlan(): lower.LoweringPlanStub =
    var out: lower.LoweringPlanStub
    out.typeArenaArtifactCid = ownershipTypeArenaCid()
    for typeId in 0..<42:
        add(
            out.typeArenaStructuralKinds,
            int32(typearena.TypedExprStructuralTypeScalar))
        var scalarKind =
            int32(typearena.TypedExprStructuralScalarInt32)
        var sizeBytes: int32 = 4
        var alignBytes: int32 = 4
        if typeId == 37 || typeId == 41:
            scalarKind =
                int32(typearena.TypedExprStructuralScalarStr)
            sizeBytes = 24
            alignBytes = 8
        add(out.typeArenaScalarKinds, scalarKind)
        add(out.typeArenaChildTypeIds, -1)
        add(out.typeArenaFixedLengths, 0)
        add(out.typeArenaSizeBytes, sizeBytes)
        add(out.typeArenaAlignBytes, alignBytes)
        add(out.typeArenaLayoutPresent, 1)
    return out

fn ownershipTransport(
        ownership: texpr.TypedExprExprClass,
        exactTypeId: int32): lower.LoweringOwnershipTransportSoA =
    var out: lower.LoweringOwnershipTransportSoA
    out.typedFunctionIndex = 3
    out.sourceValueDefinitionStart = 11
    out.sourceValueDefinitionCount = 1
    out.typeArenaArtifactCid = ownershipTypeArenaCid()
    var borrowOwnerDefinitionRow: int32 = -1
    if ownership == texpr.TypedExprExprBorrowed:
        out.sourceValueDefinitionStart = 10
        out.sourceValueDefinitionCount = 2
        lower.LoweringOwnershipTransportAppendExactRow(
            out,
            6,
            10,
            int32(texpr.TypedExprValueDefinitionOriginBindingInitializer),
            22,
            12,
            16,
            18,
            22,
            exactTypeId,
            texpr.TypedExprExprOwned,
            -1,
            texpr.TypedExprSnapshotTypeProofManagedValue,
            true,
            texpr.TypedExprIrOpCallExpr,
            28)
        borrowOwnerDefinitionRow = 10
    lower.LoweringOwnershipTransportAppendExactRow(
        out,
        7,
        11,
        int32(texpr.TypedExprValueDefinitionOriginBindingInitializer),
        23,
        13,
        17,
        19,
        23,
        exactTypeId,
        ownership,
        borrowOwnerDefinitionRow,
        texpr.TypedExprSnapshotTypeProofManagedValue,
        true,
        texpr.TypedExprIrOpCallExpr,
        29)
    out.complete = true
    return out

fn callBody(resultPassKind: int32): coreir.BodyIR =
    var out: coreir.BodyIR
    var slot: coreir.LocalSlot
    slot.id = 0
    slot.name = "call_result"
    slot.typeKind = coreir.LocalStrTag
    slot.stackOffset = 0
    slot.sizeBytes = 24
    slot.alignBytes = 8
    coreir.BodyIRApplyLocalSlotDefaultProof(slot)
    add(out.localSlots, slot)

    var call: coreir.CallOp
    coreir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = "_cheng_exact_call"
    call.targetSourcePath = "/work/pkg/callee.cheng"
    call.resultSlot = 0
    call.resultPassKind = resultPassKind
    add(out.callSequence, call)

    var op: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = coreir.BodyOpCallTag
    op.target = 0
    add(op.operands, 0)
    add(out.ops, op)
    return out

fn bindInitialOwnedDefinitionFixture(body: var coreir.BodyIR) =
    body.callSequence[0].resultOwnership = coreir.OwnMove
    body.callSequence[0].resultExprNodeIndex = 22
    body.callSequence[0].resultValueDefinitionRow = 10
    body.callSequence[0].resultDefinitionOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    body.callSequence[0].resultDefinitionOriginId = 10
    body.ops[0].valueDefSlot = 0
    body.ops[0].valueDefExprNodeIndex = 22
    body.ops[0].valueDefSemanticRow = 10
    body.ops[0].valueDefOwnership = coreir.OwnMove
    body.ops[0].valueDefOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    body.ops[0].valueDefOriginId = 10

fn appendBorrowedCallFixture(body: var coreir.BodyIR) =
    var resultSlot: coreir.LocalSlot
    resultSlot.id = 1
    resultSlot.name = "borrowed_result"
    resultSlot.typeKind = coreir.LocalStrTag
    resultSlot.stackOffset = 24
    resultSlot.sizeBytes = 24
    resultSlot.alignBytes = 8
    coreir.BodyIRApplyLocalSlotDefaultProof(resultSlot)
    add(body.localSlots, resultSlot)
    var resultCall: coreir.CallOp
    coreir.BodyIRApplyCallOpDefaultProof(resultCall)
    resultCall.targetSymbol = "_cheng_exact_borrowed_call"
    resultCall.resultSlot = 1
    resultCall.resultPassKind =
        coreir.BodyCallPassSretResultTag
    add(body.callSequence, resultCall)
    var resultOp: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(resultOp)
    resultOp.kind = coreir.BodyOpCallTag
    resultOp.target = 1
    add(resultOp.operands, 1)
    add(body.ops, resultOp)

fn assertBound(ownership: texpr.TypedExprExprClass,
               expected: coreir.OwnershipKind) =
    var transport = ownershipTransport(ownership, 37)
    var body = callBody(coreir.BodyCallPassSretResultTag)
    var callIndex: int32 = 0
    var opIndex: int32 = 0
    if ownership == texpr.TypedExprExprBorrowed:
        bindInitialOwnedDefinitionFixture(body)
        appendBorrowedCallFixture(body)
        callIndex = 1
        opIndex = 1
    var lowering = ownershipLoweringPlan()
    lower.LoweringBindManagedCallResultDefinition(
        body, lowering, transport, 19, 23,
        callIndex, opIndex)
    let call = body.callSequence[callIndex]
    let op = body.ops[opIndex]
    let slot = body.localSlots[call.resultSlot]
    var expectedBorrowOwner: int32 = -1
    if ownership == texpr.TypedExprExprBorrowed:
        expectedBorrowOwner = 10
    assert(layout.FixedBytes32Equal(
               body.typeArenaArtifactCid,
               ownershipTypeArenaCid()) &&
           slot.typeArenaTypeId == 37 &&
           slot.managedStorageKind ==
               coreir.BodyManagedStorageManagedTag &&
           slot.ownership == coreir.OwnPlain,
           "ownership transport: exact local type proof")
    assert(call.resultOwnership == expected &&
           call.resultExprNodeIndex == 23 &&
           call.resultValueDefinitionRow == 11 &&
           call.resultBorrowOwnerValueDefinitionRow ==
               expectedBorrowOwner &&
           call.resultDefinitionOriginKind ==
               coreir.BodyDefinitionOriginTypedExprTag &&
           call.resultDefinitionOriginId == 11 &&
           call.sourceDefinitionDomain ==
               coreir.BodyDefinitionDomainInvalidTag &&
           call.sourceDefinitionRow == -1,
           "ownership transport: exact CallOp definition")
    assert(op.valueDefSlot == call.resultSlot &&
           op.valueDefOwnership == expected &&
           op.valueDefExprNodeIndex == 23 &&
           op.valueDefSemanticRow == 11 &&
           op.valueDefBorrowOwnerSemanticRow ==
               expectedBorrowOwner &&
           op.valueDefOriginKind ==
               coreir.BodyDefinitionOriginTypedExprTag &&
           op.valueDefOriginId == 11 &&
           op.sourceDefinitionDomain ==
               coreir.BodyDefinitionDomainInvalidTag &&
           op.sourceDefinitionRow == -1,
           "ownership transport: exact BodyOp definition")
    let expectedLiveBytes =
        int64(12) * int64(sizeof(int32)) +
        int64(sizeof(texpr.TypedExprExprClass)) +
        int64(sizeof(bool)) +
        int64(sizeof(texpr.TypedExprIrOpKind))
    assert(lower.LoweringOwnershipTransportLiveBytes(transport) ==
               expectedLiveBytes *
                   int64(transport.definitionRows.len),
           "ownership transport: live bytes")
    assert(lower.LoweringOwnershipTransportPhysicalBufferCount(transport) ==
               15,
           "ownership transport: physical buffers")
    lower.LoweringOwnershipTransportRelease(transport)
    assert(lower.LoweringOwnershipTransportLiveBytes(transport) ==
               int64(0) &&
           lower.LoweringOwnershipTransportCapacityBytes(transport) ==
               int64(0) &&
           lower.LoweringOwnershipTransportPhysicalBufferCount(transport) ==
               0,
           "ownership transport: release")

fn appendStatementCollisionDefinition(
        transport: var lower.LoweringOwnershipTransportSoA) =
    transport.sourceValueDefinitionCount = 2
    lower.LoweringOwnershipTransportAppendExactRow(
        transport,
        8,
        12,
        int32(texpr.TypedExprValueDefinitionOriginBindingInitializer),
        31,
        14,
        18,
        19,
        31,
        37,
        texpr.TypedExprExprOwned,
        -1,
        texpr.TypedExprSnapshotTypeProofManagedValue,
        true,
        texpr.TypedExprIrOpCallExpr,
        30)

fn assertStatementCollisionUsesExactTypedNode() =
    var transport =
        ownershipTransport(texpr.TypedExprExprOwned, 37)
    appendStatementCollisionDefinition(transport)
    var body = callBody(coreir.BodyCallPassStackValueTag)
    var lowering = ownershipLoweringPlan()
    lower.LoweringBindManagedCallResultDefinition(
        body, lowering, transport, 19, 23, 0, 0)
    assert(body.callSequence[0].resultExprNodeIndex == 23 &&
           body.callSequence[0].resultValueDefinitionRow == 11 &&
           body.ops[0].valueDefExprNodeIndex == 23 &&
           body.ops[0].valueDefSemanticRow == 11,
           "ownership transport: statement collision lost exact TypedNode")

fn assertPlanLifecycleTracksOwnershipTransport() =
    var plan: lower.LoweringPlanStub
    var fnIr: lower.PrimaryObjectIrFunction
    fnIr.ownershipTransport =
        ownershipTransport(texpr.TypedExprExprOwned, 37)
    add(plan.primaryObjectIr.functions, fnIr)
    let trackedBytes =
        lower.LoweringPlanLifecycleTrackedRetainedBytes(plan)
    let trackedPhysicalBuffers =
        lower.LoweringPlanLifecycleTrackedPhysicalBufferCount(plan)
    assert(trackedBytes ==
               lower.LoweringPlanOwnershipTransportCapacityBytes(plan) &&
           trackedBytes > int64(0) &&
           trackedPhysicalBuffers == 15,
           "ownership transport: lowering lifecycle ingress")
    let freeBefore = system.memFreeCount()
    lower.LoweringPlanReleaseAfterPrimaryObjectPlan(plan)
    let freeDelta = system.memFreeCount() - freeBefore
    assert(freeDelta >= int64(trackedPhysicalBuffers) &&
           lower.LoweringPlanLifecycleTrackedStorageReleased(plan),
           "ownership transport: lowering lifecycle physical release")

