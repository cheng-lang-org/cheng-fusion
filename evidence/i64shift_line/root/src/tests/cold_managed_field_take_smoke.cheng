module cold_managed_field_take_smoke

type
    ColdManagedTakeInner =
        ok: bool
        values: int32[]

    ColdManagedTakeOuter =
        inner: ColdManagedTakeInner

fn main(): int32 =
    var outer: ColdManagedTakeOuter
    outer.inner.ok = true
    add(outer.inner.values, 7)

    var inner = outer.inner
    outer.inner = ColdManagedTakeInner()

    if !inner.ok || inner.values.len != 1 || inner.values[0] != 7:
        return 1
    if outer.inner.ok || outer.inner.values.len != 0:
        return 2
    echo("cold_managed_field_take=PASS")
    return 0
