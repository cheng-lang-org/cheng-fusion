type
    CastInner =
        value: int32

    CastRow =
        count: int32
        signedValue: int32
        inner: CastInner

fn main(): int32 =
    var row: CastRow
    row.count = 7
    row.signedValue = -9
    row.inner.value = 11

    let fieldU64: uint64 = uint64(row.count)
    let fieldI64: int64 = int64(row.signedValue)
    let nestedU64: uint64 = uint64(int32(row.inner.value))
    let localValue: int32 = 13
    let localU64: uint64 = uint64(localValue)

    var values: int32[]
    add(values, -15)
    let indexI64: int64 = int64(values[0])

    if fieldU64 != uint64(7):
        return 1
    if fieldI64 != int64(-9):
        return 2
    if nestedU64 != uint64(11):
        return 3
    if localU64 != uint64(13):
        return 4
    if indexI64 != int64(-15):
        return 5
    return 0
