import std/os

type
    ColdVarI64FieldStoreValue =
        value: int64

fn ColdVarI64FieldStoreWrite(
        target: var ColdVarI64FieldStoreValue,
        value: var int64) =
    target.value = value

fn main() =
    var target: ColdVarI64FieldStoreValue
    var value: int64 = int64(9223372036854775000)
    ColdVarI64FieldStoreWrite(target, value)
    assert(target.value == value, "var int64 field store lost value")
    os.WriteLine(os.Get_stdout(), "cold_var_i64_field_store_smoke: ok")
