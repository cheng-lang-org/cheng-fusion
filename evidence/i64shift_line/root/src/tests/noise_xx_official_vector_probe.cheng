# Official golden-vector gate for Noise_XX_25519_ChaChaPoly_SHA256
# (src/std/crypto/noise_xx.cheng), slice-3 gate ①.
#
# Vector source: noise-c (rweather/noise-c), tests/vector/noise-c-basic.txt,
# object with name=="Noise_XX_25519_ChaChaPoly_SHA256" (fetched verbatim via
# `curl` -- not through an LLM summarizer -- and diffed by a plain
# `json.load` script, so the hex constants below are byte-identical to the
# upstream file, not model-transcribed). Sender/receiver-per-message-index
# and post-split cipher assignment (message index 3 = responder's c2,
# index 4 = initiator's c1, index 5 = responder's c2 again) were cross-read
# from the reference test driver tests/vector/test-vector.c in the same
# repo (role alternates starting at the initiator for message 0; Split()
# assigns c1 = initiator-write/responder-read key, c2 = responder-write/
# initiator-read key, matching Noise spec 5.3).
#
# This probe does NOT re-derive the vector at runtime from any other source;
# it feeds the fixed keys through this repo's noise_xx.cheng state machine
# and asserts every intermediate ciphertext, the handshake hash, and three
# post-split transport messages match the upstream bytes exactly.

import std/system
import std/result
import std/rawbytes
import std/crypto/curve25519
import std/crypto/noise_xx as noise
import std/strutils as strutil

const
    initStaticPrivHex = "e61ef9919cde45dd5f82166404bd08e38bceb5dfdfded0a34c8df7ed542214d1"
    initEphemeralPrivHex = "893e28b9dc6ca8d611ab664754b8ceb7bac5117349a4439a6b0569da977c464a"
    respStaticPrivHex = "4a3acbfdb163dec651dfa3194dece676d437029c62a408b4c5ea9114246e4893"
    respEphemeralPrivHex = "bbdb4cdbd309f1a1f2e1456967fe288cadd6f712d65dc7b7793d5e63da6b375b"
    prologueHex = "50726f6c6f677565313233"

    payload0Hex = "4c756477696720766f6e204d69736573"
    payload1Hex = "4d757272617920526f746862617264"
    payload2Hex = "462e20412e20486179656b"
    payload3Hex = "4361726c204d656e676572"
    payload4Hex = "4a65616e2d426170746973746520536179"
    payload5Hex = "457567656e2042f6686d20766f6e2042617765726b"

    ct0Hex = "ca35def5ae56cec33dc2036731ab14896bc4c75dbb07a61f879f8e3afa4c79444c756477696720766f6e204d69736573"
    ct1Hex = "95ebc60d2b1fa672c1f46a8aa265ef51bfe38e7ccb39ec5be34069f14480884381cbad1f276e038c48378ffce2b65285e08d6b68aaa3629a5a8639392490e5b94a6d8798832d5372f220f161d9c2df035528f8982ffe09be9b5c412f8a0db5d21351f20af1370d0bf8ef1a8c59a30e"
    ct2Hex = "c7195ffacac1307ff99046f219750fc47693e23c3cb08b89c2af808b444850a8589981dfbd651e6ff4724a781cc2aa6158c9fea0d4ec82a286427484c5b8c8123a7a6002b1de9f9775fc97"
    ct3Hex = "96763ed773f8e47bb3712f0e29b3060ffc956ffc146cee53d5e1df"
    ct4Hex = "3e40f15f6f3a46ae446b253bf8b1d9ffb6ed9b174d272328ff91a7e2e5c79c07f5"
    ct5Hex = "eb3f3515110702e047a6c9da4478b6ead94873c11c0f2d710ddb3f09fce024b3a58502ae3f"

    handshakeHashHex = "852a28d2146785c54bd8334f4e460c80d7fe4fd0cc5bc0abef2a24a3c4d44d5f"

fn keyPairFromHex(privHex: str): curve25519.Curve25519KeyPair =
    let priv: Bytes = BytesFromHex(privHex)
    let pubRes: Result[Bytes] = curve25519.curve25519PublicFromPrivate(priv)
    assert(IsOk(pubRes), "vector: derive public key")
    var kp: curve25519.Curve25519KeyPair
    kp.priv = priv
    kp.pub = Value(pubRes)
    return kp

fn requireEqual(got: Bytes, want: Bytes, label: str) =
    if ! BytesEqual(got, want):
        echo(strutil.Join(["MISMATCH ", label, " got=", BytesToHex(got), " want=", BytesToHex(want)], ""))
        assert(false, label)

fn main(): int32 =
    let prologue: Bytes = BytesFromHex(prologueHex)
    var initiator: noise.HandshakeState = noise.noiseHandshakeInit(keyPairFromHex(initStaticPrivHex), prologue)
    noise.noiseHandshakeSetEphemeral(initiator, keyPairFromHex(initEphemeralPrivHex))
    var responder: noise.HandshakeState = noise.noiseHandshakeInit(keyPairFromHex(respStaticPrivHex), prologue)
    noise.noiseHandshakeSetEphemeral(responder, keyPairFromHex(respEphemeralPrivHex))

    # -> e
    let msg0Res: Result[Bytes] = noise.noiseWriteMessage1(initiator, BytesFromHex(payload0Hex))
    assert(IsOk(msg0Res), "vector: WriteMessage1")
    requireEqual(Value(msg0Res), BytesFromHex(ct0Hex), "message0 ciphertext")
    let read0Res: Result[Bytes] = noise.noiseReadMessage1(responder, Value(msg0Res))
    assert(IsOk(read0Res), "vector: ReadMessage1")
    requireEqual(Value(read0Res), BytesFromHex(payload0Hex), "message0 plaintext")

    # <- e, ee, s, es
    let msg1Res: Result[Bytes] = noise.noiseWriteMessage2(responder, BytesFromHex(payload1Hex))
    assert(IsOk(msg1Res), "vector: WriteMessage2")
    requireEqual(Value(msg1Res), BytesFromHex(ct1Hex), "message1 ciphertext")
    let read1Res: Result[Bytes] = noise.noiseReadMessage2(initiator, Value(msg1Res))
    assert(IsOk(read1Res), "vector: ReadMessage2")
    requireEqual(Value(read1Res), BytesFromHex(payload1Hex), "message1 plaintext")

    # -> s, se
    let msg2Res: Result[Bytes] = noise.noiseWriteMessage3(initiator, BytesFromHex(payload2Hex))
    assert(IsOk(msg2Res), "vector: WriteMessage3")
    requireEqual(Value(msg2Res), BytesFromHex(ct2Hex), "message2 ciphertext")
    let read2Res: Result[Bytes] = noise.noiseReadMessage3(responder, Value(msg2Res))
    assert(IsOk(read2Res), "vector: ReadMessage3")
    requireEqual(Value(read2Res), BytesFromHex(payload2Hex), "message2 plaintext")

    let hInit: Bytes = noise.noiseHandshakeHash(initiator)
    let hResp: Bytes = noise.noiseHandshakeHash(responder)
    requireEqual(hInit, BytesFromHex(handshakeHashHex), "handshake_hash (initiator)")
    requireEqual(hResp, BytesFromHex(handshakeHashHex), "handshake_hash (responder)")

    # Split(): c1 = initiator-write/responder-read, c2 = responder-write/initiator-read.
    var initC1: noise.CipherState
    var initC2: noise.CipherState
    let splitIRes: Result[bool] = noise.noiseHandshakeSplit(initiator, initC1, initC2)
    assert(IsOk(splitIRes), "vector: initiator Split")
    var respC1: noise.CipherState
    var respC2: noise.CipherState
    let splitRRes: Result[bool] = noise.noiseHandshakeSplit(responder, respC1, respC2)
    assert(IsOk(splitRRes), "vector: responder Split")
    requireEqual(initC1.k, respC1.k, "split c1 must match")
    requireEqual(initC2.k, respC2.k, "split c2 must match")

    # message3: responder writes with c2, initiator reads with c2.
    let ct3Res: Result[Bytes] = noise.cipherStateEncryptWithAd(respC2, EmptyBytes(), BytesFromHex(payload3Hex))
    assert(IsOk(ct3Res), "vector: transport message3 encrypt")
    requireEqual(Value(ct3Res), BytesFromHex(ct3Hex), "message3 ciphertext")
    let pt3Res: Result[Bytes] = noise.cipherStateDecryptWithAd(initC2, EmptyBytes(), Value(ct3Res))
    assert(IsOk(pt3Res), "vector: transport message3 decrypt")
    requireEqual(Value(pt3Res), BytesFromHex(payload3Hex), "message3 plaintext")

    # message4: initiator writes with c1, responder reads with c1.
    let ct4Res: Result[Bytes] = noise.cipherStateEncryptWithAd(initC1, EmptyBytes(), BytesFromHex(payload4Hex))
    assert(IsOk(ct4Res), "vector: transport message4 encrypt")
    requireEqual(Value(ct4Res), BytesFromHex(ct4Hex), "message4 ciphertext")
    let pt4Res: Result[Bytes] = noise.cipherStateDecryptWithAd(respC1, EmptyBytes(), Value(ct4Res))
    assert(IsOk(pt4Res), "vector: transport message4 decrypt")
    requireEqual(Value(pt4Res), BytesFromHex(payload4Hex), "message4 plaintext")

    # message5: responder writes with c2 (2nd use, nonce=1), initiator reads with c2.
    let ct5Res: Result[Bytes] = noise.cipherStateEncryptWithAd(respC2, EmptyBytes(), BytesFromHex(payload5Hex))
    assert(IsOk(ct5Res), "vector: transport message5 encrypt")
    requireEqual(Value(ct5Res), BytesFromHex(ct5Hex), "message5 ciphertext")
    let pt5Res: Result[Bytes] = noise.cipherStateDecryptWithAd(initC2, EmptyBytes(), Value(ct5Res))
    assert(IsOk(pt5Res), "vector: transport message5 decrypt")
    requireEqual(Value(pt5Res), BytesFromHex(payload5Hex), "message5 plaintext")

    echo("noise_xx_official_vector_probe ok (noise-c Noise_XX_25519_ChaChaPoly_SHA256, byte-exact)")
    return 0
