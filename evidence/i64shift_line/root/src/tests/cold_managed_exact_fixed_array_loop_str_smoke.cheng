import std/system as system

type ColdManagedExactFixedArrayLoopStrOwner =
    labels: str[2]

fn ColdManagedExactFixedArrayLoopStrNew(value: str): str =
    return system.NewStringCopy(
        system.StrDataPtr(value), value.len)

fn ColdManagedExactFixedArrayLoopStrExercise(): int32 =
    var owner: ColdManagedExactFixedArrayLoopStrOwner
    for step in 0..<3:
        if step == 1:
            if owner.labels[0] != "str-loop-0":
                return 1
        elif step == 2:
            if owner.labels[0] != "str-loop-1":
                return 2

        if step == 0:
            owner.labels[0] = ColdManagedExactFixedArrayLoopStrNew("str-loop-0")
        elif step == 1:
            owner.labels[0] = ColdManagedExactFixedArrayLoopStrNew("str-loop-1")
        else:
            owner.labels[0] = ColdManagedExactFixedArrayLoopStrNew("str-loop-2")
        owner.labels[0] = owner.labels[0]
        owner.labels[1] = ColdManagedExactFixedArrayLoopStrNew("str-clear")
        owner.labels[1] = ""

    if owner.labels[0] != "str-loop-2" || len(owner.labels[1]) != 0:
        return 3
    return 0

fn main(): int32 =
    let allocBefore = system.memAllocCount()
    let freeBefore = system.memFreeCount()
    let liveBefore = system.memLiveCount()
    let retainBefore = system.memRetainCount()
    let releaseBefore = system.memReleaseCount()

    if ColdManagedExactFixedArrayLoopStrExercise() != 0:
        return 1

    let allocDelta = system.memAllocCount() - allocBefore
    let freeDelta = system.memFreeCount() - freeBefore
    let liveDelta = system.memLiveCount() - liveBefore
    let retainDelta = system.memRetainCount() - retainBefore
    let releaseDelta = system.memReleaseCount() - releaseBefore
    if allocDelta != int64(6) || allocDelta != freeDelta:
        return 2
    if liveDelta != int64(0):
        return 3
    if retainDelta != int64(3):
        return 4
    if releaseDelta != int64(9):
        return 5
    if releaseDelta != retainDelta + freeDelta:
        return 6

    echo(Fmt"cold_managed_exact_fixed_array_loop_str_alloc_delta={allocDelta}")
    echo(Fmt"cold_managed_exact_fixed_array_loop_str_free_delta={freeDelta}")
    echo(Fmt"cold_managed_exact_fixed_array_loop_str_live_delta={liveDelta}")
    echo(Fmt"cold_managed_exact_fixed_array_loop_str_retain_delta={retainDelta}")
    echo(Fmt"cold_managed_exact_fixed_array_loop_str_release_delta={releaseDelta}")
    echo("cold_managed_exact_fixed_array_loop_str=PASS")
    return 0
