type
    R15Bundle =
        fds: int32[]
        tag: str

fn R15Close(out: var R15Bundle): bool =
    out.fds = []
    return true

fn main(): int32 =
    var b: R15Bundle
    b.tag = "pins"
    if !R15Close(b):
        return 10
    if b.fds.len != 0:
        return 11
    echo(Fmt"r15_emptyseq_store ok n={b.fds.len} tag={b.tag}")
    return 0
