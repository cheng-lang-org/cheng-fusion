import cheng/tests/cold_cross_module_managed_var_exact_support as expected
import cheng/tests/cold_cross_module_managed_var_exact_other as actual

@borrows
fn resetRecords(
        records: var expected.CrossModuleManagedVarRecord[]): int32 =
    records = []
    return records.len

fn main(): int32 =
    var records: actual.CrossModuleManagedVarRecord[]
    if resetRecords(records) != 0:
        return 1
    return 0
