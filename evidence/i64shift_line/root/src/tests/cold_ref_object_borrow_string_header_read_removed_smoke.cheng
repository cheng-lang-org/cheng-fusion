type
    ColdRefObjectBorrowStringHeaderRemovedOuter = ref object
        text: str

fn ColdRefObjectBorrowStringHeaderRemovedWrite(
        text: var str) =
    text = "changed"

fn ColdRefObjectBorrowStringHeaderRemovedMutate(
        out: var ColdRefObjectBorrowStringHeaderRemovedOuter) =
    var text = out.text
    let forbiddenLength = 1
    ColdRefObjectBorrowStringHeaderRemovedWrite(text)
    if forbiddenLength == 0:
        return

fn main(): int32 =
    var out = new(ColdRefObjectBorrowStringHeaderRemovedOuter)
    out.text = "initial"
    ColdRefObjectBorrowStringHeaderRemovedMutate(out)
    return 0
