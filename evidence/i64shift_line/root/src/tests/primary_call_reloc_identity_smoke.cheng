import cheng/core/backend/primary_object_plan as pobj
import cheng/core/backend/codegen_contract as contract
import cheng/core/ir/core_types as coreir
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256

fn exactCid(label: str): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(64)
    for byteIndex in 0..<label.len:
        layout.ByteBufAppendByte(
            buf, int32(label[byteIndex]) & 255)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn main(): int32 =
    let interfaceCid = exactCid("typed-function-interface")

    var state: pobj.PrimaryObjectPlanPhaseState
    add(state.relocSourceItemIds, 100007)
    add(state.relocWordOffsets, 23)
    add(state.relocTargetSymbols, "任意UTF-8函数")
    add(state.relocTargetDomainKinds,
        coreir.BodyCallTargetDomainInvalidTag)
    add(state.relocTargetRows, -1)
    add(state.relocTargetInterfaceCids, layout.FixedBytes32())
    add(state.relocCallOrdinal, 0)

    var recipeReloc: contract.RegallocA64ActionReloc
    recipeReloc.kind = contract.RegallocA64RelocCall26
    recipeReloc.targetDomain =
        coreir.BodyCallTargetDomainFunctionTag
    recipeReloc.targetRow = 7
    recipeReloc.targetInterfaceCid =
        layout.FixedBytes32Copy(interfaceCid)
    assert(pobj.PrimaryObjectPlanBindCallRelocIdentityFromRecipe(
               state, 0, recipeReloc),
           "recipe triple must bind the exact plan row")
    assert(state.relocTargetDomainKinds[0] ==
               recipeReloc.targetDomain &&
           state.relocTargetRows[0] == recipeReloc.targetRow &&
           layout.FixedBytes32Equal(
               state.relocTargetInterfaceCids[0],
               recipeReloc.targetInterfaceCid),
           "recipe triple changed while crossing the phase state")

    assert(!pobj.PrimaryObjectPlanBindCallRelocIdentityFromRecipe(
               state, 0, recipeReloc),
           "immutable recipe identity row must reject rebinding")

    var dataReloc: contract.RegallocA64ActionReloc
    dataReloc.kind = contract.RegallocA64RelocPage21
    assert(!pobj.PrimaryObjectPlanBindCallRelocIdentityFromRecipe(
               state, 0, dataReloc),
           "data relocation must not enter the call identity sidecar")

    var plan: pobj.PrimaryObjectPlan
    plan.actualBackendKind = "primary"
    plan.targetTriple = "riscv64-unknown-linux-gnu"
    plan.relocSourceItemIds = state.relocSourceItemIds
    plan.relocWordOffsets = state.relocWordOffsets
    plan.relocTargetSymbols = state.relocTargetSymbols
    plan.relocTargetDomainKinds = state.relocTargetDomainKinds
    plan.relocTargetRows = state.relocTargetRows
    plan.relocTargetInterfaceCids = state.relocTargetInterfaceCids
    plan.relocCallTargetIdentityReceiptCid =
        pobj.PrimaryObjectPlanCallRelocIdentityReceiptCid(plan)
    var err: str
    assert(pobj.PrimaryObjectPlanCallRelocIdentityStrictValidateInto(
               plan, err), err)

    plan.relocTargetRows[0] = 8
    assert(!pobj.PrimaryObjectPlanCallRelocIdentityStrictValidateInto(
               plan, err),
           "row mutation must invalidate the call identity receipt")
    plan.relocTargetRows[0] = recipeReloc.targetRow
    plan.relocCallTargetIdentityReceiptCid =
        pobj.PrimaryObjectPlanCallRelocIdentityReceiptCid(plan)
    assert(pobj.PrimaryObjectPlanCallRelocIdentityStrictValidateInto(
               plan, err), err)

    plan.relocTargetDomainKinds[0] =
        coreir.BodyCallTargetDomainInvalidTag
    plan.relocTargetRows[0] = -1
    plan.relocTargetInterfaceCids[0] = layout.FixedBytes32()
    plan.relocCallTargetIdentityReceiptCid =
        pobj.PrimaryObjectPlanCallRelocIdentityReceiptCid(plan)
    assert(!pobj.PrimaryObjectPlanCallRelocIdentityStrictValidateInto(
               plan, err) &&
           err == "primary object: call reloc exact identity missing",
           "explicit invalid call identity must remain a hard red")
    plan.relocTargetDomainKinds[0] = recipeReloc.targetDomain
    plan.relocTargetRows[0] = recipeReloc.targetRow
    plan.relocTargetInterfaceCids[0] =
        layout.FixedBytes32Copy(interfaceCid)
    plan.relocCallTargetIdentityReceiptCid =
        pobj.PrimaryObjectPlanCallRelocIdentityReceiptCid(plan)

    add(plan.itemIds, 100007)
    add(plan.symbolNames, "任意UTF-8函数")
    add(plan.symbolTypedFunctionIndexes, 7)
    add(plan.symbolNameIds, 41)
    add(plan.symbolRoles, pobj.PrimaryObjectSymbolRoleTypedName)
    add(plan.symbolInterfaceCids,
        layout.FixedBytes32Copy(interfaceCid))
    plan.symbolNameInternPoolDomainCid = exactCid("intern-domain")
    plan.symbolLoweringIdentityReceiptCid = exactCid("lowering-identity")
    plan.symbolIdentityReceiptCid =
        pobj.PrimaryObjectPlanSymbolIdentityReceiptCid(plan)
    assert(pobj.PrimaryObjectPlanSymbolIdentityStrictValidateInto(
               plan, err), err)
    plan.symbolInterfaceCids[0] = exactCid("mutated-interface")
    assert(!pobj.PrimaryObjectPlanSymbolIdentityStrictValidateInto(
               plan, err),
           "function interface CID mutation must invalidate the receipt")
    plan.symbolInterfaceCids[0] = layout.FixedBytes32Copy(interfaceCid)
    plan.symbolIdentityReceiptCid =
        pobj.PrimaryObjectPlanSymbolIdentityReceiptCid(plan)

    var releaseReceipt: pobj.PrimaryObjectPlanReleaseReceipt
    pobj.PrimaryObjectPlanReleaseWithReceipt(plan, releaseReceipt)
    assert(releaseReceipt.releasedOwnedStorageColumnCount ==
               pobj.PrimaryObjectPlanOwnedStorageColumnCount &&
           releaseReceipt.storageReleased,
           "identity sidecar storage must be released atomically")
    assert(pobj.PrimaryObjectPlanReleaseReceiptConsumeStrictInto(
               plan, releaseReceipt, err), err)

    echo("primary_call_reloc_identity_smoke=pass")
    echo(layout.FixedBytes32Hex(interfaceCid))
    return 0
