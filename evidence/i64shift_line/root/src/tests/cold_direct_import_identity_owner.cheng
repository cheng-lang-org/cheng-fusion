import cheng/tests/cold_direct_import_identity_dep as left
import cheng/tests/cold_direct_import_identity_dep as right

type
    LeftScalar = left.DirectScalar
    RightScalar = right.DirectScalar

    DirectDerived = object of left.DirectBase
        childValue: int32

    LeftBox = left.DirectBox[left.DirectLeaf]
    RightBox = right.DirectBox[right.DirectLeaf]

    DirectHolder =
        leftLeaf: left.DirectLeaf
        rightLeaf: right.DirectLeaf
        leftBox: LeftBox
        rightBox: RightBox
