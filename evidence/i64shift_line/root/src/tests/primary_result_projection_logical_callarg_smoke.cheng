import std/system
import std/result

type
    ProjectionPayload =
        code: int32
        text: str

    BoolBox =
        value: bool

var rhsSideEffectCount: int32
var evaluationOrderLog: int32

fn rhsSideEffect(value: bool): bool =
    rhsSideEffectCount = rhsSideEffectCount + 1
    return value

fn orderedBool(marker: int32, value: bool): bool =
    evaluationOrderLog = evaluationOrderLog * 10 + marker
    return value

fn consumeBool(value: bool): bool =
    return value

fn returnAnd(lhs: bool): bool =
    return lhs && rhsSideEffect(true)

fn returnOr(lhs: bool): bool =
    return lhs || rhsSideEffect(true)

fn returnNot(lhs: bool): bool =
    return !(lhs && rhsSideEffect(true))

fn returnNestedNot(lhs: bool): bool =
    return !(!(lhs || rhsSideEffect(true)))

fn resetSideEffects() =
    rhsSideEffectCount = 0

fn resetEvaluationOrder() =
    evaluationOrderLog = 0

fn consumeThree(first: bool, second: bool, third: bool): bool =
    return first && second && third

fn assertCallArgShortCircuit() =
    resetSideEffects()
    assert(!consumeBool(false && rhsSideEffect(true)) && rhsSideEffectCount == 0,
           "logical call arg && skips rhs")
    resetSideEffects()
    assert(consumeBool(true || rhsSideEffect(false)) && rhsSideEffectCount == 0,
           "logical call arg || skips rhs")
    resetSideEffects()
    assert(consumeBool(!(false && rhsSideEffect(true))) && rhsSideEffectCount == 0,
           "logical call arg ! preserves nested short circuit")
    resetSideEffects()
    assert(consumeBool(true && rhsSideEffect(true)) && rhsSideEffectCount == 1,
           "logical call arg executes reachable rhs once")
    resetSideEffects()
    assert(consumeBool(!(!(false || rhsSideEffect(true)))) && rhsSideEffectCount == 1,
           "logical call arg nested ! executes reachable rhs once")

fn assertAssignShortCircuit() =
    var localValue: bool
    var box: BoolBox
    resetSideEffects()
    localValue = false && rhsSideEffect(true)
    assert(!localValue && rhsSideEffectCount == 0,
           "logical local assign && skips rhs")
    resetSideEffects()
    localValue = true || rhsSideEffect(false)
    assert(localValue && rhsSideEffectCount == 0,
           "logical local assign || skips rhs")
    resetSideEffects()
    localValue = !(false && rhsSideEffect(true))
    assert(localValue && rhsSideEffectCount == 0,
           "logical local assign ! preserves nested short circuit")
    resetSideEffects()
    localValue = true && rhsSideEffect(true)
    assert(localValue && rhsSideEffectCount == 1,
           "logical local assign executes reachable rhs once")
    resetSideEffects()
    localValue = !(!(true || rhsSideEffect(false)))
    assert(localValue && rhsSideEffectCount == 0,
           "logical local assign nested ! skips rhs")
    resetSideEffects()
    box.value = false && rhsSideEffect(true)
    assert(!box.value && rhsSideEffectCount == 0,
           "logical field assign && skips rhs")
    resetSideEffects()
    box.value = true || rhsSideEffect(false)
    assert(box.value && rhsSideEffectCount == 0,
           "logical field assign || skips rhs")
    resetSideEffects()
    box.value = !(false && rhsSideEffect(true))
    assert(box.value && rhsSideEffectCount == 0,
           "logical field assign ! preserves nested short circuit")
    resetSideEffects()
    box.value = false || rhsSideEffect(true)
    assert(box.value && rhsSideEffectCount == 1,
           "logical field assign executes reachable rhs once")
    resetSideEffects()
    box.value = !(!(false || rhsSideEffect(true)))
    assert(box.value && rhsSideEffectCount == 1,
           "logical field assign nested ! executes reachable rhs once")

fn assertReturnShortCircuit() =
    resetSideEffects()
    assert(!returnAnd(false) && rhsSideEffectCount == 0,
           "logical return && skips rhs")
    resetSideEffects()
    assert(returnOr(true) && rhsSideEffectCount == 0,
           "logical return || skips rhs")
    resetSideEffects()
    assert(returnNot(false) && rhsSideEffectCount == 0,
           "logical return ! preserves nested short circuit")
    resetSideEffects()
    assert(returnAnd(true) && rhsSideEffectCount == 1,
           "logical return && executes reachable rhs once")
    resetSideEffects()
    assert(returnOr(false) && rhsSideEffectCount == 1,
           "logical return || executes reachable rhs once")
    resetSideEffects()
    assert(!returnNot(true) && rhsSideEffectCount == 1,
           "logical return ! executes reachable rhs once")
    resetSideEffects()
    assert(returnNestedNot(true) && rhsSideEffectCount == 0,
           "logical return nested ! skips rhs")
    resetSideEffects()
    assert(returnNestedNot(false) && rhsSideEffectCount == 1,
           "logical return nested ! executes reachable rhs once")

fn assertMultiLeafOrder() =
    resetEvaluationOrder()
    let notOr = consumeBool(!(orderedBool(1, false) ||
                              orderedBool(2, true) ||
                              orderedBool(9, true)))
    assert(!notOr, "logical !(a || b) result")
    assert(evaluationOrderLog == 12,
           "logical !(a || b) evaluates left-to-right and skips the third leaf")

    resetEvaluationOrder()
    let andThenOr = consumeBool((orderedBool(1, true) &&
                                 orderedBool(2, false)) ||
                                orderedBool(3, true))
    assert(andThenOr, "logical (a && b) || c result")
    assert(evaluationOrderLog == 123,
           "logical (a && b) || c evaluates leaves left-to-right")

    resetEvaluationOrder()
    let andNestedOr = consumeBool(orderedBool(1, true) &&
                                  (orderedBool(2, false) ||
                                   orderedBool(3, true)))
    assert(andNestedOr, "logical a && (b || c) result")
    assert(evaluationOrderLog == 123,
           "logical a && (b || c) evaluates leaves left-to-right")

fn assertThreeArgumentOrder() =
    resetEvaluationOrder()
    let firstResult = consumeThree(orderedBool(1, true) &&
                                   orderedBool(2, false) &&
                                   orderedBool(9, true),
                                   orderedBool(3, true),
                                   orderedBool(4, true))
    assert(!firstResult, "logical first argument result")
    assert(evaluationOrderLog == 1234,
           "logical first argument joins before later arguments")

    resetEvaluationOrder()
    let middleResult = consumeThree(orderedBool(1, true),
                                    orderedBool(2, true) &&
                                    orderedBool(3, false) &&
                                    orderedBool(9, true),
                                    orderedBool(4, true))
    assert(!middleResult, "logical middle argument result")
    assert(evaluationOrderLog == 1234,
           "logical middle argument preserves argument order and join")

    resetEvaluationOrder()
    let lastResult = consumeThree(orderedBool(1, true),
                                  orderedBool(2, true),
                                  orderedBool(3, true) &&
                                  orderedBool(4, false) &&
                                  orderedBool(9, true))
    assert(!lastResult, "logical last argument result")
    assert(evaluationOrderLog == 1234,
           "logical last argument preserves argument order and short-circuit")

fn projectionScalar(ok: bool): Result[int32] =
    if ok:
        return Ok[int32](17)
    return Err[int32]("scalar-error")

fn projectionText(): Result[str] =
    return Ok[str]("ready")

fn projectionAggregate(): Result[ProjectionPayload] =
    return Ok[ProjectionPayload](ProjectionPayload(code: 29, text: "payload"))

fn main(): int32 =
    assertCallArgShortCircuit()
    assertAssignShortCircuit()
    assertReturnShortCircuit()
    assertMultiLeafOrder()
    assertThreeArgumentOrder()
    let scalarRes = projectionScalar(true)
    assert(IsOk(scalarRes) && Value(scalarRes) == 17, "result projection scalar logand")
    let textRes = projectionText()
    assert(IsOk(textRes) && Value(textRes) == "ready", "result projection str logand")
    let aggregateRes = projectionAggregate()
    assert(IsOk(aggregateRes) && Value(aggregateRes).code == 29, "result projection aggregate logand")
    let errRes = projectionScalar(false)
    assert(!(IsOk(errRes) && Value(errRes) == 0),
           "result projection logand short circuit")
    assert(IsErr(errRes) || Value(errRes) == 0, "result projection logor short circuit")
    echo("primary_result_projection_logical_callarg_smoke ok")
    return 0
