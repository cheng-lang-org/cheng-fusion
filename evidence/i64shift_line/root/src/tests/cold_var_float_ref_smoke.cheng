fn SetFloat64(out: var float64) =
    out = float64(9)

fn ForwardFloat64(out: var float64): int32 =
    SetFloat64(out)
    return int32(out)

fn SetFloat32(out: var float32) =
    out = float32(7)

fn ReadFloat32(out: var float32): int32 =
    SetFloat32(out)
    return int32(out)

fn SetAliasFloat(out: var AliasFloat) =
    out = float64(11)

fn main(): int32 =
    var wide: float64
    if ForwardFloat64(wide) != 9:
        return 1
    if int32(wide) != 9:
        return 2

    var narrow: float32
    if ReadFloat32(narrow) != 7:
        return 3
    if int32(narrow) != 7:
        return 4

    var aliased: AliasFloat
    SetAliasFloat(aliased)
    if int32(aliased) != 11:
        return 5
    return 0
type AliasFloat = float64
