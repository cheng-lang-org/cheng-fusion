import std/os as os
import std/result
import std/rawbytes
import std/crypto/sha256
import std/strings
import cheng/core/csg_core/validator as csg
import cheng/core/csg_finance/certified_transaction as finance

@borrows
fn smokeFail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

fn smokeExpect(cond: bool, message: str): int32 =
    if !cond:
        return smokeFail(message)
    return 0

fn smokeHash(text: str): str =
    let digest = sha256.Sha256Digest(rawbytes.BytesFromString(text))
    return strings.ConcatStr("sha256:", rawbytes.BytesToHex(digest))

fn smokeBuildInput(riskLevel: str, signerRequirement: str): finance.FinanceCompileInput =
    var intent = finance.FinanceIntent(
        id: "intent_1",
        userId: "user_alice",
        sourceKind: finance.FinanceSourceUserIntent,
        sourceIntentHash: smokeHash("alice pays bob 25 USDC"),
        actionKind: finance.FinanceActionInternalPayment,
        chainId: int64(8453),
        asset: "USDC",
        amount: int64(25),
        recipientIdentity: "did:unimaker:bob",
        recipientAddress: "0xbob",
        userAuthorized: true
    )
    var policy = finance.FinancePolicy(
        id: "policy_1",
        maxAmount: int64(50),
        allowedChainId: int64(8453),
        allowedAsset: "USDC",
        allowedRecipientIdentity: "did:unimaker:bob",
        allowedRecipientAddress: "0xbob",
        allowedContract: "0xunimakerpay",
        allowedSelector: "0xa9059cbb",
        validUntilBlock: int64(9000),
        maxSlippageBps: 0,
        riskLevel: riskLevel,
        signerRequirement: signerRequirement,
        forbidApproveAll: true,
        forbidDelegatecall: true,
        allowUnknownContract: false,
        policyAuthorizationScheme: finance.FinancePolicyAuthClassicalMlDsa,
        rootAuthorizationScheme: finance.FinanceRootAuthSlhDsa,
        executionSignatureScheme: finance.FinanceExecutionSignatureChainNative
    )
    var snapshot = finance.FinanceStateSnapshot(
        id: "state_1",
        chainId: int64(8453),
        account: "0xalice",
        blockNumber: int64(8000),
        nonce: int64(7),
        balance: int64(100),
        allowance: int64(0),
        price: int64(1000000),
        stateReadsHash: smokeHash("state reads v1")
    )
    var contract = finance.FinanceContractProfile(
        id: "contract_1",
        chainId: int64(8453),
        contractAddress: "0xunimakerpay",
        selector: "0xa9059cbb",
        selectorName: "transfer",
        abiHash: smokeHash("abi transfer(address,uint256)"),
        knownContract: true,
        unknownCall: false,
        containsDelegatecall: false,
        approveAll: false,
        supportsSimulation: true
    )
    let intentHash = finance.FinanceIntentHash(intent)
    let policyHash = finance.FinancePolicyHash(policy)
    let stateHash = finance.FinanceStateSnapshotHash(snapshot)
    let contractHash = finance.FinanceContractProfileHash(contract)
    let payloadHash = smokeHash("chain-native payload v1")
    let calldataHash = smokeHash("calldata transfer bob 25")
    var payload = finance.FinanceSigningPayload(
        id: "payload_1",
        chainId: int64(8453),
        contractAddress: "0xunimakerpay",
        selector: "0xa9059cbb",
        calldataHash: calldataHash,
        payloadHash: payloadHash,
        intentHash: intentHash,
        policyHash: policyHash,
        stateSnapshotHash: stateHash,
        contractProfileHash: contractHash,
        validUntilBlock: int64(9000),
        maxSlippageBps: 0,
        stateReadsHash: snapshot.stateReadsHash,
        nonce: int64(7)
    )
    var simulation = finance.FinanceSimulationResult(
        id: "sim_1",
        ok: true,
        payloadHash: payloadHash,
        calldataHash: calldataHash,
        stateReadsHash: snapshot.stateReadsHash,
        outputAsset: "USDC",
        outputAmount: int64(25),
        maxLossAmount: int64(25),
        error: ""
    )
    return finance.FinanceCompileInput(
        intent: intent,
        policy: policy,
        stateSnapshot: snapshot,
        contractProfile: contract,
        simulation: simulation,
        payload: payload
    )

fn smokeCompileMustFail(input: finance.FinanceCompileInput, label: str): int32 =
    let res = finance.FinanceCompileCertifiedTransaction(input)
    if smokeExpect(IsErr(res), label) != 0:
        return 1
    return 0

fn smokeAuthorizeMustFail(cert: finance.FinanceCertifiedTransaction,
                          signerKind: str,
                          payload: finance.FinanceSigningPayload,
                          label: str): int32 =
    let res = finance.FinanceSignerGateAuthorize(cert, signerKind, payload)
    if smokeExpect(IsErr(res), label) != 0:
        return 1
    return 0

fn main(): int32 =
    var lowInput = smokeBuildInput(finance.FinanceRiskLow, finance.FinanceSignerSession)
    let lowRes = finance.FinanceCompileCertifiedTransaction(lowInput)
    if smokeExpect(IsOk(lowRes), "low risk certified transaction should compile") != 0:
        if IsErr(lowRes):
            os.WriteLine(os.Get_stderr(), Error(lowRes))
        return 1
    let lowCert = Value(lowRes)
    if smokeExpect(lowCert.complete, "certified transaction must be complete") != 0:
        return 1
    let lowResAgain = finance.FinanceCompileCertifiedTransaction(lowInput)
    if smokeExpect(IsOk(lowResAgain), "repeated compile should succeed") != 0:
        return 1
    if smokeExpect(Value(lowResAgain).certifiedHash == lowCert.certifiedHash,
                   "same transaction environment must produce stable certified hash") != 0:
        return 1
    let lowAuth = finance.FinanceSignerGateAuthorize(lowCert, finance.FinanceSignerSession, lowInput.payload)
    if smokeExpect(IsOk(lowAuth), "low risk transaction should authorize session signer") != 0:
        return 1
    if smokeExpect(Value(lowAuth).authorized, "session signer authorization should be true") != 0:
        return 1

    var overAmount = lowInput
    overAmount.intent.amount = int64(75)
    if smokeCompileMustFail(overAmount, "amount over policy max must fail") != 0:
        return 1

    var approveAll = lowInput
    approveAll.contractProfile.approveAll = true
    if smokeCompileMustFail(approveAll, "approve all must fail") != 0:
        return 1

    var payloadMismatch = lowInput
    payloadMismatch.payload.policyHash = smokeHash("wrong policy")
    if smokeCompileMustFail(payloadMismatch, "payload/policy mismatch must fail") != 0:
        return 1

    var simulationMismatch = lowInput
    simulationMismatch.simulation.calldataHash = smokeHash("different calldata")
    if smokeCompileMustFail(simulationMismatch, "simulation/final calldata mismatch must fail") != 0:
        return 1

    var expired = lowInput
    expired.stateSnapshot.blockNumber = int64(9001)
    if smokeCompileMustFail(expired, "expired block must fail") != 0:
        return 1

    var aiProposal = lowInput
    aiProposal.intent.sourceKind = "ai_proposal"
    if smokeCompileMustFail(aiProposal, "AI proposal without user intent must fail") != 0:
        return 1

    var mutatedPayload = lowInput.payload
    mutatedPayload.payloadHash = smokeHash("mutated payload")
    if smokeAuthorizeMustFail(lowCert, finance.FinanceSignerSession, mutatedPayload,
                              "signer gate must reject mismatched payload") != 0:
        return 1

    var mediumInput = smokeBuildInput(finance.FinanceRiskMedium, finance.FinanceSignerPasskey)
    let mediumRes = finance.FinanceCompileCertifiedTransaction(mediumInput)
    if smokeExpect(IsOk(mediumRes), "medium risk should compile with passkey policy") != 0:
        return 1
    let mediumCert = Value(mediumRes)
    if smokeAuthorizeMustFail(mediumCert, finance.FinanceSignerSession, mediumInput.payload,
                              "medium risk must not authorize session signer") != 0:
        return 1
    let mediumAuth = finance.FinanceSignerGateAuthorize(mediumCert, finance.FinanceSignerPasskey, mediumInput.payload)
    if smokeExpect(IsOk(mediumAuth), "medium risk should authorize passkey signer") != 0:
        return 1

    var highInput = smokeBuildInput(finance.FinanceRiskHigh, finance.FinanceSignerHardware)
    let highRes = finance.FinanceCompileCertifiedTransaction(highInput)
    if smokeExpect(IsOk(highRes), "high risk should compile with hardware policy") != 0:
        if IsErr(highRes):
            os.WriteLine(os.Get_stderr(), Error(highRes))
        return 1
    let highCert = Value(highRes)
    if smokeAuthorizeMustFail(highCert, finance.FinanceSignerPasskey, highInput.payload,
                              "high risk must not authorize passkey signer") != 0:
        return 1
    let highAuth = finance.FinanceSignerGateAuthorize(highCert, finance.FinanceSignerHardware, highInput.payload)
    if smokeExpect(IsOk(highAuth), "high risk should authorize hardware signer") != 0:
        return 1

    let schemaFact = "{\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\",\"features\":[\"core-facts\",\"finance\"]}"
    let certFact = "{\"kind\":\"csg_dialect::finance::certified_transaction\",\"id\":\"cert_1\",\"complete\":true,\"riskLevel\":\"low\",\"signerRequirement\":\"session\",\"intentHash\":\"sha256:intent\",\"policyHash\":\"sha256:policy\",\"stateSnapshotHash\":\"sha256:state\",\"contractProfileHash\":\"sha256:contract\",\"simulationHash\":\"sha256:sim\",\"payloadHash\":\"sha256:payload\",\"calldataHash\":\"sha256:calldata\",\"stateReadsHash\":\"sha256:reads\",\"validUntilBlock\":9000,\"maxSlippageBps\":0,\"certifiedHash\":\"sha256:cert\",\"auditTrace\":\"sha256:audit\"}"
    var financeLines: str[]
    add(financeLines, schemaFact)
    add(financeLines, certFact)
    let financeValidation = csg.CsgCoreValidateFactLines(financeLines, csg.CsgCoreModeStrict)
    if smokeExpect(financeValidation.valid, "finance certified fact should validate structurally") != 0:
        for i in 0..<financeValidation.errors.len:
            os.WriteLine(os.Get_stderr(), financeValidation.errors[i])
        return 1
    if smokeExpect(
           csg.CsgCoreProfilesEqual(
               financeValidation.profiles,
               [
                   csg.CsgCoreBaseProfileIdentity(),
                   finance.FinanceDialectProfile
               ]),
           "finance profile set should be detected") != 0:
        return 1

    var unknownFinanceLines: str[]
    add(unknownFinanceLines, schemaFact)
    add(unknownFinanceLines, "{\"kind\":\"csg_dialect::finance::unknown\",\"id\":\"bad\"}")
    let unknownFinance = csg.CsgCoreValidateFactLines(unknownFinanceLines, csg.CsgCoreModeStrict)
    if smokeExpect(!unknownFinance.valid, "unknown finance fact must fail") != 0:
        return 1

    let incompleteCertFact = "{\"kind\":\"csg_dialect::finance::certified_transaction\",\"id\":\"cert_bad\",\"complete\":false,\"riskLevel\":\"low\",\"signerRequirement\":\"session\",\"intentHash\":\"sha256:intent\",\"policyHash\":\"sha256:policy\",\"stateSnapshotHash\":\"sha256:state\",\"contractProfileHash\":\"sha256:contract\",\"simulationHash\":\"sha256:sim\",\"payloadHash\":\"sha256:payload\",\"calldataHash\":\"sha256:calldata\",\"stateReadsHash\":\"sha256:reads\",\"validUntilBlock\":9000,\"maxSlippageBps\":0,\"certifiedHash\":\"sha256:cert\",\"auditTrace\":\"sha256:audit\"}"
    var incompleteLines: str[]
    add(incompleteLines, schemaFact)
    add(incompleteLines, incompleteCertFact)
    let incompleteValidation = csg.CsgCoreValidateFactLines(incompleteLines, csg.CsgCoreModeStrict)
    if smokeExpect(!incompleteValidation.valid, "finance complete=false must fail") != 0:
        return 1

    os.WriteLine(os.Get_stdout(), "csg_finance_certified_transaction_smoke ok")
    return 0
