module cold_linkerless_composite_return

type Point =
    x: int32
    y: int32

type Rect =
    origin: Point
    size: Point

fn makePoint(x: int32, y: int32): Point =
    var p: Point
    p.x = x
    p.y = y
    return p

fn negatePoint(p: Point): Point =
    var r: Point
    r.x = 0 - p.x
    r.y = 0 - p.y
    return r

fn addPoints(a: Point, b: Point): Point =
    var r: Point
    r.x = a.x + b.x
    r.y = a.y + b.y
    return r

fn makeRect(ox: int32, oy: int32, sx: int32, sy: int32): Rect =
    var r: Rect
    r.origin = makePoint(ox, oy)
    r.size = makePoint(sx, sy)
    return r

fn test_simple(): int32 =
    let p = makePoint(3, 4)
    if p.x != 3:
        return 1
    if p.y != 4:
        return 2
    return 0

fn test_negate(): int32 =
    let p = makePoint(10, -20)
    let n = negatePoint(p)
    if n.x != -10:
        return 1
    if n.y != 20:
        return 2
    return 0

fn test_add(): int32 =
    let a = makePoint(5, 7)
    let b = makePoint(3, 2)
    let r = addPoints(a, b)
    if r.x != 8:
        return 1
    if r.y != 9:
        return 2
    return 0

fn test_rect(): int32 =
    let r = makeRect(1, 2, 100, 200)
    if r.origin.x != 1:
        return 1
    if r.origin.y != 2:
        return 2
    if r.size.x != 100:
        return 3
    if r.size.y != 200:
        return 4
    return 0

fn main(): int32 =
    let r1 = test_simple()
    if r1 != 0:
        return r1
    let r2 = test_negate()
    if r2 != 0:
        return 10 + r2
    let r3 = test_add()
    if r3 != 0:
        return 20 + r3
    let r4 = test_rect()
    if r4 != 0:
        return 30 + r4
    return 0

main()
