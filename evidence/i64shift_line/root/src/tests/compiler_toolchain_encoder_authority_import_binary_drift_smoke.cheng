import std/result
import cheng/core/tooling/compiler_toolchain_encoder_authority_import as authority_import

fn main(): int32 =
    let importRes =
        authority_import.CompilerToolchainEncoderRuntimeAuthorityImportCurrent()
    assert(IsErr(importRes),
           " encoder authority import drift smoke: foreign binary accepted")
    echo("compiler_toolchain_encoder_authority_import_mutation=rejected")
    return 0
