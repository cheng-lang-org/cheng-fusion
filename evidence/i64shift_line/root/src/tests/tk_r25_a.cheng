fn R25Tag(raw: str): str =
    if raw.len > 3:
        return "long"
    return "short"

fn R25Core(err: var str, n: int32): bool =
    var guard = 0
    defer:
        guard = guard + 1
    if n < 0:
        err = "neg"
        return false
    var e = R25Tag("abcdef")
    if n == 1:
        err = e
        return false
    return true

fn main(): int32 =
    var err = ""
    if !R25Core(err, 3):
        return 10
    echo("r25 a ok")
    return 0
