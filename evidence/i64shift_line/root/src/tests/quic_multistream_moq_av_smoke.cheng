import std/result
import std/rawbytes
import cheng/quic/connection as qconn
import cheng/quic/msquicruntime as qruntime
import cheng/quic/msquictransport_native as qtransport
import cheng/libp2p/transports/quic_transport
import cheng/libp2p/protocols/media/moq_segment_stream as moqstream
import cheng/core/runtime/web_scene_media_orchestrator as orchestrator

fn quicMoqBytesEq(left: rawbytes.Bytes, right: rawbytes.Bytes): bool =
    if BytesLen(left) != BytesLen(right):
        return false
    for i in 0..<BytesLen(left):
        if BytesGet(left, i) != BytesGet(right, i):
            return false
    return true

# Single QUIC connection, two independent QUIC streams (video=stream4, audio=stream8)
# carrying two independent MoQ segment-stream sessions. Proves true multistream
# concurrency: both client requests are placed in-flight BEFORE either is served, then
# each stream is served and drained independently with no cross-stream data mixing.
# One dial = one handshake / one cwnd; per-stream app slots = per-stream flow control,
# independent reorder, no cross-stream head-of-line blocking.
fn main(): int32 =
    var settings = qruntime.initMsQuicSettings()
    settings.allowDatagram = true

    var listener = qtransport.InitMsQuicTransport()
    assert(IsOk(qtransport.setMsQuicTransportSettings(listener, settings)),
        " quic multistream moq av: listener settings")
    assert(IsOk(quic_transport.Libp2pQuicConfigureTls(listener)),
        " quic multistream moq av: listener tls")
    let listenAddrRes = quic_transport.Libp2pQuicAddrFromHostPort("127.0.0.1", 0)
    assert(IsOk(listenAddrRes), " quic multistream moq av: listen addr")
    qtransport.start(listener, Value(listenAddrRes))

    var client = qtransport.InitMsQuicTransport()
    assert(IsOk(qtransport.setMsQuicTransportSettings(client, settings)),
        " quic multistream moq av: client settings")
    assert(IsOk(quic_transport.Libp2pQuicConfigureTls(client)),
        " quic multistream moq av: client tls")
    let dialRes = qtransport.dial(client, listener.listenAddr)
    assert(IsOk(dialRes), " quic multistream moq av: dial")
    var clientLegacy = Value(dialRes)
    let acceptRes = qtransport.accept(listener)
    assert(IsOk(acceptRes), " quic multistream moq av: accept")
    var serverLegacy = Value(acceptRes)

    # video=stream4, audio=stream8 — both ride the SAME dialed session (shared pipeIdx).
    let videoPairRes = qconn.newNativeConnectionPairForStreams(clientLegacy.localAddr,
                                                               clientLegacy.remoteAddr,
                                                               serverLegacy.localAddr,
                                                               serverLegacy.remoteAddr,
                                                               4, 4, 4, 4)
    assert(IsOk(videoPairRes), " quic multistream moq av: video pair")
    var videoClient = Value(videoPairRes).outbound
    var videoServer = Value(videoPairRes).inbound

    let audioPairRes = qconn.newNativeConnectionPairForStreams(clientLegacy.localAddr,
                                                               clientLegacy.remoteAddr,
                                                               serverLegacy.localAddr,
                                                               serverLegacy.remoteAddr,
                                                               8, 8, 8, 8)
    assert(IsOk(audioPairRes), " quic multistream moq av: audio pair")
    var audioClient = Value(audioPairRes).outbound
    var audioServer = Value(audioPairRes).inbound

    # Per-stream MoQ multistream-select handshake: the select bytes ride each stream's
    # own QUIC stream (sendStreamId/recvStreamId), so video=stream4 and audio=stream8
    # each negotiate independently — exactly what the bridge/publisher pair does. Run the
    # client send + server recv + server ack + client read-ack on each derived handle.
    assert(IsOk(moqstream.Libp2pMoqSegmentStreamClientSendNegotiate(client, videoClient)),
        " quic multistream moq av: video client negotiate send")
    assert(IsOk(moqstream.Libp2pMoqSegmentStreamServerNegotiate(listener, videoServer)),
        " quic multistream moq av: video server negotiate")
    assert(IsOk(moqstream.Libp2pMoqSegmentStreamClientReadNegotiateAck(client, videoClient)),
        " quic multistream moq av: video client negotiate ack")

    assert(IsOk(moqstream.Libp2pMoqSegmentStreamClientSendNegotiate(client, audioClient)),
        " quic multistream moq av: audio client negotiate send")
    assert(IsOk(moqstream.Libp2pMoqSegmentStreamServerNegotiate(listener, audioServer)),
        " quic multistream moq av: audio server negotiate")
    assert(IsOk(moqstream.Libp2pMoqSegmentStreamClientReadNegotiateAck(client, audioClient)),
        " quic multistream moq av: audio client negotiate ack")

    let videoAsset: rawbytes.Bytes = BytesFromString("VIDEO-stream4-payload-frame-0001-keyframe")
    let audioAsset: rawbytes.Bytes = BytesFromString("audio-stream8-adts-au-0001")
    let videoAsset2: rawbytes.Bytes = BytesFromString("VIDEO-stream4-payload-frame-0002")
    let audioAsset2: rawbytes.Bytes = BytesFromString("audio-stream8-adts-au-0002-longer-tail")

    # === Round 1: both requests in-flight before either is served (true interleave) ===
    # (1) client posts the video request on stream4
    var vReq: moqstream.Libp2pMoqSegmentStreamRequest
    vReq.streamId = "vid-asset"
    vReq.segmentKey = "moq-frame"
    vReq.offsetBytes = 0
    vReq.lengthBytes = BytesLen(videoAsset)
    vReq.readChunkBytes = 65536
    var vReader: moqstream.Libp2pMoqSegmentStreamReader
    assert(IsOk(moqstream.Libp2pMoqSegmentStreamClientOpen(vReader, videoClient, vReq)),
        " quic multistream moq av: video client open")

    # (2) client posts the audio request on stream8 — both now in-flight
    var aReq: moqstream.Libp2pMoqSegmentStreamRequest
    aReq.streamId = "aud-asset"
    aReq.segmentKey = "moq-aframe"
    aReq.offsetBytes = 0
    aReq.lengthBytes = BytesLen(audioAsset)
    aReq.readChunkBytes = 65536
    var aReader: moqstream.Libp2pMoqSegmentStreamReader
    assert(IsOk(moqstream.Libp2pMoqSegmentStreamClientOpen(aReader, audioClient, aReq)),
        " quic multistream moq av: audio client open")

    # (3) server reads + serves video on stream4
    let vSrvReqRes = moqstream.Libp2pMoqSegmentStreamServerReadRequest(videoServer)
    assert(IsOk(vSrvReqRes), " quic multistream moq av: video server read req")
    let vSrvReq = Value(vSrvReqRes)
    assert(vSrvReq.segmentKey == "moq-frame", " quic multistream moq av: video key")
    assert(IsOk(moqstream.Libp2pMoqSegmentStreamServerWriteRange(videoServer, videoAsset,
        vSrvReq.offsetBytes, vSrvReq.lengthBytes, vSrvReq.readChunkBytes)),
        " quic multistream moq av: video server write")

    # (4) server reads + serves audio on stream8
    let aSrvReqRes = moqstream.Libp2pMoqSegmentStreamServerReadRequest(audioServer)
    assert(IsOk(aSrvReqRes), " quic multistream moq av: audio server read req")
    let aSrvReq = Value(aSrvReqRes)
    assert(aSrvReq.segmentKey == "moq-aframe", " quic multistream moq av: audio key")
    assert(IsOk(moqstream.Libp2pMoqSegmentStreamServerWriteRange(audioServer, audioAsset,
        aSrvReq.offsetBytes, aSrvReq.lengthBytes, aSrvReq.readChunkBytes)),
        " quic multistream moq av: audio server write")

    # (5) client drains video — must equal videoAsset exactly (no audio bytes mixed in)
    let vGotRes = orchestrator.WebSceneMediaOrchestrateFetchAll(vReader, 65536)
    assert(IsOk(vGotRes), " quic multistream moq av: video drain")
    assert(quicMoqBytesEq(Value(vGotRes), videoAsset), " quic multistream moq av: video payload")

    # (6) client drains audio — must equal audioAsset exactly
    let aGotRes = orchestrator.WebSceneMediaOrchestrateFetchAll(aReader, 65536)
    assert(IsOk(aGotRes), " quic multistream moq av: audio drain")
    assert(quicMoqBytesEq(Value(aGotRes), audioAsset), " quic multistream moq av: audio payload")

    # === Round 2: second request on the SAME two streams proves multi-request reuse ===
    var vReq2: moqstream.Libp2pMoqSegmentStreamRequest
    vReq2.streamId = "vid-asset"
    vReq2.segmentKey = "moq-frame"
    vReq2.offsetBytes = 0
    vReq2.lengthBytes = BytesLen(videoAsset2)
    vReq2.readChunkBytes = 65536
    var vReader2: moqstream.Libp2pMoqSegmentStreamReader
    assert(IsOk(moqstream.Libp2pMoqSegmentStreamClientOpen(vReader2, videoClient, vReq2)),
        " quic multistream moq av: video client open r2")

    var aReq2: moqstream.Libp2pMoqSegmentStreamRequest
    aReq2.streamId = "aud-asset"
    aReq2.segmentKey = "moq-aframe"
    aReq2.offsetBytes = 0
    aReq2.lengthBytes = BytesLen(audioAsset2)
    aReq2.readChunkBytes = 65536
    var aReader2: moqstream.Libp2pMoqSegmentStreamReader
    assert(IsOk(moqstream.Libp2pMoqSegmentStreamClientOpen(aReader2, audioClient, aReq2)),
        " quic multistream moq av: audio client open r2")

    # Serve audio first this round (reversed order) to prove stream independence ordering.
    let aSrvReqRes2 = moqstream.Libp2pMoqSegmentStreamServerReadRequest(audioServer)
    assert(IsOk(aSrvReqRes2), " quic multistream moq av: audio server read req r2")
    let aSrvReq2 = Value(aSrvReqRes2)
    assert(IsOk(moqstream.Libp2pMoqSegmentStreamServerWriteRange(audioServer, audioAsset2,
        aSrvReq2.offsetBytes, aSrvReq2.lengthBytes, aSrvReq2.readChunkBytes)),
        " quic multistream moq av: audio server write r2")

    let vSrvReqRes2 = moqstream.Libp2pMoqSegmentStreamServerReadRequest(videoServer)
    assert(IsOk(vSrvReqRes2), " quic multistream moq av: video server read req r2")
    let vSrvReq2 = Value(vSrvReqRes2)
    assert(IsOk(moqstream.Libp2pMoqSegmentStreamServerWriteRange(videoServer, videoAsset2,
        vSrvReq2.offsetBytes, vSrvReq2.lengthBytes, vSrvReq2.readChunkBytes)),
        " quic multistream moq av: video server write r2")

    let vGotRes2 = orchestrator.WebSceneMediaOrchestrateFetchAll(vReader2, 65536)
    assert(IsOk(vGotRes2), " quic multistream moq av: video drain r2")
    assert(quicMoqBytesEq(Value(vGotRes2), videoAsset2), " quic multistream moq av: video payload r2")

    let aGotRes2 = orchestrator.WebSceneMediaOrchestrateFetchAll(aReader2, 65536)
    assert(IsOk(aGotRes2), " quic multistream moq av: audio drain r2")
    assert(quicMoqBytesEq(Value(aGotRes2), audioAsset2), " quic multistream moq av: audio payload r2")

    # Teardown: per-stream handles share pipeIdx — never close them individually.
    # Close only the dialed legacy connections once, then stop the listener.
    qconn.ConnClose(serverLegacy)
    qconn.ConnClose(clientLegacy)
    qtransport.Stop(listener)
    echo(" quic_multistream_moq_av_smoke ok")
    return 0
