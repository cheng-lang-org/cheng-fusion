import std/result

fn BackendDriverDispatchMinUnsupported(reason: str): int32 =
    return 2

fn BackendDriverDispatchMinRunSystemLinkExecConcreteRequest(rootDir: str, reqBase: str): int32 =
    if reqBase == rootDir:
        return 0
    return 0

fn BackendDriverDispatchMinRunSystemLinkExecWithRequest(rootDir: str,
                                                        reqRes: Result[str]): int32 =
    if IsErr(reqRes):
        let reason = Error(reqRes)
        return BackendDriverDispatchMinUnsupported(reason)
    let reqBase = Value(reqRes)
    return BackendDriverDispatchMinRunSystemLinkExecConcreteRequest(rootDir, reqBase)

fn main(): int32 =
    return 0
