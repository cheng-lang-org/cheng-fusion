import std/cmdline as cmdline
import std/seqs as seqs
import std/system

type ProbeCell =
    value: int64

fn main(argc: int32, argv: str*): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    let a0 = system.memAllocCount()
    let f0 = system.memFreeCount()
    let l0 = system.memLiveCount()
    let rt0 = system.memRetainCount()
    let rl0 = system.memReleaseCount()
    echo(Fmt"baseline alloc={a0} free={f0} live={l0} retain={rt0} release={rl0}")
    var scratch: int64[]
    seqs.reserve(scratch, 8)
    add(scratch, int64(7))
    let a1 = system.memAllocCount()
    echo(Fmt"after_seq_reserve alloc_delta={a1 - a0}")
    seqs.freeSeq(scratch)
    echo(Fmt"after_seq_free alloc_delta={system.memAllocCount() - a0} free_delta={system.memFreeCount() - f0}")
    let cell = new(ProbeCell)
    if cell == nil:
        echo(Fmt"new_returned_nil")
        return 2
    cell.value = int64(3)
    echo(Fmt"after_new alloc_delta={system.memAllocCount() - a0} refcount={memRefCount(cell)}")
    memRetain(cell)
    echo(Fmt"after_retain refcount={memRefCount(cell)} retain_delta={system.memRetainCount() - rt0}")
    return 0
