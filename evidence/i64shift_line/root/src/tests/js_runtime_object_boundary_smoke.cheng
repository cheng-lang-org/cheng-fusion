import cheng/core/runtime/js_runtime as jsrt

fn main(): int32 =
    var answer: jsrt.JsValue
    jsrt.JsValueInitInt32(answer, 42)

    var descriptor: jsrt.JsPropertyDescriptor
    jsrt.JsDescriptorInitData(descriptor, true, true, true)
    var object: jsrt.JsObject
    if !jsrt.JsObjectCreateFresh(object, 0):
        echo("FAIL create object")
        return 1
    if !jsrt.JsObjectDefineDataPropertyById(object.objectId, "answer", answer, descriptor):
        echo("FAIL define property")
        return 2

    var loaded: jsrt.JsObject
    if !jsrt.JsObjectGetById(object.objectId, loaded):
        echo("FAIL load object")
        return 3
    var got: jsrt.JsValue
    if !jsrt.JsObjectGetStringProperty(loaded, "answer", got):
        echo("FAIL read property")
        return 4
    if !jsrt.JsValueIsInt32(got) || jsrt.JsValueInt32(got) != 42:
        echo("FAIL property value")
        return 5

    echo(" js_runtime_object_boundary_assertions=create/define/get")
    echo(" js_runtime_object_boundary_smoke ok")
    return 0
