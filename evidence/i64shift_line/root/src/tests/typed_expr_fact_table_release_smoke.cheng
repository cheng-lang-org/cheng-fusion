import cheng/core/lang/typed_expr as texpr

@importc("cheng_mm_free_count")
fn factReleaseFreeCount(): int64

@importc("cheng_mm_foreign_free_count")
fn factReleaseForeignFreeCount(): int64

fn main(): int32 =
    let freeBefore = factReleaseFreeCount()
    let foreignBefore = factReleaseForeignFreeCount()
    var table: texpr.TypedExprFactTable
    var fact: texpr.TypedExprFact
    fact.exprId = "release.expr"
    fact.sourcePath = "src/tests/typed_expr_fact_table_release_smoke.cheng"
    fact.callCallee = "callee"
    fact.typeText = "int32"
    fact.lineNumber = 7
    fact.columnNumber = 11
    fact.endLineNumber = 7
    fact.endColumnNumber = 29
    texpr.TypedExprFactTableAppendHandBuilt(table, fact)
    let appendedFact = texpr.TypedExprFactAt(table, 0)
    if appendedFact.lineNumber != 7 || appendedFact.columnNumber != 11 ||
       appendedFact.endLineNumber != 7 || appendedFact.endColumnNumber != 29:
        return 6
    var clone = texpr.TypedExprFactTableClone(table)
    let clonedBeforeReset = texpr.TypedExprFactAt(clone, 0)
    if clonedBeforeReset.endLineNumber != 7 ||
       clonedBeforeReset.endColumnNumber != 29:
        return 7
    texpr.TypedExprFactTableReset(table)
    if texpr.TypedExprFactTableCount(table) != 0:
        return 4
    fact.exprId = "reset.expr"
    fact.callCallee = "resetCallee"
    fact.lineNumber = 12
    fact.columnNumber = 4
    fact.endLineNumber = 12
    fact.endColumnNumber = 37
    texpr.TypedExprFactTableAppendHandBuilt(table, fact)
    let resetFact = texpr.TypedExprFactAt(table, 0)
    if resetFact.exprId != "reset.expr" ||
       resetFact.callCallee != "resetCallee" ||
       resetFact.lineNumber != 12 || resetFact.columnNumber != 4 ||
       resetFact.endLineNumber != 12 || resetFact.endColumnNumber != 37:
        return 5
    fact.exprId = "set.expr"
    fact.callCallee = "setCallee"
    fact.lineNumber = 21
    fact.columnNumber = 5
    fact.endLineNumber = 21
    fact.endColumnNumber = 44
    fact.surfaceCallKind = texpr.TypedExprSurfaceCallMember
    fact.callReason = texpr.TypedExprCallReasonAmbiguousQualifiedTarget
    fact.abiClass = texpr.TypedExprAbiComposite
    fact.valueKind = texpr.TypedExprValuePointerLike
    fact.placeKind = texpr.TypedExprPlaceField
    fact.sinkPlaceKind = texpr.TypedExprPlaceCallResult
    fact.loweringMode = texpr.TypedExprLowerSret
    fact.callKind = texpr.TypedExprCallProjection
    fact.typeCallKind = texpr.TypedExprTypeCallConstructor
    fact.returnKind = texpr.TypedExprReturnImportBuffer
    fact.callResolved = true
    fact.callTargetImportc = true
    fact.callPrefixStyle = true
    fact.hasSink = true
    fact.returnRoot = true
    texpr.TypedExprFactTableSet(table, 0, fact)
    let setFact = texpr.TypedExprFactAt(table, 0)
    if setFact.exprId != "set.expr" || setFact.callCallee != "setCallee" ||
       setFact.lineNumber != 21 || setFact.columnNumber != 5 ||
       setFact.endLineNumber != 21 || setFact.endColumnNumber != 44 ||
       setFact.surfaceCallKind != texpr.TypedExprSurfaceCallMember ||
       setFact.callReason != texpr.TypedExprCallReasonAmbiguousQualifiedTarget ||
       setFact.abiClass != texpr.TypedExprAbiComposite ||
       setFact.valueKind != texpr.TypedExprValuePointerLike ||
       setFact.placeKind != texpr.TypedExprPlaceField ||
       setFact.sinkPlaceKind != texpr.TypedExprPlaceCallResult ||
       setFact.loweringMode != texpr.TypedExprLowerSret ||
       setFact.callKind != texpr.TypedExprCallProjection ||
       setFact.typeCallKind != texpr.TypedExprTypeCallConstructor ||
       setFact.returnKind != texpr.TypedExprReturnImportBuffer ||
       !setFact.callResolved || !setFact.callTargetImportc ||
       !setFact.callPrefixStyle || !setFact.hasSink || !setFact.returnRoot ||
       texpr.TypedExprFactEndLineNumber(table, 0) != 21 ||
       texpr.TypedExprFactEndColumnNumber(table, 0) != 44:
        return 8
    texpr.TypedExprFactTableRelease(table)
    let clonedFact = texpr.TypedExprFactAt(clone, 0)
    if clonedFact.exprId == "release.expr":
        if clonedFact.callCallee == "callee" &&
           clonedFact.lineNumber == 7 && clonedFact.columnNumber == 11 &&
           clonedFact.endLineNumber == 7 && clonedFact.endColumnNumber == 29:
            texpr.TypedExprFactTableRelease(clone)
            let released = (factReleaseFreeCount() - freeBefore) +
                           (factReleaseForeignFreeCount() - foreignBefore)
            if released > int64(0):
                return 0
            return 3
        return 2
    return 1
