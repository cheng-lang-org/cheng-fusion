module cold_linkerless_match_expr

type Color = enum Red, Green, Blue

fn colorScore(c: Color): int32 =
    match c:
        Red => return 10
        Green => return 20
        Blue => return 30

fn test_red(): int32 =
    let c: Color = Color.Red
    let s = colorScore(c)
    if s != 10:
        return 1
    return 0

fn test_green(): int32 =
    let c: Color = Color.Green
    let s = colorScore(c)
    if s != 20:
        return 1
    return 0

fn test_blue(): int32 =
    let c: Color = Color.Blue
    let s = colorScore(c)
    if s != 30:
        return 1
    return 0

fn main(): int32 =
    let r1 = test_red()
    if r1 != 0:
        return r1
    let r2 = test_green()
    if r2 != 0:
        return 10 + r2
    let r3 = test_blue()
    if r3 != 0:
        return 20 + r3
    return 0

main()
