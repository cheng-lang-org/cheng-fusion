type
    ColdRefObjectBorrowStringElementRemovedOuter = ref object
        text: str

fn ColdRefObjectBorrowStringElementRemovedWrite(
        text: var str) =
    text = "changed"

fn ColdRefObjectBorrowStringElementRemovedMutate(
        out: var ColdRefObjectBorrowStringElementRemovedOuter) =
    var text = out.text
    let forbiddenCharacter = 'a'
    ColdRefObjectBorrowStringElementRemovedWrite(text)
    if forbiddenCharacter == 'x':
        return

fn main(): int32 =
    var out = new(ColdRefObjectBorrowStringElementRemovedOuter)
    out.text = "initial"
    ColdRefObjectBorrowStringElementRemovedMutate(out)
    return 0
