import std/system
import std/os
import std/strutils as strutil
import std/rawbytes
import std/result
import cheng/std/crypto/chacha20poly1305 as aead

@importc("cheng_monotime_ns")
fn chachaBenchMonoNs(): int64

fn chachaBenchEnvInt(name: str, defaultValue: int32): int32 =
    let raw: str = os.GetEnvDefault(name, "")
    if len(raw) <= 0:
        return defaultValue
    let parsed: int32 = int32(strutil.ParseInt(raw))
    if parsed <= 0:
        return defaultValue
    return parsed

# Seal a 1200-byte QUIC-sized packet N times, report ns per packet and MB/s, to confirm
# whether per-packet AEAD is the throughput ceiling (loopback measured ~7.4ms/packet).
fn main(): int32 =
    let iters: int32 = chachaBenchEnvInt("CHENG_CHACHA_BENCH_ITERS", 1000)
    let pktLen: int32 = chachaBenchEnvInt("CHENG_CHACHA_BENCH_PKTLEN", 1200)
    var keyBytes: Bytes = BytesAlloc(32)
    var nonceBytes: Bytes = BytesAlloc(12)
    var aad: Bytes = BytesAlloc(16)
    for i in 0..<32:
        BytesSet(keyBytes, i, (i * 7 + 1) % 256)
    for i in 0..<12:
        BytesSet(nonceBytes, i, (i * 5 + 3) % 256)
    for i in 0..<16:
        BytesSet(aad, i, (i * 3 + 2) % 256)
    let keyRes: Result[aead.ChaChaPolyKey] = aead.intoChaChaPolyKey(keyBytes)
    assert(IsOk(keyRes), " chacha bench: key")
    let key: aead.ChaChaPolyKey = Value(keyRes)
    let nonceRes: Result[aead.ChaChaPolyNonce] = aead.intoChaChaPolyNonce(nonceBytes)
    assert(IsOk(nonceRes), " chacha bench: nonce")
    let nonce: aead.ChaChaPolyNonce = Value(nonceRes)

    var sink: int32
    let startNs: int64 = chachaBenchMonoNs()
    for it in 0..<iters:
        var data: Bytes = BytesAlloc(pktLen)
        BytesSet(data, it % pktLen, it % 256)
        var tag: aead.ChaChaPolyTag
        let encRes: Result[bool] = aead.encrypt(key, nonce, tag, data, aad)
        assert(IsOk(encRes), " chacha bench: encrypt")
        sink = sink + BytesGet(data, 0)
    let elapsedNs: int64 = chachaBenchMonoNs() - startNs
    let nsPerPkt: int64 = elapsedNs / int64(iters)
    let totalBytes: int64 = int64(iters) * int64(pktLen)
    var mbPerSec: int64
    if elapsedNs > 0:
        mbPerSec = totalBytes * int64(1000) / elapsedNs  # bytes/us ~= MB/s
    echo(strutil.Join(["chacha_aead_seal pkt_len=", IntToStr(pktLen),
                       " iters=", IntToStr(iters),
                       " ns_per_pkt=", int64ToStr(nsPerPkt),
                       " MB_per_s=", int64ToStr(mbPerSec),
                       " sink=", IntToStr(sink)], ""))
    echo(" chacha_aead_bench ok")
    return 0
