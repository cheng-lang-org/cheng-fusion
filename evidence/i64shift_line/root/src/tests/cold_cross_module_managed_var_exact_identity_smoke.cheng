import cheng/tests/cold_cross_module_managed_var_exact_support
import cheng/tests/cold_cross_module_managed_var_exact_worker

fn main(): int32 =
    var records: cold_cross_module_managed_var_exact_support.CrossModuleManagedVarRecord[]
    var first: cold_cross_module_managed_var_exact_support.CrossModuleManagedVarRecord
    first.value = 41
    add(records, first)
    var copied: cold_cross_module_managed_var_exact_support.CrossModuleManagedVarRecord[]
    if cold_cross_module_managed_var_exact_worker.CopyCrossModuleManagedVarRecords(
           records, copied) != 1:
        return 1
    if copied[0].value != 41:
        return 2
    echo("cold_cross_module_managed_var_exact_identity_smoke ok")
    return 0
