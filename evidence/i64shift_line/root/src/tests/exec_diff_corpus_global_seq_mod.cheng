# Helper module for cross_module_global_seq_aggregate_elem_byval fixture.
#
# Declares a MODULE-GLOBAL dynamic seq of a LARGE aggregate AND the function that
# reads `g[i]` BY VALUE (passing it to a non-var aggregate parameter) — both in
# THIS module. When the fixture in src/tests/exec_diff_corpus/ imports this module,
# the multi-source compile registers `modRecs` under THIS module's source-path,
# which normalizes differently from the importing main's source-path. That is the
# exact `loweringParallelResults[i]` family-A locus: a same-module unqualified
# global seq element copied by value where the global's registration path and the
# accessing function's runtime sourcePath fail PrimaryPathNormalizedEquals.
type
    ModRec =
        a: int32
        b: int32
        c: int32
        d: int32
        e: int32
        f: int32
        g: int32
        h: int32
        i: int32
        j: int32

var
    modRecs: ModRec[]

fn ModMakeRec(base: int32): ModRec =
    var r: ModRec
    r.a = base + 0
    r.b = base + 1
    r.c = base + 2
    r.d = base + 3
    r.e = base + 4
    r.f = base + 5
    r.g = base + 6
    r.h = base + 7
    r.i = base + 8
    r.j = base + 9
    return r

# non-var aggregate parameter: receives the element BY VALUE (the family-A ABI
# form). Reads high-offset fields to catch a truncated element copy.
fn ModSumRec(r: ModRec): int32 =
    return r.a + r.b + r.c + r.d + r.e + r.f + r.g + r.h + r.i + r.j

fn ModInit() =
    modRecs = []
    add(modRecs, ModMakeRec(100))
    add(modRecs, ModMakeRec(200))
    add(modRecs, ModMakeRec(300))

# Same-module unqualified access of the module-global seq element BY VALUE.
# `modRecs[idx]` is exactly `loweringParallelResults[i]`: a runtime index, a
# module-global PrimaryObjectIrFunction[]-shaped aggregate seq, copied by value to
# a non-var aggregate parameter. Returns the field sum so miscompiles surface as a
# wrong exit code.
fn ModSumAt(idx: int32): int32 =
    return ModSumRec(modRecs[idx])
