import std/strformat
import cheng/core/tooling/backend_driver_main as driver_main
import cheng/core/tooling/backend_driver_dispatch_min as dispatch_min

fn main(): int32 =
    var mainRss: driver_main.BackendDriverFullRssMemoryModel
    var dispatchRss: dispatch_min.BackendDriverDispatchMinFullRssMemoryModel
    var reason: str
    assert(driver_main.BackendDriverFullRssMemoryModelTryBuild(
               int64(1), int64(1), int64(1), int64(1), int64(1),
               int64(100), int64(1), int64(0), int64(0), int64(1),
               int64(1), int64(1), int64(1073741824),
               mainRss, reason),
           Fmt"main RSS fixture failed reason={reason}")
    assert(dispatch_min.BackendDriverDispatchMinFullRssMemoryModelTryBuild(
               int64(1), int64(1), int64(1), int64(1), int64(1),
               int64(100), int64(1), int64(0), int64(0), int64(1),
               int64(1), int64(1), int64(1073741824),
               dispatchRss, reason),
           Fmt"dispatch RSS fixture failed reason={reason}")
    let tightLimit = mainRss.modeledGuardEstimateBytes
    assert(tightLimit == dispatchRss.modeledGuardEstimateBytes,
           "main and dispatch guard estimates must match")

    var mainTight: driver_main.BackendDriverFullRssParallelMemoryModel
    var dispatchTight: dispatch_min.BackendDriverDispatchMinFullRssParallelMemoryModel
    assert(driver_main.BackendDriverFullRssParallelMemoryModelTryBuild(
               mainRss, int64(8), int64(8), tightLimit, mainTight, reason),
           Fmt"main tight parallel model failed reason={reason}")
    assert(dispatch_min.BackendDriverDispatchMinFullRssParallelMemoryModelTryBuild(
               dispatchRss, int64(8), int64(8), tightLimit,
               dispatchTight, reason),
           Fmt"dispatch tight parallel model failed reason={reason}")
    assert(mainTight.guardScaleNumerator == int64(3) &&
           mainTight.guardScaleDenominator == int64(1),
           "parallel guard scale must be exact 3/1")
    assert(mainTight.sourcePerWorkerBytes == int64(0) &&
           mainTight.csgPerWorkerBytes == int64(0) &&
           mainTight.typedIrPerWorkerBytes == int64(0) &&
           mainTight.providerPerWorkerBytes == int64(0) &&
           mainTight.linkPerWorkerBytes == int64(0) &&
           mainTight.reportPerWorkerBytes == int64(0),
           "serial phases must have zero per-worker bytes")
    assert(mainTight.loweringPerWorkerBytes == int64(300),
           "lowering per-worker bytes must equal three times its increment")
    assert(mainTight.loweringFixedBytes +
           mainTight.loweringPerWorkerBytes == tightLimit,
           "tight limit must admit exactly one lowering worker")
    assert(mainTight.memoryLimitedMaxJobs == int64(1) &&
           mainTight.effectiveJobs == int64(1),
           "tight limit must cap eight requested jobs at one")
    assert(mainTight.sourceFixedBytes == dispatchTight.sourceFixedBytes &&
           mainTight.csgFixedBytes == dispatchTight.csgFixedBytes &&
           mainTight.typedIrFixedBytes == dispatchTight.typedIrFixedBytes &&
           mainTight.loweringFixedBytes == dispatchTight.loweringFixedBytes &&
           mainTight.loweringPerWorkerBytes ==
               dispatchTight.loweringPerWorkerBytes &&
           mainTight.primaryFixedBytes == dispatchTight.primaryFixedBytes &&
           mainTight.primaryPerWorkerBytes ==
               dispatchTight.primaryPerWorkerBytes &&
           mainTight.providerFixedBytes == dispatchTight.providerFixedBytes &&
           mainTight.linkFixedBytes == dispatchTight.linkFixedBytes &&
           mainTight.reportFixedBytes == dispatchTight.reportFixedBytes &&
           mainTight.memoryLimitedMaxJobs ==
               dispatchTight.memoryLimitedMaxJobs &&
           mainTight.effectiveJobs == dispatchTight.effectiveJobs,
           "main and dispatch parallel models must match")

    var rejectedMain: driver_main.BackendDriverFullRssParallelMemoryModel
    var rejectedDispatch: dispatch_min.BackendDriverDispatchMinFullRssParallelMemoryModel
    assert(!driver_main.BackendDriverFullRssParallelMemoryModelTryBuild(
               mainRss, int64(8), int64(8), tightLimit - int64(1),
               rejectedMain, reason) &&
           reason ==
               "rss_parallel_lowering_one_worker_exceeds_memory_limit",
           "main must reject one-byte lowering underflow")
    assert(!dispatch_min.BackendDriverDispatchMinFullRssParallelMemoryModelTryBuild(
               dispatchRss, int64(8), int64(8), tightLimit - int64(1),
               rejectedDispatch, reason) &&
           reason ==
               "rss_parallel_lowering_one_worker_exceeds_memory_limit",
           "dispatch must reject one-byte lowering underflow")

    var zeroMainRss: driver_main.BackendDriverFullRssMemoryModel
    var zeroDispatchRss: dispatch_min.BackendDriverDispatchMinFullRssMemoryModel
    assert(driver_main.BackendDriverFullRssMemoryModelTryBuild(
               int64(1), int64(0), int64(0), int64(0), int64(1),
               int64(0), int64(0), int64(0), int64(0), int64(0),
               int64(0), int64(0), int64(0), zeroMainRss, reason),
           Fmt"main zero-increment RSS fixture failed reason={reason}")
    assert(dispatch_min.BackendDriverDispatchMinFullRssMemoryModelTryBuild(
               int64(1), int64(0), int64(0), int64(0), int64(1),
               int64(0), int64(0), int64(0), int64(0), int64(0),
               int64(0), int64(0), int64(0), zeroDispatchRss, reason),
           Fmt"dispatch zero-increment RSS fixture failed reason={reason}")
    var zeroMainParallel: driver_main.BackendDriverFullRssParallelMemoryModel
    var zeroDispatchParallel: dispatch_min.BackendDriverDispatchMinFullRssParallelMemoryModel
    assert(!driver_main.BackendDriverFullRssParallelMemoryModelTryBuild(
               zeroMainRss, int64(8), int64(8),
               zeroMainRss.modeledGuardEstimateBytes - int64(1),
               zeroMainParallel, reason) &&
           reason == "rss_parallel_serial_floor_exceeds_memory_limit",
           "main must reject a zero-increment phase above the memory limit")
    assert(!dispatch_min.BackendDriverDispatchMinFullRssParallelMemoryModelTryBuild(
               zeroDispatchRss, int64(8), int64(8),
               zeroDispatchRss.modeledGuardEstimateBytes - int64(1),
               zeroDispatchParallel, reason) &&
           reason == "rss_parallel_serial_floor_exceeds_memory_limit",
           "dispatch must reject a zero-increment phase above the memory limit")

    let eightWorkerLimit =
        tightLimit + mainTight.loweringPerWorkerBytes * int64(7)
    var mainExpanded: driver_main.BackendDriverFullRssParallelMemoryModel
    var dispatchExpanded: dispatch_min.BackendDriverDispatchMinFullRssParallelMemoryModel
    assert(driver_main.BackendDriverFullRssParallelMemoryModelTryBuild(
               mainRss, int64(16), int64(8), eightWorkerLimit,
               mainExpanded, reason),
           Fmt"main expanded parallel model failed reason={reason}")
    assert(dispatch_min.BackendDriverDispatchMinFullRssParallelMemoryModelTryBuild(
               dispatchRss, int64(16), int64(8), eightWorkerLimit,
               dispatchExpanded, reason),
           Fmt"dispatch expanded parallel model failed reason={reason}")
    assert(mainExpanded.memoryLimitedMaxJobs == int64(8) &&
           mainExpanded.effectiveJobs == int64(8) &&
           dispatchExpanded.memoryLimitedMaxJobs == int64(8) &&
           dispatchExpanded.effectiveJobs == int64(8),
           "expanded limit must cap by hardware without a jobs sweep")
    return 0
