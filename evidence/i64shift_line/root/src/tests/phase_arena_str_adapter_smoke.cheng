import std/system
import std/os as os
import cheng/core/ir/phase_arena as phase

# Positive contract for the temporary-text adapter:
#   - text bytes live in the fixed payload; empty text is the canonical
#     invalid PhaseArenaRef;
#   - decimal int64 text is formatted straight into payload bytes;
#   - exact survivors leave once (StrCopyOutOwned to a managed owner, or
#     PhaseArenaStoreRehome to a second arena) and survive the batch reset;
#   - batch reset reclaims every row at once and the second batch reuses the
#     exact same byte window.
fn main(): int32 =
    let allocBefore = system.memAllocCount()
    let freeBefore = system.memFreeCount()
    let liveBefore = system.memLiveCount()

    var store: phase.PhaseArenaStore
    phase.PhaseArenaStoreInit(store, 2, 160, 8)
    var scratch = phase.PhaseArenaStoreOpenArena(store, 1, 96, 6)
    var keep = phase.PhaseArenaStoreOpenArena(store, 2, 64, 2)

    let hello = phase.PhaseArenaStoreStrPut(store, scratch, "hello")
    assert(phase.PhaseArenaStoreStrEqual(store, scratch, hello, "hello"),
           "str adapter smoke: put/equal")
    assert(!phase.PhaseArenaStoreStrEqual(store, scratch, hello, "hell") &&
           !phase.PhaseArenaStoreStrEqual(store, scratch, hello, "hello!"),
           "str adapter smoke: equal length discipline")

    let emptyText = phase.PhaseArenaStoreStrPut(store, scratch, "")
    assert(!phase.PhaseArenaRefIsValid(emptyText),
           "str adapter smoke: empty text is the canonical invalid row")
    assert(phase.PhaseArenaStoreStrEqual(store, scratch, emptyText, ""),
           "str adapter smoke: invalid row reads as empty text")

    let zero = phase.PhaseArenaStoreStrPutInt64(store, scratch, int64(0))
    let seven = phase.PhaseArenaStoreStrPutInt64(store, scratch, int64(7))
    let neg = phase.PhaseArenaStoreStrPutInt64(store, scratch, int64(-42))
    let maxValue = phase.PhaseArenaStoreStrPutInt64(store, scratch,
                                                    int64(9223372036854775807))
    var minValue = phase.PhaseArenaStoreStrPutInt64(
        store, scratch, int64(-9223372036854775807) - int64(1))
    assert(phase.PhaseArenaStoreStrEqual(store, scratch, zero, "0") &&
           phase.PhaseArenaStoreStrEqual(store, scratch, seven, "7") &&
           phase.PhaseArenaStoreStrEqual(store, scratch, neg, "-42") &&
           phase.PhaseArenaStoreStrEqual(store, scratch, maxValue,
                                         "9223372036854775807") &&
           phase.PhaseArenaStoreStrEqual(store, scratch, minValue,
                                         "-9223372036854775808"),
           "str adapter smoke: int64 decimal text")

    let pre = phase.PhaseArenaStoreArenaReport(store, scratch)
    assert(pre.allocationCount == 6 && pre.liveAllocationCount == 6 &&
           pre.usedBytes == 49 && pre.liveBytes == 49 &&
           pre.peakBytes == 49 && pre.resetCount == 0 &&
           pre.spillCount == 0 &&
           pre.retainedStoreBytes == phase.PhaseArenaStoreRetainedBytes(store),
           "str adapter smoke: pre-transfer ledger")

    var ownedSurvivor = phase.PhaseArenaStoreStrCopyOutOwned(store, scratch,
                                                             hello)
    assert(ownedSurvivor == "hello",
           "str adapter smoke: owned survivor content")

    let rehomed = phase.PhaseArenaStoreRehome(store, scratch, minValue, keep)
    assert(!phase.PhaseArenaRefIsValid(minValue),
           "str adapter smoke: rehome invalidates the source row")
    assert(phase.PhaseArenaStoreStrEqual(store, keep, rehomed,
                                         "-9223372036854775808"),
           "str adapter smoke: rehomed survivor content")
    let mid = phase.PhaseArenaStoreArenaReport(store, scratch)
    assert(mid.liveAllocationCount == 5 && mid.liveBytes == 29 &&
           mid.survivorCount == 1 && mid.survivorBytes == 20,
           "str adapter smoke: rehome ledger")

    phase.PhaseArenaStoreResetArena(store, scratch)
    assert(ownedSurvivor == "hello",
           "str adapter smoke: owned survivor outlives the batch reset")
    let post = phase.PhaseArenaStoreArenaReport(store, scratch)
    assert(post.generation == 2 && post.usedBytes == 0 &&
           post.liveAllocationCount == 0 && post.liveBytes == 0 &&
           post.survivorCount == 0 && post.resetCount == 1 &&
           post.peakBytes == 49,
           "str adapter smoke: reset ledger")

    let helloAgain = phase.PhaseArenaStoreStrPut(store, scratch, "hello")
    let zeroAgain = phase.PhaseArenaStoreStrPutInt64(store, scratch, int64(0))
    let second = phase.PhaseArenaStoreArenaReport(store, scratch)
    assert(second.usedBytes == 6 && second.allocationCount == 2 &&
           second.generation == 2 &&
           phase.PhaseArenaStoreStrEqual(store, scratch, helloAgain,
                                         "hello") &&
           phase.PhaseArenaStoreStrEqual(store, scratch, zeroAgain, "0"),
           "str adapter smoke: second batch reuses the byte window")

    let utf = phase.PhaseArenaStoreStrPut(store, scratch, "héllo")
    assert(phase.PhaseArenaStoreStrEqual(store, scratch, utf, "héllo"),
           "str adapter smoke: utf-8 byte round trip")
    var utfOwned = phase.PhaseArenaStoreStrCopyOutOwned(store, scratch, utf)
    assert(utfOwned == "héllo",
           "str adapter smoke: utf-8 owned survivor")
    let third = phase.PhaseArenaStoreArenaReport(store, scratch)
    assert(third.usedBytes == 12 && third.allocationCount == 3,
           "str adapter smoke: utf-8 ledger")

    phase.PhaseArenaStoreCloseArena(store, scratch)
    phase.PhaseArenaStoreCloseArena(store, keep)
    phase.PhaseArenaStoreDestroy(store)

    os.ReleaseStr(ownedSurvivor)
    os.ReleaseStr(utfOwned)

    let allocDelta = system.memAllocCount() - allocBefore
    let freeDelta = system.memFreeCount() - freeBefore
    let liveDelta = system.memLiveCount() - liveBefore
    assert(allocDelta == freeDelta,
           "str adapter smoke: ORC alloc/free imbalance")
    assert(liveDelta == 0,
           "str adapter smoke: ORC live allocation leak")
    echo(Fmt"phase_arena_str_orc_alloc_delta={allocDelta}")
    echo(Fmt"phase_arena_str_orc_free_delta={freeDelta}")
    echo(Fmt"phase_arena_str_orc_live_delta={liveDelta}")
    echo("PHASE_ARENA_STR_ADAPTER_OK")
    return 0
