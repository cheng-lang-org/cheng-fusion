import std/system
import core/runtime/web_raster_runtime as raster
import core/runtime/web_paint_runtime as paint

fn runDrawImageMin(): int32 =
    var surface: raster.RasterSurface
    raster.RasterSurfaceInit(surface)
    if !raster.RasterResize(surface, 3, 3, 9):
        return 88
    # imageCache 像素语义 = ARGB 打包(alpha 高 8 位), alpha=0 透明像素跳过
    let opaque11 = (255 << 24) | 11
    let opaque22 = (255 << 24) | 22
    let opaque33 = (255 << 24) | 33
    let opaque44 = (255 << 24) | 44
    var pixels: int32[]
    add(pixels, opaque11)
    add(pixels, opaque22)
    add(pixels, opaque33)
    add(pixels, opaque44)
    if !raster.RasterImageCacheRegister(surface.imageCache, 7, 2, 2, pixels):
        return 89
    var ops: paint.PaintOp[]
    add(ops, paint.PaintOpMakeDrawImage(0, 0, 2, 2, 7, 2, 2))
    if !raster.RasterPaintOps(surface, ops):
        return 90
    if raster.RasterPixelAt(surface, 0, 0) != opaque11:
        return 91
    if raster.RasterPixelAt(surface, 1, 0) != opaque22:
        return 92
    if raster.RasterPixelAt(surface, 0, 1) != opaque33:
        return 93
    if raster.RasterPixelAt(surface, 1, 1) != opaque44:
        return 94
    if raster.RasterPixelAt(surface, 2, 2) != 9:
        return 95
    return 0

fn main(): int32 =
    return runDrawImageMin()
