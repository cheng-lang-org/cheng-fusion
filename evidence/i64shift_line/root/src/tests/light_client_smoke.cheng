# light_client smoke: full-stake 4-member committee, LiteHeaderMake binding
# digest, LiteConfirm Ok at f=1 with all votes, tampered appHash rejected,
# 2-of-4 votes rejected at f=1 (2f+1=3).

import std/os
import std/system
import std/rawbytes
import cheng/std/bytes_layout as layout
import cheng/chain/committee_vote as cvt
import cheng/chain/light_client as lc

fn CidTag(b: int32): layout.FixedBytes32 =
    var raw = BytesAlloc(32)
    BytesSet(raw, 0, b)
    let res = layout.FixedBytes32FromBytes(raw)
    return res.value

# tamper probe: copy the 32-byte hash and bump its first byte by one
fn AppHashBumpFirst(src: layout.FixedBytes32): layout.FixedBytes32 =
    let srcB = layout.FixedBytes32ToBytes(src)
    var out = BytesAlloc(32)
    var i: int32 = 0
    while i < 32:
        BytesSet(out, i, BytesGet(srcB, i))
        i = i + 1
    BytesSet(out, 0, BytesGet(srcB, 0) + 1)
    let res = layout.FixedBytes32FromBytes(out)
    return res.value

fn main(): int32 =
    var rc: int32 = 0
    let epoch: int32 = 21
    let round: int32 = 5

    let sk0 = BytesFromHex("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
    let sk1 = BytesFromHex("4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb")
    let sk2 = BytesFromHex("c5aa8df43f9f837bedb7442f31dcb7b166d38535076f094b85ce3a2e0b4458f7")
    let sk3 = BytesFromHex("3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c")

    var m0res = cvt.CommitteeDraw(sk0, 100, 100, epoch, round)
    var m1res = cvt.CommitteeDraw(sk1, 100, 100, epoch, round)
    var m2res = cvt.CommitteeDraw(sk2, 100, 100, epoch, round)
    var m3res = cvt.CommitteeDraw(sk3, 100, 100, epoch, round)
    if !m0res.ok or !m1res.ok or !m2res.ok or !m3res.ok:
        os.WriteLine(os.Get_stderr(), "draw failed")
        return 1

    # stake == totalStake puts the quorum threshold at ~2^63: selection certain
    if !m0res.value.ticket.selected:
        os.WriteLine(os.Get_stderr(), "member0 not selected")
        rc = rc + 1
    if !m1res.value.ticket.selected:
        os.WriteLine(os.Get_stderr(), "member1 not selected")
        rc = rc + 1
    if !m2res.value.ticket.selected:
        os.WriteLine(os.Get_stderr(), "member2 not selected")
        rc = rc + 1
    if !m3res.value.ticket.selected:
        os.WriteLine(os.Get_stderr(), "member3 not selected")
        rc = rc + 1

    var members: cvt.CommitteeMember[]
    add(members, m0res.value)
    add(members, m1res.value)
    add(members, m2res.value)
    add(members, m3res.value)

    var pks: Bytes[]
    add(pks, m0res.value.pk)
    add(pks, m1res.value.pk)
    add(pks, m2res.value.pk)
    add(pks, m3res.value.pk)

    # header under test: appHash=CidTag(1), commitSeqHash=CidTag(2)
    let appHash = CidTag(1)
    let commitSeqHash = CidTag(2)
    let header = lc.LiteHeaderMake(epoch, round, appHash, commitSeqHash)

    # every member signs the binding proposal hash; collect pk/sig
    let ph = header.certProposalHash
    var vp: Bytes[]
    var vs: Bytes[]
    var i: int32 = 0
    while i < members.len:
        var vres = cvt.CommitteeSignVote(members[i], ph)
        if !vres.ok:
            os.WriteLine(os.Get_stderr(), "sign vote failed")
            return 1
        add(vp, vres.value.voterPk)
        add(vs, vres.value.sig)
        i = i + 1

    if vp.len != 4:
        os.WriteLine(os.Get_stderr(), "vote collection incomplete")
        rc = rc + 1

    # positive: full committee at f=1 confirms Ok(true)
    let okRes = lc.LiteConfirm(header, pks, vp, vs, 1)
    if !okRes.ok:
        os.WriteLine(os.Get_stderr(), "full confirm errored")
        rc = rc + 1
    else:
        if !okRes.value:
            os.WriteLine(os.Get_stderr(), "full confirm returned false")
            rc = rc + 1

    # negative: tampered appHash first byte +1, rebuilt header must reject
    let badApp = AppHashBumpFirst(appHash)
    let badHeader = lc.LiteHeaderMake(epoch, round, badApp, commitSeqHash)
    let driftRes = lc.LiteConfirm(badHeader, pks, vp, vs, 1)
    if driftRes.ok:
        os.WriteLine(os.Get_stderr(), "tampered appHash confirmed")
        rc = rc + 1

    # negative: only 2 of 4 votes cannot reach 2f+1=3 at f=1
    var vp2: Bytes[]
    var vs2: Bytes[]
    var k: int32 = 0
    while k < 2:
        add(vp2, vp[k])
        add(vs2, vs[k])
        k = k + 1
    let shortRes = lc.LiteConfirm(header, pks, vp2, vs2, 1)
    if shortRes.ok:
        os.WriteLine(os.Get_stderr(), "two votes confirmed at f=1")
        rc = rc + 1

    if rc == 0:
        echo("light_client_smoke ok")
    return rc
