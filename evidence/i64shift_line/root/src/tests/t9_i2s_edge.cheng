import std/strings

fn main(): int32 =
    if strings.IntToStr(0) != "0": return 1
    if strings.IntToStr(-42) != "-42": return 2
    if strings.IntToStr(2147483647) != "2147483647": return 3
    if strings.IntToStr(-2147483648) != "-2147483648": return 4
    if strings.int64ToStr(0) != "0": return 5
    if strings.int64ToStr(-987654321098) != "-987654321098": return 6
    if strings.int64ToStr(-9223372036854775807) != "-9223372036854775807": return 7
    return 0
