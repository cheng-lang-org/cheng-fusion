import std/os as os

fn touch448(a: var uint8[448]) =
    a[0] = uint8(1)

fn touch8(a: var uint64[8]) =
    a[0] = uint64(2)

fn touchScalar(a: var int32) =
    a = 3

fn main(): int32 =
    var x448: uint8[448]
    x448[0] = uint8(0)
    touch448(x448)
    var x8: uint64[8]
    x8[0] = uint64(0)
    touch8(x8)
    var xs: int32 = 0
    touchScalar(xs)
    if x448[0] == uint8(1) && x8[0] == uint64(2) && xs == 3:
        os.WriteLine(os.Get_stdout(), "var-array-ok")
        return 0
    if x448[0] != uint8(1):
        os.WriteLine(os.Get_stdout(), "u8-448-broken")
    if x8[0] != uint64(2):
        os.WriteLine(os.Get_stdout(), "u64-8-broken")
    if xs != 3:
        os.WriteLine(os.Get_stdout(), "scalar-broken")
    return 1
