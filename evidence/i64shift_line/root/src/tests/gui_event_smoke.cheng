import std/gui as gui

fn main(): int32 =
    gui.Log("Cheng GUI event-driven test starting")
    gui.Init()
    var win = gui.CreateWindow("Event-Driven GUI", 600, 400)
    gui.ShowWindow(win)

    var label = gui.CreateLabel("Click anywhere or press any key", 50, 350, 400, 30)
    gui.AddView(win, label)

    var running: int32 = 1
    var frame: int32
    while running != 0:
        gui.ProcessFrame()
        var ev = gui.NextEvent()
        while ev != gui.EVENT_NONE:
            if ev == gui.EVENT_QUIT:
                gui.Log("Event: QUIT")
                running = 0
            if ev == gui.EVENT_CLICK:
                gui.Log("Event: CLICK")
                gui.SetLabelText(label, "Clicked!")
            if ev == gui.EVENT_KEY:
                gui.Log("Event: KEY")
                running = 0
            gui.ConsumeEvent()
            ev = gui.NextEvent()
        frame = frame + 1
        gui.SleepMs(16)
        if frame > 180:
            gui.Log("Timeout, auto-quitting")
            running = 0

    gui.ReleaseView(label)
    gui.CloseWindow(win)
    gui.Log("gui_event_smoke ok")
    return 0
