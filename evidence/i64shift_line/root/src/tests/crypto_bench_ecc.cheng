# ECC handshake primitive benchmark: X25519, P-256 ECDH, ECDSA sign/verify —
# the exact entry points the tcp-tls-forward TLS 1.3 handshake calls.
import std/crypto/curve25519
import std/crypto/ecnist
import std/crypto/sha256
import std/rawbytes
import std/strings
import std/os

@importc("cheng_monotime_ns")
fn monoNs(): int64

const eccRounds = 5

fn benchFillRandom(buf: rawbytes.Bytes) =
    var i: int32 = 0
    var seed: int32 = 987654321
    while i < rawbytes.BytesLen(buf):
        seed = (seed * 1103515245 + 12345) & 2147483647
        rawbytes.BytesSet(buf, i, (seed >> 16) & 255)
        i = i + 1

fn benchPrint(text: str) =
    os.WriteLine(os.Get_stdout(), text)

fn benchReport(name: str, ops: int32, dtNs: int64) =
    var clamped: int64 = dtNs
    if clamped < 1:
        clamped = 1
    let usPerOp: int64 = clamped / int64(ops)
    benchPrint(name)
    benchPrint(strings.Int64ToStr(usPerOp))

fn main(): int32 =
    var xPriv: rawbytes.Bytes = rawbytes.BytesAlloc(32)
    benchFillRandom(xPriv)

    let xT0: int64 = monoNs()
    var xr: int32 = 0
    while xr < eccRounds:
        let pubRes: Result[rawbytes.Bytes] = curve25519.curve25519PublicFromPrivate(xPriv)
        xr = xr + 1
    benchReport("X25519_public_from_private_us_per_op", eccRounds, monoNs() - xT0)

    var xPub: rawbytes.Bytes = rawbytes.BytesAlloc(32)
    benchFillRandom(xPub)
    let xS0: int64 = monoNs()
    xr = 0
    while xr < eccRounds:
        let shRes: Result[rawbytes.Bytes] = curve25519.curve25519SharedKey(xPriv, xPub)
        xr = xr + 1
    benchReport("X25519_shared_key_us_per_op", eccRounds, monoNs() - xS0)

    var p256Priv: rawbytes.Bytes = rawbytes.BytesAlloc(32)
    benchFillRandom(p256Priv)
    let pubGenRes: Result[rawbytes.Bytes] = ecnist.EcdsaPublicKeyFromPrivateBytes(p256Priv)
    var p256Pub: rawbytes.Bytes = Value(pubGenRes)

    let dT0: int64 = monoNs()
    var dr: int32 = 0
    while dr < eccRounds:
        let shRes: Result[rawbytes.Bytes] = ecnist.ecdhP256SharedSecretBytes(p256Priv, p256Pub)
        dr = dr + 1
    benchReport("P256_ECDH_shared_us_per_op", eccRounds, monoNs() - dT0)

    var msg: rawbytes.Bytes = rawbytes.BytesAlloc(32)
    benchFillRandom(msg)

    let sT0: int64 = monoNs()
    var sr: int32 = 0
    while sr < eccRounds:
        let sigRes: Result[rawbytes.Bytes] = ecnist.ecdsaSignBytes(p256Priv, msg)
        sr = sr + 1
    benchReport("P256_ECDSA_sign_us_per_op", eccRounds, monoNs() - sT0)

    let sigRes: Result[rawbytes.Bytes] = ecnist.ecdsaSignBytes(p256Priv, msg)
    var sig: rawbytes.Bytes = Value(sigRes)
    let vT0: int64 = monoNs()
    var vr: int32 = 0
    while vr < eccRounds:
        let ok: bool = ecnist.ecdsaVerifyTrustedBytes(p256Pub, msg, sig)
        vr = vr + 1
    benchReport("P256_ECDSA_verify_us_per_op", eccRounds, monoNs() - vT0)
    return 0
