    out.symbols.interfaceCids[functionSymbolId] = functionInterfaceCid
    out.functions.interfaceCids[0] = functionInterfaceCid
    out.readSet.observedValueCids[0] = functionInterfaceCid
    var sourceInterfaceCids: layout.FixedBytes32[]
    assert(schema.CsgCompilerSourceInterfaceCidsInto(
               out, sourceInterfaceCids, proofErr), proofErr)
    out.sources.interfaceCids = sourceInterfaceCids
    var finalReadSetPreimageCid: layout.FixedBytes32
    assert(schema.CsgCompilerReadSetPreimageCidInto(
               functionSymbolCid,
               out.readSet.targetDomainKinds,
               out.readSet.targetPortableKeyCids,
               out.readSet.observedValueCids,
               0,
               1,
               finalReadSetPreimageCid,
               proofErr),
           proofErr)
    out.functions.readSetPreimageCids[0] = finalReadSetPreimageCid
    assert(schema.CsgCompilerReadSetReverseBuildInto(out, proofErr),
           strings.ConcatStr("final reverse read-set: ", proofErr))
    var callOwnershipProofCid: layout.FixedBytes32
    assert(schema.CsgCompilerCallResultOwnershipProofCidInto(
               out, 0, callOwnershipProofCid, proofErr), proofErr)
    out.calls.resultOwnershipProofCids[0] = callOwnershipProofCid
    var ownershipProofCid: layout.FixedBytes32
    assert(schema.CsgCompilerTypedNodeOwnershipProofCidInto(
               out, 0, ownershipProofCid, proofErr), proofErr)
    out.typedNodes.ownershipProofCids[0] = ownershipProofCid
    var sendProofCid: layout.FixedBytes32
    assert(schema.CsgCompilerTypedNodeSendProofCidInto(
               out, 0, sendProofCid, proofErr), proofErr)
    out.typedNodes.sendProofCids[0] = sendProofCid
    var syncProofCid: layout.FixedBytes32
    assert(schema.CsgCompilerTypedNodeSyncProofCidInto(
               out, 0, syncProofCid, proofErr), proofErr)
    out.typedNodes.syncProofCids[0] = syncProofCid
    var shareProofCid: layout.FixedBytes32
    assert(schema.CsgCompilerTypedNodeShareProofCidInto(
               out, 0, shareProofCid, proofErr), proofErr)
    out.typedNodes.shareProofCids[0] = shareProofCid
    var fragmentCid: layout.FixedBytes32
    assert(schema.CsgCompilerFunctionFragmentCidInto(
               out, 0, fragmentCid, proofErr), proofErr)
    out.functions.fragmentCids[0] = fragmentCid
    out.diagnosticCompletions.requiredDomainCid =
        TestCid("compiler-snapshot/diagnostic-required-domain")
    out.diagnosticCompletions.requiredStarts = [0, 1, 1, 2, 3]
    out.diagnosticCompletions.requiredCounts = [1, 0, 1, 1, 0]
    out.diagnosticCompletions.proofCids = [
        layout.FixedBytes32(),
        layout.FixedBytes32(),
        layout.FixedBytes32(),
        layout.FixedBytes32(),
        layout.FixedBytes32()]
    out.diagnosticCompletions.requiredProducerIds = [0, 0, 0]
    out.diagnosticCompletions.requiredProducerCids = [
        TestCid("compiler-snapshot/diagnostic-parser-producer"),
        TestCid("compiler-snapshot/diagnostic-ownership-producer"),
        TestCid("compiler-snapshot/diagnostic-concurrency-producer")]
    out.diagnosticCompletions.requiredResultIds = [0, 0, 0]
    out.diagnosticCompletions.requiredResultCids = [
        TestCid("compiler-snapshot/diagnostic-parser-result"),
        TestCid("compiler-snapshot/diagnostic-ownership-result"),
        TestCid("compiler-snapshot/diagnostic-concurrency-result")]
    for completionId in 0..<out.diagnosticCompletions.sourceIds.len:
        var completionProofCid: layout.FixedBytes32
        var completionDiagnosticCount: int32
        assert(schema.CsgCompilerDiagnosticCompletionProofCidInto(
                   out,
                   completionId,
                   completionProofCid,
                   completionDiagnosticCount,
                   proofErr) &&
               completionDiagnosticCount ==
                   out.diagnosticCompletions.rowCounts[
                       completionId],
               proofErr)
        out.diagnosticCompletions.proofCids[completionId] =
            completionProofCid
    var verifyTraitProofCid: layout.FixedBytes32
    assert(schema.CsgCompilerTypeTraitProofCidInto(
               out, 0, verifyTraitProofCid, proofErr) &&
           layout.FixedBytes32Equal(
               verifyTraitProofCid, out.types.traitProofCids[0]),
           "BuildSnapshot trait proof drift")
    return out

fn BuildSnapshot(): schema.CsgCompilerSnapshotTables =
    var out = BuildSnapshotWithParameterDefault(false)
    return out

fn BuildParameterDefaultSnapshot():
        schema.CsgCompilerSnapshotTables =
    var out = BuildSnapshotWithParameterDefault(true)
    return out

fn TestParameterDefaultDeclarationIdentity() =
    var err: str
    var snapshot = BuildParameterDefaultSnapshot()
    let parameterDeclaration: int32 = 1
    let parameterRoot: int32 = 0
    assert(schema.CsgCompilerSnapshotTablesStrictValidateInto(
               snapshot, err), err)
    assert(snapshot.parserSidecars.declarationDefaultStatementRootRows[
               parameterDeclaration] == parameterRoot &&
           snapshot.parserSidecars.statementRootBindingDeclarationStarts[
               parameterRoot] == parameterDeclaration &&
           snapshot.parserSidecars.statementRootBindingDeclarationCounts[
               parameterRoot] == 1 &&
           snapshot.parserSidecars.declarationLexicalScopeKinds[
               snapshot.parserSidecars.declarationLexicalScopeIds[
                   parameterDeclaration]] ==
               schema.CsgCompilerParserScopeFunction &&
           snapshot.typedNodes.originParserNodeIds[0] == 3,
           "snapshot parameter default identity missing")

    var wrongDeclaration =
        schema.CsgCompilerSnapshotTablesClone(snapshot)
    wrongDeclaration.parserSidecars.statementRootBindingDeclarationStarts[
        parameterRoot] = 2
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(
               wrongDeclaration, err),
           "snapshot wrong parameter default declaration survived")
    var crossRoleReuse =
        schema.CsgCompilerSnapshotTablesClone(snapshot)
    crossRoleReuse.parserSidecars.declarationDefaultStatementRootRows[
        parameterDeclaration] = 1
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(
               crossRoleReuse, err),
           "snapshot cross-role parameter default reuse survived")
    var wrongKind =
        schema.CsgCompilerSnapshotTablesClone(snapshot)
    wrongKind.parserSidecars.declarationKinds[parameterDeclaration] =
        schema.CsgCompilerParserDeclarationLocal
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(
               wrongKind, err),
           "snapshot wrong parameter declaration kind survived")
    var wrongOwner =
        schema.CsgCompilerSnapshotTablesClone(snapshot)
    wrongOwner.parserSidecars.declarationOwnerIds[parameterDeclaration] = -1
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(
               wrongOwner, err),
           "snapshot wrong parameter declaration owner survived")
    var wrongSource =
        schema.CsgCompilerSnapshotTablesClone(snapshot)
    wrongSource.parserSidecars.declarationProducerSourceIds[
        parameterDeclaration] = 1
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(
               wrongSource, err),
           "snapshot wrong parameter declaration source survived")
    var wrongSpan =
        schema.CsgCompilerSnapshotTablesClone(snapshot)
    wrongSpan.parserSidecars.declarationSpanIds[parameterDeclaration] =
        wrongSpan.parserSidecars.declarationNameSpanIds[
            parameterDeclaration]
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(
               wrongSpan, err),
           "snapshot wrong parameter declaration span survived")
    var wrongAssign =
        schema.CsgCompilerSnapshotTablesClone(snapshot)
    let anchorToken =
        wrongAssign.parserSidecars.statementRootAnchorTokenIds[
            parameterRoot]
    wrongAssign.tokens.kinds[anchorToken] = 1
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(
               wrongAssign, err),
           "snapshot wrong parameter default assign anchor survived")
    var parameterCargo =
        cargo.CsgCompilerSnapshotCargoBuild(snapshot)
    assert(parameterCargo.ok, parameterCargo.error)
    var wireReuse = TestCloneLines(parameterCargo.canonicalLines)
    wireReuse[7] = TestReplaceField(strings.CloneStr(
        wireReuse[7]),
        "declarationDefaultStatementRootRows",
        TestIntArrayJson(
            snapshot.parserSidecars.declarationDefaultStatementRootRows),
        "[-1,1,-1]")
    assert(!TestVerifyLines(wireReuse),
           "snapshot wire cross-role parameter default reuse survived")
    cargo.CsgCompilerSnapshotCargoRelease(parameterCargo)
    echo("snapshot_parameter_default_identity_positive=1")
    echo("snapshot_parameter_default_identity_mutations_rejected=7")
    echo("snapshot_parameter_default_wire_mutations_rejected=1")

fn TestSourceInterfaceDagFinalize() =
    var initial: schema.CsgCompilerSnapshotTables
    initial.sources.documentCids = [
        TestCid("source-interface-dag/document-a"),
        TestCid("source-interface-dag/document-b"),
        TestCid("source-interface-dag/document-c")]
    initial.sources.interfaceCids = [
        layout.FixedBytes32(),
        layout.FixedBytes32(),
        layout.FixedBytes32()]
    initial.symbols.symbolCids = [
        TestCid("source-interface-dag/symbol-a"),
        TestCid("source-interface-dag/symbol-b"),
        TestCid("source-interface-dag/symbol-c")]
    initial.symbols.interfaceCids = [
        TestCid("source-interface-dag/interface-a"),
        TestCid("source-interface-dag/interface-b"),
        TestCid("source-interface-dag/interface-c")]
    initial.symbols.sourceIds = [0, 1, 2]
    initial.symbols.symbolKinds = [
        schema.CsgCompilerSymbolModule,
        schema.CsgCompilerSymbolModule,
        schema.CsgCompilerSymbolModule]
    initial.symbols.exportedFlags = [true, true, true]
    initial.dependencies.sourceIds = [0, 0, 1]
    initial.dependencies.targetSourceIds = [1, 2, 2]
    initial.dependencies.dependencyKinds = [1, 1, 1]
    initial.dependencies.observedInterfaceCids = [
        layout.FixedBytes32(),
        layout.FixedBytes32(),
        layout.FixedBytes32()]

    var first = schema.CsgCompilerSnapshotTablesClone(initial)
    var second = schema.CsgCompilerSnapshotTablesClone(initial)
    var err: str
    assert(schema.CsgCompilerSourceInterfacesFinalizeInto(first, err), err)
    assert(schema.CsgCompilerSourceInterfacesFinalizeInto(second, err), err)
    for sourceId in 0..<first.sources.interfaceCids.len:
        assert(layout.FixedBytes32Equal(
                   first.sources.interfaceCids[sourceId],
                   second.sources.interfaceCids[sourceId]) &&
               !layout.FixedBytes32Equal(
                   first.sources.interfaceCids[sourceId],
                   layout.FixedBytes32()),
               "source interface DAG finalization is not deterministic")
    assert(layout.FixedBytes32Equal(
               first.dependencies.observedInterfaceCids[0],
               first.sources.interfaceCids[1]) &&
           layout.FixedBytes32Equal(
               first.dependencies.observedInterfaceCids[1],
               first.sources.interfaceCids[2]) &&
           layout.FixedBytes32Equal(
               first.dependencies.observedInterfaceCids[2],
               first.sources.interfaceCids[2]),
           "source interface DAG target binding drift")
    var replay: layout.FixedBytes32[]
    assert(schema.CsgCompilerSourceInterfaceCidsInto(
               first, replay, err) &&
           replay.len == first.sources.interfaceCids.len,
           err)
    for sourceId in 0..<replay.len:
        assert(layout.FixedBytes32Equal(
                   replay[sourceId],
                   first.sources.interfaceCids[sourceId]),
               "source interface DAG replay mismatch")

    var observedAttack =
        schema.CsgCompilerSnapshotTablesClone(first)
    observedAttack.dependencies.observedInterfaceCids[0].data[0] =
        uint8(
            Int32(
                observedAttack.dependencies.observedInterfaceCids[
                    0].data[0]) ^ 1)
    assert(!schema.CsgCompilerSourceInterfaceCidsInto(
               observedAttack, replay, err),
           "source interface observed-target split accepted")

    var cycleAttack =
        schema.CsgCompilerSnapshotTablesClone(initial)
    cycleAttack.dependencies.sourceIds = [0, 1, 2]
    cycleAttack.dependencies.targetSourceIds = [1, 2, 0]
    assert(!schema.CsgCompilerSourceInterfacesFinalizeInto(
               cycleAttack, err),
           "source interface dependency cycle accepted")
    for sourceId in 0..<cycleAttack.sources.interfaceCids.len:
        assert(layout.FixedBytes32Equal(
                   cycleAttack.sources.interfaceCids[sourceId],
                   layout.FixedBytes32()),
               "failed source interface finalization mutated source rows")
    for dependencyId in 0..<
            cycleAttack.dependencies.observedInterfaceCids.len:
        assert(layout.FixedBytes32Equal(
                   cycleAttack.dependencies.observedInterfaceCids[
                       dependencyId],
                   layout.FixedBytes32()),
               "failed source interface finalization mutated dependency rows")

fn main() =
    var err: str
    TestSourceInterfaceDagFinalize()
    TestParameterDefaultDeclarationIdentity()
    var snapshot = BuildSnapshot()
    let fixtureModuleSymbolId = TestModuleSymbolId(snapshot)
    let fixtureFunctionSymbolId = TestFunctionSymbolId(snapshot)
    assert(fixtureModuleSymbolId >= 0 &&
           fixtureFunctionSymbolId >= 0 &&
           fixtureModuleSymbolId != fixtureFunctionSymbolId &&
           snapshot.symbols.typeIds[fixtureModuleSymbolId] == -1 &&
           snapshot.symbols.functionIds[fixtureModuleSymbolId] == -1 &&
           snapshot.symbols.nameSpanIds[fixtureModuleSymbolId] == -1 &&
           snapshot.symbols.nameTokenIds[fixtureModuleSymbolId] == -1 &&
           snapshot.symbols.declarationSpanIds[fixtureModuleSymbolId] == -1 &&
           snapshot.symbols.ownerSymbolIds[fixtureFunctionSymbolId] ==
               fixtureModuleSymbolId &&
           snapshot.functions.symbolIds.len == 1 &&
           snapshot.functions.symbolIds[0] == fixtureFunctionSymbolId,
           "full fixture Module/Function Symbol ownership drift")
    var unsealedReference =
        schema.CsgCompilerSnapshotTablesClone(snapshot)
    for sourceId in 0..<unsealedReference.sources.interfaceCids.len:
        unsealedReference.sources.interfaceCids[sourceId] =
            layout.FixedBytes32()
    unsealedReference.readSet = schema.CsgCompilerReadSetTable()
    for functionId in 0..<unsealedReference.functions.symbolIds.len:
        unsealedReference.functions.readStarts[functionId] = 0
        unsealedReference.functions.readCounts[functionId] = 0
        unsealedReference.functions.readSetPreimageCids[functionId] =
            layout.FixedBytes32()
    assert(schema.CsgCompilerSnapshotUnsealedReferenceCallTablesStrictValidateInto(
               unsealedReference, err), err)
    assert(!schema.CsgCompilerSnapshotReferenceCallTablesStrictValidateInto(
               unsealedReference, err),
           "full reference strict accepted zero source interfaces")
    var prefilledForwardRead =
        schema.CsgCompilerSnapshotTablesClone(unsealedReference)
    prefilledForwardRead.readSet.readerFunctionIds = [0]
    assert(!schema.CsgCompilerSnapshotUnsealedReferenceCallTablesStrictValidateInto(
               prefilledForwardRead, err),
           "unsealed reference strict accepted a prefilled forward read column")
    var prefilledReverseRead =
        schema.CsgCompilerSnapshotTablesClone(unsealedReference)
    prefilledReverseRead.readSet.reverseTargetDomainKinds = [
        schema.CsgCompilerReadDomainSymbolInterface]
    assert(!schema.CsgCompilerSnapshotUnsealedReferenceCallTablesStrictValidateInto(
               prefilledReverseRead, err),
           "unsealed reference strict accepted a prefilled reverse read column")
    var prefilledReverseCid =
        schema.CsgCompilerSnapshotTablesClone(unsealedReference)
    prefilledReverseCid.readSet.reverseIndexCid =
        snapshot.readSet.reverseIndexCid
    assert(!schema.CsgCompilerSnapshotUnsealedReferenceCallTablesStrictValidateInto(
               prefilledReverseCid, err),
           "unsealed reference strict accepted a nonzero reverse read CID")
    var emptyFullReads =
        schema.CsgCompilerSnapshotTablesClone(snapshot)
    emptyFullReads.readSet = schema.CsgCompilerReadSetTable()
    for functionId in 0..<emptyFullReads.functions.symbolIds.len:
        emptyFullReads.functions.readStarts[functionId] = 0
        emptyFullReads.functions.readCounts[functionId] = 0
        emptyFullReads.functions.readSetPreimageCids[functionId] =
            layout.FixedBytes32()
    assert(!schema.CsgCompilerSnapshotReferenceCallTablesStrictValidateInto(
               emptyFullReads, err),
           "full reference strict accepted empty read authority")
    var prefilledUnsealed =
        schema.CsgCompilerSnapshotTablesClone(unsealedReference)
    prefilledUnsealed.sources.interfaceCids[0] =
        snapshot.sources.interfaceCids[0]
    assert(!schema.CsgCompilerSnapshotUnsealedReferenceCallTablesStrictValidateInto(
               prefilledUnsealed, err),
           "unsealed reference strict accepted a prefilled source interface")
    var deletedUnsealed =
        schema.CsgCompilerSnapshotTablesClone(unsealedReference)
    setLen(deletedUnsealed.sources.interfaceCids,
           deletedUnsealed.sources.interfaceCids.len - 1)
    assert(!schema.CsgCompilerSnapshotUnsealedReferenceCallTablesStrictValidateInto(
               deletedUnsealed, err),
           "unsealed reference strict accepted a deleted source row")
    var immediateFragmentCid: layout.FixedBytes32
    assert(snapshot.parserSidecars.statementRootNodeIds.len == 1 &&
           snapshot.parserSidecars.statementRootNodeIds[0] == 2 &&
           snapshot.parserSidecars.statementRootRoles[0] ==
               schema.CsgCompilerParserStatementBindingInitializer &&
           snapshot.parserSidecars.statementRootBindingDeclarationStarts[0] ==
               1 &&
           snapshot.parserSidecars.statementRootBindingDeclarationCounts[0] ==
               1 &&
           snapshot.parserSidecars.declarationFunctionRows[1] == 0 &&
           snapshot.parserSidecars.functionBodySpanIds[0] == 2 &&
           snapshot.functions.bodySpanIds[0] == 2 &&
           snapshot.typedNodes.originParserNodeIds[0] == 2,
           "BuildSnapshot immutable parser origin capability drift")
    assert(schema.CsgCompilerFunctionFragmentCidInto(
               snapshot, 0, immediateFragmentCid, err), err)
    assert(layout.FixedBytes32Equal(
               immediateFragmentCid, snapshot.functions.fragmentCids[0]),
           "BuildSnapshot immediate fragment drift")
    assert(schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           err)

    snapshot = BuildSnapshot()
    snapshot.tokens.sourceLocalRows[1] = 0
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "duplicate token source-local identity accepted")

    snapshot = BuildSnapshot()
    snapshot.tokens.lexicalParentTokenIds[1] = 0
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "forged token lexical parent accepted")

    var missingModuleSnapshot = BuildSnapshot()
    assert(TestRemoveModuleSymbol(missingModuleSnapshot, err), err)
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(
               missingModuleSnapshot, err),
           "missing module Symbol accepted")

    snapshot = BuildSnapshot()
    snapshot.symbols.qualifiedNameTextIds[fixtureModuleSymbolId] =
        snapshot.symbols.qualifiedNameTextIds[fixtureFunctionSymbolId]
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "module Symbol qualifiedName remap accepted")

    snapshot = BuildSnapshot()
    snapshot.symbols.nameTokenIds[fixtureModuleSymbolId] =
        snapshot.symbols.nameTokenIds[fixtureFunctionSymbolId]
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "module Symbol nameToken remap accepted")

    snapshot = BuildSnapshot()
    snapshot.symbols.qualifiedNameTextIds[fixtureFunctionSymbolId] =
        snapshot.symbols.qualifiedNameTextIds[fixtureModuleSymbolId]
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "function Symbol qualifiedName remap accepted")

    snapshot = BuildSnapshot()
    snapshot.symbols.ownerSymbolIds[fixtureFunctionSymbolId] = -1
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "function Symbol owner remap accepted")

    snapshot = BuildSnapshot()
    var relocatedSnapshot = schema.CsgCompilerSnapshotTablesClone(snapshot)
    for spanId in 0..<relocatedSnapshot.spans.startBytes.len:
        relocatedSnapshot.spans.startBytes[spanId] =
            relocatedSnapshot.spans.startBytes[spanId] + 100
        relocatedSnapshot.spans.endBytes[spanId] =
            relocatedSnapshot.spans.endBytes[spanId] + 100
        relocatedSnapshot.spans.startLines[spanId] =
            relocatedSnapshot.spans.startLines[spanId] + 3
        relocatedSnapshot.spans.endLines[spanId] =
            relocatedSnapshot.spans.endLines[spanId] + 3
    for nodeId in 0..<relocatedSnapshot.parserNodes.producerNodeIds.len:
        relocatedSnapshot.parserNodes.producerNodeIds[nodeId] =
            relocatedSnapshot.parserNodes.producerNodeIds[nodeId] + 7
    for nodeId in 0..<relocatedSnapshot.typedNodes.typedIrNodeIndexes.len:
        relocatedSnapshot.typedNodes.typedIrNodeIndexes[nodeId] =
            relocatedSnapshot.typedNodes.typedIrNodeIndexes[nodeId] + 11
    var relocatedFragmentCid: layout.FixedBytes32
    assert(schema.CsgCompilerFunctionFragmentCidInto(
               relocatedSnapshot, 0, relocatedFragmentCid, err), err)
    assert(layout.FixedBytes32Equal(
               relocatedFragmentCid, snapshot.functions.fragmentCids[0]),
           "absolute source/producer relocation changed function fragment")

    snapshot = BuildSnapshot()
    snapshot.references.ownerSymbolIds = []
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "reference owner Symbol column length mismatch accepted")

    snapshot = BuildSnapshot()
    snapshot.references.bindingTypedNodeIds = []
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "reference binding TypedNode column length mismatch accepted")

    snapshot = BuildSnapshot()
    snapshot.references.ownerSymbolIds[0] = -1
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "negative reference owner Symbol accepted")

    snapshot = BuildSnapshot()
    snapshot.references.ownerSymbolIds[0] =
        snapshot.symbols.symbolCids.len
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "out-of-bounds reference owner Symbol accepted")

    snapshot = BuildSnapshot()
    snapshot.references.ownerSymbolIds[0] = fixtureModuleSymbolId
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "reference Function owner split accepted")

    snapshot = BuildSnapshot()
    snapshot.references.referenceKinds[0] =
        schema.CsgCompilerReferenceType
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "Type reference accepted a non-Type target")

    snapshot = BuildSnapshot()
    snapshot.references.referenceKinds[0] =
        schema.CsgCompilerReferenceImport
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "Import reference accepted a non-Module target")

    snapshot = BuildSnapshot()
    var referenceTable = snapshot.references
    var referenceTargets = referenceTable.targetSymbolIds
    referenceTargets[0] = fixtureModuleSymbolId
    referenceTable.targetSymbolIds = referenceTargets
    snapshot.references = referenceTable
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "forged reference target accepted")

    snapshot = BuildSnapshot()
    snapshot.sources.interfaceCids[0] =
        TestCid("compiler-snapshot/forged-source-interface")
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "forged source interface accepted")
    var forgedSourceCargo = cargo.CsgCompilerSnapshotCargoBuild(snapshot)
    assert(!forgedSourceCargo.ok,
           "cargo published a snapshot with a forged source interface")

    snapshot = BuildSnapshot()
    var dependencySpanTable = snapshot.dependencies
    dependencySpanTable.sourceIds = [0]
    dependencySpanTable.targetSourceIds = [0]
    dependencySpanTable.spanIds = [4]
    dependencySpanTable.dependencyKinds = [1]
    dependencySpanTable.observedInterfaceCids = [
        snapshot.sources.interfaceCids[0]]
    snapshot.dependencies = dependencySpanTable
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "cyclic source dependency accepted")

    snapshot = BuildSnapshot()
    snapshot.symbols.declarationHeaderCids[fixtureFunctionSymbolId] =
        TestCid("compiler-snapshot/forged-declaration-header")
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "forged declaration header survived parser receipt binding")

    snapshot = BuildSnapshot()
    snapshot.symbols.declIds[fixtureFunctionSymbolId] = -1
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "forged Symbol DeclId accepted")

    snapshot = BuildSnapshot()
    snapshot.symbols.declKeyCids[fixtureFunctionSymbolId] =
        TestCid("compiler-snapshot/forged-decl-key")
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "forged Symbol DeclKeyCid accepted")

    snapshot = BuildSnapshot()
    let functionDeclId =
        snapshot.symbols.declIds[fixtureFunctionSymbolId]
    snapshot.declarations.ownerDeclIds[functionDeclId] = -1
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "forged declaration owner accepted")

    snapshot = BuildSnapshot()
    snapshot.declarations.parserValidatedNameProofCids[functionDeclId] =
        TestCid("compiler-snapshot/forged-name-proof")
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "forged declaration name proof accepted")

    snapshot = BuildSnapshot()
    snapshot.declarations.tableCid =
        TestCid("compiler-snapshot/forged-declaration-table-cid")
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "forged declaration table CID accepted")

    snapshot = BuildSnapshot()
    snapshot.declarations.portableSignatureTypeExpressionCids[
        functionDeclId] = TestCid("compiler-snapshot/forged-signature-type")
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "forged declaration signature TypeCid accepted")

    snapshot = BuildSnapshot()
    snapshot.symbols.symbolCids[fixtureFunctionSymbolId] =
        TestCid("compiler-snapshot/forged-symbol-cid")
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "forged SymbolCid accepted")

    snapshot = BuildSnapshot()
    snapshot.symbols.interfaceCids[fixtureFunctionSymbolId] =
        TestCid("compiler-snapshot/forged-symbol-interface-cid")
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "forged symbol interface CID accepted")

    snapshot = BuildSnapshot()
    snapshot.functions.fragmentCids[0] =
        TestCid("compiler-snapshot/forged-function-fragment")
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "forged function fragment CID accepted")
    var forgedFragmentCargo = cargo.CsgCompilerSnapshotCargoBuild(snapshot)
    assert(!forgedFragmentCargo.ok,
           "cargo published a snapshot with a forged function fragment")

    snapshot = BuildSnapshot()
    snapshot.functions.nodeCounts = [0]
    snapshot.typedNodes = schema.CsgCompilerTypedNodeTable()
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "full function without typed-node fragment authority accepted")

    snapshot = BuildSnapshot()
    snapshot.layouts.layoutCids[0] =
        TestCid("compiler-snapshot/forged-layout-cid")
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "forged layout CID accepted")
    var forgedLayoutCargo = cargo.CsgCompilerSnapshotCargoBuild(snapshot)
    assert(!forgedLayoutCargo.ok,
           "cargo published a snapshot with a forged layout CID")

    snapshot = BuildSnapshot()
    snapshot.layouts.sizeBytes[0] = 8
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "layout size mutation without exact CID refresh accepted")

    snapshot = BuildSnapshot()
    snapshot.symbols.nameSpanIds[fixtureFunctionSymbolId] = 2
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "symbol name span without exact token authority accepted")

    snapshot = BuildSnapshot()
    snapshot.symbols.nameTokenIds[fixtureFunctionSymbolId] = 1
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "forged symbol name TokenId accepted")

    snapshot = BuildSnapshot()
    snapshot.types.sendFlags = []
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "missing Send facts accepted")

    snapshot = BuildSnapshot()
    snapshot.types.producerTypeArenaIds = []
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "missing producer TypeArena bridge accepted")

    snapshot = BuildSnapshot()
    let bridgedScalarTypeId = TestTypeKindFind(
