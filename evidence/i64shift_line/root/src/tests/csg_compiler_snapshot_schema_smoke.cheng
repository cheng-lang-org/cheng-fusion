        TestFixedBytes32Copy(out.parserSidecars.functionNameProofCids[0])
    let signatureTypeCidCopy = out.types.typeCids[signatureTypeId]
    assert(declaration.SemanticSnapshotDeclarationCandidateAppendInto(
               declarationStore, "pkg", "pkg/main", documentCid, "",
               moduleCandidate,
               declaration.SemanticSnapshotDeclarationKindFunction,
               declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
