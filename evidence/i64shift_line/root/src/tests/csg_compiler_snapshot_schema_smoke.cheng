    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "forged call target DeclKeyCid accepted")

    snapshot = BuildSnapshot()
    setLen(snapshot.typedNodes.typedIrNodeIndexes,
           snapshot.typedNodes.typedIrNodeIndexes.len - 1)
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "deleted TypedNode producer row accepted")

    snapshot = BuildSnapshot()
    snapshot.typedNodes.ownerStatementIds[0] = -1
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "deleted non-parameter TypedStatement owner accepted")

    snapshot = BuildSnapshot()
    snapshot.typedStatements.rootTypedNodeIds = []
    snapshot.typedStatements.rootCounts[0] = 0
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "disconnected TypedStatement owner DAG accepted")

    snapshot = BuildSnapshot()
    let missingTypeFunctionSymbolId =
        TestFunctionSymbolId(snapshot)
    snapshot.symbols.typeIds[missingTypeFunctionSymbolId] = -1
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "missing Function TypeId accepted")

    snapshot = BuildSnapshot()
    let forgedTypeModuleSymbolId =
        TestModuleSymbolId(snapshot)
    let forgedTypeFunctionSymbolId =
        TestFunctionSymbolId(snapshot)
    snapshot.symbols.typeIds[forgedTypeModuleSymbolId] =
        snapshot.symbols.typeIds[forgedTypeFunctionSymbolId]
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "forged Module TypeId accepted")

    snapshot = BuildSnapshot()
    snapshot.calls.resultTypedNodeIds = []
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "deleted call result TypedNode identity accepted")

    snapshot = BuildSnapshot()
    snapshot.calls.resultTypedNodeIds[0] =
        snapshot.typedNodes.functionIds.len
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "out-of-range call result TypedNode identity accepted")

    snapshot = BuildSnapshot()
    snapshot.calls.resultTypeIds[0] =
        snapshot.symbols.typeIds[TestFunctionSymbolId(snapshot)]
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "call result TypeId split from TypedExpr producer accepted")

    snapshot = BuildSnapshot()
    snapshot.calls.resultOwnershipKinds[0] =
        schema.CsgCompilerOwnershipOwned
    var forgedCallOwnershipProofCid: layout.FixedBytes32
    assert(!schema.CsgCompilerCallResultOwnershipProofCidInto(
               snapshot, 0, forgedCallOwnershipProofCid, err),
           "asserted call ownership could be rehashed as proof")

    snapshot = BuildSnapshot()
    snapshot.typedNodes.ownershipProofKinds[0] =
        schema.CsgCompilerValueProofFlow
    snapshot.calls.resultOwnershipProofKinds[0] =
        schema.CsgCompilerValueProofFlow
    var exactFlowOwnershipProofCid: layout.FixedBytes32
    assert(schema.CsgCompilerTypedNodeOwnershipProofCidInto(
               snapshot, 0, exactFlowOwnershipProofCid, err), err)
    snapshot.typedNodes.ownershipProofCids[0] =
        exactFlowOwnershipProofCid
    var exactCallFlowOwnershipProofCid: layout.FixedBytes32
    assert(schema.CsgCompilerCallResultOwnershipProofCidInto(
               snapshot, 0, exactCallFlowOwnershipProofCid, err), err)
    assert(!layout.FixedBytes32Equal(
               exactCallFlowOwnershipProofCid,
               layout.FixedBytes32()),
           "exact CallExpr flow ownership proof was empty")

    snapshot = BuildSnapshot()
    snapshot.typedNodes.shareKinds = [schema.CsgCompilerShareLocal]
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "share kind mutation without proof refresh accepted")

    snapshot = BuildSnapshot()
    snapshot.functions.annotationFlags = []
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "missing function annotation facts accepted")

    snapshot = BuildSnapshot()
    snapshot.functions.annotationFlags[0] = 512
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "unknown function annotation bit accepted")

    snapshot = BuildSnapshot()
    snapshot.functions.resultOwnershipKinds = []
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "missing function result ownership summary accepted")

    snapshot = BuildSnapshot()
    snapshot.functions.resultOwnershipKinds[0] =
        schema.CsgCompilerOwnershipBorrowed
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "function result ownership summary drift accepted")

    snapshot = BuildSnapshot()
    snapshot.functions.annotationFlags[0] =
        snapshot.functions.annotationFlags[0] |
        schema.CsgCompilerFunctionAnnotationBorrowResult
    snapshot.parserSidecars.functionAnnotationFlags[0] =
        snapshot.parserSidecars.functionAnnotationFlags[0] |
        schema.CsgCompilerFunctionAnnotationBorrowResult
    snapshot.functions.resultOwnershipKinds[0] =
        schema.CsgCompilerOwnershipBorrowed
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "@borrow_result flag without exact AnnotationTarget accepted")

    snapshot = BuildSnapshot()
    snapshot.functions.annotationFlags[0] =
        schema.CsgCompilerFunctionAnnotationBorrows |
        schema.CsgCompilerFunctionAnnotationEscapes
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "contradictory function borrow annotations accepted")

    snapshot = BuildSnapshot()
    snapshot.parserSidecars.functionAnnotationFlags[0] =
        schema.CsgCompilerFunctionAnnotationThreadBoundary
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "parser/function annotation projection drift accepted")

    snapshot = BuildSnapshot()
    snapshot.functions.parameterOwnershipStarts = []
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "missing parameter ownership starts accepted")

    snapshot = BuildSnapshot()
    snapshot.functions.parameterOwnershipCounts = []
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "missing parameter ownership counts accepted")

    snapshot = BuildSnapshot()
    snapshot.functions.parameterOwnershipStarts[0] = 1
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "non-canonical parameter ownership start accepted")

    snapshot = BuildSnapshot()
    snapshot.functions.parameterOwnershipCounts[0] = 1
    snapshot.functions.parameterOwnershipKinds = [
        schema.CsgCompilerOwnershipUnmanaged]
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "parameter ownership count split from Function Type accepted")

    snapshot = BuildSnapshot()
    snapshot.functions.parameterOwnershipKinds = [
        schema.CsgCompilerOwnershipUnmanaged]
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "unowned parameter ownership row accepted")

    snapshot = BuildSnapshot()
    snapshot.lexicalScopes.visibleSymbolIds = [
        snapshot.symbols.symbolCids.len]
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "forged completion SymbolId accepted")

    snapshot = BuildSnapshot()
    snapshot.diagnostics.producerKinds = [0]
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "unknown diagnostic producer accepted")

    snapshot = BuildSnapshot()
    snapshot.diagnosticCompletions.requiredProducerCids[0] =
        TestCid("compiler-snapshot/forged-diagnostic-producer")
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "diagnostic denominator mutation without completion refresh accepted")

    snapshot = BuildSnapshot()
    snapshot.diagnosticCompletions.requiredResultIds[1] =
        snapshot.typedNodes.functionIds.len
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "diagnostic covered-row mutation accepted")

    snapshot = BuildSnapshot()
    snapshot.diagnosticCompletions.requiredCounts[0] = 0
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "diagnostic required CSR truncation accepted")

    snapshot = BuildSnapshot()
    let savedDiagnosticResultCid =
        snapshot.diagnosticCompletions.requiredResultCids[1]
    snapshot.diagnosticCompletions.requiredResultCids[1] =
        snapshot.diagnosticCompletions.requiredResultCids[2]
    snapshot.diagnosticCompletions.requiredResultCids[2] =
        savedDiagnosticResultCid
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "diagnostic covered-result permutation accepted")

    snapshot = BuildSnapshot()
    snapshot.diagnosticCompletions.proofCids[0].data[0] =
        uint8(Int32(
            snapshot.diagnosticCompletions.proofCids[0].data[0]) ^ 1)
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "diagnostic completion proof mutation accepted")

    snapshot = BuildSnapshot()
    snapshot.diagnosticCompletions.producerReceiptCids[1] =
