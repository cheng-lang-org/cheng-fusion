            schema.CsgCompilerSymbolModule]
        canonicalSymbols.typeIds = [signatureTypeId, -1]
        canonicalSymbols.declarationSpanIds = [1, -1]
        canonicalSymbols.ownerSymbolIds = [moduleSymbolId, -1]
        canonicalSymbols.functionIds = [0, -1]
        canonicalSymbols.externFunctionIds = [-1, -1]
