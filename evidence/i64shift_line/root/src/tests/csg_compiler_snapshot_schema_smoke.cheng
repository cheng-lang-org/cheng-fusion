        canonicalSymbols.functionIds = [-1, 0]
        canonicalSymbols.externFunctionIds = [-1, -1]
    else:
        moduleSymbolId = 1
        functionSymbolId = 0
        canonicalSymbols.symbolCids = [functionSymbolCid, moduleSymbolCid]
        canonicalSymbols.declIds = [functionDeclId, moduleDeclId]
        canonicalSymbols.declKeyCids = [functionSymbolCid, moduleSymbolCid]
        canonicalSymbols.declarationHeaderCids = [
            out.parserSidecars.functionDeclarationHeaderCids[0],
            documentCid]
        canonicalSymbols.declarationPathCids = [
