    snapshot = BuildSnapshot()
    snapshot.calls.targetSourceLocalDeclarationRows[0] = 1
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "swapped call target source-local declaration accepted")

    snapshot = BuildSnapshot()
    snapshot.calls.targetDeclKeyCids[0] =
