               TestFixedBytes32Copy(out.symbols.symbolCids[1])) &&
           TestModuleSymbolId(out) == moduleSymbolId &&
           TestFunctionSymbolId(out) == functionSymbolId,
           "canonical Symbol remap drift")
    out.functions.symbolIds[0] = functionSymbolId
    out.lexicalScopes.visibleSymbolIds[0] = functionSymbolId
