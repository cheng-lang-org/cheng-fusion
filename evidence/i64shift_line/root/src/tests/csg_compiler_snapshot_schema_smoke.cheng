           layout.FixedBytes32Equal(
               typeCidBeforeBridgeMutation,
               typeCidAfterBridgeMutation) &&
           layout.FixedBytes32Equal(
               typeCidAfterBridgeMutation,
               snapshot.types.typeCids[bridgedScalarTypeId]),
