    if TestCidLess(moduleSymbolCid, functionSymbolCid):
        moduleSymbolId = 0
        functionSymbolId = 1
        canonicalSymbols.symbolCids = [moduleSymbolCid, functionSymbolCid]
        canonicalSymbols.declIds = [moduleDeclId, functionDeclId]
        canonicalSymbols.declKeyCids = [moduleSymbolCid, functionSymbolCid]
        canonicalSymbols.declarationHeaderCids = [
            documentCid,
            out.parserSidecars.functionDeclarationHeaderCids[0]]
        canonicalSymbols.declarationPathCids = [
