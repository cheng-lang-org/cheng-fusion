    snapshot = BuildSnapshot()
    snapshot.parserSidecars.regionSpanIds = [4]
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "parser region accepted an anchor outside its span")

    snapshot = BuildSnapshot()
    snapshot.parserSidecars.rootNodeIds = [3]
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "forged parser root accepted")

    snapshot = BuildSnapshot()
    snapshot.parserSidecars.callEventNodeIds = [-1]
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "forged parser call event accepted")

    snapshot = BuildSnapshot()
    snapshot.parserSidecars.statementRootEndLines = [-1]
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "forged parser statement root accepted")

    snapshot = BuildSnapshot()
    snapshot.parserSidecars.statementRootAnchorColumns = [3]
    snapshot.parserSidecars.statementRootEndColumns = [2]
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "backward same-line parser statement root accepted")

    snapshot = BuildSnapshot()
    snapshot.parserSidecars.producerSourceIndexes = [1]
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "forged parser producer source index accepted")

