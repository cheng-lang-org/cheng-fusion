    snapshot.types.producerTypeArenaIds[bridgedScalarTypeId] = -1
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "structural Type accepted synthesized producer sentinel")

    snapshot = BuildSnapshot()
    snapshot.types.producerTypeArenaIds[synthesizedFunctionTypeId] = 0
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
