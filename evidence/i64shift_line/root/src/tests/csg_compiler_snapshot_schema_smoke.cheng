            documentCid]
        canonicalSymbols.sourceIds = [0, 0]
        canonicalSymbols.nameTextIds = [1, 6]
        canonicalSymbols.nameSpanIds = [0, -1]
        canonicalSymbols.nameTokenIds = [0, -1]
        canonicalSymbols.qualifiedNameTextIds = [7, 6]
        canonicalSymbols.symbolKinds = [
