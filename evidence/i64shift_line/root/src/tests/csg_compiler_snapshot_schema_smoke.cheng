    snapshot.parserNodes.genericCounts = [0, 0, 0]
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(snapshot, err),
           "unowned parser generic span accepted")

    snapshot = BuildSnapshot()
    snapshot.parserSidecars.genericSpanIds = [
