import cheng/game/ecs

fn populateWorld(world: var ecs.EcsWorld) =
    ecs.EcsWorldReset(world)
    let player = ecs.EcsWorldSpawn(world, 1000, 2000, 1, "cid:sprite-player")
    let wall = ecs.EcsWorldSpawn(world, 5000, 2000, 1, "cid:sprite-wall")
    assert(ecs.EcsWorldSetVelocity(world, player, 120, 0), "ecs world hash: set player velocity")
    assert(ecs.EcsWorldSetAabbCollider(world, player, 500, 500), "ecs world hash: player collider")
    assert(ecs.EcsWorldSetAabbCollider(world, wall, 500, 500), "ecs world hash: wall collider")

fn main(): int32 =
    var worldA: ecs.EcsWorld
    var worldB: ecs.EcsWorld
    var worldC: ecs.EcsWorld
    populateWorld(worldA)
    populateWorld(worldB)
    populateWorld(worldC)
    assert(ecs.EcsWorldColumnsValid(worldA), "ecs world hash: columns valid")
    assert(ecs.EcsWorldEntityCount(worldA) == 2, "ecs world hash: count")
    let cidA = ecs.EcsWorldCid(worldA)
    let cidB = ecs.EcsWorldCid(worldB)
    assert(cidA.len == 64, "ecs world hash: cid is sha256 hex (64 chars)")
    assert(cidA == cidB, "ecs world hash: deterministic")
    let preimageA = ecs.EcsWorldCanonicalPreimage(worldA)
    assert(preimageA == ecs.EcsWorldCanonicalPreimage(worldB), "ecs world hash: canonical preimage deterministic")
    assert(ecs.EcsWorldSetPosition(worldC, 1, 1001, 2000), "ecs world hash: mutate")
    assert(ecs.EcsWorldCid(worldC) != cidA, "ecs world hash: mutation changes cid")
    return 0
