# Anchor spawn probe (footstep defect): the walk scene's static station
# anchors (footL, footR, handR) spawn at startTick exactly on the part's
# current coordinates (dist0 = 0). A station anchor spawned on the part
# must hold the part at its station point — the first 30 ticks must not
# kick any anchored part out of position (the megaprojection defect sent
# handR to x = -2.05 m). Assertions: zero rejected physics steps, and
# |handR.x - x0| < 0.05 m at tick 30.
import cheng/game/csg/schema
import cheng/game/csg/validation
import cheng/game/csg/producer
import cheng/game/csg/materializer
import cheng/game/csg/execution
import cheng/game/csg/numerics
import cheng/game/physics3d
import std/strings as strings

const
    ProbeTicks = 30
    ProbeTolMm = 50

fn runStation(): bool =
    var facts: schema.CsgWorldFacts = producer.CsgProducerBuildWalkScene()
    var verdict = validation.CsgValidateFacts(facts)
    if verdict.statusCode != validation.CsgValidOk:
        echo("FAIL facts validation")
        return false
    var w: world3d.World3d
    var mp: materializer.CsgMaterializerMapping
    var err: str = ""
    if !materializer.CsgMaterialize(facts, w, mp, err):
        echo("FAIL materialize")
        return false
    var st: execution.CsgExecutionState
    execution.CsgExecutionInit(st, facts, w, mp.partSlot, mp.ropeNodeSlot)
    var handPart: int32 = -1
    var pi: int32 = 0
    while pi < facts.partRole.len:
        if facts.partRole[pi] == schema.CsgRoleHandR:
            handPart = pi
        pi = pi + 1
    if handPart < 0:
        echo("FAIL handR part missing")
        return false
    let handSlot: int32 = mp.partSlot[handPart]
    let x0: float64 = st.w.bodyPx[handSlot]
    let y0: float64 = st.w.bodyPy[handSlot]
    var tick: int32 = 0
    while tick < ProbeTicks:
        var receipt = execution.CsgExecutionTick(st, facts)
        if receipt.statusCode != physics3d.Physics3dStatusOk:
            echo("FAIL step rejected")
            echo("tick=" + strings.Int64ToStr(receipt.tick))
            return false
        tick = tick + 1
    if st.rejectedCount != 0:
        echo("FAIL rejections")
        echo("n=" + strings.IntToStr(st.rejectedCount))
        return false
    let dx: float64 = st.w.bodyPx[handSlot] - x0
    let dy: float64 = st.w.bodyPy[handSlot] - y0
    let dxMm: int64 = numerics.CsgQuantMm(dx)
    let dyMm: int64 = numerics.CsgQuantMm(dy)
    echo("handR x0_mm=" + strings.Int64ToStr(numerics.CsgQuantMm(x0)))
    echo("handR dx_mm=" + strings.Int64ToStr(dxMm))
    echo("handR dy_mm=" + strings.Int64ToStr(dyMm))
    let adx: float64 = numerics.CsgAbs(dx)
    if adx * 1000.0 > float64(ProbeTolMm):
        echo("FAIL handR kicked on x")
        return false
    echo("PASS anchor spawn probe")
    return true

fn main(): int32 =
    if !runStation():
        return 1
    return 0
