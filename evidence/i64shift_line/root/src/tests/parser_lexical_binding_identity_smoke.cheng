import std/strings as strings
import cheng/core/runtime/arena as arenamod
import cheng/core/lang/parser as parser

fn IdentitySource(): str =
    return "fn Resolve(input: int32): int32 =\n    let outer = input\n    if input:\n        let outer = input + 1\n        outer\n    outer\n"

fn OutOfScopeSource(): str =
    return "fn Resolve(input: int32): int32 =\n    if input:\n        let hidden = input\n        hidden\n    hidden\n"

fn SelfReferenceSource(): str =
    return "fn Resolve(input: int32): int32 =\n    let value = value\n    value\n"

fn ComprehensionSource(): str =
    return "fn Resolve(x: int32): int32 =\n    let prefix = for x in x if x: x\n    let values = [x for x in x if x]\n    x\n"

fn PatternControlSource(): str =
    return "fn Resolve(value: int32, xs: int32[]): int32 =\n    for item in xs:\n        item\n    case value:\n        of Some(branch) if branch:\n            return branch\n    match value:\n        Some(arm) => return arm\n        _ => return 0\n    return case value: of Some(expr): expr else: 0\n"

fn main() =
    var err: str
    var tree: parser.ParserValueExprTree
    assert(parser.ParserValueExprReadTreeFromText(
               IdentitySource(), tree, err),
           Fmt"parser lexical binding identity: parse failed {err}")
    assert(parser.ParserValueExprTreeLexicalBindingAuthoritySealed(tree),
           "parser lexical binding identity: parsed authority is not sealed")
    assert(parser.ParserValueExprTreeLexicalBindingsStrictValidateInto(
               tree, err),
           Fmt"parser lexical binding identity: strict failed {err}")
    var parameterDeclaration: int32 = -1
    var outerDeclarations: int32[]
    for declarationRow in 0..<tree.declarationCount:
        let nameToken = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationNameTokenIndexes,
            declarationRow)
        let name = parser.ParserValueExprTokenText(tree, nameToken)
        let kind = parser.ParserDeclarationKind(
            arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.declarationKinds,
                declarationRow))
        if kind == parser.ParserDeclarationParameter && name == "input":
            parameterDeclaration = declarationRow
        elif kind == parser.ParserDeclarationLocal && name == "outer":
            add(outerDeclarations, declarationRow)
    assert(parameterDeclaration >= 0 && outerDeclarations.len == 2,
           "parser lexical binding identity: declaration rows missing")
    var parameterUseCount: int32
    var outerUseNodes: int32[]
    for nodeIndex in 0..<tree.nodeCount:
        if parser.ParserValueExprNodeKindAt(tree, nodeIndex) !=
               parser.ParserValueExprIdentifier:
            continue
        let name = parser.ParserValueExprNodeAtomText(tree, nodeIndex)
        let resolutionKind =
            parser.ParserValueExprBindingResolutionKind(
                arenamod.ArenaArrayInt32Get(
                    tree.arena,
                    tree.nodeBindingResolutionKinds,
                    nodeIndex))
        if name == "input":
            assert(resolutionKind ==
                       parser.ParserValueExprBindingResolutionParameter &&
                   arenamod.ArenaArrayInt32Get(
                       tree.arena,
                       tree.nodeResolvedBindingDeclarationRows,
                       nodeIndex) == parameterDeclaration &&
                   arenamod.ArenaArrayInt32Get(
                       tree.arena,
                       tree.nodeResolvedBindingPatternRows,
                       nodeIndex) == -1,
                   "parser lexical binding identity: parameter row mismatch")
            parameterUseCount = parameterUseCount + 1
        elif name == "outer":
            assert(resolutionKind ==
                       parser.ParserValueExprBindingResolutionPattern,
                   "parser lexical binding identity: pattern kind missing")
            add(outerUseNodes, nodeIndex)
    assert(parameterUseCount == 3 && outerUseNodes.len == 2,
           "parser lexical binding identity: identifier cardinality drift")
    let firstOuterDeclaration = arenamod.ArenaArrayInt32Get(
        tree.arena,
        tree.nodeResolvedBindingDeclarationRows,
        outerUseNodes[0])
    let secondOuterDeclaration = arenamod.ArenaArrayInt32Get(
        tree.arena,
        tree.nodeResolvedBindingDeclarationRows,
        outerUseNodes[1])
    assert(firstOuterDeclaration != secondOuterDeclaration &&
           firstOuterDeclaration == outerDeclarations[1] &&
           secondOuterDeclaration == outerDeclarations[0],
           "parser lexical binding identity: nested shadow rows collapsed")
    let firstOuterPattern = arenamod.ArenaArrayInt32Get(
        tree.arena,
        tree.nodeResolvedBindingPatternRows,
        outerUseNodes[0])
    let secondOuterPattern = arenamod.ArenaArrayInt32Get(
        tree.arena,
        tree.nodeResolvedBindingPatternRows,
        outerUseNodes[1])
    var outerBindingRows: int32[]
    for bindingRow in 0..<tree.lexicalBindingCount:
        let declarationRow = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.lexicalBindingDeclarationRows,
            bindingRow)
        if declarationRow == outerDeclarations[0] ||
           declarationRow == outerDeclarations[1]:
            add(outerBindingRows, bindingRow)
    assert(outerBindingRows.len == 2,
           "parser lexical binding identity: binding table rows missing")
    var swapped = parser.ParserValueExprTreeClone(tree)
    arenamod.ArenaArrayInt32Set(
        swapped.arena,
        swapped.nodeResolvedBindingDeclarationRows,
        outerUseNodes[0],
        secondOuterDeclaration)
    arenamod.ArenaArrayInt32Set(
        swapped.arena,
        swapped.nodeResolvedBindingPatternRows,
        outerUseNodes[0],
        secondOuterPattern)
    assert(!parser.ParserValueExprTreeLexicalBindingsStrictValidateInto(
               swapped, err) &&
           strings.StrContains(err, "exact row mismatch"),
           "parser lexical binding identity: same-name row swap accepted")
    var duplicate = parser.ParserValueExprTreeClone(tree)
    let outerBindingRow = outerBindingRows[0]
    let innerBindingRow = outerBindingRows[1]
    let outerScope = arenamod.ArenaArrayInt32Get(
        duplicate.arena,
        duplicate.lexicalBindingScopeRows,
        outerBindingRow)
    var innerBucket: int32 = -1
    var innerPrevious: int32 = -1
    var outerBucket: int32 = -1
    for bucketIndex in 0..<duplicate.lexicalBindingBucketCount:
        var previous: int32 = -1
        var bindingRow = arenamod.ArenaArrayInt32Get(
            duplicate.arena,
            duplicate.lexicalBindingBucketHeads,
            bucketIndex)
        while bindingRow >= 0:
            if bindingRow == innerBindingRow:
                innerBucket = bucketIndex
                innerPrevious = previous
            if bindingRow == outerBindingRow:
                outerBucket = bucketIndex
            previous = bindingRow
            bindingRow = arenamod.ArenaArrayInt32Get(
                duplicate.arena,
                duplicate.lexicalBindingNextRows,
                bindingRow)
    assert(innerBucket >= 0 && outerBucket >= 0,
           "parser lexical binding identity: bucket rows missing")
    let innerNext = arenamod.ArenaArrayInt32Get(
        duplicate.arena,
        duplicate.lexicalBindingNextRows,
        innerBindingRow)
    if innerPrevious < 0:
        arenamod.ArenaArrayInt32Set(
            duplicate.arena,
            duplicate.lexicalBindingBucketHeads,
            innerBucket,
            innerNext)
    else:
        arenamod.ArenaArrayInt32Set(
            duplicate.arena,
            duplicate.lexicalBindingNextRows,
            innerPrevious,
            innerNext)
    arenamod.ArenaArrayInt32Set(
        duplicate.arena,
        duplicate.lexicalBindingScopeRows,
        innerBindingRow,
        outerScope)
    arenamod.ArenaArrayInt32Set(
        duplicate.arena,
        duplicate.declarationLexicalScopeRows,
        outerDeclarations[1],
        outerScope)
    arenamod.ArenaArrayInt32Set(
        duplicate.arena,
        duplicate.patternOwnerLexicalScopeRows,
        firstOuterPattern,
        outerScope)
    arenamod.ArenaArrayInt32Set(
        duplicate.arena,
        duplicate.lexicalBindingNextRows,
        innerBindingRow,
        arenamod.ArenaArrayInt32Get(
            duplicate.arena,
            duplicate.lexicalBindingBucketHeads,
            outerBucket))
    arenamod.ArenaArrayInt32Set(
        duplicate.arena,
        duplicate.lexicalBindingBucketHeads,
        outerBucket,
        innerBindingRow)
    assert(!parser.ParserValueExprTreeLexicalBindingsStrictValidateInto(
               duplicate, err) &&
           strings.StrContains(err, "duplicate scope/name"),
           "parser lexical binding identity: duplicate table row accepted")
    var appended: parser.ParserValueExprTree
    parser.ParserValueExprTreeAppendFrom(appended, tree)
    assert(parser.ParserValueExprTreeLexicalBindingsStrictValidateInto(
               appended, err),
           Fmt"parser lexical binding identity: append remap failed {err}")
    var scopeTree: parser.ParserValueExprTree
    assert(parser.ParserValueExprReadTreeFromText(
               OutOfScopeSource(), scopeTree, err),
           Fmt"parser lexical binding identity: scope parse failed {err}")
    var hiddenResolvedCount: int32
    var hiddenUnresolvedCount: int32
    for nodeIndex in 0..<scopeTree.nodeCount:
        if parser.ParserValueExprNodeKindAt(scopeTree, nodeIndex) !=
               parser.ParserValueExprIdentifier ||
           parser.ParserValueExprNodeAtomText(scopeTree, nodeIndex) !=
               "hidden":
            continue
        let resolutionKind =
            parser.ParserValueExprBindingResolutionKind(
                arenamod.ArenaArrayInt32Get(
                    scopeTree.arena,
                    scopeTree.nodeBindingResolutionKinds,
                    nodeIndex))
        if resolutionKind ==
               parser.ParserValueExprBindingResolutionPattern:
            hiddenResolvedCount = hiddenResolvedCount + 1
        elif resolutionKind ==
             parser.ParserValueExprBindingResolutionNone:
            assert(arenamod.ArenaArrayInt32Get(
                       scopeTree.arena,
                       scopeTree.nodeResolvedBindingDeclarationRows,
                       nodeIndex) == -1 &&
                   arenamod.ArenaArrayInt32Get(
                       scopeTree.arena,
                       scopeTree.nodeResolvedBindingPatternRows,
                       nodeIndex) == -1,
                   "parser lexical binding identity: unresolved rows retained")
            hiddenUnresolvedCount = hiddenUnresolvedCount + 1
    assert(hiddenResolvedCount == 1 && hiddenUnresolvedCount == 1 &&
           parser.ParserValueExprTreeLexicalBindingsStrictValidateInto(
               scopeTree, err),
           "parser lexical binding identity: scope visibility drift")
    var comprehensionTree: parser.ParserValueExprTree
    assert(parser.ParserValueExprReadTreeFromText(
               ComprehensionSource(), comprehensionTree, err) &&
           parser.ParserValueExprTreeLexicalBindingAuthoritySealed(
               comprehensionTree),
           Fmt"parser lexical binding identity: comprehension parse failed {err}")
    var comprehensionParameterUses: int32
    var comprehensionPatternUses: int32
    var comprehensionOuterScope: int32 = -1
    var comprehensionPatternDeclarations: int32[]
    var comprehensionPatternDeclarationUseCounts: int32[]
    for nodeIndex in 0..<comprehensionTree.nodeCount:
        if parser.ParserValueExprNodeKindAt(
               comprehensionTree, nodeIndex) !=
               parser.ParserValueExprIdentifier ||
           parser.ParserValueExprNodeAtomText(
               comprehensionTree, nodeIndex) != "x":
            continue
        var scopeRow: int32
        var resolutionKind: parser.ParserValueExprBindingResolutionKind
        var declarationRow: int32
        var patternRow: int32
        assert(parser.ParserValueExprNodeBindingResolutionAt(
                   comprehensionTree,
                   nodeIndex,
                   scopeRow,
                   resolutionKind,
                   declarationRow,
                   patternRow),
               "parser lexical binding identity: atomic node receipt missing")
        if resolutionKind ==
               parser.ParserValueExprBindingResolutionParameter:
            assert(patternRow == -1 && declarationRow >= 0,
                   "parser lexical binding identity: comprehension outer parameter row invalid")
            if comprehensionOuterScope < 0:
                comprehensionOuterScope = scopeRow
            else:
                assert(scopeRow == comprehensionOuterScope,
                       "parser lexical binding identity: iterator node scope is not outer scope")
            comprehensionParameterUses =
                comprehensionParameterUses + 1
        elif resolutionKind ==
             parser.ParserValueExprBindingResolutionPattern:
            assert(patternRow >= 0 && declarationRow >= 0,
                   "parser lexical binding identity: comprehension pattern row invalid")
            var declarationSlot: int32 = -1
            for slot in 0..<comprehensionPatternDeclarations.len:
                if comprehensionPatternDeclarations[slot] == declarationRow:
                    declarationSlot = slot
                    break
            if declarationSlot < 0:
                add(comprehensionPatternDeclarations, declarationRow)
                add(comprehensionPatternDeclarationUseCounts, 1)
            else:
                comprehensionPatternDeclarationUseCounts[declarationSlot] =
                    comprehensionPatternDeclarationUseCounts[declarationSlot] +
                    1
            comprehensionPatternUses = comprehensionPatternUses + 1
    assert(comprehensionParameterUses == 3 &&
           comprehensionPatternUses == 4 &&
           comprehensionPatternDeclarations.len == 2 &&
           comprehensionPatternDeclarationUseCounts[0] == 2 &&
           comprehensionPatternDeclarationUseCounts[1] == 2,
           Fmt"parser lexical binding identity: comprehension timing drift parameter={comprehensionParameterUses} pattern={comprehensionPatternUses}")
    var controlTree: parser.ParserValueExprTree
    assert(parser.ParserValueExprReadTreeFromText(
               PatternControlSource(), controlTree, err) &&
           parser.ParserValueExprTreeLexicalBindingAuthoritySealed(
               controlTree),
           Fmt"parser lexical binding identity: pattern control parse failed {err}")
    var controlParameterUses: int32
    var controlPatternUses: int32
    for nodeIndex in 0..<controlTree.nodeCount:
        if parser.ParserValueExprNodeKindAt(controlTree, nodeIndex) !=
               parser.ParserValueExprIdentifier:
            continue
        let name = parser.ParserValueExprNodeAtomText(
            controlTree, nodeIndex)
        let resolutionKind =
            parser.ParserValueExprBindingResolutionKind(
                arenamod.ArenaArrayInt32Get(
                    controlTree.arena,
                    controlTree.nodeBindingResolutionKinds,
                    nodeIndex))
        if name == "value" || name == "xs":
            assert(resolutionKind ==
                       parser.ParserValueExprBindingResolutionParameter,
                   "parser lexical binding identity: control source lost outer parameter")
            controlParameterUses = controlParameterUses + 1
        elif name == "item" || name == "branch" ||
             name == "arm" || name == "expr":
            assert(resolutionKind ==
                       parser.ParserValueExprBindingResolutionPattern &&
                   arenamod.ArenaArrayInt32Get(
                       controlTree.arena,
                       controlTree.nodeResolvedBindingDeclarationRows,
                       nodeIndex) >= 0 &&
                   arenamod.ArenaArrayInt32Get(
                       controlTree.arena,
                       controlTree.nodeResolvedBindingPatternRows,
                       nodeIndex) >= 0,
                   Fmt"parser lexical binding identity: control pattern unresolved name={name}")
            controlPatternUses = controlPatternUses + 1
    assert(controlParameterUses == 4 && controlPatternUses == 5,
           Fmt"parser lexical binding identity: control timing drift parameter={controlParameterUses} pattern={controlPatternUses}")
    var rejectedTree: parser.ParserValueExprTree
    assert(!parser.ParserValueExprReadTreeFromText(
               SelfReferenceSource(), rejectedTree, err) &&
           strings.StrContains(err, "initializer self-reference"),
           "parser lexical binding identity: initializer self-reference accepted")
    echo("parser_lexical_binding_identity_smoke: ok")
