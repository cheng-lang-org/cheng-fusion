# Anchor recycle probe (game v0.2 long-session gap): the playground
# free-walk world runs ten consecutive capture gaits (a +x torso impulse
# per round, then settle until every footstep slot reports done). Without
# dynamic-queue anchor recycling each gait permanently consumed two
# World3d body slots and two StepPull constraint slots, so a long session
# panicked with "world3d: body capacity exceeded" at the 64-body limit.
# Assertions: zero rejected physics steps across the whole session, the
# body count peaks at the live-anchor plateau (standing count + the two
# concurrent capture anchors) and never approaches the 64-body capacity,
# the constraint count stays bounded, and every capture gait after the
# first round reuses exactly the anchor body slots the first round used
# (the entity id ledger balances to one id per acquire).
import cheng/game/csg/schema
import cheng/game/csg/validation
import cheng/game/csg/producer
import cheng/game/csg/materializer
import cheng/game/csg/execution
import cheng/game/world3d
import cheng/game/physics3d
import std/strings as strings

const
    ProbeRounds = 10
    ProbeSettleTick = 700
    ProbeKickMps = 1.20
    ProbeRoundGuard = 1500

fn runRecycle(): bool =
    var facts: schema.CsgWorldFacts = producer.CsgProducerBuildPlaygroundScene()
    var verdict = validation.CsgValidateFacts(facts)
    if verdict.statusCode != validation.CsgValidOk:
        echo("FAIL facts validation")
        return false
    var w: world3d.World3d
    var mp: materializer.CsgMaterializerMapping
    var err: str = ""
    if !materializer.CsgMaterialize(facts, w, mp, err):
        echo("FAIL materialize")
        return false
    var st: execution.CsgExecutionState
    execution.CsgExecutionInit(st, facts, w, mp.partSlot, mp.ropeNodeSlot)
    let dynStart: int32 = st.dynFootStart
    let nextId0: int32 = st.w.nextEntityId
    let pelvisSlot: int32 = mp.partSlot[0]
    let chestSlot: int32 = mp.partSlot[1]
    let headSlot: int32 = mp.partSlot[2]
    var maxCount: int32 = st.w.count
    var maxCons: int32 = st.w.conCount
    var tick: int32 = 0
    while tick < ProbeSettleTick:
        var receipt = execution.CsgExecutionTick(st, facts)
        if receipt.statusCode != physics3d.Physics3dStatusOk:
            echo("FAIL settle step rejected")
            echo("tick=" + strings.Int64ToStr(receipt.tick))
            return false
        if st.w.count > maxCount:
            maxCount = st.w.count
        if st.w.conCount > maxCons:
            maxCons = st.w.conCount
        tick = tick + 1
    let standCount: int32 = st.w.count
    let standCons: int32 = st.w.conCount
    var s: int32 = 0
    while s < st.footDone.len:
        if st.footDone[s] != 2:
            echo("FAIL settle unfinished footstep")
            echo("slot=" + strings.IntToStr(s))
            return false
        s = s + 1
    var poolA: int32 = -1
    var poolB: int32 = -1
    var round: int32 = 0
    while round < ProbeRounds:
        # impact: horizontal torso impulse along +x, past the capture
        # trigger (0.40 m/s CoM speed)
        st.w.bodyVx[pelvisSlot] = st.w.bodyVx[pelvisSlot] + ProbeKickMps
        st.w.bodyVx[chestSlot] = st.w.bodyVx[chestSlot] + ProbeKickMps
        st.w.bodyVx[headSlot] = st.w.bodyVx[headSlot] + ProbeKickMps
        let caps0: int32 = st.balCaptures
        let queueStart: int32 = st.footAnchor.len
        var guard: int32 = 0
        var allDone: int32 = 0
        while allDone == 0 && guard < ProbeRoundGuard:
            var receipt = execution.CsgExecutionTick(st, facts)
            if receipt.statusCode != physics3d.Physics3dStatusOk:
                echo("FAIL round step rejected")
                echo("round=" + strings.IntToStr(round))
                echo("tick=" + strings.Int64ToStr(receipt.tick))
                return false
            if st.w.count > maxCount:
                maxCount = st.w.count
            if st.w.conCount > maxCons:
                maxCons = st.w.conCount
            allDone = 1
            var si: int32 = 0
            while si < st.footDone.len:
                if st.footDone[si] != 2:
                    allDone = 0
                si = si + 1
            guard = guard + 1
        if allDone == 0:
            echo("FAIL round not settled")
            echo("round=" + strings.IntToStr(round))
            return false
        if st.balCaptures <= caps0:
            echo("FAIL capture never fired")
            echo("round=" + strings.IntToStr(round))
            return false
        # every gait this round injected must land on the recycled slot
        # pool (round 0 builds the pool; later rounds only reuse it)
        var qi: int32 = queueStart
        while qi < st.footAnchor.len:
            let a: int32 = st.footAnchor[qi]
            if a < 0:
                echo("FAIL gait anchor missing")
                echo("round=" + strings.IntToStr(round))
                echo("slot=" + strings.IntToStr(qi))
                return false
            if round == 0:
                if poolA < 0:
                    poolA = a
                if poolB < 0 && poolA != a:
                    poolB = a
            if a != poolA && a != poolB:
                echo("FAIL gait anchor not recycled")
                echo("round=" + strings.IntToStr(round))
                echo("anchor=" + strings.IntToStr(a))
                return false
            qi = qi + 1
        round = round + 1
    if st.rejectedCount != 0:
        echo("FAIL rejections")
        echo("n=" + strings.IntToStr(st.rejectedCount))
        return false
    if st.balCaptures < ProbeRounds:
        echo("FAIL capture count")
        echo("n=" + strings.IntToStr(st.balCaptures))
        return false
    # the body plateau: standing world plus the two concurrent capture
    # anchors, never one slot more, far below the 64-body capacity
    if maxCount != standCount + 2:
        echo("FAIL body plateau")
        echo("peak=" + strings.IntToStr(maxCount))
        echo("want=" + strings.IntToStr(standCount + 2))
        return false
    if maxCount > world3d.World3dMaxBodies:
        echo("FAIL body capacity")
        echo("peak=" + strings.IntToStr(maxCount))
        return false
    if maxCons != standCons + 2:
        echo("FAIL constraint plateau")
        echo("peak=" + strings.IntToStr(maxCons))
        echo("want=" + strings.IntToStr(standCons + 2))
        return false
    if maxCons > world3d.World3dMaxConstraints:
        echo("FAIL constraint capacity")
        echo("peak=" + strings.IntToStr(maxCons))
        return false
    # entity id ledger: every static station anchor consumed one id at
    # its spawn, and every dynamic gait step consumed exactly one id on
    # its acquire (real spawn or in-place recycle — both allocate the
    # next entity id), so the ledger must balance to this identity
    let expectIds: int32 = facts.stepPart.len + 2 * st.balCaptures
    let idGrowth: int32 = st.w.nextEntityId - nextId0
    if idGrowth != expectIds:
        echo("FAIL entity id ledger")
        echo("n=" + strings.IntToStr(idGrowth))
        echo("want=" + strings.IntToStr(expectIds))
        return false
    if poolB < 0:
        echo("FAIL anchor pool size")
        return false
    echo("rounds=" + strings.IntToStr(ProbeRounds))
    echo("captures=" + strings.IntToStr(st.balCaptures))
    echo("standing_bodies=" + strings.IntToStr(standCount))
    echo("peak_bodies=" + strings.IntToStr(maxCount))
    echo("peak_cons=" + strings.IntToStr(maxCons))
    echo("gait_slots=" + strings.IntToStr(st.footAnchor.len - dynStart))
    echo("anchor_slots_used=2")
    echo("entity_ids_used=" + strings.IntToStr(idGrowth))
    echo("rejected_steps=" + strings.IntToStr(st.rejectedCount))
    return true

fn main(): int32 =
    if !runRecycle():
        return 1
    echo("PASS anchor recycle probe")
    return 0
