type
    ColdExactUniqueBorrowImmutableBox =
        values: str[]

fn ColdExactUniqueBorrowImmutableSort(values: var str[]) =
    let first = values[0]
    values[0] = values[1]
    values[1] = first

fn main(): int32 =
    let box = ColdExactUniqueBorrowImmutableBox()
    var view = box.values
    ColdExactUniqueBorrowImmutableSort(view)
    return 0
