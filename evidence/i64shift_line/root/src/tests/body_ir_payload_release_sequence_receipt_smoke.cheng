import std/hashmaps as hashmaps
import cheng/core/ir/core_types as coreir
import cheng/core/ir/body_ir_lifecycle as lifecycle

fn BodyIrSequenceFull(seed: int32): coreir.BodyIR =
    var body = coreir.BodyIRNew()
    body.typeArenaArtifactCid.data[0] = uint8(seed & 255)
    body.typeFactTypeIds = [seed]
    body.typeFactStructuralKinds = [1]
    body.typeFactScalarKinds = [2]
    body.typeFactChildTypeIds = [-1]
    body.typeFactFixedLengths = [0]
    body.typeFactSizeBytes = [4]
    body.typeFactAlignBytes = [4]

    var op: coreir.BodyOp
    op.kind = coreir.BodyOpLoadConstTag
    op.target = 0
    op.valueDefSlot = 0
    op.valueDefExprNodeIndex = seed
    op.valueDefOwnership = coreir.OwnPlain
    op.valueDefOriginId = seed
    add(op.operands, seed)
    add(body.ops, op)

    var call: coreir.CallOp
    call.targetSymbol = "body_ir_release_target"
    call.targetSourcePath =
        "src/tests/body_ir_payload_release_sequence_receipt_smoke.cheng"
    call.resultSlot = 0
    add(call.argSlots, 0)
    add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(call.argAbiSizes, 4)
    add(body.callSequence, call)

    var slot: coreir.LocalSlot
    slot.id = 0
    slot.name = "body_ir_release_slot"
    slot.typeKind = coreir.LocalI32Tag
    slot.typeArenaTypeId = seed
    slot.managedStorageKind =
        coreir.BodyManagedStorageUnmanagedTag
    slot.placeKind = coreir.BodyPlaceStackValueTag
    slot.sizeBytes = 4
    slot.alignBytes = 4
    slot.ownership = coreir.OwnPlain
    slot.aliasClass = coreir.AliasNoAlias
    slot.escapeKind = coreir.EscapeNone
    add(body.localSlots, slot)
    hashmaps.HashMapStrIntPut(
        body.slotNameIndex, slot.name, slot.id)

    var term: coreir.BodyTerm
    term.kind = coreir.BodyTermReturnTag
    term.resultSlot = 0
    add(term.operands, 0)
    add(body.terms, term)

    var block: coreir.BodyBlock
    block.id = 0
    block.opStart = 0
    block.opCount = 1
    block.termIndex = 0
    add(body.blocks, block)

    var literal: coreir.CStringLiteralEntry
    literal.id = 0
    literal.text = "body-ir-release"
    literal.dataLabel = "__body_ir_release"
    add(body.cstringLiterals, literal)

    body.debugProvenanceRequired = true
    body.debugProvenanceComplete = true
    body.debugFunctionId = seed
    body.debugCurrentOpId = seed
    body.debugCurrentSyntheticKind =
        coreir.BodyDebugSyntheticNone
    add(body.debugOpIdsByOpIndex, seed)
    add(body.debugSyntheticKindsByOpIndex, 0)
    add(body.debugOpIdsByTermIndex, seed + 1)
    add(body.debugSyntheticKindsByTermIndex, 0)
    add(body.layoutLhsElide, false)
    add(body.layoutStoreElide, false)
    add(body.layoutCopySrcElide, false)
    add(body.layoutCmpFuse, -1)
    add(body.layoutCbrFuse, -1)
    add(body.x64SlotReadCnt, 1)
    add(body.x64BlockByteStart, 0)
    return body

fn BodyIrSequencePartial(seed: int32): coreir.BodyIR =
    var body = coreir.BodyIRNew()
    body.debugFunctionId = seed
    body.typeFactTypeIds = [seed]
    var op: coreir.BodyOp
    op.kind = coreir.BodyOpLoadConstTag
    add(op.operands, seed)
    add(body.ops, op)
    return body

fn BodyIrSequenceFixture(seed: int32): coreir.BodyIR[] =
    var bodies: coreir.BodyIR[]
    add(bodies, BodyIrSequenceFull(seed))
    add(bodies, BodyIrSequencePartial(seed + 10000))
    add(bodies, coreir.BodyIRNew())
    return bodies

fn BodyIrSequenceMutationNet(): bool =
    var left = BodyIrSequenceFixture(100)
    var right = BodyIrSequenceFixture(200)
    var leftState: lifecycle.BodyIrPayloadReleaseSequenceState
    var rightState: lifecycle.BodyIrPayloadReleaseSequenceState
    var leftReceipt: lifecycle.BodyIrPayloadReleaseSequenceReceipt
    var rightReceipt: lifecycle.BodyIrPayloadReleaseSequenceReceipt
    lifecycle.BodyIrPayloadReleaseSequenceWithReceipt(
        left, leftState, leftReceipt)
    lifecycle.BodyIrPayloadReleaseSequenceWithReceipt(
        right, rightState, rightReceipt)
    var err: str
    if lifecycle.BodyIrPayloadReleaseSequenceReceiptConsumeStrictInto(
           left, leftState, rightReceipt, err):
        return false
    var missingFunction = leftReceipt
    missingFunction.releasedFunctionCount =
        missingFunction.releasedFunctionCount - 1
    if lifecycle.BodyIrPayloadReleaseSequenceReceiptConsumeStrictInto(
           left, leftState, missingFunction, err):
        return false
    var missingBuffer = leftReceipt
    missingBuffer.releasedBufferCount =
        missingBuffer.releasedBufferCount - 1
    if lifecycle.BodyIrPayloadReleaseSequenceReceiptConsumeStrictInto(
           left, leftState, missingBuffer, err):
        return false
    var wrongBytes = leftReceipt
    wrongBytes.releasedBytes = wrongBytes.releasedBytes + int64(1)
    if lifecycle.BodyIrPayloadReleaseSequenceReceiptConsumeStrictInto(
           left, leftState, wrongBytes, err):
        return false
    var wrongToken = leftReceipt
    wrongToken.ownerToken.data[0] =
        uint8(Int32(wrongToken.ownerToken.data[0]) ^ 1)
    if lifecycle.BodyIrPayloadReleaseSequenceReceiptConsumeStrictInto(
           left, leftState, wrongToken, err):
        return false
    if !lifecycle.BodyIrPayloadReleaseSequenceReceiptConsumeStrictInto(
           left, leftState, leftReceipt, err):
        return false
    if lifecycle.BodyIrPayloadReleaseSequenceReceiptConsumeStrictInto(
           left, leftState, leftReceipt, err):
        return false
    return lifecycle.BodyIrPayloadReleaseSequenceReceiptConsumeStrictInto(
        right, rightState, rightReceipt, err)

fn BodyIrSequenceEmptyRelease(): bool =
    var bodies: coreir.BodyIR[]
    var state: lifecycle.BodyIrPayloadReleaseSequenceState
    var receipt: lifecycle.BodyIrPayloadReleaseSequenceReceipt
    lifecycle.BodyIrPayloadReleaseSequenceWithReceipt(
        bodies, state, receipt)
    var err: str
    return receipt.releasedFunctionCount == 0 &&
           receipt.releasedPayloadFunctionCount == 0 &&
           receipt.releasedBufferCount == 0 &&
           receipt.releasedBytes == int64(0) &&
           receipt.storageReleased &&
           lifecycle.BodyIrPayloadReleaseSequenceStorageReleased(
               bodies) &&
           lifecycle.BodyIrPayloadReleaseSequenceReceiptConsumeStrictInto(
               bodies, state, receipt, err)

fn main() =
    var allocatedBufferCount: int64
    var releasedBufferCount: int64
    var allocatedBytes: int64
    var releasedBytes: int64
    for iteration in 0..<1000:
        var bodies = BodyIrSequenceFixture(iteration + 1)
        let retained =
            lifecycle.BodyIrPayloadRetainedSequence(bodies)
        assert(retained.physicalBufferCount > 0 &&
               retained.retainedBytes > int64(0),
               "body ir sequence receipt: fixture storage missing")
        allocatedBufferCount =
            allocatedBufferCount +
            int64(retained.physicalBufferCount)
        allocatedBytes = allocatedBytes + retained.retainedBytes
        var state: lifecycle.BodyIrPayloadReleaseSequenceState
        var receipt: lifecycle.BodyIrPayloadReleaseSequenceReceipt
        lifecycle.BodyIrPayloadReleaseSequenceWithReceipt(
            bodies, state, receipt)
        assert(receipt.releasedFunctionCount == 3 &&
               receipt.releasedPayloadFunctionCount == 2 &&
               receipt.releasedBufferCount ==
                   retained.physicalBufferCount &&
               receipt.releasedBytes == retained.retainedBytes &&
               receipt.releasedManagedStringValueCount ==
                   retained.managedStringValueCount &&
               receipt.releasedManagedStringBytes ==
                   retained.managedStringBytes &&
               receipt.storageReleased &&
               lifecycle.BodyIrPayloadReleaseSequenceStorageReleased(
                   bodies),
               "body ir sequence receipt: release mismatch")
        var err: str
        assert(
            lifecycle.BodyIrPayloadReleaseSequenceReceiptConsumeStrictInto(
                bodies, state, receipt, err),
            err)
        releasedBufferCount =
            releasedBufferCount +
            int64(receipt.releasedBufferCount)
        releasedBytes = releasedBytes + receipt.releasedBytes
    assert(allocatedBufferCount == releasedBufferCount &&
           allocatedBytes == releasedBytes,
           "body ir sequence receipt: alloc/release mismatch")
    assert(BodyIrSequenceEmptyRelease(),
           "body ir sequence receipt: empty release mismatch")
    assert(BodyIrSequenceMutationNet(),
           "body ir sequence receipt: mutation accepted")
    echo("body_ir_sequence_release_iterations=1000")
    echo("body_ir_sequence_release_alloc_eq_release=1")
    echo("body_ir_sequence_release_live=0")
    echo("body_ir_sequence_release_mutations_rejected=1")
