fn ConcreteSeqRead(vals: str[], i: int32, out: var str): bool =
    out = vals[i]
    return true

fn main(): int32 =
    var vals: str[]
    setLen(vals, 4)
    vals[1] = "value-17"
    var out: str
    if !ConcreteSeqRead(vals, 1, out):
        return 41
    echo(out)
    if out == "value-17":
        return 0
    return 42
