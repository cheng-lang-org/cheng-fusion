type
    ColdGlobalSequenceElementOwner =
        count: int32
        names: str[]

var coldGlobalSequenceElementOwners: ColdGlobalSequenceElementOwner[]

fn coldGlobalSequenceElementMutate(
        owner: var ColdGlobalSequenceElementOwner) =
    owner.count = owner.count + 1

fn coldGlobalSequenceElementPublish() =
    setLen(coldGlobalSequenceElementOwners, 1)
    coldGlobalSequenceElementMutate(
        coldGlobalSequenceElementOwners[0])

fn main(): int32 =
    coldGlobalSequenceElementPublish()
    if coldGlobalSequenceElementOwners[0].count != 1:
        return 1
    return 0
