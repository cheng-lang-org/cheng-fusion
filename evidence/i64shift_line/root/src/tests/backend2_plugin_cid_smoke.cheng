# backend2_plugin_cid_smoke — S4-A 取件纯值层契约: CID 四元组 + receipt 同构 codec。
# spec: docs/cheng-csg-pickup-design.md §1/§3/§4/§6 S4-A; gate: tools/backend2_plugin_cid_gate.sh。
#
# 模式 (argv[1], 缺省 unit):
#   unit                — 正路径全断言: 非零 golden 向量冻结、确定性、四元组任一
#                         字段翻转 ⇒ CID 变化、IsZero 原语、
#                         receipt 构造守卫派生、Encode→Decode 往返恒等 (字段级+字节级)、
#                         VerifyGates 正路径、chain origin 往返。全绿输出 PLUGIN_CID_UNIT_OK。
#   tamper-artifact     — artifact 翻单字节 → 字节门必硬崩 (csg_pickup_byte_gate_mismatch 含 offset)。
#   tamper-count        — artifact 截一字节 → count 门硬崩 (csg_pickup_byte_gate_count_mismatch)。
#   tamper-cid-hex      — pickupCidHex 翻一个 hex 字符 → BindCheck 硬崩 (csg_pickup_cid_rebind_mismatch)。
#   tamper-quad         — 四元组字段 (contractVersion) 翻值 → BindCheck 硬崩 (同上)。
#   tamper-proof-local  — local receipt proofCid 翻一字节 → provenance 门硬崩 (csg_pickup_provenance_reject)。
#   guard-zero-closure / guard-zero-compiler — 零身份 → 构造守卫硬崩。
#   guard-empty-triple  — 空 triple → 构造守卫硬崩 (csg_pickup_cid_empty_target_triple)。
#   guard-bad-version   — contractVersion=0 → 构造守卫硬崩 (csg_pickup_cid_bad_contract_version)。
#   make-bad-origin     — origin=7 → Make 硬崩 (csg_pickup_receipt_bad_origin)。
#   make-chain-empty-signer — chain 空签发者 → Make 硬崩 (csg_pickup_provenance_empty_signer)。
#   err-truncated       — 多切点截断 → Decode 全显式 Err csg_pickup_receipt_truncated (rc=0)。
#   err-trailing        — 尾部多一字节 → Err csg_pickup_receipt_trailing_bytes (rc=0)。
#   err-bad-origin      — origin=7 线格式 → Err csg_pickup_receipt_bad_origin (rc=0)。
#   err-bad-tag         — 域标签翻一字节 → Err csg_pickup_receipt_bad_domain_tag (rc=0)。
#   err-bad-format      — 格式版本翻 1→2 → Err csg_pickup_receipt_bad_format_version (rc=0)。

import std/cmdline as cmdline
import std/result
import std/rawbytes
import cheng/std/bytes_layout as layout
import cheng/core/backend/codegen_contract as contract
import cheng/core/backend2/backend2_cid as b2cid
import cheng/core/backend2/backend2_plugin_cid as pcid

# ---- 夹具 ----

fn zeroFixed32(): layout.FixedBytes32 =
    var out: layout.FixedBytes32
    for i in 0..<32:
        out.data[i] = UInt8(0)
    return out

fn patternFixed32(seed: int32): layout.FixedBytes32 =
    var out: layout.FixedBytes32
    for i in 0..<32:
        out.data[i] = UInt8((seed + i * 7) & 255)
    return out

# local receipt: signer 恒 "local"; proofCid 由 Make 派生为 artifactSha256
# (自证), 实参零值仅占位, local 分支不消费。
fn buildLocalReceipt(triple: str): pcid.PluginPickupReceipt =
    var artifact = rawbytes.BytesFromString("cheng-plugin-artifact-fixture-v1")
    return pcid.PluginPickupReceiptMake(
        pcid.PluginPickupOriginLocal,
        patternFixed32(11), patternFixed32(23),
        triple, contract.CodegenContractVersion,
        artifact, "local", zeroFixed32())

fn assertReceiptEqual(a: var pcid.PluginPickupReceipt,
                      b: var pcid.PluginPickupReceipt,
                      label: str) =
    assert(a.origin == b.origin, label + " origin")
    assert(a.pickupCidHex == b.pickupCidHex, label + " pickupCidHex")
    assert(layout.FixedBytes32Equal(a.sourceClosureHash, b.sourceClosureHash),
        label + " sourceClosureHash")
    assert(layout.FixedBytes32Equal(a.compilerHash, b.compilerHash),
        label + " compilerHash")
    assert(a.targetTriple == b.targetTriple, label + " targetTriple")
    assert(a.contractVersion == b.contractVersion, label + " contractVersion")
    assert(a.artifactByteCount == b.artifactByteCount, label + " artifactByteCount")
    assert(layout.FixedBytes32Equal(a.artifactSha256, b.artifactSha256),
        label + " artifactSha256")
    assert(a.provenanceSignerId == b.provenanceSignerId, label + " provenanceSignerId")
    assert(layout.FixedBytes32Equal(a.provenanceProofCid, b.provenanceProofCid),
        label + " provenanceProofCid")

@borrows
fn decodeFresh(enc: rawbytes.Bytes): pcid.PluginPickupReceipt =
    var res = pcid.PluginPickupReceiptDecode(enc)
    if IsErr(res):
        panic("fixture decode failed")
    return Value(res)

@borrows
fn expectDecodeErr(data: rawbytes.Bytes, wantMsg: str, label: str) =
    var res = pcid.PluginPickupReceiptDecode(data)
    assert(IsErr(res), label + " must be Err")
    assert(Error(res) == wantMsg, label + " err msg")

# ---- 正路径 ----

fn runUnit(): int32 =
    assert(contract.CodegenContractVersion == 1, "contract version is 1 (S4-A epoch)")
    var artifact = rawbytes.BytesFromString("cheng-plugin-artifact-fixture-v1")

    # 可发布身份必须同时绑定非零 source closure 与真实 compiler hash。
    let cidFull = pcid.Backend2ComputePluginPickupCid(
        patternFixed32(11), patternFixed32(23), "arm64-apple-darwin",
        contract.CodegenContractVersion)
    assert(len(cidFull) == 64, "pickupCid is 64-hex sha256")
    let cidFullAgain = pcid.Backend2ComputePluginPickupCid(
        patternFixed32(11), patternFixed32(23), "arm64-apple-darwin",
        contract.CodegenContractVersion)
    assert(cidFullAgain == cidFull, "pickup cid deterministic")

    # IsZero 原语逐字节识别；零身份的拒绝由独立 hard-fail 腿覆盖。
    assert(b2cid.Backend2CidFixed32IsZero(zeroFixed32()), "zero fixed32 recognized")
    assert(!b2cid.Backend2CidFixed32IsZero(patternFixed32(3)),
        "non-zero fixed32 recognized")

    # 四元组任一字段翻转 ⇒ CID 变化
    let cidClosure = pcid.Backend2ComputePluginPickupCid(
        patternFixed32(12), patternFixed32(23), "arm64-apple-darwin",
        contract.CodegenContractVersion)
    assert(cidClosure != cidFull, "closure hash flip changes cid")
    let cidCompiler = pcid.Backend2ComputePluginPickupCid(
        patternFixed32(11), patternFixed32(24), "arm64-apple-darwin",
        contract.CodegenContractVersion)
    assert(cidCompiler != cidFull, "compiler hash flip changes cid")
    let cidTriple = pcid.Backend2ComputePluginPickupCid(
        patternFixed32(11), patternFixed32(23), "x86_64-unknown-linux-gnu",
        contract.CodegenContractVersion)
    assert(cidTriple != cidFull, "target triple flips cid")
    let cidVersion = pcid.Backend2ComputePluginPickupCid(
        patternFixed32(11), patternFixed32(23), "arm64-apple-darwin",
        contract.CodegenContractVersion + 1)
    assert(cidVersion != cidFull, "contract version flips cid")
    echo(Fmt"golden cid_full={cidFull}")
    # 非零夹具 golden，经独立 sha256 实现交叉验证。
    assert(cidFull == "35e02d9880474ffb6fdf835e0c2b6cea3e3b413b7c5f9983b7e9de79a46d309f",
        "golden full-fixture pickupCid frozen (S4-A)")

    # receipt 构造 (local): 字节门锚点 + 自证 provenance 派生
    var receipt = pcid.PluginPickupReceiptMake(
        pcid.PluginPickupOriginLocal,
        patternFixed32(11), patternFixed32(23), "arm64-apple-darwin",
        contract.CodegenContractVersion, artifact, "local", zeroFixed32())
    assert(receipt.pickupCidHex == cidFull, "receipt cid matches quad recompute")
    assert(receipt.artifactByteCount == rawbytes.BytesLen(artifact),
        "byte count anchored")
    assert(layout.FixedBytes32Equal(
        receipt.artifactSha256, pcid.Backend2ContentSha256OfBytes(artifact)),
        "artifact sha256 anchored")
    assert(layout.FixedBytes32Equal(
        receipt.provenanceProofCid, receipt.artifactSha256),
        "local proof cid is self-proof")
    assert(receipt.provenanceSignerId == "local", "local signer fixed")

    # 同构 codec: 序列化 → 解析往返恒等 (字段级 + 字节级)
    var encA = pcid.PluginPickupReceiptEncode(receipt)
    var encB = pcid.PluginPickupReceiptEncode(receipt)
    var dec = decodeFresh(encA)
    assertReceiptEqual(dec, receipt, "roundtrip")
    var encC = pcid.PluginPickupReceiptEncode(dec)
    assert(rawbytes.BytesEqual(encB, encC), "encode(decode(encode)) byte-identical")
    rawbytes.BytesFree(encA)
    rawbytes.BytesFree(encB)
    rawbytes.BytesFree(encC)

    # 门正路径: bind → 字节门 → provenance 全过 (不 panic 即证)
    pcid.PluginPickupReceiptBindCheck(receipt)
    pcid.PluginPickupVerifyGates(artifact, receipt)

    # chain origin: 结构 provenance (非空签发者 + 非零 proofCid) + 同构往返
    var chainReceipt = pcid.PluginPickupReceiptMake(
        pcid.PluginPickupOriginChain,
        patternFixed32(11), patternFixed32(23), "x86_64-unknown-linux-gnu",
        contract.CodegenContractVersion, artifact, "csg-signer-alpha",
        patternFixed32(41))
    var chainEnc = pcid.PluginPickupReceiptEncode(chainReceipt)
    var chainDec = decodeFresh(chainEnc)
    assertReceiptEqual(chainDec, chainReceipt, "chain roundtrip")
    pcid.PluginPickupVerifyGates(artifact, chainDec)
    rawbytes.BytesFree(chainEnc)

    echo("PLUGIN_CID_UNIT_OK")
    return 0

# ---- 篡改必拒 (panic 路径, rc!=0 + stderr 标记) ----

fn runTamperArtifact(): int32 =
    var artifact = rawbytes.BytesFromString("cheng-plugin-artifact-fixture-v1")
    var receipt = buildLocalReceipt("arm64-apple-darwin")
    var tampered = rawbytes.BytesSlice(artifact, 0, rawbytes.BytesLen(artifact))
    rawbytes.BytesSet(tampered, 0, (rawbytes.BytesGet(tampered, 0) + 1) & 255)
    # 门 c: sha256 抗碰撞下单字节改动必落网
    pcid.PluginPickupVerifyGates(tampered, receipt)
    echo("PLUGIN_CID_TAMPER_ARTIFACT_NOT_CAUGHT")
    return 1

fn runTamperCount(): int32 =
    var artifact = rawbytes.BytesFromString("cheng-plugin-artifact-fixture-v1")
    var receipt = buildLocalReceipt("arm64-apple-darwin")
    var tampered = rawbytes.BytesSlice(artifact, 0, rawbytes.BytesLen(artifact) - 1)
    pcid.PluginPickupVerifyGates(tampered, receipt)
    echo("PLUGIN_CID_TAMPER_COUNT_NOT_CAUGHT")
    return 1

fn runTamperCidHex(): int32 =
    var receipt = buildLocalReceipt("arm64-apple-darwin")
    var enc = pcid.PluginPickupReceiptEncode(receipt)
    var dec = decodeFresh(enc)
    rawbytes.BytesFree(enc)
    # 翻 pickupCidHex 首字符 (保持合法 hex, 过解码层, 门 b 重算必失配)
    var hexCopy = rawbytes.BytesSlice(
        rawbytes.BytesFromString(dec.pickupCidHex), 0, 64)
    if rawbytes.BytesGet(hexCopy, 0) == Int32('f'):
        rawbytes.BytesSet(hexCopy, 0, Int32('e'))
    else:
        rawbytes.BytesSet(hexCopy, 0, Int32('f'))
    dec.pickupCidHex = rawbytes.BytesToString(hexCopy)
    rawbytes.BytesFree(hexCopy)
    pcid.PluginPickupReceiptBindCheck(dec)
    echo("PLUGIN_CID_TAMPER_CID_HEX_NOT_CAUGHT")
    return 1

fn runTamperQuad(): int32 =
    var receipt = buildLocalReceipt("arm64-apple-darwin")
    var enc = pcid.PluginPickupReceiptEncode(receipt)
    var dec = decodeFresh(enc)
    rawbytes.BytesFree(enc)
    # 半吊子篡改: 单独把版本号字段改大, 门 b 双重校验必失配 (§5.3)
    dec.contractVersion = dec.contractVersion + 1
    pcid.PluginPickupReceiptBindCheck(dec)
    echo("PLUGIN_CID_TAMPER_QUAD_NOT_CAUGHT")
    return 1

fn runTamperProofLocal(): int32 =
    var artifact = rawbytes.BytesFromString("cheng-plugin-artifact-fixture-v1")
    var receipt = buildLocalReceipt("arm64-apple-darwin")
    var enc = pcid.PluginPickupReceiptEncode(receipt)
    var dec = decodeFresh(enc)
    rawbytes.BytesFree(enc)
    # 伪造 provenance: proofCid 翻一字节 (bind/字节门不受影响, 门 d 必硬崩)
    dec.provenanceProofCid.data[0] = UInt8(
        (Int32(dec.provenanceProofCid.data[0]) + 1) & 255)
    pcid.PluginPickupVerifyGates(artifact, dec)
    echo("PLUGIN_CID_TAMPER_PROOF_NOT_CAUGHT")
    return 1

fn runGuardEmptyTriple(): int32 =
    pcid.Backend2ComputePluginPickupCid(
        patternFixed32(11), patternFixed32(23), "", contract.CodegenContractVersion)
    echo("PLUGIN_CID_EMPTY_TRIPLE_NOT_CAUGHT")
    return 1

fn runGuardBadVersion(): int32 =
    pcid.Backend2ComputePluginPickupCid(
        patternFixed32(11), patternFixed32(23), "arm64-apple-darwin", 0)
    echo("PLUGIN_CID_BAD_VERSION_NOT_CAUGHT")
    return 1

fn runMakeBadOrigin(): int32 =
    var artifact = rawbytes.BytesFromString("cheng-plugin-artifact-fixture-v1")
    pcid.PluginPickupReceiptMake(
        7, patternFixed32(11), patternFixed32(23), "arm64-apple-darwin",
        contract.CodegenContractVersion, artifact, "local", zeroFixed32())
    echo("PLUGIN_CID_BAD_ORIGIN_NOT_CAUGHT")
    return 1

fn runMakeChainEmptySigner(): int32 =
    var artifact = rawbytes.BytesFromString("cheng-plugin-artifact-fixture-v1")
    pcid.PluginPickupReceiptMake(
        pcid.PluginPickupOriginChain,
        patternFixed32(11), patternFixed32(23), "arm64-apple-darwin",
        contract.CodegenContractVersion, artifact, "", patternFixed32(41))
    echo("PLUGIN_CID_EMPTY_SIGNER_NOT_CAUGHT")
    return 1

fn runGuardZeroClosure(): int32 =
    pcid.Backend2ComputePluginPickupCid(
        zeroFixed32(), patternFixed32(23), "arm64-apple-darwin",
        contract.CodegenContractVersion)
    echo("PLUGIN_CID_ZERO_CLOSURE_NOT_CAUGHT")
    return 1

fn runGuardZeroCompiler(): int32 =
    pcid.Backend2ComputePluginPickupCid(
        patternFixed32(11), zeroFixed32(), "arm64-apple-darwin",
        contract.CodegenContractVersion)
    echo("PLUGIN_CID_ZERO_COMPILER_NOT_CAUGHT")
    return 1

fn runErrZeroCompiler(): int32 =
    var receipt = buildLocalReceipt("arm64-apple-darwin")
    receipt.compilerHash = zeroFixed32()
    var enc = pcid.PluginPickupReceiptEncode(receipt)
    expectDecodeErr(enc,
        "csg_pickup_receipt_zero_closure_or_compiler_hash",
        "zero compiler hash")
    rawbytes.BytesFree(enc)
    echo("PLUGIN_CID_ZERO_COMPILER_ERR_OK")
    return 0

# ---- 严格解码 (显式 Err 路径, rc=0) ----

fn runErrTruncated(): int32 =
    var receipt = buildLocalReceipt("arm64-apple-darwin")
    var enc = pcid.PluginPickupReceiptEncode(receipt)
    let n = rawbytes.BytesLen(enc)
    var cuts: int32[]
    add(cuts, 0)
    add(cuts, 3)
    add(cuts, 4)
    add(cuts, n / 2)
    add(cuts, n - 1)
    for i in 0..<cuts.len:
        var piece = rawbytes.BytesSlice(enc, 0, cuts[i])
        expectDecodeErr(piece, "csg_pickup_receipt_truncated", "truncated")
        rawbytes.BytesFree(piece)
    rawbytes.BytesFree(enc)
    echo("PLUGIN_CID_TRUNCATED_ERR_OK")
    return 0

fn runErrTrailing(): int32 =
    var receipt = buildLocalReceipt("arm64-apple-darwin")
    var enc = pcid.PluginPickupReceiptEncode(receipt)
    var bloated = rawbytes.BytesConcat(enc, rawbytes.BytesFromString("x"))
    expectDecodeErr(bloated, "csg_pickup_receipt_trailing_bytes", "trailing")
    rawbytes.BytesFree(enc)
    rawbytes.BytesFree(bloated)
    echo("PLUGIN_CID_TRAILING_ERR_OK")
    return 0

fn runErrBadOrigin(): int32 =
    var receipt = buildLocalReceipt("arm64-apple-darwin")
    var enc = pcid.PluginPickupReceiptEncode(receipt)
    var dec = decodeFresh(enc)
    rawbytes.BytesFree(enc)
    dec.origin = 7
    # Encode 不校验 origin (缺一拒收落在解码层, §3 同构性机械保证 ①)
    var enc2 = pcid.PluginPickupReceiptEncode(dec)
    expectDecodeErr(enc2, "csg_pickup_receipt_bad_origin", "bad origin")
    rawbytes.BytesFree(enc2)
    echo("PLUGIN_CID_BAD_ORIGIN_ERR_OK")
    return 0

fn runErrBadTag(): int32 =
    var receipt = buildLocalReceipt("arm64-apple-darwin")
    var enc = pcid.PluginPickupReceiptEncode(receipt)
    rawbytes.BytesSet(enc, 4, Int32('X'))
    expectDecodeErr(enc, "csg_pickup_receipt_bad_domain_tag", "bad tag")
    rawbytes.BytesFree(enc)
    echo("PLUGIN_CID_BAD_TAG_ERR_OK")
    return 0

fn runErrBadFormat(): int32 =
    var receipt = buildLocalReceipt("arm64-apple-darwin")
    var enc = pcid.PluginPickupReceiptEncode(receipt)
    # 格式版本紧随域标签: 4B 长度前缀 + tag 字节
    let off = 4 + len("cheng.backend2.plugin.receipt")
    rawbytes.BytesSet(enc, off, 2)
    expectDecodeErr(enc, "csg_pickup_receipt_bad_format_version", "bad format")
    rawbytes.BytesFree(enc)
    echo("PLUGIN_CID_BAD_FORMAT_ERR_OK")
    return 0

fn main(argc: int32, argv: str*): int32 =
    argc
    argv
    cmdline.CaptureCmdLine(argc, argv)
    var mode = ""
    if cmdline.ParamCount() >= 1:
        mode = cmdline.ParamStr(1)
    if mode == "" || mode == "unit":
        return runUnit()
    if mode == "tamper-artifact":
        return runTamperArtifact()
    if mode == "tamper-count":
        return runTamperCount()
    if mode == "tamper-cid-hex":
        return runTamperCidHex()
    if mode == "tamper-quad":
        return runTamperQuad()
    if mode == "tamper-proof-local":
        return runTamperProofLocal()
    if mode == "guard-empty-triple":
        return runGuardEmptyTriple()
    if mode == "guard-zero-closure":
        return runGuardZeroClosure()
    if mode == "guard-zero-compiler":
        return runGuardZeroCompiler()
    if mode == "guard-bad-version":
        return runGuardBadVersion()
    if mode == "make-bad-origin":
        return runMakeBadOrigin()
    if mode == "make-chain-empty-signer":
        return runMakeChainEmptySigner()
    if mode == "err-truncated":
        return runErrTruncated()
    if mode == "err-trailing":
        return runErrTrailing()
    if mode == "err-bad-origin":
        return runErrBadOrigin()
    if mode == "err-bad-tag":
        return runErrBadTag()
    if mode == "err-bad-format":
        return runErrBadFormat()
    if mode == "err-zero-compiler":
        return runErrZeroCompiler()
    echo("PLUGIN_CID_UNKNOWN_MODE")
    return 2
