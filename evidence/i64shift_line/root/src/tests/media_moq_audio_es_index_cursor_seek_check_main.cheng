# Runtime verification for S7 slice1 (video-seek-scrub-blueprint.md §7.1 选项 A, 音频 ES
# 化 — 桥接/索引层, 用户已拍板选项 A), added to web_scene_media_network_bridge.cheng
# (aidx 解析 / 音频 pump 游标 / seek 对齐换算) and web_scene_media_block_cache.cheng
# (音频并行 key)。播放器接线是下一切片，这里只验证索引+游标+seek 对齐这条纯逻辑链，
# 因此不需要真实 QUIC 发布端：所有断言直接对着真实的 maitian.aidx 磁盘字节跑，走的是
# WebSceneMediaAudioEsOpen 网络路径在拿到字节之后完全相同的解析/建态代码
# （WebSceneMediaAudioEsAdoptIndexBytes 就是那段代码本体，从 Open 里原样搬出来的，不是
# 另一套影子实现）。
#
# aidx 头字段的独立 oracle 来自本次会话对同一份文件的 python3 struct.unpack 直接解析
# （sr=48000 ch=2 profile=2 count=259 total=134675，32B 头 + 259*8B 表 = 2104B，与文件
# 实际大小吻合）——不是这个 Cheng 解析器自证自己的答案。video fps=60 同理来自对
# maitian.moqidx 的独立 struct.unpack（fpsNum=60 fpsDen=1）。
#
# 断言列表（>=6，实际 15 条）：
#   1-2.  IndexMagicValid: 真实字节 true / 首字节被篡改后 false（不静默通过坏头）
#   3-6.  IndexSampleRate/Channels/Profile/FrameCount 对真实 maitian.aidx 四个头字段
#   7.    AdoptIndexBytes 篡改字节返回 false（不留半开状态：openFlag 仍为此前值）
#   8-11. AdoptIndexBytes 真实字节返回 true，且已有的公开 getter
#         (FrameCount/SampleRate/Channels/Profile) 全部反映同一份状态（不是自说自话）
#   12.   Adopt 后游标复位为 0
#   13.   AdvanceCursor 连续推进的返回值单调递增
#   14.   AdvanceCursor 在末尾(frames-1)返回 -1 且游标不再前移（边界）
#   15-19 seek 对齐换算精度：frame0/中段/末段 clamp/负数 clamp/fps<=0 防御，五个真实数
#         值用例（其中中段与 clamp 值是相对真实 fps=60/sr=48000/count=259 手工独立算出，
#         不是让被测函数自己验自己）
#   20-21 块缓存并行 key 无冲突：同一 assetCid 下视频 key=96 与音频 key=96 数值相同，
#         写入不同 payload，各自 Get 精确取回，互不覆盖/互不污染
#
# Any failure prints a reason and exits nonzero; success prints "ALL OK" and exits 0.

import std/os
import std/result
import std/rawbytes
import std/strings as strs
import std/strutils as strutil
import std/cmdline as cmdline
import cheng/core/runtime/web_scene_media_network_bridge as media_bridge
import cheng/core/runtime/web_scene_media_block_cache as blockcache

fn fail(msg: str): int32 =
    os.WriteLine(os.Get_stdout(), strutil.Join(["FAIL: ", msg], ""))
    return 1

fn ok(step: str): void =
    os.WriteLine(os.Get_stdout(), step)

# Real maitian.aidx bytes with byte 0 of the "MQAS" magic flipped — the ONE bad-header
# case the cold-miss precedent (media_moq_block_cache_roundtrip_check_main.cheng) asks
# for: a malformed blob must be rejected, not silently accepted with garbage fields.
fn corruptMagic(src: Bytes): Bytes =
    let n: int32 = rawbytes.BytesLen(src)
    var out: Bytes = rawbytes.BytesAlloc(n)
    var i: int32
    while i < n:
        rawbytes.BytesSet(out, i, rawbytes.BytesGet(src, i))
        i = i + 1
    rawbytes.BytesSet(out, 0, 0)
    return out

fn main(): int32 =
    var aidxPathRaw: str
    let hasAidx: bool = cmdline.ReadFirstFlagValue("--aidx", aidxPathRaw)
    if !hasAidx:
        return fail("missing --aidx <path to real maitian.aidx>")
    var rootRaw: str
    let hasRoot: bool = cmdline.ReadFirstFlagValue("--root", rootRaw)
    if !hasRoot:
        return fail("missing --root <block cache scratch dir>")
    var assetCidRaw: str
    let hasAssetCid: bool = cmdline.ReadFirstFlagValue("--asset-cid", assetCidRaw)
    let assetCid: str = if hasAssetCid: assetCidRaw else: "s7a-test-asset"

    let readRes: Result[Bytes] = os.ReadFileBytesResult(aidxPathRaw)
    if IsErr(readRes):
        return fail(strutil.Join(["failed reading --aidx ", aidxPathRaw, ": ", Error(readRes)], ""))
    let idxData: Bytes = Value(readRes)
    if rawbytes.BytesLen(idxData) != 2104:
        return fail(strutil.Join(["real maitian.aidx unexpected size: got=",
                                   strs.IntToStr(rawbytes.BytesLen(idxData)), " want=2104"], ""))
    ok("step0_fixture_size_ok")

    # 1-2. Magic validity: real bytes true, corrupted copy false.
    if !media_bridge.WebSceneMediaAudioEsIndexMagicValid(idxData):
        return fail("IndexMagicValid(real maitian.aidx) = false, want true")
    ok("step1_magic_valid_real_ok")
    let corrupted: Bytes = corruptMagic(idxData)
    if media_bridge.WebSceneMediaAudioEsIndexMagicValid(corrupted):
        return fail("IndexMagicValid(corrupted) = true, want false")
    ok("step2_magic_invalid_corrupted_ok")

    # 3-6. Header fields against the independent python3 struct.unpack oracle.
    let sr: int32 = media_bridge.WebSceneMediaAudioEsIndexSampleRate(idxData)
    if sr != 48000:
        return fail(strutil.Join(["IndexSampleRate=", strs.IntToStr(sr), " want=48000"], ""))
    let ch: int32 = media_bridge.WebSceneMediaAudioEsIndexChannels(idxData)
    if ch != 2:
        return fail(strutil.Join(["IndexChannels=", strs.IntToStr(ch), " want=2"], ""))
    let profile: int32 = media_bridge.WebSceneMediaAudioEsIndexProfile(idxData)
    if profile != 2:
        return fail(strutil.Join(["IndexProfile=", strs.IntToStr(profile), " want=2 (AAC-LC)"], ""))
    let frameCount: int32 = media_bridge.WebSceneMediaAudioEsIndexFrameCount(idxData)
    if frameCount != 259:
        return fail(strutil.Join(["IndexFrameCount=", strs.IntToStr(frameCount), " want=259"], ""))
    ok("step3_header_fields_match_oracle_ok")

    # 7. AdoptIndexBytes on the corrupted copy must reject, not half-open.
    if media_bridge.WebSceneMediaAudioEsAdoptIndexBytes(corrupted):
        return fail("AdoptIndexBytes(corrupted) = true, want false")
    if media_bridge.WebSceneMediaAudioEsFrameCount() != 0:
        return fail("AdoptIndexBytes(corrupted) left open state non-zero (half-open)")
    ok("step4_adopt_rejects_corrupted_ok")

    # 8-11. AdoptIndexBytes on the real bytes must succeed and the ALREADY-EXISTING public
    # getters (not new test-only accessors) must reflect the same fields just checked above.
    if !media_bridge.WebSceneMediaAudioEsAdoptIndexBytes(idxData):
        return fail("AdoptIndexBytes(real maitian.aidx) = false, want true")
    if media_bridge.WebSceneMediaAudioEsFrameCount() != 259:
        return fail(strutil.Join(["FrameCount() after adopt=", strs.IntToStr(media_bridge.WebSceneMediaAudioEsFrameCount()), " want=259"], ""))
    if media_bridge.WebSceneMediaAudioSampleRate() != 48000:
        return fail("SampleRate() after adopt != 48000")
    if media_bridge.WebSceneMediaAudioChannels() != 2:
        return fail("Channels() after adopt != 2")
    if media_bridge.WebSceneMediaAudioProfile() != 2:
        return fail("Profile() after adopt != 2")
    ok("step5_adopt_real_and_getters_consistent_ok")

    # 12. Cursor resets to 0 on adopt.
    if media_bridge.WebSceneMediaAudioEsPumpCursor() != 0:
        return fail("pump cursor after adopt != 0")
    ok("step6_cursor_reset_ok")

    # 13. AdvanceCursor monotonic sequence.
    var i: int32 = 1
    while i <= 5:
        let got: int32 = media_bridge.WebSceneMediaAudioEsAdvanceCursor()
        if got != i:
            return fail(strutil.Join(["AdvanceCursor step=", strs.IntToStr(i), " got=", strs.IntToStr(got), " want=", strs.IntToStr(i)], ""))
        i = i + 1
    if media_bridge.WebSceneMediaAudioEsPumpCursor() != 5:
        return fail("pump cursor after 5 advances != 5")
    ok("step7_advance_monotonic_ok")

    # 14. Boundary: keep advancing from the current cursor (5, from step 13) all the way to
    # the last frame (frameCount-1); one more advance past that must report -1 and the
    # cursor must NOT move past the last valid index.
    var j: int32 = 5
    while j < frameCount - 1:
        let step: int32 = media_bridge.WebSceneMediaAudioEsAdvanceCursor()
        if step == -1:
            return fail(strutil.Join(["AdvanceCursor returned -1 early at cursor=", strs.IntToStr(media_bridge.WebSceneMediaAudioEsPumpCursor())], ""))
        j = j + 1
    if media_bridge.WebSceneMediaAudioEsPumpCursor() != frameCount - 1:
        return fail(strutil.Join(["cursor before boundary check=", strs.IntToStr(media_bridge.WebSceneMediaAudioEsPumpCursor()),
                                   " want=", strs.IntToStr(frameCount - 1)], ""))
    let atEnd: int32 = media_bridge.WebSceneMediaAudioEsAdvanceCursor()
    if atEnd != -1:
        return fail(strutil.Join(["AdvanceCursor at last frame returned=", strs.IntToStr(atEnd), " want=-1"], ""))
    if media_bridge.WebSceneMediaAudioEsPumpCursor() != frameCount - 1:
        return fail("cursor moved past frameCount-1 after end-of-stream AdvanceCursor")
    ok("step8_advance_end_of_stream_boundary_ok")

    # 15-19. Seek-alignment math, pure form, against real fps=60 (maitian.moqidx, independent
    # python3 struct.unpack this session: fpsNum=60 fpsDen=1) / real sr=48000 / real count=259.
    let videoFps: int32 = 60
    let e0: int32 = media_bridge.WebSceneMediaAudioFrameIndexForVideoFrameEx(0, videoFps, sr, frameCount)
    if e0 != 0:
        return fail(strutil.Join(["Ex(videoFrame=0)=", strs.IntToStr(e0), " want=0"], ""))
    # 150/60s * 48000Hz = 120000 samples; /1024 samples-per-AU = 117.1875 -> floor 117.
    let e150: int32 = media_bridge.WebSceneMediaAudioFrameIndexForVideoFrameEx(150, videoFps, sr, frameCount)
    if e150 != 117:
        return fail(strutil.Join(["Ex(videoFrame=150)=", strs.IntToStr(e150), " want=117"], ""))
    # 332/60s (last video frame of a 333-frame clip) * 48000Hz = 265600 samples; /1024 =
    # 259.375 -> floor 259, clamped to frameCount-1=258 (audio track is slightly shorter).
    let e332: int32 = media_bridge.WebSceneMediaAudioFrameIndexForVideoFrameEx(332, videoFps, sr, frameCount)
    if e332 != frameCount - 1:
        return fail(strutil.Join(["Ex(videoFrame=332)=", strs.IntToStr(e332), " want=", strs.IntToStr(frameCount - 1), " (clamp)"], ""))
    let eNeg: int32 = media_bridge.WebSceneMediaAudioFrameIndexForVideoFrameEx(0 - 5, videoFps, sr, frameCount)
    if eNeg != 0:
        return fail(strutil.Join(["Ex(videoFrame=-5)=", strs.IntToStr(eNeg), " want=0 (negative clamp)"], ""))
    let eBadFps: int32 = media_bridge.WebSceneMediaAudioFrameIndexForVideoFrameEx(150, 0, sr, frameCount)
    if eBadFps != 0:
        return fail(strutil.Join(["Ex(videoFps=0)=", strs.IntToStr(eBadFps), " want=0 (defensive)"], ""))
    ok("step9_seek_alignment_math_ok")

    # 20-21. Block cache parallel key: video key=96 and audio key=96 (same assetCid, same
    # numeric index on purpose) must not collide — distinct payloads, exact round-trip.
    if !blockcache.WebSceneMediaBlockCacheInit(rootRaw):
        return fail(strutil.Join(["blockcache Init(", rootRaw, ") failed"], ""))
    var videoPayload: Bytes = rawbytes.BytesAlloc(32)
    var audioPayload: Bytes = rawbytes.BytesAlloc(32)
    var k: int32
    while k < 32:
        rawbytes.BytesSet(videoPayload, k, (k * 7 + 1) % 256)
        rawbytes.BytesSet(audioPayload, k, (k * 13 + 3) % 256)
        k = k + 1
    if !blockcache.WebSceneMediaBlockCachePut(assetCid, 96, videoPayload):
        return fail("BlockCachePut(video, key=96) failed")
    if !blockcache.WebSceneMediaBlockCachePutAudio(assetCid, 96, audioPayload):
        return fail("BlockCachePutAudio(audio, key=96) failed")
    let gotVideo: Result[Bytes] = blockcache.WebSceneMediaBlockCacheGet(assetCid, 96)
    if IsErr(gotVideo):
        return fail("BlockCacheGet(video, key=96) after Put returned Err")
    let vb: Bytes = Value(gotVideo)
    if rawbytes.BytesLen(vb) != 32 || rawbytes.BytesGet(vb, 0) != 1 || rawbytes.BytesGet(vb, 31) != (31 * 7 + 1) % 256:
        return fail("video block content wrong after audio Put with the same numeric key — collision")
    let gotAudio: Result[Bytes] = blockcache.WebSceneMediaBlockCacheGetAudio(assetCid, 96)
    if IsErr(gotAudio):
        return fail("BlockCacheGetAudio(audio, key=96) after Put returned Err")
    let ab: Bytes = Value(gotAudio)
    if rawbytes.BytesLen(ab) != 32 || rawbytes.BytesGet(ab, 0) != 3 || rawbytes.BytesGet(ab, 31) != (31 * 13 + 3) % 256:
        return fail("audio block content wrong — collided with video's key=96 payload")
    ok("step10_block_cache_parallel_key_no_collision_ok")

    ok("ALL OK")
    return 0
