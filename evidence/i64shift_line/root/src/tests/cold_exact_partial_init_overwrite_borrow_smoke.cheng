import std/system as system

type
    ColdExactLifecycleNode = ref object
        marker: int32

fn ColdExactLifecycleAppendDigit(trace: var int32, digit: int32) =
    trace = trace * 10 + digit

fn ColdExactPartialInit(enabled: bool): int32 =
    var initialized: bool = false
    var value: ColdExactLifecycleNode
    if enabled:
        value = new(ColdExactLifecycleNode)
        value.marker = 41
        initialized = true
    if initialized: # COLD_EXACT_PARTIAL_INIT_GUARD
        if value == nil || value.marker != 41:
            return 1
        value = nil
    return 0

fn ColdExactOwnedCopyFromBorrow(source: var str): str =
    return system.NewStringCopy(
        system.StrDataPtr(source), source.len) # COLD_EXACT_BORROW_LIFT

fn ColdExactOverwriteSelfAssign(trace: var int32): int32 =
    defer:
        ColdExactLifecycleAppendDigit(trace, 1)
    defer:
        ColdExactLifecycleAppendDigit(trace, 2)

    let freeBefore = system.memFreeCount()
    var first = new(ColdExactLifecycleNode)
    first.marker = 51
    var second = new(ColdExactLifecycleNode)
    second.marker = 52

    first = first
    if first == nil || first.marker != 51 ||
       system.memFreeCount() != freeBefore:
        return 1

    first = second
    # COLD_EXACT_OVERWRITE_OLD_OWNER_MUTATION
    if first == nil || first.marker != 52 ||
       system.memFreeCount() - freeBefore != 1:
        return 2

    first = nil
    if system.memFreeCount() - freeBefore != 2:
        return 3
    return 0

fn main(): int32 =
    let liveBefore = system.memLiveCount()
    system.memDiagReset()

    if ColdExactPartialInit(false) != 0:
        return 1
    if ColdExactPartialInit(true) != 0:
        return 2

    var trace: int32
    if ColdExactOverwriteSelfAssign(trace) != 0:
        return 3
    if trace != 21:
        return 4

    var owner = system.NewStringCopy(
        system.StrDataPtr("borrow-owner"), 12)
    var lifted = ColdExactOwnedCopyFromBorrow(owner)
    owner = ""
    if lifted != "borrow-owner" || lifted.len != 12:
        return 5
    lifted = ""

    if system.memLiveCount() != liveBefore:
        return 6
    return 0
