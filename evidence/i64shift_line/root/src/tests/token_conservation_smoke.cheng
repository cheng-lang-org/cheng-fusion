# token conservation smoke: total minted == total live note value == sum
# of owner balances, preserved across transfers and double-spend rejection;
# independent replay yields identical appHash.

import std/os
import std/system
import cheng/std/bytes_layout as layout
import cheng/apps/rwad/rwad_serial_state_machine as serial
import cheng/chain/lsmr_types as lt

fn Owner(b: int32): layout.FixedBytes32 =
    var raw = BytesAlloc(32)
    BytesSet(raw, 0, b)
    let res = layout.FixedBytes32FromBytes(raw)
    return res.value

@borrows
fn LiveSum(m: serial.RwadStateMachine): int64 =
    # owner balances partition all live value, so their sum is the supply
    var total: int64 = 0
    total = total + serial.RwadOwnerBalance(m, Owner(1))
    total = total + serial.RwadOwnerBalance(m, Owner(2))
    total = total + serial.RwadOwnerBalance(m, Owner(3))
    return total

fn main(): int32 =
    var rc: int32 = 0
    var m = serial.RwadStateMachineInit("token-conservation")

    # mint A=100, B=50, C=30 -> live supply 180
    let mA = serial.RwadStateMachineApplyMint(m, Int64(1), serial.RwadMintTxMake(Owner(1), Int64(100)))
    let mB = serial.RwadStateMachineApplyMint(m, Int64(2), serial.RwadMintTxMake(Owner(2), Int64(50)))
    let mC = serial.RwadStateMachineApplyMint(m, Int64(3), serial.RwadMintTxMake(Owner(3), Int64(30)))
    if !mA.accepted or !mB.accepted or !mC.accepted:
        os.WriteLine(os.Get_stderr(), "mint rejected unexpectedly")
        rc = rc + 1
    if LiveSum(m) != 180:
        os.WriteLine(os.Get_stderr(), "supply after mints wrong")
        rc = rc + 1

    # A spends a 40-unit input note to B; change returns to A
    # A holds one interval [1,100]; spend range start=1 end=40 -> B gets 40,
    # A keeps the remainder via tertiary note.
    let xfer = serial.RwadTransferTxMake(mA.primaryNoteId, Owner(1), Owner(2), Int64(1), Int64(40))
    let tRes = serial.RwadStateMachineApplyTransfer(m, Int64(4), xfer)
    if !tRes.accepted:
        os.WriteLine(os.Get_stderr(), "transfer rejected unexpectedly")
        rc = rc + 1
    if LiveSum(m) != 180:
        os.WriteLine(os.Get_stderr(), "supply changed across transfer")
        rc = rc + 1

    # replaying the same spend again must be a loud double-spend rejection
    let dup = serial.RwadStateMachineApplyTransfer(m, Int64(5), xfer)
    if dup.accepted:
        os.WriteLine(os.Get_stderr(), "double spend accepted")
        rc = rc + 1
    if LiveSum(m) != 180:
        os.WriteLine(os.Get_stderr(), "supply changed across rejection")
        rc = rc + 1

    # deterministic replay: an independent machine fed the same ordered txs
    # must land on the identical appHash
    # the appId is part of the state hash domain, so the replay machine
    # must use the same appId as the original.
    var m2 = serial.RwadStateMachineInit("token-conservation")
    let nA = serial.RwadStateMachineApplyMint(m2, Int64(1), serial.RwadMintTxMake(Owner(1), Int64(100)))
    let nB = serial.RwadStateMachineApplyMint(m2, Int64(2), serial.RwadMintTxMake(Owner(2), Int64(50)))
    let nC = serial.RwadStateMachineApplyMint(m2, Int64(3), serial.RwadMintTxMake(Owner(3), Int64(30)))
    let nXfer = serial.RwadTransferTxMake(nA.primaryNoteId, Owner(1), Owner(2), Int64(1), Int64(40))
    let nT = serial.RwadStateMachineApplyTransfer(m2, Int64(4), nXfer)
    if !nA.accepted or !nB.accepted or !nC.accepted or !nT.accepted:
        os.WriteLine(os.Get_stderr(), "replay diverged in acceptance")
        rc = rc + 1
    if !layout.FixedBytes32Equal(serial.RwadAppHash(m), serial.RwadAppHash(m2)):
        os.WriteLine(os.Get_stderr(), "replay appHash mismatch")
        rc = rc + 1

    # zero/negative mint rejected loudly without touching supply
    let badMint = serial.RwadStateMachineApplyMint(m, Int64(6), serial.RwadMintTxMake(Owner(1), 0))
    if badMint.accepted:
        os.WriteLine(os.Get_stderr(), "zero mint accepted")
        rc = rc + 1
    if LiveSum(m) != 180:
        os.WriteLine(os.Get_stderr(), "supply changed across bad mint")
        rc = rc + 1

    if rc == 0:
        echo("token_conservation_smoke ok")
    return rc
