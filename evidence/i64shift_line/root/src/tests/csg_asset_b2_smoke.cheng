# CSG 资产管线 B2 冒烟: 存量视频观测记录层。
# 真值 = mp4 容器 stts/stss/mdhd (python/ffprobe 独立提取, fixtures.md 冻结):
#   cfr:    vide ts=12288 samples=24 ticks=12288 keyframes=[0]
#   vfr:    vide ts=12288 samples=48 ticks=26112 keyframes=[0]
#   offset: vide ts=12288 samples=24 ticks=12288 keyframes=[0]
# 另验: 观测 CID 稳定 / 落库激活 / head 指回观测对象。
# 用法: csg_asset_b2_smoke <fixturesDir> <storeDir>
import std/cmdline
import std/strings
import std/crypto/sha256
import std/rawbytes
import std/os
import cheng/game/assets/import/mp4
import cheng/game/assets/import/reader
import cheng/game/assets/import/commit
import cheng/game/assets/reconstruction/observation

fn observeVideo(path: str, sourceCidOut: var str): observation.AssetVideoObservation =
    var bounds = reader.AssetReaderBoundsFor("mp4")
    var data = rawbytes.EmptyBytes()
    assert(reader.AssetReaderLoadBounded(path, bounds, data), "mp4 loaded")
    var digest = sha256.Sha256Digest(data)
    defer:
        rawbytes.BytesFree(digest)
    sourceCidOut = rawbytes.BytesToHex(digest)

    var info: mp4.AssetMp4Info
    var err: str
    assert(mp4.AssetMediaParseMp4(data, info, err), Fmt"mp4 parses: {err}")
    var vi: int32 = -1
    for i in 0..<info.tracks.len:
        if info.tracks[i].handler == mp4.AssetMediaHandlerVide():
            vi = i
            break
    assert(vi >= 0, "vide track present")
    var obs = observation.AssetVideoObserveFromTrack(info.tracks[vi].handler,
        info.tracks[vi].timebase, info.tracks[vi].sampleCount,
        info.tracks[vi].mediaDuration, info.tracks[vi].sttsCounts,
        info.tracks[vi].sttsDeltas, info.tracks[vi].stssSamples,
        path, sourceCidOut)
    rawbytes.BytesFree(data)
    return obs

@borrows
fn checkCfr(dir: str, storeDir: str) =
    var cid: str
    var obs = observeVideo(Fmt"{dir}/media/sample_cfr_1s.mp4", cid)
    assert(observation.AssetVideoObservationValid(obs), "cfr observation valid")
    assert(obs.timescale == 12288, "cfr timescale")
    assert(obs.sampleCount == 24, "cfr 24 samples")
    assert(obs.totalTicks == int64(12288), "cfr total ticks")
    assert(obs.durationMs == int64(1000), "cfr duration 1s")
    assert(obs.keyframeCount == 1, "cfr one keyframe")
    assert(obs.keyframeTicks[0] == int64(0), "cfr keyframe at 0")
    assert(obs.keyframeMs[0] == int64(0), "cfr keyframe at 0ms")
    assert(obs.gopCount == 1, "cfr single gop")
    assert(obs.originClass == 2, "cfr origin derived")
    # CID 稳定
    var cid2: str
    var obs2 = observeVideo(Fmt"{dir}/media/sample_cfr_1s.mp4", cid2)
    assert(observation.AssetVideoObservationCid(obs) ==
        observation.AssetVideoObservationCid(obs2), "observation cid stable")
    assert(cid == cid2, "source cid stable")
    # 落库激活
    assert(observation.AssetVideoObservationCommit(storeDir, obs),
        "cfr observation committed")

@borrows
fn checkVfr(dir: str) =
    var cid: str
    var obs = observeVideo(Fmt"{dir}/media/sample_vfr_bframes.mp4", cid)
    assert(observation.AssetVideoObservationValid(obs), "vfr observation valid")
    assert(obs.sampleCount == 48, "vfr 48 samples")
    assert(obs.totalTicks == int64(26112), "vfr total ticks 26112")
    assert(obs.durationMs == int64(2125), "vfr duration 2125ms")
    assert(obs.keyframeCount == 1, "vfr one keyframe")
    assert(obs.keyframeTicks[0] == int64(0), "vfr keyframe at 0")

@borrows
fn checkOffset(dir: str) =
    var cid: str
    var obs = observeVideo(Fmt"{dir}/media/sample_offset_start.mp4", cid)
    assert(observation.AssetVideoObservationValid(obs), "offset observation valid")
    assert(obs.sampleCount == 24, "offset 24 samples")
    assert(obs.totalTicks == int64(12288), "offset total ticks")

@borrows
fn checkNegative(dir: str) =
    # 非视频轨 (wav 无 mp4 结构) => 解析拒绝
    var cid: str
    var bounds = reader.AssetReaderBoundsFor("mp4")
    var data = rawbytes.EmptyBytes()
    assert(reader.AssetReaderLoadBounded(Fmt"{dir}/media/sample_440hz_2s.wav",
        bounds, data), "wav loaded")
    var info: mp4.AssetMp4Info
    var err: str
    assert(!mp4.AssetMediaParseMp4(data, info, err), "wav as mp4 rejected")
    rawbytes.BytesFree(data)
    # 手造非法观测: 关键帧越界
    var bad: observation.AssetVideoObservation
    bad.schema = observation.AssetVideoObservationSchema()
    bad.sourceCid = strings.Sha256("x")
    bad.timescale = 12288
    bad.sampleCount = 24
    bad.totalTicks = int64(12288)
    bad.keyframeCount = 1
    add(bad.keyframeTicks, int64(12288))
    add(bad.keyframeMs, int64(1000))
    bad.originClass = 2
    bad.method = observation.AssetVideoObservationMethod()
    assert(!observation.AssetVideoObservationValid(bad),
        "keyframe at totalTicks rejected")

fn main(): int32 =
    let argc = cmdline.paramCount()
    if argc < 2:
        echo("usage: csg_asset_b2_smoke <fixturesDir> <storeDir>")
        return 2
    let fixturesDir = Fmt"{cmdline.paramStr(1)}"
    let storeDir = Fmt"{cmdline.paramStr(2)}"
    checkCfr(fixturesDir, storeDir)
    checkVfr(fixturesDir)
    checkOffset(fixturesDir)
    checkNegative(fixturesDir)
    echo("csg_asset_b2_smoke PASS")
    return 0
