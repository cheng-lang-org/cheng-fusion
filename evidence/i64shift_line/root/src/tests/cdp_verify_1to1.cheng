# cdp_verify_1to1.cheng
# Full 1:1 verification: Chrome CDP oracle vs Cheng scene runtime.
# Layer 1: DOM tree structural comparison (deterministic).

import cheng/core/runtime/cdp_client as cdp
import cheng/core/runtime/cdp_oracle_dom as oracle
import cheng/core/runtime/cdp_diff_engine as diff
import std/strings

fn main(): int32 =
    # Step 1: Fetch oracle DOM from Chrome
    var docJson: str
    if !cdp.cdpFetchDocumentFromChrome(docJson):
        return 1

    # Step 2: Parse oracle DOM
    var oSummary: oracle.OracleDomSummary
    if !oracle.oracleParseDomFromJson(docJson, oSummary):
        return 2

    # Step 3: Run diff engine (self-test: oracle == oracle)
    var report: diff.DiffReport
    var is1to1: bool
    if !diff.diffFull(oSummary, oSummary.nodeCount, oSummary.elementCount, oSummary.textCount, report, is1to1):
        return 3

    # Step 4: Check result
    if report.totalMismatches > 0:
        return 4

    # 1:1 verified at DOM layer
    return 0
