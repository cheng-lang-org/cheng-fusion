# R17 positive: returning a resource-free value object through an OBJECT_REF
# place (a global shadow and a `var T` parameter). Every wrong outcome has its
# own distinct nonzero exit; a returned ADDRESS instead of the payload, a
# truncated copy, or an alias to the global all fail here.
import std/system

type
    R17VBundle =
        a: int32
        b: int64
        c: int32

var tkR17VGlobal: R17VBundle

fn TkR17VRetGlobal(): R17VBundle =
    return tkR17VGlobal

fn TkR17VRetVarParam(v: var R17VBundle): R17VBundle =
    return v

fn main(): int32 =
    tkR17VGlobal.a = -31
    tkR17VGlobal.b = 9007199254740993
    tkR17VGlobal.c = 77
    let r = TkR17VRetGlobal()
    if r.a != -31:
        return 10
    if r.b != 9007199254740993:
        return 11
    if r.c != 77:
        return 12
    tkR17VGlobal.a = 5
    let r2 = TkR17VRetGlobal()
    if r2.a != 5:
        return 13
    if r.a != -31:
        return 14
    var x: R17VBundle
    x.a = 9
    x.b = -7
    x.c = 3
    let y = TkR17VRetVarParam(x)
    if y.a != 9:
        return 15
    if y.b != -7:
        return 16
    if y.c != 3:
        return 17
    echo(Fmt"tk_r17_plainobj_ref_return ok a={r.a} b={r.b} c={r.c} a2={r2.a} y={y.a}")
    return 0
