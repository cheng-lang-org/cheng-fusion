# b2_writer_units_dispatch_smoke.cheng —— B2 writer/linker 表键派发专项
# 覆盖蓝图 B2 验证点「每 (format,triple) 组合 1 obj smoke」：
#   - TextData Bytes 槽 5 个 arch 专属组合的真产物 ELF 头断言
#     （class/e_machine/双 riscv32 变体 e_flags 区分）；
#   - 解析函数 Invalid 面（共享格式 triple 不入 arch 表：aarch64-elf/
#     macho/coff/wasm）；
#   - 缺组合显式失败（Bytes/Write/Link 三槽 Invalid 键 Err 路径）。
import std/result
import std/rawbytes
import std/os
import std/strformat
import cheng/core/backend/codegen_contract as contract
import cheng/core/backend/codegen_writer_units as wunits
import cheng/core/backend/object_symbols as osym
import cheng/core/backend/object_relocs as orel

@borrows
fn u8At(bytes: rawbytes.Bytes, offset: int32): uint64 =
    return uint64(rawbytes.BytesGet(bytes, offset) & 255)

@borrows
fn u16le(bytes: rawbytes.Bytes, offset: int32): uint64 =
    return u8At(bytes, offset) | (u8At(bytes, offset + 1) << 8)

@borrows
fn u32le(bytes: rawbytes.Bytes, offset: int32): uint64 =
    return u16le(bytes, offset) | (u16le(bytes, offset + 2) << 16)

fn b2BuildText(): rawbytes.Bytes =
    var text = rawbytes.BytesAlloc(32)
    for i in 0..<32:
        rawbytes.BytesSet(text, i, 0)
    return text

fn b2BuildSymbols(): osym.ObjectSymbolTable =
    var symbols = osym.ObjectSymbolsInit()
    assert(osym.ObjectSymbolsAddDefined(
               symbols, "entry", 0, int64(0), int64(32), true) == 0,
           "b2: entry symbol")
    return symbols

@borrows
fn b2CheckCombo(text: rawbytes.Bytes,
                data: rawbytes.Bytes,
                symbols: osym.ObjectSymbolTable,
                relocs: orel.ObjectRelocTable,
                targetTriple: str,
                expectUnit: int32,
                expectClass: uint64,
                expectMachine: uint64,
                outFlags: var uint64): bool =
    let unitKey = contract.CodegenElfTextDataWriterUnit(targetTriple)
    if unitKey != expectUnit:
        return false
    var bytesRes: Result[rawbytes.Bytes]
    bytesRes = wunits.CodegenWriterUnitTextDataObjectBytes(
        unitKey, text, data, symbols, relocs)
    if !bytesRes.ok:
        return false
    if u8At(bytesRes.value, 0) != uint64(127) ||
       u16le(bytesRes.value, 18) != expectMachine ||
       u8At(bytesRes.value, 4) != expectClass:
        return false
    if expectClass == uint64(2):
        outFlags = u32le(bytesRes.value, 48)
    else:
        outFlags = u32le(bytesRes.value, 36)
    return true

fn main(): int32 =
    var text = b2BuildText()
    var data = rawbytes.BytesAlloc(8)
    for i in 0..<8:
        rawbytes.BytesSet(data, i, 0)
    var symbols = b2BuildSymbols()
    var relocs = orel.ObjectRelocsInit()
    var flags: uint64
    # (elf, x86_64-linux) → X64, ELF64, EM_X86_64=62
    assert(b2CheckCombo(text, data, symbols, relocs,
                        "x86_64-unknown-linux-gnu",
                        contract.CodegenUnitX64,
                        uint64(2), uint64(62), flags),
           "b2: x86_64 combo dispatch")
    # (elf, riscv64-linux / riscv64-bare) → Rv64, ELF64, EM_RISCV=243
    assert(b2CheckCombo(text, data, symbols, relocs,
                        "riscv64-unknown-linux-gnu",
                        contract.CodegenUnitRv64,
                        uint64(2), uint64(243), flags),
           "b2: riscv64 linux combo dispatch")
    assert(b2CheckCombo(text, data, symbols, relocs,
                        "riscv64-unknown-none-elf",
                        contract.CodegenUnitRv64,
                        uint64(2), uint64(243), flags),
           "b2: riscv64 bare combo dispatch")
    # (elf, esp32s31) → Rv32, ELF32, EM_RISCV
    var espFlags: uint64
    assert(b2CheckCombo(text, data, symbols, relocs,
                        "riscv32-esp32s31-none-elf",
                        contract.CodegenUnitRv32,
                        uint64(1), uint64(243), espFlags),
           "b2: esp32s31 combo dispatch")
    assert(contract.CodegenElfTextDataWriterUnit("esp32s31") ==
               contract.CodegenUnitRv32,
           "b2: esp32s31 alias dispatch")
    # (elf, riscv32 bare/linux 非 esp) → Integer 变体, ELF32, EM_RISCV
    var intFlags: uint64
    assert(b2CheckCombo(text, data, symbols, relocs,
                        "riscv32-unknown-none-elf",
                        contract.CodegenWriterUnitRv32Integer,
                        uint64(1), uint64(243), intFlags),
           "b2: riscv32 integer combo dispatch")
    assert(intFlags != espFlags,
           "b2: riscv32 dual-variant e_flags differ")
    # 共享格式 triple 不入 arch 表（kernel→shared 直调保留在调用方）
    assert(contract.CodegenElfTextDataWriterUnit(
               "aarch64-unknown-linux-gnu") == contract.CodegenUnitInvalid,
           "b2: aarch64 elf is shared-format arm")
    assert(contract.CodegenElfTextDataWriterUnit(
               "arm64-apple-darwin") == contract.CodegenUnitInvalid,
           "b2: darwin macho is shared-format arm")
    assert(contract.CodegenElfTextDataWriterUnit(
               "x86_64-pc-windows-msvc") == contract.CodegenUnitInvalid,
           "b2: coff is shared-format arm")
    assert(contract.CodegenElfTextDataWriterUnit(
               "wasm32-unknown-unknown") == contract.CodegenUnitInvalid,
           "b2: wasm has no elf writer unit")
    # 缺组合显式失败（无兜底）：三槽 Invalid 键 Err 路径
    var badBytes: Result[rawbytes.Bytes]
    badBytes = wunits.CodegenWriterUnitTextDataObjectBytes(
        contract.CodegenUnitInvalid, text, data, symbols, relocs)
    assert(!badBytes.ok, "b2: bytes slot rejects missing combo")
    var badWrite: Result[contract.CodegenObjectWriterResult]
    badWrite = wunits.CodegenWriterUnitTextDataObjectWrite(
        contract.CodegenUnitInvalid, "/tmp/", "out.o",
        text, data, symbols, relocs)
    assert(!badWrite.ok, "b2: write slot rejects missing combo")
    var badPaths: str[]
    var badLink: Result[bool]
    badLink = wunits.CodegenWriterUnitLinkExeBuiltin(
        contract.CodegenUnitInvalid, badPaths, "exe", "t")
    assert(!badLink.ok, "b2: link slot rejects missing combo")
    rawbytes.BytesFree(text)
    rawbytes.BytesFree(data)
    os.WriteLine(os.Get_stdout(),
                 "b2_writer_units_dispatch=pass combos=5 invalid=5 err_paths=3")
    return 0
