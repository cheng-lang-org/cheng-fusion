# csg_core_uniqueness_driver: dynamic probe for CSGC byte / facts_root /
# proof uniqueness and strict admission rejection. Read-only verification
# driver; subcommands:
#   pack2  <in.jsonl> <out1.csgc> <out2.csgc>
#   root2  <in.jsonl>
#   prove2 <in.jsonl> <key> <out1.csgc> <out2.csgc>
#   reject <in.jsonl> <out.csgc>
import std/cmdline as cmdline
import std/os as os
import std/rawbytes
import std/result
import std/strings
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/csg_core/csgc
import cheng/core/csg_core/json_canonical as canonical
import cheng/core/csg_core/jsonl
import cheng/core/csg_core/merkle_cargo
import cheng/core/csg_core/merkle_dag
import cheng/core/csg_core/validator as csg

fn uqOut(text: str) =
    os.WriteLine(os.Get_stdout(), text)

fn uqErr(text: str) =
    os.WriteLine(os.Get_stderr(), text)

@borrows
fn uqCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

@borrows
fn uqCat3(a: str, b: str, c: str): str =
    return uqCat(uqCat(a, b), c)

fn uqBool01(value: bool): str =
    if value:
        return "1"
    return "0"

@borrows
fn uqShaHex(bytes: rawbytes.Bytes): str =
    return layout.FixedBytes32Hex(
        hash256.Sha256Fixed(layout.ByteSpanFromBytes(bytes)))

@borrows
fn uqBytesEqual(left: rawbytes.Bytes, right: rawbytes.Bytes): bool =
    let n = rawbytes.BytesLen(left)
    if n != rawbytes.BytesLen(right):
        return false
    for i in 0..<n:
        if rawbytes.BytesGet(left, i) != rawbytes.BytesGet(right, i):
            return false
    return true

# Exact replica of the production pack admission gate
# (cli.cheng csgCliReadCanonicalPackSourceLines): same checks, same order,
# same production helpers (jsonl split + json_canonical per-line compare).
@borrows
fn uqReadCanonicalLines(
        path: str,
        lines: var str[],
        error: var str): bool =
    error = ""
    if csgc.CsgCoreCsgcPathLooksBinary(path):
        error = "pack_source_jsonl_required"
        return false
    var readResult: Result[rawbytes.Bytes] =
        os.ReadFileBytesResult(path)
    if result.IsErr(readResult):
        error = uqCat("pack_source_read_failed:", path)
        return false
    var bytes = rawbytes.BytesTake(readResult.value)
    let text = rawbytes.BytesToString(bytes)
    rawbytes.BytesFree(bytes)
    if text.len == 0 || text[text.len - 1] != '\n':
        error = "pack_source_jsonl_final_lf_required"
        return false
    for byteIndex in 0..<text.len:
        if text[byteIndex] == '\r':
            error = "pack_source_jsonl_cr_forbidden"
            return false
    let split = jsonl.CsgCoreJsonlSplitLines(text)
    if split.len == 0:
        error = "pack_source_empty_fact_set"
        return false
    for lineIndex in 0..<split.len:
        if split[lineIndex].len == 0:
            error = "pack_source_jsonl_empty_record"
            return false
        let canonicalLine =
            canonical.CsgCoreJsonCanonicalize(split[lineIndex])
        if !canonicalLine.ok:
            error = uqCat3(
                uqCat("pack_source_line_", strings.IntToStr(lineIndex + 1)),
                "_invalid:",
                canonicalLine.error)
            return false
        if canonicalLine.value != split[lineIndex]:
            error = uqCat(
                uqCat("pack_source_line_", strings.IntToStr(lineIndex + 1)),
                "_non_canonical")
            return false
        add(lines, strings.CloneStr(split[lineIndex]))
    return true

fn uqRunPack2(): int32 =
    let path = cmdline.ParamStr(2)
    let out1 = cmdline.ParamStr(3)
    let out2 = cmdline.ParamStr(4)
    var lines: str[]
    var error: str
    if !uqReadCanonicalLines(path, lines, error):
        uqErr(uqCat("error: ", error))
        return 1
    var enc1 = csgc.CsgCoreCsgcEncodeCanonicalLines(lines)
    if !enc1.ok:
        uqErr(uqCat("error: encode1 ", enc1.error))
        return 1
    var enc2 = csgc.CsgCoreCsgcEncodeCanonicalLines(lines)
    if !enc2.ok:
        uqErr(uqCat("error: encode2 ", enc2.error))
        return 1
    var bytes1 = rawbytes.BytesTake(enc1.bytes)
    var bytes2 = rawbytes.BytesTake(enc2.bytes)
    let equal = uqBytesEqual(bytes1, bytes2)
    uqOut(uqCat("fact_count=", strings.IntToStr(enc1.factCount)))
    uqOut(uqCat(
        "csgc_bytes=", strings.IntToStr(rawbytes.BytesLen(bytes1))))
    uqOut(uqCat("sha256_1=", uqShaHex(bytes1)))
    uqOut(uqCat("sha256_2=", uqShaHex(bytes2)))
    uqOut(uqCat("inprocess_byte_equal=", uqBool01(equal)))
    if !uqWriteBytes(out1, bytes1):
        uqErr(uqCat("error: write failed: ", out1))
        return 1
    if !uqWriteBytes(out2, bytes2):
        uqErr(uqCat("error: write failed: ", out2))
        return 1
    rawbytes.BytesFree(bytes1)
    rawbytes.BytesFree(bytes2)
    uqOut(uqCat("out1=", out1))
    uqOut(uqCat("out2=", out2))
    if !equal:
        return 3
    return 0

fn uqRunRoot2(): int32 =
    let path = cmdline.ParamStr(2)
    var lines: str[]
    var error: str
    if !uqReadCanonicalLines(path, lines, error):
        uqErr(uqCat("error: ", error))
        return 1
    let v1 = csg.CsgCoreProductionAdmitFactLines(lines)
    let v2 = csg.CsgCoreProductionAdmitFactLines(lines)
    uqOut(uqCat("valid_1=", uqBool01(v1.valid)))
    uqOut(uqCat("complete_1=", uqBool01(v1.complete)))
    uqOut(uqCat("fact_count=", strings.IntToStr(v1.factCount)))
    uqOut(uqCat("facts_root_1=", v1.factsRoot))
    uqOut(uqCat("facts_root_2=", v2.factsRoot))
    let equal = v1.factsRoot == v2.factsRoot &&
        v1.factsRoot.len > 0
    uqOut(uqCat("facts_root_equal=", uqBool01(equal)))
    if !v1.valid:
        for i in 0..<v1.errors.len:
            uqErr(uqCat("error: ", v1.errors[i]))
        return 1
    if !equal:
        return 3
    return 0

fn uqRunProve2(): int32 =
    let path = cmdline.ParamStr(2)
    let key = cmdline.ParamStr(3)
    let out1 = cmdline.ParamStr(4)
    let out2 = cmdline.ParamStr(5)
    var lines: str[]
    var error: str
    if !uqReadCanonicalLines(path, lines, error):
        uqErr(uqCat("error: ", error))
        return 1
    let validation = csg.CsgCoreProductionAdmitFactLines(lines)
    if !validation.valid || !validation.complete:
        for i in 0..<validation.errors.len:
            uqErr(uqCat("error: ", validation.errors[i]))
        return 1
    let dag = csg.CsgCoreMerkleBuildBoundFromCanonicalLines(lines)
    if !dag.ok:
        uqErr(uqCat("error: ", dag.error))
        return 1
    let proof1 = merkle_dag.CsgCoreMerkleProveKey(dag, key)
    let proof2 = merkle_dag.CsgCoreMerkleProveKey(dag, key)
    if !proof1.ok:
        uqErr(uqCat("error: proof1 ", proof1.error))
        return 1
    if !proof2.ok:
        uqErr(uqCat("error: proof2 ", proof2.error))
        return 1
    var cargo1 =
        merkle_cargo.CsgCoreMerkleProofEncodeCsgc(proof1, dag.factsRoot)
    if !cargo1.ok:
        uqErr(uqCat("error: cargo1 ", cargo1.error))
        return 1
    var cargo2 =
        merkle_cargo.CsgCoreMerkleProofEncodeCsgc(proof2, dag.factsRoot)
    if !cargo2.ok:
        uqErr(uqCat("error: cargo2 ", cargo2.error))
        return 1
    var bytes1 = rawbytes.BytesTake(cargo1.bytes)
    var bytes2 = rawbytes.BytesTake(cargo2.bytes)
    let equal = uqBytesEqual(bytes1, bytes2)
    uqOut(uqCat("facts_root=", proof1.factsRoot))
    uqOut(uqCat("facts_root_matches_dag=",
        uqBool01(proof1.factsRoot == dag.factsRoot)))
    uqOut(uqCat("exists=", uqBool01(proof1.exists)))
    uqOut(uqCat(
        "path_count=", strings.IntToStr(proof1.splitBits.len)))
    uqOut(uqCat("proof_struct_equal=",
        uqBool01(proof1.factsRoot == proof2.factsRoot &&
            proof1.exists == proof2.exists &&
            proof1.terminalKey == proof2.terminalKey &&
            proof1.splitBits.len == proof2.splitBits.len)))
    uqOut(uqCat("proof_sha256_1=", uqShaHex(bytes1)))
    uqOut(uqCat("proof_sha256_2=", uqShaHex(bytes2)))
    uqOut(uqCat("inprocess_byte_equal=", uqBool01(equal)))
    var proofWrite1: Result[bool] =
        os.WriteFileBytesResult(out1, bytes1)
    if result.IsErr(proofWrite1):
        uqErr(uqCat("error: write failed: ", out1))
        return 1
    var proofWrite2: Result[bool] =
        os.WriteFileBytesResult(out2, bytes2)
    if result.IsErr(proofWrite2):
        uqErr(uqCat("error: write failed: ", out2))
        return 1
    rawbytes.BytesFree(bytes1)
    rawbytes.BytesFree(bytes2)
    uqOut(uqCat("out1=", out1))
    uqOut(uqCat("out2=", out2))
    if !equal:
        return 3
    return 0

fn uqRunReject(): int32 =
    let path = cmdline.ParamStr(2)
    let outPath = cmdline.ParamStr(3)
    var lines: str[]
    var error: str
    if !uqReadCanonicalLines(path, lines, error):
        uqOut(uqCat("rejected=", error))
        return 1
    var encoded = csgc.CsgCoreCsgcEncodeCanonicalLines(lines)
    if !encoded.ok:
        uqOut(uqCat("rejected=encode:", encoded.error))
        return 1
    var bytes = rawbytes.BytesTake(encoded.bytes)
    var writeResult: Result[bool] =
        os.WriteFileBytesResult(outPath, bytes)
    if result.IsErr(writeResult):
        uqErr(uqCat("error: write failed: ", outPath))
        rawbytes.BytesFree(bytes)
        return 2
    rawbytes.BytesFree(bytes)
    uqOut("admitted=1")
    return 0

fn main(argc: int32, argv: str*): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    if cmdline.ParamCount() < 1:
        uqErr("usage: csg_core_uniqueness_driver pack2|root2|prove2|reject ...")
        return 2
    let command = cmdline.ParamStr(1)
    if command == "pack2":
        return uqRunPack2()
    if command == "root2":
        return uqRunRoot2()
    if command == "prove2":
        return uqRunProve2()
    if command == "reject":
        return uqRunReject()
    uqErr(uqCat("error: unknown subcommand ", command))
    return 2
