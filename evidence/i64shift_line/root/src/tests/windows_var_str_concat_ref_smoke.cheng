fn makeArtifactPaths(stem: str,
                     outBin: var str,
                     outReportPath: var str): bool =
    outBin = "artifacts/backend_driver/" + stem + ".selftest"
    outReportPath = outBin + ".report.txt"
    return true

fn main(): int32 =
    var outBin = ""
    var outReportPath = ""
    assert(makeArtifactPaths("var_str_concat_ref", outBin, outReportPath),
           "windows var str concat ref: make paths")
    assert(outBin == "artifacts/backend_driver/var_str_concat_ref.selftest",
           "windows var str concat ref: out bin")
    assert(outReportPath == "artifacts/backend_driver/var_str_concat_ref.selftest.report.txt",
           "windows var str concat ref: report path")
    echo(" windows_var_str_concat_ref_smoke ok")
    return 0
