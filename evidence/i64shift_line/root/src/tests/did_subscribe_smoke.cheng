import std/system
import cheng/apps/chain_node/chain_node as node
import cheng/chain/did_subscribe as sub

fn main(): int32 =
    assert(!sub.DidSubscribeSeatOpen(100, 1), " did_subscribe: first period full")
    assert(sub.DidSubscribeSeatOpen(99, 1), " did_subscribe: first period open")
    assert(sub.DidSubscribeSeatOpen(100, 2), " did_subscribe: later period open")

    var server: node.ChainNode
    assert(IsOk(node.ChainNodeInitInto(server, "node-a", "did-sub-a")),
           " did_subscribe: server init")
    var client: node.ChainNode
    assert(IsOk(node.ChainNodeInitInto(client, "node-b", "did-sub-b")),
           " did_subscribe: client init")

    let nowMs = int64(1777000000000)
    let untilMs = nowMs + int64(86400000)
    let lowRise = sub.DidSubscribeApply(server,
                                          "did:cheng:holder-a",
                                          sub.DidSubscribePlanRise,
                                          1,
                                          untilMs,
                                          int64(9999),
                                          nowMs)
    assert(IsErr(lowRise), " did_subscribe: rise floor")
    let lowTop = sub.DidSubscribeApply(server,
                                         "did:cheng:holder-a",
                                         sub.DidSubscribePlanTop10,
                                         1,
                                         untilMs,
                                         int64(99999),
                                         nowMs)
    assert(IsErr(lowTop), " did_subscribe: top10 floor")

    let riseRes = sub.DidSubscribeApply(server,
                                          "did:cheng:holder-a",
                                          sub.DidSubscribePlanRise,
                                          1,
                                          untilMs,
                                          sub.DidSubscribeCapitalRiseYuan,
                                          nowMs)
    assert(IsOk(riseRes), " did_subscribe: rise apply")
    let rise = Value(riseRes)
    assert(rise.planId == sub.DidSubscribePlanRise, " did_subscribe: rise plan")
    assert(rise.period == 1, " did_subscribe: rise period")
    assert(rise.untilMs == untilMs, " did_subscribe: rise until")
    assert(sub.DidSubscribeFirstPeriodOccupied(server, sub.DidSubscribeAssetRise) == 1,
           " did_subscribe: rise occupied")

    let topRes = sub.DidSubscribeApply(server,
                                         "did:cheng:holder-b",
                                         sub.DidSubscribePlanTop10,
                                         1,
                                         untilMs,
                                         sub.DidSubscribeCapitalTop10Yuan,
                                         nowMs)
    assert(IsOk(topRes), " did_subscribe: top10 apply")

    var served: node.ChainNodeServeSnapshot
    node.ChainNodeServeOnceInto(served, server)
    let syncRes = node.ChainNodeSyncOnce(client, served)
    assert(IsOk(syncRes), " did_subscribe: sync")
    assert(Value(syncRes), " did_subscribe: sync changed")

    let clientRise = sub.DidSubscribeLookup(client, "did:cheng:holder-a", sub.DidSubscribePlanRise)
    assert(IsOk(clientRise), " did_subscribe: client lookup rise")
    assert(Value(clientRise).untilMs == untilMs, " did_subscribe: client until")
    assert(Value(clientRise).capitalYuan == sub.DidSubscribeCapitalRiseYuan,
           " did_subscribe: client capital")
    assert(sub.DidSubscribeFirstPeriodOccupied(client, sub.DidSubscribeAssetRise) == 1,
           " did_subscribe: client occupied")
    let clientTop = sub.DidSubscribeLookup(client, "did:cheng:holder-b", sub.DidSubscribePlanTop10)
    assert(IsOk(clientTop), " did_subscribe: client lookup top10")
    echo(" did_subscribe_smoke ok")
    return 0
