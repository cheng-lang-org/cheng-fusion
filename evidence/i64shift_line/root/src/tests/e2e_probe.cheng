import std/strings
import cheng/apps/vpn_proxy/vpn_proxy_config as config
import cheng/apps/vpn_proxy/vpn_proxy_routing as routing
import cheng/apps/vpn_proxy/vpn_proxy_main as vpn
import cheng/core/tooling/path as chengpath

fn main(): int32 =
    let text: str = chengpath.ReadTextFile("/Users/lbcheng/cheng-lang/platform/android/ChengHy2TunVpn/app/src/main/assets", "hy2-tun-client.example.json")
    if len(text) <= 0:
        echo("READ-FAIL")
        return 2
    let parseRes: Result[config.VpnProxyConfig] = config.VpnProxyParseConfigTextForTest(text)
    assert(!IsErr(parseRes), " cfg parse")
    var cfg: config.VpnProxyConfig
    cfg = Value(parseRes)
    if len(cfg.exits) <= 0:
        echo("NO-EXITS")
        return 4
    var oneState: vpn.VpnProxyExitState = routing.VpnProxyInitExitStateWithClientCertificate(cfg.exits[0], false)
    let idRes: Result[vpn.VpnProxyLoadedIdentity] = vpn.VpnProxyLoadIdentity("/Users/lbcheng/cheng-lang/platform/android/ChengHy2TunVpn/app/src/main/assets", cfg, false)
    assert(!IsErr(idRes), " identity")
    var identity: vpn.VpnProxyLoadedIdentity = Value(idRes)
    echo("ROUND1 pre-t=")
    echo(vpn.VpnProxyExitTransportText(oneState.cfg))
    let ok1: bool = vpn.VpnProxyProbeExit(oneState, identity, 8000)
    if ok1:
        echo("ROUND1-OK")
    else:
        echo("ROUND1-FAIL")
    echo(" post-t=")
    echo(vpn.VpnProxyExitTransportText(oneState.cfg))
    echo(" err=")
    echo(oneState.lastError)
    return 0
