import std/cmdline
import std/os
import std/rawbytes
import std/result
import std/system
import cheng/core/csg_core/csgc_mapped_reader as mapped_reader
import cheng/core/csg_core/merkle_manifest
import cheng/core/csg_core/merkle_store
import cheng/core/csg_core/merkle_store_codec

const
    FixtureParent: str = "/tmp/csg-core-csgc-mapped-reader"
    FixtureStaging: str = "staging"
    FixtureFinalName: str =
        "e2a79a63e61004c6ede0e10f269440fe446544bb8ba10ca517d429aa863f646c"
    FixtureRelativePath: str = "object.csgc"
    FixtureHashDomain: str = "csg_core.store.canonical_csgc_object"
    FixtureObjectCid: str =
        "sha256:e2a79a63e61004c6ede0e10f269440fe446544bb8ba10ca517d429aa863f646c"
    FixtureByteCount: int32 = 914
    FixtureBytesHex: str =
        ""

fn prepareFixture(): int32 =
    var encoded = rawbytes.BytesFromHex(FixtureBytesHex)
    assert(rawbytes.BytesLen(encoded) == FixtureByteCount,
           "mapped reader smoke: fixture bytes")
    let objectCid =
        merkle_store_codec.CsgCoreMerkleStoreCanonicalCsgcObjectCid(
            encoded)
    assert(objectCid == FixtureObjectCid,
           "mapped reader smoke: fixture object CID")
    let begun = os.AtomicTreeBegin(
        FixtureParent, FixtureStaging, FixtureFinalName)
    assert(IsOk(begun), "mapped reader smoke: fixture tree begin")
    let tree = Value(begun)
    assert(IsOk(os.AtomicTreeWriteExclusiveSync(
               tree, FixtureRelativePath, encoded)),
           "mapped reader smoke: fixture write")
    assert(IsOk(os.AtomicTreeSealReadOnly(
               tree, FixtureRelativePath)),
           "mapped reader smoke: fixture seal")
    assert(IsOk(os.AtomicTreeVerifyExact(
               tree, [], [FixtureRelativePath])),
           "mapped reader smoke: fixture exact tree")
    let committed = os.AtomicTreeCommitNoReplace(tree)
    assert(IsOk(committed) &&
           Value(committed) == os.AtomicTreeCommitted,
           "mapped reader smoke: fixture commit")
    assert(IsOk(os.AtomicTreeClose(tree)),
           "mapped reader smoke: fixture close")
    rawbytes.BytesFree(encoded)
    return 0

fn verifyLazy(reader: var mapped_reader.CsgCoreCsgcMappedReader): bool =
    let factCount =
        mapped_reader.CsgCoreCsgcMappedReaderFactCount(reader)
    if IsErr(factCount) || Value(factCount) != 4:
        return false
    let decoded =
        mapped_reader.CsgCoreCsgcMappedReaderDecodeFactKind(
            reader, "csg.symbol")
    return decoded.ok && decoded.found &&
        decoded.totalFactCount == 4 &&
        decoded.decodedFactCount == 2 &&
        decoded.lines.len == 2

fn verifyDetachedReceipt(
        reader: mapped_reader.CsgCoreCsgcMappedReader): bool =
    var noCanonicalCargo: rawbytes.Bytes
    let receipt =
        mapped_reader.CsgCoreCsgcMappedReaderAllocationReceipt(
            reader, noCanonicalCargo)
    return receipt.beginAttempted && receipt.ownerActivated &&
        receipt.mappingReceiptValid && receipt.objectDigestVerified &&
        receipt.objectDigestCount == 1 &&
        receipt.verifiedByteLength == int64(FixtureByteCount) &&
        receipt.closeAttempted &&
        receipt.closeSucceeded && receipt.expectedObjectCidValid &&
        !receipt.complete && receipt.active && !receipt.closed &&
        receipt.liveMappedVirtualBytes == uint64(0) &&
        receipt.liveAllocationCount == uint64(0) &&
        receipt.liveMappingCount == uint64(0) &&
        receipt.liveHandleCount == uint64(0) &&
        receipt.peakMappedVirtualBytes > uint64(0)

fn verifyProduction(): int32 =
    var owner: system.RuntimeAllocationLedgerSessionCapability
    assert(mapped_reader.CsgCoreCsgcMappedSessionOwnerBegin(
               mapped_reader.CsgCoreCsgcMappedAllocationBackingLimit,
               owner),
           "mapped reader smoke: process-entry owner begin")
    let opened =
        mapped_reader.CsgCoreCsgcMappedReaderOpenProductionOwned(
            owner,
            FixtureParent,
            FixtureFinalName,
            FixtureRelativePath,
            FixtureHashDomain,
            FixtureObjectCid)
    assert(IsOk(opened), "mapped reader smoke: production open")
    var reader = Value(opened)
    assert(verifyLazy(reader),
           "mapped reader smoke: production lazy decode")
    assert(IsOk(
           mapped_reader.CsgCoreCsgcMappedReaderSessionClose(
               reader, owner)),
           "mapped reader smoke: production close")
    assert(verifyDetachedReceipt(reader),
           "mapped reader smoke: production detach receipt")
    let closed =
        mapped_reader.CsgCoreCsgcMappedSessionOwnerClose(owner)
    assert(closed.ok && closed.receipt.complete &&
           closed.receipt.closed &&
           closed.receipt.operation ==
               system.RuntimeAllocationLedgerOpClose,
           "mapped reader smoke: process-entry terminal close")
    echo("CSG_CORE_CSGC_MAPPED_PRODUCTION_OWNER_OK")
    return 0

fn verifySession(): int32 =
    var owner: system.RuntimeAllocationLedgerSessionCapability
    assert(mapped_reader.CsgCoreCsgcMappedSessionOwnerBegin(
               mapped_reader.CsgCoreCsgcMappedAllocationBackingLimit,
               owner),
           "mapped reader smoke: session owner begin")
    let opened =
        mapped_reader.CsgCoreCsgcMappedReaderOpenSessionOwned(
            owner,
            FixtureParent,
            FixtureFinalName,
            FixtureRelativePath,
            FixtureHashDomain,
            FixtureObjectCid)
    assert(IsOk(opened), "mapped reader smoke: session open")
    var reader = Value(opened)
    assert(verifyLazy(reader),
           "mapped reader smoke: session lazy decode")
    let detached =
        mapped_reader.CsgCoreCsgcMappedReaderSessionClose(
            reader, owner)
    assert(IsOk(detached), "mapped reader smoke: session detach")
    let reopened =
        mapped_reader.CsgCoreCsgcMappedReaderOpenSessionOwned(
            owner,
            FixtureParent,
            FixtureFinalName,
            FixtureRelativePath,
            FixtureHashDomain,
            FixtureObjectCid)
    assert(IsOk(reopened), "mapped reader smoke: session reopen")
    reader = Value(reopened)
    assert(verifyLazy(reader),
           "mapped reader smoke: session lazy decode after reopen")
    let redetached =
        mapped_reader.CsgCoreCsgcMappedReaderSessionClose(
            reader, owner)
    assert(IsOk(redetached),
           "mapped reader smoke: session detach after reopen")
    let closed =
        mapped_reader.CsgCoreCsgcMappedSessionOwnerClose(owner)
    assert(closed.ok,
           "mapped reader smoke: session owner close")
    let receipt = closed.receipt
    assert(receipt.complete && receipt.closed &&
           receipt.operation ==
               system.RuntimeAllocationLedgerOpClose &&
           receipt.storageKind ==
               system.RuntimeAllocationLedgerStorageNone &&
           receipt.liveMappedVirtualBytes == uint64(0) &&
           receipt.liveAllocationCount == uint64(0) &&
           receipt.liveMappingCount == uint64(0) &&
           receipt.liveHandleCount == uint64(0) &&
           receipt.peakMappedVirtualBytes > uint64(0),
           "mapped reader smoke: session close receipt")
    echo("CSG_CORE_CSGC_MAPPED_SESSION_OWNER_OK")
    return 0

fn verifyPremapped(): int32 =
    var owner: system.RuntimeAllocationLedgerSessionCapability
    assert(mapped_reader.CsgCoreCsgcMappedSessionOwnerBegin(
               mapped_reader.CsgCoreCsgcMappedAllocationBackingLimit,
               owner),
           "mapped reader smoke: premapped owner begin")
    var manifest: merkle_manifest.CsgCoreMerkleManifest
    manifest.csgcObjectCid = FixtureObjectCid
    manifest.csgcByteCount = FixtureByteCount
    var mapped =
        merkle_store.CsgCoreMerkleStoreMapCanonicalCsgcObject(
            FixtureParent, manifest)
    assert(mapped.ok,
           "mapped reader smoke: canonical object map")
    let opened =
        mapped_reader.CsgCoreCsgcMappedReaderOpenCanonicalObjectOwned(
            mapped, owner)
    assert(IsErr(opened) &&
           Error(opened) == mapped_reader.
               CsgCoreCsgcMappedPremappedCarrierHardRedReason,
           "mapped reader smoke: constructible premapped carrier accepted")
    assert(mapped.region == os.ReadOnlyMappedRegion(0),
           "mapped reader smoke: premapped region not consumed")
    let closed =
        mapped_reader.CsgCoreCsgcMappedSessionOwnerClose(owner)
    assert(closed.ok && closed.receipt.complete &&
           closed.receipt.closed,
           "mapped reader smoke: premapped session close")
    echo("CSG_CORE_CSGC_MAPPED_PREMAPPED_CARRIER_REJECTED")
    return 0

fn verifyStaleNonceCopy(): int32 =
    var owner: system.RuntimeAllocationLedgerSessionCapability
    assert(mapped_reader.CsgCoreCsgcMappedSessionOwnerBegin(
               mapped_reader.CsgCoreCsgcMappedAllocationBackingLimit,
               owner),
           "mapped reader smoke: stale nonce owner begin")
    var stale = owner
    let first = system.RuntimeAllocationLedgerSessionOwnerSnapshot(owner)
    assert(first.ok,
           "mapped reader smoke: nonce rotation snapshot")
    var replay =
        system.RuntimeAllocationLedgerSessionOwnerSnapshot(stale)
    assert(!replay.ok &&
           replay.error == "allocation_ledger_stale_session_capability",
           "mapped reader smoke: stale nonce copy accepted")
    replay.error = ""
    let closed =
        mapped_reader.CsgCoreCsgcMappedSessionOwnerClose(owner)
    assert(closed.ok && closed.receipt.complete &&
           closed.receipt.closed && owner.handle == uint64(0) &&
           owner.generation == uint64(0) &&
           owner.nonce0 == uint64(0) && owner.nonce1 == uint64(0),
           "mapped reader smoke: stale nonce terminal close")
    echo("CSG_CORE_CSGC_SESSION_NONCE_STALE_COPY_REJECTED")
    return 0

fn main(argc: int32, argv: str*): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    if cmdline.RawParamEquals(1, "prepare"):
        return prepareFixture()
    if cmdline.RawParamEquals(1, "premapped"):
        cmdline.ClearCapturedCmdLine()
        return verifyPremapped()
    if cmdline.RawParamEquals(1, "session"):
        cmdline.ClearCapturedCmdLine()
        return verifySession()
    if cmdline.RawParamEquals(1, "stale-nonce"):
        cmdline.ClearCapturedCmdLine()
        return verifyStaleNonceCopy()
    cmdline.ClearCapturedCmdLine()
    return verifyProduction()
