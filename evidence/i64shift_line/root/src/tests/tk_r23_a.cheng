type
    R23Profile =
        text: str
        lines: str[]

fn R23Rewrite(textRaw: str, rewrittenOut: var str, err: var str): bool =
    if textRaw == "":
        err = "empty source text"
        return false
    rewrittenOut = textRaw
    err = ""
    return true

fn R23Split(textRaw: str): str[] =
    var out: str[]
    add(out, textRaw)
    return out

fn R23Build(text: str, profile: var R23Profile, err: var str): bool =
    var normalizedText: str
    if !R23Rewrite(text, normalizedText, err):
        return false
    profile.text = normalizedText
    let lines = R23Split(normalizedText)
    profile.lines = lines
    return true

fn main(): int32 =
    var profile: R23Profile
    var err: str
    if !R23Build("alpha", profile, err):
        return 10
    echo("r23 a ok")
    return 0
