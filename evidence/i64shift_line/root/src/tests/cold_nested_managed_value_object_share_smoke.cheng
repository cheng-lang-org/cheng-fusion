import std/system
import std/strings

type
    ColdSharedLeaf = ref object
        value: int32

    ColdSharedInner =
        label: str
        values: int32[]
        leaf: ColdSharedLeaf

    ColdSharedOuter =
        inner: ColdSharedInner

fn ColdSharedMake(): ColdSharedOuter =
    var source: ColdSharedOuter
    source.inner.label = IntToStr(41)
    add(source.inner.values, 7)
    source.inner.leaf = new(ColdSharedLeaf)
    source.inner.leaf.value = 41
    let alias: ColdSharedOuter = share(source)
    return alias

fn ColdSharedRun(): int32 =
    let alias = ColdSharedMake()
    if alias.inner.label != "41" ||
       alias.inner.values.len != 1 ||
       alias.inner.values[0] != 7 ||
       alias.inner.leaf == nil ||
       alias.inner.leaf.value != 41:
        return 2
    return 0

fn main(): int32 =
    let result = ColdSharedRun()
    if result != 0:
        return result
    echo("cold_nested_managed_value_object_share_smoke: ok")
    return 0
