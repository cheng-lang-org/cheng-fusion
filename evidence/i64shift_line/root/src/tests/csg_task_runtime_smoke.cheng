# CSG 统一事件调度器冒烟 (任务 06 首切片 verify a-h)。
#
# a. 调度等价: 独立 (无依赖) 节点集合, 调度器求值结果与手工串行参考
#    (直接调用 csg_exact_planner) 逐位一致 (status/cost/path/expanded)
# b. 确定性优先: det->learn 依赖链中 deterministic 先求值 (evalOrder 可断言)
# c. 循环依赖 -> 显式 hard-fail 错误 (无静默跳过/启发式解环)
# d. 世代失效: StateCommit 后旧世代结果不再服务派发 (新世代重算=再次在途+
#    再回填), 未受影响闭包 (同节点/同问题/同候选集) 在新世代回填后四键复用命中
# e. 取消: 取消事件后在途 Pending 不回填、无新派发、在途计数归零
# f. 截止时间: 注入时钟过线 -> DeadlinePassed 显式终态, 不忙等 (步数有限可断言)
# g. 预算: 节点派发预算耗尽 -> BudgetExceeded 显式终态
# h. 唯一入口: 六类节点全部经同一 CsgTaskRuntime 推进; 每次派发有且仅有
#    evalOrder 一条记录 (派发记账 = 单推进循环断言), 无第二套推进循环

import std/strings
import std/result
import cheng/core/runtime/csg_decision_contract as dc
import cheng/core/runtime/csg_goal as cgoal
import cheng/core/runtime/csg_action_model as camodel
import cheng/core/runtime/csg_exact_planner as planner
import cheng/core/runtime/csg_task_runtime as rtmod

# ---- 域构造 (与 csg_exact_planner_smoke 同一动作合同, 本文件独立持有) ----

fn addActionConstEffect(actionsOut: var camodel.CsgActionModel,
                        pre: int32,
                        cost: int64,
                        readVar: int32,
                        writeVar: int32,
                        target: int32,
                        constVal: int64): int32 =
    var rd: int32[]
    add(rd, readVar)
    var wr: int32[]
    add(wr, writeVar)
    var ek: int32[]
    add(ek, camodel.CsgActionEffectAssignConst)
    var et: int32[]
    add(et, target)
    var ec: int64[]
    add(ec, constVal)
    var es: int32[]
    add(es, 0 - 1)
    camodel.CsgActionAddAction(actionsOut, pre, cost, uint8(1), rd, wr, ek, et, ec, es)
    return actionsOut.count - 1

# 域 A: door/light, 均匀代价, 目标含 Not 组合。
fn buildDomainA(predsOut: var cgoal.CsgGoalPredicateSet, actionsOut: var camodel.CsgActionModel): int32 =
    let pDoorClosed = cgoal.CsgGoalAddScalarCompare(predsOut, cgoal.CsgGoalPredScalarEq, 0, int64(0))
    let pDoorOpen = cgoal.CsgGoalAddScalarCompare(predsOut, cgoal.CsgGoalPredScalarEq, 0, int64(1))
    let pLightOff = cgoal.CsgGoalAddScalarCompare(predsOut, cgoal.CsgGoalPredScalarEq, 1, int64(0))
    let notLightOff = cgoal.CsgGoalAddNot(predsOut, pLightOff)
    let goal = cgoal.CsgGoalAddAnd(predsOut, pDoorOpen, notLightOff)
    addActionConstEffect(actionsOut, pDoorClosed, int64(1), 0, 0, 0, int64(1))
    addActionConstEffect(actionsOut, pLightOff, int64(1), 1, 1, 1, int64(1))
    return goal

# 域 B: 双 toggle 带环, 均匀代价。
fn buildDomainB(predsOut: var cgoal.CsgGoalPredicateSet, actionsOut: var camodel.CsgActionModel): int32 =
    let p0eq0 = cgoal.CsgGoalAddScalarCompare(predsOut, cgoal.CsgGoalPredScalarEq, 0, int64(0))
    let p0eq1 = cgoal.CsgGoalAddScalarCompare(predsOut, cgoal.CsgGoalPredScalarEq, 0, int64(1))
    let p1eq0 = cgoal.CsgGoalAddScalarCompare(predsOut, cgoal.CsgGoalPredScalarEq, 1, int64(0))
    let p1eq1 = cgoal.CsgGoalAddScalarCompare(predsOut, cgoal.CsgGoalPredScalarEq, 1, int64(1))
    let goal = cgoal.CsgGoalAddAnd(predsOut, p0eq1, p1eq1)
    addActionConstEffect(actionsOut, p0eq0, int64(1), 0, 0, 0, int64(1))
    addActionConstEffect(actionsOut, p0eq1, int64(1), 0, 0, 0, int64(0))
    addActionConstEffect(actionsOut, p1eq0, int64(1), 1, 1, 1, int64(1))
    addActionConstEffect(actionsOut, p1eq1, int64(1), 1, 1, 1, int64(0))
    return goal

# 域 C: 单变量, 零权+正权混合 (必须 Dijkstra)。
fn buildDomainC(predsOut: var cgoal.CsgGoalPredicateSet, actionsOut: var camodel.CsgActionModel): int32 =
    let p0eq0 = cgoal.CsgGoalAddScalarCompare(predsOut, cgoal.CsgGoalPredScalarEq, 0, int64(0))
    let p0eq1 = cgoal.CsgGoalAddScalarCompare(predsOut, cgoal.CsgGoalPredScalarEq, 0, int64(1))
    var members: int64[]
    add(members, int64(2))
    let goal = cgoal.CsgGoalAddInSet(predsOut, 0, members)
    addActionConstEffect(actionsOut, p0eq0, int64(5), 0, 0, 0, int64(2))
    addActionConstEffect(actionsOut, p0eq0, int64(0), 0, 0, 0, int64(1))
    addActionConstEffect(actionsOut, p0eq1, int64(2), 0, 0, 0, int64(2))
    return goal

fn startUnkAll(varCount: int32): uint8[] =
    var u: uint8[]
    for i in 0..<varCount:
        add(u, uint8(0))
    return u

fn startVals2(): int64[] =
    var v: int64[]
    add(v, int64(0))
    add(v, int64(0))
    return v

fn startVals1(): int64[] =
    var v: int64[]
    add(v, int64(0))
    return v

# ---- Noul learn 结果构造 (显式概率 0.5@precision1, 过 decision_validate 门) ----

fn makeNoulResult(learnRef: int32, generation: int64, goalSlot: int32): dc.CsgDecisionLearnResult =
    var probs: dc.CsgDecisionProbValue[]
    var p: dc.CsgDecisionProbValue
    p.numer = int64(5)
    p.precision = 1
    add(probs, p)
    var r: dc.CsgDecisionLearnResult
    r.learnRef = learnRef
    r.generation = generation
    r.headKind = dc.CsgDecisionHeadNoul
    r.noMatch = false
    r.boundGoalRef = goalSlot
    r.chosenCandidate = dc.CsgDecisionChosenNone
    r.probs = probs
    return r

# ---- 图行构造辅助 ----

type
    DetSlots =
        pred: int32
        actionModel: int32
        budget: int32
        evidence: int32

fn addDetSlots(g: var dc.CsgDecisionGraph): DetSlots =
    var s: DetSlots
    s.pred = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindPredicate)
    s.actionModel = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindActionModel)
    s.budget = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindBudget)
    s.evidence = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindEvidence)
    return s

fn addDetRow(g: var dc.CsgDecisionGraph, s: DetSlots): int32 =
    var n: dc.CsgDecisionDeterministicNode
    n.predicateRef = s.pred
    n.actionModelRef = s.actionModel
    n.budgetRef = s.budget
    n.evidenceRef = s.evidence
    n.generation = g.generation
    dc.CsgDecisionDeterministicAdd(g, n)
    return g.deterministics.len - 1

fn addObserveRow(g: var dc.CsgDecisionGraph): int32 =
    let snapshot = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindSnapshot)
    let src = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindReceipt)
    let ev = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindEvidence)
    var n: dc.CsgDecisionObserveNode
    n.snapshotRef = snapshot
    n.generation = g.generation
    n.sourceReceiptRef = src
    n.evidenceRef = ev
    dc.CsgDecisionObserveAdd(g, n)
    return g.observes.len - 1

# Noul learn 行: 槽位固定 [0]=evidence [1]=backend [2]=goal (S2 中 det 槽占 0..3)。
fn addLearnRowNoul(g: var dc.CsgDecisionGraph, evidenceSlot: int32, backendSlot: int32): int32 =
    var ln: dc.CsgDecisionLearnNode
    ln.headKind = dc.CsgDecisionHeadNoul
    ln.candidateSetRef = 0
    ln.candidateCount = 0
    ln.evidenceRef = evidenceSlot
    ln.backendRef = backendSlot
    ln.generation = g.generation
    dc.CsgDecisionLearnAdd(g, ln)
    return g.learns.len - 1

# ---- 断言辅助 ----

fn postGoal(rt: var rtmod.CsgTaskRuntime, label: str) =
    var p = rtmod.CsgTaskRuntimePostEvent(rt, rtmod.CsgTaskEventGoalCommit, int64(0), int64(0))
    assert(!IsErr(p), label + ": post goal commit")

fn runExpect(rt: var rtmod.CsgTaskRuntime, wantStatus: int32, label: str) =
    var r = rtmod.CsgTaskRuntimeRunPass(rt)
    assert(!IsErr(r), label + ": run err: " + Error(r))
    assert(Value(r) == wantStatus, label + ": status mismatch")

fn attachDomainA(rt: var rtmod.CsgTaskRuntime, node: int32) =
    var preds: cgoal.CsgGoalPredicateSet
    var actions: camodel.CsgActionModel
    let goal = buildDomainA(preds, actions)
    var a = rtmod.CsgTaskRuntimeAttachDeterministicPlanner(rt, node, false, goal,
        64, int64(1024), uint8(0), preds, actions, startVals2(), startUnkAll(2))
    assert(!IsErr(a), "attach domain A")

fn attachDomainB(rt: var rtmod.CsgTaskRuntime, node: int32) =
    var preds: cgoal.CsgGoalPredicateSet
    var actions: camodel.CsgActionModel
    let goal = buildDomainB(preds, actions)
    var a = rtmod.CsgTaskRuntimeAttachDeterministicPlanner(rt, node, false, goal,
        64, int64(1024), uint8(0), preds, actions, startVals2(), startUnkAll(2))
    assert(!IsErr(a), "attach domain B")

fn attachDomainC(rt: var rtmod.CsgTaskRuntime, node: int32) =
    var preds: cgoal.CsgGoalPredicateSet
    var actions: camodel.CsgActionModel
    let goal = buildDomainC(preds, actions)
    var a = rtmod.CsgTaskRuntimeAttachDeterministicPlanner(rt, node, true, goal,
        64, int64(1024), uint8(0), preds, actions, startVals1(), startUnkAll(1))
    assert(!IsErr(a), "attach domain C")

# 调度器产出 vs 串行参考逐位一致
fn checkDetOutcome(rt: rtmod.CsgTaskRuntime, node: int32,
                   refOutcome: planner.CsgExactPlannerOutcome, label: str) =
    assert(rtmod.CsgTaskRuntimeDetStatus(share(rt), node) == refOutcome.status, label + ": status")
    assert(rtmod.CsgTaskRuntimeDetCost(share(rt), node) == refOutcome.totalCost, label + ": cost")
    assert(rtmod.CsgTaskRuntimeDetPathLen(share(rt), node) == refOutcome.actions.len, label + ": path length")
    for i in 0..<refOutcome.actions.len:
        assert(rtmod.CsgTaskRuntimeDetPathAt(share(rt), node, i) == refOutcome.actions[i], label + ": path element")
    assert(rtmod.CsgTaskRuntimeDetExpandedStates(share(rt), node) == refOutcome.expandedStates, label + ": expanded states")
    assert(rtmod.CsgTaskRuntimeDetExpandedEdges(share(rt), node) == refOutcome.expandedEdges, label + ": expanded edges")

# ---- verify a: 独立节点集合调度等价 ----

fn s1() =
    var g = dc.CsgDecisionGraphNew(1, int64(100))
    let obsRow = addObserveRow(g)
    let ds = addDetSlots(g)
    let rowA = addDetRow(g, ds)
    let rowB = addDetRow(g, ds)
    let rowC = addDetRow(g, ds)
    var rt = rtmod.CsgTaskRuntimeNew(1, int64(100), 64)
    var ad = rtmod.CsgTaskRuntimeAdoptGraph(rt, g)
    assert(!IsErr(ad), "verify-a: adopt")
    var ro = rtmod.CsgTaskRuntimeRegisterNode(rt, dc.CsgDecisionNodeClassObserve, obsRow, int64(0))
    assert(!IsErr(ro), "verify-a: register observe")
    let nodeObs = Value(ro)
    var ra = rtmod.CsgTaskRuntimeRegisterNode(rt, dc.CsgDecisionNodeClassDeterministic, rowA, int64(0))
    assert(!IsErr(ra), "verify-a: register A")
    let nodeA = Value(ra)
    var rb = rtmod.CsgTaskRuntimeRegisterNode(rt, dc.CsgDecisionNodeClassDeterministic, rowB, int64(0))
    assert(!IsErr(rb), "verify-a: register B")
    let nodeB = Value(rb)
    var rc = rtmod.CsgTaskRuntimeRegisterNode(rt, dc.CsgDecisionNodeClassDeterministic, rowC, int64(0))
    assert(!IsErr(rc), "verify-a: register C")
    let nodeC = Value(rc)
    attachDomainA(rt, nodeA)
    attachDomainB(rt, nodeB)
    attachDomainC(rt, nodeC)
    postGoal(rt, "verify-a")
    runExpect(rt, rtmod.CsgTaskStatusComplete, "verify-a")
    # 手工串行参考: 与调度器相同的域, 直接调用精确规划器
    var refPredsA: cgoal.CsgGoalPredicateSet
    var refActionsA: camodel.CsgActionModel
    let refGoalA = buildDomainA(refPredsA, refActionsA)
    var opts: planner.CsgExactPlannerOptions
    opts.degenerateConstantHash = uint8(0)
    let refA = planner.CsgExactPlannerPlanBfs(refPredsA, refGoalA, refActionsA,
        startVals2(), startUnkAll(2), 64, int64(1024), opts)
    var refPredsB: cgoal.CsgGoalPredicateSet
    var refActionsB: camodel.CsgActionModel
    let refGoalB = buildDomainB(refPredsB, refActionsB)
    let refB = planner.CsgExactPlannerPlanBfs(refPredsB, refGoalB, refActionsB,
        startVals2(), startUnkAll(2), 64, int64(1024), opts)
    var refPredsC: cgoal.CsgGoalPredicateSet
    var refActionsC: camodel.CsgActionModel
    let refGoalC = buildDomainC(refPredsC, refActionsC)
    let refC = planner.CsgExactPlannerPlanDijkstra(refPredsC, refGoalC, refActionsC,
        startVals1(), startUnkAll(1), 64, int64(1024), opts)
    checkDetOutcome(share(rt), nodeA, refA, "verify-a(A)")
    checkDetOutcome(share(rt), nodeB, refB, "verify-a(B)")
    checkDetOutcome(share(rt), nodeC, refC, "verify-a(C)")
    assert(refA.totalCost == int64(2) && refB.totalCost == int64(2) && refC.totalCost == int64(2),
        "verify-a: reference costs sanity")
    # 派发顺序确定性: 就绪集按下标序, observe -> A -> B -> C
    assert(rtmod.CsgTaskRuntimeEvalOrderLen(share(rt)) == 4, "verify-a: eval order length")
    assert(rtmod.CsgTaskRuntimeEvalOrderAt(share(rt), 0) == nodeObs, "verify-a: order[0]")
    assert(rtmod.CsgTaskRuntimeEvalOrderAt(share(rt), 1) == nodeA, "verify-a: order[1]")
    assert(rtmod.CsgTaskRuntimeEvalOrderAt(share(rt), 2) == nodeB, "verify-a: order[2]")
    assert(rtmod.CsgTaskRuntimeEvalOrderAt(share(rt), 3) == nodeC, "verify-a: order[3]")
    assert(rtmod.CsgTaskRuntimeDispatchUsed(share(rt)) == 4, "verify-a: dispatch accounting")
    assert(rtmod.CsgTaskRuntimeStepCount(share(rt)) == 5, "verify-a: finite steps (1 event + 4 dispatches)")
    echo("verify-a ok: independent nodes bit-equal to serial reference (A/B/C + observe)")

# ---- verify b: deterministic 先于依赖它的 learn 求值 ----

fn s2() =
    var g = dc.CsgDecisionGraphNew(1, int64(100))
    let ds = addDetSlots(g)
    let detRow = addDetRow(g, ds)
    let learnEv = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindEvidence)
    let learnBe = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindBackend)
    let learnGoal = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindGoal)
    let learnRow = addLearnRowNoul(g, learnEv, learnBe)
    var rt = rtmod.CsgTaskRuntimeNew(1, int64(100), 64)
    var ad = rtmod.CsgTaskRuntimeAdoptGraph(rt, g)
    assert(!IsErr(ad), "verify-b: adopt")
    var rd = rtmod.CsgTaskRuntimeRegisterNode(rt, dc.CsgDecisionNodeClassDeterministic, detRow, int64(0))
    assert(!IsErr(rd), "verify-b: register det")
    let nodeDet = Value(rd)
    var rl = rtmod.CsgTaskRuntimeRegisterNode(rt, dc.CsgDecisionNodeClassLearn, learnRow, int64(7))
    assert(!IsErr(rl), "verify-b: register learn")
    let nodeLearn = Value(rl)
    var de = rtmod.CsgTaskRuntimeAddDependency(rt, nodeDet, nodeLearn)
    assert(!IsErr(de), "verify-b: dependency")
    attachDomainA(rt, nodeDet)
    postGoal(rt, "verify-b")
    runExpect(rt, rtmod.CsgTaskStatusActive, "verify-b: wave1 waits learn backfill")
    # 求值顺序: det 同步求值完成后 learn 才派发为在途
    assert(rtmod.CsgTaskRuntimeEvalOrderLen(share(rt)) == 2, "verify-b: two dispatches")
    assert(rtmod.CsgTaskRuntimeEvalOrderAt(share(rt), 0) == nodeDet, "verify-b: deterministic first")
    assert(rtmod.CsgTaskRuntimeEvalOrderAt(share(rt), 1) == nodeLearn, "verify-b: learn second")
    assert(rtmod.CsgTaskRuntimeDetStatus(share(rt), nodeDet) == planner.CsgExactPlannerGoalReached,
        "verify-b: det evaluated before learn dispatch")
    assert(rtmod.CsgTaskRuntimeNodeState(share(rt), nodeLearn) == rtmod.CsgTaskNodeStatePending,
        "verify-b: learn pending in-flight")
    assert(rtmod.CsgTaskRuntimeInflightCount(share(rt)) == 1, "verify-b: one in-flight")
    # 在途回填 (绑定当前世代 learn 行)
    let res = makeNoulResult(rtmod.CsgTaskRuntimeNodeRow(share(rt), nodeLearn), int64(100), learnGoal)
    var cl = rtmod.CsgTaskRuntimeCompleteLearn(rt, nodeLearn, int64(7), res)
    assert(!IsErr(cl), "verify-b: complete learn")
    assert(rtmod.CsgTaskRuntimeNodeState(share(rt), nodeLearn) == rtmod.CsgTaskNodeStateDone, "verify-b: learn done")
    assert(rtmod.CsgTaskRuntimeInflightCount(share(rt)) == 0, "verify-b: in-flight drained")
    assert(rtmod.CsgTaskRuntimeLearnCacheProbe(share(rt), nodeLearn, int64(100), int64(7), 0, 0),
        "verify-b: result bound to (node,generation,problem,candidates)")
    assert(rtmod.CsgTaskRuntimeStatus(share(rt)) == rtmod.CsgTaskStatusComplete, "verify-b: all settled")
    # 重复回填显式拒绝 (节点已非在途)
    let resDup = makeNoulResult(rtmod.CsgTaskRuntimeNodeRow(share(rt), nodeLearn), int64(100), learnGoal)
    var clDup = rtmod.CsgTaskRuntimeCompleteLearn(rt, nodeLearn, int64(7), resDup)
    assert(IsErr(clDup), "verify-b: duplicate completion rejected")
    echo("verify-b ok: deterministic evaluated before dependent learn (eval order asserted)")

# ---- verify c: 循环依赖显式 hard-fail ----

fn s3() =
    var g = dc.CsgDecisionGraphNew(1, int64(100))
    let ds = addDetSlots(g)
    let row0 = addDetRow(g, ds)
    let row1 = addDetRow(g, ds)
    var rt = rtmod.CsgTaskRuntimeNew(1, int64(100), 64)
    var ad = rtmod.CsgTaskRuntimeAdoptGraph(rt, g)
    assert(!IsErr(ad), "verify-c: adopt")
    var r0 = rtmod.CsgTaskRuntimeRegisterNode(rt, dc.CsgDecisionNodeClassDeterministic, row0, int64(0))
    let node0 = Value(r0)
    var r1 = rtmod.CsgTaskRuntimeRegisterNode(rt, dc.CsgDecisionNodeClassDeterministic, row1, int64(0))
    let node1 = Value(r1)
    var d01 = rtmod.CsgTaskRuntimeAddDependency(rt, node0, node1)
    assert(!IsErr(d01), "verify-c: edge 0->1")
    var d10 = rtmod.CsgTaskRuntimeAddDependency(rt, node1, node0)
    assert(!IsErr(d10), "verify-c: edge 1->0")
    postGoal(rt, "verify-c")
    var r = rtmod.CsgTaskRuntimeRunPass(rt)
    assert(IsErr(r), "verify-c: run must hard-fail")
    assert(Error(r) == "InvalidOutput: task runtime dependency cycle", "verify-c: explicit verdict")
    assert(rtmod.CsgTaskRuntimeStatus(share(rt)) == rtmod.CsgTaskStatusFailed, "verify-c: failed terminal")
    assert(rtmod.CsgTaskRuntimeNodeState(share(rt), node0) == rtmod.CsgTaskNodeStateTerminal, "verify-c: node0 terminal")
    assert(rtmod.CsgTaskRuntimeNodeState(share(rt), node1) == rtmod.CsgTaskNodeStateTerminal, "verify-c: node1 terminal")
    assert(rtmod.CsgTaskRuntimeFailureCount(share(rt)) == 2, "verify-c: explicit failure records")
    echo("verify-c ok: dependency cycle hard-fails with explicit error, no silent skip")

# ---- verify d: 世代失效与四键复用 ----

fn s4() =
    var g = dc.CsgDecisionGraphNew(1, int64(100))
    let learnEv = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindEvidence)
    let learnBe = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindBackend)
    let learnGoal = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindGoal)
    let learnRow = addLearnRowNoul(g, learnEv, learnBe)
    var rt = rtmod.CsgTaskRuntimeNew(1, int64(100), 64)
    var ad = rtmod.CsgTaskRuntimeAdoptGraph(rt, g)
    assert(!IsErr(ad), "verify-d: adopt")
    var rl = rtmod.CsgTaskRuntimeRegisterNode(rt, dc.CsgDecisionNodeClassLearn, learnRow, int64(7))
    assert(!IsErr(rl), "verify-d: register")
    let nodeLearn = Value(rl)
    postGoal(rt, "verify-d: gen100 wave")
    runExpect(rt, rtmod.CsgTaskStatusActive, "verify-d: gen100")
    assert(rtmod.CsgTaskRuntimeNodeState(share(rt), nodeLearn) == rtmod.CsgTaskNodeStatePending, "verify-d: pending")
    assert(!rtmod.CsgTaskRuntimeLearnCacheProbe(share(rt), nodeLearn, int64(100), int64(7), 0, 0),
        "verify-d: not cached before backfill")
    let res100 = makeNoulResult(rtmod.CsgTaskRuntimeNodeRow(share(rt), nodeLearn), int64(100), learnGoal)
    var cl = rtmod.CsgTaskRuntimeCompleteLearn(rt, nodeLearn, int64(7), res100)
    assert(!IsErr(cl), "verify-d: gen100 backfill")
    assert(rtmod.CsgTaskRuntimeLearnCacheProbe(share(rt), nodeLearn, int64(100), int64(7), 0, 0),
        "verify-d: gen100 result cached under four-key binding")
    # 状态提交 -> 新世代 (整快照重铸)
    let slotCountBefore = rtmod.CsgTaskRuntimeSlotCount(share(rt))
    var ps = rtmod.CsgTaskRuntimePostEvent(rt, rtmod.CsgTaskEventStateCommit, int64(101), int64(0))
    assert(!IsErr(ps), "verify-d: state commit")
    runExpect(rt, rtmod.CsgTaskStatusActive, "verify-d: gen101 wave")
    assert(rtmod.CsgTaskRuntimeSlotCount(share(rt)) == slotCountBefore * 2, "verify-d: whole-snapshot remint")
    # 旧世代结果不服务新派发: 节点重新在途 (重算), 复用表新世代键未命中
    assert(rtmod.CsgTaskRuntimeNodeState(share(rt), nodeLearn) == rtmod.CsgTaskNodeStatePending,
        "verify-d: stale generation result not reused; node recomputes in-flight")
    assert(!rtmod.CsgTaskRuntimeLearnCacheProbe(share(rt), nodeLearn, int64(101), int64(7), 0, 0),
        "verify-d: new generation key misses before re-backfill")
    assert(rtmod.CsgTaskRuntimeInflightCount(share(rt)) == 1, "verify-d: re-dispatch in-flight")
    # 新世代回填 (重铸后 learn 行 = 1, goal 槽 = 2 + slotCountBefore)
    let newRow = rtmod.CsgTaskRuntimeNodeRow(share(rt), nodeLearn)
    assert(newRow == 1, "verify-d: learn row reminted")
    let newGoal = learnGoal + slotCountBefore
    let res101 = makeNoulResult(newRow, int64(101), newGoal)
    var cl2 = rtmod.CsgTaskRuntimeCompleteLearn(rt, nodeLearn, int64(7), res101)
    assert(!IsErr(cl2), "verify-d: gen101 backfill")
    assert(rtmod.CsgTaskRuntimeLearnCacheProbe(share(rt), nodeLearn, int64(101), int64(7), 0, 0),
        "verify-d: unaffected closure (same node/problem/candidates) reused in new generation")
    assert(rtmod.CsgTaskRuntimeDispatchUsed(share(rt)) == 2, "verify-d: recomputed across generations")
    assert(rtmod.CsgTaskRuntimeStatus(share(rt)) == rtmod.CsgTaskStatusComplete, "verify-d: settled")
    echo("verify-d ok: stale generation never reused; new generation recomputes; four-key cache hits")

# ---- verify e: 取消 ----

fn s5() =
    var g = dc.CsgDecisionGraphNew(1, int64(100))
    let learnEv = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindEvidence)
    let learnBe = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindBackend)
    let learnGoal = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindGoal)
    let learnRow = addLearnRowNoul(g, learnEv, learnBe)
    var rt = rtmod.CsgTaskRuntimeNew(1, int64(100), 64)
    var ad = rtmod.CsgTaskRuntimeAdoptGraph(rt, g)
    assert(!IsErr(ad), "verify-e: adopt")
    var rl = rtmod.CsgTaskRuntimeRegisterNode(rt, dc.CsgDecisionNodeClassLearn, learnRow, int64(7))
    let nodeLearn = Value(rl)
    postGoal(rt, "verify-e")
    runExpect(rt, rtmod.CsgTaskStatusActive, "verify-e: in-flight")
    assert(rtmod.CsgTaskRuntimeInflightCount(share(rt)) == 1, "verify-e: one in-flight before cancel")
    var pc = rtmod.CsgTaskRuntimePostEvent(rt, rtmod.CsgTaskEventCancel, int64(0), int64(0))
    assert(!IsErr(pc), "verify-e: post cancel")
    runExpect(rt, rtmod.CsgTaskStatusCancelled, "verify-e: cancelled terminal")
    assert(rtmod.CsgTaskRuntimeInflightCount(share(rt)) == 0, "verify-e: in-flight released to zero")
    assert(rtmod.CsgTaskRuntimeNodeState(share(rt), nodeLearn) == rtmod.CsgTaskNodeStateTerminal,
        "verify-e: pending voided")
    # 取消后在途结果不回填
    let resLate = makeNoulResult(rtmod.CsgTaskRuntimeNodeRow(share(rt), nodeLearn), int64(100), learnGoal)
    var cl = rtmod.CsgTaskRuntimeCompleteLearn(rt, nodeLearn, int64(7), resLate)
    assert(IsErr(cl), "verify-e: late backfill rejected")
    # 取消后无新派发, 新事件显式拒绝
    var pg = rtmod.CsgTaskRuntimePostEvent(rt, rtmod.CsgTaskEventGoalCommit, int64(0), int64(0))
    assert(IsErr(pg), "verify-e: events rejected after cancel")
    var r2 = rtmod.CsgTaskRuntimeRunPass(rt)
    assert(!IsErr(r2) && Value(r2) == rtmod.CsgTaskStatusCancelled, "verify-e: stays cancelled")
    assert(rtmod.CsgTaskRuntimeEvalOrderLen(share(rt)) == 1, "verify-e: no dispatch after cancel")
    echo("verify-e ok: cancel voids in-flight (count 0), rejects backfill, dispatches nothing")

# ---- verify f: 截止时间 (注入时钟, 不忙等) ----

fn s6() =
    var g = dc.CsgDecisionGraphNew(1, int64(100))
    let learnEv = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindEvidence)
    let learnBe = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindBackend)
    let learnRow = addLearnRowNoul(g, learnEv, learnBe)
    var rt = rtmod.CsgTaskRuntimeNew(1, int64(100), 64)
    var ad = rtmod.CsgTaskRuntimeAdoptGraph(rt, g)
    assert(!IsErr(ad), "verify-f: adopt")
    var rl = rtmod.CsgTaskRuntimeRegisterNode(rt, dc.CsgDecisionNodeClassLearn, learnRow, int64(7))
    let nodeLearn = Value(rl)
    rtmod.CsgTaskRuntimeSetDeadline(rt, int64(100))
    rtmod.CsgTaskRuntimeInjectClock(rt, int64(0))
    postGoal(rt, "verify-f")
    runExpect(rt, rtmod.CsgTaskStatusActive, "verify-f: before deadline")
    assert(rtmod.CsgTaskRuntimeNodeState(share(rt), nodeLearn) == rtmod.CsgTaskNodeStatePending, "verify-f: pending")
    let stepsAfterWave = rtmod.CsgTaskRuntimeStepCount(share(rt))
    # 无事件再推进: 不产生任何步 (无忙轮询/无固定间隔重问)
    var rIdle = rtmod.CsgTaskRuntimeRunPass(rt)
    assert(!IsErr(rIdle) && Value(rIdle) == rtmod.CsgTaskStatusActive, "verify-f: idle pass active")
    assert(rtmod.CsgTaskRuntimeStepCount(share(rt)) == stepsAfterWave, "verify-f: zero steps while waiting")
    # 注入时钟过线 (定时事件携带读数)
    var pd = rtmod.CsgTaskRuntimePostEvent(rt, rtmod.CsgTaskEventDeadline, int64(0), int64(200))
    assert(!IsErr(pd), "verify-f: post deadline event")
    runExpect(rt, rtmod.CsgTaskStatusDeadlinePassed, "verify-f: deadline terminal")
    assert(rtmod.CsgTaskRuntimeNodeState(share(rt), nodeLearn) == rtmod.CsgTaskNodeStateTerminal,
        "verify-f: pending voided by deadline")
    assert(rtmod.CsgTaskRuntimeInflightCount(share(rt)) == 0, "verify-f: in-flight released")
    let stepsTotal = rtmod.CsgTaskRuntimeStepCount(share(rt))
    assert(stepsTotal == stepsAfterWave + 1, "verify-f: exact finite steps (deadline event; pending voided, no dispatch)")
    var rAgain = rtmod.CsgTaskRuntimeRunPass(rt)
    assert(!IsErr(rAgain) && Value(rAgain) == rtmod.CsgTaskStatusDeadlinePassed, "verify-f: stays terminal")
    assert(rtmod.CsgTaskRuntimeStepCount(share(rt)) == stepsTotal, "verify-f: no steps after terminal")
    var pAfter = rtmod.CsgTaskRuntimePostEvent(rt, rtmod.CsgTaskEventGoalCommit, int64(0), int64(0))
    assert(IsErr(pAfter), "verify-f: terminal rejects events")
    echo("verify-f ok: injected clock crossing ends in DeadlinePassed, bounded steps, no busy wait")

# ---- verify g: 派发预算耗尽 ----

fn s7() =
    var g = dc.CsgDecisionGraphNew(1, int64(100))
    let obsRow0 = addObserveRow(g)
    let obsRow1 = addObserveRow(g)
    var rt = rtmod.CsgTaskRuntimeNew(1, int64(100), 1)
    var ad = rtmod.CsgTaskRuntimeAdoptGraph(rt, g)
    assert(!IsErr(ad), "verify-g: adopt")
    var r0 = rtmod.CsgTaskRuntimeRegisterNode(rt, dc.CsgDecisionNodeClassObserve, obsRow0, int64(0))
    let node0 = Value(r0)
    var r1 = rtmod.CsgTaskRuntimeRegisterNode(rt, dc.CsgDecisionNodeClassObserve, obsRow1, int64(0))
    let node1 = Value(r1)
    postGoal(rt, "verify-g")
    runExpect(rt, rtmod.CsgTaskStatusBudgetExceeded, "verify-g: budget terminal")
    assert(rtmod.CsgTaskRuntimeNodeState(share(rt), node0) == rtmod.CsgTaskNodeStateDone, "verify-g: first dispatched")
    assert(rtmod.CsgTaskRuntimeNodeState(share(rt), node1) == rtmod.CsgTaskNodeStateIdle, "verify-g: second never dispatched")
    assert(rtmod.CsgTaskRuntimeEvalOrderLen(share(rt)) == 1, "verify-g: only one dispatch recorded")
    assert(rtmod.CsgTaskRuntimeFailureCount(share(rt)) == 1, "verify-g: explicit BudgetExceeded failure row")
    let stepsAtBudget = rtmod.CsgTaskRuntimeStepCount(share(rt))
    var rAgain = rtmod.CsgTaskRuntimeRunPass(rt)
    assert(!IsErr(rAgain) && Value(rAgain) == rtmod.CsgTaskStatusBudgetExceeded, "verify-g: stays terminal")
    assert(rtmod.CsgTaskRuntimeStepCount(share(rt)) == stepsAtBudget, "verify-g: no steps after terminal")
    var pAfter = rtmod.CsgTaskRuntimePostEvent(rt, rtmod.CsgTaskEventGoalCommit, int64(0), int64(0))
    assert(IsErr(pAfter), "verify-g: terminal rejects events")
    echo("verify-g ok: dispatch budget exhaustion ends in explicit BudgetExceeded")

# ---- verify h: 六类节点唯一入口 (det->action->execute->receipt 链) ----

type
    ChainSetup =
        rt: rtmod.CsgTaskRuntime
        nodeDet: int32
        nodeAction: int32
        nodeExec: int32
        nodeRcpt: int32

fn setupChain(): ChainSetup =
    var g = dc.CsgDecisionGraphNew(1, int64(100))
    let ds = addDetSlots(g)
    let goalSlot = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindGoal)
    let opSlot = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindActionModel)
    let preSlot = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindPrecondition)
    let effSlot = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindEffectContract)
    let authSlot = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindAuthorization)
    let caSlot = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindCommitAuthority)
    let detRow = addDetRow(g, ds)
    var cand: dc.CsgDecisionCandidate
    cand.goalRef = goalSlot
    cand.operationRef = opSlot
    var noParams: int32[]
    cand.paramSlots = noParams
    cand.preconditionRef = preSlot
    cand.effectContractRef = effSlot
    cand.generation = int64(100)
    dc.CsgDecisionCandidateAdd(g, cand)
    var act: dc.CsgDecisionActionNode
    act.candidateRef = 0
    act.authorizationRef = authSlot
    act.preconditionRef = preSlot
    act.generation = int64(100)
    dc.CsgDecisionActionAdd(g, act)
    var exe: dc.CsgDecisionExecuteNode
    exe.actionRef = 0
    exe.commitAuthorityRef = caSlot
    exe.generation = int64(100)
    dc.CsgDecisionExecuteAdd(g, exe)
    var rcpt: dc.CsgDecisionReceiptNode
    rcpt.executionRef = 0
    rcpt.goalPredicateRef = ds.pred
    rcpt.generation = int64(100)
    dc.CsgDecisionReceiptAdd(g, rcpt)
    var rt = rtmod.CsgTaskRuntimeNew(1, int64(100), 64)
    var ad = rtmod.CsgTaskRuntimeAdoptGraph(rt, g)
    assert(!IsErr(ad), "chain: adopt")
    var rd = rtmod.CsgTaskRuntimeRegisterNode(rt, dc.CsgDecisionNodeClassDeterministic, detRow, int64(0))
    assert(!IsErr(rd), "chain: register det")
    var ra = rtmod.CsgTaskRuntimeRegisterNode(rt, dc.CsgDecisionNodeClassAction, 0, int64(0))
    assert(!IsErr(ra), "chain: register action")
    var re = rtmod.CsgTaskRuntimeRegisterNode(rt, dc.CsgDecisionNodeClassExecute, 0, int64(0))
    assert(!IsErr(re), "chain: register execute")
    var rr = rtmod.CsgTaskRuntimeRegisterNode(rt, dc.CsgDecisionNodeClassReceipt, 0, int64(0))
    assert(!IsErr(rr), "chain: register receipt")
    var e1 = rtmod.CsgTaskRuntimeAddDependency(rt, Value(rd), Value(ra))
    assert(!IsErr(e1), "chain: edge det->action")
    var e2 = rtmod.CsgTaskRuntimeAddDependency(rt, Value(ra), Value(re))
    assert(!IsErr(e2), "chain: edge action->execute")
    var e3 = rtmod.CsgTaskRuntimeAddDependency(rt, Value(re), Value(rr))
    assert(!IsErr(e3), "chain: edge execute->receipt")
    attachDomainB(rt, Value(rd))
    var out: ChainSetup
    out.rt = rt
    out.nodeDet = Value(rd)
    out.nodeAction = Value(ra)
    out.nodeExec = Value(re)
    out.nodeRcpt = Value(rr)
    return out

fn s8() =
    var s = setupChain()
    postGoal(s.rt, "verify-h: wave1")
    runExpect(s.rt, rtmod.CsgTaskStatusActive, "verify-h: execute in-flight")
    assert(rtmod.CsgTaskRuntimeEvalOrderLen(s.rt) == 3, "verify-h: det/action/execute dispatched")
    assert(rtmod.CsgTaskRuntimeEvalOrderAt(s.rt, 0) == s.nodeDet, "verify-h: det first")
    assert(rtmod.CsgTaskRuntimeEvalOrderAt(s.rt, 1) == s.nodeAction, "verify-h: action after det")
    assert(rtmod.CsgTaskRuntimeEvalOrderAt(s.rt, 2) == s.nodeExec, "verify-h: execute after action")
    assert(rtmod.CsgTaskRuntimeNodeState(s.rt, s.nodeExec) == rtmod.CsgTaskNodeStatePending,
        "verify-h: execute in-flight")
    # 执行前重验已过门 (action 引用全部经 decision_validate), 回执注入
    var ce = rtmod.CsgTaskRuntimeCompleteExecute(s.rt, s.nodeExec, rtmod.CsgTaskExecOutcomeOk)
    assert(!IsErr(ce), "verify-h: receipt ok")
    assert(rtmod.CsgTaskRuntimeNodeState(s.rt, s.nodeExec) == rtmod.CsgTaskNodeStateDone, "verify-h: execute done")
    postGoal(s.rt, "verify-h: wave2")
    runExpect(s.rt, rtmod.CsgTaskStatusComplete, "verify-h: complete")
    assert(rtmod.CsgTaskRuntimeEvalOrderLen(s.rt) == 4, "verify-h: receipt dispatched last")
    assert(rtmod.CsgTaskRuntimeEvalOrderAt(s.rt, 3) == s.nodeRcpt, "verify-h: receipt order")
    assert(rtmod.CsgTaskRuntimeRcptOutcomeAt(s.rt, s.nodeRcpt) == rtmod.CsgTaskExecOutcomeOk,
        "verify-h: receipt binds real execute outcome")
    assert(rtmod.CsgTaskRuntimeDispatchUsed(s.rt) == rtmod.CsgTaskRuntimeEvalOrderLen(s.rt),
        "verify-h: single dispatch accounting (no second advance loop)")
    echo("verify-h ok: det/action/execute/receipt advanced by the one scheduler; receipt binds outcome")

fn s8Unknown() =
    var s = setupChain()
    postGoal(s.rt, "verify-h-unknown: wave1")
    runExpect(s.rt, rtmod.CsgTaskStatusActive, "verify-h-unknown: in-flight")
    var ce = rtmod.CsgTaskRuntimeCompleteExecute(s.rt, s.nodeExec, rtmod.CsgTaskExecOutcomeUnknown)
    assert(!IsErr(ce), "verify-h-unknown: unknown outcome accepted as explicit state")
    postGoal(s.rt, "verify-h-unknown: wave2")
    runExpect(s.rt, rtmod.CsgTaskStatusComplete, "verify-h-unknown: complete with unknown")
    assert(rtmod.CsgTaskRuntimeRcptOutcomeAt(s.rt, s.nodeRcpt) == rtmod.CsgTaskExecOutcomeUnknown,
        "verify-h-unknown: receipt binds UnknownOutcome (no blind resend, no fake success)")
    echo("verify-h ok (unknown): UnknownOutcome recorded and propagated to receipt as pending-verify")

fn s8Failed() =
    var s = setupChain()
    postGoal(s.rt, "verify-h-failed: wave1")
    runExpect(s.rt, rtmod.CsgTaskStatusActive, "verify-h-failed: in-flight")
    var ce = rtmod.CsgTaskRuntimeCompleteExecute(s.rt, s.nodeExec, rtmod.CsgTaskExecOutcomeFailed)
    assert(IsErr(ce), "verify-h-failed: failed execution is explicit error")
    assert(rtmod.CsgTaskRuntimeStatus(s.rt) == rtmod.CsgTaskStatusFailed, "verify-h-failed: failed terminal")
    assert(rtmod.CsgTaskRuntimeNodeState(s.rt, s.nodeExec) == rtmod.CsgTaskNodeStateTerminal,
        "verify-h-failed: execute terminal")
    assert(rtmod.CsgTaskRuntimeNodeState(s.rt, s.nodeRcpt) == rtmod.CsgTaskNodeStateTerminal,
        "verify-h-failed: dependent receipt cascaded terminal")
    echo("verify-h ok (failed): execution failure cascades explicitly to dependent receipt")

fn s9AuthEvent() =
    var g = dc.CsgDecisionGraphNew(1, int64(100))
    let learnEv = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindEvidence)
    let learnBe = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindBackend)
    let learnRow = addLearnRowNoul(g, learnEv, learnBe)
    var rt = rtmod.CsgTaskRuntimeNew(1, int64(100), 64)
    var ad = rtmod.CsgTaskRuntimeAdoptGraph(rt, g)
    assert(!IsErr(ad), "auth: adopt")
    var rl = rtmod.CsgTaskRuntimeRegisterNode(rt, dc.CsgDecisionNodeClassLearn, learnRow, int64(7))
    let nodeLearn = Value(rl)
    var pa = rtmod.CsgTaskRuntimePostEvent(rt, rtmod.CsgTaskEventAuthorizationChanged, int64(0), int64(0))
    assert(!IsErr(pa), "auth: accepted as injected event")
    postGoal(rt, "auth")
    runExpect(rt, rtmod.CsgTaskStatusActive, "auth: running")
    assert(rtmod.CsgTaskRuntimeAuthVersion(share(rt)) == 1, "auth: version bumped")
    assert(rtmod.CsgTaskRuntimeNodeState(share(rt), nodeLearn) == rtmod.CsgTaskNodeStatePending, "auth: scheduling intact")
    echo("verify-h ok (auth): authorization-change event is a scheduler-advanced event (admission re-verify wiring = task 05)")

fn main(): int32 =
    s1()
    s2()
    s3()
    s4()
    s5()
    s6()
    s7()
    s8()
    s8Unknown()
    s8Failed()
    s9AuthEvent()
    echo("csg_task_runtime_smoke ok")
    return 0
