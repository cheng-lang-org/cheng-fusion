type
    Bucket =
        head: int32
        next: int32
        stamp: int32

    Lookup =
        buckets: Bucket[]

    Layer =
        lookup: Lookup

fn ReplaceBucket(layer: var Layer, index: int32, value: Bucket) =
    layer.lookup.buckets[index] = value

fn main(): int32 =
    var layer: Layer
    add(layer.lookup.buckets, Bucket(head: 1, next: 2, stamp: 3))
    add(layer.lookup.buckets, Bucket(head: 4, next: 5, stamp: 6))
    ReplaceBucket(layer, 1, Bucket(head: 17, next: 19, stamp: 23))

    let first = layer.lookup.buckets[0]
    let second = layer.lookup.buckets[1]
    if first.stamp != 3:
        return 1
    if second.head != 17:
        return 2
    if second.next != 19:
        return 3
    if second.stamp != 23:
        return 4
    echo("cold_nested_inline_object_seq_index_assign_smoke ok")
    return 0
