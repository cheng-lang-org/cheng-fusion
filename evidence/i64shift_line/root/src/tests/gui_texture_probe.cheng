# GUI texture probe (CSG player windowing scout): prove that an in-memory
# self-drawn BGRA frame can become a real MTLPixelFormatBGRA8Unorm MTLTexture
# on the default GPU device from a pure-cheng program, and that the std/gui
# drawlist texture command accepts such a handle. Same @importc objc_msgSend
# bridge pattern as src/tests/metal_compute_probe.cheng and
# src/core/runtime/core_runtime_provider_darwin.cheng.
# Closed loop: host RGBA bytes -> compute kernel writes the MTLTexture
# (BGRA8Unorm) -> second kernel reads the texture back -> byte-exact assert,
# then the texture handle is registered into a drawlist and its rect/size/
# metrics are asserted (pure cheng).
# Display (pixels on screen) is NOT exercised: in --emit:exe mode the darwin
# GUI provider is headless bookkeeping, so the drawlist assert covers the
# command recording only.
# PASS prints "PASS gui texture probe" (rc 0); every failure prints its exact
# stage and returns a distinct nonzero rc.

import std/strings as strings
import std/gui as gui

type
    Int32Ptr = int32 *
    UInt8Ptr = uint8 *
    ProbeSize =
        width: uint64
        height: uint64
        depth: uint64

# ---- bridge section: ObjC/Metal boundary ----
@importc("MTLCreateSystemDefaultDevice")
fn probe_mtl_create_system_default_device(): ptr
@importc("objc_getClass")
fn probe_objc_get_class(name: ptr): ptr
@importc("sel_registerName")
fn probe_sel_register_name(name: ptr): ptr
@importc("objc_autoreleasePoolPush")
fn probe_objc_autorelease_pool_push(): ptr
@importc("objc_autoreleasePoolPop")
fn probe_objc_autorelease_pool_pop(pool: ptr)
@importc("objc_msgSend")
fn probe_msg_send0(receiver: ptr, sel: ptr): ptr
@importc("objc_msgSend")
fn probe_msg_send_u64_return(receiver: ptr, sel: ptr): uint64
@importc("objc_msgSend")
fn probe_msg_send_ptr(receiver: ptr, sel: ptr, a0: ptr): ptr
@importc("objc_msgSend")
fn probe_msg_send_ptr_ptr(receiver: ptr, sel: ptr, a0: ptr, a1: ptr): ptr
@importc("objc_msgSend")
fn probe_msg_send_ptr_ptr_ptr(receiver: ptr, sel: ptr, a0: ptr, a1: ptr, a2: ptr): ptr
@importc("objc_msgSend")
fn probe_msg_send_ptr_u64_u64(receiver: ptr, sel: ptr, a0: ptr, a1: uint64, a2: uint64): ptr
@importc("objc_msgSend")
fn probe_msg_send_u64_u64(receiver: ptr, sel: ptr, a0: uint64, a1: uint64): ptr
@importc("objc_msgSend")
fn probe_msg_send_set_buffer(receiver: ptr, sel: ptr, buffer: ptr, offset: ptr, index: ptr)
@importc("objc_msgSend")
fn probe_msg_send_set_pipeline(receiver: ptr, sel: ptr, pipeline: ptr)
@importc("objc_msgSend")
fn probe_msg_send_set_texture(receiver: ptr, sel: ptr, texture: ptr, index: uint64)
@importc("objc_msgSend")
fn probe_msg_send_set_u64(receiver: ptr, sel: ptr, value: uint64)
@importc("objc_msgSend")
fn probe_msg_send_void0(receiver: ptr, sel: ptr)
@importc("objc_msgSend")
fn probe_msg_send_dispatch_threads(receiver: ptr, sel: ptr, grid: ProbeSize, group: ProbeSize)
@importc("malloc")
fn probe_libc_malloc(size: int64): ptr
@importc("free")
fn probe_libc_free(p: ptr)
@importc("strlen")
fn probe_libc_strlen(text: ptr): int64
@importc("write")
fn probe_libc_write(fd: int32, buf: ptr, n: uint64): int64

fn probe_dump_nserror(err: ptr) =
    if err == nil:
        return
    let descObj: ptr = probe_msg_send0(err, probe_sel_register_name("localizedDescription"))
    if descObj == nil:
        return
    let utf8: ptr = probe_msg_send0(descObj, probe_sel_register_name("UTF8String"))
    if utf8 == nil:
        return
    let n: int64 = probe_libc_strlen(utf8)
    if n <= 0:
        return
    let wr: int64 = probe_libc_write(2, utf8, uint64(n))
    if wr <= 0:
        return
# ---- end bridge section ----

const
    ProbeWidth: int32 = 32
    ProbeHeight: int32 = 16
    ProbePixelCount: int32 = 512
    ProbeBytes: int32 = 2048
    ProbeMtlPixelFormatBGRA8Unorm: uint64 = uint64(80)
    # MTLTextureUsageShaderRead(1) | MTLTextureUsageShaderWrite(2)
    ProbeTextureUsageShaderReadOrWrite: uint64 = uint64(3)
    ProbeMsl = "using namespace metal; kernel void fill_tex(device const uchar4* src, texture2d<float, access::write> dst, uint2 gid [[thread_position_in_grid]]) { if (gid.x >= dst.get_width() || gid.y >= dst.get_height()) { return; } uchar4 p = src[gid.y * dst.get_width() + gid.x]; dst.write(float4(p.x, p.y, p.z, p.w) / 255.0f, gid); } kernel void read_tex(texture2d<float, access::read> src, device uchar4* out, uint2 gid [[thread_position_in_grid]]) { if (gid.x >= src.get_width() || gid.y >= src.get_height()) { return; } float4 c = src.read(gid); out[gid.y * src.get_width() + gid.x] = uchar4(c.x * 255.0f + 0.5f, c.y * 255.0f + 0.5f, c.z * 255.0f + 0.5f, c.w * 255.0f + 0.5f); }"

fn probe_ptr_plus(base: ptr, off: int32): ptr =
    if base == nil:
        return nil
    return ptr(uint64(base) + uint64(off))

fn probe_nsstring(cstr: ptr): ptr =
    if cstr == nil:
        return nil
    let nsStringClass: ptr = probe_objc_get_class("NSString")
    if nsStringClass == nil:
        return nil
    let selUtf8: ptr = probe_sel_register_name("stringWithUTF8String:")
    if selUtf8 == nil:
        return nil
    return probe_msg_send_ptr(nsStringClass, selUtf8, cstr)

fn probe_release(obj: ptr) =
    if obj == nil:
        return
    let selRelease: ptr = probe_sel_register_name("release")
    if selRelease == nil:
        return
    let _ = probe_msg_send0(obj, selRelease)

fn probe_expected_r(x: int32, y: int32): int32 =
    return (x * 8) & 255

fn probe_expected_g(x: int32, y: int32): int32 =
    return (y * 16) & 255

fn probe_expected_b(x: int32, y: int32): int32 =
    return (x + y) & 255

fn probe_fill_host_pixels(hostPixels: ptr) =
    var y: int32 = 0
    while y < ProbeHeight:
        var x: int32 = 0
        while x < ProbeWidth:
            let base: int32 = (y * ProbeWidth + x) * 4
            *(UInt8Ptr(probe_ptr_plus(hostPixels, base + 0))) = uint8(probe_expected_r(x, y))
            *(UInt8Ptr(probe_ptr_plus(hostPixels, base + 1))) = uint8(probe_expected_g(x, y))
            *(UInt8Ptr(probe_ptr_plus(hostPixels, base + 2))) = uint8(probe_expected_b(x, y))
            *(UInt8Ptr(probe_ptr_plus(hostPixels, base + 3))) = uint8(255)
            x = x + 1
        y = y + 1

fn probe_run_kernel(queue: ptr,
                    pipeline: ptr,
                    srcBuffer: ptr,
                    dstBuffer: ptr,
                    texture: ptr,
                    useSrcBuffer: bool,
                    useDstBuffer: bool): int32 =
    let commandBuffer: ptr = probe_msg_send0(queue, probe_sel_register_name("commandBuffer"))
    if commandBuffer == nil:
        return 50
    let encoder: ptr = probe_msg_send0(commandBuffer, probe_sel_register_name("computeCommandEncoder"))
    if encoder == nil:
        return 51
    probe_msg_send_set_pipeline(encoder, probe_sel_register_name("setComputePipelineState:"), pipeline)
    let selSetBuffer: ptr = probe_sel_register_name("setBuffer:offset:atIndex:")
    if useSrcBuffer:
        probe_msg_send_set_buffer(encoder, selSetBuffer, srcBuffer, ptr(uint64(0)), ptr(uint64(0)))
    if useDstBuffer:
        probe_msg_send_set_buffer(encoder, selSetBuffer, dstBuffer, ptr(uint64(0)), ptr(uint64(0)))
    let selSetTexture: ptr = probe_sel_register_name("setTexture:atIndex:")
    probe_msg_send_set_texture(encoder, selSetTexture, texture, uint64(0))
    let grid = ProbeSize(width: uint64(ProbeWidth), height: uint64(ProbeHeight), depth: uint64(1))
    let group = ProbeSize(width: uint64(8), height: uint64(8), depth: uint64(1))
    probe_msg_send_dispatch_threads(encoder, probe_sel_register_name("dispatchThreads:threadsPerThreadgroup:"), grid, group)
    probe_msg_send_void0(encoder, probe_sel_register_name("endEncoding"))
    probe_msg_send_void0(commandBuffer, probe_sel_register_name("commit"))
    probe_msg_send_void0(commandBuffer, probe_sel_register_name("waitUntilCompleted"))
    let status: uint64 = probe_msg_send_u64_return(commandBuffer, probe_sel_register_name("status"))
    if status != uint64(4):
        return 52
    return 0

fn main(): int32 =
    var pool: ptr = probe_objc_autorelease_pool_push()
    var queue: ptr
    var library: ptr
    var functionFill: ptr
    var functionRead: ptr
    var pipelineFill: ptr
    var pipelineRead: ptr
    var textureDescriptor: ptr
    var texture: ptr
    var bufferSrc: ptr
    var bufferDst: ptr
    var hostPixels: ptr
    let device: ptr = probe_mtl_create_system_default_device()
    if device == nil:
        echo("FAIL stage=device")
        return 2
    queue = probe_msg_send0(device, probe_sel_register_name("newCommandQueue"))
    if queue == nil:
        echo("FAIL stage=queue")
        return 3
    let mslSource: str = ProbeMsl
    let mslString: ptr = probe_nsstring(mslSource.data)
    if mslString == nil:
        echo("FAIL stage=msl-nsstring")
        return 4
    var libraryError: ptr
    library = probe_msg_send_ptr_ptr_ptr(device, probe_sel_register_name("newLibraryWithSource:options:error:"), mslString, nil, ptr(&libraryError))
    if library == nil:
        echo("FAIL stage=library-compile")
        probe_dump_nserror(libraryError)
        return 5
    let fillName: str = "fill_tex"
    let fillNameString: ptr = probe_nsstring(fillName.data)
    if fillNameString == nil:
        echo("FAIL stage=fill-nsstring")
        return 6
    functionFill = probe_msg_send_ptr(library, probe_sel_register_name("newFunctionWithName:"), fillNameString)
    if functionFill == nil:
        echo("FAIL stage=function-fill")
        return 7
    let readName: str = "read_tex"
    let readNameString: ptr = probe_nsstring(readName.data)
    if readNameString == nil:
        echo("FAIL stage=read-nsstring")
        return 8
    functionRead = probe_msg_send_ptr(library, probe_sel_register_name("newFunctionWithName:"), readNameString)
    if functionRead == nil:
        echo("FAIL stage=function-read")
        return 9
    var pipelineError: ptr
    pipelineFill = probe_msg_send_ptr_ptr(device, probe_sel_register_name("newComputePipelineStateWithFunction:error:"), functionFill, ptr(&pipelineError))
    if pipelineFill == nil:
        echo("FAIL stage=pipeline-fill")
        return 10
    var pipelineError2: ptr
    pipelineRead = probe_msg_send_ptr_ptr(device, probe_sel_register_name("newComputePipelineStateWithFunction:error:"), functionRead, ptr(&pipelineError2))
    if pipelineRead == nil:
        echo("FAIL stage=pipeline-read")
        return 11

    # Build an MTLPixelFormatBGRA8Unorm texture from memory via descriptor
    # setters (no newTextureWithDescriptor bridge exists in the provider yet).
    let descriptorClass: ptr = probe_objc_get_class("MTLTextureDescriptor")
    if descriptorClass == nil:
        echo("FAIL stage=descriptor-class")
        return 12
    let descriptorAlloc: ptr = probe_msg_send0(descriptorClass, probe_sel_register_name("alloc"))
    if descriptorAlloc == nil:
        echo("FAIL stage=descriptor-alloc")
        return 13
    textureDescriptor = probe_msg_send0(descriptorAlloc, probe_sel_register_name("init"))
    if textureDescriptor == nil:
        echo("FAIL stage=descriptor-init")
        return 14
    probe_msg_send_set_u64(textureDescriptor, probe_sel_register_name("setPixelFormat:"), ProbeMtlPixelFormatBGRA8Unorm)
    probe_msg_send_set_u64(textureDescriptor, probe_sel_register_name("setWidth:"), uint64(ProbeWidth))
    probe_msg_send_set_u64(textureDescriptor, probe_sel_register_name("setHeight:"), uint64(ProbeHeight))
    probe_msg_send_set_u64(textureDescriptor, probe_sel_register_name("setUsage:"), ProbeTextureUsageShaderReadOrWrite)
    texture = probe_msg_send_ptr(device, probe_sel_register_name("newTextureWithDescriptor:"), textureDescriptor)
    if texture == nil:
        echo("FAIL stage=new-texture")
        return 15
    let textureWidth: uint64 = probe_msg_send_u64_return(texture, probe_sel_register_name("width"))
    if textureWidth != uint64(ProbeWidth):
        echo("FAIL stage=texture-width got=" + strings.IntToStr(int32(textureWidth)))
        return 16

    hostPixels = probe_libc_malloc(int64(ProbeBytes))
    if hostPixels == nil:
        echo("FAIL stage=host-mem")
        return 17
    probe_fill_host_pixels(hostPixels)
    bufferSrc = probe_msg_send_ptr_u64_u64(device, probe_sel_register_name("newBufferWithBytes:length:options:"), hostPixels, uint64(ProbeBytes), uint64(0))
    bufferDst = probe_msg_send_u64_u64(device, probe_sel_register_name("newBufferWithLength:options:"), uint64(ProbeBytes), uint64(0))
    if bufferSrc == nil || bufferDst == nil:
        echo("FAIL stage=buffer")
        return 18

    # Kernel 1: host bytes -> texture write (BGRA8Unorm).
    let fillStatus: int32 = probe_run_kernel(queue, pipelineFill, bufferSrc, bufferDst, texture, true, false)
    if fillStatus != 0:
        echo("FAIL stage=fill-kernel rc=" + strings.IntToStr(fillStatus))
        return 19
    # Kernel 2: texture read -> host-visible buffer.
    let readStatus: int32 = probe_run_kernel(queue, pipelineRead, bufferSrc, bufferDst, texture, false, true)
    if readStatus != 0:
        echo("FAIL stage=read-kernel rc=" + strings.IntToStr(readStatus))
        return 20
    let contents: ptr = probe_msg_send0(bufferDst, probe_sel_register_name("contents"))
    if contents == nil:
        echo("FAIL stage=contents")
        return 21
    var i: int32 = 0
    while i < ProbePixelCount:
        let x: int32 = i % ProbeWidth
        let y: int32 = i / ProbeWidth
        let base: ptr = probe_ptr_plus(contents, i * 4)
        let gotR: int32 = int32(*(UInt8Ptr(probe_ptr_plus(base, 0))))
        let gotG: int32 = int32(*(UInt8Ptr(probe_ptr_plus(base, 1))))
        let gotB: int32 = int32(*(UInt8Ptr(probe_ptr_plus(base, 2))))
        let gotA: int32 = int32(*(UInt8Ptr(probe_ptr_plus(base, 3))))
        if gotR != probe_expected_r(x, y) || gotG != probe_expected_g(x, y) ||
           gotB != probe_expected_b(x, y) || gotA != 255:
            echo("FAIL stage=assert index=" + strings.IntToStr(i) +
                 " rgba=" + strings.IntToStr(gotR) + "," + strings.IntToStr(gotG) + "," +
                 strings.IntToStr(gotB) + "," + strings.IntToStr(gotA))
            return 22
        i = i + 1

    # Drawlist texture command must accept the compute-created MTLTexture
    # handle (cheng_drawlist_push_texture_handle_parts path, not the H.264
    # chengDarwinMediaLastTexture* globals).
    gui.Init()
    let list: int32 = gui.DrawListNew(4)
    if list <= 0:
        echo("FAIL stage=drawlist-new")
        return 30
    let textureHandle: uint64 = uint64(texture)
    if !gui.DrawListPushTexture(list, textureHandle, 0, 0, ProbeWidth, ProbeHeight, ProbeWidth, ProbeHeight, 80):
        echo("FAIL stage=drawlist-push-texture")
        return 31
    if gui.DrawListTextureCount(list) != 1:
        echo("FAIL stage=drawlist-texture-count")
        return 32
    if gui.DrawListLastTextureHandle(list) != textureHandle:
        echo("FAIL stage=drawlist-texture-handle")
        return 33
    if gui.DrawListLastTextureWidth(list) != ProbeWidth:
        echo("FAIL stage=drawlist-texture-width")
        return 34
    if gui.DrawListLastTextureDrawHeight(list) != ProbeHeight:
        echo("FAIL stage=drawlist-texture-draw-height")
        return 35
    if gui.DrawListLastTexturePixelFormat(list) != 80:
        echo("FAIL stage=drawlist-texture-pixel-format")
        return 36
    if gui.DrawListCount(list) != 1:
        echo("FAIL stage=drawlist-count")
        return 37
    gui.DrawListFree(list)

    probe_release(bufferDst)
    probe_release(bufferSrc)
    probe_release(texture)
    probe_release(textureDescriptor)
    probe_release(pipelineRead)
    probe_release(pipelineFill)
    probe_release(functionRead)
    probe_release(functionFill)
    probe_release(library)
    probe_release(queue)
    probe_libc_free(hostPixels)
    if pool != nil:
        probe_objc_autorelease_pool_pop(pool)
    echo("PASS gui texture probe")
    return 0
