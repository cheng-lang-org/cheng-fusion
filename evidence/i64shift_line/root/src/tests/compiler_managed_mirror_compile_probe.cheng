import cheng/core/tooling/compiler_world_libp2p as cwlp
import cheng/core/tooling/compiler_world as cworld
import cheng/core/tooling/compiler_world_bundle as cwbundle
import cheng/core/tooling/compiler_equivalence as ceq
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/backend/system_link_plan as slplan
import cheng/core/backend/system_link_exec as sexec
import cheng/std/bytes_layout as layout
import std/strutils as strutil
import std/cmdline as cmdline

fn main() =
    if cmdline.ParamCount() > 0 &&
       cmdline.ParamStr(1) == "--compile-world-bundle-atomic":
        var atomicSnapshot: sexec.SystemLinkExecPublicationSnapshot
        var atomicReceipt: ccsg.CompileReceipt
        var atomicEvidence: ceq.CompilerMigrationEvidence
        var atomicProof: ceq.CompilerMigrationSemanticProof
        var atomicCompilerMirror: cwlp.CompilerManagedMirrorBundle
        var atomicManagedReceipt: cwlp.CompilerManagedDependencyReceipt
        var atomicMirrors: cwlp.CompilerManagedMirrorBundle[]
        let atomicRes = cwbundle.CompilerWorldBundleInstallAtomic(
            "",
            "",
            atomicSnapshot,
            atomicReceipt,
            atomicEvidence,
            atomicProof,
            atomicCompilerMirror,
            atomicManagedReceipt,
            atomicMirrors)
        assert(IsErr(atomicRes),
               "default world bundle atomic install must fail closed")
        return
    var stableBundle: cwbundle.CompilerWorldBundle
    assert(layout.FixedBytes32Equal(stableBundle.receipt.receiptCid,
                                    layout.FixedBytes32()),
           "default bundle remains unverified")
    var diagnosticBundle: cwlp.CompilerManagedMirrorBundle
    let diagnostic = cwlp.CompilerWorldManagedMirrorBundleFromReportText(
        "version=1",
        diagnosticBundle)
    assert(IsErr(diagnostic), "old mirror schema must be rejected")
    var a: cwlp.CompilerManagedDependencyReceiptEntry
    a.canonicalPackageId = "cheng/dependency_a"
    a.snapshotCid = cworld.CompilerWorldHashText("snapshot", [a.canonicalPackageId])
    a.syntaxSurfaceCid = cworld.CompilerWorldHashText("surface", [a.canonicalPackageId])
    a.migrationProofCid = cworld.CompilerWorldHashText("proof", [a.canonicalPackageId])
    a.priorManagedMirrorBundleCid = cworld.CompilerWorldHashText(
        "prior-mirror",
        [a.canonicalPackageId])
    var b: cwlp.CompilerManagedDependencyReceiptEntry
    b.canonicalPackageId = "cheng/dependency_b"
    b.snapshotCid = cworld.CompilerWorldHashText("snapshot", [b.canonicalPackageId])
    b.syntaxSurfaceCid = cworld.CompilerWorldHashText("surface", [b.canonicalPackageId])
    b.migrationProofCid = cworld.CompilerWorldHashText("proof", [b.canonicalPackageId])
    b.priorManagedMirrorBundleCid = cworld.CompilerWorldHashText(
        "prior-mirror",
        [b.canonicalPackageId])
    var receiptA: cwlp.CompilerManagedDependencyReceipt
    let receiptARes = cwlp.CompilerWorldManagedDependencyReceiptMake(
        "stable",
        [b, a],
        receiptA)
    assert(IsOk(receiptARes), "managed dependency receipt a")
    var receiptB: cwlp.CompilerManagedDependencyReceipt
    let receiptBRes = cwlp.CompilerWorldManagedDependencyReceiptMake(
        "stable",
        [a, b],
        receiptB)
    assert(IsOk(receiptBRes) &&
           layout.FixedBytes32Equal(receiptA.receiptCid, receiptB.receiptCid),
           "dependency reorder fixed point")
    let receiptText = cwlp.CompilerWorldManagedDependencyReceiptReport(receiptA)
    assert(!strutil.Contains(receiptText, "root") &&
           !strutil.Contains(receiptText, "manifest") &&
           !strutil.Contains(receiptText, "bundle_path"),
           "portable receipt excludes local and future roots")
    var parsed: cwlp.CompilerManagedDependencyReceipt
    let parseRes = cwlp.CompilerWorldManagedDependencyReceiptFromReportText(
        receiptText,
        parsed)
    assert(IsOk(parseRes) &&
           layout.FixedBytes32Equal(parsed.receiptCid, receiptA.receiptCid),
           "managed dependency receipt exact parse")
    var sourceEntryA: slplan.SystemLinkPlanManagedDependencyReceiptEntry
    sourceEntryA.canonicalPackageId = receiptA.entries[0].canonicalPackageId
    sourceEntryA.snapshotCid = receiptA.entries[0].snapshotCid
    sourceEntryA.syntaxSurfaceCid = receiptA.entries[0].syntaxSurfaceCid
    sourceEntryA.migrationProofCid = receiptA.entries[0].migrationProofCid
    sourceEntryA.priorManagedMirrorBundleCid =
        receiptA.entries[0].priorManagedMirrorBundleCid
    var sourceEntryB: slplan.SystemLinkPlanManagedDependencyReceiptEntry
    sourceEntryB.canonicalPackageId = receiptA.entries[1].canonicalPackageId
    sourceEntryB.snapshotCid = receiptA.entries[1].snapshotCid
    sourceEntryB.syntaxSurfaceCid = receiptA.entries[1].syntaxSurfaceCid
    sourceEntryB.migrationProofCid = receiptA.entries[1].migrationProofCid
    sourceEntryB.priorManagedMirrorBundleCid =
        receiptA.entries[1].priorManagedMirrorBundleCid
    var sourceReceipt: slplan.SystemLinkPlanManagedDependencyReceipt
    sourceReceipt.channel = receiptA.channel
    sourceReceipt.dependencyCount = 2
    sourceReceipt.entries = [sourceEntryA, sourceEntryB]
    sourceReceipt.receiptCid =
        slplan.SystemLinkPlanManagedDependencyReceiptCid(sourceReceipt)
    var converted: cwlp.CompilerManagedDependencyReceipt
    let convertedRes =
        cwlp.CompilerWorldManagedDependencyReceiptFromPlanProjection(
        sourceReceipt,
        converted)
    assert(IsOk(convertedRes) && Value(convertedRes) &&
           layout.FixedBytes32Equal(converted.receiptCid,
                                    receiptA.receiptCid),
           "compact plan projection exact conversion")
    let trailingRes = cwlp.CompilerWorldManagedDependencyReceiptFromReportText(
        strutil.Join([receiptText, "\n"], ""),
        parsed)
    assert(IsErr(trailingRes), "receipt trailing byte rejected")
    let duplicateRes = cwlp.CompilerWorldManagedDependencyReceiptFromReportText(
        strutil.Join([receiptText, "\nchannel=stable"], ""),
        parsed)
    assert(IsErr(duplicateRes), "receipt duplicate field rejected")
    let unknownRes = cwlp.CompilerWorldManagedDependencyReceiptFromReportText(
        strutil.Join([receiptText, "\nphysical_root=/tmp/escape"], ""),
        parsed)
    assert(IsErr(unknownRes), "receipt local root injection rejected")
    receiptA.entries[0].snapshotCid = a.syntaxSurfaceCid
    assert(!cwlp.CompilerWorldManagedDependencyReceiptVerify(receiptA),
           "receipt cid tamper rejected")
    var duplicateReceipt: cwlp.CompilerManagedDependencyReceipt
    let duplicateMakeRes = cwlp.CompilerWorldManagedDependencyReceiptMake(
        "stable",
        [a, a],
        duplicateReceipt)
    assert(IsErr(duplicateMakeRes), "duplicate dependency rejected")
    echo("compiler_managed_mirror_compile_probe ok")
