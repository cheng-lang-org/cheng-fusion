# Independent oracle dump for `.moqidx` frame-index binaries — deliberately does NOT
# import cheng/core/runtime/web_scene_media_network_bridge (the module under test in
# media_moq_es_pause_click_wire_check_main.cheng and friends). This file re-derives the
# header + per-frame-entry layout from scratch by direct byte inspection (see the xxd
# transcript in this file's trailing comment block), independent of whatever the tested
# module's own parser/PrefetchTick GOP-scan logic does — so a bug in that logic (or a
# stale hardcoded oracle sitting downstream of it) cannot hide from this tool.
#
# Purpose: adjudicate src/tests/media_moq_es_pause_click_wire_check_main.cheng's HEAD-red
# hardcoded oracle (targetGop=120, oracleGopLen=946127) against the REAL keyframe table
# and REAL per-GOP byte lengths of the actual `.moqidx` fixture it serves against
# (platform/harmony/ChengGuiDemo/entry/src/main/resources/rawfile/maitian.moqidx — sha256
# 137a100c6c026dab0a72984194ccc9ebe669c85e138713d262419ff62d7874fd, byte-identical to the
# copy used by the S7b audio-prefetch test's --root cache at
# /private/tmp/audioprefetch_probe_cache/maitian.moqidx — verified via shasum -a 256, both
# match).
#
# WHY THE BYTES ARE EMBEDDED AS A LITERAL, NOT READ FROM DISK AT RUNTIME: this project's
# self-hosted zero-C backend (artifacts/backend_driver/cheng, the toolchain this program
# must compile+run under per the task's cross-toolchain requirement) does not yet cover
# ANY file-read call chain through `system-link-exec --emit:exe` — verified by compiling
# this repo's OWN canonical src/tests/std_file_io_smoke.cheng (which exercises
# os.ReadFile/os.ReadFileBytesResult/os.ReadFileInto etc.) through that exact driver+flags:
# it bails with ZC_NOT_READY_TOTAL count=21, every one of them `body_kind=missing_call_target`
# on os.cheng's readFile/readFileInto/readFileResult/readFileBytesResult internals (lines
# 1226-1355 of src/std/os.cheng). This oracle's own first attempt using
# os.ReadFileBytesResult(path) hit the identical bail. A lower-level os.c_fopen/os.c_fread/
# os.cheng_file_size attempt got PAST codegen (proving the zero-C node backend has no
# objection to the parsing/loop/array logic itself) but failed at LINK time
# (`macho_provider_linker: unresolved symbol: os.cheng_file_size` — not among the objects
# --link-providers pulls in for a standalone binary).
#
# WHY THE EMBEDDED LITERAL IS A 3660-BYTE PREFIX, NOT THE FULL 4032-BYTE FILE: a plain
# `var raw: int32[4032] = [...4032 literal bytes...]` (or 4032 separate `raw[i]=byte`
# assignment statements — tried both) makes THIS SAME backend_driver binary itself crash
# (SIGSEGV, rc=139) during compilation — bisected empirically: a 310-line/3720-byte literal
# compiles fine, a 320-line/3840-byte literal reproducibly segfaults. This is a genuine,
# independently-verified scale limit of the current backend_driver build (unrelated to this
# task), not a workaround of convenience. 3660 bytes (36-byte header + the first 302 of 333
# frame-table entries, i.e. frames 0..301) stays safely under that threshold while still
# covering everything this adjudication needs: the full flags column for frames 0..301
# (proving the true keyframe positions 0,60,120,180,240,300 by genuine per-frame scan, not
# assumption) and complete offset+size data for every frame each GOP-length computation
# below actually touches (frame 59/60, 119/120, 179/180, 239/240, 299/300 — all < 302). Only
# the FINAL GOP (started by keyframe 300, the last one) cannot be closed from this prefix,
# since closing it needs frame 332 (the real last frame, count=333) — genuinely outside the
# embedded range, and this program says so explicitly (`len=UNCLOSED...`) rather than
# guessing. That gap does not touch the disputed comparison (GOP 60 vs the test's hardcoded
# GOP 120 oracle), which is fully resolved by the embedded prefix alone. Nothing about the
# RESULT values (keyframe positions, GOP offsets/lengths) is hardcoded — only the raw input
# bytes are (mechanically extracted via `head -c 3660` + `xxd -i` from the real on-disk
# file, sha256-verified above); this program computes every printed fact itself.
#
# `.moqidx` binary layout (re-derived independently here from a raw hex dump, cross-checked
# against web_scene_media_network_bridge.cheng:419-461's own header-field offsets AFTER
# writing this parser — not copied from it):
#   offset  0..3   : magic "MQES" (4 bytes, ASCII)
#   offset  4..7   : current format (u32 LE) — exactly 2
#   offset  8..11  : width (u32 LE)
#   offset 12..15  : height (u32 LE)
#   offset 16..19  : fpsNum (u32 LE)
#   offset 20..23  : fpsDen (u32 LE)
#   offset 24..27  : frame count (u32 LE)
#   offset 28..31  : exact ES total bytes (u32 LE)
#   offset 32..35  : rotation, signed two's-complement (u32 LE reinterpreted signed)
#   frame table starts at byte 36; no other header size is accepted.
#   frame table     : `count` entries of 12 bytes each, starting at headerBytes:
#                       [0..3]  frame byte offset into the ES stream (u32 LE)
#                       [4..7]  frame byte size (u32 LE)
#                       [8..11] flags (u32 LE) — bit0 (flags & 1) == 1 means keyframe
#
# GOP definition used here mirrors WebSceneMediaEsPrefetchTick's own (the thing being
# adjudicated) EXACTLY in one respect only — "a GOP starts at a keyframe index K and ends
# right before the next keyframe index K' (or end of stream)" — but this file computes it
# from the raw bytes independently, not by calling that function or any helper it calls.
#   gopLen(K) = (frame[K'-1].offset + frame[K'-1].size) - frame[K].offset,  K' = next keyframe after K
#
# Prints the header fields, the full keyframe index list (within the embedded prefix), and
# every closeable GOP's (startFrame, byteOffset, byteLen) — plain text, one fact per line.
import std/os
import std/rawbytes
import std/strutils as strutil

fn readLeU32(b: rawbytes.Bytes, off: int32): int32 =
    let b0: int32 = rawbytes.BytesGet(b, off) & 255
    let b1: int32 = rawbytes.BytesGet(b, off + 1) & 255
    let b2: int32 = rawbytes.BytesGet(b, off + 2) & 255
    let b3: int32 = rawbytes.BytesGet(b, off + 3) & 255
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)

fn fail(msg: str): int32 =
    os.WriteLine(os.Get_stdout(), strutil.Join(["FAIL: ", msg], ""))
    return 1

