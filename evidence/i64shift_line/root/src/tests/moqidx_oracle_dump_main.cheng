    0x8a, 0xf3, 0x13, 0x00, 0xb0, 0x0c, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x3a, 0x00, 0x14, 0x00, 0xd0, 0x0e, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x0a, 0x0f, 0x14, 0x00, 0xd3, 0x0f, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0xdd, 0x1e, 0x14, 0x00, 0x6c, 0x0f, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x49, 0x2e, 0x14, 0x00, 0x1e, 0x0d, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x67, 0x3b, 0x14, 0x00, 0xfe, 0x0e, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x65, 0x4a, 0x14, 0x00, 0xbb, 0x22, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x20, 0x6d, 0x14, 0x00, 0x53, 0x09, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x73, 0x76, 0x14, 0x00, 0x40, 0x0d, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0xb3, 0x83, 0x14, 0x00, 0x5a, 0x1d, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x0d, 0xa1, 0x14, 0x00, 0xe0, 0x08, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0xed, 0xa9, 0x14, 0x00, 0xaf, 0x0b, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x9c, 0xb5, 0x14, 0x00, 0x32, 0x1b, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0xce, 0xd0, 0x14, 0x00, 0x5a, 0x0b, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x28, 0xdc, 0x14, 0x00, 0x85, 0x18, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0xad, 0xf4, 0x14, 0x00, 0x84, 0x09, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x31, 0xfe, 0x14, 0x00, 0xbc, 0x13, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0xed, 0x11, 0x15, 0x00, 0x3a, 0x13, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x27, 0x25, 0x15, 0x00, 0x55, 0x11, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x7c, 0x36, 0x15, 0x00, 0x77, 0x0f, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0xf3, 0x45, 0x15, 0x00, 0x1a, 0x11, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x0d, 0x57, 0x15, 0x00, 0x21, 0x11, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x2e, 0x68, 0x15, 0x00, 0xf7, 0x10, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x25, 0x79, 0x15, 0x00, 0x4c, 0x11, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x71, 0x8a, 0x15, 0x00, 0xe1, 0x10, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x52, 0x9b, 0x15, 0x00, 0xfa, 0x11, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x4c, 0xad, 0x15, 0x00, 0xf6, 0x13, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x42, 0xc1, 0x15, 0x00, 0x89, 0x0f, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0xcb, 0xd0, 0x15, 0x00, 0x78, 0x11, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x43, 0xe2, 0x15, 0x00, 0x2a, 0x13, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x6d, 0xf5, 0x15, 0x00, 0xe5, 0x11, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x52, 0x07, 0x16, 0x00, 0xaf, 0x10, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x01, 0x18, 0x16, 0x00, 0xe2, 0x11, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0xe3, 0x29, 0x16, 0x00, 0x41, 0x13, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x24, 0x3d, 0x16, 0x00, 0x6c, 0x13, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x90, 0x50, 0x16, 0x00, 0x76, 0x12, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x06, 0x63, 0x16, 0x00, 0x6f, 0x14, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x75, 0x77, 0x16, 0x00, 0x55, 0xc8, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00,
    0xca, 0x3f, 0x17, 0x00, 0xb8, 0x06, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
    ]

    var idxData: rawbytes.Bytes = rawbytes.BytesAlloc(moqidxPrefixByteCount)
    var bi: int32
    while bi < moqidxPrefixByteCount:
        rawbytes.BytesSet(idxData, bi, raw[bi])
        bi = bi + 1

    let total: int32 = rawbytes.BytesLen(idxData)
    if total < 36:
        return fail(strutil.Join(["prefix too short: ", IntToStr(total), " bytes"], ""))

    if rawbytes.BytesGet(idxData, 0) != 77 || rawbytes.BytesGet(idxData, 1) != 81 ||
       rawbytes.BytesGet(idxData, 2) != 69 || rawbytes.BytesGet(idxData, 3) != 83:
        return fail("magic mismatch, expected MQES")

    let format: int32 = readLeU32(idxData, 4)
    let width: int32 = readLeU32(idxData, 8)
    let height: int32 = readLeU32(idxData, 12)
    let fpsNum: int32 = readLeU32(idxData, 16)
    let fpsDen: int32 = readLeU32(idxData, 20)
    let count: int32 = readLeU32(idxData, 24)
    if format != 2:
        return fail(strutil.Join(["format mismatch: ", IntToStr(format)], ""))
    let headerBytes: int32 = 36
    let rotation: int32 = readLeU32(idxData, 32)

    # How many WHOLE frame-table entries the embedded prefix actually holds — computed
    # from the embedded byte count, not hardcoded (comes out to 302 for this fixture's
    # 3660-byte prefix, but the arithmetic here doesn't assume that).
    let availableFrames: int32 = (total - headerBytes) / 12
    var scanCount: int32 = count
    if availableFrames < count:
        scanCount = availableFrames

    os.WriteLine(os.Get_stdout(), "path=<embedded maitian.moqidx PREFIX, sha256(full file) 137a100c...d7874fd>")
    os.WriteLine(os.Get_stdout(), strutil.Join(["format=", IntToStr(format)], ""))
    os.WriteLine(os.Get_stdout(), strutil.Join(["width=", IntToStr(width), " height=", IntToStr(height)], ""))
    os.WriteLine(os.Get_stdout(), strutil.Join(["fpsNum=", IntToStr(fpsNum), " fpsDen=", IntToStr(fpsDen)], ""))
    os.WriteLine(os.Get_stdout(), strutil.Join(["count(header, full file)=", IntToStr(count)], ""))
    os.WriteLine(os.Get_stdout(), strutil.Join(["availableFrames(embedded prefix)=", IntToStr(availableFrames)], ""))
    os.WriteLine(os.Get_stdout(), strutil.Join(["headerBytes=", IntToStr(headerBytes)], ""))
    os.WriteLine(os.Get_stdout(), strutil.Join(["rotation=", IntToStr(rotation)], ""))

    # Keyframe table (flags & 1 == 1), scanned across the embedded prefix only
    # (frames 0..scanCount-1). Fixed-capacity array + running count (no append-growth
    # pattern) — plenty of headroom for any real ES fixture's keyframe count.
    var keyIdx: int32[4096]
    var kfCount: int32
    var i: int32
    while i < scanCount:
        let flags: int32 = readLeU32(idxData, headerBytes + i * 12 + 8)
        if (flags & 1) == 1:
            keyIdx[kfCount] = i
            kfCount = kfCount + 1
        i = i + 1

    var kfLine: str = "keyframes="
    var k: int32
    while k < kfCount:
        if k > 0:
            kfLine = strutil.Join([kfLine, ","], "")
        kfLine = strutil.Join([kfLine, IntToStr(keyIdx[k])], "")
        k = k + 1
    os.WriteLine(os.Get_stdout(), kfLine)

    # Per-GOP offset/len — mirrors WebSceneMediaEsPrefetchTick's own GOP boundary
    # definition (next-keyframe-exclusive), independently re-derived from raw bytes. A GOP
    # is only "closeable" from this prefix when either (a) its own next keyframe was found
    # within the scanned range, or (b) it's genuinely the LAST GOP of the whole stream
    # (scanCount == count, i.e. no truncation happened) — otherwise this program says so
    # instead of guessing past the embedded prefix's edge.
    var g: int32
    while g < kfCount:
        let startFrame: int32 = keyIdx[g]
        let startOff: int32 = readLeU32(idxData, headerBytes + startFrame * 12)
        var endFrameExclusive: int32
        var closeable: bool
        if g + 1 < kfCount:
            endFrameExclusive = keyIdx[g + 1]
            closeable = true
        elif scanCount == count:
            endFrameExclusive = count
            closeable = true
        else:
            closeable = false
        if closeable:
            let lastOff: int32 = readLeU32(idxData, headerBytes + (endFrameExclusive - 1) * 12)
            let lastSize: int32 = readLeU32(idxData, headerBytes + (endFrameExclusive - 1) * 12 + 4)
            let gopLen: int32 = (lastOff + lastSize) - startOff
            os.WriteLine(os.Get_stdout(), strutil.Join(["gop startFrame=", IntToStr(startFrame),
                                                          " offset=", IntToStr(startOff),
                                                          " len=", IntToStr(gopLen)], ""))
        else:
            os.WriteLine(os.Get_stdout(), strutil.Join(["gop startFrame=", IntToStr(startFrame),
                                                          " offset=", IntToStr(startOff),
                                                          " len=UNCLOSED(embedded prefix ends at frame ",
                                                          IntToStr(scanCount), " of ", IntToStr(count),
                                                          " total; closing frame not embedded)"], ""))
        g = g + 1

    os.WriteLine(os.Get_stdout(), "DUMP_OK")
    return 0

# --- xxd anchors used to derive the byte layout above (independent hand-verification,
# not generated by this program — run against
# platform/harmony/ChengGuiDemo/entry/src/main/resources/rawfile/maitian.moqidx, which is
# byte-identical (sha256, see header) to the fixture copy used by the S7b audio-prefetch
# test's --root cache):
#
#   $ xxd -g1 -c16 maitian.moqidx | head -3
#   00000000: 4d 51 45 53 02 00 00 00 00 05 00 00 d0 02 00 00  MQES............
#   00000010: 3c 00 00 00 01 00 00 00 4d 01 00 00 1f 44 19 00  <.......M....D..
#   00000020: a6 ff ff ff 00 00 00 00 60 2f 01 00 01 00 00 00  ........`/......
#
#   bytes[0:4]   = "MQES"                              magic
#   bytes[4:8]   = 02 00 00 00 = 2                      current format
#   bytes[8:12]  = 00 05 00 00 = 0x00000500 = 1280       width
#   bytes[12:16] = d0 02 00 00 = 0x000002d0 = 720         height
#   bytes[16:20] = 3c 00 00 00 = 60                      fpsNum
#   bytes[20:24] = 01 00 00 00 = 1                       fpsDen  -> fps = 60
#   bytes[24:28] = 4d 01 00 00 = 0x0000014d = 333         frame count
#   bytes[32:36] = a6 ff ff ff = -90 (two's complement)   rotation
#   bytes[36:48] = 00 00 00 00 60 2f 01 00 01 00 00 00    frame[0]: offset=0
#                                                          size=0x00012f60=77664 flags=1(key)
#
#   $ xxd -s 756 -l 12 -g1 maitian.moqidx      # frame[60] entry = 36 + 60*12 = 756
#   000002f4: 91 bb 04 00 99 f7 00 00 01 00 00 00
#     offset = 91 bb 04 00 = 0x0004bb91 = 310161   size = 99 f7 00 00 = 63385   flags=1(key)
#
#   $ xxd -s 1464 -l 12 -g1 maitian.moqidx     # frame[119] entry = 36 + 119*12 = 1464
#   000005b8: d4 17 09 00 1b 0b 00 00 00 00 00 00
#     offset = d4 17 09 00 = 0x000917d4 = 595924   size = 1b 0b 00 00 = 2843   flags=0
#
#   $ xxd -s 1476 -l 12 -g1 maitian.moqidx     # frame[120] entry = 36 + 120*12 = 1476
#   000005c4: ef 22 09 00 04 e5 00 00 01 00 00 00
#     offset = ef 22 09 00 = 0x000922ef = 598767   size = 04 e5 00 00 = 58628   flags=1(key)
#
#   => GOP starting at frame 60 (the FIRST keyframe strictly after cursor 0 — what
#      WebSceneMediaEsPrefetchTick(aheadGops) actually fetches from a fresh cursor=0, since
#      it scans forward from currentGopStart+1 for the next flagged keyframe, not by a
#      fixed frame-count stride) spans bytes [310161, 310161+288606) = [310161, 598767):
#        gopLen(60) = (frame[119].offset + frame[119].size) - frame[60].offset
#                   = (595924 + 2843) - 310161 = 598767 - 310161 = 288606
#      This EXACTLY matches src/tests/media_moq_es_pause_click_wire_check_main.cheng's
#      own case-brief numbers (offset=310161, len=288606) for the GOP the pump actually
#      lands on — corroborating the drift diagnosis. Confirmed identical to this program's
#      own printed `gop startFrame=60 offset=310161 len=288606` line when actually run
#      (see checkerEvidence in this patch's accompanying report).
#
#   For contrast, GOP 120 (frame[179] entry at 36+179*12=2184, frame[180] at 36+180*12=2196):
#   $ xxd -s 2184 -l 12 -g1 maitian.moqidx
#   00000888: ab ac 0d 00 f7 0e 00 00 00 00 00 00
#     frame[179]: offset = ab ac 0d 00 = 0x000dacab = 896171   size = f7 0e 00 00 = 3831
#   $ xxd -s 2196 -l 12 -g1 maitian.moqidx
#   00000894: a2 bb 0d 00 4f db 00 00 01 00 00 00
#     frame[180]: offset = a2 bb 0d 00 = 0x000dbba2 = 900002 (key)
#     gopLen(120) = (896171 + 3831) - 598767 = 900002 - 598767 = 301235  (consistency check:
#     frame[179].offset+size == frame[180].offset == 900002 exactly, as expected for a
#     contiguous byte stream — confirms both reads).
#   The test's hardcoded oracleGopLen=946127 for targetGop=120 matches NEITHER GOP 60's
#   real length (288606) NOR GOP 120's own real length (301235) — 946127 instead matches
#   `git show f6eb23a7e:src/tests/media_moq_es_prefetch_tick_check_main.cheng`'s GOP-120
#   oracle for an ENTIRELY DIFFERENT, older fixture (675 frames @ 30fps, keyframes every
#   120 frames: 0,120,240,360,480,600) — i.e. the click-wire test's oracle was copy-pasted
#   from that older fixture's numbers and never updated for the real `maitian` asset (333
#   frames @ 60fps, keyframes every 60 frames: 0,60,120,180,240,300) it actually serves
#   against. Confirms the "测试漂移" adjudication.
