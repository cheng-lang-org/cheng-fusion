import std/os as os
import std/os_host_process as hostos
import std/strings
import std/strutils as strutil

fn runFile(root: var str,
           filePath: var str,
           argvWire: var str,
           logPath: str,
           context: str): str =
    var envWire: str = hostos.ArgvWire0()
    var output: str
    var rc: int32
    hostos.ExecFileCaptureWire(filePath,
                               argvWire,
                               envWire,
                               root,
                               true,
                               900,
                               output,
                               rc)
    os.WriteFile(logPath, output)
    assert(rc == 0, strutil.Join([context, ": exit code"], ""))
    return output

fn main(): int32 =
    var root = os.GetCurrentDir()
    let outDir = os.JoinPath(root, "artifacts/build_backend_driver_report_smoke")
    if !os.DirExists(outDir):
        os.CreateDir(outDir)
    var stage3 = os.JoinPath(root, "artifacts/bootstrap/cheng.stage3")
    var backendDriver = os.JoinPath(root, "artifacts/backend_driver/cheng")
    let reportPath = os.JoinPath(root, "artifacts/backend_driver/cheng.report.txt")
    assert(os.FileExists(stage3), "cheng build backend driver report: stage3 exists")
    if !os.FileExists(backendDriver):
        let bootstrapLog = os.JoinPath(outDir, "bootstrap_build_backend_driver.log")
        var bootstrapArg: str = "build-backend-driver"
        var bootstrapWire: str = hostos.ArgvWire1(bootstrapArg)
        let _ = runFile(root,
                        stage3,
                        bootstrapWire,
                        bootstrapLog,
                        "cheng build backend driver report bootstrap")
    let touchLog = os.JoinPath(outDir, "touch_stage3.log")
    var touchWire: str = hostos.ArgvWire1(stage3)
    var touchPath: str = "/usr/bin/touch"
    let _ = runFile(root,
                    touchPath,
                    touchWire,
                    touchLog,
                    "cheng build backend driver report touch")
    let buildLog = os.JoinPath(outDir, "build_backend_driver.log")
    var buildArg: str = "build-backend-driver"
    var buildWire: str = hostos.ArgvWire1(buildArg)
    backendDriver = os.JoinPath(root, "artifacts/backend_driver/cheng")
    let _ = runFile(root,
                    backendDriver,
                    buildWire,
                    buildLog,
                    "cheng build backend driver report rebuild")
    assert(os.FileExists(reportPath), "cheng build backend driver report: report exists")
    let reportText = os.ReadFile(reportPath)
    let mapPath = os.JoinPath(root, "artifacts/backend_driver/cheng.map")
    assert(!strings.StrContains(reportText, "backend_driver_candidate=cold_subset_backend"),
           "cheng build backend driver report: rejects cold-subset candidate")
    assert(!strings.StrContains(reportText, "candidate_kind=cold_subset_backend"),
           "cheng build backend driver report: rejects cold-subset kind")
    assert(!strings.StrContains(reportText, "system_link_exec_scope=cold_subset_direct_macho"),
           "cheng build backend driver report: rejects cold-subset system-link")
    assert(strings.StrContains(reportText, "compiler_class=ordinary_compiler"),
           "cheng build backend driver report: ordinary compiler recorded")
    assert(strings.StrContains(reportText, "full_backend_codegen=1"),
           "cheng build backend driver report: full backend codegen recorded")
    assert(strings.StrContains(reportText, "system_link_exec_scope=selfhost_direct"),
           "cheng build backend driver report: selfhost system-link recorded")
    assert(strings.StrContains(reportText, "output="),
           "cheng build backend driver report: output recorded")
    assert(strings.StrContains(reportText, "artifacts/backend_driver/cheng"),
           "cheng build backend driver report: output path recorded")
    assert(os.FileExists(mapPath), "cheng build backend driver report: map exists")
    echo("cheng build_backend_driver_report_smoke ok")
    return 0
