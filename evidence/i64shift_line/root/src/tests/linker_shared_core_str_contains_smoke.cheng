import std/os
import cheng/core/backend/linker_shared_core

fn main(): int =
    assert(LinkerCoreStrContains("", ""), "empty needle in empty text")
    assert(LinkerCoreStrContains("cheng", ""), "empty needle")
    assert(!LinkerCoreStrContains("", "cheng"), "non-empty needle in empty text")
    assert(!LinkerCoreStrContains("ch", "cheng"), "needle longer than text")
    assert(LinkerCoreStrContains("cheng", "c"), "prefix")
    assert(LinkerCoreStrContains("cheng", "eng"), "suffix span")
    assert(LinkerCoreStrContains("cheng", "g"), "last byte")
    assert(LinkerCoreStrContains("cheng-cheng", "-c"), "interior span")
    assert(!LinkerCoreStrContains("cheng", "chenx"), "prefix mismatch")
    assert(!LinkerCoreStrContains("cheng", "xheng"), "first byte mismatch")
    assert(!LinkerCoreStrContains("cheng", "chengx"), "long suffix mismatch")
    os.WriteLine(os.Get_stdout(), "linker_shared_core_str_contains_smoke: ok")
    return 0
