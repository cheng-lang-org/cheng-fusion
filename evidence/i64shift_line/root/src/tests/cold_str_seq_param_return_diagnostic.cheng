fn MakeSeqForParamDiagnostic(): str[] =
    var out: str[]
    setLen(out, 1)
    out[0] = "beta"
    return out

fn FirstSeqItemForParamDiagnostic(items: str[]): str =
    if items.len != 1:
        return "bad-len"
    return items[0]

fn main(): int32 =
    let items = MakeSeqForParamDiagnostic()
    let item = FirstSeqItemForParamDiagnostic(items)
    if item != "beta":
        return 20
    return 77
