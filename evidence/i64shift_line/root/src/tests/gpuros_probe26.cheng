@profile("driver_safe")

type
    IoUInt8Ptr = uint8 *
    IoUInt32Ptr = uint32 *

@trusted_abi
fn IoLd32(base: uint64, offset: uint64): int32 =
    let b = base
    let o = offset
    let addr = ptr(b + o)
    return int32(*(IoUInt32Ptr(addr)))

@trusted_abi
fn IoSt32(base: uint64, offset: uint64, value: uint32) =
    let b = base
    let o = offset
    let addr = ptr(b + o)
    *(IoUInt32Ptr(addr)) = value

fn HexNib(v: int32) =
    let w = v
    if w < 10:
        IoSt32(268435456, 0, uint32(48 + w))
    else:
        IoSt32(268435456, 0, uint32(87 + w))

fn Hex32(v: int32) =
    var div = 268435456
    while div > 0:
        HexNib((v / div) & 15)
        div = div / 16

fn Sep() =
    IoSt32(268435456, 0, uint32(32))

fn main(): int32 =
    let dev = uint64(268468224)
    IoSt32(dev, uint64(0x028), uint32(4096))
    IoSt32(dev, uint64(0x030), uint32(0))
    IoSt32(dev, uint64(0x038), uint32(64))
    IoSt32(dev, uint64(0x03C), uint32(4096))
    IoSt32(dev, uint64(0x040), uint32(532992))
    let rPfn = IoLd32(dev, uint64(0x040))
    let rAlign = IoLd32(dev, uint64(0x03C))
    let rNum = IoLd32(dev, uint64(0x038))
    Hex32(rPfn)
    Sep()
    Hex32(rAlign)
    Sep()
    Hex32(rNum)
    IoSt32(268435456, 0, uint32(10))
    var park = 0
    while park < 2000000000:
        park = park + 1
    return 0
