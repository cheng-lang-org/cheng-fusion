import cheng/core/backend/system_link_exec as system_link_exec
import cheng/core/backend/system_link_exec_runtime as system_link_exec_runtime

fn main() =
    var plan: system_link_exec.SystemLinkExecPlan
    var runtimeResult: system_link_exec_runtime.SystemLinkExecRuntimeResult
    if system_link_exec.SystemLinkExecPlanReady(plan):
        panic("seven-stage system link exec: invalid default")
    if runtimeResult.directObjectBytes != 0:
        panic("seven-stage system link runtime: invalid default")
