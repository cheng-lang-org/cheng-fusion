import std/system
import std/rawbytes
import std/crypto/sha256
import std/crypto/hash256
import cheng/std/bytes_layout as layout

fn Sha256TwoPartStreamByte(index: int32): int32 =
    return (index * 37 + 11) & 255

fn Sha256TwoPartKnownVector() =
    let first = BytesFromString("a")
    let second = BytesFromString("bc")
    var expected = BytesFromHex(
        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    var actual = sha256.Sha256DigestTwo(first, second)
    assert(BytesEqual(expected, actual),
           " sha256 two-part stream: abc KAT mismatch")
    BytesFree(actual)
    BytesFree(expected)

fn Sha256TwoPartStreamCase(firstLen: int32, secondLen: int32) =
    var first = BytesAlloc(firstLen)
    var second = BytesAlloc(secondLen)
    var joined = BytesAlloc(firstLen + secondLen)
    for index in 0..<firstLen:
        let value = Sha256TwoPartStreamByte(index)
        BytesSet(first, index, value)
        BytesSet(joined, index, value)
    for index in 0..<secondLen:
        let value = Sha256TwoPartStreamByte(firstLen + index)
        BytesSet(second, index, value)
        BytesSet(joined, firstLen + index, value)
    var expected = sha256.Sha256Digest(joined)
    var actual = sha256.Sha256DigestTwo(first, second)
    assert(BytesEqual(expected, actual),
           " sha256 two-part stream: digest mismatch")
    let expectedFixed = hash256.Sha256Fixed(
        layout.ByteSpanFromBytes(joined))
    let actualFixed = hash256.Sha256FixedTwo(
        layout.ByteSpanFromBytes(first),
        layout.ByteSpanFromBytes(second))
    assert(layout.FixedBytes32Equal(expectedFixed, actualFixed),
           " sha256 two-part stream: fixed digest mismatch")
    BytesFree(actual)
    BytesFree(expected)
    BytesFree(joined)
    BytesFree(second)
    BytesFree(first)

fn main(): int32 =
    Sha256TwoPartKnownVector()
    Sha256TwoPartStreamCase(0, 0)
    Sha256TwoPartStreamCase(1, 0)
    Sha256TwoPartStreamCase(0, 1)
    Sha256TwoPartStreamCase(4, 51)
    Sha256TwoPartStreamCase(4, 52)
    Sha256TwoPartStreamCase(17, 47)
    Sha256TwoPartStreamCase(63, 1)
    Sha256TwoPartStreamCase(64, 0)
    Sha256TwoPartStreamCase(64, 1)
    Sha256TwoPartStreamCase(65, 0)
    Sha256TwoPartStreamCase(33, 96)
    Sha256TwoPartStreamCase(31, 4097)
    echo("sha256_two_part_stream_smoke ok")
    return 0
