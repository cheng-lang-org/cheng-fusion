type
    ColdVarPlaceReassignCell =
        value: int32

    ColdVarPlaceReassignInner = ref object
        cell: ColdVarPlaceReassignCell

    ColdVarPlaceReassignOuter = ref object
        inner: ColdVarPlaceReassignInner

fn ColdVarPlaceReassignWrite(
        cell: var ColdVarPlaceReassignCell) =
    cell.value = 59

fn ColdVarPlaceReassignMutate(
        out: var ColdVarPlaceReassignOuter) =
    var inner = out.inner
    out.inner = new(ColdVarPlaceReassignInner)
    ColdVarPlaceReassignWrite(inner.cell)

fn main(): int32 =
    var out = new(ColdVarPlaceReassignOuter)
    out.inner = new(ColdVarPlaceReassignInner)
    ColdVarPlaceReassignMutate(out)
    return 0
