# Smoke: pure-Cheng GUI short-video PUBLISH 秒发秒开 (publish side, real video).
#
# Drives the orchestrator over a real h264 mp4 fixture: ingest the local short
# video into a MoQ fountain manifest, register the fountain asset onto the scene
# graph, and bind a playback slot — the 本地秒发 publish path with real fountain
# objects/repair droplets. Times the ingest (the "秒" of 秒发).

import std/result
import std/rawbytes
import std/strutils as strutil
import std/times as times
import cheng/core/runtime/web_scene_runtime as scene
import cheng/core/runtime/web_scene_media_orchestrator as orch
import cheng/moq/media_asset_manifest as media

fn main(): int32 =
    let fixturePath = "/Users/lbcheng/cheng-lang/ts-csg/fixtures/media/unimaker-default-video-2frame.mp4"
    # Platform first-frame poster: test fixture bytes (production GUI supplies the
    # decoded first frame). Ingest requires it non-empty.
    let poster = rawbytes.BytesFromString("unimaker-short-video-first-frame-poster-fixture")

    var graph: scene.WebSceneGraph
    scene.WebSceneGraphInit(graph)
    # GUI surface for the published video (route + layer + container + <video>).
    assert(scene.WebSceneAddRouteExpectedIndex(graph, "short_video_surface", 1, 1, 0), " publish: add route")
    assert(scene.WebSceneAddLayer(graph, 0, 1, "content", 0), " publish: add layer")
    assert(scene.WebSceneAddNode(graph, 0, 1, 0, 2, "div", "", 1), " publish: add container node")
    assert(scene.WebSceneAddNode(graph, 0, 2, 1, 2, "video", "", 1), " publish: add video node")

    var index = media.MediaLocalIndexInit()

    let publishStartMs = times.MonotimeMs()
    let receiptRes = orch.WebSceneMediaOrchestratePublishLocalFile(graph, index, "short-video-1",
        fixturePath, "publisher-alpha", "subscriber-bravo", "video/mp4", "h264/aac",
        int64(22000), poster, "short-video-publish-v1", 4096, 1024, 2)
    let publishMs = times.MonotimeMs() - publishStartMs
    assert(IsOk(receiptRes), Error(receiptRes))
    let receipt = Value(receiptRes)

    # Real fountain publish artifacts from the actual short video.
    assert(len(receipt.assetCid) > 0, " publish: assetCid present")
    assert(len(receipt.bundleCid) > 0, " publish: bundleCid present")
    assert(len(receipt.manifestCid) > 0, " publish: manifestCid present")
    assert(receipt.objectCount > 0, " publish: fountain object count > 0")
    assert(receipt.dropletCount > 0, " publish: fountain repair droplet count > 0")
    assert(scene.WebSceneMediaAssetCount(graph) == 1, " publish: fountain asset registered on scene graph")

    # 对端秒开 render binding: bind a playback slot to the <video> node.
    let assetIdx = scene.WebSceneFindMediaAssetIndex(graph, "short-video-1")
    assert(assetIdx >= 0, " publish: locate registered asset")
    let asset = graph.mediaAssets[assetIdx]
    assert(orch.WebSceneMediaOrchestrateBindPlaybackSlot(graph, asset, "short-video-slot-1",
                                                         receipt.manifestCid, 0, 2,
                                                         "template.native.video.player", "short.video.state",
                                                         "decode-fountain", "gpu-texture", "audio-out", "cover"),
           " publish: bind playback slot for 秒开")

    assert(publishMs >= int64(0), " publish: ingest timing")
    echo(strutil.Join([" web_scene_media_publish_smoke ok ingest_ms=", IntToStr(int32(publishMs))], ""))
    return 0
