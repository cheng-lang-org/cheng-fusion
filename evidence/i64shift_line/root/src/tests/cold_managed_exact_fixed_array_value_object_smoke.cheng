import std/system as system

type
    ColdManagedExactFixedArrayValueLeaf =
        label: str

    ColdManagedExactFixedArrayValueOwner =
        leaves: ColdManagedExactFixedArrayValueLeaf[2]

fn ColdManagedExactFixedArrayValueNew(value: str): str =
    return system.NewStringCopy(
        system.StrDataPtr(value), value.len)

fn ColdManagedExactFixedArrayValueObjectExercise(): int32 =
    var owner: ColdManagedExactFixedArrayValueOwner
    owner.leaves[0].label = ColdManagedExactFixedArrayValueNew("left")
    owner.leaves[1].label = ColdManagedExactFixedArrayValueNew("right")

    owner.leaves[0] = owner.leaves[0]
    var replacement: ColdManagedExactFixedArrayValueLeaf
    replacement.label = ColdManagedExactFixedArrayValueNew("new-left")
    owner.leaves[0] = replacement
    owner.leaves[1] = ColdManagedExactFixedArrayValueLeaf()

    if owner.leaves[0].label != "new-left" ||
       len(owner.leaves[1].label) != 0:
        return 1
    return 0

fn main(): int32 =
    let allocBefore = system.memAllocCount()
    let freeBefore = system.memFreeCount()
    let liveBefore = system.memLiveCount()
    let retainBefore = system.memRetainCount()
    let releaseBefore = system.memReleaseCount()

    if ColdManagedExactFixedArrayValueObjectExercise() != 0:
        return 1

    let allocDelta = system.memAllocCount() - allocBefore
    let freeDelta = system.memFreeCount() - freeBefore
    let retainDelta = system.memRetainCount() - retainBefore
    let releaseDelta = system.memReleaseCount() - releaseBefore
    if allocDelta <= int64(0) || allocDelta != freeDelta:
        return 2
    if system.memLiveCount() != liveBefore:
        return 3
    if releaseDelta != retainDelta + freeDelta:
        return 4
    echo("cold_managed_exact_fixed_array_value_object=PASS")
    return 0
