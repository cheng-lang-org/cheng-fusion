# gov_epoch_smoke (ge3): governance key-epoch floor. Monotone raise,
# forced-line refusals below the floor, invalid target refusal, exact
# error messages, activation timestamp binding, forced-flag flip.

import std/os
import std/system
import cheng/apps/rwad/rwad_gov_epoch as gov

fn main(): int32 =
    var rc: int32 = 0

    var book: gov.GovEpochBook
    let ini = gov.GovInit(book, 1)
    if !ini.ok:
        os.WriteLine(os.Get_stderr(), "ge3: init rejected")
        return 1
    if book.minKeyEpoch != 0:
        os.WriteLine(os.Get_stderr(), "ge3: init floor not 0")
        rc = rc + 1
    if book.currentEpoch != 1:
        os.WriteLine(os.Get_stderr(), "ge3: init current epoch not 1")
        rc = rc + 1

    let forcedBefore = gov.GovIsForced(book)
    if forcedBefore:
        os.WriteLine(os.Get_stderr(), "ge3: forced before any raise")
        rc = rc + 1

    # floor 0: both canonical epochs pass
    let a0 = gov.GovAcceptIdentity(book, 0)
    if !a0.ok:
        os.WriteLine(os.Get_stderr(), "ge3: epoch0 rejected at floor 0")
        rc = rc + 1
    let a1 = gov.GovAcceptIdentity(book, 1)
    if !a1.ok:
        os.WriteLine(os.Get_stderr(), "ge3: epoch1 rejected at floor 0")
        rc = rc + 1

    # raise floor to 1, bind activation timestamp
    let up = gov.GovSetMinEpoch(book, 1, Int64(1712345678901))
    if !up.ok:
        os.WriteLine(os.Get_stderr(), "ge3: raise to 1 rejected")
        rc = rc + 1
    if book.minKeyEpoch != 1:
        os.WriteLine(os.Get_stderr(), "ge3: floor did not reach 1")
        rc = rc + 1
    if book.activatedAtMs != Int64(1712345678901):
        os.WriteLine(os.Get_stderr(), "ge3: activation timestamp not bound")
        rc = rc + 1

    # floor 1: epoch0 refused with exact message, epoch1 passes
    let b0 = gov.GovAcceptIdentity(book, 0)
    if b0.ok:
        os.WriteLine(os.Get_stderr(), "ge3: epoch0 accepted past floor 1")
        rc = rc + 1
    if !b0.ok and b0.err.msg != "epoch below forced line":
        os.WriteLine(os.Get_stderr(), "ge3: wrong refusal message for epoch0")
        rc = rc + 1
    let b1 = gov.GovAcceptIdentity(book, 1)
    if !b1.ok:
        os.WriteLine(os.Get_stderr(), "ge3: epoch1 rejected at floor 1")
        rc = rc + 1

    # lowering refused with exact message, state untouched
    let lower = gov.GovSetMinEpoch(book, 0, Int64(1712345678902))
    if lower.ok:
        os.WriteLine(os.Get_stderr(), "ge3: floor lowered to 0 accepted")
        rc = rc + 1
    if !lower.ok and lower.err.msg != "cannot lower floor":
        os.WriteLine(os.Get_stderr(), "ge3: wrong message for lowering")
        rc = rc + 1
    if book.minKeyEpoch != 1:
        os.WriteLine(os.Get_stderr(), "ge3: refused lower mutated floor")
        rc = rc + 1

    # non-canonical target refused with exact message
    let illegal = gov.GovSetMinEpoch(book, 2, Int64(1712345678903))
    if illegal.ok:
        os.WriteLine(os.Get_stderr(), "ge3: illegal target 2 accepted")
        rc = rc + 1
    if !illegal.ok and illegal.err.msg != "invalid epoch":
        os.WriteLine(os.Get_stderr(), "ge3: wrong message for illegal target")
        rc = rc + 1

    let forcedAfter = gov.GovIsForced(book)
    if !forcedAfter:
        os.WriteLine(os.Get_stderr(), "ge3: forced flag false after raise")
        rc = rc + 1

    if rc == 0:
        echo("gov_epoch_smoke ok (ge3)")
    return rc
