# RFC draft-irtf-cfrg-vrf-15 Appendix B.3 official test vectors.
# ECVRF-EDWARDS25519-SHA512-TAI: prove/proof_to_hash/verify byte-for-byte,
# plus tamper negatives. Any mismatch exits non-zero.

import std/os
import std/system
import std/rawbytes
import std/strutils as strutil
import std/crypto/vrf as vrf

@borrows
fn CheckEq(tag: str, got: Bytes, want: Bytes): int32 =
    if got.len != want.len:
        os.WriteLine(os.Get_stderr(), tag)
        os.WriteLine(os.Get_stderr(), " length mismatch")
        return 1
    var i: int32
    while i < got.len:
        if BytesGet(got, i) != BytesGet(want, i):
            os.WriteLine(os.Get_stderr(), tag)
            os.WriteLine(os.Get_stderr(), " byte mismatch")
            return 1
        i = i + 1
    return 0

fn main(): int32 =
    # Example 16
    let sk16 = BytesFromHex("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
    let pk16 = BytesFromHex("d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a")
    let alpha16 = EmptyBytes()
    let pi16 = BytesFromHex("8657106690b5526245a92b003bb079ccd1a92130477671f6fc01ad16f26f723f26f8a57ccaed74ee1b190bed1f479d9727d2d0f9b005a6e456a35d4fb0daab1268a1b0db10836d9826a528ca76567805")
    let beta16 = BytesFromHex("90cf1df3b703cce59e2a35b925d411164068269d7b2d29f3301c03dd757876ff66b71dda49d2de59d03450451af026798e8f81cd2e333de5cdf4f3e140fdd8ae")
    # Example 17
    let alpha17 = BytesFromHex("72")
    let sk17 = BytesFromHex("4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb")
    let pk17 = BytesFromHex("3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c")
    let pi17 = BytesFromHex("f3141cd382dc42909d19ec5110469e4feae18300e94f304590abdced48aed5933bf0864a62558b3ed7f2fea45c92a465301b3bbf5e3e54ddf2d935be3b67926da3ef39226bbc355bdc9850112c8f4b02")
    let beta17 = BytesFromHex("eb4440665d3891d668e7e0fcaf587f1b4bd7fbfe99d0eb2211ccec90496310eb5e33821bc613efb94db5e5b54c70a848a0bef4553a41befc57663b56373a5031")
    # Example 18
    let sk18 = BytesFromHex("c5aa8df43f9f837bedb7442f31dcb7b166d38535076f094b85ce3a2e0b4458f7")
    let pk18 = BytesFromHex("fc51cd8e6218a1a38da47ed00230f0580816ed13ba3303ac5deb911548908025")
    let alpha18 = BytesFromHex("af82")
    let pi18 = BytesFromHex("9bc0f79119cc5604bf02d23b4caede71393cedfbb191434dd016d30177ccbf8096bb474e53895c362d8628ee9f9ea3c0e52c7a5c691b6c18c9979866568add7a2d41b00b05081ed0f58ee5e31b3a970e")
    let beta18 = BytesFromHex("645427e5d00c62a23fb703732fa5d892940935942101e456ecca7bb217c61c452118fec1219202a0edcf038bb6373241578be7217ba85a2687f7a0310b2df19f")

    var rc: int32 = 0

    # public key derivation x*B must match PK for all three examples
    let pkDer16 = vrf.VrfPublicFromSecret(sk16)
    rc = rc + CheckEq("ex16_pk", pkDer16.value, pk16)
    let pkDer17 = vrf.VrfPublicFromSecret(sk17)
    rc = rc + CheckEq("ex17_pk", pkDer17.value, pk17)
    let pkDer18 = vrf.VrfPublicFromSecret(sk18)
    rc = rc + CheckEq("ex18_pk", pkDer18.value, pk18)

    # proving reproduces official pi
    let proveRes16 = vrf.VrfProve(sk16, alpha16)
    if !proveRes16.ok:
        os.WriteLine(os.Get_stderr(), "ex16 prove errored")
        rc = rc + 1
    else:
        rc = rc + CheckEq("ex16_pi", proveRes16.value, pi16)
    let proveRes17 = vrf.VrfProve(sk17, alpha17)
    if !proveRes17.ok:
        os.WriteLine(os.Get_stderr(), "ex17 prove errored")
        rc = rc + 1
    else:
        rc = rc + CheckEq("ex17_pi", proveRes17.value, pi17)
    let proveRes18 = vrf.VrfProve(sk18, alpha18)
    if !proveRes18.ok:
        os.WriteLine(os.Get_stderr(), "ex18 prove errored")
        rc = rc + 1
    else:
        rc = rc + CheckEq("ex18_pi", proveRes18.value, pi18)

    # proof-to-hash reproduces official beta
    let p2h16 = vrf.VrfProofToHash(pi16)
    rc = rc + CheckEq("ex16_beta", p2h16.value, beta16)
    let p2h17 = vrf.VrfProofToHash(pi17)
    rc = rc + CheckEq("ex17_beta", p2h17.value, beta17)
    let p2h18 = vrf.VrfProofToHash(pi18)
    rc = rc + CheckEq("ex18_beta", p2h18.value, beta18)

    # verify accepts and outputs beta equal to proof_to_hash
    let ver16 = vrf.VrfVerify(pk16, alpha16, pi16)
    if !ver16.ok:
        os.WriteLine(os.Get_stderr(), "ex16 verify rejected valid proof")
        rc = rc + 1
    else:
        rc = rc + CheckEq("ex16_verify_beta", ver16.value, beta16)
    let ver17 = vrf.VrfVerify(pk17, alpha17, pi17)
    if !ver17.ok:
        os.WriteLine(os.Get_stderr(), "ex17 verify rejected valid proof")
        rc = rc + 1
    else:
        rc = rc + CheckEq("ex17_verify_beta", ver17.value, beta17)
    let ver18 = vrf.VrfVerify(pk18, alpha18, pi18)
    if !ver18.ok:
        os.WriteLine(os.Get_stderr(), "ex18 verify rejected valid proof")
        rc = rc + 1
    else:
        rc = rc + CheckEq("ex18_verify_beta", ver18.value, beta18)

    # negative: neighbor message must fail verification
    let badAlpha = BytesFromHex("73")
    let verBad = vrf.VrfVerify(pk17, badAlpha, pi17)
    if verBad.ok:
        os.WriteLine(os.Get_stderr(), "negative case failed: tampered alpha accepted")
        rc = rc + 1

    # negative: flipped proof byte must fail verification (no xor op; use mod arithmetic)
    var piTamper = BytesAlloc(pi18.len)
    var i: int32
    while i < pi18.len:
        BytesSet(piTamper, i, BytesGet(pi18, i))
        i = i + 1
    BytesSet(piTamper, 10, (BytesGet(piTamper, 10) + 1) % 256)
    let verTamper = vrf.VrfVerify(pk18, alpha18, piTamper)
    if verTamper.ok:
        os.WriteLine(os.Get_stderr(), "negative case failed: tampered gamma accepted")
        rc = rc + 1

    if rc == 0:
        echo("vrf_tai_vectors_smoke ok")
    return rc
