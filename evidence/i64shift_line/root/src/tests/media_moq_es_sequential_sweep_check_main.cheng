# Sequential ES sweep timing probe — drives the SAME production sequential-playback pump
# the mobile host uses (WebSceneMediaEsStreamLoop, web_scene_media_network_bridge.cheng)
# against a real media_moq_publisher_main process, real QUIC, real ES fixture bytes. No
# mocked network, no synthetic frame data, no fallback/heuristic timing.
#
# Used by src/tests/media_moq_e2e_timing_gate.sh's "丝滑" door (S4 of
# docs/cheng-video-e2e-miaofa-miaokai-plan.md): sweeps every frame of whichever ES fixture
# the publisher is serving and reports the worst-case per-frame delivery time.
#
# NOT built around WebSceneMediaEsSeekToFrame: that call only repositions the pump cursor
# (snap-to-nearest-keyframe-at-or-before) and issues zero network I/O by itself — looping
# it alone would measure nothing real. The actual frame-delivery path is
# WebSceneMediaEsStreamLoop: each tick pulls ONE contiguous "run" of frames (grouped under
# a 128KiB byte budget, see webSceneMediaEsRunByteBudget) in a single QUIC range-fetch and
# hands each frame to the host sink. This binary calls StreamLoop repeatedly from the
# fresh-open cursor (frame 0) until it reports "ended" (rc=7), timing every tick and
# dividing each tick's wall time by the number of frames that tick delivered — the same
# amortized per-frame cost the real host FIFO experiences under normal (non-backpressured)
# playback, since frames within one run are decoded/delivered from the SAME network
# round-trip, not from independent per-frame requests.
#
# Host sink: src/tests/host_stub/es_pump_backpressure_test_host_stub.c (already in tree,
# reused as-is — its sink always returns 1/"keep going" so a run drains in one tick, and it
# already exposes cheng_test_es_sink_captured() for exact per-tick delivered-frame counts).
#
# Prints one line per tick ("tick=<n> run_frames=<f> run_ms=<t> per_frame_ms=<avg>") then a
# final "SWEEP_OK frames=<total> ticks=<n> total_ms=<t> max_per_frame_ms=<worst>" summary
# the calling shell harness parses. Any failure prints "FAIL: <reason>" and exits nonzero.

import std/os
import std/times
import std/strutils as strutil
import std/cmdline as cmdline
import cheng/core/runtime/web_scene_media_network_bridge as media_bridge

@importc("cheng_test_es_sink_captured")
fn chengTestEsSinkCaptured(): int32

fn fail(msg: str): int32 =
    os.WriteLine(os.Get_stdout(), strutil.Join(["FAIL: ", msg], ""))
    return 1

fn main(): int32 =
    var hostRaw: str
    let hasHost: bool = cmdline.ReadFirstFlagValue("--host", hostRaw)
    let host: str = if hasHost: hostRaw else: "127.0.0.1"
    let port: int32 = cmdline.ReadInt32FlagOrDefault("--port", 38000)

    if !media_bridge.WebSceneMediaEsOpen(host, port):
        return fail(strutil.Join(["es_open failed: ", media_bridge.WebSceneMediaEsLastError()], ""))
    let frameCount: int32 = media_bridge.WebSceneMediaEsFrameCount()
    if frameCount <= 0:
        return fail("frame count is zero after open")
    let fps: int32 = media_bridge.WebSceneMediaEsFps()
    os.WriteLine(os.Get_stdout(), strutil.Join(["step1_open_ok frames=", IntToStr(frameCount), " fps=", IntToStr(fps)], ""))

    var delivered: int32 = 0
    var tick: int32 = 0
    var maxPerFrameMs: int64 = 0
    var totalMs: int64 = 0
    var running: bool = true
    while running:
        let beforeCaptured: int32 = chengTestEsSinkCaptured()
        let t0: int64 = times.MonotimeMs()
        let rc: int32 = media_bridge.WebSceneMediaEsStreamLoop()
        let t1: int64 = times.MonotimeMs()
        # rc==7 ("ended") is reported on the SAME tick that delivers the clip's final run
        # (StreamLoop deposits the run's frames into the sink, THEN notices
        # nextCursor>=frameCount and returns 7) — so the frame-count/timing accounting
        # below must run for rc==0 AND rc==7 alike, or the last run's frames and wall time
        # go uncounted (caught by the delivered-count assertion below: 657/675 before this
        # fix, i.e. one whole run's worth of frames silently dropped from the summary).
        if rc == 0 || rc == 7:
            if rc == 7:
                running = false
            let afterCaptured: int32 = chengTestEsSinkCaptured()
            let runFrames: int32 = afterCaptured - beforeCaptured
            if runFrames > 0:
                tick = tick + 1
                let runMs: int64 = t1 - t0
                totalMs = totalMs + runMs
                delivered = afterCaptured
                let perFrameMs: int64 = runMs / int64(runFrames)
                if perFrameMs > maxPerFrameMs:
                    maxPerFrameMs = perFrameMs
                os.WriteLine(os.Get_stdout(), strutil.Join(["tick=", IntToStr(tick), " run_frames=", IntToStr(runFrames),
                                                              " run_ms=", Int64ToStr(runMs), " per_frame_ms=", Int64ToStr(perFrameMs)], ""))
            elif rc == 0:
                return fail(strutil.Join(["tick=", IntToStr(tick + 1), " rc=0 but zero frames delivered (stalled run)"], ""))
        else:
            return fail(strutil.Join(["StreamLoop unexpected rc=", IntToStr(rc), " err=", media_bridge.WebSceneMediaEsLastError()], ""))

    if delivered != frameCount:
        return fail(strutil.Join(["delivered frame count mismatch: got=", IntToStr(delivered), " want=", IntToStr(frameCount)], ""))

    os.WriteLine(os.Get_stdout(), strutil.Join(["SWEEP_OK frames=", IntToStr(delivered), " ticks=", IntToStr(tick),
                                                 " total_ms=", Int64ToStr(totalMs), " max_per_frame_ms=", Int64ToStr(maxPerFrameMs)], ""))
    return 0
