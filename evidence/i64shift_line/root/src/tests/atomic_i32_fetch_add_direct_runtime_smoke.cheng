import std/atomic

@importc("__cheng_runtime_atomic_add_i32")
fn runtimeAtomicAddRaw(p: ptr, amount: int32): int32

@importc("cheng_atomic_fetch_add_i32")
fn atomicFetchAddRaw(p: ptr, amount: int32): int32

fn main(): int32 =
    var cell: int32
    cell = 10
    if runtimeAtomicAddRaw(&cell, 5) != 10:
        return 1
    if cell != 15:
        return 2
    if atomicFetchAddRaw(&cell, 0 - 3) != 15:
        return 3
    if cell != 12:
        return 4
    let value = atomic.NewI32(2)
    if value == nil:
        return 5
    if atomic.FetchAddI32(value, 8) != 2:
        return 6
    if atomic.LoadI32(value) != 10:
        return 7
    if atomic.AddI32(value, 4) != 14:
        return 8
    if atomic.LoadI32(value) != 14:
        return 9
    echo(" atomic_i32_fetch_add_direct_runtime_smoke ok")
    return 0
