import cheng/core/runtime/js_runtime as jsrt

fn runMapStringInt32Smoke(): int32 =
    var keys: str[]
    add(keys, "alpha")
    add(keys, "beta")
    add(keys, "gamma")
    var values: int32[]
    add(values, 11)
    add(values, 22)
    add(values, 33)

    var mapValue: jsrt.JsValue
    if !jsrt.JsMapFromStringInt32Entries(keys, values, mapValue):
        return 1
    var out: jsrt.JsValue
    if !jsrt.JsMapGet(mapValue, "beta", out):
        return 2
    if !jsrt.JsValueIsInt32(out):
        return 3
    if jsrt.JsValueInt32(out) != 22:
        return 4

    var updated: jsrt.JsValue
    jsrt.JsValueInitInt32(updated, 44)
    if !jsrt.JsMapSet(mapValue, "beta", updated):
        return 5
    if !jsrt.JsMapGet(mapValue, "beta", out):
        return 6
    if jsrt.JsValueInt32(out) != 44:
        return 7

    if jsrt.JsMapGet(mapValue, "missing", out):
        return 8
    if !jsrt.JsValueIsUndefined(out):
        return 9

    var mapKeys: jsrt.JsArray
    mapKeys = jsrt.JsMapKeys(mapValue)
    if jsrt.JsArrayLength(mapKeys) != 3:
        return 10
    var firstKey: jsrt.JsValue
    if !jsrt.JsArrayGetJsValue(mapKeys, 0, firstKey):
        return 11
    if !jsrt.JsValueIsString(firstKey):
        return 12
    if jsrt.JsValueString(firstKey) != "alpha":
        return 13

    var mapValues: jsrt.JsArray
    mapValues = jsrt.JsMapValues(mapValue)
    if jsrt.JsArrayLength(mapValues) != 3:
        return 14
    var secondValue: jsrt.JsValue
    if !jsrt.JsArrayGetJsValue(mapValues, 1, secondValue):
        return 15
    if !jsrt.JsValueIsInt32(secondValue):
        return 16
    if jsrt.JsValueInt32(secondValue) != 44:
        return 17

    var badKeys: str[]
    add(badKeys, "only")
    var badValues: int32[]
    if jsrt.JsMapFromStringInt32Entries(badKeys, badValues, out):
        return 18
    if !jsrt.JsValueIsUndefined(out):
        return 19
    return 0

fn main(): int32 =
    let code = runMapStringInt32Smoke()
    if code != 0:
        echo(Fmt"FAIL runMapStringInt32Smoke: {code}")
        return code
    echo(" js_runtime_map_string_int32_smoke ok")
    return 0
