import std/strformat
import std/strutils as strutil
import cheng/core/backend/canonical_type_chain as chain
import cheng/core/backend/lowering_plan as lower
import cheng/core/lang/parser
import cheng/core/lang/typed_expr_type_arena as typearena
import cheng/core/runtime/arena as arenamod
import cheng/core/tooling/compiler_csg as ccsg

fn appendAliasSource(parts: var str[],
                     prefix: str,
                     depth: int32) =
    for index in 0..<depth:
        let target = index == 0 ?
            "int32" :
            Fmt"{prefix}{index - 1}"
        add(parts, Fmt"type {prefix}{index} = {target}\n")

fn realApplyArenaInto(
        treeOut: var parser.ParserValueExprTree,
        arenaOut: var typearena.TypedExprTypeArena,
        applyTypeIdOut: var int32,
        declarationTypeIdOut: var int32,
        firstArgumentTypeIdOut: var int32,
        secondArgumentTypeIdOut: var int32) =
    var sourceParts = ["type Box[T, U] = int32\n"]
    appendAliasSource(sourceParts, "A", 129)
    appendAliasSource(sourceParts, "B", 512)
    add(sourceParts, "type Use = Box[A128, B511]\n")
    let source = strutil.Join(sourceParts, "")
    var tree: parser.ParserValueExprTree
    var err: str
    assert(parser.ParserValueExprReadTreeFromText(
               source, tree, err),
           Fmt"canonical type chain: real Apply parser failed {err}")
    var authority: typearena.TypedExprTypeResolutionAuthority
    assert(typearena.TypedExprTypeResolutionAuthorityBuildSameSourceInto(
               tree, authority, err),
           Fmt"canonical type chain: real Apply authority failed {err}")
    var arena: typearena.TypedExprTypeArena
    assert(typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               tree, authority, arena, err) &&
           typearena.TypedExprTypeArenaStrictValidateInto(arena, err),
           Fmt"canonical type chain: real Apply TypeArena failed {err}")
    var applyTypeId: int32 = -1
    for row in 0..<tree.typeSyntaxCount:
        if parser.ParserValueExprTypeSyntaxKindAt(tree, row) ==
               parser.ParserTypeSyntaxBracketApply:
            let candidate =
                typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
                    arena, row)
            if applyTypeId >= 0 && applyTypeId != candidate:
                panic("canonical type chain: real Apply is not unique")
            applyTypeId = candidate
    assert(applyTypeId >= 0,
           "canonical type chain: real Apply missing")
    let childStart = arenamod.ArenaArrayInt32Get(
        arena.arena, arena.childStarts, applyTypeId)
    let childCount = arenamod.ArenaArrayInt32Get(
        arena.arena, arena.childCounts, applyTypeId)
    assert(childCount == 3,
           "canonical type chain: real Apply child cardinality")
    applyTypeIdOut = applyTypeId
    declarationTypeIdOut = arenamod.ArenaArrayInt32Get(
        arena.arena, arena.childTypeIds, childStart)
    firstArgumentTypeIdOut = arenamod.ArenaArrayInt32Get(
        arena.arena, arena.childTypeIds, childStart + 1)
    secondArgumentTypeIdOut = arenamod.ArenaArrayInt32Get(
        arena.arena, arena.childTypeIds, childStart + 2)
    treeOut = tree
    arenaOut = arena

fn typeArenaAliasDepth(
        arena: typearena.TypedExprTypeArena,
        typeId: int32): int32 =
    var current = typeId
    var depth: int32
    var visited: bool[]
    setLen(visited, arena.typeCount)
    while true:
        if current < 0 || current >= arena.typeCount ||
           visited[current]:
            panic("canonical type chain: real alias chain invalid")
        if typearena.TypedExprTypeArenaKindAt(
               arena, current) !=
               typearena.TypedExprStructuralTypeAlias:
            return depth
        visited[current] = true
        let childStart = arenamod.ArenaArrayInt32Get(
            arena.arena, arena.childStarts, current)
        current = arenamod.ArenaArrayInt32Get(
            arena.arena, arena.childTypeIds, childStart)
        depth = depth + 1

fn projectRealApply(
        arena: typearena.TypedExprTypeArena,
        planOut: var lower.LoweringPlanStub,
        err: var str): bool =
    var csg: ccsg.CompilerCsg
    csg.typeArena = arena
    planOut.typeArenaArtifactCid = arena.artifactRaw32
    return ccsg.CompilerCsgCanonicalTypeFactsInto(
        csg,
        planOut.typeArenaStructuralKinds,
        planOut.typeArenaScalarKinds,
        planOut.typeArenaChildTypeIds,
        planOut.typeArenaLayoutChildStarts,
        planOut.typeArenaLayoutChildCounts,
        planOut.typeArenaLayoutChildTypeIds,
        planOut.typeArenaLayoutChildIdentityKinds,
        planOut.typeArenaLayoutChildMemberRows,
        planOut.typeArenaLayoutChildSelectorOrdinals,
        planOut.typeArenaLayoutChildOffsets,
        planOut.typeArenaLayoutChildWidths,
        planOut.typeArenaFixedLengths,
        planOut.typeArenaVariantCounts,
        planOut.typeArenaSizeBytes,
        planOut.typeArenaAlignBytes,
        planOut.typeArenaLayoutPresent,
        err)

fn projectionRejectsChildCount(
        arena: typearena.TypedExprTypeArena,
        applyTypeId: int32,
        childCount: int32): bool =
    var mutated = typearena.TypedExprTypeArenaClone(arena)
    arenamod.ArenaArrayInt32Set(
        mutated.arena, mutated.childCounts, applyTypeId, childCount)
    mutated.artifactRaw32 =
        typearena.TypedExprTypeArenaArtifactCidForCurrentState(
            mutated)
    var plan: lower.LoweringPlanStub
    var err: str
    let rejected = !projectRealApply(mutated, plan, err)
    typearena.TypedExprTypeArenaRelease(mutated)
    return rejected

fn main(): int32 =
    var tree: parser.ParserValueExprTree
    var arena: typearena.TypedExprTypeArena
    var applyTypeId: int32
    var declarationTypeId: int32
    var firstArgumentTypeId: int32
    var secondArgumentTypeId: int32
    realApplyArenaInto(tree,
                       arena,
                       applyTypeId,
                       declarationTypeId,
                       firstArgumentTypeId,
                       secondArgumentTypeId)
    assert(typeArenaAliasDepth(arena, firstArgumentTypeId) == 129 &&
           typeArenaAliasDepth(arena, secondArgumentTypeId) == 512,
           "canonical type chain: real Apply argument depth drift")
    var plan: lower.LoweringPlanStub
    var err: str
    assert(projectRealApply(arena, plan, err),
           Fmt"canonical type chain: real Apply projection failed {err}")
    assert(plan.typeArenaChildTypeIds[applyTypeId] ==
               declarationTypeId &&
           chain.CanonicalTypeChainPhysicalTypeId(
               plan, applyTypeId) ==
           chain.CanonicalTypeChainPhysicalTypeId(
               plan, declarationTypeId),
           "canonical type chain: Apply did not project declaration child")
    assert(projectionRejectsChildCount(arena, applyTypeId, 0) &&
           projectionRejectsChildCount(arena, applyTypeId, 1),
           "canonical type chain: invalid Apply child count survived")
    typearena.TypedExprTypeArenaRelease(arena)
    parser.ParserValueExprTreeRelease(tree)
    echo("canonical_type_chain_real_apply=1")
    echo("canonical_type_chain_apply_argument_depth_129_512=1")
    echo("canonical_type_chain_apply_0_1_child_hard_fail=1")
    return 0
