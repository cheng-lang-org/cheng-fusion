import std/os
import std/result
import std/strutils as strutil
import cheng/std/bytes_layout as layout
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/tooling/csg_normalize as csgnorm

fn StrictWireNode(nodeId: int32,
                  nodeKind: int32,
                  ownerNodeId: int32,
                  modulePath: str,
                  symbolText: str,
                  returnType: str,
                  exported: bool,
                  exportName: str): ccsg.CompilerCsgNode =
    var out: ccsg.CompilerCsgNode
    out.nodeId = nodeId
    out.nodeKind = nodeKind
    out.ownerNodeId = ownerNodeId
    out.modulePath = modulePath
    out.symbolText = symbolText
    out.factText = symbolText
    out.semanticSource = modulePath
    out.semanticDeclarationLineIndex = nodeId
    out.semanticParamTypeJoin = ""
    out.semanticReturnType = returnType
    out.semanticSignatureComplete = nodeKind == ccsg.CompilerCsgNodeKindSymbol ? 1 : 0
    out.resultLayoutKind = nodeKind == ccsg.CompilerCsgNodeKindSymbol ? 1 : 0
    out.effectKind = nodeKind == ccsg.CompilerCsgNodeKindSymbol ? 1 : 0
    out.capabilityKind = nodeKind == ccsg.CompilerCsgNodeKindSymbol ? 1 : 0
    out.exportedFlag = exported ? 1 : 0
    out.exportSymbolName = exportName
    out.exportNameExplicit = exported ? 1 : 0
    out.factCid = ccsg.CompilerCsgHashNodeRecord(out)
    return out

fn StrictWireEdge(edgeId: int32,
                  fromNodeId: int32,
                  toNodeId: int32): ccsg.CompilerCsgEdge =
    var out: ccsg.CompilerCsgEdge
    out.edgeId = edgeId
    out.edgeKind = ccsg.CompilerCsgEdgeKindContains
    out.fromNodeId = fromNodeId
    out.toNodeId = toNodeId
    out.edgeCid = ccsg.CompilerCsgHashEdge(fromNodeId,
                                          toNodeId,
                                          out.edgeKind)
    return out

fn AssertCompilerCsgTerminalReleased(csg: var ccsg.CompilerCsg) =
    assert(csg.packageId == "" &&
           csg.nodeCount == 0 && csg.edgeCount == 0 &&
           csg.nodes.len == 0 && csg.edges.len == 0 &&
           csg.exprLayer.exprs.len == 0 &&
           csg.typedExprFacts.count == 0 &&
           csg.typedExprFacts.internPool == nil &&
           csg.typedExprFacts.arena.basePtr == nil &&
           csg.typedIr.internPool == nil &&
           csg.typedIr.arena.basePtr == nil &&
           csg.semanticGraph.resolvedCallTable.internPool == nil &&
           csg.parserNormalizedExprReceipt.sourceSidecars.len == 0 &&
           csg.parserNormalizedExprReceipt.envelope.countKeys.len == 0 &&
           csg.parserNormalizedExprReceipt.envelope.countValues.len == 0 &&
           csg.logicalPayloadBytes == int64(0) &&
           csg.retainedCapacityBytes == int64(0) &&
           csg.arenaLogicalPayloadBytes == int64(0) &&
           csg.arenaRetainedCapacityBytes == int64(0) &&
           csg.internLogicalPayloadBytes == int64(0) &&
           csg.internRetainedCapacityBytes == int64(0),
           "strict wire: terminal release retained compiler CSG owner")

fn main() =
    var csg: ccsg.CompilerCsg
    csg.packageId = "cheng"
    add(csg.nodes, StrictWireNode(1,
                                  ccsg.CompilerCsgNodeKindPackage,
                                  0,
                                  csg.packageId,
                                  csg.packageId,
                                  "",
                                  false,
                                  ""))
    add(csg.nodes, StrictWireNode(2,
                                  ccsg.CompilerCsgNodeKindModule,
                                  1,
                                  "cheng/strict-wire/main",
                                  "main",
                                  "",
                                  false,
                                  ""))
    add(csg.nodes, StrictWireNode(3,
                                  ccsg.CompilerCsgNodeKindSymbol,
                                  2,
                                  "cheng/strict-wire/main",
                                  "Zulu",
                                  "int32",
                                  true,
                                  "strict_zulu"))
    add(csg.nodes, StrictWireNode(4,
                                  ccsg.CompilerCsgNodeKindSymbol,
                                  2,
                                  "cheng/strict-wire/main",
                                  "Alpha",
                                  "int32",
                                  true,
                                  "strict_alpha"))
    add(csg.edges, StrictWireEdge(1, 1, 2))
    add(csg.edges, StrictWireEdge(2, 2, 3))
    add(csg.edges, StrictWireEdge(3, 2, 4))
    csg.nodeCount = csg.nodes.len
    csg.edgeCount = csg.edges.len
    csg.canonicalGraphCid = csgnorm.CsgNormalizedGraphCid(csg.packageId,
                                                          csg.nodes,
                                                          csg.edges)

    let sidecar = ccsg.CompilerCsgCanonicalSidecarReport(csg)
    var parsedCanonical: layout.FixedBytes32
    var err = ""
    assert(ccsg.CompilerCsgCanonicalGraphCidFromReportTextInto(
               sidecar, parsedCanonical, err), err)
    assert(layout.FixedBytes32Equal(parsedCanonical, csg.canonicalGraphCid),
           "strict wire: canonical graph cid roundtrip drift")
    let stableCanonical = ccsg.CompilerCsgCanonicalGraphCidFromReportText(sidecar)
    assert(!IsErr(stableCanonical) &&
           layout.FixedBytes32Equal(Value(stableCanonical),
                                    csg.canonicalGraphCid),
           "strict wire: stable canonical reader drift")
    assert(IsErr(ccsg.CompilerCsgCanonicalGraphCidFromReportText(
                     strutil.Join([sidecar, "\nextra=1"], ""))),
           "strict wire: canonical reader accepted extra field")
    let reorderedSidecar = strutil.Replace(
        sidecar,
        "node[0]=1|",
        "node[1]=1|")
    assert(IsErr(ccsg.CompilerCsgCanonicalGraphCidFromReportText(
                     reorderedSidecar)),
           "strict wire: canonical reader accepted row reorder/duplicate")
    assert(IsErr(ccsg.CompilerCsgCanonicalGraphCidFromReportText(
                     ccsg.CompilerCsgReport(csg))),
           "strict wire: stable canonical reader accepted diagnostic bytes")

    let surface = ccsg.CompilerExportSurfaceFromCsg(csg)
    assert(surface.exportedSymbolCount == 2 &&
           surface.exportedSymbols[0] == "Alpha" &&
           surface.exportedSymbols[1] == "Zulu",
           "strict wire: export surface not canonical")
    let surfaceReport = ccsg.CompilerExportSurfaceReport(surface)
    assert(!strutil.Contains(surfaceReport, "version="),
           "strict wire: current export surface leaked version")
    var parsedSurface: ccsg.CsgExportSurface
    let parsedSurfaceRes = ccsg.CompilerExportSurfaceFromReportText(
        surfaceReport, parsedSurface)
    assert(!IsErr(parsedSurfaceRes), Error(parsedSurfaceRes))
    assert(ccsg.CompilerExportSurfaceCompatible(surface, parsedSurface) &&
           layout.FixedBytes32Equal(surface.surfaceCid,
                                    parsedSurface.surfaceCid),
           "strict wire: export surface roundtrip drift")
    var rejectedSurface: ccsg.CsgExportSurface
    assert(IsErr(ccsg.CompilerExportSurfaceFromReportText(
                     strutil.Join([surfaceReport, "\nextra=1"], ""),
                     rejectedSurface)),
           "strict wire: export surface accepted extra field")
    let reorderedSurface = strutil.Replace(surfaceReport,
                                            "export[0]=",
                                            "export[1]=")
    assert(IsErr(ccsg.CompilerExportSurfaceFromReportText(reorderedSurface,
                                                           rejectedSurface)),
           "strict wire: export surface accepted row reorder/duplicate")
    assert(IsErr(ccsg.CompilerExportSurfaceFromReportText(
                     strutil.Join(["version=2\n", surfaceReport], ""),
                     rejectedSurface)),
           "strict wire: stable export surface accepted versioned bytes")
    ccsg.CompilerCsgTerminalRelease(csg)
    AssertCompilerCsgTerminalReleased(csg)
    ccsg.CompilerCsgTerminalRelease(csg)
    AssertCompilerCsgTerminalReleased(csg)
    os.WriteLine(os.Get_stdout(), "compiler_csg_strict_wire_smoke: ok")
