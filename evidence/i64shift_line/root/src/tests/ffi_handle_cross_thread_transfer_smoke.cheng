import std/atomic
import std/thread

@importc("cheng_ffi_raw_new_i32")
fn cheng_ffi_raw_new_i32(value: int32): ptr

@importc("cheng_ffi_raw_release_i32")
fn cheng_ffi_raw_release_i32(p: ptr): int32

@importc("cheng_tcp_buffer_handle_register_bridge")
fn cheng_tcp_buffer_handle_register_bridge(raw: ptr): uint64

@importc("cheng_tcp_buffer_handle_lease_acquire_bridge")
fn cheng_tcp_buffer_handle_lease_acquire_bridge(
    handle: uint64,
    outPayload: ptr,
    outBorrowGeneration: ptr): int32

@importc("cheng_tcp_buffer_handle_lease_release_bridge")
fn cheng_tcp_buffer_handle_lease_release_bridge(
    handle: uint64,
    borrowGeneration: uint64): int32

@importc("cheng_tcp_buffer_handle_retire_take_bridge")
fn cheng_tcp_buffer_handle_retire_take_bridge(
    handle: uint64,
    outPayload: ptr): int32

type
    TransferCtx = ref object
        handle: uint64
        borrowGeneration: uint64
        releaseRc: atomic.I32

fn ReleaseTransferredLease(raw: ptr) =
    let ctx: TransferCtx = TransferCtx(raw)
    let rc = cheng_tcp_buffer_handle_lease_release_bridge(
        ctx.handle, ctx.borrowGeneration)
    atomic.StoreI32(ctx.releaseRc, rc)

fn main(): int32 =
    let payload = cheng_ffi_raw_new_i32(41)
    assert(payload != nil, " ffi handle transfer: payload allocation")
    let handle = cheng_tcp_buffer_handle_register_bridge(payload)
    assert(handle != uint64(0), " ffi handle transfer: registration")

    var acquiredPayload: ptr
    var borrowGeneration: uint64
    assert(cheng_tcp_buffer_handle_lease_acquire_bridge(
               handle, &acquiredPayload, &borrowGeneration) == 0,
           " ffi handle transfer: acquire on producer thread")
    assert(acquiredPayload == payload && borrowGeneration != uint64(0),
           " ffi handle transfer: exact capability")

    let releaseRc = atomic.NewI32(-99)
    assert(releaseRc != nil, " ffi handle transfer: result cell")
    let ctx = new(TransferCtx)
    assert(ctx != nil, " ffi handle transfer: context")
    ctx.handle = handle
    ctx.borrowGeneration = borrowGeneration
    ctx.releaseRc = releaseRc

    let releaseThread = thread.StartPtr(&ReleaseTransferredLease, &ctx.handle)
    assert(thread.JoinThread(releaseThread),
           " ffi handle transfer: release thread joined")
    assert(atomic.LoadI32(releaseRc) == 0,
           " ffi handle transfer: consumer thread released capability")

    var retired: ptr
    assert(cheng_tcp_buffer_handle_retire_take_bridge(handle, &retired) == 0,
           " ffi handle transfer: retire after transferred release")
    assert(retired == payload, " ffi handle transfer: retired payload")
    assert(cheng_ffi_raw_release_i32(retired) == 0,
           " ffi handle transfer: payload release")

    echo(" ffi_handle_cross_thread_transfer_smoke ok")
    return 0
