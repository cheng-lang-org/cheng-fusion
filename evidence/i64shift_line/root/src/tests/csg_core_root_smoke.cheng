import std/strings
import std/os as os
import cheng/core/csg_core/jsonl
import cheng/core/csg_core/validator as csg

fn expect(cond: bool, code: int32): int32 =
    if !cond:
        os.WriteLine(
            os.Get_stderr(),
            strings.ConcatStr(
                "csg_core_root_smoke code=",
                strings.IntToStr(code)))
        return code
    return 0

@borrows
fn join2(a: str, b: str): str =
    return strings.ConcatStr(strings.ConcatStr(a, "\n"), strings.ConcatStr(b, "\n"))

@borrows
fn join3(a: str, b: str, c: str): str =
    return strings.ConcatStr(strings.ConcatStr(join2(a, b), c), "\n")

@borrows
fn checkRootFromJsonlText(text: str, expectedCount: int32, expectedRoot: str, codeBase: int32): int32 =
    let lines = jsonl.CsgCoreJsonlSplitLines(text)
    if expect(lines.len == expectedCount, codeBase) != 0:
        return codeBase
    let dag = csg.CsgCoreMerkleBuildBoundFromLines(lines)
    if expect(dag.ok, codeBase + 1) != 0:
        return codeBase + 1
    let root = dag.factsRoot
    if expect(root == expectedRoot, codeBase + 1) != 0:
        os.WriteLine(
            os.Get_stderr(),
            strings.ConcatStr(
                strings.ConcatStr(
                    "actual_root=", root),
                strings.ConcatStr(
                    " expected_root=", expectedRoot)))
        return codeBase + 1
    return 0

fn main(): int32 =
    let schemaFact = "{\"features\":[\"core-facts\"],\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}"
    let webSchemaFact = "{\"features\":[\"core-facts\",\"runtime-closure\",\"csg_dialect::web\"],\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}"
    let moduleFact = "{\"id\":\"mod_main\",\"kind\":\"csg.module\",\"path\":\"main.ts\",\"sha256\":\"sha256:abc\"}"
    let unsupportedFact = "{\"code\":\"unsupported_jsx\",\"id\":\"unsupported_one\",\"kind\":\"csg.unsupported\",\"message\":\"unsupported jsx\"}"
    let tombstoneFact = "{\"id\":\"sym_0422_unsupported_node\",\"impact_scope\":\"dead_code_or_unreachable\",\"kind\":\"csg_core::tombstone\",\"original_text_hash\":\"sha256:abc\",\"reason\":\"unsupported_prototype_mutation\",\"schema\":\"csg_core\",\"source_span\":{\"col\":4,\"file\":\"pkg://npm/lodash/index.ts\",\"line\":12}}"

    let minimalText = join2(schemaFact, moduleFact)
    let minimalRoot = "sha256:96cd287810b31addea6d5a031d9ed50f17bdf09a0c46d42c2b91501c66cd6ede"
    if checkRootFromJsonlText(minimalText, 2, minimalRoot, 10) != 0:
        return 1
    let minimalResult = csg.CsgCoreValidateFactLines(jsonl.CsgCoreJsonlSplitLines(minimalText), csg.CsgCoreModeStrict)
    if expect(minimalResult.valid && minimalResult.complete &&
              minimalResult.factCount == 2 &&
              minimalResult.factsRoot == minimalRoot, 12) != 0:
        return 1
    let reorderedText = join2(moduleFact, schemaFact)
    let reorderedResult =
        csg.CsgCoreValidateFactLines(
            jsonl.CsgCoreJsonlSplitLines(reorderedText),
            csg.CsgCoreModeStrict)
    if expect(reorderedResult.valid &&
              reorderedResult.factsRoot == minimalRoot, 13) != 0:
        return 1

    let unsupportedText = join3(schemaFact, moduleFact, unsupportedFact)
    let unsupportedRoot = "sha256:9bb3584ee8ace2fd48b2f0a88d794e37b825c3df988cdbd2a32d6ffe7b425e28"
    if checkRootFromJsonlText(unsupportedText, 3, unsupportedRoot, 20) != 0:
        return 1
    let unsupportedResult = csg.CsgCoreValidateFactLines(jsonl.CsgCoreJsonlSplitLines(unsupportedText), csg.CsgCoreModeStrict)
    if expect(!unsupportedResult.valid && !unsupportedResult.complete &&
              unsupportedResult.unsupportedCount == 1 &&
              unsupportedResult.factsRoot.len == 0, 22) != 0:
        return 1
    let unsupportedSandbox = csg.CsgCoreValidateFactLines(jsonl.CsgCoreJsonlSplitLines(unsupportedText), csg.CsgCoreModeSandbox)
    if expect(unsupportedSandbox.valid && !unsupportedSandbox.complete &&
              unsupportedSandbox.unsupportedCount == 1 &&
              unsupportedSandbox.factsRoot == unsupportedRoot, 23) != 0:
        return 1

    let tombstoneText = join3(schemaFact, moduleFact, tombstoneFact)
    let tombstoneRoot = "sha256:f670c63ca95dead7cae6d0e5e28908d40162872c0fd6b350c668359455062dac"
    if checkRootFromJsonlText(tombstoneText, 3, tombstoneRoot, 30) != 0:
        return 1
    let tombstoneStrict = csg.CsgCoreValidateFactLines(jsonl.CsgCoreJsonlSplitLines(tombstoneText), csg.CsgCoreModeStrict)
    if expect(!tombstoneStrict.valid && !tombstoneStrict.complete, 32) != 0:
        return 1
    let tombstoneSandbox = csg.CsgCoreValidateFactLines(jsonl.CsgCoreJsonlSplitLines(tombstoneText), csg.CsgCoreModeSandbox)
    if expect(tombstoneSandbox.valid && !tombstoneSandbox.complete &&
              tombstoneSandbox.tombstoneCount == 1 &&
              tombstoneSandbox.factsRoot == tombstoneRoot, 33) != 0:
        return 1

    let incompleteModuleFact = "{\"complete\":false,\"id\":\"mod_incomplete\",\"kind\":\"csg.module\",\"path\":\"incomplete.ts\",\"sha256\":\"sha256:def\"}"
    let incompleteText = join2(schemaFact, incompleteModuleFact)
    let incompleteStrict = csg.CsgCoreValidateFactLines(jsonl.CsgCoreJsonlSplitLines(incompleteText), csg.CsgCoreModeStrict)
    if expect(!incompleteStrict.valid && !incompleteStrict.complete &&
              incompleteStrict.factsRoot.len == 0, 40) != 0:
        return 1
    let incompleteSandbox = csg.CsgCoreValidateFactLines(jsonl.CsgCoreJsonlSplitLines(incompleteText), csg.CsgCoreModeSandbox)
    if expect(incompleteSandbox.valid && !incompleteSandbox.complete &&
              incompleteSandbox.factsRoot.len > 0, 41) != 0:
        return 1

    let nestedFeaturesSchemaFact = "{\"kind\":\"csg.core.schema\",\"meta\":{\"features\":[]},\"schema\":\"csg_core\"}"
    let nestedFeaturesText = join2(nestedFeaturesSchemaFact, moduleFact)
    let nestedFeaturesResult = csg.CsgCoreValidateFactLines(jsonl.CsgCoreJsonlSplitLines(nestedFeaturesText), csg.CsgCoreModeStrict)
    if expect(!nestedFeaturesResult.valid &&
              nestedFeaturesResult.factsRoot.len == 0, 42) != 0:
        return 1

    let unknownFact = "{\"id\":\"future_one\",\"kind\":\"csg.future_fact\"}"
    let unknownText = join2(schemaFact, unknownFact)
    let unknownResult = csg.CsgCoreValidateFactLines(jsonl.CsgCoreJsonlSplitLines(unknownText), csg.CsgCoreModeStrict)
    if expect(!unknownResult.valid &&
              unknownResult.factsRoot.len == 0, 43) != 0:
        return 1

    let malformedWebFact = "{\"argumentCount\":0,\"id\":\"web_call_one\",\"kind\":\"csg.web.js_call_ref\",\"targetText\":\"run\"}"
    let malformedWebText = join2(schemaFact, malformedWebFact)
    let malformedWebResult = csg.CsgCoreValidateFactLines(jsonl.CsgCoreJsonlSplitLines(malformedWebText), csg.CsgCoreModeStrict)
    if expect(!malformedWebResult.valid &&
              malformedWebResult.factsRoot.len == 0, 44) != 0:
        return 1

    let unknownSceneFact = "{\"id\":\"scene_future\",\"kind\":\"csg.web.scene.future\"}"
    let unknownSceneText = join2(schemaFact, unknownSceneFact)
    let unknownSceneResult = csg.CsgCoreValidateFactLines(jsonl.CsgCoreJsonlSplitLines(unknownSceneText), csg.CsgCoreModeStrict)
    if expect(!unknownSceneResult.valid &&
              unknownSceneResult.factsRoot.len == 0, 45) != 0:
        return 1

    let sceneNodeFact = "{\"childCount\":0,\"id\":\"scene_node_1\",\"kind\":\"csg.web.scene.node\",\"layerId\":0,\"layoutCount\":0,\"nodeId\":1,\"nodeKind\":\"fragment\",\"ordinal\":0,\"paintCount\":0,\"parentNodeId\":0,\"propCount\":0,\"routeId\":\"root\",\"routeIndex\":0,\"styleCount\":0}"
    let sceneNodeResult = csg.CsgCoreValidateFactLines(jsonl.CsgCoreJsonlSplitLines(join2(webSchemaFact, sceneNodeFact)), csg.CsgCoreModeStrict)
    if expect(sceneNodeResult.valid &&
              sceneNodeResult.complete &&
              sceneNodeResult.factsRoot.len > 0, 46) != 0:
        return 1
    let stringSceneNodeFact = "{\"childCount\":0,\"id\":\"scene_node_string\",\"kind\":\"csg.web.scene.node\",\"layerId\":0,\"layoutCount\":0,\"nodeId\":\"1\",\"nodeKind\":\"fragment\",\"ordinal\":0,\"paintCount\":0,\"parentNodeId\":0,\"propCount\":0,\"routeId\":\"root\",\"routeIndex\":0,\"styleCount\":0}"
    let stringSceneNodeResult = csg.CsgCoreValidateFactLines(jsonl.CsgCoreJsonlSplitLines(join2(schemaFact, stringSceneNodeFact)), csg.CsgCoreModeStrict)
    if expect(!stringSceneNodeResult.valid &&
              stringSceneNodeResult.factsRoot.len == 0, 47) != 0:
        return 1

    let jsxFragmentFact = "{\"children\":[],\"id\":\"jsx_fragment\",\"jsxKind\":\"JsxFragment\",\"kind\":\"csg.jsx\",\"props\":[],\"tagName\":\"\"}"
    let jsxFragmentResult = csg.CsgCoreValidateFactLines(jsonl.CsgCoreJsonlSplitLines(join2(schemaFact, jsxFragmentFact)), csg.CsgCoreModeStrict)
    if expect(jsxFragmentResult.valid &&
              jsxFragmentResult.factsRoot.len > 0, 48) != 0:
        return 1
    let jsxElementWithEmptyTag = "{\"children\":[],\"id\":\"jsx_element_empty\",\"jsxKind\":\"JsxElement\",\"kind\":\"csg.jsx\",\"props\":[],\"tagName\":\"\"}"
    let jsxElementWithEmptyTagResult = csg.CsgCoreValidateFactLines(jsonl.CsgCoreJsonlSplitLines(join2(schemaFact, jsxElementWithEmptyTag)), csg.CsgCoreModeStrict)
    if expect(!jsxElementWithEmptyTagResult.valid &&
              jsxElementWithEmptyTagResult.factsRoot.len == 0, 49) != 0:
        return 1

    let truthRefFact = "{\"id\":\"truth_root\",\"kind\":\"csg.web.truth_ref\",\"nodeRef\":\"ground-truth/root/dom.json\",\"ownerFact\":\"surface_root\",\"surface\":\"root\"}"
    let truthRefResult = csg.CsgCoreValidateFactLines(jsonl.CsgCoreJsonlSplitLines(join2(webSchemaFact, truthRefFact)), csg.CsgCoreModeStrict)
    if expect(truthRefResult.valid &&
              truthRefResult.factsRoot.len > 0, 50) != 0:
        return 1
    let truthRefMissingOwner = "{\"id\":\"truth_missing_owner\",\"kind\":\"csg.web.truth_ref\",\"nodeRef\":\"ground-truth/root/dom.json\",\"surface\":\"root\"}"
    let truthRefMissingOwnerResult = csg.CsgCoreValidateFactLines(jsonl.CsgCoreJsonlSplitLines(join2(schemaFact, truthRefMissingOwner)), csg.CsgCoreModeStrict)
    if expect(!truthRefMissingOwnerResult.valid &&
              truthRefMissingOwnerResult.factsRoot.len == 0, 51) != 0:
        return 1

    let editLifecycleFact = "{\"assetCid\":\"sha256:asset\",\"bundleCid\":\"\",\"dispatch\":\"event-queue\",\"dropletCount\":0,\"eventCid\":\"sha256:edit\",\"eventKind\":\"EditAsset\",\"guard\":\"allowed\",\"id\":\"media_edit\",\"kind\":\"csg.web.media_lifecycle_event\",\"kindCode\":1,\"manifestCid\":\"sha256:manifest\",\"objectCount\":0,\"payload\":{},\"payloadSchema\":\"media.edit\",\"resultStateCode\":2,\"slotId\":\"slot\",\"sourceStateCode\":1,\"statusCode\":1,\"trace\":\"media.edit\",\"transport\":\"\"}"
    let editLifecycleResult = csg.CsgCoreValidateFactLines(jsonl.CsgCoreJsonlSplitLines(join2(webSchemaFact, editLifecycleFact)), csg.CsgCoreModeStrict)
    if expect(editLifecycleResult.valid &&
              editLifecycleResult.factsRoot.len > 0, 52) != 0:
        return 1

    let audioReceiptFact = "{\"assetCid\":\"sha256:asset\",\"audioDataCid\":\"sha256:audio\",\"audioProvider\":\"pcm\",\"bitsPerSample\":16,\"bytesReady\":1,\"channelCount\":2,\"decodedHeight\":0,\"decodedWidth\":0,\"elapsedMs\":\"1\",\"firstAudioCid\":\"sha256:first-audio\",\"firstFrameCid\":\"\",\"firstImageCid\":\"\",\"id\":\"audio_receipt\",\"initBytesReady\":1,\"initSegmentCid\":\"sha256:init\",\"kind\":\"csg.web.media_frame_receipt\",\"kindCode\":3,\"manifestCid\":\"sha256:manifest\",\"openToMediaMs\":\"1\",\"pcmDataBytes\":4,\"pcmDataOffset\":0,\"pixelBufferHandle\":\"0\",\"pixelFormat\":0,\"receiptKind\":\"Audio\",\"sampleRateHz\":48000,\"slotId\":\"slot\",\"sourceCode\":1,\"startedAtMs\":\"1\",\"textureHandle\":\"0\",\"textureProvider\":\"\",\"textureReady\":false,\"trace\":\"media.audio\",\"verified\":true}"
    let audioReceiptResult = csg.CsgCoreValidateFactLines(jsonl.CsgCoreJsonlSplitLines(join2(webSchemaFact, audioReceiptFact)), csg.CsgCoreModeStrict)
    if expect(audioReceiptResult.valid &&
              audioReceiptResult.factsRoot.len > 0, 53) != 0:
        return 1

    return 0
