@profile("driver_safe")

type
    UInt8Ptr = uint8 *

@trusted_abi
fn PutByteStore(ch: int32) =
    let thrAddr = ptr(uint64(268435456))
    *(UInt8Ptr(thrAddr)) = uint8(ch & 255)

@trusted_abi
fn PutBChain() =
    PutByteStore(68)
    PutByteStore(10)

fn main(): int32 =
    PutBChain()
    return 0
