import std/os as os
import std/strings
import std/system
import cheng/core/runtime/production_held_exec_spawn as spawn

fn fail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

fn main(): int32 =
    var unameBuf: os.OsUtsname
    let unameRc = os.UnameRaw(unameBuf)
    os.WriteLine(os.Get_stderr(), strings.IntToStr(unameRc))
    os.WriteLine(os.Get_stderr(), strings.IntToStr(int32(unameBuf.data[0])))
    os.WriteLine(os.Get_stderr(), strings.IntToStr(int32(unameBuf.data[260])))
    let path = system.strToCStringTemp("/usr/libexec/cheng/csg-core-native")
    let fd = os.OpenFdRaw(path, 524288, 0)
    if fd < 0:
        return fail("open held binary failed")
    var childCid: str
    var err: str
    if !spawn.CsgCoreProductionHeldExecLinuxSpawnAndObserveInto(fd, childCid, err):
        let _c = os.CloseFdRaw(fd)
        return fail(err)
    let _c2 = os.CloseFdRaw(fd)
    if childCid.len != 71:
        return fail("child identity cid shape invalid")
    os.WriteLine(os.Get_stdout(), "csg_core_held_exec_linux_spawn_smoke ok")
    os.WriteLine(os.Get_stdout(), childCid)
    return 0
