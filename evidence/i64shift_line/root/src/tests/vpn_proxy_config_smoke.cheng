import std/result
import std/strutils as strutil
import cheng/apps/vpn_proxy/vpn_proxy_config as vpn

fn main(): int32 =
    var parseRes: Result[vpn.VpnProxyConfig]
    let configText: str = strutil.Join([
        "{\"protocol\":\"hy2-tun-v1\",",
        "\"client\":{\"listen\":\"127.0.0.1:1080\",\"cert_der\":\"client.der\",",
        "\"key_pk8_der\":\"client.key\",\"trust_root_der\":\"root.der\",",
        "\"cert_chain_der\":[\"chain-a.der\",\"chain-b.der\"],",
        "\"trust_roots_der\":[\"root-b.der\"],",
        "\"tun\":{\"enabled\":true,\"address\":\"198.18.0.2\",\"mtu\":1500,\"route_mode\":\"global\",",
        "\"dns_mode\":\"fake-ip\",\"fake_ip_prefix\":\"198.18.0.0/16\"}},",
        "\"server\":{\"listen\":\"0.0.0.0:7443\",\"expected_auth\":\"shared-secret\",",
        "\"expected_auth_sha256\":\"930bbdc51b6aed5c2a5678fd6e28dee7a05e8a4b643cfc0b4427c3efb86c0d94\",",
        "\"expected_authority\":\"edge.internal\",\"cc_rx_text\":\"auto\"},",
        "\"security\":{\"auth_mode\":\"token_sha256\",",
        "\"server_pin_sha256\":[\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"],",
        "\"client_cert_mode\":\"off\",\"disable_0rtt\":true},",
        "\"anti_block\":{\"masquerade\":{\"enabled\":true,\"host\":\"www.example.com\",",
        "\"path\":\"/\",\"status\":200,\"body\":\"ok\"}},",
        "\"exits\":[{\"name\":\"64\",\"host\":\"64.176.84.12\",\"port\":7443,",
        "\"transport\":\"udp-quic\",\"server_name\":\"edge-64.internal\",\"authority\":\"edge.internal\",",
        "\"auth\":\"shared-secret\",\"cc_rx\":123456,\"weight\":10},",
        "{\"name\":\"dmit\",\"host\":\"154.26.191.226\",\"port\":7443,",
        "\"server_name\":\"edge-dmit.internal\"}]}"
    ], "")
    parseRes = vpn.VpnProxyParseConfigTextForTest(configText)
    assert(!IsErr(parseRes), " vpn proxy config parse")

    var cfg: vpn.VpnProxyConfig
    cfg = Value(parseRes)
    assert(cfg.protocol == "hy2-tun-v1", " vpn proxy config protocol")
    assert(cfg.client.listen == "127.0.0.1:1080", " vpn proxy config client listen")
    assert(cfg.client.certDer == "client.der", " vpn proxy config client cert")
    assert(cfg.client.keyPk8Der == "client.key", " vpn proxy config client key")
    assert(cfg.client.trustRootDer == "root.der", " vpn proxy config client root")
    assert(cfg.client.certChainDer.len == 2, " vpn proxy config client chain len")
    assert(cfg.client.trustRootsDer.len == 1, " vpn proxy config client roots len")
    assert(cfg.client.tun.enabled, " vpn proxy config tun enabled")
    assert(cfg.client.tun.address == "198.18.0.2", " vpn proxy config tun address")
    assert(cfg.client.tun.mtu == 1500, " vpn proxy config tun mtu")
    assert(cfg.client.tun.routeMode == "global", " vpn proxy config tun route")
    assert(cfg.client.tun.dnsMode == "fake-ip", " vpn proxy config tun dns")
    assert(cfg.client.tun.fakeIpPrefix == "198.18.0.0/16", " vpn proxy config tun fake ip")
    assert(cfg.server.listen == "0.0.0.0:7443", " vpn proxy config server listen")
    assert(cfg.server.expectedAuth == "shared-secret", " vpn proxy config server expected auth")
    assert(cfg.server.expectedAuthSha256 == "930bbdc51b6aed5c2a5678fd6e28dee7a05e8a4b643cfc0b4427c3efb86c0d94",
           " vpn proxy config server expected hash")
    assert(cfg.server.expectedAuthority == "edge.internal", " vpn proxy config server expected authority")
    assert(cfg.server.ccRxText == "auto", " vpn proxy config server cc-rx text")
    assert(cfg.security.authMode == "token_sha256", " vpn proxy config security auth mode")
    assert(cfg.security.serverPinSha256.len == 1, " vpn proxy config security pin len")
    assert(cfg.security.clientCertMode == "off", " vpn proxy config security client cert mode")
    assert(cfg.security.disable0Rtt, " vpn proxy config security disable 0rtt")
    assert(cfg.antiBlock.masquerade.enabled, " vpn proxy config masquerade enabled")
    assert(cfg.antiBlock.masquerade.host == "www.example.com", " vpn proxy config masquerade host")
    assert(cfg.antiBlock.masquerade.status == 200, " vpn proxy config masquerade status")
    assert(cfg.exits.len == 2, " vpn proxy config exits len")
    assert(cfg.exits[0].name == "64", " vpn proxy config first exit name")
    assert(cfg.exits[0].transport == "udp-quic", " vpn proxy config first exit transport")
    assert(cfg.exits[0].authority == "edge.internal", " vpn proxy config first exit authority")
    assert(cfg.exits[0].auth == "shared-secret", " vpn proxy config first exit auth")
    assert(cfg.exits[0].ccRx == 123456, " vpn proxy config first exit cc-rx")
    assert(cfg.exits[0].weight == 10, " vpn proxy config first exit weight")
    assert(cfg.exits[1].serverName == "edge-dmit.internal", " vpn proxy config second exit server name")
    assert(cfg.exits[1].transport == "udp-quic", " vpn proxy config second exit default transport")

    var tcpForwardRes: Result[vpn.VpnProxyConfig]
    tcpForwardRes = vpn.VpnProxyParseConfigTextForTest(strutil.Join([
        "{\"protocol\":\"hy2-tun-v1\",",
        "\"exits\":[{\"name\":\"tcp\",\"transport\":\"tcp-tls-forward\",",
        "\"host\":\"205.186.67.165\",\"port\":443,\"server_name\":\"edge.internal\",",
        "\"auth\":\"cheng-hy2-tun-local-shared-token-2026\",\"cc_rx\":1}]}"
    ], ""))
    assert(!IsErr(tcpForwardRes), " vpn proxy config tcp forward parse")
    assert(Value(tcpForwardRes).exits[0].transport == "tcp-tls-forward", " vpn proxy config tcp forward transport")

    var dialerProxyRes: Result[vpn.VpnProxyConfig]
    dialerProxyRes = vpn.VpnProxyParseConfigTextForTest(strutil.Join([
        "{\"protocol\":\"hy2-tun-v1\",",
        "\"exits\":[",
        "{\"name\":\"front\",\"transport\":\"tcp-tls-forward\",",
        "\"host\":\"198.51.100.10\",\"port\":443,\"server_name\":\"front.internal\",",
        "\"auth\":\"cheng-hy2-tun-local-shared-token-2026\"},",
        "{\"name\":\"ai-clean\",\"transport\":\"tcp-tls-forward\",",
        "\"host\":\"203.0.113.20\",\"port\":443,\"server_name\":\"clean.internal\",",
        "\"auth\":\"cheng-hy2-tun-local-shared-token-2026\",",
        "\"dialer_proxy\":\"front\"}]}"
    ], ""))
    assert(!IsErr(dialerProxyRes), " vpn proxy config dialer proxy parse")
    assert(Value(dialerProxyRes).exits[1].dialerProxy == "front", " vpn proxy config dialer proxy field")

    var missingDialerProxyRes: Result[vpn.VpnProxyConfig]
    missingDialerProxyRes = vpn.VpnProxyParseConfigTextForTest(strutil.Join([
        "{\"exits\":[{\"name\":\"ai-clean\",\"transport\":\"tcp-tls-forward\",",
        "\"host\":\"203.0.113.20\",\"port\":443,\"server_name\":\"clean.internal\",",
        "\"auth\":\"cheng-hy2-tun-local-shared-token-2026\",",
        "\"dialer_proxy\":\"front\"}]}"
    ], ""))
    assert(IsErr(missingDialerProxyRes), " vpn proxy config missing dialer proxy reject")

    var selfDialerProxyRes: Result[vpn.VpnProxyConfig]
    selfDialerProxyRes = vpn.VpnProxyParseConfigTextForTest(strutil.Join([
        "{\"exits\":[{\"name\":\"front\",\"transport\":\"tcp-tls-forward\",",
        "\"host\":\"198.51.100.10\",\"port\":443,\"server_name\":\"front.internal\",",
        "\"auth\":\"cheng-hy2-tun-local-shared-token-2026\",",
        "\"dialer_proxy\":\"front\"}]}"
    ], ""))
    assert(IsErr(selfDialerProxyRes), " vpn proxy config self dialer proxy reject")

    var udpDialerProxyRes: Result[vpn.VpnProxyConfig]
    udpDialerProxyRes = vpn.VpnProxyParseConfigTextForTest(strutil.Join([
        "{\"exits\":[",
        "{\"name\":\"front\",\"transport\":\"tcp-tls-forward\",",
        "\"host\":\"198.51.100.10\",\"port\":443,\"server_name\":\"front.internal\",",
        "\"auth\":\"cheng-hy2-tun-local-shared-token-2026\"},",
        "{\"name\":\"udp\",\"transport\":\"udp-quic\",",
        "\"host\":\"203.0.113.20\",\"port\":7443,\"server_name\":\"udp.internal\",",
        "\"auth\":\"shared-secret\",\"cc_rx\":1,",
        "\"dialer_proxy\":\"front\"}]}"
    ], ""))
    assert(IsErr(udpDialerProxyRes), " vpn proxy config udp dialer proxy reject")

    var nestedDialerProxyRes: Result[vpn.VpnProxyConfig]
    nestedDialerProxyRes = vpn.VpnProxyParseConfigTextForTest(strutil.Join([
        "{\"exits\":[",
        "{\"name\":\"base\",\"transport\":\"tcp-tls-forward\",",
        "\"host\":\"198.51.100.10\",\"port\":443,\"server_name\":\"base.internal\",",
        "\"auth\":\"cheng-hy2-tun-local-shared-token-2026\"},",
        "{\"name\":\"front\",\"transport\":\"tcp-tls-forward\",",
        "\"host\":\"198.51.100.11\",\"port\":443,\"server_name\":\"front.internal\",",
        "\"auth\":\"cheng-hy2-tun-local-shared-token-2026\",",
        "\"dialer_proxy\":\"base\"},",
        "{\"name\":\"ai-clean\",\"transport\":\"tcp-tls-forward\",",
        "\"host\":\"203.0.113.20\",\"port\":443,\"server_name\":\"clean.internal\",",
        "\"auth\":\"cheng-hy2-tun-local-shared-token-2026\",",
        "\"dialer_proxy\":\"front\"}]}"
    ], ""))
    assert(IsErr(nestedDialerProxyRes), " vpn proxy config nested dialer proxy reject")

    var badTransportRes: Result[vpn.VpnProxyConfig]
    badTransportRes = vpn.VpnProxyParseConfigTextForTest(strutil.Join([
        "{\"exits\":[{\"name\":\"bad\",\"transport\":\"ssh\",",
        "\"host\":\"127.0.0.1\",\"port\":22,\"server_name\":\"localhost\"}]}"
    ], ""))
    assert(IsErr(badTransportRes), " vpn proxy config bad transport reject")

    var serverOnlyRes: Result[vpn.VpnProxyConfig]
    serverOnlyRes = vpn.VpnProxyParseConfigTextForTest("{\"server\":{\"listen\":\"0.0.0.0:7443\"}}")
    assert(!IsErr(serverOnlyRes), " vpn proxy config server-only parse")
    assert(Value(serverOnlyRes).client.listen == "", " vpn proxy config server-only empty client")
    assert(Value(serverOnlyRes).client.tun.mtu == 1500, " vpn proxy config server-only tun default")

    var badRes: Result[vpn.VpnProxyConfig]
    badRes = vpn.VpnProxyParseConfigTextForTest("{\"exits\":{\"name\":\"bad\"}}")
    assert(IsErr(badRes), " vpn proxy config exits reject")
    assert(ErrorText(badRes) == "vpn proxy config: exits must be array", " vpn proxy config exits reject text")

    echo(" vpn_proxy_config_smoke ok")
    return 0
