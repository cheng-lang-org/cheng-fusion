import cheng/core/ir/body_ir_noalias as noalias
import cheng/tests/noalias_finalize_stage_probe_lib as probe

fn main(): int32 =
    var bodyIR = probe.ProbeForwardBody(true)
    var stats: noalias.BodyIrNoAliasFinalizeStats
    noalias.BodyIrNoAliasFinalizeInPlace(bodyIR, stats)
    if !stats.applied:
        return 41
    if stats.localCount != 2:
        return 42
    if stats.forwardRewriteCount != 2:
        return 43
    return bodyIR.terms[0].resultSlot
