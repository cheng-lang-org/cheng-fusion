fn smokeFingerprintMix(seed: int64, value: int32): int64 =
    return (seed * int64(65599) + int64(value) +
            int64(2147483647) + int64(1)) % int64(2147483647)

fn main(argc: int32, argv: str*): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    echo("start")
    let r = smokeFingerprintMix(int64(7), 42)
    if r > int64(0):
        echo("mix ok")
    else:
        echo("mix nonpositive")
    return 0
