# Standalone fetch client for the kernel-TCP poster side channel.
#
# Connects to a running media_moq_publisher's TCP poster server (same host:port
# as its QUIC listener), pulls the poster via the production bridge fetch path,
# writes it to --out, and prints the byte count. Used by the host-loopback
# verification: the OS kernel TCP stack moves the ~460KB poster reliably with
# zero loss-recovery code on our side (the pure-Cheng QUIC cannot yet).
import std/result
import std/rawbytes
import std/os
import std/strutils as strutil
import std/cmdline as cmdline
import cheng/core/runtime/web_scene_media_network_bridge as media_bridge

fn main(): int32 =
    var hostRaw: str
    let hasHost: bool = cmdline.ReadFirstFlagValue("--host", hostRaw)
    let host: str = if hasHost: hostRaw else: "127.0.0.1"
    let port: int32 = cmdline.ReadInt32FlagOrDefault("--port", 0)
    var outRaw: str
    let hasOut: bool = cmdline.ReadFirstFlagValue("--out", outRaw)
    let outPath: str = if hasOut: outRaw else: "/tmp/poster_fetched.bin"
    let n: int32 = media_bridge.WebSceneMediaFetchRemotePosterViaTcpToFile(host, port, outPath)
    os.WriteLine(os.Get_stdout(), strutil.Join(["poster_tcp_fetch result=", IntToStr(n), " out=", outPath], ""))
    if n <= 0:
        return 1
    return 0
