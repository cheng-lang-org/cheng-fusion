# Rider-load probe (M-a wiring): the contacts3d capsule-vs-ball contact
# must report the ball's per-tick equivalent normal load so the load-aware
# rolling resistance (Crr = 0.03) reacts to a RIDER standing on the ball,
# not only to Physics3dAddForce (the pre-M-a gap: PBD contacts wrote
# velocities only, bodyFz[ball] stayed 0, excess stayed 0, the resistance
# never fired in the machine-duck-on-ball scene).
#
# caseA (rider press, the wiring proof): a vertical capsule (5 kg,
# r = 0.02, half = 0.05) released with its bottom surface 5 mm above a
# pure-rolling ball (1.0 kg, r = 0.1, vx = wy*r = 0.5), pressing the ball
# apex under its own weight - the same position-level PBD repair channel
# (lam) that carries the machine duck's support. The capsule mass is
# picked heavy so the Coulomb cone's inverse-mass shares keep the drift
# on the ball side: the ball stops within ~25 ticks and the capsule stays
# centered on the apex for the whole window. Contract: zero rejected
# steps, the reported load Contacts3dBallLoadRead(ball) > 0 on every
# post-impact sample and on most ticks (direct wiring evidence), the
# rider ball's speed/decay curve visibly below the identical no-rider
# control, and less drift.
#
# caseB (unloaded no-regression): a slipping ball (vx = 1, omega = 0)
# converges to the 5/7 v0 pure-roll plateau and HOLDS it with the load
# channel reading exact zero throughout - the empty-table read is 0.0,
# so the loaded expression load = m*g - bodyFz + read is bit-identical
# to the pre-M-a engine and the 5/7 trajectory cannot move.
#
# caseC (machine-duck standing load, the Q2 scene): the 15-link machine
# duck assembled standing on the real-spec ball (r = 0.121 m, m = 0.62 kg)
# under the hipTrim balance protocol (the BR-line standing configuration),
# 500 ticks, sampled every 50: Contacts3dBallLoadRead(ballSlot), ball
# drift, ball omega, ball creep speed. Contracts: zero rejected steps,
# duck upright the whole window, the load channel positive on >= 75% of
# alive ticks with the settled mean inside the duck-weight-share band
# (force balance: the channel reports the position-level PBD repair share
# of the support the ball gives the duck - the held-capsule velocity
# branch is owned by the constraint stage by design; caseA pins the
# free-body path exact), and the ball creep speed shows a decay segment
# before the trim integrator's balance chase dominates (the load-aware
# rolling-resistance gate load = m_ball*g - bodyFz + read is genuinely
# open in this scene - the BR-line pre-wiring symptom was a constant
# creep speed, zero decay).
#
# Physics-loop discipline: the tick loops do scalar math only (no str
# construction, no echo, no allocation); samples are buffered into
# arrays and echoed after the loop.
import std/math as m
import std/strings as strings
import cheng/game/world3d
import cheng/game/physics3d
import cheng/game/contacts3d
import cheng/game/constraints3d
import cheng/game/csg/joint_motor
import cheng/game/csg/numerics
import cheng/game/csg/microduck_model as mm
import cheng/game/csg/ball_servo_rigid as bsr

const
    # caseA rider-press window: 480 ticks = 2 s at 240 Hz
    TotalTicks: int32 = 480
    SampleEvery: int32 = 60
    # caseB unloaded window: 240 ticks = 1 s
    CaseBTicks: int32 = 240
    BallR: float64 = 0.1
    BallM: float64 = 1.0
    V0: float64 = 0.5
    CapR: float64 = 0.02
    CapHalf: float64 = 0.05
    # heavy press rider: the cone correction shares go dominantly to the
    # ball (invMass ratio 0.2 vs 1.0), so the ball stops early and the
    # capsule cannot walk off the apex; the per-tick gravity sag keeps a
    # sustained lam repair (the load channel's position-level input)
    CapM: float64 = 5.0
    # release: capsule center z so the bottom surface sits 5 mm above the
    # ball top (2r): 0.2 + CapR + 0.005 + CapHalf
    CapZ0: float64 = 0.275
    # --- caseC: machine duck standing on the real-spec basketball ---
    # real FIBA size-7: r = 0.121 m, m = 0.62 kg on the ground plane
    DuckBallX: float64 = 0.0
    DuckBallY: float64 = 0.85
    DuckBallZ: float64 = 0.121
    DuckBallR: float64 = 0.121
    DuckBallM: float64 = 0.62
    # ball top = 2r: the duck root pose stands the sole plane on it
    DuckRootZ: float64 = 0.275364117885
    DuckAngleTolRad: float64 = 0.001
    DuckAnchorGapTolM: float64 = 0.001
    # caseC window: 500 ticks ≈ 2.08 s, sampled every 50
    CaseCTicks: int32 = 500
    CaseCSampleEvery: int32 = 50
    # caseG CEM-best hipTrim operating point (the BR-line standing
    # protocol): dTheta0/trimRate/trimRange, no feedforward
    CaseCDTheta0: float64 = 0.009
    CaseCTrimRate: float64 = 0.0011682242990654206
    CaseCTrimRangeRad: float64 = 0.10

fn fmtMm(x: float64): str =
    let scaled: int32 = int32(m.roundFloat(x * 1000.0))
    var neg: bool = scaled < 0
    var mag: int32 = scaled
    if neg:
        mag = 0 - mag
    let intPart: int32 = mag / 1000
    let fracPart: int32 = mag % 1000
    var outStr: str = ""
    if neg:
        outStr = "-"
    outStr = outStr + strings.IntToStr(intPart) + "." + strings.CloneStrRange(strings.IntToStr(fracPart + 1000), 1, 3)
    return outStr

# caseA: capsule pressing a rolling ball vs the identical unloaded
# control. The ball's decay under the rider must be visible (final vx
# far below the control, less drift) and the load channel must report
# positive load on every settled sample - the direct wiring evidence.
fn caseRiderPress(): bool =
    # control: the same rolling ball, no rider
    var wu: world3d.World3d
    World3dReset(wu, int64(31))
    let _u = World3dSpawnBody(wu, 0.0, 0.0, BallR, BallM, BallR, world3d.World3dBodyBallRigid)
    wu.bodyVx[0] = V0
    wu.bodyAngVy[0] = V0 / BallR
    # rider world: the rolling ball + the free vertical press capsule
    # (bottom surface 5 mm above the ball top at release)
    var wl: world3d.World3d
    World3dReset(wl, int64(32))
    let _b = World3dSpawnBody(wl, 0.0, 0.0, BallR, BallM, BallR, world3d.World3dBodyBallRigid)
    wl.bodyVx[0] = V0
    wl.bodyAngVy[0] = V0 / BallR
    let capSlot = World3dSpawnCapsule(wl, 0.0, 0.0, CapZ0, CapM, CapR, CapHalf, 1.0, 0.0, 0.0, 0.0)
    echo("press setup capSlot=" + strings.IntToStr(capSlot) + " capZ_mm=" + fmtMm(wl.bodyPz[capSlot] * 1000.0) + " ballTop_mm=" + fmtMm(2.0 * BallR * 1000.0))
    # buffered trace, emitted after the loop (no str work inside physics)
    var sTick: int32[]
    var sVxU: float64[]
    var sVxL: float64[]
    var sXU: float64[]
    var sXL: float64[]
    var sLoad: float64[]
    var sPole: float64[]
    setLen(sTick, 0)
    setLen(sVxU, 0)
    setLen(sVxL, 0)
    setLen(sXU, 0)
    setLen(sXL, 0)
    setLen(sLoad, 0)
    setLen(sPole, 0)
    var firedTicks: int32 = 0
    var i: int32 = 0
    while i < TotalTicks:
        var ru = physics3d.Physics3dStep(wu, "riderload:control")
        var rl = physics3d.Physics3dStep(wl, "riderload:press")
        if ru.statusCode != physics3d.Physics3dStatusOk:
            echo("FAIL press control step rejected")
            return false
        if rl.statusCode != physics3d.Physics3dStatusOk:
            echo("FAIL press rider step rejected")
            return false
        let loadNow = contacts3d.Contacts3dBallLoadRead(0)
        if loadNow > 0.0:
            firedTicks = firedTicks + 1
        if (i % SampleEvery == 0) || (i == TotalTicks - 1):
            add(sTick, i)
            add(sVxU, wu.bodyVx[0])
            add(sVxL, wl.bodyVx[0])
            add(sXU, wu.bodyPx[0])
            add(sXL, wl.bodyPx[0])
            add(sLoad, loadNow)
            add(sPole, wl.bodyPz[capSlot] - CapHalf)
        i = i + 1
    var k: int32 = 0
    var loadSeen: bool = true
    while k < sTick.len:
        echo("press t=" + strings.IntToStr(sTick[k]) + " vxU_mm=" + fmtMm(sVxU[k] * 1000.0) + " vxL_mm=" + fmtMm(sVxL[k] * 1000.0) + " xU_mm=" + fmtMm(sXU[k] * 1000.0) + " xL_mm=" + fmtMm(sXL[k] * 1000.0) + " load_N=" + fmtMm(sLoad[k]) + " pole_mm=" + fmtMm(sPole[k] * 1000.0))
        # the first samples cover the 5 mm free fall (~8 ticks); from the
        # first settled sample on, the press contact must report load
        if sTick[k] >= SampleEvery:
            if sLoad[k] <= 0.0:
                loadSeen = false
        k = k + 1
    let vxU = wu.bodyVx[0]
    let vxL = wl.bodyVx[0]
    let zErrU = m.absFloat(wu.bodyPz[0] - BallR)
    let zErrL = m.absFloat(wl.bodyPz[0] - BallR)
    echo("case riderpress firedTicks=" + strings.IntToStr(firedTicks) + " vxU=" + fmtMm(vxU * 1000.0) + " vxL=" + fmtMm(vxL * 1000.0) + " xU_mm=" + fmtMm(wu.bodyPx[0] * 1000.0) + " xL_mm=" + fmtMm(wl.bodyPx[0] * 1000.0) + " zerrU_mm=" + fmtMm(zErrU * 1000.0) + " zerrL_mm=" + fmtMm(zErrL * 1000.0))
    if !loadSeen:
        echo("FAIL press load channel not positive on settled samples")
        return false
    # wiring evidence: the contact fired on most ticks of the window
    if firedTicks < TotalTicks / 2:
        echo("FAIL press contact fired on too few ticks (" + strings.IntToStr(firedTicks) + ")")
        return false
    # decay curve visible early (by t = SampleEvery the rider ball is
    # already well below release speed)
    if sVxL[1] > 0.9 * V0:
        echo("FAIL press decay curve not visible at t=" + strings.IntToStr(sTick[1]))
        return false
    # unloaded control holds the roll
    if vxU < 0.45:
        echo("FAIL press control lost the roll (vxU=" + fmtMm(vxU * 1000.0) + ")")
        return false
    # loaded ball decays markedly and travels less
    if vxL > 0.7 * vxU:
        echo("FAIL press decay too weak (vxL=" + fmtMm(vxL * 1000.0) + " vxU=" + fmtMm(vxU * 1000.0) + ")")
        return false
    if sXL[sTick.len - 1] >= sXU[sTick.len - 1]:
        echo("FAIL press drift not reduced")
        return false
    if zErrU > 0.005:
        echo("FAIL press control z drift")
        return false
    if zErrL > 0.005:
        echo("FAIL press rider z drift")
        return false
    return true

# caseB: no rider anywhere - the slipping ball converges to the 5/7 v0
# pure-roll plateau and holds it, and the load channel reads exact zero
# on every sample (empty table -> the rolling-contact load expression is
# bit-identical to the pre-M-a engine).
fn caseUnloadedChannel(): bool =
    var w: world3d.World3d
    World3dReset(w, int64(33))
    let _b = World3dSpawnBody(w, 0.0, 0.0, BallR, BallM, BallR, world3d.World3dBodyBallRigid)
    w.bodyVx[0] = 1.0
    var sTick: int32[]
    var sVx: float64[]
    var sLoad: float64[]
    setLen(sTick, 0)
    setLen(sVx, 0)
    setLen(sLoad, 0)
    var i: int32 = 0
    while i < CaseBTicks:
        var r = physics3d.Physics3dStep(w, "riderload:unloaded")
        if r.statusCode != physics3d.Physics3dStatusOk:
            echo("FAIL unloaded step rejected")
            return false
        if (i % SampleEvery == 0) || (i == CaseBTicks - 1):
            add(sTick, i)
            add(sVx, w.bodyVx[0])
            add(sLoad, contacts3d.Contacts3dBallLoadRead(0))
        i = i + 1
    var k: int32 = 0
    var loadZero: bool = true
    while k < sTick.len:
        echo("unloaded t=" + strings.IntToStr(sTick[k]) + " vx_mm=" + fmtMm(sVx[k] * 1000.0) + " load_N=" + fmtMm(sLoad[k]))
        if sLoad[k] != 0.0:
            loadZero = false
        k = k + 1
    let slip = m.absFloat(w.bodyVx[0] - w.bodyAngVy[0] * BallR)
    let five7 = 5.0 / 7.0
    echo("case unloaded vx=" + fmtMm(w.bodyVx[0] * 1000.0) + " five7_mm=" + fmtMm(five7 * 1000.0) + " slip_mm=" + fmtMm(slip * 1000.0))
    if !loadZero:
        echo("FAIL unloaded load channel not zero")
        return false
    if slip > 0.02:
        echo("FAIL unloaded slip did not close")
        return false
    if w.bodyVx[0] > five7 + 0.02:
        echo("FAIL unloaded vx above the 5/7 plateau")
        return false
    if w.bodyVx[0] < five7 - 0.02:
        echo("FAIL unloaded vx below the 5/7 plateau")
        return false
    return true

# --- caseC assembly (same construction as the microduck ball probe) ---

# Park the servo command and goal at the measured standing flexion so tick
# 0 commands no step change; returns the measured angle.
fn casecParkHingeServo(w: var World3d, ci: int32): float64 =
    let th0 = constraints3d.Constraints3dHingeAngle(w, ci)
    w.conCmd[ci] = th0
    w.conGoal[ci] = th0
    return th0

# One MJCF joint -> one hinge servo from the model table.
@borrows
fn casecStanceHinge(w: var World3d, mdl: mm.MicroduckModel, jointIdx: int32, refX: float64, refY: float64, refZ: float64, tauMax: float64, omegaRadS: float64): int32 =
    let jt = mdl.joints[jointIdx]
    let pl = mdl.links[jt.parentLink]
    let cl = mdl.links[jt.childLink]
    var anchAx: float64
    var anchAy: float64
    var anchAz: float64
    mm.MicroduckPointToLocal(pl.axisKind, jt.anchorX, jt.anchorY, jt.anchorZ, pl.cx, pl.cy, pl.cz, anchAx, anchAy, anchAz)
    var axisAx: float64
    var axisAy: float64
    var axisAz: float64
    mm.MicroduckVecToLocal(pl.axisKind, jt.axisX, jt.axisY, jt.axisZ, axisAx, axisAy, axisAz)
    var anchBx: float64
    var anchBy: float64
    var anchBz: float64
    mm.MicroduckPointToLocal(cl.axisKind, jt.anchorX, jt.anchorY, jt.anchorZ, cl.cx, cl.cy, cl.cz, anchBx, anchBy, anchBz)
    var axisBx: float64
    var axisBy: float64
    var axisBz: float64
    mm.MicroduckVecToLocal(cl.axisKind, jt.axisX, jt.axisY, jt.axisZ, axisBx, axisBy, axisBz)
    let ci = world3d.World3dAddHingeJoint(w, jt.parentLink, jt.childLink, world3d.World3dConHingeServo, anchAx, anchAy, anchAz, anchBx, anchBy, anchBz, axisAx, axisAy, axisAz, axisBx, axisBy, axisBz)
    var refAlX: float64
    var refAlY: float64
    var refAlZ: float64
    mm.MicroduckVecToLocal(pl.axisKind, refX, refY, refZ, refAlX, refAlY, refAlZ)
    var refBlX: float64
    var refBlY: float64
    var refBlZ: float64
    mm.MicroduckVecToLocal(cl.axisKind, refX, refY, refZ, refBlX, refBlY, refBlZ)
    world3d.World3dSetHingeRefs(w, ci, refAlX, refAlY, refAlZ, refBlX, refBlY, refBlZ)
    world3d.World3dSetHingeServo(w, ci, tauMax, omegaRadS, jt.minRad, jt.maxRad)
    if constraints3d.Constraints3dJointAnchorGap(w, ci) > DuckAnchorGapTolM:
        panic("rider load probe: hinge pivot gap at " + jt.name)
    return ci

# The 15-link machine duck at the stance pose, all hinge servos parked
# (caseG protocol: no torso servo, the duck's own servos hold the pose).
# Returns the two hip-pitch servo constraint indices through the var outs
# (the hipTrim channel's goal-write targets).
fn casecBuildDuck(w: var World3d, hipPitchL: var int32, hipPitchR: var int32): int32 =
    world3d.World3dReset(w, int64(911))
    var mdl: mm.MicroduckModel = mm.MicroduckModelBuild()
    if mdl.links.len != 15:
        panic("rider load probe: link count")
    if mdl.joints.len != 14:
        panic("rider load probe: joint count")
    var i: int32 = 0
    while i < mdl.links.len:
        let sp = mm.MicroduckLinkSpawnCapsuleStance(mdl, i, DuckBallX, DuckBallY, DuckRootZ, 0.0)
        let slot = world3d.World3dSpawnCapsule(w, sp.px, sp.py, sp.pz, sp.mass, sp.radius, sp.halfLen, sp.qw, sp.qx, sp.qy, sp.qz)
        if slot != i:
            panic("rider load probe: link slot mismatch")
        i = i + 1
    let omegaRadS = mm.MicroduckServoMaxRateDegS * joint_motor.JointMotorRadPerDeg
    let ciHipYawL = casecStanceHinge(w, mdl, mm.MicroduckJointHipYawL, 0.0, 1.0, 0.0, mm.MicroduckTauMaxHipNm, omegaRadS)
    let ciHipRollL = casecStanceHinge(w, mdl, mm.MicroduckJointHipRollL, 0.0, 0.0, 0.0 - 1.0, mm.MicroduckTauMaxHipNm, omegaRadS)
    let ciHipPitchL = casecStanceHinge(w, mdl, mm.MicroduckJointHipPitchL, 0.0, 0.0, 0.0 - 1.0, mm.MicroduckTauMaxHipNm, omegaRadS)
    let ciKneeL = casecStanceHinge(w, mdl, mm.MicroduckJointKneeL, 0.0, 0.0, 0.0 - 1.0, mm.MicroduckTauMaxKneeNm, omegaRadS)
    let ciAnkleL = casecStanceHinge(w, mdl, mm.MicroduckJointAnklePitchL, 0.0, 0.0, 0.0 - 1.0, mm.MicroduckTauMaxAnkleNm, omegaRadS)
    let ciHipYawR = casecStanceHinge(w, mdl, mm.MicroduckJointHipYawR, 0.0, 1.0, 0.0, mm.MicroduckTauMaxHipNm, omegaRadS)
    let ciHipRollR = casecStanceHinge(w, mdl, mm.MicroduckJointHipRollR, 0.0, 0.0, 0.0 - 1.0, mm.MicroduckTauMaxHipNm, omegaRadS)
    let ciHipPitchR = casecStanceHinge(w, mdl, mm.MicroduckJointHipPitchR, 0.0, 0.0, 0.0 - 1.0, mm.MicroduckTauMaxHipNm, omegaRadS)
    let ciKneeR = casecStanceHinge(w, mdl, mm.MicroduckJointKneeR, 0.0, 0.0, 0.0 - 1.0, mm.MicroduckTauMaxKneeNm, omegaRadS)
    let ciAnkleR = casecStanceHinge(w, mdl, mm.MicroduckJointAnklePitchR, 0.0, 0.0, 0.0 - 1.0, mm.MicroduckTauMaxAnkleNm, omegaRadS)
    let ciNeck = casecStanceHinge(w, mdl, mm.MicroduckJointNeckPitch, 0.0, 0.0, 1.0, mm.MicroduckTauMaxNeckNm, omegaRadS)
    let ciHeadPitch = casecStanceHinge(w, mdl, mm.MicroduckJointHeadPitch, 0.0, 0.0, 1.0, mm.MicroduckTauMaxNeckNm, omegaRadS)
    let ciHeadYaw = casecStanceHinge(w, mdl, mm.MicroduckJointHeadYaw, 0.0, 1.0, 0.0, mm.MicroduckTauMaxNeckNm, omegaRadS)
    let ciHeadRoll = casecStanceHinge(w, mdl, mm.MicroduckJointHeadRoll, 0.0, 0.0, 1.0, mm.MicroduckTauMaxNeckNm, omegaRadS)
    casecParkHingeServo(w, ciHipPitchL)
    casecParkHingeServo(w, ciHipPitchR)
    casecParkHingeServo(w, ciKneeL)
    casecParkHingeServo(w, ciKneeR)
    casecParkHingeServo(w, ciAnkleL)
    casecParkHingeServo(w, ciAnkleR)
    casecParkHingeServo(w, ciNeck)
    casecParkHingeServo(w, ciHeadPitch)
    casecParkHingeServo(w, ciHeadYaw)
    casecParkHingeServo(w, ciHeadRoll)
    casecParkHingeServo(w, ciHipYawL)
    casecParkHingeServo(w, ciHipYawR)
    casecParkHingeServo(w, ciHipRollL)
    casecParkHingeServo(w, ciHipRollR)
    hipPitchL = ciHipPitchL
    hipPitchR = ciHipPitchR
    echo("casec assembly links=" + strings.IntToStr(mdl.links.len) + " joints=" + strings.IntToStr(mdl.joints.len) + " bodies=" + strings.IntToStr(w.count) + " constraints=" + strings.IntToStr(w.conCount))
    return w.count

# caseC: the standing machine duck carries its own weight through the
# feet-ball PBD contacts; the load channel must report it (force balance)
# and the rolling-resistance gate must be genuinely open (creep decay).
fn caseDuckBallLoad(): bool =
    var w: world3d.World3d
    var hipL: int32 = 0
    var hipR: int32 = 0
    let _duckBodies = casecBuildDuck(w, hipL, hipR)
    if w.count != 15:
        echo("FAIL casec assembly body count")
        return false
    if w.conCount != 14:
        echo("FAIL casec assembly constraint count")
        return false
    let ballSlot = world3d.World3dSpawnBody(w, DuckBallX, DuckBallY, DuckBallZ, DuckBallM, DuckBallR, world3d.World3dBodyBallRigid)
    let torsoSlot: int32 = mm.MicroduckLinkTorso
    let headSlot: int32 = mm.MicroduckLinkHead
    let ballX0: float64 = w.bodyPx[ballSlot]
    let ballY0: float64 = w.bodyPy[ballSlot]
    var mdl: mm.MicroduckModel = mm.MicroduckModelBuild()
    var ht: bsr.BallServoHipTrimState
    bsr.BallServoHipTrimInit(ht, w, ballSlot, 0, ballSlot - 1,
        hipL, hipR,
        mdl.joints[mm.MicroduckJointHipPitchL].minRad, mdl.joints[mm.MicroduckJointHipPitchL].maxRad,
        CaseCDTheta0, CaseCTrimRate, CaseCTrimRangeRad)
    echo("casec ballSlot=" + strings.IntToStr(ballSlot) + " duckMass_x1000=" + strings.Int64ToStr(numerics.CsgQuantMm(0.7443611)) + " duckWeight_mN=" + fmtMm(0.7443611 * 9.81 * 1000.0))
    # buffered trace, emitted after the loop (no str work inside physics)
    var sTick: int32[]
    var sAlive: int32[]
    var sLoad: float64[]
    var sDrift: float64[]
    var sCreep: float64[]
    var sW: float64[]
    var sVx: float64[]
    var sVy: float64[]
    setLen(sTick, 0)
    setLen(sAlive, 0)
    setLen(sLoad, 0)
    setLen(sDrift, 0)
    setLen(sCreep, 0)
    setLen(sW, 0)
    setLen(sVx, 0)
    setLen(sVy, 0)
    var rejected: int32 = 0
    var firstRejectTick: int32 = 0 - 1
    var fallTick: int32 = 0 - 1
    var loadPosTicks: int32 = 0
    var loadSeenTicks: int32 = 0
    var i: int32 = 0
    while i < CaseCTicks:
        bsr.BallServoHipTrimTick(ht, w)
        var r = physics3d.Physics3dStep(w, "riderload:duckball")
        if r.statusCode != physics3d.Physics3dStatusOk:
            if firstRejectTick < 0:
                firstRejectTick = i
            rejected = rejected + 1
        let dx = w.bodyPx[ballSlot] - ballX0
        let dy = w.bodyPy[ballSlot] - ballY0
        let drift = numerics.CsgSqrt(dx * dx + dy * dy)
        let bvx = w.bodyVx[ballSlot]
        let bvy = w.bodyVy[ballSlot]
        let creep = numerics.CsgSqrt(bvx * bvx + bvy * bvy)
        let bw = numerics.CsgSqrt(w.bodyAngVx[ballSlot] * w.bodyAngVx[ballSlot] + w.bodyAngVy[ballSlot] * w.bodyAngVy[ballSlot] + w.bodyAngVz[ballSlot] * w.bodyAngVz[ballSlot])
        var alive: int32 = 1
        if w.bodyPz[headSlot] < w.bodyPz[torsoSlot]:
            alive = 0
            if fallTick < 0:
                fallTick = i
        let loadNow = contacts3d.Contacts3dBallLoadRead(ballSlot)
        if alive == 1:
            loadSeenTicks = loadSeenTicks + 1
            if loadNow > 0.0:
                loadPosTicks = loadPosTicks + 1
        if (i % CaseCSampleEvery == 0) || (i == CaseCTicks - 1):
            add(sTick, i)
            add(sAlive, alive)
            add(sLoad, loadNow)
            add(sDrift, drift)
            add(sCreep, creep)
            add(sW, bw)
            add(sVx, bvx)
            add(sVy, bvy)
        i = i + 1
    var k: int32 = 0
    while k < sTick.len:
        echo("duckball t=" + strings.IntToStr(sTick[k]) + " alive=" + strings.IntToStr(sAlive[k]) + " load_N=" + fmtMm(sLoad[k]) + " drift_mm=" + fmtMm(sDrift[k] * 1000.0) + " creep_mm_s=" + fmtMm(sCreep[k] * 1000.0) + " w_mrad_s=" + fmtMm(sW[k] * 1000.0) + " vx_mm_s=" + fmtMm(sVx[k] * 1000.0) + " vy_mm_s=" + fmtMm(sVy[k] * 1000.0))
        k = k + 1
    # settled force-balance band: from t = 150 on the stance is past the
    # landing transient. The channel reports the position-level PBD
    # repair share of the support (the held-capsule velocity-impulse
    # branch is owned by the constraint stage by design, see
    # contacts3dResolveCapsuleBall); caseA proves the free-body path
    # exact (49 N for 5 kg), so here the band anchors the lam share at
    # roughly 40% of the 7.302 N duck weight, and every settled sample
    # must be clearly positive (the gate is genuinely open, not glancing)
    var loadSum: float64 = 0.0
    var loadCnt: int32 = 0
    var loadMin: float64 = 0.0
    k = 0
    while k < sTick.len:
        if sTick[k] >= 150:
            if sLoad[k] <= 0.5:
                echo("FAIL casec settled sample t=" + strings.IntToStr(sTick[k]) + " load_N=" + fmtMm(sLoad[k]) + " not clearly positive")
                return false
            if sTick[k] >= 250:
                loadSum = loadSum + sLoad[k]
                loadCnt = loadCnt + 1
        k = k + 1
    let loadMean = loadSum / float64(loadCnt)
    echo("case duckball loadMean_N=" + fmtMm(loadMean) + " duckWeight_N=" + fmtMm(0.7443611 * 9.81) + " share_x1000=" + strings.IntToStr(int32(m.roundFloat(loadMean / (0.7443611 * 9.81) * 1000.0))))
    if loadMean < 1.5 || loadMean > 5.5:
        echo("FAIL casec settled load mean " + fmtMm(loadMean) + " N outside the duck-weight-share band [1.5, 5.5]")
        return false
    # creep decay segment before the trim integrator's balance chase
    # dominates: the impact-induced creep decays monotonically t=50 ->
    # t=100 -> t=150 while the only residual damping beyond the settled
    # slip channel is the load-aware rolling resistance (excess>0 opens
    # exactly here). The pre-M-a symptom was a CONSTANT creep speed.
    if !(sCreep[3] < sCreep[2] and sCreep[2] < sCreep[1]):
        echo("FAIL casec no creep decay segment t50=" + fmtMm(sCreep[1] * 1000.0) + " t100=" + fmtMm(sCreep[2] * 1000.0) + " t150=" + fmtMm(sCreep[3] * 1000.0))
        return false
    if sCreep[3] > 0.75 * sCreep[1]:
        echo("FAIL casec creep decay too weak t50=" + fmtMm(sCreep[1] * 1000.0) + " t150=" + fmtMm(sCreep[3] * 1000.0))
        return false
    if !world3d.World3dValid(w):
        echo("FAIL casec world validity")
        return false
    if rejected != 0:
        echo("FAIL casec rejected steps at " + strings.IntToStr(firstRejectTick))
        return false
    if fallTick >= 0:
        echo("FAIL casec duck fell at tick " + strings.IntToStr(fallTick))
        return false
    if loadPosTicks * 4 < loadSeenTicks * 3:
        echo("FAIL casec load channel positive on too few alive ticks (" + strings.IntToStr(loadPosTicks) + "/" + strings.IntToStr(loadSeenTicks) + ")")
        return false
    return true

fn main(): int32 =
    if !caseRiderPress():
        echo("FAIL caseRiderPress")
        return 1
    if !caseUnloadedChannel():
        echo("FAIL caseUnloadedChannel")
        return 1
    if !caseDuckBallLoad():
        echo("FAIL caseDuckBallLoad")
        return 1
    echo("PASS rider load probe")
    return 0
