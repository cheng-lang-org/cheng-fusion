import cheng/core/backend/primary_object_plan as pobj

@borrows
fn ColdConditionalStaticStringLoopOwner(
        inputs: str[], takeOwned: bool): int32 =
    var selected = ""
    for outer in 0..<2:
        if takeOwned && outer == 0 && outer < inputs.len:
            selected = inputs[outer]
        if outer == 0:
            for scan in 0..<inputs.len:
                if scan == outer:
                    continue
            continue
        if takeOwned && outer < inputs.len:
            selected = inputs[outer]
        for scan in 0..<inputs.len:
            if scan == outer:
                continue
    if takeOwned:
        if selected == "owner":
            return 17
        return -1
    if selected == "":
        return 23
    return -2

fn main(): int32 =
    let inputs = ["owner", "owner"]
    if ColdConditionalStaticStringLoopOwner(inputs, true) != 17:
        return 1
    if ColdConditionalStaticStringLoopOwner(inputs, false) != 23:
        return 2
    return 0
