# web_geolocation_runtime_smoke.cheng
# Runtime proof for the geolocation decision core (pure Cheng, no FFI):
# permission gate branches, coordinate domain validation, cache freshness,
# getCurrentPosition resolution matrix (cache hit / provider unavailable /
# fresh fix / late fix / pending->timeout), and watch lifecycle with
# tombstone cancellation.
# Backs the base id cheng/core/runtime/web_geolocation_runtime.
import cheng/core/runtime/web_geolocation_runtime as geo

fn main(): int32 =
    # --- permission gate ---
    if geo.WebGeolocationPermissionGate("granted") != geo.GeoOk:
        return 1
    if geo.WebGeolocationPermissionGate("denied") != geo.GeoPermissionDenied:
        return 2
    if geo.WebGeolocationPermissionGate("prompt") != geo.GeoRequestRequired:
        return 3

    # --- coordinate domain validation ---
    if !geo.WebGeolocationCoordValid(31.2304, 121.4737, 25.0):
        return 4
    if geo.WebGeolocationCoordValid(91.0, 121.4737, 25.0):
        return 5      # latitude out of WGS84 range
    if geo.WebGeolocationCoordValid(31.2304, -180.5, 25.0):
        return 6      # longitude out of range
    if geo.WebGeolocationCoordValid(31.2304, 121.4737, 0.0):
        return 7      # zero accuracy carries no information

    # --- cache freshness rule ---
    if !geo.WebGeolocationCacheUsable(4000, 5000):
        return 8
    if geo.WebGeolocationCacheUsable(6000, 5000):
        return 9      # older than maximumAge
    if geo.WebGeolocationCacheUsable(-1, 5000):
        return 10     # clock skew never usable

    # --- resolve: permission denial outranks everything ---
    var rc = geo.WebGeolocationResolveCurrentPosition("denied", true, 0, 5000, false, true, 0, 1000)
    if rc != geo.GeoPermissionDenied:
        return 11

    # --- resolve: fresh cache answers immediately, no fix needed ---
    rc = geo.WebGeolocationResolveCurrentPosition("granted", true, 3000, 5000, false, false, 0, 1000)
    if rc != geo.GeoOk:
        return 12

    # --- resolve: stale cache falls through to the fresh-fix race ---
    rc = geo.WebGeolocationResolveCurrentPosition("granted", true, 9000, 5000, false, true, 300, 1000)
    if rc != geo.GeoOk:
        return 13

    # --- resolve: provider failure outranks timeout ---
    rc = geo.WebGeolocationResolveCurrentPosition("granted", false, 0, 5000, true, false, 9999, 1000)
    if rc != geo.GeoPositionUnavailable:
        return 14

    # --- resolve: still waiting inside the deadline is pending ---
    rc = geo.WebGeolocationResolveCurrentPosition("granted", false, 0, 5000, false, false, 400, 1000)
    if rc != geo.GeoPending:
        return 15

    # --- resolve: deadline exceeded without a fix is timeout ---
    rc = geo.WebGeolocationResolveCurrentPosition("granted", false, 0, 5000, false, false, 1200, 1000)
    if rc != geo.GeoTimeout:
        return 16

    # --- resolve: late fix after the deadline already fired loses ---
    rc = geo.WebGeolocationResolveCurrentPosition("granted", false, 0, 5000, false, true, 1200, 1000)
    if rc != geo.GeoTimeout:
        return 17

    # --- watch lifecycle ---
    let wA = geo.WebGeolocationWatchStart(true, 5000, 800)
    let wB = geo.WebGeolocationWatchStart(false, 60000, 2000)
    if wA <= 0 || wB <= 0 || wA == wB:
        return 18
    if geo.WebGeolocationWatchActiveCount() != 2:
        return 19

    var hi: bool = false
    if !geo.WebGeolocationWatchHighAccuracy(wA, hi):
        return 20
    if !hi:
        return 21
    if !geo.WebGeolocationWatchHighAccuracy(wB, hi):
        return 22
    if hi:
        return 23

    # delivered fixes obey each watcher's freshness bound
    if !geo.WebGeolocationWatchAccepts(wB, 59000):
        return 24
    if geo.WebGeolocationWatchAccepts(wB, 61000):
        return 25

    # cancel: active -> true, repeat/unknown -> false (tombstone invisible)
    if !geo.WebGeolocationWatchCancel(wA):
        return 26
    if geo.WebGeolocationWatchCancel(wA):
        return 27
    if geo.WebGeolocationWatchCancel(9999):
        return 28
    if geo.WebGeolocationWatchActiveCount() != 1:
        return 29
    if geo.WebGeolocationWatchAccepts(wA, 0):
        return 30    # cancelled watcher receives nothing

    echo("geolocation runtime ok")
    return 0
