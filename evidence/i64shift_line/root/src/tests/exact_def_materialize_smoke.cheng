# exact_def_materialize_smoke — ExactDef 批 6 单元验证: 物化 restage
# (上游化一次成型) + 构造器物化 + return 沉口 + W6 str[] 借用元素
# 判词。spec: docs/cheng-exact-def-batch6-materialize-spec.md (§5 挂点
# 清单/§7 基板差异), docs/cheng-exact-def-rewrite-design.md §4 批 6。
#
# 合成 BodyIR 全部经真实构建路径构造 (coreir 构建/绑定/冻结 API + 批 1
# derive (内含批 4 merge 臂与批 6 return admission 臂) + 批 2 freeze +
# 批 5 组合序), 零 Mock; 若干负例腿经夹具戳 poke 注入校验面 (批 3-5
# 夹具同法: 戳 poke 只用于把「外部腐败/缺戳」注入校验面, 判词本身全
# 部由被测层发射)。lowering 发射臂 (构造器 OBJECT_REF→OBJECT 物化臂 /
# bracket initializer 落戳 / return bracket 沉口 / W6 seq literal 门)
# 属驱动内代码, 夹具以同一物理形态合成 BodyIR 验证其戳车道全过批
# 1-5 验证面 (实物回归属驱动可构建后事项, 批 4/5 同例)。
#
# 模式 (argv[1], 缺省 unit):
#   unit                       — 正例全绿 (rc=0):
#     P1 managed return 持精确戳 (return admission 臂绿);
#     P2 构造器 OBJECT_REF→OBJECT deref 物化形态 (ref 形参 deref
#        FieldLoad 定义 + FieldStore 写入 + RET) 全组合绿;
#     P3 定长数组 bracket return 沉口形态 (int32[4] 裸 IndexedStore
#        整列 + RET, PLAIN storage 直通) 全组合绿;
#     P4 managed bracket 落戳形态探针 (str[4] 元素 IndexedStore 经
#        Prepare 落戳 + RET) — 批 6 lowering 落戳发射形的验证面;
#     ⑪ 判词文本断言 (managed return 九字段/W6 全字段构建器逐字)。
#   verdict-return-missing     — 托管 return 槽无定义 →
#     `managed return ... parsed=0 ...` + `managed function return
#     lacks exact value definition`。
#   verdict-return-mismatch    — RET source 边指他槽定义 →
#     parsed=1 字段组 + 同判词。
#   verdict-strseq-borrowed    — W6 借用元素直驱 →
#     `str[] literal ownership ...` + `str[] literal borrowed element
#     requires an explicit owned value`。
#   verdict-materialize-type    — 物化形态戳 exact type 漂移 (poke)
#     → 批 1 `slot authority mismatch` 七字段族 (def_type/slot_type
#     漂移; storage 两字段为单源同值投影, 批3 同源裁定)。
#   verdict-materialize-storage — 未绑 i32 槽 storage 列 poke 成 STR
#     → identity 槽循环 `has partial authority` 双源漂移判词
#     (storage=2 expected_storage=1)。
#
# 负例基线: 判词逐字对齐 C (cold_parser.c:74063-74086/42692-42710,
# cheng_cold.c:68402); 字段值随 IR 代次漂移, 门禁按 md5 钉死本树基板。

import std/cmdline as cmdline
import std/result
import std/os
import cheng/core/analysis/exact_def_derive as derive
import cheng/core/analysis/exact_def_freeze as freeze
import cheng/core/analysis/exact_def_identity as identity
import cheng/core/analysis/exact_def_call_authority as callauthority
import cheng/core/ir/body_ir_exact_def as exactdef
import cheng/core/ir/core_types as coreir
import cheng/core/lang/typed_expr_type_arena as typearena
import cheng/std/bytes_layout as layout

const
    # 合成 TypeArena 行: 0=i32 1=str 2=i64 3=i32[4] 4=rec{str}
    # 5=ref rec 6=str[4]。
    fixtureTypeI32 = 0
    fixtureTypeStr = 1
    fixtureTypeI64 = 2
    fixtureTypeArr4 = 3
    fixtureTypeRec = 4
    fixtureTypeRefObj = 5
    fixtureTypeStrArr4 = 6
    fixtureTransportStart = 100

fn smokeAssert(condition: bool, message: str) =
    if !condition:
        panic(message)

@borrows
fn smokeStrContains(text: str, sub: str): bool =
    let subLen = len(sub)
    if subLen <= 0:
        return true
    if len(text) < subLen:
        return false
    for start in 0..<len(text) - subLen + 1:
        var matched = true
        for offset in 0..<subLen:
            if text[start + offset] != sub[offset]:
                matched = false
                break
        if matched:
            return true
    return false

fn fixtureCid(): layout.FixedBytes32 =
    let parsed = layout.FixedBytes32FromHex(
        "cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd")
    if IsErr(parsed):
        panic(Error(parsed))
    return Value(parsed)

@borrows
fn buildWindow(): exactdef.BodyIrExactDefTypeArenaWindow =
    var window: exactdef.BodyIrExactDefTypeArenaWindow
    window.artifactCid = fixtureCid()
    for typeId in 0..<7:
        add(window.structuralKinds,
            Int32(typearena.TypedExprStructuralTypeInvalid))
        add(window.scalarKinds,
            Int32(typearena.TypedExprStructuralScalarInvalid))
        add(window.childTypeIds, -1)
        add(window.layoutChildStarts, 0)
        add(window.layoutChildCounts, 0)
        add(window.fixedLengths, 0)
        add(window.sizeBytes, 4)
        add(window.alignBytes, 4)
    window.structuralKinds[fixtureTypeI32] =
        Int32(typearena.TypedExprStructuralTypeScalar)
    window.scalarKinds[fixtureTypeI32] =
        Int32(typearena.TypedExprStructuralScalarInt32)
    window.sizeBytes[fixtureTypeI32] = 4
    window.alignBytes[fixtureTypeI32] = 4
    window.structuralKinds[fixtureTypeStr] =
        Int32(typearena.TypedExprStructuralTypeScalar)
    window.scalarKinds[fixtureTypeStr] =
        Int32(typearena.TypedExprStructuralScalarStr)
    window.sizeBytes[fixtureTypeStr] = 24
    window.alignBytes[fixtureTypeStr] = 8
    window.structuralKinds[fixtureTypeI64] =
        Int32(typearena.TypedExprStructuralTypeScalar)
    window.scalarKinds[fixtureTypeI64] =
        Int32(typearena.TypedExprStructuralScalarInt64)
    window.sizeBytes[fixtureTypeI64] = 8
    window.alignBytes[fixtureTypeI64] = 8
    window.structuralKinds[fixtureTypeArr4] =
        Int32(typearena.TypedExprStructuralTypeFixedArray)
    window.childTypeIds[fixtureTypeArr4] = fixtureTypeI32
    window.fixedLengths[fixtureTypeArr4] = 4
    window.sizeBytes[fixtureTypeArr4] = 16
    window.alignBytes[fixtureTypeArr4] = 4
    # rec{str}: Object 一托管字段 → OBJECT storage; 字段跳证据 (str@0
    # 宽 24) 供 derive field-borrow 臂逐跳核对。
    window.structuralKinds[fixtureTypeRec] =
        Int32(typearena.TypedExprStructuralTypeObject)
    window.layoutChildStarts[fixtureTypeRec] = 0
    window.layoutChildCounts[fixtureTypeRec] = 1
    add(window.layoutChildTypeIds, fixtureTypeStr)
    add(window.layoutChildOffsets, 0)
    add(window.layoutChildWidths, 24)
    window.sizeBytes[fixtureTypeRec] = 24
    window.alignBytes[fixtureTypeRec] = 8
    # ref rec: RefObject → child=rec。
    window.structuralKinds[fixtureTypeRefObj] =
        Int32(typearena.TypedExprStructuralTypeRefObject)
    window.childTypeIds[fixtureTypeRefObj] = fixtureTypeRec
    window.sizeBytes[fixtureTypeRefObj] = 8
    window.alignBytes[fixtureTypeRefObj] = 8
    # str[4]: FixedArray of str → STR storage。
    window.structuralKinds[fixtureTypeStrArr4] =
        Int32(typearena.TypedExprStructuralTypeFixedArray)
    window.childTypeIds[fixtureTypeStrArr4] = fixtureTypeStr
    window.fixedLengths[fixtureTypeStrArr4] = 4
    window.sizeBytes[fixtureTypeStrArr4] = 96
    window.alignBytes[fixtureTypeStrArr4] = 8
    smokeAssert(exactdef.BodyIrExactDefTypeArenaWindowShapeValid(window),
                "materialize smoke: window shape")
    return window

fn bindTypeFacts(body: var coreir.BodyIR) =
    smokeAssert(coreir.BodyIRBindCanonicalTypeFact(
                    body, fixtureCid(), fixtureTypeI32,
                    Int32(typearena.TypedExprStructuralTypeScalar),
                    Int32(typearena.TypedExprStructuralScalarInt32),
                    -1, 0, 4, 4),
                "materialize smoke: type fact i32")
    smokeAssert(coreir.BodyIRBindCanonicalTypeFact(
                    body, fixtureCid(), fixtureTypeStr,
                    Int32(typearena.TypedExprStructuralTypeScalar),
                    Int32(typearena.TypedExprStructuralScalarStr),
                    -1, 0, 24, 8),
                "materialize smoke: type fact str")
    smokeAssert(coreir.BodyIRBindCanonicalTypeFact(
                    body, fixtureCid(), fixtureTypeI64,
                    Int32(typearena.TypedExprStructuralTypeScalar),
                    Int32(typearena.TypedExprStructuralScalarInt64),
                    -1, 0, 8, 8),
                "materialize smoke: type fact i64")
    smokeAssert(coreir.BodyIRBindCanonicalTypeFact(
                    body, fixtureCid(), fixtureTypeArr4,
                    Int32(typearena.TypedExprStructuralTypeFixedArray),
                    Int32(typearena.TypedExprStructuralScalarInvalid),
                    fixtureTypeI32, 4, 16, 4),
                "materialize smoke: type fact arr4")
    smokeAssert(coreir.BodyIRBindCanonicalTypeFact(
                    body, fixtureCid(), fixtureTypeRec,
                    Int32(typearena.TypedExprStructuralTypeObject),
                    Int32(typearena.TypedExprStructuralScalarInvalid),
                    -1, 0, 24, 8),
                "materialize smoke: type fact rec")
    smokeAssert(coreir.BodyIRBindCanonicalTypeFact(
                    body, fixtureCid(), fixtureTypeRefObj,
                    Int32(typearena.TypedExprStructuralTypeRefObject),
                    Int32(typearena.TypedExprStructuralScalarInvalid),
                    fixtureTypeRec, 0, 8, 8),
                "materialize smoke: type fact ref rec")
    smokeAssert(coreir.BodyIRBindCanonicalTypeFact(
                    body, fixtureCid(), fixtureTypeStrArr4,
                    Int32(typearena.TypedExprStructuralTypeFixedArray),
                    Int32(typearena.TypedExprStructuralScalarInvalid),
                    fixtureTypeStr, 4, 96, 8),
                "materialize smoke: type fact str arr4")

fn addBoundSlot(body: var coreir.BodyIR,
                name: str,
                typeKind: int32,
                typeId: int32,
                managedStorageKind: int32,
                sizeBytes: int32,
                alignBytes: int32): int32 =
    var slot: coreir.LocalSlot
    let slotId = body.localSlots.len
    slot.id = slotId
    slot.name = name
    slot.typeKind = typeKind
    slot.stackOffset = slot.id * 32
    slot.sizeBytes = sizeBytes
    slot.alignBytes = alignBytes
    coreir.BodyIRApplyLocalSlotDefaultProof(slot)
    add(body.localSlots, slot)
    smokeAssert(coreir.BodyIRBindLocalSlotTypeArenaProof(
                    body, slotId, fixtureCid(), typeId,
                    managedStorageKind),
                "materialize smoke: slot TypeArena proof bind")
    return slotId

# lowering 合成槽对应物 (FindOrCreateTypedSlot 不绑 typeArena →
# sentinel 豁免车道): 不绑证明, 结构列直落。
fn addRawSlot(body: var coreir.BodyIR,
              name: str,
              typeKind: int32,
              sizeBytes: int32,
              alignBytes: int32): int32 =
    var slot: coreir.LocalSlot
    let slotId = body.localSlots.len
    slot.id = slotId
    slot.name = name
    slot.typeKind = typeKind
    slot.stackOffset = slot.id * 32
    slot.sizeBytes = sizeBytes
    slot.alignBytes = alignBytes
    coreir.BodyIRApplyLocalSlotDefaultProof(slot)
    add(body.localSlots, slot)
    return slotId

# entry 定义 ownership 冻结 (批 3 夹具同例): 全槽 OwnInvalid 打底,
# 形参序逐行落给定 ownership 后 freeze。
fn freezeEntryOwnership(body: var coreir.BodyIR,
                        ownerships: int32[]) =
    var kinds: int32[]
    for slotIndex in 0..<body.localSlots.len:
        add(kinds, Int32(coreir.OwnInvalid))
    for ordinal in 0..<ownerships.len:
        let slotId = body.entryParameterSlotIds[ordinal]
        kinds[slotId] = ownerships[ordinal]
    coreir.BodyIRFreezeEntryDefinitionOwnershipKinds(body, kinds)

fn addStrSlot(body: var coreir.BodyIR, name: str): int32 =
    return addBoundSlot(
        body, name, coreir.LocalStrTag, fixtureTypeStr,
        coreir.BodyManagedStorageManagedTag, 24, 8)

fn addRecSlot(body: var coreir.BodyIR, name: str): int32 =
    return addBoundSlot(
        body, name, coreir.LocalAggregateTag, fixtureTypeRec,
        coreir.BodyManagedStorageManagedTag, 24, 8)

fn addRefObjSlot(body: var coreir.BodyIR, name: str): int32 =
    return addBoundSlot(
        body, name, coreir.LocalAggregateTag, fixtureTypeRefObj,
        coreir.BodyManagedStorageManagedTag, 8, 8)

fn newDefOp(body: var coreir.BodyIR,
            kind: int32,
            target: int32,
            semanticRow: int32,
            ownership: coreir.OwnershipKind): int32 =
    var op: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = kind
    op.target = target
    op.valueDefSlot = target
    op.valueDefExprNodeIndex = semanticRow
    op.valueDefSemanticRow = semanticRow
    op.valueDefOwnership = ownership
    op.valueDefOriginKind = coreir.BodyDefinitionOriginTypedExprTag
    op.valueDefOriginId = semanticRow
    return coreir.BodyIRAppendOp(body, op)

fn newBareOp(body: var coreir.BodyIR, kind: int32, target: int32): int32 =
    var op: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = kind
    op.target = target
    return coreir.BodyIRAppendOp(body, op)

# 结构 source 边 (BodyDefinitionDomainBodyOpTag 物理定义边)。
fn setOpSource(body: var coreir.BodyIR, opRow: int32, sourceRow: int32) =
    body.ops[opRow].sourceDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[opRow].sourceDefinitionRow = sourceRow

fn buildTransportRows(count: int32): int32[] =
    var rows: int32[]
    for row in 0..<count:
        add(rows, fixtureTransportStart + row)
    return rows

fn appendBlock(body: var coreir.BodyIR,
               opStart: int32,
               opCount: int32,
               termIndex: int32): int32 =
    let blockId = coreir.BodyIRAppendBlock(body, opStart, opCount, 0)
    body.blocks[blockId].termIndex = termIndex
    return blockId

fn newRetTerm(body: var coreir.BodyIR,
              resultSlot: int32,
              sourceDef: int32): int32 =
    var term: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = coreir.BodyTermReturnTag
    term.resultSlot = resultSlot
    if sourceDef >= 0:
        term.sourceDefinitionDomain =
            coreir.BodyDefinitionDomainBodyOpTag
        term.sourceDefinitionRow = sourceDef
    return coreir.BodyIRAppendTerm(body, term)

fn bindSuccessors(body: var coreir.BodyIR,
                  termIndex: int32,
                  successors: int32[],
                  edgeKinds: int32[]) =
    coreir.BodyIRControlFlowBindTermSuccessors(
        body, termIndex, successors, edgeKinds)

fn beginControl(body: var coreir.BodyIR, blockCount: int32) =
    for blockId in 0..<blockCount:
        coreir.BodyIRControlFlowBindBlockScope(body, blockId, 0)

fn sealControlFlow(body: var coreir.BodyIR) =
    coreir.BodyIRControlFlowSeal(body)
    smokeAssert(coreir.BodyIRControlFlowShapeValid(body),
                "materialize smoke: control flow seal")

# 单块骨架收尾 (RET term + 块/后继/seal)。
fn sealSingleBlock(body: var coreir.BodyIR,
                   resultSlot: int32,
                   sourceDef: int32) =
    let term = newRetTerm(body, resultSlot, sourceDef)
    let _ = appendBlock(body, 0, body.ops.len, term)
    beginControl(body, 1)
    var succ: int32[]
    var kinds: int32[]
    bindSuccessors(body, term, succ, kinds)
    sealControlFlow(body)

@borrows
fn deriveFixture(body: var coreir.BodyIR,
                 originKinds: int32[],
                 exactTypeIds: int32[],
                 window: exactdef.BodyIrExactDefTypeArenaWindow) =
    smokeAssert(derive.BodyIrExactDefDerive(
                    body,
                    fixtureTransportStart,
                    buildTransportRows(originKinds.len),
                    originKinds,
                    exactTypeIds,
                    window),
                "materialize smoke: derive rejected fixture")
    smokeAssert(body.exactDef.sealed, "materialize smoke: sidecar sealed")

@borrows
fn deriveFixtureRaw(body: var coreir.BodyIR,
                    originKinds: int32[],
                    exactTypeIds: int32[],
                    window: exactdef.BodyIrExactDefTypeArenaWindow): bool =
    return derive.BodyIrExactDefDerive(
        body,
        fixtureTransportStart,
        buildTransportRows(originKinds.len),
        originKinds,
        exactTypeIds,
        window)

fn validateComposed(body: var coreir.BodyIR): bool =
    var emptyContract: exactdef.ExactProgramContract
    var emptyCalleeRows: int32[]
    return callauthority.ExactDefCallAuthorityValidateInto(
        body, freeze.ExactDefFreezeProductionLimits(),
        emptyContract, emptyCalleeRows)

fn beginBody(body: var coreir.BodyIR) =
    smokeAssert(coreir.BodyIRBindTypeArenaArtifactCid(body, fixtureCid()),
                "materialize smoke: TypeArena artifact bind")
    coreir.BodyIRControlFlowBegin(body, 0)
    bindTypeFacts(body)

# ---- 正例腿构建器 ----

# P1 managed return 持精确戳: str cell 定义 + RET(source=def)。
fn runPositiveReturnAdmission(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    add(originKinds, 4)   # 100 cell (TEMPORARY 车道, merge 夹具同例)
    add(exactTypeIds, fixtureTypeStr)
    var body: coreir.BodyIR
    beginBody(body)
    let cell = addStrSlot(body, "cell")
    let o0 = newDefOp(
        body, coreir.BodyOpLoadConstTag, cell, 100, coreir.OwnMove)
    add(body.ops[o0].operands, coreir.LocalStrTag)
    sealSingleBlock(body, cell, o0)
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    if !validateComposed(body):
        return 1
    os.WriteLine(os.Get_stdout(), "P1 managed return exact def: OK")
    return 0

# P2 构造器 OBJECT_REF→OBJECT deref 物化形态: ref 形参槽 → deref
# FieldLoad 定义 (Prepare 落戳, TEMPORARY 车道) → 裸 FieldStore 写
# 入未绑构造目标 (lowering FindOrCreateTypedSlot 对应物, sentinel
# 车道) → RET。即批 6 构造器物化臂 (primary/backend2) 发射的物理
# 形态 — 落戳 deref 经 identity TEMPORARY 臂批 6 deref 物化通道。
fn runPositiveCtorDeref(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    add(originKinds, 1)   # 100 q Parameter (ref rec, BU)
    add(originKinds, 4)   # 101 deref 物化定义 (TEMPORARY 车道)
    add(exactTypeIds, fixtureTypeRefObj)
    add(exactTypeIds, fixtureTypeRec)
    var body: coreir.BodyIR
    beginBody(body)
    let q = addRefObjSlot(body, "q")
    add(body.entryParameterSlotIds, q)
    let owned = addRecSlot(body, "owned")
    let target = addRawSlot(body, "target", coreir.LocalAggregateTag,
                            24, 8)
    freezeEntryOwnership(body, [Int32(coreir.OwnBorrowUnique)])
    let o0 = newDefOp(
        body, coreir.BodyOpLoadLocalTag, q, 100, coreir.OwnBorrowUnique)
    let o1 = newDefOp(
        body, coreir.BodyOpFieldLoadTag, owned, 101, coreir.OwnMove)
    add(body.ops[o1].operands, q)
    add(body.ops[o1].operands, owned)
    add(body.ops[o1].operands, 0)
    add(body.ops[o1].operands, 24)
    setOpSource(body, o1, o0)
    let o2 = newBareOp(body, coreir.BodyOpFieldStoreTag, target)
    add(body.ops[o2].operands, target)
    add(body.ops[o2].operands, owned)
    add(body.ops[o2].operands, 0)
    add(body.ops[o2].operands, 24)
    sealSingleBlock(body, target, o1)
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    if !validateComposed(body):
        return 1
    os.WriteLine(os.Get_stdout(), "P2 ctor object-ref deref materialize: OK")
    return 0

# P3 定长数组 bracket return 沉口形态 (int32[4]): lowering 合成槽
# (不绑 typeArena → sentinel 车道) + 4 裸 IndexedStore + RET。PLAIN
# storage 直通 return admission (C PLAIN 升格臂的 Cheng 真空裁定)。
fn runPositiveBracketReturn(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    var body: coreir.BodyIR
    beginBody(body)
    let arr = addRawSlot(body, "arr", coreir.LocalAggregateTag, 16, 4)
    let elem = addRawSlot(body, "elem", coreir.LocalI32Tag, 4, 4)
    let idx0 = addRawSlot(body, "idx0", coreir.LocalI32Tag, 4, 4)
    let _ = newBareOp(body, coreir.BodyOpLoadConstTag, elem)
    let _ = newBareOp(body, coreir.BodyOpLoadConstTag, idx0)
    var store0: coreir.BodyOp
    store0.kind = coreir.BodyOpIndexedStoreTag
    store0.target = arr
    add(store0.operands, arr)
    add(store0.operands, elem)
    add(store0.operands, idx0)
    add(store0.operands, 4)
    let _ = coreir.BodyIRAppendOp(body, store0)
    sealSingleBlock(body, arr, -1)
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    if !validateComposed(body):
        return 1
    os.WriteLine(os.Get_stdout(), "P3 fixed array bracket return sink: OK")
    return 0

# P4 managed bracket 发射形态 (str[4]): lowering 合成槽 (不绑
# typeArena → sentinel 车道) + 裸 IndexedStore 整列 + RET。批 6 实
# 测定案: 元素 store 落戳形 (Prepare) 属批 3 绑定门 copyKind 白名
# 单外新形态 (IndexedStore 非 CopyLocal/LoadConst 绑定载体, 判词
# `managed bind definition is broken`), 故 managed bracket 与非托
# 管同形保持裸 store — 其 return admission 经 storage UNKNOWN 直
# 通 (sentinel 车道), 戳落点 = 绑定侧车道 (decl binding/消费点),
# 批 3 臂扩形属后续锚点 (报告 §6)。
fn runPositiveManagedBracketBare(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    var body: coreir.BodyIR
    beginBody(body)
    let arr = addRawSlot(body, "arr", coreir.LocalAggregateTag, 96, 8)
    let elem = addStrSlot(body, "elem")
    let idx0 = addRawSlot(body, "idx0", coreir.LocalI32Tag, 4, 4)
    let idx1 = addRawSlot(body, "idx1", coreir.LocalI32Tag, 4, 4)
    let _ = newBareOp(body, coreir.BodyOpLoadConstTag, idx0)
    let _ = newBareOp(body, coreir.BodyOpLoadConstTag, idx1)
    var originKindsB: int32[]
    var exactTypeIdsB: int32[]
    add(originKindsB, 4)   # 100 elem (TEMPORARY 车道)
    add(exactTypeIdsB, fixtureTypeStr)
    let o0 = newDefOp(
        body, coreir.BodyOpLoadConstTag, elem, 100, coreir.OwnMove)
    add(body.ops[o0].operands, coreir.LocalStrTag)
    var store0: coreir.BodyOp
    store0.kind = coreir.BodyOpIndexedStoreTag
    store0.target = arr
    add(store0.operands, arr)
    add(store0.operands, elem)
    add(store0.operands, idx0)
    add(store0.operands, 24)
    let _ = coreir.BodyIRAppendOp(body, store0)
    var store1: coreir.BodyOp
    store1.kind = coreir.BodyOpIndexedStoreTag
    store1.target = arr
    add(store1.operands, arr)
    add(store1.operands, elem)
    add(store1.operands, idx1)
    add(store1.operands, 24)
    let _ = coreir.BodyIRAppendOp(body, store1)
    sealSingleBlock(body, arr, -1)
    deriveFixture(body, originKindsB, exactTypeIdsB, buildWindow())
    if !validateComposed(body):
        return 1
    os.WriteLine(os.Get_stdout(), "P4 managed bracket bare emission: OK")
    return 0

# ---- ⑪ 判词文本断言 (构建器逐字, 批 2-5 同例) ----

fn runVerdictTextAsserts(): int32 =
    # managed return 九字段 (cold_parser.c:74063-74082 字段序; type=
    # 基板替换为槽名投影, derive 臂注释)。W6 全字段 (42692-42695)。
    let w6Line =
        callauthority.ExactDefCallAuthorityTestStrSeqLiteralOwnershipLine(
            0, 1, 5, 3, -1, -1, 3, 7, 4, 2, 0, 0)
    if !smokeStrContains(
           w6Line,
           "cheng_cold: str[] literal ownership body=0 element=1 def=5 ownership=3 place=-1 origin=-1 kind=3 slot=7 source=4 op_a=2 op_b=0 op_c=0"):
        return 1
    return 0

fn runUnit(): int32 =
    if runPositiveReturnAdmission() != 0:
        return 1
    if runPositiveCtorDeref() != 0:
        return 1
    if runPositiveBracketReturn() != 0:
        return 1
    if runPositiveManagedBracketBare() != 0:
        return 1
    if runVerdictTextAsserts() != 0:
        return 1
    os.WriteLine(os.Get_stdout(), "EXACT_DEF_MATERIALIZE_UNIT_OK")
    return 0

# ---- 负例腿 ----

# N1: 托管 return 槽无定义 (parsed=0) → managed return 九字段 +
# lacks exact value definition。
fn runVerdictReturnMissing(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    var body: coreir.BodyIR
    beginBody(body)
    let cell = addStrSlot(body, "cell")
    let _ = newBareOp(body, coreir.BodyOpLoadConstTag, cell)
    sealSingleBlock(body, cell, -1)
    if deriveFixtureRaw(body, originKinds, exactTypeIds, buildWindow()):
        return 1
    return 2

# N2: RET source 边指他槽定义 (parsed=1 字段组) → 同判词。
fn runVerdictReturnMismatch(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    add(originKinds, 2)   # 100 cell
    add(originKinds, 2)   # 101 other
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)
    var body: coreir.BodyIR
    beginBody(body)
    let cell = addStrSlot(body, "cell")
    let other = addStrSlot(body, "other")
    let o0 = newDefOp(
        body, coreir.BodyOpLoadConstTag, cell, 100, coreir.OwnMove)
    add(body.ops[o0].operands, coreir.LocalStrTag)
    let o1 = newDefOp(
        body, coreir.BodyOpLoadConstTag, other, 101, coreir.OwnMove)
    add(body.ops[o1].operands, coreir.LocalStrTag)
    sealSingleBlock(body, cell, o1)
    if deriveFixtureRaw(body, originKinds, exactTypeIds, buildWindow()):
        return 1
    return 2

# N3: W6 借用元素直驱 (与 lowering seq literal 门同一 reject 通道)。
fn runVerdictStrSeqBorrowed(): int32 =
    callauthority.ExactDefCallAuthorityStrSeqBorrowedElementReject(
        0, 1, 5, 3, -1, -1, 3, 7, 4, 2, 0, 0)
    return 1

# N4: 物化形态戳 exact type 漂移 (poke) → 批 1 slot authority
# mismatch 七字段族 (identity op 层 type+storage 子句; 本腿漂移的
# 是 def_type/slot_type, storage 两字段由单源 recorded 列同值投影 —
# 批3 同源裁定, def≠slot 的 storage 漂移在本判词结构性不可表达)。
fn runVerdictMaterializeType(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    add(originKinds, 1)   # 100 q Parameter
    add(originKinds, 4)   # 101 deref
    add(exactTypeIds, fixtureTypeRefObj)
    add(exactTypeIds, fixtureTypeRec)
    var body: coreir.BodyIR
    beginBody(body)
    let q = addRefObjSlot(body, "q")
    add(body.entryParameterSlotIds, q)
    let owned = addRecSlot(body, "owned")
    let target = addRawSlot(body, "target", coreir.LocalAggregateTag,
                            24, 8)
    freezeEntryOwnership(body, [Int32(coreir.OwnBorrowUnique)])
    let o0 = newDefOp(
        body, coreir.BodyOpLoadLocalTag, q, 100, coreir.OwnBorrowUnique)
    let o1 = newDefOp(
        body, coreir.BodyOpFieldLoadTag, owned, 101, coreir.OwnMove)
    add(body.ops[o1].operands, q)
    add(body.ops[o1].operands, owned)
    add(body.ops[o1].operands, 0)
    add(body.ops[o1].operands, 24)
    setOpSource(body, o1, o0)
    let o2 = newBareOp(body, coreir.BodyOpFieldStoreTag, target)
    add(body.ops[o2].operands, target)
    add(body.ops[o2].operands, owned)
    add(body.ops[o2].operands, 0)
    add(body.ops[o2].operands, 24)
    sealSingleBlock(body, target, o1)
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    body.exactDef.opExactTypeIds[1] = fixtureTypeI64
    if validateComposed(body):
        return 1
    return 2

# N4b: 真 storage 漂移 — 未绑 i32 槽 (裸 LoadConst, sentinel 车道)
# recorded slotStorageKinds poke 成 STR: 槽脱离 sentinel (storage 列
# 非规范值) 进入槽循环, 与 expectedStorage 按 typeKind+sizeBytes 独
# 立推导的 PLAIN 分叉 → partial authority 判词携带双源字段
# (storage=2 expected_storage=1)。derive 车道对托管定义强制绑型
# (同源), 双源漂移仅在未绑静态道可构 — 本形即其夹具。
fn runVerdictMaterializeStorage(): int32 =
    var body: coreir.BodyIR
    beginBody(body)
    let idx = addRawSlot(body, "idx", coreir.LocalI32Tag, 4, 4)
    let _ = newBareOp(body, coreir.BodyOpLoadConstTag, idx)
    sealSingleBlock(body, idx, -1)
    var originKinds: int32[]
    var exactTypeIds: int32[]
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    body.exactDef.slotStorageKinds[idx] =
        exactdef.BodyIrExactDefStorageStrTag
    if validateComposed(body):
        return 1
    return 2

fn main(argc: int32, argv: ptr): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    var mode = "unit"
    if cmdline.ParamCount() >= 1:
        mode = cmdline.ParamStr(1)
    if mode == "":
        mode = "unit"
    if mode == "unit":
        return runUnit()
    if mode == "verdict-return-missing":
        return runVerdictReturnMissing()
    if mode == "verdict-return-mismatch":
        return runVerdictReturnMismatch()
    if mode == "verdict-strseq-borrowed":
        return runVerdictStrSeqBorrowed()
    if mode == "verdict-materialize-type":
        return runVerdictMaterializeType()
    if mode == "verdict-materialize-storage":
        return runVerdictMaterializeStorage()
    os.WriteLine(os.Get_stdout(), Fmt"unknown mode: {mode}")
    return 2
