import std/hashmaps

fn main(): int32 =
    var m = hashmaps.HashMapStrIntInit(8)
    var probe: hashmaps.HashMapStrIntGrowProbe
    hashmaps.HashMapStrIntGrowWithProbe(m, probe)
    assert(probe.sourceCapacity == 8 &&
           probe.destinationCapacity == 16 &&
           probe.sourceUsed == 0 &&
           probe.rehashedEntryCount == Int64(0),
           "hashmap grow preserves the exact loop call-arg origin")
    hashmaps.HashMapStrIntClear(m)
    return 0
