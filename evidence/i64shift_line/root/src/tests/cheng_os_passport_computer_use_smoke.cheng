import cheng/core/runtime/web_scene_computer_use as cu
import "src/cheng_os/passport/computer_use.cheng" as pcu
import "src/cheng_os/passport/kernel.cheng" as ker
import "src/cheng_os/passport/wire.cheng" as wire
import "src/cheng_os/passport/syscall.cheng" as sys
import "src/cheng_os/passport/effect.cheng" as eff

fn main(): int32 =
    var fails = 0
    let nonce = 305419896
    var err: str

    if pcu.PassportAdmit("Click", "external-publish", sys.SysTick, err):
        fails = fails | 1
    if err != cu.WebSceneComputerUseErrConfirmationRequired:
        fails = fails | 2

    var st = ker.InitState()
    var r = ker.StepCommand(st, eff.EffConfirmPrompt)
    st = ker.NextStateOf(r)
    if st != ker.StConfirming:
        fails = fails | 4

    var prompt: uint8[wire.FrameCap]
    var pn = 0
    pn = wire.BuildEnvelope(prompt, pn, wire.DirCommand, eff.EffConfirmPrompt, nonce, 10, 0)
    if wire.EnvelopeCrcOk(prompt, pn) == 0:
        fails = fails | 8
    if wire.NonceMatch(nonce, wire.EnvelopeNonce(prompt, pn)) == 0:
        fails = fails | 16

    if pcu.PassportAdmit("Click", "external-publish", sys.SysKey1Down, err):
        fails = fails | 32

    r = ker.Step(st, sys.SysKey3Down)
    if (ker.ActionsOf(r) & ker.ActEmitConfirm) == 0:
        fails = fails | 64
    st = ker.NextStateOf(r)
    if st != ker.StExecWait:
        fails = fails | 128

    if !pcu.PassportAdmit("Click", "external-publish", sys.SysKey3Down, err):
        fails = fails | 256
    if !pcu.PassportAdmit("Click", "external-publish", sys.SysNfcTap, err):
        fails = fails | 512

    var up: uint8[wire.FrameCap]
    var un = 0
    un = wire.BuildEnvelope(up, un, wire.DirEvent, sys.SysNfcTap, nonce, 20, 0)
    if wire.EnvelopeCrcOk(up, un) == 0:
        fails = fails | 1024
    if wire.EnvelopeDir(up, un) != wire.DirEvent:
        fails = fails | 2048

    var rec: uint8[wire.FrameCap]
    var rn = 0
    rn = wire.BuildEnvelope(rec, rn, wire.DirCommand, eff.EffReceipt, nonce, 30, 0)
    if wire.EnvelopeCrcOk(rec, rn) == 0:
        fails = fails | 4096
    if wire.EnvelopeKind(rec, rn) != eff.EffReceipt:
        fails = fails | 8192
    if wire.NonceMatch(nonce, wire.EnvelopeNonce(rec, rn)) == 0:
        fails = fails | 16384
    if wire.NonceMatch(nonce, nonce + 1) != 0:
        fails = fails | 32768

    r = ker.StepCommand(st, eff.EffReceipt)
    if ker.NextStateOf(r) != ker.StReceiptShown:
        fails = fails | 65536
    if (ker.ActionsOf(r) & ker.ActTone) == 0:
        fails = fails | 131072

    if !pcu.PassportAdmit("Click", "search", sys.SysTick, err):
        fails = fails | 262144

    return fails
