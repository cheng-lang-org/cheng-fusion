import std/os as os
import std/rawbytes
import std/result
import std/strings
import cheng/core/csg_core/merkle_builder
import cheng/core/csg_core/merkle_manifest
import cheng/core/csg_core/merkle_store
import cheng/core/csg_core/merkle_store_codec
import cheng/core/csg_core/merkle_store_pipeline

const
    Standard: str = "csg_core::v1"
    BaseProfile: str = "csg_core"
    MainSourceId: str = "source:store-smoke-main"
    ProviderSourceId: str = "source:store-smoke-provider"
    MainSourcePayload: str = "module main\nfn main() = provider()\n"
    ProviderSourcePayload: str = "module provider\nfn provider() = 1\n"

@borrows
fn fail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

@borrows
fn cat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

@borrows
fn sourceCid(text: str): str =
    var bytes = rawbytes.BytesAlloc(text.len)
    for i in 0..<text.len:
        rawbytes.BytesSet(
            bytes, i, int32(text[i]) & 255)
    let cid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            "csg_core.external.source", bytes)
    rawbytes.BytesFree(bytes)
    return cid

@borrows
fn makeSource(
        sourceId: str,
        sourceCidValue: str,
        facts: str[]):
        merkle_builder.CsgCoreMerkleBuilderSource =
    var out: merkle_builder.CsgCoreMerkleBuilderSource
    out.sourceId = strings.CloneStr(sourceId)
    out.sourceCid = strings.CloneStr(sourceCidValue)
    for i in 0..<facts.len:
        add(out.facts, strings.CloneStr(facts[i]))
    return out

@borrows
fn buildClosure(
        reverseSources: bool,
        reverseMainFacts: bool):
        merkle_builder.CsgCoreMerkleBuilderResult =
    let schemaFact =
        "{\"features\":[\"core-facts\"],\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}"
    let moduleFact =
        cat(
            cat(
                "{\"file\":\"pkg://cheng/store-smoke/main.cheng\",\"id\":\"module:main\",\"kind\":\"csg.module\",\"name\":\"main\",\"path\":\"pkg://cheng/store-smoke/main.cheng\",\"sha256\":\"",
                sourceCid(MainSourcePayload)),
            "\"}")
    let mainSymbolFact =
        "{\"caller\":\"module:main\",\"file\":\"pkg://cheng/store-smoke/main.cheng\",\"id\":\"symbol:main\",\"kind\":\"csg.symbol\",\"name\":\"main\",\"symbol\":\"main\",\"symbolKind\":\"fn\"}"
    let providerSymbolFact =
        "{\"file\":\"pkg://cheng/store-smoke/provider.cheng\",\"id\":\"symbol:provider\",\"kind\":\"csg.symbol\",\"name\":\"provider\",\"symbol\":\"provider\",\"symbolKind\":\"fn\"}"
    var mainFacts: str[]
    if reverseMainFacts:
        mainFacts = [
            strings.CloneStr(mainSymbolFact),
            strings.CloneStr(moduleFact),
            strings.CloneStr(schemaFact)
        ]
    else:
        mainFacts = [
            strings.CloneStr(schemaFact),
            strings.CloneStr(moduleFact),
            strings.CloneStr(mainSymbolFact)
        ]
    let mainSource =
        makeSource(
            MainSourceId,
            sourceCid(MainSourcePayload),
            mainFacts)
    let providerSource =
        makeSource(
            ProviderSourceId,
            sourceCid(ProviderSourcePayload),
            [strings.CloneStr(providerSymbolFact)])
    if reverseSources:
        return merkle_builder.CsgCoreMerkleBuildClosure(
            Standard,
            [BaseProfile],
            [providerSource, mainSource],
            [])
    return merkle_builder.CsgCoreMerkleBuildClosure(
        Standard,
        [BaseProfile],
        [mainSource, providerSource],
        [])

@borrows
fn storeIdentityDomainsDistinct(
        headCid: str,
        manifestCid: str,
        manifest: merkle_manifest.CsgCoreMerkleManifest): bool =
    return headCid != manifestCid &&
        headCid != manifest.csgcObjectCid &&
        headCid != manifest.csgcDirectoryCid &&
        headCid != manifest.factsRoot &&
        manifestCid != manifest.csgcObjectCid &&
        manifestCid != manifest.csgcDirectoryCid &&
        manifestCid != manifest.factsRoot &&
        manifest.csgcObjectCid != manifest.csgcDirectoryCid &&
        manifest.csgcObjectCid != manifest.factsRoot &&
        manifest.csgcDirectoryCid != manifest.factsRoot

@borrows
fn storeStagingClean(
        parentPath: str,
        storeName: str): bool =
    let parentEntries = os.ListDir(parentPath)
    for i in 0..<parentEntries.len:
        if strings.HasPrefix(parentEntries[i], ".txn-store-"):
            return false
    let storeRoot = os.JoinPath(parentPath, storeName)
    let categories = [
        "csgc_objects", "dependencies", "indexes", "manifests",
        "memberships", "nodes", "operations", "partitions", "proofs",
        "receipts", "requests", "successors", "summaries"
    ]
    for categoryIndex in 0..<categories.len:
        let entries = os.ListDir(
            os.JoinPath(storeRoot, categories[categoryIndex]))
        for entryIndex in 0..<entries.len:
            if strings.HasPrefix(entries[entryIndex], ".txn-"):
                return false
    return true

@borrows
fn successorHeadBytes(
        parentPath: str,
        storeName: str): rawbytes.Bytes =
    let path = os.JoinPath(
        os.JoinPath(
            os.JoinPath(
                os.JoinPath(parentPath, storeName),
                "successors"),
            "genesis"),
        "head.csgc")
    let read = os.ReadFileBytesResult(path)
    if result.IsErr(read):
        return rawbytes.EmptyBytes()
    return result.Value(read)

@borrows
fn verifyGenesisSuccessor(
        parentPath: str,
        storeName: str,
        expectedHeadCid: str,
        expectedManifestCid: str): str =
    var bytes = successorHeadBytes(parentPath, storeName)
    if rawbytes.BytesLen(bytes) == 0:
        return "genesis successor bytes missing"
    let decoded = merkle_store.CsgCoreMerkleHeadDecode(bytes)
    rawbytes.BytesFree(bytes)
    if !decoded.ok ||
       decoded.head.generation != int64(0) ||
       decoded.head.previousHeadCid != "none" ||
       decoded.head.receiptCid != "none" ||
       decoded.head.headCid != expectedHeadCid ||
       decoded.head.manifestCid != expectedManifestCid:
        return "genesis successor authority mismatch"
    return ""

@borrows
fn storeReceipt(
        mode: str,
        headCid: str,
        manifestCid: str,
        manifest: merkle_manifest.CsgCoreMerkleManifest): str =
    var out = cat(
        "csg_core_merkle_store_smoke ok mode=", mode)
    out = cat(cat(out, " head="), headCid)
    out = cat(cat(out, " object_cid="), manifest.csgcObjectCid)
    out = cat(cat(out, " directory_cid="), manifest.csgcDirectoryCid)
    out = cat(cat(out, " facts_root="), manifest.factsRoot)
    out = cat(cat(out, " manifest_cid="), manifestCid)
    out = cat(out, " fact_count=4")
    out = cat(out, " canonical_object=verified")
    out = cat(out, " no_replace=verified")
    out = cat(out, " head_admission=verified")
    out = cat(out, " immutable_successor=verified")
    out = cat(out, " bootstrap_reuse=verified")
    return out

@borrows
fn validatePublished(
        parentPath: str,
        storeName: str,
        mode: str): int32 =
    let read = merkle_store.CsgCoreMerkleStoreReadHead(
        parentPath, storeName)
    if !read.ok || !read.present ||
       read.head.generation != int64(0) ||
       read.manifest.factCount != 4 ||
       read.manifest.nodeCount <= 0 ||
       read.manifest.partitions.len != 4 ||
       read.manifest.csgcByteCount < 64 ||
       !read.identityProven ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           read.storeIdentityCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           read.beforeStoreIdentity) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           read.storeLayoutCid) ||
       !storeIdentityDomainsDistinct(
           read.head.headCid,
           read.head.manifestCid,
           read.manifest):
        return fail(cat("store read failed: ", read.error))
    var logicalManifest: merkle_manifest.CsgCoreMerkleManifest
    let logical =
        merkle_store.CsgCoreMerkleStoreVerifyManifestClosureLogical(
            read.storeRoot,
            read.head.manifestCid,
            logicalManifest)
    if !logical.ok ||
       !logical.storeIdentityProven ||
       logical.storeIdentityCid != read.storeIdentityCid ||
       logical.beforeStoreIdentity != read.beforeStoreIdentity ||
       logical.storeLayoutCid != read.storeLayoutCid ||
       strings.StrContains(
           logical.error,
           "identity_not_wired") ||
       strings.StrContains(
           logical.hardRed,
           "identity_not_wired"):
        return fail(cat("store consume identity bind failed: ", logical.error))
    let mapped =
        merkle_store.CsgCoreMerkleStoreMapCanonicalCsgcObject(
            os.JoinPath(parentPath, storeName),
            read.manifest)
    if !mapped.ok ||
       mapped.objectCid != read.manifest.csgcObjectCid ||
       mapped.byteCount != read.manifest.csgcByteCount ||
       mapped.storeRelativePath !=
           merkle_store.CsgCoreMerkleStoreCanonicalCsgcRelativePath(
               read.manifest.csgcObjectCid):
        return fail(cat("canonical CSGC readback failed: ", mapped.error))
    let closed = os.ReadOnlyMappedRegionClose(mapped.region)
    if result.IsErr(closed):
        return fail("canonical CSGC readback close failed")
    let successorError = verifyGenesisSuccessor(
        parentPath,
        storeName,
        read.head.headCid,
        read.head.manifestCid)
    if successorError.len > 0:
        return fail(successorError)
    if !storeStagingClean(parentPath, storeName):
        return fail("store transaction staging cleanup failed")
    os.WriteLine(
        os.Get_stdout(),
        storeReceipt(
            mode,
            read.head.headCid,
            read.head.manifestCid,
            read.manifest))
    return 0

@borrows
fn runWrite(parentPath: str): int32 =
    var forward = buildClosure(false, false)
    var reverse = buildClosure(true, true)
    if !forward.ok || !reverse.ok:
        let error = cat(forward.error, cat(" / ", reverse.error))
        merkle_builder.CsgCoreMerkleBuilderFree(forward)
        merkle_builder.CsgCoreMerkleBuilderFree(reverse)
        return fail(cat("store closure build failed: ", error))
    if forward.factCount != 4 || reverse.factCount != 4 ||
       forward.factsRoot != reverse.factsRoot ||
       forward.dagRootCid != reverse.dagRootCid ||
       forward.manifestArtifact.cid != reverse.manifestArtifact.cid ||
       forward.manifest.csgcDirectoryCid !=
           reverse.manifest.csgcDirectoryCid ||
       forward.manifest.csgcObjectCid !=
           reverse.manifest.csgcObjectCid:
        merkle_builder.CsgCoreMerkleBuilderFree(forward)
        merkle_builder.CsgCoreMerkleBuilderFree(reverse)
        return fail("store closure input order changed canonical identity")
    let published =
        merkle_store_pipeline.CsgCoreMerkleStoreBootstrapExclusive(
            parentPath, "store", forward)
    if !published.ok || !published.published || published.reused ||
       published.objectWriteCount <= 0 ||
       published.head.generation != int64(0):
        let error = published.error.len > 0 ?
            strings.CloneStr(published.error) :
            "store bootstrap result invalid"
        merkle_builder.CsgCoreMerkleBuilderFree(forward)
        merkle_builder.CsgCoreMerkleBuilderFree(reverse)
        return fail(error)
    let reused = merkle_store_pipeline.CsgCoreMerkleStoreBootstrap(
        parentPath, "store", reverse)
    if !reused.ok || !reused.published || !reused.reused ||
       reused.head.headCid != published.head.headCid ||
       reused.manifestCid != published.manifestCid:
        let error = reused.error.len > 0 ?
            strings.CloneStr(reused.error) :
            "store bootstrap reuse invalid"
        merkle_builder.CsgCoreMerkleBuilderFree(forward)
        merkle_builder.CsgCoreMerkleBuilderFree(reverse)
        return fail(error)
    let exclusiveRetry =
        merkle_store_pipeline.CsgCoreMerkleStoreBootstrapExclusive(
            parentPath, "store", reverse)
    if exclusiveRetry.ok ||
       !strings.StrContains(
           exclusiveRetry.error,
           "merkle_store_bootstrap_store_already_exists"):
        merkle_builder.CsgCoreMerkleBuilderFree(forward)
        merkle_builder.CsgCoreMerkleBuilderFree(reverse)
        return fail("exclusive bootstrap accepted occupied store")
    merkle_builder.CsgCoreMerkleBuilderFree(forward)
    merkle_builder.CsgCoreMerkleBuilderFree(reverse)
    return validatePublished(parentPath, "store", "write")

@borrows
fn identityFailReasonAccepted(error: str): bool =
    return error.len > 0 &&
        !strings.StrContains(error, "identity_not_wired") &&
        (strings.StrContains(error, "merkle_store_identity_record_missing") ||
         strings.StrContains(error, "merkle_store_identity_root_shape_invalid") ||
         strings.StrContains(error, "merkle_store_identity_record_noncanonical") ||
         strings.StrContains(error, "merkle_store_identity_record_fields_invalid") ||
         strings.StrContains(error, "merkle_store_identity_record_binding_mismatch") ||
         strings.StrContains(error, "merkle_store_identity_decode_invalid") ||
         strings.StrContains(error, "merkle_store_identity_cid_drift") ||
         strings.StrContains(error, "merkle_store_identity_path_live_join_failed"))

@borrows
fn runIdentityFail(parentPath: str): int32 =
    let identityPath = os.JoinPath(
        os.JoinPath(parentPath, "store"),
        "store.identity.csgc")
    os.WriteFile(identityPath, "not-a-store-identity-record")
    let tampered = merkle_store.CsgCoreMerkleStoreReadHead(
        parentPath, "store")
    if tampered.ok || !identityFailReasonAccepted(tampered.error):
        return fail(cat("tampered identity covered: ", tampered.error))
    if !os.RemoveFile(identityPath):
        return fail("identity file remove failed")
    let missing = merkle_store.CsgCoreMerkleStoreReadHead(
        parentPath, "store")
    if missing.ok || !identityFailReasonAccepted(missing.error):
        return fail(cat("missing identity covered: ", missing.error))
    os.WriteLine(
        os.Get_stdout(),
        cat(
            "csg_core_merkle_store_smoke ok mode=identity-fail tamper=",
            cat(tampered.error, cat(" missing=", missing.error))))
    return 0

fn main(): int32 =
    let parentPath = os.GetEnv("CSG_STORE_TEST_PARENT")
    let mode = os.GetEnv("CSG_STORE_TEST_MODE")
    if parentPath.len == 0:
        return fail("CSG_STORE_TEST_PARENT missing")
    if mode == "write":
        return runWrite(parentPath)
    if mode == "read":
        return validatePublished(parentPath, "store", "read")
    if mode == "identity-fail":
        return runIdentityFail(parentPath)
    return fail("CSG_STORE_TEST_MODE invalid")
