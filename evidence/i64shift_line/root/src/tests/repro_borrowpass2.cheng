import std/rawbytes as rawbytes

type Face =
    data: int32[]
    loaded: bool

fn initEmpty(f: var Face) =
    f.loaded = false

@borrows
fn decode(t: str, outBytes: var int32[]): bool =
    outBytes = [1, 2, 3]
    return true

@borrows
fn loadSfnt(data: int32[], f: var Face): bool =
    initEmpty(f)
    if data.len < 4:
        return false
    f.data = data
    f.loaded = true
    return true

@borrows
fn loadBase64(text: str, f: var Face): bool =
    initEmpty(f)
    var data: int32[]
    if !decode(text, data):
        return false
    return loadSfnt(data, f)

fn main(): int32 =
    var f: Face
    if loadBase64("aGVsbG8", f):
        return 1
    return 0
