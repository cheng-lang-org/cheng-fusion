fn ColdExactUniqueBorrowSequentialRewrite(value: var str,
                                          replacement: str) =
    value = replacement

fn ColdExactUniqueBorrowSequentialTwice(value: var str) =
    ColdExactUniqueBorrowSequentialRewrite(value, "first")
    ColdExactUniqueBorrowSequentialRewrite(value, "second")

fn main(): int32 =
    var value = "start"
    ColdExactUniqueBorrowSequentialTwice(value)
    if value != "second":
        return 11
    return 0
