import std/result
import std/system
import std/strings
import cheng/ip_purity/score as purity

fn smokeHash(label: str): str =
    return strings.Sha256(label)

fn mustPrefix(res: Result[purity.IpPurityPrefixRecord], label: str): purity.IpPurityPrefixRecord =
    assert(IsOk(res), label)
    return Value(res)

fn mustIpv4(text: str): int64 =
    let res = purity.IpPurityParseIPv4(text)
    assert(IsOk(res), "ip purity smoke: parse ipv4")
    return Value(res)

fn buildDataset(): purity.IpPurityDataset =
    var prefixes: purity.IpPurityPrefixRecord[]
    add(prefixes, mustPrefix(purity.IpPurityMakeCidrPrefix(
        "67.103.0.0",
        16,
        20115,
        "US",
        700,
        300,
        250,
        12,
        "fixture:coarse-prefix",
        smokeHash("coarse-prefix")
    ), "ip purity smoke: coarse prefix"))
    add(prefixes, mustPrefix(purity.IpPurityMakeCidrPrefix(
        "67.103.168.0",
        21,
        20115,
        "US",
        875,
        125,
        0,
        -8,
        "fixture:residential-prefix",
        smokeHash("residential-prefix")
    ), "ip purity smoke: residential prefix"))
    add(prefixes, mustPrefix(purity.IpPurityMakeCidrPrefix(
        "203.0.113.0",
        24,
        64500,
        "US",
        200,
        800,
        650,
        22,
        "fixture:hosting-prefix",
        smokeHash("hosting-prefix")
    ), "ip purity smoke: hosting prefix"))

    var asns: purity.IpPurityAsnRecord[]
    add(asns, purity.IpPurityAsnRecord(
        asn: 20115,
        organization: "Charter Communications LLC",
        networkClass: purity.IpNetworkResidential,
        origin: purity.IpOriginNative,
        riskPrior: -6,
        source: "fixture:asn-residential",
        evidenceHash: smokeHash("asn-residential")
    ))
    add(asns, purity.IpPurityAsnRecord(
        asn: 64500,
        organization: "Example Hosting",
        networkClass: purity.IpNetworkHosting,
        origin: purity.IpOriginBroadcast,
        riskPrior: 20,
        source: "fixture:asn-hosting",
        evidenceHash: smokeHash("asn-hosting")
    ))

    var events: purity.IpPurityEventRecord[]
    add(events, purity.IpPurityEventRecord(
        scope: purity.IpEventScopeRange,
        startIpv4: mustIpv4("203.0.113.7"),
        stopIpv4: mustIpv4("203.0.113.7"),
        asn: 0,
        kind: purity.IpEventProxy,
        severity: 100,
        observedDay: 19720,
        source: "fixture:proxy-trap",
        evidenceHash: smokeHash("proxy-trap")
    ))
    add(events, purity.IpPurityEventRecord(
        scope: purity.IpEventScopeAsn,
        asn: 64500,
        kind: purity.IpEventHoneypot,
        severity: 90,
        observedDay: 19715,
        source: "fixture:honeypot",
        evidenceHash: smokeHash("honeypot")
    ))

    var raw: purity.IpPurityDataset
    raw.generatedDay = 19730
    raw.maxEventAgeDays = 180
    raw.eventHalfLifeDays = 30
    raw.sourceSnapshotHash = smokeHash("fixture sources: cidr+asn+events")
    raw.prefixes = prefixes
    raw.asns = asns
    raw.events = events
    let finalized = purity.IpPurityFinalizeDataset(raw)
    assert(IsOk(finalized), "ip purity smoke: finalize dataset")
    return Value(finalized)

fn assertCleanResidential(dataset: purity.IpPurityDataset) =
    let scoreRes = purity.IpPurityScoreIpText(dataset, "67.103.169.151", 20115, 19730)
    assert(IsOk(scoreRes), "ip purity smoke: score residential")
    let score = Value(scoreRes)
    assert(score.riskScore <= 5, "ip purity smoke: residential risk")
    assert(score.purityScore >= 95, "ip purity smoke: residential purity")
    assert(score.band == "extremely_clean", "ip purity smoke: residential band")
    assert(score.prefixEvidenceHash == smokeHash("residential-prefix"),
        "ip purity smoke: longest prefix wins")
    assert(len(score.reasonHash) == 64, "ip purity smoke: reason hash")

fn assertRiskyHosting(dataset: purity.IpPurityDataset) =
    let scoreRes = purity.IpPurityScoreIpText(dataset, "203.0.113.7", 64500, 19730)
    assert(IsOk(scoreRes), "ip purity smoke: score hosting")
    let score = Value(scoreRes)
    assert(score.riskScore >= 90, "ip purity smoke: hosting risk")
    assert(score.band == "high_risk", "ip purity smoke: hosting band")
    assert(score.facts.len > 8, "ip purity smoke: audit facts")

fn assertHardFailures(dataset: purity.IpPurityDataset) =
    let wrongAsn = purity.IpPurityScoreIpText(dataset, "67.103.169.151", 64500, 19730)
    assert(IsErr(wrongAsn), "ip purity smoke: asn mismatch hard fail")

    let ipv6 = purity.IpPurityScoreIpText(dataset, "2001:db8::1", 64500, 19730)
    assert(IsErr(ipv6), "ip purity smoke: ipv6 unsupported")

    let staleClock = purity.IpPurityScoreIpText(dataset, "67.103.169.151", 20115, 19700)
    assert(IsErr(staleClock), "ip purity smoke: stale score time")

    var drift = dataset
    var prefix0 = drift.prefixes[0]
    prefix0.riskPrior = 99
    drift.prefixes[0] = prefix0
    let driftRes = purity.IpPurityScoreIpText(drift, "67.103.169.151", 20115, 19730)
    assert(IsErr(driftRes), "ip purity smoke: dataset drift hard fail")

    var badRatio = dataset
    var badPrefix = badRatio.prefixes[0]
    badPrefix.humanPermille = 900
    badRatio.prefixes[0] = badPrefix
    badRatio.datasetHash = purity.IpPurityDatasetHash(badRatio)
    let badRatioRes = purity.IpPurityValidateDataset(badRatio)
    assert(IsErr(badRatioRes), "ip purity smoke: bad traffic ratio hard fail")

    var badCidr = dataset
    var cidrPrefix = badCidr.prefixes[0]
    cidrPrefix.stopIpv4 = cidrPrefix.stopIpv4 - int64(1)
    badCidr.prefixes[0] = cidrPrefix
    badCidr.datasetHash = purity.IpPurityDatasetHash(badCidr)
    let badCidrRes = purity.IpPurityValidateDataset(badCidr)
    assert(IsErr(badCidrRes), "ip purity smoke: cidr shape hard fail")

fn main(): int32 =
    let dataset = buildDataset()
    assertCleanResidential(dataset)
    assertRiskyHosting(dataset)
    assertHardFailures(dataset)
    echo("ip_purity_smoke ok")
    return 0
