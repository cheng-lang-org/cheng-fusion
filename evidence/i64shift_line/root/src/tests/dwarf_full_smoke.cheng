module dwarf_full_smoke

type Point =
    x: int32
    y: int32

fn empty(): int32 =
    return 0

fn identity(x: int32): int32 =
    return x

fn add_two(a: int32, b: int32): int32 =
    return a + b

fn sum_three(a: int32, b: int32, c: int32): int32 =
    return a + b + c

fn conditional_select(flag: bool, a: int32, b: int32): int32 =
    if flag:
        return a
    else:
        return b

fn negate_if(x: int32, neg: bool): int32 =
    if neg:
        return 0 - x
    else:
        return x

fn accumulate(n: int32): int32 =
    var sum: int32
    var i: int32
    while i < n:
        sum = sum + i
        i = i + 1
    return sum

fn make_point(x: int32, y: int32): Point =
    var p: Point
    p.x = x
    p.y = y
    return p

fn sum_point(p: Point): int32 =
    return p.x + p.y

fn call_chain_depth(value: int32): int32 =
    let a = add_two(value, 1)
    let b = sum_three(a, a, value)
    return b

fn main(): int32 =
    let r0 = empty()
    if r0 != 0:
        return r0
    if identity(42) != 42:
        return 1
    if add_two(10, 20) != 30:
        return 2
    if sum_three(5, 10, 15) != 30:
        return 3
    if conditional_select(true, 1, 2) != 1:
        return 4
    if conditional_select(false, 1, 2) != 2:
        return 5
    if negate_if(10, true) != -10:
        return 6
    if negate_if(10, false) != 10:
        return 7
    if accumulate(10) != 45:
        return 8
    let p = make_point(15, 25)
    if sum_point(p) != 40:
        return 9
    if call_chain_depth(7) != 23:
        return 10
    return 0

main()
