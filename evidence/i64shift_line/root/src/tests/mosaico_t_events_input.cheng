# tests for events queue + button debounce + output policy
import "src/mosaico/events.cheng" as events
import "src/mosaico/input.cheng" as input

# drive a press/release sequence through the machine in one loop
fn RunButtonSeq(inputs: var int32[16], count: int32): int32 =
    var st = input.BtnInitState()
    var downEdges = 0
    var upEdges = 0
    var i = 0
    while i < count:
        let v = inputs[i]
        let r = input.BtnStep(st, v)
        let edges = input.StepEdges(r)
        st = input.StepNextState(r)
        if edges & 2:
            downEdges = downEdges + 1
        if edges & 4:
            upEdges = upEdges + 1
        i = i + 1
    if st != input.StepNextState(input.BtnStep(input.BtnInitState(), 0)):
        # after full release sequence, state must equal the never-pressed state
        return -100
    return downEdges * 10 + upEdges

fn CaseQueueOrder(): int32 =
    var q: int32[events.EvCap]
    var n = 0
    n = events.EvPush(q, n, events.EvPack(events.EvButtonDown, 1, 2))
    n = events.EvPush(q, n, events.EvPack(events.EvShake, 3, 4))
    if n != 2:
        return 1
    if events.EvKind(events.EvPeek(q, n, 0)) != events.EvButtonDown:
        return 2
    if events.EvArg0(events.EvPeek(q, n, 1)) != 3:
        return 4
    if events.EvArg1(events.EvPeek(q, n, 1)) != 4:
        return 8
    return 0

fn CaseQueueOverflow(): int32 =
    var q: int32[events.EvCap]
    var i = 0
    while i < events.EvCap:
        let j = i
        q[j] = 100 + i
        i = i + 1
    var n = events.EvCap
    n = events.EvPush(q, n, 999)
    if n != events.EvCap:
        return 1
    if q[0] != 101:
        return 2
    if q[events.EvCap - 1] != 999:
        return 4
    return 0

fn CaseDropOldest(): int32 =
    var q: int32[events.EvCap]
    var n = 0
    n = events.EvPush(q, n, 7)
    n = events.EvPush(q, n, 9)
    n = events.EvDropOldest(q, n)
    if n != 1:
        return 1
    if events.EvPeek(q, n, 0) != 9:
        return 2
    return 0

fn main(): int32 =
    var fails = 0

    fails = fails | (CaseQueueOrder() << 0)
    fails = fails | (CaseQueueOverflow() << 4)
    fails = fails | (CaseDropOldest() << 8)

    # button: noisy bounce then stable low (pressed), then release
    var seq: int32[16]
    seq[0] = 1
    seq[1] = 1
    seq[2] = 1
    seq[3] = 1
    seq[4] = 1
    seq[5] = 1
    seq[6] = 0
    seq[7] = 0
    seq[8] = 0
    seq[9] = 0
    let br = RunButtonSeq(seq, 10)
    # exactly one down edge and one up edge expected
    if br != 11:
        fails = fails | (1 << 12)

    # LED active-low levels
    if input.LedLevelFor(1) != 0 or input.LedLevelFor(0) != 1:
        fails = fails | (1 << 13)
    # motor active-high
    if input.MotorLevelFor(1) != 1 or input.MotorLevelFor(0) != 0:
        fails = fails | (1 << 14)

    return fails
