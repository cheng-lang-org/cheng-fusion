import std/result
import std/strings
import std/net/transports/tcp_syscall as tcp

fn main(): int32 =
    echo("tcp_ipv6_loopback_addr_smoke start")
    let connRes: Result[tcp.TcpConnectionHandle] = tcp.TcpConnect6Timeout("::1", 9, 100)
    if IsErr(connRes):
        let err: str = ErrorText(connRes)
        if strings.StrContains(err, "(61)"):
            echo("tcp_ipv6_loopback_addr_smoke ok")
            return 0
        echo(err)
        return 1
    var conn: tcp.TcpConnectionHandle = Value(connRes)
    tcp.TcpClose(conn)
    echo("tcp_ipv6_loopback_addr_smoke ok")
    return 0
