import std/result
import cheng/std/bytes_layout as layout
import cheng/core/tooling/path as chengpath
import cheng/core/tooling/compiler_request as creq
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/lang/parser
import cheng/core/backend/system_link_plan as slplan

fn main(): int32 =
    let workspaceRoot = chengpath.PathCurrentDir()
    let packageRoot = workspaceRoot
    let currentSourcePath = chengpath.PathJoin(
        packageRoot,
        "src/tests/compiler_migration_fixture.cheng")
    let legacySourcePath = chengpath.PathJoin(
        packageRoot,
        "testdata/compiler_migration/compiler_migration_fixture_legacy.cheng")
    let req = creq.CompilerRequestNew(
        packageRoot,
        currentSourcePath,
        "/tmp/compiler_migration_cid_receipt_smoke",
        "arm64-apple-darwin",
        creq.EmitExe,
        "")
    var linkPlan: slplan.SystemLinkPlanStub
    var err: str
    assert(slplan.BuildSystemLinkPlanStub(
        workspaceRoot,
        req,
        linkPlan,
        err), err)
    let entryModulePath = parser.ParserSourcePathToModulePath(
        workspaceRoot,
        packageRoot,
        currentSourcePath)
    var migration: ccsg.CompilerLegacyMigration
    let migrationRes = ccsg.BuildCompilerLegacyMigrationInto(
        workspaceRoot,
        packageRoot,
        legacySourcePath,
        linkPlan.packageId,
        entryModulePath,
        migration)
    if IsErr(migrationRes):
        echo(Error(migrationRes))
        return 1
    assert(migration.unitCount > 0,
           " compiler migration cid receipt: source unit missing")
    assert(migration.migratedArtifact.sourceIdentityReceipt.sourceSnapshotCount ==
               migration.unitCount,
           " compiler migration cid receipt: source receipt count mismatch")
    assert(ccsg.PortableSourceIdentityReceiptStrictValidateInto(
               migration.migratedArtifact.sourceIdentityReceipt,
               err), err)
    assert(layout.FixedBytes32Equal(
               migration.migratedArtifact.sourceIdentityReceipt.sourceBundleCid,
               migration.migratedSourceBundleCid),
           " compiler migration cid receipt: migrated bundle binding mismatch")
    assert(!layout.FixedBytes32Equal(
               migration.migratedArtifact.canonicalGraphCid,
               layout.FixedBytes32()) &&
           migration.migratedArtifact.canonicalCsgReport != "",
           " compiler migration cid receipt: migrated artifact identity missing")
    var mutatedReceipt =
        migration.migratedArtifact.sourceIdentityReceipt
    mutatedReceipt.sourceSnapshotCount =
        mutatedReceipt.sourceSnapshotCount + 1
    assert(!ccsg.PortableSourceIdentityReceiptStrictValidateInto(
                mutatedReceipt,
                err),
           " compiler migration cid receipt: mutated source receipt accepted")
    echo(" compiler_migration_cid_receipt_smoke ok")
    return 0
