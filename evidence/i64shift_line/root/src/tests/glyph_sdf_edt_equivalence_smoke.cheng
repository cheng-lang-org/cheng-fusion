import cheng/core/runtime/web_scene_runtime as scene

# Differential oracle: the Meijster EDT path must reproduce the windowed
# brute-force SDF byte-for-byte (clamp branch included) on synthetic masks.

fn lcgNext(state: int32): int32 =
    var x = state * 1103515245 + 12345
    if x < 0:
        x = 0 - x
    return x

fn buildMask(kind: int32, cellSize: int32, seed: int32, mask: var int32[]) =
    let total = cellSize * cellSize
    if kind == 0:
        for _ in 0..<total:
            add(mask, 0)
        return
    if kind == 1:
        for _ in 0..<total:
            add(mask, 1)
        return
    if kind == 2:
        for i in 0..<total:
            if i == (cellSize / 2) * cellSize + cellSize / 2:
                add(mask, 1)
            else:
                add(mask, 0)
        return
    if kind == 3:
        # border-touching block in the top-left corner
        for y in 0..<cellSize:
            for x in 0..<cellSize:
                if x < cellSize / 3 && y < cellSize / 3:
                    add(mask, 1)
                else:
                    add(mask, 0)
        return
    # kind 4: deterministic pseudo-random blobs
    var st = seed
    for _ in 0..<total:
        st = lcgNext(st)
        if (st / 64) % 4 == 0:
            add(mask, 1)
        else:
            add(mask, 0)

fn edtPixel(mask: int32[], distToOutside: int32[], distToInside: int32[],
            px: int32, py: int32, cellSize: int32, pxRange: int32): int32 =
    let idx = py * cellSize + px
    let inside = mask[idx] != 0
    var bestSq: int32
    if inside:
        bestSq = distToOutside[idx]
        var border = px + 1
        if cellSize - px < border:
            border = cellSize - px
        if py + 1 < border:
            border = py + 1
        if cellSize - py < border:
            border = cellSize - py
        if border * border < bestSq:
            bestSq = border * border
    else:
        bestSq = distToInside[idx]
    return scene.WebSceneGlyphSdfPixelValueFromDistSq(inside, bestSq, pxRange)

fn checkCase(kind: int32, cellSize: int32, pxRange: int32, seed: int32): int32 =
    var mask: int32[]
    buildMask(kind, cellSize, seed, mask)
    let total = cellSize * cellSize
    var colG: int32[]
    var distToOutside: int32[]
    var distToInside: int32[]
    for _ in 0..<total:
        add(colG, 0)
        add(distToOutside, 0)
        add(distToInside, 0)
    scene.WebSceneGlyphSdfColumnDistance(mask, cellSize, 0, colG)
    scene.WebSceneGlyphSdfRowEnvelopeDistSq(colG, cellSize, distToOutside)
    scene.WebSceneGlyphSdfColumnDistance(mask, cellSize, 1, colG)
    scene.WebSceneGlyphSdfRowEnvelopeDistSq(colG, cellSize, distToInside)
    for py in 0..<cellSize:
        for px in 0..<cellSize:
            let want = scene.WebSceneGlyphSdfPixelValueFromMask(mask, px, py, cellSize, pxRange)
            let got = edtPixel(mask, distToOutside, distToInside, px, py, cellSize, pxRange)
            if want != got:
                return kind * 1000000 + py * 1000 + px
    return 0 - 1

fn main(): int32 =
    var failures = 0
    for kind in 0..<5:
        var caseIndex = 0
        while caseIndex < 3:
            let cellSize = 8 + caseIndex * 28
            let pxRange = 4 + caseIndex * 22
            let seed = 7919 + kind * 131 + caseIndex * 17
            let bad = checkCase(kind, cellSize, pxRange, seed)
            if bad >= 0:
                failures = failures + 1
            caseIndex = caseIndex + 1
    # full-scale production shape: cell 192 / pxRange 48 random blob
    let badFull = checkCase(4, 192, 48, 104729)
    if badFull >= 0:
        failures = failures + 1
    if failures != 0:
        return failures
    return 0
