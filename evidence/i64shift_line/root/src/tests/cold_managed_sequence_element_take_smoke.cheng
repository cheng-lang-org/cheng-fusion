module cold_managed_sequence_element_take_smoke

type
    ColdManagedSequenceItem =
        tag: int32
        values: int32[]

fn swap(items: var ColdManagedSequenceItem[]) =
    let swapped = items[1]
    items[1] = items[0]
    items[0] = swapped

fn main(): int32 =
    var first: ColdManagedSequenceItem
    first.tag = 1
    add(first.values, 11)
    var second: ColdManagedSequenceItem
    second.tag = 2
    add(second.values, 22)

    var items: ColdManagedSequenceItem[]
    add(items, first)
    add(items, second)
    swap(items)

    if items.len != 2 ||
       items[0].tag != 2 || items[0].values.len != 1 ||
       items[0].values[0] != 22 ||
       items[1].tag != 1 || items[1].values.len != 1 ||
       items[1].values[0] != 11:
        return 1
    echo("cold_managed_sequence_element_take=PASS")
    return 0
