# wave13-findPeerIndex repro: PeerInfo(peerinfo.cheng).pubKey: Option[PublicKey]
# reaches PublicKey's real declaration (crypto/types.cheng) via a 2-hop chain
# (peerinfo.cheng -> crypto/crypto.cheng -> crypto/types.cheng); crypto.cheng
# itself is not a pure forwarding shim (has KeyTypeRawPair type + fns), so the
# fix must not require the strict PureForwardingShim gate. Baseline (pre-fix):
# PrimaryBodyIrSourceObjectLayoutViaImports only 1-hop-scans peerinfo.cheng's
# own imports, misses PublicKey, cascades to PeerInfo/PeerStore layout failure,
# findPeerIndex lands bail=44 (confirmed via CHENG_PRIMARY_OBJECT_FAIL_TRACE=1:
# phase=source_object_layout_not_found type=PublicKey source=.../peerinfo.cheng).
#
# Field assignment is done statement-by-statement (not via newPeerInfo) and the
# store stays empty (findPeerIndex exercised on the empty-store fast path, no
# putPeer/array-element-copy) to keep this repro isolated from unrelated
# pre-existing bugs that are outside this fix's scope (all independently
# reproduce identically on both baseline and fixed driver -- confirmed
# pre-existing, not caused by this fix):
#   - newPeerInfo bail=801 (whole-body ctor form)
#   - setPublicKey bail=712 / Option[T].value nested-field-write bail=713
#   - initPeerStore()'s single-expr `PeerStore(count: 0)` ctor hits a separate
#     WordCount-predictor/emitter desync once PeerInfo's real (now non-poison,
#     much larger) size is used
#   - writing a PeerInfo into store.items[i] (array-of-large-struct element
#     copy) does not round-trip str field content correctly -- a distinct
#     realizer bug, also unrelated to layout *sizing*
#   - decodeBase58/toBytes has its own cross-string comparison bug
#
# This repro instead pins the layout-resolution fix itself, at both compile
# time and runtime, without depending on any of the above: PeerInfo/PeerStore/
# findPeerIndex cannot compile *at all* unless PublicKey's size resolves
# through the 2-hop chain (mutation test below flips COMPILE_RC 0->2), and the
# resolved PeerInfo/Option[PublicKey] layout must be byte-correct for a
# standalone (non-array) struct's own fields plus findPeerIndex's empty-store
# fast path.
import cheng/libp2p/peerstore
import cheng/libp2p/peerinfo
import cheng/libp2p/peerid
import cheng/libp2p/crypto/crypto
import cheng/libp2p/utils/multiaddrlist
import std/stringlist

fn main(): int32 =
    var store: PeerStore
    let id1: PeerId = peerIdFromTextUnchecked("peerone")
    let emptyIdxRes = findPeerIndex(store, id1)
    if IsErr(emptyIdxRes):
        return 10
    if Value(emptyIdxRes) != -1:
        return 11
    var info1: PeerInfo
    info1.id = id1
    info1.addrs = initMultiAddressList()
    info1.protocols = InitStringList()
    if info1.id != id1:
        return 12
    if IsSome(info1.pubKey):
        return 13
    return 0
