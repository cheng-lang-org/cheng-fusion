import std/result
import std/media_platform as platform

fn main(): int32 =
    let probeRes = platform.MediaPlatformDarwinProbeStrict()
    assert(IsOk(probeRes), Error(probeRes))
    let probe = Value(probeRes)
    assert(probe.schema == platform.MediaPlatformProbeSchema,
        " media darwin platform provider: schema")
    assert(probe.platform == platform.MediaPlatformDarwin,
        " media darwin platform provider: platform")
    assert(probe.capabilityMask == platform.MediaPlatformDarwinRequiredCapabilityMask,
        " media darwin platform provider: required mask")
    assert(probe.videoToolboxReady,
        " media darwin platform provider: VideoToolbox")
    assert(probe.coreVideoReady,
        " media darwin platform provider: CoreVideo")
    assert(probe.metalReady,
        " media darwin platform provider: Metal")
    assert(probe.quartzCoreReady,
        " media darwin platform provider: QuartzCore")
    assert(probe.h264HardwareDecodeSupported,
        " media darwin platform provider: H264 hardware decode")
    assert(probe.decodeProviderReady,
        " media darwin platform provider: decode provider")
    assert(probe.textureProviderReady,
        " media darwin platform provider: texture provider")
    assert(probe.decodeProvider == platform.MediaPlatformDarwinVideoToolboxProvider,
        " media darwin platform provider: decode provider name")
    assert(probe.textureProvider == platform.MediaPlatformDarwinMetalTextureProvider,
        " media darwin platform provider: texture provider name")
    assert(probe.errorCode == 0,
        " media darwin platform provider: error code")
    assert(probe.trace == "dlopen->dlsym->capability-mask",
        " media darwin platform provider: trace")
    echo(" media_darwin_platform_provider_smoke ok")
    return 0
