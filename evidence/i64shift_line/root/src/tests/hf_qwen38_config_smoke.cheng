import std/result
import std/strings
import std/strutils as strutil
import std/math as m
import cheng/inference/hf_qwen38_graph as hfq
import cheng/inference/kernel_ir as kir
import cheng/inference/model_graph as mg

// Real Qwen/Qwen3.8-27B config.json (fetched from
// https://huggingface.co/Qwen/Qwen3.8-27B/raw/main/config.json on 2026-08-22).
// Every scalar below is the untouched real value; nothing is invented. W1
// covers text_config only -- vision_config rides along verbatim but is not
// parsed yet. The 64 layer_types entries follow the real interleaving
// (3x linear_attention + 1x full_attention, repeated 16 times).
fn qwen38VisionConfigChunk(): str =
    return strutil.Join([
        "\"vision_config\":{",
        "\"deepstack_visual_indexes\":[],",
        "\"depth\":27,",
        "\"hidden_act\":\"gelu_pytorch_tanh\",",
        "\"hidden_size\":1152,",
        "\"in_channels\":3,",
        "\"initializer_range\":0.02,",
        "\"intermediate_size\":4304,",
        "\"model_type\":\"qwen3_5\",",
        "\"num_heads\":16,",
        "\"num_position_embeddings\":2304,",
        "\"out_hidden_size\":5120,",
        "\"patch_size\":16,",
        "\"spatial_merge_size\":2,",
        "\"temporal_patch_size\":2",
        "},"
    ], "")

// layerTypeMode: 0 = real linear/full interleaving, 1 = corrupt every entry
// with an unknown layer type word.
fn qwen38ConfigJsonBuilt(modelType: str,
                         layerCount: int32,
                         interval: int32,
                         layerTypeMode: int32,
                         vocabSize: int32,
                         includeMtp: bool): str =
    var layerItems: str[]
    for i in 0..<layerCount:
        var word = "linear_attention"
        if (i + 1) % 4 == 0:
            word = "full_attention"
        if layerTypeMode != 0:
            word = "sparse_attention"
        add(layerItems, strutil.Join(["\"", share(word), "\""], ""))
    var mtpChunk = ""
    if includeMtp:
        mtpChunk = "\"mtp_num_hidden_layers\":1,\"mtp_use_dedicated_embeddings\":false,"
    return strutil.Join([
        "{",
        "\"architectures\":[\"Qwen3_5ForConditionalGeneration\"],",
        "\"image_token_id\":248056,",
        "\"language_model_only\":false,",
        strutil.Join(["\"model_type\":\"", share(modelType), "\","], ""),
        "\"text_config\":{",
        "\"attention_bias\":false,",
        "\"attention_dropout\":0.0,",
        "\"attn_output_gate\":true,",
        "\"bos_token_id\":248044,",
        "\"dtype\":\"bfloat16\",",
        "\"eos_token_id\":248044,",
        strutil.Join(["\"full_attention_interval\":", strings.IntToStr(interval), ","], ""),
        "\"head_dim\":256,",
        "\"hidden_act\":\"silu\",",
        "\"hidden_size\":5120,",
        "\"initializer_range\":0.02,",
        "\"intermediate_size\":17408,",
        "\"layer_types\":[", strutil.Join(layerItems, ","), "],",
        "\"linear_conv_kernel_dim\":4,",
        "\"linear_key_head_dim\":128,",
        "\"linear_num_key_heads\":16,",
        "\"linear_num_value_heads\":48,",
        "\"linear_value_head_dim\":128,",
        "\"mamba_ssm_dtype\":\"float32\",",
        "\"max_position_embeddings\":262144,",
        "\"model_type\":\"qwen3_5_text\",",
        share(mtpChunk),
        "\"num_attention_heads\":24,",
        strutil.Join(["\"num_hidden_layers\":", strings.IntToStr(layerCount), ","], ""),
        "\"num_key_value_heads\":4,",
        "\"output_gate_type\":\"swish\",",
        "\"pad_token_id\":null,",
        "\"partial_rotary_factor\":0.25,",
        "\"rms_norm_eps\":1e-06,",
        "\"rope_parameters\":{\"mrope_interleaved\":true,\"mrope_section\":[11,11,10],\"partial_rotary_factor\":0.25,\"rope_theta\":10000000,\"rope_type\":\"default\"},",
        "\"tie_word_embeddings\":false,",
        "\"use_cache\":true,",
        strutil.Join(["\"vocab_size\":", strings.IntToStr(vocabSize), ","], ""),
        "\"transformers_version\":\"5.8.0.dev0\",",
        "\"video_token_id\":248057,",
        qwen38VisionConfigChunk(),
        "\"vision_end_token_id\":248054,",
        "\"vision_start_token_id\":248053",
        "}"
    ], "")

fn qwen38ConfigJson(): str =
    return qwen38ConfigJsonBuilt("qwen3_5", 64, 4, 0, 248320, true)

@borrows
fn countOpKind(graph: mg.ModelGraph, opKind: str): int32 =
    var count: int32 = 0
    for i in 0..<graph.ops.len:
        if graph.ops[i].opKind == opKind:
            count = count + 1
    return count

@borrows
fn requireWeight(graph: mg.ModelGraph, tensorName: str): mg.ModelWeightShard =
    var idx: int32 = -1
    for i in 0..<graph.weights.len:
        if graph.weights[i].tensorName == tensorName:
            idx = i
            break
    assert(idx >= 0, strutil.Join([" hf qwen38 config smoke: missing weight ", strings.CloneStr(tensorName)], ""))
    return graph.weights[idx]

@borrows
fn factsContain(facts: str[], line: str): bool =
    for i in 0..<facts.len:
        if facts[i] == line:
            return true
    return false

fn main(): int32 =
    let configJson = qwen38ConfigJson()

    // 1. field-by-field text_config parse against the real Qwen3.8-27B values.
    let cfgRes = hfq.HfQwen38TextConfigFromConfig(share(configJson))
    assert(IsOk(cfgRes), " hf qwen38 config smoke: parse qwen3.8-27b config")
    let cfg = Value(cfgRes)
    assert(cfg.modelType == "qwen3_5_text", " hf qwen38 config smoke: text model_type")
    assert(cfg.hiddenSize == 5120, " hf qwen38 config smoke: hidden_size")
    assert(cfg.intermediateSize == 17408, " hf qwen38 config smoke: intermediate_size")
    assert(cfg.layerCount == 64, " hf qwen38 config smoke: num_hidden_layers")
    assert(cfg.attentionHeads == 24, " hf qwen38 config smoke: num_attention_heads")
    assert(cfg.keyValueHeads == 4, " hf qwen38 config smoke: num_key_value_heads")
    assert(cfg.headDim == 256, " hf qwen38 config smoke: head_dim")
    assert(cfg.fullAttentionInterval == 4, " hf qwen38 config smoke: full_attention_interval")
    assert(cfg.layerTypeCodes.len == 64, " hf qwen38 config smoke: layer_types length")
    var fullCount: int32 = 0
    for i in 0..<cfg.layerTypeCodes.len:
        if cfg.layerTypeCodes[i] == 1:
            fullCount = fullCount + 1
    assert(fullCount == 16, " hf qwen38 config smoke: full layer count")
    assert(cfg.layerTypeCodes[0] == 0 && cfg.layerTypeCodes[2] == 0,
           " hf qwen38 config smoke: leading linear layers")
    assert(cfg.layerTypeCodes[3] == 1 && cfg.layerTypeCodes[7] == 1 && cfg.layerTypeCodes[63] == 1,
           " hf qwen38 config smoke: full layers at every 4th slot")
    assert(cfg.layerTypeCodes[62] == 0, " hf qwen38 config smoke: pre-tail linear layer")
    assert(cfg.linearNumKeyHeads == 16, " hf qwen38 config smoke: linear_num_key_heads")
    assert(cfg.linearNumValueHeads == 48, " hf qwen38 config smoke: linear_num_value_heads")
    assert(cfg.linearKeyHeadDim == 128, " hf qwen38 config smoke: linear_key_head_dim")
    assert(cfg.linearValueHeadDim == 128, " hf qwen38 config smoke: linear_value_head_dim")
    assert(cfg.linearConvKernelDim == 4, " hf qwen38 config smoke: linear_conv_kernel_dim")
    assert(cfg.mtpNumHiddenLayers == 1, " hf qwen38 config smoke: mtp_num_hidden_layers")
    assert(!cfg.mtpUseDedicatedEmbeddings, " hf qwen38 config smoke: mtp_use_dedicated_embeddings")
    assert(cfg.vocabSize == 248320, " hf qwen38 config smoke: vocab_size")
    assert(cfg.maxPositionEmbeddings == 262144, " hf qwen38 config smoke: max_position_embeddings")
    assert(m.ApproxEq(cfg.rmsNormEps, 0.000001, 0.000000001), " hf qwen38 config smoke: rms_norm_eps")
    assert(m.ApproxEq(cfg.ropeTheta, 10000000.0, 0.001), " hf qwen38 config smoke: rope_theta")
    assert(cfg.ropeType == "default", " hf qwen38 config smoke: rope_type")
    assert(m.ApproxEq(cfg.partialRotaryFactor, 0.25, 0.000001), " hf qwen38 config smoke: partial_rotary_factor")
    assert(cfg.mropeInterleaved, " hf qwen38 config smoke: mrope_interleaved")
    assert(cfg.mropeSection.len == 3 && cfg.mropeSection[0] == 11 && cfg.mropeSection[1] == 11 && cfg.mropeSection[2] == 10,
           " hf qwen38 config smoke: mrope_section")
    assert(!cfg.attentionBias, " hf qwen38 config smoke: attention_bias")
    assert(cfg.attnOutputGate, " hf qwen38 config smoke: attn_output_gate")
    assert(cfg.outputGateType == "swish", " hf qwen38 config smoke: output_gate_type")
    assert(!cfg.tieWordEmbeddings, " hf qwen38 config smoke: tie_word_embeddings")
    assert(cfg.dtype == "bfloat16", " hf qwen38 config smoke: dtype")

    // 2. deploy profile + hash + validate.
    let profileRes = hfq.HfQwen38DeployProfileFromConfig(hfq.HfQwen38RepoId, share(configJson))
    assert(IsOk(profileRes), " hf qwen38 config smoke: build deploy profile")
    let profile = Value(profileRes)
    assert(profile.schema == "cheng.inference.hf_qwen38_deploy_profile.v1", " hf qwen38 config smoke: profile schema")
    assert(profile.architecture == "Qwen3_5ForConditionalGeneration", " hf qwen38 config smoke: profile architecture")
    assert(profile.profileHash != int64(0) && profile.sourceConfigHash != int64(0),
           " hf qwen38 config smoke: profile hashes")
    assert(IsOk(hfq.HfQwen38ValidateProfile(profile)), " hf qwen38 config smoke: validate profile")
    assert(IsErr(hfq.HfQwen38DeployProfileFromConfig("Qwen/Other", share(configJson))),
           " hf qwen38 config smoke: wrong repo id hard fail")

    // 3. graph build: hybrid inventory (16 full + 48 GDN + MTP) and shapes.
    let graphRes = hfq.HfQwen38GraphBuildFromProfile(share(profile), "cid:model:qwen3.8-27b-w1-smoke")
    assert(IsOk(graphRes), " hf qwen38 config smoke: build model graph")
    let graph = Value(graphRes)
    assert(graph.architecture == mg.InferenceModelArchitectureHfQwen38HybridMtp, " hf qwen38 config smoke: graph architecture")
    assert(graph.hiddenSize == 5120 && graph.attentionHeads == 24 &&
           graph.keyValueHeads == 4 && graph.headDim == 256 && graph.layerCount == 64,
           " hf qwen38 config smoke: graph dimensions")
    assert(graph.mtpLayerCount == 1 && graph.mtpStartLayer == 64,
           " hf qwen38 config smoke: graph mtp fields")
    assert(m.ApproxEq(graph.ropeTheta, 10000000.0, 0.001), " hf qwen38 config smoke: graph rope_theta")
    assert(graph.weights.len == 628 && graph.ops.len == 468,
           " hf qwen38 config smoke: graph inventory")
    assert(countOpKind(graph, mg.InferenceModelOpEmbedding) == 1, " hf qwen38 config smoke: embedding op count")
    assert(countOpKind(graph, mg.InferenceModelOpRmsNorm) == 129, " hf qwen38 config smoke: rmsnorm op count")
    assert(countOpKind(graph, mg.InferenceModelOpQkv) == 16, " hf qwen38 config smoke: qkv op count")
    assert(countOpKind(graph, mg.InferenceModelOpRope) == 16, " hf qwen38 config smoke: rope op count")
    assert(countOpKind(graph, mg.InferenceModelOpAttention) == 16, " hf qwen38 config smoke: attention op count")
    assert(countOpKind(graph, hfq.HfQwen38OpGdnConv) == 48, " hf qwen38 config smoke: gdn_conv op count")
    assert(countOpKind(graph, hfq.HfQwen38OpGdnDelta) == 48, " hf qwen38 config smoke: gdn_delta op count")
    assert(countOpKind(graph, mg.InferenceModelOpMlp) == 64, " hf qwen38 config smoke: mlp op count")
    assert(countOpKind(graph, mg.InferenceModelOpResidualAdd) == 128, " hf qwen38 config smoke: residual op count")
    assert(countOpKind(graph, mg.InferenceModelOpMtpProject) == 1, " hf qwen38 config smoke: mtp op count")
    assert(countOpKind(graph, mg.InferenceModelOpLmHead) == 1, " hf qwen38 config smoke: lm_head op count")
    let embed = requireWeight(graph, "model.embed_tokens.weight")
    assert(embed.shape.len == 2 && embed.shape[0] == 248320 && embed.shape[1] == 5120,
           " hf qwen38 config smoke: embedding shape")
    assert(embed.dtype == kir.KernelDtypeBf16, " hf qwen38 config smoke: bf16 weight dtype")
    let qProj = requireWeight(graph, "model.layers.3.self_attn.q_proj.weight")
    assert(qProj.shape[0] == 6144 && qProj.shape[1] == 5120,
           " hf qwen38 config smoke: full-layer q_proj shape (heads*head_dim)")
    let kProj = requireWeight(graph, "model.layers.3.self_attn.k_proj.weight")
    assert(kProj.shape[0] == 1024 && kProj.shape[1] == 5120,
           " hf qwen38 config smoke: full-layer k_proj shape (kv_heads*head_dim)")
    let inProj = requireWeight(graph, "model.layers.0.linear_attn.in_proj_qkvz.weight")
    assert(inProj.shape[0] == 16384 && inProj.shape[1] == 5120,
           " hf qwen38 config smoke: gdn in_proj shape (2*qk + 2*v rows)")
    let conv1d = requireWeight(graph, "model.layers.0.linear_attn.conv1d.weight")
    assert(conv1d.shape.len == 3 && conv1d.shape[0] == 10240 && conv1d.shape[1] == 1 && conv1d.shape[2] == 4,
           " hf qwen38 config smoke: gdn conv1d shape")
    let outProj = requireWeight(graph, "model.layers.0.linear_attn.out_proj.weight")
    assert(outProj.shape[0] == 5120 && outProj.shape[1] == 6144,
           " hf qwen38 config smoke: gdn out_proj shape")
    let downProj = requireWeight(graph, "model.layers.63.mlp.down_proj.weight")
    assert(downProj.shape[0] == 5120 && downProj.shape[1] == 17408,
           " hf qwen38 config smoke: last-layer down_proj shape")
    let mtpEh = requireWeight(graph, "model.mtp.eh_proj.weight")
    assert(mtpEh.shape[0] == 5120 && mtpEh.shape[1] == 10240,
           " hf qwen38 config smoke: mtp eh_proj shape")
    let lmHead = requireWeight(graph, "lm_head.weight")
    assert(lmHead.shape[0] == 248320 && lmHead.shape[1] == 5120,
           " hf qwen38 config smoke: untied lm_head shape")

    // 4. shared ModelGraphValidate accepts the registered hybrid architecture;
    //    single-gate tampering (rehashed so the specific gate fires, not the
    //    hash check) is rejected with its exact message. Struct copy moves in
    //    cheng, so `probe` takes over `graph` here and every later read goes
    //    through the restored probe.
    assert(IsOk(mg.ModelGraphValidate(graph)),
           " hf qwen38 config smoke: validate model graph")
    var probe = graph
    probe.layerCount = 63
    probe.graphHash = mg.ModelGraphHash(probe)
    let badLayersRes = mg.ModelGraphValidate(probe)
    assert(IsErr(badLayersRes) && Error(badLayersRes) == "model graph: qwen38 layer count",
           " hf qwen38 config smoke: tampered layer count rejected")
    probe.layerCount = 64
    probe.keyValueHeads = 5
    probe.graphHash = mg.ModelGraphHash(probe)
    let badKvRes = mg.ModelGraphValidate(probe)
    // kv=5 also breaks 24 % kv divisibility, so the grouped-kv gate fires first.
    assert(IsErr(badKvRes) && Error(badKvRes) == "model graph: qwen38 grouped kv divisibility",
           " hf qwen38 config smoke: tampered kv heads rejected")
    probe.keyValueHeads = 6
    probe.graphHash = mg.ModelGraphHash(probe)
    let badKvPinRes = mg.ModelGraphValidate(probe)
    assert(IsErr(badKvPinRes) && Error(badKvPinRes) == "model graph: qwen38 kv heads",
           " hf qwen38 config smoke: non-pinned kv heads rejected")
    probe.keyValueHeads = 4
    probe.mtpLayerCount = 0
    probe.graphHash = mg.ModelGraphHash(probe)
    let badMtpRes = mg.ModelGraphValidate(probe)
    assert(IsErr(badMtpRes) && Error(badMtpRes) == "model graph: qwen38 mtp layers",
           " hf qwen38 config smoke: tampered mtp layers rejected")
    // dense MoE-free allowance: expert/topk 0 stays valid for this architecture.
    probe.mtpLayerCount = 1
    probe.expertCount = 0
    probe.topK = 0
    probe.graphHash = mg.ModelGraphHash(probe)
    assert(IsOk(mg.ModelGraphValidate(probe)),
           " hf qwen38 config smoke: moe-free expert/topk allowed")
    // 4b. inventory facts for the hybrid architecture, read off the restored
    //     probe (facts consumes its by-value argument, so it is last).
    probe.expertCount = 1
    probe.topK = 1
    probe.graphHash = mg.ModelGraphHash(probe)
    let facts = mg.ModelGraphFacts(probe)
    assert(factsContain(facts, "qwen38_full_layers=16") &&
           factsContain(facts, "qwen38_linear_layers=48") &&
           factsContain(facts, "qwen38_full_interval=4") &&
           factsContain(facts, "qwen38_mtp_layers=1") &&
           factsContain(facts, "qwen38_partial_rotary=0.25"),
           " hf qwen38 config smoke: qwen38 inventory facts")

    // 5. dishonest/malformed configs are rejected, not guessed around.
    assert(IsErr(hfq.HfQwen38TextConfigFromConfig(
               qwen38ConfigJsonBuilt("qwen3", 64, 4, 0, 248320, true))),
           " hf qwen38 config smoke: wrong model_type hard fail")
    assert(IsErr(hfq.HfQwen38TextConfigFromConfig(
               qwen38ConfigJsonBuilt("qwen3_5", 63, 4, 0, 248320, true))),
           " hf qwen38 config smoke: wrong layer count hard fail")
    assert(IsErr(hfq.HfQwen38TextConfigFromConfig(
               qwen38ConfigJsonBuilt("qwen3_5", 64, 5, 0, 248320, true))),
           " hf qwen38 config smoke: wrong full attention interval hard fail")
    assert(IsErr(hfq.HfQwen38TextConfigFromConfig(
               qwen38ConfigJsonBuilt("qwen3_5", 64, 4, 1, 248320, true))),
           " hf qwen38 config smoke: unknown layer_types value hard fail")
    assert(IsErr(hfq.HfQwen38TextConfigFromConfig(
               qwen38ConfigJsonBuilt("qwen3_5", 64, 4, 0, 248320, false))),
           " hf qwen38 config smoke: missing mtp field hard fail")
    assert(IsErr(hfq.HfQwen38TextConfigFromConfig(
               qwen38ConfigJsonBuilt("qwen3_5", 64, 4, 0, 0, true))),
           " hf qwen38 config smoke: zero vocab hard fail")
    assert(IsErr(hfq.HfQwen38TextConfigFromConfig("")),
           " hf qwen38 config smoke: empty json hard fail")
    assert(IsErr(hfq.HfQwen38GraphBuildFromProfile(share(profile), "")),
           " hf qwen38 config smoke: empty model cid hard fail")

    echo(" hf_qwen38_config_smoke ok")
    return 0
