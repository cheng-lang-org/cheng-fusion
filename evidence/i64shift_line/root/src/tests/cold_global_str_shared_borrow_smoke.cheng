import std/strformat
import std/os
import cheng/core/tooling/path as chengpath

var coldGlobalStrSharedBorrowRoot: str

fn coldGlobalStrSharedBorrowPath(lane: str): str =
    return chengpath.PathJoin(
        coldGlobalStrSharedBorrowRoot,
        Fmt"stages/{lane}.production-object.bin")

fn main(): int32 =
    let path = coldGlobalStrSharedBorrowPath("primary")
    if path != "stages/primary.production-object.bin":
        panic("cold global str shared borrow: path mismatch")
    os.WriteLine(os.GetStdout(), "cold_global_str_shared_borrow=PASS")
    return 0
