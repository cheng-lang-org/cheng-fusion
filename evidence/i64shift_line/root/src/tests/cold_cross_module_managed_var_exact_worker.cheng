import cheng/tests/cold_cross_module_managed_var_exact_support

@borrows
fn copyRecords(
        records:
            cold_cross_module_managed_var_exact_support.CrossModuleManagedVarRecord[],
        out: var
            cold_cross_module_managed_var_exact_support.CrossModuleManagedVarRecord[]):
        int32 =
    out = []
    for i in 0..<records.len:
        var next: cold_cross_module_managed_var_exact_support.CrossModuleManagedVarRecord
        next.value = records[i].value
        add(out, next)
    return out.len

@borrows
fn CopyCrossModuleManagedVarRecords(
        records:
            cold_cross_module_managed_var_exact_support.CrossModuleManagedVarRecord[],
        out: var
            cold_cross_module_managed_var_exact_support.CrossModuleManagedVarRecord[]):
        int32 =
    return copyRecords(records, out)
