import std/system as system

# D4 rebind probe: owned local rebound each iteration inside a loop.
# Per iteration MakeThree() mallocs ONE fresh buffer (3 straight adds:
# grow 0->4 old=NULL, adds 2-3 fit cap). If the rebind releases the prior
# value at the bind point -> ~0 retained across 400 rounds.
# If the rebind leaks -> ~+1 block per round.

var probeSink: int32

fn MakeThree(seed: int32): int32[] =
    var out: int32[]
    add(out, seed)
    add(out, seed + 1)
    add(out, seed + 2)
    return out

fn RepeatRebind(rounds: int32): int32 =
    var s: int32[]
    var r: int32
    while r < rounds:
        s = MakeThree(r)
        r = r + 1
    return s.len

fn main(): int32 =
    let before = system.MemLiveAllocations()
    let observed = RepeatRebind(400)
    let delta = system.MemLiveAllocations() - before
    probeSink = observed
    if observed <= 0:
        return 99
    if delta <= 0:
        return 0
    if delta > 63:
        return 63
    return int32(delta)
