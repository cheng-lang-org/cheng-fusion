type
    R21Entry =
        profileIndex: int32
        items: str[]

fn R21Append(out: var str[], name: str) =
    add(out, name)

fn R21Names(cache: var R21Entry[], profileIndex: int32): str[] =
    var out: str[]
    if profileIndex < 0:
        return out
    R21Append(out, "alpha")
    var entry: R21Entry
    entry.profileIndex = profileIndex
    entry.items = out
    add(cache, entry)
    return out

fn main(): int32 =
    var cache: R21Entry[]
    let names = R21Names(cache, 0)
    if names.len != 1:
        return 10
    echo("r21 a ok")
    return 0
