import std/os as os
import std/rawbytes
import std/strformat
import std/strings
import cheng/std/strings as strutils
import cheng/std/bytes_layout as layout
import cheng/core/csg_core/compiler_snapshot_cargo as cargo
import cheng/core/csg_core/compiler_snapshot_schema as snapshot_schema
import cheng/core/csg_core/csgc
import cheng/core/csg_core/merkle_manifest
import cheng/core/csg_core/merkle_store
import cheng/core/csg_core/merkle_store_codec as merkle_codec
import cheng/core/csg_core/merkle_transaction
import cheng/core/tooling/compiler_snapshot_lowering_bridge as bridge
import cheng/tests/csg_compiler_snapshot_schema_smoke as schema_smoke

@borrows
fn fail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

@borrows
fn envelopeMutationRejected(
        manifest: merkle_manifest.CsgCoreMerkleManifest,
        lines: str[]): bool =
    var expectedKinds: str[]
    if merkle_manifest.csgManifestCompilerSnapshotEnvelopeExpectedKindsInto(
           manifest, lines, expectedKinds):
        return false
    var encoded = csgc.CsgCoreCsgcEncodeCanonicalLines(lines)
    if !encoded.ok:
        return true
    let fullError =
        merkle_manifest.CsgCoreMerkleManifestCanonicalCsgcError(
            manifest, encoded.bytes)
    rawbytes.BytesFree(encoded.bytes)
    return fullError.len > 0

@borrows
fn mutatedCidText(value: str): str =
    if !merkle_codec.CsgCoreMerkleStoreCidValid(value):
        return ""
    let replacement = value[7] == '0' ? '1' : '0'
    return strings.ConcatStr(
        strings.ConcatStr(
            strings.CloneStrRange(value, 0, 7),
            strings.CharToStr(replacement)),
        strings.CloneStrRange(value, 8, value.len - 8))

@borrows
fn cargoMutationRejected(
        parentPath: str,
        snapshot: snapshot_schema.CsgCompilerSnapshotTables,
        mutationKind: int32): bool =
    var attacked = cargo.CsgCompilerSnapshotCargoBuild(snapshot)
    if !attacked.ok:
        cargo.CsgCompilerSnapshotCargoRelease(attacked)
        return false
    if mutationKind == 1:
        let last = rawbytes.BytesLen(attacked.csgcBytes) - 1
        if last < 0:
            cargo.CsgCompilerSnapshotCargoRelease(attacked)
            return false
        rawbytes.BytesSet(
            attacked.csgcBytes,
            last,
            rawbytes.BytesGet(attacked.csgcBytes, last) ^ 1)
    elif mutationKind == 2:
        var mutatedCargoCid = attacked.cargoCid
        mutatedCargoCid.data[0] = uint8(
            (int32(mutatedCargoCid.data[0]) & 255) ^ 1)
        attacked.cargoCid = mutatedCargoCid
    elif mutationKind == 3:
        attacked.factsRoot = mutatedCidText(attacked.factsRoot)
    elif mutationKind == 4:
        var mutatedProofRoots = attacked.proofRoots
        var mutatedParserRoot = mutatedProofRoots.parserRootCid
        mutatedParserRoot.data[0] = uint8(
            (int32(mutatedParserRoot.data[0]) & 255) ^ 1)
        mutatedProofRoots.parserRootCid = mutatedParserRoot
        attacked.proofRoots = mutatedProofRoots
    else:
        cargo.CsgCompilerSnapshotCargoRelease(attacked)
        return false
    var rejected: bridge.CsgCompilerSnapshotImmutableCargoStoreBinding
    var err: str
    let accepted =
        bridge.CsgCompilerSnapshotImmutableCargoStoreEnsureInto(
            parentPath, attacked, rejected, err)
    let rejectedExactly = !accepted && err.len > 0
    bridge.CsgCompilerSnapshotImmutableCargoStoreBindingRelease(rejected)
    cargo.CsgCompilerSnapshotCargoRelease(attacked)
    return rejectedExactly

@borrows
fn legacyBootstrap(parentPath: str): int32 =
    var snapshot = schema_smoke.BuildSnapshot()
    var snapshotCargo = cargo.CsgCompilerSnapshotCargoBuild(snapshot)
    if !snapshotCargo.ok:
        return fail(snapshotCargo.error)
    var transaction: cargo.CsgCompilerSnapshotMerkleTransaction
    var err: str
    if !bridge.compilerSnapshotLoweringBridgeMerkleBootstrapInto(
           parentPath, snapshotCargo, transaction, err) ||
       !transaction.ok || !transaction.productionApplied ||
       transaction.reused:
        cargo.CsgCompilerSnapshotMerkleTransactionRelease(transaction)
        cargo.CsgCompilerSnapshotCargoRelease(snapshotCargo)
        return fail(err.len > 0 ? err :
            "compiler snapshot legacy bootstrap rejected")
    let headCid = strings.CloneStr(transaction.headCid)
    cargo.CsgCompilerSnapshotMerkleTransactionRelease(transaction)
    cargo.CsgCompilerSnapshotCargoRelease(snapshotCargo)
    os.WriteLine(
        os.Get_stdout(),
        Fmt"compiler_snapshot_legacy_bootstrap_ok head={headCid}")
    return 0

@borrows
fn staleWorker(parentPath: str): int32 =
    let expectedHead = os.GetEnv(
        "CSG_COMPILER_SNAPSHOT_ENVELOPE_EXPECTED_HEAD")
    let previousReceipt = os.GetEnv(
        "CSG_COMPILER_SNAPSHOT_ENVELOPE_PREVIOUS_RECEIPT")
    let workerVariant = os.GetEnv(
        "CSG_COMPILER_SNAPSHOT_ENVELOPE_WORKER_VARIANT")
    if !merkle_codec.CsgCoreMerkleStoreCidValid(expectedHead) ||
       !merkle_codec.CsgCoreMerkleStoreCidValid(previousReceipt) ||
       (workerVariant != "a" && workerVariant != "b" &&
        workerVariant != "c"):
        return fail("compiler snapshot stale worker input invalid")
    var snapshot = schema_smoke.BuildSnapshot()
    var snapshotCargo = cargo.CsgCompilerSnapshotCargoBuild(snapshot)
    if !snapshotCargo.ok:
        return fail(snapshotCargo.error)
    var cargoStore: bridge.CsgCompilerSnapshotImmutableCargoStoreBinding
    var err: str
    if !bridge.CsgCompilerSnapshotImmutableCargoStoreEnsureInto(
           parentPath, snapshotCargo, cargoStore, err) ||
       !cargoStore.reused:
        return fail(err.len > 0 ? err :
            "compiler snapshot stale worker Cargo rejected")
    var migration: bridge.CsgCompilerSnapshotLegacyMigrationInput
    let sourceBundleCid = snapshotCargo.proofRoots.dependencyRootCid
    let sourceIdentityReceiptCid =
        snapshotCargo.proofRoots.readSetRootCid
    if !bridge.CsgCompilerSnapshotLegacyMigrationInputInto(
           parentPath,
           cargoStore.storeIdentityCid,
           sourceBundleCid,
           sourceIdentityReceiptCid,
           migration,
           err) ||
       !migration.freshOrigin:
        return fail(err.len > 0 ? err :
            "compiler snapshot stale worker origin rejected")
    var binding: cargo.CsgCompilerSnapshotEnvelopeBinding
    var executionCid = snapshotCargo.proofRoots.typeRootCid
    if workerVariant == "b":
        let firstByte = Int32(executionCid.data[0]) & 255
        executionCid.data[0] = uint8((firstByte + 1) & 255)
    elif workerVariant == "c":
        let firstByte = Int32(executionCid.data[0]) & 255
        executionCid.data[0] = uint8((firstByte + 2) & 255)
    if !bridge.compilerSnapshotLoweringBridgeEnvelopeBindingInto(
           snapshotCargo,
           cargoStore,
           migration,
           snapshot.schemaVersion,
           snapshot.semanticEpoch,
           snapshot.predecessorReceiptCid,
           snapshotCargo.proofRoots.parserRootCid,
           executionCid,
           sourceBundleCid,
           sourceIdentityReceiptCid,
           expectedHead,
           previousReceipt,
           binding,
           err):
        return fail(err)
    let storeName =
        bridge.CsgCompilerSnapshotEnvelopeStoreName(snapshotCargo)
    var applied = cargo.csgCompilerSnapshotEnvelopeMerkleApply(
        parentPath, storeName, expectedHead, binding)
    cargo.CsgCompilerSnapshotEnvelopeBindingRelease(binding)
    bridge.CsgCompilerSnapshotLegacyMigrationInputRelease(migration)
    bridge.CsgCompilerSnapshotImmutableCargoStoreBindingRelease(cargoStore)
    cargo.CsgCompilerSnapshotCargoRelease(snapshotCargo)
    if !applied.ok:
        let rejected = applied.error.len > 0 ?
            strings.CloneStr(applied.error) :
            "compiler_snapshot_stale_expected_head_rejected"
        cargo.CsgCompilerSnapshotMerkleTransactionRelease(applied)
        os.WriteLine(
            os.Get_stdout(),
            Fmt"compiler_snapshot_stale_worker_lost error={rejected}")
        return 17
    if !applied.productionApplied || applied.reused ||
       applied.operationCount != 1 ||
       applied.operationKind != merkle_transaction.CsgTransactionReplace ||
       applied.headCid == expectedHead:
        cargo.CsgCompilerSnapshotMerkleTransactionRelease(applied)
        return fail("compiler snapshot stale worker winner invalid")
    let headCid = strings.CloneStr(applied.headCid)
    cargo.CsgCompilerSnapshotMerkleTransactionRelease(applied)
    os.WriteLine(
        os.Get_stdout(),
        Fmt"compiler_snapshot_stale_worker_won head={headCid}")
    return 0

fn main(): int32 =
    let parentPath =
        os.GetEnv("CSG_COMPILER_SNAPSHOT_ENVELOPE_STORE_PARENT")
    if parentPath.len == 0:
        return fail("compiler snapshot envelope store parent missing")
    let mode = os.GetEnv("CSG_COMPILER_SNAPSHOT_ENVELOPE_MODE")
    if mode == "legacy-bootstrap":
        return legacyBootstrap(parentPath)
    if mode == "stale-worker":
        return staleWorker(parentPath)
    let expectLegacy = mode == "legacy-migrate"
    let stalePrepare = mode == "stale-prepare"
    var snapshot = schema_smoke.BuildSnapshot()
    var snapshotCargo = cargo.CsgCompilerSnapshotCargoBuild(snapshot)
    if !snapshotCargo.ok:
        return fail(snapshotCargo.error)
    let cargoStoreIdentity =
        bridge.CsgCompilerSnapshotCargoStoreIdentityCid(snapshotCargo)
    let cargoStoreName =
        bridge.CsgCompilerSnapshotCargoStoreName(snapshotCargo)
    let envelopeStoreIdentity =
        bridge.CsgCompilerSnapshotEnvelopeStoreIdentityCid(snapshotCargo)
    let envelopeStoreName =
        bridge.CsgCompilerSnapshotEnvelopeStoreName(snapshotCargo)
    if !merkle_codec.CsgCoreMerkleStoreCidValid(cargoStoreIdentity) ||
       !merkle_codec.CsgCoreMerkleStoreCidValid(envelopeStoreIdentity) ||
       cargoStoreName.len <= 64 || envelopeStoreName.len <= 64:
        return fail("compiler snapshot store identity invalid")
    var cargoStore: bridge.CsgCompilerSnapshotImmutableCargoStoreBinding
    var err: str
    if !bridge.CsgCompilerSnapshotImmutableCargoStoreEnsureInto(
           parentPath, snapshotCargo, cargoStore, err):
        return fail(err)
    if !cargoStore.ok || cargoStore.storeName != cargoStoreName ||
       cargoStore.storeIdentityCid != cargoStoreIdentity ||
       cargoStore.generation != int64(1) || cargoStore.reused:
        return fail("compiler snapshot immutable Cargo receipt invalid")
    var migration: bridge.CsgCompilerSnapshotLegacyMigrationInput
    let sourceBundleCid = snapshotCargo.proofRoots.dependencyRootCid
    let sourceIdentityReceiptCid = snapshotCargo.proofRoots.readSetRootCid
    if !bridge.CsgCompilerSnapshotLegacyMigrationInputInto(
           parentPath,
           cargoStoreIdentity,
           sourceBundleCid,
           sourceIdentityReceiptCid,
           migration,
           err):
        return fail(err)
    if !migration.ok || migration.originCid != migration.inputCid ||
       (expectLegacy &&
        (!migration.legacyPresent || migration.freshOrigin ||
         migration.originKind !=
             cargo.CsgCompilerSnapshotEnvelopeOriginLegacyMigration)) ||
       (!expectLegacy &&
        (!migration.freshOrigin || migration.legacyPresent ||
         migration.originKind !=
             cargo.CsgCompilerSnapshotEnvelopeOriginFresh)):
        return fail("compiler snapshot origin invalid")
    var first: bridge.CsgCompilerSnapshotEnvelopeStoreReceipt
    if !bridge.CsgCompilerSnapshotEnvelopeStoreCommitInto(
           parentPath,
           snapshotCargo,
           cargoStore,
           migration,
           snapshot.schemaVersion,
           snapshot.semanticEpoch,
           snapshot.predecessorReceiptCid,
           snapshotCargo.proofRoots.parserRootCid,
           snapshotCargo.proofRoots.typeRootCid,
           sourceBundleCid,
           sourceIdentityReceiptCid,
           first,
           err):
        return fail(err)
    if !first.ok || !first.bootstrapApplied || first.generation != int64(1) ||
       first.storeName != envelopeStoreName ||
       first.storeIdentityCid != envelopeStoreIdentity ||
       first.operationCount != 1 ||
       first.operationKind != merkle_transaction.CsgTransactionReplace ||
       !merkle_codec.CsgCoreMerkleStoreCidValid(
           first.migrationReceiptCid):
        return fail("compiler snapshot first envelope receipt invalid")
    let firstCurrent = merkle_store.CsgCoreMerkleStoreReadHead(
        parentPath, envelopeStoreName)
    let genesisMarker =
        bridge.compilerSnapshotLoweringBridgeEnvelopeGenesisMarkerCid(
            envelopeStoreIdentity,
            migration.originKind,
            migration.originCid)
    if !firstCurrent.ok || !firstCurrent.present ||
       firstCurrent.head.headCid != first.headCid ||
       !merkle_codec.CsgCoreMerkleStoreCidValid(
           firstCurrent.head.previousHeadCid) ||
       !merkle_codec.CsgCoreMerkleStoreCidValid(genesisMarker):
        return fail("compiler snapshot envelope genesis binding invalid")
    if stalePrepare:
        let expectedHead = strings.CloneStr(first.headCid)
        let genesisHead =
            strings.CloneStr(firstCurrent.head.previousHeadCid)
        let genesisReceipt = strings.CloneStr(genesisMarker)
        let previousReceipt =
            strings.CloneStr(firstCurrent.head.receiptCid)
        bridge.CsgCompilerSnapshotEnvelopeStoreReceiptRelease(first)
        bridge.CsgCompilerSnapshotLegacyMigrationInputRelease(migration)
        bridge.CsgCompilerSnapshotImmutableCargoStoreBindingRelease(
            cargoStore)
        cargo.CsgCompilerSnapshotCargoRelease(snapshotCargo)
        os.WriteLine(os.Get_stdout(), Fmt"expected_head={expectedHead}")
        os.WriteLine(os.Get_stdout(), Fmt"genesis_head={genesisHead}")
        os.WriteLine(
            os.Get_stdout(), Fmt"genesis_receipt={genesisReceipt}")
        os.WriteLine(
            os.Get_stdout(), Fmt"previous_receipt={previousReceipt}")
        return 0
    if expectLegacy:
        let migrationReceipt =
            strings.CloneStr(first.migrationReceiptCid)
        bridge.CsgCompilerSnapshotEnvelopeStoreReceiptRelease(first)
        bridge.CsgCompilerSnapshotLegacyMigrationInputRelease(migration)
        bridge.CsgCompilerSnapshotImmutableCargoStoreBindingRelease(
            cargoStore)
        cargo.CsgCompilerSnapshotCargoRelease(snapshotCargo)
        os.WriteLine(
            os.Get_stdout(),
            Fmt"compiler_snapshot_legacy_migration_ok receipt={migrationReceipt}")
        return 0
    var sameBinding: cargo.CsgCompilerSnapshotEnvelopeBinding
    if !bridge.compilerSnapshotLoweringBridgeEnvelopeBindingInto(
           snapshotCargo,
           cargoStore,
           migration,
           snapshot.schemaVersion,
           snapshot.semanticEpoch,
           snapshot.predecessorReceiptCid,
           snapshotCargo.proofRoots.parserRootCid,
           snapshotCargo.proofRoots.typeRootCid,
           sourceBundleCid,
           sourceIdentityReceiptCid,
           firstCurrent.head.previousHeadCid,
           genesisMarker,
           sameBinding,
           err):
        return fail(err)
    var sameIdentity =
        cargo.CsgCompilerSnapshotEnvelopeIdentityBuild(sameBinding)
    if !sameIdentity.ok:
        return fail("compiler snapshot envelope identity invalid")
    if envelopeMutationRejected(
           firstCurrent.manifest, sameIdentity.canonicalLines):
        return fail("compiler snapshot envelope strict shape invalid")
    var reused = cargo.csgCompilerSnapshotEnvelopeMerkleApply(
        parentPath,
        envelopeStoreName,
        firstCurrent.head.previousHeadCid,
        sameBinding)
    if !reused.ok || !reused.productionApplied || !reused.reused ||
       reused.operationCount != 1 ||
       reused.operationKind != merkle_transaction.CsgTransactionReplace ||
       reused.headCid != first.headCid:
        return fail(
            Fmt"compiler snapshot envelope idempotent reuse invalid ok={reused.ok} applied={reused.productionApplied} reused={reused.reused} operations={reused.operationCount} kind={reused.operationKind} error={reused.error}")
    var standardRead = merkle_store.CsgCoreMerkleStoreReadHead(
        parentPath, envelopeStoreName)
    standardRead.manifest.standard = "csg_core::v2"
    if !envelopeMutationRejected(
           standardRead.manifest, sameIdentity.canonicalLines):
        return fail("compiler snapshot envelope standard mutation accepted")
    var profileRead = merkle_store.CsgCoreMerkleStoreReadHead(
        parentPath, envelopeStoreName)
    profileRead.manifest.profiles = [
        strings.CloneStr("csg_core"),
        strings.CloneStr("csg_dialect::cheng_compiler")]
    if !envelopeMutationRejected(
           profileRead.manifest, sameIdentity.canonicalLines):
        return fail("compiler snapshot envelope profile mutation accepted")
    var profileSetRead = merkle_store.CsgCoreMerkleStoreReadHead(
        parentPath, envelopeStoreName)
    profileSetRead.manifest.profileSetCid =
        mutatedCidText(profileSetRead.manifest.profileSetCid)
    if !envelopeMutationRejected(
           profileSetRead.manifest, sameIdentity.canonicalLines):
        return fail("compiler snapshot envelope profileSet mutation accepted")
    var factCountRead = merkle_store.CsgCoreMerkleStoreReadHead(
        parentPath, envelopeStoreName)
    factCountRead.manifest.factCount = 3
    if !envelopeMutationRejected(
           factCountRead.manifest, sameIdentity.canonicalLines):
        return fail("compiler snapshot envelope fact count mutation accepted")
    var partitionKindRead = merkle_store.CsgCoreMerkleStoreReadHead(
        parentPath, envelopeStoreName)
    partitionKindRead.manifest.partitions[0].factKind = "csg.data"
    if !envelopeMutationRejected(
           partitionKindRead.manifest, sameIdentity.canonicalLines):
        return fail("compiler snapshot envelope partition kind mutation accepted")
    var partitionCountRead = merkle_store.CsgCoreMerkleStoreReadHead(
        parentPath, envelopeStoreName)
    partitionCountRead.manifest.partitions[0].factCount = 2
    if !envelopeMutationRejected(
           partitionCountRead.manifest, sameIdentity.canonicalLines):
        return fail("compiler snapshot envelope partition count mutation accepted")
    var partitionSourceRead = merkle_store.CsgCoreMerkleStoreReadHead(
        parentPath, envelopeStoreName)
    partitionSourceRead.manifest.partitions[0].sourceId =
        mutatedCidText(
            partitionSourceRead.manifest.partitions[0].sourceId)
    if !envelopeMutationRejected(
           partitionSourceRead.manifest, sameIdentity.canonicalLines):
        return fail("compiler snapshot envelope partition source mutation accepted")
    let idMutation = strutils.Replace(
        sameIdentity.canonicalLines[1],
        "\"id\":\"csg_core::compiler_snapshot_head\"",
        "\"id\":\"csg_core::compiler_snapshot_head_mutated\"")
    let dataKindMutation = strutils.Replace(
        sameIdentity.canonicalLines[1],
        "\"dataKind\":\"compiler_snapshot_head\"",
        "\"dataKind\":\"compiler_snapshot_head_mutated\"")
    let valueShapeMutation = strutils.Replace(
        sameIdentity.canonicalLines[1],
        "\"cargoByteCount\":",
        "\"cargoByteCountMutated\":")
    let valueOrderStageOne = strutils.Replace(
        sameIdentity.canonicalLines[1],
        "\"cargoByteCount\":",
        "\"zzCargoByteCount\":")
    let valueOrderStageTwo = strutils.Replace(
        valueOrderStageOne,
        "\"cargoCallRootCid\":",
        "\"cargoByteCount\":")
    let valueOrderMutation = strutils.Replace(
        valueOrderStageTwo,
        "\"zzCargoByteCount\":",
        "\"cargoCallRootCid\":")
    let orderMutation = strutils.Replace(
        sameIdentity.canonicalLines[1],
        "{\"dataKind\":\"compiler_snapshot_head\",\"id\":\"csg_core::compiler_snapshot_head\"",
        "{\"id\":\"csg_core::compiler_snapshot_head\",\"dataKind\":\"compiler_snapshot_head\"")
    let factKindMutation = strutils.Replace(
        sameIdentity.canonicalLines[1],
        "\"kind\":\"csg.data\"",
        "\"kind\":\"csg.runtime_requirement\"")
    if !envelopeMutationRejected(
           firstCurrent.manifest,
           [strings.CloneStr(sameIdentity.canonicalLines[0]), idMutation]) ||
       !envelopeMutationRejected(
           firstCurrent.manifest,
           [strings.CloneStr(sameIdentity.canonicalLines[0]),
            dataKindMutation]) ||
       !envelopeMutationRejected(
           firstCurrent.manifest,
           [strings.CloneStr(sameIdentity.canonicalLines[0]),
            valueShapeMutation]) ||
       !envelopeMutationRejected(
           firstCurrent.manifest,
           [strings.CloneStr(sameIdentity.canonicalLines[0]),
            valueOrderMutation]) ||
       !envelopeMutationRejected(
           firstCurrent.manifest,
           [strings.CloneStr(sameIdentity.canonicalLines[0]),
            orderMutation]) ||
       !envelopeMutationRejected(
           firstCurrent.manifest,
           [strings.CloneStr(sameIdentity.canonicalLines[0]),
            factKindMutation]) ||
       !envelopeMutationRejected(
           firstCurrent.manifest,
           [strings.CloneStr(sameIdentity.canonicalLines[0])]) ||
       !envelopeMutationRejected(
           firstCurrent.manifest,
           [strings.CloneStr(sameIdentity.canonicalLines[0]),
            strings.CloneStr(sameIdentity.canonicalLines[1]),
            strings.CloneStr(sameIdentity.canonicalLines[1])]):
        return fail("compiler snapshot envelope format mutation accepted")
    cargo.CsgCompilerSnapshotMerkleTransactionRelease(reused)
    cargo.CsgCompilerSnapshotEnvelopeIdentityRelease(sameIdentity)
    cargo.CsgCompilerSnapshotEnvelopeBindingRelease(sameBinding)
    var second: bridge.CsgCompilerSnapshotEnvelopeStoreReceipt
    if !bridge.CsgCompilerSnapshotEnvelopeStoreCommitInto(
           parentPath,
           snapshotCargo,
           cargoStore,
           migration,
           snapshot.schemaVersion,
           snapshot.semanticEpoch,
           snapshot.predecessorReceiptCid,
           snapshotCargo.proofRoots.parserRootCid,
           snapshotCargo.proofRoots.typeRootCid,
           sourceBundleCid,
           sourceIdentityReceiptCid,
           second,
           err):
        return fail(err)
    if !second.ok || second.bootstrapApplied ||
       second.generation != int64(2) ||
       second.operationCount != 1 ||
       second.operationKind != merkle_transaction.CsgTransactionReplace ||
       second.headCid == first.headCid ||
       second.receiptCid == first.receiptCid:
        return fail("compiler snapshot successor envelope receipt invalid")
    var reusedCargoStore: bridge.CsgCompilerSnapshotImmutableCargoStoreBinding
    if !bridge.CsgCompilerSnapshotImmutableCargoStoreEnsureInto(
           parentPath, snapshotCargo, reusedCargoStore, err) ||
       !reusedCargoStore.reused ||
       reusedCargoStore.headCid != cargoStore.headCid:
        return fail("compiler snapshot immutable Cargo reuse invalid")
    if !cargoMutationRejected(parentPath, snapshot, 1) ||
       !cargoMutationRejected(parentPath, snapshot, 2) ||
       !cargoMutationRejected(parentPath, snapshot, 3) ||
       !cargoMutationRejected(parentPath, snapshot, 4):
        return fail("compiler snapshot Cargo mutation accepted")
    let finalGeneration = second.generation
    bridge.CsgCompilerSnapshotImmutableCargoStoreBindingRelease(
        reusedCargoStore)
    bridge.CsgCompilerSnapshotEnvelopeStoreReceiptRelease(second)
    bridge.CsgCompilerSnapshotEnvelopeStoreReceiptRelease(first)
    bridge.CsgCompilerSnapshotLegacyMigrationInputRelease(migration)
    bridge.CsgCompilerSnapshotImmutableCargoStoreBindingRelease(cargoStore)
    cargo.CsgCompilerSnapshotCargoRelease(snapshotCargo)
    os.WriteLine(
        os.Get_stdout(),
        Fmt"compiler_snapshot_envelope_store_ok cargo_store={cargoStoreIdentity} envelope_store={envelopeStoreIdentity} generation={finalGeneration}")
    return 0
