import cheng/core/runtime/web_font_runtime as font

fn putU16BE(buf: var int32[], offset: int32, value: int32) =
    buf[offset] = (value >> 8) & 255
    buf[offset + 1] = value & 255

fn putI16BE(buf: var int32[], offset: int32, value: int32) =
    var v = value
    if v < 0:
        v = v + 65536
    putU16BE(buf, offset, v)

fn putU32BE(buf: var int32[], offset: int32, value: int32) =
    buf[offset] = (value >> 24) & 255
    buf[offset + 1] = (value >> 16) & 255
    buf[offset + 2] = (value >> 8) & 255
    buf[offset + 3] = value & 255

fn putTag(buf: var int32[], offset: int32, a: char, b: char, c: char, d: char) =
    buf[offset] = int32(a)
    buf[offset + 1] = int32(b)
    buf[offset + 2] = int32(c)
    buf[offset + 3] = int32(d)

fn putDirectory(buf: var int32[], record: int32,
                a: char, b: char, c: char, d: char,
                offset: int32, length: int32) =
    putTag(buf, record, a, b, c, d)
    putU32BE(buf, record + 4, 0)
    putU32BE(buf, record + 8, offset)
    putU32BE(buf, record + 12, length)

fn makeSfntFixture(): int32[] =
    var buf: int32[]
    for _ in 0..<768:
        add(buf, 0)
    putU32BE(buf, 0, 0x00010000)
    putU16BE(buf, 4, 7)
    putU16BE(buf, 6, 0)
    putU16BE(buf, 8, 0)
    putU16BE(buf, 10, 0)
    putDirectory(buf, 12, 'c', 'm', 'a', 'p', 160, 64)
    putDirectory(buf, 28, 'g', 'l', 'y', 'f', 512, 96)
    putDirectory(buf, 44, 'h', 'e', 'a', 'd', 224, 54)
    putDirectory(buf, 60, 'h', 'h', 'e', 'a', 288, 36)
    putDirectory(buf, 76, 'h', 'm', 't', 'x', 352, 28)
    putDirectory(buf, 92, 'l', 'o', 'c', 'a', 448, 16)
    putDirectory(buf, 108, 'm', 'a', 'x', 'p', 416, 6)

    putU16BE(buf, 160, 0)
    putU16BE(buf, 162, 1)
    putU16BE(buf, 164, 3)
    putU16BE(buf, 166, 1)
    putU32BE(buf, 168, 12)

    let cmap4 = 172
    putU16BE(buf, cmap4, 4)
    putU16BE(buf, cmap4 + 2, 48)
    putU16BE(buf, cmap4 + 4, 0)
    putU16BE(buf, cmap4 + 6, 8)
    putU16BE(buf, cmap4 + 8, 0)
    putU16BE(buf, cmap4 + 10, 0)
    putU16BE(buf, cmap4 + 12, 0)
    putU16BE(buf, cmap4 + 14, 32)
    putU16BE(buf, cmap4 + 16, 65)
    putU16BE(buf, cmap4 + 18, 97)
    putU16BE(buf, cmap4 + 20, 65535)
    putU16BE(buf, cmap4 + 22, 0)
    putU16BE(buf, cmap4 + 24, 32)
    putU16BE(buf, cmap4 + 26, 65)
    putU16BE(buf, cmap4 + 28, 97)
    putU16BE(buf, cmap4 + 30, 65535)
    putI16BE(buf, cmap4 + 32, -29)
    putI16BE(buf, cmap4 + 34, -60)
    putI16BE(buf, cmap4 + 36, -91)
    putI16BE(buf, cmap4 + 38, 1)
    putU16BE(buf, cmap4 + 40, 0)
    putU16BE(buf, cmap4 + 42, 0)
    putU16BE(buf, cmap4 + 44, 0)
    putU16BE(buf, cmap4 + 46, 0)

    putU16BE(buf, 224 + 18, 1000)
    putI16BE(buf, 224 + 50, 0)
    putI16BE(buf, 288 + 4, 800)
    putI16BE(buf, 288 + 6, -200)
    putI16BE(buf, 288 + 8, 200)
    putU16BE(buf, 288 + 34, 7)
    putU16BE(buf, 416 + 4, 7)

    putU16BE(buf, 352 + 0, 0)
    putI16BE(buf, 352 + 2, 0)
    putU16BE(buf, 352 + 4, 500)
    putI16BE(buf, 352 + 6, 0)
    putU16BE(buf, 352 + 8, 500)
    putI16BE(buf, 352 + 10, 0)
    putU16BE(buf, 352 + 12, 250)
    putI16BE(buf, 352 + 14, 0)
    putU16BE(buf, 352 + 16, 600)
    putI16BE(buf, 352 + 18, 0)
    putU16BE(buf, 352 + 20, 700)
    putI16BE(buf, 352 + 22, 0)
    putU16BE(buf, 352 + 24, 550)
    putI16BE(buf, 352 + 26, 0)

    putU16BE(buf, 448 + 0, 0)
    putU16BE(buf, 448 + 2, 0)
    putU16BE(buf, 448 + 4, 0)
    putU16BE(buf, 448 + 6, 0)
    putU16BE(buf, 448 + 8, 0)
    putU16BE(buf, 448 + 10, 0)
    putU16BE(buf, 448 + 12, 16)
    putU16BE(buf, 448 + 14, 27)

    putI16BE(buf, 512 + 0, 1)
    putI16BE(buf, 512 + 2, 0)
    putI16BE(buf, 512 + 4, 0)
    putI16BE(buf, 512 + 6, 700)
    putI16BE(buf, 512 + 8, 700)
    putU16BE(buf, 512 + 10, 3)
    putU16BE(buf, 512 + 12, 0)
    buf[512 + 14] = 9
    buf[512 + 15] = 3
    putI16BE(buf, 512 + 16, 0)
    putI16BE(buf, 512 + 18, 700)
    putI16BE(buf, 512 + 20, 0)
    putI16BE(buf, 512 + 22, -700)
    putI16BE(buf, 512 + 24, 0)
    putI16BE(buf, 512 + 26, 0)
    putI16BE(buf, 512 + 28, 700)
    putI16BE(buf, 512 + 30, 0)

    putI16BE(buf, 544 + 0, 1)
    putI16BE(buf, 544 + 2, 0)
    putI16BE(buf, 544 + 4, 0)
    putI16BE(buf, 544 + 6, 200)
    putI16BE(buf, 544 + 8, 160)
    putU16BE(buf, 544 + 10, 3)
    putU16BE(buf, 544 + 12, 0)
    buf[544 + 14] = 49
    buf[544 + 15] = 51
    buf[544 + 16] = 53
    buf[544 + 17] = 35
    buf[544 + 18] = 200
    buf[544 + 19] = 200
    buf[544 + 20] = 160
    return buf

fn runWebFontSfntMetricsSmoke(): int32 =
    let data = makeSfntFixture()
    var face: font.WebFontFace
    if !font.WebFontLoadSfnt(data, face):
        return 1
    if !face.loaded || face.unitsPerEm != 1000 || face.numGlyphs != 7:
        font.WebFontFree(face)
        return 2
    if face.ascender != 800 || face.descender != -200 || face.lineGap != 200:
        font.WebFontFree(face)
        return 3

    let glyphSpace = font.WebFontGlyphIndexForCodepoint(face, 32)
    let glyphA = font.WebFontGlyphIndexForCodepoint(face, 65)
    let glyphLowerA = font.WebFontGlyphIndexForCodepoint(face, 97)
    if glyphSpace != 3:
        font.WebFontFree(face)
        return 4
    if glyphA != 5:
        font.WebFontFree(face)
        return 20
    if glyphLowerA != 6:
        font.WebFontFree(face)
        return 21
    if font.WebFontAdvanceWidth(face, glyphSpace) != 250:
        font.WebFontFree(face)
        return 5
    if font.WebFontAdvanceWidth(face, glyphA) != 700:
        font.WebFontFree(face)
        return 6
    if font.WebFontScaledAdvance(face, glyphA, 16) != 11:
        font.WebFontFree(face)
        return 7
    if font.WebFontLineHeightPx(face, 16) != 19:
        font.WebFontFree(face)
        return 8

    var glyphOffset = 0
    var glyphLength = 0
    if !font.WebFontGlyphLocation(face, glyphA, glyphOffset, glyphLength):
        font.WebFontFree(face)
        return 9
    if glyphOffset != 512 || glyphLength != 32:
        font.WebFontFree(face)
        return 10

    var bounds: font.WebFontGlyphBounds
    if !font.WebFontGlyphBoundsRead(face, glyphA, bounds):
        font.WebFontFree(face)
        return 11
    if bounds.empty || bounds.contourCount != 1:
        font.WebFontFree(face)
        return 12
    if bounds.xMin != 0 || bounds.yMin != 0 || bounds.xMax != 700 || bounds.yMax != 700:
        font.WebFontFree(face)
        return 13

    var outline: font.WebFontGlyphOutline
    if !font.WebFontGlyphOutlineRead(face, glyphA, outline):
        font.WebFontFree(face)
        return 14
    if !outline.simple || outline.contourCount != 1 || outline.pointCount != 4:
        font.WebFontFree(face)
        return 15
    if outline.xMin != 0 || outline.yMin != 0 || outline.xMax != 700 || outline.yMax != 700:
        font.WebFontFree(face)
        return 16
    if outline.points[0].x != 0 || outline.points[0].y != 0 || !outline.points[0].onCurve || outline.points[0].endContour:
        font.WebFontFree(face)
        return 17
    if outline.points[1].x != 700 || outline.points[1].y != 0 || !outline.points[1].onCurve || outline.points[1].endContour:
        font.WebFontFree(face)
        return 18
    if outline.points[2].x != 700 || outline.points[2].y != 700 || !outline.points[2].onCurve || outline.points[2].endContour:
        font.WebFontFree(face)
        return 19
    if outline.points[3].x != 0 || outline.points[3].y != 700 || !outline.points[3].onCurve || !outline.points[3].endContour:
        font.WebFontFree(face)
        return 22

    var lowerOutline: font.WebFontGlyphOutline
    if !font.WebFontGlyphOutlineRead(face, glyphLowerA, lowerOutline):
        font.WebFontFree(face)
        return 23
    if lowerOutline.pointCount != 4 || lowerOutline.xMax != 200 || lowerOutline.yMax != 160:
        font.WebFontFree(face)
        return 24
    if lowerOutline.points[0].x != 0 || lowerOutline.points[0].y != 0:
        font.WebFontFree(face)
        return 25
    if lowerOutline.points[1].x != 200 || lowerOutline.points[1].y != 0:
        font.WebFontFree(face)
        return 26
    if lowerOutline.points[2].x != 200 || lowerOutline.points[2].y != 160:
        font.WebFontFree(face)
        return 27
    if lowerOutline.points[3].x != 0 || lowerOutline.points[3].y != 160 || !lowerOutline.points[3].endContour:
        font.WebFontFree(face)
        return 28

    font.WebFontFree(face)
    return 0

fn runWebFontBase64Smoke(): int32 =
    var bytes: int32[]
    if !font.WebFontDecodeBase64("AAEC+/8=", bytes):
        return 29
    if bytes.len != 5:
        return 30
    if bytes[0] != 0 || bytes[1] != 1 || bytes[2] != 2 || bytes[3] != 251 || bytes[4] != 255:
        return 31
    if font.WebFontDecodeBase64("AA=E", bytes):
        return 32
    return 0

fn main(): int32 =
    let code = runWebFontSfntMetricsSmoke()
    if code != 0:
        echo(Fmt"FAIL runWebFontSfntMetricsSmoke: {code}")
        return code
    let base64Code = runWebFontBase64Smoke()
    if base64Code != 0:
        echo(Fmt"FAIL runWebFontBase64Smoke: {base64Code}")
        return base64Code
    echo("web_runtime_font_smoke ok")
    return 0
