module cold_linkerless_enum_variant

type Color = enum Red, Green, Blue

fn test_red(): int32 =
    let c: Color = Color.Red
    match c:
        Red => return 0
        Green => return 1
        Blue => return 2

fn test_green(): int32 =
    let c: Color = Color.Green
    match c:
        Red => return 1
        Green => return 0
        Blue => return 2

fn test_blue(): int32 =
    let c: Color = Color.Blue
    match c:
        Red => return 1
        Green => return 2
        Blue => return 0

fn main(): int32 =
    let r1 = test_red()
    if r1 != 0:
        return 1
    let r2 = test_green()
    if r2 != 0:
        return 2
    let r3 = test_blue()
    if r3 != 0:
        return 3
    return 0

main()
