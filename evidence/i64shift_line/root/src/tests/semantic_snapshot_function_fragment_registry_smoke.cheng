import std/os
import std/cmdline
import std/rawbytes as rawbytes
import std/strutils as strutil
import std/strings
import cheng/std/bytes_layout as layout
import cheng/core/lang/parser as parser
import cheng/core/lang/typed_expr as typed_expr
import cheng/core/lang/typed_expr_frag_codec as fragment_codec
import cheng/core/csg_core/compiler_snapshot_schema as schema
import cheng/core/tooling/semantic_snapshot_incremental_plan as incremental
import cheng/core/tooling/semantic_snapshot_fragment_cache_store as cache_store

type
    FragmentCacheRowSpec =
        functionSymbolCid: layout.FixedBytes32
        bodyContentCid: layout.FixedBytes32
        functionInterfaceCid: layout.FixedBytes32
        exactReadSetCid: layout.FixedBytes32
        schemaCid: layout.FixedBytes32
        compilerCid: layout.FixedBytes32
        targetCid: layout.FixedBytes32
        payload: str
        keyCid: layout.FixedBytes32

fn ExactCid(seed: int32): layout.FixedBytes32 =
    var out: layout.FixedBytes32
    out.data[0] = uint8(seed)
    return out

fn CidLess(left: layout.FixedBytes32,
           right: layout.FixedBytes32): bool =
    for index in 0..<layout.FixedBytes32Size:
        if left.data[index] < right.data[index]:
            return true
        if left.data[index] > right.data[index]:
            return false
    return false

fn ExactReadCid(readerSymbolCid: layout.FixedBytes32,
                   targetSymbolCid: layout.FixedBytes32,
                   observedInterfaceCid: layout.FixedBytes32):
                   layout.FixedBytes32 =
    var out: layout.FixedBytes32
    var err: str
    assert(incremental.SemanticSnapshotExactReadSetCidInto(
               readerSymbolCid,
               [schema.CsgCompilerReadDomainSymbolInterface],
               [targetSymbolCid],
               [observedInterfaceCid], out, err), err)
    return out

@borrows
fn AdmissionInput(
        current: incremental.SemanticSnapshotIncrementalPrebuildFacts,
        finalized: incremental.SemanticSnapshotIncrementalFinalizedReadSet,
        functionId: int32):
        incremental.SemanticSnapshotFunctionFragmentAdmissionInput =
    var out: incremental.SemanticSnapshotFunctionFragmentAdmissionInput
    var err: str
    assert(incremental.SemanticSnapshotFunctionFragmentAdmissionInputMakeInto(
               current, finalized, functionId, out, err), err)
    return out

fn CanonicalFragmentPayload(sourcePath: str,
                            functionName: str): str =
    var fragment: fragment_codec.TypedExprIrFunctionFragment
    fragment.sourcePath = sourcePath
    fragment.functionName = functionName
    fragment.signatureLineNumber = 1
    fragment.endLineNumber = 1
    fragment.bodyLineNumber = 1
    fragment.returnType = "int32"
    fragment.resultExprClass = int32(typed_expr.TypedExprExprOwned)
    fragment.returnNodeIndex = -1
    fragment.valueDefinitionTypeArenaArtifactCid =
        layout.FixedBytes32Hex(layout.FixedBytes32())
    fragment.scopeStart = 0
    fragment.scopeCount = 1
    fragment.scopes.scopeIds = [0]
    fragment.scopes.parentScopeIds = [-1]
    fragment.scopes.kinds = [int32(parser.NormalizedScopeRoot)]
    fragment.scopes.ownerStatementOrdinals = [-1]
    fragment.scopes.lexicalOrdinals = [0]
    fragment.scopes.startLineNumbers = [1]
    fragment.scopes.startColumnNumbers = [1]
    fragment.scopes.endLineNumbers = [1]
    fragment.scopes.endColumnNumbers = [1]
    var encoded =
        fragment_codec.TypedExprIrFunctionFragmentEncode(fragment)
    let out = rawbytes.BytesToString(encoded)
    rawbytes.BytesFree(encoded)
    return out

fn MutatePayloadByte(payload: str): str =
    let bytes = rawbytes.BytesFromString(payload)
    var builder = rawbytes.BytesBuilderNew(payload.len)
    for index in 0..<payload.len:
        var value = rawbytes.BytesGet(bytes, index)
        if index == payload.len - 1:
            value = value ^ 1
        rawbytes.BytesBuilderAppendByte(builder, value)
    var mutated = rawbytes.BytesBuilderFinish(builder)
    let out = rawbytes.BytesToString(mutated)
    rawbytes.BytesFree(mutated)
    return out

fn FragmentCacheRowSpecMake(
        functionSymbolCid: layout.FixedBytes32,
        bodyContentCid: layout.FixedBytes32,
        functionInterfaceCid: layout.FixedBytes32,
        exactReadSetCid: layout.FixedBytes32,
        schemaCid: layout.FixedBytes32,
        compilerCid: layout.FixedBytes32,
        targetCid: layout.FixedBytes32,
        payload: str): FragmentCacheRowSpec =
    var out: FragmentCacheRowSpec
    out.functionSymbolCid = functionSymbolCid
    out.bodyContentCid = bodyContentCid
    out.functionInterfaceCid = functionInterfaceCid
    out.exactReadSetCid = exactReadSetCid
    out.schemaCid = schemaCid
    out.compilerCid = compilerCid
    out.targetCid = targetCid
    out.payload = payload
    out.keyCid = incremental.SemanticSnapshotFunctionFragmentCacheKey(
        functionSymbolCid, bodyContentCid, functionInterfaceCid,
        exactReadSetCid,
        schemaCid, compilerCid, targetCid)
    return out

fn BuildCache(specs: FragmentCacheRowSpec[]):
              incremental.SemanticSnapshotFunctionFragmentCache =
    var sorted = specs
    if sorted.len > 1:
        for pass in 0..<(sorted.len - 1):
            for row in 0..<(sorted.len - 1 - pass):
                if CidLess(sorted[row + 1].keyCid,
                           sorted[row].keyCid):
                    let temporary = sorted[row]
                    sorted[row] = sorted[row + 1]
                    sorted[row + 1] = temporary
    var out: incremental.SemanticSnapshotFunctionFragmentCache
    var err: str
    for row in 0..<sorted.len:
        assert(incremental.SemanticSnapshotFunctionFragmentCacheAppendInto(
                   out, sorted[row].functionSymbolCid,
                   sorted[row].bodyContentCid,
                   sorted[row].functionInterfaceCid,
                   sorted[row].exactReadSetCid,
                   sorted[row].schemaCid, sorted[row].compilerCid,
                   sorted[row].targetCid,
                   strings.CloneStr(sorted[row].payload), err), err)
    assert(incremental.SemanticSnapshotFunctionFragmentCacheSealInto(
               out, err), err)
    return out

fn ExpectCacheMutationRejected(
        cache: incremental.SemanticSnapshotFunctionFragmentCache,
        mutationName: str) =
    var owner: incremental.SemanticSnapshotWorkspaceFunctionFragmentOwner
    var err: str
    assert(!incremental.SemanticSnapshotWorkspaceFunctionFragmentOwnerInitInto(
                ExactCid(209), ExactCid(200), ExactCid(201),
                ExactCid(202), cache.cacheCid, cache, owner, err),
           mutationName)

fn main() =
    let schemaCid = ExactCid(200)
    let compilerCid = ExactCid(201)
    let targetCid = ExactCid(202)
    let sourceVersion = int64(7)
    let factsCid = ExactCid(203)
    let function0 = ExactCid(10)
    let function1 = ExactCid(11)
    let function2 = ExactCid(12)
    let source0 = schema.CsgCompilerSourceContentCid("source-zero")
    let source1 = schema.CsgCompilerSourceContentCid("source-one")
    let source2 = schema.CsgCompilerSourceContentCid("source-two")
    let staleSource2 = schema.CsgCompilerSourceContentCid("stale-two")
    let read0 = ExactReadCid(function0, ExactCid(30), ExactCid(40))
    let read1 = ExactReadCid(function1, ExactCid(31), ExactCid(41))
    let read2 = ExactReadCid(function2, ExactCid(32), ExactCid(42))
    var admissionFacts: incremental.SemanticSnapshotIncrementalPrebuildFacts
    admissionFacts.sourceVersion = sourceVersion
    admissionFacts.factsCid = factsCid
    admissionFacts.symbolCids = [function0, function1, function2]
    admissionFacts.functionSymbolIds = [0, 1, 2]
    admissionFacts.bodyContentCids = [source0, source1, source2]
    admissionFacts.functionInterfaceCids = [
        ExactCid(50), ExactCid(51), ExactCid(52)]
    var admissionFinalized: incremental.SemanticSnapshotIncrementalFinalizedReadSet
    admissionFinalized.previousCsgRootCid = ExactCid(204)
    admissionFinalized.sourceVersion = sourceVersion
    admissionFinalized.factsCid = factsCid
    admissionFinalized.planCid = ExactCid(205)
    admissionFinalized.readStarts = [0, 1, 2]
    admissionFinalized.readCounts = [1, 1, 1]
    admissionFinalized.readSetPreimageCids = [read0, read1, read2]
    admissionFinalized.readSet.readerFunctionIds = [0, 1, 2]
    admissionFinalized.readSet.targetDomainKinds = [
        schema.CsgCompilerReadDomainSymbolInterface,
        schema.CsgCompilerReadDomainSymbolInterface,
        schema.CsgCompilerReadDomainSymbolInterface]
    admissionFinalized.readSet.targetPortableKeyCids = [
        ExactCid(30), ExactCid(31), ExactCid(32)]
    admissionFinalized.readSet.observedValueCids = [
        ExactCid(40), ExactCid(41), ExactCid(42)]
    admissionFinalized.readSet.reverseIndexCid = ExactCid(206)
    admissionFinalized.readSet.reverseTargetDomainKinds =
        admissionFinalized.readSet.targetDomainKinds
    admissionFinalized.readSet.reverseTargetPortableKeyCids =
        admissionFinalized.readSet.targetPortableKeyCids
    admissionFinalized.readSet.reverseStarts = [0, 1, 2]
    admissionFinalized.readSet.reverseCounts = [1, 1, 1]
    admissionFinalized.readSet.reverseReaderFunctionIds = [0, 1, 2]
    admissionFinalized.readSet.reverseObservedValueCids = [
        ExactCid(40), ExactCid(41), ExactCid(42)]
    admissionFinalized.readSet.reverseForwardRowIds = [0, 1, 2]
    admissionFinalized.reverseIndexOwner.receiptCid = ExactCid(207)
    admissionFinalized.receiptCid =
        incremental.SemanticSnapshotIncrementalFinalizedReadSetReceiptCid(
            admissionFinalized)
    let finalizedReadSetReceiptCid = admissionFinalized.receiptCid
    let input0 = AdmissionInput(admissionFacts, admissionFinalized, 0)
    let input1 = AdmissionInput(admissionFacts, admissionFinalized, 1)
    let input2 = AdmissionInput(admissionFacts, admissionFinalized, 2)
    let sharedPayload = CanonicalFragmentPayload(
        "pkg/source.cheng", "shared")

    var specs: FragmentCacheRowSpec[]
    add(specs, FragmentCacheRowSpecMake(
        function0, source0, ExactCid(50), read0, schemaCid, compilerCid,
        targetCid, strings.CloneStr(sharedPayload)))
    add(specs, FragmentCacheRowSpecMake(
        function1, source1, ExactCid(51), read1, schemaCid, compilerCid,
        targetCid, strings.CloneStr(sharedPayload)))
    add(specs, FragmentCacheRowSpecMake(
        function2, staleSource2, ExactCid(52), read2, schemaCid, compilerCid,
        targetCid, CanonicalFragmentPayload(
            "pkg/stale.cheng", "stale")))
    let cache = BuildCache(specs)
    var err: str
    let cacheRoot = cmdline.ReadFlagOrDefault(
        "--cache-root",
        "/private/tmp/cheng-semantic-snapshot-fragment-cache-smoke")
    let mode = cmdline.ReadFlagOrDefault("--mode", "normal")
    let cachePath =
        cache_store.SemanticSnapshotFunctionFragmentCachePath(
            cacheRoot, cache.cacheCid)
    assert(cache_store.SemanticSnapshotFunctionFragmentCachePutInto(
               cacheRoot, cache, ExactCid(210), err), err)
    assert(os.DirExists(cachePath),
           "semantic snapshot fragment cache tree missing")
    if mode == "corrupt-store":
        let cacheFile = strutil.Join([cachePath, "/cache.bin"], "")
        var corrupt = rawbytes.BytesFromString("corrupt")
        assert(IsOk(os.WriteFileBytesResult(cacheFile, corrupt)),
               "semantic snapshot fragment cache attack write failed")
    elif mode == "missing-store":
        let cacheFile = strutil.Join([
            strings.CloneStr(cachePath), "/cache.bin"], "")
        assert(os.RemoveFile(cacheFile),
               "semantic snapshot fragment cache missing attack remove file failed")
        os.RemoveDir(cachePath)
        assert(!os.DirExists(cachePath),
               "semantic snapshot fragment cache missing attack remove tree failed")
    var persisted: incremental.SemanticSnapshotFunctionFragmentCache
    assert(cache_store.SemanticSnapshotFunctionFragmentCacheLoadInto(
               cacheRoot, cache.cacheCid, schemaCid, compilerCid,
               targetCid, persisted, err), err)

    var workspaceOwner: incremental.SemanticSnapshotWorkspaceFunctionFragmentOwner
    assert(incremental.SemanticSnapshotWorkspaceFunctionFragmentOwnerInitInto(
               ExactCid(209), schemaCid, compilerCid, targetCid,
               persisted.cacheCid, persisted, workspaceOwner, err), err)
    var registry: incremental.SemanticSnapshotDecodedFunctionFragmentRegistry
    assert(incremental.SemanticSnapshotDecodedFunctionFragmentRegistryInitInto(
               ExactCid(210), 3, sourceVersion, factsCid,
               finalizedReadSetReceiptCid,
               workspaceOwner, registry, err), err)
    var admission0: incremental.SemanticSnapshotFunctionFragmentAdmission
    var admission1: incremental.SemanticSnapshotFunctionFragmentAdmission
    var admission2: incremental.SemanticSnapshotFunctionFragmentAdmission
    assert(incremental.SemanticSnapshotDecodedFunctionFragmentRegistryVisitInto(
               admissionFacts, admissionFinalized,
               workspaceOwner, registry, input0, admission0, err), err)
    assert(incremental.SemanticSnapshotDecodedFunctionFragmentRegistryVisitInto(
               admissionFacts, admissionFinalized,
               workspaceOwner, registry, input1, admission1, err), err)
    assert(incremental.SemanticSnapshotDecodedFunctionFragmentRegistryVisitInto(
               admissionFacts, admissionFinalized,
               workspaceOwner, registry, input2, admission2, err), err)
    assert(admission0.kind ==
               incremental.SemanticSnapshotFunctionFragmentAdmissionCacheHit &&
           admission1.kind ==
               incremental.SemanticSnapshotFunctionFragmentAdmissionCacheHit &&
           admission0.decodedRowId == admission1.decodedRowId &&
           admission2.kind ==
               incremental.SemanticSnapshotFunctionFragmentAdmissionWholeRebuild,
           " fragment registry: exact admission drift")
    assert(registry.visitCount == 3 && registry.cacheHitCount == 2 &&
           registry.rebuildCount == 1 && registry.decodeCount == 1 &&
           registry.reuseCount == 1 && workspaceOwner.decodeCount == 1 &&
           registry.decodedFragmentCids.len == 1 &&
           workspaceOwner.decodedFragments.len == 1 &&
           workspaceOwner.decodedFragments[0].functionName == "shared",
           " fragment registry: unique decode evidence drift")

    var incomplete: incremental.SemanticSnapshotFunctionFragmentCandidateReceipt
    assert(!incremental.SemanticSnapshotFunctionFragmentCandidateFinalizeInto(
                workspaceOwner, registry, incomplete, err),
           " fragment registry: incomplete candidate published")
    var rebuiltCid: layout.FixedBytes32
    assert(incremental.SemanticSnapshotFunctionFragmentWholeRebuildInto(
               registry, 2, CanonicalFragmentPayload(
                   "pkg/current.cheng", "rebuilt"), rebuiltCid, err), err)
    assert(registry.rebuiltFragments[2].functionName == "rebuilt" &&
           registry.rebuiltCanonicalPayloads[2] != "",
           " fragment registry: rebuilt owner missing")
    var rejectedCid: layout.FixedBytes32
    assert(!incremental.SemanticSnapshotFunctionFragmentWholeRebuildInto(
                registry, 0, sharedPayload, rejectedCid, err),
           " fragment registry: cache hit lowered")
    assert(!incremental.SemanticSnapshotFunctionFragmentWholeRebuildInto(
                registry, 2, sharedPayload, rejectedCid, err),
           " fragment registry: duplicate lower accepted")
    var rejectedAdmission: incremental.SemanticSnapshotFunctionFragmentAdmission
    assert(!incremental.SemanticSnapshotDecodedFunctionFragmentRegistryVisitInto(
                admissionFacts, admissionFinalized,
                workspaceOwner, registry, input2, rejectedAdmission, err),
           " fragment registry: duplicate visit accepted")
    assert(registry.visitCount == 3 && registry.lowerCount == 1 &&
           registry.decodeCount == 1,
           " fragment registry: rejected operation changed evidence")

    var receipt: incremental.SemanticSnapshotFunctionFragmentCandidateReceipt
    assert(incremental.SemanticSnapshotFunctionFragmentCandidateFinalizeInto(
               workspaceOwner, registry, receipt, err), err)
    assert(receipt.functionCount == 3 && receipt.visitCount == 3 &&
           receipt.lowerCount == 1 && receipt.cacheHitCount == 2 &&
           receipt.rebuildCount == 1 && receipt.decodeCount == 1 &&
           receipt.reuseCount == 1 &&
           receipt.uniqueDecodedFragmentCount == 1,
           " fragment registry: receipt counters drift")
    assert(incremental.SemanticSnapshotFunctionFragmentCandidateReceiptStrictValidateInto(
               workspaceOwner, registry, receipt, err), err)
    var receiptAttack = receipt
    receiptAttack.decodeCount = 2
    assert(!incremental.SemanticSnapshotFunctionFragmentCandidateReceiptStrictValidateInto(
                workspaceOwner, registry, receiptAttack, err),
           " fragment registry: receipt mutation accepted")

    # A later candidate in the same workspace borrows the immutable decoded
    # row. No payload is decoded or copied into the candidate registry.
    var secondRegistry: incremental.SemanticSnapshotDecodedFunctionFragmentRegistry
    assert(incremental.SemanticSnapshotDecodedFunctionFragmentRegistryInitInto(
               ExactCid(211), 2, sourceVersion, factsCid,
               finalizedReadSetReceiptCid,
               workspaceOwner, secondRegistry, err), err)
    var secondAdmission0: incremental.SemanticSnapshotFunctionFragmentAdmission
    var secondAdmission1: incremental.SemanticSnapshotFunctionFragmentAdmission
    assert(incremental.SemanticSnapshotDecodedFunctionFragmentRegistryVisitInto(
               admissionFacts, admissionFinalized,
               workspaceOwner, secondRegistry,
               input0, secondAdmission0, err), err)
    assert(incremental.SemanticSnapshotDecodedFunctionFragmentRegistryVisitInto(
               admissionFacts, admissionFinalized,
               workspaceOwner, secondRegistry,
               input1, secondAdmission1, err), err)
    var secondReceipt: incremental.SemanticSnapshotFunctionFragmentCandidateReceipt
    assert(incremental.SemanticSnapshotFunctionFragmentCandidateFinalizeInto(
               workspaceOwner, secondRegistry, secondReceipt, err), err)
    assert(workspaceOwner.decodeCount == 1 &&
           secondRegistry.decodeCount == 0 &&
           secondRegistry.reuseCount == 2 &&
           secondReceipt.decodeCount == 0 &&
           secondReceipt.reuseCount == 2 &&
           secondReceipt.uniqueDecodedFragmentCount == 1 &&
           secondAdmission0.decodedRowId ==
               secondAdmission1.decodedRowId,
           " fragment registry: workspace decode-once drift")
    assert(incremental.SemanticSnapshotWorkspaceFunctionFragmentOwnerStrictValidateInto(
               workspaceOwner, err), err)

    var admissionAttackCount: int32
    var readReceiptAttack = input0
    readReceiptAttack.exactReadSetCid = ExactCid(43)
    assert(!incremental.SemanticSnapshotFunctionFragmentAdmissionInputStrictValidateInto(
                admissionFacts, admissionFinalized,
                readReceiptAttack, err),
           " fragment registry: unsealed exact read mutation accepted")
    admissionAttackCount = admissionAttackCount + 1

    var interfaceReceiptAttack = input0
    interfaceReceiptAttack.functionInterfaceCid = ExactCid(53)
    assert(!incremental.SemanticSnapshotFunctionFragmentAdmissionInputStrictValidateInto(
                admissionFacts, admissionFinalized,
                interfaceReceiptAttack, err),
           " fragment registry: unsealed function interface mutation accepted")
    admissionAttackCount = admissionAttackCount + 1

    var factsReceiptAttack = input1
    factsReceiptAttack.factsCid = ExactCid(205)
    assert(!incremental.SemanticSnapshotFunctionFragmentAdmissionInputStrictValidateInto(
                admissionFacts, admissionFinalized,
                factsReceiptAttack, err),
           " fragment registry: unsealed facts mutation accepted")
    admissionAttackCount = admissionAttackCount + 1

    var versionReceiptAttack = input2
    versionReceiptAttack.sourceVersion = sourceVersion + int64(1)
    assert(!incremental.SemanticSnapshotFunctionFragmentAdmissionInputStrictValidateInto(
                admissionFacts, admissionFinalized,
                versionReceiptAttack, err),
           " fragment registry: unsealed source version mutation accepted")
    admissionAttackCount = admissionAttackCount + 1

    # The input and cache row are coherently poisoned together. Admission is
    # still rejected because neither belongs to the registry's finalized
    # read-set receipt for this function.
    let poisonedRead0 = ExactReadCid(
        function0, ExactCid(30), ExactCid(43))
    var poisonedFinalized = admissionFinalized
    poisonedFinalized.readSetPreimageCids = [
        poisonedRead0, read1, read2]
    poisonedFinalized.readSet.observedValueCids = [
        ExactCid(43), ExactCid(41), ExactCid(42)]
    poisonedFinalized.readSet.reverseObservedValueCids = [
        ExactCid(43), ExactCid(41), ExactCid(42)]
    poisonedFinalized.receiptCid =
        incremental.SemanticSnapshotIncrementalFinalizedReadSetReceiptCid(
            poisonedFinalized)
    let poisonedInput = AdmissionInput(
        admissionFacts, poisonedFinalized, 0)
    let poisonedCache = BuildCache([FragmentCacheRowSpecMake(
        function0, source0, ExactCid(50), poisonedRead0,
        schemaCid, compilerCid, targetCid,
        strings.CloneStr(sharedPayload))])
    var poisonedOwner: incremental.SemanticSnapshotWorkspaceFunctionFragmentOwner
    assert(incremental.SemanticSnapshotWorkspaceFunctionFragmentOwnerInitInto(
               ExactCid(215), schemaCid, compilerCid, targetCid,
               poisonedCache.cacheCid, poisonedCache,
               poisonedOwner, err), err)
    var poisonedRegistry: incremental.SemanticSnapshotDecodedFunctionFragmentRegistry
    assert(incremental.SemanticSnapshotDecodedFunctionFragmentRegistryInitInto(
               ExactCid(216), 1, sourceVersion, factsCid,
               finalizedReadSetReceiptCid,
               poisonedOwner, poisonedRegistry, err), err)
    var rejectedPoisonedAdmission: incremental.SemanticSnapshotFunctionFragmentAdmission
    assert(!incremental.SemanticSnapshotDecodedFunctionFragmentRegistryVisitInto(
                admissionFacts, admissionFinalized,
                poisonedOwner, poisonedRegistry, poisonedInput,
                rejectedPoisonedAdmission, err),
           " fragment registry: jointly poisoned input and cache row accepted")
    admissionAttackCount = admissionAttackCount + 1
    assert(admissionAttackCount == 5,
           " fragment registry: admission attack count drift")

    let mutationSpec = FragmentCacheRowSpecMake(
        function0, source0, ExactCid(50), read0, schemaCid, compilerCid,
        targetCid, sharedPayload)
    var mutationCount: int32

    # mutation:key_cid
    var keyAttack = BuildCache([mutationSpec])
    keyAttack.keyCids[0] = ExactCid(91)
    ExpectCacheMutationRejected(keyAttack, "key CID mutation accepted")
    mutationCount = mutationCount + 1

    # mutation:function_interface_hash
    var interfaceAttack = BuildCache([mutationSpec])
    interfaceAttack.functionInterfaceCids[0] = ExactCid(99)
    ExpectCacheMutationRejected(
        interfaceAttack, "function interface hash mutation accepted")
    mutationCount = mutationCount + 1

    # mutation:fragment_cid
    var fragmentAttack = BuildCache([mutationSpec])
    fragmentAttack.fragmentCids[0] = ExactCid(92)
    ExpectCacheMutationRejected(fragmentAttack,
                                "fragment CID mutation accepted")
    mutationCount = mutationCount + 1

    # mutation:function_body_content_hash
    var bodyAttack = BuildCache([mutationSpec])
    bodyAttack.bodyContentCids[0] = ExactCid(93)
    ExpectCacheMutationRejected(bodyAttack,
                                "body content hash mutation accepted")
    mutationCount = mutationCount + 1

    # mutation:external_exact_read_set_interface_hash
    var readAttack = BuildCache([mutationSpec])
    readAttack.exactReadSetCids[0] = ExactCid(94)
    ExpectCacheMutationRejected(
        readAttack, "external read-set interface hash mutation accepted")
    mutationCount = mutationCount + 1

    # mutation:schema_identity
    var schemaAttack = BuildCache([mutationSpec])
    schemaAttack.schemaCids[0] = ExactCid(95)
    ExpectCacheMutationRejected(schemaAttack,
                                "schema identity mutation accepted")
    mutationCount = mutationCount + 1

    # mutation:compiler_identity
    var compilerAttack = BuildCache([mutationSpec])
    compilerAttack.compilerCids[0] = ExactCid(96)
    ExpectCacheMutationRejected(compilerAttack,
                                "compiler identity mutation accepted")
    mutationCount = mutationCount + 1

    # mutation:target_identity
    var targetAttack = BuildCache([mutationSpec])
    targetAttack.targetCids[0] = ExactCid(97)
    ExpectCacheMutationRejected(targetAttack,
                                "target identity mutation accepted")
    mutationCount = mutationCount + 1

    # mutation:payload_byte_length
    var lengthAttack = BuildCache([mutationSpec])
    lengthAttack.payloadByteLengths[0] =
        lengthAttack.payloadByteLengths[0] - 1
    ExpectCacheMutationRejected(lengthAttack,
                                "payload byte length mutation accepted")
    mutationCount = mutationCount + 1

    # mutation:trailing_bytes
    var trailingAttack = BuildCache([mutationSpec])
    trailingAttack.payloads[0] = strutil.Join(
        [trailingAttack.payloads[0], "x"], "")
    ExpectCacheMutationRejected(trailingAttack,
                                "trailing bytes mutation accepted")
    mutationCount = mutationCount + 1

    # mutation:payload_bytes_same_length
    var payloadAttack = BuildCache([mutationSpec])
    payloadAttack.payloads[0] = MutatePayloadByte(
        payloadAttack.payloads[0])
    ExpectCacheMutationRejected(payloadAttack,
                                "payload bytes mutation accepted")
    mutationCount = mutationCount + 1

    # mutation:cache_cid
    var cacheCidAttack = BuildCache([mutationSpec])
    cacheCidAttack.cacheCid = ExactCid(98)
    ExpectCacheMutationRejected(cacheCidAttack,
                                "cache CID mutation accepted")
    mutationCount = mutationCount + 1

    assert(mutationCount == 12,
           " fragment registry: mutation gate count drift")
    os.WriteLine(os.Get_stdout(),
                 "semantic_snapshot_fragment_registry_mutation_count=12")
    os.WriteLine(os.Get_stdout(),
                 "semantic_snapshot_fragment_registry_admission_attack_count=5")
    os.WriteLine(os.Get_stdout(),
                 "semantic_snapshot_fragment_registry_decode_count=1")
    os.WriteLine(os.Get_stdout(),
                 "semantic_snapshot_fragment_registry_visit_count=3")
    os.WriteLine(os.Get_stdout(),
                 "semantic_snapshot_fragment_registry_lower_count=1")
    os.WriteLine(os.Get_stdout(),
                 "semantic_snapshot_fragment_workspace_decode_count=1")
    os.WriteLine(os.Get_stdout(),
                 "semantic_snapshot_fragment_second_candidate_decode_count=0")
    os.WriteLine(os.Get_stdout(),
                 "semantic_snapshot_fragment_cache_validation_count=1")
    os.WriteLine(os.Get_stdout(),
                 "semantic_snapshot_function_fragment_registry_smoke: ok")
