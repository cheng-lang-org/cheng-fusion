type
    ColdCrossModulePlan =
        command: str
        prompt: str
        resumeSessionId: str
        resumeLast: bool
        resumeAll: bool
        images: str[]
        model: str
        cwd: str
        sandbox: str
        color: str
        json: bool
        help: bool
        outputLastMessage: str
        outputSchema: str
        skipGitRepoCheck: bool
        ephemeral: bool
        ignoreUserConfig: bool
        ignoreRules: bool
        removedFullAuto: bool
        dangerouslyBypassApprovalsAndSandbox: bool
        oss: bool
        ossProvider: str
        configProfile: str
        configOverrides: str[]
        addDirs: str[]
        reviewUncommitted: bool
        reviewBase: str
        reviewCommit: str
        reviewTitle: str
        reasoningEffort: str
        reasoningSummary: str
        maxTurns: int32
        appServerUrl: str
        parseError: str

fn ColdCrossModulePlanDefault(): ColdCrossModulePlan =
    var result: ColdCrossModulePlan
    result.command = "run"
    result.color = "auto"
    result.maxTurns = 7
    return result

fn ColdCrossModulePlanParse(args: str[]): ColdCrossModulePlan =
    var plan = ColdCrossModulePlanDefault()
    if args.len > 0:
        plan.model = args[0]
    if args.len > 1:
        plan.cwd = args[1]
    return plan
