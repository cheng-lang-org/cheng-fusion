import cheng/core/lang/parser as parser

fn main() =
    let source =
        "fn main() int32 =\n    if true: if true: return 1\n    return 0\n"
    var layer: parser.NormalizedExprLayer
    var err: str
    assert(parser.ParserReadNormalizedExprLayerFromText(
               "parser_nested_inline_condition_writeback.cheng",
               source,
               layer,
               err),
           Fmt"parser nested inline condition: parse failed {err}")
    var conditionCount: int32
    for exprIndex in 0..<layer.exprs.len:
        assert(layer.exprs[exprIndex].lineNumber > 0 &&
               layer.exprs[exprIndex].sourcePath != "",
               Fmt"parser nested inline condition: row drained row={exprIndex}")
        if layer.exprs[exprIndex].kind == parser.NormalizedExprIf &&
           layer.exprs[exprIndex].detailKind ==
               parser.NormalizedExprDetailIfKeyword:
            assert(layer.exprs[exprIndex].valueExprRootNodeIndex >= 0 &&
                   layer.exprs[exprIndex].valueExprStatementRole ==
                       parser.ParserValueExprStatementCondition,
                   Fmt"parser nested inline condition: identity missing row={exprIndex}")
            conditionCount = conditionCount + 1
    assert(conditionCount == 2,
           Fmt"parser nested inline condition: cardinality={conditionCount}")
    parser.NormalizedExprLayerReset(layer)
    echo("parser_nested_inline_condition_writeback=PASS")
