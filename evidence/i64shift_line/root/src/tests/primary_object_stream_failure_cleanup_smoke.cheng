import std/os
import std/strings
import cheng/core/tooling/compiler_request as creq
import cheng/core/backend/system_link_plan as slplan
import cheng/core/backend/lowering_plan as lower
import cheng/core/backend/primary_object_plan as pobj
import cheng/core/ir/core_types as coreir
import cheng/std/bytes_layout as layout

fn PayloadBody(): coreir.BodyIR =
    var body = coreir.BodyIRNew()
    var op: coreir.BodyOp
    op.kind = coreir.BodyOpLoadConstTag
    op.target = 0
    add(body.ops, op)
    add(body.cstringLiterals, "owned-payload")
    return body

fn AppendCallReloc(state: var pobj.PrimaryObjectPlanPhaseState,
                    itemId: int32,
                    offset: int32) =
    add(state.relocSourceItemIds, itemId)
    add(state.relocWordOffsets, offset)
    add(state.relocTargetSymbols, "Target")
    add(state.relocTargetDomainKinds,
        coreir.BodyCallTargetDomainInvalidTag)
    add(state.relocTargetRows, -1)
    add(state.relocTargetInterfaceCids, layout.FixedBytes32())
    add(state.relocCallOrdinal, -1)

fn AppendDataReloc(state: var pobj.PrimaryObjectPlanPhaseState,
                    itemId: int32,
                    offset: int32) =
    add(state.dataRelocSourceItemIds, itemId)
    add(state.dataRelocWordOffsets, offset)
    add(state.dataRelocPredictedKey, offset)
    add(state.dataRelocOpIndex, 0)
    add(state.dataRelocSubIndex, 0)
    add(state.dataRelocTargetSymbols, "Data")

fn FailureKind(mode: int32): str =
    if mode == 0:
        return "stream_function_layout_missing"
    if mode == 1:
        return "stream_function_upper_bound_invalid"
    if mode == 2:
        return "stream_function_emit_failed"
    if mode == 3:
        return "buffer_size_desync"
    if mode == 4:
        return "call_bl_reloc_no_fill_record"
    return "zero_instruction_word"

fn HasReason(reasons: str[], expected: str): bool =
    for i in 0..<reasons.len:
        if reasons[i] == expected:
            return true
    return false

fn VerifyAbortCleanup(mode: int32) =
    var state: pobj.PrimaryObjectPlanPhaseState
    add(state.functionWordOffsets, 17)
    add(state.functionWordCounts, 3)
    add(state.itemIds, 7)
    add(state.symbolNames, "FailureFn")
    add(state.functionBodyKinds, "statement_sequence")
    add(state.functionInstructionBodyKinds, "statement_sequence")
    add(state.functionStatementReturnModes, 0)
    add(state.functionStatementReturnI32Values, 0)
    add(state.functionStatementCallCounts, 0)
    add(state.functionIrIndexes, -1)
    state.totalWordCount = 20
    AppendCallReloc(state, 7, 4)
    AppendDataReloc(state, 7, 5)
    AppendCallReloc(state, 8, 9)
    AppendDataReloc(state, 8, 10)
    add(state.tempBodyIRs, coreir.BodyIRNew())
    add(state.tempBodyIRs, PayloadBody())
    add(state.functionBodyIRs, PayloadBody())
    state.streamedEmitFirst = true
    state.streamedFillFailedIndex = 0
    state.streamedBackpatchFailureKind = FailureKind(mode)
    state.streamedBackpatchCallOrdinal = mode
    state.streamedBackpatchDataOpIndex = mode + 10
    state.streamedBackpatchDataSubIndex = mode + 20

    var plan: pobj.PrimaryObjectPlan
    add(plan.instructionWords, 0x11111111)
    add(plan.instructionWords, 0x22222222)
    plan.bodyIRDodSoAFunctionCount = 11
    plan.bodyIRDodSoAOpCount = 12
    plan.bodyIRDodSoATermCount = 13
    plan.bodyIRDodSoAOpOperandCount = 14
    plan.bodyIRDodSoATermOperandCount = 15

    let snapshot = pobj.PrimaryObjectPlanStreamEmitSnapshotCapture(state,
                                                                    plan,
                                                                    0,
                                                                    1,
                                                                    1)
    add(plan.instructionWords, 0)
    add(plan.instructionWords, 0)
    plan.bodyIRDodSoAFunctionCount = 101
    plan.bodyIRDodSoAOpCount = 102
    plan.bodyIRDodSoATermCount = 103
    plan.bodyIRDodSoAOpOperandCount = 104
    plan.bodyIRDodSoATermOperandCount = 105
    state.functionWordOffsets[0] = 2
    state.functionWordCounts[0] = 2
    state.totalWordCount = 4

    var bodyIR = PayloadBody()
    assert(!pobj.PrimaryObjectPlanAbortStreamEmit(state,
                                                   plan,
                                                   bodyIR,
                                                   0,
                                                   0,
                                                   snapshot),
           " primary stream cleanup: failure return")
    assert(plan.instructionWords.len == 2 &&
           plan.instructionWords[0] == 0x11111111 &&
           plan.instructionWords[1] == 0x22222222,
           " primary stream cleanup: instruction rollback")
    assert(state.relocSourceItemIds.len == 1 &&
           state.relocWordOffsets.len == 1 &&
           state.relocTargetSymbols.len == 1 &&
           state.relocCallOrdinal.len == 1,
           " primary stream cleanup: call reloc rollback")
    assert(state.dataRelocSourceItemIds.len == 1 &&
           state.dataRelocWordOffsets.len == 1 &&
           state.dataRelocPredictedKey.len == 1 &&
           state.dataRelocOpIndex.len == 1 &&
           state.dataRelocSubIndex.len == 1 &&
           state.dataRelocTargetSymbols.len == 1,
           " primary stream cleanup: data reloc rollback")
    assert(state.functionWordOffsets[0] == 17 &&
           state.functionWordCounts[0] == 3 &&
           state.totalWordCount == 20,
           " primary stream cleanup: layout rollback")
    assert(plan.bodyIRDodSoAFunctionCount == 11 &&
           plan.bodyIRDodSoAOpCount == 12 &&
           plan.bodyIRDodSoATermCount == 13 &&
           plan.bodyIRDodSoAOpOperandCount == 14 &&
           plan.bodyIRDodSoATermOperandCount == 15,
           " primary stream cleanup: metric rollback")
    assert(bodyIR.ops.len == 0 && bodyIR.cstringLiterals.len == 0,
           " primary stream cleanup: current body released")
    assert(state.tempBodyIRs[0].ops.len == 0 &&
           state.tempBodyIRs[0].cstringLiterals.len == 0,
           " primary stream cleanup: source body released")
    assert(state.fillCheckReleasedBodyIrFunctionCount == 1 &&
           state.fillCheckReleasedBodyIrPayloadItemCount == 2,
           " primary stream cleanup: release accounting")
    assert(state.streamedFillFailedIndex == 0 &&
           state.streamedBackpatchFailureKind == FailureKind(mode),
           " primary stream cleanup: diagnostic preserved")
    assert(state.streamedBuildAborted &&
           state.streamedBuildAbortReason == FailureKind(mode) &&
           state.bodySemanticsMissing,
           " primary stream cleanup: abort state")
    let firstDiagnosticFunction = state.error.functionName
    let firstDiagnosticKind = state.error.bodyKind
    let firstDiagnosticDetail = state.error.callTarget
    pobj.PrimaryObjectPlanMarkDeclOrderStreamBuildAbort(state,
                                                         99,
                                                         "LaterFailure",
                                                         "later_failure")
    assert(state.error.functionName == firstDiagnosticFunction &&
           state.error.bodyKind == firstDiagnosticKind &&
           state.error.callTarget == firstDiagnosticDetail &&
           state.streamedBuildAbortReason == FailureKind(mode),
           " primary stream cleanup: first diagnostic stable")

    pobj.PrimaryObjectPlanReleaseAbortedBuildPayload(state, plan)
    assert(state.tempBodyIRs.len == 0 &&
           state.functionBodyIRs.len == 0 &&
           state.relocSourceItemIds.len == 0 &&
           state.dataRelocSourceItemIds.len == 0 &&
           plan.instructionWords.len == 0,
           " primary stream cleanup: aborted payload released")
    assert(state.fillCheckReleasedBodyIrFunctionCount == 3 &&
           state.fillCheckReleasedBodyIrPayloadItemCount == 6,
           " primary stream cleanup: all owner accounting")

    var linkPlan: slplan.SystemLinkPlanStub
    linkPlan.targetTriple = "arm64-apple-darwin"
    linkPlan.emitKind = creq.EmitObj
    linkPlan.outputPath = "/tmp/primary_object_stream_failure_cleanup.o"
    linkPlan.jobCount = 1
    var lowering: lower.LoweringPlanStub
    pobj.PrimaryObjectPlanFillAndCheckPhase(state, linkPlan, lowering, plan)
    assert(plan.fillCheckSkippedForBuildAbort &&
           plan.streamedBuildAborted &&
           plan.streamedBuildAbortReason == FailureKind(mode) &&
           plan.instructionWords.len == 0,
           " primary stream cleanup: no fill after build abort")
    pobj.PrimaryObjectPlanDiagnoseAndFinalizePhase(state, linkPlan, lowering, plan)
    assert(HasReason(plan.missingReasons, "primary_object_decl_order_stream_failed") &&
           HasReason(plan.missingReasons, "primary_object_body_semantics_missing") &&
           HasReason(plan.missingReasons, "primary_object_machine_words_missing"),
           " primary stream cleanup: explicit not-ready reasons")
    assert(plan.error.functionName == firstDiagnosticFunction &&
           plan.error.bodyKind == firstDiagnosticKind &&
           plan.error.callTarget == firstDiagnosticDetail,
           " primary stream cleanup: finalize diagnostic stable")
    assert(pobj.PrimaryObjectPlanRetainedBodyIrPayloadItemCount(plan) == 0 &&
           pobj.PrimaryObjectPlanRetainedCompactItemCount(plan) == 0,
           " primary stream cleanup: owner payload zero")

fn VerifyNoStreamFailurePanicText() =
    let root = os.GetEnvDefault("CHENG_SMOKE_ROOT", os.GetCurrentDir())
    let sourcePath = os.JoinPath(root, "src/core/backend/primary_object_plan.cheng")
    let sourceText = os.ReadFile(sourcePath)
    assert(!strings.StrContains(sourceText,
                                "primary_object_decl_order_stream emit_failed"),
           " primary stream cleanup: emit failure must propagate")
    assert(!strings.StrContains(sourceText,
                                "primary_object_decl_order_stream build_items_failed"),
           " primary stream cleanup: body semantics failure must propagate")
    assert(!strings.StrContains(sourceText,
                                "primary_object_decl_order_stream post_release_zero_scan_failed"),
           " primary stream cleanup: post-release zero failure must propagate")
    assert(!strings.StrContains(sourceText,
                                "primary_object_decl_order_stream reachability_failed"),
           " primary stream cleanup: reachability failure must propagate")
    assert(strings.StrContains(sourceText,
                               "if !state.bodySemanticsMissing &&\n       !state.streamedBuildAborted &&\n       linkPlan.emitKind == creq.EmitExe"),
           " primary stream cleanup: entry bridge gated after abort")
    assert(strings.StrContains(sourceText,
                               "if state.streamedBuildAborted:\n        state.fillCheckSkippedForBuildAbort = true"),
           " primary stream cleanup: fill gate must precede fill")

fn VerifyBodySemanticsStopsBuild(root: str) =
    let sourcePath = os.JoinPath(root,
                                 "src/tests/exec_diff_corpus/datareloc_ordinal_stress.cheng")
    let request0 = creq.CompilerRequestNew(root,
                                           sourcePath,
                                           "/tmp/primary_object_stream_body_semantics_failure.o",
                                           "arm64-apple-darwin",
                                           creq.EmitObj,
                                           "")
    let request = creq.CompilerRequestWithExportRootSymbols(request0, ["main"])
    var linkPlan: slplan.SystemLinkPlanStub
    var err = ""
    assert(slplan.BuildSystemLinkPlanStub(root, request, linkPlan, err),
           " primary stream cleanup: body semantics link plan")
    var lowering: lower.LoweringPlanStub
    assert(lower.BuildLoweringPlanStub(linkPlan, lowering, err),
           " primary stream cleanup: body semantics lowering plan")
    lower.LoweringPlanReleasePrePrimaryObjectPayload(lowering)
    lowering.primaryObjectIr.functions = []
    lowering.primaryObjectIrFunctions = []
    var plan: pobj.PrimaryObjectPlan
    pobj.BuildPrimaryObjectPlanInto(linkPlan, lowering, plan)
    lower.LoweringPlanReleaseAfterPrimaryObjectPlan(lowering)
    assert(plan.streamedEmitFirst &&
           plan.streamedBuildAborted &&
           plan.fillCheckSkippedForBuildAbort &&
           plan.wordFillSchedule == "decl_order_stream_aborted",
           " primary stream cleanup: body semantics state machine")
    assert(plan.error.functionName != "" &&
           plan.error.bodyKind == "missing_primary_object_ir",
           " primary stream cleanup: body semantics diagnostic")
    assert(HasReason(plan.missingReasons, "primary_object_decl_order_stream_failed") &&
           HasReason(plan.missingReasons, "primary_object_body_semantics_missing"),
           " primary stream cleanup: body semantics not-ready")
    assert(plan.instructionWords.len == 0 &&
           plan.relocSourceItemIds.len == 0 &&
           plan.dataRelocSourceItemIds.len == 0 &&
           pobj.PrimaryObjectPlanRetainedBodyIrPayloadItemCount(plan) == 0,
           " primary stream cleanup: body semantics owner payload zero")
    lower.LoweringPlanReleaseAllPayload(lowering)

fn main(): int32 =
    for mode in 0..<6:
        VerifyAbortCleanup(mode)
    VerifyNoStreamFailurePanicText()
    VerifyBodySemanticsStopsBuild(os.GetEnvDefault("CHENG_SMOKE_ROOT", os.GetCurrentDir()))
    echo("primary_object_stream_failure_cleanup_smoke ok failures=6 body_semantics=1 owner_payload=0")
    return 0
