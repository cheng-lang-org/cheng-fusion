type R5Task = object
    modulePath: str

fn R5ArrShareLive(tasks: R5Task[]): int32 =
    let kept = share(tasks)
    var total = 0
    for i in 0..<kept.len:
        total = total + kept[i].modulePath.len
    for i in 0..<tasks.len:
        total = total + tasks[i].modulePath.len
    return total + kept.len + tasks.len

fn main(): int32 =
    var made: R5Task[]
    var t: R5Task
    t.modulePath = "abc"
    add(made, t)
    var u: R5Task
    u.modulePath = "de"
    add(made, u)
    let got = R5ArrShareLive(made)
    if got != 14:
        return 10
    echo(Fmt"r5_arr_share_live ok total={got}")
    return 0
