# ML-KEM-768 (FIPS 203) full KEM smoke test, three levels:
#   1. Self-consistency: KeyGen_internal -> Encaps_internal -> Decaps_internal
#      shared secrets match for 10 fixed seed groups; tampering any single
#      ciphertext byte triggers implicit rejection (K = J(z || c'), != K_enc,
#      no crash). One round each for the 512/1024 parameter sets.
#   2. Encoding sizes: ek/dk/c/K lengths match the FIPS 203 table
#      (ML-KEM-768: ek=1184 dk=2400 c=1088 K=32) and the ek modulus /
#      dk hash input-validation checks accept genuine and reject corrupted
#      keys.
#   3. Official KAT (final FIPS 203 semantics, G(d || k) domain separation):
#      a) first 3 vectors of kat_MLKEM_768.rsp from
#         github.com/post-quantum-cryptography/KAT, d/z/m -> ek/dk/c/K plus
#         the implicit-rejection vectors ct_n/ss_n;
#      b) NIST ACVP vectors from github.com/usnistgov/ACVP-Server
#         (gen-val/json-files, internalProjection.json): ML-KEM-768 keyGen
#         tcId=26, encapsulation tcId=26, decapsulation tcId=89 (valid) and
#         tcId=86 (modified ciphertext -> implicit rejection).
#      Note: C2SP/CCTV ML-KEM vectors target the FIPS 203 *draft* (ipd,
#      G without the k byte) and are deliberately not used.

import std/system
import std/strings
import std/rawbytes
import std/crypto/sha3
import std/crypto/mlkem as mlkem

const
    kat0D = "6dbbc4375136df3b07f7c70e639e223e177e7fd53b161b3f4d57791794f12624"
    kat0Z = "f696484048ec21f96cf50a56d0759c448f3779752f0383d37449690694cf7a68"
    kat0Msg = "20a7b7e10f70496cc38220b944def699bf14d14e55cf4c90a12c1b33fc80ffff"
    kat0Pk = ""
    kat0Sk = ""
    kat0Ct = ""
    kat0Ss = "b408d5d115713f0a93047dbbea832e4340787686d59a9a2d106bd662ba0aa035"
    kat0CtN = ""
    kat0SsN = "e7bcf899feb5db69d11741a8838ecfee253e80b76d6a35af46e220e81dc41daf"
    kat1D = "d69cfc64f84d4f33e4c54e166b7ff9283a394986a539b23987a10f39d2d9689b"
    kat1Z = "6de62e3465a55c9c78a07d265be8540b3e58b0801a124d07ff12b438d5202ea0"
    kat1Msg = "0121cb32acd1871135cb34e29c1a0e26ccc001b939eafaacc28f13f1938dbf91"
    kat1Pk = ""
    kat1Sk = ""
    kat1Ct = ""
    kat1Ss = "8c970242406111e26368ad8760c4d02a8b28d17d138210adc127197b50968140"
    kat1CtN = ""
    kat1SsN = "4069db9997536757c9b12f026ffb3d02f435559df63214711750cd04b1f05d5f"
    kat2D = "63470357110828f25b23edc80ed280ecd398a9f53251c3332754de2af0b15e90"
    kat2Z = "1eaae6bb91b27cd748c402c4111140d5a942cf3c95ff7977f88d2ef515bb26d0"
    kat2Msg = "34b961af5d6254af72c0d50e70dd9b4991150ccc09192aa46f1953d5c29a33ec"
    kat2Pk = ""
    kat2Sk = ""
    kat2Ct = ""
    kat2Ss = "c0d45764e3dbf0948b914d6f65c92bd0ebd21556e5076753af48df8fffd6badc"
    kat2CtN = ""
    kat2SsN = "488552101a21c9cd873146b83fed69d26376f700312566ca6b6df07bd5585d59"
    acvpKgD = "e582b7d75e6c80b05ae392a1fc9f7153b12390fd99930368cc67a768baebc8a0"
    acvpKgZ = "1cdacb8740c0b87c4a379575f187b367cbfa3b300bf591b109f79816e9cbe8f0"
    acvpKgEk = ""
    acvpKgDk = ""
    acvpEncEk = ""
    acvpEncDk = ""
    acvpEncM = "7d5201502fad05b1463bc2212d6aec1c8503204c491f12d9366ae750144b7831"
    acvpEncC = ""
    acvpEncK = "11b62291b1a9d307c8240d70be0b45436db445793173f6e79fcd2b273d7f3b01"
    acvpDecOkDk = ""
    acvpDecOkC = ""
    acvpDecOkK = "96980f7c1b160a45a8f56fb38d38d7faec7844ddf617fa47522ca2998605a71c"
    acvpDecModDk = ""
    acvpDecModC = ""
    acvpDecModK = "9652336bb52a7ad8f781e6d8c00e798fefa7071211d39fc9987779727fd9270c"

fn hexVal(c: int32): int32 =
    if c >= 48 && c <= 57:
        return c - 48
    if c >= 97 && c <= 102:
        return c - 87
    if c >= 65 && c <= 70:
        return c - 55
    Assert(false, "hexToBytes: invalid hex character")
    return 0

fn hexToBytes(s: str): Bytes =
    let raw: Bytes = BytesFromString(s)
    let n: int32 = BytesLen(raw)
    Assert(n % 2 == 0, "hexToBytes: odd length")
    let out: Bytes = BytesAlloc(n / 2)
    for i in 0..<(n / 2):
        BytesSet(out, i, hexVal(BytesGet(raw, 2 * i)) * 16 + hexVal(BytesGet(raw, 2 * i + 1)))
    return out

# Deterministic 32-byte test seeds: SHAKE256(group || label, 32).
fn deriveSeed(group: int32, label: int32): Bytes =
    let input: Bytes = BytesAlloc(2)
    BytesSet(input, 0, group)
    BytesSet(input, 1, label)
    return Shake256Xof(input, 32)

fn selfConsistencyRound(name: str, p: mlkem.MlkemParams, group: int32): bool =
    let d: Bytes = deriveSeed(group, 1)
    let z: Bytes = deriveSeed(group, 2)
    let m: Bytes = deriveSeed(group, 3)
    let kp: mlkem.MlkemKeyPair = mlkem.MlkemKeyGenInternal(p, d, z)
    if BytesLen(kp.ek) != mlkem.MlkemEkLen(p) || BytesLen(kp.dk) != mlkem.MlkemDkLen(p):
        echo(Fmt"mlkem {name} group {group}: key lengths wrong: ek={BytesLen(kp.ek)} dk={BytesLen(kp.dk)}")
        return false
    let enc: mlkem.MlkemEncapsResult = mlkem.MlkemEncapsInternal(p, kp.ek, m)
    if BytesLen(enc.ciphertext) != mlkem.MlkemCtLen(p) || BytesLen(enc.sharedSecret) != 32:
        echo(Fmt"mlkem {name} group {group}: encaps lengths wrong: c={BytesLen(enc.ciphertext)} K={BytesLen(enc.sharedSecret)}")
        return false
    let kDec: Bytes = mlkem.MlkemDecapsInternal(p, kp.dk, enc.ciphertext)
    if !BytesEqual(kDec, enc.sharedSecret):
        echo(Fmt"mlkem {name} group {group}: decaps shared secret mismatch")
        return false
    # Tamper one ciphertext byte: implicit rejection must yield J(z || c'),
    # which differs from the encapsulated key, without crashing.
    let cBad: Bytes = BytesSlice(enc.ciphertext, 0, BytesLen(enc.ciphertext))
    let pos: int32 = (group * 109 + 7) % BytesLen(cBad)
    BytesSet(cBad, pos, (BytesGet(cBad, pos) + 1) & 255)
    let kBad: Bytes = mlkem.MlkemDecapsInternal(p, kp.dk, cBad)
    if BytesLen(kBad) != 32:
        echo(Fmt"mlkem {name} group {group}: rejected decaps output length wrong")
        return false
    if BytesEqual(kBad, enc.sharedSecret):
        echo(Fmt"mlkem {name} group {group}: tampered ciphertext still yields the shared secret")
        return false
    if !BytesEqual(kBad, Shake256Xof(BytesConcat(z, cBad), 32)):
        echo(Fmt"mlkem {name} group {group}: implicit rejection output is not J(z || c)")
        return false
    return true

fn testSelfConsistency(): bool =
    let p768: mlkem.MlkemParams = mlkem.MlkemParams768()
    for group in 0..<10:
        if !selfConsistencyRound("768", p768, group):
            return false
    if !selfConsistencyRound("512", mlkem.MlkemParams512(), 0):
        return false
    if !selfConsistencyRound("1024", mlkem.MlkemParams1024(), 0):
        return false
    return true

fn testEncodingSizes(): bool =
    let p: mlkem.MlkemParams = mlkem.MlkemParams768()
    if mlkem.MlkemEkLen(p) != 1184 || mlkem.MlkemDkLen(p) != 2400 || mlkem.MlkemCtLen(p) != 1088 || mlkem.MlkemSharedSecretLen() != 32:
        echo(Fmt"mlkem 768 FIPS table mismatch: ek={mlkem.MlkemEkLen(p)} dk={mlkem.MlkemDkLen(p)} c={mlkem.MlkemCtLen(p)} K={mlkem.MlkemSharedSecretLen()}")
        return false
    let kp: mlkem.MlkemKeyPair = mlkem.MlkemKeyGenInternal(p, deriveSeed(99, 1), deriveSeed(99, 2))
    if BytesLen(kp.ek) != 1184 || BytesLen(kp.dk) != 2400:
        echo(Fmt"mlkem 768 actual key lengths wrong: ek={BytesLen(kp.ek)} dk={BytesLen(kp.dk)}")
        return false
    if !mlkem.MlkemEkValid(p, kp.ek):
        echo("mlkem 768: genuine ek rejected by validation")
        return false
    if !mlkem.MlkemDkValid(p, kp.dk):
        echo("mlkem 768: genuine dk rejected by validation")
        return false
    # Non-canonical coefficient (4095 >= q) must fail the modulus check.
    let ekBad: Bytes = BytesSlice(kp.ek, 0, 1184)
    BytesSet(ekBad, 0, 255)
    BytesSet(ekBad, 1, 255)
    BytesSet(ekBad, 2, 255)
    if mlkem.MlkemEkValid(p, ekBad):
        echo("mlkem 768: non-canonical ek passed validation")
        return false
    # Corrupted H(ek) section must fail the dk hash check.
    let dkBad: Bytes = BytesSlice(kp.dk, 0, 2400)
    BytesSet(dkBad, 2336, (BytesGet(dkBad, 2336) + 1) & 255)
    if mlkem.MlkemDkValid(p, dkBad):
        echo("mlkem 768: corrupted dk hash passed validation")
        return false
    return true

fn katCheck(label: str, dHex: str, zHex: str, mHex: str, ekHex: str, dkHex: str,
            ctHex: str, ssHex: str, ctnHex: str, ssnHex: str): bool =
    let p: mlkem.MlkemParams = mlkem.MlkemParams768()
    let kp: mlkem.MlkemKeyPair = mlkem.MlkemKeyGenInternal(p, hexToBytes(dHex), hexToBytes(zHex))
    if !streq(BytesToHex(kp.ek), ekHex):
        echo(Fmt"mlkem KAT {label}: ek mismatch")
        echo(BytesToHex(kp.ek))
        return false
    if !streq(BytesToHex(kp.dk), dkHex):
        echo(Fmt"mlkem KAT {label}: dk mismatch")
        echo(BytesToHex(kp.dk))
        return false
    let enc: mlkem.MlkemEncapsResult = mlkem.MlkemEncapsInternal(p, kp.ek, hexToBytes(mHex))
    if !streq(BytesToHex(enc.ciphertext), ctHex):
        echo(Fmt"mlkem KAT {label}: ciphertext mismatch")
        echo(BytesToHex(enc.ciphertext))
        return false
    if !streq(BytesToHex(enc.sharedSecret), ssHex):
        echo(Fmt"mlkem KAT {label}: encaps shared secret mismatch")
        echo(BytesToHex(enc.sharedSecret))
        return false
    let kDec: Bytes = mlkem.MlkemDecapsInternal(p, kp.dk, enc.ciphertext)
    if !streq(BytesToHex(kDec), ssHex):
        echo(Fmt"mlkem KAT {label}: decaps shared secret mismatch")
        echo(BytesToHex(kDec))
        return false
    let kRej: Bytes = mlkem.MlkemDecapsInternal(p, kp.dk, hexToBytes(ctnHex))
    if !streq(BytesToHex(kRej), ssnHex):
        echo(Fmt"mlkem KAT {label}: implicit rejection shared secret mismatch")
        echo(BytesToHex(kRej))
        return false
    return true

fn acvpDecapsCheck(label: str, dkHex: str, cHex: str, kHex: str): bool =
    let p: mlkem.MlkemParams = mlkem.MlkemParams768()
    let kDec: Bytes = mlkem.MlkemDecapsInternal(p, hexToBytes(dkHex), hexToBytes(cHex))
    if !streq(BytesToHex(kDec), kHex):
        echo(Fmt"mlkem KAT {label}: decaps shared secret mismatch")
        echo(BytesToHex(kDec))
        return false
    return true

fn testKat(): bool =
    if !katCheck("rsp count=0", kat0D, kat0Z, kat0Msg, kat0Pk, kat0Sk, kat0Ct, kat0Ss, kat0CtN, kat0SsN):
        return false
    if !katCheck("rsp count=1", kat1D, kat1Z, kat1Msg, kat1Pk, kat1Sk, kat1Ct, kat1Ss, kat1CtN, kat1SsN):
        return false
    if !katCheck("rsp count=2", kat2D, kat2Z, kat2Msg, kat2Pk, kat2Sk, kat2Ct, kat2Ss, kat2CtN, kat2SsN):
        return false
    let p: mlkem.MlkemParams = mlkem.MlkemParams768()
    # ACVP keyGen: d/z -> ek/dk.
    let kp: mlkem.MlkemKeyPair = mlkem.MlkemKeyGenInternal(p, hexToBytes(acvpKgD), hexToBytes(acvpKgZ))
    if !streq(BytesToHex(kp.ek), acvpKgEk) || !streq(BytesToHex(kp.dk), acvpKgDk):
        echo("mlkem KAT acvp keyGen: ek/dk mismatch")
        return false
    # ACVP encapsulation: ek/m -> c/k, and decapsulating c with dk yields k.
    let enc: mlkem.MlkemEncapsResult = mlkem.MlkemEncapsInternal(p, hexToBytes(acvpEncEk), hexToBytes(acvpEncM))
    if !streq(BytesToHex(enc.ciphertext), acvpEncC) || !streq(BytesToHex(enc.sharedSecret), acvpEncK):
        echo("mlkem KAT acvp encapsulation: c/k mismatch")
        return false
    if !acvpDecapsCheck("acvp encapsulation decaps", acvpEncDk, acvpEncC, acvpEncK):
        return false
    if !acvpDecapsCheck("acvp valid decapsulation", acvpDecOkDk, acvpDecOkC, acvpDecOkK):
        return false
    if !acvpDecapsCheck("acvp modified ciphertext", acvpDecModDk, acvpDecModC, acvpDecModK):
        return false
    return true

fn main(): int32 =
    if !testSelfConsistency():
        return 1
    if !testEncodingSizes():
        return 1
    if !testKat():
        return 1
    echo(" mlkem_kem_smoke ok: self-consistency(768 x10 + 512 + 1024, tamper-reject x12) sizes(ek=1184 dk=2400 c=1088 K=32, ek/dk validation) kat(rsp count=0..2 incl ct_n/ss_n; acvp keyGen+encaps+decaps incl implicit rejection) all passed")
    return 0
