import std/os as os
import std/strings
import cheng/core/csg_core/json_field as field

@borrows
fn probe(line: str): str =
    let raw = field.CsgCoreJsonTopRawField(line, "a")
    if !raw.found:
        return "missing"
    return raw.value

fn main(): int32 =
    let text = "{\"a\":0}\n"
    let line = strings.CloneStrRange(text, 0, text.len - 1)
    let out = probe(line)
    os.WriteLine(os.Get_stdout(), out)
    os.WriteLine(os.Get_stdout(), "repro ok")
    return 0
