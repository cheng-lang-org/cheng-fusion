type
    ColdAdjacentSeqFields =
        padding: int32[122]
        bucketHeads: int32[]
        names: str[]
        indexes: int32[]
        next: int32[]
        builtCount: int32

fn coldAdjacentSeqFieldsPrepare(state: var ColdAdjacentSeqFields) =
    state.bucketHeads = []
    state.names = []
    state.indexes = []
    state.next = []
    for i in 0..<12:
        add(state.bucketHeads, -1)
    for i in 0..<5:
        add(state.names, "scope")
        add(state.indexes, i)
        add(state.next, -1)
    state.builtCount = 5

fn coldAdjacentSeqFieldsBorrowedView(
        state: var ColdAdjacentSeqFields): ColdAdjacentSeqFields =
    var out = state
    return out

fn coldAdjacentSeqFieldsAppendMove(
        states: var ColdAdjacentSeqFields[],
        state: var ColdAdjacentSeqFields) =
    add(states, state)

fn coldAdjacentSeqFieldsCheck(state: var ColdAdjacentSeqFields): int32 =
    if state.bucketHeads.len != 12 || state.bucketHeads[11] != -1:
        return 1
    if state.names.len != 5 || state.names[4] != "scope":
        return 2
    if state.indexes.len != 5 || state.indexes[4] != 4:
        return 3
    if state.next.len != 5 || state.next[4] != -1:
        return 4
    if state.builtCount != 5:
        return 5
    return 0

fn main(): int32 =
    var owner: ColdAdjacentSeqFields
    coldAdjacentSeqFieldsPrepare(owner)
    let ownerRc = coldAdjacentSeqFieldsCheck(owner)
    if ownerRc != 0:
        return 10 + ownerRc

    var view = coldAdjacentSeqFieldsBorrowedView(owner)
    let viewRc = coldAdjacentSeqFieldsCheck(view)
    if viewRc != 0:
        return 20 + viewRc

    var states: ColdAdjacentSeqFields[]
    coldAdjacentSeqFieldsAppendMove(states, view)
    if states.len != 1:
        return 30
    let storedRc = coldAdjacentSeqFieldsCheck(states[0])
    if storedRc != 0:
        return 30 + storedRc
    return 0
