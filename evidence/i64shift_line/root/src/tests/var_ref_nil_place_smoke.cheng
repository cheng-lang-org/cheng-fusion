type
    VarRefNilPlaceCell = ref object
        value: int32

    VarRefNilPlaceHolder =
        cell: VarRefNilPlaceCell

    VarRefValuePlaceCell =
        value: int32

fn VarRefNilPlaceClear(cell: var VarRefNilPlaceCell): bool =
    if cell == nil:
        return false
    cell.value = 0
    cell = nil
    return true

fn VarRefValuePlaceSet(cell: var VarRefValuePlaceCell, value: int32) =
    cell.value = value

fn main(): int32 =
    var empty: VarRefNilPlaceCell
    if VarRefNilPlaceClear(empty):
        return 11
    if empty != nil:
        return 12
    var live = new(VarRefNilPlaceCell)
    live.value = 7
    if !VarRefNilPlaceClear(live):
        return 13
    if live != nil:
        return 14
    var holder: VarRefNilPlaceHolder
    if VarRefNilPlaceClear(holder.cell):
        return 15
    holder.cell = new(VarRefNilPlaceCell)
    holder.cell.value = 9
    if !VarRefNilPlaceClear(holder.cell):
        return 16
    if holder.cell != nil:
        return 17
    var valueCell: VarRefValuePlaceCell
    VarRefValuePlaceSet(valueCell, 23)
    if valueCell.value != 23:
        return 18
    return 0
