import cheng/core/backend2/backend2_frag_codec as codec
import cheng/core/ir/core_types as coreir
import cheng/std/bytes_layout as layout
import std/os as os
import std/rawbytes as rawbytes
import std/result

const
    codecCleanupIntentColumnCount: int32 = 47
    codecCleanupScheduleColumnCount: int32 = 27
    codecCleanupReplayColumnCount: int32 = 3

fn canonicalEmptyCleanupAuthorityBytes(): int32 =
    let intentFixedBytes = 32 + 2 * 4 + 4 * 32 + 5 * 4
    let scheduleFixedBytes = 2 * 4 + 2 * 32
    let replayFixedBytes = 2 * 4 + 32
    return 4 + intentFixedBytes +
           codecCleanupIntentColumnCount * 4 +
           scheduleFixedBytes +
           codecCleanupScheduleColumnCount * 4 +
           replayFixedBytes + codecCleanupReplayColumnCount * 4

fn entryDefinitionTagOffset(current: rawbytes.Bytes): int32 =
    let trailingTypeArenaAtomBytes: int32 = 4 + 32
    let canonicalEmptyExternCapabilityBytes: int32 = 280
    # This fixture owns three parameter and three binding rows; ownership
    # columns are canonically empty.  Every term is derived from the schema.
    let entryDefinitionBytes: int32 =
        4 + 4 + 4 + 4 + (4 + 3 * 4) + 4 + 4 + (4 + 3 * 4)
    let offset = current.len - trailingTypeArenaAtomBytes -
        canonicalEmptyCleanupAuthorityBytes() -
        canonicalEmptyExternCapabilityBytes - entryDefinitionBytes
    assert(offset >= 8, "entry parameter codec: tag15 offset")
    var cursor = offset
    assert(codec.Backend2CodecReadU32(current, cursor) == 15,
           "entry parameter codec: tag15 missing")
    return offset

fn deleteWordAt(current: rawbytes.Bytes, offset: int32): rawbytes.Bytes =
    assert(offset >= 0 && offset <= current.len - 4,
           "entry parameter codec: delete word offset")
    var out = rawbytes.BytesAlloc(current.len - 4)
    rawbytes.BytesCopyRangeInto(out, 0, current, 0, offset)
    rawbytes.BytesCopyRangeInto(
        out, offset, current, offset + 4, current.len - offset - 4)
    return out

fn entryParameterTypeArenaCid(): layout.FixedBytes32 =
    let parsed = layout.FixedBytes32FromHex(
        "4141414141414141414141414141414141414141414141414141414141414141")
    assert(IsOk(parsed), "entry parameter codec: TypeArena CID")
    return Value(parsed)

fn buildBody(): coreir.BodyIR =
    var body = coreir.BodyIRNew()
    assert(coreir.BodyIRBindTypeArenaArtifactCid(
               body, entryParameterTypeArenaCid()),
           "entry parameter codec: TypeArena bind")
    coreir.BodyIRBindLocalBindingValueDefinitionDomain(body, 100, 3)
    var bindingProjection =
        coreir.BodyIRLocalBindingValueDefinitionProjectionNew(body)
    for parameterOrdinal in 0..<3:
        var slot: coreir.LocalSlot
        coreir.BodyIRApplyLocalSlotDefaultProof(slot)
        slot.id = parameterOrdinal
        slot.typeKind = coreir.LocalI32Tag
        slot.stackOffset = 0 - 1 - parameterOrdinal
        slot.sizeBytes = 4
        slot.alignBytes = 4
        add(body.localSlots, slot)
        coreir.BodyIRAppendUnboundLocalBindingValueDefinitionRow(
            body, parameterOrdinal)
        coreir.BodyIRBindLocalBindingValueDefinitionRow(
            body,
            bindingProjection,
            parameterOrdinal,
            100 + parameterOrdinal)
        coreir.BodyIRBindEntryParameterSlot(
            body, parameterOrdinal, parameterOrdinal)
    assert(coreir.BodyIREntryParameterSlotsShapeValid(body),
           "entry parameter codec: source shape")
    return body

fn main(): int32 =
    var body = buildBody()
    let negativeMode = os.GetEnv("CHENG_ENTRY_PARAMETER_CODEC_NEGATIVE")
    if negativeMode == "entry_parameter":
        body.entryParameterSlotIds[1] = 0
        let _ = codec.Backend2BodyIrEncode(body)
        panic("entry parameter codec: mutation accepted")
    if negativeMode == "binding_duplicate":
        body.localBindingValueDefinitionRows[1] = 100
        let _ = codec.Backend2BodyIrEncode(body)
        panic("entry parameter codec: duplicate binding row accepted")
    if negativeMode == "binding_missing":
        setLen(body.localBindingValueDefinitionRows, 2)
        let _ = codec.Backend2BodyIrEncode(body)
        panic("entry parameter codec: missing binding row accepted")
    if negativeMode == "binding_invalid":
        body.localBindingValueDefinitionRows[1] = -2
        let _ = codec.Backend2BodyIrEncode(body)
        panic("entry parameter codec: invalid binding row accepted")
    if negativeMode == "binding_domain_start":
        body.localBindingValueDefinitionDomainStart = 101
        let _ = codec.Backend2BodyIrEncode(body)
        panic("entry parameter codec: binding domain start mutation accepted")
    if negativeMode == "binding_domain_count":
        body.localBindingValueDefinitionDomainCount = 2
        let _ = codec.Backend2BodyIrEncode(body)
        panic("entry parameter codec: binding domain count mutation accepted")
    if negativeMode == "binding_outside_domain":
        body.localBindingValueDefinitionRows[2] = 103
        let _ = codec.Backend2BodyIrEncode(body)
        panic("entry parameter codec: outside-domain binding row accepted")
    var encoded = codec.Backend2BodyIrEncode(body)
    if negativeMode == "wire_old_magic":
        codec.Backend2CodecPutU32(encoded, 0, 0x42424955)
        var wireCursor: int32
        let _ = codec.Backend2BodyIrDecode(encoded, wireCursor)
        panic("entry parameter codec: old wire magic accepted")
    let entryTagOffset = entryDefinitionTagOffset(encoded)
    let domainStartOffset = entryTagOffset + 32
    if negativeMode == "wire_domain_missing":
        var missingStart = deleteWordAt(encoded, domainStartOffset)
        var missingDomain = deleteWordAt(missingStart, domainStartOffset)
        var wireCursor: int32
        let _ = codec.Backend2BodyIrDecode(missingDomain, wireCursor)
        panic("entry parameter codec: missing wire domain accepted")
    if negativeMode == "wire_domain_start":
        codec.Backend2CodecPutU32(encoded, domainStartOffset, -1)
        var wireCursor: int32
        let _ = codec.Backend2BodyIrDecode(encoded, wireCursor)
        panic("entry parameter codec: invalid wire domain start accepted")
    if negativeMode == "wire_domain_count":
        codec.Backend2CodecPutU32(encoded, domainStartOffset + 4, -1)
        var wireCursor: int32
        let _ = codec.Backend2BodyIrDecode(encoded, wireCursor)
        panic("entry parameter codec: invalid wire domain count accepted")
    if negativeMode == "wire_domain_overflow":
        codec.Backend2CodecPutU32(encoded, domainStartOffset, 2147483647)
        codec.Backend2CodecPutU32(encoded, domainStartOffset + 4, 1)
        var wireCursor: int32
        let _ = codec.Backend2BodyIrDecode(encoded, wireCursor)
        panic("entry parameter codec: overflowing wire domain accepted")
    if negativeMode == "wire_binding_duplicate":
        codec.Backend2CodecPutU32(encoded, domainStartOffset + 16, 100)
        var wireCursor: int32
        let _ = codec.Backend2BodyIrDecode(encoded, wireCursor)
        panic("entry parameter codec: duplicate wire binding accepted")
    if negativeMode == "wire_binding_outside":
        codec.Backend2CodecPutU32(encoded, domainStartOffset + 20, 103)
        var wireCursor: int32
        let _ = codec.Backend2BodyIrDecode(encoded, wireCursor)
        panic("entry parameter codec: outside-domain wire binding accepted")
    var cursor: int32
    var decoded = codec.Backend2BodyIrDecode(encoded, cursor)
    var reencoded = codec.Backend2BodyIrEncode(decoded)
    var decodedBindingProjection =
        coreir.BodyIRLocalBindingValueDefinitionProjectionNew(decoded)
    coreir.BodyIRLocalBindingValueDefinitionProjectionSync(
        decoded, decodedBindingProjection)
    assert(cursor == rawbytes.BytesLen(encoded) &&
           decoded.entryParameterSlotIds.len == 3 &&
           decoded.entryParameterSlotIds[0] == 0 &&
           decoded.entryParameterSlotIds[1] == 1 &&
           decoded.entryParameterSlotIds[2] == 2 &&
           decoded.localBindingValueDefinitionDomainStart == 100 &&
           decoded.localBindingValueDefinitionDomainCount == 3 &&
           decoded.localBindingValueDefinitionRows.len == 3 &&
           decoded.localBindingValueDefinitionRows[0] == 100 &&
           decoded.localBindingValueDefinitionRows[1] == 101 &&
           decoded.localBindingValueDefinitionRows[2] == 102 &&
           coreir.BodyIRLocalBindingValueDefinitionRowsShapeValid(decoded) &&
           coreir.BodyIRLocalSlotForBindingValueDefinitionRow(
               decoded, decodedBindingProjection, 101) == 1 &&
           coreir.BodyIREntryParameterSlotsShapeValid(decoded) &&
           rawbytes.BytesEqual(encoded, reencoded),
           "entry parameter codec: byte round-trip")
    rawbytes.BytesFree(reencoded)
    rawbytes.BytesFree(encoded)
    return 0
