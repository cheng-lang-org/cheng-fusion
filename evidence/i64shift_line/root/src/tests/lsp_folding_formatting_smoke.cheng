# lsp_folding_formatting_smoke.cheng -- test FoldingRange, FormattingOptions,
# TextEdit types, indent computation, and folding logic.
#
# Standalone types mirroring lsp_protocol (no import needed for compile smoke).

import std/strings

# --- Minimal types mirroring LSP protocol ---

type
    TestPosition =
        line: int32
        character: int32

    TestRange =
        start: TestPosition
        end: TestPosition

    TestFoldingRange =
        startLine: int32
        endLine: int32
        kind: str

    TestFormattingOptions =
        tabSize: int32
        insertSpaces: bool

    TestTextEdit =
        range: TestRange
        newText: str

# --- Factory functions ---

fn TestMakePosition(line: int32, character: int32): TestPosition =
    var out: TestPosition
    out.line = line
    out.character = character
    return out

fn TestMakeRange(startLine: int32, startChar: int32,
                  endLine: int32, endChar: int32): TestRange =
    var out: TestRange
    out.start = TestMakePosition(startLine, startChar)
    out.end = TestMakePosition(endLine, endChar)
    return out

fn TestMakeFoldingRange(startLine: int32, endLine: int32, kind: str): TestFoldingRange =
    var out: TestFoldingRange
    out.startLine = startLine
    out.endLine = endLine
    out.kind = kind
    return out

fn TestMakeFormattingOptions(tabSize: int32, insertSpaces: bool): TestFormattingOptions =
    var out: TestFormattingOptions
    out.tabSize = tabSize
    out.insertSpaces = insertSpaces
    return out

fn TestMakeTextEdit(range: TestRange, newText: str): TestTextEdit =
    var out: TestTextEdit
    out.range = range
    out.newText = newText
    return out

# --- Indentation helpers (mirrors lsp_server logic) ---

fn TestCountLeadingSpaces(line: str): int32 =
    let n: int32 = strings.Len(line)
    var count: int32
    for i in 0..<n:
        if line[i] == ' ':
            count = count + 1
        elif line[i] == '\t':
            count = count + 1
        else:
            break
    return count

fn TestComputeIndentLevel(line: str, tabSize: int32): int32 =
    let n: int32 = strings.Len(line)
    var level: int32
    for i in 0..<n:
        if line[i] == ' ':
            level = level + 1
        elif line[i] == '\t':
            level = level + tabSize
        else:
            break
    return level

# ====================
# Test cases
# ====================

fn TestFoldingRangeConstruction() =
    let fr: TestFoldingRange = TestMakeFoldingRange(5, 15, "imports")

    assert(fr.startLine == 5, "folding range: startLine should be 5")
    assert(fr.endLine == 15, "folding range: endLine should be 15")
    assert(fr.kind == "imports", "folding range: kind should be 'imports'")

fn TestFoldingRangeCommentKind() =
    let fr: TestFoldingRange = TestMakeFoldingRange(10, 20, "comment")

    assert(fr.startLine == 10, "folding range comment: startLine")
    assert(fr.endLine == 20, "folding range comment: endLine")
    assert(fr.kind == "comment", "folding range comment: kind")

fn TestFoldingRangeRegionKind() =
    let fr: TestFoldingRange = TestMakeFoldingRange(3, 8, "region")

    assert(fr.startLine == 3, "folding range region: startLine")
    assert(fr.endLine == 8, "folding range region: endLine")
    assert(fr.kind == "region", "folding range region: kind")

fn TestFoldingRangeEmptyKind() =
    let fr: TestFoldingRange = TestMakeFoldingRange(0, 0, "")

    assert(fr.startLine == 0, "folding range empty: startLine")
    assert(fr.endLine == 0, "folding range empty: endLine")
    assert(strings.Len(fr.kind) == 0, "folding range empty: kind should be empty")

fn TestFoldingRangeMultipleRanges() =
    # Build a list of folding ranges like the server would
    var ranges: TestFoldingRange[]

    let r1: TestFoldingRange = TestMakeFoldingRange(0, 3, "imports")
    add(ranges, r1)

    let r2: TestFoldingRange = TestMakeFoldingRange(5, 10, "comment")
    add(ranges, r2)

    let r3: TestFoldingRange = TestMakeFoldingRange(12, 20, "region")
    add(ranges, r3)

    assert(ranges.len == 3, "folding range list: should have 3 entries")
    assert(ranges[0].kind == "imports", "folding range list: first kind")
    assert(ranges[1].kind == "comment", "folding range list: second kind")
    assert(ranges[2].kind == "region", "folding range list: third kind")
    assert(ranges[0].startLine == 0, "folding range list: first startLine")
    assert(ranges[2].endLine == 20, "folding range list: last endLine")

fn TestFormattingOptionsParsing() =
    # 4-space indentation with spaces
    let opts1: TestFormattingOptions = TestMakeFormattingOptions(4, true)
    assert(opts1.tabSize == 4, "format opts: tabSize should be 4")
    assert(opts1.insertSpaces == true, "format opts: insertSpaces should be true")

    # 2-space indentation with spaces
    let opts2: TestFormattingOptions = TestMakeFormattingOptions(2, true)
    assert(opts2.tabSize == 2, "format opts 2: tabSize should be 2")
    assert(opts2.insertSpaces == true, "format opts 2: insertSpaces should be true")

    # Tab indentation
    let opts3: TestFormattingOptions = TestMakeFormattingOptions(4, false)
    assert(opts3.tabSize == 4, "format opts tab: tabSize should be 4")
    assert(opts3.insertSpaces == false, "format opts tab: insertSpaces should be false")

fn TestTextEditConstruction() =
    let range: TestRange = TestMakeRange(0, 0, 5, 10)
    let edit: TestTextEdit = TestMakeTextEdit(range, "formatted text")

    assert(edit.range.start.line == 0, "text edit: start line")
    assert(edit.range.end.character == 10, "text edit: end char")
    assert(edit.newText == "formatted text", "text edit: newText")

fn TestIndentCounting() =
    # Lines with different leading whitespace
    assert(TestCountLeadingSpaces("no indent") == 0, "indent count: no indent")
    assert(TestCountLeadingSpaces("    four spaces") == 4, "indent count: 4 spaces")
    assert(TestCountLeadingSpaces("        eight spaces") == 8, "indent count: 8 spaces")
    assert(TestCountLeadingSpaces("\tone tab") == 1, "indent count: 1 tab == 1")

fn TestIndentLevelComputation() =
    # Compute indent level in spaces (tabs expanded)
    assert(TestComputeIndentLevel("no indent", 4) == 0, "indent level: no indent")
    assert(TestComputeIndentLevel("    four spaces", 4) == 4, "indent level: 4 spaces")
    assert(TestComputeIndentLevel("\tone tab", 4) == 4, "indent level: 1 tab == 4")
    assert(TestComputeIndentLevel("\t\ttwo tabs", 4) == 8, "indent level: 2 tabs == 8")
    assert(TestComputeIndentLevel("  two spaces", 2) == 2, "indent level: 2 spaces, tabSize=2")

fn TestFoldingRangeImportDetection() =
    # Simulate detecting import block from source lines
    # Matching the server's algorithm: strip then check startsWith "import"
    var sourceLines: str[]
    add(sourceLines, "import std/strings")
    add(sourceLines, "import std/os")
    add(sourceLines, "")
    add(sourceLines, "fn main(): int32 =")

    var startLine: int32 = -1
    var endLine: int32 = -1
    let lineCount: int32 = sourceLines.len
    var i: int32
    while i < lineCount:
        if strings.hasPrefix(sourceLines[i], "import"):
            startLine = i
            var j: int32 = i + 1
            while j < lineCount:
                let t: str = sourceLines[j]
                # Strip leading/trailing whitespace to check (simplified: check prefix)
                let trimmed: str = strings.SliceBytes(t, 0, strings.Len(t))
                if !strings.hasPrefix(trimmed, "import"):
                    break
                j = j + 1
            endLine = j - 1
            i = j
        else:
            i = i + 1

    assert(startLine == 0, "import detection: startLine should be 0")
    assert(endLine == 1, "import detection: endLine should be 1")

fn TestFoldingRangeCommentDetection() =
    # Simulate detecting comment block
    var sourceLines: str[]
    add(sourceLines, "# comment 1")
    add(sourceLines, "# comment 2")
    add(sourceLines, "# comment 3")
    add(sourceLines, "fn foo(): int32 =")

    var startLine: int32 = -1
    var endLine: int32 = -1
    let lineCount: int32 = sourceLines.len
    var i: int32
    while i < lineCount:
        if strings.hasPrefix(sourceLines[i], "#"):
            startLine = i
            var j: int32 = i + 1
            while j < lineCount:
                if strings.Len(sourceLines[j]) > 0 && !strings.hasPrefix(sourceLines[j], "#"):
                    break
                j = j + 1
            endLine = j - 1
            i = j
        else:
            i = i + 1

    assert(startLine == 0, "comment detection: startLine should be 0")
    assert(endLine == 2, "comment detection: endLine should be 2")

fn TestFullDocumentTextEdit() =
    # Simulate formatting result as a full-document TextEdit
    let original: str = "  hello\n  world"
    let formatted: str = "hello\nworld"
    let range: TestRange = TestMakeRange(0, 0, 1, 5)
    let edit: TestTextEdit = TestMakeTextEdit(range, formatted)

    assert(edit.newText == "hello\nworld", "full doc edit: formatted text")
    assert(edit.range.start.line == 0, "full doc edit: start line")
    assert(edit.range.end.character == 5, "full doc edit: end char")

fn main(): int32 =
    TestFoldingRangeConstruction()
    TestFoldingRangeCommentKind()
    TestFoldingRangeRegionKind()
    TestFoldingRangeEmptyKind()
    TestFoldingRangeMultipleRanges()
    TestFormattingOptionsParsing()
    TestTextEditConstruction()
    TestIndentCounting()
    TestIndentLevelComputation()
    TestFoldingRangeImportDetection()
    TestFoldingRangeCommentDetection()
    TestFullDocumentTextEdit()
    return 0
