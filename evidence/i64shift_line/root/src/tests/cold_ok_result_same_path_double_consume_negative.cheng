import std/result
import std/strings

fn ColdOkResultSamePathDoubleConsume(): Result[str] =
    let owned = strings.CloneStr("same-path-owned")
    let first = Ok[str](owned)
    if IsErr(first):
        return first
    return Ok[str](owned)

fn main(): int32 =
    let result = ColdOkResultSamePathDoubleConsume()
    if IsErr(result):
        return 1
    return 0
