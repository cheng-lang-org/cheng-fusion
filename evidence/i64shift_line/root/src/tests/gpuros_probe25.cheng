@profile("driver_safe")

type
    IoUInt8Ptr = uint8 *
    IoUInt32Ptr = uint32 *
    IoUInt64Ptr = uint64 *

const TestBase: uint64 = 0x82200000

@trusted_abi
fn IoRamSt64(base: uint64, byteOffset: int32, value: uint64) =
    let b = base
    let o = byteOffset
    let addr = ptr(b + uint64(o))
    *(IoUInt64Ptr(addr)) = value

@trusted_abi
fn IoRamLd32(base: uint64, byteOffset: int32): int32 =
    let b = base
    let o = byteOffset
    let addr = ptr(b + uint64(o))
    return int32(*(IoUInt32Ptr(addr)))

@trusted_abi
fn IoSt8(base: uint64, offset: uint64, value: int32) =
    let b = base
    let o = offset
    let addr = ptr(b + o)
    *(IoUInt8Ptr(addr)) = uint8(value & 255)

fn HexNib(v: int32) =
    let w = v
    if w < 10:
        IoSt8(268435456, 0, int32(48 + w))
    else:
        IoSt8(268435456, 0, int32(87 + w))

fn Hex32(v: int32) =
    var div = 268435456
    while div > 0:
        HexNib((v / div) & 15)
        div = div / 16

fn Sep() =
    IoSt8(268435456, 0, 32)

fn main(): int32 =
    let v = uint64(305419896)
    IoRamSt64(TestBase, 0, v)
    let lo = IoRamLd32(TestBase, 0)
    Hex32(lo)
    Sep()
    let b2 = uint64(2183135232)
    let v2 = uint64(305419896)
    IoRamSt64(b2, 0, v2)
    let lo2 = IoRamLd32(b2, 0)
    Hex32(lo2)
    IoSt8(268435456, 0, 10)
    return 0
