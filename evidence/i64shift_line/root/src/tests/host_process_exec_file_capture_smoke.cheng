import std/os
import std/os_host_process as hostos
import std/strutils as strutil

fn main(): int32 =
    var emptyWire: str = hostos.ArgvWire0()
    var capArg: str = "capture-ok"
    var capWire: str = hostos.ArgvWire1(capArg)
    var emptyCwd: str
    var echoPath: str = "/bin/echo"
    var capOutRaw: str
    var capRc: int32
    hostos.ExecFileCaptureWire(echoPath, capWire, emptyWire, emptyCwd, true, 5, capOutRaw, capRc)
    if capRc == -11:
        assert(false, " hostos execFileCapture rc -11")
    if capRc == -12:
        assert(false, " hostos execFileCapture rc -12")
    if capRc == -13:
        assert(false, " hostos execFileCapture rc -13")
    if capRc == 124:
        assert(false, " hostos execFileCapture rc 124")
    if capRc == 1:
        assert(false, " hostos execFileCapture rc 1")
    if capRc == 2:
        assert(false, " hostos execFileCapture rc 2")
    if capRc == 126:
        assert(false, " hostos execFileCapture rc 126")
    if capRc == 127:
        assert(false, " hostos execFileCapture rc 127")
    if capRc == 128:
        assert(false, " hostos execFileCapture rc 128")
    if capRc == 130:
        assert(false, " hostos execFileCapture rc 130")
    if capRc == 141:
        assert(false, " hostos execFileCapture rc 141")
    if capRc == 143:
        assert(false, " hostos execFileCapture rc 143")
    if capRc == 255:
        assert(false, " hostos execFileCapture rc 255")
    let capOut: str = strutil.Strip(capOutRaw)
    assert(capRc == 0, " hostos execFileCapture rc")
    assert(capOut == "capture-ok",
           " hostos execFileCapture out")
    var multiArg0: str = "debug-report"
    var multiArg1: str = "--root:/tmp/cheng-root"
    var multiArg2: str = "--in:/tmp/source.cheng"
    var multiArg3: str = "--emit:obj"
    var multiWire: str = hostos.ArgvWire4(multiArg0,
                                          multiArg1,
                                          multiArg2,
                                          multiArg3)
    var multiOutRaw: str
    var multiRc: int32
    hostos.ExecFileCaptureWire(echoPath, multiWire, emptyWire, emptyCwd, true, 5, multiOutRaw, multiRc)
    let multiOut: str = strutil.Strip(multiOutRaw)
    assert(multiRc == 0, " hostos execFileCapture multi rc")
    assert(multiOut == "debug-report --root:/tmp/cheng-root --in:/tmp/source.cheng --emit:obj",
           " hostos execFileCapture multi out")
    var splitArg: str = "BEGIN { print \"only-out\"; print \"only-err\" > \"/dev/stderr\" }"
    var splitWire: str = hostos.ArgvWire1(splitArg)
    var awkPath: str = "/usr/bin/awk"
    var stdoutOnlyRaw: str
    var stdoutOnlyRc: int32
    hostos.ExecFileCaptureWire(awkPath, splitWire, emptyWire, emptyCwd, false, 5, stdoutOnlyRaw, stdoutOnlyRc)
    let stdoutOnlyOut: str = strutil.Strip(stdoutOnlyRaw)
    assert(stdoutOnlyRc == 0, " hostos execFileCapture stdout rc")
    assert(stdoutOnlyOut == "only-out",
           " hostos execFileCapture stdout only")
    let statusRc: int32 = hostos.ExecFileStatusWire(echoPath, capWire, emptyWire, emptyCwd, 5)
    assert(statusRc == 0, " hostos execFileStatus rc")
    var timeoutArg0: str = "-c"
    var timeoutArg1: str = "sleep 2"
    var timeoutWire: str = hostos.ArgvWire2(timeoutArg0, timeoutArg1)
    var shPath: str = "/bin/sh"
    var timeoutOutRaw: str
    var timeoutRc: int32
    hostos.ExecFileCaptureWire(shPath, timeoutWire, emptyWire, emptyCwd, true, 1, timeoutOutRaw, timeoutRc)
    assert(timeoutRc == 124, " hostos execFileCapture timeout")
    echo(" host_process_exec_file_capture_smoke ok")
    return 0
