# 独立最小复现: 不依赖 std/json 模块(避开该模块另外两个无关 pre-existing 缺口
# jsonTryGetInt64/cheng_f64_to_i64 与 panicCString bail=801), 单文件复刻
# jsonParseArray 触发 bail=801 F3 族的确切形态——函数头 `=` 后第一行是纯 `//`
# 注释且注释文本里含未配对的英文单引号内 '['(TypedExprLineNeedsContinuation
# 的括号深度扫描不认单引号为字符串边界), 紧跟 while true: / break / 嵌套
# return, 函数体末尾另有一条顶层 return。真跑到底 + 打印真实数值核对, 不用
# assert/Fmt-bool(会拉入 std/system.cheng panicCString 自身另一个无关
# pre-existing bail=801 缺口, 与本次续行修复无关)。

import std/system
import std/os as os
import std/strings

fn parseFakeArray(n: int32): int32 =
    // marker at opening '['
    var total: int32
    var i: int32
    if n > 0:
        while true:
            i = i + 1
            if i > n:
                break
            if i == 2:
                return -1
            total = total + i
    return total

fn main() =
    let r1 = parseFakeArray(5)
    os.WriteLine(os.GetStdout(), Fmt"r1={strings.IntToStr(r1)}")
    let r2 = parseFakeArray(1)
    os.WriteLine(os.GetStdout(), Fmt"r2={strings.IntToStr(r2)}")
    let r3 = parseFakeArray(0)
    os.WriteLine(os.GetStdout(), Fmt"r3={strings.IntToStr(r3)}")
    if r1 == -1 && r2 == 1 && r3 == 0:
        os.WriteLine(os.GetStdout(), "PASS")
        exit(0)
    os.WriteLine(os.GetStdout(), "FAIL")
    exit(1)
