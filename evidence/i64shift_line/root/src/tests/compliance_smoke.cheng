# compliance smoke: governed slash params (grid + bounds) and report.

import std/os
import std/system
import cheng/std/bytes_layout as layout
import cheng/apps/rwad/rwad_settlement as ssm
import cheng/apps/rwad/rwad_compliance as cmp
import cheng/apps/rwad/rwad_disclosure as dsc

fn Tag(b: int32): layout.FixedBytes32 =
    var raw = BytesAlloc(32)
    BytesSet(raw, 0, b)
    let res = layout.FixedBytes32FromBytes(raw)
    return res.value

fn main(): int32 =
    var rc: int32 = 0
    var st = ssm.SsmInit()

    # approved pair applies
    let ok1 = cmp.CmpApplyParams(st, 200, 300)
    if !ok1.ok:
        os.WriteLine(os.Get_stderr(), "default pair rejected")
        rc = rc + 1
    let ok2 = cmp.CmpApplyParams(st, 500, 500)
    if !ok2.ok:
        os.WriteLine(os.Get_stderr(), "approved pair 500x500 rejected")
        rc = rc + 1

    # off-grid pairs refused
    let bad1 = cmp.CmpApplyParams(st, 333, 400)
    if bad1.ok:
        os.WriteLine(os.Get_stderr(), "off-grid pair accepted")
        rc = rc + 1
    # over-total refused
    let bad2 = cmp.CmpApplyParams(st, 6000, 6000)
    if bad2.ok:
        os.WriteLine(os.Get_stderr(), "over-total split accepted")
        rc = rc + 1
    # negative refused
    let bad3 = cmp.CmpApplyParams(st, -5, 300)
    if bad3.ok:
        os.WriteLine(os.Get_stderr(), "negative bp accepted")
        rc = rc + 1
    # state unchanged by all refusals (still 500x500)
    if st.params.challengeRewardBp != 500 or st.params.burnBp != 500:
        os.WriteLine(os.Get_stderr(), "refused params leaked into state")
        rc = rc + 1

    # generate a real slash event and check the report reflects it
    let payer = Tag(40)
    let challenger = Tag(41)
    let cr = ssm.SsmCredit(st, payer, Int64(1000))
    if !cr.ok:
        return 1
    let lk = ssm.SsmEscrowLock(st, Tag(42), payer, Int64(1000), Int64(9999))
    if !lk.ok:
        return 1
    # restore default grid first so the slash uses governed params
    let back = cmp.CmpApplyParams(st, 200, 300)
    if !back.ok:
        return 1
    let sl = ssm.SsmEscrowSlashWithSplit(st, Tag(42), Int64(1000), challenger)
    if !sl.ok:
        return 1
    # slash 1000 at reward200/burn300 -> 20/30/950
    if ssm.SsmBalanceOf(st, challenger) != 20:
        os.WriteLine(os.Get_stderr(), "governed reward wrong (expect 20)")
        rc = rc + 1

    let rep = cmp.CmpReport(st)
    if !rep.ok:
        os.WriteLine(os.Get_stderr(), "report generation failed")
        rc = rc + 1
    let text: str = rep.value
    let hasEvents = dsc.DscContains(text, "compliance|slash_events|1")
    if !hasEvents:
        os.WriteLine(os.Get_stderr(), "slash event count wrong")
        rc = rc + 1
    let hasBurn = dsc.DscContains(text, "compliance|pool_burn|30")
    if !hasBurn:
        os.WriteLine(os.Get_stderr(), "burn pool line wrong")
        rc = rc + 1
    let hasSafety = dsc.DscContains(text, "compliance|pool_safety|950")
    if !hasSafety:
        os.WriteLine(os.Get_stderr(), "safety pool line wrong")
        rc = rc + 1
    let hasParams = dsc.DscContains(text, "reward=200|burn=300")
    if !hasParams:
        os.WriteLine(os.Get_stderr(), "param line wrong")
        rc = rc + 1

    if rc == 0:
        echo("compliance_smoke ok")
    return rc
