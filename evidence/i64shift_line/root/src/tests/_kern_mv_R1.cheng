type
    Batch =
        session: int32
        staged: int32[]
        active: bool

fn closeRound(batch: var Batch) =
    batch.active = false

fn build(useFallback: bool): bool =
    var nb = new(Batch)
    nb.session = 3
    nb.active = true
    if useFallback:
        closeRound(nb)
        return false
    closeRound(nb)
    return true

fn main(): int32 =
    if build(false):
        return 0
    return 1
