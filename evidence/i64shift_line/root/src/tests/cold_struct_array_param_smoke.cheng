type
    Pt4 =
        x: int32
        tags: str[]

fn takeAll4(items: Pt4[]): int32 =
    let src = items
    var out: Pt4[]
    var i = 0
    while i < src.len:
        let it = src[i]
        if it.x > 0:
            add(out, it)
        i = i + 1
    return out.len

fn main(): int32 =
    var xs: Pt4[]
    return takeAll4(xs)
