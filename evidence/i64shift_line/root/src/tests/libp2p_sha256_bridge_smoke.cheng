import std/system
import std/rawbytes
import std/strings

# SABI (task #71): cheng_sha256_hex_bridge takes text as raw (ptr,len:int64)
# and writes the 64-byte hex digest into a caller-owned buffer. See
# program_support_backend.cheng for the full root-cause writeup.
importc fn cheng_sha256_hex_bridge(textRaw: ptr, textLen: int64, outHex: ptr): int32

fn hexOf(text: str): str =
    let outBuf: Bytes = BytesAlloc(64)
    let n = cheng_sha256_hex_bridge(StrDataPtr(text), int64(len(text)), outBuf.data)
    if n != 64:
        return ""
    return BytesToString(outBuf)

fn repeatedA(count: int32): str =
    var out: str
    for index in 0..<count:
        out = strings.ConcatStr(out, "a")
    return out

fn main(): int32 =
    let digest = hexOf("abc")
    let counts = [0, 55, 56, 63, 64, 65, 127, 128]
    let expected = [
        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
        "9f4390f8d30c2dd92ec9f095b65e2b9ae9b0a925a5258e241c9f1e910f734318",
        "b35439a4ac6f0948b6d6f9e3c6af0f5f590ce20f1bde7090ef7970686ec6738a",
        "7d3e74a05d7db15bce4ad9ec0658ea98e3f06eeecf16b4c6fff2da457ddc2f34",
        "ffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb",
        "635361c48bb9eab14198e76ea8ab7f1a41685d6ad62aa9146d301d4f17eb0ae0",
        "c57e9278af78fa3cab38667bef4ce29d783787a2f731d4e12200270f0c32320a",
        "6836cf13bac400e9105071cd6af47084dfacad4e5e302c94bfed24e013afb73e"
    ]
    for index in 0..<counts.len:
        assert(hexOf(repeatedA(counts[index])) == expected[index],
               "libp2p sha256 bridge: padding boundary mismatch")
    echo(digest)
    echo(IntToStr(len(digest)))
    return 0
