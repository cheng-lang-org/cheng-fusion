module cold_linkerless_ptr_deref

// Read value through a var parameter (pointer-like reference).
fn readRef(v: var int32): int32 =
    return v

// Write value through a var parameter.
fn writeRef(v: var int32, val: int32): int32 =
    v = val
    return 0

fn test_read(): int32 =
    var x: int32 = 42
    let v = readRef(x)
    if v != 42:
        return 1
    return 0

fn test_write(): int32 =
    var x: int32 = 7
    let _ = writeRef(x, 99)
    if x != 99:
        return 1
    return 0

fn test_read_write_chain(): int32 =
    var acc: int32
    let _ = writeRef(acc, 100)
    let v = readRef(acc)
    if v != 100:
        return 1
    let _ = writeRef(acc, v + 5)
    if acc != 105:
        return 2
    return 0

fn test_multiple_refs(): int32 =
    var x: int32 = 10
    var y: int32 = 20
    let vx = readRef(x)
    let vy = readRef(y)
    if vx != 10:
        return 1
    if vy != 20:
        return 2
    // write to x, verify y unchanged
    let _ = writeRef(x, 99)
    if x != 99:
        return 3
    if y != 20:
        return 4
    return 0

fn main(): int32 =
    let r1 = test_read()
    if r1 != 0:
        return r1
    let r2 = test_write()
    if r2 != 0:
        return 10 + r2
    let r3 = test_read_write_chain()
    if r3 != 0:
        return 20 + r3
    let r4 = test_multiple_refs()
    if r4 != 0:
        return 30 + r4
    return 0

main()
