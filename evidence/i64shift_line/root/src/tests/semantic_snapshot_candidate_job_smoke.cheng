import std/os
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/tooling/semantic_snapshot as snapshot
import cheng/core/tooling/semantic_snapshot_production as production

@borrows
fn TestCid(label: str): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(label.len)
    for index in 0..<label.len:
        layout.ByteBufAppendByte(
            buf, Int32(label[index]) & 255)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn InitAcceptedOpenInto(
        label: str,
        eventState: var snapshot.WorkspaceSourceEventState,
        store: var production.SemanticSnapshotProductionStore,
        documentCid: var layout.FixedBytes32,
        sourceVersion: var int64,
        err: var str) =
    let sessionCid = TestCid(label)
    documentCid = TestCid(Fmt"{label}/document")
    assert(snapshot.WorkspaceSourceEventStateInitInto(
               sessionCid, eventState, err), err)
    assert(production.SemanticSnapshotProductionStoreInitInto(
               sessionCid, store, err), err)
    assert(production.SemanticSnapshotProductionAcceptSourceEventInto(
               eventState, store,
               snapshot.SemanticSourceEventOpen,
               documentCid, int64(1), sourceVersion, err), err)
    assert(sourceVersion == int64(1), "candidate job: open version")

fn main() =
    var err: str
    let completionAuthorityCid =
        TestCid("candidate-job/completion-authority")

    var cancelEvents: snapshot.WorkspaceSourceEventState
    var cancelStore: production.SemanticSnapshotProductionStore
    var cancelDocumentCid: layout.FixedBytes32
    var cancelVersion: int64
    InitAcceptedOpenInto(
        "candidate-job/cancel",
        cancelEvents, cancelStore,
        cancelDocumentCid, cancelVersion, err)
    var cancelTicket: production.SemanticSnapshotProductionJobTicket
    assert(production.SemanticSnapshotProductionJobTicketMakeInto(
               cancelEvents, cancelStore, cancelTicket, err), err)
    assert(cancelTicket.changedDocumentRows.len == 1 &&
           cancelTicket.changedDocumentRows[0] == 0 &&
           cancelTicket.changedDocumentEventKinds[0] ==
               snapshot.SemanticSourceEventOpen &&
           cancelTicket.changedDocumentEventSourceVersions[0] ==
               cancelVersion,
           "candidate job: exact changed row missing")
    let cancelJobCid =
        layout.FixedBytes32Copy(cancelTicket.jobCid)
    assert(production.SemanticSnapshotProductionJobTicketStartInto(
               cancelTicket, cancelJobCid, err), err)
    var cancelled: bool
    assert(production.SemanticSnapshotProductionJobTicketCancelInto(
               cancelTicket, cancelJobCid, cancelVersion,
               cancelled, err) && cancelled,
           "candidate job: exact cancellation failed")
    var cancelRejection: production.SemanticSnapshotProductionJobCompletionRejection
    assert(!production.SemanticSnapshotProductionJobCompletionBoundAdmitInto(
                cancelStore, cancelTicket,
                cancelJobCid, cancelVersion,
                cancelTicket.sourceEventStateReceiptCid,
                completionAuthorityCid,
                cancelRejection, err) &&
           production.SemanticSnapshotProductionJobCompletionRejectionStrictValidateInto(
               cancelRejection, err) &&
           cancelRejection.reasonKind ==
               production.SemanticSnapshotProductionJobCompletionCancelled,
           "candidate job: cancelled completion was not formally rejected")
    assert(production.SemanticSnapshotProductionStoreReleaseInto(
               cancelStore, err), err)

    var mismatchEvents: snapshot.WorkspaceSourceEventState
    var mismatchStore: production.SemanticSnapshotProductionStore
    var mismatchDocumentCid: layout.FixedBytes32
    var mismatchVersion: int64
    InitAcceptedOpenInto(
        "candidate-job/mismatch",
        mismatchEvents, mismatchStore,
        mismatchDocumentCid, mismatchVersion, err)
    var mismatchTicket: production.SemanticSnapshotProductionJobTicket
    assert(production.SemanticSnapshotProductionJobTicketMakeInto(
               mismatchEvents, mismatchStore,
               mismatchTicket, err), err)
    let mismatchJobCid =
        layout.FixedBytes32Copy(mismatchTicket.jobCid)
    assert(production.SemanticSnapshotProductionJobTicketStartInto(
               mismatchTicket, mismatchJobCid, err), err)
    assert(!production.SemanticSnapshotProductionJobTicketCancelInto(
                mismatchTicket,
                TestCid("candidate-job/wrong-job"),
                mismatchVersion, cancelled, err),
           "candidate job: wrong job CID cancelled ticket")
    assert(production.SemanticSnapshotProductionStoreReleaseInto(
               mismatchStore, err), err)

    var duplicateEvents: snapshot.WorkspaceSourceEventState
    var duplicateStore: production.SemanticSnapshotProductionStore
    var duplicateDocumentCid: layout.FixedBytes32
    var duplicateVersion: int64
    InitAcceptedOpenInto(
        "candidate-job/duplicate",
        duplicateEvents, duplicateStore,
        duplicateDocumentCid, duplicateVersion, err)
    var duplicateTicket: production.SemanticSnapshotProductionJobTicket
    assert(production.SemanticSnapshotProductionJobTicketMakeInto(
               duplicateEvents, duplicateStore,
               duplicateTicket, err), err)
    let duplicateJobCid =
        layout.FixedBytes32Copy(duplicateTicket.jobCid)
    let duplicateStarted =
        production.SemanticSnapshotProductionJobTicketStartInto(
            duplicateTicket, duplicateJobCid, err)
    assert(duplicateStarted, err)
    var duplicateRejection: production.SemanticSnapshotProductionJobCompletionRejection
    let duplicateAdmitted =
        production.SemanticSnapshotProductionJobCompletionBoundAdmitInto(
            duplicateStore, duplicateTicket,
            duplicateJobCid, duplicateVersion,
            duplicateTicket.sourceEventStateReceiptCid,
            completionAuthorityCid,
            duplicateRejection, err)
    assert(duplicateAdmitted, err)
    let duplicateCommitted =
        production.SemanticSnapshotProductionJobCompletionCommitInto(
            duplicateTicket, duplicateJobCid,
            completionAuthorityCid, false, err)
    assert(duplicateCommitted, err)
    let duplicateAdmittedAgain =
        production.SemanticSnapshotProductionJobCompletionBoundAdmitInto(
            duplicateStore, duplicateTicket,
            duplicateJobCid, duplicateVersion,
            duplicateTicket.sourceEventStateReceiptCid,
            completionAuthorityCid,
            duplicateRejection, err)
    assert(!duplicateAdmittedAgain &&
           duplicateRejection.reasonKind ==
               production.SemanticSnapshotProductionJobCompletionDuplicate &&
           production.SemanticSnapshotProductionJobCompletionRejectionStrictValidateInto(
               duplicateRejection, err),
           "candidate job: duplicate completion was not formally rejected")
    assert(production.SemanticSnapshotProductionStoreReleaseInto(
               duplicateStore, err), err)

    var lateEvents: snapshot.WorkspaceSourceEventState
    var lateStore: production.SemanticSnapshotProductionStore
    var lateDocumentCid: layout.FixedBytes32
    var lateVersion: int64
    InitAcceptedOpenInto(
        "candidate-job/late",
        lateEvents, lateStore,
        lateDocumentCid, lateVersion, err)
    var lateTicket: production.SemanticSnapshotProductionJobTicket
    assert(production.SemanticSnapshotProductionJobTicketMakeInto(
               lateEvents, lateStore, lateTicket, err), err)
    let lateJobCid =
        layout.FixedBytes32Copy(lateTicket.jobCid)
    assert(production.SemanticSnapshotProductionJobTicketStartInto(
               lateTicket, lateJobCid, err), err)
    var nextVersion: int64
    assert(production.SemanticSnapshotProductionAcceptSourceEventInto(
               lateEvents, lateStore,
               snapshot.SemanticSourceEventChange,
               lateDocumentCid, int64(2), nextVersion, err) &&
           nextVersion == int64(2),
           "candidate job: newer event was not accepted")
    var lateRejection: production.SemanticSnapshotProductionJobCompletionRejection
    assert(!production.SemanticSnapshotProductionJobCompletionBoundAdmitInto(
                lateStore, lateTicket,
                lateJobCid, lateVersion,
                lateTicket.sourceEventStateReceiptCid,
                completionAuthorityCid,
                lateRejection, err) &&
           lateRejection.reasonKind ==
               production.SemanticSnapshotProductionJobCompletionLate &&
           lateRejection.observedCurrentSourceVersion == nextVersion &&
           production.SemanticSnapshotProductionJobCompletionRejectionStrictValidateInto(
               lateRejection, err),
           "candidate job: late completion was not formally rejected")
    var mutatedTicket = lateTicket
    mutatedTicket.changedDocumentEventSourceVersions[0] =
        nextVersion + int64(1)
    assert(!production.SemanticSnapshotProductionJobTicketStrictValidateInto(
                mutatedTicket, err),
           "candidate job: mutated changed-row version accepted")
    assert(production.SemanticSnapshotProductionStoreReleaseInto(
               lateStore, err), err)

    os.WriteLine(
        os.Get_stdout(),
        "semantic_snapshot_candidate_job_smoke: ok cancelled=1 late=1 duplicate=1")
