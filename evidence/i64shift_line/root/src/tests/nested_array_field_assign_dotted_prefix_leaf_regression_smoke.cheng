# M12: matches production shape (ecnist.cheng pointSetCoordsInto) -- dotted
# struct-field prefix + single array-index hop as the WHOLE assign target
# (no trailing subfield). Must stay unaffected by the guard: works before and
# after this patch (not the bug shape -- no dropped index to hide since it
# is not a two-array-hop write).
type
    Limbs =
        vals: int32[4]

type
    Outer =
        limbs: Limbs

fn main(): int32 =
    var out: Outer
    out.limbs.vals[0] = 11
    out.limbs.vals[1] = 22
    out.limbs.vals[2] = 33
    if out.limbs.vals[0] != 11:
        return 1
    if out.limbs.vals[1] != 22:
        return 2
    if out.limbs.vals[2] != 33:
        return 3
    return 0
