fn coldScalarRefBoolValue(value: bool): bool =
  return value

fn coldScalarRefI32Value(value: int32): int32 =
  return value

fn coldScalarRefNarrowValueRead(flag: var bool,
                                word: var int32): int32 =
  if !coldScalarRefBoolValue(flag):
    return 1
  if coldScalarRefI32Value(word) != 1027:
    return 2
  return 0

fn main(): int32 =
  var flag = true
  var word = 1027
  return coldScalarRefNarrowValueRead(flag, word)
