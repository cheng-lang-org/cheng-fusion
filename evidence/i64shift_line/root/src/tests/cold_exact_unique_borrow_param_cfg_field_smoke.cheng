type
    ColdParamCfgFieldRoot =
        values: int32[]

fn ColdParamCfgFieldAppend(values: var int32[], value: int32) =
    add(values, value)

fn ColdParamCfgFieldRewrite(
        out: var ColdParamCfgFieldRoot,
        chooseLeft: bool) =
    if chooseLeft:
        ColdParamCfgFieldAppend(out.values, 11)
    else:
        ColdParamCfgFieldAppend(out.values, 13)
    ColdParamCfgFieldAppend(out.values, 17)

fn main(): int32 =
    var root: ColdParamCfgFieldRoot
    ColdParamCfgFieldRewrite(root, true)
    if root.values.len != 2 ||
       root.values[0] != 11 ||
       root.values[1] != 17:
        return 1
    return 0
