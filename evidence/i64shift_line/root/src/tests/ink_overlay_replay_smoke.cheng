# M2 ink overlay replay determinism gate: same seed -> identical per-run
# rolling receipt fingerprint, identical tick count, and a guaranteed end
# state with zero overlay commands (digest-clean final frame).
import std/system
import cheng/game/fluid3d
import cheng/game/lbm2d
import std/rawbytes
import cheng/core/runtime/web_ink_overlay

fn runOnce(seed: int32, ticksOut: var int32): int32 =
    web_ink_overlay.WebInkOverlayLaunch(390, 844, seed)
    var ticks = 0
    while web_ink_overlay.WebInkOverlayActive() && ticks < 1000:
        let _t = web_ink_overlay.WebInkOverlayTick()
        ticks = ticks + 1
    ticksOut = ticks
    return web_ink_overlay.WebInkOverlayRollingFingerprint()

fn main(): int32 =
    var ticksA: int32
    var ticksB: int32
    let fpA = runOnce(52, ticksA)
    var trailing: int32[]
    let trailingCount = web_ink_overlay.WebInkOverlayCollectCommands(trailing)
    let fpB = runOnce(52, ticksB)
    var ticksC: int32
    let fpC = runOnce(53, ticksC)
    if fpA != fpB:
        return 1
    if ticksA != ticksB:
        return 2
    if ticksA <= 10:
        return 3
    if ticksA >= 1000:
        return 4
    if trailingCount != 0:
        return 5
    if fpA == fpC:
        return 6
    return 0
