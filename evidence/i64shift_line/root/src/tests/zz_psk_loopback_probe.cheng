import std/result
import std/rawbytes
import std/strutils as strutil
import cheng/quic/tls/test_pki as testpki
import cheng/quic/tls/policy as policy
import cheng/apps/vpn_proxy/transport_tcp_tls_record as rec
import cheng/apps/vpn_proxy/transport_tcp_tls_handshake as tlshs

fn keysMatchReport(tag: str, a: rec.VpnProxyTcpTlsRecordKeys, b: rec.VpnProxyTcpTlsRecordKeys): int32 =
    if BytesLen(a.key) != BytesLen(b.key):
        echo(strutil.Join(["PSKPROBE FAIL ", tag, " key len mismatch"], ""))
        return 1
    if BytesLen(a.iv) != BytesLen(b.iv):
        echo(strutil.Join(["PSKPROBE FAIL ", tag, " iv len mismatch"], ""))
        return 1
    var i: int32
    while i < BytesLen(a.key):
        if BytesGet(a.key, i) != BytesGet(b.key, i):
            echo(strutil.Join(["PSKPROBE FAIL ", tag, " key byte mismatch"], ""))
            return 1
        i = i + 1
    i = 0
    while i < BytesLen(a.iv):
        if BytesGet(a.iv, i) != BytesGet(b.iv, i):
            echo(strutil.Join(["PSKPROBE FAIL ", tag, " iv byte mismatch"], ""))
            return 1
        i = i + 1
    echo(strutil.Join(["PSKPROBE ", tag, " keys match"], ""))
    return 0

fn main(): int32 =
    var tlsPolicy: policy.MsQuicTlsPolicy
    testpki.msquicMakeLocalhostTransportTlsPolicyInto(tlsPolicy)

    # ---- handshake #1: full; server must NOT accept psk; must issue NST ----
    let hello1Res: Result[Bytes] = tlshs.VpnProxyTcpTlsForwardClientBuildHello("localhost", tlsPolicy.trustRoot0)
    if IsErr(hello1Res):
        echo(ErrorText(hello1Res))
        return 1
    var hello1: Bytes = Value(hello1Res)
    let flight1Res: Result[tlshs.VpnProxyTcpTlsServerFlight] = tlshs.VpnProxyTcpTlsForwardServerBuildFlight(hello1, tlsPolicy)
    BytesFree(hello1)
    if IsErr(flight1Res):
        echo(ErrorText(flight1Res))
        return 1
    var flight1: tlshs.VpnProxyTcpTlsServerFlight = Value(flight1Res)
    if hs.msquicTls13ServerPskAccepted():
        echo("PSKPROBE FAIL handshake1 psk accepted (must be full)")
        return 1
    let proc1Res: Result[Bytes] = tlshs.VpnProxyTcpTlsForwardClientProcessServerFlight(flight1.serverHelloRecord, flight1.encryptedHandshakeRecord)
    BytesFree(flight1.serverHelloRecord)
    BytesFree(flight1.encryptedHandshakeRecord)
    if IsErr(proc1Res):
        echo(ErrorText(proc1Res))
        return 1
    var clientFin1: Bytes = Value(proc1Res)
    let fin1Res: Result[bool] = tlshs.VpnProxyTcpTlsForwardServerProcessClientFinished(clientFin1)
    BytesFree(clientFin1)
    if IsErr(fin1Res):
        echo(ErrorText(fin1Res))
        return 1
    let storeRes: Result[bool] = tlshs.VpnProxyTcpTlsForwardClientStoreResumeTicket("localhost")
    if IsErr(storeRes):
        echo(ErrorText(storeRes))
        return 1

    # ---- handshakes #2 and #3: resume; server must accept and rotate ticket ----
    var round: int32 = 2
    while round <= 3:
        let helloRes: Result[Bytes] = tlshs.VpnProxyTcpTlsForwardClientBuildHelloMaybeResume("localhost", tlsPolicy.trustRoot0)
        if IsErr(helloRes):
            echo(ErrorText(helloRes))
            return 1
        var hello: Bytes = Value(helloRes)
        let helloLen: int32 = BytesLen(hello)
        let flightRes: Result[tlshs.VpnProxyTcpTlsServerFlight] = tlshs.VpnProxyTcpTlsForwardServerBuildFlight(hello, tlsPolicy)
        BytesFree(hello)
        if IsErr(flightRes):
            echo(ErrorText(flightRes))
            return 1
        var flight: tlshs.VpnProxyTcpTlsServerFlight = Value(flightRes)
        if !hs.msquicTls13ServerPskAccepted():
            echo(strutil.Join(["PSKPROBE FAIL resume", IntToStr(round), " server did not accept psk"], ""))
            return 1
        let procRes: Result[Bytes] = tlshs.VpnProxyTcpTlsForwardClientProcessServerFlight(flight.serverHelloRecord, flight.encryptedHandshakeRecord)
        BytesFree(flight.serverHelloRecord)
        BytesFree(flight.encryptedHandshakeRecord)
        if IsErr(procRes):
            echo(ErrorText(procRes))
            return 1
        var clientFin: Bytes = Value(procRes)
        let finRes: Result[bool] = tlshs.VpnProxyTcpTlsForwardServerProcessClientFinished(clientFin)
        BytesFree(clientFin)
        if IsErr(finRes):
            echo(ErrorText(finRes))
            return 1
        var cSend: rec.VpnProxyTcpTlsRecordKeys
        var cRecv: rec.VpnProxyTcpTlsRecordKeys
        var sSend: rec.VpnProxyTcpTlsRecordKeys
        var sRecv: rec.VpnProxyTcpTlsRecordKeys
        let csRes: Result[bool] = tlshs.VpnProxyTcpTlsForwardClientAppSendKeysInto(cSend)
        let crRes: Result[bool] = tlshs.VpnProxyTcpTlsForwardClientAppRecvKeysInto(cRecv)
        let ssRes: Result[bool] = tlshs.VpnProxyTcpTlsForwardServerAppSendKeysInto(sSend)
        let srRes: Result[bool] = tlshs.VpnProxyTcpTlsForwardServerAppRecvKeysInto(sRecv)
        if IsErr(csRes) or IsErr(crRes) or IsErr(ssRes) or IsErr(srRes):
            echo("PSKPROBE FAIL app key derivation")
            return 1
        let label: str = strutil.Join(["resume", IntToStr(round), " hello_len=", IntToStr(helloLen)], "")
        let m1: int32 = keysMatchReport(strutil.Join([share(label), " c_send==s_recv"], ""), cSend, sRecv)
        let m2: int32 = keysMatchReport(strutil.Join([share(label), " c_recv==s_send"], ""), cRecv, sSend)
        if m1 != 0 or m2 != 0:
            return 1
        let storeRoundRes: Result[bool] = tlshs.VpnProxyTcpTlsForwardClientStoreResumeTicket("localhost")
        if IsErr(storeRoundRes):
            echo(ErrorText(storeRoundRes))
            return 1
        round = round + 1
    echo("PSKPROBE OK all (full + resume x2, ticket rotation, pairwise app keys)")
    return 0
