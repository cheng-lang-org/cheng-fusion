fn R24Trim(raw: str): str =
    return raw

fn R24Tag(raw: str): str =
    if raw.len > 3:
        return "long"
    return "short"

fn R24Keep(lineRaw: str, genericPos: int32): int32 =
    let keep = R24Tag(lineRaw)
    let headRaw = R24Trim(lineRaw)
    var head: str
    if genericPos > 0:
        head = R24Tag(headRaw)
    else:
        head = headRaw
    if keep == "long":
        return 100 + head.len
    if keep == "short":
        return 200 + head.len
    return 900

fn main(): int32 =
    let a = R24Keep("abcdef", 1)
    if a != 104:
        return 10
    let b = R24Keep("abcdef", 0)
    if b != 106:
        return 11
    let c = R24Keep("ab", 1)
    if c != 205:
        return 12
    echo("r24 keepafter ok a=104 b=106 c=205")
    return 0
