import cheng/libp2p/core/types
import cheng/libp2p/discovery/node_selector

fn main(): int32 =
    let now = int64(1776297600)
    let gib = int64(1024) * int64(1024) * int64(1024)

    var heavyPeer: types.Libp2pPeerId
    heavyPeer.value.data[0] = uint8(1)
    var lightPeer: types.Libp2pPeerId
    lightPeer.value.data[0] = uint8(2)
    var badPeer: types.Libp2pPeerId
    badPeer.value.data[0] = uint8(3)

    var heavyResources: types.Libp2pNodeResource
    heavyResources.cpuLogicalCores = 16
    heavyResources.memoryAvailableBytes = int64(64) * gib
    heavyResources.diskAvailableBytes = int64(1024) * gib
    heavyResources.gpuDeviceCount = 1
    heavyResources.gpuCoreCount = 64

    var lightResources: types.Libp2pNodeResource
    lightResources.cpuLogicalCores = 4
    lightResources.memoryAvailableBytes = int64(8) * gib
    lightResources.diskAvailableBytes = int64(64) * gib

    var badResources: types.Libp2pNodeResource
    badResources.cpuLogicalCores = 2
    badResources.memoryAvailableBytes = int64(2) * gib
    badResources.diskAvailableBytes = int64(16) * gib

    var heavy: node_selector.Libp2pNodeSelectionInput
    heavy.peerId = heavyPeer
    heavy.endpointText = "https://heavy.ingress.example/v1/libp2p"
    heavy.region = "global"
    heavy.resources = heavyResources
    heavy.successPermille = 980
    heavy.latencyMs = 24
    heavy.loadPermille = 80
    heavy.capacityPermille = 950
    heavy.reputationPermille = 900
    heavy.sameOperatorPenaltyPermille = 10
    heavy.advertisedAtEpochSeconds = now - int64(10)
    heavy.ttlSeconds = 120
    heavy.failureCooldownUntilEpochSeconds = now - int64(1)

    var light: node_selector.Libp2pNodeSelectionInput
    light.peerId = lightPeer
    light.endpointText = "https://light.ingress.example/v1/libp2p"
    light.region = "global"
    light.resources = lightResources
    light.successPermille = 430
    light.latencyMs = 210
    light.loadPermille = 620
    light.capacityPermille = 420
    light.reputationPermille = 300
    light.sameOperatorPenaltyPermille = 20
    light.advertisedAtEpochSeconds = now - int64(10)
    light.ttlSeconds = 120
    light.failureCooldownUntilEpochSeconds = now - int64(1)

    var bad: node_selector.Libp2pNodeSelectionInput
    bad.peerId = badPeer
    bad.endpointText = "https://bad.ingress.example/v1/libp2p"
    bad.region = "global"
    bad.resources = badResources
    bad.latencyMs = 900
    bad.loadPermille = 1000
    bad.advertisedAtEpochSeconds = now - int64(10)
    bad.ttlSeconds = 120
    bad.failureCooldownUntilEpochSeconds = now + int64(60)

    var inputs: node_selector.Libp2pNodeSelectionInput[]
    add(inputs, heavy)
    add(inputs, light)
    add(inputs, bad)

    let heavyScore = node_selector.Libp2pNodeSelectionScore(heavy,
                                                            node_selector.Libp2pNodeSelectionRoleBootstrap,
                                                            now)
    let lightScore = node_selector.Libp2pNodeSelectionScore(light,
                                                            node_selector.Libp2pNodeSelectionRoleBootstrap,
                                                            now)
    let badScore = node_selector.Libp2pNodeSelectionScore(bad,
                                                          node_selector.Libp2pNodeSelectionRoleBootstrap,
                                                          now)
    if heavyScore <= lightScore:
        return 20
    if badScore != 0:
        return 21

    return 0
