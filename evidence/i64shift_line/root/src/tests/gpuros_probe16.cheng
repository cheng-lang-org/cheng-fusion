@profile("driver_safe")

type
    IoUInt8Ptr = uint8 *

@trusted_abi
fn IoSt8(base: uint64, offset: uint64, value: int32) =
    let b = base
    let o = offset
    let addr = ptr(b + o)
    *(IoUInt8Ptr(addr)) = uint8(value & 255)

fn HexNib(v: uint32) =
    let w = v
    if w < 10:
        IoSt8(268435456, 0, int32(48 + w))
    else:
        IoSt8(268435456, 0, int32(87 + w))

fn Hex32(v: uint32) =
    var div = uint32(268435456)
    while div > uint32(0):
        HexNib((v / div) & uint32(15))
        div = div / uint32(16)

fn Sep() =
    IoSt8(268435456, 0, 32)

fn main(): int32 =
    var i = 3
    let m = i * 4
    Hex32(uint32(m))
    Sep()
    let a = 305419896
    let b2 = a + 3
    Hex32(uint32(b2))
    IoSt8(268435456, 0, 10)
    return 0
