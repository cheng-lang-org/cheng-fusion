import cheng/core/runtime/web_layout_runtime as layout
import cheng/core/runtime/web_paint_runtime as paint

fn runPaintDisplayListSmoke(): int32 =
    var tree: layout.WebLayoutTree
    layout.WebLayoutTreeInit(tree)

    var root = 0
    var first = 0
    var second = 0
    var outside = 0

    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, 100, 100, 0, 0, root):
        return 1
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, 50, 20, 10, 10, first):
        return 2
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, 120, 30, 0, 5, second):
        return 3
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, 10, 10, 0, 100, outside):
        return 4

    if !layout.WebLayoutAppendChild(tree, root, first):
        return 5
    if !layout.WebLayoutAppendChild(tree, root, second):
        return 6
    if !layout.WebLayoutAppendChild(tree, root, outside):
        return 7

    if !layout.WebLayoutCompute(tree, root):
        return 8
    if layout.WebLayoutBoxCount(tree) != 4:
        return 9

    var colors: paint.WebPaintColorRegistry
    paint.WebPaintColorRegistryInit(colors)
    if !paint.WebPaintRegisterFillColor(colors, root, 111):
        return 10
    if !paint.WebPaintRegisterFillColor(colors, first, 222):
        return 11
    if !paint.WebPaintRegisterFillColor(colors, second, 333):
        return 12
    if !paint.WebPaintRegisterFillColor(colors, outside, 444):
        return 13

    var list: paint.WebPaintDisplayList
    paint.WebPaintDisplayListInit(list)
    if !paint.WebPaintBuildDisplayList(tree, colors, 20, 15, 70, 40, list):
        return 14
    if paint.WebPaintDisplayItemCount(list) != 3:
        return 15

    if paint.WebPaintDisplayItemNodeAt(list, 0) != root:
        return 16
    if paint.WebPaintDisplayItemXAt(list, 0) != 20:
        return 17
    if paint.WebPaintDisplayItemYAt(list, 0) != 15:
        return 18
    if paint.WebPaintDisplayItemWidthAt(list, 0) != 70:
        return 19
    if paint.WebPaintDisplayItemHeightAt(list, 0) != 40:
        return 20
    if paint.WebPaintDisplayItemFillColorAt(list, 0) != 111:
        return 21

    if paint.WebPaintDisplayItemNodeAt(list, 1) != first:
        return 22
    if paint.WebPaintDisplayItemXAt(list, 1) != 20:
        return 23
    if paint.WebPaintDisplayItemYAt(list, 1) != 15:
        return 24
    if paint.WebPaintDisplayItemWidthAt(list, 1) != 40:
        return 25
    if paint.WebPaintDisplayItemHeightAt(list, 1) != 15:
        return 26
    if paint.WebPaintDisplayItemFillColorAt(list, 1) != 222:
        return 27

    if paint.WebPaintDisplayItemNodeAt(list, 2) != second:
        return 28
    if paint.WebPaintDisplayItemXAt(list, 2) != 20:
        return 29
    if paint.WebPaintDisplayItemYAt(list, 2) != 35:
        return 30
    if paint.WebPaintDisplayItemWidthAt(list, 2) != 70:
        return 31
    if paint.WebPaintDisplayItemHeightAt(list, 2) != 20:
        return 32
    if paint.WebPaintDisplayItemFillColorAt(list, 2) != 333:
        return 33

    if paint.WebPaintBuildDisplayList(tree, colors, 20, 15, -1, 40, list):
        return 34
    if paint.WebPaintBuildDisplayList(tree, colors, 20, 15, 70, 0, list):
        return 35

    var missingColors: paint.WebPaintColorRegistry
    paint.WebPaintColorRegistryInit(missingColors)
    if !paint.WebPaintRegisterFillColor(missingColors, root, 111):
        return 36
    if paint.WebPaintBuildDisplayList(tree, missingColors, 20, 15, 70, 40, list):
        return 37
    if paint.WebPaintDisplayItemCount(list) != 0:
        return 38
    return 0

fn runPaintAncestorOverflowClipSmoke(): int32 =
    var tree: layout.WebLayoutTree
    layout.WebLayoutTreeInit(tree)

    var root = 0
    var child = 0
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, 10, 10, 0, 0, root):
        return 39
    if !layout.WebLayoutSetOverflow(tree, root, layout.WebLayoutOverflowHidden, layout.WebLayoutOverflowHidden):
        return 40
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, 10, 20, 0, 0, child):
        return 41
    if !layout.WebLayoutSetTextContent(tree, child, "AA"):
        return 42
    if !layout.WebLayoutAppendChild(tree, root, child):
        return 43
    if !layout.WebLayoutCompute(tree, root):
        return 44

    var registry: paint.WebPaintColorRegistry
    paint.WebPaintColorRegistryInit(registry)
    if !paint.WebPaintRegisterFillStyle(registry, child, 222, 0):
        return 45

    var ops: paint.PaintOp[]
    if !paint.WebPaintBuildOpsFromLayoutTreeWithRegistry(tree, registry, ops):
        return 46
    if ops.len != 2:
        return 47
    if ops[0].kind != paint.PaintOpKindFillRect:
        return 48
    if ops[0].clipRect.x != 0 || ops[0].clipRect.y != 0:
        return 49
    if ops[0].clipRect.width != 10 || ops[0].clipRect.height != 10:
        return 50
    if ops[1].kind != paint.PaintOpKindFillText:
        return 51
    if ops[1].clipRect.x != 0 || ops[1].clipRect.y != 0:
        return 52
    if ops[1].clipRect.width != 10 || ops[1].clipRect.height != 10:
        return 53
    return 0

fn runPaintNonRestrictiveAncestorClipSmoke(): int32 =
    var tree: layout.WebLayoutTree
    layout.WebLayoutTreeInit(tree)

    var root = 0
    var child = 0
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, 100, 100, 0, 0, root):
        return 54
    if !layout.WebLayoutSetOverflow(tree, root, layout.WebLayoutOverflowHidden, layout.WebLayoutOverflowHidden):
        return 55
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, 20, 20, 0, 0, child):
        return 56
    if !layout.WebLayoutSetTextContent(tree, child, "AA"):
        return 57
    if !layout.WebLayoutAppendChild(tree, root, child):
        return 58
    if !layout.WebLayoutCompute(tree, root):
        return 59

    var registry: paint.WebPaintColorRegistry
    paint.WebPaintColorRegistryInit(registry)
    if !paint.WebPaintRegisterFillStyle(registry, child, 222, 0):
        return 60

    var ops: paint.PaintOp[]
    if !paint.WebPaintBuildOpsFromLayoutTreeWithRegistry(tree, registry, ops):
        return 61
    if ops.len != 2:
        return 62
    if ops[0].clipRect.width != 0 || ops[0].clipRect.height != 0:
        return 63
    if ops[1].clipRect.width != 0 || ops[1].clipRect.height != 0:
        return 64
    return 0

fn runPaintInheritedTextColorSmoke(): int32 =
    var tree: layout.WebLayoutTree
    layout.WebLayoutTreeInit(tree)

    var root = 0
    var label = 0
    var text = 0
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, 100, 100, 0, 0, root):
        return 80
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, 100, 20, 0, 0, label):
        return 81
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayInline, 20, 20, 0, 0, text):
        return 82
    if !layout.WebLayoutSetTextContent(tree, text, "AA"):
        return 83
    if !layout.WebLayoutAppendChild(tree, root, label):
        return 84
    if !layout.WebLayoutAppendChild(tree, label, text):
        return 85
    if !layout.WebLayoutCompute(tree, root):
        return 86

    var registry: paint.WebPaintColorRegistry
    paint.WebPaintColorRegistryInit(registry)
    if !paint.WebPaintRegisterTextColor(registry, label, 777):
        return 87

    var ops: paint.PaintOp[]
    if !paint.WebPaintBuildOpsFromLayoutTreeWithRegistry(tree, registry, ops):
        return 88
    if ops.len != 1:
        return 89
    if ops[0].kind != paint.PaintOpKindFillText:
        return 90
    if ops[0].color != 777:
        return 91
    return 0

fn runPaintIconFallbackBoxSmoke(): int32 =
    var tree: layout.WebLayoutTree
    layout.WebLayoutTreeInit(tree)

    var root = 0
    var icon = 0
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, 64, 64, 0, 0, root):
        return 65
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, 64, 0, 0, 0, icon):
        return 66
    if !layout.WebLayoutAppendChild(tree, root, icon):
        return 67
    if !layout.WebLayoutCompute(tree, root):
        return 68

    var registry: paint.WebPaintColorRegistry
    paint.WebPaintColorRegistryInit(registry)
    if !paint.WebPaintRegisterIconStyle(registry, icon, paint.PaintIconKindGlobe, 777, 32):
        return 69

    var ops: paint.PaintOp[]
    if !paint.WebPaintBuildOpsFromLayoutTreeWithRegistry(tree, registry, ops):
        return 70
    if ops.len != 1:
        return 71
    if ops[0].kind != paint.PaintOpKindIcon:
        return 72
    if ops[0].rect.x != 16 || ops[0].rect.y != 16:
        return 73
    if ops[0].rect.width != 32 || ops[0].rect.height != 32:
        return 74
    if ops[0].icon.kind != paint.PaintIconKindGlobe || ops[0].color != 777:
        return 75
    if paint.PaintIconSvgPrimitiveCount(paint.PaintIconKindCheck) != 2:
        return 76
    var primitive: paint.PaintSvgPrimitive
    if !paint.PaintIconSvgPrimitiveAt(paint.PaintIconKindCheck, 0, primitive):
        return 77
    if primitive.kind != paint.PaintSvgPrimitiveLine:
        return 78
    if primitive.x1 != 20 || primitive.y1 != 6 || primitive.x2 != 9 || primitive.y2 != 17:
        return 79
    return 0

fn runPaintPositionedDescendantStackingSmoke(): int32 =
    var tree: layout.WebLayoutTree
    layout.WebLayoutTreeInit(tree)

    var root = 0
    var row = 0
    var deleteLayer = 0
    var foreground = 0
    var label = 0
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, 100, 40, 0, 0, root):
        return 92
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, 100, 40, 0, 0, row):
        return 93
    if !layout.WebLayoutSetPosition(tree, row, layout.WebLayoutPositionRelative):
        return 94
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, 50, 40, 0, 0, deleteLayer):
        return 95
    if !layout.WebLayoutSetPosition(tree, deleteLayer, layout.WebLayoutPositionAbsolute):
        return 96
    if !layout.WebLayoutSetOffsetTop(tree, deleteLayer, 0):
        return 97
    if !layout.WebLayoutSetOffsetRight(tree, deleteLayer, 0):
        return 98
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, 100, 40, 0, 0, foreground):
        return 99
    if !layout.WebLayoutSetPosition(tree, foreground, layout.WebLayoutPositionRelative):
        return 100
    if !layout.WebLayoutSetZIndex(tree, foreground, 10):
        return 101
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayInline, 0, 0, 0, 0, label):
        return 102
    if !layout.WebLayoutSetTextContent(tree, label, "ASI"):
        return 103
    if !layout.WebLayoutAppendChild(tree, root, row):
        return 104
    if !layout.WebLayoutAppendChild(tree, row, deleteLayer):
        return 105
    if !layout.WebLayoutAppendChild(tree, row, foreground):
        return 106
    if !layout.WebLayoutAppendChild(tree, foreground, label):
        return 107
    if !layout.WebLayoutCompute(tree, root):
        return 108

    var registry: paint.WebPaintColorRegistry
    paint.WebPaintColorRegistryInit(registry)
    if !paint.WebPaintRegisterFillStyle(registry, deleteLayer, 111, 0):
        return 109
    if !paint.WebPaintRegisterFillStyle(registry, foreground, 222, 0):
        return 110

    var ops: paint.PaintOp[]
    if !paint.WebPaintBuildOpsFromLayoutTreeWithRegistry(tree, registry, ops):
        return 111
    var deleteFillIndex: int32 = -1
    var foregroundFillIndex: int32 = -1
    var labelTextIndex: int32 = -1
    for i in 0..<ops.len:
        if ops[i].kind == paint.PaintOpKindFillRect && ops[i].color == 111:
            deleteFillIndex = i
        elif ops[i].kind == paint.PaintOpKindFillRect && ops[i].color == 222:
            foregroundFillIndex = i
        elif ops[i].kind == paint.PaintOpKindFillText:
            labelTextIndex = i
    if deleteFillIndex < 0 || foregroundFillIndex < 0 || labelTextIndex < 0:
        return 112
    if deleteFillIndex > foregroundFillIndex:
        return 113
    if deleteFillIndex > labelTextIndex:
        return 114
    return 0

fn runPaintTextOverflowEllipsisSmoke(): int32 =
    var tree: layout.WebLayoutTree
    layout.WebLayoutTreeInit(tree)

    var root = 0
    var text = 0
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, 48, 20, 0, 0, root):
        return 115
    if !layout.WebLayoutSetOverflow(tree, root, layout.WebLayoutOverflowHidden, layout.WebLayoutOverflowHidden):
        return 116
    let rootIdx = layout.WebLayoutFindStyleIndex(tree, root)
    if rootIdx < 0:
        return 117
    tree.styles[rootIdx].whiteSpaceNowrap = true
    tree.styles[rootIdx].textOverflowEllipsis = true
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayInline, 54, 12, 0, 0, text):
        return 118
    if !layout.WebLayoutSetTextContent(tree, text, "abcdefghi"):
        return 119
    if !layout.WebLayoutSetFontSize(tree, text, 10):
        return 120
    let textIdx = layout.WebLayoutFindStyleIndex(tree, text)
    if textIdx < 0:
        return 121
    tree.styles[textIdx].renderFontSize = 10
    tree.styles[textIdx].lineHeight = 12
    if !layout.WebLayoutAppendChild(tree, root, text):
        return 122
    if !layout.WebLayoutCompute(tree, root):
        return 123

    var registry: paint.WebPaintColorRegistry
    paint.WebPaintColorRegistryInit(registry)
    var ops: paint.PaintOp[]
    if !paint.WebPaintBuildOpsFromLayoutTreeWithRegistry(tree, registry, ops):
        return 124
    if ops.len != 1:
        return 125
    if ops[0].kind != paint.PaintOpKindFillText:
        return 126
    if ops[0].text.text != "abcde...":
        echo(Fmt"ellipsis actual {ops[0].text.text}")
        return 127
    if ops[0].text.alignWidth != 48:
        return 128
    return 0

fn main(): int32 =
    var code = runPaintDisplayListSmoke()
    if code != 0:
        echo(Fmt"FAIL runPaintDisplayListSmoke: {code}")
        return code
    code = runPaintAncestorOverflowClipSmoke()
    if code != 0:
        echo(Fmt"FAIL runPaintAncestorOverflowClipSmoke: {code}")
        return code
    code = runPaintNonRestrictiveAncestorClipSmoke()
    if code != 0:
        echo(Fmt"FAIL runPaintNonRestrictiveAncestorClipSmoke: {code}")
        return code
    code = runPaintInheritedTextColorSmoke()
    if code != 0:
        echo(Fmt"FAIL runPaintInheritedTextColorSmoke: {code}")
        return code
    code = runPaintIconFallbackBoxSmoke()
    if code != 0:
        echo(Fmt"FAIL runPaintIconFallbackBoxSmoke: {code}")
        return code
    code = runPaintPositionedDescendantStackingSmoke()
    if code != 0:
        echo(Fmt"FAIL runPaintPositionedDescendantStackingSmoke: {code}")
        return code
    code = runPaintTextOverflowEllipsisSmoke()
    if code != 0:
        echo(Fmt"FAIL runPaintTextOverflowEllipsisSmoke: {code}")
        return code
    echo("web_runtime_paint_smoke ok")
    return 0
