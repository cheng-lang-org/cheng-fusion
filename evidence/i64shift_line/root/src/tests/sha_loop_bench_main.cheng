import std/crypto/sha256
import std/rawbytes
import std/times
import std/os as os

fn main(): int32 =
    let data = BytesAlloc(1024)
    let t0 = times.MonotimeMs()
    var i: int32
    var acc: int32
    for i in i..<5750:
        let d = sha256.Sha256Digest(data)
        let h = BytesToHex(d)
        acc = acc + len(h)
    let t1 = times.MonotimeMs()
    os.WriteFile("/tmp/sha_bench_out.txt", IntToStr(t1 - t0))
    return acc - 368000
