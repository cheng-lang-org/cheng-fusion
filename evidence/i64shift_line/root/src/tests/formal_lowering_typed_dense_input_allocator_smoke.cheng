import std/os
import std/strformat
import cheng/core/backend/lowering_plan as lower

fn beginAllocatorEpoch(plan: var lower.LoweringPlanStub) =
    lower.LoweringTypedFunctionDenseStoreInputAllocatorRelease(plan)
    let receipt =
        plan.typedFunctionDenseStoreInputAllocatorReceipt
    if !lower.LoweringTypedFunctionDenseStoreInputAllocatorReceiptConsumeStrict(
           plan, receipt):
        panic("formal lowering typed dense input: epoch strict consume failed")
    lower.LoweringTypedFunctionDenseStoreInputAllocatorBegin(plan)

fn allocateTypedDenseInput(plan: var lower.LoweringPlanStub,
                           rowCount: int32) =
    var functionNames: str[]
    var functionParamCounts: int32[]
    var functionResultTypeTags: int32[]
    var functionSourcePaths: str[]
    var functionBodyKinds: int32[]
    var functionEntryFlags: int32[]
    var functionTypedIndices: int32[]
    var functionParamTypeStarts: int32[]
    lower.LoweringSequenceAllocatorSetLen(
        plan,
        functionNames,
        lower.LoweringTypedDenseFunctionNameLength(length: rowCount))
    lower.LoweringSequenceAllocatorSetLen(
        plan,
        functionParamCounts,
        lower.LoweringTypedDenseParamCountLength(length: rowCount))
    lower.LoweringSequenceAllocatorSetLen(
        plan,
        functionResultTypeTags,
        lower.LoweringTypedDenseResultTypeLength(length: rowCount))
    lower.LoweringSequenceAllocatorSetLen(
        plan,
        functionSourcePaths,
        lower.LoweringTypedDenseSourcePathLength(length: rowCount))
    lower.LoweringSequenceAllocatorSetLen(
        plan,
        functionBodyKinds,
        lower.LoweringTypedDenseBodyKindLength(length: rowCount))
    lower.LoweringSequenceAllocatorSetLen(
        plan,
        functionEntryFlags,
        lower.LoweringTypedDenseEntryFlagLength(length: rowCount))
    lower.LoweringSequenceAllocatorSetLen(
        plan,
        functionTypedIndices,
        lower.LoweringTypedDenseTypedIndexLength(length: rowCount))
    lower.LoweringSequenceAllocatorSetLen(
        plan,
        functionParamTypeStarts,
        lower.LoweringTypedDenseParamTypeStartLength(
            length: rowCount + 1))
    plan.typedFunctionDenseStore.functionNames = functionNames
    plan.typedFunctionDenseStore.functionParamCounts = functionParamCounts
    plan.typedFunctionDenseStore.functionResultTypeTags =
        functionResultTypeTags
    plan.typedFunctionDenseStore.functionSourcePaths = functionSourcePaths
    plan.typedFunctionDenseStore.functionBodyKinds = functionBodyKinds
    plan.typedFunctionDenseStore.functionEntryFlags = functionEntryFlags
    plan.typedFunctionDenseStore.functionTypedIndices = functionTypedIndices
    plan.typedFunctionDenseStore.functionParamTypeStarts =
        functionParamTypeStarts

fn main(): int32 =
    var plan: lower.LoweringPlanStub
    os.WriteLine(os.GetStdout(), "typed_dense_probe=start")
    beginAllocatorEpoch(plan)
    os.WriteLine(os.GetStdout(), "typed_dense_probe=begin_1")
    allocateTypedDenseInput(plan, 40)
    os.WriteLine(os.GetStdout(), "typed_dense_probe=allocate_1")
    beginAllocatorEpoch(plan)
    os.WriteLine(os.GetStdout(), "typed_dense_probe=begin_2")
    allocateTypedDenseInput(plan, 40)
    os.WriteLine(os.GetStdout(), "typed_dense_probe=allocate_2")
    let terminalBufferCount =
        lower.LoweringTypedFunctionDenseStoreInputAllocatorPhysicalBufferCount(
            plan)
    let terminalBytes =
        lower.LoweringTypedFunctionDenseStoreInputAllocatorCapacityBytes(plan)
    if terminalBufferCount != 8 || terminalBytes <= int64(0):
        panic("formal lowering typed dense input: terminal retained mismatch")
    let negative =
        os.GetEnv("CHENG_FORMAL_LOWERING_TYPED_DENSE_INPUT_NEGATIVE")
    if negative == "shape":
        while plan.typedFunctionDenseStore.functionNames.len <
              plan.typedFunctionDenseStore.functionNames.cap:
            add(plan.typedFunctionDenseStore.functionNames, "")
        add(plan.typedFunctionDenseStore.functionNames, "")
    var planReceipt: lower.LoweringPlanReleaseReceipt
    os.WriteLine(os.GetStdout(), "typed_dense_probe=release_begin")
    lower.LoweringPlanReleaseWithReceipt(plan, planReceipt)
    os.WriteLine(os.GetStdout(), "typed_dense_probe=release_end")
    var receipt = planReceipt.typedFunctionDenseStoreInputAllocator
    if negative == "receipt-bytes":
        planReceipt.typedFunctionDenseStoreInputAllocator.allocatedCapacityBytes =
            planReceipt.typedFunctionDenseStoreInputAllocator.allocatedCapacityBytes -
            int64(1)
    if negative == "owner-token":
        plan.typedFunctionDenseStoreInputAllocatorOwnerToken.data[0] =
            plan.typedFunctionDenseStoreInputAllocatorOwnerToken.data[0] ^ 1
    if receipt.allocationEventCount != int64(terminalBufferCount) ||
       receipt.releaseEventCount != receipt.allocationEventCount ||
       receipt.allocatedCapacityBytes != terminalBytes ||
       receipt.releasedCapacityBytes != receipt.allocatedCapacityBytes ||
       receipt.terminalRetainedBufferCount != terminalBufferCount ||
       receipt.terminalRetainedBytes != terminalBytes ||
       receipt.terminalReleasedBufferCount != terminalBufferCount ||
       receipt.terminalReleasedBytes != terminalBytes ||
       receipt.liveAllocationCount != int64(0) ||
       receipt.liveCapacityBytes != int64(0) ||
       !lower.LoweringSequenceAllocatorReceiptClosed(receipt):
        panic(Fmt"formal lowering typed dense input: allocator receipt mismatch mode={negative}")
    var err: str
    os.WriteLine(os.GetStdout(), "typed_dense_probe=consume_begin")
    if !lower.LoweringPlanReleaseReceiptConsumeStrictInto(
           plan, planReceipt, err):
        panic(Fmt"formal lowering typed dense input: aggregate receipt mismatch mode={negative} err={err}")
    os.WriteLine(os.GetStdout(), "typed_dense_probe=consume_end")
    if !plan.typedFunctionDenseStoreInputAllocatorReceiptConsumed ||
       !plan.terminalReleaseReceiptConsumed ||
       lower.LoweringPlanRetainedBufferCount(plan) != 0 ||
       lower.LoweringPlanRetainedBytes(plan) != int64(0):
        panic("formal lowering typed dense input: terminal consume incomplete")
    os.WriteLine(
        os.GetStdout(),
        Fmt"formal_lowering_typed_dense_input_allocator_smoke ok columns=9 rows=40 allocation_events={receipt.allocationEventCount} release_events={receipt.releaseEventCount} allocated_bytes={receipt.allocatedCapacityBytes} released_bytes={receipt.releasedCapacityBytes} terminal_buffers={receipt.terminalRetainedBufferCount} terminal_bytes={receipt.terminalRetainedBytes} live={receipt.liveAllocationCount} live_bytes={receipt.liveCapacityBytes}")
    return 0
