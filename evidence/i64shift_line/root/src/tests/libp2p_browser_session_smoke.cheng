import std/system
import std/strings
import cheng/apps/libp2p_browser/session as sess
import cheng/apps/libp2p_browser/compile_render as compile
import cheng/apps/libp2p_browser/sync_protocol as sync

fn fail(code: int32, msg: str): int32 =
    echo(msg)
    return code

@borrows
fn jsonHas(hay: str, needle: str): bool =
    if needle.len > hay.len:
        return false
    var i: int32 = 0
    while i + needle.len <= hay.len:
        var ok = true
        var j: int32 = 0
        while j < needle.len:
            if hay[i + j] != needle[j]:
                ok = false
            j = j + 1
        if ok:
            return true
        i = i + 1
    return false

fn main(): int32 =
    var desk = sess.BrowserSessionInit("desktop-peer", 400, 600)
    var phone = sess.BrowserSessionInit("phone-peer", 400, 600)
    if desk.rightOpen:
        return fail(1, "right must start closed")
    if !sess.BrowserSessionAttachPeer(desk, "phone-peer"):
        return fail(2, "attach phone")
    if !sess.BrowserSessionSelectPeer(desk, "phone-peer"):
        return fail(3, "select phone")
    if !sess.BrowserSessionAttachPeer(phone, "desktop-peer"):
        return fail(4, "attach desk")
    sess.BrowserSessionBeginLoad(desk, "https://ex.test/home")
    if desk.rightOpen || desk.loadComplete:
        return fail(5, "right stays closed until load complete")
    let html = "<html><body><input id=\"q\" type=\"text\" value=\"\"><a href=\"/next\">n</a></body></html>"
    if !sess.BrowserSessionOnLoadComplete(desk, html):
        echo(desk.lastError)
        return fail(6, "load complete compile")
    if !desk.rightOpen || !desk.loadComplete:
        return fail(7, "right opens after load complete")
    if desk.inputCount < 1:
        return fail(8, "compiled input")
    var inputIdx: int32 = -1
    var linkIdx: int32 = -1
    var wi: int32 = 0
    while wi < desk.widgets.len:
        if desk.widgets[wi].kind == compile.BrowserWidgetInput:
            inputIdx = wi
        if desk.widgets[wi].kind == compile.BrowserWidgetAnchor:
            linkIdx = wi
        wi = wi + 1
    if inputIdx < 0 || linkIdx < 0:
        return fail(9, "widget idx")
    let ix = desk.widgets[inputIdx].x + 1
    let iy = desk.widgets[inputIdx].y + 1
    let clickKind = sess.BrowserSessionClick(desk, ix, iy)
    if clickKind != 1:
        return fail(10, "focus input")
    if !sess.BrowserSessionKeyChar(desk, 97):
        echo(strings.IntToStr(desk.focusedNodeId))
        echo(strings.IntToStr(desk.widgets.len))
        echo(strings.IntToStr(desk.widgets[inputIdx].nodeId))
        echo(desk.widgets[inputIdx].inputType)
        return fail(11, "type a")
    if !sess.BrowserSessionKeyChar(desk, 98):
        return fail(12, "type b")
    if desk.widgets[inputIdx].value != "ab":
        echo(desk.widgets[inputIdx].value)
        return fail(13, "typed value")
    let nDeliver = sess.BrowserSessionDeliver(desk, phone)
    if nDeliver <= 0:
        return fail(14, "deliver")
    let applied = sess.BrowserSessionApplyInbox(phone)
    if applied <= 0:
        return fail(15, "phone apply")
    if phone.pendingUrl != "https://ex.test/home" && phone.url != "https://ex.test/home":
        if phone.rightOpen:
            return fail(16, "phone should not open right from input-only")
    sess.BrowserSessionBeginLoad(phone, "https://ex.test/home")
    if !sess.BrowserSessionOnLoadComplete(phone, html):
        echo(phone.lastError)
        return fail(17, "phone compile")
    sess.BrowserSessionApplyPendingInputs(phone)
    var phoneHas = false
    var pi: int32 = 0
    while pi < phone.widgets.len:
        if phone.widgets[pi].fieldId == "q" && phone.widgets[pi].value == "ab":
            phoneHas = true
        pi = pi + 1
    if !phoneHas:
        var msg = sync.BrowserSyncInput("q", "ab", "https://ex.test/home", phone.sessionEpoch)
        let wire = sync.BrowserSyncEncode(msg)
        if wire.len <= 0:
            return fail(18, "encode fallback")
        if !sess.BrowserSessionPushInboxEncoded(phone, wire):
            return fail(19, "push")
        sess.BrowserSessionApplyInbox(phone)
        pi = 0
        while pi < phone.widgets.len:
            if phone.widgets[pi].fieldId == "q" && phone.widgets[pi].value == "ab":
                phoneHas = true
            pi = pi + 1
    if !phoneHas:
        return fail(20, "phone input value")
    let lx = desk.widgets[linkIdx].x + 1
    let ly = desk.widgets[linkIdx].y + 1
    let navKind = sess.BrowserSessionClick(desk, lx, ly)
    if navKind != 2:
        return fail(21, "navigate click")
    if desk.rightOpen:
        return fail(22, "right closes on navigate")
    if desk.pendingUrl != "https://ex.test/next" && desk.url != "https://ex.test/next":
        echo(desk.url)
        return fail(23, "nav url")
    sess.BrowserSessionDeliver(desk, phone)
    sess.BrowserSessionApplyInbox(phone)
    if phone.rightOpen:
        return fail(24, "phone right closes on nav")
    if phone.url != "https://ex.test/next" && phone.pendingUrl != "https://ex.test/next":
        echo(phone.url)
        return fail(25, "phone nav url")
    let snap = sess.BrowserSessionSnapshotJson(desk)
    if !jsonHas(snap, "cheng_libp2p_browser_v1"):
        return fail(26, "snapshot format")
    if jsonHas(snap, "\"right_open\":true"):
        return fail(27, "snapshot right closed after nav")
    let html2 = "<html><body><p>page2</p><input id=\"z\" type=\"text\" value=\"\"></body></html>"
    if !sess.BrowserSessionOnPageLoaded(desk, "https://ex.test/next", html2):
        echo(desk.lastError)
        return fail(28, "second page compile")
    if !desk.rightOpen || !desk.loadComplete:
        return fail(29, "new page load complete reopens right")
    if desk.url != "https://ex.test/next":
        echo(desk.url)
        return fail(30, "second page url")
    var direct = sess.BrowserSessionInit("direct-peer", 400, 600)
    if !sess.BrowserSessionOnPageLoaded(direct, "https://ex.test/direct", html):
        echo(direct.lastError)
        return fail(31, "direct load complete")
    if !direct.rightOpen:
        return fail(32, "load complete opens right without begin-load")
    echo("libp2p_browser_session_smoke ok")
    return 0
