fn idF64(value: float64): float64 =
    return value

fn nestedIdF64(value: float64): float64 =
    return idF64(idF64(value))

fn main(): int32 =
    let exact = 12345.625
    let once = idF64(exact)
    let nested = nestedIdF64(exact)
    if once != exact:
        return 1
    if nested != exact:
        return 2
    return 0
