type
    CPlan =
        fld0: int64
        boolFldA: bool

fn viaLet(): int32 =
    var p: CPlan
    p.boolFldA = true
    let b = p.boolFldA
    if b:
        return 1
    return 0

fn viaI64(): int32 =
    var p: CPlan
    p.fld0 = int64(7)
    if p.fld0 == int64(7):
        return 1
    return 0

fn viaBool(): int32 =
    var p: CPlan
    p.boolFldA = true
    if p.boolFldA:
        return 1
    return 0

fn main(): int32 =
    if viaLet() != 1:
        return 1
    if viaI64() != 1:
        return 2
    if viaBool() != 1:
        return 3
    return 0
