# purept W2 i1: TLS 1.3 key schedule + transcript + handshake codec.
#
# Sole judge: RFC 8448 "Implementations of TLS 1.3" official vectors,
# section 3 (Simple 1-RTT Handshake). All hex below is transcribed from the
# RFC text (rfc-editor.org/rfc/rfc8448) and was independently cross-checked
# by re-deriving the whole chain with a Python reference before hardcoding.
#
# Verdict sections:
#   A  ECDHE shared secret from the RFC x25519 keypairs
#   T  transcript hash chain
#   B  key schedule chain (early/handshake/master/ap/exp/res) + finished
#   C  codec decode of the RFC handshake messages (field-exact)
#   D  self-constructed encode->decode->encode byte identity (>=20)
#   E  negatives (bad lengths / bad verify_data / kind mismatch -> reject)
#
# Driver discipline note: this compiler generation rejects managed call
# results passed directly as plain Bytes/str arguments, so every intermediate
# is bound to a named local first (bind-first style throughout).

import std/system
import std/result
import std/rawbytes
import std/os
import std/strings
import std/buffer as bytebuffer
import std/crypto/curve25519 as x25519
import cheng/libp2p/crypto/ed25519/ed25519 as edsig
import cheng/quic/pure/tls13_keyschedule as ks
import cheng/quic/pure/tls13_transcript as tr
import cheng/quic/pure/tls13_messages as msg

var checksTotal: int32 = 0
var checksFailed: int32 = 0

fn hexValue(c: char): int32 =
    if c >= '0' && c <= '9':
        return int32(c) - int32('0')
    if c >= 'a' && c <= 'f':
        return 10 + int32(c) - int32('a')
    return -1

fn hexDecode(text: str): Result[Bytes] =
    if len(text) % 2 != 0:
        return Err[Bytes]("hex: length must be even")
    let out: Bytes = BytesAlloc(len(text) / 2)
    var i: int32
    while i < len(text):
        let hi: int32 = hexValue(text[i])
        let lo: int32 = hexValue(text[i + 1])
        if hi < 0 || lo < 0:
            return Err[Bytes]("hex: invalid digit")
        BytesSet(out, i / 2, (hi << 4) | lo)
        i = i + 2
    return Ok[Bytes](out)

fn hx(text: str): Bytes =
    let r: Result[Bytes] = hexDecode(text)
    if IsErr(r):
        os.WriteLine(os.Get_stderr(), "driver hex constant invalid")
        assert(false, "driver hex constant")
    let v: Bytes = Value(r)
    return v

fn expectBytes(name: str, got: Bytes, want: Bytes) =
    checksTotal = checksTotal + 1
    if !BytesEqual(got, want):
        checksFailed = checksFailed + 1
        let gh: str = BytesToHex(got)
        let wh: str = BytesToHex(want)
        os.WriteLine(os.Get_stderr(), gh)
        os.WriteLine(os.Get_stderr(), wh)
        assert(false, name)
    os.WriteLine(os.Get_stdout(), "PASS")
    os.WriteLine(os.Get_stdout(), name)

fn expectTrue(name: str, cond: bool) =
    checksTotal = checksTotal + 1
    if !cond:
        checksFailed = checksFailed + 1
        os.WriteLine(os.Get_stderr(), "FAIL")
        os.WriteLine(os.Get_stderr(), name)
        assert(false, name)
    os.WriteLine(os.Get_stdout(), "PASS")
    os.WriteLine(os.Get_stdout(), name)

fn expectInt(name: str, got: int32, want: int32) =
    checksTotal = checksTotal + 1
    if got != want:
        checksFailed = checksFailed + 1
        let g: str = strings.Int64ToStr(got)
        let w: str = strings.Int64ToStr(want)
        os.WriteLine(os.Get_stderr(), g)
        os.WriteLine(os.Get_stderr(), w)
        assert(false, name)
    os.WriteLine(os.Get_stdout(), "PASS")
    os.WriteLine(os.Get_stdout(), name)

# ---------- RFC 8448 section 3 vectors ----------

const
    vClientPriv = "49af42ba7f7994852d713ef2784bcbcaa7911de26adc5642cb634540e7ea5005"
    vClientPub = "99381de560e4bd43d23d8e435a7dbafeb3c06e51c13cae4d5413691e529aaf2c"
    vClientRandom = "cb34ecb1e78163ba1c38c6dacb196a6dffa21a8d9912ec18a2ef6283024dece7"
    vServerPriv = "b1580eeadf6dd589b8ef4f2d5652578cc810e9980191ec8d058308cea216a21e"
    vServerPub = "c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f"
    vServerRandom = "a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155772ed3e26928"
    vClientHello = ""
    vServerHello = "020000560303a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155772ed3e2692800130100002e00330024001d0020c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f002b00020304"
    vEarlySecret = "33ad0a1c607ec03b09e6cd9893680ce210adf300aa1f2660e1b22e10f170f92a"
    vDerivedHs = "6f2615a108c702c5678f54fc9dbab69716c076189c48250cebeac3576c3611ba"
    vShared = "8bd4054fb55b9d63fdfbacf9f04b9f0d35e6d63f537563efd46272900f89492d"
    vHsSecret = "1dc826e93606aa6fdc0aadc12f741b01046aa6b99f691ed221a9f0ca043fbeac"
    vChsHash = "860c06edc07858ee8e78f0e7428c58edd6b43f2ca3e6e95f02ed063cf0e1cad8"
    vChsTraffic = "b3eddb126e067f35a780b3abf45e2d8f3b1a950738f52e9600746a0e27a55a21"
    vShsTraffic = "b67b7d690cc16c4e75e54213cb2d37b4e9c912bcded9105d42befd59d391ad38"
    vDerivedMaster = "43de77e0c77713859a944db9db2590b53190a65b3ee2e4f12dd7a0bb7ce254b4"
    vMasterSecret = "18df06843d13a08bf2a449844c5f8a478001bc4d4c627984d5a41da8d0402919"
    vSrvHsKey = "3fce516009c21727d0f2e4e86ee403bc"
    vSrvHsIv = "5d313eb2671276ee13000b30"
    vCliHsKey = "dbfaa693d1762c5b666af5d950258d01"
    vCliHsIv = "5bd3c71b836e0b76bb73265f"
    vEncryptedExtensions = "080000240022000a00140012001d00170018001901000101010201030104001c0002400100000000"
    vCertificate = ""
    vCertVerify = "0f000084080400805a747c5d88fa9bd2e55ab085a61015b7211f824cd484145ab3ff52f1fda8477b0b7abc90db78e2d33a5c141a078653fa6bef780c5ea248eeaaa785c4f394cab6d30bbe8d4859ee511f602957b15411ac027671459e46445c9ea58c181e818e95b8c3fb0bf3278409d3be152a3da5043e063dda65cdf5aea20d53dfacd42f74f3"
    vSrvFinKey = "008d3b66f816ea559f96b537e885c31fc068bf492c652f01f288a1d8cdc19fc8"
    vSrvFinishedData = "9b9b141d906337fbd2cbdce71df4deda4ab42c309572cb7fffee5454b78f0718"
    vServerFinishedMsg = "140000209b9b141d906337fbd2cbdce71df4deda4ab42c309572cb7fffee5454b78f0718"
    vApHash = "9608102a0f1ccc6db6250b7b7e417b1a000eaada3daae4777a7686c9ff83df13"
    vCapTraffic = "9e40646ce79a7f9dc05af8889bce6552875afa0b06df0087f792ebb7c17504a5"
    vSapTraffic = "a11af9f05531f856ad47116b45a950328204b4f44bfb6b3a4b4f1f3fcb631643"
    vExpMaster = "fe22f881176eda18eb8f44529e6792c50c9a3f89452f68d8ae311b4309d3cf50"
    vSrvApKey = "9f02283b6c9c07efc26bb9f2ac92e356"
    vSrvApIv = "cf782b88dd83549aadf1e984"
    vCliApKey = "17422dda596ed5d9acd890e3c63f5051"
    vCliApIv = "5b78923dee08579033e523d9"
    vCliFinKey = "b80ad01015fb2f0bd65ff7d4da5d6bf83f84821d1f87fdc7d3c75b5a7b42d9c4"
    vCliFinishedData = "a8ec436d677634ae525ac1fcebe11a039ec17694fac6e98527b642f2edd5ce61"
    vClientFinishedMsg = "14000020a8ec436d677634ae525ac1fcebe11a039ec17694fac6e98527b642f2edd5ce61"
    vResHash = "209145a96ee8e2a122ff810047cc952684658d6049e86429426db87c54ad143d"
    vResMaster = "7df235f2031d2a051287d02b0241b0bfdaf86cc856231f2d5aba46c434ec196c"
    vResumption = "4ecd0eb6ec3b4d87f5d6028f922ca4c5851a277fd41311c9e62d2c9492e1c4f3"

fn main(): int32 =
    let chBytes: Bytes = hx(vClientHello)
    let shBytes: Bytes = hx(vServerHello)
    let eeBytes: Bytes = hx(vEncryptedExtensions)
    let certBytes: Bytes = hx(vCertificate)
    let cvBytes: Bytes = hx(vCertVerify)
    let sfBytes: Bytes = hx(vServerFinishedMsg)
    let cfBytes: Bytes = hx(vClientFinishedMsg)

    # ===== A. ECDHE shared secret from the RFC x25519 keypairs =====
    let clientPriv: Bytes = hx(vClientPriv)
    let clientPub: Bytes = hx(vClientPub)
    let serverPriv: Bytes = hx(vServerPriv)
    let serverPub: Bytes = hx(vServerPub)
    let ssRes1: Result[Bytes] = x25519.curve25519SharedKey(clientPriv, serverPub)
    expectTrue("A1.ecdhe.client_side", IsOk(ssRes1))
    let ss1: Bytes = Value(ssRes1)
    let ssWant: Bytes = hx(vShared)
    expectBytes("A1.ecdhe.shared", ss1, ssWant)
    let ssRes2: Result[Bytes] = x25519.curve25519SharedKey(serverPriv, clientPub)
    expectTrue("A2.ecdhe.server_side", IsOk(ssRes2))
    let ss2: Bytes = Value(ssRes2)
    expectBytes("A2.ecdhe.shared", ss2, ssWant)
    let shared: Bytes = ss1

    # ===== T. transcript hash chain =====
    tr.tls13TranscriptBegin0()
    tr.tls13TranscriptAppend0(chBytes)
    tr.tls13TranscriptAppend0(shBytes)
    let t1: Bytes = tr.tls13TranscriptHash0()
    let t1Want: Bytes = hx(vChsHash)
    expectBytes("T1.hash(CH||SH)", t1, t1Want)
    tr.tls13TranscriptAppend0(eeBytes)
    tr.tls13TranscriptAppend0(certBytes)
    tr.tls13TranscriptAppend0(cvBytes)
    let thCv: Bytes = tr.tls13TranscriptHash0()
    tr.tls13TranscriptBegin1()
    tr.tls13TranscriptAppend1(chBytes)
    tr.tls13TranscriptAppend1(shBytes)
    tr.tls13TranscriptAppend1(eeBytes)
    tr.tls13TranscriptAppend1(certBytes)
    tr.tls13TranscriptAppend1(cvBytes)
    let t2: Bytes = tr.tls13TranscriptHash1()
    expectBytes("T2.hash(TH..CertificateVerify)", t2, thCv)
    tr.tls13TranscriptAppend0(sfBytes)
    let thSf: Bytes = tr.tls13TranscriptHash0()
    let t3Want: Bytes = hx(vApHash)
    expectBytes("T3.hash(TH..ServerFinished)", thSf, t3Want)
    tr.tls13TranscriptAppend0(cfBytes)
    let thCf: Bytes = tr.tls13TranscriptHash0()
    let t4Want: Bytes = hx(vResHash)
    expectBytes("T4.hash(TH..ClientFinished)", thCf, t4Want)
    tr.tls13TranscriptReset0()
    tr.tls13TranscriptAppend0(chBytes)
    tr.tls13TranscriptAppend0(shBytes)
    let t5: Bytes = tr.tls13TranscriptHash0()
    expectBytes("T5.hash(CH||SH) after reset", t5, t1Want)
    let t6Bytes: Bytes = tr.tls13TranscriptBytes1()
    let t6Len: int32 = BytesLen(t6Bytes)
    let t6Want: int32 = BytesLen(chBytes) + BytesLen(shBytes) + BytesLen(eeBytes) + BytesLen(certBytes) + BytesLen(cvBytes)
    expectInt("T6.slot1_window_len", t6Len, t6Want)

    # ===== B. key schedule chain =====
    let zero: Bytes = ks.tls13Zero32()
    let early: Bytes = ks.tls13EarlySecret(zero)
    let b1Want: Bytes = hx(vEarlySecret)
    expectBytes("B1.early_secret", early, b1Want)
    let b2: Bytes = ks.tls13DerivedSalt(early)
    let b2Want: Bytes = hx(vDerivedHs)
    expectBytes("B2.derived_hs", b2, b2Want)
    let hs: Bytes = ks.tls13HandshakeSecret(early, shared)
    let b3Want: Bytes = hx(vHsSecret)
    expectBytes("B3.handshake_secret", hs, b3Want)
    let chsHash: Bytes = hx(vChsHash)
    let chsRes: Result[Bytes] = ks.tls13DeriveSecretHash(hs, "c hs traffic", chsHash)
    expectTrue("B4.c_hs_traffic.ok", IsOk(chsRes))
    let chs: Bytes = Value(chsRes)
    let b4Want: Bytes = hx(vChsTraffic)
    expectBytes("B4.c_hs_traffic", chs, b4Want)
    let shsRes: Result[Bytes] = ks.tls13DeriveSecretHash(hs, "s hs traffic", chsHash)
    expectTrue("B5.s_hs_traffic.ok", IsOk(shsRes))
    let shs: Bytes = Value(shsRes)
    let b5Want: Bytes = hx(vShsTraffic)
    expectBytes("B5.s_hs_traffic", shs, b5Want)
    let b6: Bytes = ks.tls13DerivedSalt(hs)
    let b6Want: Bytes = hx(vDerivedMaster)
    expectBytes("B6.derived_master", b6, b6Want)
    let master: Bytes = ks.tls13MasterSecret(hs)
    let b7Want: Bytes = hx(vMasterSecret)
    expectBytes("B7.master_secret", master, b7Want)
    let shsKeysRes: Result[ks.Tls13TrafficKeys] = ks.tls13TrafficKeysFor(shs)
    expectTrue("B8.srv_hs_keys.ok", IsOk(shsKeysRes))
    let shsKeys: ks.Tls13TrafficKeys = Value(shsKeysRes)
    let b8Key: Bytes = ks.tls13TrafficKeyOf(shsKeys)
    let b8KeyWant: Bytes = hx(vSrvHsKey)
    expectBytes("B8.srv_hs_key", b8Key, b8KeyWant)
    let b8Iv: Bytes = ks.tls13TrafficIvOf(shsKeys)
    let b8IvWant: Bytes = hx(vSrvHsIv)
    expectBytes("B8.srv_hs_iv", b8Iv, b8IvWant)
    let chsKeysRes: Result[ks.Tls13TrafficKeys] = ks.tls13TrafficKeysFor(chs)
    expectTrue("B9.cli_hs_keys.ok", IsOk(chsKeysRes))
    let chsKeys: ks.Tls13TrafficKeys = Value(chsKeysRes)
    let b9Key: Bytes = ks.tls13TrafficKeyOf(chsKeys)
    let b9KeyWant: Bytes = hx(vCliHsKey)
    expectBytes("B9.cli_hs_key", b9Key, b9KeyWant)
    let b9Iv: Bytes = ks.tls13TrafficIvOf(chsKeys)
    let b9IvWant: Bytes = hx(vCliHsIv)
    expectBytes("B9.cli_hs_iv", b9Iv, b9IvWant)
    let srvFinKeyRes: Result[Bytes] = ks.tls13FinishedKey(shs)
    expectTrue("B10.srv_finished_key.ok", IsOk(srvFinKeyRes))
    let srvFinKey: Bytes = Value(srvFinKeyRes)
    let b10Want: Bytes = hx(vSrvFinKey)
    expectBytes("B10.srv_finished_key", srvFinKey, b10Want)
    let b11: Bytes = ks.tls13FinishedVerifyData(srvFinKey, thCv)
    let b11Want: Bytes = hx(vSrvFinishedData)
    expectBytes("B11.srv_finished_verify_data", b11, b11Want)
    let capRes: Result[Bytes] = ks.tls13DeriveSecretHash(master, "c ap traffic", thSf)
    expectTrue("B12.c_ap_traffic.ok", IsOk(capRes))
    let cap: Bytes = Value(capRes)
    let b12Want: Bytes = hx(vCapTraffic)
    expectBytes("B12.c_ap_traffic", cap, b12Want)
    let sapRes: Result[Bytes] = ks.tls13DeriveSecretHash(master, "s ap traffic", thSf)
    expectTrue("B13.s_ap_traffic.ok", IsOk(sapRes))
    let sap: Bytes = Value(sapRes)
    let b13Want: Bytes = hx(vSapTraffic)
    expectBytes("B13.s_ap_traffic", sap, b13Want)
    let expRes: Result[Bytes] = ks.tls13DeriveSecretHash(master, "exp master", thSf)
    expectTrue("B14.exp_master.ok", IsOk(expRes))
    let b14: Bytes = Value(expRes)
    let b14Want: Bytes = hx(vExpMaster)
    expectBytes("B14.exp_master", b14, b14Want)
    let sapKeysRes: Result[ks.Tls13TrafficKeys] = ks.tls13TrafficKeysFor(sap)
    expectTrue("B15.srv_ap_keys.ok", IsOk(sapKeysRes))
    let sapKeys: ks.Tls13TrafficKeys = Value(sapKeysRes)
    let b15Key: Bytes = ks.tls13TrafficKeyOf(sapKeys)
    let b15KeyWant: Bytes = hx(vSrvApKey)
    expectBytes("B15.srv_ap_key", b15Key, b15KeyWant)
    let b15Iv: Bytes = ks.tls13TrafficIvOf(sapKeys)
    let b15IvWant: Bytes = hx(vSrvApIv)
    expectBytes("B15.srv_ap_iv", b15Iv, b15IvWant)
    let capKeysRes: Result[ks.Tls13TrafficKeys] = ks.tls13TrafficKeysFor(cap)
    expectTrue("B16.cli_ap_keys.ok", IsOk(capKeysRes))
    let capKeys: ks.Tls13TrafficKeys = Value(capKeysRes)
    let b16Key: Bytes = ks.tls13TrafficKeyOf(capKeys)
    let b16KeyWant: Bytes = hx(vCliApKey)
    expectBytes("B16.cli_ap_key", b16Key, b16KeyWant)
    let b16Iv: Bytes = ks.tls13TrafficIvOf(capKeys)
    let b16IvWant: Bytes = hx(vCliApIv)
    expectBytes("B16.cli_ap_iv", b16Iv, b16IvWant)
    let cliFinKeyRes: Result[Bytes] = ks.tls13FinishedKey(chs)
    expectTrue("B17.cli_finished_key.ok", IsOk(cliFinKeyRes))
    let cliFinKey: Bytes = Value(cliFinKeyRes)
    let b17Want: Bytes = hx(vCliFinKey)
    expectBytes("B17.cli_finished_key", cliFinKey, b17Want)
    let b18: Bytes = ks.tls13FinishedVerifyData(cliFinKey, thSf)
    let b18Want: Bytes = hx(vCliFinishedData)
    expectBytes("B18.cli_finished_verify_data", b18, b18Want)
    let resMasterRes: Result[Bytes] = ks.tls13DeriveSecretHash(master, "res master", thCf)
    expectTrue("B19.res_master.ok", IsOk(resMasterRes))
    let resMaster: Bytes = Value(resMasterRes)
    let b19Want: Bytes = hx(vResMaster)
    expectBytes("B19.res_master", resMaster, b19Want)
    let nonce: Bytes = hx("0000")
    let resumptionRes: Result[Bytes] = ks.tls13ResumptionSecret(resMaster, nonce)
    expectTrue("B20.resumption.ok", IsOk(resumptionRes))
    let resumption: Bytes = Value(resumptionRes)
    let b20Want: Bytes = hx(vResumption)
    expectBytes("B20.resumption", resumption, b20Want)

    os.WriteLine(os.Get_stdout(), "PART1 done")
    return finishCodecChecks(chBytes, shBytes, eeBytes, certBytes, cvBytes, sfBytes, cfBytes, clientPub, serverPub, thCv, thSf, thCf, chs)


fn buildCvContent(transcriptHash: Bytes): Bytes =
    let cvText: str = "TLS 1.3, server CertificateVerify"
    var ctxB: bytebuffer.GrowByteBuffer = bytebuffer.NewByteBuffer()
    var ci: int32
    while ci < len(cvText):
        bytebuffer.AppendByte(ctxB, int32(cvText[ci]))
        ci = ci + 1
    bytebuffer.AppendByte(ctxB, 0)
    var pi: int32
    while pi < 64:
        bytebuffer.AppendByte(ctxB, 32)
        pi = pi + 1
    let cvPrefix: Bytes = bytebuffer.ToBytes(ctxB)
    let cvPrefixOwned: Bytes = msg.tls13OwnedBytes(cvPrefix)
    return BytesConcat(cvPrefixOwned, transcriptHash)

fn finishCodecChecks(chBytes: Bytes, shBytes: Bytes, eeBytes: Bytes, certBytes: Bytes, cvBytes: Bytes, sfBytes: Bytes, cfBytes: Bytes, clientPub: Bytes, serverPub: Bytes, thCv: Bytes, thSf: Bytes, thCf: Bytes, chs: Bytes): int32 =
    # ===== C. codec decode of the RFC handshake messages =====
    let chDec: Result[bool] = msg.tls13DecodeClientHello(chBytes)
    expectTrue("C1.decode_client_hello", IsOk(chDec))
    expectInt("C1.ch.legacy_version", msg.tls13ChLegacyVersionOf(), 771)
    let c1Random: Bytes = msg.tls13ChRandomOf()
    let c1RandomWant: Bytes = hx(vClientRandom)
    expectBytes("C1.ch.random", c1Random, c1RandomWant)
    expectInt("C1.ch.session_id_len", msg.tls13ChSessionIdLenOf(), 0)
    expectInt("C1.ch.cipher_count", msg.tls13ChCipherCountOf(), 3)
    expectInt("C1.ch.cipher0_aes128gcm", msg.tls13ChCipherAtOf(0), 4865)
    let c1Sni: str = msg.tls13ChServerNameOf()
    expectTrue("C1.ch.sni", c1Sni == "server")
    expectInt("C1.ch.group_count", msg.tls13ChGroupCountOf(), 9)
    expectInt("C1.ch.group0_x25519", msg.tls13ChGroupAtOf(0), 29)
    expectInt("C1.ch.sigalg_count", msg.tls13ChSigalgCountOf(), 15)
    expectInt("C1.ch.key_share_group", msg.tls13ChKeyShareGroupOf(), 29)
    let c1KeyShare: Bytes = msg.tls13ChKeyShareOf()
    expectBytes("C1.ch.key_share", c1KeyShare, clientPub)
    expectInt("C1.ch.selected_version", msg.tls13ChSelectedVersionOf(), 772)

    let shDec: Result[bool] = msg.tls13DecodeServerHello(shBytes)
    expectTrue("C2.decode_server_hello", IsOk(shDec))
    let c2Random: Bytes = msg.tls13ShRandomOf()
    let c2RandomWant: Bytes = hx(vServerRandom)
    expectBytes("C2.sh.random", c2Random, c2RandomWant)
    expectInt("C2.sh.cipher", msg.tls13ShCipherOf(), 4865)
    expectInt("C2.sh.selected_version", msg.tls13ShSelectedVersionOf(), 772)
    expectInt("C2.sh.key_share_group", msg.tls13ShKeyShareGroupOf(), 29)
    let c2KeyShare: Bytes = msg.tls13ShKeyShareOf()
    expectBytes("C2.sh.key_share", c2KeyShare, serverPub)

    let eeDec: Result[bool] = msg.tls13DecodeEncryptedExtensions(eeBytes)
    expectTrue("C3.decode_ee", IsOk(eeDec))
    expectInt("C3.ee.group_count", msg.tls13EeGroupCountOf(), 9)
    expectInt("C3.ee.group0_x25519", msg.tls13EeGroupAtOf(0), 29)

    let certDec: Result[bool] = msg.tls13DecodeCertificate(certBytes)
    expectTrue("C4.decode_certificate", IsOk(certDec))
    expectInt("C4.cert.entry_count", msg.tls13CertCountOf(), 1)
    let c4Der: Bytes = msg.tls13CertDerOf(0)
    expectInt("C4.cert.der_len", BytesLen(c4Der), 432)
    let c4Want: Bytes = BytesSlice(certBytes, 11, 432)
    expectBytes("C4.cert.der", c4Der, c4Want)

    let cvDec: Result[bool] = msg.tls13DecodeCertificateVerify(cvBytes)
    expectTrue("C5.decode_cert_verify", IsOk(cvDec))
    expectInt("C5.cv.scheme", msg.tls13CvSchemeOf(), 0x0804)
    let c5Sig: Bytes = msg.tls13CvSignatureOf()
    expectInt("C5.cv.sig_len", BytesLen(c5Sig), 128)
    let c5Want: Bytes = BytesSlice(cvBytes, 8, 128)
    expectBytes("C5.cv.signature", c5Sig, c5Want)

    let sfDec: Result[bool] = msg.tls13DecodeFinished(sfBytes)
    expectTrue("C6.decode_server_finished", IsOk(sfDec))
    let c6Vd: Bytes = msg.tls13FinVerifyDataOf()
    let c6Want: Bytes = hx(vSrvFinishedData)
    expectBytes("C6.sf.verify_data", c6Vd, c6Want)
    let cfDec: Result[bool] = msg.tls13DecodeFinished(cfBytes)
    expectTrue("C7.decode_client_finished", IsOk(cfDec))
    let c7Vd: Bytes = msg.tls13FinVerifyDataOf()
    let c7Want: Bytes = hx(vCliFinishedData)
    expectBytes("C7.cf.verify_data", c7Vd, c7Want)

    # ===== D. self-constructed encode->decode->encode byte identity =====
    let rtRandom1: Bytes = hx("0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20")
    let rtRandom2: Bytes = hx("2122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f40")
    let rtRandom3: Bytes = hx("4142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f60")
    let rtRandom4: Bytes = hx("0101010101010101010101010101010101010101010101010101010101010101")
    let rtRandom5: Bytes = hx("0202020202020202020202020202020202020202020202020202020202020202")
    let rtRandom6: Bytes = hx("0303030303030303030303030303030303030303030303030303030303030303")
    let rtRandom7: Bytes = hx("0404040404040404040404040404040404040404040404040404040404040404")
    let rtSid1: Bytes = hx("aa")
    let rtSid2: Bytes = hx("0102")
    let rtSid3: Bytes = hx("bb")
    let rtSid32: Bytes = hx("0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20")
    let rtEmpty: Bytes = EmptyBytes()

    # ed25519 wiring: sign and verify a real CertificateVerify content
    # (context string per RFC 8446 section 4.4.3 + transcript hash CH||SH).
    # Keypair: RFC 8032 test vector 1 (private key = seed||pub).
    let hashInput: Bytes = hx(vChsHash)
    let cvContent: Bytes = buildCvContent(hashInput)

    # ed25519 wiring: sign and verify a real CertificateVerify content
    # (context string per RFC 8446 section 4.4.3 + transcript hash CH||SH).
    # Keypair: RFC 8032 test vector 1 (private key = seed||pub).
    let hashInput: Bytes = hx(vChsHash)
    let cvContent: Bytes = buildCvContent(hashInput)
    let edSeed: Bytes = hx("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
    let edPub: Bytes = hx("d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a")
    let edPriv: Bytes = BytesConcat(edSeed, edPub)
    let cvSigRes: Result[Bytes] = edsig.signEd25519RawEpoch(edPriv, cvContent, 1)
    expectTrue("D23.ed25519.sign", IsOk(cvSigRes))
    let cvSig: Bytes = Value(cvSigRes)
    expectInt("D23.ed25519.sig_len", BytesLen(cvSig), 64)
    expectTrue("D23.ed25519.verify", edsig.verifyEd25519Epoch(edPub, cvContent, cvSig, 1))
    let cvTampered: Bytes = BytesConcat(cvContent, hashInput)
    expectTrue("D23.ed25519.verify_tampered", !edsig.verifyEd25519Epoch(edPub, cvTampered, cvSig, 1))
    # official RFC 8032 TEST1 signature over the empty message
    let emptyMsg: Bytes = EmptyBytes()
    let officialSig: Bytes = hx("e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b")
    expectTrue("D24.ed25519.official_vector", edsig.verifyEd25519Epoch(edPub, emptyMsg, officialSig, 1))

    # ===== E. negatives =====
    # E1: handshake header claims more bytes than present
    let badLen: Bytes = BytesAlloc(BytesLen(sfBytes))
    BytesCopyInto(badLen, 0, sfBytes)
    BytesSet(badLen, 2, 0xff)
    expectTrue("E1.header_len_mismatch", IsErr(msg.tls13DecodeFinished(badLen)))
    # E2: truncated ClientHello (cut mid-extension)
    let trunc: Bytes = BytesSlice(chBytes, 0, BytesLen(chBytes) - 10)
    expectTrue("E2.ch_truncated", IsErr(msg.tls13DecodeClientHello(trunc)))
    # E3: ServerHello fed to the ClientHello decoder
    expectTrue("E3.kind_mismatch", IsErr(msg.tls13DecodeClientHello(shBytes)))
    # E4: Finished with empty verify_data
    let emptyFin: Bytes = hx("14000000")
    expectTrue("E4.finished_empty", IsErr(msg.tls13DecodeFinished(emptyFin)))
    # E5: tampered Finished verify_data must not match the expected value
    let tampered: Bytes = BytesAlloc(BytesLen(sfBytes))
    BytesCopyInto(tampered, 0, sfBytes)
    var tb: int32 = BytesGet(sfBytes, 4) + 1
    tb = tb - (tb / 256) * 256
    BytesSet(tampered, 4, tb)
    let tamperedDec: Result[bool] = msg.tls13DecodeFinished(tampered)
    expectTrue("E5.tampered_decodes", IsOk(tamperedDec))
    let tamperedVd: Bytes = msg.tls13FinVerifyDataOf()
    let e5Want: Bytes = hx(vSrvFinishedData)
    expectTrue("E5.tampered_verify_data_rejected", !BytesEqual(tamperedVd, e5Want))
    # E6: certificate_list length overruns the message
    let badCert: Bytes = BytesAlloc(BytesLen(certBytes))
    BytesCopyInto(badCert, 0, certBytes)
    BytesSet(badCert, 6, 0xff)
    expectTrue("E6.cert_list_overrun", IsErr(msg.tls13DecodeCertificate(badCert)))
    # E7: odd cipher_suites length (CH layout: bytes 39-40 = suites length)
    let oddSuites: Bytes = BytesAlloc(BytesLen(chBytes) + 1)
    BytesCopyInto(oddSuites, 0, chBytes)
    BytesSet(oddSuites, 39, 0x00)
    BytesSet(oddSuites, 40, 0x05)
    expectTrue("E7.odd_cipher_len", IsErr(msg.tls13DecodeClientHello(oddSuites)))

    os.WriteLine(os.Get_stdout(), "RESULT all sections done")
    if checksFailed != 0:
        return 1
    return 0
