import std/os
import std/strutils as strutil
import cheng/core/tooling/host_smoke_gate as gate
import cheng/core/tooling/path as chengpath

@borrows
fn writeReport(path: str,
               text: str) =
    os.WriteFile(path, text)

@borrows
fn defaultSmokeContains(smokes: str[], name: str): bool =
    for i in 0..<smokes.len:
        if smokes[i] == name:
            return true
    return false

fn main(): int32 =
    let root = os.GetCurrentDir()
    let outDir = chengpath.PathAbsolute(root, "artifacts/host_smoke_gate_contract")
    assert(chengpath.MkdirP(root, outDir), " host smoke gate contract: mkdir")

    let defaultSmokes = gate.HostSmokeDefaultSmokes()
    assert(defaultSmokeContains(defaultSmokes, "csg_web_media_facts_smoke"),
           " host smoke gate contract: default includes csg web media facts")
    assert(defaultSmokeContains(defaultSmokes, "csg_oracle_asset_unimaker_vexa_smoke"),
           " host smoke gate contract: default includes csg oracle asset unimaker vexa")
    assert(defaultSmokeContains(defaultSmokes, "vexa_hyperliquid_oracle_csgc_smoke"),
           " host smoke gate contract: default includes vexa hyperliquid oracle csgc")
    assert(defaultSmokeContains(defaultSmokes, "unimaker_vexa_csgc_entry_smoke"),
           " host smoke gate contract: default includes unimaker vexa csgc entry")
    assert(defaultSmokeContains(defaultSmokes, "unimaker_vexa_runtime_bridge_smoke"),
           " host smoke gate contract: default includes unimaker vexa runtime bridge")
    assert(defaultSmokeContains(defaultSmokes, "unimaker_mobile_publish_broadcast_contract_smoke"),
           " host smoke gate contract: default includes unimaker mobile publish broadcast")
    assert(defaultSmokeContains(defaultSmokes, "native_link_exec_command_smoke"),
           " host smoke gate contract: default includes native link exec command")
    assert(defaultSmokeContains(defaultSmokes, "primary_pure_cast_return_smoke"),
           " host smoke gate contract: default includes primary pure cast return")
    assert(defaultSmokeContains(defaultSmokes, "media_asset_manifest_smoke"),
           " host smoke gate contract: default includes media asset manifest")
    assert(defaultSmokeContains(defaultSmokes, "moq_fountain_strict_fec_smoke"),
           " host smoke gate contract: default includes moq fec")
    assert(defaultSmokeContains(defaultSmokes, "libp2p_moq_segment_stream_smoke"),
           " host smoke gate contract: default includes libp2p moq segment stream")
    assert(defaultSmokeContains(defaultSmokes, "web_scene_runtime_smoke"),
           " host smoke gate contract: default includes web scene runtime")
    assert(defaultSmokeContains(defaultSmokes, "mobile_shell_codegen_smoke"),
           " host smoke gate contract: default includes mobile shell codegen")
    assert(defaultSmokeContains(defaultSmokes, "mobile_shell_android_codegen_pure_smoke"),
           " host smoke gate contract: default includes android pure codegen")
    assert(defaultSmokeContains(defaultSmokes, "gui_drawlist_render_smoke"),
           " host smoke gate contract: default includes gui drawlist")
    assert(defaultSmokeContains(defaultSmokes, "media_system_runtime_smoke"),
           " host smoke gate contract: default includes media system runtime")
    assert(defaultSmokeContains(defaultSmokes, "media_video_e2e_native_player_smoke"),
           " host smoke gate contract: default includes native media player e2e")
    assert(defaultSmokeContains(defaultSmokes, "media_darwin_platform_provider_smoke"),
           " host smoke gate contract: default includes darwin media provider")
    assert(defaultSmokeContains(defaultSmokes, "hf_model_graph_smoke"),
           " host smoke gate contract: default includes hf model graph")
    assert(defaultSmokeContains(defaultSmokes, "weight_safetensors_manifest_smoke"),
           " host smoke gate contract: default includes weight safetensors manifest")

    let goodReport = chengpath.PathJoin(outDir, "good.report.txt")
    writeReport(goodReport, strutil.Join([
        "system_link_exec_runtime_execute=1",
        "provider_object_count=2",
        "object_link_input_count=3"
    ], "\n"))
    assert(gate.HostSmokeCompileReportOk(root,
                                         "thread_atomic_orc_runtime_gate_smoke",
                                         goodReport),
           " host smoke gate contract: good runtime report")

    let missingMarkerReport = chengpath.PathJoin(outDir, "missing_marker.report.txt")
    writeReport(missingMarkerReport, strutil.Join([
        "provider_object_count=2",
        "object_link_input_count=3"
    ], "\n"))
    assert(!gate.HostSmokeCompileReportOk(root,
                                          "thread_atomic_orc_runtime_gate_smoke",
                                          missingMarkerReport),
           " host smoke gate contract: reject missing runtime marker")

    let standaloneReport = chengpath.PathJoin(outDir, "standalone.report.txt")
    writeReport(standaloneReport, strutil.Join([
        "system_link_exec_runtime_execute=1",
        "system_link_exec_runtime_standalone_no_runtime=1",
        "provider_object_count=2"
    ], "\n"))
    assert(!gate.HostSmokeCompileReportOk(root,
                                          "thread_atomic_orc_runtime_gate_smoke",
                                          standaloneReport),
           " host smoke gate contract: reject standalone no-runtime")

    let missingProviderReport = chengpath.PathJoin(outDir, "missing_provider.report.txt")
    writeReport(missingProviderReport, strutil.Join([
        "system_link_exec_runtime_execute=1",
        "object_link_input_count=1"
    ], "\n"))
    assert(!gate.HostSmokeCompileReportOk(root,
                                          "thread_atomic_orc_runtime_gate_smoke",
                                          missingProviderReport),
           " host smoke gate contract: reject missing provider count")

    let zeroProviderReport = chengpath.PathJoin(outDir, "zero_provider.report.txt")
    writeReport(zeroProviderReport, strutil.Join([
        "system_link_exec_runtime_execute=1",
        "provider_object_count=0"
    ], "\n"))
    assert(!gate.HostSmokeCompileReportOk(root,
                                          "thread_atomic_orc_runtime_gate_smoke",
                                          zeroProviderReport),
           " host smoke gate contract: reject zero provider count")

    assert(gate.HostSmokeCompileReportOk(root,
                                         "function_task_contract_smoke",
                                         zeroProviderReport),
           " host smoke gate contract: non-runtime report skipped")
    assert(gate.HostSmokeRunMarkerOk("thread_atomic_orc_runtime_gate_smoke",
                                     " thread_atomic_orc_runtime_gate_smoke ok"),
           " host smoke gate contract: runtime marker accepted")
    assert(!gate.HostSmokeRunMarkerOk("thread_atomic_orc_runtime_gate_smoke", ""),
           " host smoke gate contract: runtime marker required")
    assert(!gate.HostSmokeRunMarkerOk("function_task_contract_smoke", ""),
           " host smoke gate contract: function task marker required")
    assert(gate.HostSmokeRunMarkerOk("compiler_csg_egraph_active_contract_smoke",
                                     " compiler_csg_egraph_active_contract_smoke ok"),
           " host smoke gate contract: compiler csg egraph marker accepted")
    assert(!gate.HostSmokeRunMarkerOk("compiler_csg_egraph_active_contract_smoke", ""),
           " host smoke gate contract: compiler csg egraph marker required")
    assert(gate.HostSmokeRunMarkerOk("csg_web_media_facts_smoke",
                                     " csg_web_media_facts_smoke ok"),
           " host smoke gate contract: csg web media facts marker accepted")
    assert(!gate.HostSmokeRunMarkerOk("csg_web_media_facts_smoke", ""),
           " host smoke gate contract: csg web media facts marker required")
    assert(gate.HostSmokeRunMarkerOk("csg_oracle_asset_unimaker_vexa_smoke",
                                     "csg_oracle_asset_unimaker_vexa_smoke ok"),
           " host smoke gate contract: csg oracle asset marker accepted")
    assert(!gate.HostSmokeRunMarkerOk("csg_oracle_asset_unimaker_vexa_smoke", ""),
           " host smoke gate contract: csg oracle asset marker required")
    assert(gate.HostSmokeRunMarkerOk("vexa_hyperliquid_oracle_csgc_smoke",
                                     "vexa_hyperliquid_oracle_csgc_smoke ok"),
           " host smoke gate contract: vexa hyperliquid marker accepted")
    assert(!gate.HostSmokeRunMarkerOk("vexa_hyperliquid_oracle_csgc_smoke", ""),
           " host smoke gate contract: vexa hyperliquid marker required")
    assert(gate.HostSmokeRunMarkerOk("unimaker_vexa_csgc_entry_smoke",
                                     "unimaker_vexa_csgc_entry_smoke ok"),
           " host smoke gate contract: unimaker vexa csgc entry marker accepted")
    assert(!gate.HostSmokeRunMarkerOk("unimaker_vexa_csgc_entry_smoke", ""),
           " host smoke gate contract: unimaker vexa csgc entry marker required")
    assert(gate.HostSmokeRunMarkerOk("unimaker_vexa_runtime_bridge_smoke",
                                     "unimaker_vexa_runtime_bridge_smoke ok"),
           " host smoke gate contract: unimaker vexa runtime bridge marker accepted")
    assert(!gate.HostSmokeRunMarkerOk("unimaker_vexa_runtime_bridge_smoke", ""),
           " host smoke gate contract: unimaker vexa runtime bridge marker required")
    assert(gate.HostSmokeRunMarkerOk("unimaker_mobile_publish_broadcast_contract_smoke",
                                     " unimaker_mobile_publish_broadcast_contract_smoke ok"),
           " host smoke gate contract: unimaker mobile publish broadcast marker accepted")
    assert(!gate.HostSmokeRunMarkerOk("unimaker_mobile_publish_broadcast_contract_smoke", ""),
           " host smoke gate contract: unimaker mobile publish broadcast marker required")
    assert(gate.HostSmokeRunMarkerOk("native_link_exec_command_smoke",
                                     " native_link_exec_command_smoke ok"),
           " host smoke gate contract: native link exec command marker accepted")
    assert(!gate.HostSmokeRunMarkerOk("native_link_exec_command_smoke", ""),
           " host smoke gate contract: native link exec command marker required")
    assert(gate.HostSmokeRunMarkerOk("primary_pure_cast_return_smoke",
                                     " primary_pure_cast_return_smoke ok"),
           " host smoke gate contract: primary pure cast marker accepted")
    assert(!gate.HostSmokeRunMarkerOk("primary_pure_cast_return_smoke", ""),
           " host smoke gate contract: primary pure cast marker required")
    assert(gate.HostSmokeRunMarkerOk("media_asset_manifest_smoke",
                                     " media_asset_manifest_smoke ok"),
           " host smoke gate contract: media asset manifest marker accepted")
    assert(!gate.HostSmokeRunMarkerOk("media_asset_manifest_smoke", ""),
           " host smoke gate contract: media asset manifest marker required")
    assert(gate.HostSmokeRunMarkerOk("moq_fountain_strict_fec_smoke",
                                     " moq_fountain_strict_fec_smoke ok"),
           " host smoke gate contract: moq fountain fec marker accepted")
    assert(!gate.HostSmokeRunMarkerOk("moq_fountain_strict_fec_smoke", ""),
           " host smoke gate contract: moq fountain fec marker required")
    assert(gate.HostSmokeRunMarkerOk("libp2p_moq_segment_stream_smoke",
                                     " libp2p_moq_segment_stream_smoke ok"),
           " host smoke gate contract: libp2p moq segment marker accepted")
    assert(!gate.HostSmokeRunMarkerOk("libp2p_moq_segment_stream_smoke", ""),
           " host smoke gate contract: libp2p moq segment marker required")
    assert(gate.HostSmokeRunMarkerOk("web_scene_runtime_smoke",
                                     "web_scene_runtime_smoke ok"),
           " host smoke gate contract: web scene runtime marker accepted")
    assert(!gate.HostSmokeRunMarkerOk("web_scene_runtime_smoke", ""),
           " host smoke gate contract: web scene runtime marker required")
    assert(gate.HostSmokeRunMarkerOk("mobile_shell_codegen_smoke",
                                     " mobile_shell_codegen_smoke ok"),
           " host smoke gate contract: mobile shell marker accepted")
    assert(!gate.HostSmokeRunMarkerOk("mobile_shell_codegen_smoke", ""),
           " host smoke gate contract: mobile shell marker required")
    assert(gate.HostSmokeRunMarkerOk("mobile_shell_android_codegen_pure_smoke",
                                     " mobile_shell_android_codegen_pure_smoke ok"),
           " host smoke gate contract: android pure marker accepted")
    assert(!gate.HostSmokeRunMarkerOk("mobile_shell_android_codegen_pure_smoke", ""),
           " host smoke gate contract: android pure marker required")
    assert(gate.HostSmokeRunMarkerOk("gui_drawlist_render_smoke",
                                     "gui_drawlist_render_smoke ok"),
           " host smoke gate contract: gui drawlist marker accepted")
    assert(!gate.HostSmokeRunMarkerOk("gui_drawlist_render_smoke", ""),
           " host smoke gate contract: gui drawlist marker required")
    assert(gate.HostSmokeRunMarkerOk("weight_safetensors_manifest_smoke",
                                     " weight_safetensors_manifest_smoke ok"),
           " host smoke gate contract: weight safetensors marker accepted")
    assert(gate.HostSmokeRunMarkerOk("hf_model_graph_smoke",
                                     " hf_model_graph_smoke ok"),
           " host smoke gate contract: hf model graph marker accepted")
    assert(!gate.HostSmokeRunMarkerOk("weight_safetensors_manifest_smoke", ""),
           " host smoke gate contract: weight safetensors marker required")

    echo(" host_smoke_gate_contract_smoke ok")
    return 0
