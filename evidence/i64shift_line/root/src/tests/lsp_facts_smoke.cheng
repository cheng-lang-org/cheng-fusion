# LSP wire-structure smoke. Semantic facts live only in the published
# semantic snapshot and are tested by lsp_semantic_snapshot_gate.sh.

import std/os
import cheng/core/tooling/lsp_protocol as lsp

fn TestPositionRangeAndLocation() =
    let position = lsp.LspMakePosition(3, 7)
    assert(position.line == 3 && position.character == 7,
           "lsp protocol: position drift")
    let range = lsp.LspMakeRange(1, 2, 4, 9)
    assert(range.start.line == 1 && range.start.character == 2 &&
           range.end.line == 4 && range.end.character == 9,
           "lsp protocol: range drift")
    let location = lsp.LspMakeLocation("file:///src/main.cheng", range)
    assert(location.uri == "file:///src/main.cheng" &&
           location.range.end.character == 9,
           "lsp protocol: location drift")

fn TestDiagnosticAndCompletion() =
    let range = lsp.LspMakeRange(0, 0, 0, 4)
    let diagnostic = lsp.LspMakeDiagnostic(
        range, lsp.DsError, "type_mismatch", "cheng", "bad type")
    assert(diagnostic.code == "type_mismatch" &&
           int32(diagnostic.severity) == 1 &&
           diagnostic.source == "cheng",
           "lsp protocol: diagnostic drift")
    let item = lsp.LspMakeCompletionItem(
        "Main", lsp.CikFunction, "fn Main(): int32", "", "", "", "Main")
    assert(item.label == "Main" && int32(item.kind) == 3 &&
           item.insertText == "Main",
           "lsp protocol: completion drift")

fn TestSymbolsAndSignature() =
    let range = lsp.LspMakeRange(2, 0, 4, 1)
    let symbol = lsp.LspMakeDocumentSymbol(
        "Main", lsp.SkFunction, range, range, [])
    assert(symbol.name == "Main" && int32(symbol.kind) == 12 &&
           symbol.children.len == 0,
           "lsp protocol: document symbol drift")
    let information = lsp.LspMakeSymbolInformation(
        "Main", lsp.SkFunction,
        lsp.LspMakeLocation("file:///src/main.cheng", range))
    assert(information.location.uri == "file:///src/main.cheng",
           "lsp protocol: symbol information drift")
    let parameter = lsp.LspMakeParameterInformation("value: int32", "")
    let signature = lsp.LspMakeSignatureInformation(
        "Main(value: int32): int32", "", [parameter])
    let help = lsp.LspMakeSignatureHelp([signature], 0, 0)
    assert(help.signatures.len == 1 &&
           help.signatures[0].parameters.len == 1,
           "lsp protocol: signature help drift")

fn main() =
    TestPositionRangeAndLocation()
    TestDiagnosticAndCompletion()
    TestSymbolsAndSignature()
    os.WriteLine(os.Get_stdout(), "lsp_facts_smoke: ok")
