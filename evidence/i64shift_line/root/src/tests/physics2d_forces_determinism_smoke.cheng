# physics2d force primitives determinism smoke.
# Fixed-point expectations precomputed exactly (int32 math, dtMs = 16):
#   gravity 1000 units/s^2 -> deltaVy = 16 per tick; projectile y after
#   n ticks = sum(floor(16*k*16/1000)): n=10 -> 10, n=60 -> 440,
#   n=120 -> 1799, n=240 -> 7285 (vy = 3840).
#   drag 9/10 from vx=1000: vx==1 after tick 49, vx==0 first at tick 50.
#   ink alpha 65536 decaying 31/32 reaches exactly 0 after 259 steps.
# Receipt integrity: per-tick receipt CIDs (SHA-256 over canonical
# preimages) replay identically; tampered receipts are rejected and a
# tampered forces receipt hard-fails Physics2dReceiptBindForces (panic,
# verified via re-exec child).
import std/cmdline
import std/os
import std/strutils as strutil
import std/os_host_process as hostos
import cheng/game/ecs
import cheng/game/physics2d

# 现行契约: 托管结构体赋值=move(消费源), 借用源显式共享走 Fmt 拷贝。
# 篡改用例需对同一已提交回执做多份独立副本, 故用借用版字段克隆。
@borrows
fn cloneForcesReceipt(src: physics2d.Physics2dForcesReceipt): physics2d.Physics2dForcesReceipt =
    var out: physics2d.Physics2dForcesReceipt
    out.schema = Fmt"{src.schema}"
    out.tick = src.tick
    out.dtMs = src.dtMs
    out.gravityApplied = src.gravityApplied
    out.dragApplied = src.dragApplied
    out.splashCount = src.splashCount
    out.statusCode = src.statusCode
    out.worldCid = Fmt"{src.worldCid}"
    out.receiptCid = Fmt"{src.receiptCid}"
    out.trace = Fmt"{src.trace}"
    return out

fn forcesConfig(): physics2d.Physics2dForcesConfig =
    var cfg: physics2d.Physics2dForcesConfig
    cfg.gravityY = 1000
    cfg.dragNum = 99
    cfg.dragDen = 100
    cfg.splashEnabled = 1
    cfg.splashFloorY = 600
    cfg.splashRestNum = 1
    cfg.splashRestDen = 2
    cfg.splashJitterNum = 1
    cfg.splashJitterDen = 2
    cfg.inkDecayNum = 31
    cfg.inkDecayDen = 32
    return cfg

fn populatePairWorld(world: var ecs.EcsWorld) =
    ecs.EcsWorldReset(world)
    let left = ecs.EcsWorldSpawn(world, 0, 0, 1, "cid:left")
    let right = ecs.EcsWorldSpawn(world, 900, 0, 1, "cid:right")
    assert(ecs.EcsWorldSetAabbCollider(world, left, 500, 500), "forces smoke: left collider")
    assert(ecs.EcsWorldSetAabbCollider(world, right, 500, 500), "forces smoke: right collider")
    assert(ecs.EcsWorldSetVelocity(world, left, 100, 0), "forces smoke: left velocity")
    assert(ecs.EcsWorldSetVelocity(world, right, -100, 0), "forces smoke: right velocity")

fn checkReplayDeterminism() =
    var worldA: ecs.EcsWorld
    var worldB: ecs.EcsWorld
    populatePairWorld(worldA)
    populatePairWorld(worldB)
    let cfg = forcesConfig()
    var tick: int32 = 1
    while tick <= 240:
        let forcesA = physics2d.Physics2dApplyForces(worldA, tick, 16, cfg)
        let forcesB = physics2d.Physics2dApplyForces(worldB, tick, 16, cfg)
        assert(forcesA.statusCode == physics2d.Physics2dStatusOk, "forces smoke: forces status A")
        assert(physics2d.Physics2dForcesReceiptValid(forcesA), "forces smoke: forces receipt A valid")
        assert(physics2d.Physics2dForcesReceiptValid(forcesB), "forces smoke: forces receipt B valid")
        assert(forcesA.receiptCid.len == 64, "forces smoke: forces receipt cid is sha256 hex")
        assert(forcesA.receiptCid == forcesB.receiptCid, "forces smoke: forces receipt cid replay")
        # 现行契约: BindForces 消费 forces 回执(byval move)。链断言需要的 receiptCid
        # 在消费前用 Fmt 拷贝前置(借用源显式共享走 Fmt 拷贝), 断言语义不变。
        let forcesCidA = Fmt"{forcesA.receiptCid}"
        var receiptA = physics2d.Physics2dStep(worldA, tick, 16)
        var receiptB = physics2d.Physics2dStep(worldB, tick, 16)
        physics2d.Physics2dReceiptBindForces(receiptA, forcesA)
        physics2d.Physics2dReceiptBindForces(receiptB, forcesB)
        assert(physics2d.Physics2dReceiptValid(receiptA), "forces smoke: step receipt A valid")
        assert(physics2d.Physics2dReceiptValid(receiptB), "forces smoke: step receipt B valid")
        assert(receiptA.forcesReceiptCid == forcesCidA, "forces smoke: forces cid chained into step receipt")
        assert(receiptA.receiptCid == receiptB.receiptCid, "forces smoke: step receipt cid replay")
        tick = tick + 1
    assert(ecs.EcsWorldCid(worldA) == ecs.EcsWorldCid(worldB), "forces smoke: world cid replay")
    echo("forces smoke 1 ok: 240-tick replay receipt cid sequences identical")

fn checkGravityProjectile() =
    var world: ecs.EcsWorld
    ecs.EcsWorldReset(world)
    let body = ecs.EcsWorldSpawn(world, 0, 0, 1, "cid:projectile")
    assert(body > 0, "forces smoke: projectile spawn")
    var cfg = forcesConfig()
    cfg.dragNum = 1
    cfg.dragDen = 1
    cfg.splashEnabled = 0
    var tick: int32 = 1
    while tick <= 240:
        let forces = physics2d.Physics2dApplyForces(world, tick, 16, cfg)
        assert(forces.statusCode == physics2d.Physics2dStatusOk, "forces smoke: projectile forces status")
        let receipt = physics2d.Physics2dStep(world, tick, 16)
        assert(receipt.statusCode == physics2d.Physics2dStatusOk, "forces smoke: projectile step status")
        if tick == 10:
            assert(ecs.EcsWorldPositionYAt(world, 0) == 10, "forces smoke: projectile y at tick 10")
        if tick == 60:
            assert(ecs.EcsWorldPositionYAt(world, 0) == 440, "forces smoke: projectile y at tick 60")
        if tick == 120:
            assert(ecs.EcsWorldPositionYAt(world, 0) == 1799, "forces smoke: projectile y at tick 120")
        tick = tick + 1
    assert(ecs.EcsWorldPositionYAt(world, 0) == 7285, "forces smoke: projectile y at tick 240")
    assert(ecs.EcsWorldVelocityYAt(world, 0) == 3840, "forces smoke: projectile vy at tick 240")
    echo("forces smoke 2 ok: gravity projectile exact fixed-point positions")

fn checkDragRest() =
    var world: ecs.EcsWorld
    ecs.EcsWorldReset(world)
    let body = ecs.EcsWorldSpawn(world, 0, 0, 1, "cid:drag")
    assert(body > 0, "forces smoke: drag spawn")
    assert(ecs.EcsWorldSetVelocity(world, body, 1000, 0), "forces smoke: drag velocity")
    var cfg = forcesConfig()
    cfg.gravityY = 0
    cfg.dragNum = 9
    cfg.dragDen = 10
    cfg.splashEnabled = 0
    var restTick: int32
    var tick: int32 = 1
    while tick <= 240:
        let forces = physics2d.Physics2dApplyForces(world, tick, 16, cfg)
        assert(forces.statusCode == physics2d.Physics2dStatusOk, "forces smoke: drag forces status")
        let receipt = physics2d.Physics2dStep(world, tick, 16)
        assert(receipt.statusCode == physics2d.Physics2dStatusOk, "forces smoke: drag step status")
        if tick == 49:
            assert(ecs.EcsWorldVelocityXAt(world, 0) == 1, "forces smoke: drag vx at tick 49")
        if restTick == 0:
            if ecs.EcsWorldVelocityXAt(world, 0) == 0:
                restTick = tick
        tick = tick + 1
    assert(restTick == 50, "forces smoke: drag rest tick exact")
    echo("forces smoke 3 ok: drag reaches rest exactly at tick 50")

fn checkSplashEnergy() =
    var world: ecs.EcsWorld
    ecs.EcsWorldReset(world)
    let body = ecs.EcsWorldSpawn(world, 0, 0, 1, "cid:splash")
    assert(body > 0, "forces smoke: splash spawn")
    assert(ecs.EcsWorldSetVelocity(world, body, 0, 600), "forces smoke: splash velocity")
    var cfg = forcesConfig()
    cfg.gravityY = 0
    cfg.dragNum = 1
    cfg.dragDen = 1
    cfg.splashFloorY = 400
    var splashTotal: int32
    var prevEnergy: int32 = 360000
    var tick: int32 = 1
    while tick <= 240:
        let forces = physics2d.Physics2dApplyForces(world, tick, 16, cfg)
        assert(forces.statusCode == physics2d.Physics2dStatusOk, "forces smoke: splash forces status")
        splashTotal = splashTotal + forces.splashCount
        let receipt = physics2d.Physics2dStep(world, tick, 16)
        assert(receipt.statusCode == physics2d.Physics2dStatusOk, "forces smoke: splash step status")
        let vx = ecs.EcsWorldVelocityXAt(world, 0)
        let vy = ecs.EcsWorldVelocityYAt(world, 0)
        let energy = vx * vx + vy * vy
        assert(energy <= prevEnergy, "forces smoke: splash energy non-increasing")
        prevEnergy = energy
        tick = tick + 1
    assert(splashTotal == 1, "forces smoke: splash count")
    assert(prevEnergy < 360000, "forces smoke: splash dissipated energy")
    echo("forces smoke 4 ok: splash impulse keeps energy monotonically non-increasing")

fn checkInkAlphaDecay() =
    let cfg = forcesConfig()
    var alpha: int32 = 65536
    var prev: int32 = alpha
    var steps: int32
    while alpha > 0:
        alpha = physics2d.Physics2dInkAlphaDecay(alpha, cfg)
        assert(alpha < prev, "forces smoke: ink alpha strictly decreasing")
        assert(alpha >= 0, "forces smoke: ink alpha non-negative")
        prev = alpha
        steps = steps + 1
        assert(steps <= 300, "forces smoke: ink alpha decay bounded")
    assert(steps == 259, "forces smoke: ink alpha zero step exact")
    assert(alpha == 0, "forces smoke: ink alpha reaches zero")
    echo("forces smoke 5 ok: ink alpha decays monotonically to exactly 0 in 259 steps")

fn tamperBindChild(): int32 =
    var world: ecs.EcsWorld
    populatePairWorld(world)
    let cfg = forcesConfig()
    var forces = physics2d.Physics2dApplyForces(world, 1, 16, cfg)
    assert(physics2d.Physics2dForcesReceiptValid(forces), "forces tamper child: pristine receipt valid")
    forces.splashCount = forces.splashCount + 7
    var step = physics2d.Physics2dStep(world, 1, 16)
    physics2d.Physics2dReceiptBindForces(step, forces)
    echo("forces tamper child: bind accepted a tampered forces receipt")
    return 3

fn checkTamperHardFail() =
    var world: ecs.EcsWorld
    populatePairWorld(world)
    let cfg = forcesConfig()
    let forces = physics2d.Physics2dApplyForces(world, 1, 16, cfg)
    var tamperedSplash = cloneForcesReceipt(forces)
    tamperedSplash.splashCount = tamperedSplash.splashCount + 7
    assert(!physics2d.Physics2dForcesReceiptValid(tamperedSplash), "forces smoke: tampered splash count rejected")
    var tamperedWorld = cloneForcesReceipt(forces)
    tamperedWorld.worldCid = Fmt"{forces.receiptCid}"
    assert(!physics2d.Physics2dForcesReceiptValid(tamperedWorld), "forces smoke: tampered world cid rejected")
    var tamperedCid = cloneForcesReceipt(forces)
    tamperedCid.receiptCid = Fmt"{forces.worldCid}"
    assert(!physics2d.Physics2dForcesReceiptValid(tamperedCid), "forces smoke: forged receipt cid rejected")
    let selfPath = cmdline.paramStr(0)
    let res = hostos.ExecFileCapture(selfPath, ["tamper-bind"], [], "", true, 60)
    assert(os.ExecCmdResultExitCode(res) == 1, "forces smoke: tampered bind exits 1 (panic)")
    assert(strutil.Contains(os.ExecCmdResultOutput(res), "tampered forces receipt"),
        "forces smoke: tampered bind panics loudly")
    echo("forces smoke 6 ok: receipt tampering rejected + bind hard-fails")

fn main(): int32 =
    if cmdline.paramStr(1) == "tamper-bind":
        return tamperBindChild()
    checkReplayDeterminism()
    checkGravityProjectile()
    checkDragRest()
    checkSplashEnergy()
    checkInkAlphaDecay()
    checkTamperHardFail()
    echo("physics2d_forces_determinism_smoke ok: 6/6 checks passed")
    return 0
