import std/system

@importc("cheng_runtime_heap_new")
fn runtimeHeapNew(size: int32): ptr

fn main(): int32 =
    let allocBefore = memAllocCount()
    let freeBefore = memFreeCount()
    let liveBefore = memLiveCount()
    memDiagReset()

    let ordinary = runtimeHeapNew(32)
    assert(ordinary != nil, " orc release contract: ordinary allocation")
    assert(memRefCount(ordinary) == 1,
           " orc release contract: ordinary initial refcount")
    memRetain(ordinary)
    assert(memRefCount(ordinary) == 2,
           " orc release contract: ordinary retained refcount")
    memRelease(ordinary)
    assert(memRefCount(ordinary) == 1,
           " orc release contract: ordinary balanced refcount")
    memRelease(ordinary)

    for iteration in 0..<5000:
        let payload = runtimeHeapNew(32)
        assert(payload != nil,
               " orc release contract: atomic allocation")
        assert(memRefCountAtomic(payload) == 1,
               " orc release contract: atomic initial refcount")
        memRetainAtomic(payload)
        assert(memRefCountAtomic(payload) == 2,
               " orc release contract: atomic retained refcount")
        memReleaseAtomic(payload)
        assert(memRefCountAtomic(payload) == 1,
               " orc release contract: atomic balanced refcount")
        memReleaseAtomic(payload)

    let allocDelta = memAllocCount() - allocBefore
    let freeDelta = memFreeCount() - freeBefore
    let liveDelta = memLiveCount() - liveBefore
    assert(allocDelta == int64(5001),
           " orc release contract: exact alloc delta")
    assert(freeDelta == int64(5001),
           " orc release contract: exact free delta")
    assert(liveDelta == int64(0),
           " orc release contract: exact live delta")
    assert(memRetainCount() == int64(5001),
           " orc release contract: exact retain count")
    assert(memReleaseCount() == int64(10002),
           " orc release contract: exact release count")

    echo("orc_atomic_release_iterations=5000")
    echo(Fmt"orc_atomic_release_alloc_delta={allocDelta}")
    echo(Fmt"orc_atomic_release_free_delta={freeDelta}")
    echo(Fmt"orc_atomic_release_live_delta={liveDelta}")
    echo(" orc_atomic_release_contract_smoke ok")
    return 0
