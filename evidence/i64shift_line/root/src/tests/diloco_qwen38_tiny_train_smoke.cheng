# D4: frozen Qwen3.8 tiny hybrid (64-layer plan pin, 4-slot mini forward)
# + DiLoCo i32 lm_head inner SGD + token-weighted outer merge.
# Held-out metric is real softmax NLL from the frozen last-hidden, not mock.

import std/result
import std/os
import std/rawbytes as rawbytes
import std/strings as strings
import cheng/std/bytes_layout as layout
import cheng/libp2p/core/types
import cheng/inference/qwen38_hybrid_executor as hx
import cheng/inference/qwen38_forward as fwd
import cheng/DiLoCo/core/diloco as core
import cheng/DiLoCo/artifact/store as astore
import cheng/DiLoCo/train/codec as codec
import cheng/DiLoCo/train/inner_step as inner
import cheng/DiLoCo/train/outer_merge as outer
import cheng/DiLoCo/train/qwen38_inner as q38
import cheng/DiLoCo/tests/support

const
    SmokeInnerSteps: int32 = 4
    SmokeShardBytes: int32 = 64
    SmokeLrNum: int32 = 1
    SmokeLrDen: int32 = 64
    SmokeSeqLen: int32 = 2
    SmokeTargetA: int32 = 7
    SmokeTargetB: int32 = 21

fn die(msg: str): int32 =
    echo(msg)
    return 1

fn pairIds(a: int32, b: int32): int32[] =
    var ids: int32[]
    add(ids, a)
    add(ids, b)
    return ids

@borrows
fn putParams(store: var astore.DiLoCoArtifactStore,
             jobBundleCid: layout.FixedBytes32,
             values: int32[]): Result[core.DiLoCoArtifactRef] =
    var packed = rawbytes.EmptyBytes()
    let packRes = codec.DiLoCoTrainPackI32Fill(packed, values)
    if IsErr(packRes):
        return Err[core.DiLoCoArtifactRef](Error(packRes))
    var ref = core.DiLoCoArtifactRef()
    let putRes = astore.DiLoCoArtifactStorePutFill(ref, store, jobBundleCid, packed, SmokeShardBytes)
    if IsErr(putRes):
        return Err[core.DiLoCoArtifactRef](Error(putRes))
    return Ok[core.DiLoCoArtifactRef](ref)

@borrows
fn loadParams(store: astore.DiLoCoArtifactStore,
              artifactRef: core.DiLoCoArtifactRef): Result[int32[]] =
    var bytes = rawbytes.EmptyBytes()
    let getRes = astore.DiLoCoArtifactStoreGetFill(bytes, store, artifactRef)
    if IsErr(getRes):
        return Err[int32[]](Error(getRes))
    var values: int32[]
    let unpackRes = codec.DiLoCoTrainUnpackI32Fill(values, bytes)
    if IsErr(unpackRes):
        return Err[int32[]](Error(unpackRes))
    return Ok[int32[]](values)

fn main(): int32 =
    let tmpRoot = os.GetEnvDefault("CHENG_TASK_TMPDIR", "")
    if tmpRoot == "":
        return die("diloco_qwen38_tiny_train_smoke: CHENG_TASK_TMPDIR missing")

    let planRes = q38.DiLoCoQwen38TinyPinnedPlanBuild()
    if IsErr(planRes):
        return die(Error(planRes))
    let plan = Value(planRes)
    if plan.layerCount != hx.Qwen38HybridPinnedLayerCount:
        return die("diloco_qwen38_tiny_train_smoke: production layer pin")
    if plan.fullAttentionInterval != hx.Qwen38HybridPinnedFullInterval ||
       plan.fullLayerCount != hx.Qwen38HybridPinnedFullLayerCount:
        return die("diloco_qwen38_tiny_train_smoke: production interval pin")
    if plan.isFullAttention[0] || plan.isFullAttention[1] ||
       plan.isFullAttention[2] || !plan.isFullAttention[3]:
        return die("diloco_qwen38_tiny_train_smoke: mini prefix rhythm")

    let wRes = q38.DiLoCoQwen38TinyFrozenWeightsBuild()
    if IsErr(wRes):
        return die(Error(wRes))
    let weights = Value(wRes)
    if weights.layerCount != fwd.Qwen38MiniLayerCount:
        return die("diloco_qwen38_tiny_train_smoke: mini layer count")

    var dummyHid: int32[]
    dummyHid = []
    var emptyIds: int32[]
    emptyIds = []
    let emptyHid = q38.DiLoCoQwen38TinyLastHiddenI32Fill(dummyHid, weights, plan, emptyIds)
    if !IsErr(emptyHid):
        return die("diloco_qwen38_tiny_train_smoke: empty sequence must fail")

    let storeDir = tmpRoot + "/diloco-qwen38-artifacts"
    var store = astore.DiLoCoArtifactStore()
    let initRes = astore.DiLoCoArtifactStoreInitFill(store, storeDir)
    if IsErr(initRes):
        return die(Error(initRes))

    let jobBundleCid = support.DiLoCoTestJobBundleCid("qwen38-tiny-train")
    var leaderPeer: types.Libp2pPeerId
    leaderPeer.value = support.DiLoCoTestJobBundleCid("qwen38-tiny-leader")
    var workerPeer: types.Libp2pPeerId
    workerPeer.value = support.DiLoCoTestJobBundleCid("qwen38-tiny-worker")
    if types.Libp2pPeerIdEqual(leaderPeer, workerPeer):
        return die("diloco_qwen38_tiny_train_smoke: peer ids collided")

    var zeros: int32[]
    let zeroRes = inner.DiLoCoLinearZerosFill(zeros, fwd.Qwen38MiniVocab, fwd.Qwen38MiniHidden)
    if IsErr(zeroRes):
        return die(Error(zeroRes))
    let modelPut = putParams(store, jobBundleCid, zeros)
    if IsErr(modelPut):
        return die(Error(modelPut))
    let optPut = putParams(store, jobBundleCid, zeros)
    if IsErr(optPut):
        return die(Error(optPut))

    var state = core.DiLoCoStateInit("diloco.qwen38.tiny")
    var openedJob = core.DiLoCoJob()
    var genesis = core.DiLoCoGlobalVersion()
    let openRes = core.DiLoCoOpenJobFill(openedJob,
                                           genesis,
                                           state,
                                           jobBundleCid,
                                           2,
                                           SmokeInnerSteps,
                                           60,
                                           Value(modelPut),
                                           Value(optPut))
    if IsErr(openRes):
        return die(Error(openRes))

    var cohort = core.DiLoCoCohort()
    let joinL = core.DiLoCoJoinCohortFill(cohort, state, jobBundleCid, leaderPeer)
    if IsErr(joinL):
        return die(Error(joinL))
    let joinW = core.DiLoCoJoinCohortFill(cohort, state, jobBundleCid, workerPeer)
    if IsErr(joinW):
        return die(Error(joinW))
    if cohort.fixedMemberCount != 2 || !state.jobs[0].sealed:
        return die("diloco_qwen38_tiny_train_smoke: cohort not sealed")

    var leaderLease = core.DiLoCoLease()
    var workerLease = core.DiLoCoLease()
    let ll = core.DiLoCoFetchLeaseFill(leaderLease, state, jobBundleCid, leaderPeer)
    if IsErr(ll):
        return die(Error(ll))
    let wl = core.DiLoCoFetchLeaseFill(workerLease, state, jobBundleCid, workerPeer)
    if IsErr(wl):
        return die(Error(wl))
    if leaderLease.innerStepBudget != SmokeInnerSteps:
        return die("diloco_qwen38_tiny_train_smoke: lease budget")

    var baseW: int32[]
    let baseLoad = loadParams(store, genesis.modelRef)
    if IsErr(baseLoad):
        return die(Error(baseLoad))
    baseW = Value(baseLoad)

    var xsA: int32[]
    var ysA: int32[]
    let a0 = q38.DiLoCoQwen38TinyAppendSampleFill(xsA, ysA, weights, plan, pairIds(1, 2), SmokeTargetA)
    if IsErr(a0):
        return die(Error(a0))
    let a1 = q38.DiLoCoQwen38TinyAppendSampleFill(xsA, ysA, weights, plan, pairIds(1, 4), SmokeTargetA)
    if IsErr(a1):
        return die(Error(a1))
    let a2 = q38.DiLoCoQwen38TinyAppendSampleFill(xsA, ysA, weights, plan, pairIds(2, 4), SmokeTargetA)
    if IsErr(a2):
        return die(Error(a2))

    var xsB: int32[]
    var ysB: int32[]
    let b0 = q38.DiLoCoQwen38TinyAppendSampleFill(xsB, ysB, weights, plan, pairIds(8, 9), SmokeTargetB)
    if IsErr(b0):
        return die(Error(b0))
    let b1 = q38.DiLoCoQwen38TinyAppendSampleFill(xsB, ysB, weights, plan, pairIds(8, 11), SmokeTargetB)
    if IsErr(b1):
        return die(Error(b1))
    let b2 = q38.DiLoCoQwen38TinyAppendSampleFill(xsB, ysB, weights, plan, pairIds(9, 11), SmokeTargetB)
    if IsErr(b2):
        return die(Error(b2))

    var heldXs: int32[]
    var heldYs: int32[]
    var heldTargets: int32[]
    let h0 = q38.DiLoCoQwen38TinyAppendSampleFill(heldXs, heldYs, weights, plan, pairIds(1, 2), SmokeTargetA)
    if IsErr(h0):
        return die(Error(h0))
    add(heldTargets, SmokeTargetA)
    let h1 = q38.DiLoCoQwen38TinyAppendSampleFill(heldXs, heldYs, weights, plan, pairIds(8, 9), SmokeTargetB)
    if IsErr(h1):
        return die(Error(h1))
    add(heldTargets, SmokeTargetB)

    let nll0Res = q38.DiLoCoQwen38TinyNllMicrosSum(baseW, heldXs, heldTargets, 2,
                                                    fwd.Qwen38MiniVocab, fwd.Qwen38MiniHidden)
    if IsErr(nll0Res):
        return die(Error(nll0Res))
    let nll0 = Value(nll0Res)

    var wA: int32[]
    var dA: int32[]
    let innerA = inner.DiLoCoInnerSgdLinearFill(wA, dA, baseW, xsA, ysA, 3, SmokeInnerSteps,
                                                 fwd.Qwen38MiniVocab, fwd.Qwen38MiniHidden,
                                                 SmokeLrNum, SmokeLrDen)
    if IsErr(innerA):
        return die(Error(innerA))
    var wB: int32[]
    var dB: int32[]
    let innerB = inner.DiLoCoInnerSgdLinearFill(wB, dB, baseW, xsB, ysB, 3, SmokeInnerSteps,
                                                 fwd.Qwen38MiniVocab, fwd.Qwen38MiniHidden,
                                                 SmokeLrNum, SmokeLrDen)
    if IsErr(innerB):
        return die(Error(innerB))

    var barrier = core.DiLoCoBarrier()
    let brA = core.DiLoCoReportInnerStepDoneFill(barrier, state, jobBundleCid, leaderPeer)
    if IsErr(brA):
        return die(Error(brA))
    let brB = core.DiLoCoReportInnerStepDoneFill(barrier, state, jobBundleCid, workerPeer)
    if IsErr(brB):
        return die(Error(brB))
    if !barrier.sealed:
        return die("diloco_qwen38_tiny_train_smoke: barrier not sealed")

    let deltaAPut = putParams(store, jobBundleCid, dA)
    if IsErr(deltaAPut):
        return die(Error(deltaAPut))
    let deltaBPut = putParams(store, jobBundleCid, dB)
    if IsErr(deltaBPut):
        return die(Error(deltaBPut))
    let optAPut = putParams(store, jobBundleCid, zeros)
    if IsErr(optAPut):
        return die(Error(optAPut))
    let optBPut = putParams(store, jobBundleCid, zeros)
    if IsErr(optBPut):
        return die(Error(optBPut))

    let tokensA: int32 = 3 * SmokeSeqLen * SmokeInnerSteps
    let tokensB: int32 = 3 * SmokeSeqLen * SmokeInnerSteps
    var deltaRecA = core.DiLoCoOuterDelta()
    let subA = core.DiLoCoSubmitOuterDeltaFill(deltaRecA,
                                                 state,
                                                 jobBundleCid,
                                                 leaderLease.baseVersionCid,
                                                 leaderLease.outerStep,
                                                 leaderPeer,
                                                 Value(deltaAPut),
                                                 Value(optAPut),
                                                 3,
                                                 tokensA,
                                                 SmokeInnerSteps,
                                                 tokensA,
                                                 1)
    if IsErr(subA):
        return die(Error(subA))
    var deltaRecB = core.DiLoCoOuterDelta()
    let subB = core.DiLoCoSubmitOuterDeltaFill(deltaRecB,
                                                 state,
                                                 jobBundleCid,
                                                 workerLease.baseVersionCid,
                                                 workerLease.outerStep,
                                                 workerPeer,
                                                 Value(deltaBPut),
                                                 Value(optBPut),
                                                 3,
                                                 tokensB,
                                                 SmokeInnerSteps,
                                                 tokensB,
                                                 1)
    if IsErr(subB):
        return die(Error(subB))

    var commit = core.DiLoCoMergeCommit()
    var version = core.DiLoCoGlobalVersion()
    let mergeRes = outer.DiLoCoOuterMergeAndPublishFill(commit,
                                                          version,
                                                          store,
                                                          state,
                                                          jobBundleCid,
                                                          leaderPeer,
                                                          SmokeShardBytes)
    if IsErr(mergeRes):
        return die(Error(mergeRes))
    if layout.FixedBytes32Equal(version.versionCid, genesis.versionCid):
        return die("diloco_qwen38_tiny_train_smoke: versionCid did not change")
    if version.committedOuterStep != 1:
        return die("diloco_qwen38_tiny_train_smoke: outer step")

    let resolvable = astore.DiLoCoArtifactStoreRefResolvable(store, version.modelRef)
    if IsErr(resolvable):
        return die(Error(resolvable))
    let mergedLoad = loadParams(store, version.modelRef)
    if IsErr(mergedLoad):
        return die(Error(mergedLoad))
    let mergedW = Value(mergedLoad)
    var yhat0: int32[]
    let y0 = inner.DiLoCoLinearForwardOneFill(yhat0, mergedW, heldXs, 0,
                                               fwd.Qwen38MiniVocab, fwd.Qwen38MiniHidden)
    if IsErr(y0):
        return die(Error(y0))
    var maxLogit: int32 = yhat0[0]
    var maxIdx: int32 = 0
    for v in 1..<fwd.Qwen38MiniVocab:
        if yhat0[v] > maxLogit:
            maxLogit = yhat0[v]
            maxIdx = v
    echo(strings.ConcatStr("diloco_qwen38_tiny_train_smoke sample0_argmax=",
                           strings.IntToStr(maxIdx)))
    var yhat1: int32[]
    let y1 = inner.DiLoCoLinearForwardOneFill(yhat1, mergedW, heldXs, fwd.Qwen38MiniHidden,
                                               fwd.Qwen38MiniVocab, fwd.Qwen38MiniHidden)
    if IsErr(y1):
        return die(Error(y1))
    var maxLogit1: int32 = yhat1[0]
    var maxIdx1: int32 = 0
    for v in 1..<fwd.Qwen38MiniVocab:
        if yhat1[v] > maxLogit1:
            maxLogit1 = yhat1[v]
            maxIdx1 = v
    echo(strings.ConcatStr("diloco_qwen38_tiny_train_smoke sample1_argmax=",
                           strings.IntToStr(maxIdx1)))
    echo(strings.ConcatStr("diloco_qwen38_tiny_train_smoke sample0_tgt_logit=",
                           strings.IntToStr(yhat0[SmokeTargetA])))
    echo(strings.ConcatStr("diloco_qwen38_tiny_train_smoke sample1_tgt_logit=",
                           strings.IntToStr(yhat1[SmokeTargetB])))
    let nll1Res = q38.DiLoCoQwen38TinyNllMicrosSum(mergedW, heldXs, heldTargets, 2,
                                                    fwd.Qwen38MiniVocab, fwd.Qwen38MiniHidden)
    if IsErr(nll1Res):
        return die(Error(nll1Res))
    let nll1 = Value(nll1Res)
    if nll1 >= nll0:
        echo(strings.ConcatStr("diloco_qwen38_tiny_train_smoke: nll did not fall nll0=",
                               strings.IntToStr(int32(nll0))))
        echo(strings.ConcatStr("nll1=", strings.IntToStr(int32(nll1))))
        return 1
    echo(strings.ConcatStr("diloco_qwen38_tiny_train_smoke nll0_micros=",
                           strings.IntToStr(int32(nll0))))
    echo(strings.ConcatStr("diloco_qwen38_tiny_train_smoke nll1_micros=",
                           strings.IntToStr(int32(nll1))))
    echo("diloco_qwen38_tiny_train_smoke ok")
    return 0
