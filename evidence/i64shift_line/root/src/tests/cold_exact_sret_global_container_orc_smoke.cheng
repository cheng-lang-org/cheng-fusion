import std/system

type
    ColdExactSretToken = ref object
        value: int32

    ColdExactSretOwner =
        token: ColdExactSretToken
        marker: int32
        generation: int64

    ColdExactSretContainer =
        owner: ColdExactSretOwner

var coldExactSretGlobal: ColdExactSretOwner
var coldExactSretFirstCounterMismatch: int32

fn ColdExactSretMake(index: int32): ColdExactSretOwner =
    var result: ColdExactSretOwner
    result.token = new(ColdExactSretToken)
    result.token.value = index + 7000
    result.marker = index
    result.generation = int64(index) + int64(900000)
    return result

fn ColdExactSretInstallGlobal(firstIndex: int32, secondIndex: int32) =
    var firstOwner = ColdExactSretMake(firstIndex)
    coldExactSretGlobal = firstOwner
    coldExactSretGlobal = ColdExactSretMake(secondIndex)

fn ColdExactSretInstallContainer(
    container: var ColdExactSretContainer,
    firstIndex: int32,
    secondIndex: int32
) =
    var firstOwner = ColdExactSretMake(firstIndex)
    container.owner = firstOwner
    container.owner = ColdExactSretMake(secondIndex)
    # COLD_EXACT_SRET_CONSUMED_OWNER_MUTATION

fn ColdExactSretOwnerMatches(
    owner: var ColdExactSretOwner,
    index: int32
): bool =
    return owner.token != nil &&
           owner.token.value == index + 7000 &&
           owner.marker == index &&
           owner.generation == int64(index) + int64(900000)

fn ColdExactSretClear(container: var ColdExactSretContainer) =
    var emptyGlobal: ColdExactSretOwner
    coldExactSretGlobal = emptyGlobal
    var emptyContainer: ColdExactSretOwner
    container.owner = emptyContainer

fn ColdExactSretRunCycle(
    cycles: int32,
    auditCounters: bool,
    allocBase: int64,
    freeBase: int64,
    liveBase: int64
): int32 =
    var container: ColdExactSretContainer
    coldExactSretFirstCounterMismatch = -1
    for cycle in 0..<cycles:
        let firstIndex = cycle * 2
        let secondIndex = firstIndex + 1
        if cycle % 2 == 0:
            ColdExactSretInstallGlobal(firstIndex, secondIndex)
            if !ColdExactSretOwnerMatches(
                coldExactSretGlobal, secondIndex
            ):
                return 10
        else:
            ColdExactSretInstallContainer(
                container, firstIndex, secondIndex)
            if !ColdExactSretOwnerMatches(
                container.owner, secondIndex
            ):
                return 11

        if auditCounters:
            let allocAtCycle = memAllocCount() - allocBase
            let freeAtCycle = memFreeCount() - freeBase
            let liveAtCycle = memLiveCount() - liveBase
            let expectedAlloc = int64((cycle + 1) * 2)
            let expectedFree =
                cycle == 0 ? int64(1) : int64(cycle * 2)
            var expectedLive = int64(2)
            if cycle == 0:
                expectedLive = int64(1)
            if coldExactSretFirstCounterMismatch < 0 &&
               (allocAtCycle != expectedAlloc ||
                freeAtCycle != expectedFree ||
                liveAtCycle != expectedLive):
                coldExactSretFirstCounterMismatch = cycle

    coldExactSretGlobal = coldExactSretGlobal
    container.owner = container.owner
    if !ColdExactSretOwnerMatches(coldExactSretGlobal, cycles * 2 - 3):
        return 20
    if !ColdExactSretOwnerMatches(container.owner, cycles * 2 - 1):
        return 21

    ColdExactSretClear(container)
    if coldExactSretGlobal.token != nil:
        return 30
    if container.owner.token != nil:
        return 31
    if auditCounters &&
       coldExactSretFirstCounterMismatch < 0 &&
       (memAllocCount() - allocBase != int64(cycles * 2) ||
        memFreeCount() - freeBase != int64(cycles * 2) ||
        memLiveCount() - liveBase != int64(0)):
        coldExactSretFirstCounterMismatch = cycles
    return 0

fn main(): int32 =
    let warmRc = ColdExactSretRunCycle(
        4, false, int64(0), int64(0), int64(0))
    if warmRc != 0:
        return warmRc
    let liveBaseline = memLiveCount()

    memDiagReset()
    let allocBefore = memAllocCount()
    let freeBefore = memFreeCount()
    let runRc = ColdExactSretRunCycle(
        2500, true, allocBefore, freeBefore, liveBaseline)
    if runRc != 0:
        return 100 + runRc
    let allocDelta = memAllocCount() - allocBefore
    let freeDelta = memFreeCount() - freeBefore
    let liveDelta = memLiveCount() - liveBaseline
    echo("cold_exact_sret_orc_iterations=5000")
    echo(Fmt"cold_exact_sret_orc_alloc_delta={allocDelta}")
    echo(Fmt"cold_exact_sret_orc_free_delta={freeDelta}")
    echo(Fmt"cold_exact_sret_orc_live_delta={liveDelta}")
    echo(Fmt"cold_exact_sret_orc_first_failure_cycle={coldExactSretFirstCounterMismatch}")
    if allocDelta != int64(5000):
        return 201
    if freeDelta != int64(5000):
        return 202
    if allocDelta != freeDelta:
        return 203
    if liveDelta != int64(0):
        return 204

    echo("cold_exact_sret_global_container_orc_smoke ok")
    return 0
