    total = total + Int64(summary.loweringRuleUniqueKeyCount)
    total = total + Int64(summary.loweringRuleArgValueCount)
    total = total + Int64(summary.loweringRuleArgAddressCount)
    total = total + Int64(summary.loweringRuleArgCallResultAddressCount)
    total = total + Int64(summary.loweringRuleResultRegCount)
    total = total + Int64(summary.loweringRuleResultLocalAddressCount)
    total = total + Int64(summary.loweringRuleResultSretCount)
    total = total + Int64(summary.loweringRuleMaterializeRegisterCount)
    total = total + Int64(summary.loweringRuleMaterializeLocalSlotCount)
    total = total + Int64(summary.loweringRuleMaterializeCallResultLocalCount)
    total = total + Int64(summary.loweringRuleMaterializeDestAddressCount)
    total = total + Int64(summary.loweringRuleCopyScalarStoreCount)
    total = total + Int64(summary.loweringRuleCopyRegionCopyCount)
    total = total + Int64(summary.loweringRuleImportImportBufferCount)
    total = total + Int64(summary.loweringRuleImportBuiltinAddressSlotCount)
    total = total + Int64(summary.loweringRuleImportI32ValueSlotCount)
    total = total + Int64(summary.loweringRuleImportI32AddressSlotCount)
    return total

