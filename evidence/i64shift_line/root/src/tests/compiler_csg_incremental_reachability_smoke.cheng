    total = total + Int64(summary.lowerRegCount)
    total = total + Int64(summary.lowerLocalAddressCount)
    total = total + Int64(summary.lowerSretCount)
    total = total + Int64(summary.lowerImportBufferCount)
    total = total + Int64(summary.lowerDeferredCount)
    total = total + Int64(summary.callNoneCount)
    total = total + Int64(summary.callBuiltinCount)
