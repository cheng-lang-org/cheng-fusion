           left.callResolvedCount == right.callResolvedCount &&
           left.callUnresolvedCount == right.callUnresolvedCount &&
           left.surfaceCallLocalCount == right.surfaceCallLocalCount &&
           left.surfaceCallExternalCount == right.surfaceCallExternalCount &&
           left.surfaceCallImportcCount == right.surfaceCallImportcCount &&
           left.surfaceCallMemberCount == right.surfaceCallMemberCount &&
           left.callTargetImportcCount == right.callTargetImportcCount &&
           left.callReasonUnknownQualifiedTargetCount == right.callReasonUnknownQualifiedTargetCount &&
           left.callReasonShadowedQualifiedTargetCount == right.callReasonShadowedQualifiedTargetCount &&
           left.callReasonAmbiguousExternalTargetCount == right.callReasonAmbiguousExternalTargetCount &&
           left.callReasonAmbiguousQualifiedTargetCount == right.callReasonAmbiguousQualifiedTargetCount &&
           left.callReasonUnknownExternalTargetCount == right.callReasonUnknownExternalTargetCount &&
           left.callReasonUnknownCallTargetCount == right.callReasonUnknownCallTargetCount &&
           left.abiScalarCount == right.abiScalarCount &&
           left.abiCompositeCount == right.abiCompositeCount &&
           left.abiPointerLikeCount == right.abiPointerLikeCount &&
           left.abiPolymorphicCount == right.abiPolymorphicCount &&
           left.valueScalarCount == right.valueScalarCount &&
           left.valueCompositeCount == right.valueCompositeCount &&
           left.valuePointerLikeCount == right.valuePointerLikeCount &&
           left.valuePolymorphicCount == right.valuePolymorphicCount &&
           left.placeLocalCount == right.placeLocalCount &&
           left.placeGlobalCount == right.placeGlobalCount &&
           left.placeFieldCount == right.placeFieldCount &&
           left.placeTemporaryCount == right.placeTemporaryCount &&
           left.placeCallResultCount == right.placeCallResultCount &&
           left.lowerRegCount == right.lowerRegCount &&
           left.lowerLocalAddressCount == right.lowerLocalAddressCount &&
           left.lowerSretCount == right.lowerSretCount &&
           left.lowerImportBufferCount == right.lowerImportBufferCount &&
           left.lowerDeferredCount == right.lowerDeferredCount &&
           left.callNoneCount == right.callNoneCount &&
           left.callBuiltinCount == right.callBuiltinCount &&
           left.callResultIntrinsicCount == right.callResultIntrinsicCount &&
           left.callProjectionCount == right.callProjectionCount &&
           left.typeCallNoneCount == right.typeCallNoneCount &&
           left.typeCallDefaultInitCount == right.typeCallDefaultInitCount &&
