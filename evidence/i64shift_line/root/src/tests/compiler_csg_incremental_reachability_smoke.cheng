fn ConfigureSmokeSourceIndex(index: var ccsg.CompilerCsgSourcePathIndex) =
    var externalRoots: parser.ParserExternalPackageRoot[]
    var err: str
    assert(ccsg.CompilerCsgSourcePathIndexConfigureRoots(index,
                                                         "/tmp/compiler_csg_incremental_reachability_smoke",
                                                         "/tmp/compiler_csg_incremental_reachability_smoke",
                                                         externalRoots,
                                                         err),
           strutil.Join([" reachability smoke: source identity roots ", err], ""))

fn InitRegisteredSmokeSourceIndex(sourcePath: str,
                                  index: var ccsg.CompilerCsgSourcePathIndex) =
    index = ccsg.CompilerCsgSourcePathIndexInit(4)
    ConfigureSmokeSourceIndex(index)
    var err: str
    assert(ccsg.CompilerCsgSourcePathIndexRegister(index, sourcePath, 0, err),
           strutil.Join([" reachability smoke: registered source index ", err], ""))

fn InitReachableSet(sourcePath: str,
                    set: var ccsg.CompilerCsgReachableFunctionSet) =
    set = ccsg.CompilerCsgReachableFunctionSetInit(true)
    ConfigureSmokeSourceIndex(set.profileSourceIndex)
    add(set.sourcePaths, sourcePath)
    add(set.functionNames, "Caller")
    add(set.symbolTexts, "smoke::Caller")
    add(set.exportSymbolNames, "Caller")
    add(set.exportNameExplicitFlags, false)
    add(set.startLines, 1)
    add(set.endLines, 8)
    add(set.reachable, true)
    set.reachableCount = 1
    add(set.reachableQueue, 0)
    add(set.edgeHeads, -1)
    add(set.functionProfileIndexes, 0)
    add(set.profileFunctionStarts, 0)
    add(set.profileFunctionCounts, 1)
    add(set.profileLineIndexProven, true)
    var indexErr: str
    assert(ccsg.CompilerCsgSourcePathIndexRegister(set.profileSourceIndex,
                                                   sourcePath,
                                                   0,
                                                   indexErr),
           strutil.Join([" reachability smoke: profile index ", indexErr], ""))
    ccsg.CompilerCsgReachableNameIndexAppend(set.scopedFunctionNames,
                                             set.scopedFunctionNameNext,
                                             0,
                                             "Caller",
                                             0)
    ccsg.CompilerCsgReachableNameIndexAppend(set.globalFunctionNames,
                                             set.globalFunctionNameNext,
                                             -1,
                                             "Caller",
                                             0)

fn AddReachableFunction(sourcePath: str,
                        functionName: str,
                        startLine: int32,
                        endLine: int32,
                        reachable: bool,
                        set: var ccsg.CompilerCsgReachableFunctionSet): int32 =
    let functionIndex = set.functionNames.len
    add(set.sourcePaths, sourcePath)
    add(set.functionNames, functionName)
    add(set.symbolTexts, strutil.Join(["smoke::", functionName], ""))
    add(set.exportSymbolNames, functionName)
    add(set.exportNameExplicitFlags, false)
    add(set.startLines, startLine)
    add(set.endLines, endLine)
    add(set.reachable, reachable)
    if reachable:
        set.reachableCount = set.reachableCount + 1
        add(set.reachableQueue, functionIndex)
    add(set.edgeHeads, -1)
    add(set.functionProfileIndexes, 0)
    ccsg.CompilerCsgReachableNameIndexAppend(set.scopedFunctionNames,
                                             set.scopedFunctionNameNext,
                                             0,
                                             functionName,
                                             functionIndex)
    ccsg.CompilerCsgReachableNameIndexAppend(set.globalFunctionNames,
                                             set.globalFunctionNameNext,
                                             -1,
                                             functionName,
                                             functionIndex)
    set.profileFunctionCounts[0] = set.functionNames.len
    return functionIndex

fn SealReachableFixture(set: var ccsg.CompilerCsgReachableFunctionSet,
                        label: str) =
    var err: str
    assert(ccsg.CompilerCsgReachableFunctionSetSealStructure(set, err),
           strutil.Join([" reachability smoke: fixture seal ", label, " ", err], ""))

fn InitOverloadReachableSet(sourcePath: str,
                            firstReachable: bool,
                            secondReachable: bool,
                            set: var ccsg.CompilerCsgReachableFunctionSet) =
    set = ccsg.CompilerCsgReachableFunctionSetInit(true)
    ConfigureSmokeSourceIndex(set.profileSourceIndex)
    add(set.profileFunctionStarts, 0)
    add(set.profileFunctionCounts, 0)
    add(set.profileLineIndexProven, true)
    var indexErr: str
    assert(ccsg.CompilerCsgSourcePathIndexRegister(set.profileSourceIndex,
                                                   sourcePath,
                                                   0,
                                                   indexErr),
           strutil.Join([" reachability smoke: overload profile index ", indexErr], ""))
    let _firstIndex = AddReachableFunction(sourcePath,
                                           "Pick",
                                           1,
                                           8,
                                           firstReachable,
                                           set)
    let _secondIndex = AddReachableFunction(sourcePath,
                                            "Pick",
                                            10,
                                            18,
                                            secondReachable,
                                            set)
    SealReachableFixture(set, "overload")

fn BuildOverloadGraph(nodes: var ccsg.CompilerCsgNode[],
                      edges: var ccsg.CompilerCsgEdge[]) =
    nodes = []
    edges = []
    var packageNode: ccsg.CompilerCsgNode
    packageNode.nodeId = 1
    packageNode.nodeKind = ccsg.CompilerCsgNodeKindPackage
    var moduleNode: ccsg.CompilerCsgNode
    moduleNode.nodeId = 2
    moduleNode.nodeKind = ccsg.CompilerCsgNodeKindModule
    moduleNode.ownerNodeId = 1
    var firstOverloadNode: ccsg.CompilerCsgNode
    firstOverloadNode.nodeId = 3
    firstOverloadNode.nodeKind = ccsg.CompilerCsgNodeKindSymbol
    firstOverloadNode.ownerNodeId = 2
    firstOverloadNode.symbolText = "smoke::Pick"
    firstOverloadNode.factText = "Pick"
    var secondOverloadNode: ccsg.CompilerCsgNode
    secondOverloadNode.nodeId = 4
    secondOverloadNode.nodeKind = ccsg.CompilerCsgNodeKindSymbol
    secondOverloadNode.ownerNodeId = 2
    secondOverloadNode.symbolText = "smoke::Pick"
    secondOverloadNode.factText = "Pick"
    var firstLayoutNode: ccsg.CompilerCsgNode
    firstLayoutNode.nodeId = 5
    firstLayoutNode.nodeKind = ccsg.CompilerCsgNodeKindLayout
    firstLayoutNode.ownerNodeId = 3
    firstLayoutNode.factText = "first-layout"
    var firstFactNode: ccsg.CompilerCsgNode
    firstFactNode.nodeId = 6
    firstFactNode.nodeKind = ccsg.CompilerCsgNodeKindEffect
    firstFactNode.ownerNodeId = 5
    firstFactNode.factText = "first-fact"
    var secondLayoutNode: ccsg.CompilerCsgNode
    secondLayoutNode.nodeId = 7
    secondLayoutNode.nodeKind = ccsg.CompilerCsgNodeKindLayout
    secondLayoutNode.ownerNodeId = 4
    secondLayoutNode.factText = "second-layout"
    var secondFactNode: ccsg.CompilerCsgNode
    secondFactNode.nodeId = 8
    secondFactNode.nodeKind = ccsg.CompilerCsgNodeKindCapability
    secondFactNode.ownerNodeId = 7
    secondFactNode.factText = "second-fact"
    nodes = [packageNode,
             moduleNode,
             firstOverloadNode,
             secondOverloadNode,
             firstLayoutNode,
             firstFactNode,
             secondLayoutNode,
             secondFactNode]
    ccsg.CompilerCsgAddEdge(edges, 1, 2, ccsg.CompilerCsgEdgeKindContains)
    ccsg.CompilerCsgAddEdge(edges, 2, 3, ccsg.CompilerCsgEdgeKindContains)
    ccsg.CompilerCsgAddEdge(edges, 2, 4, ccsg.CompilerCsgEdgeKindContains)
    ccsg.CompilerCsgAddEdge(edges, 3, 5, ccsg.CompilerCsgEdgeKindHasLayout)
    ccsg.CompilerCsgAddEdge(edges, 5, 6, ccsg.CompilerCsgEdgeKindHasEffect)
    ccsg.CompilerCsgAddEdge(edges, 4, 7, ccsg.CompilerCsgEdgeKindHasLayout)
    ccsg.CompilerCsgAddEdge(edges, 7, 8, ccsg.CompilerCsgEdgeKindHasCapability)

fn BindOverloadGraphNodes(sourcePath: str,
                          set: var ccsg.CompilerCsgReachableFunctionSet,
                          nodes: var ccsg.CompilerCsgNode[],
                          column: var ccsg.CompilerCsgFunctionGraphNodeColumn) =
    column = ccsg.CompilerCsgFunctionGraphNodeColumnInit(2)
    var err: str
    assert(ccsg.CompilerCsgFunctionGraphNodeColumnBind(column,
                                                       set,
                                                       0,
                                                       0,
                                                       sourcePath,
                                                       1,
                                                       "Pick",
                                                       3,
                                                       err),
           strutil.Join([" reachability smoke: first overload binding ", err], ""))
    assert(ccsg.CompilerCsgFunctionGraphNodeColumnBind(column,
                                                       set,
                                                       1,
                                                       0,
                                                       sourcePath,
                                                       10,
                                                       "Pick",
                                                       4,
                                                       err),
           strutil.Join([" reachability smoke: second overload binding ", err], ""))
    assert(ccsg.CompilerCsgFunctionGraphNodeColumnSeal(column, set, nodes, err),
           strutil.Join([" reachability smoke: overload binding seal ", err], ""))

fn AssertOverloadGraphPruneUsesFunctionIndex(sourcePath: str) =
    var oneReachable: ccsg.CompilerCsgReachableFunctionSet
    InitOverloadReachableSet(sourcePath, false, true, oneReachable)
    var oneNodes: ccsg.CompilerCsgNode[]
    var oneEdges: ccsg.CompilerCsgEdge[]
    BuildOverloadGraph(oneNodes, oneEdges)
    var oneColumn: ccsg.CompilerCsgFunctionGraphNodeColumn
    BindOverloadGraphNodes(sourcePath, oneReachable, oneNodes, oneColumn)
    ccsg.CompilerCsgPruneGraphForReachable(oneNodes,
                                           oneEdges,
                                           oneReachable,
                                           oneColumn)
    assert(oneNodes.len == 5 && oneEdges.len == 4,
           " reachability smoke: overload single-reachable graph shape")
    var firstPresent = false
    var secondPresent = false
    var firstLayoutPresent = false
    var firstFactPresent = false
    var secondLayoutPresent = false
    var secondFactPresent = false
    for nodeIndex in 0..<oneNodes.len:
        if oneNodes[nodeIndex].nodeId == 3:
            firstPresent = true
        elif oneNodes[nodeIndex].nodeId == 4:
            secondPresent = true
        elif oneNodes[nodeIndex].nodeId == 5:
            firstLayoutPresent = true
        elif oneNodes[nodeIndex].nodeId == 6:
            firstFactPresent = true
        elif oneNodes[nodeIndex].nodeId == 7:
            secondLayoutPresent = true
        elif oneNodes[nodeIndex].nodeId == 8:
            secondFactPresent = true
    assert(!firstPresent && secondPresent &&
           !firstLayoutPresent && !firstFactPresent &&
           secondLayoutPresent && secondFactPresent,
           " reachability smoke: overload owned subgraph prune mismatch")
    for edgeIndex in 0..<oneEdges.len:
        let edge = oneEdges[edgeIndex]
        assert(edge.fromNodeId != 3 && edge.toNodeId != 3 &&
               edge.fromNodeId != 5 && edge.toNodeId != 5 &&
               edge.fromNodeId != 6 && edge.toNodeId != 6,
               " reachability smoke: unreachable overload owned edge retained")
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(oneReachable)

    var bothReachable: ccsg.CompilerCsgReachableFunctionSet
    InitOverloadReachableSet(sourcePath, true, true, bothReachable)
    var bothNodes: ccsg.CompilerCsgNode[]
    var bothEdges: ccsg.CompilerCsgEdge[]
    BuildOverloadGraph(bothNodes, bothEdges)
    var bothColumn: ccsg.CompilerCsgFunctionGraphNodeColumn
    BindOverloadGraphNodes(sourcePath, bothReachable, bothNodes, bothColumn)
    ccsg.CompilerCsgPruneGraphForReachable(bothNodes,
                                           bothEdges,
                                           bothReachable,
                                           bothColumn)
    assert(bothNodes.len == 8 && bothEdges.len == 7,
           " reachability smoke: both reachable overload subgraphs not retained")
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(bothReachable)

fn AssertSemanticIdentityIndexContracts() =
    var incomplete = ccsg.CompilerCsgSemanticIdentityIndexInit(8)
    var err: str
    assert(ccsg.CompilerCsgSemanticIdentityIndexInsert(incomplete,
                                                       "pkg/main",
                                                       "Pick",
                                                       "",
                                                       "",
                                                       0,
                                                       err),
           strutil.Join([" reachability smoke: unique incomplete identity ", err], ""))
    err = ""
    assert(!ccsg.CompilerCsgSemanticIdentityIndexInsert(incomplete,
                                                        "pkg/main",
                                                        "Pick",
                                                        "int32",
                                                        "int32",
                                                        1,
                                                        err) && err != "",
           " reachability smoke: incomplete identity accepted an overload")
    var ledgerErr: str
    assert(ccsg.CompilerCsgSemanticIdentityIndexValidateLedger(incomplete,
                                                               ledgerErr),
           strutil.Join([" reachability smoke: incomplete index ledger ",
                         ledgerErr], ""))
    ccsg.CompilerCsgSemanticIdentityIndexRelease(incomplete)
    assert(ccsg.CompilerCsgSemanticIdentityIndexRetainedCapacityBytes(incomplete) ==
           Int64(0),
           " reachability smoke: incomplete index retained storage after release")

    var complete = ccsg.CompilerCsgSemanticIdentityIndexInit(8)
    err = ""
    assert(ccsg.CompilerCsgSemanticIdentityIndexInsert(complete,
                                                       "pkg/main",
                                                       "Pick",
                                                       "int32",
                                                       "int32",
                                                       1,
                                                       err),
           strutil.Join([" reachability smoke: first complete identity ", err], ""))
    assert(ccsg.CompilerCsgSemanticIdentityIndexInsert(complete,
                                                       "pkg/main",
                                                       "Pick",
                                                       "int32;;int32",
                                                       "int32",
                                                       1,
                                                       err),
           strutil.Join([" reachability smoke: complete overload identity ", err], ""))
    assert(ccsg.CompilerCsgSemanticIdentityIndexInsert(complete,
                                                       "pkg/main",
                                                       "Pick",
                                                       "int32",
                                                       "int64",
                                                       1,
                                                       err),
           strutil.Join([" reachability smoke: return identity ", err], ""))
    err = ""
    assert(!ccsg.CompilerCsgSemanticIdentityIndexInsert(complete,
                                                        "pkg/main",
                                                        "Pick",
                                                        "int32",
                                                        "int32",
                                                        1,
                                                        err) && err != "",
           " reachability smoke: duplicate complete signature accepted")
    ledgerErr = ""
    assert(ccsg.CompilerCsgSemanticIdentityIndexValidateLedger(complete,
                                                               ledgerErr),
           strutil.Join([" reachability smoke: complete index ledger ",
                         ledgerErr], ""))
    assert(ccsg.CompilerCsgSemanticIdentityIndexCompositeKeyPayloadBytes(complete) ==
           Int64(0),
           " reachability smoke: semantic identity index materialized composite keys")
    ccsg.CompilerCsgSemanticIdentityIndexRelease(complete)

fn AssertSemanticIdentityIndexLargeNLinearProbe() =
    let rowCount: int32 = 8192
    var index = ccsg.CompilerCsgSemanticIdentityIndexInit(rowCount)
    var expectedHashByteVisits: int64
    var err: str
    for rowIndex in 0..<rowCount:
        let paramTypeJoin = Fmt"Type{rowIndex}"
        expectedHashByteVisits = expectedHashByteVisits +
                                 Int64(Len("pkg/large")) +
                                 Int64(Len("Overload")) +
                                 Int64(paramTypeJoin.len) +
                                 Int64(Len("bool"))
        assert(ccsg.CompilerCsgSemanticIdentityIndexInsert(index,
                                                           "pkg/large",
                                                           "Overload",
                                                           paramTypeJoin,
                                                           "bool",
                                                           1,
                                                           err),
               strutil.Join([" reachability smoke: large semantic index row ",
                             strings.IntToStr(rowIndex), err], ""))
    var ledgerErr: str
    assert(ccsg.CompilerCsgSemanticIdentityIndexValidateLedger(index,
                                                               ledgerErr),
           strutil.Join([" reachability smoke: large semantic index ledger ",
                         ledgerErr], ""))
    assert(ccsg.CompilerCsgSemanticIdentityIndexEntryCount(index) == rowCount &&
           ccsg.CompilerCsgSemanticIdentityIndexHashInputByteVisitCount(index) ==
               expectedHashByteVisits &&
           ccsg.CompilerCsgSemanticIdentityIndexProbeVisitCount(index) <=
               Int64(rowCount) * Int64(8) &&
           ccsg.CompilerCsgSemanticIdentityIndexCompositeKeyPayloadBytes(index) ==
               Int64(0) &&
           ccsg.CompilerCsgSemanticIdentityIndexRetainedCapacityBytes(index) >
               Int64(0) &&
           ccsg.CompilerCsgSemanticIdentityIndexPeakRetainedCapacityBytes(index) >=
               ccsg.CompilerCsgSemanticIdentityIndexRetainedCapacityBytes(index),
           " reachability smoke: semantic identity index is not linear/bounded")
    let peakBytes =
        ccsg.CompilerCsgSemanticIdentityIndexPeakRetainedCapacityBytes(index)
    ccsg.CompilerCsgSemanticIdentityIndexRelease(index)
    ledgerErr = ""
    assert(ccsg.CompilerCsgSemanticIdentityIndexValidateLedger(index,
                                                               ledgerErr) &&
           ccsg.CompilerCsgSemanticIdentityIndexRetainedCapacityBytes(index) ==
               Int64(0) &&
           ccsg.CompilerCsgSemanticIdentityIndexPeakRetainedCapacityBytes(index) ==
               peakBytes,
           " reachability smoke: semantic identity index release ledger mismatch")

fn AssertDeclarationNameExactSetCollisionPressure() =
    let rowCount: int32 = 4096
    let collisionLeft = "frhxnrbvrx"
    let collisionRight = "fwegiiltax"
    let collisionLeftKey = parser.ParserTextLookupKeyExact(collisionLeft)
    let collisionRightKey = parser.ParserTextLookupKeyExact(collisionRight)
    assert(collisionLeft != collisionRight &&
           collisionLeftKey.keyLen == collisionRightKey.keyLen &&
           collisionLeftKey.firstCode == collisionRightKey.firstCode &&
           collisionLeftKey.lastCode == collisionRightKey.lastCode &&
           collisionLeftKey.dotCount == collisionRightKey.dotCount &&
           collisionLeftKey.textHash == collisionRightKey.textHash,
           " reachability smoke: declaration collision fixture is not a real key collision")
    var decls: parser.NormalizedFunctionDecl[]
    var maskParts: str[]
    for rowIndex in 0..<rowCount:
        let functionName = Fmt"f{1000000 + rowIndex}x"
        var localDecl: parser.NormalizedFunctionDecl
        localDecl.name = functionName
        localDecl.surfaceKeyword = "fn"
        add(decls, localDecl)
        add(maskParts, "0")
        add(decls, localDecl)
        add(maskParts, "0")
        var importcDecl = localDecl
        importcDecl.surfaceKeyword = "importc fn"
        add(decls, importcDecl)
        add(maskParts, "1")
        add(decls, importcDecl)
        add(maskParts, "1")
    for collisionIndex in 0..<2:
        let functionName = collisionIndex == 0 ? collisionLeft : collisionRight
        var localDecl: parser.NormalizedFunctionDecl
        localDecl.name = functionName
        localDecl.surfaceKeyword = "fn"
        add(decls, localDecl)
        add(maskParts, "0")
        add(decls, localDecl)
        add(maskParts, "0")
        var importcDecl = localDecl
        importcDecl.surfaceKeyword = "importc fn"
        add(decls, importcDecl)
        add(maskParts, "1")
        add(decls, importcDecl)
        add(maskParts, "1")
    let importcMask = strutil.Join(maskParts, "")
    let localNames = ccsg.CompilerCsgDeclNamesFromDecls(decls, false)
    let importcNames = ccsg.CompilerCsgDeclNamesFromDecls(decls, true)
    let localMaskNames =
        ccsg.CompilerCsgDeclNamesFromDeclsWithMask(decls, importcMask, 0)
    let importcMaskNames =
        ccsg.CompilerCsgDeclNamesFromDeclsWithMask(decls, importcMask, 1)
    let expectedCount = rowCount + 2
    assert(localNames.len == expectedCount &&
           importcNames.len == expectedCount &&
           localMaskNames.len == expectedCount &&
           importcMaskNames.len == expectedCount &&
           localNames[rowCount] == collisionLeft &&
           localNames[rowCount + 1] == collisionRight &&
           importcNames[rowCount] == collisionLeft &&
           importcNames[rowCount + 1] == collisionRight &&
           localMaskNames[rowCount] == collisionLeft &&
           localMaskNames[rowCount + 1] == collisionRight &&
           importcMaskNames[rowCount] == collisionLeft &&
           importcMaskNames[rowCount + 1] == collisionRight,
           " reachability smoke: declaration exact set lost same-length hash collision")

fn SemanticSnapshotDigest(table: ccsg.CompilerCsgSemanticTypedFactTable,
                          err: var str): int64 =
    return ccsg.CompilerCsgSemanticTypedFactSemanticSnapshotDigestRange(table,
                                                                 0,
                                                                 table.sourceIndexes.len,
                                                                 2,
                                                                 3,
                                                                 err)

fn AssertTypedFactSemanticSnapshotDetectsFieldMutation() =
    var fact: texpr.TypedExprFact
    fact.exprId = "semantic-fact"
    fact.sourcePath = "pkg/semantic"
    fact.lineNumber = 11
    fact.columnNumber = 7
    fact.endLineNumber = 11
    fact.endColumnNumber = 19
    fact.kind = parser.NormalizedExprCall
    fact.surfaceCallKind = texpr.TypedExprSurfaceCallLocal
    fact.callResolved = true
    fact.callReason = texpr.TypedExprCallReasonNone
    fact.callCallee = "Target"
    fact.callTarget = "Target"
    fact.callTargetSourcePath = "pkg/semantic"
    fact.callArgCount = 1
    fact.callArgsText = "value"
    fact.typeText = "int32"
    fact.abiClass = texpr.TypedExprAbiScalar
    fact.valueKind = texpr.TypedExprValueComposite
    fact.placeKind = texpr.TypedExprPlaceField
    fact.hasSink = true
    fact.sinkPlaceKind = texpr.TypedExprPlaceLocal
    fact.loweringMode = texpr.TypedExprLowerLocalAddress
    fact.callKind = texpr.TypedExprCallProjection
    fact.typeCallKind = texpr.TypedExprTypeCallConstructor
    fact.returnKind = texpr.TypedExprReturnCompositeLocal
    fact.returnRoot = true

    var facts: texpr.TypedExprFactTable
    texpr.TypedExprFactTableAppendHandBuilt(facts, fact)
    var err: str
    let expected = ccsg.CompilerCsgTypedFactSemanticDigestRange(facts,
                                                                0,
                                                                1,
                                                                err)
    assert(err == "", " reachability smoke: fact semantic digest failed")
    var snapshot: ccsg.CompilerCsgSemanticTypedFactTable
    ccsg.CompilerCsgSemanticAppendTypedFactSemanticSnapshotRow(snapshot,
                                                         2,
                                                         3,
                                                         fact)
    let baseline = SemanticSnapshotDigest(snapshot, err)
    assert(err == "" && baseline == expected,
           " reachability smoke: retained semantic snapshot drift")

    snapshot.semanticIdentityCertificates[0] =
        snapshot.semanticIdentityCertificates[0] + Int64(1)
    assert(SemanticSnapshotDigest(snapshot, err) != baseline,
           " reachability smoke: semantic identity mutation escaped")
    snapshot.semanticIdentityCertificates[0] =
        snapshot.semanticIdentityCertificates[0] - Int64(1)
    snapshot.valueKinds[0] = snapshot.valueKinds[0] + 1
    assert(SemanticSnapshotDigest(snapshot, err) != baseline,
           " reachability smoke: value mutation escaped")
    snapshot.valueKinds[0] = snapshot.valueKinds[0] - 1
    snapshot.placeKinds[0] = snapshot.placeKinds[0] + 1
    assert(SemanticSnapshotDigest(snapshot, err) != baseline,
           " reachability smoke: place mutation escaped")
    snapshot.placeKinds[0] = snapshot.placeKinds[0] - 1
    snapshot.hasSinks[0] = !snapshot.hasSinks[0]
    assert(SemanticSnapshotDigest(snapshot, err) != baseline,
           " reachability smoke: sink-presence mutation escaped")
    snapshot.hasSinks[0] = !snapshot.hasSinks[0]
    snapshot.sinkPlaceKinds[0] = snapshot.sinkPlaceKinds[0] + 1
    assert(SemanticSnapshotDigest(snapshot, err) != baseline,
           " reachability smoke: sink-place mutation escaped")
    snapshot.sinkPlaceKinds[0] = snapshot.sinkPlaceKinds[0] - 1
    snapshot.loweringModes[0] = snapshot.loweringModes[0] + 1
    assert(SemanticSnapshotDigest(snapshot, err) != baseline,
           " reachability smoke: lowering mutation escaped")
    snapshot.loweringModes[0] = snapshot.loweringModes[0] - 1
    snapshot.callKinds[0] = snapshot.callKinds[0] + 1
    assert(SemanticSnapshotDigest(snapshot, err) != baseline,
           " reachability smoke: call mutation escaped")
    snapshot.callKinds[0] = snapshot.callKinds[0] - 1
    snapshot.typeCallKinds[0] = snapshot.typeCallKinds[0] + 1
    assert(SemanticSnapshotDigest(snapshot, err) != baseline,
           " reachability smoke: type-call mutation escaped")
    snapshot.typeCallKinds[0] = snapshot.typeCallKinds[0] - 1
    snapshot.returnKinds[0] = snapshot.returnKinds[0] + 1
    assert(SemanticSnapshotDigest(snapshot, err) != baseline,
           " reachability smoke: return mutation escaped")
    snapshot.returnKinds[0] = snapshot.returnKinds[0] - 1
    snapshot.returnRoots[0] = !snapshot.returnRoots[0]
    assert(SemanticSnapshotDigest(snapshot, err) != baseline,
           " reachability smoke: return-root mutation escaped")
    snapshot.returnRoots[0] = !snapshot.returnRoots[0]
    snapshot.functionIndexes[0] = 4
    err = ""
    let _ownerMismatch = SemanticSnapshotDigest(snapshot, err)
    assert(err != "", " reachability smoke: semantic owner mutation escaped")
    texpr.TypedExprFactTableRelease(facts)

fn AssertCompilerCsgSemanticConservationMutation(csg: var ccsg.CompilerCsg) =
    assert(csg.semanticGraph.typedFactSemanticConservationProved &&
           csg.semanticGraph.typedFactSemanticSliceCount > 0 &&
           csg.semanticGraph.typedFactSemanticValidatedSliceCount ==
               csg.semanticGraph.typedFactSemanticSliceCount &&
           csg.semanticGraph.typedFactTable.loweringModes.len > 0,
           " reachability smoke: production semantic conservation not proved")
    let savedLoweringMode = csg.semanticGraph.typedFactTable.loweringModes[0]
    csg.semanticGraph.typedFactTable.loweringModes[0] = savedLoweringMode + 1
    var err: str
    assert(!ccsg.CompilerCsgSemanticValidateTypedFactSemanticConservation(csg.semanticGraph,
                                                                    csg.typedIr,
                                                                    err) &&
           err != "",
           " reachability smoke: production semantic mutation escaped")
    csg.semanticGraph.typedFactTable.loweringModes[0] = savedLoweringMode
    err = ""
    assert(ccsg.CompilerCsgSemanticValidateTypedFactSemanticConservation(csg.semanticGraph,
                                                                   csg.typedIr,
                                                                   err) &&
           err == "",
           " reachability smoke: production semantic conservation did not recover")

fn AssertFinalGraphPruneKeepsTypedIrLateReachable(sourcePath: str) =
    var reachable: ccsg.CompilerCsgReachableFunctionSet
    InitReachableSet(sourcePath, reachable)
    let lateIndex = AddReachableFunction(sourcePath, "Late", 10, 16, false, reachable)
    let _deadIndex = AddReachableFunction(sourcePath, "Dead", 20, 24, false, reachable)
    SealReachableFixture(reachable, "final graph prune")
    var lateFrontier: int32[]
    ccsg.CompilerCsgReachableMark(reachable, lateIndex, lateFrontier)

    var packageNode: ccsg.CompilerCsgNode
    packageNode.nodeId = 1
    packageNode.nodeKind = ccsg.CompilerCsgNodeKindPackage
    var moduleNode: ccsg.CompilerCsgNode
    moduleNode.nodeId = 2
    moduleNode.nodeKind = ccsg.CompilerCsgNodeKindModule
    moduleNode.ownerNodeId = 1
    var callerNode: ccsg.CompilerCsgNode
    callerNode.nodeId = 3
    callerNode.nodeKind = ccsg.CompilerCsgNodeKindSymbol
    callerNode.ownerNodeId = 2
    callerNode.symbolText = "smoke::Caller"
    var lateNode: ccsg.CompilerCsgNode
    lateNode.nodeId = 4
    lateNode.nodeKind = ccsg.CompilerCsgNodeKindSymbol
    lateNode.ownerNodeId = 2
    lateNode.symbolText = "smoke::Late"
    var deadNode: ccsg.CompilerCsgNode
    deadNode.nodeId = 5
    deadNode.nodeKind = ccsg.CompilerCsgNodeKindSymbol
    deadNode.ownerNodeId = 2
    deadNode.symbolText = "smoke::Dead"
    var nodes = [packageNode, moduleNode, callerNode, lateNode, deadNode]
    var edges: ccsg.CompilerCsgEdge[]
    ccsg.CompilerCsgAddEdge(edges, 1, 2, ccsg.CompilerCsgEdgeKindContains)
    ccsg.CompilerCsgAddEdge(edges, 2, 3, ccsg.CompilerCsgEdgeKindContains)
    ccsg.CompilerCsgAddEdge(edges, 2, 4, ccsg.CompilerCsgEdgeKindContains)
    ccsg.CompilerCsgAddEdge(edges, 2, 5, ccsg.CompilerCsgEdgeKindContains)

    var functionGraphNodes = ccsg.CompilerCsgFunctionGraphNodeColumnInit(3)
    var graphErr: str
    assert(ccsg.CompilerCsgFunctionGraphNodeColumnBind(functionGraphNodes,
                                                       reachable,
                                                       0,
                                                       0,
                                                       sourcePath,
                                                       1,
                                                       "Caller",
                                                       3,
                                                       graphErr),
           strutil.Join([" reachability smoke: caller graph binding ", graphErr], ""))
    assert(ccsg.CompilerCsgFunctionGraphNodeColumnBind(functionGraphNodes,
                                                       reachable,
                                                       1,
                                                       0,
                                                       sourcePath,
                                                       10,
                                                       "Late",
                                                       4,
                                                       graphErr),
           strutil.Join([" reachability smoke: late graph binding ", graphErr], ""))
    assert(ccsg.CompilerCsgFunctionGraphNodeColumnBind(functionGraphNodes,
                                                       reachable,
                                                       2,
                                                       0,
                                                       sourcePath,
                                                       20,
                                                       "Dead",
                                                       5,
                                                       graphErr),
           strutil.Join([" reachability smoke: dead graph binding ", graphErr], ""))
    assert(ccsg.CompilerCsgFunctionGraphNodeColumnSeal(functionGraphNodes,
                                                       reachable,
                                                       nodes,
                                                       graphErr),
           strutil.Join([" reachability smoke: graph binding seal ", graphErr], ""))
    ccsg.CompilerCsgPruneGraphForReachable(nodes,
                                           edges,
                                           reachable,
                                           functionGraphNodes)
    assert(nodes.len == 4 && edges.len == 3,
           " reachability smoke: final prune lost late TypedIR node or live edges")
    var latePresent = false
    var deadPresent = false
    for nodeIndex in 0..<nodes.len:
        if nodes[nodeIndex].symbolText == "smoke::Late":
            latePresent = true
        if nodes[nodeIndex].symbolText == "smoke::Dead":
            deadPresent = true
    assert(latePresent && !deadPresent,
           " reachability smoke: final prune reachable bitset mismatch")
    for edgeIndex in 0..<edges.len:
        assert(edges[edgeIndex].fromNodeId != 5 && edges[edgeIndex].toNodeId != 5,
               " reachability smoke: final prune retained dead endpoint")
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(reachable)

fn AppendTypedIrFunction(ir: var texpr.TypedExprIr,
                         sourcePath: str,
                         functionName: str,
                         signatureLine: int32,
                         statementStart: int32,
                         statementCount: int32) =
    let scopeStart = ir.scopes2_scopeIds.len
    texpr.TypedExprIrAppendScope(ir,
                                  0,
                                  -1,
                                  parser.NormalizedScopeRoot,
                                  -1,
                                  0,
                                  signatureLine,
                                  1,
                                  signatureLine + 4,
                                  80)
    var fnIr: texpr.TypedExprIrFunction
    fnIr.sourcePath = sourcePath
    fnIr.functionName = functionName
    fnIr.signatureLineNumber = signatureLine
    fnIr.endLineNumber = signatureLine + 4
    fnIr.bodyLineNumber = signatureLine + 1
    fnIr.returnType = "int32"
    fnIr.statementStart = statementStart
    fnIr.statementCount = statementCount
    fnIr.scopeStart = scopeStart
    fnIr.scopeCount = 1
    fnIr.nodeStart = ir.nodes2_nodeIndexs.len
    fnIr.returnNodeIndex = -1
    texpr.TypedExprIrAppendFunction(ir, fnIr)

fn BuildDirectCallTypedIr(sourcePath: str,
                          surfaceKind: texpr.CallSurfaceKind,
                          ir: var texpr.TypedExprIr) =
    ir.internPool = langintern.InternPoolNew()
    var stmt: texpr.TypedExprIrStatement
    stmt.sourcePath = sourcePath
    stmt.functionName = "Caller"
    stmt.statementIndex = 0
    stmt.lineNumber = 2
    stmt.columnNumber = 5
    stmt.kind = texpr.TypedExprIrStmtCall
    stmt.callKind = texpr.TypedExprCallNone
    stmt.callCallee = "[]="
    stmt.callTarget = "[]="
    stmt.callTargetSourcePath = sourcePath
    stmt.callTargetImportc = false
    stmt.callSurfaceKind = surfaceKind
    stmt.callArgCount = 3
    stmt.rhsNodeIndex = -1
    stmt.callArgNodeStart = -1
    stmt.forStartNodeIndex = -1
    stmt.assignLvalueNodeIndex = -1
    stmt.assignIndexNodeIndex = -1
    texpr.TypedExprIrAppendStatement(ir, stmt)
    AppendTypedIrFunction(ir, sourcePath, "Caller", 1, 0, 1)

fn EmptyResolvedCalls(functionCount: int32): ccsg.CompilerCsgSemanticResolvedCallTable =
    var table: ccsg.CompilerCsgSemanticResolvedCallTable
    table.internPool = langintern.InternPoolNew()
    for functionIndex in 0..<functionCount:
        add(table.functionRowHeads, -1)
    return table

fn AppendDirectCallStatement(ir: var texpr.TypedExprIr,
                             sourcePath: str,
                             statementIndex: int32,
                             lineNumber: int32,
                             targetName: str) =
    var stmt: texpr.TypedExprIrStatement
    stmt.sourcePath = sourcePath
    stmt.functionName = "Caller"
    stmt.statementIndex = statementIndex
    stmt.lineNumber = lineNumber
    stmt.columnNumber = 5
    stmt.kind = texpr.TypedExprIrStmtCall
    stmt.callKind = texpr.TypedExprCallNone
    stmt.callCallee = targetName == "" ? "Damaged" : targetName
    stmt.callTarget = targetName
    stmt.callTargetSourcePath = sourcePath
    stmt.callSurfaceKind = texpr.CallSurfaceWholeCall
    stmt.rhsNodeIndex = -1
    stmt.callArgNodeStart = -1
    stmt.forStartNodeIndex = -1
    stmt.assignLvalueNodeIndex = -1
    stmt.assignIndexNodeIndex = -1
    texpr.TypedExprIrAppendStatement(ir, stmt)

fn BuildTwoCallTypedIr(sourcePath: str,
                       secondTarget: str,
                       ir: var texpr.TypedExprIr) =
    ir.internPool = langintern.InternPoolNew()
    AppendDirectCallStatement(ir, sourcePath, 0, 2, "TargetA")
    AppendDirectCallStatement(ir, sourcePath, 1, 3, secondTarget)
    AppendTypedIrFunction(ir, sourcePath, "Caller", 1, 0, 2)

fn AppendExecutableFact(facts: var texpr.TypedExprFactTable,
                        sourcePath: str,
                        lineNumber: int32,
                        callee: str,
                        target: str,
                        callArgsText: str) =
    var fact: texpr.TypedExprFact
    fact.exprId = strutil.Join(["fact-", strings.IntToStr(lineNumber)], "")
    fact.sourcePath = sourcePath
    fact.lineNumber = lineNumber
    fact.columnNumber = 5
    fact.valueExprCallNodeIndex = lineNumber
    fact.kind = parser.NormalizedExprCall
    fact.surfaceCallKind = texpr.TypedExprSurfaceCallLocal
    fact.callResolved = true
    fact.callReason = texpr.TypedExprCallReasonNone
    fact.callCallee = callee
    fact.callTarget = target
    fact.callTargetSourcePath = sourcePath
    fact.callKind = texpr.TypedExprCallNone
    fact.typeCallKind = texpr.TypedExprTypeCallNone
    fact.callArgsText = callArgsText
    texpr.TypedExprFactTableAppendHandBuilt(facts, fact)

fn AssertEmptyResolvedCallTableExact(table: var ccsg.CompilerCsgSemanticResolvedCallTable,
                                     functionCount: int32,
                                     headCapacity: int32,
                                     internTextCapacity: int32,
                                     label: str) =
    assert(table.functionRowHeads.len == functionCount &&
           table.functionRowHeads.cap == headCapacity &&
           table.internPool.texts.len == 0 &&
           table.internPool.texts.cap == internTextCapacity &&
           langintern.InternPoolCount(table.internPool) == 0 &&
           table.sourceIndexes.len == 0 && table.sourceIndexes.cap == 0 &&
           table.originParserNodeIds.len == 0 &&
           table.originParserNodeIds.cap == 0 &&
           table.functionIndexes.len == 0 && table.functionIndexes.cap == 0 &&
           table.functionRowNext.len == 0 && table.functionRowNext.cap == 0 &&
           table.sourcePathIds.len == 0 && table.sourcePathIds.cap == 0 &&
           table.lineNumbers.len == 0 && table.lineNumbers.cap == 0 &&
           table.columnNumbers.len == 0 && table.columnNumbers.cap == 0 &&
           table.callQualifierIds.len == 0 && table.callQualifierIds.cap == 0 &&
           table.callCalleeIds.len == 0 && table.callCalleeIds.cap == 0 &&
           table.callTargetIds.len == 0 && table.callTargetIds.cap == 0 &&
           table.callTargetSourcePathIds.len == 0 && table.callTargetSourcePathIds.cap == 0 &&
           table.callTargetImportcFlags.len == 0 && table.callTargetImportcFlags.cap == 0 &&
           table.callArgCounts.len == 0 && table.callArgCounts.cap == 0 &&
           table.callArgsTextIds.len == 0 && table.callArgsTextIds.cap == 0 &&
           table.returnRootFlags.len == 0 && table.returnRootFlags.cap == 0,
           strutil.Join([" reachability smoke: resolved table changed ", label], ""))
    for functionIndex in 0..<table.functionRowHeads.len:
        assert(table.functionRowHeads[functionIndex] == -1,
               strutil.Join([" reachability smoke: resolved head changed ", label], ""))

fn AppendResolvedReturnRow(table: var ccsg.CompilerCsgSemanticResolvedCallTable,
                           ownerIndex: int32,
                           sourcePath: str,
                           lineNumber: int32,
                           targetName: str) =
    let rowIndex = table.sourceIndexes.len
    add(table.sourceIndexes, 0)
    add(table.originParserNodeIds, lineNumber)
    add(table.functionIndexes, ownerIndex)
    add(table.functionRowNext, table.functionRowHeads[ownerIndex])
    table.functionRowHeads[ownerIndex] = rowIndex
    add(table.sourcePathIds, langintern.Intern(table.internPool, sourcePath))
    add(table.lineNumbers, lineNumber)
    add(table.columnNumbers, 5)
    add(table.callQualifierIds, langintern.Intern(table.internPool, ""))
    add(table.callCalleeIds, langintern.Intern(table.internPool, targetName))
    add(table.callTargetIds, langintern.Intern(table.internPool, targetName))
    add(table.callTargetSourcePathIds, langintern.Intern(table.internPool, sourcePath))
    add(table.callTargetImportcFlags, false)
    add(table.callArgCounts, 0)
    add(table.callArgsTextIds, langintern.Intern(table.internPool, ""))
    add(table.returnRootFlags, true)

fn AssertResolvedCallTableStorageEqual(left: var ccsg.CompilerCsgSemanticResolvedCallTable,
                                       right: var ccsg.CompilerCsgSemanticResolvedCallTable,
                                       label: str) =
    AssertInt32ArraysEqual(left.sourceIndexes, right.sourceIndexes, strutil.Join([label, " sources"], ""))
    AssertInt32ArraysEqual(left.originParserNodeIds,
                           right.originParserNodeIds,
                           strutil.Join([label, " parser origins"], ""))
    AssertInt32ArraysEqual(left.functionIndexes, right.functionIndexes, strutil.Join([label, " functions"], ""))
    AssertInt32ArraysEqual(left.functionRowHeads, right.functionRowHeads, strutil.Join([label, " heads"], ""))
    AssertInt32ArraysEqual(left.functionRowNext, right.functionRowNext, strutil.Join([label, " next"], ""))
    AssertInt32ArraysEqual(left.sourcePathIds, right.sourcePathIds, strutil.Join([label, " source ids"], ""))
    AssertInt32ArraysEqual(left.lineNumbers, right.lineNumbers, strutil.Join([label, " lines"], ""))
    AssertInt32ArraysEqual(left.columnNumbers, right.columnNumbers, strutil.Join([label, " columns"], ""))
    AssertInt32ArraysEqual(left.callQualifierIds, right.callQualifierIds, strutil.Join([label, " qualifiers"], ""))
    AssertInt32ArraysEqual(left.callCalleeIds, right.callCalleeIds, strutil.Join([label, " callees"], ""))
    AssertInt32ArraysEqual(left.callTargetIds, right.callTargetIds, strutil.Join([label, " targets"], ""))
    AssertInt32ArraysEqual(left.callTargetSourcePathIds,
                           right.callTargetSourcePathIds,
                           strutil.Join([label, " target sources"], ""))
    AssertBoolArraysEqual(left.callTargetImportcFlags,
                          right.callTargetImportcFlags,
                          strutil.Join([label, " importc"], ""))
    AssertInt32ArraysEqual(left.callArgCounts, right.callArgCounts, strutil.Join([label, " arg counts"], ""))
    AssertInt32ArraysEqual(left.callArgsTextIds, right.callArgsTextIds, strutil.Join([label, " arg text"], ""))
    AssertBoolArraysEqual(left.returnRootFlags, right.returnRootFlags, strutil.Join([label, " returns"], ""))
    assert(left.sourceIndexes.cap == right.sourceIndexes.cap &&
           left.originParserNodeIds.cap == right.originParserNodeIds.cap &&
           left.functionIndexes.cap == right.functionIndexes.cap &&
           left.functionRowHeads.cap == right.functionRowHeads.cap &&
           left.functionRowNext.cap == right.functionRowNext.cap &&
           left.sourcePathIds.cap == right.sourcePathIds.cap &&
           left.lineNumbers.cap == right.lineNumbers.cap &&
           left.columnNumbers.cap == right.columnNumbers.cap &&
           left.callQualifierIds.cap == right.callQualifierIds.cap &&
           left.callCalleeIds.cap == right.callCalleeIds.cap &&
           left.callTargetIds.cap == right.callTargetIds.cap &&
           left.callTargetSourcePathIds.cap == right.callTargetSourcePathIds.cap &&
           left.callTargetImportcFlags.cap == right.callTargetImportcFlags.cap &&
           left.callArgCounts.cap == right.callArgCounts.cap &&
           left.callArgsTextIds.cap == right.callArgsTextIds.cap &&
           left.returnRootFlags.cap == right.returnRootFlags.cap &&
           left.internPool.emptyId == right.internPool.emptyId,
           strutil.Join([" reachability smoke: resolved table capacity mismatch ", label], ""))
    AssertStrArraysEqual(left.internPool.texts,
                         right.internPool.texts,
                         strutil.Join([label, " intern texts"], ""))
    assert(left.internPool.texts.cap == right.internPool.texts.cap,
           strutil.Join([" reachability smoke: resolved intern capacity mismatch ", label], ""))
    AssertHashMapStrIntEqual(left.internPool.index,
                             right.internPool.index,
                             strutil.Join([label, " intern index"], ""))

fn AssertInt32ArraysEqual(left: int32[],
                          right: int32[],
                          label: str) =
    assert(left.len == right.len,
           strutil.Join([" reachability smoke: length mismatch ", label], ""))
    for i in 0..<left.len:
        assert(left[i] == right[i],
               strutil.Join([" reachability smoke: row mismatch ", label], ""))

fn AssertBoolArraysEqual(left: bool[],
                         right: bool[],
                         label: str) =
    assert(left.len == right.len,
           strutil.Join([" reachability smoke: bool length mismatch ", label], ""))
    for i in 0..<left.len:
        assert(left[i] == right[i],
               strutil.Join([" reachability smoke: bool row mismatch ", label], ""))

fn AssertInt64ArraysEqual(left: int64[],
                          right: int64[],
                          label: str) =
    assert(left.len == right.len && left.cap == right.cap,
           strutil.Join([" reachability smoke: int64 shape mismatch ", label], ""))
    for i in 0..<left.len:
        assert(left[i] == right[i],
               strutil.Join([" reachability smoke: int64 row mismatch ", label], ""))

fn AssertUInt8ArraysEqual(left: uint8[],
                          right: uint8[],
                          label: str) =
    assert(left.len == right.len && left.cap == right.cap,
           strutil.Join([" reachability smoke: uint8 shape mismatch ", label], ""))
    for i in 0..<left.len:
        assert(left[i] == right[i],
               strutil.Join([" reachability smoke: uint8 row mismatch ", label], ""))

fn AssertUInt64ArraysEqual(left: uint64[],
                           right: uint64[],
                           label: str) =
    assert(left.len == right.len && left.cap == right.cap,
           strutil.Join([" reachability smoke: uint64 shape mismatch ", label], ""))
    for i in 0..<left.len:
        assert(left[i] == right[i],
               strutil.Join([" reachability smoke: uint64 row mismatch ", label], ""))

fn AssertStagingLedgerExact(ledger: ccsg.CompilerCsgStagingCapacityLedger,
                            label: str) =
    let exact = ledger.sortingBytes + ledger.sparseIndexBytes +
                ledger.reachabilityDeltaBytes + ledger.frontierAdjacencyBytes +
                ledger.frontierSelectionBytes + ledger.frontierOutputBytes +
                ledger.profileStateJournalBytes + ledger.profilePendingBytes +
                ledger.profileCacheOverlayBytes + ledger.profileLineScratchBytes +
                ledger.profileResolverScratchBytes + ledger.parserCacheScratchBytes +
                ledger.frontierParserScratchBytes +
                ledger.typedFactTransactionBytes + ledger.validationBytes
    var err: str
    assert(ledger.totalBytes == exact && ledger.phasePeakBytes >= ledger.totalBytes &&
           ccsg.CompilerCsgStagingCapacityLedgerValidate(ledger, err),
           strutil.Join([" reachability smoke: staging ledger mismatch ", label, err], ""))

fn AssertStagingLedgerEqual(left: ccsg.CompilerCsgStagingCapacityLedger,
                            right: ccsg.CompilerCsgStagingCapacityLedger,
                            label: str) =
    assert(left.sortingBytes == right.sortingBytes &&
           left.sparseIndexBytes == right.sparseIndexBytes &&
           left.reachabilityDeltaBytes == right.reachabilityDeltaBytes &&
           left.frontierAdjacencyBytes == right.frontierAdjacencyBytes &&
           left.frontierSelectionBytes == right.frontierSelectionBytes &&
           left.frontierOutputBytes == right.frontierOutputBytes &&
           left.profileStateJournalBytes == right.profileStateJournalBytes &&
           left.profilePendingBytes == right.profilePendingBytes &&
           left.profileCacheOverlayBytes == right.profileCacheOverlayBytes &&
           left.profileLineScratchBytes == right.profileLineScratchBytes &&
           left.profileResolverScratchBytes == right.profileResolverScratchBytes &&
           left.parserCacheScratchBytes == right.parserCacheScratchBytes &&
           left.frontierParserScratchBytes == right.frontierParserScratchBytes &&
           left.typedFactTransactionBytes == right.typedFactTransactionBytes &&
           left.validationBytes == right.validationBytes &&
           left.frontierOutputPrimaryOwnsStringPayload ==
               right.frontierOutputPrimaryOwnsStringPayload &&
           left.frontierOutputScratchOwnsStringPayload ==
               right.frontierOutputScratchOwnsStringPayload &&
           left.totalBytes == right.totalBytes &&
           left.phasePeakBytes == right.phasePeakBytes &&
           left.phaseSnapshotCount == right.phaseSnapshotCount,
           strutil.Join([" reachability smoke: staging ledger state mismatch ", label], ""))

fn AssertParserTextLookupEqual(left: parser.ParserTextLookup,
                               right: parser.ParserTextLookup,
                               label: str) =
    AssertInt32ArraysEqual(left.slots, right.slots, strutil.Join([label, " slots"], ""))
    assert(left.slots.cap == right.slots.cap &&
           left.buckets.len == right.buckets.len &&
           left.buckets.cap == right.buckets.cap &&
           left.totalCount == right.totalCount,
           strutil.Join([" reachability smoke: parser lookup shape mismatch ", label], ""))
    for bucketIndex in 0..<left.buckets.len:
        let leftBucket = left.buckets[bucketIndex]
        let rightBucket = right.buckets[bucketIndex]
        assert(leftBucket.keyLen == rightBucket.keyLen &&
               leftBucket.firstCode == rightBucket.firstCode &&
               leftBucket.lastCode == rightBucket.lastCode &&
               leftBucket.dotCount == rightBucket.dotCount &&
               leftBucket.textHash == rightBucket.textHash &&
               leftBucket.items.cap == rightBucket.items.cap,
               strutil.Join([" reachability smoke: parser lookup bucket mismatch ", label], ""))
        AssertStrArraysEqual(leftBucket.items,
                             rightBucket.items,
                             strutil.Join([label, " items"], ""))

fn AssertProfileCallLookupCacheEqual(left: ccsg.CompilerCsgProfileCallLookupStore,
                                     right: ccsg.CompilerCsgProfileCallLookupStore,
                                     label: str) =
    AssertInt32ArraysEqual(left.index.slots,
                           right.index.slots,
                           strutil.Join([label, " sparse slots"], ""))
    AssertInt32ArraysEqual(left.index.keys,
                           right.index.keys,
                           strutil.Join([label, " sparse keys"], ""))
    assert(left.index.slots.cap == right.index.slots.cap &&
           left.index.keys.cap == right.index.keys.cap &&
           left.entries.len == right.entries.len &&
           left.entries.cap == right.entries.cap,
           strutil.Join([" reachability smoke: sparse profile cache shape mismatch ", label], ""))
    for row in 0..<left.entries.len:
        AssertParserTextLookupEqual(left.entries[row].localLookup,
                                    right.entries[row].localLookup,
                                    strutil.Join([label, " local"], ""))
        AssertParserTextLookupEqual(left.entries[row].importcLookup,
                                    right.entries[row].importcLookup,
                                    strutil.Join([label, " importc"], ""))

fn SeedProfileCallLookupStore(profiles: parser.NormalizedExprCallProfile[],
                              profileIndex: int32,
                              store: var ccsg.CompilerCsgProfileCallLookupStore) =
    var overlay: ccsg.CompilerCsgProfileCallLookupOverlay
    let row = ccsg.CompilerCsgSparseIntIndexEnsure(overlay.index, profileIndex)
    assert(row == 0,
           " reachability smoke: sparse profile cache seed row conflict")
    add(overlay.entries,
        parser.ParserBuildProfileCallLookups(profiles[profileIndex]))
    ccsg.CompilerCsgProfileCallLookupOverlayCommit(store, profiles, overlay)

fn AssertExprLayerEqual(left: parser.NormalizedExprLayer,
                        right: parser.NormalizedExprLayer,
                        label: str) =
    assert(left.sourceCount == right.sourceCount &&
           left.questionResidualCount == right.questionResidualCount &&
           left.exprs.len == right.exprs.len && left.exprs.cap == right.exprs.cap &&
           left.exprNext.len == right.exprNext.len &&
           left.exprNext.cap == right.exprNext.cap &&
           left.exprLookup.slots.len == right.exprLookup.slots.len &&
           left.exprLookup.slots.cap == right.exprLookup.slots.cap &&
           left.exprLookup.buckets.len == right.exprLookup.buckets.len &&
           left.exprLookup.buckets.cap == right.exprLookup.buckets.cap,
           strutil.Join([" reachability smoke: expr layer shape mismatch ", label], ""))
    AssertInt32ArraysEqual(left.exprNext, right.exprNext, strutil.Join([label, " next"], ""))
    AssertInt32ArraysEqual(left.exprLookup.slots,
                           right.exprLookup.slots,
                           strutil.Join([label, " lookup slots"], ""))
    for bucketIndex in 0..<left.exprLookup.buckets.len:
        let aBucket = left.exprLookup.buckets[bucketIndex]
        let bBucket = right.exprLookup.buckets[bucketIndex]
        assert(aBucket.sourcePathLen == bBucket.sourcePathLen &&
               aBucket.sourcePathFirstCode == bBucket.sourcePathFirstCode &&
               aBucket.sourcePathLastCode == bBucket.sourcePathLastCode &&
               aBucket.lineNumber == bBucket.lineNumber &&
               aBucket.columnNumber == bBucket.columnNumber &&
               aBucket.kindCode == bBucket.kindCode &&
               aBucket.detailCode == bBucket.detailCode &&
               aBucket.surfaceLen == bBucket.surfaceLen &&
               aBucket.surfaceFirstCode == bBucket.surfaceFirstCode &&
               aBucket.surfaceLastCode == bBucket.surfaceLastCode &&
               aBucket.head == bBucket.head && aBucket.pad == bBucket.pad,
               strutil.Join([" reachability smoke: expr lookup bucket mismatch ", label], ""))
    for exprIndex in 0..<left.exprs.len:
        let a = left.exprs[exprIndex]
        let b = right.exprs[exprIndex]
        assert(a.exprId == b.exprId && a.sourcePath == b.sourcePath &&
               a.lineNumber == b.lineNumber && a.columnNumber == b.columnNumber &&
               a.endLineNumber == b.endLineNumber &&
               a.endColumnNumber == b.endColumnNumber && a.kind == b.kind &&
               a.detailKind == b.detailKind && a.surfaceText == b.surfaceText &&
               a.callSurfaceKind == b.callSurfaceKind &&
               a.callResolved == b.callResolved && a.callReason == b.callReason &&
               a.callQualifier == b.callQualifier && a.callCallee == b.callCallee &&
               a.callTarget == b.callTarget &&
               a.callTargetSourcePath == b.callTargetSourcePath &&
               a.callTargetImportc == b.callTargetImportc &&
               a.callPrefixStyle == b.callPrefixStyle &&
               a.callArgCount == b.callArgCount && a.callArgsText == b.callArgsText,
               strutil.Join([" reachability smoke: expr row mismatch ", label], ""))

fn AssertHashMapStrIntEqual(left: hashmaps.HashMapStrInt,
                            right: hashmaps.HashMapStrInt,
                            label: str) =
    AssertStrArraysEqual(left.keys, right.keys, strutil.Join([label, " keys"], ""))
    AssertInt32ArraysEqual(left.vals, right.vals, strutil.Join([label, " vals"], ""))
    AssertUInt64ArraysEqual(left.hashes, right.hashes, strutil.Join([label, " hashes"], ""))
    AssertUInt8ArraysEqual(left.states, right.states, strutil.Join([label, " states"], ""))
    assert(left.keys.cap == right.keys.cap && left.vals.cap == right.vals.cap &&
           left.mask == right.mask && left.used == right.used &&
           left.cacheKeyLen0 == right.cacheKeyLen0 && left.cachePack0 == right.cachePack0 &&
           left.cacheSlot0 == right.cacheSlot0 && left.cacheVal0 == right.cacheVal0 &&
           left.cacheKeyLen1 == right.cacheKeyLen1 && left.cachePack1 == right.cachePack1 &&
           left.cacheSlot1 == right.cacheSlot1 && left.cacheVal1 == right.cacheVal1,
           strutil.Join([" reachability smoke: string map scalar mismatch ", label], ""))

fn AssertHashMapPtrIntEqual(left: hashmaps.HashMapPtrInt,
                            right: hashmaps.HashMapPtrInt,
                            label: str) =
    AssertInt64ArraysEqual(left.keys, right.keys, strutil.Join([label, " keys"], ""))
    AssertInt32ArraysEqual(left.vals, right.vals, strutil.Join([label, " vals"], ""))
    AssertUInt8ArraysEqual(left.states, right.states, strutil.Join([label, " states"], ""))
    assert(left.vals.cap == right.vals.cap &&
           left.mask == right.mask && left.used == right.used,
           strutil.Join([" reachability smoke: native map scalar mismatch ", label], ""))

fn AssertLoweringRuleEqual(left: texpr.TypedExprLoweringRule,
                           right: texpr.TypedExprLoweringRule,
                           label: str) =
    assert(left.exprId == right.exprId && left.sourcePath == right.sourcePath &&
           left.lineNumber == right.lineNumber && left.columnNumber == right.columnNumber &&
           left.surfaceCallKind == right.surfaceCallKind &&
           left.callResolved == right.callResolved && left.callReason == right.callReason &&
           left.callQualifier == right.callQualifier && left.callCallee == right.callCallee &&
           left.callTarget == right.callTarget &&
           left.callTargetSourcePath == right.callTargetSourcePath &&
           left.callTargetImportc == right.callTargetImportc &&
           left.callPrefixStyle == right.callPrefixStyle &&
           left.callArgCount == right.callArgCount &&
           left.callArgsText == right.callArgsText && left.typeText == right.typeText &&
           left.abiClass == right.abiClass && left.valueKind == right.valueKind &&
           left.placeKind == right.placeKind && left.loweringMode == right.loweringMode &&
           left.callKind == right.callKind && left.typeCallKind == right.typeCallKind &&
           left.returnKind == right.returnKind && left.returnRoot == right.returnRoot &&
           left.argPassKind == right.argPassKind &&
           left.resultPassKind == right.resultPassKind &&
           left.materializeKind == right.materializeKind &&
           left.copyKind == right.copyKind && left.importKind == right.importKind,
           strutil.Join([" reachability smoke: lowering rule mismatch ", label], ""))

fn AssertLoweringRuleSetEqual(left: ccsg.CompilerCsgSemanticLoweringRuleSet,
                              right: ccsg.CompilerCsgSemanticLoweringRuleSet,
                              label: str) =
    assert(left.rules.len == right.rules.len && left.rules.cap == right.rules.cap &&
           left.nextIndexes.len == right.nextIndexes.len &&
           left.nextIndexes.cap == right.nextIndexes.cap,
           strutil.Join([" reachability smoke: lowering rule set shape mismatch ", label], ""))
    for ruleIndex in 0..<left.rules.len:
        AssertLoweringRuleEqual(left.rules[ruleIndex],
                                right.rules[ruleIndex],
                                strutil.Join([label, " rule"], ""))
    AssertInt32ArraysEqual(left.nextIndexes,
                           right.nextIndexes,
                           strutil.Join([label, " next"], ""))
    AssertHashMapPtrIntEqual(left.bucketHeads,
                             right.bucketHeads,
                             strutil.Join([label, " buckets"], ""))

fn AssertResolvedCallSetEqual(left: ccsg.CompilerCsgSemanticResolvedCallSet,
                              right: ccsg.CompilerCsgSemanticResolvedCallSet,
                              label: str) =
    AssertInt32ArraysEqual(left.hashIndex.slots,
                           right.hashIndex.slots,
                           strutil.Join([label, " hash slots"], ""))
    AssertInt32ArraysEqual(left.hashIndex.keys,
                           right.hashIndex.keys,
                           strutil.Join([label, " hash keys"], ""))
    AssertInt64ArraysEqual(left.hashSlotCertificates,
                           right.hashSlotCertificates,
                           strutil.Join([label, " hash certificates"], ""))
    AssertInt32ArraysEqual(left.bucketHeads,
                           right.bucketHeads,
                           strutil.Join([label, " bucket heads"], ""))
    AssertInt64ArraysEqual(left.bucketHeadCertificates,
                           right.bucketHeadCertificates,
                           strutil.Join([label, " bucket certificates"], ""))
    AssertInt32ArraysEqual(left.nextIndexes,
                           right.nextIndexes,
                           strutil.Join([label, " next"], ""))
    AssertInt64ArraysEqual(left.nextCertificates,
                           right.nextCertificates,
                           strutil.Join([label, " next certificates"], ""))
    assert(left.hashIndex.slots.cap == right.hashIndex.slots.cap &&
           left.hashIndex.keys.cap == right.hashIndex.keys.cap &&
           left.bucketHeads.cap == right.bucketHeads.cap &&
           left.nextIndexes.cap == right.nextIndexes.cap &&
           left.version == right.version && left.sealedVersion == right.sealedVersion,
           strutil.Join([" reachability smoke: resolved set capacity mismatch ", label], ""))

fn AssertAccumulatorIndexStateEqual(left: ccsg.CompilerCsgSemanticTypedFactAccumulator,
                                    right: ccsg.CompilerCsgSemanticTypedFactAccumulator,
                                    label: str) =
    AssertSourcePathIndexEqual(left.sourceIndexCache,
                               right.sourceIndexCache,
                               strutil.Join([label, " source index"], ""))
    AssertLoweringRuleSetEqual(left.loweringRuleShapes,
                               right.loweringRuleShapes,
                               strutil.Join([label, " shape rules"], ""))
    AssertLoweringRuleSetEqual(left.loweringRuleKeys,
                               right.loweringRuleKeys,
                               strutil.Join([label, " key rules"], ""))
    AssertResolvedCallSetEqual(left.resolvedCallSet,
                               right.resolvedCallSet,
                               strutil.Join([label, " resolved set"], ""))
    assert(left.transactionCommittedBatchCount == right.transactionCommittedBatchCount &&
           left.transactionCommittedFactCount == right.transactionCommittedFactCount &&
           left.transactionMaxStagedFactCount == right.transactionMaxStagedFactCount &&
           left.transactionMaxStagedCapacity == right.transactionMaxStagedCapacity &&
           left.validatedVersion == right.validatedVersion &&
           left.stateVersion == right.stateVersion &&
           left.validatedTypedFactPrefix == right.validatedTypedFactPrefix &&
           left.validatedResolvedCallPrefix == right.validatedResolvedCallPrefix &&
           left.validationFullRowVisitCount == right.validationFullRowVisitCount &&
           left.validationAppendedRowVisitCount == right.validationAppendedRowVisitCount &&
           left.validationTouchedRowVisitCount == right.validationTouchedRowVisitCount &&
           left.active == right.active,
           strutil.Join([" reachability smoke: accumulator scalar mismatch ", label], ""))
    AssertStagingLedgerEqual(left.transactionLastStagingCapacityLedger,
                             right.transactionLastStagingCapacityLedger,
                             strutil.Join([label, " staging ledger"], ""))
    AssertInt64ArraysEqual(left.typedFactRowCertificates,
                           right.typedFactRowCertificates,
                           strutil.Join([label, " typed certificates"], ""))
    AssertInt64ArraysEqual(left.resolvedCallRowCertificates,
                           right.resolvedCallRowCertificates,
                           strutil.Join([label, " resolved certificates"], ""))
    AssertInt64ArraysEqual(left.resolvedFunctionHeadCertificates,
                           right.resolvedFunctionHeadCertificates,
                           strutil.Join([label, " head certificates"], ""))

fn AssertStrArraysEqual(left: str[],
                        right: str[],
                        label: str) =
    assert(left.len == right.len,
           strutil.Join([" reachability smoke: text length mismatch ", label], ""))
    for i in 0..<left.len:
        assert(left[i] == right[i],
               strutil.Join([" reachability smoke: text row mismatch ", label], ""))

fn CloneStrArray(items: str[]): str[] =
    var out: str[]
    for itemIndex in 0..<items.len:
        add(out, items[itemIndex])
    return out

fn CloneImportEdges(items: parser.ImportEdge[]): parser.ImportEdge[] =
    var out: parser.ImportEdge[]
    for itemIndex in 0..<items.len:
        add(out, items[itemIndex])
    return out

fn AssertImportEdgesEqual(left: parser.ImportEdge[],
                          right: parser.ImportEdge[],
                          label: str) =
    assert(left.len == right.len,
           strutil.Join([" reachability smoke: import edge length ", label], ""))
    for edgeIndex in 0..<left.len:
        assert(left[edgeIndex].ownerModulePath == right[edgeIndex].ownerModulePath &&
               left[edgeIndex].targetModulePath == right[edgeIndex].targetModulePath &&
               left[edgeIndex].targetSourcePath == right[edgeIndex].targetSourcePath &&
               left[edgeIndex].targetProfileIndex == right[edgeIndex].targetProfileIndex &&
               left[edgeIndex].importAlias == right[edgeIndex].importAlias &&
               left[edgeIndex].qualifier == right[edgeIndex].qualifier &&
               left[edgeIndex].resolved == right[edgeIndex].resolved,
               strutil.Join([" reachability smoke: import edge row ", label], ""))

fn AssertSourcePathIndexEqual(left: ccsg.CompilerCsgSourcePathIndex,
                              right: ccsg.CompilerCsgSourcePathIndex,
                              label: str) =
    AssertStrArraysEqual(left.roots, right.roots, strutil.Join([label, " roots"], ""))
    AssertInt32ArraysEqual(left.lookup.slots,
                           right.lookup.slots,
                           strutil.Join([label, " slots"], ""))
    AssertInt64ArraysEqual(left.slotCertificates,
                           right.slotCertificates,
                           strutil.Join([label, " slot certificates"], ""))
    AssertInt64ArraysEqual(left.rootCertificates,
                           right.rootCertificates,
                           strutil.Join([label, " root certificates"], ""))
    assert(left.relativeRoot == right.relativeRoot &&
           left.relativeRootCertificate == right.relativeRootCertificate &&
           left.rootsConfigured == right.rootsConfigured &&
           left.domainVersion == right.domainVersion &&
           left.sealedDomainVersion == right.sealedDomainVersion &&
           left.roots.cap == right.roots.cap &&
           left.lookup.slots.cap == right.lookup.slots.cap &&
           left.slotCertificates.cap == right.slotCertificates.cap &&
           left.rootCertificates.cap == right.rootCertificates.cap &&
           left.lookup.buckets.len == right.lookup.buckets.len &&
           left.lookup.buckets.cap == right.lookup.buckets.cap &&
           left.bucketCertificates.len == right.bucketCertificates.len &&
           left.bucketCertificates.cap == right.bucketCertificates.cap,
           strutil.Join([" reachability smoke: source index owner mismatch ", label], ""))
    for bucketIndex in 0..<left.lookup.buckets.len:
        let leftBucket = left.lookup.buckets[bucketIndex]
        let rightBucket = right.lookup.buckets[bucketIndex]
        let leftCertificates = left.bucketCertificates[bucketIndex]
        let rightCertificates = right.bucketCertificates[bucketIndex]
        assert(leftBucket.keyLen == rightBucket.keyLen &&
               leftBucket.firstCode == rightBucket.firstCode &&
               leftBucket.lastCode == rightBucket.lastCode &&
               leftBucket.dotCount == rightBucket.dotCount &&
               leftBucket.sourcePathHash == rightBucket.sourcePathHash &&
               leftBucket.items.len == rightBucket.items.len &&
               leftBucket.items.cap == rightBucket.items.cap &&
               leftCertificates.keyCertificate == rightCertificates.keyCertificate &&
               leftCertificates.itemCertificates.cap ==
                   rightCertificates.itemCertificates.cap,
               strutil.Join([" reachability smoke: source index bucket mismatch ", label], ""))
        AssertInt64ArraysEqual(leftCertificates.itemCertificates,
                               rightCertificates.itemCertificates,
                               strutil.Join([label, " item certificates"], ""))
        for itemIndex in 0..<leftBucket.items.len:
            assert(leftBucket.items[itemIndex].sourcePath == rightBucket.items[itemIndex].sourcePath &&
                   leftBucket.items[itemIndex].profileIndex == rightBucket.items[itemIndex].profileIndex,
                   strutil.Join([" reachability smoke: source index item mismatch ", label], ""))

fn AssertNameIndexEqual(left: ccsg.CompilerCsgNameAdjacencyIndex,
                        right: ccsg.CompilerCsgNameAdjacencyIndex,
                        label: str) =
    AssertInt32ArraysEqual(left.slots, right.slots, strutil.Join([label, " slots"], ""))
    AssertInt64ArraysEqual(left.slotCertificates,
                           right.slotCertificates,
                           strutil.Join([label, " slot certificates"], ""))
    AssertInt32ArraysEqual(left.profileIndexes,
                           right.profileIndexes,
                           strutil.Join([label, " profiles"], ""))
    AssertStrArraysEqual(left.functionNames,
                         right.functionNames,
                         strutil.Join([label, " names"], ""))
    AssertInt32ArraysEqual(left.heads, right.heads, strutil.Join([label, " heads"], ""))
    AssertInt32ArraysEqual(left.tails, right.tails, strutil.Join([label, " tails"], ""))
    AssertInt32ArraysEqual(left.counts, right.counts, strutil.Join([label, " counts"], ""))
    AssertInt64ArraysEqual(left.keyCertificates,
                           right.keyCertificates,
                           strutil.Join([label, " key certificates"], ""))
    AssertBoolArraysEqual(left.functionDeclared,
                          right.functionDeclared,
                          strutil.Join([label, " declared"], ""))
    AssertInt64ArraysEqual(left.functionNodeCertificates,
                           right.functionNodeCertificates,
                           strutil.Join([label, " node certificates"], ""))
    assert(left.hashOperationCount == right.hashOperationCount &&
           left.hashProbeCount == right.hashProbeCount &&
           left.hashMaxProbeCount == right.hashMaxProbeCount &&
           left.slots.cap == right.slots.cap &&
           left.profileIndexes.cap == right.profileIndexes.cap &&
           left.functionNames.cap == right.functionNames.cap &&
           left.heads.cap == right.heads.cap &&
           left.tails.cap == right.tails.cap &&
           left.counts.cap == right.counts.cap &&
           left.functionDeclared.cap == right.functionDeclared.cap,
           strutil.Join([" reachability smoke: name index state mismatch ", label], ""))

fn AssertReachabilityTransactionEqual(left: var ccsg.CompilerCsgReachableFunctionSet,
                                      right: var ccsg.CompilerCsgReachableFunctionSet,
                                      label: str) =
    AssertBoolArraysEqual(left.exportNameExplicitFlags,
                          right.exportNameExplicitFlags,
                          strutil.Join([label, " export flags"], ""))
    AssertStrArraysEqual(left.sourcePaths, right.sourcePaths, strutil.Join([label, " sources"], ""))
    AssertStrArraysEqual(left.functionNames, right.functionNames, strutil.Join([label, " functions"], ""))
    AssertStrArraysEqual(left.symbolTexts, right.symbolTexts, strutil.Join([label, " symbols"], ""))
    AssertStrArraysEqual(left.exportSymbolNames,
                         right.exportSymbolNames,
                         strutil.Join([label, " export symbols"], ""))
    AssertInt32ArraysEqual(left.startLines, right.startLines, strutil.Join([label, " starts"], ""))
    AssertInt32ArraysEqual(left.endLines, right.endLines, strutil.Join([label, " ends"], ""))
    AssertBoolArraysEqual(left.reachable, right.reachable, strutil.Join([label, " reachable"], ""))
    AssertInt32ArraysEqual(left.reachableQueue, right.reachableQueue, strutil.Join([label, " queue"], ""))
    AssertInt32ArraysEqual(left.edgeFrom, right.edgeFrom, strutil.Join([label, " edge from"], ""))
    AssertInt32ArraysEqual(left.edgeTo, right.edgeTo, strutil.Join([label, " edge to"], ""))
    AssertInt32ArraysEqual(left.edgeHeads, right.edgeHeads, strutil.Join([label, " edge heads"], ""))
    AssertInt32ArraysEqual(left.edgeNext, right.edgeNext, strutil.Join([label, " edge next"], ""))
    AssertInt32ArraysEqual(left.edgePairSlots,
                           right.edgePairSlots,
                           strutil.Join([label, " edge pair slots"], ""))
    AssertSourcePathIndexEqual(left.profileSourceIndex,
                               right.profileSourceIndex,
                               strutil.Join([label, " profile source index"], ""))
    AssertInt32ArraysEqual(left.profileFunctionStarts,
                           right.profileFunctionStarts,
                           strutil.Join([label, " profile starts"], ""))
    AssertInt32ArraysEqual(left.profileFunctionCounts,
                           right.profileFunctionCounts,
                           strutil.Join([label, " profile counts"], ""))
    AssertBoolArraysEqual(left.profileLineIndexProven,
                          right.profileLineIndexProven,
                          strutil.Join([label, " profile proofs"], ""))
    AssertInt32ArraysEqual(left.functionProfileIndexes,
                           right.functionProfileIndexes,
                           strutil.Join([label, " function profiles"], ""))
    AssertNameIndexEqual(left.scopedFunctionNames,
                         right.scopedFunctionNames,
                         strutil.Join([label, " scoped index"], ""))
    AssertInt32ArraysEqual(left.scopedFunctionNameNext,
                           right.scopedFunctionNameNext,
                           strutil.Join([label, " scoped next"], ""))
    AssertNameIndexEqual(left.globalFunctionNames,
                         right.globalFunctionNames,
                         strutil.Join([label, " global index"], ""))
    AssertInt32ArraysEqual(left.globalFunctionNameNext,
                           right.globalFunctionNameNext,
                           strutil.Join([label, " global next"], ""))
    AssertInt64ArraysEqual(left.profileRowCertificates,
                           right.profileRowCertificates,
                           strutil.Join([label, " profile certificates"], ""))
    AssertInt64ArraysEqual(left.functionRowCertificates,
                           right.functionRowCertificates,
                           strutil.Join([label, " function certificates"], ""))
    AssertInt64ArraysEqual(left.reachableRowCertificates,
                           right.reachableRowCertificates,
                           strutil.Join([label, " reachable certificates"], ""))
    AssertInt64ArraysEqual(left.reachableQueueCertificates,
                           right.reachableQueueCertificates,
                           strutil.Join([label, " queue certificates"], ""))
    AssertInt64ArraysEqual(left.edgeHeadCertificates,
                           right.edgeHeadCertificates,
                           strutil.Join([label, " edge head certificates"], ""))
    AssertInt64ArraysEqual(left.edgeRowCertificates,
                           right.edgeRowCertificates,
                           strutil.Join([label, " edge certificates"], ""))
    AssertInt64ArraysEqual(left.edgePairSlotCertificates,
                           right.edgePairSlotCertificates,
                           strutil.Join([label, " edge slot certificates"], ""))
    assert(left.keepExportedSymbolNodes == right.keepExportedSymbolNodes &&
           left.active == right.active &&
           left.reachableCount == right.reachableCount &&
           left.scopedFunctionNames.hashOperationCount == right.scopedFunctionNames.hashOperationCount &&
           left.scopedFunctionNames.hashProbeCount == right.scopedFunctionNames.hashProbeCount &&
           left.scopedFunctionNames.hashMaxProbeCount == right.scopedFunctionNames.hashMaxProbeCount &&
           left.globalFunctionNames.hashOperationCount == right.globalFunctionNames.hashOperationCount &&
           left.globalFunctionNames.hashProbeCount == right.globalFunctionNames.hashProbeCount &&
           left.globalFunctionNames.hashMaxProbeCount == right.globalFunctionNames.hashMaxProbeCount &&
           left.lineBinarySearchOperationCount == right.lineBinarySearchOperationCount &&
           left.lineBinarySearchProbeCount == right.lineBinarySearchProbeCount &&
           left.lineBinarySearchMaxProbeCount == right.lineBinarySearchMaxProbeCount &&
           left.edgePairOperationCount == right.edgePairOperationCount &&
           left.edgePairProbeCount == right.edgePairProbeCount &&
           left.edgePairMaxProbeCount == right.edgePairMaxProbeCount &&
           left.resolvedCallRowVisitCount == right.resolvedCallRowVisitCount &&
           left.structureVersion == right.structureVersion &&
           left.structureSealedVersion == right.structureSealedVersion &&
           left.structureShapeSeal == right.structureShapeSeal &&
           left.structureContentCertificate == right.structureContentCertificate &&
           left.graphVersion == right.graphVersion &&
           left.graphSealedVersion == right.graphSealedVersion &&
           left.graphShapeSeal == right.graphShapeSeal &&
           left.graphContentCertificate == right.graphContentCertificate &&
           left.certificateBuildOperationCount == right.certificateBuildOperationCount &&
           left.certificateValidationOperationCount == right.certificateValidationOperationCount &&
           left.exportNameExplicitFlags.cap == right.exportNameExplicitFlags.cap &&
           left.sourcePaths.cap == right.sourcePaths.cap &&
           left.functionNames.cap == right.functionNames.cap &&
           left.symbolTexts.cap == right.symbolTexts.cap &&
           left.exportSymbolNames.cap == right.exportSymbolNames.cap &&
           left.startLines.cap == right.startLines.cap &&
           left.endLines.cap == right.endLines.cap &&
           left.reachable.cap == right.reachable.cap &&
           left.reachableQueue.cap == right.reachableQueue.cap &&
           left.edgeFrom.cap == right.edgeFrom.cap &&
           left.edgeTo.cap == right.edgeTo.cap &&
           left.edgeHeads.cap == right.edgeHeads.cap &&
           left.edgeNext.cap == right.edgeNext.cap &&
           left.edgePairSlots.cap == right.edgePairSlots.cap &&
           left.profileFunctionStarts.cap == right.profileFunctionStarts.cap &&
           left.profileFunctionCounts.cap == right.profileFunctionCounts.cap &&
           left.profileLineIndexProven.cap == right.profileLineIndexProven.cap &&
           left.functionProfileIndexes.cap == right.functionProfileIndexes.cap &&
           left.scopedFunctionNameNext.cap == right.scopedFunctionNameNext.cap &&
           left.globalFunctionNameNext.cap == right.globalFunctionNameNext.cap,
           strutil.Join([" reachability smoke: transaction counters mismatch ", label], ""))
    AssertStagingLedgerEqual(left.lastProfileScanStaging,
                             right.lastProfileScanStaging,
                             strutil.Join([label, " profile staging"], ""))
    assert(left.structureContentCertificate ==
               ccsg.CompilerCsgReachableStructureContentCertificate(left) &&
           right.structureContentCertificate ==
               ccsg.CompilerCsgReachableStructureContentCertificate(right) &&
           left.graphContentCertificate ==
               ccsg.CompilerCsgReachableGraphContentCertificate(left) &&
           right.graphContentCertificate ==
               ccsg.CompilerCsgReachableGraphContentCertificate(right),
           strutil.Join([" reachability smoke: certificate aggregate drift ", label], ""))

fn AssertFrontierIndexEqual(left: ccsg.CompilerCsgFrontierIndex,
                            right: ccsg.CompilerCsgFrontierIndex,
                            label: str) =
    AssertInt32ArraysEqual(left.profileFunctionHeads,
                           right.profileFunctionHeads,
                           strutil.Join([label, " profile heads"], ""))
    AssertInt32ArraysEqual(left.profileFunctionTails,
                           right.profileFunctionTails,
                           strutil.Join([label, " profile tails"], ""))
    AssertInt32ArraysEqual(left.functionNext,
                           right.functionNext,
                           strutil.Join([label, " function next"], ""))
    AssertBoolArraysEqual(left.functionSelected,
                          right.functionSelected,
                          strutil.Join([label, " function selected"], ""))
    AssertBoolArraysEqual(left.profileSelected,
                          right.profileSelected,
                          strutil.Join([label, " profile selected"], ""))
    AssertInt32ArraysEqual(left.selectedProfiles,
                           right.selectedProfiles,
                           strutil.Join([label, " selected profiles"], ""))
    AssertInt32ArraysEqual(left.touchedFunctions,
                           right.touchedFunctions,
                           strutil.Join([label, " touched functions"], ""))
    AssertInt32ArraysEqual(left.exprStarts,
                           right.exprStarts,
                           strutil.Join([label, " expr starts"], ""))
    AssertInt32ArraysEqual(left.exprEnds,
                           right.exprEnds,
                           strutil.Join([label, " expr ends"], ""))
    AssertInt32ArraysEqual(left.factStarts,
                           right.factStarts,
                           strutil.Join([label, " fact starts"], ""))
    AssertInt32ArraysEqual(left.factEnds,
                           right.factEnds,
                           strutil.Join([label, " fact ends"], ""))
    AssertInt32ArraysEqual(left.retainedExprHeads,
                           right.retainedExprHeads,
                           strutil.Join([label, " retained heads"], ""))
    AssertInt32ArraysEqual(left.retainedExprTails,
                           right.retainedExprTails,
                           strutil.Join([label, " retained tails"], ""))
    AssertInt32ArraysEqual(left.retainedExprNext,
                           right.retainedExprNext,
                           strutil.Join([label, " retained next"], ""))
    AssertInt64ArraysEqual(left.profileRowCertificates,
                           right.profileRowCertificates,
                           strutil.Join([label, " profile certificates"], ""))
    AssertInt64ArraysEqual(left.functionRowCertificates,
                           right.functionRowCertificates,
                           strutil.Join([label, " function certificates"], ""))
    AssertInt64ArraysEqual(left.retainedRowCertificates,
                           right.retainedRowCertificates,
                           strutil.Join([label, " retained certificates"], ""))
    AssertInt64ArraysEqual(left.selectedProfileListCertificates,
                           right.selectedProfileListCertificates,
                           strutil.Join([label, " selected-list certificates"], ""))
    AssertInt64ArraysEqual(left.touchedFunctionListCertificates,
                           right.touchedFunctionListCertificates,
                           strutil.Join([label, " touched-list certificates"], ""))
    assert(left.retainedExprBuiltCount == right.retainedExprBuiltCount &&
           left.domainVersion == right.domainVersion &&
           left.sealedDomainVersion == right.sealedDomainVersion &&
           left.retainedValidatedPrefix == right.retainedValidatedPrefix &&
           left.certificateBuildOperationCount == right.certificateBuildOperationCount &&
           left.certificateValidationOperationCount == right.certificateValidationOperationCount &&
           left.queryOperationCount == right.queryOperationCount &&
           left.profileFunctionHeads.cap == right.profileFunctionHeads.cap &&
           left.profileFunctionTails.cap == right.profileFunctionTails.cap &&
           left.functionNext.cap == right.functionNext.cap &&
           left.functionSelected.cap == right.functionSelected.cap &&
           left.profileSelected.cap == right.profileSelected.cap &&
           left.selectedProfiles.cap == right.selectedProfiles.cap &&
           left.touchedFunctions.cap == right.touchedFunctions.cap &&
           left.exprStarts.cap == right.exprStarts.cap &&
           left.exprEnds.cap == right.exprEnds.cap &&
           left.factStarts.cap == right.factStarts.cap &&
           left.factEnds.cap == right.factEnds.cap &&
           left.retainedExprHeads.cap == right.retainedExprHeads.cap &&
           left.retainedExprTails.cap == right.retainedExprTails.cap &&
           left.retainedExprNext.cap == right.retainedExprNext.cap &&
           left.profileRowCertificates.cap == right.profileRowCertificates.cap &&
           left.functionRowCertificates.cap == right.functionRowCertificates.cap &&
           left.retainedRowCertificates.cap == right.retainedRowCertificates.cap &&
           left.selectedProfileListCertificates.cap ==
               right.selectedProfileListCertificates.cap &&
           left.touchedFunctionListCertificates.cap ==
               right.touchedFunctionListCertificates.cap,
           strutil.Join([" reachability smoke: frontier capacity mismatch ", label], ""))
    AssertStagingLedgerEqual(left.lastStagingCapacity,
                             right.lastStagingCapacity,
                             strutil.Join([label, " staging"], ""))

fn TypedFactSummaryCounterTotal(summary: ccsg.CompilerCsgSemanticTypedFactSummary): int64 =
    var total: int64
    total = total + Int64(summary.surfaceCallCount)
    total = total + Int64(summary.callResolvedCount)
    total = total + Int64(summary.callUnresolvedCount)
    total = total + Int64(summary.surfaceCallLocalCount)
    total = total + Int64(summary.surfaceCallExternalCount)
    total = total + Int64(summary.surfaceCallImportcCount)
    total = total + Int64(summary.surfaceCallMemberCount)
    total = total + Int64(summary.callTargetImportcCount)
    total = total + Int64(summary.callReasonUnknownQualifiedTargetCount)
    total = total + Int64(summary.callReasonShadowedQualifiedTargetCount)
    total = total + Int64(summary.callReasonAmbiguousExternalTargetCount)
    total = total + Int64(summary.callReasonAmbiguousQualifiedTargetCount)
    total = total + Int64(summary.callReasonUnknownExternalTargetCount)
    total = total + Int64(summary.callReasonUnknownCallTargetCount)
