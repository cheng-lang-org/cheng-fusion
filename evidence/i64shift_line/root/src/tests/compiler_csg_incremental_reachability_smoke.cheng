fn AssertStructuredNameIndex() =
    var index = ccsg.CompilerCsgReachableNameIndexInit(2)
    var nextIndexes: int32[]
    ccsg.CompilerCsgReachableNameIndexAppend(index, nextIndexes, 0, "Target", 0)
    ccsg.CompilerCsgReachableNameIndexAppend(index, nextIndexes, 1, "Target", 1)
    ccsg.CompilerCsgReachableNameIndexAppend(index, nextIndexes, 0, "Target", 2)
    var profile0Count: int32
    let profile0Head = ccsg.CompilerCsgReachableNameIndexLookup(index,
                                                               0,
                                                               "Target",
                                                               profile0Count)
    var profile1Count: int32
    let profile1Head = ccsg.CompilerCsgReachableNameIndexLookup(index,
                                                               1,
                                                               "Target",
                                                               profile1Count)
    var missingCount: int32
    let missingHead = ccsg.CompilerCsgReachableNameIndexLookup(index,
                                                              2,
                                                              "Target",
                                                              missingCount)
    assert(profile0Head == 0 && profile0Count == 2 && nextIndexes[0] == 2 &&
           profile1Head == 1 && profile1Count == 1 && nextIndexes[1] == -1 &&
           missingHead == -1 && missingCount == 0 &&
           index.profileIndexes.len == 2 && index.functionNames.len == 2 &&
           index.functionDeclared.len == 3 &&
           index.functionDeclared[0] && index.functionDeclared[1] &&
           index.functionDeclared[2] &&
           index.hashOperationCount > Int64(0) &&
           index.hashProbeCount >= index.hashOperationCount,
           " reachability smoke: structured profile/name index")

fn AssertTypedIrIndexedFrontierExpansion(sourcePath: str) =
    var set: ccsg.CompilerCsgReachableFunctionSet
    InitReachableSet(sourcePath, set)
    let targetIndex = AddReachableFunction(sourcePath,
                                           "[]=",
                                           9,
                                           12,
                                           false,
                                           set)
    SealReachableFixture(set, "indexed frontier")
    var ir: texpr.TypedExprIr
    BuildDirectCallTypedIr(sourcePath, texpr.CallSurfaceIndexed, ir)
    var resolvedCalls = EmptyResolvedCalls(set.functionNames.len)
    var statementCursor: int32
    var functionCursor: int32
    var err: str
    assert(!set.reachable[targetIndex] &&
           ccsg.CompilerCsgReachableExpandFromTypedIr(set,
                                                      ir,
                                                      resolvedCalls,
                                                      statementCursor,
                                                      functionCursor,
                                                      err),
           strutil.Join([" reachability smoke: indexed TypedIR frontier ", err], ""))
    assert(set.reachable[targetIndex] &&
           set.edgeFrom.len == 1 &&
           set.edgeFrom[0] == 0 &&
           set.edgeTo[0] == targetIndex &&
           statementCursor == 1 &&
           functionCursor == 1,
           " reachability smoke: Indexed surface expands frontier without facts/profile scan")
    ccsg.CompilerCsgSemanticResolvedCallTableRelease(resolvedCalls)
    texpr.TypedExprIrReleasePayload(ir)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(set)

fn AssertTypedIrOwnerAndSurfaceContracts(sourcePath: str) =
    var ownerSet: ccsg.CompilerCsgReachableFunctionSet
    InitReachableSet(sourcePath, ownerSet)
    let ownerTargetIndex = AddReachableFunction(sourcePath, "[]=", 9, 12, false, ownerSet)
    assert(ownerTargetIndex == 1,
           " reachability smoke: owner target index")
    ownerSet.reachable[0] = false
    ownerSet.reachableCount = 0
    ownerSet.reachableQueue = []
    SealReachableFixture(ownerSet, "unreachable owner")
    var ownerIr: texpr.TypedExprIr
    BuildDirectCallTypedIr(sourcePath, texpr.CallSurfaceIndexed, ownerIr)
    var ownerResolved = EmptyResolvedCalls(ownerSet.functionNames.len)
    var ownerStatementCursor: int32
    var ownerFunctionCursor: int32
    var ownerErr: str
    assert(!ccsg.CompilerCsgReachableExpandFromTypedIr(ownerSet,
                                                       ownerIr,
                                                       ownerResolved,
                                                       ownerStatementCursor,
                                                       ownerFunctionCursor,
                                                       ownerErr) &&
           strings.StrContains(ownerErr, "owner not reachable invariant") &&
           ownerStatementCursor == 0 && ownerFunctionCursor == 0 &&
           !ownerSet.reachable[ownerTargetIndex],
           strutil.Join([" reachability smoke: unreachable owner contract ", ownerErr], ""))
    ccsg.CompilerCsgSemanticResolvedCallTableRelease(ownerResolved)
    texpr.TypedExprIrReleasePayload(ownerIr)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(ownerSet)

    var surfaceSet: ccsg.CompilerCsgReachableFunctionSet
    InitReachableSet(sourcePath, surfaceSet)
    let surfaceTargetIndex = AddReachableFunction(sourcePath, "[]=", 9, 12, false, surfaceSet)
    assert(surfaceTargetIndex == 1,
           " reachability smoke: surface target index")
    SealReachableFixture(surfaceSet, "surface contract")
    var surfaceIr: texpr.TypedExprIr
    BuildDirectCallTypedIr(sourcePath, texpr.CallSurfacePartialCall, surfaceIr)
    var surfaceResolved = EmptyResolvedCalls(surfaceSet.functionNames.len)
    var surfaceStatementCursor: int32
    var surfaceFunctionCursor: int32
    var surfaceErr: str
    assert(!ccsg.CompilerCsgReachableExpandFromTypedIr(surfaceSet,
                                                       surfaceIr,
                                                       surfaceResolved,
                                                       surfaceStatementCursor,
                                                       surfaceFunctionCursor,
                                                       surfaceErr) &&
           strings.StrContains(surfaceErr, "surface unresolved") &&
           surfaceStatementCursor == 0 && surfaceFunctionCursor == 0 &&
           !surfaceSet.reachable[surfaceTargetIndex],
           strutil.Join([" reachability smoke: structured surface contract ", surfaceErr], ""))
    ccsg.CompilerCsgSemanticResolvedCallTableRelease(surfaceResolved)
    texpr.TypedExprIrReleasePayload(surfaceIr)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(surfaceSet)

fn InitTwoCallReachability(sourcePath: str,
                           set: var ccsg.CompilerCsgReachableFunctionSet) =
    InitReachableSet(sourcePath, set)
    let targetA = AddReachableFunction(sourcePath, "TargetA", 9, 12, false, set)
    let targetB = AddReachableFunction(sourcePath, "TargetB", 13, 16, false, set)
    assert(targetA == 1 && targetB == 2,
           " reachability smoke: two-call target indexes")
    SealReachableFixture(set, "two-call")

fn AssertTypedFactsAddressFailureAtomic(sourcePath: str) =
    var failedSet: ccsg.CompilerCsgReachableFunctionSet
    InitTwoCallReachability(sourcePath, failedSet)
    var untouchedSet: ccsg.CompilerCsgReachableFunctionSet
    InitTwoCallReachability(sourcePath, untouchedSet)
    var malformedFacts: texpr.TypedExprFactTable
    AppendExecutableFact(malformedFacts,
                         sourcePath,
                         2,
                         "DamagedCall",
                         "",
                         "&TargetA")
    var err: str
    assert(!ccsg.CompilerCsgReachableExpandFromTypedFacts(failedSet,
                                                          malformedFacts,
                                                          err) &&
           strings.StrContains(err, "target empty"),
           strutil.Join([" reachability smoke: typed fact address late failure ", err], ""))
    AssertReachabilityTransactionEqual(failedSet,
                                       untouchedSet,
                                       "typed fact address failure atomic")

    var correctedFacts: texpr.TypedExprFactTable
    AppendExecutableFact(correctedFacts,
                         sourcePath,
                         2,
                         "TargetB",
                         "TargetB",
                         "&TargetA")
    assert(ccsg.CompilerCsgReachableExpandFromTypedFacts(failedSet,
                                                         correctedFacts,
                                                         err),
           strutil.Join([" reachability smoke: typed fact address retry ", err], ""))
    assert(failedSet.reachable[1] && failedSet.reachable[2] &&
           failedSet.edgeFrom.len == 2 && failedSet.edgeTo.len == 2,
           " reachability smoke: typed fact address retry commits once")
    texpr.TypedExprFactTableRelease(malformedFacts)
    texpr.TypedExprFactTableRelease(correctedFacts)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(failedSet)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(untouchedSet)

fn AssertReachabilityContentCertificates(sourcePath: str) =
    var facts: texpr.TypedExprFactTable
    AppendExecutableFact(facts, sourcePath, 2, "TargetA", "TargetA", "")

    var nameSet: ccsg.CompilerCsgReachableFunctionSet
    InitTwoCallReachability(sourcePath, nameSet)
    var nameControl: ccsg.CompilerCsgReachableFunctionSet
    InitTwoCallReachability(sourcePath, nameControl)
    var targetKeyIndex: int32 = -1
    for keyIndex in 0..<nameSet.scopedFunctionNames.functionNames.len:
        if nameSet.scopedFunctionNames.functionNames[keyIndex] == "TargetA":
            targetKeyIndex = keyIndex
            break
    assert(targetKeyIndex >= 0,
           " reachability smoke: target name-index key missing")
    nameSet.scopedFunctionNames.functionNames[targetKeyIndex] = "XargetA"
    nameControl.scopedFunctionNames.functionNames[targetKeyIndex] = "XargetA"
    var nameErr: str
    assert(!ccsg.CompilerCsgReachableExpandFromTypedFacts(nameSet, facts, nameErr) &&
           strings.StrContains(nameErr, "content certificate mismatch"),
           strutil.Join([" reachability smoke: same-length name-index mutation ", nameErr], ""))
    AssertReachabilityTransactionEqual(nameSet,
                                       nameControl,
                                       "same-length name-index mutation atomic")

    var reachableSet: ccsg.CompilerCsgReachableFunctionSet
    InitTwoCallReachability(sourcePath, reachableSet)
    var reachableControl: ccsg.CompilerCsgReachableFunctionSet
    InitTwoCallReachability(sourcePath, reachableControl)
    reachableSet.reachable[0] = false
    reachableControl.reachable[0] = false
    var reachableErr: str
    assert(!ccsg.CompilerCsgReachableExpandFromTypedFacts(reachableSet,
                                                          facts,
                                                          reachableErr) &&
           strings.StrContains(reachableErr, "content certificate mismatch"),
           strutil.Join([" reachability smoke: reachable-row mutation ", reachableErr], ""))
    AssertReachabilityTransactionEqual(reachableSet,
                                       reachableControl,
                                       "reachable-row mutation atomic")

    var edgeSet: ccsg.CompilerCsgReachableFunctionSet
    InitTwoCallReachability(sourcePath, edgeSet)
    var edgeControl: ccsg.CompilerCsgReachableFunctionSet
    InitTwoCallReachability(sourcePath, edgeControl)
    ccsg.CompilerCsgReachableAddEdge(edgeSet, 1, 2)
    ccsg.CompilerCsgReachableAddEdge(edgeControl, 1, 2)
    edgeSet.edgeTo[0] = 1
    edgeControl.edgeTo[0] = 1
    var edgeErr: str
    assert(!ccsg.CompilerCsgReachableExpandFromTypedFacts(edgeSet, facts, edgeErr) &&
           strings.StrContains(edgeErr, "content certificate mismatch"),
           strutil.Join([" reachability smoke: edge-row mutation ", edgeErr], ""))
    AssertReachabilityTransactionEqual(edgeSet,
                                       edgeControl,
                                       "edge-row mutation atomic")
    edgeSet.edgeTo[0] = 2
    edgeControl.edgeTo[0] = 2
    var edgeControlErr: str
    assert(ccsg.CompilerCsgReachableExpandFromTypedFacts(edgeSet, facts, edgeErr) &&
           ccsg.CompilerCsgReachableExpandFromTypedFacts(edgeControl,
                                                         facts,
                                                         edgeControlErr),
           strutil.Join([" reachability smoke: edge-row mutation retry ",
                         edgeErr, edgeControlErr], ""))
    AssertReachabilityTransactionEqual(edgeSet,
                                       edgeControl,
                                       "edge-row mutation retry equals clean")
    texpr.TypedExprFactTableRelease(facts)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(nameSet)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(nameControl)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(reachableSet)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(reachableControl)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(edgeSet)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(edgeControl)

fn AssertProfileSourceIndexContentCertificate(sourcePath: str) =
    var set: ccsg.CompilerCsgReachableFunctionSet
    InitTwoCallReachability(sourcePath, set)
    var profileIndex: int32
    var err: str
    assert(ccsg.CompilerCsgSourcePathIndexFind(set.profileSourceIndex,
                                               sourcePath,
                                               profileIndex,
                                               err) &&
           profileIndex == 0,
           strutil.Join([" reachability smoke: profile source lookup seed ", err], ""))
    var targetBucket: int32 = -1
    var targetItem: int32 = -1
    for bucketIndex in 0..<set.profileSourceIndex.lookup.buckets.len:
        let bucket = set.profileSourceIndex.lookup.buckets[bucketIndex]
        for itemIndex in 0..<bucket.items.len:
            if bucket.items[itemIndex].profileIndex == profileIndex:
                targetBucket = bucketIndex
                targetItem = itemIndex
                break
        if targetBucket >= 0:
            break
    assert(targetBucket >= 0 && targetItem >= 0,
           " reachability smoke: profile source certificate item missing")
    let domainVersionBefore = set.profileSourceIndex.domainVersion
    let slotCapacityBefore = set.profileSourceIndex.lookup.slots.cap
    let bucketCapacityBefore = set.profileSourceIndex.lookup.buckets.cap
    var bucket = set.profileSourceIndex.lookup.buckets[targetBucket]
    var item = bucket.items[targetItem]
    let originalPath = item.sourcePath
    assert(originalPath.len > 1,
           " reachability smoke: profile source mutation path too short")
    let replacement = originalPath[0] == 'X' ? "Y" : "X"
    item.sourcePath = strutil.Join([replacement,
                                    strings.SliceBytes(originalPath,
                                                       1,
                                                       originalPath.len - 1)], "")
    assert(item.sourcePath.len == originalPath.len,
           " reachability smoke: profile source mutation changed length")
    bucket.items[targetItem] = item
    set.profileSourceIndex.lookup.buckets[targetBucket] = bucket
    assert(!ccsg.CompilerCsgSourcePathIndexFind(set.profileSourceIndex,
                                                sourcePath,
                                                profileIndex,
                                                err) &&
           strings.StrContains(err, "item certificate mismatch") &&
           set.profileSourceIndex.domainVersion == domainVersionBefore &&
           set.profileSourceIndex.lookup.slots.cap == slotCapacityBefore &&
           set.profileSourceIndex.lookup.buckets.cap == bucketCapacityBefore,
           strutil.Join([" reachability smoke: same-length profile source mutation ",
                         err], ""))
    item.sourcePath = originalPath
    bucket.items[targetItem] = item
    set.profileSourceIndex.lookup.buckets[targetBucket] = bucket
    assert(ccsg.CompilerCsgSourcePathIndexFind(set.profileSourceIndex,
                                               sourcePath,
                                               profileIndex,
                                               err) &&
           profileIndex == 0,
           strutil.Join([" reachability smoke: profile source mutation retry ", err], ""))
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(set)

fn AddAccumulatorPaddingFunctions(sourcePath: str,
                                  set: var ccsg.CompilerCsgReachableFunctionSet) =
    for paddingIndex in 0..<64:
        let functionName = strutil.Join(["Padding", strings.IntToStr(paddingIndex)], "")
        let startLine = 100 + paddingIndex * 4
        let _ = AddReachableFunction(sourcePath,
                                     functionName,
                                     startLine,
                                     startLine + 3,
                                     false,
                                     set)
    SealReachableFixture(set, "accumulator padding")

fn AssertDuplicateEdgeRehashKeepsGraphSeal(sourcePath: str) =
    var set: ccsg.CompilerCsgReachableFunctionSet
    InitTwoCallReachability(sourcePath, set)
    AddAccumulatorPaddingFunctions(sourcePath, set)
    for targetIndex in 1..<45:
        ccsg.CompilerCsgReachableAddEdge(set, 0, targetIndex)
    assert(set.edgeFrom.len == 44 && set.edgePairSlots.len == 64 &&
           ccsg.CompilerCsgReachableGraphSealValid(set),
           " reachability smoke: duplicate-edge rehash precondition")
    ccsg.CompilerCsgReachableAddEdge(set, 0, 1)
    assert(set.edgeFrom.len == 44 && set.edgeTo.len == 44 &&
           set.edgePairSlots.len == 128 &&
           ccsg.CompilerCsgReachableGraphSealValid(set) &&
           set.graphContentCertificate ==
               ccsg.CompilerCsgReachableGraphContentCertificate(set),
           " reachability smoke: duplicate edge rehash left stale graph seal")
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(set)

fn AssertTypedFactAccumulatorBatchAtomicRetry(sourcePath: str) =
    var set: ccsg.CompilerCsgReachableFunctionSet
    InitTwoCallReachability(sourcePath, set)
    AddAccumulatorPaddingFunctions(sourcePath, set)
    var untouchedSet: ccsg.CompilerCsgReachableFunctionSet
    InitTwoCallReachability(sourcePath, untouchedSet)
    AddAccumulatorPaddingFunctions(sourcePath, untouchedSet)

    var sourceIndex = ccsg.CompilerCsgSourcePathIndexInit(4)
    ConfigureSmokeSourceIndex(sourceIndex)
    var sourceIndexErr: str
    assert(ccsg.CompilerCsgSourcePathIndexRegister(sourceIndex,
                                                   sourcePath,
                                                   0,
                                                   sourceIndexErr),
           strutil.Join([" reachability smoke: accumulator source index ", sourceIndexErr], ""))
    var semanticGraph: ccsg.CompilerCsgSemanticGraph
    semanticGraph.sourceTable.sourcePaths = [sourcePath]
    var accumulator = ccsg.CompilerCsgSemanticTypedFactAccumulatorInit(semanticGraph,
                                                                  sourceIndex,
                                                                  set.functionNames.len)
    var controlSourceIndex = ccsg.CompilerCsgSourcePathIndexInit(4)
    ConfigureSmokeSourceIndex(controlSourceIndex)
    var controlSourceErr: str
    assert(ccsg.CompilerCsgSourcePathIndexRegister(controlSourceIndex,
                                                   sourcePath,
                                                   0,
                                                   controlSourceErr),
           strutil.Join([" reachability smoke: accumulator control source index ", controlSourceErr], ""))
    var controlSemanticGraph: ccsg.CompilerCsgSemanticGraph
    controlSemanticGraph.sourceTable.sourcePaths = [sourcePath]
    var controlAccumulator = ccsg.CompilerCsgSemanticTypedFactAccumulatorInit(controlSemanticGraph,
                                                                         controlSourceIndex,
                                                                         set.functionNames.len)
    let typedSourceCapacityBefore = semanticGraph.typedFactTable.sourceIndexes.cap
    let resolvedHeadCapacityBefore = semanticGraph.resolvedCallTable.functionRowHeads.cap
    let resolvedInternCapacityBefore = semanticGraph.resolvedCallTable.internPool.texts.cap
    let shapeRuleCapacityBefore = accumulator.loweringRuleShapes.rules.cap
    let shapeNextCapacityBefore = accumulator.loweringRuleShapes.nextIndexes.cap
    let shapeBucketKeysCapacityBefore = accumulator.loweringRuleShapes.bucketHeads.keys.cap
    let shapeBucketValsCapacityBefore = accumulator.loweringRuleShapes.bucketHeads.vals.cap
    let shapeBucketStatesCapacityBefore = accumulator.loweringRuleShapes.bucketHeads.states.cap
    let shapeBucketMaskBefore = accumulator.loweringRuleShapes.bucketHeads.mask
    let keyRuleCapacityBefore = accumulator.loweringRuleKeys.rules.cap
    let keyNextCapacityBefore = accumulator.loweringRuleKeys.nextIndexes.cap
    let keyBucketKeysCapacityBefore = accumulator.loweringRuleKeys.bucketHeads.keys.cap
    let keyBucketValsCapacityBefore = accumulator.loweringRuleKeys.bucketHeads.vals.cap
    let keyBucketStatesCapacityBefore = accumulator.loweringRuleKeys.bucketHeads.states.cap
    let keyBucketMaskBefore = accumulator.loweringRuleKeys.bucketHeads.mask
    let resolvedSetNextCapacityBefore = accumulator.resolvedCallSet.nextIndexes.cap
    let resolvedHashSlotsCapacityBefore = accumulator.resolvedCallSet.hashIndex.slots.cap
    let resolvedHashKeysCapacityBefore = accumulator.resolvedCallSet.hashIndex.keys.cap
    let resolvedBucketHeadsCapacityBefore = accumulator.resolvedCallSet.bucketHeads.cap
    let resolvedBucketCertificatesCapacityBefore =
        accumulator.resolvedCallSet.bucketHeadCertificates.cap
    let resolvedHashCertificatesCapacityBefore =
        accumulator.resolvedCallSet.hashSlotCertificates.cap
    let resolvedNextCertificatesCapacityBefore =
        accumulator.resolvedCallSet.nextCertificates.cap
    let semanticGraphLogicalBytesBefore = ccsg.CompilerCsgSemanticDynamicSequenceBytes(semanticGraph, false)
    let semanticGraphRetainedBytesBefore = ccsg.CompilerCsgSemanticDynamicSequenceBytes(semanticGraph, true)

    var malformedFacts: texpr.TypedExprFactTable
    AppendExecutableFact(malformedFacts, sourcePath, 2, "TargetA", "TargetA", "")
    AppendExecutableFact(malformedFacts, sourcePath, 3, "DamagedCall", "", "")
    var err: str
    assert(!ccsg.CompilerCsgSemanticTypedFactAccumulatorAppend(semanticGraph,
                                                         accumulator,
                                                         set,
                                                         0,
                                                         malformedFacts,
                                                         0,
                                                         malformedFacts.count,
                                                         err) &&
           strings.StrContains(err, "target empty"),
           strutil.Join([" reachability smoke: accumulator late failure ", err], ""))
    AssertReachabilityTransactionEqual(set,
                                       untouchedSet,
                                       "accumulator failure counters atomic")
    AssertTypedFactSummaryEqual(semanticGraph.typedFactTable.summary,
                                controlSemanticGraph.typedFactTable.summary,
                                "accumulator late failure")
    AssertAccumulatorIndexStateEqual(accumulator,
                                     controlAccumulator,
                                     "accumulator late failure")
    assert(semanticGraph.typedFactTable.sourceIndexes.len == 0 &&
           semanticGraph.typedFactTable.sourceIndexes.cap == typedSourceCapacityBefore &&
           semanticGraph.typedFactTable.typeCallDefaultInitCount == 0 &&
           semanticGraph.typedFactTable.typeCallConstructorCount == 0 &&
           TypedFactSummaryCounterTotal(semanticGraph.typedFactTable.summary) == Int64(0),
           " reachability smoke: accumulator failure polluted semantic graph columns or intern owner")
    AssertEmptyResolvedCallTableExact(semanticGraph.resolvedCallTable,
                                      set.functionNames.len,
                                      resolvedHeadCapacityBefore,
                                      resolvedInternCapacityBefore,
                                      "accumulator late failure")
    assert(accumulator.active &&
           accumulator.loweringRuleShapes.rules.len == 0 &&
           accumulator.loweringRuleShapes.rules.cap == shapeRuleCapacityBefore &&
           accumulator.loweringRuleShapes.nextIndexes.len == 0 &&
           accumulator.loweringRuleShapes.nextIndexes.cap == shapeNextCapacityBefore &&
           accumulator.loweringRuleShapes.bucketHeads.used == 0 &&
           accumulator.loweringRuleShapes.bucketHeads.keys.cap == shapeBucketKeysCapacityBefore &&
           accumulator.loweringRuleShapes.bucketHeads.vals.cap == shapeBucketValsCapacityBefore &&
           accumulator.loweringRuleShapes.bucketHeads.states.cap == shapeBucketStatesCapacityBefore &&
           accumulator.loweringRuleShapes.bucketHeads.mask == shapeBucketMaskBefore &&
           accumulator.loweringRuleKeys.rules.len == 0 &&
           accumulator.loweringRuleKeys.rules.cap == keyRuleCapacityBefore &&
           accumulator.loweringRuleKeys.nextIndexes.len == 0 &&
           accumulator.loweringRuleKeys.nextIndexes.cap == keyNextCapacityBefore &&
           accumulator.loweringRuleKeys.bucketHeads.used == 0 &&
           accumulator.loweringRuleKeys.bucketHeads.keys.cap == keyBucketKeysCapacityBefore &&
           accumulator.loweringRuleKeys.bucketHeads.vals.cap == keyBucketValsCapacityBefore &&
           accumulator.loweringRuleKeys.bucketHeads.states.cap == keyBucketStatesCapacityBefore &&
           accumulator.loweringRuleKeys.bucketHeads.mask == keyBucketMaskBefore &&
           accumulator.resolvedCallSet.nextIndexes.len == 0 &&
           accumulator.resolvedCallSet.nextIndexes.cap == resolvedSetNextCapacityBefore &&
           accumulator.resolvedCallSet.hashIndex.slots.len == 0 &&
           accumulator.resolvedCallSet.hashIndex.slots.cap == resolvedHashSlotsCapacityBefore &&
           accumulator.resolvedCallSet.hashIndex.keys.len == 0 &&
           accumulator.resolvedCallSet.hashIndex.keys.cap == resolvedHashKeysCapacityBefore &&
           accumulator.resolvedCallSet.bucketHeads.len == 0 &&
           accumulator.resolvedCallSet.bucketHeads.cap == resolvedBucketHeadsCapacityBefore &&
           accumulator.resolvedCallSet.bucketHeadCertificates.len == 0 &&
           accumulator.resolvedCallSet.bucketHeadCertificates.cap ==
               resolvedBucketCertificatesCapacityBefore &&
           accumulator.resolvedCallSet.hashSlotCertificates.len == 0 &&
           accumulator.resolvedCallSet.hashSlotCertificates.cap ==
               resolvedHashCertificatesCapacityBefore &&
           accumulator.resolvedCallSet.nextCertificates.len == 0 &&
           accumulator.resolvedCallSet.nextCertificates.cap ==
               resolvedNextCertificatesCapacityBefore &&
           accumulator.transactionCommittedBatchCount == Int64(0) &&
           accumulator.transactionCommittedFactCount == Int64(0) &&
           accumulator.transactionMaxStagedFactCount == 0 &&
           accumulator.transactionMaxStagedCapacity == 0 &&
           ccsg.CompilerCsgSemanticDynamicSequenceBytes(semanticGraph, false) == semanticGraphLogicalBytesBefore &&
           ccsg.CompilerCsgSemanticDynamicSequenceBytes(semanticGraph, true) == semanticGraphRetainedBytesBefore,
           " reachability smoke: accumulator failure polluted rule/set/counter state")

    var correctedFacts: texpr.TypedExprFactTable
    AppendExecutableFact(correctedFacts, sourcePath, 2, "TargetA", "TargetA", "")
    AppendExecutableFact(correctedFacts, sourcePath, 3, "TargetB", "TargetB", "")
    assert(ccsg.CompilerCsgSemanticTypedFactAccumulatorAppend(semanticGraph,
                                                        accumulator,
                                                        set,
                                                        0,
                                                        correctedFacts,
                                                        0,
                                                        correctedFacts.count,
                                                        err),
           strutil.Join([" reachability smoke: accumulator corrected retry ", err], ""))
    assert(semanticGraph.typedFactTable.sourceIndexes.len == 2 &&
           semanticGraph.typedFactTable.summary.surfaceCallCount == 2 &&
           semanticGraph.typedFactTable.summary.callResolvedCount == 2 &&
           semanticGraph.typedFactTable.summary.surfaceCallLocalCount == 2 &&
           semanticGraph.resolvedCallTable.sourceIndexes.len == 2 &&
           langintern.InternPoolCount(semanticGraph.resolvedCallTable.internPool) > 0 &&
           accumulator.transactionCommittedBatchCount == Int64(1) &&
           accumulator.transactionCommittedFactCount == Int64(2) &&
           accumulator.transactionMaxStagedFactCount == 2 &&
           accumulator.transactionMaxStagedCapacity ==
               accumulator.transactionLastStagingCapacityLedger.phasePeakBytes &&
           accumulator.transactionLastStagingCapacityLedger.typedFactTransactionBytes > Int64(0),
           " reachability smoke: accumulator retry duplicated rows or staged total history")
    AssertStagingLedgerExact(accumulator.transactionLastStagingCapacityLedger,
                             "accumulator retry")
    ccsg.CompilerCsgSemanticTypedFactAccumulatorFinish(semanticGraph, accumulator)
    ccsg.CompilerCsgSemanticTypedFactAccumulatorFinish(controlSemanticGraph, controlAccumulator)
    ccsg.CompilerCsgSemanticResolvedCallTableRelease(semanticGraph.resolvedCallTable)
    ccsg.CompilerCsgSemanticResolvedCallTableRelease(controlSemanticGraph.resolvedCallTable)
    texpr.TypedExprFactTableRelease(malformedFacts)
    texpr.TypedExprFactTableRelease(correctedFacts)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(set)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(untouchedSet)

fn AssertAccumulatorCertifiedPrefixLinearGrowth(sourcePath: str) =
    var set: ccsg.CompilerCsgReachableFunctionSet
    InitTwoCallReachability(sourcePath, set)
    var controlSet: ccsg.CompilerCsgReachableFunctionSet
    InitTwoCallReachability(sourcePath, controlSet)
    var sourceIndex: ccsg.CompilerCsgSourcePathIndex
    InitRegisteredSmokeSourceIndex(sourcePath, sourceIndex)
    var controlSourceIndex: ccsg.CompilerCsgSourcePathIndex
    InitRegisteredSmokeSourceIndex(sourcePath, controlSourceIndex)
    var semanticGraph: ccsg.CompilerCsgSemanticGraph
    semanticGraph.sourceTable.sourcePaths = [sourcePath]
    var controlSemanticGraph: ccsg.CompilerCsgSemanticGraph
    controlSemanticGraph.sourceTable.sourcePaths = [sourcePath]
    var accumulator = ccsg.CompilerCsgSemanticTypedFactAccumulatorInit(semanticGraph,
                                                                  sourceIndex,
                                                                  set.functionNames.len)
    var controlAccumulator = ccsg.CompilerCsgSemanticTypedFactAccumulatorInit(controlSemanticGraph,
                                                                         controlSourceIndex,
                                                                         controlSet.functionNames.len)
    var facts: texpr.TypedExprFactTable
    AppendExecutableFact(facts, sourcePath, 2, "TargetA", "TargetA", "")
    var err: str
    var controlErr: str
    assert(ccsg.CompilerCsgSemanticTypedFactAccumulatorAppend(semanticGraph,
                                                        accumulator,
                                                        set,
                                                        0,
                                                        facts,
                                                        0,
                                                        facts.count,
                                                        err) &&
           ccsg.CompilerCsgSemanticTypedFactAccumulatorAppend(controlSemanticGraph,
                                                        controlAccumulator,
                                                        controlSet,
                                                        0,
                                                        facts,
                                                        0,
                                                        facts.count,
                                                        controlErr),
           strutil.Join([" reachability smoke: certified prefix seed ", err, controlErr], ""))
    let initialFullRowVisits = accumulator.validationFullRowVisitCount
    let initialMaxStagedCapacity = accumulator.transactionMaxStagedCapacity
    assert(initialFullRowVisits == Int64(set.functionNames.len) &&
           initialMaxStagedCapacity > Int64(0),
           " reachability smoke: initial accumulator audit was not exactly once")

    let originalTargetId = semanticGraph.resolvedCallTable.callTargetIds[0]
    let controlOriginalTargetId = controlSemanticGraph.resolvedCallTable.callTargetIds[0]
    semanticGraph.resolvedCallTable.callTargetIds[0] = semanticGraph.resolvedCallTable.sourcePathIds[0]
    controlSemanticGraph.resolvedCallTable.callTargetIds[0] =
        controlSemanticGraph.resolvedCallTable.sourcePathIds[0]
    assert(!ccsg.CompilerCsgSemanticTypedFactAccumulatorAppend(semanticGraph,
                                                         accumulator,
                                                         set,
                                                         0,
                                                         facts,
                                                         0,
                                                         facts.count,
                                                         err) &&
           strings.StrContains(err, "certificate mismatch"),
           strutil.Join([" reachability smoke: same-shape resolved row mutation ", err], ""))
    AssertResolvedCallTableStorageEqual(semanticGraph.resolvedCallTable,
                                        controlSemanticGraph.resolvedCallTable,
                                        "same-shape resolved mutation atomic")
    AssertAccumulatorIndexStateEqual(accumulator,
                                     controlAccumulator,
                                     "same-shape resolved mutation atomic")
    AssertReachabilityTransactionEqual(set,
                                       controlSet,
                                       "same-shape resolved mutation probes atomic")
    semanticGraph.resolvedCallTable.callTargetIds[0] = originalTargetId
    controlSemanticGraph.resolvedCallTable.callTargetIds[0] = controlOriginalTargetId

    let growthRounds: int32 = 16
    for round in 0..<growthRounds:
        assert(ccsg.CompilerCsgSemanticTypedFactAccumulatorAppend(semanticGraph,
                                                            accumulator,
                                                            set,
                                                            0,
                                                            facts,
                                                            0,
                                                            facts.count,
                                                            err) &&
               ccsg.CompilerCsgSemanticTypedFactAccumulatorAppend(controlSemanticGraph,
                                                            controlAccumulator,
                                                            controlSet,
                                                            0,
                                                            facts,
                                                            0,
                                                            facts.count,
                                                            controlErr),
               strutil.Join([" reachability smoke: certified prefix growth ",
                             strings.IntToStr(round), " ", err, controlErr], ""))
    assert(accumulator.validationFullRowVisitCount == initialFullRowVisits &&
           accumulator.validationAppendedRowVisitCount ==
               Int64(semanticGraph.typedFactTable.sourceIndexes.len +
                     semanticGraph.resolvedCallTable.sourceIndexes.len) &&
           accumulator.validationTouchedRowVisitCount <=
               Int64((growthRounds + 1) * 16) &&
           accumulator.transactionMaxStagedFactCount == 1 &&
           accumulator.transactionMaxStagedCapacity == initialMaxStagedCapacity,
           " reachability smoke: accumulator rescanned history or grew staging with history")

    set.functionNames[1] = "XargetA"
    controlSet.functionNames[1] = "XargetA"
    assert(!ccsg.CompilerCsgSemanticTypedFactAccumulatorAppend(semanticGraph,
                                                         accumulator,
                                                         set,
                                                         0,
                                                         facts,
                                                         0,
                                                         facts.count,
                                                         err) &&
           strings.StrContains(err, "content certificate mismatch"),
           strutil.Join([" reachability smoke: same-length function mutation ", err], ""))
    AssertAccumulatorIndexStateEqual(accumulator,
                                     controlAccumulator,
                                     "same-length function mutation atomic")
    AssertReachabilityTransactionEqual(set,
                                       controlSet,
                                       "same-length function mutation probes atomic")
    set.functionNames[1] = "TargetA"
    controlSet.functionNames[1] = "TargetA"
    assert(ccsg.CompilerCsgSemanticTypedFactAccumulatorAppend(semanticGraph,
                                                        accumulator,
                                                        set,
                                                        0,
                                                        facts,
                                                        0,
                                                        facts.count,
                                                        err) &&
           ccsg.CompilerCsgSemanticTypedFactAccumulatorAppend(controlSemanticGraph,
                                                        controlAccumulator,
                                                        controlSet,
                                                        0,
                                                        facts,
                                                        0,
                                                        facts.count,
                                                        controlErr),
           strutil.Join([" reachability smoke: same-length mutation retry ", err, controlErr], ""))
    AssertResolvedCallTableStorageEqual(semanticGraph.resolvedCallTable,
                                        controlSemanticGraph.resolvedCallTable,
                                        "certified prefix retry table")
    AssertTypedFactSummaryEqual(semanticGraph.typedFactTable.summary,
                                controlSemanticGraph.typedFactTable.summary,
                                "certified prefix retry summary")
    AssertAccumulatorIndexStateEqual(accumulator,
                                     controlAccumulator,
                                     "certified prefix retry accumulator")
    AssertReachabilityTransactionEqual(set,
                                       controlSet,
                                       "certified prefix retry reachability")
    ccsg.CompilerCsgSemanticTypedFactAccumulatorFinish(semanticGraph, accumulator)
    ccsg.CompilerCsgSemanticTypedFactAccumulatorFinish(controlSemanticGraph, controlAccumulator)
    ccsg.CompilerCsgSemanticResolvedCallTableRelease(semanticGraph.resolvedCallTable)
    ccsg.CompilerCsgSemanticResolvedCallTableRelease(controlSemanticGraph.resolvedCallTable)
    texpr.TypedExprFactTableRelease(facts)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(set)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(controlSet)

fn AssertAccumulatorPrevalidationAndOwnerContracts(sourcePath: str) =
    var facts: texpr.TypedExprFactTable
    AppendExecutableFact(facts, sourcePath, 2, "TargetA", "TargetA", "")

    var columnSet: ccsg.CompilerCsgReachableFunctionSet
    InitTwoCallReachability(sourcePath, columnSet)
    var columnControl: ccsg.CompilerCsgReachableFunctionSet
    InitTwoCallReachability(sourcePath, columnControl)
    columnSet.edgeHeads = []
    columnControl.edgeHeads = []
    var columnSourceIndex: ccsg.CompilerCsgSourcePathIndex
    InitRegisteredSmokeSourceIndex(sourcePath, columnSourceIndex)
    var columnSemanticGraph: ccsg.CompilerCsgSemanticGraph
    columnSemanticGraph.sourceTable.sourcePaths = [sourcePath]
    var columnAccumulator = ccsg.CompilerCsgSemanticTypedFactAccumulatorInit(columnSemanticGraph,
                                                                        columnSourceIndex,
                                                                        columnSet.functionNames.len)
    var columnControlSourceIndex: ccsg.CompilerCsgSourcePathIndex
    InitRegisteredSmokeSourceIndex(sourcePath, columnControlSourceIndex)
    var columnControlSemanticGraph: ccsg.CompilerCsgSemanticGraph
    columnControlSemanticGraph.sourceTable.sourcePaths = [sourcePath]
    var columnControlAccumulator = ccsg.CompilerCsgSemanticTypedFactAccumulatorInit(columnControlSemanticGraph,
                                                                               columnControlSourceIndex,
                                                                               columnSet.functionNames.len)
    var columnErr: str
    assert(!ccsg.CompilerCsgSemanticTypedFactAccumulatorAppend(columnSemanticGraph,
                                                         columnAccumulator,
                                                         columnSet,
                                                         0,
                                                         facts,
                                                         0,
                                                         facts.count,
                                                         columnErr) &&
           strings.StrContains(columnErr, "reachable function columns mismatch"),
           strutil.Join([" reachability smoke: accumulator reachable prevalidation ", columnErr], ""))
    AssertReachabilityTransactionEqual(columnSet,
                                       columnControl,
                                       "accumulator reachable prevalidation atomic")
    AssertAccumulatorIndexStateEqual(columnAccumulator,
                                     columnControlAccumulator,
                                     "accumulator reachable prevalidation atomic")

    var tableSet: ccsg.CompilerCsgReachableFunctionSet
    InitTwoCallReachability(sourcePath, tableSet)
    var tableSourceIndex: ccsg.CompilerCsgSourcePathIndex
    InitRegisteredSmokeSourceIndex(sourcePath, tableSourceIndex)
    var tableSemanticGraph: ccsg.CompilerCsgSemanticGraph
    tableSemanticGraph.sourceTable.sourcePaths = [sourcePath]
    var tableAccumulator = ccsg.CompilerCsgSemanticTypedFactAccumulatorInit(tableSemanticGraph,
                                                                       tableSourceIndex,
                                                                       tableSet.functionNames.len)
    add(tableSemanticGraph.resolvedCallTable.sourceIndexes, 0)
    var tableControlSourceIndex: ccsg.CompilerCsgSourcePathIndex
    InitRegisteredSmokeSourceIndex(sourcePath, tableControlSourceIndex)
    var tableControlSemanticGraph: ccsg.CompilerCsgSemanticGraph
    tableControlSemanticGraph.sourceTable.sourcePaths = [sourcePath]
    var tableControlAccumulator = ccsg.CompilerCsgSemanticTypedFactAccumulatorInit(tableControlSemanticGraph,
                                                                              tableControlSourceIndex,
                                                                              tableSet.functionNames.len)
    add(tableControlSemanticGraph.resolvedCallTable.sourceIndexes, 0)
    let tableMetricsBefore = tableAccumulator.transactionCommittedBatchCount
    var tableErr: str
    assert(!ccsg.CompilerCsgSemanticTypedFactAccumulatorAppend(tableSemanticGraph,
                                                         tableAccumulator,
                                                         tableSet,
                                                         0,
                                                         facts,
                                                         0,
                                                         facts.count,
                                                         tableErr) &&
           strings.StrContains(tableErr, "resolved-call row columns mismatch"),
           strutil.Join([" reachability smoke: accumulator table prevalidation ", tableErr], ""))
    AssertResolvedCallTableStorageEqual(tableSemanticGraph.resolvedCallTable,
                                        tableControlSemanticGraph.resolvedCallTable,
                                        "accumulator table column failure atomic")
    AssertAccumulatorIndexStateEqual(tableAccumulator,
                                     tableControlAccumulator,
                                     "accumulator table column failure atomic")
    assert(tableAccumulator.transactionCommittedBatchCount == tableMetricsBefore &&
           tableAccumulator.transactionMaxStagedCapacity == 0,
           " reachability smoke: table prevalidation changed transaction metrics")

    var ownerSet: ccsg.CompilerCsgReachableFunctionSet
    InitTwoCallReachability(sourcePath, ownerSet)
    var ownerSourceIndex: ccsg.CompilerCsgSourcePathIndex
    InitRegisteredSmokeSourceIndex(sourcePath, ownerSourceIndex)
    var ownerSemanticGraph: ccsg.CompilerCsgSemanticGraph
    ownerSemanticGraph.sourceTable.sourcePaths = [sourcePath]
    var ownerAccumulator = ccsg.CompilerCsgSemanticTypedFactAccumulatorInit(ownerSemanticGraph,
                                                                       ownerSourceIndex,
                                                                       ownerSet.functionNames.len)
    AppendResolvedReturnRow(ownerSemanticGraph.resolvedCallTable, 0, sourcePath, 2, "TargetA")
    ownerSemanticGraph.resolvedCallTable.functionIndexes[0] = ownerSet.functionNames.len
    var ownerControlSourceIndex: ccsg.CompilerCsgSourcePathIndex
    InitRegisteredSmokeSourceIndex(sourcePath, ownerControlSourceIndex)
    var ownerControlSemanticGraph: ccsg.CompilerCsgSemanticGraph
    ownerControlSemanticGraph.sourceTable.sourcePaths = [sourcePath]
    var ownerControlAccumulator = ccsg.CompilerCsgSemanticTypedFactAccumulatorInit(ownerControlSemanticGraph,
                                                                              ownerControlSourceIndex,
                                                                              ownerSet.functionNames.len)
    AppendResolvedReturnRow(ownerControlSemanticGraph.resolvedCallTable, 0, sourcePath, 2, "TargetA")
    ownerControlSemanticGraph.resolvedCallTable.functionIndexes[0] = ownerSet.functionNames.len
    var ownerErr: str
    assert(!ccsg.CompilerCsgSemanticTypedFactAccumulatorAppend(ownerSemanticGraph,
                                                         ownerAccumulator,
                                                         ownerSet,
                                                         0,
                                                         facts,
                                                         0,
                                                         facts.count,
                                                         ownerErr) &&
           strings.StrContains(ownerErr, "resolved-call owner index invalid"),
           strutil.Join([" reachability smoke: accumulator owner prevalidation ", ownerErr], ""))
    AssertResolvedCallTableStorageEqual(ownerSemanticGraph.resolvedCallTable,
                                        ownerControlSemanticGraph.resolvedCallTable,
                                        "accumulator owner failure atomic")
    AssertAccumulatorIndexStateEqual(ownerAccumulator,
                                     ownerControlAccumulator,
                                     "accumulator owner failure atomic")
    assert(ownerAccumulator.transactionCommittedBatchCount == Int64(0) &&
           ownerAccumulator.transactionMaxStagedCapacity == 0,
           " reachability smoke: owner prevalidation changed transaction metrics")

    var ownerlessSet: ccsg.CompilerCsgReachableFunctionSet
    InitTwoCallReachability(sourcePath, ownerlessSet)
    var ownerlessSourceIndex: ccsg.CompilerCsgSourcePathIndex
    InitRegisteredSmokeSourceIndex(sourcePath, ownerlessSourceIndex)
    var ownerlessSemanticGraph: ccsg.CompilerCsgSemanticGraph
    ownerlessSemanticGraph.sourceTable.sourcePaths = [sourcePath]
    var ownerlessAccumulator = ccsg.CompilerCsgSemanticTypedFactAccumulatorInit(ownerlessSemanticGraph,
                                                                           ownerlessSourceIndex,
                                                                           ownerlessSet.functionNames.len)
    var ownerlessErr: str
    assert(!ccsg.CompilerCsgSemanticTypedFactAccumulatorAppend(ownerlessSemanticGraph,
                                                         ownerlessAccumulator,
                                                         ownerlessSet,
                                                         -1,
                                                         facts,
                                                         0,
                                                         facts.count,
                                                         ownerlessErr) &&
           strings.StrContains(ownerlessErr, "resolved call owner function missing") &&
           ownerlessSemanticGraph.typedFactTable.sourceIndexes.len == 0 &&
           ownerlessSemanticGraph.resolvedCallTable.sourceIndexes.len == 0 &&
           ownerlessAccumulator.transactionCommittedBatchCount == Int64(0),
           strutil.Join([" reachability smoke: dead bulk helper owner contract ", ownerlessErr], ""))

    ccsg.CompilerCsgSemanticTypedFactAccumulatorFinish(columnSemanticGraph, columnAccumulator)
    ccsg.CompilerCsgSemanticTypedFactAccumulatorFinish(columnControlSemanticGraph, columnControlAccumulator)
    ccsg.CompilerCsgSemanticTypedFactAccumulatorFinish(tableSemanticGraph, tableAccumulator)
    ccsg.CompilerCsgSemanticTypedFactAccumulatorFinish(tableControlSemanticGraph, tableControlAccumulator)
    ccsg.CompilerCsgSemanticTypedFactAccumulatorFinish(ownerSemanticGraph, ownerAccumulator)
    ccsg.CompilerCsgSemanticTypedFactAccumulatorFinish(ownerControlSemanticGraph, ownerControlAccumulator)
    ccsg.CompilerCsgSemanticTypedFactAccumulatorFinish(ownerlessSemanticGraph, ownerlessAccumulator)
    ccsg.CompilerCsgSemanticResolvedCallTableRelease(columnSemanticGraph.resolvedCallTable)
    ccsg.CompilerCsgSemanticResolvedCallTableRelease(columnControlSemanticGraph.resolvedCallTable)
    ccsg.CompilerCsgSemanticResolvedCallTableRelease(tableSemanticGraph.resolvedCallTable)
    ccsg.CompilerCsgSemanticResolvedCallTableRelease(tableControlSemanticGraph.resolvedCallTable)
    ccsg.CompilerCsgSemanticResolvedCallTableRelease(ownerSemanticGraph.resolvedCallTable)
    ccsg.CompilerCsgSemanticResolvedCallTableRelease(ownerControlSemanticGraph.resolvedCallTable)
    ccsg.CompilerCsgSemanticResolvedCallTableRelease(ownerlessSemanticGraph.resolvedCallTable)
    texpr.TypedExprFactTableRelease(facts)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(columnSet)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(columnControl)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(tableSet)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(ownerSet)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(ownerlessSet)

fn AppendFrontierCallExpr(layer: var parser.NormalizedExprLayer,
                          sourcePath: str,
                          lineNumber: int32,
                          targetName: str) =
    parser.NormalizedExprLayerAppend(layer,
                                     sourcePath,
                                     lineNumber,
                                     5,
                                     parser.NormalizedExprCall,
                                     parser.NormalizedExprDetailNone,
                                     strutil.Join([targetName, "()"], ""))

fn AssertFrontierAppendBatchAtomicRetry(sourcePath: str) =
    var set: ccsg.CompilerCsgReachableFunctionSet
    InitReturnReachability(sourcePath, set)
    AddAccumulatorPaddingFunctions(sourcePath, set)
    var untouchedSet: ccsg.CompilerCsgReachableFunctionSet
    InitReturnReachability(sourcePath, untouchedSet)
    AddAccumulatorPaddingFunctions(sourcePath, untouchedSet)

    var sourceIndex = ccsg.CompilerCsgSourcePathIndexInit(4)
    ConfigureSmokeSourceIndex(sourceIndex)
    var sourceIndexErr: str
    assert(ccsg.CompilerCsgSourcePathIndexRegister(sourceIndex,
                                                   sourcePath,
                                                   0,
                                                   sourceIndexErr),
           strutil.Join([" reachability smoke: frontier source index ", sourceIndexErr], ""))
    var semanticGraph: ccsg.CompilerCsgSemanticGraph
    semanticGraph.sourceTable.sourcePaths = [sourcePath]
    for sourceOrdinal in 0..<512:
        add(semanticGraph.sourceTable.sourcePaths,
            strutil.Join(["/tmp/frontier-padding-",
                          strings.IntToStr(sourceOrdinal),
                          ".cheng"], ""))
    var accumulator = ccsg.CompilerCsgSemanticTypedFactAccumulatorInit(semanticGraph,
                                                                  sourceIndex,
                                                                  set.functionNames.len)
    var controlSourceIndex: ccsg.CompilerCsgSourcePathIndex
    InitRegisteredSmokeSourceIndex(sourcePath, controlSourceIndex)
    var controlSemanticGraph: ccsg.CompilerCsgSemanticGraph
    controlSemanticGraph.sourceTable.sourcePaths = [sourcePath]
    for sourceOrdinal in 0..<512:
        add(controlSemanticGraph.sourceTable.sourcePaths,
            strutil.Join(["/tmp/frontier-padding-",
                          strings.IntToStr(sourceOrdinal),
                          ".cheng"], ""))
    var controlAccumulator = ccsg.CompilerCsgSemanticTypedFactAccumulatorInit(controlSemanticGraph,
                                                                         controlSourceIndex,
                                                                         set.functionNames.len)
    let resolvedHeadCapacityBefore = semanticGraph.resolvedCallTable.functionRowHeads.cap
    let resolvedInternCapacityBefore = semanticGraph.resolvedCallTable.internPool.texts.cap
    let typedSourceCapacityBefore = semanticGraph.typedFactTable.sourceIndexes.cap
    let sliceSourceCapacityBefore = semanticGraph.exprSliceTable.sourceIndex.cap
    let semanticGraphLogicalBytesBefore = ccsg.CompilerCsgSemanticDynamicSequenceBytes(semanticGraph, false)
    let semanticGraphRetainedBytesBefore = ccsg.CompilerCsgSemanticDynamicSequenceBytes(semanticGraph, true)

    var functionProcessed: bool[]
    for functionIndex in 0..<set.functionNames.len:
        add(functionProcessed, false)
    var sourceCounted: bool[]
    for sourceIndexValue in 0..<semanticGraph.sourceTable.sourcePaths.len:
        add(sourceCounted, false)
    let frontierFunctionIndexes = [0, 1]
    var frontierIndex: ccsg.CompilerCsgFrontierIndex
    ccsg.CompilerCsgFrontierIndexBegin(frontierIndex, 1, set.functionNames.len)
    let frontierFunctionCapacityBefore = frontierIndex.functionSelected.cap
    let frontierExprCapacityBefore = frontierIndex.exprStarts.cap
    let frontierFactCapacityBefore = frontierIndex.factStarts.cap
    var untouchedFrontierIndex: ccsg.CompilerCsgFrontierIndex
    ccsg.CompilerCsgFrontierIndexBegin(untouchedFrontierIndex, 1, set.functionNames.len)

    var fullExprLayer: parser.NormalizedExprLayer
    AppendFrontierCallExpr(fullExprLayer, sourcePath, 2, "TargetA")
    AppendFrontierCallExpr(fullExprLayer, sourcePath, 9, "TargetB")
    var functionExprLayer: parser.NormalizedExprLayer
    AppendFrontierCallExpr(functionExprLayer, sourcePath, 77, "Sentinel")
    functionExprLayer.sourceCount = 1
    let functionExprCapacityBefore = functionExprLayer.exprs.cap

    var malformedFacts: texpr.TypedExprFactTable
    AppendExecutableFact(malformedFacts, sourcePath, 2, "TargetA", "TargetA", "")
    AppendExecutableFact(malformedFacts, sourcePath, 9, "DamagedCall", "", "")
    var err: str
    assert(!ccsg.CompilerCsgSemanticAppendUnprocessedFrontierFacts(semanticGraph,
                                                             accumulator,
                                                             set,
                                                             frontierFunctionIndexes,
                                                             frontierIndex,
                                                             fullExprLayer,
                                                             functionExprLayer,
                                                             malformedFacts,
                                                             functionProcessed,
                                                             sourceCounted,
                                                             err) &&
           strings.StrContains(err, "target empty"),
           strutil.Join([" reachability smoke: frontier late failure ", err], ""))
    AssertReachabilityTransactionEqual(set,
                                       untouchedSet,
                                       "frontier failure counters atomic")
    AssertFrontierIndexEqual(frontierIndex,
                             untouchedFrontierIndex,
                             "frontier failure cursor atomic")
    AssertExprSummaryEqual(semanticGraph.exprSummary,
                           controlSemanticGraph.exprSummary,
                           "frontier late failure")
    AssertTypedFactSummaryEqual(semanticGraph.typedFactTable.summary,
                                controlSemanticGraph.typedFactTable.summary,
                                "frontier late failure")
    AssertAccumulatorIndexStateEqual(accumulator,
                                     controlAccumulator,
                                     "frontier late failure")
    for functionIndex in 0..<functionProcessed.len:
        assert(!functionProcessed[functionIndex],
               " reachability smoke: frontier failure marked function processed")
    for sourceIndexValue in 0..<sourceCounted.len:
        assert(!sourceCounted[sourceIndexValue],
               " reachability smoke: frontier failure marked source counted")
    assert(!sourceCounted[0] &&
           functionExprLayer.exprs.len == 1 &&
           functionExprLayer.exprs.cap == functionExprCapacityBefore &&
           functionExprLayer.sourceCount == 1 &&
           functionExprLayer.exprs[0].sourcePath == sourcePath &&
           functionExprLayer.exprs[0].lineNumber == 77,
           " reachability smoke: frontier failure polluted caller outputs")
    assert(ExprSummaryCounterTotal(semanticGraph.exprSummary) == Int64(0) &&
           semanticGraph.exprSliceTable.sourceIndex.len == 0 &&
           semanticGraph.exprSliceTable.sourceIndex.cap == sliceSourceCapacityBefore &&
           semanticGraph.exprSliceTable.sourcePaths.len == 0 &&
           semanticGraph.exprSliceTable.functionIndex.len == 0 &&
           semanticGraph.exprSliceTable.exprStart.len == 0 &&
           semanticGraph.exprSliceTable.exprCount.len == 0 &&
           semanticGraph.exprSliceTable.typedFactStart.len == 0 &&
           semanticGraph.exprSliceTable.typedFactCount.len == 0 &&
           semanticGraph.exprSliceFunctionBoundCount == 0 &&
           semanticGraph.exprSliceMaxExprCount == 0 &&
           semanticGraph.exprSliceMaxTypedFactCount == 0 &&
           semanticGraph.typedFactTable.sourceIndexes.len == 0 &&
           semanticGraph.typedFactTable.sourceIndexes.cap == typedSourceCapacityBefore &&
           semanticGraph.typedFactTable.typeCallDefaultInitCount == 0 &&
           semanticGraph.typedFactTable.typeCallConstructorCount == 0 &&
           TypedFactSummaryCounterTotal(semanticGraph.typedFactTable.summary) == Int64(0) &&
           semanticGraph.resolvedCallTable.functionRowHeads.cap == resolvedHeadCapacityBefore &&
           semanticGraph.resolvedCallTable.sourceIndexes.len == 0 &&
           langintern.InternPoolCount(semanticGraph.resolvedCallTable.internPool) == 0 &&
           accumulator.loweringRuleShapes.rules.len == 0 &&
           accumulator.loweringRuleKeys.rules.len == 0 &&
           accumulator.resolvedCallSet.nextIndexes.len == 0 &&
           accumulator.transactionCommittedBatchCount == Int64(0) &&
           accumulator.transactionCommittedFactCount == Int64(0) &&
           accumulator.transactionMaxStagedFactCount == 0 &&
           accumulator.transactionMaxStagedCapacity == 0 &&
           ccsg.CompilerCsgSemanticDynamicSequenceBytes(semanticGraph, false) == semanticGraphLogicalBytesBefore &&
           ccsg.CompilerCsgSemanticDynamicSequenceBytes(semanticGraph, true) == semanticGraphRetainedBytesBefore,
           " reachability smoke: frontier failure polluted semantic graph accumulator")
    AssertEmptyResolvedCallTableExact(semanticGraph.resolvedCallTable,
                                      set.functionNames.len,
                                      resolvedHeadCapacityBefore,
                                      resolvedInternCapacityBefore,
                                      "frontier late failure")

    var correctedFacts: texpr.TypedExprFactTable
    AppendExecutableFact(correctedFacts, sourcePath, 2, "TargetA", "TargetA", "")
    AppendExecutableFact(correctedFacts, sourcePath, 9, "TargetB", "TargetB", "")
    assert(ccsg.CompilerCsgSemanticAppendUnprocessedFrontierFacts(semanticGraph,
                                                            accumulator,
                                                            set,
                                                            frontierFunctionIndexes,
                                                            frontierIndex,
                                                            fullExprLayer,
                                                            functionExprLayer,
                                                            correctedFacts,
                                                            functionProcessed,
                                                            sourceCounted,
                                                            err),
           strutil.Join([" reachability smoke: frontier corrected retry ", err], ""))
    assert(functionProcessed[0] && functionProcessed[1] && sourceCounted[0],
           " reachability smoke: frontier retry did not commit owner flags")
    for sourceIndexValue in 1..<sourceCounted.len:
        assert(!sourceCounted[sourceIndexValue],
               " reachability smoke: frontier retry marked unrelated source")
    for functionIndex in 2..<functionProcessed.len:
        assert(!functionProcessed[functionIndex],
               " reachability smoke: frontier retry marked unrelated function")
    assert(semanticGraph.exprSummary.sourceCount == 1 &&
           semanticGraph.exprSummary.exprCount == 2 &&
           semanticGraph.exprSummary.callCount == 2 &&
           ExprSummaryCounterTotal(semanticGraph.exprSummary) == Int64(5) &&
           semanticGraph.exprSliceTable.sourceIndex.len == 2 &&
           semanticGraph.exprSliceTable.functionIndex[0] == 0 &&
           semanticGraph.exprSliceTable.functionIndex[1] == 1 &&
           semanticGraph.exprSliceTable.exprStart[0] == 0 &&
           semanticGraph.exprSliceTable.exprStart[1] == 1 &&
           semanticGraph.exprSliceTable.exprCount[0] == 1 &&
           semanticGraph.exprSliceTable.exprCount[1] == 1 &&
           semanticGraph.exprSliceTable.typedFactStart[0] == 0 &&
           semanticGraph.exprSliceTable.typedFactStart[1] == 1 &&
           semanticGraph.exprSliceTable.typedFactCount[0] == 1 &&
           semanticGraph.exprSliceTable.typedFactCount[1] == 1 &&
           semanticGraph.typedFactTable.sourceIndexes.len == 2 &&
           semanticGraph.typedFactTable.summary.surfaceCallCount == 2 &&
           semanticGraph.resolvedCallTable.sourceIndexes.len == 2 &&
           functionExprLayer.exprs.len == 0 &&
           functionExprLayer.sourceCount == 0,
           " reachability smoke: frontier retry summary or slices counted twice")
    assert(accumulator.transactionCommittedBatchCount == Int64(1) &&
           accumulator.transactionCommittedFactCount == Int64(2) &&
           accumulator.transactionMaxStagedFactCount == 2 &&
           accumulator.transactionMaxStagedCapacity ==
               accumulator.transactionLastStagingCapacityLedger.phasePeakBytes &&
           accumulator.transactionLastStagingCapacityLedger.frontierSelectionBytes > Int64(0) &&
           frontierIndex.functionSelected.cap == frontierFunctionCapacityBefore &&
           frontierIndex.exprStarts.cap == frontierExprCapacityBefore &&
           frontierIndex.factStarts.cap == frontierFactCapacityBefore,
           " reachability smoke: frontier transaction staged cumulative state")
    AssertStagingLedgerExact(accumulator.transactionLastStagingCapacityLedger,
                             "frontier transaction")

    var semanticIr: texpr.TypedExprIr
    semanticIr.internPool = langintern.InternPoolNew()
    AppendTypedIrFunction(semanticIr,
                          sourcePath,
                          set.functionNames[0],
                          set.startLines[0],
                          0,
                          0)
    AppendTypedIrFunction(semanticIr,
                          sourcePath,
                          set.functionNames[1],
                          set.startLines[1],
                          0,
                          0)
    var reverseSemanticFrontier: int32[] = [1, 0]
    assert(ccsg.CompilerCsgSemanticCommitTypedIrRoundSemanticConservation(
               semanticGraph,
               set,
               reverseSemanticFrontier,
               0,
               semanticIr,
               err),
           strutil.Join([" reachability smoke: reverse frontier semantic commit ",
                         err], ""))
    assert(semanticGraph.exprSliceTable.typedIrFunctionIndexes[0] == 0 &&
           semanticGraph.exprSliceTable.typedIrFunctionIndexes[1] == 1 &&
           semanticGraph.exprSliceTable.semanticValidated[0] &&
           semanticGraph.exprSliceTable.semanticValidated[1],
           " reachability smoke: reverse frontier semantic identity mapping")
    texpr.TypedExprIrReleasePayload(semanticIr)
    ccsg.CompilerCsgSemanticTypedFactAccumulatorFinish(semanticGraph, accumulator)
    ccsg.CompilerCsgSemanticTypedFactAccumulatorFinish(controlSemanticGraph, controlAccumulator)
    ccsg.CompilerCsgSemanticResolvedCallTableRelease(semanticGraph.resolvedCallTable)
    ccsg.CompilerCsgSemanticResolvedCallTableRelease(controlSemanticGraph.resolvedCallTable)
    parser.NormalizedExprLayerReset(fullExprLayer)
    parser.NormalizedExprLayerReset(functionExprLayer)
    texpr.TypedExprFactTableRelease(malformedFacts)
    texpr.TypedExprFactTableRelease(correctedFacts)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(set)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(untouchedSet)

fn AssertFrontierIndexFullPrevalidation(sourcePath: str) =
    var set: ccsg.CompilerCsgReachableFunctionSet
    InitTwoCallReachability(sourcePath, set)
    var sourceIndex: ccsg.CompilerCsgSourcePathIndex
    InitRegisteredSmokeSourceIndex(sourcePath, sourceIndex)
    var semanticGraph: ccsg.CompilerCsgSemanticGraph
    semanticGraph.sourceTable.sourcePaths = [sourcePath]
    var accumulator = ccsg.CompilerCsgSemanticTypedFactAccumulatorInit(semanticGraph,
                                                                  sourceIndex,
                                                                  set.functionNames.len)
    var controlSourceIndex: ccsg.CompilerCsgSourcePathIndex
    InitRegisteredSmokeSourceIndex(sourcePath, controlSourceIndex)
    var controlSemanticGraph: ccsg.CompilerCsgSemanticGraph
    controlSemanticGraph.sourceTable.sourcePaths = [sourcePath]
    var controlAccumulator = ccsg.CompilerCsgSemanticTypedFactAccumulatorInit(controlSemanticGraph,
                                                                         controlSourceIndex,
                                                                         set.functionNames.len)
    var functionProcessed: bool[] = [false, false, false]
    var sourceCounted: bool[] = [false]
    var frontierIndex: ccsg.CompilerCsgFrontierIndex
    ccsg.CompilerCsgFrontierIndexBegin(frontierIndex, 1, set.functionNames.len)
    var controlIndex: ccsg.CompilerCsgFrontierIndex
    ccsg.CompilerCsgFrontierIndexBegin(controlIndex, 1, set.functionNames.len)
    var fullExprLayer: parser.NormalizedExprLayer
    var functionExprLayer: parser.NormalizedExprLayer
    AppendFrontierCallExpr(functionExprLayer, sourcePath, 77, "Sentinel")
    functionExprLayer.sourceCount = 1
    var facts: texpr.TypedExprFactTable
    var emptyFrontier: int32[]
    let functionLayerCapacity = functionExprLayer.exprs.cap
    var err: str

    setLen(frontierIndex.functionNext, frontierIndex.functionNext.len - 1)
    setLen(controlIndex.functionNext, controlIndex.functionNext.len - 1)
    assert(!ccsg.CompilerCsgSemanticAppendUnprocessedFrontierFacts(semanticGraph,
                                                             accumulator,
                                                             set,
                                                             emptyFrontier,
                                                             frontierIndex,
                                                             fullExprLayer,
                                                             functionExprLayer,
                                                             facts,
                                                             functionProcessed,
                                                             sourceCounted,
                                                             err) &&
           strings.StrContains(err, "frontier index columns mismatch"),
           strutil.Join([" reachability smoke: frontier functionNext prevalidation ", err], ""))
    AssertFrontierIndexEqual(frontierIndex, controlIndex, "frontier functionNext failure atomic")
    ccsg.CompilerCsgFrontierIndexBegin(frontierIndex, 1, set.functionNames.len)
    ccsg.CompilerCsgFrontierIndexBegin(controlIndex, 1, set.functionNames.len)

    setLen(frontierIndex.functionSelected, frontierIndex.functionSelected.len - 1)
    setLen(controlIndex.functionSelected, controlIndex.functionSelected.len - 1)
    assert(!ccsg.CompilerCsgSemanticAppendUnprocessedFrontierFacts(semanticGraph,
                                                             accumulator,
                                                             set,
                                                             emptyFrontier,
                                                             frontierIndex,
                                                             fullExprLayer,
                                                             functionExprLayer,
                                                             facts,
                                                             functionProcessed,
                                                             sourceCounted,
                                                             err) &&
           strings.StrContains(err, "frontier index columns mismatch"),
           strutil.Join([" reachability smoke: frontier selected prevalidation ", err], ""))
    AssertFrontierIndexEqual(frontierIndex, controlIndex, "frontier selected failure atomic")
    ccsg.CompilerCsgFrontierIndexBegin(frontierIndex, 1, set.functionNames.len)
    ccsg.CompilerCsgFrontierIndexBegin(controlIndex, 1, set.functionNames.len)

    setLen(frontierIndex.exprStarts, frontierIndex.exprStarts.len - 1)
    setLen(controlIndex.exprStarts, controlIndex.exprStarts.len - 1)
    assert(!ccsg.CompilerCsgSemanticAppendUnprocessedFrontierFacts(semanticGraph,
                                                             accumulator,
                                                             set,
                                                             emptyFrontier,
                                                             frontierIndex,
                                                             fullExprLayer,
                                                             functionExprLayer,
                                                             facts,
                                                             functionProcessed,
                                                             sourceCounted,
                                                             err) &&
           strings.StrContains(err, "frontier index columns mismatch"),
           strutil.Join([" reachability smoke: frontier expr range prevalidation ", err], ""))
    AssertFrontierIndexEqual(frontierIndex, controlIndex, "frontier expr failure atomic")
    ccsg.CompilerCsgFrontierIndexBegin(frontierIndex, 1, set.functionNames.len)
    ccsg.CompilerCsgFrontierIndexBegin(controlIndex, 1, set.functionNames.len)

    setLen(frontierIndex.factStarts, frontierIndex.factStarts.len - 1)
    setLen(controlIndex.factStarts, controlIndex.factStarts.len - 1)
    assert(!ccsg.CompilerCsgSemanticAppendUnprocessedFrontierFacts(semanticGraph,
                                                             accumulator,
                                                             set,
                                                             emptyFrontier,
                                                             frontierIndex,
                                                             fullExprLayer,
                                                             functionExprLayer,
                                                             facts,
                                                             functionProcessed,
                                                             sourceCounted,
                                                             err) &&
           strings.StrContains(err, "frontier index columns mismatch"),
           strutil.Join([" reachability smoke: frontier fact range prevalidation ", err], ""))
    AssertFrontierIndexEqual(frontierIndex, controlIndex, "frontier fact failure atomic")
    AssertAccumulatorIndexStateEqual(accumulator,
                                     controlAccumulator,
                                     "frontier index failures leave rules/maps exact")
    AssertExprSummaryEqual(semanticGraph.exprSummary, controlSemanticGraph.exprSummary, "frontier index failures")
    AssertTypedFactSummaryEqual(semanticGraph.typedFactTable.summary,
                                controlSemanticGraph.typedFactTable.summary,
                                "frontier index failures")
    assert(functionExprLayer.exprs.len == 1 &&
           functionExprLayer.exprs.cap == functionLayerCapacity &&
           functionExprLayer.sourceCount == 1 &&
           !functionProcessed[0] && !functionProcessed[1] && !functionProcessed[2] &&
           !sourceCounted[0],
           " reachability smoke: frontier prevalidation changed caller state")
    ccsg.CompilerCsgSemanticTypedFactAccumulatorFinish(semanticGraph, accumulator)
    ccsg.CompilerCsgSemanticTypedFactAccumulatorFinish(controlSemanticGraph, controlAccumulator)
    ccsg.CompilerCsgSemanticResolvedCallTableRelease(semanticGraph.resolvedCallTable)
    ccsg.CompilerCsgSemanticResolvedCallTableRelease(controlSemanticGraph.resolvedCallTable)
    parser.NormalizedExprLayerReset(functionExprLayer)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(set)

fn AssertTypedIrStatementBatchAtomicRetry(sourcePath: str) =
    var failedSet: ccsg.CompilerCsgReachableFunctionSet
    InitTwoCallReachability(sourcePath, failedSet)
    var untouchedSet: ccsg.CompilerCsgReachableFunctionSet
    InitTwoCallReachability(sourcePath, untouchedSet)
    var failedIr: texpr.TypedExprIr
    BuildTwoCallTypedIr(sourcePath, "", failedIr)
    var failedResolved = EmptyResolvedCalls(failedSet.functionNames.len)
    var failedStatementCursor: int32
    var failedFunctionCursor: int32
    var failedErr: str
    assert(!ccsg.CompilerCsgReachableExpandFromTypedIr(failedSet,
                                                       failedIr,
                                                       failedResolved,
                                                       failedStatementCursor,
                                                       failedFunctionCursor,
                                                       failedErr) &&
           strings.StrContains(failedErr, "target empty") &&
           failedStatementCursor == 0 && failedFunctionCursor == 0,
           strutil.Join([" reachability smoke: statement late failure ", failedErr], ""))
    AssertReachabilityTransactionEqual(failedSet, untouchedSet, "statement failure atomic")

    failedIr.statements2_callTargetIds[1] = langintern.Intern(failedIr.internPool, "TargetB")
    assert(ccsg.CompilerCsgReachableExpandFromTypedIr(failedSet,
                                                      failedIr,
                                                      failedResolved,
                                                      failedStatementCursor,
                                                      failedFunctionCursor,
                                                      failedErr),
           strutil.Join([" reachability smoke: statement retry ", failedErr], ""))

    var cleanSet: ccsg.CompilerCsgReachableFunctionSet
    InitTwoCallReachability(sourcePath, cleanSet)
    var cleanIr: texpr.TypedExprIr
    BuildTwoCallTypedIr(sourcePath, "TargetB", cleanIr)
    var cleanResolved = EmptyResolvedCalls(cleanSet.functionNames.len)
    var cleanStatementCursor: int32
    var cleanFunctionCursor: int32
    var cleanErr: str
    assert(ccsg.CompilerCsgReachableExpandFromTypedIr(cleanSet,
                                                      cleanIr,
                                                      cleanResolved,
                                                      cleanStatementCursor,
                                                      cleanFunctionCursor,
                                                      cleanErr),
           strutil.Join([" reachability smoke: statement clean build ", cleanErr], ""))
    AssertReachabilityTransactionEqual(failedSet, cleanSet, "statement retry equals clean")
    assert(failedStatementCursor == cleanStatementCursor &&
           failedFunctionCursor == cleanFunctionCursor,
           " reachability smoke: statement retry cursor equivalence")
    ccsg.CompilerCsgSemanticResolvedCallTableRelease(failedResolved)
    ccsg.CompilerCsgSemanticResolvedCallTableRelease(cleanResolved)
    texpr.TypedExprIrReleasePayload(failedIr)
    texpr.TypedExprIrReleasePayload(cleanIr)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(failedSet)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(untouchedSet)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(cleanSet)

fn InitReturnReachability(sourcePath: str,
                          set: var ccsg.CompilerCsgReachableFunctionSet) =
    InitReachableSet(sourcePath, set)
    let secondCaller = AddReachableFunction(sourcePath, "SecondCaller", 9, 12, true, set)
    let targetA = AddReachableFunction(sourcePath, "TargetA", 13, 16, false, set)
    let targetB = AddReachableFunction(sourcePath, "TargetB", 17, 20, false, set)
    assert(secondCaller == 1 && targetA == 2 && targetB == 3,
           " reachability smoke: return target indexes")
    SealReachableFixture(set, "return reachability")

fn BuildReturnTypedIr(sourcePath: str,
                      ir: var texpr.TypedExprIr) =
    ir.internPool = langintern.InternPoolNew()
    AppendTypedIrFunction(ir, sourcePath, "Caller", 1, 0, 0)
    AppendTypedIrFunction(ir, sourcePath, "SecondCaller", 9, 0, 0)

fn BuildReturnResolvedCalls(functionCount: int32,
                            sourcePath: str,
                            secondTarget: str): ccsg.CompilerCsgSemanticResolvedCallTable =
    var table = EmptyResolvedCalls(functionCount)
    AppendResolvedReturnRow(table, 0, sourcePath, 1, "TargetA")
    AppendResolvedReturnRow(table, 1, sourcePath, 9, secondTarget)
    return table

fn AssertTypedIrReturnBatchAtomicRetry(sourcePath: str) =
    var failedSet: ccsg.CompilerCsgReachableFunctionSet
    InitReturnReachability(sourcePath, failedSet)
    var untouchedSet: ccsg.CompilerCsgReachableFunctionSet
    InitReturnReachability(sourcePath, untouchedSet)
    var failedIr: texpr.TypedExprIr
    BuildReturnTypedIr(sourcePath, failedIr)
    var failedResolved = BuildReturnResolvedCalls(failedSet.functionNames.len,
                                                  sourcePath,
                                                  "")
    var failedStatementCursor: int32
    var failedFunctionCursor: int32
    var failedErr: str
    assert(!ccsg.CompilerCsgReachableExpandFromTypedIr(failedSet,
                                                       failedIr,
                                                       failedResolved,
                                                       failedStatementCursor,
                                                       failedFunctionCursor,
                                                       failedErr) &&
           strings.StrContains(failedErr, "return-call target missing") &&
           failedStatementCursor == 0 && failedFunctionCursor == 0,
           strutil.Join([" reachability smoke: return late failure ", failedErr], ""))
    AssertReachabilityTransactionEqual(failedSet, untouchedSet, "return failure atomic")

    failedResolved.callCalleeIds[1] = langintern.Intern(failedResolved.internPool, "TargetB")
    failedResolved.callTargetIds[1] = langintern.Intern(failedResolved.internPool, "TargetB")
    assert(ccsg.CompilerCsgReachableExpandFromTypedIr(failedSet,
                                                      failedIr,
                                                      failedResolved,
                                                      failedStatementCursor,
                                                      failedFunctionCursor,
                                                      failedErr),
           strutil.Join([" reachability smoke: return retry ", failedErr], ""))

    var cleanSet: ccsg.CompilerCsgReachableFunctionSet
    InitReturnReachability(sourcePath, cleanSet)
    var cleanIr: texpr.TypedExprIr
    BuildReturnTypedIr(sourcePath, cleanIr)
    var cleanResolved = BuildReturnResolvedCalls(cleanSet.functionNames.len,
                                                 sourcePath,
                                                 "TargetB")
    var cleanStatementCursor: int32
    var cleanFunctionCursor: int32
    var cleanErr: str
    assert(ccsg.CompilerCsgReachableExpandFromTypedIr(cleanSet,
                                                      cleanIr,
                                                      cleanResolved,
                                                      cleanStatementCursor,
                                                      cleanFunctionCursor,
                                                      cleanErr),
           strutil.Join([" reachability smoke: return clean build ", cleanErr], ""))
    AssertReachabilityTransactionEqual(failedSet, cleanSet, "return retry equals clean")
    assert(failedStatementCursor == cleanStatementCursor &&
           failedFunctionCursor == cleanFunctionCursor,
           " reachability smoke: return retry cursor equivalence")
    ccsg.CompilerCsgSemanticResolvedCallTableRelease(failedResolved)
    ccsg.CompilerCsgSemanticResolvedCallTableRelease(cleanResolved)
    texpr.TypedExprIrReleasePayload(failedIr)
    texpr.TypedExprIrReleasePayload(cleanIr)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(failedSet)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(untouchedSet)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(cleanSet)

fn AssertReachabilityDeltaCommitPreflightAtomic(sourcePath: str) =
    var edgeSet: ccsg.CompilerCsgReachableFunctionSet
    InitTwoCallReachability(sourcePath, edgeSet)
    AddAccumulatorPaddingFunctions(sourcePath, edgeSet)
    var edgeControl: ccsg.CompilerCsgReachableFunctionSet
    InitTwoCallReachability(sourcePath, edgeControl)
    AddAccumulatorPaddingFunctions(sourcePath, edgeControl)
    var edgeDelta = ccsg.CompilerCsgReachabilityDeltaInit()
    ccsg.CompilerCsgReachabilityDeltaAddEdge(edgeSet, edgeDelta, 0, 1)
    ccsg.CompilerCsgReachabilityDeltaAddEdge(edgeSet, edgeDelta, 0, 2)
    let exactStagedCapacityBytes =
        Int64(9) * Int64(24) +
        Int64(edgeDelta.functionIndex.slots.cap +
              edgeDelta.functionIndex.keys.cap +
              edgeDelta.functionEdgeHeads.cap +
              edgeDelta.functionMarkQueuePositions.cap +
              edgeDelta.markQueue.cap + edgeDelta.edgeFrom.cap +
              edgeDelta.edgeTo.cap + edgeDelta.edgeNext.cap) * Int64(4) +
        Int64(edgeDelta.functionMarked.cap)
    assert(ccsg.CompilerCsgReachabilityDeltaCapacityBytes(edgeDelta) ==
               exactStagedCapacityBytes &&
           edgeDelta.functionIndex.keys.len == 3 &&
           edgeDelta.functionEdgeHeads.len == 3 &&
           edgeDelta.functionMarked.len == 3 &&
           edgeDelta.functionMarkQueuePositions.len == 3,
           " reachability smoke: delta staging is not sparse/fully accounted")
    edgeDelta.edgeTo[1] = edgeSet.functionNames.len
    var edgeErr: str
    assert(!ccsg.CompilerCsgReachabilityDeltaCommit(edgeSet, edgeDelta, edgeErr) &&
           strings.StrContains(edgeErr, "delta edge invalid"),
           strutil.Join([" reachability smoke: staged edge preflight ", edgeErr], ""))
    AssertReachabilityTransactionEqual(edgeSet,
                                       edgeControl,
                                       "staged second-edge failure atomic")

    var markSet: ccsg.CompilerCsgReachableFunctionSet
    InitTwoCallReachability(sourcePath, markSet)
    var markControl: ccsg.CompilerCsgReachableFunctionSet
    InitTwoCallReachability(sourcePath, markControl)
    var markDelta = ccsg.CompilerCsgReachabilityDeltaInit()
    ccsg.CompilerCsgReachabilityDeltaMark(markSet, markDelta, 1)
    let markedRow = ccsg.CompilerCsgSparseIntIndexFind(markDelta.functionIndex, 1)
    markDelta.functionMarkQueuePositions[markedRow] = 7
    var markErr: str
    assert(!ccsg.CompilerCsgReachabilityDeltaCommit(markSet, markDelta, markErr) &&
           strings.StrContains(markErr, "mark owner invalid"),
           strutil.Join([" reachability smoke: staged mark preflight ", markErr], ""))
    AssertReachabilityTransactionEqual(markSet,
                                       markControl,
                                       "staged mark failure atomic")

    var graphSet: ccsg.CompilerCsgReachableFunctionSet
    InitTwoCallReachability(sourcePath, graphSet)
    var graphControl: ccsg.CompilerCsgReachableFunctionSet
    InitTwoCallReachability(sourcePath, graphControl)
    var graphDelta = ccsg.CompilerCsgReachabilityDeltaInit()
    ccsg.CompilerCsgReachabilityDeltaAddEdge(graphSet, graphDelta, 0, 1)
    graphSet.edgeHeads[0] = 99
    graphControl.edgeHeads[0] = 99
    var graphErr: str
    assert(!ccsg.CompilerCsgReachabilityDeltaCommit(graphSet, graphDelta, graphErr) &&
           strings.StrContains(graphErr, "edge-head content certificate mismatch"),
           strutil.Join([" reachability smoke: committed graph preflight ", graphErr], ""))
    AssertReachabilityTransactionEqual(graphSet,
                                       graphControl,
                                       "committed graph failure atomic")
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(edgeSet)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(edgeControl)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(markSet)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(markControl)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(graphSet)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(graphControl)

fn AssertFrontierCursorColumnInvariant(sourcePath: str) =
    var set: ccsg.CompilerCsgReachableFunctionSet
    InitReachableSet(sourcePath, set)
    set.sourcePaths = []
    var processedFunctions: bool[]
    var reachableCursor: int32
    var sourcePaths: str[]
    var functionNames: str[]
    var startLines: int32[]
    var functionIndexes: int32[]
    var err: str
    assert(!ccsg.CompilerCsgReachableFilterArraysUnprocessed(set,
                                                            processedFunctions,
                                                            reachableCursor,
                                                            1,
                                                            sourcePaths,
                                                            functionNames,
                                                            startLines,
                                                            functionIndexes,
                                                            err) &&
           strings.StrContains(err, "function columns corrupt") &&
           reachableCursor == 0 && functionIndexes.len == 0,
           strutil.Join([" reachability smoke: frontier cursor commits only valid rows ", err], ""))
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(set)

fn InitFilterRetrySet(sourcePath: str,
                      set: var ccsg.CompilerCsgReachableFunctionSet) =
    InitReachableSet(sourcePath, set)
    let second = AddReachableFunction(sourcePath, "Second", 9, 12, true, set)
    assert(second == 1,
           " reachability smoke: filter retry second index")
    SealReachableFixture(set, "filter retry")

fn AssertFilterLateRowAtomicRetry(sourcePath: str) =
    var failedSet: ccsg.CompilerCsgReachableFunctionSet
    InitFilterRetrySet(sourcePath, failedSet)
    setLen(failedSet.sourcePaths, 1)
    var processedFunctions: bool[] = [false]
    var reachableCursor: int32
    var sourcePaths: str[] = ["sentinel-source"]
    var functionNames: str[] = ["sentinel-function"]
    var startLines: int32[] = [-7]
    var functionIndexes: int32[] = [-9]
    var err: str
    assert(!ccsg.CompilerCsgReachableFilterArraysUnprocessed(failedSet,
                                                            processedFunctions,
                                                            reachableCursor,
                                                            2,
                                                            sourcePaths,
                                                            functionNames,
                                                            startLines,
                                                            functionIndexes,
                                                            err) &&
           strings.StrContains(err, "function columns corrupt") &&
           reachableCursor == 0 && processedFunctions.len == 1 &&
           !processedFunctions[0] &&
           sourcePaths.len == 1 && sourcePaths[0] == "sentinel-source" &&
           functionNames.len == 1 && functionNames[0] == "sentinel-function" &&
           startLines.len == 1 && startLines[0] == -7 &&
           functionIndexes.len == 1 && functionIndexes[0] == -9,
           strutil.Join([" reachability smoke: filter late failure ", err], ""))
    add(failedSet.sourcePaths, sourcePath)
    assert(ccsg.CompilerCsgReachableFilterArraysUnprocessed(failedSet,
                                                           processedFunctions,
                                                           reachableCursor,
                                                           2,
                                                           sourcePaths,
                                                           functionNames,
                                                           startLines,
                                                           functionIndexes,
                                                           err),
           strutil.Join([" reachability smoke: filter retry ", err], ""))

    var cleanSet: ccsg.CompilerCsgReachableFunctionSet
    InitFilterRetrySet(sourcePath, cleanSet)
    var cleanProcessed: bool[] = [false]
    var cleanCursor: int32
    var cleanSources: str[] = ["sentinel-source"]
    var cleanFunctions: str[] = ["sentinel-function"]
    var cleanStarts: int32[] = [-7]
    var cleanIndexes: int32[] = [-9]
    var cleanErr: str
    assert(ccsg.CompilerCsgReachableFilterArraysUnprocessed(cleanSet,
                                                           cleanProcessed,
                                                           cleanCursor,
                                                           2,
                                                           cleanSources,
                                                           cleanFunctions,
                                                           cleanStarts,
                                                           cleanIndexes,
                                                           cleanErr),
           strutil.Join([" reachability smoke: filter clean ", cleanErr], ""))
    AssertBoolArraysEqual(processedFunctions, cleanProcessed, "filter processed retry")
    AssertStrArraysEqual(sourcePaths, cleanSources, "filter source retry")
    AssertStrArraysEqual(functionNames, cleanFunctions, "filter function retry")
    AssertInt32ArraysEqual(startLines, cleanStarts, "filter starts retry")
    AssertInt32ArraysEqual(functionIndexes, cleanIndexes, "filter indexes retry")
    assert(reachableCursor == cleanCursor,
           " reachability smoke: filter cursor retry equivalence")
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(failedSet)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(cleanSet)

fn AssertProfileQueueLateRowAtomicRetry(sourcePath: str) =
    var failedSet: ccsg.CompilerCsgReachableFunctionSet
    InitFilterRetrySet(sourcePath, failedSet)
    failedSet.functionProfileIndexes[1] = 7
    var failedDelta = ccsg.CompilerCsgReachabilityDeltaInit()
    var processedFunctions: bool[]
    var reachableCursor: int32
    var queuedProfiles: bool[] = [false]
    var pendingProfiles: int32[]
    var err: str
    assert(!ccsg.CompilerCsgQueueReachableSourceProfiles(failedSet,
                                                        failedDelta,
                                                        processedFunctions,
                                                        reachableCursor,
                                                        queuedProfiles,
                                                        pendingProfiles,
                                                        err) &&
           strings.StrContains(err, "profile index out of range") &&
           reachableCursor == 0 && queuedProfiles.len == 1 &&
           !queuedProfiles[0] && pendingProfiles.len == 0,
           strutil.Join([" reachability smoke: profile queue late failure ", err], ""))
    failedSet.functionProfileIndexes[1] = 0
    assert(ccsg.CompilerCsgQueueReachableSourceProfiles(failedSet,
                                                       failedDelta,
                                                       processedFunctions,
                                                       reachableCursor,
                                                       queuedProfiles,
                                                       pendingProfiles,
                                                       err),
           strutil.Join([" reachability smoke: profile queue retry ", err], ""))

    var cleanSet: ccsg.CompilerCsgReachableFunctionSet
    InitFilterRetrySet(sourcePath, cleanSet)
    var cleanDelta = ccsg.CompilerCsgReachabilityDeltaInit()
    var cleanProcessed: bool[]
    var cleanCursor: int32
    var cleanQueued: bool[] = [false]
    var cleanPending: int32[]
    var cleanErr: str
    assert(ccsg.CompilerCsgQueueReachableSourceProfiles(cleanSet,
                                                       cleanDelta,
                                                       cleanProcessed,
                                                       cleanCursor,
                                                       cleanQueued,
                                                       cleanPending,
                                                       cleanErr),
           strutil.Join([" reachability smoke: profile queue clean ", cleanErr], ""))
    AssertBoolArraysEqual(queuedProfiles, cleanQueued, "profile queue flags retry")
    AssertInt32ArraysEqual(pendingProfiles, cleanPending, "profile queue rows retry")
    assert(reachableCursor == cleanCursor,
           " reachability smoke: profile queue cursor retry equivalence")
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(failedSet)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(cleanSet)

fn AssertTypedIrColumnRejectPreservesState(set: var ccsg.CompilerCsgReachableFunctionSet,
                                          targetIndex: int32,
                                          ir: var texpr.TypedExprIr,
                                          expectedError: str,
                                          label: str) =
    var resolvedCalls = EmptyResolvedCalls(set.functionNames.len)
    var statementCursor: int32 = 17
    var functionCursor: int32 = 19
    let reachableCountBefore = set.reachableCount
    let edgeFromCountBefore = set.edgeFrom.len
    let edgeToCountBefore = set.edgeTo.len
    let callerEdgeHeadBefore = set.edgeHeads[0]
    let targetEdgeHeadBefore = set.edgeHeads[targetIndex]
    let scopedNameProbeBefore = set.scopedFunctionNames.hashProbeCount
    let globalNameProbeBefore = set.globalFunctionNames.hashProbeCount
    let lineProbeBefore = set.lineBinarySearchProbeCount
    let edgeProbeBefore = set.edgePairProbeCount
    let resolvedVisitBefore = set.resolvedCallRowVisitCount
    var err: str
    assert(!ccsg.CompilerCsgReachableExpandFromTypedIr(set,
                                                       ir,
                                                       resolvedCalls,
                                                       statementCursor,
                                                       functionCursor,
                                                       err) &&
           strings.StrContains(err, expectedError) &&
           statementCursor == 17 && functionCursor == 19 &&
           !set.reachable[targetIndex] && set.reachableCount == reachableCountBefore &&
           set.edgeFrom.len == edgeFromCountBefore && set.edgeTo.len == edgeToCountBefore &&
           set.edgeHeads[0] == callerEdgeHeadBefore &&
           set.edgeHeads[targetIndex] == targetEdgeHeadBefore &&
           set.scopedFunctionNames.hashProbeCount == scopedNameProbeBefore &&
           set.globalFunctionNames.hashProbeCount == globalNameProbeBefore &&
           set.lineBinarySearchProbeCount == lineProbeBefore &&
           set.edgePairProbeCount == edgeProbeBefore &&
           set.resolvedCallRowVisitCount == resolvedVisitBefore,
           strutil.Join([" reachability smoke: TypedIR column preflight ", label, " ", err], ""))
    ccsg.CompilerCsgSemanticResolvedCallTableRelease(resolvedCalls)

fn AssertTypedIrSoaColumnContracts(sourcePath: str) =
    var statementSet: ccsg.CompilerCsgReachableFunctionSet
    InitReachableSet(sourcePath, statementSet)
    let statementTarget = AddReachableFunction(sourcePath, "[]=", 9, 12, false, statementSet)
    var statementIr: texpr.TypedExprIr
    BuildDirectCallTypedIr(sourcePath, texpr.CallSurfaceIndexed, statementIr)
    statementIr.statements2_callSurfaceKinds = []
    AssertTypedIrColumnRejectPreservesState(statementSet,
                                            statementTarget,
                                            statementIr,
                                            "statement columns mismatch",
                                            "statement SoA")
    texpr.TypedExprIrReleasePayload(statementIr)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(statementSet)

    var statementArenaSet: ccsg.CompilerCsgReachableFunctionSet
    InitReachableSet(sourcePath, statementArenaSet)
    let statementArenaTarget = AddReachableFunction(sourcePath, "[]=", 9, 12, false, statementArenaSet)
    var statementArenaIr: texpr.TypedExprIr
    BuildDirectCallTypedIr(sourcePath, texpr.CallSurfaceIndexed, statementArenaIr)
    var emptyStatementLines: arenamod.ArenaArrayInt32
    statementArenaIr.statements2_lineNumbers = emptyStatementLines
    AssertTypedIrColumnRejectPreservesState(statementArenaSet,
                                            statementArenaTarget,
                                            statementArenaIr,
                                            "statement columns mismatch",
                                            "statement arena")
    texpr.TypedExprIrReleasePayload(statementArenaIr)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(statementArenaSet)

    var functionSourceSet: ccsg.CompilerCsgReachableFunctionSet
    InitReachableSet(sourcePath, functionSourceSet)
    let functionSourceTarget = AddReachableFunction(sourcePath, "[]=", 9, 12, false, functionSourceSet)
    var functionSourceIr: texpr.TypedExprIr
    BuildDirectCallTypedIr(sourcePath, texpr.CallSurfaceIndexed, functionSourceIr)
    functionSourceIr.functions2_sourcePathIds = []
    AssertTypedIrColumnRejectPreservesState(functionSourceSet,
                                            functionSourceTarget,
                                            functionSourceIr,
                                            "function columns mismatch",
                                            "function source SoA")
    var returnResolvedCalls = EmptyResolvedCalls(functionSourceSet.functionNames.len)
    var returnFunctionCursor: int32 = 23
    var returnFrontier: int32[]
    var returnErr: str
    assert(!ccsg.CompilerCsgReachableCollectReturnExprEdges(functionSourceSet,
                                                            functionSourceIr,
                                                            returnResolvedCalls,
                                                            returnFunctionCursor,
                                                            returnFrontier,
                                                            returnErr) &&
           strings.StrContains(returnErr, "function columns mismatch") &&
           returnFunctionCursor == 23 && returnFrontier.len == 0 &&
           !functionSourceSet.reachable[functionSourceTarget] &&
           functionSourceSet.edgeFrom.len == 0 && functionSourceSet.edgeTo.len == 0,
           strutil.Join([" reachability smoke: return function-column preflight ", returnErr], ""))
    ccsg.CompilerCsgSemanticResolvedCallTableRelease(returnResolvedCalls)
    texpr.TypedExprIrReleasePayload(functionSourceIr)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(functionSourceSet)

    var functionNameSet: ccsg.CompilerCsgReachableFunctionSet
    InitReachableSet(sourcePath, functionNameSet)
    let functionNameTarget = AddReachableFunction(sourcePath, "[]=", 9, 12, false, functionNameSet)
    var functionNameIr: texpr.TypedExprIr
    BuildDirectCallTypedIr(sourcePath, texpr.CallSurfaceIndexed, functionNameIr)
    functionNameIr.functions2_functionNameIds = []
    AssertTypedIrColumnRejectPreservesState(functionNameSet,
                                            functionNameTarget,
                                            functionNameIr,
                                            "function columns mismatch",
                                            "function name SoA")
    texpr.TypedExprIrReleasePayload(functionNameIr)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(functionNameSet)

    var functionArenaSet: ccsg.CompilerCsgReachableFunctionSet
    InitReachableSet(sourcePath, functionArenaSet)
    let functionArenaTarget = AddReachableFunction(sourcePath, "[]=", 9, 12, false, functionArenaSet)
    var functionArenaIr: texpr.TypedExprIr
    BuildDirectCallTypedIr(sourcePath, texpr.CallSurfaceIndexed, functionArenaIr)
    var emptySignatureLines: arenamod.ArenaArrayInt32
    functionArenaIr.functions2_signatureLineNumbers = emptySignatureLines
    AssertTypedIrColumnRejectPreservesState(functionArenaSet,
                                            functionArenaTarget,
                                            functionArenaIr,
                                            "function columns mismatch",
                                            "function arena")
    texpr.TypedExprIrReleasePayload(functionArenaIr)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(functionArenaSet)

fn AssertResolvedSnapshotReject(set: var ccsg.CompilerCsgReachableFunctionSet,
                                sourcePath: str,
                                targetName: str,
                                targetSourcePath: str,
                                callResolved: bool,
                                expectedError: str) =
    var fact: texpr.TypedExprFact
    fact.exprId = "negative-call"
    fact.sourcePath = sourcePath
    fact.lineNumber = 2
    fact.columnNumber = 5
    fact.kind = parser.NormalizedExprCall
    fact.surfaceCallKind = texpr.TypedExprSurfaceCallLocal
    fact.callResolved = callResolved
    fact.callReason = texpr.TypedExprCallReasonNone
    fact.callCallee = "Target"
    fact.callTarget = targetName
    fact.callTargetSourcePath = targetSourcePath
    fact.callKind = texpr.TypedExprCallNone
    fact.typeCallKind = texpr.TypedExprTypeCallNone
    var facts: texpr.TypedExprFactTable
    texpr.TypedExprFactTableAppendHandBuilt(facts, fact)

    var sourceIndex = ccsg.CompilerCsgSourcePathIndexInit(4)
    ConfigureSmokeSourceIndex(sourceIndex)
    var indexErr: str
    assert(ccsg.CompilerCsgSourcePathIndexRegister(sourceIndex,
                                                   sourcePath,
                                                   0,
                                                   indexErr),
           strutil.Join([" reachability smoke: source index ", indexErr], ""))
    var semanticGraph: ccsg.CompilerCsgSemanticGraph
    var accumulator = ccsg.CompilerCsgSemanticTypedFactAccumulatorInit(semanticGraph,
                                                                 sourceIndex,
                                                                 set.functionNames.len)
    var appendErr: str
    let appended = ccsg.CompilerCsgSemanticTypedFactAccumulatorAppend(semanticGraph,
                                                                accumulator,
                                                                set,
                                                                0,
                                                                facts,
                                                                0,
                                                                facts.count,
                                                                appendErr)
    assert(!appended && strings.StrContains(appendErr, expectedError),
           strutil.Join([" reachability smoke: expected ", expectedError, " got ", appendErr], ""))
    ccsg.CompilerCsgSemanticTypedFactAccumulatorFinish(semanticGraph, accumulator)
    ccsg.CompilerCsgSemanticResolvedCallTableRelease(semanticGraph.resolvedCallTable)
    texpr.TypedExprFactTableRelease(facts)

fn BuildAmbiguousProfileReachability(sourcePath: str,
                                     set: var ccsg.CompilerCsgReachableFunctionSet) =
    var profile: parser.NormalizedExprCallProfile
    profile.sourcePath = sourcePath
    profile.ownerModulePath = "smoke"
    var caller: parser.NormalizedFunctionDecl
    caller.name = "Caller"
    caller.lineIndex = 1
    caller.surfaceKeyword = "fn"
    add(profile.decls, caller)
    var targetA: parser.NormalizedFunctionDecl
    targetA.name = "Target"
    targetA.lineIndex = 9
    targetA.surfaceKeyword = "fn"
    add(profile.decls, targetA)
    var targetB = targetA
    targetB.lineIndex = 13
    add(profile.decls, targetB)
    add(profile.localCallNames, "Caller")
    add(profile.localCallNames, "Target")
    var profiles: parser.NormalizedExprCallProfile[] = [profile]
    var modules: str[] = ["smoke"]
    var lineCounts: int32[] = [16]
    var sourceIdentity = ccsg.CompilerCsgSourcePathIndexInit(4)
    ConfigureSmokeSourceIndex(sourceIdentity)
    set = ccsg.CompilerCsgReachableFunctionSetInit(true)
    var buildErr: str
    assert(ccsg.CompilerCsgReachableAddFunctionsFromProfiles(set,
                                                             profiles,
                                                             modules,
                                                             lineCounts,
                                                             sourceIdentity,
                                                             buildErr),
           strutil.Join([" reachability smoke: ambiguous profile build ", buildErr], ""))
    var frontier: int32[]
    ccsg.CompilerCsgReachableMark(set, 0, frontier)
    ccsg.CompilerCsgSourcePathIndexClear(sourceIdentity)

fn AssertMemberReturnSnapshotEdge(sourcePath: str) =
    var set: ccsg.CompilerCsgReachableFunctionSet
    InitReachableSet(sourcePath, set)
    let methodIndex = AddReachableFunction(sourcePath, "Method", 9, 12, false, set)
    SealReachableFixture(set, "member return")
    var sourceIndex = ccsg.CompilerCsgSourcePathIndexInit(4)
    ConfigureSmokeSourceIndex(sourceIndex)
    var sourceIndexErr: str
    assert(ccsg.CompilerCsgSourcePathIndexRegister(sourceIndex,
                                                   sourcePath,
                                                   0,
                                                   sourceIndexErr),
           strutil.Join([" reachability smoke: member source index ", sourceIndexErr], ""))
    var semanticGraph: ccsg.CompilerCsgSemanticGraph
    semanticGraph.sourceTable.sourcePaths = [sourcePath]
    var accumulator = ccsg.CompilerCsgSemanticTypedFactAccumulatorInit(semanticGraph,
                                                                  sourceIndex,
                                                                  set.functionNames.len)
    var memberFact: texpr.TypedExprFact
    memberFact.exprId = "member-return"
    memberFact.sourcePath = sourcePath
    memberFact.lineNumber = 2
    memberFact.columnNumber = 5
    memberFact.kind = parser.NormalizedExprCall
    memberFact.surfaceCallKind = texpr.TypedExprSurfaceCallMember
    memberFact.callResolved = true
    memberFact.callReason = texpr.TypedExprCallReasonNone
    memberFact.callQualifier = "obj"
    memberFact.callCallee = "obj.Method"
    memberFact.callTarget = "Method"
    memberFact.callTargetSourcePath = sourcePath
    memberFact.callKind = texpr.TypedExprCallNone
    memberFact.typeCallKind = texpr.TypedExprTypeCallNone
    memberFact.returnRoot = true
    var facts: texpr.TypedExprFactTable
    texpr.TypedExprFactTableAppendHandBuilt(facts, memberFact)
    assert(!ccsg.CompilerCsgTypedFactIsReachabilityExecutableCall(memberFact) &&
           ccsg.CompilerCsgTypedFactIsResolvedCallSnapshot(memberFact),
           " reachability smoke: member snapshot classification separation")
    var appendErr: str
    assert(ccsg.CompilerCsgSemanticTypedFactAccumulatorAppend(semanticGraph,
                                                        accumulator,
                                                        set,
                                                        0,
                                                        facts,
                                                        0,
                                                        facts.count,
                                                        appendErr) &&
           semanticGraph.resolvedCallTable.sourceIndexes.len == 1 &&
           semanticGraph.resolvedCallTable.returnRootFlags[0] &&
           semanticGraph.typedFactTable.summary.surfaceCallMemberCount == 1,
           strutil.Join([" reachability smoke: member snapshot append ", appendErr], ""))
    var ir: texpr.TypedExprIr
    ir.internPool = langintern.InternPoolNew()
    AppendTypedIrFunction(ir, sourcePath, "Caller", 1, 0, 0)
    AppendTypedIrFunction(ir, sourcePath, "Method", 9, 0, 0)
    var functionCursor: int32
    var frontier: int32[]
    var reachErr: str
    assert(ccsg.CompilerCsgReachableCollectReturnExprEdges(set,
                                                           ir,
                                                           semanticGraph.resolvedCallTable,
                                                           functionCursor,
                                                           frontier,
                                                           reachErr),
           strutil.Join([" reachability smoke: member return snapshot consume ", reachErr], ""))
    assert(set.reachable[methodIndex] && set.edgeFrom.len == 1 &&
           set.edgeFrom[0] == 0 && set.edgeTo[0] == methodIndex &&
           frontier.len == 1 && frontier[0] == methodIndex,
           " reachability smoke: return obj.Method edge missing")
    ccsg.CompilerCsgSemanticTypedFactAccumulatorFinish(semanticGraph, accumulator)
    ccsg.CompilerCsgSemanticResolvedCallTableRelease(semanticGraph.resolvedCallTable)
    texpr.TypedExprFactTableRelease(facts)
    texpr.TypedExprIrReleasePayload(ir)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(set)

fn AssertAmbiguousCandidateExpansionPreservesLegacy(sourcePath: str) =
    var factSet: ccsg.CompilerCsgReachableFunctionSet
    BuildAmbiguousProfileReachability(sourcePath, factSet)
    var facts: texpr.TypedExprFactTable
    AppendExecutableFact(facts, sourcePath, 2, "Target", "Target", "")
    var sourceIndex = ccsg.CompilerCsgSourcePathIndexInit(4)
    ConfigureSmokeSourceIndex(sourceIndex)
    var sourceIndexErr: str
    assert(ccsg.CompilerCsgSourcePathIndexRegister(sourceIndex,
                                                   sourcePath,
                                                   0,
                                                   sourceIndexErr),
           strutil.Join([" reachability smoke: ambiguous source index ", sourceIndexErr], ""))
    var semanticGraph: ccsg.CompilerCsgSemanticGraph
    semanticGraph.sourceTable.sourcePaths = [sourcePath]
    var accumulator = ccsg.CompilerCsgSemanticTypedFactAccumulatorInit(semanticGraph,
                                                                  sourceIndex,
                                                                  factSet.functionNames.len)
    var err: str
    assert(ccsg.CompilerCsgSemanticTypedFactAccumulatorAppend(semanticGraph,
                                                        accumulator,
                                                        factSet,
                                                        0,
                                                        facts,
                                                        0,
                                                        facts.count,
                                                        err) &&
           semanticGraph.resolvedCallTable.sourceIndexes.len == 1,
           strutil.Join([" reachability smoke: ambiguous snapshot retains fact ", err], ""))
    assert(ccsg.CompilerCsgReachableExpandFromTypedFacts(factSet, facts, err),
           strutil.Join([" reachability smoke: ambiguous fact expansion ", err], ""))
    assert(factSet.reachable[1] && factSet.reachable[2] &&
           factSet.edgeFrom.len == 2 && factSet.edgeTo.len == 2 &&
           factSet.edgeFrom[0] == 0 && factSet.edgeTo[0] == 1 &&
           factSet.edgeFrom[1] == 0 && factSet.edgeTo[1] == 2,
           " reachability smoke: ambiguous facts did not retain every legacy candidate")

    var irSet: ccsg.CompilerCsgReachableFunctionSet
    BuildAmbiguousProfileReachability(sourcePath, irSet)
    var ir: texpr.TypedExprIr
    ir.internPool = langintern.InternPoolNew()
    AppendDirectCallStatement(ir, sourcePath, 0, 2, "Target")
    AppendTypedIrFunction(ir, sourcePath, "Caller", 1, 0, 1)
    AppendTypedIrFunction(ir, sourcePath, "Target", 9, 1, 0)
    AppendTypedIrFunction(ir, sourcePath, "Target", 13, 1, 0)
    var resolvedCalls = EmptyResolvedCalls(irSet.functionNames.len)
    var statementCursor: int32
    var functionCursor: int32
    assert(ccsg.CompilerCsgReachableExpandFromTypedIr(irSet,
                                                      ir,
                                                      resolvedCalls,
                                                      statementCursor,
                                                      functionCursor,
                                                      err),
           strutil.Join([" reachability smoke: ambiguous TypedIR expansion ", err], ""))
    assert(irSet.reachable[1] && irSet.reachable[2] &&
           irSet.edgeTo.len == 2 && irSet.edgeTo[0] == 1 && irSet.edgeTo[1] == 2,
           " reachability smoke: ambiguous TypedIR did not retain every legacy candidate")
    ccsg.CompilerCsgSemanticTypedFactAccumulatorFinish(semanticGraph, accumulator)
    ccsg.CompilerCsgSemanticResolvedCallTableRelease(semanticGraph.resolvedCallTable)
    ccsg.CompilerCsgSemanticResolvedCallTableRelease(resolvedCalls)
    texpr.TypedExprFactTableRelease(facts)
    texpr.TypedExprIrReleasePayload(ir)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(factSet)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(irSet)

fn AssertRetainedFrontierLateFailureAtomic(sourcePath: str) =
    var set: ccsg.CompilerCsgReachableFunctionSet
    InitReachableSet(sourcePath, set)
    set.endLines[0] = 4
    let secondIndex = AddReachableFunction(sourcePath, "Second", 5, 8, false, set)
    SealReachableFixture(set, "retained late failure")
    var controlSet: ccsg.CompilerCsgReachableFunctionSet
    InitReachableSet(sourcePath, controlSet)
    controlSet.endLines[0] = 4
    let _ = AddReachableFunction(sourcePath, "Second", 5, 8, false, controlSet)
    SealReachableFixture(controlSet, "retained late control")
    var retained: parser.NormalizedExprLayer
    AppendFrontierCallExpr(retained, sourcePath, 2, "First")
    AppendFrontierCallExpr(retained, sourcePath, 99, "BrokenOwner")
    var frontierIndex: ccsg.CompilerCsgFrontierIndex
    ccsg.CompilerCsgFrontierIndexBegin(frontierIndex, 1, set.functionNames.len)
    var controlFrontier: ccsg.CompilerCsgFrontierIndex
    ccsg.CompilerCsgFrontierIndexBegin(controlFrontier, 1, controlSet.functionNames.len)
    var output: parser.NormalizedExprLayer
    AppendFrontierCallExpr(output, sourcePath, 77, "Sentinel")
    output.sourceCount = 1
    var controlOutput: parser.NormalizedExprLayer
    AppendFrontierCallExpr(controlOutput, sourcePath, 77, "Sentinel")
    controlOutput.sourceCount = 1
    var frontierSources: str[] = [sourcePath]
    var frontierFunctions: int32[] = [0, secondIndex]
    var err: str
    assert(!ccsg.CompilerCsgCopyRetainedTypedIrExprLayer(retained,
                                                         frontierSources,
                                                         frontierFunctions,
                                                         set,
                                                         frontierIndex,
                                                         output,
                                                         err) &&
           strings.StrContains(err, "retained expr function missing"),
           strutil.Join([" reachability smoke: retained late failure ", err], ""))
    AssertFrontierIndexEqual(frontierIndex,
                             controlFrontier,
                             "retained late failure frontier")
    AssertExprLayerEqual(output, controlOutput, "retained late failure output")
    AssertReachabilityTransactionEqual(set, controlSet, "retained late failure probes")
    setLen(retained.exprs, 1)
    var correctedFunctions: int32[] = [0]
    assert(ccsg.CompilerCsgCopyRetainedTypedIrExprLayer(retained,
                                                        frontierSources,
                                                        correctedFunctions,
                                                        set,
                                                        frontierIndex,
                                                        output,
                                                        err),
           strutil.Join([" reachability smoke: retained retry ", err], ""))
    assert(frontierIndex.retainedExprBuiltCount == 1 &&
           frontierIndex.retainedExprNext.len == 1 &&
           output.exprs.len == 1 && output.exprs[0].lineNumber == 2 &&
           frontierIndex.lastStagingCapacity.frontierAdjacencyBytes > Int64(0) &&
           frontierIndex.lastStagingCapacity.frontierOutputBytes > Int64(0),
           " reachability smoke: retained retry did not commit exact transaction")
    AssertStagingLedgerExact(frontierIndex.lastStagingCapacity,
                             "retained frontier retry")
    var mutationControl = frontierIndex
    frontierIndex.retainedExprNext[0] = 0
    mutationControl.retainedExprNext[0] = 0
    var mutationOutput: parser.NormalizedExprLayer
    AppendFrontierCallExpr(mutationOutput, sourcePath, 79, "MutationSentinel")
    var mutationControlOutput: parser.NormalizedExprLayer
    AppendFrontierCallExpr(mutationControlOutput,
                           sourcePath,
                           79,
                           "MutationSentinel")
    assert(!ccsg.CompilerCsgCopyRetainedTypedIrExprLayer(retained,
                                                         frontierSources,
                                                         correctedFunctions,
                                                         set,
                                                         frontierIndex,
                                                         mutationOutput,
                                                         err) &&
           strings.StrContains(err, "retained content certificate mismatch"),
           strutil.Join([" reachability smoke: retained same-shape mutation ", err], ""))
    AssertFrontierIndexEqual(frontierIndex,
                             mutationControl,
                             "retained same-shape mutation atomic")
    AssertExprLayerEqual(mutationOutput,
                         mutationControlOutput,
                         "retained same-shape output atomic")
    frontierIndex.retainedExprNext[0] = -1
    mutationControl.retainedExprNext[0] = -1
    assert(ccsg.CompilerCsgCopyRetainedTypedIrExprLayer(retained,
                                                        frontierSources,
                                                        correctedFunctions,
                                                        set,
                                                        frontierIndex,
                                                        mutationOutput,
                                                        err),
           strutil.Join([" reachability smoke: retained mutation retry ", err], ""))
    assert(mutationOutput.exprs.len == 1 &&
           mutationOutput.exprs[0].lineNumber == 2,
           " reachability smoke: retained mutation retry output")
    parser.NormalizedExprLayerReset(retained)
    parser.NormalizedExprLayerReset(output)
    parser.NormalizedExprLayerReset(controlOutput)
    parser.NormalizedExprLayerReset(mutationOutput)
    parser.NormalizedExprLayerReset(mutationControlOutput)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(set)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(controlSet)

fn AssertFrontierIndexOperationCountLinear(sourcePath: str) =
    var set: ccsg.CompilerCsgReachableFunctionSet
    InitReachableSet(sourcePath, set)
    set.endLines[0] = 4
    SealReachableFixture(set, "frontier operation count")
    var retained: parser.NormalizedExprLayer
    AppendFrontierCallExpr(retained, sourcePath, 2, "Counted")
    var frontierIndex: ccsg.CompilerCsgFrontierIndex
    ccsg.CompilerCsgFrontierIndexBegin(frontierIndex, 1, set.functionNames.len)
    var output: parser.NormalizedExprLayer
    var frontierSources: str[] = [sourcePath]
    var frontierFunctions: int32[] = [0]
    var err: str
    assert(ccsg.CompilerCsgCopyRetainedTypedIrExprLayer(retained,
                                                        frontierSources,
                                                        frontierFunctions,
                                                        set,
                                                        frontierIndex,
                                                        output,
                                                        err),
           strutil.Join([" reachability smoke: frontier operation warmup ", err], ""))
    let buildBefore = frontierIndex.certificateBuildOperationCount
    let validationBefore = frontierIndex.certificateValidationOperationCount
    let queryBefore = frontierIndex.queryOperationCount
    let totalBefore = ccsg.CompilerCsgFrontierIndexOperationCount(frontierIndex)
    var steadyLedger: ccsg.CompilerCsgStagingCapacityLedger
    for roundIndex in 0..<16:
        let roundBefore = ccsg.CompilerCsgFrontierIndexOperationCount(frontierIndex)
        assert(ccsg.CompilerCsgCopyRetainedTypedIrExprLayer(retained,
                                                            frontierSources,
                                                            frontierFunctions,
                                                            set,
                                                            frontierIndex,
                                                            output,
                                                            err),
               strutil.Join([" reachability smoke: frontier operation round ",
                             strings.IntToStr(roundIndex), " ", err], ""))
        let roundDelta = ccsg.CompilerCsgFrontierIndexOperationCount(frontierIndex) -
                         roundBefore
        assert(roundDelta > Int64(0) && roundDelta <= Int64(16) &&
               output.exprs.len == 1 && output.exprs[0].lineNumber == 2,
               " reachability smoke: frontier operation round exceeded bounded work")
        if roundIndex == 0:
            steadyLedger = frontierIndex.lastStagingCapacity
        else:
            AssertStagingLedgerEqual(frontierIndex.lastStagingCapacity,
                                     steadyLedger,
                                     "frontier operation steady capacity")
    let buildDelta = frontierIndex.certificateBuildOperationCount - buildBefore
    let validationDelta = frontierIndex.certificateValidationOperationCount -
                          validationBefore
    let queryDelta = frontierIndex.queryOperationCount - queryBefore
    let totalDelta = ccsg.CompilerCsgFrontierIndexOperationCount(frontierIndex) -
                     totalBefore
    assert(buildDelta > Int64(0) && validationDelta > Int64(0) &&
           queryDelta == Int64(32) &&
           totalDelta == buildDelta + validationDelta + queryDelta &&
           totalDelta <= Int64(16 * 16),
           " reachability smoke: frontier validation/query/update work is not linear")
    parser.NormalizedExprLayerReset(retained)
    parser.NormalizedExprLayerReset(output)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(set)

fn AssertParserFrontierLateFailureAtomic(sourcePath: str) =
    let sourceA = strutil.Join([sourcePath, ".parser-a"], "")
    let sourceB = strutil.Join([sourcePath, ".parser-b"], "")
    var profiles: parser.NormalizedExprCallProfile[]
    var set: ccsg.CompilerCsgReachableFunctionSet
    BuildProfileScanFixture(sourceA, sourceB, profiles, set)
    var controlProfiles: parser.NormalizedExprCallProfile[]
    var controlSet: ccsg.CompilerCsgReachableFunctionSet
    BuildProfileScanFixture(sourceA, sourceB, controlProfiles, controlSet)
    let profileLookup = parser.ParserSourcePathIndexLookupBuild(profiles)
    var snapshots: ccsg.CompilerCsgSourceText[]
    var snapshotIndex = ccsg.CompilerCsgSourcePathIndexInit(8)
    ConfigureSmokeSourceIndex(snapshotIndex)
    var snapshotErr: str
    assert(ccsg.CompilerCsgCaptureImmutableSourceSnapshot(snapshots,
                                                          snapshotIndex,
                                                          sourceA,
                                                          "smoke/a",
                                                          "fn Caller(): int32 =\n    return Target()",
                                                          snapshotErr),
           strutil.Join([" reachability smoke: parser frontier snapshot ", snapshotErr], ""))
    var cache: ccsg.CompilerCsgProfileCallLookupStore
    var controlCache: ccsg.CompilerCsgProfileCallLookupStore
    var frontierIndex: ccsg.CompilerCsgFrontierIndex
    ccsg.CompilerCsgFrontierIndexBegin(frontierIndex,
                                       profiles.len,
                                       set.functionNames.len)
    var controlFrontier: ccsg.CompilerCsgFrontierIndex
    ccsg.CompilerCsgFrontierIndexBegin(controlFrontier,
                                       controlProfiles.len,
                                       controlSet.functionNames.len)
    var output: parser.NormalizedExprLayer
    AppendFrontierCallExpr(output, sourceA, 77, "OutputSentinel")
    var controlOutput: parser.NormalizedExprLayer
    AppendFrontierCallExpr(controlOutput, sourceA, 77, "OutputSentinel")
    var functionOutput: parser.NormalizedExprLayer
    AppendFrontierCallExpr(functionOutput, sourceA, 78, "FunctionSentinel")
    var controlFunctionOutput: parser.NormalizedExprLayer
    AppendFrontierCallExpr(controlFunctionOutput, sourceA, 78, "FunctionSentinel")
    var frontierFunctions: int32[] = [0, 1]
    var err: str
    assert(!ccsg.CompilerCsgExprLayerForFrontierFunctions(snapshots,
                                                          snapshotIndex,
                                                          profiles,
                                                          profileLookup,
                                                          cache,
                                                          set,
                                                          frontierFunctions,
                                                          frontierIndex,
                                                          output,
                                                          functionOutput,
                                                          err) &&
           strings.StrContains(err, "immutable source snapshot missing"),
           strutil.Join([" reachability smoke: parser frontier late failure ", err], ""))
    AssertFrontierIndexEqual(frontierIndex,
                             controlFrontier,
                             "parser frontier late failure")
    AssertExprLayerEqual(output, controlOutput, "parser frontier output atomic")
    AssertExprLayerEqual(functionOutput,
                         controlFunctionOutput,
                         "parser frontier function output atomic")
    AssertProfileCallLookupCacheEqual(cache,
                                      controlCache,
                                      "parser frontier cache atomic")
    AssertReachabilityTransactionEqual(set,
                                       controlSet,
                                       "parser frontier reachability atomic")
    assert(cache.entries.len == 0 && cache.index.keys.len == 0 &&
           cache.entries.cap == controlCache.entries.cap &&
           cache.index.keys.cap == controlCache.index.keys.cap,
           " reachability smoke: parser cache overlay escaped failed transaction")
    var targetSnapshotErr: str
    assert(ccsg.CompilerCsgCaptureImmutableSourceSnapshot(snapshots,
                                                          snapshotIndex,
                                                          sourceB,
                                                          "smoke/b",
                                                          "fn Target(): int32 =\n    return 0",
                                                          targetSnapshotErr),
           strutil.Join([" reachability smoke: parser target snapshot ", targetSnapshotErr], ""))
    assert(ccsg.CompilerCsgExprLayerForFrontierFunctions(snapshots,
                                                         snapshotIndex,
                                                         profiles,
                                                         profileLookup,
                                                         cache,
                                                         set,
                                                         frontierFunctions,
                                                         frontierIndex,
                                                         output,
                                                         functionOutput,
                                                         err),
           strutil.Join([" reachability smoke: parser frontier retry ", err], ""))
    var controlErr: str
    assert(ccsg.CompilerCsgExprLayerForFrontierFunctions(snapshots,
                                                         snapshotIndex,
                                                         controlProfiles,
                                                         profileLookup,
                                                         controlCache,
                                                         controlSet,
                                                         frontierFunctions,
                                                         controlFrontier,
                                                         controlOutput,
                                                         controlFunctionOutput,
                                                         controlErr),
           strutil.Join([" reachability smoke: parser frontier clean ", controlErr], ""))
    AssertFrontierIndexEqual(frontierIndex,
                             controlFrontier,
                             "parser frontier retry equals clean")
    AssertExprLayerEqual(output,
                         controlOutput,
                         "parser frontier output retry equals clean")
    AssertExprLayerEqual(functionOutput,
                         controlFunctionOutput,
                         "parser frontier function retry equals clean")
    AssertProfileCallLookupCacheEqual(cache,
                                      controlCache,
                                      "parser frontier cache retry equals clean")
    AssertReachabilityTransactionEqual(set,
                                       controlSet,
                                       "parser frontier reachability retry equals clean")
    var targetCacheEntry: parser.ParserProfileCallLookupCacheEntry
    var targetCacheFound = false
    var targetCacheErr: str
    assert(ccsg.CompilerCsgProfileCallLookupStoreLookup(cache,
                                                        1,
                                                        targetCacheEntry,
                                                        targetCacheFound,
                                                        targetCacheErr),
           strutil.Join([" reachability smoke: parser cache exact lookup ",
                         targetCacheErr], ""))
    assert(frontierIndex.lastStagingCapacity.sortingBytes > Int64(0) &&
           frontierIndex.lastStagingCapacity.frontierSelectionBytes > Int64(0) &&
           frontierIndex.lastStagingCapacity.frontierParserScratchBytes > Int64(0) &&
           frontierIndex.lastStagingCapacity.parserCacheScratchBytes > Int64(0) &&
           cache.entries.len == 2 && cache.index.keys.len == 2 &&
           targetCacheFound &&
           ccsg.CompilerCsgProfileCallLookupEntryBuilt(targetCacheEntry),
           " reachability smoke: parser frontier staging owners missing")
    let outputPayloadBytes = ExpectedExprLayerStringPayloadBytes(output)
    let functionPayloadBytes = ExpectedExprLayerStringPayloadBytes(functionOutput)
    let primaryOwnsPayload =
        frontierIndex.lastStagingCapacity.frontierOutputPrimaryOwnsStringPayload
    let scratchOwnsPayload =
        frontierIndex.lastStagingCapacity.frontierOutputScratchOwnsStringPayload
    let expectedFrontierOutputBytes =
        ExpectedExprLayerRetainedCapacityBytes(output, primaryOwnsPayload) +
        ExpectedExprLayerRetainedCapacityBytes(functionOutput, scratchOwnsPayload)
    assert(outputPayloadBytes > Int64(0) &&
           functionPayloadBytes == Int64(0) &&
           functionOutput.exprs.len == 0 && functionOutput.exprs.cap > 0 &&
           primaryOwnsPayload && !scratchOwnsPayload &&
           frontierIndex.lastStagingCapacity.frontierOutputBytes ==
               expectedFrontierOutputBytes,
           " reachability smoke: frontier ORC payload owner counted more than once")
    AssertStagingLedgerExact(frontierIndex.lastStagingCapacity,
                             "parser frontier retry")
    assert(frontierIndex.selectedProfiles.len > 0,
           " reachability smoke: parser frontier selected profile missing")
    var mutationControlFrontier = frontierIndex
    let originalSelectedProfile = frontierIndex.selectedProfiles[0]
    let mutatedSelectedProfile = originalSelectedProfile == 0 ? 1 : 0
    frontierIndex.selectedProfiles[0] = mutatedSelectedProfile
    mutationControlFrontier.selectedProfiles[0] = mutatedSelectedProfile
    var mutationCache = cache
    var mutationControlCache = cache
    var mutationOutput: parser.NormalizedExprLayer
    AppendFrontierCallExpr(mutationOutput, sourceA, 81, "MutationOutputSentinel")
    var mutationControlOutput: parser.NormalizedExprLayer
    AppendFrontierCallExpr(mutationControlOutput,
                           sourceA,
                           81,
                           "MutationOutputSentinel")
    var mutationFunctionOutput: parser.NormalizedExprLayer
    AppendFrontierCallExpr(mutationFunctionOutput,
                           sourceA,
                           82,
                           "MutationFunctionSentinel")
    var mutationControlFunctionOutput: parser.NormalizedExprLayer
    AppendFrontierCallExpr(mutationControlFunctionOutput,
                           sourceA,
                           82,
                           "MutationFunctionSentinel")
    assert(!ccsg.CompilerCsgExprLayerForFrontierFunctions(snapshots,
                                                          snapshotIndex,
                                                          profiles,
                                                          profileLookup,
                                                          mutationCache,
                                                          set,
                                                          frontierFunctions,
                                                          frontierIndex,
                                                          mutationOutput,
                                                          mutationFunctionOutput,
                                                          err) &&
           strings.StrContains(err, "selected-profile list certificate mismatch"),
           strutil.Join([" reachability smoke: frontier same-shape list mutation ",
                         err], ""))
    AssertFrontierIndexEqual(frontierIndex,
                             mutationControlFrontier,
                             "frontier same-shape list mutation atomic")
    AssertExprLayerEqual(mutationOutput,
                         mutationControlOutput,
                         "frontier same-shape output atomic")
    AssertExprLayerEqual(mutationFunctionOutput,
                         mutationControlFunctionOutput,
                         "frontier same-shape function output atomic")
    AssertProfileCallLookupCacheEqual(mutationCache,
                                      mutationControlCache,
                                      "frontier same-shape cache atomic")
    AssertReachabilityTransactionEqual(set,
                                       controlSet,
                                       "frontier same-shape reachability atomic")
    ccsg.CompilerCsgReleaseImmutableSourceSnapshots(snapshots, snapshotIndex)
    parser.NormalizedExprLayerReset(output)
    parser.NormalizedExprLayerReset(controlOutput)
    parser.NormalizedExprLayerReset(functionOutput)
    parser.NormalizedExprLayerReset(controlFunctionOutput)
    parser.NormalizedExprLayerReset(mutationOutput)
    parser.NormalizedExprLayerReset(mutationControlOutput)
    parser.NormalizedExprLayerReset(mutationFunctionOutput)
    parser.NormalizedExprLayerReset(mutationControlFunctionOutput)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(set)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(controlSet)

fn BuildProfileScanFixture(sourceA: str,
                           sourceB: str,
                           profiles: var parser.NormalizedExprCallProfile[],
                           set: var ccsg.CompilerCsgReachableFunctionSet) =
    var profileA: parser.NormalizedExprCallProfile
    profileA.sourcePath = sourceA
    profileA.ownerModulePath = "smoke/a"
    profileA.lines = ["fn Caller(): int32 =", "    return Target()"]
    var caller: parser.NormalizedFunctionDecl
    caller.name = "Caller"
    caller.lineIndex = 1
    caller.surfaceKeyword = "fn"
    add(profileA.decls, caller)
    add(profileA.localCallNames, "Caller")
    var edge: parser.ImportEdge
    edge.targetSourcePath = sourceB
    edge.targetProfileIndex = 1
    edge.qualifier = "dep"
    edge.allowsUnqualifiedCall = true
    edge.resolved = true
    add(profileA.importEdges, edge)
    var profileB: parser.NormalizedExprCallProfile
    profileB.sourcePath = sourceB
    profileB.ownerModulePath = "smoke/b"
    var target: parser.NormalizedFunctionDecl
    target.name = "Target"
    target.lineIndex = 1
    target.surfaceKeyword = "fn"
    add(profileB.decls, target)
    add(profileB.localCallNames, "Target")
    profiles = [profileA, profileB]
    var modules: str[] = ["smoke/a", "smoke/b"]
    var lineCounts: int32[] = [2, 2]
    var sourceIdentity = ccsg.CompilerCsgSourcePathIndexInit(8)
    ConfigureSmokeSourceIndex(sourceIdentity)
    set = ccsg.CompilerCsgReachableFunctionSetInit(true)
    var buildErr: str
    assert(ccsg.CompilerCsgReachableAddFunctionsFromProfiles(set,
                                                             profiles,
                                                             modules,
                                                             lineCounts,
                                                             sourceIdentity,
                                                             buildErr),
           strutil.Join([" reachability smoke: profile scan fixture ", buildErr], ""))
    assert(ccsg.CompilerCsgReachableStructureSealValid(set) &&
           ccsg.CompilerCsgReachableGraphSealValid(set),
           " reachability smoke: profile structure/graph was not sealed at build")
    var frontier: int32[]
    ccsg.CompilerCsgReachableMark(set, 0, frontier)
    ccsg.CompilerCsgReachableMark(set, 1, frontier)
    assert(ccsg.CompilerCsgReachableStructureSealValid(set) &&
           ccsg.CompilerCsgReachableGraphSealValid(set),
           " reachability smoke: controlled root marks invalidated seals")
    ccsg.CompilerCsgSourcePathIndexClear(sourceIdentity)

fn AssertProfileScanLateFailureAtomic(sourcePath: str) =
    let sourceA = strutil.Join([sourcePath, ".profile-a"], "")
    let sourceB = strutil.Join([sourcePath, ".profile-b"], "")
    var profiles: parser.NormalizedExprCallProfile[]
    var set: ccsg.CompilerCsgReachableFunctionSet
    BuildProfileScanFixture(sourceA, sourceB, profiles, set)
    var controlProfiles: parser.NormalizedExprCallProfile[]
    var controlSet: ccsg.CompilerCsgReachableFunctionSet
    BuildProfileScanFixture(sourceA, sourceB, controlProfiles, controlSet)
    let profileLookup = parser.ParserSourcePathIndexLookupBuild(profiles)
    var snapshots: ccsg.CompilerCsgSourceText[]
    var snapshotIndex = ccsg.CompilerCsgSourcePathIndexInit(8)
    ConfigureSmokeSourceIndex(snapshotIndex)
    var firstSnapshotErr: str
    assert(ccsg.CompilerCsgCaptureImmutableSourceSnapshot(snapshots,
                                                          snapshotIndex,
                                                          sourceA,
                                                          "smoke/a",
                                                          "fn Caller(): int32 =\n    return Target()",
                                                          firstSnapshotErr),
           strutil.Join([" reachability smoke: profile first snapshot ", firstSnapshotErr], ""))
    var cache: ccsg.CompilerCsgProfileCallLookupStore
    SeedProfileCallLookupStore(profiles, 0, cache)
    var controlCache: ccsg.CompilerCsgProfileCallLookupStore
    SeedProfileCallLookupStore(controlProfiles, 0, controlCache)
    var processed: bool[] = [false, false]
    var controlProcessed: bool[] = [false, false]
    var localScanned: bool[] = [false, false]
    var controlLocalScanned: bool[] = [false, false]
    var queued: bool[] = [false, false]
    var controlQueued: bool[] = [false, false]
    var cursor: int32
    var controlCursor: int32
    var pending: int32[] = [77]
    var controlPending: int32[] = [77]
    var err: str
    assert(!ccsg.CompilerCsgScanReachableSourceProfiles(snapshots,
                                                        snapshotIndex,
                                                        profiles,
                                                        profileLookup,
                                                        cache,
                                                        set,
                                                        processed,
                                                        localScanned,
                                                        cursor,
                                                        queued,
                                                        pending,
                                                        err) &&
           strings.StrContains(err, "immutable source snapshot missing"),
           strutil.Join([" reachability smoke: profile scan late failure ", err], ""))
    AssertReachabilityTransactionEqual(set, controlSet, "profile scan graph atomic")
    AssertBoolArraysEqual(processed, controlProcessed, "profile scan processed atomic")
    AssertBoolArraysEqual(localScanned, controlLocalScanned, "profile scan local atomic")
    AssertBoolArraysEqual(queued, controlQueued, "profile scan queued atomic")
    AssertInt32ArraysEqual(pending, controlPending, "profile scan pending atomic")
    AssertProfileCallLookupCacheEqual(cache, controlCache, "profile scan cache atomic")
    assert(cursor == controlCursor &&
           processed.cap == controlProcessed.cap &&
           localScanned.cap == controlLocalScanned.cap &&
           queued.cap == controlQueued.cap && pending.cap == controlPending.cap,
           " reachability smoke: profile scan state/capacity changed on failure")
    var snapshotErr: str
    assert(ccsg.CompilerCsgCaptureImmutableSourceSnapshot(snapshots,
                                                          snapshotIndex,
                                                          sourceB,
                                                          "smoke/b",
                                                          "fn Target(): int32 =\n    return 0",
                                                          snapshotErr),
           strutil.Join([" reachability smoke: profile retry snapshot ", snapshotErr], ""))
    assert(ccsg.CompilerCsgScanReachableSourceProfiles(snapshots,
                                                       snapshotIndex,
                                                       profiles,
                                                       profileLookup,
                                                       cache,
                                                       set,
                                                       processed,
                                                       localScanned,
                                                       cursor,
                                                       queued,
                                                       pending,
                                                       err),
           strutil.Join([" reachability smoke: profile scan retry ", err], ""))
    var controlErr: str
    assert(ccsg.CompilerCsgScanReachableSourceProfiles(snapshots,
                                                       snapshotIndex,
                                                       controlProfiles,
                                                       profileLookup,
                                                       controlCache,
                                                       controlSet,
                                                       controlProcessed,
                                                       controlLocalScanned,
                                                       controlCursor,
                                                       controlQueued,
                                                       controlPending,
                                                       controlErr),
           strutil.Join([" reachability smoke: profile scan clean ", controlErr], ""))
    AssertReachabilityTransactionEqual(set, controlSet, "profile scan retry graph")
    AssertBoolArraysEqual(processed, controlProcessed, "profile scan retry processed")
    AssertBoolArraysEqual(localScanned,
                          controlLocalScanned,
                          "profile scan retry local")
    AssertBoolArraysEqual(queued, controlQueued, "profile scan retry queued")
    AssertInt32ArraysEqual(pending, controlPending, "profile scan retry pending")
    AssertProfileCallLookupCacheEqual(cache, controlCache, "profile scan retry cache")
    assert(cursor == controlCursor &&
           processed.cap == controlProcessed.cap &&
           localScanned.cap == controlLocalScanned.cap &&
           queued.cap == controlQueued.cap && pending.cap == controlPending.cap &&
           set.lastProfileScanStaging.profileStateJournalBytes > Int64(0) &&
           set.lastProfileScanStaging.profileCacheOverlayBytes > Int64(0),
           " reachability smoke: profile scan retry state or sparse overlay missing")
    AssertStagingLedgerExact(set.lastProfileScanStaging, "profile scan retry")
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(set)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(controlSet)
    ccsg.CompilerCsgReleaseImmutableSourceSnapshots(snapshots, snapshotIndex)

fn ExpectedEmbeddedParserLookupDynamicBytes(lookup: parser.ParserTextLookup): int64 =
    var total = Int64(lookup.slots.cap) * Int64(4) +
                Int64(lookup.buckets.cap) * Int64(48)
    for bucketIndex in 0..<lookup.buckets.len:
        total = total + Int64(lookup.buckets[bucketIndex].items.cap) * Int64(24)
    return total

fn ExpectedCompactProfileViewCapacityBytes(view: ccsg.CompilerCsgCompactProfileView): int64 =
    var total = Int64(4 * 24) +
                Int64(view.profiles.cap) * Int64(224) +
                Int64(view.originalIndexes.cap) * Int64(4) +
                Int64(view.cache.cap) * Int64(112) +
                Int64(view.cacheOwned.cap) +
                Int64(2 * 24) +
                Int64(view.originalIndex.slots.cap + view.originalIndex.keys.cap) * Int64(4)
    for compactIndex in 0..<view.profiles.len:
        total = total + Int64(view.profiles[compactIndex].importEdges.cap) * Int64(152)
        if compactIndex < view.cacheOwned.len && view.cacheOwned[compactIndex] &&
           (view.cache[compactIndex].localLookup.slots.len > 0 ||
            view.cache[compactIndex].importcLookup.slots.len > 0):
            total = total + ExpectedEmbeddedParserLookupDynamicBytes(
                                view.cache[compactIndex].localLookup) +
                            ExpectedEmbeddedParserLookupDynamicBytes(
                                view.cache[compactIndex].importcLookup)
    total = total + Int64(2 * 24) +
            Int64(view.profileIndexLookup.slots.cap) * Int64(4) +
            Int64(view.profileIndexLookup.buckets.cap) * Int64(48)
    for bucketIndex in 0..<view.profileIndexLookup.buckets.len:
        total = total +
                Int64(view.profileIndexLookup.buckets[bucketIndex].items.cap) * Int64(32)
    return total

fn ExpectedProfileCallLookupStoreCapacityBytes(store: ccsg.CompilerCsgProfileCallLookupStore): int64 =
    var total = Int64(2 * 24) +
                Int64(store.index.slots.cap + store.index.keys.cap) * Int64(4) +
                Int64(24) + Int64(store.entries.cap) * Int64(112)
    for row in 0..<store.entries.len:
        total = total + ExpectedEmbeddedParserLookupDynamicBytes(
                            store.entries[row].localLookup) +
                        ExpectedEmbeddedParserLookupDynamicBytes(
                            store.entries[row].importcLookup)
    return total

fn ExpectedExprLayerStringPayloadBytes(layer: parser.NormalizedExprLayer): int64 =
    var total: int64
    for exprIndex in 0..<layer.exprs.len:
        let expr = layer.exprs[exprIndex]
        total = total + Int64(expr.exprId.len + expr.sourcePath.len +
                              expr.surfaceText.len + expr.callQualifier.len +
                              expr.callCallee.len + expr.callTarget.len +
                              expr.callTargetSourcePath.len + expr.callArgsText.len)
    return total

fn ExpectedExprLayerRetainedCapacityBytes(layer: parser.NormalizedExprLayer,
                                          ownsStringPayload: bool): int64 =
    # Independent physical-owner oracle: four sequence descriptors plus the
    # exact retained capacities of every NormalizedExprLayer column.
    var total = Int64(4 * 24) +
                Int64(layer.exprs.cap) * Int64(240) +
                Int64(layer.exprNext.cap) * Int64(4) +
                Int64(layer.exprLookup.slots.cap) * Int64(4) +
                Int64(layer.exprLookup.buckets.cap) * Int64(48)
    if ownsStringPayload:
        total = total + ExpectedExprLayerStringPayloadBytes(layer)
    return total

fn AssertCompactProfileScratchUsesClosureDegree(sourcePath: str) =
    let targetPath = strutil.Join([sourcePath, ".compact-target"], "")
    let rootPath = strutil.Join([sourcePath, ".compact-root00"], "")
    var targetProfile: parser.NormalizedExprCallProfile
    targetProfile.sourcePath = targetPath
    targetProfile.ownerModulePath = "smoke/compact-target"
    add(targetProfile.localCallNames, "Target")
    var rootProfile: parser.NormalizedExprCallProfile
    rootProfile.sourcePath = rootPath
    rootProfile.ownerModulePath = "smoke/compact-root"
    var rootEdge: parser.ImportEdge
    rootEdge.targetSourcePath = targetPath
    rootEdge.targetProfileIndex = 17
    rootEdge.qualifier = "dep"
    rootEdge.allowsUnqualifiedCall = true
    rootEdge.resolved = true
    add(rootProfile.importEdges, rootEdge)

    var highProfiles: parser.NormalizedExprCallProfile[]
    for profileIndex in 0..<1024:
        var filler: parser.NormalizedExprCallProfile
        filler.sourcePath = strutil.Join([sourcePath,
                                          ".compact-filler-",
                                          strings.IntToStr(profileIndex)], "")
        filler.ownerModulePath = "smoke/compact-filler"
        add(highProfiles, filler)
    highProfiles[17] = targetProfile
    highProfiles[1023] = rootProfile
    let highLookup = parser.ParserSourcePathIndexLookupBuild(highProfiles)
    var emptyHighCache: ccsg.CompilerCsgProfileCallLookupStore
    var highView: ccsg.CompilerCsgCompactProfileView
    var highErr: str
    assert(ccsg.CompilerCsgCompactProfileViewBuild(highProfiles,
                                                   highLookup,
                                                   emptyHighCache,
                                                   1023,
                                                   highView,
                                                   highErr),
           strutil.Join([" reachability smoke: high-index compact profile ", highErr], ""))

    var lowRoot = rootProfile
    lowRoot.importEdges[0].targetProfileIndex = 0
    var lowProfiles: parser.NormalizedExprCallProfile[] = [targetProfile, lowRoot]
    let lowLookup = parser.ParserSourcePathIndexLookupBuild(lowProfiles)
    var emptyLowCache: ccsg.CompilerCsgProfileCallLookupStore
    var lowView: ccsg.CompilerCsgCompactProfileView
    var lowErr: str
    assert(ccsg.CompilerCsgCompactProfileViewBuild(lowProfiles,
                                                   lowLookup,
                                                   emptyLowCache,
                                                   1,
                                                   lowView,
                                                   lowErr),
           strutil.Join([" reachability smoke: low-index compact profile ", lowErr], ""))
    for compactIndex in 0..<highView.profiles.len:
        highView.cache[compactIndex] =
            parser.ParserBuildProfileCallLookups(highView.profiles[compactIndex])
        lowView.cache[compactIndex] =
            parser.ParserBuildProfileCallLookups(lowView.profiles[compactIndex])
    let highExpectedBytes = ExpectedCompactProfileViewCapacityBytes(highView)
    let lowExpectedBytes = ExpectedCompactProfileViewCapacityBytes(lowView)
    assert(highView.profiles.len == 2 && highView.originalIndexes.len == 2 &&
           highView.originalIndexes[0] == 1023 &&
           highView.originalIndexes[1] == 17 &&
           highView.originalIndex.keys.len == 2 &&
           highView.originalIndex.slots.len == lowView.originalIndex.slots.len &&
           highView.cache.len == 2 && highView.cacheOwned.len == 2 &&
           highExpectedBytes == lowExpectedBytes &&
           ccsg.CompilerCsgCompactProfileViewCapacityBytes(highView) ==
               highExpectedBytes &&
           ccsg.CompilerCsgCompactProfileViewCapacityBytes(lowView) ==
               lowExpectedBytes,
           " reachability smoke: compact parser scratch scales with original profile index")
    var highOverlay: ccsg.CompilerCsgProfileCallLookupOverlay
    var highCommitErr: str
    assert(ccsg.CompilerCsgCompactProfileCacheToOverlay(emptyHighCache,
                                                        highView,
                                                        highOverlay,
                                                        highCommitErr),
           strutil.Join([" reachability smoke: high sparse cache overlay ",
                         highCommitErr], ""))
    ccsg.CompilerCsgProfileCallLookupOverlayCommit(emptyHighCache,
                                                    highProfiles,
                                                    highOverlay)
    var lowOverlay: ccsg.CompilerCsgProfileCallLookupOverlay
    var lowCommitErr: str
    assert(ccsg.CompilerCsgCompactProfileCacheToOverlay(emptyLowCache,
                                                        lowView,
                                                        lowOverlay,
                                                        lowCommitErr),
           strutil.Join([" reachability smoke: low sparse cache overlay ",
                         lowCommitErr], ""))
    ccsg.CompilerCsgProfileCallLookupOverlayCommit(emptyLowCache,
                                                    lowProfiles,
                                                    lowOverlay)
    var highRootEntry: parser.ParserProfileCallLookupCacheEntry
    var highRootFound = false
    var highLookupErr: str
    assert(ccsg.CompilerCsgProfileCallLookupStoreLookup(emptyHighCache,
                                                        1023,
                                                        highRootEntry,
                                                        highRootFound,
                                                        highLookupErr),
           strutil.Join([" reachability smoke: high sparse cache exact lookup ",
                         highLookupErr], ""))
    var missingEntry: parser.ParserProfileCallLookupCacheEntry
    var missingFound = false
    assert(ccsg.CompilerCsgProfileCallLookupStoreLookup(emptyHighCache,
                                                        1022,
                                                        missingEntry,
                                                        missingFound,
                                                        highLookupErr),
           strutil.Join([" reachability smoke: high sparse cache absent lookup ",
                         highLookupErr], ""))
    let highStoreExpected = ExpectedProfileCallLookupStoreCapacityBytes(emptyHighCache)
    let lowStoreExpected = ExpectedProfileCallLookupStoreCapacityBytes(emptyLowCache)
    assert(emptyHighCache.entries.len == 2 &&
           emptyHighCache.index.keys.len == 2 &&
           emptyHighCache.index.keys[0] == 1023 &&
           emptyHighCache.index.keys[1] == 17 &&
           highRootFound && !missingFound &&
           highStoreExpected == lowStoreExpected &&
           ccsg.CompilerCsgProfileCallLookupStoreCapacityBytes(emptyHighCache) ==
               highStoreExpected &&
           ccsg.CompilerCsgProfileCallLookupStoreCapacityBytes(emptyLowCache) ==
               lowStoreExpected,
           " reachability smoke: production cache retained max-index dense storage")

fn AssertPhaseLedgerIndependentOracle() =
    var ledger: ccsg.CompilerCsgStagingCapacityLedger
    var first: ccsg.CompilerCsgStagingCapacityLedger
    first.sortingBytes = Int64(11)
    first.sparseIndexBytes = Int64(13)
    first.profileCacheOverlayBytes = Int64(17)
    ccsg.CompilerCsgStagingCapacityLedgerRecordPhase(ledger, first)
    assert(ledger.totalBytes == Int64(41) &&
           ledger.phasePeakBytes == Int64(41) &&
           ledger.phaseSnapshotCount == Int64(1) &&
           ledger.sortingBytes == Int64(11) &&
           ledger.sparseIndexBytes == Int64(13) &&
           ledger.profileCacheOverlayBytes == Int64(17),
           " reachability smoke: first phase exact-byte oracle")
    var second: ccsg.CompilerCsgStagingCapacityLedger
    second.validationBytes = Int64(101)
    ccsg.CompilerCsgStagingCapacityLedgerRecordPhase(ledger, second)
    assert(ledger.totalBytes == Int64(101) &&
           ledger.phasePeakBytes == Int64(101) &&
           ledger.phaseSnapshotCount == Int64(2) &&
           ledger.validationBytes == Int64(101) &&
           ledger.sortingBytes == Int64(0) &&
           ledger.profileCacheOverlayBytes == Int64(0),
           " reachability smoke: phase peak must replace, not sum")
    var third: ccsg.CompilerCsgStagingCapacityLedger
    third.frontierOutputBytes = Int64(37)
    third.parserCacheScratchBytes = Int64(41)
    ccsg.CompilerCsgStagingCapacityLedgerRecordPhase(ledger, third)
    var ledgerErr: str
    assert(ledger.totalBytes == Int64(101) &&
           ledger.phasePeakBytes == Int64(101) &&
           ledger.phaseSnapshotCount == Int64(3) &&
           ledger.validationBytes == Int64(101) &&
           ccsg.CompilerCsgStagingCapacityLedgerValidate(ledger, ledgerErr),
           strutil.Join([" reachability smoke: lower phase polluted peak ", ledgerErr], ""))

fn AssertExplicitCallExclusions() =
    var fact: texpr.TypedExprFact
    fact.surfaceCallKind = texpr.TypedExprSurfaceCallLocal
    fact.callKind = texpr.TypedExprCallBuiltin
    assert(!ccsg.CompilerCsgTypedFactIsReachabilityExecutableCall(fact),
           " reachability smoke: builtin enum exclusion")
    fact.callKind = texpr.TypedExprCallResultIntrinsic
    assert(!ccsg.CompilerCsgTypedFactIsReachabilityExecutableCall(fact),
           " reachability smoke: result enum exclusion")
    fact.callKind = texpr.TypedExprCallProjection
    assert(!ccsg.CompilerCsgTypedFactIsReachabilityExecutableCall(fact),
           " reachability smoke: projection enum exclusion")
    fact.callKind = texpr.TypedExprCallNone
    fact.typeCallKind = texpr.TypedExprTypeCallConstructor
    assert(!ccsg.CompilerCsgTypedFactIsReachabilityExecutableCall(fact),
           " reachability smoke: type-call enum exclusion")
    fact.typeCallKind = texpr.TypedExprTypeCallNone
    fact.surfaceCallKind = texpr.TypedExprSurfaceCallImportc
    assert(!ccsg.CompilerCsgTypedFactIsReachabilityExecutableCall(fact),
           " reachability smoke: importc enum exclusion")
    fact.surfaceCallKind = texpr.TypedExprSurfaceCallMember
    assert(!ccsg.CompilerCsgTypedFactIsReachabilityExecutableCall(fact),
           " reachability smoke: member enum exclusion")
    assert(ccsg.CompilerCsgTypedFactIsResolvedCallSnapshot(fact),
           " reachability smoke: member remains a resolved-call snapshot candidate")
    fact.surfaceCallKind = texpr.TypedExprSurfaceCallExternal
    fact.callTargetImportc = true
    assert(!ccsg.CompilerCsgTypedFactIsReachabilityExecutableCall(fact),
           " reachability smoke: importc target flag exclusion")
    fact.callTargetImportc = false
    assert(ccsg.CompilerCsgTypedFactIsReachabilityExecutableCall(fact),
           " reachability smoke: external executable enum")
    fact.surfaceCallKind = texpr.TypedExprSurfaceCallLocal
    assert(ccsg.CompilerCsgTypedFactIsReachabilityExecutableCall(fact),
           " reachability smoke: local executable enum")

fn AssertFinalOwnerMappingRejects(sourcePath: str) =
    var missingSet: ccsg.CompilerCsgReachableFunctionSet
    InitReachableSet(sourcePath, missingSet)
    SealReachableFixture(missingSet, "final owner missing")
    var missingIr: texpr.TypedExprIr
    missingIr.internPool = langintern.InternPoolNew()
    AppendTypedIrFunction(missingIr, sourcePath, "Caller", 99, 0, 0)
    var missingTable = EmptyResolvedCalls(missingSet.functionNames.len)
    var missingErr: str
    assert(!ccsg.CompilerCsgSemanticFinalizeResolvedCallFunctionAdjacency(missingTable,
                                                                   missingSet,
                                                                   missingIr,
                                                                   missingErr) &&
           strings.StrContains(missingErr, "typed owner missing"),
           strutil.Join([" reachability smoke: final owner missing ", missingErr], ""))
    ccsg.CompilerCsgSemanticResolvedCallTableRelease(missingTable)
    texpr.TypedExprIrReleasePayload(missingIr)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(missingSet)

    var duplicateSet: ccsg.CompilerCsgReachableFunctionSet
    InitReachableSet(sourcePath, duplicateSet)
    SealReachableFixture(duplicateSet, "final owner duplicate")
    var duplicateIr: texpr.TypedExprIr
    duplicateIr.internPool = langintern.InternPoolNew()
    AppendTypedIrFunction(duplicateIr, sourcePath, "Caller", 1, 0, 0)
    AppendTypedIrFunction(duplicateIr, sourcePath, "Caller", 1, 0, 0)
    var duplicateTable = EmptyResolvedCalls(duplicateSet.functionNames.len)
    var duplicateErr: str
    assert(!ccsg.CompilerCsgSemanticFinalizeResolvedCallFunctionAdjacency(duplicateTable,
                                                                   duplicateSet,
                                                                   duplicateIr,
                                                                   duplicateErr) &&
           strings.StrContains(duplicateErr, "typed owner duplicate"),
           strutil.Join([" reachability smoke: final owner duplicate ", duplicateErr], ""))
    ccsg.CompilerCsgSemanticResolvedCallTableRelease(duplicateTable)
    texpr.TypedExprIrReleasePayload(duplicateIr)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(duplicateSet)

    var atomicSet: ccsg.CompilerCsgReachableFunctionSet
    InitReachableSet(sourcePath, atomicSet)
    let secondOwner = AddReachableFunction(sourcePath,
                                           "SecondOwner",
                                           9,
                                           12,
                                           true,
                                           atomicSet)
    SealReachableFixture(atomicSet, "final owner atomic")
    var atomicIr: texpr.TypedExprIr
    atomicIr.internPool = langintern.InternPoolNew()
    AppendTypedIrFunction(atomicIr, sourcePath, "Caller", 1, 0, 0)
    var atomicTable = EmptyResolvedCalls(atomicSet.functionNames.len)
    AppendResolvedReturnRow(atomicTable, 0, sourcePath, 1, "Caller")
    AppendResolvedReturnRow(atomicTable, secondOwner, sourcePath, 9, "Caller")
    let oldFunctionIndexes = ccsg.CompilerCsgCloneInt32Seq(atomicTable.functionIndexes)
    let oldHeads = ccsg.CompilerCsgCloneInt32Seq(atomicTable.functionRowHeads)
    let oldNext = ccsg.CompilerCsgCloneInt32Seq(atomicTable.functionRowNext)
    var atomicErr: str
    assert(!ccsg.CompilerCsgSemanticFinalizeResolvedCallFunctionAdjacency(atomicTable,
                                                                   atomicSet,
                                                                   atomicIr,
                                                                   atomicErr) &&
           strings.StrContains(atomicErr, "owner absent from final TypedIR"),
           strutil.Join([" reachability smoke: final remap second-row failure ", atomicErr], ""))
    AssertInt32ArraysEqual(atomicTable.functionIndexes,
                           oldFunctionIndexes,
                           "final remap old function domain")
    AssertInt32ArraysEqual(atomicTable.functionRowHeads,
                           oldHeads,
                           "final remap old heads")
    AssertInt32ArraysEqual(atomicTable.functionRowNext,
                           oldNext,
                           "final remap old next")
    ccsg.CompilerCsgSemanticResolvedCallTableRelease(atomicTable)
    texpr.TypedExprIrReleasePayload(atomicIr)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(atomicSet)

fn BuildFixturePlan(root: str,
                    packageId: str,
                    sourceText: str,
                    plan: var slplan.SystemLinkPlanStub,
                    sourceBundleCid: var layout.FixedBytes32,
                    err: var str): bool =
    let sourcePath = strutil.Join([root, "/src/main.cheng"], "")
    os.MkdirAll(strutil.Join([root, "/src"], ""), 493)
    os.WriteFile(strutil.Join([root, "/cheng-package.toml"], ""),
                 strutil.Join(["package_id = \"", packageId, "\"\n"], ""))
    os.WriteFile(sourcePath, sourceText)
    let requestBase = creq.CompilerRequestNew(root,
                                              sourcePath,
                                              strutil.Join([root, "/out.o"], ""),
                                              "arm64-apple-darwin",
                                              creq.EmitObj,
                                              "")
    let request = creq.CompilerRequestWithExportRootSymbols(requestBase, ["Root"])
    if !slplan.BuildSystemLinkPlanStub(root, request, plan, err):
        return false
    let sourceBundle = slplan.SystemLinkPlanSourceBundleCid(plan)
    if IsErr(sourceBundle):
        err = Error(sourceBundle)
        return false
    sourceBundleCid = Value(sourceBundle)
    return true

fn BuildFixtureInto(root: str,
                    packageId: str,
                    sourceText: str,
                    out: var ccsg.CompilerCsg,
                    err: var str): bool =
    var plan: slplan.SystemLinkPlanStub
    var sourceBundleCid: layout.FixedBytes32
    if !BuildFixturePlan(root,
                         packageId,
                         sourceText,
                         plan,
                         sourceBundleCid,
                         err):
        return false
    return ccsg.BuildCompilerCsgInto(plan, sourceBundleCid, out, err)

fn AssertCompilerCsgGraphEquivalent(left: ccsg.CompilerCsg,
                                    right: ccsg.CompilerCsg,
                                    label: str) =
    assert(left.nodes.len > 0 && left.edges.len > 0 &&
           left.nodes.len == right.nodes.len &&
           left.edges.len == right.edges.len &&
           left.nodeCount == right.nodeCount &&
           left.edgeCount == right.edgeCount,
           strutil.Join([" reachability smoke: graph shape ", label], ""))
    for nodeIndex in 0..<left.nodes.len:
        let a = left.nodes[nodeIndex]
        let b = right.nodes[nodeIndex]
        assert(a.nodeId == b.nodeId && a.nodeKind == b.nodeKind &&
               a.ownerNodeId == b.ownerNodeId && a.modulePath == b.modulePath &&
               a.symbolText == b.symbolText && a.factText == b.factText &&
               a.semanticSource == b.semanticSource &&
               a.semanticDeclarationLineIndex == b.semanticDeclarationLineIndex &&
               a.semanticParamTypeJoin == b.semanticParamTypeJoin &&
               a.semanticReturnType == b.semanticReturnType &&
               a.semanticSignatureComplete == b.semanticSignatureComplete &&
               a.resultLayoutKind == b.resultLayoutKind &&
               a.effectKind == b.effectKind &&
               a.capabilityKind == b.capabilityKind && a.callConv == b.callConv &&
               a.entryFlag == b.entryFlag && a.exportedFlag == b.exportedFlag &&
               a.exportSymbolName == b.exportSymbolName &&
               a.exportNameExplicit == b.exportNameExplicit &&
               layout.FixedBytes32Equal(a.factCid, b.factCid),
               strutil.Join([" reachability smoke: graph node ", label], ""))
    for edgeIndex in 0..<left.edges.len:
        let a = left.edges[edgeIndex]
        let b = right.edges[edgeIndex]
        assert(a.edgeId == b.edgeId && a.fromNodeId == b.fromNodeId &&
               a.toNodeId == b.toNodeId && a.edgeKind == b.edgeKind &&
               layout.FixedBytes32Equal(a.edgeCid, b.edgeCid),
               strutil.Join([" reachability smoke: graph edge ", label], ""))
    assert(layout.FixedBytes32Equal(left.canonicalGraphCid, right.canonicalGraphCid) &&
           layout.FixedBytes32Equal(left.graphCid, right.graphCid),
           strutil.Join([" reachability smoke: graph cid ", label], ""))
    AssertInt64ArraysEqual(left.semanticGraph.exprSliceTable.typedFactSemanticDigests,
                           right.semanticGraph.exprSliceTable.typedFactSemanticDigests,
                           strutil.Join([label, " fact semantic digests"], ""))
    AssertInt64ArraysEqual(left.semanticGraph.exprSliceTable.typedIrSemanticDigests,
                           right.semanticGraph.exprSliceTable.typedIrSemanticDigests,
                           strutil.Join([label, " retained semantic digests"], ""))
    AssertInt64ArraysEqual(left.semanticGraph.typedFactTable.semanticIdentityCertificates,
                           right.semanticGraph.typedFactTable.semanticIdentityCertificates,
                           strutil.Join([label, " semantic identity certificates"], ""))
    assert(left.semanticGraph.typedFactSemanticConservationProved &&
           right.semanticGraph.typedFactSemanticConservationProved &&
           left.semanticGraph.typedFactSemanticSliceCount ==
               right.semanticGraph.typedFactSemanticSliceCount &&
           left.semanticGraph.typedFactSemanticValidatedSliceCount ==
               left.semanticGraph.typedFactSemanticSliceCount &&
           right.semanticGraph.typedFactSemanticValidatedSliceCount ==
               right.semanticGraph.typedFactSemanticSliceCount,
           strutil.Join([" reachability smoke: semantic replay ", label], ""))

fn AssertOverloadBatchGraphEquivalent(root: str) =
    let sourceText = "fn Pick(x: int32) -> int32 =\n    return x + 1\n\nfn Pick(x: int32, y: int32) -> int32 =\n    return x + y\n\nfn Root() -> int32 =\n    return Pick(7) + Pick(3, 4)\n"
    let reorderedSourceText = "# leading comment must not enter normalized identity\n\nfn Pick(x: int32, y: int32) -> int32 =\n    return x + y\n\n# overload order changed\nfn Pick(x: int32) -> int32 =\n    return x + 1\n\nfn Root() -> int32 =\n    return Pick(7) + Pick(3, 4)\n"
    let packageId = "pkg://cheng/compiler_csg_overload_batch_smoke"
    let oldBatchLimit = os.GetEnv("CHENG_CSG_TYPED_IR_BATCH_LIMIT")
    os.SetEnv("CHENG_CSG_TYPED_IR_BATCH_LIMIT", "1")
    var batchOne: ccsg.CompilerCsg
    var err: str
    assert(BuildFixtureInto(root,
                            packageId,
                            sourceText,
                            batchOne,
                            err),
           strutil.Join([" reachability smoke: overload batch=1 build ", err], ""))
    os.SetEnv("CHENG_CSG_TYPED_IR_BATCH_LIMIT", "")
    var defaultBatch: ccsg.CompilerCsg
    err = ""
    assert(BuildFixtureInto(root,
                            packageId,
                            sourceText,
                            defaultBatch,
                            err),
           strutil.Join([" reachability smoke: overload default batch build ", err], ""))
    var reordered: ccsg.CompilerCsg
    err = ""
    assert(BuildFixtureInto(strutil.Join([root, "_reordered"], ""),
                            packageId,
                            reorderedSourceText,
                            reordered,
                            err),
           strutil.Join([" reachability smoke: overload reordered build ", err], ""))
    os.SetEnv("CHENG_CSG_TYPED_IR_BATCH_LIMIT", oldBatchLimit)
    var batchOneOverloadCount: int32
    var defaultOverloadCount: int32
    var firstOverloadNode: ccsg.CompilerCsgNode
    var secondOverloadNode: ccsg.CompilerCsgNode
    var firstOverloadNodeIndex: int32 = -1
    var secondOverloadNodeIndex: int32 = -1
    var rootAbiObserved = false
    for nodeIndex in 0..<batchOne.nodes.len:
        if batchOne.nodes[nodeIndex].nodeKind == ccsg.CompilerCsgNodeKindSymbol &&
           batchOne.nodes[nodeIndex].factText == "Pick":
            batchOneOverloadCount = batchOneOverloadCount + 1
            if batchOneOverloadCount == 1:
                firstOverloadNode = batchOne.nodes[nodeIndex]
                firstOverloadNodeIndex = nodeIndex
            else:
                secondOverloadNode = batchOne.nodes[nodeIndex]
                secondOverloadNodeIndex = nodeIndex
        elif batchOne.nodes[nodeIndex].nodeKind == ccsg.CompilerCsgNodeKindSymbol &&
             batchOne.nodes[nodeIndex].factText == "Root":
            assert(batchOne.nodes[nodeIndex].exportedFlag != 0 &&
                   batchOne.nodes[nodeIndex].exportSymbolName == "Root",
                   " reachability smoke: semantic identity changed external ABI export")
            rootAbiObserved = true
    for nodeIndex in 0..<defaultBatch.nodes.len:
        if defaultBatch.nodes[nodeIndex].nodeKind == ccsg.CompilerCsgNodeKindSymbol &&
           defaultBatch.nodes[nodeIndex].factText == "Pick":
            defaultOverloadCount = defaultOverloadCount + 1
    assert(batchOneOverloadCount == 2 && defaultOverloadCount == 2 && rootAbiObserved,
           " reachability smoke: batch build lost a reachable overload")
    let signatureFactsDistinct =
        (firstOverloadNode.semanticParamTypeJoin == "int32" &&
         secondOverloadNode.semanticParamTypeJoin == "int32;;int32") ||
        (secondOverloadNode.semanticParamTypeJoin == "int32" &&
         firstOverloadNode.semanticParamTypeJoin == "int32;;int32")
    assert(firstOverloadNode.factText == "Pick" &&
           secondOverloadNode.factText == "Pick" &&
           firstOverloadNode.symbolText == secondOverloadNode.symbolText &&
           firstOverloadNode.semanticSource != "" &&
           firstOverloadNode.semanticSource == secondOverloadNode.semanticSource &&
           firstOverloadNode.semanticDeclarationLineIndex !=
               secondOverloadNode.semanticDeclarationLineIndex &&
           firstOverloadNode.semanticReturnType == "int32" &&
           secondOverloadNode.semanticReturnType == "int32" &&
           firstOverloadNode.semanticSignatureComplete == 1 &&
           secondOverloadNode.semanticSignatureComplete == 1 &&
           signatureFactsDistinct &&
           !layout.FixedBytes32Equal(firstOverloadNode.factCid,
                                     secondOverloadNode.factCid),
           " reachability smoke: overload ABI name or semantic fact identity mismatch")
    let overloadNormalizedCids = csgnorm.CsgNormNodeCids(batchOne.nodes)
    assert(firstOverloadNodeIndex >= 0 && secondOverloadNodeIndex >= 0 &&
           !layout.FixedBytes32Equal(overloadNormalizedCids[firstOverloadNodeIndex],
                                     overloadNormalizedCids[secondOverloadNodeIndex]),
           " reachability smoke: overload identity missing from normalized node cid")
    let reorderedNormalizedCids = csgnorm.CsgNormNodeCids(reordered.nodes)
    var baseOneParamCid: layout.FixedBytes32
    var baseTwoParamCid: layout.FixedBytes32
    var reorderedOneParamCid: layout.FixedBytes32
    var reorderedTwoParamCid: layout.FixedBytes32
    var baseSignatureCount: int32
    var reorderedSignatureCount: int32
    for nodeIndex in 0..<batchOne.nodes.len:
        let node = batchOne.nodes[nodeIndex]
        if node.nodeKind != ccsg.CompilerCsgNodeKindSymbol || node.factText != "Pick":
            continue
        if node.semanticParamTypeJoin == "int32":
            baseOneParamCid = overloadNormalizedCids[nodeIndex]
            baseSignatureCount = baseSignatureCount + 1
        elif node.semanticParamTypeJoin == "int32;;int32":
            baseTwoParamCid = overloadNormalizedCids[nodeIndex]
            baseSignatureCount = baseSignatureCount + 1
    for nodeIndex in 0..<reordered.nodes.len:
        let node = reordered.nodes[nodeIndex]
        if node.nodeKind != ccsg.CompilerCsgNodeKindSymbol || node.factText != "Pick":
            continue
        if node.semanticParamTypeJoin == "int32":
            reorderedOneParamCid = reorderedNormalizedCids[nodeIndex]
            reorderedSignatureCount = reorderedSignatureCount + 1
        elif node.semanticParamTypeJoin == "int32;;int32":
            reorderedTwoParamCid = reorderedNormalizedCids[nodeIndex]
            reorderedSignatureCount = reorderedSignatureCount + 1
    assert(baseSignatureCount == 2 && reorderedSignatureCount == 2 &&
           layout.FixedBytes32Equal(baseOneParamCid, reorderedOneParamCid) &&
           layout.FixedBytes32Equal(baseTwoParamCid, reorderedTwoParamCid) &&
           !layout.FixedBytes32Equal(baseOneParamCid, baseTwoParamCid) &&
           !layout.FixedBytes32Equal(reorderedOneParamCid, reorderedTwoParamCid) &&
           layout.FixedBytes32Equal(batchOne.canonicalGraphCid,
                                    reordered.canonicalGraphCid),
           " reachability smoke: comments/reorder changed overload normalized identity")
    AssertCompilerCsgGraphEquivalent(batchOne,
                                     defaultBatch,
                                     "overload batch=1/default")
    ccsg.CompilerCsgReleaseBackendInputPayload(batchOne)
    ccsg.CompilerCsgReleaseBackendInputPayload(defaultBatch)
    ccsg.CompilerCsgReleaseBackendInputPayload(reordered)

fn AssertConsumeInputAtomicity(root: str,
                               packageId: str,
                               sourceText: str) =
    var plan: slplan.SystemLinkPlanStub
    var sourceBundleCid: layout.FixedBytes32
    var err: str
    assert(BuildFixturePlan(root,
                            packageId,
                            sourceText,
                            plan,
                            sourceBundleCid,
                            err),
           strutil.Join([" reachability smoke: atomic plan ", err], ""))
    assert(plan.exprLayer.exprs.len > 0,
           " reachability smoke: atomic fixture missing borrowed expr layer")
    var exprLayerSnapshot = parser.NormalizedExprLayerClone(plan.exprLayer)
    let sourceClosureSnapshot = CloneStrArray(plan.sourceClosurePaths)
    let sourceBundleIdentitySnapshot = CloneStrArray(plan.sourceBundleIdentityPaths)
    let ownerModuleSnapshot = CloneStrArray(plan.ownerModulePaths)
    let importEdgeSnapshot = CloneImportEdges(plan.importEdges)
    let runtimeTargetSnapshot = CloneStrArray(plan.runtimeTargets)
    var invalidOverride: ccsg.CompilerCsgSourceText
    invalidOverride.sourcePath = plan.entryPath
    invalidOverride.modulePath = plan.moduleStem
    invalidOverride.text = "fn Root("
    var invalidOverrides = [invalidOverride]
    var out: ccsg.CompilerCsg
    err = ""
    assert(!ccsg.BuildCompilerCsgConsumeWithOverridesInto(out,
                                                          err,
                                                          plan,
                                                          sourceBundleCid,
                                                          "",
                                                          "",
                                                          invalidOverrides) && err != "",
           " reachability smoke: invalid consume build unexpectedly succeeded")
    AssertExprLayerEqual(plan.exprLayer, exprLayerSnapshot, "borrowed failure atomic")
    AssertStrArraysEqual(plan.sourceClosurePaths,
                         sourceClosureSnapshot,
                         "borrowed source closure atomic")
    AssertStrArraysEqual(plan.sourceBundleIdentityPaths,
                         sourceBundleIdentitySnapshot,
                         "borrowed source bundle identity atomic")
    AssertStrArraysEqual(plan.ownerModulePaths,
                         ownerModuleSnapshot,
                         "borrowed owner modules atomic")
    AssertImportEdgesEqual(plan.importEdges,
                           importEdgeSnapshot,
                           "borrowed imports atomic")
    AssertStrArraysEqual(plan.runtimeTargets,
                         runtimeTargetSnapshot,
                         "borrowed runtime targets atomic")
    assert(out.nodes.len == 0 && out.edges.len == 0 &&
           out.typedIr.functions2_functionNameIds.len == 0,
           " reachability smoke: failed consume build published partial output")
    var validOverrides: ccsg.CompilerCsgSourceText[]
    err = ""
    assert(ccsg.BuildCompilerCsgConsumeWithOverridesInto(out,
                                                         err,
                                                         plan,
                                                         sourceBundleCid,
                                                         "",
                                                         "",
                                                         validOverrides),
           strutil.Join([" reachability smoke: consume build ", err], ""))
    assert(plan.exprLayer.exprs.len == 0 && plan.exprLayer.exprs.cap == 0 &&
           plan.exprLayer.exprNext.cap == 0 &&
           plan.exprLayer.exprLookup.slots.cap == 0 &&
           plan.exprLayer.exprLookup.buckets.cap == 0 &&
           plan.sourceBundleIdentityPaths.len == 0 &&
           plan.sourceClosurePaths.len == 0 &&
           plan.ownerModulePaths.len == 0 && plan.importEdges.len == 0 &&
           plan.runtimeTargets.len == 0 && out.nodes.len > 0 &&
           out.edges.len > 0 && out.exprLayer.exprs.cap == 0,
           " reachability smoke: successful consume left input ownership live")
    ccsg.CompilerCsgNormalizedExprLayerTerminalRelease(exprLayerSnapshot)
    ccsg.CompilerCsgReleaseBackendInputPayload(out)

fn AssertLinearCounters(csg: ccsg.CompilerCsg,
                        label: str) =
    assert(csg.typedIrFinalFunctionCount == 3 &&
           csg.typedIrFinalStatementCount > 0,
           strutil.Join([" reachability smoke: final TypedIR rows ", label], ""))
    assert(csg.typedIrReachabilityScannedStatementCount == csg.typedIrFinalStatementCount,
           strutil.Join([" reachability smoke: statement scan is linear ", label], ""))
    assert(csg.typedIrReachabilityScannedFunctionCount == csg.typedIrFinalFunctionCount,
           strutil.Join([" reachability smoke: function scan is linear ", label], ""))
    assert(csg.typedIrReachabilityResolvedCallRowVisitCount ==
               Int64(csg.semanticGraph.resolvedCallTable.sourceIndexes.len),
           strutil.Join([" reachability smoke: resolved rows consumed once ", label], ""))
    assert(csg.typedIrBuildIndexGeneration > 0 &&
           csg.typedIrBuildIndexSessionGeneration > 0 &&
           csg.typedIrBuildIndexContextCountAtSeal > 0 &&
           csg.typedIrBuildIndexMetadataRowCountAtSeal >=
               csg.typedIrBuildIndexContextCountAtSeal &&
           csg.typedIrBuildIndexValidationEpochAfterFixedPoint ==
               csg.typedIrBuildIndexValidationEpochAtSeal &&
           csg.typedIrBuildIndexValidationEpochAfterClose ==
               csg.typedIrBuildIndexValidationEpochAfterFixedPoint +
               csg.typedIrBuildIndexContextCountAtSeal &&
           csg.typedIrBuildIndexFullValidationCount == 2 &&
           csg.typedIrBuildIndexSealedAppendCount == csg.typedIrRoundCount - 1 &&
           csg.typedIrBuildIndexSealedFactsCount ==
               csg.typedIrBuildIndexSealedAppendCount &&
           csg.typedIrBuildIndexSealedValidationCount ==
               csg.typedIrBuildIndexSealedFactsCount +
               csg.typedIrBuildIndexSealedAppendCount &&
           csg.typedIrBuildIndexMetadataRowsVisitedAfterSeal >=
               Int64(csg.typedIrBuildIndexSealedValidationCount),
           strutil.Join([" reachability smoke: frozen metadata session accounting ", label], ""))
    let candidateFunctionCount = csg.semanticGraph.reachableFunctionTable.functionNames.len
    let nameProbeBound = csg.reachabilityNameHashOperationCount *
                         Int64(csg.reachabilityNameIndexEntryCount * 4 + 64)
    let lineProbeBound = csg.reachabilityLineBinarySearchOperationCount *
                         Int64(candidateFunctionCount + 1)
    let edgeProbeBound = csg.reachabilityEdgePairOperationCount *
                         Int64(csg.reachabilityFinalEdgeCount * 4 + 64)
    assert(csg.reachabilityNameHashOperationCount > Int64(0) &&
           csg.reachabilityNameHashProbeCount >= csg.reachabilityNameHashOperationCount &&
           csg.reachabilityNameHashProbeCount <= nameProbeBound &&
           csg.reachabilityNameHashMaxProbeCount > 0 &&
           csg.reachabilityNameHashMaxProbeCount <= csg.reachabilityNameIndexEntryCount * 4 + 64,
           strutil.Join([" reachability smoke: real name hash probes bounded ", label], ""))
    assert(csg.reachabilityLineBinarySearchOperationCount > Int64(0) &&
           csg.reachabilityLineBinarySearchProbeCount >= csg.reachabilityLineBinarySearchOperationCount &&
           csg.reachabilityLineBinarySearchProbeCount <= lineProbeBound &&
           csg.reachabilityLineBinarySearchMaxProbeCount > 0 &&
           csg.reachabilityLineBinarySearchMaxProbeCount <= candidateFunctionCount + 1,
           strutil.Join([" reachability smoke: real line probes bounded ", label], ""))
    assert(csg.reachabilityFinalEdgeCount > 0 &&
           csg.reachabilityEdgePairOperationCount > Int64(0) &&
           csg.reachabilityEdgePairProbeCount >= csg.reachabilityEdgePairOperationCount &&
           csg.reachabilityEdgePairProbeCount <= edgeProbeBound &&
           csg.reachabilityEdgePairMaxProbeCount > 0 &&
           csg.reachabilityEdgePairMaxProbeCount <= csg.reachabilityFinalEdgeCount * 4 + 64,
           strutil.Join([" reachability smoke: real edge probes bounded ", label], ""))

fn ExpectedInternPoolBytes(pool: langintern.InternPool,
                           retainedCapacity: bool): int64 =
    if pool == nil:
        return Int64(0)
    var textSlots = pool.texts.len
    if retainedCapacity:
        textSlots = pool.texts.cap
    var total = Int64(textSlots) * Int64(24) +
                langintern.InternPoolLogicalPayloadBytes(pool)
    if retainedCapacity:
        total = total + Int64(pool.indexVals.cap) * Int64(4)
        total = total + Int64(pool.indexStates.cap) * Int64(4)
        total = total + Int64(pool.indexOccupied.cap) * Int64(4)
    else:
        total = total + Int64(pool.indexUsed) * Int64(12)
    return total

fn ExpectedCompilerCsgInternBytes(csg: var ccsg.CompilerCsg,
                                  retainedCapacity: bool): int64 =
    var total = ExpectedInternPoolBytes(csg.typedExprFacts.internPool,
                                        retainedCapacity)
    if csg.typedIr.internPool != csg.typedExprFacts.internPool:
        total = total + ExpectedInternPoolBytes(csg.typedIr.internPool,
                                                retainedCapacity)
    let resolvedPool = csg.semanticGraph.resolvedCallTable.internPool
    if resolvedPool != csg.typedExprFacts.internPool &&
       resolvedPool != csg.typedIr.internPool:
        total = total + ExpectedInternPoolBytes(resolvedPool, retainedCapacity)
    return total

fn AssertMemoryLedgerContract(csg: var ccsg.CompilerCsg,
                              label: str) =
    let logicalSum = csg.scalarLogicalPayloadBytes +
                     csg.arenaLogicalPayloadBytes +
                     csg.internLogicalPayloadBytes +
                     csg.dynamicSequenceLogicalPayloadBytes +
                     csg.buildIndexLogicalPayloadBytes
    let retainedSum = csg.scalarRetainedCapacityBytes +
                      csg.arenaRetainedCapacityBytes +
                      csg.internRetainedCapacityBytes +
                      csg.dynamicSequenceRetainedCapacityBytes +
                      csg.buildIndexRetainedCapacityBytes
    let buildIndex = texpr.TypedExprIrBuildIndex(csg.typedIr)
    assert(csg.logicalPayloadBytes == logicalSum &&
           csg.retainedCapacityBytes == retainedSum &&
           ccsg.CompilerCsgLogicalPayloadBytes(csg) == logicalSum &&
           ccsg.CompilerCsgRetainedCapacityBytes(csg) == retainedSum &&
           csg.retainedCapacityBytes >= csg.logicalPayloadBytes &&
           csg.arenaRetainedCapacityBytes >= csg.arenaLogicalPayloadBytes &&
           csg.internLogicalPayloadBytes == ExpectedCompilerCsgInternBytes(csg, false) &&
           csg.internRetainedCapacityBytes == ExpectedCompilerCsgInternBytes(csg, true) &&
           csg.internRetainedCapacityBytes >= csg.internLogicalPayloadBytes &&
           csg.dynamicSequenceRetainedCapacityBytes >= csg.dynamicSequenceLogicalPayloadBytes &&
           csg.buildIndexLogicalPayloadBytes == texpr.TypedExprBuildIndexLogicalLiveBytes(buildIndex) &&
           csg.buildIndexRetainedCapacityBytes == texpr.TypedExprBuildIndexStructuredLiveBytes(buildIndex) &&
           csg.exprLayer.exprs.len == 0 &&
           csg.exprLayer.exprs.cap == 0 &&
           csg.exprLayer.exprNext.len == 0 &&
           csg.exprLayer.exprNext.cap == 0 &&
           csg.exprLayer.exprLookup.slots.len == 0 &&
           csg.exprLayer.exprLookup.slots.cap == 0 &&
           csg.exprLayer.exprLookup.buckets.len == 0 &&
           csg.exprLayer.exprLookup.buckets.cap == 0 &&
           csg.exprLayerLiveBytes == Int64(0) &&
           csg.semanticGraph.phaseLedger.compilerCsgLogicalPayloadBytes == csg.logicalPayloadBytes &&
           csg.semanticGraph.phaseLedger.compilerCsgRetainedCapacityBytes == csg.retainedCapacityBytes &&
           !csg.semanticGraph.phaseLedger.memoryAccountingIsRss,
           strutil.Join([" reachability smoke: owner-dedup memory ledger ", label], ""))

fn AssertMemoryLedgerRefreshAllocationFree(csg: var ccsg.CompilerCsg,
                                           label: str) =
    let buildIndex = texpr.TypedExprIrBuildIndex(csg.typedIr)
    let queryCountBefore = texpr.TypedExprBuildIndexQueryLookupCount(buildIndex)
    let allocCountBefore = system.memAllocCount()
    let typedIrLiveBytesBefore = csg.typedIrLiveBytes
    ccsg.CompilerCsgRefreshMemoryLedger(csg)
    let allocCountAfter = system.memAllocCount()
    let queryCountAfter = texpr.TypedExprBuildIndexQueryLookupCount(buildIndex)
    assert(allocCountAfter == allocCountBefore &&
           queryCountAfter == queryCountBefore &&
           csg.typedIrLiveBytes == typedIrLiveBytesBefore &&
           csg.internLogicalPayloadBytes == ExpectedCompilerCsgInternBytes(csg, false) &&
           csg.internRetainedCapacityBytes == ExpectedCompilerCsgInternBytes(csg, true),
           strutil.Join([" reachability smoke: allocation-free memory ledger ", label], ""))

fn AssertBackendPayloadReleasedLedger(csg: var ccsg.CompilerCsg,
                                      label: str) =
    let retainedMetadataBytes = Int64(csg.packageId.len) + Int64(96) +
                                Int64(csg.typedIrRoundBuildMsCsv.len) +
                                Int64(csg.typedIrRoundNewReachableCountCsv.len) +
                                Int64(csg.typedIrRoundBuildCountCsv.len)
    assert(csg.nodes.len == 0 && csg.edges.len == 0 &&
           csg.nodeCount == 0 && csg.edgeCount == 0 &&
           csg.exprLayer.exprs.len == 0 &&
           csg.exprLayer.exprs.cap == 0 &&
           csg.exprLayer.exprNext.cap == 0 &&
           csg.exprLayer.exprLookup.slots.cap == 0 &&
           csg.exprLayer.exprLookup.buckets.cap == 0 &&
           csg.typedExprFacts.count == 0 &&
           csg.typedExprFactCountSnapshot == 0 &&
           csg.typedIr.functions2_functionNameIds.len == 0 &&
           csg.semanticGraph.builderName == "" &&
           csg.nodesLiveBytes == Int64(0) &&
           csg.edgesLiveBytes == Int64(0) &&
           csg.exprLayerLiveBytes == Int64(0) &&
           csg.typedFactsLiveBytes == Int64(0) &&
           csg.typedIrLiveBytes == Int64(0) &&
           csg.sourceTextLiveBytes == Int64(0) &&
           csg.arenaLogicalPayloadBytes == Int64(0) &&
           csg.arenaRetainedCapacityBytes == Int64(0) &&
           csg.internLogicalPayloadBytes == Int64(0) &&
           csg.internRetainedCapacityBytes == Int64(0) &&
           csg.dynamicSequenceLogicalPayloadBytes == Int64(0) &&
           csg.dynamicSequenceRetainedCapacityBytes == Int64(0) &&
           csg.buildIndexLogicalPayloadBytes == Int64(0) &&
           csg.buildIndexRetainedCapacityBytes == Int64(0) &&
           csg.metadataLiveBytes == Int64(csg.packageId.len) + Int64(96) &&
           csg.scalarLogicalPayloadBytes == retainedMetadataBytes &&
           csg.scalarRetainedCapacityBytes == retainedMetadataBytes &&
           csg.logicalPayloadBytes == retainedMetadataBytes &&
           csg.retainedCapacityBytes == retainedMetadataBytes,
           strutil.Join([" reachability smoke: released payload ledger ", label], ""))

fn AssertSemanticScalarStringLedgerDelta(csg: var ccsg.CompilerCsg) =
    let originalBuilderName = csg.semanticGraph.builderName
    let originalOracleReason = csg.semanticGraph.oracleMismatchReason
    let originalSliceReason = csg.semanticGraph.exprSliceValidationReason
    let scalarBefore = csg.scalarLogicalPayloadBytes
    let scalarRetainedBefore = csg.scalarRetainedCapacityBytes
    let logicalBefore = csg.logicalPayloadBytes
    let retainedBefore = csg.retainedCapacityBytes
    let builderSuffix = "-builder-ledger-extension"
    let oracleSuffix = "-oracle-ledger-extension"
    let sliceSuffix = "-slice-ledger-extension"

    csg.semanticGraph.builderName = strutil.Join([originalBuilderName, builderSuffix], "")
    ccsg.CompilerCsgRefreshMemoryLedger(csg)
    assert(csg.scalarLogicalPayloadBytes == scalarBefore + Int64(builderSuffix.len) &&
           csg.scalarRetainedCapacityBytes == scalarRetainedBefore + Int64(builderSuffix.len) &&
           csg.logicalPayloadBytes == logicalBefore + Int64(builderSuffix.len) &&
           csg.retainedCapacityBytes == retainedBefore + Int64(builderSuffix.len),
           " reachability smoke: builderName missing from scalar ledger")

    csg.semanticGraph.oracleMismatchReason = strutil.Join([originalOracleReason, oracleSuffix], "")
    ccsg.CompilerCsgRefreshMemoryLedger(csg)
    let builderOracleDelta = Int64(builderSuffix.len + oracleSuffix.len)
    assert(csg.scalarLogicalPayloadBytes == scalarBefore + builderOracleDelta &&
           csg.scalarRetainedCapacityBytes == scalarRetainedBefore + builderOracleDelta &&
           csg.logicalPayloadBytes == logicalBefore + builderOracleDelta &&
           csg.retainedCapacityBytes == retainedBefore + builderOracleDelta,
           " reachability smoke: oracleMismatchReason missing from scalar ledger")

    csg.semanticGraph.exprSliceValidationReason = strutil.Join([originalSliceReason, sliceSuffix], "")
    ccsg.CompilerCsgRefreshMemoryLedger(csg)
    let allScalarDelta = builderOracleDelta + Int64(sliceSuffix.len)
    assert(csg.scalarLogicalPayloadBytes == scalarBefore + allScalarDelta &&
           csg.scalarRetainedCapacityBytes == scalarRetainedBefore + allScalarDelta &&
           csg.logicalPayloadBytes == logicalBefore + allScalarDelta &&
           csg.retainedCapacityBytes == retainedBefore + allScalarDelta &&
           csg.semanticGraph.phaseLedger.compilerCsgLogicalPayloadBytes == csg.logicalPayloadBytes &&
           csg.semanticGraph.phaseLedger.compilerCsgRetainedCapacityBytes == csg.retainedCapacityBytes,
           " reachability smoke: exprSliceValidationReason missing from scalar ledger")

    csg.semanticGraph.builderName = originalBuilderName
    csg.semanticGraph.oracleMismatchReason = originalOracleReason
    csg.semanticGraph.exprSliceValidationReason = originalSliceReason
    ccsg.CompilerCsgRefreshMemoryLedger(csg)
    assert(csg.scalarLogicalPayloadBytes == scalarBefore &&
           csg.scalarRetainedCapacityBytes == scalarRetainedBefore &&
           csg.logicalPayloadBytes == logicalBefore &&
           csg.retainedCapacityBytes == retainedBefore,
           " reachability smoke: scalar ledger did not restore exactly")

fn AssertAdjacencyReject(base: ccsg.CompilerCsgSemanticResolvedCallTable,
                         functionCount: int32,
                         mode: int32,
                         expectedError: str) =
    var table = ccsg.CompilerCsgSemanticResolvedCallTableClone(base)
    assert(table.sourceIndexes.len > 0,
           " reachability smoke: adjacency negative requires a row")
    let row = 0
    let owner = table.functionIndexes[row]
    if mode == 1:
        table.functionRowHeads[owner] = -2
    elif mode == 2:
        table.functionRowNext[row] = -2
    elif mode == 3:
        table.functionIndexes[row] = functionCount
    elif mode == 4:
        table.functionRowNext[row] = row
    elif mode == 5:
        table.functionRowHeads[owner] = -1
    else:
        panic("reachability smoke: invalid adjacency mode")
    var err: str
    assert(!ccsg.CompilerCsgSemanticResolvedCallTableValidate(table,
                                                        functionCount,
                                                        err) &&
           strings.StrContains(err, expectedError),
           strutil.Join([" reachability smoke: adjacency negative ", expectedError, " got ", err], ""))
    ccsg.CompilerCsgSemanticResolvedCallTableRelease(table)

fn AssertResolvedCloneColumnsIndependent(original: var ccsg.CompilerCsgSemanticResolvedCallTable,
                                         cloned: var ccsg.CompilerCsgSemanticResolvedCallTable) =
    assert(original.sourceIndexes.len > 0 &&
           cloned.sourceIndexes.len == original.sourceIndexes.len &&
           cloned.functionRowHeads.len == original.functionRowHeads.len &&
           original.internPool != nil && cloned.internPool != nil &&
           original.internPool != cloned.internPool,
           " reachability smoke: resolved clone requires rows")
    let originalInternCount = langintern.InternPoolCount(original.internPool)
    let clonedInternCount = langintern.InternPoolCount(cloned.internPool)
    let _cloneOnlyIntern = langintern.Intern(cloned.internPool,
                                             "__compiler_csg_clone_only_probe__")
    assert(langintern.InternPoolCount(original.internPool) == originalInternCount &&
           langintern.InternPoolCount(cloned.internPool) == clonedInternCount + 1,
           " reachability smoke: resolved clone shares intern owner")
    cloned.sourceIndexes[0] = cloned.sourceIndexes[0] + 1
    cloned.originParserNodeIds[0] = cloned.originParserNodeIds[0] + 1
    cloned.functionIndexes[0] = cloned.functionIndexes[0] + 1
    cloned.functionRowHeads[0] = cloned.functionRowHeads[0] - 1
    cloned.functionRowNext[0] = cloned.functionRowNext[0] - 1
    cloned.sourcePathIds[0] = cloned.sourcePathIds[0] + 1
    cloned.lineNumbers[0] = cloned.lineNumbers[0] + 1
    cloned.columnNumbers[0] = cloned.columnNumbers[0] + 1
    cloned.callQualifierIds[0] = cloned.callQualifierIds[0] + 1
    cloned.callCalleeIds[0] = cloned.callCalleeIds[0] + 1
    cloned.callTargetIds[0] = cloned.callTargetIds[0] + 1
    cloned.callTargetSourcePathIds[0] = cloned.callTargetSourcePathIds[0] + 1
    cloned.callTargetImportcFlags[0] = !cloned.callTargetImportcFlags[0]
    cloned.callArgCounts[0] = cloned.callArgCounts[0] + 1
    cloned.callArgsTextIds[0] = cloned.callArgsTextIds[0] + 1
    cloned.returnRootFlags[0] = !cloned.returnRootFlags[0]
    assert(cloned.sourceIndexes[0] != original.sourceIndexes[0] &&
           cloned.originParserNodeIds[0] != original.originParserNodeIds[0] &&
           cloned.functionIndexes[0] != original.functionIndexes[0] &&
           cloned.functionRowHeads[0] != original.functionRowHeads[0] &&
           cloned.functionRowNext[0] != original.functionRowNext[0] &&
           cloned.sourcePathIds[0] != original.sourcePathIds[0] &&
           cloned.lineNumbers[0] != original.lineNumbers[0] &&
           cloned.columnNumbers[0] != original.columnNumbers[0] &&
           cloned.callQualifierIds[0] != original.callQualifierIds[0] &&
           cloned.callCalleeIds[0] != original.callCalleeIds[0] &&
           cloned.callTargetIds[0] != original.callTargetIds[0] &&
           cloned.callTargetSourcePathIds[0] != original.callTargetSourcePathIds[0] &&
           cloned.callTargetImportcFlags[0] != original.callTargetImportcFlags[0] &&
           cloned.callArgCounts[0] != original.callArgCounts[0] &&
           cloned.callArgsTextIds[0] != original.callArgsTextIds[0] &&
           cloned.returnRootFlags[0] != original.returnRootFlags[0],
           " reachability smoke: resolved clone columns share storage")

fn AssertSemanticCloneAllMutableSoaIndependent() =
    var source: ccsg.CompilerCsgSemanticGraph
    source.sourceTable.sourcePaths = ["source"]
    source.sourceTable.modulePaths = ["module"]
    source.sourceTable.textBytes = [1]
    source.sourceTable.declStart = [2]
    source.sourceTable.declCount = [3]
    source.sourceTable.importEdgeStart = [4]
    source.sourceTable.importEdgeCount = [5]
    source.declTable.sourceIndex = [6]
    source.declTable.names = ["decl"]
    source.declTable.lineNumbers = [7]
    source.declTable.importc = [false]
    source.declTable.exported = [true]
    source.importEdgeTable.ownerSourceIndex = [8]
    source.importEdgeTable.targetSourceIndex = [9]
    source.importEdgeTable.ownerModulePaths = ["owner"]
    source.importEdgeTable.targetModulePaths = ["target"]
    source.importEdgeTable.targetSourcePaths = ["target-source"]
    source.importEdgeTable.resolved = [true]
    source.reachableFunctionTable.sourceIndex = [10]
    source.reachableFunctionTable.sourcePaths = ["reachable-source"]
    source.reachableFunctionTable.functionNames = ["reachable-function"]
    source.reachableFunctionTable.symbolTexts = ["reachable-symbol"]
    source.reachableFunctionTable.startLines = [11]
    source.reachableFunctionTable.endLines = [12]
    source.reachableFunctionTable.reachable = [true]
    source.exprSliceTable.sourceIndex = [13]
    source.exprSliceTable.sourcePaths = ["slice-source"]
    source.exprSliceTable.functionIndex = [14]
    source.exprSliceTable.exprStart = [15]
    source.exprSliceTable.exprCount = [16]
    source.exprSliceTable.typedFactStart = [17]
    source.exprSliceTable.typedFactCount = [18]
    source.exprSliceTable.typedFactSemanticDigests = [181]
    source.exprSliceTable.typedIrSemanticDigests = [182]
    source.exprSliceTable.typedIrFunctionIndexes = [0]
    source.exprSliceTable.semanticValidated = [true]
    source.exprSliceTable.functionSliceIndexes = [0]
    source.typedFactTable.sourceIndexes = [19]
    source.typedFactTable.functionIndexes = [0]
    source.typedFactTable.semanticIdentityCertificates = [191]
    source.typedFactTable.valueKinds = [1]
    source.typedFactTable.placeKinds = [2]
    source.typedFactTable.hasSinks = [true]
    source.typedFactTable.sinkPlaceKinds = [3]
    source.typedFactTable.loweringModes = [4]
    source.typedFactTable.callKinds = [5]
    source.typedFactTable.typeCallKinds = [6]
    source.typedFactTable.returnKinds = [7]
    source.typedFactTable.returnRoots = [true]
    source.typedFactSemanticSliceCount = 1
    source.typedFactSemanticValidatedSliceCount = 1
    source.typedFactSemanticConservationProved = true
    source.typedIrTable.functionSourceIndexes = [20]
    source.typedIrTable.functionNames = ["typed-function"]
    source.typedIrTable.functionNodeStart = [21]
    source.typedIrTable.functionNodeCount = [22]
    source.typedIrTable.functionStatementStart = [23]
    source.typedIrTable.functionStatementCount = [24]
    source.resolvedCallTable = EmptyResolvedCalls(1)
    AppendResolvedReturnRow(source.resolvedCallTable, 0, "source", 1, "target")

    var cloned = ccsg.CompilerCsgSemanticGraphClone(source)
    cloned.sourceTable.sourcePaths[0] = "changed"
    cloned.sourceTable.modulePaths[0] = "changed"
    cloned.sourceTable.textBytes[0] = -1
    cloned.sourceTable.declStart[0] = -1
    cloned.sourceTable.declCount[0] = -1
    cloned.sourceTable.importEdgeStart[0] = -1
    cloned.sourceTable.importEdgeCount[0] = -1
    cloned.declTable.sourceIndex[0] = -1
    cloned.declTable.names[0] = "changed"
    cloned.declTable.lineNumbers[0] = -1
    cloned.declTable.importc[0] = true
    cloned.declTable.exported[0] = false
    cloned.importEdgeTable.ownerSourceIndex[0] = -1
    cloned.importEdgeTable.targetSourceIndex[0] = -1
    cloned.importEdgeTable.ownerModulePaths[0] = "changed"
    cloned.importEdgeTable.targetModulePaths[0] = "changed"
    cloned.importEdgeTable.targetSourcePaths[0] = "changed"
    cloned.importEdgeTable.resolved[0] = false
    cloned.reachableFunctionTable.sourceIndex[0] = -1
    cloned.reachableFunctionTable.sourcePaths[0] = "changed"
    cloned.reachableFunctionTable.functionNames[0] = "changed"
    cloned.reachableFunctionTable.symbolTexts[0] = "changed"
    cloned.reachableFunctionTable.startLines[0] = -1
    cloned.reachableFunctionTable.endLines[0] = -1
    cloned.reachableFunctionTable.reachable[0] = false
    cloned.exprSliceTable.sourceIndex[0] = -1
    cloned.exprSliceTable.sourcePaths[0] = "changed"
    cloned.exprSliceTable.functionIndex[0] = -1
    cloned.exprSliceTable.exprStart[0] = -1
    cloned.exprSliceTable.exprCount[0] = -1
    cloned.exprSliceTable.typedFactStart[0] = -1
    cloned.exprSliceTable.typedFactCount[0] = -1
    cloned.exprSliceTable.typedFactSemanticDigests[0] = -1
    cloned.exprSliceTable.typedIrSemanticDigests[0] = -1
    cloned.exprSliceTable.typedIrFunctionIndexes[0] = -1
    cloned.exprSliceTable.semanticValidated[0] = false
    cloned.exprSliceTable.functionSliceIndexes[0] = -1
    cloned.typedFactTable.sourceIndexes[0] = -1
    cloned.typedFactTable.functionIndexes[0] = -1
    cloned.typedFactTable.semanticIdentityCertificates[0] = -1
    cloned.typedFactTable.valueKinds[0] = -1
    cloned.typedFactTable.placeKinds[0] = -1
    cloned.typedFactTable.hasSinks[0] = false
    cloned.typedFactTable.sinkPlaceKinds[0] = -1
    cloned.typedFactTable.loweringModes[0] = -1
    cloned.typedFactTable.callKinds[0] = -1
    cloned.typedFactTable.typeCallKinds[0] = -1
    cloned.typedFactTable.returnKinds[0] = -1
    cloned.typedFactTable.returnRoots[0] = false
    cloned.typedFactSemanticSliceCount = 0
    cloned.typedFactSemanticValidatedSliceCount = 0
    cloned.typedFactSemanticConservationProved = false
    cloned.typedIrTable.functionSourceIndexes[0] = -1
    cloned.typedIrTable.functionNames[0] = "changed"
    cloned.typedIrTable.functionNodeStart[0] = -1
    cloned.typedIrTable.functionNodeCount[0] = -1
    cloned.typedIrTable.functionStatementStart[0] = -1
    cloned.typedIrTable.functionStatementCount[0] = -1
    AssertResolvedCloneColumnsIndependent(source.resolvedCallTable,
                                          cloned.resolvedCallTable)

    assert(source.sourceTable.sourcePaths[0] == "source" &&
           source.sourceTable.modulePaths[0] == "module" &&
           source.sourceTable.textBytes[0] == 1 &&
           source.sourceTable.declStart[0] == 2 &&
           source.sourceTable.declCount[0] == 3 &&
           source.sourceTable.importEdgeStart[0] == 4 &&
           source.sourceTable.importEdgeCount[0] == 5 &&
           source.declTable.sourceIndex[0] == 6 &&
           source.declTable.names[0] == "decl" &&
           source.declTable.lineNumbers[0] == 7 &&
           !source.declTable.importc[0] && source.declTable.exported[0] &&
           source.importEdgeTable.ownerSourceIndex[0] == 8 &&
           source.importEdgeTable.targetSourceIndex[0] == 9 &&
           source.importEdgeTable.ownerModulePaths[0] == "owner" &&
           source.importEdgeTable.targetModulePaths[0] == "target" &&
           source.importEdgeTable.targetSourcePaths[0] == "target-source" &&
           source.importEdgeTable.resolved[0] &&
           source.reachableFunctionTable.sourceIndex[0] == 10 &&
           source.reachableFunctionTable.sourcePaths[0] == "reachable-source" &&
           source.reachableFunctionTable.functionNames[0] == "reachable-function" &&
           source.reachableFunctionTable.symbolTexts[0] == "reachable-symbol" &&
           source.reachableFunctionTable.startLines[0] == 11 &&
           source.reachableFunctionTable.endLines[0] == 12 &&
           source.reachableFunctionTable.reachable[0] &&
           source.exprSliceTable.sourceIndex[0] == 13 &&
           source.exprSliceTable.sourcePaths[0] == "slice-source" &&
           source.exprSliceTable.functionIndex[0] == 14 &&
           source.exprSliceTable.exprStart[0] == 15 &&
           source.exprSliceTable.exprCount[0] == 16 &&
           source.exprSliceTable.typedFactStart[0] == 17 &&
           source.exprSliceTable.typedFactCount[0] == 18 &&
           source.exprSliceTable.typedFactSemanticDigests[0] == 181 &&
           source.exprSliceTable.typedIrSemanticDigests[0] == 182 &&
           source.exprSliceTable.typedIrFunctionIndexes[0] == 0 &&
           source.exprSliceTable.semanticValidated[0] &&
           source.exprSliceTable.functionSliceIndexes[0] == 0 &&
           source.typedFactTable.sourceIndexes[0] == 19 &&
           source.typedFactTable.functionIndexes[0] == 0 &&
           source.typedFactTable.semanticIdentityCertificates[0] == 191 &&
           source.typedFactTable.valueKinds[0] == 1 &&
           source.typedFactTable.placeKinds[0] == 2 &&
           source.typedFactTable.hasSinks[0] &&
           source.typedFactTable.sinkPlaceKinds[0] == 3 &&
           source.typedFactTable.loweringModes[0] == 4 &&
           source.typedFactTable.callKinds[0] == 5 &&
           source.typedFactTable.typeCallKinds[0] == 6 &&
           source.typedFactTable.returnKinds[0] == 7 &&
           source.typedFactTable.returnRoots[0] &&
           source.typedFactSemanticSliceCount == 1 &&
           source.typedFactSemanticValidatedSliceCount == 1 &&
           source.typedFactSemanticConservationProved &&
           source.typedIrTable.functionSourceIndexes[0] == 20 &&
           source.typedIrTable.functionNames[0] == "typed-function" &&
           source.typedIrTable.functionNodeStart[0] == 21 &&
           source.typedIrTable.functionNodeCount[0] == 22 &&
           source.typedIrTable.functionStatementStart[0] == 23 &&
           source.typedIrTable.functionStatementCount[0] == 24,
           " reachability smoke: semantic graph clone shares mutable SoA storage")
    ccsg.CompilerCsgSemanticResolvedCallTableRelease(cloned.resolvedCallTable)
    ccsg.CompilerCsgSemanticResolvedCallTableRelease(source.resolvedCallTable)

fn main(): int32 =
    let root = "/tmp/compiler_csg_incremental_reachability_smoke"
    let directSourcePath = strutil.Join([root, "/direct/indexed.cheng"], "")
    AssertOverloadGraphPruneUsesFunctionIndex(directSourcePath)
    AssertSemanticIdentityIndexContracts()
    AssertSemanticIdentityIndexLargeNLinearProbe()
    AssertDeclarationNameExactSetCollisionPressure()
    AssertTypedFactSemanticSnapshotDetectsFieldMutation()
    AssertFinalGraphPruneKeepsTypedIrLateReachable(directSourcePath)
    AssertStructuredNameIndex()
    AssertTypedIrIndexedFrontierExpansion(directSourcePath)
    AssertTypedIrSoaColumnContracts(directSourcePath)
    AssertTypedIrOwnerAndSurfaceContracts(directSourcePath)
    AssertTypedFactsAddressFailureAtomic(directSourcePath)
    AssertReachabilityContentCertificates(directSourcePath)
    AssertProfileSourceIndexContentCertificate(directSourcePath)
    AssertDuplicateEdgeRehashKeepsGraphSeal(directSourcePath)
    AssertTypedFactAccumulatorBatchAtomicRetry(directSourcePath)
    AssertAccumulatorCertifiedPrefixLinearGrowth(directSourcePath)
    AssertAccumulatorPrevalidationAndOwnerContracts(directSourcePath)
    AssertFrontierAppendBatchAtomicRetry(directSourcePath)
    AssertFrontierIndexFullPrevalidation(directSourcePath)
    AssertTypedIrStatementBatchAtomicRetry(directSourcePath)
    AssertTypedIrReturnBatchAtomicRetry(directSourcePath)
    AssertReachabilityDeltaCommitPreflightAtomic(directSourcePath)
    AssertFrontierCursorColumnInvariant(directSourcePath)
    AssertFilterLateRowAtomicRetry(directSourcePath)
    AssertProfileQueueLateRowAtomicRetry(directSourcePath)
    AssertMemberReturnSnapshotEdge(directSourcePath)
    AssertAmbiguousCandidateExpansionPreservesLegacy(directSourcePath)
    AssertRetainedFrontierLateFailureAtomic(directSourcePath)
    AssertFrontierIndexOperationCountLinear(directSourcePath)
    AssertParserFrontierLateFailureAtomic(directSourcePath)
    AssertProfileScanLateFailureAtomic(directSourcePath)
    AssertCompactProfileScratchUsesClosureDegree(directSourcePath)
    AssertPhaseLedgerIndependentOracle()
    AssertFinalOwnerMappingRejects(directSourcePath)
    AssertSemanticCloneAllMutableSoaIndependent()
    let firstRoot = strutil.Join([root, "/closure_a"], "")
    let secondRoot = strutil.Join([root, "/closure_b"], "")
    let atomicRoot = strutil.Join([root, "/borrowed_atomic"], "")
    let overloadRoot = strutil.Join([root, "/overload_batch"], "")
    let firstSource = "fn Leaf(x: int32) -> int32 =\n    return x + 1\n\nfn Middle(x: int32) -> int32 =\n    return Leaf(x)\n\nfn Root() -> int32 =\n    return Middle(1)\n\nfn Unused(x: int32) -> int32 =\n    return x - 1\n"
    let secondSource = "fn Leaf(x: int32) -> int32 =\n    return x + 2\n\nfn Middle(x: int32) -> int32 =\n    return Leaf(x)\n\nfn Root() -> int32 =\n    return Middle(2)\n\nfn Unused(x: int32) -> int32 =\n    return x - 2\n"
    AssertConsumeInputAtomicity(atomicRoot,
                                "pkg://cheng/compiler_csg_consume_atomic_smoke",
                                firstSource)
    AssertOverloadBatchGraphEquivalent(overloadRoot)
    let oldBatchLimit = os.GetEnv("CHENG_CSG_TYPED_IR_BATCH_LIMIT")
    os.SetEnv("CHENG_CSG_TYPED_IR_BATCH_LIMIT", "1")
    var csg: ccsg.CompilerCsg
    var csgErr: str
    assert(BuildFixtureInto(firstRoot,
                            "pkg://cheng/compiler_csg_incremental_smoke",
                            firstSource,
                            csg,
                            csgErr),
           strutil.Join([" reachability smoke: first build ", csgErr], ""))
    assert(csg.typedIrBatchLimit == 1 && csg.typedIrRoundCount >= 3,
           " reachability smoke: first batch=1 exercises multi-round append")
    AssertCompilerCsgSemanticConservationMutation(csg)
    AssertLinearCounters(csg, "first")
    AssertMemoryLedgerContract(csg, "first")
    AssertMemoryLedgerRefreshAllocationFree(csg, "first")
    os.SetEnv("CHENG_CSG_TYPED_IR_BATCH_LIMIT", "")
    var defaultBatchCsg: ccsg.CompilerCsg
    csgErr = ""
    assert(BuildFixtureInto(firstRoot,
                            "pkg://cheng/compiler_csg_incremental_smoke",
                            firstSource,
                            defaultBatchCsg,
                            csgErr),
           strutil.Join([" reachability smoke: default batch build ", csgErr], ""))
    assert(defaultBatchCsg.typedIrBatchLimit != 1,
           " reachability smoke: default batch did not exercise independent schedule")
    AssertCompilerCsgGraphEquivalent(csg,
                                     defaultBatchCsg,
                                     "batch=1/default")
    assert(csg.exprLayer.exprs.len == 0 && csg.exprLayer.sourceCount == 0 &&
           csg.exprLayer.questionResidualCount == 0 &&
           csg.exprLayer.exprs.cap == 0 && csg.exprLayer.exprNext.cap == 0 &&
           csg.exprLayer.exprLookup.slots.cap == 0 &&
           csg.exprLayer.exprLookup.buckets.cap == 0 &&
           defaultBatchCsg.exprLayer.exprs.len == 0 &&
           defaultBatchCsg.exprLayer.sourceCount == 0 &&
           defaultBatchCsg.exprLayer.questionResidualCount == 0 &&
           defaultBatchCsg.exprLayer.exprs.cap == 0 &&
           defaultBatchCsg.exprLayer.exprNext.cap == 0 &&
           defaultBatchCsg.exprLayer.exprLookup.slots.cap == 0 &&
           defaultBatchCsg.exprLayer.exprLookup.buckets.cap == 0,
           " reachability smoke: cold export input retained expr layer")
    ccsg.CompilerCsgReleaseBackendInputPayload(defaultBatchCsg)
    os.SetEnv("CHENG_CSG_TYPED_IR_BATCH_LIMIT", "1")
    let firstStatementCount = csg.typedIrFinalStatementCount
    let firstFunctionCount = csg.typedIrFinalFunctionCount
    let firstScannedStatementCount = csg.typedIrReachabilityScannedStatementCount
    let firstScannedFunctionCount = csg.typedIrReachabilityScannedFunctionCount
    let firstGraphCid = csg.graphCid
    let firstBuildIndex = texpr.TypedExprIrBuildIndex(csg.typedIr)
    let firstBuildIndexLiveBytes = texpr.TypedExprBuildIndexLiveBytes(firstBuildIndex)
    let firstTypedIrMetadataLiveBytes = ccsg.CompilerCsgTypedIrMetadataLiveBytes(csg.typedIr)
    let firstResolvedPool = csg.semanticGraph.resolvedCallTable.internPool
    assert(firstBuildIndex != nil && firstResolvedPool != nil &&
           firstBuildIndexLiveBytes > Int64(0) &&
           firstTypedIrMetadataLiveBytes >= firstBuildIndexLiveBytes &&
           csg.metadataLiveBytes >= firstTypedIrMetadataLiveBytes &&
           langintern.InternPoolCount(firstResolvedPool) > 0,
           " reachability smoke: first owned indexes and live-byte accounting")

    csgErr = ""
    assert(BuildFixtureInto(secondRoot,
                            "pkg://cheng/compiler_csg_incremental_smoke",
                            secondSource,
                            csg,
                            csgErr),
           strutil.Join([" reachability smoke: second build ", csgErr], ""))
    os.SetEnv("CHENG_CSG_TYPED_IR_BATCH_LIMIT", oldBatchLimit)
    assert(texpr.TypedExprBuildIndexReleaseCount(firstBuildIndex) == 1,
           " reachability smoke: reused output released first build index")
    assert(texpr.TypedExprBuildIndexLiveBytes(firstBuildIndex) == Int64(0),
           " reachability smoke: reused output zeroed first build-index live bytes")
    assert(langintern.InternPoolCount(firstResolvedPool) == 0,
           " reachability smoke: reused output released first resolved-call pool")
    AssertLinearCounters(csg, "second")
    AssertMemoryLedgerContract(csg, "second")
    AssertMemoryLedgerRefreshAllocationFree(csg, "second")
    AssertSemanticScalarStringLedgerDelta(csg)
    assert(csg.typedIrFinalStatementCount == firstStatementCount &&
           csg.typedIrFinalFunctionCount == firstFunctionCount &&
           csg.typedIrReachabilityScannedStatementCount == firstScannedStatementCount &&
           csg.typedIrReachabilityScannedFunctionCount == firstScannedFunctionCount &&
           csg.reachabilityNameHashOperationCount > Int64(0) &&
           csg.reachabilityLineBinarySearchOperationCount > Int64(0) &&
           csg.reachabilityEdgePairOperationCount > Int64(0),
           " reachability smoke: same-process counters are independent")
    assert(!layout.FixedBytes32Equal(firstGraphCid, csg.graphCid),
           " reachability smoke: equal-shape different closures have different graph cid")
    var adjacencyErr: str
    assert(ccsg.CompilerCsgSemanticResolvedCallTableValidate(csg.semanticGraph.resolvedCallTable,
                                                       csg.typedIrFinalFunctionCount,
                                                       adjacencyErr),
           strutil.Join([" reachability smoke: resolved-call adjacency ", adjacencyErr], ""))
    assert(csg.semanticGraph.resolvedCallTable.sourceIndexes.len > 0 &&
           csg.semanticGraph.resolvedCallTable.functionRowHeads.len ==
               csg.typedIrFinalFunctionCount &&
           csg.semanticGraph.reachableFunctionTable.functionNames.len > csg.typedIrFinalFunctionCount,
           " reachability smoke: resolved-call adjacency populated")
    AssertAdjacencyReject(csg.semanticGraph.resolvedCallTable,
                          csg.typedIrFinalFunctionCount,
                          1,
                          "adjacency head out of range")
    AssertAdjacencyReject(csg.semanticGraph.resolvedCallTable,
                          csg.typedIrFinalFunctionCount,
                          2,
                          "adjacency next out of range")
    AssertAdjacencyReject(csg.semanticGraph.resolvedCallTable,
                          csg.typedIrFinalFunctionCount,
                          3,
                          "owner index invalid")
    AssertAdjacencyReject(csg.semanticGraph.resolvedCallTable,
                          csg.typedIrFinalFunctionCount,
                          4,
                          "adjacency duplicate or cycle")
    AssertAdjacencyReject(csg.semanticGraph.resolvedCallTable,
                          csg.typedIrFinalFunctionCount,
                          5,
                          "row missing from function adjacency")
    let report = ccsg.CompilerCsgReport(csg)
    assert(strings.StrContains(report, "typed_ir_reachability_scanned_statement_count=") &&
           strings.StrContains(report, "typed_ir_reachability_scanned_function_count=") &&
           strings.StrContains(report, "typed_ir_reachability_resolved_call_row_visit_count=") &&
           strings.StrContains(report, "typed_ir_reachability_new_reachable_function_count=") &&
           strings.StrContains(report, "typed_ir_final_statement_count=") &&
           strings.StrContains(report, "typed_ir_final_function_count=") &&
           strings.StrContains(report, "typed_ir_build_index_generation=") &&
           strings.StrContains(report, "typed_ir_build_index_session_generation=") &&
           strings.StrContains(report, "typed_ir_build_index_context_count_at_seal=") &&
           strings.StrContains(report, "typed_ir_build_index_validation_epoch_at_seal=") &&
           strings.StrContains(report, "typed_ir_build_index_validation_epoch_after_fixed_point=") &&
           strings.StrContains(report, "typed_ir_build_index_validation_epoch_after_close=") &&
           strings.StrContains(report, "typed_ir_build_index_metadata_row_count_at_seal=") &&
           strings.StrContains(report, "typed_ir_build_index_metadata_rows_visited_after_seal=") &&
           strings.StrContains(report, "typed_ir_build_index_full_validation_count=2\n") &&
           strings.StrContains(report, "typed_ir_build_index_sealed_facts_count=") &&
           strings.StrContains(report, "typed_ir_build_index_sealed_append_count=") &&
           strings.StrContains(report, "typed_ir_build_index_sealed_validation_count=") &&
           strings.StrContains(report, "reachability_name_hash_operation_count=") &&
           strings.StrContains(report, "reachability_name_hash_probe_count=") &&
           strings.StrContains(report, "reachability_name_hash_max_probe_count=") &&
           strings.StrContains(report, "reachability_name_index_entry_count=") &&
           strings.StrContains(report, "reachability_line_binary_search_operation_count=") &&
           strings.StrContains(report, "reachability_line_binary_search_probe_count=") &&
           strings.StrContains(report, "reachability_line_binary_search_max_probe_count=") &&
           strings.StrContains(report, "reachability_edge_pair_operation_count=") &&
           strings.StrContains(report, "reachability_edge_pair_probe_count=") &&
           strings.StrContains(report, "reachability_edge_pair_max_probe_count=") &&
           strings.StrContains(report, "reachability_final_edge_count=") &&
           strings.StrContains(report, "logical_payload_bytes=") &&
           strings.StrContains(report, "retained_capacity_bytes=") &&
           strings.StrContains(report, "memory_accounting_is_rss=0") &&
           strings.StrContains(report, "memory_accounting_is_physical_release=0") &&
           strings.StrContains(report, "semantic_source=") &&
           strings.StrContains(report, "semantic_decl_line=") &&
           strings.StrContains(report, "semantic_params=") &&
           strings.StrContains(report, "semantic_return=") &&
           strings.StrContains(report, "semantic_signature_complete="),
           " reachability smoke: report metrics")
    let wireReport = ccsg.CompilerCsgWireReport(csg)
    assert(strings.StrContains(wireReport, "reachability_name_hash_operation_count=") &&
           strings.StrContains(wireReport, "reachability_name_hash_probe_count=") &&
           strings.StrContains(wireReport, "reachability_line_binary_search_probe_count=") &&
           strings.StrContains(wireReport, "reachability_edge_pair_probe_count=") &&
           strings.StrContains(wireReport, "reachability_final_edge_count=") &&
           strings.StrContains(wireReport, "typed_ir_build_index_session_generation=") &&
           strings.StrContains(wireReport, "typed_ir_build_index_validation_epoch_after_close=") &&
           strings.StrContains(wireReport, "typed_ir_build_index_full_validation_count=2\n") &&
           strings.StrContains(wireReport, "logical_payload_bytes=") &&
           strings.StrContains(wireReport, "retained_capacity_bytes=") &&
           strings.StrContains(wireReport, "memory_accounting_is_rss=0") &&
           strings.StrContains(wireReport, "memory_accounting_is_physical_release=0"),
           " reachability smoke: wire report probe metrics")

    let secondBuildIndex = texpr.TypedExprIrBuildIndex(csg.typedIr)
    let secondBuildIndexLiveBytes = texpr.TypedExprBuildIndexLiveBytes(secondBuildIndex)
    let secondTypedIrMetadataLiveBytes = ccsg.CompilerCsgTypedIrMetadataLiveBytes(csg.typedIr)
    let secondTypedIrPool = csg.typedIr.internPool
    let secondArenaBase = csg.typedIr.arena.basePtr
    let secondResolvedPool = csg.semanticGraph.resolvedCallTable.internPool
    var clonedCsg = ccsg.CompilerCsgClone(csg)
    AssertCompilerCsgGraphEquivalent(csg, clonedCsg, "public deep clone")
    AssertMemoryLedgerContract(clonedCsg, "clone")
    let clonedBuildIndex = texpr.TypedExprIrBuildIndex(clonedCsg.typedIr)
    let clonedBuildIndexLiveBytes = texpr.TypedExprBuildIndexLiveBytes(clonedBuildIndex)
    let clonedTypedIrMetadataLiveBytes = ccsg.CompilerCsgTypedIrMetadataLiveBytes(clonedCsg.typedIr)
    let clonedTypedIrPool = clonedCsg.typedIr.internPool
    let clonedArenaBase = clonedCsg.typedIr.arena.basePtr
    let clonedResolvedPool = clonedCsg.semanticGraph.resolvedCallTable.internPool
    assert(clonedCsg.typedIrReachabilityResolvedCallRowVisitCount ==
               csg.typedIrReachabilityResolvedCallRowVisitCount &&
           clonedCsg.typedIrBuildIndexGeneration == csg.typedIrBuildIndexGeneration &&
           clonedCsg.typedIrBuildIndexSessionGeneration ==
               csg.typedIrBuildIndexSessionGeneration &&
           clonedCsg.typedIrBuildIndexContextCountAtSeal ==
               csg.typedIrBuildIndexContextCountAtSeal &&
           clonedCsg.typedIrBuildIndexValidationEpochAtSeal ==
               csg.typedIrBuildIndexValidationEpochAtSeal &&
           clonedCsg.typedIrBuildIndexValidationEpochAfterFixedPoint ==
               csg.typedIrBuildIndexValidationEpochAfterFixedPoint &&
           clonedCsg.typedIrBuildIndexValidationEpochAfterClose ==
               csg.typedIrBuildIndexValidationEpochAfterClose &&
           clonedCsg.typedIrBuildIndexMetadataRowCountAtSeal ==
               csg.typedIrBuildIndexMetadataRowCountAtSeal &&
           clonedCsg.typedIrBuildIndexMetadataRowsVisitedAfterSeal ==
               csg.typedIrBuildIndexMetadataRowsVisitedAfterSeal &&
           clonedCsg.typedIrBuildIndexFullValidationCount ==
               csg.typedIrBuildIndexFullValidationCount &&
           clonedCsg.typedIrBuildIndexSealedFactsCount ==
               csg.typedIrBuildIndexSealedFactsCount &&
           clonedCsg.typedIrBuildIndexSealedAppendCount ==
               csg.typedIrBuildIndexSealedAppendCount &&
           clonedCsg.typedIrBuildIndexSealedValidationCount ==
               csg.typedIrBuildIndexSealedValidationCount &&
           clonedCsg.reachabilityNameHashProbeCount == csg.reachabilityNameHashProbeCount &&
           clonedCsg.reachabilityLineBinarySearchProbeCount ==
               csg.reachabilityLineBinarySearchProbeCount &&
           clonedCsg.reachabilityEdgePairProbeCount == csg.reachabilityEdgePairProbeCount &&
           layout.FixedBytes32Equal(clonedCsg.graphCid, csg.graphCid) &&
           layout.FixedBytes32Equal(clonedCsg.canonicalGraphCid, csg.canonicalGraphCid),
           " reachability smoke: clone preserves probe metrics")
    assert(clonedBuildIndex != nil && clonedBuildIndex != secondBuildIndex,
           " reachability smoke: clone owns independent build index")
    assert(secondBuildIndexLiveBytes > Int64(0) &&
           clonedBuildIndexLiveBytes == secondBuildIndexLiveBytes &&
           clonedTypedIrMetadataLiveBytes == secondTypedIrMetadataLiveBytes &&
           csg.metadataLiveBytes >= secondTypedIrMetadataLiveBytes &&
           clonedCsg.metadataLiveBytes == csg.metadataLiveBytes,
           " reachability smoke: clone independently preserves build-index live bytes")
    assert(clonedResolvedPool != nil && clonedResolvedPool != secondResolvedPool &&
           langintern.InternPoolCount(clonedResolvedPool) == langintern.InternPoolCount(secondResolvedPool),
           " reachability smoke: clone owns independent resolved-call pool")
    assert(secondTypedIrPool != nil && clonedTypedIrPool != nil &&
           secondTypedIrPool != clonedTypedIrPool &&
           secondArenaBase != nil && clonedArenaBase != nil &&
           secondArenaBase != clonedArenaBase,
           " reachability smoke: clone owns independent TypedIR arena and intern pool")
    AssertResolvedCloneColumnsIndependent(csg.semanticGraph.resolvedCallTable,
                                          clonedCsg.semanticGraph.resolvedCallTable)
    texpr.TypedExprIrReleaseBuildIndex(clonedCsg.typedIr)
    ccsg.CompilerCsgRefreshMemoryLedger(clonedCsg)
    assert(texpr.TypedExprBuildIndexReleaseCount(clonedBuildIndex) == 1 &&
           texpr.TypedExprBuildIndexReleaseCount(secondBuildIndex) == 0 &&
           texpr.TypedExprBuildIndexLiveBytes(clonedBuildIndex) == Int64(0) &&
           texpr.TypedExprBuildIndexLiveBytes(secondBuildIndex) == secondBuildIndexLiveBytes &&
           clonedCsg.buildIndexLogicalPayloadBytes == Int64(0) &&
           clonedCsg.buildIndexRetainedCapacityBytes == Int64(0) &&
           csg.buildIndexRetainedCapacityBytes == secondBuildIndexLiveBytes &&
           ccsg.CompilerCsgTypedIrMetadataLiveBytes(clonedCsg.typedIr) ==
               clonedTypedIrMetadataLiveBytes - clonedBuildIndexLiveBytes &&
           ccsg.CompilerCsgTypedIrMetadataLiveBytes(csg.typedIr) == secondTypedIrMetadataLiveBytes,
           " reachability smoke: build-index bytes are exact and clone release is isolated")
    let cloneFreeBefore = system.memFreeCount()
    texpr.TypedExprIrReleasePayload(clonedCsg.typedIr)
    assert(texpr.TypedExprBuildIndexReleaseCount(clonedBuildIndex) == 1 &&
           texpr.TypedExprBuildIndexReleaseCount(secondBuildIndex) == 0 &&
           ccsg.CompilerCsgTypedIrMetadataLiveBytes(clonedCsg.typedIr) == Int64(0) &&
           ccsg.CompilerCsgTypedIrMetadataLiveBytes(csg.typedIr) == secondTypedIrMetadataLiveBytes,
           " reachability smoke: clone payload release preserves source accounting")
    assert(clonedCsg.typedIr.arena.basePtr == nil &&
           clonedCsg.typedIr.arena.capacityBytes == 0 &&
           clonedCsg.typedIr.internPool == nil &&
           langintern.InternPoolCount(clonedTypedIrPool) == 0 &&
           system.memFreeCount() > cloneFreeBefore,
           " reachability smoke: clone TypedIR storage release")
    ccsg.CompilerCsgReleaseBackendInputPayload(clonedCsg)
    AssertBackendPayloadReleasedLedger(clonedCsg, "clone")
    assert(langintern.InternPoolCount(clonedResolvedPool) == 0 &&
           langintern.InternPoolCount(secondResolvedPool) > 0,
           " reachability smoke: clone metadata and resolved-pool release isolation")
    assert(csg.typedIr.arena.basePtr == secondArenaBase &&
           csg.typedIr.internPool == secondTypedIrPool &&
           langintern.InternPoolCount(secondTypedIrPool) > 0,
           " reachability smoke: clone release invalidated source TypedIR")

    AssertExplicitCallExclusions()

    var negativeSet: ccsg.CompilerCsgReachableFunctionSet
    let secondSourcePath = strutil.Join([secondRoot, "/src/main.cheng"], "")
    InitReachableSet(secondSourcePath, negativeSet)
    SealReachableFixture(negativeSet, "resolved snapshot negatives")
    AssertResolvedSnapshotReject(negativeSet,
                                 secondSourcePath,
                                 "",
                                 secondSourcePath,
                                 true,
                                 "executable call target empty")
    AssertResolvedSnapshotReject(negativeSet,
                                 secondSourcePath,
                                 "Target",
                                 "/tmp/compiler_csg_incremental_reachability_smoke/src/missing.cheng",
                                 true,
                                 "executable call target source missing")
    AssertResolvedSnapshotReject(negativeSet,
                                 secondSourcePath,
                                 "MissingFunction",
                                 secondSourcePath,
                                 true,
                                 "executable call target function missing")
    AssertResolvedSnapshotReject(negativeSet,
                                 secondSourcePath,
                                 "MissingFunction",
                                 secondSourcePath,
                                 false,
                                 "executable call unresolved")
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(negativeSet)

    echo(strutil.Join(["typed_ir_round_count=", strings.IntToStr(csg.typedIrRoundCount)], ""))
    echo(strutil.Join(["typed_ir_scanned_statement_count=", strings.IntToStr(csg.typedIrReachabilityScannedStatementCount)], ""))
    echo(strutil.Join(["typed_ir_final_statement_count=", strings.IntToStr(csg.typedIrFinalStatementCount)], ""))
    echo(strutil.Join(["typed_ir_scanned_function_count=", strings.IntToStr(csg.typedIrReachabilityScannedFunctionCount)], ""))
    echo(strutil.Join(["typed_ir_final_function_count=", strings.IntToStr(csg.typedIrFinalFunctionCount)], ""))
    ccsg.CompilerCsgReleaseBackendInputPayload(csg)
    assert(texpr.TypedExprBuildIndexReleaseCount(secondBuildIndex) == 1,
           " reachability smoke: final build-index release")
    assert(texpr.TypedExprBuildIndexLiveBytes(secondBuildIndex) == Int64(0) &&
           ccsg.CompilerCsgTypedIrMetadataLiveBytes(csg.typedIr) == Int64(0) &&
           csg.typedIrLiveBytes == Int64(0),
           " reachability smoke: final build-index accounting release")
    AssertBackendPayloadReleasedLedger(csg, "final")
    assert(langintern.InternPoolCount(secondResolvedPool) == 0,
           " reachability smoke: final resolved-call pool release")
    assert(langintern.InternPoolCount(secondTypedIrPool) == 0 &&
           csg.typedIr.arena.basePtr == nil &&
           csg.typedIr.arena.capacityBytes == 0 &&
           csg.typedIr.internPool == nil,
           " reachability smoke: final TypedIR owner release")
    echo(" compiler_csg_incremental_reachability_smoke ok")
    return 0
