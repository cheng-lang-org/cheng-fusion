    total = total + Int64(summary.typeCallDefaultInitCount)
    total = total + Int64(summary.typeCallConstructorCount)
    total = total + Int64(summary.returnRegCount)
    total = total + Int64(summary.returnCompositeLocalCount)
    total = total + Int64(summary.returnSretCount)
    total = total + Int64(summary.returnImportBufferCount)
    total = total + Int64(summary.returnDeferredCount)
