import cheng/core/ir/core_types as ir
import cheng/core/ir/body_ir_access as access
import cheng/core/ir/body_ir_cfg as cfg
import cheng/core/backend/regalloc_single_pass as alloc

fn makeI32Slot(id: int32, parameter: bool): ir.LocalSlot =
    var slot: ir.LocalSlot
    slot.id = id
    slot.name = "cfg_value"
    slot.typeKind = ir.LocalI32Tag
    slot.stackOffset = 16 + id * 8
    if parameter:
        slot.stackOffset = -1
    slot.sizeBytes = 4
    slot.alignBytes = 4
    ir.BodyIRApplyLocalSlotDefaultProof(slot)
    return slot

fn appendConst(body: var ir.BodyIR, target: int32, value: int32) =
    var op: ir.BodyOp
    op.kind = ir.BodyOpLoadConstTag
    op.target = target
    add(op.operands, ir.LocalI32Tag)
    add(op.operands, value)
    add(body.ops, op)

fn appendCopy(body: var ir.BodyIR, target: int32, source: int32) =
    var op: ir.BodyOp
    op.kind = ir.BodyOpCopyLocalTag
    op.target = target
    add(op.operands, source)
    add(body.ops, op)

fn appendVoidCall(body: var ir.BodyIR, symbol: str) =
    var call: ir.CallOp
    call.targetSymbol = symbol
    call.resultSlot = -1
    call.resultPassKind = ir.BodyCallPassStackValueTag
    call.relocWordOffset = -1
    let callOrdinal = body.callSequence.len
    add(body.callSequence, call)
    var op: ir.BodyOp
    op.kind = ir.BodyOpCallTag
    op.target = -1
    add(op.operands, callOrdinal)
    add(body.ops, op)

fn appendReturn(body: var ir.BodyIR, resultSlot: int32): int32 =
    var term: ir.BodyTerm
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = resultSlot
    add(term.operands, ir.LocalI32Tag)
    return ir.BodyIRAppendTerm(body, term)

fn appendBr(body: var ir.BodyIR, targetBlock: int32): int32 =
    var term: ir.BodyTerm
    term.kind = ir.BodyTermBrTag
    term.trueBlock = targetBlock
    return ir.BodyIRAppendTerm(body, term)

fn appendCbr(body: var ir.BodyIR,
             conditionSlot: int32,
             trueBlock: int32,
             falseBlock: int32): int32 =
    var term: ir.BodyTerm
    term.kind = ir.BodyTermCbrTag
    term.conditionKind = ir.BodyCondLocalNonZeroTag
    term.resultSlot = conditionSlot
    term.lhsSlot = conditionSlot
    term.rhsSlot = -1
    term.trueBlock = trueBlock
    term.falseBlock = falseBlock
    return ir.BodyIRAppendTerm(body, term)

fn twoRegisterConstraints(): alloc.RegallocTargetConstraints =
    var out = alloc.RegallocTargetConstraintsInit()
    add(out.registerUniverse, 0)
    add(out.registerUniverse, 1)
    add(out.registerUniverse, 2)
    add(out.allocatableCallerRegs, 1)
    add(out.allocatableCallerRegs, 2)
    add(out.callClobberRegs, 0)
    add(out.callClobberRegs, 1)
    add(out.callClobberRegs, 2)
    out.fixedReturnReg = 0
    add(out.gprTypeKinds, ir.LocalI32Tag)
    return out

fn edgeIndexFor(plan: var alloc.RegallocSinglePassValuePlan,
                sourceBlock: int32,
                targetBlock: int32): int32 =
    for edgeIndex in 0..<plan.edgeSourceBlocks.len:
        if plan.edgeSourceBlocks[edgeIndex] == sourceBlock &&
           plan.edgeTargetBlocks[edgeIndex] == targetBlock:
            return edgeIndex
    return -1

fn reachablePredecessorCount(analysis: var cfg.BodyIrCfgAnalysis,
                             blockIndex: int32): int32 =
    var count: int32
    for predIndex in analysis.predOffsets[blockIndex]..<analysis.predOffsets[blockIndex + 1]:
        if analysis.reachable[analysis.predBlocks[predIndex]]:
            count = count + 1
    return count

fn valueLocation(plan: var alloc.RegallocSinglePassValuePlan,
                 valueId: int32): int32 =
    if plan.valueAssignedRegs[valueId] >= 0:
        return alloc.RegallocValueLocationRegister
    return alloc.RegallocValueLocationStack

fn edgeActionFieldsValid(plan: var alloc.RegallocSinglePassValuePlan,
                         action: alloc.RegallocValueAction,
                         edgeIndex: int32,
                         parallelGroup: int32,
                         parallelOrdinal: int32,
                         requiresEdgeSplit: bool): bool =
    if action.kind != alloc.RegallocValueActionEdgeParallelCopy ||
       action.placement != alloc.RegallocValuePlacementEdge ||
       action.edgeIndex != edgeIndex ||
       action.sourceBlock != plan.edgeSourceBlocks[edgeIndex] ||
       action.targetBlock != plan.edgeTargetBlocks[edgeIndex] ||
       action.parallelGroup != parallelGroup ||
       action.parallelOrdinal != parallelOrdinal ||
       action.requiresEdgeSplit != requiresEdgeSplit ||
       action.relatedActionOrdinal != -1:
        return false
    if action.valueId < 0 || action.valueId >= plan.valueSlotIndices.len ||
       action.otherValueId < 0 ||
       action.otherValueId >= plan.valueSlotIndices.len:
        return false
    if plan.valueSlotIndices[action.valueId] != action.encodedValue ||
       plan.valueSlotIndices[action.otherValueId] != action.encodedValue ||
       action.sourceLocation != valueLocation(plan, action.valueId) ||
       action.targetLocation != valueLocation(plan, action.otherValueId) ||
       action.sourceReg != plan.valueAssignedRegs[action.valueId] ||
       action.targetReg != plan.valueAssignedRegs[action.otherValueId] ||
       action.targetMemoryHome != plan.valueMemoryHomes[action.otherValueId]:
        return false
    if (action.sourceLocation == alloc.RegallocValueLocationRegister) !=
       (action.sourceReg >= 0) ||
       (action.targetLocation == alloc.RegallocValueLocationRegister) !=
       (action.targetReg >= 0):
        return false
    return true

fn edgeSliceValid(plan: var alloc.RegallocSinglePassValuePlan,
                  analysis: var cfg.BodyIrCfgAnalysis,
                  edgeIndex: int32,
                  expectedCount: int32): bool =
    if edgeIndex < 0 || edgeIndex >= plan.edgeActionCounts.len ||
       plan.edgeActionCounts[edgeIndex] != expectedCount ||
       expectedCount <= 0:
        return false
    let start = plan.edgeActionStarts[edgeIndex]
    if start < 0 || start > plan.actions.len - expectedCount:
        return false
    let sourceBlock = plan.edgeSourceBlocks[edgeIndex]
    let targetBlock = plan.edgeTargetBlocks[edgeIndex]
    let successorCount = analysis.succOffsets[sourceBlock + 1] -
                         analysis.succOffsets[sourceBlock]
    let expectedSplit = successorCount > 1 &&
                        reachablePredecessorCount(analysis, targetBlock) > 1
    let group = plan.actions[start].parallelGroup
    if group < 0:
        return false
    for offset in 0..<expectedCount:
        let action = plan.actions[start + offset]
        if action.consumerOrdinal != start + offset ||
           !edgeActionFieldsValid(plan, action, edgeIndex, group,
                                  offset, expectedSplit):
            return false
    return true

fn virtualEntrySliceValid(plan: var alloc.RegallocSinglePassValuePlan,
                          blockIndex: int32,
                          expectedCount: int32): bool =
    if blockIndex < 0 || blockIndex >= plan.virtualEntryActionCounts.len ||
       plan.virtualEntryActionCounts[blockIndex] != expectedCount ||
       expectedCount <= 0:
        return false
    let start = plan.virtualEntryActionStarts[blockIndex]
    if start < 0 || start > plan.actions.len - expectedCount:
        return false
    let group = plan.actions[start].parallelGroup
    if group < 0:
        return false
    for offset in 0..<expectedCount:
        let action = plan.actions[start + offset]
        if action.consumerOrdinal != start + offset ||
           action.kind != alloc.RegallocValueActionEdgeParallelCopy ||
           action.placement != alloc.RegallocValuePlacementFunctionEntry ||
           action.blockIndex != -1 || action.sourceBlock != -1 ||
           action.targetBlock != blockIndex || action.edgeIndex != -1 ||
           action.requiresEdgeSplit || action.parallelGroup != group ||
           action.parallelOrdinal != offset ||
           action.relatedActionOrdinal != -1 || action.valueId < 0 ||
           action.valueId >= plan.valueSlotIndices.len ||
           action.otherValueId < 0 ||
           action.otherValueId >= plan.valueSlotIndices.len ||
           plan.valueSlotIndices[action.valueId] != action.encodedValue ||
           plan.valueSlotIndices[action.otherValueId] != action.encodedValue ||
           action.sourceLocation != valueLocation(plan, action.valueId) ||
           action.targetLocation != valueLocation(plan, action.otherValueId) ||
           action.sourceReg != plan.valueAssignedRegs[action.valueId] ||
           action.targetReg != plan.valueAssignedRegs[action.otherValueId] ||
           action.targetMemoryHome !=
               plan.valueMemoryHomes[action.otherValueId] ||
           (action.sourceLocation ==
                alloc.RegallocValueLocationRegister) !=
               (action.sourceReg >= 0) ||
           (action.targetLocation ==
                alloc.RegallocValueLocationRegister) !=
               (action.targetReg >= 0):
            return false
    return true

fn consumeAndFinalize(plan: var alloc.RegallocSinglePassValuePlan): bool =
    if !alloc.RegallocSinglePassValuePlanValidate(plan) || plan.finalized:
        return false
    let proofHash =
        "2222222222222222222222222222222222222222222222222222222222222222"
    let emptyProofHash =
        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    if !alloc.RegallocSinglePassValuePlanBeginEmissionSymbol(
           plan, "cfg_smoke", 0,
           (plan.actions.len + 1) * 4):
        return false
    for ordinal in 0..<plan.actions.len:
        var action: alloc.RegallocValueAction
        var ticket: alloc.RegallocValueActionTicket
        if !alloc.RegallocSinglePassValuePlanActionAt(
               plan, ordinal, action, ticket) ||
           action.consumerOrdinal != ordinal || action.acknowledged:
            return false
        let bindingKind =
            alloc.RegallocSinglePassValueActionBindingKind(action.kind)
        var acked: bool
        if bindingKind == alloc.RegallocValueBindingStructural:
            acked = alloc.RegallocSinglePassValuePlanAck(
                plan, ticket, 0, 0, emptyProofHash)
        else:
            acked = alloc.RegallocSinglePassValuePlanAck(
                plan, ticket, ordinal * 4, 4, proofHash)
        if !acked || !plan.actions[ordinal].acknowledged:
            return false
    return alloc.RegallocSinglePassValuePlanSealEmissionSymbol(
               plan, proofHash) &&
           alloc.RegallocSinglePassValuePlanFinalize(plan) &&
           plan.finalized && plan.nextAckOrdinal == plan.actions.len &&
           alloc.RegallocSinglePassValuePlanValidate(plan)

fn buildDiamond(): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeI32Slot(0, true))
    add(body.localSlots, makeI32Slot(1, false))
    appendConst(body, 1, 11)
    appendConst(body, 1, 22)
    let entryTerm = appendCbr(body, 0, 1, 2)
    let leftTerm = appendBr(body, 3)
    let rightTerm = appendBr(body, 3)
    let joinTerm = appendReturn(body, 1)
    let _ = ir.BodyIRAppendBlock(body, 0, 0, entryTerm)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, leftTerm)
    let _ = ir.BodyIRAppendBlock(body, 1, 1, rightTerm)
    let _ = ir.BodyIRAppendBlock(body, 2, 0, joinTerm)
    return body

fn testDiamondAndDeterminism(): int32 =
    var body = buildDiamond()
    var table = access.BodyIrAccessDecode(body)
    var analysis = cfg.BodyIrCfgAnalyze(body, table)
    var constraints = twoRegisterConstraints()
    var first = alloc.RegallocSinglePassValuePlanBuild(
        body, table, analysis, constraints)
    var second = alloc.RegallocSinglePassValuePlanBuildDecoded(
        body, constraints)
    let mergeFlat = 3 * analysis.slotCount + 1
    if !table.valid || !analysis.valid || !first.valid || !first.frozen ||
       analysis.hasCycle || analysis.mergeInputCounts[mergeFlat] != 2 ||
       analysis.mergeValueByBlockSlot[mergeFlat] < table.nextValueId ||
       !alloc.RegallocSinglePassValuePlanEquivalent(first, second):
        return 11
    let leftEdge = edgeIndexFor(first, 1, 3)
    let rightEdge = edgeIndexFor(first, 2, 3)
    if leftEdge < 0 || rightEdge < 0 ||
       first.edgeActionCounts[leftEdge] > 1 ||
       first.edgeActionCounts[rightEdge] > 1:
        return 12
    if first.edgeActionCounts[leftEdge] == 1 &&
       (!edgeSliceValid(first, analysis, leftEdge, 1) ||
        first.actions[first.edgeActionStarts[leftEdge]].requiresEdgeSplit):
        return 15
    if first.edgeActionCounts[rightEdge] == 1 &&
       (!edgeSliceValid(first, analysis, rightEdge, 1) ||
        first.actions[first.edgeActionStarts[rightEdge]].requiresEdgeSplit):
        return 16
    var missingAck = alloc.RegallocSinglePassValuePlanBuildDecoded(
        body, constraints)
    if alloc.RegallocSinglePassValuePlanFinalize(missingAck) ||
       missingAck.valid ||
       missingAck.errorCode != alloc.RegallocValuePlanErrorUnacknowledged:
        return 13
    if !consumeAndFinalize(first):
        return 14
    return 0

fn buildLoop(): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeI32Slot(0, true))
    appendCopy(body, 0, 0)
    let headerTerm = appendCbr(body, 0, 1, 2)
    let latchTerm = appendBr(body, 0)
    let exitTerm = appendReturn(body, 0)
    let _ = ir.BodyIRAppendBlock(body, 0, 0, headerTerm)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, latchTerm)
    let _ = ir.BodyIRAppendBlock(body, 1, 0, exitTerm)
    return body

fn applyCopyAction(action: alloc.RegallocValueAction,
                   values: var int32[]): bool =
    if action.kind != alloc.RegallocValueActionEdgeParallelCopy ||
       action.valueId < 0 || action.valueId >= values.len ||
       action.otherValueId < 0 || action.otherValueId >= values.len:
        return false
    values[action.otherValueId] = values[action.valueId]
    return true

fn testLoopBackedge(): int32 =
    var body = buildLoop()
    var table = access.BodyIrAccessDecode(body)
    var analysis = cfg.BodyIrCfgAnalyze(body, table)
    var constraints = twoRegisterConstraints()
    var plan = alloc.RegallocSinglePassValuePlanBuild(
        body, table, analysis, constraints)
    if !analysis.valid || !analysis.hasCycle || !plan.valid ||
       analysis.mergeValueByBlockSlot[0] < table.nextValueId ||
       analysis.mergeInputCounts[0] != 2:
        return 21
    let edgeIndex = edgeIndexFor(plan, 1, 0)
    if !edgeSliceValid(plan, analysis, edgeIndex, 1) ||
       !virtualEntrySliceValid(plan, 0, 1) ||
       plan.blockEntryActionCounts[0] != 0 ||
       plan.functionEntryActionStart < 0 ||
       plan.functionEntryActionCount <= 0:
        return 22
    let edgeAction = plan.actions[plan.edgeActionStarts[edgeIndex]]
    let entryAction = plan.actions[plan.virtualEntryActionStarts[0]]
    let mergeStart = analysis.mergeInputStarts[0]
    if edgeAction.valueId != analysis.mergeInputValues[mergeStart + 1] ||
       edgeAction.otherValueId != analysis.mergeValueByBlockSlot[0] ||
       edgeAction.valueId == edgeAction.otherValueId ||
       edgeAction.requiresEdgeSplit ||
       entryAction.otherValueId != edgeAction.otherValueId ||
       entryAction.valueId == edgeAction.valueId:
        return 23
    var positiveValues: int32[]
    var negativeValues: int32[]
    for valueId in 0..<plan.valueSlotIndices.len:
        add(positiveValues, 1000 + valueId)
        add(negativeValues, 1000 + valueId)
    if !applyCopyAction(entryAction, positiveValues) ||
       !applyCopyAction(edgeAction, positiveValues) ||
       !applyCopyAction(edgeAction, positiveValues) ||
       positiveValues[edgeAction.otherValueId] !=
           positiveValues[edgeAction.valueId]:
        return 24
    if !applyCopyAction(entryAction, negativeValues) ||
       !applyCopyAction(edgeAction, negativeValues) ||
       !applyCopyAction(entryAction, negativeValues) ||
       negativeValues[edgeAction.otherValueId] ==
           negativeValues[edgeAction.valueId] ||
       negativeValues[edgeAction.otherValueId] !=
           negativeValues[entryAction.valueId]:
        return 25
    if !consumeAndFinalize(plan):
        return 26
    return 0

fn buildUnreachable(): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeI32Slot(0, true))
    var deadCall: ir.CallOp
    deadCall.targetSymbol = "unreachable_call"
    deadCall.resultSlot = -1
    deadCall.resultPassKind = ir.BodyCallPassStackValueTag
    deadCall.relocWordOffset = -1
    add(body.callSequence, deadCall)
    var deadCallOp: ir.BodyOp
    deadCallOp.kind = ir.BodyOpCallTag
    deadCallOp.target = -1
    add(deadCallOp.operands, 0)
    add(body.ops, deadCallOp)
    let liveReturn = appendReturn(body, 0)
    let deadBackedge = appendBr(body, 0)
    let _ = ir.BodyIRAppendBlock(body, 0, 0, liveReturn)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, deadBackedge)
    return body

fn testUnreachableBlock(): int32 =
    var body = buildUnreachable()
    var table = access.BodyIrAccessDecode(body)
    var analysis = cfg.BodyIrCfgAnalyze(body, table)
    var constraints = twoRegisterConstraints()
    var plan = alloc.RegallocSinglePassValuePlanBuild(
        body, table, analysis, constraints)
    if !analysis.valid || !analysis.reachable[0] || analysis.reachable[1] ||
       analysis.reversePostorder.len != 1 || !plan.valid ||
       plan.blockEntryPositions[0] < 0 ||
       plan.blockEntryPositions[1] != -1 ||
       plan.blockExitPositions[1] != -1 || plan.edgeActionCounts.len != 1 ||
       plan.edgeActionCounts[0] != 0 || plan.callCount != 1 ||
       plan.callReachable.len != 1 || plan.callReachable[0]:
        return 31
    for actionIndex in 0..<plan.actions.len:
        let action = plan.actions[actionIndex]
        if action.blockIndex == 1 || action.sourceBlock == 1 ||
           action.targetBlock == 1 ||
           action.kind == alloc.RegallocValueActionCallClobber:
            return 32
    if !consumeAndFinalize(plan):
        return 33
    return 0

fn buildCriticalEdge(): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeI32Slot(0, true))
    add(body.localSlots, makeI32Slot(1, true))
    let entryTerm = appendCbr(body, 0, 2, 1)
    let sideTerm = appendBr(body, 2)
    let joinTerm = appendReturn(body, 1)
    let _ = ir.BodyIRAppendBlock(body, 0, 0, entryTerm)
    let _ = ir.BodyIRAppendBlock(body, 0, 0, sideTerm)
    let _ = ir.BodyIRAppendBlock(body, 0, 0, joinTerm)
    return body

fn testCriticalEdge(): int32 =
    var body = buildCriticalEdge()
    var table = access.BodyIrAccessDecode(body)
    var analysis = cfg.BodyIrCfgAnalyze(body, table)
    var constraints = twoRegisterConstraints()
    var plan = alloc.RegallocSinglePassValuePlanBuild(
        body, table, analysis, constraints)
    let criticalEdge = edgeIndexFor(plan, 0, 2)
    let sideEdge = edgeIndexFor(plan, 1, 2)
    if !analysis.valid || !plan.valid ||
       !edgeSliceValid(plan, analysis, criticalEdge, 1) ||
       !edgeSliceValid(plan, analysis, sideEdge, 1):
        return 41
    let criticalAction = plan.actions[plan.edgeActionStarts[criticalEdge]]
    let sideAction = plan.actions[plan.edgeActionStarts[sideEdge]]
    if !criticalAction.requiresEdgeSplit || sideAction.requiresEdgeSplit ||
       criticalAction.sourceBlock != 0 || criticalAction.targetBlock != 2 ||
       criticalAction.sourceLocation != valueLocation(
           plan, criticalAction.valueId) ||
       criticalAction.targetLocation != valueLocation(
           plan, criticalAction.otherValueId) ||
       criticalAction.sourceReg !=
           plan.valueAssignedRegs[criticalAction.valueId] ||
       criticalAction.targetReg !=
           plan.valueAssignedRegs[criticalAction.otherValueId]:
        return 42
    if !consumeAndFinalize(plan):
        return 43
    return 0

fn buildParallelCopyCycle(): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeI32Slot(0, false))
    add(body.localSlots, makeI32Slot(1, false))
    add(body.localSlots, makeI32Slot(2, true))
    add(body.localSlots, makeI32Slot(3, false))
    add(body.localSlots, makeI32Slot(4, false))
    appendConst(body, 1, 11)
    appendConst(body, 0, 10)
    appendConst(body, 1, 21)
    appendConst(body, 0, 20)
    appendCopy(body, 3, 0)
    appendCopy(body, 4, 1)
    let entryTerm = appendCbr(body, 2, 1, 2)
    let leftTerm = appendBr(body, 3)
    let rightTerm = appendBr(body, 3)
    let joinTerm = appendReturn(body, 4)
    let _ = ir.BodyIRAppendBlock(body, 0, 0, entryTerm)
    let _ = ir.BodyIRAppendBlock(body, 0, 2, leftTerm)
    let _ = ir.BodyIRAppendBlock(body, 2, 2, rightTerm)
    let _ = ir.BodyIRAppendBlock(body, 4, 2, joinTerm)
    return body

fn edgeHasRegisterSwapCycle(plan: var alloc.RegallocSinglePassValuePlan,
                            edgeIndex: int32): bool =
    if edgeIndex < 0 || plan.edgeActionCounts[edgeIndex] != 2:
        return false
    let start = plan.edgeActionStarts[edgeIndex]
    let first = plan.actions[start]
    let second = plan.actions[start + 1]
    return first.parallelGroup >= 0 &&
           first.parallelGroup == second.parallelGroup &&
           first.parallelOrdinal == 0 && second.parallelOrdinal == 1 &&
           first.sourceLocation == alloc.RegallocValueLocationRegister &&
           first.targetLocation == alloc.RegallocValueLocationRegister &&
           second.sourceLocation == alloc.RegallocValueLocationRegister &&
           second.targetLocation == alloc.RegallocValueLocationRegister &&
           first.sourceReg >= 0 && first.targetReg >= 0 &&
           first.sourceReg != first.targetReg &&
           first.sourceReg == second.targetReg &&
           first.targetReg == second.sourceReg &&
           first.valueId != first.otherValueId &&
           second.valueId != second.otherValueId &&
           first.encodedValue != second.encodedValue

fn testParallelCopyCycle(): int32 =
    var body = buildParallelCopyCycle()
    var table = access.BodyIrAccessDecode(body)
    var analysis = cfg.BodyIrCfgAnalyze(body, table)
    var constraints = twoRegisterConstraints()
    var first = alloc.RegallocSinglePassValuePlanBuild(
        body, table, analysis, constraints)
    var second = alloc.RegallocSinglePassValuePlanBuildDecoded(
        body, constraints)
    if !analysis.valid || first.valid || second.valid ||
       first.errorCode != alloc.RegallocValuePlanErrorParallelCopy ||
       second.errorCode != alloc.RegallocValuePlanErrorParallelCopy:
        return 51
    return 0

fn buildNonIndexRpoCalls(): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeI32Slot(0, true))
    appendVoidCall(body, "left_call")
    appendVoidCall(body, "right_call")
    let entryTerm = appendCbr(body, 0, 1, 2)
    let leftTerm = appendBr(body, 3)
    let rightTerm = appendBr(body, 3)
    let joinTerm = appendReturn(body, 0)
    let _ = ir.BodyIRAppendBlock(body, 0, 0, entryTerm)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, leftTerm)
    let _ = ir.BodyIRAppendBlock(body, 1, 1, rightTerm)
    let _ = ir.BodyIRAppendBlock(body, 2, 0, joinTerm)
    return body

fn callClobberActionIndex(plan: var alloc.RegallocSinglePassValuePlan,
                          callOrdinal: int32): int32 =
    for actionIndex in 0..<plan.actions.len:
        let action = plan.actions[actionIndex]
        if action.kind == alloc.RegallocValueActionCallClobber &&
           action.callOrdinal == callOrdinal:
            return actionIndex
    return -1

fn testNonIndexRpoActionOrder(): int32 =
    var body = buildNonIndexRpoCalls()
    var table = access.BodyIrAccessDecode(body)
    var analysis = cfg.BodyIrCfgAnalyze(body, table)
    var constraints = twoRegisterConstraints()
    var plan = alloc.RegallocSinglePassValuePlanBuild(
        body, table, analysis, constraints)
    if !table.valid || !analysis.valid || !plan.valid ||
       analysis.reversePostorder.len != 4 ||
       analysis.reversePostorder[0] != 0 ||
       analysis.reversePostorder[1] != 2 ||
       analysis.reversePostorder[2] != 1 ||
       analysis.reversePostorder[3] != 3 ||
       plan.blockEntryPositions[2] >= plan.blockEntryPositions[1]:
        return 71
    let leftAction = callClobberActionIndex(plan, 0)
    let rightAction = callClobberActionIndex(plan, 1)
    if leftAction < 0 || rightAction < 0 ||
       rightAction >= leftAction ||
       plan.actions[rightAction].position >=
           plan.actions[leftAction].position:
        return 72
    if !consumeAndFinalize(plan):
        return 73
    return 0

fn testDamagedCfgAndMergeHardFail(): int32 =
    var badEdgeBody = ir.BodyIRNew()
    add(badEdgeBody.localSlots, makeI32Slot(0, true))
    let badBranch = appendBr(badEdgeBody, 1)
    let _ = ir.BodyIRAppendBlock(badEdgeBody, 0, 0, badBranch)
    var constraints = twoRegisterConstraints()
    var badEdgePlan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        badEdgeBody, constraints)
    if badEdgePlan.valid ||
       badEdgePlan.errorCode != alloc.RegallocValuePlanErrorCfg ||
       badEdgePlan.errorDetail != cfg.BodyIrCfgErrorEdge:
        return 61
    var body = buildDiamond()
    var table = access.BodyIrAccessDecode(body)
    var damagedCfg = cfg.BodyIrCfgAnalyze(body, table)
    damagedCfg.succOffsets[damagedCfg.succOffsets.len - 1] =
        damagedCfg.succOffsets[damagedCfg.succOffsets.len - 1] + 1
    var damagedCfgPlan = alloc.RegallocSinglePassValuePlanBuild(
        body, table, damagedCfg, constraints)
    if damagedCfgPlan.valid ||
       damagedCfgPlan.errorCode != alloc.RegallocValuePlanErrorFactShape:
        return 62

    var damagedMerge = cfg.BodyIrCfgAnalyze(body, table)
    let mergeFlat = 3 * damagedMerge.slotCount + 1
    let mergeStart = damagedMerge.mergeInputStarts[mergeFlat]
    if mergeStart < 0:
        return 63
    damagedMerge.mergeInputValues[mergeStart] = damagedMerge.valueCount + 7
    var damagedMergePlan = alloc.RegallocSinglePassValuePlanBuild(
        body, table, damagedMerge, constraints)
    if damagedMergePlan.valid ||
       damagedMergePlan.errorCode != alloc.RegallocValuePlanErrorFactShape:
        return 64

    # Same-shape BodyIR mutation: stale access/CFG facts still name slot 1,
    # while the frozen return term now consumes slot 0.  The raw builder must
    # reject this cross-ingress mix; rebuilding both canonical fact layers from
    # the mutated BodyIR remains valid.
    var staleBody = buildDiamond()
    var staleTable = access.BodyIrAccessDecode(staleBody)
    var staleCfg = cfg.BodyIrCfgAnalyze(staleBody, staleTable)
    staleBody.terms[3].resultSlot = 0
    var stalePlan = alloc.RegallocSinglePassValuePlanBuild(
        staleBody, staleTable, staleCfg, constraints)
    if stalePlan.valid ||
       stalePlan.errorCode != alloc.RegallocValuePlanErrorFactShape:
        return 65
    var rebuiltPlan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        staleBody, constraints)
    if !rebuiltPlan.valid:
        return 66
    return 0

fn main(): int32 =
    let diamondCode = testDiamondAndDeterminism()
    if diamondCode != 0:
        return diamondCode
    let loopCode = testLoopBackedge()
    if loopCode != 0:
        return loopCode
    let unreachableCode = testUnreachableBlock()
    if unreachableCode != 0:
        return unreachableCode
    let criticalCode = testCriticalEdge()
    if criticalCode != 0:
        return criticalCode
    let cycleCode = testParallelCopyCycle()
    if cycleCode != 0:
        return cycleCode
    let rpoCode = testNonIndexRpoActionOrder()
    if rpoCode != 0:
        return rpoCode
    return testDamagedCfgAndMergeHardFail()
