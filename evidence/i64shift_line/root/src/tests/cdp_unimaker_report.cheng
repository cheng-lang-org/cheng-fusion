# cdp_unimaker_report.cheng - Extract UniMaker PWA DOM and report stats

import cheng/core/runtime/cdp_client as cdp
import cheng/core/runtime/cdp_oracle_dom as oracle
import std/strings

fn writeStdout(text: str) =
    var raw = rm.RawmemAsVoid(text)
    var total = len(text)
    var sent: int32
    while sent < total:
        var chunk = socketWrite(1, rm.RawmemPtrAdd(raw, sent), total - sent)
        if chunk < 0:
            return
        sent = sent + chunk

fn main(): int32 =
    var docJson: str
    if !cdp.cdpFetchDocumentFromChrome(docJson):
        writeStdout("FAIL:CDP connect failed\n")
        return 1

    var summary: oracle.OracleDomSummary
    if !oracle.oracleParseDomFromJson(docJson, summary):
        writeStdout("FAIL:DOM parse failed\n")
        return 2

    writeStdout("UniMaker PWA DOM via pure Cheng CDP:\n")
    writeStdout(ConcatStr("  nodes: ", strings.IntToStr(summary.nodeCount)))
    writeStdout("\n")
    writeStdout(ConcatStr("  elements: ", strings.IntToStr(summary.elementCount)))
    writeStdout("\n")
    writeStdout(ConcatStr("  text: ", strings.IntToStr(summary.textCount)))
    writeStdout("\n")
    writeStdout(ConcatStr("  maxDepth: ", strings.IntToStr(summary.maxDepth)))
    writeStdout("\n")
    writeStdout(ConcatStr("  rawJson: ", strings.IntToStr(summary.rawJsonLen)))
    writeStdout(" bytes\n")

    return 0
