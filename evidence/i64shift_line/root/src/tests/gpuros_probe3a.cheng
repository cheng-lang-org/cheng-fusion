@profile("driver_safe")

type
    UInt8Ptr = uint8 *

@trusted_abi
fn PutByteLoad(ch: int32) =
    let lsrAddr = ptr(uint64(268435456) + uint64(5))
    let lsrVal = int32(*(UInt8Ptr(lsrAddr)))
    var v = ch
    if (lsrVal & 32) == 0:
        v = v + 1
    let thrAddr = ptr(uint64(268435456))
    *(UInt8Ptr(thrAddr)) = uint8(v & 255)

fn main(): int32 =
    PutByteLoad(67)
    return 0
