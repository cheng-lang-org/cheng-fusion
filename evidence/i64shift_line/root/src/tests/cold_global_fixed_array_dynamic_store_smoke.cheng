const ColdGlobalFixedArrayDynamicCount: int32 = 4096

var coldGlobalFixedArrayDynamicStates: int32[ColdGlobalFixedArrayDynamicCount]
var coldGlobalFixedArrayDynamicGenerations: int32[ColdGlobalFixedArrayDynamicCount]
var coldGlobalFixedArrayDynamicDevices: uint64[ColdGlobalFixedArrayDynamicCount]

fn coldGlobalFixedArrayDynamicWrite(row: int32,
                                    state: int32,
                                    generation: int32,
                                    device: uint64) =
    coldGlobalFixedArrayDynamicStates[row] = state
    coldGlobalFixedArrayDynamicGenerations[row] = generation
    coldGlobalFixedArrayDynamicDevices[row] = device

fn main(): int32 =
    let firstRow = 73
    let lastRow = ColdGlobalFixedArrayDynamicCount - 1
    coldGlobalFixedArrayDynamicWrite(firstRow, 4, 9, uint64(1001))
    coldGlobalFixedArrayDynamicWrite(lastRow, 6, 11, uint64(9001))
    coldGlobalFixedArrayDynamicWrite(firstRow, 2, 10, uint64(1002))
    if coldGlobalFixedArrayDynamicStates[firstRow] != 2 ||
       coldGlobalFixedArrayDynamicGenerations[firstRow] != 10 ||
       coldGlobalFixedArrayDynamicDevices[firstRow] != uint64(1002):
        return 1
    if coldGlobalFixedArrayDynamicStates[lastRow] != 6 ||
       coldGlobalFixedArrayDynamicGenerations[lastRow] != 11 ||
       coldGlobalFixedArrayDynamicDevices[lastRow] != uint64(9001):
        return 2
    if coldGlobalFixedArrayDynamicStates[firstRow - 1] != 0 ||
       coldGlobalFixedArrayDynamicStates[firstRow + 1] != 0:
        return 3
    return 0
