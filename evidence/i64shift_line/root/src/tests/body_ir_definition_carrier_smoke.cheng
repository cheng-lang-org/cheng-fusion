import cheng/core/ir/core_types as coreir
import cheng/core/ir/body_ir_access as access

fn carrierAssert(condition: bool, message: str) =
    if !condition:
        panic(message)

fn carrierSlot(id: int32): coreir.LocalSlot =
    var slot: coreir.LocalSlot
    slot.id = id
    slot.name = "carrier"
    slot.typeKind = coreir.LocalI32Tag
    slot.stackOffset = id * 8
    slot.sizeBytes = 4
    slot.alignBytes = 4
    coreir.BodyIRApplyLocalSlotDefaultProof(slot)
    return slot

fn carrierManagedSlot(id: int32, stackOffset: int32): coreir.LocalSlot =
    var slot: coreir.LocalSlot
    slot.id = id
    slot.name = "managed_carrier"
    slot.typeKind = coreir.LocalStrTag
    slot.stackOffset = stackOffset
    slot.sizeBytes = 24
    slot.alignBytes = 8
    coreir.BodyIRApplyLocalSlotDefaultProof(slot)
    return slot

fn carrierAppendReturn(body: var coreir.BodyIR,
                       slot: int32,
                       sourceValueDefOpId: int32) =
    var term: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = coreir.BodyTermReturnTag
    term.resultSlot = slot
    term.sourceValueDefOpId = sourceValueDefOpId
    add(term.operands, coreir.LocalI32Tag)
    let termIndex = coreir.BodyIRAppendTerm(body, term)
    let _ = coreir.BodyIRAppendBlock(body, 0, body.ops.len, termIndex)

fn carrierAppendReturnOp(body: var coreir.BodyIR,
                         slot: int32,
                         sourceValueDefOpId: int32) =
    var returnOp: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(returnOp)
    returnOp.kind = coreir.BodyOpReturnTag
    returnOp.target = slot
    returnOp.sourceValueDefOpId = sourceValueDefOpId
    add(returnOp.operands, 0)
    let _ = coreir.BodyIRAppendOp(body, returnOp)

fn buildExactConsumeBody(): coreir.BodyIR =
    var body = coreir.BodyIRNew()
    add(body.localSlots, carrierSlot(0))
    add(body.localSlots, carrierSlot(1))
    var source: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(source)
    source.kind = coreir.BodyOpLoadConstTag
    source.target = 0
    source.valueDefSlot = 0
    source.valueDefExprNodeIndex = 101
    source.valueDefSemanticRow = 101
    source.valueDefOwnership = coreir.OwnMove
    source.valueDefConsumeOpIndexPlusOne = 2
    source.valueDefOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    source.valueDefOriginId = 101
    source.consumeActionRow = 501
    add(source.operands, coreir.LocalI32Tag)
    add(source.operands, 7)
    let _ = coreir.BodyIRAppendOp(body, source)
    var consume: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(consume)
    consume.kind = coreir.BodyOpCopyLocalTag
    consume.target = 1
    consume.valueDefSlot = 1
    consume.valueDefExprNodeIndex = -1
    consume.valueDefSemanticRow = 101
    consume.valueDefOwnership = coreir.OwnMove
    consume.valueDefOriginKind =
        coreir.BodyDefinitionOriginCanonicalCleanupActionTag
    consume.valueDefOriginId = 501
    consume.sourceValueDefOpId = 0
    add(consume.operands, 0)
    let _ = coreir.BodyIRAppendOp(body, consume)
    carrierAppendReturn(body, 1, 1)
    return body

fn buildExactCallResultBody(): coreir.BodyIR =
    var body = coreir.BodyIRNew()
    add(body.localSlots, carrierSlot(0))
    add(body.localSlots, carrierSlot(1))
    var source: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(source)
    source.kind = coreir.BodyOpLoadConstTag
    source.target = 0
    source.valueDefSlot = 0
    source.valueDefExprNodeIndex = 201
    source.valueDefSemanticRow = 201
    source.valueDefOwnership = coreir.OwnMove
    source.valueDefConsumeOpIndexPlusOne = 2
    source.valueDefOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    source.valueDefOriginId = 201
    source.consumeActionRow = 601
    add(source.operands, coreir.LocalI32Tag)
    add(source.operands, 9)
    let _ = coreir.BodyIRAppendOp(body, source)
    var call: coreir.CallOp
    coreir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = "carrier_result"
    call.resultSlot = 1
    call.resultPassKind = coreir.BodyCallPassStackValueTag
    call.resultOwnership = coreir.OwnMove
    call.resultExprNodeIndex = 202
    call.resultValueDefinitionRow = 201
    call.resultDefinitionOriginKind =
        coreir.BodyDefinitionOriginCanonicalCleanupActionTag
    call.resultDefinitionOriginId = 601
    call.sourceValueDefOpId = 0
    add(call.argSlots, coreir.CallArgSlotAddress(0))
    add(call.argPassKinds,
        coreir.BodyCallPassByAddressAggregateTag)
    add(call.argAbiSizes, 8)
    let callOrdinal = body.callSequence.len
    add(body.callSequence, call)
    var callOp: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(callOp)
    callOp.kind = coreir.BodyOpCallTag
    callOp.target = 1
    callOp.valueDefSlot = 1
    callOp.valueDefExprNodeIndex = 202
    callOp.valueDefSemanticRow = 201
    callOp.valueDefOwnership = coreir.OwnMove
    callOp.valueDefOriginKind =
        coreir.BodyDefinitionOriginCanonicalCleanupActionTag
    callOp.valueDefOriginId = 601
    callOp.sourceValueDefOpId = 0
    add(callOp.operands, callOrdinal)
    let _ = coreir.BodyIRAppendOp(body, callOp)
    carrierAppendReturn(body, 1, 1)
    return body

fn runExactConsumeMutations() =
    var body = buildExactConsumeBody()
    var table = access.BodyIrAccessDecode(body)
    carrierAssert(table.valid, "carrier smoke: exact consume rejected")
    body.ops[0].sourceValueDefOpId = 0
    table = access.BodyIrAccessDecode(body)
    carrierAssert(!table.valid,
                  "carrier smoke: typed source mutation accepted")
    body.ops[0].sourceValueDefOpId = -1
    body.ops[1].sourceValueDefOpId = -1
    table = access.BodyIrAccessDecode(body)
    carrierAssert(!table.valid,
                  "carrier smoke: cleanup source deletion accepted")
    body.ops[1].sourceValueDefOpId = 0
    body.ops[1].valueDefOriginId = 502
    table = access.BodyIrAccessDecode(body)
    carrierAssert(!table.valid,
                  "carrier smoke: consume origin mutation accepted")
    body.ops[1].valueDefOriginId = 501
    body.ops[1].consumeActionRow = 501
    table = access.BodyIrAccessDecode(body)
    carrierAssert(!table.valid,
                  "carrier smoke: duplicate consume action accepted")
    body = buildExactConsumeBody()
    body.ops[1].valueDefSemanticRow = 102
    table = access.BodyIrAccessDecode(body)
    carrierAssert(!table.valid,
                  "carrier smoke: cleanup semantic row drift accepted")
    body.ops[1].valueDefSemanticRow = -1
    table = access.BodyIrAccessDecode(body)
    carrierAssert(!table.valid,
                  "carrier smoke: cleanup semantic row deletion accepted")

fn runExactCallMutations() =
    var body = buildExactCallResultBody()
    var table = access.BodyIrAccessDecode(body)
    carrierAssert(table.valid, "carrier smoke: exact call result rejected")
    var call = body.callSequence[0]
    call.sourceValueDefOpId = -1
    body.callSequence[0] = call
    table = access.BodyIrAccessDecode(body)
    carrierAssert(!table.valid,
                  "carrier smoke: call source deletion accepted")
    call.sourceValueDefOpId = 0
    call.resultDefinitionOriginId = 602
    body.callSequence[0] = call
    table = access.BodyIrAccessDecode(body)
    carrierAssert(!table.valid,
                  "carrier smoke: call origin mutation accepted")
    call.resultDefinitionOriginId = 601
    call.resultOwnership = coreir.OwnBorrowShared
    body.callSequence[0] = call
    table = access.BodyIrAccessDecode(body)
    carrierAssert(!table.valid,
                  "carrier smoke: call ownership mutation accepted")
    body = buildExactCallResultBody()
    call = body.callSequence[0]
    call.resultValueDefinitionRow = 202
    body.callSequence[0] = call
    table = access.BodyIrAccessDecode(body)
    carrierAssert(!table.valid,
                  "carrier smoke: call semantic row drift accepted")
    call.resultValueDefinitionRow = -1
    body.callSequence[0] = call
    table = access.BodyIrAccessDecode(body)
    carrierAssert(!table.valid,
                  "carrier smoke: call semantic row deletion accepted")
    body = buildExactCallResultBody()
    body.ops[1].valueDefSemanticRow = 202
    table = access.BodyIrAccessDecode(body)
    carrierAssert(!table.valid,
                  "carrier smoke: CallOp/BodyOp semantic row drift accepted")

fn runRedefinitionAttributionMutations() =
    var body = coreir.BodyIRNew()
    add(body.localSlots, carrierSlot(0))
    var first: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(first)
    first.kind = coreir.BodyOpLoadConstTag
    first.target = 0
    first.valueDefSlot = 0
    first.valueDefExprNodeIndex = 301
    first.valueDefSemanticRow = 301
    first.valueDefOwnership = coreir.OwnMove
    first.valueDefOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    first.valueDefOriginId = 301
    add(first.operands, coreir.LocalI32Tag)
    add(first.operands, 1)
    let _ = coreir.BodyIRAppendOp(body, first)
    var second: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(second)
    second.kind = coreir.BodyOpLoadConstTag
    second.target = 0
    second.valueDefSlot = 0
    second.valueDefExprNodeIndex = 302
    second.valueDefSemanticRow = 302
    second.valueDefOwnership = coreir.OwnMove
    second.valueDefConsumeOpIndexPlusOne = 3
    second.valueDefOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    second.valueDefOriginId = 302
    add(second.operands, coreir.LocalI32Tag)
    add(second.operands, 2)
    let _ = coreir.BodyIRAppendOp(body, second)
    carrierAppendReturnOp(body, 0, 1)
    var table = access.BodyIrAccessDecode(body)
    carrierAssert(!table.valid,
                  "carrier smoke: later return consumed overwritten def")

    body = buildExactConsumeBody()
    var postConsumeUse: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(postConsumeUse)
    postConsumeUse.kind = coreir.BodyOpCopyLocalTag
    postConsumeUse.target = 1
    add(postConsumeUse.operands, 0)
    let _ = coreir.BodyIRAppendOp(body, postConsumeUse)
    table = access.BodyIrAccessDecode(body)
    carrierAssert(!table.valid &&
                  table.errorCode ==
                      access.BodyIrAccessOwnershipInvariantErrorCode(),
                  "carrier smoke: post-consume source use accepted")

    body = buildExactConsumeBody()
    var redefine: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(redefine)
    redefine.kind = coreir.BodyOpLoadConstTag
    redefine.target = 0
    redefine.valueDefSlot = 0
    redefine.valueDefExprNodeIndex = 303
    redefine.valueDefSemanticRow = 303
    redefine.valueDefOwnership = coreir.OwnMove
    redefine.valueDefConsumeOpIndexPlusOne = 4
    redefine.valueDefOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    redefine.valueDefOriginId = 303
    add(redefine.operands, coreir.LocalI32Tag)
    add(redefine.operands, 3)
    let _ = coreir.BodyIRAppendOp(body, redefine)
    carrierAppendReturnOp(body, 0, 2)
    table = access.BodyIrAccessDecode(body)
    carrierAssert(table.valid,
                  "carrier smoke: use after redefinition rejected old consume")

fn buildExactDiamondReturnBody(loopBackEdge: bool): coreir.BodyIR =
    var body = coreir.BodyIRNew()
    add(body.localSlots, carrierManagedSlot(0, 0))
    var conditionSlot = carrierSlot(1)
    conditionSlot.stackOffset = -8
    add(body.localSlots, conditionSlot)
    add(body.localSlots, carrierManagedSlot(2, -32))
    var source: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(source)
    source.kind = coreir.BodyOpCopyLocalTag
    source.target = 0
    source.valueDefSlot = 0
    source.valueDefExprNodeIndex = 401
    source.valueDefSemanticRow = 401
    source.valueDefOwnership = coreir.OwnMove
    source.valueDefOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    source.valueDefOriginId = 401
    add(source.operands, 2)
    let _ = coreir.BodyIRAppendOp(body, source)
    if loopBackEdge:
        var enterLoop: coreir.BodyTerm
        coreir.BodyIRApplyBodyTermDefaultProof(enterLoop)
        enterLoop.kind = coreir.BodyTermBrTag
        enterLoop.trueBlock = 1
        let enterLoopTerm = coreir.BodyIRAppendTerm(body, enterLoop)
        var loopCondition: coreir.BodyTerm
        coreir.BodyIRApplyBodyTermDefaultProof(loopCondition)
        loopCondition.kind = coreir.BodyTermCbrTag
        loopCondition.conditionKind =
            coreir.BodyCondLocalNonZeroTag
        loopCondition.lhsSlot = 1
        loopCondition.trueBlock = 1
        loopCondition.falseBlock = 2
        let loopConditionTerm =
            coreir.BodyIRAppendTerm(body, loopCondition)
        var loopReturn: coreir.BodyTerm
        coreir.BodyIRApplyBodyTermDefaultProof(loopReturn)
        loopReturn.kind = coreir.BodyTermReturnTag
        loopReturn.resultSlot = 0
        loopReturn.sourceValueDefOpId = 0
        let loopReturnTerm =
            coreir.BodyIRAppendTerm(body, loopReturn)
        let _ = coreir.BodyIRAppendBlock(
            body, 0, 1, enterLoopTerm)
        let _ = coreir.BodyIRAppendBlock(
            body, 1, 0, loopConditionTerm)
        let _ = coreir.BodyIRAppendBlock(
            body, 1, 0, loopReturnTerm)
        return body
    var condition: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(condition)
    condition.kind = coreir.BodyTermCbrTag
    condition.conditionKind =
        coreir.BodyCondLocalNonZeroTag
    condition.lhsSlot = 1
    condition.trueBlock = 1
    condition.falseBlock = 2
    let conditionTerm = coreir.BodyIRAppendTerm(body, condition)
    var firstReturn: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(firstReturn)
    firstReturn.kind = coreir.BodyTermReturnTag
    firstReturn.resultSlot = 0
    firstReturn.sourceValueDefOpId = 0
    let firstReturnTerm =
        coreir.BodyIRAppendTerm(body, firstReturn)
    let _ = coreir.BodyIRAppendBlock(
        body, 0, 1, conditionTerm)
    let _ = coreir.BodyIRAppendBlock(
        body, 1, 0, firstReturnTerm)
    var secondReturn: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(secondReturn)
    secondReturn.kind = coreir.BodyTermReturnTag
    secondReturn.resultSlot = 0
    secondReturn.sourceValueDefOpId = 0
    let secondReturnTerm =
        coreir.BodyIRAppendTerm(body, secondReturn)
    let _ = coreir.BodyIRAppendBlock(
        body, 1, 0, secondReturnTerm)
    return body

fn runCfgAuthorityMutations() =
    var body = buildExactDiamondReturnBody(false)
    var table = access.BodyIrAccessDecode(body)
    carrierAssert(table.valid,
                  "carrier smoke: exact diamond returns rejected")
    body.terms[2].sourceValueDefOpId = -1
    table = access.BodyIrAccessDecode(body)
    carrierAssert(!table.valid,
                  "carrier smoke: diamond return authority deletion accepted")

    body = buildExactDiamondReturnBody(true)
    table = access.BodyIrAccessDecode(body)
    carrierAssert(table.valid,
                  "carrier smoke: exact loop exit return rejected")
    body.terms[0].sourceValueDefOpId = 0
    table = access.BodyIrAccessDecode(body)
    carrierAssert(!table.valid,
                  "carrier smoke: loop non-return source authority accepted")

fn runLinearDefinitionIndexScale() =
    let pairCount: int32 = 4096
    var body = coreir.BodyIRNew()
    for slotId in 0..<(pairCount * 2):
        add(body.localSlots, carrierSlot(slotId))
    for pairIndex in 0..<pairCount:
        let sourceSlot = pairIndex * 2
        let targetSlot = sourceSlot + 1
        let sourceOpIndex = body.ops.len
        let consumeActionRow = 50000 + pairIndex
        var source: coreir.BodyOp
        coreir.BodyIRApplyBodyOpDefaultProof(source)
        source.kind = coreir.BodyOpLoadConstTag
        source.target = sourceSlot
        source.valueDefSlot = sourceSlot
        source.valueDefExprNodeIndex = 1000 + pairIndex
        source.valueDefSemanticRow = 1000 + pairIndex
        source.valueDefOwnership = coreir.OwnMove
        source.valueDefConsumeOpIndexPlusOne = sourceOpIndex + 2
        source.valueDefOriginKind =
            coreir.BodyDefinitionOriginTypedExprTag
        source.valueDefOriginId = 1000 + pairIndex
        source.consumeActionRow = consumeActionRow
        add(source.operands, coreir.LocalI32Tag)
        add(source.operands, pairIndex)
        let _ = coreir.BodyIRAppendOp(body, source)
        var consume: coreir.BodyOp
        coreir.BodyIRApplyBodyOpDefaultProof(consume)
        consume.kind = coreir.BodyOpCopyLocalTag
        consume.target = targetSlot
        consume.valueDefSlot = targetSlot
        consume.valueDefExprNodeIndex = -1
        consume.valueDefSemanticRow = 1000 + pairIndex
        consume.valueDefOwnership = coreir.OwnMove
        consume.valueDefOriginKind =
            coreir.BodyDefinitionOriginCanonicalCleanupActionTag
        consume.valueDefOriginId = consumeActionRow
        consume.sourceValueDefOpId = sourceOpIndex
        add(consume.operands, sourceSlot)
        let _ = coreir.BodyIRAppendOp(body, consume)
        var returnTerm: coreir.BodyTerm
        coreir.BodyIRApplyBodyTermDefaultProof(returnTerm)
        returnTerm.kind = coreir.BodyTermReturnTag
        returnTerm.resultSlot = targetSlot
        returnTerm.sourceValueDefOpId = sourceOpIndex + 1
        let _ = coreir.BodyIRAppendTerm(body, returnTerm)
    let table = access.BodyIrAccessDecode(body)
    carrierAssert(table.valid && body.ops.len == pairCount * 2,
                  "carrier smoke: 4096-pair linear index rejected")

fn main(): int32 =
    runExactConsumeMutations()
    runExactCallMutations()
    runRedefinitionAttributionMutations()
    runCfgAuthorityMutations()
    runLinearDefinitionIndexScale()
    echo("body_ir_definition_carrier_smoke ok")
    return 0
