fn emit(s: str): int32 =
    return len(s)

# 触发形态: 实参是 Fmt"..." 插值文本, 整体作 emit 的实参。
fn probe(x: int32): int32 =
    return emit(Fmt"v={x}")

fn main(): int32 =
    return probe(3)
