import std/os
import cheng/std/bytes_layout as layout
import cheng/core/backend/debug_facts as debug
import cheng/core/backend/debug_emission_plan_evidence as evidence
import cheng/core/backend/lowering_plan as lower
import cheng/core/backend/primary_object_plan as primary
import cheng/core/backend/regalloc_production_artifacts as regart
import cheng/core/backend/semantic_snapshot_debug_binding_receipt as bindingreceipt
import cheng/tests/debug_emission_receipt_smoke as fixture
import cheng/tests/debug_section_plan_receipt_smoke as support

@borrows
fn MakePrimaryPlan(
        planEvidence: evidence.DebugEmissionPlanEvidence,
        backendKind: str): primary.PrimaryObjectPlan =
    var out: primary.PrimaryObjectPlan
    out.actualBackendKind = backendKind
    out.symbolNames = planEvidence.symbolNames
    out.functionWordOffsets = planEvidence.functionWordOffsets
    out.functionWordCounts = planEvidence.functionWordCounts
    out.functionIrIndexes = [0]
    out.functionBodyKinds = ["statement_sequence"]
    out.regallocFrozenSnapshotSinglePayloads =
        planEvidence.frozenSnapshotPayloads
    out.regallocEmissionLedgerSinglePayloads =
        planEvidence.emissionLedgerPayloads
    out.regallocFunctionSymbols = planEvidence.symbolNames
    out.regallocFunctionIrIndexes = [0]
    out.regallocFunctionKinds =
        [regart.RegallocProductionFunctionKindNormal]
    out.regallocFunctionBodyIrSha256s = planEvidence.bodyIrSha256s
    out.regallocFunctionSymbolByteStarts = planEvidence.symbolByteStarts
    out.regallocFunctionSymbolByteLengths = planEvidence.symbolByteLengths
    out.regallocFunctionSymbolBytesSha256s =
        planEvidence.symbolBytesSha256s
    out.regallocFunctionPlanSha256s = planEvidence.planSha256s
    out.regallocFunctionActionSemanticRootSha256s =
        planEvidence.actionSemanticRootSha256s
    out.regallocFunctionActionLedgerRootSha256s =
        planEvidence.actionBindingRootSha256s
    out.regallocFunctionMachineFragmentRootSha256s =
        planEvidence.machineFragmentRootSha256s
    out.regallocFunctionAbiIngressRootSha256s =
        planEvidence.abiIngressRootSha256s
    out.regallocFunctionDebugProvenanceBound =
        planEvidence.debugProvenanceBound
    out.regallocFunctionDebugFunctionIds = planEvidence.debugFunctionIds
    out.regallocFunctionDebugProvenanceSha256s =
        planEvidence.debugProvenanceSha256s
    out.regallocFunctionDebugMachineFragmentRootSha256s =
        planEvidence.debugMachineFragmentRootSha256s
    out.regallocFunctionDebugFragmentStarts = planEvidence.debugFragmentStarts
    out.regallocFunctionDebugFragmentCounts = planEvidence.debugFragmentCounts
    out.regallocDebugFragmentFunctionIndexes =
        planEvidence.fragmentFunctionIndexes
    out.regallocDebugFragmentOpIds = planEvidence.fragmentDebugOpIds
    out.regallocDebugFragmentSyntheticKinds =
        planEvidence.fragmentSyntheticKinds
    out.regallocDebugFragmentSiteKinds = planEvidence.fragmentSiteKinds
    out.regallocDebugFragmentSiteIndexes = planEvidence.fragmentSiteIndexes
    out.regallocDebugFragmentMachineOwnerKinds =
        planEvidence.fragmentMachineOwnerKinds
    out.regallocDebugFragmentMachineOwnerOrdinals =
        planEvidence.fragmentMachineOwnerOrdinals
    out.regallocDebugFragmentActionConsumerOrdinals =
        planEvidence.fragmentActionConsumerOrdinals
    out.regallocDebugFragmentTextByteStarts =
        planEvidence.fragmentTextByteStarts
    out.regallocDebugFragmentByteLengths = planEvidence.fragmentByteLengths
    out.regallocDebugFragmentBytesSha256s =
        planEvidence.fragmentBytesSha256s
    return out

fn main() =
    var err: str
    var facts: debug.DebugFactBundle
    support.BuildFacts("backend-consumption", facts)
    var lowering: lower.LoweringPlanStub
    let retainedBody = fixture.BuildBody(facts, lowering)
    let debugBinding = support.MakeBindingReceipt(facts, lowering)
    assert(lower.LoweringPlanBindPublishedDebugBindingReceiptInto(
               lowering, debugBinding, err), err)

    let primaryEvidence = support.MakeEvidence(facts)
    var primaryPlan = MakePrimaryPlan(primaryEvidence, "primary")
    assert(primary.PrimaryObjectPlanConsumeDebugSectionPlanReceiptInto(
               lowering, primaryPlan, err) &&
           primaryPlan.debugSectionPlanConsumed &&
           primaryPlan.debugSectionPlanReceipt.backendKind == "primary" &&
           bindingreceipt.SemanticSnapshotDebugBindingReceiptEqual(
               primaryPlan.semanticDebugBindingReceipt, debugBinding), err)

    var backend2Evidence = primaryEvidence
    backend2Evidence.backendKind = "backend2"
    var backend2Plan = MakePrimaryPlan(backend2Evidence, "backend2")
    assert(primary.PrimaryObjectPlanConsumeDebugSectionPlanReceiptInto(
               lowering, backend2Plan, err) &&
           backend2Plan.debugSectionPlanConsumed &&
           backend2Plan.debugSectionPlanReceipt.backendKind == "backend2" &&
           layout.FixedBytes32Equal(
               primaryPlan.debugSectionPlanReceipt.debugBindingReceiptCid,
               backend2Plan.debugSectionPlanReceipt.debugBindingReceiptCid),
           "debug section backend consumption: binding split")
    os.WriteLine(os.Get_stdout(),
                 "debug_section_plan_backend_consumption_smoke=pass")
