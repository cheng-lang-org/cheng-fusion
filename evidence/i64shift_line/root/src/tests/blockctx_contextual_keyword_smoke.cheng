# exactdef-identity-gate 正例夹具：block 上下文关键字双形同函数共存。
# 形A(回归形)：语句首 `block = block + i` 赋值——arm 分类器旧方言误判
#   blockStmt(arm14) 致 authority invalid；修后须按赋值(arm2)走。
# 形B(真块形)：`block counter:` labeled suite——真 blockStmt，发布器须
#   建 lexical-scope 行、authority=LexicalScope(9)，验证器绿。
# 预期：编译 rc=0；运行 exit=6（block=0+0+1+2=3, total=1+1+1=3）。

fn main(): int32 =
    var block: int32
    block = 0
    var total: int32
    total = 0
    var i: int32
    i = 0
    while i < 3:
        block = block + i
        block counter:
            total = total + 1
        i = i + 1
    return block + total
