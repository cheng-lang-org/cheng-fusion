type
    ParserDelimiterKind = enum
        ParserDelimiterLeftBracket
        ParserDelimiterRightBracket
        ParserDelimiterLeftBrace
        ParserDelimiterRightBrace

fn ParserDelimiterPairScore(openKind: ParserDelimiterKind,
                            closeKind: ParserDelimiterKind): int32 =
    if openKind == ParserDelimiterLeftBracket &&
       closeKind == ParserDelimiterRightBracket:
        return 1
    if openKind == ParserDelimiterLeftBrace &&
       closeKind == ParserDelimiterRightBrace:
        return 2
    return 0

fn ParserNestedSuiteDelimiterScore(
        tokenKind: ParserDelimiterKind): int32 =
    if tokenKind == ParserDelimiterLeftBracket ||
       tokenKind == ParserDelimiterLeftBrace:
        let closeKind = if tokenKind == ParserDelimiterLeftBracket: ParserDelimiterRightBracket else: ParserDelimiterRightBrace
        let closeScore = ParserDelimiterPairScore(
            tokenKind,
            closeKind)
        return closeScore
    return 0

fn main(): int32 =
    let bracketScore =
        ParserNestedSuiteDelimiterScore(ParserDelimiterLeftBracket)
    let braceScore =
        ParserNestedSuiteDelimiterScore(ParserDelimiterLeftBrace)
    assert(bracketScore == 1 && braceScore == 2,
           "parser nested-suite if expression delimiter drift")
    return 0
