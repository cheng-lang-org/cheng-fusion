import std/strings

@borrows
fn appendStep(
        values: var str[],
        error: var str): bool =
    add(values, strings.CloneStr("step"))
    return true

@borrows
fn runNested(error: var str): int32 =
    var values: str[]
    for outer in 0..<2:
        for first in 0..<2:
            if !appendStep(values, error):
                return -1
        for second in 0..<2:
            if !appendStep(values, error):
                return -2
    return values.len

fn main(): int32 =
    var error: str
    let count = runNested(error)
    if error.len > 0:
        return 1
    return count == 8 ? 0 : 2
