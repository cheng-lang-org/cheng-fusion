import cheng/core/runtime/web_scene_runtime as scene

var __csgSceneGraph: scene.WebSceneGraph

fn __csg_scene_load_resource_0_entry(): int32 =
    scene.WebSceneGraphInit(__csgSceneGraph)

    let addStatus = scene.WebSceneAddResourceEntryStatus(__csgSceneGraph, "font_subset", "font.0")
    if addStatus != 0:
        return 10 + addStatus

    let countAfterAdd = scene.WebSceneResourceCount(__csgSceneGraph)
    if countAfterAdd != 1:
        return 20 + countAfterAdd

    if !scene.WebSceneResourceIndexValid(__csgSceneGraph, 0):
        return 25

    if !scene.WebSceneSetResourceSourceAt(__csgSceneGraph, 0, "probe-source"):
        return 30

    if scene.WebSceneResourceSourceAt(__csgSceneGraph, 0) != "probe-source":
        return 40

    return 0

@exportc("cheng_var_object_probe_run")
fn cheng_var_object_probe_run(): int32 =
    return __csg_scene_load_resource_0_entry()

fn main(): int32 =
    return 0
