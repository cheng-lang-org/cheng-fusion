import std/result
import std/strings
import cheng/core/backend/lowering_plan as lower
import cheng/core/backend/system_link_plan as slplan
import cheng/core/backend2/backend2_assemble as b2asm
import cheng/core/lang/intern as langintern
import cheng/core/tooling/compiler_request as creq
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256

fn symbolProjectionCid(label: str): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(64)
    for byteIndex in 0..<label.len:
        layout.ByteBufAppendByte(buf, int32(label[byteIndex]) & 255)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn symbolProjectionAppendRow(
        plan: var lower.LoweringPlanStub,
        typedRow: int32,
        nameId: langintern.InternId,
        name: str,
        owner: str,
        line: int32,
        exported: int32,
        exportName: str,
        exportNameExplicit: int32,
        producerSourceIndex: int32,
        producerDeclarationIndex: int32,
        producerNodeId: int32,
        producerCidLabel: str,
        entry: int32) =
    add(plan.typedIr.functions2_functionNameIds, nameId)
    add(plan.functionTypedIrIndexes, typedRow)
    add(plan.functionNameIds, nameId)
    add(plan.functionNames, strings.CloneStr(name))
    add(plan.functionOwnerModulePaths, strings.CloneStr(owner))
    add(plan.functionSymbolTexts,
        lower.LoweringFunctionSymbolText(owner, name))
    add(plan.functionSignatureLineNumbers, line)
    add(plan.functionExportedFlags, exported)
    add(plan.functionExportSymbolNames, strings.CloneStr(exportName))
    add(plan.functionExportNameExplicitFlags, exportNameExplicit)
    add(plan.functionExportProducerSourceIndexes, producerSourceIndex)
    add(plan.functionExportProducerDeclarationIndexes,
        producerDeclarationIndex)
    add(plan.functionExportProducerNodeIds, producerNodeId)
    add(plan.functionExportProducerFactCids,
        symbolProjectionCid(producerCidLabel))
    add(plan.functionEntryFlags, entry)

fn main(): int32 =
    var plan: lower.LoweringPlanStub
    plan.typedIr.internPool = langintern.InternPoolNew()
    let helperId = langintern.Intern(
        plan.typedIr.internPool, "辅助-函数")
    let exportedFunctionId = langintern.Intern(
        plan.typedIr.internPool, "exported_impl")
    let mainId = langintern.Intern(plan.typedIr.internPool, "main")
    let entryId = langintern.Intern(
        plan.typedIr.internPool, "start_impl")
    assert(mainId != 0 && mainId != helperId,
           "main must be an ordinary exact InternId")

    symbolProjectionAppendRow(
        plan, 0, helperId, "辅助-函数", "包/模", 17,
        0, "", 0,
        1, 11, 101, "producer-helper", 0)
    symbolProjectionAppendRow(
        plan, 1, exportedFunctionId, "exported_impl", "pkg/mod", 23,
        1, "导出.函数-β", 1,
        2, 22, 102, "producer-export", 0)
    symbolProjectionAppendRow(
        plan, 2, mainId, "main", "app/main", 31,
        0, "", 0,
        3, 33, 103, "producer-main", 0)
    symbolProjectionAppendRow(
        plan, 3, entryId, "start_impl", "app/main", 37,
        1, "公开/entry-β", 1,
        3, 34, 104, "producer-entry-export", 1)
    plan.sourceEntryTypedFunctionIndex = 3
    plan.entrySymbol = "start_impl"
    plan.canonicalSnapshotProjectionAuthorityCid =
        symbolProjectionCid("snapshot-projection")
    plan.compilerCsgCid = symbolProjectionCid("compiler-csg")
    plan.functionNameInternPoolDomainCid =
        lower.LoweringFunctionNameInternPoolDomainCid(plan)
    plan.functionNameIdentityReceiptCid =
        lower.LoweringFunctionNameIdentityReceiptCid(plan)
    assert(lower.LoweringFunctionNameIdentityStrictValid(plan),
           "exact function symbol authority invalid")

    var elfPlan: slplan.SystemLinkPlanStub
    elfPlan.emitKind = creq.EmitObj
    elfPlan.targetTriple = "riscv64-unknown-linux-gnu"
    let elfHelper = lower.LoweringProjectFunctionSymbolExact(
        plan, elfPlan, 0)
    let elfExport = lower.LoweringProjectFunctionSymbolExact(
        plan, elfPlan, 1)
    let elfMain = lower.LoweringProjectFunctionSymbolExact(
        plan, elfPlan, 2)
    let elfEntry = lower.LoweringProjectFunctionSymbolExact(
        plan, elfPlan, 3)
    assert(elfHelper.decoratedUtf8 ==
               "c22_e58c852fe6a8a13a3ae8be85e58aa92de587bde695b0__L17" &&
           elfHelper.originalNameId == helperId &&
           elfHelper.role == lower.LoweringFunctionSymbolRoleTypedName,
           "ELF internal UTF-8 projection drift")
    assert(elfExport.decoratedUtf8 == "导出.函数-β" &&
           elfExport.role ==
               lower.LoweringFunctionSymbolRoleExplicitExport,
           "ELF explicit export bytes were mangled")
    assert(elfMain.decoratedUtf8 ==
               "c14_6170702f6d61696e3a3a6d61696e__L31" &&
           elfMain.originalNameId == mainId &&
           elfMain.role == lower.LoweringFunctionSymbolRoleTypedName,
           "ELF ordinary main intern projection drift")
    assert(elfEntry.decoratedUtf8 == "公开/entry-β" &&
           elfEntry.role ==
               lower.LoweringFunctionSymbolRoleExplicitExport &&
           elfEntry.explicitExportNameExplicit == 1 &&
           elfEntry.exportProducerSourceIndex == 3 &&
           elfEntry.exportProducerDeclarationIndex == 34 &&
           elfEntry.exportProducerNodeId == 104,
           "emit:obj source entry overrode explicit export ABI")

    let slashMangle = lower.LoweringFunctionSymbolMangleOwned("a/b")
    let dotMangle = lower.LoweringFunctionSymbolMangleOwned("a.b")
    let dashMangle = lower.LoweringFunctionSymbolMangleOwned("a-b")
    let underscoreMangle = lower.LoweringFunctionSymbolMangleOwned("a_b")
    let utf8Mangle = lower.LoweringFunctionSymbolMangleOwned("辅助")
    assert(slashMangle == "c3_612f62" &&
           dotMangle == "c3_612e62" &&
           dashMangle == "c3_612d62" &&
           underscoreMangle == "c3_615f62" &&
           utf8Mangle == "c6_e8be85e58aa9" &&
           slashMangle != dotMangle && dotMangle != dashMangle &&
           dashMangle != underscoreMangle &&
           lower.LoweringFunctionSymbolMangleStrictValid(
               "a/b", slashMangle) &&
           !lower.LoweringFunctionSymbolMangleStrictValid(
               "a/b", "c3_612F62"),
           "canonical injective symbol mangle drift")

    var darwinPlan: slplan.SystemLinkPlanStub
    darwinPlan.emitKind = creq.EmitObj
    darwinPlan.targetTriple = "arm64-apple-darwin"
    let darwinHelper = lower.LoweringProjectFunctionSymbolExact(
        plan, darwinPlan, 0)
    let darwinExport = lower.LoweringProjectFunctionSymbolExact(
        plan, darwinPlan, 1)
    let darwinMain = lower.LoweringProjectFunctionSymbolExact(
        plan, darwinPlan, 2)
    let darwinEntry = lower.LoweringProjectFunctionSymbolExact(
        plan, darwinPlan, 3)
    assert(darwinHelper.decoratedUtf8 ==
               "_c22_e58c852fe6a8a13a3ae8be85e58aa92de587bde695b0__L17" &&
           darwinExport.decoratedUtf8 == "_导出.函数-β" &&
           darwinMain.decoratedUtf8 ==
               "_c14_6170702f6d61696e3a3a6d61696e__L31" &&
           darwinEntry.decoratedUtf8 == "_公开/entry-β",
           "Darwin target decoration drift")

    var backend2Symbols: str[]
    add(backend2Symbols, strings.CloneStr(darwinHelper.decoratedUtf8))
    add(backend2Symbols, strings.CloneStr(darwinExport.decoratedUtf8))
    add(backend2Symbols, strings.CloneStr(darwinMain.decoratedUtf8))
    add(backend2Symbols, strings.CloneStr(darwinEntry.decoratedUtf8))
    let definitionSymbol = b2asm.Backend2FunctionSymbolAtRowExact(
        backend2Symbols, 1)
    let callSymbol = b2asm.Backend2FunctionSymbolAtRowExact(
        backend2Symbols, 1)
    let funcaddrSymbol = b2asm.Backend2FunctionSymbolAtRowExact(
        backend2Symbols, 1)
    let entrySymbol = b2asm.Backend2FunctionSymbolAtRowExact(
        backend2Symbols, 1)
    assert(definitionSymbol == callSymbol &&
           callSymbol == funcaddrSymbol &&
           funcaddrSymbol == entrySymbol,
           "backend2 symbol consumers diverged")
    backend2Symbols[1] = "_变异-export"
    assert(b2asm.Backend2FunctionSymbolAtRowExact(backend2Symbols, 1) ==
               "_变异-export",
           "backend2 row mutation did not reach the shared consumer")

    let frozenReceipt = plan.functionNameIdentityReceiptCid
    plan.functionExportSymbolNames[1] = "导出.函数-变异"
    assert(!lower.LoweringFunctionNameIdentityStrictValid(plan),
           "export payload mutation escaped receipt")
    plan.functionExportSymbolNames[1] = "导出.函数-β"
    plan.functionExportProducerSourceIndexes[1] = 9
    assert(!lower.LoweringFunctionNameIdentityStrictValid(plan),
           "same export bytes with different producer escaped receipt")
    plan.functionExportProducerSourceIndexes[1] = 2
    plan.functionExportProducerFactCids[1] =
        symbolProjectionCid("producer-export-mutated")
    assert(!lower.LoweringFunctionNameIdentityStrictValid(plan),
           "export producer CID mutation escaped receipt")
    plan.functionExportProducerFactCids[1] =
        symbolProjectionCid("producer-export")
    plan.functionSignatureLineNumbers[0] = 18
    assert(!lower.LoweringFunctionNameIdentityStrictValid(plan),
           "line-scope mutation escaped receipt")
    plan.functionSignatureLineNumbers[0] = 17
    plan.functionNameIdentityReceiptCid = frozenReceipt
    assert(lower.LoweringFunctionNameIdentityStrictValid(plan),
           "restored immutable receipt did not validate")

    langintern.InternPoolRelease(plan.typedIr.internPool)
    echo("function_symbol_projection_smoke=pass")
    return 0
