import cheng/core/backend/regalloc_production_artifacts as artifacts
import cheng/core/backend/regalloc_production_emitter as emitter
import cheng/core/ir/core_types as coreir
import cheng/std/bytes_layout as layout
import std/result
import cheng/core/backend/regalloc_aarch64_adapter as rega64

fn main(): int32 =
    # B1: codegen unit composition root (dispatch fails closed without registration)
    if !rega64.RegallocA64CodegenUnitRegister():
        return 90
    var body = coreir.BodyIRNew()
    let parsedCid = layout.FixedBytes32FromHex(
        "7777777777777777777777777777777777777777777777777777777777777777")
    assert(IsOk(parsedCid), "managed authority admission CID")
    let typeArenaCid = Value(parsedCid)
    assert(coreir.BodyIRBindTypeArenaArtifactCid(body, typeArenaCid),
           "managed authority admission BodyIR CID")

    var slot: coreir.LocalSlot
    slot.id = 0
    slot.name = "managed_result"
    slot.typeKind = coreir.LocalStrTag
    slot.stackOffset = 16
    slot.sizeBytes = 8
    slot.alignBytes = 8
    coreir.BodyIRApplyLocalSlotDefaultProof(slot)
    add(body.localSlots, slot)
    assert(coreir.BodyIRBindLocalSlotTypeArenaProof(
               body,
               0,
               typeArenaCid,
               1,
               coreir.BodyManagedStorageManagedTag),
           "managed authority admission slot proof")

    var op: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = coreir.BodyOpLoadConstTag
    op.target = 0
    op.valueDefSlot = 0
    op.valueDefOwnership = coreir.OwnMove
    add(op.operands, coreir.LocalStrTag)
    add(op.operands, 0)
    add(body.ops, op)

    var noSymbols: str[]
    let emission = emitter.RegallocProductionEmitFunction(
        artifacts.RegallocProductionTargetA64Darwin,
        body,
        "_managed_authority_missing",
        0,
        noSymbols,
        noSymbols,
        0,
        artifacts.RegallocProductionFunctionKindNormal)
    return emission.errorCode
