@borrows
import std/strings

type Decl =
    prop: int32
    src: str
    spec: int32

type Comp =
    src0: str
    spec0: int32

@borrows
fn ApplyIt(style: var Comp, declaration: Decl) =
    if declaration.spec > 0:
        style.src0 = strings.CloneStr(declaration.src)
        style.spec0 = declaration.spec

fn MergeIt(declarations: Decl[], style: var Comp) =
    var i: int32
    while i < declarations.len:
        var j = i
        while j > 0:
            var cur: Decl
            var prev: Decl
            cur.prop = declarations[j].prop
            cur.src = strings.CloneStr(declarations[j].src)
            cur.spec = declarations[j].spec
            prev.prop = declarations[j - 1].prop
            prev.src = strings.CloneStr(declarations[j - 1].src)
            prev.spec = declarations[j - 1].spec
            var lower = false
            if cur.spec < prev.spec:
                lower = true
            elif cur.spec == prev.spec && cur.prop < prev.prop:
                lower = true
            if !lower:
                break
            declarations[j] = prev
            declarations[j - 1] = cur
            j = j - 1
        i = i + 1
    var k: int32
    while k < declarations.len:
        ApplyIt(style, declarations[k])
        k = k + 1
