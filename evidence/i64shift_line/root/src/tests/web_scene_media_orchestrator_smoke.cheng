# Smoke: pure-Cheng media orchestrator manifest -> scene-graph asset mapping.
# Verifies the orchestrator compiles against the media + scene APIs and that a
# MoQ fountain asset manifest projects onto the GUI media-asset record (fountain
# transport identity intact) and is accepted by the scene graph's validator.

import std/result
import cheng/core/runtime/web_scene_runtime as scene
import cheng/core/runtime/web_scene_media_orchestrator as orch
import cheng/moq/media_asset_manifest as media

fn main(): int32 =
    var manifest: media.MediaAssetManifest
    manifest.assetCid = "asset-cid-1"
    manifest.bundleCid = "bundle-cid-1"
    manifest.mime = "video/mp4"
    manifest.kindCode = 1
    manifest.durationMs = int64(22000)
    manifest.codec = "h264/aac"
    manifest.posterCid = "poster-cid-1"
    manifest.initSegmentCid = "init-cid-1"
    manifest.initSegmentByteLength = 96
    manifest.keyframeIndex = "kf-1"
    manifest.transport = "moq"
    manifest.fecScheme = "fountain"
    manifest.contentSignature = "sig-1"
    manifest.catalogCid = "catalog-cid-1"
    manifest.catalogKey = "catalog-key-1"
    manifest.rebuildTemplateCid = "rebuild-cid-1"
    manifest.rebuildTemplateKey = "rebuild-key-1"
    manifest.objectTargetBytes = 4096
    manifest.sourceBlockBytes = 1024
    var obj: media.MediaObjectDescriptor
    add(manifest.objects, obj)
    var droplet: media.MediaDropletDescriptor
    add(manifest.droplets, droplet)

    let asset = orch.WebSceneMediaAssetFromManifest("slot-1", manifest)
    assert(asset.assetFactId == "slot-1", " media orchestrator: assetFactId")
    assert(asset.assetCid == "asset-cid-1", " media orchestrator: assetCid")
    assert(asset.bundleCid == "bundle-cid-1", " media orchestrator: bundleCid")
    assert(asset.transport == "moq", " media orchestrator: transport")
    assert(asset.fecScheme == "fountain", " media orchestrator: fecScheme")
    assert(asset.catalogCid == "catalog-cid-1", " media orchestrator: catalogCid")
    assert(asset.catalogKey == "catalog-key-1", " media orchestrator: catalogKey")
    assert(asset.rebuildTemplateCid == "rebuild-cid-1", " media orchestrator: rebuildTemplateCid")
    assert(asset.objectTargetBytes == 4096, " media orchestrator: objectTargetBytes")
    assert(asset.sourceBlockBytes == 1024, " media orchestrator: sourceBlockBytes")
    assert(asset.objectCount == 1, " media orchestrator: objectCount")
    assert(asset.dropletCount == 1, " media orchestrator: dropletCount")
    assert(asset.keyframeIndex == "kf-1", " media orchestrator: keyframeIndex")
    assert(asset.initSegmentByteLength == 96, " media orchestrator: initSegmentByteLength")

    var graph: scene.WebSceneGraph
    scene.WebSceneGraphInit(graph)
    # GUI surface: route + container + <video> node (mirrors media_video_e2e_native_player_smoke).
    assert(scene.WebSceneAddRouteExpectedIndex(graph, "native_video_surface", 1, 1, 0), " media orchestrator: add route")
    assert(scene.WebSceneAddLayer(graph, 0, 1, "content", 0), " media orchestrator: add layer")
    assert(scene.WebSceneAddNode(graph, 0, 1, 0, 2, "div", "", 1), " media orchestrator: add container node")
    assert(scene.WebSceneAddNode(graph, 0, 2, 1, 2, "video", "", 1), " media orchestrator: add video node")
    assert(scene.WebSceneAddMediaAsset(graph, asset), " media orchestrator: add media asset")
    assert(scene.WebSceneMediaAssetCount(graph) == 1, " media orchestrator: media asset count")

    # OpenAsset render binding (对端秒开): build the playback slot from the asset.
    let slot = orch.WebSceneMediaPlaybackSlotFromAsset(asset, "playback-1", "manifest-cid-1",
                                                       0, 2, "template.native.video.player", "media.video.state",
                                                       "decode-fountain", "gpu-texture", "audio-out", "cover")
    assert(slot.slotId == "playback-1", " media orchestrator: slot id")
    assert(slot.assetFactId == "slot-1", " media orchestrator: slot assetFactId")
    assert(slot.assetCid == "asset-cid-1", " media orchestrator: slot assetCid")
    assert(slot.manifestCid == "manifest-cid-1", " media orchestrator: slot manifestCid")
    assert(slot.providerKind == "media-decode-provider", " media orchestrator: slot providerKind")
    assert(slot.decodeProvider == "decode-fountain", " media orchestrator: slot decodeProvider")
    assert(slot.objectFit == "cover", " media orchestrator: slot objectFit")
    assert(scene.WebSceneMediaSurfaceObjectFitHostCode(slot.objectFit) > 0, " media orchestrator: slot objectFit host code")

    # Full bind: register the slot onto the graph, validated against the live <video> node.
    assert(orch.WebSceneMediaOrchestrateBindPlaybackSlot(graph, asset, "playback-1", "manifest-cid-1",
                                                         0, 2, "template.native.video.player", "media.video.state",
                                                         "decode-fountain", "gpu-texture", "audio-out", "cover"),
           " media orchestrator: bind playback slot onto scene graph")

    echo(" web_scene_media_orchestrator_smoke ok")
    return 0
