type BorrowRvalueCounter = ref object
    value: int32

fn BorrowRvalueMake(): BorrowRvalueCounter =
    return new(BorrowRvalueCounter)

fn BorrowRvalueMutate(counter: var BorrowRvalueCounter) =
    counter.value = counter.value + 1

fn BorrowRvalueOverload(value: int32): int32 =
    return value

fn BorrowRvalueOverload(counter: var BorrowRvalueCounter): int32 =
    counter.value = counter.value + 1
    return counter.value

fn main(): int32 =
    BorrowRvalueOverload(BorrowRvalueMake())
    return 0
