import std/system

fn zcReadOccupied(states: uint8[], bucketCapacity: int32): int32 =
    let value = uint32(states[0]) |
                (uint32(states[1]) << uint32(8)) |
                (uint32(states[2]) << uint32(16)) |
                (uint32(states[3]) << uint32(24))
    if value >= uint32(bucketCapacity):
        panic("typed expr numeric cast: occupied slot corrupt")
    return int32(value)

fn zcLoadU8(dataPtr0: ptr): uint8 =
    let value: uint8 = load(dataPtr0)
    return value

fn zcLoadI32(dataPtr0: ptr): int32 =
    let value: int32 = load(dataPtr0)
    return value

fn zcLoadU64(dataPtr0: ptr): uint64 =
    let value: uint64 = load(dataPtr0)
    return value

fn zcNestedLoadU64(dataPtr0: ptr): uint64 =
    return uint64(load[uint64](dataPtr0))

fn zcHashByte(dataPtr0: ptr, offset: int32): uint64 =
    return uint64(load[uint8](system_ptr_add(dataPtr0, offset)))

fn zcPack3(dataPtr0: ptr): uint64 =
    var out: uint64
    for i in 0..<3:
        let ch: uint64 = uint64(load[uint8](system_ptr_add(dataPtr0, i)))
        out = out | (ch << uint64(i * 8))
    return out

fn zcWidenHighU32(): uint64 =
    let high: uint32 = uint32(1) << uint32(31)
    return uint64(high)

fn zcWidenSignedI32(): int64 =
    let negative: int32 = -1
    return int64(negative)

fn zcTruncateU64(): uint32 =
    let wide: uint64 = uint64(0x100000001)
    return uint32(wide)

fn zcTruncateSignedI32(): int8 =
    let wide: int32 = 255
    return int8(wide)

fn main(): int32 =
    var states: uint8[]
    add(states, uint8(4))
    add(states, uint8(0))
    add(states, uint8(0))
    add(states, uint8(0))
    assert(zcReadOccupied(states, 8) == 4,
           "typed expr numeric cast: index/cast/shift")

    let text = "abcdefgh"
    let dataPtr0 = strDataPtr(text)
    assert(zcLoadU8(dataPtr0) == uint8(97),
           "typed expr std load: direct U8")
    assert(zcLoadI32(dataPtr0) == 1684234849,
           "typed expr std load: direct I32")
    assert(zcLoadU64(dataPtr0) == uint64(0x6867666564636261),
           "typed expr std load: direct U64")
    assert(zcNestedLoadU64(dataPtr0) == uint64(0x6867666564636261),
           "typed expr std load: nested cast U64")
    assert(zcHashByte(dataPtr0, 0) == uint64(97),
           "typed expr numeric cast: explicit U8 load then widen")
    assert(zcPack3(dataPtr0) == uint64(6513249),
           "typed expr numeric cast: load/cast/shift/or")

    assert(zcWidenHighU32() == (uint64(1) << uint64(31)),
           "typed expr numeric cast: uint32 high bit zero extends")
    assert(zcWidenSignedI32() == int64(-1),
           "typed expr numeric cast: int32 sign extends")
    assert(zcTruncateU64() == uint32(1),
           "typed expr numeric cast: uint64 truncates low 32 bits")
    assert(zcTruncateSignedI32() == int8(-1),
           "typed expr numeric cast: int8 truncation sign canonicalizes")
    echo("typed_expr_numeric_cast_echo_zc_smoke ok")
    return 0
