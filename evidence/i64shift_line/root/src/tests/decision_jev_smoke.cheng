# Jev 对照适配器冒烟 (OpenSpec csg-semantic-decision-computer-use 任务 13 首切片)。
#
# 无需网络与凭据的验证门。输出行标注约定:
#   fixture-response  —— 解析器边界测试, 请求/响应体是构造的 fixture 字符串,
#                        不是真实 Jev 服务验证;
#   fault-injection   —— 经类型化传输接缝注入延迟/错误信号驱动的状态机测试,
#                        边界注入只进本测试驱动, 不进产品代码。
# 真实调用验证状态恒为 NotTested (无凭据/预算授权, 未发起任何真实网络调用)。
# 合同: docs/campaigns/2026-09-21-csg-decision-computer-use/contract.md §3;
# 校验权威 src/inference/decision_validate.cheng; 适配器
# src/inference/decision_jev.cheng。

import std/strings
import std/strutils as strutil
import std/result
import std/json as jevjson
import cheng/core/runtime/csg_decision_contract as dc
import cheng/inference/decision_validate as dv
import cheng/inference/decision_jev as jev

# -------------------------------------------------------------------
# 断言桥 (非泛型单处消费, 同 csg_decision_contract_smoke)
# -------------------------------------------------------------------

fn smokeJoin(parts: str[]): str =
    return strutil.Join(parts, "")

fn smokeCheckOk(label: str, okFlag: bool, got: str) =
    if !okFlag:
        echo(smokeJoin(["smoke FAIL expect-ok ", strings.CloneStr(label), " err=", strings.CloneStr(got)]))
        assert(false, "smoke expect-ok failed")
        return
    echo(smokeJoin(["smoke ok: ", strings.CloneStr(label)]))

fn smokeCheckErr(label: str, expected: str, okFlag: bool, got: str) =
    if okFlag:
        echo("smoke FAIL expect-err: unexpected success")
        assert(false, "smoke expected rejection")
        return
    if got != expected:
        echo(smokeJoin(["smoke FAIL err-mismatch ", strings.CloneStr(label), " expected=", strings.CloneStr(expected), " got=", strings.CloneStr(got)]))
        assert(false, "smoke err mismatch")
        return
    echo(smokeJoin(["smoke reject ok: ", strings.CloneStr(label), " -> ", strings.CloneStr(got)]))

fn smokeExpectStr(label: str, got: str, expected: str) =
    let ownedGot = strings.CloneStr(got)
    let ownedExpected = strings.CloneStr(expected)
    if ownedGot != ownedExpected:
        echo(smokeJoin(["smoke FAIL str ", strings.CloneStr(label), " expected=", ownedExpected, " got=", ownedGot]))
        assert(false, "smoke str mismatch")
        return
    echo(smokeJoin(["smoke ok: ", strings.CloneStr(label), " = ", ownedGot]))

fn smokeExpectBool(label: str, got: bool, expected: bool) =
    if got != expected:
        echo(smokeJoin(["smoke FAIL bool ", strings.CloneStr(label)]))
        assert(false, "smoke bool mismatch")
        return
    echo(smokeJoin(["smoke ok: ", strings.CloneStr(label)]))

fn smokeExpectI32(label: str, got: int32, expected: int32) =
    if got != expected:
        echo(smokeJoin(["smoke FAIL i32 ", strings.CloneStr(label)]))
        assert(false, "smoke i32 mismatch")
        return
    echo(smokeJoin(["smoke ok: ", strings.CloneStr(label)]))

fn smokeExpectI64(label: str, got: int64, expected: int64) =
    if got != expected:
        echo(smokeJoin(["smoke FAIL i64 ", strings.CloneStr(label)]))
        assert(false, "smoke i64 mismatch")
        return
    echo(smokeJoin(["smoke ok: ", strings.CloneStr(label)]))

# -------------------------------------------------------------------
# fixture 图 (全绿合同图, 子集: slots + candidates + 三头 learn 节点)
# 槽位: 0 goal, 1 actionModel, 2/3 param, 4 precondition, 5 effectContract,
# 6 evidence, 7 backend。learns: [0]Choice/[1]Noul/[2]Score, 候选集 0..1。
# -------------------------------------------------------------------

fn smokeBuildGraph(): dc.CsgDecisionGraph =
    let generation: int64 = 7
    var g = dc.CsgDecisionGraphNew(9001, generation)
    let goalSlot = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindGoal)
    let actionModelSlot = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindActionModel)
    let paramSlot1 = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindParam)
    let paramSlot2 = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindParam)
    let preconditionSlot = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindPrecondition)
    let effectSlot = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindEffectContract)
    let evidenceSlot = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindEvidence)
    let backendSlot = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindBackend)

    var ln0: dc.CsgDecisionLearnNode
    ln0.headKind = dc.CsgDecisionHeadChoice
    ln0.candidateSetRef = 0
    ln0.candidateCount = 2
    ln0.evidenceRef = evidenceSlot
    ln0.backendRef = backendSlot
    ln0.generation = generation
    dc.CsgDecisionLearnAdd(g, ln0)

    var ln1: dc.CsgDecisionLearnNode
    ln1.headKind = dc.CsgDecisionHeadNoul
    ln1.candidateSetRef = 0
    ln1.candidateCount = 0
    ln1.evidenceRef = evidenceSlot
    ln1.backendRef = backendSlot
    ln1.generation = generation
    dc.CsgDecisionLearnAdd(g, ln1)

    var ln2: dc.CsgDecisionLearnNode
    ln2.headKind = dc.CsgDecisionHeadScore
    ln2.candidateSetRef = 0
    ln2.candidateCount = 2
    ln2.evidenceRef = evidenceSlot
    ln2.backendRef = backendSlot
    ln2.generation = generation
    dc.CsgDecisionLearnAdd(g, ln2)

    var paramsA: int32[]
    add(paramsA, paramSlot1)
    add(paramsA, paramSlot2)
    var candA: dc.CsgDecisionCandidate
    candA.goalRef = goalSlot
    candA.operationRef = actionModelSlot
    candA.paramSlots = paramsA
    candA.preconditionRef = preconditionSlot
    candA.effectContractRef = effectSlot
    candA.generation = generation
    dc.CsgDecisionCandidateAdd(g, candA)

    var paramsB: int32[]
    add(paramsB, paramSlot1)
    add(paramsB, paramSlot2)
    var candB: dc.CsgDecisionCandidate
    candB.goalRef = goalSlot
    candB.operationRef = actionModelSlot
    candB.paramSlots = paramsB
    candB.preconditionRef = preconditionSlot
    candB.effectContractRef = effectSlot
    candB.generation = generation
    dc.CsgDecisionCandidateAdd(g, candB)
    return g

fn smokeNoCands(): jev.JevCandidateText[] =
    var r: jev.JevCandidateText[]
    return r

fn smokeChoiceSpec(g: dc.CsgDecisionGraph, allow: bool): jev.JevRequestSpec =
    var candTexts: jev.JevCandidateText[]
    var t0: jev.JevCandidateText
    t0.candidateIndex = 0
    t0.description = "发布短视频草稿"
    add(candTexts, t0)
    var t1: jev.JevCandidateText
    t1.candidateIndex = 1
    t1.description = "发布广告视频草稿"
    add(candTexts, t1)
    var spec: jev.JevRequestSpec
    spec.graph = g
    spec.learnRef = 0
    spec.boundGoalRef = 0
    spec.question = jev.JevQuestionText(questionId: "q1", instructions: "哪个任务类型最符合用户请求")
    spec.stateText = "用户请求: 帮我发布一个宠物视频"
    spec.candidateTexts = candTexts
    spec.allowNoMatch = allow
    spec.model = jev.JevModelDefault
    return spec

fn smokeNoulSpec(g: dc.CsgDecisionGraph): jev.JevRequestSpec =
    var spec: jev.JevRequestSpec
    spec.graph = g
    spec.learnRef = 1
    spec.boundGoalRef = 0
    spec.question = jev.JevQuestionText(questionId: "q1", instructions: "用户请求是否包含视频发布意图")
    spec.stateText = "用户请求: 帮我发布一个宠物视频"
    spec.candidateTexts = smokeNoCands()
    spec.allowNoMatch = false
    spec.model = jev.JevModelDefault
    return spec

fn smokeScoreSpec(g: dc.CsgDecisionGraph): jev.JevRequestSpec =
    var candTexts: jev.JevCandidateText[]
    var t0: jev.JevCandidateText
    t0.candidateIndex = 0
    t0.description = "低相关"
    add(candTexts, t0)
    var t1: jev.JevCandidateText
    t1.candidateIndex = 1
    t1.description = "高相关"
    add(candTexts, t1)
    var spec: jev.JevRequestSpec
    spec.graph = g
    spec.learnRef = 2
    spec.boundGoalRef = 0
    spec.question = jev.JevQuestionText(questionId: "q1", instructions: "用户请求与视频发布的匹配程度")
    spec.stateText = "用户请求: 帮我发布一个宠物视频"
    spec.candidateTexts = candTexts
    spec.allowNoMatch = false
    spec.model = jev.JevModelDefault
    return spec

# -------------------------------------------------------------------
# 传输接缝测试驱动 (fault-injection 只存在于本文件)
# -------------------------------------------------------------------

var smokeTransportCalls: int32 = 0
var smokeCurrentBody: str = ""

fn smokeTransportOk(req: str): jev.JevTransportReply =
    smokeTransportCalls = smokeTransportCalls + 1
    var reply: jev.JevTransportReply
    reply.ok = true
    reply.statusKind = jev.JevTransportKindOk
    reply.httpStatus = 200
    reply.body = strings.CloneStr(smokeCurrentBody)
    reply.latencyMs = 42
    return reply

fn smokeTransportTimeout(req: str): jev.JevTransportReply =
    smokeTransportCalls = smokeTransportCalls + 1
    var reply: jev.JevTransportReply
    reply.ok = false
    reply.statusKind = jev.JevTransportKindTimeout
    reply.httpStatus = 0
    reply.body = ""
    reply.latencyMs = 999
    return reply

fn smokeTransportBackendFailure(req: str): jev.JevTransportReply =
    smokeTransportCalls = smokeTransportCalls + 1
    var reply: jev.JevTransportReply
    reply.ok = false
    reply.statusKind = jev.JevTransportKindBackendFailure
    reply.httpStatus = 0
    reply.body = ""
    reply.latencyMs = 3
    return reply

# fixture 响应体 (fixture-response, 形状按 decision_jev.cheng 头注释调研结论)
fn smokeBodyChoiceOk(): str =
    return "{\"model\":\"jev-1.13.0\",\"answers\":{\"q1\":{\"type\":\"choice\",\"choice\":\"option_0\",\"probabilities\":{\"option_0\":0.7,\"option_1\":0.3},\"confidence\":0.2}},\"usage\":{\"input_tokens\":100,\"output_tokens\":5}}"

fn smokeBodyChoiceNoneOk(): str =
    return "{\"model\":\"jev-1.13.0\",\"answers\":{\"q1\":{\"type\":\"choice\",\"choice\":\"none_of_above\",\"probabilities\":{\"option_0\":0.1,\"option_1\":0.2,\"none_of_above\":0.7},\"confidence\":0.25}},\"usage\":{\"input_tokens\":90,\"output_tokens\":4}}"

fn smokeBodyScoreOk(): str =
    return "{\"model\":\"jev-1.13.0\",\"answers\":{\"q1\":{\"type\":\"score\",\"score\":0.75,\"probabilities\":{\"0\":0.25,\"1\":0.75},\"confidence\":0.5}},\"usage\":{\"input_tokens\":11,\"output_tokens\":2}}"

fn smokeBodyNoulOk(): str =
    return "{\"model\":\"jev-1.13.0\",\"answers\":{\"q1\":{\"type\":\"noul\",\"noul\":0.42}},\"usage\":{\"input_tokens\":7,\"output_tokens\":1}}"

fn smokeMainRequestMapping() =
    # ---- (a) 请求映射: Choice (含 no-match 语义位) ----
    var frChoice = jev.JevFreezeRequest(smokeChoiceSpec(smokeBuildGraph(), true))
    let frChoiceOk = IsOk(frChoice)
    let frChoiceMsg = Error(frChoice)
    smokeCheckOk("freeze-choice", frChoiceOk, frChoiceMsg)
    let reqChoice = Value(frChoice)
    var bodyRes = jev.JevBuildRequestJson(reqChoice)
    let bodyOk = IsOk(bodyRes)
    let bodyMsg = Error(bodyRes)
    smokeCheckOk("build-choice", bodyOk, bodyMsg)
    let parsed = jevjson.parseJson(Value(bodyRes))
    let questions = jevjson.JsonGetField(parsed, "questions")
    let q1 = jevjson.JsonGetField(questions, "q1")
    smokeExpectStr("choice-type", jevjson.GetStr(jevjson.JsonGetField(q1, "type")), "choice")
    smokeExpectStr("choice-instructions", jevjson.GetStr(jevjson.JsonGetField(q1, "instructions")), "哪个任务类型最符合用户请求")
    smokeExpectStr("root-model", jevjson.GetStr(jevjson.JsonGetField(parsed, "model")), "jev-latest")
    smokeExpectStr("root-state", jevjson.GetStr(jevjson.JsonGetField(parsed, "state")), "用户请求: 帮我发布一个宠物视频")
    let criteria = jevjson.JsonGetField(q1, "criteria")
    smokeExpectBool("choice-criteria-object", criteria.kind == jevjson.JObject, true)
    smokeExpectI32("choice-criteria-count-with-none", criteria.okeys.len, 3)
    smokeExpectBool("choice-option-0-present", jevjson.HasKey(criteria, "option_0"), true)
    smokeExpectBool("choice-option-1-present", jevjson.HasKey(criteria, "option_1"), true)
    smokeExpectBool("choice-no-match-slot-present", jevjson.HasKey(criteria, "none_of_above"), true)
    echo("smoke ok: request-mapping choice (no-match 语义位 = 保留选项 none_of_above, fixture-response)")

    # ---- (a) 请求映射: 无 no-match 位 ----
    var frChoice2 = jev.JevFreezeRequest(smokeChoiceSpec(smokeBuildGraph(), false))
    let reqChoice2 = Value(frChoice2)
    var bodyRes2 = jev.JevBuildRequestJson(reqChoice2)
    let parsed2 = jevjson.parseJson(Value(bodyRes2))
    let q12 = jevjson.JsonGetField(jevjson.JsonGetField(parsed2, "questions"), "q1")
    let criteria2 = jevjson.JsonGetField(q12, "criteria")
    smokeExpectI32("choice-criteria-count-no-none", criteria2.okeys.len, 2)
    smokeExpectBool("choice-no-match-slot-absent", jevjson.HasKey(criteria2, "none_of_above"), false)

    # ---- (a) 请求映射: Noul (无 criteria) ----
    var frNoul = jev.JevFreezeRequest(smokeNoulSpec(smokeBuildGraph()))
    let frNoulOk = IsOk(frNoul)
    let frNoulMsg = Error(frNoul)
    smokeCheckOk("freeze-noul", frNoulOk, frNoulMsg)
    let reqNoul = Value(frNoul)
    var bodyResN = jev.JevBuildRequestJson(reqNoul)
    let bodyNOk = IsOk(bodyResN)
    let bodyNMsg = Error(bodyResN)
    smokeCheckOk("build-noul", bodyNOk, bodyNMsg)
    let parsedN = jevjson.parseJson(Value(bodyResN))
    let q1N = jevjson.JsonGetField(jevjson.JsonGetField(parsedN, "questions"), "q1")
    smokeExpectStr("noul-type", jevjson.GetStr(jevjson.JsonGetField(q1N, "type")), "noul")
    smokeExpectBool("noul-criteria-absent", jevjson.HasKey(q1N, "criteria"), false)
    echo("smoke ok: request-mapping noul (fixture-response)")

    # ---- (a) 请求映射: Score (有序级别数组) ----
    var frScore = jev.JevFreezeRequest(smokeScoreSpec(smokeBuildGraph()))
    let frScoreOk = IsOk(frScore)
    let frScoreMsg = Error(frScore)
    smokeCheckOk("freeze-score", frScoreOk, frScoreMsg)
    let reqScore = Value(frScore)
    var bodyResS = jev.JevBuildRequestJson(reqScore)
    let bodySOk = IsOk(bodyResS)
    let bodySMsg = Error(bodyResS)
    smokeCheckOk("build-score", bodySOk, bodySMsg)
    let parsedS = jevjson.parseJson(Value(bodyResS))
    let q1S = jevjson.JsonGetField(jevjson.JsonGetField(parsedS, "questions"), "q1")
    smokeExpectStr("score-type", jevjson.GetStr(jevjson.JsonGetField(q1S, "type")), "score")
    let criteriaS = jevjson.JsonGetField(q1S, "criteria")
    smokeExpectBool("score-criteria-array", criteriaS.kind == jevjson.JArray, true)
    smokeExpectI32("score-level-count", criteriaS.a.len, 2)
    echo("smoke ok: request-mapping score (fixture-response)")

    # ---- (a) 反例: 候选绑定错位 ----
    var badTexts: jev.JevCandidateText[]
    var b0: jev.JevCandidateText
    b0.candidateIndex = 1
    b0.description = "发布短视频草稿"
    add(badTexts, b0)
    var b1: jev.JevCandidateText
    b1.candidateIndex = 0
    b1.description = "发布广告视频草稿"
    add(badTexts, b1)
    var badSpec: jev.JevRequestSpec
    badSpec.graph = smokeBuildGraph()
    badSpec.learnRef = 0
    badSpec.boundGoalRef = 0
    badSpec.question = jev.JevQuestionText(questionId: "q1", instructions: "哪个任务类型最符合用户请求")
    badSpec.stateText = "s"
    badSpec.candidateTexts = badTexts
    badSpec.allowNoMatch = false
    badSpec.model = jev.JevModelDefault
    var badRes = jev.JevBuildRequestJson(Value(jev.JevFreezeRequest(badSpec)))
    let badOk = IsOk(badRes)
    let badMsg = Error(badRes)
    smokeCheckErr("candidate-binding-mismatch", "InvalidOutput: jev candidate binding mismatch", badOk, badMsg)

fn smokeMainResponseGate(reqChoice: jev.JevLearnRequest) =
    # ---- (b) 响应门: 逐条 InvalidOutput 且错误串可区分 (fixture-response,
    #      解析器边界测试, 非真实服务验证) ----
    var rTrunc = jev.JevParseResponse(reqChoice, "{\"model\": \"jev-1.13.0\", \"ans")
    let rTruncOk = IsOk(rTrunc)
    let rTruncMsg = Error(rTrunc)
    smokeCheckErr("response-truncated", "InvalidOutput: jev response truncated", rTruncOk, rTruncMsg)

    var rModel = jev.JevParseResponse(reqChoice, "{\"answers\":{},\"usage\":{\"input_tokens\":1,\"output_tokens\":1}}")
    let rModelOk = IsOk(rModel)
    let rModelMsg = Error(rModel)
    smokeCheckErr("response-model-version-missing", "InvalidOutput: jev response model version missing", rModelOk, rModelMsg)

    var rKey = jev.JevParseResponse(reqChoice, "{\"model\":\"jev-1.13.0\",\"answers\":{\"zzz\":{\"type\":\"choice\",\"choice\":\"option_0\",\"probabilities\":{\"option_0\":1.0}}},\"usage\":{\"input_tokens\":1,\"output_tokens\":1}}")
    let rKeyOk = IsOk(rKey)
    let rKeyMsg = Error(rKey)
    smokeCheckErr("response-answer-key-missing", "InvalidOutput: jev response answer key missing", rKeyOk, rKeyMsg)

    var rType = jev.JevParseResponse(reqChoice, "{\"model\":\"jev-1.13.0\",\"answers\":{\"q1\":{\"type\":\"noul\",\"noul\":0.5}},\"usage\":{\"input_tokens\":1,\"output_tokens\":1}}")
    let rTypeOk = IsOk(rType)
    let rTypeMsg = Error(rType)
    smokeCheckErr("answer-type-mismatch", "InvalidOutput: jev answer type mismatch", rTypeOk, rTypeMsg)

    var rBig = jev.JevParseResponse(reqChoice, "{\"model\":\"jev-1.13.0\",\"answers\":{\"q1\":{\"type\":\"choice\",\"choice\":\"option_0\",\"probabilities\":{\"option_0\":1.5,\"option_1\":0.3}}},\"usage\":{\"input_tokens\":1,\"output_tokens\":1}}")
    let rBigOk = IsOk(rBig)
    let rBigMsg = Error(rBig)
    smokeCheckErr("prob-out-of-range", "InvalidOutput: decision prob float out of range", rBigOk, rBigMsg)

    var rNorm = jev.JevParseResponse(reqChoice, "{\"model\":\"jev-1.13.0\",\"answers\":{\"q1\":{\"type\":\"choice\",\"choice\":\"option_0\",\"probabilities\":{\"option_0\":0.5,\"option_1\":0.4}}},\"usage\":{\"input_tokens\":1,\"output_tokens\":1}}")
    let rNormOk = IsOk(rNorm)
    let rNormMsg = Error(rNorm)
    smokeCheckErr("prob-not-normalized", "InvalidOutput: jev probabilities not normalized", rNormOk, rNormMsg)

    var rCount = jev.JevParseResponse(reqChoice, "{\"model\":\"jev-1.13.0\",\"answers\":{\"q1\":{\"type\":\"choice\",\"choice\":\"option_0\",\"probabilities\":{\"option_0\":0.5,\"option_1\":0.3,\"option_2\":0.2}}},\"usage\":{\"input_tokens\":1,\"output_tokens\":1}}")
    let rCountOk = IsOk(rCount)
    let rCountMsg = Error(rCount)
    smokeCheckErr("choice-count-mismatch", "InvalidOutput: jev choice probabilities size mismatch", rCountOk, rCountMsg)

    var rWinner = jev.JevParseResponse(reqChoice, "{\"model\":\"jev-1.13.0\",\"answers\":{\"q1\":{\"type\":\"choice\",\"choice\":\"option_9\",\"probabilities\":{\"option_0\":0.7,\"option_1\":0.3}}},\"usage\":{\"input_tokens\":1,\"output_tokens\":1}}")
    let rWinnerOk = IsOk(rWinner)
    let rWinnerMsg = Error(rWinner)
    smokeCheckErr("choice-winner-unknown", "InvalidOutput: jev choice winner unknown", rWinnerOk, rWinnerMsg)

    # ---- 错误串可区分性: 由上方逐条整串精确匹配承载 —— 8 个期望串互异,
    #      任一串被改动或串间碰撞都会使对应精确匹配失败; 状态机 3 串
    #      (NotConfigured/Timeout/BackendFailure) 由 (c)/(d) 同款精确匹配覆盖。
    echo("smoke ok: 8 条 InvalidOutput 判词逐一精确匹配, 期望串互异, 可区分")

fn smokeMainStateMachine() =
    # ---- (c) 凭据未设 -> NotConfigured 且传输层零调用 ----
    smokeTransportCalls = 0
    var emptyCreds: jev.JevCredentials
    emptyCreds.apiKey = ""
    var rc = jev.JevDecide(emptyCreds, smokeChoiceSpec(smokeBuildGraph(), false), smokeTransportOk)
    let rcOk = IsOk(rc)
    let rcMsg = Error(rc)
    smokeCheckErr("not-configured", "NotConfigured: jev api key empty", rcOk, rcMsg)
    smokeExpectI32("transport-zero-calls-when-not-configured", smokeTransportCalls, 0)
    echo("smoke ok: NotConfigured 零传输调用 (fault-injection 驱动, 计数器断言)")

    # ---- (d) Timeout / BackendFailure 路径 (fault-injection) ----
    smokeTransportCalls = 0
    var rt = jev.JevDecide(jev.JevCredentials(apiKey: "smoke-explicit-test-key-never-sent"), smokeChoiceSpec(smokeBuildGraph(), false), smokeTransportTimeout)
    let rtOk = IsOk(rt)
    let rtMsg = Error(rt)
    smokeCheckErr("transport-timeout", "Timeout: jev transport timeout", rtOk, rtMsg)
    smokeExpectI32("transport-called-once-timeout", smokeTransportCalls, 1)

    smokeTransportCalls = 0
    var rb = jev.JevDecide(jev.JevCredentials(apiKey: "smoke-explicit-test-key-never-sent"), smokeChoiceSpec(smokeBuildGraph(), false), smokeTransportBackendFailure)
    let rbOk = IsOk(rb)
    let rbMsg = Error(rb)
    smokeCheckErr("transport-backend-failure", "BackendFailure: jev transport failure", rbOk, rbMsg)
    smokeExpectI32("transport-called-once-backend-failure", smokeTransportCalls, 1)
    echo("smoke ok: Timeout/BackendFailure 分立 (fault-injection)")

    # ---- 状态 -> 合同 §3 错误族映射 (图内记录合法) ----
    let kindTimeout = jev.JevContractFailureKind(jev.JevErrTimeout)
    let kindTimeoutKnown = dc.CsgDecisionFailureKindIsKnown(strings.CloneStr(kindTimeout))
    let kindBackend = jev.JevContractFailureKind(jev.JevErrBackendFailure)
    let kindBackendKnown = dc.CsgDecisionFailureKindIsKnown(strings.CloneStr(kindBackend))
    smokeExpectBool("contract-kind-timeout-known", kindTimeoutKnown, true)
    smokeExpectBool("contract-kind-backend-known", kindBackendKnown, true)
    smokeExpectStr("contract-kind-timeout", kindTimeout, dc.CsgDecisionErrDeadlinePassed)
    smokeExpectStr("contract-kind-backend", kindBackend, dc.CsgDecisionErrInferenceFailed)

fn smokeMainSuccessPaths() =
    # ---- (e) 成功路径计量 (解析 fixture, fixture-response) + 端到端合同 ----
    # Choice 成功: 计量填充 + 类型化结果绑定当前节点 + 结果入图全绿
    smokeTransportCalls = 0
    smokeCurrentBody = smokeBodyChoiceOk()
    var re = jev.JevDecide(jev.JevCredentials(apiKey: "smoke-explicit-test-key-never-sent"), smokeChoiceSpec(smokeBuildGraph(), false), smokeTransportOk)
    let reOk = IsOk(re)
    let reMsg = Error(re)
    smokeCheckOk("decide-choice-ok", reOk, reMsg)
    let outcome = Value(re)
    smokeExpectStr("metrics-model-version", strings.CloneStr(outcome.metrics.modelVersion), "jev-1.13.0")
    smokeExpectStr("metrics-question-id", strings.CloneStr(outcome.metrics.questionId), "q1")
    smokeExpectStr("metrics-status", strings.CloneStr(outcome.metrics.status), "Ok")
    smokeExpectI64("metrics-input-tokens", outcome.metrics.inputTokens, 100)
    smokeExpectI64("metrics-output-tokens", outcome.metrics.outputTokens, 5)
    smokeExpectI64("metrics-latency-fixture", outcome.metrics.latencyMs, 42)
    smokeExpectI32("metrics-request-count", outcome.metrics.requestCount, 1)
    smokeExpectI32("result-bound-learn-ref", outcome.result.learnRef, 0)
    let wantGen: int64 = 7
    smokeExpectI64("result-bound-generation", outcome.result.generation, wantGen)
    smokeExpectI32("result-head-kind", outcome.result.headKind, dc.CsgDecisionHeadChoice)
    smokeExpectBool("result-not-no-match", outcome.result.noMatch, false)
    smokeExpectI32("result-chosen-candidate", outcome.result.chosenCandidate, 0)
    smokeExpectI32("result-probs-count", outcome.result.probs.len, 2)
    smokeExpectI32("result-precision", outcome.result.probs[0].precision, 6)
    let want700000: int64 = 700000
    let want300000: int64 = 300000
    smokeExpectI64("result-prob-0-numer", outcome.result.probs[0].numer, want700000)
    smokeExpectI64("result-prob-1-numer", outcome.result.probs[1].numer, want300000)
    var gChoice = smokeBuildGraph()
    var resChoice: dc.CsgDecisionLearnResult
    resChoice = outcome.result
    dc.CsgDecisionLearnResultAdd(gChoice, resChoice)
    let gvChoice = dv.DecisionValidateGraph(share(gChoice))
    let gvChoiceOk = IsOk(gvChoice)
    let gvChoiceMsg = Error(gvChoice)
    smokeCheckOk("graph-with-jev-choice-result-valid", gvChoiceOk, gvChoiceMsg)
    smokeExpectI32("transport-called-once-success", smokeTransportCalls, 1)
    echo("smoke ok: success metrics + typed result bound to node (fixture-response)")

    # Choice no-match 成功: 显式合法选项, 契约结果不携带分布
    smokeCurrentBody = smokeBodyChoiceNoneOk()
    var rn = jev.JevDecide(jev.JevCredentials(apiKey: "smoke-explicit-test-key-never-sent"), smokeChoiceSpec(smokeBuildGraph(), true), smokeTransportOk)
    let rnOk = IsOk(rn)
    let rnMsg = Error(rn)
    smokeCheckOk("decide-choice-no-match-ok", rnOk, rnMsg)
    let outcomeNone = Value(rn)
    smokeExpectBool("result-no-match", outcomeNone.result.noMatch, true)
    smokeExpectI32("result-no-match-probs-empty", outcomeNone.result.probs.len, 0)
    smokeExpectI32("result-no-match-chosen", outcomeNone.result.chosenCandidate, dc.CsgDecisionChosenNone)
    var gNone = smokeBuildGraph()
    var resNone: dc.CsgDecisionLearnResult
    resNone = outcomeNone.result
    dc.CsgDecisionLearnResultAdd(gNone, resNone)
    let gvNone = dv.DecisionValidateGraph(share(gNone))
    let gvNoneOk = IsOk(gvNone)
    let gvNoneMsg = Error(gvNone)
    smokeCheckOk("graph-with-jev-no-match-result-valid", gvNoneOk, gvNoneMsg)

    # Score 成功: 恒等等级 + 整数域加权值
    smokeCurrentBody = smokeBodyScoreOk()
    var rs = jev.JevDecide(jev.JevCredentials(apiKey: "smoke-explicit-test-key-never-sent"), smokeScoreSpec(smokeBuildGraph()), smokeTransportOk)
    let rsOk = IsOk(rs)
    let rsMsg = Error(rs)
    smokeCheckOk("decide-score-ok", rsOk, rsMsg)
    let outcomeScore = Value(rs)
    smokeExpectI32("score-probs-count", outcomeScore.result.probs.len, 2)
    let want250000: int64 = 250000
    let want750000: int64 = 750000
    smokeExpectI64("score-prob-0-numer", outcomeScore.result.probs[0].numer, want250000)
    smokeExpectI64("score-prob-1-numer", outcomeScore.result.probs[1].numer, want750000)
    smokeExpectI32("score-rank-0", outcomeScore.result.ranks[0], 0)
    smokeExpectI32("score-rank-1", outcomeScore.result.ranks[1], 1)
    smokeExpectI64("score-weighted-numer", outcomeScore.result.weighted.numer, want750000)
    var gScore = smokeBuildGraph()
    var resScore: dc.CsgDecisionLearnResult
    resScore = outcomeScore.result
    dc.CsgDecisionLearnResultAdd(gScore, resScore)
    let gvScore = dv.DecisionValidateGraph(share(gScore))
    let gvScoreOk = IsOk(gvScore)
    let gvScoreMsg = Error(gvScore)
    smokeCheckOk("graph-with-jev-score-result-valid", gvScoreOk, gvScoreMsg)

    # Noul 成功: 单概率, 无候选
    smokeCurrentBody = smokeBodyNoulOk()
    var rnu = jev.JevDecide(jev.JevCredentials(apiKey: "smoke-explicit-test-key-never-sent"), smokeNoulSpec(smokeBuildGraph()), smokeTransportOk)
    let rnuOk = IsOk(rnu)
    let rnuMsg = Error(rnu)
    smokeCheckOk("decide-noul-ok", rnuOk, rnuMsg)
    let outcomeNoul = Value(rnu)
    smokeExpectI32("noul-probs-count", outcomeNoul.result.probs.len, 1)
    let want420000: int64 = 420000
    smokeExpectI64("noul-prob-numer", outcomeNoul.result.probs[0].numer, want420000)
    smokeExpectI32("noul-chosen-none", outcomeNoul.result.chosenCandidate, dc.CsgDecisionChosenNone)
    smokeExpectI64("noul-metrics-input-tokens", outcomeNoul.metrics.inputTokens, 7)
    var gNoul = smokeBuildGraph()
    var resNoul: dc.CsgDecisionLearnResult
    resNoul = outcomeNoul.result
    dc.CsgDecisionLearnResultAdd(gNoul, resNoul)
    let gvNoul = dv.DecisionValidateGraph(share(gNoul))
    let gvNoulOk = IsOk(gvNoul)
    let gvNoulMsg = Error(gvNoul)
    smokeCheckOk("graph-with-jev-noul-result-valid", gvNoulOk, gvNoulMsg)

fn main(): int32 =
    # ---- fixture 图合法性先决门 ----
    let g = smokeBuildGraph()
    let gv = dv.DecisionValidateGraph(share(g))
    let gvOk = IsOk(gv)
    let gvMsg = Error(gv)
    smokeCheckOk("fixture-graph-valid", gvOk, gvMsg)

    smokeMainRequestMapping()

    var frB = jev.JevFreezeRequest(smokeChoiceSpec(smokeBuildGraph(), false))
    let frBOk = IsOk(frB)
    let frBMsg = Error(frB)
    smokeCheckOk("freeze-choice-response-gate", frBOk, frBMsg)
    smokeMainResponseGate(Value(frB))

    smokeMainStateMachine()

    smokeMainSuccessPaths()

    # ---- (f) 「未测」诚实报告入口 ----
    smokeExpectStr("real-call-verification-status", jev.JevRealCallVerificationStatus(), "NotTested")
    echo("smoke ok: 真实 Jev 调用验证状态 = NotTested (无凭据/预算授权, 未发起任何真实网络调用)")

    echo("decision_jev_smoke ok")
    return 0
