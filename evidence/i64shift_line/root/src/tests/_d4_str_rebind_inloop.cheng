import std/system as system

# D4 str-rebind refined LOOP variant: the SAME two rebinds, but inside the
# caller's loop body (rebind executes per iteration in a loop-carried local).
# rounds=50, exact bucket.

var probeSink: int32

fn RepeatStrInLoop(rounds: int32): int32 =
    var s: str = Fmt"seed"
    var acc: int32
    var r: int32
    while r < rounds:
        acc = acc + s.len
        s = Fmt"{Int32(r)}-{s}"
        r = r + 1
    return acc + s.len

fn main(): int32 =
    let before = system.MemLiveAllocations()
    let observed = RepeatStrInLoop(50)
    let delta = system.MemLiveAllocations() - before
    probeSink = observed
    if observed <= 0:
        return 99
    if delta <= 0:
        return 0
    if delta > 199:
        return 199
    return int32(delta)
