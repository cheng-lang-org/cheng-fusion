# smoke for frame + board (return-length chaining)
import "src/mosaico/frame.cheng" as frame
import "src/mosaico/board.cheng" as board

# each Case uses its own locals; one mutating entry per buffer

fn CaseBasics(): int32 =
    var fails = 0
    if board.AddrBmi270 != 0x69 or board.AddrCst9220 != 0x5A:
        fails = fails | 1
    if board.PinStatusLed != 3 or board.PinAiButton != 7 or board.PinVibrationMotor != 8:
        fails = fails | 2
    if board.PinSystemRailCtrl != 60 or board.PinCodecPower != 56:
        fails = fails | 4
    if board.LcdWidthPx != 480 or board.LcdHeightPx != 480:
        fails = fails | 8
    return fails

fn CasePutGet(): int32 =
    var buf: uint8[frame.FrameCap]
    var n = 0
    n = frame.FramePut16Le(buf, n, 0x1234)
    n = frame.FramePut16Be(buf, n, 0xABCD)
    n = frame.FramePut8(buf, n, uint8(0x7F))
    if n != 5:
        return 1
    if frame.FrameGet16Le(buf, n, 0) != 0x1234:
        return 2
    if frame.FrameGet16Be(buf, n, 2) != 0xABCD:
        return 4
    if frame.FrameGet8(buf, n, 4) != 0x7F:
        return 8
    if frame.FrameGet16Le(buf, n, 4) != frame.FrameErrRange:
        return 16
    return 0

fn CaseSignExt(): int32 =
    var fails = 0
    if frame.S12FromRaw(0x0800) != -2048:
        fails = fails | 1
    if frame.S12FromRaw(0x07FF) != 2047:
        fails = fails | 2
    if frame.S16FromU16(0x8000) != -32768:
        fails = fails | 4
    if frame.S16FromU16(0x7FFF) != 32767:
        fails = fails | 8
    return fails

fn CaseOverflow(): int32 =
    var buf: uint8[frame.FrameCap]
    var n = frame.FrameCap
    let over = frame.FramePut8(buf, n, uint8(9))
    if over != frame.FrameErrOverflow:
        return 1
    let over2 = frame.FramePut16Le(buf, n - 1, 0xFFFF)
    if over2 != frame.FrameErrOverflow:
        return 2
    return 0

fn main(): int32 =
    var fails = 0
    fails = fails | CaseBasics()
    fails = fails | (CasePutGet() << 4)
    fails = fails | (CaseSignExt() << 10)
    fails = fails | (CaseOverflow() << 14)
    return fails
