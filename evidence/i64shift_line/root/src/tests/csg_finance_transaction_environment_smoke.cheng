import std/os as os
import std/result
import std/rawbytes
import std/crypto/sha256
import std/strings
import cheng/core/csg_core/validator as csg
import cheng/core/csg_finance/certified_transaction as cert
import cheng/core/csg_finance/transaction_environment as env

@borrows
fn smokeFail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

fn smokeExpect(cond: bool, message: str): int32 =
    if !cond:
        return smokeFail(message)
    return 0

fn smokeHash(text: str): str =
    let digest = sha256.Sha256Digest(rawbytes.BytesFromString(text))
    return strings.ConcatStr("sha256:", rawbytes.BytesToHex(digest))

fn smokeBuildEnvironment(): env.FinanceProductionTransactionEnvironment =
    var action = env.FinanceTypedAction(
        id: "action_pay_1",
        sourceKind: env.FinanceEnvSourceTypedAction,
        controlSurfaceId: "unimaker.pay.transfer",
        payloadSchemaHash: smokeHash("payload schema"),
        uiDisplayHash: smokeHash("ui shows bob 25 usdc"),
        userIntentHash: smokeHash("alice pays bob 25 usdc"),
        userId: "user_alice",
        actionKind: cert.FinanceActionInternalPayment,
        chainId: int64(8453),
        asset: "USDC",
        amount: int64(25),
        recipientIdentity: "did:unimaker:bob",
        recipientAddress: "0xbob",
        userAuthorized: true,
        aiGenerated: false,
        visualClickPath: false
    )
    var policy = cert.FinancePolicy(
        id: "policy_1",
        maxAmount: int64(50),
        allowedChainId: int64(8453),
        allowedAsset: "USDC",
        allowedRecipientIdentity: "did:unimaker:bob",
        allowedRecipientAddress: "0xbob",
        allowedContract: "0xunimakerpay",
        allowedSelector: "0xa9059cbb",
        validUntilBlock: int64(9000),
        maxSlippageBps: 0,
        riskLevel: cert.FinanceRiskLow,
        signerRequirement: cert.FinanceSignerSession,
        forbidApproveAll: true,
        forbidDelegatecall: true,
        allowUnknownContract: false,
        policyAuthorizationScheme: cert.FinancePolicyAuthClassicalMlDsa,
        rootAuthorizationScheme: cert.FinanceRootAuthSlhDsa,
        executionSignatureScheme: cert.FinanceExecutionSignatureChainNative
    )
    var policyReceipt = env.FinancePolicyReceipt(
        id: "policy_receipt_1",
        policy: policy,
        policyHash: cert.FinancePolicyHash(policy),
        policySourceHash: smokeHash("policy source"),
        policyVersionHash: smokeHash("policy version"),
        policyOwnerUserId: "user_alice",
        authorizationHash: smokeHash("policy authorization")
    )

    var snapshot = cert.FinanceStateSnapshot(
        id: "state_1",
        chainId: int64(8453),
        account: "0xalice",
        blockNumber: int64(8000),
        nonce: int64(7),
        balance: int64(100),
        allowance: int64(0),
        price: int64(1000000),
        stateReadsHash: smokeHash("state reads v1")
    )
    var stateReceipt = env.FinanceStateSnapshotReceipt(
        id: "state_receipt_1",
        snapshot: snapshot,
        blockHash: smokeHash("block 8000"),
        stateRootHash: smokeHash("state root 8000"),
        rpcProviderHash: smokeHash("rpc provider"),
        finality: env.FinanceEnvFinalitySafe,
        receiptHash: ""
    )
    stateReceipt.receiptHash = env.FinanceStateSnapshotReceiptHash(stateReceipt)

    var profile = cert.FinanceContractProfile(
        id: "contract_1",
        chainId: int64(8453),
        contractAddress: "0xunimakerpay",
        selector: "0xa9059cbb",
        selectorName: "transfer",
        abiHash: smokeHash("abi transfer(address,uint256)"),
        knownContract: true,
        unknownCall: false,
        containsDelegatecall: false,
        approveAll: false,
        supportsSimulation: true
    )
    var contractEntry = env.FinanceContractRegistryEntry(
        id: "registry_1",
        profile: profile,
        profileHash: cert.FinanceContractProfileHash(profile),
        registryVersionHash: smokeHash("registry version"),
        registryAuthorityHash: smokeHash("registry authority"),
        selectorPolicyHash: smokeHash("selector transfer allowed"),
        revoked: false,
        receiptHash: ""
    )
    contractEntry.receiptHash = env.FinanceContractRegistryEntryHash(contractEntry)

    let intent = env.FinanceIntentFromTypedAction(action)
    let intentHash = cert.FinanceIntentHash(intent)
    let policyHash = cert.FinancePolicyHash(policy)
    let stateHash = cert.FinanceStateSnapshotHash(snapshot)
    let contractHash = cert.FinanceContractProfileHash(profile)
    let payloadHash = smokeHash("chain-native payload v1")
    let calldataHash = smokeHash("calldata transfer bob 25")
    var payload = cert.FinanceSigningPayload(
        id: "payload_1",
        chainId: int64(8453),
        contractAddress: "0xunimakerpay",
        selector: "0xa9059cbb",
        calldataHash: calldataHash,
        payloadHash: payloadHash,
        intentHash: intentHash,
        policyHash: policyHash,
        stateSnapshotHash: stateHash,
        contractProfileHash: contractHash,
        validUntilBlock: int64(9000),
        maxSlippageBps: 0,
        stateReadsHash: snapshot.stateReadsHash,
        nonce: int64(7)
    )
    var payloadReceipt = env.FinancePayloadReceipt(
        id: "payload_receipt_1",
        payload: payload,
        builderId: "unimaker.chain-native.payload-builder",
        builderVersionHash: smokeHash("payload builder version"),
        typedActionHash: env.FinanceTypedActionHash(action),
        policyHash: policyHash,
        stateSnapshotHash: stateHash,
        contractProfileHash: contractHash,
        receiptHash: "",
        builderTrusted: true
    )
    payloadReceipt.receiptHash = env.FinancePayloadReceiptHash(payloadReceipt)

    var simulation = cert.FinanceSimulationResult(
        id: "sim_1",
        ok: true,
        payloadHash: payloadHash,
        calldataHash: calldataHash,
        stateReadsHash: snapshot.stateReadsHash,
        outputAsset: "USDC",
        outputAmount: int64(25),
        maxLossAmount: int64(25),
        error: ""
    )
    var simulationReceipt = env.FinanceSimulationReceipt(
        id: "simulation_receipt_1",
        simulation: simulation,
        engineId: "unimaker.simulator",
        engineVersionHash: smokeHash("simulator version"),
        stateSnapshotHash: stateHash,
        contractProfileHash: contractHash,
        payloadHash: payloadHash,
        requestHash: smokeHash("simulation request"),
        receiptHash: "",
        engineTrusted: true
    )
    simulationReceipt.receiptHash = env.FinanceSimulationReceiptHash(simulationReceipt)

    let signerDeviceBindingHash = smokeHash("device attestation")
    let signerIsolationHash = smokeHash("signer isolation")
    var signer = env.FinanceSignerSession(
        id: "session_signer_1",
        signerKind: cert.FinanceSignerSession,
        signerId: "secure-enclave-session-key-1",
        deviceBindingHash: signerDeviceBindingHash,
        sessionPolicyHash: smokeHash("session policy"),
        attestationHash: signerIsolationHash,
        hardwareBacked: true,
        expiresAtBlock: int64(9000),
        keyExportable: false,
        aiProcessAccessible: false
    )
    var substrate = env.FinanceExecutionSubstrate(
        id: "substrate_1",
        substrateKind: env.FinanceEnvSubstrateChengCsgTransactionOs,
        osIdentityHash: smokeHash("cheng csg transaction os identity"),
        kernelCapabilityHash: smokeHash("kernel capability profile"),
        processIsolationHash: smokeHash("process isolation profile"),
        signerIsolationHash: signerIsolationHash,
        memoryPolicyHash: smokeHash("memory policy"),
        networkPolicyHash: smokeHash("network rpc pinning"),
        uiTrustedPathHash: smokeHash("trusted ui path"),
        deviceAttestationHash: signerDeviceBindingHash,
        csgMeasurementHash: smokeHash("csg substrate measurement"),
        receiptHash: "",
        chengCsgKernel: true,
        capabilityRuntime: true,
        deterministicSyscalls: true,
        signerIsolated: true,
        aiProcessIsolated: true,
        uiTrustedPath: true,
        networkPinned: true,
        noDynamicCodeLoading: true,
        noVisualTransactionPath: true,
        noClipboardTransactionPath: true
    )
    substrate.receiptHash = env.FinanceExecutionSubstrateHash(substrate)

    return env.FinanceProductionTransactionEnvironment(
        typedAction: action,
        policyReceipt: policyReceipt,
        stateReceipt: stateReceipt,
        contractEntry: contractEntry,
        simulationReceipt: simulationReceipt,
        payloadReceipt: payloadReceipt,
        signerSession: signer,
        executionSubstrate: substrate
    )

fn smokeCompileMustFail(txEnv: env.FinanceProductionTransactionEnvironment, label: str): int32 =
    let res = env.FinanceCompileExecutionEnvelope(txEnv)
    if smokeExpect(IsErr(res), label) != 0:
        return 1
    return 0

fn smokeBroadcastMustFail(envelope: env.FinanceExecutionEnvelope,
                          signed: env.FinanceSignedTransactionReceipt,
                          adapter: env.FinanceChainAdapterProfile,
                          label: str): int32 =
    let res = env.FinanceBuildBroadcastRequest(envelope, signed, adapter, envelope.certified.validUntilBlock)
    if smokeExpect(IsErr(res), label) != 0:
        return 1
    return 0

fn main(): int32 =
    var txEnv = smokeBuildEnvironment()
    let envelopeRes = env.FinanceCompileExecutionEnvelope(txEnv)
    if smokeExpect(IsOk(envelopeRes), "production finance environment should compile") != 0:
        if IsErr(envelopeRes):
            os.WriteLine(os.Get_stderr(), Error(envelopeRes))
        return 1
    let envelope = Value(envelopeRes)
    if smokeExpect(envelope.certified.complete, "compiled environment should produce complete certificate") != 0:
        return 1
    let envelopeAgain = env.FinanceCompileExecutionEnvelope(txEnv)
    if smokeExpect(IsOk(envelopeAgain), "repeat environment compile should pass") != 0:
        return 1
    if smokeExpect(Value(envelopeAgain).environmentHash == envelope.environmentHash,
                   "environment hash must be deterministic") != 0:
        return 1

    var signed = env.FinanceSignedTransactionReceipt(
        id: "signed_tx_1",
        signerKind: cert.FinanceSignerSession,
        signerId: "secure-enclave-session-key-1",
        environmentHash: envelope.environmentHash,
        executionSubstrateHash: envelope.executionSubstrateHash,
        certifiedHash: envelope.certified.certifiedHash,
        payloadHash: envelope.certified.payloadHash,
        authorizationHash: envelope.authorization.authorizationHash,
        signedTransactionHash: smokeHash("signed transaction bytes"),
        signatureScheme: cert.FinanceExecutionSignatureChainNative,
        signerBoundary: env.FinanceEnvSignerBoundaryIsolated,
        keyExportable: false,
        aiProcessAccessible: false
    )
    var adapter = env.FinanceChainAdapterProfile(
        id: "base-chain-adapter",
        chainId: int64(8453),
        adapterKind: env.FinanceEnvChainAdapterNative,
        adapterVersionHash: smokeHash("adapter version"),
        supportedSignatureScheme: cert.FinanceExecutionSignatureChainNative,
        broadcastPolicyHash: smokeHash("broadcast policy"),
        trustedAdapter: true,
        visualPath: false
    )
    let broadcastRes = env.FinanceBuildBroadcastRequest(envelope, signed, adapter, int64(8900))
    if smokeExpect(IsOk(broadcastRes), "valid signed transaction should build broadcast request") != 0:
        if IsErr(broadcastRes):
            os.WriteLine(os.Get_stderr(), Error(broadcastRes))
        return 1
    if smokeExpect(Value(broadcastRes).requestHash.len > 7, "broadcast request must have hash") != 0:
        return 1

    var aiEnv = txEnv
    aiEnv.typedAction.aiGenerated = true
    if smokeCompileMustFail(aiEnv, "AI generated action must fail") != 0:
        return 1

    var visualEnv = txEnv
    visualEnv.typedAction.visualClickPath = true
    if smokeCompileMustFail(visualEnv, "visual click transaction path must fail") != 0:
        return 1

    var badStateEnv = txEnv
    badStateEnv.stateReceipt.receiptHash = smokeHash("wrong state receipt")
    if smokeCompileMustFail(badStateEnv, "state receipt hash mismatch must fail") != 0:
        return 1

    var revokedEnv = txEnv
    revokedEnv.contractEntry.revoked = true
    revokedEnv.contractEntry.receiptHash = env.FinanceContractRegistryEntryHash(revokedEnv.contractEntry)
    if smokeCompileMustFail(revokedEnv, "revoked contract entry must fail") != 0:
        return 1

    var untrustedSimEnv = txEnv
    untrustedSimEnv.simulationReceipt.engineTrusted = false
    untrustedSimEnv.simulationReceipt.receiptHash = env.FinanceSimulationReceiptHash(untrustedSimEnv.simulationReceipt)
    if smokeCompileMustFail(untrustedSimEnv, "untrusted simulation engine must fail") != 0:
        return 1

    var untrustedBuilderEnv = txEnv
    untrustedBuilderEnv.payloadReceipt.builderTrusted = false
    untrustedBuilderEnv.payloadReceipt.receiptHash = env.FinancePayloadReceiptHash(untrustedBuilderEnv.payloadReceipt)
    if smokeCompileMustFail(untrustedBuilderEnv, "untrusted payload builder must fail") != 0:
        return 1

    var exportableSignerEnv = txEnv
    exportableSignerEnv.signerSession.keyExportable = true
    if smokeCompileMustFail(exportableSignerEnv, "exportable signer key must fail") != 0:
        return 1

    var expiredSignerEnv = txEnv
    expiredSignerEnv.signerSession.expiresAtBlock = int64(8999)
    if smokeCompileMustFail(expiredSignerEnv, "signer expiring before transaction must fail") != 0:
        return 1

    var badSubstrateEnv = txEnv
    badSubstrateEnv.executionSubstrate.networkPinned = false
    badSubstrateEnv.executionSubstrate.receiptHash = env.FinanceExecutionSubstrateHash(badSubstrateEnv.executionSubstrate)
    if smokeCompileMustFail(badSubstrateEnv, "unpinned execution substrate network must fail") != 0:
        return 1

    var unboundSubstrateEnv = txEnv
    unboundSubstrateEnv.signerSession.attestationHash = smokeHash("different signer isolation")
    if smokeCompileMustFail(unboundSubstrateEnv, "signer attestation not bound to substrate must fail") != 0:
        return 1

    var badSigned = signed
    badSigned.payloadHash = smokeHash("wrong payload")
    if smokeBroadcastMustFail(envelope, badSigned, adapter, "signed transaction payload mismatch must fail") != 0:
        return 1

    var badSignedSigner = signed
    badSignedSigner.signerId = "wrong-signer"
    if smokeBroadcastMustFail(envelope, badSignedSigner, adapter, "signed transaction signer id mismatch must fail") != 0:
        return 1

    var badSignedSubstrate = signed
    badSignedSubstrate.executionSubstrateHash = smokeHash("wrong substrate")
    if smokeBroadcastMustFail(envelope, badSignedSubstrate, adapter, "signed transaction substrate mismatch must fail") != 0:
        return 1

    var badAdapter = adapter
    badAdapter.trustedAdapter = false
    if smokeBroadcastMustFail(envelope, signed, badAdapter, "untrusted chain adapter must fail") != 0:
        return 1

    var visualAdapter = adapter
    visualAdapter.visualPath = true
    if smokeBroadcastMustFail(envelope, signed, visualAdapter, "visual broadcast path must fail") != 0:
        return 1

    let lateBroadcast = env.FinanceBuildBroadcastRequest(envelope, signed, adapter, int64(9001))
    if smokeExpect(IsErr(lateBroadcast), "broadcast after certified validity must fail") != 0:
        return 1

    let schemaFact = "{\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\",\"features\":[\"core-facts\",\"finance\"]}"
    let typedActionFact = "{\"kind\":\"csg_dialect::finance::typed_action\",\"id\":\"action_1\",\"sourceKind\":\"typed_action\",\"controlSurfaceId\":\"unimaker.pay.transfer\",\"payloadSchemaHash\":\"sha256:schema\",\"uiDisplayHash\":\"sha256:ui\",\"userIntentHash\":\"sha256:intent\",\"userId\":\"user_alice\",\"actionKind\":\"internal_payment\",\"chainId\":8453,\"asset\":\"USDC\",\"amount\":25,\"recipientIdentity\":\"did:unimaker:bob\",\"recipientAddress\":\"0xbob\",\"userAuthorized\":true,\"aiGenerated\":false,\"visualClickPath\":false}"
    let substrateFact = "{\"kind\":\"csg_dialect::finance::execution_substrate\",\"id\":\"substrate_1\",\"substrateKind\":\"cheng-csg-transaction-os\",\"osIdentityHash\":\"sha256:os\",\"kernelCapabilityHash\":\"sha256:kernel\",\"processIsolationHash\":\"sha256:process\",\"signerIsolationHash\":\"sha256:signer\",\"memoryPolicyHash\":\"sha256:memory\",\"networkPolicyHash\":\"sha256:network\",\"uiTrustedPathHash\":\"sha256:ui\",\"deviceAttestationHash\":\"sha256:device\",\"csgMeasurementHash\":\"sha256:csg\",\"receiptHash\":\"sha256:receipt\",\"chengCsgKernel\":true,\"capabilityRuntime\":true,\"deterministicSyscalls\":true,\"signerIsolated\":true,\"aiProcessIsolated\":true,\"uiTrustedPath\":true,\"networkPinned\":true,\"noDynamicCodeLoading\":true,\"noVisualTransactionPath\":true,\"noClipboardTransactionPath\":true}"
    let broadcastFact = "{\"kind\":\"csg_dialect::finance::broadcast_request\",\"id\":\"broadcast_1\",\"chainId\":8453,\"environmentHash\":\"sha256:env\",\"executionSubstrateHash\":\"sha256:substrate\",\"certifiedHash\":\"sha256:cert\",\"payloadHash\":\"sha256:payload\",\"authorizationHash\":\"sha256:auth\",\"signedTransactionHash\":\"sha256:signed\",\"chainAdapterId\":\"base-chain-adapter\",\"chainAdapterVersionHash\":\"sha256:adapter\",\"maxSubmitBlock\":8900,\"broadcastPolicyHash\":\"sha256:broadcast\",\"requestHash\":\"sha256:request\"}"
    var financeLines: str[]
    add(financeLines, schemaFact)
    add(financeLines, typedActionFact)
    add(financeLines, substrateFact)
    add(financeLines, broadcastFact)
    let financeValidation = csg.CsgCoreValidateFactLines(financeLines, csg.CsgCoreModeStrict)
    if smokeExpect(financeValidation.valid, "finance environment facts should validate structurally") != 0:
        for i in 0..<financeValidation.errors.len:
            os.WriteLine(os.Get_stderr(), financeValidation.errors[i])
        return 1
    if smokeExpect(
           csg.CsgCoreProfilesEqual(
               financeValidation.profiles,
               [
                   csg.CsgCoreBaseProfileIdentity(),
                   cert.FinanceDialectProfile
               ]),
           "finance environment profile set should be detected") != 0:
        return 1

    os.WriteLine(os.Get_stdout(), "csg_finance_transaction_environment_smoke ok")
    return 0
