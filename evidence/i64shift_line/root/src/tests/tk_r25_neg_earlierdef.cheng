fn R25Tag(raw: str): str =
    if raw.len > 3:
        return "long"
    return "short"

fn R25Multi(n: int32): int32 =
    var guard = 0
    defer:
        guard = guard + 1
    var e = R25Tag("abcdef")
    if n == 1:
        return e.len
    e = R25Tag("ab")
    return e.len + guard

fn main(): int32 =
    if R25Multi(1) != 4:
        return 10
    echo("neg earlierdef reached")
    return 0
