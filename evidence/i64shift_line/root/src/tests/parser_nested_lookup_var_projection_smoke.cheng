import cheng/core/lang/parser as parser

type ProbeTextSet =
    lookup: parser.ParserTextLookup
    emptySeen: bool

fn CompilerCsgTextSetInit(minCap: int32): ProbeTextSet =
    var out: ProbeTextSet
    out.lookup = parser.ParserTextLookupInit(minCap)
    return out

@borrows
fn CompilerCsgTextSetInsert(set: var ProbeTextSet, text: str): bool =
    return parser.ParserTextLookupInsertExact(set.lookup, text)

fn main() =
    var set = CompilerCsgTextSetInit(32)
    assert(set.lookup.slots.len == 32 &&
           set.lookup.buckets.len == 0 &&
           set.lookup.totalCount == 0,
           "parser nested lookup: init layout")
    assert(CompilerCsgTextSetInsert(set, "hello.cheng"),
           "parser nested lookup: insert")
    assert(set.lookup.slots.len == 32 &&
           set.lookup.buckets.len == 1 &&
           set.lookup.buckets[0].items.len == 1 &&
           set.lookup.totalCount == 1,
           Fmt"parser nested lookup: projection writeback slots={set.lookup.slots.len} buckets={set.lookup.buckets.len} items={set.lookup.buckets[0].items.len} total={set.lookup.totalCount}")
    set = ProbeTextSet()
    echo("parser_nested_lookup_var_projection=PASS")
