fn PathMatches(path: var str, expected: str): bool =
    return path == expected

fn SetError(outErr: var str, message: str): bool =
    outErr = message
    return true

fn CheckPath(input: str): bool =
    var path = input
    var err = ""
    if !PathMatches(path, "accepted"):
        let _ = SetError(err, "rejected")
        return false
    return err == ""

fn main(): int32 =
    if !CheckPath("accepted"):
        return 1
    if CheckPath("rejected"):
        return 2
    return 0
