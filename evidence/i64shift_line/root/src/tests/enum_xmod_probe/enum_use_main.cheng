import cheng/quic/core/packet_header_model

fn pickType(code: int32): packet_header_model.QuicPacketType =
    if code == 10:
        return packet_header_model.quicPacketTypeFromBits(1)
    return packet_header_model.quicPacketTypeFromBits(0)

fn main(): int32 =
    let t = pickType(10)
    return 0
