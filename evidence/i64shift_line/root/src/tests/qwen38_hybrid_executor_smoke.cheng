import std/result
import std/strings
import std/strutils as strutil
import cheng/inference/hf_qwen38_graph as hfq
import cheng/inference/model_graph as mg
import cheng/inference/qwen38_hybrid_executor as hx

fn qwen38VisionConfigChunk(): str =
    return strutil.Join([
        "\"vision_config\":{",
        "\"deepstack_visual_indexes\":[],",
        "\"depth\":27,",
        "\"hidden_act\":\"gelu_pytorch_tanh\",",
        "\"hidden_size\":1152,",
        "\"in_channels\":3,",
        "\"initializer_range\":0.02,",
        "\"intermediate_size\":4304,",
        "\"model_type\":\"qwen3_5\",",
        "\"num_heads\":16,",
        "\"num_position_embeddings\":2304,",
        "\"out_hidden_size\":5120,",
        "\"patch_size\":16,",
        "\"spatial_merge_size\":2,",
        "\"temporal_patch_size\":2",
        "},"
    ], "")

fn qwen38ConfigJson(): str =
    var layerItems: str[]
    for i in 0..<64:
        var word = "linear_attention"
        if (i + 1) % 4 == 0:
            word = "full_attention"
        add(layerItems, strutil.Join(["\"", share(word), "\""], ""))
    return strutil.Join([
        "{",
        "\"architectures\":[\"Qwen3_5ForConditionalGeneration\"],",
        "\"image_token_id\":248056,",
        "\"language_model_only\":false,",
        "\"model_type\":\"qwen3_5\",",
        "\"text_config\":{",
        "\"attention_bias\":false,",
        "\"attention_dropout\":0.0,",
        "\"attn_output_gate\":true,",
        "\"bos_token_id\":248044,",
        "\"dtype\":\"bfloat16\",",
        "\"eos_token_id\":248044,",
        "\"full_attention_interval\":4,",
        "\"head_dim\":256,",
        "\"hidden_act\":\"silu\",",
        "\"hidden_size\":5120,",
        "\"initializer_range\":0.02,",
        "\"intermediate_size\":17408,",
        "\"layer_types\":[", strutil.Join(layerItems, ","), "],",
        "\"linear_conv_kernel_dim\":4,",
        "\"linear_key_head_dim\":128,",
        "\"linear_num_key_heads\":16,",
        "\"linear_num_value_heads\":48,",
        "\"linear_value_head_dim\":128,",
        "\"mamba_ssm_dtype\":\"float32\",",
        "\"max_position_embeddings\":262144,",
        "\"model_type\":\"qwen3_5_text\",",
        "\"mtp_num_hidden_layers\":1,\"mtp_use_dedicated_embeddings\":false,",
        "\"num_attention_heads\":24,",
        "\"num_hidden_layers\":64,",
        "\"num_key_value_heads\":4,",
        "\"output_gate_type\":\"swish\",",
        "\"pad_token_id\":null,",
        "\"partial_rotary_factor\":0.25,",
        "\"rms_norm_eps\":1e-06,",
        "\"rope_parameters\":{\"mrope_interleaved\":true,\"mrope_section\":[11,11,10],\"partial_rotary_factor\":0.25,\"rope_theta\":10000000,\"rope_type\":\"default\"},",
        "\"tie_word_embeddings\":false,",
        "\"use_cache\":true,",
        "\"vocab_size\":248320,",
        "\"transformers_version\":\"5.8.0.dev0\",",
        "\"video_token_id\":248057,",
        qwen38VisionConfigChunk(),
        "\"vision_end_token_id\":248054,",
        "\"vision_start_token_id\":248053",
        "}"
    ], "")

fn splitHi(v: int64): int32 =
    var t: int64 = v
    if t < int64(0):
        t = int64(0) - t
    return int32(t / int64(1000000))

fn splitLo(v: int64): int32 =
    var t: int64 = v
    if t < int64(0):
        t = int64(0) - t
    return int32(t % int64(1000000))

fn signedPrefix(v: int64): str =
    if v < int64(0):
        return "-"
    return ""

@borrows
fn stripMtpPieces(graph: mg.ModelGraph): mg.ModelGraph =
    var weights: mg.ModelWeightShard[]
    for i in 0..<graph.weights.len:
        let w = graph.weights[i]
        if w.tensorName == "model.mtp.eh_proj.weight":
            continue
        var shapeCopy: int32[]
        for j in 0..<w.shape.len:
            add(shapeCopy, w.shape[j])
        add(weights, mg.ModelWeightShard(
            modelCid: strings.CloneStr(w.modelCid),
            shardCid: strings.CloneStr(w.shardCid),
            tensorName: strings.CloneStr(w.tensorName),
            dtype: strings.CloneStr(w.dtype),
            quantScheme: strings.CloneStr(w.quantScheme),
            shape: shapeCopy,
            sizeBytes: w.sizeBytes,
            expectedPayloadHash: w.expectedPayloadHash
        ))
    var ops: mg.ModelGraphOp[]
    for i in 0..<graph.ops.len:
        let op = graph.ops[i]
        if op.opKind == mg.InferenceModelOpMtpProject:
            continue
        var inputCopy: str[]
        for j in 0..<op.inputNames.len:
            add(inputCopy, strings.CloneStr(op.inputNames[j]))
        var weightCopy: str[]
        for j in 0..<op.weightNames.len:
            add(weightCopy, strings.CloneStr(op.weightNames[j]))
        add(ops, mg.ModelGraphOp(
            opKind: strings.CloneStr(op.opKind),
            inputNames: inputCopy,
            outputName: strings.CloneStr(op.outputName),
            weightNames: weightCopy,
            layerIndex: op.layerIndex,
            expertId: op.expertId
        ))
    var tensors: mg.ModelTensorDesc[]
    for i in 0..<graph.tensors.len:
        let t = graph.tensors[i]
        var tensorShape: int32[]
        for j in 0..<t.shape.len:
            add(tensorShape, t.shape[j])
        add(tensors, mg.ModelTensorDesc(
            name: strings.CloneStr(t.name),
            dtype: strings.CloneStr(t.dtype),
            shape: tensorShape,
            quantScheme: strings.CloneStr(t.quantScheme)
        ))
    var out = mg.ModelGraph(
        schema: strings.CloneStr(graph.schema),
        modelCid: strings.CloneStr(graph.modelCid),
        architecture: strings.CloneStr(graph.architecture),
        hiddenSize: graph.hiddenSize,
        attentionHeads: graph.attentionHeads,
        keyValueHeads: graph.keyValueHeads,
        headDim: graph.headDim,
        layerCount: graph.layerCount,
        expertCount: graph.expertCount,
        topK: graph.topK,
        mtpLayerCount: graph.mtpLayerCount,
        mtpStartLayer: graph.mtpStartLayer,
        ropeTheta: graph.ropeTheta,
        tensors: tensors,
        weights: weights,
        ops: ops,
        graphHash: int64(0)
    )
    out.graphHash = mg.ModelGraphHash(out)
    return out

fn main(): int32 =
    let configJson = qwen38ConfigJson()
    let profileRes = hfq.HfQwen38DeployProfileFromConfig(hfq.HfQwen38RepoId, share(configJson))
    assert(IsOk(profileRes), " qwen38 hybrid executor smoke: build deploy profile")
    let profile = Value(profileRes)

    let planRes = hx.Qwen38HybridLayerPlanBuild(share(profile))
    assert(IsOk(planRes), " qwen38 hybrid executor smoke: build layer plan")
    let plan = Value(planRes)

    assert(plan.schema == "cheng.inference.qwen38_hybrid_executor.v1",
           " qwen38 hybrid executor smoke: plan schema")
    assert(plan.layerCount == 64, " qwen38 hybrid executor smoke: plan layer count")
    assert(plan.fullAttentionInterval == 4, " qwen38 hybrid executor smoke: plan interval")
    assert(plan.fullLayerCount == 16, " qwen38 hybrid executor smoke: plan full count")
    var fullSeen: int32 = 0
    var firstFull: int32 = -1
    var lastFull: int32 = -1
    for i in 0..<64:
        assert(plan.layerIndex[i] == i, " qwen38 hybrid executor smoke: layer index identity")
        let atFullSlot = ((i + 1) % 4) == 0
        if plan.isFullAttention[i]:
            assert(atFullSlot, " qwen38 hybrid executor smoke: full slot placement")
            fullSeen = fullSeen + 1
            if firstFull < 0:
                firstFull = i
            lastFull = i
        else:
            assert(!atFullSlot, " qwen38 hybrid executor smoke: linear slot placement")
        assert(plan.fullIntervalPos[i] == i % 4, " qwen38 hybrid executor smoke: interval pos")
    assert(fullSeen == 16, " qwen38 hybrid executor smoke: full seen count")
    assert(firstFull == 3 && lastFull == 63, " qwen38 hybrid executor smoke: full boundary indices")
    assert(plan.isFullAttention[3] && plan.isFullAttention[7] &&
           plan.isFullAttention[11] && plan.isFullAttention[15] &&
           plan.isFullAttention[19] && plan.isFullAttention[23] &&
           plan.isFullAttention[27] && plan.isFullAttention[31] &&
           plan.isFullAttention[35] && plan.isFullAttention[39] &&
           plan.isFullAttention[43] && plan.isFullAttention[47] &&
           plan.isFullAttention[51] && plan.isFullAttention[55] &&
           plan.isFullAttention[59] && plan.isFullAttention[63],
           " qwen38 hybrid executor smoke: full layers at 1-based 4,8,...,64")
    assert(!plan.isFullAttention[0] && !plan.isFullAttention[1] &&
           !plan.isFullAttention[2] && !plan.isFullAttention[62],
           " qwen38 hybrid executor smoke: leading and pre-tail linear layers")
    echo(strutil.Join(["hybrid_exec_smoke: dispatch layer_count=",
                       strings.IntToStr(plan.layerCount), " linear_count=48 full_count=",
                       strings.IntToStr(plan.fullLayerCount), " interval=",
                       strings.IntToStr(plan.fullAttentionInterval),
                       " first_full_idx=", strings.IntToStr(firstFull),
                       " last_full_idx=", strings.IntToStr(lastFull)], ""))

    let graphRes = hfq.HfQwen38GraphBuildFromProfile(share(profile), "cid:model:qwen3.8-27b-w7-hybrid-exec-smoke")
    assert(IsOk(graphRes), " qwen38 hybrid executor smoke: build model graph")
    let graph = Value(graphRes)

    let fwdOk = hx.Qwen38HybridForwardPlanValidate(plan, graph)
    assert(IsOk(fwdOk) && Value(fwdOk), " qwen38 hybrid executor smoke: forward plan validate positive")

    let mtpOk = hx.Qwen38MtpDraftStepContract(graph, 5120, 248320, "model.embed_tokens.weight", false)
    assert(IsOk(mtpOk) && Value(mtpOk), " qwen38 hybrid executor smoke: mtp contract positive")
    assert(IsErr(hx.Qwen38MtpDraftStepContract(graph, 4096, 248320, "model.embed_tokens.weight", false)),
           " qwen38 hybrid executor smoke: mtp contract wrong last hidden hard fail")
    assert(IsErr(hx.Qwen38MtpDraftStepContract(graph, 5120, 248320, "model.embed_tokens.weight.tampered", false)),
           " qwen38 hybrid executor smoke: mtp contract wrong embedding binding hard fail")
    assert(IsErr(hx.Qwen38MtpDraftStepContract(graph, 5120, 248320, "model.embed_tokens.weight", true)),
           " qwen38 hybrid executor smoke: mtp contract dedicated embedding hard fail")

    let stripped = stripMtpPieces(graph)
    let strippedValid = mg.ModelGraphValidate(stripped)
    assert(IsOk(strippedValid), " qwen38 hybrid executor smoke: stripped graph structurally valid")
    let mtpStripped = hx.Qwen38MtpDraftStepContract(stripped, 5120, 248320, "model.embed_tokens.weight", false)
    assert(IsErr(mtpStripped) &&
           Error(mtpStripped) == "qwen38 hybrid executor mtp contract: missing weight model.mtp.eh_proj.weight",
           " qwen38 hybrid executor smoke: deleted mtp weight hard fail")

    var kvHashes: int64[]
    var deltaHashes: int64[]
    for i in 0..<64:
        add(kvHashes, hx.Qwen38HybridExecutorHashStep(int64(424242), int64(i * 2 + 1)))
        add(deltaHashes, hx.Qwen38HybridExecutorHashStep(int64(424242), int64(i * 2 + 2)))
    let traceARes = hx.Qwen38HybridExecutionTraceBuild(plan, kvHashes, deltaHashes)
    assert(IsOk(traceARes), " qwen38 hybrid executor smoke: trace build")
    let traceA = Value(traceARes)
    assert(traceA.layerCount == 64, " qwen38 hybrid executor smoke: trace layer count")
    let traceAOk = hx.Qwen38HybridExecutionTraceValidate(traceA)
    assert(IsOk(traceAOk) && Value(traceAOk), " qwen38 hybrid executor smoke: trace validate")
    for i in 0..<64:
        if plan.isFullAttention[i]:
            assert(traceA.layerKindCode[i] == hx.Qwen38HybridLayerKindFull,
                   " qwen38 hybrid executor smoke: trace full kind")
        else:
            assert(traceA.layerKindCode[i] == hx.Qwen38HybridLayerKindGdn,
                   " qwen38 hybrid executor smoke: trace gdn kind")
        assert(traceA.kvStateHash[i] == kvHashes[i], " qwen38 hybrid executor smoke: trace kv hash record")
        assert(traceA.deltaStateHash[i] == deltaHashes[i], " qwen38 hybrid executor smoke: trace delta hash record")
    let traceBRes = hx.Qwen38HybridExecutionTraceBuild(plan, kvHashes, deltaHashes)
    assert(IsOk(traceBRes), " qwen38 hybrid executor smoke: trace rebuild")
    let traceB = Value(traceBRes)
    assert(traceB.traceHash == traceA.traceHash, " qwen38 hybrid executor smoke: trace hash stable")

    var deltaPerturbed: int64[]
    for i in 0..<64:
        add(deltaPerturbed, deltaHashes[i])
    deltaPerturbed[10] = deltaPerturbed[10] + int64(1)
    let traceCRes = hx.Qwen38HybridExecutionTraceBuild(plan, kvHashes, deltaPerturbed)
    assert(IsOk(traceCRes), " qwen38 hybrid executor smoke: perturbed trace build")
    let traceC = Value(traceCRes)
    assert(traceC.traceHash != traceA.traceHash, " qwen38 hybrid executor smoke: trace hash sensitive")

    var kvZeroed: int64[]
    for i in 0..<64:
        add(kvZeroed, kvHashes[i])
    kvZeroed[5] = int64(0)
    assert(IsErr(hx.Qwen38HybridExecutionTraceBuild(plan, kvZeroed, deltaHashes)),
           " qwen38 hybrid executor smoke: zero kv state hash hard fail")
    echo(strutil.Join(["hybrid_exec_smoke: trace_hash=", signedPrefix(traceA.traceHash),
                       strings.IntToStr(splitHi(traceA.traceHash)),
                       strings.IntToStr(splitLo(traceA.traceHash))], ""))

    var pneg = plan
    pneg.layerCount = 63
    let negLayers = hx.Qwen38HybridForwardPlanValidate(pneg, graph)
    assert(IsErr(negLayers) && Error(negLayers) == "qwen38 hybrid executor plan: layer array length",
           " qwen38 hybrid executor smoke: plan layer count mismatch hard fail")
    pneg.layerCount = 64
    pneg.fullAttentionInterval = 5
    let negInterval = hx.Qwen38HybridForwardPlanValidate(pneg, graph)
    assert(IsErr(negInterval) && Error(negInterval) == "qwen38 hybrid executor plan: full attention interval",
           " qwen38 hybrid executor smoke: plan interval wrong hard fail")
    pneg.fullAttentionInterval = 4
    pneg.isFullAttention[10] = true
    let negSpacing = hx.Qwen38HybridForwardPlanValidate(pneg, graph)
    assert(IsErr(negSpacing) && Error(negSpacing) == "qwen38 hybrid executor plan: full layer spacing",
           " qwen38 hybrid executor smoke: plan spacing tamper hard fail")
    pneg.isFullAttention[10] = false
    let negRestored = hx.Qwen38HybridForwardPlanValidate(pneg, graph)
    assert(IsOk(negRestored) && Value(negRestored), " qwen38 hybrid executor smoke: restored plan validates")

    var probe = graph
    probe.layerCount = 63
    probe.graphHash = mg.ModelGraphHash(probe)
    assert(IsErr(hx.Qwen38HybridForwardPlanValidate(pneg, probe)),
           " qwen38 hybrid executor smoke: graph layer count mismatch hard fail")
    probe.layerCount = 64
    probe.hiddenSize = 4096
    probe.graphHash = mg.ModelGraphHash(probe)
    let negHidden = hx.Qwen38HybridForwardPlanValidate(pneg, probe)
    assert(IsErr(negHidden) && Error(negHidden) == "qwen38 hybrid executor plan: graph hidden size",
           " qwen38 hybrid executor smoke: graph hidden size mismatch hard fail")
    probe.hiddenSize = 5120
    probe.mtpLayerCount = 2
    probe.graphHash = mg.ModelGraphHash(probe)
    assert(IsErr(hx.Qwen38HybridForwardPlanValidate(pneg, probe)),
           " qwen38 hybrid executor smoke: graph mtp layers hard fail")
    probe.mtpLayerCount = 1
    probe.graphHash = mg.ModelGraphHash(probe)
    let posRestored = hx.Qwen38HybridForwardPlanValidate(pneg, probe)
    assert(IsOk(posRestored) && Value(posRestored), " qwen38 hybrid executor smoke: restored graph validates")

    echo(" qwen38_hybrid_executor_smoke ok")
    return 0
