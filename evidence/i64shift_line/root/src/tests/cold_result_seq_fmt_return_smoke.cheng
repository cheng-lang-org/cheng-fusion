fn buildStrings(index: int32): Result[str[]] =
    if index < 0:
        return Err[str[]](Fmt"invalid index={index}")
    var values: str[]
    add(values, "ok")
    return Ok[str[]](values)

fn main(): int32 =
    let valuesRes = buildStrings(0)
    if !IsOk(valuesRes):
        return 1
    let values = Value(valuesRes)
    if values.len != 1 || values[0] != "ok":
        return 2
    return 0
