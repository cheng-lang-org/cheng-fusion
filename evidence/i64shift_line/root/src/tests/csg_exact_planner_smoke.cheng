# CSG 精确规划器冒烟(任务 07 首切片 verify a-h)。
#
# a. 小域独立穷举对拍:独立 DFS oracle(逐路径去环,深度界 ≥ 域状态数)
#    穷举全部合法动作序列,与 BFS/Dijkstra 的最优代价逐一对拍(A/B/C/I/J/K 六域)
# b. 带环图(B 域 toggle 来回)必须终止且解正确
# c. 零权+正权混合:C 域 Dijkstra 选两跳廉价路径而非一跳昂贵路径,BFS 拒绝非均匀代价
# d. 不可达域:D 域穷尽后 Unreachable(与 BudgetExceeded 可区分)
# e. 未知状态变量:E1 初始目标未知 / E2 必要前置未知 → NeedEvidence;
#    E3 存在无关于未知证据的路径时仍 GoalReached
# f. 强制哈希碰撞注入:退化常数指纹下解不受污染(B/C 域逐位对拍)
# g. 预算耗尽:状态预算(已访问状态数=预算值)与边预算(扩展边数=预算值)分立可断言
# h. 动作缺读写集声明 → 准入拒绝,rejectedAction 精确
#
# oracle 语义原语(谓词求值/效果施加)复用同一动作合同,但搜索策略
# (穷举 DFS)与规划器(BFS/Dijkstra)完全独立;非负代价下任何最优解
# 都有同代价的无环代表,故逐路径去环 + 深度界穷举即为精确 oracle。

import std/strings
import cheng/core/runtime/csg_goal as cgoal
import cheng/core/runtime/csg_action_model as camodel
import cheng/core/runtime/csg_exact_planner as planner

# ---- 独立穷举 oracle ----

var gOracleVals: int64[]
var gOracleUnk: uint8[]
var gOracleBest: int64 = int64(-1)

@borrows
fn oracleDfs(preds: cgoal.CsgGoalPredicateSet,
             actions: camodel.CsgActionModel,
             goalRoot: int32,
             depth: int32,
             gSoFar: int64,
             varCount: int32,
             maxDepth: int32) =
    if depth >= maxDepth:
        return
    let base: int32 = depth * varCount
    let tmpBase: int32 = (maxDepth + 1) * varCount
    for a in 0..<actions.count:
        let pre = camodel.CsgActionPreconditionOf(actions, a)
        if pre >= 0:
            let pe = cgoal.CsgGoalEvaluateAt(preds, pre, gOracleVals, gOracleUnk, base)
            if pe != cgoal.CsgGoalTrue:
                continue
        for j in 0..<varCount:
            gOracleVals[tmpBase + j] = gOracleVals[base + j]
            gOracleUnk[tmpBase + j] = gOracleUnk[base + j]
        camodel.CsgActionApplyEffectsAt(actions, a, gOracleVals, gOracleUnk, tmpBase)
        # 逐路径去环:与当前路径上每个状态做原值精确比较
        var dup: bool = false
        var p: int32 = 0
        while p <= depth:
            var same: bool = true
            for j in 0..<varCount:
                if gOracleVals[p * varCount + j] != gOracleVals[tmpBase + j] ||
                   gOracleUnk[p * varCount + j] != gOracleUnk[tmpBase + j]:
                    same = false
                    break
            if same:
                dup = true
                break
            p = p + 1
        if dup:
            continue
        let ng: int64 = gSoFar + camodel.CsgActionCostOf(actions, a)
        if cgoal.CsgGoalEvaluateAt(preds, goalRoot, gOracleVals, gOracleUnk, tmpBase) == cgoal.CsgGoalTrue:
            if gOracleBest < int64(0) || ng < gOracleBest:
                gOracleBest = ng
            # 代价非负:目标态的延伸不可能更优,剪此分支
            continue
        for j in 0..<varCount:
            gOracleVals[(depth + 1) * varCount + j] = gOracleVals[tmpBase + j]
            gOracleUnk[(depth + 1) * varCount + j] = gOracleUnk[tmpBase + j]
        oracleDfs(preds, actions, goalRoot, depth + 1, ng, varCount, maxDepth)

# 返回最小总代价;-1 = 无任何合法序列可达目标。
@borrows
fn oracleMinCost(preds: cgoal.CsgGoalPredicateSet,
                 actions: camodel.CsgActionModel,
                 goalRoot: int32,
                 initialValues: int64[],
                 initialUnknown: uint8[],
                 maxDepth: int32): int64 =
    let varCount: int32 = initialValues.len
    let need: int32 = (maxDepth + 2) * varCount
    while gOracleVals.len < need:
        add(gOracleVals, int64(0))
    while gOracleUnk.len < need:
        add(gOracleUnk, uint8(0))
    for j in 0..<varCount:
        gOracleVals[j] = initialValues[j]
        gOracleUnk[j] = initialUnknown[j]
    gOracleBest = int64(-1)
    if cgoal.CsgGoalEvaluateAt(preds, goalRoot, gOracleVals, gOracleUnk, 0) == cgoal.CsgGoalTrue:
        return int64(0)
    oracleDfs(preds, actions, goalRoot, 0, int64(0), varCount, maxDepth)
    return gOracleBest

# ---- 路径独立仿真复核 ----

@borrows
fn simulatePath(preds: cgoal.CsgGoalPredicateSet,
                actions: camodel.CsgActionModel,
                goalRoot: int32,
                initialValues: int64[],
                initialUnknown: uint8[],
                path: int32[]): int64 =
    let varCount: int32 = initialValues.len
    var vals: int64[]
    var unk: uint8[]
    for j in 0..<varCount:
        add(vals, initialValues[j])
        add(unk, initialUnknown[j])
    var total: int64 = int64(0)
    for i in 0..<path.len:
        let a = path[i]
        let pre = camodel.CsgActionPreconditionOf(actions, a)
        if pre >= 0:
            if cgoal.CsgGoalEvaluateAt(preds, pre, vals, unk, 0) != cgoal.CsgGoalTrue:
                return int64(-1)
        camodel.CsgActionApplyEffectsAt(actions, a, vals, unk, 0)
        total = total + camodel.CsgActionCostOf(actions, a)
    if cgoal.CsgGoalEvaluateAt(preds, goalRoot, vals, unk, 0) != cgoal.CsgGoalTrue:
        return int64(-1)
    return total

# ---- 构造辅助 ----

# 单变量读/写 + 单常量赋值效果的动作(覆盖多数测试域)。
fn addActionConstEffect(actionsOut: var camodel.CsgActionModel,
                        pre: int32,
                        cost: int64,
                        readVar: int32,
                        writeVar: int32,
                        target: int32,
                        constVal: int64): int32 =
    var rd: int32[]
    add(rd, readVar)
    var wr: int32[]
    add(wr, writeVar)
    var ek: int32[]
    add(ek, camodel.CsgActionEffectAssignConst)
    var et: int32[]
    add(et, target)
    var ec: int64[]
    add(ec, constVal)
    var es: int32[]
    add(es, -1)
    return camodel.CsgActionAddAction(actionsOut, pre, cost, uint8(1), rd, wr, ek, et, ec, es)

fn statusName(status: int32): str =
    if status == planner.CsgExactPlannerGoalReached:
        return "goal-reached"
    if status == planner.CsgExactPlannerUnreachable:
        return "unreachable"
    if status == planner.CsgExactPlannerBudgetExceeded:
        return "budget-exceeded"
    if status == planner.CsgExactPlannerNeedEvidence:
        return "need-evidence"
    if status == planner.CsgExactPlannerModelRejected:
        return "model-rejected"
    return "invalid-input"

fn startUnkAll(varCount: int32): uint8[] =
    var u: uint8[]
    for i in 0..<varCount:
        add(u, uint8(0))
    return u

# B 域初始状态 (v0=0, v1=0)
fn startValsB(): int64[] =
    var v: int64[]
    add(v, int64(0))
    add(v, int64(0))
    return v

# ---- 域构造 ----

# 域 A:door/light,均匀代价,目标含 Not 组合。
fn buildDomainA(predsOut: var cgoal.CsgGoalPredicateSet, actionsOut: var camodel.CsgActionModel): int32 =
    let pDoorClosed = cgoal.CsgGoalAddScalarCompare(predsOut, cgoal.CsgGoalPredScalarEq, 0, int64(0))
    let pDoorOpen = cgoal.CsgGoalAddScalarCompare(predsOut, cgoal.CsgGoalPredScalarEq, 0, int64(1))
    let pLightOff = cgoal.CsgGoalAddScalarCompare(predsOut, cgoal.CsgGoalPredScalarEq, 1, int64(0))
    let notLightOff = cgoal.CsgGoalAddNot(predsOut, pLightOff)
    let goal = cgoal.CsgGoalAddAnd(predsOut, pDoorOpen, notLightOff)
    addActionConstEffect(actionsOut, pDoorClosed, int64(1), 0, 0, 0, int64(1))  # openDoor
    addActionConstEffect(actionsOut, pLightOff, int64(1), 1, 1, 1, int64(1))    # lightOn
    return goal

# 域 B:双 toggle 带环,均匀代价。返回 G2 = And(v0==1, v1==1)(下标 4)。
fn buildDomainB(predsOut: var cgoal.CsgGoalPredicateSet, actionsOut: var camodel.CsgActionModel): int32 =
    let p0eq0 = cgoal.CsgGoalAddScalarCompare(predsOut, cgoal.CsgGoalPredScalarEq, 0, int64(0))
    let p0eq1 = cgoal.CsgGoalAddScalarCompare(predsOut, cgoal.CsgGoalPredScalarEq, 0, int64(1))
    let p1eq0 = cgoal.CsgGoalAddScalarCompare(predsOut, cgoal.CsgGoalPredScalarEq, 1, int64(0))
    let p1eq1 = cgoal.CsgGoalAddScalarCompare(predsOut, cgoal.CsgGoalPredScalarEq, 1, int64(1))
    let goal = cgoal.CsgGoalAddAnd(predsOut, p0eq1, p1eq1)
    addActionConstEffect(actionsOut, p0eq0, int64(1), 0, 0, 0, int64(1))  # t0on
    addActionConstEffect(actionsOut, p0eq1, int64(1), 0, 0, 0, int64(0))  # t0off
    addActionConstEffect(actionsOut, p1eq0, int64(1), 1, 1, 1, int64(1))  # t1on
    addActionConstEffect(actionsOut, p1eq1, int64(1), 1, 1, 1, int64(0))  # t1off
    return goal

# 域 C:单变量,零权+正权混合。goal = InSet(v0, {2})。
fn buildDomainC(predsOut: var cgoal.CsgGoalPredicateSet, actionsOut: var camodel.CsgActionModel): int32 =
    let p0eq0 = cgoal.CsgGoalAddScalarCompare(predsOut, cgoal.CsgGoalPredScalarEq, 0, int64(0))
    let p0eq1 = cgoal.CsgGoalAddScalarCompare(predsOut, cgoal.CsgGoalPredScalarEq, 0, int64(1))
    var members: int64[]
    add(members, int64(2))
    let goal = cgoal.CsgGoalAddInSet(predsOut, 0, members)
    # 0 jump:一跳昂贵(代价 5)
    addActionConstEffect(actionsOut, p0eq0, int64(5), 0, 0, 0, int64(2))
    # 1 step1:零权边
    addActionConstEffect(actionsOut, p0eq0, int64(0), 0, 0, 0, int64(1))
    # 2 step2:正权边
    addActionConstEffect(actionsOut, p0eq1, int64(2), 0, 0, 0, int64(2))
    return goal

# ---- verify a:域 A 对拍(含 Not) ----

fn checkDomainA() =
    var preds: cgoal.CsgGoalPredicateSet
    var actions: camodel.CsgActionModel
    let goalRoot = buildDomainA(preds, actions)
    var startVals: int64[]
    add(startVals, int64(0))
    add(startVals, int64(0))
    var opts: planner.CsgExactPlannerOptions
    opts.degenerateConstantHash = uint8(0)
    let outBfs = planner.CsgExactPlannerPlanBfs(preds, goalRoot, actions, startVals, startUnkAll(2), 64, int64(1024), opts)
    assert(outBfs.status == planner.CsgExactPlannerGoalReached, "verify-a(A): bfs status " + statusName(outBfs.status))
    assert(outBfs.totalCost == int64(2), "verify-a(A): bfs cost")
    assert(outBfs.actions.len == 2, "verify-a(A): bfs path length")
    let simBfs = simulatePath(preds, actions, goalRoot, startVals, startUnkAll(2), outBfs.actions)
    assert(simBfs == outBfs.totalCost, "verify-a(A): bfs path simulation")
    let outDij = planner.CsgExactPlannerPlanDijkstra(preds, goalRoot, actions, startVals, startUnkAll(2), 64, int64(1024), opts)
    assert(outDij.status == planner.CsgExactPlannerGoalReached && outDij.totalCost == int64(2), "verify-a(A): dijkstra")
    let oracle = oracleMinCost(preds, actions, goalRoot, startVals, startUnkAll(2), 6)
    assert(oracle == int64(2), "verify-a(A): oracle cost")
    assert(outBfs.totalCost == oracle && outDij.totalCost == oracle, "verify-a(A): planner/oracle cross-check")
    echo("verify-a A ok: bfs/dijkstra/oracle cost=" + strings.IntToStr(int32(outBfs.totalCost)))

# ---- verify a/b:域 B 对拍 + 带环终止性 ----

fn checkDomainB() =
    var preds: cgoal.CsgGoalPredicateSet
    var actions: camodel.CsgActionModel
    let goalRoot = buildDomainB(preds, actions)
    var opts: planner.CsgExactPlannerOptions
    opts.degenerateConstantHash = uint8(0)
    let outBfs = planner.CsgExactPlannerPlanBfs(preds, goalRoot, actions, startValsB(), startUnkAll(2), 64, int64(1024), opts)
    assert(outBfs.status == planner.CsgExactPlannerGoalReached, "verify-b(B): bfs status " + statusName(outBfs.status))
    assert(outBfs.totalCost == int64(2) && outBfs.actions.len == 2, "verify-b(B): bfs solution")
    let outDij = planner.CsgExactPlannerPlanDijkstra(preds, goalRoot, actions, startValsB(), startUnkAll(2), 64, int64(1024), opts)
    assert(outDij.status == planner.CsgExactPlannerGoalReached && outDij.totalCost == int64(2), "verify-b(B): dijkstra")
    let oracle = oracleMinCost(preds, actions, goalRoot, startValsB(), startUnkAll(2), 7)
    assert(oracle == int64(2) && oracle == outBfs.totalCost, "verify-a(B): oracle cross-check")
    echo("verify-b ok: cyclic domain terminates, cost=" + strings.IntToStr(int32(outBfs.totalCost)) + " states=" + strings.IntToStr(outBfs.expandedStates))

# ---- verify a/c:域 C 零权+正权混合 ----

fn checkDomainC() =
    var preds: cgoal.CsgGoalPredicateSet
    var actions: camodel.CsgActionModel
    let goalRoot = buildDomainC(preds, actions)
    var startVals: int64[]
    add(startVals, int64(0))
    var opts: planner.CsgExactPlannerOptions
    opts.degenerateConstantHash = uint8(0)
    let outDij = planner.CsgExactPlannerPlanDijkstra(preds, goalRoot, actions, startVals, startUnkAll(1), 64, int64(1024), opts)
    assert(outDij.status == planner.CsgExactPlannerGoalReached, "verify-c(C): dijkstra status " + statusName(outDij.status))
    assert(outDij.totalCost == int64(2), "verify-c(C): weighted cost must be 2 not 5")
    assert(outDij.actions.len == 2, "verify-c(C): two cheap hops beat one expensive hop")
    assert(outDij.actions[0] == 1 && outDij.actions[1] == 2, "verify-c(C): path = [step1, step2]")
    let sim = simulatePath(preds, actions, goalRoot, startVals, startUnkAll(1), outDij.actions)
    assert(sim == outDij.totalCost, "verify-c(C): path simulation")
    let oracle = oracleMinCost(preds, actions, goalRoot, startVals, startUnkAll(1), 5)
    assert(oracle == int64(2) && oracle == outDij.totalCost, "verify-c(C): oracle cross-check")
    # BFS 对非均匀代价必须显式拒绝(首个与动作 0 代价不同者 = 动作 1)
    let outBfs = planner.CsgExactPlannerPlanBfs(preds, goalRoot, actions, startVals, startUnkAll(1), 64, int64(1024), opts)
    assert(outBfs.status == planner.CsgExactPlannerModelRejected, "verify-c(C): bfs must reject non-uniform costs")
    assert(outBfs.rejectedAction == 1, "verify-c(C): bfs rejection action index")
    echo("verify-c ok: dijkstra cost=" + strings.IntToStr(int32(outDij.totalCost)) + " via two hops (weights effective); bfs rejected non-uniform")

# ---- verify d:域 D 不可达 ----

fn checkDomainD() =
    var preds: cgoal.CsgGoalPredicateSet
    var actions: camodel.CsgActionModel
    var members: int64[]
    add(members, int64(1))
    add(members, int64(3))
    let goal = cgoal.CsgGoalAddInSet(preds, 0, members)
    let p1eq0 = cgoal.CsgGoalAddScalarCompare(preds, cgoal.CsgGoalPredScalarEq, 1, int64(0))
    let p1eq1 = cgoal.CsgGoalAddScalarCompare(preds, cgoal.CsgGoalPredScalarEq, 1, int64(1))
    # 只有 var1 可动,var0 永远到不了 {1,3}
    addActionConstEffect(actions, p1eq0, int64(1), 1, 1, 1, int64(1))
    addActionConstEffect(actions, p1eq1, int64(1), 1, 1, 1, int64(0))
    var startVals: int64[]
    add(startVals, int64(0))
    add(startVals, int64(0))
    var opts: planner.CsgExactPlannerOptions
    opts.degenerateConstantHash = uint8(0)
    let outBfs = planner.CsgExactPlannerPlanBfs(preds, goal, actions, startVals, startUnkAll(2), 64, int64(1024), opts)
    assert(outBfs.status == planner.CsgExactPlannerUnreachable, "verify-d: bfs status " + statusName(outBfs.status))
    assert(outBfs.status != planner.CsgExactPlannerBudgetExceeded, "verify-d: unreachable distinct from budget")
    assert(outBfs.expandedStates == 2, "verify-d: exhausted both reachable states")
    let outDij = planner.CsgExactPlannerPlanDijkstra(preds, goal, actions, startVals, startUnkAll(2), 64, int64(1024), opts)
    assert(outDij.status == planner.CsgExactPlannerUnreachable, "verify-d: dijkstra unreachable")
    let oracle = oracleMinCost(preds, actions, goal, startVals, startUnkAll(2), 6)
    assert(oracle == int64(-1), "verify-d: oracle finds nothing")
    echo("verify-d ok: unreachable after full exhaustion, expandedStates=" + strings.IntToStr(outBfs.expandedStates))

# ---- verify e:未知状态变量 ----

fn checkNeedEvidence() =
    var opts: planner.CsgExactPlannerOptions
    opts.degenerateConstantHash = uint8(0)
    # E1:初始目标未知
    var preds1: cgoal.CsgGoalPredicateSet
    let goal1 = cgoal.CsgGoalAddScalarCompare(preds1, cgoal.CsgGoalPredScalarEq, 0, int64(1))
    var actions1: camodel.CsgActionModel
    addActionConstEffect(actions1, -1, int64(1), 0, 0, 0, int64(1))
    var sv1: int64[]
    add(sv1, int64(0))
    var su1: uint8[]
    add(su1, uint8(1))  # var0 未知
    let out1 = planner.CsgExactPlannerPlanBfs(preds1, goal1, actions1, sv1, su1, 64, int64(1024), opts)
    assert(out1.status == planner.CsgExactPlannerNeedEvidence, "verify-e(E1): status " + statusName(out1.status))
    assert(out1.expandedStates == 1, "verify-e(E1): only initial state visited")

    # E2:目标已知 false,但唯一动作前置含未知 → NeedEvidence 而非 Unreachable
    var preds2: cgoal.CsgGoalPredicateSet
    let p0eq0 = cgoal.CsgGoalAddScalarCompare(preds2, cgoal.CsgGoalPredScalarEq, 0, int64(0))
    let goal2 = cgoal.CsgGoalAddScalarCompare(preds2, cgoal.CsgGoalPredScalarEq, 0, int64(1))
    let p1eq1 = cgoal.CsgGoalAddScalarCompare(preds2, cgoal.CsgGoalPredScalarEq, 1, int64(1))
    let pre2 = cgoal.CsgGoalAddAnd(preds2, p0eq0, p1eq1)
    var actions2: camodel.CsgActionModel
    # fix: pre(v0==0 && v1==1) → v0←1;读集必须声明 {0,1}
    var rd: int32[]
    add(rd, 0)
    add(rd, 1)
    var wr: int32[]
    add(wr, 0)
    var ek: int32[]
    add(ek, camodel.CsgActionEffectAssignConst)
    var et: int32[]
    add(et, 0)
    var ec: int64[]
    add(ec, int64(1))
    var es: int32[]
    add(es, -1)
    camodel.CsgActionAddAction(actions2, pre2, int64(1), uint8(1), rd, wr, ek, et, ec, es)
    var sv2: int64[]
    add(sv2, int64(0))
    add(sv2, int64(0))
    var su2: uint8[]
    add(su2, uint8(0))
    add(su2, uint8(1))  # var1 未知
    let out2 = planner.CsgExactPlannerPlanBfs(preds2, goal2, actions2, sv2, su2, 64, int64(1024), opts)
    assert(out2.status == planner.CsgExactPlannerNeedEvidence, "verify-e(E2): status " + statusName(out2.status))
    assert(out2.status != planner.CsgExactPlannerUnreachable, "verify-e(E2): unknown precondition is not unreachable")

    # E3:另有无关于未知证据的直达动作 → 仍 GoalReached(未知不阻断可证明成功)
    var preds3: cgoal.CsgGoalPredicateSet
    let g3a = cgoal.CsgGoalAddScalarCompare(preds3, cgoal.CsgGoalPredScalarEq, 0, int64(0))
    let goal3 = cgoal.CsgGoalAddScalarCompare(preds3, cgoal.CsgGoalPredScalarEq, 0, int64(1))
    let g3c = cgoal.CsgGoalAddScalarCompare(preds3, cgoal.CsgGoalPredScalarEq, 1, int64(1))
    let pre3 = cgoal.CsgGoalAddAnd(preds3, g3a, g3c)
    var actions3: camodel.CsgActionModel
    # fix: pre(v0==0 && v1==1) → v0←1;前置引用 {0,1},读集必须声明 {0,1}
    var rd3: int32[]
    add(rd3, 0)
    add(rd3, 1)
    var wr3: int32[]
    add(wr3, 0)
    var ek3: int32[]
    add(ek3, camodel.CsgActionEffectAssignConst)
    var et3: int32[]
    add(et3, 0)
    var ec3: int64[]
    add(ec3, int64(1))
    var es3: int32[]
    add(es3, -1)
    camodel.CsgActionAddAction(actions3, pre3, int64(1), uint8(1), rd3, wr3, ek3, et3, ec3, es3)
    addActionConstEffect(actions3, -1, int64(3), 0, 0, 0, int64(1))     # directSet 恒真
    let out3 = planner.CsgExactPlannerPlanDijkstra(preds3, goal3, actions3, sv2, su2, 64, int64(1024), opts)
    assert(out3.status == planner.CsgExactPlannerGoalReached, "verify-e(E3): status " + statusName(out3.status))
    assert(out3.totalCost == int64(3), "verify-e(E3): cost via directSet")
    echo("verify-e ok: E1/E2 need-evidence, E3 goal-reached cost=" + strings.IntToStr(int32(out3.totalCost)))

# ---- verify f:强制哈希碰撞注入 ----

fn checkForcedCollision() =
    var predsB: cgoal.CsgGoalPredicateSet
    var actionsB: camodel.CsgActionModel
    let goalB = buildDomainB(predsB, actionsB)
    var clean: planner.CsgExactPlannerOptions
    clean.degenerateConstantHash = uint8(0)
    var dirty: planner.CsgExactPlannerOptions
    dirty.degenerateConstantHash = uint8(1)  # 全部状态同一退化指纹 → 纯原值比较
    let base = planner.CsgExactPlannerPlanBfs(predsB, goalB, actionsB, startValsB(), startUnkAll(2), 64, int64(1024), clean)
    let coll = planner.CsgExactPlannerPlanBfs(predsB, goalB, actionsB, startValsB(), startUnkAll(2), 64, int64(1024), dirty)
    assert(base.status == planner.CsgExactPlannerGoalReached && coll.status == planner.CsgExactPlannerGoalReached,
        "verify-f(B): status")
    assert(base.totalCost == coll.totalCost && base.actions.len == coll.actions.len, "verify-f(B): solution unchanged")
    for i in 0..<base.actions.len:
        assert(base.actions[i] == coll.actions[i], "verify-f(B): path element unchanged")

    var predsC: cgoal.CsgGoalPredicateSet
    var actionsC: camodel.CsgActionModel
    let goalC = buildDomainC(predsC, actionsC)
    var sv: int64[]
    add(sv, int64(0))
    let baseC = planner.CsgExactPlannerPlanDijkstra(predsC, goalC, actionsC, sv, startUnkAll(1), 64, int64(1024), clean)
    let collC = planner.CsgExactPlannerPlanDijkstra(predsC, goalC, actionsC, sv, startUnkAll(1), 64, int64(1024), dirty)
    assert(baseC.totalCost == int64(2) && collC.totalCost == int64(2), "verify-f(C): weighted solution unchanged")
    assert(baseC.actions.len == collC.actions.len, "verify-f(C): path length unchanged")
    for i in 0..<baseC.actions.len:
        assert(baseC.actions[i] == collC.actions[i], "verify-f(C): path element unchanged")
    echo("verify-f ok: degenerate constant hash keeps exact solutions (B + C)")

# ---- verify g:预算耗尽 ----

fn checkBudget() =
    var preds: cgoal.CsgGoalPredicateSet
    var actions: camodel.CsgActionModel
    let goalRoot = buildDomainB(preds, actions)
    var opts: planner.CsgExactPlannerOptions
    opts.degenerateConstantHash = uint8(0)
    # 状态预算 2:B/G2 目标态是第 4 个状态,第 3 个状态入表前耗尽;
    # 已访问状态数恰等于预算值 2,可断言
    let outStates = planner.CsgExactPlannerPlanBfs(preds, goalRoot, actions, startValsB(), startUnkAll(2), 2, int64(1024), opts)
    assert(outStates.status == planner.CsgExactPlannerBudgetExceeded, "verify-g: state budget status " + statusName(outStates.status))
    assert(outStates.expandedStates == 2, "verify-g: expandedStates == state budget")
    # 边预算 1:第二次前置为真的扩展尝试前耗尽,扩展边数恰等于预算值 1
    let outEdges = planner.CsgExactPlannerPlanBfs(preds, goalRoot, actions, startValsB(), startUnkAll(2), 64, int64(1), opts)
    assert(outEdges.status == planner.CsgExactPlannerBudgetExceeded, "verify-g: edge budget status " + statusName(outEdges.status))
    assert(outEdges.expandedEdges == int64(1), "verify-g: expandedEdges == edge budget")
    echo("verify-g ok: budget-exceeded with expandedStates=2 / expandedEdges=1, distinguishable from unreachable")

# ---- verify h:缺读写集声明 → 准入拒绝 ----

fn checkAdmissionRejection() =
    var preds: cgoal.CsgGoalPredicateSet
    let goal = cgoal.CsgGoalAddScalarCompare(preds, cgoal.CsgGoalPredScalarEq, 0, int64(1))
    let p0eq0 = cgoal.CsgGoalAddScalarCompare(preds, cgoal.CsgGoalPredScalarEq, 0, int64(0))
    var actions: camodel.CsgActionModel
    addActionConstEffect(actions, p0eq0, int64(1), 0, 0, 0, int64(1))
    camodel.CsgActionAddUndeclared(actions, int64(1))
    var sv: int64[]
    add(sv, int64(0))
    var opts: planner.CsgExactPlannerOptions
    opts.degenerateConstantHash = uint8(0)
    let out = planner.CsgExactPlannerPlanBfs(preds, goal, actions, sv, startUnkAll(1), 64, int64(1024), opts)
    assert(out.status == planner.CsgExactPlannerModelRejected, "verify-h: status " + statusName(out.status))
    assert(out.rejectedAction == 1, "verify-h: undeclared action index rejected")
    # 只有未声明动作时同样拒绝
    var actions2: camodel.CsgActionModel
    camodel.CsgActionAddUndeclared(actions2, int64(1))
    let out2 = planner.CsgExactPlannerPlanBfs(preds, goal, actions2, sv, startUnkAll(1), 64, int64(1024), opts)
    assert(out2.status == planner.CsgExactPlannerModelRejected && out2.rejectedAction == 0, "verify-h: single undeclared rejected")
    echo("verify-h ok: missing read/write declaration rejected with exact action index")

# ---- verify a:域 I/J/K 对拍(嵌套 And+InSet / CopyVar+IdentityEq / Lt+Le+Or) ----

fn checkDomainI() =
    var preds: cgoal.CsgGoalPredicateSet
    var actions: camodel.CsgActionModel
    let p0eq0 = cgoal.CsgGoalAddScalarCompare(preds, cgoal.CsgGoalPredScalarEq, 0, int64(0))
    let p0eq1 = cgoal.CsgGoalAddScalarCompare(preds, cgoal.CsgGoalPredScalarEq, 0, int64(1))
    let p1eq0 = cgoal.CsgGoalAddScalarCompare(preds, cgoal.CsgGoalPredScalarEq, 1, int64(0))
    let p1eq1 = cgoal.CsgGoalAddScalarCompare(preds, cgoal.CsgGoalPredScalarEq, 1, int64(1))
    let p2eq0 = cgoal.CsgGoalAddScalarCompare(preds, cgoal.CsgGoalPredScalarEq, 2, int64(0))
    let inner = cgoal.CsgGoalAddAnd(preds, p0eq1, p1eq1)
    var members: int64[]
    add(members, int64(1))
    let p2in = cgoal.CsgGoalAddInSet(preds, 2, members)
    let goal = cgoal.CsgGoalAddAnd(preds, p2in, inner)
    addActionConstEffect(actions, p0eq0, int64(1), 0, 0, 0, int64(1))  # s0
    addActionConstEffect(actions, p1eq0, int64(1), 1, 1, 1, int64(1))  # s1
    addActionConstEffect(actions, p2eq0, int64(1), 2, 2, 2, int64(1))  # s2
    addActionConstEffect(actions, p1eq1, int64(1), 1, 1, 1, int64(0))  # r1(制造环路分支)
    var startVals: int64[]
    add(startVals, int64(0))
    add(startVals, int64(0))
    add(startVals, int64(0))
    var opts: planner.CsgExactPlannerOptions
    opts.degenerateConstantHash = uint8(0)
    let outBfs = planner.CsgExactPlannerPlanBfs(preds, goal, actions, startVals, startUnkAll(3), 64, int64(1024), opts)
    assert(outBfs.status == planner.CsgExactPlannerGoalReached && outBfs.totalCost == int64(3), "verify-a(I): bfs")
    assert(outBfs.actions.len == 3, "verify-a(I): path length 3")
    let outDij = planner.CsgExactPlannerPlanDijkstra(preds, goal, actions, startVals, startUnkAll(3), 64, int64(1024), opts)
    assert(outDij.status == planner.CsgExactPlannerGoalReached && outDij.totalCost == int64(3), "verify-a(I): dijkstra")
    let oracle = oracleMinCost(preds, actions, goal, startVals, startUnkAll(3), 8)
    assert(oracle == int64(3) && oracle == outBfs.totalCost && oracle == outDij.totalCost, "verify-a(I): oracle cross-check")
    echo("verify-a I ok: nested and/in-set domain cost=" + strings.IntToStr(int32(outBfs.totalCost)))

fn checkDomainJ() =
    var preds: cgoal.CsgGoalPredicateSet
    var actions: camodel.CsgActionModel
    let idEq = cgoal.CsgGoalAddIdentityEq(preds, 0, 1)
    let p0eq1 = cgoal.CsgGoalAddScalarCompare(preds, cgoal.CsgGoalPredScalarEq, 0, int64(1))
    let goal = cgoal.CsgGoalAddAnd(preds, idEq, p0eq1)
    # 0 setV0: v0←1(恒真前置)
    addActionConstEffect(actions, -1, int64(1), 0, 0, 0, int64(1))
    # 1 copyV1: v1←v0(拷贝效果;读集 {0},写集 {1})
    var rd: int32[]
    add(rd, 0)
    var wr: int32[]
    add(wr, 1)
    var ek: int32[]
    add(ek, camodel.CsgActionEffectCopyVar)
    var et: int32[]
    add(et, 1)
    var ec: int64[]
    add(ec, int64(0))
    var es: int32[]
    add(es, 0)
    camodel.CsgActionAddAction(actions, -1, int64(1), uint8(1), rd, wr, ek, et, ec, es)
    var startVals: int64[]
    add(startVals, int64(0))
    add(startVals, int64(0))
    var opts: planner.CsgExactPlannerOptions
    opts.degenerateConstantHash = uint8(0)
    let outBfs = planner.CsgExactPlannerPlanBfs(preds, goal, actions, startVals, startUnkAll(2), 64, int64(1024), opts)
    assert(outBfs.status == planner.CsgExactPlannerGoalReached && outBfs.totalCost == int64(2), "verify-a(J): bfs")
    # 顺序敏感:必须先 setV0 再 copyV1
    assert(outBfs.actions.len == 2 && outBfs.actions[0] == 0 && outBfs.actions[1] == 1, "verify-a(J): order-sensitive path")
    let oracle = oracleMinCost(preds, actions, goal, startVals, startUnkAll(2), 6)
    assert(oracle == int64(2) && oracle == outBfs.totalCost, "verify-a(J): oracle cross-check")
    echo("verify-a J ok: copy-effect/identity-eq domain cost=" + strings.IntToStr(int32(outBfs.totalCost)))

fn checkDomainK() =
    var preds: cgoal.CsgGoalPredicateSet
    var actions: camodel.CsgActionModel
    let p0eq0 = cgoal.CsgGoalAddScalarCompare(preds, cgoal.CsgGoalPredScalarEq, 0, int64(0))
    let pLt1 = cgoal.CsgGoalAddScalarCompare(preds, cgoal.CsgGoalPredScalarLt, 0, int64(1))
    let notGe1 = cgoal.CsgGoalAddNot(preds, pLt1)   # v0 >= 1
    let pLe1 = cgoal.CsgGoalAddScalarCompare(preds, cgoal.CsgGoalPredScalarLe, 0, int64(1))  # v0 <= 1
    let andPart = cgoal.CsgGoalAddAnd(preds, notGe1, pLe1)  # v0 == 1
    let pFar = cgoal.CsgGoalAddScalarCompare(preds, cgoal.CsgGoalPredScalarEq, 0, int64(99))
    let goal = cgoal.CsgGoalAddOr(preds, andPart, pFar)
    addActionConstEffect(actions, p0eq0, int64(1), 0, 0, 0, int64(1))  # inc: v0 0→1
    var sv: int64[]
    add(sv, int64(0))
    var opts: planner.CsgExactPlannerOptions
    opts.degenerateConstantHash = uint8(0)
    let outBfs = planner.CsgExactPlannerPlanBfs(preds, goal, actions, sv, startUnkAll(1), 64, int64(1024), opts)
    assert(outBfs.status == planner.CsgExactPlannerGoalReached && outBfs.totalCost == int64(1), "verify-a(K): bfs lt/le/or")
    let oracle = oracleMinCost(preds, actions, goal, sv, startUnkAll(1), 5)
    assert(oracle == int64(1) && oracle == outBfs.totalCost, "verify-a(K): oracle cross-check")
    echo("verify-a K ok: lt/le/or domain cost=" + strings.IntToStr(int32(outBfs.totalCost)))

# ---- 附加:非法输入显式拒绝 ----

fn checkInvalidInput() =
    var preds: cgoal.CsgGoalPredicateSet
    let goal = cgoal.CsgGoalAddScalarCompare(preds, cgoal.CsgGoalPredScalarEq, 0, int64(1))
    var actions: camodel.CsgActionModel
    addActionConstEffect(actions, -1, int64(1), 0, 0, 0, int64(1))
    var opts: planner.CsgExactPlannerOptions
    opts.degenerateConstantHash = uint8(0)
    var emptyVals: int64[]
    var emptyUnk: uint8[]
    let out1 = planner.CsgExactPlannerPlanBfs(preds, goal, actions, emptyVals, emptyUnk, 64, int64(1024), opts)
    assert(out1.status == planner.CsgExactPlannerInvalidInput, "verify-input: empty state rejected")
    var sv: int64[]
    add(sv, int64(0))
    let out2 = planner.CsgExactPlannerPlanBfs(preds, goal, actions, sv, startUnkAll(2), 64, int64(1024), opts)
    assert(out2.status == planner.CsgExactPlannerInvalidInput, "verify-input: length mismatch rejected")
    let out3 = planner.CsgExactPlannerPlanBfs(preds, goal, actions, sv, startUnkAll(1), 0, int64(1024), opts)
    assert(out3.status == planner.CsgExactPlannerInvalidInput, "verify-input: zero state budget rejected")
    let out4 = planner.CsgExactPlannerPlanDijkstra(preds, goal, actions, sv, startUnkAll(1), 64, int64(-1), opts)
    assert(out4.status == planner.CsgExactPlannerInvalidInput, "verify-input: negative edge budget rejected")
    echo("verify-input ok: invalid inputs rejected without search")

fn main(): int32 =
    checkDomainA()
    checkDomainB()
    checkDomainC()
    checkDomainD()
    checkNeedEvidence()
    checkForcedCollision()
    checkBudget()
    checkAdmissionRejection()
    checkDomainI()
    checkDomainJ()
    checkDomainK()
    checkInvalidInput()
    echo("csg_exact_planner_smoke ok")
    return 0
