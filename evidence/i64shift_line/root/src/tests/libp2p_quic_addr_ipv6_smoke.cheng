import std/result
import cheng/libp2p/transports/quic_transport
import cheng/quic/multiaddress as qaddr

fn main(): int32 =
    let ipv4Res: Result[qaddr.MultiAddress] = quic_transport.Libp2pQuicAddrFromHostPort("205.186.67.165", 7443)
    assert(IsOk(ipv4Res), " libp2p quic addr ipv4 ok")
    assert(qaddr.quicMultiAddressToString(Value(ipv4Res)) == "/ip4/205.186.67.165/udp/7443/quic-v1",
           " libp2p quic addr ipv4 text")

    let ipv6Res: Result[qaddr.MultiAddress] = quic_transport.Libp2pQuicAddrFromHostPort("2400:8d60:3::1:6e25:56f2", 7443)
    assert(IsOk(ipv6Res), " libp2p quic addr ipv6 ok")
    assert(qaddr.quicMultiAddressToString(Value(ipv6Res)) == "/ip6/2400:8d60:3::1:6e25:56f2/udp/7443/quic-v1",
           " libp2p quic addr ipv6 text")

    let bracketRes: Result[qaddr.MultiAddress] = quic_transport.Libp2pQuicAddrFromHostPort("[2400:8d60:3::1:6e25:56f2]", 7443)
    assert(IsOk(bracketRes), " libp2p quic addr bracket ipv6 ok")
    assert(qaddr.quicMultiAddressToString(Value(bracketRes)) == "/ip6/2400:8d60:3::1:6e25:56f2/udp/7443/quic-v1",
           " libp2p quic addr bracket ipv6 text")

    echo(" libp2p_quic_addr_ipv6_smoke ok")
    return 0
