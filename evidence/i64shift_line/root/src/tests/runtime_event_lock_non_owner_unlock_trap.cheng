import std/thread

@importc("cheng_host_pipe_runtime")
fn cheng_host_pipe_runtime(fds: var int32[2]): int32

@importc("cheng_host_read_runtime")
fn cheng_host_read_runtime(
    fd: int32,
    data: var uint8,
    count: int32): int64

@importc("cheng_host_write_runtime")
fn cheng_host_write_runtime(
    fd: int32,
    data: var uint8,
    count: int32): int64

@importc("cheng_native_runtime_event_lock_bridge")
fn runtimeEventLock(): void

@importc("cheng_native_runtime_event_assert_owner_bridge")
fn runtimeEventAssertOwner(): void

@importc("cheng_native_runtime_event_unlock_bridge")
fn runtimeEventUnlock(): void

type
    NonOwnerUnlockCtx =
        readyPipe: int32[2]
        startPipe: int32[2]

var nonOwnerUnlockCtx: NonOwnerUnlockCtx

fn eventWrite(fd: int32) =
    var token: uint8 = uint8(1)
    assert(cheng_host_write_runtime(fd, token, 1) == int64(1),
           " runtime event lock non-owner: event write")

fn eventRead(fd: int32) =
    var token: uint8
    assert(cheng_host_read_runtime(fd, token, 1) == int64(1),
           " runtime event lock non-owner: event read")
    assert(token == uint8(1),
           " runtime event lock non-owner: event token")

fn NonOwnerUnlockWorker() =
    eventWrite(nonOwnerUnlockCtx.readyPipe[1])
    eventRead(nonOwnerUnlockCtx.startPipe[0])
    runtimeEventUnlock()

fn main(): int32 =
    assert(cheng_host_pipe_runtime(nonOwnerUnlockCtx.readyPipe) == 0,
           " runtime event lock non-owner: ready pipe")
    assert(cheng_host_pipe_runtime(nonOwnerUnlockCtx.startPipe) == 0,
           " runtime event lock non-owner: start pipe")

    let worker = thread.StartFn(NonOwnerUnlockWorker)
    eventRead(nonOwnerUnlockCtx.readyPipe[0])
    runtimeEventLock()
    runtimeEventAssertOwner()
    eventWrite(nonOwnerUnlockCtx.startPipe[1])
    let _ = thread.JoinThread(worker)
    return 91
