type MyId = int32

type
    IdBox[T] =
        ids: MyId[]
        tag: T

fn PutIds(box: var IdBox[int32], ids: MyId[]) =
    box.ids = ids

fn main(): int32 =
    var xs: MyId[]
    add(xs, 3)
    add(xs, 4)
    var box: IdBox[int32]
    box.tag = 7
    PutIds(box, xs)
    if box.ids.len != 2:
        return 11
    return box.ids[0] + box.ids[1] + box.tag - 14

main()
