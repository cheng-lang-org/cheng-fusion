import cheng/core/ir/core_types as coreir
import cheng/core/backend/lowering_plan as lowering

fn main(): int32 =
    assert(sizeof(str) == 24,
           "phase arena str budget smoke: Cheng str ABI drift")
    assert(coreir.BodyIRFlatSoAStrSlotBytes() == int64(24),
           "phase arena str budget smoke: BodyIR budget drift")
    assert(lowering.LoweringPhaseArenaStrSlotBytes() == int64(24),
           "phase arena str budget smoke: lowering budget drift")
    echo("PHASE_ARENA_STR_SLOT_BUDGET_OK")
    return 0
