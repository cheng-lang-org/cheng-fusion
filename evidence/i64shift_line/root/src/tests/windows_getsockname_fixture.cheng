import std/strutils as strutil
import std/result
import std/rawbytes as rawbytes
import std/os as os
import std/net/transports/tcp_syscall as tcp

fn main(): int32 =
    var listener: tcp.TcpListenerHandle
    let listenRes: Result[bool] = tcp.TcpListen4Fill("127.0.0.1", 18091, listener)
    if IsErr(listenRes):
        puts(strutil.Join(["listen err=", ErrorText(listenRes)], ""))
        return 1
    puts(strutil.Join(["listen ok fd=", IntToStr(listener.fd)], ""))
    let buf: rawbytes.Bytes = rawbytes.BytesAlloc(128)
    var addrLen: int32 = rawbytes.BytesLen(buf)
    let rc: int32 = os.UdpGetSockNameFd(listener.fd, buf, addrLen)
    puts(strutil.Join(["listener getsockname rc=", IntToStr(rc), " addrLen=", IntToStr(addrLen), " errno=", IntToStr(os.UdpErrno())], ""))
    let connRes: Result[tcp.TcpConnectionHandle] = tcp.TcpConnect4Timeout("127.0.0.1", 18091, 2000)
    if IsErr(connRes):
        puts(strutil.Join(["connect-timeout err=", ErrorText(connRes)], ""))
        tcp.TcpListenerClose(listener)
        return 1
    var conn: tcp.TcpConnectionHandle = Value(connRes)
    puts(strutil.Join(["connect ok fd=", IntToStr(conn.fd), " localport=", IntToStr(conn.localAddr.port)], ""))
    tcp.TcpClose(conn)
    let gen4Res: Result[tcp.TcpConnectionHandle] = tcp.TcpConnect4("127.0.0.1", 18091)
    if IsErr(gen4Res):
        puts(strutil.Join(["connect4 err=", ErrorText(gen4Res)], ""))
        tcp.TcpListenerClose(listener)
        return 1
    var gen4: tcp.TcpConnectionHandle = Value(gen4Res)
    puts(strutil.Join(["connect4 ok fd=", IntToStr(gen4.fd), " localport=", IntToStr(gen4.localAddr.port)], ""))
    tcp.TcpClose(gen4)
    let genRes: Result[tcp.TcpConnectionHandle] = tcp.TcpConnect("127.0.0.1", 18091, false)
    if IsErr(genRes):
        puts(strutil.Join(["generic connect err=", ErrorText(genRes)], ""))
        tcp.TcpListenerClose(listener)
        return 1
    var gen: tcp.TcpConnectionHandle = Value(genRes)
    puts(strutil.Join(["generic connect ok fd=", IntToStr(gen.fd), " localport=", IntToStr(gen.localAddr.port)], ""))
    tcp.TcpClose(gen)
    tcp.TcpListenerClose(listener)
    return 0
