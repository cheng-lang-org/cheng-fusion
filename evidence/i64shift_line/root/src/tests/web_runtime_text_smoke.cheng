import cheng/core/runtime/web_text_runtime as text

fn runTextMeasureSmoke(): int32 =
    var metrics: text.WebTextMetrics
    text.WebTextDefaultMetrics(metrics)
    if metrics.charWidth != text.WebTextDefaultCharWidth:
        return 1
    if metrics.lineHeight != text.WebTextDefaultLineHeight:
        return 2

    var width = 0
    var height = 0
    var charCount = 0
    if !text.WebTextMeasure("Run", metrics, width, height, charCount):
        return 3
    if width != 24:
        return 4
    if height != 16:
        return 5
    if charCount != 3:
        return 6

    if !text.WebTextMetricsInit(metrics, 2, 3):
        return 7
    if !text.WebTextMeasure("A B", metrics, width, height, charCount):
        return 8
    if width != 6 || height != 3 || charCount != 3:
        return 9
    return 0

fn runTextNegativeSmoke(): int32 =
    var metrics: text.WebTextMetrics
    if text.WebTextMetricsInit(metrics, 0, 3):
        return 50
    if !text.WebTextMetricsInit(metrics, 2, 3):
        return 51

    var width = 0
    var height = 0
    var charCount = 0
    if text.WebTextMeasure("", metrics, width, height, charCount):
        return 52
    if text.WebTextMeasure("bad\nline", metrics, width, height, charCount):
        return 53
    return 0

fn main(): int32 =
    var code = runTextMeasureSmoke()
    if code != 0:
        echo(Fmt"FAIL runTextMeasureSmoke: {code}")
        return code
    code = runTextNegativeSmoke()
    if code != 0:
        echo(Fmt"FAIL runTextNegativeSmoke: {code}")
        return code
    echo("web_runtime_text_assertions=measure/negative")
    echo("web_runtime_text_smoke ok")
    return 0
