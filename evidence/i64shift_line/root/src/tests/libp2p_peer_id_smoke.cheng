import std/system
import std/strings
import std/rawbytes
import cheng/libp2p/core/types
import cheng/libp2p/core/peer_id

fn main(): int32 =
    let knownRaw = BytesAlloc(38)
    for i in 0..<38:
        BytesSet(knownRaw, i, 0)
    BytesSet(knownRaw, 1, 36)
    BytesSet(knownRaw, 2, 0x08)
    BytesSet(knownRaw, 3, 0x01)
    BytesSet(knownRaw, 4, 0x12)
    BytesSet(knownRaw, 5, 0x20)
    assert(peer_id.Libp2pEncodeBase58(knownRaw) ==
           "12D3KooW9pNAk8aiBuGVQtWRdbkLmo5qVL3e2h5UxbN2Nz9ttwiw",
           " libp2p peer id: known raw text")
    let knownDecodeRes = peer_id.Libp2pDecodeBase58("12D3KooW9pNAk8aiBuGVQtWRdbkLmo5qVL3e2h5UxbN2Nz9ttwiw")
    assert(IsOk(knownDecodeRes), " libp2p peer id: known decode")
    let knownDecoded = Value(knownDecodeRes)
    assert(BytesLen(knownDecoded) == 38, " libp2p peer id: known decode size")
    assert(BytesGet(knownDecoded, 0) == 0 &&
           BytesGet(knownDecoded, 1) == 36 &&
           BytesGet(knownDecoded, 2) == 0x08 &&
           BytesGet(knownDecoded, 3) == 0x01 &&
           BytesGet(knownDecoded, 4) == 0x12 &&
           BytesGet(knownDecoded, 5) == 0x20,
           " libp2p peer id: known decode header")
    var peerA: types.Libp2pPeerId
    peer_id.Libp2pPeerIdFillFromSeed(peerA, "alice")
    var peerB: types.Libp2pPeerId
    peer_id.Libp2pPeerIdFillFromSeed(peerB, "bob")
    assert(!types.Libp2pPeerIdEqual(peerA, peerB), " libp2p peer id: distinct")
    assert(peer_id.Libp2pPeerIdDistance(peerA, peerB) > int64(0), " libp2p peer id: distance")
    let peerABytes = peer_id.Libp2pPeerIdBytes(peerA.value)
    assert(BytesGet(peerABytes, 0) == 0, " libp2p peer id: identity code")
    assert(BytesGet(peerABytes, 1) == 36, " libp2p peer id: proto size")
    assert(BytesGet(peerABytes, 2) == 0x08 &&
           BytesGet(peerABytes, 3) == 0x01 &&
           BytesGet(peerABytes, 4) == 0x12 &&
           BytesGet(peerABytes, 5) == 0x20,
           " libp2p peer id: protobuf header")
    let peerAText = peer_id.Libp2pPeerIdText(peerA)
    assert(strings.HasPrefix(peerAText, "12D3Koo"), " libp2p peer id: standard text")
    let peerDecodeRes = peer_id.Libp2pDecodeBase58(peerAText)
    assert(IsOk(peerDecodeRes), " libp2p peer id: peer decode")
    let peerDecoded = Value(peerDecodeRes)
    assert(BytesLen(peerDecoded) == 38, " libp2p peer id: peer decode size")
    assert(BytesGet(peerDecoded, 0) == 0 &&
           BytesGet(peerDecoded, 1) == 36 &&
           BytesGet(peerDecoded, 2) == 0x08 &&
           BytesGet(peerDecoded, 3) == 0x01 &&
           BytesGet(peerDecoded, 4) == 0x12 &&
           BytesGet(peerDecoded, 5) == 0x20,
           " libp2p peer id: peer decode header")
    let peerPubRes = peer_id.Libp2pPeerPublicKeyFromPeerIdBytes(peerDecoded)
    assert(IsOk(peerPubRes), " libp2p peer id: peer decode pubkey")
    let roundtripRes = peer_id.Libp2pPeerIdFromText(peerAText)
    assert(IsOk(roundtripRes), " libp2p peer id: parse text")
    assert(types.Libp2pPeerIdEqual(Value(roundtripRes), peerA), " libp2p peer id: roundtrip")
    let invalidPrefixRes = peer_id.Libp2pPeerIdFromText("z")
    assert(IsErr(invalidPrefixRes), " libp2p peer id: reject bare multibase prefix")
    echo(" libp2p_peer_id_smoke ok")
    return 0
