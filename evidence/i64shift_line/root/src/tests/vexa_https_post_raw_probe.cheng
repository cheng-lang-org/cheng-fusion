import std/os as os
import std/strings

@importc("calloc")
fn httpsPostRawProbeCalloc(count: int64, size: int64): ptr

@importc("memcpy")
fn httpsPostRawProbeMemcpy(dst: ptr, src: ptr, count: int64): ptr

@importc("strlen")
fn httpsPostRawProbeStrlen(raw: ptr): int64

@importc("cheng_http_request_with_timeout")
fn httpsPostRawProbeHttpRequestWithTimeout(method: cstring,
                                           url: cstring,
                                           body: cstring,
                                           headers: cstring,
                                           timeoutSeconds: int32): cstring

fn httpsPostRawProbeCString(text: str): cstring =
    let raw = httpsPostRawProbeCalloc(int64(text.len) + int64(1), int64(1))
    if raw == nil:
        return cstring(nil)
    if text.len > 0:
        httpsPostRawProbeMemcpy(raw, text.data, int64(text.len))
    return cstring(raw)

fn main(): int32 =
    let out = httpsPostRawProbeHttpRequestWithTimeout(httpsPostRawProbeCString("POST"),
                                                      httpsPostRawProbeCString("https://example.com/"),
                                                      httpsPostRawProbeCString("x"),
                                                      httpsPostRawProbeCString("[\"Content-Type: text/plain\"]"),
                                                      15)
    if ptr(out) == nil:
        os.WriteLine(os.Get_stderr(), "https post response nil")
        return 1
    let n = int32(httpsPostRawProbeStrlen(ptr(out)))
    if n <= 0:
        os.WriteLine(os.Get_stderr(), "https post response empty")
        return 1
    os.WriteLine(os.Get_stdout(), strings.ConcatStr("https_post_response_len=", strings.IntToStr(n)))
    os.WriteLine(os.Get_stdout(), "vexa_https_post_raw_probe ok")
    return 0
