import cheng/core/runtime/web_runtime as web
import cheng/core/runtime/web_style_runtime as style

fn runStyleCascadeSmoke(): int32 =
    var document: web.WebDocument
    web.WebDocumentInit(document)
    let docNode = web.WebDocumentCreateDocumentNode(document)
    let root = web.WebDocumentCreateElement(document, "div")
    let button = web.WebDocumentCreateElement(document, "button")
    let plainButton = web.WebDocumentCreateElement(document, "button")
    let label = web.WebDocumentCreateText(document, "Run")

    if !web.WebDocumentAppendChild(document, docNode, root):
        return 1
    if !web.WebDocumentAppendChild(document, root, button):
        return 2
    if !web.WebDocumentAppendChild(document, button, label):
        return 3
    if !web.WebDocumentAppendChild(document, root, plainButton):
        return 30
    if !web.WebDocumentSetAttribute(document, button, "id", "run"):
        return 4
    if !web.WebDocumentSetAttribute(document, button, "class", "primary hot"):
        return 5

    var sheet: style.WebStyleSheet
    style.WebStyleSheetInit(sheet)
    if !style.WebStyleSheetParse("button { color: red; display: inline; margin-left: 1px; flex-shrink: 1; } .primary { color: blue; margin-left: 2px; flex-shrink: 0; } #run { display: block; } button { color: green; } div { gap: 8px; text-align: center; white-space: nowrap; text-overflow: ellipsis; }", sheet):
        return 6
    if !web.WebDocumentSetInlineStyleValue(document, button, "marginLeft", "4px"):
        return 93
    if !web.WebDocumentSetInlineStyleValuePriority(document, button, "display", "inline", "important"):
        return 94
    if web.WebDocumentSetInlineStyleValuePriority(document, button, "display", "block", "urgent"):
        return 95
    var inlineValue: str
    if !web.WebDocumentGetInlineStyleValue(document, button, "marginLeft", inlineValue):
        return 96
    if inlineValue != "4px":
        return 97
    if style.WebStyleSheetRuleCount(sheet) != 5:
        return 7
    if !style.WebStyleSheetRuleSelectorEquals(sheet, 0, "button"):
        return 70
    if style.WebStyleSheetRuleSelectorKindAt(sheet, 0) != style.WebCssSelectorTag:
        return 72
    var buttonTag: str
    if !web.WebDocumentNodeTagName(document, button, buttonTag):
        return 73
    if buttonTag != "button":
        return 74
    if !style.WebStyleSheetRuleMatches(document, sheet, 0, button):
        return 8
    if !style.WebStyleSheetRuleMatches(document, sheet, 1, button):
        return 9
    if !style.WebStyleSheetRuleMatches(document, sheet, 2, button):
        return 10
    if !style.WebStyleSheetRuleMatches(document, sheet, 3, button):
        return 11
    if style.WebStyleSheetRuleMatches(document, sheet, 1, root):
        return 12
    if style.WebStyleSheetRuleMatches(document, sheet, 0, label):
        return 13

    var computed: style.WebComputedStyle
    if !style.WebStyleSheetComputeStyle(document, sheet, button, computed):
        return 14
    if !computed.hasColor || !style.WebComputedStyleColorEquals(computed, "blue"):
        return 15
    if !computed.hasDisplay || !style.WebComputedStyleDisplayEquals(computed, "inline"):
        return 16
    if !computed.hasMarginLeft || !style.WebComputedStyleMarginLeftEquals(computed, "4px"):
        return 17
    var flexShrinkVal: int32
    if !style.WebComputedStyleFlexShrinkInt(computed, flexShrinkVal):
        return 100
    if flexShrinkVal != 0:
        return 101

    var plainComputed: style.WebComputedStyle
    if !style.WebStyleSheetComputeStyle(document, sheet, plainButton, plainComputed):
        return 75
    if !plainComputed.hasColor || !style.WebComputedStyleColorEquals(plainComputed, "green"):
        return 76
    if !plainComputed.hasDisplay || !style.WebComputedStyleDisplayEquals(plainComputed, "inline"):
        return 77
    if !plainComputed.hasMarginLeft || !style.WebComputedStyleMarginLeftEquals(plainComputed, "1px"):
        return 78
    if !style.WebComputedStyleFlexShrinkInt(plainComputed, flexShrinkVal):
        return 102
    if flexShrinkVal != 1:
        return 103

    var rootComputed: style.WebComputedStyle
    if !style.WebStyleSheetComputeStyle(document, sheet, root, rootComputed):
        return 18
    if rootComputed.hasColor || rootComputed.hasDisplay || rootComputed.hasMarginLeft:
        return 19
    var gapPx: int32
    if !style.WebComputedStyleColumnGapPx(rootComputed, gapPx):
        return 25
    if gapPx != 8:
        return 26
    if !style.WebComputedStyleRowGapPx(rootComputed, gapPx):
        return 27
    if gapPx != 8:
        return 28
    if !rootComputed.hasTextAlign || !style.WebComputedStyleTextAlignEquals(rootComputed, "center"):
        return 29
    if !rootComputed.hasWhiteSpace || !style.WebComputedStyleWhiteSpaceEquals(rootComputed, "nowrap"):
        return 98
    if !rootComputed.hasTextOverflow || !style.WebComputedStyleTextOverflowEquals(rootComputed, "ellipsis"):
        return 99
    var badSheet: style.WebStyleSheet
    if style.WebStyleSheetParse("button.primary { color: red; }", badSheet):
        return 20
    if style.WebStyleSheetParse("button { width: auto; }", badSheet):
        return 21
    if style.WebStyleSheetParse("button { color red; }", badSheet):
        return 22
    if style.WebStyleSheetParse("button, .primary { color: red; }", badSheet):
        return 23
    if style.WebStyleSheetComputeStyle(document, sheet, label, computed):
        return 24
    return 0

fn main(): int32 =
    let code = runStyleCascadeSmoke()
    if code != 0:
        echo(Fmt"FAIL runStyleCascadeSmoke: {code}")
        return code
    echo(" web_runtime_style_smoke ok")
    return 0
