import std/os
import std/seqs as seqs
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/tooling/compiler_csg_production_lifetime as csglife
import cheng/core/tooling/compiler_payload_lifecycle as payload

fn runCompilerCsgProductionLifetime(outcome: int32): bool =
    var csg: ccsg.CompilerCsg
    seqs.setLen(csg.nodes, 2)
    csg.nodes[0].modulePath = "cheng/lifetime"
    csg.nodes[0].symbolText = "main"
    csg.nodes[1].semanticSource =
        "src/tests/compiler_csg_production_lifetime_smoke.cheng"
    seqs.setLen(csg.edges, 1)
    let retainedBytes =
        ccsg.CompilerCsgLifecycleRetainedBytes(csg)
    let physicalBufferCount =
        ccsg.CompilerCsgLifecycleTrackedPhysicalBufferCount(csg)
    if retainedBytes <= int64(0) ||
       physicalBufferCount <= 0:
        return false

    var producerState: csglife.CompilerCsgProductionLifetime
    csglife.CompilerCsgProductionLifetimeBegin(
        csg,
        producerState)
    csglife.CompilerCsgProductionLifetimeBorrowForLowering(
        csg,
        producerState)
    csglife.CompilerCsgProductionLifetimeReturnFromLowering(
        producerState)

    var terminalState: csglife.CompilerCsgProductionLifetime
    csglife.CompilerCsgProductionLifetimeTransferInto(
        producerState,
        terminalState)
    if producerState.active ||
       !terminalState.active:
        return false
    csglife.CompilerCsgProductionLifetimeEndUnmoved(
        csg,
        terminalState,
        outcome)
    var receipt: payload.CompilerPayloadLifecycleReceipt
    csglife.CompilerCsgProductionLifetimeReceiptInto(
        terminalState,
        receipt)
    return csglife.CompilerCsgProductionLifetimeReceiptClosed(
               receipt) &&
           receipt.outcome == outcome &&
           receipt.allocated == int64(1) &&
           receipt.released == int64(1) &&
           receipt.live == int64(0) &&
           receipt.allocatedBytes == retainedBytes &&
           receipt.releasedBytes == retainedBytes &&
           receipt.liveBytes == int64(0) &&
           receipt.retained == int64(1) &&
           receipt.borrowReturnCount == int64(1) &&
           receipt.ownerTransferCount == int64(0) &&
           receipt.physicalBufferCount == physicalBufferCount &&
           receipt.physicalFreeCount ==
               int64(physicalBufferCount) &&
           receipt.storageReleased &&
           receipt.ledgerStorageReleased &&
           ccsg.CompilerCsgLifecycleStorageReleased(csg)

fn main(): int32 =
    if !runCompilerCsgProductionLifetime(
            payload.CompilerPayloadOutcomeSuccess):
        return 1
    if !runCompilerCsgProductionLifetime(
            payload.CompilerPayloadOutcomeDiagnostic):
        return 2
    if !runCompilerCsgProductionLifetime(
            payload.CompilerPayloadOutcomeCancel):
        return 3
    if !runCompilerCsgProductionLifetime(
            payload.CompilerPayloadOutcomeEarlyReturn):
        return 4
    if !runCompilerCsgProductionLifetime(
            payload.CompilerPayloadOutcomeCacheReuse):
        return 5
    for iteration in 0..<100:
        if !runCompilerCsgProductionLifetime(
                payload.CompilerPayloadOutcomeSuccess):
            return 10
    os.WriteLine(
        os.Get_stdout(),
        "compiler_csg_production_lifetime ok paths=5 cycles=100 live=0 physical_release=1 ledger_storage_released=1")
    return 0
