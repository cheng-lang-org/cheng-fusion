import cheng/core/lang/typed_expr as texpr

fn main(): int32 =
    let sourcePath = "/work/pkg/main.cheng"
    var ir: texpr.TypedExprIr
    ir.buildIndex = texpr.TypedExprBuildIndexNew(32)
    texpr.TypedExprIrAppendTypeFieldLayout(ir,
                                           sourcePath,
                                           "CtorRow",
                                           "left",
                                           "int32",
                                           0,
                                           4,
                                           4)
    texpr.TypedExprIrAppendTypeFieldLayout(ir,
                                           sourcePath,
                                           "CtorRow",
                                           "right",
                                           "int32",
                                           4,
                                           4,
                                           4)
    texpr.TypedExprIrAppendTypeLayout(ir, sourcePath, "CtorRow", 8, 4, 2)
    texpr.TypedExprIrAppendTypeFieldLayout(ir,
                                           sourcePath,
                                           "Pair",
                                           "left",
                                           "int32",
                                           0,
                                           4,
                                           4)
    texpr.TypedExprIrAppendTypeFieldLayout(ir,
                                           sourcePath,
                                           "Pair",
                                           "right",
                                           "int32",
                                           4,
                                           4,
                                           4)
    texpr.TypedExprIrAppendTypeLayout(ir, sourcePath, "Pair", 8, 4, 2)

    var ctx: texpr.TypedExprSourceContext
    ctx.sourcePath = sourcePath
    if !texpr.TypedExprBindingRhsIsAggregateConstructor(
            ir,
            ctx,
            "CtorRow(left: Touch(1), right: Touch(2))"):
        return 1
    if !texpr.TypedExprBindingRhsIsAggregateConstructor(
            ir,
            ctx,
            "CtorRow { left: Touch(3), right: Touch(4) }"):
        return 2
    if !texpr.TypedExprBindingRhsIsAggregateConstructor(
            ir,
            ctx,
            "CtorRow(left: Choose(flag: Ready(1), value: Touch(2)), right: 1 + Touch(3))"):
        return 3
    if !texpr.TypedExprBindingRhsIsAggregateConstructor(
            ir,
            ctx,
            "CtorRow(left: Touch(1), right: Touch(2),)"):
        return 4

    # A complete named-field surface resolves to the real aggregate layout,
    # even when the value namespace contains an identically named function.
    if !texpr.TypedExprBindingRhsIsAggregateConstructor(
            ir,
            ctx,
            "Pair(left: Touch(5), right: Touch(6))"):
        return 5
    if texpr.TypedExprBindingRhsIsAggregateConstructor(
            ir,
            ctx,
            "Named(left: Touch(7), right: Touch(8))"):
        return 6
    # Brace syntax shares the same aggregate layout contract.
    if !texpr.TypedExprBindingRhsIsAggregateConstructor(
            ir,
            ctx,
            "Pair { left: Touch(9), right: Touch(10) }"):
        return 7

    if texpr.TypedExprBindingRhsIsAggregateConstructor(
            ir,
            ctx,
            "CtorRow(Touch(1), Touch(2))"):
        return 8
    if texpr.TypedExprBindingRhsIsAggregateConstructor(
            ir,
            ctx,
            "Unknown(left: Touch(1), right: Touch(2))"):
        return 9
    if texpr.TypedExprBindingRhsIsAggregateConstructor(
            ir,
            ctx,
            "Use(CtorRow(left: Touch(1), right: Touch(2)))"):
        return 10

    return 0
