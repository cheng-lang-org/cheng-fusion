import std/cmdline as cmdline
import std/os
import std/system
import cheng/std/bytes_layout as layout
import cheng/std/crypto/fixed256
import std/crypto/ecnist
import cheng/core/csg_asset/oracle_asset as asset
import cheng/tests/oracle_smoke_support as support

fn probeExpect(cond: bool, msg: str): int32 =
    if !cond:
        os.WriteLine(os.Get_stderr(), msg)
        return 1
    return 0

fn probeSignedClaim(sigHex: str, slot: int32): asset.UnimakerProductSignedSourceClaim =
    let pubKey = support.oracleSmokePubKey(slot)
    var claim: asset.UnimakerProductSourceClaim
    claim.id = "claim_unimaker_runtime_product_001"
    claim.productId = "unimaker_runtime_product_001"
    claim.sourceId = "obs_unimaker_runtime_product_001"
    claim.sellerId = "did:unimaker:seller_runtime"
    claim.titleHash = asset.AssetSha256("runtime product title")
    claim.licenseHash = asset.AssetSha256("runtime product license")
    claim.mediaAssetCid = "bafybeigdyrztruntime001"
    claim.priceE8 = int64(660000000)
    claim.inventory = int64(12)
    claim.observedAtMs = int64(1800000)
    claim.ttlMs = int64(120000)
    claim.oracleReceiptHash = asset.AssetSha256("runtime oracle receipt")
    claim.signerHash = asset.UnimakerProductSignerHash(pubKey)
    claim.authorized = true
    let sigRes = layout.FixedBytes64FromHex(sigHex)
    if IsErr(sigRes):
        system.Panic(Error(sigRes))
    var out: asset.UnimakerProductSignedSourceClaim
    out.claim = claim
    out.signerPubKey = pubKey
    out.signature = Value(sigRes)
    return out

fn main(argc: int32, argv: str*): int32 =
    argc
    argv
    cmdline.CaptureCmdLine(argc, argv)
    var sigHex = "d628b48c962dd4f2664fe04043bbb9e8362f2a8efb01567d5484c762c3bc47932ced932c23591fdc6ecfbd4fa064087c270b35e92f6080d10ea2bdef432674a6"
    var slot: int32 = 1
    if cmdline.ParamCount() >= 1 && len(cmdline.ParamStr(1)) > 0:
        sigHex = cmdline.ParamStr(1)
    if cmdline.ParamCount() >= 2 && len(cmdline.ParamStr(2)) > 0:
        var parsedSlot: int32
        if cmdline.ParseInt32(cmdline.ParamStr(2), parsedSlot):
            slot = parsedSlot
    let signedClaim = probeSignedClaim(sigHex, slot)
    if probeExpect(fixed256.P256Signature64Valid(signedClaim.signature), "sig invalid") != 0:
        return 1
    if probeExpect(signedClaim.claim.signerHash == asset.UnimakerProductSignerHash(signedClaim.signerPubKey),
                   "signer hash mismatch") != 0:
        return 1
    let pubBytes = layout.FixedBytes65ToBytes(signedClaim.signerPubKey)
    let msg = asset.UnimakerProductSignedClaimSignableBytes(signedClaim.claim)
    let sigBytes = layout.FixedBytes64ToBytes(signedClaim.signature)
    let ecdsaOk = ecnist.ecdsaVerifyTrustedBytes(pubBytes, msg, sigBytes)
    if probeExpect(ecdsaOk, "ecdsa false") != 0:
        return 1
    let verifyRes = asset.UnimakerProductSignedSourceClaimVerify(signedClaim)
    if probeExpect(IsOk(verifyRes), "unimaker product signed claim verify failed") != 0:
        if IsErr(verifyRes):
            os.WriteLine(os.Get_stderr(), Error(verifyRes))
        return 1
    os.WriteLine(os.Get_stdout(), "unimaker_product_signed_claim_verify_probe ok")
    return 0
