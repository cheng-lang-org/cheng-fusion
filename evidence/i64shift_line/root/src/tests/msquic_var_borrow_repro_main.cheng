import cheng/tests/msquic_var_borrow_repro_mod as probe

const PROBE_N: int32 = 4

var
    probeConns: probe.ProbeConn[PROBE_N]
    probeStore: probe.ProbeStore
    probeCur: int32

fn main(): int32 =
    probeConns[0].slot = 3
    var f: probe.ProbeFlow
    f.credit = 11
    f.limit = 22
    probe.ProbeStoreSetFlow(probeStore, 1, f)
    if probeStore.flows[1].credit != 11:
        return 5
    if probe.ProbeConnHasQueued(probeConns[probeCur]):
        return 7
    return 0
