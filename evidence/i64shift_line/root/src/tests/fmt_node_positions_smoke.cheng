# K3-R7A: Fmt interpolation must lower through structured nodes in every
# expression position (assign / local-decl / return / call-arg) with
# {str}/{i32}/{i64}/struct-field/{x.len} pieces. The interpolated call must
# be emitted exactly once (side-effect counter observes double emission).

type
    Item =
        id: int32
        score: int64

fn bumpInto(c: var int32, v: int32): int32 =
    c = c + 1
    return v

fn describe(tag: str, n: int32): str =
    return Fmt"{tag}:{n}"

fn wrap(s: str): str =
    return Fmt"[{s}]"

fn main(): int32 =
    let name = "hello"
    var count: int32 = 7
    var big: int64 = 1234567890
    let s0 = Fmt"plain"
    if s0 != "plain":
        return 1
    let s1 = Fmt"n={name} c={count} b={big}"
    if s1 != "n=hello c=7 b=1234567890":
        return 2
    var it: Item
    it.id = 42
    it.score = 99
    var s2 = ""
    s2 = Fmt"id={it.id} s={it.score} len={name.len}"
    if s2 != "id=42 s=99 len=5":
        return 3
    let s3 = describe("tag", 3)
    if s3 != "tag:3":
        return 4
    var calls: int32
    let s4 = Fmt"v={bumpInto(calls, 41)}"
    if calls != 1:
        return 5
    if s4 != "v=41":
        return 6
    let s5 = wrap(Fmt"k={count}")
    if s5 != "[k=7]":
        return 7
    return 0
