# AD1 negative control `_ad1_scratch_poison` (ar2 line; design
# .rebuild/ad1_line/ARENA_ROUTING_DESIGN.md §5.4) -- REPLICA form, inlined,
# scalar-only (platform walls recorded in report §6).
#
# Pinned here: the poison contract the audit organ implements at reserve
# time -- poison the full reserved span, truncate the logical length to
# zero WITHOUT touching the reservation (ParserScratchSeqLenTruncate moves
# len, never the reservation), refill real values at the front -- and an
# over-running consumer then observes the 0xA5A5A5A5 pattern, never a
# plausible zero.  Four scalar slots stand in for the reserved span.
# Exit 0 = the contract held; nonzero = one clause broken.

fn main(): int32 =
    # The audit poison pattern: 0xA5A5A5A5 as int32.
    var poisoned: int32
    poisoned = 0 - 1515870811
    # Reserved span: capacity 4, logical length 0 (post-Reserve state).
    var s0: int32
    var s1: int32
    var s2: int32
    var s3: int32
    # Reserve-time poison: fill the full capacity.
    s0 = poisoned
    s1 = poisoned
    s2 = poisoned
    s3 = poisoned
    # Truncate-to-zero moves len only; the reservation keeps every byte.
    # Refill real values through the add-at-len contract.
    var colLen: int32
    if colLen == 0:
        s0 = 7
        colLen = colLen + 1
    if colLen == 1:
        s1 = 9
        colLen = colLen + 1
    if colLen != 2:
        return 2
    if s0 != 7:
        return 3
    if s1 != 9:
        return 4
    # An over-running consumer that reads unwritten slot 3 (still inside
    # the reservation, outside the logical length) observes the poison
    # pattern -- never a silent zero that could pass for a value.
    if s3 != poisoned:
        return 5
    return 0
