fn __csg_dump_dom_styles(document: var web.WebDocument, runtime: var react.ReactRuntime) =
    echo("---CHENG_DOM_DUMP---")
    web.WebDocumentDumpDOM(document)
    # Apply inline styles (chunked across small functions)
    __csg_styles_0(document, runtime)
    __csg_styles_1(document, runtime)
    __csg_styles_2(document, runtime)
    __csg_styles_3(document, runtime)
