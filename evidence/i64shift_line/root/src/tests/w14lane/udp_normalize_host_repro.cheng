# w14-quicudp repro: udpNormalizeHost if/else-str-return with IPv6 literal
# containing a literal ':' inside the arm ("::1") must not poison(805).
# Root cause: PrimaryBodyIrAppendStrTernaryDeclValue's ?/: top-level split
# used the non-quote-aware TypedExprFindTopLevelTextToken, which stopped on
# the ':' inside "::1" instead of the real then/else separator.

import std/os

fn udpNormalizeHost(host: str, isV6: bool): str =
    if len(host) <= 0:
        return if isV6: "::1" else: "127.0.0.1"
    return host

fn main(): int32 =
    let a: str = udpNormalizeHost("", true)
    let b: str = udpNormalizeHost("", false)
    let c: str = udpNormalizeHost("example.com", true)
    if a != "::1":
        os.WriteLine(os.GetStderr(), "FAIL a=" + a)
        return 1
    if b != "127.0.0.1":
        os.WriteLine(os.GetStderr(), "FAIL b=" + b)
        return 1
    if c != "example.com":
        os.WriteLine(os.GetStderr(), "FAIL c=" + c)
        return 1
    os.WriteLine(os.GetStdout(), "PASS")
    return 0
