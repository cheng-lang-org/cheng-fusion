import std/os
import std/rawbytes
import cheng/quic/core/quic_varint as quic_varint

type
    QuicPacketHeaderVarIntDecoded = quic_varint.QuicVarIntDecoded
    QuicPacketHeaderDecoded =
        header: int32
        next: int32

@borrows
fn quicPacketHeaderDecode(data: Bytes, offset: int32): Result[QuicPacketHeaderDecoded] =
    let pnRes: Result[QuicPacketHeaderVarIntDecoded] = quic_varint.quicVarIntDecode(data, offset)
    if IsErr(pnRes):
        return Err[QuicPacketHeaderDecoded](ErrorText(pnRes))
    return Ok[QuicPacketHeaderDecoded](QuicPacketHeaderDecoded(header: 1, next: Value(pnRes).next))

fn main(): int32 =
    let data: Bytes = BytesAlloc(4)
    BytesSet(data, 0, 5)
    let res = quicPacketHeaderDecode(data, 0)
    if IsErr(res):
        os.WriteLine(os.GetStderr(), "FAIL err")
        return 1
    let v = Value(res)
    if v.next != 1:
        os.WriteLine(os.GetStderr(), Fmt"FAIL next={v.next}")
        return 1
    os.WriteLine(os.GetStdout(), "PASS")
    return 0
