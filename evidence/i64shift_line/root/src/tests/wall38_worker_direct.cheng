# wall38 前置墙最小探针 v2：worker 直传形（ptr cast ref + work.plan 直接作 var-out）。
# = f7a88ae28 staging 之前的形态。
type
    W38Plan = object
        text: str
        ok: bool

    W38Work = ref object
        plan: W38Plan
        err: str
        ok: bool

fn w38BuildPlanInto(channel: str, plan: var W38Plan, err: var str): bool =
    plan.text = channel
    plan.ok = true
    err = ""
    return true

fn w38Worker(raw: ptr) =
    if raw == nil:
        return
    let work: W38Work = W38Work(raw)
    if !w38BuildPlanInto("ch", work.plan, work.err):
        work.ok = false
        return
    work.ok = true

fn main(): int32 =
    return 0
