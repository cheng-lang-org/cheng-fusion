@profile("driver_safe")

type
    IoUInt8Ptr = uint8 *
    IoUInt32Ptr = uint32 *

@trusted_abi
fn IoLd32s(base: uint64, offset: uint64): int32 =
    let b = base
    let o = offset
    let addr = ptr(b + o)
    return int32(*(IoUInt32Ptr(addr)))

@trusted_abi
fn IoSt8(base: uint64, offset: uint64, value: int32) =
    let b = base
    let o = offset
    let addr = ptr(b + o)
    *(IoUInt8Ptr(addr)) = uint8(value & 255)

fn PlainAnswer(v: int32): int32 =
    return v + 1

@trusted_abi
fn TrustedAnswer(v: int32): int32 =
    return v + 2

fn HexNib(v: int32) =
    let w = v
    if w < 10:
        IoSt8(268435456, 0, int32(48 + w))
    else:
        IoSt8(268435456, 0, int32(87 + w))

fn Hex32(v: int32) =
    var div = 268435456
    while div > 0:
        HexNib((v / div) & 15)
        div = div / 16

fn Sep() =
    IoSt8(268435456, 0, 32)

fn GpuRosMain(): int32 =
    let a = PlainAnswer(40)
    Hex32(a)
    Sep()
    let b = TrustedAnswer(40)
    Hex32(b)
    Sep()
    let o0 = uint64(0)
    let m = IoLd32s(uint64(268468224), o0)
    Hex32(m)
    IoSt8(268435456, 0, 10)
    return 0

fn main(): int32 =
    return GpuRosMain()
