# EOS full-playback semantics check (docs/cheng-video-e2e-miaofa-miaokai-plan.md §S4).
#
# Drives the SAME production dual-track playback chain a real device runs — real
# media_moq_publisher_main, real QUIC, real hgs fixture bytes — and asserts the S4
# state machine branch-by-branch as defined in web_scene_media_network_bridge.cheng's
# "S4 EOS 完整播放语义" block:
#
#   1.  fresh open (video only): EosState==0, no latch, receipt 0
#   2.  audio open rides the persistent connection: still State 0
#   3.  StreamLoop sweeps every frame to rc=7: VideoEosLatched; audio not drained yet
#       => EosState==2 (video-eos-only) AND EosCompleteReceipt stays 0 — single-track
#       EOF must NEVER claim 完整播放 (the audio-first-race verdict mirrored)
#   4.  AdvanceCursor drives the audio clock to its last AU => -1 latches audio:
#       EosState==3, receipt==1 (the ONLY complete corner)
#   5.  idempotence: further StreamLoop ticks stay rc=7, receipt stays 1
#   6.  SeekToFrame(0) re-arms video: state falls back to 1 (audio-eos-only — the race
#       window seen from the other side); receipt keeps its earned 1
#   7.  AudioEsSeekToVideoFrame(0) un-latches audio: state 0
#   8.  second full pass converges again: receipt==2 (complete edges accumulate per run)
#
# Host sink: src/tests/host_stub/es_pump_backpressure_test_host_stub.c (same one the
# sequential sweep uses — accepts every frame, returns 1, exposes
# cheng_test_es_sink_captured). Prints EOS_CHECK_OK on success; any violation prints
# FAIL:<reason> and exits nonzero.

import std/os
import std/strutils as strutil
import std/cmdline as cmdline
import cheng/core/runtime/web_scene_media_network_bridge as media_bridge

@importc("cheng_test_es_sink_captured")
fn chengTestEsSinkCaptured(): int32

# Re-read a string flag into an independent owned value (each cmdline read yields its
# own buffer), so two owning str call sites each hand over their own copy — no shared
# local gets consumed twice (lessons 生产形: 无 @borrows 的 str 形参会吃掉实参).
fn readHostFlag(): str =
    var raw: str
    let has: bool = cmdline.ReadFirstFlagValue("--host", raw)
    return if has: raw else: "127.0.0.1"

fn fail(msg: str): int32 =
    os.WriteLine(os.Get_stdout(), strutil.Join(["FAIL: ", msg], ""))
    return 1

# Sweep the video track from the current cursor to EOF over real QUIC. Returns 0 on
# rc=7 convergence; nonzero reason otherwise.
fn sweepVideoToEnd(): int32 =
    var tick: int32 = 0
    var running: bool = true
    while running:
        let rc: int32 = media_bridge.WebSceneMediaEsStreamLoop()
        if rc == 7:
            running = false
        elif rc == 0:
            tick = tick + 1
            if tick > 100000:
                return fail("sweep: tick budget exhausted without reaching EOF (stall?)")
        else:
            return fail(strutil.Join(["sweep: unexpected rc=", IntToStr(rc), " err=", media_bridge.WebSceneMediaEsLastError()], ""))
    return 0

fn main(): int32 =
    var hostRaw: str
    let hasHost: bool = cmdline.ReadFirstFlagValue("--host", hostRaw)
    let host: str = if hasHost: hostRaw else: "127.0.0.1"
    let port: int32 = cmdline.ReadInt32FlagOrDefault("--port", 38000)

    # Branch 0: nothing open — projection reports in-progress/unknown-free corner (0),
    # receipts zeroed.
    if media_bridge.WebSceneMediaEsEosState() != 0 || media_bridge.WebSceneMediaEsEosCompleteReceipt() != 0:
        return fail(strutil.Join(["fresh process eosState=", IntToStr(media_bridge.WebSceneMediaEsEosState()), " want=0"], ""))

    # host feeds two owning (non-borrowed) str parameters below — each call site hands
    # over its own independently-read value.
    if !media_bridge.WebSceneMediaEsOpen(readHostFlag(), port):
        return fail(strutil.Join(["es_open failed: ", media_bridge.WebSceneMediaEsLastError()], ""))
    let frameCount: int32 = media_bridge.WebSceneMediaEsFrameCount()
    if frameCount <= 0:
        return fail("frame count is zero after open")
    if media_bridge.WebSceneMediaEsVideoEosLatched():
        return fail("video EOS latched by a fresh open")
    if media_bridge.WebSceneMediaEsEosState() != 0 || media_bridge.WebSceneMediaEsEosCompleteReceipt() != 0:
        return fail("open alone produced an EOS corner")
    os.WriteLine(os.Get_stdout(), strutil.Join(["step1_video_open_ok frames=", IntToStr(frameCount)], ""))

    # Audio rides the persistent connection (single publisher slot discipline).
    if !media_bridge.WebSceneMediaAudioEsOpen(readHostFlag(), port):
        return fail(strutil.Join(["audio_es_open failed: ", media_bridge.WebSceneMediaAudioEsLastError()], ""))
    let audioFrames: int32 = media_bridge.WebSceneMediaAudioEsFrameCount()
    if audioFrames <= 0:
        return fail("audio frame count is zero after audio open")
    if media_bridge.WebSceneMediaEsEosState() != 0:
        return fail(strutil.Join(["eosState after audio open=", IntToStr(media_bridge.WebSceneMediaEsEosState()), " want=0"], ""))
    os.WriteLine(os.Get_stdout(), strutil.Join(["step2_audio_open_ok audioFrames=", IntToStr(audioFrames)], ""))

    # Branches 3: full video drain to rc=7 with the audio clock NOT yet drained.
    let sweepRc: int32 = sweepVideoToEnd()
    if sweepRc != 0:
        return sweepRc
    if chengTestEsSinkCaptured() != frameCount:
        return fail(strutil.Join(["sink captured=", IntToStr(chengTestEsSinkCaptured()), " want frames=", IntToStr(frameCount)], ""))
    if !media_bridge.WebSceneMediaEsVideoEosLatched() || media_bridge.WebSceneMediaEsAudioEosLatched():
        return fail("after full video drain: videoEOS latched + audioEOS unlatched required")
    if media_bridge.WebSceneMediaEsEosState() != 2:
        return fail(strutil.Join(["eosState after video-only drain=", IntToStr(media_bridge.WebSceneMediaEsEosState()), " want=2"], ""))
    if media_bridge.WebSceneMediaEsEosCompleteReceipt() != 0:
        return fail("single-track EOF claimed completeness (receipt advanced) — forbidden")
    os.WriteLine(os.Get_stdout(), "step3_video_eos_only_ok")

    # Branch 4: run the audio clock to its tail -> dual-track convergence.
    var adv: int32 = 0
    var exhaustTicks: int32 = 0
    while adv >= 0:
        adv = media_bridge.WebSceneMediaAudioEsAdvanceCursor()
        exhaustTicks = exhaustTicks + 1
        if exhaustTicks > audioFrames + 4:
            return fail("audio advance never reported end-of-stream (-1)")
    if adv != -1 || !media_bridge.WebSceneMediaEsAudioEosLatched():
        return fail("audio exhaustion did not latch the audio EOS")
    if media_bridge.WebSceneMediaEsEosState() != 3:
        return fail(strutil.Join(["eosState after both tracks drained=", IntToStr(media_bridge.WebSceneMediaEsEosState()), " want=3"], ""))
    if media_bridge.WebSceneMediaEsEosCompleteReceipt() != 1:
        return fail(strutil.Join(["complete receipt=", IntToStr(media_bridge.WebSceneMediaEsEosCompleteReceipt()), " want=1"], ""))
    os.WriteLine(os.Get_stdout(), "step4_dual_track_complete_ok")

    # Branch 5: idempotent latch — extra pump ticks stay rc=7 and don't double-count.
    let rcAgain: int32 = media_bridge.WebSceneMediaEsStreamLoop()
    if rcAgain != 7:
        return fail(strutil.Join(["post-EOS StreamLoop rc=", IntToStr(rcAgain), " want=7"], ""))
    if media_bridge.WebSceneMediaEsEosCompleteReceipt() != 1:
        return fail("repeated post-EOS tick double-counted the completion edge")
    os.WriteLine(os.Get_stdout(), "step5_latch_idempotent_ok")

    # Branch 6: seek-back re-arms VIDEO while audio stays at its tail => the mirror
    # race window (audio-eos-only). The earned receipt is history, not revoked.
    if !media_bridge.WebSceneMediaEsSeekToFrame(0):
        return fail("SeekToFrame(0) failed")
    if media_bridge.WebSceneMediaEsVideoEosLatched():
        return fail("seek did not clear the video EOS latch")
    if media_bridge.WebSceneMediaEsEosState() != 1:
        return fail(strutil.Join(["eosState after seek-back with drained audio=", IntToStr(media_bridge.WebSceneMediaEsEosState()), " want=1"], ""))
    if media_bridge.WebSceneMediaEsEosCompleteReceipt() != 1:
        return fail("seek-back retroactively deleted the completed pass receipt")
    os.WriteLine(os.Get_stdout(), "step6_seek_rearm_race_window_ok")

    # Branch 7: seeking the AUDIO track back too un-latches it — plain in-progress.
    if !media_bridge.WebSceneMediaAudioEsSeekToVideoFrame(0):
        return fail("AudioEsSeekToVideoFrame(0) failed")
    if media_bridge.WebSceneMediaEsAudioEosLatched():
        return fail("audio seek did not clear the audio EOS latch")
    if media_bridge.WebSceneMediaEsEosState() != 0:
        return fail(strutil.Join(["eosState after full re-arm=", IntToStr(media_bridge.WebSceneMediaEsEosState()), " want=0"], ""))
    os.WriteLine(os.Get_stdout(), "step7_audio_rearm_ok")

    # Branch 8: a second full pass converges to another counted completion edge.
    let sweep2Rc: int32 = sweepVideoToEnd()
    if sweep2Rc != 0:
        return sweep2Rc
    adv = 0
    exhaustTicks = 0
    while adv >= 0:
        adv = media_bridge.WebSceneMediaAudioEsAdvanceCursor()
        exhaustTicks = exhaustTicks + 1
        if exhaustTicks > audioFrames + 4:
            return fail("pass2: audio advance never reported -1")
    if media_bridge.WebSceneMediaEsEosState() != 3 || media_bridge.WebSceneMediaEsEosCompleteReceipt() != 2:
        return fail(strutil.Join(["pass2: state=", IntToStr(media_bridge.WebSceneMediaEsEosState()), " receipt=", IntToStr(media_bridge.WebSceneMediaEsEosCompleteReceipt()), " want 3/2"], ""))
    os.WriteLine(os.Get_stdout(), "step8_second_pass_receipt_two_ok")

    os.WriteLine(os.Get_stdout(), "EOS_CHECK_OK")
    return 0
