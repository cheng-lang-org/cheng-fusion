import std/system
import std/seqs

type
    FlatBoxU8 = ref object
        s: uint8[]

@borrows
fn flatPutU8(b: FlatBoxU8, val: int32) =
    var s = b.s
    b.s = []
    s[3] = uint8(val)
    b.s = s

fn main() =
    var b: FlatBoxU8 = new(FlatBoxU8)
    var s0: uint8[]
    seqs.setLen(s0, 40)
    for i in 0..<s0.len:
        s0[i] = uint8(0)
    b.s = s0
    flatPutU8(b, 9)
    assert(b.s[3] == uint8(9), "flat d2: u8 value")
    echo("repro_flatcols_d2 ok")
