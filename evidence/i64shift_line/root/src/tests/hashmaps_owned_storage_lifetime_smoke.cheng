import std/hashmaps as hashmaps
import std/strformat
import std/system

fn main(): int32 =
    var m: hashmaps.HashMapStrInt = hashmaps.HashMapStrIntInit(4)
    assert(m.keys.buffer != nil &&
           system.memRefCount(m.keys.buffer) == 1,
           " hashmaps owned storage: keys after init")
    assert(m.vals.buffer != nil &&
           system.memRefCount(m.vals.buffer) == 1,
           " hashmaps owned storage: vals after init")
    assert(m.hashes.buffer != nil &&
           system.memRefCount(m.hashes.buffer) == 1,
           " hashmaps owned storage: hashes after init")
    assert(m.states.buffer != nil &&
           system.memRefCount(m.states.buffer) == 1,
           " hashmaps owned storage: states after init")

    for i in 0..<6:
        hashmaps.HashMapStrIntPut(m, Fmt"owned-key-{i}", i)

    assert(m.keys.len == 16, " hashmaps owned storage: first grow capacity")
    assert(m.keys.buffer != nil &&
           system.memRefCount(m.keys.buffer) == 1,
           " hashmaps owned storage: keys after grow")
    assert(m.vals.buffer != nil &&
           system.memRefCount(m.vals.buffer) == 1,
           " hashmaps owned storage: vals after grow")
    assert(m.hashes.buffer != nil &&
           system.memRefCount(m.hashes.buffer) == 1,
           " hashmaps owned storage: hashes after grow")
    assert(m.states.buffer != nil &&
           system.memRefCount(m.states.buffer) == 1,
           " hashmaps owned storage: states after grow")

    hashmaps.HashMapStrIntClear(m)
    assert(m.used == 0, " hashmaps owned storage: clear resets count")
    assert(m.keys.buffer != nil &&
           system.memRefCount(m.keys.buffer) == 1,
           " hashmaps owned storage: keys after clear")
    assert(m.vals.buffer != nil &&
           system.memRefCount(m.vals.buffer) == 1,
           " hashmaps owned storage: vals after clear")
    assert(m.hashes.buffer != nil &&
           system.memRefCount(m.hashes.buffer) == 1,
           " hashmaps owned storage: hashes after clear")
    assert(m.states.buffer != nil &&
           system.memRefCount(m.states.buffer) == 1,
           " hashmaps owned storage: states after clear")

    var spanCounts: hashmaps.HashMapPtrInt =
        hashmaps.HashMapPtrIntInit(8)
    for i in 0..<32:
        let key = (Int64(i + 1) << 32) | Int64(i + 17)
        hashmaps.HashMapPtrIntPut(spanCounts, key, i + 101)
    assert(spanCounts.used == 32,
           " hashmaps owned storage: ptr-int grow preserves count")
    for i in 0..<32:
        let key = (Int64(i + 1) << 32) | Int64(i + 17)
        var found: bool
        let value = hashmaps.HashMapPtrIntGetEx(
            spanCounts, key, found)
        assert(found && value == i + 101,
               " hashmaps owned storage: ptr-int grow preserves rows")

    echo("hashmaps_owned_storage_lifetime_smoke ok")
    return 0
