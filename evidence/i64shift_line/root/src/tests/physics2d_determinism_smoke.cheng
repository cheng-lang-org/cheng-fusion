import cheng/game/ecs
import cheng/game/physics2d

# 现行契约: 托管结构体赋值=move(消费源), 借用源显式共享走 Fmt 拷贝。
# 篡改用例需对同一已提交回执做多份独立副本, 故用借用版字段克隆。
@borrows
fn cloneReceipt(src: physics2d.Physics2dStepReceipt): physics2d.Physics2dStepReceipt =
    var out: physics2d.Physics2dStepReceipt
    out.schema = Fmt"{src.schema}"
    out.tick = src.tick
    out.dtMs = src.dtMs
    out.sourceWorldCid = Fmt"{src.sourceWorldCid}"
    out.resultWorldCid = Fmt"{src.resultWorldCid}"
    out.contactCount = src.contactCount
    out.separationIterations = src.separationIterations
    out.statusCode = src.statusCode
    out.forcesReceiptCid = Fmt"{src.forcesReceiptCid}"
    out.receiptCid = Fmt"{src.receiptCid}"
    out.trace = Fmt"{src.trace}"
    return out

fn populateWorld(world: var ecs.EcsWorld) =
    ecs.EcsWorldReset(world)
    let left = ecs.EcsWorldSpawn(world, 0, 0, 1, "cid:left")
    let right = ecs.EcsWorldSpawn(world, 900, 0, 1, "cid:right")
    assert(ecs.EcsWorldSetAabbCollider(world, left, 500, 500), "physics2d determinism: left collider")
    assert(ecs.EcsWorldSetAabbCollider(world, right, 500, 500), "physics2d determinism: right collider")
    assert(ecs.EcsWorldSetVelocity(world, left, 100, 0), "physics2d determinism: left velocity")
    assert(ecs.EcsWorldSetVelocity(world, right, -100, 0), "physics2d determinism: right velocity")

fn main(): int32 =
    var worldA: ecs.EcsWorld
    var worldB: ecs.EcsWorld
    populateWorld(worldA)
    populateWorld(worldB)
    let receiptA = physics2d.Physics2dStep(worldA, 42, 16)
    let receiptB = physics2d.Physics2dStep(worldB, 42, 16)
    assert(physics2d.Physics2dReceiptValid(receiptA), "physics2d determinism: receipt A")
    assert(physics2d.Physics2dReceiptValid(receiptB), "physics2d determinism: receipt B")
    assert(receiptA.receiptCid.len == 64, "physics2d determinism: receipt cid is sha256 hex")
    assert(receiptA.receiptCid == receiptB.receiptCid, "physics2d determinism: receipt cid")
    assert(ecs.EcsWorldCid(worldA) == ecs.EcsWorldCid(worldB), "physics2d determinism: world cid")
    var tamperedCount = cloneReceipt(receiptA)
    tamperedCount.contactCount = tamperedCount.contactCount + 1
    assert(!physics2d.Physics2dReceiptValid(tamperedCount), "physics2d determinism: tampered contact count rejected")
    var tamperedWorld = cloneReceipt(receiptA)
    tamperedWorld.resultWorldCid = Fmt"{tamperedWorld.sourceWorldCid}"
    assert(!physics2d.Physics2dReceiptValid(tamperedWorld), "physics2d determinism: tampered result world cid rejected")
    var tamperedCid = cloneReceipt(receiptA)
    tamperedCid.receiptCid = Fmt"{receiptB.sourceWorldCid}"
    assert(!physics2d.Physics2dReceiptValid(tamperedCid), "physics2d determinism: forged receipt cid rejected")
    return 0
