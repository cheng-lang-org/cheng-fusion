# Scratch: fixed key/nonce GCM-128 end-to-end. key=000102...0f,
# nonce=00112233445566778899aabb, plaintext=00112233..eeff x2 blocks.
# Prints ciphertext head after EncryptRaw and after DecryptRaw so the wrong
# side (encrypt keystream vs decrypt keystream) can be identified against
# the CommonCrypto reference (gcm_ref2.c).
import std/system
import std/rawbytes
import std/crypto/aesgcm

fn hexNib(c: int32): int32 =
    if c >= int32('0') && c <= int32('9'):
        return c - int32('0')
    if c >= int32('a') && c <= int32('f'):
        return c - int32('a') + 10
    return 0

fn bytesFromHexInto(b: Bytes, hex: str) =
    var i: int32
    while i < BytesLen(b):
        let hi: int32 = hexNib(int32(hex[i * 2]))
        let lo: int32 = hexNib(int32(hex[i * 2 + 1]))
        BytesSet(b, i, ((hi << 4) | lo) & 255)
        i = i + 1

fn main(): int32 =
    let key: Bytes = BytesAlloc(16)
    bytesFromHexInto(key, "000102030405060708090a0b0c0d0e0f")
    let nonce: Bytes = BytesAlloc(12)
    bytesFromHexInto(nonce, "00112233445566778899aabb")
    var tag: Bytes = BytesAlloc(16)
    let data: Bytes = BytesAlloc(32)
    bytesFromHexInto(data, "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff")
    var aad: rawbytes.Bytes = rawbytes.EmptyBytes()
    var keyRes: Result[aesgcm.AesGcmKey] = aesgcm.intoAesGcmKey(key)
    var key2: aesgcm.AesGcmKey = Value(keyRes)
    let enc: Result[bool] = aesgcm.aesGcmEncryptRaw(key2.rounds, key2.roundKeys, nonce, tag, data, aad)
    if IsErr(enc):
        echo("enc err")
        return 2
    # Ciphertext head verified byte-for-byte against CommonCrypto CCCrypt
    # AES-128-CTR (counter = inc32(j0)) on Apple M4 Pro.
    let gotCt: str = BytesToHex(data)
    echo(gotCt)
    let dec: Result[bool] = aesgcm.aesGcmDecryptRaw(key2.rounds, key2.roundKeys, nonce, tag, data, aad)
    if IsErr(dec):
        echo("dec err")
        return 2
    let gotPt: str = BytesToHex(data)
    echo(gotPt)
    if gotCt != "edc26959d3b5c87171f3ac3cc811a2ae83a3a67d3ecc9e0d63a7019b979cf657":
        echo("std_aesgcm128_e2e FAIL: ciphertext mismatch")
        return 1
    if gotPt != "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff":
        echo("std_aesgcm128_e2e FAIL: roundtrip mismatch")
        return 1
    echo("std_aesgcm128_e2e ok")
    return 0
    return 0
