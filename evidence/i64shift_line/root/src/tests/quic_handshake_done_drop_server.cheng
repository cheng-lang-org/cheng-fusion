import std/system
import std/rawbytes
import std/result
import std/strutils as strutil
import std/cmdline as cmdline
import cheng/libp2p/core/types
import cheng/libp2p/transports/quic_transport as qt
import cheng/quic/msquictransport_native as qtransport
import cheng/quic/connection as qconn
import cheng/quic/native_runtime as qnative

# DONE-drop fault-injection server. For every accepted connection it first arms
# msquicNativeTestDropNextAppPacket so the next ack-eliciting short send (the
# HANDSHAKE_DONE the server emits right after ServerReady) is dropped on the
# wire. A correct state machine must still complete the handshake: the client
# keeps retransmitting ClientFinished, the server re-queues HANDSHAKE_DONE on
# each duplicate ClientFinished, and the retransmit queue re-sends it on RTO
# until the client ACKs it. If recovery is broken the accept stalls and the
# whole serve window times out.
fn main(): int32 =
    let port = cmdline.ReadInt32FlagOrDefault("--port", 0)
    let readyPath = cmdline.ReadFlagOrDefault("--ready-path", "")
    let maxServe = cmdline.ReadInt32FlagOrDefault("--max-serve", 5)
    let waitMs = cmdline.ReadInt32FlagOrDefault("--wait-ms", 30000)

    var listener = qtransport.InitMsQuicTransport()
    let startRes = qt.Libp2pQuicStartListenerNamed(listener, "127.0.0.1", port, "localhost")
    if IsErr(startRes):
        panic(ErrorText(startRes))
    if !qt.Libp2pQuicWriteReadyPort(readyPath, Value(startRes)):
        qtransport.Stop(listener)
        panic(" done_drop_server: ready path write failed")

    let payload: rawbytes.Bytes = BytesAlloc(32)
    for i in 0..<32:
        BytesSet(payload, i, (0x40 + i) & 0xff)

    var servedCount: int32 = 0
    while servedCount < maxServe:
        # Arm the DONE drop for this connection's handshake.
        qnative.msquicNativeTestDropNextAppPacket()
        let acceptRes = qtransport.AcceptTimed(listener, waitMs)
        if IsErr(acceptRes):
            if ErrorText(acceptRes) == "msquic: accept timeout" ||
               qt.Libp2pQuicRetryableAcceptError(ErrorText(acceptRes)):
                qt.Libp2pQuicWriteStderr(strutil.Join(["done_drop_server: accept_retryable=", ErrorText(acceptRes)], ""))
                continue
            qtransport.Stop(listener)
            panic(strutil.Join(["done_drop_server: accept_fatal=", ErrorText(acceptRes)], ""))
        var conn = Value(acceptRes)
        var dropConn = false
        let selectRes = qt.Libp2pQuicServerSelectProtocol(listener, conn, types.Libp2pProtocolSync)
        if IsErr(selectRes):
            qt.Libp2pQuicWriteStderr(strutil.Join(["done_drop_server: select_err=", ErrorText(selectRes)], ""))
            dropConn = true
        if !dropConn:
            let writeRes = qt.Libp2pQuicWriteExact(listener, conn, qt.Libp2pQuicEncodeFrame(payload))
            if IsErr(writeRes):
                qt.Libp2pQuicWriteStderr(strutil.Join(["done_drop_server: write_err=", ErrorText(writeRes)], ""))
                dropConn = true
        qconn.ConnClose(conn)
        if dropConn:
            continue
        servedCount = servedCount + 1
        qt.Libp2pQuicWriteStderr(strutil.Join(["done_drop_server: served=", IntToStr(servedCount)], ""))

    qtransport.Stop(listener)
    echo(" quic_handshake_done_drop_server ok")
    return 0
