# wall38 前置墙最小探针 v7：staged + queryErr 本地暂存 + 早退保留。
# 验证判词真因=var-out 实参的堆投影载体（work.err 直传），非早退多版本。
type
    W38Plan = object
        text: str
        ok: bool

    W38Work = ref object
        plan: W38Plan
        err: str
        ok: bool

fn w38BuildPlanInto(channel: str, plan: var W38Plan, err: var str): bool =
    plan.text = channel
    plan.ok = true
    err = ""
    return true

fn w38Worker(raw: ptr) =
    if raw == nil:
        return
    let work: W38Work = W38Work(raw)
    var queryPlan: W38Plan = work.plan
    var queryErr: str = work.err
    if !w38BuildPlanInto("ch", queryPlan, queryErr):
        work.err = queryErr
        work.ok = false
        return
    work.plan = queryPlan
    work.err = queryErr
    work.ok = true

fn main(): int32 =
    return 0
