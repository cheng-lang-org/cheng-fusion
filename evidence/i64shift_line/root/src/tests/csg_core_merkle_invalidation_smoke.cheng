import std/os as os
import std/strings
import cheng/core/csg_core/merkle_invalidation

@borrows
fn fail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

@borrows
fn edge(
        consumer: str,
        provider: str,
        selector: str,
        cid: str):
        merkle_invalidation.CsgCoreMerkleDependencyEdge =
    var out: merkle_invalidation.CsgCoreMerkleDependencyEdge
    out.consumerSource = strings.CloneStr(consumer)
    out.providerSource = strings.CloneStr(provider)
    out.selector = strings.CloneStr(selector)
    out.providerSubgraphCid =
        strings.CloneStr(cid)
    return out

@borrows
fn cloneEdge(
        value:
            merkle_invalidation.CsgCoreMerkleDependencyEdge):
        merkle_invalidation.CsgCoreMerkleDependencyEdge =
    return edge(
        value.consumerSource,
        value.providerSource,
        value.selector,
        value.providerSubgraphCid)

@borrows
fn has(values: str[], value: str): bool =
    for i in 0..<values.len:
        if values[i] == value:
            return true
    return false

fn main(): int32 =
    let cid = "sha256:1111111111111111111111111111111111111111111111111111111111111111"
    var dependencies: merkle_invalidation.CsgCoreMerkleDependencyEdge[]
    add(dependencies, edge("B", "A", "symbol:A", cid))
    add(dependencies, edge("C", "A", "symbol:A", cid))
    add(dependencies, edge("D", "B", "symbol:B", cid))
    add(dependencies, edge("D", "C", "symbol:C", cid))

    let first =
        merkle_invalidation.CsgCoreMerkleInvalidationBuild(
            ["A", "B", "C", "D", "E"],
            dependencies,
            ["A"])
    if !first.ok ||
       first.dependencyCount != 4 ||
       first.changedSources.len != 1 ||
       first.invalidatedSources.len != 4 ||
       first.untouchedSources.len != 1 ||
       !has(first.invalidatedSources, "A") ||
       !has(first.invalidatedSources, "B") ||
       !has(first.invalidatedSources, "C") ||
       !has(first.invalidatedSources, "D") ||
       !has(first.untouchedSources, "E") ||
       first.dependencyRoot.len != 71 ||
       !strings.HasPrefix(
           first.dependencyRoot, "sha256:") ||
       first.invalidationRoot.len != 71 ||
       !strings.HasPrefix(
           first.invalidationRoot, "sha256:") ||
       first.dependencyRoot == first.invalidationRoot:
        return fail(strings.ConcatStr(
            "diamond invalidation failed: ",
            first.error))
    if first.sourceSetRoot.len != 71 ||
       !strings.HasPrefix(
           first.sourceSetRoot, "sha256:") ||
       first.sourceSetRoot == first.dependencyRoot ||
       first.sourceSetRoot == first.invalidationRoot:
        return fail("source-set root binding missing")

    var reordered: merkle_invalidation.CsgCoreMerkleDependencyEdge[]
    add(reordered, edge("D", "C", "symbol:C", cid))
    add(reordered, edge("C", "A", "symbol:A", cid))
    add(reordered, edge("D", "B", "symbol:B", cid))
    add(reordered, edge("B", "A", "symbol:A", cid))
    let second =
        merkle_invalidation.CsgCoreMerkleInvalidationBuild(
            ["E", "D", "C", "B", "A"],
            reordered,
            ["A"])
    if !second.ok ||
       second.dependencyRoot !=
           first.dependencyRoot ||
       second.sourceSetRoot !=
           first.sourceSetRoot ||
       second.invalidationRoot !=
           first.invalidationRoot ||
       second.invalidatedSources.len !=
           first.invalidatedSources.len:
        return fail(
            "invalidation order changed roots")
    for i in 0..<first.invalidatedSources.len:
        if first.invalidatedSources[i] !=
           second.invalidatedSources[i]:
            return fail(
                "invalidation output order unstable")

    var redundantPath: merkle_invalidation.CsgCoreMerkleDependencyEdge[]
    for i in 0..<dependencies.len:
        add(redundantPath, cloneEdge(dependencies[i]))
    add(
        redundantPath,
        edge("D", "A", "query:direct-D", cid))
    let sameClosureDifferentGraph =
        merkle_invalidation.CsgCoreMerkleInvalidationBuild(
            ["A", "B", "C", "D", "E"],
            redundantPath,
            ["A"])
    if !sameClosureDifferentGraph.ok ||
       sameClosureDifferentGraph.invalidatedSources.len !=
           first.invalidatedSources.len ||
       sameClosureDifferentGraph.sourceSetRoot !=
           first.sourceSetRoot ||
       sameClosureDifferentGraph.dependencyRoot ==
           first.dependencyRoot ||
       sameClosureDifferentGraph.invalidationRoot ==
           first.invalidationRoot:
        return fail(
            "invalidation root did not bind dependency graph")

    let widerUniverse =
        merkle_invalidation.CsgCoreMerkleInvalidationBuild(
            ["A", "B", "C", "D", "E", "F"],
            dependencies,
            ["A"])
    if !widerUniverse.ok ||
       widerUniverse.invalidatedSources.len !=
           first.invalidatedSources.len ||
       widerUniverse.dependencyRoot !=
           first.dependencyRoot ||
       widerUniverse.sourceSetRoot ==
           first.sourceSetRoot ||
       widerUniverse.invalidationRoot ==
           first.invalidationRoot:
        return fail(
            "invalidation root did not bind source universe")

    var providerQuery: merkle_invalidation.CsgCoreMerkleDependencyEdge[]
    add(
        providerQuery,
        edge("query-result", "provider", "query:orders", cid))
    add(
        providerQuery,
        edge(
            "consumer", "query-result",
            "symbol:query-consumer", cid))
    let providerQueryResult =
        merkle_invalidation.CsgCoreMerkleInvalidationBuild(
            ["provider", "query-result", "consumer", "idle"],
            providerQuery,
            ["provider"])
    if !providerQueryResult.ok ||
       providerQueryResult.invalidatedSources.len != 3 ||
       providerQueryResult.invalidatedSources[0] != "consumer" ||
       providerQueryResult.invalidatedSources[1] != "provider" ||
       providerQueryResult.invalidatedSources[2] != "query-result" ||
       providerQueryResult.untouchedSources.len != 1 ||
       providerQueryResult.untouchedSources[0] != "idle":
        return fail(
            "provider/query invalidation propagation incomplete")

    let independent =
        merkle_invalidation.CsgCoreMerkleInvalidationBuild(
            ["A", "B", "C", "D", "E"],
            dependencies,
            ["E"])
    if !independent.ok ||
       independent.invalidatedSources.len != 1 ||
       independent.invalidatedSources[0] != "E" ||
       independent.untouchedSources.len != 4:
        return fail("independent source invalidation leaked")

    var cyclic: merkle_invalidation.CsgCoreMerkleDependencyEdge[]
    add(cyclic, edge("B", "A", "symbol:A", cid))
    add(cyclic, edge("C", "A", "symbol:A", cid))
    add(cyclic, edge("D", "B", "symbol:B", cid))
    add(cyclic, edge("D", "C", "symbol:C", cid))
    add(cyclic, edge("A", "D", "symbol:D", cid))
    let cycle =
        merkle_invalidation.CsgCoreMerkleInvalidationBuild(
            ["A", "B", "C", "D", "E"],
            cyclic,
            ["A"])
    if !cycle.ok ||
       cycle.invalidatedSources.len != 4 ||
       !has(cycle.untouchedSources, "E"):
        return fail("cyclic invalidation failed")

    var duplicate: merkle_invalidation.CsgCoreMerkleDependencyEdge[]
    add(duplicate, edge("B", "A", "symbol:A", cid))
    add(duplicate, edge("B", "A", "symbol:A", cid))
    let duplicateResult =
        merkle_invalidation.CsgCoreMerkleInvalidationBuild(
            ["A", "B"], duplicate, ["A"])
    if duplicateResult.ok ||
       duplicateResult.error !=
           "merkle_invalidation_dependency_duplicate":
        return fail("duplicate dependency accepted")

    let otherCid =
        "sha256:2222222222222222222222222222222222222222222222222222222222222222"
    var identityConflict: merkle_invalidation.CsgCoreMerkleDependencyEdge[]
    add(
        identityConflict,
        edge("B", "A", "symbol:A", cid))
    add(
        identityConflict,
        edge("B", "A", "symbol:A", otherCid))
    let identityConflictResult =
        merkle_invalidation.CsgCoreMerkleInvalidationBuild(
            ["A", "B"], identityConflict, ["A"])
    if identityConflictResult.ok ||
       identityConflictResult.error !=
           "merkle_invalidation_dependency_identity_conflict":
        return fail(
            "dependency identity conflict accepted")

    let duplicateSource =
        merkle_invalidation.CsgCoreMerkleInvalidationBuild(
            ["A", "A"], [], ["A"])
    if duplicateSource.ok ||
       duplicateSource.error !=
           "merkle_invalidation_source_duplicate":
        return fail("duplicate source accepted")
    let duplicateChanged =
        merkle_invalidation.CsgCoreMerkleInvalidationBuild(
            ["A", "B"], [], ["A", "A"])
    if duplicateChanged.ok ||
       duplicateChanged.error !=
           "merkle_invalidation_changed_duplicate":
        return fail("duplicate changed source accepted")

    var selfEdge: merkle_invalidation.CsgCoreMerkleDependencyEdge[]
    add(selfEdge, edge("A", "A", "symbol:A", cid))
    let selfEdgeResult =
        merkle_invalidation.CsgCoreMerkleInvalidationBuild(
            ["A"], selfEdge, ["A"])
    if selfEdgeResult.ok ||
       selfEdgeResult.error !=
           "merkle_invalidation_dependency_self_edge":
        return fail("self dependency accepted")

    var unknownSource: merkle_invalidation.CsgCoreMerkleDependencyEdge[]
    add(
        unknownSource,
        edge("missing", "A", "symbol:A", cid))
    let unknownSourceResult =
        merkle_invalidation.CsgCoreMerkleInvalidationBuild(
            ["A", "B"], unknownSource, ["A"])
    if unknownSourceResult.ok ||
       unknownSourceResult.error !=
           "merkle_invalidation_dependency_unknown_source":
        return fail("unknown dependency source accepted")

    var badCid: merkle_invalidation.CsgCoreMerkleDependencyEdge[]
    add(
        badCid,
        edge("B", "A", "symbol:A", "sha256:bad"))
    if merkle_invalidation.CsgCoreMerkleInvalidationBuild(
           ["A", "B"], badCid, ["A"]).ok:
        return fail("bad dependency CID accepted")
    if merkle_invalidation.CsgCoreMerkleInvalidationBuild(
           ["A", "B"], dependencies, ["missing"]).ok:
        return fail("unknown changed source accepted")

    os.WriteLine(
        os.Get_stdout(),
        first.dependencyRoot)
    os.WriteLine(
        os.Get_stdout(),
        first.invalidationRoot)
    os.WriteLine(
        os.Get_stdout(),
        "csg_core_merkle_invalidation_smoke ok")
    return 0
