import cheng/core/csg_core/compiler_snapshot_cargo as cargo
import cheng/core/csg_core/compiler_snapshot_schema as schema
import cheng/core/csg_core/validator
import cheng/core/lang/parser
import cheng/core/tooling/compiler_csg
import cheng/core/tooling/compiler_snapshot_builder as builder
import cheng/core/tooling/compiler_world
import cheng/core/tooling/path as chengpath
import cheng/core/tooling/semantic_snapshot
import cheng/std/bytes_layout as layout
import cheng/tests/compiler_snapshot_builder_type_only_smoke as helper
import std/strutils as strutils

fn ImportcProductionSnapshotBuildInto(
        csg: var compiler_csg.CompilerCsg,
        sourceText: str,
        tables: var schema.CsgCompilerSnapshotTables,
        admission: var builder.CompilerSnapshotProductionAdmissionReceipt,
        err: var str): bool =
    if csg.semanticGraph.sourceTable.modulePaths.len != 1:
        err = " compiler snapshot builder importc smoke: source authority is not singular"
        return false
    var documentCid: layout.FixedBytes32
    if !compiler_world.CompilerWorldDocumentCidInto(
            csg.packageId,
            csg.semanticGraph.sourceTable.modulePaths[0],
            documentCid,
            err):
        return false
    var eventState: semantic_snapshot.WorkspaceSourceEventState
    if !semantic_snapshot.WorkspaceSourceEventStateInitInto(
            csg.sourceBundleCid, eventState, err):
        return false
    var sourceVersion: int64
    if !semantic_snapshot.WorkspaceSourceEventAcceptInto(
            eventState,
            semantic_snapshot.SemanticSourceEventOpen,
            documentCid,
            int64(0),
            sourceVersion,
            err):
        return false
    var documentCids: layout.FixedBytes32[]
    var canonicalSourceByProducer: int32[]
    var sourceTexts: str[]
    add(documentCids, documentCid)
    add(canonicalSourceByProducer, 0)
    add(sourceTexts, sourceText)
    if !builder.CompilerSnapshotProductionCandidateBuildUnsealedInto(
           csg,
           documentCids,
           canonicalSourceByProducer,
           sourceTexts,
           eventState,
           csg.canonicalGraphCid,
           csg.graphCid,
           csg.sourceIdentityReceipt.receiptCid,
           tables,
           admission,
           err):
        return false
    if !admission.admissionBlocked ||
       admission.missingSourceInterfaceCount !=
           tables.sources.documentCids.len ||
       (admission.missingFactBitmap &
            builder.CompilerSnapshotAdmissionMissingSourceInterface) == 0:
        err = " importc snapshot: candidate did not return unsealed"
        return false
    if !builder.CompilerSnapshotProductionCandidateSealInto(
           csg,
               documentCids,
               canonicalSourceByProducer,
               tables,
               admission,
               err):
        return false
    if !admission.admissionBlocked &&
       !schema.CsgCompilerSnapshotTablesStrictValidateInto(
           tables, err):
        return false
    err = ""
    return true

fn ImportcSnapshotStrictRejects(
        tables: schema.CsgCompilerSnapshotTables): bool =
    var err: str
    return !schema.CsgCompilerSnapshotTablesStrictValidateInto(
        tables, err)

fn main() =
    let root = chengpath.PathCurrentDir()
    let sourcePath = chengpath.PathJoin(
        root,
        "src/tests/compiler_snapshot_builder_importc_fixture.cheng")
    let sourceText = chengpath.ReadTextFile(root, sourcePath)
    assert(sourceText != "",
           "compiler snapshot builder importc smoke: source missing")
    var csg: compiler_csg.CompilerCsg
    var err: str
    assert(helper.TypeOnlyBuildCsg(
               root, sourcePath, sourceText, csg, err),
           Fmt"compiler snapshot builder importc smoke: CSG failed {err}")
    assert(csg.semanticGraph.resolvedCallTable.sourceIndexes.len == 1 &&
           csg.semanticGraph.resolvedCallTable.callTargetImportcFlags[0] &&
           csg.semanticGraph.resolvedCallTable.targetGraphNodeIds[0] == -1 &&
           csg.semanticGraph.resolvedCallTable.targetProducerSourceIndexes[
               0] == 0 &&
           csg.semanticGraph.resolvedCallTable.targetProducerDeclarationOrdinals[
               0] >= 0 &&
           csg.semanticGraph.resolvedCallTable.targetParserSourceLocalDeclarationRows[
               0] >= 0,
           "compiler snapshot builder importc smoke: exact producer call identity missing")
    var tables: schema.CsgCompilerSnapshotTables
    var admission: builder.CompilerSnapshotProductionAdmissionReceipt
    assert(ImportcProductionSnapshotBuildInto(
               csg, sourceText, tables, admission, err),
           Fmt"compiler snapshot builder importc smoke: snapshot failed {err}")
    assert(!admission.admissionBlocked &&
           admission.missingFactBitmap == 0 &&
           admission.missingReferenceProofCount == 0 &&
           !layout.FixedBytes32Equal(
               admission.referenceProofCid,
               layout.FixedBytes32()) &&
           !layout.FixedBytes32Equal(
               admission.referenceProofCid,
               admission.referenceRequiredDomainCid) &&
           admission.missingTypedNodeProofCount == 0 &&
           !layout.FixedBytes32Equal(
               admission.typedNodeProofCid,
               layout.FixedBytes32()) &&
           admission.missingDiagnosticProofCount == 0 &&
           !layout.FixedBytes32Equal(
               admission.diagnosticProofCid,
               layout.FixedBytes32()) &&
           !layout.FixedBytes32Equal(
               admission.diagnosticProofCid,
               admission.diagnosticRequiredDomainCid),
           Fmt"compiler snapshot builder importc smoke: candidate blocked bitmap={admission.missingFactBitmap}")
    assert(tables.functions.symbolIds.len == 1 &&
           tables.externFunctions.symbolIds.len == 1 &&
           tables.calls.callReferenceIds.len == 1 &&
           tables.annotationTargets.parserAnnotationRows.len == 1,
           "compiler snapshot builder importc smoke: canonical row counts split")
    let externSymbolId = tables.externFunctions.symbolIds[0]
    let externDeclId = tables.symbols.declIds[externSymbolId]
    assert(tables.symbols.functionIds[externSymbolId] == -1 &&
           tables.symbols.externFunctionIds[externSymbolId] == 0 &&
           tables.externFunctions.typeIds[0] ==
               tables.symbols.typeIds[externSymbolId] &&
           tables.calls.calleeSymbolIds[0] == externSymbolId &&
           tables.calls.targetParserDeclarationRows[0] ==
               tables.externFunctions.parserDeclarationRows[0] &&
           tables.calls.targetDeclIds[0] == externDeclId &&
           layout.FixedBytes32Equal(
               tables.calls.targetDeclKeyCids[0],
               tables.symbols.declKeyCids[externSymbolId]) &&
           layout.FixedBytes32Equal(
               tables.calls.targetSymbolCids[0],
               tables.symbols.symbolCids[externSymbolId]) &&
           tables.annotationTargets.targetSymbolIds[0] ==
               externSymbolId &&
           tables.annotationTargets.targetDeclIds[0] == externDeclId &&
           layout.FixedBytes32Equal(
               tables.annotationTargets.targetDeclKeyCids[0],
               tables.symbols.declKeyCids[externSymbolId]),
           "compiler snapshot builder importc smoke: canonical identity chain split")

    var bothFunctionDomains =
        schema.CsgCompilerSnapshotTablesClone(tables)
    bothFunctionDomains.symbols.functionIds[externSymbolId] = 0
    assert(ImportcSnapshotStrictRejects(bothFunctionDomains),
           "compiler snapshot builder importc smoke: FunctionId/ExternFunctionId XOR mutation accepted")

    var missingExternDomain =
        schema.CsgCompilerSnapshotTablesClone(tables)
    missingExternDomain.symbols.externFunctionIds[externSymbolId] = -1
    assert(ImportcSnapshotStrictRejects(missingExternDomain),
           "compiler snapshot builder importc smoke: missing ExternFunctionId accepted")

    var parserTargetMutation =
        schema.CsgCompilerSnapshotTablesClone(tables)
    var executableParserDeclaration: int32 = -1
    for parserDeclarationRow in 0..<
            tables.parserSidecars.declarationKinds.len:
        if parserDeclarationRow !=
               tables.externFunctions.parserDeclarationRows[0] &&
           tables.parserSidecars.declarationKinds[
               parserDeclarationRow] ==
               Int32(parser.ParserDeclarationFunction):
            executableParserDeclaration = parserDeclarationRow
    assert(executableParserDeclaration >= 0,
           "compiler snapshot builder importc smoke: executable parser declaration missing")
    parserTargetMutation.calls.targetParserDeclarationRows[0] =
        executableParserDeclaration
    assert(ImportcSnapshotStrictRejects(parserTargetMutation),
           "compiler snapshot builder importc smoke: call parser target mutation accepted")

    var callDeclKeyMutation =
        schema.CsgCompilerSnapshotTablesClone(tables)
    callDeclKeyMutation.calls.targetDeclKeyCids[0].data[0] =
        uint8(Int32(callDeclKeyMutation.calls.targetDeclKeyCids[
            0].data[0]) ^ 1)
    assert(ImportcSnapshotStrictRejects(callDeclKeyMutation),
           "compiler snapshot builder importc smoke: call DeclKey mutation accepted")

    var annotationDeclKeyMutation =
        schema.CsgCompilerSnapshotTablesClone(tables)
    annotationDeclKeyMutation.annotationTargets.targetDeclKeyCids[
        0].data[0] =
        uint8(Int32(annotationDeclKeyMutation.annotationTargets.targetDeclKeyCids[0].data[0]) ^ 1)
    assert(ImportcSnapshotStrictRejects(annotationDeclKeyMutation),
           "compiler snapshot builder importc smoke: annotation DeclKey mutation accepted")

    var ownershipMutation =
        schema.CsgCompilerSnapshotTablesClone(tables)
    if ownershipMutation.calls.resultOwnershipKinds[0] ==
           schema.CsgCompilerOwnershipOwned:
        ownershipMutation.calls.resultOwnershipKinds[0] =
            schema.CsgCompilerOwnershipBorrowed
    else:
        ownershipMutation.calls.resultOwnershipKinds[0] =
            schema.CsgCompilerOwnershipOwned
    assert(ImportcSnapshotStrictRejects(ownershipMutation),
           "compiler snapshot builder importc smoke: call ownership mutation accepted")

    let resultTypedNodeId = tables.calls.resultTypedNodeIds[0]
    var typedOwnershipProofMutation =
        schema.CsgCompilerSnapshotTablesClone(tables)
    typedOwnershipProofMutation.typedNodes.ownershipProofCids[
        resultTypedNodeId].data[0] =
        uint8(Int32(
            typedOwnershipProofMutation.typedNodes.ownershipProofCids[
                resultTypedNodeId].data[0]) ^ 1)
    var mutationErr: str
    assert(!builder.CompilerSnapshotProductionCandidateReceiptStrictValidateInto(
               csg,
               typedOwnershipProofMutation,
               admission,
               mutationErr),
           "compiler snapshot builder importc smoke: TypedNode ownership proof mutation survived replay")

    var typedSendConclusionMutation =
        schema.CsgCompilerSnapshotTablesClone(tables)
    typedSendConclusionMutation.typedNodes.sendConclusions[
        resultTypedNodeId] =
        !typedSendConclusionMutation.typedNodes.sendConclusions[
            resultTypedNodeId]
    mutationErr = ""
    assert(!builder.CompilerSnapshotProductionCandidateReceiptStrictValidateInto(
               csg,
               typedSendConclusionMutation,
               admission,
               mutationErr),
           "compiler snapshot builder importc smoke: TypedNode Send conclusion mutation survived replay")

    var typedShareProofMutation =
        schema.CsgCompilerSnapshotTablesClone(tables)
    typedShareProofMutation.typedNodes.shareProofCids[
        resultTypedNodeId].data[0] =
        uint8(Int32(
            typedShareProofMutation.typedNodes.shareProofCids[
                resultTypedNodeId].data[0]) ^ 1)
    mutationErr = ""
    assert(!builder.CompilerSnapshotProductionCandidateReceiptStrictValidateInto(
               csg,
               typedShareProofMutation,
               admission,
               mutationErr),
           "compiler snapshot builder importc smoke: TypedNode share proof mutation survived replay")

    var typedNodeProofReceiptMutation = share(admission)
    typedNodeProofReceiptMutation.typedNodeProofCid.data[0] =
        uint8(Int32(
            typedNodeProofReceiptMutation.typedNodeProofCid.data[0]) ^ 1)
    mutationErr = ""
    assert(!builder.CompilerSnapshotProductionCandidateReceiptStrictValidateInto(
               csg,
               tables,
               typedNodeProofReceiptMutation,
               mutationErr),
           "compiler snapshot builder importc smoke: TypedNode aggregate proof mutation accepted")

    var referenceProofReceiptMutation = share(admission)
    referenceProofReceiptMutation.referenceProofCid =
        referenceProofReceiptMutation.referenceRequiredDomainCid
    mutationErr = ""
    assert(!builder.CompilerSnapshotProductionCandidateReceiptStrictValidateInto(
               csg,
               tables,
               referenceProofReceiptMutation,
               mutationErr),
           "compiler snapshot builder importc smoke: reference denominator marker accepted as result proof")

    var diagnosticProofReceiptMutation = share(admission)
    diagnosticProofReceiptMutation.diagnosticProofCid =
        diagnosticProofReceiptMutation.diagnosticRequiredDomainCid
    mutationErr = ""
    assert(!builder.CompilerSnapshotProductionCandidateReceiptStrictValidateInto(
               csg,
               tables,
               diagnosticProofReceiptMutation,
               mutationErr),
           "compiler snapshot builder importc smoke: denominator marker accepted as diagnostic proof")

    var diagnosticCompletionMutation =
        schema.CsgCompilerSnapshotTablesClone(tables)
    diagnosticCompletionMutation.diagnosticCompletions.proofCids[0].data[0] =
        uint8(Int32(
            diagnosticCompletionMutation.diagnosticCompletions.proofCids[
                0].data[0]) ^ 1)
    mutationErr = ""
    assert(!builder.CompilerSnapshotProductionCandidateReceiptStrictValidateInto(
               csg,
               diagnosticCompletionMutation,
               admission,
               mutationErr),
           "compiler snapshot builder importc smoke: diagnostic completion mutation survived candidate admission")

    var diagnosticResultMutation =
        schema.CsgCompilerSnapshotTablesClone(tables)
    assert(diagnosticResultMutation.diagnosticCompletions.requiredResultCids.len >
               1,
           "compiler snapshot builder importc smoke: diagnostic result mutation domain missing")
    let savedDiagnosticResultCid =
        diagnosticResultMutation.diagnosticCompletions.requiredResultCids[0]
    diagnosticResultMutation.diagnosticCompletions.requiredResultCids[0] =
        diagnosticResultMutation.diagnosticCompletions.requiredResultCids[1]
    diagnosticResultMutation.diagnosticCompletions.requiredResultCids[1] =
        savedDiagnosticResultCid
    mutationErr = ""
    assert(!builder.CompilerSnapshotProductionCandidateReceiptStrictValidateInto(
               csg,
               diagnosticResultMutation,
               admission,
               mutationErr),
           "compiler snapshot builder importc smoke: diagnostic result permutation survived candidate admission")

    var builtCargo = cargo.CsgCompilerSnapshotCargoBuild(tables)
    assert(builtCargo.ok, builtCargo.error)
    var wireLines: str[]
    for lineIndex in 0..<builtCargo.canonicalLines.len:
        add(wireLines, builtCargo.canonicalLines[lineIndex])
    let originalExternLine = wireLines[14]
    wireLines[14] = strutils.Replace(
        originalExternLine,
        Fmt"\"parserDeclarationRows\":[{tables.externFunctions.parserDeclarationRows[0]}]",
        Fmt"\"parserDeclarationRows\":[{executableParserDeclaration}]")
    assert(wireLines[14] != originalExternLine,
           "compiler snapshot builder importc smoke: wire extern parser mutation missed")
    let wireResult = validator.CsgCoreValidateFactLines(
        wireLines, validator.CsgCoreModeStrict)
    assert(!wireResult.valid,
           "compiler snapshot builder importc smoke: wire extern parser mutation accepted")
    cargo.CsgCompilerSnapshotCargoRelease(builtCargo)
    echo("compiler_snapshot_builder_importc_exact_identity=1")
    echo("compiler_snapshot_builder_importc_mutations_rejected=1")
