type
    ColdRefObjectBorrowAliasInner = ref object
        value: int32

    ColdRefObjectBorrowAliasOuter = ref object
        inner: ColdRefObjectBorrowAliasInner

fn ColdRefObjectBorrowAliasWrite(
        inner: var ColdRefObjectBorrowAliasInner) =
    inner.value = 97

fn ColdRefObjectBorrowAliasMutate(
        out: var ColdRefObjectBorrowAliasOuter) =
    var inner = out.inner
    let forbiddenAlias = out.inner
    ColdRefObjectBorrowAliasWrite(inner)
    if forbiddenAlias.value == 0:
        return

fn main(): int32 =
    var out = new(ColdRefObjectBorrowAliasOuter)
    out.inner = new(ColdRefObjectBorrowAliasInner)
    ColdRefObjectBorrowAliasMutate(out)
    return 0
