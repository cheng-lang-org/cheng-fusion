# tests for BMM150 pair + CST9220 touch
import "src/mosaico/frame.cheng" as frame
import "src/mosaico/bmm150x2.cheng" as bmm
import "src/mosaico/cst9220.cheng" as cst

fn CaseBmmInitGolden(): int32 =
    var buf: uint8[frame.FrameCap]
    var n = 0
    n = bmm.BuildInitSeq(buf, n)
    if n != 4:
        return 1
    if frame.FrameGet8(buf, n, 0) != 0x4B:
        return 2
    if frame.FrameGet8(buf, n, 3) != bmm.OpModeNormalOdr10:
        return 4
    return 0

# raw X parse: byte pair LE with 3 low pad bits and sign at bit13 of the
# shifted value (datasheet layout)
fn CaseRawParse(): int32 =
    var buf: uint8[frame.FrameCap]
    var n = 0
    # X raw: value bits = 256 << 3 = 0x0800 -> +256
    n = frame.FramePut16Le(buf, n, 0x0800)
    # Y raw: -256 in 13-bit two's complement = 0x1F00, staged <<3 = 0xF800
    n = frame.FramePut16Le(buf, n, 0xF800)
    if n != 4:
        return 1
    let x = bmm.RawXFrom(buf, n, 0)
    let y = bmm.RawYFrom(buf, n, 0)
    if x != 256:
        return 2
    if y != -256:
        return 4
    return 0

# bump: both sensors hot in the same step fires once, then cooling
fn RunBumpPair(l1: int32, r1: int32, l2: int32, r2: int32, l3: int32, r3: int32): int32 =
    var st = bmm.BumpInitState()
    var firedCount = 0
    var r = bmm.BumpStep(st, l1, r1)
    st = bmm.BumpStateOf(r)
    firedCount = firedCount + bmm.BumpFiredOf(r)
    r = bmm.BumpStep(st, l2, r2)
    st = bmm.BumpStateOf(r)
    firedCount = firedCount + bmm.BumpFiredOf(r)
    r = bmm.BumpStep(st, l3, r3)
    st = bmm.BumpStateOf(r)
    firedCount = firedCount + bmm.BumpFiredOf(r)
    return firedCount * 10 + (st & 3)

fn CaseBumpBothHot(): int32 =
    let r = RunBumpPair(5, 7, 200, 190, 30, 28)
    # fires on second step, then cooling phase (3)
    if r != 13:
        return 1
    return 0

fn CaseBumpOneSidedNoFire(): int32 =
    # only left goes hot: candidate expires, never fires
    let r = RunBumpPair(200, 5, 200, 6, 200, 7)
    if r != 0:
        return 1
    return 0

fn CaseTouchTapPolicy(): int32 =
    # same position, quick hold -> tap
    if cst.IsTap(240, 240, 242, 239, 20) != 1:
        return 1
    # too long -> not a tap
    if cst.IsTap(240, 240, 240, 240, 99) != 0:
        return 2
    # moved too far -> not a tap
    if cst.IsTap(240, 240, 300, 240, 10) != 0:
        return 4
    return 0

fn CaseTouchPacketParse(): int32 =
    var buf: uint8[frame.FrameCap]
    var n = 0
    n = frame.FramePut8(buf, n, uint8(1))       # one contact
    n = frame.FramePut8(buf, n, uint8(0))       # event down
    n = frame.FramePut8(buf, n, uint8(0xF0))    # x lo = 240
    n = frame.FramePut8(buf, n, uint8(0x01))    # x hi nibble = 1 -> x=496
    n = frame.FramePut8(buf, n, uint8(0x20))    # y lo = 32
    n = frame.FramePut8(buf, n, uint8(0x00))    # y hi = 0
    let contacts = cst.ContactsFrom(buf, n)
    let x = cst.XFrom(buf, n)
    let y = cst.YFrom(buf, n)
    if contacts != 1:
        return 1
    if x != ((1 & 15) << 8) | 240 or x != 496:
        return 2
    if y != 32:
        return 4
    return 0

fn main(): int32 =
    var fails = 0
    fails = fails | (CaseBmmInitGolden() << 0)
    fails = fails | (CaseRawParse() << 4)
    fails = fails | ((CaseBumpBothHot() & 0xF) << 8)
    fails = fails | ((CaseBumpOneSidedNoFire() & 0xF) << 12)
    fails = fails | (CaseTouchTapPolicy() << 16)
    fails = fails | ((CaseTouchPacketParse() & 0xFF) << 20)
    return fails
