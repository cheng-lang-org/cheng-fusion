import std/system as system

# [repro] Does a function-local `seq` buffer survive the call that owned it?
#
# The delta MUST be taken across the call, in the caller.  An earlier version of
# this probe took the second reading *inside* the callee, before the local left
# scope, so its "+1" only proved the buffer was still alive -- it proved
# nothing about release.  This form cannot make that mistake: `main` reads the
# live-block count, calls the worker, and reads it again.
#
# Exit code = live-block delta across the call.  0 = the buffer was released;
# non-zero = it survived its owner's scope.

fn ScopeLocalSeq(): int32 =
    var a: int32[]
    add(a, 1)
    add(a, 2)
    return a.len + a[0] + a[1]

fn main(): int32 =
    let before = system.MemLiveAllocations()
    let observed = ScopeLocalSeq()
    let after = system.MemLiveAllocations()
    if observed != 5:
        return 100
    let delta = after - before
    if delta < 0:
        return 101
    return int32(delta)
