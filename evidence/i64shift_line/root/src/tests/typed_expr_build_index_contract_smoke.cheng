    var err: str
    if !texpr.TypedExprBuildSourceIdentityIndex(sources, identity, err):
        return 1
    var physicalPath: str
    var ownerKey: str
    if !texpr.TypedExprSourceIdentityIndexOwnerForPath(identity,
                                                       "/work/pkg/vendor/ext/lib.cheng",
                                                       physicalPath,
                                                       ownerKey,
                                                       err) ||
       ownerKey != "workspace=/work\npackageId=pkg://external/one\nchannel=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\nroot=/work/pkg/vendor/ext":
        return 2
    if !texpr.TypedExprSourceIdentityIndexOwnerForPath(identity,
                                                       "/work/pkg/main.cheng",
                                                       physicalPath,
                                                       ownerKey,
                                                       err) ||
       ownerKey != "workspace=/work\npackageId=current\nchannel=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\nroot=/work/pkg":
        return 3

    var missingPackageSources: texpr.TypedExprSourceText[]
