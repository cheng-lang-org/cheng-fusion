fn runImportFanoutBuildOnce(): int32 =
    let targetPath = "/work/pkg/fan_target.cheng"
    var contexts: texpr.TypedExprSourceContext[]
    for i in 0..<64:
        var owner = contextNew(Fmt"/work/pkg/fan_owner_{i}.cheng")
        contextImport(owner, "target", targetPath)
        add(contexts, owner)
    var target = contextNew(targetPath)
    for i in 0..<32:
        contextDeclared(target, Fmt"FanType{i}")
    add(contexts, target)

    var ir: texpr.TypedExprIr
    texpr.TypedExprBuildSourceContextIndex(ir, contexts)
    let index = texpr.TypedExprIrBuildIndex(ir)
    if texpr.TypedExprBuildIndexBuildCount(index) != 1 ||
       texpr.TypedExprBuildIndexReuseCount(index) != 0:
        return 1
    if texpr.TypedExprBuildIndexMetadataDeclarationCount(index) != 64 ||
       texpr.TypedExprBuildIndexVisibilityEdgeCount(index) != 64:
        return 2
    let registerCount = texpr.TypedExprBuildIndexRegisterCount(index)
    if registerCount < 300 || registerCount >= 512:
        return 3
    if ir.sourceContextIndexSourcePaths.len != 65 ||
       ir.sourceContextIndexBucketHeads.len != 0 ||
       ir.sourceContextIndexEntryNext.len != 0 ||
       ir.sourceContextIndexEntryIndexes.len != 0:
        return 4

    let lookupsBefore = texpr.TypedExprBuildIndexQueryLookupCount(index)
    let probesBefore = texpr.TypedExprBuildIndexQueryProbeCount(index)
    let candidatesBefore = texpr.TypedExprBuildIndexQueryMetadataScanCount(index)
    var targetIndex: int32
    if texpr.TypedExprBuildIndexLookup(index,
                                       "ctx_import_declared",
                                       "/work/pkg/fan_owner_63.cheng",
                                       "FanType31",
                                       "",
                                       targetIndex) != texpr.TypedExprBuildIndexUnique ||
       targetIndex != 64:
        return 5
    if texpr.TypedExprBuildIndexQueryLookupCount(index) - lookupsBefore != 1 ||
       texpr.TypedExprBuildIndexQueryProbeCount(index) <= probesBefore ||
       texpr.TypedExprBuildIndexQueryMetadataScanCount(index) - candidatesBefore != 1:
        return 6

    let declarationsBefore = texpr.TypedExprBuildIndexMetadataDeclarationCount(index)
    let liveBytesBefore = texpr.TypedExprBuildIndexLiveBytes(index)
    let reuseBefore = texpr.TypedExprBuildIndexReuseCount(index)
    texpr.TypedExprBuildSourceContextIndex(ir, contexts)
    if texpr.TypedExprIrBuildIndex(ir) != index ||
       texpr.TypedExprBuildIndexBuildCount(index) != 1 ||
       texpr.TypedExprBuildIndexReuseCount(index) != reuseBefore + 1 ||
       texpr.TypedExprBuildIndexRegisterCount(index) != registerCount ||
       texpr.TypedExprBuildIndexMetadataDeclarationCount(index) != declarationsBefore ||
       texpr.TypedExprBuildIndexLiveBytes(index) != liveBytesBefore:
        return 7
    texpr.TypedExprIrReleasePayload(ir)
    if !releasedLiveReportZero(index):
        return 8
    return 0

fn runContentScopedCaches(): int32 =
    var externalRoots: parser.ParserExternalPackageRoot[]
    let sourcePath = "/work/pkg/cache_same.cheng"
    let textOne = "const\n    Marker = 1\nfn Same(): int32 =\n    return 0\n"
    let textTwo = "const\n    Marker = 2\nfn Same(): int64 =\n    return 0\n"
    if textOne.len != textTwo.len:
        return 1
    let sourceOne = sourceNew("/work",
                              "/work/pkg",
                              "pkg://current",
                              "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
                              sourcePath,
                              textOne,
                              externalRoots)
    let sourceTwo = sourceNew("/work",
                              "/work/pkg",
                              "pkg://current",
                              "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
                              sourcePath,
                              textTwo,
                              externalRoots)
    var first: texpr.TypedExprSourceContext
    var second: texpr.TypedExprSourceContext
    var err: str
    if !texpr.TypedExprBuildSourceContext(sourceOne, first, err):
        return 2
    if texpr.TypedExprModuleConstLiteralForContext(first, "Marker") != "1" ||
       texpr.TypedExprScanSourceFunctionReturnType(first, "Same") != "int32":
        return 3
    if !texpr.TypedExprBuildSourceContext(sourceTwo, second, err):
        return 4
    if first.buildIndex == second.buildIndex:
        return 5
    if texpr.TypedExprModuleConstLiteralForContext(second, "Marker") != "2" ||
       texpr.TypedExprScanSourceFunctionReturnType(second, "Same") != "int64":
        return 6
    if texpr.TypedExprModuleConstLiteralForContext(first, "Marker") != "1" ||
       texpr.TypedExprScanSourceFunctionReturnType(first, "Same") != "int32":
        return 7
    let firstIndex = first.buildIndex
    let secondIndex = second.buildIndex
    texpr.TypedExprClearSourceContextAllFields(first)
    texpr.TypedExprClearSourceContextAllFields(second)
    if !releasedLiveReportZero(firstIndex) ||
       !releasedLiveReportZero(secondIndex):
        return 8
    return 0

