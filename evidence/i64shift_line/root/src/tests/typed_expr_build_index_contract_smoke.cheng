fn runExplicitGenericDeclarationBinding(): int32 =
    let targetPath = "/work/pkg/explicit_generic_target.cheng"
    var contexts: texpr.TypedExprSourceContext[]
    var callerIndex: int32
    explicitGenericContexts(contexts, callerIndex)
    var ir: texpr.TypedExprIr
    texpr.TypedExprBuildSourceContextIndex(ir, contexts)
    let index = texpr.TypedExprIrBuildIndex(ir)
    if index == nil || !index.callDeclarationSealed:
        return 1

    var pairRow: int32 = -1
    var returnOnlyRow: int32 = -1
    var identityRow: int32 = -1
    var implicitRow: int32 = -1
    var plainRow: int32 = -1
    var concreteXRow: int32 = -1
    for rowIndex in 0..<index.callDeclarationNames.len:
        if index.callDeclarationSourcePaths[rowIndex] != targetPath:
            continue
        let name = index.callDeclarationNames[rowIndex]
        if name == "Pair":
            pairRow = rowIndex
        elif name == "ReturnOnly":
            returnOnlyRow = rowIndex
        elif name == "Identity":
            identityRow = rowIndex
        elif name == "Implicit":
            implicitRow = rowIndex
        elif name == "Plain":
            plainRow = rowIndex
        elif name == "ConcreteX":
            concreteXRow = rowIndex
    if pairRow < 0 || returnOnlyRow < 0 || identityRow < 0 ||
       implicitRow < 0 || plainRow < 0 || concreteXRow < 0:
        return 2
    let pairGenericStart = index.callDeclarationGenericStarts[pairRow]
    if index.callDeclarationGenericCounts[pairRow] != 2 ||
       index.callDeclarationGenericNames[pairGenericStart] != "A" ||
       index.callDeclarationGenericNames[pairGenericStart + 1] != "B" ||
       index.callDeclarationGenericCounts[returnOnlyRow] != 2 ||
       index.callDeclarationGenericCounts[identityRow] != 1:
        return 3
    let implicitGenericStart = index.callDeclarationGenericStarts[implicitRow]
    if index.callDeclarationGenericCounts[implicitRow] != 1 ||
       index.callDeclarationGenericNames[implicitGenericStart] != "T" ||
       index.callDeclarationGenericCounts[plainRow] != 0 ||
       index.callDeclarationGenericCounts[concreteXRow] != 0:
        return 4

    var sourcePath: str
    var returnType: str
    var targetSymbol: str
    var importc: bool
    var rowIndex: int32
    var mismatch = false
    var pairArgs = ["uint8", "uint16"]
    var pairGenerics = ["uint8", "uint16"]
    if texpr.TypedExprResolveCallDeclarationWithExplicit(
            contexts[callerIndex],
            "generic",
            "Pair",
            pairArgs,
            pairGenerics,
            true,
            texpr.TypedExprCallDeclarationFunctionOnly,
            sourcePath,
            returnType,
            targetSymbol,
            importc,
            rowIndex,
            mismatch) != texpr.TypedExprBuildIndexUnique ||
       mismatch || sourcePath != targetPath || returnType != "uint16" ||
       importc || rowIndex != pairRow:
        return 5
    if texpr.TypedExprCallDeclarationResolvedParamType(index,
                                                       pairRow,
                                                       pairArgs,
                                                       pairGenerics,
                                                       true,
                                                       0) != "uint8" ||
       texpr.TypedExprCallDeclarationResolvedParamType(index,
                                                       pairRow,
                                                       pairArgs,
                                                       pairGenerics,
                                                       true,
                                                       1) != "uint16":
        return 6

    var returnOnlyArgs = ["int32"]
    var returnOnlyGenerics = ["uint8", "uint64"]
    mismatch = false
    if texpr.TypedExprResolveCallDeclarationWithExplicit(
            contexts[callerIndex],
            "generic",
            "ReturnOnly",
            returnOnlyArgs,
            returnOnlyGenerics,
            true,
            texpr.TypedExprCallDeclarationFunctionOnly,
            sourcePath,
            returnType,
            targetSymbol,
            importc,
            rowIndex,
            mismatch) != texpr.TypedExprBuildIndexUnique ||
       mismatch || returnType != "uint64":
        return 7

    var identityArgs = ["uint8"]
    var identityGenerics = ["uint8"]
    mismatch = false
    if texpr.TypedExprResolveCallDeclarationWithExplicit(
            contexts[callerIndex],
            "generic",
            "Identity",
            identityArgs,
            identityGenerics,
            true,
            texpr.TypedExprCallDeclarationFunctionOnly,
            sourcePath,
            returnType,
            targetSymbol,
            importc,
            rowIndex,
            mismatch) != texpr.TypedExprBuildIndexUnique ||
       mismatch || returnType != "uint8":
        return 8

    var implicitArgs = ["uint16"]
    var noExplicit: str[]
    mismatch = false
    if texpr.TypedExprResolveCallDeclarationWithExplicit(
            contexts[callerIndex],
            "generic",
            "Implicit",
            implicitArgs,
            noExplicit,
            false,
            texpr.TypedExprCallDeclarationFunctionOnly,
            sourcePath,
            returnType,
            targetSymbol,
            importc,
            rowIndex,
            mismatch) != texpr.TypedExprBuildIndexUnique ||
       mismatch || returnType != "uint16":
        return 9

    var wrongCount = ["uint8"]
    mismatch = false
    if texpr.TypedExprResolveCallDeclarationWithExplicit(
            contexts[callerIndex],
            "generic",
            "Pair",
            pairArgs,
            wrongCount,
            true,
            texpr.TypedExprCallDeclarationFunctionOnly,
            sourcePath,
            returnType,
            targetSymbol,
            importc,
            rowIndex,
            mismatch) != texpr.TypedExprBuildIndexMissing || !mismatch:
        return 10
    var conflictingPairGenerics = ["uint8", "uint64"]
    mismatch = false
    if texpr.TypedExprResolveCallDeclarationWithExplicit(
            contexts[callerIndex],
            "generic",
            "Pair",
            pairArgs,
            conflictingPairGenerics,
            true,
            texpr.TypedExprCallDeclarationFunctionOnly,
            sourcePath,
            returnType,
            targetSymbol,
            importc,
            rowIndex,
            mismatch) != texpr.TypedExprBuildIndexMissing || !mismatch:
        return 11
    var plainArgs = ["int32"]
    mismatch = false
    if texpr.TypedExprResolveCallDeclarationWithExplicit(
            contexts[callerIndex],
            "generic",
            "Plain",
            plainArgs,
            wrongCount,
            true,
            texpr.TypedExprCallDeclarationFunctionOnly,
            sourcePath,
            returnType,
            targetSymbol,
            importc,
            rowIndex,
            mismatch) != texpr.TypedExprBuildIndexMissing || !mismatch:
        return 12

    var expectedResult: str
    if texpr.TypedExprWholeCallResultTypeWithExpected("uint16",
                                                      "uint64",
                                                      expectedResult) ||
       !texpr.TypedExprWholeCallResultTypeWithExpected("uint16",
                                                       "uint16",
                                                       expectedResult) ||
       expectedResult != "uint16":
        return 13
    var genericLookupCtx = texpr.TypedExprSourceContextBorrowedView(
        contexts[callerIndex])
    if texpr.TypedExprBindingRhsCallReturnType(
            genericLookupCtx,
            contexts,
            2,
            "generic.Pair[uint8, uint16](uint8(1), uint16(2))") !=
       "uint16":
        return 14
    if texpr.TypedExprBindingRhsCallReturnType(
            genericLookupCtx,
            contexts,
            2,
            "generic.ReturnOnly[uint8, uint64](1)") != "uint64":
        return 15
    if texpr.TypedExprBindingRhsCallReturnType(
            genericLookupCtx,
            contexts,
            2,
            "generic.Identity[uint8](uint8(1))") != "uint8":
        return 16
    texpr.TypedExprIrReleasePayload(ir)
    return 0

fn runSourceContextBuildIndexOwnership(): int32 =
    let sourcePath = "/work/pkg/source_context_owner.cheng"
    var owner = contextParsed(sourcePath,
                              "fn Value(value: int32): int32 = value\n")
    let firstIndex = owner.buildIndex
    if !texpr.TypedExprSourceContextOwnsBuildIndex(owner) || firstIndex == nil:
        return 1

    var borrowed = texpr.TypedExprSourceContextBorrowedView(owner)
    texpr.TypedExprClearSourceContextAllFields(borrowed)
    texpr.TypedExprClearSourceContextAllFields(borrowed)
    if firstIndex.released || texpr.TypedExprBuildIndexReleaseCount(firstIndex) != 0 ||
       !texpr.TypedExprSourceContextOwnsBuildIndex(owner):
        return 2

    var cloned = texpr.TypedExprSourceContextClone(owner)
    let clonedIndex = cloned.buildIndex
    if !texpr.TypedExprSourceContextOwnsBuildIndex(cloned) ||
       clonedIndex == nil || clonedIndex == firstIndex:
        return 3
    var moved: texpr.TypedExprSourceContext
    texpr.TypedExprSourceContextMoveInto(moved, cloned)
    if cloned.buildIndex != nil || cloned.buildIndexOwned ||
       !texpr.TypedExprSourceContextOwnsBuildIndex(moved) ||
       moved.buildIndex != clonedIndex:
        return 4
    texpr.TypedExprClearSourceContextAllFields(moved)
    texpr.TypedExprClearSourceContextAllFields(moved)
    if !clonedIndex.released || texpr.TypedExprBuildIndexReleaseCount(clonedIndex) != 1:
        return 5

    var externalRoots: parser.ParserExternalPackageRoot[]
    var err: str
    var borrowedRebuild = texpr.TypedExprSourceContextBorrowedView(owner)
    let borrowedRebuildSource = sourceNew("",
                                          "",
                                          "pkg://current",
                                          "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
                                          "/work/pkg/source_context_borrowed_rebuild.cheng",
                                          "fn BorrowedValue(): int32 = 1\n",
                                          externalRoots)
    if !texpr.TypedExprBuildSourceContext(borrowedRebuildSource,
                                         borrowedRebuild,
                                         err):
        return 6
    let borrowedRebuiltIndex = borrowedRebuild.buildIndex
    if firstIndex.released ||
       texpr.TypedExprBuildIndexReleaseCount(firstIndex) != 0 ||
       !texpr.TypedExprSourceContextOwnsBuildIndex(borrowedRebuild) ||
       borrowedRebuiltIndex == nil || borrowedRebuiltIndex == firstIndex:
        return 7
    texpr.TypedExprClearSourceContextAllFields(borrowedRebuild)
    if !borrowedRebuiltIndex.released ||
       texpr.TypedExprBuildIndexReleaseCount(borrowedRebuiltIndex) != 1:
        return 8

    let rebuiltSource = sourceNew("",
                                  "",
                                  "pkg://current",
                                  "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
                                  sourcePath,
                                  "fn Value(value: str): str = value\n",
                                  externalRoots)
    if !texpr.TypedExprBuildSourceContext(rebuiltSource, owner, err):
        return 9
    let rebuiltIndex = owner.buildIndex
    if !firstIndex.released || texpr.TypedExprBuildIndexReleaseCount(firstIndex) != 1 ||
       rebuiltIndex == nil || rebuiltIndex == firstIndex ||
       !texpr.TypedExprSourceContextOwnsBuildIndex(owner):
        return 10
    texpr.TypedExprClearSourceContextAllFields(owner)
    texpr.TypedExprClearSourceContextAllFields(owner)
    if !rebuiltIndex.released || texpr.TypedExprBuildIndexReleaseCount(rebuiltIndex) != 1:
        return 11

    var contexts: texpr.TypedExprSourceContext[]
    var callerIndex: int32
    callDeclarationContexts(false, contexts, callerIndex)
    var standaloneIndexes: texpr.TypedExprBuildIndex[]
    for contextIndex in 0..<contexts.len:
        add(standaloneIndexes, share(contexts[contextIndex].buildIndex))
    var ir: texpr.TypedExprIr
    texpr.TypedExprBuildSourceContextIndex(ir, contexts)
    let sharedIndex = texpr.TypedExprIrBuildIndex(ir)
    for contextIndex in 0..<contexts.len:
        if standaloneIndexes[contextIndex] == nil ||
           !standaloneIndexes[contextIndex].released ||
           texpr.TypedExprBuildIndexReleaseCount(standaloneIndexes[contextIndex]) != 1 ||
           contexts[contextIndex].buildIndex != sharedIndex ||
           contexts[contextIndex].buildIndexOwned:
            return 12
    var hiddenBorrow = texpr.TypedExprSourceContextBorrowedView(contexts[3])
    texpr.TypedExprClearSourceContextAllFields(hiddenBorrow)
    if sharedIndex.released:
        return 13
    var resolvedSource: str
    var returnType: str
    var targetSymbol: str
    var importc: bool
    var rowIndex: int32
    var intArgs = ["int32"]
    if texpr.TypedExprResolveCallDeclaration(contexts[callerIndex],
                                             "overload",
                                             "Pick",
                                             intArgs,
                                             texpr.TypedExprCallDeclarationFunctionOnly,
                                             resolvedSource,
                                             returnType,
                                             targetSymbol,
                                             importc,
                                             rowIndex) != texpr.TypedExprBuildIndexUnique ||
       returnType != "str":
        return 14
    texpr.TypedExprIrReleasePayload(ir)
    if !sharedIndex.released || texpr.TypedExprBuildIndexReleaseCount(sharedIndex) != 1:
        return 15
    for contextIndex in 0..<contexts.len:
        texpr.TypedExprClearSourceContextAllFields(contexts[contextIndex])
    return 0

fn runSnapshotBuildBorrowedOwnerLifecycle(): int32 =
    let root = os.GetEnvDefault("CHENG_SMOKE_ROOT", chengpath.PathCurrentDir())
    let sourcePath = chengpath.PathJoin(root,
                                       "src/tests/typed_expr_snapshot_owner_fixture.cheng")
    let sourceText = os.ReadFile(share(sourcePath))
    if sourceText == "":
        return 1
    var externalRoots: parser.ParserExternalPackageRoot[]
    let source = sourceNew(root,
                           root,
                           "pkg://typed-expr-owner-fast-smoke",
                           "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
                           sourcePath,
                           sourceText,
                           externalRoots)
    var sourceTexts = [share(source)]
    var metadataContext: texpr.TypedExprSourceContext
    var err: str
    if !texpr.TypedExprBuildSourceContext(
            share(source), metadataContext, err):
        return 2
    var metadataContexts: texpr.TypedExprSourceContext[]
    texpr.TypedExprSourceContextAppendMove(metadataContexts, metadataContext)
    let ownerIndex = metadataContexts[0].buildIndex
    if ownerIndex == nil || !texpr.TypedExprSourceContextOwnsBuildIndex(metadataContexts[0]) ||
       texpr.TypedExprBuildIndexReleaseCount(ownerIndex) != 0:
        return 3

    var exprLayer: parser.NormalizedExprLayer
    if !texpr.TypedExprReadNormalizedExprLayerForSourceTexts(sourceTexts,
                                                             exprLayer,
                                                             err) ||
       exprLayer.exprs.len <= 0:
        return 4
    # The normalized-expression reader intentionally drops source bodies. The
    # official fast entry receives the immutable source snapshot again.
    sourceTexts[0] = share(source)
    var factsExprLayer = parser.NormalizedExprLayerClone(exprLayer)
    var facts: texpr.TypedExprFactTable
    if !texpr.TypedExprBuildFactsWithMetadataContexts(sourceTexts,
                                                       factsExprLayer,
                                                       metadataContexts,
                                                       facts,
                                                       err) ||
       texpr.TypedExprFactTableCount(facts) <= 0:
        return 5
    sourceTexts[0] = source
    if ownerIndex.released || !texpr.TypedExprSourceContextOwnsBuildIndex(metadataContexts[0]) ||
       texpr.TypedExprBuildIndexReleaseCount(ownerIndex) != 0:
        return 6

    var ir: texpr.TypedExprIr
    var filterSourcePaths: str[]
    var filterFunctionNames: str[]
    var filterStartLines: int32[]
    if !texpr.TypedExprSnapshotBuild(sourceTexts,
                                   metadataContexts,
                                   facts,
                                   exprLayer,
                                   ir,
                                   false,
                                   filterSourcePaths,
                                   filterFunctionNames,
                                   filterStartLines):
        return 7
    if ownerIndex.released || !texpr.TypedExprSourceContextOwnsBuildIndex(metadataContexts[0]) ||
       metadataContexts[0].buildIndex != ownerIndex ||
       texpr.TypedExprBuildIndexReleaseCount(ownerIndex) != 0 ||
       ir.functions2_functionNameIds.len <= 0:
        return 8

    var contextIndex: int32
    if texpr.TypedExprBuildIndexLookup(ownerIndex,
                                       "ctx_source",
                                       parser.ParserNormalizePath(sourcePath),
                                       "",
                                       "",
                                       contextIndex) != texpr.TypedExprBuildIndexUnique ||
       contextIndex != 0:
        return 9

    # Replacing a target's unrelated owner must release exactly that owner, then
    # repeated borrow and borrowed move/clear must leave the shared owner alive.
    var independent = contextParsed("/work/pkg/borrow_target_owner.cheng",
                                    "fn Independent(): int32 = 1\n")
    let independentIndex = independent.buildIndex
    if independentIndex == nil || independentIndex == ownerIndex ||
       !texpr.TypedExprSourceContextOwnsBuildIndex(independent):
        return 10
    texpr.TypedExprSourceContextBorrowBuildIndexFromOwner(independent,
                                                          metadataContexts[0])
    if !independentIndex.released ||
       texpr.TypedExprBuildIndexReleaseCount(independentIndex) != 1 ||
       independent.buildIndex != ownerIndex || independent.buildIndexOwned:
        return 11
    texpr.TypedExprSourceContextBorrowBuildIndexFromOwner(independent,
                                                          metadataContexts[0])
    if independent.buildIndex != ownerIndex || independent.buildIndexOwned ||
       ownerIndex.released || texpr.TypedExprBuildIndexReleaseCount(ownerIndex) != 0:
        return 12
    if texpr.TypedExprBuildIndexLookup(independent.buildIndex,
                                       "ctx_source",
                                       parser.ParserNormalizePath(sourcePath),
                                       "",
                                       "",
                                       contextIndex) != texpr.TypedExprBuildIndexUnique:
        return 13

    var movedBorrow: texpr.TypedExprSourceContext
    texpr.TypedExprSourceContextMoveInto(movedBorrow, independent)
    if independent.buildIndex != nil || independent.buildIndexOwned ||
       movedBorrow.buildIndex != ownerIndex || movedBorrow.buildIndexOwned:
        return 14
    texpr.TypedExprClearSourceContextAllFields(movedBorrow)
    texpr.TypedExprClearSourceContextAllFields(movedBorrow)
    if ownerIndex.released || texpr.TypedExprBuildIndexReleaseCount(ownerIndex) != 0:
        return 15

    var directBorrow = texpr.TypedExprSourceContextBorrowedView(metadataContexts[0])
    if directBorrow.buildIndex != ownerIndex || directBorrow.buildIndexOwned:
        return 16
    texpr.TypedExprClearSourceContextAllFields(directBorrow)
    if ownerIndex.released || texpr.TypedExprBuildIndexReleaseCount(ownerIndex) != 0:
        return 17

    texpr.TypedExprIrReleasePayload(ir)
    texpr.TypedExprFactTableRelease(facts)
    parser.NormalizedExprLayerReset(factsExprLayer)
    parser.NormalizedExprLayerReset(exprLayer)
    texpr.TypedExprClearSourceContextAllFields(metadataContexts[0])
    texpr.TypedExprClearSourceContextAllFields(metadataContexts[0])
    if !ownerIndex.released || texpr.TypedExprBuildIndexReleaseCount(ownerIndex) != 1:
        return 18
    return 0

type
    FrozenAtomicIrSnapshot =
        functionCount: int32
        statementCount: int32
        nodeCount: int32
        globalCount: int32
        localBindingCount: int32
        importcCount: int32
        typeLayoutCount: int32
        typeFieldCount: int32
        typeAliasCount: int32
        enumCount: int32
        sourceContextIndexCount: int32
        statementFunctionIndexCount: int32
        statementBindingIndexCount: int32
        paramRefIndexCount: int32
        firstFunctionNameId: int32
        lastFunctionNameId: int32
        validationEpoch: int32
        reuseCount: int32
        queryLookupCount: int32
        queryProbeCount: int32
        queryMetadataScanCount: int32
        registerCount: int32
        registerProbeCount: int32
        rehashEntryVisitCount: int32
        visibilityQueryCount: int32
        layoutCacheCount: int32
        fieldLayoutReadyCount: int32
        frozenMetadataLiveBytes: int64
        frozenFullContextCount: int32
        frozenJoinedLookupKeyBytes: int64
        frozenSessionGeneration: int32
        frozenCanonicalDigest: str
        frozenDuplicatedSemanticTextBytes: int64

fn frozenAtomicIrSnapshot(ir: var texpr.TypedExprIr): FrozenAtomicIrSnapshot =
    var out: FrozenAtomicIrSnapshot
    out.functionCount = ir.functions2_functionNameIds.len
    out.statementCount = arenamod.ArenaArrayInt32Len(ir.arena,
                                                      ir.statements2_statementIndexs)
    out.nodeCount = arenamod.ArenaArrayInt32Len(ir.arena, ir.nodes2_nodeIndexs)
    out.globalCount = ir.globalNames.len
    out.localBindingCount = ir.localBindingNames.len
    out.importcCount = ir.importcNames.len
    out.typeLayoutCount = ir.typeLayoutNames.len
    out.typeFieldCount = ir.typeFieldNames.len
    out.typeAliasCount = ir.typeDefAliasNames.len
    out.enumCount = ir.enumValueNames.len
    out.sourceContextIndexCount = ir.sourceContextIndexSourcePaths.len
    out.statementFunctionIndexCount = ir.statementFunctionIndexEntryNames.len
    out.statementBindingIndexCount = ir.statementFnBindingIndexEntryBindingNames.len
    out.paramRefIndexCount = ir.paramRefIndexEntryParamNames.len
    if ir.functions2_functionNameIds.len > 0:
        out.firstFunctionNameId = ir.functions2_functionNameIds[0]
        out.lastFunctionNameId =
            ir.functions2_functionNameIds[ir.functions2_functionNameIds.len - 1]
    let index = texpr.TypedExprIrBuildIndex(ir)
    out.validationEpoch = texpr.TypedExprBuildIndexValidationEpoch(index)
    out.reuseCount = texpr.TypedExprBuildIndexReuseCount(index)
    out.queryLookupCount = texpr.TypedExprBuildIndexQueryLookupCount(index)
    out.queryProbeCount = texpr.TypedExprBuildIndexQueryProbeCount(index)
    out.queryMetadataScanCount =
        texpr.TypedExprBuildIndexQueryMetadataScanCount(index)
    out.registerCount = texpr.TypedExprBuildIndexRegisterCount(index)
    out.registerProbeCount = texpr.TypedExprBuildIndexRegisterProbeCount(index)
    out.rehashEntryVisitCount =
        texpr.TypedExprBuildIndexRehashEntryVisitCount(index)
    out.visibilityQueryCount = index.visibilityQueryKinds.len
    out.layoutCacheCount = index.layoutSourcePaths.len
    for nodeIndex in 0..<index.contextFieldNodeLayoutReady.len:
        if index.contextFieldNodeLayoutReady[nodeIndex]:
            out.fieldLayoutReadyCount = out.fieldLayoutReadyCount + 1
    out.frozenMetadataLiveBytes =
        texpr.TypedExprSealedBuildIndexMetadataLiveBytes(ir)
    out.frozenFullContextCount =
        texpr.TypedExprSealedBuildIndexFullContextCount(ir)
    out.frozenJoinedLookupKeyBytes =
        texpr.TypedExprSealedBuildIndexJoinedLookupKeyBytes(ir)
    out.frozenSessionGeneration =
        texpr.TypedExprSealedBuildIndexSessionGeneration(ir)
    out.frozenCanonicalDigest =
        texpr.TypedExprSealedBuildIndexCanonicalDigest(ir)
    out.frozenDuplicatedSemanticTextBytes =
        texpr.TypedExprSealedBuildIndexDuplicatedSemanticTextBytes(ir)
    return out

@borrows
fn frozenAtomicIrSnapshotsEqual(lhs: FrozenAtomicIrSnapshot,
                                rhs: FrozenAtomicIrSnapshot): bool =
    return lhs.functionCount == rhs.functionCount &&
           lhs.statementCount == rhs.statementCount &&
           lhs.nodeCount == rhs.nodeCount &&
           lhs.globalCount == rhs.globalCount &&
           lhs.localBindingCount == rhs.localBindingCount &&
           lhs.importcCount == rhs.importcCount &&
           lhs.typeLayoutCount == rhs.typeLayoutCount &&
           lhs.typeFieldCount == rhs.typeFieldCount &&
           lhs.typeAliasCount == rhs.typeAliasCount &&
           lhs.enumCount == rhs.enumCount &&
           lhs.sourceContextIndexCount == rhs.sourceContextIndexCount &&
           lhs.statementFunctionIndexCount == rhs.statementFunctionIndexCount &&
           lhs.statementBindingIndexCount == rhs.statementBindingIndexCount &&
           lhs.paramRefIndexCount == rhs.paramRefIndexCount &&
           lhs.firstFunctionNameId == rhs.firstFunctionNameId &&
           lhs.lastFunctionNameId == rhs.lastFunctionNameId &&
           lhs.validationEpoch == rhs.validationEpoch &&
           lhs.reuseCount == rhs.reuseCount &&
           lhs.queryLookupCount == rhs.queryLookupCount &&
           lhs.queryProbeCount == rhs.queryProbeCount &&
           lhs.queryMetadataScanCount == rhs.queryMetadataScanCount &&
           lhs.registerCount == rhs.registerCount &&
           lhs.registerProbeCount == rhs.registerProbeCount &&
           lhs.rehashEntryVisitCount == rhs.rehashEntryVisitCount &&
           lhs.visibilityQueryCount == rhs.visibilityQueryCount &&
           lhs.layoutCacheCount == rhs.layoutCacheCount &&
           lhs.fieldLayoutReadyCount == rhs.fieldLayoutReadyCount &&
           lhs.frozenMetadataLiveBytes == rhs.frozenMetadataLiveBytes &&
           lhs.frozenFullContextCount == rhs.frozenFullContextCount &&
           lhs.frozenJoinedLookupKeyBytes == rhs.frozenJoinedLookupKeyBytes &&
           lhs.frozenSessionGeneration == rhs.frozenSessionGeneration &&
           lhs.frozenCanonicalDigest == rhs.frozenCanonicalDigest &&
           lhs.frozenDuplicatedSemanticTextBytes ==
               rhs.frozenDuplicatedSemanticTextBytes

@borrows
fn frozenRoundSourceTextsEqual(lhs: texpr.TypedExprSourceText[],
                               rhs: texpr.TypedExprSourceText[]): bool =
    if lhs.len != rhs.len:
        return false
    for sourceIndex in 0..<lhs.len:
        if lhs[sourceIndex].workspaceRoot != rhs[sourceIndex].workspaceRoot ||
           lhs[sourceIndex].packageRoot != rhs[sourceIndex].packageRoot ||
           lhs[sourceIndex].packageId != rhs[sourceIndex].packageId ||
           lhs[sourceIndex].packageChannel != rhs[sourceIndex].packageChannel ||
           lhs[sourceIndex].sourcePath != rhs[sourceIndex].sourcePath ||
           lhs[sourceIndex].text != rhs[sourceIndex].text ||
           lhs[sourceIndex].snapshotOnly != rhs[sourceIndex].snapshotOnly ||
           lhs[sourceIndex].externalPackageRoots.len !=
               rhs[sourceIndex].externalPackageRoots.len:
            return false
    return true

@borrows
fn frozenRoundExprLayersEqual(lhs: parser.NormalizedExprLayer,
                              rhs: parser.NormalizedExprLayer): bool =
    if lhs.sourceCount != rhs.sourceCount ||
       lhs.questionResidualCount != rhs.questionResidualCount ||
       lhs.exprs.len != rhs.exprs.len ||
       lhs.exprNext.len != rhs.exprNext.len ||
       lhs.exprLookup.slots.len != rhs.exprLookup.slots.len ||
       lhs.exprLookup.buckets.len != rhs.exprLookup.buckets.len:
        return false
    for exprIndex in 0..<lhs.exprs.len:
        let left = lhs.exprs[exprIndex]
        let right = rhs.exprs[exprIndex]
        if left.exprId != right.exprId ||
           left.sourcePath != right.sourcePath ||
           left.lineNumber != right.lineNumber ||
           left.columnNumber != right.columnNumber ||
           left.endLineNumber != right.endLineNumber ||
           left.endColumnNumber != right.endColumnNumber ||
           left.kind != right.kind ||
           left.detailKind != right.detailKind ||
           left.surfaceText != right.surfaceText ||
           left.callSurfaceKind != right.callSurfaceKind ||
           left.callResolved != right.callResolved ||
           left.callReason != right.callReason ||
           left.callQualifier != right.callQualifier ||
           left.callCallee != right.callCallee ||
           left.callTarget != right.callTarget ||
           left.callTargetSourcePath != right.callTargetSourcePath ||
           left.callTargetImportc != right.callTargetImportc ||
           left.callPrefixStyle != right.callPrefixStyle ||
           left.callArgCount != right.callArgCount ||
           left.callArgsText != right.callArgsText:
            return false
    for nextIndex in 0..<lhs.exprNext.len:
        if lhs.exprNext[nextIndex] != rhs.exprNext[nextIndex]:
            return false
    for slotIndex in 0..<lhs.exprLookup.slots.len:
        if lhs.exprLookup.slots[slotIndex] != rhs.exprLookup.slots[slotIndex]:
            return false
    return true

fn frozenSessionMetadataRowCount(ctx: var texpr.TypedExprSourceContext): int32 =
    return 1 + ctx.scopes.len + ctx.signatureScopes.len +
           ctx.importcFunctions.len + ctx.importedModules.len +
           ctx.declaredTypes.len + ctx.refTypes.len +
           ctx.typeDefAliasNames.len + ctx.typeFields.len +
           ctx.enumValueNames.len

@borrows
fn frozenDerivedEnumFingerprintBorrowed(
        index: texpr.TypedExprBuildIndex): bool =
    if index == nil || index.released ||
       index.entryFingerprintIds.len != index.entryFingerprints.len:
        return false
    var borrowedRows: int32
    for rowIndex in 0..<index.entryKinds.len:
        let kind = index.entryKinds[rowIndex]
        if kind != "ir_enum_name_source" &&
           kind != "ir_enum_name_global":
            continue
        if rowIndex >= index.entryFingerprintIds.len ||
           index.entryFingerprintIds[rowIndex] < 0 ||
           index.entryFingerprints[rowIndex] != "":
            return false
        borrowedRows = borrowedRows + 1
    return borrowedRows == 2

fn prepareFrozenSessionFixture(ir: var texpr.TypedExprIr,
                               contexts: var texpr.TypedExprSourceContext[],
                               sourceA: var texpr.TypedExprSourceText,
                               sourceB: var texpr.TypedExprSourceText,
                               sourceC: var texpr.TypedExprSourceText,
                               err: var str): bool =
    let pathA = "/work/pkg/frozen_session_a.cheng"
    let pathB = "/work/pkg/frozen_session_b.cheng"
    let pathC = "/work/pkg/frozen_session_c.cheng"
    let textA = "fn FrozenA(): int32 = 1\n"
    let textB = "fn FrozenBValue(): int32 = 2\nfn FrozenB(): int32 = FrozenBValue()\n"
    let textC = "@abi_internal\n@importc(\"frozen_c_symbol\")\nfn FrozenCNative(value: int32): int64\n@importc(\"frozen_c_map\")\n@ffi_map(ptr = arg0, len = arg1)\nfn FrozenCMap(values: int32[]): int32\n@importc(\"frozen_c_out\")\n@ffi_out_ptrs(arg0, arg1)\nfn FrozenCOut(first: int32, second: int32): tuple[int32, int32]\n@ffi_owned_result(free = FrozenCFree)\n@importc(\"frozen_c_owned\")\nfn FrozenCOwned(value: cstring): owned_cstring\nfn FrozenCValue(): int32 = 3\nfn FrozenC(): int32 = FrozenCValue()\n"
    var externalRoots: parser.ParserExternalPackageRoot[]
    sourceA = sourceNew("/work",
                        "/work/pkg",
                        "pkg://frozen-session",
                        "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
                        pathA,
                        textA,
                        externalRoots)
    sourceB = sourceNew("/work",
                        "/work/pkg",
                        "pkg://frozen-session",
                        "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
                        pathB,
                        textB,
                        externalRoots)
    sourceC = sourceNew("/work",
                        "/work/pkg",
                        "pkg://frozen-session",
                        "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
                        pathC,
                        textC,
                        externalRoots)
    var contextA = frozenMetadataContext(sourceA)
    var contextB = frozenMetadataContext(sourceB)
    var contextC = frozenMetadataContext(sourceC)
    contextA.packageOwnerKey = "pkg://frozen-session"
    contextB.packageOwnerKey = "pkg://frozen-session"
    contextC.packageOwnerKey = "pkg://frozen-session"
    contextImport(contextA, "frozen_b", pathB)
    contextDeclared(contextB, "FrozenRecord")
    contextDeclared(contextB, "FrozenTwin")
    contextDeclared(contextC, "FrozenTwin")
    contextRef(contextC, "FrozenRef")
    contextAlias(contextA, "FrozenAlias", "int32")
    contextEnum(contextA, "FrozenChoice", "FrozenChoiceType", 7)
    contextField(contextB, "FrozenRecord", "value", "int32")
    var frozenField = contextB.typeFields[0]
    frozenField.offsetBytes = 0
    frozenField.sizeBytes = 4
    frozenField.alignBytes = 4
    contextB.typeFields[0] = frozenField
    for scopeIndex in 0..<contextB.scopes.len:
        add(contextB.signatureScopes, share(contextB.scopes[scopeIndex]))
    sourceC.snapshotOnly = true
    contextC.snapshotOnly = true
    contexts = []
    texpr.TypedExprSourceContextAppendMove(contexts, contextA)
    texpr.TypedExprSourceContextAppendMove(contexts, contextB)
    texpr.TypedExprSourceContextAppendMove(contexts, contextC)

    var initialSources = [sourceA]
    var facts: texpr.TypedExprFactTable
    var exprLayer: parser.NormalizedExprLayer
    var filterSourcePaths = [pathA]
    var filterFunctionNames = ["FrozenA"]
    var filterStartLines = [int32(1)]
    if !texpr.TypedExprBuildIrWithFactsMetadataAndExprLayer(initialSources,
                                                            facts,
                                                            exprLayer,
                                                            contexts,
                                                            true,
                                                            filterSourcePaths,
                                                            filterFunctionNames,
                                                            filterStartLines,
                                                            ir,
                                                            err):
        return false
    add(ir.typeLayoutSourcePaths, pathB)
    add(ir.typeLayoutNames, "FrozenTwin")
    add(ir.typeLayoutSizeBytes, 4)
    add(ir.typeLayoutAlignBytes, 4)
    add(ir.typeLayoutFieldCounts, 0)
    add(ir.typeLayoutSourcePaths, pathC)
    add(ir.typeLayoutNames, "FrozenTwin")
    add(ir.typeLayoutSizeBytes, 8)
    add(ir.typeLayoutAlignBytes, 8)
    add(ir.typeLayoutFieldCounts, 0)
    return ir.functions2_functionNameIds.len == 1

@borrows
fn frozenDeclarationLookupExact(ir: var texpr.TypedExprIr,
                                sourcePath: str,
                                functionName: str): bool =
    let index = texpr.TypedExprIrCanonicalMetadataIndex(ir)
    if index == nil:
        return false
    var row: int32
    var rank: int32
    var mismatch: bool
    var noArgs: str[]
    return texpr.TypedExprBuildIndexLookupCallDeclarationInSource(
               index,
               sourcePath,
               functionName,
               texpr.TypedExprCallDeclarationFunction,
               noArgs,
               [],
               false,
               row,
               rank,
               mismatch) == texpr.TypedExprBuildIndexUnique &&
           rank == 2 && row >= 0 && !mismatch

@borrows
fn prepareFrozenRoundExprLayer(sourceB: texpr.TypedExprSourceText,
                               sourceC: texpr.TypedExprSourceText,
                               sourceTexts: var texpr.TypedExprSourceText[],
                               exprLayer: var parser.NormalizedExprLayer,
                               err: var str): bool =
    sourceTexts = [share(sourceB), share(sourceC)]
    if !texpr.TypedExprReadNormalizedExprLayerForSourceTexts(sourceTexts,
                                                             exprLayer,
                                                             err):
        return false
    sourceTexts = [share(sourceB), share(sourceC)]
    var firstB: int32 = -1
    var firstC: int32 = -1
    for exprIndex in 0..<exprLayer.exprs.len:
        if firstB < 0 &&
           exprLayer.exprs[exprIndex].sourcePath == sourceB.sourcePath:
            firstB = exprIndex
        if firstC < 0 &&
           exprLayer.exprs[exprIndex].sourcePath == sourceC.sourcePath:
            firstC = exprIndex
    return firstB >= 0 && firstC > firstB

@borrows
fn appendFrozenSessionRound(ir: var texpr.TypedExprIr,
                            source: texpr.TypedExprSourceText,
                            err: var str): bool =
    var sourceTexts = [share(source)]
    var exprLayer: parser.NormalizedExprLayer
    if !texpr.TypedExprReadNormalizedExprLayerForSourceTexts(sourceTexts,
                                                             exprLayer,
                                                             err):
        return false
    sourceTexts[0] = share(source)
    var facts: texpr.TypedExprFactTable
    let validationBeforeFacts =
        texpr.TypedExprSealedBuildIndexValidationCount(ir)
    if !texpr.TypedExprBuildFactsForExprLayerPreservingSealed(sourceTexts,
                                                              exprLayer,
                                                              ir,
                                                              facts,
                                                              err):
        return false
    if texpr.TypedExprSealedBuildIndexValidationCount(ir) !=
       validationBeforeFacts + 1:
        return false
    sourceTexts[0] = share(source)
    var filterSourcePaths: str[]
    var filterFunctionNames: str[]
    var filterStartLines: int32[]
    let validationBeforeAppend =
        texpr.TypedExprSealedBuildIndexValidationCount(ir)
    if !texpr.TypedExprAppendIrFunctionsWithFactsMetadataAndExprLayerSealed(
            sourceTexts,
            facts,
            exprLayer,
            false,
            filterSourcePaths,
            filterFunctionNames,
            filterStartLines,
            ir,
            err):
        return false
    if texpr.TypedExprSealedBuildIndexValidationCount(ir) !=
       validationBeforeAppend + 1:
        return false
    texpr.TypedExprFactTableRelease(facts)
    parser.NormalizedExprLayerReset(exprLayer)
    return true

fn runFrozenMetadataSessionContract(): int32 =
    var ir: texpr.TypedExprIr
    var contexts: texpr.TypedExprSourceContext[]
    var sourceA: texpr.TypedExprSourceText
    var sourceB: texpr.TypedExprSourceText
    var sourceC: texpr.TypedExprSourceText
    var err: str
    if !prepareFrozenSessionFixture(ir,
                                    contexts,
                                    sourceA,
                                    sourceB,
                                    sourceC,
                                    err):
        return 1
    let rowsB = frozenSessionMetadataRowCount(contexts[1])
    let rowsC = frozenSessionMetadataRowCount(contexts[2])
    if !texpr.TypedExprSealBuildSourceContextIndex(ir, contexts, err):
        return 2
    if contexts.len != 0 ||
       !texpr.TypedExprSealedBuildIndexActive(ir) ||
       texpr.TypedExprSealedBuildIndexClosed(ir) ||
       texpr.TypedExprSealedBuildIndexFullValidationCount(ir) != 1 ||
       texpr.TypedExprSealedBuildIndexValidationCount(ir) != 0 ||
       texpr.TypedExprSealedBuildIndexMetadataLiveBytes(ir) <= 0 ||
       texpr.TypedExprSealedBuildIndexPreSealFullIndexBytes(ir) <=
           texpr.TypedExprSealedBuildIndexCanonicalIndexBytes(ir) ||
       texpr.TypedExprSealedBuildIndexCanonicalIndexBytes(ir) <= 0 ||
       texpr.TypedExprSealedBuildIndexCanonicalStoreBytes(ir) <= 0 ||
       texpr.TypedExprSealedBuildIndexDuplicatedSemanticTextBytes(ir) != 0 ||
       texpr.TypedExprSealedBuildIndexDerivedIrCanonicalTextOverlapBytes(ir) != 0 ||
       texpr.TypedExprSealedBuildIndexDerivedIrSemanticTextBytes(ir) <= 0 ||
       !frozenDerivedEnumFingerprintBorrowed(
           texpr.TypedExprIrBuildIndex(ir)) ||
       texpr.TypedExprSealedBuildIndexCanonicalDigest(ir) == "" ||
       texpr.TypedExprSealedBuildIndexMetadataOwnerCount(ir) != 2 ||
       texpr.TypedExprSealedBuildIndexRoundContextCount(ir) != 0 ||
       texpr.TypedExprSealedBuildIndexDependencyCount(ir) != 0 ||
       texpr.TypedExprSealedBuildIndexRoundViewLiveBytes(ir) != 0 ||
       texpr.TypedExprSealedBuildIndexFullContextCount(ir) != 0 ||
       texpr.TypedExprSealedBuildIndexJoinedLookupKeyBytes(ir) != 0:
        return 3
    let frozenDeclarationIndex =
        texpr.TypedExprIrCanonicalMetadataIndex(ir)
    var frozenDeclarationRow: int32
    var frozenDeclarationRank: int32
    var frozenDeclarationMismatch: bool
    var frozenNoArgs: str[]
    if frozenDeclarationIndex == nil ||
       frozenDeclarationIndex == texpr.TypedExprIrBuildIndex(ir) ||
       texpr.TypedExprIrCallDeclarationBuildIndex(ir) !=
           frozenDeclarationIndex ||
       texpr.TypedExprBuildIndexLookupCallDeclarationInSource(
           frozenDeclarationIndex,
           sourceA.sourcePath,
           "FrozenA",
           texpr.TypedExprCallDeclarationFunction,
           frozenNoArgs,
           [],
           false,
           frozenDeclarationRow,
           frozenDeclarationRank,
           frozenDeclarationMismatch) != texpr.TypedExprBuildIndexUnique ||
       frozenDeclarationRank != 2 || frozenDeclarationRow < 0 ||
       frozenDeclarationMismatch:
        return 21
    let validationEpochAtSeal =
        texpr.TypedExprBuildIndexValidationEpoch(texpr.TypedExprIrBuildIndex(ir))
    let sessionGeneration =
        texpr.TypedExprSealedBuildIndexSessionGeneration(ir)
    if validationEpochAtSeal <= 0 || sessionGeneration <= 0:
        return 4

    # Same aggregate text in two sources must remain two exact source-owned
    # identities.  The ownerless aggregate row is intentionally ambiguous;
    # it must never become a text-only fallback.
    let derivedIdentityIndex = texpr.TypedExprIrBuildIndex(ir)
    var twinBRow: int32
    var twinCRow: int32
    var twinGlobalRow: int32
    if texpr.TypedExprBuildIndexLookup(
           derivedIdentityIndex,
           "ir_layout_source",
           sourceB.sourcePath,
           "FrozenTwin",
           "",
           twinBRow) != texpr.TypedExprBuildIndexUnique:
        return 22
    if texpr.TypedExprBuildIndexLookup(
           derivedIdentityIndex,
           "ir_layout_source",
           sourceC.sourcePath,
           "FrozenTwin",
           "",
           twinCRow) != texpr.TypedExprBuildIndexUnique:
        return 24
    if twinBRow < 0 || twinCRow < 0 || twinBRow == twinCRow:
        return 25
    if texpr.TypedExprBuildIndexLookup(
           derivedIdentityIndex,
           "ir_layout_global",
           "",
           "FrozenTwin",
           "",
           twinGlobalRow) != texpr.TypedExprBuildIndexAmbiguous:
        return 26
    if twinBRow >= derivedIdentityIndex.entrySourcePathIds.len ||
       twinCRow >= derivedIdentityIndex.entrySourcePathIds.len ||
       derivedIdentityIndex.entrySourcePathIds[twinBRow] < 0 ||
       derivedIdentityIndex.entrySourcePathIds[twinCRow] < 0 ||
       derivedIdentityIndex.entrySourcePaths[twinBRow] != "" ||
       derivedIdentityIndex.entrySourcePaths[twinCRow] != "":
        return 28
    var twinBSize: int32
    var twinBAlign: int32
    var twinBFields: int32
    var twinCSize: int32
    var twinCAlign: int32
    var twinCFields: int32
    var unownedSize: int32
    var unownedAlign: int32
    var unownedFields: int32
    if !texpr.TypedExprIrLookupTypeLayout(
           ir, sourceB.sourcePath, "FrozenTwin",
           twinBSize, twinBAlign, twinBFields) ||
       !texpr.TypedExprIrLookupTypeLayout(
           ir, sourceC.sourcePath, "FrozenTwin",
           twinCSize, twinCAlign, twinCFields) ||
       twinBSize != 4 || twinBAlign != 4 || twinBFields != 0 ||
       twinCSize != 8 || twinCAlign != 8 || twinCFields != 0 ||
       texpr.TypedExprIrLookupTypeLayout(
           ir, "", "FrozenTwin",
           unownedSize, unownedAlign, unownedFields):
        return 29
    if cmdline.paramStr(1) == "frozen-owner-identity-contract":
        let frozenCallCount =
            frozenDeclarationIndex.callDeclarationKinds.len
        let frozenProducerSource =
            frozenDeclarationIndex.callDeclarationProducerSourceIndexes[
                frozenDeclarationRow]
        let frozenProducerDeclarationOrdinal =
            frozenDeclarationIndex.
                callDeclarationProducerDeclarationOrdinals[
                frozenDeclarationRow]
        let frozenProducerFunctionRow =
            frozenDeclarationIndex.
                callDeclarationProducerFunctionRows[
                frozenDeclarationRow]
        if !texpr.TypedExprCloseSealedBuildSourceContextIndex(ir, err):
            return 30
        let closedIndex = texpr.TypedExprIrBuildIndex(ir)
        if texpr.TypedExprIrCallDeclarationBuildIndex(ir) != closedIndex ||
           frozenCallCount <= 0 ||
           closedIndex.callDeclarationKinds.len != frozenCallCount ||
           closedIndex.callDeclarationProducerSourceIndexes.len !=
               frozenCallCount ||
           closedIndex.callDeclarationProducerDeclarationOrdinals.len !=
               frozenCallCount ||
           closedIndex.callDeclarationProducerFunctionRows.len !=
               frozenCallCount:
            return 31
        if closedIndex.callDeclarationProducerSourceIndexes[
               frozenDeclarationRow] != frozenProducerSource ||
           closedIndex.callDeclarationProducerDeclarationOrdinals[
               frozenDeclarationRow] !=
               frozenProducerDeclarationOrdinal ||
           closedIndex.callDeclarationProducerFunctionRows[
               frozenDeclarationRow] !=
               frozenProducerFunctionRow:
            return 32
        texpr.TypedExprIrReleasePayload(ir)
        return 0

    var probeQueriesBefore: int64
    var probeBucketsBefore: int64
    var probeEmptyBefore: int64
    var probeTextScansBefore: int64
    if texpr.TypedExprTestDerivedIrCanonicalTextOverlapProbe(
            ir,
            probeQueriesBefore,
            probeBucketsBefore,
            probeEmptyBefore,
            probeTextScansBefore) != 0 ||
       probeQueriesBefore <= 0 ||
       probeQueriesBefore != probeBucketsBefore + probeEmptyBefore ||
       probeTextScansBefore != 0:
        return 5
    let overlapProbeRows: int32 = 2048
    for rowIndex in 0..<overlapProbeRows:
        let probeName = Fmt"overlap_probe_{rowIndex}"
        if texpr.TypedExprTestRegisterDerivedBuildIndex(
                ir,
                "ir_overlap_probe",
                "/work/pkg/frozen_session_a.cheng",
                probeName,
                "",
                rowIndex,
                "/work/pkg/frozen_session_a.cheng",
                probeName,
                true) != texpr.TypedExprBuildIndexUnique:
            return 5
    var probeQueriesAfter: int64
    var probeBucketsAfter: int64
    var probeEmptyAfter: int64
    var probeTextScansAfter: int64
    if texpr.TypedExprTestDerivedIrCanonicalTextOverlapProbe(
            ir,
            probeQueriesAfter,
            probeBucketsAfter,
            probeEmptyAfter,
            probeTextScansAfter) != 0 ||
       probeQueriesAfter - probeQueriesBefore !=
           Int64(overlapProbeRows) * Int64(6) ||
       probeBucketsAfter - probeBucketsBefore !=
           Int64(overlapProbeRows) * Int64(3) ||
       probeEmptyAfter - probeEmptyBefore !=
           Int64(overlapProbeRows) * Int64(3) ||
       probeQueriesAfter != probeBucketsAfter + probeEmptyAfter ||
       probeTextScansAfter != 0:
        return 5

    var moved: texpr.TypedExprIr
    texpr.TypedExprIrMoveInto(moved, ir)
    if texpr.TypedExprSealedBuildIndexActive(ir) ||
       !texpr.TypedExprSealedBuildIndexActive(moved) ||
       texpr.TypedExprSealedBuildIndexSessionGeneration(moved) != sessionGeneration:
        return 6

    var emptySources: texpr.TypedExprSourceText[]
    var emptyFacts: texpr.TypedExprFactTable
    var emptyExprLayer: parser.NormalizedExprLayer
    var emptyFilterSources: str[]
    var emptyFilterFunctions: str[]
    var emptyFilterStarts: int32[]
    let emptyIrBefore = frozenAtomicIrSnapshot(moved)
    let emptyValidationBefore =
        texpr.TypedExprSealedBuildIndexValidationCount(moved)
    let emptyRowsBefore =
        texpr.TypedExprSealedBuildIndexMetadataRowsVisited(moved)
    if !texpr.TypedExprAppendIrFunctionsWithFactsMetadataAndExprLayerSealed(
            emptySources,
            emptyFacts,
            emptyExprLayer,
            false,
            emptyFilterSources,
            emptyFilterFunctions,
            emptyFilterStarts,
            moved,
            err) ||
       !frozenAtomicIrSnapshotsEqual(frozenAtomicIrSnapshot(moved),
                                     emptyIrBefore) ||
       texpr.TypedExprSealedBuildIndexValidationCount(moved) !=
           emptyValidationBefore + 1 ||
       texpr.TypedExprSealedBuildIndexMetadataRowsVisited(moved) !=
           emptyRowsBefore ||
       texpr.TypedExprSealedBuildIndexFullContextCount(moved) != 0:
        return 7

    if !appendFrozenSessionRound(moved, sourceB, err):
        return 8
    if texpr.TypedExprSealedBuildIndexRoundContextCount(moved) != 1 ||
       texpr.TypedExprSealedBuildIndexDependencyCount(moved) < 0 ||
       texpr.TypedExprSealedBuildIndexRoundPeakBytes(moved) <= 0 ||
       texpr.TypedExprSealedBuildIndexRoundViewLiveBytes(moved) != 0 ||
       texpr.TypedExprSealedBuildIndexMetadataOwnerCount(moved) != 2 ||
       texpr.TypedExprSealedBuildIndexDuplicatedSemanticTextBytes(moved) != 0 ||
       texpr.TypedExprSealedBuildIndexDerivedIrCanonicalTextOverlapBytes(moved) != 0:
        return 9
    if texpr.TypedExprBuildIndexValidationEpoch(texpr.TypedExprIrBuildIndex(moved)) !=
       validationEpochAtSeal:
        return 10
    if !appendFrozenSessionRound(moved, sourceC, err):
        return 11
    if texpr.TypedExprSealedBuildIndexValidationCount(moved) != 5 ||
       texpr.TypedExprBuildIndexValidationEpoch(texpr.TypedExprIrBuildIndex(moved)) !=
       validationEpochAtSeal:
        return 12
    let visitedRows = texpr.TypedExprSealedBuildIndexMetadataRowsVisited(moved)
    if visitedRows != Int64((rowsB + rowsC) * 2) ||
       visitedRows >= Int64(texpr.TypedExprSealedBuildIndexMetadataRowCount(moved) * 2):
        return 13
    if !texpr.TypedExprCloseSealedBuildSourceContextIndex(moved, err):
        return 14
    if !texpr.TypedExprSealedBuildIndexClosed(moved) ||
       texpr.TypedExprSealedBuildIndexActive(moved) ||
       texpr.TypedExprSealedBuildIndexFullValidationCount(moved) != 2 ||
       texpr.TypedExprSealedBuildIndexValidationEpoch(moved) <= validationEpochAtSeal ||
       texpr.TypedExprSealedBuildIndexMetadataLiveBytes(moved) != 0 ||
       texpr.TypedExprSealedBuildIndexDuplicatedSemanticTextBytes(moved) != 0 ||
       texpr.TypedExprSealedBuildIndexDerivedIrCanonicalTextOverlapBytes(moved) != 0 ||
       texpr.TypedExprSealedBuildIndexFullContextCount(moved) != 0 ||
       texpr.TypedExprSealedBuildIndexJoinedLookupKeyBytes(moved) != 0:
        return 15
    if !frozenDeclarationLookupExact(moved,
                                     sourceA.sourcePath,
                                     "FrozenA"):
        return 16
    texpr.TypedExprIrCompactForBackend(moved)
    var backendMoved: texpr.TypedExprIr
    texpr.TypedExprIrMoveInto(backendMoved, moved)
    if !frozenDeclarationLookupExact(backendMoved,
                                     sourceA.sourcePath,
                                     "FrozenA"):
        return 17
    texpr.TypedExprIrReleasePayload(backendMoved)
    return 0

fn runFrozenSealFailureAtomicityContract(): int32 =
    var retryIr: texpr.TypedExprIr
    var retryContexts: texpr.TypedExprSourceContext[]
    var retrySourceA: texpr.TypedExprSourceText
    var retrySourceB: texpr.TypedExprSourceText
    var retrySourceC: texpr.TypedExprSourceText
    var err: str
    if !prepareFrozenSessionFixture(retryIr,
                                    retryContexts,
                                    retrySourceA,
                                    retrySourceB,
                                    retrySourceC,
                                    err):
        return 1
    let retryIndex = texpr.TypedExprIrBuildIndex(retryIr)
    let epochBeforeFailure = texpr.TypedExprBuildIndexValidationEpoch(retryIndex)
    let reuseBeforeFailure = texpr.TypedExprBuildIndexReuseCount(retryIndex)
    let irBeforeFailure = frozenAtomicIrSnapshot(retryIr)
    for contextIndex in 0..<retryContexts.len:
        retryContexts[contextIndex].snapshotOnly = true
    let lastContextIndex = retryContexts.len - 1
    if lastContextIndex < 0 || retryContexts[lastContextIndex].scopes.len <= 0:
        return 2
    var brokenScope = retryContexts[lastContextIndex].scopes[0]
    let correctScopeName = share(brokenScope.name)
    brokenScope.name = ""
    retryContexts[lastContextIndex].scopes[0] = share(brokenScope)
    if texpr.TypedExprSealBuildSourceContextIndex(retryIr, retryContexts, err) ||
       !strutil.Contains(err,
                         "frozen metadata seal code=canonical_store_invalid") ||
       !strutil.Contains(
           err,
           "detail= typed expr: frozen metadata scope invalid function= start=13 end=13"):
        return 3
    if retryContexts.len != 3 ||
       texpr.TypedExprSealedBuildIndexActive(retryIr) ||
       texpr.TypedExprSealedBuildIndexFullValidationCount(retryIr) != 0 ||
       texpr.TypedExprSealedBuildIndexValidationCount(retryIr) != 0 ||
       texpr.TypedExprSealedBuildIndexMetadataRowsVisited(retryIr) != 0 ||
       texpr.TypedExprSealedBuildIndexSessionGeneration(retryIr) != 0 ||
       texpr.TypedExprSealedBuildIndexMetadataLiveBytes(retryIr) != 0 ||
       texpr.TypedExprSealedBuildIndexFullContextCount(retryIr) != 0 ||
       texpr.TypedExprSealedBuildIndexJoinedLookupKeyBytes(retryIr) != 0 ||
       !retryContexts[lastContextIndex].snapshotOnly ||
       retryContexts[lastContextIndex].scopes[0].name != "" ||
       !frozenAtomicIrSnapshotsEqual(frozenAtomicIrSnapshot(retryIr),
                                     irBeforeFailure) ||
       texpr.TypedExprBuildIndexValidationEpoch(retryIndex) != epochBeforeFailure ||
       texpr.TypedExprBuildIndexReuseCount(retryIndex) != reuseBeforeFailure:
        return 4

    brokenScope.name = correctScopeName
    retryContexts[lastContextIndex].scopes[0] = brokenScope
    for contextIndex in 0..<retryContexts.len:
        retryContexts[contextIndex].snapshotOnly = false
    retryContexts[lastContextIndex].snapshotOnly = true
    if !texpr.TypedExprSealBuildSourceContextIndex(retryIr, retryContexts, err):
        return 5
    let retrySealedIndex = texpr.TypedExprIrBuildIndex(retryIr)

    var cleanIr: texpr.TypedExprIr
    var cleanContexts: texpr.TypedExprSourceContext[]
    var cleanSourceA: texpr.TypedExprSourceText
    var cleanSourceB: texpr.TypedExprSourceText
    var cleanSourceC: texpr.TypedExprSourceText
    if !prepareFrozenSessionFixture(cleanIr,
                                    cleanContexts,
                                    cleanSourceA,
                                    cleanSourceB,
                                    cleanSourceC,
                                    err):
        return 6
    if !texpr.TypedExprSealBuildSourceContextIndex(cleanIr, cleanContexts, err):
        return 7
    let cleanIndex = texpr.TypedExprIrBuildIndex(cleanIr)
    if texpr.TypedExprBuildIndexValidationEpoch(retrySealedIndex) !=
           texpr.TypedExprBuildIndexValidationEpoch(cleanIndex) ||
       texpr.TypedExprBuildIndexReuseCount(retrySealedIndex) !=
           texpr.TypedExprBuildIndexReuseCount(cleanIndex) ||
       texpr.TypedExprSealedBuildIndexMetadataRowCount(retryIr) !=
           texpr.TypedExprSealedBuildIndexMetadataRowCount(cleanIr) ||
       texpr.TypedExprSealedBuildIndexSessionGeneration(retryIr) !=
           texpr.TypedExprSealedBuildIndexSessionGeneration(cleanIr) ||
       texpr.TypedExprSealedBuildIndexMetadataLiveBytes(retryIr) !=
           texpr.TypedExprSealedBuildIndexMetadataLiveBytes(cleanIr) ||
       texpr.TypedExprSealedBuildIndexFullContextCount(retryIr) != 0 ||
       texpr.TypedExprSealedBuildIndexFullContextCount(cleanIr) != 0 ||
       texpr.TypedExprSealedBuildIndexJoinedLookupKeyBytes(retryIr) != 0 ||
       texpr.TypedExprSealedBuildIndexJoinedLookupKeyBytes(cleanIr) != 0 ||
       texpr.TypedExprSealedBuildIndexValidationCount(retryIr) != 0 ||
       texpr.TypedExprSealedBuildIndexMetadataRowsVisited(retryIr) != 0:
        return 8
    let retryEpochAtSeal =
        texpr.TypedExprBuildIndexValidationEpoch(retrySealedIndex)
    let cleanEpochAtSeal = texpr.TypedExprBuildIndexValidationEpoch(cleanIndex)
    if !texpr.TypedExprCloseSealedBuildSourceContextIndex(retryIr, err) ||
       !texpr.TypedExprCloseSealedBuildSourceContextIndex(cleanIr, err):
        return 9
    if texpr.TypedExprBuildIndexValidationEpoch(retrySealedIndex) !=
           retryEpochAtSeal + 3 ||
       texpr.TypedExprBuildIndexValidationEpoch(cleanIndex) !=
           cleanEpochAtSeal + 3 ||
       texpr.TypedExprSealedBuildIndexValidationEpoch(retryIr) !=
           retryEpochAtSeal + 3 ||
       texpr.TypedExprSealedBuildIndexFullValidationCount(retryIr) != 2 ||
       texpr.TypedExprSealedBuildIndexMetadataLiveBytes(retryIr) != 0 ||
       texpr.TypedExprSealedBuildIndexMetadataLiveBytes(cleanIr) != 0:
        return 10
    texpr.TypedExprIrReleasePayload(retryIr)
    texpr.TypedExprIrReleasePayload(cleanIr)
    return 0

fn runFrozenRoundFailureAtomicityContract(): int32 =
    var retryIr: texpr.TypedExprIr
    var retryContexts: texpr.TypedExprSourceContext[]
    var retrySourceA: texpr.TypedExprSourceText
    var retrySourceB: texpr.TypedExprSourceText
    var retrySourceC: texpr.TypedExprSourceText
    var err: str
    if !prepareFrozenSessionFixture(retryIr,
                                    retryContexts,
                                    retrySourceA,
                                    retrySourceB,
                                    retrySourceC,
                                    err):
        return 1
    let rowsB = frozenSessionMetadataRowCount(retryContexts[1])
    let rowsC = frozenSessionMetadataRowCount(retryContexts[2])
    if !texpr.TypedExprSealBuildSourceContextIndex(retryIr, retryContexts, err):
        return 2
    let retryIndex = texpr.TypedExprIrBuildIndex(retryIr)
    let retryEpochAtSeal = texpr.TypedExprBuildIndexValidationEpoch(retryIndex)
    let retryReuseAtSeal = texpr.TypedExprBuildIndexReuseCount(retryIndex)
    var retrySources: texpr.TypedExprSourceText[]
    var retryExprLayer: parser.NormalizedExprLayer
    if !prepareFrozenRoundExprLayer(retrySourceB,
                                    retrySourceC,
                                    retrySources,
                                    retryExprLayer,
                                    err):
        return 3
    var sentinel: texpr.TypedExprFact
    sentinel.exprId = "frozen-failure-sentinel"
    sentinel.sourcePath = share(retrySourceB.sourcePath)
    sentinel.callArgsText = "sentinel"
    sentinel.lineNumber = 777
    var retryFacts: texpr.TypedExprFactTable
    texpr.TypedExprFactTableAppendHandBuilt(retryFacts, share(sentinel))

    retrySources[1].text = "fn FrozenC(): str = \"\"\"\nunterminated\n"
    var factsFailureSourcesBefore = [share(retrySources[0]),
                                     share(retrySources[1])]
    var factsFailureExprBefore = parser.NormalizedExprLayerClone(retryExprLayer)
    let factsFailureIrBefore = frozenAtomicIrSnapshot(retryIr)
    let factsFailureValidationBefore =
        texpr.TypedExprSealedBuildIndexValidationCount(retryIr)
    let factsFailureRowsBefore =
        texpr.TypedExprSealedBuildIndexMetadataRowsVisited(retryIr)
    if texpr.TypedExprBuildFactsForExprLayerPreservingSealed(retrySources,
                                                            retryExprLayer,
                                                            retryIr,
                                                            retryFacts,
                                                            err) ||
       !strutil.Contains(err, "unterminated multiline string"):
        return 4
    if texpr.TypedExprFactTableCount(retryFacts) != 1 ||
       !texpr.TypedExprFactEqual(texpr.TypedExprFactAt(retryFacts, 0), sentinel) ||
       !frozenRoundSourceTextsEqual(retrySources, factsFailureSourcesBefore) ||
       !frozenRoundExprLayersEqual(retryExprLayer, factsFailureExprBefore) ||
       !frozenAtomicIrSnapshotsEqual(frozenAtomicIrSnapshot(retryIr),
                                     factsFailureIrBefore) ||
       texpr.TypedExprSealedBuildIndexValidationCount(retryIr) !=
           factsFailureValidationBefore ||
       texpr.TypedExprSealedBuildIndexMetadataRowsVisited(retryIr) !=
           factsFailureRowsBefore ||
       texpr.TypedExprBuildIndexValidationEpoch(retryIndex) != retryEpochAtSeal ||
       texpr.TypedExprBuildIndexReuseCount(retryIndex) != retryReuseAtSeal:
        return 5
    parser.NormalizedExprLayerReset(factsFailureExprBefore)

    retrySources[1] = share(retrySourceC)
    if !texpr.TypedExprBuildFactsForExprLayerPreservingSealed(retrySources,
                                                              retryExprLayer,
                                                              retryIr,
                                                              retryFacts,
                                                              err) ||
       texpr.TypedExprFactTableCount(retryFacts) <= 0:
        return 6
    retrySources = [share(retrySourceB), share(retrySourceC)]
    retrySources[1].text = "fn FrozenC(): str = \"\"\"\nunterminated\n"
    var appendFailureSourcesBefore = [share(retrySources[0]),
                                      share(retrySources[1])]
    var appendFailureExprBefore = parser.NormalizedExprLayerClone(retryExprLayer)
    let appendFailureIrBefore = frozenAtomicIrSnapshot(retryIr)
    let appendFailureFactCount = texpr.TypedExprFactTableCount(retryFacts)
    let appendFailureHasFact = appendFailureFactCount > 0
    var appendFailureFirstFact: texpr.TypedExprFact
    if appendFailureHasFact:
        appendFailureFirstFact = texpr.TypedExprFactAt(retryFacts, 0)
    let appendFailureValidationBefore =
        texpr.TypedExprSealedBuildIndexValidationCount(retryIr)
    let appendFailureRowsBefore =
        texpr.TypedExprSealedBuildIndexMetadataRowsVisited(retryIr)
    var filterSourcePaths: str[]
    var filterFunctionNames: str[]
    var filterStartLines: int32[]
    if texpr.TypedExprAppendIrFunctionsWithFactsMetadataAndExprLayerSealed(
            retrySources,
            retryFacts,
            retryExprLayer,
            false,
            filterSourcePaths,
            filterFunctionNames,
            filterStartLines,
            retryIr,
            err) || !strutil.Contains(err, "unterminated multiline string"):
        return 7
    if texpr.TypedExprFactTableCount(retryFacts) != appendFailureFactCount ||
       (appendFailureHasFact &&
        !texpr.TypedExprFactEqual(texpr.TypedExprFactAt(retryFacts, 0),
                                  appendFailureFirstFact)) ||
       !frozenRoundSourceTextsEqual(retrySources, appendFailureSourcesBefore) ||
       !frozenRoundExprLayersEqual(retryExprLayer, appendFailureExprBefore) ||
       !frozenAtomicIrSnapshotsEqual(frozenAtomicIrSnapshot(retryIr),
                                     appendFailureIrBefore) ||
       texpr.TypedExprSealedBuildIndexValidationCount(retryIr) !=
           appendFailureValidationBefore ||
       texpr.TypedExprSealedBuildIndexMetadataRowsVisited(retryIr) !=
           appendFailureRowsBefore ||
       texpr.TypedExprBuildIndexValidationEpoch(retryIndex) != retryEpochAtSeal ||
       texpr.TypedExprBuildIndexReuseCount(retryIndex) != retryReuseAtSeal:
        return 8
    parser.NormalizedExprLayerReset(appendFailureExprBefore)
    retrySources[1] = share(retrySourceC)
    var lateFailureSourcesBefore = [share(retrySources[0]),
                                    share(retrySources[1])]
    var lateFailureFactsBefore = texpr.TypedExprFactTableClone(retryFacts)
    var lateFailureExprBefore = parser.NormalizedExprLayerClone(retryExprLayer)
    let lateFailureIrBefore = frozenAtomicIrSnapshot(retryIr)
    let lateFailureValidationBefore =
        texpr.TypedExprSealedBuildIndexValidationCount(retryIr)
    let lateFailureRowsBefore =
        texpr.TypedExprSealedBuildIndexMetadataRowsVisited(retryIr)
    let lateFailureRoundPeakBefore =
        texpr.TypedExprSealedBuildIndexRoundPeakBytes(retryIr)
    let lateFailureRoundContextsBefore =
        texpr.TypedExprSealedBuildIndexRoundContextCount(retryIr)
    let lateFailureDependenciesBefore =
        texpr.TypedExprSealedBuildIndexDependencyCount(retryIr)
    texpr.TypedExprTestArmFrozenLateFailureAfterScope(retryIr, 1)
    if texpr.TypedExprAppendIrFunctionsWithFactsMetadataAndExprLayerSealed(
            retrySources,
            retryFacts,
            retryExprLayer,
            false,
            filterSourcePaths,
            filterFunctionNames,
            filterStartLines,
            retryIr,
            err) ||
       !strutil.Contains(err,
                         "injected frozen metadata late failure after first scope"):
        return 9
    if !texpr.TypedExprTestFrozenLateFailureObserved(retryIr):
        return 10
    if !frozenRoundSourceTextsEqual(retrySources,
                                    lateFailureSourcesBefore):
        return 20
    if !texpr.TypedExprFactTablesEqual(retryFacts,
                                       lateFailureFactsBefore):
        return 21
    if !frozenRoundExprLayersEqual(retryExprLayer,
                                   lateFailureExprBefore):
        return 22
    if !frozenAtomicIrSnapshotsEqual(frozenAtomicIrSnapshot(retryIr),
                                     lateFailureIrBefore):
        return 23
    if texpr.TypedExprSealedBuildIndexValidationCount(retryIr) !=
       lateFailureValidationBefore:
        return 24
    if texpr.TypedExprSealedBuildIndexMetadataRowsVisited(retryIr) !=
       lateFailureRowsBefore:
        return 25
    if texpr.TypedExprSealedBuildIndexRoundPeakBytes(retryIr) !=
       lateFailureRoundPeakBefore:
        return 26
    if texpr.TypedExprSealedBuildIndexRoundContextCount(retryIr) !=
       lateFailureRoundContextsBefore:
        return 27
    if texpr.TypedExprSealedBuildIndexDependencyCount(retryIr) !=
       lateFailureDependenciesBefore:
        return 28
    if texpr.TypedExprBuildIndexValidationEpoch(retryIndex) != retryEpochAtSeal:
        return 29
    if texpr.TypedExprBuildIndexReuseCount(retryIndex) != retryReuseAtSeal:
        return 30
    texpr.TypedExprFactTableRelease(lateFailureFactsBefore)
    parser.NormalizedExprLayerReset(lateFailureExprBefore)
    if !texpr.TypedExprAppendIrFunctionsWithFactsMetadataAndExprLayerSealed(
            retrySources,
            retryFacts,
            retryExprLayer,
            false,
            filterSourcePaths,
            filterFunctionNames,
            filterStartLines,
            retryIr,
            err):
        return 11

    var cleanIr: texpr.TypedExprIr
    var cleanContexts: texpr.TypedExprSourceContext[]
    var cleanSourceA: texpr.TypedExprSourceText
    var cleanSourceB: texpr.TypedExprSourceText
    var cleanSourceC: texpr.TypedExprSourceText
    if !prepareFrozenSessionFixture(cleanIr,
                                    cleanContexts,
                                    cleanSourceA,
                                    cleanSourceB,
                                    cleanSourceC,
                                    err):
        return 12
    if !texpr.TypedExprSealBuildSourceContextIndex(cleanIr, cleanContexts, err):
        return 13
    let cleanIndex = texpr.TypedExprIrBuildIndex(cleanIr)
    let cleanEpochAtSeal = texpr.TypedExprBuildIndexValidationEpoch(cleanIndex)
    var cleanSources: texpr.TypedExprSourceText[]
    var cleanExprLayer: parser.NormalizedExprLayer
    if !prepareFrozenRoundExprLayer(cleanSourceB,
                                    cleanSourceC,
                                    cleanSources,
                                    cleanExprLayer,
                                    err):
        return 14
    var cleanFacts: texpr.TypedExprFactTable
    if !texpr.TypedExprBuildFactsForExprLayerPreservingSealed(cleanSources,
                                                              cleanExprLayer,
                                                              cleanIr,
                                                              cleanFacts,
                                                              err):
        return 15
    cleanSources = [cleanSourceB, cleanSourceC]
    if !texpr.TypedExprAppendIrFunctionsWithFactsMetadataAndExprLayerSealed(
            cleanSources,
            cleanFacts,
            cleanExprLayer,
            false,
            filterSourcePaths,
            filterFunctionNames,
            filterStartLines,
            cleanIr,
            err):
        return 16
    let expectedVisitedRows = Int64((rowsB + rowsC) * 2)
    if !texpr.TypedExprFactTablesEqual(retryFacts, cleanFacts) ||
       !frozenRoundSourceTextsEqual(retrySources, cleanSources) ||
       !frozenRoundExprLayersEqual(retryExprLayer, cleanExprLayer) ||
       !frozenAtomicIrSnapshotsEqual(frozenAtomicIrSnapshot(retryIr),
                                     frozenAtomicIrSnapshot(cleanIr)) ||
       texpr.TypedExprSealedBuildIndexValidationCount(retryIr) != 2 ||
       texpr.TypedExprSealedBuildIndexValidationCount(cleanIr) != 2 ||
       texpr.TypedExprSealedBuildIndexMetadataRowsVisited(retryIr) !=
           expectedVisitedRows ||
       texpr.TypedExprSealedBuildIndexMetadataRowsVisited(cleanIr) !=
           expectedVisitedRows ||
       texpr.TypedExprBuildIndexValidationEpoch(retryIndex) != retryEpochAtSeal ||
       texpr.TypedExprBuildIndexValidationEpoch(cleanIndex) != cleanEpochAtSeal:
        return 17
    if !texpr.TypedExprCloseSealedBuildSourceContextIndex(retryIr, err) ||
       !texpr.TypedExprCloseSealedBuildSourceContextIndex(cleanIr, err):
        return 18
    if texpr.TypedExprBuildIndexValidationEpoch(retryIndex) != retryEpochAtSeal + 3 ||
       texpr.TypedExprBuildIndexValidationEpoch(cleanIndex) != cleanEpochAtSeal + 3 ||
       texpr.TypedExprSealedBuildIndexValidationEpoch(retryIr) != retryEpochAtSeal + 3 ||
       texpr.TypedExprSealedBuildIndexValidationEpoch(cleanIr) != cleanEpochAtSeal + 3 ||
       texpr.TypedExprSealedBuildIndexFullValidationCount(retryIr) != 2 ||
       texpr.TypedExprSealedBuildIndexFullValidationCount(cleanIr) != 2 ||
       texpr.TypedExprSealedBuildIndexMetadataRowsVisited(retryIr) !=
           expectedVisitedRows ||
       texpr.TypedExprSealedBuildIndexMetadataRowsVisited(cleanIr) !=
           expectedVisitedRows ||
       texpr.TypedExprSealedBuildIndexMetadataLiveBytes(retryIr) != 0 ||
       texpr.TypedExprSealedBuildIndexMetadataLiveBytes(cleanIr) != 0 ||
       texpr.TypedExprSealedBuildIndexFullContextCount(retryIr) != 0 ||
       texpr.TypedExprSealedBuildIndexFullContextCount(cleanIr) != 0 ||
       texpr.TypedExprSealedBuildIndexJoinedLookupKeyBytes(retryIr) != 0 ||
       texpr.TypedExprSealedBuildIndexJoinedLookupKeyBytes(cleanIr) != 0:
        return 19
    texpr.TypedExprFactTableRelease(retryFacts)
    texpr.TypedExprFactTableRelease(cleanFacts)
    parser.NormalizedExprLayerReset(retryExprLayer)
    parser.NormalizedExprLayerReset(cleanExprLayer)
    texpr.TypedExprIrReleasePayload(retryIr)
    texpr.TypedExprIrReleasePayload(cleanIr)
    return 0

fn runOrdinaryAppendFullValidationContract(): int32 =
    var ir: texpr.TypedExprIr
    var contexts: texpr.TypedExprSourceContext[]
    var sourceA: texpr.TypedExprSourceText
    var sourceB: texpr.TypedExprSourceText
    var sourceC: texpr.TypedExprSourceText
    var err: str
    if !prepareFrozenSessionFixture(ir,
                                    contexts,
                                    sourceA,
                                    sourceB,
                                    sourceC,
                                    err):
        return 1
    let index = texpr.TypedExprIrBuildIndex(ir)
    let reuseBefore = texpr.TypedExprBuildIndexReuseCount(index)
    let epochBefore = texpr.TypedExprBuildIndexValidationEpoch(index)
    var sourceTexts: texpr.TypedExprSourceText[]
    var facts: texpr.TypedExprFactTable
    var exprLayer: parser.NormalizedExprLayer
    var filterSourcePaths: str[]
    var filterFunctionNames: str[]
    var filterStartLines: int32[]
    if !texpr.TypedExprAppendIrFunctionsWithFactsMetadataAndExprLayer(
            sourceTexts,
            facts,
            exprLayer,
            contexts,
            false,
            filterSourcePaths,
            filterFunctionNames,
            filterStartLines,
            ir,
            err):
        return 2
    if texpr.TypedExprBuildIndexReuseCount(index) != reuseBefore + 1 ||
       texpr.TypedExprBuildIndexValidationEpoch(index) != epochBefore + contexts.len:
        return 3
    texpr.TypedExprIrReleasePayload(ir)
    for contextIndex in 0..<contexts.len:
        texpr.TypedExprClearSourceContextAllFields(contexts[contextIndex])
    return 0

fn prepareActiveFrozenSession(ir: var texpr.TypedExprIr) =
    var contexts: texpr.TypedExprSourceContext[]
    var sourceA: texpr.TypedExprSourceText
    var sourceB: texpr.TypedExprSourceText
    var sourceC: texpr.TypedExprSourceText
    var err: str
    if !prepareFrozenSessionFixture(ir,
                                    contexts,
                                    sourceA,
                                    sourceB,
                                    sourceC,
                                    err):
        panic(Fmt"typed expr smoke: frozen fixture setup failed error={err}")
    if !texpr.TypedExprSealBuildSourceContextIndex(ir, contexts, err):
        panic(Fmt"typed expr smoke: frozen fixture seal failed error={err}")

fn invokeEmptyFrozenAppend(ir: var texpr.TypedExprIr) =
    var sourceTexts: texpr.TypedExprSourceText[]
    var facts: texpr.TypedExprFactTable
    var exprLayer: parser.NormalizedExprLayer
    var filterSourcePaths: str[]
    var filterFunctionNames: str[]
    var filterStartLines: int32[]
    var err: str
    let _ok = texpr.TypedExprAppendIrFunctionsWithFactsMetadataAndExprLayerSealed(
        sourceTexts,
        facts,
        exprLayer,
        false,
        filterSourcePaths,
        filterFunctionNames,
        filterStartLines,
        ir,
        err)

fn runFrozenSessionGenerationNegative() =
    var ir: texpr.TypedExprIr
    prepareActiveFrozenSession(ir)
    ir.buildIndexGeneration = ir.buildIndexGeneration + 1
    invokeEmptyFrozenAppend(ir)

fn runFrozenSessionCloseNegative() =
    var ir: texpr.TypedExprIr
    prepareActiveFrozenSession(ir)
    var err: str
    if !texpr.TypedExprCloseSealedBuildSourceContextIndex(ir, err):
        panic(Fmt"typed expr smoke: frozen close setup failed error={err}")
    invokeEmptyFrozenAppend(ir)

fn runFrozenSessionReleaseNegative() =
    var ir: texpr.TypedExprIr
    prepareActiveFrozenSession(ir)
    texpr.TypedExprIrReleasePayload(ir)
    invokeEmptyFrozenAppend(ir)

