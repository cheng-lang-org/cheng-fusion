                                      "/work/pkg",
                                      "pkg://current",
                                      "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
                                      "/work/pkg/vendor/ext/conflict.cheng",
                                      "fn conflict(): int32 = 0\n",
