fn runFrozenSessionTextOverlapNegative() =
    var ir: texpr.TypedExprIr
    prepareActiveFrozenSession(ir)
    texpr.TypedExprTestInjectDerivedCanonicalTextOverlap(ir)
    let overlapBytes =
        texpr.TypedExprSealedBuildIndexDerivedIrCanonicalTextOverlapBytes(ir)
    let duplicatedBytes =
        texpr.TypedExprSealedBuildIndexDuplicatedSemanticTextBytes(ir)
    if overlapBytes <= 0 || duplicatedBytes != overlapBytes:
        panic("typed expr smoke: derived canonical text overlap audit missed injected copy")
    var err: str
    let _closed = texpr.TypedExprCloseSealedBuildSourceContextIndex(ir, err)

