fn expectedHardFail(mode: str, expectedText: str): bool =
    let selfPath = cmdline.paramStr(0)
    if selfPath == "":
        return false
    # Keep the captured payload and status in direct out parameters. This test
    # invokes many children in sequence; routing them through the aggregate
    # ExecCmdResult value would make its ownership lifetime part of the contract
    # being tested instead of the typed-expression hard-fail diagnostics.
    var output: str
    var exitCode: int32
    hostos.ExecFileCaptureFill(selfPath,
                               [mode],
                               [],
                               "",
                               true,
                               60,
                               output,
                               exitCode)
    return exitCode != 0 && strutil.Contains(output, expectedText)

fn runDefaultHardFailCases(): int32 =
    if !expectedHardFail("call-decl-ambiguity",
                         "ambiguous call declaration"):
        return 1
    if !expectedHardFail("call-decl-unknown-arg",
                         "static argument type unavailable"):
        return 2
    if !expectedHardFail("explicit-generic-count",
                         "explicit generic binding mismatch"):
        return 18
    if !expectedHardFail("explicit-generic-param",
                         "explicit generic binding mismatch"):
        return 19
    if !expectedHardFail("explicit-generic-nongeneric",
                         "explicit generic binding mismatch"):
        return 20
    if !expectedHardFail("call-decl-freshness",
                         "call declaration metadata changed"):
        return 3
    if !expectedHardFail("importc-freshness",
                         "call declaration metadata changed"):
        return 4
    if !expectedHardFail("borrowed-owner-corrupt",
                         "build-once context owner changed"):
        return 5
    if !expectedHardFail("borrowed-as-owner",
                         "borrow source is not a live owner"):
        return 7
    if !expectedHardFail("frozen-generation",
                         "frozen metadata session generation mismatch"):
        return 8
    if !expectedHardFail("frozen-close",
                         "frozen metadata session closed"):
        return 9
    if !expectedHardFail("frozen-release",
                         "frozen metadata session missing"):
        return 10
    if !expectedHardFail("frozen-clone",
                         "active frozen metadata IR clone forbidden"):
        return 12
    if !expectedHardFail("frozen-shallow-release",
                         "session owner is shared by value assignment"):
        return 13
    if !expectedHardFail("frozen-shallow-move",
                         "source session owner is shared by value assignment"):
        return 14
    if !expectedHardFail("frozen-metadata-drift",
                         "sealed build index mutation forbidden"):
        return 15
    if !expectedHardFail("frozen-field-drift",
                         "frozen metadata session cardinality drift"):
        return 16
    if !expectedHardFail("frozen-text-overlap",
                         "frozen metadata session cardinality drift"):
        return 17
    if !expectedHardFail("value-call-parser-origin-drift",
                         "value-call parser origin authority drift"):
        return 21
    return 0

fn main(): int32 =
    let childMode = cmdline.paramStr(1)
    if childMode == "value-call-parser-origin-drift":
        runValueCallParserOriginDriftNegative()
        return 85
    if childMode == "call-decl-ambiguity":
        runCallDeclarationAmbiguityNegative()
        return 87
    if childMode == "call-decl-unknown-arg":
        runCallDeclarationUnknownArgTypeNegative()
