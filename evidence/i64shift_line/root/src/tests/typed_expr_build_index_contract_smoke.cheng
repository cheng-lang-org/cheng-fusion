    if texpr.TypedExprResolveCallDeclaration(contexts[callerIndex],
                                             "ffi",
                                             "CrossKind",
                                             intArgs,
                                             texpr.TypedExprCallDeclarationImportcOnly,
                                             sourcePath,
                                             returnType,
                                             targetSymbol,
                                             importc,
                                             rowIndex) != texpr.TypedExprBuildIndexUnique ||
       sourcePath != importcPath || returnType != "uint64" ||
       targetSymbol != "c_cross" || !importc:
        return 17
    if texpr.TypedExprResolveCallDeclaration(contexts[callerIndex],
                                             "",
                                             "HiddenC",
                                             intArgs,
                                             texpr.TypedExprCallDeclarationImportcOnly,
                                             sourcePath,
