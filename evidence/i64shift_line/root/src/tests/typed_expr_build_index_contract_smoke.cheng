    stmt.assignLvalueNodeIndex = -1
    stmt.assignIndexNodeIndex = -1
    texpr.TypedExprIrAppendStatement(ir, stmt)
    var node: texpr.TypedExprIrNode
    node.resultStructuralTypeId = -1
    node.sourcePath = fnSourcePath
    node.functionName = fnName
    node.nodeIndex = 0
    node.lineNumber = 8
    node.opKind = texpr.TypedExprIrOpI32Const
    node.resultType = "int32"
    node.surfaceText = "0"
    node.paramSlot = -1
    node.operand0NodeIndex = -1
    node.operand1NodeIndex = -1
    node.operand2NodeIndex = -1
    node.literalText = "0"
    texpr.TypedExprIrAppendNode(ir, node)
    let sourceLogicalBytes = texpr.TypedExprIrArenaLogicalLiveBytes(ir)
    let _unreachableTail = arenamod.ArenaAllocBytes(ir.arena, 2097152)
    let sourceRetainedBytes = texpr.TypedExprIrArenaOwnerRetainedBytes(ir)
    var cloned = texpr.TypedExprIrClone(ir)
    if cloned.internPool == ir.internPool ||
       cloned.arena.basePtr == ir.arena.basePtr:
        return 1
    let cloneLogicalBytes = texpr.TypedExprIrArenaLogicalLiveBytes(cloned)
    let cloneRetainedBytes = texpr.TypedExprIrArenaOwnerRetainedBytes(cloned)
    if sourceLogicalBytes <= 0 ||
       cloneLogicalBytes != sourceLogicalBytes ||
       cloneRetainedBytes != cloneLogicalBytes ||
       cloneRetainedBytes >= sourceRetainedBytes ||
       Int64(cloned.arena.usedBytes) != cloneLogicalBytes:
        return 2
    if arenamod.ArenaArrayInt32Get(ir.arena,
                                    ir.functions2_signatureLineNumbers,
                                    0) != 7 ||
       arenamod.ArenaArrayInt32Get(cloned.arena,
                                    cloned.functions2_signatureLineNumbers,
                                    0) != 7 ||
       arenamod.ArenaArrayInt32Get(cloned.arena,
                                    cloned.statements2_lineNumbers,
                                    0) != 8 ||
       arenamod.ArenaArrayInt32Get(cloned.arena,
                                    cloned.nodes2_nodeIndexs,
                                    0) != 0:
        return 3
    arenamod.ArenaArrayInt32Set(cloned.arena,
                                cloned.functions2_signatureLineNumbers,
                                0,
                                19)
    if arenamod.ArenaArrayInt32Get(ir.arena,
                                    ir.functions2_signatureLineNumbers,
                                    0) != 7 ||
       arenamod.ArenaArrayInt32Get(cloned.arena,
                                    cloned.functions2_signatureLineNumbers,
                                    0) != 19:
        return 4
    let _cloneOnly = langintern.Intern(cloned.internPool, "clone-only")
    if langintern.HasIntern(ir.internPool, "clone-only") ||
       !langintern.HasIntern(cloned.internPool, "clone-only"):
        return 5
    texpr.TypedExprIrReleasePayload(ir)
    if arenamod.ArenaArrayInt32Get(cloned.arena,
                                    cloned.functions2_signatureLineNumbers,
                                    0) != 19 ||
       !langintern.HasIntern(cloned.internPool, "clone-only"):
        return 6
    texpr.TypedExprIrReleasePayload(cloned)
    if cloned.arena.basePtr != nil || cloned.internPool != nil:
        return 7
    return 0

fn seedOrdinarySequenceCloneColumns(ir: var texpr.TypedExprIr,
                                    label: str) =
    ir.internPool = langintern.InternPoolNew()
    let sourceId = langintern.Intern(ir.internPool, Fmt"{label}-source")
    add(ir.functions2_sourcePathIds, sourceId)
    add(ir.statements2_kinds, texpr.TypedExprIrStmtReturn)
    add(ir.nodes2_opKinds, texpr.TypedExprIrOpI32Const)
    add(ir.globalNames, Fmt"{label}-global")

fn mutateOrdinarySequenceCloneColumns(ir: var texpr.TypedExprIr,
                                      label: str) =
    ir.statements2_kinds[0] = texpr.TypedExprIrStmtAssign
    ir.nodes2_opKinds[0] = texpr.TypedExprIrOpBoolLit
    ir.functions2_sourcePathIds[0] = langintern.Intern(ir.internPool,
                                                       Fmt"{label}-mutated-source")
    ir.globalNames[0] = Fmt"{label}-mutated-global"

fn ordinarySequenceCloneSourceUnchanged(ir: var texpr.TypedExprIr,
                                        label: str): bool =
    return ir.statements2_kinds[0] == texpr.TypedExprIrStmtReturn &&
           ir.nodes2_opKinds[0] == texpr.TypedExprIrOpI32Const &&
           ir.functions2_sourcePathIds[0] == langintern.Intern(ir.internPool,
                                                               Fmt"{label}-source") &&
           ir.globalNames[0] == Fmt"{label}-global" &&
           !langintern.HasIntern(ir.internPool, Fmt"{label}-mutated-source")

fn runOrdinarySequenceCloneAssignOwnership(): int32 =
    var source: texpr.TypedExprIr
    seedOrdinarySequenceCloneColumns(source, "clone")
    var cloned = texpr.TypedExprIrClone(source)
    mutateOrdinarySequenceCloneColumns(cloned, "clone")
    if !ordinarySequenceCloneSourceUnchanged(source, "clone") ||
       cloned.statements2_kinds[0] != texpr.TypedExprIrStmtAssign ||
       cloned.nodes2_opKinds[0] != texpr.TypedExprIrOpBoolLit ||
       cloned.globalNames[0] != "clone-mutated-global":
        return 1
    texpr.TypedExprIrReleasePayload(source)
    if cloned.statements2_kinds[0] != texpr.TypedExprIrStmtAssign ||
       cloned.nodes2_opKinds[0] != texpr.TypedExprIrOpBoolLit ||
       cloned.globalNames[0] != "clone-mutated-global" ||
       !langintern.HasIntern(cloned.internPool, "clone-mutated-source"):
        return 2
    texpr.TypedExprIrReleasePayload(cloned)

    var assignSource: texpr.TypedExprIr
    seedOrdinarySequenceCloneColumns(assignSource, "assign")
    var assigned: texpr.TypedExprIr
    seedOrdinarySequenceCloneColumns(assigned, "replaced")
    texpr.TypedExprIrAssignInto(assigned, assignSource)
    mutateOrdinarySequenceCloneColumns(assigned, "assign")
    if !ordinarySequenceCloneSourceUnchanged(assignSource, "assign") ||
       assigned.statements2_kinds[0] != texpr.TypedExprIrStmtAssign ||
       assigned.nodes2_opKinds[0] != texpr.TypedExprIrOpBoolLit ||
       assigned.globalNames[0] != "assign-mutated-global":
        return 3
    texpr.TypedExprIrReleasePayload(assignSource)
    if assigned.statements2_kinds[0] != texpr.TypedExprIrStmtAssign ||
       assigned.nodes2_opKinds[0] != texpr.TypedExprIrOpBoolLit ||
       assigned.globalNames[0] != "assign-mutated-global" ||
       !langintern.HasIntern(assigned.internPool, "assign-mutated-source"):
        return 4
    texpr.TypedExprIrReleasePayload(assigned)
    return 0

fn runRetainedCapacityAccounting(): int32 =
    var index = texpr.TypedExprBuildIndexNew(8)
    let before = texpr.TypedExprBuildIndexMeasureLiveBytes(index)
    let beforeOracle = retainedCapacityOracle(index)
    if before.totalBytes != beforeOracle.totalBytes ||
       before.entryBytes != beforeOracle.entryBytes:
        return 1
    let logicalBefore = texpr.TypedExprBuildIndexLogicalLiveBytes(index)
    let capBefore = index.entryNext.cap
    seqs.Reserve(index.entryNext, capBefore + 257)
    let capAfter = index.entryNext.cap
    if capAfter <= capBefore || index.entryNext.len != 0:
        return 2
    let after = texpr.TypedExprBuildIndexMeasureLiveBytes(index)
    let afterOracle = retainedCapacityOracle(index)
    let expectedDelta = Int64(capAfter - capBefore) * 4
    if after.entryBytes != afterOracle.entryBytes ||
       after.totalBytes != afterOracle.totalBytes ||
       afterOracle.entryBytes - beforeOracle.entryBytes != expectedDelta ||
       afterOracle.totalBytes - beforeOracle.totalBytes != expectedDelta:
        return 3
    if texpr.TypedExprBuildIndexLogicalLiveBytes(index) != logicalBefore:
        return 4
    let cloned = texpr.TypedExprBuildIndexClone(index)
    if cloned == nil || cloned.entryNext.len != 0 ||
       cloned.entryNext.cap >= index.entryNext.cap:
        return 5
    texpr.TypedExprBuildIndexRelease(cloned)
    if !releasedLiveReportZero(cloned):
        return 6
    texpr.TypedExprBuildIndexRelease(index)
    if !releasedLiveReportZero(index):
        return 7
    return 0

fn prepareContentCacheLifecycle(ir: var texpr.TypedExprIr,
                                ctx: var texpr.TypedExprSourceContext): bool =
    var externalRoots: parser.ParserExternalPackageRoot[]
    let sourcePath = "/work/pkg/content_cache_lifecycle.cheng"
    let source = sourceNew("/work",
                           "/work/pkg",
                           "pkg://current",
                           "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
                           sourcePath,
                           "const\n    Marker = 9\ntype\n    PersistentLayout =\n        value: int64\nfn Cached(): int32 =\n    return 0\n",
                           externalRoots)
    var err: str
    var builtCtx: texpr.TypedExprSourceContext
    if !texpr.TypedExprBuildSourceContext(source, builtCtx, err):
        return false
    var contexts: texpr.TypedExprSourceContext[]
    texpr.TypedExprSourceContextAppendMove(contexts, builtCtx)
    texpr.TypedExprBuildSourceContextIndex(ir, contexts)
    ctx = texpr.TypedExprSourceContextBorrowedView(contexts[0])
    if texpr.TypedExprModuleConstLiteralForContext(ctx, "Marker") != "9" ||
       texpr.TypedExprScanSourceFunctionReturnType(ctx, "Cached") != "int32":
        return false
    texpr.TypedExprIrAppendTypeLayoutsFromContext(
        ir, share(contexts[0]), contexts)
    return true

fn runClearStatementsIndexLifecycle(): int32 =
    var ir: texpr.TypedExprIr
    var ctx: texpr.TypedExprSourceContext
    if !prepareContentCacheLifecycle(ir, ctx):
        return 1
    let index = texpr.TypedExprIrBuildIndex(ir)
    let before = texpr.TypedExprBuildIndexMeasureLiveBytes(index)
    if before.contentCacheBytes <= 0 || index.contentCacheReleased:
        return 2
    texpr.TypedExprIrClearSoAStatementsData(ir)
    let after = texpr.TypedExprBuildIndexMeasureLiveBytes(index)
    if !index.contentCacheReleased || after.contentCacheBytes != 0 ||
       after.totalBytes >= before.totalBytes:
        return 3
    if texpr.TypedExprModuleConstLiteralForContext(ctx, "Marker") != "9":
        return 4
    var layoutSize: int32
    var layoutAlign: int32
    var layoutFields: int32
    if !texpr.TypedExprIrLookupTypeLayout(ir,
                                          ctx.sourcePath,
                                          "PersistentLayout",
                                          layoutSize,
                                          layoutAlign,
                                          layoutFields) ||
       layoutSize != 8 || layoutAlign != 8 || layoutFields != 1:
        return 5
    if !texpr.TypedExprIrLookupTypeLayout(ir,
                                          ctx.sourcePath,
                                          "PersistentLayout",
                                          layoutSize,
                                          layoutAlign,
                                          layoutFields) ||
       layoutSize != 8 || layoutAlign != 8 || layoutFields != 1:
        return 6
    var contextIndex: int32
    if texpr.TypedExprBuildIndexLookup(index,
                                       "ctx_source",
                                       parser.ParserNormalizePath(ctx.sourcePath),
                                       "",
                                       "",
                                       contextIndex) != texpr.TypedExprBuildIndexUnique ||
       contextIndex != 0:
        return 7
    texpr.TypedExprIrReleasePayload(ir)
    if !releasedLiveReportZero(index):
        return 8
    return 0

fn runCallDeclarationVisibilityAndOverload(): int32 =
    let overloadPath = "/work/pkg/call_decl_overload.cheng"
    let importcPath = "/work/pkg/call_decl_importc.cheng"
    var contexts: texpr.TypedExprSourceContext[]
