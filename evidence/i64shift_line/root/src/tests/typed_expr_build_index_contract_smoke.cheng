    if os.GetEnv("CHENG_TYPED_EXPR_CALL_DECL_AMBIGUITY_NEGATIVE") == "1":
        runCallDeclarationAmbiguityNegative()
        return 92
    if os.GetEnv("CHENG_TYPED_EXPR_CALL_DECL_MISSING_INDEX_NEGATIVE") == "1":
