fn runOwnerScopedVisibilityCache(): int32 =
    let ownerCount: int32 = 40
    let ambiguousOwnerPath = "/work/pkg/cache_ambiguous_owner.cheng"
    var contexts: texpr.TypedExprSourceContext[]
    for i in 0..<ownerCount:
        let ownerPath = Fmt"/work/pkg/cache_owner_{i}.cheng"
        let targetPath = Fmt"/work/pkg/cache_common_{i}.cheng"
        var owner = contextNew(ownerPath)
        contextImport(owner, "common", targetPath)
        add(contexts, owner)
    var ambiguousOwner = contextNew(ambiguousOwnerPath)
    contextImport(ambiguousOwner,
                  "left",
                  "/work/pkg/cache_common_17.cheng")
    contextImport(ambiguousOwner,
                  "left_alias",
                  "/work/pkg/cache_common_17.cheng")
    contextImport(ambiguousOwner,
                  "right",
                  "/work/pkg/cache_common_18.cheng")
    add(contexts, ambiguousOwner)
    for i in 0..<ownerCount:
        var moduleCtx = contextNew(Fmt"/work/pkg/cache_common_{i}.cheng")
        contextDeclared(moduleCtx, "Common")
        add(contexts, moduleCtx)

    var ir: texpr.TypedExprIr
    texpr.TypedExprBuildSourceContextIndex(ir, contexts)
    let index = texpr.TypedExprIrBuildIndex(ir)
    if texpr.TypedExprBuildIndexMetadataDeclarationCount(index) != ownerCount * 2 ||
       texpr.TypedExprBuildIndexVisibilityEdgeCount(index) != ownerCount + 2 ||
       index.importOwnerSourcePaths.len != ownerCount + 1 ||
       index.importTargetNext.len != ownerCount + 2:
        return 1
    let registerCount = texpr.TypedExprBuildIndexRegisterCount(index)
    let registerProbes = texpr.TypedExprBuildIndexRegisterProbeCount(index)
    if registerCount <= 0 || registerProbes >= registerCount * 4:
        return 2

    let retainedBefore = texpr.TypedExprBuildIndexMeasureLiveBytes(index)
    let scansBefore = texpr.TypedExprBuildIndexQueryMetadataScanCount(index)
    let probesBefore = texpr.TypedExprBuildIndexQueryProbeCount(index)
    var valueIndex: int32
    for i in 0..<ownerCount:
        if texpr.TypedExprBuildIndexLookup(index,
                                           "ctx_import_declared",
                                           Fmt"/work/pkg/cache_owner_{i}.cheng",
                                           "Common",
                                           "",
                                           valueIndex) != texpr.TypedExprBuildIndexUnique ||
           valueIndex != ownerCount + 1 + i:
            return 3
    let scansAfterOwners = texpr.TypedExprBuildIndexQueryMetadataScanCount(index)
    let probesAfterOwners = texpr.TypedExprBuildIndexQueryProbeCount(index)
    if scansAfterOwners - scansBefore != ownerCount ||
       probesAfterOwners - probesBefore >= ownerCount * 8 ||
       index.visibilityQueryKinds.len != ownerCount:
        return 4

    for queryRound in 0..<3:
        for i in 0..<ownerCount:
            if texpr.TypedExprBuildIndexLookup(index,
                                               "ctx_import_declared",
                                               Fmt"/work/pkg/cache_owner_{i}.cheng",
                                               "Common",
                                               "",
                                               valueIndex) != texpr.TypedExprBuildIndexUnique ||
               valueIndex != ownerCount + 1 + i:
                return 5
    var fingerprint: str
    if texpr.TypedExprBuildIndexLookupFingerprint(index,
                                                  "ctx_import_declared",
                                                  "/work/pkg/cache_owner_0.cheng",
                                                  "Common",
                                                  "",
                                                  fingerprint) != texpr.TypedExprBuildIndexUnique ||
       fingerprint != "Common" ||
       texpr.TypedExprBuildIndexQueryMetadataScanCount(index) != scansAfterOwners ||
       index.visibilityQueryKinds.len != ownerCount:
        return 6

    let scansBeforeMissing = texpr.TypedExprBuildIndexQueryMetadataScanCount(index)
    if texpr.TypedExprBuildIndexLookup(index,
                                       "ctx_import_declared",
                                       "/work/pkg/cache_owner_0.cheng",
                                       "AbsentCommon",
                                       "",
                                       valueIndex) != texpr.TypedExprBuildIndexMissing ||
       texpr.TypedExprBuildIndexQueryMetadataScanCount(index) - scansBeforeMissing != 1 ||
       index.visibilityQueryKinds.len != ownerCount + 1 ||
       index.visibilityQueryStates[ownerCount] != texpr.TypedExprBuildIndexMissing ||
       index.visibilityQueryValueIndexes[ownerCount] != -1:
        return 7
    let scansAfterMissing = texpr.TypedExprBuildIndexQueryMetadataScanCount(index)
    if texpr.TypedExprBuildIndexLookup(index,
                                       "ctx_import_declared",
                                       "/work/pkg/cache_owner_0.cheng",
                                       "AbsentCommon",
                                       "",
                                       valueIndex) != texpr.TypedExprBuildIndexMissing ||
       texpr.TypedExprBuildIndexQueryMetadataScanCount(index) != scansAfterMissing:
        return 8
    fingerprint = "must-clear"
    if texpr.TypedExprBuildIndexLookupFingerprint(
           index,
           "ctx_import_declared",
           "/work/pkg/cache_owner_0.cheng",
           "AbsentCommon",
           "",
           fingerprint) != texpr.TypedExprBuildIndexMissing ||
       fingerprint != "" ||
       texpr.TypedExprBuildIndexQueryMetadataScanCount(index) !=
           scansAfterMissing:
        return 15

    let scansBeforeAmbiguous = texpr.TypedExprBuildIndexQueryMetadataScanCount(index)
    if texpr.TypedExprBuildIndexLookup(index,
                                       "ctx_import_declared",
                                       ambiguousOwnerPath,
                                       "Common",
                                       "",
                                       valueIndex) != texpr.TypedExprBuildIndexAmbiguous ||
       texpr.TypedExprBuildIndexQueryMetadataScanCount(index) - scansBeforeAmbiguous != 2 ||
       index.visibilityQueryKinds.len != ownerCount + 2 ||
       index.visibilityQueryStates[ownerCount + 1] != texpr.TypedExprBuildIndexAmbiguous ||
       index.visibilityQueryValueIndexes[ownerCount + 1] != -1:
        return 9
    let scansAfterAmbiguous = texpr.TypedExprBuildIndexQueryMetadataScanCount(index)
    if texpr.TypedExprBuildIndexLookup(index,
                                       "ctx_import_declared",
                                       ambiguousOwnerPath,
                                       "Common",
                                       "",
                                       valueIndex) != texpr.TypedExprBuildIndexAmbiguous ||
       texpr.TypedExprBuildIndexQueryMetadataScanCount(index) != scansAfterAmbiguous:
        return 10

    let retainedAfter = texpr.TypedExprBuildIndexMeasureLiveBytes(index)
    if retainedAfter.cacheBytes <= retainedBefore.cacheBytes ||
       retainedAfter.totalBytes <= retainedBefore.totalBytes:
        return 11
    var clonedIr = texpr.TypedExprIrClone(ir)
    let clonedIndex = texpr.TypedExprIrBuildIndex(clonedIr)
    let clonedScansBefore = texpr.TypedExprBuildIndexQueryMetadataScanCount(clonedIndex)
    if clonedIndex == nil || clonedIndex == index ||
       clonedIndex.importOwnerSourcePaths.len != ownerCount + 1 ||
       clonedIndex.importTargetNext.len != ownerCount + 2 ||
       clonedIndex.visibilityQueryKinds.len != ownerCount + 2 ||
       texpr.TypedExprBuildIndexLookup(clonedIndex,
                                       "ctx_import_declared",
                                       "/work/pkg/cache_owner_39.cheng",
                                       "Common",
                                       "",
                                       valueIndex) != texpr.TypedExprBuildIndexUnique ||
       valueIndex != ownerCount + 1 + 39 ||
       texpr.TypedExprBuildIndexQueryMetadataScanCount(clonedIndex) != clonedScansBefore:
        return 12
    texpr.TypedExprIrReleasePayload(ir)
    if !releasedLiveReportZero(index) ||
       clonedIndex.importOwnerSourcePaths.len != ownerCount + 1:
        return 13
    texpr.TypedExprIrReleasePayload(clonedIr)
    if !releasedLiveReportZero(clonedIndex):
        return 14
    return 0

