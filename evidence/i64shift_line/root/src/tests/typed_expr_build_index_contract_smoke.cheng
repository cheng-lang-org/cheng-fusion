        runFrozenSessionFieldDriftNegative()
        return 72
    if childMode == "frozen-text-overlap":
        runFrozenSessionTextOverlapNegative()
        return 71
    if childMode == "frozen-owner-identity-contract":
        return runFrozenMetadataSessionContract()
    if os.GetEnv("CHENG_TYPED_EXPR_METADATA_DUPLICATE_DRIFT_NEGATIVE") == "1":
        runMetadataDuplicateDriftNegative()
