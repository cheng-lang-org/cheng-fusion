fn runLocalBindingIndexBackendLifetime(): int32 =
    var ir: texpr.TypedExprIr
    ir.internPool = langintern.InternPoolNew()
    texpr.TypedExprIrAppendLocalBinding(
        ir, "/work/pkg/local_binding_lifetime.cheng", "Run", 2, "value", "int32")
    texpr.TypedExprIrAppendLocalBinding(
        ir, "/work/pkg/local_binding_lifetime.cheng", "Run", 5, "value", "int32")
    texpr.TypedExprIrAppendLocalBinding(
        ir, "/work/pkg/local_binding_lifetime.cheng", "Run", 3, "name", "str")
    if !texpr.TypedExprIrLocalBindingIndexComplete(ir) ||
       ir.localBindingNames.len != 3:
        return 1
    if texpr.TypedExprIrLookupLocalBindingType(ir,
                                               "/work/pkg/local_binding_lifetime.cheng",
                                               "Run",
                                               6,
                                               "value") != "int32" ||
       texpr.TypedExprIrLookupLocalBindingTypeAnyLine(ir,
                                                      "/work/pkg/local_binding_lifetime.cheng",
                                                      "Run",
                                                      "name") != "str":
        return 2
    texpr.TypedExprIrCompactForBackend(ir)
    if !ir.localBindingNameIndexSealed ||
       !texpr.TypedExprIrLocalBindingIndexComplete(ir):
        return 3
    texpr.TypedExprIrClearSoAStatementsData(ir)
    if !texpr.TypedExprIrLocalBindingIndexComplete(ir) ||
       texpr.TypedExprIrLookupLocalBindingType(ir,
                                               "/work/pkg/local_binding_lifetime.cheng",
                                               "Run",
                                               4,
                                               "value") != "int32" ||
       texpr.TypedExprIrLookupLocalBindingTypeAnyLine(ir,
                                                      "/work/pkg/local_binding_lifetime.cheng",
                                                      "Run",
                                                      "value") != "int32":
        return 4
    var cloned = texpr.TypedExprIrClone(ir)
    if !cloned.localBindingNameIndexSealed ||
       !texpr.TypedExprIrLocalBindingIndexComplete(cloned) ||
       texpr.TypedExprIrLookupLocalBindingTypeAnyLine(cloned,
                                                      "/work/pkg/local_binding_lifetime.cheng",
                                                      "Run",
                                                      "name") != "str":
        return 5
    texpr.TypedExprIrReleasePayload(ir)
    if texpr.TypedExprIrLookupLocalBindingTypeAnyLine(cloned,
                                                      "/work/pkg/local_binding_lifetime.cheng",
                                                      "Run",
                                                      "value") != "int32":
        return 6
    texpr.TypedExprIrReleasePayload(cloned)
    return 0

