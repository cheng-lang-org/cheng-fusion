    if texpr.TypedExprResolveCallDeclaration(contexts[callerIndex],
                                             "",
                                             "CrossKind",
                                             intArgs,
                                             texpr.TypedExprCallDeclarationFunctionOrImportc,
                                             sourcePath,
                                             returnType,
                                             targetSymbol,
                                             importc,
                                             rowIndex) != texpr.TypedExprBuildIndexUnique ||
       sourcePath != overloadPath || returnType != "str" || importc:
