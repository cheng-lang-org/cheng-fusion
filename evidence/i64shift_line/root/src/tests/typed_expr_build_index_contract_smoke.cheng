    if os.GetEnv("CHENG_TYPED_EXPR_RELEASED_QUERY_NEGATIVE") == "1":
        runReleasedQueryNegative()
        return 99
    if os.GetEnv("CHENG_TYPED_EXPR_LOCAL_BINDING_INDEX_NEGATIVE") == "1":
        runLocalBindingIndexCorruptionNegative()
