    fnIr.returnType = "int32"
    fnIr.returnExpr = "0"
    fnIr.statementStart = 0
    fnIr.statementCount = 1
    fnIr.scopeStart = 0
    fnIr.scopeCount = 1
    fnIr.nodeStart = 0
    fnIr.nodeCount = 1
    fnIr.returnNodeIndex = 0
    let fnSourcePath = share(fnIr.sourcePath)
    let fnName = share(fnIr.functionName)
    texpr.TypedExprIrAppendScope(ir,
                                   0,
                                   -1,
                                   parser.NormalizedScopeRoot,
                                   -1,
                                   0,
                                   7,
                                   1,
                                   9,
                                   1)
    texpr.TypedExprIrAppendFunction(ir, fnIr)
