    if childMode == "explicit-generic-param":
        runExplicitGenericBindingNegative("generic.Identity[uint8](1)")
        return 69
    if childMode == "explicit-generic-nongeneric":
        runExplicitGenericBindingNegative("generic.Plain[uint8](1)")
        return 68
    if childMode == "call-decl-freshness":
        runCallDeclarationDriftNegative()
