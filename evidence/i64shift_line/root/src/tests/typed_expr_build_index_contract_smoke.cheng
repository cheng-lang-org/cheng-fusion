@borrows
fn contextNew(sourcePath: str): texpr.TypedExprSourceContext =
    var ctx: texpr.TypedExprSourceContext
    ctx.sourcePath = share(sourcePath)
    ctx.normalizedSourcePath = share(sourcePath)
    # Synthetic contexts have no source text; declare the empty module-const
    # authority explicitly instead of relying on missing lines as absence.
    ctx.moduleConstScanned = true
    return ctx

@borrows
fn contextImport(ctx: var texpr.TypedExprSourceContext,
                 qualifier: str,
                 targetSourcePath: str) =
    var imported: texpr.TypedExprImportedModule
    imported.qualifier = share(qualifier)
    imported.targetSourcePath = share(targetSourcePath)
    # hand-built edges model plain imports: unqualified calls allowed
    imported.allowsUnqualifiedCall = true
    add(ctx.importedModules, imported)

@borrows
fn contextDeclared(ctx: var texpr.TypedExprSourceContext, name: str) =
    add(ctx.declaredTypes, share(name))

@borrows
fn contextRef(ctx: var texpr.TypedExprSourceContext, name: str) =
    add(ctx.refTypes, share(name))

@borrows
fn contextAlias(ctx: var texpr.TypedExprSourceContext,
                name: str,
                targetType: str) =
    add(ctx.typeDefAliasNames, share(name))
    add(ctx.typeDefAliasTargetTypes, share(targetType))

@borrows
fn contextEnum(ctx: var texpr.TypedExprSourceContext,
               name: str,
               typeName: str,
               ordinal: int32) =
    add(ctx.enumValueNames, share(name))
    add(ctx.enumValueTypes, share(typeName))
    add(ctx.enumValueOrdinals, ordinal)

@borrows
fn contextField(ctx: var texpr.TypedExprSourceContext,
                ownerType: str,
                fieldName: str,
                fieldType: str) =
    var field: texpr.TypedExprTypeFieldDecl
    field.ownerType = share(ownerType)
    field.fieldName = share(fieldName)
    field.fieldType = share(fieldType)
    add(ctx.typeFields, field)

@borrows
fn contextParsed(sourcePath: str, text: str): texpr.TypedExprSourceContext =
    var externalRoots: parser.ParserExternalPackageRoot[]
    let source = sourceNew("",
                           "",
                           "pkg://current",
                           "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
                           sourcePath,
                           text,
                           externalRoots)
    var ctx: texpr.TypedExprSourceContext
    var err: str
    if !texpr.TypedExprBuildSourceContext(source, ctx, err):
        panic(Fmt"typed expr smoke: source context parse failed source={sourcePath} error={err}")
    return ctx

fn frozenMetadataContext(source: var texpr.TypedExprSourceText):
        texpr.TypedExprSourceContext =
    var profile: parser.NormalizedExprCallProfile
    var err: str
    if !parser.ParserBuildExprCallProfileWithExternalPackageRoots(
           source.workspaceRoot,
           source.packageRoot,
           source.externalPackageRoots,
           source.sourcePath,
           source.text,
           profile,
           err):
        panic(Fmt"typed expr smoke: frozen profile failed source={source.sourcePath} error={err}")
    var ctx: texpr.TypedExprSourceContext
    if !texpr.TypedExprBuildMetadataContextFromProfile(
           profile, source, ctx, err):
        panic(Fmt"typed expr smoke: frozen metadata failed source={source.sourcePath} error={err}")
    return ctx

fn runBacktickOperatorGenericHeadContract(): int32 =
    var externalRoots: parser.ParserExternalPackageRoot[]
    let sourcePath = "/work/pkg/backtick_operator_generic_head.cheng"
    let source = sourceNew(
        "",
        "",
        "pkg://current",
        "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
        sourcePath,
        "fn `[]`(values: int32[], index: int32): int32 = 0\nfn Generic[T](value: T): T = value\n",
        externalRoots)
    var ctx: texpr.TypedExprSourceContext
    var err: str
    if !texpr.TypedExprBuildSourceContext(source, ctx, err):
        return 1
    var operatorCount: int32
    var explicitGenericCount: int32
    for scopeIndex in 0..<ctx.scopes.len:
        if ctx.scopes[scopeIndex].genericNameJoin == "":
            operatorCount = operatorCount + 1
        elif ctx.scopes[scopeIndex].genericNameJoin == "T":
            explicitGenericCount = explicitGenericCount + 1
    if ctx.scopes.len != 2 || operatorCount != 1 || explicitGenericCount != 1:
        return 2

    let malformedSource = sourceNew(
        "",
        "",
        "pkg://current",
        "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
        "/work/pkg/malformed_generic_head.cheng",
        "fn Broken[T]junk(value: T): T = value\n",
        externalRoots)
    var malformedCtx: texpr.TypedExprSourceContext
    if texpr.TypedExprBuildSourceContext(malformedSource, malformedCtx, err) ||
       !strutil.Contains(err, "malformed function generic declaration"):
        return 3
    let operatorGenericSource = sourceNew(
        "",
        "",
        "pkg://current",
        "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
        "/work/pkg/operator_explicit_generic_head.cheng",
        "fn `[]`[T](values: T[], index: int32): T = values[index]\n",
        externalRoots)
    var operatorGenericCtx: texpr.TypedExprSourceContext
    if texpr.TypedExprBuildSourceContext(operatorGenericSource,
                                         operatorGenericCtx,
                                         err) ||
       !strutil.Contains(err, "malformed function generic declaration"):
        return 4
    return 0

fn runFfiMapPhysicalLayoutContract(): int32 =
    var externalRoots: parser.ParserExternalPackageRoot[]
    let validSource = sourceNew(
        "",
        "",
        "pkg://current",
        "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
        "/work/pkg/ffi_map_valid.cheng",
        "@importc(\"slice_only\")\n@ffi_map(ptr = arg0, len = arg1)\nfn SliceOnly(values: int32[]): int32\n@importc(\"slice_with_prefix\")\n@ffi_map(ptr = arg1, len = arg2)\nfn SliceWithPrefix(tag: int32, values: uint8[]): int32\n",
        externalRoots)
    var ctx: texpr.TypedExprSourceContext
    var err: str
    if !texpr.TypedExprBuildSourceContext(validSource, ctx, err) ||
       ctx.importcFunctions.len != 2:
        return 1

    let scalarSource = sourceNew(
        "",
        "",
        "pkg://current",
        "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
        "/work/pkg/ffi_map_scalar.cheng",
        "@importc(\"scalar_pair\")\n@ffi_map(ptr = arg0, len = arg1)\nfn ScalarPair(first: int32, second: int32): int32\n",
        externalRoots)
    var scalarCtx: texpr.TypedExprSourceContext
    if texpr.TypedExprBuildSourceContext(scalarSource, scalarCtx, err) ||
       !strutil.Contains(err, "requires exactly one dynamic slice"):
        return 2

    let wrongLayoutSource = sourceNew(
        "",
        "",
        "pkg://current",
        "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
        "/work/pkg/ffi_map_wrong_layout.cheng",
        "@importc(\"wrong_layout\")\n@ffi_map(ptr = arg0, len = arg1)\nfn WrongLayout(tag: int32, values: uint8[]): int32\n",
        externalRoots)
    var wrongLayoutCtx: texpr.TypedExprSourceContext
    if texpr.TypedExprBuildSourceContext(wrongLayoutSource,
                                         wrongLayoutCtx,
                                         err) ||
       !strutil.Contains(err, "layout mismatch expected ptr=arg1 len=arg2"):
        return 3

    let multipleSlicesSource = sourceNew(
        "",
        "",
        "pkg://current",
        "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
        "/work/pkg/ffi_map_multiple_slices.cheng",
        "@importc(\"multiple_slices\")\n@ffi_map(ptr = arg0, len = arg1)\nfn MultipleSlices(first: uint8[], second: int32[]): int32\n",
        externalRoots)
    var multipleSlicesCtx: texpr.TypedExprSourceContext
    if texpr.TypedExprBuildSourceContext(multipleSlicesSource,
                                         multipleSlicesCtx,
                                         err) ||
       !strutil.Contains(err, "requires exactly one dynamic slice"):
        return 4
    return 0

fn callDeclarationContexts(reverseOrder: bool,
                           contexts: var texpr.TypedExprSourceContext[],
                           callerIndex: var int32) =
    let callerPath = "/work/pkg/call_decl_caller.cheng"
    let overloadPath = "/work/pkg/call_decl_overload.cheng"
    let collisionPath = "/work/pkg/call_decl_collision.cheng"
    let hiddenPath = "/work/pkg/call_decl_hidden.cheng"
    let importcPath = "/work/pkg/call_decl_importc.cheng"

    var caller = contextParsed(callerPath,
                               "import pkg/call_decl_overload as overload\nimport pkg/call_decl_collision as collision\nimport pkg/call_decl_importc as ffi\ntype\n    CallArgInner =\n        values: int32[]\n    CallArgOuter =\n        inners: CallArgInner[]\nfn Run(state: CallArgOuter, i: int32, j: int32): int32 = 0\n")
    if reverseOrder:
        contextImport(caller, "ffi", importcPath)
        contextImport(caller, "collision", collisionPath)
        contextImport(caller, "overload", overloadPath)
    else:
        contextImport(caller, "overload", overloadPath)
        contextImport(caller, "collision", collisionPath)
        contextImport(caller, "ffi", importcPath)

    var overload: texpr.TypedExprSourceContext
    if reverseOrder:
        overload = contextParsed(overloadPath,
                                 "fn Pick(value: str): bool = true\nfn Pick(value: int32): str = \"\"\nfn Collision(value: int32): str = \"\"\nfn CrossKind(value: int32): str = \"\"\nfn privatePick(value: int32): int32 = value\n")
    else:
        overload = contextParsed(overloadPath,
                                 "fn Pick(value: int32): str = \"\"\nfn Pick(value: str): bool = true\nfn Collision(value: int32): str = \"\"\nfn CrossKind(value: int32): str = \"\"\nfn privatePick(value: int32): int32 = value\n")

    var collision = contextParsed(collisionPath,
                                  "fn Collision(value: int32): int64 = int64(value)\n")

    var hidden = contextParsed(hiddenPath,
                               "fn Pick(value: int32): uint64 = uint64(value)\nfn Hidden(value: int32): int32 = value\n@importc(\"hidden_c\")\nfn HiddenC(value: int32): int32\n")

    var importc = contextParsed(importcPath,
                                "@importc(\"c_read\")\nfn CRead(value: int32): uint64\n@importc(\"c_cross\")\nfn CrossKind(value: int32): uint64\n")

    contexts = []
    if reverseOrder:
        texpr.TypedExprSourceContextAppendMove(contexts, hidden)
        texpr.TypedExprSourceContextAppendMove(contexts, importc)
        texpr.TypedExprSourceContextAppendMove(contexts, collision)
        texpr.TypedExprSourceContextAppendMove(contexts, overload)
        texpr.TypedExprSourceContextAppendMove(contexts, caller)
        callerIndex = 4
    else:
        texpr.TypedExprSourceContextAppendMove(contexts, caller)
        texpr.TypedExprSourceContextAppendMove(contexts, overload)
        texpr.TypedExprSourceContextAppendMove(contexts, collision)
        texpr.TypedExprSourceContextAppendMove(contexts, hidden)
        texpr.TypedExprSourceContextAppendMove(contexts, importc)
        callerIndex = 0

fn explicitGenericContexts(contexts: var texpr.TypedExprSourceContext[],
                           callerIndex: var int32) =
    let callerPath = "/work/pkg/explicit_generic_caller.cheng"
    let targetPath = "/work/pkg/explicit_generic_target.cheng"
    var caller = contextParsed(
        callerPath,
        "import pkg/explicit_generic_target as generic\nfn Run(): int32 = 0\n")
    contextImport(caller, "generic", targetPath)
    var target = contextParsed(
        targetPath,
        "type X = int32\nfn Pair[A, B](first: A, second: B): B = second\nfn ReturnOnly[A, B](marker: int32): B =\n    var result: B\n    return result\nfn Identity[T](value: T): T = value\nfn Implicit(value: T): T = value\nfn Plain(value: int32): int32 = value\nfn ConcreteX(value: X): X = value\n")
    contexts = []
    texpr.TypedExprSourceContextAppendMove(contexts, caller)
    texpr.TypedExprSourceContextAppendMove(contexts, target)
    callerIndex = 0

# Adversarial witness for the removed freshness scheme only. Production
# freshness never calls this hash.
@borrows
fn removedWeakMetadataHash(seedRaw: int64, text: str): int64 =
    var seed = seedRaw
    for i in 0..<text.len:
        seed = (seed * 16777619 + Int64(int32(text[i])) + 1) % 2147483647
    return (seed * 16777619 + 257) % 2147483647

@borrows
fn sourceNew(workspaceRoot: str,
             packageRoot: str,
             packageId: str,
             packageChannel: str,
             sourcePath: str,
             text: str,
             externalRoots: parser.ParserExternalPackageRoot[]): texpr.TypedExprSourceText =
    return texpr.TypedExprSourceTextBorrowPackageFacts(workspaceRoot,
                                                      packageRoot,
                                                      packageId,
                                                      packageChannel,
                                                      externalRoots,
                                                      sourcePath,
                                                      text)

@borrows
fn oracleStringCapacityBytes(items: str[]): int64 =
    var total = Int64(items.cap) * 24
    for i in 0..<items.len:
        total = total + Int64(items[i].len)
    return total

@borrows
fn oracleIntCapacityBytes(items: int32[]): int64 =
    return Int64(items.cap) * 4

@borrows
fn oracleStateCapacityBytes(items: texpr.TypedExprBuildIndexLookupState[]): int64 =
    return Int64(items.cap) * 4

@borrows
fn oracleDeclarationKindCapacityBytes(items: texpr.TypedExprCallDeclarationKind[]): int64 =
    return Int64(items.cap) * 4

@borrows
fn oracleBoolCapacityBytes(items: bool[]): int64 =
    return Int64(items.cap)

# Independent field-by-field retained-capacity oracle. It intentionally does
# not call any production live-byte helper or unified measurement entry point.
@borrows
fn retainedCapacityOracle(index: texpr.TypedExprBuildIndex): texpr.TypedExprBuildIndexLiveByteReport =
    var out: texpr.TypedExprBuildIndexLiveByteReport
    if index == nil:
        return out
    if !index.released:
        # arm64 owner object, including canonical/derived intern-id columns,
        # scalar counters, flags, refs and ABI alignment.
        out.objectBytes = Int64(2120)

    out.bucketBytes = oracleIntCapacityBytes(index.entryBucketHeads) +
                      oracleIntCapacityBytes(index.visibilityBucketHeads) +
                      oracleIntCapacityBytes(index.importOwnerBucketHeads) +
                      oracleIntCapacityBytes(index.visibilityQueryBucketHeads) +
                      oracleIntCapacityBytes(index.contextFieldOwnerBucketHeads) +
                      oracleIntCapacityBytes(index.fieldOwnerBucketHeads) +
                      oracleIntCapacityBytes(index.layoutBucketHeads)

    out.entryBytes = oracleIntCapacityBytes(index.entryNext) +
                     oracleIntCapacityBytes(index.entryHashes) +
                     oracleStateCapacityBytes(index.entryStates) +
                     oracleIntCapacityBytes(index.entryValueIndexes) +
                     oracleIntCapacityBytes(index.entryValidationMarks) +
                     oracleIntCapacityBytes(index.visibilityNext) +
                     oracleIntCapacityBytes(index.visibilityHashes) +
                     oracleIntCapacityBytes(index.visibilityValueIndexes) +
                     oracleIntCapacityBytes(index.importOwnerNext) +
                     oracleIntCapacityBytes(index.importOwnerHashes) +
                     oracleIntCapacityBytes(index.importOwnerTargetHeads) +
                     oracleIntCapacityBytes(index.importTargetNext) +
                     oracleIntCapacityBytes(index.importTargetEntryIndexes)

    out.keyBytes = oracleStringCapacityBytes(index.entryKinds) +
                   oracleStringCapacityBytes(index.entrySourcePaths) +
                   oracleStringCapacityBytes(index.entryNames) +
                   oracleStringCapacityBytes(index.entryDetails) +
                   oracleStringCapacityBytes(index.entryOrigins) +
                   oracleStringCapacityBytes(index.entryFingerprints) +
                   oracleStringCapacityBytes(index.visibilityKinds) +
                   oracleStringCapacityBytes(index.visibilitySourcePaths) +
                   oracleStringCapacityBytes(index.visibilityNames) +
                   oracleStringCapacityBytes(index.visibilityDetails) +
                   oracleStringCapacityBytes(index.visibilityFingerprints) +
                   oracleStringCapacityBytes(index.importOwnerSourcePaths) +
                   oracleIntCapacityBytes(index.entryKindIds) +
                   oracleIntCapacityBytes(index.entrySourcePathIds) +
                   oracleIntCapacityBytes(index.entryNameIds) +
                   oracleIntCapacityBytes(index.entryDetailIds) +
                   oracleIntCapacityBytes(index.entryOriginIds) +
                   oracleIntCapacityBytes(index.entryFingerprintIds) +
                   oracleIntCapacityBytes(index.visibilityKindIds) +
                   oracleIntCapacityBytes(index.visibilitySourcePathIds) +
                   oracleIntCapacityBytes(index.visibilityNameIds) +
                   oracleIntCapacityBytes(index.visibilityDetailIds) +
                   oracleIntCapacityBytes(index.visibilityFingerprintIds) +
                   oracleIntCapacityBytes(index.importOwnerSourcePathIds) +
                   Int64(index.hardError.len)

    out.rootBytes = oracleStringCapacityBytes(index.contextSourcePaths) +
                    oracleIntCapacityBytes(index.contextMetadataDomainCounts) +
                    oracleIntCapacityBytes(index.callDeclarationSortedRows) +
                    oracleStringCapacityBytes(index.callDeclarationSourcePaths) +
                    oracleStringCapacityBytes(index.callDeclarationNames) +
                    oracleIntCapacityBytes(index.callDeclarationArities) +
                    oracleIntCapacityBytes(index.callDeclarationGenericStarts) +
                    oracleIntCapacityBytes(index.callDeclarationGenericCounts) +
                    oracleStringCapacityBytes(index.callDeclarationGenericNames) +
                    oracleIntCapacityBytes(index.callDeclarationParamStarts) +
                    oracleIntCapacityBytes(index.callDeclarationParamCounts) +
                    oracleStringCapacityBytes(index.callDeclarationParamTypes) +
                    oracleStringCapacityBytes(index.callDeclarationReturnTypes) +
                    oracleStringCapacityBytes(index.callDeclarationTargetSymbols) +
                    oracleDeclarationKindCapacityBytes(index.callDeclarationKinds) +
                    oracleIntCapacityBytes(index.contextSourcePathIds) +
                    oracleIntCapacityBytes(index.callDeclarationSourcePathIds) +
                    oracleIntCapacityBytes(index.callDeclarationNameIds) +
                    oracleIntCapacityBytes(index.callDeclarationGenericNameIds) +
                    oracleIntCapacityBytes(index.callDeclarationParamTypeIds) +
                    oracleIntCapacityBytes(index.callDeclarationReturnTypeIds) +
                    oracleIntCapacityBytes(index.callDeclarationTargetSymbolIds)

    out.contentCacheBytes = oracleIntCapacityBytes(index.contentCacheBucketHeads) +
                            oracleIntCapacityBytes(index.contentCacheNext) +
                            oracleIntCapacityBytes(index.contentCacheHashes) +
                            oracleStringCapacityBytes(index.contentCacheKinds) +
                            oracleStringCapacityBytes(index.contentCacheSourcePaths) +
                            oracleStringCapacityBytes(index.contentCacheNames) +
                            oracleStringCapacityBytes(index.contentCacheValues) +
                            oracleIntCapacityBytes(index.contentCacheKindIds) +
                            oracleIntCapacityBytes(index.contentCacheSourcePathIds) +
                            oracleIntCapacityBytes(index.contentCacheNameIds) +
                            oracleIntCapacityBytes(index.contentCacheValueIds)

    out.cacheBytes = oracleIntCapacityBytes(index.contextFieldOwnerNext) +
                     oracleIntCapacityBytes(index.contextFieldOwnerHashes) +
                     oracleStringCapacityBytes(index.contextFieldOwnerSourcePaths) +
                     oracleStringCapacityBytes(index.contextFieldOwnerTypes) +
                     oracleIntCapacityBytes(index.contextFieldOwnerSourcePathIds) +
                     oracleIntCapacityBytes(index.contextFieldOwnerTypeIds) +
                     oracleIntCapacityBytes(index.contextFieldOwnerHeads) +
                     oracleIntCapacityBytes(index.contextFieldOwnerTails) +
                     oracleIntCapacityBytes(index.contextFieldNodeNext) +
                     oracleIntCapacityBytes(index.contextFieldNodeContextIndexes) +
                     oracleIntCapacityBytes(index.contextFieldNodeRowIndexes) +
                     oracleIntCapacityBytes(index.contextFieldNodeDeclaredOffsetBytes) +
                     oracleIntCapacityBytes(index.contextFieldNodeDeclaredSizeBytes) +
                     oracleIntCapacityBytes(index.contextFieldNodeDeclaredAlignBytes) +
                     oracleIntCapacityBytes(index.contextFieldNodeOffsetBytes) +
                     oracleIntCapacityBytes(index.contextFieldNodeSizeBytes) +
                     oracleIntCapacityBytes(index.contextFieldNodeAlignBytes) +
                     oracleBoolCapacityBytes(index.contextFieldNodeLayoutReady) +
                     oracleIntCapacityBytes(index.fieldOwnerNext) +
                     oracleIntCapacityBytes(index.fieldOwnerHashes) +
                     oracleStringCapacityBytes(index.fieldOwnerSourcePaths) +
                     oracleStringCapacityBytes(index.fieldOwnerTypes) +
                     oracleIntCapacityBytes(index.fieldOwnerSourcePathIds) +
                     oracleIntCapacityBytes(index.fieldOwnerTypeIds) +
                     oracleIntCapacityBytes(index.fieldOwnerHeads) +
                     oracleIntCapacityBytes(index.fieldOwnerTails) +
                     oracleIntCapacityBytes(index.fieldRowNext) +
                     oracleIntCapacityBytes(index.layoutNext) +
                     oracleIntCapacityBytes(index.layoutHashes) +
                     oracleStringCapacityBytes(index.layoutSourcePaths) +
                     oracleStringCapacityBytes(index.layoutTypeNames) +
                     oracleIntCapacityBytes(index.layoutSourcePathIds) +
                     oracleIntCapacityBytes(index.layoutTypeNameIds) +
                     oracleIntCapacityBytes(index.layoutStates) +
                     oracleIntCapacityBytes(index.layoutSizeBytes) +
                     oracleIntCapacityBytes(index.layoutAlignBytes) +
                     oracleIntCapacityBytes(index.visibilityQueryNext) +
                     oracleIntCapacityBytes(index.visibilityQueryHashes) +
                     oracleStringCapacityBytes(index.visibilityQueryOwnerSourcePaths) +
                     oracleStringCapacityBytes(index.visibilityQueryKinds) +
                     oracleStringCapacityBytes(index.visibilityQueryNames) +
                     oracleStringCapacityBytes(index.visibilityQueryDetails) +
                     oracleStateCapacityBytes(index.visibilityQueryStates) +
                     oracleIntCapacityBytes(index.visibilityQueryValueIndexes) +
                     oracleStringCapacityBytes(index.visibilityQueryFingerprints)

    out.totalBytes = out.objectBytes + out.bucketBytes + out.entryBytes +
                     out.keyBytes + out.rootBytes + out.cacheBytes +
                     out.contentCacheBytes
    return out

@borrows
fn liveReportValid(index: texpr.TypedExprBuildIndex): bool =
    let report = texpr.TypedExprBuildIndexMeasureLiveBytes(index)
    let oracle = retainedCapacityOracle(index)
    if report.objectBytes != oracle.objectBytes ||
       report.bucketBytes != oracle.bucketBytes ||
       report.entryBytes != oracle.entryBytes ||
       report.keyBytes != oracle.keyBytes ||
       report.rootBytes != oracle.rootBytes ||
       report.cacheBytes != oracle.cacheBytes ||
       report.contentCacheBytes != oracle.contentCacheBytes ||
       report.totalBytes != oracle.totalBytes:
        return false
    if oracle.objectBytes <= 0 || oracle.bucketBytes <= 0 ||
       oracle.entryBytes <= 0 || oracle.keyBytes <= 0 ||
       oracle.rootBytes <= 0 || oracle.cacheBytes <= 0:
        return false
    if oracle.totalBytes != texpr.TypedExprBuildIndexStructuredLiveBytes(index) ||
       oracle.totalBytes != texpr.TypedExprBuildIndexLiveBytes(index):
        return false
    let logicalBytes = texpr.TypedExprBuildIndexLogicalLiveBytes(index)
    return logicalBytes > 0 && logicalBytes <= oracle.totalBytes

@borrows
fn releasedLiveReportZero(index: texpr.TypedExprBuildIndex): bool =
    let report = texpr.TypedExprBuildIndexMeasureLiveBytes(index)
    let oracle = retainedCapacityOracle(index)
    return oracle.totalBytes == 0 &&
           report.objectBytes == oracle.objectBytes &&
           report.bucketBytes == oracle.bucketBytes &&
           report.entryBytes == oracle.entryBytes &&
           report.keyBytes == oracle.keyBytes &&
           report.rootBytes == oracle.rootBytes &&
           report.cacheBytes == oracle.cacheBytes &&
           report.contentCacheBytes == oracle.contentCacheBytes &&
           report.totalBytes == oracle.totalBytes &&
           texpr.TypedExprBuildIndexLogicalLiveBytes(index) == 0 &&
           texpr.TypedExprBuildIndexStructuredLiveBytes(index) == 0 &&
           texpr.TypedExprBuildIndexLiveBytes(index) == 0

@borrows
fn liveReportsEqual(left: texpr.TypedExprBuildIndexLiveByteReport,
                    right: texpr.TypedExprBuildIndexLiveByteReport): bool =
    return left.objectBytes == right.objectBytes &&
           left.bucketBytes == right.bucketBytes &&
           left.entryBytes == right.entryBytes &&
           left.keyBytes == right.keyBytes &&
           left.rootBytes == right.rootBytes &&
           left.cacheBytes == right.cacheBytes &&
           left.contentCacheBytes == right.contentCacheBytes &&
           left.totalBytes == right.totalBytes

fn runExactVisibilityLayoutClone(): int32 =
    let callerPath = "/work/pkg/caller.cheng"
    let importedPath = "/work/pkg/imported.cheng"
    let hiddenPath = "/work/pkg/hidden.cheng"

    var contexts: texpr.TypedExprSourceContext[]
    var caller = contextNew(callerPath)
    contextImport(caller, "imported", importedPath)
    add(contexts, caller)

    var imported = contextParsed(
        importedPath,
        "type\n    ImportedType =\n        value: int32\n    ImportedRef = ref object\n        value: int32\n    ImportedPtr = int32*\n    ImportedEnum = enum\n        ImportedValue = 7\n    ImportedOwner =\n        first: int32\n        second: int64\n")
    add(contexts, imported)

    var hidden = contextParsed(
        hiddenPath,
        "type\n    GlobalOnlyPtr = uint64*\n    GlobalOnlyEnum = enum\n        GlobalOnlyValue = 11\n    CloneOnly =\n        value: int32\n")
    add(contexts, hidden)

    var ir: texpr.TypedExprIr
    texpr.TypedExprBuildSourceContextIndex(ir, contexts)
    let index = texpr.TypedExprIrBuildIndex(ir)
    let reuseBefore = texpr.TypedExprBuildIndexReuseCount(index)
    texpr.TypedExprBuildSourceContextIndex(ir, contexts)
    if texpr.TypedExprIrBuildIndex(ir) != index ||
       texpr.TypedExprBuildIndexReuseCount(index) != reuseBefore + 1:
        return 21
    var valueIndex: int32
    if texpr.TypedExprBuildIndexLookup(index,
                                       "ctx_declared_source",
                                       callerPath,
                                       "ImportedType",
                                       "",
                                       valueIndex) != texpr.TypedExprBuildIndexMissing:
        return 1
    if texpr.TypedExprBuildIndexLookup(index,
                                       "ctx_import_declared",
                                       callerPath,
                                       "ImportedType",
                                       "",
                                       valueIndex) != texpr.TypedExprBuildIndexUnique ||
       valueIndex != 1:
        return 2
    if texpr.TypedExprPointerPointeeType(contexts[0], contexts, "ImportedPtr") != "int32":
        return 3
    if texpr.TypedExprLookupEnumConstType(contexts[0], contexts, "ImportedValue") != "ImportedEnum":
        return 4
    if texpr.TypedExprPointerPointeeType(contexts[0], contexts, "GlobalOnlyPtr") != "":
        return 5
    if texpr.TypedExprLookupEnumConstType(contexts[0], contexts, "GlobalOnlyValue") != "":
        return 6

    texpr.TypedExprIrAppendTypeDefAliasesFromContext(ir, contexts[1])
    texpr.TypedExprIrAppendTypeDefAliasesFromContext(ir, contexts[2])
    texpr.TypedExprIrAppendEnumValuesFromContext(ir, contexts[1])
    texpr.TypedExprIrAppendEnumValuesFromContext(ir, contexts[2])
    texpr.TypedExprIrAppendTypeLayoutsFromContext(
        ir, share(contexts[1]), contexts)
    if texpr.TypedExprIrLookupTypeDefAliasTargetType(ir,
                                                     callerPath,
                                                     "ImportedPtr") != "int32*":
        return 7
    if texpr.TypedExprIrLookupTypeDefAliasTargetType(ir,
                                                     callerPath,
                                                     "GlobalOnlyPtr") != "":
        return 8
    var enumType: str
    var enumValue: int32
    if !texpr.TypedExprIrLookupEnumConstValue(ir,
                                              callerPath,
                                              "ImportedValue",
                                              enumType,
                                              enumValue) ||
       enumType != "ImportedEnum" || enumValue != 7:
        return 9
    if texpr.TypedExprIrLookupEnumConstValue(ir,
                                             callerPath,
                                             "GlobalOnlyValue",
                                             enumType,
                                             enumValue):
        return 10
    var fieldType: str
    var fieldOffset: int32
    var fieldSize: int32
    var fieldAlign: int32
    if !texpr.TypedExprIrLookupSingleFieldMeta(ir,
                                               callerPath,
                                               "ImportedOwner",
                                               "second",
                                               fieldType,
                                               fieldOffset,
                                               fieldSize,
                                               fieldAlign) ||
       fieldType != "int64" || fieldOffset != 8 ||
       fieldSize != 8 || fieldAlign != 8:
        return 11
    var layoutSize: int32
    var layoutAlign: int32
    var layoutFields: int32
    if !texpr.TypedExprIrLookupTypeLayout(ir,
                                          callerPath,
                                          "ImportedOwner",
                                          layoutSize,
                                          layoutAlign,
                                          layoutFields) ||
       layoutSize != 16 || layoutAlign != 8 || layoutFields != 2:
        return 12
    if !liveReportValid(index):
        return 13

    let originalLiveBytes = texpr.TypedExprBuildIndexLiveBytes(index)
    let originalLiveReport = texpr.TypedExprBuildIndexMeasureLiveBytes(index)
    var clonedIr = texpr.TypedExprIrClone(ir)
    let clonedIndex = texpr.TypedExprIrBuildIndex(clonedIr)
    if clonedIndex == nil || clonedIndex == index ||
       texpr.TypedExprBuildIndexLiveBytes(index) != originalLiveBytes ||
       !liveReportsEqual(originalLiveReport,
                         texpr.TypedExprBuildIndexMeasureLiveBytes(index)):
        return 14
    texpr.TypedExprIrAppendTypeLayoutsFromContext(
        clonedIr, share(contexts[2]), contexts)
    if texpr.TypedExprBuildIndexLiveBytes(index) != originalLiveBytes ||
       !liveReportsEqual(originalLiveReport,
                         texpr.TypedExprBuildIndexMeasureLiveBytes(index)):
        return 17
    if !texpr.TypedExprIrLookupTypeLayout(clonedIr,
                                          hiddenPath,
                                          "CloneOnly",
                                          layoutSize,
                                          layoutAlign,
                                          layoutFields):
        return 15
    if texpr.TypedExprIrLookupTypeLayout(ir,
                                         hiddenPath,
                                         "CloneOnly",
                                         layoutSize,
                                         layoutAlign,
                                         layoutFields):
        return 16

    texpr.TypedExprIrReleasePayload(ir)
    if texpr.TypedExprBuildIndexReleaseCount(index) != 1 ||
       !releasedLiveReportZero(index):
        return 18
    if !texpr.TypedExprIrLookupSingleFieldMeta(clonedIr,
                                               callerPath,
                                               "ImportedOwner",
                                               "second",
                                               fieldType,
                                               fieldOffset,
                                               fieldSize,
                                               fieldAlign):
        return 19
    texpr.TypedExprIrReleasePayload(clonedIr)
    if texpr.TypedExprBuildIndexReleaseCount(clonedIndex) != 1 ||
       !releasedLiveReportZero(clonedIndex):
        return 20
    return 0

