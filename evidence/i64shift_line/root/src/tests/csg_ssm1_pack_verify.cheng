# SSM1 单文件内嵌 payload 真包集成验证 (E 线 tools/ssm1_pack.py 产物)。
# 用法: csg_ssm1_pack_verify.exe <stream.ssm1 路径>
# 断言: 内嵌解析 / t=0 关键帧定位 / 首 chunk payload 头 magic "DPD1" /
# 秒开预算 (manifest 区 + 首关键帧 payload, 首 chunk offset 即 manifest 区末)。
import std/cmdline
import std/rawbytes
import cheng/game/assets/import/reader
import cheng/game/assets/stream/manifest

fn main(): int32 =
    let path = cmdline.paramStr(1)
    var bounds = reader.AssetReaderBoundsFor("manifest")
    bounds.maxBytes = manifest.StreamManifestQuotaMaxBytes()
    var data = rawbytes.EmptyBytes()
    assert(reader.AssetReaderLoadBounded(path, bounds, data), "load pack")
    defer:
        rawbytes.BytesFree(data)
    var m: manifest.StreamManifest
    assert(manifest.StreamManifestParseEx(data, m, true), "embedded parse")
    let n = manifest.StreamManifestChunkCount(m)
    let dur = manifest.StreamManifestTotalDurationMs(m)
    echo(Fmt"pack chunks={n} durationMs={dur}")
    let first = manifest.StreamManifestNearestKeyframeIndexForTime(m, int64(0))
    assert(first >= 0, "first keyframe exists at t=0")
    var c: manifest.StreamChunk
    assert(manifest.StreamManifestChunkAt(m, first, c), "chunk at first kf")
    let budget = c.payloadOffset + c.payloadLen
    echo(Fmt"firstKeyframe chunk={first} startMs={c.startMs} len={c.payloadLen} offset={c.payloadOffset}")
    echo(Fmt"openBudgetBytes={budget}")
    # payload 头 magic "DPD1" (36B 头首 4 字节)。
    let ob: int32 = int32(c.payloadOffset)
    let p0 = rawbytes.BytesGet(data, ob)
    let p1 = rawbytes.BytesGet(data, ob + 1)
    let p2 = rawbytes.BytesGet(data, ob + 2)
    let p3 = rawbytes.BytesGet(data, ob + 3)
    assert(p0 == Int32('D') && p1 == Int32('P') && p2 == Int32('D') &&
        p3 == Int32('1'), "payload magic DPD1")
    echo("PASS payload magic DPD1")
    echo("csg_ssm1_pack_verify PASS")
    return 0
