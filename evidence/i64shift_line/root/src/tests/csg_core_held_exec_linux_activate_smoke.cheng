import std/os as os
import std/rawbytes
import std/strings
import cheng/std/bytes_layout as layout
import cheng/core/csg_core/merkle_store_codec
import cheng/core/csg_core/production_launcher as launcher
import cheng/core/runtime/held_exec_identity as held_identity
import cheng/core/runtime/production_held_exec_provider as provider

fn fail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

fn smokeCid(domain: str, seed: str): str =
    var payload = layout.ByteBufInit(seed.len + 8)
    var index: int32
    while index < seed.len:
        layout.ByteBufAppendByte(payload, seed[index])
        index = index + 1
    var bytes = layout.ByteBufToBytes(payload)
    let cid = merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(domain, bytes)
    rawbytes.BytesFree(bytes)
    layout.ByteBufFree(payload)
    return cid

fn main(): int32 =
    let platform = held_identity.ChengHeldExecIdentityPlatform()
    if platform != "linux-x86_64":
        return fail("held-exec linux activate requires linux-x86_64")

    let launcherPath = held_identity.ChengHeldExecIdentityLauncherFixedPath(platform)
    let binaryPath = held_identity.ChengHeldExecIdentityBinaryFixedPath(platform)
    var launcherEvidence: held_identity.ChengHeldExecFileEvidence
    var binaryEvidence: held_identity.ChengHeldExecFileEvidence
    var collectErr: str
    if !held_identity.ChengHeldExecIdentityCollectFileInto(
           platform, launcherPath, launcherEvidence, collectErr):
        return fail(collectErr)
    if !held_identity.ChengHeldExecIdentityCollectFileInto(
           platform, binaryPath, binaryEvidence, collectErr):
        return fail(collectErr)
    os.WriteLine(os.Get_stderr(), strings.Uint64ToStr(launcherEvidence.linux.inodeFlags))
    os.WriteLine(os.Get_stderr(), strings.Uint64ToStr(binaryEvidence.linux.inodeFlags))
    if launcherEvidence.nativeImageProven:
        os.WriteLine(os.Get_stderr(), "launcher_native_ok")
    if binaryEvidence.nativeImageProven:
        os.WriteLine(os.Get_stderr(), "binary_native_ok")
    if !launcherEvidence.linux.fsVerityProven ||
       !binaryEvidence.linux.fsVerityProven:
        os.WriteLine(os.Get_stderr(), launcherEvidence.nativeImageError)
        os.WriteLine(os.Get_stderr(), binaryEvidence.nativeImageError)
        return fail("installed images lack fs-verity")
    os.WriteLine(os.Get_stderr(), launcherEvidence.bytesCid)
    os.WriteLine(os.Get_stderr(), binaryEvidence.bytesCid)
    os.WriteLine(os.Get_stderr(), launcherEvidence.linux.fsVerityDigestCid)
    os.WriteLine(os.Get_stderr(), binaryEvidence.linux.fsVerityDigestCid)

    os.WriteLine(os.Get_stderr(), "after_collect")
    var launcherIdentity: provider.CsgCoreProductionHeldExecIdentity
    var binaryIdentity: provider.CsgCoreProductionHeldExecIdentity
    launcherIdentity.device = launcherEvidence.held.device
    launcherIdentity.inode = launcherEvidence.held.inode
    launcherIdentity.mode = launcherEvidence.held.mode
    launcherIdentity.linkCount = launcherEvidence.held.linkCount
    launcherIdentity.size = launcherEvidence.held.size
    launcherIdentity.ownerUid = launcherEvidence.held.ownerUid
    launcherIdentity.ownerGid = launcherEvidence.held.ownerGid
    launcherIdentity.mtimeSec = launcherEvidence.held.mtimeSec
    launcherIdentity.mtimeNsec = launcherEvidence.held.mtimeNsec
    launcherIdentity.ctimeSec = launcherEvidence.held.ctimeSec
    launcherIdentity.ctimeNsec = launcherEvidence.held.ctimeNsec
    os.WriteLine(os.Get_stderr(), "after_launcher_scalars")
    launcherIdentity.bytesCid = strings.CloneStr(launcherEvidence.bytesCid)
    os.WriteLine(os.Get_stderr(), "after_launcher_bytes")
    launcherIdentity.externalAnchorCid =
        strings.CloneStr(launcherEvidence.linux.fsVerityDigestCid)
    os.WriteLine(os.Get_stderr(), "after_launcher_anchor")
    launcherIdentity.immutableReceiptCid =
        launcher.productionLauncherImmutableReceiptCid(
            launcherEvidence.linux.inodeFlags)
    launcherIdentity.heldDescriptorTokenCid =
        launcher.productionLauncherHeldDescriptorTokenCid(
            launcherEvidence.held.device, launcherEvidence.held.inode)
    launcherIdentity.heldDescriptorIdentityCid =
        provider.CsgCoreProductionHeldExecProviderIdentityCid(launcherIdentity)
    os.WriteLine(os.Get_stderr(), "after_launcher_map")
    binaryIdentity.device = binaryEvidence.held.device
    binaryIdentity.inode = binaryEvidence.held.inode
    binaryIdentity.mode = binaryEvidence.held.mode
    binaryIdentity.linkCount = binaryEvidence.held.linkCount
    binaryIdentity.size = binaryEvidence.held.size
    binaryIdentity.ownerUid = binaryEvidence.held.ownerUid
    binaryIdentity.ownerGid = binaryEvidence.held.ownerGid
    binaryIdentity.mtimeSec = binaryEvidence.held.mtimeSec
    binaryIdentity.mtimeNsec = binaryEvidence.held.mtimeNsec
    binaryIdentity.ctimeSec = binaryEvidence.held.ctimeSec
    binaryIdentity.ctimeNsec = binaryEvidence.held.ctimeNsec
    binaryIdentity.bytesCid = strings.CloneStr(binaryEvidence.bytesCid)
    binaryIdentity.externalAnchorCid =
        strings.CloneStr(binaryEvidence.linux.fsVerityDigestCid)
    binaryIdentity.immutableReceiptCid =
        launcher.productionLauncherImmutableReceiptCid(
            binaryEvidence.linux.inodeFlags)
    binaryIdentity.heldDescriptorTokenCid =
        launcher.productionLauncherHeldDescriptorTokenCid(
            binaryEvidence.held.device, binaryEvidence.held.inode)
    binaryIdentity.heldDescriptorIdentityCid =
        provider.CsgCoreProductionHeldExecProviderIdentityCid(binaryIdentity)
    os.WriteLine(os.Get_stderr(), "after_binary_map")

    var session: system.RuntimeAllocationLedgerSessionCapability
    session.handle = uint64(71)
    session.generation = uint64(13)
    session.nonce0 = uint64(17)
    session.nonce1 = uint64(19)

    let argvCid =
        "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    let envCid =
        "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
    let planCid =
        "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
    let proofCid =
        "sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
    let admitCid =
        "sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"

    os.WriteLine(os.Get_stderr(), "before_activate")
    if !launcher.CsgCoreProductionLauncherMainActivateHeldBinaryInto(
           session,
           3,
           binaryIdentity.bytesCid,
           binaryIdentity.heldDescriptorIdentityCid,
           argvCid,
           envCid,
           planCid,
           proofCid,
           admitCid):
        return fail("ActivateHeldBinaryInto failed on linux-x86_64")

    var issued: provider.CsgCoreProductionHeldExecReceipt
    var issueErr: str
    if !provider.CsgCoreProductionHeldExecProviderIssueInto(issued, issueErr):
        return fail(issueErr)
    if issued.executionMethod != "execveat_at_empty_path":
        return fail("issued execution method is not execveat")
    if issued.childProcessIdentityCid.len == 0:
        return fail("issued receipt missing child identity")

    os.WriteLine(os.Get_stdout(), "csg_core_held_exec_linux_activate_smoke ok")
    os.WriteLine(os.Get_stdout(), issued.receiptCid)
    os.WriteLine(os.Get_stdout(), issued.childProcessIdentityCid)
    return 0
