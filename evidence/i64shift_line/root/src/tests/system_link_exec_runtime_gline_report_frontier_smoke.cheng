import std/strutils as strutil
import cheng/core/backend/system_link_exec_runtime as runtime
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/tooling/compiler_csg_production_lifetime as csglife
import cheng/core/tooling/compiler_payload_lifecycle as payload

fn attachTerminalCompilerCsgReceipt(
        result: var runtime.SystemLinkExecRuntimeResult) =
    var csg: ccsg.CompilerCsg
    var state: csglife.CompilerCsgProductionLifetime
    csglife.CompilerCsgProductionLifetimeBegin(csg, state)
    csglife.CompilerCsgProductionLifetimeEndUnmoved(
        csg,
        state,
        payload.CompilerPayloadOutcomeSuccess)
    csglife.CompilerCsgProductionLifetimeReceiptInto(
        state,
        result.compilerCsgLifetimeReceipt)
    result.compilerCsgLifetimeReceiptReady = true

fn main(): int32 =
    var emptyResult: runtime.SystemLinkExecRuntimeResult
    attachTerminalCompilerCsgReceipt(emptyResult)
    let firstReport =
        runtime.SystemLinkExecRuntimeResultReport(emptyResult)
    let secondReport =
        runtime.SystemLinkExecRuntimeResultReport(emptyResult)
    assert(firstReport == secondReport &&
           strutil.Contains(
               firstReport,
               "g_line_full_backend_parallel=blocked\n") &&
           strutil.Contains(
               firstReport,
               "g_line_full_backend_parallel_blocker=provider_hot_path_not_covered\n"),
           " system link runtime g-line report: second consume drift")
    echo("system_link_exec_runtime_gline_report_frontier_smoke=ok")
    return 0
