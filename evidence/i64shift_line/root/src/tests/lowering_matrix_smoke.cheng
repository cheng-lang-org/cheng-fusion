import std/os
import std/result
import cheng/core/tooling/compiler_request as creq
import cheng/core/tooling/path as chengpath
import cheng/core/tooling/compiler_world as cworld
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/backend/system_link_plan as slplan
import cheng/core/backend/lowering_plan as lower
import cheng/core/lang/parser
import cheng/core/lang/typed_expr as texpr
import std/strutils as strutil

fn reportFieldValue(report: str, key: str): str =
    let taggedReport = strutil.Join(["\n", report], "")
    let needle = strutil.Join(["\n", key, "="], "")
    let fieldPos = parser.ParserFindText(taggedReport, needle)
    if fieldPos < 0:
        return ""
    let valueStart = fieldPos + needle.len
    let tail = chengpath.TextSlice(taggedReport, valueStart, taggedReport.len - valueStart)
    let newlinePos = parser.ParserFindText(tail, "\n")
    if newlinePos < 0:
        return tail
    return chengpath.TextSlice(tail, 0, newlinePos)

fn buildOracleLayer(workspaceRoot: str,
                    packageRoot: str,
                    linkPlan: slplan.SystemLinkPlanStub,
                    label: str): parser.NormalizedExprLayer =
    let externalPackageRoots = slplan.SystemLinkPlanExternalPackageRoots(linkPlan)
    var oracleLayer: parser.NormalizedExprLayer
    var parseErr = ""
    assert(parser.ParserReadNormalizedExprLayerForSourceClosureWithExternalPackageRoots(workspaceRoot,
                                                                                        packageRoot,
                                                                                        externalPackageRoots,
                                                                                        linkPlan.sourceClosurePaths,
                                                                                        oracleLayer,
                                                                                        parseErr),
           strutil.Join([label, " oracle layer ", parseErr], ""))
    return oracleLayer

fn buildOracleFacts(workspaceRoot: str,
                    packageRoot: str,
                    linkPlan: slplan.SystemLinkPlanStub,
                    oracleLayer: var parser.NormalizedExprLayer,
                    label: str): ccsg.TypedExprFactTable =
    let externalPackageRoots = slplan.SystemLinkPlanExternalPackageRoots(linkPlan)
    var sourceTexts: texpr.TypedExprSourceText[]
    var metadataContexts: texpr.TypedExprSourceContext[]
    for i in 0..<linkPlan.sourceClosurePaths.len:
        let sourcePath = linkPlan.sourceClosurePaths[i]
        let sourceText = chengpath.ReadTextFile("", sourcePath)
        let typedSource = texpr.TypedExprSourceTextNewWithExternalPackageRoots(workspaceRoot,
                                                                                packageRoot,
                                                                                externalPackageRoots,
                                                                                sourcePath,
                                                                                sourceText)
        add(sourceTexts, typedSource)
        var metadataContext: texpr.TypedExprSourceContext
        var contextErr = ""
        assert(texpr.TypedExprBuildSourceContext(typedSource, metadataContext, contextErr),
               strutil.Join([label, " metadata context ", contextErr], ""))
        add(metadataContexts, metadataContext)
    assert(sourceTexts.len == linkPlan.sourceClosurePaths.len,
           strutil.Join([label, " source closure"], ""))
    assert(metadataContexts.len == linkPlan.sourceClosurePaths.len,
           strutil.Join([label, " metadata contexts"], ""))
    oracleLayer = buildOracleLayer(workspaceRoot, packageRoot, linkPlan, label)
    var factsLayer = parser.NormalizedExprLayerClone(oracleLayer)
    var facts: ccsg.TypedExprFactTable
    var factsErr = ""
    assert(texpr.TypedExprBuildFactsWithMetadataContexts(sourceTexts,
                                                         factsLayer,
                                                         metadataContexts,
                                                         facts,
                                                         factsErr),
           strutil.Join([label, " facts ", factsErr], ""))
    for i in 0..<sourceTexts.len:
        texpr.TypedExprClearSourceTextAllFields(sourceTexts[i])
    for i in 0..<metadataContexts.len:
        texpr.TypedExprClearSourceContextHeavyFields(metadataContexts[i])
    return facts

fn assertReportCount(report: str,
                     key: str,
                     expected: int32,
                     label: str) =
    assert(reportFieldValue(report, key) == IntToStr(expected),
           strutil.Join([label, " ", key], ""))

fn assertLoweringAggregateReport(report: str,
                                 rules: texpr.TypedExprLoweringRule[],
                                 label: str) =
    assertReportCount(report, "lowering_rule_count", rules.len, label)
    assertReportCount(report, "lowering_rule_unique_shape_count", texpr.TypedExprLoweringRuleUniqueShapeCount(rules), label)
    assertReportCount(report, "lowering_rule_unique_key_count", texpr.TypedExprLoweringRuleUniqueKeyCount(rules), label)
    assertReportCount(report, "lowering_rule_arg_value_count", texpr.TypedExprLoweringRuleCountArgPassKind(rules, texpr.TypedExprArgPassValue), label)
    assertReportCount(report, "lowering_rule_arg_address_count", texpr.TypedExprLoweringRuleCountArgPassKind(rules, texpr.TypedExprArgPassAddress), label)
    assertReportCount(report, "lowering_rule_arg_call_result_address_count", texpr.TypedExprLoweringRuleCountArgPassKind(rules, texpr.TypedExprArgPassCallResultAddress), label)
    assertReportCount(report, "lowering_rule_result_reg_count", texpr.TypedExprLoweringRuleCountResultPassKind(rules, texpr.TypedExprResultPassReg), label)
    assertReportCount(report, "lowering_rule_result_local_address_count", texpr.TypedExprLoweringRuleCountResultPassKind(rules, texpr.TypedExprResultPassLocalAddress), label)
    assertReportCount(report, "lowering_rule_result_sret_count", texpr.TypedExprLoweringRuleCountResultPassKind(rules, texpr.TypedExprResultPassSret), label)
    assertReportCount(report, "lowering_rule_materialize_register_count", texpr.TypedExprLoweringRuleCountMaterializeKind(rules, texpr.TypedExprMaterializeRegister), label)
    assertReportCount(report, "lowering_rule_materialize_local_slot_count", texpr.TypedExprLoweringRuleCountMaterializeKind(rules, texpr.TypedExprMaterializeLocalSlot), label)
    assertReportCount(report, "lowering_rule_materialize_call_result_local_count", texpr.TypedExprLoweringRuleCountMaterializeKind(rules, texpr.TypedExprMaterializeCallResultLocal), label)
    assertReportCount(report, "lowering_rule_materialize_dest_address_count", texpr.TypedExprLoweringRuleCountMaterializeKind(rules, texpr.TypedExprMaterializeDestAddress), label)
    assertReportCount(report, "lowering_rule_copy_scalar_store_count", texpr.TypedExprLoweringRuleCountCopyKind(rules, texpr.TypedExprCopyScalarStore), label)
    assertReportCount(report, "lowering_rule_copy_region_copy_count", texpr.TypedExprLoweringRuleCountCopyKind(rules, texpr.TypedExprCopyRegionCopy), label)
    assertReportCount(report, "lowering_rule_import_import_buffer_count", texpr.TypedExprLoweringRuleCountImportKind(rules, texpr.TypedExprImportImportBuffer), label)
    assertReportCount(report, "lowering_rule_import_builtin_address_slot_count", texpr.TypedExprLoweringRuleCountImportKind(rules, texpr.TypedExprImportBuiltinAddressSlot), label)
    assertReportCount(report, "lowering_rule_import_i32_value_slot_count", texpr.TypedExprLoweringRuleCountImportKind(rules, texpr.TypedExprImportI32ValueSlot), label)
    assertReportCount(report, "lowering_rule_import_i32_address_slot_count", texpr.TypedExprLoweringRuleCountImportKind(rules, texpr.TypedExprImportI32AddressSlot), label)
    assertReportCount(report, "lowering_rule_type_call_none_count", texpr.TypedExprLoweringRuleCountTypeCallKind(rules, texpr.TypedExprTypeCallNone), label)
    assertReportCount(report, "lowering_rule_type_call_default_init_count", texpr.TypedExprLoweringRuleCountTypeCallKind(rules, texpr.TypedExprTypeCallDefaultInit), label)
    assertReportCount(report, "lowering_rule_type_call_constructor_count", texpr.TypedExprLoweringRuleCountTypeCallKind(rules, texpr.TypedExprTypeCallConstructor), label)
    assertReportCount(report, "lowering_rule_return_root_count", texpr.TypedExprLoweringRuleReturnRootCount(rules), label)
    assert(reportFieldValue(report, "lowering_rule_report_mode") == "summary_v2",
           strutil.Join([label, " report mode"], ""))
    assert(reportFieldValue(report, "lowering_rule_entries_materialized") == "0",
           strutil.Join([label, " entries materialized"], ""))
    assert(!chengpath.TextContains(report, "lowering_rule_entry["),
           strutil.Join([label, " no materialized entries"], ""))

fn resolvedCallOracleCount(facts: var ccsg.TypedExprFactTable): int32 =
    var count: int32
    for i in 0..<facts.count:
        let fact = texpr.TypedExprFactAt(facts, i)
        if fact.lineNumber > 0 && fact.callResolved && fact.callTarget != "":
            count = count + 1
    return count

fn buildLinkPlan(workspaceRoot: str,
                 packageRoot: str,
                 sourcePath: str,
                 outputPath: str,
                 emitKind: int32): slplan.SystemLinkPlanStub =
    let req = creq.CompilerRequestNew(
        packageRoot,
        sourcePath,
        outputPath,
        "arm64-apple-darwin",
        emitKind,
        ""
    )
    var linkPlan: slplan.SystemLinkPlanStub
    var err = ""
    assert(slplan.BuildSystemLinkPlanStub(workspaceRoot, req, linkPlan, err),
           " lowering matrix: link plan")
    return linkPlan

fn main(): int32 =
    let workspaceRoot: str = chengpath.PathCurrentDir()
    let packageRoot: str = workspaceRoot
    let smokeLabel: str = os.GetEnvDefault("CHENG_SMOKE_LABEL", "host")
    let outDir: str = chengpath.PathJoin(workspaceRoot, strutil.Join(["artifacts/lowering_matrix/", smokeLabel], ""))
    assert(chengpath.MkdirP(workspaceRoot, outDir), " lowering matrix: mkdir")
    let fixturePath: str = chengpath.PathJoin(packageRoot, "src/tests/lowering_matrix_fixture.cheng")
    let outputPath: str = chengpath.PathJoin(outDir, "lowering_matrix_fixture")
    let linkPlan = buildLinkPlan(workspaceRoot,
                                 packageRoot,
                                 fixturePath,
                                 outputPath,
                                 creq.EmitShared)
    let sourceBundleRes = slplan.SystemLinkPlanSourceBundleCid(linkPlan)
    assert(IsOk(sourceBundleRes), " lowering matrix: source bundle")
    let sourceBundleCid = Value(sourceBundleRes)
    let csgRes = ccsg.BuildCompilerCsg(linkPlan, sourceBundleCid)
    assert(IsOk(csgRes), " lowering matrix: compiler csg")
    let csg = ccsg.CompilerCsgClone(Value(csgRes))
    var csgOracleLayer: parser.NormalizedExprLayer
    var csgOracleFacts = buildOracleFacts(workspaceRoot,
                                          packageRoot,
                                          linkPlan,
                                          csgOracleLayer,
                                          " lowering matrix: csg oracle")
    assert(csg.typedExprFacts.count == 0, " lowering matrix: csg legacy facts released")
    assert(csg.typedExprFactCountSnapshot == csgOracleFacts.count,
           " lowering matrix: csg fact snapshot")
    assert(csg.semanticGraph.typedFactTable.sourceIndexes.len == csgOracleFacts.count,
           " lowering matrix: csg fact count")
    assert(csg.semanticGraph.resolvedCallTable.sourcePathIds.len == resolvedCallOracleCount(csgOracleFacts),
           " lowering matrix: csg resolved call snapshot")
    var err = ""
    var plan: lower.LoweringPlanStub
    assert(lower.BuildLoweringPlanStub(linkPlan, plan, err),
           " lowering matrix: lowering plan")
    var planOracleLayer: parser.NormalizedExprLayer
    var planOracleFacts = buildOracleFacts(workspaceRoot,
                                           packageRoot,
                                           linkPlan,
                                           planOracleLayer,
                                           " lowering matrix: plan oracle")
    assert(plan.typedExprFacts.count == 0, " lowering matrix: plan legacy facts released")
    assert(plan.typedExprFactCountSnapshot == planOracleFacts.count,
           " lowering matrix: plan fact snapshot")
    assert(lower.LoweringResolvedCallFactSnapshotBound(plan),
           " lowering matrix: plan resolved calls bound")
    assert(lower.LoweringResolvedCallFactSnapshotEntryCount(plan) == resolvedCallOracleCount(planOracleFacts),
           " lowering matrix: plan resolved call snapshot")
    let fixtureFacts = texpr.TypedExprFactsForSource(csgOracleFacts, fixturePath)
    let fixtureRules = texpr.TypedExprLoweringRulesFromFacts(fixtureFacts)
    let planFacts = texpr.TypedExprFactsForSource(planOracleFacts, fixturePath)
    let planRules = texpr.TypedExprLoweringRulesFromFacts(planFacts)
    let csgAllRules = texpr.TypedExprLoweringRulesFromFacts(csgOracleFacts)
    let planAllRules = texpr.TypedExprLoweringRulesFromFacts(planOracleFacts)
    let csgReport = ccsg.CompilerCsgReport(csg)
    let planReport = lower.LoweringPlanStubReport(plan)
    assert(fixtureRules.len > 0, " lowering matrix: fixture rules")
    assert(texpr.TypedExprLoweringRulesEqual(fixtureRules, planRules),
           " lowering matrix: compiler csg vs lowering plan")
    assert(texpr.TypedExprLoweringRuleUniqueShapeCount(fixtureRules) ==
           texpr.TypedExprLoweringRuleUniqueKeyCount(fixtureRules),
           " lowering matrix: rule shape count vs key count")
    assert(chengpath.TextContains(csgReport, "lowering_rule_arg_address_count="),
           " lowering matrix: csg address arg key")
    assert(chengpath.TextContains(planReport, "lowering_rule_arg_address_count="),
           " lowering matrix: plan address arg key")
    assert(reportFieldValue(csgReport, "lowering_rule_unique_key_count") ==
           reportFieldValue(planReport, "lowering_rule_unique_key_count"),
           " lowering matrix: report unique key count")
    assert(chengpath.TextContains(csgReport, texpr.TypedExprFactsReportText(csgOracleFacts)),
           " lowering matrix: csg typed aggregate report")
    assert(chengpath.TextContains(planReport, texpr.TypedExprFactsReportText(planOracleFacts)),
           " lowering matrix: plan typed aggregate report")
    assertLoweringAggregateReport(csgReport, csgAllRules, " lowering matrix: csg aggregate")
    assertLoweringAggregateReport(planReport, planAllRules, " lowering matrix: plan aggregate")
    assert(!chengpath.TextContains(planReport, "lowering_rule_arg_address_count=0\n"),
           " lowering matrix: address arg rule")
    assert(!chengpath.TextContains(planReport, "lowering_rule_arg_call_result_address_count=0\n"),
           " lowering matrix: call-result address arg rule")
    assert(!chengpath.TextContains(planReport, "lowering_rule_arg_value_count=0\n"),
           " lowering matrix: value arg rule")
    assert(!chengpath.TextContains(planReport, "lowering_rule_result_reg_count=0\n"),
           " lowering matrix: reg result rule")
    assert(!chengpath.TextContains(planReport, "lowering_rule_result_local_address_count=0\n"),
           " lowering matrix: local-address result rule")
    assert(!chengpath.TextContains(planReport, "lowering_rule_result_sret_count=0\n"),
           " lowering matrix: sret result rule")
    assert(!chengpath.TextContains(planReport, "lowering_rule_materialize_register_count=0\n"),
           " lowering matrix: register materialize rule")
    assert(!chengpath.TextContains(planReport, "lowering_rule_materialize_local_slot_count=0\n"),
           " lowering matrix: local-slot materialize rule")
    assert(!chengpath.TextContains(planReport, "lowering_rule_materialize_call_result_local_count=0\n"),
           " lowering matrix: call-result local materialize rule")
    assert(!chengpath.TextContains(planReport, "lowering_rule_materialize_dest_address_count=0\n"),
           " lowering matrix: dest-address materialize rule")
    assert(!chengpath.TextContains(planReport, "lowering_rule_copy_scalar_store_count=0\n"),
           " lowering matrix: scalar-store copy rule")
    assert(!chengpath.TextContains(planReport, "lowering_rule_copy_region_copy_count=0\n"),
           " lowering matrix: region-copy rule")
    assert(!chengpath.TextContains(planReport, "lowering_rule_import_builtin_address_slot_count=0\n"),
           " lowering matrix: builtin address import rule")
    assert(!chengpath.TextContains(planReport, "lowering_rule_import_i32_value_slot_count=0\n"),
           " lowering matrix: value-slot import rule")
    assert(!chengpath.TextContains(planReport, "lowering_rule_import_i32_address_slot_count=0\n"),
           " lowering matrix: address-slot import rule")
    echo(" lowering_matrix_smoke ok")
    return 0
