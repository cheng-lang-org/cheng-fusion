import core/tooling/path as chengpath

fn main(): int32 =
    let root = "."
    let rel = "artifacts/pure_cheng_bootstrap_audit/cold_x64_intrinsics_conformance.roundtrip.txt"
    let joined = chengpath.PathJoin(root, rel)
    if joined == "":
        return 31
    if !chengpath.WriteTextFile("", joined, "roundtrip-ok"):
        return 40
    let text = chengpath.ReadTextFile("", joined)
    if text != "roundtrip-ok":
        return 41
    return 77
