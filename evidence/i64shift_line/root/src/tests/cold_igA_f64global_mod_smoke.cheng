const
    probeNegThreshold = -10.0
    probePosPenalty = 4.0

var
    probeThreshold: float64 = probeNegThreshold
    probeCounter: int32

fn probeSetThreshold(v: float64) =
    probeThreshold = v

fn probeGetThreshold(): float64 =
    return probeThreshold

fn probeReset() =
    probeCounter = 0
    probeThreshold = probeNegThreshold

fn probeIsBelow(v: float64): bool =
    return v <= probeThreshold
