# Repro V2: field-store + append to a LOCAL struct field DIRECTLY (no function-call layer).
# add(node.a, ...) passes &node.a (FIELD_REF on SLOT_OBJECT local) to add's var T[] param.
# If V2 works -> field-store + &localField append is fine; repro_F bug is the function-call layer.
import std/json as json
import std/os as os

fn main(): int32 =
    var node: json.JsonNode
    node.kind = json.JArray
    var items: json.JsonNode[]
    node.a = items
    add(node.a, json.NewJInt(1))
    os.WriteLine(os.Get_stdout(), "V2-ok")
    return 0
