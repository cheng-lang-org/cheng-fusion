fn assertLoopBackedgeFixedPoint() =
    var body = buildBody(true)
    let expectedRoot =
        layout.FixedBytes32Copy(
            body.manualConsume.rootCid)
    let targetSlot =
        body.manualConsume.targetOwnerSlotIds[0]

    var enterLoop: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(enterLoop)
    enterLoop.kind = coreir.BodyTermBrTag
    enterLoop.trueBlock = 1
    body.terms[0] = enterLoop
    let enterLoopTerm: int32 = 0

    var loopBranch: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(loopBranch)
    loopBranch.kind = coreir.BodyTermCbrTag
    loopBranch.conditionKind =
        coreir.BodyCondLocalNonZeroTag
    loopBranch.lhsSlot = targetSlot
    loopBranch.trueBlock = 1
    loopBranch.falseBlock = 2
    let loopBranchTerm =
        coreir.BodyIRAppendTerm(body, loopBranch)

    var loopReturn: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(loopReturn)
    loopReturn.kind = coreir.BodyTermReturnTag
    let loopReturnTerm =
        coreir.BodyIRAppendTerm(body, loopReturn)

    body.blocks[0].opStart = 0
    body.blocks[0].opCount = 1
    body.blocks[0].termIndex = enterLoopTerm
    let _ = coreir.BodyIRAppendBlock(
        body, 1, 0, loopBranchTerm)
    let _ = coreir.BodyIRAppendBlock(
        body, 1, 0, loopReturnTerm)
    for _ in 1..<3:
        add(body.blockScopeIds, 0)

    body.termSuccessorStarts[0] = 0
    body.termSuccessorCounts[0] = 1
    add(body.successorBlockIds, 1)
    add(body.successorEdgeKinds,
        coreir.BodyControlEdgeNormal)

    add(body.termSuccessorStarts, 1)
    add(body.termSuccessorCounts, 2)
    add(body.successorBlockIds, 1)
    add(body.successorEdgeKinds,
        coreir.BodyControlEdgeLoopBack)
    add(body.successorBlockIds, 2)
    add(body.successorEdgeKinds,
        coreir.BodyControlEdgeNormal)

    add(body.termSuccessorStarts, 3)
    add(body.termSuccessorCounts, 0)
    assert(coreir.BodyIRControlFlowShapeValid(body),
           "manual consume BodyIR smoke: loop CFG shape")

    var table = access.BodyIrAccessDecode(body)
    assert(access.BodyIrAccessTableIsValid(table) &&
           access.BodyIrAccessManualConsumeExactValidateAgainst(
               body, table, expectedRoot),
           "manual consume BodyIR smoke: loop fixed point")
    let released = lifecycle.BodyIrPayloadRelease(body)
    assert(released.storageReleased,
           "manual consume BodyIR smoke: loop release")

