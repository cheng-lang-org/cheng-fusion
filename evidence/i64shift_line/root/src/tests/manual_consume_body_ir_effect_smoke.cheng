fn assertDiamondAmbiguousJoinRejected(
        ): ManualConsumeMutationProof =
    var body = buildBody(true)
    let targetSlot =
        body.manualConsume.targetOwnerSlotIds[0]
    let sourceSlot =
        body.manualConsume.sourcePlaceSlotIds[0]

    var copy: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(copy)
    copy.kind = coreir.BodyOpCopyLocalTag
    copy.target = targetSlot
    add(copy.operands, sourceSlot)
    let copyOpIndex =
        coreir.BodyIRAppendOp(body, copy)

    var branch: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(branch)
    branch.kind = coreir.BodyTermCbrTag
    branch.conditionKind =
        coreir.BodyCondLocalNonZeroTag
    branch.lhsSlot = targetSlot
    branch.trueBlock = 1
    branch.falseBlock = 2
    body.terms[0] = branch
    let branchTerm: int32 = 0

    var trueJoin: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(trueJoin)
    trueJoin.kind = coreir.BodyTermBrTag
    trueJoin.trueBlock = 3
    let trueJoinTerm =
        coreir.BodyIRAppendTerm(body, trueJoin)

    var falseJoin: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(falseJoin)
    falseJoin.kind = coreir.BodyTermBrTag
    falseJoin.trueBlock = 3
    let falseJoinTerm =
        coreir.BodyIRAppendTerm(body, falseJoin)

    var joinReturn: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(joinReturn)
    joinReturn.kind = coreir.BodyTermReturnTag
    let joinReturnTerm =
        coreir.BodyIRAppendTerm(body, joinReturn)

    body.blocks[0].opStart = 0
    body.blocks[0].opCount = 0
    body.blocks[0].termIndex = branchTerm
    let _ = coreir.BodyIRAppendBlock(
        body, 0, 1, trueJoinTerm)
    let _ = coreir.BodyIRAppendBlock(
        body, 1, 0, falseJoinTerm)
    let _ = coreir.BodyIRAppendBlock(
        body, 1, 1, joinReturnTerm)
    for _ in 1..<4:
        add(body.blockScopeIds, 0)

    body.termSuccessorStarts[0] = 0
    body.termSuccessorCounts[0] = 2
    add(body.successorBlockIds, 1)
    add(body.successorEdgeKinds,
        coreir.BodyControlEdgeNormal)
    add(body.successorBlockIds, 2)
    add(body.successorEdgeKinds,
        coreir.BodyControlEdgeNormal)

    add(body.termSuccessorStarts, 2)
    add(body.termSuccessorCounts, 1)
    add(body.successorBlockIds, 3)
    add(body.successorEdgeKinds,
        coreir.BodyControlEdgeNormal)

    add(body.termSuccessorStarts, 3)
    add(body.termSuccessorCounts, 1)
    add(body.successorBlockIds, 3)
    add(body.successorEdgeKinds,
        coreir.BodyControlEdgeNormal)

    add(body.termSuccessorStarts, 4)
    add(body.termSuccessorCounts, 0)
    assert(coreir.BodyIRControlFlowShapeValid(body),
           "manual consume BodyIR smoke: diamond CFG shape")

    var table = access.BodyIrAccessDecode(body)
    let proof = manualConsumeMutationAccessProofAt(
        table,
        access.BodyIrAccessSiteOp,
        copyOpIndex,
        sourceSlot)
    let released = lifecycle.BodyIrPayloadRelease(body)
    assert(released.storageReleased,
           "manual consume BodyIR smoke: diamond release")
    return proof

