fn assertTwoCallExactFacts() =
    var body = buildBodyWithCallCount(true, 2)
    let expectedRoot =
        layout.FixedBytes32Copy(
            body.manualConsume.rootCid)
    var table = access.BodyIrAccessDecode(body)
    assert(access.BodyIrAccessManualConsumeExactValidateAgainst(
               body, table, expectedRoot) &&
           access.BodyIrAccessManualConsumeRowForCall(
               table, 0) == 0 &&
           access.BodyIrAccessManualConsumeRowForCall(
               table, 1) == 1,
           "manual consume BodyIR smoke: two-call index")
    for row in 0..<2:
        let targetFact =
            access.BodyIrAccessManualConsumeTargetFactIndex(
                table, row)
        let sourceFact =
            access.BodyIrAccessManualConsumeSourceFactIndex(
                table, row)
        let postFact =
            access.BodyIrAccessManualConsumePostDefinitionFactIndex(
                table, row)
        assert(targetFact >= 0 && sourceFact >= 0 &&
               postFact >= 0 &&
               table.facts[targetFact].consumesDefinition &&
               table.facts[sourceFact].consumesDefinition &&
               !table.facts[postFact].consumesDefinition &&
               table.facts[postFact].definitionDomain ==
                   coreir.BodyDefinitionDomainManualConsumePostCallTag &&
               table.facts[postFact].definitionRow == row,
               "manual consume BodyIR smoke: exact consume publish facts")
    assert(table.facts[
               access.BodyIrAccessManualConsumeTargetFactIndex(
                   table, 1)].definitionDomain ==
               coreir.BodyDefinitionDomainManualConsumePostCallTag &&
           table.facts[
               access.BodyIrAccessManualConsumeTargetFactIndex(
                   table, 1)].definitionRow == 0,
           "manual consume BodyIR smoke: post definition reuse")
    var secondTable = access.BodyIrAccessDecode(body)
    assert(access.BodyIrAccessTableIsValid(secondTable) &&
           access.BodyIrAccessManualConsumeExactValidateAgainst(
               body, secondTable, expectedRoot),
           "manual consume BodyIR smoke: borrow preservation")
    let released = lifecycle.BodyIrPayloadRelease(body)
    assert(released.storageReleased,
           "manual consume BodyIR smoke: two-call release")

fn runPositive(): int32 =
    var body = buildBody(true)
    assert(coreir.BodyIRManualConsumeSidecarShapeValid(body),
           "manual consume BodyIR smoke: source shape")
    let sourceRoot = coreir.BodyIRManualConsumeSidecarCid(body)
    assert(layout.FixedBytes32Equal(
               sourceRoot, body.manualConsume.rootCid),
           "manual consume BodyIR smoke: source root")
    let dod = coreir.BodyIRDodSoAContractCheck(body)
    assert(dod.ok && dod.independentArrayCount == 63 &&
           dod.nestedPayloadArrayCount == 1,
           "manual consume BodyIR smoke: DOD contract")
    var accessTable = access.BodyIrAccessDecode(body)
    assert(access.BodyIrAccessTableIsValid(accessTable),
           "manual consume BodyIR smoke: access admission")
    var managedBodyOpCount: int32
    for opIndex in 0..<body.ops.len:
        if body.ops[opIndex].valueDefOwnership !=
               coreir.OwnInvalid:
            managedBodyOpCount = managedBodyOpCount + 1
    assert(managedBodyOpCount == 0,
           "manual consume BodyIR smoke: expected no managed BodyOp")
    assert(access.BodyIrAccessManualConsumeExactValidateAgainst(
               body, accessTable, sourceRoot),
           "manual consume BodyIR smoke: exact access authority")
    assert(coreir.BodyIRManualConsumeSidecarShapeValid(body),
           "manual consume BodyIR smoke: access preserved sidecar")
    let targetConsumeFact =
        access.BodyIrAccessManualConsumeTargetFactIndex(
            accessTable, 0)
    let sourceConsumeFact =
        access.BodyIrAccessManualConsumeSourceFactIndex(
            accessTable, 0)
    let postDefinitionFact =
        access.BodyIrAccessManualConsumePostDefinitionFactIndex(
            accessTable, 0)
    assert(targetConsumeFact >= 0 &&
           sourceConsumeFact >= 0 &&
           postDefinitionFact >= 0 &&
           accessTable.facts[
               targetConsumeFact].consumesDefinition &&
           accessTable.facts[
               sourceConsumeFact].consumesDefinition &&
           accessTable.facts[
               postDefinitionFact].definitionDomain ==
               coreir.BodyDefinitionDomainManualConsumePostCallTag,
           "manual consume BodyIR smoke: consume publish facts")

    var encoded =
        codec.Backend2BodyIrEncodeExpectedManualConsumeAuthority(
            body, sourceRoot)
    var cursor: int32
    var decoded =
        codec.Backend2BodyIrDecodeExpectedManualConsumeAuthority(
            encoded, cursor, typeArenaCid(), sourceRoot)
    assert(cursor == rawbytes.BytesLen(encoded) &&
           coreir.BodyIRManualConsumeSidecarShapeValid(decoded) &&
           layout.FixedBytes32Equal(
               decoded.manualConsume.rootCid, sourceRoot) &&
           decoded.manualConsume.callOrdinals.len == 1 &&
           decoded.manualConsume.postDefinitionRows[0] == 0,
           "manual consume BodyIR smoke: codec 14 round trip")
    rawbytes.BytesFree(encoded)

    var cloned =
        coreir.BodyIRManualConsumeSidecarClone(body.manualConsume)
    var movedBody = buildBody(false)
    coreir.BodyIRManualConsumeSidecarMoveInto(
        movedBody.manualConsume, cloned)
    assert(coreir.BodyIRManualConsumeSidecarIsCanonicalEmpty(cloned) &&
           !coreir.BodyIRManualConsumeSidecarHasPhysicalStorage(cloned) &&
           coreir.BodyIRManualConsumeSidecarShapeValid(movedBody) &&
           layout.FixedBytes32Equal(
               movedBody.manualConsume.rootCid, sourceRoot),
           "manual consume BodyIR smoke: clone move")

    var ordinaryBody = buildBody(false)
    var ordinaryBytes = codec.Backend2BodyIrEncode(ordinaryBody)
    var ordinaryCursor: int32
    var ordinaryDecoded =
        codec.Backend2BodyIrDecode(ordinaryBytes, ordinaryCursor)
    assert(ordinaryCursor == rawbytes.BytesLen(ordinaryBytes) &&
           coreir.BodyIRManualConsumeSidecarIsCanonicalEmpty(
               ordinaryDecoded.manualConsume) &&
           ordinaryDecoded.ops.len == 1 &&
           ordinaryDecoded.callSequence.len == 1,
           "manual consume BodyIR smoke: ordinary call unchanged")
    rawbytes.BytesFree(ordinaryBytes)

    let retained = lifecycle.BodyIrPayloadRetained(decoded)
    assert(retained.physicalBufferCount > 20 &&
           retained.retainedBytes > int64(0),
           "manual consume BodyIR smoke: retained payload")
    let decodedRelease = lifecycle.BodyIrPayloadRelease(decoded)
    let movedRelease = lifecycle.BodyIrPayloadRelease(movedBody)
    let ordinaryRelease = lifecycle.BodyIrPayloadRelease(ordinaryBody)
    let ordinaryDecodedRelease =
        lifecycle.BodyIrPayloadRelease(ordinaryDecoded)
    let sourceRelease = lifecycle.BodyIrPayloadRelease(body)
    assert(decodedRelease.storageReleased &&
           movedRelease.storageReleased &&
           ordinaryRelease.storageReleased &&
           ordinaryDecodedRelease.storageReleased &&
           sourceRelease.storageReleased,
           "manual consume BodyIR smoke: physical release")

    assertLoopBackedgeFixedPoint()

    var mutationReceipt: ManualConsumeMutationReceipt
    manualConsumeMutationRecord(
        mutationReceipt, "call-ordinal",
        assertRejectedMutation("call-ordinal"))
    manualConsumeMutationRecord(
        mutationReceipt, "target-argument",
        assertRejectedMutation("target-argument"))
    manualConsumeMutationRecord(
        mutationReceipt, "target-owner",
        assertRejectedMutation("target-owner"))
    manualConsumeMutationRecord(
        mutationReceipt, "target-definition-domain",
        assertRejectedMutation("target-definition-domain"))
    manualConsumeMutationRecord(
        mutationReceipt, "source-definition-row",
        assertRejectedMutation("source-definition-row"))
    manualConsumeMutationRecord(
        mutationReceipt, "post-definition-row",
        assertRejectedMutation("post-definition-row"))
    manualConsumeMutationRecord(
        mutationReceipt, "target-type",
        assertRejectedMutation("target-type"))
    manualConsumeMutationRecord(
        mutationReceipt, "target-storage",
        assertRejectedMutation("target-storage"))
    manualConsumeMutationRecord(
        mutationReceipt, "source-ownership",
        assertRejectedMutation("source-ownership"))
    manualConsumeMutationRecord(
        mutationReceipt, "function-proof-rehash",
        assertRejectedMutation("function-proof-rehash"))
    manualConsumeMutationRecord(
        mutationReceipt, "target-binding-rehash",
        assertRejectedMutation("target-binding-rehash"))
    manualConsumeMutationRecord(
        mutationReceipt, "source-binding-rehash",
        assertRejectedMutation("source-binding-rehash"))
    manualConsumeMutationRecord(
        mutationReceipt, "target-projection-rehash",
        assertRejectedMutation("target-projection-rehash"))
    manualConsumeMutationRecord(
        mutationReceipt, "source-projection-rehash",
        assertRejectedMutation("source-projection-rehash"))
    manualConsumeMutationRecord(
        mutationReceipt, "effect-rehash",
        assertRejectedMutation("effect-rehash"))
    manualConsumeMutationRecord(
        mutationReceipt, "token-rehash",
        assertRejectedMutation("token-rehash"))
    manualConsumeMutationRecord(
        mutationReceipt, "snapshot-call-rehash",
        assertRejectedMutation("snapshot-call-rehash"))
    manualConsumeMutationRecord(
        mutationReceipt, "semantic-call-rehash",
        assertRejectedMutation("semantic-call-rehash"))
    manualConsumeMutationRecord(
        mutationReceipt, "bridge-rehash",
        assertRejectedMutation("bridge-rehash"))
    manualConsumeMutationRecord(
        mutationReceipt, "call-pair-second-consume",
        assertRejectedMutation("call-pair-second-consume"))
    manualConsumeMutationRecord(
        mutationReceipt, "op-pair-second-consume",
        assertRejectedMutation("op-pair-second-consume"))
    manualConsumeMutationRecord(
        mutationReceipt, "term-pair-second-consume",
        assertRejectedMutation("term-pair-second-consume"))
    manualConsumeMutationRecord(
        mutationReceipt, "whole-table-rehash",
        assertRejectedMutation("whole-table-rehash"))
    manualConsumeMutationRecord(
        mutationReceipt, "linear-token-zero",
        assertRejectedMutation("linear-token-zero"))
    manualConsumeMutationRecord(
        mutationReceipt, "unsealed-payload",
        assertRejectedMutation("unsealed-payload"))
    manualConsumeMutationRecord(
        mutationReceipt, "deleted-table",
        assertDeletedTableRejected())
    manualConsumeMutationRecord(
        mutationReceipt, "duplicate-row",
        assertDuplicateRowRejected())
    manualConsumeMutationRecord(
        mutationReceipt, "reordered-rows",
        assertReorderedRowsRejected())
    manualConsumeMutationRecord(
        mutationReceipt, "duplicate-snapshot-call",
        assertDuplicateSnapshotCallRejected())
    manualConsumeMutationRecord(
        mutationReceipt, "duplicate-semantic-call",
        assertDuplicateSemanticCallRejected())
    manualConsumeMutationRecord(
        mutationReceipt, "future-post-definition",
        assertFuturePostDefinitionRejected())
    manualConsumeMutationRecord(
        mutationReceipt, "future-body-op-definition",
        assertFutureBodyOpDefinitionRejected())
    manualConsumeMutationRecord(
        mutationReceipt, "duplicate-target-definition",
        assertDuplicateTargetConsumeIdentityRejected())
    manualConsumeMutationRecord(
        mutationReceipt, "duplicate-source-definition",
        assertDuplicateSourceConsumeIdentityRejected())
    manualConsumeMutationRecord(
        mutationReceipt, "prior-source-current-target",
        assertPriorSourceCurrentTargetRejected())
    manualConsumeMutationRecord(
        mutationReceipt, "prior-target-current-source",
        assertPriorTargetCurrentSourceRejected())
    manualConsumeMutationRecord(
        mutationReceipt, "target-borrow-shared",
        assertTargetOwnerCapabilityRejected(
            coreir.OwnBorrowShared))
    manualConsumeMutationRecord(
        mutationReceipt, "target-plain",
        assertTargetOwnerCapabilityRejected(
            coreir.OwnPlain))
    manualConsumeMutationRecord(
        mutationReceipt, "ordinary-use-after-manual-consume",
        assertOrdinaryUseAfterManualConsumeRejected())
    manualConsumeMutationRecord(
        mutationReceipt, "manual-target-second-definition",
        assertManualTargetSecondDefinitionRejected())
    manualConsumeMutationRecord(
        mutationReceipt, "diamond-ambiguous-join",
        assertDiamondAmbiguousJoinRejected())
    manualConsumeMutationRecord(
        mutationReceipt, "unreachable-manual-row",
        assertUnreachableManualRowRejected())
    manualConsumeMutationRecord(
        mutationReceipt, "sibling-branch-post-definition",
        assertSiblingBranchPostDefinitionRejected())
    assert(mutationReceipt.labels.len == 43,
           "manual consume BodyIR smoke: mutation receipt count")
    let mutationReceiptCid =
        manualConsumeMutationReceiptCid(mutationReceipt)
    assertTwoCallExactFacts()
    echo("manual_consume_body_ir_effect_positive=1")
    echo("manual_consume_body_ir_effect_mutations_rejected=43")
    echo(Fmt"manual_consume_body_ir_effect_mutation_receipt_cid={layout.FixedBytes32Hex(mutationReceiptCid)}")
    echo("manual_consume_body_ir_effect_two_call_rows=2")
    echo("manual_consume_body_ir_effect_no_managed_body_op=1")
    echo("manual_consume_body_ir_effect_borrow_preservation_decodes=2")
    echo("manual_consume_body_ir_effect_loop_backedge_fixed_point=1")
    echo("manual_consume_body_ir_effect_cfg_authority=body_ir_access_exact_definition_fixed_point")
    echo("manual_consume_body_ir_effect_smoke: ok")
    return 0

fn runCodecFieldCountMutation(fieldCount: int32): int32 =
    var body = buildBody(true)
    var encoded = codec.Backend2BodyIrEncode(body)
    codec.Backend2CodecPutU32(encoded, 4, fieldCount)
    var cursor: int32
    let _ = codec.Backend2BodyIrDecode(encoded, cursor)
    echo("manual_consume_body_ir_effect_old_codec_field_count_survived")
    return 1

fn codecU32At(bytes: rawbytes.Bytes, offset: int32): int32 =
    var cursor = offset
    return codec.Backend2CodecReadU32(bytes, cursor)

fn manualConsumeTagOffset(
        bytes: rawbytes.Bytes): int32 =
    var found: int32 = -1
    for offset in 0..<(rawbytes.BytesLen(bytes) - 24):
        if codecU32At(bytes, offset) == 14 &&
           codecU32At(bytes, offset + 4) == 1 &&
           codecU32At(bytes, offset + 8) == 1 &&
           codecU32At(bytes, offset + 12) == 101 &&
           codecU32At(bytes, offset + 16) == 0 &&
           codecU32At(bytes, offset + 20) == 1:
            assert(found == -1,
                   "manual consume BodyIR smoke: duplicate tag signature")
            found = offset
    assert(found >= 0,
           "manual consume BodyIR smoke: tag signature missing")
    return found

fn bytesDeleteRange(
        bytes: rawbytes.Bytes,
        offset: int32,
        count: int32): rawbytes.Bytes =
    var prefix = rawbytes.BytesSlice(bytes, 0, offset)
    var suffix = rawbytes.BytesSlice(
        bytes, offset + count,
        rawbytes.BytesLen(bytes) - offset - count)
    let out = rawbytes.BytesConcat(prefix, suffix)
    rawbytes.BytesFree(prefix)
    rawbytes.BytesFree(suffix)
    return out

fn bytesDuplicateRange(
        bytes: rawbytes.Bytes,
        offset: int32,
        count: int32): rawbytes.Bytes =
    var prefix = rawbytes.BytesSlice(bytes, 0, offset)
    var duplicate = rawbytes.BytesSlice(
        bytes, offset, count)
    var suffix = rawbytes.BytesSlice(
        bytes, offset,
        rawbytes.BytesLen(bytes) - offset)
    let out = rawbytes.BytesConcat3(
        prefix, duplicate, suffix)
    rawbytes.BytesFree(prefix)
    rawbytes.BytesFree(duplicate)
    rawbytes.BytesFree(suffix)
    return out

fn runCodecPayloadMutation(mutation: str): int32 =
    var body = buildBody(true)
    let expectedRoot =
        layout.FixedBytes32Copy(
            body.manualConsume.rootCid)
    var encoded =
        codec.Backend2BodyIrEncodeExpectedManualConsumeAuthority(
            body, expectedRoot)
    let tagOffset = manualConsumeTagOffset(encoded)
    var mutated: rawbytes.Bytes
    if mutation == "codec-tag-delete":
        mutated = bytesDeleteRange(encoded, tagOffset, 4)
    elif mutation == "codec-tag-duplicate":
        mutated = bytesDuplicateRange(encoded, tagOffset, 4)
    elif mutation == "codec-tag-swap":
        mutated = rawbytes.BytesSlice(
            encoded, 0, rawbytes.BytesLen(encoded))
        codec.Backend2CodecPutU32(mutated, tagOffset, 11)
        codec.Backend2CodecPutU32(
            mutated, rawbytes.BytesLen(mutated) - 36, 14)
    elif mutation == "codec-truncate":
        mutated = rawbytes.BytesSlice(
            encoded, 0, rawbytes.BytesLen(encoded) - 1)
    else:
        assert(false,
               "manual consume BodyIR smoke: unknown codec mutation")
    rawbytes.BytesFree(encoded)
    var cursor: int32
    let _ = codec.Backend2BodyIrDecode(mutated, cursor)
    echo("manual_consume_body_ir_effect_codec_mutation_survived")
    return 1

fn main(argc: int32, argv: str*): int32 =
    argc
    argv
    cmdline.CaptureCmdLine(argc, argv)
    if cmdline.ParamCount() <= 1:
        return runPositive()
    if cmdline.ParamStr(1) == "codec-field-count-13":
        return runCodecFieldCountMutation(13)
    if cmdline.ParamStr(1) == "codec-field-count-14":
        return runCodecFieldCountMutation(14)
    if cmdline.ParamStr(1) == "codec-tag-delete" ||
       cmdline.ParamStr(1) == "codec-tag-duplicate" ||
       cmdline.ParamStr(1) == "codec-tag-swap" ||
       cmdline.ParamStr(1) == "codec-truncate":
        return runCodecPayloadMutation(
            cmdline.ParamStr(1))
    echo("manual_consume_body_ir_effect_unknown_mode")
    return 2
