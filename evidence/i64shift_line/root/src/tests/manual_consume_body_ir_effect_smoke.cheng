# manual_consume_body_ir_effect_smoke — exact manual-consume BodyIR sidecar.

import std/cmdline as cmdline
import std/result
import std/rawbytes as rawbytes
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/ir/core_types as coreir
import cheng/core/ir/body_ir_access as access
import cheng/core/ir/body_ir_lifecycle as lifecycle
import cheng/core/backend2/backend2_frag_codec as codec

type
    ManualConsumeMutationProof =
        rejectionLayer: int32
        siteKind: int32 = -1
        siteIndex: int32 = -1
        detail: int32 = -1

    ManualConsumeMutationReceipt =
        labels: str[]
        rejectionLayers: int32[]
        siteKinds: int32[]
        siteIndexes: int32[]
        details: int32[]

const
    ManualConsumeRejectSidecarShape = 1
    ManualConsumeRejectAccessCfg = 2
    ManualConsumeRejectExactRoot = 3

fn manualConsumeMutationAppendI32(
        buf: var layout.ByteBuf,
        value: int32) =
    layout.ByteBufAppendByte(buf, value & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)

@borrows
fn manualConsumeMutationAppendText(
        buf: var layout.ByteBuf,
        value: str) =
    manualConsumeMutationAppendI32(buf, len(value))
    for index in 0..<len(value):
        layout.ByteBufAppendByte(buf, value[index])

fn manualConsumeMutationRecord(
        receipt: var ManualConsumeMutationReceipt,
        label: str,
        proof: ManualConsumeMutationProof) =
    add(receipt.labels, label)
    add(receipt.rejectionLayers, proof.rejectionLayer)
    add(receipt.siteKinds, proof.siteKind)
    add(receipt.siteIndexes, proof.siteIndex)
    add(receipt.details, proof.detail)

fn manualConsumeMutationShapeProof(
        rejected: bool): ManualConsumeMutationProof =
    assert(rejected,
           "manual consume BodyIR smoke: expected sidecar rejection")
    var proof: ManualConsumeMutationProof
    proof.rejectionLayer = ManualConsumeRejectSidecarShape
    return proof

fn manualConsumeMutationExactRootProof(
        rejected: bool): ManualConsumeMutationProof =
    assert(rejected,
           "manual consume BodyIR smoke: expected exact-root rejection")
    var proof: ManualConsumeMutationProof
    proof.rejectionLayer = ManualConsumeRejectExactRoot
    return proof

fn manualConsumeMutationAccessProof(
        table: var access.BodyIrAccessTable): ManualConsumeMutationProof =
    assert(!access.BodyIrAccessTableIsValid(table),
           "manual consume BodyIR smoke: expected access rejection")
    var proof: ManualConsumeMutationProof
    proof.rejectionLayer = ManualConsumeRejectAccessCfg
    proof.siteKind = table.errorSiteKind
    proof.siteIndex = table.errorSiteIndex
    proof.detail = table.errorDetail
    return proof

fn manualConsumeMutationAccessProofAt(
        table: var access.BodyIrAccessTable,
        siteKind: int32,
        siteIndex: int32,
        detail: int32): ManualConsumeMutationProof =
    assert(!access.BodyIrAccessTableIsValid(table) &&
           table.errorSiteKind == siteKind &&
           table.errorSiteIndex == siteIndex &&
           table.errorDetail == detail,
           "manual consume BodyIR smoke: exact access rejection")
    var proof: ManualConsumeMutationProof
    proof.rejectionLayer = ManualConsumeRejectAccessCfg
    proof.siteKind = table.errorSiteKind
    proof.siteIndex = table.errorSiteIndex
    proof.detail = table.errorDetail
    return proof

fn manualConsumeMutationReceiptCid(
        receipt: var ManualConsumeMutationReceipt): layout.FixedBytes32 =
    let count = receipt.labels.len
    assert(receipt.rejectionLayers.len == count &&
           receipt.siteKinds.len == count &&
           receipt.siteIndexes.len == count &&
           receipt.details.len == count,
           "manual consume BodyIR smoke: mutation receipt shape")
    var bytes: layout.ByteBuf = layout.ByteBufInit(4096)
    manualConsumeMutationAppendText(
        bytes, "cheng.manual-consume.body-ir.mutations")
    manualConsumeMutationAppendI32(bytes, count)
    for row in 0..<count:
        manualConsumeMutationAppendText(
            bytes, receipt.labels[row])
        manualConsumeMutationAppendI32(
            bytes, receipt.rejectionLayers[row])
        manualConsumeMutationAppendI32(
            bytes, receipt.siteKinds[row])
        manualConsumeMutationAppendI32(
            bytes, receipt.siteIndexes[row])
        manualConsumeMutationAppendI32(
            bytes, receipt.details[row])
    let out = hash256.Sha256Fixed(layout.ByteBufView(bytes))
    layout.ByteBufFree(bytes)
    return out

fn smokeCid(hexValue: str): layout.FixedBytes32 =
    let parsed = layout.FixedBytes32FromHex(hexValue)
    assert(IsOk(parsed), "manual consume BodyIR smoke: CID parse")
    return Value(parsed)

fn typeArenaCid(): layout.FixedBytes32 =
    return smokeCid(
        "1111111111111111111111111111111111111111111111111111111111111111")

fn callTargetCid(): layout.FixedBytes32 =
    return smokeCid(
        "2222222222222222222222222222222222222222222222222222222222222222")

fn appendParameterSlot(
        body: var coreir.BodyIR,
        name: str,
        placeKind: int32,
        ownership: coreir.OwnershipKind): int32 =
    var slot: coreir.LocalSlot
    slot.id = body.localSlots.len
    slot.name = name
    slot.typeKind = coreir.LocalAggregateTag
    slot.stackOffset = -1 - slot.id
    slot.sizeBytes = 24
    slot.alignBytes = 8
    coreir.BodyIRApplyLocalSlotDefaultProof(slot)
    slot.placeKind = placeKind
    slot.ownership = ownership
    let slotId = slot.id
    add(body.localSlots, slot)
    assert(coreir.BodyIRBindLocalSlotTypeArenaProof(
               body,
               slotId,
               typeArenaCid(),
               7,
               coreir.BodyManagedStorageManagedTag),
           "manual consume BodyIR smoke: parameter TypeArena proof")
    return slotId

fn manualCallCid(row: int32, field: int32): layout.FixedBytes32 =
    if row == 0:
        if field == 0:
            return smokeCid(
                "5555555555555555555555555555555555555555555555555555555555555555")
        if field == 1:
            return smokeCid(
                "6666666666666666666666666666666666666666666666666666666666666666")
        if field == 2:
            return smokeCid(
                "7777777777777777777777777777777777777777777777777777777777777777")
        if field == 3:
            return smokeCid(
                "8888888888888888888888888888888888888888888888888888888888888888")
        if field == 4:
            return smokeCid(
                "9999999999999999999999999999999999999999999999999999999999999999")
        if field == 5:
            return smokeCid(
                "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
        return smokeCid(
            "1010101010101010101010101010101010101010101010101010101010101010")
    if field == 0:
        return smokeCid(
            "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")
    if field == 1:
        return smokeCid(
            "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc")
    if field == 2:
        return smokeCid(
            "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd")
    if field == 3:
        return smokeCid(
            "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee")
    if field == 4:
        return smokeCid(
            "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff")
    if field == 5:
        return smokeCid(
            "1212121212121212121212121212121212121212121212121212121212121212")
    return smokeCid(
        "3434343434343434343434343434343434343434343434343434343434343434")

fn buildBodyWithCallCount(
        withManualConsume: bool,
        callCount: int32): coreir.BodyIR =
    assert(callCount == 1 || callCount == 2,
           "manual consume BodyIR smoke: call count")
    var body = coreir.BodyIRNew()
    assert(coreir.BodyIRBindCanonicalTypeFact(
               body, typeArenaCid(), 3, 4, 0, 7, 0, 8, 8),
           "manual consume BodyIR smoke: target formal type")
    assert(coreir.BodyIRBindCanonicalTypeFact(
               body, typeArenaCid(), 7, 1, 10, -1, 0, 24, 8),
           "manual consume BodyIR smoke: source type")
    let targetSlot = appendParameterSlot(
        body,
        "manual_consume_target",
        coreir.BodyPlaceParamAddressTag,
        coreir.OwnBorrowUnique)
    var sourceSlots: int32[]
    add(sourceSlots, appendParameterSlot(
        body,
        "manual_consume_source_0",
        coreir.BodyPlaceStackValueTag,
        coreir.OwnMove))
    if callCount == 2:
        add(sourceSlots, appendParameterSlot(
            body,
            "manual_consume_source_1",
            coreir.BodyPlaceStackValueTag,
            coreir.OwnMove))
    var entryDefinitionOwnershipKinds: int32[]
    add(entryDefinitionOwnershipKinds,
        int32(coreir.OwnBorrowUnique))
    for _ in 0..<sourceSlots.len:
        add(entryDefinitionOwnershipKinds,
            int32(coreir.OwnMove))
    coreir.BodyIRFreezeEntryDefinitionOwnershipKinds(
        body, entryDefinitionOwnershipKinds)

    for callOrdinal in 0..<callCount:
        var call: coreir.CallOp
        coreir.BodyIRApplyCallOpDefaultProof(call)
        call.targetSymbol = "manual_consume_fixture"
        call.semanticCallExprNodeIndex = 301 + callOrdinal
        add(call.argSlots,
            coreir.CallArgSlotAddress(targetSlot))
        add(call.argPassKinds,
            coreir.BodyCallPassBorrowAddressTag)
        add(call.argAbiSizes, 8)
        add(call.argSlots,
            coreir.CallArgSlotAddress(
                sourceSlots[callOrdinal]))
        add(call.argPassKinds,
            coreir.BodyCallPassParamAddressTag)
        add(call.argAbiSizes, 8)
        add(body.callSequence, call)

        var op: coreir.BodyOp
        coreir.BodyIRApplyBodyOpDefaultProof(op)
        op.kind = coreir.BodyOpCallTag
        add(op.operands, callOrdinal)
        let _ = coreir.BodyIRAppendOp(body, op)

    var term: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = coreir.BodyTermReturnTag
    let termIndex = coreir.BodyIRAppendTerm(body, term)
    let _ = coreir.BodyIRAppendBlock(
        body, 0, callCount, termIndex)

    coreir.BodyIRControlFlowBegin(body, 101)
    coreir.BodyIRControlFlowBindBlockScope(body, 0, 0)
    var successors: int32[]
    var edgeKinds: int32[]
    coreir.BodyIRControlFlowBindTermSuccessors(
        body, termIndex, successors, edgeKinds)
    for callOrdinal in 0..<callCount:
        coreir.BodyIRControlFlowBindCallTarget(
            body,
            callOrdinal,
            coreir.BodyCallTargetDomainFunctionTag,
            202,
            callTargetCid())
    coreir.BodyIRControlFlowSeal(body)

    if withManualConsume:
        coreir.BodyIRManualConsumeBindFunction(
            body,
            101,
            0,
            1,
            targetSlot,
            sourceSlots[0],
            3,
            7,
            smokeCid(
                "3333333333333333333333333333333333333333333333333333333333333333"),
            smokeCid(
                "4444444444444444444444444444444444444444444444444444444444444444"))
        for row in 0..<callCount:
            var effect: coreir.BodyIRManualConsumeCallEffect
            effect.callOrdinal = row
            effect.snapshotCallId = 401 + row
            effect.targetArgumentOrdinal = 0
            effect.sourceArgumentOrdinal = 1
            effect.targetPlaceSlotId = targetSlot
            effect.targetOwnerSlotId = targetSlot
            effect.sourcePlaceSlotId = sourceSlots[row]
            effect.targetArgumentBindingCid =
                manualCallCid(row, 0)
            effect.sourceArgumentBindingCid =
                manualCallCid(row, 1)
            effect.targetProjectionCid =
                manualCallCid(row, 2)
            effect.sourceProjectionCid =
                manualCallCid(row, 3)
            if row == 0:
                effect.targetDefinitionDomain =
                    coreir.BodyDefinitionDomainEntrySlotTag
                effect.targetDefinitionRow = targetSlot
            else:
                effect.targetDefinitionDomain =
                    coreir.BodyDefinitionDomainManualConsumePostCallTag
                effect.targetDefinitionRow = row - 1
            effect.sourceDefinitionDomain =
                coreir.BodyDefinitionDomainEntrySlotTag
            effect.sourceDefinitionRow = sourceSlots[row]
            effect.targetTypeArenaTypeId = 3
            effect.sourceTypeArenaTypeId = 7
            effect.postDefinitionDomain =
                coreir.BodyDefinitionDomainManualConsumePostCallTag
            effect.postDefinitionRow = row
            effect.effectCid = manualCallCid(row, 4)
            effect.linearTokenCid = manualCallCid(row, 5)
            effect.bridgeCid = manualCallCid(row, 6)
            coreir.BodyIRManualConsumeAppendCall(body, effect)
        coreir.BodyIRManualConsumeSeal(body)
    return body

fn buildBody(withManualConsume: bool): coreir.BodyIR =
    return buildBodyWithCallCount(withManualConsume, 1)

fn buildDeletedTableBody(): coreir.BodyIR =
    var body = buildBody(false)
    coreir.BodyIRManualConsumeBindFunction(
        body,
        101,
        0,
        1,
        0,
        1,
        3,
        7,
        smokeCid(
            "3333333333333333333333333333333333333333333333333333333333333333"),
        smokeCid(
            "4444444444444444444444444444444444444444444444444444444444444444"))
    coreir.BodyIRManualConsumeSeal(body)
    return body

fn swapI32Rows(values: var int32[]) =
    let first = values[0]
    values[0] = values[1]
    values[1] = first

fn swapFixed32Rows(values: var layout.FixedBytes32[]) =
    let first = layout.FixedBytes32Copy(values[0])
    values[0] = layout.FixedBytes32Copy(values[1])
    values[1] = first

fn reorderManualConsumeRows(body: var coreir.BodyIR) =
    swapI32Rows(body.manualConsume.callOrdinals)
    swapI32Rows(body.manualConsume.snapshotCallIds)
    swapI32Rows(body.manualConsume.targetArgumentOrdinals)
    swapI32Rows(body.manualConsume.sourceArgumentOrdinals)
    swapI32Rows(body.manualConsume.targetPlaceSlotIds)
    swapI32Rows(body.manualConsume.targetOwnerSlotIds)
    swapI32Rows(body.manualConsume.sourcePlaceSlotIds)
    swapFixed32Rows(
        body.manualConsume.targetArgumentBindingCids)
    swapFixed32Rows(
        body.manualConsume.sourceArgumentBindingCids)
    swapFixed32Rows(body.manualConsume.targetProjectionCids)
    swapFixed32Rows(body.manualConsume.sourceProjectionCids)
    swapI32Rows(body.manualConsume.targetDefinitionDomains)
    swapI32Rows(body.manualConsume.targetDefinitionRows)
    swapI32Rows(body.manualConsume.sourceDefinitionDomains)
    swapI32Rows(body.manualConsume.sourceDefinitionRows)
    swapI32Rows(body.manualConsume.targetTypeArenaTypeIds)
    swapI32Rows(body.manualConsume.sourceTypeArenaTypeIds)
    swapI32Rows(body.manualConsume.postDefinitionDomains)
    swapI32Rows(body.manualConsume.postDefinitionRows)
    swapFixed32Rows(body.manualConsume.effectCids)
    swapFixed32Rows(body.manualConsume.linearTokenCids)
    swapFixed32Rows(body.manualConsume.bridgeCids)

fn duplicateManualConsumeRowZero(body: var coreir.BodyIR) =
    add(body.manualConsume.callOrdinals,
        body.manualConsume.callOrdinals[0])
    add(body.manualConsume.snapshotCallIds,
        body.manualConsume.snapshotCallIds[0])
    add(body.manualConsume.targetArgumentOrdinals,
        body.manualConsume.targetArgumentOrdinals[0])
    add(body.manualConsume.sourceArgumentOrdinals,
        body.manualConsume.sourceArgumentOrdinals[0])
    add(body.manualConsume.targetPlaceSlotIds,
        body.manualConsume.targetPlaceSlotIds[0])
    add(body.manualConsume.targetOwnerSlotIds,
        body.manualConsume.targetOwnerSlotIds[0])
    add(body.manualConsume.sourcePlaceSlotIds,
        body.manualConsume.sourcePlaceSlotIds[0])
    add(body.manualConsume.targetArgumentBindingCids,
        layout.FixedBytes32Copy(
            body.manualConsume.targetArgumentBindingCids[0]))
    add(body.manualConsume.sourceArgumentBindingCids,
        layout.FixedBytes32Copy(
            body.manualConsume.sourceArgumentBindingCids[0]))
    add(body.manualConsume.targetProjectionCids,
        layout.FixedBytes32Copy(
            body.manualConsume.targetProjectionCids[0]))
    add(body.manualConsume.sourceProjectionCids,
        layout.FixedBytes32Copy(
            body.manualConsume.sourceProjectionCids[0]))
    add(body.manualConsume.targetDefinitionDomains,
        body.manualConsume.targetDefinitionDomains[0])
    add(body.manualConsume.targetDefinitionRows,
        body.manualConsume.targetDefinitionRows[0])
    add(body.manualConsume.sourceDefinitionDomains,
        body.manualConsume.sourceDefinitionDomains[0])
    add(body.manualConsume.sourceDefinitionRows,
        body.manualConsume.sourceDefinitionRows[0])
    add(body.manualConsume.targetTypeArenaTypeIds,
        body.manualConsume.targetTypeArenaTypeIds[0])
    add(body.manualConsume.sourceTypeArenaTypeIds,
        body.manualConsume.sourceTypeArenaTypeIds[0])
    add(body.manualConsume.postDefinitionDomains,
        body.manualConsume.postDefinitionDomains[0])
    add(body.manualConsume.postDefinitionRows,
        body.manualConsume.postDefinitionRows[0])
    add(body.manualConsume.effectCids,
        layout.FixedBytes32Copy(
            body.manualConsume.effectCids[0]))
    add(body.manualConsume.linearTokenCids,
        layout.FixedBytes32Copy(
            body.manualConsume.linearTokenCids[0]))
    add(body.manualConsume.bridgeCids,
        layout.FixedBytes32Copy(
            body.manualConsume.bridgeCids[0]))

fn assertRejectedMutation(
        mutation: str): ManualConsumeMutationProof =
    var body = buildBody(true)
    let expectedRoot =
        layout.FixedBytes32Copy(
            body.manualConsume.rootCid)
    var rehashesOpaqueAuthority: bool
    var accessOnlyMutation: bool
    var proof: ManualConsumeMutationProof
    if mutation == "call-ordinal":
        body.manualConsume.callOrdinals[0] = 1
    elif mutation == "target-argument":
        body.manualConsume.targetArgumentOrdinals[0] = 1
    elif mutation == "target-owner":
        body.manualConsume.targetOwnerSlotIds[0] = 1
    elif mutation == "target-definition-domain":
        body.manualConsume.targetDefinitionDomains[0] =
            coreir.BodyDefinitionDomainBodyOpTag
    elif mutation == "source-definition-row":
        body.manualConsume.sourceDefinitionRows[0] = 0
    elif mutation == "post-definition-row":
        body.manualConsume.postDefinitionRows[0] = 1
    elif mutation == "target-type":
        body.manualConsume.targetTypeArenaTypeIds[0] = 7
    elif mutation == "target-storage":
        body.localSlots[0].managedStorageKind =
            coreir.BodyManagedStorageUnmanagedTag
    elif mutation == "source-ownership":
        body.entryDefinitionOwnershipKinds[1] =
            int32(coreir.OwnBorrowShared)
    elif mutation == "function-proof-rehash":
        body.manualConsume.functionBodyProofCid =
            smokeCid(
                "1313131313131313131313131313131313131313131313131313131313131313")
        rehashesOpaqueAuthority = true
    elif mutation == "target-binding-rehash":
        body.manualConsume.targetArgumentBindingCids[0] =
            smokeCid(
                "1414141414141414141414141414141414141414141414141414141414141414")
        rehashesOpaqueAuthority = true
    elif mutation == "source-binding-rehash":
        body.manualConsume.sourceArgumentBindingCids[0] =
            smokeCid(
                "1515151515151515151515151515151515151515151515151515151515151515")
        rehashesOpaqueAuthority = true
    elif mutation == "target-projection-rehash":
        body.manualConsume.targetProjectionCids[0] =
            smokeCid(
                "1616161616161616161616161616161616161616161616161616161616161616")
        rehashesOpaqueAuthority = true
    elif mutation == "source-projection-rehash":
        body.manualConsume.sourceProjectionCids[0] =
            smokeCid(
                "1717171717171717171717171717171717171717171717171717171717171717")
        rehashesOpaqueAuthority = true
    elif mutation == "effect-rehash":
        body.manualConsume.effectCids[0] = smokeCid(
            "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")
        rehashesOpaqueAuthority = true
    elif mutation == "token-rehash":
        body.manualConsume.linearTokenCids[0] =
            smokeCid(
                "1818181818181818181818181818181818181818181818181818181818181818")
        rehashesOpaqueAuthority = true
    elif mutation == "snapshot-call-rehash":
        body.manualConsume.snapshotCallIds[0] = 777
        rehashesOpaqueAuthority = true
    elif mutation == "semantic-call-rehash":
        body.callSequence[0].semanticCallExprNodeIndex = 778
        rehashesOpaqueAuthority = true
    elif mutation == "bridge-rehash":
        body.manualConsume.bridgeCids[0] =
            smokeCid(
                "2929292929292929292929292929292929292929292929292929292929292929")
        rehashesOpaqueAuthority = true
    elif mutation == "call-pair-second-consume":
        body.callSequence[0].sourceDefinitionDomain =
            coreir.BodyDefinitionDomainEntrySlotTag
        body.callSequence[0].sourceDefinitionRow = 1
        accessOnlyMutation = true
    elif mutation == "op-pair-second-consume":
        body.ops[0].sourceDefinitionDomain =
            coreir.BodyDefinitionDomainEntrySlotTag
        body.ops[0].sourceDefinitionRow = 1
        accessOnlyMutation = true
    elif mutation == "term-pair-second-consume":
        body.terms[0].resultSlot = 1
        body.terms[0].sourceDefinitionDomain =
            coreir.BodyDefinitionDomainEntrySlotTag
        body.terms[0].sourceDefinitionRow = 1
        accessOnlyMutation = true
    elif mutation == "whole-table-rehash":
        body.manualConsume.targetArgumentBindingCids[0] =
            smokeCid(
                "1919191919191919191919191919191919191919191919191919191919191919")
        body.manualConsume.sourceArgumentBindingCids[0] =
            smokeCid(
                "2020202020202020202020202020202020202020202020202020202020202020")
        body.manualConsume.targetProjectionCids[0] =
            smokeCid(
                "2121212121212121212121212121212121212121212121212121212121212121")
        body.manualConsume.sourceProjectionCids[0] =
            smokeCid(
                "2323232323232323232323232323232323232323232323232323232323232323")
        body.manualConsume.effectCids[0] =
            smokeCid(
                "2424242424242424242424242424242424242424242424242424242424242424")
        body.manualConsume.linearTokenCids[0] =
            smokeCid(
                "2525252525252525252525252525252525252525252525252525252525252525")
        rehashesOpaqueAuthority = true
    elif mutation == "linear-token-zero":
        body.manualConsume.linearTokenCids[0] =
            layout.FixedBytes32()
    elif mutation == "unsealed-payload":
        body.manualConsume.sealed = false
    else:
        assert(false, "manual consume BodyIR smoke: unknown mutation")
    if accessOnlyMutation:
        assert(coreir.BodyIRManualConsumeSidecarShapeValid(body),
               "manual consume BodyIR smoke: pair mutation shape")
        var mutatedAccess =
            access.BodyIrAccessDecode(body)
        proof = manualConsumeMutationAccessProof(
            mutatedAccess)
    elif rehashesOpaqueAuthority:
        let mutatedRoot =
            coreir.BodyIRManualConsumeSidecarCid(body)
        assert(coreir.BodyIRTypeArenaArtifactCidValid(
                   mutatedRoot),
               "manual consume BodyIR smoke: mutated root")
        body.manualConsume.rootCid = mutatedRoot
        assert(coreir.BodyIRManualConsumeSidecarShapeValid(body),
               "manual consume BodyIR smoke: rehash shape")
        var mutatedAccess =
            access.BodyIrAccessDecode(body)
        let rejected =
            access.BodyIrAccessTableIsValid(mutatedAccess) &&
            !access.BodyIrAccessManualConsumeExactValidateAgainst(
                body, mutatedAccess, expectedRoot)
        proof = manualConsumeMutationExactRootProof(rejected)
    else:
        let rejected =
            !coreir.BodyIRManualConsumeSidecarShapeValid(body)
        proof = manualConsumeMutationShapeProof(rejected)
    let released = lifecycle.BodyIrPayloadRelease(body)
    assert(released.storageReleased,
           "manual consume BodyIR smoke: mutation release")
    return proof

fn assertDeletedTableRejected(
        ): ManualConsumeMutationProof =
    var authorityBody = buildBody(true)
    let expectedRoot =
        layout.FixedBytes32Copy(
            authorityBody.manualConsume.rootCid)
    var deletedBody = buildDeletedTableBody()
    assert(coreir.BodyIRManualConsumeSidecarShapeValid(
               deletedBody),
           "manual consume BodyIR smoke: deleted shape")
    var deletedAccess =
        access.BodyIrAccessDecode(deletedBody)
    let rejected =
        access.BodyIrAccessTableIsValid(deletedAccess) &&
        !access.BodyIrAccessManualConsumeExactValidateAgainst(
            deletedBody, deletedAccess, expectedRoot)
    let proof = manualConsumeMutationExactRootProof(rejected)
    let authorityRelease =
        lifecycle.BodyIrPayloadRelease(authorityBody)
    let deletedRelease =
        lifecycle.BodyIrPayloadRelease(deletedBody)
    assert(authorityRelease.storageReleased &&
           deletedRelease.storageReleased,
           "manual consume BodyIR smoke: deleted release")
    return proof

