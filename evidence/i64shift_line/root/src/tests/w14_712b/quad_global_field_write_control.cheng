import std/os
import std/strutils as strutil
import std/strings

type
    Quad =
        a: int32
        b: int32
        c: int32
        d: int32

var
    gQuad: Quad

fn initG() =
    gQuad.a = 1
    gQuad.b = 2
    gQuad.c = 3
    gQuad.d = 4

fn main(): int32 =
    initG()
    var local1: Quad = gQuad
    os.WriteLine(os.Get_stdout(), strutil.Join(["a=", strings.IntToStr(local1.a), " b=", strings.IntToStr(local1.b), " c=", strings.IntToStr(local1.c), " d=", strings.IntToStr(local1.d)], ""))
    return 0
