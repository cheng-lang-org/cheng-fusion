import std/os
import std/strutils as strutil
import std/strings

type
    Pair =
        a: int32
        b: int32

var
    gPair: Pair

fn initG() =
    var local: Pair
    local.a = 11
    local.b = 22
    gPair = local

fn main(): int32 =
    initG()
    let a = gPair.a
    let b = gPair.b
    os.WriteLine(os.Get_stdout(), strutil.Join(["a=", strings.IntToStr(a), " b=", strings.IntToStr(b)], ""))
    return 0
