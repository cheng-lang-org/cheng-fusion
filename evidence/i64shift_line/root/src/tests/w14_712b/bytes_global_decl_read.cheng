import std/os
import std/rawbytes
import std/strutils as strutil
import std/strings

var
    globalPrivCache: Bytes

fn initCaches() =
    var b: Bytes = BytesAlloc(3)
    BytesSet(b, 0, 9)
    BytesSet(b, 1, 8)
    BytesSet(b, 2, 7)
    globalPrivCache = b

fn main(): int32 =
    initCaches()
    var local1: Bytes = globalPrivCache
    let payloadLen = BytesLen(local1)
    os.WriteLine(os.Get_stdout(), strutil.Join(["local1_len=", strings.IntToStr(payloadLen)], ""))
    return 0
