import std/os
import std/strutils as strutil
import std/strings

type
    PtrLen =
        p: ptr
        n: int32

var
    gPL: PtrLen

fn initG() =
    gPL.p = ptr(0)
    gPL.n = 77

fn main(): int32 =
    initG()
    var local1: PtrLen = gPL
    os.WriteLine(os.Get_stdout(), strutil.Join(["n=", strings.IntToStr(local1.n)], ""))
    return 0
