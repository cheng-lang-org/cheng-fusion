# wave14-712b: 运行时值断言 repro，精确镜像
# src/quic/tls/handshake13.cheng:1259-1262 (msquicTls13ComputeSharedSecret) 的
# `state.localKeyShareGroup = <全局int32缓存>` + `state.localKeySharePriv =
# <全局Bytes缓存>` 形态 — 后者 (字段=全局聚合裸标识符读) 是 712 族根 B。
#
# 注: assert() 条件若是调用表达式 (如 `assert(BytesGet(x,0)==9, ...)`) 存在一个
# 独立的、与本修复无关的既存静默失效 (assert 未触发 exit(1))。为避免该已知陷阱
# 混淆本 repro 的真实性，所有待验证值先落进局部变量再 assert (assert 条件只含
# 裸标识符比较，已用 mutation 验证该形态可靠触发失败)。
import std/os
import std/rawbytes

type
    Holder =
        localKeyShareGroup: int32
        localKeySharePriv: Bytes

var
    globalGroupCache: int32
    globalPrivCache: Bytes

fn initCaches() =
    globalGroupCache = 29
    var b: Bytes = BytesAlloc(3)
    BytesSet(b, 0, 9)
    BytesSet(b, 1, 8)
    BytesSet(b, 2, 7)
    globalPrivCache = b

fn applyCache(state: var Holder) =
    if state.localKeyShareGroup <= 0 && BytesLen(globalPrivCache) > 0:
        state.localKeyShareGroup = globalGroupCache
        state.localKeySharePriv = globalPrivCache

fn main(): int32 =
    initCaches()
    var h: Holder
    h.localKeyShareGroup = 0
    applyCache(h)
    let group = h.localKeyShareGroup
    let plen = BytesLen(h.localKeySharePriv)
    let b0 = BytesGet(h.localKeySharePriv, 0)
    let b1 = BytesGet(h.localKeySharePriv, 1)
    let b2 = BytesGet(h.localKeySharePriv, 2)
    assert(group == 29, "w14_712b: localKeyShareGroup must adopt global cache")
    assert(plen == 3, "w14_712b: localKeySharePriv len must adopt global cache bytes")
    assert(b0 == 9, "w14_712b: byte 0 must be 9")
    assert(b1 == 8, "w14_712b: byte 1 must be 8")
    assert(b2 == 7, "w14_712b: byte 2 must be 7")
    os.WriteLine(os.Get_stdout(), "msquic_shared_secret_global_bytes_mirror: PASS")
    return 0
