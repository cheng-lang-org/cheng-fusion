import std/os
import std/strutils as strutil
import std/strings

type
    Pair =
        a: int32
        b: int32

var
    gPair: Pair

fn initG() =
    gPair.a = 11
    gPair.b = 22

fn main(): int32 =
    initG()
    var local1: Pair = gPair
    os.WriteLine(os.Get_stdout(), strutil.Join(["local1.a=", strings.IntToStr(local1.a), " local1.b=", strings.IntToStr(local1.b)], ""))
    return 0
