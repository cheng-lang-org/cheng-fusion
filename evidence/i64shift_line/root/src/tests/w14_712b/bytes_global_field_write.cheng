import std/os
import std/rawbytes
import std/strutils as strutil
import std/strings

type
    Holder =
        payload: Bytes

var
    globalPrivCache: Bytes

fn initCaches() =
    var b: Bytes = BytesAlloc(3)
    BytesSet(b, 0, 9)
    BytesSet(b, 1, 8)
    BytesSet(b, 2, 7)
    globalPrivCache = b

fn applyCache(state: var Holder) =
    state.payload = globalPrivCache

fn main(): int32 =
    initCaches()
    var h: Holder
    applyCache(h)
    let payloadLen = BytesLen(h.payload)
    os.WriteLine(os.Get_stdout(), strutil.Join(["payload_len=", strings.IntToStr(payloadLen)], ""))
    return 0
