import std/strutils as strutil

fn R24Join(a: str, b: str): str =
    var parts: str[]
    add(parts, a)
    add(parts, b)
    return strutil.Join(parts, "")

fn R24Reuse(lineRaw: str, genericPos: int32): int32 =
    let keep = R24Join("Kx", lineRaw)
    let headRaw = R24Join("head-", lineRaw)
    var head: str
    if genericPos > 0:
        head = R24Join("tag-", headRaw)
    else:
        head = headRaw
    let filler = R24Join("ZZ", lineRaw)
    return filler.len * 100000 + head.len * 1000 + keep[0]

fn main(): int32 =
    let a = R24Reuse("abcdef", 1)
    echo(strutil.Join(["a=", IntToStr(a)], ""))
    let b = R24Reuse("abcdef", 0)
    echo(strutil.Join(["b=", IntToStr(b)], ""))
    if a != 815075:
        return 10
    if b != 811075:
        return 11
    echo("r24 reuse ok")
    return 0
