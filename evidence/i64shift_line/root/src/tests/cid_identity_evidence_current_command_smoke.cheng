import cheng/core/tooling/cid_identity_evidence_current as cidcurrent

fn cidCurrentRejected(
        argc: int32,
        programPath: str,
        command: str,
        caseId: str,
        sha256: str): bool =
    var payload = "must-be-cleared"
    var err: str
    if cidcurrent.CidIdentityEvidenceCurrentRunCase(
            argc,
            programPath,
            command,
            caseId,
            sha256,
            payload,
            err):
        return false
    return payload == "" && err != ""

fn main(): int32 =
    let sha256 =
        "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
    let cases = [
        "source-bundle-entry",
        "zero-byte-import",
        "source-csg-binding",
        "csg-atomic-consume",
        "migration-cross-root-fixed-point",
        "mirror-atomic-install"]
    for index in 0..<cases.len:
        var err: str
        if !cidcurrent.CidIdentityEvidenceCurrentValidateArguments(
                4, "run-case", cases[index], sha256, err) ||
           err != "":
            return 1
    if !cidCurrentRejected(
            3,
            "/cheng-hardcap/current-driver",
            "run-case",
            "source-bundle-entry",
            sha256):
        return 2
    if !cidCurrentRejected(
            5,
            "/cheng-hardcap/current-driver",
            "run-case",
            "source-bundle-entry",
            sha256):
        return 3
    if !cidCurrentRejected(
            4,
            "/cheng-hardcap/current-driver",
            "not-run-case",
            "source-bundle-entry",
            sha256):
        return 4
    if !cidCurrentRejected(
            4,
            "/cheng-hardcap/current-driver",
            "run-case",
            "unknown-case",
            sha256):
        return 5
    if !cidCurrentRejected(
            4,
            "/cheng-hardcap/current-driver",
            "run-case",
            "source-bundle-entry",
            "0123456789ABCDEF0123456789abcdef0123456789abcdef0123456789abcdef"):
        return 6
    if !cidCurrentRejected(
            4,
            "/cheng-hardcap/current-driver",
            "run-case",
            "source-bundle-entry",
            "0123456789abcdef"):
        return 7
    if !cidCurrentRejected(
            4,
            "/not-the-current-driver",
            "run-case",
            "source-bundle-entry",
            sha256):
        return 8
    return 0
