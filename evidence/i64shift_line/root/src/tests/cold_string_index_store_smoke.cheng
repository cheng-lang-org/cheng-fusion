import std/system

fn main(): int32 =
    let source = "abcd"
    var copied = NewStringAlloc(4)
    for i in 0..<4:
        copied[i] = source[i]
    if copied[0] != 'a':
        return 61
    if copied[1] != 'b':
        return 62
    if copied[2] != 'c':
        return 63
    if copied[3] != 'd':
        return 64
    echo(" cold_string_index_store_smoke ok")
    return 0