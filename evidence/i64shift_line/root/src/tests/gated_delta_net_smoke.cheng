import std/result
import std/math as m
import std/strutils as strutil
import std/strings as strings
import cheng/inference/gated_delta_net as gdn

// GDN CPU reference kernel smoke.
// Fixture weights come from a fixed-seed LCG (deterministic pseudo random,
// NOT real model weights - mathematical fixture for self-consistency对拍:
// naive recurrence vs chunked block form must agree within 1e-12, and the
// public single-token stepping surface must reproduce the whole-sequence
// recurrent forward bit-for-bit).
//
// Scaled-down config keeps the Qwen3.8 structural invariant valueHeads ==
// 3 * keyHeads: k=2, v=6, head_dim=8, hidden=24, T=20, chunk=7 (non-divisible
// tail exercise).

const
    SmokeKeyHeads = 2
    SmokeValueHeads = 6
    SmokeHeadDim = 8
    SmokeHidden = 24
    SmokeSeqLen = 20
    SmokeChunkLen = 7

fn lcgDraw(seed: var int64, amp: float64): float64 =
    seed = seed * int64(6364136223846793005) + int64(1442695040888963407)
    let draw: int64 = (seed >> 33) & int64(1023)
    return (float64(draw) - 512.0) / 1024.0 * amp

fn fillWeights(outArr: var float64[], n: int32, seed: var int64, amp: float64) =
    for i in 0..<n:
        add(outArr, lcgDraw(seed, amp))

fn buildParams(qLenDelta: int32, convLenDelta: int32): gdn.GatedDeltaNetParams =
    var p: gdn.GatedDeltaNetParams
    p.schema = gdn.GatedDeltaNetSchema
    p.keyHeads = SmokeKeyHeads
    p.valueHeads = SmokeValueHeads
    p.headDim = SmokeHeadDim
    p.hiddenSize = SmokeHidden
    p.convKernel = gdn.GatedDeltaNetConvKernel
    p.sourceHash = int64(2026082201)
    let kW = SmokeKeyHeads * SmokeHeadDim
    let vW = SmokeValueHeads * SmokeHeadDim
    var seed: int64 = int64(88172645463325252)
    fillWeights(p.qProj, kW * SmokeHidden + qLenDelta, seed, 0.25)
    fillWeights(p.kProj, kW * SmokeHidden, seed, 0.25)
    fillWeights(p.vProj, vW * SmokeHidden, seed, 0.25)
    fillWeights(p.gateAlpha, SmokeKeyHeads * SmokeHidden, seed, 0.6)
    fillWeights(p.gateBeta, SmokeKeyHeads * SmokeHidden, seed, 0.6)
    fillWeights(p.outGate, vW * SmokeHidden, seed, 0.25)
    fillWeights(p.outProj, vW * SmokeHidden, seed, 0.25)
    fillWeights(p.convW,
                gdn.GatedDeltaNetConvKernel * (kW + kW + vW) + convLenDelta, seed, 0.5)
    return p

fn buildInputs(): float64[] =
    var x: float64[]
    var seed: int64 = int64(424242424242424)
    fillWeights(x, SmokeSeqLen * SmokeHidden, seed, 1.0)
    return x

fn splitHi(v: int64): int32 =
    var t: int64 = v
    if t < int64(0):
        t = int64(0) - t
    return int32(t / int64(1000000))

fn splitLo(v: int64): int32 =
    var t: int64 = v
    if t < int64(0):
        t = int64(0) - t
    return int32(t % int64(1000000))

fn boolWord(b: bool): str =
    if b:
        return "1"
    return "0"

fn signedPrefix(v: int64): str =
    if v < int64(0):
        return "-"
    return ""

fn f64ScaledDigits(value: float64, scalePow: int32): int64 =
    // value * 10^scalePow via repeated exact-of-purpose multiply; for smoke
    // magnitudes (|value| < 1e3, scale <= 21) the product stays inside int64.
    var scaled: float64 = value
    for i in 0..<scalePow:
        scaled = scaled * 10.0
    return int64(scaled)

fn echoF64(label: str, value: float64, scalePow: int32) =
    let d = f64ScaledDigits(value, scalePow)
    echo(strutil.Join([label, signedPrefix(d), strings.IntToStr(splitHi(d)), ".",
                       strings.IntToStr(splitLo(d)), "e-", strings.IntToStr(scalePow)], ""))

fn main(): int32 =
    // Long fractional decimal literals are unreliable on this lexer, so the
    // small thresholds below are built by integer division and verified.
    let tolTight: float64 = 1.0 / 1000000000000.0
    let perturbStep: float64 = 1.0 / 1000000000.0
    assert(int64(tolTight * 1000000000000000000.0) == int64(1000000),
           "gdn smoke: tolTight constant self-check")
    assert(int64(perturbStep * 1000000000000000000.0) == int64(1000000000),
           "gdn smoke: perturbStep constant self-check")
    let params = buildParams(0, 0)
    let valOk = gdn.GatedDeltaNetParamsValidate(params)
    assert(IsOk(valOk), "gdn smoke: valid params must validate")

    // --- shape negatives (>= 5 hard fails) ---
    var negSchema = buildParams(0, 0)
    negSchema.schema = "cheng.inference.gated_delta_net.v2"
    assert(IsErr(gdn.GatedDeltaNetParamsValidate(negSchema)), "gdn smoke: schema negative")

    var negRatio = buildParams(0, 0)
    negRatio.valueHeads = 5
    assert(IsErr(gdn.GatedDeltaNetParamsValidate(negRatio)), "gdn smoke: value head ratio negative")

    var negHash = buildParams(0, 0)
    negHash.sourceHash = int64(0)
    assert(IsErr(gdn.GatedDeltaNetParamsValidate(negHash)), "gdn smoke: zero source hash negative")

    let negQ = buildParams(-1, 0)
    assert(IsErr(gdn.GatedDeltaNetParamsValidate(negQ)), "gdn smoke: short q proj negative")

    let negConv = buildParams(0, 1)
    assert(IsErr(gdn.GatedDeltaNetParamsValidate(negConv)), "gdn smoke: long conv weight negative")

    var negDims = buildParams(0, 0)
    negDims.hiddenSize = 0
    assert(IsErr(gdn.GatedDeltaNetParamsValidate(negDims)), "gdn smoke: zero hidden negative")

    // --- conv left zero-pad boundary (dyadic-exact hand computation) ---
    // taps j=0..3 weights, two channels; inputs rows t0,t1,t2 dyadic powers.
    var convW: float64[]
    add(convW, 0.5)        // j0 c0
    add(convW, 0.25)       // j0 c1
    add(convW, 0.125)      // j1 c0
    add(convW, 0.0625)     // j1 c1
    add(convW, 0.03125)    // j2 c0
    add(convW, 0.015625)   // j2 c1
    add(convW, 0.0078125)  // j3 c0
    add(convW, 0.00390625) // j3 c1
    var convIn: float64[]
    add(convIn, 1.0)
    add(convIn, 2.0)
    add(convIn, 4.0)
    add(convIn, 8.0)
    add(convIn, 16.0)
    add(convIn, 32.0)
    var convOut: float64[]
    for i in 0..<6:
        add(convOut, 0.0)
    let convRes = gdn.GatedDeltaNetConvSequenceFill(convOut, convIn, 2, 3, convW, 0)
    assert(IsOk(convRes), "gdn smoke: conv boundary run")
    // t0: only tap j=3 contributes (left pad skips j=0..2)
    assert(convOut[0] == 0.0078125 * 1.0, "gdn smoke: conv t0 c0")
    assert(convOut[1] == 0.00390625 * 2.0, "gdn smoke: conv t0 c1")
    // t1: taps j=2,3
    assert(convOut[2] == 0.03125 * 1.0 + 0.0078125 * 4.0, "gdn smoke: conv t1 c0")
    assert(convOut[3] == 0.015625 * 2.0 + 0.00390625 * 8.0, "gdn smoke: conv t1 c1")
    // t2: full window taps j=0..3
    assert(convOut[4] == 0.125 * 1.0 + 0.03125 * 4.0 + 0.0078125 * 16.0,
           "gdn smoke: conv t2 c0")
    assert(convOut[5] == 0.0625 * 2.0 + 0.015625 * 8.0 + 0.00390625 * 32.0,
           "gdn smoke: conv t2 c1")
    assert(IsErr(gdn.GatedDeltaNetConvSequenceFill(convOut, convIn, 2, 3, convW, 4)),
           "gdn smoke: conv offset range negative")

    // --- whole-sequence forwards: naive recurrence vs chunked ---
    let xAll = buildInputs()
    var recOut: float64[]
    for i in 0..<SmokeSeqLen * SmokeHidden:
        add(recOut, 0.0)
    var chunkOut: float64[]
    for i in 0..<SmokeSeqLen * SmokeHidden:
        add(chunkOut, 0.0)
    var recState: gdn.GatedDeltaNetState
    var chunkState: gdn.GatedDeltaNetState
    let recOk = gdn.GatedDeltaNetRecurrentForwardFill(recOut, recState, params, xAll, SmokeSeqLen)
    assert(IsOk(recOk), "gdn smoke: recurrent forward")
    let chunkOk = gdn.GatedDeltaNetChunkedForwardFill(chunkOut, chunkState, params,
                                                      xAll, SmokeSeqLen, SmokeChunkLen)
    assert(IsOk(chunkOk), "gdn smoke: chunked forward")

    // tolerance 2^-40 (~8.6e-13) as a pure integer IEEE key: (-40, 0)
    let outKey = gdn.GatedDeltaNetArraysWithinToleranceKey(recOut, chunkOut,
                                                           int64(0) - int64(40), int64(0))
    assert(IsOk(outKey), "gdn smoke: output tolerance key run")
    echo(strutil.Join(["gdn_smoke: recurrent_vs_chunked_within_2^-40=",
                       boolWord(Value(outKey))], ""))
    assert(Value(outKey), "gdn smoke: recurrent vs chunked output tolerance")
    let outDiffRes = gdn.GatedDeltaNetMaxAbsDiff(recOut, chunkOut)
    assert(IsOk(outDiffRes), "gdn smoke: output diff")
    echoF64("gdn_smoke: recurrent_vs_chunked_out_maxdiff=", Value(outDiffRes), 21)

    let stDiffRes = gdn.GatedDeltaNetMaxAbsDiff(recState.data, chunkState.data)
    assert(IsOk(stDiffRes), "gdn smoke: state diff")
    let stDiff = Value(stDiffRes)
    echoF64("gdn_smoke: recurrent_vs_chunked_state_maxdiff=", stDiff, 21)
    let stTol = gdn.GatedDeltaNetWithinTolerance(stDiff, tolTight)
    assert(IsOk(stTol) && Value(stTol), "gdn smoke: recurrent vs chunked state tolerance")

    // --- single-token stepping surface == whole-sequence recurrence ---
    let kW = SmokeKeyHeads * SmokeHeadDim
    let vW = SmokeValueHeads * SmokeHeadDim
    let kh = SmokeKeyHeads
    var qC: float64[]
    var kC: float64[]
    var vC: float64[]
    var alphaAll: float64[]
    var betaAll: float64[]
    for i in 0..<SmokeSeqLen * kW:
        add(qC, 0.0)
        add(kC, 0.0)
    for i in 0..<SmokeSeqLen * vW:
        add(vC, 0.0)
    for i in 0..<SmokeSeqLen * kh:
        add(alphaAll, 0.0)
        add(betaAll, 0.0)
    let prepOk = gdn.GatedDeltaNetPrepareSequenceFill(qC, kC, vC, alphaAll, betaAll,
                                                      params, xAll, SmokeSeqLen)
    assert(IsOk(prepOk), "gdn smoke: prepare sequence")

    var stepState: gdn.GatedDeltaNetState
    let initOk = gdn.GatedDeltaNetStateInit(stepState, SmokeKeyHeads, SmokeHeadDim)
    assert(IsOk(initOk), "gdn smoke: step state init")
    var stepOut: float64[]
    for i in 0..<SmokeSeqLen * SmokeHidden:
        add(stepOut, 0.0)
    var qRow: float64[]
    var kRow: float64[]
    var vRow: float64[]
    var alphaHead: float64[]
    var betaHead: float64[]
    var attnScratch: float64[]
    var gateScratch: float64[]
    var outRowScratch: float64[]
    for i in 0..<kW:
        add(qRow, 0.0)
        add(kRow, 0.0)
    for i in 0..<vW:
        add(vRow, 0.0)
        add(attnScratch, 0.0)
        add(gateScratch, 0.0)
    for i in 0..<kh:
        add(alphaHead, 0.0)
        add(betaHead, 0.0)
    for i in 0..<SmokeHidden:
        add(outRowScratch, 0.0)
    for t in 0..<SmokeSeqLen:
        for i in 0..<kW:
            qRow[i] = qC[t * kW + i]
            kRow[i] = kC[t * kW + i]
        for i in 0..<vW:
            vRow[i] = vC[t * vW + i]
        for hd in 0..<kh:
            alphaHead[hd] = alphaAll[t * kh + hd]
            betaHead[hd] = betaAll[t * kh + hd]
        let stepOk = gdn.GatedDeltaNetStepRecurrentFill(stepState, outRowScratch, params,
                                                        qRow, kRow, vRow, alphaHead, betaHead,
                                                        xAll, t * SmokeHidden,
                                                        attnScratch, gateScratch)
        assert(IsOk(stepOk), "gdn smoke: single step")
        for i in 0..<SmokeHidden:
            stepOut[t * SmokeHidden + i] = outRowScratch[i]

    let stepEq = gdn.GatedDeltaNetArraysBitEqual(recOut, stepOut)
    assert(IsOk(stepEq), "gdn smoke: step bit equal run")
    echo(strutil.Join(["gdn_smoke: single_step_vs_recurrent_bit_equal=",
                       boolWord(Value(stepEq))], ""))
    assert(Value(stepEq), "gdn smoke: stepping surface bitwise equal")
    assert(stepState.stateHash == recState.stateHash, "gdn smoke: stepping state hash equal")
    let eqRes = gdn.GatedDeltaNetStatesEqualWithin(stepState, recState, 0.0)
    assert(IsOk(eqRes) && Value(eqRes), "gdn smoke: states equal within zero tolerance")

    // --- states-equal negative paths ---
    var perturbed: gdn.GatedDeltaNetState
    let pertInit = gdn.GatedDeltaNetStateInit(perturbed, SmokeKeyHeads, SmokeHeadDim)
    assert(IsOk(pertInit), "gdn smoke: perturbed init")
    for i in 0..<perturbed.data.len:
        perturbed.data[i] = recState.data[i]
    perturbed.data[0] = perturbed.data[0] + perturbStep
    let pertNe = gdn.GatedDeltaNetStatesEqualWithin(perturbed, recState, tolTight)
    assert(IsOk(pertNe) && !Value(pertNe), "gdn smoke: perturbed state must differ")
    var smallState: gdn.GatedDeltaNetState
    let smallInit = gdn.GatedDeltaNetStateInit(smallState, SmokeKeyHeads, SmokeHeadDim - 1)
    assert(IsOk(smallInit), "gdn smoke: small state init")
    assert(IsErr(gdn.GatedDeltaNetStatesEqualWithin(smallState, recState, 0.0)),
           "gdn smoke: dims mismatch must be Err")

    echo(strutil.Join(["gdn_smoke: rec_state_hash=", signedPrefix(recState.stateHash),
                       strings.IntToStr(splitHi(recState.stateHash)),
                       strings.IntToStr(splitLo(recState.stateHash))], ""))
    echo(strutil.Join(["gdn_smoke: chunk_state_hash=", signedPrefix(chunkState.stateHash),
                       strings.IntToStr(splitHi(chunkState.stateHash)),
                       strings.IntToStr(splitLo(chunkState.stateHash))], ""))
    echo(" gated_delta_net_smoke ok")
    return 0
