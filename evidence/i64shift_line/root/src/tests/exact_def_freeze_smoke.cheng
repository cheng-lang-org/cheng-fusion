# exact_def_freeze_smoke — ExactDef 批 2 单元验证: 点活性 walker +
# consume 边 + read-edge。spec: docs/cheng-exact-def-rewrite-design.md
# §4 批 2 + docs/cheng-exact-def-batch2-walker-spec.md。
#
# 合成 BodyIR 全部经真实构建路径构造 (coreir 构建/绑定/冻结 API +
# 批 1 derive + 批 2 freeze), 零 Mock; consume 戳由夹具按 cleanup
# 物化语义手工落 (cleanup_cfg.cheng:10313/12333 同形: 记录戳指向
# source 边物化消费 op)。
#
# 模式 (argv[1], 缺省 unit):
#   unit                    — 正例全绿 (rc=0, EXACT_DEF_FREEZE_UNIT_OK):
#     ① CSR call consume (通道② MOVE arg); ② loop 回边 (环内定义+消费
#       逐迭代新纪元); ③ 跨块互斥臂双消费 (join 收敛 CONSUMED);
#     ④ term RET consume (term sourceDefinition 单列); ⑤ 同步扩列腿
#       (derive → 物化追加 snapshot 槽/物化 move/drop-glue call →
#       ExactDefFreezeSidecarSyncAppended → 验证绿); ⑥ 判词构建器文本
#       断言 (missing/extra required=1 形 + invalid 形 + reissuefail 形)。
#   verdict-broken-edge     — 禁 origin 通道回归形同族: 记录戳指向不
#     命名该定义的 op → recorded_found=0 → `consume edge is broken`。
#   verdict-mutex-negative  — 跨块非互斥双消费 (顺序块可互达) → walker
#     `exact consume dataflow body=` + 审计 `has invalid path consume`。
#   verdict-three-consumer-negative — A 与 B/C 互斥，但 B→C 同路径；
#     A 为 cp1 时也必须在 C 点由 Consumed dataflow hard-red。
#   verdict-use-after-consume — 消费后同槽读 →
#     `use of consumed managed value`。
#   verdict-capacity-queue  — 容量哨兵 2 (workQueueBlockCap=1) →
#     die `exact definition work queue size overflow`。
#   verdict-capacity-slice  — 容量哨兵 1 (reverseQueueCap=1, 点查询
#     切片逆 BFS) → die `exact point liveness reverse queue overflow`。
#   verdict-read-ambiguous  — 双 shared-borrow-param 车道边 (其一经
#     夹具戳 poke 构造) + 当前定义边失效 → pass1 空 pass2 双候选 →
#     `read-edge ambiguous` + freeze fail + die canonicalization。
#   verdict-read-unresolved — 定义在互斥臂另一侧不可达 →
#     `read-edge unresolved` + freeze fail + die。
#
# 负例基线回执: /Users/lbcheng/cheng-patches/consume-edge-20260825/
# receipts/ (raster_smoke_before.err.gz 的 consume edge is broken
# 逐字段形; 禁 origin 通道 negmut 回归形, ANALYSIS.md 缺陷 A-D 终态)。
#
# read-edge terminal 三判词 (invalid/missing/extra) 的结构性裁定:
# Cheng 无解析期预发布边 (derive 恒 -1 起), 陈旧边来源不存在;
# 完成器对每个 required 读要么落戳要么已发 ambiguous/unresolved
# 判词; required=false ⇒ edgeValid=false 逐情形证 → 三判词在单遍
# 完成+终校验同规则下不可经活体夹具触发, 文本经 ⑥ 构建器断言锁死
# (代码在, 任何未来产生陈旧边的上游变更即被接住)。

import std/cmdline as cmdline
import std/result
import std/os
import cheng/core/analysis/exact_def_derive as derive
import cheng/core/analysis/exact_def_freeze as freeze
import cheng/core/ir/body_ir_exact_def as exactdef
import cheng/core/ir/core_types as coreir
import cheng/core/lang/typed_expr_type_arena as typearena
import cheng/std/bytes_layout as layout

const
    # 合成 TypeArena 行: 0=i32 1=str。
    fixtureTypeI32 = 0
    fixtureTypeStr = 1
    fixtureTransportStart = 100

fn smokeAssert(condition: bool, message: str) =
    if !condition:
        panic(message)

@borrows
fn smokeStrContains(text: str, sub: str): bool =
    let subLen = len(sub)
    if subLen <= 0:
        return true
    if len(text) < subLen:
        return false
    for start in 0..<len(text) - subLen + 1:
        var matched = true
        for offset in 0..<subLen:
            if text[start + offset] != sub[offset]:
                matched = false
                break
        if matched:
            return true
    return false

fn fixtureCid(): layout.FixedBytes32 =
    let parsed = layout.FixedBytes32FromHex(
        "cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd")
    if IsErr(parsed):
        panic(Error(parsed))
    return Value(parsed)

@borrows
fn buildWindow(): exactdef.BodyIrExactDefTypeArenaWindow =
    var window: exactdef.BodyIrExactDefTypeArenaWindow
    window.artifactCid = fixtureCid()
    for typeId in 0..<2:
        add(window.structuralKinds,
            Int32(typearena.TypedExprStructuralTypeInvalid))
        add(window.scalarKinds,
            Int32(typearena.TypedExprStructuralScalarInvalid))
        add(window.childTypeIds, -1)
        add(window.layoutChildStarts, 0)
        add(window.layoutChildCounts, 0)
        add(window.fixedLengths, 0)
        add(window.sizeBytes, 4)
        add(window.alignBytes, 4)
    window.structuralKinds[fixtureTypeI32] =
        Int32(typearena.TypedExprStructuralTypeScalar)
    window.scalarKinds[fixtureTypeI32] =
        Int32(typearena.TypedExprStructuralScalarInt32)
    window.sizeBytes[fixtureTypeI32] = 4
    window.alignBytes[fixtureTypeI32] = 4
    window.structuralKinds[fixtureTypeStr] =
        Int32(typearena.TypedExprStructuralTypeScalar)
    window.scalarKinds[fixtureTypeStr] =
        Int32(typearena.TypedExprStructuralScalarStr)
    window.sizeBytes[fixtureTypeStr] = 24
    window.alignBytes[fixtureTypeStr] = 8
    smokeAssert(exactdef.BodyIrExactDefTypeArenaWindowShapeValid(window),
                "freeze smoke: window shape")
    return window

fn addBoundSlot(body: var coreir.BodyIR,
                name: str,
                typeKind: int32,
                typeId: int32,
                managedStorageKind: int32,
                sizeBytes: int32,
                alignBytes: int32): int32 =
    var slot: coreir.LocalSlot
    let slotId = body.localSlots.len
    slot.id = slotId
    slot.name = name
    slot.typeKind = typeKind
    slot.stackOffset = slot.id * 32
    slot.sizeBytes = sizeBytes
    slot.alignBytes = alignBytes
    coreir.BodyIRApplyLocalSlotDefaultProof(slot)
    add(body.localSlots, slot)
    smokeAssert(coreir.BodyIRBindLocalSlotTypeArenaProof(
                    body, slotId, fixtureCid(), typeId, managedStorageKind),
                "freeze smoke: slot TypeArena proof bind")
    return slotId

fn addStrSlot(body: var coreir.BodyIR, name: str): int32 =
    return addBoundSlot(
        body, name, coreir.LocalStrTag, fixtureTypeStr,
        coreir.BodyManagedStorageManagedTag, 24, 8)

fn newDefOp(body: var coreir.BodyIR,
            kind: int32,
            target: int32,
            semanticRow: int32,
            ownership: coreir.OwnershipKind): int32 =
    var op: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = kind
    op.target = target
    op.valueDefSlot = target
    op.valueDefExprNodeIndex = semanticRow
    op.valueDefSemanticRow = semanticRow
    op.valueDefOwnership = ownership
    op.valueDefOriginKind = coreir.BodyDefinitionOriginTypedExprTag
    op.valueDefOriginId = semanticRow
    return coreir.BodyIRAppendOp(body, op)

# transport 投影列 (LoweringOwnershipTransportSoA 的 int32 窗):
# rows/kinds/types 三列按 def op 序。
fn buildTransportRows(count: int32): int32[] =
    var rows: int32[]
    for row in 0..<count:
        add(rows, fixtureTransportStart + row)
    return rows

fn appendCallTarget(body: var coreir.BodyIR, callIndex: int32) =
    coreir.BodyIRControlFlowBindCallTarget(
        body, callIndex,
        coreir.BodyCallTargetDomainRuntimeIntrinsicTag, 0, fixtureCid())

fn appendBlock(body: var coreir.BodyIR,
               opStart: int32,
               opCount: int32,
               termIndex: int32): int32 =
    let blockId = coreir.BodyIRAppendBlock(body, opStart, opCount, 0)
    body.blocks[blockId].termIndex = termIndex
    return blockId

fn appendTerm(body: var coreir.BodyIR, term: coreir.BodyTerm): int32 =
    return coreir.BodyIRAppendTerm(body, term)

fn newRetTerm(body: var coreir.BodyIR, resultSlot: int32): int32 =
    var term: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = coreir.BodyTermReturnTag
    term.resultSlot = resultSlot
    return appendTerm(body, term)

fn newBrTerm(body: var coreir.BodyIR, targetBlock: int32): int32 =
    var term: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = coreir.BodyTermBrTag
    term.trueBlock = targetBlock
    term.falseBlock = -1
    return appendTerm(body, term)

fn newCbrTerm(body: var coreir.BodyIR,
              conditionSlot: int32,
              trueBlock: int32,
              falseBlock: int32): int32 =
    var term: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = coreir.BodyTermCbrTag
    term.conditionKind = coreir.LocalI32Tag
    term.lhsSlot = conditionSlot
    term.rhsSlot = -1
    term.trueBlock = trueBlock
    term.falseBlock = falseBlock
    return appendTerm(body, term)

fn bindSuccessors(body: var coreir.BodyIR,
                  termIndex: int32,
                  successors: int32[],
                  edgeKinds: int32[]) =
    coreir.BodyIRControlFlowBindTermSuccessors(
        body, termIndex, successors, edgeKinds)

fn sealControl(body: var coreir.BodyIR, blockCount: int32) =
    coreir.BodyIRControlFlowBegin(body, 0)
    for blockId in 0..<blockCount:
        coreir.BodyIRControlFlowBindBlockScope(body, blockId, 0)
    # 后继绑定已在各腿完成 (块序); 此处只 seal。
    coreir.BodyIRControlFlowSeal(body)
    smokeAssert(coreir.BodyIRControlFlowShapeValid(body),
                "freeze smoke: control flow seal")

@borrows
fn deriveFixture(body: var coreir.BodyIR,
                 originKinds: int32[],
                 exactTypeIds: int32[],
                 window: exactdef.BodyIrExactDefTypeArenaWindow) =
    smokeAssert(derive.BodyIrExactDefDerive(
                    body,
                    fixtureTransportStart,
                    buildTransportRows(originKinds.len),
                    originKinds,
                    exactTypeIds,
                    window),
                "freeze smoke: derive rejected fixture")
    smokeAssert(body.exactDef.sealed, "freeze smoke: sidecar sealed")

# ---- 控制流收尾两件: begin (Begin+scopes) / seal (Seal+断言) ----

fn beginControl(body: var coreir.BodyIR, blockCount: int32) =
    coreir.BodyIRControlFlowBegin(body, 0)
    for blockId in 0..<blockCount:
        coreir.BodyIRControlFlowBindBlockScope(body, blockId, 0)

fn sealControlFlow(body: var coreir.BodyIR) =
    coreir.BodyIRControlFlowSeal(body)
    smokeAssert(coreir.BodyIRControlFlowShapeValid(body),
                "freeze smoke: control flow seal")

fn freezeEntryOwnership(body: var coreir.BodyIR,
                        paramSlot: int32,
                        paramOwnership: coreir.OwnershipKind) =
    var ownershipKinds: int32[]
    for slotIndex in 0..<body.localSlots.len:
        add(ownershipKinds, Int32(coreir.OwnInvalid))
    ownershipKinds[paramSlot] = Int32(paramOwnership)
    coreir.BodyIRFreezeEntryDefinitionOwnershipKinds(body, ownershipKinds)

# ---- 腿构建器 ----

# ① CSR call consume (recordedPlusOne 可调: 绿=o2+1, broken=o0+1)。
# ops: o0 param def, o1 call def (str MOVE), o2 call 非 def (CSR arg)。
fn buildCsrConsumeBody(recordedPlusOne: int32): coreir.BodyIR =
    var body: coreir.BodyIR
    smokeAssert(coreir.BodyIRBindTypeArenaArtifactCid(body, fixtureCid()),
                "freeze smoke: TypeArena artifact bind")
    let paramStr = addStrSlot(body, "text")
    body.localSlots[paramStr].stackOffset = -1
    let callStr = addStrSlot(body, "call_str")
    coreir.BodyIRBindEntryParameterSlot(body, 0, paramStr)
    freezeEntryOwnership(body, paramStr, coreir.OwnMove)
    let _ = newDefOp(
        body, coreir.BodyOpLoadLocalTag, paramStr, 100, coreir.OwnMove)
    var call0: coreir.CallOp
    coreir.BodyIRApplyCallOpDefaultProof(call0)
    call0.targetSymbol = "exact_def_freeze_fixture_make_str"
    call0.resultSlot = callStr
    call0.resultOwnership = coreir.OwnMove
    call0.resultExprNodeIndex = 101
    call0.resultValueDefinitionRow = 101
    call0.resultDefinitionOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    call0.resultDefinitionOriginId = 101
    add(body.callSequence, call0)
    let opCall = newDefOp(
        body, coreir.BodyOpCallTag, callStr, 101, coreir.OwnMove)
    add(body.ops[opCall].operands, 0)
    var call1: coreir.CallOp
    coreir.BodyIRApplyCallOpDefaultProof(call1)
    call1.targetSymbol = "exact_def_freeze_fixture_take_str"
    call1.resultSlot = -1
    add(call1.argSlots, callStr)
    add(call1.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(body.callSequence, call1)
    var consumeOp: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(consumeOp)
    consumeOp.kind = coreir.BodyOpCallTag
    consumeOp.target = -1
    add(consumeOp.operands, 1)
    let opConsume = coreir.BodyIRAppendOp(body, consumeOp)
    body.ops[opCall].valueDefConsumeOpIndexPlusOne = recordedPlusOne
    let termIndex = newRetTerm(body, paramStr)
    let _ = appendBlock(body, 0, body.ops.len, termIndex)
    beginControl(body, 1)
    var successors: int32[]
    var edgeKinds: int32[]
    bindSuccessors(body, termIndex, successors, edgeKinds)
    appendCallTarget(body, 0)
    appendCallTarget(body, 1)
    sealControlFlow(body)
    return body

fn csrConsumeTransport(originKinds: var int32[], exactTypeIds: var int32[]) =
    add(originKinds, 1)   # 100 Parameter
    add(originKinds, 3)   # 101 CallResult
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)

# ② loop 回边: b0 cond 定义 + BR→b1; b1 环内定义 str + source 边消费,
# CBR true→b2 false→b1; b2 RET。
fn buildLoopBody(): coreir.BodyIR =
    var body: coreir.BodyIR
    smokeAssert(coreir.BodyIRBindTypeArenaArtifactCid(body, fixtureCid()),
                "freeze smoke: TypeArena artifact bind")
    let cond = addBoundSlot(
        body, "cond", coreir.LocalI32Tag, fixtureTypeI32,
        coreir.BodyManagedStorageUnmanagedTag, 4, 4)
    let tmpStr = addStrSlot(body, "tmp_str")
    let tmp2Str = addStrSlot(body, "tmp2_str")
    let opCond = newDefOp(
        body, coreir.BodyOpLoadConstTag, cond, 100, coreir.OwnPlain)
    add(body.ops[opCond].operands, coreir.LocalI32Tag)
    let term0 = newBrTerm(body, 1)
    let opDef = newDefOp(
        body, coreir.BodyOpLoadConstTag, tmpStr, 101, coreir.OwnMove)
    add(body.ops[opDef].operands, coreir.LocalStrTag)
    let opConsume = newDefOp(
        body, coreir.BodyOpCopyLocalTag, tmp2Str, 102, coreir.OwnMove)
    add(body.ops[opConsume].operands, tmpStr)
    body.ops[opConsume].sourceDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[opConsume].sourceDefinitionRow = opDef
    body.ops[opDef].valueDefConsumeOpIndexPlusOne = opConsume + 1
    let term1 = newCbrTerm(body, cond, 2, 1)
    let term2 = newRetTerm(body, cond)
    let _ = appendBlock(body, 0, 1, term0)
    let _ = appendBlock(body, 1, 2, term1)
    let _ = appendBlock(body, 3, 0, term2)
    beginControl(body, 3)
    var succ0: int32[]
    add(succ0, 1)
    var kind0: int32[]
    add(kind0, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term0, succ0, kind0)
    var succ1: int32[]
    add(succ1, 2)
    add(succ1, 1)
    var kind1: int32[]
    add(kind1, coreir.BodyControlEdgeNormal)
    add(kind1, coreir.BodyControlEdgeLoopBack)
    bindSuccessors(body, term1, succ1, kind1)
    var succ2: int32[]
    var kind2: int32[]
    bindSuccessors(body, term2, succ2, kind2)
    sealControlFlow(body)
    return body

fn loopTransport(originKinds: var int32[], exactTypeIds: var int32[]) =
    add(originKinds, 4)   # 100 ManagedTemporary (cond)
    add(originKinds, 4)   # 101 ManagedTemporary (tmp_str)
    add(originKinds, 4)   # 102 ManagedTemporary (tmp2_str)
    add(exactTypeIds, fixtureTypeI32)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)

# ③ 跨块互斥臂: b0 cond+tmp0 定义, CBR→b1/b2; b1/b2 各 source 边消费
# tmp0 后 BR→b3; b3 RET。
fn buildMutexBody(): coreir.BodyIR =
    var body: coreir.BodyIR
    smokeAssert(coreir.BodyIRBindTypeArenaArtifactCid(body, fixtureCid()),
                "freeze smoke: TypeArena artifact bind")
    let cond = addBoundSlot(
        body, "cond", coreir.LocalI32Tag, fixtureTypeI32,
        coreir.BodyManagedStorageUnmanagedTag, 4, 4)
    let tmp0 = addStrSlot(body, "tmp0")
    let tmp1 = addStrSlot(body, "tmp1")
    let tmp2 = addStrSlot(body, "tmp2")
    let opCond = newDefOp(
        body, coreir.BodyOpLoadConstTag, cond, 100, coreir.OwnPlain)
    add(body.ops[opCond].operands, coreir.LocalI32Tag)
    let opDef = newDefOp(
        body, coreir.BodyOpLoadConstTag, tmp0, 101, coreir.OwnMove)
    add(body.ops[opDef].operands, coreir.LocalStrTag)
    let term0 = newCbrTerm(body, cond, 1, 2)
    let opFirst = newDefOp(
        body, coreir.BodyOpCopyLocalTag, tmp1, 102, coreir.OwnMove)
    add(body.ops[opFirst].operands, tmp0)
    body.ops[opFirst].sourceDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[opFirst].sourceDefinitionRow = opDef
    let term1 = newBrTerm(body, 3)
    let opSecond = newDefOp(
        body, coreir.BodyOpCopyLocalTag, tmp2, 103, coreir.OwnMove)
    add(body.ops[opSecond].operands, tmp0)
    body.ops[opSecond].sourceDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[opSecond].sourceDefinitionRow = opDef
    let term2 = newBrTerm(body, 3)
    body.ops[opDef].valueDefConsumeOpIndexPlusOne = opFirst + 1
    let term3 = newRetTerm(body, cond)
    let _ = appendBlock(body, 0, 2, term0)
    let _ = appendBlock(body, 2, 1, term1)
    let _ = appendBlock(body, 3, 1, term2)
    let _ = appendBlock(body, 4, 0, term3)
    beginControl(body, 4)
    var succ0: int32[]
    add(succ0, 1)
    add(succ0, 2)
    var kind0: int32[]
    add(kind0, coreir.BodyControlEdgeNormal)
    add(kind0, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term0, succ0, kind0)
    var succ1: int32[]
    add(succ1, 3)
    var kind1: int32[]
    add(kind1, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term1, succ1, kind1)
    var succ2: int32[]
    add(succ2, 3)
    var kind2: int32[]
    add(kind2, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term2, succ2, kind2)
    var succ3: int32[]
    var kind3: int32[]
    bindSuccessors(body, term3, succ3, kind3)
    sealControlFlow(body)
    return body

fn mutexTransport(originKinds: var int32[], exactTypeIds: var int32[]) =
    add(originKinds, 4)   # 100 ManagedTemporary (cond)
    add(originKinds, 4)   # 101 ManagedTemporary (tmp0)
    add(originKinds, 2)   # 102 BindingInitializer (tmp1 ← tmp0)
    add(originKinds, 2)   # 103 BindingInitializer (tmp2 ← tmp0)
    add(exactTypeIds, fixtureTypeI32)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)

# ④ term RET consume: 单块, RET term sourceDefinition 命名定义。
fn buildRetConsumeBody(): coreir.BodyIR =
    var body: coreir.BodyIR
    smokeAssert(coreir.BodyIRBindTypeArenaArtifactCid(body, fixtureCid()),
                "freeze smoke: TypeArena artifact bind")
    let tmp0 = addStrSlot(body, "tmp0")
    let opDef = newDefOp(
        body, coreir.BodyOpLoadConstTag, tmp0, 100, coreir.OwnMove)
    add(body.ops[opDef].operands, coreir.LocalStrTag)
    var term: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = coreir.BodyTermReturnTag
    term.resultSlot = tmp0
    term.sourceDefinitionDomain = coreir.BodyDefinitionDomainBodyOpTag
    term.sourceDefinitionRow = opDef
    let termIndex = appendTerm(body, term)
    let _ = appendBlock(body, 0, 1, termIndex)
    beginControl(body, 1)
    var successors: int32[]
    var edgeKinds: int32[]
    bindSuccessors(body, termIndex, successors, edgeKinds)
    sealControlFlow(body)
    return body

fn retConsumeTransport(originKinds: var int32[], exactTypeIds: var int32[]) =
    add(originKinds, 4)
    add(exactTypeIds, fixtureTypeStr)

# ⑤ 同步扩列腿基体: o0 param def + o1 call def + RET (物化行在
# derive 后由 runUnit 追加, 见 runUnit 腿⑤注释)。
fn buildSyncBaseBody(): coreir.BodyIR =
    var body: coreir.BodyIR
    smokeAssert(coreir.BodyIRBindTypeArenaArtifactCid(body, fixtureCid()),
                "freeze smoke: TypeArena artifact bind")
    let paramStr = addStrSlot(body, "text")
    body.localSlots[paramStr].stackOffset = -1
    let callStr = addStrSlot(body, "call_str")
    coreir.BodyIRBindEntryParameterSlot(body, 0, paramStr)
    freezeEntryOwnership(body, paramStr, coreir.OwnMove)
    let _ = newDefOp(
        body, coreir.BodyOpLoadLocalTag, paramStr, 100, coreir.OwnMove)
    var call0: coreir.CallOp
    coreir.BodyIRApplyCallOpDefaultProof(call0)
    call0.targetSymbol = "exact_def_freeze_fixture_make_str"
    call0.resultSlot = callStr
    call0.resultOwnership = coreir.OwnMove
    call0.resultExprNodeIndex = 101
    call0.resultValueDefinitionRow = 101
    call0.resultDefinitionOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    call0.resultDefinitionOriginId = 101
    add(body.callSequence, call0)
    let opCall = newDefOp(
        body, coreir.BodyOpCallTag, callStr, 101, coreir.OwnMove)
    add(body.ops[opCall].operands, 0)
    let termIndex = newRetTerm(body, paramStr)
    let _ = appendBlock(body, 0, body.ops.len, termIndex)
    beginControl(body, 1)
    var successors: int32[]
    var edgeKinds: int32[]
    bindSuccessors(body, termIndex, successors, edgeKinds)
    appendCallTarget(body, 0)
    sealControlFlow(body)
    return body

fn syncBaseTransport(originKinds: var int32[], exactTypeIds: var int32[]) =
    add(originKinds, 1)   # 100 Parameter
    add(originKinds, 3)   # 101 CallResult
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)

# ⑥ 跨块非互斥双消费 (顺序块): b0 def, b1 消费, b2 再消费。
fn buildMutexNegativeBody(): coreir.BodyIR =
    var body: coreir.BodyIR
    smokeAssert(coreir.BodyIRBindTypeArenaArtifactCid(body, fixtureCid()),
                "freeze smoke: TypeArena artifact bind")
    let tmp0 = addStrSlot(body, "tmp0")
    let tmp1 = addStrSlot(body, "tmp1")
    let tmp2 = addStrSlot(body, "tmp2")
    let opDef = newDefOp(
        body, coreir.BodyOpLoadConstTag, tmp0, 100, coreir.OwnMove)
    add(body.ops[opDef].operands, coreir.LocalStrTag)
    let term0 = newBrTerm(body, 1)
    let opFirst = newDefOp(
        body, coreir.BodyOpCopyLocalTag, tmp1, 101, coreir.OwnMove)
    add(body.ops[opFirst].operands, tmp0)
    body.ops[opFirst].sourceDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[opFirst].sourceDefinitionRow = opDef
    let term1 = newBrTerm(body, 2)
    let opSecond = newDefOp(
        body, coreir.BodyOpCopyLocalTag, tmp2, 102, coreir.OwnMove)
    add(body.ops[opSecond].operands, tmp0)
    body.ops[opSecond].sourceDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[opSecond].sourceDefinitionRow = opDef
    body.ops[opDef].valueDefConsumeOpIndexPlusOne = opFirst + 1
    let term2 = newRetTerm(body, tmp0)
    let _ = appendBlock(body, 0, 1, term0)
    let _ = appendBlock(body, 1, 1, term1)
    let _ = appendBlock(body, 2, 1, term2)
    beginControl(body, 3)
    var succ0: int32[]
    add(succ0, 1)
    var kind0: int32[]
    add(kind0, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term0, succ0, kind0)
    var succ1: int32[]
    add(succ1, 2)
    var kind1: int32[]
    add(kind1, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term1, succ1, kind1)
    var succ2: int32[]
    var kind2: int32[]
    bindSuccessors(body, term2, succ2, kind2)
    sealControlFlow(body)
    return body

fn mutexNegativeTransport(originKinds: var int32[],
                          exactTypeIds: var int32[]) =
    add(originKinds, 4)   # 100 ManagedTemporary
    add(originKinds, 2)   # 101 BindingInitializer
    add(originKinds, 2)   # 102 BindingInitializer
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)

# ⑦ 三消费者反例：b0 定义后分叉；b1 的 A 消费并 Return，b2 的 B
# 消费后 BR→b3，b3 的 C 再消费。A(cp1) 与 C 互斥，但 B 可达 C；只拿
# cp1 做两两证明会假绿，逐路径 dataflow 必须在 C 看到 Consumed。
fn buildThreeConsumerNegativeBody(): coreir.BodyIR =
    var body: coreir.BodyIR
    smokeAssert(coreir.BodyIRBindTypeArenaArtifactCid(body, fixtureCid()),
                "freeze smoke: TypeArena artifact bind")
    let cond = addBoundSlot(
        body, "cond", coreir.LocalI32Tag, fixtureTypeI32,
        coreir.BodyManagedStorageUnmanagedTag, 4, 4)
    let source = addStrSlot(body, "source")
    let outA = addStrSlot(body, "out_a")
    let outB = addStrSlot(body, "out_b")
    let outC = addStrSlot(body, "out_c")
    let opCond = newDefOp(
        body, coreir.BodyOpLoadConstTag, cond, 100, coreir.OwnPlain)
    add(body.ops[opCond].operands, coreir.LocalI32Tag)
    let opDef = newDefOp(
        body, coreir.BodyOpLoadConstTag, source, 101, coreir.OwnMove)
    add(body.ops[opDef].operands, coreir.LocalStrTag)
    let term0 = newCbrTerm(body, cond, 1, 2)
    let opA = newDefOp(
        body, coreir.BodyOpCopyLocalTag, outA, 102, coreir.OwnMove)
    add(body.ops[opA].operands, source)
    body.ops[opA].sourceDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[opA].sourceDefinitionRow = opDef
    let termA = newRetTerm(body, cond)
    let opB = newDefOp(
        body, coreir.BodyOpCopyLocalTag, outB, 103, coreir.OwnMove)
    add(body.ops[opB].operands, source)
    body.ops[opB].sourceDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[opB].sourceDefinitionRow = opDef
    let termB = newBrTerm(body, 3)
    let opC = newDefOp(
        body, coreir.BodyOpCopyLocalTag, outC, 104, coreir.OwnMove)
    add(body.ops[opC].operands, source)
    body.ops[opC].sourceDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[opC].sourceDefinitionRow = opDef
    body.ops[opDef].valueDefConsumeOpIndexPlusOne = opA + 1
    let termC = newRetTerm(body, cond)
    let _ = appendBlock(body, 0, 2, term0)
    let _ = appendBlock(body, 2, 1, termA)
    let _ = appendBlock(body, 3, 1, termB)
    let _ = appendBlock(body, 4, 1, termC)
    beginControl(body, 4)
    var succ0: int32[]
    add(succ0, 1)
    add(succ0, 2)
    var kind0: int32[]
    add(kind0, coreir.BodyControlEdgeNormal)
    add(kind0, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term0, succ0, kind0)
    var succA: int32[]
    var kindA: int32[]
    bindSuccessors(body, termA, succA, kindA)
    var succB: int32[]
    add(succB, 3)
    var kindB: int32[]
    add(kindB, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, termB, succB, kindB)
    var succC: int32[]
    var kindC: int32[]
    bindSuccessors(body, termC, succC, kindC)
    sealControlFlow(body)
    return body

fn threeConsumerNegativeTransport(originKinds: var int32[],
                                  exactTypeIds: var int32[]) =
    add(originKinds, 4)
    add(originKinds, 4)
    add(originKinds, 2)
    add(originKinds, 2)
    add(originKinds, 2)
    add(exactTypeIds, fixtureTypeI32)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)

# ⑧ use-after-consume (splitBlocks=true 时读在下游块, 供容量哨兵 1)。
fn buildUseAfterConsumeBody(splitBlocks: bool): coreir.BodyIR =
    var body: coreir.BodyIR
    smokeAssert(coreir.BodyIRBindTypeArenaArtifactCid(body, fixtureCid()),
                "freeze smoke: TypeArena artifact bind")
    let tmp0 = addStrSlot(body, "tmp0")
    let callStr = addStrSlot(body, "call_str")
    let tmp2 = addStrSlot(body, "tmp2")
    let opTmp = newDefOp(
        body, coreir.BodyOpLoadConstTag, tmp0, 100, coreir.OwnMove)
    add(body.ops[opTmp].operands, coreir.LocalStrTag)
    var call0: coreir.CallOp
    coreir.BodyIRApplyCallOpDefaultProof(call0)
    call0.targetSymbol = "exact_def_freeze_fixture_make_str"
    call0.resultSlot = callStr
    call0.resultOwnership = coreir.OwnMove
    call0.resultExprNodeIndex = 101
    call0.resultValueDefinitionRow = 101
    call0.resultDefinitionOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    call0.resultDefinitionOriginId = 101
    add(body.callSequence, call0)
    let opCall = newDefOp(
        body, coreir.BodyOpCallTag, callStr, 101, coreir.OwnMove)
    add(body.ops[opCall].operands, 0)
    var call1: coreir.CallOp
    coreir.BodyIRApplyCallOpDefaultProof(call1)
    call1.targetSymbol = "exact_def_freeze_fixture_take_str"
    call1.resultSlot = -1
    add(call1.argSlots, callStr)
    add(call1.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(body.callSequence, call1)
    var consumeOp: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(consumeOp)
    consumeOp.kind = coreir.BodyOpCallTag
    consumeOp.target = -1
    add(consumeOp.operands, 1)
    let _ = coreir.BodyIRAppendOp(body, consumeOp)
    body.ops[opCall].valueDefConsumeOpIndexPlusOne = 3
    let opRead = newDefOp(
        body, coreir.BodyOpCopyLocalTag, tmp2, 102, coreir.OwnMove)
    add(body.ops[opRead].operands, callStr)
    if splitBlocks:
        let term0 = newBrTerm(body, 1)
        let termIndex = newRetTerm(body, tmp0)
        let _ = appendBlock(body, 0, 3, term0)
        let _ = appendBlock(body, 3, 1, termIndex)
        beginControl(body, 2)
        var succ0: int32[]
        add(succ0, 1)
        var kind0: int32[]
        add(kind0, coreir.BodyControlEdgeNormal)
        bindSuccessors(body, term0, succ0, kind0)
        var successors: int32[]
        var edgeKinds: int32[]
        bindSuccessors(body, termIndex, successors, edgeKinds)
    else:
        let termIndex = newRetTerm(body, tmp0)
        let _ = appendBlock(body, 0, 4, termIndex)
        beginControl(body, 1)
        var successors: int32[]
        var edgeKinds: int32[]
        bindSuccessors(body, termIndex, successors, edgeKinds)
    appendCallTarget(body, 0)
    appendCallTarget(body, 1)
    sealControlFlow(body)
    return body

fn useAfterConsumeTransport(originKinds: var int32[],
                            exactTypeIds: var int32[]) =
    add(originKinds, 4)   # 100 ManagedTemporary
    add(originKinds, 3)   # 101 CallResult
    add(originKinds, 2)   # 102 BindingInitializer
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)

# ⑧ read-ambiguous: 双 PARAM/BorrowShared 定义 (o0 形参定义 + o1
# 同槽 Parameter origin 定义) + o2 当前定义边失效 (夹具戳 poke
# opExactTypeIds) → pass1 空, pass2 {o0,o1}。
fn buildReadAmbiguousBody(): coreir.BodyIR =
    var body: coreir.BodyIR
    smokeAssert(coreir.BodyIRBindTypeArenaArtifactCid(body, fixtureCid()),
                "freeze smoke: TypeArena artifact bind")
    let paramStr = addStrSlot(body, "text")
    body.localSlots[paramStr].stackOffset = -1
    let outStr = addStrSlot(body, "out_str")
    coreir.BodyIRBindEntryParameterSlot(body, 0, paramStr)
    freezeEntryOwnership(body, paramStr, coreir.OwnBorrowShared)
    let _ = newDefOp(
        body, coreir.BodyOpLoadLocalTag, paramStr, 100,
        coreir.OwnBorrowShared)
    let _ = newDefOp(
        body, coreir.BodyOpLoadLocalTag, paramStr, 101,
        coreir.OwnBorrowShared)
    let opShadow = newDefOp(
        body, coreir.BodyOpLoadLocalTag, paramStr, 102, coreir.OwnMove)
    let opRead = newDefOp(
        body, coreir.BodyOpCopyLocalTag, outStr, 103, coreir.OwnMove)
    add(body.ops[opRead].operands, paramStr)
    let termIndex = newRetTerm(body, outStr)
    let _ = appendBlock(body, 0, body.ops.len, termIndex)
    beginControl(body, 1)
    var successors: int32[]
    var edgeKinds: int32[]
    bindSuccessors(body, termIndex, successors, edgeKinds)
    sealControlFlow(body)
    return body

fn readAmbiguousTransport(originKinds: var int32[],
                          exactTypeIds: var int32[]) =
    add(originKinds, 1)   # 100 Parameter
    add(originKinds, 1)   # 101 Parameter (同槽第二 PARAM 定义)
    add(originKinds, 1)   # 102 Parameter (同槽当前定义, 戳后失效)
    add(originKinds, 2)   # 103 BindingInitializer
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)

# ⑨ read-unresolved: 定义在 CBR 一臂, 读在另一臂 (不可达)。
fn buildReadUnresolvedBody(): coreir.BodyIR =
    var body: coreir.BodyIR
    smokeAssert(coreir.BodyIRBindTypeArenaArtifactCid(body, fixtureCid()),
                "freeze smoke: TypeArena artifact bind")
    let cond = addBoundSlot(
        body, "cond", coreir.LocalI32Tag, fixtureTypeI32,
        coreir.BodyManagedStorageUnmanagedTag, 4, 4)
    let arm0Str = addStrSlot(body, "arm0_str")
    let outStr = addStrSlot(body, "out_str")
    let opCond = newDefOp(
        body, coreir.BodyOpLoadConstTag, cond, 100, coreir.OwnPlain)
    add(body.ops[opCond].operands, coreir.LocalI32Tag)
    let term0 = newCbrTerm(body, cond, 1, 2)
    let opDef = newDefOp(
        body, coreir.BodyOpLoadConstTag, arm0Str, 101, coreir.OwnMove)
    add(body.ops[opDef].operands, coreir.LocalStrTag)
    let term1 = newBrTerm(body, 3)
    let opRead = newDefOp(
        body, coreir.BodyOpCopyLocalTag, outStr, 102, coreir.OwnMove)
    add(body.ops[opRead].operands, arm0Str)
    let term2 = newBrTerm(body, 3)
    let term3 = newRetTerm(body, cond)
    let _ = appendBlock(body, 0, 1, term0)
    let _ = appendBlock(body, 1, 1, term1)
    let _ = appendBlock(body, 2, 1, term2)
    let _ = appendBlock(body, 3, 0, term3)
    beginControl(body, 4)
    var succ0: int32[]
    add(succ0, 1)
    add(succ0, 2)
    var kind0: int32[]
    add(kind0, coreir.BodyControlEdgeNormal)
    add(kind0, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term0, succ0, kind0)
    var succ1: int32[]
    add(succ1, 3)
    var kind1: int32[]
    add(kind1, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term1, succ1, kind1)
    var succ2: int32[]
    add(succ2, 3)
    var kind2: int32[]
    add(kind2, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term2, succ2, kind2)
    var succ3: int32[]
    var kind3: int32[]
    bindSuccessors(body, term3, succ3, kind3)
    sealControlFlow(body)
    return body

fn readUnresolvedTransport(originKinds: var int32[],
                           exactTypeIds: var int32[]) =
    add(originKinds, 4)   # 100 ManagedTemporary (cond)
    add(originKinds, 4)   # 101 ManagedTemporary (arm0_str)
    add(originKinds, 2)   # 102 BindingInitializer (out_str)
    add(exactTypeIds, fixtureTypeI32)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)

# ---- 运行腿 ----

fn validateFrozen(body: var coreir.BodyIR): bool =
    return freeze.ExactDefFreezeValidateInto(
        body, freeze.ExactDefFreezeProductionLimits())

fn runUnit(): int32 =
    let window = buildWindow()
    # ① CSR call consume。
    var originKinds: int32[]
    var exactTypeIds: int32[]
    csrConsumeTransport(originKinds, exactTypeIds)
    var body1 = buildCsrConsumeBody(3)
    deriveFixture(body1, originKinds, exactTypeIds, window)
    smokeAssert(validateFrozen(body1), "freeze smoke: leg1 CSR consume")
    smokeAssert(body1.exactDef.opReadADefOpRows[0] == -1 &&
                body1.exactDef.opReadADefOpRows[1] == -1 &&
                body1.exactDef.opReadADefOpRows[2] == -1,
                "freeze smoke: leg1 read edges empty")
    # ② loop 回边。
    originKinds = []
    exactTypeIds = []
    loopTransport(originKinds, exactTypeIds)
    var body2 = buildLoopBody()
    deriveFixture(body2, originKinds, exactTypeIds, window)
    smokeAssert(validateFrozen(body2), "freeze smoke: leg2 loop backedge")
    smokeAssert(body2.exactDef.opReadADefOpRows[2] == 1,
                "freeze smoke: leg2 read edge resolved")
    # ③ 跨块互斥臂。
    originKinds = []
    exactTypeIds = []
    mutexTransport(originKinds, exactTypeIds)
    var body3 = buildMutexBody()
    deriveFixture(body3, originKinds, exactTypeIds, window)
    smokeAssert(validateFrozen(body3), "freeze smoke: leg3 mutex arms")
    smokeAssert(body3.exactDef.opReadADefOpRows[2] == 1 &&
                body3.exactDef.opReadADefOpRows[3] == 1,
                "freeze smoke: leg3 read edges resolved")
    # ④ term RET consume。
    originKinds = []
    exactTypeIds = []
    retConsumeTransport(originKinds, exactTypeIds)
    var body4 = buildRetConsumeBody()
    deriveFixture(body4, originKinds, exactTypeIds, window)
    smokeAssert(validateFrozen(body4), "freeze smoke: leg4 RET consume")
    # ⑤ 同步扩列: derive 后追加物化行 (snapshot 槽 + 物化 move 定义 +
    # drop-glue call, cleanup_cfg.cheng:12250-12339 同形), 同步扩列后
    # 验证绿。物化消费链: o1 →(source 边) 物化 move →(source 边)
    # drop-glue call。追加走直数组写: cleanup 物化经
    # BodyIRControlFlowOpenExactMutation 解封/重封产出同样的终态
    # (追加 op 落在既有块内, term/后继不变, callTarget 行同步补齐),
    # 夹具直接构造该终态。
    originKinds = []
    exactTypeIds = []
    syncBaseTransport(originKinds, exactTypeIds)
    var body5 = buildSyncBaseBody()
    deriveFixture(body5, originKinds, exactTypeIds, window)
    let callStrSlot = body5.ops[1].valueDefSlot
    let snapshotSlot = addStrSlot(body5, "#canonical_return_snapshot#5#2")
    body5.localSlots[snapshotSlot].stackOffset = 4096
    var moveOp: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(moveOp)
    moveOp.kind = coreir.BodyOpCopyLocalTag
    moveOp.target = snapshotSlot
    moveOp.valueDefSlot = snapshotSlot
    moveOp.valueDefSemanticRow = 101
    moveOp.valueDefOwnership = coreir.OwnMove
    moveOp.valueDefOriginKind =
        coreir.BodyDefinitionOriginCanonicalCleanupActionTag
    moveOp.valueDefOriginId = 0
    moveOp.sourceDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    moveOp.sourceDefinitionRow = 1
    add(moveOp.operands, callStrSlot)
    let opMove = body5.ops.len
    add(body5.ops, moveOp)
    body5.ops[1].valueDefConsumeOpIndexPlusOne = opMove + 1
    var dropCall: coreir.CallOp
    coreir.BodyIRApplyCallOpDefaultProof(dropCall)
    dropCall.targetSymbol = "cheng_str_snapshot_release"
    dropCall.resultSlot = -1
    add(dropCall.argSlots, coreir.CallArgSlotAddress(snapshotSlot))
    add(dropCall.argPassKinds, coreir.BodyCallPassByAddressAggregateTag)
    add(dropCall.argAbiSizes, 8)
    dropCall.sourceDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    dropCall.sourceDefinitionRow = opMove
    add(body5.callSequence, dropCall)
    var dropOp: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(dropOp)
    dropOp.kind = coreir.BodyOpCallTag
    dropOp.target = -1
    add(dropOp.operands, 1)
    dropOp.sourceDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    dropOp.sourceDefinitionRow = opMove
    let opDrop = body5.ops.len
    add(body5.ops, dropOp)
    body5.ops[opMove].valueDefConsumeOpIndexPlusOne = opDrop + 1
    body5.blocks[0].opCount = body5.ops.len
    add(body5.callTargetDomainKinds,
        coreir.BodyCallTargetDomainRuntimeIntrinsicTag)
    add(body5.callTargetRows, 0)
    add(body5.callTargetInterfaceCids,
        layout.FixedBytes32Copy(fixtureCid()))
    smokeAssert(freeze.ExactDefFreezeSidecarSyncAppended(body5),
                "freeze smoke: leg5 sync appended")
    smokeAssert(exactdef.BodyIrExactDefSidecarShapeValid(body5),
                "freeze smoke: leg5 sidecar shape after sync")
    smokeAssert(validateFrozen(body5), "freeze smoke: leg5 sync validate")
    smokeAssert(body5.exactDef.opPlaceKinds[opMove] ==
                    exactdef.BodyIrExactDefPlaceTemporaryTag &&
                body5.exactDef.slotStorageKinds[snapshotSlot] ==
                    exactdef.BodyIrExactDefStorageStrTag,
                "freeze smoke: leg5 sync lanes")
    # ⑥ 判词构建器文本断言 (terminal 三判词 + reissuefail 形;
    # 结构性裁定见文件头)。
    let missingLine = freeze.ExactDefFreezeTestDirectReadMissingExtraLine(
        0, 7, 9, 1, 4, -1, 1, -1, -1, 3, 2, 2)
    smokeAssert(missingLine ==
                    "cheng_cold: managed direct-read edge missing/extra fn=0 op=7 kind=9 operand=1 slot=4 source=-1 required=1 b=-1 c=-1 slot_kind=3 slot_place=2 slot_storage=2",
                "freeze smoke: missing/extra verdict text")
    let invalidLine = freeze.ExactDefFreezeTestDirectReadInvalidLine(
        0, 7, 9, 1, 4, 3)
    smokeAssert(invalidLine ==
                    "cheng_cold: managed direct-read edge invalid fn=0 op=7 kind=9 operand=1 slot=4 source=3",
                "freeze smoke: invalid verdict text")
    os.WriteLine(os.Get_stdout(), "EXACT_DEF_FREEZE_UNIT_OK")
    return 0

fn runVerdictBrokenEdge(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    csrConsumeTransport(originKinds, exactTypeIds)
    # 禁 origin 通道回归形同族: 记录戳指向不命名该定义的 o0。
    var body = buildCsrConsumeBody(1)
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    if validateFrozen(body):
        return 1
    return 2

fn runVerdictMutexNegative(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    mutexNegativeTransport(originKinds, exactTypeIds)
    var body = buildMutexNegativeBody()
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    if validateFrozen(body):
        return 1
    return 2

fn runVerdictThreeConsumerNegative(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    threeConsumerNegativeTransport(originKinds, exactTypeIds)
    var body = buildThreeConsumerNegativeBody()
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    if validateFrozen(body):
        return 1
    return 2

fn runVerdictUseAfterConsume(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    useAfterConsumeTransport(originKinds, exactTypeIds)
    var body = buildUseAfterConsumeBody(false)
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    if validateFrozen(body):
        return 1
    return 2

fn runVerdictCapacityQueue(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    loopTransport(originKinds, exactTypeIds)
    var body = buildLoopBody()
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    var limits = freeze.ExactDefFreezeProductionLimits()
    limits.workQueueBlockCap = 1
    let _ = freeze.ExactDefFreezeValidateInto(body, limits)
    return 1

fn runVerdictCapacitySlice(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    useAfterConsumeTransport(originKinds, exactTypeIds)
    var body = buildUseAfterConsumeBody(true)
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    var limits = freeze.ExactDefFreezeProductionLimits()
    limits.reverseQueueCap = 1
    let _ = freeze.ExactDefFreezeValidateInto(body, limits)
    return 1

fn runVerdictReadAmbiguous(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    readAmbiguousTransport(originKinds, exactTypeIds)
    var body = buildReadAmbiguousBody()
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    # 夹具戳 poke (批 1 slotStorageKinds poke 同例): 当前定义的
    # exactType 车道改到不存在 TypeId → 该定义的边失效。
    body.exactDef.opExactTypeIds[2] = 999
    if validateFrozen(body):
        return 1
    return 2

fn runVerdictReadUnresolved(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    readUnresolvedTransport(originKinds, exactTypeIds)
    var body = buildReadUnresolvedBody()
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    if validateFrozen(body):
        return 1
    return 2

fn main(argc: int32, argv: ptr): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    var mode = "unit"
    if cmdline.ParamCount() >= 1:
        mode = cmdline.ParamStr(1)
    if mode == "":
        mode = "unit"
    if mode == "unit":
        return runUnit()
    if mode == "verdict-broken-edge":
        return runVerdictBrokenEdge()
    if mode == "verdict-mutex-negative":
        return runVerdictMutexNegative()
    if mode == "verdict-three-consumer-negative":
        return runVerdictThreeConsumerNegative()
    if mode == "verdict-use-after-consume":
        return runVerdictUseAfterConsume()
    if mode == "verdict-capacity-queue":
        return runVerdictCapacityQueue()
    if mode == "verdict-capacity-slice":
        return runVerdictCapacitySlice()
    if mode == "verdict-read-ambiguous":
        return runVerdictReadAmbiguous()
    if mode == "verdict-read-unresolved":
        return runVerdictReadUnresolved()
    os.WriteLine(os.Get_stdout(), Fmt"unknown mode: {mode}")
    return 2
