import std/system
import std/result
import std/strings
import std/strutils as strutil
import cheng/apps/libp2p_ingress/libp2p_ingress_http as ingress

fn smokeConfigInto(cfg: var ingress.Libp2pIngressConfig) =
    cfg.turnPublicHost = "64.176.84.12"
    var hosts: str[]
    hosts = []
    ingress.Libp2pIngressSplitCsvInto("64.176.84.12,154.26.191.226", hosts)
    cfg.turnPublicHosts = hosts
    cfg.turnPort = ingress.Libp2pIngressDefaultTurnPort
    cfg.turnSharedSecret = "turn-shared-secret"
    cfg.turnRealm = "unimaker.fun"
    cfg.turnCredentialTtlSec = ingress.Libp2pIngressDefaultTurnCredentialTtlSec

fn main(): int32 =
    var cfg = ingress.Libp2pIngressConfigInit()
    smokeConfigInto(cfg)
    assert(cfg.turnSharedSecret == "turn-shared-secret",
           "libp2p ingress http: config secret")
    let configuredHosts = cfg.turnPublicHosts
    assert(configuredHosts[1] == "154.26.191.226",
           "libp2p ingress http: config host item")
    assert(strutil.Strip(cfg.turnSharedSecret) == "turn-shared-secret",
           "libp2p ingress http: config strip")
    assert(ingress.Libp2pIngressCat("a", "b") == "ab",
           "libp2p ingress http: cat")
    assert(ingress.Libp2pIngressCat3("a", "b", "c") == "abc",
           "libp2p ingress http: cat3")
    assert(strings.StrContains(ingress.Libp2pIngressJsonQuote("abc"), "\"abc\""),
           "libp2p ingress http: json quote")
    assert(strings.StrContains(ingress.Libp2pIngressJsonStringArray(["one", "two"]), "[\"one\",\"two\"]"),
           "libp2p ingress http: json array")
    assert(strings.StrContains(ingress.Libp2pIngressJsonStringArray(ingress.Libp2pIngressBuildStunUrls(["64.176.84.12"], 3478)), "\"stun:64.176.84.12:3478\""),
           "libp2p ingress http: stun builder")
    let earlyPool = ingress.Libp2pIngressPoolHosts(cfg)
    assert(earlyPool[1] == "154.26.191.226",
           "libp2p ingress http: early pool item")
    assert(ingress.Libp2pIngressIceConfigured(cfg),
           "libp2p ingress http: ice configured")
    assert(strings.StrContains(ingress.Libp2pIngressJsonStringArray(ingress.Libp2pIngressPoolHosts(cfg)), "\"154.26.191.226\""),
           "libp2p ingress http: pool hosts early")
    let smokeCredential = ingress.Libp2pIngressHmacSha1Base64("turn-shared-secret",
                                                              "1800000600:peer-turn")
    assert(smokeCredential == "AqQNrETU6gnaFtagr8fIZhhD0hk=",
           "libp2p ingress http: hmac early")
    let smokePartial = ingress.Libp2pIngressCat3("{\"ok\":true,\"credential\":",
                                                 ingress.Libp2pIngressJsonQuote(smokeCredential),
                                                 "}")
    assert(strings.StrContains(smokePartial, "\"ok\":true"),
           "libp2p ingress http: partial body early")
    let iceRes: Result[str] = ingress.Libp2pIngressBuildIceConfigJson(cfg,
                                                                       "peer-turn",
                                                                       int64(1800000000))
    assert(IsOk(iceRes), "libp2p ingress http: ice config")
    let ice = Value(iceRes)
    assert(strings.StrContains(ice, "\"ok\":true"), "libp2p ingress http: ok")
    assert(strings.StrContains(ice, "\"realm\":\"unimaker.fun\""), "libp2p ingress http: realm")
    assert(strings.StrContains(ice, "\"poolHosts\":[\"64.176.84.12\",\"154.26.191.226\"]"), "libp2p ingress http: pool hosts")
    assert(strings.StrContains(ice, "\"stun:64.176.84.12:3478\""), "libp2p ingress http: stun")
    assert(strings.StrContains(ice, "\"turn:64.176.84.12:3478?transport=udp\""), "libp2p ingress http: turn udp")
    assert(strings.StrContains(ice, "\"username\":\"1800000600:peer-turn\""), "libp2p ingress http: username")
    assert(strings.StrContains(ice, "\"credential\":\"AqQNrETU6gnaFtagr8fIZhhD0hk=\""), "libp2p ingress http: hmac")

    let ready = ingress.Libp2pIngressHandleRequestText(cfg,
                                                        "GET /readyz HTTP/1.1\r\nHost: test\r\n\r\n",
                                                        int64(1800000000))
    assert(ready.statusCode == 200, "libp2p ingress http: ready status")
    assert(strings.StrContains(ready.body, "\"iceConfigured\":true"), "libp2p ingress http: ready body")

    let route = ingress.Libp2pIngressHandleRequestText(cfg,
                                                        "GET /v1/libp2p/webrtc/ice-config?peerId=peer-turn HTTP/1.1\r\nHost: test\r\n\r\n",
                                                        int64(1800000000))
    assert(route.statusCode == 200, "libp2p ingress http: route status")
    assert(strings.StrContains(route.body, "\"username\":\"1800000600:peer-turn\""), "libp2p ingress http: route body")
    let wire = ingress.Libp2pIngressHttpResponseWire(route)
    assert(strings.StrContains(wire, "HTTP/1.1 200 OK\r\n"), "libp2p ingress http: wire status")
    assert(strings.StrContains(wire, "Content-Type: application/json; charset=utf-8\r\n"), "libp2p ingress http: wire content type")

    var missing = ingress.Libp2pIngressConfigInit()
    let missingRoute = ingress.Libp2pIngressHandleRequestText(missing,
                                                               "GET /v1/libp2p/webrtc/ice-config?peerId=peer-turn HTTP/1.1\r\nHost: test\r\n\r\n",
                                                               int64(1800000000))
    assert(missingRoute.statusCode == 503, "libp2p ingress http: missing status")
    assert(strings.StrContains(missingRoute.body, "\"error\":\"webrtc_ice_not_configured\""), "libp2p ingress http: missing error")

    let methodRoute = ingress.Libp2pIngressHandleRequestText(cfg,
                                                              "POST /readyz HTTP/1.1\r\nHost: test\r\n\r\n",
                                                              int64(1800000000))
    assert(methodRoute.statusCode == 405, "libp2p ingress http: method status")

    let notFound = ingress.Libp2pIngressHandleRequestText(cfg,
                                                           "GET /missing HTTP/1.1\r\nHost: test\r\n\r\n",
                                                           int64(1800000000))
    assert(notFound.statusCode == 404, "libp2p ingress http: not found")

    echo("libp2p_ingress_http_smoke ok")
    return 0
