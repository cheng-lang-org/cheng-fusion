import std/os
import std/strings

fn main(): int32 =
    let root = os.GetCurrentDir()
    let sourcePath = os.JoinPath(root, "src/libp2p/mobile_ffi/unimaker_compat_ffi.cheng")
    let sourceText = os.ReadFile(sourcePath)

    assert(strings.StrContains(sourceText, "contentAnnounceTopic = \"unimaker/content/v1\""),
           " unimaker content topic gossip: content topic constant exists")

    # Subscribe/unsubscribe use the pre-existing generic pubsub entrypoints
    # (libp2p_pubsub_subscribe/unsubscribe), not a duplicated per-topic
    # wrapper -- Android/HarmonyOS drive those directly with the content
    # topic string.
    assert(strings.StrContains(sourceText, "fn libp2p_pubsub_subscribe(handle: int64, topicPtr: void*, callback: void*, userData: void*): void*") &&
           strings.StrContains(sourceText, "um_hostGossipsubSubscribe(topicText)"),
           " unimaker content topic gossip: generic subscribe stays topic-agnostic")

    # The single shared gossip-inbox drain is topic-routed, not social-only.
    assert(strings.StrContains(sourceText, "fn drainInboundGossipMessages(node: var NodeRuntime): int32") &&
           strings.StrContains(sourceText, "let socialPrefix: str = socialPublishMetadataTopic + charToStr(chr(31))") &&
           strings.StrContains(sourceText, "let contentPrefix: str = contentAnnounceTopic + charToStr(chr(31))") &&
           strings.StrContains(sourceText, "storeReceivedSocialPublishMetadata(node, data)") &&
           strings.StrContains(sourceText, "storeReceivedContentAnnounce(node, data)"),
           " unimaker content topic gossip: drain routes both topics by prefix, not social-only")
    assert(!strings.StrContains(sourceText, "fn drainInboundSocialMetadata"),
           " unimaker content topic gossip: social-only drain name retired (generalized, not duplicated)")

    # Receiver-side store requires a resolvable content id and uses structured
    # json (contentId falling back to id/postId), mirroring the social path's
    # use of json.ParseJsonSafe + JsonTryGetStr rather than substring hacks.
    assert(strings.StrContains(sourceText, "fn storeReceivedContentAnnounce(node: var NodeRuntime, payloadJson: str): Result[str]") &&
           strings.StrContains(sourceText, "json.ParseJsonSafe(normalized)") &&
           strings.StrContains(sourceText, "let contentId: str = contentIdFromJsonValue(parsed.value)") &&
           strings.StrContains(sourceText, "return Err[str](\"missing_content_id\")"),
           " unimaker content topic gossip: received announce uses structured json + requires content id")

    # Idempotent dedup: receiver checks the shared feed store for the same
    # content id before storing, on both the gossip-receive path and the
    # ingress/local feedPublishEntry path, so dual-channel arrival of the same
    # content id lands in the feed store exactly once.
    assert(strings.StrContains(sourceText, "if findFeedEntryByContentId(node, contentId):") &&
           strings.StrContains(sourceText, "return Ok[str](contentId)") &&
           strings.StrContains(sourceText, "storeFeedEntryLocal(node, normalized)"),
           " unimaker content topic gossip: gossip receive dedupes before store")
    assert(strings.StrContains(sourceText, "let dedupContentId: str = feedEntryContentIdOrEmpty(payloadJson)") &&
           strings.StrContains(sourceText, "if len(dedupContentId) > 0 && findFeedEntryByContentId(*node, dedupContentId):") &&
           strings.StrContains(sourceText, "fn libp2p_feed_publish_entry(handle: int64, payloadJsonPtr: void*): bool"),
           " unimaker content topic gossip: ingress feed_publish_entry path also dedupes (dual-channel arrival is idempotent)")

    # A genuinely new content announce notifies the same "moments"/"upsert"
    # entity the Android ingress content handler already uses, so the
    # existing shouldRefreshMoments dispatch picks it up without new wiring.
    assert(strings.StrContains(sourceText, "emitSocialEvent(node, \"moments\", \"upsert\", normalized, \"\", \"\", contentId)"),
           " unimaker content topic gossip: new content announce emits moments/upsert notification")

    # The drain is triggered from social_poll_events, the one poll point every
    # platform's live event loop already calls every cycle -- no dedicated
    # per-platform drain trigger is required once a client subscribes.
    assert(strings.StrContains(sourceText, "fn social_poll_events(handle: int64, maxEventsRequested: int32): cstring") &&
           strings.StrContains(sourceText, "let _ = drainInboundGossipMessages(*node)\n    return dupCString(queueDrain(node->socialEvents, maxEventsRequested))"),
           " unimaker content topic gossip: social_poll_events drains the shared gossip inbox every poll cycle")

    echo(" unimaker_content_topic_gossip_dedup_contract_smoke ok")
    return 0
