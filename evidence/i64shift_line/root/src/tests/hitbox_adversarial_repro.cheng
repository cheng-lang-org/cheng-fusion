import cheng/core/runtime/web_scene_runtime as scene
import cheng/core/runtime/web_layout_runtime as layout

# Adversarial repro: a single text node wrapped across two lines legitimately
# produces TWO box records in tree.boxes for the SAME nodeId (one per line),
# both real/visible/non-zero-size -- this is not a stale re-layout duplicate.
# If WebSceneRefreshRouteLayoutBoxes collapses to only the canonical
# (first-visible) record, the second line becomes un-hit-testable.
fn main(): int32 =
    var tree: layout.WebLayoutTree
    layout.WebLayoutTreeInit(tree)
    if !layout.WebLayoutTreeAddStyle(tree, 5001, layout.WebLayoutDisplayInline, 0, 0, 0, 0):
        return 1
    # line 1 of wrapped text: y=0
    layout.WebLayoutRecordBox(tree, 5001, 0, 0, 50, 20)
    # line 2 of wrapped text, SAME nodeId, non-overlapping y=20
    layout.WebLayoutRecordBox(tree, 5001, 0, 20, 30, 20)

    var graph: scene.WebSceneGraph
    scene.WebSceneGraphInit(graph)
    var route = -1
    if !scene.WebSceneAddRoute(graph, "wrap_test", 5001, 1, route):
        return 2
    if !scene.WebSceneRefreshRouteLayoutBoxes(graph, route, tree):
        return 3

    var count = 0
    var sawLine1 = false
    var sawLine2 = false
    for i in 0..<graph.layoutBoxes.len:
        if graph.layoutBoxes[i].nodeId == 5001:
            count = count + 1
            if graph.layoutBoxes[i].y == 0:
                sawLine1 = true
            if graph.layoutBoxes[i].y == 20:
                sawLine2 = true
    echo(Fmt"line-box count for wrapped-text nodeId=5001: {count}")
    echo(Fmt"sawLine1(y=0)={sawLine1} sawLine2(y=20)={sawLine2}")
    if count != 2 || !sawLine1 || !sawLine2:
        echo("REGRESSION: second wrapped-text line box missing from hit-test list")
        return 42
    echo("both wrapped-text line boxes present in hit-test list")
    return 0
