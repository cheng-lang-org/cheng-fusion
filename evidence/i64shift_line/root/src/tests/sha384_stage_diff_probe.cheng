# SHA-384 阶段差分探针：逐字复制 sha384Digest 体内联，输出各阶段中间值，
# 与 Python 黄金实现对比定位 miscompile 的发散点。
import std/system
import std/result
import std/rawbytes
import std/strutils as strutil
import std/crypto/sha384 as sha384m
import std/crypto/rsa as rsacrypto

fn u64hex(v: uint64): str =
    var tmp: Bytes = BytesAlloc(8)
    sha384m.sha384SetU64BE(tmp, 0, v)
    return BytesToHex(tmp)

fn main(): int32 =
    let data: Bytes = BytesFromString("abc")
    let inputLen: int32 = BytesLen(data)
    var padZero: int32
    while ((inputLen + 1 + padZero) % 128) != 112:
        padZero = padZero + 1
    let totalLen: int32 = inputLen + 1 + padZero + 16
    let msg: Bytes = BytesAlloc(totalLen)
    var i: int32
    for i in i..<inputLen:
        BytesSet(msg, i, BytesGet(data, i))
    BytesSet(msg, inputLen, 0x80)
    for padIdx in inputLen + 1..<totalLen - 16:
        BytesSet(msg, padIdx, 0)
    let bitLenLow: uint64 = uint64(inputLen) * 8
    let bitLenHigh: uint64 = 0
    sha384m.sha384SetU64BE(msg, totalLen - 16, bitLenHigh)
    sha384m.sha384SetU64BE(msg, totalLen - 8, bitLenLow)
    echo(strutil.Join(["probe: totalLen=", IntToStr(totalLen), " padZero=", IntToStr(padZero)], ""))
    echo(strutil.Join(["probe: msgTail=", BytesToHex(BytesSlice(msg, totalLen - 16, 16))], ""))

    var h0: uint64 = sha384m.sha384U64FromBytes(0xcb, 0xbb, 0x9d, 0x5d, 0xc1, 0x05, 0x9e, 0xd8)
    var h1: uint64 = sha384m.sha384U64FromBytes(0x62, 0x9a, 0x29, 0x2a, 0x36, 0x7c, 0xd5, 0x07)
    var h2: uint64 = sha384m.sha384U64FromBytes(0x91, 0x59, 0x01, 0x5a, 0x30, 0x70, 0xdd, 0x17)
    var h3: uint64 = sha384m.sha384U64FromBytes(0x15, 0x2f, 0xec, 0xd8, 0xf7, 0x0e, 0x59, 0x39)
    var h4: uint64 = sha384m.sha384U64FromBytes(0x67, 0x33, 0x26, 0x67, 0xff, 0xc0, 0x0b, 0x31)
    var h5: uint64 = sha384m.sha384U64FromBytes(0x8e, 0xb4, 0x4a, 0x87, 0x68, 0x58, 0x15, 0x11)
    var h6: uint64 = sha384m.sha384U64FromBytes(0xdb, 0x0c, 0x2e, 0x0d, 0x64, 0xf9, 0x8f, 0xa7)
    var h7: uint64 = sha384m.sha384U64FromBytes(0x47, 0xb5, 0x48, 0x1d, 0xbe, 0xfa, 0x4f, 0xa4)
    var h0b: Bytes = BytesAlloc(8)
    sha384m.sha384SetU64BE(h0b, 0, h0)
    echo(strutil.Join(["probe: h0_init=", BytesToHex(h0b)], ""))

    let wbuf: Bytes = BytesAlloc(80 * 8)
    var offset: int32
    var t: int32
    while offset < totalLen:
        t = 0
        for t in t..<16:
            let word: uint64 = sha384m.sha384GetU64BE(msg, offset + t * 8)
            sha384m.sha384SetU64BE(wbuf, t * 8, word)
        echo(strutil.Join(["probe: block0_w0=", BytesToHex(BytesSlice(wbuf, 0, 8)),
                           " w1=", BytesToHex(BytesSlice(wbuf, 8, 8))], ""))
        t = 16
        for t in t..<80:
            let w2: uint64 = sha384m.sha384GetU64BE(wbuf, (t - 2) * 8)
            let w7: uint64 = sha384m.sha384GetU64BE(wbuf, (t - 7) * 8)
            let w15: uint64 = sha384m.sha384GetU64BE(wbuf, (t - 15) * 8)
            let w16: uint64 = sha384m.sha384GetU64BE(wbuf, (t - 16) * 8)
            let next: uint64 = (w16 + sha384m.sha384SmallSigma0(w15) + w7 + sha384m.sha384SmallSigma1(w2))
            sha384m.sha384SetU64BE(wbuf, t * 8, next)
        echo(strutil.Join(["probe: w16=", BytesToHex(BytesSlice(wbuf, 128, 8)),
                           " w17=", BytesToHex(BytesSlice(wbuf, 136, 8)),
                           " w79=", BytesToHex(BytesSlice(wbuf, 632, 8))], ""))

        var a: uint64 = h0
        var b: uint64 = h1
        var c: uint64 = h2
        var d: uint64 = h3
        var e: uint64 = h4
        var f: uint64 = h5
        var g: uint64 = h6
        var h: uint64 = h7
        t = 0
        for t in t..<80:
            let wt: uint64 = sha384m.sha384GetU64BE(wbuf, t * 8)
            let t1: uint64 = (h + sha384m.sha384BigSigma1(e) + sha384m.sha384Ch(e, f, g) + sha384m.sha384K512(t) + wt)
            let t2: uint64 = (sha384m.sha384BigSigma0(a) + sha384m.sha384Maj(a, b, c))
            h = g
            g = f
            f = e
            e = (d + t1)
            d = c
            c = b
            b = a
            a = (t1 + t2)
            if t == 0 || t == 1 || t == 79:
                var tmp: Bytes = BytesAlloc(8)
                sha384m.sha384SetU64BE(tmp, 0, a)
                var tmpe: Bytes = BytesAlloc(8)
                sha384m.sha384SetU64BE(tmpe, 0, e)
                echo(strutil.Join(["probe: round=", IntToStr(t),
                                   " a=", BytesToHex(tmp),
                                   " e=", BytesToHex(tmpe)], ""))
        h0 = (h0 + a)
        h1 = (h1 + b)
        h2 = (h2 + c)
        h3 = (h3 + d)
        h4 = (h4 + e)
        h5 = (h5 + f)
        h6 = (h6 + g)
        h7 = (h7 + h)
        offset = offset + 128

    let out: Bytes = BytesAlloc(48)
    sha384m.sha384SetU64BE(out, 0, h0)
    sha384m.sha384SetU64BE(out, 8, h1)
    sha384m.sha384SetU64BE(out, 16, h2)
    sha384m.sha384SetU64BE(out, 24, h3)
    sha384m.sha384SetU64BE(out, 32, h4)
    sha384m.sha384SetU64BE(out, 40, h5)
    echo(strutil.Join(["probe: digest=", BytesToHex(out)], ""))
    return 0
