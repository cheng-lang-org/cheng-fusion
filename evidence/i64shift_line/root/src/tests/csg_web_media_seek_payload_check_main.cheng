# S6 (video-seek-scrub-blueprint.md §1.3/§S6, task #14 CSG payload 贯通) roundtrip fixture:
# CSG Seek payload — struct field, WithPayload parse, backward-compat empty-payload shape,
# effect-segment routing via an explicit slotId (drag-handle sibling, not a video-subtree
# descendant), and text<->struct round trip stability. Isolated standalone main() (not
# folded into web_scene_runtime_smoke.cheng's single sequential ladder) so this fixture's
# result is never masked by an unrelated failure earlier in that ladder.

import cheng/core/runtime/web_scene_runtime as scene

fn main(): int32 =
    var graph: scene.WebSceneGraph
    scene.WebSceneGraphInit(graph)
    if !scene.WebSceneAddRouteExpectedIndex(graph, "media_seek", 1, 1, 0):
        return 1
    if !scene.WebSceneSetActiveRouteByIndex(graph, 0):
        return 2
    if !scene.WebSceneAddLayer(graph, 0, 1, "content", 0):
        return 3
    if !scene.WebSceneAddNode(graph, 0, 50001, 0, 2, "video", "", 1):
        return 4
    # Sibling drag-handle node — a controls-overlay slider is NOT a descendant of the video
    # node in real markup — proving the new explicit-slotId routing
    # (WebSceneApplyMediaControlForSlotWithPayload) is used, not the ancestor walk every
    # other media_lifecycle branch relies on.
    if !scene.WebSceneAddNode(graph, 0, 50002, 0, 2, "div", "", 1):
        return 5
    var asset: scene.WebSceneMediaAsset
    asset.assetFactId = "csg.web.media_asset.seek-video"
    asset.assetCid = "bafy-seek-video-asset"
    asset.bundleCid = "bafy-seek-video-bundle"
    asset.mime = "video/mp4"
    asset.kindCode = 1
    asset.durationMs = "22500"
    asset.codec = "avc1.64001f"
    asset.posterCid = "bafy-seek-video-poster"
    asset.initSegmentCid = "bafy-seek-video-init"
    asset.initSegmentByteLength = 4096
    asset.keyframeIndex = "0:0"
    asset.transport = "moq"
    asset.fecScheme = "raptorq-v1"
    asset.contentSignature = "sig-ed25519-seek"
    asset.catalogCid = "bafy-seek-video-catalog"
    asset.catalogKey = "seek/catalog"
    asset.rebuildTemplateCid = "bafy-seek-video-rebuild"
    asset.rebuildTemplateKey = "seek/rebuild"
    asset.objectTargetBytes = 4096
    asset.sourceBlockBytes = 4096
    asset.objectCount = 1
    asset.dropletCount = 1
    if !scene.WebSceneAddMediaAsset(graph, asset):
        return 6
    var slot: scene.WebSceneMediaPlaybackSlot
    slot.slotId = "seek.slot.0.1"
    slot.assetFactId = "csg.web.media_asset.seek-video"
    slot.assetCid = "bafy-seek-video-asset"
    slot.manifestCid = "bafy-seek-video-manifest"
    slot.nodeTemplate = "csg.web.scene.node.0.50001"
    slot.routeIndex = 0
    slot.nodeId = 50001
    slot.providerKind = "media-decode-provider"
    slot.stateRef = "media:seek.slot.0.1"
    slot.decodeProvider = "macos-videotoolbox-codec-provider"
    slot.textureProvider = "metal-surface-texture-provider"
    slot.audioProvider = "macos-coreaudio-provider"
    slot.objectFit = "cover"
    if !scene.WebSceneAddMediaPlaybackSlot(graph, slot):
        return 7
    if scene.WebSceneMediaSlotSeekPositionMs(graph, "seek.slot.0.1") != 0:
        return 8
    var openControl: scene.WebSceneMediaControlAction
    openControl.slotId = "seek.slot.0.1"
    openControl.actionKind = "OpenAsset"
    openControl.payloadSchema = "unimaker.media.lifecycle.runtime.v1"
    openControl.dispatch = "event-queue"
    openControl.guard = "assetCid:bafy-seek-video-asset"
    openControl.trace = "trace.seek.open"
    if !scene.WebSceneAddMediaControlAction(graph, openControl):
        return 9
    var seekControl: scene.WebSceneMediaControlAction
    seekControl.slotId = "seek.slot.0.1"
    seekControl.actionKind = "Seek"
    seekControl.payloadSchema = "unimaker.media.lifecycle.runtime.v1"
    seekControl.dispatch = "event-queue"
    seekControl.guard = "assetCid:bafy-seek-video-asset"
    seekControl.trace = "trace.seek.seek"
    if !scene.WebSceneAddMediaControlAction(graph, seekControl):
        return 10
    var pauseControl: scene.WebSceneMediaControlAction
    pauseControl.slotId = "seek.slot.0.1"
    pauseControl.actionKind = "Pause"
    pauseControl.payloadSchema = "unimaker.media.lifecycle.runtime.v1"
    pauseControl.dispatch = "event-queue"
    pauseControl.guard = "assetCid:bafy-seek-video-asset"
    pauseControl.trace = "trace.seek.pause"
    if !scene.WebSceneAddMediaControlAction(graph, pauseControl):
        return 34
    if !scene.WebSceneApplyMediaControl(graph, "seek.slot.0.1", "OpenAsset"):
        return 11
    if scene.WebSceneMediaSlotPlaybackState(graph, "seek.slot.0.1") != scene.WebSceneMediaPlaybackOpened:
        return 12

    # 1. Backward compatibility: empty-payload Seek (the pre-existing call shape two other
    # smoke tests already rely on) keeps working exactly as before — bare transition, no ms.
    if !scene.WebSceneApplyMediaControl(graph, "seek.slot.0.1", "Seek"):
        return 13
    if scene.WebSceneMediaSlotPlaybackState(graph, "seek.slot.0.1") != scene.WebSceneMediaPlaybackSeeked:
        return 14
    if scene.WebSceneMediaSlotSeekPositionMs(graph, "seek.slot.0.1") != 0:
        return 15

    # 2. Direct WithPayload call (the JNI/NAPI dispatch shape, cheng_app_media_control):
    # a numeric payload lands in the new struct field.
    if !scene.WebSceneApplyMediaControlWithPayload(graph, "seek.slot.0.1", "Seek", "4200"):
        return 16
    if scene.WebSceneMediaSlotSeekPositionMs(graph, "seek.slot.0.1") != 4200:
        return 17

    # 3. Malformed payload fails closed, not a silent coerce/truncate.
    if scene.WebSceneApplyMediaControlWithPayload(graph, "seek.slot.0.1", "Seek", "12ms"):
        return 18
    if scene.WebSceneMediaSlotSeekPositionMs(graph, "seek.slot.0.1") != 4200:
        return 19

    # Move off Seeked before the dirty-marking checks below: ForSlotWithPayload's dirty
    # mark is gated on a REAL playbackState transition (mirrors WebSceneApplyMediaControlForNode's
    # existing gate) — steps 1-3 above went through the direct, non-dirty-tracking
    # WebSceneApplyMediaControl(WithPayload) API, so playbackState is already Seeked; without
    # this Pause, step 4's Seek would be a Seeked->Seeked no-op transition and never mark dirty.
    if !scene.WebSceneApplyMediaControl(graph, "seek.slot.0.1", "Pause"):
        return 20
    if scene.WebSceneMediaSlotPlaybackState(graph, "seek.slot.0.1") != scene.WebSceneMediaPlaybackPaused:
        return 21

    # 4. Effect-segment round trip (the declarative/materializer shape): drag-handle node
    # 50002 (a sibling of video node 50001, not a descendant) carries the explicit slotId.
    if !scene.WebSceneAddEventHandlerWithAction(graph,
                                                0,
                                                50002,
                                                0,
                                                0,
                                                "onPointerUp",
                                                "pointerUp",
                                                "videoRef.current.seekTo",
                                                "event_handler",
                                                "media_lifecycle",
                                                "",
                                                "media_lifecycle:Seek:seek.slot.0.1:9000"):
        return 22
    scene.WebSceneClearDirty(graph)
    if !scene.WebSceneApplyNodeEventEffect(graph, 0, 50002, "pointerUp", true):
        return 23
    if scene.WebSceneMediaSlotSeekPositionMs(graph, "seek.slot.0.1") != 9000:
        return 24
    if scene.WebSceneMediaSlotPlaybackState(graph, "seek.slot.0.1") != scene.WebSceneMediaPlaybackSeeked:
        return 25
    if scene.WebSceneDirtyCount(graph) != 1:
        return 26

    # 5. Round trip (the "双向" requirement): re-emit the segment text from the just-applied
    # struct state and reapply it — idempotent, same target reproduces the same field, and
    # (since the resulting state is unchanged) no new dirty mark on the repeat application.
    let seekMs = scene.WebSceneMediaSlotSeekPositionMs(graph, "seek.slot.0.1")
    let roundTripSegment = Fmt"media_lifecycle:Seek:seek.slot.0.1:{seekMs}"
    if roundTripSegment != "media_lifecycle:Seek:seek.slot.0.1:9000":
        return 27
    scene.WebSceneClearDirty(graph)
    if scene.WebSceneApplyEventEffectSegmentForNode(graph, 0, 50002, roundTripSegment, true) < 0:
        return 28
    if scene.WebSceneMediaSlotSeekPositionMs(graph, "seek.slot.0.1") != 9000:
        return 29
    if scene.WebSceneDirtyCount(graph) != 0:
        return 30

    # 6. Malformed effect segment (missing the numeric field) fails closed and leaves the
    # struct state untouched.
    if !scene.WebSceneAddEventHandlerWithAction(graph,
                                                0,
                                                50002,
                                                1,
                                                0,
                                                "onPointerDown",
                                                "pointerDown",
                                                "videoRef.current.seekTo",
                                                "event_handler",
                                                "media_lifecycle",
                                                "",
                                                "media_lifecycle:Seek:seek.slot.0.1"):
        return 31
    if scene.WebSceneApplyNodeEventEffect(graph, 0, 50002, "pointerDown", true):
        return 32
    if scene.WebSceneMediaSlotSeekPositionMs(graph, "seek.slot.0.1") != 9000:
        return 33

    echo("csg_web_media_seek_payload_check_main ok")
    return 0
