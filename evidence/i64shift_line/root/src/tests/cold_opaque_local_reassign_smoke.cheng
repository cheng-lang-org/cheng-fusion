# Regression: assignment to a plain ptr/opaque local must copy the value into
# the slot. cold previously routed SLOT_OPAQUE locals through PAYLOAD_STORE,
# dereferencing the stale value as the store address (silent memory
# corruption / SIGSEGV). Covers straight-line, if-branch and else-branch
# reassignment from call results.
fn helper(): ptr =
    return ptr(uint64(8192))

fn pick(flag: int32): ptr =
    let seed: uint64 = uint64(4096)
    var block: ptr = ptr(seed)
    if flag != 0:
        let keep: uint64 = uint64(block)
        block = ptr(keep)
    else:
        block = helper()
    return block

fn main(): int32 =
    var direct: ptr = helper()
    direct = helper()
    if direct != ptr(uint64(8192)):
        return 1
    if pick(0) != ptr(uint64(8192)):
        return 2
    if pick(1) != ptr(uint64(4096)):
        return 3
    return 0
