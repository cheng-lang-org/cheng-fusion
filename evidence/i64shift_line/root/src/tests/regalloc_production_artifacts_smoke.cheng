import cheng/core/backend/regalloc_production_artifacts as artifacts
import cheng/core/backend/regalloc_single_pass as alloc
import cheng/core/backend/regalloc_aarch64_adapter as adapter
import cheng/core/backend/regalloc_production_emitter as emitter
import cheng/core/ir/core_types as ir
import cheng/std/bytes_layout as layout
import std/strutils as strutil

fn hash1(): str =
    return "1111111111111111111111111111111111111111111111111111111111111111"

fn hash2(): str =
    return "2222222222222222222222222222222222222222222222222222222222222222"

fn hash3(): str =
    return "3333333333333333333333333333333333333333333333333333333333333333"

fn hash4(): str =
    return "4444444444444444444444444444444444444444444444444444444444444444"

fn hash5(): str =
    return "5555555555555555555555555555555555555555555555555555555555555555"

fn hash6(): str =
    return "6666666666666666666666666666666666666666666666666666666666666666"

fn machineHash(): str =
    return "7777777777777777777777777777777777777777777777777777777777777777"

fn symbolHash(): str =
    return "8888888888888888888888888888888888888888888888888888888888888888"

fn artifactTypeArenaCid(): layout.FixedBytes32 =
    let parsed = layout.FixedBytes32FromHex(hash6())
    assert(parsed.ok, " regalloc artifact: TypeArena CID fixture invalid")
    return parsed.value

fn makeArgSlot(id: int32): ir.LocalSlot =
    var slot: ir.LocalSlot
    slot.id = id
    slot.name = "artifact_arg"
    slot.typeKind = ir.LocalI32Tag
    slot.stackOffset = 0 - 1 - id
    slot.sizeBytes = 4
    slot.alignBytes = 4
    ir.BodyIRApplyLocalSlotDefaultProof(slot)
    return slot

fn buildTenArgCall(): ir.BodyIR =
    var body = ir.BodyIRNew()
    assert(ir.BodyIRBindTypeArenaArtifactCid(
               body, artifactTypeArenaCid()),
           " regalloc artifact: BodyIR TypeArena identity")
    for slotIndex in 0..<10:
        add(body.localSlots, makeArgSlot(slotIndex))
    var call: ir.CallOp
    ir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = "artifact_target"
    call.resultSlot = -1
    call.resultPassKind = ir.BodyCallPassStackValueTag
    call.relocWordOffset = -1
    for argIndex in 0..<10:
        add(call.argSlots, argIndex)
        add(call.argPassKinds, ir.BodyCallPassStackValueTag)
        add(call.argAbiSizes, 4)
    add(body.callSequence, call)
    var op: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = ir.BodyOpCallTag
    op.target = -1
    add(op.operands, 0)
    add(body.ops, op)
    var term: ir.BodyTerm
    ir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = -1
    let termIndex = ir.BodyIRAppendTerm(body, term)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn buildEmission(
        symbol: str,
        symbolStart: int32,
        functionIrIndex: int32): emitter.RegallocProductionFunctionEmission =
    var body = buildTenArgCall()
    var targets: str[]
    add(targets, "_artifact_target")
    var dataTargets: str[]
    return emitter.RegallocProductionEmitFunction(
        "arm64-apple-darwin",
        body, symbol, symbolStart, targets, dataTargets,
        functionIrIndex, artifacts.RegallocProductionFunctionKindNormal)

fn snapshotMetadata(): artifacts.RegallocProductionSnapshotMetadata =
    var out: artifacts.RegallocProductionSnapshotMetadata
    out.fixtureSourceSha256 = hash1()
    out.sourceManifestSha256 = hash2()
    out.driverSha256 = hash3()
    out.target = artifacts.RegallocProductionTargetA64Darwin
    return out

fn ledgerMetadata(): artifacts.RegallocProductionLedgerMetadata =
    var out: artifacts.RegallocProductionLedgerMetadata
    out.fixtureSourceSha256 = hash1()
    out.outputObjectSha256 = hash6()
    out.target = artifacts.RegallocProductionTargetA64Darwin
    return out

fn invalidSymbols(): str[] =
    var out: str[]
    add(out, "bad symbol")
    add(out, "bad.symbol")
    add(out, "bad=symbol")
    return out

fn checkFieldContracts(): int32 =
    let actionNames = strutil.Join(
        artifacts.RegallocProductionArtifactActionFieldNames(), " ")
    let expectedActions =
        "consumer_ordinal action_kind placement position block_index op_index term_index fact_index value_id other_value_id source_location target_location source_reg target_reg source_stack_slot target_stack_slot scratch_reg target_memory_home source_block target_block edge_index requires_edge_split parallel_group parallel_ordinal related_action_ordinal fixed_kind fixed_ordinal pass_kind encoded_value call_ordinal abi_size_bytes abi_size_explicit outgoing_stack_arg_index outgoing_stack_byte_offset outgoing_stack_byte_width outgoing_stack_frame_bytes semantic_kind semantic_start semantic_end semantic_register"
    if artifacts.RegallocProductionArtifactActionFieldCount() != 40 ||
       actionNames != expectedActions:
        return 1
    let constraintNames = strutil.Join(
        artifacts.RegallocProductionArtifactConstraintFieldNames(), " ")
    let expectedConstraints =
        "register_universe allocatable_caller_regs allocatable_callee_regs reserved_regs call_clobber_regs fixed_arg_regs fixed_result_reg fixed_sret_reg sret_shifts_fixed_args fixed_return_reg parallel_copy_scratch_reg packed_stack_args stack_arg_slot_bytes stack_alignment_bytes gpr_type_kinds"
    if artifacts.RegallocProductionArtifactConstraintFieldCount() != 15 ||
       constraintNames != expectedConstraints:
        return 2
    let planNames = strutil.Join(
        artifacts.RegallocProductionArtifactPlanFieldNames(), " ")
    let expectedPlans =
        "debug_provenance_sha256 stack_slot_count call_count call_arg_counts call_reachable position_count block_entry_positions block_exit_positions body_op_kinds body_op_operand_counts op_before_positions op_after_positions term_before_positions term_after_positions value_def_positions value_def_fact_indices value_def_blocks value_def_is_entry value_end_positions value_slot_indices value_type_kinds value_classes value_memory_homes value_assigned_regs value_use_offsets value_use_positions value_use_fact_indices value_use_kinds value_use_source_blocks value_use_target_blocks call_positions allocation_order reg_interval_offsets reg_interval_values operand_reg_by_fact access_fact_registers access_fact_is_allocator_clobber access_fact_block_indices access_fact_op_indices access_fact_term_indices access_fact_edge_indices op_action_starts op_action_counts term_action_starts term_action_counts block_entry_action_starts block_entry_action_counts function_entry_action_start function_entry_action_count block_exit_action_starts block_exit_action_counts edge_source_blocks edge_target_blocks edge_action_starts edge_action_counts virtual_entry_action_starts virtual_entry_action_counts used_callee_mask"
    if artifacts.RegallocProductionArtifactPlanFieldCount() != 58 ||
       planNames != expectedPlans:
        return 3
    return 0

fn checkActionKindContract(): int32 =
    var actualKinds: str[]
    var machineCount: int32
    var structuralCount: int32
    for nativeKind in alloc.RegallocValueActionEntryReload..<
                           (alloc.RegallocValueActionBindCallWriteHome + 1):
        var action: alloc.RegallocValueAction
        action.kind = nativeKind
        let ledgerKind =
            artifacts.RegallocProductionArtifactActionLedgerKind(action)
        if len(ledgerKind) == 0:
            return 1
        add(actualKinds, ledgerKind)
        let bindingKind =
            alloc.RegallocSinglePassValueActionBindingKind(nativeKind)
        if bindingKind == alloc.RegallocValueBindingMachine:
            machineCount = machineCount + 1
        elif bindingKind == alloc.RegallocValueBindingStructural:
            structuralCount = structuralCount + 1
        else:
            return 2
    let actual = strutil.Join(actualKinds, " ")
    let expected =
        "reload reload spill reload register_assignment spill stack_home_store fixed_result_move fixed_result_move fixed_result_move register_assignment spill spill reload edge_parallel_copy sret_result_binding sret_return_store outgoing_stack_arg_store parallel_copy_scratch_save parallel_copy_scratch_restore call_clobber value_classification liveness_interval sret_exclusion address_escape_home callee_saved_selection dead_value coalesced_copy sret_forward call_write_home_binding"
    if actual != expected || machineCount != 20 || structuralCount != 10:
        return 3
    var fixedLoad: alloc.RegallocValueAction
    fixedLoad.kind = alloc.RegallocValueActionLoadFixed
    fixedLoad.sourceLocation = alloc.RegallocValueLocationStack
    if artifacts.RegallocProductionArtifactActionLedgerKind(fixedLoad) !=
       "reload":
        return 4
    var entryRegister: alloc.RegallocValueAction
    entryRegister.kind = alloc.RegallocValueActionEntryReload
    entryRegister.sourceLocation = alloc.RegallocValueLocationRegister
    if artifacts.RegallocProductionArtifactActionLedgerKind(entryRegister) !=
       "register_assignment":
        return 5
    var critical: alloc.RegallocValueAction
    critical.kind = alloc.RegallocValueActionEdgeParallelCopy
    critical.requiresEdgeSplit = true
    if artifacts.RegallocProductionArtifactActionLedgerKind(critical) !=
       "critical_edge_copy":
        return 6
    var unknown: alloc.RegallocValueAction
    unknown.kind = alloc.RegallocValueActionBindCallWriteHome + 1
    if len(artifacts.RegallocProductionArtifactActionLedgerKind(unknown)) != 0:
        return 7
    return 0

fn buildFrozenSnapshotRow(
        symbol: str,
        functionIrIndex: int32,
        functionKind: int32,
        row: var artifacts.RegallocProductionSnapshotFunction): bool =
    var body = buildTenArgCall()
    var constraints = alloc.RegallocTargetConstraintsA64Darwin()
    var plan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        body, constraints)
    if !plan.valid || !alloc.RegallocSinglePassValuePlanValidate(plan):
        return false
    var recipes = adapter.RegallocA64PrepareFunctionActionRecipes(
        body, plan)
    if !recipes.valid ||
       !artifacts.RegallocProductionBindMachineRecipe(plan, recipes):
        return false
    row.symbol = symbol
    row.functionIrIndex = functionIrIndex
    row.functionKind = functionKind
    row.bodyIrSha256 = plan.bodyIrIngressSha256
    row.recipeOrigin =
        artifacts.RegallocProductionRecipeOriginBodyIrAdapter
    row.plan = plan
    row.recipes = recipes
    return true

fn buildSnapshotRows(
        rows: var artifacts.RegallocProductionSnapshotFunction[]): bool =
    var firstRow: artifacts.RegallocProductionSnapshotFunction
    var secondRow: artifacts.RegallocProductionSnapshotFunction
    if !buildFrozenSnapshotRow(
           "artifact_function_a", 0,
           artifacts.RegallocProductionFunctionKindNormal, firstRow) ||
       !buildFrozenSnapshotRow(
           "artifact_function_b", 1,
           artifacts.RegallocProductionFunctionKindNormal, secondRow) ||
       firstRow.plan.actions.len < 27 ||
       secondRow.plan.actions.len != firstRow.plan.actions.len:
        return false
    add(rows, firstRow)
    add(rows, secondRow)
    return true

fn checkSnapshot(): int32 =
    var rows: artifacts.RegallocProductionSnapshotFunction[]
    if !buildSnapshotRows(rows):
        return 1
    let metadata: artifacts.RegallocProductionSnapshotMetadata =
        snapshotMetadata()
    let first: artifacts.RegallocProductionArtifact =
        artifacts.RegallocProductionFrozenPlanSnapshotSerialize(
        metadata, rows)
    let replay: artifacts.RegallocProductionArtifact =
        artifacts.RegallocProductionFrozenPlanSnapshotSerialize(
        metadata, rows)
    if !first.valid || !replay.valid || first.payload != replay.payload ||
       first.payloadSha256 != replay.payloadSha256 ||
       first.functionSymbols.len != 2 ||
       first.functionRootSha256s.len != 2 ||
       !artifacts.RegallocProductionFrozenPlanSnapshotMatches(
           metadata, rows, first.payload):
        return 2
    if !strutil.Contains(
           first.payload, "schema=regalloc_frozen_plan_snapshot\n") ||
       !strutil.Contains(
           first.payload,
           "phase=allocator_and_machine_recipe_freeze_before_fill\n") ||
       !strutil.Contains(first.payload, "function_count=2\n") ||
       !strutil.Contains(
           first.payload, "function.1.symbol=artifact_function_b\n") ||
       !strutil.Contains(first.payload,
           "function.0.recipe_origin=body_ir_adapter\n") ||
       !strutil.Contains(first.payload,
           "function.0.constraint.gpr_type_kinds=1,4,6\n") ||
       !strutil.Contains(first.payload,
           "function.0.plan.used_callee_mask=") ||
       !strutil.Contains(first.payload,
           "function.0.action.0.semantic_register=") ||
       !strutil.Contains(first.payload,
           "function.0.fragment.0.fragment_sha256=") ||
       !strutil.Contains(first.payload,
           "owner_kind=frame_prologue\n") ||
       !strutil.Contains(first.payload,
           "owner_kind=frame_epilogue\n") ||
       !strutil.Contains(first.payload, strutil.Join([
           "snapshot_payload_sha256=", first.payloadSha256, "\n"
       ], "")):
        return 3
    var firstSingleRow: artifacts.RegallocProductionSnapshotFunction[]
    var secondSingleRow: artifacts.RegallocProductionSnapshotFunction[]
    add(firstSingleRow, rows[0])
    add(secondSingleRow, rows[1])
    let firstSingle =
        artifacts.RegallocProductionFrozenPlanSnapshotSerialize(
            metadata, firstSingleRow)
    let secondSingle =
        artifacts.RegallocProductionFrozenPlanSnapshotSerialize(
            metadata, secondSingleRow)
    var singlePayloads: str[]
    add(singlePayloads, firstSingle.payload)
    add(singlePayloads, secondSingle.payload)
    let merged =
        artifacts.RegallocProductionFrozenPlanSnapshotMerge(
            metadata, singlePayloads)
    if !firstSingle.valid || !secondSingle.valid || !merged.valid ||
       !strutil.Contains(
           merged.payload, "function.0.function_ir_index=0\n") ||
       !strutil.Contains(
           merged.payload, "function.1.function_ir_index=1\n") ||
       !strutil.Contains(
           merged.payload, "function.0.function_kind=1\n") ||
       !strutil.Contains(
           merged.payload, "function.1.function_kind=1\n"):
        return 15
    var duplicateMergeRow = rows[1]
    duplicateMergeRow.functionIrIndex = rows[0].functionIrIndex
    var duplicateMergeRows: artifacts.RegallocProductionSnapshotFunction[]
    add(duplicateMergeRows, duplicateMergeRow)
    let duplicateMergeSingle =
        artifacts.RegallocProductionFrozenPlanSnapshotSerialize(
            metadata, duplicateMergeRows)
    var duplicateMergePayloads: str[]
    add(duplicateMergePayloads, firstSingle.payload)
    add(duplicateMergePayloads, duplicateMergeSingle.payload)
    let duplicateMerge =
        artifacts.RegallocProductionFrozenPlanSnapshotMerge(
            metadata, duplicateMergePayloads)
    if !duplicateMergeSingle.valid || duplicateMerge.valid ||
       duplicateMerge.errorCode !=
           artifacts.RegallocProductionArtifactBindingMismatch:
        return 16
    let tampered = strutil.Join([first.payload, "unexpected_field=1\n"], "")
    if artifacts.RegallocProductionFrozenPlanSnapshotMatches(
           metadata, rows, tampered):
        return 4
    var fixedOriginRow = rows[0]
    fixedOriginRow.recipeOrigin = "fixed_template"
    var fixedOriginRows: artifacts.RegallocProductionSnapshotFunction[]
    add(fixedOriginRows, fixedOriginRow)
    let fixedOriginResult: artifacts.RegallocProductionArtifact =
        artifacts.RegallocProductionFrozenPlanSnapshotSerialize(
            metadata, fixedOriginRows)
    if fixedOriginResult.valid || fixedOriginResult.errorCode !=
       artifacts.RegallocProductionArtifactMetadataInvalid:
        return 11
    var duplicateRows: artifacts.RegallocProductionSnapshotFunction[]
    add(duplicateRows, rows[0])
    add(duplicateRows, rows[0])
    let duplicate: artifacts.RegallocProductionArtifact =
        artifacts.RegallocProductionFrozenPlanSnapshotSerialize(
            metadata, duplicateRows)
    if duplicate.valid || duplicate.errorCode !=
       artifacts.RegallocProductionArtifactDuplicateSymbol:
        return 5
    var duplicateIdentityRow = rows[1]
    duplicateIdentityRow.functionIrIndex = rows[0].functionIrIndex
    var duplicateIdentityRows: artifacts.RegallocProductionSnapshotFunction[]
    add(duplicateIdentityRows, rows[0])
    add(duplicateIdentityRows, duplicateIdentityRow)
    let duplicateIdentity =
        artifacts.RegallocProductionFrozenPlanSnapshotSerialize(
            metadata, duplicateIdentityRows)
    if duplicateIdentity.valid ||
       duplicateIdentity.errorCode !=
           artifacts.RegallocProductionArtifactBindingMismatch:
        return 12
    var firstEntry = rows[0]
    firstEntry.symbol = "artifact_entry_a"
    firstEntry.functionIrIndex = -1
    firstEntry.functionKind =
        artifacts.RegallocProductionFunctionKindEntryBridge
    var secondEntry = rows[1]
    secondEntry.symbol = "artifact_entry_b"
    secondEntry.functionIrIndex = -1
    secondEntry.functionKind =
        artifacts.RegallocProductionFunctionKindEntryBridge
    var duplicateEntryRows: artifacts.RegallocProductionSnapshotFunction[]
    add(duplicateEntryRows, firstEntry)
    add(duplicateEntryRows, secondEntry)
    let duplicateEntry =
        artifacts.RegallocProductionFrozenPlanSnapshotSerialize(
            metadata, duplicateEntryRows)
    if duplicateEntry.valid ||
       duplicateEntry.errorCode !=
           artifacts.RegallocProductionArtifactBindingMismatch:
        return 13
    var invalidKindRow = rows[0]
    invalidKindRow.functionIrIndex = -1
    var invalidKindRows: artifacts.RegallocProductionSnapshotFunction[]
    add(invalidKindRows, invalidKindRow)
    let invalidKind =
        artifacts.RegallocProductionFrozenPlanSnapshotSerialize(
            metadata, invalidKindRows)
    if invalidKind.valid ||
       invalidKind.errorCode !=
           artifacts.RegallocProductionArtifactMetadataInvalid:
        return 14
    var startedRow: artifacts.RegallocProductionSnapshotFunction
    if !buildFrozenSnapshotRow(
           "started", 2,
           artifacts.RegallocProductionFunctionKindNormal, startedRow):
        return 6
    if !alloc.RegallocSinglePassValuePlanBeginEmissionSymbol(
           startedRow.plan, "started", 0,
           startedRow.recipes.functionWords.len * 4):
        return 6
    var startedRows: artifacts.RegallocProductionSnapshotFunction[]
    add(startedRows, startedRow)
    let badState: artifacts.RegallocProductionArtifact =
        artifacts.RegallocProductionFrozenPlanSnapshotSerialize(
            metadata, startedRows)
    if badState.valid || badState.errorCode !=
       artifacts.RegallocProductionArtifactStateInvalid:
        return 7
    var unknownRow: artifacts.RegallocProductionSnapshotFunction
    if !buildFrozenSnapshotRow(
           "unknown_action", 3,
           artifacts.RegallocProductionFunctionKindNormal, unknownRow):
        return 8
    if unknownRow.plan.actions.len <= 0:
        return 8
    unknownRow.plan.actions[0].kind =
        alloc.RegallocValueActionBindCallWriteHome + 1
    var unknownRows: artifacts.RegallocProductionSnapshotFunction[]
    add(unknownRows, unknownRow)
    let unknownResult: artifacts.RegallocProductionArtifact =
        artifacts.RegallocProductionFrozenPlanSnapshotSerialize(
            metadata, unknownRows)
    if unknownResult.valid || unknownResult.errorCode !=
       artifacts.RegallocProductionArtifactUnknownActionKind:
        return 9
    let badSymbols = invalidSymbols()
    for symbolIndex in 0..<badSymbols.len:
        var invalidRow = rows[0]
        invalidRow.symbol = badSymbols[symbolIndex]
        var invalidRows: artifacts.RegallocProductionSnapshotFunction[]
        add(invalidRows, invalidRow)
        let invalidResult: artifacts.RegallocProductionArtifact =
            artifacts.RegallocProductionFrozenPlanSnapshotSerialize(
                metadata, invalidRows)
        if invalidResult.valid || invalidResult.errorCode !=
           artifacts.RegallocProductionArtifactMetadataInvalid:
            return 10
    return 0

fn buildLedgerRows(
        rows: var artifacts.RegallocProductionLedgerFunction[]): bool =
    var first = buildEmission("artifact_function_a", 0, 0)
    var second = buildEmission("artifact_function_b", 4096, 1)
    if !first.valid || !second.valid:
        return false
    var firstRow: artifacts.RegallocProductionLedgerFunction
    firstRow.plan = first.plan
    firstRow.recipes = first.recipes
    firstRow.receipt = first.receipt
    add(rows, firstRow)
    var secondRow: artifacts.RegallocProductionLedgerFunction
    secondRow.plan = second.plan
    secondRow.recipes = second.recipes
    secondRow.receipt = second.receipt
    add(rows, secondRow)
    return true

fn checkLedger(): int32 =
    var rows: artifacts.RegallocProductionLedgerFunction[]
    if !buildLedgerRows(rows):
        return 1
    let metadata: artifacts.RegallocProductionLedgerMetadata =
        ledgerMetadata()
    let first: artifacts.RegallocProductionArtifact =
        artifacts.RegallocProductionActionEmissionLedgerSerialize(
        metadata, rows)
    let replay: artifacts.RegallocProductionArtifact =
        artifacts.RegallocProductionActionEmissionLedgerSerialize(
        metadata, rows)
    if !first.valid || !replay.valid || first.payload != replay.payload ||
       first.payloadSha256 != replay.payloadSha256 ||
       first.functionSymbols.len != 2 ||
       first.functionRootSha256s.len != 2 ||
       !artifacts.RegallocProductionActionEmissionLedgerMatches(
           metadata, rows, first.payload):
        return 2
    if !strutil.Contains(
           first.payload, "schema=regalloc_action_emission_ledger\n") ||
       !strutil.Contains(
           first.payload, "target=arm64-apple-darwin\n") ||
       !strutil.Contains(first.payload, "function_count=2\n") ||
       !strutil.Contains(first.payload, "ack_kind=machine_emitted\n") ||
       !strutil.Contains(
           first.payload, "ack_kind=structural_validated\n") ||
       !strutil.Contains(first.payload, "binding_kind=machine\n") ||
       !strutil.Contains(first.payload, "binding_kind=structural\n") ||
       !strutil.Contains(first.payload, "machine_size=4\n") ||
       !strutil.Contains(first.payload, "machine_size=0\n") ||
       !strutil.Contains(first.payload,
           "function.0.fragment.0.fragment_sha256=") ||
       !strutil.Contains(first.payload,
           "owner_kind=frame_prologue\n") ||
       !strutil.Contains(first.payload,
           "owner_kind=frame_epilogue\n") ||
       !strutil.Contains(first.payload,
           "kind=outgoing_stack_arg_store\n") ||
       !strutil.Contains(first.payload,
           "function.1.root_sha256=") ||
       !strutil.Contains(first.payload, strutil.Join([
           "ledger_payload_sha256=", first.payloadSha256, "\n"
       ], "")):
        return 3
    let tampered = strutil.Join([
        first.payload, "function.2.symbol=forged\n"
    ], "")
    if artifacts.RegallocProductionActionEmissionLedgerMatches(
           metadata, rows, tampered):
        return 4
    var duplicateRows: artifacts.RegallocProductionLedgerFunction[]
    add(duplicateRows, rows[0])
    add(duplicateRows, rows[0])
    let duplicate: artifacts.RegallocProductionArtifact =
        artifacts.RegallocProductionActionEmissionLedgerSerialize(
            metadata, duplicateRows)
    if duplicate.valid || duplicate.errorCode !=
       artifacts.RegallocProductionArtifactDuplicateSymbol:
        return 5
    var badEmission = buildEmission("bad_range", 8192, 2)
    if !badEmission.valid:
        return 6
    var badPlan = badEmission.plan
    var badReceipt = badEmission.receipt
    var machineIndex: int32 = -1
    for actionIndex in 0..<badPlan.actions.len:
        if alloc.RegallocSinglePassValueActionBindingKind(
               badPlan.actions[actionIndex].kind) ==
           alloc.RegallocValueBindingMachine:
            machineIndex = actionIndex
            break
    if machineIndex < 0:
        return 7
    badReceipt.actionEmissions[machineIndex].emittedByteLength = 8
    var badRow: artifacts.RegallocProductionLedgerFunction
    badRow.plan = badPlan
    badRow.recipes = badEmission.recipes
    badRow.receipt = badReceipt
    var badRows: artifacts.RegallocProductionLedgerFunction[]
    add(badRows, badRow)
    let badRange: artifacts.RegallocProductionArtifact =
        artifacts.RegallocProductionActionEmissionLedgerSerialize(
            metadata, badRows)
    if badRange.valid || badRange.errorCode !=
       artifacts.RegallocProductionArtifactReceiptMismatch:
        return 8
    var unfinalizedSnapshot: artifacts.RegallocProductionSnapshotFunction
    if !buildFrozenSnapshotRow(
           "unfinalized_source", 4,
           artifacts.RegallocProductionFunctionKindNormal,
           unfinalizedSnapshot):
        return 9
    var unfinalizedRow: artifacts.RegallocProductionLedgerFunction
    unfinalizedRow.plan = unfinalizedSnapshot.plan
    unfinalizedRow.recipes = unfinalizedSnapshot.recipes
    var unfinalizedRows: artifacts.RegallocProductionLedgerFunction[]
    add(unfinalizedRows, unfinalizedRow)
    let badState: artifacts.RegallocProductionArtifact =
        artifacts.RegallocProductionActionEmissionLedgerSerialize(
            metadata, unfinalizedRows)
    if badState.valid || badState.errorCode !=
       artifacts.RegallocProductionArtifactStateInvalid:
        return 9
    let badSymbols = invalidSymbols()
    for symbolIndex in 0..<badSymbols.len:
        var invalidEmission = buildEmission(
            "valid_source", 16384 + symbolIndex * 4096,
            3 + symbolIndex)
        if !invalidEmission.valid:
            return 10
        var invalidReceipt = invalidEmission.receipt
        invalidReceipt.symbolName = badSymbols[symbolIndex]
        var invalidRow: artifacts.RegallocProductionLedgerFunction
        invalidRow.plan = invalidEmission.plan
        invalidRow.recipes = invalidEmission.recipes
        invalidRow.receipt = invalidReceipt
        var invalidRows: artifacts.RegallocProductionLedgerFunction[]
        add(invalidRows, invalidRow)
        let invalidResult: artifacts.RegallocProductionArtifact =
            artifacts.RegallocProductionActionEmissionLedgerSerialize(
                metadata, invalidRows)
        if invalidResult.valid || invalidResult.errorCode !=
           artifacts.RegallocProductionArtifactReceiptMismatch:
            return 11
    return 0

fn checkFunctionIdentityIndexScale(): int32 =
    let functionCount: int32 = 20000
    var index =
        artifacts.RegallocProductionFunctionIndexInit(
            functionCount + 1)
    for functionIrIndex in 0..<functionCount:
        if artifacts.RegallocProductionFunctionIndexAppend(
               index,
               functionIrIndex,
               artifacts.RegallocProductionFunctionKindNormal,
               Fmt"_scale_function_{functionIrIndex}") !=
               artifacts.RegallocProductionFunctionIndexAppendOk:
            return 1
    if index.normalFunctionCount != functionCount ||
       artifacts.RegallocProductionFunctionIndexAppend(
           index,
           functionCount - 1,
           artifacts.RegallocProductionFunctionKindNormal,
           "_scale_duplicate_identity") !=
           artifacts.RegallocProductionFunctionIndexAppendDuplicateIdentity ||
       artifacts.RegallocProductionFunctionIndexAppend(
           index,
           functionCount,
           artifacts.RegallocProductionFunctionKindNormal,
           "_scale_function_0") !=
           artifacts.RegallocProductionFunctionIndexAppendDuplicateSymbol ||
       artifacts.RegallocProductionFunctionIndexAppend(
           index,
           -1,
           artifacts.RegallocProductionFunctionKindEntryBridge,
           "_scale_entry") !=
           artifacts.RegallocProductionFunctionIndexAppendOk ||
       artifacts.RegallocProductionFunctionIndexAppend(
           index,
           -1,
           artifacts.RegallocProductionFunctionKindEntryBridge,
           "_scale_entry_duplicate") !=
           artifacts.RegallocProductionFunctionIndexAppendDuplicateIdentity:
        return 2
    return 0

fn main(): int32 =
    # B1: codegen unit composition root (dispatch fails closed without registration)
    if !adapter.RegallocA64CodegenUnitRegister():
        return 90
    let identityScale = checkFunctionIdentityIndexScale()
    if identityScale != 0:
        return 80 + identityScale
    let fields = checkFieldContracts()
    if fields != 0:
        return 10 + fields
    let kinds = checkActionKindContract()
    if kinds != 0:
        return 20 + kinds
    let snapshot = checkSnapshot()
    if snapshot != 0:
        return 40 + snapshot
    let ledger = checkLedger()
    if ledger != 0:
        return 60 + ledger
    return 0
