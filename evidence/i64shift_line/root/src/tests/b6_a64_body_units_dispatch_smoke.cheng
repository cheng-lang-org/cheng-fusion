# b6_a64_body_units_dispatch_smoke.cheng — B6 facade dispatch smoke.
# The codegen_a64_body_units facade (shared-format; the module
# primary_object_plan calls through since B6) must behave identically to the
# direct arch modules it fronts: (a) the 16 const re-exports equal
# aarch64_encode's constants; (b) primitive fn forwards (plain int32 and
# Result[int32] carriers) equal direct aarch64_encode calls; (c) the moved
# cluster slots (codegen_a64_fill_units, aarch64 unit) return exactly what
# their in-tree source semantics prescribe, oracled here against
# aarch64_encode/coreir constants directly (B4 b4_x64_body_units_dispatch
# same-form precedent).

import cheng/core/ir/core_types as ir
import cheng/core/backend/aarch64_encode as a64
import cheng/core/backend/codegen_a64_body_units as units
import std/seqs

fn main(): int32 =
    var pass = true

    # (a) const re-exports (all 16 staying constants)
    pass = pass &&
        units.CodegenA64X0 == a64.A64X0 &&
        units.CodegenA64X8 == a64.A64X8 &&
        units.CodegenA64X9 == a64.A64X9 &&
        units.CodegenA64X10 == a64.A64X10 &&
        units.CodegenA64X11 == a64.A64X11 &&
        units.CodegenA64X12 == a64.A64X12 &&
        units.CodegenA64X13 == a64.A64X13 &&
        units.CodegenA64X14 == a64.A64X14 &&
        units.CodegenA64X15 == a64.A64X15 &&
        units.CodegenA64X16 == a64.A64X16 &&
        units.CodegenA64FP == a64.A64FP &&
        units.CodegenA64LR == a64.A64LR &&
        units.CodegenA64SP == a64.A64SP &&
        units.CodegenA64CondNE == a64.A64CondNE &&
        units.CodegenA64CondEQ == a64.A64CondEQ &&
        units.CodegenA64CondGT == a64.A64CondGT

    # (b) primitive fn forwards: int32 returns
    pass = pass &&
        units.CodegenA64EncRet() == a64.A64EncRet() &&
        units.CodegenA64EncNop() == a64.A64EncNop() &&
        units.CodegenA64EncBlPlaceholder() == a64.A64EncBlPlaceholder() &&
        units.CodegenA64EncAdrp(a64.A64X9) == a64.A64EncAdrp(a64.A64X9) &&
        units.CodegenA64EncMovz(true, 5, 77, 1) == a64.A64EncMovz(true, 5, 77, 1) &&
        units.CodegenA64EncMovk(false, 6, 511, 0) == a64.A64EncMovk(false, 6, 511, 0) &&
        units.CodegenA64EncAddReg(true, 1, 2, 3) == a64.A64EncAddReg(true, 1, 2, 3) &&
        units.CodegenA64EncSubReg(false, 4, 5, 6) == a64.A64EncSubReg(false, 4, 5, 6) &&
        units.CodegenA64EncCmpReg(true, 7, 8) == a64.A64EncCmpReg(true, 7, 8) &&
        units.CodegenA64EncFmulD(1, 2, 3) == a64.A64EncFmulD(1, 2, 3) &&
        units.CodegenA64EncStrImmValue(true, 4, 5, 16) == a64.A64EncStrImmValue(true, 4, 5, 16)

    # (b2) primitive fn forwards: Result[int32] carriers (ok + value)
    var addF = a64.A64EncAddImm(true, 1, 2, 3)
    var addU = units.CodegenA64EncAddImm(true, 1, 2, 3)
    pass = pass && addF.ok && addU.ok && addF.value == addU.value
    var ldrF = a64.A64EncLdrImm(true, 9, 10, 24)
    var ldrU = units.CodegenA64EncLdrImm(true, 9, 10, 24)
    pass = pass && ldrF.ok && ldrU.ok && ldrF.value == ldrU.value
    var bF = a64.A64EncBCond(16, a64.A64CondNE)
    var bU = units.CodegenA64EncBCond(16, a64.A64CondNE)
    pass = pass && bF.ok && bU.ok && bF.value == bU.value
    var stpF = a64.A64EncStp64(a64.A64FP, a64.A64LR, a64.A64SP, int64(0))
    var stpU = units.CodegenA64EncStp64(a64.A64FP, a64.A64LR, a64.A64SP, int64(0))
    pass = pass && stpF.ok && stpU.ok && stpF.value == stpU.value

    # (c1) EmitPrologueWord: fixed prologue literals (source: EmitPrologueWord)
    pass = pass &&
        units.CodegenA64BodyEmitPrologueWord(0) == Value(a64.A64EncSubImm(true, a64.A64SP, a64.A64SP, 32)) &&
        units.CodegenA64BodyEmitPrologueWord(1) == Value(a64.A64EncStp64(a64.A64FP, a64.A64LR, a64.A64SP, int64(0))) &&
        units.CodegenA64BodyEmitPrologueWord(2) == Value(a64.A64EncAddImm(true, a64.A64FP, a64.A64SP, 0)) &&
        units.CodegenA64BodyEmitPrologueWord(3) == 0

    # (c2) EmitTermWord: per-kind arms (source: EmitTermWord)
    var cbrTerm: ir.BodyTerm
    cbrTerm.kind = ir.BodyTermCbrTag
    var brTerm: ir.BodyTerm
    brTerm.kind = ir.BodyTermBrTag
    var retTerm: ir.BodyTerm
    retTerm.kind = ir.BodyTermReturnTag
    pass = pass &&
        units.CodegenA64BodyEmitTermWord(cbrTerm, 0) == a64.A64EncMovz(false, 0, 0, 0) &&
        units.CodegenA64BodyEmitTermWord(cbrTerm, 1) == 0 &&
        units.CodegenA64BodyEmitTermWord(brTerm, 0) == a64.A64EncBPlaceholder() &&
        units.CodegenA64BodyEmitTermWord(brTerm, 2) == 0 &&
        units.CodegenA64BodyEmitTermWord(retTerm, 0) == a64.A64EncRet()

    # (c3) CondA64TrueCode: representative rows across signed/unsigned/f64
    pass = pass &&
        units.CodegenA64BodyCondTrueCode(ir.BodyCondI32EqTag) == a64.A64CondEQ &&
        units.CodegenA64BodyCondTrueCode(ir.BodyCondI64NeTag) == a64.A64CondNE &&
        units.CodegenA64BodyCondTrueCode(ir.BodyCondI32LtTag) == a64.A64CondLT &&
        units.CodegenA64BodyCondTrueCode(ir.BodyCondI64GeTag) == a64.A64CondGE &&
        units.CodegenA64BodyCondTrueCode(ir.BodyCondU32LtTag) == a64.A64CondLO &&
        units.CodegenA64BodyCondTrueCode(ir.BodyCondU64GeTag) == a64.A64CondHS &&
        units.CodegenA64BodyCondTrueCode(ir.BodyCondF64EqTag) == a64.A64CondEQ &&
        units.CodegenA64BodyCondTrueCode(ir.BodyCondF64GtTag) == a64.A64CondGT

    # (c4) FillStackAdjustExact: imm12 chunking math oracled from a64 primitives
    var w1: int32[]
    add(w1, 0)
    add(w1, 0)
    var r1 = units.CodegenA64BodyFillStackAdjustExact(w1, 0, 32, false)
    pass = pass && r1 == 1 &&
        w1[0] == Value(a64.A64EncAddImm(true, a64.A64SP, a64.A64SP, 32))
    var r2 = units.CodegenA64BodyFillStackAdjustExact(w1, 0, 0, true)
    pass = pass && r2 == 0
    var w3: int32[]
    add(w3, 0)
    add(w3, 0)
    add(w3, 0)
    var r3 = units.CodegenA64BodyFillStackAdjustExact(w3, 1, 4095 + 7, true)
    pass = pass && r3 == 3 &&
        w3[1] == Value(a64.A64EncSubImm(true, a64.A64SP, a64.A64SP, 4095)) &&
        w3[2] == Value(a64.A64EncSubImm(true, a64.A64SP, a64.A64SP, 7))

    # (c5) FillGlobalDataAddress: ADRP + ADD pair, plus out-of-range rejection
    var w5: int32[]
    add(w5, 0)
    add(w5, 0)
    var r5 = units.CodegenA64BodyFillGlobalDataAddress(w5, 0, a64.A64X9)
    pass = pass && r5 == 2 &&
        w5[0] == a64.A64EncAdrp(a64.A64X9) &&
        w5[1] == Value(a64.A64EncAddImm(true, a64.A64X9, a64.A64X9, 0))
    var r5b = units.CodegenA64BodyFillGlobalDataAddress(w5, 1, a64.A64X9)
    pass = pass && r5b == -1

    # (c6) FillRegAddImmToReg: single ADD-immediate for imm12-fitting offset
    var w6: int32[]
    add(w6, 0)
    add(w6, 0)
    var r6 = units.CodegenA64BodyFillRegAddImmToReg(w6, 0, a64.A64X9, a64.A64X10, 96)
    pass = pass && r6 == 1 &&
        w6[0] == Value(a64.A64EncAddImm(true, a64.A64X9, a64.A64X10, 96))

    # (c7) FillStackAddressToReg: imm12-fitting SP offset emits one ADD
    # immediate; negative raw offsets are rejected
    var w7: int32[]
    add(w7, 0)
    add(w7, 0)
    var r7 = units.CodegenA64BodyFillStackAddressToReg(w7, 0, a64.A64X9, 16)
    pass = pass && r7 == 1 &&
        w7[0] == Value(a64.A64EncAddImm(true, a64.A64X9, a64.A64SP, 16))
    var r7b = units.CodegenA64BodyFillStackAddressToReg(w7, 0, a64.A64X9, 0 - 16)
    pass = pass && r7b == -1

    if pass:
        os.WriteLine(os.GetStdout(), "b6_a64_body_units_dispatch=pass consts=16 primitives=15 slots=7")
        return 0
    os.WriteLine(os.GetStdout(), "b6_a64_body_units_dispatch=fail")
    return 1
