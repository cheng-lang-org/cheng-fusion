import std/os as os
import std/strings
import cheng/core/csg_core/merkle_closure
import cheng/core/csg_core/merkle_dag

@borrows
fn fail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

fn main(): int32 =
    let facts = [
        "{\"id\":\"schema\",\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}",
        "{\"id\":\"module:a\",\"kind\":\"csg.module\",\"path\":\"a.cheng\"}",
        "{\"id\":\"symbol:a\",\"kind\":\"csg.symbol\",\"name\":\"A\"}"
    ]
    let dag = merkle_dag.CsgCoreMerkleBuild(facts)
    if !dag.ok ||
       dag.factsRoot.len != 0 ||
       dag.dagRootCid.len != 71 ||
       dag.subgraphCid.len != 71:
        return fail("closure DAG build failed")
    var nodes: merkle_dag.CsgCoreMerkleNodeRecord[]
    for index in 0..<dag.nodeKinds.len:
        var projectionError: str
        let node =
            merkle_dag.CsgCoreMerkleDagNodeRecord(
                dag, index, projectionError)
        if projectionError.len > 0:
            return fail("closure node projection failed")
        add(nodes, node)
    if nodes.len != dag.nodeKinds.len:
        return fail("closure node projection failed")
    let exactError =
        merkle_closure.CsgCoreMerkleNodeClosureError(
            dag, nodes)
    if exactError.len > 0:
        return fail(strings.ConcatStr(
            "exact node closure failed: ",
            exactError))

    var reversed: merkle_dag.CsgCoreMerkleNodeRecord[]
    var reverseIndex = nodes.len - 1
    while reverseIndex >= 0:
        var projectionError: str
        let node =
            merkle_dag.CsgCoreMerkleDagNodeRecord(
                dag, reverseIndex,
                projectionError)
        if projectionError.len > 0:
            return fail(
                "reverse closure projection failed")
        add(reversed, node)
        reverseIndex = reverseIndex - 1
    if merkle_closure.CsgCoreMerkleNodeClosureError(
           dag, reversed).len > 0:
        return fail("node closure depends on segment order")

    var missing: merkle_dag.CsgCoreMerkleNodeRecord[]
    for i in 0..<(nodes.len - 1):
        var projectionError: str
        let node =
            merkle_dag.CsgCoreMerkleDagNodeRecord(
                dag, i, projectionError)
        if projectionError.len > 0:
            return fail(
                "missing closure projection failed")
        add(missing, node)
    if !strings.StrContains(
           merkle_closure.CsgCoreMerkleNodeClosureError(
               dag, missing),
           "count_mismatch"):
        return fail("missing node accepted")

    var duplicate: merkle_dag.CsgCoreMerkleNodeRecord[]
    for i in 0..<(nodes.len - 1):
        var projectionError: str
        let node =
            merkle_dag.CsgCoreMerkleDagNodeRecord(
                dag, i, projectionError)
        if projectionError.len > 0:
            return fail(
                "duplicate closure projection failed")
        add(duplicate, node)
    var duplicateProjectionError: str
    let duplicateNode =
        merkle_dag.CsgCoreMerkleDagNodeRecord(
            dag, 0, duplicateProjectionError)
    if duplicateProjectionError.len > 0:
        return fail(
            "duplicate node projection failed")
    add(duplicate, duplicateNode)
    if !strings.StrContains(
           merkle_closure.CsgCoreMerkleNodeClosureError(
               dag, duplicate),
           "duplicate"):
        return fail("duplicate node accepted")

    let otherDag =
        merkle_dag.CsgCoreMerkleBuild([
            "{\"id\":\"schema\",\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}",
            "{\"id\":\"module:b\",\"kind\":\"csg.module\",\"path\":\"b.cheng\"}",
            "{\"id\":\"symbol:b\",\"kind\":\"csg.symbol\",\"name\":\"B\"}"
        ])
    if !otherDag.ok:
        return fail("alternate closure fixture invalid")
    var otherNodes: merkle_dag.CsgCoreMerkleNodeRecord[]
    for index in 0..<otherDag.nodeKinds.len:
        var projectionError: str
        let node =
            merkle_dag.CsgCoreMerkleDagNodeRecord(
                otherDag, index, projectionError)
        if projectionError.len > 0:
            return fail(
                "alternate closure projection failed")
        add(otherNodes, node)
    if otherNodes.len != nodes.len:
        return fail("alternate closure node count drift")
    let mismatchError =
        merkle_closure.CsgCoreMerkleNodeClosureError(
            dag, otherNodes)
    if mismatchError.len == 0:
        return fail("different node set accepted")

    os.WriteLine(
        os.Get_stdout(),
        "csg_core_merkle_closure_smoke ok")
    return 0
