import std/system

@borrows
@borrow_result
fn ColdNestedGenericBorrow[V](values: V[]): V[] =
    return values

fn ColdNestedGenericBorrowCase[V](): int32 =
    var values: V[]
    let borrowed = ColdNestedGenericBorrow[V](values)
    if borrowed.len != 0:
        return 11
    if values.len != 0:
        return 12
    echo("cold_nested_generic_borrow_result_authority=pass")
    return 0

fn main(): int32 =
    return ColdNestedGenericBorrowCase[str]()
