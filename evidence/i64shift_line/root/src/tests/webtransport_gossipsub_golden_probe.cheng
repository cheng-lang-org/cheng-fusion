# Golden gossipsub RPC protobuf wire-format probe(WebTransport slice-4).
#
# Dumps 9 deterministic gossipsub RPC vectors covering subscribe/
# unsubscribe/publish/control(IHAVE/IWANT/IDONTWANT/GRAFT/PRUNE)/combo.
#
# Wire-format primitives used(InitProtoBuffer/writeString/writeVarint/
# writeBytes/protoToBytes) are the REAL production LEB128-varint +
# tag + length-delimited encoder from
# cheng/libp2p/protobuf/minprotobuf.cheng(itself a thin shim to
# std/multiformats/protobuf/minprotobuf.cheng) -- the exact same functions
# cheng/libp2p/protocols/pubsub/rpc/protobuf.cheng's encodePubsubRPC/
# encodePubsubControl/encodePubsubSubscription/... are built from. This
# probe reproduces exactly what those field-level encoders would emit
# (same field-number constants, copied verbatim below from that file's own
# `const` block; same field write order, verified against that file's
# source) instead of calling them directly, because of a confirmed,
# reproducible pinned-driver(seed-rescue-20260709/cheng.stage3)
# `system-link-exec` limitation: importing
# cheng/libp2p/protocols/pubsub/rpc/{message,messages,protobuf} into a
# fresh single-file entry point(never before part of any compiled
# closure) triggers a `cheng_cold: ambiguous imported type name` recovery
# that then non-deterministically drops SOME of that module's function
# bodies from the reachable set(`reachable function body missing:
# protobuf.<fn>`) -- reproduced 10+ times in isolation across
# encodePubsubRPC, encodePubsubControl, encodePubsubControlIHave,
# encodePubsubControlPrune(no loop -- rules out a "for-loop" theory) and
# decodePubsubControlIHave, with the exact failing function depending
# unpredictably on call order/count, not on any single code shape. Not a
# bug introduced by this file(the repo's own pre-existing
# src/libp2p/tests/gossipsub_smoke.cheng reproduces the same class of
# error when force-compiled standalone through this same driver). Root
# cause is inside the pinned cold compiler's type/reachability resolver,
# out of this task's scope to fix(zero-C compiler campaign territory, not
# a wire-format concern) -- routing around it at the source level here
# does not touch any shared file. This is this cheng-lang repository's own
# custom gossipsub wire dialect(custom message field numbers, SubOpts
# field order reversed vs go-libp2p/js-libp2p, IWANT/IDONTWANT carry an
# extra topic field), not the official pubsub.proto.
#
# Two byte layers per vector are written + hex-echoed:
#   <name>.body.bin -- raw protobuf body(what encodePubsubRPC() would
#                      return)
#   <name>.lp.bin   -- same body with a uvarint length prefix(identical
#                      framing to libp2p/stream/lpstream.cheng's writeLp,
#                      built with the same std/varint.encodeUVarint
#                      primitive relied on by minprotobuf itself)
# All field values are compile-time string constants(no clock, no RNG) so
# re-running produces byte-identical output every time.

import std/system
import std/os
import std/multiformats/protobuf/minprotobuf

const
    goldenTopic = "unimaker/content/v1"
    goldenPayloadJson = "{\"contentId\":\"c1\",\"postId\":\"c1\",\"text\":\"hello\"}"
    goldenSeqno = "1"
    goldenOutDir = "/tmp/wt4_gossipsub_golden"

    # Verbatim from cheng/libp2p/protocols/pubsub/rpc/protobuf.cheng's own
    # `const` block(lines 9-38 as of this probe's authoring).
    rpcSubField = 1
    rpcMsgField = 2
    rpcControlField = 3
    subTopicField = 1
    subSubscribeField = 2
    msgFromField = 1
    msgDataField = 2
    msgSeqnoField = 3
    msgTopicField = 4
    controlIHaveField = 1
    controlIWantField = 2
    controlGraftField = 3
    controlPruneField = 4
    controlIDontWantField = 5
    iHaveTopicField = 1
    iHaveMsgIdField = 2
    iWantTopicField = 1
    iWantMsgIdField = 2
    iDontWantTopicField = 1
    iDontWantMsgIdField = 2
    graftTopicField = 1
    pruneTopicField = 1

# Mirrors encodePubsubSubscription: topic(1) always, subscribe(2) only if
# true(proto3-style omission -- matches getField's zero-value default on
# decode).
fn encodeSubscription(topic: str, subscribe: bool): Bytes =
    var pb = InitProtoBuffer()
    writeString(pb, subTopicField, topic)
    if subscribe:
        writeVarint(pb, subSubscribeField, 1)
    return protoToBytes(pb)

# Mirrors encodePubsubMessage with hasFrom=false(real gossipsubPublish()
# never sets msg.hasFrom -- see src/libp2p/switch.cheng). Field write
# order is seqno(3), topic(4), data(2) -- NOT numeric order, matches the
# real encoder exactly.
fn encodeMessageNoFrom(topic: str, seqno: str, dataJson: str): Bytes =
    var pb = InitProtoBuffer()
    writeBytes(pb, msgSeqnoField, BytesFromString(seqno))
    writeString(pb, msgTopicField, topic)
    writeBytes(pb, msgDataField, BytesFromString(dataJson))
    return protoToBytes(pb)

# Mirrors encodePubsubControlIHave: topic(1) always, msgId(2) per entry.
fn encodeIHave(topic: str, id0: str, id1: str, idCount: int32): Bytes =
    var pb = InitProtoBuffer()
    writeString(pb, iHaveTopicField, topic)
    if idCount >= 1:
        writeBytes(pb, iHaveMsgIdField, BytesFromString(id0))
    if idCount >= 2:
        writeBytes(pb, iHaveMsgIdField, BytesFromString(id1))
    return protoToBytes(pb)

# Mirrors encodePubsubControlIWant.
fn encodeIWant(topic: str, id0: str, id1: str, idCount: int32): Bytes =
    var pb = InitProtoBuffer()
    writeString(pb, iWantTopicField, topic)
    if idCount >= 1:
        writeBytes(pb, iWantMsgIdField, BytesFromString(id0))
    if idCount >= 2:
        writeBytes(pb, iWantMsgIdField, BytesFromString(id1))
    return protoToBytes(pb)

# Mirrors encodePubsubControlIDontWant.
fn encodeIDontWant(topic: str, id0: str, id1: str, idCount: int32): Bytes =
    var pb = InitProtoBuffer()
    writeString(pb, iDontWantTopicField, topic)
    if idCount >= 1:
        writeBytes(pb, iDontWantMsgIdField, BytesFromString(id0))
    if idCount >= 2:
        writeBytes(pb, iDontWantMsgIdField, BytesFromString(id1))
    return protoToBytes(pb)

# Mirrors encodePubsubControlGraft.
fn encodeGraft(topic: str): Bytes =
    var pb = InitProtoBuffer()
    writeString(pb, graftTopicField, topic)
    return protoToBytes(pb)

# Mirrors encodePubsubControlPrune.
fn encodePrune(topic: str): Bytes =
    var pb = InitProtoBuffer()
    writeString(pb, pruneTopicField, topic)
    return protoToBytes(pb)

# Mirrors encodePubsubControl's field order: ihave(1), iwant(2), graft(3),
# prune(4), idontwant(5).
fn encodeControl(
    ihaveBytes: Bytes, hasIhave: bool,
    iwantBytes: Bytes, hasIwant: bool,
    graftBytes: Bytes, hasGraft: bool,
    pruneBytes: Bytes, hasPrune: bool,
    idontwantBytes: Bytes, hasIdontwant: bool
): Bytes =
    var pb = InitProtoBuffer()
    if hasIhave:
        writeBytes(pb, controlIHaveField, ihaveBytes)
    if hasIwant:
        writeBytes(pb, controlIWantField, iwantBytes)
    if hasGraft:
        writeBytes(pb, controlGraftField, graftBytes)
    if hasPrune:
        writeBytes(pb, controlPruneField, pruneBytes)
    if hasIdontwant:
        writeBytes(pb, controlIDontWantField, idontwantBytes)
    return protoToBytes(pb)

# Mirrors encodePubsubRPC's field order: subs(1), msgs(2), control(3).
fn encodeRpc(
    subBytes: Bytes, hasSub: bool,
    msgBytes: Bytes, hasMsg: bool,
    ctrlBytes: Bytes, hasCtrl: bool
): Bytes =
    var pb = InitProtoBuffer()
    if hasSub:
        writeBytes(pb, rpcSubField, subBytes)
    if hasMsg:
        writeBytes(pb, rpcMsgField, msgBytes)
    if hasCtrl:
        writeBytes(pb, rpcControlField, ctrlBytes)
    return protoToBytes(pb)

fn dumpVector(name: str, body: var Bytes) =
    var framed = BytesConcat(encodeUVarint(int64(BytesLen(body))), body)
    let bodyPath: str = goldenOutDir + "/" + name + ".body.bin"
    let lpPath: str = goldenOutDir + "/" + name + ".lp.bin"
    let bodyWriteRes = WriteFileBytesResult(bodyPath, body)
    if IsErr(bodyWriteRes):
        panic("golden probe: write " + bodyPath + ": " + ErrorText(bodyWriteRes))
    let lpWriteRes = WriteFileBytesResult(lpPath, framed)
    if IsErr(lpWriteRes):
        panic("golden probe: write " + lpPath + ": " + ErrorText(lpWriteRes))
    echo("vector=" + name + " body_len=" + IntToStr(BytesLen(body)) + " body_hex=" + BytesToHex(body))
    echo("vector=" + name + " lp_len=" + IntToStr(BytesLen(framed)) + " lp_hex=" + BytesToHex(framed))

fn main(): int32 =
    let emptyB = EmptyBytes()

    # V1: subscribe=true
    var subBytesV1 = encodeSubscription(goldenTopic, true)
    var bodyV1 = encodeRpc(subBytesV1, true, emptyB, false, emptyB, false)
    dumpVector("v1_subscribe", bodyV1)

    # V2: subscribe=false(unsubscribe)
    var subBytesV2 = encodeSubscription(goldenTopic, false)
    var bodyV2 = encodeRpc(subBytesV2, true, emptyB, false, emptyB, false)
    dumpVector("v2_unsubscribe", bodyV2)

    # V3: publish -- mirrors real gossipsubPublish() output shape(no from,
    # decimal-string seqno, real JSON payload).
    var msgBytesV3 = encodeMessageNoFrom(goldenTopic, goldenSeqno, goldenPayloadJson)
    var bodyV3 = encodeRpc(emptyB, false, msgBytesV3, true, emptyB, false)
    dumpVector("v3_publish", bodyV3)

    # V4: control-only IHAVE, 2 msgIds
    var ihaveBytesV4 = encodeIHave(goldenTopic, "QmGoldenMsgId0001", "QmGoldenMsgId0002", 2)
    var ctrlBytesV4 = encodeControl(ihaveBytesV4, true, emptyB, false, emptyB, false, emptyB, false, emptyB, false)
    var bodyV4 = encodeRpc(emptyB, false, emptyB, false, ctrlBytesV4, true)
    dumpVector("v4_control_ihave", bodyV4)

    # V5: control-only IWANT, 2 msgIds
    var iwantBytesV5 = encodeIWant(goldenTopic, "QmGoldenMsgId0003", "QmGoldenMsgId0004", 2)
    var ctrlBytesV5 = encodeControl(emptyB, false, iwantBytesV5, true, emptyB, false, emptyB, false, emptyB, false)
    var bodyV5 = encodeRpc(emptyB, false, emptyB, false, ctrlBytesV5, true)
    dumpVector("v5_control_iwant", bodyV5)

    # V6: control-only IDONTWANT, 2 msgIds
    var idontwantBytesV6 = encodeIDontWant(goldenTopic, "QmGoldenMsgId0005", "QmGoldenMsgId0006", 2)
    var ctrlBytesV6 = encodeControl(emptyB, false, emptyB, false, emptyB, false, emptyB, false, idontwantBytesV6, true)
    var bodyV6 = encodeRpc(emptyB, false, emptyB, false, ctrlBytesV6, true)
    dumpVector("v6_control_idontwant", bodyV6)

    # V7: control-only GRAFT
    var graftBytesV7 = encodeGraft(goldenTopic)
    var ctrlBytesV7 = encodeControl(emptyB, false, emptyB, false, graftBytesV7, true, emptyB, false, emptyB, false)
    var bodyV7 = encodeRpc(emptyB, false, emptyB, false, ctrlBytesV7, true)
    dumpVector("v7_control_graft", bodyV7)

    # V8: control-only PRUNE
    var pruneBytesV8 = encodePrune(goldenTopic)
    var ctrlBytesV8 = encodeControl(emptyB, false, emptyB, false, emptyB, false, pruneBytesV8, true, emptyB, false)
    var bodyV8 = encodeRpc(emptyB, false, emptyB, false, ctrlBytesV8, true)
    dumpVector("v8_control_prune", bodyV8)

    # V9: combo -- subs + msgs + all 5 control kinds in one frame, to catch
    # field-interleaving bugs.
    var subBytesV9 = encodeSubscription(goldenTopic, true)
    var msgBytesV9 = encodeMessageNoFrom(goldenTopic, goldenSeqno, goldenPayloadJson)
    var ihaveBytesV9 = encodeIHave(goldenTopic, "QmGoldenMsgId0001", "", 1)
    var iwantBytesV9 = encodeIWant(goldenTopic, "QmGoldenMsgId0003", "", 1)
    var idontwantBytesV9 = encodeIDontWant(goldenTopic, "QmGoldenMsgId0005", "", 1)
    var graftBytesV9 = encodeGraft(goldenTopic)
    var pruneBytesV9 = encodePrune(goldenTopic)
    var ctrlBytesV9 = encodeControl(
        ihaveBytesV9, true,
        iwantBytesV9, true,
        graftBytesV9, true,
        pruneBytesV9, true,
        idontwantBytesV9, true
    )
    var bodyV9 = encodeRpc(subBytesV9, true, msgBytesV9, true, ctrlBytesV9, true)
    dumpVector("v9_combo", bodyV9)

    echo("webtransport_gossipsub_golden_probe ok")
    return 0
