import cheng/core/backend/primary_object_plan as pobj
import cheng/core/backend/lowering_plan as lower

fn assertExact(sym: str[], names: str[], paths: str[],
               sourcePath: str, target: str,
               wantSymbol: int32,
               wantName: int32,
               wantCombined: int32): bool =
    pobj.PrimaryBodyIrResetLookupCaches()
    var stub: lower.LoweringPlanStub
    stub.functionSymbolTexts = sym
    stub.functionNames = names
    stub.functionSourcePaths = paths
    return pobj.PrimaryPlanResolveTargetIndex(stub, sourcePath, target) == wantSymbol &&
           pobj.PrimaryPlanResolveNameTargetIndex(stub, sourcePath, target) == wantName &&
           pobj.PrimaryPlanResolveTargetIndexWithNames(stub,
                                                       sourcePath,
                                                       target) == wantCombined

fn main(): int32 =
    assert(pobj.PrimaryFunctionTailName("a::b.c") == "b.c",
           " tail split order")
    assert(pobj.PrimaryCallTargetTailName("::Run") == "Run",
           " qualified call leaf")
    assert(pobj.PrimaryPathNormalizedEquals("/work/src/a.cheng",
                                            "src/a.cheng"),
           " normalized owner path")

    assert(assertExact(["a::Run", "b::Run"],
                       ["Run", "Run"],
                       ["src/a.cheng", "src/b.cheng"],
                       "src/a.cheng", "Run", 0, 0, 0),
           " exact owner selects only its declaration")

    assert(assertExact(["a::Run"],
                       ["Run"],
                       ["src/a.cheng"],
                       "src/missing.cheng", "Run", -1, -1, -1),
           " global uniqueness is not visibility")

    assert(assertExact(["a::Run", "a2::Run"],
                       ["Run", "Run"],
                       ["src/a.cheng", "src/a.cheng"],
                       "src/a.cheng", "Run", -1, -1, -1),
           " same-owner overload requires call-site type resolution")

    assert(assertExact(["a::Other", "b::Run"],
                       ["Run", "Other"],
                       ["src/a.cheng", "src/b.cheng"],
                       "src/a.cheng", "Run", -1, 0, 0),
           " name fallback remains exact-owner")

    assert(assertExact(["a::Run"],
                       ["Run"],
                       ["src/a.cheng"],
                       "", "Run", -1, -1, -1),
           " empty owner is invalid")

    echo(" target_index_semantic_contract_smoke ok")
    return 0
