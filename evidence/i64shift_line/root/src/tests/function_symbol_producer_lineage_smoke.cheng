import std/result
import std/seqs as seqs
import std/strformat
import std/strings
import cheng/core/backend/lowering_plan as lower
import cheng/core/backend/primary_object_plan as primary
import cheng/core/backend/system_link_plan as slplan
import cheng/core/backend2/backend2_assemble as b2asm
import cheng/core/lang/intern as langintern
import cheng/core/lang/typed_expr as texpr
import cheng/core/runtime/arena as arenamod
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/tooling/compiler_request as creq
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256

fn lineageCid(label: str): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(64)
    for byteIndex in 0..<label.len:
        layout.ByteBufAppendByte(buf, int32(label[byteIndex]) & 255)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn lineageSourcePath(): str =
    return "/work/pkg/symbol_lineage.cheng"

fn lineagePlan(plan: var lower.LoweringPlanStub) =
    plan.workspaceRoot = "/work"
    plan.packageRoot = "/work/pkg"
    plan.typedIr.internPool = langintern.InternPoolNew()
    plan.typedIr.arena = arenamod.ArenaInitDefault(1048576)
    add(plan.typedIr.functions2_sourcePathIds,
        langintern.Intern(plan.typedIr.internPool, lineageSourcePath()))
    add(plan.typedIr.functions2_functionNameIds,
        langintern.Intern(plan.typedIr.internPool, "Pick"))
    arenamod.ArenaArrayInt32Add(
        plan.typedIr.arena,
        plan.typedIr.functions2_signatureLineNumbers,
        1)
    add(plan.typedIr.functions2_returnTypeIds,
        langintern.Intern(plan.typedIr.internPool, "int32"))
    add(plan.typedIr.functions2_resultExprClasses,
        texpr.TypedExprExprOwned)
    var err: str
    assert(lower.LoweringBuildTypedFunctionIdentityIndex(plan, err),
           Fmt"function symbol lineage: typed index failed {err}")

fn lineageNode(): ccsg.CompilerCsgNode =
    var node: ccsg.CompilerCsgNode
    node.nodeId = 41
    node.nodeKind = ccsg.CompilerCsgNodeKindSymbol
    node.ownerNodeId = 7
    node.modulePath = "pkg/symbol_lineage"
    node.symbolText = "pkg/symbol_lineage::Pick"
    node.factText = "Pick"
    node.producerSourceIndex = 7
    node.producerDeclarationIndex = 9
    node.nameProofCid = lineageCid("name-proof")
    node.semanticSource = "pkg/symbol_lineage"
    node.semanticDeclarationLineIndex = 1
    node.semanticParamTypeJoin = ""
    node.semanticReturnType = "int32"
    node.semanticSignatureComplete = 0
    node.resultLayoutKind = 5
    node.callConv = 1
    node.entryFlag = 1
    node.exportedFlag = 1
    # This annotation payload is intentionally not interned in TypedExpr.
    node.exportSymbolName = "导出/同名-β"
    node.exportNameExplicit = 1
    node.factCid = ccsg.CompilerCsgHashNodeRecord(node)
    return node

fn main(): int32 =
    var plan: lower.LoweringPlanStub
    lineagePlan(plan)
    var claimed: bool[]
    setLen(claimed, plan.typedIr.functions2_functionNameIds.len)
    let node = lineageNode()
    var err: str
    assert(lower.LoweringAppendCompilerCsgSemanticFunctionRow(
               plan, node, lineageSourcePath(), claimed, err),
           Fmt"function symbol lineage: CSG bind failed {err}")
    assert(lower.LoweringBuildExactFunctionNameIdentityColumn(plan, err),
           Fmt"function symbol lineage: name identity failed {err}")
    plan.entrySymbol = "Pick"
    plan.canonicalSnapshotProjectionAuthorityCid =
        lineageCid("snapshot-authority")
    plan.compilerCsgCid = lineageCid("compiler-csg")
    plan.functionNameInternPoolDomainCid =
        lower.LoweringFunctionNameInternPoolDomainCid(plan)
    assert(lower.LoweringValidateFunctionSemanticIdentityRows(plan, err),
           Fmt"function symbol lineage: row validation failed {err}")
    assert(lower.LoweringFunctionNameIdentityStrictValid(plan),
           "function symbol lineage: frozen receipt invalid")
    assert(plan.functionExportProducerSourceIndexes[0] == 7 &&
           plan.functionExportProducerDeclarationIndexes[0] == 9 &&
           plan.functionExportProducerNodeIds[0] == 41 &&
           layout.FixedBytes32Equal(
               plan.functionExportProducerFactCids[0], node.factCid),
           "function symbol lineage: exact CSG producer was not retained")

    var linkPlan: slplan.SystemLinkPlanStub
    linkPlan.emitKind = creq.EmitObj
    linkPlan.targetTriple = "riscv64-unknown-linux-gnu"
    var primaryRole: int32
    let primarySymbol = primary.PrimaryObjectPlanMaterializeFunctionSymbol(
        linkPlan, plan, 0, primaryRole)
    let projection = lower.LoweringProjectFunctionSymbolExact(
        plan, linkPlan, 0)
    var backend2Symbols: str[]
    add(backend2Symbols, strings.CloneStr(projection.decoratedUtf8))
    let backend2Symbol = b2asm.Backend2FunctionSymbolAtRowExact(
        backend2Symbols, 0)
    assert(primarySymbol == "导出/同名-β" &&
           backend2Symbol == primarySymbol &&
           primaryRole == lower.LoweringFunctionSymbolRoleExplicitExport &&
           projection.role == primaryRole,
           "function symbol lineage: primary/backend2 shared consumer drift")

    let frozenReceipt = plan.functionNameIdentityReceiptCid
    plan.functionExportProducerSourceIndexes[0] = 8
    assert(!lower.LoweringFunctionNameIdentityStrictValid(plan),
           "function symbol lineage: source producer mutation accepted")
    plan.functionExportProducerSourceIndexes[0] = 7
    plan.functionExportProducerDeclarationIndexes[0] = 10
    assert(!lower.LoweringFunctionNameIdentityStrictValid(plan),
           "function symbol lineage: declaration producer mutation accepted")
    plan.functionExportProducerDeclarationIndexes[0] = 9
    plan.functionExportProducerNodeIds[0] = 42
    assert(!lower.LoweringFunctionNameIdentityStrictValid(plan),
           "function symbol lineage: node producer mutation accepted")
    plan.functionExportProducerNodeIds[0] = 41
    plan.functionExportProducerFactCids[0] =
        lineageCid("same-text-different-fact")
    assert(!lower.LoweringFunctionNameIdentityStrictValid(plan),
           "function symbol lineage: fact producer mutation accepted")
    plan.functionExportProducerFactCids[0] =
        layout.FixedBytes32Copy(node.factCid)
    plan.functionNameIdentityReceiptCid = frozenReceipt
    assert(lower.LoweringFunctionNameIdentityStrictValid(plan),
           "function symbol lineage: exact producer restoration failed")

    lower.LoweringPlanReleaseFunctionRuntimeIdentityPayload(plan)
    lower.LoweringPlanReleaseFunctionEmissionMetadataPayload(plan)
    lower.LoweringFunctionSemanticIdentityAllocatorRelease(plan)
    lower.LoweringPlanReleaseTypedFunctionIdentityIndexPayload(plan)
    seqs.freeSeq(plan.functionNameIds)
    seqs.freeSeq(plan.typedIr.functions2_sourcePathIds)
    seqs.freeSeq(plan.typedIr.functions2_functionNameIds)
    seqs.freeSeq(plan.typedIr.functions2_returnTypeIds)
    seqs.freeSeq(plan.typedIr.functions2_resultExprClasses)
    arenamod.ArenaRelease(plan.typedIr.arena)
    langintern.InternPoolRelease(plan.typedIr.internPool)
    echo("function_symbol_producer_lineage_smoke=pass")
    return 0
