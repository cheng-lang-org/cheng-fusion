import std/strformat
import cheng/core/lang/parser
import cheng/core/lang/typed_expr as texpr
import cheng/core/lang/typed_expr_type_arena as typearena

@borrows
fn requireOk(ok: bool, err: str) =
    if !ok:
        panic(err)

fn requireCheck(ok: bool) =
    if !ok:
        panic("typed expr function source range smoke assertion failed")

@borrows
fn parsedSource(path: str,
                text: str,
                source: var texpr.TypedExprSourceText,
                ctx: var texpr.TypedExprSourceContext,
                layer: var parser.NormalizedExprLayer) =
    var externalPackageRoots: parser.ParserExternalPackageRoot[]
    source = texpr.TypedExprSourceTextNewWithPackageFacts(
        "/work",
        "/work/pkg",
        "pkg://typed-expr-function-source-range",
        "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
        externalPackageRoots,
        share(path),
        share(text))
    source.snapshotOnly = true
    var err = ""
    requireOk(texpr.TypedExprBuildSourceContext(source, ctx, err), err)
    requireOk(
        parser.ParserReadNormalizedExprLayerFromText(path, text, layer, err),
        err)

fn appendLayerPhysical(total: var parser.NormalizedExprLayer,
                       source: var parser.NormalizedExprLayer) =
    parser.NormalizedExprLayerAdd(total, source)

fn structuredStatementCount(layer: var parser.NormalizedExprLayer): int32 =
    var count: int32
    for exprIndex in 0..<layer.exprs.len:
        if parser.ParserNormalizedExprKindIsSidecarStructured(
                layer.exprs[exprIndex].kind):
            count = count + 1
    return count

@borrows
fn appendOneFunctionRange(
        ranges: var texpr.TypedExprFunctionSourceRangeSet,
        path: str,
        functionName: str,
        startLine: int32,
        endLine: int32,
        contextIndex: int32,
        functionScopeIndex: int32,
        rootPhysicalIndex: int32,
        exprPhysicalStart: int32,
        exprCount: int32,
        scopeCount: int32,
        statementCount: int32) =
    texpr.TypedExprFunctionSourceRangeSetAppend(ranges,
                                                path,
                                                functionName,
                                                startLine,
                                                endLine,
                                                contextIndex,
                                                functionScopeIndex,
                                                rootPhysicalIndex,
                                                exprPhysicalStart,
                                                exprCount,
                                                0,
                                                0,
                                                1,
                                                scopeCount,
                                                0,
                                                statementCount)

fn twoSourceBuildAndLocalStartRejection() =
    let pathA = "/work/pkg/range_a.cheng"
    let pathB = "/work/pkg/range_b.cheng"
    let textA = "fn First(): int32 =\n    let value: int32 = 1\n    return value\n"
    let textB = "fn Second(): int32 =\n    let value: int32 = 2\n    return value\n"
    var sourceA: texpr.TypedExprSourceText
    var sourceB: texpr.TypedExprSourceText
    var ctxA: texpr.TypedExprSourceContext
    var ctxB: texpr.TypedExprSourceContext
    var layerA: parser.NormalizedExprLayer
    var layerB: parser.NormalizedExprLayer
    parsedSource(pathA, textA, sourceA, ctxA, layerA)
    parsedSource(pathB, textB, sourceB, ctxB, layerB)
    requireCheck(layerA.exprs.len > 0)
    requireCheck(layerB.exprs.len > 0)
    requireCheck(ctxA.scopes.len == 1)
    requireCheck(ctxB.scopes.len == 1)
    let layerAExprCount = layerA.exprs.len
    let layerBExprCount = layerB.exprs.len
    let layerAScopeCount = layerA.scopes.len
    let layerBScopeCount = layerB.scopes.len
    let layerAStatementCount = structuredStatementCount(layerA)
    let layerBStatementCount = structuredStatementCount(layerB)
    let layerADeclarationCount = layerA.valueExprTree.declarationCount
    let layerBDeclarationCount = layerB.valueExprTree.declarationCount

    var sourceTexts: texpr.TypedExprSourceText[]
    add(sourceTexts, sourceA)
    add(sourceTexts, sourceB)
    var contexts: texpr.TypedExprSourceContext[]
    texpr.TypedExprSourceContextAppendMove(contexts, ctxA)
    texpr.TypedExprSourceContextAppendMove(contexts, ctxB)
    texpr.TypedExprBindExactLayoutParserAuthority(
        contexts[0], 2, layerADeclarationCount)
    texpr.TypedExprBindExactLayoutParserAuthority(
        contexts[1], 2, layerBDeclarationCount)
    var physicalLayer: parser.NormalizedExprLayer
    appendLayerPhysical(physicalLayer, layerA)
    appendLayerPhysical(physicalLayer, layerB)
    var facts: texpr.TypedExprFactTable

    var ranges = texpr.TypedExprFunctionSourceRangeSetInit(2)
    appendOneFunctionRange(ranges,
                           pathA,
                           "First",
                           contexts[0].scopes[0].startLine,
                           contexts[0].scopes[0].endLine,
                           0,
                           0,
                           0,
                           0,
                           layerAExprCount,
                           layerAScopeCount - 1,
                           layerAStatementCount)
    appendOneFunctionRange(ranges,
                           pathB,
                           "Second",
                           contexts[1].scopes[0].startLine,
                           contexts[1].scopes[0].endLine,
                           1,
                           0,
                           layerAScopeCount,
                           layerAExprCount,
                           layerBExprCount,
                           layerBScopeCount - 1,
                           layerBStatementCount)
    texpr.TypedExprFunctionSourceRangeSetSeal(ranges)

    # Adversarial proof: FunctionSourceSliceIndex's second source-local start is
    # zero, but this API requires a physical global index. Test rejection before
    # the successful build consumes and clears the original expr payload.
    var ir: texpr.TypedExprIr
    var err = ""
    let typeResolutionAuthority =
        typearena.TypedExprTypeResolutionAuthorityEmpty()
    var exactTypeArena: typearena.TypedExprTypeArena
    requireOk(
        typearena.TypedExprTypeArenaBuildFromParserTreeInto(
            physicalLayer.valueExprTree,
            typeResolutionAuthority,
            exactTypeArena,
            err),
        err)
    requireOk(
        typearena.TypedExprTypeArenaStrictValidateInto(exactTypeArena, err),
        err)
    requireOk(texpr.TypedExprIrBindExactTypeArena(ir, exactTypeArena, err), err)
    var localStartRanges = texpr.TypedExprFunctionSourceRangeSetInit(2)
    appendOneFunctionRange(localStartRanges,
                           pathA,
                           "First",
                           contexts[0].scopes[0].startLine,
                           contexts[0].scopes[0].endLine,
                           0,
                           0,
                           0,
                           0,
                           layerAExprCount,
                           layerAScopeCount - 1,
                           layerAStatementCount)
    appendOneFunctionRange(localStartRanges,
                           pathB,
                           "Second",
                           contexts[1].scopes[0].startLine,
                           contexts[1].scopes[0].endLine,
                           1,
                           0,
                           layerAScopeCount,
                           0,
                           layerBExprCount,
                           layerBScopeCount - 1,
                           layerBStatementCount)
    texpr.TypedExprFunctionSourceRangeSetSeal(localStartRanges)
    let functionsBefore = ir.functions2_functionNameIds.len
    let statementsBefore = ir.statements2_statementIndexs.len
    let nodesBefore = ir.nodes2_nodeIndexs.len
    var rejectedReport: texpr.TypedExprFunctionSourceRangeBuildReport
    if texpr.TypedExprAppendIrFunctionsForFunctionSourceRanges(
            sourceTexts,
            facts,
            physicalLayer,
            contexts,
            localStartRanges,
            ir,
            rejectedReport,
            err):
        panic("function-range-local-start-was-accepted")
    requireCheck(err != "")
    requireCheck(ir.functions2_functionNameIds.len == functionsBefore)
    requireCheck(ir.statements2_statementIndexs.len == statementsBefore)
    requireCheck(ir.nodes2_nodeIndexs.len == nodesBefore)

    var report: texpr.TypedExprFunctionSourceRangeBuildReport
    err = ""
    requireOk(texpr.TypedExprBuildIrForFunctionSourceRanges(sourceTexts,
                                                             facts,
                                                             physicalLayer,
                                                             contexts,
                                                             ranges,
                                                             ir,
                                                             report,
                                                             err), err)
    requireCheck(report.rowCount == 2)
    requireCheck(report.activeRangePeak == 1)
    requireCheck(report.activeRangeCount == 0)
    requireCheck(report.fullSourceScopeRescanCount == 0)
    requireCheck(report.fullSourceLineRescanCount == 0)
    requireCheck(report.perRowFullSourceBindingRescanCount == 0)
    requireCheck(report.sourceBindingIndexBuildCount == 2)
    requireCheck(report.functionLineVisitCount == Int64(6))
    requireCheck(report.bindingIndexBuildVisitCount == Int64(2))
    requireCheck(report.bindingIndexFillVisitCount == Int64(2))
    requireCheck(report.commitExprVisitCount == Int64(layerAExprCount + layerBExprCount))
    requireCheck(report.functionCountAfter == 2)
    for exprIndex in 0..<physicalLayer.exprs.len:
        if physicalLayer.exprs[exprIndex].sourcePath != "":
            panic("function-range-committed-expr-payload-released")

fn sealedSecondRoundBuild() =
    let pathA = "/work/pkg/range_sealed_a.cheng"
    let pathB = "/work/pkg/range_sealed_b.cheng"
    let textA = "fn First(): int32 =\n    let value: int32 = 1\n    return value\n"
    let textB = "fn Second(): int32 =\n    let value: int32 = 2\n    return value\n"
    var sourceA: texpr.TypedExprSourceText
    var sourceB: texpr.TypedExprSourceText
    var ctxA: texpr.TypedExprSourceContext
    var ctxB: texpr.TypedExprSourceContext
    var layerA: parser.NormalizedExprLayer
    var layerB: parser.NormalizedExprLayer
    parsedSource(pathA, textA, sourceA, ctxA, layerA)
    parsedSource(pathB, textB, sourceB, ctxB, layerB)

    let layerAExprCount = layerA.exprs.len
    let layerBExprCount = layerB.exprs.len
    let layerAScopeCount = layerA.scopes.len
    let layerBScopeCount = layerB.scopes.len
    let layerAStatementCount = structuredStatementCount(layerA)
    let layerBStatementCount = structuredStatementCount(layerB)
    let layerADeclarationCount = layerA.valueExprTree.declarationCount
    let layerBDeclarationCount = layerB.valueExprTree.declarationCount
    var err = ""
    var profileA: parser.NormalizedExprCallProfile
    var profileB: parser.NormalizedExprCallProfile
    requireOk(parser.ParserBuildExprCallProfileWithExternalPackageRoots(
                  sourceA.workspaceRoot,
                  sourceA.packageRoot,
                  sourceA.externalPackageRoots,
                  pathA,
                  textA,
                  profileA,
                  err), err)
    requireOk(parser.ParserBuildExprCallProfileWithExternalPackageRoots(
                  sourceB.workspaceRoot,
                  sourceB.packageRoot,
                  sourceB.externalPackageRoots,
                  pathB,
                  textB,
                  profileB,
                  err), err)
    requireOk(texpr.TypedExprBuildMetadataContextFromProfile(
                  profileA, sourceA, ctxA, err), err)
    requireOk(texpr.TypedExprBuildMetadataContextFromProfile(
                  profileB, sourceB, ctxB, err), err)
    texpr.TypedExprClearMetadataContextScopeSourcePaths(ctxA)
    texpr.TypedExprClearMetadataContextScopeSourcePaths(ctxB)
    texpr.TypedExprBindExactLayoutParserAuthority(
        ctxA, 2, layerADeclarationCount)
    texpr.TypedExprBindExactLayoutParserAuthority(
        ctxB, 2, layerBDeclarationCount)

    # The TypeArena is package-wide, while each production reachability round
    # consumes only that round's physical parser layer.
    var typeArenaLayer: parser.NormalizedExprLayer
    var typeArenaLayerA: parser.NormalizedExprLayer
    var typeArenaLayerB: parser.NormalizedExprLayer
    requireOk(parser.ParserReadNormalizedExprLayerFromText(
                  pathA, textA, typeArenaLayerA, err), err)
    requireOk(parser.ParserReadNormalizedExprLayerFromText(
                  pathB, textB, typeArenaLayerB, err), err)
    appendLayerPhysical(typeArenaLayer, typeArenaLayerA)
    appendLayerPhysical(typeArenaLayer, typeArenaLayerB)

    var allSources: texpr.TypedExprSourceText[]
    add(allSources, sourceA)
    add(allSources, share(sourceB))
    var metadataContexts: texpr.TypedExprSourceContext[]
    texpr.TypedExprSourceContextAppendMove(metadataContexts, ctxA)
    texpr.TypedExprSourceContextAppendMove(metadataContexts, ctxB)
    var firstRanges = texpr.TypedExprFunctionSourceRangeSetInit(1)
    appendOneFunctionRange(firstRanges,
                           pathA,
                           "First",
                           metadataContexts[0].scopes[0].startLine,
                           metadataContexts[0].scopes[0].endLine,
                           0,
                           0,
                           0,
                           0,
                           layerAExprCount,
                           layerAScopeCount - 1,
                           layerAStatementCount)
    texpr.TypedExprFunctionSourceRangeSetSeal(firstRanges)
    var facts: texpr.TypedExprFactTable
    var ir: texpr.TypedExprIr
    var firstReport: texpr.TypedExprFunctionSourceRangeBuildReport
    let typeResolutionAuthority =
        typearena.TypedExprTypeResolutionAuthorityEmpty()
    var exactTypeArena: typearena.TypedExprTypeArena
    requireOk(typearena.TypedExprTypeArenaBuildFromParserTreeInto(
                  typeArenaLayer.valueExprTree,
                  typeResolutionAuthority,
                  exactTypeArena,
                  err), err)
    requireOk(typearena.TypedExprTypeArenaStrictValidateInto(
                  exactTypeArena, err), err)
    requireOk(texpr.TypedExprIrBindExactTypeArena(
                  ir, exactTypeArena, err), err)
    requireOk(texpr.TypedExprBuildIrForFunctionSourceRangesFromMetadata(
        allSources,
        facts,
        layerA,
        metadataContexts,
        firstRanges,
        ir,
        firstReport,
        err), err)
    requireCheck(firstReport.functionCountAfter == 1)
    requireCheck(firstReport.contextIndexBuildVisitCount == Int64(2))
    requireCheck(firstReport.contextIndexLookupCount == Int64(1))
    requireOk(texpr.TypedExprSealBuildSourceContextIndex(ir,
                                                          metadataContexts,
                                                          err), err)
    requireCheck(metadataContexts.len == 0)
    requireCheck(texpr.TypedExprSealedBuildIndexActive(ir))

    var secondSources: texpr.TypedExprSourceText[]
    add(secondSources, sourceB)
    var secondRanges = texpr.TypedExprFunctionSourceRangeSetInit(1)
    appendOneFunctionRange(secondRanges,
                           pathB,
                           "Second",
                           1,
                           3,
                           0,
                           0,
                           0,
                           0,
                           layerBExprCount,
                           layerBScopeCount - 1,
                           layerBStatementCount)
    texpr.TypedExprFunctionSourceRangeSetSeal(secondRanges)
    var secondReport: texpr.TypedExprFunctionSourceRangeBuildReport
    err = ""
    requireOk(texpr.TypedExprAppendIrFunctionsForFunctionSourceRangesSealed(
        secondSources,
        facts,
        layerB,
        secondRanges,
        ir,
        secondReport,
        err), err)
    requireCheck(secondReport.sealedRoundViewUsed)
    requireCheck(secondReport.sealedRoundContextCount == 1)
    requireCheck(secondReport.sealedRoundDependencyCount == 0)
    requireCheck(secondReport.contextIndexBuildVisitCount == Int64(1))
    requireCheck(secondReport.contextIndexLookupCount == Int64(1))
    requireCheck(secondReport.functionCountBefore == 1)
    requireCheck(secondReport.functionCountAfter == 2)
    var sawFirstStableProducer = false
    var sawSecondStableProducer = false
    for definitionRow in 0..<texpr.TypedExprValueDefinitionAuthorityCount(ir):
        let producerSourceIndex =
            texpr.TypedExprValueDefinitionProducerSourceIndexAt(
                ir, definitionRow)
        if producerSourceIndex == 0:
            sawFirstStableProducer = true
        elif producerSourceIndex == 1:
            sawSecondStableProducer = true
        else:
            panic("sealed-round-value-definition-producer-outside-package-domain")
    requireCheck(sawFirstStableProducer)
    requireCheck(sawSecondStableProducer)
    requireOk(texpr.TypedExprCloseSealedBuildSourceContextIndex(ir, err), err)

fn linearBindingPreflight(functionCount: int32) =
    let path = Fmt"/work/pkg/range_linear_{functionCount}.cheng"
    var text = ""
    var ctx: texpr.TypedExprSourceContext
    ctx.sourcePath = share(path)
    ctx.normalizedSourcePath = share(path)
    var ranges = texpr.TypedExprFunctionSourceRangeSetInit(functionCount)
    for functionIndex in 0..<functionCount:
        let functionName = Fmt"F{functionIndex}"
        text = Fmt"{text}fn {functionName}(): int32 = 0\n"
        add(ctx.lines, Fmt"fn {functionName}(): int32 = 0")
        var scope: texpr.TypedExprFunctionScope
        scope.sourcePath = share(path)
        scope.name = share(functionName)
        scope.startLine = functionIndex + 1
        scope.endLine = functionIndex + 1
        scope.returnType = "int32"
        scope.genericNamesComplete = true
        scope.paramTypesComplete = true
        add(ctx.scopes, scope)
        var binding: texpr.TypedExprBinding
        binding.sourcePath = share(path)
        binding.functionName = share(functionName)
        binding.lineNumber = functionIndex + 1
        binding.name = "value"
        binding.typeText = "int32"
        add(ctx.bindings, binding)
        texpr.TypedExprFunctionSourceRangeSetAppend(ranges,
                                                    path,
                                                    functionName,
                                                    functionIndex + 1,
                                                    functionIndex + 1,
                                                    0,
                                                    functionIndex,
                                                    0,
                                                    0,
                                                    0,
                                                    0,
                                                    0,
                                                    1,
                                                    0,
                                                    0,
                                                    0)
    texpr.TypedExprFunctionSourceRangeSetSeal(ranges)
    var contexts: texpr.TypedExprSourceContext[]
    texpr.TypedExprSourceContextAppendMove(contexts, ctx)
    var sourceTexts: texpr.TypedExprSourceText[]
    var externalPackageRoots: parser.ParserExternalPackageRoot[]
    var source = texpr.TypedExprSourceTextNewWithPackageFacts(
        "/work",
        "/work/pkg",
        "pkg://typed-expr-function-source-range",
        "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
        externalPackageRoots,
        share(path),
        text)
    source.snapshotOnly = true
    add(sourceTexts, source)
    var layer: parser.NormalizedExprLayer
    layer.sourceCount = 1
    var root: parser.NormalizedScopeFact
    root.sourcePath = path
    root.scopeId = 0
    root.sourceScopeId = 0
    root.parentScopeId = -1
    root.kind = parser.NormalizedScopeRoot
    root.ownerStatementOrdinal = -1
    root.ownerDeclarationRow = -1
    root.lexicalOrdinal = 0
    root.startLineNumber = 1
    root.startColumnNumber = 1
    root.endLineNumber = functionCount
    root.endColumnNumber = 1
    add(layer.scopes, root)
    var facts: texpr.TypedExprFactTable
    var report: texpr.TypedExprFunctionSourceRangeBuildReport
    var err = ""
    requireOk(texpr.TypedExprFunctionSourceRangesPreflight(sourceTexts,
                                                            facts,
                                                            layer,
                                                            contexts,
                                                            ranges,
                                                            report,
                                                            err), err)
    requireCheck(report.rowCount == functionCount)
    requireCheck(report.preflightRowVisitCount == Int64(functionCount))
    requireCheck(report.preflightExprVisitCount == Int64(0))
    requireCheck(report.preflightScopeVisitCount == Int64(0))
    requireCheck(report.preflightStatementVisitCount == Int64(0))
    requireCheck(report.bindingIndexBuildVisitCount == Int64(functionCount))
    requireCheck(report.bindingIndexFillVisitCount == Int64(functionCount))
    requireCheck(report.fullSourceScopeRescanCount == 0)
    requireCheck(report.fullSourceLineRescanCount == 0)
    requireCheck(report.perRowFullSourceBindingRescanCount == 0)
    requireCheck(report.sourceBindingIndexBuildCount == 1)

fn main(): int32 =
    twoSourceBuildAndLocalStartRejection()
    sealedSecondRoundBuild()
    linearBindingPreflight(1)
    linearBindingPreflight(2)
    linearBindingPreflight(1024)
    return 0
