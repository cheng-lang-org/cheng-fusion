import std/system as system
import std/os as os
import std/rawbytes as bytes
import std/crypto/sha256 as sha256

var frame: bytes.Bytes
var frameOff: int32

fn putU64(value: uint64) =
    for i in 0..<8:
        bytes.BytesSet(frame, frameOff + i,
            uint8((value >> uint64(i * 8)) & uint64(255)))
    frameOff = frameOff + 8

fn putText(value: str) =
    for i in 0..<value.len:
        bytes.BytesSet(frame, frameOff + i, uint8(int32(value[i]) & 255))
    frameOff = frameOff + value.len

fn b2u(v: bool): uint64 =
    return v ? uint64(1) : uint64(0)

fn be64(d: bytes.Bytes, off: int32): uint64 =
    var out = uint64(0)
    for i in 0..<8:
        out = (out << uint64(8)) | uint64(bytes.BytesGet(d, off + i))
    return out

fn main(argc: int32, argv: str*): int32 =
    var cap: system.RuntimeAllocationLedgerSessionCapability
    if !system.RuntimeAllocationLedgerSessionOwnerBegin(
           uint64(1073741824), cap):
        os.WriteLine(os.Get_stderr(), "begin-failed")
        return 1
    var wire: system.RuntimeAllocationLedgerReceiptWire
    var closeErr: str
    let closeRc = system.runtimeAllocationLedgerSessionOwnerCloseBridge(
        cap.handle, cap.generation, cap.nonce0, cap.nonce1,
        wire, closeErr)
    if closeRc != 1:
        os.WriteLine(os.Get_stderr(), "close-bridge-failed")
        return 1
    var r: system.RuntimeAllocationLedgerReceipt
    r.complete = wire.complete == 1
    r.active = wire.active == 1
    r.closed = wire.closed == 1
    r.operation = wire.operation
    r.storageKind = wire.storageKind
    r.rawManagedPointerAbaProven = wire.rawManagedPointerAbaProven == 1
    r.recursiveLockProven = wire.recursiveLockProven == 1
    r.capabilityGeneration = wire.capabilityGeneration
    r.allocationId = wire.allocationId
    r.ownerGeneration = wire.ownerGeneration
    r.allocationGeneration = wire.allocationGeneration
    r.slabId = wire.slabId
    r.slabGeneration = wire.slabGeneration
    r.slabBackingBytes = wire.slabBackingBytes
    r.backingDeltaBytes = wire.backingDeltaBytes
    r.reallocOverlapUsableBytes = wire.reallocOverlapUsableBytes
    r.requestedPayloadBytes = wire.requestedPayloadBytes
    r.usablePayloadBytes = wire.usablePayloadBytes
    r.headerBytes = wire.headerBytes
    r.backingBytes = wire.backingBytes
    r.alignmentBytes = wire.alignmentBytes
    r.allocatorLayoutCid.word0 = wire.layout0
    r.allocatorLayoutCid.word1 = wire.layout1
    r.allocatorLayoutCid.word2 = wire.layout2
    r.allocatorLayoutCid.word3 = wire.layout3
    r.ownerDomainCid.word0 = wire.ownerDomain0
    r.ownerDomainCid.word1 = wire.ownerDomain1
    r.ownerDomainCid.word2 = wire.ownerDomain2
    r.ownerDomainCid.word3 = wire.ownerDomain3
    r.eventChainCid.word0 = wire.eventChain0
    r.eventChainCid.word1 = wire.eventChain1
    r.eventChainCid.word2 = wire.eventChain2
    r.eventChainCid.word3 = wire.eventChain3
    r.backingLimit = wire.backingLimit
    r.controlPlaneBackingBytes = wire.controlPlaneBackingBytes
    r.liveBackingBytes = wire.liveBackingBytes
    r.peakBackingBytes = wire.peakBackingBytes
    r.liveMappedVirtualBytes = wire.liveMappedVirtualBytes
    r.peakMappedVirtualBytes = wire.peakMappedVirtualBytes
    r.liveAllocationCount = wire.liveAllocationCount
    r.peakAllocationCount = wire.peakAllocationCount
    r.liveMappingCount = wire.liveMappingCount
    r.liveHandleCount = wire.liveHandleCount
    r.peakHandleCount = wire.peakHandleCount
    r.eventIndex = wire.eventIndex
    r.receiptCid.word0 = wire.receipt0
    r.receiptCid.word1 = wire.receipt1
    r.receiptCid.word2 = wire.receipt2
    r.receiptCid.word3 = wire.receipt3
    frame = bytes.BytesAlloc(436)
    frameOff = 0
    let domain = "cheng.runtime.allocation_ledger.receipt_wire"
    putU64(uint64(44))
    putText(domain)
    putU64(uint64(0x43484c4452435054))
    putU64(uint64(384))
    putU64(b2u(r.complete))
    putU64(b2u(r.active))
    putU64(b2u(r.closed))
    putU64(uint64(int32(r.operation)))
    putU64(uint64(int32(r.storageKind)))
    putU64(b2u(r.rawManagedPointerAbaProven))
    putU64(b2u(r.recursiveLockProven))
    putU64(uint64(0))
    putU64(r.capabilityGeneration)
    putU64(r.allocationId)
    putU64(r.ownerGeneration)
    putU64(r.allocationGeneration)
    putU64(r.slabId)
    putU64(r.slabGeneration)
    putU64(r.slabBackingBytes)
    putU64(r.backingDeltaBytes)
    putU64(r.reallocOverlapUsableBytes)
    putU64(r.requestedPayloadBytes)
    putU64(r.usablePayloadBytes)
    putU64(r.headerBytes)
    putU64(r.backingBytes)
    putU64(r.alignmentBytes)
    putU64(r.allocatorLayoutCid.word0)
    putU64(r.allocatorLayoutCid.word1)
    putU64(r.allocatorLayoutCid.word2)
    putU64(r.allocatorLayoutCid.word3)
    putU64(r.ownerDomainCid.word0)
    putU64(r.ownerDomainCid.word1)
    putU64(r.ownerDomainCid.word2)
    putU64(r.ownerDomainCid.word3)
    putU64(r.eventChainCid.word0)
    putU64(r.eventChainCid.word1)
    putU64(r.eventChainCid.word2)
    putU64(r.eventChainCid.word3)
    putU64(r.backingLimit)
    putU64(r.controlPlaneBackingBytes)
    putU64(r.liveBackingBytes)
    putU64(r.peakBackingBytes)
    putU64(r.liveMappedVirtualBytes)
    putU64(r.peakMappedVirtualBytes)
    putU64(r.liveAllocationCount)
    putU64(r.peakAllocationCount)
    putU64(r.liveMappingCount)
    putU64(r.liveHandleCount)
    putU64(r.peakHandleCount)
    putU64(r.eventIndex)
    var st = sha256.Sha256TwoPartStateInit()
    sha256.Sha256TwoPartUpdate(st, frame)
    let digest = sha256.Sha256TwoPartFinish(st)
    let w0 = be64(digest, 0)
    let w1 = be64(digest, 8)
    let w2 = be64(digest, 16)
    let w3 = be64(digest, 24)
    if w0 == r.receiptCid.word0 && w1 == r.receiptCid.word1 &&
       w2 == r.receiptCid.word2 && w3 == r.receiptCid.word3:
        os.WriteLine(os.Get_stdout(), "module-matches-provider")
        return 0
    os.WriteLine(os.Get_stdout(), "module-diverges-from-provider")
    return 2
