import std/system

type
    DropRow =
        left: str
        marker: int32
        right: str

fn ownedLabel(id: int32): str =
    return Fmt"seq-aggregate-str-owned-{id}"

fn main(): int32 =
    var rows: DropRow[]
    setLen(rows, 2)

    let liveBaseline = memLiveCount()
    let allocBaseline = memAllocCount()
    let freeBaseline = memFreeCount()
    var keptLeft = ownedLabel(101)
    var keptRight = ownedLabel(102)
    var tailLeft = ownedLabel(201)
    var tailRight = ownedLabel(202)
    assert(memLiveCount() == liveBaseline + 4,
           " seq aggregate str drop: four initial payloads are live")

    rows[0].left = keptLeft
    rows[0].marker = 37
    rows[0].right = keptRight
    rows[1].left = tailLeft
    rows[1].marker = 73
    rows[1].right = tailRight
    keptLeft = ""
    keptRight = ""
    tailLeft = ""
    tailRight = ""
    assert(memLiveCount() == liveBaseline + 4,
           " seq aggregate str drop: two rows own four payloads")

    let retainBeforeTailDrop = memRetainCount()
    let releaseBeforeTailDrop = memReleaseCount()
    setLen(rows, 1)
    assert(memRetainCount() == retainBeforeTailDrop,
           " seq aggregate str drop: shrinking does not retain tail fields")
    assert(memReleaseCount() == releaseBeforeTailDrop + 2,
           " seq aggregate str drop: shrinking releases each tail field once")
    assert(memLiveCount() == liveBaseline + 2,
           " seq aggregate str drop: shrinking destroys only the removed row")
    assert(rows[0].left == "seq-aggregate-str-owned-101",
           " seq aggregate str drop: kept left field survives tail destruction")
    assert(rows[0].right == "seq-aggregate-str-owned-102",
           " seq aggregate str drop: kept right field survives tail destruction")
    assert(rows[0].marker == 37,
           " seq aggregate str drop: kept scalar survives tail destruction")

    setLen(rows, 2)
    assert(len(rows[1].left) == 0 && len(rows[1].right) == 0,
           " seq aggregate str drop: regrown tail strings are zero initialized")
    assert(rows[1].marker == 0,
           " seq aggregate str drop: regrown tail scalar is zero initialized")

    var reboundLeft = ownedLabel(301)
    var reboundRight = ownedLabel(302)
    rows[1].left = reboundLeft
    rows[1].marker = 91
    rows[1].right = reboundRight
    reboundLeft = ""
    reboundRight = ""
    assert(rows[1].left == "seq-aggregate-str-owned-301" &&
           rows[1].right == "seq-aggregate-str-owned-302" &&
           rows[1].marker == 91,
           " seq aggregate str drop: regrown tail owns reassigned values")
    assert(memLiveCount() == liveBaseline + 4,
           " seq aggregate str drop: rebound sequence owns four payloads")

    let retainBeforeFinalDrop = memRetainCount()
    let releaseBeforeFinalDrop = memReleaseCount()
    setLen(rows, 0)
    assert(memRetainCount() == retainBeforeFinalDrop,
           " seq aggregate str drop: final shrink does not retain fields")
    assert(memReleaseCount() == releaseBeforeFinalDrop + 4,
           " seq aggregate str drop: final shrink releases four fields once")
    assert(memLiveCount() == liveBaseline,
           " seq aggregate str drop: final shrink restores live baseline")
    assert(memAllocCount() - allocBaseline == memFreeCount() - freeBaseline,
           " seq aggregate str drop: all owned string allocations are freed")
    echo("seq_aggregate_str_drop_glue_smoke ok")
    return 0
