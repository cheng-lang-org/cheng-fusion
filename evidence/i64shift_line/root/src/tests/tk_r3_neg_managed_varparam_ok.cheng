import std/system as system

type
    TkR3Managed =
        tag: str
        n: int32

fn TkR3ManagedFill(seed: int32, out: var TkR3Managed): int32 =
    var next: TkR3Managed
    next.tag = strings.ConcatStr("he", "llo")
    next.n = seed
    out = next
    return out.n

fn main(): int32 =
    var got: TkR3Managed
    let n = TkR3ManagedFill(3, got)
    os.WriteLine(os.Get_stdout(),
        strings.ConcatStr(got.tag, strings.ConcatStr("/", strings.Int64ToStr(int64(n)))))
    return 0
