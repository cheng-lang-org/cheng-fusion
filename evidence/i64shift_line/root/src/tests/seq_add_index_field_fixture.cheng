type
    Entry =
        key: str
        weight: int32

fn uniqueKeyCount(entries: Entry[]): int32 =
    var keys: str[]
    var count: int32
    for i in 0..<entries.len:
        var seen = false
        for j in 0..<keys.len:
            if keys[j] == entries[i].key:
                seen = true
                break
        if seen:
            continue
        add(keys, entries[i].key)
        count = count + 1
    return count

fn weightSum(entries: Entry[]): int32 =
    var ws: int32[]
    var total: int32
    for i in 0..<entries.len:
        add(ws, entries[i].weight)
    for k in 0..<ws.len:
        total = total + ws[k]
    return total

fn main(): int32 =
    var entries: Entry[]
    var a: Entry
    a.key = "alpha"
    a.weight = 3
    add(entries, a)
    var b: Entry
    b.key = "beta"
    b.weight = 5
    add(entries, b)
    var c: Entry
    c.key = "alpha"
    c.weight = 7
    add(entries, c)
    if uniqueKeyCount(entries) != 2:
        return 1
    if weightSum(entries) != 15:
        return 2
    echo("seq_add_index_field_fixture ok")
    return 0
