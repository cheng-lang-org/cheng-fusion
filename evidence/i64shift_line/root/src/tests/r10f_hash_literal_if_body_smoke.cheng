# R10-F hash-literal if-body recovery fixture:
# A '#'-bearing string literal in an if-condition previously caused the
# parser fact layer to drop every statement in the function scope, and the
# repair pass failed to re-register the control header (parser dropped the
# control expr too), so the if-body statement was silently lost from
# ir.statements. classify("zzz") returned 2 instead of 1.
# The fix re-registers any recognized control header during repair so its
# body lines are recovered even when the parser fact layer drops the line.

fn classify(s: str): int32 =
    if s != "a#c":
        return 1
    return 2

fn classifyStart(s: str): int32 =
    if s != "#lead":
        return 3
    return 4

fn classifyEnd(s: str): int32 =
    if s == "trail#":
        return 5
    return 6

fn main(): int32 =
    if classify("zzz") != 1:
        return 1
    if classify("a#c") != 2:
        return 2
    if classifyStart("other") != 3:
        return 3
    if classifyStart("#lead") != 4:
        return 4
    if classifyEnd("trail#") != 5:
        return 5
    if classifyEnd("nope") != 6:
        return 6
    return 0
