import cheng/std/bytes_layout as layout

@borrows
fn chooseFixed32(
        useZero: bool,
        values: layout.FixedBytes32[],
        index: int32): layout.FixedBytes32 =
    return useZero ? layout.FixedBytes32() : values[index]

fn main(): int32 =
    var nonzero = layout.FixedBytes32()
    nonzero.data[0] = 37
    let values = [nonzero]
    let zero = chooseFixed32(true, values, 0)
    if zero.data[0] != 0:
        return 1
    let selected = chooseFixed32(false, values, 0)
    if selected.data[0] != 37:
        return 2
    return 0
