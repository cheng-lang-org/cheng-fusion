# libp2p P2 S2: 真两进程 CAS-source 服务端 exe (正典 §11.6 P2 S2)。
# 真 bind + AcceptTimed + 写 ready-port 文件; 收 WANT → 查本地 CAS 库 → 组 BLOCK 帧回。
# 非 loopback: 独立 OS 进程, 客户端另进程真 UDP dial。
#
# 用法: --port 0 --ready-path <f> --store-root <dir> --content <blob文本>
# 流程: 把源 blob ingest 进 store (得 cid) → serve 恰好 1 个请求 → 退出 0。

import std/system
import std/cmdline as cmdline
import cheng/libp2p/cas_store as cas
import cheng/libp2p/host/host_quic as hq
import std/strutils as strutil

fn main(): int32 =
    let port = cmdline.ReadInt32FlagOrDefault("--port", 0)
    let readyPath = cmdline.ReadFlagOrDefault("--ready-path", "")
    let storeRoot = cmdline.ReadFlagOrDefault("--store-root", "")
    let content = cmdline.ReadFlagOrDefault("--content", "")
    assert(readyPath != "", " server: --ready-path required")
    assert(storeRoot != "", " server: --store-root required")
    assert(content != "", " server: --content required")

    let ingestRes = cas.CasStoreIngest(storeRoot, content)
    assert(ingestRes.ok, " server: cas ingest: " + Error(ingestRes))
    let cidHex = ingestRes.value
    echo(strutil.Join([" cas_source server ingested cid=", cidHex], ""))

    let serveRes = hq.Libp2pHostQuicServeCasSource("127.0.0.1",
                                                     port,
                                                     "localhost",
                                                     storeRoot,
                                                     readyPath,
                                                     1,
                                                     -1)
    assert(serveRes.ok, " server: serve: " + Error(serveRes))
    assert(serveRes.value == 1, " server: served exactly 1 request")
    echo(" cas_source_quic_twoproc_server ok")
    return 0
