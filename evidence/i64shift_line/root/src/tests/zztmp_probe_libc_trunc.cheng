# probe_libc_trunc.cheng — RUNTIME-LIBC-TRUNC 探针
# 实证 libc_read/libc_write/libc_send/libc_recv 的 ssize_t 返回通道:
# 错误路径必须交付 int64 -1(符号位完整, 而非零扩展 4294967295),
# 成功路径交付精确字节计数, EOF 交付 0。
import std/strings

@importc("libc_read")
fn libc_read(fd: int32, buf: ptr, count: int64): int64
@importc("libc_write")
fn libc_write(fd: int32, buf: ptr, count: int64): int64
@importc("libc_send")
fn libc_send(fd: int32, buf: ptr, len: int32, flags: int32): int64
@importc("libc_recv")
fn libc_recv(fd: int32, buf: ptr, len: int32, flags: int32): int64
@importc("libc_socket")
fn libc_socket(domain: int32, typ: int32, protocol: int32): int32
@importc("libc_close")
fn libc_close(fd: int32): int32
@importc("libc_open")
fn libc_open(path: ptr, flags: int32, mode: int32): int32
@importc("malloc")
fn rawMalloc(size: int64): ptr

fn main(): int32 =
    let neg1: int64 = Int64(0) - Int64(1)
    var bad: int32 = 0
    let buf = rawMalloc(4096)
    if buf == nil:
        echo("probe_malloc_failed")
        return 2
    # 1. read 非法 fd -> 期望精确 -1
    let rdBad: int64 = libc_read(2147480000, buf, Int64(16))
    echo(Fmt"read_badfd={strings.Int64ToStr(rdBad)}")
    if rdBad != neg1:
        bad = 1
    # 2. write 非法 fd -> 期望精确 -1
    let wrBad: int64 = libc_write(2147480000, buf, Int64(16))
    echo(Fmt"write_badfd={strings.Int64ToStr(wrBad)}")
    if wrBad != neg1:
        bad = 1
    # 3. socket 创建成功后立即 close, 对死 fd send/recv -> 期望精确 -1 (EBADF)
    let sock = libc_socket(2, 1, 6)
    echo(Fmt"socket={strings.IntToStr(sock)}")
    if sock < 0:
        bad = 1
    let closedRc = libc_close(sock)
    echo(Fmt"close={strings.IntToStr(closedRc)}")
    let sndBad: int64 = libc_send(sock, buf, 16, 0)
    echo(Fmt"send_closed={strings.Int64ToStr(sndBad)}")
    if sndBad != neg1:
        bad = 1
    let rcvBad: int64 = libc_recv(sock, buf, 16, 0)
    echo(Fmt"recv_closed={strings.Int64ToStr(rcvBad)}")
    if rcvBad != neg1:
        bad = 1
    # 4. 成功路径: /dev/null (O_RDWR=2) 写入 3 字节 -> 3; 读 -> 0 (EOF)
    let dn = libc_open("/dev/null", 2, 0)
    echo(Fmt"open_devnull={strings.IntToStr(dn)}")
    if dn < 0:
        bad = 1
    let wrOk: int64 = libc_write(dn, buf, Int64(3))
    echo(Fmt"write_devnull={strings.Int64ToStr(wrOk)}")
    if wrOk != Int64(3):
        bad = 1
    let rdEof: int64 = libc_read(dn, buf, Int64(16))
    echo(Fmt"read_devnull_eof={strings.Int64ToStr(rdEof)}")
    if rdEof != Int64(0):
        bad = 1
    let closeDn = libc_close(dn)
    echo(Fmt"close_devnull={strings.IntToStr(closeDn)}")
    if bad == 0:
        echo("probe_libc_trunc ok")
    else:
        echo("probe_libc_trunc FAIL")
    return bad
