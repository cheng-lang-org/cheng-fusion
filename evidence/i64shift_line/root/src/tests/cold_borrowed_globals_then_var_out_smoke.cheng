type
    ColdBorrowedGlobalsPlan =
        values: int32[]

    ColdBorrowedGlobalsOutput =
        name: str
        values: str[]

var coldBorrowedGlobalsPlan: ColdBorrowedGlobalsPlan
var coldBorrowedGlobalsSources: str[]
var coldBorrowedGlobalsResults: ColdBorrowedGlobalsOutput[]

@borrows
fn coldBorrowedGlobalsBuild(
        plan: ColdBorrowedGlobalsPlan,
        sources: str[],
        index: int32,
        output: var ColdBorrowedGlobalsOutput) =
    output.name = "built"
    add(output.values, "value")
    if plan.values.len > index && sources.len > index:
        output.name = "built"

fn coldBorrowedGlobalsCopy(
        source: var ColdBorrowedGlobalsOutput,
        output: var ColdBorrowedGlobalsOutput) =
    output.name = source.name
    output.values = source.values

fn coldBorrowedGlobalsPublish(
        output: ColdBorrowedGlobalsOutput) =
    coldBorrowedGlobalsCopy(
        output,
        coldBorrowedGlobalsResults[0])

fn coldBorrowedGlobalsExecute() =
    var output: ColdBorrowedGlobalsOutput
    coldBorrowedGlobalsBuild(
        coldBorrowedGlobalsPlan,
        coldBorrowedGlobalsSources,
        0,
        output)
    coldBorrowedGlobalsPublish(output)

fn main(): int32 =
    setLen(coldBorrowedGlobalsResults, 1)
    coldBorrowedGlobalsExecute()
    if coldBorrowedGlobalsResults[0].name != "built":
        return 1
    return 0
