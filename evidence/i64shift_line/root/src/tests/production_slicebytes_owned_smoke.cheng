import cheng/core/backend/system_link_exec_runtime as runtime
import cheng/core/lang/typed_expr as typedexpr

fn main(): int32 =
    let safe = runtime.SystemLinkExecRuntimeCacheSafeTarget(
        "arm64-apple.darwin+debug")
    if safe != "arm64_apple_darwin_debug":
        return 2

    let parts = typedexpr.TypedExprSplitParamTypeJoin(
        "str;;Result[int32];;str[]")
    if parts.len != 3:
        return 3
    if parts[0] != "str":
        return 4
    if parts[1] != "Result[int32]":
        return 5
    if parts[2] != "str[]":
        return 6

    let emptyParts = typedexpr.TypedExprSplitParamTypeJoin("")
    if emptyParts.len != 0:
        return 7
    let trailing = typedexpr.TypedExprSplitParamTypeJoin("a;;")
    if trailing.len != 2:
        return 8
    if trailing[0] != "a" || trailing[1] != "":
        return 9
    return 0
