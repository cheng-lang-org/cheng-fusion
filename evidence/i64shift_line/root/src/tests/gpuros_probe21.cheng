@profile("driver_safe")

type
    IoUInt8Ptr = uint8 *
    IoUInt32Ptr = uint32 *

@trusted_abi
fn IoLd32s(base: uint64, offset: uint64): int32 =
    let b = base
    let o = offset
    let addr = ptr(b + o)
    return int32(*(IoUInt32Ptr(addr)))

@trusted_abi
fn IoSt8(base: uint64, offset: uint64, value: int32) =
    let b = base
    let o = offset
    let addr = ptr(b + o)
    *(IoUInt8Ptr(addr)) = uint8(value & 255)

fn Answer(v: int32): int32 =
    return v + 1

fn HexNib(v: int32) =
    let w = v
    if w < 10:
        IoSt8(268435456, 0, int32(48 + w))
    else:
        IoSt8(268435456, 0, int32(87 + w))

fn Sep() =
    IoSt8(268435456, 0, 32)

fn main(): int32 =
    let a = Answer(40)
    HexNib((a / 268435456) & 15)
    HexNib((a / 16777216) & 15)
    Sep()
    HexNib((Answer(50) / 16) & 15)
    Sep()
    var i = 0
    while i < 3:
        HexNib(i)
        i = i + 1
    Sep()
    let b7 = uint64(268468224)
    let o0 = uint64(0)
    let m = IoLd32s(b7, o0)
    HexNib((m / 268435456) & 15)
    HexNib((m / 16777216) & 15)
    HexNib((m / 1048576) & 15)
    HexNib((m / 65536) & 15)
    IoSt8(268435456, 0, 10)
    return 0
