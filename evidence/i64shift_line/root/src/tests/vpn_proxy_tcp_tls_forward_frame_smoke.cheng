import std/result
import std/rawbytes
import std/strutils as strutil
import cheng/apps/vpn_proxy/transport_tcp_tls_forward as ttf

fn main(): int32 =
    let token: str = "cheng-hy2-tun-local-shared-token-2026"
    var authWire: Bytes
    let authRes: int32 = ttf.VpnProxyTcpTlsForwardBuildAuthFrameInto(token, authWire)
    assert(authRes > 0, " tcp-tls-forward auth frame build")
    var authFrame: ttf.VpnProxyTcpTlsForwardFrame
    let authFrameRes: int32 = ttf.VpnProxyTcpTlsForwardDecodeFrameCode(authWire, authFrame)
    assert(authFrameRes > 0, " tcp-tls-forward auth frame decode")
    assert(authFrame.frameType == ttf.VpnProxyTcpTlsForwardFrameKindAuth(), " tcp-tls-forward auth frame type")
    if ttf.VpnProxyTcpTlsForwardPayloadText(authFrame) != token:
        echo(strutil.Join([" tcp-tls-forward debug auth_wire_len=", IntToStr(authWire.len),
                           " payload_len=", IntToStr(authFrame.payload.len),
                           " payload_text=", ttf.VpnProxyTcpTlsForwardPayloadText(authFrame)], ""))
    assert(ttf.VpnProxyTcpTlsForwardPayloadText(authFrame) == token, " tcp-tls-forward auth payload")
    assert(ttf.VpnProxyTcpTlsForwardAuthPayloadOk(authFrame.payload,
                                                  "25e8b2cf0aa570ef5e11ec1026782e297912bb0cc729dbef2290278b925b54a6"),
           " tcp-tls-forward auth hash ok")
    assert(!ttf.VpnProxyTcpTlsForwardAuthPayloadOk(authFrame.payload,
                                                   "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"),
           " tcp-tls-forward auth hash reject")

    var openWire: Bytes
    let openRes: int32 = ttf.VpnProxyTcpTlsForwardBuildOpenFrameInto(7, "google.com:443", openWire)
    assert(openRes > 0, " tcp-tls-forward open frame build")
    var openFrame: ttf.VpnProxyTcpTlsForwardFrame
    let openFrameRes: int32 = ttf.VpnProxyTcpTlsForwardDecodeFrameCode(openWire, openFrame)
    assert(openFrameRes > 0, " tcp-tls-forward open frame decode")
    assert(openFrame.frameType == ttf.VpnProxyTcpTlsForwardFrameKindOpen(), " tcp-tls-forward open type")
    assert(openFrame.streamId == 7, " tcp-tls-forward open stream id")
    assert(ttf.VpnProxyTcpTlsForwardPayloadText(openFrame) == "google.com:443", " tcp-tls-forward open payload")

    let dataPayload: Bytes = BytesFromString("hello")
    var dataWire: Bytes
    let dataRes: int32 = ttf.VpnProxyTcpTlsForwardBuildDataFrameInto(7, dataPayload, dataWire)
    assert(dataRes > 0, " tcp-tls-forward data frame build")
    var dataFrame: ttf.VpnProxyTcpTlsForwardFrame
    let dataFrameRes: int32 = ttf.VpnProxyTcpTlsForwardDecodeFrameCode(dataWire, dataFrame)
    assert(dataFrameRes > 0, " tcp-tls-forward data frame decode")
    assert(dataWire.len == ttf.VpnProxyTcpTlsForwardHeaderBytes() + dataPayload.len,
           " tcp-tls-forward complete length value")
    assert(BytesEqual(dataFrame.payload, dataPayload), " tcp-tls-forward data payload")

    var closeWire: Bytes
    let closeRes: int32 = ttf.VpnProxyTcpTlsForwardBuildCloseFrameInto(7, closeWire)
    assert(closeRes > 0, " tcp-tls-forward close frame build")
    var closeFrame: ttf.VpnProxyTcpTlsForwardFrame
    let closeFrameRes: int32 = ttf.VpnProxyTcpTlsForwardDecodeFrameCode(closeWire, closeFrame)
    assert(closeFrameRes > 0, " tcp-tls-forward close frame decode")
    assert(closeFrame.frameType == ttf.VpnProxyTcpTlsForwardFrameKindClose(),
           " tcp-tls-forward close type")

    var openOkWire: Bytes
    let openOkRes: int32 = ttf.VpnProxyTcpTlsForwardBuildOpenOkFrameInto(7, openOkWire)
    assert(openOkRes > 0, " tcp-tls-forward open-ok build")
    var openOkFrame: ttf.VpnProxyTcpTlsForwardFrame
    let openOkFrameRes: int32 = ttf.VpnProxyTcpTlsForwardDecodeFrameCode(openOkWire, openOkFrame)
    assert(openOkFrameRes > 0, " tcp-tls-forward open-ok decode")
    assert(openOkFrame.frameType == ttf.VpnProxyTcpTlsForwardFrameKindOpenOk(),
           " tcp-tls-forward open-ok type")

    var openErrWire: Bytes
    let openErrRes: int32 = ttf.VpnProxyTcpTlsForwardBuildOpenErrorFrameInto(7, "connect failed", openErrWire)
    assert(openErrRes > 0, " tcp-tls-forward open-error build")
    var openErrFrame: ttf.VpnProxyTcpTlsForwardFrame
    let openErrFrameRes: int32 = ttf.VpnProxyTcpTlsForwardDecodeFrameCode(openErrWire, openErrFrame)
    assert(openErrFrameRes > 0, " tcp-tls-forward open-error decode")
    assert(openErrFrame.frameType == ttf.VpnProxyTcpTlsForwardFrameKindOpenError(),
           " tcp-tls-forward open-error type")
    assert(ttf.VpnProxyTcpTlsForwardPayloadText(openErrFrame) == "connect failed",
           " tcp-tls-forward open-error payload")

    var bad: Bytes = BytesSlice(dataWire, 0, 8)
    var incompleteFrame: ttf.VpnProxyTcpTlsForwardFrame
    let incompleteRes: int32 = ttf.VpnProxyTcpTlsForwardDecodeFrameCode(bad, incompleteFrame)
    assert(incompleteRes <= 0, " tcp-tls-forward incomplete check")
    BytesSet(bad, 0, 88)
    var badFrame: ttf.VpnProxyTcpTlsForwardFrame
    let badRes: int32 = ttf.VpnProxyTcpTlsForwardDecodeFrameCode(bad, badFrame)
    assert(badRes <= 0, " tcp-tls-forward short bad magic waits for header")

    echo(" vpn_proxy_tcp_tls_forward_frame_smoke ok")
    return 0
