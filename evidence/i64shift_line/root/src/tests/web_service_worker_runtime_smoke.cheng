# web_service_worker_runtime_smoke.cheng
# Runtime proof for the service-worker substrate (pure Cheng, no FFI):
# register -> install -> activate -> fetch dispatch -> state readback ->
# unregister -> stale invisibility. Backs the provider id
#   cheng/core/runtime/web_service_worker_runtime.register-lite
# used by the ts-csg runtime closure decision table.
import std/strutils as strutil
import cheng/core/runtime/web_service_worker_runtime as sw

fn smokeFail(label: str): int32 =
    echo(strutil.Join(["service worker substrate smoke failed: ", label], ""))
    return 1

fn main(): int32 =
    let registrationId: int32 = sw.WebServiceWorkerRegister("/", "/sw.js", 1, 1, 1, 0)
    if registrationId != 1:
        return smokeFail("registration id")
    if !sw.WebServiceWorkerTriggerInstall(registrationId):
        return smokeFail("install trigger")
    if !sw.WebServiceWorkerTriggerActivate(registrationId):
        return smokeFail("activate trigger")
    var response: str = ""
    if !sw.WebServiceWorkerTriggerFetch(registrationId, "/feed.json", "GET", response):
        return smokeFail("fetch dispatch")
    if response != "/feed.json":
        return smokeFail("fetch response payload")
    var registration: sw.WebServiceWorkerRegistration
    if !sw.WebServiceWorkerGetState(registrationId, registration):
        return smokeFail("state readback")
    if registration.state != sw.WebSWActivated:
        return smokeFail("activated state")
    if registration.scope != "/":
        return smokeFail("scope")
    if !sw.WebServiceWorkerUnregister("/"):
        return smokeFail("unregister")
    var stale: sw.WebServiceWorkerRegistration
    if sw.WebServiceWorkerGetState(registrationId, stale):
        return smokeFail("stale registration visible after unregister")

    echo("service worker substrate smoke ok")
    return 0
