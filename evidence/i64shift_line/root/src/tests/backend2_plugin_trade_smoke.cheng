# backend2_plugin_trade_smoke — S4-C/D 取件交易对象与组合准入契约:
# 交易 record codec / T6 降格映射 / 同构 receipt / 链查取件 / 本地构建腿 /
# 组合准入包装。spec: 设计卷 step4-fetch-design-20260827 DESIGN.md §2/§3/§5;
# gate: tools/backend2_plugin_trade_gate.sh。
#
# 模式 (argv[1], argv[2]=工作根目录, argv[3]=manifest 路径可空):
#   unit                  — 正路径全断言: closure 单派生器确定性/无序性 / Issue
#                           golden + 字段敏感 / Encode→Decode 往返 (字段+字节) /
#                           T6 降格 receipt 与 Make 同构 (同 pickupCid, 仅
#                           origin/signer/proof 三字段异) / VerifyGates 正路径。
#                           输出 PLUGIN_TRADE_UNIT_OK。
#   issue-err             — Issue 入参守卫族 (quad 缺位/版本/签发者/proofCid/
#                           generation) 全显式 Err (rc=0)。
#   err-truncated         — 多切点截断 → Decode Err truncated (rc=0)。
#   err-trailing          — 尾部多一字节 → Err trailing (rc=0)。
#   err-bad-tag/format/kind/cid/content/proof/version/count/toolarge
#                         — 线格式逐域篡改 → 对应结构 Err (rc=0)。
#   tamper-selfcid        — record 字段翻一哈希 → VerifySelfCid 硬崩
#                           (csg_pickup_trade_cid_recompute_mismatch)。
#   tamper-bind           — receipt sha 与 record 互证不等 → BindToReceipt 硬崩
#                           (csg_pickup_trade_receipt_bind_mismatch)。
#   fetch-ok              — 链条目 fixture (record+artifact 双文件) → Acquire
#                           online → not-published→fetch→gates→Store 全通,
#                           输出 PLUGIN_TRADE_FETCH_OK。
#   fetch-hit-no-net      — 链根置为不存在目录后二次 Acquire → 缓存命中短路
#                           链查 (§4 ②命中不发网), 输出 PLUGIN_TRADE_HIT_NONET_OK。
#   fetch-not-published   — 链根配置但无此 cid → Err csg_pickup_not_published
#                           + codegen_plugin_missing (rc=1, fail-closed)。
#   fetch-corrupt         — 链 record 垃圾字节 → FetchRemote 硬崩
#                           (csg_pickup_trade_record_corrupt, 不伪装 fetch Err)。
#   local-compose         — LocalBuildCompose → 同构 local receipt 落缓存 →
#                           LoadCached 逐次过门, 输出 PLUGIN_TRADE_LOCAL_OK。
#   compose-offline       — 组合包装: 缺省离线 (T2) + 空缓存 → Err
#                           codegen_plugin_missing + installed=[] (rc=1)。
#   compose-online        — 链条目就位 + 显式 allowNetwork=1 → 包装全通
#                           (closure 现场 派生→Acquire), 输出
#                           PLUGIN_TRADE_COMPOSE_ONLINE_OK。
#   compose-unknown-triple— tmat 权威外 triple → Err (rc=1)。
#   compose-manifest-mismatch — manifest canonical triple 与请求不符 → Err (rc=1)。
#   compose-manifest-unset    — manifest env 未配置 → Err (rc=1)。

import std/cmdline as cmdline
import std/os
import std/result
import std/strings
import std/rawbytes
import cheng/std/bytes_layout as layout
import cheng/core/backend/codegen_contract as contract
import cheng/core/backend2/backend2_plugin_cid as pcid
import cheng/core/backend/csg_plugin_pickup as pickup
import cheng/core/csg_core/plugin_trade_record as trade

const
    fixtureTriple: str = "arm64-apple-darwin"
    fixtureSigner: str = "csg-signer-fixture"

# ---- 夹具 ----

fn zeroFixed32(): layout.FixedBytes32 =
    var out: layout.FixedBytes32
    for i in 0..<32:
        out.data[i] = UInt8(0)
    return out

fn patternFixed32(seed: int32): layout.FixedBytes32 =
    var out: layout.FixedBytes32
    for i in 0..<32:
        out.data[i] = UInt8((seed + i * 7) & 255)
    return out

fn fixtureCompilerHash(): layout.FixedBytes32 =
    return patternFixed32(23)

fn fixtureArtifact(): rawbytes.Bytes =
    return rawbytes.BytesFromString("cheng-plugin-artifact-fixture-v1")

fn setManifestEnv(path: str) =
    os.SetEnv("CHENG_CSG_PLUGIN_MANIFEST", path)

fn manifestClosureOrPanic(): layout.FixedBytes32 =
    var closureRes = pickup.CsgPluginPickupClosureHashForTriple(fixtureTriple)
    if IsErr(closureRes):
        panic(Fmt"manifest closure failed: {Error(closureRes)}")
    return Value(closureRes)

fn fixtureQueryCid(closure: layout.FixedBytes32): str =
    return pcid.Backend2ComputePluginPickupCid(
        closure, fixtureCompilerHash(), fixtureTriple,
        contract.CodegenContractVersion)

@borrows
fn issueFixtureRecord(closure: layout.FixedBytes32,
                      artifact: rawbytes.Bytes): trade.ChengPluginTradeRecord =
    let proofCid = "sha256:" + layout.FixedBytes32Hex(patternFixed32(5))
    var issueRes = trade.ChengPluginTradeRecordIssue(
        closure, fixtureCompilerHash(), fixtureTriple,
        contract.CodegenContractVersion,
        artifact, fixtureSigner, proofCid, 7)
    if IsErr(issueRes):
        panic("fixture record issue failed")
    return Value(issueRes)

@borrows
fn publishChainFixture(chainRoot: str, queryCid: str,
                       recordBytes: rawbytes.Bytes, artifact: rawbytes.Bytes) =
    let shard = strings.CloneStrRange(queryCid, 0, 2)
    os.MkdirAll(chainRoot + "/" + shard, 493)
    var recordPath = pickup.CsgPluginPickupChainRecordPath(chainRoot, queryCid)
    var artifactPath = pickup.CsgPluginPickupChainArtifactPath(chainRoot, queryCid)
    var recRes = os.WriteFileBytesResult(recordPath, recordBytes)
    assert(!IsErr(recRes), "chain record fixture write")
    var artRes = os.WriteFileBytesResult(artifactPath, artifact)
    assert(!IsErr(artRes), "chain artifact fixture write")

@borrows
fn expectTradeErr(data: rawbytes.Bytes, wantMsg: str, label: str) =
    var res = trade.ChengPluginTradeRecordDecode(data)
    assert(IsErr(res), label + " must be Err")
    assert(Error(res) == wantMsg, label + " err msg")

# ---- 正路径: 纯值层 ----

fn runUnit(root: str, manifestPath: str): int32 =
    setManifestEnv(manifestPath)
    var artifact = fixtureArtifact()

    # closure 单派生器: 确定性 + 顺序不敏感 (SortStrings 内建) + 非零
    let closure = manifestClosureOrPanic()
    let closureAgain = manifestClosureOrPanic()
    assert(layout.FixedBytes32Equal(closure, closureAgain), "closure deterministic")
    assert(!layout.FixedBytes32Equal(closure, zeroFixed32()), "closure non-zero")
    var units: str[]
    add(units, "zzz_last.cheng")
    add(units, "aaa_first.cheng")
    add(units, "mmm_mid.cheng")
    let hashA = pickup.CsgPluginPickupDeriveSourceClosureHash(units)
    var units2: str[]
    add(units2, "mmm_mid.cheng")
    add(units2, "aaa_first.cheng")
    add(units2, "zzz_last.cheng")
    let hashB = pickup.CsgPluginPickupDeriveSourceClosureHash(units2)
    assert(layout.FixedBytes32Equal(hashA, hashB), "closure order-insensitive")
    assert(!layout.FixedBytes32Equal(hashA, closure), "closure binds source set")

    # Issue golden: 确定性 + self-check + artifact 绑定派生
    var record = issueFixtureRecord(closure, artifact)
    let tradeCid = record.tradeCidHex
    assert(len(tradeCid) == 64, "tradeCid is 64-hex")
    var recordAgain = issueFixtureRecord(closure, artifact)
    assert(recordAgain.tradeCidHex == tradeCid, "issue deterministic")
    let artifactSha = pcid.Backend2ContentSha256OfBytes(artifact)
    assert(layout.FixedBytes32Equal(record.artifactSha256, artifactSha),
        "issue binds artifact sha")
    assert(record.artifactByteCount == Int64(rawbytes.BytesLen(artifact)),
        "issue binds artifact count")
    assert(record.artifactContentCid ==
        "sha256:" + layout.FixedBytes32Hex(artifactSha), "content cid self-proof")

    # 字段敏感性: 任一字段翻转 ⇒ tradeCid 变化 (经 Issue 重算, 非改字段)
    let proofG = "sha256:" + layout.FixedBytes32Hex(patternFixed32(5))
    var artifactG = fixtureArtifact()
    var issueG = trade.ChengPluginTradeRecordIssue(
        closure, fixtureCompilerHash(), fixtureTriple,
        contract.CodegenContractVersion,
        artifactG, fixtureSigner, proofG, 8)
    assert(!IsErr(issueG), "issue with flipped generation ok")
    var flippedGen = Value(issueG)
    assert(flippedGen.tradeCidHex != tradeCid, "generation flip changes tradeCid")
    var artifactS = fixtureArtifact()
    var issueS = trade.ChengPluginTradeRecordIssue(
        closure, fixtureCompilerHash(), fixtureTriple,
        contract.CodegenContractVersion,
        artifactS, fixtureSigner + "x", proofG, 7)
    assert(!IsErr(issueS), "issue with flipped signer ok")
    var flippedSigner = Value(issueS)
    assert(flippedSigner.tradeCidHex != tradeCid, "signer flip changes tradeCid")
    let proofB = "sha256:" + layout.FixedBytes32Hex(patternFixed32(6))
    var artifactB = fixtureArtifact()
    var issueB = trade.ChengPluginTradeRecordIssue(
        closure, fixtureCompilerHash(), fixtureTriple,
        contract.CodegenContractVersion,
        artifactB, fixtureSigner, proofB, 7)
    assert(!IsErr(issueB), "issue with flipped proof ok")
    var recordB = Value(issueB)
    assert(recordB.tradeCidHex != tradeCid, "proof flip changes tradeCid")

    # Encode→Decode 往返恒等 (字段级 + 字节级)
    var enc = trade.ChengPluginTradeRecordEncode(record)
    var dec = trade.ChengPluginTradeRecordDecode(enc)
    assert(!IsErr(dec), "roundtrip decode")
    var back = Value(dec)
    assert(back.kind == record.kind, "roundtrip kind")
    assert(back.tradeCidHex == record.tradeCidHex, "roundtrip tradeCid")
    assert(layout.FixedBytes32Equal(back.sourceClosureHash, record.sourceClosureHash),
        "roundtrip closure")
    assert(layout.FixedBytes32Equal(back.compilerHash, record.compilerHash),
        "roundtrip compiler")
    assert(back.targetTriple == record.targetTriple, "roundtrip triple")
    assert(back.contractVersion == record.contractVersion, "roundtrip version")
    assert(back.artifactByteCount == record.artifactByteCount, "roundtrip count")
    assert(layout.FixedBytes32Equal(back.artifactSha256, record.artifactSha256),
        "roundtrip sha")
    assert(back.artifactContentCid == record.artifactContentCid, "roundtrip content")
    assert(back.issuedBySignerId == record.issuedBySignerId, "roundtrip signer")
    assert(back.issuanceProofCid == record.issuanceProofCid, "roundtrip proof")
    assert(back.issuerGeneration == record.issuerGeneration, "roundtrip generation")
    var enc2 = trade.ChengPluginTradeRecordEncode(back)
    assert(rawbytes.BytesEqual(enc, enc2), "encode byte-stable")
    rawbytes.BytesFree(enc2)

    # T6 降格映射: chain-origin receipt + 三方相等硬闸 + VerifyGates 正路径
    var receipt = trade.ChengPluginTradeRecordDemoteToReceipt(record, artifact)
    assert(receipt.origin == pcid.PluginPickupOriginChain, "demote origin=chain")
    assert(receipt.provenanceSignerId == fixtureSigner, "demote signer")
    assert(receipt.pickupCidHex == fixtureQueryCid(closure),
        "demote pickupCid == quad recompute")
    pcid.PluginPickupVerifyGates(artifact, receipt)

    # 同构无分叉: 同 quad+artifact 的 local receipt 与链 receipt 共享 pickupCid
    # 与 artifact 绑定, 仅 origin/signer/proofCid 三字段允许不同 (设计 §3.1)
    var localReceipt = pcid.PluginPickupReceiptMake(
        pcid.PluginPickupOriginLocal, closure, fixtureCompilerHash(),
        fixtureTriple, contract.CodegenContractVersion,
        artifact, "local", zeroFixed32())
    assert(localReceipt.pickupCidHex == receipt.pickupCidHex,
        "isomorphic pickupCid across origins")
    assert(layout.FixedBytes32Equal(localReceipt.artifactSha256, receipt.artifactSha256),
        "isomorphic artifact sha")
    assert(localReceipt.artifactByteCount == receipt.artifactByteCount,
        "isomorphic byte count")
    assert(localReceipt.origin != receipt.origin, "origin differs by design")
    assert(localReceipt.provenanceSignerId != receipt.provenanceSignerId,
        "signer differs by design")
    pcid.PluginPickupVerifyGates(artifact, localReceipt)
    rawbytes.BytesFree(enc)
    echo("PLUGIN_TRADE_UNIT_OK")
    return 0

# ---- Issue 入参守卫族 ----

fn runIssueErr(root: str, manifestPath: str): int32 =
    setManifestEnv(manifestPath)
    let closure = manifestClosureOrPanic()
    var artifact = fixtureArtifact()
    let proofCid = "sha256:" + layout.FixedBytes32Hex(patternFixed32(5))
    var res = trade.ChengPluginTradeRecordIssue(
        closure, fixtureCompilerHash(), "", contract.CodegenContractVersion,
        artifact, fixtureSigner, proofCid, 7)
    assert(IsErr(res) && Error(res) == trade.ChengPluginTradeErrorQuadMissing,
        "empty triple Err")
    var res2 = trade.ChengPluginTradeRecordIssue(
        closure, fixtureCompilerHash(), fixtureTriple, 0,
        artifact, fixtureSigner, proofCid, 7)
    assert(IsErr(res2) && Error(res2) == trade.ChengPluginTradeErrorBadContractVersion,
        "bad version Err")
    var res3 = trade.ChengPluginTradeRecordIssue(
        closure, fixtureCompilerHash(), fixtureTriple,
        contract.CodegenContractVersion,
        artifact, "", proofCid, 7)
    assert(IsErr(res3) && Error(res3) == trade.ChengPluginTradeErrorEmptySigner,
        "empty signer Err")
    var res4 = trade.ChengPluginTradeRecordIssue(
        closure, fixtureCompilerHash(), fixtureTriple,
        contract.CodegenContractVersion,
        artifact, fixtureSigner, "sha256:zzzz", 7)
    assert(IsErr(res4) && Error(res4) == trade.ChengPluginTradeErrorIssuanceProofCid,
        "bad proof cid Err")
    var res5 = trade.ChengPluginTradeRecordIssue(
        closure, fixtureCompilerHash(), fixtureTriple,
        contract.CodegenContractVersion,
        artifact, fixtureSigner, proofCid, 0)
    assert(IsErr(res5) && Error(res5) == trade.ChengPluginTradeErrorIssuerGeneration,
        "zero generation Err")
    var res6 = trade.ChengPluginTradeRecordIssue(
        closure, zeroFixed32(), fixtureTriple,
        contract.CodegenContractVersion,
        artifact, fixtureSigner, proofCid, 7)
    assert(IsErr(res6) &&
           Error(res6) == trade.ChengPluginTradeErrorZeroClosureOrCompilerHash,
        "zero compiler hash Err")
    echo("PLUGIN_TRADE_ISSUE_ERR_OK")
    return 0

# ---- 线格式结构错误族 (域偏移按线格式常量断言后定点篡改) ----

fn encodedFixture(closure: layout.FixedBytes32): rawbytes.Bytes =
    var record = issueFixtureRecord(closure, fixtureArtifact())
    return trade.ChengPluginTradeRecordEncode(record)

fn runErrTruncated(root: str, manifestPath: str): int32 =
    setManifestEnv(manifestPath)
    var enc = encodedFixture(manifestClosureOrPanic())
    let total = rawbytes.BytesLen(enc)
    for cut in 0..<total:
        var piece = rawbytes.BytesSlice(enc, 0, cut)
        expectTradeErr(piece, trade.ChengPluginTradeErrorTruncated,
            Fmt"truncated at {cut}")
        rawbytes.BytesFree(piece)
    rawbytes.BytesFree(enc)
    echo("PLUGIN_TRADE_TRUNCATED_ERR_OK")
    return 0

@borrows
fn patchedByteAt(data: rawbytes.Bytes, offset: int32, value: int32): rawbytes.Bytes =
    var out = rawbytes.BytesSlice(data, 0, rawbytes.BytesLen(data))
    rawbytes.BytesSet(out, offset, value & 255)
    return out

# 线格式常量偏移 (fixture 域长冻结; 单元腿先断言总长, 漂移即红):
#   tag:4+34 format:4 kind:4+29 tradeCid:4+64 closure:32 compiler:32
#   triple:4+18 version:4 count:8 sha:32 content:4+71 signer:4+18 proof:4+71 gen:8
fn runErrPatches(root: str, manifestPath: str): int32 =
    setManifestEnv(manifestPath)
    let closure = manifestClosureOrPanic()
    var enc = encodedFixture(closure)
    let total = rawbytes.BytesLen(enc)
    assert(total == 453, Fmt"wire layout drifted: total={total} expect=453")
    var tagPatch = patchedByteAt(enc, 4, Int32('X'))
    expectTradeErr(tagPatch, trade.ChengPluginTradeErrorBadDomainTag, "bad tag")
    rawbytes.BytesFree(tagPatch)
    var formatPatch = patchedByteAt(enc, 38, 2)
    expectTradeErr(formatPatch, trade.ChengPluginTradeErrorBadFormatVersion, "bad format")
    rawbytes.BytesFree(formatPatch)
    var kindPatch = patchedByteAt(enc, 42, Int32('X'))
    expectTradeErr(kindPatch, trade.ChengPluginTradeErrorBadKind, "bad kind")
    rawbytes.BytesFree(kindPatch)
    var cidPatch = patchedByteAt(enc, 79, Int32('g'))
    expectTradeErr(cidPatch, trade.ChengPluginTradeErrorBadTradeCidHex, "bad trade cid")
    rawbytes.BytesFree(cidPatch)
    var versionPatch = patchedByteAt(enc, 229, 0)
    expectTradeErr(versionPatch, trade.ChengPluginTradeDecodeBadContractVersion, "bad version")
    rawbytes.BytesFree(versionPatch)
    var countPatch = patchedByteAt(enc, 240, 0x80)
    expectTradeErr(countPatch, trade.ChengPluginTradeErrorBadByteCount, "negative count")
    rawbytes.BytesFree(countPatch)
    var largePatch = patchedByteAt(enc, 237, 1)
    expectTradeErr(largePatch, trade.ChengPluginTradeErrorArtifactTooLarge, "too large")
    rawbytes.BytesFree(largePatch)
    var contentPatch = patchedByteAt(enc, 277, Int32('g'))
    expectTradeErr(contentPatch, trade.ChengPluginTradeErrorBadContentCid, "bad content cid")
    rawbytes.BytesFree(contentPatch)
    var proofPatch = patchedByteAt(enc, 374, Int32('g'))
    expectTradeErr(proofPatch, trade.ChengPluginTradeErrorBadIssuanceProofCid, "bad proof cid")
    rawbytes.BytesFree(proofPatch)
    var trailing = rawbytes.BytesSlice(enc, 0, total)
    var widened = rawbytes.BytesConcat(trailing, rawbytes.BytesFromString("!"))
    rawbytes.BytesFree(trailing)
    expectTradeErr(widened, trade.ChengPluginTradeErrorTrailingBytes, "trailing byte")
    rawbytes.BytesFree(widened)
    rawbytes.BytesFree(enc)
    echo("PLUGIN_TRADE_PATCH_ERR_OK")
    return 0

# ---- 身份/互证硬崩腿 ----

fn runTamperSelfCid(root: str, manifestPath: str): int32 =
    setManifestEnv(manifestPath)
    var record = issueFixtureRecord(manifestClosureOrPanic(), fixtureArtifact())
    record.compilerHash = patternFixed32(9)
    trade.ChengPluginTradeRecordVerifySelfCid(record)
    echo("UNREACHABLE")
    return 2

fn runTamperBind(root: str, manifestPath: str): int32 =
    setManifestEnv(manifestPath)
    var record = issueFixtureRecord(manifestClosureOrPanic(), fixtureArtifact())
    var artifact = fixtureArtifact()
    var receipt = trade.ChengPluginTradeRecordDemoteToReceipt(record, artifact)
    receipt.artifactSha256 = patternFixed32(11)
    trade.ChengPluginTradeRecordBindToReceipt(record, receipt)
    echo("UNREACHABLE")
    return 2

# ---- S4-C 链对接腿 (链条目 fixture + Acquire 全流程) ----

fn runFetchOk(root: str, manifestPath: str): int32 =
    setManifestEnv(manifestPath)
    let chainRoot = root + "/chain"
    let cacheRoot = root + "/cache"
    os.SetEnv("CHENG_CSG_CHAIN_ROOT", strings.CloneStr(chainRoot))
    let closure = manifestClosureOrPanic()
    let queryCid = fixtureQueryCid(closure)
    var artifact = fixtureArtifact()
    var record = issueFixtureRecord(closure, artifact)
    var recordBytes = trade.ChengPluginTradeRecordEncode(record)
    publishChainFixture(chainRoot, queryCid, recordBytes, artifact)
    var acqArt: rawbytes.Bytes
    var acqRes = pickup.CsgPluginPickupAcquire(
        cacheRoot, true, closure, fixtureCompilerHash(), fixtureTriple,
        contract.CodegenContractVersion, acqArt)
    assert(!IsErr(acqRes), "online acquire fetches chain entry")
    var receipt = Value(acqRes)
    assert(receipt.origin == pcid.PluginPickupOriginChain, "fetched receipt is chain origin")
    assert(receipt.pickupCidHex == queryCid, "fetched pickupCid matches")
    assert(rawbytes.BytesEqual(acqArt, artifact), "fetched artifact bytes")
    rawbytes.BytesFree(acqArt)
    # Store 已落缓存双文件
    assert(os.FileExists(pickup.CsgPluginPickupCachePath(cacheRoot, queryCid)),
        "fetched entry cached")
    assert(os.FileExists(pickup.CsgPluginPickupReceiptPath(cacheRoot, queryCid)),
        "fetched receipt cached")
    echo("PLUGIN_TRADE_FETCH_OK")
    return 0

fn runFetchHitNoNet(root: str, manifestPath: str): int32 =
    setManifestEnv(manifestPath)
    let chainRoot = root + "/chain"
    let cacheRoot = root + "/cache"
    os.SetEnv("CHENG_CSG_CHAIN_ROOT", strings.CloneStr(chainRoot))
    let closure = manifestClosureOrPanic()
    let queryCid = fixtureQueryCid(closure)
    var artifact = fixtureArtifact()
    var record = issueFixtureRecord(closure, artifact)
    var recordBytes = trade.ChengPluginTradeRecordEncode(record)
    publishChainFixture(chainRoot, queryCid, recordBytes, artifact)
    var warmArt: rawbytes.Bytes
    var warmRes = pickup.CsgPluginPickupAcquire(
        cacheRoot, true, closure, fixtureCompilerHash(), fixtureTriple,
        contract.CodegenContractVersion, warmArt)
    assert(!IsErr(warmRes), "first acquire fetches")
    rawbytes.BytesFree(warmArt)
    # 链根置为不存在目录: 缓存命中必须短路链查 (§4 ②命中不发网)
    os.SetEnv("CHENG_CSG_CHAIN_ROOT", root + "/chain-absent")
    var hitArt: rawbytes.Bytes
    var hitRes = pickup.CsgPluginPickupAcquire(
        cacheRoot, false, closure, fixtureCompilerHash(), fixtureTriple,
        contract.CodegenContractVersion, hitArt)
    assert(!IsErr(hitRes), "cache hit serves offline")
    var receipt = Value(hitRes)
    assert(receipt.pickupCidHex == queryCid, "hit receipt cid")
    assert(rawbytes.BytesEqual(hitArt, artifact), "hit artifact bytes")
    rawbytes.BytesFree(hitArt)
    echo("PLUGIN_TRADE_HIT_NONET_OK")
    return 0

fn runFetchNotPublished(root: str, manifestPath: str): int32 =
    setManifestEnv(manifestPath)
    os.SetEnv("CHENG_CSG_CHAIN_ROOT", root + "/chain-absent")
    let closure = manifestClosureOrPanic()
    var acqArt: rawbytes.Bytes
    var acqRes = pickup.CsgPluginPickupAcquire(
        root + "/cache", true, closure, fixtureCompilerHash(), fixtureTriple,
        contract.CodegenContractVersion, acqArt)
    assert(IsErr(acqRes), "absent chain entry must be explicit Err")
    let msg = Error(acqRes)
    assert(strings.StrContains(msg, "csg_pickup_not_published"),
        "not published marker")
    assert(strings.StrContains(msg, "codegen_plugin_missing=" + fixtureTriple),
        "fail-closed missing report")
    echo(msg)
    return 1

fn runFetchCorrupt(root: str, manifestPath: str): int32 =
    setManifestEnv(manifestPath)
    let chainRoot = root + "/chain"
    os.SetEnv("CHENG_CSG_CHAIN_ROOT", strings.CloneStr(chainRoot))
    let closure = manifestClosureOrPanic()
    let queryCid = fixtureQueryCid(closure)
    var artifact = fixtureArtifact()
    var garbage = rawbytes.BytesFromString("not-a-trade-record-payload")
    publishChainFixture(chainRoot, queryCid, garbage, artifact)
    var art: rawbytes.Bytes
    var res = pickup.CsgPluginPickupFetchRemote(queryCid, art)
    assert(!IsErr(res), "corrupt chain record must panic, not Err")
    echo("UNREACHABLE")
    return 2

# ---- S4-D 组合准入腿 ----

fn runLocalCompose(root: str, manifestPath: str): int32 =
    setManifestEnv(manifestPath)
    let cacheRoot = root + "/cache"
    var artifact = fixtureArtifact()
    var composeRes = pickup.CsgPluginPickupLocalBuildCompose(
        cacheRoot, fixtureCompilerHash(), fixtureTriple, artifact)
    assert(!IsErr(composeRes), "local build compose")
    var receipt = Value(composeRes)
    assert(receipt.origin == pcid.PluginPickupOriginLocal, "local origin")
    assert(receipt.provenanceSignerId == "local", "local signer")
    let queryCid = fixtureQueryCid(manifestClosureOrPanic())
    assert(receipt.pickupCidHex == queryCid, "local pickupCid == quad recompute")
    assert(os.FileExists(pickup.CsgPluginPickupCachePath(cacheRoot, queryCid)),
        "local entry cached")
    var outArt: rawbytes.Bytes
    var loadRes = pickup.CsgPluginPickupLoadCached(cacheRoot, queryCid, outArt)
    assert(!IsErr(loadRes), "local entry loads through full gates")
    rawbytes.BytesFree(outArt)
    echo("PLUGIN_TRADE_LOCAL_OK")
    return 0

fn runComposeOffline(root: str, manifestPath: str): int32 =
    setManifestEnv(manifestPath)
    os.SetEnv("CHENG_CSG_PLUGIN_CACHE_ROOT", root + "/cache")
    os.SetEnv("CHENG_CSG_PLUGIN_ALLOW_NETWORK", "")
    let closure = manifestClosureOrPanic()
    var art: rawbytes.Bytes
    var res = pickup.CsgPluginPickupAcquire(
        root + "/cache", false, closure, fixtureCompilerHash(), fixtureTriple,
        contract.CodegenContractVersion, art)
    assert(IsErr(res), "offline empty cache must fail closed")
    let msg = Error(res)
    assert(strings.StrContains(msg, "codegen_plugin_missing=" + fixtureTriple),
        "missing marker")
    assert(strings.StrContains(msg, "installed=[]"), "empty installed list")
    echo(msg)
    return 1

fn runComposeOnline(root: str, manifestPath: str): int32 =
    setManifestEnv(manifestPath)
    let chainRoot = root + "/chain"
    os.SetEnv("CHENG_CSG_PLUGIN_CACHE_ROOT", root + "/cache")
    os.SetEnv("CHENG_CSG_CHAIN_ROOT", strings.CloneStr(chainRoot))
    os.SetEnv("CHENG_CSG_PLUGIN_ALLOW_NETWORK", "1")
    let closure = manifestClosureOrPanic()
    let queryCid = fixtureQueryCid(closure)
    var artifact = fixtureArtifact()
    var record = issueFixtureRecord(closure, artifact)
    var recordBytes = trade.ChengPluginTradeRecordEncode(record)
    publishChainFixture(chainRoot, queryCid, recordBytes, artifact)
    var art: rawbytes.Bytes
    var res = pickup.CsgPluginPickupAcquire(
        root + "/cache", true, closure, fixtureCompilerHash(), fixtureTriple,
        contract.CodegenContractVersion, art)
    assert(!IsErr(res), "online acquire with bound compiler identity")
    var receipt = Value(res)
    assert(receipt.origin == pcid.PluginPickupOriginChain, "wrapper fetched chain origin")
    assert(rawbytes.BytesEqual(art, artifact), "wrapper artifact bytes")
    rawbytes.BytesFree(art)
    echo("PLUGIN_TRADE_COMPOSE_ONLINE_OK")
    return 0

fn runComposeUnheldCompiler(root: str, manifestPath: str): int32 =
    setManifestEnv(manifestPath)
    os.SetEnv("CHENG_CSG_PLUGIN_CACHE_ROOT", root + "/cache")
    var art: rawbytes.Bytes
    var res = pickup.CodegenCompositionAcquireArtifactForTriple(fixtureTriple, art)
    assert(IsErr(res), "composition wrapper requires held compiler identity")
    assert(Error(res) == "csg_pickup_compiler_identity_admission_missing",
        "unheld compiler identity marker")
    echo(Error(res))
    return 1

fn runComposeUnknownTriple(root: str, manifestPath: str): int32 =
    setManifestEnv(manifestPath)
    os.SetEnv("CHENG_CSG_PLUGIN_CACHE_ROOT", root + "/cache")
    var art: rawbytes.Bytes
    var res = pickup.CodegenCompositionAcquireArtifactForTriple(
        "wasm64-unknown-unknown", art)
    assert(IsErr(res), "unknown triple rejected by tmat authority")
    assert(strings.StrContains(Error(res), "csg_pickup_compose_unknown_target_triple"),
        "unknown triple marker")
    echo(Error(res))
    return 1

fn runComposeManifestMismatch(root: str, manifestPath: str): int32 =
    # 门禁传 x86_64 manifest, 请求 arm64 triple → 权威互证失败
    setManifestEnv(manifestPath)
    os.SetEnv("CHENG_CSG_PLUGIN_CACHE_ROOT", root + "/cache")
    var art: rawbytes.Bytes
    var res = pickup.CodegenCompositionAcquireArtifactForTriple(fixtureTriple, art)
    assert(IsErr(res), "manifest triple mismatch must be Err")
    assert(strings.StrContains(Error(res), "csg_pickup_manifest_triple_mismatch"),
        "mismatch marker")
    echo(Error(res))
    return 1

fn runComposeManifestUnset(root: str, manifestPath: str): int32 =
    setManifestEnv("")
    os.SetEnv("CHENG_CSG_PLUGIN_CACHE_ROOT", root + "/cache")
    var art: rawbytes.Bytes
    var res = pickup.CodegenCompositionAcquireArtifactForTriple(fixtureTriple, art)
    assert(IsErr(res), "unconfigured manifest must be Err")
    assert(strings.StrContains(Error(res), "csg_pickup_manifest_unconfigured"),
        "unconfigured marker")
    echo(Error(res))
    return 1

fn main(argc: int32, argv: str*): int32 =
    argc
    argv
    cmdline.CaptureCmdLine(argc, argv)
    var mode = ""
    if cmdline.ParamCount() >= 1:
        mode = cmdline.ParamStr(1)
    var root = ""
    if cmdline.ParamCount() >= 2:
        root = cmdline.ParamStr(2)
    var manifestPath = ""
    if cmdline.ParamCount() >= 3:
        manifestPath = cmdline.ParamStr(3)
    if mode == "" || mode == "unit":
        return runUnit(root, manifestPath)
    if mode == "issue-err":
        return runIssueErr(root, manifestPath)
    if mode == "err-truncated":
        return runErrTruncated(root, manifestPath)
    if mode == "err-patches":
        return runErrPatches(root, manifestPath)
    if mode == "tamper-selfcid":
        return runTamperSelfCid(root, manifestPath)
    if mode == "tamper-bind":
        return runTamperBind(root, manifestPath)
    if mode == "fetch-ok":
        return runFetchOk(root, manifestPath)
    if mode == "fetch-hit-no-net":
        return runFetchHitNoNet(root, manifestPath)
    if mode == "fetch-not-published":
        return runFetchNotPublished(root, manifestPath)
    if mode == "fetch-corrupt":
        return runFetchCorrupt(root, manifestPath)
    if mode == "local-compose":
        return runLocalCompose(root, manifestPath)
    if mode == "compose-offline":
        return runComposeOffline(root, manifestPath)
    if mode == "compose-online":
        return runComposeOnline(root, manifestPath)
    if mode == "compose-unheld-compiler":
        return runComposeUnheldCompiler(root, manifestPath)
    if mode == "compose-unknown-triple":
        return runComposeUnknownTriple(root, manifestPath)
    if mode == "compose-manifest-mismatch":
        return runComposeManifestMismatch(root, manifestPath)
    if mode == "compose-manifest-unset":
        return runComposeManifestUnset(root, manifestPath)
    echo("PLUGIN_TRADE_UNKNOWN_MODE")
    return 2
