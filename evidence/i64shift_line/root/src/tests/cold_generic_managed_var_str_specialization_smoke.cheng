import std/tables as tables
import cheng/core/tooling/memory_release_receipt as receipt

fn coldGenericManagedVarStrExercise(): int32 =
    var table = tables.TableInit[str](16)
    let firstValue = Fmt"managed-success-value-that-is-heap-backed-{109}"
    tables.TablePut[str](
        table, Fmt"managed-success-{101}", firstValue)

    # Success must retain the table's borrowed element before replacing and
    # dropping the old target owner.
    var out = Fmt"managed-old-target-that-must-be-dropped-{113}"
    if !tables.TableTryGet[str](
            table, Fmt"managed-success-{101}", out):
        return 1
    if out != "managed-success-value-that-is-heap-backed-109":
        return 2

    # The table and out now share one backing allocation. Re-inserting out and
    # reading it back into itself proves retain-before-drop for aliasing data.
    tables.TablePut[str](
        table, Fmt"managed-alias-{103}", share(out))
    if !tables.TableTryGet[str](
            table, Fmt"managed-alias-{103}", out):
        return 3
    if out != "managed-success-value-that-is-heap-backed-109":
        return 4

    # A second overwrite must drop exactly one prior target owner and publish
    # a fresh var memory version.
    out = Fmt"managed-second-old-target-that-must-be-dropped-{127}"
    if !tables.TableTryGet[str](
            table, Fmt"managed-success-{101}", out):
        return 5
    if out != "managed-success-value-that-is-heap-backed-109":
        return 6

    # The generic default V() path must initialize the complete str ABI and
    # replace/drop the prior target; a four-byte zero store is insufficient.
    if tables.TableTryGet[str](
            table, Fmt"managed-missing-{107}", out):
        return 7
    if out.len != 0:
        return 8
    return 0

fn main(): int32 =
    var scope: receipt.MemoryReleaseOrcScope
    var row: receipt.MemoryReleaseOrcRow
    receipt.MemoryReleaseOrcScopeBegin(
        scope, "generic_managed_var_str_specialization")
    let exerciseRc = coldGenericManagedVarStrExercise()
    receipt.MemoryReleaseOrcScopeFinish(scope, int64(1), row)
    if exerciseRc != 0:
        return exerciseRc
    if row.allocCount <= int64(0) ||
       row.allocCount != row.freeCount ||
       row.liveCount != int64(0):
        return 20
    if row.allocCount > int64(9223372036854775807) - row.retainCount:
        return 21
    if row.releaseCount != row.allocCount + row.retainCount:
        return 22
    echo("cold_generic_managed_var_str_specialization: ok")
    return 0
