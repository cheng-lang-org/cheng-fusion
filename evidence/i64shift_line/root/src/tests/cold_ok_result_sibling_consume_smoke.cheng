import std/result
import std/strings
import std/system

fn ColdOkResultSiblingConsume(selectFirst: bool): Result[str] =
    let owned = strings.CloneStr("sibling-owned")
    if selectFirst:
        return Ok[str](owned)
    return Ok[str](owned)

fn main(): int32 =
    let first = ColdOkResultSiblingConsume(true)
    if IsErr(first) || Value(first) != "sibling-owned":
        return 11
    let second = ColdOkResultSiblingConsume(false)
    if IsErr(second) || Value(second) != "sibling-owned":
        return 12
    echo("cold_ok_result_sibling_consume=pass")
    return 0
