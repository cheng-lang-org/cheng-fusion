import std/system
import std/result
import std/rawbytes
import std/strutils as strutil
import cheng/apps/vpn_proxy/transport_tcp_tls_record as rec

fn hexVal(c: int32): int32 =
    if c >= 48 && c <= 57:
        return c - 48
    if c >= 97 && c <= 102:
        return c - 87
    if c >= 65 && c <= 70:
        return c - 55
    Assert(false, "hexToBytes: invalid hex character")
    return 0

fn hexToBytes(s: str): Bytes =
    let raw: Bytes = BytesFromString(s)
    let n: int32 = BytesLen(raw)
    Assert(n % 2 == 0, "hexToBytes: odd length")
    let out: Bytes = BytesAlloc(n / 2)
    for i in 0..<(n / 2):
        BytesSet(out, i, hexVal(BytesGet(raw, 2 * i)) * 16 + hexVal(BytesGet(raw, 2 * i + 1)))
    return out

fn main(): int32 =
    let key: Bytes = hexToBytes("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
    let iv: Bytes = hexToBytes("000000000102030405060708")
    var sendKeys: rec.VpnProxyTcpTlsRecordKeys
    let sendInitRes: Result[bool] = rec.VpnProxyTcpTlsRecordInitKeysForCipherCodeInto(3,
                                                                                      key,
                                                                                      iv,
                                                                                      sendKeys)
    assert(!IsErr(sendInitRes), "tcp-tls-record chacha send keys")
    let payload0: Bytes = BytesFromString("tcp-tls-record-chacha-cross-arch-0")
    var wire0: Bytes
    let enc0Res: Result[bool] = rec.VpnProxyTcpTlsRecordEncryptInto(sendKeys,
                                                                    rec.VpnProxyTcpTlsRecordContentTypeApplicationData(),
                                                                    payload0,
                                                                    wire0)
    assert(!IsErr(enc0Res), "tcp-tls-record chacha encrypt 0")
    let payload1: Bytes = BytesFromString("tcp-tls-record-chacha-cross-arch-1")
    var wire1: Bytes
    let enc1Res: Result[bool] = rec.VpnProxyTcpTlsRecordEncryptInto(sendKeys,
                                                                    rec.VpnProxyTcpTlsRecordContentTypeApplicationData(),
                                                                    payload1,
                                                                    wire1)
    assert(!IsErr(enc1Res), "tcp-tls-record chacha encrypt 1")

    var recvKeys: rec.VpnProxyTcpTlsRecordKeys
    let recvInitRes: Result[bool] = rec.VpnProxyTcpTlsRecordInitKeysForCipherCodeInto(3,
                                                                                      key,
                                                                                      iv,
                                                                                      recvKeys)
    assert(!IsErr(recvInitRes), "tcp-tls-record chacha recv keys")
    let dec0Res: Result[rec.VpnProxyTcpTlsRecordPlain] = rec.VpnProxyTcpTlsRecordDecrypt(recvKeys, wire0)
    assert(!IsErr(dec0Res), "tcp-tls-record chacha decrypt 0")
    assert(BytesEqual(Value(dec0Res).payload, payload0), "tcp-tls-record chacha payload 0")
    let dec1Res: Result[rec.VpnProxyTcpTlsRecordPlain] = rec.VpnProxyTcpTlsRecordDecrypt(recvKeys, wire1)
    assert(!IsErr(dec1Res), "tcp-tls-record chacha decrypt 1")
    assert(BytesEqual(Value(dec1Res).payload, payload1), "tcp-tls-record chacha payload 1")

    echo(strutil.Join(["record0=", BytesToHex(wire0)], ""))
    echo(strutil.Join(["record1=", BytesToHex(wire1)], ""))
    echo(" vpn_proxy_tcp_tls_record_chacha_vector_smoke ok")
    return 0
