type
    Batch =
        session: int32
        staged: int32[]
        active: bool

fn closeRound(batch: var Batch) =
    batch.active = false

fn cloneSeq(n: int32): int32[] =
    var o: int32[]
    setLen(o, n)
    return o

fn build(useFallback: bool): bool =
    var nb = new(Batch)
    nb.staged = cloneSeq(4)
    if useFallback:
        closeRound(nb)
        return false
    closeRound(nb)
    return true

fn main(): int32 =
    if build(false):
        return 0
    return 1
