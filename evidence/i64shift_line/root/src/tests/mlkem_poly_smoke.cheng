# ML-KEM (FIPS 203) polynomial math self-checks (no external oracle):
#   1. INTT(NTT(f)) == f for LCG-random polynomials.
#   2. INTT(MultiplyNTTs(NTT(f), NTT(g))) == schoolbook negacyclic
#      convolution mod (x^256 + 1, q) for 3 random input pairs.
#   3. |x - Decompress_d(Compress_d(x))| mod+- q <= round(q / 2^(d+1))
#      for every x in [0, q) and every d in 1..11.
#   4. ByteDecode_d(ByteEncode_d(f)) == f for d in 1..12.
#   5. SampleNTT coefficients all in [0, q); SamplePolyCBD_eta coefficients
#      all in {0..eta} union {q-eta..q-1} (centered values stored mod q).

import std/system
import std/strings
import std/rawbytes
import std/crypto/sha3
import std/crypto/mlkem_poly

# LCG state update uses "& 2147483647" (== mod 2^31 for non-negative x):
# the literal 2147483648 does not fit int32 and "% 2147483648" miscompiles
# (known bit31 literal defect family, findings.md 2026-06-12).
fn lcgPoly(seed: int64, modulus: int32): int32[] =
    var x: int64 = seed
    var f: int32[]
    setLen(f, 256)
    for i in 0..<256:
        x = (x * 1103515245 + 12345) & 2147483647
        f[i] = int32((x >> 16) % int64(modulus))
    return f

fn polyCopy(f: int32[]): int32[] =
    var g: int32[]
    setLen(g, 256)
    for i in 0..<256:
        g[i] = f[i]
    return g

fn polyCheckEqual(label: str, got: int32[], expected: int32[]): bool =
    for i in 0..<256:
        if got[i] != expected[i]:
            echo(Fmt"mlkem_poly mismatch [{label}] first diff at index {i}: got {got[i]} expected {expected[i]}")
            return false
    return true

# Schoolbook multiplication in Z_q[x]/(x^256 + 1): x^256 == -1.
fn schoolbookMul(f: int32[], g: int32[]): int32[] =
    var h: int32[]
    setLen(h, 256)
    for i in 0..<256:
        for j in 0..<256:
            let p: int32 = (f[i] * g[j]) % 3329
            let k: int32 = i + j
            if k < 256:
                h[k] = (h[k] + p) % 3329
            else:
                h[k - 256] = (h[k - 256] - p + 3329) % 3329
    return h

fn testNttRoundtrip(): bool =
    var seed: int64 = 1
    while seed <= 3:
        let f: int32[] = lcgPoly(seed, 3329)
        var g: int32[] = polyCopy(f)
        MlkemNtt(g)
        MlkemIntt(g)
        if !polyCheckEqual(Fmt"ntt-intt seed={seed}", g, f):
            return false
        let h: int32[] = lcgPoly(seed + 50, 3329)
        if !polyCheckEqual(Fmt"add-sub seed={seed}", MlkemPolySub(MlkemPolyAdd(f, h), h), f):
            return false
        seed = seed + 1
    return true

fn testNttMultiply(): bool =
    var seed: int64 = 11
    while seed <= 13:
        let f: int32[] = lcgPoly(seed, 3329)
        let g: int32[] = lcgPoly(seed + 100, 3329)
        let want: int32[] = schoolbookMul(f, g)
        var fHat: int32[] = polyCopy(f)
        var gHat: int32[] = polyCopy(g)
        MlkemNtt(fHat)
        MlkemNtt(gHat)
        var got: int32[] = MlkemMultiplyNtts(fHat, gHat)
        MlkemIntt(got)
        if !polyCheckEqual(Fmt"ntt-mul seed={seed}", got, want):
            return false
        seed = seed + 1
    return true

fn testCompressRoundtrip(): bool =
    var d: int32 = 1
    while d <= 11:
        # bound = round(q / 2^(d+1)) half-up = floor((2q + 2^(d+1)) / 2^(d+2))
        let bound: int32 = (6658 + (1 << (d + 1))) / (1 << (d + 2))
        var x: int32
        while x < 3329:
            let y: int32 = MlkemCompress(x, d)
            if y < 0 || y >= (1 << d):
                echo(Fmt"mlkem_poly compress out of range: d={d} x={x} y={y}")
                return false
            let z: int32 = MlkemDecompress(y, d)
            var diff: int32 = x - z
            if diff < 0:
                diff = 0 - diff
            if 3329 - diff < diff:
                diff = 3329 - diff
            if diff > bound:
                echo(Fmt"mlkem_poly compress error bound violated: d={d} x={x} z={z} diff={diff} bound={bound}")
                return false
            x = x + 1
        d = d + 1
    return true

fn testByteEncodeRoundtrip(): bool =
    var d: int32 = 1
    while d <= 12:
        var modulus: int32 = 1 << d
        if d == 12:
            modulus = 3329
        let f: int32[] = lcgPoly(int64(40 + d), modulus)
        let packed: Bytes = MlkemByteEncode(f, d)
        if BytesLen(packed) != 32 * d:
            echo(Fmt"mlkem_poly byte-encode length wrong: d={d} len={BytesLen(packed)}")
            return false
        let back: int32[] = MlkemByteDecode(packed, d)
        if !polyCheckEqual(Fmt"byte-encode d={d}", back, f):
            return false
        d = d + 1
    return true

fn testSampling(): bool =
    # SampleNTT: 34-byte XOF input (rho || j || i shape).
    let seed: Bytes = BytesAlloc(34)
    for i in 0..<34:
        BytesSet(seed, i, (i * 7 + 1) & 255)
    let a: int32[] = MlkemSampleNtt(seed)
    if a.len != 256:
        echo(Fmt"mlkem_poly sample-ntt length wrong: {a.len}")
        return false
    for j in 0..<256:
        if a[j] < 0 || a[j] >= 3329:
            echo(Fmt"mlkem_poly sample-ntt coefficient out of range at {j}: {a[j]}")
            return false
    # SamplePolyCBD for eta = 2 and eta = 3; input bytes from SHAKE256
    # (stands in for the scheme PRF, content is irrelevant for the check).
    var eta: int32 = 2
    while eta <= 3:
        let prf: Bytes = Shake256Xof(seed, 64 * eta)
        let f: int32[] = MlkemSamplePolyCbd(prf, eta)
        for j in 0..<256:
            let v: int32 = f[j]
            if !(v <= eta || v >= 3329 - eta) || v < 0 || v >= 3329:
                echo(Fmt"mlkem_poly sample-cbd eta={eta} coefficient out of range at {j}: {v}")
                return false
        eta = eta + 1
    return true

fn main(): int32 =
    if !testNttRoundtrip():
        return 1
    if !testNttMultiply():
        return 1
    if !testCompressRoundtrip():
        return 1
    if !testByteEncodeRoundtrip():
        return 1
    if !testSampling():
        return 1
    echo(" mlkem_poly_smoke ok: ntt-roundtrip(3) add-sub(3) ntt-mul(3) compress(d=1..11 full domain) byte-encode(d=1..12) sampling(ntt+cbd2+cbd3) all passed")
    return 0
