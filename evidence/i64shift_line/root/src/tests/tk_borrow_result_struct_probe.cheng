module tk_borrow_result_struct_probe

import std/bytes_layout as layout
import std/rawbytes

fn Caller(bytes: rawbytes.Bytes): int32 =
    let span = layout.ByteSpanFromBytes(bytes)
    return layout.ByteSpanLen(span)

fn main(): int32 =
    var b = rawbytes.BytesFromString("abcd")
    return Caller(b)

main()
