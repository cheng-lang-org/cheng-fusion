import cheng/core/lang/parser
import cheng/core/lang/typed_expr as texpr

fn main(): int32 =
    let sourcePath = "/typed-expr-source-context-lifecycle/entry.cheng"
    var externalRoots: parser.ParserExternalPackageRoot[]
    let source = texpr.TypedExprSourceTextNewWithPackageFacts(
        "/typed-expr-source-context-lifecycle",
        "/typed-expr-source-context-lifecycle",
        "pkg://typed-expr-source-context-lifecycle",
        "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
        externalRoots,
        sourcePath,
        "fn leaf(x: int32): int32 =\n    return x + 1\n\nfn middle(x: int32): int32 =\n    return leaf(x)\n\nfn main(): int32 =\n    return middle(40)\n")
    var ctx: texpr.TypedExprSourceContext
    var err: str
    assert(texpr.TypedExprBuildSourceContext(source, ctx, err),
           Fmt"typed expr source context lifecycle: build failed {err}")
    assert(ctx.buildIndex != nil && !ctx.buildIndex.released,
           "typed expr source context lifecycle: final index unavailable")
    var borrowed = texpr.TypedExprSourceContextBorrowedView(ctx)
    assert(borrowed.buildIndex == ctx.buildIndex &&
           !borrowed.buildIndexOwned && ctx.buildIndexOwned,
           "typed expr source context lifecycle: borrowed owner split failed")
    texpr.TypedExprSourceContextReleaseBuildIndex(borrowed)
    texpr.TypedExprSourceContextReleaseBuildIndex(ctx)
    echo("typed_expr_source_context_call_index_lifecycle_smoke ok")
    return 0
