module cold_if_ternary_smoke

fn main(): int32 =
    let x = true ? 10 : 20
    if x != 10:
        return 1
    let y = false ? 10 : 20
    if y != 20:
        return 2
    var status: str
    status = true ? "failed" : "completed"
    if status != "failed":
        return 3
    status = false ? "failed" : "completed"
    if status != "completed":
        return 4
    let suffix = true ? "tail" : "lost"
    if suffix != "tail":
        return 5
    return 0

main()
