import std/system

var scalarAppendBase: int32
var scalarAppendValues: int32[]

fn AppendPlainScalarValues(value: int32) =
    add(scalarAppendValues, scalarAppendBase)
    add(scalarAppendValues, value)
    add(scalarAppendValues, scalarAppendBase)
    add(scalarAppendValues, value)

fn main() =
    scalarAppendBase = 11
    AppendPlainScalarValues(23)
    if len(scalarAppendValues) != 4:
        panic("plain scalar append length")
    if scalarAppendValues[0] != 11 || scalarAppendValues[1] != 23:
        panic("plain scalar append prefix")
    if scalarAppendValues[2] != 11 || scalarAppendValues[3] != 23:
        panic("plain scalar append reuse")
