# Rigid-ball probe (rotational dynamics minimal cut):
#   A. rolling coupling: ball launched vx=1, omega=0 (pure slip) must
#      converge to pure rolling (|vx - wy*r| < 0.02) with vx decayed
#   B. pure roll sustains: a rolling ball keeps vx (no rolling resistance
#      when unloaded) and travels farther than a sliding plain dynamic body
#   C. conditional preimage: identical worlds differing only in
#      Dynamic-vs-BallRigid kind hash differently; repeated hashing of
#      the same world is stable
#   D. load-aware rolling resistance: a pure-rolling ball under rider
#      pressure (downward force = one extra body weight, re-applied every
#      tick after the step clears forces) decays markedly faster than the
#      identical unloaded control, while slip stays ~0 in both — the
#      resistance preserves the rolling ratio and only fires above the
#      self-weight load threshold
import cheng/game/world3d
import cheng/game/physics3d
import cheng/game/csg/numerics
import std/math as m
import std/strings as strings

fn fmtMm(x: float64): str =
    let scaled: int32 = int32(m.roundFloat(x * 1000.0))
    var neg: bool = scaled < 0
    var mag: int32 = scaled
    if neg:
        mag = 0 - mag
    let intPart: int32 = mag / 1000
    let fracPart: int32 = mag % 1000
    var outStr: str = ""
    if neg:
        outStr = "-"
    outStr = outStr + strings.IntToStr(intPart) + "." + strings.CloneStrRange(strings.IntToStr(fracPart + 1000), 1, 3)
    return outStr

# case A: pure slip -> pure roll convergence. Slip decays at
# mu*g*(1 + m r^2/I) = 3.5*mu*g for a solid sphere, so the ball enters
# pure rolling after ~12 steps (50 ms); vx drops by mu*g*t* to ~0.715
# and then holds (no rolling resistance).
fn caseRollCouple(): bool =
    var w: world3d.World3d
    World3dReset(w, int64(21))
    let ballR = 0.1
    let _b = World3dSpawnBody(w, 0.0, 0.0, ballR, 1.0, ballR, world3d.World3dBodyBallRigid)
    w.bodyVx[0] = 1.0
    # buffered trace, emitted after the loop (no str work inside physics)
    var sTick: int32[]
    var sVx: float64[]
    var sWyr: float64[]
    var sSlip: float64[]
    setLen(sTick, 0)
    setLen(sVx, 0)
    setLen(sWyr, 0)
    setLen(sSlip, 0)
    var i: int32 = 0
    while i < 240:
        var r = physics3d.Physics3dStep(w, "case:rollcouple")
        if r.statusCode != physics3d.Physics3dStatusOk:
            echo("FAIL rollcouple step rejected")
            return false
        if (i == 0) || (i == 1) || (i == 2) || (i == 4) || (i == 8) || (i == 12) || (i == 16) || (i == 32) || (i == 120) || (i == 239):
            let wyr = w.bodyAngVy[0] * ballR
            add(sTick, i)
            add(sVx, w.bodyVx[0])
            add(sWyr, wyr)
            add(sSlip, w.bodyVx[0] - wyr)
        i = i + 1
    var k: int32 = 0
    while k < sTick.len:
        echo("roll t=" + strings.IntToStr(sTick[k]) + " vx_mm=" + fmtMm(sVx[k] * 1000.0) + " wyr_mm=" + fmtMm(sWyr[k] * 1000.0) + " slip_mm=" + fmtMm(sSlip[k] * 1000.0))
        k = k + 1
    let slipEnd = m.absFloat(w.bodyVx[0] - w.bodyAngVy[0] * ballR)
    let vxEnd = w.bodyVx[0]
    let zErr = m.absFloat(w.bodyPz[0] - ballR)
    echo("case rollcouple vx=" + fmtMm(vxEnd * 1000.0) + " slip_mm=" + fmtMm(slipEnd * 1000.0) + " zerr_mm=" + fmtMm(zErr * 1000.0))
    if slipEnd > 0.02:
        return false
    if vxEnd > 0.95:
        return false
    if vxEnd < 0.1:
        return false
    if zErr > 0.005:
        return false
    return true

# case B: pure roll sustains and beats a slider. Ball starts at
# vx = wy*r = 1.0 (no slip, friction never fires); a plain dynamic body
# with the same vx is braked by the position-level friction cone and
# stops within ~0.2 m.
fn casePureRoll(): bool =
    var w: world3d.World3d
    World3dReset(w, int64(22))
    let ballR = 0.1
    let _b = World3dSpawnBody(w, 0.0, 0.0, ballR, 1.0, ballR, world3d.World3dBodyBallRigid)
    w.bodyVx[0] = 1.0
    w.bodyAngVy[0] = 1.0 / ballR
    let _s = World3dSpawnBody(w, 0.0, 0.5, 0.05, 1.0, 0.05, world3d.World3dBodyDynamic)
    w.bodyVx[1] = 1.0
    var i: int32 = 0
    while i < 480:
        var r = physics3d.Physics3dStep(w, "case:pureroll")
        if r.statusCode != physics3d.Physics3dStatusOk:
            echo("FAIL pureroll step rejected")
            return false
        i = i + 1
    let slip = m.absFloat(w.bodyVx[0] - w.bodyAngVy[0] * ballR)
    let ballX = w.bodyPx[0]
    let sliderX = w.bodyPx[1]
    echo("case pureroll ballX_mm=" + fmtMm(ballX * 1000.0) + " sliderX_mm=" + fmtMm(sliderX * 1000.0) + " vx=" + fmtMm(w.bodyVx[0] * 1000.0) + " slip_mm=" + fmtMm(slip * 1000.0))
    if slip > 0.02:
        return false
    if w.bodyVx[0] < 0.95:
        return false
    if ballX < 1.5:
        return false
    if sliderX > 0.3:
        return false
    if ballX < sliderX:
        return false
    return true

# case C: the angular-velocity preimage section is conditional. Two
# worlds identical except body kind (Dynamic vs BallRigid) must hash
# differently (the |balls=| section appears), and hashing is stable.
fn casePreimageGate(): bool =
    var wa: world3d.World3d
    World3dReset(wa, int64(23))
    let _a = World3dSpawnBody(wa, 0.0, 0.0, 0.1, 1.0, 0.1, world3d.World3dBodyDynamic)
    wa.bodyVx[0] = 1.0
    var wb: world3d.World3d
    World3dReset(wb, int64(23))
    let _c = World3dSpawnBody(wb, 0.0, 0.0, 0.1, 1.0, 0.1, world3d.World3dBodyBallRigid)
    wb.bodyVx[0] = 1.0
    let cidA = World3dCid(wa)
    let cidB = World3dCid(wb)
    let cidA2 = World3dCid(wa)
    echo("case preimage cidA=" + cidA)
    echo("case preimage cidB=" + cidB)
    if cidA != cidA2:
        return false
    if cidA == cidB:
        return false
    return true

# case D: load-aware rolling resistance. Two identical pure-rolling balls
# (vx = wy*r = 0.5, slip exactly 0, so the Coulomb channel never fires and
# the ONLY decay channel is the new load-aware resistance). The loaded one
# carries a rider pressing down with one extra body weight (Fz = -m*g,
# re-applied every tick because Physics3dStep clears forces at its end).
# Theory: excess = m*g, dv/dt = -Crr*excess/m = -0.03*g ~ -0.294 m/s^2, so
# after 240 ticks (1 s) vx ~ 0.5 - 0.294 ~ 0.206 while the unloaded
# control holds vx ~ 0.5 (pure roll sustains, case B). Slip must stay ~0
# in both: the resistance spin delta preserves the rolling ratio.
fn caseRiderLoad(): bool =
    let ballR = 0.1
    let v0 = 0.5
    var wu: world3d.World3d
    World3dReset(wu, int64(24))
    let _a = World3dSpawnBody(wu, 0.0, 0.0, ballR, 1.0, ballR, world3d.World3dBodyBallRigid)
    wu.bodyVx[0] = v0
    wu.bodyAngVy[0] = v0 / ballR
    var wl: world3d.World3d
    World3dReset(wl, int64(25))
    let _b = World3dSpawnBody(wl, 0.0, 0.0, ballR, 1.0, ballR, world3d.World3dBodyBallRigid)
    wl.bodyVx[0] = v0
    wl.bodyAngVy[0] = v0 / ballR
    let riderFz = 0.0 - 1.0 * physics3d.Physics3dGravity
    # buffered trace of the loaded decay, emitted after the loop
    var sTick: int32[]
    var sVx: float64[]
    setLen(sTick, 0)
    setLen(sVx, 0)
    var i: int32 = 0
    while i < 240:
        physics3d.Physics3dAddForce(wl, 0, 0.0, 0.0, riderFz)
        var ru = physics3d.Physics3dStep(wu, "case:riderload-unloaded")
        var rl = physics3d.Physics3dStep(wl, "case:riderload-loaded")
        if ru.statusCode != physics3d.Physics3dStatusOk:
            echo("FAIL riderload unloaded step rejected")
            return false
        if rl.statusCode != physics3d.Physics3dStatusOk:
            echo("FAIL riderload loaded step rejected")
            return false
        if (i == 0) || (i == 30) || (i == 60) || (i == 120) || (i == 180) || (i == 239):
            add(sTick, i)
            add(sVx, wl.bodyVx[0])
        i = i + 1
    var k: int32 = 0
    while k < sTick.len:
        echo("riderload t=" + strings.IntToStr(sTick[k]) + " vx_loaded_mm=" + fmtMm(sVx[k] * 1000.0))
        k = k + 1
    let vxU = wu.bodyVx[0]
    let vxL = wl.bodyVx[0]
    let slipU = m.absFloat(wu.bodyVx[0] - wu.bodyAngVy[0] * ballR)
    let slipL = m.absFloat(wl.bodyVx[0] - wl.bodyAngVy[0] * ballR)
    let zErrU = m.absFloat(wu.bodyPz[0] - ballR)
    let zErrL = m.absFloat(wl.bodyPz[0] - ballR)
    echo("case riderload vx_unloaded_mm=" + fmtMm(vxU * 1000.0) + " vx_loaded_mm=" + fmtMm(vxL * 1000.0) + " slipU_mm=" + fmtMm(slipU * 1000.0) + " slipL_mm=" + fmtMm(slipL * 1000.0) + " zerrU_mm=" + fmtMm(zErrU * 1000.0) + " zerrL_mm=" + fmtMm(zErrL * 1000.0))
    # unloaded control: pure roll sustains (no resistance at N = m*g)
    if vxU < 0.48:
        return false
    # loaded: visible decay, far below the control
    if vxL > 0.30:
        return false
    if vxL > 0.7 * vxU:
        return false
    # rolling ratio preserved under load
    if slipU > 0.02:
        return false
    if slipL > 0.02:
        return false
    if zErrU > 0.005:
        return false
    if zErrL > 0.005:
        return false
    return true

fn main(): int32 =
    if !casePreimageGate():
        echo("FAIL casePreimageGate")
        return 1
    if !caseRollCouple():
        echo("FAIL caseRollCouple")
        return 1
    if !casePureRoll():
        echo("FAIL casePureRoll")
        return 1
    if !caseRiderLoad():
        echo("FAIL caseRiderLoad")
        return 1
    echo("PASS rigid ball probe")
    return 0
