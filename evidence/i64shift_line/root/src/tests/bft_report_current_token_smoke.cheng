import std/os
import cheng/core/tooling/path as chengpath

fn CurrentBftTokenCount(text: str, needle: str): int32 =
    if needle.len == 0 || text.len < needle.len:
        return 0
    var count: int32
    let candidateCount = text.len - needle.len + 1
    for i in 0..<candidateCount:
        var matched = true
        for j in 0..<needle.len:
            if text[i + j] != needle[j]:
                matched = false
                break
        if matched:
            count = count + 1
    return count

fn main(): int32 =
    let root = os.GetCurrentDir()
    let bftSource = chengpath.ReadTextFile(
        root, "src/core/tooling/bft_three_node.cheng")
    let controlSource = chengpath.ReadTextFile(
        root, "src/core/tooling/bft_three_node_control.cheng")
    let gateSource = chengpath.ReadTextFile(
        root, "src/core/tooling/gate_main.cheng")
    assert(bftSource.len > 0 &&
           controlSource.len > 0 &&
           gateSource.len > 0,
           " bft report token: production source missing")

    let verifyToken = "version=cheng.bft_three_node_verify"
    let benchToken = "version=cheng.bft_three_node_bench"
    let oracleVerifyToken =
        "version=cheng.oracle_bft_three_node_verify"
    assert(CurrentBftTokenCount(bftSource, verifyToken) == 1 &&
           CurrentBftTokenCount(bftSource, benchToken) == 2,
           " bft report token: primary producer set drifted")
    assert(CurrentBftTokenCount(controlSource, verifyToken) == 1 &&
           CurrentBftTokenCount(controlSource, benchToken) == 1,
           " bft report token: control producer set drifted")
    assert(CurrentBftTokenCount(gateSource, verifyToken) == 1 &&
           CurrentBftTokenCount(gateSource, benchToken) == 1 &&
           CurrentBftTokenCount(gateSource, oracleVerifyToken) == 1,
           " bft report token: gate producer set drifted")
    assert(CurrentBftTokenCount(bftSource, ".v1") == 0 &&
           CurrentBftTokenCount(bftSource, ".v2") == 0 &&
           CurrentBftTokenCount(controlSource, ".v1") == 0 &&
           CurrentBftTokenCount(controlSource, ".v2") == 0 &&
           CurrentBftTokenCount(gateSource, ".v1") == 0 &&
           CurrentBftTokenCount(gateSource, ".v2") == 0,
           " bft report token: version fragment survived")
    echo(" bft_report_current_token_smoke ok")
    return 0
