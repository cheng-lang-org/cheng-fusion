import std/strutils as strutil

fn R24Join(a: str, b: str): str =
    var parts: str[]
    add(parts, a)
    add(parts, b)
    return strutil.Join(parts, "")

fn R24HeapDirect(lineRaw: str, genericPos: int32): int32 =
    let keep = R24Join("keep-", lineRaw)
    let headRaw = R24Join("head-", lineRaw)
    var head: str
    if genericPos > 0:
        head = R24Join("tag-", headRaw)
    else:
        head = headRaw
    return head.len * 1000 + keep.len

fn main(): int32 =
    let a = R24HeapDirect("abcdef", 1)
    if a != 15011:
        return 10
    let b = R24HeapDirect("abcdef", 0)
    if b != 11011:
        return 11
    echo("r24 heapdirect ok a=15011 b=11011")
    return 0
