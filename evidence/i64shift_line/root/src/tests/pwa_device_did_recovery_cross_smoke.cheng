// PWA browser-device-DID recovery cross-check (Cheng vs JS).
//
// Independent Cheng reproduction of the PWA recovery->DID derivation in
//   UniMaker/React.js/app/libp2p/browserDeviceDid.ts   (taggedHashHex, buildRecoveryPayloadText)
//   UniMaker/React.js/app/libp2p/browserPeerIdentity.ts (derivePseudoPeerId)
//
// The browser device DID depends ONLY on recoverySecret:
//   rootSeed = sha256("pwa.device.did.root.v1" || secretBytes)
//   did      = "did:cheng:" + derivePseudoPeerId("did-root|" + rootSeed)   (fnv1a32 rolling)
// The WebAuthn credential only feeds deviceSeed/peerId, so the DID is offline reproducible.
//
// This test consumes src/tests/fixtures/pwa_device_did_recovery_fixture.json (generated by
// src/tests/fixtures/pwa_device_did_recovery_gen.mjs and validated byte-for-byte against the
// real PWA module) and recomputes the DID with Cheng's own sha256 + a Cheng transcription of
// fnv1a32. Agreement breaks the JS-vs-Cheng double blind.

import std/system
import std/rawbytes
import std/os as os
import std/json as json
import std/crypto/sha256 as sha256

fn pwaU32ToHexLower(value: int64): str =
    if value == 0:
        return "0"
    var v: int64 = value & 0xffffffff
    var buf: Bytes = BytesAlloc(8)
    var count: int32
    while v > 0:
        let nib: int32 = int32(v & 15)
        var db: int32 = 48 + nib
        if nib >= 10:
            db = 97 + (nib - 10)
        BytesSet(buf, count, db)
        count = count + 1
        v = v >> 4
    var out: Bytes = BytesAlloc(count)
    for i in 0..<count:
        BytesSet(out, i, BytesGet(buf, count - 1 - i))
    return BytesToString(out)

fn pwaIntToDecimal(value: int32): str =
    if value == 0:
        return "0"
    var v: int32 = value
    var buf: Bytes = BytesAlloc(12)
    var count: int32
    while v > 0:
        let d: int32 = v % 10
        BytesSet(buf, count, 48 + d)
        count = count + 1
        v = v / 10
    var out: Bytes = BytesAlloc(count)
    for i in 0..<count:
        BytesSet(out, i, BytesGet(buf, count - 1 - i))
    return BytesToString(out)

fn pwaFnv1a32(input: str): int64 =
    let ib: Bytes = BytesFromString(input)
    let n: int32 = BytesLen(ib)
    var hash: int64 = 0x811c9dc5
    var i: int32
    while i < n:
        hash = (hash ^ int64(BytesGet(ib, i) & 255)) & 0xffffffff
        hash = (hash * 0x01000193) & 0xffffffff
        i = i + 1
    return hash

fn pwaDerivePseudoPeerId(seed: str): str =
    let alphaBytes: Bytes = BytesFromString("123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz")
    let alphaLen: int32 = BytesLen(alphaBytes)
    var rolling: int64 = pwaFnv1a32("peer|" + seed)
    var body: str
    for index in 0..<44:
        rolling = pwaFnv1a32(seed + "|" + pwaIntToDecimal(index) + "|" + pwaU32ToHexLower(rolling))
        let shifted: int64 = (rolling >> 13) & 0xffffffff
        let golden: int64 = (int64(index + 1) * 0x9e3779b1) & 0xffffffff
        let mixed: int64 = (rolling ^ shifted ^ golden) & 0xffffffff
        let idx: int32 = int32(mixed % int64(alphaLen))
        var ch: Bytes = BytesAlloc(1)
        BytesSet(ch, 0, BytesGet(alphaBytes, idx))
        body = body + BytesToString(ch)
    return "12D3KooW" + body

fn pwaTaggedHashHex(tag: str, secretHex: str): str =
    let secretBytes: Bytes = BytesFromHex(secretHex)
    let tagged: Bytes = BytesConcat(BytesFromString(tag), secretBytes)
    return BytesToHex(sha256.Sha256Digest(tagged))

fn pwaDeriveDidFromRecoverySecret(recoverySecret: str): str =
    let rootSeedHex: str = pwaTaggedHashHex("pwa.device.did.root.v1", recoverySecret)
    return "did:cheng:" + pwaDerivePseudoPeerId("did-root|" + rootSeedHex)

fn pwaDeriveOperatorId(recoverySecret: str): str =
    return pwaTaggedHashHex("device.did.operator.v1", recoverySecret)

// Faithful buildRecoveryPayloadText: JSON.stringify({kind,version,operatorId,recoverySecret}, null, 2).
fn pwaBuildRecoveryPayload(operatorId: str, recoverySecret: str): str =
    return "{\n  \"kind\": \"unimaker_device_did_recovery_v1\",\n  \"version\": 1,\n  \"operatorId\": \"" + operatorId + "\",\n  \"recoverySecret\": \"" + recoverySecret + "\"\n}"

fn main(): int32 =
    let fixturePath = "src/tests/fixtures/pwa_device_did_recovery_fixture.json"
    assert(os.FileExists(fixturePath), " pwa did fixture: exists")
    let fixtureText = os.ReadFile(fixturePath)
    let fixtureParsed = json.ParseJsonSafe(fixtureText)
    assert(fixtureParsed.success, " pwa did fixture: parse")

    var fxRecoverySecret: str
    assert(json.JsonTryGetStr(fixtureParsed.value, "recoverySecret", fxRecoverySecret),
           " pwa did fixture: recoverySecret field")
    var fxOperatorId: str
    assert(json.JsonTryGetStr(fixtureParsed.value, "operatorId", fxOperatorId),
           " pwa did fixture: operatorId field")
    var fxRootSeed: str
    assert(json.JsonTryGetStr(fixtureParsed.value, "rootSeed", fxRootSeed),
           " pwa did fixture: rootSeed field")
    var fxExpectedDid: str
    assert(json.JsonTryGetStr(fixtureParsed.value, "expectedDid", fxExpectedDid),
           " pwa did fixture: expectedDid field")
    var fxRecoveryPayload: str
    assert(json.JsonTryGetStr(fixtureParsed.value, "recoveryPayload", fxRecoveryPayload),
           " pwa did fixture: recoveryPayload field")

    // Cheng-vs-JS: recompute rootSeed, operatorId and DID independently; must match the fixture.
    assert(pwaTaggedHashHex("pwa.device.did.root.v1", fxRecoverySecret) == fxRootSeed,
           " pwa did cross-check: rootSeed matches PWA")
    assert(pwaDeriveOperatorId(fxRecoverySecret) == fxOperatorId,
           " pwa did cross-check: operatorId matches PWA")
    let chengDidCreated = pwaDeriveDidFromRecoverySecret(fxRecoverySecret)
    assert(chengDidCreated == fxExpectedDid, " pwa did cross-check: DID matches PWA")

    // Format-parse of the real PWA recovery payload: kind/version/operatorId/recoverySecret.
    // operatorId must equal sha256(OPERATOR_TAG || secret) -- the PWA import validation gate.
    let payloadParsed = json.ParseJsonSafe(fxRecoveryPayload)
    assert(payloadParsed.success, " pwa did payload: parse")
    var pKind: str
    assert(json.JsonTryGetStr(payloadParsed.value, "kind", pKind), " pwa did payload: kind field")
    assert(pKind == "unimaker_device_did_recovery_v1", " pwa did payload: kind value")
    var pVersion: int64
    assert(json.JsonTryGetInt64(payloadParsed.value, "version", pVersion), " pwa did payload: version field")
    assert(pVersion == int64(1), " pwa did payload: version value")
    var pOperatorId: str
    assert(json.JsonTryGetStr(payloadParsed.value, "operatorId", pOperatorId), " pwa did payload: operatorId field")
    var pRecoverySecret: str
    assert(json.JsonTryGetStr(payloadParsed.value, "recoverySecret", pRecoverySecret), " pwa did payload: recoverySecret field")
    assert(pRecoverySecret == fxRecoverySecret, " pwa did payload: recoverySecret round-trips")
    assert(pOperatorId == pwaDeriveOperatorId(pRecoverySecret), " pwa did payload: operatorId self-consistent")

    // Cheng-Cheng round-trip: create -> export (build payload) -> import (re-parse) -> DID stable.
    let exportedPayload = pwaBuildRecoveryPayload(fxOperatorId, fxRecoverySecret)
    let reimported = json.ParseJsonSafe(exportedPayload)
    assert(reimported.success, " pwa did round-trip: re-parse")
    var riSecret: str
    assert(json.JsonTryGetStr(reimported.value, "recoverySecret", riSecret), " pwa did round-trip: recoverySecret field")
    let chengDidImported = pwaDeriveDidFromRecoverySecret(riSecret)
    assert(chengDidImported == chengDidCreated, " pwa did round-trip: DID stable across export/import")

    // Error path: a truncated 62-hex secret must not reproduce the real DID.
    let shortSecret = "5f1c8b3a2d4e6079a1b2c3d4e5f60718293a4b5c6d7e8f9012a3b4c5d6e7f8"
    assert(pwaDeriveDidFromRecoverySecret(shortSecret) != fxExpectedDid,
           " pwa did error path: truncated secret yields different DID")

    echo(" pwa_device_did_recovery_cross_smoke ok")
    return 0
