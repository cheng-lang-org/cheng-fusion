type
    Scope =
        startLine: int32
        endLine: int32

fn Base(): int32 =
    return 2

fn SumRange(scope: Scope): int32 =
    var total: int32
    for i in scope.startLine..<scope.endLine:
        total = total + i
    return total

fn SumRangeIncl(scope: Scope): int32 =
    var total: int32
    for i in scope.startLine..scope.endLine:
        total = total + i
    return total

fn SumFromCall(): int32 =
    var total: int32
    for i in Base()..<5:
        total = total + i
    return total

fn main(): int32 =
    var s: Scope
    s.startLine = 3
    s.endLine = 6
    if SumRange(s) != 12:
        return 1
    if SumRangeIncl(s) != 18:
        return 2
    s.startLine = 6
    if SumRange(s) != 0:
        return 3
    if SumFromCall() != 9:
        return 4
    return 0
