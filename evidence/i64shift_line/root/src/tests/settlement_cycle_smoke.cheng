# settlement cycle smoke: reserve gate + creator + agent + depin on ONE
# shared state. Asserts per-flow cid namespaces, per-flow ledgers, and the
# global closure identity credited == balances + pools + outstanding.

import std/os
import std/system
import cheng/std/bytes_layout as layout
import cheng/apps/rwad/rwad_settlement as ssm
import cheng/chain/rwad_bridge_contract as brg
import cheng/apps/rwad/rwad_creator_flow as cff
import cheng/apps/rwad/rwad_agent_payflow as apf
import cheng/apps/rwad/rwad_depin_settle as dps
import cheng/apps/rwad/rwad_reserve as rsv
import cheng/apps/rwad/rwad_settlement_cycle as cyc

fn main(): int32 =
    var rc: int32 = 0
    var st = ssm.SsmInit()

    let sponsor = cyc.CidTagged(10)
    let creator = cyc.CidTagged(11)
    let challenger = cyc.CidTagged(12)
    let client = cyc.CidTagged(13)
    let agent = cyc.CidTagged(14)
    let payer = cyc.CidTagged(15)
    let providerA = cyc.CidTagged(16)
    let providerB = cyc.CidTagged(18)
    let platform = cyc.CidTagged(17)

    # --- E4 reserve discipline gate ---------------------------------------
    var book: rsv.ReserveBook
    let ri = rsv.ResInit(book, cyc.CidTagged(1), Int64(100000), 500, Int64(604800000))
    if !ri.ok:
        os.WriteLine(os.Get_stderr(), "die-34"); rc = 99; return rc
    let mint = rsv.ResMint(book, Int64(100000), cyc.CidTagged(1))
    if !mint.ok:
        os.WriteLine(os.Get_stderr(), "die-37"); rc = 99; return rc
    var lines: rsv.CreditLine[]
    let cSponsor = rsv.ResIssueCredit(book.mintedSupply, book.creditCapBp, lines, sponsor, Int64(1500), Int64(100))
    if !cSponsor.ok:
        os.WriteLine(os.Get_stderr(), "die-41"); rc = 99; return rc
    let cClient = rsv.ResIssueCredit(book.mintedSupply, book.creditCapBp, lines, client, Int64(200), Int64(110))
    if !cClient.ok:
        os.WriteLine(os.Get_stderr(), "die-44"); rc = 99; return rc
    let cPayer = rsv.ResIssueCredit(book.mintedSupply, book.creditCapBp, lines, payer, Int64(3300), Int64(120))
    if !cPayer.ok:
        os.WriteLine(os.Get_stderr(), "die-47"); rc = 99; return rc
    # cap is 5000; 5000 issued already -> one more unit must fail loudly
    let cOver = rsv.ResIssueCredit(book.mintedSupply, book.creditCapBp, lines, platform, Int64(1), Int64(130))
    if cOver.ok:
        os.WriteLine(os.Get_stderr(), "over-cap credit accepted")
        rc = rc + 1
    let guard = rsv.ResGuardSpend(lines, payer)
    if !guard.ok:
        os.WriteLine(os.Get_stderr(), "die-55"); rc = 99; return rc
    # approved credit lines are drawn down into the settlement ledger
    let dSponsor = ssm.SsmCredit(st, sponsor, Int64(1500))
    if !dSponsor.ok:
        os.WriteLine(os.Get_stderr(), "die-draw-sponsor"); rc = 99; return rc
    let dClient = ssm.SsmCredit(st, client, Int64(200))
    if !dClient.ok:
        os.WriteLine(os.Get_stderr(), "die-draw-client"); rc = 99; return rc
    let dPayer = ssm.SsmCredit(st, payer, Int64(3300))
    if !dPayer.ok:
        os.WriteLine(os.Get_stderr(), "die-draw-payer"); rc = 99; return rc
    var credited: int64 = 1500 + 200 + 3300

    # --- cid namespaces pairwise distinct ----------------------------------
    var cids: cyc.CycleCids
    cids.creatorCampaign = cyc.CidTagged(30)
    cids.agentLockEscrow = cyc.CidTagged(31)
    cids.depinCycle = cyc.CidTagged(32)
    cids.creatorBatch1 = cyc.CidTagged(33)
    cids.creatorBatch2 = cyc.CidTagged(34)
    let ns = cyc.CycleNamespacesDistinct(cids)
    if !ns.ok:
        os.WriteLine(os.Get_stderr(), "die-67"); rc = 99; return rc
    var badCids: cyc.CycleCids
    badCids.creatorCampaign = cyc.CidTagged(40)
    badCids.agentLockEscrow = cyc.CidTagged(40)
    badCids.depinCycle = cyc.CidTagged(42)
    let nsBad = cyc.CycleNamespacesDistinct(badCids)
    if nsBad.ok:
        os.WriteLine(os.Get_stderr(), "colliding namespaces accepted")
        rc = rc + 1

    # --- E1 creator flow ---------------------------------------------------
    var flow: cff.CreatorFlow
    flow.campaignCid = cids.creatorCampaign
    flow.creatorCid = creator
    flow.platformCid = platform
    let f1 = cff.FlowFund(st, flow, sponsor, Int64(1000), Int64(90000))
    if !f1.ok:
        os.WriteLine(os.Get_stderr(), "die-84"); rc = 99; return rc
    var entries: brg.BridgeEntry[]
    var eA: brg.BridgeEntry
    eA.accountCid = creator
    eA.amount = Int64(600)
    add(entries, eA)
    var eB: brg.BridgeEntry
    eB.accountCid = platform
    eB.amount = Int64(400)
    add(entries, eB)
    let sub1 = cff.FlowSubmitUsageBatch(st, flow, entries, cids.creatorBatch1, Int64(200), Int64(1000))
    if !sub1.ok:
        os.WriteLine(os.Get_stderr(), "die-96"); rc = 99; return rc
    let chal = cff.FlowChallenge(st, flow, challenger, true)
    if !chal.ok or !chal.value:
        os.WriteLine(os.Get_stderr(), "die-99"); rc = 99; return rc
    # slash 100 -> challenger 2 / burn 3 / safety 95; escrow now 900
    let sub2 = cff.FlowSubmitUsageBatch(st, flow, entries, cids.creatorBatch2, Int64(5000), Int64(10))
    if !sub2.ok:
        os.WriteLine(os.Get_stderr(), "die-103"); rc = 99; return rc
    let settle = cff.FlowSettle(st, flow, 8000)
    if !settle.ok:
        os.WriteLine(os.Get_stderr(), "die-106"); rc = 99; return rc
    if ssm.SsmBalanceOf(st, creator) != 720:
        os.WriteLine(os.Get_stderr(), "creator cut wrong in cycle")
        rc = rc + 1
    if ssm.SsmBalanceOf(st, platform) != 180:
        os.WriteLine(os.Get_stderr(), "platform cut wrong in cycle")
        rc = rc + 1

    # --- E2 agent payflow --------------------------------------------------
    var abook: apf.AgentBook
    var q: apf.AgentQuote
    q.quoteCid = cyc.CidTagged(50)
    q.agentCid = agent
    q.clientCid = client
    q.pricePerCall = Int64(10)
    q.maxCalls = 20
    q.expiresAtMs = Int64(1000) + Int64(10000)
    let quote = apf.FlowQuote(abook, q)
    if !quote.ok:
        os.WriteLine(os.Get_stderr(), "die-125"); rc = 99; return rc
    let lock = apf.FlowLock(st, abook, cids.agentLockEscrow, Int64(1000))
    if !lock.ok:
        os.WriteLine(os.Get_stderr(), "die-128"); rc = 99; return rc
    var k: int32
    while k < 20:
        let chg = apf.FlowCharge(st, abook, cyc.CidTagged(51), cyc.CidTagged(51))
        if !chg.ok:
            os.WriteLine(os.Get_stderr(), "agent charge failed mid-cycle")
            rc = rc + 1
        k = k + 1
    if ssm.SsmBalanceOf(st, agent) != 200:
        os.WriteLine(os.Get_stderr(), "agent total wrong (expect 200)")
        rc = rc + 1
    if ssm.SsmBalanceOf(st, client) != 0:
        os.WriteLine(os.Get_stderr(), "client remainder wrong (expect 0)")
        rc = rc + 1

    # --- E3 depin settle ---------------------------------------------------
    var dcycle: dps.DepinCycle
    dcycle.cycleCid = cids.depinCycle
    dcycle.payerCid = payer
    var mA: dps.DepinMeter
    mA.providerCid = providerA
    mA.gpuHoursMilli = Int64(10000)
    mA.unitPriceMilli = Int64(20000)
    mA.evidenceDigest = cyc.CidTagged(60)
    let addA = dps.CycleAddMeter(dcycle, mA)
    if !addA.ok:
        os.WriteLine(os.Get_stderr(), "die-154"); rc = 99; return rc
    var mB: dps.DepinMeter
    mB.providerCid = providerB
    mB.gpuHoursMilli = Int64(4000)
    mB.unitPriceMilli = Int64(25000)
    mB.evidenceDigest = cyc.CidTagged(61)
    let addB = dps.CycleAddMeter(dcycle, mB)
    if !addB.ok:
        os.WriteLine(os.Get_stderr(), "die-162"); rc = 99; return rc
    # A: 10000*20000/1e6 = 200 ; B: 4000*25000/1e6 = 100 ; total 300
    let dsub = dps.CycleSubmit(dcycle, st, Int64(1000), Int64(6000))
    if !dsub.ok:
        os.WriteLine(os.Get_stderr(), "die-166"); rc = 99; return rc
    let dfin = dps.CycleFinalize(dcycle, st, Int64(7001))
    if !dfin.ok:
        os.WriteLine(os.Get_stderr(), "die-169"); rc = 99; return rc
    if ssm.SsmBalanceOf(st, providerA) != 200:
        os.WriteLine(os.Get_stderr(), "providerA payout wrong")
        rc = rc + 1
    if ssm.SsmBalanceOf(st, providerB) != 100:
        os.WriteLine(os.Get_stderr(), "providerB payout wrong")
        rc = rc + 1

    # --- global closure identity -------------------------------------------
    let audit = cyc.CycleAuditCompute(st, credited)
    if !audit.closed:
        os.WriteLine(os.Get_stderr(), "cycle conservation broken")
        rc = rc + 1
    # precise totals: sponsor 1500-1000=500, creator 720, challenger 2,
    # client 0, agent 200, payer 3300-300=3000, providers 200+100,
    # platform 180 -> 4902 ; pools 98 ; 4902+98 == 5000 == credited
    if audit.finalBalances != 4902:
        os.WriteLine(os.Get_stderr(), "balance total wrong")
        rc = rc + 1
    if audit.finalPools != 98:
        os.WriteLine(os.Get_stderr(), "pools total wrong")
        rc = rc + 1
    if audit.finalEscrowLocked != 0:
        os.WriteLine(os.Get_stderr(), "escrow not fully unwound")
        rc = rc + 1

    if rc == 0:
        echo("settlement_cycle_smoke ok")
    return rc
