import cheng/core/ir/core_types as ir
import cheng/core/ir/body_ir_egraph as egraph
import cheng/core/ir/body_ir_noalias as noalias

fn BuildEntryBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    body.entryIsCAbi = true
    var slot: ir.LocalSlot
    slot.id = 0
    slot.name = "value"
    slot.typeKind = ir.LocalI32Tag
    slot.stackOffset = 16
    slot.sizeBytes = 4
    slot.alignBytes = 4
    slot.noAlias = true
    add(body.localSlots, slot)
    var op: ir.BodyOp
    op.kind = ir.BodyOpLoadConstTag
    op.target = 0
    add(op.operands, ir.LocalI32Tag)
    add(op.operands, 7)
    add(body.ops, op)
    var term: ir.BodyTerm
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = 0
    let termIndex = ir.BodyIRAppendTerm(body, term)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn main(): int32 =
    var body = BuildEntryBody()
    let forwarded = noalias.BodyIrNoAliasForwardLocals(body)
    assert(forwarded.entryIsCAbi,
           "noalias must preserve entry C ABI provenance")

    var egraphBody = BuildEntryBody()

    var snapshot: egraph.EGraphOpSnapshot
    snapshot.kind = ir.BodyOpLoadConstTag
    snapshot.target = 0
    snapshot.operandCount = 2
    snapshot.operand0 = ir.LocalI32Tag
    snapshot.operand1 = 7
    var snapshots: egraph.EGraphOpSnapshot[]
    add(snapshots, snapshot)
    var flat: ir.BodyIRFlatSoA
    var snapshotOk: bool
    egraph.EGraphBodyWithOpSnapshots(egraphBody,
                                    snapshots,
                                    flat,
                                    snapshotOk)
    assert(snapshotOk && egraphBody.entryIsCAbi,
           "egraph snapshot rebuild must preserve entry C ABI provenance")
    var report: egraph.EGraphRunReport
    egraph.BodyIrEgraphPassWithFlat(egraphBody, flat, report)
    assert(egraphBody.entryIsCAbi,
           "egraph transform must preserve entry C ABI provenance")
    return 0
