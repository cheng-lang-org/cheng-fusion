import cheng/core/ir/core_types as ir
import cheng/core/ir/body_ir_access as access
import cheng/core/lang/typed_expr as texpr
import cheng/core/backend/regalloc_single_pass as alloc
import cheng/core/backend/regalloc_aarch64_adapter as adapter
import cheng/core/backend/codegen_contract as contract
import cheng/core/backend/aarch64_encode as a64
import cheng/core/backend/regalloc_production_emitter as emitter
import cheng/core/backend/regalloc_production_artifacts as artifacts

fn makeTypedSlot(id: int32,
                 parameter: bool,
                 typeKind: int32): ir.LocalSlot =
    var slot: ir.LocalSlot
    slot.id = id
    slot.name = "coalesced"
    slot.typeKind = typeKind
    slot.stackOffset = 16 + id * 8
    if parameter:
        slot.stackOffset = 0 - 1 - id
    slot.sizeBytes = 8
    slot.alignBytes = 8
    if typeKind == ir.LocalI32Tag:
        slot.sizeBytes = 4
        slot.alignBytes = 4
    elif typeKind == ir.LocalStrTag:
        slot.sizeBytes = 24
    ir.BodyIRApplyLocalSlotDefaultProof(slot)
    if typeKind == ir.LocalPtrTag:
        slot.auxValue = 0
        slot.noAlias = true
    return slot

fn makeI32Slot(id: int32, parameter: bool): ir.LocalSlot =
    return makeTypedSlot(id, parameter, ir.LocalI32Tag)

fn makeWriteThroughPtrSlot(id: int32,
                           parameter: bool,
                           pointeeType: int32): ir.LocalSlot =
    var slot = makeTypedSlot(id, parameter, ir.LocalPtrTag)
    slot.auxValue = pointeeType
    slot.noAlias = false
    return slot

fn coalescedConstraints(): alloc.RegallocTargetConstraints =
    var out = alloc.RegallocTargetConstraintsInit()
    for reg in 0..<10:
        add(out.registerUniverse, reg)
    add(out.registerUniverse, 16)
    add(out.allocatableCallerRegs, 9)
    for reg in 0..<9:
        add(out.reservedRegs, reg)
    add(out.reservedRegs, 16)
    for reg in 0..<10:
        add(out.callClobberRegs, reg)
    for reg in 0..<8:
        add(out.fixedArgRegs, reg)
    out.fixedResultReg = 0
    out.fixedSretReg = 8
    out.fixedReturnReg = 0
    out.parallelCopyScratchReg = 16
    add(out.gprTypeKinds, ir.LocalI32Tag)
    add(out.gprTypeKinds, ir.LocalI64Tag)
    add(out.gprTypeKinds, ir.LocalPtrTag)
    return out

fn buildCoalescedCopyBody(opKind: int32): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeI32Slot(0, true))
    add(body.localSlots, makeI32Slot(1, false))
    var copy: ir.BodyOp
    copy.kind = opKind
    copy.target = 1
    add(copy.operands, 0)
    add(body.ops, copy)
    var term: ir.BodyTerm
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = 1
    add(term.operands, ir.LocalI32Tag)
    let termIndex = ir.BodyIRAppendTerm(body, term)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn distinctConstraints(): alloc.RegallocTargetConstraints =
    var out = alloc.RegallocTargetConstraintsInit()
    for reg in 0..<11:
        add(out.registerUniverse, reg)
    add(out.registerUniverse, 16)
    add(out.allocatableCallerRegs, 9)
    add(out.allocatableCallerRegs, 10)
    for reg in 0..<9:
        add(out.reservedRegs, reg)
    add(out.reservedRegs, 16)
    for reg in 0..<11:
        add(out.callClobberRegs, reg)
    for reg in 0..<8:
        add(out.fixedArgRegs, reg)
    out.fixedResultReg = 0
    out.fixedSretReg = 8
    out.fixedReturnReg = 0
    out.parallelCopyScratchReg = 16
    add(out.gprTypeKinds, ir.LocalI32Tag)
    add(out.gprTypeKinds, ir.LocalI64Tag)
    add(out.gprTypeKinds, ir.LocalPtrTag)
    return out

fn buildDistinctCopyBody(opKind: int32): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeI32Slot(0, true))
    add(body.localSlots, makeI32Slot(1, false))
    add(body.localSlots, makeI32Slot(2, false))
    var copy: ir.BodyOp
    copy.kind = opKind
    copy.target = 1
    add(copy.operands, 0)
    add(body.ops, copy)
    var sum: ir.BodyOp
    sum.kind = ir.BodyOpBinOpTag
    sum.target = 2
    add(sum.operands, ir.LocalI32Tag)
    add(sum.operands, int32(texpr.TypedExprIrOpI32Add))
    add(sum.operands, 0)
    add(sum.operands, 1)
    add(body.ops, sum)
    var term: ir.BodyTerm
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = 2
    add(term.operands, ir.LocalI32Tag)
    let termIndex = ir.BodyIRAppendTerm(body, term)
    let _ = ir.BodyIRAppendBlock(body, 0, 2, termIndex)
    return body

fn buildTypedCopyBody(opKind: int32,
                      sourceType: int32,
                      targetType: int32): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeTypedSlot(0, true, sourceType))
    add(body.localSlots, makeTypedSlot(1, false, targetType))
    var copy: ir.BodyOp
    copy.kind = opKind
    copy.target = 1
    add(copy.operands, 0)
    add(body.ops, copy)
    var term: ir.BodyTerm
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = 1
    add(term.operands, targetType)
    let termIndex = ir.BodyIRAppendTerm(body, term)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn buildWriteThroughBody(opKind: int32,
                         sourceType: int32,
                         pointeeType: int32): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeTypedSlot(0, true, sourceType))
    add(body.localSlots, makeWriteThroughPtrSlot(
        1, true, pointeeType))
    var store: ir.BodyOp
    store.kind = opKind
    store.target = 1
    add(store.operands, 0)
    add(body.ops, store)
    var term: ir.BodyTerm
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = -1
    let termIndex = ir.BodyIRAppendTerm(body, term)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn writeThroughI32(out: var int32, value: int32) =
    out = value

fn writeThroughI64(out: var int64, value: int32) =
    out = int64(value)

fn coalescedActionIndex(plan: var alloc.RegallocSinglePassValuePlan): int32 =
    var found: int32 = -1
    for actionIndex in 0..<plan.actions.len:
        if plan.actions[actionIndex].kind !=
           alloc.RegallocValueActionCoalescedCopy:
            continue
        if found >= 0:
            return -2
        found = actionIndex
    return found

fn planWithCoalescedCopy(body: var ir.BodyIR): alloc.RegallocSinglePassValuePlan =
    var constraints = coalescedConstraints()
    return alloc.RegallocSinglePassValuePlanBuildDecoded(body, constraints)

fn mutationRejected(body: var ir.BodyIR, mutationKind: int32): bool =
    var plan = planWithCoalescedCopy(body)
    let actionIndex = coalescedActionIndex(plan)
    if !plan.valid || actionIndex < 0:
        return false
    if mutationKind == 1:
        plan.actions[actionIndex].otherValueId =
            plan.actions[actionIndex].valueId
    elif mutationKind == 2:
        plan.actions[actionIndex].targetReg =
            plan.actions[actionIndex].targetReg + 1
    elif mutationKind == 3:
        plan.actions[actionIndex].opIndex = body.ops.len
    elif mutationKind == 4:
        plan.actions[actionIndex].fragmentOrdinal = 0
    elif mutationKind == 5:
        plan.bodyOpOperandCounts[plan.actions[actionIndex].opIndex] = 2
    else:
        return false
    return !alloc.RegallocSinglePassValuePlanValidate(plan) && !plan.valid

fn verifyDistinctRegisterCopy(opKind: int32): int32 =
    var body = buildDistinctCopyBody(opKind)
    var constraints = distinctConstraints()
    var plan = alloc.RegallocSinglePassValuePlanBuildDecoded(body, constraints)
    if !plan.valid || !plan.frozen ||
       !alloc.RegallocSinglePassValuePlanValidate(plan):
        return 31
    if coalescedActionIndex(plan) != -1:
        return 32
    var bindIndex: int32 = -1
    for actionIndex in 0..<plan.actions.len:
        if plan.actions[actionIndex].kind ==
               alloc.RegallocValueActionBindDef &&
           plan.actions[actionIndex].opIndex == 0:
            if bindIndex >= 0:
                return 33
            bindIndex = actionIndex
    if bindIndex < 0:
        return 34
    var table = access.BodyIrAccessDecode(body)
    if !table.valid || table.opFactCounts[0] <= 0:
        return 35
    var sourceFactIndex: int32 = -1
    let factStart = table.opFactStarts[0]
    let factCount = table.opFactCounts[0]
    for factIndex in factStart..<(factStart + factCount):
        if table.facts[factIndex].kind == access.BodyIrAccessFactUse &&
           table.facts[factIndex].operandIndex == 0:
            sourceFactIndex = factIndex
    if sourceFactIndex < 0 ||
       sourceFactIndex >= plan.operandRegByFact.len:
        return 36
    let sourceReg = plan.operandRegByFact[sourceFactIndex]
    let targetReg = plan.actions[bindIndex].targetReg
    if sourceReg < 0 || targetReg < 0 || sourceReg == targetReg ||
       alloc.RegallocSinglePassValueActionBindingKind(
           plan.actions[bindIndex].kind) != alloc.RegallocValueBindingMachine:
        return 37
    let prepared = adapter.RegallocA64PrepareFunctionActionRecipes(
        body, plan)
    if !prepared.valid || bindIndex >= prepared.recipes.len ||
       bindIndex >= prepared.actionWordCounts.len:
        return 38
    let recipe = prepared.recipes[bindIndex]
    let expectedMove = a64.A64EncOrrReg(
        false, targetReg, a64.A64ZR, sourceReg)
    if recipe.bindingKind != alloc.RegallocValueBindingMachine ||
       !recipe.ownsBodyOp ||
       recipe.producerOpKind != opKind ||
       recipe.words.len != 1 || recipe.words[0] != expectedMove ||
       prepared.actionWordCounts[bindIndex] != 1:
        return 39
    var fragmentCount: int32
    for fragmentIndex in 0..<prepared.machineFragments.len:
        let fragment = prepared.machineFragments[fragmentIndex]
        if fragment.actionConsumerOrdinal == bindIndex:
            fragmentCount = fragmentCount + 1
            if fragment.wordCount != 1:
                return 40
    if fragmentCount != 1:
        return 41
    return 0

fn verifyProductionEmitter(body: var ir.BodyIR): int32 =
    var noCallTargets: str[]
    var emission = emitter.RegallocProductionEmitFunction(
        "arm64-apple-darwin",
        body, "_regalloc_coalesced_copy", 0,
        noCallTargets, noCallTargets,
        0, artifacts.RegallocProductionFunctionKindNormal)
    if !emission.valid || !emission.receipt.valid ||
       emission.recipeOrigin != "body_ir_adapter" ||
       emission.recipes.functionWords.len <= 0 ||
       emission.receipt.actionCount != emission.plan.actions.len ||
       emission.receipt.actionEmissions.len != emission.plan.actions.len:
        return 51
    let actionIndex = coalescedActionIndex(emission.plan)
    if actionIndex < 0 ||
       actionIndex >= emission.receipt.actionEmissions.len:
        return 52
    let action = emission.plan.actions[actionIndex]
    let binding = emission.receipt.actionEmissions[actionIndex]
    if action.fragmentOrdinal != -1 || action.effectSpLoad ||
       action.effectSpStore || action.effectCall ||
       action.effectX16 || action.effectX17 ||
       binding.actionKind != alloc.RegallocValueActionCoalescedCopy ||
       binding.bindingKind != alloc.RegallocValueBindingStructural ||
       binding.emittedByteStart != 0 || binding.emittedByteLength != 0 ||
       binding.emittedBytesSha256 != alloc.RegallocValueEmptySha256:
        return 53
    for fragmentIndex in 0..<emission.recipes.machineFragments.len:
        if emission.recipes.machineFragments[fragmentIndex].actionConsumerOrdinal ==
           actionIndex:
            return 54
    let selfOrr32 = a64.A64EncOrrReg(
        false, action.targetReg, a64.A64ZR, action.sourceReg)
    let selfOrr64 = a64.A64EncOrrReg(
        true, action.targetReg, a64.A64ZR, action.sourceReg)
    for wordIndex in 0..<emission.recipes.functionWords.len:
        if emission.recipes.functionWords[wordIndex] == selfOrr32 ||
           emission.recipes.functionWords[wordIndex] == selfOrr64:
            return 55
    return 0

fn verifyCrossTypeCopy(opKind: int32,
                       sourceType: int32,
                       targetType: int32,
                       structural: bool): int32 =
    var body = buildTypedCopyBody(opKind, sourceType, targetType)
    var constraints = coalescedConstraints()
    var plan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        body, constraints)
    if !plan.valid || !plan.frozen ||
       !alloc.RegallocSinglePassValuePlanValidate(plan):
        return 61
    var table = access.BodyIrAccessDecode(body)
    if !table.valid || table.opFactCounts[0] <= 0:
        return 62
    var sourceFactIndex: int32 = -1
    let factStart = table.opFactStarts[0]
    let factCount = table.opFactCounts[0]
    for factIndex in factStart..<(factStart + factCount):
        if table.facts[factIndex].kind == access.BodyIrAccessFactUse &&
           table.facts[factIndex].operandIndex == 0:
            sourceFactIndex = factIndex
    var bindIndex: int32 = -1
    for actionIndex in 0..<plan.actions.len:
        if plan.actions[actionIndex].kind ==
               alloc.RegallocValueActionBindDef &&
           plan.actions[actionIndex].opIndex == 0:
            if bindIndex >= 0:
                return 63
            bindIndex = actionIndex
    let structuralIndex = coalescedActionIndex(plan)
    if sourceFactIndex < 0 ||
       sourceFactIndex >= plan.operandRegByFact.len:
        return 64
    if structural:
        if structuralIndex < 0:
            if bindIndex >= 0 && sourceFactIndex >= 0 &&
               sourceFactIndex < plan.operandRegByFact.len:
                if plan.actions[bindIndex].targetReg ==
                   plan.operandRegByFact[sourceFactIndex]:
                    return 76
                return 75
            return 65
        if bindIndex >= 0:
            return 74
    elif structuralIndex != -1 || bindIndex < 0:
        return 66
    let actionIndex = structural ? structuralIndex : bindIndex
    let action = plan.actions[actionIndex]
    let sourceReg = plan.operandRegByFact[sourceFactIndex]
    if sourceReg < 0 || sourceReg != action.targetReg:
        return 67
    let prepared = adapter.RegallocA64PrepareFunctionActionRecipes(
        body, plan)
    if !prepared.valid || actionIndex >= prepared.recipes.len:
        return 68
    let recipe = prepared.recipes[actionIndex]
    if structural:
        if recipe.bindingKind != alloc.RegallocValueBindingStructural ||
           recipe.words.len != 0 || recipe.effectMask != 0:
            return 69
    else:
        var expectedMove: int32
        if sourceType == ir.LocalI32Tag &&
           targetType == ir.LocalI64Tag:
            expectedMove = a64.A64EncSxtw(action.targetReg, sourceReg)
        else:
            expectedMove = a64.A64EncOrrReg(
                targetType != ir.LocalI32Tag,
                action.targetReg, a64.A64ZR, sourceReg)
        if recipe.bindingKind != alloc.RegallocValueBindingMachine ||
           recipe.words.len != 1 || recipe.words[0] != expectedMove:
            return 70
    var noCallTargets: str[]
    var emission = emitter.RegallocProductionEmitFunction(
        "arm64-apple-darwin",
        body, "_regalloc_typed_copy", 0,
        noCallTargets, noCallTargets,
        0, artifacts.RegallocProductionFunctionKindNormal)
    if !emission.valid || !emission.receipt.valid:
        return 71
    let emittedStructuralIndex = coalescedActionIndex(emission.plan)
    if structural != (emittedStructuralIndex >= 0):
        return 72
    if structural:
        let binding = emission.receipt.actionEmissions[
            emittedStructuralIndex]
        if binding.bindingKind != alloc.RegallocValueBindingStructural ||
           binding.emittedByteLength != 0 ||
           binding.emittedBytesSha256 != alloc.RegallocValueEmptySha256:
            return 73
    return 0

fn verifyWriteThrough(opKind: int32,
                      sourceType: int32,
                      pointeeType: int32): int32 =
    var body = buildWriteThroughBody(
        opKind, sourceType, pointeeType)
    var table = access.BodyIrAccessDecode(body)
    if !table.valid || table.opFactCounts[0] != 3:
        return 81
    var sourceFact: int32 = -1
    var pointerFact: int32 = -1
    var memoryCount: int32
    var definitionCount: int32
    let factStart = table.opFactStarts[0]
    for factIndex in factStart..<(factStart + table.opFactCounts[0]):
        let fact = table.facts[factIndex]
        if fact.kind == access.BodyIrAccessFactUse &&
           fact.operandIndex == 0:
            sourceFact = factIndex
        elif fact.kind == access.BodyIrAccessFactUse &&
             fact.operandIndex == access.BodyIrAccessNoIndex:
            pointerFact = factIndex
        elif fact.kind == access.BodyIrAccessFactMemory:
            memoryCount = memoryCount + 1
            if fact.memoryEffect !=
               access.BodyIrAccessMemoryIndirectWrite:
                return 82
        elif fact.kind == access.BodyIrAccessFactDef:
            definitionCount = definitionCount + 1
    if sourceFact < 0 || pointerFact < 0 || memoryCount != 1 ||
       definitionCount != 0:
        return 83
    var constraints = distinctConstraints()
    var plan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        body, constraints)
    if !plan.valid || !plan.frozen ||
       !alloc.RegallocSinglePassValuePlanValidate(plan) ||
       coalescedActionIndex(plan) != -1:
        return 84
    for actionIndex in 0..<plan.actions.len:
        if plan.actions[actionIndex].opIndex == 0 &&
           plan.actions[actionIndex].kind ==
               alloc.RegallocValueActionBindDef:
            return 85
    if sourceFact >= plan.operandRegByFact.len ||
       pointerFact >= plan.operandRegByFact.len:
        return 86
    let sourceReg = plan.operandRegByFact[sourceFact]
    let pointerReg = plan.operandRegByFact[pointerFact]
    if sourceReg < 0 || pointerReg < 0 || sourceReg == pointerReg:
        return 87
    let prepared = adapter.RegallocA64PrepareFunctionActionRecipes(
        body, plan)
    if !prepared.valid || prepared.opRecipes.len <= 0 ||
       !prepared.opRecipes[0].valid ||
       prepared.opRecipes[0].machineOwnerKind !=
           contract.RegallocA64SiteOwnerOp:
        return 88
    let recipe = prepared.opRecipes[0]
    if pointeeType == ir.LocalI32Tag:
        let expected = Value(a64.A64EncStrImm(
            false, sourceReg, pointerReg, int64(0)))
        if recipe.words.len != 1 || recipe.words[0] != expected:
            return 89
    elif sourceType == ir.LocalI32Tag:
        let expectedStore = Value(a64.A64EncStrImm(
            true, a64.A64X17, pointerReg, int64(0)))
        if recipe.words.len != 2 ||
           recipe.words[0] != a64.A64EncSxtw(a64.A64X17, sourceReg) ||
           recipe.words[1] != expectedStore ||
           (recipe.effectMask & contract.RegallocA64EffectX17) == 0:
            return 90
    else:
        let expected = Value(a64.A64EncStrImm(
            true, sourceReg, pointerReg, int64(0)))
        if recipe.words.len != 1 || recipe.words[0] != expected:
            return 91
    var opFragmentCount: int32
    for fragmentIndex in 0..<prepared.machineFragments.len:
        let fragment = prepared.machineFragments[fragmentIndex]
        if fragment.ownerKind == contract.RegallocA64FragmentOwnerOp &&
           fragment.ownerOrdinal == 0:
            opFragmentCount = opFragmentCount + 1
            if fragment.wordCount != recipe.words.len:
                return 92
    if opFragmentCount != 1:
        return 93
    var noCallTargets: str[]
    var emission = emitter.RegallocProductionEmitFunction(
        "arm64-apple-darwin",
        body, "_regalloc_write_through", 0,
        noCallTargets, noCallTargets,
        0, artifacts.RegallocProductionFunctionKindNormal)
    if !emission.valid || !emission.receipt.valid:
        return 94
    return 0

fn main(): int32 =
    # B1: codegen unit composition root (dispatch fails closed without registration)
    if !adapter.RegallocA64CodegenUnitRegister():
        return 90
    let negativeI32: int32 = -123456789
    if int64(negativeI32) != int64(-123456789):
        return 10
    for opKind in ir.BodyOpLoadLocalTag..<(
            ir.BodyOpCopyLocalTag + 1):
        var body = buildCoalescedCopyBody(opKind)
        var plan = planWithCoalescedCopy(body)
        if !plan.valid || !plan.frozen ||
           !alloc.RegallocSinglePassValuePlanValidate(plan):
            return 11
        let actionIndex = coalescedActionIndex(plan)
        if actionIndex < 0:
            return 12
        let action = plan.actions[actionIndex]
        if action.opIndex != 0 || action.termIndex != -1 ||
           action.semanticKind != opKind ||
           action.valueId < 0 || action.otherValueId < 0 ||
           action.valueId == action.otherValueId ||
           action.sourceLocation != alloc.RegallocValueLocationRegister ||
           action.targetLocation != alloc.RegallocValueLocationRegister ||
           action.sourceReg < 0 || action.sourceReg != action.targetReg ||
           action.fragmentOrdinal != -1 || action.effectSpLoad ||
           action.effectSpStore || action.effectCall ||
           action.effectX16 || action.effectX17:
            return 13
        if action.valueId >= plan.valueAssignedRegs.len ||
           action.otherValueId >= plan.valueAssignedRegs.len ||
           plan.valueAssignedRegs[action.valueId] != action.targetReg ||
           plan.valueAssignedRegs[action.otherValueId] != action.sourceReg ||
           alloc.RegallocSinglePassValueActionBindingKind(action.kind) !=
               alloc.RegallocValueBindingStructural:
            return 14
        let prepared = adapter.RegallocA64PrepareFunctionActionRecipes(
            body, plan)
        if !prepared.valid || actionIndex >= prepared.recipes.len ||
           actionIndex >= prepared.actionWordCounts.len:
            return 15
        let recipe = prepared.recipes[actionIndex]
        if !recipe.valid ||
           recipe.bindingKind != alloc.RegallocValueBindingStructural ||
           recipe.words.len != 0 || recipe.relocs.len != 0 ||
           recipe.effectMask != 0 || recipe.writtenRegs.len != 0 ||
           prepared.actionWordCounts[actionIndex] != 0:
            return 16
        for fragmentIndex in 0..<prepared.machineFragments.len:
            if prepared.machineFragments[fragmentIndex].actionConsumerOrdinal ==
               actionIndex:
                return 17
        let selfOrr32 = a64.A64EncOrrReg(
            false, action.targetReg, a64.A64ZR, action.sourceReg)
        let selfOrr64 = a64.A64EncOrrReg(
            true, action.targetReg, a64.A64ZR, action.sourceReg)
        for wordIndex in 0..<prepared.functionWords.len:
            if prepared.functionWords[wordIndex] == selfOrr32 ||
               prepared.functionWords[wordIndex] == selfOrr64:
                return 18
        let productionResult = verifyProductionEmitter(body)
        if productionResult != 0:
            return productionResult
        for mutationKind in 1..<6:
            if !mutationRejected(body, mutationKind):
                return 20 + mutationKind
        let distinctResult = verifyDistinctRegisterCopy(opKind)
        if distinctResult != 0:
            return distinctResult
        var typedResult = verifyCrossTypeCopy(
            opKind, ir.LocalI32Tag, ir.LocalI64Tag, false)
        if typedResult != 0:
            return typedResult
        typedResult = verifyCrossTypeCopy(
            opKind, ir.LocalPtrTag, ir.LocalI64Tag, true)
        if typedResult != 0:
            return typedResult
        typedResult = verifyCrossTypeCopy(
            opKind, ir.LocalI64Tag, ir.LocalPtrTag, true)
        if typedResult != 0:
            return typedResult
        typedResult = verifyCrossTypeCopy(
            opKind, ir.LocalI64Tag, ir.LocalI32Tag, false)
        if typedResult != 0:
            return typedResult
        var writeResult = verifyWriteThrough(
            opKind, ir.LocalI32Tag, ir.LocalI32Tag)
        if writeResult != 0:
            return writeResult
        writeResult = verifyWriteThrough(
            opKind, ir.LocalI32Tag, ir.LocalI64Tag)
        if writeResult != 0:
            return writeResult
        writeResult = verifyWriteThrough(
            opKind, ir.LocalI64Tag, ir.LocalI64Tag)
        if writeResult != 0:
            return writeResult
        writeResult = verifyWriteThrough(
            opKind, ir.LocalPtrTag, ir.LocalI64Tag)
        if writeResult != 0:
            return writeResult
    var outI32: int32
    writeThroughI32(outI32, -77)
    if outI32 != -77:
        return 95
    var outI64: int64
    writeThroughI64(outI64, negativeI32)
    if outI64 != int64(-123456789):
        return 96
    return 0
