import std/os
import std/system
import std/strings as strings
import std/strutil as strutil

@importc("cheng_malloc")
fn ctrlHeapNew(size: int32): ptr

@importc("cheng_free")
fn ctrlHeapFree(p: ptr)

fn emitLine(label: str, value: int64) =
    os.WriteLine(os.Get_stdout(),
                 strutil.Join([label, "=", strings.Int64ToStr(value)], ""))

fn main(): int32 =
    let allocBefore = system.memAllocCount()
    let freeBefore = system.memFreeCount()
    let block = ctrlHeapNew(64)
    let allocMid = system.memAllocCount()
    ctrlHeapFree(block)
    let freeAfter = system.memFreeCount()
    emitLine("ctrl_alloc_before", allocBefore)
    emitLine("ctrl_alloc_mid", allocMid)
    emitLine("ctrl_free_before", freeBefore)
    emitLine("ctrl_free_after", freeAfter)
    emitLine("ctrl_free_delta", freeAfter - freeBefore)
    return 0
