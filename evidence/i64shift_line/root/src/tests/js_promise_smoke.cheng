import cheng/core/runtime/js_runtime as jsrt
import cheng/core/runtime/js_event_loop_runtime as eloop
import cheng/core/runtime/js_promise_runtime as jsp

fn testPromiseNew(st: var jsp.JsPromiseRuntime): int32 =
    var promise: int32
    promise = jsp.jsPromiseNew(st)
    if jsp.jsPromiseState(st, promise) != jsp.JsPromisePending:
        return 1
    if !jsp.jsPromiseIsPending(st, promise):
        return 2
    if jsp.jsPromiseIsFulfilled(st, promise):
        return 3
    if jsp.jsPromiseIsRejected(st, promise):
        return 4
    return 0

fn testPromiseResolve(st: var jsp.JsPromiseRuntime): int32 =
    var val: jsrt.JsValue
    jsrt.JsValueInitInt32(val, 42)
    var promise: int32
    promise = jsp.jsPromiseResolve(st, val)
    if jsp.jsPromiseState(st, promise) != jsp.JsPromiseFulfilled:
        return 1
    if !jsp.jsPromiseIsFulfilled(st, promise):
        return 2
    var out: jsrt.JsValue
    if !jsp.jsPromiseGetValue(st, promise, out):
        return 3
    if jsrt.JsValueInt32(out) != 42:
        return 4
    var reason: jsrt.JsValue
    if jsp.jsPromiseGetReason(st, promise, reason):
        return 5
    if !jsrt.JsValueIsUndefined(reason):
        return 6
    return 0

fn testPromiseReject(st: var jsp.JsPromiseRuntime): int32 =
    var reason: jsrt.JsValue
    jsrt.JsValueInitString(reason, "error")
    var promise: int32
    promise = jsp.jsPromiseStaticReject(st, reason)
    if jsp.jsPromiseState(st, promise) != jsp.JsPromiseRejected:
        return 1
    if !jsp.jsPromiseIsRejected(st, promise):
        return 2
    var out: jsrt.JsValue
    if !jsp.jsPromiseGetReason(st, promise, out):
        return 3
    if jsrt.JsValueString(out) != "error":
        return 4
    var value: jsrt.JsValue
    if jsp.jsPromiseGetValue(st, promise, value):
        return 5
    if !jsrt.JsValueIsUndefined(value):
        return 6
    return 0

fn testPromiseFulfill(st: var jsp.JsPromiseRuntime): int32 =
    var loop: eloop.JsEventLoop
    eloop.JsEventLoopInit(loop)
    var promise: int32
    promise = jsp.jsPromiseNew(st)
    var val: jsrt.JsValue
    jsrt.JsValueInitBool(val, true)
    jsp.jsPromiseFulfill(st, promise, val, loop)
    if jsp.jsPromiseState(st, promise) != jsp.JsPromiseFulfilled:
        return 1
    var out: jsrt.JsValue
    if !jsp.jsPromiseGetValue(st, promise, out):
        return 2
    if !jsrt.JsValueBool(out):
        return 3
    return 0

fn testPromiseRejectInternal(st: var jsp.JsPromiseRuntime): int32 =
    var loop: eloop.JsEventLoop
    eloop.JsEventLoopInit(loop)
    var promise: int32
    promise = jsp.jsPromiseNew(st)
    var reason: jsrt.JsValue
    jsrt.JsValueInitString(reason, "fail")
    jsp.jsPromiseReject(st, promise, reason, loop)
    if jsp.jsPromiseState(st, promise) != jsp.JsPromiseRejected:
        return 1
    var out: jsrt.JsValue
    if !jsp.jsPromiseGetReason(st, promise, out):
        return 2
    if jsrt.JsValueString(out) != "fail":
        return 3
    return 0

fn testPromiseThenCatch(st: var jsp.JsPromiseRuntime): int32 =
    var loop: eloop.JsEventLoop
    eloop.JsEventLoopInit(loop)
    var promise: int32
    promise = jsp.jsPromiseNew(st)
    var child1: int32
    child1 = jsp.jsPromiseThen(st, promise, 42, 0, loop)
    if jsp.jsPromiseState(st, child1) != jsp.JsPromisePending:
        return 1
    var child2: int32
    child2 = jsp.jsPromiseCatch(st, promise, 99, loop)
    if jsp.jsPromiseState(st, child2) != jsp.JsPromisePending:
        return 2
    var val: jsrt.JsValue
    jsrt.JsValueInitInt32(val, 7)
    jsp.jsPromiseFulfill(st, promise, val, loop)
    if eloop.JsEventLoopMicrotaskQueueCount(loop) != 1:
        return 3
    if !eloop.JsEventLoopRunUntilEmpty(loop, 8):
        return 4
    if eloop.JsEventLoopTraceCount(loop) != 1:
        return 5
    if eloop.JsEventLoopTraceHandlerAt(loop, 0) != 42:
        return 6
    if eloop.JsEventLoopTracePhaseAt(loop, 0) != eloop.JsEventLoopTracePhaseMicrotask:
        return 7
    return 0

fn testPromiseRejectedCatchEnqueue(st: var jsp.JsPromiseRuntime): int32 =
    var loop: eloop.JsEventLoop
    eloop.JsEventLoopInit(loop)
    var promise: int32
    promise = jsp.jsPromiseNew(st)
    var child: int32
    child = jsp.jsPromiseCatch(st, promise, 99, loop)
    if jsp.jsPromiseState(st, child) != jsp.JsPromisePending:
        return 1
    var reason: jsrt.JsValue
    jsrt.JsValueInitString(reason, "boom")
    jsp.jsPromiseReject(st, promise, reason, loop)
    if eloop.JsEventLoopMicrotaskQueueCount(loop) != 1:
        return 2
    if !eloop.JsEventLoopRunUntilEmpty(loop, 8):
        return 3
    if eloop.JsEventLoopTraceCount(loop) != 1:
        return 4
    if eloop.JsEventLoopTraceHandlerAt(loop, 0) != 99:
        return 5
    if eloop.JsEventLoopTracePhaseAt(loop, 0) != eloop.JsEventLoopTracePhaseMicrotask:
        return 6
    return 0

fn testPromiseSettledThenCatchEnqueue(st: var jsp.JsPromiseRuntime): int32 =
    var loop: eloop.JsEventLoop
    eloop.JsEventLoopInit(loop)
    var val: jsrt.JsValue
    jsrt.JsValueInitInt32(val, 11)
    var resolved: int32
    resolved = jsp.jsPromiseResolve(st, val)
    var child1: int32
    child1 = jsp.jsPromiseThen(st, resolved, 77, 0, loop)
    if jsp.jsPromiseState(st, child1) != jsp.JsPromisePending:
        return 1
    if eloop.JsEventLoopMicrotaskQueueCount(loop) != 1:
        return 2
    var reason: jsrt.JsValue
    jsrt.JsValueInitString(reason, "late")
    var rejected: int32
    rejected = jsp.jsPromiseStaticReject(st, reason)
    var child2: int32
    child2 = jsp.jsPromiseCatch(st, rejected, 88, loop)
    if jsp.jsPromiseState(st, child2) != jsp.JsPromisePending:
        return 3
    if eloop.JsEventLoopMicrotaskQueueCount(loop) != 2:
        return 4
    if !eloop.JsEventLoopRunUntilEmpty(loop, 8):
        return 5
    if eloop.JsEventLoopTraceCount(loop) != 2:
        return 6
    if eloop.JsEventLoopTraceHandlerAt(loop, 0) != 77:
        return 7
    if eloop.JsEventLoopTraceHandlerAt(loop, 1) != 88:
        return 8
    return 0

fn testDoubleSettle(st: var jsp.JsPromiseRuntime): int32 =
    var loop: eloop.JsEventLoop
    eloop.JsEventLoopInit(loop)
    var promise: int32
    promise = jsp.jsPromiseNew(st)
    var val: jsrt.JsValue
    jsrt.JsValueInitInt32(val, 1)
    jsp.jsPromiseFulfill(st, promise, val, loop)
    var val2: jsrt.JsValue
    jsrt.JsValueInitInt32(val2, 2)
    jsp.jsPromiseFulfill(st, promise, val2, loop)
    var out: jsrt.JsValue
    if !jsp.jsPromiseGetValue(st, promise, out):
        return 1
    if jsrt.JsValueInt32(out) != 1:
        return 2
    return 0

fn testRejectAfterFulfill(st: var jsp.JsPromiseRuntime): int32 =
    var loop: eloop.JsEventLoop
    eloop.JsEventLoopInit(loop)
    var promise: int32
    promise = jsp.jsPromiseNew(st)
    var val: jsrt.JsValue
    jsrt.JsValueInitInt32(val, 1)
    jsp.jsPromiseFulfill(st, promise, val, loop)
    var reason: jsrt.JsValue
    jsrt.JsValueInitString(reason, "should-be-ignored")
    jsp.jsPromiseReject(st, promise, reason, loop)
    if jsp.jsPromiseState(st, promise) != jsp.JsPromiseFulfilled:
        return 1
    return 0

fn testPromiseAwaitInt32(st: var jsp.JsPromiseRuntime): int32 =
    var val: jsrt.JsValue
    jsrt.JsValueInitInt32(val, 33)
    var promise: int32
    promise = jsp.jsPromiseResolve(st, val)
    var out: int32
    if !jsp.jsPromiseAwaitInt32(st, promise, out):
        return 1
    if out != 33:
        return 2
    return 0

fn testPromiseAwaitInt32RejectsPendingRejectedAndNonInt32(st: var jsp.JsPromiseRuntime): int32 =
    var out: int32 = 91
    var pending: int32
    pending = jsp.jsPromiseNew(st)
    if jsp.jsPromiseAwaitInt32(st, pending, out):
        return 1
    if out != 91:
        return 2
    var reason: jsrt.JsValue
    jsrt.JsValueInitString(reason, "no")
    var rejected: int32
    rejected = jsp.jsPromiseStaticReject(st, reason)
    if jsp.jsPromiseAwaitInt32(st, rejected, out):
        return 3
    if out != 91:
        return 4
    var text: jsrt.JsValue
    jsrt.JsValueInitString(text, "not-int32")
    var fulfilledText: int32
    fulfilledText = jsp.jsPromiseResolve(st, text)
    if jsp.jsPromiseAwaitInt32(st, fulfilledText, out):
        return 5
    if out != 91:
        return 6
    return 0

fn testPromiseHandlerDispatch(st: var jsp.JsPromiseRuntime): int32 =
    if !jsrt.jsRegisterChengFn(2):
        return 1
    var handler: jsrt.JsFunction
    jsrt.JsFunctionInit(handler, "promiseIdentity")
    jsrt.JsFunctionSetBodyKind(handler, jsrt.JsBodyKindChengFn)
    jsrt.JsFunctionSetChengFn(handler, 2)
    if !jsp.jsPromiseRegisterHandler(st, 7, handler):
        return 2
    if !jsp.jsPromiseRegisterHandler(st, 8, handler):
        return 3

    var loop: eloop.JsEventLoop
    eloop.JsEventLoopInit(loop)
    var value: jsrt.JsValue
    jsrt.JsValueInitInt32(value, 41)
    let resolved = jsp.jsPromiseResolve(st, value)
    let child = jsp.jsPromiseThen(st, resolved, 7, 0, loop)
    if child == jsp.JsPromiseNoChild:
        return 4
    if jsp.jsPromiseReactionJobQueueCount(st) != 1:
        return 5
    var drainOut: jsrt.JsValue
    if !jsp.jsPromiseDrainReactionJobs(st, loop, 8, drainOut):
        return 6
    if !jsp.jsPromiseIsFulfilled(st, child):
        return 7
    var childValue: jsrt.JsValue
    if !jsp.jsPromiseGetValue(st, child, childValue):
        return 8
    if !jsrt.JsValueIsInt32(childValue):
        return 9
    if jsrt.JsValueInt32(childValue) != 41:
        return 10

    var reason: jsrt.JsValue
    jsrt.JsValueInitString(reason, "boom")
    let rejected = jsp.jsPromiseStaticReject(st, reason)
    let recovered = jsp.jsPromiseCatch(st, rejected, 8, loop)
    if recovered == jsp.JsPromiseNoChild:
        return 11
    if !jsp.jsPromiseDrainReactionJobs(st, loop, 8, drainOut):
        return 12
    if !jsp.jsPromiseIsFulfilled(st, recovered):
        return 13
    var recoveredValue: jsrt.JsValue
    if !jsp.jsPromiseGetValue(st, recovered, recoveredValue):
        return 14
    if !jsrt.JsValueIsString(recoveredValue):
        return 15
    if jsrt.JsValueString(recoveredValue) != "boom":
        return 16
    return 0

fn main(): int32 =
    var st: jsp.JsPromiseRuntime
    jsp.JsPromiseRuntimeInit(st)

    var code: int32

    code = testPromiseNew(st)
    if code != 0:
        echo(Fmt"FAIL testPromiseNew: {code}")
        return code

    code = testPromiseResolve(st)
    if code != 0:
        echo(Fmt"FAIL testPromiseResolve: {code}")
        return code

    code = testPromiseReject(st)
    if code != 0:
        echo(Fmt"FAIL testPromiseReject: {code}")
        return code

    code = testPromiseFulfill(st)
    if code != 0:
        echo(Fmt"FAIL testPromiseFulfill: {code}")
        return code

    code = testPromiseRejectInternal(st)
    if code != 0:
        echo(Fmt"FAIL testPromiseRejectInternal: {code}")
        return code

    code = testPromiseThenCatch(st)
    if code != 0:
        echo(Fmt"FAIL testPromiseThenCatch: {code}")
        return code

    code = testPromiseRejectedCatchEnqueue(st)
    if code != 0:
        echo(Fmt"FAIL testPromiseRejectedCatchEnqueue: {code}")
        return code

    code = testPromiseSettledThenCatchEnqueue(st)
    if code != 0:
        echo(Fmt"FAIL testPromiseSettledThenCatchEnqueue: {code}")
        return code

    code = testDoubleSettle(st)
    if code != 0:
        echo(Fmt"FAIL testDoubleSettle: {code}")
        return code

    code = testRejectAfterFulfill(st)
    if code != 0:
        echo(Fmt"FAIL testRejectAfterFulfill: {code}")
        return code

    code = testPromiseAwaitInt32(st)
    if code != 0:
        echo(Fmt"FAIL testPromiseAwaitInt32: {code}")
        return code

    code = testPromiseAwaitInt32RejectsPendingRejectedAndNonInt32(st)
    if code != 0:
        echo(Fmt"FAIL testPromiseAwaitInt32RejectsPendingRejectedAndNonInt32: {code}")
        return code

    code = testPromiseHandlerDispatch(st)
    if code != 0:
        echo(Fmt"FAIL testPromiseHandlerDispatch: {code}")
        return code

    echo(" js_promise_smoke ok")
    return 0
