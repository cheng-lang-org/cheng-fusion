import std/cmdline
import std/os
import std/strutils as strutil
import std/os_host_process as hostos
import cheng/std/bytes_layout as layout
import cheng/core/lang/parser as parser
import cheng/core/tooling/compiler_request as creq
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/tooling/compiler_csg_production_lifetime as csglife
import cheng/core/tooling/compiler_payload_lifecycle as compilerlife
import cheng/core/tooling/path as chengpath
import cheng/core/backend/lowering_plan as lower
import cheng/core/backend/system_link_plan as slplan
import cheng/core/backend/system_link_exec as sexec
import cheng/core/backend/system_link_exec_runtime as sexecrt

fn LifecycleEnvKeyCount(env: str[], key: str): int32 =
    let prefix = Fmt"{key}="
    var count: int32
    for i in 0..<env.len:
        let item = env[i]
        if strutil.StartsWith(item, prefix):
            count = count + 1
    return count

fn LifecycleEnvValue(env: str[], key: str): str =
    let prefix = Fmt"{key}="
    for i in 0..<env.len:
        let item = env[i]
        if strutil.StartsWith(item, prefix):
            return chengpath.TextSlice(item,
                                       len(prefix),
                                       len(item) - len(prefix))
    return ""

fn LifecycleMoveOnlyState(): sexec.SystemLinkExecPayloadLifecycle =
    var lifecycle: sexec.SystemLinkExecPayloadLifecycle
    lifecycle.systemLinkExprMoveCount = 1
    lifecycle.systemLinkExprCloneCount = 0
    return lifecycle

fn LifecycleApply(lifecycle: var sexec.SystemLinkExecPayloadLifecycle,
                  transition: sexec.SystemLinkExecPayloadTransition,
                  label: str) =
    var err: str
    assert(sexec.SystemLinkExecPayloadLifecycleCanTransition(lifecycle,
                                                             transition,
                                                             err),
           label)
    assert(len(err) == 0, " lifecycle state: success retained error")
    sexec.SystemLinkExecPayloadLifecycleTransition(lifecycle, transition)

fn LifecycleReject(lifecycle: var sexec.SystemLinkExecPayloadLifecycle,
                   transition: sexec.SystemLinkExecPayloadTransition,
                   label: str) =
    var err: str
    assert(!sexec.SystemLinkExecPayloadLifecycleTryTransition(lifecycle,
                                                              transition,
                                                              err),
           label)
    assert(len(err) > 0, " lifecycle state: rejection missing reason")

fn LifecycleAssertSuccessCounts(
        lifecycle: sexec.SystemLinkExecPayloadLifecycle) =
    assert(lifecycle.systemLinkExprMoveCount == 1 &&
           lifecycle.systemLinkExprCloneCount == 0 &&
           lifecycle.systemLinkExprConsumeCount == 1,
           " lifecycle state: expression ownership counts")
    assert(lifecycle.compilerCsgBackendReleaseCount == 1 &&
           lifecycle.loweringPrePrimaryReleaseCount == 1 &&
           lifecycle.loweringAfterPrimaryReleaseCount == 1 &&
           lifecycle.loweringTerminalReleaseCount == 1,
           " lifecycle state: compiler and lowering release counts")
    assert(lifecycle.runtimeUnusedReleaseCount == 1 &&
           lifecycle.primaryBodyIrReleaseCount == 1 &&
           lifecycle.providerPayloadReleaseCount == 1 &&
           lifecycle.nativePayloadReleaseCount == 1,
           " lifecycle state: runtime release counts")

fn LifecycleEarlyReleaseHardFailChild(): int32 =
    var lifecycle = LifecycleMoveOnlyState()
    sexec.SystemLinkExecPayloadLifecycleTransition(
        lifecycle,
        sexec.SystemLinkExecPayloadReleaseCompilerCsgBackend)
    return 3

fn LifecycleDuplicateReleaseHardFailChild(): int32 =
    var lifecycle = LifecycleMoveOnlyState()
    sexec.SystemLinkExecPayloadLifecycleTransition(
        lifecycle,
        sexec.SystemLinkExecPayloadConsumeSystemLinkExpr)
    sexec.SystemLinkExecPayloadLifecycleTransition(
        lifecycle,
        sexec.SystemLinkExecPayloadConsumeSystemLinkExpr)
    return 3

fn LifecycleDuplicateAbortReleaseHardFailChild(): int32 =
    var linkPlan: slplan.SystemLinkPlanStub
    var expr: parser.NormalizedExpr
    add(linkPlan.exprLayer.exprs, expr)
    var owned = true
    sexec.SystemLinkExecReleaseSystemLinkCompilerInputOnAbort(linkPlan, owned)
    sexec.SystemLinkExecReleaseSystemLinkCompilerInputOnAbort(linkPlan, owned)
    return 3

fn LifecycleSourceBundleReceipt(
        receipt: var sexec.SystemLinkExecSourceBundleReceipt) =
    receipt = sexec.SystemLinkExecSourceBundleReceipt()
    receipt.entrySourceIndex = 0
    var sourceBundleCid: layout.FixedBytes32
    sourceBundleCid.data[0] = uint8(1)
    receipt.sourceBundleCid = sourceBundleCid
    var entrySourceCid: layout.FixedBytes32
    entrySourceCid.data[0] = uint8(7)
    receipt.entrySourceCid = entrySourceCid
    var importGraphCid: layout.FixedBytes32
    importGraphCid.data[0] = uint8(8)
    receipt.importGraphCid = importGraphCid
    var bindingSeal: layout.FixedBytes32
    bindingSeal.data[0] = uint8(2)
    receipt.bindingSeal = bindingSeal
    # identityKind 已删除; entry 身份封禁收敛为 (packageId, modulePath,
    # sourceBundleCid, bindingSeal) 四参。
    receipt.entryIdentitySeal =
        sexec.SystemLinkExecSourceBundleEntryIdentitySeal(
            "cheng",
            "cheng/tests/entry",
            receipt.sourceBundleCid,
            receipt.bindingSeal)
    receipt.sourceClosureCount = 1
    receipt.sourceIdentityCount = 1
    receipt.ownerModuleCount = 1
    receipt.importEdgeCount = 0
    receipt.unresolvedImportCount = 0
    # 新 receipt 还带 portable source identity 三列 (packageId/entryModule/
    # receipt cid), 缺列即「seal is missing」; 经 MakeInto 取得一致身份。
    var sourceReceipt: ccsg.PortableSourceIdentityReceipt
    var makeErr: str
    let makeOk = ccsg.PortableSourceIdentityReceiptMakeInto(
        receipt.sourceClosureCount,
        receipt.importEdgeCount,
        receipt.unresolvedImportCount,
        "cheng",
        "cheng/tests/entry",
        receipt.sourceBundleCid,
        receipt.entrySourceCid,
        receipt.importGraphCid,
        sourceReceipt,
        makeErr)
    assert(makeOk, makeErr)
    receipt.sourcePackageIdCid = sourceReceipt.sourcePackageIdCid
    receipt.entryModulePathCid = sourceReceipt.entryModulePathCid
    receipt.sourceIdentityReceiptCid = sourceReceipt.receiptCid
    receipt.receiptSeal =
        sexec.SystemLinkExecSourceBundleReceiptComputeSeal(receipt)
    var err: str
    assert(sexec.SystemLinkExecSourceBundleReceiptValidInto(receipt, err) &&
           len(err) == 0,
           Fmt" lifecycle state: source bundle receipt fixture size={sexec.SystemLinkExecSourceBundleReceiptFixedLiveBytes()} err={err}")

# 终态释放必须从真实生产构建取得全部 owner receipt。测试不再手工摆
# lifecycle 计数或合成空 lowering/primary payload。
fn LifecyclePrepareRuntimePlan(plan: var sexec.SystemLinkExecPlan) =
    let root = "/tmp/system_link_payload_lifecycle_state_smoke"
    let sourceDir = Fmt"{root}/src"
    let entryPath = Fmt"{sourceDir}/main.cheng"
    os.MkdirAll(sourceDir, 493)
    os.WriteFile(Fmt"{root}/cheng-package.toml",
                 "package_id = \"pkg://cheng/system-link-payload-lifecycle\"\n")
    os.WriteFile(entryPath,
                 "fn Root(): int32 =\n    return 7\n")
    let base = creq.CompilerRequestNew(root,
                                       entryPath,
                                       Fmt"{root}/lifecycle.o",
                                       "arm64-apple-darwin",
                                       creq.EmitObj,
                                       "")
    var request = creq.CompilerRequestWithExportRootSymbols(base, ["Root"])
    creq.CompilerRequestSeal(request)
    let planRes = sexec.BuildSystemLinkExecPlan(root, request)
    assert(planRes.ok, planRes.err.msg)
    plan = planRes.value

fn LifecycleAssertCompilerCsgLifetimePrepared(
        plan: var sexec.SystemLinkExecPlan) =
    let loweringReleasedBufferCount =
        lower.LoweringPlanCompilerCsgReleasedBufferCount(
            plan.loweringPlan)
    let loweringReleasedBytes =
        lower.LoweringPlanCompilerCsgReleasedBytes(
            plan.loweringPlan)
    let residualBufferCount =
        ccsg.CompilerCsgLifecycleTrackedPhysicalBufferCount(
            plan.compilerCsg)
    let residualBytes =
        ccsg.CompilerCsgLifecycleRetainedBytes(
            plan.compilerCsg)
    assert(plan.compilerCsgProductionLifetime.active &&
           plan.compilerCsgProductionLifetime.lifecycle.movedToConsumer &&
           !plan.compilerCsgLifetimeReceiptReady &&
           lower.LoweringPlanCompilerCsgReleaseReceiptComplete(
               plan.loweringPlan) &&
           plan.loweringPlan.compilerCsgLifecycleInitialBufferCount ==
               loweringReleasedBufferCount + residualBufferCount &&
           plan.loweringPlan.compilerCsgLifecycleInitialBytes ==
               loweringReleasedBytes + residualBytes,
           " lifecycle state: CompilerCSG moved partition")

fn LifecycleAssertOwnerTableLifetimeClosed(
        receipt: sexec.SystemLinkExecPayloadFinalizeReceipt,
        expectedOutcome: int32) =
    let ownerTableReleasedBytes =
        receipt.ownerTableReleasedBytes
    var lifetimeReceipt = receipt.ownerTableLifetimeReceipt
    assert(
        compilerlife.CompilerPayloadLifecycleReceiptClosed(
            lifetimeReceipt) &&
        lifetimeReceipt.outcome == expectedOutcome &&
        lifetimeReceipt.allocated == int64(1) &&
        lifetimeReceipt.released == int64(1) &&
        lifetimeReceipt.live == int64(0) &&
        lifetimeReceipt.allocatedBytes ==
            ownerTableReleasedBytes &&
        lifetimeReceipt.releasedBytes ==
            ownerTableReleasedBytes &&
        lifetimeReceipt.liveBytes == int64(0) &&
        lifetimeReceipt.retained == int64(1) &&
        lifetimeReceipt.borrowReturnCount == int64(1) &&
        lifetimeReceipt.ownerTransferCount == int64(1) &&
        lifetimeReceipt.physicalBufferCount == 1 &&
        lifetimeReceipt.physicalFreeCount == int64(1) &&
        lifetimeReceipt.storageReleased &&
        lifetimeReceipt.ledgerStorageReleased,
        " lifecycle state: owner table lifetime receipt")

fn LifecycleSourceBundleReceiptSmoke() =
    var receipt: sexec.SystemLinkExecSourceBundleReceipt
    LifecycleSourceBundleReceipt(receipt)
    assert(sexec.SystemLinkExecSourceBundleReceiptFixedBytes == int64(312),
           " lifecycle state: source bundle receipt fixed bytes")
    assert(sexec.SystemLinkExecSourceBundleReceiptFixedLiveBytes() ==
               sexec.SystemLinkExecSourceBundleReceiptFixedBytes,
           " lifecycle state: source bundle receipt fixed ABI bytes")

    receipt.sourceIdentityCount = 2
    var err: str
    assert(!sexec.SystemLinkExecSourceBundleReceiptValidInto(receipt,
                                                             err) &&
           strutil.Contains(err, "column counts mismatch"),
           " lifecycle state: source bundle receipt count tamper accepted")
    receipt.sourceIdentityCount = 1

    let originalSourceBundleCidByte = receipt.sourceBundleCid.data[0]
    receipt.sourceBundleCid.data[0] = uint8(3)
    assert(!sexec.SystemLinkExecSourceBundleReceiptValidInto(receipt, err) &&
           strutil.Contains(err, "scalar seal mismatch"),
           " lifecycle state: source bundle receipt cid tamper accepted")
    receipt.sourceBundleCid.data[0] = originalSourceBundleCidByte

    # report 在 readyCode==1 时先过完整 CID 严格链; 手工合成 plan 造不出
    # parserNormalizedExprReceipt/localUniverse, 必须走真 CSG fixture (见
    # LifecyclePrepareRuntimePlan)。单文件无 import 的包给出 closure/
    # identity/owner=1, import_edge/unresolved=0, entry_source_index=0。
    var reportPlan: sexec.SystemLinkExecPlan
    LifecyclePrepareRuntimePlan(reportPlan)
    let report = sexec.SystemLinkExecPlanReportBorrowed(reportPlan)
    let receiptCidHex =
        layout.FixedBytes32Hex(reportPlan.sourceBundleReceipt.sourceBundleCid)
    # report 已去 identityKind 行 (逐行自动分流后无 kind 标量);
    # 反向断言该行不再出现, 正向断言其余 sealed 列。
    assert(strutil.Contains(report,
                            Fmt"source_bundle_cid={receiptCidHex}\n") &&
           strutil.Contains(report,
                            Fmt"source_manifest_sha256={receiptCidHex}\n") &&
           !strutil.Contains(report,
                             "source_bundle_identity_kind=") &&
           strutil.Contains(report,
                            "source_bundle_entry_source_index=0\n") &&
           strutil.Contains(report,
                            "source_bundle_closure_count=1\n") &&
           strutil.Contains(report,
                            "source_bundle_identity_count=1\n") &&
           strutil.Contains(report,
                            "source_bundle_owner_count=1\n") &&
           strutil.Contains(report,
                            "source_bundle_import_edge_count=0\n") &&
           strutil.Contains(report,
                            "source_bundle_unresolved_import_count=0\n") &&
           strutil.Contains(report,
                            "source_bundle_receipt_fixed_bytes=312\n") &&
           strutil.Contains(report,
                            "source_bundle_entry_identity_seal=") &&
           strutil.Contains(report,
                            "source_bundle_receipt_managed_live_bytes=0\n"),
           " lifecycle state: source bundle report receipt scalars")

    # 旧 fixture 曾用「receipt cid != compilerCsg.sourceBundleCid」反向验证
    # source_manifest_sha256 不取自 compiler csg 侧; 真 plan 中二者同值,
    # 该区分已无对应物。等价严格性负向断言: 篡改 compilerCsg 侧
    # sourceBundleCid 的 plan 必须被 CID 严格链拒绝 (report 就绪态门即此链)。
    let originalCompilerCidByte =
        reportPlan.compilerCsg.sourceBundleCid.data[0]
    if originalCompilerCidByte == uint8(0):
        reportPlan.compilerCsg.sourceBundleCid.data[0] = uint8(1)
    else:
        reportPlan.compilerCsg.sourceBundleCid.data[0] = uint8(0)
    var chainTamperErr: str
    assert(!sexec.SystemLinkExecPlanCidChainStrictValidateInto(
               reportPlan,
               chainTamperErr) &&
           len(chainTamperErr) > 0,
           " lifecycle state: compiler csg cid tamper passed strict chain")
    reportPlan.compilerCsg.sourceBundleCid.data[0] =
        originalCompilerCidByte
    var reportBeginErr: str
    assert(sexec.SystemLinkExecPlanBeginExecution(
               reportPlan, reportBeginErr), reportBeginErr)
    sexecrt.SystemLinkExecRuntimeFinalize(
        reportPlan, false, "fixture report plan release")

fn LifecycleDuplicateRuntimeOwnerReleaseHardFailChild(): int32 =
    var plan: sexec.SystemLinkExecPlan
    LifecyclePrepareRuntimePlan(plan)
    var beginErr: str
    assert(sexec.SystemLinkExecPlanBeginExecution(plan, beginErr),
           " lifecycle state: runtime owner fixture did not begin")
    var ownerToken: layout.FixedBytes32
    ownerToken.data[0] = uint8(1)
    sexec.SystemLinkExecPlanRecordOwnerReleaseReceipt(
        plan,
        sexec.SystemLinkExecOwnerKindLowering,
        ownerToken,
        0,
        0,
        int64(0))
    sexec.SystemLinkExecPlanRecordOwnerReleaseReceipt(
        plan,
        sexec.SystemLinkExecOwnerKindLowering,
        ownerToken,
        0,
        0,
        int64(0))
    return 3

fn LifecycleRequireChildHardFail(mode: str, messagePart: str) =
    let selfPath = cmdline.ParamStr(0)
    let result = hostos.ExecFileCapture(selfPath, [mode], [], "", true, 60)
    assert(os.ExecCmdResultExitCode(result) == 1,
           " lifecycle state: rejected transition did not hard-fail")
    assert(strutil.Contains(os.ExecCmdResultOutput(result), messagePart),
           " lifecycle state: rejected transition panic reason")

fn LifecycleTransitionHardFailSmoke() =
    LifecycleRequireChildHardFail(
        "early-release",
        "CompilerCSG backend release before expression payload consumption")
    LifecycleRequireChildHardFail(
        "duplicate-release",
        "system-link expression payload consumed more than once")
    LifecycleRequireChildHardFail(
        "duplicate-abort-release",
        "system-link compiler input abort release without ownership")
    LifecycleRequireChildHardFail(
        "duplicate-runtime-owner-release",
        "invalid or duplicate terminal owner receipt")

fn LifecycleStateTransitionSmoke() =
    var invalidOwnership: sexec.SystemLinkExecPayloadLifecycle
    LifecycleReject(invalidOwnership,
                    sexec.SystemLinkExecPayloadConsumeSystemLinkExpr,
                    " lifecycle state: expression consume without move accepted")
    assert(invalidOwnership.systemLinkExprConsumeCount == 0,
           " lifecycle state: rejected ownership transition mutated state")

    var early = LifecycleMoveOnlyState()
    LifecycleReject(early,
                    sexec.SystemLinkExecPayloadReleaseCompilerCsgBackend,
                    " lifecycle state: early CompilerCSG release accepted")
    assert(early.compilerCsgBackendReleaseCount == 0,
           " lifecycle state: rejected CompilerCSG transition mutated state")
    LifecycleReject(early,
                    sexec.SystemLinkExecPayloadReleaseLoweringTerminal,
                    " lifecycle state: early terminal release accepted")
    assert(early.loweringTerminalReleaseCount == 0,
           " lifecycle state: rejected terminal transition mutated state")

    var duplicate = LifecycleMoveOnlyState()
    LifecycleApply(duplicate,
                   sexec.SystemLinkExecPayloadConsumeSystemLinkExpr,
                   " lifecycle state: initial expression consume")
    LifecycleReject(duplicate,
                    sexec.SystemLinkExecPayloadConsumeSystemLinkExpr,
                    " lifecycle state: duplicate expression consume accepted")
    assert(duplicate.systemLinkExprConsumeCount == 1,
           " lifecycle state: duplicate transition changed count")

    var lifecycle = LifecycleMoveOnlyState()
    LifecycleApply(lifecycle,
                   sexec.SystemLinkExecPayloadConsumeSystemLinkExpr,
                   " lifecycle state: expression consume")
    LifecycleApply(lifecycle,
                   sexec.SystemLinkExecPayloadReleaseCompilerCsgBackend,
                   " lifecycle state: CompilerCSG release")
    LifecycleApply(lifecycle,
                   sexec.SystemLinkExecPayloadReleaseLoweringPrePrimary,
                   " lifecycle state: lowering pre-primary release")
    LifecycleApply(lifecycle,
                   sexec.SystemLinkExecPayloadReleaseLoweringAfterPrimary,
                   " lifecycle state: lowering post-primary release")
    LifecycleApply(lifecycle,
                   sexec.SystemLinkExecPayloadReleaseRuntimeUnused,
                   " lifecycle state: runtime-unused release")
    LifecycleApply(lifecycle,
                   sexec.SystemLinkExecPayloadReleasePrimaryBodyIr,
                   " lifecycle state: primary BodyIR release")
    LifecycleApply(lifecycle,
                   sexec.SystemLinkExecPayloadReleaseProvider,
                   " lifecycle state: provider release")
    LifecycleApply(lifecycle,
                   sexec.SystemLinkExecPayloadReleaseNative,
                   " lifecycle state: native release")

    var plan: sexec.SystemLinkExecPlan
    plan.payloadLifecycle = lifecycle
    plan.loweringPlan.entryPath = "terminal-owner.cheng"
    plan.loweringPlan.compilerCsgBackendPayloadReleased = true
    plan.loweringPlan.primaryObjectIrFunctionCountSnapshot = 7
    add(plan.loweringPlan.functionNames, "terminal-owner")
    add(plan.loweringPlan.missingReasons, "terminal-diagnostic")
    let terminalBeforeBytes =
        lower.LoweringPlanStructuredLiveBytes(plan.loweringPlan)
    assert(terminalBeforeBytes > int64(0),
           " lifecycle state: terminal fixture has no structured payload")
    lower.LoweringPlanReleaseAllPayload(plan.loweringPlan)
    LifecycleApply(plan.payloadLifecycle,
                   sexec.SystemLinkExecPayloadReleaseLoweringTerminal,
                   " lifecycle state: lowering terminal release")
    assert(plan.loweringPlan.functionNames.len == 0 &&
           plan.loweringPlan.missingReasons.len == 0 &&
           len(plan.loweringPlan.entryPath) == 0 &&
           !plan.loweringPlan.compilerCsgBackendPayloadReleased &&
           plan.loweringPlan.primaryObjectIrFunctionCountSnapshot == 0,
           " lifecycle state: terminal lowering owner not zeroed")
    assert(lower.LoweringPlanStructuredLiveBytes(plan.loweringPlan) == int64(0),
           " lifecycle state: terminal structured bytes not zero")
    LifecycleAssertSuccessCounts(plan.payloadLifecycle)
    LifecycleReject(plan.payloadLifecycle,
                    sexec.SystemLinkExecPayloadReleaseLoweringTerminal,
                    " lifecycle state: duplicate terminal release accepted")
    assert(plan.payloadLifecycle.loweringTerminalReleaseCount == 1,
           " lifecycle state: duplicate terminal changed count")

fn LifecycleAbortOwnerSmoke() =
    var linkPlan: slplan.SystemLinkPlanStub
    var expr: parser.NormalizedExpr
    expr.exprId = "abort-owner"
    add(linkPlan.exprLayer.exprs, expr)
    add(linkPlan.exprLayer.exprNext, -1)
    linkPlan.exprLayer.sourceCount = 1
    linkPlan.sourceBundleEntrySourceIndex = 0
    add(linkPlan.sourceBundleIdentityPaths, "abort-owner")
    add(linkPlan.sourceClosurePaths, "abort-owner.cheng")
    add(linkPlan.ownerModulePaths, "abort-owner")
    add(linkPlan.runtimeTargets, "abort-runtime")
    var linkPlanOwned = true
    sexec.SystemLinkExecReleaseSystemLinkCompilerInputOnAbort(linkPlan,
                                                              linkPlanOwned)
    assert(!linkPlanOwned &&
           linkPlan.exprLayer.sourceCount == 0 &&
           linkPlan.exprLayer.exprs.len == 0 &&
           linkPlan.exprLayer.exprNext.len == 0 &&
           linkPlan.sourceBundleEntrySourceIndex == -1 &&
           linkPlan.sourceBundleIdentityPaths.len == 0 &&
           linkPlan.sourceClosurePaths.len == 0 &&
           linkPlan.ownerModulePaths.len == 0 &&
           linkPlan.runtimeTargets.len == 0,
           " lifecycle state: system-link abort owner retained payload")

    var compilerCsg: ccsg.CompilerCsg
    var node: ccsg.CompilerCsgNode
    add(compilerCsg.nodes, node)
    compilerCsg.nodeCount = 1
    var loweringPlan: lower.LoweringPlanStub
    add(loweringPlan.functionNames, "abort-lowering-owner")
    assert(!lower.LoweringAbortCompilerCsgBind(compilerCsg, loweringPlan),
           " lifecycle state: lowering abort returned success")
    assert(compilerCsg.nodes.len == 0 && compilerCsg.nodeCount == 0,
           " lifecycle state: CompilerCSG abort owner retained payload")
    assert(loweringPlan.compilerCsgBackendPayloadReleased &&
           lower.LoweringPlanStructuredLiveBytes(loweringPlan) == int64(0),
           " lifecycle state: lowering abort owner retained payload")

fn LifecycleRuntimeFinalizerSmoke() =
    var plan: sexec.SystemLinkExecPlan
    LifecyclePrepareRuntimePlan(plan)
    LifecycleAssertCompilerCsgLifetimePrepared(plan)
    let abortCompilerCsgInitialBufferCount =
        plan.loweringPlan.compilerCsgLifecycleInitialBufferCount
    let abortCompilerCsgInitialBytes =
        plan.loweringPlan.compilerCsgLifecycleInitialBytes
    let executionTokenId = plan.allocationOwnerLedger.executionTokenId
    var abortBeginErr: str
    assert(sexec.SystemLinkExecPlanBeginExecution(plan, abortBeginErr) &&
           len(abortBeginErr) == 0,
           " lifecycle state: abort owner fixture did not begin")
    sexecrt.SystemLinkExecRuntimeFinalize(
        plan, false, "fixture requested abort after begin")
    let receipt = plan.payloadFinalizeReceipt
    assert(receipt.executionTokenId == executionTokenId &&
           receipt.terminalState == sexec.SystemLinkExecExecutionAborted &&
           receipt.aborted && !receipt.completed &&
           receipt.reasonCode == 2 &&
           !layout.FixedBytes32Equal(
               receipt.reasonCid, layout.FixedBytes32()),
           " lifecycle state: abort terminal receipt")
    assert(receipt.requiredOwnerCount ==
               sexec.SystemLinkExecRequiredOwnerCount &&
           receipt.terminalOwnerCount ==
               sexec.SystemLinkExecRequiredOwnerCount &&
           receipt.receiptCount ==
               sexec.SystemLinkExecRequiredOwnerCount &&
           receipt.duplicateReceiptCount == 0 &&
           receipt.ownerTableStorageReleased,
           " lifecycle state: abort owner coverage")
    LifecycleAssertOwnerTableLifetimeClosed(
        receipt,
        compilerlife.CompilerPayloadOutcomeDiagnostic)
    assert(plan.compilerCsgLifetimeReceiptReady &&
           csglife.CompilerCsgProductionLifetimeReceiptClosed(
               plan.compilerCsgLifetimeReceipt) &&
           plan.compilerCsgLifetimeReceipt.outcome ==
               compilerlife.CompilerPayloadOutcomeDiagnostic &&
           plan.compilerCsgLifetimeReceipt.physicalBufferCount ==
               abortCompilerCsgInitialBufferCount &&
           plan.compilerCsgLifetimeReceipt.releasedBytes ==
               abortCompilerCsgInitialBytes,
           " lifecycle state: abort CompilerCSG lifetime")
    assert(sexec.SystemLinkExecPlanRetainedPayloadDiagnosticEstimateBytes(plan) == int64(0),
           " lifecycle state: abort retained execution payload")

    var secondResult: sexecrt.SystemLinkExecRuntimeResult
    var secondErr: str
    assert(!sexecrt.SystemLinkExecRuntimeExecutePlanWithCompilerInto(
               secondResult,
               secondErr,
               os.GetCurrentDir(),
               plan,
               cmdline.ParamStr(0)) &&
           strutil.Contains(secondErr, "execution token is not reusable"),
           " lifecycle state: finalized plan was reusable")
    assert(plan.payloadFinalizeReceipt.executionTokenId == executionTokenId &&
           plan.payloadFinalizeReceipt.receiptCount ==
               sexec.SystemLinkExecRequiredOwnerCount &&
           plan.payloadFinalizeReceipt.duplicateReceiptCount == 0,
           " lifecycle state: rejected reuse changed receipt")

    var completedPlan: sexec.SystemLinkExecPlan
    LifecyclePrepareRuntimePlan(completedPlan)
    LifecycleAssertCompilerCsgLifetimePrepared(completedPlan)
    let completedCompilerCsgInitialBufferCount =
        completedPlan.loweringPlan.compilerCsgLifecycleInitialBufferCount
    let completedCompilerCsgInitialBytes =
        completedPlan.loweringPlan.compilerCsgLifecycleInitialBytes
    let completedTokenId = completedPlan.allocationOwnerLedger.executionTokenId
    var completedBeginErr: str
    assert(sexec.SystemLinkExecPlanBeginExecution(completedPlan,
                                                  completedBeginErr) &&
           len(completedBeginErr) == 0,
           " lifecycle state: completed owner fixture did not begin")
    sexecrt.SystemLinkExecRuntimeFinalize(completedPlan, true, "")
    let completedReceipt = completedPlan.payloadFinalizeReceipt
    assert(completedReceipt.executionTokenId == completedTokenId &&
           completedReceipt.terminalState ==
               sexec.SystemLinkExecExecutionCompleted &&
           completedReceipt.completed && !completedReceipt.aborted &&
           completedReceipt.reasonCode == 1 &&
           !layout.FixedBytes32Equal(
               completedReceipt.reasonCid, layout.FixedBytes32()),
           " lifecycle state: completed terminal receipt")
    assert(completedReceipt.requiredOwnerCount ==
               sexec.SystemLinkExecRequiredOwnerCount &&
           completedReceipt.terminalOwnerCount ==
               sexec.SystemLinkExecRequiredOwnerCount &&
           completedReceipt.receiptCount ==
               sexec.SystemLinkExecRequiredOwnerCount &&
           completedReceipt.duplicateReceiptCount == 0 &&
           completedReceipt.ownerTableStorageReleased &&
           sexec.SystemLinkExecPlanRetainedPayloadDiagnosticEstimateBytes(
               completedPlan) == int64(0),
           " lifecycle state: completed owner coverage")
    LifecycleAssertOwnerTableLifetimeClosed(
        completedReceipt,
        compilerlife.CompilerPayloadOutcomeSuccess)
    assert(completedPlan.compilerCsgLifetimeReceiptReady &&
           csglife.CompilerCsgProductionLifetimeReceiptClosed(
               completedPlan.compilerCsgLifetimeReceipt) &&
           completedPlan.compilerCsgLifetimeReceipt.outcome ==
               compilerlife.CompilerPayloadOutcomeSuccess &&
           completedPlan.compilerCsgLifetimeReceipt.physicalBufferCount ==
               completedCompilerCsgInitialBufferCount &&
           completedPlan.compilerCsgLifetimeReceipt.releasedBytes ==
               completedCompilerCsgInitialBytes,
           " lifecycle state: completed CompilerCSG lifetime")

fn LifecycleRuntimeBeginFailureDiscardSmoke() =
    var notReadyPlan: sexec.SystemLinkExecPlan
    LifecyclePrepareRuntimePlan(notReadyPlan)
    notReadyPlan.readyCode = 0
    var notReadyResult: sexecrt.SystemLinkExecRuntimeResult
    var notReadyErr: str
    assert(!sexecrt.SystemLinkExecRuntimeExecutePlanWithCompilerInto(
               notReadyResult,
               notReadyErr,
               os.GetCurrentDir(),
               notReadyPlan,
               cmdline.ParamStr(0)) &&
           len(notReadyErr) > 0 &&
           notReadyPlan.compilerCsgLifetimeReceiptReady &&
           csglife.CompilerCsgProductionLifetimeReceiptClosed(
               notReadyPlan.compilerCsgLifetimeReceipt) &&
           notReadyPlan.compilerCsgLifetimeReceipt.outcome ==
               compilerlife.CompilerPayloadOutcomeDiagnostic &&
           notReadyPlan.payloadFinalizeReceipt.aborted &&
           notReadyPlan.payloadFinalizeReceipt.ownerTableStorageReleased,
           " lifecycle state: not-ready begin failure leaked")
    LifecycleAssertOwnerTableLifetimeClosed(
        notReadyPlan.payloadFinalizeReceipt,
        compilerlife.CompilerPayloadOutcomeDiagnostic)

    var cidDriftPlan: sexec.SystemLinkExecPlan
    LifecyclePrepareRuntimePlan(cidDriftPlan)
    cidDriftPlan.sourceToCsgBindingSeal.data[0] =
        cidDriftPlan.sourceToCsgBindingSeal.data[0] ^ uint8(1)
    var cidDriftResult: sexecrt.SystemLinkExecRuntimeResult
    var cidDriftErr: str
    assert(!sexecrt.SystemLinkExecRuntimeExecutePlanWithCompilerInto(
               cidDriftResult,
               cidDriftErr,
               os.GetCurrentDir(),
               cidDriftPlan,
               cmdline.ParamStr(0)) &&
           len(cidDriftErr) > 0 &&
           cidDriftPlan.compilerCsgLifetimeReceiptReady &&
           csglife.CompilerCsgProductionLifetimeReceiptClosed(
               cidDriftPlan.compilerCsgLifetimeReceipt) &&
           cidDriftPlan.compilerCsgLifetimeReceipt.outcome ==
               compilerlife.CompilerPayloadOutcomeDiagnostic &&
           cidDriftPlan.payloadFinalizeReceipt.aborted &&
           cidDriftPlan.payloadFinalizeReceipt.ownerTableStorageReleased,
           " lifecycle state: CID begin failure leaked")
    LifecycleAssertOwnerTableLifetimeClosed(
        cidDriftPlan.payloadFinalizeReceipt,
        compilerlife.CompilerPayloadOutcomeDiagnostic)

fn LifecycleProviderCompilerOverrideSmoke() =
    let root = os.GetCurrentDir()
    let selfPath = chengpath.PathAbsolute(root, cmdline.ParamStr(0))
    assert(chengpath.FileExistsNonEmpty(root, selfPath),
           " lifecycle state: self compiler fixture missing")
    let oldWindowsCompiler = os.GetEnv("CHENG_WINDOWS_PRIMARY_OBJECT_COMPILER")
    let oldColdCompiler = os.GetEnv("CHENG_COLD_COMPILER")
    let oldProgressAppend = os.GetEnv("CHENG_PROGRESS_APPEND")

    let windowsResolved = sexecrt.SystemLinkExecRuntimeResolveWindowsPrimaryCompiler(
        root,
        selfPath)
    assert(windowsResolved.ok && windowsResolved.value == selfPath,
           " lifecycle state: Windows request-local compiler lost precedence")
    var windowsPlan: sexec.SystemLinkExecPlan
    windowsPlan.systemLinkPlan.targetTriple = "x86_64-pc-windows-msvc"
    let providerResolved = sexecrt.SystemLinkExecRuntimeResolveProviderObjectCompiler(
        root,
        windowsPlan,
        selfPath)
    assert(providerResolved.ok && providerResolved.value == selfPath,
           " lifecycle state: provider request-local compiler lost precedence")
    let providerEnv = sexecrt.SystemLinkExecRuntimeProviderCompileEnv(selfPath)
    assert(LifecycleEnvKeyCount(providerEnv, "CHENG_COLD_COMPILER") == 1 &&
           LifecycleEnvValue(providerEnv, "CHENG_COLD_COMPILER") == selfPath,
           " lifecycle state: cold compiler override is not request-local")
    assert(LifecycleEnvKeyCount(
               providerEnv,
               "CHENG_WINDOWS_PRIMARY_OBJECT_COMPILER") == 1 &&
           LifecycleEnvValue(
               providerEnv,
               "CHENG_WINDOWS_PRIMARY_OBJECT_COMPILER") == selfPath,
           " lifecycle state: Windows compiler override is not request-local")
    assert(LifecycleEnvKeyCount(providerEnv,
                                "CHENG_BACKEND_DRIVER_HANDOFF") == 1 &&
           LifecycleEnvValue(providerEnv,
                             "CHENG_BACKEND_DRIVER_HANDOFF") == "0" &&
           LifecycleEnvKeyCount(providerEnv,
                                "CHENG_NO_BACKEND_DRIVER_HANDOFF") == 1 &&
           LifecycleEnvValue(providerEnv,
                             "CHENG_NO_BACKEND_DRIVER_HANDOFF") == "1",
           " lifecycle state: provider handoff environment is ambiguous")
    assert(os.GetEnv("CHENG_WINDOWS_PRIMARY_OBJECT_COMPILER") ==
               oldWindowsCompiler &&
           os.GetEnv("CHENG_COLD_COMPILER") == oldColdCompiler &&
           os.GetEnv("CHENG_PROGRESS_APPEND") == oldProgressAppend,
           " lifecycle state: request-local override mutated process env")

fn main(): int32 =
    if cmdline.ParamStr(1) == "early-release":
        return LifecycleEarlyReleaseHardFailChild()
    if cmdline.ParamStr(1) == "duplicate-release":
        return LifecycleDuplicateReleaseHardFailChild()
    if cmdline.ParamStr(1) == "duplicate-abort-release":
        return LifecycleDuplicateAbortReleaseHardFailChild()
    if cmdline.ParamStr(1) == "duplicate-runtime-owner-release":
        return LifecycleDuplicateRuntimeOwnerReleaseHardFailChild()
    LifecycleStateTransitionSmoke()
    LifecycleSourceBundleReceiptSmoke()
    LifecycleTransitionHardFailSmoke()
    LifecycleAbortOwnerSmoke()
    LifecycleRuntimeFinalizerSmoke()
    LifecycleRuntimeBeginFailureDiscardSmoke()
    LifecycleProviderCompilerOverrideSmoke()
    os.WriteLine(
        os.Get_stdout(),
        "system_link_payload_lifecycle_state ok success=1 diagnostic=1 begin_failure=1 live=0 live_bytes=0")
    return 0
