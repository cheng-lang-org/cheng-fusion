import std/system
import std/result
import std/strutils as strutil
import std/rawbytes
import std/crypto/rsa
import std/tls/x509
import cheng/quic/tls/test_pki as testpki

fn main(): int32 =
    echo("rsa x509 chain direct: start")
    var leafDer: Bytes
    var keyDer: Bytes
    testpki.msquicLocalhostCertDerInto(leafDer)
    testpki.msquicLocalhostKeyPkcs8DerInto(keyDer)
    var leaf: x509.X509Certificate
    x509.initX509CertificateInto(leaf)
    let leafRes: Result[bool] = x509.x509ParseCertificateInto(leaf, leafDer)
    if IsErr(leafRes):
        echo(strutil.Join(["rsa x509 chain direct: leaf parse err=", ErrorText(leafRes)], ""))
        return 1
    echo("rsa x509 chain direct: leaf parse ok")
    var roots: x509.X509CertList
    x509.initX509CertListInto(roots)
    let pinAddRes: Result[bool] = x509.x509CertListAddDer(roots, leafDer)
    if IsErr(pinAddRes):
        echo(strutil.Join(["rsa x509 chain direct: pinned leaf add err=", ErrorText(pinAddRes)], ""))
        return 1
    echo("rsa x509 chain direct: pinned leaf add ok")
    var inter: x509.X509CertList
    x509.initX509CertListInto(inter)
    let chainRes: Result[bool] = x509.x509VerifyChain(leaf, inter, roots, 1800000000)
    if IsErr(chainRes):
        echo(strutil.Join(["rsa x509 chain direct: chain err=", Error(chainRes)], ""))
        return 1
    if ! Value(chainRes):
        echo("rsa x509 chain direct: chain false")
        return 1
    let msg: Bytes = rawbytes.BytesFromString("rsa-x509-chain-direct-pss")
    let pkcs1SigRes: Result[Bytes] = rsa.rsaBigSignPkcs1Bytes(keyDer, msg, false)
    if IsErr(pkcs1SigRes):
        echo(strutil.Join(["rsa x509 chain direct: pkcs1 sign err=", Error(pkcs1SigRes)], ""))
        return 1
    let pubRes: Result[rsa.RsaBigPublicKey] = rsa.rsaBigPublicKeyFromParts(leaf.publicKey.rsaN,
                                                                           leaf.publicKey.rsaE)
    if IsErr(pubRes):
        echo(strutil.Join(["rsa x509 chain direct: parse public key err=", Error(pubRes)], ""))
        return 1
    let pkcs1VerifyRes: Result[bool] = rsa.rsaVerifyPkcs1Diag(Value(pubRes),
                                                              msg,
                                                              Value(pkcs1SigRes),
                                                              false)
    if IsErr(pkcs1VerifyRes):
        echo(strutil.Join(["rsa x509 chain direct: pkcs1 verify err=", Error(pkcs1VerifyRes)], ""))
        return 1
    if ! Value(pkcs1VerifyRes):
        echo("rsa x509 chain direct: pkcs1 verify false")
        return 1
    echo("rsa x509 chain direct: pkcs1 ok")
    let sigRes: Result[Bytes] = rsa.rsaBigSignPssBytes(keyDer, msg, false)
    if IsErr(sigRes):
        echo(strutil.Join(["rsa x509 chain direct: pss sign err=", Error(sigRes)], ""))
        return 1
    let verifyRes: Result[bool] = rsa.rsaVerifyPssBytes(leaf.publicKey.rsaN,
                                                        leaf.publicKey.rsaE,
                                                        msg,
                                                        Value(sigRes),
                                                        false)
    if IsErr(verifyRes):
        echo(strutil.Join(["rsa x509 chain direct: pss verify err=", Error(verifyRes)], ""))
        return 1
    if ! Value(verifyRes):
        echo("rsa x509 chain direct: pss verify false")
        return 1
    echo("rsa x509 chain direct: pss bytes ok")
    let scratchRes: Result[bool] = rsa.rsaBigSignPssBytesScratch(keyDer, msg, false)
    if IsErr(scratchRes):
        echo(strutil.Join(["rsa x509 chain direct: pss scratch sign err=", Error(scratchRes)], ""))
        return 1
    let scratchLen: int32 = rsa.rsaBigLastPssSignatureLen()
    if scratchLen <= 0 || scratchLen > 512:
        echo("rsa x509 chain direct: pss scratch len invalid")
        return 1
    var scratchSig: Bytes = rawbytes.BytesAlloc(scratchLen)
    for i in 0..<scratchLen:
        rawbytes.BytesSet(scratchSig, i, rsa.rsaBigLastPssSignatureByte(i))
    let scratchVerifyRes: Result[bool] = rsa.rsaVerifyPssBytes(leaf.publicKey.rsaN,
                                                               leaf.publicKey.rsaE,
                                                               msg,
                                                               scratchSig,
                                                               false)
    if IsErr(scratchVerifyRes):
        echo(strutil.Join(["rsa x509 chain direct: pss scratch verify err=", Error(scratchVerifyRes)], ""))
        return 1
    if ! Value(scratchVerifyRes):
        echo("rsa x509 chain direct: pss scratch verify false")
        return 1
    echo("rsa x509 chain direct: pss scratch ok")
    echo("rsa_x509_chain_direct_probe ok")
    return 0
