# W3a criterion (a) part 1 + varint unit verdicts.
# RFC 9000 Section 16 sample encodings and Appendix A.1 sample values,
# boundary values on every encoding tier, non-minimal acceptance, and the
# negative set (truncation at every length, out-of-range values, non-minimal
# Frame Type rejection). Any mismatch exits non-zero with the case tag.

import std/os
import std/rawbytes
import std/strings as strings
import cheng/quic/pure/frames_varint as quicvarint

var gFails: int32

fn fail(tag: str, detail: str) =
    os.WriteLine(os.Get_stdout(), strings.concatStr("FAIL ", strings.concatStr(tag, strings.concatStr(": ", detail))))
    gFails = gFails + 1

fn checkValue(tag: str, hexIn: str, want: int64) =
    let b: Bytes = BytesFromHex(hexIn)
    let r: quicvarint.QuicVarintRead = quicvarint.QuicVarintReadAt(b, 0)
    if !r.ok:
        fail(tag, "decode reported not-ok")
        return
    if r.value != want:
        fail(tag, strings.concatStr("value=", strings.Int64ToStr(r.value)))
        return
    if r.size != b.len:
        fail(tag, "size mismatch")
        return
    os.WriteLine(os.Get_stdout(), strings.concatStr("PASS ", strings.concatStr(tag,
        strings.concatStr(" value=", strings.Int64ToStr(r.value)))))

fn checkEncode(tag: str, value: int64, wantHex: str) =
    var bb: BytesBuilder = BytesBuilderNew(8)
    let n: int32 = quicvarint.QuicVarintAppend(bb, value)
    let got: Bytes = BytesBuilderFinish(bb)
    let want: Bytes = BytesFromHex(wantHex)
    if n != want.len:
        fail(tag, strings.concatStr("appended=", strings.IntToStr(n)))
        return
    if !BytesEqual(got, want):
        fail(tag, strings.concatStr("bytes=", BytesToHex(got)))
        return
    os.WriteLine(os.Get_stdout(), strings.concatStr("PASS ", strings.concatStr(tag,
        strings.concatStr(" bytes=", BytesToHex(got)))))

fn checkTruncated(tag: str, hexIn: str) =
    let b: Bytes = BytesFromHex(hexIn)
    let r: quicvarint.QuicVarintRead = quicvarint.QuicVarintReadAt(b, 0)
    if r.ok:
        fail(tag, "truncated buffer decoded ok")
        return
    os.WriteLine(os.Get_stdout(), strings.concatStr("PASS ", strings.concatStr(tag, " rejected")))

fn main(): int32 =
    # RFC 9000 Appendix A.1 sample values (and Section 16 examples).
    checkValue("a1_8byte_c2197c5eff14e88c", "c2197c5eff14e88c", 151288809941952652)
    checkValue("a1_4byte_9d7f3e7d", "9d7f3e7d", 494878333)
    checkValue("a1_2byte_7bbd", "7bbd", 15293)
    checkValue("a1_1byte_25", "25", 37)
    # Section 16: non-minimal encodings decode to the same value.
    checkValue("a1_nonminimal_4025", "4025", 37)

    # Tier boundaries: encode and decode both directions.
    # 2-byte tier: value bits are (first & 0x3f) << 8 | second, so 64 -> 4040
    # and 16383 -> 7fff; 16384 needs the 4-byte tier.
    checkValue("bnd_max1byte_3f", "3f", 63)
    checkEncode("bnd_enc_63", 63, "3f")
    checkValue("bnd_min2byte_4040", "4040", 64)
    checkEncode("bnd_enc_64", 64, "4040")
    checkValue("bnd_max2byte_7fff", "7fff", 16383)
    checkEncode("bnd_enc_16383", 16383, "7fff")
    checkValue("bnd_min4byte_80004000", "80004000", 16384)
    checkEncode("bnd_enc_16384", 16384, "80004000")
    checkValue("bnd_max4byte_bfffffff", "bfffffff", 1073741823)
    checkEncode("bnd_enc_2p30_minus1", 1073741823, "bfffffff")
    checkEncode("bnd_enc_2p30", 1073741824, "c000000040000000")
    checkValue("bnd_min8byte_c000000040000000", "c000000040000000", 1073741824)
    checkValue("bnd_max8byte_ffffffffffffffff", "ffffffffffffffff", 4611686018427387903)
    checkEncode("bnd_enc_2p62_minus1", 4611686018427387903, "ffffffffffffffff")
    checkValue("bnd_zero_00", "00", 0)
    checkEncode("bnd_enc_0", 0, "00")

    # Round-trip encode(decode(x)) identity on the A.1 samples.
    checkEncode("rt_enc_494878333", 494878333, "9d7f3e7d")
    checkEncode("rt_enc_151288809941952652", 151288809941952652, "c2197c5eff14e88c")

    # Size selection.
    let s1: int32 = quicvarint.QuicVarintSize(63)
    let s2: int32 = quicvarint.QuicVarintSize(64)
    let s3: int32 = quicvarint.QuicVarintSize(16384)
    let s4: int32 = quicvarint.QuicVarintSize(1073741824)
    let s5: int32 = quicvarint.QuicVarintSize(4611686018427387903)
    let s6: int32 = quicvarint.QuicVarintSize(4611686018427387904)
    let s7: int32 = quicvarint.QuicVarintSize(0 - 1)
    if s1 != 1 || s2 != 2 || s3 != 4 || s4 != 8 || s5 != 8:
        fail("size_tiers", strings.concatStr(strings.IntToStr(s1), strings.concatStr(
            strings.IntToStr(s2), strings.concatStr(strings.IntToStr(s3),
            strings.concatStr(strings.IntToStr(s4), strings.IntToStr(s5))))))
    if s6 != -1 || s7 != -1:
        fail("size_out_of_range", strings.concatStr(strings.IntToStr(s6), strings.IntToStr(s7)))
    if s1 == 1 && s2 == 2 && s3 == 4 && s4 == 8 && s5 == 8 && s6 == -1 && s7 == -1:
        os.WriteLine(os.Get_stdout(), "PASS size_tiers 1/2/4/8/8, 2^62=-1, negative=-1")

    # Non-minimal encode in explicit size (legal for non-type fields).
    var bb3: BytesBuilder = BytesBuilderNew(16)
    let nm: int32 = quicvarint.QuicVarintAppendSized(bb3, 37, 2)
    let nmBytes: Bytes = BytesBuilderFinish(bb3)
    if nm != 2 || !BytesEqual(nmBytes, BytesFromHex("4025")):
        fail("sized_nonminimal", BytesToHex(nmBytes))
    else:
        os.WriteLine(os.Get_stdout(), "PASS sized_nonminimal 37@2B=4025")

    # Negatives: truncation at every tier.
    checkTruncated("neg_trunc_2byte", "7b")
    checkTruncated("neg_trunc_4byte", "9d7f3e")
    checkTruncated("neg_trunc_8byte", "c2197c5eff14e8")
    checkTruncated("neg_empty", "")

    # Negatives: non-minimal Frame Type varint must be rejected.
    let nmBad: quicvarint.QuicVarintRead = quicvarint.QuicVarintReadMinimalAt(BytesFromHex("4025"), 0)
    if nmBad.ok:
        fail("neg_minimal_frametype", "4025 accepted as frame type")
    else:
        os.WriteLine(os.Get_stdout(), "PASS neg_minimal_frametype 4025 rejected (FRAME_ENCODING_ERROR)")
    let nmOk: quicvarint.QuicVarintRead = quicvarint.QuicVarintReadMinimalAt(BytesFromHex("25"), 0)
    if !nmOk.ok || nmOk.value != 37:
        fail("neg_minimal_frametype_ok", "25 rejected wrongly")
    else:
        os.WriteLine(os.Get_stdout(), "PASS neg_minimal_frametype_ok 25 accepted")

    # Negative: value beyond 2^62-1 cannot be encoded.
    var bb4: BytesBuilder = BytesBuilderNew(16)
    let over: int32 = quicvarint.QuicVarintAppend(bb4, 4611686018427387904)
    BytesBuilderFree(bb4)
    if over != -1:
        fail("neg_encode_overflow", strings.IntToStr(over))
    else:
        os.WriteLine(os.Get_stdout(), "PASS neg_encode_overflow 2^62 rejected (-1)")

    if gFails != 0:
        os.WriteLine(os.Get_stdout(), strings.concatStr("W3A-VARINT RESULT: FAIL count=",
            strings.IntToStr(gFails)))
        return 1
    os.WriteLine(os.Get_stdout(), "W3A-VARINT RESULT: PASS")
    return 0
