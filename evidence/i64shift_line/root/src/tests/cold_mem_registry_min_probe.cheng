# Minimal repro probe for cheng_mem_registry_ensure_capacity not_ready.
# New test-only file.
var cheng_mem_registry_len: int32
var cheng_mem_registry_cap: int32
var cheng_mem_registry_dead: int32

fn cheng_mem_registry_grow(needed: int32): bool =
    if needed > 0:
        return true
    return false

fn cheng_mem_registry_ensure_capacity(extraLive: int32): bool =
    let needed: int32 = cheng_mem_registry_len + extraLive
    if cheng_mem_registry_cap <= 0:
        return cheng_mem_registry_grow(needed)
    if (cheng_mem_registry_len + cheng_mem_registry_dead + extraLive) * 10 >= cheng_mem_registry_cap * 7:
        return cheng_mem_registry_grow(needed)
    return true

fn main(): int32 =
    if cheng_mem_registry_ensure_capacity(1):
        return 0
    return 1
