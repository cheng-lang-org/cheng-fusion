import cheng/std/strings

# A mutable module-global managed sequence is rooted in immortal global
# storage.  Each mutation must use a fresh exact unique projection carrier;
# the post-call memory version must remain joined to the shared GLOBAL_ADDR
# root without turning that root itself into unique authority.
var globalManagedItems: str[]

fn main(): int32 =
    setLen(globalManagedItems, 0)
    add(globalManagedItems, strings.CloneStr("alpha"))
    add(globalManagedItems, strings.CloneStr("beta"))
    if globalManagedItems.len != 2:
        return 11
    if globalManagedItems[0] != "alpha":
        return 12
    if globalManagedItems[1] != "beta":
        return 13
    setLen(globalManagedItems, 1)
    if globalManagedItems.len != 1 || globalManagedItems[0] != "alpha":
        return 14
    return 0
