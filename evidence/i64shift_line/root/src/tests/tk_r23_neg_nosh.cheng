type
    R23VProfile =
        sourcePath: str
        text: str
        lines: str[]
        lineCount: int32
        textLen: int32
        textFirstCode: int32
        textLastCode: int32
        firstLineLen: int32

fn R23VRewrite(textRaw: str, rewrittenOut: var str, err: var str): bool =
    if textRaw == "":
        err = "missing text"
        return false
    rewrittenOut = textRaw
    err = ""
    return true

fn R23VLines(textRaw: str): str[] =
    var out: str[]
    let derived = Fmt"{textRaw}/{textRaw.len}"
    add(out, textRaw)
    add(out, derived)
    return out

fn R23VBuild(sourcePathRaw: str, text: str,
             profile: var R23VProfile, err: var str): bool =
    var normalizedText: str
    if !R23VRewrite(text, normalizedText, err):
        return false
    if sourcePathRaw == "":
        err = "missing source path"
        return false
    profile.sourcePath = sourcePathRaw
    profile.text = normalizedText
    let lines = R23VLines(normalizedText)
    profile.lines = lines
    profile.lineCount = lines.len
    profile.textLen = normalizedText.len
    profile.textFirstCode = Int32(normalizedText[0])
    profile.textLastCode = Int32(normalizedText[normalizedText.len - 1])
    profile.firstLineLen = lines[0].len
    err = ""
    return true

fn main(): int32 =
    var profile: R23VProfile
    var err: str
    if R23VBuild("", "syntax profile text", profile, err):
        return 10
    if err != "missing source path":
        return 11
    var p2: R23VProfile
    var err2: str
    if R23VBuild("src/a.cheng", "", p2, err2):
        return 12
    if err2 != "missing text":
        return 13
    var p3: R23VProfile
    var err3: str
    if !R23VBuild("src/a.cheng", "syntax profile text", p3, err3):
        return 14
    if err3 != "":
        return 15
    if p3.sourcePath != "src/a.cheng":
        return 16
    if p3.text != "syntax profile text":
        return 17
    if p3.lineCount != 2:
        return 18
    if p3.lines.len != 2:
        return 19
    if p3.lines[0] != "syntax profile text":
        return 20
    if p3.lines[1] != "syntax profile text/19":
        return 21
    if p3.textLen != 19:
        return 22
    if p3.textFirstCode != 115:
        return 23
    if p3.textLastCode != 116:
        return 24
    if p3.firstLineLen != 19:
        return 25
    let width = p3.textLen + p3.lines[1].len
    if width != 41:
        return 26
    echo("tk_r23_share ok lines=2 text=syntax profile text width=41")
    return 0
