import cheng/core/ir/core_types as ir
import cheng/core/ir/body_ir_noalias as noalias
import cheng/tests/noalias_finalize_stage_probe_lib as probe

fn ProbeForwardOpSignature(bodyIR: ir.BodyIR,
                           op: var ir.BodyOp,
                           knownSource: var int32[],
                           allowDropSelfCopy: bool,
                           dropOp: var bool) =
    dropOp = allowDropSelfCopy
    if bodyIR.localSlots.len > 0 && op.operands.len > 0 && knownSource.len > 0:
        knownSource[0] = op.operands[0]
    return

fn main(): int32 =
    let bodyIR = probe.ProbeForwardBody(true)
    var op = noalias.BodyIrNoAliasCloneOp(bodyIR.ops[0])
    var known = noalias.BodyIrNoAliasIntSeqInit(bodyIR.localSlots.len, -1)
    var dropOp = false
    ProbeForwardOpSignature(bodyIR, op, known, true, dropOp)
    if !dropOp:
        return 66
    return 77
