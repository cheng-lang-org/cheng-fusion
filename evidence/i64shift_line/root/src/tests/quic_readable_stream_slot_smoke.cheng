# Repro + regression guard for QUIC interop gap 2 (task #40):
# msquicNativeReadableAppStreamIdCurrent hardcoded `streamId % 4 == 0`
# (client-initiated bidirectional only), so bytes correctly received and
# buffered on any other stream class -- server-initiated bidi, and either
# side's peer-initiated unidirectional stream (HTTP/3's mandatory
# control/qpack streams) -- were never observed as readable.
#
# RFC 9000 §2.1: low 2 bits of a stream ID encode initiator (bit0: 0=client,
# 1=server) and directionality (bit1: 0=bidi, 1=uni). A stream is readable by
# `side` unless it is unidirectional AND self-initiated (that combination is
# `side`'s own write-only stream). Each self-uni exclusion check below runs
# first, alone, so it cannot be masked by an already-added, still-"ready"
# other stream satisfying the same query.

import std/result
import std/rawbytes
import cheng/quic/native_runtime as qnative

fn oneByte(): rawbytes.Bytes =
    let b: rawbytes.Bytes = BytesAlloc(1)
    BytesSet(b, 0, 0x41)
    return b

fn addReady(side: int32, streamId: int64) =
    let addRes: Result[bool] = qnative.msquicNativeAppRecvAdd(side, streamId, 0, oneByte())
    if IsErr(addRes):
        panic(ErrorText(addRes))

fn main(): int32 =
    # --- server side ---
    # server-initiated uni (id%4==3): server's own write-only stream, never readable by server.
    addReady(qnative.msquicNativeServerSide, 3)
    let srvSelfUni: Result[int64] = qnative.msquicNativeReadableAppStreamIdCurrent(qnative.msquicNativeServerSide, 3)
    assert(IsErr(srvSelfUni), "server does not see its own server-initiated uni stream 3 as readable")

    # client-initiated bidi (id%4==0)... use id=1 (server-initiated bidi) since a bidi
    # stream is readable by both sides regardless of initiator.
    addReady(qnative.msquicNativeServerSide, 1)
    let srvBidi: Result[int64] = qnative.msquicNativeReadableAppStreamIdCurrent(qnative.msquicNativeServerSide, 1)
    assert(IsOk(srvBidi) && Value(srvBidi) == 1, "server sees server-initiated bidi stream 1 as readable")

    # client-initiated uni (id%4==2): peer-initiated, must be readable by server
    # (this is the exact gap: HTTP/3's client-initiated control/qpack streams).
    addReady(qnative.msquicNativeServerSide, 2)
    let srvPeerUni: Result[int64] = qnative.msquicNativeReadableAppStreamIdCurrent(qnative.msquicNativeServerSide, 2)
    assert(IsOk(srvPeerUni) && Value(srvPeerUni) == 2, "server sees client-initiated uni stream 2 as readable")

    # --- client side ---
    # client-initiated uni (id%4==2): client's own write-only stream, never readable by client.
    addReady(qnative.msquicNativeClientSide, 2)
    let cliSelfUni: Result[int64] = qnative.msquicNativeReadableAppStreamIdCurrent(qnative.msquicNativeClientSide, 2)
    assert(IsErr(cliSelfUni), "client does not see its own client-initiated uni stream 2 as readable")

    addReady(qnative.msquicNativeClientSide, 1)
    let cliBidi: Result[int64] = qnative.msquicNativeReadableAppStreamIdCurrent(qnative.msquicNativeClientSide, 1)
    assert(IsOk(cliBidi) && Value(cliBidi) == 1, "client sees server-initiated bidi stream 1 as readable")

    # server-initiated uni (id%4==3): peer-initiated, must be readable by client
    # (server-initiated unidirectional streams, e.g. HTTP/3's control/qpack streams).
    addReady(qnative.msquicNativeClientSide, 3)
    let cliPeerUni: Result[int64] = qnative.msquicNativeReadableAppStreamIdCurrent(qnative.msquicNativeClientSide, 3)
    assert(IsOk(cliPeerUni) && Value(cliPeerUni) == 3, "client sees server-initiated uni stream 3 as readable")

    echo(" quic_readable_stream_slot_smoke ok")
    return 0
