import std/os
import std/strformat
import cheng/core/backend/lowering_plan as lower
import cheng/core/lang/typed_expr as texpr

fn buildTrackedCallTargets(
        fnIr: var lower.PrimaryObjectIrFunction,
        plan: var lower.LoweringPlanStub) =
    for row in 0..<40:
        let target = Fmt"tracked_target_{row}"
        let sourcePath = Fmt"/tracked/source_{row}.cheng"
        let argTypes = Fmt"arg_type_{row}"
        lower.LoweringPrimaryObjectIrCallTargetAppendExactRow(
            fnIr,
            row,
            target,
            sourcePath,
            row + 1,
            false,
            row,
            "",
            argTypes)
    let indirectStart = fnIr.callTargets.len
    lower.LoweringPrimaryObjectIrCallTargetAppendExactRow(
        fnIr, 2, "cheng_call_ptr_i32_raw", "/tracked/indirect.cheng",
        90, false, -1, "", "int64,int32")
    lower.LoweringPrimaryObjectIrCallTargetAppendExactRow(
        fnIr, 2, "tracked_after_indirect", "/tracked/indirect.cheng",
        91, false, 91, "", "int64,int32")
    lower.LoweringPrimaryObjectIrCallTargetAppendExactRow(
        fnIr, 2, "cheng_call_ptr_void_raw", "/tracked/indirect.cheng",
        92, false, -1, "", "int64,int32")
    if os.GetEnv("CHENG_FORMAL_LOWERING_CALL_TARGET_NEGATIVE") ==
           "shape":
        add(fnIr.callArgCounts, 1)
    lower.LoweringRemoveIndirectCallIntrinsicTargetsFromIndex(
        fnIr, indirectStart)
    if fnIr.callTargets.len != 41:
        panic("formal lowering call target: indirect rebuild mismatch")
    let indirectRebuildPeakBytes =
        fnIr.callTargetAllocatorLedger.peakLiveCapacityBytes
    lower.LoweringPrimaryObjectIrCallTargetClear(fnIr)
    lower.LoweringPrimaryObjectIrCallTargetAppendExactRow(
        fnIr, 1, "len", "/tracked/builtin.cheng",
        93, false, -1, "", "str")
    lower.LoweringPrimaryObjectIrCallTargetAppendExactRow(
        fnIr, 1, "range", "/tracked/builtin.cheng",
        94, false, -1, "", "int32")
    lower.LoweringPrimaryObjectIrCallTargetAppendExactRow(
        fnIr, 1, "bytesLen", "/tracked/builtin.cheng",
        95, false, -1, "", "str")
    lower.LoweringPrimaryObjectIrCallTargetAppendExactRow(
        fnIr, 1, "sizeof", "/tracked/builtin.cheng",
        96, false, -1, "", "int32")
    var sourceTexts: texpr.TypedExprSourceText[]
    lower.LoweringRemoveBuiltinCallTargets(fnIr, plan, sourceTexts)
    if fnIr.callTargets.len != 0:
        panic("formal lowering call target: builtin rebuild mismatch")
    if fnIr.callTargetAllocatorLedger.peakLiveCapacityBytes <
           indirectRebuildPeakBytes:
        panic("formal lowering call target: rebuild peak regressed")
    for row in 0..<40:
        let target = Fmt"terminal_target_{row}"
        let sourcePath = Fmt"/terminal/source_{row}.cheng"
        let argTypes = Fmt"terminal_type_{row}"
        lower.LoweringPrimaryObjectIrCallTargetAppendExactRow(
            fnIr,
            row,
            target,
            sourcePath,
            row + 100,
            false,
            row,
            "",
            argTypes)

fn main(): int32 =
    var plan: lower.LoweringPlanStub
    var fnIr: lower.PrimaryObjectIrFunction
    buildTrackedCallTargets(fnIr, plan)
    if !lower.LoweringPrimaryObjectIrCallTargetShapeComplete(fnIr) ||
       fnIr.callTargets.len != 40:
        panic("formal lowering call target: rebuild shape mismatch")
    let terminalBufferCount =
        lower.LoweringPrimaryObjectIrCallTargetAllocatorPhysicalBufferCount(
            fnIr)
    let terminalBytes =
        lower.LoweringPrimaryObjectIrCallTargetAllocatorCapacityBytes(fnIr)
    if terminalBufferCount != 8 || terminalBytes <= int64(0):
        panic("formal lowering call target: terminal retained mismatch")
    var receipt: lower.LoweringSequenceAllocatorReceipt
    lower.LoweringPrimaryObjectIrCallTargetReleaseWithAllocatorReceipt(
        fnIr, receipt)
    if os.GetEnv("CHENG_FORMAL_LOWERING_CALL_TARGET_NEGATIVE") ==
           "receipt-bytes":
        receipt.allocatedCapacityBytes =
            receipt.allocatedCapacityBytes - int64(1)
    if receipt.allocationEventCount <= int64(terminalBufferCount) ||
       receipt.releaseEventCount != receipt.allocationEventCount ||
       receipt.allocatedCapacityBytes <= terminalBytes ||
       receipt.releasedCapacityBytes != receipt.allocatedCapacityBytes ||
       receipt.terminalRetainedBufferCount != terminalBufferCount ||
       receipt.terminalRetainedBytes != terminalBytes ||
       receipt.terminalReleasedBufferCount != terminalBufferCount ||
       receipt.terminalReleasedBytes != terminalBytes ||
       receipt.liveAllocationCount != int64(0) ||
       receipt.liveCapacityBytes != int64(0) ||
       !lower.LoweringSequenceAllocatorReceiptClosed(receipt):
        panic("formal lowering call target: allocator receipt mismatch")
    os.WriteLine(
        os.GetStdout(),
        Fmt"formal_lowering_call_target_allocator_smoke ok columns=8 rows=40 allocation_events={receipt.allocationEventCount} release_events={receipt.releaseEventCount} allocated_bytes={receipt.allocatedCapacityBytes} released_bytes={receipt.releasedCapacityBytes} terminal_buffers={receipt.terminalRetainedBufferCount} terminal_bytes={receipt.terminalRetainedBytes} live={receipt.liveAllocationCount} live_bytes={receipt.liveCapacityBytes}")
    return 0
