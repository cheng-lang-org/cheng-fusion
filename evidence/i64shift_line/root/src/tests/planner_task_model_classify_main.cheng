import std/strutils as strutil
import std/cmdline
import std/os
import std/strings
import cheng/inference/distributed_engine as engine
import cheng/inference/planner_task as ptask

# S2 真模型接线 e2e 驱动 (#15), 任务03 失败语义迁移:
#   --mode rules-golden (默认): 7 规则分支金标, 走显式规则入口
#     PlannerTaskClassifyRulesFromText (与 asiComputerUseContract.ts
#     classifyTaskKind 镜像语义逐条对齐, 顺序敏感)。
#   --mode failure-golden: 任务03 显式失败合同 —— 取消/超时先于任何模型调用,
#     env 未设/路径缺失/坏文件逐项显式拒绝; 每项断言错误串可区分, 无任何
#     关键词回退伪装成功。
#   其余 (模型模式): env 已设 -> PlannerTaskClassifyFromTextWithBudget 走真
#     模型受限 argmax, Ok 打印结果供外部确定性对拍; Err 如实打印
#     classify_error 并 rc=1, 不回落规则。

fn classifyAlwaysCancel(): bool =
    return true

fn classifyNeverCancel(): bool =
    return false

fn runRulesGolden(): int32 =
    var cases: str[]
    add(cases, "帮我发布一个宠物广告视频")
    add(cases, "帮我发布一个宠物视频")
    add(cases, "从淘宝导入商品")
    add(cases, "帮我买一箱苹果")
    add(cases, "看看二手相机 距离最近的")
    add(cases, "搜索古典音乐")
    add(cases, "今天天气怎么样")
    var expected: str[]
    add(expected, "publish-ad-video-draft")
    add(expected, "publish-short-video-draft")
    add(expected, "authorized-product-publish-draft")
    add(expected, "purchase-assist-review")
    add(expected, "feed-filter-review")
    add(expected, "content-search-review")
    add(expected, "unsupported-review")
    for i in 0..<cases.len:
        let got = ptask.PlannerTaskClassifyRulesFromText(cases[i])
        if got != expected[i]:
            echo(strutil.Join(["rules_golden_mismatch: case=", strings.CloneStr(cases[i]), " expected=", strings.CloneStr(expected[i]), " got=", strings.CloneStr(got)], ""))
            return 1
        echo(strutil.Join(["rules_golden_ok: ", strings.CloneStr(cases[i]), " -> ", strings.CloneStr(got)], ""))
    if ptask.PlannerTaskClassifyRulesFromText("") != "unsupported-review":
        echo("rules_golden_mismatch: empty text")
        return 1
    echo("planner_task_model_classify_main rules-golden ok")
    return 0

fn expectErrFail(label: str, msg: str, wantSub: str): int32 =
    # 仅拼打印用; Err 判定在调用点内联完成 (Result 不作形参传递)。
    echo(strutil.Join(["failure_golden_mismatch: ", strings.CloneStr(label), " got=", strings.CloneStr(msg), " want=", strings.CloneStr(wantSub)], ""))
    return 1

fn runFailureGolden(): int32 =
    # 1) 超时: deadline 已过 -> 显式 Err, 且先于 env/加载/forward (env 未设也
    #    必须报超时而不是 env 错误, 证明检查顺序)。
    let deadlineBudget = engine.DistributedGenerationBudget(
        deadlineMs: int64(1), cancelPoll: classifyNeverCancel)
    let r1res = ptask.PlannerTaskClassifyFromTextWithBudget("帮我发布一个宠物视频", deadlineBudget)
    if IsOk(r1res):
        echo(strutil.Join(["failure_golden_mismatch: deadline-passed expected Err got Ok kind=", strings.CloneStr(Value(r1res))], ""))
        return 1
    if !strutil.Contains(Error(r1res), "budget deadline passed"):
        return expectErrFail("deadline-passed", Error(r1res), "budget deadline passed")
    echo(strutil.Join(["failure_golden_ok: deadline-passed -> ", strings.CloneStr(Error(r1res))], ""))

    # 2) 取消: cancelPoll=true -> 显式 Err, 先于 env/加载/forward。
    let cancelBudget = engine.DistributedGenerationBudget(
        deadlineMs: int64(0), cancelPoll: classifyAlwaysCancel)
    let r2res = ptask.PlannerTaskClassifyFromTextWithBudget("帮我发布一个宠物视频", cancelBudget)
    if IsOk(r2res):
        echo(strutil.Join(["failure_golden_mismatch: cancelled expected Err got Ok kind=", strings.CloneStr(Value(r2res))], ""))
        return 1
    if !strutil.Contains(Error(r2res), "budget cancelled"):
        return expectErrFail("cancelled", Error(r2res), "budget cancelled")
    echo(strutil.Join(["failure_golden_ok: cancelled -> ", strings.CloneStr(Error(r2res))], ""))

    # 3) env 未设 -> 显式 NotConfigured 拒绝。
    if os.GetEnv("CHENG_PLANNER_CONFIG") == "" && os.GetEnv("CHENG_PLANNER_WEIGHTS") == "":
        let r3res = ptask.PlannerTaskClassifyFromTextWithBudget("帮我发布一个宠物视频", engine.DistributedGenerationBudgetUnbounded())
        if IsOk(r3res):
            echo(strutil.Join(["failure_golden_mismatch: env-unset expected Err got Ok kind=", strings.CloneStr(Value(r3res))], ""))
            return 1
        if !strutil.Contains(Error(r3res), "env not set"):
            return expectErrFail("env-unset", Error(r3res), "env not set")
        echo(strutil.Join(["failure_golden_ok: env-unset -> ", strings.CloneStr(Error(r3res))], ""))
    else:
        echo("failure_golden_skip: env-unset (外部已设 planner env)")

    # 4) 路径缺失 -> 显式拒绝 (env 可进程内改写)。
    os.SetEnv("CHENG_PLANNER_CONFIG", "failure_golden_missing_config_xyz.json")
    os.SetEnv("CHENG_PLANNER_WEIGHTS", "failure_golden_missing_weights_xyz.safetensors")
    let r4res = ptask.PlannerTaskClassifyFromTextWithBudget("帮我发布一个宠物视频", engine.DistributedGenerationBudgetUnbounded())
    if IsOk(r4res):
        echo(strutil.Join(["failure_golden_mismatch: path-not-found expected Err got Ok kind=", strings.CloneStr(Value(r4res))], ""))
        return 1
    if !strutil.Contains(Error(r4res), "path not found"):
        return expectErrFail("path-not-found", Error(r4res), "path not found")
    echo(strutil.Join(["failure_golden_ok: path-not-found -> ", strings.CloneStr(Error(r4res))], ""))

    # 5) 坏文件 (路径存在但内容不合法; 目录充数) -> 加载链显式 Err,
    #    不伪装成任何 taskKind 成功。
    os.SetEnv("CHENG_PLANNER_CONFIG", ".")
    os.SetEnv("CHENG_PLANNER_WEIGHTS", ".")
    let r5res = ptask.PlannerTaskClassifyFromTextWithBudget("帮我发布一个宠物视频", engine.DistributedGenerationBudgetUnbounded())
    if IsOk(r5res):
        echo(strutil.Join(["failure_golden_mismatch: bad-artifact expected Err got Ok kind=", strings.CloneStr(Value(r5res))], ""))
        return 1
    echo(strutil.Join(["failure_golden_ok: bad-artifact -> ", strings.CloneStr(Error(r5res))], ""))

    echo("planner_task_model_classify_main failure-golden ok")
    return 0

fn main(): int32 =
    let mode = cmdline.ReadFlagOrDefault("--mode", "rules-golden")
    if mode == "rules-golden":
        return runRulesGolden()
    if mode == "failure-golden":
        return runFailureGolden()
    let text = cmdline.ReadFlagOrDefault("--text", "帮我发布一个宠物视频")
    let kindRes = ptask.PlannerTaskClassifyFromTextWithBudget(
        strings.CloneStr(text), engine.DistributedGenerationBudgetUnbounded())
    if IsErr(kindRes):
        echo(strutil.Join(["classify_error: ", strings.CloneStr(Error(kindRes))], ""))
        return 1
    let kind = Value(kindRes)
    # 合法性断言: 返回值必须是 7 候选之一
    let kinds = ptask.PlannerTaskCandidateKinds()
    var valid = false
    for i in 0..<kinds.len:
        if kind == kinds[i]:
            valid = true
    if !valid:
        echo(strutil.Join(["invalid_kind: ", strings.CloneStr(kind)], ""))
        return 1
    echo(strutil.Join(["text: ", strings.CloneStr(text)], ""))
    echo(strutil.Join(["task_kind: ", strings.CloneStr(kind)], ""))
    echo("planner_task_model_classify_main ok")
    return 0
