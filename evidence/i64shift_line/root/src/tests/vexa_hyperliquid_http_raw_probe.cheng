import std/os as os
import std/strings
import cheng/core/csg_asset/hyperliquid_source as hyper

@importc("calloc")
fn rawProbeCalloc(count: int64, size: int64): ptr

@importc("memcpy")
fn rawProbeMemcpy(dst: ptr, src: ptr, count: int64): ptr

@importc("strlen")
fn rawProbeStrlen(raw: ptr): int64

@importc("cheng_http_request_with_timeout")
fn rawProbeHttpRequestWithTimeout(method: cstring,
                                  url: cstring,
                                  body: cstring,
                                  headers: cstring,
                                  timeoutSeconds: int32): cstring

fn rawProbeCString(text: str): cstring =
    let raw = rawProbeCalloc(int64(text.len) + int64(1), int64(1))
    if raw == nil:
        return cstring(nil)
    if text.len > 0:
        rawProbeMemcpy(raw, text.data, int64(text.len))
    return cstring(raw)

fn main(): int32 =
    let out = rawProbeHttpRequestWithTimeout(rawProbeCString("POST"),
                                             rawProbeCString(hyper.HyperliquidAllMidsSourceUri),
                                             rawProbeCString(hyper.HyperliquidAllMidsRequestBody),
                                             rawProbeCString("[\"Content-Type: application/json\"]"),
                                             15)
    if ptr(out) == nil:
        os.WriteLine(os.Get_stderr(), "raw hyperliquid response nil")
        return 1
    let n = int32(rawProbeStrlen(ptr(out)))
    if n <= 0:
        os.WriteLine(os.Get_stderr(), "raw hyperliquid response empty")
        return 1
    os.WriteLine(os.Get_stdout(), strings.ConcatStr("raw_hyperliquid_response_len=", strings.IntToStr(n)))
    os.WriteLine(os.Get_stdout(), "vexa_hyperliquid_http_raw_probe ok")
    return 0
