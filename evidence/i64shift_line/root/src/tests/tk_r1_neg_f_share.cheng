import std/system as system

type
    TkR1Model =
        n: int64
        tag: str

fn TkR1Report(model: TkR1Model): str =
    return model.tag

fn main(): int32 =
    var s: str
    s = strings.ConcatStr("hel", "lo")
    var m: TkR1Model
    m.n = 1
    m.tag = share(s)
    os.WriteLine(os.Get_stdout(), strings.ConcatStr(TkR1Report(m), s))
    return 0
