type
    ColdRefObjectBorrowStringHeaderOuter = ref object
        text: str

fn ColdRefObjectBorrowStringHeaderWrite(
        text: var str) =
    text = "changed"

fn ColdRefObjectBorrowStringHeaderMutate(
        out: var ColdRefObjectBorrowStringHeaderOuter) =
    var text = out.text
    let forbiddenLength = out.text.len
    ColdRefObjectBorrowStringHeaderWrite(text)
    if forbiddenLength == 0:
        return

fn main(): int32 =
    var out = new(ColdRefObjectBorrowStringHeaderOuter)
    out.text = "initial"
    ColdRefObjectBorrowStringHeaderMutate(out)
    return 0
