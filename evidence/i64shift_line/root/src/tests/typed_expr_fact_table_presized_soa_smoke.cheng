import std/cmdline as cmdline
import cheng/core/backend/primary_object_plan as primary
import cheng/core/backend/regalloc_production_emitter as regprod
import cheng/core/backend/regalloc_production_artifacts as regart
import cheng/core/backend2/backend2_lower_util as backend2util
import cheng/core/ir/core_types as coreir
import cheng/core/lang/parser
import cheng/core/lang/typed_expr as texpr
import cheng/core/lang/typed_expr_type_arena as typearena
import cheng/core/runtime/arena as arenamod
import cheng/core/backend/regalloc_aarch64_adapter as rega64

fn bindExactTypeArena(body: var coreir.BodyIR) =
    let source = "type Backend2CanonicalScalar = int32\n"
    var tree: parser.ParserValueExprTree
    var authority: typearena.TypedExprTypeResolutionAuthority
    var arena: typearena.TypedExprTypeArena
    var err: str
    assert(parser.ParserValueExprReadTreeFromText(source, tree, err) &&
           typearena.TypedExprTypeResolutionAuthorityBuildSameSourceInto(
               tree, authority, err) &&
           typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               tree, authority, arena, err) &&
           typearena.TypedExprTypeArenaComplete(arena) &&
           typearena.TypedExprTypeArenaStrictValidateInto(arena, err),
           "fact table exact TypeArena fixture")
    assert(coreir.BodyIRBindTypeArenaArtifactCid(
               body, arena.artifactRaw32),
           "fact table TypeArena bind")
    typearena.TypedExprTypeArenaRelease(arena)
    parser.ParserValueExprTreeRelease(tree)

fn FactRow(index: int32): texpr.TypedExprFact =
    var fact: texpr.TypedExprFact
    fact.exprId = "shared-expr"
    fact.sourcePath = "/fixture/source.cheng"
    fact.callQualifier = "fixture"
    fact.callCallee = "Call"
    fact.callTarget = "Call"
    fact.callTargetSourcePath = "/fixture/source.cheng"
    fact.callArgsText = "value"
    fact.typeText = "int32"
    fact.lineNumber = index + 1
    fact.columnNumber = index % 97
    fact.endLineNumber = index + 2
    fact.endColumnNumber = (index % 97) + 1
    fact.lexicalScopeId = index % 11
    fact.suiteScopeId = index % 7
    fact.statementOrdinal = index
    fact.lexicalOrdinal = index % 13
    fact.deferOwnerStatementOrdinal = index - 1
    fact.callArgCount = index % 5
    fact.valueExprCallNodeIndex = index + 100
    fact.originParserNodeId = index + 10
    fact.valueExprArgRootStart = index + 20
    fact.valueExprArgRootCount = index % 4
    fact.valueExprRootNodeIndex = index + 30
    fact.valueExprSpanStart = index + 40
    fact.valueExprSpanEnd = index + 50
    fact.valueExprStatementRole = parser.ParserValueExprStatementReturnValue
    fact.kind = parser.NormalizedExprConstructor
    fact.surfaceCallKind = texpr.TypedExprSurfaceCallMember
    fact.callResolved = (index % 2) == 0
    fact.callReason = texpr.TypedExprCallReasonAmbiguousQualifiedTarget
    fact.callTargetImportc = (index % 3) == 0
    fact.callPrefixStyle = (index % 5) == 0
    fact.abiClass = texpr.TypedExprAbiComposite
    fact.valueKind = texpr.TypedExprValuePointerLike
    fact.placeKind = texpr.TypedExprPlaceField
    fact.hasSink = (index % 7) == 0
    fact.sinkPlaceKind = texpr.TypedExprPlaceCallResult
    fact.loweringMode = texpr.TypedExprLowerSret
    fact.callKind = texpr.TypedExprCallProjection
    fact.typeCallKind = texpr.TypedExprTypeCallConstructor
    fact.returnKind = texpr.TypedExprReturnImportBuffer
    fact.returnRoot = (index % 11) == 0
    return fact

fn AssertRow(table: texpr.TypedExprFactTable, index: int32) =
    let fact = texpr.TypedExprFactAt(table, index)
    assert(fact.exprId == "shared-expr" &&
           fact.sourcePath == "/fixture/source.cheng" &&
           fact.callQualifier == "fixture" &&
           fact.callCallee == "Call" &&
           fact.callTarget == "Call" &&
           fact.callTargetSourcePath == "/fixture/source.cheng" &&
           fact.callArgsText == "value" &&
           fact.typeText == "int32" &&
           fact.lineNumber == index + 1 &&
           fact.columnNumber == index % 97 &&
           fact.endLineNumber == index + 2 &&
           fact.endColumnNumber == (index % 97) + 1 &&
           fact.lexicalScopeId == index % 11 &&
           fact.suiteScopeId == index % 7 &&
           fact.statementOrdinal == index &&
           fact.lexicalOrdinal == index % 13 &&
           fact.deferOwnerStatementOrdinal == index - 1 &&
           fact.callArgCount == index % 5 &&
           fact.valueExprCallNodeIndex == index + 100 &&
           fact.originParserNodeId == index + 10 &&
           fact.valueExprArgRootStart == index + 20 &&
           fact.valueExprArgRootCount == index % 4 &&
           fact.valueExprRootNodeIndex == index + 30 &&
           fact.valueExprSpanStart == index + 40 &&
           fact.valueExprSpanEnd == index + 50 &&
           fact.valueExprStatementRole ==
               parser.ParserValueExprStatementReturnValue &&
           fact.kind == parser.NormalizedExprConstructor &&
           fact.surfaceCallKind == texpr.TypedExprSurfaceCallMember &&
           fact.callResolved == ((index % 2) == 0) &&
           fact.callReason == texpr.TypedExprCallReasonAmbiguousQualifiedTarget &&
           fact.callTargetImportc == ((index % 3) == 0) &&
           fact.callPrefixStyle == ((index % 5) == 0) &&
           fact.abiClass == texpr.TypedExprAbiComposite &&
           fact.valueKind == texpr.TypedExprValuePointerLike &&
           fact.placeKind == texpr.TypedExprPlaceField &&
           fact.hasSink == ((index % 7) == 0) &&
           fact.sinkPlaceKind == texpr.TypedExprPlaceCallResult &&
           fact.loweringMode == texpr.TypedExprLowerSret &&
           fact.callKind == texpr.TypedExprCallProjection &&
           fact.typeCallKind == texpr.TypedExprTypeCallConstructor &&
           fact.returnKind == texpr.TypedExprReturnImportBuffer &&
           fact.returnRoot == ((index % 11) == 0),
           Fmt"typed expr fact table: row roundtrip index={index} call_node={fact.valueExprCallNodeIndex} origin={fact.originParserNodeId} arg_start={fact.valueExprArgRootStart} arg_count={fact.valueExprArgRootCount} root={fact.valueExprRootNodeIndex} span={fact.valueExprSpanStart}/{fact.valueExprSpanEnd} role={Int32(fact.valueExprStatementRole)} kind={Int32(fact.kind)}")

fn LargeReserveContract() =
    let rowCount: int32 = 1165414
    let expectedBytes: int64 = Int64(138684266)
    assert(texpr.TypedExprFactTableStorageBytesForRows(rowCount) ==
               expectedBytes,
           "typed expr fact table: large storage theory")
    var table: texpr.TypedExprFactTable
    assert(texpr.TypedExprFactTablePrepareEmptyRows(table, rowCount),
           "typed expr fact table: large reserve")
    assert(texpr.TypedExprFactTableColumnsLockstep(table) &&
           texpr.TypedExprFactTablePreparedRowCapacity(table) == rowCount &&
           texpr.TypedExprFactTableCompactGrowCount(table) == 0 &&
           table.arena.usedBytes == Int32(expectedBytes) &&
           table.arena.capacityBytes == Int32(expectedBytes) &&
           table.arena.capacityBytes < 140000000,
           "typed expr fact table: large reserve stays below 140MB")
    let logicalCountBeforeProbe = texpr.TypedExprFactTableCount(table)
    assert(arenamod.ArenaArrayInt32ProbeReservedIndexForTest(table.arena,
                                                              table.exprIdIds,
                                                              0,
                                                              101) &&
           arenamod.ArenaArrayU8ProbeReservedIndexForTest(table.arena,
                                                           table.placeKinds,
                                                           rowCount / 2,
                                                           202) &&
           arenamod.ArenaArrayU8ProbeReservedIndexForTest(table.arena,
                                                           table.callPrefixStyles,
                                                           rowCount - 1,
                                                           203) &&
           texpr.TypedExprFactTableCount(table) == logicalCountBeforeProbe &&
           table.exprIdIds.len == 0 &&
           table.placeKinds.len == 0 &&
           table.callPrefixStyles.len == 0,
           "typed expr fact table: large reserve first middle last offsets")
    texpr.TypedExprFactTableRelease(table)

fn ColumnLayoutIntegrityContract() =
    var empty: texpr.TypedExprFactTable
    assert(texpr.TypedExprFactTableColumnsLockstep(empty),
           "typed expr fact table: zero table layout")

    var table: texpr.TypedExprFactTable
    assert(texpr.TypedExprFactTablePrepareEmptyRows(table, 65) &&
           texpr.TypedExprFactTableColumnsLockstep(table),
           "typed expr fact table: prepared layout")
    let sourcePathColumn = table.sourcePathIds
    table.sourcePathIds.offset = table.exprIdIds.offset
    assert(!texpr.TypedExprFactTableColumnsLockstep(table),
           "typed expr fact table: overlap rejected")
    table.sourcePathIds = sourcePathColumn
    table.sourcePathIds.offset = sourcePathColumn.offset + 2
    assert(!texpr.TypedExprFactTableColumnsLockstep(table),
           "typed expr fact table: misalignment rejected")
    table.sourcePathIds = sourcePathColumn
    let finalColumn = table.callPrefixStyles
    table.callPrefixStyles.offset = finalColumn.offset + 4
    assert(!texpr.TypedExprFactTableColumnsLockstep(table),
           "typed expr fact table: truncated final range rejected")
    table.callPrefixStyles = finalColumn
    assert(texpr.TypedExprFactTableColumnsLockstep(table),
           "typed expr fact table: restored layout")
    texpr.TypedExprFactTableRelease(table)

fn PresizedAppendContract(rowCount: int32) =
    var table: texpr.TypedExprFactTable
    assert(texpr.TypedExprFactTablePrepareEmptyRows(table, rowCount),
           "typed expr fact table: presized prepare")
    for i in 0..<rowCount:
        texpr.TypedExprFactTableAppend(table, FactRow(i))
    assert(texpr.TypedExprFactTableCount(table) == rowCount &&
           texpr.TypedExprFactTablePreparedRowCapacity(table) == rowCount &&
           texpr.TypedExprFactTableCompactGrowCount(table) == 0 &&
           texpr.TypedExprFactTableColumnsLockstep(table),
           "typed expr fact table: presized append lockstep")
    AssertRow(table, 0)
    AssertRow(table, rowCount / 2)
    AssertRow(table, rowCount - 1)
    texpr.TypedExprFactTableRelease(table)

fn HandBuiltCompactGrowContract() =
    var table: texpr.TypedExprFactTable
    for i in 0..<65:
        texpr.TypedExprFactTableAppendHandBuilt(table, FactRow(i))
    assert(texpr.TypedExprFactTableCount(table) == 65 &&
           texpr.TypedExprFactTablePreparedRowCapacity(table) == 128 &&
           texpr.TypedExprFactTableCompactGrowCount(table) == 1 &&
           table.arena.capacityBytes == 128 * 119 &&
           texpr.TypedExprFactTableColumnsLockstep(table),
           "typed expr fact table: hand-built append uses whole-table compact grow")
    AssertRow(table, 64)
    texpr.TypedExprFactTableRelease(table)

fn ResetReleaseContract() =
    var small: texpr.TypedExprFactTable
    assert(texpr.TypedExprFactTablePrepareEmptyRows(small, 65),
           "typed expr fact table: small reset prepare")
    for i in 0..<65:
        texpr.TypedExprFactTableAppendPrepared(small, FactRow(i))
    let retainedCapacity = small.arena.capacityBytes
    texpr.TypedExprFactTableReset(small)
    assert(texpr.TypedExprFactTableCount(small) == 0 &&
           small.arena.capacityBytes == retainedCapacity &&
           small.arena.usedBytes == 0 &&
           texpr.TypedExprFactTablePreparedRowCapacity(small) == 0 &&
           texpr.TypedExprFactTableCompactGrowCount(small) == 0 &&
           texpr.TypedExprFactTableColumnsLockstep(small),
           "typed expr fact table: bounded reset contract")
    assert(texpr.TypedExprFactTablePrepareEmptyRows(small, 64),
           "typed expr fact table: prepare after reset")
    texpr.TypedExprFactTableAppendPrepared(small, FactRow(0))
    AssertRow(small, 0)
    texpr.TypedExprFactTableRelease(small)
    assert(texpr.TypedExprFactTableCount(small) == 0 &&
           small.arena.capacityBytes == 0 &&
           texpr.TypedExprFactTablePreparedRowCapacity(small) == 0 &&
           texpr.TypedExprFactTableCompactGrowCount(small) == 0 &&
           texpr.TypedExprFactTableColumnsLockstep(small),
           "typed expr fact table: release contract")

    var large: texpr.TypedExprFactTable
    assert(texpr.TypedExprFactTablePrepareEmptyRows(large, 640),
           "typed expr fact table: large reset prepare")
    texpr.TypedExprFactTableReset(large)
    assert(large.arena.capacityBytes == 0 &&
           texpr.TypedExprFactTableColumnsLockstep(large),
           "typed expr fact table: oversized reset releases arena")
    texpr.TypedExprFactTableRelease(large)

fn CloneReleaseContract() =
    let rowCount: int32 = 4096
    var original: texpr.TypedExprFactTable
    assert(texpr.TypedExprFactTablePrepareEmptyRows(original, rowCount),
           "typed expr fact table: clone source prepare")
    for i in 0..<rowCount:
        texpr.TypedExprFactTableAppendPrepared(original, FactRow(i))
    var cloned: texpr.TypedExprFactTable
    cloned = texpr.TypedExprFactTableClone(original)
    assert(texpr.TypedExprFactTablesEqual(original, cloned) &&
           texpr.TypedExprFactTablePreparedRowCapacity(cloned) == rowCount &&
           texpr.TypedExprFactTableCompactGrowCount(cloned) == 0,
           "typed expr fact table: large clone shape")
    texpr.TypedExprFactTableRelease(original)
    assert(texpr.TypedExprFactTableReleasedEmpty(original),
           "typed expr fact table: clone source independent release")
    AssertRow(cloned, 0)
    AssertRow(cloned, rowCount / 2)
    AssertRow(cloned, rowCount - 1)
    texpr.TypedExprFactTableRelease(cloned)
    assert(texpr.TypedExprFactTableReleasedEmpty(cloned),
           "typed expr fact table: clone terminal release")
    texpr.TypedExprFactTableRelease(original)
    texpr.TypedExprFactTableRelease(cloned)

fn MoveContract() =
    var source: texpr.TypedExprFactTable
    assert(texpr.TypedExprFactTablePrepareEmptyRows(source, 3),
           "typed expr fact table: move source prepare")
    for i in 0..<3:
        texpr.TypedExprFactTableAppendPrepared(source, FactRow(i))
    var target: texpr.TypedExprFactTable
    texpr.TypedExprFactTableMoveInto(target, source)
    assert(texpr.TypedExprFactTableReleasedEmpty(source) &&
           texpr.TypedExprFactTableCount(target) == 3,
           "typed expr fact table: move transfers one owner")
    AssertRow(target, 2)
    texpr.TypedExprFactTableRelease(source)
    texpr.TypedExprFactTableRelease(target)

fn MoveNonEmptyTargetNegative() =
    var source: texpr.TypedExprFactTable
    var target: texpr.TypedExprFactTable
    assert(texpr.TypedExprFactTablePrepareEmptyRows(source, 1) &&
           texpr.TypedExprFactTablePrepareEmptyRows(target, 1),
           "typed expr fact table: move negative prepare")
    texpr.TypedExprFactTableAppendPrepared(source, FactRow(1))
    texpr.TypedExprFactTableAppendPrepared(target, FactRow(2))
    texpr.TypedExprFactTableMoveInto(target, source)

fn MoveResetRetainedTargetNegative() =
    var source: texpr.TypedExprFactTable
    var target: texpr.TypedExprFactTable
    assert(texpr.TypedExprFactTablePrepareEmptyRows(source, 1) &&
           texpr.TypedExprFactTablePrepareEmptyRows(target, 64),
           "typed expr fact table: retained move negative prepare")
    texpr.TypedExprFactTableAppendPrepared(source, FactRow(1))
    texpr.TypedExprFactTableAppendPrepared(target, FactRow(2))
    texpr.TypedExprFactTableReset(target)
    assert(texpr.TypedExprFactTableCount(target) == 0 &&
           target.arena.capacityBytes > 0 &&
           target.arena.usedBytes == 0 &&
           target.internPool != nil &&
           texpr.TypedExprFactTableColumnsLockstep(target),
           "typed expr fact table: reset target retained ownership")
    texpr.TypedExprFactTableMoveInto(target, source)

fn AppendUnpreparedNegative() =
    var table: texpr.TypedExprFactTable
    texpr.TypedExprFactTableAppend(table, FactRow(0))

fn U8FieldOverflowNegative() =
    var table: texpr.TypedExprFactTable
    assert(texpr.TypedExprFactTablePrepareEmptyRows(table, 1),
           "typed expr fact table: u8 overflow prepare")
    var fact = FactRow(0)
    fact.kind = parser.NormalizedExprKind(256)
    texpr.TypedExprFactTableAppendPrepared(table, fact)

fn AppendAggregateCopyOp(bodyIR: var coreir.BodyIR) =
    var copyOp: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(copyOp)
    copyOp.kind = coreir.BodyOpCopyLocalTag
    copyOp.target = 1
    add(copyOp.operands, 0)
    add(bodyIR.ops, copyOp)

fn BodyIrAggregateCopyContract(layoutSize: int32) =
    assert(layoutSize > 0 && layoutSize % 8 == 0,
           "typed expr fact table: aggregate layout chunk alignment")
    var primaryBody = coreir.BodyIRNew()
    primary.PrimaryBodyIrLocalSlotNewSized(primaryBody,
                                            0,
                                            "source",
                                            coreir.LocalAggregateTag,
                                            layoutSize,
                                            8)
    primary.PrimaryBodyIrLocalSlotNewSized(primaryBody,
                                            1,
                                            "target",
                                            coreir.LocalAggregateTag,
                                            layoutSize,
                                            8)
    AppendAggregateCopyOp(primaryBody)
    let primaryBodyReport = coreir.BodyIRDodSoAContractCheck(primaryBody)
    let primaryCopyWords = primary.PrimaryBodyIRCopySlotWordCount(primaryBody,
                                                                  0,
                                                                  1)
    assert(primaryBodyReport.ok && primaryBody.localSlots.len == 2 &&
           primaryBody.localSlots[0].typeKind == coreir.LocalAggregateTag &&
           primaryBody.localSlots[1].typeKind == coreir.LocalAggregateTag &&
           primaryBody.localSlots[0].sizeBytes == layoutSize &&
           primaryBody.localSlots[1].sizeBytes == layoutSize &&
           primaryBody.localSlots[1].stackOffset >=
               primaryBody.localSlots[0].stackOffset + layoutSize &&
           primaryBody.ops.len == 1 &&
           primaryBody.ops[0].kind == coreir.BodyOpCopyLocalTag &&
           primaryBody.ops[0].target == 1 &&
           primaryBody.ops[0].operands.len == 1 &&
           primaryBody.ops[0].operands[0] == 0 &&
           primaryCopyWords >= (layoutSize / 8) * 2,
           "primary typed expr fact table aggregate copy BodyIR")

    var backend2Body = coreir.BodyIRNew()
    bindExactTypeArena(backend2Body)
    backend2util.PrimaryBodyIrLocalSlotNewSized(backend2Body,
                                                0,
                                                "source",
                                                coreir.LocalAggregateTag,
                                                layoutSize,
                                                8)
    backend2util.PrimaryBodyIrLocalSlotNewSized(backend2Body,
                                                1,
                                                "target",
                                                coreir.LocalAggregateTag,
                                                layoutSize,
                                                8)
    AppendAggregateCopyOp(backend2Body)
    var term: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = coreir.BodyTermReturnTag
    term.resultSlot = -1
    let termIndex = coreir.BodyIRAppendTerm(backend2Body, term)
    coreir.BodyIRAppendBlock(backend2Body, 0, backend2Body.ops.len, termIndex)
    let backend2BodyReport = coreir.BodyIRDodSoAContractCheck(backend2Body)
    var callTargets: str[]
    var dataTargets: str[]
    let backend2Emission = regprod.RegallocProductionEmitFunction(
        "arm64-apple-darwin", backend2Body,
        "TypedExprFactTableAggregateCopy", 0,
        callTargets, dataTargets, 0,
        regart.RegallocProductionFunctionKindNormal)
    var canonicalCopyOwned = false
    for recipeIndex in 0..<backend2Emission.recipes.recipes.len:
        let recipe = backend2Emission.recipes.recipes[recipeIndex]
        if recipe.ownsBodyOp &&
           recipe.producerOpKind == coreir.BodyOpCopyLocalTag &&
           recipe.words.len > 0:
            canonicalCopyOwned = true
    assert(backend2BodyReport.ok && backend2Body.localSlots.len == 2 &&
           backend2Body.localSlots[0].typeKind == coreir.LocalAggregateTag &&
           backend2Body.localSlots[1].typeKind == coreir.LocalAggregateTag &&
           backend2Body.localSlots[0].sizeBytes == layoutSize &&
           backend2Body.localSlots[1].sizeBytes == layoutSize &&
           backend2Body.localSlots[1].stackOffset >=
               backend2Body.localSlots[0].stackOffset + layoutSize &&
           backend2Body.ops.len == 1 &&
           backend2Body.ops[0].kind == coreir.BodyOpCopyLocalTag &&
           backend2Body.ops[0].target == 1 &&
           backend2Body.ops[0].operands.len == 1 &&
           backend2Body.ops[0].operands[0] == 0 &&
           backend2Emission.valid && backend2Emission.receipt.valid &&
           backend2Emission.recipes.functionWords.len > 0 &&
           canonicalCopyOwned,
           "canonical backend2 typed expr fact table aggregate copy BodyIR")

fn BackendLayoutContract() =
    var typedIr: texpr.TypedExprIr
    var primaryTypeKind: int32
    var primarySizeBytes: int32
    var primaryAlignBytes: int32
    primary.PrimaryBodyIrTypeShapeFromText(typedIr,
                                           "",
                                           "texpr.TypedExprFactTable",
                                           primaryTypeKind,
                                           primarySizeBytes,
                                           primaryAlignBytes)
    var backend2TypeKind: int32
    var backend2SizeBytes: int32
    var backend2AlignBytes: int32
    backend2util.PrimaryBodyIrTypeShapeFromText(typedIr,
                                                "",
                                                "texpr.TypedExprFactTable",
                                                backend2TypeKind,
                                                backend2SizeBytes,
                                                backend2AlignBytes)
    assert(primaryTypeKind == coreir.LocalAggregateTag &&
           primarySizeBytes == Int32(sizeof(texpr.TypedExprFactTable)) &&
           primaryAlignBytes == 8,
           "primary typed expr fact table layout must follow sizeof")
    assert(backend2TypeKind == coreir.LocalAggregateTag &&
           backend2SizeBytes == Int32(sizeof(texpr.TypedExprFactTable)) &&
           backend2AlignBytes == 8 &&
           backend2SizeBytes == primarySizeBytes,
           "backend2 typed expr fact table layout must mirror primary sizeof")
    BodyIrAggregateCopyContract(primarySizeBytes)

fn OverflowContract() =
    var table: texpr.TypedExprFactTable
    assert(texpr.TypedExprFactTableStorageBytesForRows(18046081) ==
               Int64(2147483639) &&
           texpr.TypedExprFactTableStorageBytesForRows(18046082) < 0 &&
           !texpr.TypedExprFactTablePrepareEmptyRows(table, 18046082) &&
           table.arena.capacityBytes == 0 &&
           texpr.TypedExprFactTableColumnsLockstep(table),
           "typed expr fact table: overflow rejected without allocation")
    texpr.TypedExprFactTableRelease(table)

fn main(): int32 =
    # B1: codegen unit composition root (dispatch fails closed without registration)
    if !rega64.RegallocA64CodegenUnitRegister():
        return 90
    let mode = cmdline.ParamStr(1)
    if mode == "move-nonempty":
        MoveNonEmptyTargetNegative()
        return 91
    if mode == "move-reset-retained":
        MoveResetRetainedTargetNegative()
        return 93
    if mode == "append-unprepared":
        AppendUnpreparedNegative()
        return 92
    if mode == "u8-overflow":
        U8FieldOverflowNegative()
        return 94
    assert(texpr.TypedExprFactTablePhysicalColumnCount() == 41 &&
           texpr.TypedExprFactTablePhysicalInt32ColumnCount() == 26 &&
           texpr.TypedExprFactTablePhysicalU8ColumnCount() == 15 &&
           texpr.TypedExprFactTablePhysicalRowBytes() == 119,
           "typed expr fact table: physical column count")
    BackendLayoutContract()
    LargeReserveContract()
    ColumnLayoutIntegrityContract()
    PresizedAppendContract(65)
    PresizedAppendContract(640)
    PresizedAppendContract(4096)
    HandBuiltCompactGrowContract()
    ResetReleaseContract()
    CloneReleaseContract()
    MoveContract()
    OverflowContract()
    echo("typed_expr_fact_table_presized_soa_smoke ok")
    return 0
