# S3 (video-seek-scrub-blueprint.md §S6/§1.3) UI seek-handle bridge verification: the
# NEW position(ms)<->frame conversion + WebSceneMediaEsSeekToPositionMs one-stop entry
# added to web_scene_media_network_bridge.cheng — the pure math a drag handle's x
# position gets turned into before it ever reaches the existing (already-verified, S2)
# WebSceneMediaEsSeekToFrame/SnapToKeyFrame/cache-hit machinery. Real QUIC client against
# a real media_moq_publisher_main process serving the real hgs_stream ES fixture — no
# mocked network, no faked keyframe table. Independent oracle (same as
# media_moq_es_prefetch_tick_check_main.cheng's header comment, itself cross-checked
# against a standalone python3 struct.unpack of hgs_stream.moqidx):
#   frame_count=675, fps=30, keyframes=[0,120,240,360,480,600], durationMs=675*1000/30=22500.
#
# Uses the SAME desktop C stub as media_moq_es_prefetch_tick_check_main.cheng
# (host_stub/es_prefetch_test_host_stub.c) — no new C code, one stub reused by both.
#
# --mode conv (no cache/prefetch involved, pure math + one real seek+delivery):
#   1. WebSceneMediaEsDurationMs() == 22500 (675 frames / 30fps * 1000, independent formula).
#   2. WebSceneMediaEsFrameForPositionMs(0) == 0 — lower boundary.
#   3. WebSceneMediaEsFrameForPositionMs(999999) == 674 (frameCount-1) — upper boundary,
#      a position far past the clip end clamps instead of reading out of bounds.
#   4. WebSceneMediaEsFrameForPositionMs(4100) == 123 — mid-clip conversion, cross-checked
#      against the independent formula floor(4100*30/1000)=123 computed inline from the
#      fps/positionMs inputs themselves (not by calling the function under test twice).
#   5. WebSceneMediaEsSeekToPositionMs(4100) returns true, and WebSceneMediaEsPumpCursor()
#      == 120 — the real nearest keyframe at-or-before frame 123, proving the ms->frame
#      conversion result (123, non-keyframe) actually gets snapped by the EXISTING
#      SnapToKeyFrame inside SeekToFrame, not left unsnapped.
#   6. WebSceneMediaEsPositionMsForFrame(WebSceneMediaEsPumpCursor()) == 4000 (120
#      frames/30fps*1000) — the round-trip "seek 后游标一致": converting the POST-seek
#      cursor back to ms lands on the real snapped position, not the original 4100 the
#      user dragged to and not some drifted value.
#   7. One StreamLoop() tick after that seek actually delivers frameIdx==120 (the transport
#      layer honored the position-derived, snapped cursor — not just an in-memory cursor
#      variable nobody reads).
#
# --mode replay-cached (targetMs=4000 -> frame 120, a GOP the CALLER already primed into
#   the S4 block cache via a prior media_moq_es_prefetch_tick_check_main --mode prefetch
#   run against the SAME --root/asset — cross-process cache reuse, mirrors that test's own
#   --mode replay-cached): SeekToPositionMs(4000), one StreamLoop tick must deliver
#   frameIdx==120. The CALLER (shell harness) diffs the publisher's "served moq-frame"
#   stderr line count across this invocation and asserts ZERO growth — the S4 verify②
#   method, proving this position-based entry point reads the SAME cache-hit path S2/S4's
#   own tests already verified, not a parallel one that bypasses it.
#
# --mode replay-miss (targetMs=0 -> frame 0, GOP 0, never a prefetch target by design so
#   guaranteed uncached): SeekToPositionMs(0), one StreamLoop tick must deliver
#   frameIdx==0. The CALLER asserts the publisher log grows by exactly +1 "served
#   moq-frame" line — "未缓存响亮走取流": a miss is loud (a real network fetch happens),
#   never a silent no-op.
#
# Any failure prints a reason and exits nonzero; success prints "<MODE>_OK" and exits 0.

import std/os
import std/strutils as strutil
import std/cmdline as cmdline
import cheng/core/runtime/web_scene_media_network_bridge as media_bridge
import cheng/core/runtime/web_scene_media_block_cache as blockcache

@importc("cheng_test_es_sink_first_frame_idx")
fn chengTestEsSinkFirstFrameIdx(): int32

@importc("cheng_test_es_sink_captured")
fn chengTestEsSinkCaptured(): int32

fn fail(msg: str): int32 =
    os.WriteLine(os.Get_stdout(), strutil.Join(["FAIL: ", msg], ""))
    return 1

fn runConv(host: str, port: int32): int32 =
    if !media_bridge.WebSceneMediaEsOpen(host, port):
        return fail(strutil.Join(["es_open failed: ", media_bridge.WebSceneMediaEsLastError()], ""))
    let frames: int32 = media_bridge.WebSceneMediaEsFrameCount()
    if frames != 675:
        return fail(strutil.Join(["frame count mismatch: got=", IntToStr(frames), " want=675 (independent oracle)"], ""))
    let fps: int32 = media_bridge.WebSceneMediaEsFps()
    if fps != 30:
        return fail(strutil.Join(["fps mismatch: got=", IntToStr(fps), " want=30 (independent oracle)"], ""))
    os.WriteLine(os.Get_stdout(), "step1_open_ok")

    # 1. Duration.
    let duration: int32 = media_bridge.WebSceneMediaEsDurationMs()
    let expectedDuration: int32 = (frames * 1000) / fps
    if duration != expectedDuration:
        return fail(strutil.Join(["DurationMs mismatch: got=", IntToStr(duration), " want=", IntToStr(expectedDuration)], ""))
    if duration != 22500:
        return fail(strutil.Join(["DurationMs != independent oracle 22500: got=", IntToStr(duration)], ""))
    os.WriteLine(os.Get_stdout(), strutil.Join(["step2_duration_ok durationMs=", IntToStr(duration)], ""))

    # 2. Lower boundary.
    let frameAtZero: int32 = media_bridge.WebSceneMediaEsFrameForPositionMs(0)
    if frameAtZero != 0:
        return fail(strutil.Join(["FrameForPositionMs(0) mismatch: got=", IntToStr(frameAtZero), " want=0"], ""))
    os.WriteLine(os.Get_stdout(), "step3_lower_boundary_ok")

    # 3. Upper boundary — far past the clip end clamps to frames-1, not out of bounds.
    let frameAtFar: int32 = media_bridge.WebSceneMediaEsFrameForPositionMs(999999)
    if frameAtFar != frames - 1:
        return fail(strutil.Join(["FrameForPositionMs(999999) mismatch: got=", IntToStr(frameAtFar), " want=", IntToStr(frames - 1)], ""))
    os.WriteLine(os.Get_stdout(), "step4_upper_boundary_ok")

    # 4. Mid-clip conversion, independent formula computed from raw inputs (not by calling
    # the function under test a second time).
    let targetMs: int32 = 4100
    let expectedFrame: int32 = (targetMs * fps) / 1000
    if expectedFrame != 123:
        return fail(strutil.Join(["test's own independent formula drifted: got=", IntToStr(expectedFrame), " want=123"], ""))
    let gotFrame: int32 = media_bridge.WebSceneMediaEsFrameForPositionMs(targetMs)
    if gotFrame != expectedFrame:
        return fail(strutil.Join(["FrameForPositionMs(4100) mismatch: got=", IntToStr(gotFrame), " want=", IntToStr(expectedFrame)], ""))
    os.WriteLine(os.Get_stdout(), strutil.Join(["step5_midpoint_conversion_ok frame=", IntToStr(gotFrame)], ""))

    # 5. SeekToPositionMs snaps the non-keyframe-aligned target (123) down to the real
    # nearest keyframe (120), via the EXISTING SeekToFrame/SnapToKeyFrame — not a second,
    # unsnapped code path.
    if !media_bridge.WebSceneMediaEsSeekToPositionMs(targetMs):
        return fail("SeekToPositionMs returned false")
    let cursor: int32 = media_bridge.WebSceneMediaEsPumpCursor()
    if cursor != 120:
        return fail(strutil.Join(["pump cursor after SeekToPositionMs(4100) mismatch: got=", IntToStr(cursor), " want=120 (nearest real keyframe)"], ""))
    os.WriteLine(os.Get_stdout(), strutil.Join(["step6_snap_to_keyframe_ok cursor=", IntToStr(cursor)], ""))

    # 6. Round-trip: cursor -> ms lands on the SNAPPED position (4000), not the original
    # drag target (4100) and not some drifted value — "seek 后游标一致".
    let roundTripMs: int32 = media_bridge.WebSceneMediaEsPositionMsForFrame(cursor)
    if roundTripMs != 4000:
        return fail(strutil.Join(["PositionMsForFrame(120) mismatch: got=", IntToStr(roundTripMs), " want=4000"], ""))
    os.WriteLine(os.Get_stdout(), "step7_cursor_roundtrip_consistent_ok")

    # 7. The transport layer actually delivers the snapped frame, not just an in-memory
    # cursor variable nobody reads.
    let loopRc: int32 = media_bridge.WebSceneMediaEsStreamLoop()
    if loopRc != 0:
        return fail(strutil.Join(["StreamLoop unexpected rc=", IntToStr(loopRc)], ""))
    if chengTestEsSinkCaptured() != 1:
        return fail(strutil.Join(["sink captured count=", IntToStr(chengTestEsSinkCaptured()), " want=1 (stub stops after one frame)"], ""))
    let gotFrameIdx: int32 = chengTestEsSinkFirstFrameIdx()
    if gotFrameIdx != 120:
        return fail(strutil.Join(["sink delivered frameIdx=", IntToStr(gotFrameIdx), " want=120"], ""))
    os.WriteLine(os.Get_stdout(), strutil.Join(["step8_stream_loop_delivered_snapped_frame_ok frameIdx=", IntToStr(gotFrameIdx)], ""))

    os.WriteLine(os.Get_stdout(), "CONV_OK")
    return 0

# Shared by both replay modes: open, SeekToPositionMs(targetMs), run exactly one
# StreamLoop tick, and print what the desktop sink actually captured — the CALLER (shell
# harness, which owns the publisher's stderr log) decides cache-hit-vs-miss pass/fail from
# its own request-count diff, exactly like media_moq_es_prefetch_tick_check_main.cheng's
# runReplay does for the frame-indexed SeekToFrame entry point.
fn runReplay(host: str, port: int32, root: str, targetMs: int32, expectedFrameIdx: int32, label: str): int32 =
    if !blockcache.WebSceneMediaBlockCacheInit(root):
        return fail(strutil.Join(["Init(root) failed: ", root], ""))
    if !media_bridge.WebSceneMediaEsOpen(host, port):
        return fail(strutil.Join(["es_open failed: ", media_bridge.WebSceneMediaEsLastError()], ""))
    if !media_bridge.WebSceneMediaEsSeekToPositionMs(targetMs):
        return fail("SeekToPositionMs returned false")
    let cursor: int32 = media_bridge.WebSceneMediaEsPumpCursor()
    if cursor != expectedFrameIdx:
        return fail(strutil.Join(["pump cursor mismatch: got=", IntToStr(cursor), " want=", IntToStr(expectedFrameIdx)], ""))
    os.WriteLine(os.Get_stdout(), "step1_seek_ok")

    let rc: int32 = media_bridge.WebSceneMediaEsStreamLoop()
    if rc != 0:
        return fail(strutil.Join(["StreamLoop unexpected rc=", IntToStr(rc)], ""))
    if chengTestEsSinkCaptured() != 1:
        return fail(strutil.Join(["sink captured count=", IntToStr(chengTestEsSinkCaptured()), " want=1 (stub stops after one frame)"], ""))
    let gotFrameIdx: int32 = chengTestEsSinkFirstFrameIdx()
    if gotFrameIdx != expectedFrameIdx:
        return fail(strutil.Join(["sink delivered frameIdx=", IntToStr(gotFrameIdx), " want=", IntToStr(expectedFrameIdx)], ""))
    os.WriteLine(os.Get_stdout(), strutil.Join(["step2_stream_loop_delivered_frame_ok frameIdx=", IntToStr(gotFrameIdx)], ""))

    os.WriteLine(os.Get_stdout(), strutil.Join([label, "_OK"], ""))
    return 0

fn main(): int32 =
    var hostRaw: str
    let hasHost: bool = cmdline.ReadFirstFlagValue("--host", hostRaw)
    let host: str = if hasHost: hostRaw else: "127.0.0.1"
    let port: int32 = cmdline.ReadInt32FlagOrDefault("--port", 38000)
    var modeRaw: str
    let hasMode: bool = cmdline.ReadFirstFlagValue("--mode", modeRaw)
    let mode: str = if hasMode: modeRaw else: "conv"

    if mode == "conv":
        return runConv(host, port)
    var rootRaw: str
    let hasRoot: bool = cmdline.ReadFirstFlagValue("--root", rootRaw)
    if !hasRoot:
        return fail("missing --root")
    if mode == "replay-cached":
        return runReplay(host, port, rootRaw, 4000, 120, "REPLAY_CACHED")
    if mode == "replay-miss":
        return runReplay(host, port, rootRaw, 0, 0, "REPLAY_MISS")
    return fail(strutil.Join(["unknown --mode: ", mode], ""))
