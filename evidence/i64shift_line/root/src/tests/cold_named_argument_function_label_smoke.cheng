@importc("cold_named_argument_external_label")
fn externalLabel(): int32

fn localLabel(): int32 =
    return 101

fn genericLabel[T](): int32 =
    return 202

fn collect(localLabel: int32, genericLabel: int32, externalLabel: int32): int32 =
    return localLabel + genericLabel + externalLabel

fn main(): int32 =
    return collect(localLabel: 7, genericLabel: 11, externalLabel: 13) - 31
