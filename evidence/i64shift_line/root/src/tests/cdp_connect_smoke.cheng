# cdp_connect_smoke.cheng - CDP connectivity test
# Just connects to Chrome DevTools, discovers pages, and exits.

import cheng/core/runtime/cdp_client as cdp
import std/strings

fn main(): int32 =
    # Connect and discover pages
    var conn = cdp.cdpTcpConnect(9222)
    if !cdp.cdpIsAlive(conn):
        return 1
    
    var pagesJson = cdp.cdpDiscoverPages(conn)
    cdp.cdpDisconnect(conn)
    
    if strings.len(pagesJson) > 0:
        return 0
    return 2
