import std/system

fn main(): int32 =
    let counters = system.RuntimeMemoryCountersSnapshotQuiescent()
    assert(counters.allocTotal >= counters.freeTotal,
           " runtime memory counters: free exceeds alloc")
    assert(counters.allocTotal - counters.freeTotal == counters.liveTotal,
           " runtime memory counters: live invariant")
    assert(system.MemLiveAllocations() == counters.liveTotal,
           " runtime memory counters: live authority drift")
    echo(" runtime_memory_counters_contract_smoke ok")
    return 0
