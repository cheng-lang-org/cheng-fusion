# frontier9 / bail=44 / site1 — 嵌套 call + 带调用下标实参
#
# 归属 lane: op-lane (共享后端 primary_object_plan.cheng)
# 真源站点: LoweringBuildOneFunctionInto (src/core/backend/lowering_plan.cheng:3203)
#   `let returnNode = texpr.TypedExprIrNode(... nodeIndex: arenamod.ArenaArrayInt32Get(
#      plan.typedIr.arena, plan.typedIr.nodes2_nodeIndexs,
#      arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.functions2_returnNodeIndexs, typedFnIndex)) ...)`
#   → 构造子(named-arg call)的某个实参本身是"外层 call 其下标又是 call"的嵌套形态。
# 共享根: PrimaryBodyIrAppendCallArgs (primary_object_plan.cheng:18765-20231) 对该
#   实参降级失败, 落穿到 :19434 callarg_fi_node_missing → failureDetail0=44。
# w8 macOS 前沿观测: bail=44, stmt_kind=2, detail1(failing argIndex)=1。
#
# ★ 本夹具在 pinned driver b56f05b3be9ebd1d71a3645097680c6d 上【编译干净 count=0】
#   (2026-07-03 实测 rc=0 obj=735)。它不是 bail 见证, 而是 arg-form 规格 + runtime-golden
#   哨兵: op-lane 扩 realizer 覆盖后此形态必须仍编译干净且运行时正确。
#   真正的 bail=44 只在整编 src/core/tooling/backend_driver_dispatch_min.cheng --emit:exe
#   (整个编译器) 的 in-context 类型解析 miss 下复现; 本 Linux 机整编在前端
#   typed-facts (primary_object_plan.cheng expr_count=47141) SIGSEGV(rc=139), 复现须走
#   参考(macOS)驱动。三重验证协议见 docs/beat-c-exe-frontier9-handoff-2026-07-03.md。

type Node =
    kind: int32
    text: str

fn pickIdx(i: int32): int32 =
    return i

fn kindOf(n: Node): int32 =
    return n.kind

# 触发形态: 实参 nodes[pickIdx(i)] = 下标是 call 的索引访问, 再整体作 kindOf 的实参。
fn probe(nodes: Node[], i: int32): int32 =
    return kindOf(nodes[pickIdx(i)])

fn main(): int32 =
    var nodes: Node[]
    return probe(nodes, 0)
