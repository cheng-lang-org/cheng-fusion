import std/os
import cheng/core/lang/parser as parser
import cheng/core/lang/typed_expr as texpr

fn main(): int32 =
    let root = os.GetCurrentDir()
    let sourcePath = Fmt"{root}/src/tests/typed_expr_source_line_index_virtual.cheng"
    let sourceText = "let GlobalLet: int32 = 1\r\nvar\r\n    GlobalVar: int32\r\nconst GlobalConst: int32 = 3\r\n\r\nfn First(): str =\r\n    return \"\"\"\r\n        alpha\r\n        beta\r\n        \"\"\"\r\n\r\nfn Middle(): int32 =\r\n    return 2\r\n\r\nfn Third(): int32 =\r\n    return GlobalLet + GlobalConst\r\n"
    var externalRoots: parser.ParserExternalPackageRoot[]
    var profile: parser.NormalizedExprCallProfile
    var err: str
    assert(parser.ParserBuildExprCallProfileWithExternalPackageRoots(
               root,
               root,
               externalRoots,
               sourcePath,
               sourceText,
               profile,
               err),
           Fmt"typed expr sealed line index: profile failed {err}")
    var source = texpr.TypedExprSourceTextBorrowPackageFacts(
        root,
        root,
        "typed-expr-source-line-index-smoke",
        "",
        externalRoots,
        sourcePath,
        sourceText)
    source.snapshotOnly = true
    var metadata: texpr.TypedExprSourceContext
    assert(texpr.TypedExprBuildMetadataContextFromProfile(
               profile, source, metadata, err),
           Fmt"typed expr sealed line index: metadata failed {err}")
    assert(metadata.sourceIndexProducerFullTraversalCount == 1 &&
           metadata.sourceLineCount == profile.lines.len &&
           metadata.sourceLineByteStarts.len == profile.lines.len &&
           metadata.sourceLineByteLengths.len == profile.lines.len &&
           metadata.sourceLineOverrideIndexes.len == profile.lines.len &&
           metadata.sourceLineByteLengths[
               metadata.sourceLineByteLengths.len - 1] == 0,
           "typed expr sealed line index: raw line domain mismatch")
    var overrideCount: int32
    for lineIndex in 0..<metadata.sourceLineOverrideIndexes.len:
        let overrideIndex = metadata.sourceLineOverrideIndexes[lineIndex]
        if overrideIndex < 0:
            continue
        assert(overrideIndex == overrideCount,
               "typed expr sealed line index: override order drift")
        overrideCount = overrideCount + 1
    assert(overrideCount == metadata.sourceLineOverrideTexts.len &&
           overrideCount > 0,
           "typed expr sealed line index: multiline/CRLF override missing")

    var globalBindingCount: int32
    for bindingIndex in 0..<metadata.bindings.len:
        assert(metadata.bindings[bindingIndex].globalFlag,
               "typed expr sealed line index: local binding retained in metadata")
        globalBindingCount = globalBindingCount + 1
    assert(globalBindingCount == 3,
           Fmt"typed expr sealed line index: global binding count {globalBindingCount}")

    var contexts = [metadata]
    let buildIndex = texpr.TypedExprBuildIndexForContexts(contexts, 64)
    var contextLookup: parser.ParserSourcePathIndexLookup
    assert(texpr.TypedExprBuildSourceContextExactIndex(
               contexts, contextLookup, err),
           Fmt"typed expr sealed line index: context lookup failed {err}")
    var functionIndexes: int32[]
    var functionSourcePaths: str[]
    var functionStartLines: int32[]
    var functionEndLines: int32[]
    var functionSelected: bool[]
    var middleStartLine: int32
    for scopeIndex in 0..<contexts[0].scopes.len:
        let scope = contexts[0].scopes[scopeIndex]
        add(functionSourcePaths, sourcePath)
        add(functionStartLines, scope.startLine)
        add(functionEndLines, scope.endLine)
        let selected = scope.name == "First" || scope.name == "Third"
        add(functionSelected, selected)
        if selected:
            add(functionIndexes, scopeIndex)
        if scope.name == "Middle":
            middleStartLine = scope.startLine
    assert(functionIndexes.len == 2 && middleStartLine > 0,
           "typed expr sealed line index: non-adjacent range setup failed")
    var sourceTexts = [source]
    var reusable: texpr.TypedExprSourceContext
    assert(texpr.TypedExprBuildReusableFactsSourceContext(
               sourceTexts,
               0,
               contexts,
               contextLookup,
               functionIndexes,
               functionSourcePaths,
               functionStartLines,
               functionEndLines,
               functionSelected,
               true,
               0,
               functionIndexes.len,
               reusable,
               err),
           Fmt"typed expr sealed line index: reusable build failed {err}")
    assert(reusable.sourceIndexProducerFullTraversalCount == 1 &&
           reusable.factsFullSourceRescanCount == 0 &&
           reusable.factsSelectedScopeVisitCount == Int64(2) &&
           reusable.factsSelectedLineVisitCount == Int64(reusable.lines.len) &&
           reusable.factsSelectedLineBytes > Int64(0) &&
           reusable.factsGlobalBindingVisitCount == Int64(3) &&
           reusable.factsGlobalBindingVisitCount <=
               reusable.factsSelectedBindingVisitCount,
           "typed expr sealed line index: producer/consumer telemetry mismatch")
    assert(texpr.TypedExprSourceContextLineIndex(reusable,
                                                  middleStartLine) < 0,
           "typed expr sealed line index: unselected middle range visited")
    assert(reusable.lineNumbers.len < metadata.sourceLineCount,
           "typed expr sealed line index: reusable path traversed full line domain")
    echo(Fmt"source_index_producer_full_traversal_count={reusable.sourceIndexProducerFullTraversalCount}")
    echo(Fmt"reusable_full_source_rescan_count={reusable.factsFullSourceRescanCount}")
    echo(Fmt"reusable_selected_line_visit_count={reusable.factsSelectedLineVisitCount}")
    echo(Fmt"reusable_selected_line_bytes={reusable.factsSelectedLineBytes}")
    echo(Fmt"reusable_global_binding_visit_count={reusable.factsGlobalBindingVisitCount}")
    echo("typed_expr_sealed_source_line_index_smoke ok")
    texpr.TypedExprReleaseReusableFactsSourceContext(reusable)
    for contextIndex in 0..<contexts.len:
        texpr.TypedExprClearSourceContextAllFields(contexts[contextIndex])
    texpr.TypedExprBuildIndexRelease(buildIndex)
    return 0
