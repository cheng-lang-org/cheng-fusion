import std/monotimes as mono
import std/strings
import std/strutils as strutil
import cheng/core/lang/parser
import cheng/core/tooling/compiler_csg as ccsg

const
    BorrowProfileCount: int32 = 1024
    BorrowTargetIndex: int32 = 17
    BorrowRootIndex: int32 = 1023
    BorrowIterationCount: int32 = 128

fn MakeDecl(name: str, lineIndex: int32): parser.NormalizedFunctionDecl =
    var out: parser.NormalizedFunctionDecl
    out.name = name
    out.lineIndex = lineIndex
    return out

fn MakeTypeDecl(name: str): parser.NormalizedTypeDecl =
    var out: parser.NormalizedTypeDecl
    out.name = name
    return out

fn ConfigureSourceIndex(index: var ccsg.CompilerCsgSourcePathIndex,
                        root: str) =
    var externalRoots: parser.ParserExternalPackageRoot[]
    var err: str
    assert(ccsg.CompilerCsgSourcePathIndexConfigureRoots(index,
                                                         root,
                                                         root,
                                                         externalRoots,
                                                         err),
           strutil.Join([" compiler csg profile borrow: configure roots ", err], ""))

fn BuildBorrowProfiles(profiles: var parser.NormalizedExprCallProfile[]) =
    for profileIndex in 0..<BorrowProfileCount:
        var profile: parser.NormalizedExprCallProfile
        profile.sourcePath = strutil.Join(["/tmp/compiler_csg_profile_borrow/src/filler_",
                                           strings.IntToStr(profileIndex),
                                           ".cheng"], "")
        profile.ownerModulePath = "smoke/filler"
        profile.text = "fn Filler(): int32 =\n    return 0"
        add(profile.lines, "fn Filler(): int32 =")
        add(profile.lines, "    return 0")
        add(profile.decls, MakeDecl("Filler", 1))
        add(profile.typeDecls, MakeTypeDecl("FillerType"))
        add(profile.importcCallNames, "FillerImportc")
        add(profile.localCallNames, "Filler")
        add(profiles, profile)

    var target = profiles[BorrowTargetIndex]
    target.sourcePath = "/tmp/compiler_csg_profile_borrow/src/target.cheng"
    target.ownerModulePath = "smoke/target"
    target.decls = [MakeDecl("Target", 1)]
    target.typeDecls = [MakeTypeDecl("TargetType")]
    target.importcCallNames = ["TargetImportc"]
    target.localCallNames = ["Target"]
    profiles[BorrowTargetIndex] = target

    var root = profiles[BorrowRootIndex]
    root.sourcePath = "/tmp/compiler_csg_profile_borrow/src/root.cheng"
    root.ownerModulePath = "smoke/root"
    root.decls = [MakeDecl("Root", 1)]
    root.typeDecls = [MakeTypeDecl("RootType")]
    root.importcCallNames = ["RootImportc"]
    root.localCallNames = ["Root"]
    var edge: parser.ImportEdge
    edge.ownerModulePath = "smoke/root"
    edge.targetModulePath = "smoke/target"
    edge.targetSourcePath = target.sourcePath
    edge.targetProfileIndex = BorrowTargetIndex
    edge.importAlias = "target"
    edge.qualifier = "target"
    edge.resolved = true
    add(root.importEdges, edge)
    profiles[BorrowRootIndex] = root

fn CompactColumnGrowCount(length: int32, capacity: int32): int32 =
    assert(capacity >= length, " compiler csg profile borrow: invalid compact column capacity")
    return capacity - length + 1

fn GrowCompactDeclColumn(items: var parser.NormalizedFunctionDecl[]): int64 =
    let capBefore = items.cap
    let growCount = CompactColumnGrowCount(items.len, capBefore)
    for i in 0..<growCount:
        add(items, MakeDecl("CapacityDecl", i + 1))
    return Int64(items.cap - capBefore) *
           ccsg.CompilerCsgNormalizedFunctionDeclRowBytes()

fn GrowCompactTypeDeclColumn(items: var parser.NormalizedTypeDecl[]): int64 =
    let capBefore = items.cap
    let growCount = CompactColumnGrowCount(items.len, capBefore)
    for i in 0..<growCount:
        add(items, MakeTypeDecl("CapacityType"))
    return Int64(items.cap - capBefore) *
           ccsg.CompilerCsgNormalizedTypeDeclRowBytes()

fn GrowCompactImportcNameColumn(items: var str[]): int64 =
    let capBefore = items.cap
    let growCount = CompactColumnGrowCount(items.len, capBefore)
    for i in 0..<growCount:
        add(items, "CapacityImportc")
    return Int64(items.cap - capBefore) *
           ccsg.CompilerCsgStrHeaderBytes()

fn GrowCompactLocalNameColumn(items: var str[]): int64 =
    let capBefore = items.cap
    let growCount = CompactColumnGrowCount(items.len, capBefore)
    for i in 0..<growCount:
        add(items, "CapacityLocal")
    return Int64(items.cap - capBefore) *
           ccsg.CompilerCsgStrHeaderBytes()

fn GrowCompactImportEdgeColumn(items: var parser.ImportEdge[]): int64 =
    let capBefore = items.cap
    let growCount = CompactColumnGrowCount(items.len, capBefore)
    for i in 0..<growCount:
        var edge: parser.ImportEdge
        edge.targetProfileIndex = 1
        add(items, edge)
    return Int64(items.cap - capBefore) *
           ccsg.CompilerCsgImportEdgeRowBytes()

fn AssertCompactProfileColumnCapacityDeltas(
        view: var ccsg.CompilerCsgCompactProfileView): int64 =
    assert(view.profiles.len > 0 && view.profiles[0].decls.len > 0 &&
           view.profiles[0].typeDecls.len > 0 &&
           view.profiles[0].importcCallNames.len > 0 &&
           view.profiles[0].localCallNames.len > 0 &&
           view.profiles[0].importEdges.len > 0,
           " compiler csg profile borrow: compact owned columns missing")
    var checksum: int64

    let declBytesBefore = ccsg.CompilerCsgCompactProfileViewCapacityBytes(view)
    let declExpected = GrowCompactDeclColumn(view.profiles[0].decls)
    let declBytesAfter = ccsg.CompilerCsgCompactProfileViewCapacityBytes(view)
    assert(declExpected > Int64(0) &&
           declBytesAfter - declBytesBefore == declExpected,
           " compiler csg profile borrow: decl capacity delta")
    checksum = checksum + declExpected

    let typeBytesBefore = ccsg.CompilerCsgCompactProfileViewCapacityBytes(view)
    let typeExpected = GrowCompactTypeDeclColumn(view.profiles[0].typeDecls)
    let typeBytesAfter = ccsg.CompilerCsgCompactProfileViewCapacityBytes(view)
    assert(typeExpected > Int64(0) &&
           typeBytesAfter - typeBytesBefore == typeExpected,
           " compiler csg profile borrow: type-decl capacity delta")
    checksum = checksum + typeExpected

    let importcBytesBefore = ccsg.CompilerCsgCompactProfileViewCapacityBytes(view)
    let importcExpected = GrowCompactImportcNameColumn(view.profiles[0].importcCallNames)
    let importcBytesAfter = ccsg.CompilerCsgCompactProfileViewCapacityBytes(view)
    assert(importcExpected > Int64(0) &&
           importcBytesAfter - importcBytesBefore == importcExpected,
           " compiler csg profile borrow: importc-name capacity delta")
    checksum = checksum + importcExpected

    let localBytesBefore = ccsg.CompilerCsgCompactProfileViewCapacityBytes(view)
    let localExpected = GrowCompactLocalNameColumn(view.profiles[0].localCallNames)
    let localBytesAfter = ccsg.CompilerCsgCompactProfileViewCapacityBytes(view)
    assert(localExpected > Int64(0) &&
           localBytesAfter - localBytesBefore == localExpected,
           " compiler csg profile borrow: local-name capacity delta")
    checksum = checksum + localExpected

    let edgeBytesBefore = ccsg.CompilerCsgCompactProfileViewCapacityBytes(view)
    let edgeExpected = GrowCompactImportEdgeColumn(view.profiles[0].importEdges)
    let edgeBytesAfter = ccsg.CompilerCsgCompactProfileViewCapacityBytes(view)
    assert(edgeExpected > Int64(0) &&
           edgeBytesAfter - edgeBytesBefore == edgeExpected,
           " compiler csg profile borrow: import-edge capacity delta")
    return checksum + edgeExpected

fn AssertCompactViewBorrowScalesWithClosure(): int64 =
    var profiles: parser.NormalizedExprCallProfile[]
    BuildBorrowProfiles(profiles)
    var profileIndexLookup = parser.ParserSourcePathIndexLookupBuild(profiles)
    var cache: ccsg.CompilerCsgProfileCallLookupStore
    var checksum: int64
    var maxViewBytes: int64
    var columnDeltaChecksum: int64
    let started = mono.GetMonoTime()
    for iteration in 0..<BorrowIterationCount:
        var view: ccsg.CompilerCsgCompactProfileView
        var err: str
        assert(ccsg.CompilerCsgCompactProfileViewBuild(profiles,
                                                       profileIndexLookup,
                                                       cache,
                                                       BorrowRootIndex,
                                                       view,
                                                       err),
               strutil.Join([" compiler csg profile borrow: compact view ", err], ""))
        assert(view.profiles.len == 2 && view.originalIndexes.len == 2 &&
               view.originalIndexes[0] == BorrowRootIndex &&
               view.originalIndexes[1] == BorrowTargetIndex &&
               view.profiles[0].importEdges.len == 1 &&
               view.profiles[0].importEdges[0].targetProfileIndex == 1 &&
               view.profiles[0].decls.len > 0 &&
               view.profiles[0].typeDecls.len > 0 &&
               view.profiles[0].importcCallNames.len > 0 &&
               view.profiles[0].localCallNames.len > 0 &&
               view.profiles[0].text == "" && view.profiles[0].lines.len == 0 &&
               view.profiles[1].text == "" && view.profiles[1].lines.len == 0 &&
               view.profiles[1].sourcePath == profiles[BorrowTargetIndex].sourcePath,
               " compiler csg profile borrow: compact closure semantics")
        if iteration == 0:
            columnDeltaChecksum = AssertCompactProfileColumnCapacityDeltas(view)
        let viewBytes = ccsg.CompilerCsgCompactProfileViewCapacityBytes(view)
        if viewBytes > maxViewBytes:
            maxViewBytes = viewBytes
        checksum = checksum + Int64(view.profiles.len + view.originalIndexes.len) + viewBytes
    let elapsedNs = mono.MonoTimeNs(mono.GetMonoTime()) - mono.MonoTimeNs(started)
    assert(checksum > Int64(0) && maxViewBytes > Int64(0) &&
           columnDeltaChecksum > Int64(0),
           " compiler csg profile borrow: benchmark work eliminated")
    assert(profiles.len == BorrowProfileCount &&
           profiles[BorrowRootIndex].sourcePath == "/tmp/compiler_csg_profile_borrow/src/root.cheng" &&
           profiles[BorrowRootIndex].importEdges.len == 1 &&
           profiles[BorrowRootIndex].importEdges[0].targetProfileIndex == BorrowTargetIndex &&
           profiles[BorrowRootIndex].text != "" &&
           profiles[BorrowRootIndex].lines.len == 2 &&
           profiles[BorrowRootIndex].typeDecls.len == 1 &&
           profiles[BorrowRootIndex].importcCallNames.len == 1 &&
           profiles[BorrowTargetIndex].localCallNames.len == 1 &&
           profiles[BorrowTargetIndex].localCallNames[0] == "Target",
           " compiler csg profile borrow: borrowed domain mutated")
    echo(strutil.Join(["profile_borrow_profile_count=", strings.IntToStr(BorrowProfileCount)], ""))
    echo(strutil.Join(["profile_borrow_iterations=", strings.IntToStr(BorrowIterationCount)], ""))
    echo(strutil.Join(["profile_borrow_max_compact_view_bytes=", strings.Int64ToStr(maxViewBytes)], ""))
    echo(strutil.Join(["profile_borrow_elapsed_ns=", strings.Int64ToStr(elapsedNs)], ""))
    return elapsedNs

fn BuildLateProfiles(rootPath: str,
                     leafPath: str,
                     profiles: var parser.NormalizedExprCallProfile[]) =
    var root: parser.NormalizedExprCallProfile
    root.sourcePath = rootPath
    root.ownerModulePath = "smoke/root"
    root.text = "fn Entry(): int32 =\n    return 0\n\nfn Late(): int32 =\n    leaf.Leaf()\n    return 0\n\nfn ParamShadow(leaf: int32): int32 =\n    leaf.Leaf()\n    return 0\n\nfn LocalShadow(): int32 =\n    let leaf = 0\n    leaf.Leaf()\n    return 0"
    root.lines = ["fn Entry(): int32 =",
                  "    return 0",
                  "",
                  "fn Late(): int32 =",
                  "    leaf.Leaf()",
                  "    return 0",
                  "",
                  "fn ParamShadow(leaf: int32): int32 =",
                  "    leaf.Leaf()",
                  "    return 0",
                  "",
                  "fn LocalShadow(): int32 =",
                  "    let leaf = 0",
                  "    leaf.Leaf()",
                  "    return 0"]
    root.decls = [MakeDecl("Entry", 1),
                  MakeDecl("Late", 4),
                  MakeDecl("ParamShadow", 8),
                  MakeDecl("LocalShadow", 12)]
    root.localCallNames = ["Entry", "Late", "ParamShadow", "LocalShadow"]
    var edge: parser.ImportEdge
    edge.ownerModulePath = "smoke/root"
    edge.targetModulePath = "smoke/leaf"
    edge.targetSourcePath = leafPath
    edge.targetProfileIndex = 1
    edge.importAlias = "leaf"
    edge.qualifier = "leaf"
    edge.resolved = true
    add(root.importEdges, edge)

    var leaf: parser.NormalizedExprCallProfile
    leaf.sourcePath = leafPath
    leaf.ownerModulePath = "smoke/leaf"
    leaf.text = "fn Leaf(): int32 =\n    return 1"
    leaf.lines = ["fn Leaf(): int32 =", "    return 1"]
    leaf.decls = [MakeDecl("Leaf", 1)]
    leaf.localCallNames = ["Leaf"]
    profiles = [root, leaf]

fn AssertNoExternalCallAtLine(layer: var parser.NormalizedExprLayer,
                              lineNumber: int32,
                              label: str) =
    for exprIndex in 0..<layer.exprs.len:
        let expr = layer.exprs[exprIndex]
        if expr.lineNumber != lineNumber || expr.kind != parser.NormalizedExprCall:
            continue
        assert(expr.callSurfaceKind != parser.NormalizedExprSurfaceCallExternal,
               strutil.Join([" compiler csg profile borrow: external shadow fact ", label], ""))

fn AssertExternalCallAtLine(layer: var parser.NormalizedExprLayer,
                            lineNumber: int32,
                            expectedTarget: str) =
    var found = false
    for exprIndex in 0..<layer.exprs.len:
        let expr = layer.exprs[exprIndex]
        if expr.lineNumber != lineNumber || expr.kind != parser.NormalizedExprCall:
            continue
        if expr.callSurfaceKind == parser.NormalizedExprSurfaceCallExternal &&
           expr.callTarget == expectedTarget:
            found = true
    assert(found,
           " compiler csg profile borrow: unshadowed external control missing")

fn AssertLateReachabilityAfterProfileRelease() =
    let rootDir = "/tmp/compiler_csg_profile_release"
    let rootPath = "/tmp/compiler_csg_profile_release/src/root.cheng"
    let leafPath = "/tmp/compiler_csg_profile_release/src/leaf.cheng"
    var profiles: parser.NormalizedExprCallProfile[]
    BuildLateProfiles(rootPath, leafPath, profiles)

    var sourceIndex = ccsg.CompilerCsgSourcePathIndexInit(8)
    ConfigureSourceIndex(sourceIndex, rootDir)
    var err: str
    assert(ccsg.CompilerCsgSourcePathIndexRegister(sourceIndex, rootPath, 0, err) &&
           ccsg.CompilerCsgSourcePathIndexRegister(sourceIndex, leafPath, 1, err),
           strutil.Join([" compiler csg profile borrow: source index ", err], ""))

    var snapshots: ccsg.CompilerCsgSourceText[]
    var snapshotIndex = ccsg.CompilerCsgSourcePathIndexInit(8)
    ConfigureSourceIndex(snapshotIndex, rootDir)
    assert(ccsg.CompilerCsgCaptureImmutableSourceSnapshot(snapshots,
                                                          snapshotIndex,
                                                          rootPath,
                                                          "smoke/root",
                                                          profiles[0].text,
                                                          err) &&
           ccsg.CompilerCsgCaptureImmutableSourceSnapshot(snapshots,
                                                          snapshotIndex,
                                                          leafPath,
                                                          "smoke/leaf",
                                                          profiles[1].text,
                                                          err),
           strutil.Join([" compiler csg profile borrow: snapshots ", err], ""))

    var set = ccsg.CompilerCsgReachableFunctionSetInit(true)
    var modules: str[] = ["smoke/root", "smoke/leaf"]
    var lineCounts: int32[] = [15, 2]
    assert(ccsg.CompilerCsgReachableAddFunctionsFromProfiles(set,
                                                             profiles,
                                                             modules,
                                                             lineCounts,
                                                             sourceIndex,
                                                             err),
           strutil.Join([" compiler csg profile borrow: functions ", err], ""))
    let entryIndex = ccsg.CompilerCsgReachableFindFunction(set, rootPath, "Entry")
    let lateIndex = ccsg.CompilerCsgReachableFindFunction(set, rootPath, "Late")
    let paramShadowIndex = ccsg.CompilerCsgReachableFindFunction(set,
                                                                 rootPath,
                                                                 "ParamShadow")
    let localShadowIndex = ccsg.CompilerCsgReachableFindFunction(set,
                                                                 rootPath,
                                                                 "LocalShadow")
    let leafIndex = ccsg.CompilerCsgReachableFindFunction(set, leafPath, "Leaf")
    assert(entryIndex >= 0 && lateIndex >= 0 && paramShadowIndex >= 0 &&
           localShadowIndex >= 0 && leafIndex >= 0,
           " compiler csg profile borrow: function lookup")
    var frontier: int32[]
    ccsg.CompilerCsgReachableMark(set, entryIndex, frontier)
    ccsg.CompilerCsgReachableExpand(set, frontier)

    var profileIndexLookup = parser.ParserSourcePathIndexLookupBuild(profiles)
    var cache: ccsg.CompilerCsgProfileCallLookupStore
    var processedFunctions: bool[]
    var localScannedProfiles: bool[]
    var reachableCursor: int32
    var queuedProfiles: bool[]
    var pendingProfiles: int32[]
    assert(ccsg.CompilerCsgScanReachableSourceProfiles(snapshots,
                                                       snapshotIndex,
                                                       profiles,
                                                       profileIndexLookup,
                                                       cache,
                                                       set,
                                                       processedFunctions,
                                                       localScannedProfiles,
                                                       reachableCursor,
                                                       queuedProfiles,
                                                       pendingProfiles,
                                                       err),
           strutil.Join([" compiler csg profile borrow: initial scan ", err], ""))
    assert(set.reachable[entryIndex] && !set.reachable[lateIndex] &&
           !set.reachable[paramShadowIndex] && !set.reachable[localShadowIndex] &&
           !set.reachable[leafIndex],
           " compiler csg profile borrow: target reached before late root")

    ccsg.CompilerCsgCompactProfilesForFixedPoint(profiles)
    assert(profiles[0].text == "" && profiles[0].lines.len == 0 &&
           profiles[1].text == "" && profiles[1].lines.len == 0 &&
           profiles[0].decls.len == 4 && profiles[0].importEdges.len == 1 &&
           profiles[1].decls.len == 1 && profiles[1].localCallNames[0] == "Leaf",
           " compiler csg profile borrow: compact release contract")

    let shadowEdgeCountBefore = set.edgeFrom.len
    frontier = []
    ccsg.CompilerCsgReachableMark(set, paramShadowIndex, frontier)
    ccsg.CompilerCsgReachableExpand(set, frontier)
    assert(ccsg.CompilerCsgScanReachableSourceProfiles(snapshots,
                                                       snapshotIndex,
                                                       profiles,
                                                       profileIndexLookup,
                                                       cache,
                                                       set,
                                                       processedFunctions,
                                                       localScannedProfiles,
                                                       reachableCursor,
                                                       queuedProfiles,
                                                       pendingProfiles,
                                                       err),
           strutil.Join([" compiler csg profile borrow: param shadow scan ", err], ""))
    assert(set.reachable[paramShadowIndex] && !set.reachable[leafIndex] &&
           set.edgeFrom.len == shadowEdgeCountBefore,
           " compiler csg profile borrow: parameter shadow emitted external edge")

    frontier = []
    ccsg.CompilerCsgReachableMark(set, localShadowIndex, frontier)
    ccsg.CompilerCsgReachableExpand(set, frontier)
    assert(ccsg.CompilerCsgScanReachableSourceProfiles(snapshots,
                                                       snapshotIndex,
                                                       profiles,
                                                       profileIndexLookup,
                                                       cache,
                                                       set,
                                                       processedFunctions,
                                                       localScannedProfiles,
                                                       reachableCursor,
                                                       queuedProfiles,
                                                       pendingProfiles,
                                                       err),
           strutil.Join([" compiler csg profile borrow: local shadow scan ", err], ""))
    assert(set.reachable[localShadowIndex] && !set.reachable[leafIndex] &&
           set.edgeFrom.len == shadowEdgeCountBefore,
           " compiler csg profile borrow: local shadow emitted external edge")

    var restoredRootText: str
    assert(ccsg.CompilerCsgImmutableSourceSnapshotText(snapshots,
                                                        snapshotIndex,
                                                        rootPath,
                                                        restoredRootText,
                                                        err),
           strutil.Join([" compiler csg profile borrow: restore shadow source ", err], ""))
    var restoredRootLines = parser.ParserSplitChar(restoredRootText, '\n')
    parser.ParserJoinContinuationLinesInPlace(restoredRootLines)
    var localNames: str[] = ["Entry", "Late", "ParamShadow", "LocalShadow"]
    var paramExternalNames: str[] = ["leaf.Leaf"]
    var noCallNames: str[]
    var localCallLookup = parser.ParserTextLookupBuildExact(localNames)
    var paramExternalCallLookup = parser.ParserTextLookupBuildExact(paramExternalNames)
    var importcCallLookup = parser.ParserTextLookupBuildExact(noCallNames)
    var paramLayer: parser.NormalizedExprLayer
    let paramLayerRes = ccsg.CompilerCsgExprLayerForSparseProfileRange(
        rootPath,
        localCallLookup,
        paramExternalCallLookup,
        importcCallLookup,
        restoredRootLines,
        profiles,
        profileIndexLookup,
        cache,
        0,
        set,
        8,
        10,
        false,
        paramLayer)
    assert(IsOk(paramLayerRes),
           strutil.Join([" compiler csg profile borrow: param shadow normalize ",
                         Error(paramLayerRes)], ""))
    AssertNoExternalCallAtLine(paramLayer, 9, "parameter")

    var localExternalNames: str[] = ["leaf.Leaf"]
    var localExternalCallLookup = parser.ParserTextLookupBuildExact(localExternalNames)
    var localLayer: parser.NormalizedExprLayer
    let localLayerRes = ccsg.CompilerCsgExprLayerForSparseProfileRange(
        rootPath,
        localCallLookup,
        localExternalCallLookup,
        importcCallLookup,
        restoredRootLines,
        profiles,
        profileIndexLookup,
        cache,
        0,
        set,
        12,
        15,
        false,
        localLayer)
    assert(IsOk(localLayerRes),
           strutil.Join([" compiler csg profile borrow: local shadow normalize ",
                         Error(localLayerRes)], ""))
    AssertNoExternalCallAtLine(localLayer, 14, "local")
    assert(profiles[0].lines.len == 0 && profiles[1].lines.len == 0,
           " compiler csg profile borrow: explicit lines escaped into compact profile")

    frontier = []
    ccsg.CompilerCsgReachableMark(set, lateIndex, frontier)
    ccsg.CompilerCsgReachableExpand(set, frontier)
    var controlExternalNames: str[] = ["leaf.Leaf"]
    var controlExternalCallLookup = parser.ParserTextLookupBuildExact(controlExternalNames)
    var controlLayer: parser.NormalizedExprLayer
    let controlLayerRes = ccsg.CompilerCsgExprLayerForSparseProfileRange(
        rootPath,
        localCallLookup,
        controlExternalCallLookup,
        importcCallLookup,
        restoredRootLines,
        profiles,
        profileIndexLookup,
        cache,
        0,
        set,
        4,
        6,
        false,
        controlLayer)
    assert(IsOk(controlLayerRes),
           strutil.Join([" compiler csg profile borrow: external control normalize ",
                         Error(controlLayerRes)], ""))
    AssertExternalCallAtLine(controlLayer, 5, "leaf.Leaf")
    assert(ccsg.CompilerCsgScanReachableSourceProfiles(snapshots,
                                                       snapshotIndex,
                                                       profiles,
                                                       profileIndexLookup,
                                                       cache,
                                                       set,
                                                       processedFunctions,
                                                       localScannedProfiles,
                                                       reachableCursor,
                                                       queuedProfiles,
                                                       pendingProfiles,
                                                       err),
           strutil.Join([" compiler csg profile borrow: late scan ", err], ""))
    assert(set.reachable[lateIndex] && set.reachable[leafIndex] &&
           set.edgeFrom.len > shadowEdgeCountBefore &&
           profiles[0].lines.len == 0 && profiles[1].lines.len == 0,
           " compiler csg profile borrow: late target not reachable after release")

    var work: ccsg.CompilerCsgBuildWorkingSet
    work.exprCallProfiles = profiles
    work.profileIndexLookup = profileIndexLookup
    work.profileCallLookupCache = cache
    work.reachableSet = set
    work.sourceSnapshots = snapshots
    work.sourceSnapshotIndex = snapshotIndex
    ccsg.CompilerCsgBuildWorkingSetRelease(work)
    assert(work.exprCallProfiles.len == 0 &&
           work.profileIndexLookup.slots.len == 0 &&
           work.profileCallLookupCache.entries.len == 0 &&
           work.profileCallLookupCache.index.keys.len == 0 &&
           work.reachableSet.functionNames.len == 0 &&
           work.sourceSnapshots.len == 0,
           " compiler csg profile borrow: working-set release contract")

fn AssertExprLayerScopeCapacityAccounting() =
    var layer: parser.NormalizedExprLayer
    let bytesBefore = ccsg.CompilerCsgExprLayerCapacityBytesMode(layer, false)
    let capacityBefore = layer.scopes.cap
    var scope: parser.NormalizedScopeFact
    scope.sourcePath = "scope/accounting.cheng"
    add(layer.scopes, scope)
    let capacityDelta = layer.scopes.cap - capacityBefore
    assert(capacityDelta > 0,
           " compiler csg profile borrow: scope capacity did not grow")
    let borrowedBytes = ccsg.CompilerCsgExprLayerCapacityBytesMode(layer, false)
    let expectedDelta = Int64(capacityDelta) *
                        ccsg.CompilerCsgNormalizedScopeFactRowBytes()
    assert(borrowedBytes - bytesBefore == expectedDelta,
           " compiler csg profile borrow: scope row capacity delta")
    let ownedBytes = ccsg.CompilerCsgExprLayerCapacityBytesMode(layer, true)
    assert(ownedBytes - borrowedBytes == Int64(scope.sourcePath.len),
           " compiler csg profile borrow: scope source payload delta")
    let liveBytes = ccsg.CompilerCsgExprLayerLiveBytes(layer)
    assert(liveBytes == ccsg.CompilerCsgNormalizedScopeFactRowBytes() +
                        Int64(scope.sourcePath.len),
           " compiler csg profile borrow: scope logical live bytes")
    let retainedBytes = ccsg.CompilerCsgExprLayerSequenceBytes(layer, true)
    assert(retainedBytes - liveBytes ==
           Int64(layer.scopes.cap - layer.scopes.len) *
               ccsg.CompilerCsgNormalizedScopeFactRowBytes(),
           " compiler csg profile borrow: scope retained sequence bytes")

fn main(): int32 =
    let elapsedNs = AssertCompactViewBorrowScalesWithClosure()
    assert(elapsedNs >= Int64(0), " compiler csg profile borrow: monotonic clock")
    AssertLateReachabilityAfterProfileRelease()
    AssertExprLayerScopeCapacityAccounting()
    echo("compiler_csg_profile_payload_release_smoke ok")
    return 0
