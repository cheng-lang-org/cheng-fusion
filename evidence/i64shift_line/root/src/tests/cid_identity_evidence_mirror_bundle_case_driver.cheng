import std/cmdline
import std/os
import std/result
import std/strings
import std/strutils as strutil
import cheng/core/tooling/path as chengpath
import cheng/core/tooling/compiler_equivalence as ceq
import cheng/core/tooling/compiler_world_libp2p as cwlp

type
    CidEvidenceMirrorReports =
        baselineCsg: str
        baselineSemantic: str
        baselineSurface: str
        migratedCsg: str
        migratedSemantic: str
        migratedSurface: str
        migrationEvidence: str
        migrationProof: str

@borrows
fn CidEvidenceJoin(parts: str[]): str =
    return strutil.Join(parts, "")

@borrows
fn CidEvidenceRead(path: str,
                   out: var str): Result[bool] =
    let readRes = os.ReadFileResult(path)
    if IsErr(readRes):
        return Err[bool](Error(readRes))
    out = Value(readRes)
    if out == "":
        return Err[bool](CidEvidenceJoin([
            "CID evidence: empty mirror material: ",
            strings.CloneStr(path)]))
    return Ok[bool](true)

@borrows
fn CidEvidenceReadPayloadReports(
        artifactRoot: str,
        prefix: str,
        out: var CidEvidenceMirrorReports): Result[bool] =
    let roles = [
        "baseline_csg",
        "baseline_semantic",
        "baseline_surface",
        "migrated_csg",
        "migrated_semantic",
        "migrated_surface",
        "migration_evidence",
        "migration_proof"]
    var values: str[]
    for roleIndex in 0..<roles.len:
        var text = ""
        let readRes = CidEvidenceRead(
            chengpath.PathJoin(
                artifactRoot,
                CidEvidenceJoin([
                    "artifacts/",
                    strings.CloneStr(prefix),
                    strings.CloneStr(roles[roleIndex]),
                    ".bin"])),
            text)
        if IsErr(readRes):
            return Err[bool](Error(readRes))
        add(values, text)
    if values.len != 8:
        return Err[bool]("CID evidence: mirror report count")
    out.baselineCsg = strings.CloneStr(values[0])
    out.baselineSemantic = strings.CloneStr(values[1])
    out.baselineSurface = strings.CloneStr(values[2])
    out.migratedCsg = strings.CloneStr(values[3])
    out.migratedSemantic = strings.CloneStr(values[4])
    out.migratedSurface = strings.CloneStr(values[5])
    out.migrationEvidence = strings.CloneStr(values[6])
    out.migrationProof = strings.CloneStr(values[7])
    return Ok[bool](true)

@borrows
fn CidEvidenceReadDependencyReports(
        workRoot: str,
        out: var CidEvidenceMirrorReports): Result[bool] =
    let roles = [
        "baseline-csg",
        "baseline-semantic",
        "baseline-surface",
        "migrated-csg",
        "migrated-semantic",
        "migrated-surface",
        "migration-evidence",
        "migration-proof"]
    var values: str[]
    for roleIndex in 0..<roles.len:
        var text = ""
        let readRes = CidEvidenceRead(
            chengpath.PathJoin(
                workRoot,
                CidEvidenceJoin([
                    "mirror-dependency-",
                    strings.CloneStr(roles[roleIndex]),
                    ".kv"])),
            text)
        if IsErr(readRes):
            return Err[bool](Error(readRes))
        add(values, text)
    if values.len != 8:
        return Err[bool]("CID evidence: dependency report count")
    out.baselineCsg = strings.CloneStr(values[0])
    out.baselineSemantic = strings.CloneStr(values[1])
    out.baselineSurface = strings.CloneStr(values[2])
    out.migratedCsg = strings.CloneStr(values[3])
    out.migratedSemantic = strings.CloneStr(values[4])
    out.migratedSurface = strings.CloneStr(values[5])
    out.migrationEvidence = strings.CloneStr(values[6])
    out.migrationProof = strings.CloneStr(values[7])
    return Ok[bool](true)

@borrows
fn CidEvidencePlanBindingMatches(
        workRoot: str,
        label: str,
        reports: CidEvidenceMirrorReports): Result[bool] =
    let roles = ["csg", "semantic", "surface"]
    let expected = [
        strings.CloneStr(reports.migratedCsg),
        strings.CloneStr(reports.migratedSemantic),
        strings.CloneStr(reports.migratedSurface)]
    for roleIndex in 0..<roles.len:
        var actual = ""
        let readRes = CidEvidenceRead(
            chengpath.PathJoin(
                workRoot,
                CidEvidenceJoin([
                    "mirror-plan-",
                    strings.CloneStr(label),
                    "-",
                    strings.CloneStr(roles[roleIndex]),
                    ".kv"])),
            actual)
        if IsErr(readRes):
            return Err[bool](Error(readRes))
        if actual != expected[roleIndex]:
            return Err[bool](CidEvidenceJoin([
                "CID evidence: mirror plan binding mismatch: ",
                strings.CloneStr(label),
                "/",
                strings.CloneStr(roles[roleIndex])]))
    return Ok[bool](true)

@borrows
fn CidEvidenceBuildBundle(
        workspaceRoot: str,
        reports: CidEvidenceMirrorReports,
        out: var cwlp.CompilerManagedMirrorBundle): Result[bool] =
    let currentSourcePath = chengpath.PathJoin(
        workspaceRoot, "src/main.cheng")
    let legacySourcePath = chengpath.PathJoin(
        workspaceRoot, "legacy/main.cheng")
    var evidence: ceq.CompilerMigrationEvidence
    let evidenceRes = ceq.CompilerMigrationEvidenceFromReportText(
        strings.CloneStr(reports.migrationEvidence), evidence)
    if IsErr(evidenceRes):
        return Err[bool](Error(evidenceRes))
    var proof: ceq.CompilerMigrationSemanticProof
    let proofRes = ceq.CompilerMigrationSemanticProofFromReportText(
        strings.CloneStr(reports.migrationProof), proof)
    if IsErr(proofRes):
        return Err[bool](Error(proofRes))
    if evidence.unitCount != 1 ||
       evidence.orderedModulePaths.len != 1 ||
       evidence.orderedModulePaths[0] != evidence.entryModulePath:
        return Err[bool](
            "CID evidence: mirror bundle entry module mismatch")
    var currentText = ""
    var legacyText = ""
    let currentRes = CidEvidenceRead(currentSourcePath, currentText)
    if IsErr(currentRes):
        return Err[bool](Error(currentRes))
    let legacyRes = CidEvidenceRead(legacySourcePath, legacyText)
    if IsErr(legacyRes):
        return Err[bool](Error(legacyRes))
    let bundleRes =
        cwlp.CompilerWorldManagedMirrorBundleMakeFromAuthenticatedReports(
            [legacyText],
            [currentText],
            evidence,
            proof,
            strings.CloneStr(reports.baselineCsg),
            strings.CloneStr(reports.migratedCsg),
            strings.CloneStr(reports.baselineSurface),
            strings.CloneStr(reports.migratedSurface),
            strings.CloneStr(reports.baselineSemantic),
            strings.CloneStr(reports.migratedSemantic),
            out)
    if IsErr(bundleRes):
        return Err[bool](Error(bundleRes))
    return Ok[bool](true)

@borrows
fn CidEvidenceMirrorBundleStage(
        caseRoot: str,
        artifactRoot: str,
        compiledOutput: str): Result[bool] =
    var rootAReports: CidEvidenceMirrorReports
    let ownedArtifactRoot = strings.CloneStr(artifactRoot)
    let ownedCaseRoot = strings.CloneStr(caseRoot)
    let rootAReportsRes = CidEvidenceReadPayloadReports(
        strings.CloneStr(ownedArtifactRoot), "", rootAReports)
    if IsErr(rootAReportsRes):
        return Err[bool](Error(rootAReportsRes))
    var rootABundle: cwlp.CompilerManagedMirrorBundle
    let workRoot = chengpath.PathParentDir(strings.CloneStr(ownedArtifactRoot))
    let rootABindingRes = CidEvidencePlanBindingMatches(
        strings.CloneStr(workRoot), "root-a", rootAReports)
    if IsErr(rootABindingRes):
        return Err[bool](Error(rootABindingRes))
    let rootABundleRes = CidEvidenceBuildBundle(
        strings.CloneStr(ownedCaseRoot), rootAReports, rootABundle)
    if IsErr(rootABundleRes):
        return Err[bool](Error(rootABundleRes))
    let rootB = strings.ConcatStr(strings.CloneStr(ownedCaseRoot), "-root-b")
    var rootBReports: CidEvidenceMirrorReports
    let rootBReportsRes = CidEvidenceReadPayloadReports(
        strings.CloneStr(ownedArtifactRoot), "root_b_", rootBReports)
    if IsErr(rootBReportsRes):
        return Err[bool](Error(rootBReportsRes))
    var rootBBundle: cwlp.CompilerManagedMirrorBundle
    let rootBBindingRes = CidEvidencePlanBindingMatches(
        strings.CloneStr(workRoot), "root-b", rootBReports)
    if IsErr(rootBBindingRes):
        return Err[bool](Error(rootBBindingRes))
    let rootBBundleRes = CidEvidenceBuildBundle(
        rootB,
        rootBReports,
        rootBBundle)
    if IsErr(rootBBundleRes):
        return Err[bool](Error(rootBBundleRes))
    let rootABundleText =
        cwlp.CompilerWorldManagedMirrorBundleReport(rootABundle)
    let rootBBundleText =
        cwlp.CompilerWorldManagedMirrorBundleReport(rootBBundle)
    if rootABundleText != rootBBundleText:
        return Err[bool](
            "CID evidence: mirror bundle cross-root fixed point")
    os.WriteFile(
        chengpath.PathJoin(
            strings.CloneStr(ownedArtifactRoot),
            "artifacts/mirror_bundle.bin"),
        rootABundleText)
    os.WriteFile(
        chengpath.PathJoin(
            strings.CloneStr(ownedArtifactRoot),
            "artifacts/root_b_mirror_bundle.bin"),
        rootBBundleText)
    var dependencyReports: CidEvidenceMirrorReports
    let dependencyReportsRes = CidEvidenceReadDependencyReports(
        strings.CloneStr(workRoot), dependencyReports)
    if IsErr(dependencyReportsRes):
        return Err[bool](Error(dependencyReportsRes))
    let dependencyRoot = strings.ConcatStr(
        strings.CloneStr(ownedCaseRoot), "-managed-dependency")
    var dependencyBundle: cwlp.CompilerManagedMirrorBundle
    let dependencyBindingRes = CidEvidencePlanBindingMatches(
        strings.CloneStr(workRoot), "dependency", dependencyReports)
    if IsErr(dependencyBindingRes):
        return Err[bool](Error(dependencyBindingRes))
    let dependencyBundleRes = CidEvidenceBuildBundle(
        dependencyRoot,
        dependencyReports,
        dependencyBundle)
    if IsErr(dependencyBundleRes):
        return Err[bool](Error(dependencyBundleRes))
    os.WriteFile(
        chengpath.PathJoin(
            strings.CloneStr(workRoot),
            "mirror-dependency-bundle.kv"),
        cwlp.CompilerWorldManagedMirrorBundleReport(dependencyBundle))
    return Ok[bool](true)

fn main(): int32 =
    var caseId = ""
    var caseRoot = ""
    var artifactRoot = ""
    var compiledOutput = ""
    var evidencePrefix = ""
    if !cmdline.readFlagValue("--case", caseId) ||
       !cmdline.readFlagValue("--case-root", caseRoot) ||
       !cmdline.readFlagValue("--artifact-root", artifactRoot) ||
       !cmdline.readFlagValue("--compiled-output", compiledOutput) ||
       !cmdline.readFlagValue("--evidence-prefix", evidencePrefix) ||
       caseId != "mirror-atomic-install" || caseRoot == "" ||
       artifactRoot == "" || compiledOutput == "" ||
       evidencePrefix == "":
        os.WriteLine(os.Get_stderr(),
                     "CID evidence: invalid mirror bundle flags")
        return 2
    let result = CidEvidenceMirrorBundleStage(
        caseRoot, artifactRoot, compiledOutput)
    if IsErr(result):
        os.WriteLine(os.Get_stderr(), Error(result))
        return 1
    return 0
