import std/cmdline
import std/os
import std/rawbytes
import std/strings
import cheng/std/bytes_layout as layout
import cheng/core/tooling/held_output_fd as heldfd

fn fail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

@borrows
fn publishText(
        lease: var heldfd.HeldOutputFdLease,
        text: str,
        outSha256: var layout.FixedBytes32,
        err: var str): bool =
    let bytes = rawbytes.BytesFromString(text)
    return heldfd.HeldOutputFdPublishBytes(
        lease, bytes, "", outSha256, err)

fn main(): int32 =
    let paramCount = cmdline.ParamCount()
    if paramCount != 3 && paramCount != 4:
        return fail("held fd contract: expected --out-fd/--report-fd")
    let workerFailureMode = paramCount == 4 &&
        cmdline.ParamStr(3) == "--linear-worker-failure"
    if paramCount == 4 && !workerFailureMode:
        return fail("held fd contract: unknown linear mode")
    let objectArg = cmdline.ParamStr(1)
    let reportArg = cmdline.ParamStr(2)
    if objectArg.len <= 9 || reportArg.len <= 12 ||
       strings.SliceBytes(objectArg, 0, 9) != "--out-fd:" ||
       strings.SliceBytes(reportArg, 0, 12) != "--report-fd:":
        return fail("held fd contract: fd selector shape failed")
    var objectFd: int32
    var reportFd: int32
    if !cmdline.ParseInt32(
           strings.SliceBytes(objectArg, 9, objectArg.len - 9),
           objectFd) ||
       !cmdline.ParseInt32(
           strings.SliceBytes(reportArg, 12, reportArg.len - 12),
           reportFd):
        return fail("held fd contract: fd parse failed")
    var objectLease: heldfd.HeldOutputFdLease
    var reportLease: heldfd.HeldOutputFdLease
    defer:
        heldfd.HeldOutputFdRetireOrPanic(
            objectLease, "held fd contract object retire")
        heldfd.HeldOutputFdRetireOrPanic(
            reportLease, "held fd contract report retire")
    var err: str
    if !heldfd.HeldOutputFdRegistryInitializeBeforeWorkload():
        return fail("held fd contract: registry init failed")
    if !heldfd.HeldOutputFdClaimEmpty(
           objectFd, objectLease, err):
        return fail(err)
    if !heldfd.HeldOutputFdClaimEmpty(
           reportFd, reportLease, err):
        return fail(err)
    if !heldfd.HeldOutputFdClaimsDistinct(
           objectLease, reportLease):
        return fail("held fd contract: capabilities alias")
    var duplicateClaim: heldfd.HeldOutputFdLease
    if heldfd.HeldOutputFdClaimEmpty(
           objectFd, duplicateClaim, err) ||
       !heldfd.HeldOutputFdLeaseIsEmpty(duplicateClaim) ||
       err != "held output fd: descriptor is already claimed":
        return fail("held fd contract: duplicate claim was not rejected")
    if workerFailureMode:
        var staleWorkerLease = objectLease
        var failedWorkerLease: heldfd.HeldOutputFdLease
        if !heldfd.HeldOutputFdMove(
               objectLease, failedWorkerLease, err) ||
           !heldfd.HeldOutputFdLeaseIsEmpty(objectLease):
            return fail("held fd contract: failure worker move did not clear source")
        if !heldfd.HeldOutputFdRetire(
               failedWorkerLease, err) ||
           !heldfd.HeldOutputFdLeaseIsEmpty(failedWorkerLease):
            return fail("held fd contract: worker failure did not retire")
        if heldfd.HeldOutputFdRetire(staleWorkerLease, err) ||
           err != "held output fd: retire lease is stale or consumed":
            return fail("held fd contract: worker retire replay succeeded")
        if !heldfd.HeldOutputFdRetire(reportLease, err) ||
           !heldfd.HeldOutputFdLeaseIsEmpty(reportLease):
            return fail("held fd contract: worker failure report did not retire")
        return 0
    var staleGenerationLease = objectLease
    var workerObjectLease: heldfd.HeldOutputFdLease
    if !heldfd.HeldOutputFdMove(
           objectLease, workerObjectLease, err) ||
       !heldfd.HeldOutputFdLeaseIsEmpty(objectLease):
        return fail("held fd contract: worker move did not clear source")
    if staleGenerationLease.generation ==
           workerObjectLease.generation ||
       staleGenerationLease.owner == workerObjectLease.owner:
        return fail("held fd contract: worker move did not rotate token")
    var staleMoveOut: heldfd.HeldOutputFdLease
    if heldfd.HeldOutputFdMove(
           staleGenerationLease, staleMoveOut, err) ||
       !heldfd.HeldOutputFdLeaseIsEmpty(staleMoveOut) ||
       err != "held output fd: move source is stale or consumed":
        return fail("held fd contract: stale generation move was not rejected")
    if !heldfd.HeldOutputFdMove(
           workerObjectLease, objectLease, err) ||
       !heldfd.HeldOutputFdLeaseIsEmpty(workerObjectLease):
        return fail("held fd contract: worker return move did not clear source")
    if !heldfd.HeldOutputFdClaimsDistinct(
           objectLease, reportLease):
        return fail("held fd contract: moved capabilities alias")
    var objectSha256: layout.FixedBytes32
    var reportSha256: layout.FixedBytes32
    var staleObjectPublishLease = objectLease
    if !publishText(
           objectLease,
           "held-object-capability-contract",
           objectSha256,
           err):
        let publishErr = strings.CloneStr(err)
        heldfd.HeldOutputFdRetireOrPanic(
            objectLease, "held fd contract object publish failure retire")
        return fail(publishErr)
    var staleVerifyErr: str
    if heldfd.HeldOutputFdVerifyPublished(
           staleObjectPublishLease,
           objectSha256,
           staleVerifyErr) ||
       staleVerifyErr !=
           "held output fd: published lease is stale or consumed":
        return fail("held fd contract: pre-publish owner verified")
    var staleReportPublishLease = reportLease
    if !publishText(
           reportLease,
           "held-report-capability-contract",
           reportSha256,
           err):
        let publishErr = strings.CloneStr(err)
        heldfd.HeldOutputFdRetireOrPanic(
            reportLease, "held fd contract report publish failure retire")
        return fail(publishErr)
    var rejectedSha256: layout.FixedBytes32
    let staleReportPublished = publishText(
           staleReportPublishLease,
           "held-report-capability-contract",
           rejectedSha256,
           err)
    if staleReportPublished ||
       err != "held output fd: lease is stale or already consumed":
        return fail("held fd contract: lease copy double-published")
    if !heldfd.HeldOutputFdClaimsDistinct(
           objectLease, reportLease):
        return fail("held fd contract: published capabilities alias")
    var objectVerifyReplay = objectLease
    var reportVerifyReplay = reportLease
    if !heldfd.HeldOutputFdVerifyPublished(
           objectLease, objectSha256, err) ||
       !heldfd.HeldOutputFdVerifyPublished(
           reportLease, reportSha256, err):
        return fail(err)
    if !heldfd.HeldOutputFdLeaseIsEmpty(objectLease) ||
       !heldfd.HeldOutputFdLeaseIsEmpty(reportLease):
        return fail("held fd contract: verify did not consume lease")
    if heldfd.HeldOutputFdVerifyPublished(
           objectVerifyReplay, objectSha256, err) ||
       err != "held output fd: published lease is stale or consumed":
        return fail("held fd contract: object verify replay succeeded")
    if heldfd.HeldOutputFdVerifyPublished(
           reportVerifyReplay, reportSha256, err) ||
       err != "held output fd: published lease is stale or consumed":
        return fail("held fd contract: report verify replay succeeded")
    return 0
