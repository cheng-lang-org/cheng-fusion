# PHASEB-RECENSUS probe_sizeof: sizeof folded constant (incl nested call form)
fn main(): int32 =
  let a: int32 = int32(sizeof(int32))
  let b: int32 = int32(sizeof(int32)) + int32(sizeof(int8))
  if a == 4:
    if b == 5:
      echo("probe_sizeof=pass")
      return 0
  echo("probe_sizeof=fail")
  return 101
