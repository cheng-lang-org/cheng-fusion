# Crypto primitive benchmark: measures the exact primitives the tcp-tls-forward
# record layer uses, in generated-code conditions (same emit pipeline as the
# server binary). Run on the target host for true per-primitive throughput.
# Ownership note: managed structs are never held in locals across calls — every
# use inlines Value(resultVar), matching the proven record-layer call shape.
import std/crypto/aesgcm
import std/crypto/chacha20poly1305 as chacha
import std/crypto/sha256
import std/rawbytes
import std/strings
import std/strutils as strutil
import std/os

@importc("cheng_monotime_ns")
fn monoNs(): int64

const benchRecordBytes = 16384
const benchRecordsPerRound = 64
const benchRounds = 6

fn benchFillRandom(buf: rawbytes.Bytes) =
    var i: int32 = 0
    var seed: int32 = 123456789
    while i < rawbytes.BytesLen(buf):
        seed = (seed * 1103515245 + 12345) & 2147483647
        rawbytes.BytesSet(buf, i, (seed >> 16) & 255)
        i = i + 1

fn benchPrint(text: str) =
    os.WriteLine(os.Get_stdout(), text)

fn benchReport(name: str, dtNs: int64) =
    let totalBytes: int64 = int64(benchRecordBytes) * int64(benchRecordsPerRound) * int64(benchRounds)
    let ms: int64 = dtNs / int64(1000000)
    let rateK: int64 = if dtNs > 0: (totalBytes * int64(1000000)) / dtNs else: 0
    benchPrint(name)
    benchPrint(strings.Int64ToStr(ms))
    benchPrint(strings.Int64ToStr(rateK))

fn main(): int32 =
    var keyData: rawbytes.Bytes = rawbytes.BytesAlloc(32)
    benchFillRandom(keyData)
    var nonceBuf: rawbytes.Bytes = rawbytes.BytesAlloc(12)
    benchFillRandom(nonceBuf)
    var tagBuf: rawbytes.Bytes = rawbytes.BytesAlloc(16)
    var aad: rawbytes.Bytes = rawbytes.EmptyBytes()
    var bigBuf: rawbytes.Bytes = rawbytes.BytesAlloc(benchRecordBytes * benchRecordsPerRound)
    benchFillRandom(bigBuf)

    var keyRes: Result[aesgcm.AesGcmKey] = aesgcm.intoAesGcmKey(keyData)
    var key: aesgcm.AesGcmKey = Value(keyRes)
    let t0: int64 = monoNs()
    var r: int32 = 0
    while r < benchRounds:
        let enc: Result[bool] = aesgcm.aesGcmEncryptRaw(key.rounds, key.roundKeys, nonceBuf, tagBuf, bigBuf, aad)
        r = r + 1
    benchReport("AESGCM_bulk_1MB", monoNs() - t0)

    let t1: int64 = monoNs()
    r = 0
    while r < benchRounds:
        var rec: int32 = 0
        while rec < benchRecordsPerRound:
            let enc: Result[bool] = aesgcm.aesGcmEncryptRaw(key.rounds, key.roundKeys, nonceBuf, tagBuf, bigBuf, aad)
            rec = rec + 1
        r = r + 1
    benchReport("AESGCM_record_pattern_1MB", monoNs() - t1)

    var chachaKey: Result[chacha.ChaChaPolyKey] = chacha.intoChaChaPolyKey(keyData)
    var chachaNonce: Result[chacha.ChaChaPolyNonce] = chacha.intoChaChaPolyNonce(nonceBuf)
    let t2: int64 = monoNs()
    r = 0
    while r < benchRounds:
        let keyOnce: chacha.ChaChaPolyKey = Value(chachaKey)
        let nonceOnce: chacha.ChaChaPolyNonce = Value(chachaNonce)
        var tagOut: chacha.ChaChaPolyTag
        let enc: Result[bool] = chacha.encrypt(keyOnce, nonceOnce, tagOut, bigBuf, aad)
        r = r + 1
    benchReport("CHACHA_1MB", monoNs() - t2)

    let t3: int64 = monoNs()
    r = 0
    while r < benchRounds:
        var digest: rawbytes.Bytes = sha256.Sha256Digest(bigBuf)
        rawbytes.BytesFree(digest)
        r = r + 1
    benchReport("SHA256_1MB", monoNs() - t3)
    return 0
