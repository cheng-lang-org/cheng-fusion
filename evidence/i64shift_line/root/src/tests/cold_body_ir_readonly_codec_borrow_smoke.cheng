module cold_body_ir_readonly_codec_borrow_smoke

import core/backend2/backend2_frag_codec as codec
import core/ir/core_types as coreir
import std/rawbytes

type
    BodyIrReadonlyHolder =
        bodyIR: coreir.BodyIR

@borrows
fn EncodeReadonlyBodyIr(holder: BodyIrReadonlyHolder): int32 =
    var encoded = codec.Backend2BodyIrEncode(holder.bodyIR)
    let byteCount = rawbytes.BytesLen(encoded)
    rawbytes.BytesFree(encoded)
    return byteCount

fn main(): int32 =
    var holder: BodyIrReadonlyHolder
    holder.bodyIR = coreir.BodyIRNew()
    return EncodeReadonlyBodyIr(holder)
