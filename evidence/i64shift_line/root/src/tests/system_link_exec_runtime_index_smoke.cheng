import std/strformat
import std/strutils as strutil
import std/hashmaps as hashmaps
import cheng/core/backend/system_link_exec as sexec
import cheng/core/backend/system_link_exec_runtime as runtime
import cheng/core/backend/primary_object_plan as pobj
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/tooling/compiler_csg_production_lifetime as csglife
import cheng/core/tooling/compiler_payload_lifecycle as payload

fn attachTerminalCompilerCsgReceipt(
        result: var runtime.SystemLinkExecRuntimeResult) =
    var csg: ccsg.CompilerCsg
    var state: csglife.CompilerCsgProductionLifetime
    csglife.CompilerCsgProductionLifetimeBegin(csg, state)
    csglife.CompilerCsgProductionLifetimeEndUnmoved(
        csg,
        state,
        payload.CompilerPayloadOutcomeSuccess)
    csglife.CompilerCsgProductionLifetimeReceiptInto(
        state,
        result.compilerCsgLifetimeReceipt)
    result.compilerCsgLifetimeReceiptReady = true

fn addUniqueOracle(out: var str[], value: str) =
    if len(value) <= 0:
        return
    for i in 0..<out.len:
        if out[i] == value:
            return
    add(out, value)

fn sameTexts(left: var str[], right: var str[]): bool =
    if left.len != right.len:
        return false
    for i in 0..<left.len:
        if left[i] != right[i]:
            return false
    return true

fn ownedTextAt(values: var str[], index: int32): str =
    if index < 0 || index >= values.len:
        panic("system link runtime index smoke: owned text row out of range")
    return Fmt"{values[index]}"

fn ownedText(value: var str): str =
    return Fmt"{value}"

fn ownedTexts(values: var str[]): str[] =
    var out: str[]
    reserve(out, values.len)
    for i in 0..<values.len:
        add(out, Fmt"{values[i]}")
    return out

fn oldProgramSupportRelocOracle(plan: var sexec.SystemLinkExecPlan,
                                 initialRoots: var str[]): str[] =
    var out: str[]
    for i in 0..<initialRoots.len:
        add(out, Fmt"{initialRoots[i]}")
    let debugFlush = pobj.PrimaryTargetSymbolName(plan.systemLinkPlan.targetTriple,
                                                   "cheng_debug_profile_flush_from_argv0")
    let getEnvBridge = pobj.PrimaryTargetSymbolName(plan.systemLinkPlan.targetTriple,
                                                     "driver_c_get_env_bridge")
    let newString = pobj.PrimaryTargetSymbolName(plan.systemLinkPlan.targetTriple,
                                                  "driver_c_new_string")
    let newStringCopy = pobj.PrimaryTargetSymbolName(plan.systemLinkPlan.targetTriple,
                                                      "driver_c_new_string_copy_n")
    var coreRuntimePresent = false
    for i in 0..<plan.objectPlan.providerModules.len:
        if plan.objectPlan.providerModules[i] == "runtime/core_runtime":
            coreRuntimePresent = true
    for relocIndex in 0..<plan.primaryObjectPlan.relocTargetSymbols.len:
        let symbol = plan.primaryObjectPlan.relocTargetSymbols[relocIndex]
        if symbol == debugFlush || symbol == getEnvBridge:
            continue
        if coreRuntimePresent && (symbol == newString || symbol == newStringCopy):
            continue
        var defined = false
        for definitionIndex in 0..<plan.primaryObjectPlan.symbolNames.len:
            if plan.primaryObjectPlan.symbolNames[definitionIndex] == symbol:
                defined = true
                break
        if !defined:
            addUniqueOracle(out, symbol)
    return out

fn oldNativeInputOracle(existing: var str[], providers: var str[]): str[] =
    var out: str[]
    for i in 0..<existing.len:
        add(out, Fmt"{existing[i]}")
    for providerIndex in 0..<providers.len:
        var found = false
        for inputIndex in 0..<out.len:
            if out[inputIndex] == providers[providerIndex]:
                found = true
                break
        if !found:
            add(out, providers[providerIndex])
    return out

fn runExactCollisionCase() =
    var firstByBucket: str[]
    setLen(firstByBucket, 8)
    var leftIndex: int32 = -1
    var rightIndex: int32 = -1
    for i in 0..<4096:
        let candidate = Fmt"same{i + 100000}"
        let bucket = int32(hashmaps.HashMapHash64Str(candidate) & uint64(7))
        if len(firstByBucket[bucket]) > 0:
            leftIndex = bucket
            add(firstByBucket, ownedText(candidate))
            rightIndex = firstByBucket.len - 1
            break
        firstByBucket[bucket] = candidate
    let left = ownedTextAt(firstByBucket, leftIndex)
    let right = ownedTextAt(firstByBucket, rightIndex)
    assert(len(left) > 0 && len(right) > 0 && len(left) == len(right),
           " system link runtime index smoke: failed to construct same-length collision")
    var index = runtime.SystemLinkExecRuntimeExactTextIndexInit(2)
    var existingRow: int32
    assert(runtime.SystemLinkExecRuntimeExactTextIndexInsert(index,
                                                             left,
                                                             11,
                                                             false,
                                                             existingRow),
           " system link runtime index smoke: first collision key rejected")
    assert(runtime.SystemLinkExecRuntimeExactTextIndexInsert(index,
                                                             right,
                                                             22,
                                                             false,
                                                             existingRow),
           " system link runtime index smoke: second collision key rejected")
    let leftEntry = runtime.SystemLinkExecRuntimeExactTextIndexFind(index, left, true)
    let rightEntry = runtime.SystemLinkExecRuntimeExactTextIndexFind(index, right, true)
    assert(leftEntry >= 0 && rightEntry >= 0 && leftEntry != rightEntry &&
           index.entryRows[leftEntry] == 11 && index.entryRows[rightEntry] == 22,
           " system link runtime index smoke: collision did not use full key equality")
    let metrics = runtime.SystemLinkExecRuntimeExactTextIndexRelease(index)
    assert(metrics.buildCount == Int64(2) &&
           metrics.queryCount == Int64(2) &&
           metrics.lookupComparisonCount >= Int64(1) &&
           metrics.maxLookupComparisons >= 1 &&
           metrics.retainedBytesEstimate > Int64(0) &&
           metrics.liveRetainedBytesEstimate == Int64(0) &&
           metrics.compositeKeyBytes == Int64(0) &&
           metrics.released,
           " system link runtime index smoke: collision metrics drift")

fn runProviderCanonicalDuplicateCase() =
    var plan: sexec.SystemLinkExecPlan
    plan.systemLinkPlan.targetTriple = "aarch64-apple-darwin"
    add(plan.objectPlan.providerSourcePaths,
        "src/core/backend/system_link_exec_runtime.cheng")
    add(plan.objectPlan.providerSourcePaths,
        "src/core/backend/system_link_exec_runtime.cheng")
    add(plan.objectPlan.providerObjectPaths,
        "src/core/backend/system_link_exec_runtime.cheng")
    add(plan.objectPlan.providerObjectPaths,
        "src/core/backend/./system_link_exec_runtime.cheng")
    var metrics: runtime.SystemLinkExecRuntimeExactTextIndexMetrics
    let validateRes = runtime.SystemLinkExecRuntimeValidateProviderPlanWithMetrics(".",
                                                                                    plan,
                                                                                    metrics)
    assert(!validateRes.ok &&
           strutil.Contains(validateRes.err.msg,
                            "duplicate provider object canonical path") &&
           metrics.buildCount == Int64(2) &&
           metrics.compositeKeyBytes == Int64(0) &&
           metrics.liveRetainedBytesEstimate == Int64(0) &&
           metrics.released,
           Fmt"system link runtime index smoke: canonical duplicate accepted {validateRes.err.msg}")

fn runRelocOracleCases() =
    var plan: sexec.SystemLinkExecPlan
    plan.systemLinkPlan.targetTriple = "aarch64-apple-darwin"
    add(plan.primaryObjectPlan.symbolNames, "defined_a")
    add(plan.primaryObjectPlan.symbolNames, "defined_b")
    add(plan.primaryObjectPlan.relocTargetSymbols, "missing_b")
    add(plan.primaryObjectPlan.relocTargetSymbols, "defined_a")
    add(plan.primaryObjectPlan.relocTargetSymbols, "missing_a")
    add(plan.primaryObjectPlan.relocTargetSymbols, "missing_b")
    var initialRoots: str[]
    add(initialRoots, "fixed_root")
    let expected = oldProgramSupportRelocOracle(plan, initialRoots)
    var actual = ownedTexts(initialRoots)
    var definitionMetrics: runtime.SystemLinkExecRuntimeExactTextIndexMetrics
    var rootMetrics: runtime.SystemLinkExecRuntimeExactTextIndexMetrics
    var err: str
    assert(runtime.SystemLinkExecRuntimeAppendProgramSupportRelocRoots(plan,
                                                                       actual,
                                                                       definitionMetrics,
                                                                       rootMetrics,
                                                                       err),
           Fmt"system link runtime index smoke: reloc merge failed {err}")
    assert(sameTexts(actual, expected) &&
           actual.len == 3 &&
           actual[0] == "fixed_root" &&
           actual[1] == "missing_b" &&
           actual[2] == "missing_a",
           " system link runtime index smoke: reloc output order drift")
    assert(definitionMetrics.queryCount == Int64(4) &&
           rootMetrics.queryCount == Int64(3) &&
           definitionMetrics.compositeKeyBytes == Int64(0) &&
           rootMetrics.compositeKeyBytes == Int64(0) &&
           definitionMetrics.liveRetainedBytesEstimate == Int64(0) &&
           rootMetrics.liveRetainedBytesEstimate == Int64(0),
           " system link runtime index smoke: reloc metrics drift")

    var duplicatePlan: sexec.SystemLinkExecPlan
    duplicatePlan.systemLinkPlan.targetTriple = "aarch64-apple-darwin"
    add(duplicatePlan.primaryObjectPlan.symbolNames, "same_symbol")
    add(duplicatePlan.primaryObjectPlan.symbolNames, "same_symbol")
    add(duplicatePlan.primaryObjectPlan.functionIrIndexes, 101)
    add(duplicatePlan.primaryObjectPlan.functionIrIndexes, 202)
    add(duplicatePlan.primaryObjectPlan.relocTargetSymbols, "same_symbol")
    let oldDuplicateResult = oldProgramSupportRelocOracle(duplicatePlan,
                                                           initialRoots)
    var duplicateActual = ownedTexts(initialRoots)
    var duplicateDefinitionMetrics: runtime.SystemLinkExecRuntimeExactTextIndexMetrics
    var duplicateRootMetrics: runtime.SystemLinkExecRuntimeExactTextIndexMetrics
    err = ""
    assert(oldDuplicateResult.len == 1 &&
           !runtime.SystemLinkExecRuntimeAppendProgramSupportRelocRoots(
               duplicatePlan,
               duplicateActual,
               duplicateDefinitionMetrics,
               duplicateRootMetrics,
               err) &&
           strutil.Contains(err, "ambiguous duplicate primary definition") &&
           strutil.Contains(err, "first_function_ir=101") &&
           strutil.Contains(err, "duplicate_function_ir=202") &&
           duplicateDefinitionMetrics.buildCount == Int64(2) &&
           duplicateDefinitionMetrics.liveRetainedBytesEstimate == Int64(0),
           Fmt"system link runtime index smoke: duplicate definition accepted {err}")

fn runNativeInputCases() =
    var inputs: str[]
    add(inputs, "/work/a.o")
    add(inputs, "/work/b.o")
    var providers: str[]
    add(providers, "/work/c.o")
    add(providers, "/work/d.o")
    let expected = oldNativeInputOracle(inputs, providers)
    let mergeRes = runtime.SystemLinkExecRuntimeMergeNativeInputPaths("/",
                                                                      inputs,
                                                                      providers)
    assert(mergeRes.ok && sameTexts(inputs, expected) &&
           inputs[0] == "/work/a.o" && inputs[1] == "/work/b.o" &&
           inputs[2] == "/work/c.o" && inputs[3] == "/work/d.o" &&
           mergeRes.value.compositeKeyBytes == Int64(0) &&
           mergeRes.value.liveRetainedBytesEstimate == Int64(0) &&
           mergeRes.value.released,
           " system link runtime index smoke: native input order drift")

    var duplicateInputs: str[]
    add(duplicateInputs, "/work/a.o")
    var duplicateProviders: str[]
    add(duplicateProviders, "/work/./a.o")
    let duplicateRes = runtime.SystemLinkExecRuntimeMergeNativeInputPaths(
        "/",
        duplicateInputs,
        duplicateProviders)
    assert(!duplicateRes.ok && duplicateInputs.len == 1 &&
           duplicateInputs[0] == "/work/a.o" &&
           strutil.Contains(duplicateRes.err.msg,
                            "duplicate runtime provider canonical path"),
           " system link runtime index smoke: native canonical duplicate accepted")

fn runLargeVisitCase() =
    let itemCount: int32 = 4096
    var index = runtime.SystemLinkExecRuntimeExactTextIndexInit(itemCount)
    for i in 0..<itemCount:
        let key = Fmt"same{i + 100000}"
        var existingRow: int32
        assert(runtime.SystemLinkExecRuntimeExactTextIndexInsert(index,
                                                                 key,
                                                                 i,
                                                                 false,
                                                                 existingRow),
               Fmt"system link runtime index smoke: large insert failed {i}")
    for i in 0..<itemCount:
        let key = Fmt"same{i + 100000}"
        assert(runtime.SystemLinkExecRuntimeExactTextIndexFind(index, key, true) >= 0,
               Fmt"system link runtime index smoke: large lookup failed {i}")
    let metrics = runtime.SystemLinkExecRuntimeExactTextIndexRelease(index)
    assert(metrics.buildCount == Int64(itemCount) &&
           metrics.queryCount == Int64(itemCount) &&
           metrics.lookupComparisonCount <= Int64(itemCount) * Int64(32) &&
           metrics.maxLookupComparisons <= 32 &&
           metrics.compositeKeyBytes == Int64(0) &&
           metrics.liveRetainedBytesEstimate == Int64(0) &&
           metrics.released,
           Fmt"system link runtime index smoke: large index non-linear comparisons={metrics.lookupComparisonCount} max={metrics.maxLookupComparisons}")

    var relocPlan: sexec.SystemLinkExecPlan
    relocPlan.systemLinkPlan.targetTriple = "aarch64-apple-darwin"
    for i in 0..<itemCount:
        add(relocPlan.primaryObjectPlan.symbolNames,
            Fmt"definition_{i + 100000}")
        if (i % 2) == 0:
            add(relocPlan.primaryObjectPlan.relocTargetSymbols,
                Fmt"definition_{i + 100000}")
        else:
            add(relocPlan.primaryObjectPlan.relocTargetSymbols,
                Fmt"missing_{i + 100000}")
    var relocRoots: str[]
    add(relocRoots, "fixed_root")
    var definitionMetrics: runtime.SystemLinkExecRuntimeExactTextIndexMetrics
    var rootMetrics: runtime.SystemLinkExecRuntimeExactTextIndexMetrics
    var relocErr: str
    assert(runtime.SystemLinkExecRuntimeAppendProgramSupportRelocRoots(
               relocPlan,
               relocRoots,
               definitionMetrics,
               rootMetrics,
               relocErr) &&
           relocRoots.len == 1 + itemCount / 2 &&
           definitionMetrics.buildCount == Int64(itemCount) &&
           definitionMetrics.queryCount == Int64(itemCount) &&
           definitionMetrics.lookupComparisonCount <= Int64(itemCount) * Int64(64) &&
           definitionMetrics.maxLookupComparisons <= 64 &&
           rootMetrics.buildCount == Int64(1 + itemCount / 2) &&
           rootMetrics.queryCount == Int64(itemCount / 2) &&
           rootMetrics.lookupComparisonCount <= Int64(itemCount) * Int64(64) &&
           rootMetrics.maxLookupComparisons <= 64 &&
           definitionMetrics.compositeKeyBytes == Int64(0) &&
           rootMetrics.compositeKeyBytes == Int64(0) &&
           definitionMetrics.liveRetainedBytesEstimate == Int64(0) &&
           rootMetrics.liveRetainedBytesEstimate == Int64(0),
           Fmt"system link runtime index smoke: reloc large visit bound drift {relocErr}")

    var nativeInputs: str[]
    var nativeProviders: str[]
    for i in 0..<itemCount:
        add(nativeInputs, Fmt"/work/input_{i + 100000}.o")
        add(nativeProviders, Fmt"/work/provider_{i + 100000}.o")
    let nativeRes = runtime.SystemLinkExecRuntimeMergeNativeInputPaths("/",
                                                                       nativeInputs,
                                                                       nativeProviders)
    assert(nativeRes.ok &&
           nativeInputs.len == itemCount * 2 &&
           nativeRes.value.buildCount == Int64(itemCount * 2) &&
           nativeRes.value.queryCount == Int64(itemCount) &&
           nativeRes.value.lookupComparisonCount <= Int64(itemCount) * Int64(64) &&
           nativeRes.value.maxLookupComparisons <= 64 &&
           nativeRes.value.compositeKeyBytes == Int64(0),
           " system link runtime index smoke: native large visit bound drift")

fn runReportContractCase() =
    var index = runtime.SystemLinkExecRuntimeExactTextIndexInit(1)
    var existingRow: int32
    assert(runtime.SystemLinkExecRuntimeExactTextIndexInsert(index,
                                                             "report_key",
                                                             0,
                                                             false,
                                                             existingRow),
           " system link runtime index smoke: report index insert failed")
    assert(runtime.SystemLinkExecRuntimeExactTextIndexFind(index,
                                                           "report_key",
                                                           true) >= 0,
           " system link runtime index smoke: report index lookup failed")
    let metrics = runtime.SystemLinkExecRuntimeExactTextIndexRelease(index)
    var result: runtime.SystemLinkExecRuntimeResult
    attachTerminalCompilerCsgReceipt(result)
    result.indexMetrics.providerPath = metrics
    let report = runtime.SystemLinkExecRuntimeResultReport(result)
    assert(strutil.Contains(report,
                            "system_link_exec_provider_path_index_build_count=1\n") &&
           strutil.Contains(report,
                            "system_link_exec_provider_path_index_query_count=1\n") &&
           strutil.Contains(report,
                            "system_link_exec_provider_path_index_sort_comparison_count=") &&
           strutil.Contains(report,
                            "system_link_exec_provider_path_index_lookup_comparison_count=") &&
           strutil.Contains(report,
                            "system_link_exec_provider_path_index_max_lookup_comparisons=") &&
           strutil.Contains(report,
                            "system_link_exec_provider_path_index_retained_bytes_estimate=") &&
           strutil.Contains(report,
                            "system_link_exec_provider_path_index_live_retained_bytes_estimate=0\n") &&
           strutil.Contains(report,
                            "system_link_exec_provider_path_index_composite_key_bytes=0\n") &&
           strutil.Contains(report,
                            "system_link_exec_provider_path_index_released=1\n") &&
           strutil.Contains(report,
                            "system_link_exec_index_total_composite_key_bytes=0\n"),
           " system link runtime index smoke: runtime report contract missing")

fn runCompileArgOrderCase() =
    var plan: sexec.SystemLinkExecPlan
    plan.systemLinkPlan.packageRoot = "/work"
    plan.systemLinkPlan.targetTriple = "aarch64-apple-darwin"
    var roots: str[]
    add(roots, "root_b")
    add(roots, "root_a")
    let argv = runtime.SystemLinkExecRuntimeProviderCompileArgs(
        plan.systemLinkPlan.packageRoot,
        plan.systemLinkPlan.targetTriple,
        "runtime/program_support",
        "/work/provider.cheng",
        "/work/provider.o",
        roots)
    assert(argv.len >= 2 &&
           argv[argv.len - 2] == "--symbol-visibility:internal" &&
           argv[argv.len - 1] == "--export-roots:root_b,root_a",
           " system link runtime index smoke: export root byte order drift")

fn main(): int32 =
    runExactCollisionCase()
    runProviderCanonicalDuplicateCase()
    runRelocOracleCases()
    runNativeInputCases()
    runLargeVisitCase()
    runReportContractCase()
    runCompileArgOrderCase()
    echo("system_link_exec_runtime_index_smoke=ok")
    return 0
