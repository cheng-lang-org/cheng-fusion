import std/system as system

# Amplified discrimination: does the shared drop path leak for `str` too?
#
# `cold_emit_exact_owned_drop_materialized` builds ONE private copy for every
# managed kind (`move = COPY_COMPOSITE(drop_slot <- source->slot)` published as
# OWN_MOVE) and only then branches by kind (`SLOT_STR` vs `SLOT_SEQ_*`).  So if
# that copy is what leaves an extra reference behind, a `str` reassigned inside
# a loop must leak just like the `seq` case; if `str` comes out clean, the cause
# must sit in the seq-only arm (the `rc == 1` guard) instead.
#
# Exit code = bucket(loopDelta) * 16 + bucket(straightDelta), each capped at 15:
#   240 = only the loop shape leaks | 15 = only the straight shape leaks
#   255 = both leak (shared path)  |   0 = neither (seq-arm specific)

var probeSink: int32

fn StrLoop(seed: int32, count: int32): int32 =
    var s: str = "s"
    var i: int32
    while i < count:
        s = Fmt"{s}{Int32(seed)}"
        i = i + 1
    return s.len

fn StrStraight(seed: int32): int32 =
    var s: str = "s"
    s = Fmt"{s}{Int32(seed)}"
    s = Fmt"{s}{Int32(seed)}"
    s = Fmt"{s}{Int32(seed)}"
    return s.len

fn RepeatLoop(rounds: int32): int32 =
    var acc: int32
    var r: int32
    while r < rounds:
        acc = acc + StrLoop(r, 8)
        r = r + 1
    return acc

fn RepeatStraight(rounds: int32): int32 =
    var acc: int32
    var r: int32
    while r < rounds:
        acc = acc + StrStraight(r)
        r = r + 1
    return acc

fn Bucket(delta: int64): int64 =
    if delta <= 0:
        return 0
    if delta > 15:
        return 15
    return delta

fn main(): int32 =
    let rounds: int32 = 1000
    let beforeLoop = system.MemLiveAllocations()
    let loopObserved = RepeatLoop(rounds)
    let loopDelta = system.MemLiveAllocations() - beforeLoop
    let beforeStraight = system.MemLiveAllocations()
    let straightObserved = RepeatStraight(rounds)
    let straightDelta = system.MemLiveAllocations() - beforeStraight
    probeSink = loopObserved + straightObserved
    if loopObserved <= 0 || straightObserved <= 0:
        return 99
    return int32(Bucket(loopDelta) * 16 + Bucket(straightDelta))
