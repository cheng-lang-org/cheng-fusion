# Memory transport in-place listener state runtime smoke.
# A/B verified 2026-07-09 (stage3 cold backend): identical green before/after
# the libp2p whole-struct-copy -> var-param in-place rewrite.
import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/multiaddress
import cheng/libp2p/transports/memorytransport
import cheng/libp2p/stream/connection

fn run(): Result[bool] =
    let addrRes: Result[MultiAddress] = parseMultiAddress("/memory/81")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    let addr = Value(addrRes)
    var listener = initMemoryTransport()
    start(listener, addr)
    if ! listener.running:
        return Err[bool]("mt: listener ! running")
    var dialer = initMemoryTransport()
    let outRes: Result[Connection] = dial(dialer, addr)
    if IsErr(outRes):
        return Err[bool]("mt: dial failed: " + Error(outRes))
    let inRes: Result[Connection] = accept(listener)
    if IsErr(inRes):
        return Err[bool]("mt: accept failed: " + Error(inRes))
    var outConn = Value(outRes)
    var inConn = Value(inRes)
    # queue multiple pending, drop one by pipe, dequeue the rest
    let out2Res: Result[Connection] = dial(dialer, addr)
    if IsErr(out2Res):
        return Err[bool]("mt: second dial failed: " + Error(out2Res))
    let out3Res: Result[Connection] = dial(dialer, addr)
    if IsErr(out3Res):
        return Err[bool]("mt: third dial failed: " + Error(out3Res))
    var out2 = Value(out2Res)
    let dropRes: Result[bool] = dropMemoryPendingByPipe(dialer, addr, out2.pipeIdx)
    if IsErr(dropRes):
        return Err[bool]("mt: drop failed: " + Error(dropRes))
    if ! Value(dropRes):
        return Err[bool]("mt: drop did not find pipe")
    let in3Res: Result[Connection] = accept(listener)
    if IsErr(in3Res):
        return Err[bool]("mt: third accept failed: " + Error(in3Res))
    var in3 = Value(in3Res)
    if in3.pipeIdx == out2.pipeIdx:
        return Err[bool]("mt: dropped connection was accepted")
    let emptyRes: Result[Connection] = accept(listener)
    if IsErr(emptyRes) == false:
        return Err[bool]("mt: queue should be empty after drop+accept")
    connClose(outConn)
    connClose(inConn)
    stop(listener)
    if listener.running:
        return Err[bool]("mt: listener still running after stop")
    # restart on same addr exercises listener slot reactivation
    var listener2 = initMemoryTransport()
    start(listener2, addr)
    if ! listener2.running:
        return Err[bool]("mt: listener restart failed")
    let out4Res: Result[Connection] = dial(dialer, addr)
    if IsErr(out4Res):
        return Err[bool]("mt: dial after restart failed: " + Error(out4Res))
    let in4Res: Result[Connection] = accept(listener2)
    if IsErr(in4Res):
        return Err[bool]("mt: accept after restart failed: " + Error(in4Res))
    stop(listener2)
    return Ok[bool](true)

fn main(): int32 =
    let res: Result[bool] = run()
    if IsErr(res):
        echo("mt ab smoke failed: " + Error(res))
        return 1
    echo("mt ab smoke ok")
    return 0
