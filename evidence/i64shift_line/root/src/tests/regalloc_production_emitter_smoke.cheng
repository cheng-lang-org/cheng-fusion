import cheng/core/ir/core_types as ir
import cheng/core/ir/body_ir_access as access
import cheng/core/backend/regalloc_single_pass as alloc
import cheng/core/backend/regalloc_production_emitter as emitter
import cheng/core/backend/codegen_contract as contract
import cheng/core/backend/regalloc_production_artifacts as artifacts
import cheng/std/bytes_layout as layout
import std/strutils as strutil
import cheng/core/backend/regalloc_aarch64_adapter as rega64
import cheng/core/backend/regalloc_x86_64_adapter as x8664adapter

fn regallocProductionSmokeBodyIrNew(): ir.BodyIR =
    let parsed = layout.FixedBytes32FromHex(
        "6666666666666666666666666666666666666666666666666666666666666666")
    assert(parsed.ok, " regalloc production emitter: TypeArena CID fixture invalid")
    var body = ir.BodyIRNew()
    assert(ir.BodyIRBindTypeArenaArtifactCid(body, parsed.value),
           " regalloc production emitter: TypeArena CID binding failed")
    return body

fn regallocProductionSmokeI32Slot(id: int32,
                                  isParam: bool): ir.LocalSlot =
    var slot: ir.LocalSlot
    slot.id = id
    slot.name = "v"
    slot.typeKind = ir.LocalI32Tag
    slot.stackOffset = 16 + id * 8
    if isParam:
        slot.stackOffset = 0 - 1 - id
    slot.sizeBytes = 4
    slot.alignBytes = 4
    ir.BodyIRApplyLocalSlotDefaultProof(slot)
    return slot

fn regallocProductionSmokeAppendReturn(body: var ir.BodyIR,
                                        slotIndex: int32): int32 =
    var term: ir.BodyTerm
    ir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = slotIndex
    add(term.operands, ir.LocalI32Tag)
    return ir.BodyIRAppendTerm(body, term)

fn regallocProductionSmokeConstBody(): ir.BodyIR =
    var body = regallocProductionSmokeBodyIrNew()
    add(body.localSlots, regallocProductionSmokeI32Slot(0, false))
    var op: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = ir.BodyOpLoadConstTag
    op.target = 0
    add(op.operands, ir.LocalI32Tag)
    add(op.operands, 70000)
    add(body.ops, op)
    let termIndex = regallocProductionSmokeAppendReturn(body, 0)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn regallocProductionSmokeParamBody(): ir.BodyIR =
    var body = regallocProductionSmokeBodyIrNew()
    add(body.localSlots, regallocProductionSmokeI32Slot(0, true))
    let termIndex = regallocProductionSmokeAppendReturn(body, 0)
    let _ = ir.BodyIRAppendBlock(body, 0, 0, termIndex)
    return body

fn regallocProductionSmokeCallBody(): ir.BodyIR =
    var body = regallocProductionSmokeBodyIrNew()
    add(body.localSlots, regallocProductionSmokeI32Slot(0, true))
    add(body.localSlots, regallocProductionSmokeI32Slot(1, false))
    var call: ir.CallOp
    ir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = "surface_callee"
    call.targetSourcePath =
        "src/tests/regalloc_production_emitter_callee.cheng"
    call.resultSlot = 1
    call.resultPassKind = ir.BodyCallPassStackValueTag
    call.relocWordOffset = -1
    add(call.argSlots, 0)
    add(call.argPassKinds, ir.BodyCallPassStackValueTag)
    add(call.argAbiSizes, 4)
    add(body.callSequence, call)
    var op: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = ir.BodyOpCallTag
    op.target = 1
    add(op.operands, 0)
    add(body.ops, op)
    let termIndex = regallocProductionSmokeAppendReturn(body, 1)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn regallocProductionSmokeStackArgBody(): ir.BodyIR =
    var body = regallocProductionSmokeBodyIrNew()
    for slotIndex in 0..<7:
        add(body.localSlots,
            regallocProductionSmokeI32Slot(slotIndex, true))
    add(body.localSlots, regallocProductionSmokeI32Slot(7, false))
    var call: ir.CallOp
    ir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = "surface_stack_arg_callee"
    call.targetSourcePath =
        "src/tests/regalloc_production_emitter_stack_callee.cheng"
    call.resultSlot = 7
    call.resultPassKind = ir.BodyCallPassStackValueTag
    call.relocWordOffset = -1
    for argIndex in 0..<7:
        add(call.argSlots, argIndex)
        add(call.argPassKinds, ir.BodyCallPassStackValueTag)
        add(call.argAbiSizes, 4)
    add(body.callSequence, call)
    var op: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = ir.BodyOpCallTag
    op.target = 7
    add(op.operands, 0)
    add(body.ops, op)
    let termIndex = regallocProductionSmokeAppendReturn(body, 7)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn regallocProductionSmokeDirectSretBody(): ir.BodyIR =
    var body = regallocProductionSmokeBodyIrNew()
    for slotIndex in 0..<6:
        add(body.localSlots,
            regallocProductionSmokeI32Slot(slotIndex, true))
    var result: ir.LocalSlot
    result.id = 6
    result.name = "aggregate_result"
    result.typeKind = ir.LocalAggregateTag
    result.stackOffset = 16
    result.sizeBytes = 16
    result.alignBytes = 8
    ir.BodyIRApplyLocalSlotDefaultProof(result)
    add(body.localSlots, result)
    var call: ir.CallOp
    ir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = "surface_direct_sret_callee"
    call.targetSourcePath =
        "src/tests/regalloc_production_emitter_sret_callee.cheng"
    call.resultSlot = 6
    call.resultPassKind = ir.BodyCallPassSretResultTag
    call.relocWordOffset = -1
    for argIndex in 0..<6:
        add(call.argSlots, argIndex)
        add(call.argPassKinds, ir.BodyCallPassStackValueTag)
        add(call.argAbiSizes, 4)
    add(body.callSequence, call)
    var op: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = ir.BodyOpCallTag
    op.target = 6
    add(op.operands, 0)
    add(body.ops, op)
    var term: ir.BodyTerm
    ir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = 6
    let termIndex = ir.BodyIRAppendTerm(body, term)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn regallocProductionSmokeGlobalStoreBody(): ir.BodyIR =
    var body = regallocProductionSmokeBodyIrNew()
    add(body.localSlots, regallocProductionSmokeI32Slot(0, true))
    var globalSlot = regallocProductionSmokeI32Slot(1, false)
    globalSlot.name = "production_global_i32"
    globalSlot.placeKind = ir.BodyPlaceGlobalAddressTag
    add(body.localSlots, globalSlot)
    var store: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(store)
    store.kind = ir.BodyOpGlobalStoreTag
    store.target = 0
    add(store.operands, 1)
    add(body.ops, store)
    var term: ir.BodyTerm
    ir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = -1
    let termIndex = ir.BodyIRAppendTerm(body, term)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn regallocProductionSmokePtrParamSlot(id: int32): ir.LocalSlot =
    var slot: ir.LocalSlot
    slot.id = id
    slot.name = "sret_arg"
    slot.typeKind = ir.LocalPtrTag
    slot.stackOffset = 0 - 1 - id
    slot.sizeBytes = 8
    slot.alignBytes = 8
    ir.BodyIRApplyLocalSlotDefaultProof(slot)
    return slot

fn regallocProductionSmokeSretForwardBody(): ir.BodyIR =
    var body = regallocProductionSmokeBodyIrNew()
    body.entryIsCAbi = true
    add(body.localSlots, regallocProductionSmokePtrParamSlot(0))
    add(body.localSlots, regallocProductionSmokePtrParamSlot(1))
    var call: ir.CallOp
    ir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = "cheng_call_ptr_sret_agg1_raw"
    call.resultSlot = -1
    # Cross-module field defaults do not materialize: state the -1 contract
    # explicitly (mirrors the production bridge in primary_object_plan.cheng).
    call.resultExprNodeIndex = -1
    call.resultPassKind = ir.BodyCallPassForwardEntrySretTag
    call.relocWordOffset = -1
    for argIndex in 0..<2:
        add(call.argSlots, argIndex)
        add(call.argPassKinds, ir.BodyCallPassStackValueTag)
        add(call.argAbiSizes, 8)
    add(body.callSequence, call)
    var op: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = ir.BodyOpCallTag
    op.target = -1
    add(op.operands, 0)
    add(body.ops, op)
    var term: ir.BodyTerm
    ir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = -1
    let termIndex = ir.BodyIRAppendTerm(body, term)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn main(): int32 =
    # B1: codegen unit composition root (dispatch fails closed without registration)
    if !rega64.RegallocA64CodegenUnitRegister() ||
       !x8664adapter.RegallocX64CodegenUnitRegister():
        return 90
    var emptyBody = regallocProductionSmokeBodyIrNew()
    var noCallTargets: str[]
    let emptyEmission = emitter.RegallocProductionEmitFunction(
        "arm64-apple-darwin",
        emptyBody, "_regalloc_empty", 0,
        noCallTargets, noCallTargets,
        0, artifacts.RegallocProductionFunctionKindNormal)
    if emptyEmission.valid ||
       emptyEmission.errorCode !=
           emitter.RegallocProductionEmitPlanInvalid:
        return 250
    var termOnlyBody = regallocProductionSmokeBodyIrNew()
    let _ = regallocProductionSmokeAppendReturn(termOnlyBody, -1)
    let termOnlyPlan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        termOnlyBody,
        alloc.RegallocTargetConstraintsA64Darwin())
    if termOnlyPlan.valid ||
       termOnlyPlan.errorCode !=
           alloc.RegallocValuePlanErrorBodyIrIngress:
        return 251
    var constBody = regallocProductionSmokeConstBody()
    var frozenIngressBody = regallocProductionSmokeConstBody()
    var frozenIngressPlan =
        alloc.RegallocSinglePassValuePlanBuildDecoded(
            frozenIngressBody,
            alloc.RegallocTargetConstraintsA64Darwin())
    if !frozenIngressPlan.valid ||
       !alloc.RegallocSinglePassValuePlanMatchesBodyIrIngress(
           frozenIngressBody, frozenIngressPlan):
        return 252
    frozenIngressBody.ops[0].operands[1] =
        frozenIngressBody.ops[0].operands[1] + 1
    if alloc.RegallocSinglePassValuePlanMatchesBodyIrIngress(
           frozenIngressBody, frozenIngressPlan):
        return 253
    if frozenIngressPlan.actions.len <= 0:
        return 254
    frozenIngressPlan.actions[0].consumerOrdinal =
        frozenIngressPlan.actions[0].consumerOrdinal + 1
    if alloc.RegallocSinglePassValuePlanValidate(frozenIngressPlan):
        return 255
    var constEmission = emitter.RegallocProductionEmitFunction(
        "arm64-apple-darwin",
        constBody, "_regalloc_const", 0,
        noCallTargets, noCallTargets,
        0, artifacts.RegallocProductionFunctionKindNormal)
    if !constEmission.valid:
        return 100 + constEmission.errorCode
    if !constEmission.receipt.valid:
        return 113
    if constEmission.targetTriple !=
           artifacts.RegallocProductionTargetA64Darwin:
        return 114
    if !constEmission.plan.constraints.packedStackArgs:
        return 115
    if constEmission.recipes.functionWords.len <= 0:
        return 116
    if constEmission.receipt.symbolName != "_regalloc_const":
        return 117
    if constEmission.receipt.symbolByteStart != 0:
        return 118
    if constEmission.receipt.symbolByteLength !=
           constEmission.recipes.functionWords.len * 4:
        return 119
    if constEmission.receipt.actionCount != constEmission.plan.actions.len:
        return 120
    if len(constEmission.plan.bodyIrIngressSha256) != 64 ||
       constEmission.bodyIrSha256 !=
           constEmission.plan.bodyIrIngressSha256 ||
       len(constEmission.frozenSnapshotPayload) <= 0 ||
       len(constEmission.frozenSnapshotPayloadSha256) != 64 ||
       !strutil.Contains(
           constEmission.frozenSnapshotPayload,
           "phase=allocator_and_machine_recipe_freeze_before_fill\n") ||
       !strutil.Contains(
           constEmission.frozenSnapshotPayload,
           strutil.Join([
               "function.0.body_ir_sha256=",
               constEmission.plan.bodyIrIngressSha256, "\n"
           ], "")) ||
       !strutil.Contains(
           constEmission.frozenSnapshotPayload,
           "function.0.finalized=0\n") ||
       !strutil.Contains(
           constEmission.frozenSnapshotPayload,
           "function.0.emission_symbol_bound=0\n") ||
       !strutil.Contains(
           constEmission.frozenSnapshotPayload,
           strutil.Join([
               "snapshot_payload_sha256=",
               constEmission.frozenSnapshotPayloadSha256, "\n"
           ], "")):
        return 2
    var callBody = regallocProductionSmokeCallBody()
    var resolvedCallTargets: str[]
    add(resolvedCallTargets, "_resolved_callee")
    var callEmission = emitter.RegallocProductionEmitFunction(
        "arm64-apple-darwin",
        callBody, "_regalloc_call", 64,
        resolvedCallTargets, noCallTargets,
        0, artifacts.RegallocProductionFunctionKindNormal)
    if !callEmission.valid || !callEmission.receipt.valid:
        if callEmission.errorCode ==
           emitter.RegallocProductionEmitRelocInvalid:
            for relocIndex in 0..<callEmission.recipes.functionRelocs.len:
                let failedReloc =
                    callEmission.recipes.functionRelocs[relocIndex]
                if failedReloc.opIndex < 0:
                    return 41
                if failedReloc.kind ==
                       contract.RegallocA64RelocCall26 &&
                   failedReloc.subIndex >= 0:
                    return 42
            return 43
        return 20 + callEmission.errorCode
    var callRelocCount: int32
    for relocIndex in 0..<callEmission.recipes.functionRelocs.len:
        let reloc = callEmission.recipes.functionRelocs[relocIndex]
        if reloc.kind == contract.RegallocA64RelocCall26:
            if reloc.callOrdinal != 0 ||
               reloc.targetSymbol != "_resolved_callee":
                return 3
            callRelocCount = callRelocCount + 1
    if callRelocCount != 1:
        return 4
    var globalBody = regallocProductionSmokeGlobalStoreBody()
    var resolvedDataTargets: str[]
    add(resolvedDataTargets, "")
    add(resolvedDataTargets, "_production_global_i32")
    var globalEmission = emitter.RegallocProductionEmitFunction(
        "arm64-apple-darwin",
        globalBody, "_regalloc_global_store", 128,
        noCallTargets, resolvedDataTargets,
        0, artifacts.RegallocProductionFunctionKindNormal)
    if !globalEmission.valid || !globalEmission.receipt.valid:
        return 50 + globalEmission.errorCode
    if globalEmission.recipes.functionRelocs.len != 2:
        return 60
    let pageReloc = globalEmission.recipes.functionRelocs[0]
    let pageOffReloc = globalEmission.recipes.functionRelocs[1]
    if pageReloc.kind != contract.RegallocA64RelocPage21 ||
       pageOffReloc.kind != contract.RegallocA64RelocPageOff12 ||
       pageReloc.wordIndex + 1 != pageOffReloc.wordIndex ||
       pageReloc.opIndex != 0 || pageOffReloc.opIndex != 0 ||
       pageReloc.subIndex != 0 || pageOffReloc.subIndex != 0 ||
       pageReloc.targetSymbol != "_production_global_i32" ||
       pageOffReloc.targetSymbol != "_production_global_i32":
        return 61
    var sretBody = regallocProductionSmokeSretForwardBody()
    var intrinsicTargets: str[]
    add(intrinsicTargets, "")
    var sretEmission = emitter.RegallocProductionEmitFunction(
        "arm64-apple-darwin",
        sretBody, "_regalloc_sret_forward", 256,
        intrinsicTargets, noCallTargets,
        0, artifacts.RegallocProductionFunctionKindNormal)
    if !sretEmission.valid:
        return 100 + sretEmission.errorCode
    if !sretEmission.receipt.valid:
        return 81
    if sretEmission.recipeOrigin !=
           artifacts.RegallocProductionRecipeOriginBodyIrAdapter:
        return 82
    if sretEmission.recipes.functionWords.len <= 0:
        return 83
    if sretEmission.recipes.functionRelocs.len != 0:
        return 84
    if sretEmission.receipt.actionEmissions.len !=
           sretEmission.plan.actions.len:
        return 85
    var sretForwardCount: int32
    for actionIndex in 0..<sretEmission.plan.actions.len:
        let action = sretEmission.plan.actions[actionIndex]
        if action.kind != alloc.RegallocValueActionSretForward:
            continue
        let actionEmission =
            sretEmission.receipt.actionEmissions[actionIndex]
        if action.factIndex < 0 ||
           action.factIndex >=
               sretEmission.plan.accessFactRegisters.len ||
           sretEmission.plan.accessFactRegisters[action.factIndex] != 8 ||
           !action.acknowledged || action.callOrdinal != 0 ||
           action.fixedKind != access.BodyIrAccessFixedSretForward ||
           action.passKind != ir.BodyCallPassForwardEntrySretTag ||
           action.semanticKind != ir.BodyOpCallTag ||
           action.semanticRegister != 8 ||
           alloc.RegallocSinglePassValueActionBindingKind(action.kind) !=
               alloc.RegallocValueBindingStructural ||
           actionEmission.bindingKind !=
               alloc.RegallocValueBindingStructural ||
           actionEmission.emittedByteStart != 0 ||
           actionEmission.emittedByteLength != 0 ||
           actionEmission.emittedBytesSha256 !=
               alloc.RegallocValueEmptySha256:
            return 71
        sretForwardCount = sretForwardCount + 1
    if sretForwardCount != 1:
        return 72
    var wrongPassBody = regallocProductionSmokeSretForwardBody()
    var wrongPassCall = wrongPassBody.callSequence[0]
    wrongPassCall.resultPassKind = ir.BodyCallPassStackValueTag
    wrongPassBody.callSequence = []
    add(wrongPassBody.callSequence, wrongPassCall)
    let wrongPassEmission = emitter.RegallocProductionEmitFunction(
        "arm64-apple-darwin",
        wrongPassBody, "_regalloc_sret_wrong_pass", 512,
        intrinsicTargets, noCallTargets,
        0, artifacts.RegallocProductionFunctionKindNormal)
    if wrongPassEmission.valid:
        return 73
    var missingCAbiBody = regallocProductionSmokeSretForwardBody()
    missingCAbiBody.entryIsCAbi = false
    let missingCAbiEmission = emitter.RegallocProductionEmitFunction(
        "arm64-apple-darwin",
        missingCAbiBody, "_regalloc_sret_missing_cabi", 768,
        intrinsicTargets, noCallTargets,
        0, artifacts.RegallocProductionFunctionKindNormal)
    if missingCAbiEmission.valid:
        return 74
    var wrongTargetBody = regallocProductionSmokeSretForwardBody()
    var wrongTargetCall = wrongTargetBody.callSequence[0]
    wrongTargetCall.targetSymbol = "not_sret_forward_intrinsic"
    wrongTargetBody.callSequence = []
    add(wrongTargetBody.callSequence, wrongTargetCall)
    let wrongTargetEmission = emitter.RegallocProductionEmitFunction(
        "arm64-apple-darwin",
        wrongTargetBody, "_regalloc_sret_wrong_target", 1024,
        intrinsicTargets, noCallTargets,
        0, artifacts.RegallocProductionFunctionKindNormal)
    if wrongTargetEmission.valid:
        return 75
    var linuxBody = regallocProductionSmokeConstBody()
    var linuxEmission = emitter.RegallocProductionEmitFunction(
        artifacts.RegallocProductionTargetA64Linux,
        linuxBody, "regalloc_linux_aarch64", 0,
        noCallTargets, noCallTargets,
        1, artifacts.RegallocProductionFunctionKindNormal)
    if !linuxEmission.valid:
        if linuxEmission.errorCode ==
               emitter.RegallocProductionEmitSnapshotInvalid:
            return 150 + linuxEmission.errorDetail
        return 130 + linuxEmission.errorCode
    if !linuxEmission.receipt.valid:
        return 143
    if linuxEmission.targetTriple !=
           artifacts.RegallocProductionTargetA64Linux:
        return 144
    if linuxEmission.plan.constraints.packedStackArgs:
        return 145
    if !strutil.Contains(
           linuxEmission.frozenSnapshotPayload,
           "target=aarch64-unknown-linux-gnu\n"):
        return 146
    var x8664Body = regallocProductionSmokeConstBody()
    var x8664Emission = emitter.RegallocProductionEmitFunction(
        artifacts.RegallocProductionTargetX64Linux,
        x8664Body, "regalloc_linux_x86_64", 0,
        noCallTargets, noCallTargets,
        2, artifacts.RegallocProductionFunctionKindNormal)
    if !x8664Emission.valid || !x8664Emission.receipt.valid:
        return 201
    if x8664Emission.targetTriple !=
           artifacts.RegallocProductionTargetX64Linux:
        return 202
    if !x8664Emission.plan.valid || !x8664Emission.plan.frozen ||
       !x8664Emission.plan.finalized ||
       !alloc.RegallocSinglePassValuePlanValidate(x8664Emission.plan):
        return 203
    if x8664Emission.plan.constraints.packedStackArgs ||
       x8664Emission.plan.constraints.fixedSretReg != 7 ||
       !x8664Emission.plan.constraints.sretShiftsFixedArgs ||
       x8664Emission.plan.constraints.parallelCopyScratchReg != 11:
        return 204
    if x8664Emission.recipes.functionWords.len <= 0 ||
       x8664Emission.receipt.symbolByteLength !=
           x8664Emission.recipes.functionWords.len * 4 ||
       x8664Emission.receipt.actionCount !=
           x8664Emission.plan.actions.len:
        return 205
    if x8664Emission.recipes.functionRelocs.len != 0:
        return 206
    if len(x8664Emission.bodyIrSha256) != 64 ||
       !strutil.Contains(
           x8664Emission.frozenSnapshotPayload,
           "target=x86_64-unknown-linux-gnu\n"):
        return 207
    let firstWord = uint32(x8664Emission.recipes.functionWords[0])
    if int32(firstWord & uint32(255)) != 0x55 ||
       int32((firstWord >> uint32(8)) & uint32(255)) != 0x48 ||
       int32((firstWord >> uint32(16)) & uint32(255)) != 0x89 ||
       int32((firstWord >> uint32(24)) & uint32(255)) != 0xE5:
        return 208
    var x8664ParamBody = regallocProductionSmokeParamBody()
    var x8664ParamEmission = emitter.RegallocProductionEmitFunction(
        artifacts.RegallocProductionTargetX64Linux,
        x8664ParamBody, "regalloc_linux_x86_64_param", 0,
        noCallTargets, noCallTargets,
        3, artifacts.RegallocProductionFunctionKindNormal)
    if !x8664ParamEmission.valid:
        return 211
    if x8664ParamEmission.recipes.abiIngressRegs.len != 1 ||
       x8664ParamEmission.recipes.abiIngressOffsets.len != 1 ||
       x8664ParamEmission.recipes.abiIngressOffsets[0] != -1:
        return 212
    if x8664ParamEmission.recipes.parameterHomeOffsets.len != 1 ||
       x8664ParamEmission.recipes.parameterHomeOffsets[0] != -1:
        return 213
    if !strutil.Contains(
           x8664ParamEmission.frozenSnapshotPayload,
           "function.0.abi_ingress.0.role=parameter_register\n"):
        return 214
    var x8664CallBody = regallocProductionSmokeCallBody()
    var x8664CallEmission = emitter.RegallocProductionEmitFunction(
        artifacts.RegallocProductionTargetX64Linux,
        x8664CallBody, "regalloc_linux_x86_64_call", 0,
        resolvedCallTargets, noCallTargets,
        4, artifacts.RegallocProductionFunctionKindNormal)
    if !x8664CallEmission.valid ||
       !x8664CallEmission.receipt.valid ||
       x8664CallEmission.recipes.functionWords.len <= 0 ||
       x8664CallEmission.recipes.functionRelocs.len != 1:
        return 209
    let x8664CallReloc =
        x8664CallEmission.recipes.functionRelocs[0]
    if x8664CallReloc.kind !=
           contract.RegallocMachineRelocPcRel32 ||
       x8664CallReloc.callOrdinal != 0 ||
       x8664CallReloc.opIndex != 0 ||
       x8664CallReloc.subIndex != -1 ||
       x8664CallReloc.byteOffset <= 0 ||
       x8664CallReloc.wordIndex !=
           x8664CallReloc.byteOffset / 4 ||
       x8664CallReloc.targetSymbol != "_resolved_callee":
        return 215
    var callActionCount: int32
    for actionIndex in 0..<x8664CallEmission.plan.actions.len:
        let action = x8664CallEmission.plan.actions[actionIndex]
        if action.kind != alloc.RegallocValueActionCallClobber:
            continue
        if !action.effectCall || action.fragmentOrdinal < 0:
            return 216
        callActionCount = callActionCount + 1
    if callActionCount != 1:
        return 217
    var x8664IndirectBody = regallocProductionSmokeCallBody()
    var x8664IndirectCall = x8664IndirectBody.callSequence[0]
    x8664IndirectCall.targetSourcePath = ""
    x8664IndirectBody.callSequence = []
    add(x8664IndirectBody.callSequence, x8664IndirectCall)
    let x8664IndirectEmission =
        emitter.RegallocProductionEmitFunction(
            artifacts.RegallocProductionTargetX64Linux,
            x8664IndirectBody, "regalloc_linux_x86_64_indirect", 0,
            resolvedCallTargets, noCallTargets,
            5, artifacts.RegallocProductionFunctionKindNormal)
    if x8664IndirectEmission.valid ||
       x8664IndirectEmission.errorCode !=
           emitter.RegallocProductionEmitRecipeInvalid ||
       x8664IndirectEmission.recipes.functionWords.len != 0 ||
       x8664IndirectEmission.recipes.functionRelocs.len != 0:
        return 218
    var x8664ImportcBody = regallocProductionSmokeCallBody()
    var x8664ImportcCall = x8664ImportcBody.callSequence[0]
    x8664ImportcCall.targetIsImportc = true
    x8664ImportcBody.callSequence = []
    add(x8664ImportcBody.callSequence, x8664ImportcCall)
    let x8664ImportcEmission =
        emitter.RegallocProductionEmitFunction(
            artifacts.RegallocProductionTargetX64Linux,
            x8664ImportcBody, "regalloc_linux_x86_64_importc", 0,
            resolvedCallTargets, noCallTargets,
            6, artifacts.RegallocProductionFunctionKindNormal)
    if x8664ImportcEmission.valid ||
       x8664ImportcEmission.errorCode !=
           emitter.RegallocProductionEmitRecipeInvalid ||
       x8664ImportcEmission.recipes.functionWords.len != 0 ||
       x8664ImportcEmission.recipes.functionRelocs.len != 0:
        return 219
    var x8664StackArgBody =
        regallocProductionSmokeStackArgBody()
    var x8664StackTargets: str[]
    add(x8664StackTargets, "_resolved_stack_arg_callee")
    let x8664StackArgEmission =
        emitter.RegallocProductionEmitFunction(
            artifacts.RegallocProductionTargetX64Linux,
            x8664StackArgBody, "regalloc_linux_x86_64_stack_arg", 0,
            x8664StackTargets, noCallTargets,
            7, artifacts.RegallocProductionFunctionKindNormal)
    if !x8664StackArgEmission.valid:
        return 220
    if !x8664StackArgEmission.receipt.valid ||
       x8664StackArgEmission.recipes.functionRelocs.len != 1 ||
       x8664StackArgEmission.recipes.outgoingStackBytes != 16:
        return 221
    var x8664StackStoreCount: int32
    for actionIndex in 0..<
            x8664StackArgEmission.plan.actions.len:
        let action =
            x8664StackArgEmission.plan.actions[actionIndex]
        if action.kind !=
               alloc.RegallocValueActionStoreStackArg:
            continue
        if action.callOrdinal != 0 ||
           action.fixedOrdinal != 6 ||
           action.outgoingStackArgIndex != 0 ||
           action.outgoingStackByteOffset != 0 ||
           action.outgoingStackByteWidth != 8 ||
           action.outgoingStackFrameBytes != 16 ||
           action.fragmentOrdinal < 0 ||
           actionIndex >=
               x8664StackArgEmission.receipt.actionEmissions.len ||
           x8664StackArgEmission.receipt.actionEmissions[
               actionIndex].emittedByteLength <= 0:
            return 222
        x8664StackStoreCount = x8664StackStoreCount + 1
    if x8664StackStoreCount != 1:
        return 223
    var x8664DirectSretBody =
        regallocProductionSmokeDirectSretBody()
    var x8664DirectSretTargets: str[]
    add(x8664DirectSretTargets,
        "_resolved_direct_sret_callee")
    let x8664DirectSretEmission =
        emitter.RegallocProductionEmitFunction(
            artifacts.RegallocProductionTargetX64Linux,
            x8664DirectSretBody,
            "regalloc_linux_x86_64_direct_sret", 0,
            x8664DirectSretTargets, noCallTargets,
            8, artifacts.RegallocProductionFunctionKindNormal)
    if !x8664DirectSretEmission.valid:
        return 230
    if !x8664DirectSretEmission.receipt.valid ||
       x8664DirectSretEmission.recipes.functionRelocs.len != 1 ||
       !x8664DirectSretEmission.recipes.hasSretReturn ||
       x8664DirectSretEmission.recipes.returnBufferSaveOffset >= 0 ||
       x8664DirectSretEmission.recipes.outgoingStackBytes != 16:
        return 224
    var x8664SretAddressCount: int32
    var x8664SretBindCount: int32
    var x8664SretReturnCount: int32
    var x8664SretStackStoreCount: int32
    for actionIndex in 0..<
            x8664DirectSretEmission.plan.actions.len:
        let action =
            x8664DirectSretEmission.plan.actions[actionIndex]
        if action.kind ==
               alloc.RegallocValueActionAddressFixed:
            if action.callOrdinal != 0 ||
               action.targetReg != 7 ||
               action.fixedKind !=
                   access.BodyIrAccessFixedSretResult:
                return 225
            x8664SretAddressCount =
                x8664SretAddressCount + 1
        elif action.kind ==
                 alloc.RegallocValueActionBindSretResult:
            if action.callOrdinal != 0 ||
               action.fixedKind !=
                   access.BodyIrAccessFixedSretResult:
                return 226
            x8664SretBindCount = x8664SretBindCount + 1
        elif action.kind ==
                 alloc.RegallocValueActionStoreSretReturn:
            if action.targetReg != 7 ||
               action.fragmentOrdinal < 0:
                return 227
            x8664SretReturnCount =
                x8664SretReturnCount + 1
        elif action.kind ==
                 alloc.RegallocValueActionStoreStackArg:
            if action.fixedOrdinal != 5 ||
               action.outgoingStackArgIndex != 0 ||
               action.outgoingStackByteOffset != 0 ||
               action.outgoingStackByteWidth != 8 ||
               action.outgoingStackFrameBytes != 16:
                return 228
            x8664SretStackStoreCount =
                x8664SretStackStoreCount + 1
    if x8664SretAddressCount != 1 ||
       x8664SretBindCount != 1 ||
       x8664SretReturnCount != 1 ||
       x8664SretStackStoreCount != 1:
        return 229
    var x8664SretBody = regallocProductionSmokeSretForwardBody()
    var x8664SretEmission = emitter.RegallocProductionEmitFunction(
        artifacts.RegallocProductionTargetX64Linux,
        x8664SretBody, "regalloc_linux_x86_64_sret", 0,
        intrinsicTargets, noCallTargets,
        9, artifacts.RegallocProductionFunctionKindNormal)
    if !x8664SretEmission.valid:
        return 240 + x8664SretEmission.errorCode
    if !x8664SretEmission.receipt.valid ||
       x8664SretEmission.recipes.functionWords.len <= 0 ||
       x8664SretEmission.recipes.functionRelocs.len != 0 ||
       !x8664SretEmission.recipes.hasSretReturn ||
       x8664SretEmission.recipes.returnBufferSaveOffset >= 0:
        return 210
    if x8664SretEmission.recipes.abiIngressRegs.len != 3 ||
       x8664SretEmission.recipes.abiIngressParamOrdinals.len != 3 ||
       x8664SretEmission.recipes.abiIngressRegs[0] != 7 ||
       x8664SretEmission.recipes.abiIngressParamOrdinals[0] != -1 ||
       x8664SretEmission.recipes.abiIngressRegs[1] != 6 ||
       x8664SretEmission.recipes.abiIngressParamOrdinals[1] != 0 ||
       x8664SretEmission.recipes.abiIngressRegs[2] != 2 ||
       x8664SretEmission.recipes.abiIngressParamOrdinals[2] != 1:
        return 211
    var x8664ForwardCount: int32
    var x8664ForwardCallCount: int32
    for actionIndex in 0..<x8664SretEmission.plan.actions.len:
        let action = x8664SretEmission.plan.actions[actionIndex]
        if action.kind == alloc.RegallocValueActionSretForward:
            let actionEmission =
                x8664SretEmission.receipt.actionEmissions[actionIndex]
            if action.callOrdinal != 0 ||
               action.fixedKind !=
                   access.BodyIrAccessFixedSretForward ||
               action.passKind !=
                   ir.BodyCallPassForwardEntrySretTag ||
               action.semanticKind != ir.BodyOpCallTag ||
               action.semanticRegister != 7 ||
               alloc.RegallocSinglePassValueActionBindingKind(
                   action.kind) !=
                   alloc.RegallocValueBindingStructural ||
               actionEmission.bindingKind !=
                   alloc.RegallocValueBindingStructural ||
               actionEmission.emittedByteLength != 0 ||
               actionEmission.emittedBytesSha256 !=
                   alloc.RegallocValueEmptySha256:
                return 212
            x8664ForwardCount = x8664ForwardCount + 1
        elif action.kind ==
                 alloc.RegallocValueActionCallClobber:
            if action.callOrdinal != 0 ||
               action.fragmentOrdinal < 0 ||
               action.fragmentOrdinal >=
                   x8664SretEmission.recipes.machineFragments.len:
                return 213
            let fragment =
                x8664SretEmission.recipes.machineFragments[
                    action.fragmentOrdinal]
            if fragment.ownerKind !=
                   contract.RegallocA64FragmentOwnerAction ||
               fragment.actionConsumerOrdinal != actionIndex ||
               fragment.relocs.len != 0 ||
               (fragment.effectMask &
                    contract.RegallocA64EffectCall) == 0 ||
               x8664SretEmission.receipt.actionEmissions[
                   actionIndex].emittedByteLength <= 0:
                return 214
            x8664ForwardCallCount =
                x8664ForwardCallCount + 1
    if x8664ForwardCount != 1 ||
       x8664ForwardCallCount != 1:
        return 231
    return 0
