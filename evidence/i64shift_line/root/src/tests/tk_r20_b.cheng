type R20Seed = object
    endColumnNumber: int32
    surfaceText: str

fn R20Find(line: str, start: int32): int32 =
    if start < line.len:
        return start
    return -1

fn R20Append(lineRaw: str, seeds: var R20Seed[]) =
    var searchStart: int32
    while searchStart < lineRaw.len:
        let breakPos = R20Find(lineRaw, searchStart)
        var tokenStart = -1
        var surfaceText = "break"
        if breakPos >= 0:
            tokenStart = breakPos
        else:
            tokenStart = breakPos
            surfaceText = "continue"
        var seed: R20Seed
        seed.endColumnNumber = tokenStart + surfaceText.len
        seed.surfaceText = surfaceText
        add(seeds, seed)
        searchStart = searchStart + 1

fn main(): int32 =
    var seeds: R20Seed[]
    R20Append("break", seeds)
    echo("r20 ok")
    return 0
