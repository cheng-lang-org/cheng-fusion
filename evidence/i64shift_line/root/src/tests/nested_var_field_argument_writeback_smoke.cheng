type
    NestedVarLeaf =
        left: int32
        value: int32
        right: int32
    NestedVarBranch =
        head: int64
        leaf: NestedVarLeaf
        tail: int64
    NestedVarRoot =
        prefix: int32
        branch: NestedVarBranch
        suffix: int32
    NestedVarNode = ref object
        marker: int32
    NestedVarRefBranch =
        head: int64
        node: NestedVarNode
        tail: int64
    NestedVarRefRoot =
        prefix: int32
        branch: NestedVarRefBranch
        suffix: int32

fn nestedVarMoveScalar(outValue: var int32,
                       sourceValue: var int32) =
    outValue = sourceValue
    sourceValue = -7

fn nestedVarMoveLeaf(outLeaf: var NestedVarLeaf,
                     sourceLeaf: var NestedVarLeaf) =
    outLeaf.left = sourceLeaf.left
    outLeaf.value = sourceLeaf.value
    outLeaf.right = sourceLeaf.right
    sourceLeaf.left = -11
    sourceLeaf.value = -12
    sourceLeaf.right = -13

fn nestedVarRelayScalar(outRoot: var NestedVarRoot,
                        sourceRoot: var NestedVarRoot) =
    nestedVarMoveScalar(outRoot.branch.leaf.value,
                        sourceRoot.branch.leaf.value)

fn nestedVarRelayLeaf(outRoot: var NestedVarRoot,
                      sourceRoot: var NestedVarRoot) =
    nestedVarMoveLeaf(outRoot.branch.leaf,
                      sourceRoot.branch.leaf)

fn nestedVarMoveRef(outNode: var NestedVarNode,
                    sourceNode: var NestedVarNode) =
    outNode = sourceNode
    sourceNode = nil

fn nestedVarRelayRef(outRoot: var NestedVarRefRoot,
                     sourceRoot: var NestedVarRefRoot) =
    nestedVarMoveRef(outRoot.branch.node,
                     sourceRoot.branch.node)

fn main(): int32 =
    var scalarOut: NestedVarRoot
    var scalarSource: NestedVarRoot
    scalarOut.prefix = 101
    scalarOut.branch.head = 102
    scalarOut.branch.leaf.left = 103
    scalarOut.branch.leaf.value = 104
    scalarOut.branch.leaf.right = 105
    scalarOut.branch.tail = 106
    scalarOut.suffix = 107
    scalarSource.prefix = 201
    scalarSource.branch.head = 202
    scalarSource.branch.leaf.left = 203
    scalarSource.branch.leaf.value = 204
    scalarSource.branch.leaf.right = 205
    scalarSource.branch.tail = 206
    scalarSource.suffix = 207
    nestedVarRelayScalar(scalarOut, scalarSource)
    if scalarOut.branch.leaf.value != 204 ||
       scalarSource.branch.leaf.value != -7:
        return 1
    if scalarOut.prefix != 101 || scalarOut.branch.head != 102 ||
       scalarOut.branch.leaf.left != 103 ||
       scalarOut.branch.leaf.right != 105 ||
       scalarOut.branch.tail != 106 || scalarOut.suffix != 107:
        return 2
    if scalarSource.prefix != 201 || scalarSource.branch.head != 202 ||
       scalarSource.branch.leaf.left != 203 ||
       scalarSource.branch.leaf.right != 205 ||
       scalarSource.branch.tail != 206 || scalarSource.suffix != 207:
        return 3

    var leafOut: NestedVarRoot
    var leafSource: NestedVarRoot
    leafOut.prefix = 301
    leafOut.branch.head = 302
    leafOut.branch.leaf.left = 303
    leafOut.branch.leaf.value = 304
    leafOut.branch.leaf.right = 305
    leafOut.branch.tail = 306
    leafOut.suffix = 307
    leafSource.prefix = 401
    leafSource.branch.head = 402
    leafSource.branch.leaf.left = 403
    leafSource.branch.leaf.value = 404
    leafSource.branch.leaf.right = 405
    leafSource.branch.tail = 406
    leafSource.suffix = 407
    nestedVarRelayLeaf(leafOut, leafSource)
    if leafOut.branch.leaf.left != 403 ||
       leafOut.branch.leaf.value != 404 ||
       leafOut.branch.leaf.right != 405:
        return 4
    if leafSource.branch.leaf.left != -11 ||
       leafSource.branch.leaf.value != -12 ||
       leafSource.branch.leaf.right != -13:
        return 5
    if leafOut.prefix != 301 || leafOut.branch.head != 302 ||
       leafOut.branch.tail != 306 || leafOut.suffix != 307:
        return 6
    if leafSource.prefix != 401 || leafSource.branch.head != 402 ||
       leafSource.branch.tail != 406 || leafSource.suffix != 407:
        return 7

    var refOut: NestedVarRefRoot
    var refSource: NestedVarRefRoot
    refOut.prefix = 501
    refOut.branch.head = 502
    refOut.branch.tail = 503
    refOut.suffix = 504
    refSource.prefix = 601
    refSource.branch.head = 602
    refSource.branch.node = new(NestedVarNode)
    refSource.branch.node.marker = 603
    refSource.branch.tail = 604
    refSource.suffix = 605
    nestedVarRelayRef(refOut, refSource)
    if refOut.branch.node == nil || refOut.branch.node.marker != 603:
        return 8
    if refSource.branch.node != nil:
        return 9
    if refOut.prefix != 501 || refOut.branch.head != 502 ||
       refOut.branch.tail != 503 || refOut.suffix != 504:
        return 10
    if refSource.prefix != 601 || refSource.branch.head != 602 ||
       refSource.branch.tail != 604 || refSource.suffix != 605:
        return 11
    echo("nested_var_field_argument_writeback_smoke ok")
    return 0
