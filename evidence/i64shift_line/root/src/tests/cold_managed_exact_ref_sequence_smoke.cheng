import std/system as system

type ColdManagedExactSequenceRef = ref object
    marker: int32

fn ColdManagedExactRefSequenceExercise(): int32 =
    let allocBefore = system.memAllocCount()
    let freeBefore = system.memFreeCount()
    let liveBefore = system.memLiveCount()
    let retainBefore = system.memRetainCount()
    let releaseBefore = system.memReleaseCount()

    var first = new(ColdManagedExactSequenceRef)
    first.marker = 11
    var values: ColdManagedExactSequenceRef[]
    add(values, share(first))
    if values.len != 1 ||
       values[0] != first ||
       values[0].marker != 11 ||
       system.memRefCount(first) != 2:
        return 1

    var second = new(ColdManagedExactSequenceRef)
    second.marker = 22
    values[0] = share(second)
    if values.len != 1 ||
       values[0] != second ||
       values[0].marker != 22 ||
       system.memRefCount(first) != 1 ||
       system.memRefCount(second) != 2:
        return 2

    values = []
    if system.memRefCount(first) != 1 ||
       system.memRefCount(second) != 1:
        return 3
    first = nil
    second = nil

    let allocDelta = system.memAllocCount() - allocBefore
    let freeDelta = system.memFreeCount() - freeBefore
    let retainDelta = system.memRetainCount() - retainBefore
    let releaseDelta = system.memReleaseCount() - releaseBefore
    if allocDelta <= int64(0) || allocDelta != freeDelta:
        return 4
    if system.memLiveCount() != liveBefore:
        return 5
    if retainDelta != int64(2):
        return 6
    if releaseDelta != retainDelta + freeDelta:
        return 7
    return 0

fn main(): int32 =
    let result = ColdManagedExactRefSequenceExercise()
    if result != 0:
        return result
    echo("cold_managed_exact_ref_sequence=PASS")
    return 0
