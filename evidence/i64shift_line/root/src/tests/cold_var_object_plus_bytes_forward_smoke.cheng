import std/rawbytes

type
    ColdForwardFe =
        v0: int64
        v1: int64
        v2: int64
        v3: int64
        v4: int64
        v5: int64
        v6: int64
        v7: int64
        v8: int64
        v9: int64

    ColdForwardPoint =
        x: ColdForwardFe
        y: ColdForwardFe
        z: ColdForwardFe
        t: ColdForwardFe

fn ColdVarBytesInner(p: var ColdForwardPoint, b: Bytes): bool =
    p.y.v0 = int64(BytesLen(b))
    return p.y.v0 == int64(32)

fn ColdVarBytesOuter(p: var ColdForwardPoint, b: Bytes): bool =
    return ColdVarBytesInner(p, b)

fn main(): int32 =
    var p: ColdForwardPoint
    var b: Bytes
    b = BytesAlloc(32)
    if !ColdVarBytesInner(p, b):
        return 1
    if int32(p.y.v0) != 32:
        return 2
    p.y.v0 = int64(0)
    if !ColdVarBytesOuter(p, b):
        return 3
    if int32(p.y.v0) != 32:
        return 4
    return 0
