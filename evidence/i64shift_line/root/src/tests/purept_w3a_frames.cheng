# W3a frames driver: RFC 9001 Appendix A.2 (client Initial payload) and A.3
# (server Initial payload) field-by-field parse, randomized and fixed
# encode->decode->encode byte-identity + field-identity rounds with per-kind
# coverage proof, and the frame negative set. Any mismatch exits non-zero.

import std/os
import std/rawbytes
import std/strings as strings
import cheng/quic/pure/frames_varint as quicvarint
import cheng/quic/pure/frames_codec as quicframe

var gFails: int32
var gRng: int64
var gPool: Bytes
var gKindMask: int32

@borrows
fn fail2(tag: str, detail: str) =
    os.WriteLine(os.Get_stdout(), strings.concatStr("FAIL ", strings.concatStr(tag,
        strings.concatStr(": ", detail))))
    gFails = gFails + 1

@borrows
fn pass2(tag: str, detail: str) =
    os.WriteLine(os.Get_stdout(), strings.concatStr("PASS ", strings.concatStr(tag,
        strings.concatStr(": ", detail))))

fn rndNext(): int64 =
    gRng = gRng ^ (gRng << 13)
    gRng = gRng ^ (gRng >> 7)
    gRng = gRng ^ (gRng << 17)
    return gRng

fn rndBelow(n: int32): int32 =
    return int32(quicvarint.QuicLshr64(rndNext(), 20) % int64(n))

fn rndValue(): int64 =
    # Random varint-legal value spread over the four encoding tiers.
    let tier: int32 = rndBelow(4)
    if tier == 0:
        return int64(rndBelow(64))
    if tier == 1:
        return int64(rndBelow(16384))
    if tier == 2:
        return int64(rndBelow(1000000))
    return int64(rndBelow(1000000)) * 1000000 + int64(rndBelow(1000000))

@borrows
fn genRandomPayload(pool: Bytes, off: int32, len: int32) =
    var i: int32
    while i < len:
        BytesSet(pool, off + i, rndBelow(256))
        i = i + 1

# ---- (a) sample payload parse: RFC 9001 A.2 client / A.3 server ----

@borrows
fn parseSamplePayload(tag: str, cryptoHex: str, wantCryptoLen: int64,
                      padZeros: int32, wantAck: bool, ackHex: str): bool =
    # Assemble via a builder: appends copy, so no move-of-local hazards.
    var bb: BytesBuilder = BytesBuilderNew(2048)
    if wantAck:
        BytesBuilderAppend(bb, BytesFromHex(ackHex))
    BytesBuilderAppend(bb, BytesFromHex(cryptoHex))
    if padZeros > 0:
        var z: int32
        while z < padZeros:
            BytesBuilderAppendByte(bb, 0)
            z = z + 1
    let buf: Bytes = BytesBuilderFinish(bb)
    var pos: int32
    var f: quicframe.QuicFrame = quicframe.QuicFrameZero()
    if wantAck:
        let nextA: int32 = quicframe.QuicFrameDecodeAt(buf, pos, f)
        if nextA < 0:
            fail2(tag, strings.concatStr("ack decode err ", strings.IntToStr(nextA)))
            return false
        if f.ftype != quicframe.QuicFrameAck:
            fail2(tag, strings.concatStr("first frame type ", strings.IntToStr(f.ftype)))
            return false
        if f.largestAck != 0 || f.ackDelay != 0 || f.ackRangeCount != 0 || f.firstAckRange != 0:
            fail2(tag, strings.concatStr("ack fields largest=", strings.Int64ToStr(f.largestAck)))
            return false
        pass2(tag, "ACK(0,0,extra_ranges=0,range=0) no ECN")
        pos = nextA
    let nextC: int32 = quicframe.QuicFrameDecodeAt(buf, pos, f)
    if nextC < 0:
        fail2(tag, strings.concatStr("crypto decode err ", strings.IntToStr(nextC)))
        return false
    if f.ftype != quicframe.QuicFrameCrypto:
        fail2(tag, strings.concatStr("expected CRYPTO got ", strings.IntToStr(f.ftype)))
        return false
    if f.offset != 0 || f.length != wantCryptoLen || f.dataLen != int32(wantCryptoLen):
        fail2(tag, strings.concatStr("crypto off=", strings.Int64ToStr(f.offset)))
        return false
    pos = nextC
    if padZeros > 0:
        var pads: int32
        var g: quicframe.QuicFrame = quicframe.QuicFrameZero()
        while pos < buf.len:
            let nx: int32 = quicframe.QuicFrameDecodeAt(buf, pos, g)
            if nx < 0:
                fail2(tag, strings.concatStr("padding walk err at ", strings.IntToStr(pos)))
                return false
            if g.ftype != quicframe.QuicFramePadding:
                fail2(tag, strings.concatStr("non-padding at ", strings.IntToStr(pos)))
                return false
            pads = pads + 1
            pos = nx
        if pads != padZeros:
            fail2(tag, strings.concatStr("padding count=", strings.IntToStr(pads)))
            return false
    else:
        if pos != buf.len:
            fail2(tag, "payload not fully consumed")
            return false
    pass2(tag, strings.concatStr("CRYPTO(off=0,len=",
        strings.concatStr(strings.Int64ToStr(f.length),
        strings.concatStr(") parsed, walk consumed ", strings.IntToStr(pos)))))
    return true

# ---- randomized round-trip: expected field identity ----

const
    MaxFramesPerRound: int32 = 8

var expType: int32[]
var expV0: int64[]
var expV1: int64[]
var expV2: int64[]
var expV3: int64[]
var expDataLen: int32[]

# Generates one random frame: appends wire bytes to b (payload from gPool at
# poolOff), records expected scalars at index i. Returns pool bytes consumed.
fn genOneFrame(b: var BytesBuilder, poolOff: int32, i: int32, isLast: bool): int32 =
    let kind: int32 = rndBelow(11)
    gKindMask = gKindMask | (1 << kind)
    if kind == 0:
        BytesBuilderAppendByte(b, 0x00)
        expType[i] = quicframe.QuicFramePadding
        return 0
    if kind == 1:
        BytesBuilderAppendByte(b, 0x01)
        expType[i] = quicframe.QuicFramePing
        return 0
    if kind == 2:
        let ecn: bool = (rndBelow(2) == 0)
        let largest: int64 = rndValue() % 100000
        let delay: int64 = rndValue() % 10000
        let ranges: int64 = int64(rndBelow(3))
        let firstR: int64 = rndValue() % 500
        if ecn:
            BytesBuilderAppendByte(b, 0x03)
        else:
            BytesBuilderAppendByte(b, 0x02)
        quicvarint.QuicVarintAppend(b, largest)
        quicvarint.QuicVarintAppend(b, delay)
        quicvarint.QuicVarintAppend(b, ranges)
        quicvarint.QuicVarintAppend(b, firstR)
        var r: int64
        while r < ranges:
            quicvarint.QuicVarintAppend(b, int64(rndBelow(64)))
            quicvarint.QuicVarintAppend(b, int64(rndBelow(64)))
            r = r + 1
        if ecn:
            quicvarint.QuicVarintAppend(b, largest + 1)
            quicvarint.QuicVarintAppend(b, largest + 2)
            quicvarint.QuicVarintAppend(b, largest + 3)
        if ecn:
            expType[i] = quicframe.QuicFrameAckEcn
        else:
            expType[i] = quicframe.QuicFrameAck
        expV0[i] = largest
        expV1[i] = delay
        expV2[i] = ranges
        expV3[i] = firstR
        return 0
    if kind == 3:
        let off: int64 = rndValue() % 100000
        let plen: int32 = rndBelow(48)
        genRandomPayload(gPool, poolOff, plen)
        BytesBuilderAppendByte(b, 0x06)
        quicvarint.QuicVarintAppend(b, off)
        quicvarint.QuicVarintAppend(b, int64(plen))
        let view: Bytes = BytesSliceView(gPool, poolOff, plen)
        BytesBuilderAppend(b, view)
        expType[i] = quicframe.QuicFrameCrypto
        expV0[i] = off
        expV1[i] = int64(plen)
        expDataLen[i] = plen
        return plen
    if kind == 4:
        # STREAM: random OFF/LEN/FIN bits; a frame without the LEN bit must be
        # the final frame (Stream Data runs to end of packet).
        let hasOff: bool = (rndBelow(2) == 0)
        let hasLen: bool = !isLast || (rndBelow(4) != 0)
        let fin: bool = (rndBelow(2) == 0)
        let sid: int64 = rndValue() % 1000
        let off: int64 = rndValue() % 100000
        let plen: int32 = rndBelow(48)
        genRandomPayload(gPool, poolOff, plen)
        var t: int32 = 0x08
        if fin:
            t = t | 0x01
        if hasLen:
            t = t | 0x02
        if hasOff:
            t = t | 0x04
        BytesBuilderAppendByte(b, t)
        quicvarint.QuicVarintAppend(b, sid)
        if hasOff:
            quicvarint.QuicVarintAppend(b, off)
        if hasLen:
            quicvarint.QuicVarintAppend(b, int64(plen))
        let view: Bytes = BytesSliceView(gPool, poolOff, plen)
        BytesBuilderAppend(b, view)
        expType[i] = t
        expV0[i] = sid
        expV1[i] = off
        expV2[i] = int64(plen)
        expDataLen[i] = plen
        return plen
    if kind == 5:
        let m: int64 = rndValue()
        BytesBuilderAppendByte(b, 0x10)
        quicvarint.QuicVarintAppend(b, m)
        expType[i] = quicframe.QuicFrameMaxData
        expV0[i] = m
        return 0
    if kind == 6:
        let sid: int64 = rndValue() % 1000
        let m: int64 = rndValue()
        BytesBuilderAppendByte(b, 0x11)
        quicvarint.QuicVarintAppend(b, sid)
        quicvarint.QuicVarintAppend(b, m)
        expType[i] = quicframe.QuicFrameMaxStreamData
        expV0[i] = sid
        expV1[i] = m
        return 0
    if kind == 7:
        let uni: bool = (rndBelow(2) == 0)
        let m: int64 = rndValue()
        if uni:
            BytesBuilderAppendByte(b, 0x13)
        else:
            BytesBuilderAppendByte(b, 0x12)
        quicvarint.QuicVarintAppend(b, m)
        if uni:
            expType[i] = quicframe.QuicFrameMaxStreamsUni
        else:
            expType[i] = quicframe.QuicFrameMaxStreamsBidi
        expV0[i] = m
        return 0
    if kind == 8:
        let seq: int64 = int64(rndBelow(1000))
        let retire: int64 = int64(rndBelow(1000)) % (seq + 1)
        let clen: int32 = 1 + rndBelow(quicframe.QuicCidMaxLen)
        genRandomPayload(gPool, poolOff, clen)
        genRandomPayload(gPool, poolOff + 48, 16)
        BytesBuilderAppendByte(b, 0x18)
        quicvarint.QuicVarintAppend(b, seq)
        quicvarint.QuicVarintAppend(b, retire)
        BytesBuilderAppendByte(b, clen)
        let cidView: Bytes = BytesSliceView(gPool, poolOff, clen)
        BytesBuilderAppend(b, cidView)
        let tokView: Bytes = BytesSliceView(gPool, poolOff + 48, 16)
        BytesBuilderAppend(b, tokView)
        expType[i] = quicframe.QuicFrameNewConnectionId
        expV0[i] = seq
        expV1[i] = retire
        expV2[i] = int64(clen)
        return 0
    if kind == 9:
        let ec: int64 = rndValue() % 100
        let cft: int64 = rndValue() % 100
        let rlen: int32 = rndBelow(32)
        genRandomPayload(gPool, poolOff, rlen)
        BytesBuilderAppendByte(b, 0x1c)
        quicvarint.QuicVarintAppend(b, ec)
        quicvarint.QuicVarintAppend(b, cft)
        quicvarint.QuicVarintAppend(b, int64(rlen))
        let view: Bytes = BytesSliceView(gPool, poolOff, rlen)
        BytesBuilderAppend(b, view)
        expType[i] = quicframe.QuicFrameConnectionClose
        expV0[i] = ec
        expV1[i] = cft
        expV2[i] = int64(rlen)
        expDataLen[i] = rlen
        return rlen
    let ec: int64 = rndValue() % 100
    let rlen: int32 = rndBelow(32)
    genRandomPayload(gPool, poolOff, rlen)
    BytesBuilderAppendByte(b, 0x1d)
    quicvarint.QuicVarintAppend(b, ec)
    quicvarint.QuicVarintAppend(b, int64(rlen))
    let view: Bytes = BytesSliceView(gPool, poolOff, rlen)
    BytesBuilderAppend(b, view)
    expType[i] = quicframe.QuicFrameConnectionCloseApp
    expV0[i] = ec
    expV2[i] = int64(rlen)
    expDataLen[i] = rlen
    return rlen

@borrows
fn verifyDecoded(tag: str, f: quicframe.QuicFrame, i: int32): bool =
    if f.ftype != expType[i]:
        fail2(tag, strings.concatStr("frame type at idx ", strings.IntToStr(i)))
        return false
    let t: int32 = expType[i]
    if t == quicframe.QuicFrameAck || t == quicframe.QuicFrameAckEcn:
        if f.largestAck != expV0[i] || f.ackDelay != expV1[i] || f.ackRangeCount != expV2[i] || f.firstAckRange != expV3[i]:
            fail2(tag, strings.concatStr("ack fields at idx ", strings.IntToStr(i)))
            return false
        if t == quicframe.QuicFrameAckEcn:
            if f.ect0 != expV0[i] + 1 || f.ect1 != expV0[i] + 2 || f.ceCount != expV0[i] + 3:
                fail2(tag, strings.concatStr("ecn counts at idx ", strings.IntToStr(i)))
                return false
        return true
    if t == quicframe.QuicFrameCrypto:
        if f.offset != expV0[i] || f.length != expV1[i] || f.dataLen != expDataLen[i]:
            fail2(tag, strings.concatStr("crypto fields at idx ", strings.IntToStr(i)))
            return false
        return true
    if t >= 0x08 && t <= 0x0f:
        let wantOff: bool = (t & 0x04) != 0
        let wantLen: bool = (t & 0x02) != 0
        let wantFin: bool = (t & 0x01) != 0
        if f.hasOffset != wantOff || f.hasLength != wantLen || f.fin != wantFin:
            fail2(tag, strings.concatStr("stream bits at idx ", strings.IntToStr(i)))
            return false
        if f.streamId != expV0[i]:
            fail2(tag, strings.concatStr("stream id at idx ", strings.IntToStr(i)))
            return false
        if wantOff && f.offset != expV1[i]:
            fail2(tag, strings.concatStr("stream offset at idx ", strings.IntToStr(i)))
            return false
        if wantLen && (f.length != expV2[i] || f.dataLen != expDataLen[i]):
            fail2(tag, strings.concatStr("stream length at idx ", strings.IntToStr(i)))
            return false
        return true
    if t == quicframe.QuicFrameMaxData || t == quicframe.QuicFrameMaxStreamsBidi || t == quicframe.QuicFrameMaxStreamsUni:
        if f.maximum != expV0[i]:
            fail2(tag, strings.concatStr("maximum at idx ", strings.IntToStr(i)))
            return false
        return true
    if t == quicframe.QuicFrameMaxStreamData:
        if f.streamId != expV0[i] || f.maximum != expV1[i]:
            fail2(tag, strings.concatStr("max stream data at idx ", strings.IntToStr(i)))
            return false
        return true
    if t == quicframe.QuicFrameNewConnectionId:
        if f.seqNum != expV0[i] || f.retirePriorTo != expV1[i] || f.cidLen != int32(expV2[i]):
            fail2(tag, strings.concatStr("ncid fields at idx ", strings.IntToStr(i)))
            return false
        return true
    if t == quicframe.QuicFrameConnectionClose || t == quicframe.QuicFrameConnectionCloseApp:
        if f.errorCode != expV0[i]:
            fail2(tag, strings.concatStr("close code at idx ", strings.IntToStr(i)))
            return false
        if t == quicframe.QuicFrameConnectionClose && f.closeFrameType != expV1[i]:
            fail2(tag, strings.concatStr("close frame type at idx ", strings.IntToStr(i)))
            return false
        if f.reasonLen != int32(expV2[i]) || f.dataLen != expDataLen[i]:
            fail2(tag, strings.concatStr("close reason at idx ", strings.IntToStr(i)))
            return false
        return true
    return true

@borrows
fn roundTripOnce(tag: str, nframes: int32): bool =
    var b1: BytesBuilder = BytesBuilderNew(256)
    var poolOff: int32
    var i: int32
    while i < nframes:
        let used: int32 = genOneFrame(b1, poolOff, i, i == nframes - 1)
        poolOff = poolOff + used + 64
        i = i + 1
    let buf: Bytes = BytesBuilderFinish(b1)
    var b2: BytesBuilder = BytesBuilderNew(256)
    var pos: int32
    var idx: int32
    var f: quicframe.QuicFrame = quicframe.QuicFrameZero()
    while pos < buf.len:
        let next: int32 = quicframe.QuicFrameDecodeAt(buf, pos, f)
        if next < 0:
            fail2(tag, strings.concatStr("decode err ", strings.IntToStr(next)))
            BytesBuilderFree(b2)
            return false
        if idx >= nframes:
            fail2(tag, "decoded more frames than generated")
            BytesBuilderFree(b2)
            return false
        if !verifyDecoded(tag, f, idx):
            BytesBuilderFree(b2)
            return false
        let wr: int32 = quicframe.QuicFrameAppend(b2, buf, f)
        if wr < 0:
            fail2(tag, strings.concatStr("append err ", strings.IntToStr(wr)))
            BytesBuilderFree(b2)
            return false
        pos = next
        idx = idx + 1
    if idx != nframes:
        fail2(tag, strings.concatStr("frame count ", strings.IntToStr(idx)))
        BytesBuilderFree(b2)
        return false
    let buf2: Bytes = BytesBuilderFinish(b2)
    if !BytesEqual(buf, buf2):
        fail2(tag, strings.concatStr("byte identity: ", strings.IntToStr(buf.len)))
        return false
    return true

fn main(): int32 =
    gRng = 0x243f6a8885a308d3
    gPool = BytesAlloc(8192)

    # (a) RFC 9001 A.2 client Initial payload: CRYPTO(0,241) + PADDING to 1162
    let a2ok: bool = parseSamplePayload("a2_client_payload", "", 241, 917, false, "")
    # (a) RFC 9001 A.3 server Initial payload: ACK + CRYPTO(0,90)
    let a3ok: bool = parseSamplePayload("a3_server_payload", "0600405a020000560303eefce7f7b37ba1d1632e96677825ddf73988cfc79825df566dc5430b9a045a1200130100002e00330024001d00209d3c940d89690b84d08a60993c144eca684d1081287c834d5311bcf32bb9da1a002b00020304", 90, 0, true, "0200000000")
    if !a2ok || !a3ok:
        gFails = gFails + 1

    setLen(expType, MaxFramesPerRound)
    setLen(expV0, MaxFramesPerRound)
    setLen(expV1, MaxFramesPerRound)
    setLen(expV2, MaxFramesPerRound)
    setLen(expV3, MaxFramesPerRound)
    setLen(expDataLen, MaxFramesPerRound)

    # (b) round-trips: 12 fixed + 64 randomized, all frames, all 11 kinds
    var rtOk: int32
    var r: int32
    while r < 76:
        let n: int32 = 2 + rndBelow(MaxFramesPerRound - 1)
        if roundTripOnce(strings.concatStr("rt_round_", strings.IntToStr(r)), n):
            rtOk = rtOk + 1
        r = r + 1
    pass2("round_trips", strings.concatStr(strings.IntToStr(rtOk),
        strings.concatStr("/", strings.IntToStr(r))))
    if gKindMask != 0x7ff:
        fail2("kind_coverage", strings.concatStr("mask=", strings.IntToStr(gKindMask)))
    else:
        pass2("kind_coverage", "all 11 frame kinds exercised")

    # (c) negatives: exact error codes
    var f: quicframe.QuicFrame = quicframe.QuicFrameZero()
    let e1: int32 = quicframe.QuicFrameDecodeAt(EmptyBytes(), 0, f)
    if e1 != -1:
        fail2("neg_1_empty", strings.IntToStr(e1))
    let e2: int32 = quicframe.QuicFrameDecodeAt(BytesFromHex("06004010aabb"), 0, f)
    if e2 != -5:
        fail2("neg_2_crypto_overrun", strings.IntToStr(e2))
    let e3: int32 = quicframe.QuicFrameDecodeAt(BytesFromHex("0a004010aabb"), 0, f)
    if e3 != -5:
        fail2("neg_3_stream_overrun", strings.IntToStr(e3))
    let e4: int32 = quicframe.QuicFrameDecodeAt(BytesFromHex("2a00"), 0, f)
    if e4 != -2:
        fail2("neg_4_unknown_type", strings.IntToStr(e4))
    let e5: int32 = quicframe.QuicFrameDecodeAt(BytesFromHex("4025"), 0, f)
    if e5 != -3:
        fail2("neg_5_nonminimal_type", strings.IntToStr(e5))
    let e6: int32 = quicframe.QuicFrameDecodeAt(BytesFromHex("180000151111111111111111111111111111111111111111111111111111"), 0, f)
    if e6 != -4:
        fail2("neg_6_ncid_len21", strings.IntToStr(e6))
    let e7: int32 = quicframe.QuicFrameDecodeAt(BytesFromHex("18000000aabb00112233445566778899aabbccddeeff"), 0, f)
    if e7 != -4:
        fail2("neg_7_ncid_len0", strings.IntToStr(e7))
    let e8: int32 = quicframe.QuicFrameDecodeAt(BytesFromHex("1805070400112233445566778899aabbccddeeff00112233"), 0, f)
    if e8 != -5:
        fail2("neg_8_ncid_retire_gt_seq", strings.IntToStr(e8))
    let e9: int32 = quicframe.QuicFrameDecodeAt(BytesFromHex("0200000100"), 0, f)
    if e9 != -1:
        fail2("neg_9_ack_pair_truncated", strings.IntToStr(e9))
    let e10: int32 = quicframe.QuicFrameDecodeAt(BytesFromHex("020000020001"), 0, f)
    if e10 != -1:
        fail2("neg_10_ack_ranges_truncated", strings.IntToStr(e10))
    let e11: int32 = quicframe.QuicFrameDecodeAt(BytesFromHex("1c000205626264"), 0, f)
    if e11 != -5:
        fail2("neg_11_close_reason_overrun", strings.IntToStr(e11))
    let e12: int32 = quicframe.QuicFrameDecodeAt(BytesFromHex("18010004112233445566778899"), 0, f)
    if e12 != -1:
        fail2("neg_12_ncid_token_truncated", strings.IntToStr(e12))
    pass2("negatives", "12 frame-level negatives rejected with exact codes")

    if gFails != 0:
        os.WriteLine(os.Get_stdout(), strings.concatStr("W3A-FRAMES RESULT: FAIL count=",
            strings.IntToStr(gFails)))
        return 1
    os.WriteLine(os.Get_stdout(), "W3A-FRAMES RESULT: PASS")
    return 0
