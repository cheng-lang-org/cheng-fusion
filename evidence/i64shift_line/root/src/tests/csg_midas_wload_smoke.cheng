# MidasNet 权重装载冒烟: .midasw MDW1 二进制读取器 (Cheng 实现)。
# 真值: python struct 解析 pretrained.layer1.0.weight 的 864 定点值哈希
# d176f58667ccc465e14d4a48202464bc1cdb49b528b56b481fe5a7f390bcf95f (逗号串)。
# 用法: csg_midas_wload_smoke <midasw路径>
import std/cmdline
import std/strings
import std/crypto/sha256
import std/rawbytes
import cheng/game/assets/import/reader

fn main(): int32 =
    let argc = cmdline.paramCount()
    if argc < 1:
        echo("usage: csg_midas_wload_smoke <midasw路径>")
        return 2
    let path = Fmt"{cmdline.paramStr(1)}"
    var bounds = reader.AssetReaderBoundsFor("mp4")
    var data = rawbytes.EmptyBytes()
    if !reader.AssetReaderLoadBounded(path, bounds, data):
        echo("load failed")
        return 1
    let total = rawbytes.BytesLen(data)
    if total < 8:
        echo("too small")
        return 1
    var magic0 = rawbytes.BytesGet(data, 0)
    var magic1 = rawbytes.BytesGet(data, 1)
    var magic2 = rawbytes.BytesGet(data, 2)
    var magic3 = rawbytes.BytesGet(data, 3)
    if magic0 != 77 or magic1 != 68 or magic2 != 87 or magic3 != 49:
        echo("bad magic")
        return 1
    var cnt: int64
    if !reader.AssetReaderU32At(data, 4, cnt):
        echo("cnt read fail")
        return 1
    echo(Fmt"magic=MDW1 entries={cnt}")
    if cnt != 482:
        echo("entry count mismatch")
        return 1

    var off: int32 = 8
    var lastName: str = ""
    var w864HashIn: str = ""
    var found: int32 = 0
    var idx: int32 = 0
    while idx < cnt:
        var nl: int64
        if !reader.AssetReaderU32At(data, off, nl):
            echo("nl fail")
            return 1
        off = off + 4
        if nl <= 0 or nl > 300:
            echo(Fmt"garbage nameLen={nl} at idx={idx}")
            return 1
        var name: str = ""
        var ci: int32
        ci = 0
        while ci < int32(nl):
            name = name + rawbytes.BytesToString(rawbytes.BytesSliceView(data, off + ci, 1))
            ci = ci + 1
        off = off + int32(nl)
        var nd: int64
        if !reader.AssetReaderU32At(data, off, nd):
            return 1
        off = off + 4
        off = off + int32(nd) * 4
        var sc: int64
        if !reader.AssetReaderU32At(data, off, sc):
            return 1
        off = off + 4
        var n: int64
        if !reader.AssetReaderU32At(data, off, n):
            return 1
        off = off + 4
        if name == "pretrained.layer1.0.weight":
            var di: int32
            di = 0
            while di < int32(n):
                var v: int64
                if !reader.AssetReaderU32At(data, off + di * 4, v):
                    return 1
                if di > 0:
                    w864HashIn = w864HashIn + ","
                w864HashIn = w864HashIn + strings.IntToStr(int32(v))
                di = di + 1
            found = 1
        off = off + int32(n) * 4
        idx = idx + 1
    if found == 0:
        echo("layer1.0.weight not found")
        return 1
    let got: str = strings.Sha256(w864HashIn)
    echo(Fmt"w864 sha256={got}")
    if got == "d176f58667ccc465e14d4a48202464bc1cdb49b528b56b481fe5a7f390bcf95f":
        echo("csg_midas_wload_smoke PASS")
        return 0
    echo("sha mismatch")
    return 1
