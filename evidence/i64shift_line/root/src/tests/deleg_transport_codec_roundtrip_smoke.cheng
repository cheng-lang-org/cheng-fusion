# libp2p P3 收尾片: 委托 head 网络分发动词 (DELEG_REQ/DELEG_RESP) 线格式往返 + 畸形硬拒 (正典 §11.6 P3)。
# 自足 exe (无网络无状态), 断言失败即 abort 非零, 末行 "ok" 才打印。照 revoke_transport_codec 模式。
# 覆盖: REQ 往返 (33B/tag 0x23); RESP found 往返 (171B/tag 0x24/status 1); RESP miss (2B/status 0);
#       畸形穷举 (REQ 长/tag; RESP 截断/tag/status 非法/found 帧长/miss 尾残/cert wire 非 169) 一律拒。

import std/system
import std/result
import std/rawbytes as rawbytes
import cheng/std/bytes_layout as layout
import cheng/libp2p/protocols/cas_source/channel_head/deleg_transport_codec as dt

fn mkCid(seed: int32): layout.FixedBytes32 =
    var b = BytesAlloc(32)
    for i in 0..<32:
        BytesSet(b, i, (seed * 17 + i + 3) & 255)
    let r = layout.FixedBytes32FromBytes(b)
    assert(!IsErr(r), " mkCid 32B")
    return Value(r)

fn mkWire169(seed: int32): Bytes =
    var b = BytesAlloc(169)
    for i in 0..<169:
        BytesSet(b, i, (seed * 7 + i) & 255)
    BytesSet(b, 0, 0x40)   # 委托 cert 记录 tag
    return b

fn main(): int32 =
    # ---- DELEG_REQ 往返 ----
    let cid = mkCid(13)
    var reqWire = dt.DelegReqEncode(cid)
    assert(BytesLen(reqWire) == 33, " REQ wire = 33B")
    assert(BytesGet(reqWire, 0) == 0x23, " REQ tag 0x23")
    var reqDecRes = dt.DelegReqDecode(reqWire)
    assert(!IsErr(reqDecRes), " REQ decode ok: " + Error(reqDecRes))
    var reqDec = Value(reqDecRes)
    assert(layout.FixedBytes32Equal(reqDec.channelId, cid), " REQ 往返 channelId 精确")

    # REQ 畸形: 长度错 / tag 错
    assert(IsErr(dt.DelegReqDecode(BytesSlice(reqWire, 0, 32))), " REQ 畸形: 32B 截断拒")
    var reqBadTag = BytesAlloc(33)
    for i in 0..<33:
        BytesSet(reqBadTag, i, BytesGet(reqWire, i))
    BytesSet(reqBadTag, 0, 0x21)   # 冒充 REVOKE_REQ tag
    assert(IsErr(dt.DelegReqDecode(reqBadTag)), " REQ 畸形: tag 非 0x23 拒")
    # 隔离对照: tag 恢复 0x23 → decode 应过 (只有 tag 变量触发拒绝)
    BytesSet(reqBadTag, 0, 0x23)
    assert(!IsErr(dt.DelegReqDecode(reqBadTag)), " 对照: tag 恢复 0x23 → decode 过")

    # ---- DELEG_RESP found 往返 ----
    var cw = mkWire169(23)
    var respFoundRes = dt.DelegRespEncodeFound(cw)
    assert(!IsErr(respFoundRes), " RESP found encode: " + Error(respFoundRes))
    var respFound = Value(respFoundRes)
    assert(BytesLen(respFound) == 171, " RESP found = 171B")
    assert(BytesGet(respFound, 0) == 0x24, " RESP tag 0x24")
    assert(BytesGet(respFound, 1) == 1, " RESP status 1 (found)")
    var rfDecRes = dt.DelegRespDecode(respFound)
    assert(!IsErr(rfDecRes), " RESP found decode: " + Error(rfDecRes))
    var rfDec = Value(rfDecRes)
    assert(rfDec.found, " RESP found decode.found == true")
    assert(rawbytes.BytesEqual(rfDec.recordWire, cw), " RESP found 往返 cert wire 精确")

    # RESP found encode 拒非 169B cert wire
    assert(IsErr(dt.DelegRespEncodeFound(BytesAlloc(168))), " RESP found encode 拒 168B cert wire")

    # ---- DELEG_RESP miss 往返 ----
    var respMiss = dt.DelegRespEncodeMiss()
    assert(BytesLen(respMiss) == 2, " RESP miss = 2B")
    assert(BytesGet(respMiss, 1) == 0, " RESP miss status 0")
    var rmDecRes = dt.DelegRespDecode(respMiss)
    assert(!IsErr(rmDecRes), " RESP miss decode")
    assert(!Value(rmDecRes).found, " RESP miss decode.found == false")

    # ---- RESP 畸形穷举 ----
    assert(IsErr(dt.DelegRespDecode(BytesAlloc(1))), " RESP 畸形: 1B header 截断拒")
    var respBadTag = BytesAlloc(2)
    BytesSet(respBadTag, 0, 0x99)
    assert(IsErr(dt.DelegRespDecode(respBadTag)), " RESP 畸形: tag 非 0x24 拒")
    var respBadStatus = BytesAlloc(2)
    BytesSet(respBadStatus, 0, 0x24)
    BytesSet(respBadStatus, 1, 0x05)   # status 非 0/1
    assert(IsErr(dt.DelegRespDecode(respBadStatus)), " RESP 畸形: status 非 0/1 拒")
    # found 但帧长非 171 (status=1, 只给 10 字节)
    var respShort = BytesAlloc(10)
    BytesSet(respShort, 0, 0x24)
    BytesSet(respShort, 1, 0x01)
    assert(IsErr(dt.DelegRespDecode(respShort)), " RESP 畸形: found 帧长非 171 拒")
    # miss 但帧长非 2 (status=0, 给 5 字节尾残)
    var respMissLong = BytesAlloc(5)
    BytesSet(respMissLong, 0, 0x24)
    BytesSet(respMissLong, 1, 0x00)
    assert(IsErr(dt.DelegRespDecode(respMissLong)), " RESP 畸形: miss 帧长非 2 拒 (尾残)")

    echo(" deleg_transport_codec_roundtrip_smoke ok")
    return 0
