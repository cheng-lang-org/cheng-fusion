@ffi_owned_result(free = SabiFree)
@importc("SabiDupCString")
fn rawStrdup(text: cstring): owned_cstring

fn main(): int32 =
    var acc: int32 = 0
    for i in 0..<80000:
        let s: str = rawStrdup("owned-probe-payload-padding-48-bytes-aaaaaaaaaaaaaaaa")
        acc = acc + len(s)
    if acc <= 0: return 2
    return 0
