import std/seqs

fn coldOpenGenericSequenceAuthority[T](items: var T[]): int32 =
    return items.len

fn coldOpenGenericTypedescAuthority[T](t: typedesc[T]): int32 =
    t
    return 0

fn main(): int32 =
    var items: int32[]
    if coldOpenGenericSequenceAuthority[int32](items) != 0:
        return 31
    return 0
