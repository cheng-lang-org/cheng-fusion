import std/crypto/bigint as bigint
import std/system
import std/strutils as strutil

# Dirty a wide stack region with 0xFFFFFFFF so any uninitialized read is visible.
fn dirtyStack(seed: int32): int32 =
    var buf: int32[300]
    var i: int32
    while i < 300:
        buf[i] = 0 - 1            # 0xFFFFFFFF
        i = i + 1
    var s: int32
    var j: int32
    while j < 300:
        s = s + buf[(j + seed) % 300]
        j = j + 1
    return s

fn main(): int32 =
    var acc: int32
    var round: int32
    var litHits: int32          # struct-literal path
    var declHits: int32         # bare `var x: Struct` (no initializer) path
    var countHits: int32        # count field nonzero on bare decl
    while round < 1000:
        acc = acc + dirtyStack(round)
        # (A) struct literal
        let b: bigint.BigInt = bigint.BigInt(count: 0)
        var k: int32
        while k < 256:
            if b.limbs[k] != 0:
                litHits = litHits + 1
            k = k + 1
        # (B) bare declaration, NO initializer — the pattern handshake uses (`var out: EcPointFixed`)
        var b2: bigint.BigInt
        if b2.count != 0:
            countHits = countHits + 1
        var k2: int32
        while k2 < 256:
            if b2.limbs[k2] != 0:
                declHits = declHits + 1
            k2 = k2 + 1
        round = round + 1
    echo(strutil.Join(["litHits=", IntToStr(litHits), " declHits=", IntToStr(declHits), " countHits=", IntToStr(countHits), " acc=", IntToStr(acc & 0xFF)], ""))
    return 0
