import std/os
import std/rawbytes
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/lang/parser
import cheng/core/tooling/compiler_world
import cheng/core/tooling/semantic_snapshot_declaration_identity as declaration

fn TestCid(label: str): layout.FixedBytes32 =
    var bytes = layout.ByteBufInit(label.len)
    for index in 0..<label.len:
        layout.ByteBufAppendByte(bytes, Int32(label[index]) & 255)
    let out = hash256.Sha256Fixed(layout.ByteBufView(bytes))
    layout.ByteBufFree(bytes)
    return out

fn DocumentCid(packageId: str,
               modulePath: str): layout.FixedBytes32 =
    var out: layout.FixedBytes32
    var err: str
    assert(compiler_world.CompilerWorldDocumentCidInto(
               packageId, modulePath, out, err), err)
    return out

# Test producer evidence is opaque to the declaration table.  The positive
# backtick fixture below separately proves that the current parser accepted
# the exact source before this content-bound evidence enters the table.
fn ParserValidatedNameProofCid(
        kind: int32,
        nameSurfaceKind: int32,
        name: str): layout.FixedBytes32 =
    var bytes = layout.ByteBufInit(96 + name.len)
    let domain = "test.parser_validated_declaration_name"
    for index in 0..<domain.len:
        layout.ByteBufAppendByte(bytes, Int32(domain[index]) & 255)
    layout.ByteBufAppendByte(bytes, (kind >> 24) & 255)
    layout.ByteBufAppendByte(bytes, (kind >> 16) & 255)
    layout.ByteBufAppendByte(bytes, (kind >> 8) & 255)
    layout.ByteBufAppendByte(bytes, kind & 255)
    layout.ByteBufAppendByte(bytes, (nameSurfaceKind >> 24) & 255)
    layout.ByteBufAppendByte(bytes, (nameSurfaceKind >> 16) & 255)
    layout.ByteBufAppendByte(bytes, (nameSurfaceKind >> 8) & 255)
    layout.ByteBufAppendByte(bytes, nameSurfaceKind & 255)
    for index in 0..<name.len:
        layout.ByteBufAppendByte(bytes, Int32(name[index]) & 255)
    let out = hash256.Sha256Fixed(layout.ByteBufView(bytes))
    layout.ByteBufFree(bytes)
    return out

fn CheckParserBacktickParenthesesAuthority() =
    var tree: parser.ParserValueExprTree
    var err: str
    assert(parser.ParserValueExprReadTreeFromText(
               "fn `()`() = return", tree, err), err)
    parser.ParserValueExprTreeRelease(tree)

fn AppendDeclaration(
        store: var declaration.SemanticSnapshotDeclarationCandidateStore,
        packageId: str,
        modulePath: str,
        documentCid: layout.FixedBytes32,
        ownerCandidateIndex: int32,
        kind: int32,
        nameSurfaceKind: int32,
        name: str,
        signatureTypeExpressionCid: layout.FixedBytes32,
        scopeCid: layout.FixedBytes32,
        startByte: int32,
        endByte: int32): int32 =
    var out: int32
    var err: str
    assert(declaration.SemanticSnapshotDeclarationCandidateAppendInto(
               store, packageId, modulePath, documentCid, "",
               ownerCandidateIndex, kind, nameSurfaceKind, name,
               ParserValidatedNameProofCid(kind, nameSurfaceKind, name),
               signatureTypeExpressionCid, scopeCid,
               startByte, endByte, out, err), err)
    return out

fn AppendIdentifier(
        store: var declaration.SemanticSnapshotDeclarationCandidateStore,
        packageId: str,
        modulePath: str,
        documentCid: layout.FixedBytes32,
        ownerCandidateIndex: int32,
        kind: int32,
        name: str,
        signatureTypeExpressionCid: layout.FixedBytes32,
        scopeCid: layout.FixedBytes32,
        startByte: int32,
        endByte: int32): int32 =
    if kind == declaration.SemanticSnapshotDeclarationKindModule:
        var out: int32
        var err: str
        assert(declaration.SemanticSnapshotDeclarationCandidateAppendInto(
                   store, packageId, modulePath, documentCid, "",
                   ownerCandidateIndex, kind,
                   declaration.SemanticSnapshotDeclarationNameSurfaceModulePath,
                   modulePath, documentCid, documentCid, scopeCid,
                   startByte, endByte, out, err), err)
        return out
    return AppendDeclaration(
        store, packageId, modulePath, documentCid,
        ownerCandidateIndex, kind,
        declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
        name, signatureTypeExpressionCid, scopeCid,
        startByte, endByte)

fn BuildReferenceInto(
        orderVariant: int32,
        spanDelta: int32,
        proofVariant: int32,
        storeOut: var declaration.SemanticSnapshotDeclarationCandidateStore,
        tableOut: var declaration.SemanticSnapshotDeclarationTable,
        receiptOut: var declaration.SemanticSnapshotDeclarationMappingReceipt) =
    let documentA = DocumentCid("pkg", "pkg/a")
    let documentB = DocumentCid("pkg", "pkg/b")
    let moduleAType = TestCid("module-signature:pkg/a")
    let moduleBType = TestCid("module-signature:pkg/b")
    let widgetType = TestCid(
        "type-expression:object(value:int32):without-self-declkey-or-typeid")
    let intType = TestCid("type-expression:scalar:int32")
    let signatureA = TestCid("signature-type-expression:fn(int32):int32")
    let signatureB = TestCid("signature-type-expression:fn(uint32):int32")
    let operatorSignature = TestCid("signature-type-expression:fn():int32")
    let scopeA = TestCid("lexical-scope:pkg/a.Compute/body")
    var store: declaration.SemanticSnapshotDeclarationCandidateStore
    declaration.SemanticSnapshotDeclarationCandidateStoreInitInto(store)
    if orderVariant == 0:
        let moduleA = AppendIdentifier(
            store, "pkg", "pkg/a", documentA, -1,
            declaration.SemanticSnapshotDeclarationKindModule,
            "a", moduleAType, layout.FixedBytes32(),
            0 + spanDelta, 9 + spanDelta)
        let widget = AppendIdentifier(
            store, "pkg", "pkg/a", documentA, moduleA,
            declaration.SemanticSnapshotDeclarationKindType,
            "Widget", widgetType, layout.FixedBytes32(),
            10 + spanDelta, 20 + spanDelta)
        AppendIdentifier(
            store, "pkg", "pkg/a", documentA, widget,
            declaration.SemanticSnapshotDeclarationKindField,
            "value", intType, layout.FixedBytes32(),
            12 + spanDelta, 17 + spanDelta)
        let computeA = AppendIdentifier(
            store, "pkg", "pkg/a", documentA, moduleA,
            declaration.SemanticSnapshotDeclarationKindFunction,
            "Compute", signatureA, layout.FixedBytes32(),
            30 + spanDelta, 55 + spanDelta)
        AppendIdentifier(
            store, "pkg", "pkg/a", documentA, computeA,
            declaration.SemanticSnapshotDeclarationKindLocal,
            "tmp", intType, scopeA,
            40 + spanDelta, 43 + spanDelta)
        AppendIdentifier(
            store, "pkg", "pkg/a", documentA, moduleA,
            declaration.SemanticSnapshotDeclarationKindFunction,
            "Compute", signatureB, layout.FixedBytes32(),
            60 + spanDelta, 85 + spanDelta)
        AppendDeclaration(
            store, "pkg", "pkg/a", documentA, moduleA,
            declaration.SemanticSnapshotDeclarationKindFunction,
            declaration.SemanticSnapshotDeclarationNameSurfaceBacktickOperator,
            "()", operatorSignature, layout.FixedBytes32(),
            86 + spanDelta, 99 + spanDelta)
        let moduleB = AppendIdentifier(
            store, "pkg", "pkg/b", documentB, -1,
            declaration.SemanticSnapshotDeclarationKindModule,
            "b", moduleBType, layout.FixedBytes32(),
            0 + spanDelta, 9 + spanDelta)
        AppendIdentifier(
            store, "pkg", "pkg/b", documentB, moduleB,
            declaration.SemanticSnapshotDeclarationKindFunction,
            "Compute", signatureA, layout.FixedBytes32(),
            10 + spanDelta, 35 + spanDelta)
    else:
        let moduleB = AppendIdentifier(
            store, "pkg", "pkg/b", documentB, -1,
            declaration.SemanticSnapshotDeclarationKindModule,
            "b", moduleBType, layout.FixedBytes32(),
            0 + spanDelta, 9 + spanDelta)
        AppendIdentifier(
            store, "pkg", "pkg/b", documentB, moduleB,
            declaration.SemanticSnapshotDeclarationKindFunction,
            "Compute", signatureA, layout.FixedBytes32(),
            10 + spanDelta, 35 + spanDelta)
        let moduleA = AppendIdentifier(
            store, "pkg", "pkg/a", documentA, -1,
            declaration.SemanticSnapshotDeclarationKindModule,
            "a", moduleAType, layout.FixedBytes32(),
            0 + spanDelta, 9 + spanDelta)
        AppendDeclaration(
            store, "pkg", "pkg/a", documentA, moduleA,
            declaration.SemanticSnapshotDeclarationKindFunction,
            declaration.SemanticSnapshotDeclarationNameSurfaceBacktickOperator,
            "()", operatorSignature, layout.FixedBytes32(),
            86 + spanDelta, 99 + spanDelta)
        AppendIdentifier(
            store, "pkg", "pkg/a", documentA, moduleA,
            declaration.SemanticSnapshotDeclarationKindFunction,
            "Compute", signatureB, layout.FixedBytes32(),
            60 + spanDelta, 85 + spanDelta)
        let computeA = AppendIdentifier(
            store, "pkg", "pkg/a", documentA, moduleA,
            declaration.SemanticSnapshotDeclarationKindFunction,
            "Compute", signatureA, layout.FixedBytes32(),
            30 + spanDelta, 55 + spanDelta)
        AppendIdentifier(
            store, "pkg", "pkg/a", documentA, computeA,
            declaration.SemanticSnapshotDeclarationKindLocal,
            "tmp", intType, scopeA,
            40 + spanDelta, 43 + spanDelta)
        let widget = AppendIdentifier(
            store, "pkg", "pkg/a", documentA, moduleA,
            declaration.SemanticSnapshotDeclarationKindType,
            "Widget", widgetType, layout.FixedBytes32(),
            10 + spanDelta, 20 + spanDelta)
        AppendIdentifier(
            store, "pkg", "pkg/a", documentA, widget,
            declaration.SemanticSnapshotDeclarationKindField,
            "value", intType, layout.FixedBytes32(),
            12 + spanDelta, 17 + spanDelta)
    if proofVariant != 0:
        var proofRow: int32 = -1
        for row in 0..<store.declarationKinds.len:
            if proofRow < 0 && store.declarationKinds[row] ==
                   declaration.SemanticSnapshotDeclarationKindFunction:
                proofRow = row
        assert(proofRow >= 0,
               " declaration identity smoke: proof variant function missing")
        store.parserValidatedNameProofCids[proofRow] =
            TestCid("parser-receipt-variant:proof-only")
    var table: declaration.SemanticSnapshotDeclarationTable
    var receipt: declaration.SemanticSnapshotDeclarationMappingReceipt
    var err: str
    assert(declaration.SemanticSnapshotDeclarationTableSealInto(
               store, table, receipt, err), err)
    assert(declaration.SemanticSnapshotDeclarationTableStrictValidateInto(
               table, err), err)
    assert(declaration.SemanticSnapshotDeclarationMappingReceiptStrictValidateInto(
               store, table, receipt, err), err)
    storeOut = store
    tableOut = table
    receiptOut = receipt

fn FindRow(
        table: declaration.SemanticSnapshotDeclarationTable,
        documentCid: layout.FixedBytes32,
        name: str,
        signatureTypeExpressionCid: layout.FixedBytes32): int32 =
    var found: int32 = -1
    for row in 0..<table.declIds.len:
        if layout.FixedBytes32Equal(
               table.portableDocumentIdentityCids[row], documentCid) &&
           table.canonicalNames[row] == name &&
           layout.FixedBytes32Equal(
               table.portableSignatureTypeExpressionCids[row],
               signatureTypeExpressionCid):
            assert(found < 0,
                   " declaration identity smoke: ambiguous exact row")
            found = row
    assert(found >= 0, " declaration identity smoke: exact row missing")
    return found

fn CheckCanonicalAndIdentityProperties() =
    var storeA: declaration.SemanticSnapshotDeclarationCandidateStore
    var tableA: declaration.SemanticSnapshotDeclarationTable
    var receiptA: declaration.SemanticSnapshotDeclarationMappingReceipt
    BuildReferenceInto(0, 0, 0, storeA, tableA, receiptA)
    var storeB: declaration.SemanticSnapshotDeclarationCandidateStore
    var tableB: declaration.SemanticSnapshotDeclarationTable
    var receiptB: declaration.SemanticSnapshotDeclarationMappingReceipt
    BuildReferenceInto(1, 0, 0, storeB, tableB, receiptB)
    var storeSpan: declaration.SemanticSnapshotDeclarationCandidateStore
    var tableSpan: declaration.SemanticSnapshotDeclarationTable
    var receiptSpan: declaration.SemanticSnapshotDeclarationMappingReceipt
    BuildReferenceInto(0, 1000, 0, storeSpan, tableSpan, receiptSpan)
    var storeProof: declaration.SemanticSnapshotDeclarationCandidateStore
    var tableProof: declaration.SemanticSnapshotDeclarationTable
    var receiptProof: declaration.SemanticSnapshotDeclarationMappingReceipt
    BuildReferenceInto(0, 0, 1, storeProof, tableProof, receiptProof)
    assert(tableA.declIds.len == 9 && tableB.declIds.len == 9,
           " declaration identity smoke: declaration count")
    for declId in 0..<tableA.declIds.len:
        assert(tableA.declIds[declId] == declId,
               " declaration identity smoke: dense DeclId")
    assert(rawbytes.BytesEqual(
               tableA.canonicalBytes, tableB.canonicalBytes),
           " declaration identity smoke: producer reorder changed table bytes")
    assert(layout.FixedBytes32Equal(tableA.tableCid, tableB.tableCid),
           " declaration identity smoke: producer reorder changed table CID")
    assert(!layout.FixedBytes32Equal(
               receiptA.receiptCid, receiptB.receiptCid),
           " declaration identity smoke: producer receipt unbound")
    assert(!rawbytes.BytesEqual(
               tableA.canonicalBytes, tableSpan.canonicalBytes) &&
           !layout.FixedBytes32Equal(tableA.tableCid, tableSpan.tableCid),
           " declaration identity smoke: span absent from table CID")
    for declId in 0..<tableA.declIds.len:
        assert(layout.FixedBytes32Equal(
                   tableA.declKeyCids[declId],
                   tableSpan.declKeyCids[declId]),
               " declaration identity smoke: span entered DeclKeyCid")
        assert(layout.FixedBytes32Equal(
                   tableA.declKeyCids[declId],
                   tableProof.declKeyCids[declId]),
               " declaration identity smoke: parser proof entered DeclKeyCid")
    assert(!layout.FixedBytes32Equal(tableA.tableCid, tableProof.tableCid),
           " declaration identity smoke: parser proof absent from table CID")
    let documentA = DocumentCid("pkg", "pkg/a")
    let documentB = DocumentCid("pkg", "pkg/b")
    let signatureA = TestCid("signature-type-expression:fn(int32):int32")
    let signatureB = TestCid("signature-type-expression:fn(uint32):int32")
    let operatorSignature = TestCid("signature-type-expression:fn():int32")
    let widgetType = TestCid(
        "type-expression:object(value:int32):without-self-declkey-or-typeid")
    let intType = TestCid("type-expression:scalar:int32")
    let computeA = FindRow(tableA, documentA, "Compute", signatureA)
    let overload = FindRow(tableA, documentA, "Compute", signatureB)
    let otherDocument = FindRow(tableA, documentB, "Compute", signatureA)
    let operator = FindRow(tableA, documentA, "()", operatorSignature)
    let moduleA = FindRow(tableA, documentA, "pkg/a", documentA)
    assert(!layout.FixedBytes32Equal(
               tableA.declKeyCids[computeA], tableA.declKeyCids[overload]) &&
           !layout.FixedBytes32Equal(
               tableA.declKeyCids[computeA],
               tableA.declKeyCids[otherDocument]),
           " declaration identity smoke: exact identities merged")
    assert(tableA.nameSurfaceKinds[operator] ==
               declaration.SemanticSnapshotDeclarationNameSurfaceBacktickOperator,
           " declaration identity smoke: parser-accepted backtick () lost")
    assert(tableA.nameSurfaceKinds[moduleA] ==
               declaration.SemanticSnapshotDeclarationNameSurfaceModulePath &&
           tableA.ownerDeclIds[moduleA] == -1 &&
           layout.FixedBytes32Equal(
               tableA.parserValidatedNameProofCids[moduleA], documentA) &&
           layout.FixedBytes32Equal(
               tableA.portableSignatureTypeExpressionCids[moduleA],
               documentA),
           " declaration identity smoke: module declaration authority drift")
    let widget = FindRow(tableA, documentA, "Widget", widgetType)
    let field = FindRow(tableA, documentA, "value", intType)
    var local: int32 = -1
    for row in 0..<tableA.declIds.len:
        if tableA.declarationKinds[row] ==
               declaration.SemanticSnapshotDeclarationKindLocal:
            local = row
    assert(local >= 0 && tableA.ownerDeclIds[field] == widget &&
           tableA.ownerDeclIds[local] == computeA &&
           tableA.ownerDepths[field] == 2 &&
           tableA.ownerDepths[local] == 2 &&
           tableA.maxOwnerDepth == 2,
           " declaration identity smoke: module-root owner remap/depth")
    assert(tableSpan.spanStartBytes[widget] ==
               tableA.spanStartBytes[widget] + 1000,
           " declaration identity smoke: span payload not preserved")
    var tableClone =
        declaration.SemanticSnapshotDeclarationTableClone(tableA)
    tableClone.parserValidatedNameProofCids[computeA] =
        TestCid("clone/proof-mutation")
    var cloneErr: str
    assert(!layout.FixedBytes32Equal(
               tableClone.parserValidatedNameProofCids[computeA],
               tableA.parserValidatedNameProofCids[computeA]) &&
           declaration.SemanticSnapshotDeclarationTableStrictValidateInto(
               tableA, cloneErr),
           " declaration identity smoke: declaration table clone aliases source")
    declaration.SemanticSnapshotDeclarationTableReleaseInto(tableClone)
    declaration.SemanticSnapshotDeclarationTableReleaseInto(tableProof)
    declaration.SemanticSnapshotDeclarationTableReleaseInto(tableSpan)
    declaration.SemanticSnapshotDeclarationTableReleaseInto(tableB)
    declaration.SemanticSnapshotDeclarationTableReleaseInto(tableA)

fn CheckAllDeclarationKinds() =
    let documentCid = DocumentCid("pkg", "pkg/kinds")
    let zero = layout.FixedBytes32()
    let scope = TestCid("all-kinds/scope")
    var store: declaration.SemanticSnapshotDeclarationCandidateStore
    declaration.SemanticSnapshotDeclarationCandidateStoreInitInto(store)
    let moduleRoot = AppendIdentifier(store, "pkg", "pkg/kinds", documentCid,
        -1, declaration.SemanticSnapshotDeclarationKindModule,
        "kinds", TestCid("all-kinds/module"), zero, 0, 1)
    AppendIdentifier(store, "pkg", "pkg/kinds", documentCid, moduleRoot,
        declaration.SemanticSnapshotDeclarationKindImportAlias,
        "dep", TestCid("all-kinds/import"), zero, 1, 2)
    let functionRoot = AppendIdentifier(store, "pkg", "pkg/kinds", documentCid,
        moduleRoot, declaration.SemanticSnapshotDeclarationKindFunction,
        "Function", TestCid("all-kinds/function"), zero, 2, 3)
    AppendIdentifier(store, "pkg", "pkg/kinds", documentCid, moduleRoot,
        declaration.SemanticSnapshotDeclarationKindIterator,
        "Iterator", TestCid("all-kinds/iterator"), zero, 3, 4)
    AppendIdentifier(store, "pkg", "pkg/kinds", documentCid, moduleRoot,
        declaration.SemanticSnapshotDeclarationKindMacro,
        "Macro", TestCid("all-kinds/macro"), zero, 4, 5)
    AppendIdentifier(store, "pkg", "pkg/kinds", documentCid, moduleRoot,
        declaration.SemanticSnapshotDeclarationKindTemplate,
        "Template", TestCid("all-kinds/template"), zero, 5, 6)
    let typeRoot = AppendIdentifier(store, "pkg", "pkg/kinds", documentCid,
        moduleRoot, declaration.SemanticSnapshotDeclarationKindType,
        "TypeRoot", TestCid("all-kinds/type"), zero, 6, 7)
    AppendIdentifier(store, "pkg", "pkg/kinds", documentCid, moduleRoot,
        declaration.SemanticSnapshotDeclarationKindConcept,
        "Concept", TestCid("all-kinds/concept"), zero, 7, 8)
    AppendIdentifier(store, "pkg", "pkg/kinds", documentCid, moduleRoot,
        declaration.SemanticSnapshotDeclarationKindTrait,
        "Trait", TestCid("all-kinds/trait"), zero, 8, 9)
    AppendIdentifier(store, "pkg", "pkg/kinds", documentCid, typeRoot,
        declaration.SemanticSnapshotDeclarationKindField,
        "field", TestCid("all-kinds/field"), zero, 9, 10)
    AppendIdentifier(store, "pkg", "pkg/kinds", documentCid, typeRoot,
        declaration.SemanticSnapshotDeclarationKindEnumVariant,
        "Variant", TestCid("all-kinds/variant"), zero, 10, 11)
    AppendIdentifier(store, "pkg", "pkg/kinds", documentCid, moduleRoot,
        declaration.SemanticSnapshotDeclarationKindConst,
        "Constant", TestCid("all-kinds/const"), zero, 11, 12)
    AppendIdentifier(store, "pkg", "pkg/kinds", documentCid, moduleRoot,
        declaration.SemanticSnapshotDeclarationKindGlobal,
        "Global", TestCid("all-kinds/global"), zero, 12, 13)
    AppendIdentifier(store, "pkg", "pkg/kinds", documentCid, functionRoot,
        declaration.SemanticSnapshotDeclarationKindLocal,
        "local", TestCid("all-kinds/local"), scope, 13, 14)
    AppendIdentifier(store, "pkg", "pkg/kinds", documentCid, functionRoot,
        declaration.SemanticSnapshotDeclarationKindParameter,
        "parameter", TestCid("all-kinds/parameter"), zero, 14, 15)
    AppendIdentifier(store, "pkg", "pkg/kinds", documentCid, typeRoot,
        declaration.SemanticSnapshotDeclarationKindGenericParameter,
        "Generic", TestCid("all-kinds/generic"), zero, 15, 16)
    let lambdaRoot = AppendIdentifier(store, "pkg", "pkg/kinds", documentCid,
        functionRoot, declaration.SemanticSnapshotDeclarationKindLambda,
        "lambda", TestCid("all-kinds/lambda"), scope, 16, 17)
    AppendIdentifier(store, "pkg", "pkg/kinds", documentCid, lambdaRoot,
        declaration.SemanticSnapshotDeclarationKindLabel,
        "label", TestCid("all-kinds/label"), scope, 17, 18)
    var table: declaration.SemanticSnapshotDeclarationTable
    var receipt: declaration.SemanticSnapshotDeclarationMappingReceipt
    var err: str
    assert(declaration.SemanticSnapshotDeclarationTableSealInto(
               store, table, receipt, err), err)
    assert(table.declIds.len == 18,
           " declaration identity smoke: formal kind coverage count")
    var seen: bool[]
    setLen(seen, 19)
    for row in 0..<table.declIds.len:
        seen[table.declarationKinds[row]] = true
    for kind in 1..<19:
        assert(seen[kind],
               " declaration identity smoke: formal kind missing")
    declaration.SemanticSnapshotDeclarationTableReleaseInto(table)

fn ExpectAppendRejected(
        store: var declaration.SemanticSnapshotDeclarationCandidateStore,
        packageId: str,
        modulePath: str,
        documentCid: layout.FixedBytes32,
        owner: int32,
        kind: int32,
        nameSurfaceKind: int32,
        name: str,
        scopeCid: layout.FixedBytes32,
        message: str) =
    var candidateIndex: int32
    var err: str
    let before = store.portableDocumentIdentityCids.len
    assert(!declaration.SemanticSnapshotDeclarationCandidateAppendInto(
               store, packageId, modulePath, documentCid, "", owner, kind,
               nameSurfaceKind, name,
               ParserValidatedNameProofCid(kind, nameSurfaceKind, name),
               TestCid("attack/type-expression"),
               scopeCid, 0, 1, candidateIndex, err), message)
    assert(store.portableDocumentIdentityCids.len == before,
           " declaration identity smoke: rejected append mutated store")

fn CheckDuplicateKeyAttack() =
    let documentCid = DocumentCid("pkg", "pkg/duplicate")
    var store: declaration.SemanticSnapshotDeclarationCandidateStore
    declaration.SemanticSnapshotDeclarationCandidateStoreInitInto(store)
    let moduleRoot = AppendIdentifier(store, "pkg", "pkg/duplicate", documentCid,
        -1, declaration.SemanticSnapshotDeclarationKindModule,
        "duplicate", TestCid("duplicate/module"), layout.FixedBytes32(), 0, 1)
    let signature = TestCid("duplicate/signature-without-self-declkey")
    AppendIdentifier(store, "pkg", "pkg/duplicate", documentCid, moduleRoot,
        declaration.SemanticSnapshotDeclarationKindFunction,
        "Same", signature, layout.FixedBytes32(), 2, 3)
    AppendIdentifier(store, "pkg", "pkg/duplicate", documentCid, moduleRoot,
        declaration.SemanticSnapshotDeclarationKindFunction,
        "Same", signature, layout.FixedBytes32(), 4, 5)
    var table: declaration.SemanticSnapshotDeclarationTable
    var receipt: declaration.SemanticSnapshotDeclarationMappingReceipt
    var err: str
    assert(!declaration.SemanticSnapshotDeclarationTableSealInto(
               store, table, receipt, err),
           " declaration identity smoke: duplicate key accepted")
    assert(!store.sealed,
           " declaration identity smoke: failed duplicate seal mutated state")

fn CheckIngressAndNameAttacks() =
    let documentCid = DocumentCid("pkg", "pkg/attack")
    var store: declaration.SemanticSnapshotDeclarationCandidateStore
    declaration.SemanticSnapshotDeclarationCandidateStoreInitInto(store)
    var candidateIndex: int32
    var err: str
    assert(!declaration.SemanticSnapshotDeclarationCandidateAppendInto(
               store, "pkg", "pkg/attack", documentCid, "", -1,
               declaration.SemanticSnapshotDeclarationKindModule,
               declaration.SemanticSnapshotDeclarationNameSurfaceModulePath,
               "pkg/other", documentCid, documentCid,
               layout.FixedBytes32(), 0, 1, candidateIndex, err),
           " declaration identity smoke: module canonical name drift accepted")
    assert(!declaration.SemanticSnapshotDeclarationCandidateAppendInto(
               store, "pkg", "pkg/attack", documentCid, "", -1,
               declaration.SemanticSnapshotDeclarationKindModule,
               declaration.SemanticSnapshotDeclarationNameSurfaceModulePath,
               "pkg/attack", TestCid("attack/module-proof"), documentCid,
               layout.FixedBytes32(), 0, 1, candidateIndex, err),
           " declaration identity smoke: module proof drift accepted")
    assert(!declaration.SemanticSnapshotDeclarationCandidateAppendInto(
               store, "pkg", "pkg/attack", documentCid, "", -1,
               declaration.SemanticSnapshotDeclarationKindModule,
               declaration.SemanticSnapshotDeclarationNameSurfaceModulePath,
               "pkg/attack", documentCid, TestCid("attack/module-signature"),
               layout.FixedBytes32(), 0, 1, candidateIndex, err),
           " declaration identity smoke: module signature drift accepted")
    assert(!declaration.SemanticSnapshotDeclarationCandidateAppendInto(
               store, "pkg", "pkg/attack", documentCid, "", 0,
               declaration.SemanticSnapshotDeclarationKindField,
               declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
               "field", ParserValidatedNameProofCid(
                   declaration.SemanticSnapshotDeclarationKindField,
                   declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
                   "field"), TestCid("attack/type"), layout.FixedBytes32(),
               0, 1, candidateIndex, err),
           " declaration identity smoke: forward owner accepted")
    assert(!declaration.SemanticSnapshotDeclarationCandidateAppendInto(
               store, "pkg", "pkg/attack", documentCid,
               "/tmp/workspace/source.cheng", -1,
               declaration.SemanticSnapshotDeclarationKindModule,
               declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
               "attack", ParserValidatedNameProofCid(
                   declaration.SemanticSnapshotDeclarationKindModule,
                   declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
                   "attack"), TestCid("attack/module"), layout.FixedBytes32(),
               0, 1, candidateIndex, err),
           " declaration identity smoke: physical path accepted")
    assert(!declaration.SemanticSnapshotDeclarationCandidateAppendInto(
               store, "pkg", "pkg/attack", documentCid, "", -1,
               declaration.SemanticSnapshotDeclarationKindModule,
               declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
               "/tmp/workspace/source.cheng", ParserValidatedNameProofCid(
                   declaration.SemanticSnapshotDeclarationKindModule,
                   declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
                   "/tmp/workspace/source.cheng"), TestCid("attack/module"),
               layout.FixedBytes32(), 0, 1, candidateIndex, err),
           " declaration identity smoke: path used as name accepted")
    let moduleRoot = AppendIdentifier(store, "pkg", "pkg/attack", documentCid,
        -1, declaration.SemanticSnapshotDeclarationKindModule,
        "attack", TestCid("attack/module"), layout.FixedBytes32(), 0, 1)
    assert(!declaration.SemanticSnapshotDeclarationCandidateAppendInto(
               store, "pkg", "pkg/attack", documentCid, "", moduleRoot,
               declaration.SemanticSnapshotDeclarationKindFunction,
               declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
               "MissingProof", layout.FixedBytes32(),
               TestCid("attack/missing-proof-signature"),
               layout.FixedBytes32(), 2, 3, candidateIndex, err),
           " declaration identity smoke: missing parser name proof accepted")
    ExpectAppendRejected(store, "pkg", "pkg/attack", documentCid, moduleRoot,
        declaration.SemanticSnapshotDeclarationKindFunction,
        declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
        "return", layout.FixedBytes32(),
        " declaration identity smoke: parser keyword accepted as identifier")
    ExpectAppendRejected(store, "pkg", "pkg/attack", documentCid, moduleRoot,
        declaration.SemanticSnapshotDeclarationKindType,
        declaration.SemanticSnapshotDeclarationNameSurfaceBacktickOperator,
        "()", layout.FixedBytes32(),
        " declaration identity smoke: backtick name accepted on non-routine")
    ExpectAppendRejected(store, "pkg", "pkg/attack", documentCid, moduleRoot,
        declaration.SemanticSnapshotDeclarationKindFunction,
        declaration.SemanticSnapshotDeclarationNameSurfaceBacktickOperator,
        "", layout.FixedBytes32(),
        " declaration identity smoke: empty parser-proved name accepted")
    ExpectAppendRejected(store, "pkg", "pkg/attack",
        TestCid("source-content:pkg/attack:edited"), moduleRoot,
        declaration.SemanticSnapshotDeclarationKindFunction,
        declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
        "ContentHashMiswire", layout.FixedBytes32(),
        " declaration identity smoke: source content hash used as document id")

fn CheckOwnerCycleAttack() =
    let documentCid = DocumentCid("pkg", "pkg/cycle")
    var store: declaration.SemanticSnapshotDeclarationCandidateStore
    declaration.SemanticSnapshotDeclarationCandidateStoreInitInto(store)
    let moduleRoot = AppendIdentifier(store, "pkg", "pkg/cycle", documentCid,
        -1, declaration.SemanticSnapshotDeclarationKindModule,
        "cycle", TestCid("cycle/module"), layout.FixedBytes32(), 0, 1)
    let functionRoot = AppendIdentifier(store, "pkg", "pkg/cycle", documentCid,
        moduleRoot, declaration.SemanticSnapshotDeclarationKindFunction,
        "CycleFn", TestCid("cycle/function"), layout.FixedBytes32(), 2, 3)
    store.ownerCandidateIndexes[moduleRoot] = functionRoot
    var err: str
    assert(!declaration.SemanticSnapshotDeclarationCandidateStoreStrictValidateInto(
               store, err),
           " declaration identity smoke: owner cycle accepted")

fn CheckOwnerScopeKindAttacks() =
    let documentCid = DocumentCid("pkg", "pkg/owners")
    let zero = layout.FixedBytes32()
    let scope = TestCid("owner-scope/scope")
    var store: declaration.SemanticSnapshotDeclarationCandidateStore
    declaration.SemanticSnapshotDeclarationCandidateStoreInitInto(store)
    ExpectAppendRejected(store, "pkg", "pkg/owners", documentCid, -1,
        declaration.SemanticSnapshotDeclarationKindFunction,
        declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
        "Ownerless", zero,
        " declaration identity smoke: non-module ownerless accepted")
    let moduleRoot = AppendIdentifier(store, "pkg", "pkg/owners", documentCid,
        -1, declaration.SemanticSnapshotDeclarationKindModule,
        "owners", TestCid("owners/module"), zero, 0, 1)
    let functionRoot = AppendIdentifier(store, "pkg", "pkg/owners", documentCid,
        moduleRoot, declaration.SemanticSnapshotDeclarationKindFunction,
        "OwnerFn", TestCid("owners/function"), zero, 1, 2)
    let typeRoot = AppendIdentifier(store, "pkg", "pkg/owners", documentCid,
        moduleRoot, declaration.SemanticSnapshotDeclarationKindType,
        "OwnerType", TestCid("owners/type"), zero, 2, 3)
    ExpectAppendRejected(store, "pkg", "pkg/owners", documentCid, functionRoot,
        declaration.SemanticSnapshotDeclarationKindModule,
        declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
        "NestedModule", zero,
        " declaration identity smoke: owned module accepted")
    ExpectAppendRejected(store, "pkg", "pkg/owners", documentCid, functionRoot,
        declaration.SemanticSnapshotDeclarationKindImportAlias,
        declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
        "badImport", zero,
        " declaration identity smoke: import alias non-module owner accepted")
    ExpectAppendRejected(store, "pkg", "pkg/owners", documentCid, functionRoot,
        declaration.SemanticSnapshotDeclarationKindField,
        declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
        "badField", zero,
        " declaration identity smoke: field non-type owner accepted")
    ExpectAppendRejected(store, "pkg", "pkg/owners", documentCid, functionRoot,
        declaration.SemanticSnapshotDeclarationKindEnumVariant,
        declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
        "BadVariant", zero,
        " declaration identity smoke: enum variant non-type owner accepted")
    ExpectAppendRejected(store, "pkg", "pkg/owners", documentCid, functionRoot,
        declaration.SemanticSnapshotDeclarationKindLocal,
        declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
        "badLocal", zero,
        " declaration identity smoke: local without scope accepted")
    ExpectAppendRejected(store, "pkg", "pkg/owners", documentCid, functionRoot,
        declaration.SemanticSnapshotDeclarationKindLambda,
        declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
        "badLambda", zero,
        " declaration identity smoke: lambda without scope accepted")
    ExpectAppendRejected(store, "pkg", "pkg/owners", documentCid, functionRoot,
        declaration.SemanticSnapshotDeclarationKindLabel,
        declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
        "badLabel", zero,
        " declaration identity smoke: label without scope accepted")
    ExpectAppendRejected(store, "pkg", "pkg/owners", documentCid, typeRoot,
        declaration.SemanticSnapshotDeclarationKindParameter,
        declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
        "badParameter", zero,
        " declaration identity smoke: parameter type owner accepted")
    ExpectAppendRejected(store, "pkg", "pkg/owners", documentCid, moduleRoot,
        declaration.SemanticSnapshotDeclarationKindGenericParameter,
        declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
        "BadGeneric", zero,
        " declaration identity smoke: generic module owner accepted")
    ExpectAppendRejected(store, "pkg", "pkg/owners", documentCid, functionRoot,
        declaration.SemanticSnapshotDeclarationKindGlobal,
        declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
        "badGlobal", zero,
        " declaration identity smoke: global non-module owner accepted")
    ExpectAppendRejected(store, "pkg", "pkg/owners", documentCid, moduleRoot,
        declaration.SemanticSnapshotDeclarationKindFunction,
        declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
        "ScopedTop", scope,
        " declaration identity smoke: top-level random scope accepted")

fn CheckTableTamperAttack(mode: int32) =
    var store: declaration.SemanticSnapshotDeclarationCandidateStore
    var table: declaration.SemanticSnapshotDeclarationTable
    var receipt: declaration.SemanticSnapshotDeclarationMappingReceipt
    BuildReferenceInto(0, 0, 0, store, table, receipt)
    let documentA = DocumentCid("pkg", "pkg/a")
    let widget = FindRow(table, documentA, "Widget", TestCid(
        "type-expression:object(value:int32):without-self-declkey-or-typeid"))
    let field = FindRow(
        table, documentA, "value", TestCid("type-expression:scalar:int32"))
    var local: int32 = -1
    for row in 0..<table.declIds.len:
        if table.declarationKinds[row] ==
               declaration.SemanticSnapshotDeclarationKindLocal:
            local = row
    assert(local >= 0, " declaration identity smoke: local attack row")
    if mode == 0: table.ownerDeclIds[field] = -1
    elif mode == 1:
        table.declarationKinds[widget] =
            declaration.SemanticSnapshotDeclarationKindFunction
    elif mode == 2:
        table.nameSurfaceKinds[widget] =
            declaration.SemanticSnapshotDeclarationNameSurfaceBacktickOperator
    elif mode == 3: table.canonicalNames[widget] = "WidgetChanged"
    elif mode == 4:
        table.portableSignatureTypeExpressionCids[widget] =
            TestCid("attack/type-expression-drift")
    elif mode == 5: table.lexicalScopeCids[local] = TestCid("attack/scope")
    elif mode == 6: table.declKeyCids[widget] = TestCid("attack/key")
    elif mode == 7: table.declIds[0] = 1
    elif mode == 8: table.ownerDepths[field] = table.ownerDepths[field] + 1
    elif mode == 9: table.tableCid = TestCid("attack/table")
    elif mode == 10:
        let first = rawbytes.BytesGet(table.canonicalBytes, 0)
        rawbytes.BytesSet(table.canonicalBytes, 0, first ^ 1)
    elif mode == 11: table.spanStartBytes[widget] = 999
    elif mode == 12: table.portableDocumentPackageIds[widget] = "other"
    elif mode == 13: table.portableDocumentModulePaths[widget] = "pkg/other"
    elif mode == 14:
        table.portableDocumentIdentityCids[widget] =
            TestCid("source-content:tamper")
    elif mode == 15:
        table.parserValidatedNameProofCids[widget] =
            TestCid("attack/parser-name-proof")
    else: assert(false, " declaration identity smoke: unknown table attack")
    var err: str
    var rejectionMessage =
        " declaration identity smoke: tampered table accepted"
    if mode == 15:
        rejectionMessage =
            " declaration identity smoke: wrong parser name proof accepted by old table"
    assert(!declaration.SemanticSnapshotDeclarationTableStrictValidateInto(
               table, err),
           rejectionMessage)
    declaration.SemanticSnapshotDeclarationTableReleaseInto(table)

fn CheckMappingTamperAttack(mode: int32) =
    var store: declaration.SemanticSnapshotDeclarationCandidateStore
    var table: declaration.SemanticSnapshotDeclarationTable
    var receipt: declaration.SemanticSnapshotDeclarationMappingReceipt
    BuildReferenceInto(0, 0, 0, store, table, receipt)
    if mode == 0:
        receipt.producerCandidateToDeclIds[0] =
            (receipt.producerCandidateToDeclIds[0] + 1) % table.declIds.len
    elif mode == 1:
        receipt.producerCandidateDeclKeyCids[0] = TestCid("attack/map-key")
    elif mode == 2: receipt.tableCid = TestCid("attack/map-table")
    elif mode == 3: receipt.maxOwnerDepth = receipt.maxOwnerDepth + 1
    elif mode == 4: receipt.receiptCid = TestCid("attack/map-receipt")
    else: assert(false, " declaration identity smoke: unknown mapping attack")
    var err: str
    assert(!declaration.SemanticSnapshotDeclarationMappingReceiptStrictValidateInto(
               store, table, receipt, err),
           " declaration identity smoke: tampered mapping accepted")
    declaration.SemanticSnapshotDeclarationTableReleaseInto(table)

fn CheckSealLifecycleAttacks() =
    var store: declaration.SemanticSnapshotDeclarationCandidateStore
    var table: declaration.SemanticSnapshotDeclarationTable
    var receipt: declaration.SemanticSnapshotDeclarationMappingReceipt
    BuildReferenceInto(0, 0, 0, store, table, receipt)
    var secondTable: declaration.SemanticSnapshotDeclarationTable
    var secondReceipt: declaration.SemanticSnapshotDeclarationMappingReceipt
    var err: str
    assert(!declaration.SemanticSnapshotDeclarationTableSealInto(
               store, secondTable, secondReceipt, err),
           " declaration identity smoke: duplicate seal accepted")
    var candidateIndex: int32
    assert(!declaration.SemanticSnapshotDeclarationCandidateAppendInto(
               store, "pkg", "pkg/late", DocumentCid("pkg", "pkg/late"),
               "", -1, declaration.SemanticSnapshotDeclarationKindModule,
               declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
               "late", ParserValidatedNameProofCid(
                   declaration.SemanticSnapshotDeclarationKindModule,
                   declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
                   "late"), TestCid("late/module"), layout.FixedBytes32(),
               0, 1, candidateIndex, err),
           " declaration identity smoke: append after seal accepted")
    declaration.SemanticSnapshotDeclarationTableReleaseInto(table)

fn main() =
    CheckParserBacktickParenthesesAuthority()
    CheckCanonicalAndIdentityProperties()
    CheckAllDeclarationKinds()
    CheckDuplicateKeyAttack()
    CheckIngressAndNameAttacks()
    CheckOwnerCycleAttack()
    CheckOwnerScopeKindAttacks()
    for mode in 0..<16:
        CheckTableTamperAttack(mode)
    for mode in 0..<5:
        CheckMappingTamperAttack(mode)
    CheckSealLifecycleAttacks()
    os.WriteLine(os.Get_stdout(),
                 "semantic_snapshot_declaration_identity_attack_count=48")
    os.WriteLine(os.Get_stdout(),
                 "semantic_snapshot_declaration_identity_formal_kind_count=18")
    os.WriteLine(os.Get_stdout(),
                 "semantic_snapshot_declaration_identity_document_hash=package_module_only")
    os.WriteLine(os.Get_stdout(),
                 "semantic_snapshot_declaration_identity_backtick_parentheses=accepted")
    os.WriteLine(os.Get_stdout(),
                 "semantic_snapshot_declaration_identity_radix_bytes=32")
    os.WriteLine(os.Get_stdout(),
                 "semantic_snapshot_declaration_identity_module_authority=1")
    os.WriteLine(os.Get_stdout(),
                 "semantic_snapshot_declaration_identity_smoke: ok")
