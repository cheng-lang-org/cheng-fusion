import std/system
import std/strings
import cheng/core/lang/parser as parser
import cheng/core/backend/system_link_plan as slplan

fn main(): int32 =
    let entry = "/Users/lbcheng/cheng-lang/src/tests/_zc_probe_sys.cheng"
    var externalPackageRoots: parser.ParserExternalPackageRoot[]
    var seen: str[]
    var ordered: str[]
    var edges: parser.ImportEdge[]
    var unresolved: int32
    var cerr: str
    let cok = parser.ParserCollectClosureWithExternalPackageRoots(
        "/Users/lbcheng/cheng-lang",
        "/Users/lbcheng/cheng-lang",
        externalPackageRoots,
        entry,
        seen,
        ordered,
        edges,
        unresolved,
        cerr)
    if !cok:
        echo("COLLECT FAIL err=" + cerr)
        return 1
    var ownerModulePaths: str[]
    var sourceTexts: str[]
    for i in 0..<ordered.len:
        var identity: str
        let iok = slplan.SystemLinkPlanSourceRowIdentityInto(
            "/Users/lbcheng/cheng-lang",
            "/Users/lbcheng/cheng-lang",
            "cheng",
            externalPackageRoots,
            ordered[i],
            identity)
        if !iok:
            echo("IDENTITY FAIL")
            return 2
        add(ownerModulePaths, identity)
        var txt: str
        var terr: str
        if !parser.ParserSourceTextWithExternalPackageRootsInto(
                ordered[i],
                externalPackageRoots,
                txt,
                terr):
            echo("TEXT FAIL")
            return 3
        add(sourceTexts, txt)
    var rebuilt: parser.ImportEdge[]
    var rebuiltUnresolved: int32
    var rerr: str
    let rok = slplan.SystemLinkPlanRebuildImportEdgesFromTextsInto(
        "/Users/lbcheng/cheng-lang",
        "/Users/lbcheng/cheng-lang",
        "cheng",
        externalPackageRoots,
        ordered,
        ownerModulePaths,
        sourceTexts,
        0,
        rebuilt,
        rebuiltUnresolved,
        rerr)
    if !rok:
        echo("REBUILD FAIL err=" + rerr)
        return 4
    echo("REBUILD ok rows=" + strings.IntToStr(ordered.len) + " edges=" + strings.IntToStr(rebuilt.len) + " unresolved=" + strings.IntToStr(rebuiltUnresolved))
    return 0
