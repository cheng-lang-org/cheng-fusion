fn ColdExactConditionalCleanupAppendDigit(
        trace: var int32,
        digit: int32) =
    trace = trace * 10 + digit

fn ColdExactConditionalCleanupNonemptyJoin(
        trace: var int32,
        takeConditional: bool,
        early: bool): str =
    defer:
        ColdExactConditionalCleanupAppendDigit(trace, 9)
    let conditional = Fmt"conditional-owner"
    var active: str[]
    add(active, "active-owner")
    if takeConditional:
        return conditional
    if early:
        return ""
    let out = Fmt"late-owner"
    return out

fn main(): int32 =
    var conditionalTrace: int32
    let conditional = ColdExactConditionalCleanupNonemptyJoin(
        conditionalTrace,
        true,
        false)
    if conditional != "conditional-owner" ||
       conditionalTrace != 9:
        return 1

    var earlyTrace: int32
    let early = ColdExactConditionalCleanupNonemptyJoin(
        earlyTrace,
        false,
        true)
    if early != "" || earlyTrace != 9:
        return 2

    var lateTrace: int32
    let late = ColdExactConditionalCleanupNonemptyJoin(
        lateTrace,
        false,
        false)
    if late != "late-owner" || lateTrace != 9:
        return 3
    return 0
