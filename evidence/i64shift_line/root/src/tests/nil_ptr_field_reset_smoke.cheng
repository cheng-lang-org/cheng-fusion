type
    Cache =
        keyPtr: ptr
        keyLen: int32

fn ResetCache(c: var Cache) =
    c.keyPtr = nil
    c.keyLen = 0

fn main(): int32 =
    var v: int32
    var c: Cache
    c.keyPtr = &v
    c.keyLen = 4
    if c.keyPtr == nil:
        return 1
    ResetCache(c)
    if c.keyPtr != nil:
        return 2
    if c.keyLen != 0:
        return 3
    return 0
