import std/strings

type Entry =
    name: str
    value: str

@borrows
fn Valid(n: str): bool =
    return n.len > 0

fn SetEntry(doc: var Entry[], entryName: str, entryValue: str): bool =
    if !Valid(entryName):
        return false
    var i = 0
    while i < doc.len:
        if doc[i].name == entryName:
            doc[i].value = strings.CloneStr(entryValue)
            return true
        i = i + 1
    var e: Entry
    e.name = entryName
    e.value = strings.CloneStr(entryValue)
    add(doc, e)
    return true

fn main(): int32 =
    var bag: Entry[]
    let r1 = SetEntry(bag, "alpha", "1")
    let r2 = SetEntry(bag, "alpha", "2")
    if r1 && r2 && bag.len == 1:
        return 0
    return 1
