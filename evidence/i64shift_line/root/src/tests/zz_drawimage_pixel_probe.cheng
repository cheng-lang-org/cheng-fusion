import std/system
import core/runtime/web_raster_runtime as raster
import core/runtime/web_paint_runtime as paint

fn runDrawImagePixelProbe(): int32 =
    var surface: raster.RasterSurface
    raster.RasterSurfaceInit(surface)
    if !raster.RasterResize(surface, 3, 3, 9):
        return 88
    # arm A: legacy bare pixels (alpha=0 under the new ARGB contract)
    var pixels: int32[]
    add(pixels, 11)
    add(pixels, 22)
    add(pixels, 33)
    add(pixels, 44)
    if !raster.RasterImageCacheRegister(surface.imageCache, 7, 2, 2, pixels):
        return 89
    var ops: paint.PaintOp[]
    add(ops, paint.PaintOpMakeDrawImage(0, 0, 2, 2, 7, 2, 2))
    if !raster.RasterPaintOps(surface, ops):
        return 90
    echo(Fmt"armA bare px00={raster.RasterPixelAt(surface, 0, 0)} px10={raster.RasterPixelAt(surface, 1, 0)} px01={raster.RasterPixelAt(surface, 0, 1)} px11={raster.RasterPixelAt(surface, 1, 1)} corner22={raster.RasterPixelAt(surface, 2, 2)}")
    # arm B: opaque ARGB pixels (alpha=255), the production packing
    var opaque: int32[]
    add(opaque, (255 << 24) | 11)
    add(opaque, (255 << 24) | 22)
    add(opaque, (255 << 24) | 33)
    add(opaque, (255 << 24) | 44)
    if !raster.RasterImageCacheRegister(surface.imageCache, 8, 2, 2, opaque):
        return 96
    var ops2: paint.PaintOp[]
    add(ops2, paint.PaintOpMakeDrawImage(0, 0, 2, 2, 8, 2, 2))
    if !raster.RasterPaintOps(surface, ops2):
        return 97
    echo(Fmt"armB opaque px00={raster.RasterPixelAt(surface, 0, 0)} px10={raster.RasterPixelAt(surface, 1, 0)} px01={raster.RasterPixelAt(surface, 0, 1)} px11={raster.RasterPixelAt(surface, 1, 1)} corner22={raster.RasterPixelAt(surface, 2, 2)}")
    return 0

fn main(): int32 =
    return runDrawImagePixelProbe()
