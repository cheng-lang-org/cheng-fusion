import cheng/core/ir/core_types as ir
import cheng/core/ir/body_ir_access as access

fn makeSlot(id: int32, name: str, typeKind: int32): ir.LocalSlot =
    var slot: ir.LocalSlot
    slot.id = id
    slot.name = name
    slot.typeKind = typeKind
    slot.stackOffset = -1 - id
    slot.sizeBytes = 4
    slot.alignBytes = 4
    if typeKind == ir.LocalStrTag:
        slot.sizeBytes = 24
        slot.alignBytes = 8
    ir.BodyIRApplyLocalSlotDefaultProof(slot)
    return slot

fn appendGuard(body: var ir.BodyIR,
               conditionSlot: int32,
               callOrdinal: int32,
               target: int32,
               operandCount: int32) =
    var op: ir.BodyOp
    op.kind = ir.BodyOpResultPanicGuardTag
    op.target = target
    if operandCount > 0:
        add(op.operands, conditionSlot)
    if operandCount > 1:
        add(op.operands, callOrdinal)
    if operandCount > 2:
        add(op.operands, 0)
    add(body.ops, op)

fn buildGuardBody(body: var ir.BodyIR,
                  conditionType: int32,
                  conditionSlot: int32,
                  guardCallOrdinal: int32,
                  guardTarget: int32,
                  guardOperandCount: int32,
                  normalCallFirst: bool,
                  guardCount: int32,
                  argPassCount: int32,
                  argPassKind: int32,
                  callResultSlot: int32,
                  resultPassKind: int32,
                  argAbiCount: int32,
                  argAbiSize: int32) =
    add(body.localSlots, makeSlot(0, "ok", conditionType))
    add(body.localSlots, makeSlot(1, "message", ir.LocalStrTag))

    var call: ir.CallOp
    call.targetSymbol = "Panic"
    call.resultSlot = callResultSlot
    call.resultPassKind = resultPassKind
    call.relocWordOffset = -1
    add(call.argSlots, 1)
    if argPassCount > 0:
        add(call.argPassKinds, argPassKind)
    if argPassCount > 1:
        add(call.argPassKinds, argPassKind)
    if argAbiCount > 0:
        add(call.argAbiSizes, argAbiSize)
    if argAbiCount > 1:
        add(call.argAbiSizes, argAbiSize)
    add(body.callSequence, call)
    if normalCallFirst:
        var callOp: ir.BodyOp
        callOp.kind = ir.BodyOpCallTag
        callOp.target = callResultSlot
        add(callOp.operands, 0)
        add(body.ops, callOp)
    if guardCount > 0:
        appendGuard(body,
                    conditionSlot,
                    guardCallOrdinal,
                    guardTarget,
                    guardOperandCount)
    if guardCount > 1:
        appendGuard(body,
                    conditionSlot,
                    guardCallOrdinal,
                    guardTarget,
                    guardOperandCount)

    var term: ir.BodyTerm
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = 0
    add(term.operands, ir.LocalI32Tag)
    let termIndex = ir.BodyIRAppendTerm(body, term)
    var opCount = guardCount
    if normalCallFirst:
        opCount = opCount + 1
    let _ = ir.BodyIRAppendBlock(body, 0, opCount, termIndex)

fn buildGuardOpShape(body: var ir.BodyIR,
                     conditionType: int32,
                     conditionSlot: int32,
                     callOrdinal: int32,
                     target: int32,
                     operandCount: int32,
                     normalCallFirst: bool,
                     guardCount: int32) =
    buildGuardBody(body,
                   conditionType,
                   conditionSlot,
                   callOrdinal,
                   target,
                   operandCount,
                   normalCallFirst,
                   guardCount,
                   1,
                   ir.BodyCallPassStackValueTag,
                   -1,
                   ir.BodyCallPassStackValueTag,
                   0,
                   0)

fn buildGuardCallShape(body: var ir.BodyIR,
                       argPassCount: int32,
                       argPassKind: int32,
                       callResultSlot: int32,
                       resultPassKind: int32,
                       argAbiCount: int32,
                       argAbiSize: int32) =
    buildGuardBody(body,
                   ir.LocalI32Tag,
                   0,
                   0,
                   -1,
                   2,
                   false,
                   1,
                   argPassCount,
                   argPassKind,
                   callResultSlot,
                   resultPassKind,
                   argAbiCount,
                   argAbiSize)

fn buildValidGuardBody(body: var ir.BodyIR) =
    buildGuardCallShape(body,
                        1,
                        ir.BodyCallPassStackValueTag,
                        -1,
                        ir.BodyCallPassStackValueTag,
                        0,
                        0)

fn expectFailure(body: var ir.BodyIR,
                 errorCode: int32,
                 errorSiteIndex: int32): bool =
    var table = access.BodyIrAccessDecode(body)
    return !table.valid &&
           table.errorCode == errorCode &&
           table.errorSiteKind == access.BodyIrAccessSiteOp &&
           table.errorSiteIndex == errorSiteIndex

fn testValidGuardFacts(): int32 =
    var body = ir.BodyIRNew()
    buildValidGuardBody(body)
    if body.callSequence.len != 1:
        return 71
    if body.ops.len != 1:
        return 72
    if body.ops[0].kind != ir.BodyOpResultPanicGuardTag:
        return 73
    if body.ops[0].operands.len != 2:
        return 74
    if body.ops[0].operands[0] != 0 || body.ops[0].operands[1] != 0:
        return 75
    var table = access.BodyIrAccessDecode(body)
    if !table.valid:
        if table.errorCode == access.BodyIrAccessErrorCallOrdinal:
            if table.errorSiteIndex == -1:
                return 76
            if table.errorSiteIndex == 0:
                return 77
            return 78
        return 40 + table.errorCode
    let dod = ir.BodyIRDodSoAContractCheck(body)
    if !dod.ok:
        return 79
    if table.errorCode != access.BodyIrAccessErrorNone:
        return 60 + table.errorCode
    if table.callUseCounts.len != 1 || table.callUseCounts[0] != 1 ||
       table.callFactStarts.len != 1 || table.callFactStarts[0] != 3 ||
       table.callFactCounts.len != 1 || table.callFactCounts[0] != 4:
        return 12
    if table.opFactStarts.len != 1 || table.opFactStarts[0] != 2 ||
       table.opFactCounts.len != 1 || table.opFactCounts[0] != 5:
        return 13
    let opStart = table.opFactStarts[0]
    let condition = table.facts[opStart]
    let address = table.facts[opStart + 1]
    let argument = table.facts[opStart + 2]
    let memory = table.facts[opStart + 3]
    let clobber = table.facts[opStart + 4]
    if condition.kind != access.BodyIrAccessFactUse ||
       condition.slotIndex != 0 || condition.operandIndex != 0 ||
       condition.fixedKind != access.BodyIrAccessFixedNone:
        return 14
    if address.kind != access.BodyIrAccessFactAddress ||
       address.slotIndex != 1 || address.operandIndex != 0 ||
       address.fixedKind != access.BodyIrAccessFixedCallArg ||
       address.fixedOrdinal != 0 ||
       address.passKind != ir.BodyCallPassStackValueTag ||
       !address.addressEscapes || address.addressOwnerSlot != 1 ||
       address.addressByteOffset != 0 || address.addressByteLength != 24 ||
       address.abiSizeBytes != 8 || address.abiSizeExplicit ||
       address.callOrdinal != 0 ||
       !access.BodyIrAccessAddressFactIsValid(body, address):
        return 15
    if argument.kind != access.BodyIrAccessFactUse ||
       argument.slotIndex != 1 || argument.operandIndex != 0 ||
       argument.fixedKind != access.BodyIrAccessFixedCallArg ||
       argument.fixedOrdinal != 0 ||
       argument.passKind != ir.BodyCallPassStackValueTag ||
       !argument.addressEscapes || argument.abiSizeBytes != 8 ||
       argument.abiSizeExplicit || argument.callOrdinal != 0:
        return 16
    if memory.kind != access.BodyIrAccessFactMemory ||
       memory.memoryEffect != access.BodyIrAccessMemoryCallReadWrite:
        return 17
    if clobber.kind != access.BodyIrAccessFactClobber ||
       clobber.clobberKind != access.BodyIrAccessClobberCallAbi ||
       clobber.encodedValue != 0:
        return 18
    for factIndex in opStart..<(opStart + table.opFactCounts[0]):
        if table.facts[factIndex].kind == access.BodyIrAccessFactDef:
            return 19
    return 0

fn testGuardShapeFailures(): int32 =
    var shortArity = ir.BodyIRNew()
    buildGuardOpShape(shortArity, ir.LocalI32Tag,
                      0, 0, -1, 1, false, 1)
    if !expectFailure(shortArity, access.BodyIrAccessErrorArity, 0):
        return 21
    if ir.BodyIRDodSoAContractCheck(shortArity).ok:
        return 81

    var longArity = ir.BodyIRNew()
    buildGuardOpShape(longArity, ir.LocalI32Tag,
                      0, 0, -1, 3, false, 1)
    if !expectFailure(longArity, access.BodyIrAccessErrorArity, 0):
        return 22
    if ir.BodyIRDodSoAContractCheck(longArity).ok:
        return 82

    var badTarget = ir.BodyIRNew()
    buildGuardOpShape(badTarget, ir.LocalI32Tag,
                      0, 0, 0, 2, false, 1)
    if !expectFailure(badTarget, access.BodyIrAccessErrorCallShape, 0):
        return 23
    if ir.BodyIRDodSoAContractCheck(badTarget).ok:
        return 83

    var badConditionRef = ir.BodyIRNew()
    buildGuardOpShape(badConditionRef, ir.LocalI32Tag,
                      2, 0, -1, 2, false, 1)
    if !expectFailure(badConditionRef, access.BodyIrAccessErrorLocalRef, 0):
        return 24
    if ir.BodyIRDodSoAContractCheck(badConditionRef).ok:
        return 84

    var badConditionType = ir.BodyIRNew()
    buildGuardOpShape(badConditionType, ir.LocalI64Tag,
                      0, 0, -1, 2, false, 1)
    if !expectFailure(badConditionType,
                      access.BodyIrAccessErrorOperandShape,
                      0):
        return 25
    if ir.BodyIRDodSoAContractCheck(badConditionType).ok:
        return 85

    var badOrdinal = ir.BodyIRNew()
    buildGuardOpShape(badOrdinal, ir.LocalI32Tag,
                      0, 1, -1, 2, false, 1)
    if !expectFailure(badOrdinal, access.BodyIrAccessErrorCallOrdinal, 0):
        return 26
    if ir.BodyIRDodSoAContractCheck(badOrdinal).ok:
        return 86
    return 0

fn testEmbeddedCallFailures(): int32 =
    var duplicate = ir.BodyIRNew()
    buildGuardOpShape(duplicate, ir.LocalI32Tag,
                      0, 0, -1, 2, true, 1)
    var duplicateTable = access.BodyIrAccessDecode(duplicate)
    if duplicateTable.valid ||
       duplicateTable.errorCode != access.BodyIrAccessErrorCallOrdinal ||
       duplicateTable.errorSiteIndex != 1 ||
       duplicateTable.callUseCounts.len != 1 ||
       duplicateTable.callUseCounts[0] != 1:
        return 31

    var missing = ir.BodyIRNew()
    buildGuardOpShape(missing, ir.LocalI32Tag,
                      0, 0, -1, 2, false, 0)
    var missingTable = access.BodyIrAccessDecode(missing)
    if missingTable.valid ||
       missingTable.errorCode != access.BodyIrAccessErrorCallOrdinal ||
       missingTable.errorSiteIndex != -1 ||
       missingTable.callUseCounts.len != 1 ||
       missingTable.callUseCounts[0] != 0:
        return 39

    var badArgShape = ir.BodyIRNew()
    buildGuardCallShape(badArgShape,
                        0,
                        ir.BodyCallPassStackValueTag,
                        -1,
                        ir.BodyCallPassStackValueTag,
                        0,
                        0)
    if !expectFailure(badArgShape, access.BodyIrAccessErrorCallShape, 0):
        return 32

    var badPass = ir.BodyIRNew()
    buildGuardCallShape(badPass, 1, 99, -1,
                        ir.BodyCallPassStackValueTag, 0, 0)
    if !expectFailure(badPass, access.BodyIrAccessErrorPassKind, 0):
        return 33

    var badResultPass = ir.BodyIRNew()
    buildGuardCallShape(badResultPass,
                        1,
                        ir.BodyCallPassStackValueTag,
                        -1, 99, 0, 0)
    if !expectFailure(badResultPass, access.BodyIrAccessErrorPassKind, 0):
        return 34

    var badResultSlot = ir.BodyIRNew()
    buildGuardCallShape(badResultSlot,
                        1,
                        ir.BodyCallPassStackValueTag,
                        0,
                        ir.BodyCallPassStackValueTag,
                        0,
                        0)
    if !expectFailure(badResultSlot, access.BodyIrAccessErrorCallShape, 0):
        return 35

    var badSret = ir.BodyIRNew()
    buildGuardCallShape(badSret,
                        1,
                        ir.BodyCallPassStackValueTag,
                        -1,
                        ir.BodyCallPassSretResultTag,
                        0,
                        0)
    if !expectFailure(badSret, access.BodyIrAccessErrorCallShape, 0):
        return 36

    var badAbiCount = ir.BodyIRNew()
    buildGuardCallShape(badAbiCount,
                        1,
                        ir.BodyCallPassStackValueTag,
                        -1,
                        ir.BodyCallPassStackValueTag,
                        2,
                        4)
    if !expectFailure(badAbiCount, access.BodyIrAccessErrorCallShape, 0):
        return 37

    var badAbiSize = ir.BodyIRNew()
    buildGuardCallShape(badAbiSize,
                        1,
                        ir.BodyCallPassStackValueTag,
                        -1,
                        ir.BodyCallPassStackValueTag,
                        1,
                        3)
    if !expectFailure(badAbiSize, access.BodyIrAccessErrorCallShape, 0):
        return 38
    var wrongCompositeAbiSize = ir.BodyIRNew()
    buildGuardCallShape(wrongCompositeAbiSize,
                        1,
                        ir.BodyCallPassStackValueTag,
                        -1,
                        ir.BodyCallPassStackValueTag,
                        1,
                        4)
    if !expectFailure(wrongCompositeAbiSize,
                      access.BodyIrAccessErrorCallShape,
                      0):
        return 41
    return 0

fn main(): int32 =
    let validCode = testValidGuardFacts()
    if validCode != 0:
        return validCode
    let shapeCode = testGuardShapeFailures()
    if shapeCode != 0:
        return shapeCode
    return testEmbeddedCallFailures()
