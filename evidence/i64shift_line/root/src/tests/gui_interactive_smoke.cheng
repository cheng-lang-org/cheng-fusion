import std/gui as gui

fn main(): int32 =
    gui.Log("Cheng GUI interactive test starting")
    gui.Init()

    var win = gui.CreateWindow("Cheng GUI Interactive", 600, 400)
    gui.ShowWindow(win)

    var label = gui.CreateLabel("Welcome to Cheng GUI!", 50, 350, 300, 30)
    gui.AddView(win, label)

    var canvas = gui.CreateCanvas(50, 100, 500, 200)
    gui.SetCanvasColor(canvas, 100, 150, 255)
    gui.AddView(win, canvas)

    var button = gui.CreateButton("Click Me", 220, 30, 160, 40)
    gui.AddView(win, button)

    var running: int32
    while running < 360:
        gui.ProcessFrame()
        var ev = gui.NextEvent()
        while ev != gui.EVENT_NONE:
            if ev == gui.EVENT_QUIT:
                running = 360
            gui.ConsumeEvent()
            ev = gui.NextEvent()
        gui.TimerTick()
        running = running + 1
        gui.SleepMs(16)

    gui.ReleaseView(label)
    gui.ReleaseView(canvas)
    gui.ReleaseView(button)
    gui.CloseWindow(win)
    gui.Log("Cheng GUI interactive test done")
    return 0
