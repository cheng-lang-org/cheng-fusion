type
    CsgCoreMerkleSuccessorCrashBoundary = enum
        BeforeObjectCommit
        AfterObjectCommitBeforeSuccessorRename
        AfterSuccessorRenameBeforeParentSync
        AfterParentSync

type
    CsgCoreMerkleSuccessorWriterOutcome = enum
        SuccessorCommitted
        SuccessorConflict

type
    CsgCoreMerkleSuccessorCrashExpectation =
        predecessorRemainsReadable: bool
        successorMayBeReadable: bool
        successorMustBeReadable: bool
        commitRequiresReread: bool
        authorityDeletionAllowed: bool

@borrows
fn CsgCoreMerkleSuccessorWriterResult(
        successorExists: bool,
        existingHeadCid: str,
        candidateHeadCid: str):
        CsgCoreMerkleSuccessorWriterOutcome =
    if !successorExists:
        return SuccessorCommitted
    return SuccessorConflict

fn CsgCoreMerkleSuccessorCrashExpected(
        boundary: CsgCoreMerkleSuccessorCrashBoundary):
        CsgCoreMerkleSuccessorCrashExpectation =
    var out: CsgCoreMerkleSuccessorCrashExpectation
    out.predecessorRemainsReadable = true
    out.authorityDeletionAllowed = false
    if boundary == BeforeObjectCommit:
        return out
    if boundary == AfterObjectCommitBeforeSuccessorRename:
        return out
    out.successorMayBeReadable = true
    out.commitRequiresReread =
        boundary == AfterSuccessorRenameBeforeParentSync
    out.successorMustBeReadable =
        boundary == AfterParentSync
    return out

fn main(): int32 =
    let same =
        CsgCoreMerkleSuccessorWriterResult(
            true, "head-a", "head-a")
    let different =
        CsgCoreMerkleSuccessorWriterResult(
            true, "head-a", "head-b")
    let uncertain =
        CsgCoreMerkleSuccessorCrashExpected(
            AfterSuccessorRenameBeforeParentSync)
    let durable =
        CsgCoreMerkleSuccessorCrashExpected(
            AfterParentSync)
    if same != SuccessorConflict ||
       different != SuccessorConflict ||
       !uncertain.predecessorRemainsReadable ||
       !uncertain.successorMayBeReadable ||
       !uncertain.commitRequiresReread ||
       uncertain.authorityDeletionAllowed ||
       !durable.successorMustBeReadable ||
       durable.authorityDeletionAllowed:
        return 1
    return 0
