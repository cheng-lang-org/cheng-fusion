import std/result
import std/strformat
import std/strutils as strutil
import cheng/core/backend/lowering_plan as lower
import cheng/core/lang/intern as langintern
import cheng/core/lang/parser
import cheng/core/lang/typed_expr as texpr
import cheng/core/tooling/path as chengpath

fn appendFunction(plan: var lower.LoweringPlanStub,
                  sourcePath: str,
                  functionName: str,
                  lineNumber: int32) =
    var fnIr: texpr.TypedExprIrFunction
    fnIr.sourcePath = sourcePath
    fnIr.functionName = functionName
    fnIr.signatureLineNumber = lineNumber
    fnIr.endLineNumber = lineNumber
    fnIr.bodyLineNumber = lineNumber
    fnIr.returnType = "int32"
    fnIr.returnNodeIndex = -1
    texpr.TypedExprIrAppendFunction(plan.typedIr, fnIr)

fn appendStatement(plan: var lower.LoweringPlanStub,
                   sourcePath: str,
                   functionName: str,
                   surfaceText: str,
                   callArgsText: str,
                   callTarget: str,
                   callTargetSourcePath: str) =
    var stmt: texpr.TypedExprIrStatement
    stmt.sourcePath = sourcePath
    stmt.functionName = functionName
    stmt.statementIndex = plan.typedIr.statements2_statementIndexs.len
    stmt.lineNumber = stmt.statementIndex + 1
    stmt.surfaceText = surfaceText
    stmt.callArgsText = callArgsText
    stmt.callTarget = callTarget
    stmt.callTargetSourcePath = callTargetSourcePath
    stmt.assignLvalueNodeIndex = -1
    texpr.TypedExprIrAppendStatement(plan.typedIr, stmt)

fn appendFuncRef(plan: var lower.LoweringPlanStub,
                 sourcePath: str,
                 ownerFunctionName: str,
                 targetFunctionName: str) =
    var node: texpr.TypedExprIrNode
    node.resultStructuralTypeId = -1
    node.sourcePath = sourcePath
    node.functionName = ownerFunctionName
    node.nodeIndex = plan.typedIr.nodes2_nodeIndexs.len
    node.lineNumber = node.nodeIndex + 1
    node.opKind = texpr.TypedExprIrOpFuncRef
    node.resultType = "ptr"
    node.surfaceText = targetFunctionName
    node.literalText = targetFunctionName
    texpr.TypedExprIrAppendNode(plan.typedIr, node)

fn oracleDotTail(name: str): str =
    var tailStart: int32
    for i in 0..<len(name):
        if name[i] == '.':
            tailStart = i + 1
    if tailStart > 0 && tailStart < len(name):
        return chengpath.TextSlice(name, tailStart, len(name) - tailStart)
    return name

fn oracleSurfaceReferences(text: str,
                           functionName: str): bool =
    let functionTail = lower.LoweringFunctionTailName(functionName)
    for i in 0..<len(text):
        if text[i] != '(':
            continue
        let identEnd = i
        var identStart = i
        while identStart > 0:
            let ch = text[identStart - 1]
            var identChar = false
            if ch >= 'a' && ch <= 'z':
                identChar = true
            elif ch >= 'A' && ch <= 'Z':
                identChar = true
            elif ch >= '0' && ch <= '9':
                identChar = true
            elif ch == '_' || ch == '.':
                identChar = true
            if !identChar:
                break
            identStart = identStart - 1
        if identStart >= identEnd:
            continue
        let head = chengpath.TextSlice(text,
                                      identStart,
                                      identEnd - identStart)
        let colonTail = lower.LoweringFunctionTailName(head)
        let dotTail = oracleDotTail(colonTail)
        if head == functionName || head == functionTail ||
           colonTail == functionName || colonTail == functionTail ||
           dotTail == functionName || dotTail == functionTail:
            return true
    return false

fn oracleAddressReferences(callArgsText: str,
                           functionName: str): bool =
    let pieces = texpr.TypedExprSplitTopLevelCsv(callArgsText)
    let functionTail = lower.LoweringFunctionTailName(functionName)
    for i in 0..<pieces.len:
        let addressName = lower.LoweringFunctionAddressArgName(pieces[i])
        let addressTail = lower.LoweringFunctionTailName(addressName)
        if addressName == functionName || addressName == functionTail ||
           addressTail == functionName || addressTail == functionTail:
            return true
    return false

fn oracleUniqueSource(ir: var texpr.TypedExprIr,
                      functionName: str): str =
    let functionTail = lower.LoweringFunctionTailName(functionName)
    var found: str
    for functionIndex in 0..<ir.functions2_functionNameIds.len:
        let sourceRes: Result[str] = langintern.LookupIntern(
            ir.internPool,
            ir.functions2_sourcePathIds[functionIndex])
        let nameRes: Result[str] = langintern.LookupIntern(
            ir.internPool,
            ir.functions2_functionNameIds[functionIndex])
        if !IsOk(sourceRes) || !IsOk(nameRes):
            continue
        let candidateName = Value(nameRes)
        let candidateTail = lower.LoweringFunctionTailName(candidateName)
        if candidateName != functionName &&
           candidateName != functionTail &&
           candidateTail != functionName &&
           candidateTail != functionTail:
            continue
        let candidateSource = parser.ParserNormalizePath(Value(sourceRes))
        if found != "" && found != candidateSource:
            return ""
        found = candidateSource
    return found

fn oracleIsReferenced(ir: var texpr.TypedExprIr,
                      sourcePathRaw: str,
                      functionName: str): bool =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let functionTail = lower.LoweringFunctionTailName(functionName)
    for statementIndex in 0..<ir.statements2_statementIndexs.len:
        let sourceRes: Result[str] = langintern.LookupIntern(
            ir.internPool,
            ir.statements2_sourcePathIds[statementIndex])
        let surfaceRes: Result[str] = langintern.LookupIntern(
            ir.internPool,
            ir.statements2_surfaceTextIds[statementIndex])
        let callArgsRes: Result[str] = langintern.LookupIntern(
            ir.internPool,
            ir.statements2_callArgsTextIds[statementIndex])
        let targetRes: Result[str] = langintern.LookupIntern(
            ir.internPool,
            ir.statements2_callTargetIds[statementIndex])
        let targetSourceRes: Result[str] = langintern.LookupIntern(
            ir.internPool,
            ir.statements2_callTargetSourcePathIds[statementIndex])
        if !IsOk(sourceRes) || !IsOk(surfaceRes) ||
           !IsOk(callArgsRes) || !IsOk(targetRes) ||
           !IsOk(targetSourceRes):
            continue
        let statementSource = parser.ParserNormalizePath(Value(sourceRes))
        let surfaceText = Value(surfaceRes)
        let callArgsText = Value(callArgsRes)
        if statementSource == sourcePath:
            if oracleAddressReferences(callArgsText, functionName) ||
               oracleSurfaceReferences(surfaceText, functionName) ||
               oracleSurfaceReferences(callArgsText, functionName):
                return true
        elif (oracleSurfaceReferences(surfaceText, functionName) ||
              oracleSurfaceReferences(callArgsText, functionName)) &&
             oracleUniqueSource(ir, functionTail) == sourcePath:
            return true
        if ir.statements2_callTargetImportcs[statementIndex]:
            continue
        let target = Value(targetRes)
        if target == "":
            continue
        var targetSource = Value(targetSourceRes)
        if targetSource == "":
            targetSource = Value(sourceRes)
        if parser.ParserNormalizePath(targetSource) != sourcePath:
            continue
        let targetTail = lower.LoweringFunctionTailName(target)
        if target == functionName || target == functionTail ||
           targetTail == functionName || targetTail == functionTail:
            return true
    for nodeIndex in 0..<ir.nodes2_nodeIndexs.len:
        if ir.nodes2_opKinds[nodeIndex] != texpr.TypedExprIrOpFuncRef:
            continue
        let sourceRes: Result[str] = langintern.LookupIntern(
            ir.internPool,
            ir.nodes2_sourcePathIds[nodeIndex])
        let literalRes: Result[str] = langintern.LookupIntern(
            ir.internPool,
            ir.nodes2_literalTextIds[nodeIndex])
        if !IsOk(sourceRes) || !IsOk(literalRes):
            continue
        if parser.ParserNormalizePath(Value(sourceRes)) != sourcePath:
            continue
        let literal = Value(literalRes)
        let literalTail = lower.LoweringFunctionTailName(literal)
        if literal == functionName || literal == functionTail ||
           literalTail == functionTail:
            return true
    return false

fn runSemanticOracleCase() =
    let sourceA = "/work/pkg/a.cheng"
    let sourceB = "/work/pkg/b.cheng"
    let sourceC = "/work/pkg/c.cheng"
    var plan: lower.LoweringPlanStub
    plan.workspaceRoot = "/work"
    plan.typedIr.internPool = langintern.InternPoolNew()
    appendFunction(plan, sourceA, "Caller", 1)
    appendFunction(plan, sourceA, "Direct", 2)
    appendFunction(plan, sourceA, "Address", 3)
    appendFunction(plan, sourceA, "NodeRef", 4)
    appendFunction(plan, sourceA, "SurfaceLocal", 5)
    appendFunction(plan, sourceB, "CrossSurface", 1)
    appendFunction(plan, sourceB, "Unused", 2)
    appendFunction(plan, sourceB, "CrossDirect", 3)
    appendFunction(plan, sourceC, "CrossDirect", 1)
    appendStatement(plan, sourceA, "Caller", "", "", "Direct", "")
    appendStatement(plan, sourceA, "Caller", "", "&Address", "", "")
    appendStatement(plan,
                    sourceA,
                    "Caller",
                    "Fmt\"{pkg.CrossSurface()}\"",
                    "",
                    "",
                    "")
    appendStatement(plan,
                    sourceA,
                    "Caller",
                    "SurfaceLocal()",
                    "",
                    "",
                    "")
    appendStatement(plan,
                    sourceA,
                    "Caller",
                    "CrossDirect()",
                    "",
                    "CrossDirect",
                    sourceB)
    appendFuncRef(plan, sourceA, "Caller", "NodeRef")
    var claimed: bool[]
    setLen(claimed, plan.typedIr.functions2_functionNameIds.len)
    claimed[0] = true
    var err: str
    assert(lower.LoweringBuildTypedFunctionReferenceIndex(plan, claimed, err),
           Fmt"function reference smoke: semantic build failed {err}")
    for functionIndex in 0..<plan.typedIr.functions2_functionNameIds.len:
        let sourceRes: Result[str] = langintern.LookupIntern(
            plan.typedIr.internPool,
            plan.typedIr.functions2_sourcePathIds[functionIndex])
        let nameRes: Result[str] = langintern.LookupIntern(
            plan.typedIr.internPool,
            plan.typedIr.functions2_functionNameIds[functionIndex])
        assert(IsOk(sourceRes) && IsOk(nameRes),
               " function reference smoke: oracle intern missing")
        let expected = oracleIsReferenced(plan.typedIr,
                                           Value(sourceRes),
                                           Value(nameRes))
        let actual = lower.LoweringPlanTypedFunctionIndexIsReferenced(
            plan,
            functionIndex)
        assert(actual == expected,
               Fmt"function reference smoke: semantic drift function={Value(nameRes)} expected={expected} actual={actual}")
    assert(plan.typedFunctionReferenceReferencedFunctionCount == 6 &&
           plan.typedFunctionReferenceDirectTargetCount >= 1 &&
           plan.typedFunctionReferenceFuncRefCount >= 1 &&
           plan.typedFunctionReferenceSurfaceCount >= 2 &&
           plan.typedFunctionReferenceAddressCount >= 1 &&
           plan.typedFunctionReferenceAmbiguousCount == 0 &&
           plan.typedFunctionReferenceCompositeKeyPayloadBytes == Int64(0),
           " function reference smoke: semantic counters invalid")
    lower.LoweringPlanReleaseAllPayload(plan)

fn runOverloadClaimCases() =
    let sourcePath = "/work/pkg/overload.cheng"
    var plan: lower.LoweringPlanStub
    plan.workspaceRoot = "/work"
    plan.typedIr.internPool = langintern.InternPoolNew()
    appendFunction(plan, sourcePath, "Caller", 1)
    appendFunction(plan, sourcePath, "Pick", 2)
    appendFunction(plan, sourcePath, "Pick", 3)
    appendStatement(plan, sourcePath, "Caller", "", "", "Pick", "")
    var claimed: bool[]
    setLen(claimed, 3)
    claimed[0] = true
    var err: str
    assert(lower.LoweringBuildTypedFunctionReferenceIndex(plan,
                                                           claimed,
                                                           err) &&
           lower.LoweringPlanTypedFunctionIndexIsReferenced(plan, 1) &&
           lower.LoweringPlanTypedFunctionIndexIsReferenced(plan, 2) &&
           plan.typedFunctionReferenceReferencedFunctionCount == 2 &&
           plan.typedFunctionReferenceAmbiguousCount == 0,
           Fmt"function reference smoke: unclaimed overload drift {err}")
    lower.LoweringPlanReleaseAllPayload(plan)

    var partialPlan: lower.LoweringPlanStub
    partialPlan.workspaceRoot = "/work"
    partialPlan.typedIr.internPool = langintern.InternPoolNew()
    appendFunction(partialPlan, sourcePath, "Caller", 1)
    appendFunction(partialPlan, sourcePath, "Pick", 2)
    appendFunction(partialPlan, sourcePath, "Pick", 3)
    appendStatement(partialPlan,
                    sourcePath,
                    "Caller",
                    "",
                    "",
                    "Pick",
                    "")
    var partialClaimed: bool[]
    setLen(partialClaimed, 3)
    partialClaimed[0] = true
    partialClaimed[1] = true
    err = ""
    assert(lower.LoweringBuildTypedFunctionReferenceIndex(partialPlan,
                                                           partialClaimed,
                                                           err) &&
           !lower.LoweringPlanTypedFunctionIndexIsReferenced(partialPlan, 1) &&
           lower.LoweringPlanTypedFunctionIndexIsReferenced(partialPlan, 2) &&
           partialPlan.typedFunctionReferenceReferencedFunctionCount == 1 &&
           partialPlan.typedFunctionReferenceAmbiguousCount == 0,
           Fmt"function reference smoke: partial claimed overload drift {err}")
    lower.LoweringPlanReleaseAllPayload(partialPlan)

    var allClaimedPlan: lower.LoweringPlanStub
    allClaimedPlan.workspaceRoot = "/work"
    allClaimedPlan.typedIr.internPool = langintern.InternPoolNew()
    appendFunction(allClaimedPlan, sourcePath, "Caller", 1)
    appendFunction(allClaimedPlan, sourcePath, "Pick", 2)
    appendFunction(allClaimedPlan, sourcePath, "Pick", 3)
    appendStatement(allClaimedPlan, sourcePath, "Caller", "", "", "Pick", "")
    var allClaimed: bool[]
    setLen(allClaimed, 3)
    allClaimed[0] = true
    allClaimed[1] = true
    allClaimed[2] = true
    err = ""
    assert(lower.LoweringBuildTypedFunctionReferenceIndex(allClaimedPlan,
                                                           allClaimed,
                                                           err) &&
           !lower.LoweringPlanTypedFunctionIndexIsReferenced(allClaimedPlan, 1) &&
           !lower.LoweringPlanTypedFunctionIndexIsReferenced(allClaimedPlan, 2) &&
           allClaimedPlan.typedFunctionReferenceReferencedFunctionCount == 0 &&
           allClaimedPlan.typedFunctionReferenceAmbiguousCount == 0,
           Fmt"function reference smoke: all claimed overload drift {err}")
    lower.LoweringPlanReleaseAllPayload(allClaimedPlan)

fn runQualifiedSurfaceCases() =
    let callerSource = "/work/pkg/caller.cheng"
    let sourceB = "/work/pkg/b.cheng"
    let sourceC = "/work/pkg/c.cheng"
    var uniquePlan: lower.LoweringPlanStub
    uniquePlan.workspaceRoot = "/work"
    uniquePlan.typedIr.internPool = langintern.InternPoolNew()
    appendFunction(uniquePlan, callerSource, "Caller", 1)
    appendFunction(uniquePlan, sourceB, "Nested", 1)
    appendFunction(uniquePlan, sourceB, "Nested", 2)
    appendStatement(uniquePlan,
                    callerSource,
                    "Caller",
                    "Fmt\"{pkg.Nested()}\"",
                    "",
                    "",
                    "")
    var uniqueClaimed: bool[]
    setLen(uniqueClaimed, 3)
    uniqueClaimed[0] = true
    var err: str
    assert(lower.LoweringBuildTypedFunctionReferenceIndex(uniquePlan,
                                                           uniqueClaimed,
                                                           err) &&
           lower.LoweringPlanTypedFunctionIndexIsReferenced(uniquePlan, 1) &&
           lower.LoweringPlanTypedFunctionIndexIsReferenced(uniquePlan, 2) &&
           uniquePlan.typedFunctionReferenceReferencedFunctionCount == 2,
           Fmt"function reference smoke: unique qualified overload drift {err}")
    lower.LoweringPlanReleaseAllPayload(uniquePlan)

    var duplicatePlan: lower.LoweringPlanStub
    duplicatePlan.workspaceRoot = "/work"
    duplicatePlan.typedIr.internPool = langintern.InternPoolNew()
    appendFunction(duplicatePlan, callerSource, "Caller", 1)
    appendFunction(duplicatePlan, sourceB, "Nested", 1)
    appendFunction(duplicatePlan, sourceC, "Nested", 1)
    appendStatement(duplicatePlan,
                    callerSource,
                    "Caller",
                    "Fmt\"{pkg.Nested()}\"",
                    "",
                    "",
                    "")
    var duplicateClaimed: bool[]
    setLen(duplicateClaimed, 3)
    duplicateClaimed[0] = true
    err = ""
    assert(lower.LoweringBuildTypedFunctionReferenceIndex(duplicatePlan,
                                                           duplicateClaimed,
                                                           err) &&
           !lower.LoweringPlanTypedFunctionIndexIsReferenced(duplicatePlan, 1) &&
           !lower.LoweringPlanTypedFunctionIndexIsReferenced(duplicatePlan, 2) &&
           duplicatePlan.typedFunctionReferenceReferencedFunctionCount == 0 &&
           duplicatePlan.typedFunctionReferenceAmbiguousCount == 0,
           Fmt"function reference smoke: cross-source qualified tail was not ignored {err}")
    lower.LoweringPlanReleaseAllPayload(duplicatePlan)

    var localPlan: lower.LoweringPlanStub
    localPlan.workspaceRoot = "/work"
    localPlan.typedIr.internPool = langintern.InternPoolNew()
    appendFunction(localPlan, callerSource, "Caller", 1)
    appendFunction(localPlan, callerSource, "Nested", 2)
    appendFunction(localPlan, callerSource, "Nested", 3)
    appendStatement(localPlan,
                    callerSource,
                    "Caller",
                    "Fmt\"{pkg.Nested()}\"",
                    "",
                    "",
                    "")
    var localClaimed: bool[]
    setLen(localClaimed, 3)
    localClaimed[0] = true
    err = ""
    assert(lower.LoweringBuildTypedFunctionReferenceIndex(localPlan,
                                                           localClaimed,
                                                           err) &&
           lower.LoweringPlanTypedFunctionIndexIsReferenced(localPlan, 1) &&
           lower.LoweringPlanTypedFunctionIndexIsReferenced(localPlan, 2),
           Fmt"function reference smoke: qualified local overload drift {err}")
    lower.LoweringPlanReleaseAllPayload(localPlan)

fn runLargeLinearCase() =
    let functionCount: int32 = 4096
    let sourcePath = "/work/pkg/reference_scale.cheng"
    var plan: lower.LoweringPlanStub
    plan.workspaceRoot = "/work"
    plan.typedIr.internPool = langintern.InternPoolNew()
    for functionIndex in 0..<functionCount:
        appendFunction(plan,
                       sourcePath,
                       Fmt"Ref{functionIndex}",
                       functionIndex + 1)
    for targetIndex in 1..<functionCount:
        appendStatement(plan,
                        sourcePath,
                        "Ref0",
                        "",
                        "",
                        Fmt"Ref{targetIndex}",
                        "")
    var nodeTarget: int32 = 1
    while nodeTarget < functionCount:
        appendFuncRef(plan,
                      sourcePath,
                      "Ref0",
                      Fmt"Ref{nodeTarget}")
        nodeTarget = nodeTarget + 4
    var claimed: bool[]
    setLen(claimed, functionCount)
    claimed[0] = true
    var err: str
    assert(lower.LoweringBuildTypedFunctionReferenceIndex(plan, claimed, err),
           Fmt"function reference smoke: large build failed {err}")
    let workCount = plan.typedFunctionReferenceBuildFunctionCount +
                    plan.typedFunctionReferenceBuildStatementCount +
                    plan.typedFunctionReferenceBuildNodeCount
    assert(plan.typedFunctionReferenceBuildFunctionCount == functionCount &&
           plan.typedFunctionReferenceBuildStatementCount == functionCount - 1 &&
           plan.typedFunctionReferenceReferencedFunctionCount == functionCount - 1 &&
           plan.typedFunctionReferenceBuildBucketVisitCount <= workCount * 16 &&
           plan.typedFunctionReferenceResolveBucketVisitCount <= workCount * 16 &&
           plan.typedFunctionReferenceResolveMaxBucketVisitCount <= 16 &&
           plan.typedFunctionReferencePeakCapacityEstimateBytes > Int64(0) &&
           plan.typedFunctionReferenceCompositeKeyPayloadBytes == Int64(0),
           Fmt"function reference smoke: non-linear counters work={workCount} build_visits={plan.typedFunctionReferenceBuildBucketVisitCount} lookup_visits={plan.typedFunctionReferenceResolveBucketVisitCount} max={plan.typedFunctionReferenceResolveMaxBucketVisitCount}")
    for functionIndex in 0..<functionCount:
        let expected = functionIndex != 0
        let actual = lower.LoweringPlanTypedFunctionIndexIsReferenced(
            plan,
            functionIndex)
        assert(actual == expected,
               Fmt"function reference smoke: large flag drift index={functionIndex} expected={expected} actual={actual}")
    assert(plan.typedFunctionReferenceFlagQueryCount == functionCount,
           " function reference smoke: flag lookup count drift")
    let buildFunctionCount = plan.typedFunctionReferenceBuildFunctionCount
    let resolveLookupCount = plan.typedFunctionReferenceResolveLookupCount
    let peakBytes = plan.typedFunctionReferencePeakCapacityEstimateBytes
    lower.LoweringPlanReleaseTypedFunctionReferenceIndexPayload(plan)
    assert(lower.LoweringTypedFunctionReferenceIndexRetainedItemCount(plan) == 0 &&
           lower.LoweringTypedFunctionReferenceIndexCapacityEstimateBytes(plan) == Int64(0) &&
           plan.typedFunctionReferenceIndexCompleted &&
           plan.typedFunctionReferenceBuildFunctionCount == buildFunctionCount &&
           plan.typedFunctionReferenceResolveLookupCount == resolveLookupCount &&
           plan.typedFunctionReferencePeakCapacityEstimateBytes == peakBytes,
           " function reference smoke: release lost counters or retained payload")
    lower.LoweringPlanReleaseAllPayload(plan)

fn runModuleSourceIndexCases() =
    let sourceCount: int32 = 2048
    var plan: lower.LoweringPlanStub
    plan.workspaceRoot = "/work"
    plan.packageRoot = "/work/pkg"
    var externalRoots: parser.ParserExternalPackageRoot[]
    var sourcePaths: str[]
    for sourceIndex in 0..<sourceCount:
        add(sourcePaths, Fmt"/work/pkg/module_{sourceIndex}.cheng")
    var err: str
    assert(lower.LoweringBuildModuleSourceIndex(plan,
                                                externalRoots,
                                                sourcePaths,
                                                err),
           Fmt"function reference smoke: module index build failed {err}")
    for sourceIndex in 0..<sourceCount:
        let sourcePath = sourcePaths[sourceIndex]
        let modulePath =
            parser.ParserSourcePathToModulePathWithExternalPackageRoots(
                plan.workspaceRoot,
                plan.packageRoot,
                externalRoots,
                sourcePath)
        var actualSourcePath: str
        err = ""
        assert(lower.LoweringModuleSourceIndexLookup(plan,
                                                      modulePath,
                                                      actualSourcePath,
                                                      err) &&
               actualSourcePath == parser.ParserNormalizePath(sourcePath),
               Fmt"function reference smoke: module lookup drift module={modulePath} actual={actualSourcePath} err={err}")
    assert(plan.moduleSourceIndexBuildSourceCount == sourceCount &&
           plan.moduleSourceIndexSourceCountSnapshot == sourceCount &&
           plan.moduleSourceIndexBuildBucketVisitCount <= sourceCount * 8 &&
           plan.moduleSourceIndexLookupCount == sourceCount &&
           plan.moduleSourceIndexLookupBucketVisitCount <= sourceCount * 8 &&
           plan.moduleSourceIndexLookupMaxBucketVisitCount <= 16 &&
           plan.moduleSourceIndexDuplicateModuleCount == 0 &&
           plan.moduleSourceIndexCompositeKeyPayloadBytes == Int64(0) &&
           plan.moduleSourceIndexPeakCapacityEstimateBytes > Int64(0),
           Fmt"function reference smoke: module index non-linear build={plan.moduleSourceIndexBuildBucketVisitCount} lookup={plan.moduleSourceIndexLookupBucketVisitCount} max={plan.moduleSourceIndexLookupMaxBucketVisitCount}")
    let modulePeakBytes = plan.moduleSourceIndexPeakCapacityEstimateBytes
    lower.LoweringPlanReleaseModuleSourceIndexPayload(plan)
    assert(lower.LoweringModuleSourceIndexRetainedItemCount(plan) == 0 &&
           lower.LoweringModuleSourceIndexCapacityEstimateBytes(plan) == Int64(0) &&
           plan.moduleSourceIndexCompleted &&
           plan.moduleSourceIndexPeakCapacityEstimateBytes == modulePeakBytes,
           " function reference smoke: module index release drift")
    lower.LoweringPlanReleaseAllPayload(plan)

    var duplicatePlan: lower.LoweringPlanStub
    duplicatePlan.workspaceRoot = "/work"
    duplicatePlan.packageRoot = "/work/pkg"
    var duplicatePaths: str[]
    add(duplicatePaths, "/work/pkg/duplicate.cheng")
    add(duplicatePaths, "/work/pkg/duplicate.cheng")
    err = ""
    assert(!lower.LoweringBuildModuleSourceIndex(duplicatePlan,
                                                  externalRoots,
                                                  duplicatePaths,
                                                  err) &&
           strutil.Contains(err, "duplicate module source identity") &&
           duplicatePlan.moduleSourceIndexDuplicateModuleCount == 1 &&
           lower.LoweringModuleSourceIndexRetainedItemCount(duplicatePlan) == 0,
           Fmt"function reference smoke: duplicate module accepted {err}")
    lower.LoweringPlanReleaseAllPayload(duplicatePlan)

fn runTypedFunctionIndexLinearCase() =
    let functionCount: int32 = 4096
    let split: int32 = 2048
    let sharedSource = "/work/pkg/same_length.cheng"
    var plan: lower.LoweringPlanStub
    plan.workspaceRoot = "/work"
    plan.entryPath = "/work/pkg/source_0.cheng"
    plan.entrySymbol = "Unique"
    plan.typedIr.internPool = langintern.InternPoolNew()
    for functionIndex in 0..<split:
        appendFunction(plan,
                       Fmt"/work/pkg/source_{functionIndex}.cheng",
                       "Unique",
                       1)
    for functionIndex in split..<functionCount:
        appendFunction(plan,
                       sharedSource,
                       Fmt"SameLen{100000 + functionIndex}",
                       functionIndex - split + 1)
    lower.LoweringBuildTypedFunctionIndex(plan)
    assert(plan.typedFunctionIndexBuilt &&
           plan.typedFunctionIndexCompleted &&
           plan.typedFunctionIndexBuildFunctionCount == functionCount &&
           plan.typedFunctionIndexBuildSourceCount == split + 1 &&
           plan.typedFunctionIndexSourceCountSnapshot == split + 1 &&
           plan.typedFunctionIndexEntryCountSnapshot == functionCount &&
           plan.typedFunctionIndexBuildBucketVisitCount <= functionCount * 16 &&
           plan.typedFunctionIndexCompositeKeyPayloadBytes == Int64(0) &&
           plan.typedFunctionIndexPeakSidecarCapacityEstimateBytes > Int64(0) &&
           lower.LoweringTypedFunctionDenseStoreFunctionCount(plan) == functionCount,
           Fmt"function reference smoke: typed function index build non-linear sources={plan.typedFunctionIndexBuildSourceCount} visits={plan.typedFunctionIndexBuildBucketVisitCount}")
    for functionIndex in 0..<split:
        let sourcePath = Fmt"/work/pkg/source_{functionIndex}.cheng"
        let actual = lower.LoweringTypedFunctionIndexLookup(plan,
                                                             sourcePath,
                                                             "Unique")
        assert(actual == functionIndex,
               Fmt"function reference smoke: typed source lookup drift expected={functionIndex} actual={actual}")
    for functionIndex in split..<functionCount:
        let functionName = Fmt"SameLen{100000 + functionIndex}"
        let actual = lower.LoweringTypedFunctionIndexLookup(plan,
                                                             sharedSource,
                                                             functionName)
        assert(actual == functionIndex,
               Fmt"function reference smoke: typed name lookup drift expected={functionIndex} actual={actual}")
    assert(plan.typedFunctionIndexLookupCount == functionCount &&
           plan.typedFunctionIndexLookupBucketVisitCount <= functionCount * 16 &&
           plan.typedFunctionIndexLookupMaxBucketVisitCount <= 32,
           Fmt"function reference smoke: typed function lookup non-linear count={plan.typedFunctionIndexLookupCount} visits={plan.typedFunctionIndexLookupBucketVisitCount} max={plan.typedFunctionIndexLookupMaxBucketVisitCount}")
    let typedIndexPeakBytes =
        plan.typedFunctionIndexPeakSidecarCapacityEstimateBytes
    let denseStoreFunctionCount =
        lower.LoweringTypedFunctionDenseStoreFunctionCount(plan)
    lower.LoweringPlanReleaseTypedFunctionLookupSidecarPayload(plan)
    assert(lower.LoweringTypedFunctionLookupSidecarRetainedItemCount(plan) == 0 &&
           lower.LoweringTypedFunctionLookupSidecarCapacityEstimateBytes(plan) == Int64(0) &&
           lower.LoweringTypedFunctionDenseStoreFunctionCount(plan) == denseStoreFunctionCount &&
           plan.typedFunctionIndexCompleted &&
           plan.typedFunctionIndexPeakSidecarCapacityEstimateBytes == typedIndexPeakBytes,
           " function reference smoke: typed function lookup sidecar release drift")
    lower.LoweringPlanReleaseAllPayload(plan)
    assert(lower.LoweringTypedFunctionDenseStoreFunctionCount(plan) == 0,
           " function reference smoke: terminal dense store release drift")

fn runTypedFunctionPathEquivalenceCases() =
    var plan: lower.LoweringPlanStub
    plan.workspaceRoot = "/work"
    plan.entryPath = "pkg/local.cheng"
    plan.entrySymbol = "RelativeLocal"
    plan.typedIr.internPool = langintern.InternPoolNew()
    appendFunction(plan, "pkg/local.cheng", "RelativeLocal", 1)
    appendFunction(plan,
                   "/external/vendor/pkg/external.cheng",
                   "External",
                   1)
    appendFunction(plan, "/root_a/pkg/same.cheng", "Shared", 1)
    appendFunction(plan, "/root_b/other/same.cheng", "Shared", 1)
    appendFunction(plan, "/root_c/pkg/same.cheng", "Shared", 1)
    lower.LoweringBuildTypedFunctionIndex(plan)
    assert(lower.LoweringTypedFunctionIndexLookup(
               plan,
               "/alternate/pkg/local.cheng",
               "RelativeLocal") == 0,
           " function reference smoke: absolute query did not match relative source suffix")
    assert(lower.LoweringTypedFunctionIndexLookup(
               plan,
               "pkg/external.cheng",
               "External") == 1,
           " function reference smoke: relative query did not match external absolute source")
    assert(lower.LoweringTypedFunctionIndexLookup(
               plan,
               "/outside/pkg/external.cheng",
               "External") == -1,
           " function reference smoke: unequal absolute roots were conflated")
    assert(lower.LoweringTypedFunctionIndexLookup(
               plan,
               "pkg/same.cheng",
               "Shared") == 2,
           " function reference smoke: suffix-equivalent sources lost stable first-row semantics")
    assert(lower.LoweringTypedFunctionIndexLookup(
               plan,
               "other/same.cheng",
               "Shared") == 3,
           " function reference smoke: same basename crossed directory boundary")
    assert(lower.LoweringTypedFunctionIndexLookup(
               plan,
               "/root_c/pkg/same.cheng",
               "Shared") == 4,
           " function reference smoke: exact absolute source lookup drift")
    assert(lower.LoweringTypedFunctionIndexLookup(
               plan,
               "missing/same.cheng",
               "Shared") == -1,
           " function reference smoke: basename-only fallback reappeared")
    lower.LoweringPlanReleaseAllPayload(plan)

fn appendExportFunction(plan: var lower.LoweringPlanStub,
                        functionName: str,
                        symbolText: str,
                        exportedFlag: int32,
                        exportName: str) =
    add(plan.functionNames, functionName)
    add(plan.functionSymbolTexts, symbolText)
    add(plan.functionExportedFlags, exportedFlag)
    add(plan.functionExportSymbolNames, exportName)

fn runExportRootIndexCases() =
    let functionCount: int32 = 4096
    var plan: lower.LoweringPlanStub
    for functionIndex in 0..<functionCount:
        appendExportFunction(plan,
                             Fmt"Root{functionIndex}",
                             Fmt"pkg::Root{functionIndex}",
                             0,
                             "")
    var index: lower.LoweringExportRootIndex
    var err: str
    assert(lower.LoweringBuildExportRootIndex(plan, index, err),
           Fmt"function reference smoke: export root index build failed {err}")
    for functionIndex in 0..<functionCount:
        let actual = lower.LoweringExportRootIndexLookup(
            index,
            Fmt"Root{functionIndex}")
        assert(actual == functionIndex,
               Fmt"function reference smoke: export root lookup drift expected={functionIndex} actual={actual}")
    assert(index.buildFunctionCount == functionCount &&
           index.lookupCount == functionCount &&
           index.buildBucketVisitCount <= functionCount * 64 &&
           index.lookupBucketVisitCount <= functionCount * 32 &&
           index.lookupCandidateVisitCount <= functionCount * 4 &&
           index.lookupMaxBucketVisitCount <= 32 &&
           index.peakCapacityEstimateBytes > Int64(0),
           Fmt"function reference smoke: export root index non-linear build={index.buildBucketVisitCount} lookup={index.lookupBucketVisitCount} candidates={index.lookupCandidateVisitCount} max={index.lookupMaxBucketVisitCount}")
    let peakBytes = index.peakCapacityEstimateBytes
    lower.LoweringExportRootIndexReleasePayload(index)
    assert(lower.LoweringExportRootIndexRetainedItemCount(index) == 0 &&
           lower.LoweringExportRootIndexCapacityEstimateBytes(index) == Int64(0) &&
           index.completed &&
           index.peakCapacityEstimateBytes == peakBytes,
           " function reference smoke: export root index release drift")
    lower.LoweringPlanReleaseAllPayload(plan)

    var priorityPlan: lower.LoweringPlanStub
    appendExportFunction(priorityPlan, "Alias", "pkg::Alias", 1, "Chosen")
    appendExportFunction(priorityPlan, "Chosen", "pkg::Chosen", 0, "")
    var priorityIndex: lower.LoweringExportRootIndex
    err = ""
    assert(lower.LoweringBuildExportRootIndex(priorityPlan,
                                              priorityIndex,
                                              err) &&
           lower.LoweringExportRootIndexLookup(priorityIndex, "Chosen") == 0,
           Fmt"function reference smoke: exact export priority drift {err}")
    lower.LoweringExportRootIndexReleasePayload(priorityIndex)
    lower.LoweringPlanReleaseAllPayload(priorityPlan)

    var ambiguousPlan: lower.LoweringPlanStub
    appendExportFunction(ambiguousPlan, "Over", "a::Over", 0, "")
    appendExportFunction(ambiguousPlan, "Over", "b::Over", 0, "")
    var ambiguousIndex: lower.LoweringExportRootIndex
    err = ""
    assert(lower.LoweringBuildExportRootIndex(ambiguousPlan,
                                              ambiguousIndex,
                                              err) &&
           lower.LoweringExportRootIndexLookup(ambiguousIndex, "Over") == -2,
           Fmt"function reference smoke: export root overload ambiguity drift {err}")
    lower.LoweringExportRootIndexReleasePayload(ambiguousIndex)
    lower.LoweringPlanReleaseAllPayload(ambiguousPlan)

    var duplicateExportPlan: lower.LoweringPlanStub
    appendExportFunction(duplicateExportPlan, "One", "a::One", 1, "Dup")
    appendExportFunction(duplicateExportPlan, "Two", "b::Two", 1, "Dup")
    var duplicateExportIndex: lower.LoweringExportRootIndex
    err = ""
    assert(lower.LoweringBuildExportRootIndex(duplicateExportPlan,
                                              duplicateExportIndex,
                                              err) &&
           lower.LoweringExportRootIndexLookup(duplicateExportIndex, "Dup") == -2,
           Fmt"function reference smoke: duplicate exact export ambiguity drift {err}")
    lower.LoweringExportRootIndexReleasePayload(duplicateExportIndex)
    lower.LoweringPlanReleaseAllPayload(duplicateExportPlan)

    var underscorePlan: lower.LoweringPlanStub
    appendExportFunction(underscorePlan, "__Needle", "pkg::__Needle", 0, "")
    var underscoreIndex: lower.LoweringExportRootIndex
    err = ""
    assert(lower.LoweringBuildExportRootIndex(underscorePlan,
                                              underscoreIndex,
                                              err) &&
           lower.LoweringExportRootIndexLookup(underscoreIndex, "_Needle") == 0,
           Fmt"function reference smoke: leading underscore equivalence drift {err}")
    lower.LoweringExportRootIndexReleasePayload(underscoreIndex)
    lower.LoweringPlanReleaseAllPayload(underscorePlan)

fn main(): int32 =
    runSemanticOracleCase()
    runOverloadClaimCases()
    runQualifiedSurfaceCases()
    runLargeLinearCase()
    runModuleSourceIndexCases()
    runTypedFunctionIndexLinearCase()
    runTypedFunctionPathEquivalenceCases()
    runExportRootIndexCases()
    echo("lowering_function_reference_index_smoke=ok")
    return 0
