type
    ColdVarRefBorrowedCell = ref object
        value: int32

    ColdVarRefBorrowedBox = ref object
        cell: ColdVarRefBorrowedCell

fn ColdVarRefBorrowedRebind(target: var ColdVarRefBorrowedCell) =
    target = new(ColdVarRefBorrowedCell)

fn main(): int32 =
    let box = new(ColdVarRefBorrowedBox)
    box.cell = new(ColdVarRefBorrowedCell)
    var target = box.cell
    ColdVarRefBorrowedRebind(target)
    return 0
