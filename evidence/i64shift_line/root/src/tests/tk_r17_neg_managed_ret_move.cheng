# R17 negative control (same family, TRUE violation): a resource-bearing value
# object is moved into a global and then read again. Must stay rejected.
import std/system

type
    R17NBundle =
        tag: str
        n: int32

var tkR17NGlobal: R17NBundle

fn TkR17NMove(m: R17NBundle): int32 =
    tkR17NGlobal = m
    return m.n

fn main(): int32 =
    var b: R17NBundle
    b.tag = "hello"
    b.n = 3
    if TkR17NMove(b) != 3:
        return 10
    echo("tk_r17_neg unexpected")
    return 0
