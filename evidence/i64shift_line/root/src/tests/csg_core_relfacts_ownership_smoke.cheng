import std/os as os
import cheng/core/csg_core/relfacts

fn main(): int32 =
    var facts: str[]
    let profiles = ["csg_core"]
    let replay =
        relfacts.CsgCoreRelfactsReplayCanonicalTransition(
            "",
            facts,
            facts,
            "csg_core::v1",
            profiles,
            "csg_core::v1",
            "sha256:1111111111111111111111111111111111111111111111111111111111111111",
            "csg_core::v1",
            profiles,
            "csg_core::v1",
            "sha256:1111111111111111111111111111111111111111111111111111111111111111")
    if replay.ok:
        os.WriteLine(
            os.Get_stderr(),
            "relfacts empty replay unexpectedly passed")
        return 1
    os.WriteLine(
        os.Get_stdout(),
        "csg_core_relfacts_ownership_smoke ok")
    return 0
