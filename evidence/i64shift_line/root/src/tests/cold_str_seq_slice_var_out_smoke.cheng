import std/strings

fn SliceIdentityArg(args: str[], prefix: str, out: var str): bool =
    for index in 0..<args.len:
        if strings.HasPrefix(args[index], prefix):
            out = args[index][prefix.len..<args[index].len]
            return true
    return false

fn main(): int32 =
    let args = ["--identity=1111111111111111111111111111111111111111111111111111111111111111"]
    var value: str
    if !SliceIdentityArg(args, "--identity=", value):
        return 1
    if value.len != 64:
        return 2
    if value != "1111111111111111111111111111111111111111111111111111111111111111":
        return 3
    return 0
