# checkpoint smoke: median-of-last-K timestamp rule, checkpoint digest
# binding, certificate verification, and binding-tamper rejection.

import std/os
import std/system
import std/rawbytes
import std/strutils as strutil
import cheng/std/bytes_layout as layout
import cheng/chain/committee_vote as cvt
import cheng/chain/finality_certificate as fcert
import cheng/chain/checkpoint as ckpt

fn main(): int32 =
    var rc: int32 = 0

    # --- median-of-last-K ---
    var win: int64[]
    add(win, Int64(1))
    add(win, Int64(5))
    add(win, Int64(9))
    add(win, Int64(3))
    add(win, Int64(7))
    let m5 = ckpt.MedianOfLastK(win, 5)
    if !m5.ok or m5.value != 5:
        os.WriteLine(os.Get_stderr(), "median of {1,5,9,3,7} wrong")
        rc = rc + 1
    # k=2 takes the LAST two entries {3,7}; ascending order -> [3,7];
    # upper-middle (index k/2) = 7.
    let m2 = ckpt.MedianOfLastK(win, 2)
    if !m2.ok or m2.value != 7:
        os.WriteLine(os.Get_stderr(), "median upper-middle rule violated for k=2")
        rc = rc + 1
    let m1 = ckpt.MedianOfLastK(win, 1)
    if !m1.ok or m1.value != 7:
        os.WriteLine(os.Get_stderr(), "median k=1 must be the last entry")
        rc = rc + 1

    # manipulation immunity: one wild spike does not move the median
    var spiky: int64[]
    add(spiky, Int64(100))
    add(spiky, Int64(100))
    add(spiky, Int64(1000000))
    let ms = ckpt.MedianOfLastK(spiky, 3)
    if !ms.ok or ms.value != 100:
        os.WriteLine(os.Get_stderr(), "spike moved the median")
        rc = rc + 1

    # window smaller than k rejected loudly
    let small = ckpt.MedianOfLastK(win, 9)
    if small.ok:
        os.WriteLine(os.Get_stderr(), "window overrun accepted")
        rc = rc + 1

    # --- checkpoint binding and certificate ---
    let sk0 = BytesFromHex("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
    let sk1 = BytesFromHex("4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb")
    let sk2 = BytesFromHex("c5aa8df43f9f837bedb7442f31dcb7b166d38535076f094b85ce3a2e0b4458f7")
    let sk3 = BytesFromHex("3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c")

    var members: cvt.CommitteeMember[]
    var d0 = cvt.CommitteeDraw(sk0, 25, 100, 12, 1)
    var d1 = cvt.CommitteeDraw(sk1, 25, 100, 12, 1)
    var d2 = cvt.CommitteeDraw(sk2, 25, 100, 12, 1)
    var d3 = cvt.CommitteeDraw(sk3, 25, 100, 12, 1)
    add(members, d0.value)
    add(members, d1.value)
    add(members, d2.value)
    add(members, d3.value)

    var commitHash = CkptTag(11)
    var stateHash = CkptTag(22)
    let epoch: int32 = 12
    let digest = ckpt.CheckpointDigest(commitHash, stateHash)

    # all members sign the checkpoint digest as a proposal hash
    var votes: cvt.SignedVote[]
    var pks: Bytes[]
    var i: int32
    while i < members.len:
        let vres = cvt.CommitteeSignVote(members[i], digest)
        if vres.ok:
            add(votes, vres.value)
            add(pks, members[i].pk)
        i = i + 1

    let certRes = fcert.FcertCreate(digest, epoch, 1,
                                    CkptVotesPks(votes), CkptVotesSigs(votes))
    if !certRes.ok:
        os.WriteLine(os.Get_stderr(), "cert create failed")
        rc = rc + 1
    else:
        # binding holds -> certificate verifies
        if !ckpt.CheckpointVerifyBinding(certRes.value.proposalHash, commitHash, stateHash):
            os.WriteLine(os.Get_stderr(), "binding failed on honest hashes")
            rc = rc + 1
        let vf = fcert.FcertVerify(certRes.value, pks, 1)
        if !vf.ok:
            os.WriteLine(os.Get_stderr(), "valid checkpoint rejected")
            rc = rc + 1

        # tamper state hash by one bit -> binding breaks even with a valid cert
        var badState = CkptTag(22)
        let bsBytes = layout.FixedBytes32ToBytes(badState)
        BytesSet(bsBytes, 5, (BytesGet(bsBytes, 5) + 1) % 256)
        let badRebuild = layout.FixedBytes32FromBytes(bsBytes)
        if badRebuild.ok:
            if ckpt.CheckpointVerifyBinding(certRes.value.proposalHash, commitHash, badRebuild.value):
                os.WriteLine(os.Get_stderr(), "tampered state hash still binds")
                rc = rc + 1

    # under-voted certificate must fail quorum (f=1 needs 3 votes)
    var twoPks: Bytes[]
    var twoSigs: Bytes[]
    if votes.len >= 2:
        add(twoPks, votes[0].voterPk)
        add(twoPks, votes[1].voterPk)
        add(twoSigs, votes[0].sig)
        add(twoSigs, votes[1].sig)
        let thinCert = fcert.FcertCreate(digest, epoch, 1, twoPks, twoSigs)
        if thinCert.ok:
            let vfThin = fcert.FcertVerify(thinCert.value, pks, 1)
            if vfThin.ok:
                os.WriteLine(os.Get_stderr(), "under-voted checkpoint accepted")
                rc = rc + 1

    if rc == 0:
        echo("checkpoint_smoke ok")
    return rc

fn CkptTag(b: int32): layout.FixedBytes32 =
    var raw = BytesAlloc(32)
    BytesSet(raw, 0, b)
    let res = layout.FixedBytes32FromBytes(raw)
    return res.value

@borrows
fn CkptVotesPks(votes: cvt.SignedVote[]): Bytes[] =
    var outP: Bytes[]
    var i: int32
    while i < votes.len:
        add(outP, votes[i].voterPk)
        i = i + 1
    return outP

@borrows
fn CkptVotesSigs(votes: cvt.SignedVote[]): Bytes[] =
    var outS: Bytes[]
    var i: int32
    while i < votes.len:
        add(outS, votes[i].sig)
        i = i + 1
    return outS
