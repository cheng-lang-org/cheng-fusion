import std/os
import std/rawbytes as rawbytes
import std/result
import std/strings
import std/strformat
import cheng/core/tooling/seven_stage_receipt as receipt
import cheng/std/bytes_layout as layout

fn Observe(stage: str,
           lane: str,
           identity: var receipt.SevenStageSourceIdentity,
           suffix: str): bool =
    return receipt.SevenStageReceiptObserve(
        stage,
        lane,
        identity,
        "src/tests/seven_stage_receipt_failstop_smoke.cheng",
        rawbytes.BytesFromString(Fmt"sidecar:{stage}:{suffix}"),
        rawbytes.BytesFromString(Fmt"artifact:{stage}:{suffix}"))

fn ObserveObject(stage: str,
                 lane: str,
                 identity: var receipt.SevenStageSourceIdentity): bool =
    return receipt.SevenStageReceiptObserve(
        stage,
        lane,
        identity,
        "src/tests/seven_stage_receipt_failstop_smoke.cheng",
        rawbytes.BytesFromString(Fmt"object-sidecar:{stage}"),
        rawbytes.BytesFromString(
            "MACHO_HEADER_BYTES|TEXT_SECTION_BYTES|RELOCATION_BYTES|SYMBOL_BYTES"))

fn DeletePendingObjectByte(mode: str) =
    let outputRoot = os.GetEnv("SEVEN_STAGE_TEST_OUT")
    if outputRoot == "":
        panic("seven-stage receipt: mutation output root missing")
    let original =
        "MACHO_HEADER_BYTES|TEXT_SECTION_BYTES|RELOCATION_BYTES|SYMBOL_BYTES"
    var deleteOffset: int32
    if mode == "delete_header_byte":
        deleteOffset = 2
    elif mode == "delete_section_byte":
        deleteOffset = 25
    elif mode == "delete_reloc_byte":
        deleteOffset = 43
    else:
        return
    let mutated = Fmt"{strings.SliceBytes(original, 0, deleteOffset)}{strings.SliceBytes(original, deleteOffset + 1, len(original) - deleteOffset - 1)}"
    os.WriteFile(
        Fmt"{outputRoot}/stages/6-backend2.artifact.bin",
        mutated)

fn main() =
    if receipt.SevenStageReceiptEnabled():
        let configErr = receipt.SevenStageReceiptValidateConfig(
            os.GetCurrentDir(), "arm64-apple-darwin", 1)
        if configErr != "":
            panic(configErr)
        let sourceBundleCid =
            "1111111111111111111111111111111111111111111111111111111111111111"
        var identity =
            receipt.SevenStageSourceIdentityResolve(sourceBundleCid)
        if !identity.valid:
            panic("seven-stage receipt: configured identity unavailable")
        if !Observe(receipt.SevenStageReceiptStageTypedExpr,
                    receipt.SevenStageReceiptLaneShared,
                    identity,
                    "one") ||
           !Observe(receipt.SevenStageReceiptStageCsg,
                    receipt.SevenStageReceiptLaneShared,
                    identity,
                    "two") ||
           !Observe(receipt.SevenStageReceiptStageLowering,
                    receipt.SevenStageReceiptLaneShared,
                    identity,
                    "three"):
            panic("seven-stage receipt: shared stages rejected")
        let mode = os.GetEnv("SEVEN_STAGE_TEST_MODE")
        if mode == "identity_drift":
            var wrongIdentity: receipt.SevenStageSourceIdentity
            wrongIdentity.valid = identity.valid
            wrongIdentity.executionRaw32 = identity.executionRaw32
            let wrongSourceBundleCidRes =
                layout.FixedBytes32FromHex(
                "2222222222222222222222222222222222222222222222222222222222222222"
                )
            if IsErr(wrongSourceBundleCidRes):
                panic("seven-stage receipt: wrong identity fixture invalid")
            wrongIdentity.sourceBundleCidRaw32 =
                Value(wrongSourceBundleCidRes)
            if Observe(receipt.SevenStageReceiptStageBackend2,
                       receipt.SevenStageReceiptLaneBackend2,
                       wrongIdentity,
                       "wrong"):
                panic("seven-stage receipt: identity drift accepted")
            os.WriteLine(os.GetStdout(),
                         "SEVEN_STAGE_RECEIPT_IDENTITY_DRIFT_REJECTED")
            return
        if !ObserveObject(receipt.SevenStageReceiptStageBackend2,
                          receipt.SevenStageReceiptLaneBackend2,
                          identity):
            panic("seven-stage receipt: backend2 stage rejected")
        if mode != "second_lane_failure":
            if !ObserveObject(
                   receipt.SevenStageReceiptStageBackend2Regalloc,
                   receipt.SevenStageReceiptLaneBackend2,
                   identity):
                panic("seven-stage receipt: backend2 regalloc rejected")
        DeletePendingObjectByte(mode)
        if !ObserveObject(receipt.SevenStageReceiptStagePrimary,
                          receipt.SevenStageReceiptLanePrimary,
                          identity):
            panic("seven-stage receipt: primary stage rejected")
        let primaryRegallocOk =
            ObserveObject(receipt.SevenStageReceiptStagePrimaryRegalloc,
                          receipt.SevenStageReceiptLanePrimary,
                          identity)
        if mode == "second_lane_failure":
            if primaryRegallocOk ||
               receipt.SevenStageReceiptFinalize() == "":
                panic("seven-stage receipt: incomplete second lane committed")
            os.WriteLine(os.GetStdout(),
                         "SEVEN_STAGE_RECEIPT_SECOND_LANE_FAILURE_REJECTED")
            return
        if mode == "delete_header_byte" ||
           mode == "delete_section_byte" ||
           mode == "delete_reloc_byte":
            if primaryRegallocOk ||
               receipt.SevenStageReceiptFinalize() == "":
                panic("seven-stage receipt: object byte deletion committed")
            os.WriteLine(
                os.GetStdout(),
                "SEVEN_STAGE_RECEIPT_OBJECT_BYTE_DELETION_REJECTED")
            return
        if !primaryRegallocOk:
            panic("seven-stage receipt: primary regalloc rejected")
        let finalizeErr = receipt.SevenStageReceiptFinalize()
        if finalizeErr != "":
            panic(finalizeErr)
        os.WriteLine(os.GetStdout(),
                     "SEVEN_STAGE_RECEIPT_SEVEN_OBSERVED_OK")
        return
    if receipt.SevenStageReceiptActive():
        panic("seven-stage receipt: unconfigured collector is active")
    var identity: receipt.SevenStageSourceIdentity
    if receipt.SevenStageReceiptObserve(
           receipt.SevenStageReceiptStageTypedExpr,
           receipt.SevenStageReceiptLaneShared,
           identity,
           "src/core/backend/lowering_plan.cheng",
           rawbytes.BytesFromString("sidecar"),
           rawbytes.BytesFromString("artifact")):
        panic("seven-stage receipt: unconfigured observation accepted")
    if receipt.SevenStageReceiptFinalize() != "":
        panic("seven-stage receipt: disabled finalize changed compilation")
    os.WriteLine(os.GetStdout(), "SEVEN_STAGE_RECEIPT_COLLECTOR_OK")
