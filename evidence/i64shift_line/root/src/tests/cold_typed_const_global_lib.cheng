const
    typedConstF64 = -10.0
    typedConstF32: float32 = 1.0
    typedConstI64: int64 = 4294967297
    typedHexI64: int64 = 0xffffffff
    typedShiftI32: int32 = 1 << 20
    typedShiftI64: int64 = int64(1) << 32
    typedUint32Max: uint32 = uint32(4294967295)
    typedCharSlash: char = '/'
    typedPrecedence: int32 = 1 + 2 * 3

var
    typedGlobalF64: float64 = typedConstF64
    typedGlobalF32: float32 = typedConstF32
    typedGlobalI64: int64 = typedConstI64

fn TypedGlobalF64(): float64 =
    return typedGlobalF64

fn TypedGlobalF32(): float32 =
    return typedGlobalF32

fn TypedGlobalI64(): int64 =
    return typedGlobalI64

fn TypedHexI64(): int64 =
    return typedHexI64

fn TypedShiftI32(): int32 =
    return typedShiftI32

fn TypedShiftI64(): int64 =
    return typedShiftI64

fn TypedUint32Max(): uint32 =
    return typedUint32Max

fn TypedCharSlash(): char =
    return typedCharSlash

fn TypedPrecedence(): int32 =
    return typedPrecedence

fn TypedGlobalSetF64(value: float64) =
    typedGlobalF64 = value

fn TypedGlobalSetF32(value: float32) =
    typedGlobalF32 = value

fn TypedGlobalSetI64(value: int64) =
    typedGlobalI64 = value

fn TypedGlobalReset() =
    typedGlobalF64 = typedConstF64
    typedGlobalF32 = typedConstF32
    typedGlobalI64 = typedConstI64
