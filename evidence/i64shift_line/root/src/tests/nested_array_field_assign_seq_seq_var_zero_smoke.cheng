# shape: two-level nested seq, tail field scalar, variable indices.
# Grid.rows[i].cols[j].a = v
type
    Col =
        a: int32
        b: int32

type
    Row =
        cols: Col[]

type
    Grid =
        rows: Row[]

fn main(): int32 =
    var g: Grid
    var r0: Row
    var c00: Col
    c00.a = 1
    c00.b = 11
    add(r0.cols, c00)
    var c01: Col
    c01.a = 2
    c01.b = 22
    add(r0.cols, c01)
    add(g.rows, r0)

    var r1: Row
    var c10: Col
    c10.a = 3
    c10.b = 33
    add(r1.cols, c10)
    var c11: Col
    c11.a = 4
    c11.b = 44
    add(r1.cols, c11)
    add(g.rows, r1)

    var i: int32
    var j: int32 = 1
    g.rows[i].cols[j].a = 999

    if g.rows[0].cols[1].a != 999:
        return 1
    if g.rows[0].cols[1].b != 22:
        return 2
    if g.rows[0].cols[0].a != 1:
        return 3
    if g.rows[1].cols[0].a != 3:
        return 4
    if g.rows[1].cols[1].a != 4:
        return 5
    return 0
