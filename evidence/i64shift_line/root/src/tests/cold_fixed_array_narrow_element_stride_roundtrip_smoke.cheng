# #133 v2 regression lock: v1 narrowed the fixed-array element SIZE TABLE
# (int16/uint16 -> 2 bytes/element, bool -> 1 byte/element, cold_fixed_array_
# element_size) but left the element STORE/READ codegen on its pre-#133
# {1-byte, 4-byte} two-way split (cold_emit_fixed_array_element_store's
# `element_size <= 4` early-out, BODY_OP_ARRAY_I32_INDEX_{STORE,DYNAMIC}'s
# codegen, and the constant-index BODY_OP_PAYLOAD_LOAD emission in
# parse_postfix). A 2-byte element silently fell back to a 4-byte store/load
# stride while the size table (and hence every other element's byte offset)
# had already moved to 2 -- so writing element[0] stomped element[1], and a
# `bool[N]` (1-byte per the #133 sizer, but never matched by the codegen's
# literal "uint8[" text-prefix predicate) had the same problem. This smoke
# exercises constant-index AND loop/dynamic-index writes+reads, on both bare
# local arrays and struct fields, and asserts a neighboring stack variable /
# neighboring array element is never stomped by a narrow-element store.
type
    NarrowRoundTripRec =
        lead: uint8
        vals: uint16[3]
        flags: bool[3]
        tail: int64

fn main(): int32 =
    # 1) local uint16[3], constant-index write+read, incl. a value that needs
    #    the top bit (40000 > int16 max, only valid as unsigned).
    var v: uint16[3]
    v[0] = 65535
    v[1] = 258
    v[2] = 40000
    if v[0] != 65535: return 1
    if v[1] != 258: return 2
    if v[2] != 40000: return 3

    # 2) local uint16[3], dynamic-index (loop variable) write+read.
    var w: uint16[3]
    for i in 0..<3:
        w[i] = (i + 1) * 111
    for i in 0..<3:
        if w[i] != (i + 1) * 111: return 10 + i

    # 3) writing element[0] must not clobber element[1] (the core symptom):
    #    write [1] first, then [0], and confirm [1] is untouched.
    var z: uint16[3]
    z[1] = 999
    z[0] = 7
    if z[1] != 999: return 20
    if z[0] != 7: return 21

    # 4) local bool[3] + an adjacent stack sentinel that a 4-byte-wide
    #    mis-store into a 1-byte-wide bool[3] would stomp.
    var guard: int64 = 424242
    var flags: bool[3]
    flags[0] = true
    flags[1] = false
    flags[2] = true
    if guard != 424242: return 30
    if flags[0] != true: return 31
    if flags[1] != false: return 32
    if flags[2] != true: return 33

    # 5) struct field uint16[3]: constant-index write+read, cross-element
    #    independence.
    var r: NarrowRoundTripRec
    r.vals[0] = 111
    r.vals[1] = 222
    r.vals[2] = 333
    if r.vals[0] != 111: return 40
    if r.vals[1] != 222: return 41
    if r.vals[2] != 333: return 42

    # 6) struct field uint16[3]: dynamic-index write+read.
    for j in 0..<3:
        r.vals[j] = (j + 1) * 500
    for j in 0..<3:
        if r.vals[j] != (j + 1) * 500: return 50 + j

    # 7) struct field bool[3]: constant-index write+read, and the trailing
    #    int64 field must still land correctly (layout regression guard).
    r.flags[0] = true
    r.flags[1] = false
    r.flags[2] = true
    if r.flags[0] != true: return 60
    if r.flags[1] != false: return 61
    if r.flags[2] != true: return 62
    r.tail = 777
    if r.tail != 777: return 63

    # 8) masked-index loop read (arr[i & mask]): this specific shape is
    #    recognized by the arm64 backend's loop-register-promotion peephole
    #    (cold_a64_try_loop_array_index_peephole), a THIRD, independent
    #    stride decision point separate from the per-op BODY_OP_ARRAY_I32_
    #    INDEX_DYNAMIC dispatch exercised by items 2/6 above -- it has its
    #    own uint8-vs-4-byte two-way split and needed its own width fix.
    var w: uint16[4]
    w[0] = 10
    w[1] = 20
    w[2] = 30
    w[3] = 40
    var sum: int32 = 0
    for i in 0..<8:
        let idx = i & 3
        sum = sum + int32(w[idx])
    if sum != 200: return 70
    return 0
