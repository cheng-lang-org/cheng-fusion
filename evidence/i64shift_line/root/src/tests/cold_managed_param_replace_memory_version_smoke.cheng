fn writeExactText(value: int32, out: var str) =
    out = Fmt"exact-{value}"

fn replaceExactText(out: var str): bool =
    var current: str
    writeExactText(7, current)
    out = current
    return len(out) == 7

fn main(): int32 =
    var result: str
    if !replaceExactText(result):
        return 1
    if result != "exact-7":
        return 2
    return 0
