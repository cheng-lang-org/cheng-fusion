import std/system as system

type
    ColdManagedExactFixedArrayLoopValueLeaf =
        label: str

    ColdManagedExactFixedArrayLoopValueOwner =
        leaves: ColdManagedExactFixedArrayLoopValueLeaf[2]

fn ColdManagedExactFixedArrayLoopValueNew(
    value: str
): ColdManagedExactFixedArrayLoopValueLeaf =
    var leaf: ColdManagedExactFixedArrayLoopValueLeaf
    leaf.label = system.NewStringCopy(
        system.StrDataPtr(value), value.len)
    return leaf

fn ColdManagedExactFixedArrayLoopValueExercise(): int32 =
    var owner: ColdManagedExactFixedArrayLoopValueOwner
    for step in 0..<3:
        if step == 1:
            if owner.leaves[0].label != "value-loop-0":
                return 1
        elif step == 2:
            if owner.leaves[0].label != "value-loop-1":
                return 2

        if step == 0:
            owner.leaves[0] = ColdManagedExactFixedArrayLoopValueNew("value-loop-0")
        elif step == 1:
            owner.leaves[0] = ColdManagedExactFixedArrayLoopValueNew("value-loop-1")
        else:
            owner.leaves[0] = ColdManagedExactFixedArrayLoopValueNew("value-loop-2")
        owner.leaves[0] = owner.leaves[0]
        owner.leaves[1] = ColdManagedExactFixedArrayLoopValueNew("value-clear")
        owner.leaves[1] = ColdManagedExactFixedArrayLoopValueLeaf()

    if owner.leaves[0].label != "value-loop-2" ||
       len(owner.leaves[1].label) != 0:
        return 3
    return 0

fn main(): int32 =
    let allocBefore = system.memAllocCount()
    let freeBefore = system.memFreeCount()
    let liveBefore = system.memLiveCount()
    let retainBefore = system.memRetainCount()
    let releaseBefore = system.memReleaseCount()

    if ColdManagedExactFixedArrayLoopValueExercise() != 0:
        return 1

    let allocDelta = system.memAllocCount() - allocBefore
    let freeDelta = system.memFreeCount() - freeBefore
    let liveDelta = system.memLiveCount() - liveBefore
    let retainDelta = system.memRetainCount() - retainBefore
    let releaseDelta = system.memReleaseCount() - releaseBefore
    if allocDelta != int64(6) || allocDelta != freeDelta:
        return 2
    if liveDelta != int64(0):
        return 3
    if retainDelta != int64(3):
        return 4
    if releaseDelta != int64(9):
        return 5
    if releaseDelta != retainDelta + freeDelta:
        return 6

    echo(Fmt"cold_managed_exact_fixed_array_loop_value_object_alloc_delta={allocDelta}")
    echo(Fmt"cold_managed_exact_fixed_array_loop_value_object_free_delta={freeDelta}")
    echo(Fmt"cold_managed_exact_fixed_array_loop_value_object_live_delta={liveDelta}")
    echo(Fmt"cold_managed_exact_fixed_array_loop_value_object_retain_delta={retainDelta}")
    echo(Fmt"cold_managed_exact_fixed_array_loop_value_object_release_delta={releaseDelta}")
    echo("cold_managed_exact_fixed_array_loop_value_object=PASS")
    return 0
