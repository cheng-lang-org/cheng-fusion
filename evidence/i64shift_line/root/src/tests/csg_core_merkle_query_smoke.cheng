import std/os as os
import std/rawbytes
import std/strings
import cheng/core/csg_core/json_canonical as canonical
import cheng/core/csg_core/merkle_artifacts
import cheng/core/csg_core/merkle_builder
import cheng/core/csg_core/merkle_manifest
import cheng/core/csg_core/merkle_query
import cheng/core/csg_core/merkle_store
import cheng/core/csg_core/merkle_store_codec
import cheng/core/csg_core/merkle_store_pipeline

const
    Standard: str = "csg_core::v1"
    BaseProfile: str = "csg_core"
    SourceA: str = "source:query-a"
    SourceB: str = "source:query-b"
    SourceAText: str = "module query_a\nfn alpha() = 1\n"
    SourceBText: str = "module query_b\nfn beta() = 2\n"

@borrows
fn fail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

@borrows
fn cat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

@borrows
fn sourceCid(text: str): str =
    var bytes = rawbytes.BytesAlloc(text.len)
    for i in 0..<text.len:
        rawbytes.BytesSet(
            bytes, i, int32(text[i]) & 255)
    let cid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            "csg_core.external.source", bytes)
    rawbytes.BytesFree(bytes)
    return cid

@borrows
fn makeSource(
        sourceId: str,
        sourceCidValue: str,
        facts: str[]):
        merkle_builder.CsgCoreMerkleBuilderSource =
    var out: merkle_builder.CsgCoreMerkleBuilderSource
    out.sourceId = strings.CloneStr(sourceId)
    out.sourceCid = strings.CloneStr(sourceCidValue)
    for i in 0..<facts.len:
        add(out.facts, strings.CloneStr(facts[i]))
    return out

@borrows
fn publishClosure(
        parentPath: str,
        storeName: str,
        closure:
            merkle_builder.CsgCoreMerkleBuilderResult):
        str =
    let published =
        merkle_store_pipeline.CsgCoreMerkleStoreBootstrapExclusive(
            parentPath, storeName, closure)
    if !published.ok || !published.published || published.reused:
        return published.error.len > 0 ?
            strings.CloneStr(published.error) :
            "merkle_query_fixture_bootstrap_invalid"
    return ""

@borrows
fn reportCanonical(report: str): bool =
    let normalized =
        canonical.CsgCoreJsonCanonicalize(report)
    return normalized.ok && normalized.value == report

@borrows
fn queryPositive(
        parentPath: str,
        storeName: str):
        merkle_query.CsgCoreMerkleQueryResult =
    return merkle_query.CsgCoreMerkleStoreQuery(
        parentPath,
        storeName,
        "kind",
        "csg.symbol")

@borrows
fn positiveValid(
        result:
            merkle_query.CsgCoreMerkleQueryResult):
        bool =
    return result.ok &&
        result.verificationScope == "local_query" &&
        !result.fullClosureVerified &&
        !result.productionAdmission &&
        result.generationRecordsRead == 2 &&
        result.manifestObjectsRead == 2 &&
        result.queryShardObjectsRead == 1 &&
        result.partitionObjectsRead == 2 &&
        result.membershipObjectsRead == 2 &&
        result.proofNodeObjectsRead > 0 &&
        result.objectsRead ==
            result.manifestObjectsRead +
            result.queryShardObjectsRead +
            result.partitionObjectsRead +
            result.membershipObjectsRead +
            result.proofNodeObjectsRead &&
        merkle_store_codec.CsgCoreMerkleStoreCidValid(
            result.queryKeyRoot) &&
        merkle_store_codec.CsgCoreMerkleStoreCidValid(
            result.resultRoot) &&
        result.hits.len == 2 &&
        result.hits[0].factKey ==
            "id:symbol:query-alpha" &&
        result.hits[1].factKey ==
            "id:symbol:query-beta" &&
        reportCanonical(result.report)

@borrows
fn findSymbolPartition(
        closure:
            merkle_builder.CsgCoreMerkleBuilderResult,
        sourceId: str,
        factsCid: var str,
        membershipCid: var str): bool =
    for i in 0..<closure.manifest.partitions.len:
        if closure.manifest.partitions[i].sourceId ==
               sourceId &&
           closure.manifest.partitions[i].factKind ==
               "csg.symbol":
            factsCid =
                strings.CloneStr(
                    closure.manifest.partitions[i].factsCid)
            membershipCid =
                strings.CloneStr(
                    closure.manifest.partitions[i].membershipCid)
            return true
    return false

@borrows
fn writeReceipt(name: str, value: str) =
    os.WriteLine(
        os.Get_stdout(),
        cat(cat(name, "="), value))

@borrows
fn runRead(
        parentPath: str,
        storeName: str): int32 =
    let result =
        queryPositive(parentPath, storeName)
    if !positiveValid(result):
        return fail(
            cat(
                "merkle query positive failed: ",
                result.error))
    os.WriteLine(os.Get_stdout(), result.report)
    return 0

@borrows
fn runEmpty(
        parentPath: str,
        storeName: str): int32 =
    let result =
        merkle_query.CsgCoreMerkleStoreQuery(
            parentPath,
            storeName,
            "name",
            "absent")
    if !result.ok ||
       result.hits.len != 0 ||
       result.generationRecordsRead != 2 ||
       result.manifestObjectsRead != 2 ||
       result.objectsRead != 2 ||
       result.partitionObjectsRead != 0 ||
       result.membershipObjectsRead != 0 ||
       !reportCanonical(result.report):
        return fail(
            cat(
                "merkle query empty failed: ",
                result.error))
    os.WriteLine(os.Get_stdout(), result.report)
    return 0

@borrows
fn runReject(
        parentPath: str,
        storeName: str): int32 =
    let result =
        queryPositive(parentPath, storeName)
    if result.ok || result.error.len == 0:
        return fail(
            "merkle query corruption was accepted")
    os.WriteLine(os.Get_stdout(), result.error)
    return 0

@borrows
fn runFull(
        parentPath: str,
        storeName: str): int32 =
    let result =
        merkle_store.CsgCoreMerkleStoreReadHead(
            parentPath, storeName)
    if !result.ok || !result.present:
        return fail(
            cat(
                "full ReadHead failed: ",
                result.error))
    os.WriteLine(
        os.Get_stdout(), result.head.headCid)
    return 0

@borrows
fn runWrite(parentPath: str): int32 =
    let schemaFact =
        "{\"features\":[\"core-facts\"],\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}"
    let alphaFact =
        "{\"file\":\"pkg://cheng/query/a.cheng\",\"id\":\"symbol:query-alpha\",\"kind\":\"csg.symbol\",\"name\":\"alpha\",\"symbol\":\"alpha\",\"symbolKind\":\"fn\"}"
    let betaFact =
        "{\"file\":\"pkg://cheng/query/b.cheng\",\"id\":\"symbol:query-beta\",\"kind\":\"csg.symbol\",\"name\":\"beta\",\"symbol\":\"beta\",\"symbolKind\":\"fn\"}"
    let sourceACid = sourceCid(SourceAText)
    let sourceBCid = sourceCid(SourceBText)
    let sourceAForward =
        makeSource(
            SourceA,
            sourceACid,
            [strings.CloneStr(schemaFact),
             strings.CloneStr(alphaFact)])
    let sourceBForward =
        makeSource(
            SourceB,
            sourceBCid,
            [strings.CloneStr(betaFact)])
    let sourceAReverse =
        makeSource(
            SourceA,
            sourceACid,
            [strings.CloneStr(alphaFact),
             strings.CloneStr(schemaFact)])
    let sourceBReverse =
        makeSource(
            SourceB,
            sourceBCid,
            [strings.CloneStr(betaFact)])
    var forward =
        merkle_builder.CsgCoreMerkleBuildClosure(
            Standard,
            [BaseProfile],
            [sourceAForward, sourceBForward],
            [])
    var reverse =
        merkle_builder.CsgCoreMerkleBuildClosure(
            Standard,
            [BaseProfile],
            [sourceBReverse, sourceAReverse],
            [])
    if !forward.ok || !reverse.ok:
        let error =
            cat(
                cat(forward.error, " / "),
                reverse.error)
        merkle_builder.CsgCoreMerkleBuilderFree(
            forward)
        merkle_builder.CsgCoreMerkleBuilderFree(
            reverse)
        return fail(
            cat("merkle query build failed: ", error))
    if forward.manifestArtifact.cid !=
           reverse.manifestArtifact.cid ||
       forward.queryCargo.root !=
           reverse.queryCargo.root ||
       forward.dependencyCargo.consumerRoot !=
           reverse.dependencyCargo.consumerRoot ||
       forward.dependencyCargo.providerRoot !=
           reverse.dependencyCargo.providerRoot ||
       forward.factsRoot != reverse.factsRoot:
        merkle_builder.CsgCoreMerkleBuilderFree(
            forward)
        merkle_builder.CsgCoreMerkleBuilderFree(
            reverse)
        return fail(
            "merkle query input order changed closure")

    var error =
        publishClosure(
            parentPath, "store", forward)
    if error.len == 0:
        error =
            publishClosure(
                parentPath, "reverse", reverse)
    if error.len > 0:
        merkle_builder.CsgCoreMerkleBuilderFree(
            forward)
        merkle_builder.CsgCoreMerkleBuilderFree(
            reverse)
        return fail(
            cat(
                "merkle query publish failed: ",
                error))

    let forwardQuery =
        queryPositive(parentPath, "store")
    let reverseQuery =
        queryPositive(parentPath, "reverse")
    let full =
        merkle_store.CsgCoreMerkleStoreReadHead(
            parentPath, "store")
    let manifestOnly =
        merkle_store.CsgCoreMerkleStoreReadManifestOnlyHead(
            parentPath, "store")
    if !positiveValid(forwardQuery) ||
       !positiveValid(reverseQuery) ||
       forwardQuery.report != reverseQuery.report ||
       !full.ok || !full.present ||
       !manifestOnly.ok ||
       !manifestOnly.present ||
       manifestOnly.verificationScope !=
           "manifest_only" ||
       manifestOnly.fullClosureVerified ||
       manifestOnly.productionAdmission ||
       manifestOnly.objectsRead != 1:
        let message =
            cat(
                cat(
                    forwardQuery.error, " / "),
                reverseQuery.error)
        merkle_builder.CsgCoreMerkleBuilderFree(
            forward)
        merkle_builder.CsgCoreMerkleBuilderFree(
            reverse)
        return fail(
            cat(
                "merkle query verification failed: ",
                message))

    let empty =
        merkle_query.CsgCoreMerkleStoreQuery(
            parentPath,
            "store",
            "name",
            "absent")
    let one =
        merkle_query.CsgCoreMerkleStoreQuery(
            parentPath,
            "store",
            "symbol",
            "alpha")
    if !empty.ok ||
       empty.hits.len != 0 ||
       empty.generationRecordsRead != 2 ||
       empty.manifestObjectsRead != 2 ||
       empty.objectsRead != 2 ||
       !one.ok ||
       one.hits.len != 1 ||
       one.generationRecordsRead != 2 ||
       one.manifestObjectsRead != 2 ||
       one.objectsRead !=
           one.manifestObjectsRead +
           one.queryShardObjectsRead +
           one.partitionObjectsRead +
           one.membershipObjectsRead +
           one.proofNodeObjectsRead:
        merkle_builder.CsgCoreMerkleBuilderFree(
            forward)
        merkle_builder.CsgCoreMerkleBuilderFree(
            reverse)
        return fail(
            "merkle query object count mismatch")

    var partitionCid: str
    var membershipCid: str
    if !findSymbolPartition(
           forward,
           SourceA,
           partitionCid,
           membershipCid):
        merkle_builder.CsgCoreMerkleBuilderFree(
            forward)
        merkle_builder.CsgCoreMerkleBuilderFree(
            reverse)
        return fail(
            "merkle query fixture partition missing")
    let symbolBucket =
        merkle_artifacts.CsgCoreMerkleQueryBucket(
            "kind", "csg.symbol")
    let symbolDescriptorAt =
        merkle_manifest.CsgCoreMerkleShardDescriptorIndex(
            forward.manifest.queryShards,
            symbolBucket)
    if symbolDescriptorAt < 0:
        merkle_builder.CsgCoreMerkleBuilderFree(forward)
        merkle_builder.CsgCoreMerkleBuilderFree(reverse)
        return fail(
            "merkle query fixture shard missing")
    writeReceipt(
        "query_shard_cid",
        forward.manifest.queryShards[
            symbolDescriptorAt].cid)
    writeReceipt("partition_cid", partitionCid)
    writeReceipt("membership_cid", membershipCid)
    writeReceipt(
        "head_cid", forwardQuery.headCid)
    writeReceipt(
        "manifest_cid",
        forward.manifestArtifact.cid)
    os.WriteLine(
        os.Get_stdout(),
        "csg_core_merkle_query_write=passed")
    merkle_builder.CsgCoreMerkleBuilderFree(
        forward)
    merkle_builder.CsgCoreMerkleBuilderFree(
        reverse)
    return 0

fn main(): int32 =
    let parentPath =
        os.GetEnv("CSG_QUERY_TEST_PARENT")
    let storeName =
        os.GetEnv("CSG_QUERY_TEST_STORE")
    let mode =
        os.GetEnv("CSG_QUERY_TEST_MODE")
    if parentPath.len == 0:
        return fail(
            "CSG_QUERY_TEST_PARENT missing")
    if mode == "write":
        return runWrite(parentPath)
    if storeName.len == 0:
        return fail(
            "CSG_QUERY_TEST_STORE missing")
    if mode == "read":
        return runRead(parentPath, storeName)
    if mode == "empty":
        return runEmpty(parentPath, storeName)
    if mode == "reject":
        return runReject(parentPath, storeName)
    if mode == "full":
        return runFull(parentPath, storeName)
    return fail("CSG_QUERY_TEST_MODE invalid")
