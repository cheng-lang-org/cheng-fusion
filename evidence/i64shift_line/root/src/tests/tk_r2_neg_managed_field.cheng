import std/system as system

type
    TkR2Managed =
        outcome: int32
        tag: str

    TkR2Holder =
        m: TkR2Managed
        ready: bool

fn main(): int32 =
    var h: TkR2Holder
    var m: TkR2Managed
    m.outcome = 1
    m.tag = strings.ConcatStr("hel", "lo")
    h.m = m
    h.ready = true
    os.WriteLine(os.Get_stdout(), m.tag)
    return 0
