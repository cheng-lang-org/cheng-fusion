type
    ColdRefObjectBorrowSequenceHeaderOuter = ref object
        values: int32[]

fn ColdRefObjectBorrowSequenceHeaderWrite(
        values: var int32[]) =
    add(values, 17)

fn ColdRefObjectBorrowSequenceHeaderMutate(
        out: var ColdRefObjectBorrowSequenceHeaderOuter) =
    var values = out.values
    let forbiddenLength = out.values.len
    ColdRefObjectBorrowSequenceHeaderWrite(values)
    if forbiddenLength == 0:
        return

fn main(): int32 =
    var out = new(ColdRefObjectBorrowSequenceHeaderOuter)
    ColdRefObjectBorrowSequenceHeaderMutate(out)
    return 0
