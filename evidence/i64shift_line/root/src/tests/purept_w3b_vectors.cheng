# W3b criterion (a): RFC 9001 Appendix A field-by-field vectors, evaluated
# through the pure-Cheng packet protection modules (packet_keys +
# packet_protect) on top of the W3a plaintext format layer.
#
#   A.1  HKDF-Expand-Label wire forms, Initial secrets, key/iv/hp per side
#   A.2  client Initial: hp mask sample, full protect == published packet,
#        unprotect -> pn 2 -> CRYPTO(0, 241) + 917 PADDING frame walk
#   A.3  server Initial: hp mask sample, full protect == published packet,
#        unprotect -> pn 1 -> ACK + CRYPTO(0, 90) frame walk
#   A.4  Retry wire form: token/tag split via frames_header, integrity stub
#        returns the distinct deferred code (-60), never a silent pass
#   A.5  ChaCha-shaped secret: key/iv/hp(32)/ku derivation, per-packet nonce,
#        ChaCha20 header protection mask, mask application to the header
#
# Exit non-zero on any mismatch.

import std/os
import std/rawbytes
import std/result as result
import std/strings as strings
import cheng/quic/pure/frames_varint as quicvarint
import cheng/quic/pure/frames_header as quichdr
import cheng/quic/pure/frames_codec as quicframes
import cheng/quic/pure/packet_keys as qkeys
import cheng/quic/pure/packet_protect as qprot

var gPass: int32
var gFails: int32

@borrows
fn reportFail(tag: str, detail: str) =
    os.WriteLine(os.Get_stdout(), strings.concatStr("FAIL ",
        strings.concatStr(tag, strings.concatStr(": ", detail))))
    gFails = gFails + 1

@borrows
fn reportPass(tag: str, detail: str) =
    os.WriteLine(os.Get_stdout(), strings.concatStr("PASS ",
        strings.concatStr(tag, strings.concatStr(": ", detail))))
    gPass = gPass + 1

@borrows
fn expectHex(tag: str, got: Bytes, wantHex: str) =
    let gotHex: str = BytesToHex(got)
    if gotHex != wantHex:
        reportFail(tag, strings.concatStr(gotHex, strings.concatStr(" want ", wantHex)))
    else:
        reportPass(tag, strings.concatStr(gotHex, strings.concatStr(" (", strings.concatStr(strings.IntToStr(got.len * 8), " bits)"))))

@borrows
fn expectTrue(tag: str, cond: bool, detail: str) =
    if !cond:
        reportFail(tag, detail)
    else:
        reportPass(tag, detail)

@borrows
fn expectInt(tag: str, got: int32, want: int32) =
    if got != want:
        reportFail(tag, strings.concatStr(strings.IntToStr(got), strings.concatStr(" want ", strings.IntToStr(want))))
    else:
        reportPass(tag, strings.IntToStr(got))

@borrows
fn expectInt64(tag: str, got: int64, want: int64) =
    if got != want:
        reportFail(tag, strings.concatStr(strings.IntToStr(got), strings.concatStr(" want ", strings.IntToStr(want))))
    else:
        reportPass(tag, strings.IntToStr(got))

# RFC 9001 Appendix A sample connection ID (A.1: "an 8-byte client-chosen
# Destination Connection ID of 0x8394c8f03e515708").
const SampleCidHex: str = "8394c8f03e515708"

fn main(): int32 =
    # ---------- A.1: HKDF-Expand-Label wire forms ----------
    var b: BytesBuilder = BytesBuilderNew(64)
    let lblRc: int32 = qkeys.QuicHkdfLabelAppend(b, BytesFromHex(qkeys.QuicLabelClientInHex), 32)
    expectHex("a1_hkl_client_in", BytesBuilderFinish(b), "00200f746c73313320636c69656e7420696e00")
    b = BytesBuilderNew(64)
    let lblRc: int32 = qkeys.QuicHkdfLabelAppend(b, BytesFromHex(qkeys.QuicLabelServerInHex), 32)
    expectHex("a1_hkl_server_in", BytesBuilderFinish(b), "00200f746c7331332073657276657220696e00")
    b = BytesBuilderNew(64)
    let lblRc: int32 = qkeys.QuicHkdfLabelAppend(b, BytesFromHex(qkeys.QuicLabelQuicKeyHex), 16)
    expectHex("a1_hkl_quic_key", BytesBuilderFinish(b), "00100e746c7331332071756963206b657900")
    b = BytesBuilderNew(64)
    let lblRc: int32 = qkeys.QuicHkdfLabelAppend(b, BytesFromHex(qkeys.QuicLabelQuicIvHex), 12)
    expectHex("a1_hkl_quic_iv", BytesBuilderFinish(b), "000c0d746c733133207175696320697600")
    b = BytesBuilderNew(64)
    let lblRc: int32 = qkeys.QuicHkdfLabelAppend(b, BytesFromHex(qkeys.QuicLabelQuicHpHex), 16)
    expectHex("a1_hkl_quic_hp", BytesBuilderFinish(b), "00100d746c733133207175696320687000")

    # ---------- A.1: Initial secrets and key material ----------
    var secRes: result.Result[qkeys.QuicInitialSecrets] = qkeys.QuicInitialSecretsForCid(BytesFromHex(SampleCidHex))
    expectTrue("a1_secrets.ok", result.IsOk(secRes), "derivation failed")
    if result.IsErr(secRes):
        os.WriteLine(os.Get_stdout(), "W3B-VECTORS RESULT: FAIL (no secrets)")
        return 1
    var sec: qkeys.QuicInitialSecrets = result.Value(secRes)
    expectHex("a1_initial_secret", sec.initialSecret, "7db5df06e7a69e432496adedb00851923595221596ae2ae9fb8115c1e9ed0a44")
    expectHex("a1_client_secret", sec.clientSecret, "c00cf151ca5be075ed0ebfb5c80323c42d6b7db67881289af4008f1f6c357aea")
    expectHex("a1_server_secret", sec.serverSecret, "3c199828fd139efd216c155ad844cc81fb82fa8d7446fa7d78be803acdda951b")

    var ckRes: result.Result[qkeys.QuicPacketKeys] = qkeys.QuicInitialKeys(BytesFromHex(SampleCidHex), false)
    var skRes: result.Result[qkeys.QuicPacketKeys] = qkeys.QuicInitialKeys(BytesFromHex(SampleCidHex), true)
    expectTrue("a1_keys.ok", result.IsOk(ckRes) && result.IsOk(skRes), "key derivation failed")
    if result.IsErr(ckRes) || result.IsErr(skRes):
        os.WriteLine(os.Get_stdout(), "W3B-VECTORS RESULT: FAIL (no keys)")
        return 1
    var ckeys: qkeys.QuicPacketKeys = result.Value(ckRes)
    var skeys: qkeys.QuicPacketKeys = result.Value(skRes)
    expectHex("a1_client_key", ckeys.key, "1f369613dd76d5467730efcbe3b1a22d")
    expectHex("a1_client_iv", ckeys.iv, "fa044b2f42a3fd3b46fb255c")
    expectHex("a1_client_hp", ckeys.hp, "9f50449e04a0e810283a1e9933adedd2")
    expectHex("a1_server_key", skeys.key, "cf3a5331653c364c88f0f379b6067e37")
    expectHex("a1_server_iv", skeys.iv, "0ac1493ca1905853b0bba03e")
    expectHex("a1_server_hp", skeys.hp, "c206b8d9b9f0f37644430b490eeaa314")

    # ---------- A.2: client Initial ----------
    let a2Sample: Bytes = BytesFromHex("d1b1c98dd7689fb8ec11d242b123dc9b")
    var a2MaskRes: result.Result[Bytes] = qprot.QuicHpMaskAes(ckeys.hp, a2Sample)
    expectTrue("a2_mask.ok", result.IsOk(a2MaskRes), "mask computation failed")
    if result.IsOk(a2MaskRes):
        expectHex("a2_mask", BytesSlice(BytesTake(a2MaskRes.value), 0, 5), "437b9aec36")

    let a2Hdr: Bytes = BytesFromHex("c300000001088394c8f03e5157080000449e00000002")
    let a2Crypto: Bytes = BytesFromHex("")
    expectInt("a2_crypto_len", a2Crypto.len, 245)
    # A.2 header is 18 bytes through the Length field + 4-byte pn = 22; the
    # 1162-byte payload follows at offset 22.
    var a2Plain: Bytes = BytesAlloc(22 + 1162)
    BytesCopyInto(a2Plain, 0, a2Hdr)
    BytesCopyInto(a2Plain, 22, a2Crypto)
    # remaining 917 bytes stay zero = PADDING
    var a2ProtRes: result.Result[Bytes] = qprot.QuicPacketProtect(ckeys, a2Plain, 18, 4, 2)
    expectTrue("a2_protect.ok", result.IsOk(a2ProtRes), "protect failed")
    if result.IsOk(a2ProtRes):
        let a2Prot: Bytes = BytesTake(a2ProtRes.value)
        expectInt("a2_protect_len", a2Prot.len, 1200)
        expectHex("a2_protect_packet", a2Prot, "")
        expectHex("a2_protect_header", BytesSlice(a2Prot, 0, 22), "c000000001088394c8f03e5157080000449e7b9aec34")

    let a2Pkt: Bytes = BytesFromHex("")
    var rec2: qprot.QuicUnprotectRecord = qprot.QuicUnprotectRecordZero()
    let a2UnpRc: int32 = qprot.QuicPacketUnprotect(ckeys, a2Pkt, 0, 0, rec2)
    expectInt("a2_unprotect_rc", a2UnpRc, 0)
    if a2UnpRc == 0:
        expectTrue("a2_unprotect.ok", rec2.ok, "record not ok")
        expectInt64("a2_pn", rec2.fullPn, 2)
        expectInt("a2_pnlen", rec2.pnLen, 4)
        expectInt("a2_byte0", rec2.byte0, 0xc3)
        expectInt("a2_header_len", rec2.headerLen, 22)
        expectInt("a2_payload_len", rec2.payloadLen, 1162)
        expectTrue("a2_plain_crypto_prefix", BytesEqual(BytesSlice(rec2.plain, 0, 32), BytesSlice(a2Crypto, 0, 32)),
            BytesToHex(BytesSlice(rec2.plain, 0, 16)))
        expectTrue("a2_plain_padding", quicvarint.QuicLshr64(1, 1) >= 0 && rec2.plain.len == 1162,
            strings.IntToStr(rec2.plain.len))
        var padOk: bool = true
        var pi: int32 = 245
        while pi < rec2.plain.len:
            if BytesGet(rec2.plain, pi) != 0:
                padOk = false
            pi = pi + 1
        expectTrue("a2_plain_917_padding", padOk, "nonzero padding byte")
        # frame walk: CRYPTO(0, 241) then PADDING to the end
        var pos: int32
        var cryptoSeen: bool
        var f: quicframes.QuicFrame = quicframes.QuicFrameZero()
        var walkOk: bool = true
        while pos < rec2.plain.len:
            let consumed: int32 = quicframes.QuicFrameDecodeAt(rec2.plain, pos, f)
            if consumed < 0:
                walkOk = false
                break
            if f.ftype == quicframes.QuicFrameCrypto:
                cryptoSeen = true
                expectInt64("a2_crypto_offset", f.offset, 0)
                expectInt64("a2_crypto_len_field", f.length, 241)
                expectInt("a2_crypto_data0", BytesGet(rec2.plain, f.dataOff) & 255, 0x01)
            pos = consumed
        expectTrue("a2_frame_walk", walkOk && cryptoSeen && pos == rec2.plain.len,
            strings.concatStr("walkOk=", strings.concatStr(strings.IntToStr(walkOk), strings.concatStr(" crypto=", strings.IntToStr(cryptoSeen)))))

    # ---------- A.3: server Initial ----------
    let a3Sample: Bytes = BytesFromHex("2cd0991cd25b0aac406a5816b6394100")
    var a3MaskRes: result.Result[Bytes] = qprot.QuicHpMaskAes(skeys.hp, a3Sample)
    if result.IsOk(a3MaskRes):
        expectHex("a3_mask", BytesSlice(BytesTake(a3MaskRes.value), 0, 5), "2ec0d8356a")
    else:
        reportFail("a3_mask.ok", "mask computation failed")

    let a3Hdr: Bytes = BytesFromHex("c1000000010008f067a5502a4262b50040750001")
    let a3Payload: Bytes = BytesFromHex("02000000000600405a020000560303eefce7f7b37ba1d1632e96677825ddf73988cfc79825df566dc5430b9a045a1200130100002e00330024001d00209d3c940d89690b84d08a60993c144eca684d1081287c834d5311bcf32bb9da1a002b00020304")
    expectInt("a3_payload_len", a3Payload.len, 99)
    var a3Plain: Bytes = BytesAlloc(20 + 99)
    BytesCopyInto(a3Plain, 0, a3Hdr)
    BytesCopyInto(a3Plain, 20, a3Payload)
    var a3ProtRes: result.Result[Bytes] = qprot.QuicPacketProtect(skeys, a3Plain, 18, 2, 1)
    expectTrue("a3_protect.ok", result.IsOk(a3ProtRes), "protect failed")
    if result.IsOk(a3ProtRes):
        expectHex("a3_protect_packet", BytesTake(a3ProtRes.value), "cf000000010008f067a5502a4262b5004075c0d95a482cd0991cd25b0aac406a5816b6394100f37a1c69797554780bb38cc5a99f5ede4cf73c3ec2493a1839b3dbcba3f6ea46c5b7684df3548e7ddeb9c3bf9c73cc3f3bded74b562bfb19fb84022f8ef4cdd93795d77d06edbb7aaf2f58891850abbdca3d20398c276456cbc42158407dd074ee")

    let a3Pkt: Bytes = BytesFromHex("cf000000010008f067a5502a4262b5004075c0d95a482cd0991cd25b0aac406a5816b6394100f37a1c69797554780bb38cc5a99f5ede4cf73c3ec2493a1839b3dbcba3f6ea46c5b7684df3548e7ddeb9c3bf9c73cc3f3bded74b562bfb19fb84022f8ef4cdd93795d77d06edbb7aaf2f58891850abbdca3d20398c276456cbc42158407dd074ee")
    expectInt("a3_packet_len", a3Pkt.len, 135)
    expectHex("a3_protected_header", BytesSlice(a3Pkt, 0, 20), "cf000000010008f067a5502a4262b5004075c0d9")
    var rec3: qprot.QuicUnprotectRecord = qprot.QuicUnprotectRecordZero()
    let a3UnpRc: int32 = qprot.QuicPacketUnprotect(skeys, a3Pkt, 0, 0, rec3)
    expectInt("a3_unprotect_rc", a3UnpRc, 0)
    if a3UnpRc == 0:
        expectInt64("a3_pn", rec3.fullPn, 1)
        expectInt("a3_pnlen", rec3.pnLen, 2)
        expectInt("a3_byte0", rec3.byte0, 0xc1)
        expectHex("a3_plain", rec3.plain, "02000000000600405a020000560303eefce7f7b37ba1d1632e96677825ddf73988cfc79825df566dc5430b9a045a1200130100002e00330024001d00209d3c940d89690b84d08a60993c144eca684d1081287c834d5311bcf32bb9da1a002b00020304")
        var f3: quicframes.QuicFrame = quicframes.QuicFrameZero()
        let c1: int32 = quicframes.QuicFrameDecodeAt(rec3.plain, 0, f3)
        expectInt("a3_frame1_rc", c1, 5)
        if c1 == 5:
            expectInt("a3_ack_type", f3.ftype, quicframes.QuicFrameAck)
            expectInt64("a3_ack_largest", f3.largestAck, 0)
            expectInt64("a3_ack_delay", f3.ackDelay, 0)
            expectInt64("a3_ack_count", f3.ackRangeCount, 0)
            expectInt64("a3_ack_first_range", f3.firstAckRange, 0)
        let c2: int32 = quicframes.QuicFrameDecodeAt(rec3.plain, c1, f3)
        expectInt("a3_frame2_end", c2, rec3.plain.len)
        if c2 == rec3.plain.len:
            expectInt("a3_crypto_type", f3.ftype, quicframes.QuicFrameCrypto)
            expectInt64("a3_crypto_offset", f3.offset, 0)
            expectInt64("a3_crypto_len_field", f3.length, 90)
            expectInt("a3_crypto_data0", BytesGet(rec3.plain, f3.dataOff) & 255, 0x02)

    # ---------- A.4: Retry wire form (format layer) ----------
    let a4Pkt: Bytes = BytesFromHex("ff000000010008f067a5502a4262b5746f6b656e04a265ba2eff4d829058fb3f0f2496ba")
    expectInt("a4_packet_len", a4Pkt.len, 36)
    # generic long-header parse reports Retry with the distinct -6 code
    var h4: quichdr.QuicHeader = quichdr.QuicHeaderZero()
    expectInt("a4_retry_parse_rc", quichdr.QuicHeaderParse(a4Pkt, h4), -6)
    # Section 17.2.5 wire form: DCID / token / 16-byte integrity tag, no SCID
    var r4: qprot.QuicRetryParsed = qprot.QuicRetryParsedZero()
    let a4FmtRc: int32 = qprot.QuicRetryParse(a4Pkt, r4)
    expectInt("a4_retry_fmt_rc", a4FmtRc, 0)
    if a4FmtRc == 0:
        expectTrue("a4_retry_fmt_ok", r4.ok, "record not ok")
        expectInt64("a4_retry_version", r4.version, 1)
        # A.2's client SCID is empty, so this Retry carries an empty DCID and
        # a 14-byte opaque token (last 16 bytes are the integrity tag).
        expectInt("a4_retry_dcid_len", r4.dcidLen, 0)
        expectInt("a4_retry_token_len", r4.tokenLen, 14)
        expectHex("a4_retry_token", BytesSlice(a4Pkt, r4.tokenOff, r4.tokenLen), "08f067a5502a4262b5746f6b656e")
        expectHex("a4_retry_tag", BytesSlice(a4Pkt, r4.tagOff, 16), "04a265ba2eff4d829058fb3f0f2496ba")
    expectInt("a4_retry_integrity_stub", qprot.QuicRetryIntegrityVerify(a4Pkt), -60)

    # ---------- A.5: ChaCha-shaped secret (RFC 9001 Appendix A.5) ----------
    let a5Secret: Bytes = BytesFromHex("9ac312a7f877468ebe69422748ad00a15443f18203a07d6060f688f30f21632b")
    var a5KeysRes: result.Result[qkeys.QuicPacketKeys] = qkeys.QuicKeysFromSecret(a5Secret, 32, 12, 32)
    expectTrue("a5_keys.ok", result.IsOk(a5KeysRes), "key derivation failed")
    if result.IsOk(a5KeysRes):
        var a5k: qkeys.QuicPacketKeys = result.Value(a5KeysRes)
        expectHex("a5_key", a5k.key, "c6d98ff3441c3fe1b2182094f69caa2ed4b716b65488960a7a984979fb23e1c8")
        expectHex("a5_iv", a5k.iv, "e0459b3474bdd0e44a41c144")
        expectHex("a5_hp", a5k.hp, "25a282b9e82f06f21f488917a4fc8f1b73573685608597d0efcb076b0ab7a7a4")
        var kuRes: result.Result[Bytes] = qkeys.QuicHkdfExpandLabel(a5Secret, BytesFromHex("746c7331332071756963206b75"), 32)
        if result.IsOk(kuRes):
            expectHex("a5_ku", BytesTake(kuRes.value), "1223504755036d556342ee9361d253421a826c9ecdf3c7148684b36b714881f9")
        else:
            reportFail("a5_ku.ok", "ku derivation failed")
        # per-packet nonce: iv xor (64-bit BE pn=654360564)
        let a5Nonce: Bytes = qkeys.QuicPacketNonce(a5k.iv, 654360564)
        expectHex("a5_nonce", a5Nonce, "e0459b3474bdd0e46d417eb0")
        # ChaCha20 header protection mask over the published sample
        let a5Sample: Bytes = BytesFromHex("5e5cd55c41f69080575d7999c25a5bfb")
        var a5MaskRes: result.Result[Bytes] = qprot.QuicHpMaskChacha(a5k.hp, a5Sample)
        expectTrue("a5_mask.ok", result.IsOk(a5MaskRes), "chacha mask failed")
        if result.IsOk(a5MaskRes):
            let a5Mask: Bytes = BytesTake(a5MaskRes.value)
            expectHex("a5_mask", BytesSlice(a5Mask, 0, 5), "aefefe7d03")
            # mask application: 4200bff4 ^ mask -> 4cfe4189
            let hdr: Bytes = BytesFromHex("4200bff4")
            let outHdr: Bytes = BytesAlloc(4)
            BytesSet(outHdr, 0, BytesGet(hdr, 0) ^ (BytesGet(a5Mask, 0) & 0x1f))
            BytesSet(outHdr, 1, BytesGet(hdr, 1) ^ BytesGet(a5Mask, 1))
            BytesSet(outHdr, 2, BytesGet(hdr, 2) ^ BytesGet(a5Mask, 2))
            BytesSet(outHdr, 3, BytesGet(hdr, 3) ^ BytesGet(a5Mask, 3))
            expectHex("a5_protected_header", outHdr, "4cfe4189")

    os.WriteLine(os.Get_stdout(), strings.concatStr("summary pass=", strings.concatStr(strings.IntToStr(gPass),
        strings.concatStr(" fail=", strings.IntToStr(gFails)))))
    if gFails != 0:
        os.WriteLine(os.Get_stdout(), "W3B-VECTORS RESULT: FAIL")
        return 1
    os.WriteLine(os.Get_stdout(), "W3B-VECTORS RESULT: PASS")
    return 0
