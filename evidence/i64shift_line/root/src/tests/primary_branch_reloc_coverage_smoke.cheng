import cheng/core/backend/primary_object_plan as primary
import cheng/core/ir/core_types as coreir
import cheng/std/bytes_layout as layout
import std/os

fn appendCallReloc(state: var primary.PrimaryObjectPlanPhaseState,
                   itemId: int32,
                   wordIndex: int32,
                   target: str) =
    add(state.relocSourceItemIds, itemId)
    add(state.relocWordOffsets, wordIndex)
    add(state.relocTargetSymbols, target)
    add(state.relocTargetDomainKinds,
        coreir.BodyCallTargetDomainInvalidTag)
    add(state.relocTargetRows, -1)
    add(state.relocTargetInterfaceCids, layout.FixedBytes32())

fn appendDataReloc(state: var primary.PrimaryObjectPlanPhaseState,
                   itemId: int32,
                   wordIndex: int32,
                   target: str) =
    add(state.dataRelocSourceItemIds, itemId)
    add(state.dataRelocWordOffsets, wordIndex)
    add(state.dataRelocTargetSymbols, target)

fn fillFixtureState(state: var primary.PrimaryObjectPlanPhaseState) =
    appendCallReloc(state, 17, 11, "call-target")
    appendCallReloc(state, 17, 13, "")
    appendDataReloc(state, 17, 14, "data-target")

fn main(): int32 =
    var state: primary.PrimaryObjectPlanPhaseState
    fillFixtureState(state)

    var localCovered: bool[]
    assert(primary.PrimaryObjectPlanBuildFunctionBranchRelocCoverage(
               state, 17, 10, 6, 0, 0, localCovered),
           "function coverage")
    assert(localCovered.len == 6 &&
           !localCovered[0] && localCovered[1] &&
           !localCovered[2] && !localCovered[3] &&
           localCovered[4] && !localCovered[5],
           "function coverage bytes")

    var globalCovered: bool[]
    var globalOwners: int32[]
    assert(primary.PrimaryObjectPlanBuildBranchRelocWordOwners(
               state, 16, globalCovered, globalOwners),
           "global coverage")
    assert(globalCovered.len == 16 && globalOwners.len == 16 &&
           globalCovered[11] && globalOwners[11] == 17 &&
           !globalCovered[13] && globalOwners[13] == -1 &&
           globalCovered[14] && globalOwners[14] == 17,
           "global owners")

    var badShape: primary.PrimaryObjectPlanPhaseState
    fillFixtureState(badShape)
    add(badShape.relocSourceItemIds, 17)
    if primary.PrimaryObjectPlanBuildBranchRelocWordOwners(
           badShape, 16, globalCovered, globalOwners):
        return 1

    var wrongFunction: primary.PrimaryObjectPlanPhaseState
    fillFixtureState(wrongFunction)
    wrongFunction.relocSourceItemIds[1] = 23
    if primary.PrimaryObjectPlanBuildFunctionBranchRelocCoverage(
           wrongFunction, 17, 10, 6, 0, 0, localCovered):
        return 2

    var crossOwner: primary.PrimaryObjectPlanPhaseState
    appendCallReloc(crossOwner, 17, 4, "first")
    appendDataReloc(crossOwner, 23, 4, "second")
    if primary.PrimaryObjectPlanBuildBranchRelocWordOwners(
           crossOwner, 8, globalCovered, globalOwners):
        return 3

    if primary.PrimaryObjectPlanBuildFunctionBranchRelocCoverage(
           state, 17, 2147483647, 1, 0, 0, localCovered):
        return 4
    if primary.PrimaryObjectPlanBuildFunctionBranchRelocCoverage(
           state, 17, 10, 6, 4, 0, localCovered):
        return 5

    var sameOwner: primary.PrimaryObjectPlanPhaseState
    appendCallReloc(sameOwner, 31, 2, "call")
    appendDataReloc(sameOwner, 31, 2, "data")
    assert(primary.PrimaryObjectPlanBuildBranchRelocWordOwners(
               sameOwner, 4, globalCovered, globalOwners) &&
           globalCovered[2] && globalOwners[2] == 31,
           "same owner duplicate")

    os.WriteLine(
        os.GetStdout(),
        "primary_branch_reloc_coverage_smoke=pass mutations=5")
    return 0
