import cheng/core/backend/target_matrix as tmat

fn main(): int32 =
    if "aarch64-unknown-linux-gnu" == "aarch64-unknown-linux-gnu":
        echo("literal_eq=1")
    else:
        echo("literal_eq=0")
    let linuxTarget = "aarch64-unknown-linux-gnu"
    if linuxTarget == "aarch64-unknown-linux-gnu":
        echo("var_eq=1")
    else:
        echo("var_eq=0")
    if tmat.TargetIsLinuxA64("aarch64-unknown-linux-gnu"):
        echo("linux_aarch64=1")
    else:
        echo("linux_aarch64=0")
    if tmat.TargetUsesLinuxNolibcRuntime("aarch64-unknown-linux-gnu"):
        echo("linux_nolibc=1")
    else:
        echo("linux_nolibc=0")
    if tmat.TargetIsElfObject("aarch64-unknown-linux-gnu"):
        echo("linux_elf=1")
    else:
        echo("linux_elf=0")
    echo(tmat.TargetPrimaryObjectFormat("aarch64-unknown-linux-gnu"))
    echo(tmat.TargetPrimaryObjectFormat("riscv64-unknown-linux-gnu"))
    echo(tmat.TargetPrimaryObjectFormat("riscv64-unknown-none-elf"))
    echo(tmat.TargetPrimaryObjectFormat("aarch64-pc-windows-msvc"))
    echo(tmat.TargetLinkerProgram("arm64-apple-darwin"))
    echo(tmat.TargetLinkerFlavor("arm64-apple-darwin"))
    echo(tmat.TargetLinkerProgram("aarch64-unknown-linux-gnu"))
    echo(tmat.TargetLinkerFlavor("aarch64-unknown-linux-gnu"))
    echo(tmat.TargetLinkerProgram("riscv64-unknown-linux-gnu"))
    echo(tmat.TargetLinkerFlavor("riscv64-unknown-linux-gnu"))
    echo(tmat.TargetLinkerProgram("riscv64-unknown-none-elf"))
    echo(tmat.TargetLinkerFlavor("riscv64-unknown-none-elf"))
    return 0
