fn R19Trim(raw: str): str =
    return raw

fn R19Slice(raw: str, start: int32, count: int32): str =
    return raw

fn R19FindEq(text: str): int32 =
    return text.len

fn R19Core(lineRaw: str, prefixLen: int32, typeOut: var str): bool =
    typeOut = ""
    let line = R19Trim(lineRaw)
    var tail: str
    if prefixLen > 0:
        tail = R19Slice(line, prefixLen, line.len - prefixLen)
    else:
        tail = line
    let eqPos = R19FindEq(tail)
    if eqPos <= 0:
        return false
    let left = R19Trim(R19Slice(tail, 0, eqPos))
    typeOut = R19Trim(left)
    return typeOut.len > 0

fn main(): int32 =
    var t: str
    let ok = R19Core("abcdef", 0, t)
    if !ok:
        return 10
    echo("r19 ok")
    return 0
