import cheng/core/ir/phase_arena as phase

# Attack: closing the owning arena twice. Close invalidates the handle, so
# the second close must hard-fail instead of double-releasing the owner.
fn main(): int32 =
    var store: phase.PhaseArenaStore
    phase.PhaseArenaStoreInit(store, 1, 64, 4)
    var arena = phase.PhaseArenaStoreOpenArena(store, 1, 64, 4)
    let text = phase.PhaseArenaStoreStrPut(store, arena, "owned")
    if !phase.PhaseArenaStoreStrEqual(store, arena, text, "owned"):
        return 2
    phase.PhaseArenaStoreCloseArena(store, arena)
    phase.PhaseArenaStoreCloseArena(store, arena)
    return 0
