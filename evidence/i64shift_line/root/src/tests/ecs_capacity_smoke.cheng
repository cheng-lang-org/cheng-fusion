# ECS fixed-capacity (64-slot) smoke:
#   1. spawn 64 entities, per-entity position/velocity read/write, stable
#      deterministic fingerprint (rebuild equal, mutation differs)
#   2. 65th spawn hard-fails loudly (re-exec self with "overflow" arg,
#      expect exit 1 + panic message; silent drop must not pass)
#   3. 64 entities through Physics2dStep for 240 ticks: same initial state
#      yields identical per-tick receipt fingerprints and final world hash
import std/cmdline
import std/os
import std/strutils as strutil
import std/os_host_process as hostos
import cheng/game/ecs
import cheng/game/physics2d

fn buildFullWorld(world: var ecs.EcsWorld) =
    ecs.EcsWorldReset(world)
    for i in 0..<ecs.EcsCapacity:
        let id = ecs.EcsWorldSpawn(world, i * 2000, 100 + i, 1 + i % 7, "cid:slot")
        assert(id == i + 1, "ecs capacity: spawn id sequential")
    for i in 0..<ecs.EcsCapacity:
        let id = i + 1
        assert(ecs.EcsWorldSetPosition(world, id, i * 10 + 5, i * 3 + 1), "ecs capacity: set position")
        assert(ecs.EcsWorldSetVelocity(world, id, 100 - i, i - 32), "ecs capacity: set velocity")

fn checkReadWriteAndFingerprint() =
    var worldA: ecs.EcsWorld
    var worldB: ecs.EcsWorld
    buildFullWorld(worldA)
    buildFullWorld(worldB)
    assert(ecs.EcsWorldEntityCount(worldA) == ecs.EcsCapacity, "ecs capacity: count == 64")
    assert(ecs.EcsWorldColumnsValid(worldA), "ecs capacity: columns valid at full load")
    for i in 0..<ecs.EcsCapacity:
        assert(ecs.EcsWorldEntityIdAt(worldA, i) == i + 1, "ecs capacity: entity id readback")
        assert(ecs.EcsWorldPositionXAt(worldA, i) == i * 10 + 5, "ecs capacity: position x readback")
        assert(ecs.EcsWorldPositionYAt(worldA, i) == i * 3 + 1, "ecs capacity: position y readback")
        assert(ecs.EcsWorldVelocityXAt(worldA, i) == 100 - i, "ecs capacity: velocity x readback")
        assert(ecs.EcsWorldVelocityYAt(worldA, i) == i - 32, "ecs capacity: velocity y readback")
        assert(ecs.EcsWorldMassAt(worldA, i) == 1 + i % 7, "ecs capacity: mass readback")
    let cidA = ecs.EcsWorldCid(worldA)
    assert(cidA.len == 64, "ecs capacity: world cid is sha256 hex")
    assert(cidA == ecs.EcsWorldCid(worldB), "ecs capacity: world cid stable across rebuild")
    assert(ecs.EcsWorldSetPosition(worldB, 64, 999999, 0), "ecs capacity: mutate last slot")
    assert(ecs.EcsWorldCid(worldB) != cidA, "ecs capacity: mutation changes world cid")
    echo("ecs capacity smoke 1 ok: 64-slot read/write + stable world cid")

fn overflowChild(): int32 =
    var world: ecs.EcsWorld
    ecs.EcsWorldReset(world)
    for i in 0..<ecs.EcsCapacity:
        let id = ecs.EcsWorldSpawn(world, i * 2000, 0, 1, "cid:slot")
        assert(id == i + 1, "ecs capacity overflow child: spawn id")
    let _extra = ecs.EcsWorldSpawn(world, 0, 0, 1, "cid:overflow")
    echo("ecs capacity overflow child: 65th spawn did not hard-fail")
    return 3

fn checkOverflowHardFail() =
    let selfPath = cmdline.paramStr(0)
    let res = hostos.ExecFileCapture(selfPath, ["overflow"], [], "", true, 60)
    assert(os.ExecCmdResultExitCode(res) == 1, "ecs capacity: 65th spawn exits 1 (panic)")
    assert(strutil.Contains(os.ExecCmdResultOutput(res), "capacity exceeded"),
        "ecs capacity: 65th spawn panics loudly with capacity message")
    echo("ecs capacity smoke 2 ok: 65th spawn hard-fails (exit 1, loud panic)")

fn buildPhysicsWorld(world: var ecs.EcsWorld) =
    ecs.EcsWorldReset(world)
    for i in 0..<ecs.EcsCapacity:
        let id = ecs.EcsWorldSpawn(world, i * 1500, 0, 1, "cid:body")
        assert(ecs.EcsWorldSetAabbCollider(world, id, 500, 500), "ecs capacity: physics collider")
        if i % 2 == 0:
            assert(ecs.EcsWorldSetVelocity(world, id, 400, 0), "ecs capacity: physics velocity even")
        else:
            assert(ecs.EcsWorldSetVelocity(world, id, -400, 0), "ecs capacity: physics velocity odd")

fn checkStepDeterminism() =
    var worldA: ecs.EcsWorld
    var worldB: ecs.EcsWorld
    buildPhysicsWorld(worldA)
    buildPhysicsWorld(worldB)
    var contactTotal: int32
    var tick: int32 = 1
    while tick <= 240:
        let receiptA = physics2d.Physics2dStep(worldA, tick, 16)
        let receiptB = physics2d.Physics2dStep(worldB, tick, 16)
        assert(receiptA.statusCode == physics2d.Physics2dStatusOk, "ecs capacity: step status ok")
        assert(physics2d.Physics2dReceiptValid(receiptA), "ecs capacity: step receipt A valid")
        assert(physics2d.Physics2dReceiptValid(receiptB), "ecs capacity: step receipt B valid")
        assert(receiptA.receiptCid == receiptB.receiptCid,
            "ecs capacity: per-tick receipt cid identical")
        contactTotal = contactTotal + receiptA.contactCount
        tick = tick + 1
    assert(ecs.EcsWorldCid(worldA) == ecs.EcsWorldCid(worldB), "ecs capacity: final world cid identical")
    assert(contactTotal > 0, "ecs capacity: 240-tick run produced contacts")
    echo("ecs capacity smoke 3 ok: 64 entities x 240 ticks deterministic")

fn main(): int32 =
    if cmdline.paramStr(1) == "overflow":
        return overflowChild()
    checkReadWriteAndFingerprint()
    checkOverflowHardFail()
    checkStepDeterminism()
    echo("ecs_capacity_smoke ok: 3/3 checks passed")
    return 0
