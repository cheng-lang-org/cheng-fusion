import std/system
import std/strings
import cheng/core/runtime/web_runtime as web
import cheng/apps/libp2p_browser/compile_render as compile
import cheng/apps/libp2p_browser/session as sess
import cheng/apps/libp2p_browser/computer_use_session as cuse
import cheng/apps/libp2p_browser/computer_use_command as cmd

fn fail(code: int32, msg: str): int32 =
    echo(msg)
    return code

# 夹具同 cuse_smoke, 追加 box5 checkbox(Newsletter, checked)。
fn fixture(): str =
    var s: str = "CLB4\n400 600 6 1\n"
    s = strings.ConcatStr(s, "4 10 20 120 32 -1 -16777216 14 1 -16777216 2 400 0 0 0 0 0 0 0 400 600\nbutton\n\nbutton\nbtnOk\nGo\nGo\nsans-serif\n\n\n")
    s = strings.ConcatStr(s, "1 10 70 200 32 -1 -16777216 14 1 -16777216 2 400 0 0 0 0 0 0 0 400 600\ntext\n\ntext\nq\n\n\nsans-serif\n\n\n")
    s = strings.ConcatStr(s, "6 10 120 180 32 -1 -16777216 14 1 -16777216 2 400 0 0 0 0 0 0 0 400 600\nselect\n\nselect-one\ns\n\n\nsans-serif\n\n0\ta\tAlpha%0A0\tb\tBeta%0A1\tc\tGamma\n")
    s = strings.ConcatStr(s, "1 10 170 200 32 -1 -16777216 14 1 -16777216 2 400 0 0 0 0 0 0 0 400 600\ntext\n\ntext\nfrozen\n\n\nsans-serif\n\n\n")
    s = strings.ConcatStr(s, "1 10 220 200 32 -1 -16777216 14 1 -16777216 2 400 0 0 0 0 0 0 0 400 600\nnumber\n\nnumber\nn\n\n\nsans-serif\n\n\n")
    s = strings.ConcatStr(s, "1 10 270 200 20 -1 -16777216 13 0 0 0 400 0 0 0 0 0 0 0 400 600\ncheckbox\n\ncheckbox\nnl\non\n\nsans-serif\n\n\n")
    s = strings.ConcatStr(s, "CTL|0|3|0|button|Go\n")
    s = strings.ConcatStr(s, "CTL|1|4|0||Quantity\n")
    s = strings.ConcatStr(s, "CTL|2|5|0||Choose\n")
    s = strings.ConcatStr(s, "CTL|3|6|1||Frozen\n")
    s = strings.ConcatStr(s, "CTL|4|7|0||Count\n")
    s = strings.ConcatStr(s, "CTL|5|8|4||Newsletter\n")
    return s

fn main(): int32 =
    let src = fixture()
    var session = sess.BrowserSessionInit("cmd-peer", 400, 600)
    if !sess.BrowserSessionOnPageSnapshot(session, "https://ex.test/cmd", src):
        echo(session.lastError)
        return fail(1, "cmd session snapshot")
    var err: str = ""
    # 英文动词 + name 检索
    if cmd.BrowserCuseCommand(session, "click Go", "", false, err) != 0:
        echo(err)
        return fail(2, "click en")
    if session.applyCtlId != 3 || session.applyAction != "Click":
        return fail(3, "click apply")
    # 中文动词 + name 检索
    if cmd.BrowserCuseCommand(session, "输入 Quantity 7", "", false, err) != 0:
        echo(err)
        return fail(4, "settext zh")
    if session.applyCtlId != 4 || session.applyValue != "7" || session.applyAction != "SetText":
        return fail(5, "settext apply")
    # number 输入框 + 纯数字载荷 → SetNumber
    if cmd.BrowserCuseCommand(session, "设置 Count 5", "", false, err) != 0:
        echo(err)
        return fail(6, "setnumber")
    if session.applyAction != "SetNumber" || session.applyValue != "5":
        return fail(7, "setnumber apply")
    # 非数字载荷走 SetText
    if cmd.BrowserCuseCommand(session, "填 Quantity abc", "", false, err) != 0:
        echo(err)
        return fail(8, "settext fallback")
    if session.applyAction != "SetText" || session.applyValue != "abc":
        return fail(9, "settext fallback apply")
    # select: label 命中映射 value
    if cmd.BrowserCuseCommand(session, "选择 Choose Beta", "", false, err) != 0:
        echo(err)
        return fail(10, "select zh")
    if session.applyCtlId != 5 || session.applyAction != "Select" || session.applyValue != "b":
        return fail(11, "select apply")
    # Toggle checkbox: cheng 侧 checked 翻转
    var checkedBefore = false
    var nlIdx = cmd.BrowserCuseFindByName(session, "Newsletter")
    if nlIdx < 0:
        return fail(12, "find checkbox")
    web.WebDocumentGetChecked(session.document, session.widgets[nlIdx].nodeId, checkedBefore)
    if cmd.BrowserCuseCommand(session, "切换 Newsletter", "", false, err) != 0:
        echo(err)
        return fail(13, "toggle zh")
    var checkedAfter = true
    web.WebDocumentGetChecked(session.document, session.widgets[nlIdx].nodeId, checkedAfter)
    if checkedAfter == checkedBefore:
        return fail(14, "toggle must flip checked")
    # 确认门沿动作层生效
    if cmd.BrowserCuseCommand(session, "点击 Go", "external-publish", false, err) != -3:
        return fail(15, "cmd confirmation gate")
    if err != "computer_use_e_confirmation_required":
        return fail(16, "cmd confirmation err")
    # hard-fail 矩阵
    if cmd.BrowserCuseCommand(session, "点击 不存在的按钮", "", false, err) != -1:
        return fail(17, "unknown target")
    if err != "cuse_e_no_control":
        return fail(18, "unknown target err")
    if cmd.BrowserCuseCommand(session, "奔跑 Go", "", false, err) != -10:
        return fail(19, "unknown verb")
    if cmd.BrowserCuseCommand(session, "点击", "", false, err) != -10:
        return fail(20, "missing target")
    if cmd.BrowserCuseCommand(session, "", "", false, err) != -10:
        return fail(21, "empty command")
    # disabled 目标经 name 检索同样拒绝
    if cmd.BrowserCuseCommand(session, "输入 Frozen x", "", false, err) != -2:
        return fail(22, "disabled via name")
    # 控件树序列化
    let tree = cmd.BrowserCuseControlTreeText(session)
    var hasGo = false
    var hasNl = false
    var ti: int32 = 0
    while ti + 12 <= tree.len:
        if tree[ti] == '3' && tree[ti + 1] == '|' && tree[ti + 2] == '4' && tree[ti + 3] == '|':
            hasGo = true
        if tree[ti] == '8' && tree[ti + 1] == '|' && tree[ti + 2] == '1' && tree[ti + 3] == '|' && tree[ti + 4] == '4':
            hasNl = true
        ti = ti + 1
    if !hasGo || !hasNl:
        return fail(23, "control tree text")
    echo("libp2p_browser_command_smoke ok")
    return 0
