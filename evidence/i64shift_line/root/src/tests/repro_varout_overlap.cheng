import std/rawbytes

var g: rawbytes.Bytes

fn encode(var a: int32[], var b: int32[]): bool =
    a = [1, 2, 3]
    b = [4, 5, 6]
    return true

fn pack(bytes: var rawbytes.Bytes, words: var int32[]): bool =
    if rawbytes.BytesLen(bytes) != words.len * 4:
        return false
    return true

fn main(): int32 =
    var hostEntryBatch: int32[]
    var hostPixelBatch: int32[]
    if !encode(hostEntryBatch, hostPixelBatch):
        return 1
    if !pack(g, hostEntryBatch):
        return 2
    return 0
