# csgworld roundtrip probe (G2): the pure-CSG delivery loop. Save the
# climb world as a .csgworld file, load it back, verify the CID matches,
# materialize both and verify the worlds are identical, then report the
# size ratio against the H.264 deliverable.
import cheng/game/csg/schema
import cheng/game/csg/csgworld
import cheng/game/csg/validation
import cheng/game/csg/producer
import cheng/game/csg/materializer
import cheng/game/world3d
import std/os
import std/strings as strings

const
    ProbeDir = "artifacts/csg_world_video/csgworld"

# The canonical world CID is the "same world" contract: quantized
# fields hash equal even when float64 values differ by ULPs.
@borrows
fn worldCidEquals(a: world3d.World3d, b: world3d.World3d): bool =
    let ca: str = Fmt"{world3d.World3dCid(a)}"
    let cb: str = Fmt"{world3d.World3dCid(b)}"
    return ca == cb

fn main(): int32 =
    os.MkdirAll(ProbeDir, 493)
    var facts: schema.CsgWorldFacts = producer.CsgProducerBuildClimbScene()
    let cid: str = Fmt"{schema.CsgWorldFactsCid(facts)}"
    var savePath: str = csgworld.CsgWorldPath(ProbeDir, "climb")
    var loadPath: str = csgworld.CsgWorldPath(ProbeDir, "climb")
    savePath = Fmt"{savePath}"
    loadPath = Fmt"{loadPath}"
    csgworld.CsgWorldSave(facts, cid, savePath)
    # load back from an independent owned path copy
    var loaded: schema.CsgWorldFacts
    let loadedCid: str = csgworld.CsgWorldLoad(loadPath, loaded)
    if loadedCid != cid:
        echo("FAIL cid mismatch")
        echo("loaded=" + loadedCid)
        echo("want  =" + cid)
        return 1
    let cid2: str = Fmt"{schema.CsgWorldFactsCid(loaded)}"
    if cid2 != cid:
        echo("FAIL roundtrip cid drift")
        let preA: str = Fmt"{schema.CsgWorldFactsCanonicalPreimage(facts)}"
        let preB: str = Fmt"{schema.CsgWorldFactsCanonicalPreimage(loaded)}"
        var di: int32 = 0
        var n: int32 = preA.len
        if preB.len < n:
            n = preB.len
        while di < n:
            if preA[di] != preB[di]:
                break
            di = di + 1
        echo("preA len=" + strings.IntToStr(preA.len) + " preB len=" + strings.IntToStr(preB.len) + " firstDiff=" + strings.IntToStr(di))
        echo("preA ctx=" + strings.CloneStrRange(preA, di - 24, 48))
        echo("preB ctx=" + strings.CloneStrRange(preB, di - 24, 48))
        return 1
    # materialize both worlds and compare
    var w1: world3d.World3d
    var mp1: materializer.CsgMaterializerMapping
    var w2: world3d.World3d
    var mp2: materializer.CsgMaterializerMapping
    var err: str = ""
    if !materializer.CsgMaterialize(facts, w1, mp1, err):
        echo("FAIL materialize original")
        return 1
    if !materializer.CsgMaterialize(loaded, w2, mp2, err):
        echo("FAIL materialize loaded")
        return 1
    if !worldCidEquals(w1, w2):
        echo("FAIL world cid mismatch after roundtrip")
        return 1
    # size accounting
    let csgBytes: int32 = int32(strings.Len(os.ReadFile(loadPath)))
    var mp4Bytes: int32 = 0
    if os.FileExists("artifacts/csg_world_video/climb_film.mp4"):
        let mp4: str = os.ReadFile("artifacts/csg_world_video/climb_film.mp4")
        mp4Bytes = mp4.len
    echo("csgworld bytes=" + strings.IntToStr(csgBytes) + " mp4 bytes=" + strings.IntToStr(mp4Bytes))
    echo("PASS csgworld roundtrip probe")
    return 0
