import std/atomic
import std/strings
import std/strutils
import std/thread

const
    eventLockWorkerCount: int32 = 4
    eventLockRounds: int32 = 128
    eventLockExpectedAcquires: int32 = 512
    eventLockExpectedAuditTotal: int32 = 513
    eventLockAuditMagic: int32 = 1163283538
    eventLockAuditBytes: int32 = 28

@importc("cheng_host_pipe_runtime")
fn cheng_host_pipe_runtime(fds: var int32[2]): int32

@importc("cheng_host_read_runtime")
fn cheng_host_read_runtime(
    fd: int32,
    data: var uint8,
    count: int32): int64

@importc("cheng_host_write_runtime")
fn cheng_host_write_runtime(
    fd: int32,
    data: var uint8,
    count: int32): int64

@importc("cheng_host_close")
fn cheng_host_close(fd: int32): int32

@importc("cheng_native_runtime_event_lock_bridge")
fn runtimeEventLock(): void

@importc("cheng_native_runtime_event_assert_owner_bridge")
fn runtimeEventAssertOwner(): void

@importc("cheng_native_runtime_event_unlock_bridge")
fn runtimeEventUnlock(): void

@importc("cheng_linux_runtime_event_waiter_barrier_bridge")
fn runtimeEventWaiterBarrier(expectedWaiters: int32): int32

@importc("cheng_linux_runtime_event_audit_snapshot_bridge")
fn runtimeEventAuditSnapshot(out: var int32[7]): int32

type
    EventLockRaceCtx =
        acquireCount: atomic.I32
        readyPipe: int32[2]
        startPipe: int32[2]
        preLockPipe: int32[2]
        donePipe: int32[2]

var eventLockRaceCtx: EventLockRaceCtx

fn eventWrite(fd: int32) =
    var token: uint8 = uint8(1)
    assert(cheng_host_write_runtime(fd, token, 1) == int64(1),
           " runtime event lock: event write")

fn eventRead(fd: int32) =
    var token: uint8
    assert(cheng_host_read_runtime(fd, token, 1) == int64(1),
           " runtime event lock: event read")
    assert(token == uint8(1), " runtime event lock: event token")

fn EventLockRaceWorker() =
    eventWrite(eventLockRaceCtx.readyPipe[1])
    eventRead(eventLockRaceCtx.startPipe[0])
    eventWrite(eventLockRaceCtx.preLockPipe[1])
    for _ in 0..<eventLockRounds:
        runtimeEventLock()
        runtimeEventAssertOwner()
        let _ = atomic.AddI32(eventLockRaceCtx.acquireCount, 1)
        runtimeEventUnlock()
    eventWrite(eventLockRaceCtx.donePipe[1])

fn closeEventPipe(fds: var int32[2]) =
    assert(cheng_host_close(fds[0]) == 0,
           " runtime event lock: event pipe read close")
    assert(cheng_host_close(fds[1]) == 0,
           " runtime event lock: event pipe write close")

fn main(): int32 =
    assert(cheng_host_pipe_runtime(eventLockRaceCtx.readyPipe) == 0,
           " runtime event lock: ready pipe")
    assert(cheng_host_pipe_runtime(eventLockRaceCtx.startPipe) == 0,
           " runtime event lock: start pipe")
    assert(cheng_host_pipe_runtime(eventLockRaceCtx.preLockPipe) == 0,
           " runtime event lock: pre-lock pipe")
    assert(cheng_host_pipe_runtime(eventLockRaceCtx.donePipe) == 0,
           " runtime event lock: done pipe")

    eventLockRaceCtx.acquireCount = atomic.NewI32(0)
    assert(eventLockRaceCtx.acquireCount != nil,
           " runtime event lock: shared counter")

    let worker0 = thread.StartFn(EventLockRaceWorker)
    let worker1 = thread.StartFn(EventLockRaceWorker)
    let worker2 = thread.StartFn(EventLockRaceWorker)
    let worker3 = thread.StartFn(EventLockRaceWorker)

    for _ in 0..<eventLockWorkerCount:
        eventRead(eventLockRaceCtx.readyPipe[0])
    runtimeEventLock()
    runtimeEventAssertOwner()
    for _ in 0..<eventLockWorkerCount:
        eventWrite(eventLockRaceCtx.startPipe[1])
    for _ in 0..<eventLockWorkerCount:
        eventRead(eventLockRaceCtx.preLockPipe[0])
    assert(runtimeEventWaiterBarrier(eventLockWorkerCount) == 0,
           " runtime event lock: provider waiter barrier")
    runtimeEventAssertOwner()
    runtimeEventUnlock()

    for _ in 0..<eventLockWorkerCount:
        eventRead(eventLockRaceCtx.donePipe[0])
    assert(thread.JoinThread(worker0),
           " runtime event lock: worker 0 joined")
    assert(thread.JoinThread(worker1),
           " runtime event lock: worker 1 joined")
    assert(thread.JoinThread(worker2),
           " runtime event lock: worker 2 joined")
    assert(thread.JoinThread(worker3),
           " runtime event lock: worker 3 joined")
    assert(atomic.LoadI32(eventLockRaceCtx.acquireCount) ==
           eventLockExpectedAcquires,
           " runtime event lock: exact acquisition count")

    var audit: int32[7]
    assert(runtimeEventAuditSnapshot(audit) == eventLockAuditBytes,
           " runtime event lock: audit snapshot bytes")
    assert(audit[0] == eventLockAuditMagic,
           " runtime event lock: audit magic")
    assert(audit[1] >= eventLockWorkerCount,
           " runtime event lock: registered total")
    assert(audit[2] == 0,
           " runtime event lock: current waiters drained")
    assert(audit[3] >= 1,
           " runtime event lock: lock wake call total")
    assert(audit[4] >= 1,
           " runtime event lock: lock wake success total")
    assert(audit[4] <= audit[3],
           " runtime event lock: lock wake receipt order")
    assert(audit[5] == eventLockExpectedAuditTotal,
           " runtime event lock: provider acquire total")
    assert(audit[6] == eventLockExpectedAuditTotal,
           " runtime event lock: provider unlock total")

    closeEventPipe(eventLockRaceCtx.readyPipe)
    closeEventPipe(eventLockRaceCtx.startPipe)
    closeEventPipe(eventLockRaceCtx.preLockPipe)
    closeEventPipe(eventLockRaceCtx.donePipe)
    echo(strutils.Join([
        "runtime_event_lock_provider_audit ",
        strings.IntToStr(audit[0]), " ",
        strings.IntToStr(audit[1]), " ",
        strings.IntToStr(audit[2]), " ",
        strings.IntToStr(audit[3]), " ",
        strings.IntToStr(audit[4]), " ",
        strings.IntToStr(audit[5]), " ",
        strings.IntToStr(audit[6])], ""))
    return 0
