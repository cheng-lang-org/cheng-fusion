# R17 mutant of the positive: expects the WRONG value for r.a. Must run and
# exit 14 (a real return, not a signal) -- proves the assertions are live.
import std/system

type
    R17VBundle =
        a: int32
        b: int64
        c: int32

var tkR17MGlobal: R17VBundle

fn TkR17MRetGlobal(): R17VBundle =
    return tkR17MGlobal

fn main(): int32 =
    tkR17MGlobal.a = -31
    tkR17MGlobal.b = 9007199254740993
    tkR17MGlobal.c = 77
    let r = TkR17MRetGlobal()
    if r.a != -31:
        return 10
    tkR17MGlobal.a = 5
    if r.a != 5:
        return 14
    echo("tk_r17_mutant unexpected")
    return 0
