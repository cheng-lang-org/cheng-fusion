import std.cocoa

fn main(): int32 =
    logMsg("Cheng GUI starting")
    appInit()
    var win = windowCreate("Cheng Native Window", 800, 600)
    windowShow(win)
    // 简单循环保持窗口存在 3 秒
    var counter: int32
    while counter < 180:
        pollEvent()
        counter = counter + 1
    windowClose(win)
    logMsg("Cheng GUI done")
    return 0
