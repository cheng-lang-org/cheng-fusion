import cheng/core/ir/body_ir_noalias as noalias
import cheng/tests/noalias_finalize_stage_probe_lib as probe

fn main(): int32 =
    var bodyIR = probe.ProbeForwardBody(true)
    noalias.BodyIrAnalyzeOwnership(bodyIR)
    let forwarded = noalias.BodyIrNoAliasForwardLocals(bodyIR)
    return noalias.BodyIrNoAliasRewriteCount(bodyIR, forwarded)
