import std/rawbytes
import std/strings
import cheng/core/csg_core/csgc
import cheng/core/csg_core/merkle_transaction_request as request

const
    RequestCidA: str =
        "sha256:1111111111111111111111111111111111111111111111111111111111111111"
    RequestCidB: str =
        "sha256:2222222222222222222222222222222222222222222222222222222222222222"
    RequestCidC: str =
        "sha256:3333333333333333333333333333333333333333333333333333333333333333"
    RequestCidD: str =
        "sha256:4444444444444444444444444444444444444444444444444444444444444444"
    RequestCidE: str =
        "sha256:5555555555555555555555555555555555555555555555555555555555555555"

@borrows
fn requestAssert(ok: bool, message: str) =
    if !ok:
        panic(message)

@borrows
fn requestFact(
        key: str,
        cid: str):
        request.CsgCoreMerkleTransactionRequestFact =
    var out: request.CsgCoreMerkleTransactionRequestFact
    out.factKey = strings.CloneStr(key)
    out.factCid = strings.CloneStr(cid)
    return out

@borrows
fn requestDependency(
        sourceId: str,
        factKind: str,
        selector: str):
        request.CsgCoreMerkleTransactionRequestDependency =
    var out: request.CsgCoreMerkleTransactionRequestDependency
    out.providerSource = strings.CloneStr(sourceId)
    out.providerFactKind = strings.CloneStr(factKind)
    out.selector = strings.CloneStr(selector)
    return out

@borrows
fn requestReplacementA(
        reverse: bool):
        request.CsgCoreMerkleTransactionRequestReplacement =
    var out: request.CsgCoreMerkleTransactionRequestReplacement
    out.sourceId = "source-a"
    out.sourceCid = RequestCidA
    if reverse:
        add(out.facts, requestFact("id:z", RequestCidC))
        add(out.facts, requestFact("id:a", RequestCidB))
        add(
            out.dependencies,
            requestDependency(
                "source-z", "type", "selector-z"))
        add(
            out.dependencies,
            requestDependency(
                "source-b", "symbol", "selector-a"))
    else:
        add(out.facts, requestFact("id:a", RequestCidB))
        add(out.facts, requestFact("id:z", RequestCidC))
        add(
            out.dependencies,
            requestDependency(
                "source-b", "symbol", "selector-a"))
        add(
            out.dependencies,
            requestDependency(
                "source-z", "type", "selector-z"))
    return out

fn requestReplacementB():
        request.CsgCoreMerkleTransactionRequestReplacement =
    var out: request.CsgCoreMerkleTransactionRequestReplacement
    out.sourceId = "source-b"
    out.sourceCid = RequestCidD
    add(out.facts, requestFact("id:b", RequestCidE))
    return out

fn requestInput(reverse: bool):
        request.CsgCoreMerkleTransactionRequest =
    var out: request.CsgCoreMerkleTransactionRequest
    out.expectedBeforeHeadCid = RequestCidA
    if reverse:
        add(out.changedSources, "source-b")
        add(out.changedSources, "source-a")
        add(out.replacements, requestReplacementB())
        add(out.replacements, requestReplacementA(true))
    else:
        add(out.changedSources, "source-a")
        add(out.changedSources, "source-b")
        add(out.replacements, requestReplacementA(false))
        add(out.replacements, requestReplacementB())
    return out

@borrows
fn requestPlan(
        requestCid: str,
        reverseOperations: bool):
        request.CsgCoreMerkleTransactionPlan =
    var out: request.CsgCoreMerkleTransactionPlan
    out.requestCid = strings.CloneStr(requestCid)
    out.beforeHeadCid = RequestCidA
    out.beforeManifestCid = RequestCidB
    out.beforeCsgcDirectoryCid = RequestCidC
    out.beforeFactsRoot = RequestCidD
    out.beforeDagRootCid = RequestCidA
    out.beforeFactCount = 2
    out.afterCsgcDirectoryCid = RequestCidD
    out.afterFactsRoot = RequestCidC
    out.afterDagRootCid = RequestCidB
    out.afterFactCount = 2
    out.invalidationCid = RequestCidD
    if reverseOperations:
        add(out.operationKinds, int32(3))
        add(out.operationFactKeys, "id:b")
        add(out.operationCids, RequestCidB)
        add(out.operationKinds, int32(2))
        add(out.operationFactKeys, "id:a")
        add(out.operationCids, RequestCidA)
    else:
        add(out.operationKinds, int32(2))
        add(out.operationFactKeys, "id:a")
        add(out.operationCids, RequestCidA)
        add(out.operationKinds, int32(3))
        add(out.operationFactKeys, "id:b")
        add(out.operationCids, RequestCidB)
    return out

fn requestExpectFailure(
        value: request.CsgCoreMerkleTransactionRequest,
        expected: str) =
    var encoded =
        request.CsgCoreMerkleTransactionRequestCid(value)
    requestAssert(!encoded.ok, "request_negative_accepted")
    requestAssert(
        encoded.error == expected,
        strings.ConcatStr(
            "request_negative_error ", encoded.error))
    request.CsgCoreMerkleTransactionRequestCidFree(
        encoded)

fn requestExpectPlanFailure(
        value: request.CsgCoreMerkleTransactionPlan,
        expected: str) =
    var encoded =
        request.CsgCoreMerkleTransactionPlanRoot(value)
    requestAssert(!encoded.ok, "plan_negative_accepted")
    requestAssert(
        encoded.error == expected,
        strings.ConcatStr(
            "plan_negative_error ", encoded.error))
    request.CsgCoreMerkleTransactionPlanRootFree(
        encoded)

fn main(): int32 =
    var first =
        request.CsgCoreMerkleTransactionRequestCid(
            requestInput(false))
    var reordered =
        request.CsgCoreMerkleTransactionRequestCid(
            requestInput(true))
    requestAssert(first.ok, first.error)
    requestAssert(reordered.ok, reordered.error)
    requestAssert(
        first.requestCid == reordered.requestCid,
        "request_permutation_changed_cid")
    requestAssert(
        rawbytes.BytesEqual(first.bytes, reordered.bytes),
        "request_permutation_changed_csgc")
    let decoded = csgc.CsgCoreCsgcDecodeLines(first.bytes)
    requestAssert(decoded.ok, decoded.error)
    requestAssert(
        decoded.headerSize == 64 &&
        decoded.flags == 0 &&
        decoded.factCount == first.factCount,
        "request_csgc_header_invalid")
    var artifactError: str
    let artifactCid =
        request.CsgCoreMerkleTransactionRequestArtifactCid(
            first.bytes, artifactError)
    requestAssert(
        artifactError.len == 0 &&
        artifactCid == first.requestCid,
        "request_artifact_cid_mismatch")
    let typedDecoded =
        request.CsgCoreMerkleTransactionRequestDecode(
            first.bytes)
    requestAssert(typedDecoded.ok, typedDecoded.error)
    requestAssert(
        typedDecoded.requestCid == first.requestCid &&
        typedDecoded.factCount == first.factCount &&
        typedDecoded.request.expectedBeforeHeadCid ==
            RequestCidA &&
        typedDecoded.request.changedSources.len == 2 &&
        typedDecoded.request.replacements.len == 2,
        "request_typed_decode_roundtrip_mismatch")
    var truncated =
        rawbytes.BytesSlice(
            first.bytes,
            0,
            rawbytes.BytesLen(first.bytes) - 1)
    let truncatedCid =
        request.CsgCoreMerkleTransactionRequestArtifactCid(
            truncated, artifactError)
    requestAssert(
        truncatedCid.len == 0 &&
        artifactError ==
            "merkle_transaction_request_artifact_decode_failed",
        "request_artifact_truncation_accepted")
    let truncatedDecoded =
        request.CsgCoreMerkleTransactionRequestDecode(
            truncated)
    requestAssert(
        !truncatedDecoded.ok,
        "request_typed_decode_truncation_accepted")
    rawbytes.BytesFree(truncated)
    var wrongKind =
        csgc.CsgCoreCsgcEncodeCanonicalLines(
            ["{\"id\":\"wrong\",\"kind\":\"csg.symbol\"}"])
    requestAssert(wrongKind.ok, wrongKind.error)
    let wrongKindCid =
        request.CsgCoreMerkleTransactionRequestArtifactCid(
            wrongKind.bytes, artifactError)
    requestAssert(
        wrongKindCid.len == 0 &&
        artifactError ==
            "merkle_transaction_request_artifact_kind_invalid",
        "request_artifact_wrong_kind_accepted")
    let wrongKindDecoded =
        request.CsgCoreMerkleTransactionRequestDecode(
            wrongKind.bytes)
    requestAssert(
        !wrongKindDecoded.ok &&
        wrongKindDecoded.error ==
            "merkle_transaction_request_decode_header_invalid",
        "request_typed_decode_wrong_kind_accepted")
    rawbytes.BytesFree(wrongKind.bytes)

    var repeated =
        request.CsgCoreMerkleTransactionRequestCid(
            requestInput(false))
    requestAssert(repeated.ok, repeated.error)
    requestAssert(
        repeated.requestCid == first.requestCid &&
        rawbytes.BytesEqual(repeated.bytes, first.bytes),
        "request_repeat_not_deterministic")

    var changedHead = requestInput(false)
    changedHead.expectedBeforeHeadCid = RequestCidD
    var changedHeadEncoded =
        request.CsgCoreMerkleTransactionRequestCid(
            changedHead)
    requestAssert(changedHeadEncoded.ok, changedHeadEncoded.error)
    requestAssert(
        changedHeadEncoded.requestCid != first.requestCid,
        "request_head_not_bound")

    var planForward =
        request.CsgCoreMerkleTransactionPlanRoot(
            requestPlan(first.requestCid, false))
    var planReverse =
        request.CsgCoreMerkleTransactionPlanRoot(
            requestPlan(first.requestCid, true))
    var planRepeated =
        request.CsgCoreMerkleTransactionPlanRoot(
            requestPlan(first.requestCid, false))
    requestAssert(planForward.ok, planForward.error)
    requestAssert(
        !planReverse.ok &&
        planReverse.error ==
            "merkle_transaction_plan_operation_order_invalid",
        "noncanonical plan operation order crossed admission")
    requestAssert(planRepeated.ok, planRepeated.error)
    requestAssert(
        planForward.factCount == 3,
        "plan_fact_count_invalid")
    requestAssert(
        planForward.planRoot == planRepeated.planRoot &&
        rawbytes.BytesEqual(
            planForward.bytes, planRepeated.bytes),
        "plan_repeat_not_deterministic")
    requestAssert(
        planForward.planRoot != first.requestCid,
        "request_plan_domain_not_separated")

    var mutatingZeroPlan = requestPlan(first.requestCid, false)
    mutatingZeroPlan.operationKinds = []
    mutatingZeroPlan.operationFactKeys = []
    mutatingZeroPlan.operationCids = []
    var noopPlan = requestPlan(first.requestCid, false)
    noopPlan.operationKinds = []
    noopPlan.operationFactKeys = []
    noopPlan.operationCids = []
    requestExpectPlanFailure(
        noopPlan,
        "merkle_transaction_plan_noop_transition_invalid")
    var zeroPlan = mutatingZeroPlan
    zeroPlan.afterCsgcDirectoryCid =
        strings.CloneStr(zeroPlan.beforeCsgcDirectoryCid)
    zeroPlan.afterFactsRoot =
        strings.CloneStr(zeroPlan.beforeFactsRoot)
    zeroPlan.afterDagRootCid =
        strings.CloneStr(zeroPlan.beforeDagRootCid)
    zeroPlan.afterFactCount = zeroPlan.beforeFactCount
    var zeroPlanRoot =
        request.CsgCoreMerkleTransactionPlanRoot(zeroPlan)
    requestAssert(zeroPlanRoot.ok, zeroPlanRoot.error)
    requestAssert(
        zeroPlanRoot.factCount == 1,
        "plan_zero_fact_count_invalid")

    var changedPlanHead = requestPlan(first.requestCid, false)
    changedPlanHead.beforeHeadCid = RequestCidE
    var changedPlanHeadRoot =
        request.CsgCoreMerkleTransactionPlanRoot(
            changedPlanHead)
    requestAssert(changedPlanHeadRoot.ok, changedPlanHeadRoot.error)
    requestAssert(
        changedPlanHeadRoot.planRoot != planForward.planRoot,
        "plan_before_head_not_bound")

    var changedOperationCid = requestPlan(first.requestCid, false)
    changedOperationCid.operationCids[0] = RequestCidE
    var changedOperationCidRoot =
        request.CsgCoreMerkleTransactionPlanRoot(
            changedOperationCid)
    requestAssert(
        changedOperationCidRoot.ok,
        changedOperationCidRoot.error)
    requestAssert(
        changedOperationCidRoot.planRoot != planForward.planRoot,
        "plan_operation_cid_not_bound")

    var badPlanShape = requestPlan(first.requestCid, false)
    badPlanShape.operationKinds = [int32(2)]
    requestExpectPlanFailure(
        badPlanShape,
        "merkle_transaction_plan_operation_shape_invalid")
    var badPlanCid = requestPlan(first.requestCid, false)
    badPlanCid.operationCids[0] = "sha256:bad"
    requestExpectPlanFailure(
        badPlanCid,
        "merkle_transaction_plan_operation_cid_invalid")
    var badPlanKind = requestPlan(first.requestCid, false)
    badPlanKind.operationKinds[0] = int32(4)
    requestExpectPlanFailure(
        badPlanKind,
        "merkle_transaction_plan_operation_kind_invalid")
    var badPlanKey = requestPlan(first.requestCid, false)
    badPlanKey.operationFactKeys[0] = ""
    requestExpectPlanFailure(
        badPlanKey,
        "merkle_transaction_plan_operation_fact_key_invalid")
    var duplicatePlanKey = requestPlan(first.requestCid, false)
    duplicatePlanKey.operationFactKeys[1] = "id:a"
    requestExpectPlanFailure(
        duplicatePlanKey,
        "merkle_transaction_plan_operation_duplicate")
    var duplicatePlanCid = requestPlan(first.requestCid, false)
    duplicatePlanCid.operationCids[1] =
        strings.CloneStr(duplicatePlanCid.operationCids[0])
    requestExpectPlanFailure(
        duplicatePlanCid,
        "merkle_transaction_plan_operation_cid_duplicate")

    var duplicateSource = requestInput(false)
    add(duplicateSource.changedSources, "source-a")
    requestExpectFailure(
        duplicateSource,
        "merkle_transaction_request_changed_source_duplicate")

    var duplicateReplacement = requestInput(false)
    add(
        duplicateReplacement.replacements,
        requestReplacementA(false))
    requestExpectFailure(
        duplicateReplacement,
        "merkle_transaction_request_replacement_duplicate")

    var duplicateFact = requestInput(false)
    add(
        duplicateFact.replacements[0].facts,
        requestFact("id:a", RequestCidE))
    requestExpectFailure(
        duplicateFact,
        "merkle_transaction_request_fact_duplicate")

    var duplicateDependency = requestInput(false)
    add(
        duplicateDependency.replacements[0].dependencies,
        requestDependency(
            "source-b", "symbol", "selector-a"))
    requestExpectFailure(
        duplicateDependency,
        "merkle_transaction_request_dependency_duplicate")

    var invalidCid = requestInput(false)
    invalidCid.replacements[0].facts[0].factCid = "sha256:00"
    requestExpectFailure(
        invalidCid,
        "merkle_transaction_request_fact_invalid")

    var overLimit: request.CsgCoreMerkleTransactionRequest
    overLimit.expectedBeforeHeadCid = RequestCidA
    for i in 0..request.CsgCoreMerkleTransactionRequestSourceLimit():
        add(
            overLimit.changedSources,
            strings.IntToStr(i))
    requestExpectFailure(
        overLimit,
        "merkle_transaction_request_source_count_limit_exceeded")

    request.CsgCoreMerkleTransactionRequestCidFree(first)
    request.CsgCoreMerkleTransactionRequestCidFree(reordered)
    request.CsgCoreMerkleTransactionRequestCidFree(repeated)
    request.CsgCoreMerkleTransactionRequestCidFree(
        changedHeadEncoded)
    request.CsgCoreMerkleTransactionPlanRootFree(planForward)
    request.CsgCoreMerkleTransactionPlanRootFree(planReverse)
    request.CsgCoreMerkleTransactionPlanRootFree(planRepeated)
    request.CsgCoreMerkleTransactionPlanRootFree(zeroPlanRoot)
    request.CsgCoreMerkleTransactionPlanRootFree(
        changedPlanHeadRoot)
    request.CsgCoreMerkleTransactionPlanRootFree(
        changedOperationCidRoot)
    echo("csg_core_merkle_transaction_request_smoke ok")
    echo("request_permutation_stable=1")
    echo("plan_operation_order_canonical=1")
    echo("plan_zero_operation_transition_bound=1")
    echo("plan_pre_execution_intent_bound=1")
    echo("request_plan_domain_separated=1")
    echo("request_artifact_replay_bound=1")
    echo("request_typed_decode_canonical=1")
    return 0
