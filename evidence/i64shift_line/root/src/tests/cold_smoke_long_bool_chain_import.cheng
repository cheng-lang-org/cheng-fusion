import cheng/tests/cold_bool_regression as br

fn main(): int32 =
    // isWriteMode: the exact original bug pattern
    assert(br.isWriteMode(1) == true, " wm: 1")
    assert(br.isWriteMode(2) == true, " wm: 2")
    assert(br.isWriteMode(3) == true, " wm: 3")
    assert(br.isWriteMode(0) == false, " wm: 0")
    assert(br.isWriteMode(4) == false, " wm: 4")
    assert(br.isWriteMode(99) == false, " wm: 99")

    // isSpecial
    assert(br.isSpecial(0) == true, " sp: 0")
    assert(br.isSpecial(-1) == true, " sp: -1")
    assert(br.isSpecial(255) == true, " sp: 255")
    assert(br.isSpecial(1) == false, " sp: 1")

    // isPathSep
    assert(br.isPathSep(47) == true, " ps: /")
    assert(br.isPathSep(92) == true, " ps: \\")
    assert(br.isPathSep(65) == false, " ps: A")

    // isSpace
    assert(br.isSpace(32) == true, " sp: space")
    assert(br.isSpace(9) == true, " sp: tab")
    assert(br.isSpace(13) == true, " sp: cr")
    assert(br.isSpace(10) == true, " sp: lf")
    assert(br.isSpace(65) == false, " sp: A")

    echo(" cold_smoke_long_bool_chain_import ok")
    return 0
