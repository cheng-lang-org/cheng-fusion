import cheng/core/backend/direct_object_emit as direct
import cheng/core/backend/primary_object_plan as pobj

fn main(): int32 =
    var plan: pobj.PrimaryObjectPlan
    add(plan.dataLabels, "truncated-raw")
    add(plan.dataPayloadTexts, "-")
    add(plan.dataPayloadRawByteCounts, 4)
    add(plan.dataPayloadRawBytes, 1)
    add(plan.dataPayloadRawBytes, 2)
    add(plan.dataPayloadRawBytes, 3)
    let _ = direct.DirectObjectEmitPlanData(plan, 0)
    return 1
