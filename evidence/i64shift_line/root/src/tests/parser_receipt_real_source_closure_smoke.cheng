import cheng/core/lang/parser as parser
import cheng/core/tooling/compiler_parser_receipt as parser_receipt
import cheng/std/os as os

fn RealSourceReceiptScopeEndLine(lines: str[], startLine: int32): int32 =
    var endLine = startLine
    var parenDepth: int32
    let firstLine = parser.ParserStripLineCommentSlashAware(
        lines[startLine - 1])
    for column in 0..<firstLine.len:
        if firstLine[column] == '(':
            parenDepth = parenDepth + 1
        elif firstLine[column] == ')':
            parenDepth = parenDepth - 1
    if startLine + 1 > lines.len:
        return endLine
    for lineNumber in (startLine + 1)..lines.len:
        let rawLine = lines[lineNumber - 1]
        let significant = parser.ParserStripLineCommentSlashAware(rawLine)
        var significantStart: int32
        var significantStop: int32
        if !parser.ParserTrimmedLineRange(
               significant, significantStart, significantStop):
            continue
        if !parser.ParserHasLeadingIndent(rawLine) && parenDepth <= 0:
            return endLine
        for column in significantStart..<significantStop:
            if significant[column] == '(':
                parenDepth = parenDepth + 1
            elif significant[column] == ')':
                parenDepth = parenDepth - 1
        endLine = lineNumber
    return endLine

fn RealSourceReceiptCheck(path: str,
                          sourceIndex: int32,
                          functionBase: var int32,
                          exactNormalizedTree: bool) =
    let source = os.ReadFile(path)
    assert(source != "", Fmt"parser receipt real closure: source empty {path}")
    let lines = parser.ParserSplitChar(source, '\n')
    var declarations: parser.NormalizedFunctionDecl[]
    var err: str
    assert(parser.ParserReadNormalizedFunctionDecls(
               source, declarations, err),
           Fmt"parser receipt real closure: declarations failed path={path} err={err}")
    var identities: parser_receipt.ParserNormalizedExprFunctionIdentity[]
    for declarationIndex in 0..<declarations.len:
        let declaration = declarations[declarationIndex]
        if declaration.importc:
            continue
        let endLine = RealSourceReceiptScopeEndLine(
            lines, declaration.lineIndex)
        add(identities,
            parser_receipt.ParserNormalizedExprFunctionIdentityMake(
                sourceIndex,
                functionBase,
                path,
                "diag/real_source_closure",
                declaration.name,
                declaration.lineIndex,
                endLine))
        functionBase = functionBase + 1
    var sidecar: parser_receipt.ParserCanonicalSourceSidecar
    assert(parser_receipt.ParserCanonicalSourceSidecarBuildFromSourceInto(
               sourceIndex,
               source,
               false,
               identities,
               declarations,
               sidecar,
               err),
           Fmt"parser receipt real closure: build failed path={path} err={err}")
    assert(parser_receipt.ParserCanonicalSourceSidecarStrictValidateInto(
               sidecar, err),
           Fmt"parser receipt real closure: validate failed path={path} err={err}")
    if exactNormalizedTree:
        var profile: parser.NormalizedExprCallProfile
        profile.sourcePath = path
        profile.text = source
        profile.lines = lines
        for declarationIndex in 0..<declarations.len:
            let declaration = declarations[declarationIndex]
            if declaration.importc:
                add(profile.importcCallNames, declaration.name)
            else:
                add(profile.localCallNames, declaration.name)
        parser.ParserJoinContinuationLinesInPlace(profile.lines)
        var profiles = [profile]
        let profileLookup =
            parser.ParserSourcePathIndexLookupBuild(profiles)
        var profileCache: parser.ParserProfileCallLookupCacheEntry[]
        var exactLayer: parser.NormalizedExprLayer
        assert(parser.ParserReadNormalizedExprLayerFromTextWithKnownCallsAndProfilesCachedWithCurrentLines(
                   path,
                   source,
                   profile.importcCallNames,
                   profile.localCallNames,
                   [],
                   profile,
                   profile.lines,
                   profiles,
                   profileLookup,
                   profileCache,
                   exactLayer,
                   err),
               Fmt"parser receipt real closure: exact layer failed path={path} err={err}")
        var parserInputText: str
        var coordinateMap: parser.ParserSourceRewriteCoordinateMap
        assert(parser.ParserRewriteMultilineStringSourceTextWithCoordinateMap(
                   source, parserInputText, coordinateMap, err),
               Fmt"parser receipt real closure: rewrite failed path={path} err={err}")
        var exactSidecar: parser_receipt.ParserCanonicalSourceSidecar
        assert(parser_receipt.ParserCanonicalSourceSidecarBuildInto(
                   sourceIndex,
                   source,
                   parserInputText,
                   exactLayer.valueExprTree,
                   identities,
                   declarations,
                   exactSidecar,
                   err),
               Fmt"parser receipt real closure: exact sidecar failed path={path} err={err}")
        assert(parser_receipt.ParserCanonicalSourceSidecarStrictValidateInto(
                   exactSidecar, err),
               Fmt"parser receipt real closure: exact validate failed path={path} err={err}")
        parser.NormalizedExprLayerReset(exactLayer)
    if sourceIndex == 1:
        var declarationFunctionCount: int32
        var lastFunctionDeclaration: int32 = -1
        for declarationRow in 0..<sidecar.declarationKinds.len:
            if sidecar.declarationKinds[declarationRow] ==
                   Int32(parser.ParserDeclarationFunction):
                declarationFunctionCount = declarationFunctionCount + 1
                lastFunctionDeclaration = declarationRow
        assert(declarationFunctionCount > sidecar.functionIndexes.len &&
               lastFunctionDeclaration >= 0,
               "parser receipt real closure: importc domain was not separated")
        var functionRowTamper =
            parser_receipt.ParserCanonicalSourceSidecarClone(sidecar)
        functionRowTamper.declarationFunctionRows[
            lastFunctionDeclaration] = 0
        assert(!parser_receipt.ParserCanonicalSourceSidecarStrictValidateInto(
                   functionRowTamper, err),
               "parser receipt real closure: duplicate parser function row survived")

fn main() =
    let root = os.GetCurrentDir()
    var paths: str[]
    add(paths, "/tmp/rb.cheng")
    add(paths, os.JoinPath(root, "src/std/os.cheng"))
    add(paths, os.JoinPath(root, "src/std/rawbytes.cheng"))
    add(paths, os.JoinPath(root, "src/std/strings.cheng"))
    add(paths, os.JoinPath(root, "src/std/cmdline.cheng"))
    add(paths, os.JoinPath(root, "src/std/buffer.cheng"))
    add(paths, os.JoinPath(root, "src/std/seqs.cheng"))
    add(paths, os.JoinPath(root, "src/std/system.cheng"))
    add(paths, os.JoinPath(root, "src/std/rawmem_support.cheng"))
    add(paths, os.JoinPath(root, "src/std/strformat.cheng"))
    add(paths, os.JoinPath(root, "src/std/times.cheng"))
    add(paths, os.JoinPath(root, "src/std/result.cheng"))
    add(paths, os.JoinPath(root, "src/std/crypto/sha256.cheng"))
    add(paths, os.JoinPath(root, "src/std/strutils.cheng"))
    add(paths, os.JoinPath(root, "src/core/backend/aarch64_encode.cheng"))
    add(paths, os.JoinPath(root, "src/core/backend/coff_object_writer.cheng"))
    var functionBase: int32
    for sourceIndex in 0..<paths.len:
        RealSourceReceiptCheck(paths[sourceIndex],
                               sourceIndex,
                               functionBase,
                               sourceIndex == paths.len - 1)
    echo(Fmt"parser_receipt_real_source_count={paths.len}")
    echo(Fmt"parser_receipt_real_function_count={functionBase}")
    echo("parser_receipt_importc_function_domain_separated=1")
    echo("parser_receipt_real_source_closure_smoke: ok")

main()
