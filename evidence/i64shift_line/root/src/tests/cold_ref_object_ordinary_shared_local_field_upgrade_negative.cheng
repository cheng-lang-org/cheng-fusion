type
    ColdOrdinarySharedFieldCell =
        value: int32

    ColdOrdinarySharedFieldInner = ref object
        cell: ColdOrdinarySharedFieldCell

    ColdOrdinarySharedFieldOuter = ref object
        inner: ColdOrdinarySharedFieldInner

fn ColdOrdinarySharedFieldWrite(
        cell: var ColdOrdinarySharedFieldCell) =
    cell.value = 59

fn ColdOrdinarySharedFieldReject(
        source: var ColdOrdinarySharedFieldOuter) =
    let borrowed = source
    var alias = borrowed
    var projected = alias.inner
    ColdOrdinarySharedFieldWrite(projected.cell)

fn main(): int32 =
    var source = new(ColdOrdinarySharedFieldOuter)
    source.inner = new(ColdOrdinarySharedFieldInner)
    ColdOrdinarySharedFieldReject(source)
    return 0
