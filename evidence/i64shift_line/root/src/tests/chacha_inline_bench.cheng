# ChaCha20 block generation: baseline (chachaQR fn calls) vs fully-inlined QR bodies.
# Purpose: quantify fn-call overhead fraction under stage3 no-regalloc codegen,
# then report real achievable speedup for the production chacha20Xor path.
import std/crypto/chacha20poly1305
import std/rawbytes
import std/strings
import std/os

@importc("cheng_monotime_ns")
fn monoNs(): int64

const benchBlocks = 16384
fn benchFill(buf: rawbytes.Bytes) =
    var i: int32 = 0
    while i < rawbytes.BytesLen(buf):
        rawbytes.BytesSet(buf, i, int32((i * 2654435761) & 255))
        i = i + 1

# Baseline: use existing Chacha20Block from std (which has chachaQR fn calls)
let warmupKey: rawbytes.Bytes = rawbytes.BytesAlloc(32)
benchFill(warmupKey)
var discardKs: rawbytes.Bytes = rawbytes.BytesAlloc(64)

let t0_base: int64 = monoNs()
var bi: int32 = 0
while bi < benchBlocks:
    var ks: rawbytes.Bytes = std.crypto.chacha20poly1305.Chacha20Block(warmupKey, int32(bi), nonceBuf)
    BytesFree(ks)
    bi = bi + 1
let t1_base: int64 = monoNs()
benchPrint("CHACHA_BASELINE")
benchReport("CHACHA_baseline_64B", t1_base - t0_base)
