import cheng/core/csg_core/merkle_store as authority

fn main(): int32 =
    if !authority.ProductionAdmittedClaimAuthorityInitializeBeforeFork():
        return 2
    if authority.ProductionAdmittedClaimAuthorityStateCurrent() !=
           authority.ProductionAdmittedClaimStateEmpty:
        return 3
    var claimOwner: int32 = -1
    var admittedOwner: int32 = -1
    var err: str
    if authority.ProductionAdmittedClaimAuthorityClaimDurableInto(
           admittedOwner, -1, claimOwner, err):
        return 4
    if claimOwner != -1 || err.len == 0:
        return 5
    return 0
