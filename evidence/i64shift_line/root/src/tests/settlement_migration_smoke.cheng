# settlement migration smoke: mirrors RWAD-blockchain
# tests/settlement_challenge_smoke.cheng assertion-for-assertion on the
# LSMR kernel implementation, plus release/finalize legs.

import std/os
import std/system
import cheng/std/bytes_layout as layout
import cheng/apps/rwad/rwad_settlement as ssm

fn Acct(b: int32): layout.FixedBytes32 =
    var raw = BytesAlloc(32)
    BytesSet(raw, 0, b)
    let res = layout.FixedBytes32FromBytes(raw)
    return res.value

fn main(): int32 =
    var rc: int32 = 0
    var st = ssm.SsmInit()

    let challenger = Acct(10)
    let payer = Acct(11)
    # original: challenger starts at explicit 0, payer holds 3000
    let c0 = ssm.SsmCredit(st, challenger, 0)
    if !c0.ok:
        os.WriteLine(os.Get_stderr(), "credit challenger failed")
        return 1
    let p0 = ssm.SsmCredit(st, payer, Int64(3000))
    if !p0.ok:
        os.WriteLine(os.Get_stderr(), "credit payer failed")
        return 1

    # applyEscrowLock(state, "escrow-1", "payer", 2000, 2000)
    let lockRes = ssm.SsmEscrowLock(st, Acct(1), payer, Int64(2000), Int64(2000))
    if !lockRes.ok:
        os.WriteLine(os.Get_stderr(), "escrow lock failed")
        rc = rc + 1
    if ssm.SsmBalanceOf(st, payer) != 1000:
        os.WriteLine(os.Get_stderr(), "payer balance after lock wrong")
        rc = rc + 1

    # batch submitted with challenge window
    var totals: ssm.SsmBatchTotals
    totals.totalPayout = Int64(100)
    totals.totalFees = Int64(0)
    totals.totalCount = Int64(1)
    let subRes = ssm.SsmBatchSubmit(st, Acct(2), Int64(1), Acct(21), totals, Int64(1000), Int64(5000))
    if !subRes.ok:
        os.WriteLine(os.Get_stderr(), "batch submit failed")
        rc = rc + 1

    # invalid proof: returns false, status stays submitted
    let bad = ssm.SsmBatchChallenge(st, Acct(2), false)
    if !bad.ok or bad.value:
        os.WriteLine(os.Get_stderr(), "invalid proof should be no-op false")
        rc = rc + 1

    # valid proof: challenged
    let okC = ssm.SsmBatchChallenge(st, Acct(2), true)
    if !okC.ok or !okC.value:
        os.WriteLine(os.Get_stderr(), "valid proof should flip to challenged")
        rc = rc + 1

    # re-challenging a challenged batch must error loudly
    let again = ssm.SsmBatchChallenge(st, Acct(2), true)
    if again.ok:
        os.WriteLine(os.Get_stderr(), "double challenge accepted")
        rc = rc + 1

    # applyEscrowSlashWithSplit(state, "escrow-1", 1000, "challenger",
    #                           rewardBp=200, burnBp=300)
    let slash = ssm.SsmEscrowSlashWithSplit(st, Acct(1), Int64(1000), challenger)
    if !slash.ok:
        os.WriteLine(os.Get_stderr(), "escrow slash failed")
        rc = rc + 1

    # challenger reward: 1000 * 200 / 10000 = 20 (had 0 before)
    if ssm.SsmBalanceOf(st, challenger) != 20:
        os.WriteLine(os.Get_stderr(), "challenger reward mismatch")
        rc = rc + 1
    # burn bucket: 1000 * 300 / 10000 = 30
    if st.pools.burnBucket != 30:
        os.WriteLine(os.Get_stderr(), "burn bucket mismatch")
        rc = rc + 1
    # safety fund remainder: 950
    if st.pools.safetyFund != 950:
        os.WriteLine(os.Get_stderr(), "safety fund mismatch")
        rc = rc + 1

    # supply conservation: credit(3000) == payer remaining 1000 + challenger 20
    #   + escrow locked 1000 + pools 980
    var totalSupply: int64 = 0
    var i: int32
    while i < st.balAmounts.len:
        totalSupply = totalSupply + st.balAmounts[i]
        i = i + 1
    var inEscrow: int64 = 0
    i = 0
    while i < st.escrows.len:
        inEscrow = inEscrow + st.escrows[i].amountLocked + st.escrows[i].amountReleased
        i = i + 1
    let poolsTotal: int64 = st.pools.burnBucket + st.pools.safetyFund
    # credit(3000) = balances(1020) + escrowLocked(1000) + pools(980)
    if totalSupply + inEscrow + poolsTotal != Int64(3000):
        os.WriteLine(os.Get_stderr(), "supply conservation broken")
        rc = rc + 1
    if inEscrow + poolsTotal != Int64(1980):
        os.WriteLine(os.Get_stderr(), "locked plus pools mismatch")
        rc = rc + 1

    # --- release leg: pay out the remaining locked 1000 to two payees ---
    let relA = ssm.SsmEscrowRelease(st, Acct(1), Acct(31), Int64(600))
    if !relA.ok:
        os.WriteLine(os.Get_stderr(), "release A failed")
        rc = rc + 1
    let relB = ssm.SsmEscrowRelease(st, Acct(1), Acct(32), Int64(400))
    if !relB.ok:
        os.WriteLine(os.Get_stderr(), "release B failed")
        rc = rc + 1
    if ssm.SsmBalanceOf(st, Acct(31)) != 600 or ssm.SsmBalanceOf(st, Acct(32)) != 400:
        os.WriteLine(os.Get_stderr(), "payee balances wrong after release")
        rc = rc + 1

    # over-release rejected loudly; slashing a released escrow rejected
    let overRel = ssm.SsmEscrowRelease(st, Acct(1), Acct(33), Int64(1))
    if overRel.ok:
        os.WriteLine(os.Get_stderr(), "over-release accepted")
        rc = rc + 1
    let slashAgain = ssm.SsmEscrowSlashWithSplit(st, Acct(1), Int64(1), challenger)
    if slashAgain.ok:
        os.WriteLine(os.Get_stderr(), "slash after full release accepted")
        rc = rc + 1

    if rc == 0:
        echo("settlement_migration_smoke ok")
    return rc
