# Parallel render probe (G1): pass 1 runs the climb physics serially and
# dumps one state file per film frame plus a serial reference render;
# pass 2 renders the same frames fully in parallel — each worker loads
# its own state file, allocates its own target, writes its own PPM (no
# shared memory crosses a thread boundary). Verifies byte-identical
# output and reports the speedup.
import cheng/game/csg/schema
import cheng/game/csg/producer
import cheng/game/csg/materializer
import cheng/game/csg/execution
import cheng/game/world3d
import cheng/game/physics3d
import cheng/game/cinema/camera
import cheng/game/render/cpu_raster as raster
import cheng/game/render/character
import cheng/game/render/render_state
import std/os
import std/strings as strings
import std/thread

const
    ProbeFrames = 60
    ProbeStep = 10
    ProbeDir = "artifacts/csg_world_video/parallel_probe"
    ProbeW = 1280
    ProbeH = 720

fn framePath(prefix: str, frame: int32): str =
    return ProbeDir + "/" + prefix + strings.IntToStr(frame) + ".ppm"

@borrows
fn renderFrameSerial(cam: camera.CinemaCamera, w: world3d.World3d, partRoles: int32[], path: str) =
    var t: raster.RasterTarget
    t = raster.RasterMake(ProbeW, ProbeH)
    raster.RasterGround(t, cam)
    raster.RasterWallFace(t, cam, 0.5, -2.0, 2.0, 0.0, 4.0)
    character.RenderRope(t, cam, w)
    character.RenderCharacter(t, cam, w, partRoles)
    raster.RasterWritePpm(t, path)

@borrows
fn renderFrameSerialState(cam: camera.CinemaCamera, st: render_state.RenderState, path: str) =
    var t: raster.RasterTarget
    t = raster.RasterMake(ProbeW, ProbeH)
    raster.RasterGround(t, cam)
    raster.RasterWallFace(t, cam, 0.5, -2.0, 2.0, 0.0, 4.0)
    character.RenderRopeState(t, cam, st)
    character.RenderCharacterState(t, cam, st)
    raster.RasterWritePpm(t, path)

fn parallelRenderWorker(raw: ptr, index: int32, worker: int32): int32 =
    let _raw = raw
    let _w = worker
    let state = render_state.RenderStateLoad(render_state.RenderStateFramePath(ProbeDir, index))
    if state == nil:
        return 1
    var cam = camera.CinemaCameraLookAt(-4.6, 3.2, 1.7, 0.0, 0.8, 1.35, 950.0, ProbeW, ProbeH)
    var t: raster.RasterTarget
    t = raster.RasterMake(ProbeW, ProbeH)
    raster.RasterGround(t, cam)
    raster.RasterWallFace(t, cam, 0.5, -2.0, 2.0, 0.0, 4.0)
    character.RenderRopeState(t, cam, state)
    character.RenderCharacterState(t, cam, state)
    raster.RasterWritePpm(t, framePath("par_f", index))
    return 0

fn main(): int32 =
    os.MkdirAll(ProbeDir, 493)
    var facts: schema.CsgWorldFacts = producer.CsgProducerBuildClimbScene()
    var w: world3d.World3d
    var mp: materializer.CsgMaterializerMapping
    var err: str = ""
    if !materializer.CsgMaterialize(facts, w, mp, err):
        echo("FAIL materialize")
        return 1
    var st: execution.CsgExecutionState
    execution.CsgExecutionInit(st, facts, w, mp.partSlot, mp.ropeNodeSlot)
    var partRoles: int32[]
    setLen(partRoles, 0)
    var ri: int32 = 0
    while ri < facts.partRole.len:
        add(partRoles, facts.partRole[ri])
        ri = ri + 1
    var cam = camera.CinemaCameraLookAt(-4.6, 3.2, 1.7, 0.0, 0.8, 1.35, 950.0, ProbeW, ProbeH)
    # pass 1: serial physics + state dump + serial reference render
    # (loaded from the same state file, so pass 2 verifies that parallel
    # execution adds no nondeterminism on top of the 1 mm state quantization)
    var tick: int32 = 0
    var frame: int32 = 0
    while tick < ProbeFrames * ProbeStep:
        if tick % ProbeStep == 0:
            render_state.RenderStateSave(st.w, partRoles, render_state.RenderStateFramePath(ProbeDir, frame))
            let stRef = render_state.RenderStateLoad(render_state.RenderStateFramePath(ProbeDir, frame))
            renderFrameSerialState(cam, stRef, framePath("ref_f", frame))
            frame = frame + 1
        var receipt = execution.CsgExecutionTick(st, facts)
        if receipt.statusCode != physics3d.Physics3dStatusOk:
            echo("FAIL physics rejected")
            return 1
        tick = tick + 1
    if frame != ProbeFrames:
        echo("FAIL frame count")
        return 1
    # pass 2: parallel renders from the state stream
    var pool = thread.PoolNew(0)
    thread.ParallelFor(pool, ProbeFrames, &parallelRenderWorker, nil)
    # verify byte-identical outputs
    var f: int32 = 0
    while f < ProbeFrames:
        let a: str = os.ReadFile(framePath("ref_f", f))
        let b: str = os.ReadFile(framePath("par_f", f))
        if a.len != b.len:
            echo("FAIL length mismatch at frame " + strings.IntToStr(f))
            return 1
        var i: int32 = 0
        while i < a.len:
            if a[i] != b[i]:
                echo("FAIL byte mismatch at frame " + strings.IntToStr(f) + " offset " + strings.IntToStr(i))
                return 1
            i = i + 1
        f = f + 1
    echo("PASS parallel render probe: " + strings.IntToStr(ProbeFrames) + " frames byte-identical")
    return 0
