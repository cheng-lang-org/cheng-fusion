fn R24Trim(raw: str): str =
    return raw

fn R24Tag(raw: str): str =
    if raw.len > 3:
        return "long"
    return "short"

fn R24NegHead(lineRaw: str, genericPos: int32): int32 =
    let headRaw = R24Trim(lineRaw)
    var head: str
    if genericPos > 0:
        head = R24Tag(headRaw)
    else:
        head = headRaw
    return head.len + headRaw.len

fn main(): int32 =
    let n = R24NegHead("abcdef", 1)
    if n != 10:
        return 10
    echo("neg reached")
    return 0
