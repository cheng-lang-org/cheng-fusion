# R17 positive at the SPECIMEN's own type: `Bytes` is a resource-free value
# object ({data: ptr, len: int32}), and sha256.sharedSha256KTab returns exactly
# this shape -- `return <Bytes global>`.
import std/rawbytes
import std/system

var tkR17BytesGlobal: Bytes

fn TkR17BytesRetGlobal(): Bytes =
    return tkR17BytesGlobal

fn main(): int32 =
    tkR17BytesGlobal.data = nil
    tkR17BytesGlobal.len = 256
    if TkR17BytesRetGlobal().len != 256:
        return 10
    tkR17BytesGlobal.len = 64
    if TkR17BytesRetGlobal().len != 64:
        return 11
    echo(Fmt"tk_r17_bytes_global_return ok len={TkR17BytesRetGlobal().len}")
    return 0
