import cheng/libp2p/stream/connection
import cheng/libp2p/switch
import cheng/tests/famG/repro_libp2p_side
import cheng/tests/famG/repro_quic_side

fn main(): int32 =
    var c: Connection
    c.remotePeer = ""
    let out: Connection = famGTouch(c)
    if out.remotePeer != "peer-a-text":
        return 1
    return 0
