import cheng/libp2p/stream/connection

# Mirrors noiseSecure's `next.remotePeer = peerText` shape exactly: unqualified
# `Connection` local var copy + field-store. This file (like noise.cheng) only
# ever imports ONE Connection module -- unambiguous from its own import graph.
fn famGTouch(conn: Connection): Connection =
    var next: Connection = conn
    next.remotePeer = "peer-a-text"
    return next
