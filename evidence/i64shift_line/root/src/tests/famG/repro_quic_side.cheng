import cheng/quic/connection

# Unrelated file that pulls the *other* same-named `Connection` (distinct
# struct layout in src/quic/connection.cheng) into the whole-program
# sourceContexts set, reproducing the real cross-module leaf-name collision
# without repro_libp2p_side.cheng ever importing this module itself. Fully
# self-contained (no external param needed) so the caller never has to name
# `Connection` itself.
fn famGTouchQuicSide(): int32 =
    var qconn: Connection
    qconn.pipeIdx = 5
    return qconn.pipeIdx
