import std/system as system

type ColdManagedIndexConsumed =
    key: str

fn main(): int32 =
    var value: ColdManagedIndexConsumed
    value.key = system.NewStringCopy(
        system.StrDataPtr("consumed"), 8)
    var values: ColdManagedIndexConsumed[]
    add(values, value)
    if value.key == "consumed":
        return 1
    return 0
