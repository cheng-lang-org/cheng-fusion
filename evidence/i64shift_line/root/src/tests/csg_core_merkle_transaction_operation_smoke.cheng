import std/os
import std/rawbytes
import std/strings
import cheng/core/csg_core/merkle_admission
import cheng/core/csg_core/merkle_transaction_operation as operation

fn fail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

@borrows
fn truncated(bytes: rawbytes.Bytes): rawbytes.Bytes =
    if rawbytes.BytesLen(bytes) <= 0:
        return rawbytes.BytesAlloc(0)
    var out = rawbytes.BytesAlloc(rawbytes.BytesLen(bytes) - 1)
    rawbytes.BytesCopyRangeInto(
        out, 0, bytes, 0, rawbytes.BytesLen(out))
    return out

fn main(): int32 =
    let schema =
        "{\"features\":[\"core-facts\"],\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}"
    let beforeFact =
        "{\"id\":\"mod_a\",\"kind\":\"csg.module\",\"path\":\"a.cheng\",\"sha256\":\"sha256:aaa\"}"
    let afterFact =
        "{\"id\":\"mod_a\",\"kind\":\"csg.module\",\"path\":\"a.cheng\",\"sha256\":\"sha256:bbb\"}"
    var beforeFacts = [
        strings.CloneStr(schema),
        strings.CloneStr(beforeFact)]
    var issueA =
        merkle_admission.CsgCoreMerkleSealBeforeAuthority(
            beforeFacts, afterFact, "id:mod_a")
    if !issueA.ok ||
       !issueA.candidate.replay.ok ||
       issueA.candidate.replacementCount != 1 ||
       issueA.candidate.beforeFact != beforeFact ||
       issueA.candidate.afterFact != afterFact:
        return fail("sealed operation candidate rejected")

    let legacy = operation.CsgCoreMerkleTransactionOperationBuild(
        operation.CsgCoreMerkleTransactionReplaceKind(),
        issueA.candidate.proof,
        issueA.candidate.replay.beforeFactsRoot,
        issueA.candidate.replay.beforeBinding.profiles,
        afterFact)
    if legacy.ok || legacy.error !=
           "merkle_transaction_operation_legacy_build_disabled":
        return fail("legacy operation builder was not disabled")
    let proofOnly =
        operation.CsgCoreMerkleTransactionOperationBuildReplaceBound(
            issueA.candidate.proof,
            issueA.candidate.replay.beforeFactsRoot,
            beforeFact,
            afterFact)
    if proofOnly.ok || proofOnly.error !=
           "merkle_transaction_operation_requires_admitted_delta":
        return fail("proof-only operation builder was not disabled")

    var first =
        operation.CsgCoreMerkleTransactionOperationBuildSealedReplace(
            issueA.candidate)
    if !first.ok ||
       first.operation.queryKey != "id:mod_a" ||
       first.operation.beforeFact != beforeFact ||
       first.operation.afterFact != afterFact ||
       first.operation.beforeFactsRoot !=
           issueA.candidate.replay.beforeFactsRoot ||
       first.operation.afterFactsRoot !=
           issueA.candidate.replay.afterFactsRoot:
        return fail("sealed operation bytes or Replay binding drifted")

    var liveA = issueA.live
    issueA.live = merkle_admission.CsgCoreMerkleSealedBeforeLiveToken()
    let terminalA =
        merkle_admission.CsgCoreMerkleSealedBeforeLivePoison(liveA)
    if !terminalA.ok || !terminalA.terminal:
        return fail("sealed operation authority interleave terminal failed")

    var issueB =
        merkle_admission.CsgCoreMerkleSealBeforeAuthority(
            beforeFacts, afterFact, "id:mod_a")
    if !issueB.ok ||
       !issueB.candidate.replay.ok ||
       issueB.candidate.replacementCount != 1 ||
       issueB.candidate.beforeFact != beforeFact ||
       issueB.candidate.afterFact != afterFact:
        return fail("sealed operation candidate reissue rejected")

    var second =
        operation.CsgCoreMerkleTransactionOperationBuildSealedReplace(
            issueB.candidate)
    if !second.ok || first.cid != second.cid ||
       !rawbytes.BytesEqual(first.bytes, second.bytes) ||
       !rawbytes.BytesEqual(first.proofBytes, second.proofBytes):
        return fail("sealed operation reissue bytes or Replay binding drifted")

    let cloned =
        operation.CsgCoreMerkleTransactionOperationClone(
            first.operation)
    if cloned.queryKey != first.operation.queryKey ||
       cloned.beforeFactsRoot != first.operation.beforeFactsRoot ||
       cloned.afterFactsRoot != first.operation.afterFactsRoot:
        return fail("sealed operation owned clone drifted")

    var decoded =
        operation.CsgCoreMerkleTransactionOperationDecode(first.bytes)
    if !decoded.ok || decoded.cid != first.cid ||
       !rawbytes.BytesEqual(decoded.bytes, first.bytes) ||
       decoded.operation.beforeFact != beforeFact ||
       decoded.operation.afterFact != afterFact ||
       decoded.operation.beforeFactsRoot !=
           issueA.candidate.replay.beforeFactsRoot ||
       decoded.operation.afterFactsRoot !=
           issueA.candidate.replay.afterFactsRoot:
        return fail("sealed operation did not decode byte-exactly")

    var shortBytes = truncated(first.bytes)
    let shortDecoded =
        operation.CsgCoreMerkleTransactionOperationDecode(shortBytes)
    rawbytes.BytesFree(shortBytes)
    if shortDecoded.ok:
        return fail("truncated transaction operation accepted")

    var liveB = issueB.live
    issueB.live = merkle_admission.CsgCoreMerkleSealedBeforeLiveToken()
    let terminalB =
        merkle_admission.CsgCoreMerkleSealedBeforeLivePoison(liveB)
    if !terminalB.ok || !terminalB.terminal:
        return fail("sealed operation authority cleanup failed")

    rawbytes.BytesFree(first.bytes)
    rawbytes.BytesFree(first.proofBytes)
    rawbytes.BytesFree(second.bytes)
    rawbytes.BytesFree(second.proofBytes)
    rawbytes.BytesFree(decoded.bytes)
    os.WriteLine(
        os.Get_stdout(),
        "csg_core_merkle_transaction_operation_smoke ok")
    return 0
