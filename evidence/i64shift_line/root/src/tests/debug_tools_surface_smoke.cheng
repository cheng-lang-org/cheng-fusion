import std/os
import std/strutils as strutil
import cheng/core/backend/line_map as linemap
import cheng/core/tooling/host_ops as hostops
import cheng/core/tooling/path as chengpath

fn containsText(text: str, needle: str): bool =
    return strutil.Contains(text, needle)

fn loggedText(logPath: str, label: str): str =
    let text = chengpath.ReadTextFile("", logPath)
    assert(Len(text) > 0, strutil.Join([label, " log text"], ""))
    return text

fn removeStaleFile(path: str) =
    let _removed = os.RemoveFile(path)

fn main(): int32 =
    let root = os.GetCurrentDir()
    let outDir = chengpath.PathAbsolute(root, "artifacts/debug_tools_surface")
    assert(chengpath.MkdirP(root, outDir), "cheng debug tools surface: mkdir")
    let driver = chengpath.PathAbsolute(root, "artifacts/backend_driver/cheng")
    assert(chengpath.FileExistsNonEmpty(root, driver), "cheng debug tools surface: backend_driver exists")
    let packageRoot = root
    let ordinarySource = chengpath.PathAbsolute(root, "src/tests/ordinary_zero_exit_fixture.cheng")
    let asmSource = chengpath.PathAbsolute(root, "src/tests/ordinary_call_chain_fixture.cheng")

    let debugLog = chengpath.PathJoin(outDir, "debug-report.log")
    removeStaleFile(debugLog)
    let debugRun = hostops.RunFileLogged(root,
                                           "debug_report",
                                           driver,
                                           [
                                               "debug-report",
                                               strutil.Join(["--root:", packageRoot], ""),
                                               strutil.Join(["--in:", ordinarySource], ""),
                                               "--target:arm64-apple-darwin",
                                               "--emit:obj"
                                           ],
                                           [],
                                           root,
                                           120,
                                           debugLog)
    assert(hostops.LoggedRunOk(debugRun), "debug-report rc")
    let debugText = loggedText(debugLog, "debug-report")
    assert(containsText(debugText, "cheng_debug_report"), "debug-report header")
    assert(containsText(debugText, "entry="), "debug-report entry")
    assert(containsText(debugText, "lowering_function_count="), "debug-report lowering")
    assert(containsText(debugText, "primary_object_item_count="), "debug-report primary")
    assert(containsText(debugText, "native_linker_program="), "debug-report linker")
    assert(containsText(debugText, ordinarySource), "debug-report source")

    let symbolsLog = chengpath.PathJoin(outDir, "print-symbols.log")
    removeStaleFile(symbolsLog)
    let symbolsRun = hostops.RunFileLogged(root,
                                             "print_symbols",
                                             driver,
                                             [
                                                 "print-symbols",
                                                 strutil.Join(["--root:", packageRoot], ""),
                                                 strutil.Join(["--in:", ordinarySource], ""),
                                                 "--target:arm64-apple-darwin",
                                                 "--emit:obj"
                                             ],
                                             [],
                                             root,
                                             120,
                                             symbolsLog)
    assert(hostops.LoggedRunOk(symbolsRun), "print-symbols rc")
    let symbolsText = loggedText(symbolsLog, "print-symbols")
    assert(strutil.StartsWith(symbolsText, "cheng_symbols\n"), "print-symbols header")
    assert(containsText(symbolsText, "lowering_symbol_count="), "print-symbols lowering")
    assert(containsText(symbolsText, "primary_symbol_count="), "print-symbols primary")
    assert(containsText(symbolsText, "primary_unsupported_count=0"), "print-symbols unsupported")

    let lineMapLog = chengpath.PathJoin(outDir, "print-line-map.log")
    removeStaleFile(lineMapLog)
    let lineMapRun = hostops.RunFileLogged(root,
                                             "print_line_map",
                                             driver,
                                             [
                                                 "print-line-map",
                                                 strutil.Join(["--root:", packageRoot], ""),
                                                 strutil.Join(["--in:", ordinarySource], ""),
                                                 "--target:arm64-apple-darwin",
                                                 "--emit:obj"
                                             ],
                                             [],
                                             root,
                                             120,
                                             lineMapLog)
    assert(hostops.LoggedRunOk(lineMapRun), "print-line-map rc")
    let lineMapText = loggedText(lineMapLog, "print-line-map")
    assert(strutil.StartsWith(lineMapText, "cheng_line_map\n"),
           "print-line-map exact header")
    assert(containsText(lineMapText, "entry_count="), "print-line-map count")
    assert(containsText(lineMapText, "entry\t"), "print-line-map entry")
    assert(containsText(lineMapText, "function_name=main"), "print-line-map function name")
    assert(containsText(lineMapText, strutil.Join(["module_path=", ordinarySource], "")),
           "print-line-map module path")
    assert(linemap.LineMapTextHasRequiredDebugFields(lineMapText),
           "print-line-map debug fields complete")
    assert(!linemap.LineMapTextHasRequiredDebugFields("cheng_line_map\nentry_count=1\nentry\ta\tb\tc\t1\t1\t1\n"),
           "print-line-map rejects missing debug fields")
    assert(!linemap.LineMapTextHasRequiredDebugFields("cheng_line_map_v1\nentry_count=1\nentry\ta\tb\tc\t1\t1\t1\tfunction_name=b\tmodule_path=c\n"),
           "print-line-map rejects replaced header")

    let machoObject = chengpath.PathJoin(outDir, "ordinary_zero_exit_fixture.macho.o")
    let machoReport = strutil.Join([machoObject, ".report.txt"], "")
    let machoCompileLog = strutil.Join([machoObject, ".compile.log"], "")
    removeStaleFile(machoObject)
    removeStaleFile(machoReport)
    removeStaleFile(machoCompileLog)
    let machoCompileRun = hostops.RunFileLogged(root,
                                                  "compile_arm64_apple_darwin",
                                                  driver,
                                                  [
                                                      "system-link-exec",
                                                      strutil.Join(["--root:", packageRoot], ""),
                                                      strutil.Join(["--in:", ordinarySource], ""),
                                                      "--emit:obj",
                                                      "--target:arm64-apple-darwin",
                                                      strutil.Join(["--out:", machoObject], ""),
                                                      strutil.Join(["--report-out:", machoReport], "")
                                                  ],
                                                  [],
                                                  root,
                                                  120,
                                                  machoCompileLog)
    assert(hostops.LoggedRunOk(machoCompileRun), "compile macho rc")
    assert(chengpath.PathFileNonEmpty(machoObject), "compile macho object")
    let machoReportText = loggedText(machoReport, "compile macho report")
    let machoPrintLog = chengpath.PathJoin(outDir, "print-object.macho.log")
    removeStaleFile(machoPrintLog)
    let machoRun = hostops.RunFileLogged(root,
                                           "print_object_macho",
                                           driver,
                                           ["print-object", strutil.Join(["--object:", machoObject], "")],
                                           [],
                                           root,
                                           120,
                                            machoPrintLog)
    assert(hostops.LoggedRunOk(machoRun), "print-object macho rc")
    let machoText = loggedText(machoPrintLog, "print-object macho")
    assert(containsText(machoText, "cheng_object_report"), "print-object macho header")
    assert(containsText(machoText, "format=macho64"), "print-object macho format")
    assert(containsText(machoText, "load_command_count="), "print-object macho load")
    assert(containsText(machoText, "section_count="), "print-object macho sections")

    let elfObject = chengpath.PathJoin(outDir, "ordinary_zero_exit_fixture.elf.o")
    let elfReport = strutil.Join([elfObject, ".report.txt"], "")
    let elfCompileLog = strutil.Join([elfObject, ".compile.log"], "")
    removeStaleFile(elfObject)
    removeStaleFile(elfReport)
    removeStaleFile(elfCompileLog)
    let elfCompileRun = hostops.RunFileLogged(root,
                                                "compile_aarch64_unknown_linux_gnu",
                                                driver,
                                                [
                                                    "system-link-exec",
                                                    strutil.Join(["--root:", packageRoot], ""),
                                                    strutil.Join(["--in:", ordinarySource], ""),
                                                    "--emit:obj",
                                                    "--target:aarch64-unknown-linux-gnu",
                                                    strutil.Join(["--out:", elfObject], ""),
                                                    strutil.Join(["--report-out:", elfReport], "")
                                                ],
                                                [],
                                                root,
                                                120,
                                                elfCompileLog)
    assert(hostops.LoggedRunOk(elfCompileRun), "compile elf rc")
    assert(chengpath.PathFileNonEmpty(elfObject), "compile elf object")
    let elfReportText = loggedText(elfReport, "compile elf report")
    let elfPrintLog = chengpath.PathJoin(outDir, "print-object.elf.log")
    removeStaleFile(elfPrintLog)
    let elfRun = hostops.RunFileLogged(root,
                                         "print_object_elf",
                                         driver,
                                         ["print-object", strutil.Join(["--object:", elfObject], "")],
                                         [],
                                         root,
                                         120,
                                          elfPrintLog)
    assert(hostops.LoggedRunOk(elfRun), "print-object elf rc")
    let elfText = loggedText(elfPrintLog, "print-object elf")
    assert(containsText(elfText, "cheng_object_report"), "print-object elf header")
    assert(containsText(elfText, "format=elf64"), "print-object elf format")
    assert(containsText(elfText, "section_count="), "print-object elf sections")
    assert(containsText(elfText, "symbol_count="), "print-object elf symbols")
    assert(containsText(elfText, "reloc_count="), "print-object elf relocs")
    let elfAliasLog = chengpath.PathJoin(outDir, "print-elf.log")
    removeStaleFile(elfAliasLog)
    let elfAliasRun = hostops.RunFileLogged(root,
                                              "print_elf",
                                              driver,
                                              ["print-elf", strutil.Join(["--object:", elfObject], "")],
                                              [],
                                              root,
                                              120,
                                              elfAliasLog)
    assert(hostops.LoggedRunOk(elfAliasRun), "print-elf rc")
    let elfAliasOutputRaw = loggedText(elfAliasLog, "print-elf")
    let elfOutputRaw = elfText
    let elfAliasOutput = strutil.Strip(elfAliasOutputRaw)
    let elfOutput = strutil.Strip(elfOutputRaw)
    assert(elfAliasOutput == elfOutput, "print-elf alias drift")

    let peObject = chengpath.PathJoin(outDir, "ordinary_zero_exit_fixture.pe.exe")
    let peReport = strutil.Join([peObject, ".report.txt"], "")
    let peCompileLog = strutil.Join([peObject, ".compile.log"], "")
    removeStaleFile(peObject)
    removeStaleFile(peReport)
    removeStaleFile(peCompileLog)
    let peCompileRun = hostops.RunFileLogged(root,
                                               "compile_aarch64_pc_windows_msvc",
                                               driver,
                                               [
                                                   "system-link-exec",
                                                   strutil.Join(["--root:", packageRoot], ""),
                                                   strutil.Join(["--in:", ordinarySource], ""),
                                                   "--emit:exe",
                                                   "--target:aarch64-pc-windows-msvc",
                                                   strutil.Join(["--out:", peObject], ""),
                                                   strutil.Join(["--report-out:", peReport], "")
                                               ],
                                               [],
                                               root,
                                               120,
                                               peCompileLog)
    assert(hostops.LoggedRunOk(peCompileRun), "compile pe rc")
    assert(chengpath.PathFileNonEmpty(peObject), "compile pe object")
    let peReportText = loggedText(peReport, "compile pe report")
    let pePrintLog = chengpath.PathJoin(outDir, "print-object.pe.log")
    removeStaleFile(pePrintLog)
    let peRun = hostops.RunFileLogged(root,
                                        "print_object_pe",
                                        driver,
                                        ["print-object", strutil.Join(["--object:", peObject], "")],
                                        [],
                                        root,
                                        120,
                                        pePrintLog)
    assert(hostops.LoggedRunOk(peRun), "print-object pe rc")
    let peText = loggedText(pePrintLog, "print-object pe")
    assert(containsText(peText, "cheng_object_report"), "print-object pe header")
    assert(containsText(peText, "format=pe/coff"), "print-object pe format")
    assert(containsText(peText, "section_count="), "print-object pe sections")
    assert(containsText(peText, "import_count="), "print-object pe imports")

    let asmLog = chengpath.PathJoin(outDir, "print-asm.log")
    removeStaleFile(asmLog)
    let asmRun = hostops.RunFileLogged(root,
                                         "print_asm",
                                         driver,
                                         [
                                             "print-asm",
                                             strutil.Join(["--root:", packageRoot], ""),
                                             strutil.Join(["--in:", asmSource], ""),
                                             "--target:arm64-apple-darwin",
                                             "--emit:obj"
                                         ],
                                         [],
                                         root,
                                         120,
                                         asmLog)
    assert(hostops.LoggedRunOk(asmRun), "print-asm rc")
    let asmText = loggedText(asmLog, "print-asm")
    assert(containsText(asmText, "cheng_asm_report"), "print-asm header")
    assert(containsText(asmText, "asm_text_begin"), "print-asm begin")
    assert(containsText(asmText, ".globl"), "print-asm globl")
    assert(containsText(asmText, "Leaf"), "print-asm symbol")

    echo("cheng debug_tools_surface_smoke ok")
    return 0
