fn ColdExactSharedVarReborrowRead(source: var str): int32 =
    let borrowed = source
    var first = borrowed
    var second = borrowed
    if first != "owner" || second != "owner" || borrowed != "owner" || source != "owner":
        return 11
    return 0

fn main(): int32 =
    var owner = "owner"
    if ColdExactSharedVarReborrowRead(owner) != 0:
        return 12
    if owner != "owner":
        return 13
    return 0
