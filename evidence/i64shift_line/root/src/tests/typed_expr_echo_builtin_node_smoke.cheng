import cheng/core/lang/typed_expr as texpr
import cheng/core/runtime/arena as arenamod
import cheng/core/lang/intern as langintern
import cheng/core/lang/parser

fn main(): int32 =
    let sourceText = """
    fn main(): int32 =
        echo("ok")
        return 0
    """
    var sources: texpr.TypedExprSourceText[]
    add(sources, texpr.TypedExprSourceTextNew("/fixture",
                                               "/fixture",
                                               "/fixture/echo_builtin.cheng",
                                               sourceText))
    var ir: texpr.TypedExprIr
    var err: str
    assert(texpr.TypedExprBuildIr(sources, ir, err),
           Fmt"echo builtin build failed: {err}")
    assert(ir.statements2_statementIndexs.len == 1,
           "echo builtin statement count")
    let stmt = texpr.TypedExprIrStatementAt(ir, 0)
    assert(stmt.kind == texpr.TypedExprIrStmtCall &&
           stmt.callCallee == "echo" && stmt.callTarget == "echo" &&
           stmt.resultType == "void" && stmt.rhsNodeIndex >= 0 &&
           stmt.rhsBailReason == texpr.RhsBailNone,
           "echo builtin statement contract")

    let callNode = stmt.rhsNodeIndex
    assert(ir.nodes2_opKinds[callNode] == texpr.TypedExprIrOpCallExpr &&
           Value(langintern.LookupIntern(ir.internPool,
                                         ir.nodes2_literalTextIds[callNode])) == "echo",
           "echo builtin call node contract")
    let linkNode = arenamod.ArenaArrayInt32Get(ir.arena,
                                                ir.nodes2_operand0NodeIndexs,
                                                callNode)
    let argNode = arenamod.ArenaArrayInt32Get(ir.arena,
                                               ir.nodes2_operand0NodeIndexs,
                                               linkNode)
    assert(linkNode >= 0 && argNode >= 0 &&
           ir.nodes2_opKinds[linkNode] == texpr.TypedExprIrOpArgLink &&
           ir.nodes2_opKinds[argNode] == texpr.TypedExprIrOpStrLit,
           "echo builtin argument node contract")
    texpr.TypedExprIrReleasePayload(ir)
    return 0
