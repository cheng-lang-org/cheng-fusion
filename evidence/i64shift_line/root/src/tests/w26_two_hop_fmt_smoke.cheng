# wave-26 回归见证: 跨模块容器 var-param → 下标元素 → 两跳 Fmt piece (er.bodyIrDetail.X)。
# 与 dispatch_min:1775 同形同 bail=631。修前 (中间聚合槽退化 8 字节) 双腿红, 修后双腿绿。
import cheng/tests/w26_errlib as elib
import std/strutils as strutil
import std/strings as strings
import std/os as os

fn w26build(primaryPlan: var elib.W26Plan): str =
    var rows: str[]
    for ei in 0..<primaryPlan.errors.len:
        let er = primaryPlan.errors[ei]
        add(rows, Fmt"{er.functionName}|{er.bodyIrDetail.firstZeroOpKind}|{er.bodyIrDetail.firstZeroOpOperand0}")
    return strutil.Join(rows, ";;")

fn main(): int32 =
    var plan: elib.W26Plan
    var e0: elib.W26Err
    e0.functionName = "fnA"
    e0.bodyIrDetail.firstZeroOpKind = 7
    e0.bodyIrDetail.firstZeroOpOperand0 = 8
    add(plan.errors, e0)
    let got = w26build(plan)
    if got == "fnA|7|8":
        os.WriteLine(os.GetStdout(), "W26_TWOHOP_OK")
        return 0
    os.WriteLine(os.GetStdout(), strings.ConcatStr("W26_TWOHOP_FAIL got=", got))
    return 1
