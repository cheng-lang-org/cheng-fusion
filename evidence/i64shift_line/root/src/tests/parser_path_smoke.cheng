import cheng/core/lang/parser
import cheng/core/tooling/compiler_request as creq
import cheng/core/tooling/path as chengpath
import std/strutils as strutil

fn ParserPathHasCallExprAtSource(layer: parser.NormalizedExprLayer,
                                 sourcePath: str,
                                 callKind: parser.NormalizedExprSurfaceCallKind,
                                 lineNumber: int32): bool =
    for i in 0..<layer.exprs.len:
        let expr = layer.exprs[i]
        if expr.sourcePath != sourcePath:
            continue
        if expr.kind == parser.NormalizedExprCall &&
           expr.callSurfaceKind == callKind &&
           expr.lineNumber == lineNumber:
            return true
    return false

fn main(): int32 =
    let workspaceRoot = chengpath.PathCurrentDir()
    let packageRoot = workspaceRoot
    let contractsSourcePath = chengpath.PathJoin(packageRoot, "src/core/tooling/bootstrap_contracts.cheng")
    let stdSourcePath = chengpath.PathJoin(workspaceRoot, "src/std/strutils.cheng")
    let codexPackageRoot = chengpath.PathJoin(packageRoot, "codex")
    let codexSourcePath = chengpath.PathJoin(codexPackageRoot, "src/tests/rust_csg_exec_operation_smoke.cheng")
    let codexCoreSourcePath = chengpath.PathJoin(codexPackageRoot, "src/core/inventory.cheng")
    let typedFixturePath = chengpath.PathJoin(packageRoot, "src/tests/typed_expr_fact_fixture.cheng")
    let typedHelperPath = chengpath.PathJoin(packageRoot, "src/tests/typed_expr_fact_helper.cheng")
    let typedHelperPlainPath = chengpath.PathJoin(packageRoot, "src/tests/typed_expr_fact_helper_plain.cheng")
    let typedImportcHelperPath = chengpath.PathJoin(packageRoot, "src/tests/typed_expr_fact_importc_helper.cheng")
    let oldDefaultPath = chengpath.PathJoin(packageRoot, "src/tests/composite_default_init_negative_old_default.cheng")
    let scalarTypeCallPath = chengpath.PathJoin(packageRoot, "src/tests/composite_default_init_negative_scalar_type_call.cheng")
    let refTypeCallPath = chengpath.PathJoin(packageRoot, "src/tests/composite_default_init_negative_ref_type_call.cheng")
    let refTypeCallUnusedPath = chengpath.PathJoin(packageRoot, "src/tests/composite_default_init_negative_ref_type_call_unused.cheng")
    let genericZeroArgCallPath = chengpath.PathJoin(packageRoot, "src/tests/composite_default_init_generic_zeroarg_call_ok.cheng")
    let codexManifestPath = chengpath.PathJoin(codexPackageRoot, "cheng-package.toml")
    let rootPackageId = parser.ParserPackageId(packageRoot)
    if rootPackageId != "cheng":
        echo(strutil.Join(["BLOCKER parser_path:package_id got=", rootPackageId], ""))
        return 1
    let stdSlice = chengpath.TextSlice("std/strutils", 4, 8)
    if stdSlice != "strutils":
        echo(strutil.Join(["BLOCKER parser_path:std_slice got=", stdSlice], ""))
        return 1
    let packageImportPath = parser.ParserModulePathToSourcePath(workspaceRoot,
                                                                 packageRoot,
                                                                 "cheng/core/tooling/bootstrap_contracts")
    if packageImportPath != contractsSourcePath:
        echo(strutil.Join(["BLOCKER parser_path:package_import got=", packageImportPath, " expected=", contractsSourcePath], ""))
        return 1
    let stdImportPath = parser.ParserModulePathToSourcePath(workspaceRoot,
                                                             packageRoot,
                                                             "std/strutils")
    if stdImportPath != stdSourcePath:
        echo(strutil.Join(["BLOCKER parser_path:std_import got=", stdImportPath, " expected=", stdSourcePath], ""))
        return 1
    let packageModulePath = parser.ParserSourcePathToModulePath(workspaceRoot,
                                                                 packageRoot,
                                                                 contractsSourcePath)
    if packageModulePath != "cheng/core/tooling/bootstrap_contracts":
        echo(strutil.Join(["BLOCKER parser_path:package_source got=", packageModulePath], ""))
        return 1
    let stdModulePath = parser.ParserSourcePathToModulePath(workspaceRoot,
                                                             packageRoot,
                                                             stdSourcePath)
    if stdModulePath != "std/strutils":
        echo(strutil.Join(["BLOCKER parser_path:std_source got=", stdModulePath], ""))
        return 1
    let codexRootFromWorkspace = creq.CompilerResolvePackageRoot(workspaceRoot,
                                                                  codexSourcePath,
                                                                  workspaceRoot)
    if codexRootFromWorkspace != codexPackageRoot:
        echo(strutil.Join(["BLOCKER parser_path:nested_root_workspace got=", codexRootFromWorkspace, " expected=", codexPackageRoot, " manifest=", codexManifestPath, " manifest_exists=", chengpath.PathBoolText(chengpath.PathFileExists(codexManifestPath))], ""))
        return 1
    let codexRootFromPackage = creq.CompilerResolvePackageRoot(workspaceRoot,
                                                                codexSourcePath,
                                                                packageRoot)
    if codexRootFromPackage != codexPackageRoot:
        echo(strutil.Join(["BLOCKER parser_path:nested_root_package got=", codexRootFromPackage, " expected=", codexPackageRoot], ""))
        return 1
    let codexWorkspaceRoot = parser.ParserWorkspaceRoot(codexPackageRoot)
    if codexWorkspaceRoot != workspaceRoot:
        echo(strutil.Join(["BLOCKER parser_path:nested_workspace_root got=", codexWorkspaceRoot, " expected=", workspaceRoot], ""))
        return 1
    let codexPackageId = parser.ParserPackageId(codexPackageRoot)
    if codexPackageId != "cheng/codex":
        echo(strutil.Join(["BLOCKER parser_path:nested_package_id got=", codexPackageId], ""))
        return 1
    let codexImportPath = parser.ParserModulePathToSourcePath(workspaceRoot,
                                                               codexPackageRoot,
                                                               "cheng/codex/core/inventory")
    if codexImportPath != codexCoreSourcePath:
        echo(strutil.Join(["BLOCKER parser_path:nested_import got=", codexImportPath, " expected=", codexCoreSourcePath], ""))
        return 1
    let sharedImportPath = parser.ParserModulePathToSourcePath(workspaceRoot,
                                                                codexPackageRoot,
                                                                "cheng/core/tooling/bootstrap_contracts")
    if sharedImportPath != contractsSourcePath:
        echo(strutil.Join(["BLOCKER parser_path:shared_import got=", sharedImportPath, " expected=", contractsSourcePath], ""))
        return 1
    let sharedStdImportPath = parser.ParserModulePathToSourcePath(workspaceRoot,
                                                                   codexPackageRoot,
                                                                   "std/strutils")
    if sharedStdImportPath != stdSourcePath:
        echo(strutil.Join(["BLOCKER parser_path:shared_std_import got=", sharedStdImportPath, " expected=", stdSourcePath], ""))
        return 1
    let codexSourceModulePath = parser.ParserSourcePathToModulePath(workspaceRoot,
                                                                     codexPackageRoot,
                                                                     codexCoreSourcePath)
    if codexSourceModulePath != "cheng/codex/core/inventory":
        echo(strutil.Join(["BLOCKER parser_path:nested_source got=", codexSourceModulePath], ""))
        return 1
    let sharedSourceModulePath = parser.ParserSourcePathToModulePath(workspaceRoot,
                                                                      codexPackageRoot,
                                                                      contractsSourcePath)
    if sharedSourceModulePath != "cheng/core/tooling/bootstrap_contracts":
        echo(strutil.Join(["BLOCKER parser_path:shared_source got=", sharedSourceModulePath], ""))
        return 1
    var parsed: parser.ParsedSourceStub
    var err = ""
    if !parser.ParseOrdinarySourceStub(codexPackageRoot, codexSourcePath, parsed, err):
        echo(strutil.Join(["BLOCKER parser_path:nested_package_parse path=", codexSourcePath, " err=", err], ""))
        return 1
    if parsed.workspaceRoot != workspaceRoot:
        echo(strutil.Join(["BLOCKER parser_path:parsed_workspace_root got=", parsed.workspaceRoot, " expected=", workspaceRoot], ""))
        return 1
    if parsed.packageRoot != codexPackageRoot:
        echo(strutil.Join(["BLOCKER parser_path:parsed_package_root got=", parsed.packageRoot, " expected=", codexPackageRoot], ""))
        return 1
    if parsed.ownerModulePaths.len < 1 ||
       !parser.ParserStringSeqContains(parsed.ownerModulePaths, "cheng/codex/tests/rust_csg_exec_operation_smoke"):
        echo(strutil.Join(["BLOCKER parser_path:parsed_owner_module count=", IntToStr(parsed.ownerModulePaths.len)], ""))
        return 1
    if parsed.unresolvedImportCount != 0:
        echo(strutil.Join(["BLOCKER parser_path:parsed_unresolved_imports count=", IntToStr(parsed.unresolvedImportCount)], ""))
        return 1
    var typedParsed: parser.ParsedSourceStub
    err = ""
    if !parser.ParseOrdinarySourceStub(packageRoot, typedFixturePath, typedParsed, err):
        echo(strutil.Join(["BLOCKER parser_path:typed_fixture_parse path=", typedFixturePath, " err=", err], ""))
        return 1
    if typedParsed.normalizedExprLayer.exprs.len == 0:
        echo(strutil.Join(["BLOCKER parser_path:typed_fixture_empty_expr_layer closure_count=",
                           IntToStr(typedParsed.orderedClosureSourcePaths.len),
                           " import_count=",
                           IntToStr(typedParsed.importEdges.len),
                           " unresolved=",
                           IntToStr(typedParsed.unresolvedImportCount)], ""))
        return 1
    var foundGroupedImport = false
    for i in 0..<typedParsed.importEdges.len:
        if typedParsed.importEdges[i].targetModulePath == "cheng/tests/typed_expr_fact_helper_plain":
            foundGroupedImport = true
    if !foundGroupedImport:
        echo(strutil.Join(["BLOCKER parser_path:grouped_import_edge import_count=", IntToStr(typedParsed.importEdges.len)], ""))
        return 1
    if !ParserPathHasCallExprAtSource(typedParsed.normalizedExprLayer,
                                       typedFixturePath,
                                       parser.NormalizedExprSurfaceCallExternal,
                                       29):
        echo(strutil.Join(["DIAG parser_path:typed_expr_count=", IntToStr(typedParsed.normalizedExprLayer.exprs.len)], ""))
        for i in 0..<typedParsed.normalizedExprLayer.exprs.len:
            let expr = typedParsed.normalizedExprLayer.exprs[i]
            if expr.sourcePath == typedFixturePath &&
               expr.lineNumber >= 27 &&
               expr.lineNumber <= 34:
                echo(strutil.Join(["DIAG parser_path:typed_expr line=",
                                   IntToStr(expr.lineNumber),
                                   " expr_kind=",
                                   parser.NormalizedExprKindText(expr.kind),
                                   " kind=",
                                   parser.ParserCallSurfaceKindText(expr.callSurfaceKind),
                                   " resolved=",
                                   chengpath.PathBoolText(expr.callResolved),
                                   " surface=",
                                   expr.surfaceText,
                                   " qualifier=",
                                   expr.callQualifier,
                                   " callee=",
                                   expr.callCallee,
                                   " target=",
                                   expr.callTarget,
                                   " target_source=",
                                   expr.callTargetSourcePath,
                                   " source=",
                                   expr.sourcePath], ""))
        echo("BLOCKER parser_path:alias_external_call line=29")
        return 1
    if !ParserPathHasCallExprAtSource(typedParsed.normalizedExprLayer,
                                       typedFixturePath,
                                       parser.NormalizedExprSurfaceCallExternal,
                                       30):
        echo("BLOCKER parser_path:module_stem_external_call line=30")
        return 1
    if !ParserPathHasCallExprAtSource(typedParsed.normalizedExprLayer,
                                       typedFixturePath,
                                       parser.NormalizedExprSurfaceCallExternal,
                                       31):
        echo("BLOCKER parser_path:nested_qualified_external_call line=31")
        return 1
    if !ParserPathHasCallExprAtSource(typedParsed.normalizedExprLayer,
                                       typedFixturePath,
                                       parser.NormalizedExprSurfaceCallExternal,
                                       33):
        echo("BLOCKER parser_path:alias_importc_external_call line=33")
        return 1
    if !ParserPathHasCallExprAtSource(typedParsed.normalizedExprLayer,
                                       typedFixturePath,
                                       parser.NormalizedExprSurfaceCallExternal,
                                       34):
        echo("BLOCKER parser_path:nested_importc_external_call line=34")
        return 1
    var sawAliasExternalTarget = false
    var sawNestedExternalTarget = false
    var sawAliasImportcTarget = false
    var sawNestedImportcTarget = false
    for i in 0..<typedParsed.normalizedExprLayer.exprs.len:
        let expr = typedParsed.normalizedExprLayer.exprs[i]
        if expr.sourcePath != typedFixturePath:
            continue
        if expr.kind != parser.NormalizedExprCall:
            continue
        if !expr.callResolved:
            continue
        if expr.lineNumber == 29:
            if expr.callTargetSourcePath != typedHelperPath:
                echo(strutil.Join(["BLOCKER parser_path:alias_external_target line=29 got=", expr.callTargetSourcePath, " expected=", typedHelperPath], ""))
                return 1
            if expr.callTargetImportc:
                echo("BLOCKER parser_path:alias_external_importc line=29")
                return 1
            sawAliasExternalTarget = true
        elif expr.lineNumber == 31:
            if expr.callTargetSourcePath != typedHelperPlainPath:
                echo(strutil.Join(["BLOCKER parser_path:nested_external_target line=31 got=", expr.callTargetSourcePath, " expected=", typedHelperPlainPath], ""))
                return 1
            if expr.callTargetImportc:
                echo("BLOCKER parser_path:nested_external_importc line=31")
                return 1
            sawNestedExternalTarget = true
        elif expr.lineNumber == 33:
            if expr.callTargetSourcePath != typedImportcHelperPath:
                echo(strutil.Join(["BLOCKER parser_path:alias_importc_target line=33 got=", expr.callTargetSourcePath, " expected=", typedImportcHelperPath], ""))
                return 1
            if !expr.callTargetImportc:
                echo("BLOCKER parser_path:alias_importc_flag line=33")
                return 1
            sawAliasImportcTarget = true
        elif expr.lineNumber == 34:
            if expr.callTargetSourcePath != typedImportcHelperPath:
                echo(strutil.Join(["BLOCKER parser_path:nested_importc_target line=34 got=", expr.callTargetSourcePath, " expected=", typedImportcHelperPath], ""))
                return 1
            if !expr.callTargetImportc:
                echo("BLOCKER parser_path:nested_importc_flag line=34")
                return 1
            sawNestedImportcTarget = true
    if !sawAliasExternalTarget:
        echo("BLOCKER parser_path:saw_alias_external_target line=29")
        return 1
    if !sawNestedExternalTarget:
        echo("BLOCKER parser_path:saw_nested_external_target line=31")
        return 1
    if !sawAliasImportcTarget:
        echo("BLOCKER parser_path:saw_alias_importc_target line=33")
        return 1
    if !sawNestedImportcTarget:
        echo("BLOCKER parser_path:saw_nested_importc_target line=34")
        return 1

    let trimmedSliceFixturePath = chengpath.PathJoin(packageRoot, "src/tests/parser_trimmed_slice_fixture.cheng")
    let trimmedSliceFixtureText = """
fn main(): int32 =
    var alpha: int32
       alpha   =   41
    if alpha > 0:   return   alpha + 1
    return    0
"""
    var trimmedSliceLayer: parser.NormalizedExprLayer
    err = ""
    assert(parser.ParserReadNormalizedExprLayerFromText(trimmedSliceFixturePath,
                                                        trimmedSliceFixtureText,
                                                        trimmedSliceLayer,
                                                        err),
           " parser path: trimmed slice fixture parses")
    assert(parser.NormalizedExprLayerAssignCount(trimmedSliceLayer) == 1,
           " parser path: trimmed assignment count")
    assert(parser.NormalizedExprLayerReturnCount(trimmedSliceLayer) == 2,
           " parser path: trimmed return count")
    var sawTrimmedAssign = false
    var sawTrimmedIfReturn = false
    var sawTrimmedReturn = false
    for i in 0..<trimmedSliceLayer.exprs.len:
        let expr = trimmedSliceLayer.exprs[i]
        if expr.sourcePath != trimmedSliceFixturePath:
            continue
        if expr.kind == parser.NormalizedExprAssign && expr.lineNumber == 3:
            assert(expr.surfaceText == "alpha",
                   " parser path: assignment lhs trimmed slice")
            assert(expr.callArgsText == "41",
                   " parser path: assignment rhs trimmed slice")
            sawTrimmedAssign = true
        elif expr.kind == parser.NormalizedExprReturn && expr.lineNumber == 4:
            assert(expr.surfaceText == "alpha + 1",
                   " parser path: if return trimmed slice")
            sawTrimmedIfReturn = true
        elif expr.kind == parser.NormalizedExprReturn && expr.lineNumber == 5:
            assert(expr.surfaceText == "0",
                   " parser path: return trimmed slice")
            sawTrimmedReturn = true
    assert(sawTrimmedAssign, " parser path: saw trimmed assignment")
    assert(sawTrimmedIfReturn, " parser path: saw trimmed if return")
    assert(sawTrimmedReturn, " parser path: saw trimmed return")

    assert(parser.ParserLineStartsWithStatementKeyword("   if alpha > 0:", "if"),
           " parser path: keyword leading spaces")
    assert(parser.ParserLineStartsWithStatementKeyword("\tfor item in items:", "for"),
           " parser path: keyword leading tab")
    assert(parser.ParserLineStartsWithStatementKeyword("return 0", "return"),
           " parser path: keyword bare return")
    assert(parser.ParserLineStartsWithStatementKeyword("if: return 0", "if"),
           " parser path: keyword colon boundary")
    assert(!parser.ParserLineStartsWithStatementKeyword("   ifx alpha > 0:", "if"),
           " parser path: keyword ident boundary false")
    assert(!parser.ParserLineStartsWithStatementKeyword("format value:", "for"),
           " parser path: keyword prefix false")
    assert(!parser.ParserLineStartsWithStatementKeyword("   # if alpha > 0:", "if"),
           " parser path: keyword comment false")

    let statementKeywordFixturePath = chengpath.PathJoin(packageRoot,
                                                         "src/tests/parser_statement_keyword_fixture.cheng")
    let statementKeywordFixtureText = """
fn main(): int32 =
       if alpha > 0:
           return 1
       ifx alpha > 0:
           return 2
       for item in items:
           return 3
       format value:
           return 4
       else:
           return 5
"""
    var statementKeywordLayer: parser.NormalizedExprLayer
    err = ""
    assert(parser.ParserReadNormalizedExprLayerFromText(statementKeywordFixturePath,
                                                        statementKeywordFixtureText,
                                                        statementKeywordLayer,
                                                        err),
           " parser path: statement keyword fixture parses")
    assert(parser.NormalizedExprLayerIfStmtCount(statementKeywordLayer) == 1,
           " parser path: exact if keyword count")
    assert(parser.NormalizedExprLayerForStmtCount(statementKeywordLayer) == 1,
           " parser path: exact for keyword count")
    assert(parser.NormalizedExprLayerElseStmtCount(statementKeywordLayer) == 1,
           " parser path: exact else keyword count")
    let statementKeywordCounts = parser.NormalizedExprLayerKindCountsBuild(statementKeywordLayer)
    assert(statementKeywordCounts.exprCount == parser.NormalizedExprLayerExprCount(statementKeywordLayer),
           " parser path: batched expr count")
    assert(statementKeywordCounts.ifStmtCount == 1,
           " parser path: batched if keyword count")
    assert(statementKeywordCounts.forStmtCount == 1,
           " parser path: batched for keyword count")
    assert(statementKeywordCounts.elseStmtCount == 1,
           " parser path: batched else keyword count")
    var sawStatementKeywordIf = false
    var sawStatementKeywordFor = false
    var sawStatementKeywordElse = false
    for i in 0..<statementKeywordLayer.exprs.len:
        let expr = statementKeywordLayer.exprs[i]
        if expr.sourcePath != statementKeywordFixturePath:
            continue
        if expr.kind == parser.NormalizedExprIfStmt:
            assert(expr.lineNumber == 2,
                   " parser path: ifx is not if statement")
            assert(expr.surfaceText == "alpha > 0",
                   " parser path: if payload exact")
            sawStatementKeywordIf = true
        elif expr.kind == parser.NormalizedExprForStmt:
            assert(expr.lineNumber == 6,
                   " parser path: format is not for statement")
            assert(expr.surfaceText == "item in items",
                   " parser path: for payload exact")
            sawStatementKeywordFor = true
        elif expr.kind == parser.NormalizedExprElseStmt:
            assert(expr.lineNumber == 10,
                   " parser path: else exact keyword")
            sawStatementKeywordElse = true
    assert(sawStatementKeywordIf, " parser path: saw exact if keyword")
    assert(sawStatementKeywordFor, " parser path: saw exact for keyword")
    assert(sawStatementKeywordElse, " parser path: saw exact else keyword")

    var oldDefaultParsed: parser.ParsedSourceStub
    err = ""
    assert(!parser.ParseOrdinarySourceStub(packageRoot, oldDefaultPath, oldDefaultParsed, err),
           " parser path: old default syntax rejected in frontend")
    assert(chengpath.TextContains(err, "default[T] removed"),
           " parser path: old default syntax diagnostic")
    var scalarTypeCallParsed: parser.ParsedSourceStub
    err = ""
    assert(!parser.ParseOrdinarySourceStub(packageRoot, scalarTypeCallPath, scalarTypeCallParsed, err),
           " parser path: scalar type call rejected in frontend")
    assert(chengpath.TextContains(err, "simple type T() unsupported"),
           " parser path: scalar type call diagnostic")
    var refTypeCallParsed: parser.ParsedSourceStub
    err = ""
    assert(!parser.ParseOrdinarySourceStub(packageRoot, refTypeCallPath, refTypeCallParsed, err),
           " parser path: ref type call rejected in frontend")
    assert(chengpath.TextContains(err, "ref object T() unsupported"),
           " parser path: ref type call diagnostic")
    var refTypeCallUnusedParsed: parser.ParsedSourceStub
    err = ""
    assert(!parser.ParseOrdinarySourceStub(packageRoot, refTypeCallUnusedPath, refTypeCallUnusedParsed, err),
           " parser path: unused ref type call rejected in frontend")
    assert(chengpath.TextContains(err, "ref object T() unsupported"),
           " parser path: unused ref type call diagnostic")
    var genericZeroArgCallParsed: parser.ParsedSourceStub
    err = ""
    assert(parser.ParserTypeExprLooksLikeLowerGenericFunction("elemSize[int32]"),
           " parser path: lower generic helper detects elemSize")
    assert(!parser.ParserTypeExprLooksLikeLowerGenericFunction("SurfacePair"),
           " parser path: lower generic helper leaves type name")
    assert(!parser.ParserTypeExprLooksLikeLowerGenericFunction("int32[]"),
           " parser path: lower generic helper leaves seq type")
    assert(!parser.ParserTypeExprLooksLikeLowerGenericFunction("int32[2]"),
           " parser path: lower generic helper leaves fixed type")
    assert(parser.ParseOrdinarySourceStub(packageRoot, genericZeroArgCallPath, genericZeroArgCallParsed, err),
           " parser path: lower generic zeroarg call parses")
    var genericZeroArgMisclassified = false
    for i in 0..<genericZeroArgCallParsed.normalizedExprLayer.exprs.len:
        let expr = genericZeroArgCallParsed.normalizedExprLayer.exprs[i]
        if expr.sourcePath != genericZeroArgCallPath || expr.lineNumber != 4:
            continue
        if expr.kind == parser.NormalizedExprDefaultInit ||
           expr.kind == parser.NormalizedExprConstructor:
            genericZeroArgMisclassified = true
    assert(!genericZeroArgMisclassified,
           " parser path: lower generic zeroarg not type-call")
    echo(" parser_path_smoke ok")
    return 0
