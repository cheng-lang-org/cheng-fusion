# depin settle smoke: DePIN metering cycle end-to-end - evidence meters,
# Merkle-sum batch submit, payer escrow lock, challenge-window enforcement,
# per-provider payout finalize, and supply conservation.

import std/os
import std/system
import std/rawbytes
import cheng/std/bytes_layout as layout
import cheng/apps/rwad/rwad_settlement as ssm
import cheng/apps/rwad/rwad_depin_settle as dps

fn CidTag(b: int32): layout.FixedBytes32 =
    var raw = BytesAlloc(32)
    BytesSet(raw, 0, b)
    let res = layout.FixedBytes32FromBytes(raw)
    return res.value

fn main(): int32 =
    var rc: int32 = 0

    let payerCid = CidTag(5)
    let provA = CidTag(1)
    let provB = CidTag(2)

    var st = ssm.SsmInit()
    let creditRes = ssm.SsmCredit(st, payerCid, Int64(5000))
    if !creditRes.ok:
        os.WriteLine(os.Get_stderr(), "credit payer failed")
        return 1
    if ssm.SsmBalanceOf(st, payerCid) != 5000:
        os.WriteLine(os.Get_stderr(), "credit balance wrong")
        return 1

    # open cycle with two evidence meters
    var cycle: dps.DepinCycle
    cycle.cycleCid = CidTag(9)
    cycle.payerCid = payerCid
    cycle.status = 0

    var mA: dps.DepinMeter
    mA.providerCid = provA
    mA.gpuHoursMilli = Int64(10000)
    mA.unitPriceMilli = Int64(300000)
    mA.evidenceDigest = CidTag(11)
    let addA = dps.CycleAddMeter(cycle, mA)
    if !addA.ok:
        os.WriteLine(os.Get_stderr(), "meter A rejected")
        return 1

    var mB: dps.DepinMeter
    mB.providerCid = provB
    mB.gpuHoursMilli = Int64(4000)
    mB.unitPriceMilli = Int64(500000)
    mB.evidenceDigest = CidTag(12)
    let addB = dps.CycleAddMeter(cycle, mB)
    if !addB.ok:
        os.WriteLine(os.Get_stderr(), "meter B rejected")
        return 1
    if cycle.meters.len != 2:
        os.WriteLine(os.Get_stderr(), "meter count wrong")
        rc = rc + 1

    # negative: zero-duration metering rejected
    var mZero: dps.DepinMeter
    mZero.providerCid = provA
    mZero.gpuHoursMilli = Int64(0)
    mZero.unitPriceMilli = Int64(300000)
    mZero.evidenceDigest = CidTag(13)
    let addZero = dps.CycleAddMeter(cycle, mZero)
    if addZero.ok:
        os.WriteLine(os.Get_stderr(), "zero-duration meter accepted")
        rc = rc + 1

    # negative: all-zero evidence digest rejected
    let zeroFb = layout.FixedBytes32()
    var mNoEv: dps.DepinMeter
    mNoEv.providerCid = provA
    mNoEv.gpuHoursMilli = Int64(10000)
    mNoEv.unitPriceMilli = Int64(300000)
    mNoEv.evidenceDigest = zeroFb
    let addNoEv = dps.CycleAddMeter(cycle, mNoEv)
    if addNoEv.ok:
        os.WriteLine(os.Get_stderr(), "all-zero digest accepted")
        rc = rc + 1
    if cycle.meters.len != 2:
        os.WriteLine(os.Get_stderr(), "rejected meters leaked into cycle")
        rc = rc + 1

    # submit: lock 5000 from payer, challenge until 2000
    let subRes = dps.CycleSubmit(cycle, st, Int64(1000), Int64(1000))
    if !subRes.ok:
        os.WriteLine(os.Get_stderr(), "cycle submit failed")
        return 1
    if cycle.status != 1:
        os.WriteLine(os.Get_stderr(), "cycle status not submitted")
        rc = rc + 1
    if cycle.totalDue != 5000:
        os.WriteLine(os.Get_stderr(), "totalDue wrong")
        rc = rc + 1
    if cycle.challengeUntilMs != 2000:
        os.WriteLine(os.Get_stderr(), "challenge deadline wrong")
        rc = rc + 1
    if dps.ZeroDigest(cycle.root):
        os.WriteLine(os.Get_stderr(), "batch root empty")
        rc = rc + 1
    if ssm.SsmBalanceOf(st, payerCid) != 0:
        os.WriteLine(os.Get_stderr(), "payer not fully locked")
        rc = rc + 1
    var ei: int32 = 0
    if st.escrows[ei].amountLocked != 5000 or st.escrows[ei].amountReleased != 0:
        os.WriteLine(os.Get_stderr(), "escrow lock legs wrong")
        rc = rc + 1

    # negative: metering frozen once submitted
    var mLate: dps.DepinMeter
    mLate.providerCid = provA
    mLate.gpuHoursMilli = Int64(1000)
    mLate.unitPriceMilli = Int64(300000)
    mLate.evidenceDigest = CidTag(14)
    let addLate = dps.CycleAddMeter(cycle, mLate)
    if addLate.ok:
        os.WriteLine(os.Get_stderr(), "meter accepted after submit")
        rc = rc + 1
    if cycle.meters.len != 2:
        os.WriteLine(os.Get_stderr(), "late meter mutated cycle")
        rc = rc + 1

    # negative: finalize inside the challenge window rejected
    let finEarly = dps.CycleFinalize(cycle, st, Int64(1500))
    if finEarly.ok:
        os.WriteLine(os.Get_stderr(), "early finalize accepted")
        rc = rc + 1
    if cycle.status != 1:
        os.WriteLine(os.Get_stderr(), "status drifted on early finalize")
        rc = rc + 1

    # finalize after the window pays providers exactly
    let finRes = dps.CycleFinalize(cycle, st, Int64(2001))
    if !finRes.ok:
        os.WriteLine(os.Get_stderr(), "finalize failed")
        return 1
    if cycle.status != 2:
        os.WriteLine(os.Get_stderr(), "cycle status not finalized")
        rc = rc + 1
    if ssm.SsmBalanceOf(st, provA) != 3000:
        os.WriteLine(os.Get_stderr(), "provider A payout wrong")
        rc = rc + 1
    if ssm.SsmBalanceOf(st, provB) != 2000:
        os.WriteLine(os.Get_stderr(), "provider B payout wrong")
        rc = rc + 1
    if ssm.SsmBalanceOf(st, payerCid) != 0:
        os.WriteLine(os.Get_stderr(), "payer balance drifted")
        rc = rc + 1
    if st.escrows[ei].amountLocked != 0 or st.escrows[ei].amountReleased != 5000:
        os.WriteLine(os.Get_stderr(), "escrow release legs wrong")
        rc = rc + 1

    # conservation: locked 5000 == payout 3000 + 2000, nothing minted
    let paid: int64 = ssm.SsmBalanceOf(st, provA) + ssm.SsmBalanceOf(st, provB)
    if paid != 5000:
        os.WriteLine(os.Get_stderr(), "conservation broken")
        rc = rc + 1

    if rc == 0:
        echo("depin_settle_smoke ok")
    return rc
