@profile("driver_safe")
import std/driver_safe as ds

@trusted_abi
fn UartTx(): ds.MmioRegU8 =
    let base = ds.TrustedPhysAddr(uint64(268435456))
    return ds.TrustedMmioRegU8(base, uint64(0))

@no_alloc
fn ScalarOnly(value: int32): int32 =
    return value + 1

@interrupt_handler
fn TimerInterruptMarker(): int32 =
    return 0

fn main(): int32 =
    let _uart = UartTx()
    let a = ScalarOnly(41)
    let b = TimerInterruptMarker()
    if b != 0:
        return 1
    if a != 42:
        return 2
    return 0
