fn pick3(c: int32): str =
    return if c == 1: "a" else elif c == 2: "b" else: "c"

fn picki(c: int32): int32 =
    return if c == 1: 10 else elif c == 2: 20 else: 30

fn main(): int32 =
    if pick3(2) != "b":
        return 1
    if pick3(3) != "c":
        return 2
    if picki(1) != 10:
        return 3
    if picki(2) != 20:
        return 4
    if picki(9) != 30:
        return 5
    return 0
