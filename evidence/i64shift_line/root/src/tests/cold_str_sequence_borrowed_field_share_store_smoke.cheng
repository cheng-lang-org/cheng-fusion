import std/seqs

type
    ColdBorrowedReasonReport =
        reason: str
        bodyValue: int32

fn ColdBorrowedReasonReportNew(): ColdBorrowedReasonReport =
    var report: ColdBorrowedReasonReport
    report.reason = "reason-" + "owned"
    report.bodyValue = 73
    return report

fn main(): int32 =
    var values: str[]
    seqs.setLen(values, 1)
    let report = ColdBorrowedReasonReportNew()
    values[0] = share(report.reason)
    if values[0] != "reason-owned" ||
       report.reason != "reason-owned" ||
       report.bodyValue != 73:
        return 1
    values[0] = share(report.reason)
    if values[0] != report.reason:
        return 2
    values[0] = ""
    if values[0] != "" || report.reason != "reason-owned":
        return 3
    return 0
