type
    VersionParts =
        major: int32
        minor: int32
        patch: int32

    DepEdge =
        from: str
        to: str

    DependencyGraph =
        nodeCount: int32
        nodeIds: str[]
        edgeCount: int32
        edges: DepEdge[]

// ===== String helpers =====

fn ParseIntRange(s: str, start: int32, endAt: int32): int32 =
    var val: int32
    var i: int32 = start
    while i < endAt && i < s.len:
        let ch = s[i]
        if ch < '0' || ch > '9':
            break
        val = val * 10 + (Int32(ch) - 48)
        i = i + 1
    return val

fn FindChar(s: str, ch: char, start: int32): int32 =
    var i: int32 = start
    while i < s.len:
        if s[i] == ch:
            return i
        i = i + 1
    return -1

// ===== Version operations =====

fn VersionParse(ver: str): VersionParts =
    var out: VersionParts
    out.major = 0
    out.minor = 0
    out.patch = 0
    if ver.len <= 0:
        return out
    let dot1 = FindChar(ver, '.', 0)
    if dot1 < 0:
        out.major = ParseIntRange(ver, 0, ver.len)
    else:
        out.major = ParseIntRange(ver, 0, dot1)
        let dot2 = FindChar(ver, '.', dot1 + 1)
        if dot2 < 0:
            out.minor = ParseIntRange(ver, dot1 + 1, ver.len)
        else:
            out.minor = ParseIntRange(ver, dot1 + 1, dot2)
            out.patch = ParseIntRange(ver, dot2 + 1, ver.len)
    return out

fn VersionCompare(a: VersionParts, b: VersionParts): int32 =
    if a.major < b.major: return -1
    if a.major > b.major: return 1
    if a.minor < b.minor: return -1
    if a.minor > b.minor: return 1
    if a.patch < b.patch: return -1
    if a.patch > b.patch: return 1
    return 0

// ===== Graph operations =====

fn DepEdgeMake(fromVal: str, toVal: str): DepEdge =
    var out: DepEdge
    out.from = fromVal
    out.to = toVal
    return out

fn ArrContains(arr: str[], val: str): bool =
    for i in 0..<arr.len:
        if arr[i] == val:
            return true
    return false

fn TopologicalSort(graph: DependencyGraph): str[] =
    var inDeg: int32[]
    for i in 0..<graph.nodeCount:
        add(inDeg, 0)
    for i in 0..<graph.edges.len:
        let targetId = graph.edges[i].to
        for j in 0..<graph.nodeCount:
            if graph.nodeIds[j] == targetId:
                inDeg[j] = inDeg[j] + 1
                break
    var queue: str[]
    for i in 0..<graph.nodeCount:
        if inDeg[i] == 0:
            add(queue, graph.nodeIds[i])
    var result: str[]
    while queue.len > 0:
        let nodeId = queue[0]
        var newQ: str[]
        for i in 1..<queue.len:
            add(newQ, queue[i])
        queue = newQ
        add(result, nodeId)
        for i in 0..<graph.edges.len:
            if graph.edges[i].from == nodeId:
                let targetId = graph.edges[i].to
                for j in 0..<graph.nodeCount:
                    if graph.nodeIds[j] == targetId:
                        inDeg[j] = inDeg[j] - 1
                        if inDeg[j] == 0:
                            add(queue, graph.nodeIds[j])
                        break
    return result

fn DetectCycles(graph: DependencyGraph): str[] =
    // Use Kahn's: if result.len != nodeCount, there are cycles
    let sorted = TopologicalSort(graph)
    if sorted.len == graph.nodeCount:
        return []  // no cycles
    // Find a cycle: pick a node not in sorted and trace
    var remaining: str[]
    for i in 0..<graph.nodeCount:
        let nid = graph.nodeIds[i]
        if !ArrContains(sorted, nid):
            add(remaining, nid)
    // Return remaining nodes (the cycle participants)
    return remaining

fn VersionConstraintMakeExact(ver: str): VersionConstraint =
    var out: VersionConstraint
    out.constraintType = 0
    out.exactVersion = ver
    out.minVersion = ver
    out.maxVersion = ver
    return out

fn VersionConstraintMakeCaret(minVer: str): VersionConstraint =
    var out: VersionConstraint
    out.constraintType = 1
    out.minVersion = minVer
    var vp = VersionParse(minVer)
    vp.major = vp.major + 1
    vp.minor = 0
    vp.patch = 0
    out.maxVersion = IntToStr(vp.major)
    return out

// ===== Version constraint and resolution =====

type
    VersionConstraint =
        constraintType: int32
        exactVersion: str
        minVersion: str
        maxVersion: str

fn VersionSatisfies(vp: VersionParts, constraint: VersionConstraint): bool =
    if constraint.constraintType == 0:
        let exactParts = VersionParse(constraint.exactVersion)
        return VersionCompare(vp, exactParts) == 0
    let minParts = VersionParse(constraint.minVersion)
    if VersionCompare(vp, minParts) < 0:
        return false
    let maxParts = VersionParse(constraint.maxVersion)
    if VersionCompare(vp, maxParts) >= 0:
        return false
    return true

fn ResolveBestVersion(constraint: VersionConstraint, available: str[]): str =
    var bestVersion = ""
    var bestMajor: int32 = -1
    var bestMinor: int32 = -1
    var bestPatch: int32 = -1
    for i in 0..<available.len:
        let vp = VersionParse(available[i])
        if VersionSatisfies(vp, constraint):
            if bestMajor < 0 ||
               vp.major > bestMajor ||
               (vp.major == bestMajor && vp.minor > bestMinor) ||
               (vp.major == bestMajor && vp.minor == bestMinor && vp.patch > bestPatch):
                bestVersion = available[i]
                bestMajor = vp.major
                bestMinor = vp.minor
                bestPatch = vp.patch
    return bestVersion

// ===== Tests =====

fn main(): int32 =
    // 1. VersionParse basic
    let v1 = VersionParse("1.2.3")
    if v1.major != 1: echo("FAIL 1a"); return 1
    if v1.minor != 2: echo("FAIL 1b"); return 1
    if v1.patch != 3: echo("FAIL 1c"); return 1

    // 2. VersionParse two-component
    let v2 = VersionParse("2.0")
    if v2.major != 2 || v2.minor != 0 || v2.patch != 0:
        echo("FAIL 2"); return 1

    // 3. VersionParse single-component
    let v3 = VersionParse("5")
    if v3.major != 5 || v3.minor != 0 || v3.patch != 0:
        echo("FAIL 3"); return 1

    // 4. VersionParse multi-digit
    let v4 = VersionParse("10.20.30")
    if v4.major != 10 || v4.minor != 20 || v4.patch != 30:
        echo("FAIL 4"); return 1

    // 5. VersionParse empty
    let v5 = VersionParse("")
    if v5.major != 0 || v5.minor != 0 || v5.patch != 0:
        echo("FAIL 5"); return 1

    // 6. VersionCompare less/greater/equal
    if VersionCompare(v1, v1) != 0: echo("FAIL 6a"); return 1
    let vSmall = VersionParse("0.9.0")
    if VersionCompare(vSmall, v1) != -1: echo("FAIL 6b"); return 1
    if VersionCompare(v1, vSmall) != 1: echo("FAIL 6c"); return 1
    if VersionCompare(VersionParse("1.10.0"), VersionParse("1.2.0")) != 1:
        echo("FAIL 6d"); return 1

    // 7. DepEdge
    let de = DepEdgeMake("x", "y")
    if de.from != "x": echo("FAIL 7a"); return 1
    if de.to != "y": echo("FAIL 7b"); return 1

    // 8. DepEdge array
    var edges: DepEdge[]
    add(edges, DepEdgeMake("a", "b"))
    add(edges, DepEdgeMake("c", "d"))
    if edges.len != 2: echo("FAIL 8a"); return 1
    if edges[0].from != "a": echo("FAIL 8b"); return 1
    if edges[1].to != "d": echo("FAIL 8c"); return 1

    // 9. Topological sort: root -> b -> a
    var n: str[]
    add(n, "root"); add(n, "a"); add(n, "b")
    var e: DepEdge[]
    add(e, DepEdgeMake("root", "a"))
    add(e, DepEdgeMake("root", "b"))
    add(e, DepEdgeMake("b", "a"))
    var g: DependencyGraph
    g.nodeIds = n; g.nodeCount = n.len
    g.edges = e; g.edgeCount = e.len
    let order = TopologicalSort(g)
    if order.len != 3: echo("FAIL 9a"); return 1
    if order[0] != "root": echo("FAIL 9b"); return 1
    if order[1] != "b": echo("FAIL 9c"); return 1
    if order[2] != "a": echo("FAIL 9d"); return 1

    // 10. Cycle detection: acyclic
    var an: str[]; add(an, "p"); add(an, "q")
    var ae: DepEdge[]; add(ae, DepEdgeMake("p", "q"))
    var ag: DependencyGraph
    ag.nodeIds = an; ag.nodeCount = an.len
    ag.edges = ae; ag.edgeCount = ae.len
    if DetectCycles(ag).len > 0: echo("FAIL 10"); return 1

    // 11. Cycle detection: cyclic x -> y -> x
    var cn: str[]; add(cn, "x"); add(cn, "y")
    var ce: DepEdge[]
    add(ce, DepEdgeMake("x", "y"))
    add(ce, DepEdgeMake("y", "x"))
    var cg: DependencyGraph
    cg.nodeIds = cn; cg.nodeCount = cn.len
    cg.edges = ce; cg.edgeCount = ce.len
    let cycle = DetectCycles(cg)
    if cycle.len <= 0: echo("FAIL 11a"); return 1

    // 12. Cycle detection: larger cycle a->b->c->a
    var lcn: str[]; add(lcn, "a"); add(lcn, "b"); add(lcn, "c")
    var lce: DepEdge[]
    add(lce, DepEdgeMake("a", "b"))
    add(lce, DepEdgeMake("b", "c"))
    add(lce, DepEdgeMake("c", "a"))
    var lcg: DependencyGraph
    lcg.nodeIds = lcn; lcg.nodeCount = lcn.len
    lcg.edges = lce; lcg.edgeCount = lce.len
    let lcycle = DetectCycles(lcg)
    if lcycle.len <= 0: echo("FAIL 12"); return 1

    // 13. Version constraint: exact
    let exactC = VersionConstraintMakeExact("1.5.0")
    if !VersionSatisfies(VersionParse("1.5.0"), exactC):
        echo("FAIL 13a"); return 1
    if VersionSatisfies(VersionParse("2.0.0"), exactC):
        echo("FAIL 13b"); return 1

    // 14. Version constraint: caret ^1
    let caretC = VersionConstraintMakeCaret("1.0")
    if !VersionSatisfies(VersionParse("1.5.0"), caretC):
        echo("FAIL 14a"); return 1
    if !VersionSatisfies(VersionParse("1.99.99"), caretC):
        echo("FAIL 14b"); return 1
    if VersionSatisfies(VersionParse("2.0.0"), caretC):
        echo("FAIL 14c"); return 1
    if VersionSatisfies(VersionParse("0.9.0"), caretC):
        echo("FAIL 14d"); return 1

    // 15. Version resolution: caret picks highest
    var available: str[]
    add(available, "1.0.0"); add(available, "1.1.0")
    add(available, "2.0.0"); add(available, "1.2.5")
    let bestCaret = ResolveBestVersion(VersionConstraintMakeCaret("1.0"), available)
    if bestCaret != "1.2.5": echo("FAIL 15a"); return 1

    // 16. Version resolution: exact match
    let bestExact = ResolveBestVersion(VersionConstraintMakeExact("1.1.0"), available)
    if bestExact != "1.1.0": echo("FAIL 16"); return 1

    // 17. Version resolution: no match
    let noMatch = ResolveBestVersion(VersionConstraintMakeCaret("3.0"), available)
    if noMatch.len > 0: echo("FAIL 17"); return 1

    // 18. Version resolution: empty available
    var empty: str[]
    let noAvail = ResolveBestVersion(VersionConstraintMakeExact("1.0"), empty)
    if noAvail.len > 0: echo("FAIL 18"); return 1

    echo("ALL PASS")
    return 0
