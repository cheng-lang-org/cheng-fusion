type ColdVarValueSnapshot =
    left: int32
    right: int32
    marker: int32

type ColdVarValueOriginOther =
    first: int32
    second: int32

type ColdVarValueLaneRef = ref object
    marker: int32

fn ColdVarValueRead(value: ColdVarValueSnapshot): int32 =
    return value.left + value.right + value.marker

fn ColdVarValueForward(value: var ColdVarValueSnapshot): int32 =
    return ColdVarValueRead(value)

fn ColdVarValueOriginProbe(
        value: var ColdVarValueSnapshot,
        other: var ColdVarValueOriginOther): int32 =
    return ColdVarValueRead(value) + other.first - other.first

@borrows
fn ColdVarValueLaneRefRead(value: ColdVarValueLaneRef): int32 =
    return value.marker

fn main(): int32 =
    var value: ColdVarValueSnapshot =
        ColdVarValueSnapshot(left: 7, right: 11, marker: 13)
    var other: ColdVarValueOriginOther =
        ColdVarValueOriginOther(first: 17, second: 19)
    var laneRef = new(ColdVarValueLaneRef)
    laneRef.marker = 23
    if ColdVarValueForward(value) != 31:
        return 2
    if ColdVarValueOriginProbe(value, other) != 31:
        return 3
    if ColdVarValueLaneRefRead(laneRef) != 23:
        return 4
    laneRef = nil
    return 0
