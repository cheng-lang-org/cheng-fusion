# AD1 negative control `_ad1_scratch_stale` (ar2 line; design
# .rebuild/ad1_line/ARENA_ROUTING_DESIGN.md §5.4) -- REPLICA form, inlined
# (platform walls listed in _ad1_scratch_overflow.cheng / report §6).
#
# Pinned here: the arenaRequireLive / ReserveEmpty guard semantics for the
# post-release state the facade produces by releasing the scratch arena at
# every tree release point (design decision point 2).  ArenaRelease zeroes
# every Arena field, and the FIRST live guard (`capacityBytes <= 0` ->
# "arena: uninitialized") must reject any later operation before storage
# is touched.  Exit 0 = the fail-closed guard held; a `return` in the 6/7
# block would mean a use-after-release was silently accepted.

fn main(): int32 =
    # Live arena: capacity/alignment/generation all sane.
    var arenaCapacity: int32
    arenaCapacity = 256
    var arenaAlignment: int32
    arenaAlignment = 8
    var arenaUsed: int32
    var arenaGeneration: int32
    arenaGeneration = 1
    # arenaRequireLive predicate over the live arena: passes.
    if arenaCapacity <= 0:
        return 3
    if arenaAlignment <= 0:
        return 4
    if arenaUsed < 0 || arenaUsed > arenaCapacity:
        return 5
    if arenaGeneration <= 0:
        return 6
    # Post-release state: ArenaRelease zeroes every field.
    arenaCapacity = 0
    arenaAlignment = 0
    arenaUsed = 0
    arenaGeneration = 0
    # Any post-release facade operation must be rejected on the FIRST
    # guard (uninitialized), before storage is ever touched.
    if arenaCapacity <= 0:
        return 0
    # Reaching here means the uninitialized guard did not fire.
    return 7
