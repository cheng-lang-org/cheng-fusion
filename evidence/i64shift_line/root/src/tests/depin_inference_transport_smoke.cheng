type
    DepinTransportSmokeWeightFixture =
        graph: mg.ModelGraph
        bindings: wb.WeightBindingSet
        store: ws.WeightTensorStore

    DepinTransportSmokeActivationFixture =
        shards: engine.DistributedActivationShard[]
        payloads: at.ActivationTensorPayload[]

    DepinTransportSmokeKvFixture =
        cache: pkv.PagedKVCache
        seq: pkv.PagedKVSequence
        receipt: pkv.PagedKVReceipt
        stateHash: int64

fn depinInferenceTransportSmokeFrame(kind: int64): pipe.DepinInferenceWireFrame =
    var frame: pipe.DepinInferenceWireFrame
    frame.magic = int64(pipe.DepinInferenceWireFrameMagic)
    frame.frameKind = kind
    frame.enginePlanHash = int64(101)
    frame.seqNo = int64(0)
    frame.coordinatorPeerHash = int64(201)
    frame.sourcePeerHash = int64(202)
    frame.targetPeerHash = int64(203)
    frame.shardNameHash = int64(204)
    frame.requestHash = int64(301)
    frame.responseHash = int64(0)
    frame.envelopeHash = int64(0)
    frame.payloadHash = int64(401)
    frame.receiptHash = int64(0)
    frame.sentAtNs = int64(501)
    frame.frameHash = int64(601)
    if kind == int64(pipe.DepinInferenceWireFrameKindResponse):
        frame.responseHash = int64(302)
        frame.envelopeHash = int64(303)
        frame.receiptHash = int64(304)
    return frame

fn depinInferenceTransportSmokeDistributedFrame(kind: str, seqNo: uint64): engine.DistributedShardTransportFrame =
    var sourcePeerId: str = "peer:coordinator"
    var targetPeerId: str = "peer:a"
    var responseHash: int64 = int64(0)
    var envelopeHash: int64 = int64(0)
    var receiptHash: int64 = int64(0)
    if kind == engine.DistributedTransportFrameKindResponse:
        sourcePeerId = "peer:a"
        targetPeerId = "peer:coordinator"
        responseHash = int64(302)
        envelopeHash = int64(303)
        receiptHash = int64(304)
    return engine.DistributedShardTransportFrameBuild(engine.DistributedShardTransportFrame(
        schema: "",
        frameKind: kind,
        enginePlanHash: int64(101),
        seqNo: seqNo,
        coordinatorPeerId: "peer:coordinator",
        sourcePeerId: sourcePeerId,
        targetPeerId: targetPeerId,
        shardName: "hidden:tokens:0",
        requestHash: int64(301),
        responseHash: responseHash,
        envelopeHash: envelopeHash,
        payloadHash: int64(401),
        receiptHash: receiptHash,
        sentAtNs: int64(501),
        frameHash: int64(0)
    ))

fn depinInferenceTransportSmokeOpen(pair: var quic_transport.Libp2pQuicLoopbackPair): Result[bool] =
    var listenAddr: types.Libp2pMultiaddr
    multiaddr.Libp2pMultiaddrFillQuic(listenAddr, "127.0.0.1", 0)
    let openRes = quic_transport.Libp2pQuicLoopbackOpenInto(pair, listenAddr)
    if IsErr(openRes):
        return Err[bool](ErrorText(openRes))
    return quic_transport.Libp2pQuicLoopbackSelectProtocol(pair, types.Libp2pProtocolDepinInference)

fn depinInferenceTransportSmokeDerivePair(out: var quic_transport.Libp2pQuicLoopbackPair,
                                          base: quic_transport.Libp2pQuicLoopbackPair,
                                          streamId: int64) =
    out.listener = base.listener
    out.client = base.client
    out.listenAddr = base.listenAddr
    out.outbound = qconn.ConnDeriveStream(base.outbound, streamId, streamId)
    out.inbound = qconn.ConnDeriveStream(base.inbound, streamId, streamId)

fn depinTransportSmokeMakeTensor(shape: int32[], scale: int32, data: int32[]): infer.TensorQ =
    var out: infer.TensorQ
    let res = infer.TensorFromDataFill(out, shape, scale, data)
    assert(IsOk(res), " depin transport smoke: tensor")
    return out

fn depinTransportSmokeBuildKvFixture(): DepinTransportSmokeKvFixture =
    let cacheRes = pkv.PagedKVInit(2, 4, 4, 1000, 1000)
    assert(IsOk(cacheRes), " depin transport smoke: kv init")
    var cache = Value(cacheRes)
    var seq = pkv.PagedKVSequenceInit(9)
    let appendRes = pkv.PagedKVAppendToken(
        cache,
        seq,
        depinTransportSmokeMakeTensor([4], 1000, [1000, 0, 0, 0]),
        depinTransportSmokeMakeTensor([4], 1000, [0, 1000, 0, 0])
    )
    assert(IsOk(appendRes), " depin transport smoke: kv append")
    let layerState = exec.ModelExecutorKvLayerStateBuild(0, cache, seq)
    assert(IsOk(layerState), " depin transport smoke: kv layer state")
    let stateSet = exec.ModelExecutorKvStateSetBuild([Value(layerState)])
    assert(IsOk(exec.ModelExecutorValidateKvStateSet(stateSet)), " depin transport smoke: kv state set")
    return DepinTransportSmokeKvFixture(cache: cache, seq: seq, receipt: pkv.PagedKVReceiptFor(seq), stateHash: stateSet.stateSetHash)

fn depinTransportSmokeBuildPartition(peers: str[]): pp.InferencePartitionPlan =
    let planRes = pp.ParallelBuildTensorHeadPlan("cid:partition:transport-session", 1, peers)
    assert(IsOk(planRes), " depin transport smoke: tensor plan")
    var plan = Value(planRes)
    let expertRes = pp.ParallelAttachExpertPlan(plan, 2, peers, "cid:expert:transport:")
    assert(IsOk(expertRes), " depin transport smoke: expert plan")
    assert(IsOk(pp.ParallelValidatePlan(plan)), " depin transport smoke: partition validate")
    return plan

fn depinTransportSmokeMakeWeightTensor(weight: mg.ModelWeightShard, ordinal: int32): infer.TensorQ =
    let countRes = mg.ModelGraphTensorElementCount(weight.shape)
    assert(IsOk(countRes), " depin transport smoke: weight shape")
    let elemCount = int32(Value(countRes))
    var data: int32[]
    for i in 0..<elemCount:
        add(data, 100 + ordinal * 10 + i)
    return depinTransportSmokeMakeTensor(weight.shape, 1000, data)

fn depinTransportSmokeWeightShardPath(graph: mg.ModelGraph, ordinal: int32): str =
    return strutil.Join([
        "/tmp/cheng_depin_inference_weight_",
        strings.Int64ToStr(graph.graphHash),
        "_",
        strings.IntToStr(ordinal),
        ".cwi1"
    ], "")

fn depinTransportSmokeBuildWeightFixture(graph: mg.ModelGraph): DepinTransportSmokeWeightFixture =
    var payloads: ws.WeightTensorPayload[]
    var bindings: wb.WeightShardBinding[]
    var shardPaths: str[]
    for i in 0..<graph.weights.len:
        var peerId = "peer:a"
        if i % 2 == 1:
            peerId = "peer:b"
        let tensor = depinTransportSmokeMakeWeightTensor(graph.weights[i], i)
        let payloadRes = ws.WeightTensorPayloadBuild(
            graph.weights[i].modelCid,
            graph.weights[i].tensorName,
            graph.weights[i].shardCid,
            graph.weights[i].dtype,
            graph.weights[i].quantScheme,
            peerId,
            tensor
        )
        assert(IsOk(payloadRes), " depin transport smoke: weight payload")
        let payload = Value(payloadRes)
        add(payloads, payload)
        add(bindings, wb.WeightShardBinding(
            modelCid: graph.weights[i].modelCid,
            tensorName: graph.weights[i].tensorName,
            shardCid: graph.weights[i].shardCid,
            dtype: graph.weights[i].dtype,
            quantScheme: graph.weights[i].quantScheme,
            sizeBytes: graph.weights[i].sizeBytes,
            peerId: peerId,
            payloadHash: payload.payloadHash
        ))
        let shardPath = depinTransportSmokeWeightShardPath(graph, i)
        if os.FileExists(shardPath):
            assert(os.RemoveFile(shardPath), " depin transport smoke: remove old shard")
        let writeShard = ws.WeightTensorPayloadWriteMaterializedShardFile(shardPath, payload)
        assert(IsOk(writeShard), " depin transport smoke: write weight shard")
        add(shardPaths, shardPath)
    let set = wb.WeightBindingBuildSet(graph.modelCid, bindings)
    assert(IsOk(wb.WeightBindingValidate(set, graph)), " depin transport smoke: weight binding")
    let loadStore = ws.WeightTensorStoreLoadMaterializedShardFiles(graph.modelCid, set, shardPaths)
    assert(IsOk(loadStore), " depin transport smoke: load materialized weight shards")
    let store = Value(loadStore)
    assert(IsOk(ws.WeightTensorValidateStore(store, set, graph)), " depin transport smoke: weight store")
    var payloadHashes: int64[]
    for i in 0..<store.payloads.len:
        add(payloadHashes, store.payloads[i].payloadHash)
    let boundGraphRes = mg.ModelGraphBindExpectedWeightPayloadHashes(graph, payloadHashes)
    assert(IsOk(boundGraphRes), " depin transport smoke: bind weight anchors")
    let boundGraph = Value(boundGraphRes)
    assert(IsOk(wb.WeightBindingValidate(set, boundGraph)), " depin transport smoke: anchored weight binding")
    assert(IsOk(ws.WeightTensorValidateStore(store, set, boundGraph)), " depin transport smoke: anchored weight store")
    return DepinTransportSmokeWeightFixture(graph: boundGraph, bindings: set, store: store)

fn depinTransportSmokeBuildActivationFixture(): DepinTransportSmokeActivationFixture =
    let payload0Res = at.ActivationTensorPayloadBuild(
        "peer:a",
        "peer:b",
        "hidden:tokens:0",
        0,
        1,
        0,
        4,
        depinTransportSmokeMakeTensor([1, 4], 1000, [101, 102, 103, 104])
    )
    assert(IsOk(payload0Res), " depin transport smoke: activation payload0")
    let payload0 = Value(payload0Res)
    let payload1Res = at.ActivationTensorPayloadBuild(
        "peer:a",
        "peer:b",
        "hidden:tokens:1",
        1,
        1,
        0,
        4,
        depinTransportSmokeMakeTensor([1, 4], 1000, [201, 202, 203, 204])
    )
    assert(IsOk(payload1Res), " depin transport smoke: activation payload1")
    let payload1 = Value(payload1Res)
    var shards: engine.DistributedActivationShard[]
    add(shards, engine.DistributedActivationShard(shardName: payload0.shardName, peerId: payload0.sourcePeerId, schema: engine.DistributedInferenceActivationSchema, tokenStart: payload0.tokenStart, tokenCount: payload0.tokenCount, featureStart: payload0.featureStart, featureCount: payload0.featureCount, shardHash: payload0.payloadHash))
    add(shards, engine.DistributedActivationShard(shardName: payload1.shardName, peerId: payload1.sourcePeerId, schema: engine.DistributedInferenceActivationSchema, tokenStart: payload1.tokenStart, tokenCount: payload1.tokenCount, featureStart: payload1.featureStart, featureCount: payload1.featureCount, shardHash: payload1.payloadHash))
    var payloads: at.ActivationTensorPayload[]
    add(payloads, payload0)
    add(payloads, payload1)
    return DepinTransportSmokeActivationFixture(shards: shards, payloads: payloads)

fn depinTransportSmokePeerCapability(peers: engine.DistributedInferencePeer[], peerId: str): str =
    for i in 0..<peers.len:
        if peers[i].peerId == peerId:
            return peers[i].deviceCapabilityHash
    assert(false, " depin transport smoke: peer capability")
    return ""

fn depinTransportSmokeBuildRequestSet(plan: engine.DistributedInferencePlan,
                                      peers: engine.DistributedInferencePeer[],
                                      payloads: at.ActivationTensorPayload[]): engine.DistributedShardDispatchRequestSet =
    var requests: engine.DistributedShardDispatchRequest[]
    let kernelHash: int64 = plan.kernelPrograms[0].kernelHash
    for i in 0..<payloads.len:
        let inputHash = engine.DistributedShardDispatchExpectedInputHash(
            plan,
            plan.activationShards[i],
            kernelHash
        )
        assert(IsOk(inputHash), " depin transport smoke: shard input hash")
        let draft = engine.DistributedShardDispatchRequest(
            schema: "",
            enginePlanHash: plan.engineHash,
            coordinatorPeerId: "peer:coordinator",
            peerId: payloads[i].sourcePeerId,
            targetPeerId: payloads[i].targetPeerId,
            deviceCapabilityHash: depinTransportSmokePeerCapability(peers, payloads[i].sourcePeerId),
            shardName: payloads[i].shardName,
            kernelHash: kernelHash,
            inputHash: Value(inputHash),
            expectedOutputPayloadHash: payloads[i].payloadHash,
            tokenStart: payloads[i].tokenStart,
            tokenCount: payloads[i].tokenCount,
            featureStart: payloads[i].featureStart,
            featureCount: payloads[i].featureCount,
            requestHash: int64(0)
        )
        add(requests, engine.DistributedShardDispatchRequestBuild(draft))
    return engine.DistributedShardDispatchRequestSetBuild(plan.engineHash, requests)

fn depinTransportSmokeBuildCertifiedFixtureWithSpecDecodePlan(specDecodePlan: engine.DistributedSpecDecodePlan,
                                                             planOut: var engine.DistributedInferencePlan,
                                                             peersOut: var engine.DistributedInferencePeer[],
                                                             kvCacheOut: var pkv.PagedKVCache,
                                                             kvSeqOut: var pkv.PagedKVSequence,
                                                             envelopesOut: var at.ActivationEnvelope[],
                                                             activationStoreOut: var at.ActivationTensorStore,
                                                             evidenceOut: var engine.DistributedActivationEvidence,
                                                             kvTransferEvidenceOut: var engine.DistributedKvPageTransferEvidence,
                                                             distributedManifestOut: var inference_manifest.DepinDistributedInferenceManifest): Result[bool] =
    let graph = mg.ModelGraphBuildTinyGlmMoeFixture("cid:model:transport-session")
    assert(IsOk(mg.ModelGraphValidate(graph)), " depin transport smoke: graph")
    let peersText: str[] = ["peer:a", "peer:b"]
    var peers: engine.DistributedInferencePeer[]
    add(peers, engine.DistributedInferencePeer(peerId: "peer:a", deviceCapabilityHash: "cap:metal:a", online: true, tensorShardBudget: 4, expertShardBudget: 1))
    add(peers, engine.DistributedInferencePeer(peerId: "peer:b", deviceCapabilityHash: "cap:metal:b", online: true, tensorShardBudget: 4, expertShardBudget: 1))
    let partition = depinTransportSmokeBuildPartition(peersText)
    let weightFixture = depinTransportSmokeBuildWeightFixture(graph)
    let anchoredGraph = weightFixture.graph
    let kernels = [
        kir.KernelIrGemmProgram(2, 4, 4, kir.KernelDtypeFp16, 1000),
        kir.KernelIrRmsNormProgram(4, kir.KernelDtypeFp16, 1000, 1)
    ]
    let routeRes = moe.MoeRouteTop2([10, 8, 7, 9], 2, 2, 4)
    assert(IsOk(routeRes), " depin transport smoke: route")
    let routePlanSet = moe.MoeRoutePlanSetFromSingle(0, Value(routeRes))
    let activationFixture = depinTransportSmokeBuildActivationFixture()
    let kvFixture = depinTransportSmokeBuildKvFixture()
    let plan = engine.DistributedBuildPlanWithRouteSetAndSpecDecode(
        "cid:engine:transport-session",
        anchoredGraph,
        weightFixture.bindings,
        partition,
        kernels,
        kvFixture.receipt,
        kvFixture.stateHash,
        specDecodePlan,
        Value(routeRes),
        routePlanSet,
        activationFixture.shards
    )
    assert(IsOk(engine.DistributedValidatePlan(plan, peers)), " depin transport smoke: plan")
    let unanchoredPlan = engine.DistributedBuildPlanWithRouteSetAndSpecDecode(
        "cid:engine:transport-session-unanchored",
        graph,
        weightFixture.bindings,
        partition,
        kernels,
        kvFixture.receipt,
        kvFixture.stateHash,
        specDecodePlan,
        Value(routeRes),
        routePlanSet,
        activationFixture.shards
    )
    assert(IsErr(engine.DistributedValidatePlan(unanchoredPlan, peers)),
           " depin transport smoke: unanchored weight graph hard fail")
    let envelope0 = at.ActivationTransportBuildEnvelope(
        plan.engineHash,
        activationFixture.payloads[0].sourcePeerId,
        activationFixture.payloads[0].targetPeerId,
        activationFixture.payloads[0].shardName,
        uint64(0),
        activationFixture.payloads[0].tokenStart,
        activationFixture.payloads[0].tokenCount,
        activationFixture.payloads[0].featureStart,
        activationFixture.payloads[0].featureCount,
        activationFixture.payloads[0].payloadHash,
        int64(0)
    )
    let envelope1 = at.ActivationTransportBuildEnvelope(
        plan.engineHash,
        activationFixture.payloads[1].sourcePeerId,
        activationFixture.payloads[1].targetPeerId,
        activationFixture.payloads[1].shardName,
        uint64(1),
        activationFixture.payloads[1].tokenStart,
        activationFixture.payloads[1].tokenCount,
        activationFixture.payloads[1].featureStart,
        activationFixture.payloads[1].featureCount,
        activationFixture.payloads[1].payloadHash,
        envelope0.envelopeHash
    )
    var envelopes: at.ActivationEnvelope[]
    add(envelopes, envelope0)
    add(envelopes, envelope1)
    let activationStore = at.ActivationTensorStoreBuild(plan.engineHash, activationFixture.payloads)
    let activationPayloadWire0 = at.ActivationTensorPayloadWireBytes(activationFixture.payloads[0])
    assert(IsOk(activationPayloadWire0), " depin transport smoke: activation payload wire")
    var activationPayloadWire0Bytes = Value(activationPayloadWire0)
    assert(IsOk(at.ActivationTensorPayloadValidateWire(activationFixture.payloads[0], activationPayloadWire0Bytes)),
        " depin transport smoke: activation payload wire validate")
    let decodedActivationPayload0 = at.ActivationTensorPayloadDecodeWire(envelope0, activationPayloadWire0Bytes)
    assert(IsOk(decodedActivationPayload0), " depin transport smoke: activation payload wire decode")
    assert(Value(decodedActivationPayload0).payloadHash == activationFixture.payloads[0].payloadHash,
        " depin transport smoke: activation payload wire decode hash")
    rawbytes.BytesSet(activationPayloadWire0Bytes, at.ActivationTensorPayloadWireHeaderBytes, rawbytes.BytesGet(activationPayloadWire0Bytes, at.ActivationTensorPayloadWireHeaderBytes) ^ 1)
    assert(IsErr(at.ActivationTensorPayloadValidateWire(activationFixture.payloads[0], activationPayloadWire0Bytes)),
        " depin transport smoke: activation payload wire drift hard fail")
    assert(IsErr(at.ActivationTensorPayloadDecodeWire(envelope0, activationPayloadWire0Bytes)),
        " depin transport smoke: activation payload wire decode drift hard fail")
    rawbytes.BytesFree(activationPayloadWire0Bytes)
    let requests = depinTransportSmokeBuildRequestSet(plan, peers, activationFixture.payloads)
    var receiptsRaw: engine.DistributedShardExecutionReceipt[]
    var responsesRaw: engine.DistributedShardDispatchResponse[]
    var framesRaw: engine.DistributedShardTransportFrame[]
    for i in 0..<requests.requests.len:
        let request = requests.requests[i]
        let executed = engine.DistributedPeerExecuteActivationDispatch(
            plan,
            peers,
            request,
            activationFixture.payloads[i].tensor,
            int64(3000 + i)
        )
        assert(IsOk(executed), " depin transport smoke: peer execute")
        let peerResult = Value(executed)
        add(receiptsRaw, peerResult.receipt)
        add(responsesRaw, peerResult.response)
        let requestFrame = engine.DistributedShardTransportRequestFrameBuild(
            request,
            uint64(i * 2),
            int64(9000 + i * 2)
        )
        assert(IsOk(requestFrame), " depin transport smoke: request frame")
        add(framesRaw, Value(requestFrame))
        let responseFrame = engine.DistributedShardTransportResponseFrameBuild(
            request,
            peerResult.response,
            envelopes[i],
            uint64(i * 2 + 1),
            int64(9000 + i * 2 + 1)
        )
        assert(IsOk(responseFrame), " depin transport smoke: response frame")
        add(framesRaw, Value(responseFrame))
    let receipts = engine.DistributedShardExecutionReceiptSetBuild(plan.engineHash, receiptsRaw)
    let responses = engine.DistributedShardDispatchResponseSetBuild(plan.engineHash, responsesRaw)
    let frames = engine.DistributedShardTransportFrameSetBuild(plan.engineHash, framesRaw)
    let draft = engine.DistributedActivationEvidenceBuild(plan.engineHash, requests, responses, receipts, frames)
    let evidenceRes = engine.DistributedActivationEvidenceSeal(envelopes, activationStore, draft)
    assert(IsOk(evidenceRes), " depin transport smoke: evidence seal")
    let evidence = Value(evidenceRes)
    assert(IsOk(engine.DistributedValidateActivationEvidence(plan, peers, envelopes, activationStore, evidence)),
        " depin transport smoke: evidence validate")
    let kvTransferEvidenceRes = engine.DistributedBuildKvPageTransferEvidence(
        plan,
        peers,
        kvFixture.cache,
        kvFixture.seq,
        "peer:b",
        "peer:a",
        int64(880000)
    )
    assert(IsOk(kvTransferEvidenceRes), " depin transport smoke: kv transfer evidence build")
    let kvTransferEvidence = Value(kvTransferEvidenceRes)
    assert(IsOk(engine.DistributedValidateKvPageTransferEvidence(plan, peers, kvFixture.cache, kvFixture.seq, kvTransferEvidence)),
        " depin transport smoke: kv transfer evidence validate")
    let kvResidencyReceiptRes = engine.DistributedBuildKvPageResidencyReceipt(
        plan,
        peers,
        kvTransferEvidence,
        int64(990000),
        int64(1990000)
    )
    assert(IsOk(kvResidencyReceiptRes), " depin transport smoke: kv residency receipt build")
    let kvResidencyReceipt = Value(kvResidencyReceiptRes)
    assert(IsOk(engine.DistributedValidateKvPageResidencyReceipt(plan, peers, kvTransferEvidence, kvResidencyReceipt)),
        " depin transport smoke: kv residency receipt validate")
    assert(kvResidencyReceipt.targetPeerId == "peer:b" &&
           kvResidencyReceipt.pageCount == kvTransferEvidence.payloadStore.payloads.len,
        " depin transport smoke: kv residency receipt binding")
    var kvResidencyDrift = kvResidencyReceipt
    var kvResidencyDriftEntries: engine.DistributedKvPageResidencyEntry[]
    for i in 0..<kvResidencyReceipt.entries.len:
        var entry = kvResidencyReceipt.entries[i]
        if i == 0:
            entry.payloadHash = entry.payloadHash + int64(1)
        add(kvResidencyDriftEntries, entry)
    kvResidencyDrift.entries = kvResidencyDriftEntries
    assert(IsErr(engine.DistributedValidateKvPageResidencyReceipt(plan, peers, kvTransferEvidence, kvResidencyDrift)),
        " depin transport smoke: kv residency drift hard fail")
    let distributedManifest = DepinBuildDistributedManifestFromPlanFacts(
        graph.modelCid,
        plan.partitionPlan,
        plan.kernelPrograms,
        plan.deviceWeightBindingHash,
        plan.kvReceipt,
        plan.kvStateHash,
        plan.kvShardReceipts.receiptSetHash,
        kvTransferEvidence.evidenceHash,
        plan.specDecodePlan.planHash,
        plan.routePlanSet,
        evidence.requests.requestSetHash,
        evidence.transportFrames.frameSetHash,
        evidence.evidenceHash,
        DepinInferenceNowMs()
    )
    assert(IsOk(DepinValidateDistributedManifest(distributedManifest)), " depin transport smoke: manifest")
    assert(distributedManifest.weightDeviceBindingCid == strutil.Join([
        "cid:weight_device_binding:",
        strings.Int64ToStr(plan.deviceWeightBindingHash)
    ], ""), " depin transport smoke: manifest weight device binding")
    assert(distributedManifest.kvShardReceiptCid == strutil.Join([
        "cid:kv:shard_receipt:",
        strings.Int64ToStr(plan.kvShardReceipts.receiptSetHash)
    ], ""), " depin transport smoke: manifest kv shard receipt binding")
    assert(distributedManifest.kvPageTransferEvidenceCid == strutil.Join([
        "cid:kv:page_transfer_evidence:",
        strings.Int64ToStr(kvTransferEvidence.evidenceHash)
    ], ""), " depin transport smoke: manifest kv transfer evidence binding")
    planOut = plan
    peersOut = peers
    kvCacheOut = kvFixture.cache
    kvSeqOut = kvFixture.seq
    envelopesOut = envelopes
    activationStoreOut = activationStore
    evidenceOut = evidence
    kvTransferEvidenceOut = kvTransferEvidence
    distributedManifestOut = distributedManifest
    return Ok[bool](true)

fn depinTransportSmokeBuildCertifiedFixture(planOut: var engine.DistributedInferencePlan,
                                           peersOut: var engine.DistributedInferencePeer[],
                                           kvCacheOut: var pkv.PagedKVCache,
                                           kvSeqOut: var pkv.PagedKVSequence,
                                           envelopesOut: var at.ActivationEnvelope[],
                                           activationStoreOut: var at.ActivationTensorStore,
                                           evidenceOut: var engine.DistributedActivationEvidence,
                                           kvTransferEvidenceOut: var engine.DistributedKvPageTransferEvidence,
                                           distributedManifestOut: var inference_manifest.DepinDistributedInferenceManifest): Result[bool] =
    return depinTransportSmokeBuildCertifiedFixtureWithSpecDecodePlan(
        engine.DistributedBuildDisabledSpecDecodePlan(),
        planOut,
        peersOut,
        kvCacheOut,
        kvSeqOut,
        envelopesOut,
        activationStoreOut,
        evidenceOut,
        kvTransferEvidenceOut,
        distributedManifestOut
    )

fn depinTransportSmokeBuildSession(modelCid: str): inference_manifest.DepinInferenceSession =
    return DepinBuildStartedInferenceSession(
        "req:depin:transport-session",
        modelCid,
        "prompt:transport-session",
        "base"
    )

fn depinTransportSmokeBuildSettlementPlan(): inference_settlement.DepinSettlementPlan =
    return inference_settlement.DepinSettlementPlanBuildWithReplicas(
        "batch:transport-session",
        "job:transport-session",
        "peer:coordinator",
        "escrow:transport-session",
        int64(100),
        ["peer:coordinator", "peer:b"],
        2,
        2
    )

fn depinTransportSmokeFreshResidencyPrefix(label: str, planHash: int64): str =
    let prefix = strutil.Join([
        "/tmp/cheng_depin_inference_residency_",
        label,
        "_",
        strings.Int64ToStr(planHash)
    ], "")
    let storePath = strutil.Join([prefix, ".ckvs1"], "")
    let walPath = strutil.Join([prefix, ".cwal1"], "")
    let headPath = strutil.Join([prefix, ".ckvh1"], "")
    let tempPath = strutil.Join([prefix, ".ckvh1.tmp"], "")
    let lockDir = strutil.Join([prefix, ".ckvl1.lock"], "")
    let settlementLedgerPath = inference_settlement.DepinSettlementLedgerPathFromPrefix(prefix)
    let settlementReplicaPath = inference_settlement.DepinSettlementLedgerReplicaPathFromPrefix(prefix, "peer:b")
    let settlementCoordinatorReplicaPath = inference_settlement.DepinSettlementLedgerReplicaPathFromPrefix(prefix, "peer:coordinator")
    let settlementPeerAReplicaPath = inference_settlement.DepinSettlementLedgerReplicaPathFromPrefix(prefix, "peer:a")
    let settlementNotPresentReplicaPath = inference_settlement.DepinSettlementLedgerReplicaPathFromPrefix(prefix, "peer:not-present")
    let settlementQuorumPath = transport.DepinInferenceTransportSettlementLedgerQuorumPathFromPrefix(prefix)
    let settlementRepairPath = transport.DepinInferenceTransportSettlementLedgerRepairPathFromPrefix(prefix)
    let settlementRepairDaemonPath = transport.DepinInferenceTransportSettlementRepairDaemonStatePathFromPrefix(prefix)
    let supervisorPath = transport.DepinInferenceTransportResidencySettlementSupervisorStatePathFromPrefix(prefix)
    let daemonRunPath = transport.DepinInferenceTransportResidencySettlementDaemonRunReceiptPathFromPrefix(prefix)
    let daemonWatchPath = transport.DepinInferenceTransportResidencySettlementDaemonFileEventBatchPathFromPrefix(prefix)
    let daemonOsServiceReceiptPath = transport.DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceiptPathFromPrefix(prefix)
    let daemonStartupBundlePath = transport.DepinInferenceTransportResidencySettlementDaemonStartupBundlePathFromPrefix(prefix)
    let daemonHealthPath = transport.DepinInferenceTransportResidencySettlementDaemonHealthReceiptPathFromPrefix(prefix)
    let daemonLaunchdPathRes = transport.DepinInferenceTransportResidencySettlementDaemonOsServiceSpecTextPathFromPrefix(
        prefix,
        transport.DepinInferenceTransportResidencySettlementDaemonOsServiceLaunchd
    )
    assert(IsOk(daemonLaunchdPathRes), " depin transport smoke: launchd service path")
    let daemonSystemdPathRes = transport.DepinInferenceTransportResidencySettlementDaemonOsServiceSpecTextPathFromPrefix(
        prefix,
        transport.DepinInferenceTransportResidencySettlementDaemonOsServiceSystemd
    )
    assert(IsOk(daemonSystemdPathRes), " depin transport smoke: systemd service path")
    let daemonSystemdTriggerPathRes = transport.DepinInferenceTransportResidencySettlementDaemonOsServiceTriggerSpecTextPathFromPrefix(
        prefix,
        transport.DepinInferenceTransportResidencySettlementDaemonOsServiceSystemd
    )
    assert(IsOk(daemonSystemdTriggerPathRes), " depin transport smoke: systemd trigger service path")
    let lockFile = engine.DistributedKvResidencyHeadLockFilePath(lockDir)
    if os.FileExists(storePath):
        assert(os.RemoveFile(storePath), " depin transport smoke: remove old residency store")
    if os.FileExists(walPath):
        assert(os.RemoveFile(walPath), " depin transport smoke: remove old residency wal")
    if os.FileExists(headPath):
        assert(os.RemoveFile(headPath), " depin transport smoke: remove old residency head")
    if os.FileExists(tempPath):
        assert(os.RemoveFile(tempPath), " depin transport smoke: remove old residency temp")
    if os.FileExists(settlementLedgerPath):
        assert(os.RemoveFile(settlementLedgerPath), " depin transport smoke: remove old settlement ledger")
    if os.FileExists(settlementReplicaPath):
        assert(os.RemoveFile(settlementReplicaPath), " depin transport smoke: remove old settlement replica")
    if os.FileExists(settlementCoordinatorReplicaPath):
        assert(os.RemoveFile(settlementCoordinatorReplicaPath), " depin transport smoke: remove old coordinator settlement replica")
    if os.FileExists(settlementPeerAReplicaPath):
        assert(os.RemoveFile(settlementPeerAReplicaPath), " depin transport smoke: remove old peer a settlement replica")
    if os.FileExists(settlementNotPresentReplicaPath):
        assert(os.RemoveFile(settlementNotPresentReplicaPath), " depin transport smoke: remove old not-present settlement replica")
    if os.FileExists(settlementQuorumPath):
        assert(os.RemoveFile(settlementQuorumPath), " depin transport smoke: remove old settlement quorum")
    if os.FileExists(settlementRepairPath):
        assert(os.RemoveFile(settlementRepairPath), " depin transport smoke: remove old settlement repair")
    if os.FileExists(settlementRepairDaemonPath):
        assert(os.RemoveFile(settlementRepairDaemonPath), " depin transport smoke: remove old settlement repair daemon")
    if os.FileExists(supervisorPath):
        assert(os.RemoveFile(supervisorPath), " depin transport smoke: remove old supervisor")
    if os.FileExists(daemonRunPath):
        assert(os.RemoveFile(daemonRunPath), " depin transport smoke: remove old residency settlement daemon run")
    if os.FileExists(daemonWatchPath):
        assert(os.RemoveFile(daemonWatchPath), " depin transport smoke: remove old residency settlement daemon file events")
    if os.FileExists(daemonOsServiceReceiptPath):
        assert(os.RemoveFile(daemonOsServiceReceiptPath), " depin transport smoke: remove old residency settlement os service receipt")
    if os.FileExists(daemonStartupBundlePath):
        assert(os.RemoveFile(daemonStartupBundlePath), " depin transport smoke: remove old residency settlement startup bundle")
    if os.FileExists(daemonHealthPath):
        assert(os.RemoveFile(daemonHealthPath), " depin transport smoke: remove old residency settlement health receipt")
    if os.FileExists(Value(daemonLaunchdPathRes)):
        assert(os.RemoveFile(Value(daemonLaunchdPathRes)), " depin transport smoke: remove old launchd service spec")
    if os.FileExists(Value(daemonSystemdPathRes)):
        assert(os.RemoveFile(Value(daemonSystemdPathRes)), " depin transport smoke: remove old systemd service spec")
    if os.FileExists(Value(daemonSystemdTriggerPathRes)):
        assert(os.RemoveFile(Value(daemonSystemdTriggerPathRes)), " depin transport smoke: remove old systemd trigger service spec")
    if os.FileExists(lockFile):
        assert(os.RemoveFile(lockFile), " depin transport smoke: remove old residency lock file")
    if os.DirExists(lockDir):
        os.RemoveDir(lockDir)
        assert(!os.DirExists(lockDir), " depin transport smoke: remove old residency lock dir")
    return prefix

fn depinTransportSmokeResolveCompiler(root: str): Result[str] =
    let explicit = strutil.Strip(os.GetEnv("CHENG_SMOKE_COMPILER"))
    if explicit != "":
        let explicitPath = chengpath.PathAbsolute(root, explicit)
        if chengpath.FileExistsNonEmpty(root, explicitPath):
            return Ok[str](explicitPath)
        return Err[str](strutil.Join([" depin transport smoke: CHENG_SMOKE_COMPILER missing: ", explicitPath], ""))
    let stage3 = chengpath.PathAbsolute(root, "artifacts/bootstrap/cheng.stage3")
    if chengpath.FileExistsNonEmpty(root, stage3):
        return Ok[str](stage3)
    let backendDriver = chengpath.PathAbsolute(root, "artifacts/backend_driver/cheng")
    if chengpath.FileExistsNonEmpty(root, backendDriver):
        return Ok[str](backendDriver)
    return Err[str](" depin transport smoke: missing compiler for daemon build")

fn depinTransportSmokeBuildResidencySettlementDaemon(root: str): Result[str] =
    let compilerRes = depinTransportSmokeResolveCompiler(root)
    if IsErr(compilerRes):
        return Err[str](Error(compilerRes))
    let outDir = chengpath.PathAbsolute(root, "artifacts/depin_residency_settlement_daemon_smoke")
    if !chengpath.MkdirP(root, outDir):
        return Err[str](" depin transport smoke: mkdir daemon artifact dir")
    let outBin = os.JoinPath(outDir, "depin_residency_settlement_daemon")
    let source = chengpath.PathAbsolute(root, "src/libp2p/cli/depin_residency_settlement_daemon_main.cheng")
    let reportPath = os.JoinPath(outDir, "depin_residency_settlement_daemon.report.txt")
    let logPath = os.JoinPath(outDir, "depin_residency_settlement_daemon.compile.log")
    if chengpath.PathFileExists(outBin):
        os.RemoveFile(outBin)
    let compileRun = hostops.RunFileLogged(
        root,
        "build_depin_residency_settlement_daemon",
        Value(compilerRes),
        [
            "system-link-exec",
            strutil.Join(["--root:", root], ""),
            strutil.Join(["--in:", source], ""),
            "--emit:exe",
            "--target:arm64-apple-darwin",
            strutil.Join(["--out:", outBin], ""),
            strutil.Join(["--report-out:", reportPath], "")
        ],
        [],
        root,
        300,
        logPath
    )
    if compileRun.exitCode != 0:
        return Err[str](strutil.Join([" depin transport smoke: daemon compile failed: ", compileRun.output], ""))
    if !chengpath.FileExistsNonEmpty(root, outBin):
        return Err[str](" depin transport smoke: daemon binary missing after compile")
    return Ok[str](outBin)

fn depinTransportSmokeOpenCertifiedLinks(links: var transport.DepinInferenceTransportPeerLink[],
                                         peerAPair: var quic_transport.Libp2pQuicLoopbackPair,
                                         peerBPair: var quic_transport.Libp2pQuicLoopbackPair,
                                         coordinatorPair: var quic_transport.Libp2pQuicLoopbackPair): Result[bool] =
    let peerAOpen = depinInferenceTransportSmokeOpen(peerAPair)
    if IsErr(peerAOpen):
        return Err[bool](Error(peerAOpen))
    depinInferenceTransportSmokeDerivePair(peerBPair, peerAPair, int64(4))
    depinInferenceTransportSmokeDerivePair(coordinatorPair, peerAPair, int64(8))
    links = [
        transport.DepinInferenceTransportPeerLink(peerId: "peer:a", outbound: peerAPair.outbound, inbound: peerAPair.inbound),
        transport.DepinInferenceTransportPeerLink(peerId: "peer:b", outbound: peerBPair.outbound, inbound: peerBPair.inbound),
        transport.DepinInferenceTransportPeerLink(peerId: "peer:coordinator", outbound: coordinatorPair.outbound, inbound: coordinatorPair.inbound)
    ]
    return Ok[bool](true)

fn RunDepinInferenceTransportSmoke(): int32 =
    qtransport.ResetNativeRuntime()
    var pair: quic_transport.Libp2pQuicLoopbackPair
    let pairOk = depinInferenceTransportSmokeOpen(pair)
    if IsErr(pairOk):
        echo(ErrorText(pairOk))
        return 1
    echo("depin transport smoke: pair open")

    let requestFrame = depinInferenceTransportSmokeFrame(int64(pipe.DepinInferenceWireFrameKindRequest))
    let writeRequest = transport.DepinInferenceTransportWriteWireFrame(pair.outbound, requestFrame)
    if IsErr(writeRequest):
        echo(ErrorText(writeRequest))
        return 2
    echo("depin transport smoke: request written")
    let readRequest = transport.DepinInferenceTransportReadWireFrame(pair.inbound)
    if IsErr(readRequest):
        echo(ErrorText(readRequest))
        return 3
    if Value(readRequest).requestHash != requestFrame.requestHash ||
       Value(readRequest).responseHash != int64(0):
        return 4

    let responseFrame = depinInferenceTransportSmokeFrame(int64(pipe.DepinInferenceWireFrameKindResponse))
    let writeResponse = transport.DepinInferenceTransportWriteWireFrame(pair.outbound, responseFrame)
    if IsErr(writeResponse):
        echo(ErrorText(writeResponse))
        return 5
    echo("depin transport smoke: response written")
    let readResponse = transport.DepinInferenceTransportReadWireFrame(pair.inbound)
    if IsErr(readResponse):
        echo(ErrorText(readResponse))
        return 6
    if Value(readResponse).receiptHash != responseFrame.receiptHash ||
       Value(readResponse).envelopeHash != responseFrame.envelopeHash:
        return 7
    quic_transport.Libp2pQuicLoopbackClose(pair)

    var badPair: quic_transport.Libp2pQuicLoopbackPair
    let badPairOk = depinInferenceTransportSmokeOpen(badPair)
    if IsErr(badPairOk):
        echo(ErrorText(badPairOk))
        return 8
    var badFrame: Bytes = BytesAlloc(pipe.DepinInferenceWireFrameBytes)
    BytesSet(badFrame, 0, 7)
    let rawWrite = qconn.connWrite(badPair.outbound, badFrame)
    if IsErr(rawWrite):
        return 9
    let badRead = transport.DepinInferenceTransportReadWireFrame(badPair.inbound)
    if IsOk(badRead):
        return 10
    rawbytes.BytesFree(badFrame)
    quic_transport.Libp2pQuicLoopbackClose(badPair)

    let distributedFrame = depinInferenceTransportSmokeDistributedFrame(engine.DistributedTransportFrameKindRequest, uint64(0))
    let distributedWire = transport.DepinInferenceTransportWireFrameFromDistributedFrame(distributedFrame)
    if IsErr(distributedWire):
        echo(ErrorText(distributedWire))
        return 11
    if Value(distributedWire).frameHash != distributedFrame.frameHash:
        return 12

    var distributedPair: quic_transport.Libp2pQuicLoopbackPair
    let distributedOpen = depinInferenceTransportSmokeOpen(distributedPair)
    if IsErr(distributedOpen):
        echo(ErrorText(distributedOpen))
        return 13
    let distributedWrite = transport.DepinInferenceTransportWriteDistributedFrame(distributedPair.outbound, distributedFrame)
    if IsErr(distributedWrite):
        echo(ErrorText(distributedWrite))
        return 14
    let distributedRead = transport.DepinInferenceTransportReadExpectedDistributedFrame(distributedPair.inbound, distributedFrame)
    if IsErr(distributedRead):
        echo(ErrorText(distributedRead))
        return 15
    if Value(distributedRead).frameHash != distributedFrame.frameHash:
        return 16
    quic_transport.Libp2pQuicLoopbackClose(distributedPair)

    var driftPair: quic_transport.Libp2pQuicLoopbackPair
    let driftOpen = depinInferenceTransportSmokeOpen(driftPair)
    if IsErr(driftOpen):
        echo(ErrorText(driftOpen))
        return 17
    let driftWrite = transport.DepinInferenceTransportWriteDistributedFrame(driftPair.outbound, distributedFrame)
    if IsErr(driftWrite):
        echo(ErrorText(driftWrite))
        return 18
    var driftExpected = distributedFrame
    driftExpected.payloadHash = driftExpected.payloadHash + int64(1)
    driftExpected = engine.DistributedShardTransportFrameBuild(driftExpected)
    if driftExpected.payloadHash == distributedFrame.payloadHash ||
       driftExpected.frameHash == distributedFrame.frameHash:
        return 281
    let driftWireBytes = engine.DistributedShardTransportFrameWireBytes(distributedFrame)
    if IsErr(driftWireBytes):
        echo(ErrorText(driftWireBytes))
        return 282
    var driftWireBytesValue = Value(driftWireBytes)
    let driftWireValidate = engine.DistributedValidateShardTransportFrameWire(driftExpected, driftWireBytesValue)
    rawbytes.BytesFree(driftWireBytesValue)
    if IsOk(driftWireValidate):
        return 283
    let driftRead = transport.DepinInferenceTransportReadExpectedDistributedFrame(driftPair.inbound, driftExpected)
    if IsOk(driftRead):
        return 19
    quic_transport.Libp2pQuicLoopbackClose(driftPair)

    let requestDistributedFrame = depinInferenceTransportSmokeDistributedFrame(engine.DistributedTransportFrameKindRequest, uint64(0))
    let responseDistributedFrame = depinInferenceTransportSmokeDistributedFrame(engine.DistributedTransportFrameKindResponse, uint64(1))
    let frameSet = engine.DistributedShardTransportFrameSetBuild(
        int64(101),
        [requestDistributedFrame, responseDistributedFrame]
    )
    let frameSetOk = transport.DepinInferenceTransportValidateDistributedFrameSet(frameSet)
    if IsErr(frameSetOk):
        echo(ErrorText(frameSetOk))
        return 20
    var setPair: quic_transport.Libp2pQuicLoopbackPair
    let setOpen = depinInferenceTransportSmokeOpen(setPair)
    if IsErr(setOpen):
        echo(ErrorText(setOpen))
        return 21
    let setWrite = transport.DepinInferenceTransportWriteDistributedFrameSet(setPair.outbound, frameSet)
    if IsErr(setWrite):
        echo(ErrorText(setWrite))
        return 22
    if Value(setWrite) != pipe.DepinInferenceWireFrameBytes * 2:
        return 23
    let setRead = transport.DepinInferenceTransportReadExpectedDistributedFrameSet(setPair.inbound, frameSet)
    if IsErr(setRead):
        echo(ErrorText(setRead))
        return 24
    if Value(setRead) != pipe.DepinInferenceWireFrameBytes * 2:
        return 25
    quic_transport.Libp2pQuicLoopbackClose(setPair)

    let wrongOrderFrameSet = engine.DistributedShardTransportFrameSetBuild(
        int64(101),
        [responseDistributedFrame, requestDistributedFrame]
    )
    let wrongOrderValidate = transport.DepinInferenceTransportValidateDistributedFrameSet(wrongOrderFrameSet)
    if IsOk(wrongOrderValidate):
        return 26
    var orderPair: quic_transport.Libp2pQuicLoopbackPair
    let orderOpen = depinInferenceTransportSmokeOpen(orderPair)
    if IsErr(orderOpen):
        echo(ErrorText(orderOpen))
        return 27
    let orderWrite0 = transport.DepinInferenceTransportWriteDistributedFrame(orderPair.outbound, responseDistributedFrame)
    if IsErr(orderWrite0):
        echo(ErrorText(orderWrite0))
        return 28
    let orderWrite1 = transport.DepinInferenceTransportWriteDistributedFrame(orderPair.outbound, requestDistributedFrame)
    if IsErr(orderWrite1):
        echo(ErrorText(orderWrite1))
        return 29
    let orderRead = transport.DepinInferenceTransportReadExpectedDistributedFrameSet(orderPair.inbound, frameSet)
    if IsOk(orderRead):
        return 30
    quic_transport.Libp2pQuicLoopbackClose(orderPair)

    var driftSetFrame0 = requestDistributedFrame
    driftSetFrame0.payloadHash = driftSetFrame0.payloadHash + int64(1)
    driftSetFrame0 = engine.DistributedShardTransportFrameBuild(driftSetFrame0)
    let driftFrameSet = engine.DistributedShardTransportFrameSetBuild(
        int64(101),
        [driftSetFrame0, responseDistributedFrame]
    )
    var driftSetPair: quic_transport.Libp2pQuicLoopbackPair
    let driftSetOpen = depinInferenceTransportSmokeOpen(driftSetPair)
    if IsErr(driftSetOpen):
        echo(ErrorText(driftSetOpen))
        return 31
    let driftSetWrite = transport.DepinInferenceTransportWriteDistributedFrameSet(driftSetPair.outbound, frameSet)
    if IsErr(driftSetWrite):
        echo(ErrorText(driftSetWrite))
        return 32
    let driftSetRead = transport.DepinInferenceTransportReadExpectedDistributedFrameSet(driftSetPair.inbound, driftFrameSet)
    if IsOk(driftSetRead):
        return 33
    quic_transport.Libp2pQuicLoopbackClose(driftSetPair)

    var peerPair: quic_transport.Libp2pQuicLoopbackPair
    let peerOpen = depinInferenceTransportSmokeOpen(peerPair)
    if IsErr(peerOpen):
        echo(ErrorText(peerOpen))
        return 34
    var coordinatorPair: quic_transport.Libp2pQuicLoopbackPair
    depinInferenceTransportSmokeDerivePair(coordinatorPair, peerPair, int64(4))
    var links: transport.DepinInferenceTransportPeerLink[] = [
        transport.DepinInferenceTransportPeerLink(peerId: "peer:a", outbound: peerPair.outbound, inbound: peerPair.inbound),
        transport.DepinInferenceTransportPeerLink(peerId: "peer:coordinator", outbound: coordinatorPair.outbound, inbound: coordinatorPair.inbound)
    ]
    let dispatchWrite = transport.DepinInferenceTransportDispatchFrameSetByTarget(links, frameSet)
    if IsErr(dispatchWrite):
        echo(ErrorText(dispatchWrite))
        return 36
    if Value(dispatchWrite) != pipe.DepinInferenceWireFrameBytes * 2:
        return 37
    let peerRead = transport.DepinInferenceTransportReadPeerExpectedFrames(links, "peer:a", [requestDistributedFrame])
    if IsErr(peerRead):
        echo(ErrorText(peerRead))
        return 38
    let coordinatorRead = transport.DepinInferenceTransportReadPeerExpectedFrames(links, "peer:coordinator", [responseDistributedFrame])
    if IsErr(coordinatorRead):
        echo(ErrorText(coordinatorRead))
        return 39
    if Value(peerRead) != pipe.DepinInferenceWireFrameBytes ||
       Value(coordinatorRead) != pipe.DepinInferenceWireFrameBytes:
        return 40

    var missingLinks: transport.DepinInferenceTransportPeerLink[] = [
        transport.DepinInferenceTransportPeerLink(peerId: "peer:a", outbound: peerPair.outbound, inbound: peerPair.inbound)
    ]
    let missingDispatch = transport.DepinInferenceTransportDispatchFrameSetByTarget(missingLinks, frameSet)
    if IsOk(missingDispatch):
        return 41

    let wrongPeerRead = transport.DepinInferenceTransportReadPeerExpectedFrames(links, "peer:a", [responseDistributedFrame])
    if IsOk(wrongPeerRead):
        return 42

    var duplicateLinks: transport.DepinInferenceTransportPeerLink[] = [
        transport.DepinInferenceTransportPeerLink(peerId: "peer:a", outbound: peerPair.outbound, inbound: peerPair.inbound),
        transport.DepinInferenceTransportPeerLink(peerId: "peer:a", outbound: coordinatorPair.outbound, inbound: coordinatorPair.inbound)
    ]
    let duplicateValidate = transport.DepinInferenceTransportValidatePeerLinks(duplicateLinks)
    if IsOk(duplicateValidate):
        return 43
    quic_transport.Libp2pQuicLoopbackClose(peerPair)

    var certifiedPlan: engine.DistributedInferencePlan
    var certifiedPeers: engine.DistributedInferencePeer[]
    var certifiedKvCache: pkv.PagedKVCache
    var certifiedKvSeq: pkv.PagedKVSequence
    var certifiedEnvelopes: at.ActivationEnvelope[]
    var certifiedActivationStore: at.ActivationTensorStore
    var certifiedEvidence: engine.DistributedActivationEvidence
    var certifiedKvTransferEvidence: engine.DistributedKvPageTransferEvidence
    var certifiedManifest: inference_manifest.DepinDistributedInferenceManifest
    let certifiedFixtureOk = depinTransportSmokeBuildCertifiedFixture(
        certifiedPlan,
        certifiedPeers,
        certifiedKvCache,
        certifiedKvSeq,
        certifiedEnvelopes,
        certifiedActivationStore,
        certifiedEvidence,
        certifiedKvTransferEvidence,
        certifiedManifest
    )
    if IsErr(certifiedFixtureOk):
        echo(ErrorText(certifiedFixtureOk))
        return 44

    let kvWireFrame0 = transport.DepinInferenceTransportWireFrameFromKvPageTransferFrame(certifiedKvTransferEvidence.frames.frames[0])
    if IsErr(kvWireFrame0):
        echo(ErrorText(kvWireFrame0))
        return 141
    if Value(kvWireFrame0).shardNameHash != engine.DistributedKvPageTransferFramePageHash(certifiedKvTransferEvidence.frames.frames[0]):
        return 142
    var kvFramePair: quic_transport.Libp2pQuicLoopbackPair
    let kvFrameOpen = depinInferenceTransportSmokeOpen(kvFramePair)
    if IsErr(kvFrameOpen):
        echo(ErrorText(kvFrameOpen))
        return 143
    let kvFrameWrite = transport.DepinInferenceTransportWriteKvPageTransferFrame(kvFramePair.outbound, certifiedKvTransferEvidence.frames.frames[0])
    if IsErr(kvFrameWrite):
        echo(ErrorText(kvFrameWrite))
        return 144
    let kvFrameRead = transport.DepinInferenceTransportReadExpectedKvPageTransferFrame(kvFramePair.inbound, certifiedKvTransferEvidence.frames.frames[0])
    if IsErr(kvFrameRead):
        echo(ErrorText(kvFrameRead))
        return 145
    if Value(kvFrameRead).frameHash != certifiedKvTransferEvidence.frames.frames[0].frameHash:
        return 146
    quic_transport.Libp2pQuicLoopbackClose(kvFramePair)
    var kvFrameDriftPair: quic_transport.Libp2pQuicLoopbackPair
    let kvFrameDriftOpen = depinInferenceTransportSmokeOpen(kvFrameDriftPair)
    if IsErr(kvFrameDriftOpen):
        echo(ErrorText(kvFrameDriftOpen))
        return 147
    let kvFrameDriftWrite = transport.DepinInferenceTransportWriteKvPageTransferFrame(kvFrameDriftPair.outbound, certifiedKvTransferEvidence.frames.frames[0])
    if IsErr(kvFrameDriftWrite):
        echo(ErrorText(kvFrameDriftWrite))
        return 148
    var kvFrameDriftExpected = certifiedKvTransferEvidence.frames.frames[0]
    kvFrameDriftExpected.pageId = kvFrameDriftExpected.pageId + 1
    kvFrameDriftExpected = engine.DistributedKvPageTransferFrameBuild(kvFrameDriftExpected)
    let kvFrameDriftRead = transport.DepinInferenceTransportReadExpectedKvPageTransferFrame(kvFrameDriftPair.inbound, kvFrameDriftExpected)
    if IsOk(kvFrameDriftRead):
        return 140
    quic_transport.Libp2pQuicLoopbackClose(kvFrameDriftPair)

    var session: inference_manifest.DepinInferenceSession
    session = depinTransportSmokeBuildSession(certifiedPlan.modelGraph.modelCid)
    var certifiedLinks: transport.DepinInferenceTransportPeerLink[]
    var certifiedPeerAPair: quic_transport.Libp2pQuicLoopbackPair
    var certifiedPeerBPair: quic_transport.Libp2pQuicLoopbackPair
    var certifiedCoordinatorPair: quic_transport.Libp2pQuicLoopbackPair
    let certifiedLinksOpen = depinTransportSmokeOpenCertifiedLinks(
        certifiedLinks,
        certifiedPeerAPair,
        certifiedPeerBPair,
        certifiedCoordinatorPair
    )
    if IsErr(certifiedLinksOpen):
        echo(ErrorText(certifiedLinksOpen))
        return 45
    var adapter = initDepinRwadDispatcherAdapter(
        "rwad-local",
        "did:coordinator:transport",
        "keyref:coordinator:transport",
        uint64(1)
    )
    let certifiedKvResidencyStoreRes = engine.DistributedBuildEmptyKvResidencyStore(
        certifiedPlan,
        certifiedPeers,
        "peer:b",
        certifiedPlan.kvReceipt.pageCount,
        int64(900000)
    )
    if IsErr(certifiedKvResidencyStoreRes):
        echo(ErrorText(certifiedKvResidencyStoreRes))
        return 140
    let certifiedKvResidencyStore = Value(certifiedKvResidencyStoreRes)
    let certifiedResidencyPrefix = depinTransportSmokeFreshResidencyPrefix("certified", certifiedPlan.engineHash)
    let certifiedReceipt = transport.DepinInferenceTransportRunCertifiedDispatchSession(
        session,
        certifiedLinks,
        certifiedManifest,
        certifiedPlan,
        certifiedPeers,
        certifiedKvCache,
        certifiedKvSeq,
        certifiedEnvelopes,
        certifiedActivationStore,
        certifiedEvidence,
        certifiedKvTransferEvidence,
        certifiedKvResidencyStore,
        certifiedResidencyPrefix,
        adapter,
        depinTransportSmokeBuildSettlementPlan()
    )
    if IsErr(certifiedReceipt):
        echo(ErrorText(certifiedReceipt))
        return 46
    if !session.finished || session.failed:
        return 47
