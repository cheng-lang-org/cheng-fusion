        Value(a2NetworkReplication),
        Value(a2QuorumRead).ledgerByteHash,
        Value(a2QuorumRead).requiredReplicaCount
    )
    if IsErr(a2NetworkOk):
        echo(ErrorText(a2NetworkOk))
        return 435
    var a2NetworkDrift = Value(a2NetworkReplication)
    a2NetworkDrift.replicaLedgerByteHashSetHash = a2NetworkDrift.replicaLedgerByteHashSetHash + int64(1)
    if IsOk(transport.DepinInferenceTransportValidateResidencyStoreNetworkReplicationReceiptSelf(a2NetworkDrift)):
        return 436
    let a2NetworkQuorumCheck = transport.DepinInferenceTransportValidateResidencyStoreNetworkReplicationReceipt(
        Value(a2NetworkReplication),
        Value(a2QuorumRead).ledgerByteHash,
        Value(a2QuorumRead).requiredReplicaCount + 1
    )
    if IsOk(a2NetworkQuorumCheck):
        return 437

    quic_transport.Libp2pQuicLoopbackClose(certifiedPeerAPair)

    echo(" depin_inference_transport_smoke ok")
    return 0

fn main(): int32 =
    return RunDepinInferenceTransportSmoke()
