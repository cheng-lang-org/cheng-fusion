# Quick probe of time.cheng contract on the cold parser (int64 div/mod).
import cheng/game/time

fn main(): int32 =
    var t: time.CinemaTime
    time.CinemaTimeReset(t)
    if !time.CinemaTimeValid(t):
        echo("FAIL initial valid")
        return 1
    if time.CinemaTimeFrameOf(t.tick) != 0:
        echo("FAIL frame0")
        return 1
    var i: int32
    while i < 250:
        if !time.CinemaTimeAdvance(t):
            echo("FAIL advance early")
            return 1
        i = i + 1
    if time.CinemaTimeFrameOf(t.tick) != 25:
        echo("FAIL frame25")
        return 1
    if time.CinemaTimeSampleOf(t.tick) != int64(50000):
        echo("FAIL sample")
        return 1
    # run to the end: advance must refuse past the closed interval
    var keptGoing: bool = time.CinemaTimeAdvance(t)
    while keptGoing:
        keptGoing = time.CinemaTimeAdvance(t)
    if t.tick != int64(2399):
        echo("FAIL end tick")
        return 1
    echo("PASS time probe")
    return 0
