# #133 regression lock: two narrow-width residuals left after #44's named-object
# scalar-field narrowing (int8/uint8/int16/uint16 -> 1/2 bytes):
#   (1) a `bool` field must occupy 1 byte (natural C alignment), not the generic
#       4-byte register-slot width -- cold_scalar_payload_size_from_type did not
#       list "bool" so it fell through to the SLOT_I32->4 fallback.
#   (2) a fixed-array element of int16/uint16 must be 2 bytes/element, not 4 --
#       cold_fixed_array_element_size narrowed only uint8/int8/char to 1 byte and
#       let int16/uint16 fall to the generic SLOT_I32->4 slot width, inflating the
#       whole array's byte footprint and shifting every following field.
# Both are the same "scalar/element payload narrowing table is incomplete" root
# family as #44; fixed at the byte-precise sizers (cold_scalar_payload_size_from_type
# and cold_fixed_array_element_size), mirroring #44's fix style.
type
    NarrowBoolMix =
        lead: uint8
        flag: bool
        b2: bool
        tail: int64
    NarrowArrMix =
        lead: uint8
        vals: uint16[3]
        svals: int16[3]
        tail: int64

fn main(): int32 =
    var b: NarrowBoolMix
    let bb = int64(ptr(&b))
    # lead@0 (1B), flag bool@1 (1B), b2@2 (1B), tail int64 8-aligned @8.
    if int64(ptr(&b.flag)) - bb != 1:
        return 1
    if int64(ptr(&b.b2)) - bb != 2:
        return 2
    if int64(ptr(&b.tail)) - bb != 8:
        return 3

    var a: NarrowArrMix
    let ab = int64(ptr(&a))
    # lead@0, vals uint16[3] = align(3*2,8)=8 bytes, 8-aligned @8,
    # svals int16[3] = 8 bytes @16, tail int64 @24.
    if int64(ptr(&a.vals)) - ab != 8:
        return 4
    if int64(ptr(&a.svals)) - ab != 16:
        return 5
    if int64(ptr(&a.tail)) - ab != 24:
        return 6
    return 0
