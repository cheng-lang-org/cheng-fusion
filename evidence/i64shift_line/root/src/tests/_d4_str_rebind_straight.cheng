import std/system as system

# D4 str-rebind refined: rounds=50 keeps the bucket below the 63 cap so the
# exit reads the exact block count. Worker isolates the rebind shape; the
# caller loop adds no rebind of its own.

var probeSink: int32

fn StrRebindOnce(seed: int32): int32 =
    var s: str = Fmt"seed{Int32(seed)}"
    s = Fmt"{Int32(seed)}-{s}"
    s = Fmt"{Int32(seed)}+{s}"
    return s.len

fn RepeatStr(rounds: int32): int32 =
    var acc: int32
    var r: int32
    while r < rounds:
        acc = acc + StrRebindOnce(r)
        r = r + 1
    return acc

fn main(): int32 =
    let before = system.MemLiveAllocations()
    let observed = RepeatStr(50)
    let delta = system.MemLiveAllocations() - before
    probeSink = observed
    if observed <= 0:
        return 99
    if delta <= 0:
        return 0
    if delta > 199:
        return 199
    return int32(delta)
