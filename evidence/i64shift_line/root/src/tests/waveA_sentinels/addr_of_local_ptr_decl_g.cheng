# Wave-A T4 哨兵 — addr_of_local_ptr_decl 形态 g
#
# 根因族: uninit-slot / decl-init 位 `&局部` 取址
#   PrimaryBodyIrPtrExpressionSlot 缺 &name 臂 → 丢 & 求值;
#   decl-init 消费点 slotType 门失败 → 不发拷贝不 poison → 读栈垃圾
# 形态 g (packet): let p: ptr = &x  (裸 & 无强转)
#   姊妹 d: let p: ptr = ptr(&x)  — 见 addr_of_local_ptr_decl_d.cheng
# 分界: call-arg 位 (&x 直传) 正确; 推断 let / 独立赋值诚实 bail;
#   仅 ptr 型 decl-init 位曾静默 miscompile
#
# 期望 (修后 / 正确物化): run rc=0, *p 读回 7
# 实测 2026-07-09 HEAD 官方 driver (sha256 见 README):
#   providers + obj 路径均 run rc=0  — 当前绿 (LEA 物化已进 official)
# 历史红: scratchpad/gen2fix + /tmp/addrloc/g_let_ptr_bare
#   (drv_fix 反汇编 p 槽从不写; 案卷 addrlocal_arg_packet.md)
# 关联: op-lane-queue #1 Step-1 poison addr_of_local_ptr_decl / Step-2 LEA
# 用途: T1.6 回归门 — 修回退后必须再红

type I32P = int32 *

fn readI32(p: ptr): int32 =
    let ip: I32P = I32P(p)
    return *ip

fn main(): int32 =
    var x: int32 = 7
    let p: ptr = &x
    let got = readI32(p)
    if got != 7:
        return 1
    return 0
