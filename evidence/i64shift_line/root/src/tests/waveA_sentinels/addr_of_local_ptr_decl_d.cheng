# Wave-A T4 哨兵 — addr_of_local_ptr_decl 形态 d
#
# 根因族: 同 g (addr_of_local_ptr_decl); 形态 d = ptr(&x) 强转包装
#   packet 表: let p: ptr = ptr(&x); readI64(p) — 静默 miscompile 代表
# 期望: run rc=0, 经 p 读回 7
# 实测 2026-07-09 HEAD 官方 driver: providers/obj 均 rc=0 (当前绿)
# 历史红: /tmp/addrloc/d_let_ptr_cast + gen2fix drv
# 关联: op-lane-queue #1; scratchpad/gen2fix/addrlocal_arg_packet.md

type I32P = int32 *

fn readI32(p: ptr): int32 =
    let ip: I32P = I32P(p)
    return *ip

fn main(): int32 =
    var x: int32 = 7
    let p: ptr = ptr(&x)
    let got = readI32(p)
    if got != 7:
        return 1
    return 0
