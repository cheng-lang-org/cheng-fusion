# Wave-A T4 哨兵 — 裸宽 deref 表达式位 (inline let, 非 return)
#
# 根因族: 裸 `*name` 宽度截断
#   return-form 已修 (见 exec_diff_corpus/bare_deref_wide_return.cheng, 当前绿)
#   本哨兵 = 残余: `let b = *slot` 仍走 I32 臂 ldr w 截断 64 位高半
# 来源: scratchpad/gen2fix/pending_sentinels/inline_deref_wide_residual.cheng.pending
#   转正入库 (2026-07-09 T4) — 已可独立复现, 非 blocked
#
# 期望 (修后): run rc=0
# 当前 HEAD 官方 driver (providers 与 obj 同):
#   run rc=81  — 红 (inline 截成低 32 位 = 42 = 0x1_0000_002A 低半)
# stage3: run rc=0
# 区分码: 71=return-form 截断 / 81=inline-form 截断 / 72|82=其它值错
# 关联: op-lane-queue #1 F 线 i64 裸 deref; T1.7

type I64P = int64 *

@importc("malloc")
fn c_malloc(n: uint64): ptr

fn readRet(p: I64P): int64 =
    return *p

fn main(): int32 =
    let raw = c_malloc(uint64(8))
    let slot: I64P = I64P(raw)
    *slot = 4294967338
    let a = readRet(slot)
    if a == 42:
        return 71
    if a != 4294967338:
        return 72
    let b = *slot
    if b == 42:
        return 81
    if b != 4294967338:
        return 82
    return 0
