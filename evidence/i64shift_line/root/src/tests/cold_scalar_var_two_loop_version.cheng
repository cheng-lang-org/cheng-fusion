fn AdvanceNarrowAfterLoop(cursor: var int32) =
    cursor = cursor + 1

fn AdvanceAcrossTwoLoops(limit: int32, cursor: var int32): int32 =
    while cursor < limit:
        cursor = cursor + 1
    while cursor < limit + 2:
        cursor = cursor + 1
    AdvanceNarrowAfterLoop(cursor)
    return cursor

fn main(): int32 =
    var narrow: int32 = 0
    if AdvanceAcrossTwoLoops(3, narrow) != 6 or narrow != 6:
        return 1
    return 0
