import std/strings
import std/os
import std/rawbytes
import std/result
import cheng/game/assets/import/mp4
import cheng/game/assets/semantic_video/schema
import cheng/game/assets/semantic_video/reader
import cheng/game/assets/semantic_video/validator
import cheng/game/assets/semantic_video/convert
import cheng/game/assets/semantic_video/source_index

# B2 转换 smoke: 内存内对 sample.mp4 跑 SvConvert (写 .scratch/b2/
# smoke.svblock) → validator ok → reader 回读断言 (manifest caps/resType、
# 实体数=实际媒体轨数、观测数=关键帧数+音频、timeEnd=totalTicks) +
# 索引资源编解码确定性 + 第 k 个样本抽检 (界内且首 4 字节非全零)。

fn main(): int32 =
    let fileResult = os.ReadFileBytesResult(
        "src/tests/network_milestone_assets/sample.mp4")
    if result.IsErr(fileResult):
        echo(" sv_b2 smoke FAIL: read sample")
        return 1
    var data = result.Value(fileResult)

    # 索引构建确定性 + 资源编解码对称。
    var idxA = source_index.SvSourceIndexBuild(data)
    assert(idxA.ok, schema.SvCat(" build: ", idxA.error))
    var idxB = source_index.SvSourceIndexBuild(data)
    assert(idxB.ok, " second build")
    var bytesA = source_index.SvSourceIndexEncodeResource(idxA)
    var bytesB = source_index.SvSourceIndexEncodeResource(idxB)
    assert(rawbytes.BytesEqual(bytesA, bytesB), " index encode deterministic")
    var dec = source_index.SvSourceIndexDecodeResource(bytesA)
    assert(dec.ok, schema.SvCat(" decode: ", dec.error))
    assert(dec.timescale == idxA.timescale, " dec timescale")
    assert(dec.sampleCount == idxA.sampleCount, " dec sampleCount")
    assert(dec.keyframeCount == idxA.keyframeCount, " dec keyframeCount")
    var bytesC = source_index.SvSourceIndexEncodeResource(dec)
    assert(rawbytes.BytesEqual(bytesA, bytesC), " decode reencode identical")

    # 容器真值: 独立走 mp4.cheng 解析 (与 Build 同源但字段独立取)。
    var info: mp4.AssetMp4Info
    var mp4Err: str
    assert(mp4.AssetMediaParseMp4(data, info, mp4Err), " mp4 parse")
    var videoAt: int32 = -1
    var audioAt: int32 = -1
    var mediaTracks: int32 = 0
    for i in 0..<info.trackCount:
        if info.tracks[i].handler == mp4.AssetMediaHandlerVide():
            videoAt = i
            mediaTracks = mediaTracks + 1
        elif info.tracks[i].handler == mp4.AssetMediaHandlerSoun():
            audioAt = i
            mediaTracks = mediaTracks + 1
    assert(videoAt >= 0, " video track present")
    let totalTicks = info.tracks[videoAt].sttsTotalDuration

    var cv = convert.SvConvert(data, ".scratch/b2/smoke.svblock")
    assert(cv.ok, schema.SvCat(" convert: ", cv.error))

    let blockResult = os.ReadFileBytesResult(".scratch/b2/smoke.svblock")
    if result.IsErr(blockResult):
        echo(" smoke FAIL: read back committed block")
        return 1
    var blockBytes = result.Value(blockResult)
    assert(rawbytes.BytesLen(blockBytes) == cv.svblockBytes, " committed size")
    var validation = validator.SvValidate(blockBytes)
    assert(validation.ok, schema.SvCat(" validate: ", validation.error))
    var decoded = reader.SvReaderDecode(blockBytes)
    assert(decoded.ok, schema.SvCat(" decode: ", decoded.error))
    var parsed = reader.SvParseRecords(decoded.lines)
    assert(parsed.ok, schema.SvCat(" parse: ", parsed.error))
    let records = parsed.records

    assert(records.manifests.len == 1, " one manifest")
    let m = records.manifests[0]
    assert(m.caps.len == 1 && m.caps[0] == "common_core",
        " caps common_core only")
    assert(m.resType.len == 2 && m.resType[0] == "video_sample" &&
        m.resType[1] == "index", " resType video_sample+index")
    assert(m.resCid.len == 2 && m.resCid[0] == cv.sourceCid &&
        m.resCid[1] == cv.indexCid, " resCid bound to convert output")
    assert(m.tbNum == 1 && m.tbDen == idxA.timescale, " manifest timebase")
    assert(m.timeStart == 0 && m.timeEnd == totalTicks, " time range")

    assert(records.entities.len == mediaTracks, " entity count = media tracks")
    assert(records.observations.len ==
        idxA.keyframeCount + (audioAt >= 0 ? 1 : 0), " observation count")
    assert(records.observations[0].obsId == "obs-v0", " first obs id")
    assert(records.observations[0].tickStart == 0, " first obs starts 0")
    assert(records.observations[0].sourceClass == "observed", " source class")
    assert(records.observations[idxA.keyframeCount - 1].tickEnd == totalTicks,
        " last gop ends at totalTicks")
    if audioAt >= 0:
        assert(records.observations[idxA.keyframeCount].obsId == "obs-a0",
            " audio obs id")
    assert(records.assertions.len == 0, " no assertions (recognition absent)")

    # 样本抽检: 第 k 个样本 offset+size 界内且首 4 字节非全零。
    var k = idxA.sampleCount / 2
    let off = idxA.offset[k]
    let sz = idxA.size[k]
    assert(off >= int64(0) && sz > 0 &&
        off + int64(sz) <= int64(rawbytes.BytesLen(data)), " sample bounds")
    let w = rawbytes.BytesGet(data, int32(off)) |
        (rawbytes.BytesGet(data, int32(off) + 1) << 8) |
        (rawbytes.BytesGet(data, int32(off) + 2) << 16) |
        (rawbytes.BytesGet(data, int32(off) + 3) << 24)
    assert(w != 0, " sample bytes nonzero")

    echo(" sv_b2_convert_smoke ok")
    return 0
