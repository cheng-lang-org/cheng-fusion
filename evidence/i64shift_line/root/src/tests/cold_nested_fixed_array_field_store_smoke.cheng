type
    NestedFixedArrayEvidence =
        data: uint8[643]

var nestedFixedArrayEvidenceRows: NestedFixedArrayEvidence[4]

fn writeNestedFixedArrayEvidence(index: int32, value: uint8) =
    nestedFixedArrayEvidenceRows[0].data[index] = value

fn main(): int32 =
    writeNestedFixedArrayEvidence(0, uint8(17))
    writeNestedFixedArrayEvidence(642, uint8(91))
    return 0
