fn R19Trim(raw: str): str =
    return raw

fn R19Core(lineRaw: str, prefixLen: int32): int32 =
    let line = R19Trim(lineRaw)
    var tail: str
    if prefixLen > 0:
        tail = R19Trim(line)
    else:
        tail = line
    return tail.len

fn main(): int32 =
    let n = R19Core("abcdef", 0)
    if n != 6:
        return 10
    echo("r19 mergeexit ok")
    return 0
