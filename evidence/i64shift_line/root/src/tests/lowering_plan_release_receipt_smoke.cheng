import std/os
import std/strings
import std/system
import cheng/std/bytes_layout as layout
import cheng/core/backend/lowering_plan as lower
import cheng/core/backend/debug_facts as debugfact
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/ir/core_types as coreir
import cheng/core/csg_core/compiler_snapshot_schema as snapshot_schema
import cheng/core/lang/parser
import cheng/core/lang/typed_expr as texpr
import cheng/core/runtime/arena as arenamod

fn LoweringReleaseCid(seed: int32, lane: int32): layout.FixedBytes32 =
    var cid: layout.FixedBytes32
    cid.data[0] = uint8(seed & 255)
    cid.data[31] = uint8(lane & 255)
    return cid

fn LoweringReleaseSeedFfiCapabilityBridge(
        plan: var lower.LoweringPlanStub,
        seed: int32) =
    var bridge: lower.LoweringExternFfiHandleCallCapabilityBridge
    var table: ccsg.CompilerCsgExternFfiHandleCallCapabilityTable
    table.arena = arenamod.ArenaInitDefault(4096)
    assert(
        arenamod.ArenaArrayInt32ReserveEmpty(
            table.arena, table.callCoordinateKinds, 1) &&
        arenamod.ArenaArrayInt32ReserveEmpty(
            table.arena, table.resolvedCallRows, 1) &&
        arenamod.ArenaArrayInt32ReserveEmpty(
            table.arena, table.callerTypedFunctionIndexes, 1) &&
        arenamod.ArenaArrayInt32ReserveEmpty(
            table.arena, table.typedCallNodeIndexes, 1) &&
        arenamod.ArenaArrayInt32ReserveEmpty(
            table.arena, table.contractRows, 1) &&
        arenamod.ArenaArrayInt32ReserveEmpty(
            table.arena, table.effectStarts, 1) &&
        arenamod.ArenaArrayInt32ReserveEmpty(
            table.arena, table.effectCounts, 1) &&
        arenamod.ArenaArrayInt32ReserveEmpty(
            table.arena, table.effectRows, 1) &&
        arenamod.ArenaArrayInt32ReserveEmpty(
            table.arena, table.effectKinds, 1) &&
        arenamod.ArenaArrayInt32ReserveEmpty(
            table.arena, table.effectTargetKinds, 1) &&
        arenamod.ArenaArrayInt32ReserveEmpty(
            table.arena, table.effectParameterOrdinals, 1) &&
        arenamod.ArenaArrayInt32ReserveEmpty(
            table.arena, table.effectArgumentRows, 1) &&
        arenamod.ArenaArrayInt32ReserveEmpty(
            table.arena, table.effectArgumentValueNodeIndexes, 1) &&
        arenamod.ArenaArrayInt32ReserveEmpty(
            table.arena, table.effectValueDefinitionRows, 1) &&
        arenamod.ArenaArrayInt32ReserveEmpty(
            table.arena,
            table.effectGenerationRootValueDefinitionRows,
            1) &&
        arenamod.ArenaArrayInt32ReserveEmpty(
            table.arena, table.effectExactTypeIds, 1) &&
        arenamod.ArenaArrayInt32ReserveEmpty(
            table.arena, table.effectCarrierKinds, 1),
        "lowering release smoke: ffi capability arena reserve failed")
    arenamod.ArenaArrayInt32AddReserved(
        table.arena, table.callCoordinateKinds, 1)
    arenamod.ArenaArrayInt32AddReserved(
        table.arena, table.resolvedCallRows, 0)
    arenamod.ArenaArrayInt32AddReserved(
        table.arena, table.callerTypedFunctionIndexes, 0)
    arenamod.ArenaArrayInt32AddReserved(
        table.arena, table.typedCallNodeIndexes, 0)
    arenamod.ArenaArrayInt32AddReserved(
        table.arena, table.contractRows, 0)
    arenamod.ArenaArrayInt32AddReserved(
        table.arena, table.effectStarts, 0)
    arenamod.ArenaArrayInt32AddReserved(
        table.arena, table.effectCounts, 1)
    arenamod.ArenaArrayInt32AddReserved(
        table.arena, table.effectRows, 0)
    arenamod.ArenaArrayInt32AddReserved(
        table.arena, table.effectKinds, 1)
    arenamod.ArenaArrayInt32AddReserved(
        table.arena, table.effectTargetKinds, 1)
    arenamod.ArenaArrayInt32AddReserved(
        table.arena, table.effectParameterOrdinals, 0)
    arenamod.ArenaArrayInt32AddReserved(
        table.arena, table.effectArgumentRows, 0)
    arenamod.ArenaArrayInt32AddReserved(
        table.arena, table.effectArgumentValueNodeIndexes, 0)
    arenamod.ArenaArrayInt32AddReserved(
        table.arena, table.effectValueDefinitionRows, 0)
    arenamod.ArenaArrayInt32AddReserved(
        table.arena,
        table.effectGenerationRootValueDefinitionRows,
        0)
    arenamod.ArenaArrayInt32AddReserved(
        table.arena, table.effectExactTypeIds, seed)
    arenamod.ArenaArrayInt32AddReserved(
        table.arena, table.effectCarrierKinds, 1)
    add(table.callCapabilityCids, LoweringReleaseCid(seed, 60))
    add(table.effectArgumentBindingCids, LoweringReleaseCid(seed, 61))
    add(table.effectTypeCids, LoweringReleaseCid(seed, 62))
    add(table.effectGenerationCids, LoweringReleaseCid(seed, 63))
    add(table.effectDefinitionLineageCids, LoweringReleaseCid(seed, 64))
    add(table.effectCapabilityCids, LoweringReleaseCid(seed, 65))
    table.cargoCid = LoweringReleaseCid(seed, 66)
    table.complete = true
    bridge.semanticCapabilities = table
    table = ccsg.CompilerCsgExternFfiHandleCallCapabilityTable()
    let transferredBufferCount =
        lower.LoweringExternFfiHandleCallCapabilityBridgePhysicalBufferCount(
            bridge)
    let transferredBytes =
        lower.LoweringExternFfiHandleCallCapabilityBridgeRetainedBytes(bridge)
    assert(transferredBufferCount == 7 && transferredBytes > int64(0),
           "lowering release smoke: ffi capability transferred partition invalid")
    plan.compilerCsgLifecycleInitialBufferCount = transferredBufferCount
    plan.compilerCsgLifecycleInitialBytes = transferredBytes
    plan.compilerCsgLifecycleTransferredBufferCount = transferredBufferCount
    plan.compilerCsgLifecycleTransferredBytes = transferredBytes
    add(bridge.semanticContractCids, LoweringReleaseCid(seed, 67))
    add(bridge.semanticInterfaceCids, LoweringReleaseCid(seed, 68))
    add(bridge.semanticEffectCids, LoweringReleaseCid(seed, 69))
    add(bridge.snapshotCallIds, 0)
    add(bridge.snapshotContractRows, 0)
    add(bridge.snapshotEffectRows, 0)
    add(bridge.effectBridgeCids, LoweringReleaseCid(seed, 70))
    add(bridge.callBridgeCids, LoweringReleaseCid(seed, 71))
    bridge.semanticCargoCid = bridge.semanticCapabilities.cargoCid
    bridge.bridgeCid = LoweringReleaseCid(seed, 72)
    bridge.snapshotBound = true
    assert(
        lower.LoweringExternFfiHandleCallCapabilityBridgePhysicalBufferCount(
            bridge) == transferredBufferCount + 8 &&
        lower.LoweringExternFfiHandleCallCapabilityBridgeRetainedBytes(
            bridge) > transferredBytes,
        "lowering release smoke: ffi capability full bridge partition invalid")
    plan.externFfiHandleCallCapabilityBridge = bridge
    bridge = lower.LoweringExternFfiHandleCallCapabilityBridge()

fn LoweringReleaseBodyFunction(
        seed: int32): lower.PrimaryObjectIrFunction =
    var fnIr: lower.PrimaryObjectIrFunction
    fnIr.sourcePath = Fmt"src/body_{seed}.cheng"
    fnIr.functionName = Fmt"Body{seed}"
    fnIr.bodyKind = "function"
    var body = coreir.BodyIRNew()
    var slot: coreir.LocalSlot
    slot.id = seed
    slot.name = Fmt"owned_{seed}"
    add(body.localSlots, slot)
    var op: coreir.BodyOp
    op.kind = coreir.BodyOpLoadConstTag
    add(op.operands, seed)
    add(body.ops, op)
    fnIr.bodyIR = body
    return fnIr

fn LoweringReleaseCanonicalProjectionLifecycle(seed: int32) =
    var plan: lower.LoweringPlanStub
    lower.LoweringPlanReleaseCanonicalSnapshotProjectionPayload(plan)
    lower.LoweringCanonicalSnapshotProjectionAllocatorBegin(plan)
    lower.LoweringCanonicalSnapshotProjectionSetDomains(plan, 1, 1)
    let interfaceCid = LoweringReleaseCid(seed, 4)
    plan.snapshotFunctionIdsByTypedFunctionIndex[0] = 0
    plan.snapshotFunctionFragmentCidsByTypedFunctionIndex[0] =
        LoweringReleaseCid(seed, 3)
    plan.interfaceCidByTypedFunctionIndex[0] = interfaceCid
    lower.LoweringCanonicalSnapshotFunctionMerkleSeal(plan)
    plan.snapshotCallIdByTypedIrNodeIndex[0] = 0
    let externAbiCid = LoweringReleaseCid(seed, 50)
    let functionSymbolCid = LoweringReleaseCid(seed, 51)
    let parserProvenanceCid = LoweringReleaseCid(seed, 52)
    let contractCid = LoweringReleaseCid(seed, 53)
    let ffiInterfaceCid = LoweringReleaseCid(seed, 54)
    let parameterSymbolCid = LoweringReleaseCid(seed, 55)
    let typeCid = LoweringReleaseCid(seed, 56)
    let effectCid = LoweringReleaseCid(seed, 57)
    plan.snapshotExternFfiHandleCargoCid = LoweringReleaseCid(seed, 58)
    lower.LoweringCanonicalSnapshotProjectionAppendExternFfiHandleEffectRow(
        plan,
        0,
        snapshot_schema.CsgCompilerExternFfiHandleEffectBorrow,
        snapshot_schema.CsgCompilerExternFfiHandleTargetParameter,
        0,
        parameterSymbolCid,
        typeCid,
        snapshot_schema.CsgCompilerExternFfiHandleAbiCarrierUInt64,
        effectCid)
    lower.LoweringCanonicalSnapshotProjectionAppendCallRow(
        plan,
        0,
        seed + 30,
        -1,
        seed + 31,
        -1,
        externAbiCid,
        0,
        functionSymbolCid,
        parserProvenanceCid,
        contractCid,
        ffiInterfaceCid,
        snapshot_schema.CsgCompilerExternFfiHandleUnwindNoUnwind,
        0,
        1,
        0,
        0,
        0)
    lower.LoweringCanonicalSnapshotProjectionAppendValueDefinitionRow(
        plan, 0)
    plan.canonicalSnapshotProjectionRemainderCid =
        lower.LoweringCanonicalSnapshotProjectionRemainderCid(plan)
    let projectionAuthorityCid =
        lower.LoweringCanonicalSnapshotProjectionAuthorityCid(plan)
    let retainedBufferCount =
        lower.LoweringCanonicalSnapshotProjectionAllocatorPhysicalBufferCount(
            plan)
    let retainedBytes =
        lower.LoweringCanonicalSnapshotProjectionAllocatorCapacityBytes(plan)
    assert(
        plan.canonicalSnapshotFunctionMerkleNodes.len == 1 &&
        plan.canonicalSnapshotFunctionMerkleNodes.cap > 0 &&
        !layout.FixedBytes32Equal(
            projectionAuthorityCid, layout.FixedBytes32()) &&
        retainedBufferCount > 0 && retainedBytes > int64(0),
        "lowering release smoke: canonical projection preimage invalid")
    lower.LoweringPlanReleaseCanonicalSnapshotProjectionPayload(plan)
    let receipt = plan.canonicalSnapshotProjectionAllocatorReceipt
    assert(
        plan.canonicalSnapshotProjectionAllocatorReceiptReady &&
        receipt.storageReleased &&
        receipt.allocationEventCount == receipt.releaseEventCount &&
        receipt.allocatedCapacityBytes == receipt.releasedCapacityBytes &&
        receipt.terminalRetainedBufferCount == retainedBufferCount &&
        receipt.terminalReleasedBufferCount == retainedBufferCount &&
        receipt.terminalRetainedBytes == retainedBytes &&
        receipt.terminalReleasedBytes == retainedBytes &&
        receipt.liveAllocationCount == int64(0) &&
        receipt.liveCapacityBytes == int64(0) &&
        plan.canonicalSnapshotFunctionMerkleNodes.len == 0 &&
        plan.canonicalSnapshotFunctionMerkleNodes.cap == 0 &&
        lower.LoweringCanonicalSnapshotProjectionAllocatorPhysicalBufferCount(
            plan) == 0 &&
        lower.LoweringCanonicalSnapshotProjectionAllocatorCapacityBytes(plan) ==
            int64(0),
        "lowering release smoke: canonical projection release mismatch")

fn LoweringReleaseFixtureFull(seed: int32): lower.LoweringPlanStub =
    var plan: lower.LoweringPlanStub
    let suffix = strings.IntToStr(seed)
    plan.workspaceRoot = Fmt"/workspace/{suffix}"
    plan.packageRoot = Fmt"/workspace/{suffix}/src"
    plan.packageId = Fmt"cheng/lowering/{suffix}"
    plan.entryPath = Fmt"src/main_{suffix}.cheng"
    plan.entrySymbol = Fmt"Main{suffix}"
    plan.compilerCsgExprSliceSidecarValidationReason =
        Fmt"validated-{suffix}"
    plan.primaryObjectIrBuildMode = Fmt"full-{suffix}"
    plan.pipelineStage = Fmt"lowering-release-{suffix}"
    plan.sourceBundleCid.data[0] = uint8(seed & 255)
    plan.compilerCsgCid.data[0] = uint8((seed + 1) & 255)
    plan.typeArenaArtifactCid.data[0] =
        uint8((seed + 2) & 255)
    plan.fnPtrFieldCallTypeArenaArtifactCid.data[0] =
        uint8((seed + 3) & 255)

    plan.typeArenaStructuralKinds = [seed]
    plan.typeArenaScalarKinds = [seed + 1]
    plan.typeArenaChildTypeIds = [seed + 2]
    plan.typeArenaFixedLengths = [seed + 3]
    plan.typeArenaSizeBytes = [seed + 4]
    plan.typeArenaAlignBytes = [seed + 5]
    plan.typeArenaLayoutPresent = [1]
    plan.fnPtrFieldCallNodeIndexes = [seed + 6]
    plan.fnPtrFieldCallFieldNodeIndexes = [seed + 7]
    plan.fnPtrFieldCallFieldTypeIds = [seed + 8]
    plan.fnPtrFieldCallStructuralKinds = [seed + 9]
    add(
        plan.fnPtrFieldCallFunctionInterfaceCids,
        LoweringReleaseCid(seed, 4))
    LoweringReleaseSeedFfiCapabilityBridge(plan, seed)
    lower.LoweringResolvedCallTargetProjectionBegin(plan, 1)
    lower.LoweringResolvedCallTargetProjectionAppend(
        plan, seed + 36)
    lower.LoweringResolvedCallTargetProjectionMoveToPlan(plan)
    plan.semanticDebugFunctionIdsByTypedFunctionIndex = [seed + 37]
    plan.semanticDebugTypedNodeIdsByTypedIrNodeIndex = [seed + 38]
    plan.semanticDebugOpIdsByTypedIrNodeIndex = [seed + 39]
    plan.typedFunctionReturnTypeArenaTypeIds = [seed + 10]
    plan.typedFunctionReturnManagedStorageKinds = [seed + 11]
    plan.globalTypeArenaTypeIds = [seed + 12]
    plan.globalManagedStorageKinds = [seed + 13]

    plan.resolvedCallFactSourcePaths = [
        Fmt"src/resolved_{suffix}.cheng"]
    plan.resolvedCallFactSourceBucketHeads = [0]
    plan.resolvedCallFactSourceEntryNext = [-1]
    plan.resolvedCallFactBucketHeads = [0]
    plan.resolvedCallFactEntryNext = [-1]
    plan.resolvedCallFactEntrySourceIndexes = [0]
    plan.resolvedCallFactEntryLineNumbers = [seed + 40]
    plan.resolvedCallFactEntryFactIndexes = [0]
    plan.typedFunctionIndexSourcePaths = [
        Fmt"src/typed_{suffix}.cheng"]
    plan.typedFunctionIndexSourceBucketHeads = [0]
    plan.typedFunctionIndexSourceEntryNext = [-1]
    plan.typedFunctionIndexAbsoluteSuffixBucketHeads = [0]
    plan.typedFunctionIndexAbsoluteSuffixEntryNext = [-1]
    plan.typedFunctionIndexAbsoluteSuffixEntryNames = [
        Fmt"typed_suffix_{suffix}"]
    plan.typedFunctionIndexAbsoluteSuffixEntrySourceIndexes = [0]
    plan.typedFunctionIndexBucketHeads = [0]
    plan.typedFunctionIndexEntryNext = [-1]
    plan.typedFunctionIndexEntrySourceIndexes = [0]
    plan.typedFunctionIndexEntryNames = [Fmt"Typed{suffix}"]
    plan.typedFunctionIndexEntryIndexes = [0]
    plan.typedFunctionIdentitySourcePaths = [
        Fmt"src/identity_{suffix}.cheng"]
    plan.typedFunctionIdentitySourceBucketHeads = [0]
    plan.typedFunctionIdentitySourceEntryNext = [-1]
    plan.typedFunctionIdentityBucketHeads = [0]
    plan.typedFunctionIdentityEntryNext = [-1]
    plan.typedFunctionIdentityEntrySourceIndexes = [0]
    plan.typedFunctionIdentityEntryNameIds = [seed + 41]
    plan.typedFunctionIdentityEntryDeclarationLines = [seed + 42]
    plan.typedFunctionIdentityEntryFunctionIndexes = [0]
    plan.typedFunctionReferenceSourcePaths = [
        Fmt"src/reference_{suffix}.cheng"]
    plan.typedFunctionReferenceSourceBucketHeads = [0]
    plan.typedFunctionReferenceSourceEntryNext = [-1]
    plan.typedFunctionReferenceAliasBucketHeads = [0]
    plan.typedFunctionReferenceAliasEntryNext = [-1]
    plan.typedFunctionReferenceAliasEntrySourceIndexes = [0]
    plan.typedFunctionReferenceAliasEntryNames = [
        Fmt"reference_{suffix}"]
    plan.typedFunctionReferenceAliasEntryCandidateHeads = [0]
    plan.typedFunctionReferenceAliasEntryCandidateTails = [0]
    plan.typedFunctionReferenceAliasCandidateNext = [-1]
    plan.typedFunctionReferenceAliasCandidateFunctionIndexes = [0]
    plan.typedFunctionReferenceGlobalBucketHeads = [0]
    plan.typedFunctionReferenceGlobalEntryNext = [-1]
    plan.typedFunctionReferenceGlobalEntryNames = [
        Fmt"global_{suffix}"]
    plan.typedFunctionReferenceGlobalEntryCandidateHeads = [0]
    plan.typedFunctionReferenceGlobalEntryCandidateTails = [0]
    plan.typedFunctionReferenceGlobalCandidateNext = [-1]
    plan.typedFunctionReferenceGlobalCandidateSourceIndexes = [0]
    plan.typedFunctionReferenceGlobalCandidateFunctionIndexes = [0]
    plan.typedFunctionReferenceClaimedFlags = [true]
    plan.typedFunctionReferenceFlags = [true]
    plan.moduleSourceIndexModulePaths = [
        Fmt"module/{suffix}"]
    plan.moduleSourceIndexCanonicalSourcePaths = [
        Fmt"src/module_{suffix}.cheng"]
    plan.moduleSourceIndexBucketHeads = [0]
    plan.moduleSourceIndexEntryNext = [-1]
    plan.functionSourcePaths = [
        Fmt"src/function_{suffix}.cheng"]
    plan.functionOwnerModulePaths = [
        Fmt"owner/{suffix}"]
    plan.functionNames = [Fmt"Function{suffix}"]
    plan.functionSymbolTexts = [Fmt"_Function{suffix}"]
    plan.functionSemanticSources = [
        Fmt"src/function_{suffix}.cheng"]
    plan.functionSemanticDeclarationLineIndexes = [seed]
    plan.functionSemanticParamTypeJoins = ["int32"]
    plan.functionSemanticReturnTypes = ["int32"]
    plan.functionSemanticSignatureCompletes = [1]
    plan.functionTypedIrIndexes = [0]
    plan.functionExportedFlags = [1]
    plan.functionExportSymbolNames = [Fmt"_Function{suffix}"]
    add(plan.functionNameIds, seed)
    plan.functionEntryFlags = [1]
    plan.functionCallConvs = [0]
    plan.functionResultLayoutKinds = [1]
    plan.functionSignatureLineNumbers = [seed + 1]
    plan.functionBodyLineNumbers = [seed + 2]
    plan.missingReasons = [Fmt"fixture-{suffix}"]
    let standaloneFn =
        LoweringReleaseBodyFunction(seed + 20)
    add(plan.primaryObjectIrFunctions, standaloneFn)
    let primaryFn =
        LoweringReleaseBodyFunction(seed + 21)
    add(plan.primaryObjectIr.functions, primaryFn)

    var returnOp: texpr.TypedExprReturnOpFact
    returnOp.sourcePath = plan.functionSourcePaths[0]
    returnOp.functionName = plan.functionNames[0]
    returnOp.returnType = "int32"
    returnOp.lhsName = "lhs"
    returnOp.lhsType = "int32"
    returnOp.rhsName = "rhs"
    returnOp.rhsType = "int32"
    returnOp.accName = "acc"
    returnOp.accType = "int32"
    returnOp.returnExpr = "lhs + rhs"
    add(plan.typedReturnOps, returnOp)

    var rule: texpr.TypedExprLoweringRule
    rule.exprId = Fmt"expr-{suffix}"
    rule.sourcePath = plan.functionSourcePaths[0]
    rule.callQualifier = "fixture"
    rule.callCallee = "callee"
    rule.callTarget = "fixture::callee"
    rule.callTargetSourcePath = plan.functionSourcePaths[0]
    rule.callArgsText = "lhs, rhs"
    rule.typeText = "int32"
    add(plan.loweringRules, rule)

    var edge: parser.ImportEdge
    edge.ownerModulePath = Fmt"owner/{suffix}"
    edge.targetModulePath = Fmt"target/{suffix}"
    edge.targetSourcePath = Fmt"src/target_{suffix}.cheng"
    edge.importAlias = "target"
    edge.qualifier = "target"
    plan.importEdgeIndexOwnerModulePaths = [Fmt"owner/{suffix}"]
    plan.importEdgeIndexQualifiers = ["target"]
    plan.importEdgeIndexEntryEdgeIndexes = [0]
    plan.importEdgeIndexBucketHeads = [0]
    plan.importEdgeIndexEntryNext = [-1]
    plan.importOwnerIndexOwnerModulePaths = [Fmt"owner/{suffix}"]
    plan.importOwnerIndexEntryEdgeIndexes = [0]
    plan.importOwnerIndexBucketHeads = [0]
    plan.importOwnerIndexEntryNext = [-1]
    plan.unqualifiedImportResolveCacheSourcePaths = [
        Fmt"src/function_{suffix}.cheng"]
    plan.unqualifiedImportResolveCacheFunctionNames = [
        Fmt"Function{suffix}"]
    plan.unqualifiedImportResolveCacheTargetSourcePaths = [
        Fmt"src/target_{suffix}.cheng"]
    plan.unqualifiedImportResolveCacheBucketHeads = [0]
    plan.unqualifiedImportResolveCacheEntryNext = [-1]
    plan.qualifiedImportResolveCacheSourcePaths = [
        Fmt"src/function_{suffix}.cheng"]
    plan.qualifiedImportResolveCacheQualifiers = ["target"]
    plan.qualifiedImportResolveCacheTargetSourcePaths = [
        Fmt"src/target_{suffix}.cheng"]
    plan.qualifiedImportResolveCacheBucketHeads = [0]
    plan.qualifiedImportResolveCacheEntryNext = [-1]
    lower.LoweringPlanReleaseImportGraphPayload(plan)
    lower.LoweringImportGraphAllocatorBegin(plan)
    lower.LoweringImportGraphAppendEdge(plan, edge)

    plan.semanticDebugFacts.packageId = plan.packageId
    var debugRow: debugfact.DebugFact
    debugRow.kind = debugfact.DebugFactKindFunction
    debugRow.functionFact.modulePath = Fmt"module/{suffix}"
    debugRow.functionFact.functionName = plan.functionNames[0]
    debugRow.functionFact.qualifiedName =
        Fmt"{plan.packageId}::{plan.functionNames[0]}"
    debugRow.operationFact.modulePath = Fmt"module/{suffix}"
    debugRow.symbolFact.modulePath = Fmt"module/{suffix}"
    debugRow.symbolFact.name = Fmt"symbol-{suffix}"
    debugRow.symbolFact.qualifiedName =
        Fmt"{plan.packageId}::symbol-{suffix}"
    debugRow.layoutFact.canonicalTypeName =
        Fmt"Layout{suffix}"
    add(plan.semanticDebugFacts.facts, debugRow)
    return plan

fn LoweringReleaseFixturePartial(seed: int32): lower.LoweringPlanStub =
    var plan: lower.LoweringPlanStub
    plan.workspaceRoot = Fmt"/partial/{strings.IntToStr(seed)}"
    plan.typeArenaStructuralKinds = [seed]
    plan.fnPtrFieldCallFieldTypeIds = [seed + 1]
    plan.typedFunctionReturnTypeArenaTypeIds = [seed + 2]
    plan.globalTypeArenaTypeIds = [seed + 3]
    return plan

fn LoweringReleaseConsume(
        plan: var lower.LoweringPlanStub,
        allocatedBufferCount: var int64,
        releasedBufferCount: var int64,
        allocatedBytes: var int64,
        releasedBytes: var int64) =
    let buffers = lower.LoweringPlanRetainedBufferCount(plan)
    let bytes = lower.LoweringPlanRetainedBytes(plan)
    allocatedBufferCount =
        allocatedBufferCount + int64(buffers)
    allocatedBytes = allocatedBytes + bytes
    var receipt: lower.LoweringPlanReleaseReceipt
    lower.LoweringPlanReleaseWithReceipt(plan, receipt)
    assert(receipt.storageReleased &&
           layout.FixedBytes32Equal(
               receipt.canonicalSnapshotProjectionAuthorityCid,
               layout.FixedBytes32()) &&
           layout.FixedBytes32Equal(
               receipt.canonicalSnapshotProjectionAuthorityCid,
               plan.terminalReleasedCanonicalSnapshotProjectionAuthorityCid) &&
           receipt.releasedOwnedStorageColumnCount ==
               lower.LoweringPlanOwnedStorageColumnCount &&
           receipt.releasedBufferCount == buffers &&
           receipt.releasedBytes == bytes &&
           receipt.lifecycleClosed &&
           receipt.lifecycleInitialBufferCount ==
               receipt.lifecycleReleasedBufferCount &&
           receipt.lifecycleInitialBytes ==
               receipt.lifecycleReleasedBytes &&
           lower.LoweringPlanStorageReleased(plan) &&
           lower.LoweringPlanRetainedBufferCount(plan) == 0 &&
           lower.LoweringPlanRetainedBytes(plan) == int64(0),
           "lowering release smoke: receipt mismatch")
    var err: str
    assert(
        lower.LoweringPlanReleaseReceiptConsumeStrictInto(
            plan, receipt, err),
        err)
    releasedBufferCount =
        releasedBufferCount +
        int64(receipt.releasedBufferCount)
    releasedBytes = releasedBytes + receipt.releasedBytes

fn LoweringReleaseMutationNet(): bool =
    var left = LoweringReleaseFixtureFull(101)
    var right = LoweringReleaseFixtureFull(202)
    var leftReceipt: lower.LoweringPlanReleaseReceipt
    var rightReceipt: lower.LoweringPlanReleaseReceipt
    lower.LoweringPlanReleaseWithReceipt(left, leftReceipt)
    lower.LoweringPlanReleaseWithReceipt(right, rightReceipt)
    var err: str
    if lower.LoweringPlanReleaseReceiptConsumeStrictInto(
           left, rightReceipt, err):
        return false
    var missingNewColumn = leftReceipt
    missingNewColumn.releasedOwnedStorageColumnCount =
        missingNewColumn.releasedOwnedStorageColumnCount - 1
    if lower.LoweringPlanReleaseReceiptConsumeStrictInto(
           left, missingNewColumn, err):
        return false
    var missingNewBuffer = leftReceipt
    missingNewBuffer.releasedBufferCount =
        missingNewBuffer.releasedBufferCount - 1
    if lower.LoweringPlanReleaseReceiptConsumeStrictInto(
           left, missingNewBuffer, err):
        return false
    var wrongBytes = leftReceipt
    wrongBytes.releasedBytes =
        wrongBytes.releasedBytes + int64(1)
    if lower.LoweringPlanReleaseReceiptConsumeStrictInto(
           left, wrongBytes, err):
        return false
    var wrongLifecycleBytes = leftReceipt
    wrongLifecycleBytes.lifecycleReleasedBytes =
        wrongLifecycleBytes.lifecycleReleasedBytes + int64(1)
    if lower.LoweringPlanReleaseReceiptConsumeStrictInto(
           left, wrongLifecycleBytes, err):
        return false
    var openLifecycle = leftReceipt
    openLifecycle.lifecycleClosed = false
    if lower.LoweringPlanReleaseReceiptConsumeStrictInto(
           left, openLifecycle, err):
        return false
    var wrongToken = leftReceipt
    wrongToken.ownerToken.data[0] =
        uint8(Int32(wrongToken.ownerToken.data[0]) ^ 1)
    if lower.LoweringPlanReleaseReceiptConsumeStrictInto(
           left, wrongToken, err):
        return false
    var wrongProjectionAuthority = leftReceipt
    wrongProjectionAuthority.canonicalSnapshotProjectionAuthorityCid.data[0] =
        uint8(
            Int32(
                wrongProjectionAuthority.
                    canonicalSnapshotProjectionAuthorityCid.data[0]) ^ 1)
    if lower.LoweringPlanReleaseReceiptConsumeStrictInto(
           left, wrongProjectionAuthority, err):
        return false
    if !lower.LoweringPlanReleaseReceiptConsumeStrictInto(
           left, leftReceipt, err):
        return false
    if lower.LoweringPlanReleaseReceiptConsumeStrictInto(
           left, leftReceipt, err):
        return false
    return lower.LoweringPlanReleaseReceiptConsumeStrictInto(
        right, rightReceipt, err)

fn LoweringReleaseDuplicateNegative() =
    var plan = LoweringReleaseFixturePartial(303)
    var receipt: lower.LoweringPlanReleaseReceipt
    lower.LoweringPlanReleaseWithReceipt(plan, receipt)
    lower.LoweringPlanReleaseWithReceipt(plan, receipt)

fn main(): int32 =
    if os.GetEnv("CHENG_LOWERING_RELEASE_NEGATIVE") ==
           "duplicate_release":
        LoweringReleaseDuplicateNegative()
        return 91
    assert(lower.LoweringPlanOwnedStorageColumnCount == 250,
           "lowering release smoke: owned column schema drift")
    LoweringReleaseCanonicalProjectionLifecycle(701)
    var allocatedBufferCount: int64
    var releasedBufferCount: int64
    var allocatedBytes: int64
    var releasedBytes: int64
    let runtimeAllocBefore = system.memAllocCount()
    let runtimeFreeBefore = system.memFreeCount()
    let runtimeLiveBefore = system.memLiveCount()
    for iteration in 0..<1000:
        var fullPlan =
            LoweringReleaseFixtureFull(iteration + 1)
        assert(lower.LoweringPlanRetainedBufferCount(fullPlan) > 0 &&
               lower.LoweringPlanRetainedBytes(fullPlan) > int64(0),
               "lowering release smoke: full fixture storage missing")
        LoweringReleaseConsume(
            fullPlan,
            allocatedBufferCount,
            releasedBufferCount,
            allocatedBytes,
            releasedBytes)

        var partialPlan =
            LoweringReleaseFixturePartial(iteration + 1)
        assert(
            lower.LoweringPlanRetainedBufferCount(partialPlan) > 0,
            "lowering release smoke: partial fixture storage missing")
        LoweringReleaseConsume(
            partialPlan,
            allocatedBufferCount,
            releasedBufferCount,
            allocatedBytes,
            releasedBytes)

        var emptyPlan: lower.LoweringPlanStub
        LoweringReleaseConsume(
            emptyPlan,
            allocatedBufferCount,
            releasedBufferCount,
            allocatedBytes,
            releasedBytes)
    assert(allocatedBufferCount == releasedBufferCount &&
           allocatedBytes == releasedBytes,
           "lowering release smoke: alloc/release mismatch")
    assert(LoweringReleaseMutationNet(),
           "lowering release smoke: mutation accepted")
    let runtimeAllocDelta =
        system.memAllocCount() - runtimeAllocBefore
    let runtimeFreeDelta =
        system.memFreeCount() - runtimeFreeBefore
    let runtimeLiveAfter = system.memLiveCount()
    assert(runtimeAllocDelta > int64(0) &&
           runtimeAllocDelta == runtimeFreeDelta &&
           runtimeLiveAfter == runtimeLiveBefore,
           "lowering release smoke: ORC alloc/free/live mismatch")
    echo("lowering_plan_release_full_iterations=1000")
    echo("lowering_plan_release_ffi_capability_bridge_iterations=1000")
    echo("lowering_plan_release_partial_iterations=1000")
    echo("lowering_plan_release_empty_iterations=1000")
    echo("lowering_plan_release_alloc_eq_release=1")
    echo("lowering_plan_release_orc_alloc_eq_free=1")
    echo("lowering_plan_release_live=0")
    echo("lowering_plan_release_mutations_rejected=1")
    return 0
