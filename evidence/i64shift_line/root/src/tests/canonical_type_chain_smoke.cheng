import std/cmdline
import cheng/core/backend/canonical_type_chain as chain
import cheng/core/backend/lowering_plan as lower
import cheng/core/lang/typed_expr_type_arena as typearena
import cheng/std/bytes_layout as layout

fn appendFact(plan: var lower.LoweringPlanStub,
              kind: typearena.TypedExprStructuralTypeKind,
              childTypeId: int32,
              fixedLength: int32,
              sizeBytes: int32,
              alignBytes: int32) =
    add(plan.typeArenaStructuralKinds, Int32(kind))
    add(plan.typeArenaScalarKinds, 0)
    add(plan.typeArenaChildTypeIds, childTypeId)
    add(plan.typeArenaFixedLengths, fixedLength)
    add(plan.typeArenaSizeBytes, sizeBytes)
    add(plan.typeArenaAlignBytes, alignBytes)
    add(plan.typeArenaLayoutPresent, 1)

fn beginPlan(): lower.LoweringPlanStub =
    var plan: lower.LoweringPlanStub
    plan.typeArenaArtifactCid.data[0] = uint8(1)
    return plan

fn deepAliasPlan(depth: int32,
                 terminalKind: typearena.TypedExprStructuralTypeKind,
                 terminalChild: int32,
                 terminalFixedLength: int32): lower.LoweringPlanStub =
    var plan = beginPlan()
    for index in 0..<depth:
        appendFact(plan,
                   typearena.TypedExprStructuralTypeAlias,
                   index + 1,
                   0,
                   8,
                   8)
    appendFact(plan,
               terminalKind,
               terminalChild,
               terminalFixedLength,
               8,
               8)
    return plan

fn runPositive() =
    var applyDeclaration = beginPlan()
    appendFact(applyDeclaration,
               typearena.TypedExprStructuralTypeApply,
               1,
               0,
               8,
               8)
    for index in 0..<129:
        appendFact(applyDeclaration,
                   typearena.TypedExprStructuralTypeAlias,
                   index + 2,
                   0,
                   8,
                   8)
    appendFact(applyDeclaration,
               typearena.TypedExprStructuralTypeEnum,
               -1,
               0,
               4,
               4)
    assert(chain.CanonicalTypeChainEnumTypeId(
               applyDeclaration, 0) == 130,
           "canonical type chain: Apply declaration child projection")

    var chain129 = deepAliasPlan(
        129,
        typearena.TypedExprStructuralTypeEnum,
        -1,
        0)
    assert(chain.CanonicalTypeChainEnumTypeId(chain129, 0) == 129,
           "canonical type chain: 129-deep enum")

    var chain512 = deepAliasPlan(
        512,
        typearena.TypedExprStructuralTypeRefObject,
        -1,
        0)
    assert(chain.CanonicalTypeChainPhysicalTypeId(chain512, 0) == 512,
           "canonical type chain: 512-deep ref")

    var sequence = beginPlan()
    appendFact(sequence,
               typearena.TypedExprStructuralTypeSequence,
               1,
               0,
               24,
               8)
    appendFact(sequence,
               typearena.TypedExprStructuralTypeEnum,
               -1,
               0,
               4,
               4)
    assert(chain.CanonicalTypeChainSequenceElementTypeId(
               sequence, 0, false) == 1 &&
           chain.CanonicalTypeChainEnumTypeId(sequence, 1) == 1,
           "canonical type chain: seq enum")

    var fixed = beginPlan()
    appendFact(fixed,
               typearena.TypedExprStructuralTypeFixedArray,
               1,
               7,
               28,
               4)
    appendFact(fixed,
               typearena.TypedExprStructuralTypeScalar,
               -1,
               0,
               4,
               4)
    fixed.typeArenaScalarKinds[1] =
        Int32(typearena.TypedExprStructuralScalarInt32)
    assert(chain.CanonicalTypeChainSequenceElementTypeId(
               fixed, 0, true) == 1,
           "canonical type chain: fixed array")

    var childOrder = beginPlan()
    appendFact(childOrder,
               typearena.TypedExprStructuralTypeSequence,
               2,
               0,
               24,
               8)
    appendFact(childOrder,
               typearena.TypedExprStructuralTypeEnum,
               -1,
               0,
               4,
               4)
    appendFact(childOrder,
               typearena.TypedExprStructuralTypeEnum,
               -1,
               0,
               4,
               4)
    let selectedChild =
        chain.CanonicalTypeChainSequenceElementTypeId(
            childOrder, 0, false)
    assert(selectedChild == 2 && selectedChild != 1,
           "canonical type chain: TypeId child order")

    # Two generic applications may share one physical declaration child and
    # layout while retaining different exact semantic TypeIds.  Backends must
    # never use physical traversal as generic type equality.
    var genericIdentity = beginPlan()
    appendFact(genericIdentity,
               typearena.TypedExprStructuralTypeApply,
               2,
               0,
               8,
               8)
    appendFact(genericIdentity,
               typearena.TypedExprStructuralTypeApply,
               2,
               0,
               8,
               8)
    appendFact(genericIdentity,
               typearena.TypedExprStructuralTypeRefObject,
               -1,
               0,
               8,
               8)
    assert(chain.CanonicalTypeChainPhysicalTypeId(
               genericIdentity, 0) ==
           chain.CanonicalTypeChainPhysicalTypeId(
               genericIdentity, 1) &&
           0 != 1,
           "canonical type chain: generic Apply exact identity")

fn runCycle() =
    var plan = beginPlan()
    appendFact(plan, typearena.TypedExprStructuralTypeAlias, 1, 0, 8, 8)
    appendFact(plan, typearena.TypedExprStructuralTypeAlias, 0, 0, 8, 8)
    let _ = chain.CanonicalTypeChainPhysicalTypeId(plan, 0)

fn runNonUnique() =
    var plan = beginPlan()
    appendFact(plan, typearena.TypedExprStructuralTypeAlias, -1, 0, 8, 8)
    let _ = chain.CanonicalTypeChainPhysicalTypeId(plan, 0)

fn runMissing() =
    var plan = beginPlan()
    appendFact(plan, typearena.TypedExprStructuralTypeSequence, 9, 0, 24, 8)
    let _ = chain.CanonicalTypeChainSequenceElementTypeId(plan, 0, false)

fn runApplyCycle() =
    var plan = beginPlan()
    appendFact(plan, typearena.TypedExprStructuralTypeApply, 0, 0, 8, 8)
    let _ = chain.CanonicalTypeChainPhysicalTypeId(plan, 0)

fn runApplyZero() =
    var plan = beginPlan()
    appendFact(plan, typearena.TypedExprStructuralTypeApply, -1, 0, 8, 8)
    let _ = chain.CanonicalTypeChainPhysicalTypeId(plan, 0)

fn runApplyMissing() =
    var plan = beginPlan()
    appendFact(plan, typearena.TypedExprStructuralTypeApply, 9, 0, 8, 8)
    let _ = chain.CanonicalTypeChainPhysicalTypeId(plan, 0)

fn main(): int32 =
    let mode = cmdline.ParamCount() > 1 ? cmdline.ParamStr(1) : "positive"
    if mode == "positive":
        runPositive()
    elif mode == "cycle":
        runCycle()
    elif mode == "zero" || mode == "ambiguous":
        runNonUnique()
    elif mode == "missing":
        runMissing()
    elif mode == "apply_cycle":
        runApplyCycle()
    elif mode == "apply_zero":
        runApplyZero()
    elif mode == "apply_missing":
        runApplyMissing()
    else:
        panic("canonical type chain smoke: unknown mode")
    return 0
