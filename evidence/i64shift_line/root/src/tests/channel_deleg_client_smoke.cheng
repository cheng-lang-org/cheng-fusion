# libp2p P3 收尾片: 委托 head 网络分发腿 — 请求方 (B) 客户端 exe (正典 §11.6 P3 委托解析闭环)。
# B 真两进程之另一: 空库空 TOFU, 只知逻辑 channel L, 真 UDP dial 应答方 A → 跑编排器
# Libp2pHostQuicResolveDelegatedHead (①取cert→②先取撤销闸→③自证取D head→④resolver委托授权)。
#   expect=valid: 编排器接受 D head 绑回 L → TofuAdmit (按 record.channelId=sha256(D)); 并跑两轮验幂等。
#   expect=<负路径名>: 编排器硬错 + rejectReason 精确 + B 库零污染 (TOFU 未落, 无静默回落 L 直连)。
#
# 用法: --port <bound> --store-root <B dir> --logical-l-hex <hex> --expect <name>
# expect: valid | deleg_miss | cert_a_mismatch | revoked | forged_cert | subdeleg | expired | head_missing

import std/system
import std/result
import std/cmdline as cmdline
import std/rawbytes as rawbytes
import cheng/std/bytes_layout as layout
import cheng/libp2p/protocols/cas_source/channel_head/head_codec as head
import cheng/libp2p/protocols/cas_source/channel_head/tofu as tofu
import cheng/libp2p/host/host_quic as hq
import std/strutils as strutil
import std/strings as strings

# TOFU 信任文件里的非空条目数 (零污染判据: 负路径后应为 0)。
fn tofuEntryCount(storeRoot: str): int32 =
    var loadRes = tofu.TofuLoad(storeRoot)
    if IsErr(loadRes):
        return int32(-1)
    let lines = Value(loadRes)
    var n: int32 = 0
    for i in 0..<lines.len:
        if strutil.Strip(lines[i]) != "":
            n = n + 1
    return n

# 负路径统一断言: 编排器硬错 + rejectReason 含期望片段 + B 零污染 (TOFU 无条目)。
fn assertReject(port: int32, storeRoot: str, logicalL: layout.FixedBytes32, want: str) =
    var rec: head.ChannelHeadRecord
    let res = hq.Libp2pHostQuicResolveDelegatedHead("127.0.0.1", port, "localhost", storeRoot, logicalL, rec)
    assert(IsErr(res), " 负路径必须硬错 (期望含: " + want + ")")
    echo(strutil.Join(["   REJECT full=[", Error(res), "]"], ""))
    assert(strutil.Contains(Error(res), want), " rejectReason 精确: got=[" + Error(res) + "] want 含=[" + want + "]")
    assert(tofuEntryCount(storeRoot) == 0, " B 零污染: TOFU 无条目 (负路径不落 TofuAdmit)")

fn main(): int32 =
    let port = cmdline.ReadInt32FlagOrDefault("--port", -1)
    let storeRoot = cmdline.ReadFlagOrDefault("--store-root", "")
    let logicalLHex = cmdline.ReadFlagOrDefault("--logical-l-hex", "")
    let expect = cmdline.ReadFlagOrDefault("--expect", "valid")
    assert(port > 0, " client: --port required")
    assert(storeRoot != "", " client: --store-root required")
    assert(logicalLHex != "", " client: --logical-l-hex required")

    let lRes = layout.FixedBytes32FromHex(logicalLHex)
    assert(lRes.ok, " client: logical-l-hex 非 32B hex: " + Error(lRes))
    let logicalL = lRes.value

    if expect == "valid":
        # ---- 正路径: 编排器接受 D 的 head 绑回 L (真 UDP: ①取cert→②先取撤销闸→③自证取head→④授权) ----
        var rec: head.ChannelHeadRecord
        let r = hq.Libp2pHostQuicResolveDelegatedHead("127.0.0.1", port, "localhost", storeRoot, logicalL, rec)
        assert(r.ok, " 正路径委托解析: " + Error(r))
        # D 自证 head: channelId == sha256(signerPubKey), 且 != 逻辑 L (真委托而非直连)
        assert(layout.FixedBytes32Equal(rec.channelId, head.ChannelIdForPubKey(rec.signerPubKey)), " 委托 head 自证 (channelId==sha256(D))")
        assert(!layout.FixedBytes32Equal(rec.channelId, logicalL), " 委托源 != 逻辑 L (确为委托路径)")
        let dChanHex = layout.FixedBytes32Hex(rec.channelId)
        let before = tofuEntryCount(storeRoot)
        var loadRes = tofu.TofuLoad(storeRoot)
        assert(loadRes.ok, " TOFU load: " + Error(loadRes))
        let prior = tofu.TofuLookup(Value(loadRes), dChanHex)
        if !prior.found:
            # 首轮: 空 B → 接受并落 TOFU (按 record.channelId=sha256(D), 调用方下一步)
            var admit = tofu.TofuAdmit(storeRoot, rec.channelId, rec.signerPubKey, rec.epoch)
            assert(admit.ok, " TofuAdmit 接受委托 head: " + Error(admit))
            assert(tofuEntryCount(storeRoot) == before + 1, " 接受后 TOFU +1 条目")
            echo(strutil.Join([" cas_deleg client VALID ok (委托解析绑回 L, 首轮接受) delegate_channel=", dChanHex,
                               " epoch=", strings.Int64ToStr(rec.epoch)], ""))
        else:
            # 幂等轮: B 已有该 (channel,epoch) → 独立进程再解结果逐字段等同 + 同 epoch 再 admit 被单调拒 + TOFU 不变
            assert(prior.pubKeyHex == rawbytes.BytesToHex(rec.signerPubKey), " 幂等: 解析 signer 与已落 TOFU 等同")
            assert(prior.epoch == rec.epoch, " 幂等: 解析 epoch 与已落 TOFU 等同")
            var readmit = tofu.TofuAdmit(storeRoot, rec.channelId, rec.signerPubKey, rec.epoch)
            assert(IsErr(readmit), " 幂等: 同 epoch 再 admit 必被单调拒 (TOFU monotonic)")
            assert(strutil.Contains(Error(readmit), "rollback"), " 幂等: rejectReason=epoch rollback, got=[" + Error(readmit) + "]")
            assert(tofuEntryCount(storeRoot) == before, " 幂等: TOFU 条目不变")
            echo(strutil.Join([" cas_deleg client VALID ok (委托解析幂等, 二轮不变) delegate_channel=", dChanHex,
                               " epoch=", strings.Int64ToStr(rec.epoch)], ""))
        echo(" cas_deleg_client ok")
        return 0

    # ---- 负路径矩阵 (每条独立 rejectReason + 零污染) ----
    if expect == "deleg_miss":
        assertReject(port, storeRoot, logicalL, "应答方无该 channel 委托记录")
    elif expect == "cert_a_mismatch":
        assertReject(port, storeRoot, logicalL, "委托记录 A 不符请求 (cert.a≠L)")
    elif expect == "revoked":
        assertReject(port, storeRoot, logicalL, "delegate 已撤销 (先取撤销拒)")
    elif expect == "forged_cert":
        assertReject(port, storeRoot, logicalL, "cert 签发者非根钥 (伪造/子委托拒)")
    elif expect == "subdeleg":
        assertReject(port, storeRoot, logicalL, "cert 签发者非根钥 (伪造/子委托拒)")
    elif expect == "expired":
        assertReject(port, storeRoot, logicalL, "delegate head epoch 越 cert 有效期 (越权拒)")
    elif expect == "head_missing":
        assertReject(port, storeRoot, logicalL, "应答方无该 channel head")
    else:
        assert(false, " client: 未知 expect: " + expect)

    echo(strutil.Join([" cas_deleg client REJECT ok expect=", expect], ""))
    echo(" cas_deleg_client ok")
    return 0
