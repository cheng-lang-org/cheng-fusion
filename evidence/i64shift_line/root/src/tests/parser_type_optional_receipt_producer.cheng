import std/cmdline as cmdline
import std/result
import cheng/core/lang/parser as parser
import cheng/core/tooling/compiler_parser_receipt as receipt
import cheng/core/tooling/path as chengpath

fn main(argc: int32, argv: str*): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    assert(cmdline.ParamCount() == 5,
           "parser optional receipt producer: expected driver path, driver/source hashes and source path")
    let driverPath = cmdline.ParamStr(1)
    let driverSha256 = cmdline.ParamStr(2)
    let sourceSha256 = cmdline.ParamStr(3)
    let sourcePath = cmdline.ParamStr(4)
    let sourceText = chengpath.ReadTextFile("", sourcePath)
    assert(sourceText.len > 0,
           "parser optional receipt producer: source unavailable")
    var layer: parser.NormalizedExprLayer
    var err: str
    assert(parser.ParserReadNormalizedExprLayerFromText(
               sourcePath, sourceText, layer, err),
           Fmt"parser optional receipt producer: parse failed {err}")
    let root = "/Users/lbcheng/cheng-lang"
    let manifest = receipt.ParserSpanReceiptToolchainManifestBuild(
        driverPath, driverSha256, root, root)
    assert(IsOk(manifest),
           "parser optional receipt producer: manifest failed")
    let json = receipt.ParserSpanReceiptJsonBuild(
        layer,
        "src/tests/parser_type_optional_receipt_probe.cheng",
        sourcePath,
        sourceSha256,
        driverSha256,
        Value(manifest))
    assert(IsOk(json),
           "parser optional receipt producer: receipt failed")
    echo(Value(json))
    parser.NormalizedExprLayerReset(layer)
    return 0
