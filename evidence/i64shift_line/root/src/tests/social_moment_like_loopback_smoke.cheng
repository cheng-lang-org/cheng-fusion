# Real transmit proof: moment-like request frame + 1-byte ack over a real QUIC
# loopback connection (the same msquicTransportWrite -> pipeWrite ->
# msquicNativePipeWrite STREAM-frame path the device uses). Single-threaded: the
# client write and server serve interleave on one thread over the loopback pair.
#
# Proves the send service's wire protocol REALLY transmits bytes (not a stub):
# the client writes the multistream select + the request frame, the server reads
# them back over QUIC and writes the ack, the client reads the ack. If any byte
# failed to transmit/decrypt, the reads time out and the harness panics.

import std/system
import std/result
import std/os
import std/rawbytes
import std/strings as strings
import cheng/libp2p/core/types as types
import cheng/libp2p/core/multiaddr as multiaddr
import cheng/libp2p/transports/quic_transport as quic_transport
import cheng/core/runtime/web_scene_social_send as social

fn logLine(s: str) =
    os.WriteLine(os.Get_stdout(), s)

fn logInt(label: str, n: int32) =
    os.WriteLine(os.Get_stdout(), strings.ConcatStr(label, strings.IntToStr(n)))

fn main(): int32 =
    var listenAddr: types.Libp2pMultiaddr
    multiaddr.Libp2pMultiaddrFillQuic(listenAddr, "127.0.0.1", 0)
    var pair: quic_transport.Libp2pQuicLoopbackPair
    let openRes = quic_transport.Libp2pQuicLoopbackOpenInto(pair, listenAddr)
    if IsErr(openRes):
        panic(ErrorText(openRes))
    logLine("loopback open ok")

    # --- client: negotiate moment-like protocol (real select bytes out the socket) ---
    let protocol: int32 = types.Libp2pProtocolSocialMomentLike
    let selRes = quic_transport.Libp2pQuicLoopbackSelectProtocol(pair, protocol)
    if IsErr(selRes):
        panic(ErrorText(selRes))
    logLine("negotiate ok (real select transmitted + echoed)")

    # --- client: build + transmit the request frame (REAL bytes out) ---
    let frame = social.WebSceneSocialBuildLikeFrameExport("post-abc123", true)
    let frameLen: int32 = rawbytes.BytesLen(frame)
    let wRes = quic_transport.Libp2pQuicLoopbackWriteClient(pair, frame)
    if IsErr(wRes):
        panic(ErrorText(wRes))
    if Value(wRes) != frameLen:
        panic("short frame write")
    logInt("frame transmitted bytes=", Value(wRes))

    # --- server: read the frame back over QUIC, parse it, write the 1-byte ack ---
    let lenRes = quic_transport.Libp2pQuicLoopbackReadServer(pair, 4)
    if IsErr(lenRes):
        panic(ErrorText(lenRes))
    let lenBytes = Value(lenRes)
    let idLen: int32 = (rawbytes.BytesGet(lenBytes, 0) << 24) |
                       (rawbytes.BytesGet(lenBytes, 1) << 16) |
                       (rawbytes.BytesGet(lenBytes, 2) << 8) |
                       rawbytes.BytesGet(lenBytes, 3)
    let bodyRes = quic_transport.Libp2pQuicLoopbackReadServer(pair, idLen + 1)
    if IsErr(bodyRes):
        panic(ErrorText(bodyRes))
    let body = Value(bodyRes)
    let postId: str = rawbytes.BytesToString(rawbytes.BytesSlice(body, 0, idLen))
    let likeByte: int32 = rawbytes.BytesGet(body, idLen)
    logLine(strings.ConcatStr("server received postId=", postId))
    logInt("server received like=", likeByte)

    var ack = rawbytes.BytesAlloc(1)
    rawbytes.BytesSet(ack, 0, 1)
    let ackW = quic_transport.Libp2pQuicLoopbackWriteServer(pair, ack)
    if IsErr(ackW):
        panic(ErrorText(ackW))
    logLine("server ack transmitted")

    # --- client: read the real recv done-signal (the 1-byte ack) ---
    let ackRes = quic_transport.Libp2pQuicLoopbackReadClient(pair, 1)
    if IsErr(ackRes):
        panic(ErrorText(ackRes))
    let ackBytes = Value(ackRes)
    if rawbytes.BytesLen(ackBytes) < 1:
        panic("short ack read")
    logInt("client received ack byte=", rawbytes.BytesGet(ackBytes, 0))

    quic_transport.Libp2pQuicLoopbackClose(pair)
    if rawbytes.BytesGet(ackBytes, 0) == 1:
        logLine("MOMENT_LIKE_REAL_TRANSMIT_OK")
    else:
        logLine("MOMENT_LIKE_REJECTED")
    return 0
