import std/strutils as strutil
import std/os as os

fn main(): int32 =
    let fd4: int32 = os.UdpOpenSocket(2, 1, 0)
    puts(strutil.Join(["AF_INET stream fd=", IntToStr(fd4), " errno=", IntToStr(os.UdpErrno())], ""))
    if fd4 >= 0:
        let _ = os.UdpCloseFd(fd4)
    let fd6w: int32 = os.UdpOpenSocket(23, 1, 0)
    puts(strutil.Join(["AF_INET6(win=23) stream fd=", IntToStr(fd6w), " errno=", IntToStr(os.UdpErrno())], ""))
    if fd6w >= 0:
        let _ = os.UdpCloseFd(fd6w)
    let fd6l: int32 = os.UdpOpenSocket(10, 1, 0)
    puts(strutil.Join(["AF_INET6(linux=10) stream fd=", IntToStr(fd6l), " errno=", IntToStr(os.UdpErrno())], ""))
    if fd6l >= 0:
        let _ = os.UdpCloseFd(fd6l)
    return 0
