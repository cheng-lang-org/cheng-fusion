import std/os
import std/rawbytes as rawbytes
import std/result
import std/strformat
import cheng/core/tooling/compiler_execution_stage_receipt as execution_receipt
import cheng/core/tooling/compiler_execution_stage_receipt_wire as receiptwire
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256

fn OwnedBytesFromText(text: str): rawbytes.Bytes =
    var out = rawbytes.BytesAlloc(text.len)
    if text.len <= 0:
        return out
    assert(rawbytes.BytesLen(out) == text.len,
           " execution stage receipt smoke: bytes allocation")
    for index in 0..<text.len:
        rawbytes.BytesSet(out, index, Int32(text[index]) & 255)
    return out

fn ObservedRaw32(text: str): layout.FixedBytes32 =
    var observed = OwnedBytesFromText(text)
    defer:
        rawbytes.BytesFree(observed)
    let result = execution_receipt.CompilerExecutionIdentityObservedRaw32(observed)
    assert(IsOk(result), " execution stage receipt smoke: observed hash")
    return Value(result)

fn EmptyRaw32(): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(0)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn MakeIdentity(caseId: str): execution_receipt.CompilerExecutionIdentity =
    let result = execution_receipt.CompilerExecutionIdentityMake(
        caseId,
        ObservedRaw32(Fmt"source:{caseId}"),
        ObservedRaw32("materializer:bounded-matrix"),
        ObservedRaw32("grammar-obligation-root:966"),
        ObservedRaw32("compiler-source-closure:typed-csg-lowering-backends-regalloc"),
        ObservedRaw32("driver:exact-observed-bytes"),
        ObservedRaw32("toolchain:exact-manifest-bytes"),
        ObservedRaw32("command:argv-env-target-limits"),
        "arm64-apple-darwin")
    assert(IsOk(result), " execution stage receipt smoke: identity")
    return Value(result)

fn MakeStage(
        identity: execution_receipt.CompilerExecutionIdentity,
        stageKind: str,
        laneKind: str,
        predecessorStageKind: str,
        predecessorReceiptRaw32: layout.FixedBytes32,
        inputSemanticRaw32: layout.FixedBytes32,
        sidecarText: str,
        artifactText: str): Result[execution_receipt.ExecutionStageReceipt] =
    var producerSourceBytes = OwnedBytesFromText(
        Fmt"producer-source:{stageKind}")
    defer:
        rawbytes.BytesFree(producerSourceBytes)
    var sidecarBytes = OwnedBytesFromText(sidecarText)
    defer:
        rawbytes.BytesFree(sidecarBytes)
    var artifactBytes = OwnedBytesFromText(artifactText)
    defer:
        rawbytes.BytesFree(artifactBytes)
    return execution_receipt.ExecutionStageReceiptMakeObserved(
        identity,
        stageKind,
        laneKind,
        producerSourceBytes,
        predecessorStageKind,
        predecessorReceiptRaw32,
        inputSemanticRaw32,
        Fmt"artifacts/execution/{stageKind}.semantic.bin",
        sidecarBytes,
        Fmt"artifacts/execution/{stageKind}.artifact.bin",
        artifactBytes)

fn VerifyObservedTexts(
        receipt: execution_receipt.ExecutionStageReceipt,
        identity: execution_receipt.CompilerExecutionIdentity,
        expectedPredecessorRaw32: layout.FixedBytes32,
        sidecarText: str,
        artifactText: str): Result[bool] =
    var producerSourceBytes = OwnedBytesFromText(
        Fmt"producer-source:{receipt.stageKind}")
    defer:
        rawbytes.BytesFree(producerSourceBytes)
    var sidecarBytes = OwnedBytesFromText(sidecarText)
    defer:
        rawbytes.BytesFree(sidecarBytes)
    var artifactBytes = OwnedBytesFromText(artifactText)
    defer:
        rawbytes.BytesFree(artifactBytes)
    return execution_receipt.ExecutionStageReceiptVerifyObserved(
        receipt,
        identity,
        expectedPredecessorRaw32,
        producerSourceBytes,
        sidecarBytes,
        artifactBytes)

fn ObserveTexts(
        validator: var execution_receipt.CompilerSevenStageReceiptValidator,
        identity: execution_receipt.CompilerExecutionIdentity,
        receipt: execution_receipt.ExecutionStageReceipt,
        sidecarText: str,
        artifactText: str): Result[bool] =
    var producerSourceBytes = OwnedBytesFromText(
        Fmt"producer-source:{receipt.stageKind}")
    defer:
        rawbytes.BytesFree(producerSourceBytes)
    var sidecarBytes = OwnedBytesFromText(sidecarText)
    defer:
        rawbytes.BytesFree(sidecarBytes)
    var artifactBytes = OwnedBytesFromText(artifactText)
    defer:
        rawbytes.BytesFree(artifactBytes)
    return execution_receipt.CompilerSevenStageReceiptValidatorObserve(
        validator,
        identity,
        receipt,
        producerSourceBytes,
        sidecarBytes,
        artifactBytes)

fn BuildSeven(
        identity: execution_receipt.CompilerExecutionIdentity,
        parserReceiptRaw32: layout.FixedBytes32,
        parserSemanticRaw32: layout.FixedBytes32,
        receipts: var execution_receipt.ExecutionStageReceipt[],
        sidecars: var str[],
        artifacts: var str[]) =
    add(sidecars, "typed-expr-sidecar:exact-int32-identities")
    add(artifacts, "typed-expr-fact-table:exact-bytes")
    let typedResult = MakeStage(
        identity,
        execution_receipt.ExecutionStageReceiptStageTypedExpr,
        execution_receipt.ExecutionStageReceiptLaneShared,
        execution_receipt.ExecutionStageReceiptStageParser,
        parserReceiptRaw32,
        parserSemanticRaw32,
        sidecars[0],
        artifacts[0])
    assert(IsOk(typedResult), " execution stage receipt smoke: typed")
    add(receipts, Value(typedResult))

    add(sidecars, "csg-sidecar:exact-node-decl-value-def")
    add(artifacts, "csg-facts:exact-bytes")
    let csgResult = MakeStage(
        identity,
        execution_receipt.ExecutionStageReceiptStageCsg,
        execution_receipt.ExecutionStageReceiptLaneShared,
        execution_receipt.ExecutionStageReceiptStageTypedExpr,
        receipts[0].receiptRaw32,
        receipts[0].outputSemanticRaw32,
        sidecars[1],
        artifacts[1])
    assert(IsOk(csgResult), " execution stage receipt smoke: csg")
    add(receipts, Value(csgResult))

    add(sidecars, "lowering-sidecar:body-ir-use-def-alias")
    add(artifacts, "lowering-body-ir:exact-bytes")
    let loweringResult = MakeStage(
        identity,
        execution_receipt.ExecutionStageReceiptStageLowering,
        execution_receipt.ExecutionStageReceiptLaneShared,
        execution_receipt.ExecutionStageReceiptStageCsg,
        receipts[1].receiptRaw32,
        receipts[1].outputSemanticRaw32,
        sidecars[2],
        artifacts[2])
    assert(IsOk(loweringResult), " execution stage receipt smoke: lowering")
    add(receipts, Value(loweringResult))

    add(sidecars, "primary-sidecar:emission-action-ledger")
    add(artifacts, "primary-emission-ledger:exact-bytes")
    let primaryResult = MakeStage(
        identity,
        execution_receipt.ExecutionStageReceiptStagePrimary,
        execution_receipt.ExecutionStageReceiptLanePrimary,
        execution_receipt.ExecutionStageReceiptStageLowering,
        receipts[2].receiptRaw32,
        receipts[2].outputSemanticRaw32,
        sidecars[3],
        artifacts[3])
    assert(IsOk(primaryResult), " execution stage receipt smoke: primary")
    add(receipts, Value(primaryResult))

    add(sidecars, "primary-regalloc-sidecar:plan-action-fragment-symbol")
    add(artifacts, "primary-regalloc-object-ranges:exact-bytes")
    let primaryRegallocResult = MakeStage(
        identity,
        execution_receipt.ExecutionStageReceiptStagePrimaryRegalloc,
        execution_receipt.ExecutionStageReceiptLanePrimary,
        execution_receipt.ExecutionStageReceiptStagePrimary,
        receipts[3].receiptRaw32,
        receipts[3].outputSemanticRaw32,
        sidecars[4],
        artifacts[4])
    assert(IsOk(primaryRegallocResult),
           " execution stage receipt smoke: primary regalloc")
    add(receipts, Value(primaryRegallocResult))

    add(sidecars, "backend2-sidecar:emission-action-ledger")
    add(artifacts, "backend2-emission-ledger:exact-bytes")
    let backend2Result = MakeStage(
        identity,
        execution_receipt.ExecutionStageReceiptStageBackend2,
        execution_receipt.ExecutionStageReceiptLaneBackend2,
        execution_receipt.ExecutionStageReceiptStageLowering,
        receipts[2].receiptRaw32,
        receipts[2].outputSemanticRaw32,
        sidecars[5],
        artifacts[5])
    assert(IsOk(backend2Result), " execution stage receipt smoke: backend2")
    add(receipts, Value(backend2Result))

    add(sidecars, "backend2-regalloc-sidecar:plan-action-fragment-symbol")
    add(artifacts, "backend2-regalloc-object-ranges:exact-bytes")
    let backend2RegallocResult = MakeStage(
        identity,
        execution_receipt.ExecutionStageReceiptStageBackend2Regalloc,
        execution_receipt.ExecutionStageReceiptLaneBackend2,
        execution_receipt.ExecutionStageReceiptStageBackend2,
        receipts[5].receiptRaw32,
        receipts[5].outputSemanticRaw32,
        sidecars[6],
        artifacts[6])
    assert(IsOk(backend2RegallocResult),
           " execution stage receipt smoke: backend2 regalloc")
    add(receipts, Value(backend2RegallocResult))

fn ObserveSeven(
        identity: execution_receipt.CompilerExecutionIdentity,
        parserReceiptRaw32: layout.FixedBytes32,
        parserSemanticRaw32: layout.FixedBytes32,
        receipts: execution_receipt.ExecutionStageReceipt[],
        sidecars: str[],
        artifacts: str[]): Result[layout.FixedBytes32] =
    let initResult = execution_receipt.CompilerSevenStageReceiptValidatorInit(
        identity, parserReceiptRaw32, parserSemanticRaw32)
    if IsErr(initResult):
        return Err[layout.FixedBytes32](Error(initResult))
    var validator = Value(initResult)
    for index in 0..<receipts.len:
        let observeResult = ObserveTexts(validator,
                                         identity,
                                         receipts[index],
                                         sidecars[index],
                                         artifacts[index])
        if IsErr(observeResult):
            return Err[layout.FixedBytes32](Error(observeResult))
    return execution_receipt.CompilerSevenStageReceiptValidatorFinalize(validator)

fn main(): int32 =
    let identity = MakeIdentity("bounded.case.0001")
    assert(IsOk(execution_receipt.CompilerExecutionIdentityVerify(identity)),
           " execution stage receipt smoke: identity verify")
    let parserReceipt = ObservedRaw32("parser-receipt:exact-trace")
    let parserSemantic = ObservedRaw32("parser-semantic-root:exact-trace")
    var receipts: execution_receipt.ExecutionStageReceipt[]
    var sidecars: str[]
    var artifacts: str[]
    BuildSeven(identity,
               parserReceipt,
               parserSemantic,
               receipts,
               sidecars,
               artifacts)
    assert(receipts.len == 7 && sidecars.len == 7 && artifacts.len == 7,
           " execution stage receipt smoke: seven stages")
    assert(layout.FixedBytes32Equal(receipts[0].outputSemanticRaw32,
                                    ObservedRaw32(sidecars[0])),
           " execution stage receipt smoke: semantic root is sidecar hash")

    let rootAResult = ObserveSeven(identity,
                                   parserReceipt,
                                   parserSemantic,
                                   receipts,
                                   sidecars,
                                   artifacts)
    let rootBResult = ObserveSeven(identity,
                                   parserReceipt,
                                   parserSemantic,
                                   receipts,
                                   sidecars,
                                   artifacts)
    assert(IsOk(rootAResult) && IsOk(rootBResult),
           " execution stage receipt smoke: complete observed chain")
    assert(layout.FixedBytes32Equal(Value(rootAResult), Value(rootBResult)),
           " execution stage receipt smoke: deterministic root")

    let observedPaths = receiptwire.CompilerExecutionObservedPathsMake(
        "evidence/identity/source-bundle.bin",
        "evidence/identity/materializer.bin",
        "evidence/identity/grammar-obligation.bin",
        "evidence/identity/compiler-source-closure.bin",
        "evidence/identity/driver.bin",
        "evidence/identity/toolchain-manifest.bin",
        "evidence/identity/command-manifest.bin")
    var producerSourcePaths = [
        "evidence/producers/typed-expr.cheng",
        "evidence/producers/compiler-csg.cheng",
        "evidence/producers/lowering-plan.cheng",
        "evidence/producers/primary-object-plan.cheng",
        "evidence/producers/primary-regalloc.cheng",
        "evidence/producers/backend2-pipeline.cheng",
        "evidence/producers/backend2-regalloc.cheng"]
    let wireAResult = receiptwire.CompilerExecutionStageBundleCanonicalJson(
        identity,
        observedPaths,
        parserReceipt,
        parserSemantic,
        receipts,
        producerSourcePaths,
        Value(rootAResult))
    let wireBResult = receiptwire.CompilerExecutionStageBundleCanonicalJson(
        identity,
        observedPaths,
        parserReceipt,
        parserSemantic,
        receipts,
        producerSourcePaths,
        Value(rootAResult))
    assert(IsOk(wireAResult) && IsOk(wireBResult),
           " execution stage receipt smoke: canonical wire")
    let wireA = Value(wireAResult)
    let wireB = Value(wireBResult)
    assert(wireA == wireB,
           " execution stage receipt smoke: canonical wire deterministic")
    assert(wireA.len > 1 && wireA[wireA.len - 1] == '\n' &&
           wireA[wireA.len - 2] != '\n',
           " execution stage receipt smoke: exactly one trailing LF")
    let wireRaw32 = ObservedRaw32(wireA)

    let traversalPaths = receiptwire.CompilerExecutionObservedPathsMake(
        "evidence/identity/source-bundle.bin",
        "evidence/identity/materializer.bin",
        "evidence/identity/grammar-obligation.bin",
        "evidence/identity/compiler-source-closure.bin",
        "../driver.bin",
        "evidence/identity/toolchain-manifest.bin",
        "evidence/identity/command-manifest.bin")
    assert(IsErr(receiptwire.CompilerExecutionStageBundleCanonicalJson(
                     identity,
                     traversalPaths,
                     parserReceipt,
                     parserSemantic,
                     receipts,
                     producerSourcePaths,
                     Value(rootAResult))),
           " execution stage receipt smoke: identity traversal survived")
    var traversalProducerPaths = [
        "evidence/producers/typed-expr.cheng",
        "evidence/producers/compiler-csg.cheng",
        "evidence/producers/lowering-plan.cheng",
        "evidence/producers/primary-object-plan.cheng",
        "evidence/producers/primary-regalloc.cheng",
        "evidence/producers/backend2-pipeline.cheng",
        "evidence/producers/backend2-regalloc.cheng"]
    traversalProducerPaths[3] = "evidence/producers/../primary.cheng"
    assert(IsErr(receiptwire.CompilerExecutionStageBundleCanonicalJson(
                     identity,
                     observedPaths,
                     parserReceipt,
                     parserSemantic,
                     receipts,
                     traversalProducerPaths,
                     Value(rootAResult))),
           " execution stage receipt smoke: producer traversal survived")
    assert(IsErr(receiptwire.CompilerExecutionStageBundleCanonicalJson(
                     identity,
                     observedPaths,
                     parserReceipt,
                     parserSemantic,
                     receipts,
                     producerSourcePaths,
                     parserSemantic)),
           " execution stage receipt smoke: wrong seven-stage root survived")

    var duplicateEvidenceReceipts: execution_receipt.ExecutionStageReceipt[]
    setLen(duplicateEvidenceReceipts, receipts.len)
    for index in 0..<receipts.len:
        duplicateEvidenceReceipts[index] = receipts[index]
    var duplicateProducerSource = OwnedBytesFromText(
        "producer-source:backend2_regalloc")
    defer:
        rawbytes.BytesFree(duplicateProducerSource)
    var duplicateSidecar = OwnedBytesFromText(sidecars[6])
    defer:
        rawbytes.BytesFree(duplicateSidecar)
    var duplicateArtifact = OwnedBytesFromText(artifacts[6])
    defer:
        rawbytes.BytesFree(duplicateArtifact)
    let duplicateLastResult = execution_receipt.ExecutionStageReceiptMakeObserved(
        identity,
        execution_receipt.ExecutionStageReceiptStageBackend2Regalloc,
        execution_receipt.ExecutionStageReceiptLaneBackend2,
        duplicateProducerSource,
        execution_receipt.ExecutionStageReceiptStageBackend2,
        receipts[5].receiptRaw32,
        receipts[5].outputSemanticRaw32,
        receipts[0].sidecarPath,
        duplicateSidecar,
        receipts[6].artifactPath,
        duplicateArtifact)
    assert(IsOk(duplicateLastResult),
           " execution stage receipt smoke: duplicate path fixture")
    duplicateEvidenceReceipts[6] = Value(duplicateLastResult)
    let duplicateRootResult =
        execution_receipt.CompilerSevenStageReceiptValidateStructure(
            identity,
            parserReceipt,
            parserSemantic,
            duplicateEvidenceReceipts)
    assert(IsOk(duplicateRootResult),
           " execution stage receipt smoke: duplicate path structure")
    assert(IsErr(receiptwire.CompilerExecutionStageBundleCanonicalJson(
                     identity,
                     observedPaths,
                     parserReceipt,
                     parserSemantic,
                     duplicateEvidenceReceipts,
                     producerSourcePaths,
                     Value(duplicateRootResult))),
           " execution stage receipt smoke: cross-stage evidence alias survived")

    assert(IsErr(VerifyObservedTexts(
                     receipts[0],
                     identity,
                     parserReceipt,
                     "typed-expr-sidecar:tampered",
                     artifacts[0])),
           " execution stage receipt smoke: sidecar mutation survived")
    assert(IsErr(VerifyObservedTexts(
                     receipts[0],
                     identity,
                     parserReceipt,
                     sidecars[0],
                     "typed-expr-artifact:tampered")),
           " execution stage receipt smoke: artifact mutation survived")
    var wrongProducerSource = OwnedBytesFromText(
        "producer-source:tampered")
    defer:
        rawbytes.BytesFree(wrongProducerSource)
    var observedSidecar = OwnedBytesFromText(sidecars[0])
    defer:
        rawbytes.BytesFree(observedSidecar)
    var observedArtifact = OwnedBytesFromText(artifacts[0])
    defer:
        rawbytes.BytesFree(observedArtifact)
    assert(IsErr(execution_receipt.ExecutionStageReceiptVerifyObserved(
                     receipts[0],
                     identity,
                     parserReceipt,
                     wrongProducerSource,
                     observedSidecar,
                     observedArtifact)),
           " execution stage receipt smoke: producer mutation survived")

    var selfMutated = receipts[0]
    selfMutated.outputSemanticRaw32 = ObservedRaw32("mutated-output")
    assert(IsErr(execution_receipt.ExecutionStageReceiptVerify(selfMutated)),
           " execution stage receipt smoke: self mutation survived")
    var schemaMutated = receipts[0]
    schemaMutated.sidecarSchema = "cheng.compiler.stage_semantic_sidecar.fake"
    assert(IsErr(execution_receipt.ExecutionStageReceiptVerify(schemaMutated)),
           " execution stage receipt smoke: schema mutation survived")

    let initMissingResult =
        execution_receipt.CompilerSevenStageReceiptValidatorInit(
            identity, parserReceipt, parserSemantic)
    assert(IsOk(initMissingResult),
           " execution stage receipt smoke: missing init")
    var missingValidator = Value(initMissingResult)
    for index in 0..<6:
        let observeResult = ObserveTexts(missingValidator,
                                         identity,
                                         receipts[index],
                                         sidecars[index],
                                         artifacts[index])
        assert(IsOk(observeResult),
               " execution stage receipt smoke: missing prefix")
    assert(IsErr(execution_receipt.CompilerSevenStageReceiptValidatorFinalize(
                     missingValidator)),
           " execution stage receipt smoke: missing stage survived")

    let initReorderResult =
        execution_receipt.CompilerSevenStageReceiptValidatorInit(
            identity, parserReceipt, parserSemantic)
    assert(IsOk(initReorderResult),
           " execution stage receipt smoke: reorder init")
    var reorderValidator = Value(initReorderResult)
    assert(IsErr(ObserveTexts(reorderValidator,
                              identity,
                              receipts[1],
                              sidecars[1],
                              artifacts[1])),
           " execution stage receipt smoke: reorder survived")

    let wrongBackend2Result = MakeStage(
        identity,
        execution_receipt.ExecutionStageReceiptStageBackend2,
        execution_receipt.ExecutionStageReceiptLaneBackend2,
        execution_receipt.ExecutionStageReceiptStageLowering,
        receipts[4].receiptRaw32,
        receipts[4].outputSemanticRaw32,
        sidecars[5],
        artifacts[5])
    assert(IsOk(wrongBackend2Result),
           " execution stage receipt smoke: wrong branch fixture")
    var wrongReceipts: execution_receipt.ExecutionStageReceipt[]
    setLen(wrongReceipts, receipts.len)
    for index in 0..<receipts.len:
        wrongReceipts[index] = receipts[index]
    wrongReceipts[5] = Value(wrongBackend2Result)
    assert(IsErr(ObserveSeven(identity,
                              parserReceipt,
                              parserSemantic,
                              wrongReceipts,
                              sidecars,
                              artifacts)),
           " execution stage receipt smoke: wrong branch survived")

    var traversalSidecar = OwnedBytesFromText(sidecars[0])
    defer:
        rawbytes.BytesFree(traversalSidecar)
    var traversalArtifact = OwnedBytesFromText(artifacts[0])
    defer:
        rawbytes.BytesFree(traversalArtifact)
    var traversalProducerSource = OwnedBytesFromText(
        "producer-source:typed_expr")
    defer:
        rawbytes.BytesFree(traversalProducerSource)
    let traversalResult = execution_receipt.ExecutionStageReceiptMakeObserved(
        identity,
        execution_receipt.ExecutionStageReceiptStageTypedExpr,
        execution_receipt.ExecutionStageReceiptLaneShared,
        traversalProducerSource,
        execution_receipt.ExecutionStageReceiptStageParser,
        parserReceipt,
        parserSemantic,
        "../typed.sidecar",
        traversalSidecar,
        "artifacts/typed.artifact",
        traversalArtifact)
    assert(IsErr(traversalResult),
           " execution stage receipt smoke: traversal path survived")

    let emptyIdentityResult = execution_receipt.CompilerExecutionIdentityMake(
        "bounded.case.empty",
        layout.FixedBytes32(),
        EmptyRaw32(),
        ObservedRaw32("grammar"),
        ObservedRaw32("closure"),
        ObservedRaw32("driver"),
        ObservedRaw32("toolchain"),
        ObservedRaw32("command"),
        "arm64-apple-darwin")
    assert(IsErr(emptyIdentityResult),
           " execution stage receipt smoke: placeholder identity survived")

    let otherIdentity = MakeIdentity("bounded.case.0002")
    assert(IsErr(VerifyObservedTexts(receipts[0],
                                     otherIdentity,
                                     parserReceipt,
                                     sidecars[0],
                                     artifacts[0])),
           " execution stage receipt smoke: execution drift survived")

    os.WriteLine(os.GetStdout(),
                 Fmt"COMPILER_EXECUTION_STAGE_RECEIPT_WIRE_RAW32={layout.FixedBytes32Hex(wireRaw32)}")
    os.WriteLine(os.GetStdout(), "COMPILER_EXECUTION_STAGE_RECEIPT_OK")
    return 0
