import std/os
import cheng/core/lang/parser

fn main() =
    let source =
        "fn ExportedAdd(left: int32,\r\n                   right: int32): int32 =\r\n    return left + right\r\n"
    var declarations: parser.NormalizedFunctionDecl[]
    var err = ""
    assert(parser.ParserReadNormalizedFunctionDecls(
               source,
               declarations,
               err), err)
    assert(declarations.len == 1,
           "parser multiline declaration: declaration count")
    let declaration = declarations[0]
    assert(declaration.name == "ExportedAdd" &&
           declaration.lineIndex == 1 &&
           declaration.signatureStartColumn == 0 &&
           declaration.signatureEndLineIndex == 2 &&
           declaration.signatureEndColumn == 41 &&
           declaration.nameStartColumn == 3 &&
           declaration.nameEndColumn == 14 &&
           declaration.bodyStartLineIndex == 2 &&
           declaration.bodyStartColumn == 41,
           Fmt"parser multiline declaration: exact signature/body coordinates line={declaration.lineIndex} sig_start={declaration.signatureStartColumn} sig_end_line={declaration.signatureEndLineIndex} sig_end={declaration.signatureEndColumn} name_start={declaration.nameStartColumn} name_end={declaration.nameEndColumn} body_line={declaration.bodyStartLineIndex} body={declaration.bodyStartColumn}")
    os.WriteLine(os.Get_stdout(),
                 "parser_multiline_function_decl_smoke: ok")
