import std/strutils as strutil
import cheng/core/backend/primary_object_plan as pobj
import cheng/core/ir/body_ir_egraph as egraph
import cheng/core/ir/core_types as ir
import cheng/core/lang/typed_expr as texpr

fn appendI32Add(bodyIR: var ir.BodyIR,
                 target: int32,
                 lhs: int32,
                 rhs: int32) =
    var op: ir.BodyOp
    op.kind = ir.BodyOpBinOpTag
    op.target = target
    add(op.operands, ir.LocalI32Tag)
    add(op.operands, int32(texpr.TypedExprIrOpI32Add))
    add(op.operands, lhs)
    add(op.operands, rhs)
    add(bodyIR.ops, op)

@borrows
fn collectEGraphSnapshotText(bodyIR: ir.BodyIR): str =
    var rows: str[]
    for opIndex in 0..<bodyIR.ops.len:
        let op = bodyIR.ops[opIndex]
        let count = op.operands.len
        var op0: int32
        var op1: int32
        var op2: int32
        var op3: int32
        var op4: int32
        var op5: int32
        var op6: int32
        var op7: int32
        if count >= 1:
            op0 = op.operands[0]
        if count >= 2:
            op1 = op.operands[1]
        if count >= 3:
            op2 = op.operands[2]
        if count >= 4:
            op3 = op.operands[3]
        if count >= 5:
            op4 = op.operands[4]
        if count >= 6:
            op5 = op.operands[5]
        if count >= 7:
            op6 = op.operands[6]
        if count >= 8:
            op7 = op.operands[7]
        add(rows, Fmt"{op.kind},{op.target},{count},{op0},{op1},{op2},{op3},{op4},{op5},{op6},{op7};")
    return strutil.Join(rows, "")

fn buildEGraphCandidateBody(): ir.BodyIR =
    var bodyIR = ir.BodyIRNew()
    var slotNames: str[]
    let value = pobj.PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                     slotNames,
                                                     "value",
                                                     ir.LocalI32Tag,
                                                     41)
    let zero = pobj.PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                    slotNames,
                                                    "zero",
                                                    ir.LocalI32Tag,
                                                    0)
    let sum = pobj.PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                 slotNames,
                                                 "sum",
                                                 ir.LocalI32Tag)
    appendI32Add(bodyIR, sum, value, zero)
    var term: ir.BodyTerm
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = sum
    let termIndex = ir.BodyIRAppendTerm(bodyIR, term)
    let _ = ir.BodyIRAppendBlock(bodyIR, 0, 3, termIndex)
    return bodyIR

fn main(): int32 =
    var bodyIR = buildEGraphCandidateBody()
    let snapshotText = collectEGraphSnapshotText(bodyIR)
    var snapshots: egraph.EGraphOpSnapshot[]
    if !egraph.EGraphParseSnapshotText(snapshotText, snapshots):
        return 61
    var flat: ir.BodyIRFlatSoA
    var ok: bool
    egraph.EGraphBodyWithOpSnapshots(bodyIR, snapshots, flat, ok)
    if !ok:
        return 62
    var report: egraph.EGraphRunReport
    egraph.BodyIrEgraphPassWithFlat(bodyIR, flat, report)
    return 77
