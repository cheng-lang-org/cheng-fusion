type BorrowCounter = ref object
    value: int32
    nestedValues: int32[]

type BorrowHolder = ref object
    counter: BorrowCounter
    values: int32[]

type BorrowValueCounter =
    value: int32

type BorrowValueHolder =
    counter: BorrowValueCounter

fn BorrowCounterBump(counter: var BorrowCounter) =
    counter.value = counter.value + 1

fn BorrowValuesAppend(values: var int32[]) =
    add(values, 41)

fn BorrowValueCounterBump(counter: var BorrowValueCounter) =
    counter.value = counter.value + 1

fn BorrowHolderMutateThroughVar(holder: var BorrowHolder) =
    BorrowCounterBump(holder.counter)
    BorrowValuesAppend(holder.values)

fn BorrowCounterReplaceThenWrite(counter: var BorrowCounter) =
    counter = new(BorrowCounter)
    counter.value = 73

fn BorrowOverload(value: int32): int32 =
    return value

fn BorrowOverload(counter: var BorrowCounter): int32 =
    BorrowCounterBump(counter)
    return counter.value

fn main(): int32 =
    var counter: BorrowCounter = new(BorrowCounter)
    var replaced: BorrowCounter = new(BorrowCounter)
    var holder: BorrowHolder = new(BorrowHolder)
    var valueHolder = BorrowValueHolder()
    BorrowCounterReplaceThenWrite(replaced)
    assert(replaced.value == 73,
           "cold var-ref implicit borrow: replace then field write")
    holder.counter = counter
    BorrowCounterBump(holder.counter)
    BorrowValuesAppend(holder.values)
    BorrowValuesAppend(holder.counter.nestedValues)
    BorrowHolderMutateThroughVar(holder)
    BorrowValueCounterBump(valueHolder.counter)
    assert(BorrowOverload(holder.counter) == 3 &&
           BorrowOverload(19) == 19 &&
           holder.counter.value == 3,
           "cold var-ref implicit borrow: ref field mutation")
    assert(valueHolder.counter.value == 1,
           "cold var-ref implicit borrow: value-object field mutation")
    assert(holder.values.len == 2 &&
           holder.values[0] == 41 &&
           holder.values[1] == 41,
           "cold var-ref implicit borrow: sequence field mutation")
    assert(holder.counter.nestedValues.len == 1 &&
           holder.counter.nestedValues[0] == 41,
           "cold var-ref implicit borrow: nested ref field mutation")
    echo("cold_var_ref_implicit_borrow_smoke: ok")
    return 0
