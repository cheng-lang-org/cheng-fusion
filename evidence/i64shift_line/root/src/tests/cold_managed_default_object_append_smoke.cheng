import std/strings

type
    ColdManagedDefaultObjectAppendEntry =
        name: str
        ordinal: int32

@borrows
fn coldManagedDefaultObjectAppendOwn(
        source: ColdManagedDefaultObjectAppendEntry): ColdManagedDefaultObjectAppendEntry =
    var out: ColdManagedDefaultObjectAppendEntry
    out.name = strings.CloneStr(source.name)
    out.ordinal = source.ordinal
    return out

fn coldManagedDefaultObjectAppendBuild(
        source: ColdManagedDefaultObjectAppendEntry[]): ColdManagedDefaultObjectAppendEntry[] =
    var out: ColdManagedDefaultObjectAppendEntry[]
    for index in 0..<source.len:
        let candidate = coldManagedDefaultObjectAppendOwn(source[index])
        var empty: ColdManagedDefaultObjectAppendEntry
        add(out, empty)
        out[out.len - 1] = candidate
    return out

fn main(): int32 =
    var source: ColdManagedDefaultObjectAppendEntry[]
    var entry: ColdManagedDefaultObjectAppendEntry
    entry.name = "stable"
    entry.ordinal = 7
    add(source, entry)
    let out = coldManagedDefaultObjectAppendBuild(source)
    if out.len != 1 || out[0].name != "stable" || out[0].ordinal != 7:
        return 1
    return 0
