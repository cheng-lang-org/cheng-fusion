type
    ColorKind = enum
        ColorRed
        ColorGreen
        ColorBlue

fn ColorScore(kind: ColorKind): int32 =
    if kind == ColorGreen:
        return 7
    elif kind == ColorBlue:
        return 9
    return 1

fn Promote(kind: var ColorKind): int32 =
    if kind == ColorRed:
        kind = ColorGreen
        return 1
    return 0

fn main(): int32 =
    if ColorScore(ColorGreen) != 7:
        return 1
    if ColorScore(ColorBlue) != 9:
        return 2
    if ColorScore(ColorRed) != 1:
        return 3
    var k = ColorRed
    if Promote(k) != 1:
        return 4
    if k != ColorGreen:
        return 5
    return 0
