# slice-3a probe: Noise_XX_25519_ChaChaPoly_SHA256 handshake state machine
# (src/std/crypto/noise_xx.cheng), fully in-process, no IO.
#
# Verification tier actually run here (降级口径, 如实标注): this agent did not
# request/receive user approval for an outbound WebFetch to pull official
# cacophony/snow Noise_XX_25519_ChaChaPoly_SHA256 test vectors, so this is
# NOT a pass against the official third-party vector suite. What was
# actually verified, with fixed (non-random) key material so every run is
# bit-exact reproducible:
#   1. Full 3-message XX handshake between an initiator and responder built
#      from independently-fixed static/ephemeral private keys converges to
#      the same handshake hash on both sides and Split() yields matching,
#      non-zero, distinct transport keys on both sides (round-trip proof).
#   2. Mutation-negative tests: flipping one byte of the responder's
#      ephemeral-DH field or the AEAD-encrypted static-key field inside
#      message2, or of the initiator's AEAD-encrypted static-key field inside
#      message3, must make the peer's Read call return Err -- proving the
#      AEAD tag (and the DH-derived key it depends on) actually binds
#      identity instead of being decorative.
#   3. Cross-checked against an independent second implementation of the
#      same spec, hand-written in Python against the `cryptography` package
#      (not this file's code, not std/crypto/*, no network access) at
#      scratchpad/noise/noise_xx_oracle.py: with the same 4 fixed keys it
#      reproduces handshake_hash/transport_c1/transport_c2 byte-for-byte.
#      This is a same-spec independent-implementation cross-check, not a
#      third-party golden vector -- both implementations could in principle
#      share a misreading of the spec.
# X25519 itself is covered independently by curve25519_vector_probe.cheng
# (RFC 7748 vectors) and the AEAD by chacha20poly1305_rfc8439_smoke.cheng
# (RFC 8439 vectors); this probe only exercises their composition inside the
# Noise state machine.

import std/system
import std/result
import std/rawbytes
import std/crypto/curve25519
import std/crypto/noise_xx as noise
import std/strutils as strutil

const
    # Fixed (non-random) 32-byte private keys, SHA256("noise-xx-slice3a-<role>")
    # so every run is bit-exact reproducible. Not secret, test fixtures only.
    initiatorStaticPrivHex = "096a8e4756e87d430409cee708f6fa95ed2b476cb92965d01473cbf071cd6f99"
    responderStaticPrivHex = "925a9ef4b2615bd545266f8bbc3929d95921ceeebdb37925bd218ecb9a610d7e"
    initiatorEphemeralPrivHex = "a52d698991fa659762cc8d299d3d4e0140d5a254d97ee8b80a945870d44d4d78"
    responderEphemeralPrivHex = "feaaffa32dda91a058acba4e24a3cc79c3b8b17f89e9281bb459cade4203dc7d"

fn keyPairFromHex(privHex: str): curve25519.Curve25519KeyPair =
    let priv: Bytes = BytesFromHex(privHex)
    let pubRes: Result[Bytes] = curve25519.curve25519PublicFromPrivate(priv)
    assert(IsOk(pubRes), "probe: derive public key")
    # Field-assignment instead of curve25519.initCurve25519KeyPair(...): the
    # cross-module qualified call to that helper (a bare named-field struct
    # literal as its whole body) trips a cheng_cold parser edge case
    # ("reachable function body missing" + "non-void function block
    # unterminated") isolated with a minimal repro during this slice; same
    # struct/fields/values, this form just avoids the trigger.
    var kp: curve25519.Curve25519KeyPair
    kp.priv = priv
    kp.pub = Value(pubRes)
    return kp

fn buildInitiator(): noise.HandshakeState =
    var hs: noise.HandshakeState = noise.noiseHandshakeInit(keyPairFromHex(initiatorStaticPrivHex), EmptyBytes())
    noise.noiseHandshakeSetEphemeral(hs, keyPairFromHex(initiatorEphemeralPrivHex))
    return hs

fn buildResponder(): noise.HandshakeState =
    var hs: noise.HandshakeState = noise.noiseHandshakeInit(keyPairFromHex(responderStaticPrivHex), EmptyBytes())
    noise.noiseHandshakeSetEphemeral(hs, keyPairFromHex(responderEphemeralPrivHex))
    return hs

fn flippedCopy(data: Bytes, idx: int32): Bytes =
    var out: Bytes = BytesSlice(data, 0, BytesLen(data))
    BytesSet(out, idx, BytesGet(out, idx) ^ 1)
    return out

fn main(): int32 =
    # --- 1. full handshake round trip -------------------------------------
    var initiator: noise.HandshakeState = buildInitiator()
    var responder: noise.HandshakeState = buildResponder()

    let msg1Res: Result[Bytes] = noise.noiseWriteMessage1(initiator, EmptyBytes())
    assert(IsOk(msg1Res), "probe: WriteMessage1")
    let msg1: Bytes = Value(msg1Res)
    let read1Res: Result[Bytes] = noise.noiseReadMessage1(responder, msg1)
    assert(IsOk(read1Res), "probe: ReadMessage1")

    let msg2Res: Result[Bytes] = noise.noiseWriteMessage2(responder, EmptyBytes())
    assert(IsOk(msg2Res), "probe: WriteMessage2")
    let msg2: Bytes = Value(msg2Res)
    let read2Res: Result[Bytes] = noise.noiseReadMessage2(initiator, msg2)
    assert(IsOk(read2Res), "probe: ReadMessage2")

    let msg3Res: Result[Bytes] = noise.noiseWriteMessage3(initiator, EmptyBytes())
    assert(IsOk(msg3Res), "probe: WriteMessage3")
    let msg3: Bytes = Value(msg3Res)
    let read3Res: Result[Bytes] = noise.noiseReadMessage3(responder, msg3)
    assert(IsOk(read3Res), "probe: ReadMessage3")

    let hInit: Bytes = noise.noiseHandshakeHash(initiator)
    let hResp: Bytes = noise.noiseHandshakeHash(responder)
    assert(BytesEqual(hInit, hResp), "probe: handshake hash must match on both sides")
    echo(strutil.Join(["handshake_hash=", BytesToHex(hInit)], ""))

    var initC1: noise.CipherState
    var initC2: noise.CipherState
    let splitInitRes: Result[bool] = noise.noiseHandshakeSplit(initiator, initC1, initC2)
    assert(IsOk(splitInitRes), "probe: initiator Split")
    var respC1: noise.CipherState
    var respC2: noise.CipherState
    let splitRespRes: Result[bool] = noise.noiseHandshakeSplit(responder, respC1, respC2)
    assert(IsOk(splitRespRes), "probe: responder Split")

    assert(BytesLen(initC1.k) == 32, "probe: c1 key length")
    assert(BytesLen(initC2.k) == 32, "probe: c2 key length")
    assert(BytesEqual(initC1.k, respC1.k), "probe: c1 must match on both sides")
    assert(BytesEqual(initC2.k, respC2.k), "probe: c2 must match on both sides")
    assert(!BytesEqual(initC1.k, initC2.k), "probe: c1/c2 must be distinct directions")
    echo(strutil.Join(["transport_c1=", BytesToHex(initC1.k)], ""))
    echo(strutil.Join(["transport_c2=", BytesToHex(initC2.k)], ""))

    # --- 2. mutation-negative tests (fresh replay per trial, reusing the
    # deterministic msg1/msg2/msg3 bytes captured above -- every run with the
    # same fixed keys reproduces them bit-for-bit) --------------------------

    # 2a: flip a byte inside message2's AEAD-encrypted responder-static field.
    var initA: noise.HandshakeState = buildInitiator()
    let primeARes: Result[Bytes] = noise.noiseWriteMessage1(initA, EmptyBytes())
    assert(IsOk(primeARes), "probe: 2a prime WriteMessage1")
    let msg2A: Bytes = flippedCopy(msg2, 40)
    let read2ABadRes: Result[Bytes] = noise.noiseReadMessage2(initA, msg2A)
    assert(IsErr(read2ABadRes), "probe: mutated message2 static field must be rejected")

    # 2b: flip a byte inside message2's plaintext responder-ephemeral field.
    var initB: noise.HandshakeState = buildInitiator()
    let primeBRes: Result[Bytes] = noise.noiseWriteMessage1(initB, EmptyBytes())
    assert(IsOk(primeBRes), "probe: 2b prime WriteMessage1")
    let msg2B: Bytes = flippedCopy(msg2, 0)
    let read2BBadRes: Result[Bytes] = noise.noiseReadMessage2(initB, msg2B)
    assert(IsErr(read2BBadRes), "probe: mutated message2 ephemeral field must be rejected")

    # 2c: flip a byte inside message3's AEAD-encrypted initiator-static field.
    var respC: noise.HandshakeState = buildResponder()
    let primeC1Res: Result[Bytes] = noise.noiseReadMessage1(respC, msg1)
    assert(IsOk(primeC1Res), "probe: 2c prime ReadMessage1")
    let primeC2Res: Result[Bytes] = noise.noiseWriteMessage2(respC, EmptyBytes())
    assert(IsOk(primeC2Res), "probe: 2c prime WriteMessage2")
    let msg3C: Bytes = flippedCopy(msg3, 5)
    let read3CBadRes: Result[Bytes] = noise.noiseReadMessage3(respC, msg3C)
    assert(IsErr(read3CBadRes), "probe: mutated message3 static field must be rejected")

    echo("noise_xx_handshake_slice3_probe ok (self-consistency + mutation tier; no official golden vectors compared)")
    return 0
