import std/rawbytes
import std/strings

@borrows
fn ProductionSliceBytesOwnedCacheSafe(text: str): str =
    var builder = rawbytes.BytesBuilderNew(len(text))
    for i in 0..<len(text):
        let ch = text[i]
        let digit = ch >= '0' && ch <= '9'
        let upper = ch >= 'A' && ch <= 'Z'
        let lower = ch >= 'a' && ch <= 'z'
        if digit || upper || lower:
            rawbytes.BytesBuilderAppendByte(builder, Int32(ch))
        else:
            rawbytes.BytesBuilderAppendByte(builder, Int32('_'))
    var payload = rawbytes.BytesBuilderFinish(builder)
    let out = rawbytes.BytesToString(payload)
    rawbytes.BytesFree(payload)
    return out

@borrows
fn ProductionSliceBytesOwnedSplit(joined: str): str[] =
    var out: str[]
    if len(joined) <= 0:
        return out
    var start: int32
    var i: int32
    while i + 1 < len(joined):
        if joined[i] == ';' && joined[i + 1] == ';':
            add(out, strings.CloneStrRange(joined, start, i - start))
            start = i + 2
            i = i + 2
        else:
            i = i + 1
    add(out, strings.CloneStrRange(joined, start, len(joined) - start))
    return out

fn ProductionSliceBytesOwnedBuildSafe(): str =
    let source = strings.CloneStr("arm64-apple.darwin+debug")
    return ProductionSliceBytesOwnedCacheSafe(source)

fn ProductionSliceBytesOwnedBuildParts(): str[] =
    let source = strings.CloneStr("str;;Result[int32];;str[]")
    return ProductionSliceBytesOwnedSplit(source)

fn main(): int32 =
    let safe = ProductionSliceBytesOwnedBuildSafe()
    if safe != "arm64_apple_darwin_debug":
        return 2

    let parts = ProductionSliceBytesOwnedBuildParts()
    if parts.len != 3:
        return 3
    if parts[0] != "str":
        return 4
    if parts[1] != "Result[int32]":
        return 5
    if parts[2] != "str[]":
        return 6

    let emptyParts = ProductionSliceBytesOwnedSplit("")
    if emptyParts.len != 0:
        return 7
    let trailing = ProductionSliceBytesOwnedSplit("a;;")
    if trailing.len != 2:
        return 8
    if trailing[0] != "a" || trailing[1] != "":
        return 9
    return 0
