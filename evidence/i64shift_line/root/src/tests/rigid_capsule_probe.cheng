# Rigid-capsule probe (full-pose rigid bodies with quaternion + inertia):
#   A. drop-and-rest: upright capsule falls onto its lower endpoint, lands
#      inelastic (e=0), stays standing; omega = 0 keeps the pose exact
#   B. topple: capsule released with a 0.05 rad tilt falls over about the
#      ground contact (contact torque + rotational inertia), within the
#      physical-pendulum time magnitude (~0.8 s analytic for this shape)
#   C. gyroscopic free flight: torque-free symmetric top with transverse +
#      axial spin — |omega| is conserved (gyro term kept, closed-form
#      Rodrigues precession) while the direction precesses, pose norm exact
#   D. conditional preimage: identical worlds differing only in
#      Dynamic-vs-CapsuleRigid kind hash differently (the |caps=| pose
#      section appears), a rotated pose hashes differently, repeated
#      hashing of the same world is stable
import cheng/game/world3d
import cheng/game/physics3d
import cheng/game/csg/numerics
import std/math as m
import std/strings as strings

fn fmtMm(x: float64): str =
    let scaled: int32 = int32(m.roundFloat(x * 1000.0))
    var neg: bool = scaled < 0
    var mag: int32 = scaled
    if neg:
        mag = 0 - mag
    let intPart: int32 = mag / 1000
    let fracPart: int32 = mag % 1000
    var outStr: str = ""
    if neg:
        outStr = "-"
    outStr = outStr + strings.IntToStr(intPart) + "." + strings.CloneStrRange(strings.IntToStr(fracPart + 1000), 1, 3)
    return outStr

fn casePreimageGate(): bool =
    var wa: world3d.World3d
    World3dReset(wa, int64(41))
    let _a = World3dSpawnBody(wa, 0.0, 0.0, 0.3, 2.0, 0.05, world3d.World3dBodyDynamic)
    var wb: world3d.World3d
    World3dReset(wb, int64(41))
    let _b = World3dSpawnCapsule(wb, 0.0, 0.0, 0.3, 2.0, 0.05, 0.25, 1.0, 0.0, 0.0, 0.0)
    var wc: world3d.World3d
    World3dReset(wc, int64(41))
    let qh = 0.7071067811865476
    let _c = World3dSpawnCapsule(wc, 0.0, 0.0, 0.3, 2.0, 0.05, 0.25, qh, qh, 0.0, 0.0)
    let cidA = World3dCid(wa)
    let cidA2 = World3dCid(wa)
    let cidB = World3dCid(wb)
    let cidC = World3dCid(wc)
    let cidB2 = World3dCid(wb)
    echo("case preimage cidA=" + cidA)
    echo("case preimage cidB=" + cidB)
    echo("case preimage cidC=" + cidC)
    if cidA != cidA2:
        return false
    if cidA == cidB:
        return false
    if cidB != cidB2:
        return false
    if cidB == cidC:
        return false
    return true

# case A: upright drop. Rest height h + r, e=0 landing (no bounce past the
# pushout), omega = 0 in flight and in contact must leave the pose exactly
# identity (gyro with zero omega is the identity map).
fn caseDropRest(): bool =
    var w: world3d.World3d
    World3dReset(w, int64(42))
    let capH = 0.25
    let capR = 0.05
    let _b = World3dSpawnCapsule(w, 0.0, 0.0, 2.0, 2.0, capR, capH, 1.0, 0.0, 0.0, 0.0)
    var pzMid: float64 = 0.0
    var i: int32 = 0
    while i < 480:
        var r = physics3d.Physics3dStep(w, "case:droprest")
        if r.statusCode != physics3d.Physics3dStatusOk:
            echo("FAIL droprest step rejected at t=" + strings.IntToStr(i))
            return false
        if i == 240:
            pzMid = w.bodyPz[0]
        i = i + 1
    let restZ = capH + capR
    let zErr = m.absFloat(w.bodyPz[0] - restZ)
    let creep = m.absFloat(w.bodyPz[0] - pzMid)
    let quatErr = m.absFloat(w.bodyQuatW[0] - 1.0) + m.absFloat(w.bodyQuatX[0]) + m.absFloat(w.bodyQuatY[0]) + m.absFloat(w.bodyQuatZ[0])
    let spin = m.absFloat(w.bodyAngVx[0]) + m.absFloat(w.bodyAngVy[0]) + m.absFloat(w.bodyAngVz[0])
    echo("case droprest z=" + fmtMm(w.bodyPz[0] * 1000.0) + " zerr_mm=" + fmtMm(zErr * 1000.0) + " creep_mm=" + fmtMm(creep * 1000.0) + " quaterr=" + fmtMm(quatErr * 1000000.0) + "e-6 spin=" + fmtMm(spin * 1000000.0) + "e-6")
    if zErr > 0.005:
        return false
    if creep > 0.001:
        return false
    if quatErr > 0.000001:
        return false
    if spin > 0.000001:
        return false
    return true

# case B: topple about the ground contact. Released upright with a 0.05 rad
# tilt, the capsule must rotate over (axis z-component drops below 0.25,
# i.e. past ~75 deg) within the physical-pendulum magnitude. Analytic
# small-oscillation estimate for h=0.25, r=0.05, m=2: kappa =
# sqrt(m g (h+r) / (I_cm + m (h+r)^2)) ~ 5.0 1/s -> ~190 steps to 75 deg.
# <60 steps would mean a free spin (no contact pivot), >600 no real topple.
fn caseTopple(): bool =
    var w: world3d.World3d
    World3dReset(w, int64(43))
    let capH = 0.25
    let capR = 0.05
    let th0 = 0.05
    let qw0 = m.cosFloat(0.5 * th0)
    let qx0 = m.sinFloat(0.5 * th0)
    let _b = World3dSpawnCapsule(w, 0.0, 0.0, capH + capR, 2.0, capR, capH, qw0, qx0, 0.0, 0.0)
    var fellAt: int32 = -1
    var i: int32 = 0
    while i < 900:
        var r = physics3d.Physics3dStep(w, "case:topple")
        if r.statusCode != physics3d.Physics3dStatusOk:
            echo("FAIL topple step rejected at t=" + strings.IntToStr(i))
            return false
        if fellAt < 0:
            let az = 1.0 - 2.0 * (w.bodyQuatX[0] * w.bodyQuatX[0] + w.bodyQuatY[0] * w.bodyQuatY[0])
            if az < 0.25:
                fellAt = i
        i = i + 1
    let azEnd = 1.0 - 2.0 * (w.bodyQuatX[0] * w.bodyQuatX[0] + w.bodyQuatY[0] * w.bodyQuatY[0])
    echo("case topple fellAt=" + strings.IntToStr(fellAt) + " axisZ_end=" + fmtMm(azEnd * 1000.0) + " z_end=" + fmtMm(w.bodyPz[0] * 1000.0))
    if fellAt < 0:
        return false
    if fellAt < 60:
        return false
    if fellAt > 600:
        return false
    if m.absFloat(azEnd) > 0.4:
        return false
    if w.bodyPz[0] > (capH + capR) - 0.15:
        return false
    return true

# case C: gyroscopic free flight. Spin (3, 0, 5) rad/s on the symmetric-top
# capsule: the closed-form gyroscopic precession rotates omega about the
# symmetry axis (direction change >> 0) while |omega| and the pose norm
# stay exact; the body stays airborne (no contact) the whole window.
fn caseGyroFree(): bool =
    var w: world3d.World3d
    World3dReset(w, int64(44))
    let _b = World3dSpawnCapsule(w, 0.0, 0.0, 10.0, 2.0, 0.05, 0.25, 1.0, 0.0, 0.0, 0.0)
    w.bodyAngVx[0] = 3.0
    w.bodyAngVz[0] = 5.0
    let w0 = numerics.CsgSqrt(9.0 + 25.0)
    var i: int32 = 0
    while i < 240:
        var r = physics3d.Physics3dStep(w, "case:gyrofree")
        if r.statusCode != physics3d.Physics3dStatusOk:
            echo("FAIL gyrofree step rejected at t=" + strings.IntToStr(i))
            return false
        i = i + 1
    let wEnd = numerics.CsgSqrt(w.bodyAngVx[0] * w.bodyAngVx[0] + w.bodyAngVy[0] * w.bodyAngVy[0] + w.bodyAngVz[0] * w.bodyAngVz[0])
    let drift = m.absFloat(wEnd - w0) / w0
    let dx = w.bodyAngVx[0] - 3.0
    let dz = w.bodyAngVz[0] - 5.0
    let moved = numerics.CsgSqrt(dx * dx + w.bodyAngVy[0] * w.bodyAngVy[0] + dz * dz)
    let qn = numerics.CsgSqrt(w.bodyQuatW[0] * w.bodyQuatW[0] + w.bodyQuatX[0] * w.bodyQuatX[0] + w.bodyQuatY[0] * w.bodyQuatY[0] + w.bodyQuatZ[0] * w.bodyQuatZ[0])
    echo("case gyrofree w0=" + fmtMm(w0 * 1000.0) + " wEnd=" + fmtMm(wEnd * 1000.0) + " drift=" + fmtMm(drift * 1000000000.0) + "e-9 moved=" + fmtMm(moved * 1000.0) + " qnerr=" + fmtMm(m.absFloat(qn - 1.0) * 1000000000.0) + "e-9 z=" + fmtMm(w.bodyPz[0] * 1000.0))
    if drift > 0.000000001:
        return false
    if moved < 1.0:
        return false
    if m.absFloat(qn - 1.0) > 0.000000001:
        return false
    if w.bodyPz[0] < 4.5:
        return false
    return true

fn main(): int32 =
    if !casePreimageGate():
        echo("FAIL casePreimageGate")
        return 1
    if !caseDropRest():
        echo("FAIL caseDropRest")
        return 1
    if !caseTopple():
        echo("FAIL caseTopple")
        return 1
    if !caseGyroFree():
        echo("FAIL caseGyroFree")
        return 1
    echo("PASS rigid capsule probe")
    return 0
