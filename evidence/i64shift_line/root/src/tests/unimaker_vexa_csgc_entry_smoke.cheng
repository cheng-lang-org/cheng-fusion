import std/os as os
import std/rawbytes
import cheng/core/csg_asset/oracle_asset as asset
import cheng/apps/unimaker/unimaker_product_publish as publish
import cheng/apps/vexa/vexa_asset_discovery as discovery

@borrows
fn smokeFail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

fn smokeExpect(cond: bool, message: str): int32 =
    if !cond:
        return smokeFail(message)
    return 0

fn smokeObservation(): asset.OracleAssetObservation =
    return asset.OracleAssetObservation(
        id: "obs_unimaker_entry_product_001",
        sourceKind: "oracle_bft_committee",
        sourceUri: "oracle://cheng/mainnet/unimaker/product/entry-001",
        subjectId: "unimaker_entry_product_001",
        valueHash: asset.AssetSha256("entry product source value"),
        observedAtMs: int64(900000),
        ttlMs: int64(120000),
        reporterCount: 7,
        quorum: 5,
        appHash: asset.AssetSha256("entry oracle app hash"),
        receiptHash: asset.AssetSha256("entry oracle receipt")
    )

fn smokeClaim(observation: asset.OracleAssetObservation): asset.UnimakerProductSourceClaim =
    return asset.UnimakerProductSourceClaim(
        id: "claim_unimaker_entry_product_001",
        productId: observation.subjectId,
        sourceId: observation.id,
        sellerId: "did:unimaker:seller_entry",
        titleHash: asset.AssetSha256("entry product title"),
        licenseHash: asset.AssetSha256("entry product license"),
        mediaAssetCid: "bafybeigdyrztentry001",
        priceE8: int64(880000000),
        inventory: int64(9),
        observedAtMs: observation.observedAtMs,
        ttlMs: observation.ttlMs,
        oracleReceiptHash: observation.receiptHash,
        signerHash: asset.AssetSha256("entry seller signature"),
        authorized: true
    )

fn smokeBuildRequest(): publish.UnimakerProductPublishRequest =
    var observation = smokeObservation()
    let claim = smokeClaim(observation)
    observation.valueHash = asset.UnimakerProductObservationValueHash(claim)
    return publish.UnimakerProductPublishRequest(
        observation: observation,
        claim: claim,
        nowMs: int64(910000),
        actionKind: "unimaker.publish_product",
        preconditionHash: asset.AssetSha256("entry publish preconditions"),
        executorId: "cheng_unimaker_publish_executor",
        executionStateHash: asset.AssetSha256("entry execution input state"),
        outputStateHash: asset.AssetSha256("entry published product state"),
        executedAtMs: int64(930000),
        resumeTokenHash: asset.AssetSha256("entry recoverable cell resume token")
    )

fn main(): int32 =
    let request = smokeBuildRequest()
    let bundleRes = publish.UnimakerProductPublishCompile(request)
    if smokeExpect(bundleRes.ok, "UniMaker product publish should produce CSGC bundle") != 0:
        os.WriteLine(os.Get_stderr(), bundleRes.err.msg)
        return 1
    let bundle = bundleRes.value
    if smokeExpect(rawbytes.BytesLen(bundle.csgcBytes) > 64, "UniMaker publish CSGC bytes should be non-empty") != 0:
        return 1
    if smokeExpect(bundle.csgcFactCount == 7, "UniMaker publish closed-loop fact count mismatch") != 0:
        return 1
    if smokeExpect(bundle.cell.complete, "UniMaker publish recoverable Cell should be complete") != 0:
        return 1

    let admittedRes = discovery.VexaAdmitClosedLoopAssetFromCsgc(bundle.csgcBytes)
    if smokeExpect(admittedRes.ok, "Vexa should admit UniMaker CSGC closed-loop asset") != 0:
        os.WriteLine(os.Get_stderr(), admittedRes.err.msg)
        return 1
    let admitted = admittedRes.value
    if smokeExpect(admitted.assetId == bundle.candidate.id, "Vexa admitted asset id mismatch") != 0:
        return 1
    if smokeExpect(admitted.planRoot == bundle.plan.planRoot, "Vexa admitted plan root mismatch") != 0:
        return 1
    if smokeExpect(admitted.closedLoopFactsRoot == bundle.closedLoopFactsRoot,
                   "Vexa admitted closed-loop facts root mismatch") != 0:
        return 1
    if smokeExpect(admitted.receiptHash == bundle.executionReceipt.receiptHash,
                   "Vexa admitted receipt hash mismatch") != 0:
        return 1
    if smokeExpect(admitted.recoveryRoot == bundle.cell.recoveryRoot, "Vexa admitted recovery root mismatch") != 0:
        return 1

    var unauthorized = request
    unauthorized.claim.authorized = false
    let unauthorizedRes = publish.UnimakerProductPublishCompile(unauthorized)
    if smokeExpect(!unauthorizedRes.ok, "unauthorized UniMaker product publish must fail") != 0:
        return 1

    let baseLines = asset.CsgAssetFactsDebugLines(request.observation,
                                                  bundle.certificate,
                                                  bundle.candidate)
    let baseCsgc = asset.CsgAssetEncodeCsgc(baseLines)
    if smokeExpect(baseCsgc.ok, "base asset facts should encode") != 0:
        return 1
    let incompleteAdmission = discovery.VexaAdmitClosedLoopAssetFromCsgc(baseCsgc.bytes)
    if smokeExpect(!incompleteAdmission.ok, "Vexa must reject CSGC without plan receipt Cell") != 0:
        return 1

    os.WriteLine(os.Get_stdout(), "unimaker_vexa_csgc_entry_smoke ok")
    return 0
