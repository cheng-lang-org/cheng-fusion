import std/strutils as strutil

fn takeBoolAfterStr(host: str, port: int32, flag: bool = false): int32 =
    if flag:
        return 1
    return 0

fn takeBoolAfterInt(port: int32, flag: bool = false): int32 =
    if flag:
        return 1
    return 0

fn takeBoolTwoStr(a: str, b: str, flag: bool = false): int32 =
    if flag:
        return 1
    return 0

fn innerForward(host: str, port: int32, flag: bool = false): int32 =
    if flag:
        return 1
    return 0

fn outerForward(host: str, port: int32, flag: bool = false): int32 =
    return innerForward(host, port, flag)

fn leafLoneBool(flag: bool): int32 =
    if flag:
        return 1
    return 0

fn midToLeaf(host: str, port: int32, flag: bool = false): int32 =
    return leafLoneBool(flag)

fn leafNotBool(flag: bool): int32 =
    if !flag:
        return 100
    return 200

fn midToNotLeaf(host: str, port: int32, flag: bool = false): int32 =
    return leafNotBool(flag)

fn main(): int32 =
    puts(strutil.Join(["bool_after_str(false)=", IntToStr(takeBoolAfterStr("127.0.0.1", 80, false))], ""))
    puts(strutil.Join(["bool_after_str(true)=", IntToStr(takeBoolAfterStr("127.0.0.1", 80, true))], ""))
    puts(strutil.Join(["bool_after_int(false)=", IntToStr(takeBoolAfterInt(80, false))], ""))
    puts(strutil.Join(["bool_after_int(true)=", IntToStr(takeBoolAfterInt(80, true))], ""))
    puts(strutil.Join(["bool_two_str(false)=", IntToStr(takeBoolTwoStr("a", "b", false))], ""))
    puts(strutil.Join(["bool_two_str(true)=", IntToStr(takeBoolTwoStr("a", "b", true))], ""))
    puts(strutil.Join(["forward(false)=", IntToStr(outerForward("127.0.0.1", 80, false))], ""))
    puts(strutil.Join(["forward(true)=", IntToStr(outerForward("127.0.0.1", 80, true))], ""))
    puts(strutil.Join(["midToLeaf(false)=", IntToStr(midToLeaf("127.0.0.1", 80, false))], ""))
    puts(strutil.Join(["midToLeaf(true)=", IntToStr(midToLeaf("127.0.0.1", 80, true))], ""))
    puts(strutil.Join(["midToNotLeaf(false)=", IntToStr(midToNotLeaf("127.0.0.1", 80, false))], ""))
    puts(strutil.Join(["midToNotLeaf(true)=", IntToStr(midToNotLeaf("127.0.0.1", 80, true))], ""))
    return 0
