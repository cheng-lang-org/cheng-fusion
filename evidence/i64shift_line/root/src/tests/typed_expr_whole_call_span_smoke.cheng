import cheng/core/lang/parser
import cheng/core/lang/typed_expr as texpr

fn textIndexFrom(text: str, needle: str, startRaw: int32): int32 =
    if needle == "" || needle.len > text.len:
        return -1
    var start = startRaw
    if start < 0:
        start = 0
    let lastStart = text.len - needle.len
    for candidate in start..lastStart:
        var matches = true
        for offset in 0..<needle.len:
            if text[candidate + offset] != needle[offset]:
                matches = false
                break
        if matches:
            return candidate
    return -1

fn callSurface(qualifier: str, callee: str): str =
    if qualifier == "":
        return callee
    return Fmt"{qualifier}.{callee}"

fn callText(qualifier: str, callee: str, argsText: str): str =
    return Fmt"{callSurface(qualifier, callee)}({argsText})"

fn callFact(joinedRaw: str,
            qualifier: str,
            callee: str,
            argsText: str,
            lineNumber: int32,
            searchStart: int32): texpr.TypedExprFact =
    let surface = callSurface(qualifier, callee)
    let fullText = callText(qualifier, callee, argsText)
    let fullStart0 = textIndexFrom(joinedRaw, fullText, searchStart)
    assert(fullStart0 >= 0, "typed expr whole-call span: fixture call missing")
    var fact: texpr.TypedExprFact
    fact.lineNumber = lineNumber
    fact.columnNumber = fullStart0 + (surface.len - callee.len) + 1
    fact.endLineNumber = lineNumber
    fact.endColumnNumber = fullStart0 + fullText.len
    fact.kind = parser.NormalizedExprCall
    fact.callQualifier = qualifier
    fact.callCallee = callee
    fact.callArgCount = parser.ParserCountTopLevelArgs(argsText)
    fact.callArgsText = argsText
    return fact

fn scopeThrough(endLine: int32): texpr.TypedExprFunctionScope =
    var scope: texpr.TypedExprFunctionScope
    scope.startLine = 1
    scope.endLine = endLine
    return scope

fn main(): int32 =
    # f1: physical comments are skipped while the open call continues.
    var multilineCtx: texpr.TypedExprSourceContext
    add(multilineCtx.lines, "fn f1(): void =")
    add(multilineCtx.lines, "    add(seq,")
    add(multilineCtx.lines, "        # hash-only")
    add(multilineCtx.lines, "        // slash-only")
    add(multilineCtx.lines, "        pkg.helper(1))")
    let multilineScope = scopeThrough(multilineCtx.lines.len)
    let multilineWhole = texpr.TypedExprResolveWholeCallStatementAtLine(
        multilineCtx,
        2,
        multilineScope.endLine)
    assert(multilineWhole.ok,
           "typed expr whole-call span: multiline call unresolved")
    assert(multilineWhole.joinedRaw == "    add(seq, pkg.helper(1))" &&
           multilineWhole.text == "add(seq, pkg.helper(1))" &&
           multilineWhole.startLine == 2 && multilineWhole.endLine == 2 &&
           multilineWhole.trimStart0 == 4 && multilineWhole.openPos == 3 &&
           multilineWhole.closePos == multilineWhole.text.len - 1,
           "typed expr whole-call span: parser-isomorphic joined coordinates")
    let multilineFact = callFact(multilineWhole.joinedRaw,
                                 "pkg",
                                 "helper",
                                 "1",
                                 2,
                                 0)
    assert(texpr.TypedExprFactIsSeqSideEffectBuiltinSubExpr(multilineCtx,
                                                            multilineScope,
                                                            multilineFact),
           "typed expr whole-call span: multiline f1")

    # A physically blank line is a statement boundary, unlike a comment line.
    var blankCtx: texpr.TypedExprSourceContext
    add(blankCtx.lines, "fn blank(): void =")
    add(blankCtx.lines, "    add(seq,")
    add(blankCtx.lines, "        ")
    add(blankCtx.lines, "        pkg.helper(1))")
    let blankWhole = texpr.TypedExprResolveWholeCallStatementAtLine(blankCtx,
                                                                    2,
                                                                    4)
    assert(!blankWhole.ok,
           "typed expr whole-call span: blank continuation must terminate")

    # f2: the same fact and span contract on one physical line.
    var singleCtx: texpr.TypedExprSourceContext
    add(singleCtx.lines, "fn f2(): void =")
    add(singleCtx.lines, "    add(seq, pkg.helper(1))")
    let singleScope = scopeThrough(singleCtx.lines.len)
    let singleWhole = texpr.TypedExprResolveWholeCallStatementAtLine(
        singleCtx,
        2,
        singleScope.endLine)
    let singleFact = callFact(singleWhole.joinedRaw,
                              "pkg",
                              "helper",
                              "1",
                              2,
                              0)
    assert(texpr.TypedExprFactIsSeqSideEffectBuiltinSubExpr(singleCtx,
                                                            singleScope,
                                                            singleFact),
           "typed expr whole-call span: single-line f2")
    var surfaceColumnFact: texpr.TypedExprFact
    surfaceColumnFact = singleFact
    surfaceColumnFact.columnNumber = textIndexFrom(singleWhole.joinedRaw,
                                                    "pkg.helper(1)",
                                                    0) + 1
    assert(texpr.TypedExprFactIsSeqSideEffectBuiltinSubExpr(singleCtx,
                                                            singleScope,
                                                            surfaceColumnFact),
           "typed expr whole-call span: surface-column contract")

    # Facts are compacted before TypedIR consumes them. End spans are semantic
    # ownership data and must survive that boundary.
    var compactFacts: texpr.TypedExprFactTable
    texpr.TypedExprFactTableAppendHandBuilt(compactFacts, singleFact)
    texpr.TypedExprCompactStoredFactsRange(compactFacts, 0, 1)
    let compactFact = texpr.TypedExprFactAt(compactFacts, 0)
    assert(compactFact.endLineNumber == singleFact.endLineNumber &&
           compactFact.endColumnNumber == singleFact.endColumnNumber &&
           texpr.TypedExprFactIsSeqSideEffectBuiltinSubExpr(singleCtx,
                                                             singleScope,
                                                             compactFact),
           "typed expr whole-call span: compacted span ownership")
    texpr.TypedExprFactTableRelease(compactFacts)

    # Reverse mutations: either text or the half-open span drifting is fatal.
    var badSeqText: texpr.TypedExprFact
    badSeqText = singleFact
    badSeqText.callArgsText = "2"
    assert(!texpr.TypedExprFactIsSeqSideEffectBuiltinSubExpr(singleCtx,
                                                             singleScope,
                                                             badSeqText),
           "typed expr whole-call span: seq text mutation accepted")
    var badSeqSpan: texpr.TypedExprFact
    badSeqSpan = singleFact
    badSeqSpan.endColumnNumber = badSeqSpan.endColumnNumber + 1
    assert(!texpr.TypedExprFactIsSeqSideEffectBuiltinSubExpr(singleCtx,
                                                             singleScope,
                                                             badSeqSpan),
           "typed expr whole-call span: seq span mutation accepted")

    # f3: pre-extracted helper is a separate statement, not add's subexpr.
    var extractedCtx: texpr.TypedExprSourceContext
    add(extractedCtx.lines, "fn f3(): void =")
    add(extractedCtx.lines, "    let value = pkg.helper(1)")
    add(extractedCtx.lines, "    add(seq, value)")
    let extractedScope = scopeThrough(extractedCtx.lines.len)
    let extractedRaw = texpr.TypedExprParserJoinedSourceLine(extractedCtx,
                                                             2,
                                                             extractedScope.endLine)
    let extractedFact = callFact(extractedRaw,
                                 "pkg",
                                 "helper",
                                 "1",
                                 2,
                                 0)
    assert(!texpr.TypedExprFactIsSeqSideEffectBuiltinSubExpr(extractedCtx,
                                                             extractedScope,
                                                             extractedFact),
           "typed expr whole-call span: pre-extract f3")

    # Dependency ownership uses the same source coordinates plus an exact
    # relative slice of the parent's argument text.
    let parentRaw = "    outer(pkg.helper(1), helper(2), helper(2), xhelper(3))"
    let parentArgs = "pkg.helper(1), helper(2), helper(2), xhelper(3)"
    let rootFact = callFact(parentRaw, "", "outer", parentArgs, 9, 0)
    let qualifiedDep = callFact(parentRaw, "pkg", "helper", "1", 9, 0)
    assert(texpr.TypedExprFactCallArgsContainFact(parentRaw,
                                                  rootFact,
                                                  qualifiedDep),
           "typed expr whole-call span: qualified dependency")
    let zeroRaw = "    outer(pkg.helper( ))"
    let zeroRoot = callFact(zeroRaw, "", "outer", "pkg.helper( )", 10, 0)
    let zeroDep = callFact(zeroRaw, "pkg", "helper", " ", 10, 0)
    assert(zeroDep.callArgCount == 0 &&
           texpr.TypedExprFactCallArgsContainFact(zeroRaw,
                                                  zeroRoot,
                                                  zeroDep),
           "typed expr whole-call span: zero-arg whitespace")
    let spacedRaw = "    outer(pkg.helper ( ))"
    let spacedRoot = callFact(spacedRaw,
                              "",
                              "outer",
                              "pkg.helper ( )",
                              10,
                              0)
    let spacedStart0 = textIndexFrom(spacedRaw, "pkg.helper ( )", 0)
    var spacedDep: texpr.TypedExprFact
    spacedDep.lineNumber = 10
    spacedDep.columnNumber = spacedStart0 + "pkg.".len + 1
    spacedDep.endLineNumber = 10
    spacedDep.endColumnNumber = spacedStart0 + "pkg.helper ( )".len
    spacedDep.kind = parser.NormalizedExprCall
    spacedDep.callQualifier = "pkg"
    spacedDep.callCallee = "helper"
    spacedDep.callArgCount = 0
    spacedDep.callArgsText = " "
    assert(texpr.TypedExprFactCallArgsContainFact(spacedRaw,
                                                  spacedRoot,
                                                  spacedDep),
           "typed expr whole-call span: callee/open-paren whitespace")
    let firstRepeatedStart = textIndexFrom(parentRaw, "helper(2)", 0)
    let secondRepeated = callFact(parentRaw,
                                  "",
                                  "helper",
                                  "2",
                                  9,
                                  firstRepeatedStart + 1)
    assert(texpr.TypedExprFactCallArgsContainFact(parentRaw,
                                                  rootFact,
                                                  secondRepeated),
           "typed expr whole-call span: repeated dependency")
    var badDependencyText: texpr.TypedExprFact
    badDependencyText = secondRepeated
    badDependencyText.callArgsText = "1"
    assert(!texpr.TypedExprFactCallArgsContainFact(parentRaw,
                                                   rootFact,
                                                   badDependencyText),
           "typed expr whole-call span: dependency text mutation accepted")
    var badDependencySpan: texpr.TypedExprFact
    badDependencySpan = secondRepeated
    badDependencySpan.columnNumber = badDependencySpan.columnNumber + 1
    assert(!texpr.TypedExprFactCallArgsContainFact(parentRaw,
                                                   rootFact,
                                                   badDependencySpan),
           "typed expr whole-call span: dependency span mutation accepted")
    let prefixedDep = callFact(parentRaw, "", "xhelper", "3", 9, 0)
    var forgedPrefix: texpr.TypedExprFact
    forgedPrefix = prefixedDep
    forgedPrefix.callCallee = "helper"
    assert(!texpr.TypedExprFactCallArgsContainFact(parentRaw,
                                                   rootFact,
                                                   forgedPrefix),
           "typed expr whole-call span: prefixed callee accepted")
    let stringRaw = "    outer(\"pkg.helper(1)\")"
    let stringRoot = callFact(stringRaw,
                              "",
                              "outer",
                              "\"pkg.helper(1)\"",
                              11,
                              0)
    let stringDep = callFact(stringRaw, "pkg", "helper", "1", 11, 0)
    assert(!texpr.TypedExprFactCallArgsContainFact(stringRaw,
                                                   stringRoot,
                                                   stringDep),
           "typed expr whole-call span: string content accepted as call")
    return 0
