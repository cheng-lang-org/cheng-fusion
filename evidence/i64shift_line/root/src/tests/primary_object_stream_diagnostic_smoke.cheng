import std/os
import std/strings
import std/hashmaps as hashmaps
import cheng/core/tooling/compiler_request as creq
import cheng/core/backend/system_link_plan as slplan
import cheng/core/backend/lowering_plan as lower
import cheng/core/backend/primary_object_plan as pobj
import cheng/core/backend/direct_object_emit as dobj
import cheng/core/ir/core_types as coreir
import cheng/core/ir/body_ir_lifecycle as bodylife
import cheng/std/bytes_layout as layout

fn ValidatePrimaryBodyIrExactMove() =
    let parsedCid = layout.FixedBytes32FromHex(
        "9999999999999999999999999999999999999999999999999999999999999999")
    assert(IsOk(parsedCid),
           " primary body ir move: fixture type arena CID")
    let typeArenaCid = Value(parsedCid)
    var source = coreir.BodyIRNew()
    assert(coreir.BodyIRBindTypeArenaArtifactCid(
               source, typeArenaCid),
           " primary body ir move: bind type arena CID")
    hashmaps.HashMapStrIntPut(source.slotNameIndex, "move_slot", 7)
    source.debugProvenanceRequired = true
    source.debugProvenanceComplete = true
    source.debugFunctionId = 41
    source.debugCurrentOpId = 43
    source.debugCurrentSyntheticKind = 47
    add(source.debugOpIdsByOpIndex, 53)
    add(source.debugSyntheticKindsByOpIndex, 59)
    add(source.debugOpIdsByTermIndex, 61)
    add(source.debugSyntheticKindsByTermIndex, 67)
    var op: coreir.BodyOp
    op.kind = coreir.BodyOpLoadConstTag
    op.target = 0
    add(op.operands, 71)
    add(source.ops, op)

    var destination = coreir.BodyIRNew()
    pobj.PrimaryBodyIRMoveInto(destination, source)
    var found = false
    let movedSlot = hashmaps.HashMapStrIntGet(
        destination.slotNameIndex, "move_slot", found)
    assert(bodylife.BodyIrPayloadIsReleased(source) &&
           layout.FixedBytes32Equal(
               destination.typeArenaArtifactCid, typeArenaCid) &&
           found && movedSlot == 7 &&
           destination.debugProvenanceRequired &&
           destination.debugProvenanceComplete &&
           destination.debugFunctionId == 41 &&
           destination.debugCurrentOpId == 43 &&
           destination.debugCurrentSyntheticKind == 47 &&
           destination.debugOpIdsByOpIndex.len == 1 &&
           destination.debugOpIdsByOpIndex[0] == 53 &&
           destination.debugSyntheticKindsByOpIndex[0] == 59 &&
           destination.debugOpIdsByTermIndex[0] == 61 &&
           destination.debugSyntheticKindsByTermIndex[0] == 67,
           " primary body ir move: exact identity and payload transfer")

    var lifecycle: bodylife.BodyIrFunctionLifecycle
    var receipt: bodylife.BodyIrFunctionLifecycleReceipt
    bodylife.BodyIrFunctionLifecycleBegin(
        lifecycle, destination, 73)
    bodylife.BodyIrFunctionLifecycleMoveToEmitter(lifecycle)
    bodylife.BodyIrFunctionLifecycleRelease(
        lifecycle,
        destination,
        bodylife.BodyIrFunctionOutcomeEmitSuccess,
        receipt)
    assert(receipt.live == int64(0) &&
           receipt.liveBytes == int64(0) &&
           receipt.payloadReleased &&
           receipt.ledgerStorageReleased &&
           receipt.phaseArenaStorageReleased &&
           receipt.phaseArenaReleasedBufferCount > 0 &&
           receipt.phaseArenaReleasedBytes > int64(0) &&
           bodylife.BodyIrPayloadIsReleased(destination),
           " primary body ir move: terminal physical release")

fn ValidatePrimaryObjectDeclOrderStream(root: str) =
    let sourcePath = os.JoinPath(root, "src/tests/exec_diff_corpus/datareloc_ordinal_stress.cheng")
    let request0 = creq.CompilerRequestNew(root,
                                           sourcePath,
                                           "/tmp/primary_object_stream_diagnostic_target.o",
                                           "arm64-apple-darwin",
                                           creq.EmitObj,
                                           "")
    let request = creq.CompilerRequestWithExportRootSymbols(request0, ["main"])
    var linkPlan: slplan.SystemLinkPlanStub
    var err = ""
    assert(slplan.BuildSystemLinkPlanStub(root, request, linkPlan, err),
           " primary object stream diagnostic: link plan")
    assert(linkPlan.missingReasons.len == 0,
           " primary object stream diagnostic: link plan ready")
    var loweringPlan: lower.LoweringPlanStub
    let loweringReady =
        lower.BuildLoweringPlanStub(linkPlan, loweringPlan, err)
    if !loweringReady:
        os.WriteLine(os.GetStderr(), Fmt"primary_object_stream_diagnostic_lowering_error={err}")
    assert(loweringReady,
           " primary object stream diagnostic: lowering plan")
    lower.LoweringPlanReleasePrePrimaryObjectPayload(loweringPlan)
    var primaryPlan: pobj.PrimaryObjectPlan
    pobj.BuildPrimaryObjectPlanInto(linkPlan, loweringPlan, primaryPlan)
    lower.LoweringPlanReleaseAfterPrimaryObjectPlan(loweringPlan)
    assert(primaryPlan.wordFillSchedule == "decl_order_stream_emit_release",
           " primary object stream diagnostic: actual stream schedule")
    assert(primaryPlan.streamedEmitFirst,
           " primary object stream diagnostic: actual stream active")
    assert(primaryPlan.fillCheckReleasedBodyIrFunctionCount > 0,
           " primary object stream diagnostic: actual body ir release")
    assert(primaryPlan.bodyIrLifecycleFunctionCount ==
               primaryPlan.fillCheckReleasedBodyIrFunctionCount &&
           primaryPlan.bodyIrLifecycleAllocated ==
               int64(primaryPlan.bodyIrLifecycleFunctionCount) &&
           primaryPlan.bodyIrLifecycleReleased ==
               int64(primaryPlan.bodyIrLifecycleFunctionCount) &&
           primaryPlan.bodyIrLifecycleLive == int64(0) &&
           primaryPlan.bodyIrLifecycleAllocatedBytes ==
               primaryPlan.bodyIrLifecycleReleasedBytes &&
           primaryPlan.bodyIrLifecycleLiveBytes == int64(0) &&
           primaryPlan.bodyIrLifecycleOwnerTransferCount ==
               int64(primaryPlan.bodyIrLifecycleFunctionCount) &&
           primaryPlan.bodyIrLifecyclePhysicalFreeCount >=
               int64(primaryPlan.bodyIrLifecycleFunctionCount) &&
           primaryPlan.bodyIrLifecycleAllClosed,
           " primary object stream diagnostic: deterministic body ir lifecycle")
    assert(pobj.PrimaryObjectPlanRetainedBodyIrFunctionCount(primaryPlan) == 0,
           " primary object stream diagnostic: actual no retained body ir")
    assert(primaryPlan.functionBodyIRs.len == 0,
           " primary object stream diagnostic: body ir table released")
    assert(primaryPlan.relocSourceItemIds.len > 0,
           " primary object stream diagnostic: actual call reloc")
    assert(primaryPlan.dataRelocSourceItemIds.len > 0,
           " primary object stream diagnostic: actual data reloc")
    assert(primaryPlan.relocSourceItemIds.len == primaryPlan.relocWordOffsets.len &&
           primaryPlan.relocWordOffsets.len == primaryPlan.relocTargetSymbols.len,
           " primary object stream diagnostic: call reloc columns aligned")
    assert(primaryPlan.dataRelocSourceItemIds.len == primaryPlan.dataRelocWordOffsets.len &&
           primaryPlan.dataRelocWordOffsets.len == primaryPlan.dataRelocTargetSymbols.len,
           " primary object stream diagnostic: data reloc columns aligned")
    for i in 0..<primaryPlan.relocWordOffsets.len:
        assert(primaryPlan.relocWordOffsets[i] >= 0 &&
               primaryPlan.relocWordOffsets[i] < primaryPlan.instructionWords.len &&
               primaryPlan.relocTargetSymbols[i] != "",
               " primary object stream diagnostic: call reloc resolved")
    for i in 0..<primaryPlan.dataRelocWordOffsets.len:
        assert(primaryPlan.dataRelocWordOffsets[i] >= 0 &&
               primaryPlan.dataRelocWordOffsets[i] < primaryPlan.instructionWords.len &&
               primaryPlan.dataRelocTargetSymbols[i] != "",
               " primary object stream diagnostic: data reloc resolved")
    var emitResult: dobj.DirectObjectEmitResult
    var emitErr = ""
    assert(dobj.DirectObjectEmitPlanObjectInto(root,
                                              primaryPlan,
                                              emitResult,
                                              emitErr),
           " primary object stream diagnostic: direct object writer")
    assert(emitResult.bytesWritten > 0 && emitResult.relocCount > 0,
           " primary object stream diagnostic: direct object materialized")
    let report = pobj.PrimaryObjectPlanReport(primaryPlan)
    assert(strings.StrContains(report,
                               "primary_object_word_fill_schedule=decl_order_stream_emit_release"),
           " primary object stream diagnostic: actual schedule report")
    assert(strings.StrContains(report,
                               "primary_object_streamed_emit_first=1"),
           " primary object stream diagnostic: actual active report")
    assert(strings.StrContains(report,
                               Fmt"primary_object_fill_released_body_ir_function_count={primaryPlan.fillCheckReleasedBodyIrFunctionCount}"),
           " primary object stream diagnostic: actual release report")
    assert(strings.StrContains(
               report,
               Fmt"primary_object_body_ir_lifecycle_function_count={primaryPlan.bodyIrLifecycleFunctionCount}") &&
           strings.StrContains(
               report,
               Fmt"primary_object_body_ir_lifecycle_allocated={primaryPlan.bodyIrLifecycleAllocated}") &&
           strings.StrContains(
               report,
               Fmt"primary_object_body_ir_lifecycle_released={primaryPlan.bodyIrLifecycleReleased}") &&
           strings.StrContains(
               report,
               "primary_object_body_ir_lifecycle_live=0") &&
           strings.StrContains(
               report,
               "primary_object_body_ir_lifecycle_live_bytes=0") &&
           strings.StrContains(
               report,
               "primary_object_body_ir_lifecycle_all_closed=1"),
           " primary object stream diagnostic: lifecycle receipt report")
    assert(strings.StrContains(report,
                               "primary_object_retained_body_ir_function_count=0"),
           " primary object stream diagnostic: actual retained report")
    echo(Fmt"primary_object_word_fill_schedule={primaryPlan.wordFillSchedule}")
    echo("primary_object_streamed_emit_first=1")
    echo(Fmt"primary_object_fill_released_body_ir_function_count={primaryPlan.fillCheckReleasedBodyIrFunctionCount}")
    echo(Fmt"primary_object_body_ir_lifecycle_function_count={primaryPlan.bodyIrLifecycleFunctionCount}")
    echo("primary_object_body_ir_lifecycle_live=0")
    echo("primary_object_body_ir_lifecycle_all_closed=1")
    echo("primary_object_retained_body_ir_function_count=0")
    pobj.PrimaryObjectPlanReleasePostEmitBodyIR(primaryPlan)
    lower.LoweringPlanReleaseAllPayload(loweringPlan)

fn main(): int32 =
    ValidatePrimaryBodyIrExactMove()

    var diagnosticIr: lower.PrimaryObjectIrFunction
    add(diagnosticIr.callTargets, "FirstCall")
    add(diagnosticIr.callTargets, "ActualCall")
    add(diagnosticIr.callTargetSourcePaths, "/wrong/first.cheng")
    add(diagnosticIr.callTargetSourcePaths, "/right/actual.cheng")
    add(diagnosticIr.callTargetImportcFlags, false)
    add(diagnosticIr.callTargetImportcFlags, false)
    add(diagnosticIr.callImportcSymbols, "")
    add(diagnosticIr.callImportcSymbols, "")
    let actualOrdinal =
        pobj.PrimaryObjectCallTargetOrdinalForActual(
            diagnosticIr, "ActualCall", 0)
    assert(actualOrdinal == 1 &&
           actualOrdinal < diagnosticIr.callTargetSourcePaths.len &&
           diagnosticIr.callTargetSourcePaths[actualOrdinal] ==
               "/right/actual.cheng",
           " primary object stream diagnostic: emitted call source path uses resolved ordinal")

    var diagnosticState: pobj.PrimaryObjectPlanPhaseState
    diagnosticState.streamedFillFailedIndex = -1
    pobj.PrimaryObjectPlanRecordStreamedBackpatchFailure(diagnosticState,
                                                         7,
                                                         "data_reloc_no_fill_record",
                                                         -1,
                                                         13,
                                                         2)
    pobj.PrimaryObjectPlanRecordStreamedBackpatchFailure(diagnosticState,
                                                         8,
                                                         "call_bl_reloc_no_fill_record",
                                                         5,
                                                         -1,
                                                         -1)
    assert(diagnosticState.streamedFillFailedIndex == 7,
           " primary object stream diagnostic: first failure function")
    assert(diagnosticState.streamedBackpatchFailureKind == "data_reloc_no_fill_record",
           " primary object stream diagnostic: first failure kind")
    assert(diagnosticState.streamedBackpatchCallOrdinal == -1 &&
           diagnosticState.streamedBackpatchDataOpIndex == 13 &&
           diagnosticState.streamedBackpatchDataSubIndex == 2,
           " primary object stream diagnostic: preserved data structural key")

    var callRelocState: pobj.PrimaryObjectPlanPhaseState
    callRelocState.streamedFillFailedIndex = -1
    add(callRelocState.itemIds, 100007)
    add(callRelocState.functionWordOffsets, 64)
    add(callRelocState.relocSourceItemIds, 100007)
    add(callRelocState.relocWordOffsets, -1)
    add(callRelocState.relocTargetSymbols, "TargetCall")
    add(callRelocState.relocTargetDomainKinds,
        coreir.BodyCallTargetDomainInvalidTag)
    add(callRelocState.relocTargetRows, -1)
    add(callRelocState.relocTargetInterfaceCids,
        layout.FixedBytes32())
    add(callRelocState.relocCallOrdinal, 4)
    assert(!pobj.PrimaryObjectPlanResolveStreamedRelocsForFunction(callRelocState,
                                                                   0,
                                                                   0,
                                                                   0),
           " primary object stream diagnostic: missing call fill record hard failure")
    assert(callRelocState.streamedBackpatchFailureKind == "call_bl_reloc_no_fill_record" &&
           callRelocState.streamedBackpatchCallOrdinal == 4,
           " primary object stream diagnostic: call structural key reaches failure")

    var dataRelocState: pobj.PrimaryObjectPlanPhaseState
    dataRelocState.streamedFillFailedIndex = -1
    add(dataRelocState.itemIds, 100008)
    add(dataRelocState.functionWordOffsets, 96)
    add(dataRelocState.dataRelocSourceItemIds, 100008)
    add(dataRelocState.dataRelocWordOffsets, -1)
    add(dataRelocState.dataRelocTargetSymbols, "TargetData")
    add(dataRelocState.dataRelocOpIndex, 13)
    add(dataRelocState.dataRelocSubIndex, 2)
    assert(!pobj.PrimaryObjectPlanResolveStreamedRelocsForFunction(dataRelocState,
                                                                   0,
                                                                   0,
                                                                   0),
           " primary object stream diagnostic: missing data fill record hard failure")
    assert(dataRelocState.streamedBackpatchFailureKind == "data_reloc_no_fill_record" &&
           dataRelocState.streamedBackpatchDataOpIndex == 13 &&
           dataRelocState.streamedBackpatchDataSubIndex == 2,
           " primary object stream diagnostic: data structural key reaches failure")

    var reportPlan: pobj.PrimaryObjectPlan
    reportPlan.streamedEmitFirst = true
    reportPlan.fillCheckReleasedBodyIrFunctionCount = 3
    reportPlan.bodyIrLifecycleFunctionCount = 3
    reportPlan.bodyIrLifecycleAllocated = int64(3)
    reportPlan.bodyIrLifecycleReleased = int64(3)
    reportPlan.bodyIrLifecycleAllClosed = true
    reportPlan.wordFillSchedule = "decl_order_stream_emit_release"
    let report = pobj.PrimaryObjectPlanReport(reportPlan)
    assert(strings.StrContains(report,
                               "primary_object_word_fill_schedule=decl_order_stream_emit_release"),
           " primary object stream diagnostic: schedule report")
    assert(strings.StrContains(report,
                               "primary_object_streamed_emit_first=1"),
           " primary object stream diagnostic: active report")
    assert(strings.StrContains(report,
                               "primary_object_fill_released_body_ir_function_count=3"),
           " primary object stream diagnostic: release report")
    assert(strings.StrContains(
               report,
               "primary_object_body_ir_lifecycle_function_count=3") &&
           strings.StrContains(
               report,
               "primary_object_body_ir_lifecycle_allocated=3") &&
           strings.StrContains(
               report,
               "primary_object_body_ir_lifecycle_released=3") &&
           strings.StrContains(
               report,
               "primary_object_body_ir_lifecycle_all_closed=1"),
           " primary object stream diagnostic: lifecycle report")
    assert(strings.StrContains(report,
                               "primary_object_retained_body_ir_function_count=0"),
           " primary object stream diagnostic: retained report")

    ValidatePrimaryObjectDeclOrderStream(os.GetEnvDefault("CHENG_SMOKE_ROOT", os.GetCurrentDir()))

    echo(" primary_object_stream_diagnostic_smoke ok")
    return 0
