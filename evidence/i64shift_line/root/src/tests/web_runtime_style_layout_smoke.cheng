    let text = web.WebDocumentCreateText(document, "abc")
    if !web.WebDocumentAppendChild(document, docNode, root):
        return 1
    if !web.WebDocumentAppendChild(document, root, label):
        return 2
    if !web.WebDocumentAppendChild(document, label, text):
