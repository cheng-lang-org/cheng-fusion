        return 1
    if !web.WebDocumentAppendChild(document, root, chip):
        return 2
    if !web.WebDocumentAppendChild(document, chip, text):
        return 3

    var sheet: style.WebStyleSheet
    style.WebStyleSheetInit(sheet)
    if !style.WebStyleSheetParse("div { display: block; width: 390px; height: 0px; margin-left: 0px; margin-top: 0px; } button { display: flex; font-size: 14px; line-height: 20px; padding-left: 12px; padding-top: 6px; padding-right: 12px; padding-bottom: 6px; border-width: 1px; margin-left: 0px; margin-top: 0px; }", sheet):
        return 4

    var tree: layout.WebLayoutTree
    if !bridge.WebStyleLayoutBridgeBuildTree(document, sheet, root, tree):
        return 5
    if !layout.WebLayoutCompute(tree, root):
        return 6
    let chipBox = findBoxIndex(tree, chip)
    let chipStyleIdx = layout.WebLayoutFindStyleIndex(tree, chip)
    if chipBox < 0 || chipStyleIdx < 0:
