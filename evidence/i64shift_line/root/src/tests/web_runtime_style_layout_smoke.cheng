    let text = web.WebDocumentCreateText(document, "视频")
    if !web.WebDocumentAppendChild(document, docNode, root):
        return 1
    if !web.WebDocumentAppendChild(document, root, card):
        return 2
    if !web.WebDocumentAppendChild(document, card, label):
        return 3
    if !web.WebDocumentAppendChild(document, label, text):
        return 4
    if !web.WebDocumentSetAttribute(document, root, "class", "grid grid-cols-4 gap-3"):
        return 5
    if !web.WebDocumentSetInlineStyleValue(document, root, "width", "390px"):
        return 6
    if !web.WebDocumentSetInlineStyleValue(document, card, "display", "flex"):
        return 7
    if !web.WebDocumentSetInlineStyleValue(document, card, "flex-direction", "column"):
        return 8
    if !web.WebDocumentSetInlineStyleValue(document, card, "height", "58px"):
        return 9
    if !web.WebDocumentSetInlineStyleValue(document, card, "padding-left", "4px"):
        return 10
    if !web.WebDocumentSetInlineStyleValue(document, card, "padding-right", "4px"):
        return 11
    if !web.WebDocumentSetInlineStyleValue(document, label, "width", "100%"):
        return 12

    var sheet: style.WebStyleSheet
    style.WebStyleSheetInit(sheet)
    if !style.WebStyleSheetParse(".grid{display:grid}.grid-cols-4{grid-template-columns:25% 25% 25% 25%}.gap-3{gap:12px}", sheet):
        return 13
    var computed: style.WebComputedStyle
    if !style.WebStyleSheetComputeStyle(document, sheet, label, computed):
        return 14
    var widthPercent: int32
    if !style.WebComputedStyleWidthPercent(computed, widthPercent):
        return 15
    if widthPercent != 100:
        return 16

    var tree: layout.WebLayoutTree
    if !bridge.WebStyleLayoutBridgeBuildTree(document, sheet, root, tree):
        return 17
    if !layout.WebLayoutCompute(tree, root):
        return 18
    let cardBox = findBoxIndex(tree, card)
    let labelBox = findBoxIndex(tree, label)
    if cardBox < 0 || labelBox < 0:
        return 19
    if layout.WebLayoutBoxWidthAt(tree, cardBox) != 88:
        echo(Fmt"percent card width actual {layout.WebLayoutBoxWidthAt(tree, cardBox)}")
        return 20
    if layout.WebLayoutBoxWidthAt(tree, labelBox) != 80:
        echo(Fmt"percent label width actual {layout.WebLayoutBoxWidthAt(tree, labelBox)}")
        return 21
    return 0

fn findBoxIndex(tree: var layout.WebLayoutTree, nodeId: int32): int32 =
    for i in 0..<layout.WebLayoutBoxCount(tree):
        if layout.WebLayoutBoxNodeAt(tree, i) == nodeId:
            return i
    return -1

fn runStyleLayoutBridgeLineHeightSmoke(): int32 =
    var document: web.WebDocument
    web.WebDocumentInit(document)
    let docNode = web.WebDocumentCreateDocumentNode(document)
    let root = web.WebDocumentCreateElement(document, "div")
    let chip = web.WebDocumentCreateElement(document, "button")
    let text = web.WebDocumentCreateText(document, "小说")
    if !web.WebDocumentAppendChild(document, docNode, root):
        return 1
    if !web.WebDocumentAppendChild(document, root, chip):
        return 2
    if !web.WebDocumentAppendChild(document, chip, text):
        return 3

    var sheet: style.WebStyleSheet
    style.WebStyleSheetInit(sheet)
    if !style.WebStyleSheetParse("div { display: block; width: 390px; height: 0px; margin-left: 0px; margin-top: 0px; } button { display: flex; font-size: 14px; line-height: 20px; padding-left: 12px; padding-top: 6px; padding-right: 12px; padding-bottom: 6px; margin-left: 0px; margin-top: 0px; }", sheet):
        return 4
    var computed: style.WebComputedStyle
    if !style.WebStyleSheetComputeStyle(document, sheet, chip, computed):
        return 5
    var lineHeight: int32
    if !style.WebComputedStyleLineHeightPx(computed, 14, lineHeight):
        return 6
    if lineHeight != 20:
        return 7

    var tree: layout.WebLayoutTree
    if !bridge.WebStyleLayoutBridgeBuildTree(document, sheet, root, tree):
        return 8
    if !layout.WebLayoutCompute(tree, root):
        return 9
    let chipBox = findBoxIndex(tree, chip)
    let textStyleIdx = layout.WebLayoutFindStyleIndex(tree, text)
    if chipBox < 0 || textStyleIdx < 0:
        return 10
    if tree.styles[textStyleIdx].fontSize != 14:
        return 11
    if tree.styles[textStyleIdx].lineHeight != 20:
        return 12
    if layout.WebLayoutBoxHeightAt(tree, chipBox) != 32:
        echo(Fmt"chip height actual {layout.WebLayoutBoxHeightAt(tree, chipBox)}")
        return 13
    return 0

fn runStyleLayoutBridgeUnitlessInheritedLineHeightSmoke(): int32 =
    var document: web.WebDocument
    web.WebDocumentInit(document)
    let docNode = web.WebDocumentCreateDocumentNode(document)
    let root = web.WebDocumentCreateElement(document, "div")
    let label = web.WebDocumentCreateElement(document, "span")
    let text = web.WebDocumentCreateText(document, "首页")
    if !web.WebDocumentAppendChild(document, docNode, root):
        return 1
    if !web.WebDocumentAppendChild(document, root, label):
        return 2
    if !web.WebDocumentAppendChild(document, label, text):
        return 3

    var sheet: style.WebStyleSheet
    style.WebStyleSheetInit(sheet)
    if !style.WebStyleSheetParse("div { display: block; width: 390px; height: 0px; font-size: 18px; margin-left: 0px; margin-top: 0px; } span { display: block; line-height: 1; margin-left: 0px; margin-top: 0px; }", sheet):
        return 4
    var computed: style.WebComputedStyle
    if !style.WebStyleSheetComputeStyle(document, sheet, label, computed):
        return 5
    var fontSize: int32
    if !style.WebComputedStyleFontSizePx(computed, fontSize):
        return 6
    if fontSize != 18:
        return 7
    var lineHeight: int32
    if !style.WebComputedStyleLineHeightPx(computed, fontSize, lineHeight):
        return 8
    if lineHeight != 18:
        echo(Fmt"unitless lineHeight actual {lineHeight} source={computed.lineHeightSource} start={computed.lineHeightStart} stop={computed.lineHeightStop} font={fontSize}")
        return 9

    var halfSheet: style.WebStyleSheet
    style.WebStyleSheetInit(halfSheet)
    if !style.WebStyleSheetParse("div { display: block; width: 390px; height: 0px; font-size: 11px; margin-left: 0px; margin-top: 0px; } span { display: block; line-height: 1.5; margin-left: 0px; margin-top: 0px; }", halfSheet):
        return 17
    var halfComputed: style.WebComputedStyle
    if !style.WebStyleSheetComputeStyle(document, halfSheet, label, halfComputed):
        return 18
    var halfFontSize: int32
    if !style.WebComputedStyleFontSizePx(halfComputed, halfFontSize):
        return 19
    if halfFontSize != 11:
        return 20
    var halfLineHeight: int32
    if !style.WebComputedStyleLineHeightPx(halfComputed, halfFontSize, halfLineHeight):
        return 21
    if halfLineHeight != 17:
        echo(Fmt"half unitless lineHeight actual {halfLineHeight} font={halfFontSize}")
        return 22

    var tree: layout.WebLayoutTree
    if !bridge.WebStyleLayoutBridgeBuildTree(document, sheet, root, tree):
        return 10
    if !layout.WebLayoutCompute(tree, root):
        return 11
    let labelBox = findBoxIndex(tree, label)
    let textBox = findBoxIndex(tree, text)
    let textStyleIdx = layout.WebLayoutFindStyleIndex(tree, text)
    if labelBox < 0 || textBox < 0 || textStyleIdx < 0:
        return 12
    if tree.styles[textStyleIdx].fontSize != 18:
        return 13
    if tree.styles[textStyleIdx].lineHeight != 18:
        return 14
    if layout.WebLayoutBoxHeightAt(tree, textBox) != 18:
        echo(Fmt"text height actual {layout.WebLayoutBoxHeightAt(tree, textBox)} lineHeight={tree.styles[textStyleIdx].lineHeight} lineHeightPx2={tree.styles[textStyleIdx].lineHeightPx2}")
        return 15
    if layout.WebLayoutBoxHeightAt(tree, labelBox) != 18:
        echo(Fmt"label height actual {layout.WebLayoutBoxHeightAt(tree, labelBox)}")
        return 16
    return 0

fn runStyleLayoutBridgeInlineParentStrutSmoke(): int32 =
    var document: web.WebDocument
    web.WebDocumentInit(document)
    let docNode = web.WebDocumentCreateDocumentNode(document)
    let root = web.WebDocumentCreateElement(document, "div")
    let label = web.WebDocumentCreateElement(document, "div")
    let span = web.WebDocumentCreateElement(document, "span")
    let text = web.WebDocumentCreateText(document, "域名")
    if !web.WebDocumentAppendChild(document, docNode, root):
        return 1
    if !web.WebDocumentAppendChild(document, root, label):
        return 2
    if !web.WebDocumentAppendChild(document, label, span):
        return 3
    if !web.WebDocumentAppendChild(document, span, text):
        return 4
    if !web.WebDocumentSetAttribute(document, root, "id", "root"):
        return 5
    if !web.WebDocumentSetAttribute(document, label, "id", "label"):
        return 6

    var sheet: style.WebStyleSheet
    style.WebStyleSheetInit(sheet)
    if !style.WebStyleSheetParse("#root { display: block; width: 390px; font-size: 16px; line-height: 24px; margin-left: 0px; margin-top: 0px; } #label { display: block; margin-bottom: 8px; margin-left: 0px; margin-top: 0px; } span { display: inline; font-size: 14px; line-height: 20px; margin-left: 0px; margin-top: 0px; }", sheet):
        return 7

    var tree: layout.WebLayoutTree
    if !bridge.WebStyleLayoutBridgeBuildTree(document, sheet, root, tree):
        return 8
    if !layout.WebLayoutCompute(tree, root):
        return 9
    let labelBox = findBoxIndex(tree, label)
    let spanBox = findBoxIndex(tree, span)
    if labelBox < 0 || spanBox < 0:
        return 10
    if layout.WebLayoutBoxHeightAt(tree, spanBox) != 20:
        echo(Fmt"inline span height actual {layout.WebLayoutBoxHeightAt(tree, spanBox)}")
        return 11
    if layout.WebLayoutBoxHeightAt(tree, labelBox) != 24:
        echo(Fmt"inline parent strut height actual {layout.WebLayoutBoxHeightAt(tree, labelBox)}")
        return 12
    return 0

fn runStyleLayoutBridgeBorderAutoHeightSmoke(): int32 =
    var document: web.WebDocument
    web.WebDocumentInit(document)
    let docNode = web.WebDocumentCreateDocumentNode(document)
    let root = web.WebDocumentCreateElement(document, "div")
    let chip = web.WebDocumentCreateElement(document, "button")
