    if tree.styles[chipStyleIdx].borderTopWidth != 1 || tree.styles[chipStyleIdx].borderBottomWidth != 1:
        return 8
    if layout.WebLayoutBoxHeightAt(tree, chipBox) != 34:
        echo(Fmt"border chip height actual {layout.WebLayoutBoxHeightAt(tree, chipBox)}")
        return 9
    return 0

fn runStyleLayoutBridgeInputAutoHeightSmoke(): int32 =
    var document: web.WebDocument
    web.WebDocumentInit(document)
    let docNode = web.WebDocumentCreateDocumentNode(document)
    let root = web.WebDocumentCreateElement(document, "div")
    let field = web.WebDocumentCreateElement(document, "input")
    if !web.WebDocumentAppendChild(document, docNode, root):
        return 1
    if !web.WebDocumentAppendChild(document, root, field):
        return 2
    if !web.WebDocumentSetAttribute(document, field, "type", "text"):
        return 3

    var sheet: style.WebStyleSheet
    style.WebStyleSheetInit(sheet)
    if !style.WebStyleSheetParse("div { display: block; width: 390px; height: 0px; margin-left: 0px; margin-top: 0px; } input { display: inline; font-size: 14px; line-height: 20px; padding-left: 12px; padding-top: 8px; padding-right: 12px; padding-bottom: 8px; border-width: 1px; margin-left: 0px; margin-top: 0px; }", sheet):
        return 4

    var tree: layout.WebLayoutTree
    if !bridge.WebStyleLayoutBridgeBuildTree(document, sheet, root, tree):
        return 5
    if !layout.WebLayoutCompute(tree, root):
        return 6
    let fieldBox = findBoxIndex(tree, field)
    let fieldStyleIdx = layout.WebLayoutFindStyleIndex(tree, field)
    if fieldBox < 0 || fieldStyleIdx < 0:
        return 7
    if tree.styles[fieldStyleIdx].height != 38:
        echo(Fmt"input style height actual {tree.styles[fieldStyleIdx].height}")
        return 8
    if layout.WebLayoutBoxHeightAt(tree, fieldBox) != 38:
        echo(Fmt"input box height actual {layout.WebLayoutBoxHeightAt(tree, fieldBox)}")
        return 9
    return 0

fn runStyleLayoutBridgeTailwindButtonHeaderSmoke(): int32 =
    var document: web.WebDocument
    web.WebDocumentInit(document)
    let docNode = web.WebDocumentCreateDocumentNode(document)
    let root = web.WebDocumentCreateElement(document, "div")
    let header = web.WebDocumentCreateElement(document, "header")
    let button = web.WebDocumentCreateElement(document, "button")
    let icon = web.WebDocumentCreateElement(document, "span")
    if !web.WebDocumentAppendChild(document, docNode, root):
        return 1
    if !web.WebDocumentAppendChild(document, root, header):
        return 2
    if !web.WebDocumentAppendChild(document, header, button):
        return 3
    if !web.WebDocumentAppendChild(document, button, icon):
        return 4
    if !web.WebDocumentSetInlineStyleValue(document, root, "width", "390px"):
        return 5
    if !web.WebDocumentSetInlineStyleValue(document, header, "display", "flex"):
        return 6
    if !web.WebDocumentSetInlineStyleValue(document, header, "align-items", "center"):
        return 7
    if !web.WebDocumentSetInlineStyleValue(document, header, "justify-content", "space-between"):
        return 8
    if !web.WebDocumentSetInlineStyleValue(document, header, "padding-left", "16px"):
        return 9
    if !web.WebDocumentSetInlineStyleValue(document, header, "padding-right", "16px"):
        return 10
    if !web.WebDocumentSetInlineStyleValue(document, header, "padding-top", "16px"):
        return 11
    if !web.WebDocumentSetInlineStyleValue(document, header, "padding-bottom", "16px"):
        return 12
    if !web.WebDocumentSetInlineStyleValue(document, button, "padding-left", "8px"):
        return 13
    if !web.WebDocumentSetInlineStyleValue(document, button, "padding-right", "8px"):
        return 14
    if !web.WebDocumentSetInlineStyleValue(document, button, "padding-top", "8px"):
        return 15
    if !web.WebDocumentSetInlineStyleValue(document, button, "padding-bottom", "8px"):
        return 16
    if !web.WebDocumentSetInlineStyleValue(document, icon, "width", "22px"):
        return 17
    if !web.WebDocumentSetInlineStyleValue(document, icon, "height", "22px"):
        return 18

    var sheet: style.WebStyleSheet
    style.WebStyleSheetInit(sheet)
    var tree: layout.WebLayoutTree
    if !bridge.WebStyleLayoutBridgeBuildTree(document, sheet, root, tree):
        return 19
    if !layout.WebLayoutCompute(tree, root):
        return 20
    let headerBox = findBoxIndex(tree, header)
    let buttonBox = findBoxIndex(tree, button)
    if headerBox < 0 || buttonBox < 0:
        return 21
    if layout.WebLayoutBoxHeightAt(tree, buttonBox) != 38:
        echo(Fmt"button height actual {layout.WebLayoutBoxHeightAt(tree, buttonBox)}")
        return 22
    if layout.WebLayoutBoxHeightAt(tree, headerBox) != 70:
        echo(Fmt"header height actual {layout.WebLayoutBoxHeightAt(tree, headerBox)}")
        return 23
    return 0

fn runRasterCornerRadiusSmoke(): int32 =
    var surface: raster.RasterSurface
    raster.RasterSurfaceInit(surface)
    let white = int32(0xFFFFFFFF)
    let red = int32(0xFFFF0000)
    if !raster.RasterResize(surface, 8, 8, white):
        return 1
    var op = paint.PaintOpMakeFillRect(0, 0, 8, 8, red)
    op.borderTopLeftRadius = 4
    op.borderTopRightRadius = 4
    op.borderBottomRightRadius = 0
    op.borderBottomLeftRadius = 0
    var ops: paint.PaintOp[]
    add(ops, op)
    if !raster.RasterPaintOps(surface, ops):
        echo(raster.RasterLastError(surface))
        return 2
    if raster.RasterPixelAt(surface, 0, 0) != white:
        return 3
    if raster.RasterPixelAt(surface, 7, 0) != white:
        return 4
    if raster.RasterPixelAt(surface, 0, 7) != red:
        return 5
    if raster.RasterPixelAt(surface, 7, 7) != red:
        return 6
    return 0

fn main(): int32 =
    let code = runStyleLayoutBridgeSmoke()
    if code != 0:
        echo(Fmt"FAIL runStyleLayoutBridgeSmoke: {code}")
        return code
    let gapCode = runStyleLayoutBridgeGapSmoke()
    if gapCode != 0:
        echo(Fmt"FAIL runStyleLayoutBridgeGapSmoke: {gapCode}")
        return gapCode
    let masonryCode = runStyleLayoutBridgeMasonrySmoke()
    if masonryCode != 0:
        echo(Fmt"FAIL runStyleLayoutBridgeMasonrySmoke: {masonryCode}")
        return masonryCode
    let flexShrinkCode = runStyleLayoutBridgeFlexShrinkSmoke()
    if flexShrinkCode != 0:
        echo(Fmt"FAIL runStyleLayoutBridgeFlexShrinkSmoke: {flexShrinkCode}")
        return flexShrinkCode
    let alignCode = runStyleLayoutBridgeTextAlignSmoke()
    if alignCode != 0:
        echo(Fmt"FAIL runStyleLayoutBridgeTextAlignSmoke: {alignCode}")
        return alignCode
    let fontSizeCode = runStyleLayoutBridgeFontSizeSmoke()
    if fontSizeCode != 0:
        echo(Fmt"FAIL runStyleLayoutBridgeFontSizeSmoke: {fontSizeCode}")
        return fontSizeCode
    let lineHeightCode = runStyleLayoutBridgeLineHeightSmoke()
    if lineHeightCode != 0:
        echo(Fmt"FAIL runStyleLayoutBridgeLineHeightSmoke: {lineHeightCode}")
        return lineHeightCode
    let unitlessLineHeightCode = runStyleLayoutBridgeUnitlessInheritedLineHeightSmoke()
    if unitlessLineHeightCode != 0:
        echo(Fmt"FAIL runStyleLayoutBridgeUnitlessInheritedLineHeightSmoke: {unitlessLineHeightCode}")
        return unitlessLineHeightCode
    let inlineParentStrutCode = runStyleLayoutBridgeInlineParentStrutSmoke()
    if inlineParentStrutCode != 0:
        echo(Fmt"FAIL runStyleLayoutBridgeInlineParentStrutSmoke: {inlineParentStrutCode}")
        return inlineParentStrutCode
    let borderAutoHeightCode = runStyleLayoutBridgeBorderAutoHeightSmoke()
    if borderAutoHeightCode != 0:
        echo(Fmt"FAIL runStyleLayoutBridgeBorderAutoHeightSmoke: {borderAutoHeightCode}")
        return borderAutoHeightCode
    let inputAutoHeightCode = runStyleLayoutBridgeInputAutoHeightSmoke()
    if inputAutoHeightCode != 0:
        echo(Fmt"FAIL runStyleLayoutBridgeInputAutoHeightSmoke: {inputAutoHeightCode}")
        return inputAutoHeightCode
    let classTokenCode = runStyleLayoutBridgeClassTokenSmoke()
    if classTokenCode != 0:
        echo(Fmt"FAIL runStyleLayoutBridgeClassTokenSmoke: {classTokenCode}")
        return classTokenCode
    let computedPrecedenceCode = runStyleLayoutBridgeComputedPrecedenceSmoke()
    if computedPrecedenceCode != 0:
        echo(Fmt"FAIL runStyleLayoutBridgeComputedPrecedenceSmoke: {computedPrecedenceCode}")
        return computedPrecedenceCode
    let generatedCssCode = runStyleLayoutBridgeGeneratedCssSmoke()
    if generatedCssCode != 0:
        echo(Fmt"FAIL runStyleLayoutBridgeGeneratedCssSmoke: {generatedCssCode}")
        return generatedCssCode
    let gridColsCode = runStyleLayoutBridgeGridColsSmoke()
    if gridColsCode != 0:
        echo(Fmt"FAIL runStyleLayoutBridgeGridColsSmoke: {gridColsCode}")
        return gridColsCode
    let percentWidthCode = runStyleLayoutBridgePercentWidthSmoke()
    if percentWidthCode != 0:
        echo(Fmt"FAIL runStyleLayoutBridgePercentWidthSmoke: {percentWidthCode}")
        return percentWidthCode
    let buttonHeaderCode = runStyleLayoutBridgeTailwindButtonHeaderSmoke()
    if buttonHeaderCode != 0:
        echo(Fmt"FAIL runStyleLayoutBridgeTailwindButtonHeaderSmoke: {buttonHeaderCode}")
        return buttonHeaderCode
    let rasterCornerCode = runRasterCornerRadiusSmoke()
    if rasterCornerCode != 0:
        echo(Fmt"FAIL runRasterCornerRadiusSmoke: {rasterCornerCode}")
        return rasterCornerCode
    echo("web_runtime_style_layout_smoke ok")
    return 0
