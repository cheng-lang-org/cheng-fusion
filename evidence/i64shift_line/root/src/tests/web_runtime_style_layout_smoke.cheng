fn runStyleLayoutBridgeClassTokenSmoke(): int32 =
    var document: web.WebDocument
    web.WebDocumentInit(document)
    let docNode = web.WebDocumentCreateDocumentNode(document)
    let root = web.WebDocumentCreateElement(document, "div")
    let hidden = web.WebDocumentCreateElement(document, "span")
    if !web.WebDocumentAppendChild(document, docNode, root):
        return 1
    if !web.WebDocumentAppendChild(document, root, hidden):
        return 2
    if !web.WebDocumentSetAttribute(document, root, "class", "bg-white overflow-hidden truncate"):
        return 3
    if !web.WebDocumentSetAttribute(document, hidden, "class", "hidden"):
        return 4

    var sheet: style.WebStyleSheet
    style.WebStyleSheetInit(sheet)
    if !style.WebStyleSheetParse("div { display: block; width: 100px; height: 10px; margin-left: 0px; margin-top: 0px; } span { display: block; width: 10px; height: 10px; margin-left: 0px; margin-top: 0px; } .hidden { display: none; } .overflow-hidden { overflow: hidden; } .truncate { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }", sheet):
        return 5

    var rootStyle: style.WebComputedStyle
    if !style.WebStyleSheetComputeStyle(document, sheet, root, rootStyle):
        return 6
    if style.WebComputedStyleDisplayEquals(rootStyle, "none"):
        return 7
    if !style.WebComputedStyleOverflowEquals(rootStyle, "hidden"):
        return 8
    if !style.WebComputedStyleTextOverflowEquals(rootStyle, "ellipsis"):
        return 15
    if !style.WebComputedStyleWhiteSpaceEquals(rootStyle, "nowrap"):
        return 16

    var hiddenStyle: style.WebComputedStyle
    if !style.WebStyleSheetComputeStyle(document, sheet, hidden, hiddenStyle):
        return 9
    if !style.WebComputedStyleDisplayEquals(hiddenStyle, "none"):
        return 10

    var tree: layout.WebLayoutTree
    if !bridge.WebStyleLayoutBridgeBuildTree(document, sheet, root, tree):
        return 11
    if !layout.WebLayoutCompute(tree, root):
        return 12
    if layout.WebLayoutBoxCount(tree) != 1:
        return 13
    if layout.WebLayoutBoxNodeAt(tree, 0) != root:
        return 14
    let rootIdx = layout.WebLayoutFindStyleIndex(tree, root)
    if rootIdx < 0:
        return 17
    if !tree.styles[rootIdx].textOverflowEllipsis:
        return 18
    if !tree.styles[rootIdx].whiteSpaceNowrap:
        return 19
    return 0

fn runStyleLayoutBridgeComputedPrecedenceSmoke(): int32 =
    var document: web.WebDocument
    web.WebDocumentInit(document)
    let docNode = web.WebDocumentCreateDocumentNode(document)
    let root = web.WebDocumentCreateElement(document, "div")
    let overlay = web.WebDocumentCreateElement(document, "div")
    let panel = web.WebDocumentCreateElement(document, "div")
    if !web.WebDocumentAppendChild(document, docNode, root):
        return 1
    if !web.WebDocumentAppendChild(document, root, overlay):
        return 2
    if !web.WebDocumentAppendChild(document, overlay, panel):
        return 3
    if !web.WebDocumentSetAttribute(document, overlay, "class", "fixed inset-0 bg-black bg-opacity-50 z-50 flex items-end"):
        return 4
    if !web.WebDocumentSetAttribute(document, panel, "class", "bg-white w-full rounded-t-3xl overflow-hidden"):
        return 5
    if !web.WebDocumentSetInlineStyleValue(document, root, "display", "block"):
        return 6
    if !web.WebDocumentSetInlineStyleValue(document, root, "width", "390px"):
        return 7
    if !web.WebDocumentSetInlineStyleValue(document, root, "height", "844px"):
        return 8
    if !web.WebDocumentSetInlineStyleValue(document, overlay, "display", "flex"):
        return 9
    if !web.WebDocumentSetInlineStyleValue(document, overlay, "position", "fixed"):
        return 10
    if !web.WebDocumentSetInlineStyleValue(document, overlay, "width", "390px"):
        return 11
    if !web.WebDocumentSetInlineStyleValue(document, overlay, "height", "844px"):
        return 12
    if !web.WebDocumentSetInlineStyleValue(document, overlay, "align-items", "flex-end"):
        return 13
    if !web.WebDocumentSetInlineStyleValue(document, panel, "display", "block"):
        return 14
    if !web.WebDocumentSetInlineStyleValue(document, panel, "position", "static"):
        return 15
    if !web.WebDocumentSetInlineStyleValue(document, panel, "width", "390px"):
        return 16
    if !web.WebDocumentSetInlineStyleValue(document, panel, "height", "200px"):
        return 17
    if !web.WebDocumentSetInlineStyleValue(document, panel, "overflow", "hidden"):
        return 18

    var sheet: style.WebStyleSheet
    style.WebStyleSheetInit(sheet)
    if !style.WebStyleSheetParse("", sheet):
        return 19

    var tree: layout.WebLayoutTree
    if !bridge.WebStyleLayoutBridgeBuildTree(document, sheet, root, tree):
        return 20
    let overlayStyleIdx = layout.WebLayoutFindStyleIndex(tree, overlay)
    if overlayStyleIdx < 0:
        return 21
    if tree.styles[overlayStyleIdx].alignItems != layout.WebLayoutAlignItemsFlexEnd:
        return 22
    let panelStyleIdx = layout.WebLayoutFindStyleIndex(tree, panel)
    if panelStyleIdx < 0:
        return 23
    if tree.styles[panelStyleIdx].display != layout.WebLayoutDisplayBlock:
        return 24
    if tree.styles[panelStyleIdx].position != layout.WebLayoutPositionStatic:
        return 25
    if !layout.WebLayoutCompute(tree, root):
        return 26
    if layout.WebLayoutBoxCount(tree) != 3:
        return 27
    return 0

fn runStyleLayoutBridgeGeneratedCssSmoke(): int32 =
    var document: web.WebDocument
    web.WebDocumentInit(document)
    let docNode = web.WebDocumentCreateDocumentNode(document)
    let root = web.WebDocumentCreateElement(document, "div")
    if !web.WebDocumentAppendChild(document, docNode, root):
        return 1
    if !web.WebDocumentSetAttribute(document, root, "class", "z-[60] ml-auto shadow"):
        return 2

    var sheet: style.WebStyleSheet
    style.WebStyleSheetInit(sheet)
    if !style.WebStyleSheetParse(".z-\\[60\\]{z-index:60}.ml-auto{margin-left:auto}.shadow{box-shadow:0 1px 3px 0 rgba(0,0,0,0.1)}", sheet):
        return 3
    var computed: style.WebComputedStyle
    if !style.WebStyleSheetComputeStyle(document, sheet, root, computed):
        return 4
    var z: int32
    if !style.WebComputedStyleZIndexInt(computed, z):
        return 5
    if z != 60:
        return 6
    if !style.WebComputedStyleMarginLeftEquals(computed, "auto"):
        return 7
    var shadow: str
    if !style.WebComputedStyleBoxShadowStr(computed, shadow):
        return 8
    return 0

fn runStyleLayoutBridgeGridColsSmoke(): int32 =
    var document: web.WebDocument
    web.WebDocumentInit(document)
    let docNode = web.WebDocumentCreateDocumentNode(document)
    let root = web.WebDocumentCreateElement(document, "div")
    if !web.WebDocumentAppendChild(document, docNode, root):
        return 1
    if !web.WebDocumentSetAttribute(document, root, "class", "grid grid-cols-4 gap-3"):
        return 2
    if !web.WebDocumentSetInlineStyleValue(document, root, "width", "390px"):
        return 3
    var childIds: int32[]
    for i in 0..<10:
        let child = web.WebDocumentCreateElement(document, "button")
        add(childIds, child)
        if !web.WebDocumentAppendChild(document, root, child):
            return 4
        if !web.WebDocumentSetInlineStyleValue(document, child, "height", "24px"):
            return 5

    var sheet: style.WebStyleSheet
    style.WebStyleSheetInit(sheet)
    if !style.WebStyleSheetParse(".grid{display:grid}.grid-cols-4{grid-template-columns:25% 25% 25% 25%}.gap-3{gap:12px}", sheet):
        return 6

    var computed: style.WebComputedStyle
    if !style.WebStyleSheetComputeStyle(document, sheet, root, computed):
        return 7
    var cols: str
    if !style.WebComputedStyleGridTemplateColumnsStr(computed, cols):
        return 8
    if cols != "25% 25% 25% 25%":
        return 9

    var tree: layout.WebLayoutTree
    if !bridge.WebStyleLayoutBridgeBuildTree(document, sheet, root, tree):
        return 10
    if tree.gridTracks.len != 4:
        return 11
    if !layout.WebLayoutCompute(tree, root):
        return 12
    if layout.WebLayoutBoxCount(tree) != 11:
        return 13
    if layout.WebLayoutBoxWidthAt(tree, 1) != 88:
        return 14
    if layout.WebLayoutBoxXAt(tree, 1) != 0:
        return 15
    if layout.WebLayoutBoxXAt(tree, 2) != 100:
        return 16
    if layout.WebLayoutBoxXAt(tree, 3) != 201:
        return 17
    if layout.WebLayoutBoxXAt(tree, 4) != 301:
        return 18
    if layout.WebLayoutBoxYAt(tree, 5) != 36:
        return 19
    if layout.WebLayoutBoxHeightAt(tree, 0) != 96:
        return 20
    for ci in 0..<childIds.len:
        var found = false
        for bi in 0..<tree.boxes.len:
            if tree.boxes[bi].nodeId == childIds[ci]:
                found = true
                break
        if !found:
            return 21
    return 0

fn runStyleLayoutBridgePercentWidthSmoke(): int32 =
    var document: web.WebDocument
    web.WebDocumentInit(document)
    let docNode = web.WebDocumentCreateDocumentNode(document)
    let root = web.WebDocumentCreateElement(document, "div")
    let card = web.WebDocumentCreateElement(document, "div")
