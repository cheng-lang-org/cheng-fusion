        return 7
    if layout.WebLayoutBoxYAt(tree, 1) != 0:
        return 8
    if layout.WebLayoutBoxYAt(tree, 2) != 18:
        return 9
    if layout.WebLayoutBoxHeightAt(tree, 0) != 28:
        return 10
    return 0

fn runStyleLayoutBridgeMasonrySmoke(): int32 =
    var document: web.WebDocument
    web.WebDocumentInit(document)
    let docNode = web.WebDocumentCreateDocumentNode(document)
    let root = web.WebDocumentCreateElement(document, "div")
    let first = web.WebDocumentCreateElement(document, "article")
    let second = web.WebDocumentCreateElement(document, "article")
    let third = web.WebDocumentCreateElement(document, "article")
    let fourth = web.WebDocumentCreateElement(document, "article")
    if !web.WebDocumentAppendChild(document, docNode, root):
        return 1
    if !web.WebDocumentAppendChild(document, root, first):
        return 2
    if !web.WebDocumentAppendChild(document, root, second):
        return 3
    if !web.WebDocumentAppendChild(document, root, third):
        return 4
    if !web.WebDocumentAppendChild(document, root, fourth):
        return 5
    if !web.WebDocumentSetAttribute(document, root, "id", "root"):
        return 6
    if !web.WebDocumentSetAttribute(document, root, "data-csg-masonry-min-column-width", "40"):
        return 7
    if !web.WebDocumentSetAttribute(document, root, "data-csg-masonry-min-columns", "2"):
        return 8
    if !web.WebDocumentSetAttribute(document, root, "data-csg-masonry-max-columns", "3"):
        return 9
    if !web.WebDocumentSetAttribute(document, root, "data-csg-masonry-estimated-item-height", "200"):
        return 10
    if !web.WebDocumentSetAttribute(document, first, "id", "first"):
        return 11
    if !web.WebDocumentSetAttribute(document, second, "id", "second"):
        return 12
    if !web.WebDocumentSetAttribute(document, third, "id", "third"):
        return 13
    if !web.WebDocumentSetAttribute(document, fourth, "id", "fourth"):
        return 14

    var sheet: style.WebStyleSheet
    style.WebStyleSheetInit(sheet)
    if !style.WebStyleSheetParse("#root { display: masonry; width: 100px; gap: 10px; margin-left: 0px; margin-top: 0px; } article { display: block; width: 0px; margin-left: 0px; margin-top: 0px; } #first { height: 50px; } #second { height: 20px; } #third { height: 30px; } #fourth { height: 10px; }", sheet):
        return 15

    var tree: layout.WebLayoutTree
    if !bridge.WebStyleLayoutBridgeBuildTree(document, sheet, root, tree):
        return 16
    let rootStyleIdx = layout.WebLayoutFindStyleIndex(tree, root)
    if rootStyleIdx < 0:
        return 17
    if tree.styles[rootStyleIdx].display != layout.WebLayoutDisplayMasonry:
        return 18
    if tree.styles[rootStyleIdx].masonryMinColumnWidth != 40:
        return 19
    if tree.styles[rootStyleIdx].masonryMinColumns != 2:
        return 20
    if tree.styles[rootStyleIdx].masonryMaxColumns != 3:
        return 21
    if tree.styles[rootStyleIdx].masonryEstimatedItemHeight != 200:
        return 22
    if tree.styles[rootStyleIdx].gap != 10:
        return 23
    if !layout.WebLayoutCompute(tree, root):
        return 24
    if layout.WebLayoutBoxCount(tree) != 5:
        return 25
    if layout.WebLayoutBoxXAt(tree, 1) != 0 || layout.WebLayoutBoxYAt(tree, 1) != 0:
        return 26
    if layout.WebLayoutBoxXAt(tree, 2) != 55 || layout.WebLayoutBoxYAt(tree, 2) != 0:
        return 27
    if layout.WebLayoutBoxXAt(tree, 3) != 55 || layout.WebLayoutBoxYAt(tree, 3) != 30:
        return 28
    if layout.WebLayoutBoxXAt(tree, 4) != 0 || layout.WebLayoutBoxYAt(tree, 4) != 60:
        return 29
    if layout.WebLayoutBoxHeightAt(tree, 0) != 70:
        echo(Fmt"bridge masonry rootH={layout.WebLayoutBoxHeightAt(tree, 0)}")
        return 30
    return 0

fn runStyleLayoutBridgeFlexShrinkSmoke(): int32 =
    var document: web.WebDocument
    web.WebDocumentInit(document)
    let docNode = web.WebDocumentCreateDocumentNode(document)
    let root = web.WebDocumentCreateElement(document, "div")
    let fixed = web.WebDocumentCreateElement(document, "button")
    let flexible = web.WebDocumentCreateElement(document, "button")
    if !web.WebDocumentAppendChild(document, docNode, root):
        return 1
    if !web.WebDocumentAppendChild(document, root, fixed):
        return 2
    if !web.WebDocumentAppendChild(document, root, flexible):
        return 3
    if !web.WebDocumentSetAttribute(document, fixed, "class", "chip shrink-0"):
        return 4
    if !web.WebDocumentSetAttribute(document, flexible, "class", "chip"):
        return 5

    var sheet: style.WebStyleSheet
    style.WebStyleSheetInit(sheet)
    if !style.WebStyleSheetParse("div { display: flex; width: 100px; height: 0px; margin-left: 0px; margin-top: 0px; } .chip { display: block; width: 80px; height: 10px; margin-left: 0px; margin-top: 0px; } .shrink-0 { flex-shrink: 0; }", sheet):
        return 6

    var tree: layout.WebLayoutTree
    if !bridge.WebStyleLayoutBridgeBuildTree(document, sheet, root, tree):
        return 7
    if !layout.WebLayoutCompute(tree, root):
        return 8
    let fixedBox = findBoxIndex(tree, fixed)
    let flexibleBox = findBoxIndex(tree, flexible)
    let fixedStyleIdx = layout.WebLayoutFindStyleIndex(tree, fixed)
    let flexibleStyleIdx = layout.WebLayoutFindStyleIndex(tree, flexible)
    if fixedBox < 0 || flexibleBox < 0 || fixedStyleIdx < 0 || flexibleStyleIdx < 0:
        return 9
    if tree.styles[fixedStyleIdx].flexShrink != 0:
        return 10
    if tree.styles[flexibleStyleIdx].flexShrink != 1:
        return 11
    if layout.WebLayoutBoxWidthAt(tree, fixedBox) != 80:
        echo(Fmt"fixed shrink-0 width actual {layout.WebLayoutBoxWidthAt(tree, fixedBox)}")
        return 12
    if layout.WebLayoutBoxWidthAt(tree, flexibleBox) != 20:
        echo(Fmt"flexible width actual {layout.WebLayoutBoxWidthAt(tree, flexibleBox)}")
        return 13
    return 0

fn runStyleLayoutBridgeTextAlignSmoke(): int32 =
    var document: web.WebDocument
