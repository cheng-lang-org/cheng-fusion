        return 4

    var tree: layout.WebLayoutTree
    if !bridge.WebStyleLayoutBridgeBuildTree(document, sheet, root, tree):
        return 5
    if !layout.WebLayoutCompute(tree, root):
        return 6
    if layout.WebLayoutBoxCount(tree) != 3:
        return 7
    if layout.WebLayoutBoxXAt(tree, 1) != 0:
        return 8
    if layout.WebLayoutBoxWidthAt(tree, 1) != 100:
        return 9
    if layout.WebLayoutBoxNodeAt(tree, 2) != text:
        return 10
    let textStyleIdx = layout.WebLayoutFindStyleIndex(tree, text)
    if textStyleIdx < 0:
        return 11
    if tree.styles[textStyleIdx].textContent != "abc":
        return 12
