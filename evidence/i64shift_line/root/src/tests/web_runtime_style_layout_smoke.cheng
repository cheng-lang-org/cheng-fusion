import cheng/core/runtime/web_runtime as web
import cheng/core/runtime/web_style_runtime as style
import cheng/core/runtime/web_layout_runtime as layout
import cheng/core/runtime/web_style_layout_bridge as bridge
import cheng/core/runtime/web_paint_runtime as paint
import cheng/core/runtime/web_raster_runtime as raster

fn BuildDocument(document: var web.WebDocument, root: var int32, child: var int32, hidden: var int32): bool =
    web.WebDocumentInit(document)
    let docNode = web.WebDocumentCreateDocumentNode(document)
    root = web.WebDocumentCreateElement(document, "div")
    child = web.WebDocumentCreateElement(document, "button")
    hidden = web.WebDocumentCreateElement(document, "span")
    if !web.WebDocumentAppendChild(document, docNode, root):
        return false
    if !web.WebDocumentAppendChild(document, root, child):
        return false
    if !web.WebDocumentAppendChild(document, root, hidden):
        return false
    if !web.WebDocumentSetAttribute(document, root, "id", "root"):
        return false
    if !web.WebDocumentSetAttribute(document, child, "id", "run"):
        return false
    if !web.WebDocumentSetAttribute(document, child, "class", "primary"):
        return false
    if !web.WebDocumentSetAttribute(document, hidden, "class", "hidden"):
        return false
    return true

fn runStyleLayoutBridgeSmoke(): int32 =
    var document: web.WebDocument
    var root = 0
    var child = 0
    var hidden = 0
    if !BuildDocument(document, root, child, hidden):
        return 1

    var sheet: style.WebStyleSheet
    style.WebStyleSheetInit(sheet)
    if !style.WebStyleSheetParse("div { display: block; width: 200px; height: 100px; margin-left: 3px; margin-top: 5px; } button { display: block; width: 40px; height: 10px; margin-left: 7px; margin-top: 11px; } .primary { width: 50px; } #run { height: 12px; } .hidden { display: none; width: 9px; height: 9px; margin-left: 1px; margin-top: 1px; }", sheet):
        return 2

    var computed: style.WebComputedStyle
    if !style.WebStyleSheetComputeStyle(document, sheet, child, computed):
        return 3
    if !style.WebComputedStyleWidthEquals(computed, "50px"):
        return 4
    if !style.WebComputedStyleHeightEquals(computed, "12px"):
        return 5
    if !style.WebComputedStyleMarginLeftEquals(computed, "7px"):
        return 6
    if !style.WebComputedStyleMarginTopEquals(computed, "11px"):
        return 7

    var tree: layout.WebLayoutTree
    if !bridge.WebStyleLayoutBridgeBuildTree(document, sheet, root, tree):
        return 8
    if !layout.WebLayoutCompute(tree, root):
        return 9
    if layout.WebLayoutBoxCount(tree) != 2:
        return 10
    if layout.WebLayoutBoxNodeAt(tree, 0) != root:
        return 11
    if layout.WebLayoutBoxXAt(tree, 0) != 3:
        return 12
    if layout.WebLayoutBoxYAt(tree, 0) != 5:
        return 13
    if layout.WebLayoutBoxWidthAt(tree, 0) != 200:
        return 14
    if layout.WebLayoutBoxHeightAt(tree, 0) != 100:
        return 15
    if layout.WebLayoutBoxNodeAt(tree, 1) != child:
        return 16
    if layout.WebLayoutBoxXAt(tree, 1) != 10:
        return 17
    if layout.WebLayoutBoxYAt(tree, 1) != 16:
        return 18
    if layout.WebLayoutBoxWidthAt(tree, 1) != 50:
        return 19
    if layout.WebLayoutBoxHeightAt(tree, 1) != 12:
        return 20

    var badSheet: style.WebStyleSheet
    if style.WebStyleSheetParse("div { display: block; width: auto; height: 100px; margin-left: 0px; margin-top: 0px; }", badSheet):
        return 21
    if !style.WebStyleSheetParse("div { display: block; width: 10px; margin-left: 0px; margin-top: 0px; } button { display: block; width: 1px; height: 1px; margin-left: 0px; margin-top: 0px; } .hidden { display: none; width: 1px; height: 1px; margin-left: 0px; margin-top: 0px; }", badSheet):
        return 22
    if !bridge.WebStyleLayoutBridgeBuildTree(document, badSheet, root, tree):
        return 23
    if !style.WebStyleSheetParse("div { display: table; width: 10px; height: 10px; margin-left: 0px; margin-top: 0px; } button { display: block; width: 1px; height: 1px; margin-left: 0px; margin-top: 0px; } .hidden { display: none; width: 1px; height: 1px; margin-left: 0px; margin-top: 0px; }", badSheet):
        return 24
    if !bridge.WebStyleLayoutBridgeBuildTree(document, badSheet, root, tree):
        return 25
    return 0

