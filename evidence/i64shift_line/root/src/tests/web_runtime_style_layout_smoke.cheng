    if tree.styles[textStyleIdx].textAlign != layout.WebLayoutTextAlignCenter:
        return 14
    if layout.WebLayoutBoxXAt(tree, 2) != 36:
        echo(Fmt"text align center x actual {layout.WebLayoutBoxXAt(tree, 2)}")
        return 15
    return 0

