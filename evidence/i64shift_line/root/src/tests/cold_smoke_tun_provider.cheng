import std/system

@importc("cheng_tun_open_utun_bridge")
fn tunOpenUtun(): int32

fn main(): int32 =
    let fd: int32 = tunOpenUtun()
    if fd >= 0:
        echo("cold_smoke_tun_provider ok")
        return 0
    echo("cold_smoke_tun_provider: utun not available (fd=" + IntToStr(fd) + ")")
    return 1
