import cheng/tests/cold_aggregate_field_store_left as left
import cheng/tests/cold_aggregate_field_store_right as right

type
    ColdAggregateObjectRefNegativeHolder =
        borrowed: var left.AggregateIdentity

fn ColdAggregateStoreWrongBorrowed(holder: var ColdAggregateObjectRefNegativeHolder,
                                   payload: var right.AggregateIdentity) =
    holder.borrowed = payload

fn main(): int32 =
    var payload = right.AggregateIdentity(label: "wrong", values: [1, 2, 3, 4])
    var holder: ColdAggregateObjectRefNegativeHolder
    ColdAggregateStoreWrongBorrowed(holder, payload)
    return 0

