# econ gov migration smoke: oracle trimmed-mean aggregation, reward
# window dedup and pool exhaustion, penalty capping, risk pause/limit
# dominance, governance bp bounds.

import std/os
import std/system
import cheng/std/bytes_layout as layout
import cheng/apps/rwad/rwad_settlement as ssm
import cheng/apps/rwad/rwad_oracle_risk as eco

fn Acct(b: int32): layout.FixedBytes32 =
    var raw = BytesAlloc(32)
    BytesSet(raw, 0, b)
    let res = layout.FixedBytes32FromBytes(raw)
    return res.value

fn main(): int32 =
    var rc: int32 = 0
    var st = ssm.SsmInit()
    var eco0 = eco.EcoInit()

    # --- trimmed mean: 5 prices {100,200,300,400,500} -> drop 100+500 -> 300 ---
    let pair = Acct(50)
    let t1 = eco.EcoUpdateAggregate(eco0, pair, Int64(100), Int64(1000))
    let t2 = eco.EcoUpdateAggregate(eco0, pair, Int64(200), Int64(11000))
    let t3 = eco.EcoUpdateAggregate(eco0, pair, Int64(300), Int64(21000))
    let t4 = eco.EcoUpdateAggregate(eco0, pair, Int64(400), Int64(31000))
    let t5 = eco.EcoUpdateAggregate(eco0, pair, Int64(500), Int64(41000))
    if !t1.ok or !t2.ok or !t3.ok or !t4.ok or !t5.ok:
        os.WriteLine(os.Get_stderr(), "aggregate updates failed")
        rc = rc + 1
    let mean5 = eco.EcoTrimmedMean(eco0, pair)
    if !mean5.ok or mean5.value != 300:
        os.WriteLine(os.Get_stderr(), "trimmed mean of five wrong")
        rc = rc + 1

    # two samples: plain mean {100,200} on a fresh pair -> 150
    let pair2 = Acct(51)
    let u1 = eco.EcoUpdateAggregate(eco0, pair2, Int64(100), Int64(1000))
    let u2 = eco.EcoUpdateAggregate(eco0, pair2, Int64(200), Int64(2000))
    if !u1.ok or !u2.ok:
        rc = rc + 1
    let mean2 = eco.EcoTrimmedMean(eco0, pair2)
    if !mean2.ok or mean2.value != 150:
        os.WriteLine(os.Get_stderr(), "plain mean of two wrong")
        rc = rc + 1

    # stale window resets the aggregate: next tick after the window is alone
    let stale = eco.EcoUpdateAggregate(eco0, pair, Int64(900), Int64(41000) + eco0.oracleWindowMs + Int64(1))
    if !stale.ok:
        rc = rc + 1
    let meanStale = eco.EcoTrimmedMean(eco0, pair)
    if !meanStale.ok or meanStale.value != 900:
        os.WriteLine(os.Get_stderr(), "stale window did not reset aggregate")
        rc = rc + 1

    # --- rewards: window dedup, then payout from a funded pool ---
    let signer = Acct(60)
    eco0.oracleRewardAmount = Int64(7)
    st.pools.rewardPool = Int64(21)
    let r1 = eco.EcoMaybeReward(st, eco0, signer, 0, Int64(100000))
    if !r1.ok:
        rc = rc + 1
    # within the window of the previous payout: no second reward
    let r2 = eco.EcoMaybeReward(st, eco0, signer, Int64(100000), Int64(130000))
    if !r2.ok:
        rc = rc + 1
    if ssm.SsmBalanceOf(st, signer) != 7:
        os.WriteLine(os.Get_stderr(), "reward dedup broken")
        rc = rc + 1
    # at exactly the window boundary (now - prev == window) a new reward
    # lands per the original `< minWindow` skip rule; pool drains 21 -> 7.
    let r3 = eco.EcoMaybeReward(st, eco0, signer, Int64(100000), Int64(100000) + eco0.oracleWindowMs)
    if !r3.ok:
        rc = rc + 1
    if ssm.SsmBalanceOf(st, signer) != 14:
        os.WriteLine(os.Get_stderr(), "second reward missing")
        rc = rc + 1
    if st.pools.rewardPool != 7:
        os.WriteLine(os.Get_stderr(), "reward pool debit wrong")
        rc = rc + 1
    # exhausted pool: silent no-op per original semantics
    st.pools.rewardPool = 0
    let r4 = eco.EcoMaybeReward(st, eco0, signer, 0, Int64(999999))
    if !r4.ok:
        os.WriteLine(os.Get_stderr(), "empty pool errored instead of skipping")
        rc = rc + 1
    if ssm.SsmBalanceOf(st, signer) != 14:
        os.WriteLine(os.Get_stderr(), "empty pool paid out")
        rc = rc + 1

    # --- penalty: capped at balance, lands in safety fund ---
    eco0.oraclePenaltyAmount = Int64(500)
    let pen = eco.EcoApplyPenalty(st, eco0, signer)
    if !pen.ok:
        rc = rc + 1
    # balance was 14 -> charged 14, safetyFund += 14
    if ssm.SsmBalanceOf(st, signer) != 0:
        os.WriteLine(os.Get_stderr(), "penalty did not drain balance")
        rc = rc + 1
    if st.pools.safetyFund != 14:
        os.WriteLine(os.Get_stderr(), "penalty not credited to safety fund")
        rc = rc + 1

    # --- risk: global dominance, limit preservation ---
    let globalScope = Acct(70)
    let scopeA = Acct(71)
    let emptyScope = Acct(255)
    BytesSet(layout.FixedBytes32ToBytes(emptyScope), 0, 255)
    let pG = eco.EcoApplyRiskPause(eco0, globalScope, true, emptyScope)
    if !pG.ok:
        rc = rc + 1
    if !eco.EcoIsPaused(eco0, globalScope, scopeA):
        os.WriteLine(os.Get_stderr(), "global pause not dominant")
        rc = rc + 1
    let pOff = eco.EcoApplyRiskPause(eco0, globalScope, false, emptyScope)
    if !pOff.ok:
        rc = rc + 1
    let limA = eco.EcoApplyRiskLimit(eco0, scopeA, Int64(12345), emptyScope)
    if !limA.ok:
        rc = rc + 1
    # pausing scope A must preserve its limit
    let pA = eco.EcoApplyRiskPause(eco0, scopeA, true, emptyScope)
    if !pA.ok:
        rc = rc + 1
    if eco.EcoGetLimit(eco0, scopeA) != 12345:
        os.WriteLine(os.Get_stderr(), "limit lost across pause update")
        rc = rc + 1
    if !eco.EcoIsPaused(eco0, globalScope, scopeA):
        os.WriteLine(os.Get_stderr(), "scope pause not visible")
        rc = rc + 1
    # untouched scope is neither paused nor limited
    let scopeB = Acct(72)
    if eco.EcoIsPaused(eco0, globalScope, scopeB):
        os.WriteLine(os.Get_stderr(), "untouched scope paused")
        rc = rc + 1
    if eco.EcoGetLimit(eco0, scopeB) != 0:
        os.WriteLine(os.Get_stderr(), "untouched scope limited")
        rc = rc + 1
    # blacklist round trip
    let bl = eco.EcoBlacklist(eco0, Acct(80), true)
    if !bl.ok or !eco.EcoIsBlacklisted(eco0, Acct(80)):
        os.WriteLine(os.Get_stderr(), "blacklist set failed")
        rc = rc + 1

    # --- governance: whitelist keys and bp bound ---
    let gOk = eco.EcoGovSetBp(st, 2, 450)
    if !gOk.ok or st.params.burnBp != 450:
        os.WriteLine(os.Get_stderr(), "gov burn bp write failed")
        rc = rc + 1
    let gHigh = eco.EcoGovSetBp(st, 1, 20000)
    if gHigh.ok:
        os.WriteLine(os.Get_stderr(), "bp above 10000 accepted")
        rc = rc + 1
    let gKey = eco.EcoGovSetBp(st, 9, 100)
    if gKey.ok:
        os.WriteLine(os.Get_stderr(), "unknown param key accepted")
        rc = rc + 1

    if rc == 0:
        echo("econ_gov_migration_smoke ok")
    return rc
