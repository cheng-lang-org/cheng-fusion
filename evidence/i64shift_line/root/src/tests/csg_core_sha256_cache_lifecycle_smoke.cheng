import std/crypto/sha256 as sha256
import std/rawbytes as rawbytes
import std/system as system

fn main(): int32 =
    assert(system.RuntimeAllocationLedgerSupported(),
           " sha256 cache lifecycle: ledger unsupported")
    let opened = system.RuntimeAllocationLedgerBegin(
        "cheng.csg_core.sha256_cache_lifecycle",
        uint64(268435456))
    assert(opened.ok, opened.error)

    var input = rawbytes.BytesAlloc(3)
    rawbytes.BytesSet(input, 0, 0x61)
    rawbytes.BytesSet(input, 1, 0x62)
    rawbytes.BytesSet(input, 2, 0x63)
    var stateScratch = rawbytes.BytesAlloc(32)
    var messageScratch = rawbytes.BytesAlloc(128)
    var digest = rawbytes.BytesAlloc(32)
    var expected = rawbytes.BytesFromHex(
        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")

    let beforeDigest = system.RuntimeAllocationLedgerSnapshot(opened.owner)
    assert(beforeDigest.ok,
           " sha256 cache lifecycle: baseline snapshot")
    sha256.Sha256DigestInto(
        input, stateScratch, messageScratch, digest)
    assert(rawbytes.BytesEqual(digest, expected),
           " sha256 cache lifecycle: first digest")
    let afterFirstDigest =
        system.RuntimeAllocationLedgerSnapshot(opened.owner)
    assert(afterFirstDigest.ok &&
           afterFirstDigest.receipt.liveAllocationCount ==
               beforeDigest.receipt.liveAllocationCount + uint64(1),
           " sha256 cache lifecycle: one shared allocation")

    sha256.Sha256DigestInto(
        input, stateScratch, messageScratch, digest)
    assert(rawbytes.BytesEqual(digest, expected),
           " sha256 cache lifecycle: repeated digest")
    let afterSecondDigest =
        system.RuntimeAllocationLedgerSnapshot(opened.owner)
    assert(afterSecondDigest.ok &&
           afterSecondDigest.receipt.liveAllocationCount ==
               afterFirstDigest.receipt.liveAllocationCount,
           " sha256 cache lifecycle: repeated call allocated")

    rawbytes.BytesFree(expected)
    rawbytes.BytesFree(digest)
    rawbytes.BytesFree(messageScratch)
    rawbytes.BytesFree(stateScratch)
    rawbytes.BytesFree(input)
    assert(sha256.Sha256SharedKTableClose(),
           " sha256 cache lifecycle: cache close")

    let drained = system.RuntimeAllocationLedgerSnapshot(opened.owner)
    assert(drained.ok &&
           drained.receipt.liveAllocationCount == uint64(0),
           " sha256 cache lifecycle: owner not drained")
    let closed = system.RuntimeAllocationLedgerClose(opened.owner)
    assert(closed.ok && closed.receipt.complete && closed.receipt.closed,
           " sha256 cache lifecycle: ledger close")
    return 0
