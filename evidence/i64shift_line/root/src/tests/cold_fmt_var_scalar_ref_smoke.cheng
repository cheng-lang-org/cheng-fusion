import std/strformat

fn FormatVarScalars(i32Value: var int32,
                    i64Value: var int64): str =
    return Fmt"{i32Value}:{i64Value}"

fn main(): int32 =
    var i32Value: int32
    i32Value = -17
    var i64Value: int64
    i64Value = int64(4294967297)
    assert(FormatVarScalars(i32Value, i64Value) == "-17:4294967297",
           "Fmt var scalar references must load their pointee values")
    return 0
