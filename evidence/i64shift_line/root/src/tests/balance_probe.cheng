# Balance probe (phase-2 capstone): the free-walk playground world with
# the balance-v1 controller must survive a 1.5 m/s lateral shove while
# free-standing, and the identical shove with the controller kill
# switch off must topple — proving the controller is the cause of the
# recovery. Protocol per arm: materialize the playground scene +
# execution init, 300 ticks anchored standing (head drift must stay
# stable), free-stand through the tick-690 anchor release, then at tick
# 800 inject +1.5 m/s horizontal velocity directly into the chest and
# pelvis bodyVx columns. Assertions (controller on): zero rejected
# physics steps, the capture reflex fires, pelvis height recovers to
# within 80 mm of the pre-shove value inside 400 ticks and the figure
# never stays toppled (head z >= pelvis z at the window end).
# Assertions (controller off): the same shove topples the figure.
# Trace is buffered and printed after the loops (no echo in physics
# loops).
import cheng/game/csg/schema
import cheng/game/csg/validation
import cheng/game/csg/producer
import cheng/game/csg/materializer
import cheng/game/csg/execution
import cheng/game/csg/numerics
import cheng/game/world3d
import cheng/game/physics3d
import std/strings as strings

const
    ProbeSettleTick = 300
    ProbeDriftFromTick = 200
    ProbePushTick = 800
    ProbeWindowTicks = 400
    ProbeKickMps = 1.5
    ProbeBandMm = 80
    ProbeDriftBandMm = 10
    ProbePelvis = 0
    ProbeChest = 1
    ProbeHead = 2

type
    ProbeArm =
        ok: bool
        headDriftMm: int64
        pzBeforeMm: int64
        pzWorstMm: int64
        pzEndMm: int64
        recovMm: int64
        fallTicks: int32
        endFallen: bool
        rejected: int32
        captures: int32

# One arm of the experiment: a full playground run with the balance
# controller on or off (the kill switch is st.balOn, seeded by the
# CsgBalanceEnabled constant in Init). Metrics are accumulated in the
# loop; all reporting happens in the caller.
fn runArm(balanceOn: bool): ProbeArm =
    var out: ProbeArm
    out.ok = false
    out.headDriftMm = -1
    var facts: schema.CsgWorldFacts = producer.CsgProducerBuildPlaygroundScene()
    var verdict = validation.CsgValidateFacts(facts)
    if verdict.statusCode != validation.CsgValidOk:
        echo("FAIL balance facts validation")
        return out
    var w: world3d.World3d
    var mp: materializer.CsgMaterializerMapping
    var err: str = ""
    if !materializer.CsgMaterialize(facts, w, mp, err):
        echo("FAIL balance materialize")
        return out
    var st: execution.CsgExecutionState
    execution.CsgExecutionInit(st, facts, w, mp.partSlot, mp.ropeNodeSlot)
    if balanceOn:
        if st.balOn != 1:
            echo("FAIL balance gate closed on a free-walk world")
            return out
    else:
        # control arm: the kill switch off — no servo, no capture step
        st.balOn = 0
    let pelvisSlot: int32 = mp.partSlot[ProbePelvis]
    let chestSlot: int32 = mp.partSlot[ProbeChest]
    let headSlot: int32 = mp.partSlot[ProbeHead]
    var refX: float64 = 0.0
    var refY: float64 = 0.0
    var refZ: float64 = 0.0
    var pzBefore: float64 = 0.0
    var pzWorst: float64 = 0.0
    var fallTicks: int32
    var tick: int32 = 0
    let lastTick: int32 = ProbePushTick + ProbeWindowTicks
    while tick < lastTick:
        if tick == ProbeDriftFromTick:
            refX = st.w.bodyPx[headSlot]
            refY = st.w.bodyPy[headSlot]
            refZ = st.w.bodyPz[headSlot]
        if tick == ProbeSettleTick:
            # anchored standing must be settled: head displacement over
            # the last 100 ticks stays inside the drift band
            let dX = st.w.bodyPx[headSlot] - refX
            let dY = st.w.bodyPy[headSlot] - refY
            let dZ = st.w.bodyPz[headSlot] - refZ
            out.headDriftMm = numerics.CsgQuantMm(numerics.CsgSqrt(dX * dX + dY * dY + dZ * dZ))
        if tick == ProbePushTick:
            pzBefore = st.w.bodyPz[pelvisSlot]
            pzWorst = pzBefore
            st.w.bodyVx[chestSlot] = st.w.bodyVx[chestSlot] + ProbeKickMps
            st.w.bodyVx[pelvisSlot] = st.w.bodyVx[pelvisSlot] + ProbeKickMps
        if tick > ProbePushTick:
            let pz = st.w.bodyPz[pelvisSlot]
            if pz < pzWorst:
                pzWorst = pz
            if st.w.bodyPz[headSlot] < pz:
                fallTicks = fallTicks + 1
        var receipt = execution.CsgExecutionTick(st, facts)
        if receipt.statusCode != physics3d.Physics3dStatusOk:
            out.rejected = out.rejected + 1
        tick = tick + 1
    out.pzBeforeMm = numerics.CsgQuantMm(pzBefore)
    out.pzWorstMm = numerics.CsgQuantMm(pzWorst)
    out.pzEndMm = numerics.CsgQuantMm(st.w.bodyPz[pelvisSlot])
    out.recovMm = numerics.CsgQuantMm(st.w.bodyPz[pelvisSlot] - pzBefore)
    out.fallTicks = fallTicks
    out.endFallen = st.w.bodyPz[headSlot] < st.w.bodyPz[pelvisSlot]
    out.captures = st.balCaptures
    out.ok = true
    return out

fn reportArm(label: str, a: ProbeArm) =
    echo("arm " + label
        + " drift_mm=" + strings.Int64ToStr(a.headDriftMm)
        + " pz_before_mm=" + strings.Int64ToStr(a.pzBeforeMm)
        + " pz_worst_mm=" + strings.Int64ToStr(a.pzWorstMm)
        + " pz_end_mm=" + strings.Int64ToStr(a.pzEndMm)
        + " recov_mm=" + strings.Int64ToStr(a.recovMm)
        + " fall_ticks=" + strings.IntToStr(a.fallTicks)
        + " captures=" + strings.IntToStr(a.captures)
        + " rejected=" + strings.IntToStr(a.rejected))

fn main(): int32 =
    var onArm = runArm(true)
    var offArm = runArm(false)
    reportArm("on", onArm)
    reportArm("off", offArm)
    if !onArm.ok || !offArm.ok:
        return 1
    # shared: zero rejected physics steps anywhere in either arm
    if onArm.rejected != 0 || offArm.rejected != 0:
        echo("FAIL balance rejected steps")
        return 1
    # on arm: anchored standing head drift stable
    if onArm.headDriftMm > ProbeDriftBandMm:
        echo("FAIL balance standing drift")
        return 1
    # on arm: the capture reflex fired for the shove
    if onArm.captures < 1:
        echo("FAIL balance no capture step")
        return 1
    # on arm: pelvis height recovered inside the band, no sustained
    # topple (head above pelvis at window end)
    var recovAbs: int64 = onArm.recovMm
    if recovAbs < 0:
        recovAbs = -recovAbs
    if recovAbs > ProbeBandMm:
        echo("FAIL balance recovery band")
        return 1
    if onArm.endFallen:
        echo("FAIL balance on-arm toppled")
        return 1
    # off arm: the same shove must topple — the controller is the cause
    let offDrop: int64 = onArm.pzBeforeMm - offArm.pzEndMm
    if !offArm.endFallen && offDrop < 250:
        echo("FAIL balance control arm did not fall")
        return 1
    echo("PASS balance probe")
    return 0
