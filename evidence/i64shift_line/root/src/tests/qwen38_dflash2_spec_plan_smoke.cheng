import std/result
import std/strings
import std/strutils as strutil
import cheng/inference/kernel as infer
import cheng/inference/model_graph as mg
import cheng/inference/weight_binding as wb
import cheng/inference/parallel_plan as pp
import cheng/inference/paged_kv_cache as pkv
import cheng/inference/moe_router as moe
import cheng/inference/dflash2_draft as d2
import cheng/inference/distributed_engine as engine

# W8 冒烟: DFlash2 spec decode 计划构建 + Qwen3.8 架构门控 + greedy verify 纯函数。
#
# 覆盖:
#   1. DistributedSpecDecodePlanBuildDflash2 正例 + 形状负例 (count=0/window<count/
#      window=0/mtpLayerCount!=0) 与 mtp/eagle_mtp/none 回归控制 (GLM52 行为零变化)
#   2. DistributedRequireArchitectureDflash2SpecDecodeExecution 门控正例 +
#      架构不匹配/算法不匹配/disabled plan 负例
#   3. DistributedSpecDecodeVerifyGreedyFromArgmax 表驱动: 全接受/中途拒/首 token 拒,
#      hash 稳定性 (同输入两次 hash 相等) + 输入域负例
#   4. draftTokenIds 用 dflash2_draft 公开 API 构造真实候选块走 greedy walk 得到;
#      选择器表用 Dflash2SyntheticSelectorTables (确定性 LCG 数学夹具, 非生产权重路径)。
#      所有权纪律: 托管实参 (plan/tensor/数组) 一律在调用点现造, 不跨 consuming 调用复用。

const
    SmokeVocabSize: int32 = 8
    SmokeHiddenDim: int32 = 4
    SmokeBlockLen: int32 = 3
    SmokeLastVerifiedTokenId: int32 = 3
    VerifyCaseAllAccept: int32 = 0
    VerifyCaseMidReject: int32 = 1
    VerifyCaseFirstReject: int32 = 2

fn makeTensor(shape: int32[], scale: int32, data: int32[]): infer.TensorQ =
    var out: infer.TensorQ
    let res = infer.TensorFromDataFill(out, shape, scale, data)
    assert(IsOk(res), " qwen38 dflash2 spec plan smoke: tensor")
    return out

fn gatingGraph(architecture: str): mg.ModelGraph =
    return mg.ModelGraph(
        schema: mg.InferenceModelGraphSchema,
        modelCid: "cid:model:qwen38-dflash2-spec-plan-smoke",
        architecture: architecture,
        hiddenSize: 8,
        attentionHeads: 2,
        keyValueHeads: 2,
        headDim: 4,
        layerCount: 2,
        expertCount: 0,
        topK: 0,
        qLoraRank: 0,
        kvLoraRank: 0,
        qkHeadDim: 0,
        qkNopeHeadDim: 0,
        qkRopeHeadDim: 0,
        vHeadDim: 0,
        denseLayerCount: 0,
        sharedExpertCount: 0,
        mtpLayerCount: 0,
        mtpStartLayer: 0,
        indexHeads: 0,
        indexHeadDim: 0,
        indexTopK: 0,
        indexTopKFreq: 0,
        ropeTheta: 10000.0,
        tensors: [],
        weights: [],
        ops: [],
        graphHash: int64(1)
    )

fn gatingPlan(graph: mg.ModelGraph,
              specPlan: engine.DistributedSpecDecodePlan): engine.DistributedInferencePlan =
    return engine.DistributedInferencePlan(
        schema: engine.DistributedInferenceSchema,
        engineCid: "cid:engine:qwen38-dflash2-spec-plan-smoke",
        modelGraph: graph,
        weightBindings: wb.WeightBindingSet(
            schema: wb.WeightBindingSchema,
            modelCid: graph.modelCid,
            bindings: [],
            bindingHash: int64(1)
        ),
        deviceWeightBindingHash: int64(1),
        partitionPlan: pp.InferencePartitionPlan(
            planCid: "cid:partition:qwen38-dflash2-spec-plan-smoke",
            tensorShards: [],
            expertShards: [],
            pipelineStageCount: 1,
            planHash: int64(1)
        ),
        kernelPrograms: [],
        kvReceipt: pkv.PagedKVReceipt(
            seqId: 9,
            tokenCount: 4,
            pageCount: 1,
            pageTableHash: int64(1),
            trace: "qwen38_dflash2_spec_plan_smoke"
        ),
        kvStateHash: int64(1),
        kvShardReceipts: engine.DistributedKvShardReceiptSet(
            schema: engine.DistributedKvShardReceiptSetSchema,
            receipts: [],
            receiptSetHash: int64(1)
        ),
        specDecodePlan: specPlan,
        routePlan: moe.MoeRoutePlan(
            tokenCount: 0,
            expertCount: 0,
            topK: 0,
            expertCapacity: 0,
            choices: [],
            expertLoads: [],
            routeHash: int64(1)
        ),
        routePlanSet: moe.MoeRoutePlanSet(
            layerRoutes: [],
            routeSetHash: int64(1)
        ),
        activationShards: [],
        engineHash: int64(1)
    )

fn freshDflash2SpecPlan(): engine.DistributedSpecDecodePlan =
    let res = engine.DistributedSpecDecodePlanBuildDflash2(4, 2)
    assert(IsOk(res), " qwen38 dflash2 spec plan smoke: fresh dflash2 plan")
    return Value(res)

fn corruptedHashSpecPlan(): engine.DistributedSpecDecodePlan =
    let good = freshDflash2SpecPlan()
    return engine.DistributedSpecDecodePlan(
        schema: good.schema,
        algorithm: good.algorithm,
        draftWindow: good.draftWindow,
        draftTokenCount: good.draftTokenCount,
        mtpLayerCount: good.mtpLayerCount,
        planHash: good.planHash + int64(1)
    )

fn badMtpLabelSpecPlan(): engine.DistributedSpecDecodePlan =
    let good = freshDflash2SpecPlan()
    return engine.DistributedSpecDecodePlan(
        schema: good.schema,
        algorithm: good.algorithm,
        draftWindow: good.draftWindow,
        draftTokenCount: good.draftTokenCount,
        mtpLayerCount: 1,
        planHash: good.planHash
    )

fn gateErrContains(plan: engine.DistributedInferencePlan,
                   stage: str,
                   expectedArchitecture: str,
                   needle: str): bool =
    let res = engine.DistributedRequireArchitectureDflash2SpecDecodeExecution(
        plan,
        "qwen38_dflash2_spec_plan_smoke",
        expectedArchitecture
    )
    if IsOk(res):
        return false
    return strutil.Contains(Error(res), needle)

fn buildDraftTokenIds(): infer.TensorQ =
    var candIds: int32[]
    var candLogits: float64[]
    for t in 0..<SmokeBlockLen:
        for k in 0..<d2.Dflash2TopK:
            add(candIds, (t * 3 + k) % SmokeVocabSize)
            add(candLogits, float64(k) * 0.125 - float64(t) * 0.25)
    let candidatesRes = d2.Dflash2CandidatesBuild(SmokeBlockLen, candIds, candLogits)
    assert(IsOk(candidatesRes), " qwen38 dflash2 spec plan smoke: candidates build")
    let tablesRes = d2.Dflash2SyntheticSelectorTables(SmokeVocabSize, SmokeHiddenDim, int64(20260822))
    assert(IsOk(tablesRes), " qwen38 dflash2 spec plan smoke: selector tables")
    var hidden: float64[]
    for i in 0..<(SmokeBlockLen * SmokeHiddenDim):
        add(hidden, 0.25 + 0.125 * float64(i % 7))
    let walkRes = d2.Dflash2GreedyWalkFill(
        Value(candidatesRes),
        Value(tablesRes),
        hidden,
        SmokeLastVerifiedTokenId
    )
    assert(IsOk(walkRes), " qwen38 dflash2 spec plan smoke: greedy walk")
    let path = Value(walkRes)
    assert(path.pathTokenIds.len == SmokeBlockLen &&
           path.selectedIndices.len == SmokeBlockLen,
           " qwen38 dflash2 spec plan smoke: walk path length")
    for i in 0..<path.pathTokenIds.len:
        assert(path.pathTokenIds[i] >= 0 && path.pathTokenIds[i] < SmokeVocabSize,
               " qwen38 dflash2 spec plan smoke: walk token domain")
    return makeTensor([SmokeBlockLen], 1000, path.pathTokenIds)

fn draftIdsData(): int32[] =
    let drafts = buildDraftTokenIds()
    var out: int32[]
    for i in 0..<drafts.shape[0]:
        add(out, drafts.data[i])
    return out

fn buildArgmaxForCase(kind: int32, xToken: int32): int32[] =
    var argmax = draftIdsData()
    if kind == VerifyCaseMidReject:
        argmax[1] = xToken
    if kind == VerifyCaseFirstReject:
        argmax[0] = xToken
    return argmax

fn expectedEmittedForCase(kind: int32, xToken: int32): int32[] =
    var out: int32[]
    if kind == VerifyCaseAllAccept:
        let drafts = draftIdsData()
        for i in 0..<drafts.len:
            add(out, drafts[i])
    elif kind == VerifyCaseMidReject:
        let drafts = draftIdsData()
        add(out, drafts[0])
        add(out, xToken)
    else:
        add(out, xToken)
    return out

fn verifyCaseOk(caseName: str,
                kind: int32,
                xToken: int32,
                wantAccepted: int32,
                wantFirstRejected: int32,
                wantCorrection: int32): bool =
    let expected = expectedEmittedForCase(kind, xToken)
    let drafts = buildDraftTokenIds()
    let argmax = buildArgmaxForCase(kind, xToken)
    let res = engine.DistributedSpecDecodeVerifyGreedyFromArgmax(drafts, argmax)
    if IsErr(res):
        echo(strutil.Join([caseName, ": unexpected err: ", Error(res)], ""))
        return false
    let v = Value(res)
    if v.acceptedDraftTokenCount != wantAccepted ||
       v.firstRejectedIndex != wantFirstRejected ||
       v.correctionToken != wantCorrection ||
       v.emittedTokenCount != expected.len ||
       v.outputTokens.data.len != expected.len ||
       v.outputTokens.scale != 1000:
        echo(strutil.Join([caseName, ": field mismatch"], ""))
        return false
    for i in 0..<expected.len:
        if v.outputTokens.data[i] != expected[i]:
            echo(strutil.Join([caseName, ": emitted token mismatch at ", strings.IntToStr(i)], ""))
            return false
    let drafts2 = buildDraftTokenIds()
    let argmax2 = buildArgmaxForCase(kind, xToken)
    let again = engine.DistributedSpecDecodeVerifyGreedyFromArgmax(drafts2, argmax2)
    if IsErr(again):
        echo(strutil.Join([caseName, ": repeat run errored"], ""))
        return false
    if Value(again).verifyHash != v.verifyHash ||
       Value(again).draftTokenHash != v.draftTokenHash ||
       Value(again).verifierLogitsHash != v.verifierLogitsHash ||
       Value(again).outputTokenHash != v.outputTokenHash:
        echo(strutil.Join([caseName, ": hash instability"], ""))
        return false
    return true

fn main(): int32 =
    # 1. dflash2 plan build 正例
    let planPosRes = engine.DistributedSpecDecodePlanBuildDflash2(4, 2)
    assert(IsOk(planPosRes), " qwen38 dflash2 spec plan smoke: plan build positive")
    let planPos = Value(planPosRes)
    assert(planPos.schema == engine.DistributedSpecDecodePlanSchema &&
           planPos.algorithm == engine.DistributedSpecDecodeAlgorithmDflash2 &&
           planPos.draftWindow == 4 &&
           planPos.draftTokenCount == 2 &&
           planPos.mtpLayerCount == 0 &&
           planPos.planHash > int64(0),
           " qwen38 dflash2 spec plan smoke: plan fields")
    let planAgainRes = engine.DistributedSpecDecodePlanBuildDflash2(4, 2)
    assert(IsOk(planAgainRes), " qwen38 dflash2 spec plan smoke: plan rebuild")
    assert(Value(planAgainRes).planHash == planPos.planHash,
           " qwen38 dflash2 spec plan smoke: plan hash deterministic")
    let planSquareRes = engine.DistributedSpecDecodePlanBuildDflash2(2, 2)
    assert(IsOk(planSquareRes) && Value(planSquareRes).draftWindow == 2,
           " qwen38 dflash2 spec plan smoke: square window plan")
    assert(IsErr(engine.DistributedBuildSpecDecodePlan(
        engine.DistributedSpecDecodeAlgorithmDflash2, 4, 2, 0)),
        " qwen38 dflash2 spec plan smoke: generic builder not wired for dflash2 yet")

    # 2. plan build 负例
    assert(IsErr(engine.DistributedSpecDecodePlanBuildDflash2(4, 0)),
           " qwen38 dflash2 spec plan smoke: count=0 rejected")
    assert(IsErr(engine.DistributedSpecDecodePlanBuildDflash2(1, 2)),
           " qwen38 dflash2 spec plan smoke: window<count rejected")
    assert(IsErr(engine.DistributedSpecDecodePlanBuildDflash2(0, 1)),
           " qwen38 dflash2 spec plan smoke: window=0 rejected")


    # 3. mtp/eagle_mtp/none 回归控制 (GLM52 行为零变化)
    assert(IsOk(engine.DistributedBuildSpecDecodePlan(
        engine.DistributedSpecDecodeAlgorithmMtp, 1, 1, 1)),
        " qwen38 dflash2 spec plan smoke: mtp control")
    assert(IsOk(engine.DistributedBuildSpecDecodePlan(
        engine.DistributedSpecDecodeAlgorithmEagleMtp, 2, 1, 1)),
        " qwen38 dflash2 spec plan smoke: eagle_mtp control")
    assert(IsErr(engine.DistributedBuildSpecDecodePlan(
        engine.DistributedSpecDecodeAlgorithmMtp, 1, 1, 0)),
        " qwen38 dflash2 spec plan smoke: mtp enabled-fields control")
    assert(engine.DistributedBuildDisabledSpecDecodePlan().algorithm ==
           engine.DistributedSpecDecodeAlgorithmNone,
           " qwen38 dflash2 spec plan smoke: none control")

    # 4. 门控正例
    let gateOk = engine.DistributedRequireArchitectureDflash2SpecDecodeExecution(
        gatingPlan(gatingGraph(mg.InferenceModelArchitectureHfQwen38HybridMtp), freshDflash2SpecPlan()),
        "qwen38_dflash2_spec_plan_smoke",
        mg.InferenceModelArchitectureHfQwen38HybridMtp
    )
    assert(IsOk(gateOk) && Value(gateOk),
           " qwen38 dflash2 spec plan smoke: gate positive")

    # 5. 门控负例: 架构不匹配 / 算法不匹配 / disabled plan / hash 破坏 / mtp 标签
    assert(gateErrContains(
        gatingPlan(gatingGraph(mg.InferenceModelArchitectureHfQwen38HybridMtp), freshDflash2SpecPlan()),
        "qwen38_dflash2_spec_plan_smoke",
        mg.InferenceModelArchitectureHfGlm52DsaMlaMtp,
        "architecture"),
        " qwen38 dflash2 spec plan smoke: gate architecture mismatch")
    let mtpSpecRes = engine.DistributedBuildSpecDecodePlan(
        engine.DistributedSpecDecodeAlgorithmMtp, 1, 1, 1)
    assert(IsOk(mtpSpecRes), " qwen38 dflash2 spec plan smoke: mtp spec plan for gate")
    assert(gateErrContains(
        gatingPlan(gatingGraph(mg.InferenceModelArchitectureHfQwen38HybridMtp), Value(mtpSpecRes)),
        "qwen38_dflash2_spec_plan_smoke",
        mg.InferenceModelArchitectureHfQwen38HybridMtp,
        "algorithm"),
        " qwen38 dflash2 spec plan smoke: gate algorithm mismatch")
    assert(gateErrContains(
        gatingPlan(gatingGraph(mg.InferenceModelArchitectureHfQwen38HybridMtp),
                   engine.DistributedBuildDisabledSpecDecodePlan()),
        "qwen38_dflash2_spec_plan_smoke",
        mg.InferenceModelArchitectureHfQwen38HybridMtp,
        "algorithm"),
        " qwen38 dflash2 spec plan smoke: gate disabled plan")
    assert(gateErrContains(
        gatingPlan(gatingGraph(mg.InferenceModelArchitectureHfQwen38HybridMtp),
                   corruptedHashSpecPlan()),
        "qwen38_dflash2_spec_plan_smoke",
        mg.InferenceModelArchitectureHfQwen38HybridMtp,
        "plan hash"),
        " qwen38 dflash2 spec plan smoke: gate corrupted hash")
    assert(gateErrContains(
        gatingPlan(gatingGraph(mg.InferenceModelArchitectureHfQwen38HybridMtp),
                   badMtpLabelSpecPlan()),
        "qwen38_dflash2_spec_plan_smoke",
        mg.InferenceModelArchitectureHfQwen38HybridMtp,
        "draft window"),
        " qwen38 dflash2 spec plan smoke: gate mtp label rejected")

    # 6. 真实候选块 walk 出 draftTokenIds (确定性, 供夹具派生)
    let draftsData = draftIdsData()
    assert(draftsData.len == SmokeBlockLen,
           " qwen38 dflash2 spec plan smoke: draft data length")

    # 7. verify 表驱动
    let midX: int32 = (draftsData[1] + 1) % SmokeVocabSize
    let firstX: int32 = (draftsData[0] + 1) % SmokeVocabSize
    assert(midX != draftsData[1] && firstX != draftsData[0],
           " qwen38 dflash2 spec plan smoke: reject fixture domain")
    assert(verifyCaseOk("verify all accept",
                        VerifyCaseAllAccept,
                        -1,
                        SmokeBlockLen,
                        -1,
                        -1),
           " qwen38 dflash2 spec plan smoke: verify all accept")
    assert(verifyCaseOk("verify mid reject",
                        VerifyCaseMidReject,
                        midX,
                        1,
                        1,
                        midX),
           " qwen38 dflash2 spec plan smoke: verify mid reject")
    assert(verifyCaseOk("verify first reject",
                        VerifyCaseFirstReject,
                        firstX,
                        0,
                        0,
                        firstX),
           " qwen38 dflash2 spec plan smoke: verify first reject")

    # 8. 不同输入 hash 必须不同
    let allAcceptHash = Value(engine.DistributedSpecDecodeVerifyGreedyFromArgmax(
        buildDraftTokenIds(), buildArgmaxForCase(VerifyCaseAllAccept, -1))).verifyHash
    let midRejectHash = Value(engine.DistributedSpecDecodeVerifyGreedyFromArgmax(
        buildDraftTokenIds(), buildArgmaxForCase(VerifyCaseMidReject, midX))).verifyHash
    assert(allAcceptHash != midRejectHash,
           " qwen38 dflash2 spec plan smoke: distinct inputs distinct hash")

    # 9. verify 输入域负例
    var emptyDraft: infer.TensorQ
    assert(IsErr(engine.DistributedSpecDecodeVerifyGreedyFromArgmax(
        emptyDraft, buildArgmaxForCase(VerifyCaseAllAccept, -1))),
        " qwen38 dflash2 spec plan smoke: empty draft rejected")
    var shortArgmax: int32[]
    add(shortArgmax, draftsData[0])
    add(shortArgmax, draftsData[1])
    assert(IsErr(engine.DistributedSpecDecodeVerifyGreedyFromArgmax(
        buildDraftTokenIds(), shortArgmax)),
        " qwen38 dflash2 spec plan smoke: short argmax rejected")
    var negArgmax: int32[]
    add(negArgmax, draftsData[0])
    add(negArgmax, -1)
    add(negArgmax, draftsData[2])
    assert(IsErr(engine.DistributedSpecDecodeVerifyGreedyFromArgmax(
        buildDraftTokenIds(), negArgmax)),
        " qwen38 dflash2 spec plan smoke: negative argmax rejected")

    echo("qwen38_dflash2_spec_plan_smoke ok")
    return 0
