fn R24Trim(raw: str): str =
    return raw

fn R24Slice(raw: str, count: int32): str =
    return raw

fn R24Head(lineRaw: str, genericPos: int32): int32 =
    let headRaw = R24Trim(lineRaw)
    var head: str
    if genericPos > 0:
        head = R24Trim(R24Slice(headRaw, genericPos))
    else:
        head = headRaw
    return head.len

fn main(): int32 =
    let n = R24Head("abcdef", 0)
    if n != 6:
        return 10
    let m = R24Head("abcdef", 2)
    if m != 6:
        return 11
    echo("r24 a ok")
    return 0
