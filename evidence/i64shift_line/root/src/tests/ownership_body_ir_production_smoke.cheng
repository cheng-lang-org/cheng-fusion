import std/result
import std/cmdline as cmdline
import cheng/core/analysis/managed_lvalue_replace as managedreplace
import cheng/core/analysis/ownership_body_ir_production as production
import cheng/core/ir/core_types as coreir
import cheng/core/ir/body_ir_access as bodyaccess
import cheng/std/bytes_layout as layout

const
    # Test-local semantic opcode for the synthetic make-str runtime call.
    OwnershipFixtureRuntimeMakeStrRow = 1001

fn smokeAssert(condition: bool, message: str) =
    if !condition:
        panic(message)

fn typeArenaCid(): layout.FixedBytes32 =
    let parsed = layout.FixedBytes32FromHex(
        "1111111111111111111111111111111111111111111111111111111111111111")
    if IsErr(parsed):
        panic(Error(parsed))
    return Value(parsed)

fn addI32(body: var coreir.BodyIR, name: str): int32 =
    var slot: coreir.LocalSlot
    let slotId = body.localSlots.len
    slot.id = slotId
    slot.name = name
    slot.typeKind = coreir.LocalI32Tag
    slot.stackOffset = slot.id * 32
    slot.sizeBytes = 4
    slot.alignBytes = 4
    coreir.BodyIRApplyLocalSlotDefaultProof(slot)
    add(body.localSlots, slot)
    return slotId

fn addStr(body: var coreir.BodyIR, name: str): int32 =
    var slot: coreir.LocalSlot
    let slotId = body.localSlots.len
    slot.id = slotId
    slot.name = name
    slot.typeKind = coreir.LocalStrTag
    slot.stackOffset = slot.id * 32
    slot.sizeBytes = 24
    slot.alignBytes = 8
    coreir.BodyIRApplyLocalSlotDefaultProof(slot)
    add(body.localSlots, slot)
    smokeAssert(coreir.BodyIRBindLocalSlotTypeArenaProof(
                    body,
                    slotId,
                    typeArenaCid(),
                    7,
                    coreir.BodyManagedStorageManagedTag),
                "ownership production smoke: str proof bind")
    return slotId

fn addManualTarget(body: var coreir.BodyIR,
                   name: str): int32 =
    var slot: coreir.LocalSlot
    let slotId = body.localSlots.len
    slot.id = slotId
    slot.name = name
    slot.typeKind = coreir.LocalStrTag
    slot.stackOffset = -1 - slot.id
    slot.sizeBytes = 24
    slot.alignBytes = 8
    coreir.BodyIRApplyLocalSlotDefaultProof(slot)
    slot.placeKind = coreir.BodyPlaceParamAddressTag
    slot.ownership = coreir.OwnBorrowUnique
    add(body.localSlots, slot)
    smokeAssert(coreir.BodyIRBindLocalSlotTypeArenaProof(
                    body,
                    slotId,
                    typeArenaCid(),
                    7,
                    coreir.BodyManagedStorageManagedTag),
                "ownership production smoke: manual target proof bind")
    return slotId

fn addManualSourceParameter(body: var coreir.BodyIR,
                            name: str): int32 =
    var slot: coreir.LocalSlot
    let slotId = body.localSlots.len
    slot.id = slotId
    slot.name = name
    slot.typeKind = coreir.LocalStrTag
    slot.stackOffset = -1 - slot.id
    slot.sizeBytes = 24
    slot.alignBytes = 8
    coreir.BodyIRApplyLocalSlotDefaultProof(slot)
    slot.placeKind = coreir.BodyPlaceStackValueTag
    slot.ownership = coreir.OwnMove
    add(body.localSlots, slot)
    smokeAssert(coreir.BodyIRBindLocalSlotTypeArenaProof(
                    body,
                    slotId,
                    typeArenaCid(),
                    7,
                    coreir.BodyManagedStorageManagedTag),
                "ownership production smoke: manual source parameter proof")
    return slotId

fn addBorrowedStrParameter(body: var coreir.BodyIR,
                           name: str): int32 =
    var slot: coreir.LocalSlot
    let slotId = body.localSlots.len
    slot.id = slotId
    slot.name = name
    slot.typeKind = coreir.LocalStrTag
    slot.stackOffset = -1 - slot.id
    slot.sizeBytes = 24
    slot.alignBytes = 8
    coreir.BodyIRApplyLocalSlotDefaultProof(slot)
    slot.placeKind = coreir.BodyPlaceStackValueTag
    slot.ownership = coreir.OwnBorrowShared
    add(body.localSlots, slot)
    smokeAssert(coreir.BodyIRBindLocalSlotTypeArenaProof(
                    body,
                    slotId,
                    typeArenaCid(),
                    7,
                    coreir.BodyManagedStorageManagedTag),
                "ownership production smoke: borrowed source proof")
    return slotId

fn addAggregateParameter(body: var coreir.BodyIR,
                         name: str): int32 =
    var slot: coreir.LocalSlot
    let slotId = body.localSlots.len
    slot.id = slotId
    slot.name = name
    slot.typeKind = coreir.LocalAggregateTag
    slot.stackOffset = -1 - slot.id
    slot.sizeBytes = 64
    slot.alignBytes = 8
    coreir.BodyIRApplyLocalSlotDefaultProof(slot)
    add(body.localSlots, slot)
    return slotId

fn freezeFirstEntryOwnership(body: var coreir.BodyIR,
                             firstOwnership: int32) =
    var ownershipKinds: int32[]
    for slotIndex in 0..<body.localSlots.len:
        var ownership = int32(coreir.OwnInvalid)
        if slotIndex == 0:
            ownership = firstOwnership
        add(ownershipKinds, ownership)
    coreir.BodyIRFreezeEntryDefinitionOwnershipKinds(
        body, ownershipKinds)

fn bindStrTypeFact(body: var coreir.BodyIR) =
    smokeAssert(coreir.BodyIRBindCanonicalTypeFact(
                    body,
                    typeArenaCid(),
                    7,
                    1,
                    1,
                    -1,
                    0,
                    24,
                    8),
                "ownership production smoke: type fact bind")

fn bindManualTargetTypeFact(body: var coreir.BodyIR) =
    smokeAssert(coreir.BodyIRBindCanonicalTypeFact(
                    body,
                    typeArenaCid(),
                    3,
                    4,
                    0,
                    7,
                    0,
                    8,
                    8),
                "ownership production smoke: manual target type fact bind")

fn appendConst(body: var coreir.BodyIR,
               target: int32,
               value: int32): int32 =
    var op: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = coreir.BodyOpLoadConstTag
    op.target = target
    add(op.operands, coreir.LocalI32Tag)
    add(op.operands, value)
    return coreir.BodyIRAppendOp(body, op)

fn appendOwnedCall(body: var coreir.BodyIR,
                   target: int32,
                   exprNodeIndex: int32,
                   resultPassKind: int32): int32 =
    var call: coreir.CallOp
    coreir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = "ownership_fixture_make_str"
    call.resultSlot = target
    call.resultPassKind = resultPassKind
    call.resultOwnership = coreir.OwnMove
    call.resultExprNodeIndex = exprNodeIndex
    call.resultValueDefinitionRow = exprNodeIndex
    call.resultDefinitionOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    call.resultDefinitionOriginId = exprNodeIndex
    let callIndex = body.callSequence.len
    add(body.callSequence, call)
    var op: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = coreir.BodyOpCallTag
    op.target = target
    op.valueDefSlot = target
    op.valueDefExprNodeIndex = exprNodeIndex
    op.valueDefSemanticRow = exprNodeIndex
    op.valueDefOwnership = coreir.OwnMove
    op.valueDefOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    op.valueDefOriginId = exprNodeIndex
    add(op.operands, callIndex)
    return coreir.BodyIRAppendOp(body, op)

fn appendBr(body: var coreir.BodyIR, target: int32): int32 =
    var term: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = coreir.BodyTermBrTag
    term.trueBlock = target
    return coreir.BodyIRAppendTerm(body, term)

fn appendCbr(body: var coreir.BodyIR,
              conditionSlot: int32,
              yes: int32,
              no: int32): int32 =
    var term: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = coreir.BodyTermCbrTag
    term.conditionKind = coreir.BodyCondLocalNonZeroTag
    term.lhsSlot = conditionSlot
    term.trueBlock = yes
    term.falseBlock = no
    return coreir.BodyIRAppendTerm(body, term)

fn appendReturn(body: var coreir.BodyIR,
                resultSlot: int32,
                sourceDefinitionRow: int32): int32 =
    var term: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = coreir.BodyTermReturnTag
    term.resultSlot = resultSlot
    if sourceDefinitionRow >= 0:
        term.sourceDefinitionDomain =
            coreir.BodyDefinitionDomainBodyOpTag
    term.sourceDefinitionRow = sourceDefinitionRow
    return coreir.BodyIRAppendTerm(body, term)

fn bindOwnershipFixtureRuntimeCallTarget(
        body: var coreir.BodyIR,
        callIndex: int32) =
    if callIndex < 0 || callIndex >= body.callSequence.len:
        panic("ownership production smoke: runtime call index")
    let call = body.callSequence[callIndex]
    var runtimeRow: int32
    if call.managedStoreKind != coreir.ManagedStoreNoneTag:
        runtimeRow = call.managedStoreKind
    elif call.targetSymbol == "ownership_fixture_make_str":
        runtimeRow = OwnershipFixtureRuntimeMakeStrRow
    else:
        panic("ownership production smoke: runtime call identity")
    coreir.BodyIRControlFlowBindCallTarget(
        body,
        callIndex,
        coreir.BodyCallTargetDomainRuntimeIntrinsicTag,
        runtimeRow,
        typeArenaCid())

fn sealControlFlow(body: var coreir.BodyIR, functionRow: int32) =
    coreir.BodyIRControlFlowBegin(body, functionRow)
    for blockIndex in 0..<body.blocks.len:
        coreir.BodyIRControlFlowBindBlockScope(body, blockIndex, 0)
    for termIndex in 0..<body.terms.len:
        var successors: int32[]
        var edgeKinds: int32[]
        if body.terms[termIndex].kind == coreir.BodyTermBrTag:
            add(successors, body.terms[termIndex].trueBlock)
            add(edgeKinds, coreir.BodyControlEdgeNormal)
        elif body.terms[termIndex].kind ==
                 coreir.BodyTermCbrTag:
            add(successors, body.terms[termIndex].trueBlock)
            add(edgeKinds, coreir.BodyControlEdgeNormal)
            add(successors, body.terms[termIndex].falseBlock)
            add(edgeKinds, coreir.BodyControlEdgeNormal)
        elif body.terms[termIndex].kind !=
                 coreir.BodyTermReturnTag:
            panic("ownership production smoke: unsupported terminator")
        coreir.BodyIRControlFlowBindTermSuccessors(
            body, termIndex, successors, edgeKinds)
    for callIndex in 0..<body.callSequence.len:
        bindOwnershipFixtureRuntimeCallTarget(body, callIndex)
    coreir.BodyIRControlFlowSeal(body)
    smokeAssert(coreir.BodyIRControlFlowShapeValid(body),
                "ownership production smoke: control seal invalid")

fn sealManualControlFlow(body: var coreir.BodyIR,
                         functionRow: int32,
                         loopTermIndex: int32,
                         loopTarget: int32) =
    coreir.BodyIRControlFlowBegin(body, functionRow)
    for blockIndex in 0..<body.blocks.len:
        coreir.BodyIRControlFlowBindBlockScope(body, blockIndex, 0)
    for termIndex in 0..<body.terms.len:
        var successors: int32[]
        var edgeKinds: int32[]
        if body.terms[termIndex].kind == coreir.BodyTermBrTag:
            let target = body.terms[termIndex].trueBlock
            add(successors, target)
            if termIndex == loopTermIndex && target == loopTarget:
                add(edgeKinds, coreir.BodyControlEdgeLoopBack)
            else:
                add(edgeKinds, coreir.BodyControlEdgeNormal)
        elif body.terms[termIndex].kind ==
                 coreir.BodyTermCbrTag:
            let trueTarget = body.terms[termIndex].trueBlock
            let falseTarget = body.terms[termIndex].falseBlock
            add(successors, trueTarget)
            if termIndex == loopTermIndex &&
               trueTarget == loopTarget:
                add(edgeKinds, coreir.BodyControlEdgeLoopBack)
            else:
                add(edgeKinds, coreir.BodyControlEdgeNormal)
            add(successors, falseTarget)
            if termIndex == loopTermIndex &&
               falseTarget == loopTarget:
                add(edgeKinds, coreir.BodyControlEdgeLoopBack)
            else:
                add(edgeKinds, coreir.BodyControlEdgeNormal)
        elif body.terms[termIndex].kind !=
                 coreir.BodyTermReturnTag:
            panic("ownership production smoke: manual terminator")
        coreir.BodyIRControlFlowBindTermSuccessors(
            body, termIndex, successors, edgeKinds)
    for callIndex in 0..<body.callSequence.len:
        if callIndex == 0:
            coreir.BodyIRControlFlowBindCallTarget(
                body,
                callIndex,
                coreir.BodyCallTargetDomainFunctionTag,
                602,
                typeArenaCid())
        else:
            bindOwnershipFixtureRuntimeCallTarget(body, callIndex)
    coreir.BodyIRControlFlowSeal(body)
    smokeAssert(coreir.BodyIRControlFlowShapeValid(body),
                "ownership production smoke: manual control seal invalid")

fn appendManualConsumeCall(body: var coreir.BodyIR,
                           targetSlot: int32,
                           sourceSlot: int32): int32 =
    var call: coreir.CallOp
    coreir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = "ownership_fixture_manual_consume"
    call.semanticCallExprNodeIndex = 701
    add(call.argSlots, coreir.CallArgSlotAddress(targetSlot))
    add(call.argPassKinds, coreir.BodyCallPassBorrowAddressTag)
    add(call.argAbiSizes, 8)
    add(call.argSlots, coreir.CallArgSlotAddress(sourceSlot))
    add(call.argPassKinds, coreir.BodyCallPassParamAddressTag)
    add(call.argAbiSizes, 8)
    let callOrdinal = body.callSequence.len
    add(body.callSequence, call)
    var op: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = coreir.BodyOpCallTag
    add(op.operands, callOrdinal)
    return coreir.BodyIRAppendOp(body, op)

fn bindManualConsumeSidecar(body: var coreir.BodyIR,
                            targetSlot: int32,
                            functionSourceSlot: int32,
                            sourceSlot: int32,
                            callOrdinal: int32,
                            sourceDefinitionRow: int32) =
    coreir.BodyIRManualConsumeBindFunction(
        body,
        601,
        0,
        1,
        targetSlot,
        functionSourceSlot,
        3,
        7,
        typeArenaCid(),
        typeArenaCid())
    var effect: coreir.BodyIRManualConsumeCallEffect
    effect.callOrdinal = callOrdinal
    effect.snapshotCallId = 702
    effect.targetArgumentOrdinal = 0
    effect.sourceArgumentOrdinal = 1
    effect.targetPlaceSlotId = targetSlot
    effect.targetOwnerSlotId = targetSlot
    effect.sourcePlaceSlotId = sourceSlot
    effect.targetArgumentBindingCid = typeArenaCid()
    effect.sourceArgumentBindingCid = typeArenaCid()
    effect.targetProjectionCid = typeArenaCid()
    effect.sourceProjectionCid = typeArenaCid()
    effect.targetDefinitionDomain =
        coreir.BodyDefinitionDomainEntrySlotTag
    effect.targetDefinitionRow = targetSlot
    effect.sourceDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    effect.sourceDefinitionRow = sourceDefinitionRow
    effect.targetTypeArenaTypeId = 3
    effect.sourceTypeArenaTypeId = 7
    effect.postDefinitionDomain =
        coreir.BodyDefinitionDomainManualConsumePostCallTag
    effect.postDefinitionRow = 0
    effect.effectCid = typeArenaCid()
    effect.linearTokenCid = typeArenaCid()
    effect.bridgeCid = typeArenaCid()
    coreir.BodyIRManualConsumeAppendCall(body, effect)
    coreir.BodyIRManualConsumeSeal(body)

fn buildManualConsumePhysicalOrderFixture(
        layoutKind: int32): coreir.BodyIR =
    var body = coreir.BodyIRNew()
    bindStrTypeFact(body)
    bindManualTargetTypeFact(body)
    let targetSlot =
        addManualTarget(body, "manual_target")
    let functionSourceSlot =
        addManualSourceParameter(
            body, "manual_source_parameter")
    let sourceSlot =
        addStr(body, "manual_source")
    var entryOwnership: int32[]
    add(entryOwnership, int32(coreir.OwnBorrowUnique))
    add(entryOwnership, int32(coreir.OwnMove))
    add(entryOwnership, int32(coreir.OwnInvalid))
    coreir.BodyIRFreezeEntryDefinitionOwnershipKinds(
        body, entryOwnership)

    let consumerOp =
        appendManualConsumeCall(body, targetSlot, sourceSlot)
    let manualCallOrdinal =
        body.ops[consumerOp].operands[0]
    let sourceDefinition = appendOwnedCall(
        body,
        sourceSlot,
        703,
        coreir.BodyCallPassSretResultTag)
    smokeAssert(consumerOp == 0 && sourceDefinition == 1,
                "ownership production smoke: inverse physical rows")

    var loopTermIndex: int32 = -1
    var loopTarget: int32 = -1
    if layoutKind == 0:
        let entryTerm = appendBr(body, 4)
        let consumerTerm = appendReturn(body, -1, -1)
        let leftTerm = appendBr(body, 1)
        let rightTerm = appendBr(body, 1)
        let definitionTerm =
            appendCbr(body, targetSlot, 2, 3)
        let _ = coreir.BodyIRAppendBlock(
            body, 2, 0, entryTerm)
        let _ = coreir.BodyIRAppendBlock(
            body, 0, 1, consumerTerm)
        let _ = coreir.BodyIRAppendBlock(
            body, 2, 0, leftTerm)
        let _ = coreir.BodyIRAppendBlock(
            body, 2, 0, rightTerm)
        let _ = coreir.BodyIRAppendBlock(
            body, 1, 1, definitionTerm)
    elif layoutKind == 1:
        let entryTerm = appendBr(body, 2)
        let headerTerm =
            appendCbr(body, targetSlot, 1, 3)
        let definitionTerm = appendBr(body, 1)
        let consumerTerm = appendReturn(body, -1, -1)
        let _ = coreir.BodyIRAppendBlock(
            body, 2, 0, entryTerm)
        let _ = coreir.BodyIRAppendBlock(
            body, 2, 0, headerTerm)
        let _ = coreir.BodyIRAppendBlock(
            body, 1, 1, definitionTerm)
        let _ = coreir.BodyIRAppendBlock(
            body, 0, 1, consumerTerm)
        loopTermIndex = headerTerm
        loopTarget = 1
    elif layoutKind == 2:
        let returnTerm = appendReturn(body, -1, -1)
        let _ = coreir.BodyIRAppendBlock(
            body, 0, 2, returnTerm)
    elif layoutKind == 3:
        let entryTerm =
            appendCbr(body, targetSlot, 2, 1)
        let consumerTerm = appendReturn(body, -1, -1)
        let definitionTerm = appendReturn(body, -1, -1)
        let _ = coreir.BodyIRAppendBlock(
            body, 2, 0, entryTerm)
        let _ = coreir.BodyIRAppendBlock(
            body, 0, 1, consumerTerm)
        let _ = coreir.BodyIRAppendBlock(
            body, 1, 1, definitionTerm)
    else:
        panic("ownership production smoke: manual layout kind")
    sealManualControlFlow(body, 601, loopTermIndex, loopTarget)
    bindManualConsumeSidecar(
        body,
        targetSlot,
        functionSourceSlot,
        sourceSlot,
        manualCallOrdinal,
        sourceDefinition)
    return body

fn assertManualConsumePhysicalOrderAccepted(
        layoutKind: int32) =
    var body =
        buildManualConsumePhysicalOrderFixture(layoutKind)
    var access = bodyaccess.BodyIrAccessDecode(body)
    let sourceFactIndex =
        bodyaccess.BodyIrAccessManualConsumeSourceFactIndex(
            access, 0)
    smokeAssert(
        bodyaccess.BodyIrAccessTableIsValid(access) &&
        sourceFactIndex >= 0 &&
        access.facts[sourceFactIndex].siteIndex == 0 &&
        access.facts[sourceFactIndex].definitionRow == 1 &&
        access.facts[sourceFactIndex].consumesDefinition,
        "ownership production smoke: inverse CFG source not admitted")
    let report =
        production.OwnershipBodyIrProductionApplyOwned(body)
    smokeAssert(report.applied && report.plannerReleased &&
                report.ownedDefinitionCount == 0 &&
                report.managedReplaceValidated,
                "ownership production smoke: inverse CFG production rejected")

fn runManualConsumeFutureDefinitionRejected() =
    var body =
        buildManualConsumePhysicalOrderFixture(2)
    var access = bodyaccess.BodyIrAccessDecode(body)
    smokeAssert(
        !bodyaccess.BodyIrAccessTableIsValid(access) &&
        access.errorCode ==
            bodyaccess.BodyIrAccessOwnershipInvariantErrorCode(),
        "ownership production smoke: same-block future definition accepted")
    let _ =
        production.OwnershipBodyIrProductionApplyOwned(body)
    panic("ownership production smoke: same-block future production accepted")

fn runManualConsumeNonDominatingSiblingRejected() =
    var body =
        buildManualConsumePhysicalOrderFixture(3)
    var access = bodyaccess.BodyIrAccessDecode(body)
    smokeAssert(
        !bodyaccess.BodyIrAccessTableIsValid(access) &&
        access.errorCode ==
            bodyaccess.BodyIrAccessOwnershipInvariantErrorCode(),
        "ownership production smoke: non-dominating sibling accepted")
    let _ =
        production.OwnershipBodyIrProductionApplyOwned(body)
    panic("ownership production smoke: non-dominating sibling production accepted")

fn runRawManagedStoreRejected() =
    var body = coreir.BodyIRNew()
    bindStrTypeFact(body)
    let source = addBorrowedStrParameter(
        body, "raw_store_source")
    let target = addStr(body, "raw_store_target")
    let result = addI32(body, "raw_store_result")
    freezeFirstEntryOwnership(
        body, int32(coreir.OwnBorrowShared))
    var store: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(store)
    store.kind = coreir.BodyOpStoreLocalTag
    store.target = target
    add(store.operands, source)
    let _ = coreir.BodyIRAppendOp(body, store)
    let literal = coreir.BodyIRAppendCStringLiteral(
        body, "raw", ".L_raw_managed_store")
    var useTarget: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(useTarget)
    useTarget.kind = coreir.BodyOpStrEqLiteralTag
    useTarget.target = result
    add(useTarget.operands, target)
    add(useTarget.operands, literal)
    let _ = coreir.BodyIRAppendOp(body, useTarget)
    let returnTerm = appendReturn(body, result, -1)
    let _ = coreir.BodyIRAppendBlock(body, 0, 2, returnTerm)
    sealControlFlow(body, 701)
    var access = bodyaccess.BodyIrAccessDecode(body)
    smokeAssert(
        !bodyaccess.BodyIrAccessTableIsValid(access) &&
        access.errorCode ==
            bodyaccess.BodyIrAccessOwnershipInvariantErrorCode(),
        "ownership production smoke: raw managed StoreLocal accepted")
    let _ =
        production.OwnershipBodyIrProductionApplyOwned(body)
    panic("ownership production smoke: raw managed store production accepted")

