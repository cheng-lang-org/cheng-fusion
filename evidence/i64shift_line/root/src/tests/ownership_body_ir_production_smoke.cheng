fn runForgedTypedOwnedProjectRejected() =
    var body = coreir.BodyIRNew()
    bindStrTypeFact(body)
    let source = addAggregateParameter(
        body, "forged_owned_source")
    let target = addStr(body, "forged_owned_target")
    freezeFirstEntryOwnership(
        body, int32(coreir.OwnPlain))
    var forged: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(forged)
    forged.kind = coreir.BodyOpResultProjectTag
    forged.target = target
    forged.valueDefSlot = target
    forged.valueDefExprNodeIndex = 709
    forged.valueDefSemanticRow = 709
    forged.valueDefOwnership = coreir.OwnMove
    forged.valueDefOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    forged.valueDefOriginId = 709
    add(forged.operands, coreir.BodyResultProjectValueStrTag)
    add(forged.operands, source)
    add(forged.operands, 0)
    add(forged.operands, 24)
    let definition = coreir.BodyIRAppendOp(body, forged)
    let returnTerm = appendReturn(body, target, definition)
    let _ = coreir.BodyIRAppendBlock(body, 0, 1, returnTerm)
    sealControlFlow(body, 709)
    var access = bodyaccess.BodyIrAccessDecode(body)
    smokeAssert(
        !bodyaccess.BodyIrAccessTableIsValid(access) &&
        access.errorCode ==
            bodyaccess.BodyIrAccessOwnershipInvariantErrorCode(),
        "ownership production smoke: forged TypedExpr owner accepted")
    let _ =
        production.OwnershipBodyIrProductionApplyOwned(body)
    panic("ownership production smoke: forged TypedExpr owner production accepted")

fn runForgedTypedBorrowedProjectRejected() =
    var body = coreir.BodyIRNew()
    bindStrTypeFact(body)
    let source = addAggregateParameter(
        body, "forged_borrowed_source")
    let target = addStr(body, "forged_borrowed_target")
    let result = addI32(body, "forged_borrowed_result")
    freezeFirstEntryOwnership(
        body, int32(coreir.OwnPlain))
    var forged: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(forged)
    forged.kind = coreir.BodyOpResultProjectTag
    forged.target = target
    forged.valueDefSlot = target
    forged.valueDefExprNodeIndex = 719
    forged.valueDefSemanticRow = 719
    forged.valueDefOwnership = coreir.OwnBorrowShared
    forged.valueDefOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    forged.valueDefOriginId = 719
    add(forged.operands, coreir.BodyResultProjectValueStrTag)
    add(forged.operands, source)
    add(forged.operands, 0)
    add(forged.operands, 24)
    let _ = coreir.BodyIRAppendOp(body, forged)
    let literal = coreir.BodyIRAppendCStringLiteral(
        body, "borrowed", ".L_forged_borrowed")
    var useTarget: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(useTarget)
    useTarget.kind = coreir.BodyOpStrEqLiteralTag
    useTarget.target = result
    add(useTarget.operands, target)
    add(useTarget.operands, literal)
    let _ = coreir.BodyIRAppendOp(body, useTarget)
    let returnTerm = appendReturn(body, result, -1)
    let _ = coreir.BodyIRAppendBlock(body, 0, 2, returnTerm)
    sealControlFlow(body, 719)
    var access = bodyaccess.BodyIrAccessDecode(body)
    smokeAssert(
        !bodyaccess.BodyIrAccessTableIsValid(access) &&
        access.errorCode ==
            bodyaccess.BodyIrAccessOwnershipInvariantErrorCode(),
        "ownership production smoke: forged TypedExpr borrow accepted")
    let _ =
        production.OwnershipBodyIrProductionApplyOwned(body)
    panic("ownership production smoke: forged TypedExpr borrow production accepted")

fn buildManagedCleanupCopyFixture(
        copyOwnership: coreir.OwnershipKind,
        copyOrigin: int32): coreir.BodyIR =
    var body = coreir.BodyIRNew()
    bindStrTypeFact(body)
    let source = addStr(body, "cleanup_copy_source")
    let target = addStr(body, "cleanup_copy_target")
    freezeFirstEntryOwnership(
        body, int32(coreir.OwnInvalid))
    let sourceDefinition = appendOwnedCall(
        body, source, 733, coreir.BodyCallPassSretResultTag)
    let copyIndex = body.ops.len
    var sourceOp = body.ops[sourceDefinition]
    sourceOp.valueDefConsumeOpIndexPlusOne = copyIndex + 1
    sourceOp.consumeActionRow = 17
    body.ops[sourceDefinition] = sourceOp
    var copy: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(copy)
    copy.kind = coreir.BodyOpCopyLocalTag
    copy.target = target
    copy.valueDefSlot = target
    copy.valueDefExprNodeIndex = -1
    copy.valueDefSemanticRow = sourceOp.valueDefSemanticRow
    copy.valueDefOwnership = copyOwnership
    copy.valueDefOriginKind = copyOrigin
    copy.valueDefOriginId = 17
    copy.sourceDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    copy.sourceDefinitionRow = sourceDefinition
    add(copy.operands, source)
    smokeAssert(coreir.BodyIRAppendOp(body, copy) == copyIndex,
                "ownership production smoke: cleanup copy index")
    let returnTerm = appendReturn(body, target, copyIndex)
    let _ = coreir.BodyIRAppendBlock(body, 0, 2, returnTerm)
    sealControlFlow(body, 733)
    return body

fn assertManagedCleanupCopyAccepted() =
    var body = buildManagedCleanupCopyFixture(
        coreir.OwnMove,
        coreir.BodyDefinitionOriginCanonicalCleanupActionTag)
    var access = bodyaccess.BodyIrAccessDecode(body)
    smokeAssert(bodyaccess.BodyIrAccessTableIsValid(access),
                "ownership production smoke: canonical cleanup copy rejected")

fn runManagedCleanupCopyBorrowedRejected() =
    var body = buildManagedCleanupCopyFixture(
        coreir.OwnBorrowShared,
        coreir.BodyDefinitionOriginCanonicalCleanupActionTag)
    var access = bodyaccess.BodyIrAccessDecode(body)
    smokeAssert(
        !bodyaccess.BodyIrAccessTableIsValid(access) &&
        access.errorCode ==
            bodyaccess.BodyIrAccessOwnershipInvariantErrorCode(),
        "ownership production smoke: borrowed cleanup copy accepted")
    let _ = production.OwnershipBodyIrProductionApplyOwned(body)
    panic("ownership production smoke: borrowed cleanup copy production accepted")

fn runManagedCleanupCopyOriginRejected() =
    var body = buildManagedCleanupCopyFixture(
        coreir.OwnMove,
        coreir.BodyDefinitionOriginTypedExprTag)
    var access = bodyaccess.BodyIrAccessDecode(body)
    smokeAssert(
        !bodyaccess.BodyIrAccessTableIsValid(access) &&
        access.errorCode ==
            bodyaccess.BodyIrAccessOwnershipInvariantErrorCode(),
        "ownership production smoke: wrong-origin cleanup copy accepted")
    let _ = production.OwnershipBodyIrProductionApplyOwned(body)
    panic("ownership production smoke: wrong-origin cleanup copy production accepted")

@borrows
fn countTarget(body: coreir.BodyIR, symbol: str): int32 =
    var out: int32
    for callIndex in 0..<body.callSequence.len:
        if body.callSequence[callIndex].targetSymbol == symbol:
            out = out + 1
    return out

fn assertMaterialized(body: var coreir.BodyIR,
                      report: production.OwnershipBodyIrProductionReport) =
    smokeAssert(report.applied && report.plannerReleased &&
                report.ownedDefinitionCount == 1 &&
                report.ownershipActionCount > 0 &&
                report.materializedCallCount > 0,
                "ownership production smoke: report incomplete")
    var access = bodyaccess.BodyIrAccessDecode(body)
    smokeAssert(bodyaccess.BodyIrAccessTableIsValid(access),
                "ownership production smoke: BodyIR ownership invalid")
    smokeAssert(countTarget(body, "cheng_str_drop_owned") > 0,
                "ownership production smoke: canonical drop missing")

fn assertManagedReplaceVerifyPreservesCallResult(
        body: var coreir.BodyIR,
        definition: int32) =
    let kindBefore = body.ops[definition].kind
    let operandCountBefore = body.ops[definition].operands.len
    let operandCapacityBefore = body.ops[definition].operands.cap
    let callIndexBefore = body.ops[definition].operands[0]
    let resultSlotBefore =
        body.callSequence[callIndexBefore].resultSlot
    let resultPassKindBefore =
        body.callSequence[callIndexBefore].resultPassKind
    let resultOwnershipBefore =
        body.callSequence[callIndexBefore].resultOwnership
    let resultExprNodeIndexBefore =
        body.callSequence[callIndexBefore].resultExprNodeIndex
    let resultValueDefinitionRowBefore =
        body.callSequence[callIndexBefore].resultValueDefinitionRow
    let resultDefinitionOriginKindBefore =
        body.callSequence[
            callIndexBefore].resultDefinitionOriginKind
    let resultDefinitionOriginIdBefore =
        body.callSequence[callIndexBefore].resultDefinitionOriginId
    let sourceDefinitionRowBefore =
        body.callSequence[callIndexBefore].sourceDefinitionRow
    let sourceDefinitionDomainBefore =
        body.callSequence[callIndexBefore].sourceDefinitionDomain
    let consumeActionRowBefore =
        body.callSequence[callIndexBefore].consumeActionRow
    let report =
        managedreplace.ManagedLvalueReplaceProductionVerify(body)
    smokeAssert(report.valid,
                "ownership production smoke: managed replace verify invalid")
    smokeAssert(report.rawManagedStoreCount == 0,
                "ownership production smoke: raw managed store drift")
    smokeAssert(body.ops[definition].kind == kindBefore,
                "ownership production smoke: managed replace op kind drift")
    smokeAssert(
        body.ops[definition].operands.len == operandCountBefore,
        "ownership production smoke: managed replace operand count drift")
    smokeAssert(
        body.ops[definition].operands.cap == operandCapacityBefore,
        "ownership production smoke: managed replace operand buffer identity drift")
    smokeAssert(
        body.ops[definition].operands[0] == callIndexBefore,
        "ownership production smoke: managed replace call index drift")
    smokeAssert(
        body.callSequence[callIndexBefore].resultSlot ==
            resultSlotBefore,
        "ownership production smoke: managed replace result slot drift")
    smokeAssert(
        body.callSequence[callIndexBefore].resultPassKind ==
            resultPassKindBefore,
        "ownership production smoke: managed replace pass kind drift")
    smokeAssert(
        body.callSequence[callIndexBefore].resultOwnership ==
            resultOwnershipBefore,
        "ownership production smoke: managed replace ownership drift")
    smokeAssert(
        body.callSequence[callIndexBefore].resultExprNodeIndex ==
            resultExprNodeIndexBefore,
        "ownership production smoke: managed replace expr identity drift")
    smokeAssert(
        body.callSequence[callIndexBefore].resultValueDefinitionRow ==
            resultValueDefinitionRowBefore,
        "ownership production smoke: managed replace value definition drift")
    smokeAssert(
        body.callSequence[
            callIndexBefore].resultDefinitionOriginKind ==
            resultDefinitionOriginKindBefore,
        "ownership production smoke: managed replace origin kind drift")
    smokeAssert(
        body.callSequence[callIndexBefore].resultDefinitionOriginId ==
            resultDefinitionOriginIdBefore,
        "ownership production smoke: managed replace origin identity drift")
    smokeAssert(
        body.callSequence[callIndexBefore].sourceDefinitionDomain ==
            sourceDefinitionDomainBefore &&
        body.callSequence[callIndexBefore].sourceDefinitionRow ==
            sourceDefinitionRowBefore,
        "ownership production smoke: managed replace source definition drift")
    smokeAssert(
        body.callSequence[callIndexBefore].consumeActionRow ==
            consumeActionRowBefore,
        "ownership production smoke: managed replace consume action drift")

fn runDiamondPartialInit() =
    var body = coreir.BodyIRNew()
    bindStrTypeFact(body)
    let condition = addI32(body, "condition")
    let owned = addStr(body, "owned")
    let result = addI32(body, "result")
    let _ = appendConst(body, condition, 1)
    let entryTerm = appendCbr(body, condition, 1, 2)
    let _ = coreir.BodyIRAppendBlock(body, 0, 1, entryTerm)
    let ownedDefinition = appendOwnedCall(
        body, owned, 101, coreir.BodyCallPassSretResultTag)
    let yesTerm = appendBr(body, 3)
    let _ = coreir.BodyIRAppendBlock(body, 1, 1, yesTerm)
    let noTerm = appendBr(body, 3)
    let _ = coreir.BodyIRAppendBlock(body, 2, 0, noTerm)
    let _ = appendConst(body, result, 9)
    let returnTerm = appendReturn(body, result, -1)
    let _ = coreir.BodyIRAppendBlock(body, 2, 1, returnTerm)
    smokeAssert(ownedDefinition == 1,
                "ownership production smoke: definition row drift")
    sealControlFlow(body, 101)
    assertManagedReplaceVerifyPreservesCallResult(
        body, ownedDefinition)
    let report =
        production.OwnershipBodyIrProductionApplyOwned(body)
    assertMaterialized(body, report)
    smokeAssert(report.conditionFlagCount > 0,
                "ownership production smoke: partial-init flag missing")

fn runOwnedSretReturn() =
    var body = coreir.BodyIRNew()
    bindStrTypeFact(body)
    let owned = addStr(body, "owned_return")
    let ownedDefinition = appendOwnedCall(
        body, owned, 202, coreir.BodyCallPassSretResultTag)
    let returnTerm = appendReturn(body, owned, ownedDefinition)
    let _ = coreir.BodyIRAppendBlock(body, 0, 1, returnTerm)
    sealControlFlow(body, 202)
    let report =
        production.OwnershipBodyIrProductionApplyOwned(body)
    assertMaterialized(body, report)
    smokeAssert(countTarget(
                    body, "cheng_str_snapshot_retain_owned") == 1,
                "ownership production smoke: owned return snapshot missing")

fn runMultipleScalarReturns() =
    var body = coreir.BodyIRNew()
    bindStrTypeFact(body)
    let owned = addStr(body, "owned_before_branch")
    let condition = addI32(body, "condition")
    let yesValue = addI32(body, "yes")
    let noValue = addI32(body, "no")
    let _ = appendOwnedCall(
        body, owned, 303, coreir.BodyCallPassSretResultTag)
    let _ = appendConst(body, condition, 1)
    let entryTerm = appendCbr(body, condition, 1, 2)
    let _ = coreir.BodyIRAppendBlock(body, 0, 2, entryTerm)
    let _ = appendConst(body, yesValue, 7)
    let yesReturn = appendReturn(body, yesValue, -1)
    let _ = coreir.BodyIRAppendBlock(body, 2, 1, yesReturn)
    let _ = appendConst(body, noValue, 8)
    let noReturn = appendReturn(body, noValue, -1)
    let _ = coreir.BodyIRAppendBlock(body, 3, 1, noReturn)
    sealControlFlow(body, 303)
    let report =
        production.OwnershipBodyIrProductionApplyOwned(body)
    assertMaterialized(body, report)
    smokeAssert(report.normalizedReturnCount == 2 &&
                countTarget(body, "cheng_str_drop_owned") == 2,
                "ownership production smoke: per-edge return cleanup missing")

fn main(argc: int32, argv: str*): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    let mode = cmdline.ParamStr(1)
    if len(mode) == 0:
        assertManualConsumePhysicalOrderAccepted(0)
        assertManualConsumePhysicalOrderAccepted(1)
        assertManagedCleanupCopyAccepted()
        runDiamondPartialInit()
        runOwnedSretReturn()
        runMultipleScalarReturns()
        echo("ownership_body_ir_production_smoke ok")
        return 0
    if mode == "same-block-future":
        runManualConsumeFutureDefinitionRejected()
    elif mode == "non-dominating-sibling":
        runManualConsumeNonDominatingSiblingRejected()
    elif mode == "raw-managed-store":
        runRawManagedStoreRejected()
    elif mode == "raw-managed-load":
        runRawManagedLoadRejected()
    elif mode == "forged-typed-owned-project":
        runForgedTypedOwnedProjectRejected()
    elif mode == "forged-typed-borrowed-project":
        runForgedTypedBorrowedProjectRejected()
    elif mode == "managed-cleanup-copy-borrowed":
        runManagedCleanupCopyBorrowedRejected()
    elif mode == "managed-cleanup-copy-origin":
        runManagedCleanupCopyOriginRejected()
    else:
        panic("ownership production smoke: unknown mode")
    return 0
