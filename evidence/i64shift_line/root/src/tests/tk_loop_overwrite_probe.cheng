module tk_loop_overwrite_probe

import std/strutils as strutil

fn Probe(lines: str[]): int32 =
    var prior: str
    var count: int32
    for index in 0..<lines.len:
        let relativePath = lines[index]
        if index > 0 && len(prior) > len(relativePath):
            count += 1
        prior = relativePath
    return count

fn main(): int32 =
    let text = "a\nbb\nc"
    let lines = strutil.Split(text, '\n')
    return Probe(lines)

main()
