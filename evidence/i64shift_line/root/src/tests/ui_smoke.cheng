# ui_smoke — Zero raw pointer GUI test using handle-based API
#
# Uses direct @importc (no module import) to call C bridge functions,
# wrapping them in handle-based helpers so application code never sees ptr.

# --- Handle management ---
@importc("cheng_ui_alloc_handle")
fn __allocHandle(ptr: ptr): int32

@importc("cheng_ui_get_handle")
fn __getHandle(id: int32): ptr

@importc("cheng_ui_free_handle")
fn __freeHandle(id: int32)

# --- Window ---
@importc("cheng_app_init")
fn __appInit()

@importc("cheng_app_run_frame")
fn __processFrame()

@importc("cheng_window_create")
fn __windowCreate(title: str, w: int32, h: int32): ptr

@importc("cheng_window_show")
fn __windowShow(win: ptr)

@importc("cheng_window_close")
fn __windowClose(win: ptr)

@importc("cheng_window_add_view")
fn __windowAddView(win: ptr, view: ptr)

# --- Controls ---
@importc("cheng_label_create")
fn __labelCreate(text: str, x: int32, y: int32, w: int32, h: int32): ptr

@importc("cheng_label_set_text")
fn __labelSetText(label: ptr, text: str)

@importc("cheng_button_create")
fn __buttonCreate(title: str, x: int32, y: int32, w: int32, h: int32): ptr

@importc("cheng_canvas_create")
fn __canvasCreate(x: int32, y: int32, w: int32, h: int32): ptr

@importc("cheng_canvas_set_color")
fn __canvasSetColor(canvas: ptr, r: int32, g: int32, b: int32)

@importc("cheng_view_release")
fn __viewRelease(view: ptr)

# --- Event ---
@importc("cheng_next_event_type")
fn __nextEventType(): int32

@importc("cheng_next_event_x")
fn __nextEventX(): int32

@importc("cheng_next_event_y")
fn __nextEventY(): int32

@importc("cheng_event_consume")
fn __eventConsume()

@importc("cheng_sleep_ms")
fn __sleepMs(ms: int32)

# ============================================================
# Handle-based wrappers — no ptr in any public signature
# ============================================================

const
    EVENT_NONE: int32 = 0
    EVENT_QUIT: int32 = 1

fn app_init() =
    __appInit()

fn app_processFrame() =
    __processFrame()

fn app_sleepMs(ms: int32) =
    __sleepMs(ms)

fn app_nextEvent(): int32 =
    return __nextEventType()

fn app_consumeEvent() =
    __eventConsume()

fn window_create(title: str, w: int32, h: int32): int32 =
    var win = __windowCreate(title, w, h)
    return __allocHandle(win)

fn window_show(id: int32) =
    var win = __getHandle(id)
    __windowShow(win)

fn window_close(id: int32) =
    var win = __getHandle(id)
    __windowClose(win)

fn window_add(id: int32, childId: int32) =
    var win = __getHandle(id)
    var child = __getHandle(childId)
    __windowAddView(win, child)

fn label_create(text: str, x: int32, y: int32, w: int32, h: int32): int32 =
    var lbl = __labelCreate(text, x, y, w, h)
    return __allocHandle(lbl)

fn canvas_create(x: int32, y: int32, w: int32, h: int32): int32 =
    var cv = __canvasCreate(x, y, w, h)
    return __allocHandle(cv)

fn canvas_setColor(id: int32, r: int32, g: int32, b: int32) =
    var cv = __getHandle(id)
    __canvasSetColor(cv, r, g, b)

fn button_create(title: str, x: int32, y: int32, w: int32, h: int32): int32 =
    var btn = __buttonCreate(title, x, y, w, h)
    return __allocHandle(btn)

fn control_release(id: int32) =
    var view = __getHandle(id)
    __viewRelease(view)
    __freeHandle(id)

# ============================================================
# Test — application code never touches ptr
# ============================================================

fn main(): int32 =
    app_init()
    var win = window_create("Production GUI (no ptr)", 600, 400)
    window_show(win)

    var lbl = label_create("Zero raw pointers!", 50, 350, 300, 30)
    window_add(win, lbl)

    var cv = canvas_create(50, 100, 500, 200)
    canvas_setColor(cv, 100, 150, 255)
    window_add(win, cv)

    var btn = button_create("Click Me", 220, 30, 160, 40)
    window_add(win, btn)

    var frame: int32
    while frame < 180:
        app_processFrame()
        var ev = app_nextEvent()
        while ev != EVENT_NONE:
            if ev == EVENT_QUIT:
                frame = 999
            app_consumeEvent()
            ev = app_nextEvent()
        app_sleepMs(16)
        frame = frame + 1

    control_release(lbl)
    control_release(cv)
    control_release(btn)
    window_close(win)
    return 0
