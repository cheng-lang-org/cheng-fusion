import std/result
import std/os
import std/strutils as strutil
import cheng/std/bytes_layout as layout
import cheng/core/tooling/compiler_request as creq
import cheng/core/tooling/compiler_world as cworld
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/backend/system_link_plan as slplan
import cheng/core/backend/system_link_exec as sexec

fn CompilerWorldReplaceTomlQuotedLine(text: str,
                                      key: str,
                                      quotedValue: str): str =
    let lines = strutil.Split(text, '\n')
    let prefix = strutil.Join([key, " = "], "")
    var out = ""
    var replaced = false
    for index in 0..<lines.len:
        let line = strutil.Strip(lines[index])
        var nextLine = line
        if strutil.StartsWith(line, prefix):
            nextLine = strutil.Join([prefix, quotedValue], "")
            replaced = true
        if out.len > 0:
            out = strutil.Join([out, "\n"], "")
        out = strutil.Join([out, nextLine], "")
    assert(replaced,
           Fmt"compiler world manifest closure: missing lock key {key}")
    return out

fn CompilerWorldClosurePrintCidPair(label: str,
                                    left: layout.FixedBytes32,
                                    right: layout.FixedBytes32) =
    if layout.FixedBytes32Equal(left, right):
        return
    echo(Fmt" compiler world manifest closure drift {label} left={layout.FixedBytes32Hex(left)} right={layout.FixedBytes32Hex(right)}")

fn CompilerWorldClosurePrintPlanDrift(left: sexec.SystemLinkExecPlan,
                                      right: sexec.SystemLinkExecPlan) =
    CompilerWorldClosurePrintCidPair("source_bundle",
                                     left.sourceBundleCid,
                                     right.sourceBundleCid)
    CompilerWorldClosurePrintCidPair(
        "canonical_csg",
        left.compilerCsg.canonicalGraphCid,
        right.compilerCsg.canonicalGraphCid)
    CompilerWorldClosurePrintCidPair(
        "manifest",
        left.localUniverse.manifest.manifestCid,
        right.localUniverse.manifest.manifestCid)
    CompilerWorldClosurePrintCidPair(
        "world_head",
        left.localUniverse.worldHead.headCid,
        right.localUniverse.worldHead.headCid)

# sexec 整管 BuildSystemLinkExecPlan(WithWorldAndChannel) 当前自洽破缺:
# lowering bind 的 LoweringReleaseCompilerCsgAfterBind 先释放
# compilerCsg.nodes/edges, 同函数后段的 CompilerCsgTransitionReceiptStrictValidateInto
# (含 artifact graph 列校验) 必撞 graph column/count mismatch。因此本 fixture
# 不走整管 builder, 按 driver freeze-before-lowering 时序手工装链 (与
# system_link_payload_lifecycle_state_smoke 的 LifecyclePrepareRuntimePlan 同构):
# stub → portable source receipt → source bundle receipt → CSG (消耗 linkPlan
# 输入) → 在 CSG 存活期内冻结 exportSurface / localUniverse / semanticReceipt /
# binding seal, 不跑 lowering, CSG 列原样进 plan; 最后三处 targetTriple 对齐。
# universe 用 stable channel 冻结 (零 proof/mirror 对合法), stable lock 的
# proof/mirror 成对门禁正是下方 wrong-proof 负向断言的被测物。
fn CompilerWorldClosurePreparePlan(root: str,
                                   packageId: str,
                                   plan: var sexec.SystemLinkExecPlan) =
    let sourceDir = Fmt"{root}/src"
    let entryPath = Fmt"{sourceDir}/main.cheng"
    os.MkdirAll(sourceDir, 493)
    os.WriteFile(Fmt"{root}/cheng-package.toml",
                 Fmt"package_id = \"{packageId}\"\n")
    os.WriteFile(entryPath,
                 "fn Root(): int32 =\n    return 7\n")
    let base = creq.CompilerRequestNew(root,
                                       entryPath,
                                       Fmt"{root}/closure.o",
                                       "arm64-apple-darwin",
                                       creq.EmitObj,
                                       "")
    var request = creq.CompilerRequestWithExportRootSymbols(base, ["Root"])
    creq.CompilerRequestSeal(request)
    var linkPlan: slplan.SystemLinkPlanStub
    var err = ""
    assert(slplan.BuildSystemLinkPlanStub(root, request, linkPlan, err), err)
    assert(slplan.SystemLinkPlanSourceBundleBindingValidInto(linkPlan, err),
           err)
    var sourceReceipt: ccsg.PortableSourceIdentityReceipt
    assert(ccsg.PortableSourceIdentityReceiptMakeInto(
               linkPlan.sourceClosurePaths.len,
               linkPlan.importEdges.len,
               linkPlan.unresolvedImportCount,
               linkPlan.packageId,
               linkPlan.ownerModulePaths[linkPlan.sourceBundleEntrySourceIndex],
               linkPlan.sourceBundleCidValue,
               linkPlan.sourceBundleEntrySourceCid,
               linkPlan.sourceBundleImportGraphCid,
               sourceReceipt,
               err), err)
    var sourceBundleReceipt: sexec.SystemLinkExecSourceBundleReceipt
    assert(sexec.SystemLinkExecSourceBundleReceiptCaptureInto(
               linkPlan,
               sourceReceipt,
               sourceBundleReceipt,
               err), err)
    var csg: ccsg.CompilerCsg
    assert(ccsg.BuildCompilerCsgConsumePortableReceiptInto(csg,
                                                           err,
                                                           linkPlan,
                                                           sourceReceipt), err)
    linkPlan.managedDependencyReceipt =
        slplan.SystemLinkPlanManagedDependencyReceipt()
    var exportSurface: ccsg.CsgExportSurface
    ccsg.CompilerExportSurfaceFromCsgInto(csg, exportSurface)
    var localUniverse: cworld.CompilerLocalUniverse
    var extraManifestEntries: cworld.CompilerUniverseManifestEntry[]
    assert(cworld.CompilerLocalUniverseBuildForChannelWithManifestEntriesInto(
               localUniverse,
               err,
               "stable",
               sourceBundleReceipt.sourceBundleCid,
               csg.canonicalGraphCid,
               exportSurface.surfaceCid,
               layout.FixedBytes32(),
               layout.FixedBytes32(),
               extraManifestEntries), err)
    var orderedProviders: str[]
    assert(sexec.SystemLinkExecCanonicalProviderSetInto(
               linkPlan.providerModules,
               orderedProviders,
               err), err)
    let canonicalOutputDigest = sexec.SystemLinkExecCanonicalOutputDigest(
        linkPlan.emitKind,
        linkPlan.symbolVisibility,
        linkPlan.targetTriple,
        orderedProviders,
        csg.canonicalGraphCid)
    var semanticReceipt: sexec.CompileSemanticReceipt
    assert(sexec.SystemLinkExecCompileSemanticReceiptMakeInto(
               csg.sourceIdentityReceipt,
               csg,
               canonicalOutputDigest,
               linkPlan.targetTriple,
               "stage3_local",
               orderedProviders,
               semanticReceipt,
               err), err)
    plan.sourceBundleReceipt = sourceBundleReceipt
    plan.sourceBundleCid = sourceBundleReceipt.sourceBundleCid
    plan.compilerEntrySource = linkPlan.buildEntryPath
    plan.systemLinkPlan = linkPlan
    plan.compilerCsg = csg
    plan.exportSurface = exportSurface
    plan.localUniverse = localUniverse
    plan.semanticReceipt = semanticReceipt
    plan.sourceToCsgBindingSeal = sexec.SystemLinkExecSourceToCsgBindingSeal(
        csg.sourceIdentityReceipt.receiptCid,
        csg.canonicalGraphCid,
        semanticReceipt.receiptCid)
    plan.requestBackendKind = request.backendKind
    plan.requestedJobCount = request.jobCount
    plan.requestEmitKind = request.emitKind
    plan.requestProviderObjectPaths =
        share(request.providerObjectPaths)
    plan.requestRuntimeProviderBundle =
        share(request.runtimeProviderBundle)
    plan.backendRequestActionCid =
        request.backendRequestActionCid
    plan.backendRequestCid = request.backendRequestCid
    plan.requestBindingSealed = true
    plan.objectPlan.targetTriple = linkPlan.targetTriple
    for providerIndex in 0..<linkPlan.providerModules.len:
        add(plan.objectPlan.providerModules,
            linkPlan.providerModules[providerIndex])
    plan.nativeLinkPlan.targetTriple = linkPlan.targetTriple

# 旧版攻击辅助会把伪造 receipt 重链进 transition/semantic receipt 再让严格链
# 拒; 当前 API 更严: CompilerCsgTransitionReceiptMakeInto /
# SystemLinkExecCompileSemanticReceiptMakeInto 对绑定不上的伪造身份直接
# Make 失败 (「portable artifact source identity binding mismatch」), 重链
# 本身即被拒, 无对应物。等价负向断言: 伪造 receipt 经 MakeInto 仍自洽有效
# (seal 由输入算出), 换入 plan 后严格链必须在本地绑定门禁处拒绝。
fn AssertCoordinatedIdentityMutationRejected(
        base: sexec.SystemLinkExecPlan,
        packageId: str,
        entryModulePath: str,
        sourceSnapshotCount: int32,
        importEdgeCount: int32) =
    var attack = base
    var sourceReceipt: ccsg.PortableSourceIdentityReceipt
    var err: str
    assert(ccsg.PortableSourceIdentityReceiptMakeInto(
               sourceSnapshotCount,
               importEdgeCount,
               base.compilerCsg.sourceIdentityReceipt.unresolvedImportCount,
               packageId,
               entryModulePath,
               base.compilerCsg.sourceIdentityReceipt.sourceBundleCid,
               base.compilerCsg.sourceIdentityReceipt.entrySourceCid,
               base.compilerCsg.sourceIdentityReceipt.importGraphCid,
               sourceReceipt,
               err),
           err)
    attack.compilerCsg.sourceIdentityReceipt = sourceReceipt
    assert(!sexec.SystemLinkExecPlanCidChainStrictValidateInto(attack, err) &&
           err == "system link exec: portable source receipt local binding mismatch",
           "compiler world manifest closure: coordinated source identity attack accepted")

fn main(): int32 =
    let artifactRoot = "/tmp/compiler_world_manifest_closure_smoke"
    let packageId = "pkg://cheng/manifest-closure"
    var plan: sexec.SystemLinkExecPlan
    CompilerWorldClosurePreparePlan(Fmt"{artifactRoot}/root_a",
                                    packageId,
                                    plan)
    var strictErr: str
    assert(sexec.SystemLinkExecPlanCidChainStrictValidateInto(plan,
                                                              strictErr),
           strictErr)
    let backendActionCid = plan.backendRequestActionCid
    plan.backendRequestActionCid = layout.FixedBytes32()
    assert(!sexec.SystemLinkExecPlanCidChainStrictValidateInto(
               plan,
               strictErr) &&
           strictErr ==
               "system link exec: backend request CID binding mismatch",
           "compiler world manifest closure: zero backend action CID accepted")
    plan.backendRequestActionCid = backendActionCid
    let backendRequestCid = plan.backendRequestCid
    plan.backendRequestCid = layout.FixedBytes32()
    assert(!sexec.SystemLinkExecPlanCidChainStrictValidateInto(
               plan,
               strictErr) &&
           strictErr ==
               "system link exec: backend request CID binding mismatch",
           "compiler world manifest closure: zero backend request CID accepted")
    plan.backendRequestCid = backendRequestCid
    assert(sexec.SystemLinkExecPlanCidChainStrictValidateInto(
               plan,
               strictErr),
           strictErr)

    let manifestReport =
        cworld.CompilerUniverseManifestReport(plan.localUniverse.manifest)
    var parsedManifest: cworld.CompilerUniverseManifest
    let parseManifestRes = cworld.CompilerUniverseManifestFromReportText(
        manifestReport,
        parsedManifest)
    assert(IsOk(parseManifestRes) && Value(parseManifestRes),
           "compiler world manifest closure: manifest roundtrip parse")
    assert(layout.FixedBytes32Equal(parsedManifest.manifestCid,
                                    plan.localUniverse.manifest.manifestCid) &&
           parsedManifest.entryCount == plan.localUniverse.manifest.entryCount &&
           parsedManifest.entryCount == 3,
           "compiler world manifest closure: manifest roundtrip identity")
    var wrongManifestEntries: cworld.CompilerUniverseManifestEntry[]
    for entryIndex in 0..<parsedManifest.entries.len:
        add(wrongManifestEntries, parsedManifest.entries[entryIndex])
    wrongManifestEntries[0].syntaxSurfaceCid = cworld.CompilerWorldHashText(
        "wrong_manifest_syntax",
        [packageId])
    let wrongManifestIdentityRes = cworld.CompilerUniverseManifestMake(
        parsedManifest.channel,
        wrongManifestEntries,
        parsedManifest.managedDependencyReceiptCid)
    assert(IsOk(wrongManifestIdentityRes) &&
           !layout.FixedBytes32Equal(
               Value(wrongManifestIdentityRes).manifestCid,
               parsedManifest.manifestCid),
           "compiler world manifest closure: manifest cid omitted entry identity")

    let lockText = cworld.CompilerLockText(plan.localUniverse)
    let lockPath = Fmt"{artifactRoot}/closure.lock.toml"
    let lockRes = cworld.CompilerLockSnapshotFromText(lockText, lockPath)
    assert(IsOk(lockRes),
           "compiler world manifest closure: canonical lock parse")
    let lock = Value(lockRes)
    let verifyLockRes = cworld.CompilerWorldVerifyLock(plan.localUniverse,
                                                       lock)
    assert(IsOk(verifyLockRes) && Value(verifyLockRes),
           "compiler world manifest closure: canonical lock verify")
    os.WriteFile(lockPath, lockText)
    assert(os.FileExists(lockPath),
           "compiler world manifest closure: canonical lock write")

    # 生产整管 BuildSystemLinkExecPlanWithWorldAndChannel 的 world-head pin +
    # lock 门禁 (含「pinned 必须带 lock」与「wrong lock 拒绝」) 挂在同一破缺
    # builder 上, 手工链无对应物; 等价的当前严格性经 cworld 公开门禁覆盖:
    # 正确 head hex 必须匹配, 篡改 head hex 必须被拒; wrong lock 的拒绝由下方
    # CompilerWorldVerifyLock 负向断言承载。
    let headHex = layout.FixedBytes32Hex(plan.localUniverse.worldHead.headCid)
    let headMatchRes = cworld.CompilerWorldHeadMatchesHex(
        plan.localUniverse.worldHead,
        headHex)
    assert(IsOk(headMatchRes) && Value(headMatchRes),
           "compiler world manifest closure: world head pin match")
    let wrongHeadHex = layout.FixedBytes32Hex(
        cworld.CompilerWorldHashText("wrong_world_head", [headHex]))
    assert(IsErr(cworld.CompilerWorldHeadMatchesHex(
               plan.localUniverse.worldHead,
               wrongHeadHex)),
           "compiler world manifest closure: wrong world head pin accepted")

    let wrongManifestHex = layout.FixedBytes32Hex(
        cworld.CompilerWorldHashText("wrong_manifest", [packageId]))
    let wrongManifestText = CompilerWorldReplaceTomlQuotedLine(
        lockText,
        "manifest_root_cid",
        strutil.Join(["\"", wrongManifestHex, "\""], ""))
    let wrongManifestLockPath = Fmt"{artifactRoot}/wrong_manifest.lock.toml"
    let wrongManifestLockRes = cworld.CompilerLockSnapshotFromText(
        wrongManifestText,
        wrongManifestLockPath)
    assert(IsOk(wrongManifestLockRes) &&
           IsErr(cworld.CompilerWorldVerifyLock(
               plan.localUniverse,
               Value(wrongManifestLockRes))),
           "compiler world manifest closure: wrong manifest lock accepted")
    os.WriteFile(wrongManifestLockPath, wrongManifestText)
    assert(os.FileExists(wrongManifestLockPath),
           "compiler world manifest closure: wrong manifest lock write")

    let wrongChannelText = CompilerWorldReplaceTomlQuotedLine(
        lockText,
        "channel",
        "\"edge\"")
    let wrongChannelRes = cworld.CompilerLockSnapshotFromText(
        wrongChannelText,
        Fmt"{artifactRoot}/wrong_channel.lock.toml")
    assert(IsOk(wrongChannelRes) &&
           IsErr(cworld.CompilerWorldVerifyLock(
               plan.localUniverse,
               Value(wrongChannelRes))),
           "compiler world manifest closure: wrong channel lock accepted")
    let wrongSnapshotHex = layout.FixedBytes32Hex(
        cworld.CompilerWorldHashText("wrong_snapshot", [packageId]))
    let wrongSnapshotText = CompilerWorldReplaceTomlQuotedLine(
        lockText,
        "entry[0].snapshot_cid",
        strutil.Join(["\"", wrongSnapshotHex, "\""], ""))
    let wrongSnapshotRes = cworld.CompilerLockSnapshotFromText(
        wrongSnapshotText,
        Fmt"{artifactRoot}/wrong_snapshot.lock.toml")
    assert(IsOk(wrongSnapshotRes) &&
           IsErr(cworld.CompilerWorldVerifyLock(
               plan.localUniverse,
               Value(wrongSnapshotRes))),
           "compiler world manifest closure: wrong snapshot lock accepted")
    let wrongProofHex = layout.FixedBytes32Hex(
        cworld.CompilerWorldHashText("wrong_lock_proof", [packageId]))
    let wrongProofText = CompilerWorldReplaceTomlQuotedLine(
        lockText,
        "entry[0].migration_proof_cid",
        strutil.Join(["\"", wrongProofHex, "\""], ""))
    let wrongProofRes = cworld.CompilerLockSnapshotFromText(
        wrongProofText,
        Fmt"{artifactRoot}/wrong_proof.lock.toml")
    assert(IsErr(wrongProofRes),
           "compiler world manifest closure: incomplete proof/mirror pair accepted")

    # 跨 workspace root 固定点: 同一 package_id + 同一入口源码落到不同绝对
    # root, source bundle / manifest / world head 必须逐位一致 (内容寻址,
    # 不含绝对路径)。
    var frozenPlan: sexec.SystemLinkExecPlan
    CompilerWorldClosurePreparePlan(Fmt"{artifactRoot}/root_b",
                                    packageId,
                                    frozenPlan)
    if !layout.FixedBytes32Equal(frozenPlan.sourceBundleCid,
                                 plan.sourceBundleCid) ||
       !layout.FixedBytes32Equal(
           frozenPlan.localUniverse.manifest.manifestCid,
           plan.localUniverse.manifest.manifestCid) ||
       !layout.FixedBytes32Equal(
           frozenPlan.localUniverse.worldHead.headCid,
           plan.localUniverse.worldHead.headCid):
        CompilerWorldClosurePrintPlanDrift(plan, frozenPlan)
    assert(layout.FixedBytes32Equal(frozenPlan.sourceBundleCid,
                                    plan.sourceBundleCid),
           "compiler world manifest closure: source fixed point across workspace roots")
    assert(layout.FixedBytes32Equal(
               frozenPlan.localUniverse.manifest.manifestCid,
               plan.localUniverse.manifest.manifestCid),
           "compiler world manifest closure: manifest fixed point across workspace roots")
    assert(layout.FixedBytes32Equal(
               frozenPlan.localUniverse.worldHead.headCid,
               plan.localUniverse.worldHead.headCid),
           "compiler world manifest closure: world fixed point across workspace roots")
    assert(sexec.SystemLinkExecPlanCidChainStrictValidateInto(
               frozenPlan,
               strictErr),
           strictErr)

    let sourceReceipt = plan.compilerCsg.sourceIdentityReceipt
    AssertCoordinatedIdentityMutationRejected(
        plan,
        "cheng/forged-package",
        plan.systemLinkPlan.moduleStem,
        sourceReceipt.sourceSnapshotCount,
        sourceReceipt.importEdgeCount)
    AssertCoordinatedIdentityMutationRejected(
        plan,
        plan.systemLinkPlan.packageId,
        "cheng/tests/forged-entry",
        sourceReceipt.sourceSnapshotCount,
        sourceReceipt.importEdgeCount)
    AssertCoordinatedIdentityMutationRejected(
        plan,
        plan.systemLinkPlan.packageId,
        plan.systemLinkPlan.moduleStem,
        sourceReceipt.sourceSnapshotCount + 1,
        sourceReceipt.importEdgeCount)
    AssertCoordinatedIdentityMutationRejected(
        plan,
        plan.systemLinkPlan.packageId,
        plan.systemLinkPlan.moduleStem,
        sourceReceipt.sourceSnapshotCount,
        sourceReceipt.importEdgeCount + 1)
    echo("compiler_world_manifest_closure_smoke ok")
    return 0
