import std/os
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/tooling/semantic_snapshot as snapshot
import cheng/core/tooling/semantic_snapshot_incremental_plan as incremental
import cheng/core/tooling/semantic_snapshot_production as production

@borrows
fn TestCid(label: str): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(label.len)
    for index in 0..<label.len:
        layout.ByteBufAppendByte(buf, Int32(label[index]) & 255)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn RecordMutation(id: str, mutationBytes: str) =
    assert(id != "" && mutationBytes != "",
           " membership smoke: empty mutation identity")
    os.WriteLine(
        os.Get_stdout(),
        Fmt"semantic_snapshot_source_membership_mutation id={id} cid={layout.FixedBytes32Hex(TestCid(mutationBytes))} bytes={mutationBytes}")

@borrows
fn MakePrebuildInput(
        documentCids: layout.FixedBytes32[]):
        incremental.SemanticSnapshotIncrementalPrebuildInput =
    var out: incremental.SemanticSnapshotIncrementalPrebuildInput
    out.worldHeadCid = TestCid("membership/prebuild-world")
    out.compilerCid = TestCid("membership/prebuild-compiler")
    out.sourceBundleCid = TestCid("membership/prebuild-source-bundle")
    out.frontEndReceiptCid = TestCid("membership/prebuild-front-end")
    for sourceId in 0..<documentCids.len:
        add(out.documentCids,
            layout.FixedBytes32Copy(documentCids[sourceId]))
        add(out.sourceProducerIndexes, sourceId)
        add(out.sourceTexts,
            Fmt"fn MembershipSource{sourceId}(): int32 =\n    return {sourceId}\n")
        add(out.sourceInterfaceCids,
            TestCid(Fmt"membership/prebuild-interface/{sourceId}"))
    return out

fn MakeIdentity(): snapshot.PortableSemanticSnapshotIdentity =
    var out: snapshot.PortableSemanticSnapshotIdentity
    var err: str
    assert(snapshot.PortableSemanticSnapshotIdentityMakeInto(
        TestCid("membership/source-receipt"),
        TestCid("membership/world"),
        TestCid("membership/compiler"),
        TestCid("membership/source-bundle"),
        TestCid("membership/csg-root"),
        out, err), " membership smoke: identity build failed")
    return out

@borrows
fn AssertRejectedWithoutVersionAdvance(
        events: var snapshot.WorkspaceSourceEventState,
        store: var snapshot.SemanticSnapshotStore,
        eventKind: int32,
        documentCid: layout.FixedBytes32,
        renameTargetDocumentCid: layout.FixedBytes32) =
    let versionBefore = events.lastAcceptedSourceVersion
    let receiptBefore =
        layout.FixedBytes32Copy(events.eventStateReceiptCid)
    var sourceVersion: int64
    var err: str
    assert(!snapshot.SemanticSnapshotAcceptSourceFileEventInto(
        events, store, eventKind, documentCid,
        renameTargetDocumentCid, sourceVersion, err),
        " membership smoke: invalid file event accepted")
    assert(sourceVersion == 0 &&
           events.lastAcceptedSourceVersion == versionBefore &&
           store.currentSourceVersion == versionBefore &&
           layout.FixedBytes32Equal(
               events.eventStateReceiptCid, receiptBefore),
        " membership smoke: rejected file event mutated state")

@borrows
fn InitProductionOpenInto(
        label: str,
        events: var snapshot.WorkspaceSourceEventState,
        store: var production.SemanticSnapshotProductionStore,
        documentCid: var layout.FixedBytes32,
        sourceVersion: var int64,
        err: var str) =
    let sessionCid = TestCid(Fmt"{label}/session")
    documentCid = TestCid(Fmt"{label}/document")
    assert(snapshot.WorkspaceSourceEventStateInitInto(
               sessionCid, events, err), err)
    assert(production.SemanticSnapshotProductionStoreInitInto(
               sessionCid, store, err), err)
    assert(production.SemanticSnapshotProductionAcceptSourceEventInto(
               events, store,
               snapshot.SemanticSourceEventOpen,
               documentCid, int64(1), sourceVersion, err) &&
           sourceVersion == int64(1),
           " membership smoke: production open failed")

fn AssertCompletionReceiptMutations() =
    let completionAuthorityCid =
        TestCid("membership/completion-authority")
    let wrongReceiptCid =
        TestCid("membership/completion-wrong-source-event-receipt")
    var err: str

    var runningEvents: snapshot.WorkspaceSourceEventState
    var runningStore: production.SemanticSnapshotProductionStore
    var runningDocumentCid: layout.FixedBytes32
    var runningVersion: int64
    InitProductionOpenInto(
        "membership/running-receipt",
        runningEvents, runningStore,
        runningDocumentCid, runningVersion, err)
    var runningTicket: production.SemanticSnapshotProductionJobTicket
    assert(production.SemanticSnapshotProductionJobTicketMakeInto(
               runningEvents, runningStore, runningTicket, err), err)
    assert(production.SemanticSnapshotProductionJobTicketStartInto(
               runningTicket, runningTicket.jobCid, err), err)
    var runningRejection: production.SemanticSnapshotProductionJobCompletionRejection
    assert(!production.SemanticSnapshotProductionJobCompletionBoundAdmitInto(
                runningStore, runningTicket,
                runningTicket.jobCid, runningVersion,
                wrongReceiptCid, completionAuthorityCid,
                runningRejection, err) &&
           err != "" &&
           runningTicket.state ==
               production.SemanticSnapshotProductionJobRunning &&
           layout.FixedBytes32Equal(
               runningRejection.receiptCid,
               layout.FixedBytes32()),
           " membership smoke: running receipt mismatch survived")
    RecordMutation(
        "completion_receipt_mismatch",
        "membership_event/v1|case=completion_receipt_mismatch|field=sourceEventStateReceiptCid|from=ticket|to=foreign")
    assert(production.SemanticSnapshotProductionStoreReleaseInto(
               runningStore, err), err)

    var cancelEvents: snapshot.WorkspaceSourceEventState
    var cancelStore: production.SemanticSnapshotProductionStore
    var cancelDocumentCid: layout.FixedBytes32
    var cancelVersion: int64
    InitProductionOpenInto(
        "membership/cancel-receipt",
        cancelEvents, cancelStore,
        cancelDocumentCid, cancelVersion, err)
    var cancelTicket: production.SemanticSnapshotProductionJobTicket
    assert(production.SemanticSnapshotProductionJobTicketMakeInto(
               cancelEvents, cancelStore, cancelTicket, err), err)
    assert(production.SemanticSnapshotProductionJobTicketStartInto(
               cancelTicket, cancelTicket.jobCid, err), err)
    var cancelled: bool
    assert(production.SemanticSnapshotProductionJobTicketCancelInto(
               cancelTicket, cancelTicket.jobCid, cancelVersion,
               cancelled, err) && cancelled,
           " membership smoke: cancellation setup failed")
    var cancelRejection: production.SemanticSnapshotProductionJobCompletionRejection
    assert(!production.SemanticSnapshotProductionJobCompletionBoundAdmitInto(
                cancelStore, cancelTicket,
                cancelTicket.jobCid, cancelVersion,
                wrongReceiptCid, completionAuthorityCid,
                cancelRejection, err) &&
           err != "" &&
           cancelTicket.state ==
               production.SemanticSnapshotProductionJobCancelled &&
           layout.FixedBytes32Equal(
               cancelRejection.receiptCid,
               layout.FixedBytes32()),
           " membership smoke: cancelled receipt mismatch survived")
    RecordMutation(
        "cancelled_completion_receipt_mismatch",
        "membership_event/v1|case=cancelled_completion_receipt_mismatch|field=sourceEventStateReceiptCid|from=ticket|to=foreign")
    assert(!production.SemanticSnapshotProductionJobCompletionBoundAdmitInto(
                cancelStore, cancelTicket,
                cancelTicket.jobCid, cancelVersion,
                cancelTicket.sourceEventStateReceiptCid,
                completionAuthorityCid,
                cancelRejection, err) &&
           production.SemanticSnapshotProductionJobCompletionRejectionStrictValidateInto(
               cancelRejection, err) &&
           cancelRejection.reasonKind ==
               production.SemanticSnapshotProductionJobCompletionCancelled,
           " membership smoke: canonical cancellation receipt missing")
    assert(production.SemanticSnapshotProductionStoreReleaseInto(
               cancelStore, err), err)

    var lateEvents: snapshot.WorkspaceSourceEventState
    var lateStore: production.SemanticSnapshotProductionStore
    var lateDocumentCid: layout.FixedBytes32
    var lateVersion: int64
    InitProductionOpenInto(
        "membership/late-receipt",
        lateEvents, lateStore,
        lateDocumentCid, lateVersion, err)
    var lateTicket: production.SemanticSnapshotProductionJobTicket
    assert(production.SemanticSnapshotProductionJobTicketMakeInto(
               lateEvents, lateStore, lateTicket, err), err)
    assert(production.SemanticSnapshotProductionJobTicketStartInto(
               lateTicket, lateTicket.jobCid, err), err)
    var nextVersion: int64
    assert(production.SemanticSnapshotProductionAcceptSourceEventInto(
               lateEvents, lateStore,
               snapshot.SemanticSourceEventChange,
               lateDocumentCid, int64(2), nextVersion, err) &&
           nextVersion == int64(2),
           " membership smoke: late completion setup failed")
    var lateRejection: production.SemanticSnapshotProductionJobCompletionRejection
    assert(!production.SemanticSnapshotProductionJobCompletionBoundAdmitInto(
                lateStore, lateTicket,
                lateTicket.jobCid, lateVersion,
                wrongReceiptCid, completionAuthorityCid,
                lateRejection, err) &&
           err != "" &&
           lateTicket.state ==
               production.SemanticSnapshotProductionJobRunning &&
           layout.FixedBytes32Equal(
               lateRejection.receiptCid,
               layout.FixedBytes32()),
           " membership smoke: late receipt mismatch survived")
    RecordMutation(
        "late_completion_receipt_mismatch",
        "membership_event/v1|case=late_completion_receipt_mismatch|field=sourceEventStateReceiptCid|from=ticket|to=foreign")
    assert(!production.SemanticSnapshotProductionJobCompletionBoundAdmitInto(
                lateStore, lateTicket,
                lateTicket.jobCid, lateVersion,
                lateTicket.sourceEventStateReceiptCid,
                completionAuthorityCid,
                lateRejection, err) &&
           production.SemanticSnapshotProductionJobCompletionRejectionStrictValidateInto(
               lateRejection, err) &&
           lateRejection.reasonKind ==
               production.SemanticSnapshotProductionJobCompletionLate,
           " membership smoke: canonical late receipt missing")
    assert(production.SemanticSnapshotProductionStoreReleaseInto(
               lateStore, err), err)

fn main() =
    let sessionCid = TestCid("membership/session")
    let entryCid = TestCid("membership/entry")
    let detachedCid = TestCid("membership/detached")
    let renamedCid = TestCid("membership/renamed")
    let chainedCid = TestCid("membership/chained")
    var events: snapshot.WorkspaceSourceEventState
    var store: snapshot.SemanticSnapshotStore
    var err: str
    assert(snapshot.WorkspaceSourceEventStateInitInto(
        sessionCid, events, err),
        " membership smoke: event state init failed")
    assert(snapshot.SemanticSnapshotStoreInitInto(
        sessionCid, store, err),
        " membership smoke: store init failed")

    var entryStableRow: int32
    assert(snapshot.WorkspaceSourceEventRegisterInitialDocumentInto(
        events, entryCid, entryStableRow, err),
        " membership smoke: initial registration failed")
    assert(entryStableRow == 0 &&
           events.lastAcceptedSourceVersion == 0 &&
           events.documentPresenceStates[entryStableRow] ==
               snapshot.SemanticSourcePresencePresent,
        " membership smoke: initial registration drift")

    var sourceVersion: int64
    assert(snapshot.SemanticSnapshotAcceptSourceEventInto(
        events, store, snapshot.SemanticSourceEventOpen,
        entryCid, int64(1), sourceVersion, err),
        " membership smoke: open failed")
    assert(sourceVersion == 1 &&
           events.documentOpenStates[entryStableRow] == 1,
        " membership smoke: open drift")
    assert(snapshot.SemanticSnapshotAcceptSourceEventInto(
        events, store, snapshot.SemanticSourceEventClose,
        entryCid, int64(-1), sourceVersion, err),
        " membership smoke: close failed")
    assert(sourceVersion == 2 &&
           events.documentOpenStates[entryStableRow] == 0 &&
           events.documentPresenceStates[entryStableRow] ==
               snapshot.SemanticSourcePresencePresent &&
           events.documentLastEventKinds[entryStableRow] ==
               snapshot.SemanticSourceEventClose,
        " membership smoke: close became remove")

    assert(snapshot.SemanticSnapshotAcceptSourceFileEventInto(
        events, store, snapshot.SemanticSourceEventAdd,
        detachedCid, layout.FixedBytes32(), sourceVersion, err),
        " membership smoke: add failed")
    let detachedStableRow = 1
    assert(sourceVersion == 3 &&
           events.documentPresenceStates[detachedStableRow] ==
               snapshot.SemanticSourcePresencePresent,
        " membership smoke: add drift")
    AssertRejectedWithoutVersionAdvance(
        events, store, snapshot.SemanticSourceEventAdd,
        detachedCid, layout.FixedBytes32())
    RecordMutation(
        "duplicate_add",
        "membership_event/v1|case=duplicate_add|field=eventKind|from=absent|to=present")

    assert(snapshot.SemanticSnapshotAcceptSourceFileEventInto(
        events, store, snapshot.SemanticSourceEventRename,
        detachedCid, renamedCid, sourceVersion, err),
        " membership smoke: rename failed")
    let renamedStableRow = 2
    assert(sourceVersion == 4 &&
           events.documentPresenceStates[detachedStableRow] ==
               snapshot.SemanticSourcePresenceAbsent &&
           events.documentPresenceStates[renamedStableRow] ==
               snapshot.SemanticSourcePresencePresent &&
           events.documentRenamePeerRows[detachedStableRow] ==
               renamedStableRow &&
           events.documentRenamePeerRows[renamedStableRow] ==
               detachedStableRow &&
           layout.FixedBytes32Equal(
               events.documentLastEventCids[detachedStableRow],
               events.documentLastEventCids[renamedStableRow]),
        " membership smoke: rename edge drift")

    assert(snapshot.SemanticSnapshotAcceptSourceFileEventInto(
        events, store, snapshot.SemanticSourceEventRename,
        renamedCid, chainedCid, sourceVersion, err),
        " membership smoke: rename chain failed")
    let chainedStableRow = 3
    assert(sourceVersion == 5 &&
           events.documentPresenceStates[renamedStableRow] ==
               snapshot.SemanticSourcePresenceAbsent &&
           events.documentPresenceStates[chainedStableRow] ==
               snapshot.SemanticSourcePresencePresent,
        " membership smoke: rename chain drift")
    AssertRejectedWithoutVersionAdvance(
        events, store, snapshot.SemanticSourceEventRename,
        entryCid, chainedCid)
    RecordMutation(
        "rename_target_present",
        "membership_event/v1|case=rename_target_present|field=renameTargetPresence|from=absent|to=present")
    AssertRejectedWithoutVersionAdvance(
        events, store, snapshot.SemanticSourceEventRemove,
        TestCid("membership/unknown"), layout.FixedBytes32())
    RecordMutation(
        "remove_unknown",
        "membership_event/v1|case=remove_unknown|field=documentCid|from=active|to=unknown")

    assert(snapshot.SemanticSnapshotAcceptSourceFileEventInto(
        events, store, snapshot.SemanticSourceEventRemove,
        chainedCid, layout.FixedBytes32(), sourceVersion, err),
        " membership smoke: remove failed")
    assert(sourceVersion == 6 &&
           events.documentPresenceStates[chainedStableRow] ==
               snapshot.SemanticSourcePresenceAbsent &&
           events.documentLastEventKinds[chainedStableRow] ==
               snapshot.SemanticSourceEventRemove,
        " membership smoke: remove tombstone drift")
    AssertRejectedWithoutVersionAdvance(
        events, store, snapshot.SemanticSourceEventRemove,
        chainedCid, layout.FixedBytes32())
    RecordMutation(
        "duplicate_remove",
        "membership_event/v1|case=duplicate_remove|field=presence|from=present|to=absent")

    assert(snapshot.SemanticSnapshotAcceptSourceFileEventInto(
        events, store, snapshot.SemanticSourceEventAdd,
        chainedCid, layout.FixedBytes32(), sourceVersion, err),
        " membership smoke: tombstone reactivation failed")
    assert(sourceVersion == 7 &&
           events.documentCids.len == 4 &&
           events.documentPresenceStates[chainedStableRow] ==
               snapshot.SemanticSourcePresencePresent,
        " membership smoke: tombstone reactivation changed stable row")

    var activeRows: int32[]
    assert(snapshot.WorkspaceSourceEventActiveSourceRowsInto(
        events, activeRows, err),
        " membership smoke: active rows failed")
    assert(activeRows.len == 2 &&
           activeRows[0] == entryStableRow &&
           activeRows[1] == chainedStableRow,
        " membership smoke: active stable rows drift")

    let prebuildInput = MakePrebuildInput([
        layout.FixedBytes32Copy(entryCid),
        layout.FixedBytes32Copy(chainedCid)])
    var prebuildFacts: incremental.SemanticSnapshotIncrementalPrebuildFacts
    assert(incremental.SemanticSnapshotIncrementalPrebuildFactsMakeInto(
        events, prebuildInput, prebuildFacts, err),
        " membership smoke: next candidate active prebuild failed")
    var entryFactRow: int32 = -1
    var chainedFactRow: int32 = -1
    for sourceId in 0..<prebuildFacts.documentCids.len:
        if layout.FixedBytes32Equal(
                prebuildFacts.documentCids[sourceId], entryCid):
            entryFactRow = sourceId
        elif layout.FixedBytes32Equal(
                prebuildFacts.documentCids[sourceId], chainedCid):
            chainedFactRow = sourceId
        assert(!layout.FixedBytes32Equal(
                   prebuildFacts.documentCids[sourceId], detachedCid) &&
               !layout.FixedBytes32Equal(
                   prebuildFacts.documentCids[sourceId], renamedCid),
               " membership smoke: tombstone entered next candidate")
    assert(prebuildFacts.documentCids.len == 2 &&
           entryFactRow >= 0 &&
           chainedFactRow >= 0 &&
           prebuildFacts.sourceLastEventKinds[entryFactRow] ==
               snapshot.SemanticSourceEventClose &&
           prebuildFacts.sourceLastEventKinds[chainedFactRow] ==
               snapshot.SemanticSourceEventAdd,
        " membership smoke: next candidate active event mapping drift")

    let tombstoneInput = MakePrebuildInput([
        layout.FixedBytes32Copy(entryCid),
        layout.FixedBytes32Copy(detachedCid),
        layout.FixedBytes32Copy(chainedCid)])
    var tombstoneFacts: incremental.SemanticSnapshotIncrementalPrebuildFacts
    assert(!incremental.SemanticSnapshotIncrementalPrebuildFactsMakeInto(
        events, tombstoneInput, tombstoneFacts, err),
        " membership smoke: tombstone inclusion survived")
    RecordMutation(
        "tombstone_inclusion",
        "membership_event/v1|case=tombstone_inclusion|field=activeDocumentCids|from=active_only|to=includes_tombstone")

    let missingActiveInput = MakePrebuildInput([
        layout.FixedBytes32Copy(entryCid)])
    var missingActiveFacts: incremental.SemanticSnapshotIncrementalPrebuildFacts
    assert(!incremental.SemanticSnapshotIncrementalPrebuildFactsMakeInto(
        events, missingActiveInput, missingActiveFacts, err),
        " membership smoke: missing active source survived")
    RecordMutation(
        "missing_active",
        "membership_event/v1|case=missing_active|field=activeDocumentCids|from=complete|to=missing_row")

    let wrongCidInput = MakePrebuildInput([
        layout.FixedBytes32Copy(entryCid),
        layout.FixedBytes32Copy(renamedCid)])
    var wrongCidFacts: incremental.SemanticSnapshotIncrementalPrebuildFacts
    assert(!incremental.SemanticSnapshotIncrementalPrebuildFactsMakeInto(
        events, wrongCidInput, wrongCidFacts, err),
        " membership smoke: wrong active CID survived")
    RecordMutation(
        "wrong_active_cid",
        "membership_event/v1|case=wrong_active_cid|field=documentCid|from=active|to=renamed_tombstone")

    let duplicateInput = MakePrebuildInput([
        layout.FixedBytes32Copy(entryCid),
        layout.FixedBytes32Copy(entryCid)])
    var duplicateFacts: incremental.SemanticSnapshotIncrementalPrebuildFacts
    assert(!incremental.SemanticSnapshotIncrementalPrebuildFactsMakeInto(
        events, duplicateInput, duplicateFacts, err),
        " membership smoke: duplicate active row survived")
    RecordMutation(
        "duplicate_active",
        "membership_event/v1|case=duplicate_active|field=activeSourceStableRows|from=bijective|to=duplicate")

    let reorderedInput = MakePrebuildInput([
        layout.FixedBytes32Copy(chainedCid),
        layout.FixedBytes32Copy(entryCid)])
    var reorderedFacts: incremental.SemanticSnapshotIncrementalPrebuildFacts
    assert(!incremental.SemanticSnapshotIncrementalPrebuildFactsMakeInto(
        events, reorderedInput, reorderedFacts, err),
        " membership smoke: reordered active mapping survived")
    RecordMutation(
        "reordered_active",
        "membership_event/v1|case=reordered_active|field=SourceId|from=canonical|to=swapped")

    let identity = MakeIdentity()
    var binding: snapshot.LocalSourceVersionBinding
    assert(snapshot.LocalSourceVersionBindingMakeInto(
        events, identity, binding, err),
        " membership smoke: binding build failed")
    assert(binding.documentCids.len == 2 &&
           binding.activeSourceStableRows.len == 2 &&
           ((binding.activeSourceStableRows[0] == entryStableRow &&
             binding.activeSourceStableRows[1] == chainedStableRow) ||
            (binding.activeSourceStableRows[0] == chainedStableRow &&
             binding.activeSourceStableRows[1] == entryStableRow)) &&
           layout.FixedBytes32Equal(
               binding.sourceEventStateReceiptCid,
               events.eventStateReceiptCid),
        " membership smoke: active SourceId mapping drift")

    let stableRowBefore = binding.activeSourceStableRows[0]
    binding.activeSourceStableRows[0] = -1
    assert(!snapshot.LocalSourceVersionBindingStrictValidateInto(
        binding, identity, err),
        " membership smoke: active stable-row mutation survived")
    RecordMutation(
        "binding_stable_row",
        "membership_event/v1|case=binding_stable_row|field=activeSourceStableRows[0]|from=stable|to=-1")
    binding.activeSourceStableRows[0] = stableRowBefore
    assert(snapshot.LocalSourceVersionBindingStrictValidateInto(
        binding, identity, err),
        " membership smoke: binding restore failed")

    let receiptBefore =
        layout.FixedBytes32Copy(events.eventStateReceiptCid)
    events.documentPresenceStates[entryStableRow] =
        snapshot.SemanticSourcePresenceAbsent
    assert(!snapshot.WorkspaceSourceEventActiveSourceRowsInto(
        events, activeRows, err),
        " membership smoke: presence mutation survived")
    RecordMutation(
        "presence_state",
        "membership_event/v1|case=presence_state|field=documentPresenceStates[0]|from=present|to=absent")
    events.documentPresenceStates[entryStableRow] =
        snapshot.SemanticSourcePresencePresent
    events.eventStateReceiptCid = receiptBefore
    assert(snapshot.WorkspaceSourceEventActiveSourceRowsInto(
        events, activeRows, err),
        " membership smoke: presence restore failed")

    let renamePeerBefore =
        events.documentRenamePeerRows[renamedStableRow]
    events.documentRenamePeerRows[renamedStableRow] = -1
    assert(!snapshot.WorkspaceSourceEventActiveSourceRowsInto(
        events, activeRows, err),
        " membership smoke: rename peer mutation survived")
    RecordMutation(
        "rename_peer",
        "membership_event/v1|case=rename_peer|field=documentRenamePeerRows|from=paired|to=missing")
    events.documentRenamePeerRows[renamedStableRow] =
        renamePeerBefore
    events.eventStateReceiptCid = receiptBefore
    assert(snapshot.WorkspaceSourceEventActiveSourceRowsInto(
        events, activeRows, err),
        " membership smoke: rename peer restore failed")

    AssertCompletionReceiptMutations()

    os.WriteLine(
        os.Get_stdout(),
        "semantic_snapshot_source_membership_event_smoke: ok")
