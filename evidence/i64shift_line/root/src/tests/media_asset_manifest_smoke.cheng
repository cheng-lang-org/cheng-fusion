import std/rawbytes
import std/strutils as strutil
import cheng/moq/media_asset_manifest as media

fn setU16LE(buf: var rawbytes.Bytes, offset: int32, value: int32) =
    rawbytes.BytesSet(buf, offset, value & 255)
    rawbytes.BytesSet(buf, offset + 1, (value >> 8) & 255)

fn setU32LE(buf: var rawbytes.Bytes, offset: int32, value: int32) =
    rawbytes.BytesSet(buf, offset, value & 255)
    rawbytes.BytesSet(buf, offset + 1, (value >> 8) & 255)
    rawbytes.BytesSet(buf, offset + 2, (value >> 16) & 255)
    rawbytes.BytesSet(buf, offset + 3, (value >> 24) & 255)

fn makeTinyWavBytes(): rawbytes.Bytes =
    var out = rawbytes.BytesAlloc(52)
    rawbytes.BytesSet(out, 0, 82)
    rawbytes.BytesSet(out, 1, 73)
    rawbytes.BytesSet(out, 2, 70)
    rawbytes.BytesSet(out, 3, 70)
    setU32LE(out, 4, 44)
    rawbytes.BytesSet(out, 8, 87)
    rawbytes.BytesSet(out, 9, 65)
    rawbytes.BytesSet(out, 10, 86)
    rawbytes.BytesSet(out, 11, 69)
    rawbytes.BytesSet(out, 12, 102)
    rawbytes.BytesSet(out, 13, 109)
    rawbytes.BytesSet(out, 14, 116)
    rawbytes.BytesSet(out, 15, 32)
    setU32LE(out, 16, 16)
    setU16LE(out, 20, 1)
    setU16LE(out, 22, 1)
    setU32LE(out, 24, 44100)
    setU32LE(out, 28, 88200)
    setU16LE(out, 32, 2)
    setU16LE(out, 34, 16)
    rawbytes.BytesSet(out, 36, 100)
    rawbytes.BytesSet(out, 37, 97)
    rawbytes.BytesSet(out, 38, 116)
    rawbytes.BytesSet(out, 39, 97)
    setU32LE(out, 40, 8)
    rawbytes.BytesSet(out, 44, 0)
    rawbytes.BytesSet(out, 45, 0)
    rawbytes.BytesSet(out, 46, 16)
    rawbytes.BytesSet(out, 47, 0)
    rawbytes.BytesSet(out, 48, 32)
    rawbytes.BytesSet(out, 49, 0)
    rawbytes.BytesSet(out, 50, 48)
    rawbytes.BytesSet(out, 51, 0)
    return out

fn assertImageManifestLifecycle() =
    var imageMissingIndex: media.MediaAssetBuildRequest
    imageMissingIndex.blob = rawbytes.BytesFromString("png-fixture-rgba-pixels")
    imageMissingIndex.ownerPeerId = "peer-alpha"
    imageMissingIndex.remotePeersCsv = "peer-bravo"
    imageMissingIndex.mime = "image/png"
    imageMissingIndex.kindCode = media.MediaAssetKindImage
    imageMissingIndex.codec = "png"
    imageMissingIndex.posterCid = media.MediaAssetSha256Hex(rawbytes.BytesFromString("png-preview"))
    imageMissingIndex.initSegmentCid = media.MediaAssetSha256Hex(rawbytes.BytesFromString("png-metadata"))
    imageMissingIndex.initSegmentByteLength = rawbytes.BytesLen(rawbytes.BytesFromString("png-metadata"))
    imageMissingIndex.contentSignature = "image-signature-provided-by-caller"
    imageMissingIndex.objectTargetBytes = 16
    imageMissingIndex.sourceBlockBytes = 8
    imageMissingIndex.repairDropletCount = 2
    let imageMissingIndexRes = media.MediaAssetBuildManifest(imageMissingIndex)
    assert(IsErr(imageMissingIndexRes), " media asset manifest: image frame index hard fail")

    var imageReq = imageMissingIndex
    imageReq.keyframeIndex = "image:single-frame"
    let imageManifestRes = media.MediaAssetBuildManifest(imageReq)
    assert(IsOk(imageManifestRes), " media asset manifest: image build")
    let imageManifest = Value(imageManifestRes)
    assert(imageManifest.kindCode == media.MediaAssetKindImage, " media asset manifest: image kind")
    assert(imageManifest.mime == "image/png", " media asset manifest: image mime")
    let imageFrameRes = media.MediaAssetFirstFrameReceipt(imageManifest,
                                                          imageReq.blob,
                                                          media.MediaAssetFirstFrameSourceAsset)
    assert(IsOk(imageFrameRes), " media asset manifest: image asset frame")
    let imageFrame = Value(imageFrameRes)
    assert(imageFrame.firstFrameCid == imageManifest.assetCid,
        " media asset manifest: image frame cid")

    var mismatchedKind = imageReq
    mismatchedKind.kindCode = media.MediaAssetKindAudio
    let mismatchedKindRes = media.MediaAssetBuildManifest(mismatchedKind)
    assert(IsErr(mismatchedKindRes), " media asset manifest: kind mime mismatch rejected")

fn assertAudioManifestLifecycle() =
    let audioBytes = makeTinyWavBytes()
    var audioMissingSeek: media.MediaAssetBuildRequest
    audioMissingSeek.blob = audioBytes
    audioMissingSeek.ownerPeerId = "peer-alpha"
    audioMissingSeek.remotePeersCsv = "peer-bravo"
    audioMissingSeek.mime = "audio/wav"
    audioMissingSeek.kindCode = media.MediaAssetKindAudio
    audioMissingSeek.durationMs = int64(120000)
    audioMissingSeek.codec = "pcm_s16le"
    audioMissingSeek.posterCid = media.MediaAssetSha256Hex(rawbytes.BytesFromString("album-cover"))
    audioMissingSeek.initSegmentCid = media.MediaAssetSha256Hex(rawbytes.BytesSlice(audioBytes, 0, 44))
    audioMissingSeek.initSegmentByteLength = 44
    audioMissingSeek.contentSignature = "audio-signature-provided-by-caller"
    audioMissingSeek.objectTargetBytes = 64
    audioMissingSeek.sourceBlockBytes = 8
    audioMissingSeek.repairDropletCount = 2
    let audioMissingSeekRes = media.MediaAssetBuildManifest(audioMissingSeek)
    assert(IsErr(audioMissingSeekRes), " media asset manifest: audio seek index hard fail")

    var audioReq = audioMissingSeek
    audioReq.keyframeIndex = "audio:wav:pcm:0"
    let audioManifestRes = media.MediaAssetBuildManifest(audioReq)
    assert(IsOk(audioManifestRes), " media asset manifest: audio build")
    let audioManifest = Value(audioManifestRes)
    assert(audioManifest.kindCode == media.MediaAssetKindAudio, " media asset manifest: audio kind")
    assert(audioManifest.durationMs == int64(120000), " media asset manifest: audio duration")
    let audioProbeRes = media.MediaProbeWavAudioBytes(audioBytes)
    assert(IsOk(audioProbeRes), " media asset manifest: wav probe")
    assert(Value(audioProbeRes).sampleRateHz == 44100, " media asset manifest: wav sample rate")
    assert(Value(audioProbeRes).pcmDataBytes == 8, " media asset manifest: wav pcm bytes")

fn main(): int32 =
    let posterBytes = rawbytes.BytesFromString("poster-first-frame")
    let initBytes = rawbytes.BytesFromString("init-segment-keyframe-zero")
    let posterCid = media.MediaAssetSha256Hex(posterBytes)
    let initCid = media.MediaAssetSha256Hex(initBytes)

    var missingSig: media.MediaAssetBuildRequest
    missingSig.blob = rawbytes.BytesFromString("media-blob-missing-signature")
    missingSig.ownerPeerId = "peer-alpha"
    missingSig.remotePeersCsv = "peer-bravo"
    missingSig.mime = "video/mp4"
    missingSig.codec = "h264/aac"
    missingSig.posterCid = posterCid
    missingSig.initSegmentCid = initCid
    missingSig.initSegmentByteLength = rawbytes.BytesLen(initBytes)
    missingSig.keyframeIndex = "0:0"
    let missingSigRes = media.MediaAssetBuildManifest(missingSig)
    assert(IsErr(missingSigRes), " media asset manifest: missing signature hard fail")

    var req: media.MediaAssetBuildRequest
    req.blob = rawbytes.BytesFromString("init-segment-keyframe-zero|sample-video-body")
    req.ownerPeerId = "peer-alpha"
    req.remotePeersCsv = "peer-bravo,peer-charlie"
    req.mime = "video/mp4"
    req.kindCode = media.MediaAssetKindVideo
    req.durationMs = int64(33000)
    req.codec = "h264/aac"
    req.posterCid = posterCid
    req.initSegmentCid = initCid
    req.initSegmentByteLength = rawbytes.BytesLen(initBytes)
    req.keyframeIndex = "0:0"
    req.contentSignature = "test-signature-provided-by-caller"
    req.objectTargetBytes = 32
    req.sourceBlockBytes = 8
    req.repairDropletCount = 2

    var tooSmallTarget = req
    tooSmallTarget.objectTargetBytes = 16
    let tooSmallTargetRes = media.MediaAssetBuildManifest(tooSmallTarget)
    assert(IsErr(tooSmallTargetRes), " media asset manifest: init segment target hard fail")

    let manifestRes = media.MediaAssetBuildManifest(req)
    assert(IsOk(manifestRes), " media asset manifest: build")
    let manifest = Value(manifestRes)
    assert(manifest.transport == media.MediaAssetTransportMoq, " media asset manifest: transport")
    assert(manifest.fecScheme == media.MediaAssetFecLtXorV1Experimental, " media asset manifest: fec experimental")
    assert(manifest.objects.len > 0, " media asset manifest: objects")
    assert(manifest.droplets.len > manifest.objects.len, " media asset manifest: repair droplets")
    assert(manifest.posterCid == posterCid, " media asset manifest: poster cid")
    assert(manifest.initSegmentCid == initCid, " media asset manifest: init cid")
    assert(manifest.initSegmentByteLength == rawbytes.BytesLen(initBytes),
        " media asset manifest: init segment length")
    assert(manifest.objects[0].byteOffset == 0, " media asset manifest: init object offset")
    assert(manifest.objects[0].byteLength >= manifest.initSegmentByteLength,
        " media asset manifest: init object covers segment")

    let wireRes = media.MediaAssetManifestWire(manifest)
    assert(IsOk(wireRes), " media asset manifest: wire")
    let wire = Value(wireRes)
    assert(strutil.Contains(wire, "magic=unimaker.media.asset.manifest.v1"),
        " media asset manifest: wire magic")
    assert(strutil.Contains(wire, "fec_scheme=lt_xor_v1:experimental"),
        " media asset manifest: wire fec")
    assert(strutil.Contains(wire, "init_segment_byte_length=26"),
        " media asset manifest: wire init segment length")
    assert(strutil.Contains(wire, "content_signature=test-signature-provided-by-caller"),
        " media asset manifest: wire signature")

    let cid1Res = media.MediaAssetManifestCid(manifest)
    let cid2Res = media.MediaAssetManifestCid(manifest)
    assert(IsOk(cid1Res), " media asset manifest: cid1")
    assert(IsOk(cid2Res), " media asset manifest: cid2")
    assert(Value(cid1Res) == Value(cid2Res), " media asset manifest: cid deterministic")

    let openRes = media.MediaAssetOpenReceiptFromManifest(manifest)
    assert(IsOk(openRes), " media asset manifest: open receipt")
    let openReceipt = Value(openRes)
    assert(openReceipt.assetCid == manifest.assetCid, " media asset manifest: receipt asset")
    assert(openReceipt.statusCode == media.MediaAssetOpenStatusManifestAnnounced,
        " media asset manifest: receipt status")
    assert(openReceipt.announcedBytes == len(wire), " media asset manifest: announced bytes")

    let firstRes = media.MediaAssetFirstFrameReceipt(manifest,
                                                     posterBytes,
                                                     media.MediaAssetFirstFrameSourcePoster)
    assert(IsOk(firstRes), " media asset manifest: first frame")
    let firstReceipt = Value(firstRes)
    assert(firstReceipt.verified, " media asset manifest: first frame verified")
    assert(firstReceipt.firstFrameCid == posterCid, " media asset manifest: first frame cid")

    let badFirstRes = media.MediaAssetFirstFrameReceipt(manifest,
                                                        rawbytes.BytesFromString("wrong-frame"),
                                                        media.MediaAssetFirstFrameSourcePoster)
    assert(IsErr(badFirstRes), " media asset manifest: bad first frame rejected")

    var badFec = manifest
    badFec.fecScheme = "raptorq:rfc6330:not-implemented"
    let badFecRes = media.MediaAssetManifestValidate(badFec)
    assert(IsErr(badFecRes), " media asset manifest: unsupported fec rejected")

    assertImageManifestLifecycle()
    assertAudioManifestLifecycle()

    assert(media.MediaAssetControlActionAllowed("Play"), " media asset manifest: play action")
    assert(media.MediaAssetControlActionAllowed("OpenAsset"), " media asset manifest: open action")
    assert(!media.MediaAssetControlActionAllowed("MutateDom"), " media asset manifest: mutating action rejected")

    echo(" media_asset_manifest_smoke ok")
    return 0
