fn regallocGatePerfCallee(value: int32): int32 =
    return (value & 31) + 1

# Four loop-carried values remain live across a call on every iteration. The
# workload is long enough to stay above process-start timing noise while its
# checksum remains within int32 range.
fn regallocGatePerfHot(iterations: int32): int32 =
    var a = int32(1)
    var b = int32(2)
    var c = int32(3)
    var d = int32(4)
    for i in 0..<iterations:
        let bump = regallocGatePerfCallee(i)
        a = a + (i & 7)
        b = b + bump
        c = c + (i & 3)
        d = d + (i & 1)
    return a + b + c + d
