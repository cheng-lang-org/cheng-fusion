import std/system
import std/os
import std/strutils as strutil
import std/rawbytes
import std/result
import cheng/quic/tls/common
import cheng/apps/vpn_proxy/transport_tcp_tls_record as rec

@importc("cheng_monotime_ns")
fn recordAeadBenchMonoNs(): int64

fn recordAeadBenchEnvInt(name: str, defaultValue: int32): int32 =
    let raw: str = os.GetEnvDefault(name, "")
    if len(raw) <= 0:
        return defaultValue
    let parsed: int32 = int32(strutil.ParseInt(raw))
    if parsed <= 0:
        return defaultValue
    return parsed

fn recordAeadBenchFill(buf: Bytes, mul: int32, addv: int32) =
    for i in 0..<BytesLen(buf):
        BytesSet(buf, i, (i * mul + addv) % 256)

fn recordAeadBenchRun(label: str,
                      cipher: common.MsQuicCipherSuite,
                      keyLen: int32,
                      iters: int32,
                      pktLen: int32): int32 =
    var key: Bytes = BytesAlloc(keyLen)
    var iv: Bytes = BytesAlloc(12)
    var payload: Bytes = BytesAlloc(pktLen)
    recordAeadBenchFill(key, 7, 1)
    recordAeadBenchFill(iv, 5, 3)
    recordAeadBenchFill(payload, 11, 9)
    var keys: rec.VpnProxyTcpTlsRecordKeys
    let initRes: Result[bool] = rec.VpnProxyTcpTlsRecordInitKeysForCipherInto(cipher, key, iv, keys)
    if IsErr(initRes):
        echo(strutil.Join([label, "_init_error=", ErrorText(initRes)], ""))
        BytesFree(payload)
        return 1
    var sink: int32
    let startNs: int64 = recordAeadBenchMonoNs()
    for it in 0..<iters:
        BytesSet(payload, it % pktLen, it % 256)
        var wire: Bytes
        let encRes: Result[bool] = rec.VpnProxyTcpTlsRecordEncryptInto(keys,
                                                                       rec.VpnProxyTcpTlsRecordContentTypeApplicationData(),
                                                                       payload,
                                                                       wire)
        if IsErr(encRes):
            echo(strutil.Join([label, "_encrypt_error=", ErrorText(encRes)], ""))
            rec.VpnProxyTcpTlsRecordKeysFree(keys)
            BytesFree(payload)
            return 2
        sink = sink + BytesGet(wire, BytesLen(wire) - 1)
        BytesFree(wire)
    let elapsedNs: int64 = recordAeadBenchMonoNs() - startNs
    let nsPerPkt: int64 = elapsedNs / int64(iters)
    let totalBytes: int64 = int64(iters) * int64(pktLen)
    var mbPerSec: int64
    if elapsedNs > 0:
        mbPerSec = totalBytes * int64(1000) / elapsedNs
    echo(strutil.Join([label,
                       "_record_seal pkt_len=", IntToStr(pktLen),
                       " iters=", IntToStr(iters),
                       " ns_per_pkt=", int64ToStr(nsPerPkt),
                       " MB_per_s=", int64ToStr(mbPerSec),
                       " sink=", IntToStr(sink)], ""))
    rec.VpnProxyTcpTlsRecordKeysFree(keys)
    BytesFree(payload)
    return 0

fn main(): int32 =
    let iters: int32 = recordAeadBenchEnvInt("CHENG_RECORD_AEAD_BENCH_ITERS", 200)
    let pktLen: int32 = recordAeadBenchEnvInt("CHENG_RECORD_AEAD_BENCH_PKTLEN", 15360)
    let aesRc: int32 = recordAeadBenchRun("aes128gcm",
                                          common.MsQuicCipherAes128Gcm,
                                          16,
                                          iters,
                                          pktLen)
    if aesRc != 0:
        return aesRc
    let chachaRc: int32 = recordAeadBenchRun("chacha20poly1305",
                                             common.MsQuicCipherChacha20Poly1305,
                                             32,
                                             iters,
                                             pktLen)
    if chachaRc != 0:
        return chachaRc
    echo(" vpn_proxy_tcp_tls_record_aead_bench ok")
    return 0
