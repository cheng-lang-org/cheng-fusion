fn exactFillRows(rows: var int32[], value: int32) =
    add(rows, value)

fn exactRevalidateRows(rows: var int32[]) =
    add(rows, 7)

fn exactVarOutCfg(flag: bool): int32 =
    var rows: int32[]
    if flag:
        exactFillRows(rows, 1)
    else:
        exactFillRows(rows, 2)
    exactRevalidateRows(rows)
    return rows.len

fn makePath(value: int32): str =
    return Fmt"path-{value}"

fn chooseReference(primaryReady: bool, retry: bool): int32 =
    var selected: str
    if primaryReady:
        let primaryReference = makePath(1)
        selected = primaryReference
    else:
        let bootstrapReference = makePath(2)
        if len(bootstrapReference) > 0:
            selected = bootstrapReference
    if retry:
        let fallbackReference = makePath(3)
        if len(fallbackReference) > 0:
            selected = fallbackReference
    return len(selected)

fn main(): int32 =
    if exactVarOutCfg(true) != 2:
        return 1
    if exactVarOutCfg(false) != 2:
        return 2
    if chooseReference(true, true) <= 0:
        return 3
    if chooseReference(false, true) <= 0:
        return 4
    return 0
