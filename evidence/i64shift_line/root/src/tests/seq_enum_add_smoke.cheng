import std/result
import std/seqs
import cheng/core/lang/typed_expr as texpr
import cheng/tests/seq_enum_add_cross_source_support as cross

type KindAlias = texpr.TypedExprIrStatementKind
type KindAliasChain = KindAlias

type LocalKind = enum
    LocalReady
    LocalDone

type ComplexValue =
    code: int32
    label: str

fn AddKindParam(kinds: var texpr.TypedExprIrStatementKind[],
                kind: texpr.TypedExprIrStatementKind) =
    add(kinds, kind)

fn NextKind(): texpr.TypedExprIrStatementKind =
    return texpr.TypedExprIrStmtIf

fn NextKindResult(): Result[texpr.TypedExprIrStatementKind] =
    return Ok[texpr.TypedExprIrStatementKind](texpr.TypedExprIrStmtCall)

fn AddIntParam(values: var int32[], value: int32) =
    add(values, value)

fn NextInt(): int32 =
    return 13

fn main(): int32 =
    var kinds: texpr.TypedExprIrStatementKind[]
    add(kinds, texpr.TypedExprIrStmtReturn)
    let localKind: texpr.TypedExprIrStatementKind = texpr.TypedExprIrStmtLetCall
    add(kinds, localKind)
    AddKindParam(kinds, texpr.TypedExprIrStmtCall)
    add(kinds, NextKind())
    let chooseReturn = true
    add(kinds, chooseReturn ? texpr.TypedExprIrStmtReturn : texpr.TypedExprIrStmtIf)
    let kindResult = NextKindResult()
    seqs.Add(kinds, Value(kindResult))
    if kinds.len != 6:
        return 1
    if kinds[0] != texpr.TypedExprIrStmtReturn:
        return 2
    if kinds[1] != texpr.TypedExprIrStmtLetCall:
        return 3
    if kinds[2] != texpr.TypedExprIrStmtCall:
        return 4
    if kinds[3] != texpr.TypedExprIrStmtIf:
        return 5
    if kinds[4] != texpr.TypedExprIrStmtReturn:
        return 6
    if kinds[5] != texpr.TypedExprIrStmtCall:
        return 6
    var aliasKinds: KindAliasChain[]
    add(aliasKinds, texpr.TypedExprIrStmtCall)
    if aliasKinds.len != 1 || aliasKinds[0] != texpr.TypedExprIrStmtCall:
        return 6
    var localKinds: LocalKind[]
    let localCustomKind: LocalKind = LocalDone
    add(localKinds, localCustomKind)
    if localKinds.len != 1 || localKinds[0] != LocalDone:
        return 8
    var crossHolder: cross.CrossSourceHolder
    let crossKind: cross.CrossSourceKind = cross.CrossSourceDone
    add(crossHolder.kinds, crossKind)
    if crossHolder.kinds.len != 1 || crossHolder.kinds[0] != cross.CrossSourceDone:
        return 9
    var labels: str[]
    add(labels, "alpha")
    let localLabel = "beta"
    add(labels, localLabel)
    if labels.len != 2 || labels[0] != "alpha" || labels[1] != "beta":
        return 10
    var complexValues: ComplexValue[]
    let complexValue = ComplexValue(code: 23, label: "ready")
    add(complexValues, complexValue)
    if complexValues.len != 1 || complexValues[0].code != 23 ||
       complexValues[0].label != "ready":
        return 11
    var ints: int32[]
    add(ints, 11)
    let localInt: int32 = 12
    add(ints, localInt)
    add(ints, NextInt())
    AddIntParam(ints, 14)
    let chooseInt = true
    add(ints, chooseInt ? 15 : 16)
    if ints.len != 5 || ints[0] != 11 || ints[1] != 12 ||
       ints[2] != 13 || ints[3] != 14 || ints[4] != 15:
        return 6
    return 7
