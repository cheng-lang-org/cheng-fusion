import std/cmdline
import std/os
import std/rawbytes
import std/strutils as strutil
import cheng/std/bytes_layout as layout
import cheng/core/lang/parser
import cheng/core/tooling/path as chengpath
import cheng/core/tooling/compiler_world as cworld
import cheng/core/backend/system_link_exec as sexec

fn LocatorRoot(): str =
    var root = cmdline.ReadFlagOrDefault("--root", "")
    if root == "":
        root = strutil.Join([
            os.GetCurrentDir(),
            "/artifacts/compiler_managed_mirror_locator_snapshot-",
            IntToStr(os.ProcessId())
        ], "")
    os.MkdirAll(root, 493)
    return root

fn LocatorWire(sourceText: str): cworld.CompilerManagedMirrorBundleWire =
    let legacyText = strutil.Join([sourceText, "# legacy\n"], "")
    var unit: cworld.CompilerManagedMirrorBundleWireUnit
    unit.modulePath = "dep/pkg/main"
    unit.legacySourceRawByteLength = legacyText.len
    unit.legacySourceCid = cworld.CompilerWorldSourceRawBytesCid(legacyText)
    unit.legacySourceText = legacyText
    unit.migratedSourceRawByteLength = sourceText.len
    unit.migratedSourceCid = cworld.CompilerWorldSourceRawBytesCid(sourceText)
    unit.migratedSourceText = sourceText
    var wire: cworld.CompilerManagedMirrorBundleWire
    wire.channel = "stable"
    wire.packageId = "dep/pkg"
    wire.migrationProofCid = cworld.CompilerWorldHashText(
        "managed_mirror_locator_proof",
        ["fixture"])
    wire.legacySourceIdentityReceiptCid = cworld.CompilerWorldHashText(
        "managed_mirror_locator_legacy_receipt",
        ["fixture"])
    wire.migratedSourceIdentityReceiptCid = cworld.CompilerWorldHashText(
        "managed_mirror_locator_migrated_receipt",
        ["fixture"])
    wire.compileSemanticReceiptCid = cworld.CompilerWorldHashText(
        "managed_mirror_locator_semantic_receipt",
        ["fixture"])
    wire.unitCount = 1
    wire.units = [unit]
    wire.baselineCsgText = "baseline-csg"
    wire.migratedCsgText = "migrated-csg"
    wire.baselineSurfaceText = "baseline-surface"
    wire.migratedSurfaceText = "migrated-surface"
    wire.baselineSemanticReceiptText = "baseline-semantic"
    wire.migratedSemanticReceiptText = "migrated-semantic"
    wire.evidenceText = "evidence"
    wire.proofText = "proof"
    wire.bundleCid = cworld.CompilerManagedMirrorBundleWireCid(wire)
    assert(IsOk(cworld.CompilerManagedMirrorBundleWireVerify(wire)),
           "managed mirror locator snapshot: wire invalid")
    return wire

fn LocatorWrite(handle: os.AtomicTree,
                path: str,
                text: str) =
    var bytes = rawbytes.BytesFromString(text)
    assert(IsOk(os.AtomicTreeWriteExclusiveSync(handle, path, bytes)),
           strutil.Join(["managed mirror locator snapshot: write ", path], ""))

fn LocatorInstall(rootDir: str,
                  label: str,
                  wire: cworld.CompilerManagedMirrorBundleWire,
                  physicalSourceText: str): str =
    let finalRoot = cworld.CompilerManagedMirrorRoot(
        rootDir,
        wire.channel,
        wire.packageId,
        wire.bundleCid)
    let finalName = layout.FixedBytes32Hex(wire.bundleCid)
    let canonicalParent = chengpath.PathParentDir(finalRoot)
    assert(canonicalParent != "",
           "managed mirror locator snapshot: parent identity missing")
    os.MkdirAll(canonicalParent, 493)
    let beginRes = os.AtomicTreeBegin(
        canonicalParent,
        strutil.Join([".staging-", label, "-", IntToStr(os.ProcessId())], ""),
        finalName)
    assert(IsOk(beginRes), Error(beginRes))
    let handle = Value(beginRes)
    assert(IsOk(os.AtomicTreeMkdir(handle, "src")) &&
           IsOk(os.AtomicTreeMkdir(handle, ".cheng-mirror")),
           "managed mirror locator snapshot: mkdir")
    let bundleText = cworld.CompilerManagedMirrorBundleWireReport(wire)
    LocatorWrite(handle, "bundle.txt", bundleText)
    LocatorWrite(handle, "src/main.cheng", physicalSourceText)
    var bundleFile: cworld.CompilerManagedMirrorCommitFile
    bundleFile.relativePath = "bundle.txt"
    bundleFile.rawByteLength = bundleText.len
    bundleFile.contentCid = cworld.CompilerWorldSourceRawBytesCid(bundleText)
    var sourceFile: cworld.CompilerManagedMirrorCommitFile
    sourceFile.relativePath = "src/main.cheng"
    sourceFile.rawByteLength = physicalSourceText.len
    sourceFile.contentCid = cworld.CompilerWorldSourceRawBytesCid(
        physicalSourceText)
    var commit: cworld.CompilerManagedMirrorCommit
    commit.bundleCid = wire.bundleCid
    commit.fileCount = 2
    commit.files = [bundleFile, sourceFile]
    LocatorWrite(handle,
                 ".cheng-mirror/commit.txt",
                 cworld.CompilerManagedMirrorCommitReport(commit))
    let commitRes = os.AtomicTreeCommitNoReplace(handle)
    assert(IsOk(commitRes) && Value(commitRes) == os.AtomicTreeCommitted,
           "managed mirror locator snapshot: atomic commit")
    assert(IsOk(os.AtomicTreeClose(handle)),
           "managed mirror locator snapshot: install close")
    return finalRoot

fn LocatorLock(
        wire: cworld.CompilerManagedMirrorBundleWire): cworld.CompilerLockSnapshot =
    var entry: cworld.CompilerUniverseManifestEntry
    entry.packageId = wire.packageId
    entry.snapshotCid = cworld.CompilerWorldHashText(
        "managed_mirror_locator_snapshot",
        [wire.packageId])
    entry.syntaxSurfaceCid = cworld.CompilerWorldHashText(
        "managed_mirror_locator_syntax",
        [wire.packageId])
    entry.migrationProofCid = wire.migrationProofCid
    entry.managedMirrorBundleCid = wire.bundleCid
    var lock: cworld.CompilerLockSnapshot
    lock.channel = wire.channel
    lock.worldHeadCid = cworld.CompilerWorldHashText("world", [wire.channel])
    lock.manifestRootCid = cworld.CompilerWorldHashText("manifest", [wire.channel])
    lock.compilerPkgCid = cworld.CompilerWorldHashText("compiler", [wire.channel])
    lock.stdPkgCid = cworld.CompilerWorldHashText("std", [wire.channel])
    lock.runtimePkgCid = cworld.CompilerWorldHashText("runtime", [wire.channel])
    lock.managedDependencyReceiptCid = cworld.CompilerWorldHashText(
        "managed_deps",
        [wire.channel])
    lock.entryCount = 1
    lock.entries = [entry]
    return lock

fn main(argc: int32, argv: str*): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    let root = LocatorRoot()
    let sourceText = "fn main(): int32 =\n    return 0\n"
    let wire = LocatorWire(sourceText)
    let validRootDir = strutil.Join([root, "/valid"], "")
    let finalRoot = LocatorInstall(validRootDir,
                                   "valid",
                                   wire,
                                   sourceText)
    let lock = LocatorLock(wire)
    var roots: parser.ParserExternalPackageRoot[]
    var handles: os.AtomicTree[]
    var err: str
    assert(sexec.SystemLinkExecExternalPackageRootsInto(
               validRootDir,
               lock,
               roots,
               handles,
               err),
           strutil.Join([
               "managed mirror locator snapshot: valid rejected: ",
               err
           ], ""))
    assert(roots.len == 1 && roots[0].verifiedSnapshotRequired &&
           roots[0].verifiedSourcePaths.len == 1 &&
           roots[0].verifiedSourceTexts[0] == sourceText &&
           roots[0].packageRoot == finalRoot,
           "managed mirror locator snapshot: snapshot mismatch")
    assert(sexec.SystemLinkExecManagedMirrorHandlesCloseInto(handles, err),
           "managed mirror locator snapshot: valid close")
    echo("managed_mirror_locator_snapshot_valid=1")

    let rewriteRootDir = strutil.Join([root, "/rewrite"], "")
    let rewriteFinalRoot = LocatorInstall(rewriteRootDir,
                                          "rewrite",
                                          wire,
                                          sourceText)
    roots = []
    handles = []
    err = ""
    assert(sexec.SystemLinkExecExternalPackageRootsInto(
               rewriteRootDir,
               lock,
               roots,
               handles,
               err),
           "managed mirror locator snapshot: rewrite setup")
    let rewriteSourcePath = strutil.Join([
        rewriteFinalRoot,
        "/src/main.cheng"
    ], "")
    os.WriteFile(rewriteSourcePath,
                 "fn main(): int32 =\n    return 8\n")
    var snapshotText: str
    assert(parser.ParserSourceTextWithExternalPackageRootsInto(
               rewriteSourcePath,
               roots,
               snapshotText,
               err) &&
           snapshotText == sourceText,
           "managed mirror locator snapshot: rewrite reopened physical source")
    assert(!sexec.SystemLinkExecManagedMirrorHandlesCloseInto(handles, err),
           "managed mirror locator snapshot: same-inode rewrite close accepted")
    echo("managed_mirror_locator_same_inode_rejected=1")

    let swapRootDir = strutil.Join([root, "/swap"], "")
    let swapFinalRoot = LocatorInstall(swapRootDir,
                                       "swap",
                                       wire,
                                       sourceText)
    roots = []
    handles = []
    err = ""
    assert(sexec.SystemLinkExecExternalPackageRootsInto(
               swapRootDir,
               lock,
               roots,
               handles,
               err),
           "managed mirror locator snapshot: swap setup")
    let attackerSourceText = "fn main(): int32 =\n    return 7\n"
    let attackerWire = LocatorWire(attackerSourceText)
    let attackerFinalRoot = LocatorInstall(swapRootDir,
                                           "swap-attacker",
                                           attackerWire,
                                           attackerSourceText)
    let heldRoot = strutil.Join([swapFinalRoot, ".held"], "")
    assert(os.RenamePath(swapFinalRoot, heldRoot) &&
           os.RenamePath(attackerFinalRoot, swapFinalRoot),
           "managed mirror locator snapshot: root swap failed")
    let swapSourcePath = strutil.Join([
        swapFinalRoot,
        "/src/main.cheng"
    ], "")
    snapshotText = ""
    err = ""
    assert(parser.ParserSourceTextWithExternalPackageRootsInto(
               swapSourcePath,
               roots,
               snapshotText,
               err) &&
           snapshotText == sourceText,
           "managed mirror locator snapshot: root swap reopened physical source")
    assert(!sexec.SystemLinkExecManagedMirrorHandlesCloseInto(handles, err),
           "managed mirror locator snapshot: root swap close accepted")
    echo("managed_mirror_locator_root_swap_rejected=1")

    let attackRootDir = strutil.Join([root, "/attack"], "")
    LocatorInstall(attackRootDir,
                   "attack",
                   wire,
                   "fn main(): int32 =\n    return 9\n")
    roots = []
    handles = []
    err = ""
    assert(!sexec.SystemLinkExecExternalPackageRootsInto(
                attackRootDir,
                lock,
                roots,
                handles,
                err),
           "managed mirror locator snapshot: coordinated source/commit attack accepted")
    assert(handles.len == 0,
           "managed mirror locator snapshot: rejected handle leaked")
    echo("managed_mirror_locator_manifest_attack_rejected=1")
    return 0
