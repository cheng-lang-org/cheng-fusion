type
    ColdExactBorrowedSource =
        sourcePathRaw: str

    ColdExactBorrowedPaths =
        entryPath: str
        sourcePath: str

fn ColdExactBorrowedFieldStoreReuse(
        fields: var ColdExactBorrowedSource): int32 =
    var requestSourcePath = fields.sourcePathRaw
    var ordered: str[]
    add(ordered, requestSourcePath)
    if ordered.len != 1 ||
       ordered[0] != requestSourcePath:
        return 10
    var parsed: ColdExactBorrowedPaths
    parsed.entryPath = requestSourcePath
    parsed.sourcePath = requestSourcePath
    if requestSourcePath != "source-a":
        return 11
    if parsed.entryPath != requestSourcePath:
        return 12
    if parsed.sourcePath != requestSourcePath:
        return 13
    fields.sourcePathRaw = "source-b"
    if parsed.entryPath != "source-a" ||
       parsed.sourcePath != "source-a":
        return 14
    return 0

fn main(): int32 =
    var fields: ColdExactBorrowedSource
    fields.sourcePathRaw = "source-a"
    return ColdExactBorrowedFieldStoreReuse(fields)
