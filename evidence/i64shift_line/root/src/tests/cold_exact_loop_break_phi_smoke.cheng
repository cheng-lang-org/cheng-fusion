import std/strutils as strutil
import std/system as system

fn LoopBreakValueLength(stopAtOne: bool): int32 =
    var current: str = "seed"
    var step: int32 = 0
    while step < 3:
        current = strutil.Join([current, "x"], "")
        if stopAtOne && step == 1:
            break
        step = step + 1
    return current.len

fn ConsumeLoopValue(value: str): int32 =
    return value.len

fn LoopPathConsumeOrReplace(stopAtOne: bool): int32 =
    var current: str = "seed"
    var consumed: str[]
    var step: int32 = 0
    while step < 3:
        if stopAtOne && step == 1:
            add(consumed, current)
            return consumed.len
        current = strutil.Join([current, "x"], "")
        step = step + 1
    return current.len

fn LoopBreakAssignedValue(run: bool): int32 =
    var current: str = ""
    let stop = run ? 1 : 0
    for step in 0..<stop:
        current = "picked"
        break
    if current == "":
        return 0
    return current.len

fn BorrowedLoopRebindLength(initial: var str, steps: int32): int32 =
    var current = initial
    var step = 0
    while step < steps:
        current = strutil.Join([current, "x"], "")
        step = step + 1
    return current.len

fn BorrowedNestedLoopRebindLength(initial: var str, outerSteps: int32): int32 =
    var current = initial
    var outer = 0
    while outer < outerSteps:
        var inner = 0
        while inner < 1:
            current = strutil.Join([current, "x"], "")
            inner = inner + 1
        outer = outer + 1
    return current.len

fn BorrowedDeadRebindLength(initial: var str, steps: int32): int32 =
    var current = initial
    var step = 0
    while step < steps:
        if step < 0:
            continue
            current = strutil.Join([current, "dead"], "")
        current = strutil.Join([current, "x"], "")
        step = step + 1
    return current.len

fn BorrowedThreeWayRebindLength(
    initial: var str,
    steps: int32,
    mode: int32
): int32 =
    var current = initial
    var step = 0
    while step < steps:
        if mode == 0:
            current = strutil.Join([current, "a"], "")
        elif mode == 1:
            current = strutil.Join([current, "bb"], "")
        else:
            current = strutil.Join([current, "ccc"], "")
        step = step + 1
    return current.len

fn BorrowMergeThenOwn(
    initial: var str,
    alternate: var str,
    takeAlternate: bool,
    steps: int32
): int32 =
    var current = initial
    var step = 0
    while step < steps:
        if takeAlternate:
            current = alternate
        current = strutil.Join([current, "x"], "")
        step = step + 1
    return current.len

fn BorrowedNestedMergeThenOwn(
    initial: var str,
    alternate: var str,
    takeAlternate: bool,
    outerSteps: int32
): int32 =
    var current = initial
    var outer = 0
    while outer < outerSteps:
        var inner = 0
        while inner < 1:
            if takeAlternate:
                current = alternate
            current = strutil.Join([current, "x"], "")
            inner = inner + 1
        outer = outer + 1
    return current.len

fn NestedConditionalOwnerClose(
    outerSteps: int32,
    innerSteps: int32,
    choose: bool
): int32 =
    var unresolved = ""
    var outer = 0
    while outer < outerSteps:
        var inner = 0
        while inner < innerSteps:
            if choose && outer == 0 && inner == 0:
                unresolved = strutil.Join(["symbol", "x"], "")
            inner = inner + 1
        outer = outer + 1
    return unresolved.len

fn main(): int32 =
    if LoopBreakValueLength(true) != 6:
        return 1
    if LoopBreakValueLength(false) != 7:
        return 2
    if LoopPathConsumeOrReplace(true) != 1:
        return 3
    if LoopPathConsumeOrReplace(false) != 7:
        return 4
    if LoopBreakAssignedValue(false) != 0:
        return 5
    if LoopBreakAssignedValue(true) != 6:
        return 6
    var borrowedInitial = "seed"
    if BorrowedLoopRebindLength(borrowedInitial, 0) != 4:
        return 7
    if BorrowedLoopRebindLength(borrowedInitial, 1) != 5:
        return 8
    if BorrowedLoopRebindLength(borrowedInitial, 2) != 6:
        return 9
    var borrowedAlternate = "branch"
    let allocBefore = system.memAllocCount()
    let freeBefore = system.memFreeCount()
    let liveBefore = system.memLiveCount()
    let retainBefore = system.memRetainCount()
    let releaseBefore = system.memReleaseCount()
    if BorrowedNestedLoopRebindLength(borrowedInitial, 0) != 4:
        return 10
    if BorrowedNestedLoopRebindLength(borrowedInitial, 1) != 5:
        return 11
    if BorrowedNestedLoopRebindLength(borrowedInitial, 2) != 6:
        return 12
    if BorrowedDeadRebindLength(borrowedInitial, 0) != 4:
        return 13
    if BorrowedDeadRebindLength(borrowedInitial, 1) != 5:
        return 14
    if BorrowedDeadRebindLength(borrowedInitial, 2) != 6:
        return 15
    if BorrowedThreeWayRebindLength(borrowedInitial, 2, 0) != 6:
        return 16
    if BorrowedThreeWayRebindLength(borrowedInitial, 2, 1) != 8:
        return 17
    if BorrowedThreeWayRebindLength(borrowedInitial, 2, 2) != 10:
        return 18
    let mergeAllocBefore = system.memAllocCount()
    let mergeFreeBefore = system.memFreeCount()
    let mergeLiveBefore = system.memLiveCount()
    let mergeRetainBefore = system.memRetainCount()
    let mergeReleaseBefore = system.memReleaseCount()
    if BorrowMergeThenOwn(borrowedInitial, borrowedAlternate, false, 0) != 4:
        return 19
    if BorrowMergeThenOwn(borrowedInitial, borrowedAlternate, false, 1) != 5:
        return 20
    if BorrowMergeThenOwn(borrowedInitial, borrowedAlternate, false, 2) != 6:
        return 21
    if BorrowMergeThenOwn(borrowedInitial, borrowedAlternate, true, 0) != 4:
        return 22
    if BorrowMergeThenOwn(borrowedInitial, borrowedAlternate, true, 1) != 7:
        return 23
    if BorrowMergeThenOwn(borrowedInitial, borrowedAlternate, true, 2) != 7:
        return 24
    if system.memAllocCount() - mergeAllocBefore != int64(12):
        return 25
    if system.memFreeCount() - mergeFreeBefore != int64(12):
        return 26
    if system.memLiveCount() != mergeLiveBefore:
        return 27
    if system.memRetainCount() - mergeRetainBefore != int64(0):
        return 28
    if system.memReleaseCount() - mergeReleaseBefore != int64(12):
        return 29
    if BorrowedNestedMergeThenOwn(
            borrowedInitial, borrowedAlternate, false, 0) != 4:
        return 30
    if BorrowedNestedMergeThenOwn(
            borrowedInitial, borrowedAlternate, false, 1) != 5:
        return 31
    if BorrowedNestedMergeThenOwn(
            borrowedInitial, borrowedAlternate, false, 2) != 6:
        return 32
    if BorrowedNestedMergeThenOwn(
            borrowedInitial, borrowedAlternate, true, 0) != 4:
        return 33
    if BorrowedNestedMergeThenOwn(
            borrowedInitial, borrowedAlternate, true, 1) != 7:
        return 34
    if BorrowedNestedMergeThenOwn(
            borrowedInitial, borrowedAlternate, true, 2) != 7:
        return 35
    let allocDelta = system.memAllocCount() - allocBefore
    let freeDelta = system.memFreeCount() - freeBefore
    let retainDelta = system.memRetainCount() - retainBefore
    let releaseDelta = system.memReleaseCount() - releaseBefore
    if allocDelta <= int64(0):
        return 36
    if allocDelta != freeDelta:
        return 37
    if system.memLiveCount() != liveBefore:
        return 38
    if releaseDelta != retainDelta + freeDelta:
        return 39
    if NestedConditionalOwnerClose(0, 1, true) != 0:
        return 40
    if NestedConditionalOwnerClose(1, 0, true) != 0:
        return 41
    if NestedConditionalOwnerClose(1, 1, true) != 7:
        return 42
    if NestedConditionalOwnerClose(2, 2, false) != 0:
        return 43
    return 0
