import std/system
import std/rawbytes
import cheng/quic/multiaddress as qaddr
import cheng/quic/msquicruntime as qruntime
import cheng/quic/native_runtime as qnative

fn main(): int32 =
    var addr: qaddr.MultiAddress
    addr.raw = "/ip4/127.0.0.1/udp/6210/quic-v1"
    addr.data = BytesFromString(addr.raw)
    var settings: qruntime.MsQuicSettings
    qruntime.initMsQuicSettingsInto(settings)
    let certDer: Bytes = qnative.msquicNativeSeededBytes(17)
    let keyDer: Bytes = qnative.msquicNativeSeededBytes(29)
    let listenerId = qnative.msquicNativeStartListenerServerInputsCode(addr, settings, "localhost", certDer, keyDer)
    if listenerId == -1:
        panic("msquic tls policy: serverName missing")
    if listenerId == -2:
        panic("msquic tls policy: certificate missing")
    if listenerId == -3:
        panic("msquic tls policy: private key missing")
    if listenerId == -4:
        panic("msquic native: listener datapath add failed")
    if listenerId == -5:
        panic("msquic native: listener datapath start failed")
    if listenerId == -6:
        panic("msquic native: listener bind failed")
    assert(listenerId > 0, "msquic native: listener start failed")
    let _listenerId = listenerId
    var bound: qaddr.MultiAddress
    qnative.MsQuicNativeListenerBoundAddrInto(bound)
    assert(qaddr.quicMultiAddressKind(bound) == qaddr.quicAddrKindMsQuic, " quic native listener: bound kind")
    assert(qaddr.quicMultiAddressPort(bound) == 6210, " quic native listener: bound port")
    qnative.msquicNativeStopListener()

    echo(" quic_native_listener_smoke ok")
    return 0
