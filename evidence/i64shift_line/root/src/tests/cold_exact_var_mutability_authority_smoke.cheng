fn MutabilityAuthoritySetText(value: var str) =
    value = "changed"

fn MutabilityAuthoritySetCount(value: var int32) =
    value = 41

fn main(): int32 =
    var text = "before"
    var count: int32
    MutabilityAuthoritySetText(text)
    MutabilityAuthoritySetCount(count)
    if text != "changed":
        return 1
    if count != 41:
        return 2
    return 0
