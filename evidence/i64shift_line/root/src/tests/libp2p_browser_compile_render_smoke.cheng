import std/system
import std/strings
import cheng/core/runtime/web_runtime as web
import cheng/apps/libp2p_browser/compile_render as compile

fn fail(code: int32, msg: str): int32 =
    echo(msg)
    return code

fn main(): int32 =
    let src = "<html><head><style>body{display:block;width:400px}input{width:128px;height:30px}a{color:blue}</style></head><body><p>hi</p><input id=\"q\" name=\"q\" type=\"text\" value=\"x\"><a href=\"/go\">go</a></body></html>"
    var document: web.WebDocument
    var bundle: compile.BrowserCompileBundle
    if !compile.BrowserCompileHtml(src, "", 400, 600, document, bundle):
        echo(bundle.err)
        return fail(1, "compile")
    if bundle.stats.nodeCount <= 0:
        return fail(2, "nodes")
    if bundle.stats.parseMs < 0 || bundle.stats.layoutMs < 0 || bundle.stats.paintMs < 0:
        return fail(3, "timing")
    if bundle.stats.inputCount < 1:
        echo(strings.IntToStr(bundle.stats.nodeCount))
        echo(strings.IntToStr(bundle.stats.widgetCount))
        echo(strings.IntToStr(bundle.stats.opCount))
        echo(strings.IntToStr(bundle.stats.boxCount))
        echo(strings.IntToStr(bundle.stats.styleCount))
        if bundle.stats.cssParseOk:
            echo("cssok")
        else:
            echo("cssfail")
        var tagHits: int32 = 0
        var ni: int32 = 0
        while ni < web.WebDocumentNodeCount(document):
            let nodeId = web.WebDocumentNodeIdAt(document, ni)
            ni = ni + 1
            if web.WebDocumentNodeKind(document, nodeId) != web.WebNodeKindElement:
                continue
            var tag: str = ""
            if web.WebDocumentNodeTagName(document, nodeId, tag):
                if tag == "input":
                    tagHits = tagHits + 1
        echo(strings.IntToStr(tagHits))
        return fail(4, "input")
    if bundle.stats.widgetCount < 2:
        return fail(5, "widgets")
    if bundle.stats.opCount <= 0:
        return fail(6, "ops")
    var hasInput = false
    var hasAnchor = false
    var inputX: int32 = 0
    var inputY: int32 = 0
    var wi: int32 = 0
    while wi < bundle.widgets.len:
        if bundle.widgets[wi].kind == compile.BrowserWidgetInput && bundle.widgets[wi].fieldId == "q":
            hasInput = true
            inputX = bundle.widgets[wi].x + 2
            inputY = bundle.widgets[wi].y + 2
            if bundle.widgets[wi].value != "x":
                return fail(7, "input value")
        if bundle.widgets[wi].kind == compile.BrowserWidgetAnchor && bundle.widgets[wi].href == "/go":
            hasAnchor = true
        wi = wi + 1
    if !hasInput || !hasAnchor:
        return fail(8, "widget kinds")
    let hit = compile.BrowserHitWidget(bundle.widgets, inputX, inputY)
    if hit < 0:
        return fail(9, "hit")
    if bundle.widgets[hit].fieldId != "q":
        return fail(10, "hit field")
    let resolved = compile.BrowserResolveUrl("https://ex.test/dir/page", "/go")
    if resolved != "https://ex.test/go":
        echo(resolved)
        return fail(11, "resolve")
    echo("libp2p_browser_compile_render_smoke ok")
    return 0
