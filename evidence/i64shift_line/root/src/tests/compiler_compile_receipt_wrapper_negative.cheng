import std/os
import std/result
import cheng/core/tooling/compiler_csg

fn main(): int32 =
    var receipt: compiler_csg.CompileReceipt
    let decoded = compiler_csg.CompileReceiptFromReportText("", receipt)
    if !IsErr(decoded):
        os.WriteLine(
            os.Get_stderr(),
            "compiler csg compile receipt wrapper accepted empty bytes")
        return 1
    return 0
