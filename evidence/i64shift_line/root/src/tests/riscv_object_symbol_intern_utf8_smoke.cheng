import std/rawbytes
import std/result
import std/strings
import std/strformat
import cheng/core/lang/intern as langintern
import cheng/core/backend/object_buffer as obuf
import cheng/core/backend/object_symbols as osym
import cheng/core/backend/object_relocs as orel
import cheng/core/backend/elf_riscv64_writer as elf64
import cheng/core/backend/elf_riscv32_writer as elf32
import cheng/core/backend/riscv64_encode as rv

# Independent UTF-8 / ELF byte readers. They do not import encoder layouts
# for symbol names; ISA field recon below uses the unprivileged bit layout.

@borrows
fn specOpcode(word: uint32): uint32 =
    return word & uint32(127)

@borrows
fn specRd(word: uint32): int32 =
    return int32((word >> 7) & uint32(31))

@borrows
fn specFunct3(word: uint32): uint32 =
    return (word >> 12) & uint32(7)

@borrows
fn specRs1(word: uint32): int32 =
    return int32((word >> 15) & uint32(31))

@borrows
fn specIImm(word: uint32): int32 =
    let raw = int32((word >> 20) & uint32(4095))
    if (raw & 2048) != 0:
        return raw - 4096
    return raw

@borrows
fn u8At(buf: rawbytes.Bytes, off: int32): int32 =
    return rawbytes.BytesGet(buf, off) & 255

@borrows
fn utf8BytesExact(left: str, right: str): bool =
    if len(left) != len(right):
        return false
    var i: int32
    while i < len(left):
        if (int32(left[i]) & 255) != (int32(right[i]) & 255):
            return false
        i = i + 1
    return true

@borrows
fn objContainsUtf8(buf: rawbytes.Bytes, text: str): bool =
    let n = rawbytes.BytesLen(buf)
    let m = len(text)
    if m <= 0 || n < m:
        return false
    var i: int32
    while i + m <= n:
        var matched = true
        var j: int32
        while j < m:
            if u8At(buf, i + j) != (int32(text[j]) & 255):
                matched = false
                break
            j = j + 1
        if matched:
            return true
        i = i + 1
    return false

fn buildText(words: uint32[]): rawbytes.Bytes =
    var out = obuf.ObjectBufferInit(16)
    for i in 0..<words.len:
        obuf.ObjectBufferWriteU32LE(out, uint64(words[i]))
    return obuf.ObjectBufferTakeBytes(out)

fn main(): int32 =
    # Shipped Cheng encoder must be the ISA source; a cold-only C encoder
    # path cannot satisfy this import + field reconstruction.
    let addi = rv.rv64EncAddi(10, 11, 42)
    assert(specOpcode(addi) == uint32(19), "addi opcode")
    assert(specFunct3(addi) == uint32(0), "addi funct3")
    assert(specRd(addi) == 10, "addi rd")
    assert(specRs1(addi) == 11, "addi rs1")
    assert(specIImm(addi) == 42, "addi imm")
    echo(Fmt"recon addi opcode={specOpcode(addi)} funct3={specFunct3(addi)} rd={specRd(addi)} rs1={specRs1(addi)} imm={specIImm(addi)}")

    let ld32 = rv.RvEncLdForXlen(32, 10, 11, 0)
    assert(!ld32.ok, "ld must be rejected on XLEN=32")
    let addw32 = rv.RvEncAddwForXlen(32, 10, 11, 12)
    assert(!addw32.ok, "addw must be rejected on XLEN=32")
    let addiw32 = rv.RvEncAddiwForXlen(32, 10, 11, 1)
    assert(!addiw32.ok, "addiw must be rejected on XLEN=32")
    let faddd32 = rv.RvEncFaddDForXlen(32, 0, 1, 2)
    assert(!faddd32.ok, "fadd.d must be rejected on XLEN=32")
    let ld64 = rv.RvEncLdForXlen(64, 10, 11, 16)
    assert(ld64.ok, ld64.err.msg)

    var pool = langintern.InternPoolNew()
    defer:
        langintern.InternPoolRelease(pool)

    let asciiName = "helper_add"
    let utf8Name = "辅助"
    let internIdShapedName = "id42-payload"
    let asciiId = langintern.Intern(pool, asciiName)
    let utf8Id = langintern.Intern(pool, utf8Name)
    let payloadId = langintern.Intern(pool, internIdShapedName)
    let mainId = langintern.Intern(pool, "main")

    let asciiLookup = langintern.LookupInternOwnedCopy(pool, asciiId)
    assert(asciiLookup.ok, asciiLookup.err.msg)
    assert(utf8BytesExact(asciiLookup.value, asciiName), "intern-lookup ascii utf8")
    assert(asciiLookup.value != "main", "ascii intern-lookup must not be main")

    let utf8Lookup = langintern.LookupInternOwnedCopy(pool, utf8Id)
    assert(utf8Lookup.ok, utf8Lookup.err.msg)
    assert(utf8BytesExact(utf8Lookup.value, utf8Name), "intern-lookup utf8")
    assert(utf8Lookup.value != "main", "utf8 intern-lookup must not be main")

    let payloadLookup = langintern.LookupInternOwnedCopy(pool, payloadId)
    assert(payloadLookup.ok, payloadLookup.err.msg)
    assert(utf8BytesExact(payloadLookup.value, internIdShapedName),
           "intern-lookup intern-id-shaped name")
    assert(payloadLookup.value != "main", "intern-id-shaped must not be main")

    let mainLookup = langintern.LookupInternOwnedCopy(pool, mainId)
    assert(mainLookup.ok, mainLookup.err.msg)
    assert(utf8BytesExact(mainLookup.value, "main"), "intern-lookup of main is main")

    var words: uint32[]
    add(words, addi)
    var text = buildText(words)
    defer:
        rawbytes.BytesFree(text)

    var syms = osym.ObjectSymbolsInit()
    assert(osym.ObjectSymbolsAddDefined(syms, strings.CloneStr(asciiLookup.value), 0, int64(0), int64(4), true) >= 0,
           "ascii symbol")
    assert(osym.ObjectSymbolsAddDefined(syms, strings.CloneStr(utf8Lookup.value), 0, int64(0), int64(4), true) >= 0,
           "utf8 symbol")
    assert(osym.ObjectSymbolsAddDefined(syms, strings.CloneStr(payloadLookup.value), 0, int64(0), int64(4), true) >= 0,
           "intern-id-shaped symbol")
    var relocs = orel.ObjectRelocsInit()
    let obj64Res = elf64.ElfRv64TextObjectBytes(text, syms, relocs)
    assert(obj64Res.ok, obj64Res.err.msg)
    var obj64 = obj64Res.value
    defer:
        rawbytes.BytesFree(obj64)
    assert(u8At(obj64, 4) == 2, "elf64 class")
    assert(objContainsUtf8(obj64, asciiName), "elf64 strtab helper_add")
    assert(objContainsUtf8(obj64, utf8Name), "elf64 strtab utf8")
    assert(objContainsUtf8(obj64, internIdShapedName), "elf64 strtab intern-id-shaped")
    echo("elf64 intern-lookup utf8 names present")

    var relocs32 = orel.ObjectRelocsInit()
    let obj32Res = elf32.ElfRv32TextObjectBytes(text, syms, relocs32)
    assert(obj32Res.ok, obj32Res.err.msg)
    var obj32 = obj32Res.value
    defer:
        rawbytes.BytesFree(obj32)
    assert(u8At(obj32, 4) == 1, "elf32 class")
    assert(objContainsUtf8(obj32, asciiName), "elf32 strtab helper_add")
    assert(objContainsUtf8(obj32, utf8Name), "elf32 strtab utf8")
    assert(objContainsUtf8(obj32, internIdShapedName), "elf32 strtab intern-id-shaped")
    echo("elf32 intern-lookup utf8 names present")

    echo("riscv_object_symbol_intern_utf8_smoke=pass")
    return 0
