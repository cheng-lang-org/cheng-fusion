# minimal probe 3: add bridge_fs import + BfsApplyFile call
import std/os
import std/system
import std/rawbytes
import std/result
import std/bytes_layout as layout
import cheng/apps/rwad/rwad_settlement as ssm
import cheng/apps/rwad/rwad_bridge_fs as bfs

fn Tag(b: int32): layout.FixedBytes32 =
    var raw = BytesAlloc(32)
    BytesSet(raw, 0, b)
    let res = layout.FixedBytes32FromBytes(raw)
    return res.value

fn main(): int32 =
    var st = ssm.SsmInit()
    let r = bfs.BfsApplyFile(st, "/tmp/orc_dev_missing3.bin", Tag(80), Int64(100), Int64(10))
    if r.ok:
        echo("unexpected ok")
    else:
        echo("err propagated")
    return 0
