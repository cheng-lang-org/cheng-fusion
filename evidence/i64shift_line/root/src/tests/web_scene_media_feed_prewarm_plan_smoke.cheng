# S3 desktop-pure smoke: feed prewarm plan skeleton (N=2 peer collect, no dial).
# Verifies WebSceneMediaCollectFeedPrewarmPeers scans slot.peerHost/peerPort,
# caps at 2, dedupes identical host:port, and ignores empty-host (local) slots.

import cheng/core/runtime/web_scene_runtime as scene

fn fail(msg: str): int32 =
    echo(msg)
    return 1

fn makeVideoAsset(factId: str, cid: str): scene.WebSceneMediaAsset =
    var asset: scene.WebSceneMediaAsset
    asset.assetFactId = factId
    asset.assetCid = cid
    asset.bundleCid = "bundle-1"
    asset.mime = "video/mp4"
    asset.kindCode = 1
    asset.durationMs = "1000"
    asset.codec = "h264"
    asset.posterCid = "poster-1"
    asset.initSegmentCid = "init-1"
    asset.initSegmentByteLength = 64
    asset.keyframeIndex = "kf-1"
    asset.transport = "moq"
    asset.fecScheme = "fountain"
    asset.contentSignature = "sig-1"
    asset.catalogCid = "cat-1"
    asset.catalogKey = "cat-key-1"
    asset.rebuildTemplateCid = "rb-1"
    asset.rebuildTemplateKey = "rb-key-1"
    asset.objectTargetBytes = 4096
    asset.sourceBlockBytes = 1024
    asset.objectCount = 1
    asset.dropletCount = 1
    return asset

fn makeSlot(slotId: str, factId: str, cid: str, nodeId: int32, peerHost: str, peerPort: int32): scene.WebSceneMediaPlaybackSlot =
    var slot: scene.WebSceneMediaPlaybackSlot
    slot.slotId = slotId
    slot.assetFactId = factId
    slot.assetCid = cid
    slot.manifestCid = "manifest-1"
    slot.nodeTemplate = "tpl"
    slot.routeIndex = 0
    slot.nodeId = nodeId
    slot.providerKind = "media-decode-provider"
    slot.stateRef = "media.state"
    slot.decodeProvider = "decode-fountain"
    slot.textureProvider = "gpu-texture"
    slot.audioProvider = "audio-out"
    slot.objectFit = "cover"
    slot.peerHost = peerHost
    slot.peerPort = peerPort
    return slot

fn main(): int32 =
    var graph: scene.WebSceneGraph
    scene.WebSceneGraphInit(graph)
    if !scene.WebSceneAddRouteExpectedIndex(graph, "home_default", 1, 1, 0):
        return fail("FAIL: add route")
    if !scene.WebSceneAddLayer(graph, 0, 1, "content", 0):
        return fail("FAIL: add layer")
    if !scene.WebSceneAddNode(graph, 0, 1, 0, 2, "div", "", 1):
        return fail("FAIL: add container")
    if !scene.WebSceneAddNode(graph, 0, 2, 1, 2, "video", "", 1):
        return fail("FAIL: add video node 2")
    if !scene.WebSceneAddNode(graph, 0, 3, 1, 2, "video", "", 1):
        return fail("FAIL: add video node 3")
    if !scene.WebSceneAddNode(graph, 0, 4, 1, 2, "video", "", 1):
        return fail("FAIL: add video node 4")

    let a0 = makeVideoAsset("fact-0", "cid-0")
    let a1 = makeVideoAsset("fact-1", "cid-1")
    let a2 = makeVideoAsset("fact-2", "cid-2")
    if !scene.WebSceneAddMediaAsset(graph, a0):
        return fail("FAIL: add asset 0")
    if !scene.WebSceneAddMediaAsset(graph, a1):
        return fail("FAIL: add asset 1")
    if !scene.WebSceneAddMediaAsset(graph, a2):
        return fail("FAIL: add asset 2")

    # Slot0: remote peer A; slot1: local empty peer; slot2: remote peer B; slot3 would be dup of A
    if !scene.WebSceneAddMediaPlaybackSlot(graph, makeSlot("s0", "fact-0", "cid-0", 2, "127.0.0.1", 38000)):
        return fail("FAIL: add slot 0")
    if !scene.WebSceneAddMediaPlaybackSlot(graph, makeSlot("s1", "fact-1", "cid-1", 3, "", 0)):
        return fail("FAIL: add slot 1 (local)")
    if !scene.WebSceneAddMediaPlaybackSlot(graph, makeSlot("s2", "fact-2", "cid-2", 4, "192.168.1.3", 38000)):
        return fail("FAIL: add slot 2")

    # Accessors round-trip.
    if scene.WebSceneMediaPlaybackSlotPeerHostAt(graph, 0) != "127.0.0.1":
        return fail("FAIL: peerHostAt 0")
    if scene.WebSceneMediaPlaybackSlotPeerPortAt(graph, 0) != 38000:
        return fail("FAIL: peerPortAt 0")
    if scene.WebSceneMediaPlaybackSlotPeerHostAt(graph, 1) != "":
        return fail("FAIL: peerHostAt 1 must be empty (local)")

    var h0: str
    var p0: int32
    var h1: str
    var p1: int32
    let n2 = scene.WebSceneMediaCollectFeedPrewarmPeers(graph, 2, h0, p0, h1, p1)
    if n2 != 2:
        return fail("FAIL: collect N=2 want 2")
    if h0 != "127.0.0.1" || p0 != 38000:
        return fail("FAIL: plan[0] peer")
    if h1 != "192.168.1.3" || p1 != 38000:
        return fail("FAIL: plan[1] peer")

    let n1 = scene.WebSceneMediaCollectFeedPrewarmPeers(graph, 1, h0, p0, h1, p1)
    if n1 != 1:
        return fail("FAIL: collect N=1 want 1")
    if h0 != "127.0.0.1" || h1 != "":
        return fail("FAIL: N=1 must only fill slot0")

    # Default port when peerPort<=0 but host set.
    var graph2: scene.WebSceneGraph
    scene.WebSceneGraphInit(graph2)
    if !scene.WebSceneAddRouteExpectedIndex(graph2, "home_default", 1, 1, 0):
        return fail("FAIL: g2 route")
    if !scene.WebSceneAddLayer(graph2, 0, 1, "content", 0):
        return fail("FAIL: g2 layer")
    if !scene.WebSceneAddNode(graph2, 0, 1, 0, 2, "div", "", 1):
        return fail("FAIL: g2 container")
    if !scene.WebSceneAddNode(graph2, 0, 2, 1, 2, "video", "", 1):
        return fail("FAIL: g2 video")
    if !scene.WebSceneAddMediaAsset(graph2, makeVideoAsset("f", "c")):
        return fail("FAIL: g2 asset")
    if !scene.WebSceneAddMediaPlaybackSlot(graph2, makeSlot("sx", "f", "c", 2, "10.0.0.1", 0)):
        return fail("FAIL: g2 slot")
    let nd = scene.WebSceneMediaCollectFeedPrewarmPeers(graph2, 2, h0, p0, h1, p1)
    if nd != 1 || p0 != 38000:
        return fail("FAIL: default port 38000 when peerPort<=0")

    echo("web_scene_media_feed_prewarm_plan_smoke ok")
    return 0
