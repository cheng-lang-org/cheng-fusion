import std/strings
import cheng/game/assets/semantic_video/schema
import cheng/game/assets/semantic_video/writer
import cheng/game/assets/semantic_video/validator

# B1 负例验收：领域层全部结构化错误路径必须拒绝且错误码精确。
# 行直接注入 SvValidateLines（canonical 顺序手写构造）。

fn expectFail(lines: str[], want: str, label: str) =
    let result = validator.SvValidateLines(lines)
    assert(!result.ok, schema.SvCat(" should fail: ", label))
    assert(strings.StrContains(result.error, want),
        schema.SvCat(label,
            schema.SvCat(": ", result.error)))

fn expectOk(lines: str[], label: str) =
    let result = validator.SvValidateLines(lines)
    assert(result.ok,
        schema.SvCat(label, schema.SvCat(": ", result.error)))

fn main(): int32 =
    let cid = writer.SvContentCid("negative-seed")

    # 1. 未知 kind
    expectFail([
            "{\"kind\":\"csg_semantic_video::alien\",\"schema\":\"csg_semantic_video::v0.1\"}"
        ], "sv_unknown_kind", "unknown kind")

    # 2. 未知字段（非 x- 前缀）
    expectFail([
            schema.SvCat3("{\"cap\":[\"common_core\"],\"contentId\":\"", cid,
                "\",\"entrySnapshot\":\"\",\"kind\":\"csg_semantic_video::manifest\",\"resCid\":[],\"resLength\":[],\"resType\":[],\"schema\":\"csg_semantic_video::v0.1\",\"tbDen\":9e4,\"tbNum\":1,\"timeEnd\":9e5,\"timeStart\":0,\"zz\":1}")
        ], "sv_unknown_field", "unknown field")

    # 3. x- 扩展忽略并回报
    let extResult = validator.SvValidateLines([
            schema.SvCat3("{\"cap\":[\"common_core\"],\"contentId\":\"", cid,
                "\",\"entrySnapshot\":\"\",\"kind\":\"csg_semantic_video::manifest\",\"resCid\":[],\"resLength\":[],\"resType\":[],\"schema\":\"csg_semantic_video::v0.1\",\"tbDen\":9e4,\"tbNum\":1,\"timeEnd\":9e5,\"timeStart\":0,\"x-note\":\"ok\"}")
        ])
    assert(extResult.ok,
        schema.SvCat(" x-extension: ", extResult.error))
    assert(extResult.ignoredExtensions.len == 1 &&
        extResult.ignoredExtensions[0] == "x-note", " x-note reported")

    # 4. timebase 非法（tbDen=0）
    expectFail([
            schema.SvCat3("{\"cap\":[\"common_core\"],\"contentId\":\"", cid,
                "\",\"entrySnapshot\":\"\",\"kind\":\"csg_semantic_video::manifest\",\"resCid\":[],\"resLength\":[],\"resType\":[],\"schema\":\"csg_semantic_video::v0.1\",\"tbDen\":0,\"tbNum\":1,\"timeEnd\":9e5,\"timeStart\":0}")
        ], "sv_timebase_invalid", "bad timebase")

    # 5. 区间反向
    expectFail([
            schema.SvCat3("{\"cap\":[\"common_core\"],\"contentId\":\"", cid,
                "\",\"entrySnapshot\":\"\",\"kind\":\"csg_semantic_video::manifest\",\"resCid\":[],\"resLength\":[],\"resType\":[],\"schema\":\"csg_semantic_video::v0.1\",\"tbDen\":9e4,\"tbNum\":1,\"timeEnd\":9e5,\"timeStart\":0}"),
            "{\"kind\":\"csg_semantic_video::observation\",\"method\":\"m\",\"obsId\":\"obs-0\",\"schema\":\"csg_semantic_video::v0.1\",\"sensor\":\"cam\",\"sourceClass\":\"observed\",\"srcTrack\":\"v:0\",\"tbDen\":9e4,\"tbNum\":1,\"tickEnd\":50,\"tickStart\":100}"
        ], "sv_interval_reversed", "reversed interval")

    # 6. 实体引用悬空
    expectFail([
            schema.SvCat3("{\"cap\":[\"common_core\"],\"contentId\":\"", cid,
                "\",\"entrySnapshot\":\"\",\"kind\":\"csg_semantic_video::manifest\",\"resCid\":[],\"resLength\":[],\"resType\":[],\"schema\":\"csg_semantic_video::v0.1\",\"tbDen\":9e4,\"tbNum\":1,\"timeEnd\":9e5,\"timeStart\":0}"),
            "{\"confBp\":9e3,\"confDef\":\"iou\",\"kind\":\"csg_semantic_video::assertion\",\"method\":\"m\",\"obj\":\"sv-ent:ghost:0:1\",\"pred\":\"object_track\",\"rev\":0,\"schema\":\"csg_semantic_video::v0.1\",\"sourceClass\":\"inferred\",\"tbDen\":9e4,\"tbNum\":1,\"tickEnd\":100,\"tickStart\":0,\"uid\":\"asv-0\",\"val\":\"v\"}"
        ], "sv_ref_undefined", "dangling entity ref")

    # 7. delta 断链（seq=2 无前驱）
    expectFail([
            schema.SvCat3("{\"cap\":[\"common_core\",\"world_execution\"],\"contentId\":\"", cid,
                "\",\"entrySnapshot\":\"ck-root\",\"kind\":\"csg_semantic_video::manifest\",\"resCid\":[],\"resLength\":[],\"resType\":[],\"schema\":\"csg_semantic_video::v0.1\",\"tbDen\":9e4,\"tbNum\":1,\"timeEnd\":9e5,\"timeStart\":0}"),
            schema.SvCat3("{\"branch\":\"main\",\"ckpt\":\"ck-root\",\"deps\":[],\"kind\":\"csg_semantic_video::snapshot\",\"schema\":\"csg_semantic_video::v0.1\",\"tbDen\":9e4,\"tbNum\":1,\"tick\":0,\"worldCid\":\"", cid, "\"}"),
            "{\"baseCkpt\":\"ck-root\",\"kind\":\"csg_semantic_video::delta\",\"opsCid\":\"" +
                cid + "\",\"schema\":\"csg_semantic_video::v0.1\",\"seq\":0,\"tbDen\":9e4,\"tbNum\":1,\"tickEnd\":10,\"tickStart\":0,\"toCkpt\":\"ck-1\"}",
            "{\"baseCkpt\":\"ck-missing\",\"kind\":\"csg_semantic_video::delta\",\"opsCid\":\"" +
                cid + "\",\"schema\":\"csg_semantic_video::v0.1\",\"seq\":2,\"tbDen\":9e4,\"tbNum\":1,\"tickEnd\":30,\"tickStart\":20,\"toCkpt\":\"ck-x\"}"
        ], "sv_delta_seq_gap", "delta chain gap")

    # 8. 依赖环
    expectFail([
            schema.SvCat3("{\"cap\":[\"common_core\"],\"contentId\":\"", cid,
                "\",\"entrySnapshot\":\"\",\"kind\":\"csg_semantic_video::manifest\",\"resCid\":[],\"resLength\":[],\"resType\":[],\"schema\":\"csg_semantic_video::v0.1\",\"tbDen\":9e4,\"tbNum\":1,\"timeEnd\":9e5,\"timeStart\":0}"),
            "{\"consumer\":\"a\",\"kind\":\"csg_semantic_video::dependency\",\"purpose\":\"p\",\"queryBasis\":\"q\",\"schema\":\"csg_semantic_video::v0.1\",\"target\":\"b\",\"targetVer\":\"v1\"}",
            "{\"consumer\":\"b\",\"kind\":\"csg_semantic_video::dependency\",\"purpose\":\"p\",\"queryBasis\":\"q\",\"schema\":\"csg_semantic_video::v0.1\",\"target\":\"a\",\"targetVer\":\"v1\"}"
        ], "sv_ref_cycle", "dependency cycle")

    # 9. 非 canonical 行（键序倒置）
    expectFail([
            "{\"schema\":\"csg_semantic_video::v0.1\",\"kind\":\"csg_semantic_video::dependency\",\"consumer\":\"a\",\"purpose\":\"p\",\"queryBasis\":\"q\",\"target\":\"b\",\"targetVer\":\"v1\"}"
        ], "sv_noncanonical_line", "non-canonical key order")

    # 10. 实体 uid 篡改
    expectFail([
            schema.SvCat3("{\"cap\":[\"common_core\"],\"contentId\":\"", cid,
                "\",\"entrySnapshot\":\"\",\"kind\":\"csg_semantic_video::manifest\",\"resCid\":[],\"resLength\":[],\"resType\":[],\"schema\":\"csg_semantic_video::v0.1\",\"tbDen\":9e4,\"tbNum\":1,\"timeEnd\":9e5,\"timeStart\":0}"),
            "{\"gen\":0,\"kind\":\"csg_semantic_video::entity\",\"lifecycle\":\"active\",\"ns\":\"demo\",\"num\":1,\"schema\":\"csg_semantic_video::v0.1\",\"typeVer\":\"t\",\"uid\":\"wrong\"}"
        ], "sv_field_type_mismatch uid", "entity uid tampered")

    # 11. 缺 manifest
    expectFail([
            "{\"kind\":\"csg_semantic_video::observation\",\"method\":\"m\",\"obsId\":\"obs-0\",\"schema\":\"csg_semantic_video::v0.1\",\"sensor\":\"cam\",\"sourceClass\":\"observed\",\"srcTrack\":\"v:0\",\"tbDen\":9e4,\"tbNum\":1,\"tickEnd\":100,\"tickStart\":0}"
        ], "sv_missing_required_field manifest", "missing manifest")

    # 12. 置信越界
    expectFail([
            schema.SvCat3("{\"cap\":[\"common_core\"],\"contentId\":\"", cid,
                "\",\"entrySnapshot\":\"\",\"kind\":\"csg_semantic_video::manifest\",\"resCid\":[],\"resLength\":[],\"resType\":[],\"schema\":\"csg_semantic_video::v0.1\",\"tbDen\":9e4,\"tbNum\":1,\"timeEnd\":9e5,\"timeStart\":0}"),
            "{\"gen\":0,\"kind\":\"csg_semantic_video::entity\",\"lifecycle\":\"active\",\"ns\":\"demo\",\"num\":1,\"schema\":\"csg_semantic_video::v0.1\",\"typeVer\":\"t\",\"uid\":\"sv-ent:demo:0:1\"}",
            "{\"confBp\":10001,\"confDef\":\"\",\"kind\":\"csg_semantic_video::assertion\",\"method\":\"m\",\"obj\":\"sv-ent:demo:0:1\",\"pred\":\"object_track\",\"rev\":0,\"schema\":\"csg_semantic_video::v0.1\",\"sourceClass\":\"inferred\",\"tbDen\":9e4,\"tbNum\":1,\"tickEnd\":100,\"tickStart\":0,\"uid\":\"asv-0\",\"val\":\"v\"}"
        ], "sv_conf_out_of_range", "confidence out of range")

    # 13. schema 错误命名空间
    expectFail([
            "{\"kind\":\"csg_semantic_video::manifest\",\"schema\":\"other::v9\"}"
        ], "sv_unknown_field", "wrong schema namespace")

    echo(" sv_b1_negative_smoke ok")
    return 0
