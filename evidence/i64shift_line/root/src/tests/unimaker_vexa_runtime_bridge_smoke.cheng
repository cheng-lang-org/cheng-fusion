import std/strings
import std/os as os
import std/rawbytes
import std/strutils as strutil
import std/system
import cheng/core/tooling/path as chengpath
import cheng/std/bytes_layout as layout
import cheng/core/csg_asset/oracle_asset as asset
import cheng/apps/unimaker/unimaker_edge_types as types
import cheng/apps/unimaker/unimaker_edge_agent as edge_agent
import cheng/apps/unimaker/unimaker_product_publish as publish
import cheng/apps/vexa/vexa_asset_discovery as discovery
import cheng/tests/oracle_smoke_support as support

fn bridgeCleanup(tmpRoot: str) =
    let storePath = os.JoinPath(tmpRoot, "agent.did")
    let eventLogPath = os.JoinPath(tmpRoot, "events.jsonl")
    let eventLogTmpPath = strutil.Join([strings.CloneStr(eventLogPath), ".tmp"], "")
    if os.FileExists(storePath):
        let _ = os.RemoveFile(storePath)
    if os.FileExists(eventLogPath):
        let _ = os.RemoveFile(eventLogPath)
    if os.FileExists(eventLogTmpPath):
        let _ = os.RemoveFile(eventLogTmpPath)
    if os.DirExists(tmpRoot):
        os.RemoveDir(tmpRoot)

fn bridgeExpect(cond: bool, message: str): int32 =
    if !cond:
        os.WriteLine(os.Get_stderr(), message)
        return 1
    return 0

fn bridgeObservation(): asset.OracleAssetObservation =
    return asset.OracleAssetObservation(
        id: "obs_unimaker_runtime_product_001",
        sourceKind: "oracle_bft_committee",
        sourceUri: "oracle://cheng/mainnet/unimaker/product/runtime-001",
        subjectId: "unimaker_runtime_product_001",
        valueHash: asset.AssetSha256("runtime product source value"),
        observedAtMs: int64(1800000),
        ttlMs: int64(120000),
        reporterCount: 9,
        quorum: 6,
        appHash: asset.AssetSha256("runtime oracle app hash"),
        receiptHash: asset.AssetSha256("runtime oracle receipt")
    )

@borrows
fn bridgeClaim(observation: asset.OracleAssetObservation): asset.UnimakerProductSourceClaim =
    return asset.UnimakerProductSourceClaim(
        id: "claim_unimaker_runtime_product_001",
        productId: observation.subjectId,
        sourceId: observation.id,
        sellerId: "did:unimaker:seller_runtime",
        titleHash: asset.AssetSha256("runtime product title"),
        licenseHash: asset.AssetSha256("runtime product license"),
        mediaAssetCid: "bafybeigdyrztruntime001",
        priceE8: int64(660000000),
        inventory: int64(12),
        observedAtMs: observation.observedAtMs,
        ttlMs: observation.ttlMs,
        oracleReceiptHash: observation.receiptHash,
        signerHash: asset.AssetSha256("runtime seller signature"),
        authorized: true
    )

fn bridgeBuildRequest(): publish.UnimakerProductPublishRequest =
    var observation = bridgeObservation()
    let claim = bridgeClaim(observation)
    observation.valueHash = asset.UnimakerProductObservationValueHash(claim)
    return publish.UnimakerProductPublishRequest(
        observation: observation,
        claim: claim,
        nowMs: int64(1810000),
        actionKind: "unimaker.publish_product",
        preconditionHash: asset.AssetSha256("runtime publish preconditions"),
        executorId: "cheng_unimaker_runtime_publish_executor",
        executionStateHash: asset.AssetSha256("runtime execution input state"),
        outputStateHash: asset.AssetSha256("runtime published product state"),
        executedAtMs: int64(1830000),
        resumeTokenHash: asset.AssetSha256("runtime recoverable cell resume token")
    )

fn bridgeSignedClaimSigHex(authorized: bool): str =
    if authorized:
        return "d628b48c962dd4f2664fe04043bbb9e8362f2a8efb01567d5484c762c3bc47932ced932c23591fdc6ecfbd4fa064087c270b35e92f6080d10ea2bdef432674a6"
    return "eee3507ae0a64e071f2ffbceac369d92ffaa56b424d0d6e02e50bfff0ad6bd36305ee4615830126b0d93e508e560a087b111f842121d08264eb72930ee3a72ff"

@borrows
fn bridgeSignedClaimWithAuthorized(observation: asset.OracleAssetObservation,
                                   authorized: bool): asset.UnimakerProductSignedSourceClaim =
    var claim = bridgeClaim(observation)
    let pubKey = support.oracleSmokePubKey(1)
    claim.authorized = authorized
    claim.signerHash = asset.UnimakerProductSignerHash(pubKey)
    let sigRes = layout.FixedBytes64FromHex(bridgeSignedClaimSigHex(authorized))
    if IsErr(sigRes):
        system.Panic(Error(sigRes))
    var out: asset.UnimakerProductSignedSourceClaim
    out.claim = claim
    out.signerPubKey = pubKey
    out.signature = Value(sigRes)
    let verifyRes = asset.UnimakerProductSignedSourceClaimVerify(out)
    if IsErr(verifyRes):
        system.Panic(Error(verifyRes))
    return out

@borrows
fn bridgeSignedClaim(observation: asset.OracleAssetObservation): asset.UnimakerProductSignedSourceClaim =
    return bridgeSignedClaimWithAuthorized(observation, true)

fn bridgeBuildSignedRequest(): publish.UnimakerProductSignedPublishRequest =
    var observation = bridgeObservation()
    let signedClaim = bridgeSignedClaim(observation)
    observation.valueHash = asset.UnimakerProductObservationValueHash(signedClaim.claim)
    return publish.UnimakerProductSignedPublishRequest(
        observation: observation,
        signedClaim: signedClaim,
        trustedSignerHash: signedClaim.claim.signerHash,
        nowMs: int64(1810000),
        actionKind: "unimaker.publish_product",
        preconditionHash: asset.AssetSha256("runtime publish preconditions"),
        executorId: "cheng_unimaker_runtime_publish_executor",
        executionStateHash: asset.AssetSha256("runtime execution input state"),
        outputStateHash: asset.AssetSha256("runtime published product state"),
        executedAtMs: int64(1830000),
        resumeTokenHash: asset.AssetSha256("runtime recoverable cell resume token")
    )

fn main(): int32 =
    let tmpRoot = "artifacts/unimaker_vexa_runtime_bridge_smoke"
    bridgeCleanup(tmpRoot)
    os.CreateDir(tmpRoot)

    var cfg = types.UnimakerAgentConfig()
    cfg.rootDir = chengpath.PathCurrentDir()
    cfg.eventLogPath = os.JoinPath(tmpRoot, "events.jsonl")
    cfg.identityStorePath = os.JoinPath(tmpRoot, "agent.did")
    cfg.rootSeedHint = "unimaker.vexa.runtime.root.seed"
    cfg.deviceSeedHint = "unimaker.vexa.runtime.device.seed"
    cfg.deviceLabelHint = "unimaker-vexa-runtime"
    cfg.epochSeconds = int64(1711000000)
    var edge = edge_agent.UnimakerAgentInit(cfg)

    let request = bridgeBuildSignedRequest()
    var ledger = publish.UnimakerProductPublishLedgerInit()
    let initialLedgerRoot = ledger.ledgerRoot
    var registry = discovery.VexaAdmissionRegistryInit()
    let initialRegistryRoot = registry.registryRoot
    let submitRes = publish.UnimakerProductPublishSubmitSigned(edge,
                                                               ledger,
                                                               registry,
                                                               request,
                                                               "task.runtime.publish",
                                                               int64(1711000010))
    if bridgeExpect(submitRes.ok, "runtime bridge: UniMaker publish submit failed") != 0:
        os.WriteLine(os.Get_stderr(), submitRes.err.msg)
        return 1
    let submitted = submitRes.value
    let bundle = submitted.bundle
    let record = submitted.record
    let capsule = submitted.capsule
    let admitted = submitted.admitted
    if bridgeExpect(rawbytes.BytesLen(bundle.csgcBytes) > 64, "runtime bridge: empty CSGC") != 0:
        return 1
    if bridgeExpect(submitted.ledgerRoot == ledger.ledgerRoot,
                    "runtime bridge: submit ledger root mismatch") != 0:
        return 1
    if bridgeExpect(submitted.registryRoot == registry.registryRoot,
                    "runtime bridge: submit registry root mismatch") != 0:
        return 1
    if bridgeExpect(publish.UnimakerProductPublishLedgerCount(ledger) == 1,
                    "runtime bridge: UniMaker publish ledger count mismatch") != 0:
        return 1
    if bridgeExpect(initialLedgerRoot != ledger.ledgerRoot,
                    "runtime bridge: UniMaker publish ledger root did not change") != 0:
        return 1
    if bridgeExpect(record.planRoot == bundle.plan.planRoot,
                    "runtime bridge: UniMaker publish record plan root mismatch") != 0:
        return 1
    if bridgeExpect(record.recoveryRoot == bundle.cell.recoveryRoot,
                    "runtime bridge: UniMaker publish record recovery root mismatch") != 0:
        return 1
    if bridgeExpect(edge_agent.UnimakerAgentCapsuleCount(edge) == 1,
                    "runtime bridge: edge agent capsule count mismatch") != 0:
        return 1
    if bridgeExpect(capsule.contentText == record.eventContentHash,
                    "runtime bridge: edge capsule content hash mismatch") != 0:
        return 1
    if bridgeExpect(types.UnimakerCapsuleKeywordMatch(capsule, "csg"),
                    "runtime bridge: edge capsule missing csg keyword") != 0:
        return 1
    var edgeQuery = types.MemoryQuery()
    edgeQuery.taskId = "task.runtime.publish"
    edgeQuery.limit = 4
    let recallRes = edge_agent.UnimakerAgentRecall(edge, edgeQuery)
    if bridgeExpect(IsOk(recallRes), "runtime bridge: edge recall failed") != 0:
        os.WriteLine(os.Get_stderr(), Error(recallRes))
        return 1
    if bridgeExpect(Value(recallRes).len == 1,
                    "runtime bridge: edge recall count mismatch") != 0:
        return 1
    var keywordQuery = types.MemoryQuery()
    keywordQuery.keyword = "csg"
    keywordQuery.limit = 4
    let keywordRecallRes = edge_agent.UnimakerAgentRecall(edge, keywordQuery)
    if bridgeExpect(IsOk(keywordRecallRes), "runtime bridge: edge keyword recall failed") != 0:
        os.WriteLine(os.Get_stderr(), Error(keywordRecallRes))
        return 1
    if bridgeExpect(Value(keywordRecallRes).len == 1,
                    "runtime bridge: edge keyword recall count mismatch") != 0:
        return 1
    let missingTaskIngest = publish.UnimakerProductPublishIngestAgent(edge,
                                                                      bundle,
                                                                      "",
                                                                      int64(1711000010))
    if bridgeExpect(IsErr(missingTaskIngest),
                    "runtime bridge: edge ingest with empty task id must fail") != 0:
        return 1
    let badTimestampIngest = publish.UnimakerProductPublishIngestAgent(edge,
                                                                       bundle,
                                                                       "task.runtime.bad_timestamp",
                                                                       int64(0))
    if bridgeExpect(IsErr(badTimestampIngest),
                    "runtime bridge: edge ingest with invalid timestamp must fail") != 0:
        return 1
    let missingTaskSubmit = publish.UnimakerProductPublishSubmitSigned(edge,
                                                                       ledger,
                                                                       registry,
                                                                       request,
                                                                       "",
                                                                       int64(1711000012))
    if bridgeExpect(!missingTaskSubmit.ok,
                    "runtime bridge: publish submit with empty task id must fail") != 0:
        return 1
    let badTimestampSubmit = publish.UnimakerProductPublishSubmitSigned(edge,
                                                                        ledger,
                                                                        registry,
                                                                        request,
                                                                        "task.runtime.bad_timestamp",
                                                                        int64(0))
    if bridgeExpect(!badTimestampSubmit.ok,
                    "runtime bridge: publish submit with invalid timestamp must fail") != 0:
        return 1
    var wrongSignerRequest = request
    wrongSignerRequest.signedClaim.signerPubKey = support.oracleSmokePubKey(2)
    let wrongSignerSubmit = publish.UnimakerProductPublishSubmitSigned(edge,
                                                                       ledger,
                                                                       registry,
                                                                       wrongSignerRequest,
                                                                       "task.runtime.wrong_signer",
                                                                       int64(1711000012))
    if bridgeExpect(!wrongSignerSubmit.ok,
                    "runtime bridge: wrong signer publish submit must fail") != 0:
        return 1
    var tamperedRequest = request
    tamperedRequest.signedClaim.claim.priceE8 = tamperedRequest.signedClaim.claim.priceE8 + int64(1)
    tamperedRequest.observation.valueHash = asset.UnimakerProductObservationValueHash(tamperedRequest.signedClaim.claim)
    let tamperedSubmit = publish.UnimakerProductPublishSubmitSigned(edge,
                                                                    ledger,
                                                                    registry,
                                                                    tamperedRequest,
                                                                    "task.runtime.tampered_claim",
                                                                    int64(1711000012))
    if bridgeExpect(!tamperedSubmit.ok,
                    "runtime bridge: tampered signed claim publish submit must fail") != 0:
        return 1
    var wrongTrustRequest = request
    wrongTrustRequest.trustedSignerHash = asset.AssetSha256("wrong trusted signer")
    let wrongTrustSubmit = publish.UnimakerProductPublishSubmitSigned(edge,
                                                                      ledger,
                                                                      registry,
                                                                      wrongTrustRequest,
                                                                      "task.runtime.wrong_trust",
                                                                      int64(1711000012))
    if bridgeExpect(!wrongTrustSubmit.ok,
                    "runtime bridge: wrong trusted signer publish submit must fail") != 0:
        return 1
    var unauthorizedObservation = bridgeObservation()
    let unauthorizedSignedClaim = bridgeSignedClaimWithAuthorized(unauthorizedObservation, false)
    unauthorizedObservation.valueHash = asset.UnimakerProductObservationValueHash(unauthorizedSignedClaim.claim)
    var unauthorizedRequest: publish.UnimakerProductSignedPublishRequest
    unauthorizedRequest = request
    unauthorizedRequest.observation = unauthorizedObservation
    unauthorizedRequest.signedClaim = unauthorizedSignedClaim
    let unauthorizedSubmit = publish.UnimakerProductPublishSubmitSigned(edge,
                                                                        ledger,
                                                                        registry,
                                                                        unauthorizedRequest,
                                                                        "task.runtime.unauthorized",
                                                                        int64(1711000012))
    if bridgeExpect(!unauthorizedSubmit.ok,
                    "runtime bridge: unauthorized publish submit must fail") != 0:
        return 1
    if bridgeExpect(discovery.VexaAdmissionRegistryCount(registry) == 1,
                    "runtime bridge: Vexa registry count mismatch") != 0:
        return 1
    if bridgeExpect(initialRegistryRoot != registry.registryRoot,
                    "runtime bridge: Vexa registry root did not change") != 0:
        return 1
    if bridgeExpect(admitted.recoveryRoot == record.recoveryRoot,
                    "runtime bridge: UniMaker and Vexa recovery roots diverged") != 0:
        return 1
    if bridgeExpect(admitted.planRoot == bundle.plan.planRoot,
                    "runtime bridge: admitted plan root mismatch") != 0:
        return 1

    let duplicateAdmission = discovery.VexaAdmissionRegistryAdmitCsgc(registry, bundle.csgcBytes)
    if bridgeExpect(!duplicateAdmission.ok,
                    "runtime bridge: duplicate Vexa CSGC admission must fail") != 0:
        return 1

    let duplicateRecord = publish.UnimakerProductPublishLedgerAppendBundle(ledger,
                                                                           bundle,
                                                                           "task.runtime.publish",
                                                                           int64(1711000011))
    if bridgeExpect(!duplicateRecord.ok,
                    "runtime bridge: duplicate UniMaker publish record must fail") != 0:
        return 1
    let duplicateSubmit = publish.UnimakerProductPublishSubmitSigned(edge,
                                                                     ledger,
                                                                     registry,
                                                                     request,
                                                                     "task.runtime.publish.duplicate",
                                                                     int64(1711000012))
    if bridgeExpect(!duplicateSubmit.ok,
                    "runtime bridge: duplicate publish submit must fail") != 0:
        return 1

    var incomplete: discovery.VexaAdmittedAsset
    incomplete.assetId = admitted.assetId
    incomplete.planRoot = asset.AssetSha256("runtime incomplete plan")
    incomplete.recoveryRoot = asset.AssetSha256("runtime incomplete recovery")
    incomplete.complete = false
    let incompleteAdmission = discovery.VexaAdmissionRegistryAdmit(registry, incomplete)
    if bridgeExpect(!incompleteAdmission.ok,
                    "runtime bridge: incomplete Vexa admission must fail") != 0:
        return 1

    bridgeCleanup(tmpRoot)
    os.WriteLine(os.Get_stdout(), "unimaker_vexa_runtime_bridge_smoke ok")
    return 0
