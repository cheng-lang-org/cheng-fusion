# tier1 minimal: no Tag/Tagged, literal path.
import std/system
import std/os
import std/result

fn Tier1(path: str): Result[bool] =
    let r = os.ReadFileBytesResult(path)
    if !r.ok:
        return Err[bool](r.err.msg)
    return Ok[bool](true)

fn main(): int32 =
    let t1 = Tier1("/tmp/orc_repro_does_not_exist.bin")
    if t1.ok:
        echo("unexpected ok")
    else:
        echo("err propagated")
    echo("exit now")
    return 0
