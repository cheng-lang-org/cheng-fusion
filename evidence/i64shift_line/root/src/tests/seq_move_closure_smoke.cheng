import std/seqs as seqs

fn invoke(callback: fn(): int32): int32 =
    return callback()

fn main(): int32 =
    let callback = fn(): int32 =
        var source: int32[]
        add(source, 23)
        var moved: int32[] = source
        if moved.len != 1 || moved[0] != 23:
            return 1
        seqs.chengSeqFreeTyped[int32](moved)
        return 0
    return invoke(callback)
