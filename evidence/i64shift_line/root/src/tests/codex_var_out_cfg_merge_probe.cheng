fn SetText(out: var str, value: str): bool =
    out = value
    return true

fn RewriteAcrossTwoJoins(
        out: var str,
        chooseFirst: bool,
        chooseSecond: bool): bool =
    if chooseFirst:
        if !SetText(out, "first-left"):
            return false
    else:
        if !SetText(out, "first-right"):
            return false
    if chooseSecond:
        if !SetText(out, "second-left"):
            return false
    else:
        if !SetText(out, "second-right"):
            return false
    out = "done"
    return true

fn main(): int32 =
    var value = "start"
    if !RewriteAcrossTwoJoins(value, true, false) || value != "done":
        return 1
    if !RewriteAcrossTwoJoins(value, false, true) || value != "done":
        return 2
    return 0
