type
    R18Expr = object
        sourcePath: str
        surfaceText: str
        callCallee: str
        callTarget: str
        idHash: int32

fn R18MakeCallId(sourcePath: str, surfaceText: str, callTarget: str): int32 =
    return sourcePath.len * 100 + surfaceText.len * 10 + callTarget.len

fn R18Build(sourcePath: str, surfaceText: str, callName: str): R18Expr =
    var expr: R18Expr
    expr.sourcePath = share(sourcePath)
    expr.surfaceText = share(surfaceText)
    expr.callCallee = share(callName)
    expr.callTarget = callName
    expr.idHash = R18MakeCallId(sourcePath, surfaceText, expr.callTarget)
    return expr

fn main(): int32 =
    let e = R18Build("src/a.cheng", "foo(x)", "pkg.foo")
    if e.idHash != 1168:
        return 10
    if e.sourcePath != "src/a.cheng":
        return 11
    if e.surfaceText != "foo(x)":
        return 12
    if e.callCallee != "pkg.foo":
        return 13
    if e.callTarget != "pkg.foo":
        return 14
    echo("tk_r18_share MUTANT p=" + e.sourcePath + " s=" + e.surfaceText + " c=" + e.callCallee + " t=" + e.callTarget)
    return 0
