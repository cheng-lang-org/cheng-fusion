import std/os as os
import std/strings as strings

fn main(): int32 =
    let compilerMainPath: str = "src/core/tooling/compiler_main.cheng"
    let osPath: str = "src/std/os.cheng"
    let rawbytesPath: str = "src/std/rawbytes.cheng"
    let hostOpsPath: str = "src/core/tooling/host_ops.cheng"
    let systemLinkExecPath: str = "src/core/backend/system_link_exec.cheng"
    let systemLinkExecRuntimePath: str = "src/core/backend/system_link_exec_runtime.cheng"
    let backendDriverDispatchMinPath: str = "src/core/tooling/backend_driver_dispatch_min.cheng"
    let machoProviderLinkerPath: str = "src/core/backend/macho_provider_linker.cheng"
    let parserPath: str = "src/core/lang/parser.cheng"
    let typedExprPath: str = "src/core/lang/typed_expr.cheng"
    let loweringPlanPath: str = "src/core/backend/lowering_plan.cheng"
    let primaryObjectPlanPath: str = "src/core/backend/primary_object_plan.cheng"
    let programSupportBackendPath: str = "src/core/runtime/program_support_backend.cheng"
    let coldPath: str = "bootstrap/cheng_cold.c"
    let gateMainPath: str = "src/core/tooling/gate_main.cheng"
    let hostSmokeGatePath: str = "src/core/tooling/host_smoke_gate.cheng"
    let runtimeZeroSmokePath: str = "src/tests/runtime_zero_c_surface_smoke.cheng"
    let kCensusPath: str = "tools/k_census.sh"
    let execDiffPath: str = "tools/exec_diff.sh"
    let buildCdpModulesPath: str = "tools/build_cdp_modules.sh"
    let diffFuzzPath: str = "tools/diff_fuzz_test.sh"
    let abiFuzzPath: str = "tools/abi_fuzz_test.sh"
    let hostRuntimeGapReportPath: str = "tools/host_runtime_gap_report.sh"
    let functionParallelBenchmarkPath: str = "tools/function_parallel_benchmark.sh"
    assert(os.FileExists(compilerMainPath) && os.FileSize(compilerMainPath) > int64(0),
           " backend driver resource guard: compiler main exists")
    assert(os.FileExists(osPath) && os.FileSize(osPath) > int64(0),
           " backend driver resource guard: os exists")
    assert(os.FileExists(rawbytesPath) && os.FileSize(rawbytesPath) > int64(0),
           " backend driver resource guard: rawbytes exists")
    assert(os.FileExists(hostOpsPath) && os.FileSize(hostOpsPath) > int64(0),
           " backend driver resource guard: host ops exists")
    assert(os.FileExists(systemLinkExecPath) && os.FileSize(systemLinkExecPath) > int64(0),
           " backend driver resource guard: system link exec exists")
    assert(os.FileExists(systemLinkExecRuntimePath) && os.FileSize(systemLinkExecRuntimePath) > int64(0),
           " backend driver resource guard: system link exec runtime exists")
    assert(os.FileExists(backendDriverDispatchMinPath) && os.FileSize(backendDriverDispatchMinPath) > int64(0),
           " backend driver resource guard: backend driver dispatch min exists")
    assert(os.FileExists(machoProviderLinkerPath) && os.FileSize(machoProviderLinkerPath) > int64(0),
           " backend driver resource guard: macho provider linker exists")
    assert(os.FileExists(parserPath) && os.FileSize(parserPath) > int64(0),
           " backend driver resource guard: parser exists")
    assert(os.FileExists(typedExprPath) && os.FileSize(typedExprPath) > int64(0),
           " backend driver resource guard: typed expr exists")
    assert(os.FileExists(loweringPlanPath) && os.FileSize(loweringPlanPath) > int64(0),
           " backend driver resource guard: lowering plan exists")
    assert(os.FileExists(primaryObjectPlanPath) && os.FileSize(primaryObjectPlanPath) > int64(0),
           " backend driver resource guard: primary object plan exists")
    assert(os.FileExists(programSupportBackendPath) && os.FileSize(programSupportBackendPath) > int64(0),
           " backend driver resource guard: program support backend exists")
    assert(os.FileExists(coldPath) && os.FileSize(coldPath) > int64(0),
           " backend driver resource guard: cold bootstrap exists")
    assert(os.FileExists(gateMainPath) && os.FileSize(gateMainPath) > int64(0),
           " backend driver resource guard: gate main exists")
    assert(os.FileExists(hostSmokeGatePath) && os.FileSize(hostSmokeGatePath) > int64(0),
           " backend driver resource guard: host smoke gate exists")
    assert(os.FileExists(runtimeZeroSmokePath) && os.FileSize(runtimeZeroSmokePath) > int64(0),
           " backend driver resource guard: runtime zero smoke exists")
    assert(os.FileExists(kCensusPath) && os.FileSize(kCensusPath) > int64(0),
           " backend driver resource guard: k census exists")
    assert(os.FileExists(execDiffPath) && os.FileSize(execDiffPath) > int64(0),
           " backend driver resource guard: exec diff exists")
    assert(os.FileExists(buildCdpModulesPath) && os.FileSize(buildCdpModulesPath) > int64(0),
           " backend driver resource guard: cdp build exists")
    assert(os.FileExists(diffFuzzPath) && os.FileSize(diffFuzzPath) > int64(0),
           " backend driver resource guard: diff fuzz exists")
    assert(os.FileExists(abiFuzzPath) && os.FileSize(abiFuzzPath) > int64(0),
           " backend driver resource guard: abi fuzz exists")
    assert(os.FileExists(hostRuntimeGapReportPath) && os.FileSize(hostRuntimeGapReportPath) > int64(0),
           " backend driver resource guard: host runtime gap report exists")
    assert(os.FileExists(functionParallelBenchmarkPath) && os.FileSize(functionParallelBenchmarkPath) > int64(0),
           " backend driver resource guard: function parallel benchmark exists")

    let compilerText: str = os.ReadFile(compilerMainPath)
    let osText: str = os.ReadFile(osPath)
    let rawbytesText: str = os.ReadFile(rawbytesPath)
    let hostOpsText: str = os.ReadFile(hostOpsPath)
    let systemLinkExecText: str = os.ReadFile(systemLinkExecPath)
    let systemLinkExecRuntimeText: str = os.ReadFile(systemLinkExecRuntimePath)
    let backendDriverDispatchMinText: str = os.ReadFile(backendDriverDispatchMinPath)
    let machoProviderLinkerText: str = os.ReadFile(machoProviderLinkerPath)
    let parserText: str = os.ReadFile(parserPath)
    let typedExprText: str = os.ReadFile(typedExprPath)
    let loweringPlanText: str = os.ReadFile(loweringPlanPath)
    let primaryObjectPlanText: str = os.ReadFile(primaryObjectPlanPath)
    let programSupportBackendText: str = os.ReadFile(programSupportBackendPath)
    let coldText: str = os.ReadFile(coldPath)
    let gateMainText: str = os.ReadFile(gateMainPath)
    let hostSmokeGateText: str = os.ReadFile(hostSmokeGatePath)
    let runtimeZeroSmokeText: str = os.ReadFile(runtimeZeroSmokePath)
    let kCensusText: str = os.ReadFile(kCensusPath)
    let execDiffText: str = os.ReadFile(execDiffPath)
    let buildCdpModulesText: str = os.ReadFile(buildCdpModulesPath)
    let diffFuzzText: str = os.ReadFile(diffFuzzPath)
    let abiFuzzText: str = os.ReadFile(abiFuzzPath)
    let hostRuntimeGapReportText: str = os.ReadFile(hostRuntimeGapReportPath)
    let functionParallelBenchmarkText: str = os.ReadFile(functionParallelBenchmarkPath)

    assert(strings.StrContains(compilerText, "CompilerBuildBackendDriverMaxRssBytesText"),
           " backend driver resource guard: max rss helper")
    assert(strings.StrContains(compilerText, "CompilerFollowWorldMaxRssBytesText"),
           " backend driver resource guard: follow-world max rss helper")
    assert(strings.StrContains(compilerText, "return CompilerBackendDriverDefaultMaxRssBytesText()"),
           " backend driver resource guard: build cap is fixed")
    assert(!strings.StrContains(compilerText, "let processRaw: str = strutil.Strip(os.GetEnv(\"CHENG_PROCESS_MAX_RSS_BYTES\"))"),
           " backend driver resource guard: no inherited process rss cap")
    assert(strings.StrContains(compilerText, "1073741824"),
           " backend driver resource guard: default 1g theory hard gate")
    assert(strings.StrContains(compilerText, "os.SetEnv(\"CHENG_PROGRESS\", \"1\")"),
           " backend driver resource guard: progress enabled")
    assert(strings.StrContains(compilerText, "strutil.Join([\"CHENG_PROCESS_MAX_RSS_BYTES=\", buildMaxRssBytesText], \"\")"),
           " backend driver resource guard: child rss cap")
    assert(strings.StrContains(compilerText, "strutil.Join([\"CHENG_PROCESS_MAX_RSS_BYTES=\", followMaxRssBytesText], \"\")"),
           " backend driver resource guard: follow-world child rss cap")
    assert(strings.StrContains(compilerText, "followGuardEnv"),
           " backend driver resource guard: follow-world guarded env")
    assert(strings.StrContains(compilerText, "\"BACKEND_INCREMENTAL=0\""),
           " backend driver resource guard: incremental disabled")
    assert(strings.StrContains(compilerText, "\"BACKEND_MULTI_MODULE_CACHE=0\""),
           " backend driver resource guard: module cache disabled")
    assert(strings.StrContains(compilerText, "\"CHENG_DISABLE_PRIMARY_OBJECT_CACHE=1\""),
           " backend driver resource guard: primary object cache disabled")
    assert(strings.StrContains(compilerText, "\"BACKEND_BUILD_DRIVER_QUICK_STAMP_CACHE=0\""),
           " backend driver resource guard: stamp cache disabled")
    assert(strings.StrContains(compilerText, "\"BACKEND_BUILD_DRIVER_QUICK_SHARED_CACHE=0\""),
           " backend driver resource guard: shared cache disabled")
    assert(strings.StrContains(compilerText, "CompilerProgressResourceGuardCheck"),
           " backend driver resource guard: compiler progress self guard")
    assert(strings.StrContains(compilerText, "CompilerRunFileEnvLogged(rootDir"),
           " backend driver resource guard: guarded process runner")

    assert(strings.StrContains(osText, "ProcessResourceGuardCheck"),
           " backend driver resource guard: os phase guard export")
    assert(strings.StrContains(osText, "fn CompileRssTheoryHardGateBytes(): int64 ="),
           " backend driver resource guard: os compile rss theory hard gate helper")
    assert(strings.StrContains(backendDriverDispatchMinText,
                               "fn BackendDriverDispatchMinCompileRssTheoryLowerBoundBytes("),
           " backend driver resource guard: dispatch compile rss theory lower bound helper")
    assert(strings.StrContains(backendDriverDispatchMinText,
                               "full_compile_theory_rss_lower_bound_model=deterministic_phase_lifetime_consume_window_plus_orc"),
           " backend driver resource guard: dispatch theory lower bound model")
    assert(strings.StrContains(backendDriverDispatchMinText,
                               "full_compile_theory_rss_lower_bound_bytes="),
           " backend driver resource guard: dispatch theory lower bound bytes")
    assert(strings.StrContains(osText, "processResourceGuardDefaultMaxRssBytes"),
           " backend driver resource guard: os default max rss helper")
    assert(strings.StrContains(osText, "return int64(1073741824)") ||
           strings.StrContains(osText, "return Int64(1073741824)"),
           " backend driver resource guard: os default 1g theory hard gate")
    assert(strings.StrContains(osText, "CHENG_PROCESS_MAX_RSS_BYTES"),
           " backend driver resource guard: os rss env")
    assert(strings.StrContains(osText, "CHENG_PARENT_RSS_GUARD"),
           " backend driver resource guard: os parent rss guard")
    assert(strings.StrContains(
               osText,
               "if Len(getEnv(\"PARENT_RSS_GUARD\")) > 0 ||") &&
           strings.StrContains(
               osText,
               "Len(getEnv(\"PROCESS_MAX_RSS_BYTES\")) > 0 ||") &&
           strings.StrContains(
               osText,
               "Len(getEnv(\"CHENG_MAX_RSS_BYTES\")) > 0 ||") &&
           strings.StrContains(
               osText,
               "Len(getEnv(\"MAX_RSS_BYTES\")) > 0:\n        return Int64(-1)"),
           " backend driver resource guard: os rejects legacy rss env")
    assert(strings.StrContains(osText, "for i in 0..<Len(raw):"),
           " backend driver resource guard: os parser uses stable len")
    assert(strings.StrContains(osText, "@importc(\"getrusage\")"),
           " backend driver resource guard: os direct rusage bridge")
    assert(!strings.StrContains(osText, "/bin/ps -p "),
           " backend driver resource guard: os no ps rss fallback")
    assert(strings.StrContains(osText, "if maxRssBytes == Int64(0):\n        return"),
           " backend driver resource guard: os parent guard disables self cap")
    assert(!strings.StrContains(osText, "fn processResourceGuardCheck() =\n    return"),
           " backend driver resource guard: os phase guard is active")
    assert(strings.StrContains(osText, "status=rss_limit_exceeded"),
           " backend driver resource guard: os rss diagnostic")
    assert(strings.StrContains(osText, "status=rss_unavailable"),
           " backend driver resource guard: os unavailable rss hard fail")
    assert(strings.StrContains(osText, "rawbytes.BytesAlloc"),
           " backend driver resource guard: os rawbytes calls are module-qualified")
    assert(!strings.StrContains(osText, "let out: Bytes = BytesAlloc("),
           " backend driver resource guard: os no unqualified BytesAlloc call")
    assert(!strings.StrContains(rawbytesText, "fn bytesLen(b: Bytes): int32 =\n    return b.len\n\nfn BytesLen(b: Bytes): int32 =\n    return b.len"),
           " backend driver resource guard: rawbytes BytesLen has a single exported definition")
    assert(!strings.StrContains(osText, "let n: int32 = BytesLen("),
           " backend driver resource guard: os no unqualified BytesLen call")

    assert(strings.StrContains(hostOpsText, "HostOpsProcessGroupRssBytes"),
           " backend driver resource guard: process group rss")
    assert(strings.StrContains(hostOpsText, "HostOpsCurrentRssBytes"),
           " backend driver resource guard: current rss")
    assert(strings.StrContains(hostOpsText, "HostOpsLegacyResourceGuardEnvPresent") &&
           strings.StrContains(hostOpsText, "HostOpsEnvOverrideHasKey"),
           " backend driver resource guard: host ops rejects legacy rss env")
    assert(!strings.StrContains(hostOpsText, "raw = strutil.Strip(HostOpsEnvOverrideValue(envOverrides, \"PROCESS_MAX_RSS_BYTES\"))") &&
           !strings.StrContains(hostOpsText, "raw = strutil.Strip(os.GetEnv(\"PROCESS_MAX_RSS_BYTES\"))"),
           " backend driver resource guard: host ops has no legacy fallback")
    assert(strings.StrContains(hostOpsText, "HostOpsExitProcess"),
           " backend driver resource guard: hard exit")
    assert(strings.StrContains(hostOpsText, "let i: int32 = n - 1 - ri"),
           " backend driver resource guard: env override last wins")
    assert(strings.StrContains(hostOpsText, "resource_guard status=rss_limit_exceeded"),
           " backend driver resource guard: live diagnostic")
    assert(strings.StrContains(hostOpsText, "ProcessMemoryExceeded = 125"),
           " backend driver resource guard: memory exit code")

    assert(strings.StrContains(gateMainText, "CHENG_PROCESS_MAX_RSS_BYTES=805306368"),
           " backend driver resource guard: gate host smoke 1g theory hard gate")
    assert(!strings.StrContains(gateMainText, "CHENG_PROCESS_MAX_RSS_BYTES=34359738368"),
           " backend driver resource guard: gate host smoke no 32g cap")
    assert(strings.StrContains(hostSmokeGateText, "CHENG_PROCESS_MAX_RSS_BYTES=805306368"),
           " backend driver resource guard: host smoke 1g theory hard gate")
    assert(!strings.StrContains(hostSmokeGateText, "CHENG_PROCESS_MAX_RSS_BYTES=34359738368"),
           " backend driver resource guard: host smoke no 32g cap")
    assert(strings.StrContains(runtimeZeroSmokeText, "CHENG_PROCESS_MAX_RSS_BYTES=805306368"),
           " backend driver resource guard: runtime zero 1g theory hard gate")
    assert(!strings.StrContains(runtimeZeroSmokeText, "CHENG_PROCESS_MAX_RSS_BYTES=34359738368"),
           " backend driver resource guard: runtime zero no 32g cap")
    assert(strings.StrContains(kCensusText, "CHENG_CENSUS_MAX_RSS:-1073741824") &&
           strings.StrContains(kCensusText, "CHENG_CENSUS_PARALLEL:-0"),
           " backend driver resource guard: k census safe default")
    assert(!strings.StrContains(kCensusText, "CHENG_CENSUS_MAX_RSS:-34359738368"),
           " backend driver resource guard: k census no 32g default")
    assert(strings.StrContains(execDiffText, "CHENG_CENSUS_MAX_RSS:-1073741824"),
           " backend driver resource guard: exec diff safe rss default")
    assert(!strings.StrContains(execDiffText, "CHENG_CENSUS_MAX_RSS:-34359738368"),
           " backend driver resource guard: exec diff no 32g default")
    assert(!strings.StrContains(buildCdpModulesText, "CHENG_MAX_RSS_BYTES") &&
           strings.StrContains(buildCdpModulesText, "CHENG_PROCESS_MAX_RSS_BYTES:-805306368"),
           " backend driver resource guard: cdp build safe rss default")
    assert(strings.StrContains(diffFuzzText, "JOBS=\"${JOBS:-1}\"") &&
           strings.StrContains(diffFuzzText, "CHENG_PROCESS_MAX_RSS_BYTES:-805306368"),
           " backend driver resource guard: diff fuzz safe default")
    assert(!strings.StrContains(diffFuzzText, "JOBS=\"${JOBS:-4}\""),
           " backend driver resource guard: diff fuzz no parallel default")
    assert(strings.StrContains(abiFuzzText, "JOBS=\"${JOBS:-1}\"") &&
           strings.StrContains(abiFuzzText, "CHENG_PROCESS_MAX_RSS_BYTES:-805306368"),
           " backend driver resource guard: abi fuzz safe default")
    assert(!strings.StrContains(abiFuzzText, "JOBS=\"${JOBS:-4}\""),
           " backend driver resource guard: abi fuzz no parallel default")
    assert(strings.StrContains(hostRuntimeGapReportText, "BACKEND_JOBS=\"${BACKEND_JOBS:-1}\"") &&
           strings.StrContains(hostRuntimeGapReportText, "CHENG_PROCESS_MAX_RSS_BYTES:-805306368"),
           " backend driver resource guard: host runtime gap safe default")
    assert(!strings.StrContains(hostRuntimeGapReportText, "BACKEND_JOBS=\"${BACKEND_JOBS:-4}\""),
           " backend driver resource guard: host runtime gap no parallel default")
    assert(strings.StrContains(functionParallelBenchmarkText, "BACKEND_JOBS_N=\"${BACKEND_JOBS_N:-2}\"") &&
           strings.StrContains(functionParallelBenchmarkText, "ITERATIONS=\"${ITERATIONS:-1}\"") &&
           strings.StrContains(functionParallelBenchmarkText, "FIXTURE=\"${FIXTURE:-src/core/tooling/backend_driver_dispatch_min.cheng}\"") &&
           strings.StrContains(functionParallelBenchmarkText, "CHENG_PROCESS_MAX_RSS_BYTES:-805306368"),
           " backend driver resource guard: function benchmark safe default")
    assert(!strings.StrContains(functionParallelBenchmarkText, "BACKEND_JOBS_N=\"${BACKEND_JOBS_N:-4}\"") &&
           !strings.StrContains(functionParallelBenchmarkText, "ITERATIONS=\"${ITERATIONS:-3}\"") &&
           !strings.StrContains(functionParallelBenchmarkText, "FIXTURE=\"${FIXTURE:-src/core/backend/primary_object_plan.cheng}\""),
           " backend driver resource guard: function benchmark no heavy default")

    assert(strings.StrContains(systemLinkExecText, "SystemLinkExecProgressResourceGuardCheck"),
           " backend driver resource guard: system-link self guard")
    assert(strings.StrContains(systemLinkExecText, "SystemLinkExecDefaultMaxRssBytesText"),
           " backend driver resource guard: system-link default max rss helper")
    assert(strings.StrContains(systemLinkExecText, "return \"1073741824\""),
           " backend driver resource guard: system-link default 1g theory hard gate")
    assert(strings.StrContains(systemLinkExecText, "SystemLinkExecEnsureDefaultResourceGuard"),
           " backend driver resource guard: system-link default guard installer")
    assert(strings.StrContains(systemLinkExecText, "os.SetEnv(\"CHENG_PROCESS_MAX_RSS_BYTES\", SystemLinkExecDefaultMaxRssBytesText())"),
           " backend driver resource guard: system-link default child rss env")
    assert(strings.StrContains(systemLinkExecText, "hostops.HostOpsCurrentRssBytes"),
           " backend driver resource guard: system-link rss check")
    assert(strings.StrContains(systemLinkExecText, "hostops.HostOpsExitProcess(hostops.ProcessMemoryExceeded)"),
           " backend driver resource guard: system-link hard stop")

    assert(strings.StrContains(backendDriverDispatchMinText, "BackendDriverDispatchMinProgressResourceGuardCheck"),
           " backend driver resource guard: min driver self guard")
    assert(strings.StrContains(backendDriverDispatchMinText, "CHENG_PROCESS_MAX_RSS_BYTES"),
           " backend driver resource guard: min driver rss env")
    assert(strings.StrContains(backendDriverDispatchMinText, "os.GetEnv(\"CHENG_PROCESS_MAX_RSS_BYTES\")"),
           " backend driver resource guard: min driver reads canonical rss env")
    assert(strings.StrContains(
               backendDriverDispatchMinText,
               "strings.Len(os.GetEnv(\"PARENT_RSS_GUARD\")) > 0 ||") &&
           strings.StrContains(
               backendDriverDispatchMinText,
               "strings.Len(os.GetEnv(\"PROCESS_MAX_RSS_BYTES\")) > 0 ||") &&
           strings.StrContains(
               backendDriverDispatchMinText,
               "strings.Len(os.GetEnv(\"CHENG_MAX_RSS_BYTES\")) > 0 ||") &&
           strings.StrContains(
               backendDriverDispatchMinText,
               "strings.Len(os.GetEnv(\"MAX_RSS_BYTES\")) > 0:\n        return int64(-1)"),
           " backend driver resource guard: min driver rejects legacy rss env")
    assert(!strings.StrContains(backendDriverDispatchMinText, " PROCESS_MAX_RSS_BYTES=805306368"),
           " backend driver resource guard: min driver has no legacy rss assignment")
    assert(strings.StrContains(backendDriverDispatchMinText, "CHENG_PROGRESS=1"),
           " backend driver resource guard: min driver cheng progress env")
    assert(strings.StrContains(backendDriverDispatchMinText, "PROGRESS=1"),
           " backend driver resource guard: min driver legacy progress env")
    assert(strings.StrContains(backendDriverDispatchMinText, "os.GetEnv(\"CHENG_PROGRESS\")"),
           " backend driver resource guard: min driver reads canonical progress env")
    assert(strings.StrContains(backendDriverDispatchMinText, "os.GetEnv(\"PROGRESS\")"),
           " backend driver resource guard: min driver reads legacy progress env")
    assert(strings.StrContains(backendDriverDispatchMinText, "os.GetEnv(\"CHENG_PARENT_RSS_GUARD\")"),
           " backend driver resource guard: min driver reads canonical parent guard")
    assert(!strings.StrContains(backendDriverDispatchMinText, " PARENT_RSS_GUARD=1"),
           " backend driver resource guard: min driver has no legacy parent assignment")
    assert(!strings.StrContains(backendDriverDispatchMinText, "len(os.GetEnv(\"CHENG_PARENT_RSS_GUARD\"))"),
           " backend driver resource guard: min driver env guard uses stable shape")
    assert(strings.StrContains(backendDriverDispatchMinText, "BackendDriverDispatchMinDefaultMaxRssBytes"),
           " backend driver resource guard: min driver default max rss helper")
    assert(strings.StrContains(backendDriverDispatchMinText, "return int64(1073741824)"),
           " backend driver resource guard: min driver default 1g theory hard gate")
    assert(strings.StrContains(backendDriverDispatchMinText, "@importc(\"getrusage\")"),
           " backend driver resource guard: min driver direct rusage bridge")
    assert(!strings.StrContains(backendDriverDispatchMinText, "/bin/ps -p "),
           " backend driver resource guard: min driver no ps rss fallback")
    assert(strings.StrContains(backendDriverDispatchMinText, "BackendDriverDispatchMinResourceGuardCheckWithMax(maxRssBytes)"),
           " backend driver resource guard: min driver initial self guard")
    assert(strings.StrContains(backendDriverDispatchMinText, "if maxRssBytes == int64(0):\n        return"),
           " backend driver resource guard: min driver parent guard disables self cap")
    assert(!strings.StrContains(backendDriverDispatchMinText, "fn BackendDriverDispatchMinProgressResourceGuardCheck() =\n    return"),
           " backend driver resource guard: min driver progress guard is active")
    assert(strings.StrContains(backendDriverDispatchMinText, "BackendDriverDispatchMinCurrentRssBytes"),
           " backend driver resource guard: min driver current rss")
    assert(strings.StrContains(backendDriverDispatchMinText, "status=rss_limit_exceeded"),
           " backend driver resource guard: min driver rss diagnostic")
    assert(strings.StrContains(backendDriverDispatchMinText, "status=rss_unavailable"),
           " backend driver resource guard: min driver unavailable rss hard fail")
    assert(strings.StrContains(backendDriverDispatchMinText, "BackendDriverDispatchMinExitBridge(BackendDriverDispatchMinProcessMemoryExceeded)"),
           " backend driver resource guard: min driver hard stop")
    assert(strings.StrContains(backendDriverDispatchMinText, "BackendDriverDispatchMinProcessMemoryExceeded = 125"),
           " backend driver resource guard: min driver memory exit code")
    assert(strings.StrContains(backendDriverDispatchMinText, "BackendDriverDispatchMinForbidLargeClosureMaterialize"),
           " backend driver resource guard: min driver large closure policy")
    assert(strings.StrContains(backendDriverDispatchMinText, "forbidden_large_closure_materialize_entry"),
           " backend driver resource guard: forbidden large closure report")
    assert(strings.StrContains(backendDriverDispatchMinText, "BackendDriverDispatchMinPathIsCompilerMain"),
           " backend driver resource guard: compiler_main path detector")
    assert(strings.StrContains(systemLinkExecText, "fn SystemLinkExecAddCoreRuntimeRootIfNeeded(") &&
           strings.StrContains(systemLinkExecText, "fn SystemLinkExecCoreRuntimeExportRoots("),
           " backend driver resource guard: formal plan owns canonical provider-root selection")
    assert(strings.StrContains(systemLinkExecRuntimeText, "fn SystemLinkExecRuntimeAddCoreRuntimeRootIfNeeded(") &&
           strings.StrContains(systemLinkExecRuntimeText, "fn SystemLinkExecRuntimeProviderExportRootsInto("),
           " backend driver resource guard: formal runtime owns provider export roots")
    assert(strings.StrContains(systemLinkExecRuntimeText, "SystemLinkExecRuntimeAddPureCoreRuntimeBridgeRoots(out)"),
           " backend driver resource guard: core runtime roots include transitive pure bridges")
    assert(strings.StrContains(systemLinkExecText, "SystemLinkExecAddCoreRuntimeRootIfNeeded(linkPlan, primaryPlan, out, \"cheng_mobile_biometric_fingerprint_authorize_bridge_native\")") &&
           strings.StrContains(systemLinkExecRuntimeText, "SystemLinkExecRuntimeAddUniqueText(out, \"cheng_mobile_biometric_fingerprint_authorize_bridge_native\")"),
           " backend driver resource guard: biometric native bridge is planned and materialized")
    assert(strings.StrContains(systemLinkExecRuntimeText, "fn SystemLinkExecRuntimeAddBackendDriverHostRuntimeRoots(") &&
           strings.StrContains(systemLinkExecRuntimeText, "SystemLinkExecRuntimeAddBackendDriverHostRuntimeRoots(out)"),
           " backend driver resource guard: formal runtime owns backend-driver host roots")
    assert(strings.StrContains(systemLinkExecRuntimeText, "cheng_host_sysconf"),
           " backend driver resource guard: host sysconf rooted for core runtime")
    assert(strings.StrContains(systemLinkExecRuntimeText, "cheng_host_getentropy"),
           " backend driver resource guard: pure host runtime getentropy rooted")
    assert(strings.StrContains(systemLinkExecRuntimeText, "cheng_host_recvfrom"),
           " backend driver resource guard: pure host runtime recvfrom rooted")
    assert(strings.StrContains(systemLinkExecRuntimeText, "cheng_host_waitpid_runtime"),
           " backend driver resource guard: pure host runtime waitpid rooted")
    assert(strings.StrContains(systemLinkExecRuntimeText, "cheng_host_write_runtime"),
           " backend driver resource guard: pure host runtime write rooted")
    assert(strings.StrContains(systemLinkExecText, "SystemLinkExecAddCoreRuntimeRootIfNeeded(linkPlan, primaryPlan, out, \"cheng_native_sock_stream_bridge\")") &&
           strings.StrContains(systemLinkExecRuntimeText, "SystemLinkExecRuntimeAddUniqueText(out, \"cheng_native_sock_stream_bridge\")"),
           " backend driver resource guard: socket stream root keeps canonical symbol")
