type
    R21VEntry =
        profileIndex: int32
        prefix: str
        items: str[]

fn R21VAppend(out: var str[], prefix: str, name: str) =
    add(out, Fmt"{prefix}.{name}")

fn R21VNames(cache: var R21VEntry[], profileIndex: int32, prefix: str): str[] =
    var out: str[]
    if profileIndex < 0:
        return out
    if prefix == "":
        return out
    R21VAppend(out, prefix, "alpha")
    R21VAppend(out, prefix, "bravo")
    var entry: R21VEntry
    entry.profileIndex = profileIndex
    entry.prefix = prefix
    entry.items = share(out)
    add(cache, entry)
    return out

fn main(): int32 =
    var cache: R21VEntry[]
    let first = R21VNames(cache, 3, "pkg")
    if first.len != 2:
        return 10
    if first[0] != "pkg.alpha":
        return 11
    if first[1] != "pkg.bravo":
        return 12
    if cache.len != 1:
        return 13
    let cached = cache[0].items
    if cached.len != 2:
        return 14
    if cached[0] != "pkg.alpha":
        return 15
    if cached[1] != "pkg.bravo":
        return 16
    if cache[0].profileIndex != 3:
        return 17
    let empty = R21VNames(cache, -1, "pkg")
    if empty.len != 0:
        return 18
    let width = first[0].len + cached[1].len
    if width != 19:
        return 19
    echo(Fmt"tk_r21_share ok n={first.len} first={first[0]} cached={cached[1]} width={width}")
    return 0
