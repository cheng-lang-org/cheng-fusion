# T78 家族回归夹具 | 来源: cheng-patches/20260717/round12/T78_v3_adversarial_review/repros/adv_while_fixedsrc.cheng | 期望: RUNRC=4
fn main(): int32 =
    var arr: bool[4]
    arr[0] = true
    arr[1] = true
    arr[2] = true
    arr[3] = true
    var i: int32
    var count: int32
    i = 0
    count = 0
    while i < 4 && arr[i]:
        count = count + 1
        i = i + 1
    return count
