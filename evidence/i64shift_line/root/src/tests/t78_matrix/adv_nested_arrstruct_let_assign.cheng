# T78 家族回归夹具 | 来源: cheng-patches/20260717/round14/T78_v4_adversarial_review/repros/adv_nested_arrstruct_let_assign.cheng | 期望: RUNRC=0
# same shape but consumed via a plain `let` scalar binding (not a boolean
# condition) -- checks whether the v4 EvalNode fast-path regression is
# specific to condition-operand context or a general IndexGet defect.
type
    Elem =
        arr: bool[4]

fn main(): int32 =
    var xs: Elem[2]
    xs[0].arr[0] = false
    xs[0].arr[1] = false
    xs[0].arr[2] = false
    xs[0].arr[3] = false
    xs[1].arr[0] = false
    xs[1].arr[1] = false
    xs[1].arr[2] = false
    xs[1].arr[3] = false
    let v: bool = xs[0].arr[1]
    if v:
        return 1
    return 0
