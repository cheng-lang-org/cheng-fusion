# T78 家族回归夹具 | 来源: cheng-patches/20260717/round14/T78_v4_adversarial_review/repros/adv_struct_tail_array_oob.cheng | 期望: RUNRC=1
# adversarial: bool[N] array field placed LAST in struct (not first). If write
# uses aligned (4B) stride while the field's own tight allocation (1B/elem) is
# what determines the struct's total size, writing idx>=1 escapes the struct's
# OWN bounds entirely (not just into a sibling field) -- a stronger form of the
# already-disclosed cross-field corruption ("新发现" in v4 writeup), tested here
# via an adjacent canary local to detect any escape past s itself.
type
    TailBox =
        other: int32
        arr: bool[4]

fn main(): int32 =
    var s: TailBox
    var canary: int32
    canary = 12345
    s.other = 7
    s.arr[0] = true
    s.arr[1] = true
    s.arr[2] = true
    s.arr[3] = true
    return canary
