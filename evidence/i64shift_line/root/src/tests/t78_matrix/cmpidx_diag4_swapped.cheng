# T78 家族回归夹具 | 来源: cheng-patches/20260717/round12/T78_v3/repros/cmpidx_diag4_swapped.cheng | 期望: RUNRC=100
fn main(): int32 =
    var arr: bool[4]
    arr[0] = true
    arr[1] = true
    arr[2] = true
    arr[3] = true
    var i: int32 = 1
    var flags: bool[]
    add(flags, false)
    flags[0] = arr[i] && i < 4
    if flags[0]:
        return 100
    return 200
