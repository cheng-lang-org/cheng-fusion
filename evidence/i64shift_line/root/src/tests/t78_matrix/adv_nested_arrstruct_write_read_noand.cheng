# T78 家族回归夹具 | 来源: cheng-patches/20260717/round14/T78_v4_adversarial_review/repros/adv_nested_arrstruct_write_read_noand.cheng | 期望: RUNRC=0
type
    Elem =
        arr: bool[4]

fn main(): int32 =
    var xs: Elem[2]
    var k: int32
    k = 0
    xs[k].arr[0] = false
    xs[k].arr[1] = true
    xs[k].arr[2] = false
    xs[k].arr[3] = false
    var i: int32
    i = 1
    if xs[0].arr[i]:
        return 1
    return 0
