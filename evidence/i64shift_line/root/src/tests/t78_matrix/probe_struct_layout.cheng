type
    FlagBox =
        arr: bool[4]
        other: int32

fn main(): int32 =
    var s: FlagBox
    s.arr[0] = false
    s.arr[1] = false
    s.arr[2] = false
    s.arr[3] = false
    s.other = 777
    return s.other
