# T78 家族回归夹具 | 来源: cheng-patches/20260717/round14/T78_v4_adversarial_review/repros/adv_int8_field_array_noregress.cheng | 期望: RUNRC=1
# adversarial: struct field is int8[4], not bool[4]. TypeShapeFromText gives
# int8 aligned=1B (same as tight) so there should be NO elemSize divergence and
# v4's changes must be no-ops here (behavior identical baseline/v3/v4).
type
    Int8Box =
        arr: int8[4]
        other: int32

fn main(): int32 =
    var s: Int8Box
    s.arr[0] = 10
    s.arr[1] = 20
    s.arr[2] = 30
    s.arr[3] = 40
    var i: int32
    i = 2
    let v: int32 = int32(s.arr[i])
    if i < 4 && v == 30:
        return 1
    return 0
