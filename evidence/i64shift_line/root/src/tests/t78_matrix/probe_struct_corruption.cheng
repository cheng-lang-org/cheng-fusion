# T78 家族回归夹具 | 来源: cheng-patches/20260717/round14/T78_v4/repros/probe_struct_corruption.cheng | 期望: RUNRC=1
type
    FlagBox =
        arr: bool[4]
        other: int32

fn main(): int32 =
    var s: FlagBox
    s.other = 42
    s.arr[0] = true
    s.arr[1] = true
    s.arr[2] = true
    s.arr[3] = true
    return s.other
