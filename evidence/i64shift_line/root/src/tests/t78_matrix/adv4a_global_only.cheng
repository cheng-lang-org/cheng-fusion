# T78 家族回归夹具 | 来源: cheng-patches/20260717/round21/t78_v6_reverify/repros/adv4a_global_only.cheng | 期望: 诚实 bail BAIL=718(非缺陷, ZC_NOT_READY)
import std/system

type
    State =
        reachable: bool[]

var gResolved: bool

fn ResolveGlobal(state: var State, idx: int32): int32 =
    gResolved = idx < state.reachable.len && state.reachable[idx]
    if gResolved:
        return idx
    return -1

fn main(): int32 =
    var s: State
    add(s.reachable, true)
    add(s.reachable, true)
    add(s.reachable, false)

    let g1 = ResolveGlobal(s, 0)
    if g1 != 0:
        return 101
    let g2 = ResolveGlobal(s, 2)
    if g2 != -1:
        return 102
    let g3 = ResolveGlobal(s, 5)
    if g3 != -1:
        return 103
    return 0
