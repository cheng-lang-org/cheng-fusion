# T78 家族回归夹具 | 来源: cheng-patches/20260717/round21/t78_v6_reverify/repros/adv4b_field_only.cheng | 期望: RUNRC=0
import std/system

type
    State =
        reachable: bool[]
        ok: bool

fn ResolveField(state: var State, idx: int32): int32 =
    state.ok = idx < state.reachable.len && state.reachable[idx]
    if state.ok:
        return idx
    return -1

fn main(): int32 =
    var s: State
    add(s.reachable, true)
    add(s.reachable, true)
    add(s.reachable, false)

    let f1 = ResolveField(s, 0)
    if f1 != 0:
        return 111
    let f2 = ResolveField(s, 2)
    if f2 != -1:
        return 112
    let f3 = ResolveField(s, 5)
    if f3 != -1:
        return 113
    return 0
