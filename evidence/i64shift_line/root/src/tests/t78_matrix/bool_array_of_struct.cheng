type
    Item =
        flags: bool[4]
        id: int32

fn main(): int32 =
    var xs: Item[3]
    xs[0].id = 100
    xs[0].flags[0] = true
    xs[0].flags[1] = false
    xs[1].id = 200
    xs[1].flags[2] = true
    xs[1].flags[3] = false
    xs[2].id = 300
    xs[2].flags[0] = false
    xs[2].flags[1] = true
    if xs[0].id != 100:
        return 1
    if xs[1].id != 200:
        return 2
    if xs[2].id != 300:
        return 3
    var j2: int32
    j2 = 2
    let r0: bool = (j2 < 4 && xs[1].flags[j2])
    if !r0:
        return 4
    var j1: int32
    j1 = 1
    let r1: bool = (j1 < 4 && xs[2].flags[j1])
    if !r1:
        return 5
    return 0
