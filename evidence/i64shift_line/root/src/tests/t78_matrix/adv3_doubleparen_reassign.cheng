# T78 家族回归夹具 | 来源: cheng-patches/20260717/round21/t78_v6_reverify/repros/adv3_doubleparen_reassign.cheng | 期望: RUNRC=0
import std/system

type
    State =
        reachable: bool[]

fn ResolveIdx(state: var State, idx: int32): int32 =
    var resolved = true
    # 双括号包裹的纯量重赋值 (T78 v2 教训: 顶层 && 被括号盖住, 裸文本探测会漏判)
    resolved = ((idx < state.reachable.len && state.reachable[idx]))
    if resolved:
        return idx
    return -1

fn main(): int32 =
    var s: State
    add(s.reachable, true)
    add(s.reachable, true)
    add(s.reachable, false)
    let q1 = ResolveIdx(s, 0)
    if q1 != 0:
        return 101
    let q2 = ResolveIdx(s, 2)
    if q2 != -1:
        return 102
    # idx>=len 必须短路, 不越界读
    let q3 = ResolveIdx(s, 5)
    if q3 != -1:
        return 103
    return 0
