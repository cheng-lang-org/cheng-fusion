# T78 家族回归夹具 | 来源: cheng-patches/20260717/round12/T78_v3_adversarial_review/repros/adv_struct_field_arr_if.cheng | 期望: RUNRC=1
type
    FlagBox =
        arr: bool[4]
        other: int32

fn main(): int32 =
    var s: FlagBox
    s.arr[0] = false
    s.arr[1] = true
    s.arr[2] = false
    s.arr[3] = false
    var i: int32
    i = 1
    if i < 4 && s.arr[i]:
        return 1
    return 0
