# T78 家族回归夹具 | 来源: cheng-patches/20260717/round12/T78_v3/repros/cmpidx_fixedtarget_dynsrc.cheng | 期望: RUNRC=1
fn main(): int32 =
    var arr: bool[]
    add(arr, false)
    add(arr, true)
    add(arr, true)
    add(arr, false)
    var i: int32 = 1
    var flags: bool[2]
    flags[0] = i < 4 && arr[i]
    if flags[0]:
        return 1
    return 0
