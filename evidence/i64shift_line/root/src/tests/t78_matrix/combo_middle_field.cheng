# T78 家族回归夹具 | 来源: cheng-patches/20260717/round22/T147_rootfix_adversarial_review/repros/combo_middle_field.cheng | 期望: RUNRC=11
type
    Elem3 =
        pre: int32
        arr: bool[4]
        post: int32

fn main(): int32 =
    var xs: Elem3[2]
    xs[0].pre = 100
    xs[0].arr[0] = false
    xs[0].arr[1] = true
    xs[0].arr[2] = false
    xs[0].arr[3] = false
    xs[0].post = 200
    xs[1].pre = 300
    xs[1].arr[0] = true
    xs[1].arr[1] = false
    xs[1].arr[2] = true
    xs[1].arr[3] = false
    xs[1].post = 400
    var i0: int32
    var i1: int32
    i0 = 0
    i1 = 1
    var j1: int32
    var j2: int32
    j1 = 1
    j2 = 2
    # expect: xs[0].arr[1]=true, xs[1].arr[2]=true, pre/post unaffected
    if !xs[i0].arr[j1]:
        return 10
    if !xs[i1].arr[j2]:
        return 11
    if xs[i0].arr[j2]:
        return 12
    if xs[0].pre != 100:
        return 13
    if xs[0].post != 200:
        return 14
    if xs[1].pre != 300:
        return 15
    if xs[1].post != 400:
        return 16
    return 0
