fn SetVal(arr: var int8[], idx: int32, v: int8) =
    arr[idx] = v

fn main(): int32 =
    var arr: int8[]
    setLen(arr, 8)
    SetVal(arr, 0, 10)
    SetVal(arr, 1, 20)
    SetVal(arr, 2, 30)
    SetVal(arr, 3, 40)
    var total: int32
    for i in 0..<8:
        total = total + int32(arr[i])
    if total != 100:
        return 1
    return 0
