# T78 家族回归夹具 | 来源: cheng-patches/20260717/round22/T147_rootfix_adversarial_review/repros/combo_and_variants.cheng | 期望: RUNRC=3
type
    Elem =
        arr: bool[4]
        other: int32

fn main(): int32 =
    var xs: Elem[2]
    xs[0].arr[0] = false
    xs[0].arr[1] = true
    xs[0].arr[2] = false
    xs[0].arr[3] = false
    xs[0].other = 7
    xs[1].arr[0] = false
    xs[1].arr[1] = false
    xs[1].arr[2] = false
    xs[1].arr[3] = false
    xs[1].other = 8
    var i: int32
    var j: int32
    i = 0
    j = 1
    # D1: field first operand of &&
    if xs[i].arr[j] && i < 2:
        # ok
        var _noop1: int32
        _noop1 = 0
    else:
        return 1
    # D2: three-way chain, field in middle
    if i < 5 && xs[i].arr[j] && j < 5:
        var _noop2: int32
        _noop2 = 0
    else:
        return 2
    # D3: || with field
    if xs[i].arr[j] || false:
        var _noop3: int32
        _noop3 = 0
    else:
        return 3
    # D4: negation
    if !xs[i].arr[j]:
        return 4
    # D5: field is false, && should short circuit correctly (i=1 all false)
    i = 1
    if xs[i].arr[j] && i < 2:
        return 5
    # D6: || both false
    if xs[i].arr[j] || xs[i].arr[2]:
        return 6
    return 0
