# T78 家族回归夹具 | 来源: cheng-patches/20260717/round14/T78_v4/repros/probe_plain_assign.cheng | 期望: RUNRC=101
fn main(): int32 =
    var arr: bool[4]
    arr[0] = true
    arr[1] = false
    arr[2] = true
    arr[3] = false
    var s: int32
    if arr[0]:
        s = s + 1
    if arr[1]:
        s = s + 10
    if arr[2]:
        s = s + 100
    if arr[3]:
        s = s + 1000
    # expect: arr[0]=T,arr[1]=F,arr[2]=T,arr[3]=F -> s=1+100=101
    return s
