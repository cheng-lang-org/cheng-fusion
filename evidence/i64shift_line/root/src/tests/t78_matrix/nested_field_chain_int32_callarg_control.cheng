type
    Inner =
        nums: int32[]

type
    Outer =
        inner: Inner

fn identityI32(v: int32): int32 =
    return v

fn main(): int32 =
    let o = Outer(inner: Inner(nums: [1, 1, 1, 9]))
    var total = 0
    total = total + identityI32(o.inner.nums[0])
    total = total + identityI32(o.inner.nums[1])
    total = total + identityI32(o.inner.nums[2])
    total = total + identityI32(o.inner.nums[3])
    return total
