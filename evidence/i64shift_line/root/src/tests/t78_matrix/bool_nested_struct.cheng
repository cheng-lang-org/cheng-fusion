type
    Inner =
        flags: bool[4]
        tag: int32
    Outer =
        inner: Inner
        marker: int32

fn main(): int32 =
    var o: Outer
    o.marker = 5
    o.inner.tag = 6
    o.inner.flags[0] = true
    o.inner.flags[1] = false
    o.inner.flags[2] = true
    o.inner.flags[3] = false
    if o.marker != 5:
        return 1
    if o.inner.tag != 6:
        return 2
    var i2: int32
    i2 = 2
    let r2: bool = (i2 < 4 && o.inner.flags[i2])
    if !r2:
        return 3
    return 0
