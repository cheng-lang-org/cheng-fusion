fn main(): int32 =
    var grid: bool[][]
    var row0: bool[]
    add(row0, true)
    add(row0, false)
    add(row0, true)
    var row1: bool[]
    add(row1, false)
    add(row1, true)
    add(row1, true)
    add(grid, row0)
    add(grid, row1)
    var total = 0
    for row in grid:
        for v in row:
            if v:
                total = total + 1
    return total
