# T78 家族回归夹具 | 来源: cheng-patches/20260717/round22/T147_rootfix_adversarial_review/repros/combo_loop_all_cells.cheng | 期望: RUNRC=3
type
    Elem =
        arr: bool[4]
        other: int32

fn main(): int32 =
    var xs: Elem[3]
    var i: int32
    var j: int32
    i = 0
    while i < 3:
        j = 0
        while j < 4:
            xs[i].arr[j] = (i + j) % 2 == 0
            j = j + 1
        xs[i].other = i * 100
        i = i + 1
    i = 0
    while i < 3:
        j = 0
        while j < 4:
            let expect: bool = (i + j) % 2 == 0
            if xs[i].arr[j] != expect:
                return (i * 10 + j + 1)
            j = j + 1
        if xs[i].other != i * 100:
            return 99
        i = i + 1
    return 0
