type
    Box =
        arr: bool[4]
        other: int32

fn makeBox(): Box =
    var b: Box
    b.other = 42
    b.arr[0] = true
    b.arr[1] = false
    b.arr[2] = true
    b.arr[3] = false
    return b

fn main(): int32 =
    var i2: int32
    i2 = 2
    let r2: bool = makeBox().arr[i2]
    if !r2:
        return 1
    return 0
