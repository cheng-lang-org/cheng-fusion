# T78 家族回归夹具 | 来源: cheng-patches/20260717/round21/t78_v6_reverify/repros/adv1_threechain_and.cheng | 期望: RUNRC=0
import std/system

type
    State =
        reachable: bool[]

fn ThreeChain(state: var State, i: int32, j: int32): int32 =
    var r = true
    # 三链 a && b && c 纯量重赋值 (r 已声明, 非 decl-init)
    r = i >= 0 && i < state.reachable.len && state.reachable[i]
    if r:
        return 1
    return 0

fn main(): int32 =
    var s: State
    add(s.reachable, true)
    add(s.reachable, true)
    add(s.reachable, false)
    # Q1: i<0 短路于第一项, 不读 state.reachable
    let q1 = ThreeChain(s, -1, 0)
    if q1 != 0:
        return 101
    # Q2: i>=len 短路于第二项, 不越界读 state.reachable[i]
    let q2 = ThreeChain(s, 5, 0)
    if q2 != 0:
        return 102
    # Q3: i 合法且 reachable[i]=true -> r=true
    let q3 = ThreeChain(s, 0, 0)
    if q3 != 1:
        return 103
    # Q4: i 合法且 reachable[i]=false -> r=false
    let q4 = ThreeChain(s, 2, 0)
    if q4 != 0:
        return 104
    return 0
