# T78 家族回归夹具 | 来源: cheng-patches/20260717/round14/T78_v4_adversarial_review/repros/adv_dynseq_field_noregress.cheng | 期望: RUNRC=1
# adversarial: struct field is a DYNAMIC bool seq (not fixed array). v4's new
# `!fieldIsDynamicSeq` guards must NOT widen this to aligned stride -- dynamic
# seq bool packing is genuinely tight (1B) everywhere (T77 root fix), so any
# accidental override here would be a NEW regression introduced by v4.
type
    DynBox =
        arr: bool[]

fn main(): int32 =
    var s: DynBox
    add(s.arr, false)
    add(s.arr, true)
    add(s.arr, false)
    add(s.arr, true)
    var i: int32
    i = 1
    if i < s.arr.len && s.arr[i]:
        return 1
    return 0
