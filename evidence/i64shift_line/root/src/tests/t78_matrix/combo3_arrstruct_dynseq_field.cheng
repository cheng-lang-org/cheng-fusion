# T78 家族回归夹具 | 来源: cheng-patches/20260717/round17/T78_v5_adversarial_review/repros/combo3_arrstruct_dynseq_field.cheng | 期望: RUNRC=0
# combo attack #3: array-of-struct where the struct's field is a DYNAMIC seq
# (not fixed array): xs[i].dyn[j]. This is the array-of-struct analog of
# adv_dynseq_field_noregress -- checks the v5 guard (opKind allow-list on the
# FieldGet's own base) doesn't accidentally get bypassed or misfire for the
# dynamic-seq member-field case, since dynamic seq indexing goes through a
# different (buffer-indirect) codegen path than the fixed-array fast path
# entry#16 guards.
type
    Elem =
        dyn: bool[]

fn main(): int32 =
    var xs: Elem[2]
    add(xs[0].dyn, true)
    add(xs[0].dyn, false)
    add(xs[0].dyn, true)
    add(xs[0].dyn, false)
    add(xs[1].dyn, false)
    add(xs[1].dyn, true)
    add(xs[1].dyn, false)
    add(xs[1].dyn, true)
    var i: int32
    i = 0
    var j: int32
    j = 1
    # xs[0].dyn[1] was set false -> expect 0.
    if i < 2 && j < xs[i].dyn.len && xs[i].dyn[j]:
        return 1
    return 0
