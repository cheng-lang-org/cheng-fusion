# T78 家族回归夹具 | 来源: cheng-patches/20260717/round8/T78/lensB_regression_boundary/probes/cmpidx_isolate_cond.cheng | 期望: RUNRC=0
fn main(): int32 =
    var arr: bool[]
    var i: int32
    var flags: bool[]
    add(flags, true)
    let cond: bool = i < arr.len && arr[i]
    if cond:
        return 10
    flags[0] = cond
    if flags[0]:
        return 1
    return 0
