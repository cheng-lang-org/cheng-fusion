type
    Box32 =
        arr: int32[4]
        other: int32

fn makeBox32(): Box32 =
    var b: Box32
    b.other = 42
    b.arr[0] = 10
    b.arr[1] = 20
    b.arr[2] = 30
    b.arr[3] = 40
    return b

fn main(): int32 =
    var i2: int32
    i2 = 2
    let v2: int32 = makeBox32().arr[i2]
    if i2 < 4 && v2 != 30:
        return 1
    return 0
