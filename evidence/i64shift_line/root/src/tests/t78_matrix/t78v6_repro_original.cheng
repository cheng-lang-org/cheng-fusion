# T78 家族回归夹具 | 来源: cheng-patches/20260717/round21/t78_v6_reverify/repros/t78v6_repro_original.cheng | 期望: RUNRC=0
import std/system

type
    State =
        reachable: bool[]

fn ResolveIdx(state: var State, idx: int32, requireReachable: bool): int32 =
    var resolved = idx >= 0
    if resolved && requireReachable:
        resolved = idx < state.reachable.len && state.reachable[idx]
    if resolved:
        return idx
    return -1

fn main(): int32 =
    var s: State
    add(s.reachable, true)
    add(s.reachable, true)
    add(s.reachable, false)
    # Q1: idx<0 short-circuits at the first line, requireReachable ignored.
    let q1 = ResolveIdx(s, -1, true)
    if q1 != -1:
        return 101
    # Q2: requireReachable=false skips the reassignment entirely.
    let q2 = ResolveIdx(s, 2, false)
    if q2 != 2:
        return 102
    # Q3: idx<len true && reachable[idx] true -> resolved stays true.
    let q3 = ResolveIdx(s, 0, true)
    if q3 != 0:
        return 103
    # Q4: idx<len true && reachable[idx] false -> resolved becomes false.
    let q4 = ResolveIdx(s, 2, true)
    if q4 != -1:
        return 104
    # Q5: idx>=len must short-circuit BEFORE reading reachable[idx] (would be
    # an out-of-bounds read/crash if the `&&` were eagerly evaluated).
    let q5 = ResolveIdx(s, 5, true)
    if q5 != -1:
        return 105
    return 0
