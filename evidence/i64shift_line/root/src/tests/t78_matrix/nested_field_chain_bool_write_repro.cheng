type
    Inner =
        flags: bool[]

type
    Outer =
        inner: Inner

fn main(): int32 =
    var o = Outer(inner: Inner(flags: [false, false, false, false]))
    o.inner.flags[1] = true
    o.inner.flags[3] = true
    var total = 0
    for i in 0..<4:
        if o.inner.flags[i]:
            total = total + 1
    return total
