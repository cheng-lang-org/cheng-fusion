type Holder = (flags: bool[], tag: int32)

fn main(): int32 =
    var localFlags: bool[]
    add(localFlags, false)
    add(localFlags, false)
    add(localFlags, false)
    add(localFlags, false)
    add(localFlags, false)
    add(localFlags, false)
    var h: Holder
    h.flags = localFlags
    h.tag = 99
    h.flags[0] = true
    h.flags[1] = true
    h.flags[2] = true
    var total: int32
    for i in 0..<6:
        if h.flags[i]:
            total = total + 1
    if h.tag != 99:
        return 50
    if total != 3:
        return total
    return 0
