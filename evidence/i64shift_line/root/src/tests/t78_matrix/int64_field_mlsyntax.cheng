type
    Box64 =
        arr: int64[4]
        other: int32

fn main(): int32 =
    var s: Box64
    s.other = 33
    s.arr[0] = 100000
    s.arr[1] = 200000
    s.arr[2] = 300000
    s.arr[3] = 400000
    var i1: int32
    i1 = 1
    let v1: int64 = s.arr[i1]
    if i1 < 4 && v1 != 200000:
        return 61
    if s.other != 33:
        return 62
    return 49
