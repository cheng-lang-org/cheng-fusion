# T78 家族回归夹具 | 来源: cheng-patches/20260717/round17/T78_v5_adversarial_review/repros/combo4_arrstruct_write_target.cheng | 期望: RUNRC=0
# combo attack #4: xs[i].arr[j] used as a WRITE target with fully dynamic i/j
# (round14's task #10 "已知空白" -- write path AppendNestedFixedArrayIndexedFieldStore,
# untouched by v4/v5). This checks whether v5's read-side guard change has any
# interaction with the write path: write via dynamic index, then read back via
# the exact same dynamic-index expression (self read-after-write consistency),
# across all four (i,j) combinations of one struct slot.
type
    Elem =
        arr: bool[4]

fn main(): int32 =
    var xs: Elem[2]
    var i: int32
    var j: int32
    i = 0
    j = 0
    xs[i].arr[j] = true
    i = 0
    j = 1
    xs[i].arr[j] = false
    i = 0
    j = 2
    xs[i].arr[j] = true
    i = 0
    j = 3
    xs[i].arr[j] = false
    i = 1
    j = 0
    xs[i].arr[j] = false
    i = 1
    j = 1
    xs[i].arr[j] = true
    i = 1
    j = 2
    xs[i].arr[j] = false
    i = 1
    j = 3
    xs[i].arr[j] = true
    # read back xs[0].arr[1] (expect false=0) via dynamic index, same shape as write.
    i = 0
    j = 1
    if xs[i].arr[j]:
        return 1
    return 0
