type
    Box =
        arr: int32[4]
        other: int32

fn main(): int32 =
    var boxes: Box[]
    var b0: Box
    b0.other = 1
    b0.arr[0] = 100
    b0.arr[1] = 200
    b0.arr[2] = 300
    b0.arr[3] = 400
    add(boxes, b0)
    var b1: Box
    b1.other = 42
    b1.arr[0] = 10
    b1.arr[1] = 20
    b1.arr[2] = 30
    b1.arr[3] = 40
    add(boxes, b1)
    var i2: int32
    i2 = 2
    var k: int32
    k = 1
    let v2: int32 = boxes[k].arr[i2]
    if v2 != 30:
        return 1
    return 0
