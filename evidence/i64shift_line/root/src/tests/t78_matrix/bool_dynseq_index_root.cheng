type
    Box =
        arr: bool[4]
        other: int32

fn main(): int32 =
    var boxes: Box[]
    var b0: Box
    b0.other = 1
    b0.arr[0] = false
    b0.arr[1] = false
    b0.arr[2] = false
    b0.arr[3] = false
    add(boxes, b0)
    var b1: Box
    b1.other = 42
    b1.arr[0] = true
    b1.arr[1] = false
    b1.arr[2] = true
    b1.arr[3] = false
    add(boxes, b1)
    var i2: int32
    i2 = 2
    var k: int32
    k = 1
    let r2: bool = boxes[k].arr[i2]
    if !r2:
        return 1
    return 0
