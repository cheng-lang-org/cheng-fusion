# T78 家族回归夹具 | 来源: cheng-patches/20260717/round8/T78/lensB_regression_boundary/probes/cmpidx_2elem.cheng | 期望: RUNRC=2
fn main(): int32 =
    var arr: bool[]
    var i: int32
    var flags: bool[]
    add(flags, true)
    add(flags, true)
    flags[0] = i < arr.len && arr[i]
    var r: int32
    r = 0
    if flags[0]:
        r = r + 1
    if flags[1]:
        r = r + 2
    return r
