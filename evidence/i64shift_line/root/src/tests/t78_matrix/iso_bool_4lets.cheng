# T78 家族回归夹具 | 来源: cheng-patches/20260717/round22/T147_rootfix_adversarial_review/repros/iso_bool_4lets.cheng | 期望: RUNRC=1
type
    Elem =
        arr: bool[4]
        other: int32

fn main(): int32 =
    var xs: Elem[2]
    xs[0].arr[0] = false
    xs[0].arr[1] = true
    xs[0].arr[2] = false
    xs[0].arr[3] = false
    xs[0].other = 999
    let v0: bool = xs[0].arr[0]
    let v1: bool = xs[0].arr[1]
    let v2: bool = xs[0].arr[2]
    let v3: bool = xs[0].arr[3]
    if v0:
        return 1
    if !v1:
        return 2
    if v2:
        return 3
    if v3:
        return 4
    return 0
