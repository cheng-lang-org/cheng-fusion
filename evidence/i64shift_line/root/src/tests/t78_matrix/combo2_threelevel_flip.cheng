# T78 家族回归夹具 | 来源: cheng-patches/20260717/round17/T78_v5_adversarial_review/repros/combo2_threelevel_flip.cheng | 期望: 诚实 bail BAIL=6102(非缺陷, ZC_NOT_READY)
# flip of combo2: s.t[0].arr[1] now TRUE.
type
    Elem =
        arr: bool[4]

type
    Outer =
        t: Elem[2]
        other: int32

fn main(): int32 =
    var s: Outer
    var i: int32
    i = 0
    s.t[i].arr[0] = false
    s.t[i].arr[1] = true
    s.t[i].arr[2] = false
    s.t[i].arr[3] = true
    i = 1
    s.t[i].arr[0] = true
    s.t[i].arr[1] = false
    s.t[i].arr[2] = true
    s.t[i].arr[3] = false
    i = 0
    var j: int32
    j = 1
    # s.t[0].arr[1] was set true -> expect 1.
    if s.t[i].arr[j]:
        return 1
    return 0
