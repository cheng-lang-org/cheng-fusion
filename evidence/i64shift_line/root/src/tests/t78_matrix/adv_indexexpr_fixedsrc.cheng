# T78 家族回归夹具 | 来源: cheng-patches/20260717/round12/T78_v3_adversarial_review/repros/adv_indexexpr_fixedsrc.cheng | 期望: RUNRC=1
fn main(): int32 =
    var arr: bool[4]
    arr[0] = false
    arr[1] = false
    arr[2] = true
    arr[3] = false
    var j: int32 = 1
    let r: bool = (j + 1 < 4 && arr[j + 1])
    if r:
        return 1
    return 0
