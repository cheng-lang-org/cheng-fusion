# T78 家族回归夹具 | 来源: cheng-patches/20260717/round21/t78_v6_reverify/repros/adv2_or_reassign.cheng | 期望: RUNRC=0
import std/system

type
    State =
        reachable: bool[]

fn OrForm(state: var State, idx: int32): int32 =
    var flag = false
    # || 形纯量重赋值: idx>=len 短路为 true, 不越界读 state.reachable[idx]
    flag = idx >= state.reachable.len || state.reachable[idx]
    if flag:
        return 1
    return 0

fn main(): int32 =
    var s: State
    add(s.reachable, true)
    add(s.reachable, false)
    add(s.reachable, false)
    # Q1: idx>=len 短路(不崩溃) -> true
    let q1 = OrForm(s, 5)
    if q1 != 1:
        return 101
    # Q2: idx<len, 必须求值第二项; reachable[0]=true -> true
    let q2 = OrForm(s, 0)
    if q2 != 1:
        return 102
    # Q3: idx<len, reachable[1]=false, 第一项也 false -> false
    let q3 = OrForm(s, 1)
    if q3 != 0:
        return 103
    return 0
