# T78 家族回归夹具 | 来源: cheng-patches/20260717/round12/T78_v3/repros/nested_dotted_andor.cheng | 期望: RUNRC=1
fn main(): int32 =
    var arr: bool[]
    var i: int32
    add(arr, true)
    add(arr, false)
    i = 0
    let r: bool = ((i < arr.len && arr[i]) || (i < 0 && arr[i]))
    if r:
        return 1
    return 0
