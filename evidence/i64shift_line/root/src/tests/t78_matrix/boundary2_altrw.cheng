fn main(): int32 =
    var flags: bool[]
    setLen(flags, 6)
    var i = 0
    while i < 6:
        flags[i] = (i % 2) == 0
        i = i + 1
    var total = 0
    i = 0
    while i < 6:
        if flags[i]:
            total = total + 1
        flags[i] = !flags[i]
        i = i + 1
    var total2 = 0
    for i2 in 0..<6:
        if flags[i2]:
            total2 = total2 + 1
    if total != 3:
        return 100 + total
    if total2 != 3:
        return 200 + total2
    return 0
