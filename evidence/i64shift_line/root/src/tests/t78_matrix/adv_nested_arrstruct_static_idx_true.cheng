# T78 家族回归夹具 | 来源: cheng-patches/20260717/round14/T78_v4_adversarial_review/repros/adv_nested_arrstruct_static_idx_true.cheng | 期望: RUNRC=0
# same fully-static shape, but xs[0].arr[1]=TRUE this time -- checks whether
# baseline/v3 can EVER observe a true value here (rules out "baseline is also
# just a constant-false stub").
type
    Elem =
        arr: bool[4]

fn main(): int32 =
    var xs: Elem[2]
    xs[0].arr[0] = false
    xs[0].arr[1] = true
    xs[0].arr[2] = false
    xs[0].arr[3] = false
    xs[1].arr[0] = false
    xs[1].arr[1] = false
    xs[1].arr[2] = false
    xs[1].arr[3] = false
    if xs[0].arr[1]:
        return 1
    return 0
