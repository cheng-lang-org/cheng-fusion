fn make_int32_row(a: int32, b: int32, c: int32, d: int32): int32[] =
    var row: int32[]
    add(row, a)
    add(row, b)
    add(row, c)
    add(row, d)
    return row

fn main(): int32 =
    var grid: int32[][]
    setLen(grid, 2)
    let r0 = make_int32_row(1, 1, 1, 1)
    grid[0] = r0
    grid[0][1] = 9
    var total = 0
    for i in 0..<4:
        total = total + grid[0][i]
    return total
