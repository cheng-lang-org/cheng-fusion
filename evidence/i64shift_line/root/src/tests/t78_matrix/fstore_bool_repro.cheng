# T78 家族回归夹具 | 来源: cheng-patches/20260717/round6/T78/fixtures/fstore_bool_repro.cheng | 期望: RUNRC=0
type S =
    flag: bool

fn main(): int32 =
    var arr: bool[]
    var i: int32
    var xs: S[]
    var s0: S
    s0.flag = false
    add(xs, s0)
    xs[0].flag = i < arr.len && arr[i]
    if xs[0].flag:
        return 1
    return 0
