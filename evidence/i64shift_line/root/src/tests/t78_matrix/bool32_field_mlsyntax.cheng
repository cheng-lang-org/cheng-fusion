type
    Box32Bool =
        arr: bool[32]
        other: int32

fn main(): int32 =
    var s: Box32Bool
    s.other = 200
    var k: int32
    k = 0
    while k < 32:
        s.arr[k] = (k == 31)
        k = k + 1
    var i31: int32
    i31 = 31
    let r31: bool = (i31 < 32 && s.arr[i31])
    if !r31:
        return 1
    if s.other != 200:
        return 2
    return 0
