type
    Box =
        arr: bool[4]
        other: int32

fn makeBox(): Box =
    var b: Box
    b.other = 42
    b.arr[0] = true
    b.arr[1] = false
    b.arr[2] = true
    b.arr[3] = false
    return b

fn main(): int32 =
    var i2: int32
    i2 = 2
    if makeBox().arr[i2]:
        return 0
    return 1
