fn make_bool_row(a: bool, b: bool, c: bool, d: bool): bool[] =
    var row: bool[]
    add(row, a)
    add(row, b)
    add(row, c)
    add(row, d)
    return row

fn main(): int32 =
    var grid: bool[][]
    setLen(grid, 2)
    let r0 = make_bool_row(true, true, true, true)
    grid[0] = r0
    grid[0][1] = false
    var total = 0
    for i in 0..<4:
        if grid[0][i]:
            total = total + 1
    return total
