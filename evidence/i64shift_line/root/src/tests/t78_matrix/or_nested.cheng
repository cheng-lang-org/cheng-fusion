# T78 家族回归夹具 | 来源: cheng-patches/20260717/round8/T78/lensB_regression_boundary/probes/or_nested.cheng | 期望: RUNRC=1
fn main(): int32 =
    var arr: bool[]
    var i: int32
    var j: int32
    j = 5
    # (A||B)&&C: A=false(i<arr.len false on empty arr), B=arr[i] would fault
    # if eagerly evaluated but must be skipped since whole (A||B) is
    # protected by needing C anyway; C = j==5 true.
    # Expect: (i<arr.len || arr[i]) is false||fault-avoided = false (arr empty,
    # both A and B should be false: A is false, B (arr[i]) must NOT be
    # evaluated eagerly when unguarded -- but here OR means if A is false we
    # MUST evaluate B. Since arr is empty this would fault under any
    # correct semantics too (real short-circuit || also evaluates arr[i]
    # when A is false). So use i explicitly out of range only reachable if
    # A is true to test the &&/|| bail boundary safely.
    if (true || arr[i]) && j == 5:
        return 1
    return 0
