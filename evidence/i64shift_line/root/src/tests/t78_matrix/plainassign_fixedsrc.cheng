# T78 家族回归夹具 | 来源: cheng-patches/20260717/round12/T78_v3/repros/plainassign_fixedsrc.cheng | 期望: RUNRC=1
fn main(): int32 =
    var arr: bool[4]
    arr[0] = true
    arr[1] = true
    arr[2] = true
    arr[3] = true
    var i: int32 = 1
    var flag: bool
    flag = i < 4 && arr[i]
    if flag:
        return 1
    return 0
