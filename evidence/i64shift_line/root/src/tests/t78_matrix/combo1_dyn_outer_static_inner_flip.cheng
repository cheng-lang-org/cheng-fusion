# T78 家族回归夹具 | 来源: cheng-patches/20260717/round17/T78_v5_adversarial_review/repros/combo1_dyn_outer_static_inner_flip.cheng | 期望: RUNRC=0
# dual-direction flip of combo1_dyn_outer_static_inner: now xs[0].arr[1]=TRUE.
type
    Elem =
        arr: bool[4]

fn main(): int32 =
    var xs: Elem[2]
    var k: int32
    k = 0
    xs[k].arr[0] = false
    xs[k].arr[1] = true
    xs[k].arr[2] = false
    xs[k].arr[3] = true
    k = 1
    xs[k].arr[0] = true
    xs[k].arr[1] = false
    xs[k].arr[2] = true
    xs[k].arr[3] = false
    k = 0
    # xs[0].arr[1] was set true -> expect 1.
    if xs[k].arr[1]:
        return 1
    return 0
