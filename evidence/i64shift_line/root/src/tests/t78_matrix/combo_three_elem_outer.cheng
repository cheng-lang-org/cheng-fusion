# T78 家族回归夹具 | 来源: cheng-patches/20260717/round22/T147_rootfix_adversarial_review/repros/combo_three_elem_outer.cheng | 期望: RUNRC=1
type
    Elem =
        arr: bool[4]
        other: int32

fn main(): int32 =
    var xs: Elem[3]
    xs[0].arr[0] = false
    xs[0].arr[1] = false
    xs[0].arr[2] = false
    xs[0].arr[3] = false
    xs[0].other = 1
    xs[1].arr[0] = false
    xs[1].arr[1] = false
    xs[1].arr[2] = false
    xs[1].arr[3] = false
    xs[1].other = 2
    xs[2].arr[0] = true
    xs[2].arr[1] = false
    xs[2].arr[2] = true
    xs[2].arr[3] = false
    xs[2].other = 3
    var i: int32
    i = 2
    var j: int32
    j = 0
    if !xs[i].arr[j]:
        return 1
    j = 1
    if xs[i].arr[j]:
        return 2
    j = 2
    if !xs[i].arr[j]:
        return 3
    j = 3
    if xs[i].arr[j]:
        return 4
    if xs[2].other != 3:
        return 5
    if xs[0].other != 1:
        return 6
    if xs[1].other != 2:
        return 7
    return 0
