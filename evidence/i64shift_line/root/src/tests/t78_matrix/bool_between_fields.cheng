type
    Mixed =
        pre: int32
        arr: bool[4]
        post: int32

fn main(): int32 =
    var s: Mixed
    s.pre = 11
    s.post = 22
    s.arr[0] = true
    s.arr[1] = true
    s.arr[2] = true
    s.arr[3] = true
    if s.pre != 11:
        return 1
    if s.post != 22:
        return 2
    var i3: int32
    i3 = 3
    let r3: bool = (i3 < 4 && s.arr[i3])
    if !r3:
        return 3
    return 0
