# T78 家族回归夹具 | 来源: cheng-patches/20260717/round6/T78/fixtures/truth_table_repro.cheng | 期望: RUNRC=0
fn main(): int32 =
    var arr: bool[]
    add(arr, true)
    add(arr, false)
    var lhsList: bool[]
    add(lhsList, true)
    add(lhsList, false)
    if !(lhsList[0] && arr[0]):
        return 1
    if lhsList[0] && arr[1]:
        return 2
    if lhsList[1] && arr[0]:
        return 3
    if lhsList[1] && arr[1]:
        return 4
    if !(lhsList[0] || arr[0]):
        return 5
    if !(lhsList[0] || arr[1]):
        return 6
    if !(lhsList[1] || arr[0]):
        return 7
    if lhsList[1] || arr[1]:
        return 8
    return 0
