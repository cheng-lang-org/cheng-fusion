# T78 家族回归夹具 | 来源: cheng-patches/20260717/round14/T78_v4_adversarial_review/repros/adv_int16_field_array_noregress.cheng | 期望: RUNRC=1
type
    Int16Box =
        arr: int16[4]
        other: int32

fn main(): int32 =
    var s: Int16Box
    s.arr[0] = 100
    s.arr[1] = 200
    s.arr[2] = 300
    s.arr[3] = 400
    var i: int32
    i = 2
    let v: int32 = int32(s.arr[i])
    if i < 4 && v == 300:
        return 1
    return 0
