type
    Inner =
        flags: bool[]

type
    Outer =
        inner: Inner

fn checkFlag(v: bool): int32 =
    if v:
        return 1
    return 0

fn main(): int32 =
    let o = Outer(inner: Inner(flags: [true, false, true, true]))
    var total = 0
    total = total + checkFlag(o.inner.flags[0])
    total = total + checkFlag(o.inner.flags[1])
    total = total + checkFlag(o.inner.flags[2])
    total = total + checkFlag(o.inner.flags[3])
    return total
