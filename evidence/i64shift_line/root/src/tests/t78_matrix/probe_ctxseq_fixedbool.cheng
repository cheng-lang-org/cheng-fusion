# T78 家族回归夹具 | 来源: cheng-patches/20260717/round14/T78_v4/repros/probe_ctxseq_fixedbool.cheng | 期望: RUNRC=1
fn main(): int32 =
    var arr: bool[4]
    arr[0] = false
    arr[1] = true
    arr[2] = false
    arr[3] = true
    var i: int32
    i = 1
    var j: int32
    j = 2
    # arithmetic BinOp context operand (not a condition leaf): forces
    # ContextScalarValueSlotForText -> ContextSeqIndexedScalarValueSlot.
    let x: int32 = int32(arr[i]) + int32(arr[j]) * 10
    return x
