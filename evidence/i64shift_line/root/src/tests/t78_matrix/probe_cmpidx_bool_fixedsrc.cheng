# T78 家族回归夹具 | 来源: cheng-patches/20260717/round14/T78_v4/repros/probe_cmpidx_bool_fixedsrc.cheng | 期望: RUNRC=87
fn main(): int32 =
    var flags: bool[4]
    var a: int32
    var b: int32
    a = 5
    b = 3
    flags[0] = a > b
    flags[1] = a > b
    flags[2] = a > b
    flags[3] = a > b
    var s: int32
    if flags[0]:
        s = s + 1
    if flags[1]:
        s = s + 10
    if flags[2]:
        s = s + 100
    if flags[3]:
        s = s + 1000
    # a>b is true, all set -> s=1111
    return s
