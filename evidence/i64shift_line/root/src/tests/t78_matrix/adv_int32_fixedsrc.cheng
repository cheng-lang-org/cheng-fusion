# T78 家族回归夹具 | 来源: cheng-patches/20260717/round12/T78_v3_adversarial_review/repros/adv_int32_fixedsrc.cheng | 期望: RUNRC=1
fn main(): int32 =
    var arr: int32[4]
    arr[0] = 10
    arr[1] = 20
    arr[2] = 30
    arr[3] = 40
    var i: int32 = 1
    let r: bool = (i < 4 && arr[i] > 0)
    if r:
        return 1
    return 0
