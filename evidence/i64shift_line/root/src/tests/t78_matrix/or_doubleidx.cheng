# T78 家族回归夹具 | 来源: cheng-patches/20260717/round8/T78/lensB_regression_boundary/probes/or_doubleidx.cheng | 期望: RUNRC=1
fn main(): int32 =
    var arr: bool[]
    var brr: bool[]
    var i: int32
    var j: int32
    i = 0
    j = 0
    # arr and brr both empty: arr[i] || brr[j] would OOB on eager eval of
    # either side (arr empty makes arr[i] itself already OOB, forcing a
    # real language-level guard upstream is not present here since || does
    # not skip evaluating LHS -- LHS is always evaluated in real
    # short-circuit too). So guard both with length checks that make LHS
    # true via i<arr.len after seeding one true element in arr, and keep
    # brr empty + unreachable (must be skipped because LHS true).
    add(arr, true)
    if (i < arr.len && arr[i]) || (j < brr.len && brr[j]):
        return 1
    return 0
