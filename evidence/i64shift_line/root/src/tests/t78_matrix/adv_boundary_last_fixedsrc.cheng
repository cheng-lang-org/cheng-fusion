# T78 家族回归夹具 | 来源: cheng-patches/20260717/round12/T78_v3_adversarial_review/repros/adv_boundary_last_fixedsrc.cheng | 期望: RUNRC=1
fn main(): int32 =
    var arr: bool[4]
    arr[0] = false
    arr[1] = false
    arr[2] = false
    arr[3] = true
    var i: int32 = 3
    let r: bool = (i < 4 && arr[i])
    if r:
        return 1
    return 0
