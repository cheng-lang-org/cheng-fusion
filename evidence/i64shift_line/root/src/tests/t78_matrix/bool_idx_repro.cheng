fn MarkTrue(flags: var bool[], idx: int32) =
    flags[idx] = true

fn main(): int32 =
    var flags: bool[]
    setLen(flags, 8)
    MarkTrue(flags, 0)
    MarkTrue(flags, 1)
    MarkTrue(flags, 2)
    MarkTrue(flags, 3)
    var total = 0
    for i in 0..<flags.len:
        if flags[i]:
            total = total + 1
    return total
