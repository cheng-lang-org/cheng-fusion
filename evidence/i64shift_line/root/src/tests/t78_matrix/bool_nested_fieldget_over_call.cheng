type
    Inner =
        arr: bool[4]
        other: int32
    Outer =
        inner: Inner
        tag: int32

fn makeOuter(): Outer =
    var o: Outer
    o.tag = 9
    o.inner.other = 42
    o.inner.arr[0] = true
    o.inner.arr[1] = false
    o.inner.arr[2] = true
    o.inner.arr[3] = false
    return o

fn main(): int32 =
    var i2: int32
    i2 = 2
    let r2: bool = makeOuter().inner.arr[i2]
    if !r2:
        return 1
    return 0
