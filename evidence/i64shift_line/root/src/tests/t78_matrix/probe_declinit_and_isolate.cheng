# T78 家族回归夹具 | 来源: cheng-patches/20260717/round14/T78_v4/repros/probe_declinit_and_isolate.cheng | 期望: RUNRC=1
type
    FlagBox =
        arr: bool[4]
        other: int32

fn main(): int32 =
    var s: FlagBox
    s.arr[1] = true
    var i: int32 = 1
    let r: bool = (i < 4 && s.arr[i])
    if r:
        return 1
    return 0
