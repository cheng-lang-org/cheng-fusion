type
    Box32 =
        arr: int32[4]
        other: int32

fn main(): int32 =
    var s: Box32
    s.other = 55
    s.arr[0] = 1000
    s.arr[1] = 2000
    s.arr[2] = 3000
    s.arr[3] = 4000
    var i1: int32
    i1 = 1
    let v1: int32 = s.arr[i1]
    if i1 < 4 && v1 != 2000:
        return 51
    if s.other != 55:
        return 52
    return 48
