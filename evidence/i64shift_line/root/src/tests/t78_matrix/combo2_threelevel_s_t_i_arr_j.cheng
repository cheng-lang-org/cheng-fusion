# T78 家族回归夹具 | 来源: cheng-patches/20260717/round17/T78_v5_adversarial_review/repros/combo2_threelevel_s_t_i_arr_j.cheng | 期望: 诚实 bail BAIL=6102(非缺陷, ZC_NOT_READY)
# combo attack #2: three-level nesting s.t[i].arr[j] -- struct s has a field
# t that is itself an array-of-struct (Elem[2]), and Elem has a fixed bool[4]
# field arr. This is deeper than the array-of-struct xs[i].arr[j] REFUTED
# shape: the array-of-struct here is reached through an outer struct FIELD
# (s.t) rather than being a bare local. Tests whether the idxBaseFieldRootKind
# guard (checking the base of the FieldGet's own operand0) still correctly
# identifies s.t[i] (an IndexGet) as non-simple and falls through to the
# safe path, rather than being fooled by the extra FieldGet wrapper.
type
    Elem =
        arr: bool[4]

type
    Outer =
        t: Elem[2]
        other: int32

fn main(): int32 =
    var s: Outer
    var i: int32
    i = 0
    s.t[i].arr[0] = true
    s.t[i].arr[1] = false
    s.t[i].arr[2] = true
    s.t[i].arr[3] = false
    i = 1
    s.t[i].arr[0] = false
    s.t[i].arr[1] = true
    s.t[i].arr[2] = false
    s.t[i].arr[3] = true
    i = 0
    var j: int32
    j = 1
    # s.t[0].arr[1] was set false -> expect 0.
    if s.t[i].arr[j]:
        return 1
    return 0
