# T78 家族回归夹具 | 来源: cheng-patches/20260717/round22/T147_rootfix_adversarial_review/repros/combo_dual_dynamic.cheng | 期望: RUNRC=10
type
    Elem =
        arr: bool[4]
        other: int32

fn main(): int32 =
    var xs: Elem[2]
    var i: int32
    var j: int32
    i = 0
    xs[i].arr[0] = false
    xs[i].arr[1] = true
    xs[i].arr[2] = false
    xs[i].arr[3] = true
    xs[i].other = 1
    i = 1
    xs[i].arr[0] = true
    xs[i].arr[1] = false
    xs[i].arr[2] = true
    xs[i].arr[3] = false
    xs[i].other = 2
    # dynamic-dynamic read: both i and j come from arithmetic, not literal
    var a: int32
    var b: int32
    a = 3
    b = 1
    i = a - 3
    j = b + 1
    # i=0, j=2 -> expect false
    if xs[i].arr[j]:
        return 10
    i = a - 2
    j = b + 2
    # i=1, j=3 -> expect false
    if xs[i].arr[j]:
        return 11
    i = a - 3
    j = b
    # i=0, j=1 -> expect true
    if !xs[i].arr[j]:
        return 12
    i = a - 2
    j = b - 1
    # i=1, j=0 -> expect true
    if !xs[i].arr[j]:
        return 13
    return 0
