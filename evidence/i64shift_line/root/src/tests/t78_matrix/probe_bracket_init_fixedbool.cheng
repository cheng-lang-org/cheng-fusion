# T78 家族回归夹具 | 来源: cheng-patches/20260717/round14/T78_v4/repros/probe_bracket_init_fixedbool.cheng | 期望: RUNRC=87
fn main(): int32 =
    var arr: bool[4] = [false, true, false, true]
    var s: int32
    if arr[0]:
        s = s + 1
    if arr[1]:
        s = s + 10
    if arr[2]:
        s = s + 100
    if arr[3]:
        s = s + 1000
    # arr=[F,T,F,T] -> s=10+1000=1010
    return s
