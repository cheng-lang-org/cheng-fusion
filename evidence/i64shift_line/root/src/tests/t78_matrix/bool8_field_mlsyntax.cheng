type
    Box8Bool =
        arr: bool[8]
        other: int32

fn main(): int32 =
    var s: Box8Bool
    s.other = 99
    s.arr[0] = false
    s.arr[1] = true
    s.arr[2] = false
    s.arr[3] = true
    s.arr[4] = false
    s.arr[5] = true
    s.arr[6] = false
    s.arr[7] = true
    var i7: int32
    i7 = 7
    let r7: bool = (i7 < 8 && s.arr[i7])
    if !r7:
        return 1
    if s.other != 99:
        return 2
    return 0
