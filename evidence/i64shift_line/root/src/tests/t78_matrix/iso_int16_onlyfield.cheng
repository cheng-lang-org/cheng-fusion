# T78 家族回归夹具 | 来源: cheng-patches/20260717/round22/T147_rootfix_adversarial_review/repros/iso_int16_onlyfield.cheng | 期望: RUNRC=2
type
    ElemI16Only =
        arr: int16[4]

fn main(): int32 =
    var xs: ElemI16Only[2]
    xs[0].arr[0] = 11
    xs[0].arr[1] = 22
    xs[0].arr[2] = 33
    xs[0].arr[3] = 44
    let v0: int16 = xs[0].arr[0]
    let v1: int16 = xs[0].arr[1]
    let v2: int16 = xs[0].arr[2]
    let v3: int16 = xs[0].arr[3]
    if v0 != 11:
        return 1
    if v1 != 22:
        return 2
    if v2 != 33:
        return 3
    if v3 != 44:
        return 4
    return 0
