# T78 家族回归夹具 | 来源: cheng-patches/20260717/round21/t78_v6_reverify/repros/adv4_global_field_not_swallowed.cheng | 期望: 诚实 bail BAIL=718(非缺陷, ZC_NOT_READY)
import std/system

type
    State =
        reachable: bool[]
        ok: bool

var gResolved: bool

fn ResolveGlobal(state: var State, idx: int32): int32 =
    # global 目标重赋值(assignRootGlobalFlag=true), 不应被 v6 门吞掉, 必须走原有逻辑
    # 且仍要正确短路(不越界读)
    gResolved = idx < state.reachable.len && state.reachable[idx]
    if gResolved:
        return idx
    return -1

fn ResolveField(state: var State, idx: int32): int32 =
    # field 目标重赋值(assignFieldName != ""), 不应被 v6 门吞掉
    state.ok = idx < state.reachable.len && state.reachable[idx]
    if state.ok:
        return idx
    return -1

fn main(): int32 =
    var s: State
    add(s.reachable, true)
    add(s.reachable, true)
    add(s.reachable, false)

    let g1 = ResolveGlobal(s, 0)
    if g1 != 0:
        return 101
    let g2 = ResolveGlobal(s, 2)
    if g2 != -1:
        return 102
    let g3 = ResolveGlobal(s, 5)
    if g3 != -1:
        return 103

    let f1 = ResolveField(s, 0)
    if f1 != 0:
        return 111
    let f2 = ResolveField(s, 2)
    if f2 != -1:
        return 112
    let f3 = ResolveField(s, 5)
    if f3 != -1:
        return 113

    return 0
