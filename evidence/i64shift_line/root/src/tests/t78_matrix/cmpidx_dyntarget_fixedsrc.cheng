# T78 家族回归夹具 | 来源: cheng-patches/20260717/round12/T78_v3/repros/cmpidx_dyntarget_fixedsrc.cheng | 期望: RUNRC=1
fn main(): int32 =
    var arr: bool[4]
    arr[0] = false
    arr[1] = true
    arr[2] = true
    arr[3] = false
    var i: int32 = 1
    var flags: bool[]
    add(flags, false)
    flags[0] = i < 4 && arr[i]
    if flags[0]:
        return 1
    return 0
