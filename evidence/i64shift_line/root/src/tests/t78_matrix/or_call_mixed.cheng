# T78 家族回归夹具 | 来源: cheng-patches/20260717/round8/T78/lensB_regression_boundary/probes/or_call_mixed.cheng | 期望: RUNRC=1
var callCount: int32

fn always_true(): bool =
    callCount = callCount + 1
    return true

fn main(): int32 =
    var arr: bool[]
    var i: int32
    callCount = 0
    # f() true -> || must short-circuit, never touch arr[i] (empty arr, OOB).
    if always_true() || arr[i]:
        if callCount != 1:
            return 2
        return 1
    return 0
