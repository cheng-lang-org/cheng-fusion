type
    Inner =
        arr: int32[4]
        other: int32
    Outer =
        inner: Inner
        tag: int32

fn makeOuter(): Outer =
    var o: Outer
    o.tag = 9
    o.inner.other = 42
    o.inner.arr[0] = 10
    o.inner.arr[1] = 20
    o.inner.arr[2] = 30
    o.inner.arr[3] = 40
    return o

fn main(): int32 =
    var i2: int32
    i2 = 2
    let v2: int32 = makeOuter().inner.arr[i2]
    if v2 != 30:
        return 1
    return 0
