# T78 家族回归夹具 | 来源: cheng-patches/20260717/round14/T78_v4_adversarial_review/repros/adv_nested_arrstruct_alias_disambig.cheng | 期望: RUNRC=0
# disambiguation probe: does reading xs[0].arr[1] via the (post-v4) aligned-
# stride node fast-path actually alias into xs[1].arr[0] (the next struct
# element), because the nested WRITE path (AppendNestedFixedArrayIndexedFieldStore)
# addresses arr[idx] with TIGHT stride while the v4-touched read fast-path uses
# ALIGNED stride for the same arr[idx]? Set xs[0].arr[1]=false and
# xs[1].arr[0]=true (deliberately DIFFERENT) so any aliasing is visible instead
# of coincidentally matching.
type
    Elem =
        arr: bool[4]

fn main(): int32 =
    var xs: Elem[2]
    var k: int32
    k = 0
    xs[k].arr[0] = true
    xs[k].arr[1] = false
    xs[k].arr[2] = true
    xs[k].arr[3] = false
    k = 1
    xs[k].arr[0] = true
    xs[k].arr[1] = true
    xs[k].arr[2] = true
    xs[k].arr[3] = true
    var i: int32
    i = 1
    # expect false: xs[0].arr[1] was set false. If aliased into xs[1].arr[0]
    # (true), this wrongly returns 1 instead of 0.
    if xs[0].arr[i]:
        return 1
    return 0
