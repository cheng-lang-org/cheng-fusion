# T78 家族回归夹具 | 来源: cheng-patches/20260717/round22/T147_rootfix_adversarial_review/repros/combo_int16_field.cheng | 期望: RUNRC=1
type
    ElemI16 =
        arr: int16[4]
        other: int32

fn main(): int32 =
    var xs: ElemI16[2]
    xs[0].arr[0] = 11
    xs[0].arr[1] = 22
    xs[0].arr[2] = 33
    xs[0].arr[3] = 44
    xs[0].other = 999
    xs[1].arr[0] = 55
    xs[1].arr[1] = 66
    xs[1].arr[2] = 77
    xs[1].arr[3] = 88
    xs[1].other = 888
    var i: int32
    var j: int32
    i = 0
    j = 2
    if xs[i].arr[j] != 33:
        return 1
    i = 1
    j = 3
    if xs[i].arr[j] != 88:
        return 2
    if xs[0].other != 999:
        return 3
    if xs[1].other != 888:
        return 4
    return 0
