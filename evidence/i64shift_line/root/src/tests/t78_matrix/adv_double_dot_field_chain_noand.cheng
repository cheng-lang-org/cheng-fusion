# T78 家族回归夹具 | 来源: cheng-patches/20260717/round14/T78_v4_adversarial_review/repros/adv_double_dot_field_chain_noand.cheng | 期望: RUNRC=1
type
    Inner =
        arr: bool[4]

type
    Outer =
        t: Inner
        other: int32

fn main(): int32 =
    var s: Outer
    s.t.arr[0] = false
    s.t.arr[1] = true
    s.t.arr[2] = false
    s.t.arr[3] = false
    var i: int32
    i = 1
    if s.t.arr[i]:
        return 1
    return 0
