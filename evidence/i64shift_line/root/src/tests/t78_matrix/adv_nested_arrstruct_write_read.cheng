# T78 家族回归夹具 | 来源: cheng-patches/20260717/round14/T78_v4_adversarial_review/repros/adv_nested_arrstruct_write_read.cheng | 期望: RUNRC=0
# adversarial: array-of-struct with a bool[N] scalar array FIELD, written via the
# root-indexed nested-store path (PrimaryBodyIrAppendNestedFixedArrayIndexedFieldStore,
# TIGHT elemSize stride, untouched by v4) then read back via a non-root-indexed
# dotted condition read (v4-fixed ALIGNED stride, entry #4/#16).
type
    Elem =
        arr: bool[4]

fn main(): int32 =
    var xs: Elem[2]
    var k: int32
    k = 0
    xs[k].arr[0] = false
    xs[k].arr[1] = true
    xs[k].arr[2] = false
    xs[k].arr[3] = false
    k = 1
    xs[k].arr[0] = true
    xs[k].arr[1] = false
    xs[k].arr[2] = true
    xs[k].arr[3] = false
    var i: int32
    i = 1
    # read xs[0].arr[1] (should be true) via dotted condition path
    if i < 4 && xs[0].arr[i]:
        return 1
    return 0
