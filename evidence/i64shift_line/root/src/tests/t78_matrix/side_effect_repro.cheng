# T78 家族回归夹具 | 来源: cheng-patches/20260717/round6/T78/fixtures/side_effect_repro.cheng | 期望: RUNRC=0
var counter: int32

fn bump(v: bool): bool =
    counter = counter + 1
    return v

fn main(): int32 =
    var arr: bool[]
    add(arr, true)
    counter = 0
    if false && bump(true):
        return 1
    if counter != 0:
        return 2
    counter = 0
    if true || bump(true):
        counter = counter
    if counter != 0:
        return 3
    counter = 0
    if 5 < arr.len && arr[5]:
        return 4
    return 0
