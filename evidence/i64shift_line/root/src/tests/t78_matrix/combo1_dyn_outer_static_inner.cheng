# T78 家族回归夹具 | 来源: cheng-patches/20260717/round17/T78_v5_adversarial_review/repros/combo1_dyn_outer_static_inner.cheng | 期望: RUNRC=0
# combo attack #1: xs[i].arr[j] with OUTER index (i, struct-array) dynamic,
# INNER index (j, bool[4] field) static literal. Complements the existing
# adv_nested_arrstruct_write_read_noand (outer static literal 0, inner dynamic)
# by testing the opposite direction.
type
    Elem =
        arr: bool[4]

fn main(): int32 =
    var xs: Elem[2]
    var k: int32
    k = 0
    xs[k].arr[0] = true
    xs[k].arr[1] = false
    xs[k].arr[2] = true
    xs[k].arr[3] = false
    k = 1
    xs[k].arr[0] = false
    xs[k].arr[1] = true
    xs[k].arr[2] = false
    xs[k].arr[3] = true
    k = 0
    # outer index k is dynamic (variable), inner index is static literal 1.
    # xs[0].arr[1] was set false -> expect 0.
    if xs[k].arr[1]:
        return 1
    return 0
