# T78 家族回归夹具 | 来源: cheng-patches/20260717/round22/T147_rootfix_adversarial_review/repros/t147_basic.cheng | 期望: RUNRC=0
type
    Elem =
        arr: bool[4]
        other: int32

fn main(): int32 =
    var xs: Elem[2]
    xs[0].arr[0] = false
    xs[0].arr[1] = true
    xs[0].arr[2] = false
    xs[0].arr[3] = false
    xs[0].other = 111
    xs[1].arr[0] = false
    xs[1].arr[1] = false
    xs[1].arr[2] = false
    xs[1].arr[3] = false
    xs[1].other = 222
    var i: int32
    i = 1
    if xs[0].arr[i]:
        return 1
    return 0
