import cheng/core/runtime/web_font_runtime as font
import cheng/core/runtime/web_paint_runtime as paint

type
    RasterSurface =
        width: int32
        height: int32
        pixelBuffer: int32[]
        platformSurface: uint64

fn RasterFail(surface: var RasterSurface, msg: str): bool =
    return false

fn RasterFontCascadeValidate8(surface: var RasterSurface, face0: var font.WebFontFace, face1: var font.WebFontFace, face2: var font.WebFontFace, face3: var font.WebFontFace, face4: var font.WebFontFace, face5: var font.WebFontFace, face6: var font.WebFontFace, face7: var font.WebFontFace, faceCount: int32): bool =
    return true

fn WebRasterMax(a: int32, b: int32): int32 =
    if a > b:
        return a
    return b

fn WebRasterMin(a: int32, b: int32): int32 =
    if a < b:
        return a
    return b

fn RasterClearError(surface: var RasterSurface) =
    surface.platformSurface = uint64(0)

fn RasterFillRoundedRectCornersClippedImpl(surface: var RasterSurface, x: int32, y: int32, w: int32, h: int32, rtl: int32, rtr: int32, rbr: int32, rbl: int32, clipX: int32, clipY: int32, clipW: int32, clipH: int32, color: int32) =
    surface.width = x

fn RasterBorderRectCornersClippedImpl(surface: var RasterSurface, x: int32, y: int32, w: int32, h: int32, color: int32, btw: int32, brw: int32, bbw: int32, blw: int32, rtl: int32, rtr: int32, rbr: int32, rbl: int32, clipX: int32, clipY: int32, clipW: int32, clipH: int32): bool =
    return true

fn RasterFillTextWithFontCascade8WeightedClippedPx2(surface: var RasterSurface, face0: var font.WebFontFace, face1: var font.WebFontFace, face2: var font.WebFontFace, face3: var font.WebFontFace, face4: var font.WebFontFace, face5: var font.WebFontFace, face6: var font.WebFontFace, face7: var font.WebFontFace, faceCount: int32, xPx2: int32, yPx2: int32, text: str, fontSize: int32, lineHeightPx2: int32, color: int32, clipX: int32, clipY: int32, clipW: int32, clipH: int32, alignX: int32, alignWidth: int32, textAlign: int32, weight0: int32, weight1: int32, weight2: int32, weight3: int32, weight4: int32, weight5: int32, weight6: int32, weight7: int32, family0: int32, family1: int32, family2: int32, family3: int32, family4: int32, family5: int32, family6: int32, family7: int32, fontWeight: int32, fontFamily: int32): bool =
    return true

fn RasterDrawSvgIconClippedImpl(surface: var RasterSurface, x: int32, y: int32, w: int32, h: int32, kind: int32, size: int32, primitives: int32[], color: int32, clipX: int32, clipY: int32, clipW: int32, clipH: int32): bool =
    return true

fn main(): int32 =
    var surface: RasterSurface
    var f0: font.WebFontFace
    var f1: font.WebFontFace
    var f2: font.WebFontFace
    var f3: font.WebFontFace
    var f4: font.WebFontFace
    var f5: font.WebFontFace
    var f6: font.WebFontFace
    var f7: font.WebFontFace
    var ops: paint.PaintOp[]
    if RasterPaintOpsWithFontCascade8WeightedFamily(surface, ops, f0, f1, f2, f3, f4, f5, f6, f7, 1, 400, 400, 400, 400, 400, 400, 400, 400, 0, 0, 0, 0, 0, 0, 0, 0):
        return 0
    return 1

fn RasterPaintOp(surface: var RasterSurface, op: paint.PaintOp): bool =
    return true

fn RasterPaintOpsWithFontCascade8WeightedFamily(surface: var RasterSurface,
                                                ops: paint.PaintOp[],
                                                face0: var font.WebFontFace,
                                                face1: var font.WebFontFace,
                                                face2: var font.WebFontFace,
                                                face3: var font.WebFontFace,
                                                face4: var font.WebFontFace,
                                                face5: var font.WebFontFace,
                                                face6: var font.WebFontFace,
                                                face7: var font.WebFontFace,
                                                faceCount: int32,
                                                weight0: int32,
                                                weight1: int32,
                                                weight2: int32,
                                                weight3: int32,
                                                weight4: int32,
                                                weight5: int32,
                                                weight6: int32,
                                                weight7: int32,
                                                family0: int32,
                                                family1: int32,
                                                family2: int32,
                                                family3: int32,
                                                family4: int32,
                                                family5: int32,
                                                family6: int32,
                                                family7: int32): bool =
    if surface.platformSurface != uint64(0):
        return RasterFail(surface, "platform raster surface unsupported")
    if surface.width <= 0 || surface.height <= 0:
        return RasterFail(surface, "invalid raster surface size")
    if !RasterFontCascadeValidate8(surface, face0, face1, face2, face3, face4, face5, face6, face7, faceCount):
        return false
    let expectedPixelCount = surface.width * surface.height
    if surface.pixelBuffer.len != expectedPixelCount:
        return RasterFail(surface, "raster pixel buffer size mismatch")
    RasterClearError(surface)
    var clipX: int32
    var clipY: int32
    var clipW = surface.width
    var clipH = surface.height
    for i in 0..<ops.len:
        let op = ops[i]
        let savedClipX = clipX
        let savedClipY = clipY
        let savedClipW = clipW
        let savedClipH = clipH
        if op.kind == paint.PaintOpKindClipRect:
            if op.clipRect.width <= 0 || op.clipRect.height <= 0:
                return RasterFail(surface, "invalid clip rect")
            var crx: int32 = op.clipRect.x
            var cry: int32 = op.clipRect.y
            var crw: int32 = op.clipRect.width
            var crh: int32 = op.clipRect.height
            var nextX: int32 = WebRasterMax(clipX, crx)
            var nextY: int32 = WebRasterMax(clipY, cry)
            var nextRight: int32 = WebRasterMin(clipX + clipW, crx + crw)
            var nextBottom: int32 = WebRasterMin(clipY + clipH, cry + crh)
            clipX = nextX
            clipY = nextY
            clipW = nextRight - nextX
            clipH = nextBottom - nextY
            if clipW < 0:
                clipW = 0
            if clipH < 0:
                clipH = 0
        elif op.kind == paint.PaintOpKindFillRect:
            var fillClipX = clipX
            var fillClipY = clipY
            var fillClipW = clipW
            var fillClipH = clipH
            if op.clipRect.width > 0 && op.clipRect.height > 0:
                let nextX = WebRasterMax(fillClipX, op.clipRect.x)
                let nextY = WebRasterMax(fillClipY, op.clipRect.y)
                let nextRight = WebRasterMin(fillClipX + fillClipW, op.clipRect.x + op.clipRect.width)
                let nextBottom = WebRasterMin(fillClipY + fillClipH, op.clipRect.y + op.clipRect.height)
                fillClipX = nextX
                fillClipY = nextY
                fillClipW = nextRight - nextX
                fillClipH = nextBottom - nextY
                if fillClipW < 0:
                    fillClipW = 0
                if fillClipH < 0:
                    fillClipH = 0
            RasterFillRoundedRectCornersClippedImpl(surface, op.rect.x, op.rect.y, op.rect.width, op.rect.height,
                op.borderTopLeftRadius, op.borderTopRightRadius, op.borderBottomRightRadius, op.borderBottomLeftRadius,
                fillClipX, fillClipY, fillClipW, fillClipH, op.color)
            clipX = savedClipX
            clipY = savedClipY
            clipW = savedClipW
            clipH = savedClipH
        elif op.kind == paint.PaintOpKindIcon:
            var iconClipX = clipX
            var iconClipY = clipY
            var iconClipW = clipW
            var iconClipH = clipH
            if op.clipRect.width > 0 && op.clipRect.height > 0:
                let nextX = WebRasterMax(iconClipX, op.clipRect.x)
                let nextY = WebRasterMax(iconClipY, op.clipRect.y)
                let nextRight = WebRasterMin(iconClipX + iconClipW, op.clipRect.x + op.clipRect.width)
                let nextBottom = WebRasterMin(iconClipY + iconClipH, op.clipRect.y + op.clipRect.height)
                iconClipX = nextX
                iconClipY = nextY
                iconClipW = nextRight - nextX
                iconClipH = nextBottom - nextY
                if iconClipW < 0:
                    iconClipW = 0
                if iconClipH < 0:
                    iconClipH = 0
            if !RasterDrawSvgIconClippedImpl(surface, op.rect.x, op.rect.y, op.rect.width, op.rect.height,
                op.icon.kind, op.icon.size, op.icon.primitives, op.color, iconClipX, iconClipY, iconClipW, iconClipH):
                return false
            clipX = savedClipX
            clipY = savedClipY
            clipW = savedClipW
            clipH = savedClipH
        elif !RasterPaintOp(surface, op):
            return false
    return true

