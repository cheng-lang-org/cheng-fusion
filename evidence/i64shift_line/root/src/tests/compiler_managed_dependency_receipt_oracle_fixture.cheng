import cheng/core/tooling/compiler_world_libp2p as cwlp
import cheng/core/tooling/path as chengpath
import cheng/std/bytes_layout as layout

fn fixed32(hexText: str): layout.FixedBytes32 =
    let valueRes = layout.FixedBytes32FromHex(hexText)
    assert(IsOk(valueRes), "fixture fixed32")
    return Value(valueRes)

fn main() =
    var entry: cwlp.CompilerManagedDependencyReceiptEntry
    entry.canonicalPackageId = "cheng/dependency"
    entry.snapshotCid = fixed32(
        "0101010101010101010101010101010101010101010101010101010101010101")
    entry.syntaxSurfaceCid = fixed32(
        "0202020202020202020202020202020202020202020202020202020202020202")
    entry.migrationProofCid = fixed32(
        "0303030303030303030303030303030303030303030303030303030303030303")
    entry.priorManagedMirrorBundleCid = fixed32(
        "0404040404040404040404040404040404040404040404040404040404040404")
    var receipt: cwlp.CompilerManagedDependencyReceipt
    let makeRes = cwlp.CompilerWorldManagedDependencyReceiptMake(
        "stable",
        [entry],
        receipt)
    assert(IsOk(makeRes), "managed dependency receipt fixture")
    let report = cwlp.CompilerWorldManagedDependencyReceiptReport(receipt)
    assert(chengpath.WriteTextFile(
        "",
        "/private/tmp/managed_dependency_receipt.cheng.txt",
        report),
        "managed dependency receipt fixture write")
