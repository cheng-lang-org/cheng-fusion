# Regression lock for cold defect #144 site 1: parse_scalar_identity_cast
# generic branch must tag uint32(literal) results so a subsequent float64
# promotion zero-extends (not sign-extends) values >= 2^31.
# 3000000007 > 2^31; correct u32*0.5 = 1500000003.5. If the marker is lost
# the value is sign-misread to negative. Returns 0 only when every mixed
# u32-literal x f64 cell is correct.
fn main(): int32 =
    let f: float64 = 0.5
    if uint32(3000000007) * f == 1500000003.5:
        if uint32(3000000007) + f == 3000000007.5:
            if uint32(3000000007) - f == 3000000006.5:
                return 0
            return 3
        return 2
    return 1
