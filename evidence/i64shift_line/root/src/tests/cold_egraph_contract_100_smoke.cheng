import std/strings
import cheng/core/tooling/compiler_csg_egraph_contract as econtract

fn assertContains(text: str,
                  needle: str,
                  label: str) =
    assert(strings.StrContains(text, needle), label)

fn main(): int32 =
    // Verify contract declares 36 rules
    let activeReport = econtract.CompilerCsgEgraphActiveContractReport()
    assertContains(activeReport,
                   "uir_egraph_rewrite_rule_count=36",
                   "contract declares 36 rewrite rules")
    assertContains(activeReport,
                   "uir_egraph_rewrite_enabled=0",
                   "rewrites are enabled")
    assertContains(activeReport,
                   "uir_egraph_status=compiled_not_invoked",
                   "egraph status compiled in backend driver")
    assertContains(activeReport,
                   "normalization_coverage=I32_I64_bitwise_integer_only",
                   "normalization coverage matches implementation")
    assertContains(activeReport,
                   "egraph_active_contract=canonical_csg_equivalence",
                   "active contract is canonical CSG equivalence")
    assertContains(activeReport,
                   "canonical_csg_equivalence_available=1",
                   "canonical CSG equivalence available")
    assertContains(activeReport,
                   "uir_egraph_hard_fail=0",
                   "hard fail not triggered")

    // Verify UIR exit code contract
    assert(econtract.CompilerCsgUirEgraphUnavailableExitCode() == 78,
           "uir egraph unavailable exit code is 0")

    echo(" cold_egraph_contract_100_smoke ok")
    return 0
