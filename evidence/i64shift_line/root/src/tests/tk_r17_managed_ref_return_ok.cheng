# R17 gate control: a resource-BEARING value object returned through the very
# same OBJECT_REF place (a `var T` parameter) must keep the exact managed path
# (retain/release), not the new plain payload copy. A wrongly-plain copy shows
# up as a wrong string, or as cheng_orc_release_failure at teardown.
import std/system

type
    R17MBundle =
        tag: str
        n: int32

fn TkR17MgRetVarParam(v: var R17MBundle): R17MBundle =
    return v

fn main(): int32 =
    var x: R17MBundle
    x.tag = "beta"
    x.n = 6
    let y = TkR17MgRetVarParam(x)
    if y.n != 6:
        return 12
    if y.tag != "beta":
        return 13
    echo(Fmt"tk_r17_managed_ref_return ok y={y.tag}/{y.n}")
    return 0
