# Exact-identity golden pair: same module, same name and arity, distinct
# parameter/result types.  A name+arity lookup cannot distinguish these calls.
fn ManagedValue(seed: int32): str =
    return Fmt"managed-global-imported-{seed}"

fn ManagedValue(seed: int64): int32[] =
    let value = int32(seed)
    var values: int32[]
    add(values, value)
    add(values, value + 1)
    add(values, value + 2)
    return values
