import std/system
import std/thread
import std/os
import std/rawbytes
import std/strings
import cheng/core/runtime/arena as arenamod

var participantSourceRow: int32
var participantSourceGeneration: int32
var participantSourceOwner: int32
var participantTerminalRow: int32
var participantTerminalGeneration: int32
var participantTerminalOwner: int32
var participantMode: int32

const
    ParticipantMapFinal: str =
        "93ab93ab93ab93ab93ab93ab93ab93ab93ab93ab93ab93ab93ab93ab93ab93ab"
    ParticipantMapRelative: str = "participant.bin"

fn boundaryRoot(): system.RuntimeAllocationLedgerParticipantRoot =
    return system.RuntimeAllocationLedgerParticipantRoot(
        word0: uint64(0x0102030405060708),
        word1: uint64(0x1112131415161718),
        word2: uint64(0x2122232425262728),
        word3: uint64(0x3132333435363738))

fn resultRoot(): system.RuntimeAllocationLedgerParticipantRoot =
    return system.RuntimeAllocationLedgerParticipantRoot(
        word0: uint64(0x4142434445464748),
        word1: uint64(0x5152535455565758),
        word2: uint64(0x6162636465666768),
        word3: uint64(0x7172737475767778))

fn participantExerciseRuntimeDomains(): bool =
    var arena = arenamod.ArenaInit(64)
    defer:
        arenamod.ArenaRelease(arena)
    let region = arenamod.ArenaAlloc(arena, 4096)
    if region.len != 4096:
        return false
    var mapped = rawbytes.BytesAlloc(2097152)
    defer:
        rawbytes.BytesFree(mapped)
    if mapped.len != 2097152:
        return false
    let mapParent = os.GetEnv("CHENG_PARTICIPANT_MAP_PARENT")
    let openedTree = os.AtomicTreeOpenVerified(
        mapParent, ParticipantMapFinal)
    if IsErr(openedTree):
        return false
    let tree = Value(openedTree)
    let mappedRegion = os.AtomicTreeMapReadOnly(
        tree, ParticipantMapRelative)
    if IsErr(mappedRegion):
        let _ = os.AtomicTreeClose(tree)
        return false
    let region = Value(mappedRegion)
    let measured = os.ReadOnlyMappedRegionByteLength(region)
    if IsErr(measured) || Value(measured) != int64(23):
        let _ = os.ReadOnlyMappedRegionClose(region)
        let _ = os.AtomicTreeClose(tree)
        return false
    if IsErr(os.ReadOnlyMappedRegionClose(region)) ||
       IsErr(os.AtomicTreeClose(tree)):
        return false
    let opened = os.OpenReadHandleResult("/dev/null")
    if IsErr(opened):
        return false
    let handle = Value(opened)
    let closed = os.CloseFileResult(handle)
    if !IsOk(closed) || !Value(closed):
        return false
    let retained = strings.CloneStr("participant-retain-release")
    let shared = share(retained)
    return shared == retained

fn participantWorker() =
    let exactStartedWorker =
        system.RuntimeAllocationLedgerParticipantStartedWorkerOrdinal()
    if exactStartedWorker != 1:
        panic("participant worker start row drift")
    var capability: system.RuntimeAllocationLedgerParticipantCapability
    capability.row = participantSourceRow
    capability.generation = participantSourceGeneration
    capability.owner = participantSourceOwner
    participantSourceRow = 0
    participantSourceGeneration = 0
    participantSourceOwner = 0
    if participantSourceRow != 0 ||
       participantSourceGeneration != 0 ||
       participantSourceOwner != 0:
        panic("participant worker source not cleared")
    let preClaimCopy = capability
    if participantMode == 4:
        var missing = boundaryRoot()
        missing.word2 = uint64(0)
        let _ = system.RuntimeAllocationLedgerParticipantClaim(
            capability, exactStartedWorker, missing)
    if !system.RuntimeAllocationLedgerParticipantClaim(
           capability, exactStartedWorker, boundaryRoot()):
        panic("participant worker claim failed")
    if participantMode == 3:
        var duplicateClaim = preClaimCopy
        let _ = system.RuntimeAllocationLedgerParticipantClaim(
            duplicateClaim, exactStartedWorker, boundaryRoot())
    if !participantExerciseRuntimeDomains():
        panic("participant worker runtime domain exercise failed")
    let prePublishCopy = capability
    if !system.RuntimeAllocationLedgerParticipantPublish(
           capability,
           exactStartedWorker,
           boundaryRoot(),
           resultRoot()):
        panic("participant worker publish failed")
    participantTerminalRow = capability.row
    participantTerminalGeneration = capability.generation
    participantTerminalOwner = capability.owner
    capability = system.RuntimeAllocationLedgerParticipantCapability()
    if !system.RuntimeAllocationLedgerParticipantCapabilityIsEmpty(
           capability):
        panic("participant worker terminal source not cleared")
    if participantMode == 5:
        var replay = prePublishCopy
        let _ = system.RuntimeAllocationLedgerParticipantPublish(
            replay, exactStartedWorker, boundaryRoot(), resultRoot())

fn selectedMode(): int32 =
    let mode = os.GetEnv("CHENG_PARTICIPANT_NEGATIVE")
    if mode == "duplicate_mint":
        return 1
    if mode == "stale_after_move":
        return 2
    if mode == "duplicate_claim":
        return 3
    if mode == "missing_boundary_column":
        return 4
    if mode == "publish_replay":
        return 5
    if mode == "double_consume":
        return 6
    if mode == "cross_row_claim":
        return 7
    return 0

fn runParticipant(mode: int32): int32 =
    var minted: system.RuntimeAllocationLedgerParticipantCapability
    if !system.RuntimeAllocationLedgerParticipantMint(
           1, boundaryRoot(), minted):
        return 10
    if mode == 1:
        var duplicate: system.RuntimeAllocationLedgerParticipantCapability
        let _ = system.RuntimeAllocationLedgerParticipantMint(
            1, boundaryRoot(), duplicate)
        return 11
    let stale = minted
    let priorGeneration = minted.generation
    let priorOwner = minted.owner
    var moved: system.RuntimeAllocationLedgerParticipantCapability
    if !system.RuntimeAllocationLedgerParticipantMove(minted, moved) ||
       !system.RuntimeAllocationLedgerParticipantCapabilityIsEmpty(minted) ||
       moved.generation == priorGeneration || moved.owner == priorOwner:
        return 12
    if mode == 2:
        var staleMove = stale
        let _ = system.RuntimeAllocationLedgerParticipantClaim(
            staleMove, 1, boundaryRoot())
        return 13
    if mode == 7:
        var crossMinted: system.RuntimeAllocationLedgerParticipantCapability
        var crossMoved: system.RuntimeAllocationLedgerParticipantCapability
        if !system.RuntimeAllocationLedgerParticipantMint(
               2, boundaryRoot(), crossMinted) ||
           !system.RuntimeAllocationLedgerParticipantMove(
               crossMinted, crossMoved):
            return 14
        participantSourceRow = crossMoved.row
        participantSourceGeneration = crossMoved.generation
        participantSourceOwner = crossMoved.owner
        crossMoved =
            system.RuntimeAllocationLedgerParticipantCapability()
        if !system.RuntimeAllocationLedgerParticipantCapabilityIsEmpty(
               crossMoved):
            return 15
        moved = system.RuntimeAllocationLedgerParticipantCapability()
    else:
        participantSourceRow = moved.row
        participantSourceGeneration = moved.generation
        participantSourceOwner = moved.owner
        moved = system.RuntimeAllocationLedgerParticipantCapability()
    if !system.RuntimeAllocationLedgerParticipantCapabilityIsEmpty(moved):
        return 17
    participantMode = mode
    let worker = thread.StartFn(participantWorker)
    if !thread.JoinThread(worker):
        return 18
    var terminal: system.RuntimeAllocationLedgerParticipantCapability
    terminal.row = participantTerminalRow
    terminal.generation = participantTerminalGeneration
    terminal.owner = participantTerminalOwner
    participantTerminalRow = 0
    participantTerminalGeneration = 0
    participantTerminalOwner = 0
    let replay = terminal
    if !system.RuntimeAllocationLedgerParticipantConsume(
           terminal, 1, boundaryRoot(), resultRoot()) ||
       !system.RuntimeAllocationLedgerParticipantCapabilityIsEmpty(terminal):
        return 19
    if mode == 6:
        var doubleConsume = replay
        let _ = system.RuntimeAllocationLedgerParticipantConsume(
            doubleConsume, 1, boundaryRoot(), resultRoot())
        return 20
    return 0

fn main(): int32 =
    var session: system.RuntimeAllocationLedgerSessionCapability
    if !system.RuntimeAllocationLedgerSessionOwnerBegin(
           uint64(1073741824), session):
        return 1
    let mode = selectedMode()
    let runCode = runParticipant(mode)
    if runCode != 0:
        return runCode
    if mode == 0:
        let remintCode = runParticipant(0)
        if remintCode != 0:
            return remintCode
    let observed = system.RuntimeAllocationLedgerSessionOwnerSnapshot(session)
    if !observed.ok || !observed.receipt.active:
        return 21
    if observed.receipt.liveAllocationCount != uint64(0):
        return 23
    if observed.receipt.liveMappingCount != uint64(0):
        return 24
    if observed.receipt.liveHandleCount != uint64(0):
        return 25
    if observed.receipt.peakAllocationCount == uint64(0):
        return 26
    if observed.receipt.peakMappedVirtualBytes == uint64(0):
        return 27
    if observed.receipt.peakHandleCount == uint64(0):
        return 28
    let closed = system.RuntimeAllocationLedgerSessionOwnerClose(session)
    if !closed.ok || !closed.receipt.complete ||
       !closed.receipt.closed || closed.receipt.active ||
       closed.receipt.liveAllocationCount != uint64(0) ||
       closed.receipt.liveMappingCount != uint64(0) ||
       closed.receipt.liveHandleCount != uint64(0):
        return 22
    echo(Fmt"participant_receipt live_alloc={observed.receipt.liveAllocationCount} live_map={observed.receipt.liveMappingCount} live_handle={observed.receipt.liveHandleCount} peak_alloc={observed.receipt.peakAllocationCount} peak_map_bytes={observed.receipt.peakMappedVirtualBytes} peak_handle={observed.receipt.peakHandleCount} event_index={observed.receipt.eventIndex} remint=1")
    return 0
