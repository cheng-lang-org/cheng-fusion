@borrows
fn SourceMembershipMutationCid(
        mutationBytes: str): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(mutationBytes.len)
    for index in 0..<mutationBytes.len:
        layout.ByteBufAppendByte(
            buf, Int32(mutationBytes[index]) & 255)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn RecordSourceMembershipMutation(
        id: str,
        mutationBytes: str) =
    assert(id != "" && mutationBytes != "",
           "lsp source membership: empty mutation identity")
    os.WriteLine(
        os.Get_stdout(),
        Fmt"semantic_snapshot_source_membership_mutation id={id} cid={layout.FixedBytes32Hex(SourceMembershipMutationCid(mutationBytes))} bytes={mutationBytes}")

fn RequiredCidEnv(name: str): layout.FixedBytes32 =
    let raw = os.GetEnv(name)
    let parsed = layout.FixedBytes32FromHex(raw)
    assert(IsOk(parsed), Fmt"lsp multifile exact: invalid CID env {name}")
    let cid = Value(parsed)
    assert(!layout.FixedBytes32Equal(cid, layout.FixedBytes32()),
           Fmt"lsp multifile exact: zero CID env {name}")
    return cid

fn ReplaceProducerProjectionForAttack(
        facts: var snapshot_cargo.CsgCompilerSnapshotFailureFacts,
        attackProjectionCid: layout.FixedBytes32) =
    facts.structuredDiagnosticProducerProjectionCids[0] =
        attackProjectionCid

fn CurrentExecution(): execution.CompilerExecutionIdentity =
    let identity = execution.CompilerExecutionIdentityMake(
        "lsp-multifile-exact-current-source",
        RequiredCidEnv("CHENG_LSP_COMPILER_SOURCE_BUNDLE_CID"),
        RequiredCidEnv("CHENG_LSP_MATERIALIZER_CID"),
        RequiredCidEnv("CHENG_LSP_GRAMMAR_CID"),
        RequiredCidEnv("CHENG_LSP_COMPILER_SOURCE_CLOSURE_CID"),
        RequiredCidEnv("CHENG_LSP_DRIVER_CID"),
        RequiredCidEnv("CHENG_LSP_TOOLCHAIN_CID"),
        RequiredCidEnv("CHENG_LSP_COMMAND_CID"),
        "arm64-apple-darwin")
    if IsErr(identity):
        panic(Error(identity))
    return Value(identity)

@borrows
fn CurrentUniverse(
        compilerExecution: execution.CompilerExecutionIdentity):
        cworld.CompilerLocalUniverse =
    var universe: cworld.CompilerLocalUniverse
    var noExtraEntries: cworld.CompilerUniverseManifestEntry[]
    var err: str
    let sourceBundleCid =
        layout.FixedBytes32Copy(compilerExecution.sourceBundleRaw32)
    assert(cworld.CompilerLocalUniverseBuildForChannelWithManifestEntriesInto(
               universe,
               err,
               "stable",
               sourceBundleCid,
               RequiredCidEnv("CHENG_LSP_COMPILER_CSG_ROOT_CID"),
               RequiredCidEnv("CHENG_LSP_COMPILER_EXPORT_SURFACE_CID"),
               layout.FixedBytes32(),
               noExtraEntries), err)
    return universe

fn ReceiptPublished(receipt: lsp.LspExactQueryReceipt): bool =
    return receipt.sourceVersion > int64(0) && !receipt.rejected &&
        !layout.FixedBytes32Equal(
            receipt.semanticSnapshotCid, layout.FixedBytes32()) &&
        !layout.FixedBytes32Equal(
            receipt.bindingReceiptCid, layout.FixedBytes32()) &&
        !layout.FixedBytes32Equal(
            receipt.csgRootCid, layout.FixedBytes32()) &&
        !layout.FixedBytes32Equal(
            receipt.queryProjectionCid, layout.FixedBytes32()) &&
        !layout.FixedBytes32Equal(
            receipt.queryIndexCid, layout.FixedBytes32()) &&
        !layout.FixedBytes32Equal(
            receipt.openDocumentUniverseCid,
            layout.FixedBytes32()) &&
        !layout.FixedBytes32Equal(
            receipt.declarationTableCid, layout.FixedBytes32()) &&
        !layout.FixedBytes32Equal(
            receipt.compilerFactProjectionCid, layout.FixedBytes32()) &&
        layout.FixedBytes32Equal(
            receipt.failureDiagnosticRootCid, layout.FixedBytes32()) &&
        layout.FixedBytes32Equal(
            receipt.failureCargoCid, layout.FixedBytes32()) &&
        layout.FixedBytes32Equal(
            receipt.failureAdmissionReceiptCid, layout.FixedBytes32()) &&
        layout.FixedBytes32Equal(
            receipt.failureParserDiagnosticAuthorityRootCid,
            layout.FixedBytes32())

fn ReceiptsEqual(
        left: lsp.LspExactQueryReceipt,
        right: lsp.LspExactQueryReceipt): bool =
    return left.sourceVersion == right.sourceVersion &&
        left.rejected == right.rejected &&
        layout.FixedBytes32Equal(
            left.semanticSnapshotCid, right.semanticSnapshotCid) &&
        layout.FixedBytes32Equal(
            left.bindingReceiptCid, right.bindingReceiptCid) &&
        layout.FixedBytes32Equal(left.csgRootCid, right.csgRootCid) &&
        layout.FixedBytes32Equal(
            left.queryProjectionCid, right.queryProjectionCid) &&
        layout.FixedBytes32Equal(
            left.queryIndexCid, right.queryIndexCid) &&
        layout.FixedBytes32Equal(
            left.openDocumentUniverseCid,
            right.openDocumentUniverseCid) &&
        layout.FixedBytes32Equal(
            left.declarationTableCid, right.declarationTableCid) &&
        layout.FixedBytes32Equal(
            left.compilerFactProjectionCid,
            right.compilerFactProjectionCid) &&
        layout.FixedBytes32Equal(
            left.failureDiagnosticRootCid,
            right.failureDiagnosticRootCid) &&
        layout.FixedBytes32Equal(
            left.failureCargoCid,
            right.failureCargoCid) &&
        layout.FixedBytes32Equal(
            left.failureAdmissionReceiptCid,
            right.failureAdmissionReceiptCid) &&
        layout.FixedBytes32Equal(
            left.failureParserDiagnosticAuthorityRootCid,
            right.failureParserDiagnosticAuthorityRootCid)

fn ReceiptEmpty(receipt: lsp.LspExactQueryReceipt): bool =
    return receipt.sourceVersion == int64(0) && !receipt.rejected &&
        layout.FixedBytes32Equal(
            receipt.semanticSnapshotCid, layout.FixedBytes32()) &&
        layout.FixedBytes32Equal(
            receipt.bindingReceiptCid, layout.FixedBytes32()) &&
        layout.FixedBytes32Equal(
            receipt.csgRootCid, layout.FixedBytes32()) &&
        layout.FixedBytes32Equal(
            receipt.queryProjectionCid, layout.FixedBytes32()) &&
        layout.FixedBytes32Equal(
            receipt.queryIndexCid, layout.FixedBytes32()) &&
        layout.FixedBytes32Equal(
            receipt.openDocumentUniverseCid,
            layout.FixedBytes32()) &&
        layout.FixedBytes32Equal(
            receipt.declarationTableCid, layout.FixedBytes32()) &&
        layout.FixedBytes32Equal(
            receipt.compilerFactProjectionCid, layout.FixedBytes32()) &&
        layout.FixedBytes32Equal(
            receipt.failureDiagnosticRootCid, layout.FixedBytes32()) &&
        layout.FixedBytes32Equal(
            receipt.failureCargoCid, layout.FixedBytes32()) &&
        layout.FixedBytes32Equal(
            receipt.failureAdmissionReceiptCid, layout.FixedBytes32()) &&
        layout.FixedBytes32Equal(
            receipt.failureParserDiagnosticAuthorityRootCid,
            layout.FixedBytes32())

fn CurrentVersionPublished(
        workspace: lsp.LspWorkspace,
        sourceVersion: int64): bool =
    let publishedIndex = workspace.snapshotStore.core.publishedIndex
    return publishedIndex >= 0 &&
        publishedIndex < workspace.snapshotStore.core.sourceVersions.len &&
        publishedIndex < workspace.snapshotStore.core.states.len &&
        workspace.snapshotStore.core.currentSourceVersion == sourceVersion &&
        workspace.snapshotStore.core.sourceVersions[publishedIndex] ==
            sourceVersion &&
        workspace.snapshotStore.core.states[publishedIndex] ==
            snapshot_core.SemanticSnapshotStatePublished

@borrows
fn AssertPublishedActiveMembershipInto(
        workspace: var lsp.LspWorkspace,
        sourceVersion: int64,
        expectedStableRows: var int32[]) =
    let snapshotIndex = workspace.snapshotStore.core.publishedIndex
    assert(CurrentVersionPublished(workspace, sourceVersion) &&
           snapshotIndex >= 0 &&
           snapshotIndex <
               workspace.snapshotStore.payloadIndexesBySnapshot.len,
           "lsp source membership: current version was not published")
    let payloadIndex =
        workspace.snapshotStore.payloadIndexesBySnapshot[snapshotIndex]
    assert(payloadIndex >= 0 &&
           payloadIndex < workspace.snapshotStore.payloadBindings.len &&
           payloadIndex <
               workspace.snapshotStore.payloadQueryProjections.len &&
           payloadIndex < workspace.snapshotStore.payloadTables.len &&
           workspace.snapshotStore.payloadBindings[
               payloadIndex].documentCids.len ==
               expectedStableRows.len &&
           workspace.snapshotStore.payloadBindings[
               payloadIndex].activeSourceStableRows.len ==
               expectedStableRows.len &&
           workspace.snapshotStore.payloadQueryProjections[
               payloadIndex].documents.len ==
               expectedStableRows.len &&
           workspace.snapshotStore.payloadQueryProjections[
               payloadIndex].activeSourceStableRows.len ==
               expectedStableRows.len &&
           workspace.snapshotStore.payloadTables[
               payloadIndex].sources.documentCids.len ==
               expectedStableRows.len,
           "lsp source membership: published active source shape drift")
    for sourceId in 0..<expectedStableRows.len:
        let stableRow =
            workspace.snapshotStore.payloadBindings[
                payloadIndex].activeSourceStableRows[sourceId]
        var expectedMatchCount: int32
        for expectedIndex in 0..<expectedStableRows.len:
            if expectedStableRows[expectedIndex] == stableRow:
                expectedMatchCount = expectedMatchCount + 1
        assert(expectedMatchCount == 1 &&
               stableRow >= 0 &&
               stableRow < workspace.eventState.documentCids.len &&
               stableRow < workspace.documents.len &&
               workspace.eventState.documentPresenceStates[stableRow] ==
                   snapshot_core.SemanticSourcePresencePresent &&
               workspace.documents[stableRow].present &&
               workspace.documents[stableRow].stableEventRow == stableRow &&
               workspace.snapshotStore.payloadQueryProjections[
                   payloadIndex].activeSourceStableRows[sourceId] ==
                   stableRow &&
               layout.FixedBytes32Equal(
                   workspace.snapshotStore.payloadBindings[
                       payloadIndex].documentCids[sourceId],
                   workspace.eventState.documentCids[stableRow]) &&
               layout.FixedBytes32Equal(
                   workspace.snapshotStore.payloadTables[
                       payloadIndex].sources.documentCids[sourceId],
                   workspace.eventState.documentCids[stableRow]) &&
               layout.FixedBytes32Equal(
                   workspace.snapshotStore.payloadQueryProjections[
                       payloadIndex].documents[sourceId].documentCid,
                   workspace.eventState.documentCids[stableRow]),
               "lsp source membership: SourceId/stable-row/CID split")
    for expectedIndex in 0..<expectedStableRows.len:
        var publishedMatchCount: int32
        for sourceId in 0..<workspace.snapshotStore.payloadBindings[
                payloadIndex].activeSourceStableRows.len:
            if workspace.snapshotStore.payloadBindings[
                    payloadIndex].activeSourceStableRows[sourceId] ==
                   expectedStableRows[expectedIndex]:
                publishedMatchCount = publishedMatchCount + 1
        assert(publishedMatchCount == 1,
               "lsp source membership: active stable row missing or duplicated")

@borrows
fn PublishedSourceIdForUri(
        workspace: var lsp.LspWorkspace,
        publishedIndex: int32,
        uri: str): int32 =
    var documentMatchCount: int32
    for documentIndex in 0..<workspace.documents.len:
        if workspace.documents[documentIndex].uri == uri:
            documentMatchCount = documentMatchCount + 1
            assert(documentMatchCount == 1,
                   "lsp multifile exact: duplicate workspace URI")
            let sources =
                workspace.snapshotStore.payloadTables[
                    publishedIndex].sources
            for sourceId in 0..<sources.documentCids.len:
                if layout.FixedBytes32Equal(
                        sources.documentCids[sourceId],
                        workspace.documents[
                            documentIndex].documentCid):
                    return sourceId
    assert(documentMatchCount == 1,
           "lsp multifile exact: workspace URI missing")
    panic("lsp_multifile_exact_published_source_missing")

@borrows
fn FiveSemanticRequestsContentModified(
        workspace: var lsp.LspWorkspace,
        uri: str,
        line: int32,
        column: int32): bool =
    var err: str
    var definition: lsp.LspExactDefinitionResult
    if lsp.LspWorkspaceExactDefinitionInto(
           workspace, uri, line, column, definition, err) ||
       !strings.StrContains(err, "content modified") ||
       definition.found || !ReceiptEmpty(definition.receipt):
        return false
    err = ""
    var references: lsp.LspExactReferencesResult
    if lsp.LspWorkspaceExactReferencesInto(
           workspace, uri, line, column, true, references, err) ||
       !strings.StrContains(err, "content modified") ||
       references.found || references.locations.len != 0 ||
       !ReceiptEmpty(references.receipt):
        return false
    err = ""
    var rename: lsp.LspExactRenameResult
    if lsp.LspWorkspaceExactRenameInto(
           workspace, uri, line, column, "ResolveRenamed", rename, err) ||
       !strings.StrContains(err, "content modified") ||
       rename.edits.len != 0 || !ReceiptEmpty(rename.receipt):
        return false
    err = ""
    var hover: lsp.LspExactHoverResult
    if lsp.LspWorkspaceExactHoverInto(
           workspace, uri, line, column, hover, err) ||
       !strings.StrContains(err, "content modified") ||
       hover.found || !ReceiptEmpty(hover.receipt):
        return false
    err = ""
    var completion: lsp.LspExactCompletionResult
    if lsp.LspWorkspaceExactCompletionInto(
           workspace, uri, line, column, completion, err) ||
       !strings.StrContains(err, "content modified") ||
       completion.items.len != 0 || !ReceiptEmpty(completion.receipt):
        return false
    return true

@borrows
fn SixSemanticRequestsContentModified(
        workspace: var lsp.LspWorkspace,
        uri: str,
        line: int32,
        column: int32): bool =
    if !FiveSemanticRequestsContentModified(
            workspace, uri, line, column):
        return false
    var diagnostics: lsp.LspExactDiagnosticsResult
    var err: str
    return !lsp.LspWorkspaceExactDiagnosticsInto(
               workspace, uri, diagnostics, err) &&
        strings.StrContains(err, "content modified") &&
        diagnostics.items.len == 0 && ReceiptEmpty(diagnostics.receipt)

@borrows
fn RejectedDiagnosticsCurrent(
        workspace: var lsp.LspWorkspace,
        uri: str,
        sourceVersion: int64): bool =
    var diagnostics: lsp.LspExactDiagnosticsResult
    var err: str
    return lsp.LspWorkspaceExactDiagnosticsInto(
               workspace, uri, diagnostics, err) &&
        diagnostics.receipt.rejected &&
        diagnostics.receipt.sourceVersion == sourceVersion &&
        diagnostics.items.len == 1 &&
        diagnostics.items[0].code != "" &&
        strings.StrContains(
            diagnostics.items[0].message,
            strutil.Join([
                "source_version=", strings.Int64ToStr(sourceVersion)], "")) &&
        !layout.FixedBytes32Equal(
            diagnostics.receipt.failureDiagnosticRootCid,
            layout.FixedBytes32()) &&
        !layout.FixedBytes32Equal(
            diagnostics.receipt.failureCargoCid,
            layout.FixedBytes32())

fn RejectedTwoDocumentVersionExact(
        workspace: lsp.LspWorkspace,
        sourceVersion: int64,
        helperClientVersion: int64,
        helperOpen: int32,
        helperLastEventSourceVersion: int64,
        helperLastEventKind: int32,
        mainClientVersion: int64,
        mainLastEventSourceVersion: int64,
        mainLastEventKind: int32): bool =
    let state = workspace.eventState
    let store = workspace.snapshotStore
    let snapshotIndex = store.core.states.len - 1
    let rejectionIndex = store.rejectionStates.len - 1
    if snapshotIndex < 0 || rejectionIndex < 0 ||
       state.documentCids.len != 2 || state.clientVersions.len != 2 ||
       state.documentOpenStates.len != 2 ||
       state.documentLastEventSourceVersions.len != 2 ||
       state.documentLastEventKinds.len != 2 ||
       store.core.currentSourceVersion != sourceVersion ||
       state.lastAcceptedSourceVersion != sourceVersion ||
       state.nextSourceVersion != sourceVersion + int64(1) ||
       store.core.candidateIndex != -1 ||
       store.core.sourceVersions[snapshotIndex] != sourceVersion ||
       store.core.states[snapshotIndex] !=
           snapshot_core.SemanticSnapshotStateRejected ||
       store.rejectionSourceVersions[rejectionIndex] != sourceVersion:
        return false
    let binding = store.rejectionBindings[rejectionIndex]
    return layout.FixedBytes32Equal(
               state.documentCids[0], workspace.documents[0].documentCid) &&
        layout.FixedBytes32Equal(
               state.documentCids[1], workspace.documents[1].documentCid) &&
        state.clientVersions[0] == helperClientVersion &&
        state.clientVersions[1] == mainClientVersion &&
        state.documentOpenStates[0] == helperOpen &&
        state.documentOpenStates[1] == 1 &&
        state.documentLastEventSourceVersions[0] ==
            helperLastEventSourceVersion &&
        state.documentLastEventSourceVersions[1] ==
            mainLastEventSourceVersion &&
        state.documentLastEventKinds[0] == helperLastEventKind &&
        state.documentLastEventKinds[1] == mainLastEventKind &&
        workspace.documents[0].clientVersion == helperClientVersion &&
        workspace.documents[0].open == (helperOpen == 1) &&
        workspace.documents[1].clientVersion == mainClientVersion &&
        workspace.documents[1].open &&
        binding.sourceVersion == sourceVersion &&
        binding.clientVersions.len == 2 &&
        binding.documentOpenStates.len == 2 &&
        binding.clientVersions[0] == helperClientVersion &&
        binding.clientVersions[1] == mainClientVersion &&
        binding.documentOpenStates[0] == helperOpen &&
        binding.documentOpenStates[1] == 1

fn DefinitionAtInto(
        workspace: var lsp.LspWorkspace,
        uri: var str,
        line: int32,
        column: int32,
        out: var lsp.LspExactDefinitionResult) =
    var result: lsp.LspExactDefinitionResult
    var err: str
    assert(lsp.LspWorkspaceExactDefinitionInto(
               workspace, uri, line, column, result, err), err)
    assert(result.found && result.targetSymbolId >= 0 &&
           result.targetDeclId >= 0 &&
           !layout.FixedBytes32Equal(
               result.targetSymbolCid, layout.FixedBytes32()) &&
           !layout.FixedBytes32Equal(
               result.targetDeclKeyCid, layout.FixedBytes32()) &&
           ReceiptPublished(result.receipt),
           "lsp multifile exact: definition lacks exact published identity")
    out = result

fn AssertLocationPresent(
        locations: var lsp.LspExactLocation[],
        uri: var str,
        line: int32): bool =
    for index in 0..<locations.len:
        if locations[index].uri == uri &&
           locations[index].startLine == line:
            return true
    return false

fn AssertLocationExactPresent(
        locations: var lsp.LspExactLocation[],
        uri: var str,
        line: int32,
        column: int32): bool =
    for index in 0..<locations.len:
        if locations[index].uri == uri &&
           locations[index].startLine == line &&
           locations[index].startColumn == column:
            return true
    return false

fn AssertBaselineQueriesInto(
        workspace: var lsp.LspWorkspace,
        uriMain: var str,
        uriHelper: var str,
        out: var lsp.LspExactDefinitionResult) =
    var err: str
    var helperDefinition: lsp.LspExactDefinitionResult
    DefinitionAtInto(workspace, uriMain, 7, 30, helperDefinition)
    assert(helperDefinition.location.uri == uriHelper &&
           helperDefinition.location.startLine == 0,
           "lsp multifile exact: alias/overload definition selected wrong declaration")

    var references: lsp.LspExactReferencesResult
    assert(lsp.LspWorkspaceExactReferencesInto(
               workspace, uriMain, 7, 30, true, references, err), err)
    assert(references.found &&
           references.targetSymbolId == helperDefinition.targetSymbolId &&
           layout.FixedBytes32Equal(
               references.targetSymbolCid,
               helperDefinition.targetSymbolCid) &&
           references.targetDeclId == helperDefinition.targetDeclId &&
           layout.FixedBytes32Equal(
               references.targetDeclKeyCid,
               helperDefinition.targetDeclKeyCid) &&
           AssertLocationPresent(references.locations, uriHelper, 0) &&
           AssertLocationPresent(references.locations, uriMain, 7) &&
           ReceiptsEqual(references.receipt, helperDefinition.receipt),
           "lsp multifile exact: cross-module reverse references drift")

    var rename: lsp.LspExactRenameResult
    assert(lsp.LspWorkspaceExactRenameInto(
               workspace, uriMain, 7, 30,
               "ResolveRenamed", rename, err), err)
    var renameLocations: lsp.LspExactLocation[]
    for editIndex in 0..<rename.edits.len:
        assert(rename.edits[editIndex].newText == "ResolveRenamed" &&
               rename.edits[editIndex].clientVersion > int64(0),
               "lsp multifile exact: rename edit lost document version")
        add(renameLocations, rename.edits[editIndex].location)
    assert(rename.targetSymbolId == helperDefinition.targetSymbolId &&
           layout.FixedBytes32Equal(
               rename.targetSymbolCid,
               helperDefinition.targetSymbolCid) &&
           rename.targetDeclId == helperDefinition.targetDeclId &&
           layout.FixedBytes32Equal(
               rename.targetDeclKeyCid,
               helperDefinition.targetDeclKeyCid) &&
           AssertLocationPresent(renameLocations, uriHelper, 0) &&
           AssertLocationPresent(renameLocations, uriMain, 7) &&
           !AssertLocationPresent(renameLocations, uriMain, 2) &&
           !AssertLocationPresent(renameLocations, uriMain, 6) &&
           ReceiptsEqual(rename.receipt, helperDefinition.receipt),
           "lsp multifile exact: rename crossed overload/shadow SymbolId")

    var hover: lsp.LspExactHoverResult
    assert(lsp.LspWorkspaceExactHoverInto(
               workspace, uriMain, 7, 30, hover, err), err)
    assert(hover.found &&
           hover.targetSymbolId == helperDefinition.targetSymbolId &&
           hover.symbol.symbolId == helperDefinition.targetSymbolId &&
           layout.FixedBytes32Equal(
               hover.symbol.symbolCid,
               helperDefinition.targetSymbolCid) &&
           hover.targetDeclId == helperDefinition.targetDeclId &&
           layout.FixedBytes32Equal(
               hover.targetDeclKeyCid,
               helperDefinition.targetDeclKeyCid) &&
           hover.symbol.declId == hover.targetDeclId &&
           layout.FixedBytes32Equal(
               hover.symbol.declKeyCid, hover.targetDeclKeyCid) &&
           layout.FixedBytes32Equal(
               hover.symbol.declarationTableCid,
               hover.receipt.declarationTableCid) &&
           hover.symbol.declarationSpanId >= 0 &&
           hover.symbol.modulePath == "pkg/helper" &&
           ReceiptsEqual(hover.receipt, helperDefinition.receipt),
           "lsp multifile exact: hover SymbolFact declaration identity drift")

    var completion: lsp.LspExactCompletionResult
    assert(lsp.LspWorkspaceExactCompletionInto(
               workspace, uriMain, 7, 28, completion, err), err)
    var overloadIds: int32[]
    var exactCompletionObserved = false
    for itemIndex in 0..<completion.items.len:
        let item = completion.items[itemIndex]
        if item.name == "Resolve" && item.modulePath == "pkg/helper":
            for prior in 0..<overloadIds.len:
                assert(overloadIds[prior] != item.symbolId,
                       "lsp multifile exact: completion duplicated SymbolId")
            add(overloadIds, item.symbolId)
            if item.symbolId == helperDefinition.targetSymbolId &&
               layout.FixedBytes32Equal(
                   item.symbolCid, helperDefinition.targetSymbolCid) &&
               item.declId == helperDefinition.targetDeclId &&
               layout.FixedBytes32Equal(
                   item.declKeyCid,
                   helperDefinition.targetDeclKeyCid):
                exactCompletionObserved = true
    assert(overloadIds.len == 2 && exactCompletionObserved &&
           ReceiptsEqual(completion.receipt, helperDefinition.receipt),
           "lsp multifile exact: overload completion identity drift")

    var diagnostics: lsp.LspExactDiagnosticsResult
    assert(lsp.LspWorkspaceExactDiagnosticsInto(
               workspace, uriMain, diagnostics, err), err)
    assert(diagnostics.items.len == 0 &&
           ReceiptsEqual(diagnostics.receipt, helperDefinition.receipt),
           "lsp multifile exact: diagnostics used a different snapshot")

    var sameNameDefinition: lsp.LspExactDefinitionResult
    DefinitionAtInto(workspace, uriMain, 8, 22, sameNameDefinition)
    assert(sameNameDefinition.location.uri == uriMain &&
           sameNameDefinition.location.startLine == 2 &&
           sameNameDefinition.targetSymbolId !=
               helperDefinition.targetSymbolId &&
           sameNameDefinition.targetDeclId !=
               helperDefinition.targetDeclId &&
           !layout.FixedBytes32Equal(
               sameNameDefinition.targetSymbolCid,
               helperDefinition.targetSymbolCid) &&
           !layout.FixedBytes32Equal(
               sameNameDefinition.targetDeclKeyCid,
               helperDefinition.targetDeclKeyCid) &&
           ReceiptsEqual(
               sameNameDefinition.receipt,
               helperDefinition.receipt),
           "lsp multifile exact: same-name module isolation failed")

    var shadowDefinition: lsp.LspExactDefinitionResult
    DefinitionAtInto(workspace, uriMain, 9, 38, shadowDefinition)
    assert(shadowDefinition.location.uri == uriMain &&
           shadowDefinition.location.startLine == 6 &&
           shadowDefinition.targetSymbolId !=
               helperDefinition.targetSymbolId &&
           shadowDefinition.targetSymbolId !=
               sameNameDefinition.targetSymbolId &&
           shadowDefinition.targetDeclId !=
               helperDefinition.targetDeclId &&
           shadowDefinition.targetDeclId !=
               sameNameDefinition.targetDeclId &&
           !layout.FixedBytes32Equal(
               shadowDefinition.targetDeclKeyCid,
               helperDefinition.targetDeclKeyCid) &&
           !layout.FixedBytes32Equal(
               shadowDefinition.targetDeclKeyCid,
               sameNameDefinition.targetDeclKeyCid) &&
           ReceiptsEqual(
               shadowDefinition.receipt,
               helperDefinition.receipt),
           "lsp multifile exact: lexical shadow resolved by text")

    var parameterDefinition: lsp.LspExactDefinitionResult
    DefinitionAtInto(
        workspace, uriHelper, 1, 12, parameterDefinition)
    assert(parameterDefinition.location.uri == uriHelper &&
           parameterDefinition.location.startLine == 0 &&
           parameterDefinition.location.startColumn == 11 &&
           parameterDefinition.targetSymbolId !=
               helperDefinition.targetSymbolId,
           "lsp multifile exact: ParamRef did not select exact parameter")
    var parameterReferences: lsp.LspExactReferencesResult
    assert(lsp.LspWorkspaceExactReferencesInto(
               workspace, uriHelper, 1, 12, true,
               parameterReferences, err), err)
    assert(parameterReferences.targetSymbolId ==
               parameterDefinition.targetSymbolId &&
           parameterReferences.locations.len == 2 &&
           AssertLocationExactPresent(
               parameterReferences.locations, uriHelper, 0, 11) &&
           AssertLocationExactPresent(
               parameterReferences.locations, uriHelper, 1, 11) &&
           !AssertLocationPresent(
               parameterReferences.locations, uriHelper, 3) &&
           !AssertLocationPresent(
               parameterReferences.locations, uriHelper, 4),
           "lsp multifile exact: ParamRef crossed overloaded Function identity")

    var localReferences: lsp.LspExactReferencesResult
    assert(lsp.LspWorkspaceExactReferencesInto(
               workspace, uriMain, 9, 38, true,
               localReferences, err), err)
    assert(localReferences.targetSymbolId ==
               shadowDefinition.targetSymbolId &&
           localReferences.locations.len == 2 &&
           AssertLocationExactPresent(
               localReferences.locations, uriMain, 6, 8) &&
           AssertLocationExactPresent(
               localReferences.locations, uriMain, 9, 36) &&
           !AssertLocationPresent(
               localReferences.locations, uriMain, 12) &&
           !AssertLocationPresent(
               localReferences.locations, uriMain, 13),
           "lsp multifile exact: LocalRef crossed same-name Function identity")

    var leftDefinition: lsp.LspExactDefinitionResult
    var rightDefinition: lsp.LspExactDefinitionResult
    DefinitionAtInto(workspace, uriMain, 17, 12, leftDefinition)
    DefinitionAtInto(workspace, uriMain, 17, 19, rightDefinition)
    assert(leftDefinition.location.startLine == 16 &&
           leftDefinition.location.startColumn == 9 &&
           rightDefinition.location.startLine == 16 &&
           rightDefinition.location.startColumn == 15 &&
           leftDefinition.targetSymbolId !=
               rightDefinition.targetSymbolId &&
           leftDefinition.targetDeclId != rightDefinition.targetDeclId &&
           !layout.FixedBytes32Equal(
               leftDefinition.targetDeclKeyCid,
               rightDefinition.targetDeclKeyCid),
           "lsp multifile exact: multi-binding identities collapsed")
    var leftReferences: lsp.LspExactReferencesResult
    var rightReferences: lsp.LspExactReferencesResult
    assert(lsp.LspWorkspaceExactReferencesInto(
               workspace, uriMain, 17, 12, true,
               leftReferences, err), err)
    assert(lsp.LspWorkspaceExactReferencesInto(
               workspace, uriMain, 17, 19, true,
               rightReferences, err), err)
    assert(leftReferences.targetSymbolId ==
               leftDefinition.targetSymbolId &&
           rightReferences.targetSymbolId ==
               rightDefinition.targetSymbolId &&
           leftReferences.locations.len == 2 &&
           rightReferences.locations.len == 2 &&
           AssertLocationExactPresent(
               leftReferences.locations, uriMain, 16, 9) &&
           AssertLocationExactPresent(
               leftReferences.locations, uriMain, 17, 11) &&
           !AssertLocationExactPresent(
               leftReferences.locations, uriMain, 16, 15) &&
           !AssertLocationExactPresent(
               leftReferences.locations, uriMain, 17, 18) &&
           AssertLocationExactPresent(
               rightReferences.locations, uriMain, 16, 15) &&
           AssertLocationExactPresent(
               rightReferences.locations, uriMain, 17, 18) &&
           !AssertLocationExactPresent(
               rightReferences.locations, uriMain, 16, 9) &&
           !AssertLocationExactPresent(
               rightReferences.locations, uriMain, 17, 11),
           "lsp multifile exact: multi-binding reverse references crossed")

    var innerShadowDefinition: lsp.LspExactDefinitionResult
    var outerShadowDefinition: lsp.LspExactDefinitionResult
    DefinitionAtInto(
        workspace, uriMain, 23, 16, innerShadowDefinition)
    DefinitionAtInto(
        workspace, uriMain, 24, 12, outerShadowDefinition)
    assert(innerShadowDefinition.location.startLine == 22 &&
           innerShadowDefinition.location.startColumn == 12 &&
           outerShadowDefinition.location.startLine == 20 &&
           outerShadowDefinition.location.startColumn == 8 &&
           innerShadowDefinition.targetSymbolId !=
               outerShadowDefinition.targetSymbolId &&
           innerShadowDefinition.targetDeclId !=
               outerShadowDefinition.targetDeclId,
           "lsp multifile exact: nested same-name LocalRef shadow collapsed")
    out = helperDefinition

@borrows
fn AssertSamePinDefinitionReferencesRenameOwnershipInto(
        workspace: var lsp.LspWorkspace,
        uriMain: str,
        uriHelper: str) =
    var err: str
    let documentRow = lsp.lspWorkspaceFindDocumentByUri(
        workspace, uriMain)
    assert(documentRow >= 0 && workspace.documents[documentRow].open,
           "lsp same-pin owner: request document missing")
    let documentCid = workspace.documents[documentRow].documentCid
    var pin: snapshot_production.SemanticSnapshotProductionPin
    var receipt: lsp.LspExactQueryReceipt
    assert(lsp.lspWorkspacePinCompilerFactsInto(
               workspace, pin, receipt, err), err)

    var snapshotColumn: int32
    assert(lsp.lspPinnedRequestPositionInto(
               workspace, pin, uriMain, documentCid,
               7, 30, snapshotColumn, err), err)
    var symbolId: int32
    var found: bool
    assert(lsp.lspFindTargetSymbolIdAtPositionInto(
               workspace, pin, documentCid, 7, snapshotColumn,
               symbolId, found, err) &&
           found && symbolId >= 0,
           err)
    var definitionLocation: lsp.LspExactLocation
    var definitionDeclId: int32
    var definitionDeclKeyCid: layout.FixedBytes32
    assert(lsp.lspPinnedSymbolDeclarationInto(
               workspace, pin, symbolId,
               definitionDeclId, definitionDeclKeyCid, err) &&
           lsp.lspPinnedSymbolNavigationLocationInto(
               workspace, pin, symbolId, definitionLocation, err),
           err)

    var references: lsp.LspExactReferencesResult
    assert(lsp.lspExactReferencesFromPinnedInto(
               workspace, pin, receipt, documentCid,
               7, snapshotColumn, true, references, err) &&
           references.found &&
           references.targetSymbolId == symbolId &&
           references.targetDeclId == definitionDeclId &&
           layout.FixedBytes32Equal(
               references.targetDeclKeyCid, definitionDeclKeyCid),
           err)

    var renameReferences: lsp.LspExactReferencesResult
    assert(lsp.lspExactReferencesFromPinnedInto(
               workspace, pin, receipt, documentCid,
               7, snapshotColumn, true, renameReferences, err) &&
           renameReferences.found &&
           renameReferences.targetSymbolId == symbolId,
           err)
    var rename: lsp.LspExactRenameResult
    rename.targetSymbolId = renameReferences.targetSymbolId
    rename.targetSymbolCid = renameReferences.targetSymbolCid
    rename.targetDeclId = renameReferences.targetDeclId
    rename.targetDeclKeyCid = renameReferences.targetDeclKeyCid
    rename.receipt = renameReferences.receipt
    for locationIndex in 0..<renameReferences.locations.len:
        let location = renameReferences.locations[locationIndex]
        var targetDocument: query_projection.SemanticSnapshotSourceDocument
        assert(lsp.lspPinnedSourceDocumentInto(
                   workspace, pin, location.documentCid,
                   targetDocument, err), err)
        var edit: lsp.LspExactRenameEdit
        edit.location = location
        edit.clientVersion = targetDocument.clientVersion
        edit.newText = system.SystemToStringStr("ResolveRenamed")
        add(rename.edits, edit)

    var ownedDefinitionDocument: query_projection.SemanticSnapshotSourceDocument
    assert(lsp.lspPinnedSourceDocumentInto(
               workspace, pin, definitionLocation.documentCid,
               ownedDefinitionDocument, err), err)
    lsp.lspWorkspaceReleasePin(workspace, pin)
    assert(!pin.active &&
           definitionLocation.uri == uriHelper &&
           ownedDefinitionDocument.uri == uriHelper &&
           strings.StrContains(
               ownedDefinitionDocument.text, "fn Resolve") &&
           references.locations.len >= 2 &&
           rename.edits.len == references.locations.len,
           "lsp same-pin owner: released pin invalidated owned URI/text")
    var referenceHelperFound = false
    for locationIndex in 0..<references.locations.len:
        if references.locations[locationIndex].uri == uriHelper:
            referenceHelperFound = true
    var renameHelperFound = false
    for editIndex in 0..<rename.edits.len:
        assert(rename.edits[editIndex].newText == "ResolveRenamed",
               "lsp same-pin owner: rename text owner invalid after release")
        if rename.edits[editIndex].location.uri == uriHelper:
            renameHelperFound = true
    assert(referenceHelperFound && renameHelperFound,
           "lsp same-pin owner: owned locations invalid after release")

fn AssertPublishedOpenDocumentUniverseInto(
        workspace: var lsp.LspWorkspace,
        uris: str[],
        out: var layout.FixedBytes32) =
    let publishedIndex = workspace.snapshotStore.core.publishedIndex
    assert(publishedIndex >= 0 &&
           publishedIndex <
               workspace.snapshotStore.payloadQueryProjections.len &&
           publishedIndex <
               workspace.snapshotStore.payloadTables.len,
           "lsp multifile exact: open document universe is not published")
    let projection =
        workspace.snapshotStore.payloadQueryProjections[publishedIndex]
    let sources =
        workspace.snapshotStore.payloadTables[publishedIndex].sources
    assert(projection.documents.len == uris.len &&
           projection.openDocumentSourceIds.len == uris.len &&
           sources.documentCids.len == uris.len &&
           !layout.FixedBytes32Equal(
               projection.openDocumentUniverseCid,
               layout.FixedBytes32()),
           "lsp multifile exact: open document universe shape drift")
    for uriIndex in 0..<uris.len:
        let sourceId = PublishedSourceIdForUri(
            workspace, publishedIndex, uris[uriIndex])
        assert(sourceId >= 0 &&
               sourceId < projection.documents.len &&
               projection.documents[sourceId].uri == uris[uriIndex] &&
               projection.documents[sourceId].open &&
               layout.FixedBytes32Equal(
                   projection.documents[sourceId].documentCid,
                   sources.documentCids[sourceId]),
               "lsp multifile exact: open document source identity split")
        var openRowMatchCount: int32
        for openRow in 0..<projection.openDocumentSourceIds.len:
            if projection.openDocumentSourceIds[openRow] == sourceId:
                openRowMatchCount = openRowMatchCount + 1
        assert(openRowMatchCount == 1,
               "lsp multifile exact: open document source row is not exact")
    out = layout.FixedBytes32Copy(
        projection.openDocumentUniverseCid)

fn AssertDetachedConsumerQueriesInto(
        workspace: var lsp.LspWorkspace,
        uriMain: var str,
        uriHelper: var str,
        uriDetached: var str,
        out: var lsp.LspExactDefinitionResult) =
    var err: str
    var mainDefinition: lsp.LspExactDefinitionResult
    var detachedDefinition: lsp.LspExactDefinitionResult
    DefinitionAtInto(workspace, uriMain, 7, 30, mainDefinition)
    DefinitionAtInto(
        workspace, uriDetached, 3, 20, detachedDefinition)
    assert(detachedDefinition.found &&
           detachedDefinition.location.uri == uriHelper &&
           detachedDefinition.location.startLine == 0 &&
           detachedDefinition.targetSymbolId ==
               mainDefinition.targetSymbolId &&
           layout.FixedBytes32Equal(
               detachedDefinition.targetSymbolCid,
               mainDefinition.targetSymbolCid) &&
           detachedDefinition.targetDeclId ==
               mainDefinition.targetDeclId &&
           layout.FixedBytes32Equal(
               detachedDefinition.targetDeclKeyCid,
               mainDefinition.targetDeclKeyCid) &&
           ReceiptsEqual(
               detachedDefinition.receipt,
               mainDefinition.receipt),
           "lsp multifile exact: detached definition lost exact declaration identity")

    var references: lsp.LspExactReferencesResult
    assert(lsp.LspWorkspaceExactReferencesInto(
               workspace, uriMain, 7, 30, true,
               references, err), err)
    assert(references.found &&
           references.targetSymbolId ==
               mainDefinition.targetSymbolId &&
           layout.FixedBytes32Equal(
               references.targetSymbolCid,
               mainDefinition.targetSymbolCid) &&
           references.targetDeclId == mainDefinition.targetDeclId &&
           layout.FixedBytes32Equal(
               references.targetDeclKeyCid,
               mainDefinition.targetDeclKeyCid) &&
           references.locations.len == 3 &&
           AssertLocationPresent(
               references.locations, uriHelper, 0) &&
           AssertLocationPresent(
               references.locations, uriMain, 7) &&
           AssertLocationExactPresent(
               references.locations, uriDetached, 3, 18) &&
           ReceiptsEqual(
               references.receipt, mainDefinition.receipt),
           "lsp multifile exact: reverse references omitted detached open document")

    var rename: lsp.LspExactRenameResult
    assert(lsp.LspWorkspaceExactRenameInto(
               workspace, uriDetached, 3, 20,
               "ResolveAcrossOpenDocuments", rename, err), err)
    var renameLocations: lsp.LspExactLocation[]
    for editIndex in 0..<rename.edits.len:
        add(renameLocations, rename.edits[editIndex].location)
    assert(rename.targetSymbolId ==
               mainDefinition.targetSymbolId &&
           layout.FixedBytes32Equal(
               rename.targetSymbolCid,
               mainDefinition.targetSymbolCid) &&
           rename.targetDeclId == mainDefinition.targetDeclId &&
           layout.FixedBytes32Equal(
               rename.targetDeclKeyCid,
               mainDefinition.targetDeclKeyCid) &&
           rename.edits.len == 3 &&
           AssertLocationPresent(renameLocations, uriHelper, 0) &&
           AssertLocationPresent(renameLocations, uriMain, 7) &&
           AssertLocationExactPresent(
               renameLocations, uriDetached, 3, 18) &&
           ReceiptsEqual(rename.receipt, mainDefinition.receipt),
           "lsp multifile exact: rename omitted detached open document")

    let publishedIndex = workspace.snapshotStore.core.publishedIndex
    let detachedSourceId = PublishedSourceIdForUri(
        workspace, publishedIndex, uriDetached)
    let helperSourceId = PublishedSourceIdForUri(
        workspace, publishedIndex, uriHelper)
    var detachedOpenRow: int32 = -1
    for openRow in 0..<workspace.snapshotStore.payloadQueryProjections[
            publishedIndex].openDocumentSourceIds.len:
        if workspace.snapshotStore.payloadQueryProjections[
                publishedIndex].openDocumentSourceIds[openRow] ==
               detachedSourceId:
            detachedOpenRow = openRow
    assert(detachedOpenRow >= 0 &&
           detachedSourceId != helperSourceId,
           "lsp multifile exact: detached open document row missing")
    workspace.snapshotStore.payloadQueryProjections[
        publishedIndex].openDocumentSourceIds[detachedOpenRow] =
        helperSourceId
    assert(FiveSemanticRequestsContentModified(
               workspace, uriMain, 7, 30),
           "lsp multifile exact: open document source-row mutation survived")
    workspace.snapshotStore.payloadQueryProjections[
        publishedIndex].openDocumentSourceIds[detachedOpenRow] =
        detachedSourceId
    var restored: lsp.LspExactDefinitionResult
    DefinitionAtInto(workspace, uriDetached, 3, 20, restored)
    assert(restored.targetSymbolId ==
               detachedDefinition.targetSymbolId &&
           ReceiptsEqual(
               restored.receipt, detachedDefinition.receipt),
           "lsp multifile exact: open document source-row restoration drift")
    out = restored

fn AssertBindingAuthorityMutationRejected(
        workspace: var lsp.LspWorkspace,
        publishedIndex: int32,
        uriMain: var str) =
    var leftDefinition: lsp.LspExactDefinitionResult
    var rightDefinition: lsp.LspExactDefinitionResult
    DefinitionAtInto(workspace, uriMain, 17, 12, leftDefinition)
    DefinitionAtInto(workspace, uriMain, 17, 19, rightDefinition)
    var leftReferenceId: int32 = -1
    var rightReferenceId: int32 = -1
    let referenceCount =
        workspace.snapshotStore.payloadTables[
            publishedIndex].references.targetSymbolIds.len
    for referenceId in 0..<referenceCount:
        let targetSymbolId =
            workspace.snapshotStore.payloadTables[
                publishedIndex].references.targetSymbolIds[referenceId]
        let typedNodeId =
            workspace.snapshotStore.payloadTables[
                publishedIndex].references.bindingTypedNodeIds[referenceId]
        if targetSymbolId == leftDefinition.targetSymbolId &&
           typedNodeId >= 0:
            assert(leftReferenceId < 0,
                   "lsp multifile exact: duplicate left binding reference")
            leftReferenceId = referenceId
        elif targetSymbolId == rightDefinition.targetSymbolId &&
             typedNodeId >= 0:
            assert(rightReferenceId < 0,
                   "lsp multifile exact: duplicate right binding reference")
            rightReferenceId = referenceId
    assert(leftReferenceId >= 0 && rightReferenceId >= 0,
           "lsp multifile exact: multi-binding reference authority missing")
    let leftTypedNodeId =
        workspace.snapshotStore.payloadTables[
            publishedIndex].references.bindingTypedNodeIds[leftReferenceId]
    let rightTypedNodeId =
        workspace.snapshotStore.payloadTables[
            publishedIndex].references.bindingTypedNodeIds[rightReferenceId]
    assert(leftTypedNodeId != rightTypedNodeId &&
           workspace.snapshotStore.payloadTables[
               publishedIndex].typedNodes.opKinds[leftTypedNodeId] ==
               snapshot_schema.CsgCompilerTypedOpLocalRef &&
           workspace.snapshotStore.payloadTables[
               publishedIndex].typedNodes.opKinds[rightTypedNodeId] ==
               snapshot_schema.CsgCompilerTypedOpLocalRef,
           "lsp multifile exact: multi-binding TypedNode identity collapsed")

    workspace.snapshotStore.payloadTables[
        publishedIndex].references.bindingTypedNodeIds[leftReferenceId] =
        rightTypedNodeId
    assert(FiveSemanticRequestsContentModified(
               workspace, uriMain, 17, 12),
           "lsp multifile exact: ReferenceId/TypedNodeId substitution survived")
    workspace.snapshotStore.payloadTables[
        publishedIndex].references.bindingTypedNodeIds[leftReferenceId] =
        leftTypedNodeId

    let leftOriginParserNodeId =
        workspace.snapshotStore.payloadTables[
            publishedIndex].typedNodes.originParserNodeIds[leftTypedNodeId]
    let rightOriginParserNodeId =
        workspace.snapshotStore.payloadTables[
            publishedIndex].typedNodes.originParserNodeIds[rightTypedNodeId]
    let leftDeclarationLocalRow =
        workspace.snapshotStore.payloadTables[
            publishedIndex].parserNodes.bindingDeclarationSourceLocalRows[
                leftOriginParserNodeId]
    let rightDeclarationLocalRow =
        workspace.snapshotStore.payloadTables[
            publishedIndex].parserNodes.bindingDeclarationSourceLocalRows[
                rightOriginParserNodeId]
    assert(leftDeclarationLocalRow != rightDeclarationLocalRow,
           "lsp multifile exact: Parser declaration identities collapsed")
    workspace.snapshotStore.payloadTables[
        publishedIndex].parserNodes.bindingDeclarationSourceLocalRows[
            leftOriginParserNodeId] = rightDeclarationLocalRow
    assert(FiveSemanticRequestsContentModified(
               workspace, uriMain, 17, 12),
           "lsp multifile exact: Parser binding substitution survived")
    workspace.snapshotStore.payloadTables[
        publishedIndex].parserNodes.bindingDeclarationSourceLocalRows[
            leftOriginParserNodeId] = leftDeclarationLocalRow

    let leftValueDefinitionRow =
        workspace.snapshotStore.payloadTables[
            publishedIndex].typedNodes.bindingValueDefinitionRows[
                leftTypedNodeId]
    let rightValueDefinitionRow =
        workspace.snapshotStore.payloadTables[
            publishedIndex].typedNodes.bindingValueDefinitionRows[
                rightTypedNodeId]
    assert(leftValueDefinitionRow != rightValueDefinitionRow,
           "lsp multifile exact: TypedExpr value definitions collapsed")
    workspace.snapshotStore.payloadTables[
        publishedIndex].typedNodes.bindingValueDefinitionRows[
            leftTypedNodeId] = rightValueDefinitionRow
    assert(FiveSemanticRequestsContentModified(
               workspace, uriMain, 17, 12),
           "lsp multifile exact: TypedExpr binding substitution survived")
    workspace.snapshotStore.payloadTables[
        publishedIndex].typedNodes.bindingValueDefinitionRows[
            leftTypedNodeId] = leftValueDefinitionRow
    var restored: lsp.LspExactDefinitionResult
    DefinitionAtInto(workspace, uriMain, 17, 12, restored)
    assert(restored.targetSymbolId == leftDefinition.targetSymbolId &&
           ReceiptsEqual(restored.receipt, leftDefinition.receipt),
           "lsp multifile exact: binding authority restoration drift")

fn PublishOrReportRed(
        workspace: var lsp.LspWorkspace,
        uriMain: str,
        sourceVersion: int64): bool =
    if CurrentVersionPublished(workspace, sourceVersion) &&
       workspace.metrics.candidatePublishedCount > int64(0):
        return true
    let contentModified = FiveSemanticRequestsContentModified(
        workspace, uriMain, 7, 30)
    os.WriteLine(os.Get_stdout(), Fmt"lsp_multifile_exact_snapshot_acceptance_status=red source_version={sourceVersion} published={workspace.metrics.candidatePublishedCount} rejected={workspace.metrics.candidateRejectedCount} completed_stage_bitmap={workspace.candidateAdmissionCompletedStageBitmap} missing_fact_bitmap={workspace.candidateAdmissionMissingFactBitmap} all_queries_content_modified={contentModified ? 1 : 0} admission_receipt={layout.FixedBytes32Hex(workspace.candidateAdmissionReceiptCid)} blocked_reason={workspace.candidateBlockedReason}")
    return false

fn RunVersionIsolationInto(
        workspace: var lsp.LspWorkspace,
        uriMain: var str,
        uriHelper: var str,
        textHelper: str,
        sourceVersion: var int64,
        err: var str): bool =
    if !RejectedTwoDocumentVersionExact(
            workspace, int64(2), int64(10), 1,
            int64(1), snapshot_core.SemanticSourceEventOpen,
            int64(100), int64(2), snapshot_core.SemanticSourceEventOpen) ||
       !FiveSemanticRequestsContentModified(
            workspace, uriMain, 7, 30) ||
       !FiveSemanticRequestsContentModified(
            workspace, uriHelper, 1, 11) ||
       !RejectedDiagnosticsCurrent(workspace, uriMain, int64(2)) ||
       !RejectedDiagnosticsCurrent(workspace, uriHelper, int64(2)):
        err = " lsp multifile version isolation: initial documents crossed"
        return false

    var mainChange: lsp.LspContentChange
    mainChange.rangePresent = true
    mainChange.startLine = 3
    mainChange.startCharacter = 11
    mainChange.endLine = 3
    mainChange.endCharacter = 13
    mainChange.rangeLengthPresent = true
    mainChange.rangeLength = 2
    mainChange.text = "23"
    let beforeStaleVersion =
        workspace.snapshotStore.core.currentSourceVersion
    if lsp.LspWorkspaceDidChangeInto(
           workspace, uriMain, int64(100), [mainChange],
           sourceVersion, err) || sourceVersion != int64(0) ||
       workspace.snapshotStore.core.currentSourceVersion !=
           beforeStaleVersion ||
       workspace.eventState.clientVersions[0] != int64(10) ||
       workspace.eventState.clientVersions[1] != int64(100):
        err = " lsp multifile version isolation: stale main version mutated state"
        return false

    var helperChange: lsp.LspContentChange
    helperChange.rangePresent = true
    helperChange.startLine = 1
    helperChange.startCharacter = 16
    helperChange.endLine = 1
    helperChange.endCharacter = 16
    helperChange.rangeLengthPresent = true
    helperChange.rangeLength = 0
    helperChange.text = " + 1"
    if !lsp.LspWorkspaceDidChangeInto(
           workspace, uriHelper, int64(11), [helperChange],
           sourceVersion, err) || sourceVersion != int64(3) ||
       !RejectedTwoDocumentVersionExact(
            workspace, sourceVersion, int64(11), 1,
            int64(3), snapshot_core.SemanticSourceEventChange,
            int64(100), int64(2), snapshot_core.SemanticSourceEventOpen) ||
       !FiveSemanticRequestsContentModified(
            workspace, uriMain, 7, 30) ||
       !RejectedDiagnosticsCurrent(workspace, uriMain, sourceVersion):
        err = " lsp multifile version isolation: helper change crossed main"
        return false

    if lsp.LspWorkspaceDidChangeInto(
           workspace, uriMain, int64(11), [mainChange],
           sourceVersion, err) || sourceVersion != int64(0) ||
       workspace.snapshotStore.core.currentSourceVersion != int64(3) ||
       workspace.eventState.clientVersions[0] != int64(11) ||
       workspace.eventState.clientVersions[1] != int64(100):
        err = " lsp multifile version isolation: helper client version accepted for main"
        return false

    if !lsp.LspWorkspaceDidChangeInto(
           workspace, uriMain, int64(101), [mainChange],
           sourceVersion, err) || sourceVersion != int64(4) ||
       !RejectedTwoDocumentVersionExact(
            workspace, sourceVersion, int64(11), 1,
            int64(3), snapshot_core.SemanticSourceEventChange,
            int64(101), int64(4), snapshot_core.SemanticSourceEventChange) ||
       !FiveSemanticRequestsContentModified(
            workspace, uriHelper, 1, 11) ||
       !RejectedDiagnosticsCurrent(workspace, uriHelper, sourceVersion):
        err = " lsp multifile version isolation: main change crossed helper"
        return false

    if !lsp.LspWorkspaceDidCloseInto(
           workspace, uriHelper, sourceVersion, err) ||
       sourceVersion != int64(5) ||
       !RejectedTwoDocumentVersionExact(
            workspace, sourceVersion, int64(11), 0,
            int64(5), snapshot_core.SemanticSourceEventClose,
            int64(101), int64(4), snapshot_core.SemanticSourceEventChange) ||
       !FiveSemanticRequestsContentModified(
            workspace, uriMain, 7, 30) ||
       !RejectedDiagnosticsCurrent(workspace, uriMain, sourceVersion):
        err = " lsp multifile version isolation: helper close leaked old result"
        return false

    if !lsp.LspWorkspaceDidOpenInto(
           workspace, uriHelper, int64(12), textHelper,
           sourceVersion, err) || sourceVersion != int64(6) ||
       !RejectedTwoDocumentVersionExact(
            workspace, sourceVersion, int64(12), 1,
            int64(6), snapshot_core.SemanticSourceEventOpen,
            int64(101), int64(4), snapshot_core.SemanticSourceEventChange) ||
       !FiveSemanticRequestsContentModified(
            workspace, uriMain, 7, 30) ||
       !RejectedDiagnosticsCurrent(workspace, uriMain, sourceVersion):
        err = " lsp multifile version isolation: helper reopen leaked old result"
        return false

    if !lsp.LspWorkspaceDidChangeInto(
           workspace, uriHelper, int64(13), [helperChange],
           sourceVersion, err) || sourceVersion != int64(7) ||
       !RejectedTwoDocumentVersionExact(
            workspace, sourceVersion, int64(13), 1,
            int64(7), snapshot_core.SemanticSourceEventChange,
            int64(101), int64(4), snapshot_core.SemanticSourceEventChange):
        err = " lsp multifile version isolation: reopened helper version drift"
        return false

    mainChange.startCharacter = 12
    mainChange.endCharacter = 13
    mainChange.rangeLength = 1
    mainChange.text = "4"
    if lsp.LspWorkspaceDidChangeInto(
           workspace, uriMain, int64(13), [mainChange],
           sourceVersion, err) || sourceVersion != int64(0) ||
       workspace.snapshotStore.core.currentSourceVersion != int64(7) ||
       workspace.eventState.clientVersions[0] != int64(13) ||
       workspace.eventState.clientVersions[1] != int64(101):
        err = " lsp multifile version isolation: reopened helper version crossed main"
        return false
    if !lsp.LspWorkspaceDidChangeInto(
           workspace, uriMain, int64(102), [mainChange],
           sourceVersion, err) || sourceVersion != int64(8) ||
       !RejectedTwoDocumentVersionExact(
            workspace, sourceVersion, int64(13), 1,
            int64(7), snapshot_core.SemanticSourceEventChange,
            int64(102), int64(8), snapshot_core.SemanticSourceEventChange):
        err = " lsp multifile version isolation: final main version drift"
        return false

    if !snapshot_production.SemanticSnapshotProductionAcceptSourceEventInto(
           workspace.eventState, workspace.snapshotStore,
           snapshot_core.SemanticSourceEventChange,
           workspace.documents[1].documentCid, int64(103),
           sourceVersion, err) || sourceVersion != int64(9):
        return false
    let priorSnapshotIndex = workspace.snapshotStore.core.states.len - 1
    if workspace.snapshotStore.core.currentSourceVersion != sourceVersion ||
       workspace.snapshotStore.core.candidateIndex != -1 ||
       priorSnapshotIndex < 0 ||
       workspace.snapshotStore.core.sourceVersions[priorSnapshotIndex] !=
           sourceVersion - int64(1) ||
       workspace.snapshotStore.core.states[priorSnapshotIndex] !=
           snapshot_core.SemanticSnapshotStateRejected ||
       workspace.snapshotStore.core.publishedIndex == priorSnapshotIndex:
        err = Fmt" lsp multifile version isolation: uncompleted source version state drift current={workspace.snapshotStore.core.currentSourceVersion} candidate={workspace.snapshotStore.core.candidateIndex} states={workspace.snapshotStore.core.states.len} published={workspace.snapshotStore.core.publishedIndex}"
        return false
    if !SixSemanticRequestsContentModified(
            workspace, uriMain, 7, 30):
        err = " lsp multifile version isolation: uncompleted source version exposed main result"
        return false
    if !SixSemanticRequestsContentModified(
            workspace, uriHelper, 1, 11):
        err = " lsp multifile version isolation: uncompleted source version exposed helper result"
        return false
    err = ""
    return true

fn main(): int32 =
    let workspaceRoot = os.GetEnv("CHENG_LSP_ACCEPTANCE_WORKSPACE")
    assert(workspaceRoot != "",
           "lsp multifile exact: workspace env missing")
    let sourceRoot = strutil.Join([workspaceRoot, "/src"], "")
    let sourceMain = strutil.Join([sourceRoot, "/main.cheng"], "")
    let sourceHelper = strutil.Join([sourceRoot, "/helper.cheng"], "")
    let sourceDetached =
        strutil.Join([sourceRoot, "/detached_consumer.cheng"], "")
    let sourceRenamed =
        strutil.Join([sourceRoot, "/detached_renamed.cheng"], "")
    var uriMain = strutil.Join(["file://", sourceMain], "")
    var uriHelper = strutil.Join(["file://", sourceHelper], "")
    var uriDetached = strutil.Join(["file://", sourceDetached], "")
    var uriRenamed = strutil.Join(["file://", sourceRenamed], "")
    let membershipEventsOnly =
        os.GetEnv("CHENG_LSP_SOURCE_MEMBERSHIP_ONLY") == "1"
    let candidatePreflightOnly =
        os.GetEnv("CHENG_LSP_MULTIFILE_CANDIDATE_PREFLIGHT_ONLY") == "1" ||
        membershipEventsOnly
    let acceptanceTextHelper = strutil.Join([
        "fn Resolve(value: int32): int32 =\n",
        "    return value\n\n",
        "fn Resolve(value: str): int32 =\n",
        "    return 2\n\n",
        "fn Shared(): int32 =\n",
        "    return 11\n"], "")
    let candidateTextHelper = strutil.Join([
        "importc fn NativeProbe(): int32\n\n",
        "@profile(\"candidate\")\n",
        "type Marker[T: int32 = int32] = T\n\n",
        "fn Resolve(value: int32): int32 =\n",
        "    return value\n"], "")
    let textHelper = candidatePreflightOnly ?
        candidateTextHelper : acceptanceTextHelper
    let textDetached = strutil.Join([
        "import pkg/helper as helper\n\n",
        "fn DetachedConsumer(): int32 =\n",
        "    return helper.Resolve(9)\n"], "")
    let acceptanceTextMain = strutil.Join([
        "import pkg/helper as helper\n\n",
        "fn Resolve(): int32 =\n",
        "    return 22\n\n",
        "fn Main(): int32 =\n",
        "    let Shared = 5\n",
        "    let fromHelper = helper.Resolve(7)\n",
        "    let fromLocal = Resolve()\n",
        "    return fromHelper + fromLocal + Shared\n\n",
        "fn Other(): int32 =\n",
        "    let Shared = 41\n",
        "    return Shared\n\n",
        "fn Multi(): int32 =\n",
        "    let (left, right): tuple[int32, int32] = (1, 2)\n",
        "    return left + right\n\n",
        "fn Shadow(): int32 =\n",
        "    let value = 1\n",
        "    if true:\n",
        "        let value = 2\n",
        "        return value\n",
        "    return value\n"], "")
    let candidateTextMain = strutil.Join([
        "import pkg/helper as helper\n\n",
        "fn Main(): int32 =\n",
        "    return helper.Resolve(7)\n"], "")
    let textMain = candidatePreflightOnly ?
        candidateTextMain : acceptanceTextMain
    let versionIsolationOnly =
        os.GetEnv("CHENG_LSP_MULTIFILE_VERSION_ISOLATION_ONLY") == "1"
    let textMainForOpen = versionIsolationOnly ? strutil.Join([
        "import pkg/helper as helper\n\n",
        "fn Resolve(): int32 =\n",
        "    return 22\n\n",
        "fn Main(): int32 =\n",
        "    let Shared = 5\n",
        "    let fromHelper = 7\n",
        "    let fromLocal = 22\n",
        "    return fromHelper + fromLocal + Shared\n"], "") : textMain

    os.MkdirAll(sourceRoot, 493)
    os.WriteFile(
        strutil.Join([workspaceRoot, "/cheng-package.toml"], ""),
        "disk manifest bytes are outside the immutable overlay\n")
    os.WriteFile(sourceMain, "disk main bytes must not feed CompilerCSG\n")
    os.WriteFile(sourceHelper, "disk helper bytes must not feed CompilerCSG\n")
    os.WriteFile(
        sourceDetached,
        "disk detached bytes must not feed CompilerCSG\n")

    let compilerExecution = CurrentExecution()
    var workspace: lsp.LspWorkspace
    var err: str
    assert(lsp.LspWorkspaceInitInto(
               RequiredCidEnv("CHENG_LSP_WORKSPACE_SESSION_CID"),
               CurrentUniverse(compilerExecution),
               compilerExecution, workspace, err), err)
    assert(lsp.LspWorkspaceBindDocumentCompilerIdentityInto(
               workspace, uriHelper, workspaceRoot, workspaceRoot,
               "pkg", "arm64-apple-darwin", sourceHelper,
               "pkg/helper", false, err), err)
    assert(lsp.LspWorkspaceBindDocumentCompilerIdentityInto(
               workspace, uriMain, workspaceRoot, workspaceRoot,
               "pkg", "arm64-apple-darwin", sourceMain,
               "pkg/main", true, err), err)
    if !versionIsolationOnly:
        assert(lsp.LspWorkspaceBindDocumentCompilerIdentityInto(
                   workspace, uriDetached, workspaceRoot, workspaceRoot,
                   "pkg", "arm64-apple-darwin", sourceDetached,
                   "pkg/detached_consumer", false, err), err)

    let helperOpenClientVersion =
        versionIsolationOnly ? int64(10) : int64(1)
    let mainOpenClientVersion =
        versionIsolationOnly ? int64(100) : int64(1)
    var sourceVersion: int64
    assert(lsp.LspWorkspaceDidOpenInto(
               workspace, uriHelper, helperOpenClientVersion, textHelper,
               sourceVersion, err) && sourceVersion == int64(1), err)
    if versionIsolationOnly:
        assert(workspace.eventState.documentCids.len == 1 &&
               workspace.eventState.clientVersions.len == 1 &&
               workspace.eventState.clientVersions[0] == int64(10) &&
               workspace.eventState.documentLastEventSourceVersions[0] ==
                   int64(1) &&
               workspace.eventState.documentLastEventKinds[0] ==
                   snapshot_core.SemanticSourceEventOpen &&
               FiveSemanticRequestsContentModified(
                   workspace, uriHelper, 1, 11) &&
               RejectedDiagnosticsCurrent(
                   workspace, uriHelper, sourceVersion),
               "lsp multifile version isolation: first document version drift")
    if !versionIsolationOnly:
        assert(lsp.LspWorkspaceDidOpenInto(
                   workspace, uriDetached, int64(1), textDetached,
                   sourceVersion, err) && sourceVersion == int64(2), err)
    let expectedMainOpenSourceVersion =
        versionIsolationOnly ? int64(2) : int64(3)
    assert(lsp.LspWorkspaceDidOpenInto(
               workspace, uriMain, mainOpenClientVersion, textMainForOpen,
               sourceVersion, err) &&
           sourceVersion == expectedMainOpenSourceVersion, err)
    if versionIsolationOnly:
        assert(RunVersionIsolationInto(
                   workspace, uriMain, uriHelper, textHelper,
                   sourceVersion, err), err)
        assert(workspace.metrics.explicitSourceFileReadCount == int64(2) &&
               workspace.metrics.explicitSourceFileReadBytes > int64(0),
               "lsp multifile version isolation: binding read receipt drift")
        assert(lsp.LspWorkspaceReleaseInto(workspace, err), err)
        os.WriteLine(os.Get_stdout(),
            "lsp_multifile_version_isolation_status=pass source_version=9 uncompleted_version_rejected=1 documents=2")
        return 0
    assert(workspace.metrics.explicitSourceFileReadCount == int64(3) &&
           workspace.metrics.explicitSourceFileReadBytes > int64(0) &&
           workspace.metrics.parserBuildObserved &&
           workspace.metrics.compilerCsgBuildObserved &&
           workspace.metrics.compilerSnapshotBuilderAttemptCount > int64(0),
           "lsp multifile exact: internal producer path was not observed")
    if candidatePreflightOnly:
        var entryDocumentIndex: int32 = -1
        for documentIndex in 0..<workspace.documents.len:
            if workspace.documents[documentIndex].entrySource:
                assert(entryDocumentIndex < 0,
                       "lsp multifile preflight: duplicate entry coordinate")
                entryDocumentIndex = documentIndex
        var entryCoordinateErr: str
        assert(lsp.LspWorkspaceEntryDocumentCoordinateStrictValidateInto(
                   workspace,
                   sourceVersion,
                   entryDocumentIndex,
                   entryCoordinateErr),
               entryCoordinateErr)
        entryCoordinateErr = ""
        assert(!lsp.LspWorkspaceEntryDocumentCoordinateStrictValidateInto(
                    workspace,
                    sourceVersion,
                    workspace.documents.len,
                    entryCoordinateErr),
               "lsp multifile preflight: deleted entry coordinate survived")
        let reorderedEntryIndex =
            entryDocumentIndex == 0 ? 1 : 0
        entryCoordinateErr = ""
        assert(!lsp.LspWorkspaceEntryDocumentCoordinateStrictValidateInto(
                    workspace,
                    sourceVersion,
                    reorderedEntryIndex,
                    entryCoordinateErr),
               "lsp multifile preflight: reordered entry coordinate survived")
        entryCoordinateErr = ""
        assert(!lsp.LspWorkspaceEntryDocumentCoordinateStrictValidateInto(
                    workspace,
                    sourceVersion - int64(1),
                    entryDocumentIndex,
                    entryCoordinateErr),
               "lsp multifile preflight: close-reopen stale coordinate survived")
        let currentPublished =
            CurrentVersionPublished(workspace, sourceVersion)
        var openDocumentUniverseCid: layout.FixedBytes32
        AssertPublishedOpenDocumentUniverseInto(
            workspace, [uriMain, uriHelper, uriDetached],
            openDocumentUniverseCid)
        assert(currentPublished &&
               workspace.metrics.candidatePublishedCount > int64(0) &&
               workspace.candidateAdmissionMissingFactBitmap == 0 &&
               !layout.FixedBytes32Equal(
                   openDocumentUniverseCid,
                   layout.FixedBytes32()),
               "lsp multifile preflight: production candidate is not publishable")
        if membershipEventsOnly:
            var helperDocumentIndex: int32 = -1
            var mainDocumentIndex: int32 = -1
            var detachedDocumentIndex: int32 = -1
            for documentIndex in 0..<workspace.documents.len:
                if workspace.documents[documentIndex].uri == uriHelper:
                    assert(helperDocumentIndex < 0,
                           "lsp source membership: duplicate helper row")
                    helperDocumentIndex = documentIndex
                elif workspace.documents[documentIndex].uri == uriMain:
                    assert(mainDocumentIndex < 0,
                           "lsp source membership: duplicate main row")
                    mainDocumentIndex = documentIndex
                elif workspace.documents[documentIndex].uri == uriDetached:
                    assert(detachedDocumentIndex < 0,
                           "lsp source membership: duplicate detached row")
                    detachedDocumentIndex = documentIndex
            assert(helperDocumentIndex >= 0 &&
                   mainDocumentIndex >= 0 &&
                   detachedDocumentIndex >= 0,
                   "lsp source membership: initial stable rows missing")
            var activeBeforeRename: int32[] = [
                helperDocumentIndex,
                mainDocumentIndex,
                detachedDocumentIndex]
            AssertPublishedActiveMembershipInto(
                workspace, sourceVersion, activeBeforeRename)

            os.WriteFile(
                sourceRenamed,
                "disk detached bytes must not feed CompilerCSG\n")
            let versionBeforeRename = sourceVersion
            assert(lsp.LspWorkspaceDidRenameFileInto(
                       workspace, uriDetached, uriRenamed,
                       sourceVersion, err) &&
                   sourceVersion == versionBeforeRename + int64(1) &&
                   CurrentVersionPublished(workspace, sourceVersion),
                   err)
            var renamedDocumentIndex: int32 = -1
            for documentIndex in 0..<workspace.documents.len:
                if workspace.documents[documentIndex].uri == uriRenamed:
                    assert(renamedDocumentIndex < 0,
                           "lsp source membership: duplicate rename target row")
                    renamedDocumentIndex = documentIndex
            assert(renamedDocumentIndex >= 0 &&
                   !workspace.documents[detachedDocumentIndex].present &&
                   workspace.documents[renamedDocumentIndex].present &&
                   workspace.eventState.documentPresenceStates[
                       detachedDocumentIndex] ==
                       snapshot_core.SemanticSourcePresenceAbsent &&
                   workspace.eventState.documentPresenceStates[
                       renamedDocumentIndex] ==
                       snapshot_core.SemanticSourcePresencePresent &&
                   workspace.eventState.documentLastEventKinds[
                       detachedDocumentIndex] ==
                       snapshot_core.SemanticSourceEventRename &&
                   workspace.eventState.documentLastEventKinds[
                       renamedDocumentIndex] ==
                       snapshot_core.SemanticSourceEventRename &&
                   workspace.eventState.documentRenamePeerRows[
                       detachedDocumentIndex] == renamedDocumentIndex &&
                   workspace.eventState.documentRenamePeerRows[
                       renamedDocumentIndex] == detachedDocumentIndex,
                   "lsp source membership: rename tombstone authority drift")
            var activeAfterRename: int32[] = [
                helperDocumentIndex,
                mainDocumentIndex,
                renamedDocumentIndex]
            AssertPublishedActiveMembershipInto(
                workspace, sourceVersion, activeAfterRename)

            let versionBeforeStaleRename = sourceVersion
            err = ""
            assert(!lsp.LspWorkspaceDidRenameFileInto(
                        workspace, uriDetached, uriRenamed,
                        sourceVersion, err) &&
                   sourceVersion == int64(0) &&
                   workspace.snapshotStore.core.currentSourceVersion ==
                       versionBeforeStaleRename,
                   "lsp source membership: stale rename source survived")
            RecordSourceMembershipMutation(
                "lsp_stale_rename",
                "membership_event/v1|case=lsp_stale_rename|field=renameSourcePresence|from=present|to=tombstone")

            assert(lsp.LspWorkspaceDidDeleteFileInto(
                       workspace, uriRenamed, sourceVersion, err) &&
                   sourceVersion == versionBeforeStaleRename + int64(1) &&
                   CurrentVersionPublished(workspace, sourceVersion),
                   err)
            assert(!workspace.documents[renamedDocumentIndex].present &&
                   workspace.eventState.documentPresenceStates[
                       renamedDocumentIndex] ==
                       snapshot_core.SemanticSourcePresenceAbsent &&
                   workspace.eventState.documentLastEventKinds[
                       renamedDocumentIndex] ==
                       snapshot_core.SemanticSourceEventRemove,
                   "lsp source membership: delete tombstone authority drift")
            var activeAfterDelete: int32[] = [
                helperDocumentIndex,
                mainDocumentIndex]
            AssertPublishedActiveMembershipInto(
                workspace, sourceVersion, activeAfterDelete)

            let versionBeforeRejectedDelete = sourceVersion
            err = ""
            assert(!lsp.LspWorkspaceDidDeleteFileInto(
                        workspace, uriRenamed, sourceVersion, err) &&
                   sourceVersion == int64(0) &&
                   workspace.snapshotStore.core.currentSourceVersion ==
                       versionBeforeRejectedDelete,
                   "lsp source membership: duplicate delete survived")
            RecordSourceMembershipMutation(
                "lsp_duplicate_delete",
                "membership_event/v1|case=lsp_duplicate_delete|field=deleteSourcePresence|from=present|to=tombstone")
            err = ""
            assert(!lsp.LspWorkspaceDidDeleteFileInto(
                        workspace, uriMain, sourceVersion, err) &&
                   sourceVersion == int64(0) &&
                   workspace.snapshotStore.core.currentSourceVersion ==
                       versionBeforeRejectedDelete,
                   "lsp source membership: entry delete survived")
            RecordSourceMembershipMutation(
                "lsp_entry_delete",
                "membership_event/v1|case=lsp_entry_delete|field=entrySourcePresence|from=present|to=absent")

            let currentEventStateReceiptCid =
                layout.FixedBytes32Copy(
                    workspace.eventState.eventStateReceiptCid)
            workspace.eventState.eventStateReceiptCid =
                SourceMembershipMutationCid(
                    "lsp/current-event-receipt-attack")
            var receiptAttackDiagnostics: lsp.LspExactDiagnosticsResult
            err = ""
            assert(!lsp.LspWorkspaceExactDiagnosticsInto(
                        workspace, uriMain,
                        receiptAttackDiagnostics, err) &&
                   strings.StrContains(err, "content modified") &&
                   receiptAttackDiagnostics.items.len == 0 &&
                   ReceiptEmpty(receiptAttackDiagnostics.receipt),
                   "lsp source membership: current receipt query survived")
            RecordSourceMembershipMutation(
                "lsp_current_event_receipt_query",
                "membership_event/v1|case=lsp_current_event_receipt_query|field=currentEventStateReceiptCid|from=publishedBinding|to=foreign")

            var receiptAttackPublished: lsp.LspExactQueryReceipt
            var receiptAttackSnapshotCid: layout.FixedBytes32
            err = ""
            assert(!lsp.LspWorkspaceWriteCurrentPublishedSemanticRawNextInto(
                        workspace,
                        strutil.Join([
                            workspaceRoot,
                            "/receipt-attack-binding.next"], ""),
                        strutil.Join([
                            workspaceRoot,
                            "/receipt-attack-query.next"], ""),
                        strutil.Join([
                            workspaceRoot,
                            "/receipt-attack-universe.next"], ""),
                        strutil.Join([
                            workspaceRoot,
                            "/receipt-attack-snapshot.next"], ""),
                        receiptAttackPublished,
                        receiptAttackSnapshotCid,
                        err) &&
                   strings.StrContains(err, "content modified") &&
                   ReceiptEmpty(receiptAttackPublished) &&
                   layout.FixedBytes32Equal(
                       receiptAttackSnapshotCid,
                       layout.FixedBytes32()),
                   "lsp source membership: current receipt publisher survived")
            RecordSourceMembershipMutation(
                "lsp_current_event_receipt_publisher",
                "membership_event/v1|case=lsp_current_event_receipt_publisher|field=currentEventStateReceiptCid|from=publishedBinding|to=foreign")

            workspace.eventState.eventStateReceiptCid =
                currentEventStateReceiptCid
            var restoredDiagnostics: lsp.LspExactDiagnosticsResult
            err = ""
            assert(lsp.LspWorkspaceExactDiagnosticsInto(
                       workspace, uriMain,
                       restoredDiagnostics, err) &&
                   restoredDiagnostics.receipt.sourceVersion ==
                       sourceVersion,
                   "lsp source membership: current receipt restoration failed")

            os.WriteLine(os.Get_stdout(),
                Fmt"lsp_source_membership_event_status=pass rename_source_version={versionBeforeStaleRename} delete_source_version={versionBeforeRejectedDelete} stable_rows={workspace.documents.len} active_rows={activeAfterDelete.len} published=1")
            assert(lsp.LspWorkspaceReleaseInto(workspace, err), err)
            return 0
        let bindingNextPath =
            os.GetEnv("CHENG_LSP_PUBLISHED_BINDING_NEXT")
        let queryProjectionNextPath =
            os.GetEnv("CHENG_LSP_PUBLISHED_QUERY_PROJECTION_NEXT")
        let openDocumentUniverseNextPath =
            os.GetEnv("CHENG_LSP_PUBLISHED_OPEN_DOCUMENT_UNIVERSE_NEXT")
        let snapshotPayloadNextPath =
            os.GetEnv("CHENG_LSP_PUBLISHED_SNAPSHOT_NEXT")
        assert(bindingNextPath != "" &&
               queryProjectionNextPath != "" &&
               openDocumentUniverseNextPath != "" &&
               snapshotPayloadNextPath != "",
               "lsp multifile preflight: published semantic raw next paths missing")
        var publishedRawReceipt: lsp.LspExactQueryReceipt
        var snapshotPayloadCid: layout.FixedBytes32
        assert(lsp.LspWorkspaceWriteCurrentPublishedSemanticRawNextInto(
                   workspace,
                   bindingNextPath,
                   queryProjectionNextPath,
                   openDocumentUniverseNextPath,
                   snapshotPayloadNextPath,
                   publishedRawReceipt,
                   snapshotPayloadCid,
                   err) &&
               publishedRawReceipt.sourceVersion == sourceVersion &&
               layout.FixedBytes32Equal(
                   publishedRawReceipt.openDocumentUniverseCid,
                   openDocumentUniverseCid) &&
               !layout.FixedBytes32Equal(
                   snapshotPayloadCid, layout.FixedBytes32()),
               err)
        let preflightStatus =
            currentPublished ?
                "green" : "red"
        os.WriteLine(os.Get_stdout(), Fmt"lsp_multifile_production_candidate_preflight_status={preflightStatus} documents={workspace.documents.len} open_documents=3 source_version={sourceVersion} current_published={currentPublished ? 1 : 0} candidate_attempt={workspace.metrics.candidateAttemptCount} parser_observed={workspace.metrics.parserBuildObserved ? 1 : 0} csg_observed={workspace.metrics.compilerCsgBuildObserved ? 1 : 0} builder_attempt={workspace.metrics.compilerSnapshotBuilderAttemptCount} published={workspace.metrics.candidatePublishedCount} rejected={workspace.metrics.candidateRejectedCount} completed_stage_bitmap={workspace.candidateAdmissionCompletedStageBitmap} missing_fact_bitmap={workspace.candidateAdmissionMissingFactBitmap} admission_receipt={layout.FixedBytes32Hex(workspace.candidateAdmissionReceiptCid)} binding_receipt={layout.FixedBytes32Hex(publishedRawReceipt.bindingReceiptCid)} query_projection={layout.FixedBytes32Hex(publishedRawReceipt.queryProjectionCid)} open_document_universe={layout.FixedBytes32Hex(openDocumentUniverseCid)} snapshot_payload={layout.FixedBytes32Hex(snapshotPayloadCid)} blocked_reason={workspace.candidateBlockedReason}")
        assert(lsp.LspWorkspaceReleaseInto(workspace, err), err)
        return 0
    if !PublishOrReportRed(workspace, uriMain, sourceVersion):
        assert(lsp.LspWorkspaceReleaseInto(workspace, err), err)
        return 1

    var baseline: lsp.LspExactDefinitionResult
    AssertBaselineQueriesInto(
        workspace, uriMain, uriHelper, baseline)
    let baselineVersion = baseline.receipt.sourceVersion
    let baselineBinding = baseline.receipt.bindingReceiptCid

    let publishedIndex = workspace.snapshotStore.core.publishedIndex
    AssertBindingAuthorityMutationRejected(
        workspace, publishedIndex, uriMain)
    let originalProjectionCid =
        workspace.snapshotStore.payloadQueryProjectionCids[publishedIndex]
    workspace.snapshotStore.payloadQueryProjectionCids[
        publishedIndex].data[0] =
        uint8(Int32(workspace.snapshotStore.payloadQueryProjectionCids[
            publishedIndex].data[0]) ^ 1)
    var cidAttackDefinition: lsp.LspExactDefinitionResult
    assert(!lsp.LspWorkspaceExactDefinitionInto(
                workspace, uriMain, 7, 30,
                cidAttackDefinition, err) &&
           strings.StrContains(err, "content modified"),
           "lsp multifile exact: query projection CID attack survived")
    workspace.snapshotStore.payloadQueryProjectionCids[publishedIndex] =
        originalProjectionCid
    var restored: lsp.LspExactDefinitionResult
    DefinitionAtInto(workspace, uriMain, 7, 30, restored)
    assert(ReceiptsEqual(restored.receipt, baseline.receipt),
           "lsp multifile exact: CID attack restoration changed snapshot")

    let originalCompilerFactProjectionCid =
        workspace.snapshotStore.payloadCompilerFactProjectionCids[
            publishedIndex]
    workspace.snapshotStore.payloadCompilerFactProjectionCids[
        publishedIndex].data[0] =
        uint8(Int32(workspace.snapshotStore.payloadCompilerFactProjectionCids[
            publishedIndex].data[0]) ^ 1)
    assert(SixSemanticRequestsContentModified(
               workspace, uriMain, 7, 30),
           "lsp multifile exact: compiler fact projection CID attack survived")
    workspace.snapshotStore.payloadCompilerFactProjectionCids[
        publishedIndex] = originalCompilerFactProjectionCid
    var compilerFactReceiptRestored: lsp.LspExactDefinitionResult
    DefinitionAtInto(
        workspace, uriMain, 7, 30, compilerFactReceiptRestored)
    assert(ReceiptsEqual(
               compilerFactReceiptRestored.receipt, baseline.receipt),
           "lsp multifile exact: compiler fact receipt restoration drift")

    let mainSourceId = PublishedSourceIdForUri(
        workspace, publishedIndex, uriMain)
    let originalReferenceCount =
        workspace.snapshotStore.payloadQueryProjections[
            publishedIndex].queryIndex.referenceCountsBySource[mainSourceId]
    assert(originalReferenceCount > 0,
           "lsp multifile exact: reference cache attack fixture missing")
    workspace.snapshotStore.payloadQueryProjections[
        publishedIndex].queryIndex.referenceCountsBySource[mainSourceId] =
        originalReferenceCount - 1
    assert(FiveSemanticRequestsContentModified(
               workspace, uriMain, 7, 30),
           "lsp multifile exact: deleted reference cache row survived")
    workspace.snapshotStore.payloadQueryProjections[
        publishedIndex].queryIndex.referenceCountsBySource[mainSourceId] =
        originalReferenceCount

    let originalSymbolCount =
        workspace.snapshotStore.payloadQueryProjections[
            publishedIndex].queryIndex.symbolCountsBySource[mainSourceId]
    assert(originalSymbolCount > 0,
           "lsp multifile exact: symbol cache attack fixture missing")
    workspace.snapshotStore.payloadQueryProjections[
        publishedIndex].queryIndex.symbolCountsBySource[mainSourceId] =
        originalSymbolCount - 1
    assert(FiveSemanticRequestsContentModified(
               workspace, uriMain, 7, 30),
           "lsp multifile exact: deleted symbol cache row survived")
    workspace.snapshotStore.payloadQueryProjections[
        publishedIndex].queryIndex.symbolCountsBySource[mainSourceId] =
        originalSymbolCount
    var cacheRowsRestored: lsp.LspExactDefinitionResult
    DefinitionAtInto(workspace, uriMain, 7, 30, cacheRowsRestored)
    assert(ReceiptsEqual(
               cacheRowsRestored.receipt, baseline.receipt),
           "lsp multifile exact: query cache attack restoration drift")

    let originalDeclId = workspace.snapshotStore.payloadQueryProjections[
        publishedIndex].queryIndex.symbolDeclIds[baseline.targetSymbolId]
    workspace.snapshotStore.payloadQueryProjections[
        publishedIndex].queryIndex.symbolDeclIds[
            baseline.targetSymbolId] = originalDeclId + 1
    var declarationAttackDefinition: lsp.LspExactDefinitionResult
    assert(!lsp.LspWorkspaceExactDefinitionInto(
                workspace, uriMain, 7, 30,
                declarationAttackDefinition, err) &&
           strings.StrContains(err, "content modified"),
           "lsp multifile exact: SymbolId declaration attack survived")
    workspace.snapshotStore.payloadQueryProjections[
        publishedIndex].queryIndex.symbolDeclIds[
            baseline.targetSymbolId] = originalDeclId

    let originalDeclKeyCid = workspace.snapshotStore.payloadQueryProjections[
        publishedIndex].queryIndex.symbolDeclKeyCids[
            baseline.targetSymbolId]
    workspace.snapshotStore.payloadQueryProjections[
        publishedIndex].queryIndex.symbolDeclKeyCids[
            baseline.targetSymbolId].data[0] =
        uint8(Int32(workspace.snapshotStore.payloadQueryProjections[
            publishedIndex].queryIndex.symbolDeclKeyCids[
                baseline.targetSymbolId].data[0]) ^ 1)
    assert(!lsp.LspWorkspaceExactDefinitionInto(
                workspace, uriMain, 7, 30,
                declarationAttackDefinition, err) &&
           strings.StrContains(err, "content modified"),
           "lsp multifile exact: declaration key attack survived")
    workspace.snapshotStore.payloadQueryProjections[
        publishedIndex].queryIndex.symbolDeclKeyCids[
            baseline.targetSymbolId] = originalDeclKeyCid

    let originalDeclarationTableCid =
        workspace.snapshotStore.payloadQueryProjections[
            publishedIndex].queryIndex.declarationTableCid
    workspace.snapshotStore.payloadQueryProjections[
        publishedIndex].queryIndex.declarationTableCid.data[0] =
        uint8(Int32(workspace.snapshotStore.payloadQueryProjections[
            publishedIndex].queryIndex.declarationTableCid.data[0]) ^ 1)
    assert(!lsp.LspWorkspaceExactDefinitionInto(
                workspace, uriMain, 7, 30,
                declarationAttackDefinition, err) &&
           strings.StrContains(err, "content modified"),
           "lsp multifile exact: declaration table attack survived")
    workspace.snapshotStore.payloadQueryProjections[
        publishedIndex].queryIndex.declarationTableCid =
        originalDeclarationTableCid
    var declarationsRestored: lsp.LspExactDefinitionResult
    DefinitionAtInto(workspace, uriMain, 7, 30, declarationsRestored)
    assert(ReceiptsEqual(declarationsRestored.receipt, baseline.receipt) &&
           declarationsRestored.targetDeclId == baseline.targetDeclId &&
           layout.FixedBytes32Equal(
               declarationsRestored.targetDeclKeyCid,
               baseline.targetDeclKeyCid),
           "lsp multifile exact: declaration attack restoration drift")

    var staleChange: lsp.LspContentChange
    staleChange.rangePresent = true
    staleChange.startLine = 3
    staleChange.startCharacter = 11
    staleChange.endLine = 3
    staleChange.endCharacter = 13
    staleChange.rangeLengthPresent = true
    staleChange.rangeLength = 2
    staleChange.text = "23"
    let versionBeforeStale =
        workspace.snapshotStore.core.currentSourceVersion
    assert(!lsp.LspWorkspaceDidChangeInto(
                workspace, uriMain, int64(1), [staleChange],
                sourceVersion, err) && sourceVersion == int64(0) &&
           workspace.snapshotStore.core.currentSourceVersion ==
               versionBeforeStale,
           "lsp multifile exact: out-of-order client version accepted")

    var invalidChange: lsp.LspContentChange
    invalidChange.rangePresent = true
    invalidChange.startLine = 1
    invalidChange.startCharacter = 16
    invalidChange.endLine = 1
    invalidChange.endCharacter = 16
    invalidChange.rangeLengthPresent = true
    invalidChange.rangeLength = 0
    invalidChange.text = " 1"
    os.SetEnv("CHENG_STRICT_CALL_SYNTAX", "1")
    assert(lsp.LspWorkspaceDidChangeInto(
               workspace, uriHelper, int64(2), [invalidChange],
               sourceVersion, err) && sourceVersion == int64(4), err)
    assert(!CurrentVersionPublished(workspace, sourceVersion) &&
           FiveSemanticRequestsContentModified(
               workspace, uriMain, 7, 30) &&
           RejectedDiagnosticsCurrent(
               workspace, uriHelper, sourceVersion),
           "lsp multifile exact: rejected new version returned old results")
    let parserFailureRejectionIndex =
        workspace.snapshotStore.rejectionFacts.len - 1
    let parserFailureFacts = workspace.snapshotStore.rejectionFacts[
        parserFailureRejectionIndex]
    var parserFailureDiagnostics: lsp.LspExactDiagnosticsResult
    assert(parserFailureRejectionIndex >= 0 &&
           lsp.LspWorkspaceExactDiagnosticsInto(
               workspace, uriHelper, parserFailureDiagnostics, err) &&
           parserFailureDiagnostics.receipt.rejected &&
           workspace.snapshotStore.core.publishedIndex == publishedIndex &&
           parserFailureFacts.structuredDiagnosticArtifact.producerKinds.len ==
               1 &&
           parserFailureFacts.structuredDiagnosticAuthority.authorityKinds.len ==
               1 &&
           parserFailureFacts.structuredDiagnosticAuthority.parserLocalProducerSourceRows[
               0] == 0 &&
           parserFailureFacts.structuredDiagnosticAuthority.portableProducerSourceIndexes[
               0] > 0 &&
           parserFailureFacts.structuredDiagnosticProducerProjectionCids.len ==
               1 &&
           layout.FixedBytes32Equal(
               parserFailureFacts.structuredDiagnosticAuthority.producerProjectionCids[
                   0],
               parserFailureFacts.structuredDiagnosticProducerProjectionCids[
                   0]) &&
           !layout.FixedBytes32Equal(
               parserFailureDiagnostics.receipt.failureDiagnosticRootCid,
               layout.FixedBytes32()) &&
           !layout.FixedBytes32Equal(
               parserFailureDiagnostics.receipt.failureCargoCid,
               layout.FixedBytes32()) &&
           !layout.FixedBytes32Equal(
               parserFailureDiagnostics.receipt.failureAdmissionReceiptCid,
               layout.FixedBytes32()) &&
           !layout.FixedBytes32Equal(
               parserFailureDiagnostics.receipt.failureParserDiagnosticAuthorityRootCid,
               layout.FixedBytes32()) &&
           layout.FixedBytes32Equal(
               parserFailureDiagnostics.receipt.failureParserDiagnosticAuthorityRootCid,
               parserFailureFacts.structuredDiagnosticAuthority.authorityRootCid),
           "lsp multifile exact: structured rejection query receipt split")
    let verifiedParserFailureCargo =
        snapshot_cargo.CsgCompilerSnapshotFailureCargoVerify(
            workspace.snapshotStore.rejectionCsgcBytes[
                parserFailureRejectionIndex],
            workspace.snapshotStore.rejectionFactsRootCids[
                parserFailureRejectionIndex])
    assert(verifiedParserFailureCargo.ok &&
           verifiedParserFailureCargo.canonicalLines.len == 7,
           verifiedParserFailureCargo.error)
    let stalePublishedRootValidation =
        snapshot_cargo.CsgCompilerSnapshotFailureCargoVerify(
            workspace.snapshotStore.rejectionCsgcBytes[
                parserFailureRejectionIndex],
            baseline.receipt.csgRootCid)
    assert(!stalePublishedRootValidation.ok,
           "lsp multifile exact: stale published facts root accepted")
    let originalProducerProjection =
        workspace.snapshotStore.rejectionFacts[
            parserFailureRejectionIndex].structuredDiagnosticProducerProjectionCids[
                0]
    ReplaceProducerProjectionForAttack(
        workspace.snapshotStore.rejectionFacts[
            parserFailureRejectionIndex],
        RequiredCidEnv("CHENG_LSP_GRAMMAR_CID"))
    var exchangedProjectionDiagnostics: lsp.LspExactDiagnosticsResult
    assert(!lsp.LspWorkspaceExactDiagnosticsInto(
               workspace, uriHelper,
               exchangedProjectionDiagnostics, err),
           "lsp multifile exact: exchanged producer projection survived query")
    workspace.snapshotStore.rejectionFacts[
        parserFailureRejectionIndex].structuredDiagnosticProducerProjectionCids[
            0] =
        originalProducerProjection
    let restoredParserFailureFacts =
        workspace.snapshotStore.rejectionFacts[
            parserFailureRejectionIndex]
    assert(lsp.LspWorkspaceExactDiagnosticsInto(
               workspace, uriHelper, parserFailureDiagnostics, err) &&
           layout.FixedBytes32Equal(
               parserFailureDiagnostics.receipt.failureParserDiagnosticAuthorityRootCid,
               restoredParserFailureFacts.structuredDiagnosticAuthority.authorityRootCid),
           "lsp multifile exact: structured receipt restoration drift")

    var contentAttackFacts =
        snapshot_cargo.CsgCompilerSnapshotFailureFactsClone(
            restoredParserFailureFacts)
    contentAttackFacts.structuredDiagnosticArtifact.producerContentCids[0] =
        diagnostic_failure.DiagnosticFailureSourceContentCid(
            "different structured diagnostic source bytes")
    contentAttackFacts.structuredDiagnosticArtifact.proofCids[0] =
        diagnostic_failure.DiagnosticFailureRowProofCid(
            contentAttackFacts.structuredDiagnosticArtifact, 0)
    contentAttackFacts.structuredDiagnosticArtifact.receiptCid =
        diagnostic_failure.DiagnosticFailureReceiptCid(
            contentAttackFacts.structuredDiagnosticArtifact)
    var contentAuthorityErr: str
    assert(diagnostic_failure.DiagnosticFailureArtifactStrictValidateInto(
               contentAttackFacts.structuredDiagnosticArtifact,
               contentAuthorityErr) &&
           !snapshot_cargo.CsgCompilerSnapshotFailureFactsStrictValidateInto(
               contentAttackFacts,
               contentAuthorityErr) &&
           strings.StrContains(
               contentAuthorityErr,
               "structured diagnostic projection split"),
           "lsp multifile exact: recomputed content attack remained authoritative")
    var originalContentArtifact: diagnostic_failure.DiagnosticFailureArtifact
    assert(diagnostic_failure.DiagnosticFailureArtifactCloneInto(
               restoredParserFailureFacts.structuredDiagnosticArtifact,
               originalContentArtifact,
               err), err)
    diagnostic_failure.DiagnosticFailureArtifactMoveInto(
        workspace.snapshotStore.rejectionFacts[
            parserFailureRejectionIndex].structuredDiagnosticArtifact,
        contentAttackFacts.structuredDiagnosticArtifact)
    let contentAttackCargo =
        snapshot_cargo.CsgCompilerSnapshotFailureCargoVerify(
            workspace.snapshotStore.rejectionCsgcBytes[
                parserFailureRejectionIndex],
            workspace.snapshotStore.rejectionFactsRootCids[
                parserFailureRejectionIndex])
    var recomputedContentDiagnostics: lsp.LspExactDiagnosticsResult
    assert(contentAttackCargo.ok &&
           contentAttackCargo.canonicalLines.len == 7 &&
           !lsp.LspWorkspaceExactDiagnosticsInto(
               workspace,
               uriHelper,
               recomputedContentDiagnostics,
               err),
           "lsp multifile exact: recomputed structured content survived query")
    diagnostic_failure.DiagnosticFailureArtifactMoveInto(
        workspace.snapshotStore.rejectionFacts[
            parserFailureRejectionIndex].structuredDiagnosticArtifact,
        originalContentArtifact)
    assert(lsp.LspWorkspaceExactDiagnosticsInto(
               workspace, uriHelper, parserFailureDiagnostics, err),
           "lsp multifile exact: content attack restoration drift")

    let helperDocumentRow: int32 = 0
    assert(workspace.documents[helperDocumentRow].uri == uriHelper,
           "lsp multifile exact: helper document row drift")
    let rejectedContentCid =
        workspace.documents[helperDocumentRow].sourceContentCid
    workspace.documents[helperDocumentRow].sourceContentCid.data[0] =
        uint8(Int32(workspace.documents[
            helperDocumentRow].sourceContentCid.data[0]) ^ 1)
    var rejectedContentAttack: lsp.LspExactDiagnosticsResult
    assert(!lsp.LspWorkspaceExactDiagnosticsInto(
                workspace, uriHelper, rejectedContentAttack, err) &&
           strings.StrContains(err, "content modified"),
           "lsp multifile exact: rejected content CID attack survived")
    workspace.documents[helperDocumentRow].sourceContentCid =
        rejectedContentCid

    var repairChange: lsp.LspContentChange
    repairChange.rangePresent = true
    repairChange.startLine = 1
    repairChange.startCharacter = 16
    repairChange.endLine = 1
    repairChange.endCharacter = 18
    repairChange.rangeLengthPresent = true
    repairChange.rangeLength = 2
    repairChange.text = ""
    assert(lsp.LspWorkspaceDidChangeInto(
               workspace, uriHelper, int64(3), [repairChange],
               sourceVersion, err) && sourceVersion == int64(5) &&
           CurrentVersionPublished(workspace, sourceVersion), err)
    os.SetEnv("CHENG_STRICT_CALL_SYNTAX", "0")
    var afterRepair: lsp.LspExactDefinitionResult
    DefinitionAtInto(workspace, uriMain, 7, 30, afterRepair)
    assert(afterRepair.receipt.sourceVersion > baselineVersion &&
           !layout.FixedBytes32Equal(
               afterRepair.receipt.bindingReceiptCid, baselineBinding) &&
           layout.FixedBytes32Equal(
               afterRepair.targetSymbolCid, baseline.targetSymbolCid),
           "lsp multifile exact: repaired version isolation drift")

    assert(lsp.LspWorkspaceDidCloseInto(
               workspace, uriHelper, sourceVersion, err) &&
           sourceVersion == int64(6), err)
    assert(!CurrentVersionPublished(workspace, sourceVersion) &&
           FiveSemanticRequestsContentModified(
               workspace, uriMain, 7, 30) &&
           RejectedDiagnosticsCurrent(
               workspace, uriMain, sourceVersion),
           "lsp multifile exact: didClose returned stale helper results")

    let reopenedHelper = strutil.Join([
        "fn Resolve(value: int32): int32 =\n",
        "    return value + 1\n\n",
        "fn Resolve(value: str): int32 =\n",
        "    return 2\n\n",
        "fn Shared(): int32 =\n",
        "    return 11\n"], "")
    assert(lsp.LspWorkspaceDidOpenInto(
               workspace, uriHelper, int64(2), reopenedHelper,
               sourceVersion, err) && sourceVersion == int64(7) &&
           CurrentVersionPublished(workspace, sourceVersion), err)
    var afterReopen: lsp.LspExactDefinitionResult
    DefinitionAtInto(workspace, uriMain, 7, 30, afterReopen)
    assert(afterReopen.receipt.sourceVersion == int64(7) &&
           layout.FixedBytes32Equal(
               afterReopen.targetSymbolCid, baseline.targetSymbolCid) &&
           afterReopen.location.uri == uriHelper &&
           afterReopen.location.startLine == 0 &&
           !layout.FixedBytes32Equal(
               afterReopen.receipt.bindingReceiptCid,
               afterRepair.receipt.bindingReceiptCid),
           "lsp multifile exact: close/reopen version binding drift")

    var openDocumentUniverseCid: layout.FixedBytes32
    AssertPublishedOpenDocumentUniverseInto(
        workspace, [uriMain, uriHelper, uriDetached],
        openDocumentUniverseCid)
    var detachedResult: lsp.LspExactDefinitionResult
    AssertDetachedConsumerQueriesInto(
        workspace, uriMain, uriHelper, uriDetached, detachedResult)
    assert(detachedResult.receipt.sourceVersion == int64(7) &&
           layout.FixedBytes32Equal(
               detachedResult.receipt.openDocumentUniverseCid,
               openDocumentUniverseCid),
           "lsp multifile exact: query receipt lost open document universe CID")

    let samePinAllocBefore = system.memAllocCount()
    let samePinFreeBefore = system.memFreeCount()
    let samePinLiveBefore = system.memLiveCount()
    let samePinRetainBefore = system.memRetainCount()
    let samePinReleaseBefore = system.memReleaseCount()
    AssertSamePinDefinitionReferencesRenameOwnershipInto(
        workspace, uriMain, uriHelper)
    let samePinAlloc =
        system.memAllocCount() - samePinAllocBefore
    let samePinFree =
        system.memFreeCount() - samePinFreeBefore
    let samePinRetain =
        system.memRetainCount() - samePinRetainBefore
    let samePinRelease =
        system.memReleaseCount() - samePinReleaseBefore
    assert(samePinAlloc > int64(0) &&
           samePinAlloc == samePinFree &&
           system.memLiveCount() == samePinLiveBefore &&
           samePinRetain == int64(0) &&
           samePinRelease == samePinFree,
           "lsp same-pin owner: alloc/free/live/retain/release drift")

    assert(workspace.metrics.explicitSourceFileReadCount == int64(3) &&
           workspace.metrics.explicitSourceFileReadBytes > int64(0),
           "lsp multifile exact: event loop reopened source files")
    let bindingNextPath =
        os.GetEnv("CHENG_LSP_PUBLISHED_BINDING_NEXT")
    let queryProjectionNextPath =
        os.GetEnv("CHENG_LSP_PUBLISHED_QUERY_PROJECTION_NEXT")
    let openDocumentUniverseNextPath =
        os.GetEnv("CHENG_LSP_PUBLISHED_OPEN_DOCUMENT_UNIVERSE_NEXT")
    let snapshotPayloadNextPath =
        os.GetEnv("CHENG_LSP_PUBLISHED_SNAPSHOT_NEXT")
    let publishedRawRequested =
        bindingNextPath != "" ||
        queryProjectionNextPath != "" ||
        openDocumentUniverseNextPath != "" ||
        snapshotPayloadNextPath != ""
    var finalSnapshotPayload = "not_requested"
    if publishedRawRequested:
        assert(bindingNextPath != "" &&
               queryProjectionNextPath != "" &&
               openDocumentUniverseNextPath != "" &&
               snapshotPayloadNextPath != "",
               "lsp multifile exact: published semantic raw next path set incomplete")
        var publishedRawReceipt: lsp.LspExactQueryReceipt
        var snapshotPayloadCid: layout.FixedBytes32
        assert(lsp.LspWorkspaceWriteCurrentPublishedSemanticRawNextInto(
                   workspace,
                   bindingNextPath,
                   queryProjectionNextPath,
                   openDocumentUniverseNextPath,
                   snapshotPayloadNextPath,
                   publishedRawReceipt,
                   snapshotPayloadCid,
                   err) &&
               ReceiptsEqual(
                   publishedRawReceipt, detachedResult.receipt),
               err)
        finalSnapshotPayload =
            layout.FixedBytes32Hex(snapshotPayloadCid)
    let finalBinding =
        layout.FixedBytes32Hex(detachedResult.receipt.bindingReceiptCid)
    let finalProjection =
        layout.FixedBytes32Hex(detachedResult.receipt.queryProjectionCid)
    let finalOpenDocumentUniverse =
        layout.FixedBytes32Hex(openDocumentUniverseCid)
    assert(lsp.LspWorkspaceReleaseInto(workspace, err), err)
    os.WriteLine(os.Get_stdout(), Fmt"lsp_multifile_exact_snapshot_acceptance_status=pass published=1 source_version=7 documents=3 open_documents=3 binding_receipt={finalBinding} query_projection={finalProjection} open_document_universe={finalOpenDocumentUniverse} snapshot_payload={finalSnapshotPayload}")
    return 0
