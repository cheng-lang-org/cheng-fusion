# Standalone moq-asset byte-range fetch client — Phase B verification.
# Fetches an arbitrary [offset,length] range of the publisher's whole asset over
# QUIC (the "moq-asset" range serve) and writes it to --out, so it can be cmp'd
# against the local faststart-mp4 slice. Proves the random byte-range serve that
# the OHOS data-source readAt relies on.
import std/result
import std/rawbytes
import std/os
import std/strutils as strutil
import std/cmdline as cmdline
import cheng/core/runtime/web_scene_media_network_bridge as media_bridge
import cheng/quic/connection as qconn
import cheng/quic/msquictransport_native as qtransport
import cheng/libp2p/transports/quic_transport as quic_transport
import cheng/libp2p/protocols/media/moq_segment_stream as moqstream
import cheng/core/runtime/web_scene_media_orchestrator as orchestrator

@exportc("cheng_host_es_diag")
fn cheng_host_es_diag(step: int32, a: int32, b: int32): void =
    return

# Minimal multi-request-per-conn probe: dial ONCE, then ClientOpen+drain TWICE on the
# SAME local (stack) conn. Both requests fetch moq-announce. If request 2 works, the
# QUIC impl supports multiple requests per connection; if it fails "session ! ready"
# the server session died after request 1 (the bug). Conn is a stack var (no globals
# → no segfault), so this isolates the pure protocol question.
fn multiReqProbe(host: str, port: int32): int32 =
    var client = qtransport.InitMsQuicTransport()
    var conn: qconn.Connection
    let dialRes = quic_transport.Libp2pQuicDialOneShotClientNamed(client, conn, host, port, "localhost")
    if IsErr(dialRes):
        os.WriteLine(os.Get_stdout(), strutil.Join(["multireq dial FAIL: ", Error(dialRes)], ""))
        return 1
    let negRes = moqstream.Libp2pMoqSegmentStreamClientSendNegotiate(client, conn)
    if IsErr(negRes):
        os.WriteLine(os.Get_stdout(), strutil.Join(["multireq negotiate FAIL: ", Error(negRes)], ""))
        return 1
    let ackRes = moqstream.Libp2pMoqSegmentStreamClientReadNegotiateAck(client, conn)
    if IsErr(ackRes):
        os.WriteLine(os.Get_stdout(), strutil.Join(["multireq ack FAIL: ", Error(ackRes)], ""))
        return 1
    # Slot-scaling probe: N sequential moq-announce requests on ONE conn. If they all
    # succeed, requests reuse the fixed stream pair (only ~2 of 16 slots) → a whole
    # video can stream on one dial. If it fails near 16, fresh streams hit the slot cap.
    # 500 requests = a looping video's worth of per-frame fetches on one persistent conn.
    let reqCount: int32 = cmdline.ReadInt32FlagOrDefault("--count", 500)
    var k: int32 = 0
    while k < reqCount:
        var req: moqstream.Libp2pMoqSegmentStreamRequest
        req.streamId = "probe"
        req.segmentKey = "moq-announce"
        req.offsetBytes = 0
        req.lengthBytes = 1024
        req.readChunkBytes = 1024
        var reader: moqstream.Libp2pMoqSegmentStreamReader
        let openRes = moqstream.Libp2pMoqSegmentStreamClientOpen(reader, conn, req)
        if IsErr(openRes):
            os.WriteLine(os.Get_stdout(), strutil.Join(["multireq req", IntToStr(k), " open FAIL: ", Error(openRes)], ""))
            qconn.ConnClose(conn)
            qtransport.Stop(client)
            return 1
        let drainRes = orchestrator.WebSceneMediaOrchestrateFetchAll(reader, 1024)
        if IsErr(drainRes):
            os.WriteLine(os.Get_stdout(), strutil.Join(["multireq req", IntToStr(k), " drain FAIL: ", Error(drainRes)], ""))
            qconn.ConnClose(conn)
            qtransport.Stop(client)
            return 1
        k = k + 1
        if (k % 50) == 0:
            os.WriteLine(os.Get_stdout(), strutil.Join(["multireq progress ", IntToStr(k), "/", IntToStr(reqCount)], ""))
    qconn.ConnClose(conn)
    qtransport.Stop(client)
    os.WriteLine(os.Get_stdout(), strutil.Join(["multireq ALL OK (", IntToStr(k), " requests on one conn)"], ""))
    return 0

fn main(): int32 =
    var hostRaw: str
    let hasHost: bool = cmdline.ReadFirstFlagValue("--host", hostRaw)
    let host: str = if hasHost: hostRaw else: "127.0.0.1"
    let port: int32 = cmdline.ReadInt32FlagOrDefault("--port", 38000)
    var mrRaw: str
    if cmdline.ReadFirstFlagValue("--multireq", mrRaw):
        return multiReqProbe(host, port)
    var sidRaw: str
    let hasSid: bool = cmdline.ReadFirstFlagValue("--streamid", sidRaw)
    let sid: str = if hasSid: sidRaw else: "moq-asset-1"
    let offset: int32 = cmdline.ReadInt32FlagOrDefault("--offset", 0)
    let length: int32 = cmdline.ReadInt32FlagOrDefault("--length", 65536)
    var segKeyRaw: str
    let hasSegKey: bool = cmdline.ReadFirstFlagValue("--segment-key", segKeyRaw)
    let segKey: str = if hasSegKey: segKeyRaw else: "moq-asset"
    var outRaw: str
    let hasOut: bool = cmdline.ReadFirstFlagValue("--out", outRaw)
    let outPath: str = if hasOut: outRaw else: "/tmp/range.bin"
    # --frame N: exercise the per-frame ES path (es_open + es_fetch_frame) directly.
    var frameRaw: str
    let hasFrame: bool = cmdline.ReadFirstFlagValue("--frame", frameRaw)
    if hasFrame:
        # --frame N: open once, then fetch frames 0..N on the PERSISTENT connection
        # (exercises no-re-dial stability past the old ~8-frame busy-loop ceiling).
        var lastIdx: int32 = 0
        let _p = cmdline.ParseInt32(frameRaw, lastIdx)
        if !media_bridge.WebSceneMediaEsOpen(host, port):
            os.WriteLine(os.Get_stdout(), "es_open ERR")
            return 1
        let cnt: int32 = media_bridge.WebSceneMediaEsFrameCount()
        let w: int32 = media_bridge.WebSceneMediaEsWidth()
        let h: int32 = media_bridge.WebSceneMediaEsHeight()
        let fps: int32 = media_bridge.WebSceneMediaEsFps()
        os.WriteLine(os.Get_stdout(), strutil.Join(["es_open ok count=", IntToStr(cnt),
                                                    " ", IntToStr(w), "x", IntToStr(h), " fps=", IntToStr(fps)], ""))
        var buf = rawbytes.BytesAlloc(262144)
        var totalBytes: int32 = 0
        var okCount: int32 = 0
        var i: int32 = 0
        while i <= lastIdx:
            var got: int32 = media_bridge.WebSceneMediaEsFrameFetch(i, buf.data, 262144)
            var rtry: int32 = 0
            while got <= 0 && rtry < 5:
                got = media_bridge.WebSceneMediaEsFrameFetch(i, buf.data, 262144)
                rtry = rtry + 1
            if got > 0:
                okCount = okCount + 1
                totalBytes = totalBytes + got
                if i == lastIdx:
                    let outBytes = rawbytes.BytesSlice(buf, 0, got)
                    let _w = os.WriteFileBytesResult(outPath, outBytes)
            else:
                os.WriteLine(os.Get_stdout(), strutil.Join(["es_fetch FAIL at frame=", IntToStr(i),
                                                            " err=", media_bridge.WebSceneMediaEsLastError()], ""))
                return 1
            i = i + 1
        os.WriteLine(os.Get_stdout(), strutil.Join(["es_fetch ok frames=", IntToStr(okCount),
                                                    " total_bytes=", IntToStr(totalBytes),
                                                    " last=", IntToStr(lastIdx)], ""))
        return 0
    let res = media_bridge.WebSceneMediaFetchRemoteObject(host, port, sid, segKey, offset, length, 65536)
    if IsErr(res):
        os.WriteLine(os.Get_stdout(), strutil.Join(["range fetch ERR: ", Error(res)], ""))
        return 1
    var b = Value(res)
    let writeRes = os.WriteFileBytesResult(outPath, b)
    if IsErr(writeRes):
        return 2
    os.WriteLine(os.Get_stdout(), strutil.Join(["range fetch ok offset=", IntToStr(offset),
                                               " bytes=", IntToStr(rawbytes.BytesLen(b)), " out=", outPath], ""))
    return 0
