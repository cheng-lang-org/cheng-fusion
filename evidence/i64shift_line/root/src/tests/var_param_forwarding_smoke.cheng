type
    VarForwardScalarAlias = int32
    VarForwardNode = ref object
        value: int32

fn varForwardScalarInner(value: var int32) =
    value = 41

fn varForwardScalarOuter(value: var int32) =
    varForwardScalarInner(value)

fn varForwardAliasScalarInner(value: var int32) =
    value = 52

fn varForwardAliasScalarOuter(value: var VarForwardScalarAlias) =
    varForwardAliasScalarInner(value)

fn varForwardAliasSequenceInner(values: var int32[]) =
    add(values, 64)

fn varForwardAliasSequenceOuter(values: var VarForwardScalarAlias[]) =
    varForwardAliasSequenceInner(values)
    add(values, 65)

fn varForwardRefInner(node: var VarForwardNode) =
    node = new(VarForwardNode)
    node.value = 73

fn varForwardRefOuter(node: var VarForwardNode) =
    varForwardRefInner(node)

fn main(): int32 =
    var scalar: int32
    varForwardScalarOuter(scalar)
    if scalar != 41:
        return 1

    var aliasScalar: VarForwardScalarAlias
    varForwardAliasScalarOuter(aliasScalar)
    if aliasScalar != 52:
        return 3

    var aliasSequence: VarForwardScalarAlias[]
    varForwardAliasSequenceOuter(aliasSequence)
    if aliasSequence.len != 2 || aliasSequence[0] != 64 ||
       aliasSequence[1] != 65:
        return 4

    var node: VarForwardNode
    varForwardRefOuter(node)
    if node == nil || node.value != 73:
        return 2

    echo("var_param_forwarding_smoke ok")
    return 0
