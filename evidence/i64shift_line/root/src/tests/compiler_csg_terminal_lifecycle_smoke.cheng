import std/os
import std/system
import std/seqs as seqs
import cheng/core/lang/diagnostic_failure as diagnostic_failure
import cheng/core/lang/parser_diagnostic_authority as diagnostic_authority
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/tooling/compiler_parser_receipt as parser_receipt
import cheng/core/tooling/compiler_payload_lifecycle as lifecycle
import cheng/std/bytes_layout as layout

fn exactCid(seed: int32): layout.FixedBytes32 =
    var out: layout.FixedBytes32
    out.data[0] = uint8(seed)
    return out

fn buildCommittedCompilerCsg(csg: var ccsg.CompilerCsg) =
    csg.packageId = "cheng/test"

    seqs.setLen(csg.nodes, 2)
    csg.nodes[0].modulePath = "cheng/test"
    csg.nodes[0].symbolText = "main"
    csg.nodes[0].factText = "function"
    csg.nodes[1].semanticSource = "src/test.cheng"
    csg.nodes[1].semanticParamTypeJoin = "int32"
    csg.nodes[1].semanticReturnType = "int32"
    csg.nodes[1].exportSymbolName = "main"
    seqs.setLen(csg.edges, 1)

    seqs.setLen(csg.semanticGraph.sourceTable.sourcePaths, 1)
    csg.semanticGraph.sourceTable.sourcePaths[0] = "src/test.cheng"
    seqs.setLen(csg.semanticGraph.declTable.sourceIndex, 1)
    seqs.setLen(csg.semanticGraph.importEdgeTable.ownerSourceIndex, 1)
    seqs.setLen(csg.semanticGraph.reachableFunctionTable.sourceIndex, 1)
    seqs.setLen(csg.semanticGraph.exprSliceTable.sourceIndex, 1)
    seqs.setLen(csg.semanticGraph.typedFactTable.sourceIndexes, 1)
    seqs.setLen(csg.semanticGraph.resolvedCallTable.sourceIndexes, 1)
    seqs.setLen(csg.semanticGraph.typedIrTable.functionSourceIndexes, 1)

    seqs.setLen(csg.parserNormalizedExprReceipt.envelope.countKeys, 1)
    csg.parserNormalizedExprReceipt.envelope.countKeys[0] = "node_count"
    seqs.setLen(csg.parserNormalizedExprReceipt.envelope.countValues, 1)
    seqs.setLen(csg.parserNormalizedExprReceipt.sourceSidecars, 1)
    var sidecar: parser_receipt.ParserCanonicalSourceSidecar
    seqs.setLen(sidecar.tokenProducerSourceIds, 2)
    seqs.setLen(sidecar.tokenSourceLocalRows, 2)
    seqs.setLen(sidecar.tokenLexicalParentIds, 2)
    seqs.setLen(sidecar.tokenKinds, 2)
    seqs.setLen(sidecar.tokenSpanIds, 2)
    seqs.setLen(sidecar.tokenValues, 2)
    sidecar.tokenValues[0] = "fn"
    sidecar.tokenValues[1] = "main"
    seqs.setLen(sidecar.typeSyntaxKinds, 1)
    seqs.setLen(sidecar.typeSyntaxSourceLocalRows, 1)
    seqs.setLen(sidecar.typeConstExprKinds, 1)
    seqs.setLen(sidecar.typeConstExprIdentityCids, 1)
    seqs.setLen(sidecar.declarationKinds, 1)
    seqs.setLen(sidecar.declarationMutableFlags, 1)
    seqs.setLen(sidecar.patternKinds, 1)
    seqs.setLen(sidecar.annotationArgKinds, 1)
    seqs.setLen(sidecar.normalizedExprParserNodeIds, 1)
    seqs.setLen(sidecar.functionNames, 1)
    sidecar.functionNames[0] = "main"
    seqs.setLen(sidecar.functionDeclarationHeaderCids, 1)
    seqs.setLen(sidecar.functionDeclarationPathCids, 1)
    csg.parserNormalizedExprReceipt.sourceSidecars[0] = sidecar
    sidecar = parser_receipt.ParserCanonicalSourceSidecar()

    let failureSource = "fn main(): int32 =\n    return 0\n"
    let failureDocumentCid =
        diagnostic_failure.DiagnosticFailureLocalDocumentCid(0)
    let failureContentCid =
        diagnostic_failure.DiagnosticFailureSourceContentCid(
            failureSource)
    let failureSourceReceiptCid =
        diagnostic_failure.DiagnosticFailureLocalSourceIdentityReceiptCid(
            0, 1, failureDocumentCid, failureContentCid)
    var failureErr: str
    if !diagnostic_failure.DiagnosticFailureArtifactSealParserPortableInto(
           failureSource,
           0,
           1,
           failureSourceReceiptCid,
           failureDocumentCid,
           failureContentCid,
           diagnostic_failure.DiagnosticFailureAnchorParserNode,
           11,
           -1,
           0,
           failureSource.len,
           "terminal owner release",
           csg.diagnosticFailureArtifact,
           failureErr):
        panic(failureErr)
    let authorityKind =
        diagnostic_authority.ParserDiagnosticAuthorityKindCanonicalSidecar
    let authorityAnchor =
        diagnostic_authority.ParserDiagnosticAuthorityAnchorParserNode
    csg.diagnosticFailureAuthority.schemaVersion =
        diagnostic_authority.ParserDiagnosticAuthoritySchemaVersionLatest
    add(csg.diagnosticFailureAuthority.authorityKinds, authorityKind)
    add(csg.diagnosticFailureAuthority.parserLocalProducerSourceRows, 0)
    add(csg.diagnosticFailureAuthority.portableProducerSourceIndexes, 0)
    add(csg.diagnosticFailureAuthority.producerSourceByteLengths,
        failureSource.len)
    add(csg.diagnosticFailureAuthority.producerContentCids,
        failureContentCid)
    add(csg.diagnosticFailureAuthority.parserInputCids,
        failureContentCid)
    add(csg.diagnosticFailureAuthority.sourceSidecarCids, exactCid(1))
    add(csg.diagnosticFailureAuthority.diagnosticCompletionCids,
        exactCid(2))
    add(csg.diagnosticFailureAuthority.anchorKinds, authorityAnchor)
    add(csg.diagnosticFailureAuthority.canonicalParserNodeRows, 7)
    add(csg.diagnosticFailureAuthority.producerParserNodeRows, 11)
    add(csg.diagnosticFailureAuthority.parserNodeKinds, 9)
    add(csg.diagnosticFailureAuthority.parserNodeSpanStartBytes, 0)
    add(csg.diagnosticFailureAuthority.parserNodeSpanEndBytes,
        failureSource.len)
    add(csg.diagnosticFailureAuthority.ownerDeclarationSourceLocalRows,
        -1)
    add(csg.diagnosticFailureAuthority.ownerDeclarationKinds, -1)
    add(csg.diagnosticFailureAuthority.ownerDeclarationSpanStartBytes,
        -1)
    add(csg.diagnosticFailureAuthority.ownerDeclarationSpanEndBytes,
        -1)
    add(csg.diagnosticFailureAuthority.diagnosticSpanIds, 5)
    add(csg.diagnosticFailureAuthority.diagnosticSpanStartBytes, 0)
    add(csg.diagnosticFailureAuthority.diagnosticSpanEndBytes,
        failureSource.len)
    add(csg.diagnosticFailureAuthority.severities,
        diagnostic_authority.ParserDiagnosticAuthoritySeverityError)
    add(csg.diagnosticFailureAuthority.codes,
        csg.diagnosticFailureArtifact.codes[0])
    add(csg.diagnosticFailureAuthority.messages,
        csg.diagnosticFailureArtifact.messages[0])
    let parserProjection =
        diagnostic_authority.ParserDiagnosticAuthorityParserProjectionCidAt(
            csg.diagnosticFailureAuthority, 0)
    add(csg.diagnosticFailureAuthority.producerProjectionCids,
        parserProjection)
    add(csg.diagnosticFailureProducerProjectionCids,
        parserProjection)
    add(csg.diagnosticFailureAuthority.proofCids,
        diagnostic_authority.ParserDiagnosticAuthorityRowProofCid(
            csg.diagnosticFailureAuthority, 0))
    csg.diagnosticFailureAuthority.authorityRootCid =
        diagnostic_authority.ParserDiagnosticAuthorityRootCid(
            csg.diagnosticFailureAuthority)
    if !diagnostic_authority.ParserDiagnosticAuthorityStrictValidateInto(
           csg.diagnosticFailureAuthority,
           csg.diagnosticFailureProducerProjectionCids,
           failureErr) ||
       !diagnostic_failure.DiagnosticFailureArtifactBindParserAuthorityInto(
           csg.diagnosticFailureArtifact,
           csg.diagnosticFailureAuthority.authorityRootCid,
           failureErr):
        panic(failureErr)

fn runCompilerCsgTerminal(outcome: int32): bool =
    var csg: ccsg.CompilerCsg
    buildCommittedCompilerCsg(csg)
    let diagnosticDynamicBytes =
        diagnostic_failure.DiagnosticFailureArtifactDynamicSequenceBytes(
            csg.diagnosticFailureArtifact, true)
    let diagnosticPhysicalBufferCount =
        diagnostic_failure.DiagnosticFailureArtifactPhysicalBufferCount(
            csg.diagnosticFailureArtifact)
    let diagnosticLogicalStringCount =
        diagnostic_failure.DiagnosticFailureArtifactLogicalStringCount(
            csg.diagnosticFailureArtifact)
    let authorityDynamicBytes =
        diagnostic_authority.ParserDiagnosticAuthorityDynamicSequenceBytes(
            csg.diagnosticFailureAuthority, true)
    let authorityPhysicalBufferCount =
        diagnostic_authority.ParserDiagnosticAuthorityPhysicalBufferCount(
            csg.diagnosticFailureAuthority)
    let authorityLogicalStringCount =
        diagnostic_authority.ParserDiagnosticAuthorityLogicalStringCount(
            csg.diagnosticFailureAuthority)
    let retainedBytes = ccsg.CompilerCsgLifecycleRetainedBytes(csg)
    let physicalBufferCount =
        ccsg.CompilerCsgLifecycleTrackedPhysicalBufferCount(csg)
    if diagnosticDynamicBytes <= int64(0) ||
       diagnosticPhysicalBufferCount != 16 ||
       diagnosticLogicalStringCount != int64(2) ||
       authorityDynamicBytes <= int64(0) ||
       authorityPhysicalBufferCount != 26 ||
       authorityLogicalStringCount != int64(2) ||
       retainedBytes < diagnosticDynamicBytes + authorityDynamicBytes ||
       physicalBufferCount <
           diagnosticPhysicalBufferCount +
           authorityPhysicalBufferCount + 1:
        return false

    let orcReleaseBefore = system.memReleaseCount()
    var state: lifecycle.CompilerPayloadLifecycle
    lifecycle.CompilerPayloadLifecycleBegin(
        state,
        lifecycle.CompilerPayloadKindCompilerCsg,
        retainedBytes,
        physicalBufferCount)
    lifecycle.CompilerPayloadLifecyclePrepareTerminal(state)
    var releasedBufferCount: int32
    var releasedBytes: int64
    ccsg.CompilerCsgTerminalReleaseWithReceipt(
        csg, releasedBufferCount, releasedBytes)
    var repeatedReleasedBufferCount: int32
    var repeatedReleasedBytes: int64
    ccsg.CompilerCsgTerminalReleaseWithReceipt(
        csg, repeatedReleasedBufferCount, repeatedReleasedBytes)
    let orcReleaseDelta =
        system.memReleaseCount() - orcReleaseBefore
    let storageReleased = ccsg.CompilerCsgLifecycleStorageReleased(csg)
    var receipt: lifecycle.CompilerPayloadLifecycleReceipt
    var physicalRelease: lifecycle.CompilerPayloadPhysicalReleaseReceipt
    physicalRelease.releasedBufferCount = releasedBufferCount
    physicalRelease.releasedBytes = releasedBytes
    physicalRelease.storageReleased = storageReleased
    lifecycle.CompilerPayloadLifecycleEnd(
        state,
        outcome,
        physicalRelease,
        receipt)
    return receipt.outcome == outcome &&
           receipt.allocated == int64(1) &&
           receipt.released == int64(1) &&
           receipt.live == int64(0) &&
           receipt.allocatedBytes == retainedBytes &&
           receipt.releasedBytes == retainedBytes &&
           receipt.liveBytes == int64(0) &&
           receipt.physicalFreeCount == int64(physicalBufferCount) &&
           repeatedReleasedBufferCount == 0 &&
           repeatedReleasedBytes == int64(0) &&
           orcReleaseDelta >=
               diagnosticLogicalStringCount +
               authorityLogicalStringCount &&
           diagnostic_failure.DiagnosticFailureArtifactReleased(
               csg.diagnosticFailureArtifact) &&
           diagnostic_authority.ParserDiagnosticAuthorityReleased(
               csg.diagnosticFailureAuthority) &&
           csg.diagnosticFailureProducerProjectionCids.cap == 0 &&
           receipt.storageReleased &&
           receipt.ledgerStorageReleased

fn main(): int32 =
    if !runCompilerCsgTerminal(lifecycle.CompilerPayloadOutcomeSuccess):
        return 1
    if !runCompilerCsgTerminal(lifecycle.CompilerPayloadOutcomeDiagnostic):
        return 2
    if !runCompilerCsgTerminal(lifecycle.CompilerPayloadOutcomeCancel):
        return 3
    if !runCompilerCsgTerminal(lifecycle.CompilerPayloadOutcomeEarlyReturn):
        return 4
    if !runCompilerCsgTerminal(lifecycle.CompilerPayloadOutcomeCacheReuse):
        return 5

    let allocBefore = system.memAllocCount()
    let freeBefore = system.memFreeCount()
    let liveBefore = system.memLiveCount()
    for iteration in 0..<100:
        if !runCompilerCsgTerminal(
                lifecycle.CompilerPayloadOutcomeSuccess):
            return 10
    let allocDelta = system.memAllocCount() - allocBefore
    let freeDelta = system.memFreeCount() - freeBefore
    if allocDelta <= int64(0) ||
       allocDelta != freeDelta ||
       system.memLiveCount() != liveBefore:
        return 11

    os.WriteLine(
        os.Get_stdout(),
        "compiler_csg_terminal_lifecycle ok paths=5 cycles=100 ledger_live=0 alloc_free_balanced=1 canonical_sidecar_released=1 semantic_graph_released=1")
    return 0
