fn ForRangeCallSumEnd(n: int32): int32 =
    var total: int32
    for i in range(n):
        total = total + i
    return total

fn ForRangeCallSumStartEnd(lo: int32, hi: int32): int32 =
    var total: int32
    for i in range(lo, hi):
        total = total + i
    return total

fn ForRangeCallComputedStart(base: int32, hi: int32): int32 =
    var total: int32
    for i in (base + 1)..<hi:
        total = total + i
    return total

fn main(): int32 =
    let a = ForRangeCallSumEnd(5)
    if a != 10:
        return 11
    let b = ForRangeCallSumStartEnd(2, 6)
    if b != 14:
        return 12
    let c = ForRangeCallComputedStart(0, 4)
    if c != 6:
        return 13
    return 0
