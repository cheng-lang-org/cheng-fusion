import cheng/core/runtime/arena as arena

fn main(): int32 =
    var a = arena.ArenaInit(32, 8)
    let first = arena.ArenaAllocBytes(a, 3)
    if arena.ArenaBytesOffset(first) != 0:
        return 1
    if arena.ArenaBytesLen(first) != 3:
        return 2
    arena.ArenaSetByte(a, first, 0, 7)
    arena.ArenaSetByte(a, first, 1, 9)
    if arena.ArenaGetByte(a, first, 0) != 7:
        return 3
    if arena.ArenaGetByte(a, first, 1) != 9:
        return 4
    let second = arena.ArenaAllocBytesAligned(a, 5, 4)
    if arena.ArenaBytesOffset(second) != 4:
        return 5
    if arena.ArenaUsed(a) != 9:
        return 6
    if arena.ArenaRemaining(a) != 23:
        return 7
    arena.ArenaReset(a)
    if arena.ArenaUsed(a) != 0:
        return 8
    let zeroed = arena.ArenaAllocZeroBytes(a, 2)
    if arena.ArenaGetByte(a, zeroed, 0) != 0:
        return 9
    if arena.ArenaGetByte(a, zeroed, 1) != 0:
        return 10
    var arr = arena.ArenaArrayInt32Init()
    arena.ArenaArrayInt32Add(a, arr, 100)
    arena.ArenaArrayInt32Add(a, arr, 200)
    arena.ArenaArrayInt32Add(a, arr, 300)
    if arena.ArenaArrayInt32Len(arr) != 3:
        return 11
    if arena.ArenaArrayInt32Get(a, arr, 0) != 100:
        return 12
    if arena.ArenaArrayInt32Get(a, arr, 1) != 200:
        return 13
    if arena.ArenaArrayInt32Get(a, arr, 2) != 300:
        return 14
    arena.ArenaArrayInt32Set(a, arr, 1, 250)
    if arena.ArenaArrayInt32Get(a, arr, 1) != 250:
        return 15
    var growArr = arena.ArenaArrayInt32Init()
    for gi in 0..<20:
        arena.ArenaArrayInt32Add(a, growArr, 1000 + gi * 10)
    if arena.ArenaArrayInt32Len(growArr) != 20:
        return 16
    for gj in 0..<20:
        if arena.ArenaArrayInt32Get(a, growArr, gj) != 1000 + gj * 10:
            return 17
    arena.ArenaDestroy(a)
    return 0
