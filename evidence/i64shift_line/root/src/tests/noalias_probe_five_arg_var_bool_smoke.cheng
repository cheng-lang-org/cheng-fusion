fn ProbeFiveArgVarBool(a: int32,
                       b: int32,
                       c: int32,
                       d: bool,
                       out: var bool) =
    out = d && a == 1 && b == 2 && c == 3
    return

fn main(): int32 =
    var out = false
    ProbeFiveArgVarBool(1, 2, 3, true, out)
    if !out:
        return 66
    return 77
