import std/rawbytes

type
    NestedSequenceElementImmutableOwner =
        bytes: rawbytes.Bytes[]

fn BuildNestedSequenceElementImmutableOwner():
        NestedSequenceElementImmutableOwner =
    var owner: NestedSequenceElementImmutableOwner
    add(owner.bytes, rawbytes.BytesAlloc(4))
    return owner

fn main(): int32 =
    let owner = BuildNestedSequenceElementImmutableOwner()
    rawbytes.BytesFree(owner.bytes[0])
    return 0
