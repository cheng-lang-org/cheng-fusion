# libp2p CAS-source S1 codec 往返 + 畸形拒绝门禁 (正典 §11 P2 S1)。
# exe run 非 census: 断言失败即 abort 非零, 末行 "ok" 才打印。
#
# 覆盖:
#   (1) WANT(3 cid) / HAVE(3 cid + have 位混合) / BLOCK(2 cid: 空块 + 多字节块)
#       encode → decode 字段逐一相等 + re-encode 字节逐字节相等 (往返稳定)。
#   (2) 畸形: header 截断 / 未知 tag / 跨 tag / count 与实际不符 / have 非 0/1 /
#       block len>16MiB / block 尾部残字节 → 一律 decode Err (无静默错解)。

import std/system
import std/result
import std/rawbytes
import cheng/std/bytes_layout as layout
import cheng/libp2p/protocols/cas_source/codec as codec

fn mkCid(seed: int32): layout.FixedBytes32 =
    var b = BytesAlloc(32)
    for i in 0..<32:
        BytesSet(b, i, (seed + i) & 255)
    let res = layout.FixedBytes32FromBytes(b)
    assert(!IsErr(res), " mkCid 32B")
    return Value(res)

fn mkData(seed: int32, n: int32): Bytes =
    if n <= 0:
        return EmptyBytes()
    var b = BytesAlloc(n)
    for i in 0..<n:
        BytesSet(b, i, (seed * 7 + i) & 255)
    return b

fn main(): int32 =
    # ---- (1a) WANT 往返 ----
    var want: codec.CasSourceWantMsg
    add(want.cids, mkCid(1))
    add(want.cids, mkCid(40))
    add(want.cids, mkCid(200))

    var wEncRes: Result[Bytes] = codec.CasSourceWantEncode(want)
    assert(!IsErr(wEncRes), " want encode: " + Error(wEncRes))
    var wBytes = Value(wEncRes)
    assert(BytesLen(wBytes) == 3 + 3 * 32, " want wire len = 3 + 3*32")
    assert(BytesGet(wBytes, 0) == 0x01, " want tag 0x01")
    assert(BytesGet(wBytes, 1) == 0 && BytesGet(wBytes, 2) == 3, " want count big-endian = 3")

    var wDecRes: Result[codec.CasSourceWantMsg] = codec.CasSourceWantDecode(wBytes)
    assert(!IsErr(wDecRes), " want decode: " + Error(wDecRes))
    var want2 = Value(wDecRes)
    assert(want2.cids.len == 3, " want decode: 3 cid")
    for i in 0..<3:
        assert(layout.FixedBytes32Equal(want.cids[i], want2.cids[i]), " want cid 逐一相等")

    var wReRes: Result[Bytes] = codec.CasSourceWantEncode(want2)
    assert(!IsErr(wReRes), " want re-encode")
    assert(BytesEqual(wBytes, Value(wReRes)), " want re-encode 字节逐字节相等")

    # ---- (1b) HAVE 往返 (have 位混合) ----
    var have: codec.CasSourceHaveMsg
    var he0: codec.CasSourceHaveEntry
    he0.cid = mkCid(11)
    he0.have = true
    add(have.entries, he0)
    var he1: codec.CasSourceHaveEntry
    he1.cid = mkCid(77)
    he1.have = false
    add(have.entries, he1)
    var he2: codec.CasSourceHaveEntry
    he2.cid = mkCid(255)
    he2.have = true
    add(have.entries, he2)

    var hEncRes: Result[Bytes] = codec.CasSourceHaveEncode(have)
    assert(!IsErr(hEncRes), " have encode: " + Error(hEncRes))
    var hBytes = Value(hEncRes)
    assert(BytesLen(hBytes) == 3 + 3 * 33, " have wire len = 3 + 3*33")
    assert(BytesGet(hBytes, 0) == 0x02, " have tag 0x02")

    var hDecRes: Result[codec.CasSourceHaveMsg] = codec.CasSourceHaveDecode(hBytes)
    assert(!IsErr(hDecRes), " have decode: " + Error(hDecRes))
    var have2 = Value(hDecRes)
    assert(have2.entries.len == 3, " have decode: 3 entry")
    for i in 0..<3:
        assert(layout.FixedBytes32Equal(have.entries[i].cid, have2.entries[i].cid), " have cid 逐一相等")
        assert(have.entries[i].have == have2.entries[i].have, " have 位逐一相等")

    var hReRes: Result[Bytes] = codec.CasSourceHaveEncode(have2)
    assert(!IsErr(hReRes), " have re-encode")
    assert(BytesEqual(hBytes, Value(hReRes)), " have re-encode 字节逐字节相等")

    # ---- (1c) BLOCK 往返 (空块 + 多字节块) ----
    var block: codec.CasSourceBlockMsg
    var be0: codec.CasSourceBlockEntry
    be0.cid = mkCid(20)
    be0.data = EmptyBytes()                 # 空块
    add(block.entries, be0)
    var be1: codec.CasSourceBlockEntry
    be1.cid = mkCid(21)
    be1.data = mkData(3, 250)               # 变长多字节块
    add(block.entries, be1)

    var bEncRes: Result[Bytes] = codec.CasSourceBlockEncode(block)
    assert(!IsErr(bEncRes), " block encode: " + Error(bEncRes))
    var bBytes = Value(bEncRes)
    # 3(hdr) + [32+4+0] + [32+4+250]
    assert(BytesLen(bBytes) == 3 + 36 + 36 + 250, " block wire len")
    assert(BytesGet(bBytes, 0) == 0x03, " block tag 0x03")

    var bDecRes: Result[codec.CasSourceBlockMsg] = codec.CasSourceBlockDecode(bBytes)
    assert(!IsErr(bDecRes), " block decode: " + Error(bDecRes))
    var block2 = Value(bDecRes)
    assert(block2.entries.len == 2, " block decode: 2 entry")
    assert(layout.FixedBytes32Equal(block.entries[0].cid, block2.entries[0].cid), " block cid0 相等")
    assert(BytesLen(block2.entries[0].data) == 0, " block 空块 len=0")
    assert(layout.FixedBytes32Equal(block.entries[1].cid, block2.entries[1].cid), " block cid1 相等")
    assert(BytesEqual(block.entries[1].data, block2.entries[1].data), " block 多字节块数据相等")

    var bReRes: Result[Bytes] = codec.CasSourceBlockEncode(block2)
    assert(!IsErr(bReRes), " block re-encode")
    assert(BytesEqual(bBytes, Value(bReRes)), " block re-encode 字节逐字节相等")

    # ---- (2) 畸形拒绝 ----
    # header 截断 (< 3 字节)
    var trunc = BytesAlloc(2)
    assert(IsErr(codec.CasSourceWantDecode(trunc)), " 畸形: want header 截断 → Err")
    assert(IsErr(codec.CasSourceHaveDecode(trunc)), " 畸形: have header 截断 → Err")
    assert(IsErr(codec.CasSourceBlockDecode(trunc)), " 畸形: block header 截断 → Err")

    # 未知/错误 tag (翻 byte0)
    var badTag = BytesAlloc(BytesLen(wBytes))
    BytesCopyInto(badTag, 0, wBytes)
    BytesSet(badTag, 0, 0x09)
    assert(IsErr(codec.CasSourceWantDecode(badTag)), " 畸形: want 未知 tag → Err")

    # 跨 tag: 拿 HAVE 字节喂 WANT decode
    assert(IsErr(codec.CasSourceWantDecode(hBytes)), " 畸形: 跨 tag (have→want) → Err")

    # count 与实际不符 (砍掉尾部 5 字节, count 仍写 3)
    var wShort = BytesSlice(wBytes, 0, BytesLen(wBytes) - 5)
    assert(IsErr(codec.CasSourceWantDecode(wShort)), " 畸形: want count 与实际不符 → Err")

    # have 位非 0/1
    var badHave = BytesAlloc(3 + 33)
    BytesSet(badHave, 0, 0x02)
    BytesSet(badHave, 1, 0)
    BytesSet(badHave, 2, 1)          # count = 1
    BytesSet(badHave, 3 + 32, 0x05)  # have 字节 = 5 (非法)
    assert(IsErr(codec.CasSourceHaveDecode(badHave)), " 畸形: have 位非 0/1 → Err")

    # block len 越界 (>16MiB): 手工造 len=0x02000000 (33MiB)
    var badLen = BytesAlloc(3 + 36)
    BytesSet(badLen, 0, 0x03)
    BytesSet(badLen, 1, 0)
    BytesSet(badLen, 2, 1)           # count = 1
    BytesSet(badLen, 3 + 32, 0x02)   # len 高字节 0x02 → 33 MiB
    assert(IsErr(codec.CasSourceBlockDecode(badLen)), " 畸形: block len>16MiB → Err")

    # block 尾部残字节
    var bTrail = BytesAlloc(BytesLen(bBytes) + 1)
    BytesCopyInto(bTrail, 0, bBytes)
    assert(IsErr(codec.CasSourceBlockDecode(bTrail)), " 畸形: block 尾部残字节 → Err")

    echo(" cas_source_codec_roundtrip_smoke ok")
    return 0
