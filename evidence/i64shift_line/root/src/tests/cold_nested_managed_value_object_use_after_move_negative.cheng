type
    ColdManagedMoveNegativeLeaf = ref object
        value: int32

    ColdManagedMoveNegativeInner =
        leaf: ColdManagedMoveNegativeLeaf

    ColdManagedMoveNegativeOuter =
        inner: ColdManagedMoveNegativeInner

fn ColdManagedMoveNegativeMakeOuter(
        value: int32): ColdManagedMoveNegativeOuter =
    var out: ColdManagedMoveNegativeOuter
    out.inner.leaf = new(ColdManagedMoveNegativeLeaf)
    out.inner.leaf.value = value
    return out

fn main(): int32 =
    let source = ColdManagedMoveNegativeMakeOuter(7)
    var rows: ColdManagedMoveNegativeOuter[]
    add(rows, source)
    return source.inner.leaf.value
