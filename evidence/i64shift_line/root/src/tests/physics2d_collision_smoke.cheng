import cheng/game/ecs
import cheng/game/physics2d

fn main(): int32 =
    var world: ecs.EcsWorld
    ecs.EcsWorldReset(world)
    let left = ecs.EcsWorldSpawn(world, 0, 0, 1, "cid:left")
    let right = ecs.EcsWorldSpawn(world, 900, 0, 1, "cid:right")
    assert(ecs.EcsWorldSetAabbCollider(world, left, 500, 500), "physics2d collision: left collider")
    assert(ecs.EcsWorldSetAabbCollider(world, right, 500, 500), "physics2d collision: right collider")
    assert(ecs.EcsWorldSetVelocity(world, left, 100, 0), "physics2d collision: left velocity")
    assert(ecs.EcsWorldSetVelocity(world, right, -100, 0), "physics2d collision: right velocity")

    let receipt = physics2d.Physics2dStep(world, 0, 16)
    assert(receipt.statusCode == physics2d.Physics2dStatusOk, "physics2d collision: status")
    assert(receipt.contactCount == 1, "physics2d collision: contact count")
    assert(receipt.separationIterations == 1, "physics2d collision: separation count")
    assert(physics2d.Physics2dReceiptValid(receipt), "physics2d collision: receipt valid")

    let leftIndex = ecs.EcsWorldIndexOf(world, left)
    let rightIndex = ecs.EcsWorldIndexOf(world, right)
    assert(leftIndex >= 0, "physics2d collision: left entity index")
    assert(rightIndex >= 0, "physics2d collision: right entity index")
    assert(ecs.EcsWorldPositionXAt(world, rightIndex) - ecs.EcsWorldPositionXAt(world, leftIndex) >= 1000,
        "physics2d collision: separated")
    assert(ecs.EcsWorldVelocityXAt(world, leftIndex) == -100, "physics2d collision: left bounced")
    assert(ecs.EcsWorldVelocityXAt(world, rightIndex) == 100, "physics2d collision: right bounced")

    return 0
