# Loopback QUIC bulk-transfer CPU bench — server half.
# Serves a single fixed-size payload once over the native QUIC stack (real
# framing + AEAD + ack loop), no MoQ/media layer. Used to measure per-packet
# CPU cost isolated from mp4 ingest/fountain overhead.
import std/system
import std/cmdline as cmdline
import std/rawbytes
import cheng/libp2p/core/types
import cheng/libp2p/transports/quic_transport

fn main(): int32 =
    let port = cmdline.ReadInt32FlagOrDefault("--port", 0)
    let readyPath = cmdline.ReadFlagOrDefault("--ready-path", "")
    let sizeBytes = cmdline.ReadInt32FlagOrDefault("--size", 1048576)
    var payload: rawbytes.Bytes = rawbytes.BytesAlloc(sizeBytes)
    var i: int32
    for i in 0..<sizeBytes:
        rawbytes.BytesSet(payload, i, i & 255)
    let serveRes = quic_transport.Libp2pQuicServePayloadOnce("127.0.0.1",
                                                               port,
                                                               types.Libp2pProtocolSync,
                                                               payload,
                                                               readyPath)
    assert(serveRes.ok, " quicframe_bench_server: serve failed")
    echo(" quicframe_bench_server ok")
    return 0
