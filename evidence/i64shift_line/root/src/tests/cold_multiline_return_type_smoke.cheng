import std/os
import cheng/std/bytes_layout as layout

fn ColdMultilineReturnTypeValue():
        layout.FixedBytes32 =
    var out: layout.FixedBytes32
    out.data[0] = uint8(37)
    return out

fn main() =
    let value = ColdMultilineReturnTypeValue()
    assert(layout.FixedBytes32Equal(value, ColdMultilineReturnTypeValue()),
           "multiline return type changed composite call result kind")
    assert(Int32(value.data[0]) == 37,
           "multiline return type changed composite call result bytes")
    os.WriteLine(os.Get_stdout(), "cold_multiline_return_type_smoke: ok")
