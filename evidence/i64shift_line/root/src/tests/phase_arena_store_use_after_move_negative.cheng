import cheng/core/ir/phase_arena as phase

fn consumeStore(store: phase.PhaseArenaStore): int32 =
    return 1

fn main(): int32 =
    var store: phase.PhaseArenaStore
    phase.PhaseArenaStoreInit(store, 1, 32, 1)
    let consumed = consumeStore(store)
    if consumed != 1:
        return 2
    return int32(phase.PhaseArenaStoreRetainedBytes(store))
