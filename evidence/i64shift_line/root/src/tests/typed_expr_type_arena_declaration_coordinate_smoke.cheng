import std/strutils as strutil
import cheng/core/lang/parser
import cheng/core/lang/typed_expr_type_arena as typearena
import cheng/core/runtime/arena as arenamod

fn main(): int32 =
    let source =
        "type Record =\n    signed: int16\n    unsigned: uint16\n"
    var tree: parser.ParserValueExprTree
    var err: str
    assert(
        parser.ParserValueExprReadTreeFromText(
            source, tree, err),
        Fmt"typed expr type arena declaration coordinate: parse failed {err}")
    var arena: typearena.TypedExprTypeArena
    let authority =
        typearena.TypedExprTypeResolutionAuthorityEmpty()
    assert(typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               tree, authority, arena, err),
           Fmt"typed expr type arena declaration coordinate: build failed {err}")
    assert(typearena.TypedExprTypeArenaStrictValidateInto(arena, err),
           Fmt"typed expr type arena declaration coordinate: strict failed {err}")
    var typeDeclarationRow: int32 = -1
    var signedFieldRow: int32 = -1
    var unsignedFieldRow: int32 = -1
    for declarationRow in 0..<tree.declarationCount:
        let kind = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.declarationKinds, declarationRow)
        let sourceLocalRow = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationSourceLocalRows,
            declarationRow)
        if kind == Int32(parser.ParserDeclarationType):
            typeDeclarationRow = sourceLocalRow
        elif kind == Int32(parser.ParserDeclarationField):
            if signedFieldRow < 0:
                signedFieldRow = sourceLocalRow
            else:
                unsignedFieldRow = sourceLocalRow
    assert(typeDeclarationRow >= 0 &&
           signedFieldRow >= 0 &&
           unsignedFieldRow >= 0,
           "typed expr type arena declaration coordinate: parser rows missing")
    let recordTypeId =
        typearena.TypedExprTypeArenaTypeDeclarationTypeIdAt(
            arena, 0, typeDeclarationRow)
    let signedTypeId =
        typearena.TypedExprTypeArenaFieldDeclarationMemberTypeIdAt(
            arena, 0, signedFieldRow, 0)
    let unsignedTypeId =
        typearena.TypedExprTypeArenaFieldDeclarationMemberTypeIdAt(
            arena, 0, unsignedFieldRow, 1)
    let recordKind =
        typearena.TypedExprTypeArenaKindAt(arena, recordTypeId)
    let signedKind = arenamod.ArenaArrayInt32Get(
        arena.arena, arena.scalarKinds, signedTypeId)
    let unsignedKind = arenamod.ArenaArrayInt32Get(
        arena.arena, arena.scalarKinds, unsignedTypeId)
    assert(recordKind == typearena.TypedExprStructuralTypeObject,
           "typed expr type arena declaration coordinate: record TypeId drift")
    assert(signedKind ==
               Int32(typearena.TypedExprStructuralScalarInt16),
           "typed expr type arena declaration coordinate: signed field drift")
    assert(unsignedKind ==
               Int32(typearena.TypedExprStructuralScalarUInt16),
           "typed expr type arena declaration coordinate: unsigned field drift")
    let declarationStart = arenamod.ArenaArrayInt32Get(
        arena.arena, arena.declarationTypeStarts, 0)
    var typeAttack = typearena.TypedExprTypeArenaClone(arena)
    arenamod.ArenaArrayInt32Set(
        typeAttack.arena,
        typeAttack.declarationTypeIds,
        declarationStart + typeDeclarationRow,
        signedTypeId)
    typeAttack.artifactRaw32 =
        typearena.TypedExprTypeArenaArtifactCidForCurrentState(typeAttack)
    let typeRejected =
        !typearena.TypedExprTypeArenaStrictValidateInto(
            typeAttack, err)
    assert(typeRejected &&
           (strutil.Contains(err, "declaration TypeId drift") ||
            strutil.Contains(err, "type declaration coordinate")),
        "typed expr type arena declaration coordinate: recomputed-CID type mutation survived")
    var fieldAttack = typearena.TypedExprTypeArenaClone(arena)
    arenamod.ArenaArrayInt32Set(
        fieldAttack.arena,
        fieldAttack.declarationMemberOrdinals,
        declarationStart + signedFieldRow,
        1)
    fieldAttack.artifactRaw32 =
        typearena.TypedExprTypeArenaArtifactCidForCurrentState(fieldAttack)
    let fieldRejected =
        !typearena.TypedExprTypeArenaStrictValidateInto(
            fieldAttack, err)
    assert(fieldRejected &&
           strutil.Contains(err, "field declaration/member"),
        "typed expr type arena declaration coordinate: recomputed-CID field ordinal mutation survived")
    let firstDuplicateSource =
        "type Same =\n    value: int16\n"
    let secondDuplicateSource =
        "type Same =\n    value: uint16\n"
    var firstDuplicateTree: parser.ParserValueExprTree
    var secondDuplicateTree: parser.ParserValueExprTree
    var duplicateForest: parser.ParserValueExprTree
    assert(parser.ParserValueExprReadTreeFromText(
               firstDuplicateSource, firstDuplicateTree, err) &&
           parser.ParserValueExprReadTreeFromText(
               secondDuplicateSource, secondDuplicateTree, err),
           Fmt"typed expr type arena declaration coordinate: duplicate-name parse failed {err}")
    parser.ParserValueExprTreeAppendFrom(
        duplicateForest, firstDuplicateTree)
    parser.ParserValueExprTreeAppendFrom(
        duplicateForest, secondDuplicateTree)
    parser.ParserValueExprTreeRelease(secondDuplicateTree)
    parser.ParserValueExprTreeRelease(firstDuplicateTree)
    var duplicateArena: typearena.TypedExprTypeArena
    assert(typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               duplicateForest, authority, duplicateArena, err) &&
           typearena.TypedExprTypeArenaStrictValidateInto(
               duplicateArena, err),
           Fmt"typed expr type arena declaration coordinate: duplicate-name build failed {err}")
    var firstFieldSourceLocalRow: int32 = -1
    var secondFieldSourceLocalRow: int32 = -1
    for declarationRow in 0..<duplicateForest.declarationCount:
        if arenamod.ArenaArrayInt32Get(
               duplicateForest.arena,
               duplicateForest.declarationKinds,
               declarationRow) !=
               Int32(parser.ParserDeclarationField):
            continue
        let producerSourceIndex = arenamod.ArenaArrayInt32Get(
            duplicateForest.arena,
            duplicateForest.declarationProducerSourceIndexes,
            declarationRow)
        let sourceLocalRow = arenamod.ArenaArrayInt32Get(
            duplicateForest.arena,
            duplicateForest.declarationSourceLocalRows,
            declarationRow)
        if producerSourceIndex == 0:
            firstFieldSourceLocalRow = sourceLocalRow
        elif producerSourceIndex == 1:
            secondFieldSourceLocalRow = sourceLocalRow
    assert(firstFieldSourceLocalRow >= 0 &&
           secondFieldSourceLocalRow >= 0,
           "typed expr type arena declaration coordinate: duplicate-name field rows missing")
    let firstDeclarationStart = arenamod.ArenaArrayInt32Get(
        duplicateArena.arena,
        duplicateArena.declarationTypeStarts,
        0)
    let secondDeclarationStart = arenamod.ArenaArrayInt32Get(
        duplicateArena.arena,
        duplicateArena.declarationTypeStarts,
        1)
    let firstFieldCoordinate =
        firstDeclarationStart + firstFieldSourceLocalRow
    let secondFieldCoordinate =
        secondDeclarationStart + secondFieldSourceLocalRow
    let firstFieldTypeId = arenamod.ArenaArrayInt32Get(
        duplicateArena.arena,
        duplicateArena.declarationTypeIds,
        firstFieldCoordinate)
    let secondFieldTypeId = arenamod.ArenaArrayInt32Get(
        duplicateArena.arena,
        duplicateArena.declarationTypeIds,
        secondFieldCoordinate)
    assert(firstFieldTypeId != secondFieldTypeId,
           "typed expr type arena declaration coordinate: duplicate-name scalar TypeIds collapsed")
    var crossSourceAttack =
        typearena.TypedExprTypeArenaClone(duplicateArena)
    arenamod.ArenaArrayInt32Set(
        crossSourceAttack.arena,
        crossSourceAttack.declarationTypeIds,
        firstFieldCoordinate,
        secondFieldTypeId)
    arenamod.ArenaArrayInt32Set(
        crossSourceAttack.arena,
        crossSourceAttack.declarationTypeIds,
        secondFieldCoordinate,
        firstFieldTypeId)
    crossSourceAttack.artifactRaw32 =
        typearena.TypedExprTypeArenaArtifactCidForCurrentState(
            crossSourceAttack)
    assert(!typearena.TypedExprTypeArenaStrictValidateInto(
               crossSourceAttack, err) &&
           strutil.Contains(err, "declaration TypeId drift"),
           "typed expr type arena declaration coordinate: cross-source duplicate-name TypeId swap survived")
    typearena.TypedExprTypeArenaRelease(crossSourceAttack)
    typearena.TypedExprTypeArenaRelease(duplicateArena)
    parser.ParserValueExprTreeRelease(duplicateForest)
    typearena.TypedExprTypeArenaRelease(fieldAttack)
    typearena.TypedExprTypeArenaRelease(typeAttack)
    typearena.TypedExprTypeArenaRelease(arena)
    parser.ParserValueExprTreeRelease(tree)
    echo("typed_expr_type_arena_declaration_coordinate_smoke: ok")
    return 0
