fn absI32(v: int32): int32 =
    if v < 0:
        return -v
    return v

fn rotateAtPosition(out: var infer.TensorQ, input: infer.TensorQ, position: int32): Result[bool] =
    var invFreq: float64[]
    let invFreqOk = exec.ModelExecutorRopeInvFreqFill(invFreq, 32, 1000000.0)
    if IsErr(invFreqOk):
        return Err[bool](Error(invFreqOk))
    var cosRow: int32[]
    var sinRow: int32[]
    let rowOk = exec.ModelExecutorRopeCosSinRowFill(cosRow, sinRow, invFreq, position)
    if IsErr(rowOk):
        return Err[bool](Error(rowOk))
    let copyOk = infer.TensorFromDataFill(out, input.shape, input.scale, input.data)
    if IsErr(copyOk):
        return Err[bool](Error(copyOk))
    return exec.ModelExecutorRopeRotateSpan(out, 0, 0, 64, cosRow, sinRow)

fn checkPosition(label: str, position: int32, golden: int32[], tolUnits: int32): bool =
    var input: infer.TensorQ
    let fillOk = infer.TensorFromDataFill(input, [1, 64], 1000, qVec())
    if IsErr(fillOk):
        os.WriteLine(os.Get_stderr(), strutil.Join(["FAIL ", label, ": input tensor build"], ""))
        return false
    var out: infer.TensorQ
    let ropeOk = rotateAtPosition(out, input, position)
    if IsErr(ropeOk):
        os.WriteLine(os.Get_stderr(), strutil.Join(["FAIL ", label, ": rope error"], ""))
        return false
    if out.data.len != golden.len:
        os.WriteLine(os.Get_stderr(), strutil.Join(["FAIL ", label, ": length mismatch"], ""))
        return false
    var worst: int32
    var worstIdx: int32
    for i in 0..<golden.len:
        let d = absI32(out.data[i] - golden[i])
        if d > worst:
            worst = d
            worstIdx = i
    if worst > tolUnits:
        os.WriteLine(os.Get_stderr(), strutil.Join([
            "FAIL ", label, ": worst diff=", strings.IntToStr(worst),
            " at idx=", strings.IntToStr(worstIdx),
            " actual=", strings.IntToStr(out.data[worstIdx]),
            " expected=", strings.IntToStr(golden[worstIdx])
        ], ""))
        return false
    os.WriteLine(os.Get_stdout(), strutil.Join(["ok ", label, " worst_diff_units=", strings.IntToStr(worst)], ""))
    return true

fn main(): int32 =
    var allOk = true
    // tolUnits=2 at scale=1000 => 0.002 absolute tolerance on the
    // dequantized activation, dominated by the int32 Q-format step size
    // (1/1000) rather than by trig precision (trig table quantization
    // step is 2^-30, ~10 orders of magnitude finer).
    allOk = checkPosition("pos0_identity", 0, goldenPos0(), 0) && allOk
    allOk = checkPosition("pos1", 1, goldenPos1(), 2) && allOk
    allOk = checkPosition("pos100", 100, goldenPos100(), 2) && allOk
    allOk = checkPosition("pos8192_large", 8192, goldenPos8192(), 2) && allOk
    if allOk:
        os.WriteLine(os.Get_stdout(), "rope_hf_parity_smoke ok")
        return 0
    os.WriteLine(os.Get_stderr(), "rope_hf_parity_smoke FAILED")
    return 1
