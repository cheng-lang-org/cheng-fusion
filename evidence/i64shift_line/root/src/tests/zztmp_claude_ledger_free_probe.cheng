import std/os
import std/system
import std/strings as strings
import std/strutil as strutil
import cheng/core/tooling/lifetime_ledger as ledger

@importc("cheng_mm_foreign_free_count")
fn probeForeignFreeCount(): int64

fn emitLine(label: str, value: int64) =
    os.WriteLine(os.Get_stdout(),
                 strutil.Join([label, "=", strings.Int64ToStr(value)], ""))

fn main(): int32 =
    var observed: ledger.LifetimeLedger
    ledger.LifetimeLedgerInit(observed)
    let category = ledger.LifetimeLedgerRegisterCategory(observed, "typed_ir_nodes2")
    let ownerA = ledger.LifetimeLedgerRegisterOwner(observed, "compiler_csg")
    let objectId = ledger.LifetimeLedgerReserveObject(observed, category, int64(96))
    ledger.LifetimeLedgerOwn(observed, objectId, ownerA)
    ledger.LifetimeLedgerRelease(observed, objectId, ownerA)
    ledger.LifetimeLedgerAssertOwnerClosed(observed, ownerA)
    ledger.LifetimeLedgerAssertClosed(observed)
    var metrics: ledger.LifetimeLedgerMetrics
    ledger.LifetimeLedgerReadTotalMetrics(observed, metrics)

    let allocBefore = system.memAllocCount()
    let freeBefore = system.memFreeCount()
    let foreignBefore = probeForeignFreeCount()
    ledger.LifetimeLedgerReleaseStorage(observed)
    let allocAfter = system.memAllocCount()
    let freeAfter = system.memFreeCount()
    let foreignAfter = probeForeignFreeCount()

    emitLine("alloc_before", allocBefore)
    emitLine("free_before", freeBefore)
    emitLine("foreign_before", foreignBefore)
    emitLine("alloc_after", allocAfter)
    emitLine("free_after", freeAfter)
    emitLine("foreign_after", foreignAfter)
    emitLine("free_delta", freeAfter - freeBefore)
    emitLine("foreign_delta", foreignAfter - foreignBefore)
    emitLine("storage_released", ledger.LifetimeLedgerStorageReleased(observed) ? int64(1) : int64(0))
    return 0
