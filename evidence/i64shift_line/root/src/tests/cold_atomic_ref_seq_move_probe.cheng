import std/atomic

var globalHeads: atomic.I32[]
var globalDone: atomic.I32

fn prepareHeads(workerCount: int32) =
    globalHeads = []
    globalDone = atomic.NewI32(0)
    if globalDone == nil:
        return
    var preparedHeads: atomic.I32[]
    for workerId in 0..<workerCount:
        let start = workerId * 2
        let finish = start + 1
        let head = atomic.NewI32(start)
        let tail = atomic.NewI32(finish)
        if head == nil || tail == nil:
            return
        add(preparedHeads, head)
        add(preparedHeads, tail)
    globalHeads = preparedHeads

fn main(): int32 =
    prepareHeads(1)
    if globalHeads.len != 2:
        return 2
    if atomic.LoadI32(globalHeads[0]) != 0:
        return 3
    if atomic.LoadI32(globalHeads[1]) != 1:
        return 4
    return 0
