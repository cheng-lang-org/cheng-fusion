import std/system
import std/strings
import cheng/core/ir/csg_web_facts as csgweb
import cheng/apps/libp2p_browser/session as sess
import cheng/apps/libp2p_browser/computer_use_csg_export as csgx

fn fail(code: int32, msg: str): int32 =
    echo(msg)
    return code

fn fixture(): str =
    var s: str = "CLB4\n400 600 6 1\n"
    s = strings.ConcatStr(s, "4 10 20 120 32 -1 -16777216 14 1 -16777216 2 400 0 0 0 0 0 0 0 400 600\nbutton\n\nbutton\nbtnOk\nGo\nGo\nsans-serif\n\n\n")
    s = strings.ConcatStr(s, "1 10 70 200 32 -1 -16777216 14 1 -16777216 2 400 0 0 0 0 0 0 0 400 600\ntext\n\ntext\nq\n\n\nsans-serif\n\n\n")
    s = strings.ConcatStr(s, "6 10 120 180 32 -1 -16777216 14 1 -16777216 2 400 0 0 0 0 0 0 0 400 600\nselect\n\nselect-one\ns\n\n\nsans-serif\n\n0\ta\tAlpha%0A0\tb\tBeta%0A1\tc\tGamma\n")
    s = strings.ConcatStr(s, "1 10 170 200 32 -1 -16777216 14 1 -16777216 2 400 0 0 0 0 0 0 0 400 600\ntext\n\ntext\nfrozen\n\n\nsans-serif\n\n\n")
    s = strings.ConcatStr(s, "1 10 220 200 32 -1 -16777216 14 1 -16777216 2 400 0 0 0 0 0 0 0 400 600\nnumber\n\nnumber\nn\n\n\nsans-serif\n\n\n")
    s = strings.ConcatStr(s, "1 10 270 200 20 -1 -16777216 13 0 0 0 400 0 0 0 0 0 0 0 400 600\ncheckbox\n\ncheckbox\nnl\non\n\nsans-serif\n\n\n")
    s = strings.ConcatStr(s, "CTL|0|3|0|button|Go\n")
    s = strings.ConcatStr(s, "CTL|1|4|0||Quantity\n")
    s = strings.ConcatStr(s, "CTL|2|5|0||Choose\n")
    # Frozen 带显式 role=tab: 导出必须透传显式 role 而非 implicit 推导
    s = strings.ConcatStr(s, "CTL|3|6|1|tab|Frozen\n")
    s = strings.ConcatStr(s, "CTL|4|7|0||Count\n")
    s = strings.ConcatStr(s, "CTL|5|8|4||Newsletter\n")
    return s

fn main(): int32 =
    let src = fixture()
    var session = sess.BrowserSessionInit("csg-peer", 400, 600)
    if !sess.BrowserSessionOnPageSnapshot(session, "https://ex.test/csg", src):
        echo(session.lastError)
        return fail(1, "csg session snapshot")
    let facts = csgx.BrowserCsgExportControlSurface(session, "https://ex.test/csg")
    if facts.len != 6:
        echo(strings.IntToStr(facts.len))
        return fail(2, "fact count")
    var i: int32 = 0
    while i < facts.len:
        if facts[i].kind != csgweb.CsgWebControlSurface:
            return fail(3, "fact kind")
        var wantId: str = "csg.web.control_surface:ctl-"
        wantId = strings.ConcatStr(wantId, strings.IntToStr(i + 3))
        if facts[i].id != wantId:
            echo(facts[i].id)
            return fail(4, "fact id")
        if facts[i].owner != "https://ex.test/csg" || facts[i].sourceFile != "https://ex.test/csg":
            return fail(5, "fact owner")
        i = i + 1
    # button: implicit role=button, Click, 无 payload
    if facts[0].role != "button" || facts[0].actionKind != "Click" || facts[0].payloadSchema != "":
        return fail(6, "button mapping")
    if facts[0].label != "Go" || facts[0].stateRef != "btnOk" || facts[0].guard != "":
        return fail(7, "button label/state/guard")
    # text input: textbox + SetText/text
    if facts[1].role != "textbox" || facts[1].actionKind != "SetText" || facts[1].payloadSchema != "text":
        return fail(8, "textbox mapping")
    # select: combobox + Select/option-ref
    if facts[2].role != "combobox" || facts[2].actionKind != "Select" || facts[2].payloadSchema != "option-ref":
        return fail(9, "select mapping")
    # disabled input 带显式 role=tab: 透传显式 role, guard=disabled
    if facts[3].role != "tab":
        echo(facts[3].role)
        return fail(10, "explicit role passthrough")
    if facts[3].guard != "disabled" || facts[3].actionKind != "SetText":
        return fail(11, "disabled guard")
    # number input: spinbutton + SetText/number
    if facts[4].role != "spinbutton" || facts[4].actionKind != "SetText" || facts[4].payloadSchema != "number":
        return fail(12, "number mapping")
    # checkbox (checked 位不在 guard): checkbox + Toggle, 无 payload
    if facts[5].role != "checkbox" || facts[5].actionKind != "Toggle" || facts[5].payloadSchema != "":
        return fail(13, "checkbox mapping")
    # trace/nodeTemplate/coreFact
    if facts[0].trace != "clb4:ctl-3" || facts[0].nodeTemplate != "btnOk" || facts[0].coreFact != "clb4-snapshot":
        return fail(14, "trace/nodeTemplate/coreFact")
    echo("libp2p_browser_csg_export_smoke ok")
    return 0
