fn R19Trim(raw: str): str =
    return raw

fn R19Tag(raw: str): str =
    if raw.len > 3:
        return "long"
    return "short"

fn R19NegCore(lineRaw: str, useTag: int32): int32 =
    let line = R19Trim(lineRaw)
    var tail: str
    if useTag > 0:
        tail = R19Tag(line)
    else:
        tail = line
    let n = tail.len
    if n <= 0:
        return 0
    let left = R19Trim(tail)
    return left.len + line.len

fn main(): int32 =
    let n = R19NegCore("abcdef", 1)
    if n != 10:
        return 10
    echo("neg reached")
    return 0
