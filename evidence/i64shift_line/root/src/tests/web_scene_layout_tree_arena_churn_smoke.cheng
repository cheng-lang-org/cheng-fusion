# WebLayoutTree arena 化 churn 探针：~1000 节点+文本节点的图，250 次
# WebSceneApplyRouteLayoutToPaintOps，采样 RSS。arena 复用后 RSS 应在预热后
# 走平（旧实现每次换 fresh Init + grow-from-8，碎片页滞留线性涨）。
import std/os as os
import cheng/core/runtime/web_scene_runtime as scene
import cheng/core/runtime/web_layout_runtime as layout

fn BuildGraph(graph: var scene.WebSceneGraph, routeIndex: var int32): bool =
    scene.WebSceneGraphInit(graph)
    if !scene.WebSceneAddRoute(graph, "churn_route", 1, 1, routeIndex):
        echo("AddRoute failed")
        return false
    var layerId = 1
    while layerId <= 24:
        if !scene.WebSceneAddLayer(graph, routeIndex, layerId, Fmt"layer{layerId}", layerId - 1):
            echo("AddLayer failed")
            return false
        layerId = layerId + 1
    if !scene.WebSceneAddNode(graph, routeIndex, 1, 0, 2, "div", "", 1):
        echo("AddNode root failed")
        return false
    # 24 层 × 40 节点 ≈ 960 div 节点 + 每 4 节点 1 个文本节点
    var nodeId = 2
    var n = 0
    while n < 960:
        let layerId = 1 + (n % 24)
        if !scene.WebSceneAddNode(graph, routeIndex, nodeId, 1, 2, "div", "", layerId):
            echo("AddNode failed")
            return false
        if !scene.WebSceneAddPaintOpAt(graph, routeIndex, nodeId, 0, 0, 0,
                                       scene.WebScenePaintFill, Int64(4278190080),
                                       0, 10, 10, "", ""):
            echo("AddPaintOp failed")
            return false
        if n % 4 == 0:
            var textId = nodeId + 10000
            if !scene.WebSceneAddNode(graph, routeIndex, textId, nodeId, 3, "span",
                                      "sample text node for churn probe", layerId):
                echo("AddTextNode failed")
                return false
            if !scene.WebSceneAddPaintOpAt(graph, routeIndex, textId, 0, 0, 0,
                                           scene.WebScenePaintTextColor, Int64(4278190080),
                                           0, 8, 8, "",
                                           "sample text node for churn probe"):
                echo("AddTextOp failed")
                return false
        nodeId = nodeId + 1
        n = n + 1
    return true

fn main(): int32 =
    var graph: scene.WebSceneGraph
    var routeIndex: int32 = 0
    if !BuildGraph(graph, routeIndex):
        return 1
    # 预热 10 次（arena 容量成形）
    var i = 0
    while i < 10:
        if !scene.WebSceneApplyRouteLayoutToPaintOps(graph, routeIndex, 390, 844):
            echo("warmup apply failed")
            return 2
        i = i + 1
    let rssStart = os.ProcessRssBytes()
    # 相位 1：只重建布局树（arena 复用路径本体）
    i = 0
    while i < 250:
        if !scene.WebSceneBuildRouteLayoutTreeReused(graph, routeIndex, 390, 844, __probeTree):
            echo(Fmt"phase1 build failed at {i}")
            return 3
        i = i + 1
    let rssAfterBuild = os.ProcessRssBytes()
    # 相位 2a：建树 + layoutBoxes 回写（不碰 paintOp）
    i = 0
    while i < 250:
        if !scene.WebSceneBuildRouteLayoutTreeReused(graph, routeIndex, 390, 844, __probeTree):
            echo(Fmt"phase2a build failed at {i}")
            return 3
        if !scene.WebSceneRefreshRouteLayoutBoxes(graph, routeIndex, __probeTree):
            echo(Fmt"phase2a refresh failed at {i}")
            return 3
        i = i + 1
    let rssAfterRefresh = os.ProcessRssBytes()
    # 相位 2b：完整每换路径（含 paintOp 几何补丁）
    i = 0
    while i < 250:
        if !scene.WebSceneApplyRouteLayoutToPaintOps(graph, routeIndex, 390, 844):
            echo(Fmt"apply failed at {i}")
            return 3
        if i % 50 == 49:
            echo(Fmt"phase2b iter={i} rss={os.ProcessRssBytes()}")
        i = i + 1
    let rssEnd = os.ProcessRssBytes()
    echo(Fmt"nodes={graph.nodes.len} paintOps={graph.paintOps.len}")
    echo(Fmt"phase1_build_drift={rssAfterBuild - rssStart} phase2a_refresh_drift={rssAfterRefresh - rssAfterBuild} phase2b_full_drift={rssEnd - rssAfterRefresh} total_drift_bytes={rssEnd - rssStart}")
    # 漂移阈值：arena 复用后 250 换应 < 8MB（旧形态约 90MB 量级：363KB/换）
    if rssEnd - rssStart > 8388608:
        echo("CHURN-FAIL drift over 8MB")
        return 4
    echo("CHURN-OK")
    return 0

var __probeTree: layout.WebLayoutTree
