import std/rawbytes
import cheng/tests/cold_import_bool_return_helper as helper

fn main(): int32 =
    var p: helper.ColdImportBoolPoint
    var b: Bytes
    b = BytesAlloc(32)
    if !helper.ColdImportBoolInner(p, b):
        return 1
    if int32(p.y.v0) != 32:
        return 2
    p.y.v0 = int64(0)
    if !helper.ColdImportBoolOuter(p, b):
        return 3
    if int32(p.y.v0) != 32:
        return 4
    return 0
