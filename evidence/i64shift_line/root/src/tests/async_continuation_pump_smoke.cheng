import std/system
import std/strings as strings
import std/strutils as strutil

# ---------------------------------------------------------------------------
# Event-driven async handler continuation runtime (increment 1).
# Single-threaded: the pump runs on the render thread inside cheng_app_tick.
# Real awaitable: tick-deadline delay (setTimeout-equivalent), polled each pump.
# No stub / no fake-async / no heuristic.
# ---------------------------------------------------------------------------

type AsyncFrame =
    active: bool
    kind: int32
    seg: int32
    deadlineTick: int32

var __asyncFrames: AsyncFrame[8]
var __asyncTickNow: int32

# state slot driven by the modeled async handler:
#   async () => { setStatus("sending"); await delay(2); setStatus("sent") }
var __statusSlot: str

fn setStatus(value: str) =
    __statusSlot = value

# B. tick-delay primitive (the real awaitable)
fn __asyncDelayRegister(frameIdx: int32, ticks: int32) =
    __asyncFrames[frameIdx].deadlineTick = __asyncTickNow + ticks
    __asyncFrames[frameIdx].active = true

# completion predicate: deadline reached
fn __asyncFrameReady(frameIdx: int32): bool =
    return __asyncTickNow >= __asyncFrames[frameIdx].deadlineTick

# allocate a free frame slot, returns index or -1 if pool exhausted
fn __asyncFrameAlloc(): int32 =
    var i: int32
    i = 0
    while i < 8:
        if !__asyncFrames[i].active:
            return i
        i = i + 1
    return -1

fn __asyncAnyActive(): bool =
    var i: int32
    i = 0
    while i < 8:
        if __asyncFrames[i].active:
            return true
        i = i + 1
    return false

# kind 1 = the modeled status handler.
# C. await-split: seg0 = code before await, seg1 = code after await.

# seg0: run pre-await effects, register the delay, SUSPEND (return).
fn __asyncStatusHandlerSeg0() =
    setStatus("sending")
    let f = __asyncFrameAlloc()
    if f < 0:
        return
    __asyncFrames[f].kind = 1
    __asyncFrames[f].seg = 1
    __asyncDelayRegister(f, 2)

# seg1: code after the await.
fn __asyncStatusHandlerSeg1() =
    setStatus("sent")

# resume dispatch: switch on kind+seg
fn __asyncResume(frameIdx: int32) =
    let k = __asyncFrames[frameIdx].kind
    let s = __asyncFrames[frameIdx].seg
    if k == 1:
        if s == 1:
            __asyncStatusHandlerSeg1()

# D. pump: advance tick, resume any frame whose predicate is true.
fn __asyncPump() =
    __asyncTickNow = __asyncTickNow + 1
    var i: int32
    i = 0
    while i < 8:
        if __asyncFrames[i].active:
            if __asyncFrameReady(i):
                __asyncFrames[i].active = false
                __asyncResume(i)
        i = i + 1

fn dumpState(label: str) =
    var activeTxt: str
    activeTxt = "no"
    if __asyncAnyActive():
        activeTxt = "yes"
    echo(strutil.Join([label, " status=", __statusSlot, " anyActive=", activeTxt, " tick=", strings.IntToStr(__asyncTickNow)], ""))

fn main(): int32 =
    __asyncTickNow = 0
    __statusSlot = "idle"

    # E. dispatch: a compiled ASYNC handler runs seg0 only and returns.
    __asyncStatusHandlerSeg0()
    dumpState("after-dispatch:")
    if __statusSlot != "sending":
        echo("FAIL: expected status=sending after dispatch")
        return 1
    if !__asyncAnyActive():
        echo("FAIL: expected an active frame after dispatch")
        return 1

    __asyncPump()
    dumpState("after-pump1: ")
    if __statusSlot != "sending":
        echo("FAIL: resumed too early at pump1")
        return 1
    if !__asyncAnyActive():
        echo("FAIL: frame cleared too early at pump1")
        return 1

    __asyncPump()
    dumpState("after-pump2: ")
    if __statusSlot != "sent":
        echo("FAIL: expected status=sent after 2 pumps")
        return 1
    if __asyncAnyActive():
        echo("FAIL: expected no active frame after resume")
        return 1

    echo("PASS: suspend->resume across pumped ticks verified")
    return 0
