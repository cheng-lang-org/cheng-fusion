type
    R6OwBundle =
        cacheMode: str
        count: int32

fn R6OwMode(tag: str): str =
    return Fmt"mode-{tag}"

fn R6OwFill(out: var R6OwBundle) =
    out = R6OwBundle()
    out.cacheMode = R6OwMode("first")
    out.count = 1
    out.cacheMode = R6OwMode("second")
    out.count = 2

fn main(): int32 =
    var bundle: R6OwBundle
    R6OwFill(bundle)
    if bundle.cacheMode != "mode-second":
        return 10
    if bundle.count != 2:
        return 11
    echo(Fmt"r6_callfield_overwrite ok mode={bundle.cacheMode} count={bundle.count}")
    return 0
