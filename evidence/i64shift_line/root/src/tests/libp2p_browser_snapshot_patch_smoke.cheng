# 增量图补丁回归：session refresh（等值跳过/全量回退）后，ops/widgets 必须与
# 全新 BrowserCompileSnapshot 逐字段等价（跳过只是优化，正确性=与全量编译
# 不可区分）。覆盖：盒区相同零成本跳过、值变化全量、中部插入、中部删除、
# 尾部追加、整页重写、CLB2 版本变化、重复刷新稳定性。
# 注：比较用内联字段读取，不用 @borrows 记录形参（该形状疑似编译器在途缺陷，
# 会触发 cheng_orc_release_failure——已如实挂账编译器域）。
import std/strings
import cheng/core/runtime/web_runtime as web
import cheng/core/runtime/web_paint_runtime as paint
import cheng/apps/libp2p_browser/compile_render as compile
import cheng/apps/libp2p_browser/page_snapshot as snap
import cheng/apps/libp2p_browser/session as sess

# 5 盒 CLB3：div 盒、输入(value 可变)、链接、select、粗体文本盒。
# 每盒 1 数字行 + 9 编码行。
fn SnapClbA(): str =
    return "CLB3\n400 600 5 7\n0 0 0 400 600 -1 -16777216 0 0 0 0 400 0 0 0 0 0 0 0 400 600\ndiv\n\n\n\n\n\n\n\n\n2 10 20 80 18 -1 -16777216 14 1 -16777216 2 400 0 0 0 0 0 0 0 400 600\ninput\n\n text \nq\ntyped \n\n\n\n\n1 10 50 60 16 -1 -13421670 14 0 0 0 400 0 0 0 0 0 0 0 400 600\na\nhttps://ex.test/x\n\n\n\nlink text\n\n\n\n6 10 80 200 32 -1 -16777216 14 1 -16777216 2 400 0 0 0 0 0 0 0 400 600\nselect\n\nselect\nview\n\n\n\n\n0\ta\tAlpha%0A0\tb\tBeta\n3 10 120 200 16 -1 -16777216 16 0 0 0 700 0 4 8 0 -16777216 0 0 400 600\n#text\n\n\n\n\nbody text\nsans-serif\n\n\n"

# A2：仅输入值变化（打字）
fn SnapClbA2(): str =
    return "CLB3\n400 600 5 8\n0 0 0 400 600 -1 -16777216 0 0 0 0 400 0 0 0 0 0 0 0 400 600\ndiv\n\n\n\n\n\n\n\n\n2 10 20 80 18 -1 -16777216 14 1 -16777216 2 400 0 0 0 0 0 0 0 400 600\ninput\n\n text \nq\ntyped value\n\n\n\n\n1 10 50 60 16 -1 -13421670 14 0 0 0 400 0 0 0 0 0 0 0 400 600\na\nhttps://ex.test/x\n\n\n\nlink text\n\n\n\n6 10 80 200 32 -1 -16777216 14 1 -16777216 2 400 0 0 0 0 0 0 0 400 600\nselect\n\nselect\nview\n\n\n\n\n0\ta\tAlpha%0A0\tb\tBeta\n3 10 120 200 16 -1 -16777216 16 0 0 0 700 0 4 8 0 -16777216 0 0 400 600\n#text\n\n\n\n\nbody text\nsans-serif\n\n\n"

# Insert：链接与 select 之间插入按钮盒（中部插入）
fn SnapClbInsert(): str =
    return "CLB3\n400 600 6 8\n0 0 0 400 600 -1 -16777216 0 0 0 0 400 0 0 0 0 0 0 0 400 600\ndiv\n\n\n\n\n\n\n\n\n2 10 20 80 18 -1 -16777216 14 1 -16777216 2 400 0 0 0 0 0 0 0 400 600\ninput\n\n text \nq\ntyped value\n\n\n\n\n1 10 50 60 16 -1 -13421670 14 0 0 0 400 0 0 0 0 0 0 0 400 600\na\nhttps://ex.test/x\n\n\n\nlink text\n\n\n\n4 10 66 90 24 -1 -16777216 14 0 0 2 400 0 0 0 0 0 0 0 400 600\nbutton\n\nsubmit\n\n\nOK\n\n\n\n6 10 80 200 32 -1 -16777216 14 1 -16777216 2 400 0 0 0 0 0 0 0 400 600\nselect\n\nselect\nview\n\n\n\n\n0\ta\tAlpha%0A0\tb\tBeta\n3 10 120 200 16 -1 -16777216 16 0 0 0 700 0 4 8 0 -16777216 0 0 400 600\n#text\n\n\n\n\nbody text\nsans-serif\n\n\n"

# Deleted：删除链接盒（5→4）
fn SnapClbDeleted(): str =
    return "CLB3\n400 600 4 8\n0 0 0 400 600 -1 -16777216 0 0 0 0 400 0 0 0 0 0 0 0 400 600\ndiv\n\n\n\n\n\n\n\n\n2 10 20 80 18 -1 -16777216 14 1 -16777216 2 400 0 0 0 0 0 0 0 400 600\ninput\n\n text \nq\ntyped value\n\n\n\n\n6 10 80 200 32 -1 -16777216 14 1 -16777216 2 400 0 0 0 0 0 0 0 400 600\nselect\n\nselect\nview\n\n\n\n\n0\ta\tAlpha%0A0\tb\tBeta\n3 10 120 200 16 -1 -16777216 16 0 0 0 700 0 4 8 0 -16777216 0 0 400 600\n#text\n\n\n\n\nbody text\nsans-serif\n\n\n"

# Tail：A2 + 尾部追加按钮盒
fn SnapClbTail(): str =
    return "CLB3\n400 600 6 8\n0 0 0 400 600 -1 -16777216 0 0 0 0 400 0 0 0 0 0 0 0 400 600\ndiv\n\n\n\n\n\n\n\n\n2 10 20 80 18 -1 -16777216 14 1 -16777216 2 400 0 0 0 0 0 0 0 400 600\ninput\n\n text \nq\ntyped value\n\n\n\n\n1 10 50 60 16 -1 -13421670 14 0 0 0 400 0 0 0 0 0 0 0 400 600\na\nhttps://ex.test/x\n\n\n\nlink text\n\n\n\n6 10 80 200 32 -1 -16777216 14 1 -16777216 2 400 0 0 0 0 0 0 0 400 600\nselect\n\nselect\nview\n\n\n\n\n0\ta\tAlpha%0A0\tb\tBeta\n3 10 120 200 16 -1 -16777216 16 0 0 0 700 0 4 8 0 -16777216 0 0 400 600\n#text\n\n\n\n\nbody text\nsans-serif\n\n\n4 10 160 90 24 -1 -16777216 14 0 0 2 400 0 0 0 0 0 0 0 400 600\nbutton\n\nsubmit\n\n\ntail\n\n\n\n"

# Rewrite：整页重写（盒序全变）
fn SnapClbRewrite(): str =
    return "CLB3\n400 600 3 9\n2 0 0 200 300 -1 -1 14 0 0 0 400 0 0 0 0 0 0 0 400 600\ninput\n\n text \na\nzzz\n\n\n\n\n1 10 310 200 20 -1 -1 14 0 0 0 400 0 0 0 0 0 0 0 400 600\na\nhttps://ex.test/y\n\n\n\nrewritten\n\n\n\n3 10 340 200 20 -1 -1 14 0 0 0 400 0 0 0 0 0 0 0 400 600\n#text\n\n\n\n\nmore\n\n\n\n"

# CLB2 旧版本
fn SnapClb2(): str =
    return "CLB2\n400 600 1 3\n0 0 0 400 600 -1 -16777216 0 0 0 0\ndiv\n\n\n\n\n\n"

fn CompareSessionAgainstFresh(session: var sess.BrowserSession, snapshotText: str): int32 =
    var refDoc: web.WebDocument
    var refBundle: compile.BrowserCompileBundle
    if !snap.BrowserCompileSnapshot(snapshotText, refDoc, refBundle):
        return 900
    if session.opCount != refBundle.ops.len:
        return 901
    if session.ops.len != refBundle.ops.len:
        return 902
    var i: int32 = 0
    while i < refBundle.ops.len:
        # 内联字段比较：避免 @borrows 记录形参（该形状疑似编译器在途缺陷）
        if session.ops[i].kind != refBundle.ops[i].kind:
            return 903
        if session.ops[i].rect.x != refBundle.ops[i].rect.x:
            return 903
        if session.ops[i].rect.y != refBundle.ops[i].rect.y:
            return 903
        if session.ops[i].rect.width != refBundle.ops[i].rect.width:
            return 903
        if session.ops[i].rect.height != refBundle.ops[i].rect.height:
            return 903
        if session.ops[i].color != refBundle.ops[i].color:
            return 903
        if session.ops[i].borderRadius != refBundle.ops[i].borderRadius:
            return 903
        if session.ops[i].text.text != refBundle.ops[i].text.text:
            return 903
        if session.ops[i].text.fontWeight != refBundle.ops[i].text.fontWeight:
            return 903
        if session.ops[i].shadowText != refBundle.ops[i].shadowText:
            return 903
        i = i + 1
    if session.widgets.len != refBundle.widgets.len:
        return 904
    i = 0
    while i < refBundle.widgets.len:
        if session.widgets[i].kind != refBundle.widgets[i].kind:
            return 905
        if session.widgets[i].fieldId != refBundle.widgets[i].fieldId:
            return 905
        if session.widgets[i].value != refBundle.widgets[i].value:
            return 905
        if session.widgets[i].href != refBundle.widgets[i].href:
            return 905
        if session.widgets[i].options != refBundle.widgets[i].options:
            return 905
        if session.widgets[i].x != refBundle.widgets[i].x:
            return 905
        if session.widgets[i].y != refBundle.widgets[i].y:
            return 905
        if session.widgets[i].w != refBundle.widgets[i].w:
            return 905
        if session.widgets[i].h != refBundle.widgets[i].h:
            return 905
        i = i + 1
    return 0

fn main(): int32 =
    var session = sess.BrowserSessionInit("patch-peer", 400, 600)
    if !sess.BrowserSessionOnPageSnapshot(session, "https://ex.test/home", SnapClbA()):
        echo(session.lastError)
        return 10
    var rc = CompareSessionAgainstFresh(session, SnapClbA())
    if rc != 0:
        echo(Fmt"baseline rc={rc}")
        return 11
    # 盒区相同：等值跳过（stats 保持有效）
    if !sess.BrowserSessionRefreshSnapshot(session, "https://ex.test/home", SnapClbA()):
        echo(session.lastError)
        return 20
    rc = CompareSessionAgainstFresh(session, SnapClbA())
    if rc != 0:
        echo(Fmt"identical rc={rc}")
        return 21
    # 值变化（打字）：走全量
    if !sess.BrowserSessionRefreshSnapshot(session, "https://ex.test/home", SnapClbA2()):
        echo(session.lastError)
        return 22
    rc = CompareSessionAgainstFresh(session, SnapClbA2())
    if rc != 0:
        echo(Fmt"value rc={rc}")
        return 23
    # 中部插入
    if !sess.BrowserSessionRefreshSnapshot(session, "https://ex.test/home", SnapClbInsert()):
        echo(session.lastError)
        return 30
    rc = CompareSessionAgainstFresh(session, SnapClbInsert())
    if rc != 0:
        echo(Fmt"insert rc={rc}")
        return 31
    # 中部删除
    if !sess.BrowserSessionRefreshSnapshot(session, "https://ex.test/home", SnapClbDeleted()):
        echo(session.lastError)
        return 32
    rc = CompareSessionAgainstFresh(session, SnapClbDeleted())
    if rc != 0:
        echo(Fmt"delete rc={rc}")
        return 33
    # 尾部追加
    if !sess.BrowserSessionRefreshSnapshot(session, "https://ex.test/home", SnapClbTail()):
        echo(session.lastError)
        return 34
    rc = CompareSessionAgainstFresh(session, SnapClbTail())
    if rc != 0:
        echo(Fmt"tail rc={rc}")
        return 35
    # 整页重写
    if !sess.BrowserSessionRefreshSnapshot(session, "https://ex.test/home", SnapClbRewrite()):
        echo(session.lastError)
        return 36
    rc = CompareSessionAgainstFresh(session, SnapClbRewrite())
    if rc != 0:
        echo(Fmt"rewrite rc={rc}")
        return 37
    # CLB2 版本变化
    if !sess.BrowserSessionRefreshSnapshot(session, "https://ex.test/home", SnapClb2()):
        echo(session.lastError)
        return 38
    # 回到 CLB3 大页再跳过一次（跨版本后等值跳过仍正确）
    if !sess.BrowserSessionOnPageSnapshot(session, "https://ex.test/home", SnapClbA()):
        echo(session.lastError)
        return 39
    if !sess.BrowserSessionRefreshSnapshot(session, "https://ex.test/home", SnapClbA()):
        echo(session.lastError)
        return 40
    rc = CompareSessionAgainstFresh(session, SnapClbA())
    if rc != 0:
        echo(Fmt"final rc={rc}")
        return 41
    echo("PATCH-SMOKE-OK")
    return 0
