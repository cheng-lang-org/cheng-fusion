import std/os
import std/strutils as strutil
import cheng/std/bytes_layout as layout
import cheng/core/backend/system_link_plan as slplan
import cheng/core/tooling/compiler_request as creq
import cheng/core/tooling/compiler_world as cworld
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/lang/typed_expr_type_arena as typearena

fn FfiHandleSource(): str =
    return """
@ffi_handle(unwind=no_unwind, arg1=consume, result=produce, arg0=borrow)
@importc("ffi_multi")
fn Multi(left: uint64, right: uint64): uint64

@ffi_handle(unwind=no_unwind, arg0=borrow)
@importc("ffi_observe")
fn Observe(handle: uint64): uint32

@ffi_handle(unwind=no_unwind, result=produce)
@importc("ffi_produce32")
fn Produce32(): uint32

fn Root(): int32 =
    return 0
"""

fn FfiHandleEffectVariantSource(): str =
    return """
@ffi_handle(unwind=no_unwind, arg1=borrow, result=produce, arg0=borrow)
@importc("ffi_multi")
fn Multi(left: uint64, right: uint64): uint64

@ffi_handle(unwind=no_unwind, arg0=borrow)
@importc("ffi_observe")
fn Observe(handle: uint64): uint32

@ffi_handle(unwind=no_unwind, result=produce)
@importc("ffi_produce32")
fn Produce32(): uint32

fn Root(): int32 =
    return 0
"""

fn FfiHandleNonExternSource(): str =
    return """
@ffi_handle(unwind=no_unwind, arg0=borrow)
fn NotExtern(handle: uint64): uint32 =
    return 0

fn Root(): int32 =
    return 0
"""

fn FfiHandleWrongCarrierSource(): str =
    return """
@ffi_handle(unwind=no_unwind, result=produce)
@importc("ffi_wrong")
fn Wrong(): int32

fn Root(): int32 =
    return 0
"""

fn FfiHandleWritePackage(root: str, source: str) =
    let sourceDir = Fmt"{root}/src"
    os.MkdirAll(sourceDir, 493)
    os.WriteFile(
        Fmt"{root}/cheng-package.toml",
        "package_id = \"pkg://cheng/csg_compiler_ffi_handle_contract\"\n")
    os.WriteFile(Fmt"{sourceDir}/main.cheng", source)

fn FfiHandleTryBuild(root: str,
                     source: str,
                     out: var ccsg.CompilerCsg,
                     err: var str): bool =
    FfiHandleWritePackage(root, source)
    let entryPath = Fmt"{root}/src/main.cheng"
    let baseRequest = creq.CompilerRequestNew(
        root,
        entryPath,
        Fmt"{root}/out.o",
        "arm64-apple-darwin",
        creq.EmitObj,
        "")
    let request = creq.CompilerRequestWithExportRootSymbols(
        baseRequest, ["Root"])
    var plan: slplan.SystemLinkPlanStub
    if !slplan.BuildSystemLinkPlanStub(root, request, plan, err) ||
       !slplan.SystemLinkPlanSourceBundleBindingValidInto(plan, err):
        return false
    var importGraphCid: layout.FixedBytes32
    if !cworld.CompilerWorldPortableImportGraphCidInto(
           plan.packageId,
           plan.importEdges,
           plan.unresolvedImportCount,
           importGraphCid,
           err):
        return false
    var sourceReceipt: ccsg.PortableSourceIdentityReceipt
    if !ccsg.PortableSourceIdentityReceiptMakeInto(
           plan.sourceClosurePaths.len,
           plan.importEdges.len,
           plan.unresolvedImportCount,
           plan.packageId,
           plan.ownerModulePaths[plan.sourceBundleEntrySourceIndex],
           plan.sourceBundleCidValue,
           cworld.CompilerWorldSourceRawBytesCid(source),
           importGraphCid,
           sourceReceipt,
           err):
        return false
    return ccsg.BuildCompilerCsgConsumePortableReceiptInto(
        out, err, plan, sourceReceipt)

fn FfiHandleBuild(root: str,
                  source: str,
                  out: var ccsg.CompilerCsg) =
    var err: str
    assert(FfiHandleTryBuild(root, source, out, err), err)
    assert(ccsg.CompilerCsgExternFfiHandleContractsStrictValidateInto(
               out, err), err)
    assert(ccsg.CompilerCsgParserDeclarationProvenanceStrictValidateInto(
               out, err), err)
    assert(ccsg.CompilerCsgOwnPortableArtifactStrictValidateInto(
               out, err), err)

fn FfiHandleNodeIndex(csg: var ccsg.CompilerCsg,
                      nodeId: int32): int32 =
    for nodeIndex in 0..<csg.nodes.len:
        if csg.nodes[nodeIndex].nodeId == nodeId:
            return nodeIndex
    return -1

fn FfiHandleMaxNodeId(csg: var ccsg.CompilerCsg): int32 =
    var maximum: int32
    for nodeIndex in 0..<csg.nodes.len:
        if csg.nodes[nodeIndex].nodeId > maximum:
            maximum = csg.nodes[nodeIndex].nodeId
    return maximum

fn FfiHandleStrictReject(csg: var ccsg.CompilerCsg, label: str) =
    var err: str
    assert(!ccsg.CompilerCsgExternFfiHandleContractsStrictValidateInto(
                csg, err),
           Fmt"ffi handle CSG accepted tamper: {label}")
    ccsg.CompilerCsgTerminalRelease(csg)

fn FfiHandleProvenanceReject(csg: var ccsg.CompilerCsg, label: str) =
    var err: str
    assert(!ccsg.CompilerCsgParserDeclarationProvenanceStrictValidateInto(
                csg, err),
           Fmt"ffi handle Symbol partition accepted tamper: {label}")
    ccsg.CompilerCsgTerminalRelease(csg)

fn FfiHandlePortableReject(csg: var ccsg.CompilerCsg, label: str) =
    var err: str
    assert(!ccsg.CompilerCsgOwnPortableArtifactStrictValidateInto(csg, err),
           Fmt"ffi handle portable root accepted tamper: {label}")
    ccsg.CompilerCsgTerminalRelease(csg)

fn FfiHandleRejectSource(root: str, source: str, label: str) =
    var rejected: ccsg.CompilerCsg
    var err: str
    assert(!FfiHandleTryBuild(root, source, rejected, err),
           Fmt"ffi handle CSG accepted invalid source: {label}")
    ccsg.CompilerCsgTerminalRelease(rejected)

fn main() =
    let root = "/tmp/csg_compiler_ffi_handle_contract_smoke"
    var first: ccsg.CompilerCsg
    var repeated: ccsg.CompilerCsg
    FfiHandleBuild(root, FfiHandleSource(), first)
    FfiHandleBuild(root, FfiHandleSource(), repeated)

    let table = first.externFfiHandleContracts
    assert(table.complete &&
           table.producerSourceIds.len == 3 &&
           table.functionSymbolIds.len == 3 &&
           table.contractGraphNodeIds.len == 3 &&
           table.unwindKinds.len == 3 &&
           table.effectKinds.len == 5 &&
           table.effectGraphNodeIds.len == 5,
           "ffi handle CSG table/CSR shape mismatch")
    assert(table.unwindKinds[0] ==
               ccsg.CompilerCsgExternFfiHandleUnwindNoUnwind &&
           table.unwindKinds[1] ==
               ccsg.CompilerCsgExternFfiHandleUnwindNoUnwind &&
           table.unwindKinds[2] ==
               ccsg.CompilerCsgExternFfiHandleUnwindNoUnwind,
           "ffi handle CSG mandatory no_unwind projection mismatch")
    assert(table.effectKinds[0] ==
               ccsg.CompilerCsgEffectExternFfiHandleProduce &&
           table.effectKinds[1] ==
               ccsg.CompilerCsgEffectExternFfiHandleBorrow &&
           table.effectKinds[2] ==
               ccsg.CompilerCsgEffectExternFfiHandleConsume &&
           table.effectKinds[3] ==
               ccsg.CompilerCsgEffectExternFfiHandleBorrow &&
           table.effectKinds[4] ==
               ccsg.CompilerCsgEffectExternFfiHandleProduce,
           "ffi handle CSG produce/borrow/consume order mismatch")
    let uint32TypeId =
        typearena.TypedExprTypeArenaReservedScalarTypeId(
            first.typeArena,
            typearena.TypedExprStructuralScalarUInt32)
    let uint64TypeId =
        typearena.TypedExprTypeArenaReservedScalarTypeId(
            first.typeArena,
            typearena.TypedExprStructuralScalarUInt64)
    assert(table.effectTypeIds[0] == uint64TypeId &&
           table.effectTypeIds[1] == uint64TypeId &&
           table.effectTypeIds[2] == uint64TypeId &&
           table.effectTypeIds[3] == uint64TypeId &&
           table.effectTypeIds[4] == uint32TypeId &&
           uint32TypeId != uint64TypeId,
           "ffi handle CSG exact scalar TypeId binding mismatch")
    assert(table.effectParameterSymbolIds[0] == -1 &&
           table.effectParameterSymbolIds[1] > 0 &&
           table.effectParameterSymbolIds[2] > 0 &&
           table.effectParameterSymbolIds[3] > 0 &&
           table.effectParameterSymbolIds[4] == -1 &&
           table.effectParameterSymbolIds[1] !=
               table.effectParameterSymbolIds[2] &&
           table.effectParameterSymbolIds[1] !=
               table.effectParameterSymbolIds[3] &&
           table.effectParameterSymbolIds[2] !=
               table.effectParameterSymbolIds[3],
           "ffi handle CSG parameter SymbolId binding collapsed")

    var symbolCount: int32
    for nodeIndex in 0..<first.nodes.len:
        if first.nodes[nodeIndex].nodeKind ==
               ccsg.CompilerCsgNodeKindSymbol:
            symbolCount = symbolCount + 1
    assert(symbolCount ==
               first.semanticGraph.reachableFunctionTable.graphNodeIds.len +
               table.functionSymbolIds.len,
           "ffi handle ordinary/extern Symbol partition is not exhaustive")
    for contractRow in 0..<table.functionSymbolIds.len:
        let functionNodeIndex =
            FfiHandleNodeIndex(first, table.functionSymbolIds[contractRow])
        assert(functionNodeIndex >= 0 &&
               first.nodes[functionNodeIndex].nodeKind ==
                   ccsg.CompilerCsgNodeKindSymbol,
               "ffi handle extern function is not a real Symbol node")
        for ordinaryRow in 0..<
                first.semanticGraph.reachableFunctionTable.graphNodeIds.len:
            assert(table.functionSymbolIds[contractRow] !=
                       first.semanticGraph.reachableFunctionTable.graphNodeIds[
                           ordinaryRow],
                   "ffi handle ordinary/extern Symbol authority overlaps")

    let firstCanonicalReport =
        ccsg.CompilerCsgCanonicalSidecarReport(first)
    let repeatedCanonicalReport =
        ccsg.CompilerCsgCanonicalSidecarReport(repeated)
    assert(firstCanonicalReport == repeatedCanonicalReport &&
           layout.FixedBytes32Equal(first.canonicalGraphCid,
                                    repeated.canonicalGraphCid) &&
           layout.FixedBytes32Equal(first.graphCid,
                                    repeated.graphCid) &&
           layout.FixedBytes32Equal(
               first.externFfiHandleContracts.cargoCid,
               repeated.externFfiHandleContracts.cargoCid),
           "ffi handle repeated build canonical report/root/cargo drift")
    let report = ccsg.CompilerCsgReport(first)
    assert(strutil.Contains(report,
                            "extern_ffi_handle_contract_count=3") &&
           strutil.Contains(report,
                            "extern_ffi_handle_no_unwind_contract_count=3") &&
           strutil.Contains(report,
                            "extern_ffi_handle_effect_count=5") &&
           strutil.Contains(report,
                            "extern_ffi_handle_cargo_cid="),
           "ffi handle CSG report receipt missing")

    var effectVariant: ccsg.CompilerCsg
    FfiHandleBuild(root, FfiHandleEffectVariantSource(), effectVariant)
    assert(!layout.FixedBytes32Equal(
               first.externFfiHandleContracts.cargoCid,
               effectVariant.externFfiHandleContracts.cargoCid) &&
           !layout.FixedBytes32Equal(first.canonicalGraphCid,
                                     effectVariant.canonicalGraphCid) &&
           !layout.FixedBytes32Equal(first.graphCid,
                                     effectVariant.graphCid),
           "ffi handle effect change did not bind cargo/snapshot/root")

    var wrongFunctionRow = ccsg.CompilerCsgDeepCloneDiagnostic(first)
    wrongFunctionRow.externFfiHandleContracts.functionDeclarationSourceLocalRows[0] =
        wrongFunctionRow.externFfiHandleContracts.functionDeclarationSourceLocalRows[0] + 1
    FfiHandleStrictReject(wrongFunctionRow, "function_declaration_row")

    var wrongUnwind = ccsg.CompilerCsgDeepCloneDiagnostic(first)
    wrongUnwind.externFfiHandleContracts.unwindKinds[0] = 0
    var wrongUnwindErr: str
    assert(!ccsg.CompilerCsgExternFfiHandleContractsStrictValidateInto(
                wrongUnwind, wrongUnwindErr),
           "ffi handle CSG accepted tamper: unwind_kind")
    ccsg.CompilerCsgTerminalRelease(wrongUnwind)

    var wrongEffectKind = ccsg.CompilerCsgDeepCloneDiagnostic(first)
    wrongEffectKind.externFfiHandleContracts.effectKinds[0] =
        ccsg.CompilerCsgEffectExternFfiHandleBorrow
    FfiHandleStrictReject(wrongEffectKind, "effect_kind")

    var wrongTypeId = ccsg.CompilerCsgDeepCloneDiagnostic(first)
    wrongTypeId.externFfiHandleContracts.effectTypeIds[0] = -1
    FfiHandleStrictReject(wrongTypeId, "exact_type_id")

    var wrongEffectCid = ccsg.CompilerCsgDeepCloneDiagnostic(first)
    wrongEffectCid.externFfiHandleContracts.effectCids[0].data[0] =
        uint8(Int32(
            wrongEffectCid.externFfiHandleContracts.effectCids[0].data[0]) ^ 1)
    FfiHandleStrictReject(wrongEffectCid, "effect_cid")

    var wrongContractCid = ccsg.CompilerCsgDeepCloneDiagnostic(first)
    wrongContractCid.externFfiHandleContracts.contractCids[0].data[0] =
        uint8(Int32(
            wrongContractCid.externFfiHandleContracts.contractCids[0].data[0]) ^ 1)
    FfiHandleStrictReject(wrongContractCid, "contract_cid")

    var wrongParserCid = ccsg.CompilerCsgDeepCloneDiagnostic(first)
    wrongParserCid.externFfiHandleContracts.parserContractCids[0].data[0] =
        uint8(Int32(
            wrongParserCid.externFfiHandleContracts.parserContractCids[0].data[0]) ^ 1)
    FfiHandleStrictReject(wrongParserCid, "parser_contract_cid")

    var wrongCargoCid = ccsg.CompilerCsgDeepCloneDiagnostic(first)
    wrongCargoCid.externFfiHandleContracts.cargoCid.data[0] =
        uint8(Int32(
            wrongCargoCid.externFfiHandleContracts.cargoCid.data[0]) ^ 1)
    FfiHandleStrictReject(wrongCargoCid, "cargo_cid")

    var wrongFunctionSymbol = ccsg.CompilerCsgDeepCloneDiagnostic(first)
    wrongFunctionSymbol.externFfiHandleContracts.functionSymbolIds[0] =
        wrongFunctionSymbol.externFfiHandleContracts.contractGraphNodeIds[0]
    FfiHandleStrictReject(wrongFunctionSymbol, "function_symbol_id")

    var wrongParameterSymbol = ccsg.CompilerCsgDeepCloneDiagnostic(first)
    wrongParameterSymbol.externFfiHandleContracts.effectParameterSymbolIds[1] =
        wrongParameterSymbol.externFfiHandleContracts.effectGraphNodeIds[1]
    FfiHandleStrictReject(wrongParameterSymbol, "parameter_symbol_id")

    var wrongGraphEffect = ccsg.CompilerCsgDeepCloneDiagnostic(first)
    let wrongGraphEffectNodeIndex = FfiHandleNodeIndex(
        wrongGraphEffect,
        wrongGraphEffect.externFfiHandleContracts.effectGraphNodeIds[0])
    assert(wrongGraphEffectNodeIndex >= 0,
           "ffi handle graph effect fixture missing")
    wrongGraphEffect.nodes[wrongGraphEffectNodeIndex].semanticParamTypeJoin =
        "tampered-type-cid"
    FfiHandleStrictReject(wrongGraphEffect, "normalized_graph_effect")

    var extraSymbol = ccsg.CompilerCsgDeepCloneDiagnostic(first)
    var forgedSymbol: ccsg.CompilerCsgNode
    forgedSymbol.nodeId = FfiHandleMaxNodeId(extraSymbol) + 1
    forgedSymbol.nodeKind = ccsg.CompilerCsgNodeKindSymbol
    add(extraSymbol.nodes, forgedSymbol)
    FfiHandleProvenanceReject(extraSymbol, "extra_symbol")

    var duplicatedExtern = ccsg.CompilerCsgDeepCloneDiagnostic(first)
    duplicatedExtern.externFfiHandleContracts.functionSymbolIds[1] =
        duplicatedExtern.externFfiHandleContracts.functionSymbolIds[0]
    FfiHandleProvenanceReject(duplicatedExtern, "duplicate_extern_symbol")

    var externAsOrdinary = ccsg.CompilerCsgDeepCloneDiagnostic(first)
    externAsOrdinary.semanticGraph.reachableFunctionTable.graphNodeIds[0] =
        externAsOrdinary.externFfiHandleContracts.functionSymbolIds[0]
    FfiHandleProvenanceReject(externAsOrdinary, "extern_as_ordinary")

    var ordinaryAsExtern = ccsg.CompilerCsgDeepCloneDiagnostic(first)
    ordinaryAsExtern.externFfiHandleContracts.functionSymbolIds[0] =
        ordinaryAsExtern.semanticGraph.reachableFunctionTable.graphNodeIds[0]
    FfiHandleProvenanceReject(ordinaryAsExtern, "ordinary_as_extern")

    var wrongCanonicalRoot = ccsg.CompilerCsgDeepCloneDiagnostic(first)
    wrongCanonicalRoot.canonicalGraphCid.data[0] =
        uint8(Int32(wrongCanonicalRoot.canonicalGraphCid.data[0]) ^ 1)
    FfiHandlePortableReject(wrongCanonicalRoot, "canonical_graph_cid")

    var wrongSourceBoundRoot = ccsg.CompilerCsgDeepCloneDiagnostic(first)
    wrongSourceBoundRoot.graphCid.data[0] =
        uint8(Int32(wrongSourceBoundRoot.graphCid.data[0]) ^ 1)
    FfiHandlePortableReject(wrongSourceBoundRoot, "graph_cid")

    FfiHandleRejectSource(
        root, FfiHandleNonExternSource(), "non_extern_contract")
    FfiHandleRejectSource(
        root, FfiHandleWrongCarrierSource(), "non_uint32_uint64_carrier")

    ccsg.CompilerCsgTerminalRelease(effectVariant)
    ccsg.CompilerCsgTerminalRelease(repeated)
    ccsg.CompilerCsgTerminalRelease(first)
    os.WriteLine(os.Get_stdout(),
                 "csg_compiler_ffi_handle_contract_rows=3")
    os.WriteLine(os.Get_stdout(),
                 "csg_compiler_ffi_handle_no_unwind_rows=3")
    os.WriteLine(os.Get_stdout(),
                 "csg_compiler_ffi_handle_effect_rows=5")
    os.WriteLine(os.Get_stdout(),
                 "csg_compiler_ffi_handle_dynamic_rejections=19")
    os.WriteLine(os.Get_stdout(),
                 "csg_compiler_ffi_handle_contract_smoke: ok")

main()
