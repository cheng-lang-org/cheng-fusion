module scan_test

import cheng/apps/vpn_proxy/vpn_proxy_tun_policy as policy

fn main(): int32 =
    if !policy.VpnProxyTunShouldFakeDomain("www.youtube.com"):
        return 1
    if !policy.VpnProxyTunShouldFakeDomain("www.google.com"):
        return 2
    if !policy.VpnProxyTunShouldFakeDomain("x.com"):
        return 3
    if !policy.VpnProxyTunShouldFakeDomain("zh.wikipedia.org"):
        return 4
    if policy.VpnProxyTunShouldFakeDomain("www.baidu.com"):
        return 5
    return 0

main()