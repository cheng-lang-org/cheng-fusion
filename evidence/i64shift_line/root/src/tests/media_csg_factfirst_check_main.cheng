# S1 verification for the fact-first publish seal (CFFM v1) — added
# src/core/runtime/web_scene_media_factfirst.cheng (docs/cheng-csg-video-facts-bytes-plan.md §S1).
#
# PURE, in-memory, no file IO, no network, no fixtures: the self-hosted backend's
# `system-link-exec --emit:exe` still lacks the os.ReadFile call chain (see
# moqidx_oracle_dump_main.cheng header for that measured gap), so this check drives the
# REAL moqidx->CFFM seal/verify/lookup logic over synthetic `.moqidx` byte images built
# in-program with the exact on-disk format (36B MQES header + 12B/frame entries).
# The synthetic shapes are ANCHORED to the real fixtures independently: the runner
# (run_media_csg_factfirst_check.sh) re-derives the keyframe tables of the actual
# maitian.moqidx / hgs_stream.moqidx via python3 struct.unpack and asserts they equal
# the same keyframe strides asserted here — a wrong parser cannot produce a false green
# against both sides at once.
#
# Asserts, in order (fixture A = maitian shape, fixture B = hgs shape):
#   1. Seal rejects: bad magic; frame[0] not keyframe.
#   2. A: Verify==0; header facts round-trip (width/height/fps/frameCount/esTotal);
#      keyframe table == [0,60,120,180,240,300]; keyframe offsets == independent
#      prefix-sum accumulation; SnapToKeyframe backward/clamp semantics;
#      GOP byte lens incl. last-GOP==esTotal-tail; FirstGopByteLen==GopByteLen(0);
#      ManifestLen(keyframeCount)==actual wire length.
#   3. Determinism: seal(seal(A)) is byte-identical (same input, same manifest bytes).
#   4. Tamper negatives: flipping a non-key frame's flags bit re-seals to 7 keyframes
#      with a different manifest; flipping one manifest table byte -> Verify==4 (CID).
#   5. B: Verify==0; keyframe table == [0,120,240,360,480,600]; SnapTo(674)==600 clamp.
# Success prints "ALL OK" and exits 0; every failure prints a reason and exits nonzero.

import std/os
import std/rawbytes
import std/result
import std/strutils as strutil
import cheng/core/runtime/web_scene_media_factfirst as ff

fn fail(msg: str): int32 =
    os.WriteLine(os.Get_stdout(), strutil.Join(["FAIL: ", msg], ""))
    return 1

# Build a synthetic `.moqidx` byte image: format=2, frameCount frames, keyframe every
# kfStride (frame 0 included), size_i = sizeBase + (i*37 % 500), contiguous offsets.
fn buildIdx(width: int32, height: int32, fpsNum: int32, fpsDen: int32,
            frameCount: int32, rotation: int32, kfStride: int32, sizeBase: int32): rawbytes.Bytes =
    var idx: rawbytes.Bytes = rawbytes.BytesAlloc(36 + frameCount * 12)
    rawbytes.BytesSet(idx, 0, 77)   # "M"
    rawbytes.BytesSet(idx, 1, 81)   # "Q"
    rawbytes.BytesSet(idx, 2, 69)   # "E"
    rawbytes.BytesSet(idx, 3, 83)   # "S"
    var off: int32 = 0
    var acc: int32 = 0
    # little-endian header fields via the module-independent local writer
    var shift: int32 = 0
    var v: int32 = 2
    while shift < 4:
        rawbytes.BytesSet(idx, 4 + shift, v & 255)
        v = v >> 8
        shift = shift + 1
    v = width
    shift = 0
    while shift < 4:
        rawbytes.BytesSet(idx, 8 + shift, v & 255)
        v = v >> 8
        shift = shift + 1
    v = height
    shift = 0
    while shift < 4:
        rawbytes.BytesSet(idx, 12 + shift, v & 255)
        v = v >> 8
        shift = shift + 1
    v = fpsNum
    shift = 0
    while shift < 4:
        rawbytes.BytesSet(idx, 16 + shift, v & 255)
        v = v >> 8
        shift = shift + 1
    v = fpsDen
    shift = 0
    while shift < 4:
        rawbytes.BytesSet(idx, 20 + shift, v & 255)
        v = v >> 8
        shift = shift + 1
    v = frameCount
    shift = 0
    while shift < 4:
        rawbytes.BytesSet(idx, 24 + shift, v & 255)
        v = v >> 8
        shift = shift + 1

    var i: int32 = 0
    while i < frameCount:
        let size: int32 = sizeBase + (i * 37 % 500)
        # offset u32 at entry+0
        v = off
        shift = 0
        while shift < 4:
            rawbytes.BytesSet(idx, 36 + i * 12 + shift, v & 255)
            v = v >> 8
            shift = shift + 1
        # size u32 at entry+4
        v = size
        shift = 0
        while shift < 4:
            rawbytes.BytesSet(idx, 40 + i * 12 + shift, v & 255)
            v = v >> 8
            shift = shift + 1
        # flags u32 at entry+8: bit0 = keyframe
        var flags: int32 = 0
        if (i % kfStride) == 0:
            flags = 1
        v = flags
        shift = 0
        while shift < 4:
            rawbytes.BytesSet(idx, 44 + i * 12 + shift, v & 255)
            v = v >> 8
            shift = shift + 1
        off = off + size
        acc = acc + 1
        i = i + 1
    # esTotalBytes u32 at header+28 = sum of all sizes
    v = off
    shift = 0
    while shift < 4:
        rawbytes.BytesSet(idx, 28 + shift, v & 255)
        v = v >> 8
        shift = shift + 1
    # rotation i32 at header+32
    v = rotation
    shift = 0
    while shift < 4:
        rawbytes.BytesSet(idx, 32 + shift, v & 255)
        v = v >> 8
        shift = shift + 1
    return idx

fn sealOrDie(idx: rawbytes.Bytes, label: str): rawbytes.Bytes =
    var res: Result[rawbytes.Bytes] = ff.WebSceneMediaFactFirstSeal(idx)
    if IsErr(res):
        var dead: rawbytes.Bytes = rawbytes.BytesAlloc(1)
        os.WriteLine(os.Get_stdout(), strutil.Join(["seal failed: ", label], ""))
        return dead
    return Value(res)

fn main(): int32 =
    # --- 1. seal rejects malformed indexes -----------------------------------
    var badMagic: rawbytes.Bytes = buildIdx(1280, 720, 60, 1, 120, 0, 60, 1000)
    rawbytes.BytesSet(badMagic, 1, 88)  # "MQES" -> "MXES"
    var badRes: Result[rawbytes.Bytes] = ff.WebSceneMediaFactFirstSeal(badMagic)
    if !IsErr(badRes):
        return fail("seal accepted a bad-magic index")
    var noKf: rawbytes.Bytes = buildIdx(1280, 720, 60, 1, 120, 0, 60, 1000)
    rawbytes.BytesSet(noKf, 44, 0)  # frame[0] flags bit0 -> 0 (not a keyframe)
    var noKfRes: Result[rawbytes.Bytes] = ff.WebSceneMediaFactFirstSeal(noKf)
    if !IsErr(noKfRes):
        return fail("seal accepted an index whose frame[0] is not a keyframe")
    os.WriteLine(os.Get_stdout(), "step1_seal_rejects_ok")

    # --- 2. fixture A (maitian shape): full fact surface ----------------------
    var idxA: rawbytes.Bytes = buildIdx(1280, 720, 60, 1, 333, -90, 60, 1000)
    var manA: rawbytes.Bytes = sealOrDie(idxA, "A")
    if ff.WebSceneMediaFactFirstVerify(manA) != 0:
        return fail("A manifest fails its own CID verification")
    if ff.WebSceneMediaFactFirstWidth(manA) != 1280 || ff.WebSceneMediaFactFirstHeight(manA) != 720:
        return fail("A width/height round-trip mismatch")
    if ff.WebSceneMediaFactFirstFpsNum(manA) != 60 || ff.WebSceneMediaFactFirstFpsDen(manA) != 1:
        return fail("A fps round-trip mismatch")
    if ff.WebSceneMediaFactFirstFrameCount(manA) != 333:
        return fail("A frameCount round-trip mismatch")

    # Independent ground truth: accumulate sizes with the constructor's formula in a
    # fresh loop, and compare keyframe offsets/total against the manifest facts.
    var expectedTotal: int32 = 0
    var expectedKfOffset: int32[6]
    var kfSeen: int32 = 0
    var i: int32 = 0
    while i < 333:
        if (i % 60) == 0:
            expectedKfOffset[kfSeen] = expectedTotal
            kfSeen = kfSeen + 1
        expectedTotal = expectedTotal + 1000 + (i * 37 % 500)
        i = i + 1
    if ff.WebSceneMediaFactFirstEsTotalBytes(manA) != expectedTotal:
        return fail("A esTotalBytes mismatch vs independent accumulation")
    if ff.WebSceneMediaFactFirstKeyframeCount(manA) != 6:
        return fail("A keyframeCount != 6")
    var expectedKf: int32[] = [0, 60, 120, 180, 240, 300]
    var k: int32 = 0
    while k < 6:
        if ff.WebSceneMediaFactFirstKeyframeFrame(manA, k) != expectedKf[k]:
            return fail(strutil.Join(["A keyframe[", IntToStr(k), "] frame index mismatch"], ""))
        if ff.WebSceneMediaFactFirstKeyframeOffset(manA, k) != expectedKfOffset[k]:
            return fail(strutil.Join(["A keyframe[", IntToStr(k), "] offset mismatch vs prefix sum"], ""))
        k = k + 1

    # Receiver-side seek purely from facts (backward snap + clamp).
    if ff.WebSceneMediaFactFirstSnapToKeyframe(manA, 0) != 0:
        return fail("A SnapTo(0) != 0")
    if ff.WebSceneMediaFactFirstSnapToKeyframe(manA, 59) != 0:
        return fail("A SnapTo(59) != 0")
    if ff.WebSceneMediaFactFirstSnapToKeyframe(manA, 60) != 60:
        return fail("A SnapTo(60) != 60")
    if ff.WebSceneMediaFactFirstSnapToKeyframe(manA, 299) != 240:
        return fail("A SnapTo(299) != 240")
    if ff.WebSceneMediaFactFirstSnapToKeyframe(manA, 300) != 300:
        return fail("A SnapTo(300) != 300")
    if ff.WebSceneMediaFactFirstSnapToKeyframe(manA, 332) != 300:
        return fail("A SnapTo(332) != 300 (clamp)")

    # GOP byte lens: interior from next keyframe offset, last from esTotal tail.
    var g: int32 = 0
    while g < 6:
        var want: int32 = 0
        if g < 5:
            want = expectedKfOffset[g + 1] - expectedKfOffset[g]
        else:
            want = expectedTotal - expectedKfOffset[g]
        if ff.WebSceneMediaFactFirstGopByteLen(manA, g) != want:
            return fail(strutil.Join(["A gop[", IntToStr(g), "] byte length mismatch"], ""))
        g = g + 1
    if ff.WebSceneMediaFactFirstFirstGopByteLen(manA) != expectedKfOffset[1]:
        return fail("A first-GOP byte budget != keyframe[1].offset")
    if ff.WebSceneMediaFactFirstManifestLen(6) != rawbytes.BytesLen(manA):
        return fail("A manifest wire length != 104 + 12*keyframeCount")
    os.WriteLine(os.Get_stdout(), strutil.Join(["step2_A_facts_ok manifestBytes=", IntToStr(rawbytes.BytesLen(manA)),
                                                " esBytes=", IntToStr(expectedTotal)], ""))

    # --- 3. determinism: same input, byte-identical manifest ------------------
    var manA2: rawbytes.Bytes = sealOrDie(idxA, "A2")
    if rawbytes.BytesLen(manA2) != rawbytes.BytesLen(manA):
        return fail("A re-seal length differs (nondeterministic seal)")
    var b: int32 = 0
    while b < rawbytes.BytesLen(manA):
        if rawbytes.BytesGet(manA2, b) != rawbytes.BytesGet(manA, b):
            return fail("A re-seal byte mismatch (nondeterministic seal)")
        b = b + 1
    os.WriteLine(os.Get_stdout(), "step3_seal_deterministic_ok")

    # --- 4. tamper negatives ---------------------------------------------------
    # 4a. promote a non-key frame to keyframe: re-seal must see 7 keyframes and a
    #     different manifest (frame 10 is not on the stride-60 keyframe grid).
    var idxT: rawbytes.Bytes = buildIdx(1280, 720, 60, 1, 333, -90, 60, 1000)
    rawbytes.BytesSet(idxT, 44 + 10 * 12, 1)
    var manT: rawbytes.Bytes = sealOrDie(idxT, "tampered")
    if ff.WebSceneMediaFactFirstVerify(manT) != 0:
        return fail("tampered-index manifest fails self verification")
    if ff.WebSceneMediaFactFirstKeyframeCount(manT) != 7:
        return fail("tampered-index manifest did not register the promoted keyframe")
    if ff.WebSceneMediaFactFirstSnapToKeyframe(manT, 10) != 10:
        return fail("tampered-index SnapTo(10) did not land on the promoted keyframe")
    # 4b. flip one manifest table byte: CID verification must go red (rc=4).
    var manBad: rawbytes.Bytes = sealOrDie(idxA, "flip")
    rawbytes.BytesSet(manBad, 76, rawbytes.BytesGet(manBad, 76) ^ 255)
    if ff.WebSceneMediaFactFirstVerify(manBad) != 4:
        return fail("flipped manifest byte not caught by CID verification")
    os.WriteLine(os.Get_stdout(), "step4_tamper_negatives_ok")

    # --- 5. fixture B (hgs shape) ----------------------------------------------
    var idxB: rawbytes.Bytes = buildIdx(1080, 1920, 30, 1, 675, 0, 120, 900)
    var manB: rawbytes.Bytes = sealOrDie(idxB, "B")
    if ff.WebSceneMediaFactFirstVerify(manB) != 0:
        return fail("B manifest fails its own CID verification")
    if ff.WebSceneMediaFactFirstKeyframeCount(manB) != 6:
        return fail("B keyframeCount != 6")
    var expectedKfB: int32[] = [0, 120, 240, 360, 480, 600]
    k = 0
    while k < 6:
        if ff.WebSceneMediaFactFirstKeyframeFrame(manB, k) != expectedKfB[k]:
            return fail(strutil.Join(["B keyframe[", IntToStr(k), "] frame index mismatch"], ""))
        k = k + 1
    if ff.WebSceneMediaFactFirstSnapToKeyframe(manB, 674) != 600:
        return fail("B SnapTo(674) != 600 (clamp)")
    if ff.WebSceneMediaFactFirstSnapToKeyframe(manB, 1) != 0:
        return fail("B SnapTo(1) != 0")
    os.WriteLine(os.Get_stdout(), strutil.Join(["step5_B_facts_ok manifestBytes=", IntToStr(rawbytes.BytesLen(manB))], ""))

    os.WriteLine(os.Get_stdout(), "ALL OK")
    return 0
