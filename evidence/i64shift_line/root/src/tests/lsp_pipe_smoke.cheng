# lsp_pipe_smoke.cheng
# LSP stdin/stdout pipe lifecycle smoke test (in-memory).
#
# Tests Content-Length framing and JSON-RPC 2.0 lifecycle:
#   1. Initialize request
#   2. Initialize response (capabilities + serverInfo)
#   3. Initialized notification
#   4. Shutdown request + response
#   5. Exit notification
#   6. Full lifecycle sequence
#   7. Multiple message stream framing
#   8. Error response format
#
# Uses string ops only (no json module). All tests inline in main()
# to avoid a cold compiler ABI bug with return values from functions
# with large string-heavy bodies.

import std/strings
import std/strutils as strutil

fn StrContains(text: str, sub: str): bool =
    return strings.strContains(text, sub)

fn FindIndex(text: str, sub: str): int32 =
    let n: int32 = strings.Len(text)
    let m: int32 = strings.Len(sub)
    if m <= 0 || m > n:
        return -1
    let limit: int32 = n - m
    for i in 0..limit:
        let candidate: str = strings.SliceBytes(text, i, m)
        if candidate == sub:
            return i
    return -1

fn BuildCLHeader(body: str): str =
    return strutil.Join(["Content-Length: ", strings.IntToStr(strings.Len(body)),
                         "\r\n\r\n"], "")

fn ParseI32(s: str): int32 =
    let n: int32 = strings.Len(s)
    if n <= 0: return -1
    var r: int32
    var st: int32
    if s[0] == '-':
        st = 1
    else:
        st = 0
    for i in st..<n:
        let c: char = s[i]
        if c < '0' || c > '9':
            break
        r = r * 10 + int32(c) - 48
    if st == 1:
        r = -r
    return r

fn ExtractCL(header: str): int32 =
    var colonPos: int32 = -1
    let hlen: int32 = strings.Len(header)
    for i in 0..<hlen:
        if header[i] == ':':
            colonPos = i
            break
    if colonPos < 0: return -1
    var vs: int32 = colonPos + 2
    var ve: int32 = vs
    while ve < hlen && header[ve] >= '0' && header[ve] <= '9':
        ve = ve + 1
    if ve <= vs: return -2
    var v: str = strings.SliceBytes(header, vs, ve - vs)
    return ParseI32(v)

fn VerifyFrame(body: str): int32 =
    var h: str = BuildCLHeader(body)
    var framed: str = strutil.Join([h, body], "")
    let sp: int32 = FindIndex(framed, "\r\n\r\n")
    if sp < 0: return 1
    let he: int32 = sp + 4
    var ph: str = strings.SliceBytes(framed, 0, he)
    var pb: str = strings.SliceBytes(framed, he, strings.Len(framed) - he)
    let pl: int32 = ExtractCL(ph)
    if pl < 0 || pl != strings.Len(pb): return 2
    if pb != body: return 3
    return 0

fn main(): int32 =
    # T1: init request
    var t1: str = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"processId\":null,\"rootUri\":null,\"capabilities\":{}}}"
    var v: int32 = VerifyFrame(t1)
    if v != 0: return 100 + v
    if !StrContains(t1, "\"jsonrpc\""): return 110
    if !StrContains(t1, "\"2.0\""): return 111
    if !StrContains(t1, "\"id\""): return 112
    if !StrContains(t1, "\"method\""): return 113
    if !StrContains(t1, "\"initialize\""): return 114
    if !StrContains(t1, "\"params\""): return 115
    if !StrContains(t1, "\"processId\""): return 116
    if !StrContains(t1, "\"rootUri\""): return 117
    if !StrContains(t1, "\"capabilities\""): return 118

    # T2: init response
    var t2: str = "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"capabilities\":{\"textDocumentSync\":1,\"hoverProvider\":true,\"definitionProvider\":true,\"referencesProvider\":true,\"completionProvider\":{\"triggerCharacters\":[\".\"],\"resolveProvider\":false},\"diagnosticProvider\":{\"identifier\":\"cheng\",\"interFileDependencies\":true,\"workspaceDiagnostics\":false}},\"serverInfo\":{\"name\":\"cheng-lsp\",\"version\":\"0.1.0\"}}}"
    var v2: int32 = VerifyFrame(t2)
    if v2 != 0: return 200 + v2
    if !StrContains(t2, "\"jsonrpc\""): return 210
    if !StrContains(t2, "\"2.0\""): return 211
    if !StrContains(t2, "\"result\""): return 212
    if StrContains(t2, "\"error\""): return 213
    if !StrContains(t2, "\"id\":1"): return 214
    if !StrContains(t2, "\"capabilities\""): return 220
    if !StrContains(t2, "\"textDocumentSync\""): return 221
    if !StrContains(t2, "\"hoverProvider\""): return 222
    if !StrContains(t2, "\"definitionProvider\""): return 223
    if !StrContains(t2, "\"referencesProvider\""): return 224
    if !StrContains(t2, "\"completionProvider\""): return 225
    if !StrContains(t2, "\"triggerCharacters\""): return 226
    if !StrContains(t2, "\".\""): return 227
    if !StrContains(t2, "\"diagnosticProvider\""): return 228
    if !StrContains(t2, "\"identifier\""): return 229
    if !StrContains(t2, "\"cheng\""): return 230
    if !StrContains(t2, "\"interFileDependencies\""): return 231
    if !StrContains(t2, "true"): return 232
    if !StrContains(t2, "false"): return 233
    if !StrContains(t2, "\"serverInfo\""): return 240
    if !StrContains(t2, "\"cheng-lsp\""): return 241
    if !StrContains(t2, "\"0.1.0\""): return 242

    # T3: notification
    var t3: str = "{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{}}"
    var v3: int32 = VerifyFrame(t3)
    if v3 != 0: return 300 + v3
    if !StrContains(t3, "\"jsonrpc\""): return 310
    if !StrContains(t3, "\"2.0\""): return 311
    if !StrContains(t3, "\"method\""): return 312
    if !StrContains(t3, "\"initialized\""): return 313
    if !StrContains(t3, "\"params\""): return 314
    if FindIndex(t3, "\"id\"") >= 0: return 315

    # T4: shutdown
    var t4r: str = "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"shutdown\"}"
    var v4: int32 = VerifyFrame(t4r)
    if v4 != 0: return 400 + v4
    if !StrContains(t4r, "\"jsonrpc\""): return 410
    if !StrContains(t4r, "\"2.0\""): return 411
    if !StrContains(t4r, "\"id\":2"): return 412
    if !StrContains(t4r, "\"method\""): return 413
    if !StrContains(t4r, "\"shutdown\""): return 414
    var t4s: str = "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":null}"
    var v4b: int32 = VerifyFrame(t4s)
    if v4b != 0: return 420 + v4b
    if !StrContains(t4s, "\"jsonrpc\""): return 430
    if !StrContains(t4s, "\"2.0\""): return 431
    if !StrContains(t4s, "\"id\":2"): return 432
    if !StrContains(t4s, "\"result\""): return 433
    if !StrContains(t4s, "null"): return 434
    if StrContains(t4s, "\"error\""): return 435

    # T5: exit
    var t5: str = "{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}"
    var v5: int32 = VerifyFrame(t5)
    if v5 != 0: return 500 + v5
    if !StrContains(t5, "\"jsonrpc\""): return 510
    if !StrContains(t5, "\"2.0\""): return 511
    if !StrContains(t5, "\"method\""): return 512
    if !StrContains(t5, "\"exit\""): return 513
    if FindIndex(t5, "\"id\"") >= 0: return 520
    if FindIndex(t5, "\"result\"") >= 0: return 521

    # T6: full lifecycle
    var t6a: str = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{}}"
    var v6a: int32 = VerifyFrame(t6a)
    if v6a != 0: return 600 + v6a
    var t6b: str = "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":null}"
    var v6b: int32 = VerifyFrame(t6b)
    if v6b != 0: return 610 + v6b
    var t6c: str = "{\"jsonrpc\":\"2.0\",\"method\":\"shutdown\"}"
    var v6c: int32 = VerifyFrame(t6c)
    if v6c != 0: return 620 + v6c
    var t6d: str = "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":null}"
    var v6d: int32 = VerifyFrame(t6d)
    if v6d != 0: return 630 + v6d

    # T7: multi-message framing (simplified: verify 2 messages via VerifyFrame)
    var t7a: str = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\"}"
    var t7b: str = "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"shutdown\"}"
    var v7a: int32 = VerifyFrame(t7a)
    if v7a != 0: return 700 + v7a
    var v7b: int32 = VerifyFrame(t7b)
    if v7b != 0: return 710 + v7b

    # T8: error
    var t8: str = "{\"jsonrpc\":\"2.0\",\"id\":1,\"error\":{\"code\":-32601,\"message\":\"MethodNotFound\"}}"
    var v8: int32 = VerifyFrame(t8)
    if v8 != 0: return 800 + v8
    if !StrContains(t8, "\"jsonrpc\""): return 810
    if !StrContains(t8, "\"2.0\""): return 811
    if !StrContains(t8, "\"id\":1"): return 812
    if !StrContains(t8, "\"error\""): return 813
    if !StrContains(t8, "\"code\""): return 814
    if !StrContains(t8, "-32601"): return 815
    if !StrContains(t8, "\"message\""): return 816
    if !StrContains(t8, "\"MethodNotFound\""): return 817
    if StrContains(t8, "\"result\""): return 820

    return 0
