fn R13Exists(path: str): bool =
    return path.len > 3

fn R13Remove(path: str): bool =
    return path.len > 0

fn R13Make(dir: str, name: str): str =
    return Fmt"{dir}/{name}"

fn R13Run(): int32 =
    let outputPath = R13Make("outdir", "app.exe")
    if R13Exists(outputPath) && !R13Remove(outputPath):
        return 10
    if outputPath.len != 14:
        return 11
    return 0

fn main(): int32 =
    let code = R13Run()
    if code != 0:
        return code
    echo("r13_callarg ok")
    return 0
