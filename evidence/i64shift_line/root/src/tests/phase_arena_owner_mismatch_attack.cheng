import cheng/core/ir/phase_arena as phase

fn main(): int32 =
    var store: phase.PhaseArenaStore
    phase.PhaseArenaStoreInit(store, 2, 64, 2)
    let first = phase.PhaseArenaStoreOpenArena(store, 1, 32, 1)
    let second = phase.PhaseArenaStoreOpenArena(store, 2, 32, 1)
    let ownedByFirst = phase.PhaseArenaStoreAllocRef(store, first, 8)
    return phase.PhaseArenaStoreGetByte(store, second, ownedByFirst, 0)
