import std/cmdline as cmdline
import std/system
import cheng/core/tooling/lifetime_ledger as ledger

type ProbeCell =
    value: int64

fn probeLedgerScope(outSeqCount: var int32,
                    outBufferCount: var int32,
                    outCapacityBytes: var int64,
                    outAllocDelta: var int64,
                    outFreeDelta: var int64) =
    let allocBefore = system.memAllocCount()
    let freeBefore = system.memFreeCount()
    var observed: ledger.LifetimeLedger
    ledger.LifetimeLedgerInit(observed)
    let category = ledger.LifetimeLedgerRegisterCategory(observed, "probe_payload")
    let ownerA = ledger.LifetimeLedgerRegisterOwner(observed, "probe_owner_a")
    let ownerB = ledger.LifetimeLedgerRegisterOwner(observed, "probe_owner_b")
    let objectA = ledger.LifetimeLedgerReserveObject(observed, category, int64(96))
    ledger.LifetimeLedgerOwn(observed, objectA, ownerA)
    let borrowA = ledger.LifetimeLedgerBorrow(observed, objectA, ownerB)
    ledger.LifetimeLedgerReturnBorrow(observed, objectA, borrowA, ownerB)
    ledger.LifetimeLedgerMove(observed, objectA, ownerA, ownerB)
    ledger.LifetimeLedgerRelease(observed, objectA, ownerB)
    ledger.LifetimeLedgerAssertOwnerClosed(observed, ownerA)
    ledger.LifetimeLedgerAssertOwnerClosed(observed, ownerB)
    ledger.LifetimeLedgerAssertClosed(observed)
    var metrics: ledger.LifetimeLedgerMetrics
    ledger.LifetimeLedgerReadTotalMetrics(observed, metrics)
    let receipt = ledger.LifetimeLedgerReleaseStorage(observed)
    outSeqCount = receipt.releasedSequenceCount
    outBufferCount = receipt.releasedSequenceBufferCount
    outCapacityBytes = receipt.releasedSequenceCapacityBytes
    outAllocDelta = system.memAllocCount() - allocBefore
    outFreeDelta = system.memFreeCount() - freeBefore

fn probeOrcScope(iterations: int32,
                 outAlloc: var int64,
                 outFree: var int64,
                 outLive: var int64,
                 outRetain: var int64,
                 outRelease: var int64) =
    let allocBefore = system.memAllocCount()
    let freeBefore = system.memFreeCount()
    let liveBefore = system.memLiveCount()
    let retainBefore = system.memRetainCount()
    let releaseBefore = system.memReleaseCount()
    for i in 0..<iterations:
        let cell = new(ProbeCell)
        if cell == nil:
            panic("memory_release_counter_probe: orc cell alloc failed")
        cell.value = int64(i)
        memRetain(cell)
        memRelease(cell)
    outAlloc = system.memAllocCount() - allocBefore
    outFree = system.memFreeCount() - freeBefore
    outLive = system.memLiveCount() - liveBefore
    outRetain = system.memRetainCount() - retainBefore
    outRelease = system.memReleaseCount() - releaseBefore

fn main(argc: int32, argv: str*): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    var seqCount: int32 = 0
    var bufferCount: int32 = 0
    var capacityBytes: int64 = int64(0)
    var allocDelta: int64 = int64(0)
    var freeDelta: int64 = int64(0)
    probeLedgerScope(seqCount, bufferCount, capacityBytes, allocDelta, freeDelta)
    echo(Fmt"ledger_sequence_count={seqCount}")
    echo(Fmt"ledger_buffer_count={bufferCount}")
    echo(Fmt"ledger_capacity_bytes={capacityBytes}")
    echo(Fmt"ledger_scope_alloc_delta={allocDelta}")
    echo(Fmt"ledger_scope_free_delta={freeDelta}")
    var orcAlloc: int64 = int64(0)
    var orcFree: int64 = int64(0)
    var orcLive: int64 = int64(0)
    var orcRetain: int64 = int64(0)
    var orcRelease: int64 = int64(0)
    probeOrcScope(5000, orcAlloc, orcFree, orcLive, orcRetain, orcRelease)
    echo(Fmt"orc_alloc={orcAlloc}")
    echo(Fmt"orc_free={orcFree}")
    echo(Fmt"orc_live={orcLive}")
    echo(Fmt"orc_retain={orcRetain}")
    echo(Fmt"orc_release={orcRelease}")
    return 0
