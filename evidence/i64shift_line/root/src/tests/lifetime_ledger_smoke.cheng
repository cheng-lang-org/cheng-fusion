import std/cmdline as cmdline
import std/os
import cheng/core/tooling/lifetime_ledger as ledger

fn smokeAssert(ok: bool, message: str) =
    if !ok:
        panic(message)

fn newLedger(outLedger: var ledger.LifetimeLedger,
             outCategory: var int32,
             outOwnerA: var int32,
             outOwnerB: var int32) =
    ledger.LifetimeLedgerInit(outLedger)
    outCategory = ledger.LifetimeLedgerRegisterCategory(outLedger, "typed_ir_nodes2")
    outOwnerA = ledger.LifetimeLedgerRegisterOwner(outLedger, "compiler_csg")
    outOwnerB = ledger.LifetimeLedgerRegisterOwner(outLedger, "lowering")

fn runPositive() =
    var observed: ledger.LifetimeLedger
    var category: int32
    var ownerA: int32
    var ownerB: int32
    newLedger(observed, category, ownerA, ownerB)
    let bodyCategory = ledger.LifetimeLedgerRegisterCategory(observed, "body_ir")
    let ownerPrimary = ledger.LifetimeLedgerRegisterOwner(observed, "primary")

    smokeAssert(category == 1, "lifetime ledger smoke: category id")
    smokeAssert(bodyCategory == 2, "lifetime ledger smoke: second category id")
    smokeAssert(ownerA == 1, "lifetime ledger smoke: owner a id")
    smokeAssert(ownerB == 2, "lifetime ledger smoke: owner b id")
    smokeAssert(ownerPrimary == 3, "lifetime ledger smoke: owner primary id")

    let objectA = ledger.LifetimeLedgerReserveObject(observed, category, int64(96))
    smokeAssert(objectA == 1, "lifetime ledger smoke: object a id")
    ledger.LifetimeLedgerOwn(observed, objectA, ownerA)
    smokeAssert(ledger.LifetimeLedgerRead(observed, objectA, ownerA) == category,
                "lifetime ledger smoke: owner read")
    let borrowA = ledger.LifetimeLedgerBorrow(observed, objectA, ownerB)
    smokeAssert(borrowA == 1, "lifetime ledger smoke: borrow id")
    smokeAssert(ledger.LifetimeLedgerRead(observed, objectA, ownerB) == category,
                "lifetime ledger smoke: borrower read")
    ledger.LifetimeLedgerReturnBorrow(observed, objectA, borrowA, ownerB)
    ledger.LifetimeLedgerMove(observed, objectA, ownerA, ownerB)
    smokeAssert(ledger.LifetimeLedgerRead(observed, objectA, ownerB) == category,
                "lifetime ledger smoke: moved owner read")

    let objectB = ledger.LifetimeLedgerReserveObject(observed, bodyCategory, int64(40))
    smokeAssert(objectB == 2, "lifetime ledger smoke: object b id")
    ledger.LifetimeLedgerOwn(observed, objectB, ownerPrimary)

    var liveMetrics: ledger.LifetimeLedgerMetrics
    ledger.LifetimeLedgerReadTotalMetrics(observed, liveMetrics)
    smokeAssert(liveMetrics.allocated == int64(2),
                "lifetime ledger smoke: allocated before release")
    smokeAssert(liveMetrics.live == int64(2),
                "lifetime ledger smoke: live before release")
    smokeAssert(liveMetrics.peakLive == int64(2),
                "lifetime ledger smoke: peak live")
    smokeAssert(liveMetrics.allocatedBytes == int64(136),
                "lifetime ledger smoke: allocated bytes before release")
    smokeAssert(liveMetrics.liveBytes == int64(136),
                "lifetime ledger smoke: live bytes before release")
    smokeAssert(liveMetrics.peakLiveBytes == int64(136),
                "lifetime ledger smoke: peak live bytes")

    ledger.LifetimeLedgerRelease(observed, objectA, ownerB)
    ledger.LifetimeLedgerRelease(observed, objectB, ownerPrimary)
    ledger.LifetimeLedgerAssertOwnerClosed(observed, ownerA)
    ledger.LifetimeLedgerAssertOwnerClosed(observed, ownerB)
    ledger.LifetimeLedgerAssertOwnerClosed(observed, ownerPrimary)
    ledger.LifetimeLedgerAssertClosed(observed)

    var total: ledger.LifetimeLedgerMetrics
    ledger.LifetimeLedgerReadTotalMetrics(observed, total)
    smokeAssert(total.allocated == int64(2), "lifetime ledger smoke: allocated")
    smokeAssert(total.live == int64(0), "lifetime ledger smoke: live")
    smokeAssert(total.peakLive == int64(2), "lifetime ledger smoke: peak")
    smokeAssert(total.retained == int64(1), "lifetime ledger smoke: retained")
    smokeAssert(total.released == int64(2), "lifetime ledger smoke: released")
    smokeAssert(total.allocatedBytes == int64(136),
                "lifetime ledger smoke: allocated bytes")
    smokeAssert(total.liveBytes == int64(0),
                "lifetime ledger smoke: live bytes")
    smokeAssert(total.peakLiveBytes == int64(136),
                "lifetime ledger smoke: peak live bytes final")
    smokeAssert(total.releasedBytes == int64(136),
                "lifetime ledger smoke: released bytes")
    smokeAssert(total.ownerTransferCount == int64(1),
                "lifetime ledger smoke: owner transfer count")
    smokeAssert(total.borrowReturnCount == int64(1),
                "lifetime ledger smoke: borrow return count")

    var typedMetrics: ledger.LifetimeLedgerMetrics
    ledger.LifetimeLedgerReadCategoryMetrics(observed, category, typedMetrics)
    smokeAssert(typedMetrics.allocated == int64(1),
                "lifetime ledger smoke: category allocated")
    smokeAssert(typedMetrics.live == int64(0),
                "lifetime ledger smoke: category live")
    smokeAssert(typedMetrics.retained == int64(1),
                "lifetime ledger smoke: category retained")
    smokeAssert(typedMetrics.released == int64(1),
                "lifetime ledger smoke: category released")
    smokeAssert(typedMetrics.allocatedBytes == int64(96) &&
                typedMetrics.releasedBytes == int64(96),
                "lifetime ledger smoke: category bytes")
    smokeAssert(typedMetrics.ownerTransferCount == int64(1),
                "lifetime ledger smoke: category transfers")
    let storageRelease = ledger.LifetimeLedgerReleaseStorage(observed)
    smokeAssert(ledger.LifetimeLedgerStorageReleased(observed),
                "lifetime ledger smoke: ledger storage release")
    smokeAssert(storageRelease.storageReleased &&
                storageRelease.releasedSequenceBufferCount == 6 &&
                storageRelease.releasedSequenceCapacityBytes > int64(0),
                "lifetime ledger smoke: exact sequence storage release receipt")
    os.WriteLine(os.Get_stdout(),
                 "lifetime_ledger ok allocated=2 live=0 peak_live=2 allocated_bytes=136 live_bytes=0 peak_live_bytes=136 retained=1 released=2 released_bytes=136 owner_transfer_count=1 storage_released=1 exact_sequence_storage_receipt=1")

fn runUnknownObject() =
    var observed: ledger.LifetimeLedger
    var category: int32
    var ownerA: int32
    var ownerB: int32
    newLedger(observed, category, ownerA, ownerB)
    ledger.LifetimeLedgerRead(observed, 99, ownerA)
    panic("lifetime ledger smoke: unknown object accepted")

fn runInvalidObjectBytes() =
    var observed: ledger.LifetimeLedger
    var category: int32
    var ownerA: int32
    var ownerB: int32
    newLedger(observed, category, ownerA, ownerB)
    ledger.LifetimeLedgerReserveObject(observed, category, int64(0))
    panic("lifetime ledger smoke: zero-byte object accepted")

fn runDuplicateRelease() =
    var observed: ledger.LifetimeLedger
    var category: int32
    var ownerA: int32
    var ownerB: int32
    newLedger(observed, category, ownerA, ownerB)
    let objectId = ledger.LifetimeLedgerReserveObject(observed, category, int64(8))
    ledger.LifetimeLedgerOwn(observed, objectId, ownerA)
    ledger.LifetimeLedgerRelease(observed, objectId, ownerA)
    ledger.LifetimeLedgerRelease(observed, objectId, ownerA)
    panic("lifetime ledger smoke: duplicate release accepted")

fn runMoveWhileBorrowed() =
    var observed: ledger.LifetimeLedger
    var category: int32
    var ownerA: int32
    var ownerB: int32
    newLedger(observed, category, ownerA, ownerB)
    let objectId = ledger.LifetimeLedgerReserveObject(observed, category, int64(8))
    ledger.LifetimeLedgerOwn(observed, objectId, ownerA)
    ledger.LifetimeLedgerBorrow(observed, objectId, ownerB)
    ledger.LifetimeLedgerMove(observed, objectId, ownerA, ownerB)
    panic("lifetime ledger smoke: borrowed move accepted")

fn runReleaseWhileBorrowed() =
    var observed: ledger.LifetimeLedger
    var category: int32
    var ownerA: int32
    var ownerB: int32
    newLedger(observed, category, ownerA, ownerB)
    let objectId = ledger.LifetimeLedgerReserveObject(observed, category, int64(8))
    ledger.LifetimeLedgerOwn(observed, objectId, ownerA)
    ledger.LifetimeLedgerBorrow(observed, objectId, ownerB)
    ledger.LifetimeLedgerRelease(observed, objectId, ownerA)
    panic("lifetime ledger smoke: borrowed release accepted")

fn runEndOwned() =
    var observed: ledger.LifetimeLedger
    var category: int32
    var ownerA: int32
    var ownerB: int32
    newLedger(observed, category, ownerA, ownerB)
    let objectId = ledger.LifetimeLedgerReserveObject(observed, category, int64(8))
    ledger.LifetimeLedgerOwn(observed, objectId, ownerA)
    ledger.LifetimeLedgerAssertClosed(observed)
    panic("lifetime ledger smoke: owned object accepted at end")

fn runIllegalMove() =
    var observed: ledger.LifetimeLedger
    var category: int32
    var ownerA: int32
    var ownerB: int32
    newLedger(observed, category, ownerA, ownerB)
    let ownerC = ledger.LifetimeLedgerRegisterOwner(observed, "primary")
    let objectId = ledger.LifetimeLedgerReserveObject(observed, category, int64(8))
    ledger.LifetimeLedgerOwn(observed, objectId, ownerA)
    ledger.LifetimeLedgerMove(observed, objectId, ownerC, ownerB)
    panic("lifetime ledger smoke: illegal move accepted")

fn runReadAfterRelease() =
    var observed: ledger.LifetimeLedger
    var category: int32
    var ownerA: int32
    var ownerB: int32
    newLedger(observed, category, ownerA, ownerB)
    let objectId = ledger.LifetimeLedgerReserveObject(observed, category, int64(8))
    ledger.LifetimeLedgerOwn(observed, objectId, ownerA)
    ledger.LifetimeLedgerRelease(observed, objectId, ownerA)
    ledger.LifetimeLedgerRead(observed, objectId, ownerA)
    panic("lifetime ledger smoke: read after release accepted")

fn runOwnerReadWhileBorrowed() =
    var observed: ledger.LifetimeLedger
    var category: int32
    var ownerA: int32
    var ownerB: int32
    newLedger(observed, category, ownerA, ownerB)
    let objectId = ledger.LifetimeLedgerReserveObject(observed, category, int64(8))
    ledger.LifetimeLedgerOwn(observed, objectId, ownerA)
    ledger.LifetimeLedgerBorrow(observed, objectId, ownerB)
    ledger.LifetimeLedgerRead(observed, objectId, ownerA)
    panic("lifetime ledger smoke: owner read while borrowed accepted")

fn runOwnerReopen() =
    var observed: ledger.LifetimeLedger
    var category: int32
    var ownerA: int32
    var ownerB: int32
    newLedger(observed, category, ownerA, ownerB)
    ledger.LifetimeLedgerAssertOwnerClosed(observed, ownerA)
    let objectId = ledger.LifetimeLedgerReserveObject(observed, category, int64(8))
    ledger.LifetimeLedgerOwn(observed, objectId, ownerA)
    panic("lifetime ledger smoke: closed owner accepted new object")

fn runLedgerReopen() =
    var observed: ledger.LifetimeLedger
    var category: int32
    var ownerA: int32
    var ownerB: int32
    newLedger(observed, category, ownerA, ownerB)
    ledger.LifetimeLedgerAssertOwnerClosed(observed, ownerA)
    ledger.LifetimeLedgerAssertOwnerClosed(observed, ownerB)
    ledger.LifetimeLedgerAssertClosed(observed)
    ledger.LifetimeLedgerRegisterCategory(observed, "after_close")
    panic("lifetime ledger smoke: closed ledger accepted registration")

fn runDuplicateLedgerClose() =
    var observed: ledger.LifetimeLedger
    var category: int32
    var ownerA: int32
    var ownerB: int32
    newLedger(observed, category, ownerA, ownerB)
    ledger.LifetimeLedgerAssertOwnerClosed(observed, ownerA)
    ledger.LifetimeLedgerAssertOwnerClosed(observed, ownerB)
    ledger.LifetimeLedgerAssertClosed(observed)
    ledger.LifetimeLedgerAssertClosed(observed)
    panic("lifetime ledger smoke: duplicate ledger close accepted")

fn runStorageReleaseBeforeMetrics() =
    var observed: ledger.LifetimeLedger
    var category: int32
    var ownerA: int32
    var ownerB: int32
    newLedger(observed, category, ownerA, ownerB)
    ledger.LifetimeLedgerAssertOwnerClosed(observed, ownerA)
    ledger.LifetimeLedgerAssertOwnerClosed(observed, ownerB)
    ledger.LifetimeLedgerAssertClosed(observed)
    ledger.LifetimeLedgerReleaseStorage(observed)
    panic("lifetime ledger smoke: storage released before final metrics")

fn runReadAfterStorageRelease() =
    var observed: ledger.LifetimeLedger
    var category: int32
    var ownerA: int32
    var ownerB: int32
    newLedger(observed, category, ownerA, ownerB)
    ledger.LifetimeLedgerAssertOwnerClosed(observed, ownerA)
    ledger.LifetimeLedgerAssertOwnerClosed(observed, ownerB)
    ledger.LifetimeLedgerAssertClosed(observed)
    var metrics: ledger.LifetimeLedgerMetrics
    ledger.LifetimeLedgerReadTotalMetrics(observed, metrics)
    ledger.LifetimeLedgerReleaseStorage(observed)
    ledger.LifetimeLedgerReadTotalMetrics(observed, metrics)
    panic("lifetime ledger smoke: metrics read after storage release")

fn runDuplicateStorageRelease() =
    var observed: ledger.LifetimeLedger
    var category: int32
    var ownerA: int32
    var ownerB: int32
    newLedger(observed, category, ownerA, ownerB)
    ledger.LifetimeLedgerAssertOwnerClosed(observed, ownerA)
    ledger.LifetimeLedgerAssertOwnerClosed(observed, ownerB)
    ledger.LifetimeLedgerAssertClosed(observed)
    var metrics: ledger.LifetimeLedgerMetrics
    ledger.LifetimeLedgerReadTotalMetrics(observed, metrics)
    ledger.LifetimeLedgerReleaseStorage(observed)
    ledger.LifetimeLedgerReleaseStorage(observed)
    panic("lifetime ledger smoke: duplicate storage release accepted")

fn main(argc: int32, argv: str*): int32 =
    argc
    argv
    cmdline.CaptureCmdLine(argc, argv)
    let mode = cmdline.ParamStr(1)
    if mode == "unknown-object":
        runUnknownObject()
    elif mode == "invalid-object-bytes":
        runInvalidObjectBytes()
    elif mode == "duplicate-release":
        runDuplicateRelease()
    elif mode == "move-while-borrowed":
        runMoveWhileBorrowed()
    elif mode == "release-while-borrowed":
        runReleaseWhileBorrowed()
    elif mode == "end-owned":
        runEndOwned()
    elif mode == "illegal-move":
        runIllegalMove()
    elif mode == "read-after-release":
        runReadAfterRelease()
    elif mode == "owner-read-while-borrowed":
        runOwnerReadWhileBorrowed()
    elif mode == "owner-reopen":
        runOwnerReopen()
    elif mode == "ledger-reopen":
        runLedgerReopen()
    elif mode == "duplicate-ledger-close":
        runDuplicateLedgerClose()
    elif mode == "storage-release-before-metrics":
        runStorageReleaseBeforeMetrics()
    elif mode == "read-after-storage-release":
        runReadAfterStorageRelease()
    elif mode == "duplicate-storage-release":
        runDuplicateStorageRelease()
    elif len(mode) != 0:
        panic("lifetime ledger smoke: unknown mode")
    else:
        runPositive()
    return 0
