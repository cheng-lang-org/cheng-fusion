import std/strings
import cheng/core/csg_core/jsonl as jsonl

fn smokeExpect(cond: bool, code: int32): int32 =
    if !cond:
        return code
    return 0

@borrows
fn smokeExpectLine(lines: str[], index: int32, expected: str, code: int32): int32 =
    if lines[index] != expected:
        return code
    return 0

fn main(): int32 =
    let schemaFact = "{\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\",\"features\":[\"core-facts\"]}"
    let moduleFact = "{\"kind\":\"csg.module\",\"id\":\"mod_main\",\"path\":\"main.ts\",\"sha256\":\"sha256:abc\"}"

    let lfLines = jsonl.CsgCoreJsonlSplitLines("a\nb\n")
    if smokeExpect(lfLines.len == 2, 1) != 0:
        return 1
    if smokeExpectLine(lfLines, 0, "a", 2) != 0:
        return 1
    if smokeExpectLine(lfLines, 1, "b", 3) != 0:
        return 1

    let csgText = strings.ConcatStr(strings.ConcatStr(schemaFact, "\n"), moduleFact)
    let csgLines = jsonl.CsgCoreJsonlSplitLines(csgText)
    if smokeExpect(csgLines.len == 2, 4) != 0:
        return 1
    if smokeExpectLine(csgLines, 0, schemaFact, 5) != 0:
        return 1
    if smokeExpectLine(csgLines, 1, moduleFact, 6) != 0:
        return 1

    let crlfLines = jsonl.CsgCoreJsonlSplitLines("x\r\ny\r\n")
    if smokeExpect(crlfLines.len == 2, 7) != 0:
        return 1
    if smokeExpectLine(crlfLines, 0, "x", 8) != 0:
        return 1
    if smokeExpectLine(crlfLines, 1, "y", 9) != 0:
        return 1

    let middleEmpty = jsonl.CsgCoreJsonlSplitLines("head\n\nbody\n")
    if smokeExpect(middleEmpty.len == 3, 10) != 0:
        return 1
    if smokeExpectLine(middleEmpty, 1, "", 11) != 0:
        return 1

    let emptyLines = jsonl.CsgCoreJsonlSplitLines("")
    if smokeExpect(emptyLines.len == 0, 12) != 0:
        return 1

    let unterminatedCr = jsonl.CsgCoreJsonlSplitLines("tail\r")
    if smokeExpect(unterminatedCr.len == 1, 13) != 0:
        return 1
    if smokeExpectLine(unterminatedCr, 0, "tail\r", 14) != 0:
        return 1

    return 0
