import cheng/core/runtime/web_scene_runtime as scene

fn main(): int32 =
    var graph: scene.WebSceneGraph
    scene.WebSceneGraphInit(graph)

    var routeIndex: int32 = -1
    if !scene.WebSceneAddRoute(graph, "dynamic_image", 1, 1, routeIndex):
        return 1
    if !scene.WebSceneAddLayer(graph, routeIndex, 1, "root", 0):
        return 2
    if !scene.WebSceneAddNode(graph, routeIndex, 1, 0, 2, "img", "", 1):
        return 3
    if !scene.WebSceneAddProp(graph, routeIndex, 1, 0, "src", "", "state-src:proofScreenshotDataUrl"):
        return 4
    if scene.WebScenePaintCount(graph) != 0:
        return 5

    if !scene.WebSceneSetStateValue(graph, "proofScreenshotDataUrl", "data:image/png;base64,AAAA"):
        return 6
    if scene.WebScenePropValueAt(graph, 0) != "data:image/png;base64,AAAA":
        return 7
    if scene.WebScenePaintCount(graph) != 1:
        return 8
    if scene.WebScenePaintKindAt(graph, 0) != scene.WebScenePaintImage:
        return 9
    if scene.WebScenePaintResourceAt(graph, 0) != "image.state.proofScreenshotDataUrl":
        return 10
    if scene.WebScenePaintOrdinalAt(graph, 0) != 100000:
        return 11

    // GPU draw command must carry a real texture reference (the forged state-image
    // hash the host re-injects the decoded pixels under). Building the image atlas
    // skips the pixel-less state-image shell, but the DrawImage command still emits
    // with imageId == WebSceneResourceIdHash31("image.state.<ref>") — the same id the
    // host aligns its uploaded dynamic texture to. Without this the smoke was blind to
    // the draw falling through to a placeholder.
    var imageAtlas: scene.WebSceneImageAtlas
    var svgAtlas: scene.WebSceneSvgDisplayListAtlas
    var gpu: scene.WebSceneGpuCommandBuffer
    if !scene.WebSceneBuildImageAtlasFromResources(graph, imageAtlas):
        return 15
    if scene.WebSceneImageAtlasTextureCount(imageAtlas) != 0:
        return 16
    if !scene.WebSceneBuildRouteLayerGpuCommandsWithAtlases(graph, routeIndex, 1, imageAtlas, svgAtlas, gpu):
        return 17
    if scene.WebSceneGpuCommandCount(gpu) != 1:
        return 18
    if scene.WebSceneGpuCommandKindAt(gpu, 0) != scene.WebSceneGpuDrawImage:
        return 19
    let expectedTextureId = scene.WebSceneResourceIdHash31("image.state.proofScreenshotDataUrl")
    if expectedTextureId <= 0:
        return 20
    if scene.WebSceneGpuCommandImageIdAt(gpu, 0) != expectedTextureId:
        return 21

    if !scene.WebSceneSetStateValue(graph, "proofScreenshotDataUrl", ""):
        return 12
    if scene.WebScenePropValueAt(graph, 0) != "":
        return 13
    if scene.WebScenePaintCount(graph) != 0:
        return 14
    return 0
