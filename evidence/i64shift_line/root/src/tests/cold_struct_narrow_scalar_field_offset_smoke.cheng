# #44 regression lock: named `type X = \n field: T` struct/object field byte
# layout must use natural C alignment for narrow scalar fields (int8/uint8/
# int16/uint16), not the generic 4-byte register-slot width. Mirrors the
# real Darwin `struct stat` field list (two uint16 fields ahead of a
# uint64-aligned field, then four embedded timespec-shaped struct fields,
# then trailing scalar fields) that exposed the defect: widening st_mode/
# st_nlink from 2 to 4 bytes each shifted every field from st_ino onward by
# a fixed +8, so `st.st_size` field access read back what should have been
# `st_blocks`'s value. Root cause: cold_parser.c's named-object field path
# used the generic register-slot sizer (cold_parser_slot_size_from_type,
# 4 bytes for every SLOT_I32-classified scalar) instead of the byte-precise
# payload sizer (cold_payload_size_from_type_with_symbols) already used by
# the anon-tuple and enum-variant field paths.
type
    NarrowRTs =
        tv_sec: int64
        tv_nsec: int64
    NarrowRStat =
        st_dev: int32
        st_mode: uint16
        st_nlink: uint16
        st_ino: uint64
        st_uid: uint32
        st_gid: uint32
        st_rdev: int32
        st_pad0: int32
        st_atimespec: NarrowRTs
        st_mtimespec: NarrowRTs
        st_ctimespec: NarrowRTs
        st_birthtimespec: NarrowRTs
        st_size: int64
        st_blocks: int64
        st_blksize: int32
        st_flags: uint32
        st_gen: uint32
        st_lspare: int32
        st_qspare0: int64
        st_qspare1: int64

fn main(): int32 =
    var o: NarrowRStat
    let base = int64(ptr(&o))
    if int64(ptr(&o.st_mode)) - base != 4:
        return 1
    if int64(ptr(&o.st_nlink)) - base != 6:
        return 2
    if int64(ptr(&o.st_ino)) - base != 8:
        return 3
    if int64(ptr(&o.st_atimespec)) - base != 32:
        return 4
    if int64(ptr(&o.st_mtimespec.tv_sec)) - base != 48:
        return 5
    if int64(ptr(&o.st_size)) - base != 96:
        return 6
    if int64(ptr(&o.st_blocks)) - base != 104:
        return 7
    if int64(ptr(&o.st_qspare1)) - base != 136:
        return 8
    return 0
