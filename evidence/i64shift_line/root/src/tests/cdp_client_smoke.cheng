# cdp_client_smoke.cheng
# Smoke test: connect to Chrome DevTools and fetch DOM document.
# Assumes Chrome is running with --remote-debugging-port=9222
# Usage: link with Darwin provider for socket exports.

import cheng/core/runtime/cdp_client as cdp
import std/strings
import std/strutils as su

fn main(): int32 =
    echo("CDP client smoke: connecting to Chrome DevTools on port 9222...")

    var docJson: str
    if !cdp.cdpFetchDocumentFromChrome(docJson):
        echo("FAIL: could not fetch document from Chrome")
        echo("Make sure Chrome is running with: --remote-debugging-port=9222")
        return 1

    echo(su.Join(["OK: received DOM document, length=", strings.IntToStr(len(docJson))], ""))

    # Print first 500 chars of the DOM JSON
    var previewLen = 500
    if len(docJson) < previewLen:
        previewLen = len(docJson)
    var preview = sliceBytes(docJson, 0, previewLen)
    echo(su.Join(["First ", strings.IntToStr(previewLen), " chars:"], ""))
    echo(preview)

    return 0
