import std/result

type IntResult = OkInt(value: int32) | ErrStr(error: str)

type CompilerEmit = EmitExe | EmitObj

fn Touch(x: int32): int32 =
    return x

fn CompilerEmitFromText(raw: str): Result[CompilerEmit] =
    if raw == "obj":
        return Ok[CompilerEmit](EmitObj)
    if raw == "exe":
        return Ok[CompilerEmit](EmitExe)
    return Err[CompilerEmit]("unknown emit")

fn Count(seed: int32): IntResult =
    var x = seed
    Touch(x)
    for i in 1..3:
        if i == 2:
            x = x + i
        elif i == 3:
            x = x + Touch(i)
        else:
            x = x + 1
    if x > 10:
        return OkInt(x)
    return ErrStr("too small")

fn main(): int32 =
    let emitKindRes = CompilerEmitFromText("obj")
    if IsErr(emitKindRes):
        return 1
    let r = Count(5)
    match r:
        OkInt(value) =>
            return value
        ErrStr(e) =>
            return len(e)
