fn helper_add(a: int32, b: int32): int32 =
    return a + b

fn intern_id_shaped_payload(): int32 =
    return 0

@exported("任意符号_λ")
fn utf8_export_symbol(value: int32): int32 =
    return value + 1

fn main(): int32 =
    let a = 40
    let b = 2
    if a > 0:
        return utf8_export_symbol(helper_add(a, b))
    return intern_id_shaped_payload()
