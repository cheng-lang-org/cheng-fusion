import std/os
import std/system
import std/strutils as strutil
import cheng/core/backend/lowering_plan as lower
import cheng/core/backend/system_link_plan as slplan
import cheng/core/lang/intern as langintern
import cheng/core/lang/parser
import cheng/core/lang/typed_expr as texpr
import cheng/core/ir/compiler_dense_store as dense
import cheng/core/tooling/compiler_csg as ccsg

fn compactFixtureInit(csg: var ccsg.CompilerCsg,
                      includeExpr: bool) =
    let sourcePath = "/tmp/lowering_compact_expr_bind_fixture.cheng"
    csg.semanticGraph = ccsg.CompilerCsgSemanticInit()
    csg.semanticGraph.oracleCompared = true
    csg.semanticGraph.oracleMatched = true
    csg.semanticGraph.exprSliceTypedFactComplete = true
    csg.semanticGraph.exprSliceValidationReason = "complete"
    csg.semanticGraph.resolvedCallTable.internPool = langintern.InternPoolNew()
    add(csg.semanticGraph.resolvedCallTable.functionRowHeads, -1)
    add(csg.semanticGraph.resolvedCallTable.functionRowHeads, -1)
    add(csg.semanticGraph.sourceTable.sourcePaths, sourcePath)
    add(csg.semanticGraph.sourceTable.modulePaths, "lowering_compact_expr_bind_fixture")
    add(csg.semanticGraph.sourceTable.textBytes, 32)
    add(csg.semanticGraph.sourceTable.declStart, 0)
    add(csg.semanticGraph.sourceTable.declCount, 1)
    add(csg.semanticGraph.sourceTable.importEdgeStart, 0)
    add(csg.semanticGraph.sourceTable.importEdgeCount, 0)
    var indexContext: texpr.TypedExprSourceContext
    indexContext.sourcePath = sourcePath
    indexContext.normalizedSourcePath = sourcePath
    var indexContexts: texpr.TypedExprSourceContext[]
    add(indexContexts, indexContext)
    texpr.TypedExprBuildSourceContextIndex(csg.typedIr, indexContexts)
    csg.typedIr.internPool = langintern.InternPoolNew()
    var callerFn: texpr.TypedExprIrFunction
    callerFn.sourcePath = sourcePath
    callerFn.functionName = "Caller"
    callerFn.signatureLineNumber = 1
    callerFn.endLineNumber = 2
    callerFn.bodyLineNumber = 2
    callerFn.returnType = "int32"
    callerFn.returnNodeIndex = -1
    texpr.TypedExprIrAppendFunction(csg.typedIr, callerFn)
    var otherFn = callerFn
    otherFn.functionName = "Other"
    otherFn.signatureLineNumber = 3
    otherFn.endLineNumber = 4
    otherFn.bodyLineNumber = 4
    texpr.TypedExprIrAppendFunction(csg.typedIr, otherFn)
    # A reset table has count=0 but still owns its Arena and intern pool. The
    # lowering bind must physically release both before doing closure work.
    var retainedFact: texpr.TypedExprFact
    retainedFact.sourcePath = sourcePath
    retainedFact.exprId = "retained-capacity"
    texpr.TypedExprFactTableAppendHandBuilt(csg.typedExprFacts, retainedFact)
    texpr.TypedExprFactTableReset(csg.typedExprFacts)
    assert(csg.typedExprFacts.count == 0 &&
           csg.typedExprFacts.arena.capacityBytes > 0 &&
           csg.typedExprFacts.internPool != nil,
           "fixture: reset table did not retain capacity")
    if !includeExpr:
        return
    csg.semanticGraph.exprSummary.sourceCount = 1
    csg.semanticGraph.exprSummary.exprCount = 1
    csg.semanticGraph.exprSummary.ifCount = 1
    var expr: parser.NormalizedExpr
    expr.exprId = "expr-1"
    expr.sourcePath = sourcePath
    expr.lineNumber = 2
    expr.columnNumber = 5
    expr.kind = parser.NormalizedExprIf
    add(csg.exprLayer.exprs, expr)
    add(csg.exprLayer.exprNext, -1)
    csg.exprLayer.sourceCount = 1
    csg.exprLayerLiveBytes = Int64(256)
    add(csg.semanticGraph.exprSliceTable.sourceIndex, 0)
    add(csg.semanticGraph.exprSliceTable.sourcePaths, sourcePath)
    add(csg.semanticGraph.exprSliceTable.functionIndex, -1)
    add(csg.semanticGraph.exprSliceTable.exprStart, 0)
    add(csg.semanticGraph.exprSliceTable.exprCount, 1)
    add(csg.semanticGraph.exprSliceTable.typedFactStart, 0)
    add(csg.semanticGraph.exprSliceTable.typedFactCount, 1)
    add(csg.semanticGraph.typedFactTable.sourceIndexes, 0)
    csg.typedExprFactCountSnapshot = 1
    csg.semanticGraph.exprSliceTypedFactCoveredCount = 1
    csg.typedFactsLiveBytes = Int64(4)

fn compactFixtureBind(csg: var ccsg.CompilerCsg,
                      plan: var lower.LoweringPlanStub,
                      err: var str): bool =
    var linkPlan: slplan.SystemLinkPlanStub
    var sourceBundleOwner: slplan.SystemLinkPlanSourceBundleOwner
    return lower.BuildLoweringPlanStubFromCompilerCsgBorrowedWithSourceBundleOwner(
        linkPlan,
        sourceBundleOwner,
        csg,
        plan,
        err)

fn compactFixtureAppendResolvedCall(csg: var ccsg.CompilerCsg,
                                    targetSourcePath: str,
                                    targetName: str) =
    let pool = csg.semanticGraph.resolvedCallTable.internPool
    let rowIndex = csg.semanticGraph.resolvedCallTable.sourceIndexes.len
    add(csg.semanticGraph.resolvedCallTable.sourceIndexes, 0)
    add(csg.semanticGraph.resolvedCallTable.originParserNodeIds, 0)
    add(csg.semanticGraph.resolvedCallTable.functionIndexes, 0)
    add(csg.semanticGraph.resolvedCallTable.functionRowNext, -1)
    csg.semanticGraph.resolvedCallTable.functionRowHeads[0] = rowIndex
    add(csg.semanticGraph.resolvedCallTable.sourcePathIds,
        langintern.Intern(pool, csg.semanticGraph.sourceTable.sourcePaths[0]))
    add(csg.semanticGraph.resolvedCallTable.lineNumbers, 2)
    add(csg.semanticGraph.resolvedCallTable.columnNumbers, 1)
    add(csg.semanticGraph.resolvedCallTable.callQualifierIds, langintern.Intern(pool, "dep"))
    add(csg.semanticGraph.resolvedCallTable.callCalleeIds, langintern.Intern(pool, targetName))
    add(csg.semanticGraph.resolvedCallTable.callTargetIds, langintern.Intern(pool, targetName))
    add(csg.semanticGraph.resolvedCallTable.callTargetSourcePathIds,
        langintern.Intern(pool, targetSourcePath))
    add(csg.semanticGraph.resolvedCallTable.callTargetImportcFlags, false)
    add(csg.semanticGraph.resolvedCallTable.callArgCounts, 0)
    add(csg.semanticGraph.resolvedCallTable.callArgsTextIds, langintern.Intern(pool, ""))
    add(csg.semanticGraph.resolvedCallTable.returnRootFlags, false)

fn compactFixtureAssertReleased(csg: var ccsg.CompilerCsg,
                                plan: var lower.LoweringPlanStub,
                                label: str) =
    assert(csg.exprLayer.sourceCount == 0 && csg.exprLayer.exprs.len == 0 &&
           csg.exprLayer.exprNext.len == 0 && csg.exprLayerLiveBytes == Int64(0),
           Fmt"{label}: donor expr layer retained")
    assert(plan.exprLayer.sourceCount == 0 && plan.exprLayer.exprs.len == 0 &&
           plan.exprLayer.exprNext.len == 0,
           Fmt"{label}: plan expr layer retained")
    assert(plan.typedExprFacts.count == 0,
           Fmt"{label}: plan forbidden typed facts retained")
    assert(csg.typedExprFacts.count == 0 &&
           csg.typedExprFacts.arena.capacityBytes == 0 &&
           csg.typedExprFacts.internPool == nil &&
           csg.typedExprFacts.exprIdIds.capacity == 0 &&
           csg.typedExprFacts.sourcePathIds.capacity == 0 &&
           csg.typedExprFacts.callQualifierIds.capacity == 0 &&
           csg.typedExprFacts.callCalleeIds.capacity == 0 &&
           csg.typedExprFacts.callTargetIds.capacity == 0 &&
           csg.typedExprFacts.callTargetSourcePathIds.capacity == 0 &&
           csg.typedExprFacts.callArgsTextIds.capacity == 0 &&
           csg.typedExprFacts.typeTextIds.capacity == 0 &&
           csg.typedExprFacts.lineNumbers.capacity == 0 &&
           csg.typedExprFacts.columnNumbers.capacity == 0 &&
           csg.typedExprFacts.endLineNumbers.capacity == 0 &&
           csg.typedExprFacts.endColumnNumbers.capacity == 0 &&
           csg.typedExprFacts.callArgCounts.capacity == 0 &&
           csg.typedExprFacts.kinds.capacity == 0 &&
           csg.typedExprFacts.surfaceCallKinds.capacity == 0 &&
           csg.typedExprFacts.callReasons.capacity == 0 &&
           csg.typedExprFacts.abiClasses.capacity == 0 &&
           csg.typedExprFacts.valueKinds.capacity == 0 &&
           csg.typedExprFacts.placeKinds.capacity == 0 &&
           csg.typedExprFacts.sinkPlaceKinds.capacity == 0 &&
           csg.typedExprFacts.loweringModes.capacity == 0 &&
           csg.typedExprFacts.callKinds.capacity == 0 &&
           csg.typedExprFacts.typeCallKinds.capacity == 0 &&
           csg.typedExprFacts.returnKinds.capacity == 0 &&
           csg.typedExprFacts.callResolveds.capacity == 0 &&
           csg.typedExprFacts.callTargetImportcs.capacity == 0 &&
           csg.typedExprFacts.callPrefixStyles.capacity == 0 &&
           csg.typedExprFacts.hasSinks.capacity == 0 &&
           csg.typedExprFacts.returnRoots.capacity == 0,
           Fmt"{label}: donor typed-fact arena retained")
    assert(csg.semanticGraph.typedFactTable.sourceIndexes.len == 0,
           Fmt"{label}: donor compact typed-fact rows retained")
    assert(csg.typedFactsLiveBytes == Int64(0),
           Fmt"{label}: donor compact typed-fact live bytes retained")
    assert(texpr.TypedExprIrBuildIndex(csg.typedIr) == nil,
           Fmt"{label}: donor TypedIR build index retained")
    assert(csg.typedIr.arena.basePtr == nil &&
           csg.typedIr.arena.capacityBytes == 0 &&
           csg.typedIr.internPool == nil,
           Fmt"{label}: donor TypedIR owner retained")

fn compactFixtureAssertAbortReleased(plan: var lower.LoweringPlanStub,
                                      label: str) =
    assert(plan.resolvedCallSnapshot.internPool == nil &&
           plan.resolvedCallSnapshot.sourceIndexes.len == 0 &&
           plan.resolvedCallSnapshot.functionIndexes.len == 0 &&
           plan.resolvedCallSnapshot.functionRowHeads.len == 0 &&
           plan.resolvedCallSnapshot.functionRowNext.len == 0 &&
           plan.resolvedCallSnapshot.sourcePathIds.len == 0 &&
           plan.resolvedCallSnapshot.lineNumbers.len == 0 &&
           plan.resolvedCallSnapshot.columnNumbers.len == 0 &&
           plan.resolvedCallSnapshot.callQualifierIds.len == 0 &&
           plan.resolvedCallSnapshot.callCalleeIds.len == 0 &&
           plan.resolvedCallSnapshot.callTargetIds.len == 0 &&
           plan.resolvedCallSnapshot.callTargetSourcePathIds.len == 0 &&
           plan.resolvedCallSnapshot.callTargetImportcFlags.len == 0 &&
           plan.resolvedCallSnapshot.callArgCounts.len == 0 &&
           plan.resolvedCallSnapshot.callArgsTextIds.len == 0 &&
           plan.resolvedCallSnapshot.returnRootFlags.len == 0 &&
           plan.compilerCsgExprSliceSidecar.sourceIndex.len == 0 &&
           plan.compilerCsgExprSliceSidecar.sourcePaths.len == 0 &&
           plan.compilerCsgExprSliceSidecar.functionIndex.len == 0 &&
           plan.compilerCsgExprSliceSidecar.exprStart.len == 0 &&
           plan.compilerCsgExprSliceSidecar.exprCount.len == 0 &&
           plan.compilerCsgExprSliceSidecar.typedFactStart.len == 0 &&
           plan.compilerCsgExprSliceSidecar.typedFactCount.len == 0 &&
           plan.typedExprFacts.count == 0 &&
           plan.typedExprFacts.arena.capacityBytes == 0 &&
           plan.typedExprFacts.internPool == nil &&
           texpr.TypedExprIrBuildIndex(plan.typedIr) == nil &&
           plan.typedIr.arena.basePtr == nil &&
           plan.typedIr.arena.capacityBytes == 0 &&
           plan.typedIr.internPool == nil,
           Fmt"{label}: aborted plan retained moved payload")

fn compactFixtureAssertMovedIndex(plan: var lower.LoweringPlanStub,
                                   label: str): texpr.TypedExprBuildIndex =
    let index = texpr.TypedExprIrBuildIndex(plan.typedIr)
    var contextIndex: int32
    assert(index != nil && !index.released &&
           plan.typedIr.arena.basePtr != nil &&
           plan.typedIr.arena.capacityBytes > 0 &&
           plan.typedIr.internPool != nil &&
           texpr.TypedExprBuildIndexLookup(index,
                                           "ctx_source",
                                           "/tmp/lowering_compact_expr_bind_fixture.cheng",
                                           "",
                                           "",
                                           contextIndex) == texpr.TypedExprBuildIndexUnique &&
           contextIndex == 0,
           Fmt"{label}: moved TypedIR build index missing or unreadable")
    return index

fn runNonemptySummaryCase() =
    var csg: ccsg.CompilerCsg
    var plan: lower.LoweringPlanStub
    var err: str
    compactFixtureInit(csg, true)
    assert(compactFixtureBind(csg, plan, err),
           Fmt"nonempty: bind failed {err}")
    compactFixtureAssertReleased(csg, plan, "nonempty")
    let nonemptyMovedIndex = compactFixtureAssertMovedIndex(plan, "nonempty")
    let nonemptyMovedPool = plan.typedIr.internPool
    assert(plan.compactExprPayloadReleasedBeforeSourceClosure,
           "nonempty: early release proof missing")
    let report = lower.LoweringPlanStubReport(plan)
    assert(strutil.Contains(report, "expr_surface_source_count=1") &&
           strutil.Contains(report, "expr_surface_expr_count=1") &&
           strutil.Contains(report, "expr_surface_if_count=1") &&
           strutil.Contains(report, "typed_expr_fact_payload_retained_count=0") &&
           strutil.Contains(report, "compact_expr_payload_released_before_source_closure=true"),
           "nonempty: compact summary report mismatch")
    let freeBeforeRelease = system.memFreeCount()
    lower.LoweringPlanReleaseAfterPrimaryObjectPlan(plan)
    assert(texpr.TypedExprBuildIndexReleaseCount(nonemptyMovedIndex) == 1,
           "nonempty: moved TypedIR build index release count")
    assert(langintern.InternPoolCount(nonemptyMovedPool) == 0 &&
           system.memFreeCount() > freeBeforeRelease,
           "nonempty: TypedIR release did not free owned runtime storage")
    compactFixtureAssertAbortReleased(plan, "nonempty-release")

fn runMissingSummaryCase() =
    var csg: ccsg.CompilerCsg
    var plan: lower.LoweringPlanStub
    var err: str
    compactFixtureInit(csg, true)
    let ownedPool = csg.typedIr.internPool
    let freeBeforeBind = system.memFreeCount()
    csg.semanticGraph.exprSummary = ccsg.CompilerCsgSemanticExprSummary()
    assert(!compactFixtureBind(csg, plan, err) &&
           strutil.Contains(err, "expr-slice totals mismatch"),
           Fmt"missing summary: expected hard failure err={err}")
    compactFixtureAssertReleased(csg, plan, "missing summary")
    compactFixtureAssertAbortReleased(plan, "missing summary")
    assert(!plan.compactExprPayloadReleasedBeforeSourceClosure,
           "missing summary: abort retained proof scalar")
    assert(langintern.InternPoolCount(ownedPool) == 0 &&
           system.memFreeCount() > freeBeforeBind,
           "missing summary: abort did not free TypedIR owner")

fn runContradictorySummaryCase() =
    var csg: ccsg.CompilerCsg
    var plan: lower.LoweringPlanStub
    var err: str
    compactFixtureInit(csg, true)
    csg.semanticGraph.exprSummary.ifCount = 2
    assert(!compactFixtureBind(csg, plan, err) &&
           strutil.Contains(err, "expr summary invalid"),
           Fmt"contradictory summary: expected hard failure err={err}")
    compactFixtureAssertReleased(csg, plan, "contradictory summary")
    compactFixtureAssertAbortReleased(plan, "contradictory summary")

fn runDeclarationOnlyCase() =
    var csg: ccsg.CompilerCsg
    var plan: lower.LoweringPlanStub
    var err: str
    compactFixtureInit(csg, false)
    assert(csg.semanticGraph.sourceTable.sourcePaths.len == 1 &&
           csg.semanticGraph.exprSummary.sourceCount == 0 &&
           csg.semanticGraph.exprSummary.exprCount == 0,
           "declaration-only: fixture contract")
    assert(compactFixtureBind(csg, plan, err),
           Fmt"declaration-only: bind failed {err}")
    compactFixtureAssertReleased(csg, plan, "declaration-only")
    let declarationMovedIndex = compactFixtureAssertMovedIndex(plan, "declaration-only")
    let declarationMovedPool = plan.typedIr.internPool
    let report = lower.LoweringPlanStubReport(plan)
    assert(strutil.Contains(report, "expr_surface_source_count=0") &&
           strutil.Contains(report, "expr_surface_expr_count=0"),
           "declaration-only: zero summary report mismatch")
    let freeBeforeRelease = system.memFreeCount()
    lower.LoweringPlanReleaseAfterPrimaryObjectPlan(plan)
    assert(texpr.TypedExprBuildIndexReleaseCount(declarationMovedIndex) == 1,
           "declaration-only: moved TypedIR build index release count")
    assert(langintern.InternPoolCount(declarationMovedPool) == 0 &&
           system.memFreeCount() > freeBeforeRelease,
           "declaration-only: TypedIR release did not free owned runtime storage")
    compactFixtureAssertAbortReleased(plan, "declaration-only-release")

fn runLegacyTypedFactsCase() =
    var csg: ccsg.CompilerCsg
    var plan: lower.LoweringPlanStub
    var err: str
    compactFixtureInit(csg, false)
    var fact: texpr.TypedExprFact
    fact.sourcePath = csg.semanticGraph.sourceTable.sourcePaths[0]
    texpr.TypedExprFactTableAppendHandBuilt(csg.typedExprFacts, fact)
    assert(!compactFixtureBind(csg, plan, err) &&
           strutil.Contains(err, "forbidden typed-expr facts must be empty count=1"),
           Fmt"forbidden typed facts: expected hard failure err={err}")
    compactFixtureAssertReleased(csg, plan, "forbidden typed facts")
    compactFixtureAssertAbortReleased(plan, "forbidden typed facts")
    assert(csg.typedExprFacts.count == 0,
           "forbidden typed facts: donor facts not released")

fn runResolvedCallSuccessCase() =
    var csg: ccsg.CompilerCsg
    var plan: lower.LoweringPlanStub
    var err: str
    compactFixtureInit(csg, false)
    let sourcePath = csg.semanticGraph.sourceTable.sourcePaths[0]
    compactFixtureAppendResolvedCall(csg, sourcePath, "Other")
    let snapshotPool = csg.semanticGraph.resolvedCallTable.internPool
    assert(langintern.InternPoolCount(snapshotPool) > 0,
           "resolved call success: fixture pool empty")
    assert(compactFixtureBind(csg, plan, err),
           Fmt"resolved call success: bind failed {err}")
    compactFixtureAssertReleased(csg, plan, "resolved-call-success")
    let movedIndex = compactFixtureAssertMovedIndex(plan, "resolved-call-success")
    assert(lower.LoweringResolvedCallFactSnapshotBound(plan) &&
           lower.LoweringResolvedCallFactSnapshotEntryCount(plan) == 1 &&
           plan.resolvedCallSnapshot.internPool == snapshotPool &&
           plan.resolvedCallSnapshot.functionRowHeads.len == 2 &&
           plan.resolvedCallSnapshot.functionRowHeads[0] == 0,
           "resolved call success: moved snapshot unreadable")
    let freeBeforeRelease = system.memFreeCount()
    lower.LoweringPlanReleaseAfterPrimaryObjectPlan(plan)
    assert(texpr.TypedExprBuildIndexReleaseCount(movedIndex) == 1 &&
           langintern.InternPoolCount(snapshotPool) == 0 &&
           system.memFreeCount() > freeBeforeRelease,
           "resolved call success: owners not physically released")
    compactFixtureAssertAbortReleased(plan, "resolved-call-success-release")
    lower.LoweringPlanReleaseAfterPrimaryObjectPlan(plan)
    assert(texpr.TypedExprBuildIndexReleaseCount(movedIndex) == 1 &&
           langintern.InternPoolCount(snapshotPool) == 0,
           "resolved call success: repeated release was not idempotent")
    compactFixtureAssertAbortReleased(plan, "resolved-call-success-release-twice")

fn runResolvedCallTargetSourceCase() =
    var csg: ccsg.CompilerCsg
    var plan: lower.LoweringPlanStub
    var err: str
    compactFixtureInit(csg, false)
    compactFixtureAppendResolvedCall(csg, "", "Target")
    assert(!compactFixtureBind(csg, plan, err) &&
           strutil.Contains(err, "invalid resolved-call snapshot row"),
           Fmt"resolved call: expected missing target source failure err={err}")
    compactFixtureAssertReleased(csg, plan, "resolved-call-target-source")
    compactFixtureAssertAbortReleased(plan, "resolved-call-target-source")

fn runResolvedCallFunctionRowsCase() =
    var csg: ccsg.CompilerCsg
    var plan: lower.LoweringPlanStub
    var err: str
    compactFixtureInit(csg, false)
    compactFixtureAppendResolvedCall(csg, "/tmp/missing_target.cheng", "Target")
    csg.semanticGraph.resolvedCallTable.functionRowNext = []
    assert(!compactFixtureBind(csg, plan, err) &&
           strutil.Contains(err, "resolved-call row columns mismatch"),
           Fmt"resolved call rows: expected column failure err={err}")
    compactFixtureAssertReleased(csg, plan, "resolved-call-function-rows")
    compactFixtureAssertAbortReleased(plan, "resolved-call-function-rows")

fn runResolvedCallAdjacencyCase(mode: int32,
                                expectedError: str,
                                label: str) =
    var csg: ccsg.CompilerCsg
    var plan: lower.LoweringPlanStub
    var err: str
    compactFixtureInit(csg, false)
    compactFixtureAppendResolvedCall(csg, "/tmp/missing_target.cheng", "Target")
    if mode == 1:
        csg.semanticGraph.resolvedCallTable.functionRowHeads[0] = -2
    elif mode == 2:
        csg.semanticGraph.resolvedCallTable.functionRowNext[0] = 0
    elif mode == 3:
        csg.semanticGraph.resolvedCallTable.functionIndexes[0] = 1
    elif mode == 4:
        csg.semanticGraph.resolvedCallTable.functionRowHeads[0] = -1
    elif mode == 5:
        csg.semanticGraph.resolvedCallTable.functionRowHeads[1] = 0
    elif mode == 6:
        csg.semanticGraph.resolvedCallTable.functionRowNext[0] = -2
    else:
        panic("adjacency fixture mode invalid")
    assert(!compactFixtureBind(csg, plan, err) &&
           strutil.Contains(err, expectedError),
           Fmt"{label}: expected adjacency failure={expectedError} err={err}")
    compactFixtureAssertReleased(csg, plan, label)
    compactFixtureAssertAbortReleased(plan, label)

fn runResolvedCallMissingTargetCase() =
    var csg: ccsg.CompilerCsg
    var plan: lower.LoweringPlanStub
    var err: str
    compactFixtureInit(csg, false)
    compactFixtureAppendResolvedCall(csg, "/tmp/missing_target.cheng", "Target")
    assert(!compactFixtureBind(csg, plan, err) &&
           strutil.Contains(err, "resolved-call target missing"),
           Fmt"resolved call target: expected exact target failure err={err}")
    compactFixtureAssertReleased(csg, plan, "resolved-call-missing-target")
    compactFixtureAssertAbortReleased(plan, "resolved-call-missing-target")
    assert(!plan.compactExprPayloadReleasedBeforeSourceClosure,
           "resolved call target: abort retained proof scalar")

fn runReusablePlanCase() =
    var firstCsg: ccsg.CompilerCsg
    var secondCsg: ccsg.CompilerCsg
    var plan: lower.LoweringPlanStub
    var err: str
    compactFixtureInit(firstCsg, true)
    compactFixtureAppendResolvedCall(firstCsg,
                                     firstCsg.semanticGraph.sourceTable.sourcePaths[0],
                                     "Other")
    assert(compactFixtureBind(firstCsg, plan, err),
           Fmt"reusable plan: first bind failed {err}")
    let firstIndex = compactFixtureAssertMovedIndex(plan, "reusable-plan-first")
    let firstPool = plan.typedIr.internPool
    let firstSnapshotPool = plan.resolvedCallSnapshot.internPool
    assert(plan.compilerCsgExprSliceSidecar.sourceIndex.len == 1 &&
           plan.resolvedCallSnapshot.sourcePathIds.len == 1,
           "reusable plan: first owned payload missing")
    var retainedPlanFact: texpr.TypedExprFact
    retainedPlanFact.sourcePath = "/tmp/reusable_plan_retained_fact.cheng"
    retainedPlanFact.exprId = "retained-plan-fact"
    texpr.TypedExprFactTableAppendHandBuilt(plan.typedExprFacts, retainedPlanFact)
    let firstFactPool = plan.typedExprFacts.internPool
    compactFixtureInit(secondCsg, true)
    compactFixtureAppendResolvedCall(secondCsg,
                                     secondCsg.semanticGraph.sourceTable.sourcePaths[0],
                                     "Other")
    let freeBeforeSecondBind = system.memFreeCount()
    err = ""
    assert(compactFixtureBind(secondCsg, plan, err),
           Fmt"reusable plan: second bind failed {err}")
    assert(texpr.TypedExprBuildIndexReleaseCount(firstIndex) == 1 &&
           langintern.InternPoolCount(firstPool) == 0 &&
           langintern.InternPoolCount(firstSnapshotPool) == 0 &&
           langintern.InternPoolCount(firstFactPool) == 0 &&
           system.memFreeCount() > freeBeforeSecondBind,
           "reusable plan: replacing output leaked prior owners")
    let secondIndex = compactFixtureAssertMovedIndex(plan, "reusable-plan-second")
    let secondSnapshotPool = plan.resolvedCallSnapshot.internPool
    assert(plan.compilerCsgExprSliceSidecar.sourceIndex.len == 1 &&
           plan.resolvedCallSnapshot.sourcePathIds.len == 1,
           "reusable plan: second owned payload missing")
    lower.LoweringPlanReleaseAfterPrimaryObjectPlan(plan)
    assert(texpr.TypedExprBuildIndexReleaseCount(secondIndex) == 1 &&
           langintern.InternPoolCount(secondSnapshotPool) == 0,
           "reusable plan: final owners not released")
    compactFixtureAssertAbortReleased(plan, "reusable-plan-release")

fn runReusablePlanFailureCase() =
    var firstCsg: ccsg.CompilerCsg
    var failingCsg: ccsg.CompilerCsg
    var plan: lower.LoweringPlanStub
    var err: str
    compactFixtureInit(firstCsg, true)
    compactFixtureAppendResolvedCall(firstCsg,
                                     firstCsg.semanticGraph.sourceTable.sourcePaths[0],
                                     "Other")
    assert(compactFixtureBind(firstCsg, plan, err),
           Fmt"reusable failure: first bind failed {err}")
    let firstIndex = compactFixtureAssertMovedIndex(plan, "reusable-failure-first")
    let firstTypedPool = plan.typedIr.internPool
    let firstSnapshotPool = plan.resolvedCallSnapshot.internPool
    var retainedPlanFact: texpr.TypedExprFact
    retainedPlanFact.sourcePath = "/tmp/reusable_failure_retained_fact.cheng"
    retainedPlanFact.exprId = "retained-plan-fact"
    texpr.TypedExprFactTableAppendHandBuilt(plan.typedExprFacts, retainedPlanFact)
    let firstFactPool = plan.typedExprFacts.internPool
    compactFixtureInit(failingCsg, true)
    failingCsg.semanticGraph.exprSummary = ccsg.CompilerCsgSemanticExprSummary()
    let freeBeforeFailingBind = system.memFreeCount()
    err = ""
    assert(!compactFixtureBind(failingCsg, plan, err) &&
           strutil.Contains(err, "expr-slice totals mismatch"),
           Fmt"reusable failure: expected hard failure err={err}")
    assert(texpr.TypedExprBuildIndexReleaseCount(firstIndex) == 1 &&
           langintern.InternPoolCount(firstTypedPool) == 0 &&
           langintern.InternPoolCount(firstSnapshotPool) == 0 &&
           langintern.InternPoolCount(firstFactPool) == 0 &&
           system.memFreeCount() > freeBeforeFailingBind,
           "reusable failure: prior owners leaked on replacement")
    compactFixtureAssertReleased(failingCsg, plan, "reusable-failure-donor")
    compactFixtureAssertAbortReleased(plan, "reusable-failure-plan")

fn primaryImportLifetimeAppendFunction(plan: var lower.LoweringPlanStub,
                                        sourcePath: str,
                                        withBody: bool) =
    var fnIr: texpr.TypedExprIrFunction
    fnIr.sourcePath = sourcePath
    fnIr.functionName = "Run"
    fnIr.signatureLineNumber = 1
    fnIr.endLineNumber = 4
    fnIr.bodyLineNumber = 2
    fnIr.returnType = "int32"
    fnIr.statementStart = plan.typedIr.statements2_statementIndexs.len
    fnIr.nodeStart = plan.typedIr.nodes2_sourcePathIds.len
    if withBody:
        fnIr.statementCount = 1
        fnIr.nodeCount = 1
        fnIr.returnNodeIndex = fnIr.nodeStart
    else:
        fnIr.returnNodeIndex = -1
    texpr.TypedExprIrAppendFunction(plan.typedIr, fnIr)
    if !withBody:
        return
    var stmt: texpr.TypedExprIrStatement
    stmt.sourcePath = sourcePath
    stmt.functionName = "Run"
    stmt.statementIndex = fnIr.statementStart
    stmt.lineNumber = 2
    stmt.kind = texpr.TypedExprIrStmtLocalDecl
    stmt.bindingName = "value"
    stmt.resultType = "int32"
    stmt.rhsNodeIndex = fnIr.nodeStart
    stmt.assignLvalueNodeIndex = -1
    texpr.TypedExprIrAppendStatement(plan.typedIr, stmt)
    var node: texpr.TypedExprIrNode
    node.resultStructuralTypeId = -1
    node.sourcePath = sourcePath
    node.functionName = "Run"
    node.nodeIndex = fnIr.nodeStart
    node.lineNumber = 2
    node.opKind = texpr.TypedExprIrOpI32Lit
    node.resultType = "int32"
    node.literalText = "1"
    texpr.TypedExprIrAppendNode(plan.typedIr, node)

fn primaryImportLifetimeAppendEdge(plan: var lower.LoweringPlanStub,
                                    qualifier: str,
                                    targetModulePath: str,
                                    targetSourcePath: str) =
    var edge: parser.ImportEdge
    edge.ownerModulePath = "app/main"
    edge.targetModulePath = targetModulePath
    edge.targetSourcePath = targetSourcePath
    edge.importAlias = qualifier
    edge.qualifier = qualifier
    edge.allowsUnqualifiedCall = true
    edge.resolved = true
    lower.LoweringImportGraphAppendEdge(plan, edge)

fn primaryImportLifetimeInit(plan: var lower.LoweringPlanStub,
                              ambiguous: bool) =
    plan.workspaceRoot = "/outside-cwd/workspace"
    plan.packageRoot = plan.workspaceRoot
    plan.primaryObjectIrBuildMode = "object_all_lazy"
    plan.primaryObjectIrReachableFirst = 1
    plan.primaryObjectIrSkippedFunctionCount = 1
    plan.typedIr.internPool = langintern.InternPoolNew()
    lower.LoweringPlanReleaseImportGraphPayload(plan)
    lower.LoweringImportGraphAllocatorBegin(plan)
    primaryImportLifetimeAppendFunction(plan, "dep/runtime.cheng", true)
    primaryImportLifetimeAppendEdge(plan,
                                    "dep",
                                    "dep/runtime",
                                    "/outside-cwd/workspace/dep/runtime.cheng")
    if ambiguous:
        primaryImportLifetimeAppendFunction(plan, "dep2/runtime.cheng", false)
        primaryImportLifetimeAppendEdge(plan,
                                        "dep2",
                                        "dep2/runtime",
                                        "/outside-cwd/workspace/dep2/runtime.cheng")
    lower.LoweringBuildTypedFunctionIndex(plan)
    lower.LoweringBuildImportEdgeIndex(plan)
    var fact: texpr.TypedExprFact
    fact.sourcePath = "dep/runtime.cheng"
    fact.exprId = "primary-import-lifetime"
    texpr.TypedExprFactTableAppendHandBuilt(plan.typedExprFacts, fact)
    var expr: parser.NormalizedExpr
    expr.sourcePath = "dep/runtime.cheng"
    expr.exprId = fact.exprId
    add(plan.exprLayer.exprs, expr)
    add(plan.exprLayer.exprNext, -1)
    plan.exprLayer.sourceCount = 1

fn runPrimaryImportLifetimeCase() =
    var plan: lower.LoweringPlanStub
    primaryImportLifetimeInit(plan, false)
    let factPool = plan.typedExprFacts.internPool
    let currentSourcePath = "/outside-cwd/workspace/app/main.cheng"
    let targetSourcePath = "/outside-cwd/workspace/dep/runtime.cheng"

    lower.LoweringPlanReleasePrePrimaryObjectPayload(plan)
    assert(plan.importEdges.len == 1 &&
           plan.importEdgeIndexOwnerModulePaths.len == 1 &&
           plan.importEdgeIndexEntryEdgeIndexes.len == 1 &&
           plan.importOwnerIndexOwnerModulePaths.len == 1 &&
           plan.typedFunctionIndexEntryIndexes.len > 0 &&
           dense.DenseStoreFunctionCount(plan.typedFunctionDenseStore) == 1 &&
           plan.typedIr.statements2_statementIndexs.len == 1 &&
           plan.typedIr.nodes2_sourcePathIds.len == 1 &&
           texpr.TypedExprFactTableCount(plan.typedExprFacts) == 0 &&
           langintern.InternPoolCount(factPool) == 0 &&
           plan.exprLayer.exprs.len == 0,
           "primary import lifetime: pre-primary release dropped live resolution facts")
    assert(lower.LoweringPlanQualifiedImportTargetSourcePath(plan,
                                                              currentSourcePath,
                                                              "dep") == targetSourcePath &&
           lower.LoweringPlanUnqualifiedImportTargetSourcePath(plan,
                                                                currentSourcePath,
                                                                "Run") == targetSourcePath,
           "primary import lifetime: retained resolver failed relative/absolute target")

    lower.LoweringPlanReleaseAfterPrimaryObjectPlan(plan)
    assert(plan.importEdges.len == 0 &&
           plan.importEdgeIndexOwnerModulePaths.len == 0 &&
           plan.importEdgeIndexQualifiers.len == 0 &&
           plan.importEdgeIndexEntryEdgeIndexes.len == 0 &&
           plan.importEdgeIndexBucketHeads.len == 0 &&
           plan.importEdgeIndexEntryNext.len == 0 &&
           plan.importOwnerIndexOwnerModulePaths.len == 0 &&
           plan.importOwnerIndexEntryEdgeIndexes.len == 0 &&
           plan.importOwnerIndexBucketHeads.len == 0 &&
           plan.importOwnerIndexEntryNext.len == 0 &&
           plan.unqualifiedImportResolveCacheSourcePaths.len == 0 &&
           plan.unqualifiedImportResolveCacheFunctionNames.len == 0 &&
           plan.unqualifiedImportResolveCacheTargetSourcePaths.len == 0 &&
           plan.unqualifiedImportResolveCacheBucketHeads.len == 0 &&
           plan.unqualifiedImportResolveCacheEntryNext.len == 0 &&
           plan.qualifiedImportResolveCacheSourcePaths.len == 0 &&
           plan.qualifiedImportResolveCacheQualifiers.len == 0 &&
           plan.qualifiedImportResolveCacheTargetSourcePaths.len == 0 &&
           plan.qualifiedImportResolveCacheBucketHeads.len == 0 &&
           plan.qualifiedImportResolveCacheEntryNext.len == 0 &&
           plan.typedFunctionIndexEntryIndexes.len == 0 &&
           dense.DenseStoreFunctionCount(plan.typedFunctionDenseStore) == 0 &&
           plan.typedIr.functions2_functionNameIds.len == 0 &&
           plan.typedIr.statements2_statementIndexs.len == 0 &&
           plan.typedIr.nodes2_sourcePathIds.len == 0,
           "primary import lifetime: post-primary release retained resolution facts")

    var ambiguousPlan: lower.LoweringPlanStub
    primaryImportLifetimeInit(ambiguousPlan, true)
    lower.LoweringPlanReleasePrePrimaryObjectPayload(ambiguousPlan)
    assert(lower.LoweringPlanQualifiedImportTargetSourcePath(ambiguousPlan,
                                                              currentSourcePath,
                                                              "dep") == targetSourcePath &&
           lower.LoweringPlanQualifiedImportTargetSourcePath(ambiguousPlan,
                                                              currentSourcePath,
                                                              "dep2") == "/outside-cwd/workspace/dep2/runtime.cheng" &&
           lower.LoweringPlanUnqualifiedImportTargetSourcePath(ambiguousPlan,
                                                                currentSourcePath,
                                                                "Run") == "",
           "primary import lifetime: ambiguity or qualified resolution drift")
    lower.LoweringPlanReleaseAfterPrimaryObjectPlan(ambiguousPlan)

fn main(): int32 =
    runNonemptySummaryCase()
    runMissingSummaryCase()
    runContradictorySummaryCase()
    runDeclarationOnlyCase()
    runLegacyTypedFactsCase()
    runResolvedCallSuccessCase()
    runResolvedCallTargetSourceCase()
    runResolvedCallFunctionRowsCase()
    runResolvedCallAdjacencyCase(1, "adjacency head out of range", "resolved-call-invalid-head")
    runResolvedCallAdjacencyCase(2, "adjacency duplicate or cycle", "resolved-call-cycle")
    runResolvedCallAdjacencyCase(3, "adjacency owner mismatch", "resolved-call-owner-mismatch")
    runResolvedCallAdjacencyCase(4, "row missing from function adjacency", "resolved-call-orphan")
    runResolvedCallAdjacencyCase(5, "adjacency duplicate or cycle", "resolved-call-duplicate")
    runResolvedCallAdjacencyCase(6, "adjacency next out of range", "resolved-call-invalid-next")
    runResolvedCallMissingTargetCase()
    runReusablePlanCase()
    runReusablePlanFailureCase()
    runPrimaryImportLifetimeCase()
    os.WriteLine(os.GetStdout(),
                 "lowering_compact_expr_bind_smoke ok cases=18")
    return 0
