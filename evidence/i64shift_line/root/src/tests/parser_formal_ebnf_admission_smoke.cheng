import std/result
import std/strutils as strutil
import cheng/core/lang/parser as parser
import cheng/core/tooling/compiler_parser_receipt as parser_receipt

fn ParserFormalEbnfAssertReceipt(label: str, source: str) =
    var layer: parser.NormalizedExprLayer
    var err: str
    assert(parser.ParserReadNormalizedExprLayerFromText(
               Fmt"/workspace/{label}.cheng",
               source,
               layer,
               err),
           Fmt"parser formal EBNF: positive parse failed label={label} err={err}")
    let driverHash =
        parser_receipt.ParserSpanReceiptTextSha256Hex(
            "parser-formal-ebnf-admission-driver")
    let sourceHash =
        parser_receipt.ParserSpanReceiptTextSha256Hex(source)
    let manifest = parser_receipt.ParserSpanReceiptToolchainManifestBuild(
        "/workspace/cheng",
        driverHash,
        "/workspace",
        "/workspace")
    assert(IsOk(manifest),
           Fmt"parser formal EBNF: manifest failed label={label}")
    let receipt = parser_receipt.ParserSpanReceiptJsonBuild(
        layer,
        Fmt"src/{label}.cheng",
        Fmt"/workspace/{label}.cheng",
        sourceHash,
        driverHash,
        Value(manifest))
    assert(IsOk(receipt) &&
           strutil.Contains(Value(receipt), sourceHash),
           Fmt"parser formal EBNF: receipt failed label={label}")
    parser.NormalizedExprLayerReset(layer)

fn ParserFormalEbnfAssertReject(
        label: str,
        source: str,
        diagnosticCode: str) =
    var tree: parser.ParserValueExprTree
    var err: str
    let accepted = parser.ParserValueExprReadTreeFromText(
        source, tree, err)
    if accepted:
        parser.ParserValueExprTreeRelease(tree)
    assert(!accepted && strutil.Contains(err, diagnosticCode),
           Fmt"parser formal EBNF: negative survived label={label} expected={diagnosticCode} err={err}")

fn main() =
    ParserFormalEbnfAssertReceipt(
        "public_operator_positive",
        "fn main(): int32 =\n    let a = 2\n    let b = 3\n    let product = a * b\n    let bits = a & b\n    let field = value.field\n    return product + bits\n")
    ParserFormalEbnfAssertReceipt(
        "case_statement_positive",
        "fn main(): int32 =\n    let value = 0\n    case value:\n        of 0: return 0\n    return 1\n")
    ParserFormalEbnfAssertReceipt(
        "case_expression_positive",
        "fn main(): int32 =\n    let value = 0\n    let result = case value:\n        of 0: 1\n    return result\n")
    ParserFormalEbnfAssertReceipt(
        "case_statement_colonless_positive",
        "fn main(): int32 =\n    let value = 0\n    case value\n        of 0: return 0\n    return 1\n")
    ParserFormalEbnfAssertReceipt(
        "case_expression_colonless_positive",
        "fn main(): int32 =\n    let value = 0\n    let result = case value\n        of 0: 1\n    return result\n")
    ParserFormalEbnfAssertReceipt(
        "case_statement_unindented_branch_positive",
        "fn main(): int32 =\n    let value = 0\n    case value\n    of 0: return 0\n    else: return 1\n")
    ParserFormalEbnfAssertReceipt(
        "implicit_object_inheritance_colon_positive",
        "type Base =\n    value: int32\ntype Derived = of Base:\n    local: int32\n")
    ParserFormalEbnfAssertReceipt(
        "explicit_object_inheritance_colon_positive",
        "type Base =\n    value: int32\ntype Derived = object of Base:\n    local: int32\n")
    ParserFormalEbnfAssertReceipt(
        "nested_ref_object_fields_positive",
        "type Node = ref object:\n    value: int32\n    child: ref object:\n        next: ref object:\n            value: int32\n")
    ParserFormalEbnfAssertReceipt(
        "empty_enum_positive",
        "type Empty = enum\n")
    ParserFormalEbnfAssertReceipt(
        "case_entry_function_expression_positive",
        "fn main(): int32 =\n    case 0\n    of (fn(): int32 = 1):\n        return 1\n    return 0\n")
    ParserFormalEbnfAssertReceipt(
        "nested_function_literals_positive",
        "fn main(): int32 =\n    let fnlit = fn(): int32 = fn(): int32 = fn(): int32 = fn(): int32 = 1\n    let itlit = iterator(): int32 = iterator(): int32 = iterator(): int32 = iterator(): int32 = 1\n    return 0\n")
    ParserFormalEbnfAssertReceipt(
        "nested_comprehensions_positive",
        "fn main(): int32 =\n    let comprs = [[[[w for w in ws] for x in xs] for y in ys] for z in zs]\n    let prefix = for q in xs: (for r in ys: (for s in zs: (for t in ws: t)))\n    return 0\n")
    ParserFormalEbnfAssertReceipt(
        "nested_match_arm_suite_positive",
        "fn main(): int32 =\n    match 0:\n        0 => match 0:\n            1 => return 1\n            _ => return 2\n        _ => return 0\n    return 0\n")
    ParserFormalEbnfAssertReceipt(
        "nested_case_arm_suite_positive",
        "fn main(): int32 =\n    case 0:\n        of 0: case 0:\n            of 1: return 1\n            else: return 2\n        else: return 0\n    return 0\n")
    ParserFormalEbnfAssertReceipt(
        "grouped_function_literal_call_positive",
        "fn main(): int32 =\n    return (fn(): int32 = 1)()\n")
    ParserFormalEbnfAssertReceipt(
        "nested_parameter_default_literal_positive",
        "fn p0(x: int32 = (fn(): int32 = fn p1(y: int32 = (fn(): int32 = 1)()) = y)()) = x\n")

    ParserFormalEbnfAssertReject(
        "pointer_member",
        "fn main(): int32 =\n    return value->field\n",
        "ZRPC_PUBLIC_POINTER_MEMBER_FORBIDDEN")
    ParserFormalEbnfAssertReject(
        "dereference",
        "fn main(): int32 =\n    let p = 1\n    return *p\n",
        "ZRPC_PUBLIC_DEREFERENCE_FORBIDDEN")
    ParserFormalEbnfAssertReceipt(
        "address_of_place_positive",
        "fn main(): int32 =\n    let value = 1\n    return &value\n")
    ParserFormalEbnfAssertReject(
        "address_of_rvalue",
        "fn main(): int32 =\n    return &1\n",
        "ZRPC_PUBLIC_ADDRESS_OF_FORBIDDEN")
    ParserFormalEbnfAssertReject(
        "raw_pointer_type",
        "type Bad = int32*\n",
        "ZRPC_PUBLIC_RAW_POINTER_TYPE_FORBIDDEN")
    ParserFormalEbnfAssertReject(
        "raw_pointer_conversion",
        "fn main(): int32 =\n    return int32*(1)\n",
        "ZRPC_PUBLIC_RAW_POINTER_TYPE_FORBIDDEN")
    ParserFormalEbnfAssertReject(
        "empty_case_statement",
        "fn main(): int32 =\n    let value = 0\n    case value:\n    return 1\n",
        "PARSER_EMPTY_CASE_STATEMENT_BRANCHES")
    ParserFormalEbnfAssertReject(
        "empty_case_expression",
        "fn main(): int32 =\n    let value = 0\n    let result = case value:\n    return result\n",
        "PARSER_EMPTY_CASE_EXPRESSION_BRANCHES")
    ParserFormalEbnfAssertReject(
        "empty_suite",
        "fn main(): int32 =\n",
        "PARSER_EMPTY_SUITE_FORBIDDEN")
    ParserFormalEbnfAssertReject(
        "empty_match",
        "fn main(): int32 =\n    match 0:\n",
        "PARSER_EMPTY_SUITE_FORBIDDEN")
    ParserFormalEbnfAssertReject(
        "empty_object_body",
        "type Base =\n    value: int32\ntype Bad = of Base:\n",
        "parser type syntax: object or enum body is empty")

    echo("parser_formal_ebnf_positive_receipts=17")
    echo("parser_formal_ebnf_negative_admissions=10")
    echo("parser_formal_ebnf_ref_object_group=deferred_current_plan_conflict")
    echo("PARSER_FORMAL_EBNF_ADMISSION_OK")
