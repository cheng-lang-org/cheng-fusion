import std/os
import std/strings
import cheng/core/tooling/path as chengpath

fn LifecycleFind(text: str, needle: str): int32 =
    if len(needle) <= 0:
        return 0
    if len(text) < len(needle):
        return -1
    let limit = len(text) - len(needle)
    for i in 0..limit:
        var matched = true
        for j in 0..<len(needle):
            if text[i + j] != needle[j]:
                matched = false
                break
        if matched:
            return i
    return -1

fn LifecycleCount(text: str, needle: str): int32 =
    if len(needle) <= 0 || len(text) < len(needle):
        return 0
    var count: int32
    let candidateCount = len(text) - len(needle) + 1
    for i in 0..<candidateCount:
        var matched = true
        for j in 0..<len(needle):
            if text[i + j] != needle[j]:
                matched = false
                break
        if matched:
            count = count + 1
    return count

fn LifecycleRequireOrdered(text: str,
                           first: str,
                           second: str,
                           message: str) =
    let firstAt = LifecycleFind(text, first)
    let secondAt = LifecycleFind(text, second)
    assert(firstAt >= 0 && secondAt > firstAt, message)

fn main(): int32 =
    let root = os.GetCurrentDir()
    let planText = chengpath.ReadTextFile(root,
                                          "src/core/backend/system_link_plan.cheng")
    let execText = chengpath.ReadTextFile(root,
                                          "src/core/backend/system_link_exec.cheng")
    let runtimeText = chengpath.ReadTextFile(
        root,
        "src/core/backend/system_link_exec_runtime.cheng")
    let loweringText = chengpath.ReadTextFile(root,
                                              "src/core/backend/lowering_plan.cheng")
    assert(len(planText) > 0 && len(execText) > 0 && len(runtimeText) > 0 &&
           len(loweringText) > 0,
           " system link lifecycle: source inputs")

    assert(LifecycleCount(planText,
                          "NormalizedExprLayerClone(parsed.normalizedExprLayer)") == 0,
           " system link lifecycle: parser layer must not clone")
    assert(LifecycleCount(planText,
                          "parser.NormalizedExprLayerMoveInto(plan.exprLayer,") == 1,
           " system link lifecycle: parser layer moves exactly once")
    assert(strings.StrContains(planText, "exprLayerCloneCount: int32") &&
           strings.StrContains(planText, "exprLayerMoveCount: int32") &&
           strings.StrContains(planText, "expr_surface_transfer_kind\", \"move"),
           " system link lifecycle: move proof fields")

    assert(LifecycleCount(execText,
                          "lower.LoweringPlanReleasePrePrimaryObjectPayload(loweringPlan)") == 1,
           " system link lifecycle: pre-primary release call count")
    assert(LifecycleCount(execText,
                          "lower.LoweringPlanReleaseAfterPrimaryObjectPlan(loweringPlan)") == 1,
           " system link lifecycle: post-primary release call count")
    assert(LifecycleCount(execText,
                          "LoweringPlanReleaseLineMapUnusedPayload(plan.loweringPlan)") == 0,
           " system link lifecycle: no overlapping terminal release")
    assert(LifecycleCount(runtimeText,
                          "lower.LoweringPlanReleaseWithReceipt(") == 1 &&
           LifecycleCount(runtimeText,
                          "lower.LoweringPlanReleaseReceiptConsumeStrictInto(") == 1 &&
           LifecycleCount(runtimeText,
                          "lower.LoweringPlanReleaseAllPayload(plan.loweringPlan)") == 0,
           " system link lifecycle: sole strict terminal owner destruction")

    assert(LifecycleCount(execText,
                          "ccsg.CompilerCsgReleaseBackendInputPayload(compilerCsg)") == 0 &&
           LifecycleCount(execText,
                          "lower.LoweringAbortCompilerCsgBind(compilerCsg,") == 1,
           " system link lifecycle: lowering remains the sole csg release owner")
    assert(LifecycleCount(execText,
                          "SystemLinkExecReleaseSystemLinkCompilerInputOnAbort(linkPlan,") == 1 &&
           strings.StrContains(execText,
                               "system-link compiler input abort release without ownership"),
           " system link lifecycle: system-link failure owner releases exactly once")
    LifecycleRequireOrdered(execText,
                            "linkPlanCompilerInputOwned = true",
                            "if !SystemLinkExecSourceBundleReceiptCaptureInto(",
                            " system link lifecycle: system-link failure cleanup armed")
    LifecycleRequireOrdered(execText,
                            "if !SystemLinkExecSourceBundleReceiptCaptureInto(",
                            "ccsg.BuildCompilerCsgConsumePortableReceiptWithSourceBundleOwnerInto(",
                            " system link lifecycle: source receipt captured before csg consume")
    assert(LifecycleCount(
               execText,
               "slplan.SystemLinkPlanSourceBundleBindingStructuralValidInto(") == 2 &&
           LifecycleCount(
               execText,
               "slplan.SystemLinkPlanSourceBundleBindingValidInto(") == 0,
           " system link lifecycle: compact receipt phase must not reopen source files")
    LifecycleRequireOrdered(execText,
                            "compilerCsgNeedsAbortRelease = true",
                            "if !SystemLinkExecExactFunctionCoverageFromCompilerCsgInto(",
                            " system link lifecycle: early failure cleanup armed")
    LifecycleRequireOrdered(execText,
                            "let loweringPlanOk =",
                            "\n    compilerCsgNeedsAbortRelease = false",
                            " system link lifecycle: lowering owns release before defer disarm")
    assert(strings.StrContains(loweringText,
                               "fn LoweringAbortCompilerCsgBind(") &&
           strings.StrContains(loweringText,
                               "LoweringPlanReleaseAllPayload(plan)") &&
           strings.StrContains(loweringText,
                               "LoweringReleaseCompilerCsgAfterBind(compilerCsg, plan)"),
           " system link lifecycle: lowering failure cleanup contract")

    assert(strings.StrContains(execText,
                               "system-link expression payload consumed more than once") &&
           strings.StrContains(execText,
                               "CompilerCSG backend payload released more than once") &&
           strings.StrContains(execText,
                               "lowering pre-primary payload released more than once") &&
           strings.StrContains(execText,
                               "lowering post-primary payload released more than once") &&
           strings.StrContains(execText,
                               "lowering terminal payload released more than once"),
           " system link lifecycle: duplicate releases hard fail")
    assert(strings.StrContains(execText,
                               "fn SystemLinkExecPayloadLifecycleTryTransition(") &&
           strings.StrContains(execText,
                               "fn SystemLinkExecPayloadLifecycleTransition(") &&
           LifecycleCount(execText,
                          "SystemLinkExecPayloadLifecycleRequireTransitionReady(") == 5 &&
           LifecycleCount(execText,
                          "SystemLinkExecPayloadLifecycleTransition(") == 5 &&
           strings.StrContains(execText,
                               "panic(transitionErr)"),
           " system link lifecycle: production and tests share transition contract")

    assert(!strings.StrContains(execText, "immutableReportSnapshot") &&
           !strings.StrContains(execText, "snapshotText") &&
           strings.StrContains(execText,
                               "sourceBundleReceipt: SystemLinkExecSourceBundleReceipt") &&
           strings.StrContains(execText,
                               "SystemLinkExecSourceBundleReceiptFixedBytes = int64(312)") &&
           strings.StrContains(execText,
                               "source_bundle_entry_identity_seal") &&
           strings.StrContains(execText,
                               "source_bundle_receipt_managed_live_bytes") &&
           strings.StrContains(execText,
                               "execPlan.sourceBundleReceipt = sourceBundleReceipt") &&
           !strings.StrContains(execText,
                                "layout.FixedBytes32Hex(plan.sourceBundleCid)") &&
           strings.StrContains(execText,
                               "plan.sourceBundleReceipt.sourceBundleCid") &&
           LifecycleCount(execText,
                          "sourceBundleEntrySourceIndex != -1") == 2 &&
           strings.StrContains(execText,
                               "linkPlan.sourceBundleEntrySourceIndex = -1"),
           " system link lifecycle: fixed source receipt replaces retained path snapshot")

    assert(LifecycleCount(execText,
                          "SystemLinkExecPhaseMemoryRequireStructuredNonIncrease(") == 3,
           " system link lifecycle: release snapshots are monotonic")
    assert(strings.StrContains(execText,
                               "csg_to_lowering_and_backend_release") &&
           LifecycleCount(execText, "\"csg_backend_release\"") == 0 &&
           LifecycleCount(execText, "csgBackendRelease:") == 0,
           " system link lifecycle: phase name matches real release")

    assert(LifecycleCount(execText,
                          "\"exec_retained_payload_approx_bytes\"") == 1 &&
           strings.StrContains(execText,
                               "exec_retained_payload_approx_bytes_scope") &&
           strings.StrContains(execText,
                               "diagnostic_non_authoritative_not_rss") &&
           strings.StrContains(execText,
                               "exec_retained_payload_approx_bytes_gate_eligible") &&
           strings.StrContains(execText,
                               "exec_retained_payload_diagnostic_estimate_bytes") &&
           strings.StrContains(execText,
                               "non_authoritative_item_estimate_not_rss") &&
           strings.StrContains(execText,
                               "exec_retained_payload_diagnostic_estimate_gate_eligible\",\n                                   \"0"),
           " system link lifecycle: approximate bytes are diagnostic only")
    assert(strings.StrContains(execText,
                               "phase_memory_structured_measurement_scope") &&
           strings.StrContains(execText,
                               "phase_memory_structured_is_rss\", \"0") &&
           strings.StrContains(execText,
                               "CompilerCsgRetainedCapacityBytes") &&
           strings.StrContains(execText,
                               "LoweringPlanStructuredLiveBytes") &&
           strings.StrContains(execText,
                               "PrimaryObjectPlanStructuredLiveBytes"),
           " system link lifecycle: module ledgers are structured diagnostics, not RSS")
    return 0
