# csg_normalize_reorder_invariance_smoke.cheng
#
# Oracle for the per-def semantic-cid normalization pass (正典 §11.6 P1 首片).
#
# 证明: 同一逻辑 CSG 图在源中 def 重排后,
#   (旧) CompilerCsgCanonicalGraphCid  —— 岔开 (重排敏感, 位置性 nodeId/边端点/插入序)
#   (新) CsgNormalizedGraphCid         —— 收敛 (内容寻址, 重排不变)
# 这一对 = “旧岔开 / 新收敛” 对照, 证明新 pass 修了旧的修不了的重排敏感性。
#
# 诚实边界 (α 等价): 本 cid 层 factText=函数名，overload 身份使用独立结构化字段；
# 函数体与局部变量名仍不进入本层。改 symbolText/factText/semantic identity 都是 def
# 语义变化，normalized cid 必须变化。见断言 A4/A4b。

import std/system
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/tooling/csg_normalize as csgnorm
import cheng/std/bytes_layout as layout

# 同逻辑图, 插入序 A: pkg, mFoo, mBar, mBaz, sFoo, sBar, sBaz。
# 结构: package 根; 三 module (foo/bar/baz); 每 module 一 symbol。
#   互递归对: mFoo <-> mBar 互相 import (module import 环);
#   单叶:     mBaz/sBaz 无出向 import;
#   调用链:   mFoo -> mBaz。
# sFooSymbol 参数化, 供 A4 制造“不同语义源”。
fn buildGraphA(nodes: var ccsg.CompilerCsgNode[], edges: var ccsg.CompilerCsgEdge[], sFooSymbol: str) =
    let pkg = ccsg.CompilerCsgAddNode(nodes, ccsg.CompilerCsgNodeKindPackage, 0, "cheng", "cheng", "cheng", 0, 0, 0, 0, 0, 0, "")
    let mFoo = ccsg.CompilerCsgAddNode(nodes, ccsg.CompilerCsgNodeKindModule, pkg, "cheng/foo", "cheng/foo", "cheng/foo", 0, 0, 0, 0, 0, 0, "")
    let mBar = ccsg.CompilerCsgAddNode(nodes, ccsg.CompilerCsgNodeKindModule, pkg, "cheng/bar", "cheng/bar", "cheng/bar", 0, 0, 0, 0, 0, 0, "")
    let mBaz = ccsg.CompilerCsgAddNode(nodes, ccsg.CompilerCsgNodeKindModule, pkg, "cheng/baz", "cheng/baz", "cheng/baz", 0, 0, 0, 0, 0, 0, "")
    let sFoo = ccsg.CompilerCsgAddNode(nodes, ccsg.CompilerCsgNodeKindSymbol, mFoo, "cheng/foo", sFooSymbol, "a", 0, 0, 0, 0, 0, 0, "")
    let sBar = ccsg.CompilerCsgAddNode(nodes, ccsg.CompilerCsgNodeKindSymbol, mBar, "cheng/bar", "cheng/bar::b", "b", 0, 0, 0, 0, 0, 0, "")
    let sBaz = ccsg.CompilerCsgAddNode(nodes, ccsg.CompilerCsgNodeKindSymbol, mBaz, "cheng/baz", "cheng/baz::c", "c", 0, 0, 0, 0, 0, 0, "")
    ccsg.CompilerCsgAddEdge(edges, pkg, mFoo, ccsg.CompilerCsgEdgeKindContains)
    ccsg.CompilerCsgAddEdge(edges, pkg, mBar, ccsg.CompilerCsgEdgeKindContains)
    ccsg.CompilerCsgAddEdge(edges, pkg, mBaz, ccsg.CompilerCsgEdgeKindContains)
    ccsg.CompilerCsgAddEdge(edges, mFoo, sFoo, ccsg.CompilerCsgEdgeKindContains)
    ccsg.CompilerCsgAddEdge(edges, mBar, sBar, ccsg.CompilerCsgEdgeKindContains)
    ccsg.CompilerCsgAddEdge(edges, mBaz, sBaz, ccsg.CompilerCsgEdgeKindContains)
    ccsg.CompilerCsgAddEdge(edges, mFoo, mBar, ccsg.CompilerCsgEdgeKindImports)
    ccsg.CompilerCsgAddEdge(edges, mBar, mFoo, ccsg.CompilerCsgEdgeKindImports)
    ccsg.CompilerCsgAddEdge(edges, mFoo, mBaz, ccsg.CompilerCsgEdgeKindImports)

# 同逻辑图, 插入序 B: pkg, mBaz, mBar, mFoo, sBaz, sBar, sFoo (module/symbol 顺序颠倒),
# 边插入序也颠倒。语义与 A 完全相同, 仅 def 排布不同。
fn buildGraphB(nodes: var ccsg.CompilerCsgNode[], edges: var ccsg.CompilerCsgEdge[]) =
    let pkg = ccsg.CompilerCsgAddNode(nodes, ccsg.CompilerCsgNodeKindPackage, 0, "cheng", "cheng", "cheng", 0, 0, 0, 0, 0, 0, "")
    let mBaz = ccsg.CompilerCsgAddNode(nodes, ccsg.CompilerCsgNodeKindModule, pkg, "cheng/baz", "cheng/baz", "cheng/baz", 0, 0, 0, 0, 0, 0, "")
    let mBar = ccsg.CompilerCsgAddNode(nodes, ccsg.CompilerCsgNodeKindModule, pkg, "cheng/bar", "cheng/bar", "cheng/bar", 0, 0, 0, 0, 0, 0, "")
    let mFoo = ccsg.CompilerCsgAddNode(nodes, ccsg.CompilerCsgNodeKindModule, pkg, "cheng/foo", "cheng/foo", "cheng/foo", 0, 0, 0, 0, 0, 0, "")
    let sBaz = ccsg.CompilerCsgAddNode(nodes, ccsg.CompilerCsgNodeKindSymbol, mBaz, "cheng/baz", "cheng/baz::c", "c", 0, 0, 0, 0, 0, 0, "")
    let sBar = ccsg.CompilerCsgAddNode(nodes, ccsg.CompilerCsgNodeKindSymbol, mBar, "cheng/bar", "cheng/bar::b", "b", 0, 0, 0, 0, 0, 0, "")
    let sFoo = ccsg.CompilerCsgAddNode(nodes, ccsg.CompilerCsgNodeKindSymbol, mFoo, "cheng/foo", "cheng/foo::a", "a", 0, 0, 0, 0, 0, 0, "")
    ccsg.CompilerCsgAddEdge(edges, mFoo, mBaz, ccsg.CompilerCsgEdgeKindImports)
    ccsg.CompilerCsgAddEdge(edges, mBar, mFoo, ccsg.CompilerCsgEdgeKindImports)
    ccsg.CompilerCsgAddEdge(edges, mFoo, mBar, ccsg.CompilerCsgEdgeKindImports)
    ccsg.CompilerCsgAddEdge(edges, mBaz, sBaz, ccsg.CompilerCsgEdgeKindContains)
    ccsg.CompilerCsgAddEdge(edges, mBar, sBar, ccsg.CompilerCsgEdgeKindContains)
    ccsg.CompilerCsgAddEdge(edges, mFoo, sFoo, ccsg.CompilerCsgEdgeKindContains)
    ccsg.CompilerCsgAddEdge(edges, pkg, mBaz, ccsg.CompilerCsgEdgeKindContains)
    ccsg.CompilerCsgAddEdge(edges, pkg, mBar, ccsg.CompilerCsgEdgeKindContains)
    ccsg.CompilerCsgAddEdge(edges, pkg, mFoo, ccsg.CompilerCsgEdgeKindContains)

fn findNodeIndexBySymbolText(nodes: var ccsg.CompilerCsgNode[], text: str): int32 =
    for i in 0..<nodes.len:
        if nodes[i].symbolText == text:
            return i
    panic("smoke: node with symbolText not found: " + text)
    return -1

fn setFunctionSemanticIdentity(nodes: var ccsg.CompilerCsgNode[],
                               symbolText: str,
                               source: str,
                               declarationLine: int32,
                               paramTypeJoin: str,
                               returnType: str) =
    let nodeIndex = findNodeIndexBySymbolText(nodes, symbolText)
    nodes[nodeIndex].semanticSource = source
    nodes[nodeIndex].semanticDeclarationLineIndex = declarationLine
    nodes[nodeIndex].semanticParamTypeJoin = paramTypeJoin
    nodes[nodeIndex].semanticReturnType = returnType
    nodes[nodeIndex].semanticSignatureComplete = 1

fn oldCanonicalCid(packageId: str, nodes: var ccsg.CompilerCsgNode[], edges: var ccsg.CompilerCsgEdge[]): layout.FixedBytes32 =
    return ccsg.CompilerCsgCanonicalGraphCid(packageId,
                                             nodes,
                                             edges)

# 合成 owner 环夹具 (刻意的 2-cycle: X owns Y 且 Y owns X)。有效 CSG 的 owner 是严格树,
# 永不出现此形; 但通用 Tarjan 引擎的 component-local 序号解环路径必须对它确定且重排不变。
# 这是对引擎该分支的直接压力测试, 非真实 CSG 数据。ownerNodeId 用预测的 nodeId 制造环。
fn buildOwnerCycleXY(nodes: var ccsg.CompilerCsgNode[]) =
    # 插入序 X 先: X=id1(owner=2), Y=id2(owner=1)
    let _ = ccsg.CompilerCsgAddNode(nodes, ccsg.CompilerCsgNodeKindSymbol, 2, "modX", "X", "fx", 0, 0, 0, 0, 0, 0, "")
    let _ = ccsg.CompilerCsgAddNode(nodes, ccsg.CompilerCsgNodeKindSymbol, 1, "modY", "Y", "fy", 0, 0, 0, 0, 0, 0, "")

fn buildOwnerCycleYX(nodes: var ccsg.CompilerCsgNode[]) =
    # 插入序 Y 先: Y=id1(owner=2), X=id2(owner=1) —— 同语义环, 排布颠倒
    let _ = ccsg.CompilerCsgAddNode(nodes, ccsg.CompilerCsgNodeKindSymbol, 2, "modY", "Y", "fy", 0, 0, 0, 0, 0, 0, "")
    let _ = ccsg.CompilerCsgAddNode(nodes, ccsg.CompilerCsgNodeKindSymbol, 1, "modX", "X", "fx", 0, 0, 0, 0, 0, 0, "")

# 合成 owner 3-cycle (刻意互递归三元环: X owns Y, Y owns Z, Z owns X)。压测通用 Tarjan
# size-3 component 的 component-local 解环: 确定性 + 重排不变 (非真实 CSG 数据, owner 严格树)。
fn buildOwnerTriXYZ(nodes: var ccsg.CompilerCsgNode[]) =
    # 插入序 X,Y,Z: X=id1 owner=2(Y), Y=id2 owner=3(Z), Z=id3 owner=1(X)
    let _ = ccsg.CompilerCsgAddNode(nodes, ccsg.CompilerCsgNodeKindSymbol, 2, "modX", "TX", "fx", 0, 0, 0, 0, 0, 0, "")
    let _ = ccsg.CompilerCsgAddNode(nodes, ccsg.CompilerCsgNodeKindSymbol, 3, "modY", "TY", "fy", 0, 0, 0, 0, 0, 0, "")
    let _ = ccsg.CompilerCsgAddNode(nodes, ccsg.CompilerCsgNodeKindSymbol, 1, "modZ", "TZ", "fz", 0, 0, 0, 0, 0, 0, "")

fn buildOwnerTriZXY(nodes: var ccsg.CompilerCsgNode[]) =
    # 同环, 插入序 Z,X,Y: Z=id1 owner=2(X), X=id2 owner=3(Y), Y=id3 owner=1(Z)
    let _ = ccsg.CompilerCsgAddNode(nodes, ccsg.CompilerCsgNodeKindSymbol, 2, "modZ", "TZ", "fz", 0, 0, 0, 0, 0, 0, "")
    let _ = ccsg.CompilerCsgAddNode(nodes, ccsg.CompilerCsgNodeKindSymbol, 3, "modX", "TX", "fx", 0, 0, 0, 0, 0, 0, "")
    let _ = ccsg.CompilerCsgAddNode(nodes, ccsg.CompilerCsgNodeKindSymbol, 1, "modY", "TY", "fy", 0, 0, 0, 0, 0, 0, "")

# B 的插入序, sBar 的 symbolText 参数化 (warm-incremental: 只改一个 def 语义)。
fn buildGraphReordered(nodes: var ccsg.CompilerCsgNode[], edges: var ccsg.CompilerCsgEdge[], sBarSymbol: str) =
    let pkg = ccsg.CompilerCsgAddNode(nodes, ccsg.CompilerCsgNodeKindPackage, 0, "cheng", "cheng", "cheng", 0, 0, 0, 0, 0, 0, "")
    let mBaz = ccsg.CompilerCsgAddNode(nodes, ccsg.CompilerCsgNodeKindModule, pkg, "cheng/baz", "cheng/baz", "cheng/baz", 0, 0, 0, 0, 0, 0, "")
    let mBar = ccsg.CompilerCsgAddNode(nodes, ccsg.CompilerCsgNodeKindModule, pkg, "cheng/bar", "cheng/bar", "cheng/bar", 0, 0, 0, 0, 0, 0, "")
    let mFoo = ccsg.CompilerCsgAddNode(nodes, ccsg.CompilerCsgNodeKindModule, pkg, "cheng/foo", "cheng/foo", "cheng/foo", 0, 0, 0, 0, 0, 0, "")
    let sBaz = ccsg.CompilerCsgAddNode(nodes, ccsg.CompilerCsgNodeKindSymbol, mBaz, "cheng/baz", "cheng/baz::c", "c", 0, 0, 0, 0, 0, 0, "")
    let sBar = ccsg.CompilerCsgAddNode(nodes, ccsg.CompilerCsgNodeKindSymbol, mBar, "cheng/bar", sBarSymbol, "b", 0, 0, 0, 0, 0, 0, "")
    let sFoo = ccsg.CompilerCsgAddNode(nodes, ccsg.CompilerCsgNodeKindSymbol, mFoo, "cheng/foo", "cheng/foo::a", "a", 0, 0, 0, 0, 0, 0, "")
    ccsg.CompilerCsgAddEdge(edges, mFoo, mBaz, ccsg.CompilerCsgEdgeKindImports)
    ccsg.CompilerCsgAddEdge(edges, mBar, mFoo, ccsg.CompilerCsgEdgeKindImports)
    ccsg.CompilerCsgAddEdge(edges, mFoo, mBar, ccsg.CompilerCsgEdgeKindImports)
    ccsg.CompilerCsgAddEdge(edges, mBaz, sBaz, ccsg.CompilerCsgEdgeKindContains)
    ccsg.CompilerCsgAddEdge(edges, mBar, sBar, ccsg.CompilerCsgEdgeKindContains)
    ccsg.CompilerCsgAddEdge(edges, mFoo, sFoo, ccsg.CompilerCsgEdgeKindContains)
    ccsg.CompilerCsgAddEdge(edges, pkg, mBaz, ccsg.CompilerCsgEdgeKindContains)
    ccsg.CompilerCsgAddEdge(edges, pkg, mBar, ccsg.CompilerCsgEdgeKindContains)
    ccsg.CompilerCsgAddEdge(edges, pkg, mFoo, ccsg.CompilerCsgEdgeKindContains)

fn main(): int32 =
    # ============ 主对照: A/B 重排, 旧岔开 / 新收敛 ============
    var nodesA: ccsg.CompilerCsgNode[]
    var edgesA: ccsg.CompilerCsgEdge[]
    buildGraphA(nodesA, edgesA, "cheng/foo::a")

    var nodesB: ccsg.CompilerCsgNode[]
    var edgesB: ccsg.CompilerCsgEdge[]
    buildGraphB(nodesB, edgesB)

    assert(nodesA.len == 7, " graph A has 7 nodes")
    assert(nodesB.len == 7, " graph B has 7 nodes")
    assert(edgesA.len == 9, " graph A has 9 edges")
    assert(edgesB.len == 9, " graph B has 9 edges")

    # --- A1 (复现旧 bug): 旧 canonical cid 因重排岔开 ---
    let oldA = oldCanonicalCid("cheng", nodesA, edgesA)
    let oldB = oldCanonicalCid("cheng", nodesB, edgesB)
    assert(!layout.FixedBytes32Equal(oldA, oldB),
           " A1: 旧 CompilerCsgCanonicalGraphCid 对 def 重排敏感 (A != B)")

    # --- A2 (新 pass 收敛): normalizedGraphCid 重排不变 ---
    let normA = csgnorm.CsgNormalizedGraphCid("cheng", nodesA, edgesA)
    let normB = csgnorm.CsgNormalizedGraphCid("cheng", nodesB, edgesB)
    assert(layout.FixedBytes32Equal(normA, normB),
           " A2: CsgNormalizedGraphCid 重排不变 (A == B) —— 修了旧的修不了的重排敏感性")

    # --- 每 def 的 normalized cid: A/B 逐节点收敛 ---
    let cidsA = csgnorm.CsgNormNodeCids(nodesA)
    let cidsB = csgnorm.CsgNormNodeCids(nodesB)
    let pkgA = findNodeIndexBySymbolText(nodesA, "cheng")
    let pkgB = findNodeIndexBySymbolText(nodesB, "cheng")
    assert(layout.FixedBytes32Equal(cidsA[pkgA], cidsB[pkgB]), " per-def: package ncid A==B")
    let mFooA = findNodeIndexBySymbolText(nodesA, "cheng/foo")
    let mFooB = findNodeIndexBySymbolText(nodesB, "cheng/foo")
    assert(layout.FixedBytes32Equal(cidsA[mFooA], cidsB[mFooB]), " per-def: module cheng/foo ncid A==B")
    let sFooA = findNodeIndexBySymbolText(nodesA, "cheng/foo::a")
    let sFooB = findNodeIndexBySymbolText(nodesB, "cheng/foo::a")
    assert(layout.FixedBytes32Equal(cidsA[sFooA], cidsB[sFooB]), " per-def: symbol cheng/foo::a ncid A==B")
    let sBazA = findNodeIndexBySymbolText(nodesA, "cheng/baz::c")
    let sBazB = findNodeIndexBySymbolText(nodesB, "cheng/baz::c")
    assert(layout.FixedBytes32Equal(cidsA[sBazA], cidsB[sBazB]), " per-def: 单叶 symbol cheng/baz::c ncid A==B")
    # sibling module 不同内容 -> ncid 不同 (证明不是把一切抹平)
    assert(!layout.FixedBytes32Equal(cidsA[mFooA], cidsA[findNodeIndexBySymbolText(nodesA, "cheng/bar")]),
           " per-def: 不同 module (foo vs bar) ncid 不同")

    # --- A4 (真敏感保留): 换一个 symbol 的 symbolText = 真换 def -> normalizedGraphCid 必变 ---
    var nodesC: ccsg.CompilerCsgNode[]
    var edgesC: ccsg.CompilerCsgEdge[]
    buildGraphA(nodesC, edgesC, "cheng/foo::RENAMED")
    let normC = csgnorm.CsgNormalizedGraphCid("cheng", nodesC, edgesC)
    assert(!layout.FixedBytes32Equal(normA, normC),
           " A4: 改 symbolText (真语义变更) -> normalizedGraphCid 变 (非常数函数)")

    # --- A4b: factText 继续是函数名；独立 overload identity 同时进入 local/content hash ---
    var identityNodesA: ccsg.CompilerCsgNode[]
    var identityEdgesA: ccsg.CompilerCsgEdge[]
    buildGraphA(identityNodesA, identityEdgesA, "cheng/foo::a")
    setFunctionSemanticIdentity(identityNodesA,
                                "cheng/foo::a",
                                "cheng/foo",
                                10,
                                "int32",
                                "int32")
    var identityNodesB: ccsg.CompilerCsgNode[]
    var identityEdgesB: ccsg.CompilerCsgEdge[]
    buildGraphA(identityNodesB, identityEdgesB, "cheng/foo::a")
    setFunctionSemanticIdentity(identityNodesB,
                                "cheng/foo::a",
                                "cheng/foo",
                                20,
                                "int32;;int32",
                                "int32")
    let identityIndexA = findNodeIndexBySymbolText(identityNodesA, "cheng/foo::a")
    let identityIndexB = findNodeIndexBySymbolText(identityNodesB, "cheng/foo::a")
    assert(identityNodesA[identityIndexA].factText == "a" &&
           identityNodesB[identityIndexB].factText == "a",
           " A4b: semantic identity must not replace function-name factText")
    let identityLocalA = csgnorm.CsgNormLocalFingerprint(identityNodesA[identityIndexA])
    let identityLocalB = csgnorm.CsgNormLocalFingerprint(identityNodesB[identityIndexB])
    assert(!layout.FixedBytes32Equal(identityLocalA, identityLocalB),
           " A4b: overload identity participates in local fingerprint")
    let identityNodeCidsA = csgnorm.CsgNormNodeCids(identityNodesA)
    let identityNodeCidsB = csgnorm.CsgNormNodeCids(identityNodesB)
    assert(!layout.FixedBytes32Equal(identityNodeCidsA[identityIndexA],
                                    identityNodeCidsB[identityIndexB]),
           " A4b: overload identity participates in normalized node content")
    let identityGraphA = csgnorm.CsgNormalizedGraphCid("cheng",
                                                       identityNodesA,
                                                       identityEdgesA)
    let identityGraphB = csgnorm.CsgNormalizedGraphCid("cheng",
                                                       identityNodesB,
                                                       identityEdgesB)
    assert(!layout.FixedBytes32Equal(identityGraphA, identityGraphB),
           " A4b: overload identity participates in normalized graph cid")
    identityNodesB[identityIndexB].semanticParamTypeJoin = "int32"
    let movedLocalB = csgnorm.CsgNormLocalFingerprint(identityNodesB[identityIndexB])
    assert(layout.FixedBytes32Equal(identityLocalA, movedLocalB),
           " A4b: complete signature identity ignores declaration-line movement")
    let movedGraphB = csgnorm.CsgNormalizedGraphCid("cheng",
                                                    identityNodesB,
                                                    identityEdgesB)
    assert(layout.FixedBytes32Equal(identityGraphA, movedGraphB),
           " A4b: def movement preserves normalized graph cid")
    identityNodesB[identityIndexB].semanticReturnType = "int64"
    let returnChangedLocalB = csgnorm.CsgNormLocalFingerprint(identityNodesB[identityIndexB])
    assert(!layout.FixedBytes32Equal(identityLocalA, returnChangedLocalB),
           " A4b: return type participates in normalized identity")
    identityNodesB[identityIndexB].semanticReturnType = "int32"
    identityNodesA[identityIndexA].semanticSignatureComplete = 0
    identityNodesB[identityIndexB].semanticSignatureComplete = 0
    let fallbackLocalA = csgnorm.CsgNormLocalFingerprint(identityNodesA[identityIndexA])
    let fallbackLocalB = csgnorm.CsgNormLocalFingerprint(identityNodesB[identityIndexB])
    assert(layout.FixedBytes32Equal(fallbackLocalA, fallbackLocalB),
           " A4b: unique incomplete identity ignores declaration-line movement")
    let fallbackGraphA = csgnorm.CsgNormalizedGraphCid("cheng",
                                                       identityNodesA,
                                                       identityEdgesA)
    let fallbackGraphB = csgnorm.CsgNormalizedGraphCid("cheng",
                                                       identityNodesB,
                                                       identityEdgesB)
    assert(layout.FixedBytes32Equal(fallbackGraphA, fallbackGraphB),
           " A4b: unique incomplete function movement preserves normalized cid")

    var duplicateIncompleteNodes: ccsg.CompilerCsgNode[]
    let duplicatePackage = ccsg.CompilerCsgAddNode(duplicateIncompleteNodes,
                                                    ccsg.CompilerCsgNodeKindPackage,
                                                    0,
                                                    "cheng",
                                                    "cheng",
                                                    "cheng",
                                                    0, 0, 0, 0, 0, 0, "")
    let duplicateModule = ccsg.CompilerCsgAddNode(duplicateIncompleteNodes,
                                                   ccsg.CompilerCsgNodeKindModule,
                                                   duplicatePackage,
                                                   "cheng/dup",
                                                   "cheng/dup",
                                                   "cheng/dup",
                                                   0, 0, 0, 0, 0, 0, "")
    let firstDuplicate = ccsg.CompilerCsgAddNode(duplicateIncompleteNodes,
                                                  ccsg.CompilerCsgNodeKindSymbol,
                                                  duplicateModule,
                                                  "cheng/dup",
                                                  "cheng/dup::Pick",
                                                  "Pick",
                                                  0, 0, 0, 0, 0, 0, "")
    let secondDuplicate = ccsg.CompilerCsgAddNode(duplicateIncompleteNodes,
                                                   ccsg.CompilerCsgNodeKindSymbol,
                                                   duplicateModule,
                                                   "cheng/dup",
                                                   "cheng/dup::Pick",
                                                   "Pick",
                                                   0, 0, 0, 0, 0, 0, "")
    duplicateIncompleteNodes[firstDuplicate - 1].semanticSource = "cheng/dup"
    duplicateIncompleteNodes[secondDuplicate - 1].semanticSource = "cheng/dup"
    var duplicateIdentityErr: str
    assert(!csgnorm.CsgNormValidateSemanticIdentity(duplicateIncompleteNodes,
                                                     duplicateIdentityErr) &&
           duplicateIdentityErr.len > 0,
           " A4b: duplicate incomplete overload identity must hard-fail validation")

    # --- A5 (确定性): 同输入连算 3 次字节稳定 ---
    let normA2 = csgnorm.CsgNormalizedGraphCid("cheng", nodesA, edgesA)
    let normA3 = csgnorm.CsgNormalizedGraphCid("cheng", nodesA, edgesA)
    assert(layout.FixedBytes32Equal(normA, normA2), " A5: 确定性 run#2 == run#1")
    assert(layout.FixedBytes32Equal(normA, normA3), " A5: 确定性 run#3 == run#1")

    # --- packageId 参与顶层 cid (钉 pkg:// 稳定) ---
    let normOther = csgnorm.CsgNormalizedGraphCid("other", nodesA, edgesA)
    assert(!layout.FixedBytes32Equal(normA, normOther), " packageId 入顶层 cid (不同 pkg -> 不同 cid)")

    # ============ Tarjan 引擎单测: 合成 CSR (环 + DAG) ============
    # 环 0->1->2->0: 一个 size-3 component
    var gc: csgnorm.CsgNormOwnerGraph
    var ss: int32[]
    add(ss, 0)
    add(ss, 1)
    add(ss, 2)
    add(ss, 3)
    gc.succStart = ss
    var sl: int32[]
    add(sl, 1)
    add(sl, 2)
    add(sl, 0)
    gc.succList = sl
    let compsCycle = csgnorm.CsgNormTarjanComponents(gc, 3)
    assert(compsCycle.compStart.len == 2, " Tarjan 环: 恰 1 个 component")
    assert(compsCycle.compStart[0] == 0 && compsCycle.compStart[1] == 3, " Tarjan 环: component size 3")

    # DAG 0->1, 2->1 (1 是 sink): 3 个单点 component, sink 先出
    var gd: csgnorm.CsgNormOwnerGraph
    var ds: int32[]
    add(ds, 0)
    add(ds, 1)
    add(ds, 1)
    add(ds, 2)
    gd.succStart = ds
    var dl: int32[]
    add(dl, 1)
    add(dl, 1)
    gd.succList = dl
    let compsDag = csgnorm.CsgNormTarjanComponents(gd, 3)
    assert(compsDag.compStart.len == 4, " Tarjan DAG: 3 个 component")
    assert(compsDag.compStart[1] - compsDag.compStart[0] == 1, " Tarjan DAG: 首 component size 1")
    assert(compsDag.compNodes[0] == 1, " Tarjan DAG: sink(node1) 先出 (被引者先算)")

    # ============ component-local 解环路径单测 (合成 owner 2-cycle, 重排不变) ============
    var nodesXY: ccsg.CompilerCsgNode[]
    buildOwnerCycleXY(nodesXY)
    var nodesYX: ccsg.CompilerCsgNode[]
    buildOwnerCycleYX(nodesYX)
    let cidsXY = csgnorm.CsgNormNodeCids(nodesXY)
    let cidsYX = csgnorm.CsgNormNodeCids(nodesYX)
    let xInXY = findNodeIndexBySymbolText(nodesXY, "X")
    let xInYX = findNodeIndexBySymbolText(nodesYX, "X")
    let yInXY = findNodeIndexBySymbolText(nodesXY, "Y")
    let yInYX = findNodeIndexBySymbolText(nodesYX, "Y")
    assert(layout.FixedBytes32Equal(cidsXY[xInXY], cidsYX[xInYX]), " 环内 X ncid 重排不变")
    assert(layout.FixedBytes32Equal(cidsXY[yInXY], cidsYX[yInYX]), " 环内 Y ncid 重排不变")
    assert(!layout.FixedBytes32Equal(cidsXY[xInXY], cidsXY[yInXY]), " 环内 X/Y (不同 localFp) ncid 相异")

    # ============ 扩场景 1: 三 def 互递归环 (X->Y->Z->X) 重排不变 + 三者相异 ============
    var nodesXYZ: ccsg.CompilerCsgNode[]
    buildOwnerTriXYZ(nodesXYZ)
    var nodesZXY: ccsg.CompilerCsgNode[]
    buildOwnerTriZXY(nodesZXY)
    let cidsTriA = csgnorm.CsgNormNodeCids(nodesXYZ)
    let cidsTriB = csgnorm.CsgNormNodeCids(nodesZXY)
    let txA = findNodeIndexBySymbolText(nodesXYZ, "TX")
    let txB = findNodeIndexBySymbolText(nodesZXY, "TX")
    let tyA = findNodeIndexBySymbolText(nodesXYZ, "TY")
    let tyB = findNodeIndexBySymbolText(nodesZXY, "TY")
    let tzA = findNodeIndexBySymbolText(nodesXYZ, "TZ")
    let tzB = findNodeIndexBySymbolText(nodesZXY, "TZ")
    assert(layout.FixedBytes32Equal(cidsTriA[txA], cidsTriB[txB]), " 三环 X ncid 重排不变")
    assert(layout.FixedBytes32Equal(cidsTriA[tyA], cidsTriB[tyB]), " 三环 Y ncid 重排不变")
    assert(layout.FixedBytes32Equal(cidsTriA[tzA], cidsTriB[tzB]), " 三环 Z ncid 重排不变")
    assert(!layout.FixedBytes32Equal(cidsTriA[txA], cidsTriA[tyA]), " 三环 X/Y ncid 相异")
    assert(!layout.FixedBytes32Equal(cidsTriA[tyA], cidsTriA[tzA]), " 三环 Y/Z ncid 相异")
    assert(!layout.FixedBytes32Equal(cidsTriA[txA], cidsTriA[tzA]), " 三环 X/Z ncid 相异")

    # ============ 扩场景 2: 重排 + 改一个 def 语义 (warm-incremental 种子性质) ============
    # R = B 插入序、sBar 原名 (内容 == A/B); R2 = R 但仅 sBar 改名。与 A (不同插入序) 相比:
    # 未改 def 的 ncid 全等 (重排不变 + 增量局部性); 仅被改 def(sBar)的 ncid 变。
    var nodesR: ccsg.CompilerCsgNode[]
    var edgesR: ccsg.CompilerCsgEdge[]
    buildGraphReordered(nodesR, edgesR, "cheng/bar::b")
    var nodesR2: ccsg.CompilerCsgNode[]
    var edgesR2: ccsg.CompilerCsgEdge[]
    buildGraphReordered(nodesR2, edgesR2, "cheng/bar::CHANGED")
    let cidsR2 = csgnorm.CsgNormNodeCids(nodesR2)
    assert(layout.FixedBytes32Equal(cidsA[pkgA], cidsR2[findNodeIndexBySymbolText(nodesR2, "cheng")]),
           " 增量: package ncid 不变 (重排+他改)")
    assert(layout.FixedBytes32Equal(cidsA[mFooA], cidsR2[findNodeIndexBySymbolText(nodesR2, "cheng/foo")]),
           " 增量: module foo ncid 不变")
    assert(layout.FixedBytes32Equal(cidsA[sFooA], cidsR2[findNodeIndexBySymbolText(nodesR2, "cheng/foo::a")]),
           " 增量: symbol foo::a ncid 不变")
    assert(layout.FixedBytes32Equal(cidsA[sBazA], cidsR2[findNodeIndexBySymbolText(nodesR2, "cheng/baz::c")]),
           " 增量: symbol baz::c ncid 不变")
    let mBarA = findNodeIndexBySymbolText(nodesA, "cheng/bar")
    assert(layout.FixedBytes32Equal(cidsA[mBarA], cidsR2[findNodeIndexBySymbolText(nodesR2, "cheng/bar")]),
           " 增量: module bar ncid 不变 (父不依赖子, 子改名不波及)")
    let sBarA = findNodeIndexBySymbolText(nodesA, "cheng/bar::b")
    let sBarR2 = findNodeIndexBySymbolText(nodesR2, "cheng/bar::CHANGED")
    assert(!layout.FixedBytes32Equal(cidsA[sBarA], cidsR2[sBarR2]), " 增量: 被改 def(sBar)ncid 变")
    let normR = csgnorm.CsgNormalizedGraphCid("cheng", nodesR, edgesR)
    let normR2 = csgnorm.CsgNormalizedGraphCid("cheng", nodesR2, edgesR2)
    assert(layout.FixedBytes32Equal(normA, normR), " 增量: 纯重排 graph cid 不变 (R==A)")
    assert(!layout.FixedBytes32Equal(normA, normR2), " 增量: 改一 def graph cid 变 (R2)")

    # ============ 诚实边界: modulePath basename 敏感 (未规范化, 靠上游 pinned-package 兜) ============
    # 本层直接 hash node.modulePath -> 改 basename 即变 cid; 本 pass 不规范化 modulePath,
    # 共享面稳定性由上游 CAS admission 钉 package_id 兜 (裁决丙)。unpinned 下敏感度仍在。
    var nodesMp: ccsg.CompilerCsgNode[]
    var edgesMp: ccsg.CompilerCsgEdge[]
    buildGraphA(nodesMp, edgesMp, "cheng/foo::a")
    let mpi = findNodeIndexBySymbolText(nodesMp, "cheng/foo")
    nodesMp[mpi].modulePath = "cheng/foo2"
    let normMp = csgnorm.CsgNormalizedGraphCid("cheng", nodesMp, edgesMp)
    assert(!layout.FixedBytes32Equal(normA, normMp),
           " 诚实边界: modulePath basename 敏感 (未规范化, 靠上游 pin 兜共享面)")

    echo(" csg_normalize_reorder_invariance_smoke ok")
    return 0
