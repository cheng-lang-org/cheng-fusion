# fishing A1 平台合同测试: 值/借用接口与身份合同的正例锚定。
#
# 只使用 2026-09-05 A1 探针矩阵实证过的合法形态:
#   - @borrows 只读视图对托管结构体可重复借用 (probe p1b/p6)
#   - 托管返回值 let 绑定 (probe p2)
#   - 字面量 str 入 str[] (probe p5d)
#   - 借用 str 的显式共享走 Fmt 插值拷贝 (probe p5f; CloneStr 在 C 链有
#     registry_miss 前沿, p5c, 不入正例)
#   - 托管结构体赋值 = move (probe p5e), 故多副本用 @borrows 字段克隆 (p5e/p6)
# 指针绕过负例见 docs/campaigns/2026-09-05-pure-cheng-fishing/probes/negative_*.cheng,
# 由 tools/fishing_gate.cheng baseline 阶段断言其编译被拒。
import std/system

const
    ContractSchema = "cheng.fishing.platform.contract.v1"
    KeySlots = 8

type
    # 共享数据合同的最小身份形 (全局依赖图 A2 冻结前锚): 精确 int32 索引,
    # generation 防复用, 无指针、无名称键。
    EntityKey =
        slot: int32
        generation: int32

    # 托管载体: 含 str 字段, 用于值/借用/共享合同的运行期验证。
    KeyedRecord =
        key: EntityKey
        label: str

fn makeRecord(slot: int32, generation: int32, label: str): KeyedRecord =
    # 当前契约: 不支持 local.field.subfield 形式的嵌套字段写;
    # 先物化整体键值, 再整体赋给字段。
    var k: EntityKey
    k.slot = slot
    k.generation = generation
    var r: KeyedRecord
    r.key = k
    r.label = label
    return r

@borrows
fn recordKeyValid(r: KeyedRecord): bool =
    if r.key.slot < 0:
        return false
    if r.key.slot >= KeySlots:
        return false
    if r.key.generation < 0:
        return false
    return true

@borrows
fn recordLabel(r: KeyedRecord): str =
    return r.label

# 借用源显式共享的合同形: Fmt 插值产生全新 owned 副本 (p5f 实证),
# 共享结果与源内容逐字节一致且释放干净。
@borrows
fn shareLabel(r: KeyedRecord): str =
    return Fmt"{r.label}"

@borrows
fn cloneRecord(src: KeyedRecord): KeyedRecord =
    var k: EntityKey
    k.slot = src.key.slot
    k.generation = src.key.generation
    var out: KeyedRecord
    out.key = k
    out.label = Fmt"{src.label}"
    return out

fn keyEq(a: EntityKey, b: EntityKey): bool =
    return a.slot == b.slot && a.generation == b.generation

fn main(): int32 =
    # 1. 值语义: 标量字段结构体按位传递, 读取互不干扰。
    var base = makeRecord(3, 1, "fishing:platform")
    if !recordKeyValid(base):
        return 2
    # 2. 借用语义: 同一托管值的只读视图可重复获取 (两次借用调用)。
    let firstLabel = recordLabel(base)
    let secondLabel = recordLabel(base)
    if firstLabel != secondLabel:
        return 3
    # 3. 显式共享: 借用源经 Fmt 拷贝产出 owned 副本, 内容一致。
    let shared = shareLabel(base)
    if shared != "fishing:platform":
        return 4
    # 4. move 语义下的多副本: 克隆助手产出独立副本, 源仍可借用。
    var copyA = cloneRecord(base)
    var copyB = cloneRecord(base)
    if !keyEq(copyA.key, base.key):
        return 5
    if copyB.label != copyA.label:
        return 6
    # 5. generation 合同: 改代际不改 slot, 旧代际身份 != 新代际身份。
    var bumped: EntityKey
    bumped.slot = copyA.key.slot
    bumped.generation = copyA.key.generation + 1
    copyA.key = bumped
    if keyEq(copyA.key, base.key):
        return 7
    if !recordKeyValid(copyA):
        return 8
    # 6. 序列化往返: label 经 Fmt 拷贝两次, 字节一致 (规则序列化往返前提)。
    let roundTrip = shareLabel(copyB)
    if roundTrip != copyB.label:
        return 9
    echo(Fmt"fishing platform contract ok: schema={ContractSchema} slot={base.key.slot} gen={base.key.generation} labelLen={base.label.len}")
    return 0
