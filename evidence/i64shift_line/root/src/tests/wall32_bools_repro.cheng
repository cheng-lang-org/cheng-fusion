fn typedExprCanonicalDigestStep(first: var int64, second: var int64, value: int64) =
    return

@borrows
fn typedExprCanonicalDigestBools(first: var int64,
                                 second: var int64,
                                 values: bool[]) =
    typedExprCanonicalDigestStep(first, second, Int64(values.len))
    for valueIndex in 0..<values.len:
        typedExprCanonicalDigestStep(first, second,
                                     values[valueIndex] ? 1 : 0)

fn main(): int32 =
    var f1: int64
    var f2: int64
    var vs: bool[2]
    typedExprCanonicalDigestBools(f1, f2, vs)
    return 0
