import cheng/core/backend/codegen_contract as contract
import cheng/core/backend/regalloc_production_encoder_events as events
import cheng/core/backend/regalloc_riscv_adapter as riscv
import cheng/core/backend/regalloc_single_pass as alloc
import cheng/core/ir/core_types as ir
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import std/os

fn fixtureCid(label: str): layout.FixedBytes32 =
    var bytes = layout.ByteBufInit(label.len)
    for index in 0..<label.len:
        layout.ByteBufAppendByte(bytes, int32(label[index]))
    let out = hash256.Sha256Fixed(layout.ByteBufView(bytes))
    layout.ByteBufFree(bytes)
    return out

fn integerReturnBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    assert(ir.BodyIRBindTypeArenaArtifactCid(
               body, fixtureCid("riscv_action_csr_type_arena")),
           "csr type arena")
    var slot: ir.LocalSlot
    ir.BodyIRApplyLocalSlotDefaultProof(slot)
    slot.id = 0
    slot.name = "result"
    slot.typeKind = ir.LocalI32Tag
    slot.stackOffset = 16
    slot.sizeBytes = 4
    slot.alignBytes = 4
    add(body.localSlots, slot)
    var ownership: int32[]
    add(ownership, int32(ir.OwnInvalid))
    ir.BodyIRFreezeEntryDefinitionOwnershipKinds(body, ownership)
    var op: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = ir.BodyOpLoadConstTag
    op.target = 0
    add(op.operands, ir.LocalI32Tag)
    add(op.operands, 42)
    let _ = ir.BodyIRAppendOp(body, op)
    var term: ir.BodyTerm
    ir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = 0
    add(term.operands, ir.LocalI32Tag)
    let termIndex = ir.BodyIRAppendTerm(body, term)
    let blockIndex = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    ir.BodyIRControlFlowBegin(body, 0)
    ir.BodyIRControlFlowBindBlockScope(body, blockIndex, 0)
    var successors: int32[]
    var edgeKinds: int32[]
    ir.BodyIRControlFlowBindTermSuccessors(
        body, termIndex, successors, edgeKinds)
    ir.BodyIRControlFlowSeal(body)
    return body

fn csrAction(placement: int32,
             blockIndex: int32,
             opIndex: int32,
             termIndex: int32,
             edgeIndex: int32): alloc.RegallocValueAction =
    var action: alloc.RegallocValueAction
    action.placement = placement
    action.blockIndex = blockIndex
    action.opIndex = opIndex
    action.termIndex = termIndex
    action.edgeIndex = edgeIndex
    return action

fn csrShapeBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    var op: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(op)
    let _ = ir.BodyIRAppendOp(body, op)
    var term: ir.BodyTerm
    ir.BodyIRApplyBodyTermDefaultProof(term)
    let termIndex = ir.BodyIRAppendTerm(body, term)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn csrShapePlan(): alloc.RegallocSinglePassValuePlan =
    var plan: alloc.RegallocSinglePassValuePlan
    add(plan.actions,
        csrAction(alloc.RegallocValuePlacementFunctionEntry,
                  -1, -1, -1, -1))
    add(plan.actions,
        csrAction(alloc.RegallocValuePlacementBlockEntry,
                  0, -1, -1, -1))
    add(plan.actions,
        csrAction(alloc.RegallocValuePlacementBeforeOp,
                  0, 0, -1, -1))
    add(plan.actions,
        csrAction(alloc.RegallocValuePlacementAfterOp,
                  0, 0, -1, -1))
    add(plan.actions,
        csrAction(alloc.RegallocValuePlacementBlockExit,
                  0, -1, -1, -1))
    add(plan.actions,
        csrAction(alloc.RegallocValuePlacementBeforeTerm,
                  0, -1, 0, -1))
    add(plan.actions,
        csrAction(alloc.RegallocValuePlacementAfterTerm,
                  0, -1, 0, -1))
    add(plan.actions,
        csrAction(alloc.RegallocValuePlacementEdge,
                  0, -1, -1, 0))
    plan.functionEntryActionStart = 0
    plan.functionEntryActionCount = 1
    add(plan.blockEntryActionStarts, 1)
    add(plan.blockEntryActionCounts, 1)
    add(plan.opActionStarts, 2)
    add(plan.opActionCounts, 2)
    add(plan.blockExitActionStarts, 4)
    add(plan.blockExitActionCounts, 1)
    add(plan.termActionStarts, 5)
    add(plan.termActionCounts, 2)
    add(plan.edgeSourceBlocks, 0)
    add(plan.edgeTargetBlocks, 0)
    add(plan.edgeActionStarts, 7)
    add(plan.edgeActionCounts, 1)
    return plan

fn csrMutationsReject(): bool =
    var body = csrShapeBody()
    var exact = csrShapePlan()
    if !riscv.RegallocRiscvActionCsrExact(body, exact):
        return false
    var badStart = csrShapePlan()
    badStart.opActionStarts[0] = -1
    if riscv.RegallocRiscvActionCsrExact(body, badStart):
        return false
    var badCount = csrShapePlan()
    badCount.termActionCounts[0] = 4
    if riscv.RegallocRiscvActionCsrExact(body, badCount):
        return false
    var overlap = csrShapePlan()
    overlap.blockEntryActionStarts[0] = 0
    if riscv.RegallocRiscvActionCsrExact(body, overlap):
        return false
    var missing = csrShapePlan()
    missing.edgeActionStarts[0] = -1
    missing.edgeActionCounts[0] = 0
    if riscv.RegallocRiscvActionCsrExact(body, missing):
        return false
    var wrongSite = csrShapePlan()
    wrongSite.actions[2].opIndex = 7
    if riscv.RegallocRiscvActionCsrExact(body, wrongSite):
        return false
    var nonCanonicalEmpty = csrShapePlan()
    nonCanonicalEmpty.functionEntryActionCount = 0
    if riscv.RegallocRiscvActionCsrExact(body, nonCanonicalEmpty):
        return false
    return true

@borrows
fn wordsCid(recipes: var contract.RegallocA64FunctionRecipes):
        layout.FixedBytes32 =
    var bytes = layout.ByteBufInit(recipes.functionWords.len * 4)
    for row in 0..<recipes.functionWords.len:
        let word = recipes.functionWords[row]
        layout.ByteBufAppendByte(bytes, word & 255)
        layout.ByteBufAppendByte(bytes, (word >> 8) & 255)
        layout.ByteBufAppendByte(bytes, (word >> 16) & 255)
        layout.ByteBufAppendByte(bytes, (word >> 24) & 255)
    let out = hash256.Sha256Fixed(layout.ByteBufView(bytes))
    layout.ByteBufFree(bytes)
    return out

fn main(): int32 =
    let sourceCid = fixtureCid("riscv_action_csr_encoder_source")
    var body = integerReturnBody()
    var constraints = alloc.RegallocTargetConstraintsRv64()
    var plan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        body, constraints)
    assert(plan.valid && alloc.RegallocSinglePassValuePlanValidate(plan),
           "csr plan")
    assert(riscv.RegallocRiscvActionCsrExact(body, plan),
           "csr production plan exact")
    var recipes =
        riscv.RegallocRiscvPrepareFunctionActionRecipesWithEncoderAuthority(
            body, plan, 64, 97, sourceCid)
    assert(recipes.valid &&
           events.RegallocProductionEncoderEventStrictValidate(
               recipes.encoderEvents),
           "csr recipes")
    let wordRoot = layout.FixedBytes32Hex(wordsCid(recipes))
    let eventRoot = layout.FixedBytes32Hex(
        recipes.encoderEvents.orderedRoot)
    assert(plan.actions.len == 5 && recipes.functionWords.len == 8 &&
           recipes.functionRelocs.len == 0 &&
           wordRoot ==
               "ca800e7a637ccf4d244f2a6a5769f6c01168b1329b98440db113b4439c42ecfd" &&
           eventRoot ==
               "fa233bc294cc8c84b0cc5ced70a6e72495c956ca992520989db5d5d473a7fac6",
           "csr byte identity")
    assert(csrMutationsReject(), "csr mutations")
    var damagedBody = integerReturnBody()
    var damagedPlan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        damagedBody, constraints)
    assert(damagedPlan.valid && damagedPlan.functionEntryActionCount > 0,
           "csr damaged production fixture")
    damagedPlan.functionEntryActionStart =
        damagedPlan.functionEntryActionStart + 1
    var damagedRecipes =
        riscv.RegallocRiscvPrepareFunctionActionRecipesWithEncoderAuthority(
            damagedBody, damagedPlan, 64, 97, sourceCid)
    assert(!damagedRecipes.valid, "csr damaged production hard fail")
    os.WriteLine(os.GetStdout(),
                 "riscv_action_csr_smoke=pass mutations=7 byte_identity=1")
    return 0
