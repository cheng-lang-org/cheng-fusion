import cheng/core/ir/phase_arena as phase

# Attack: destroying the store while an arena with live text rows is still
# open. The leak must hard-fail instead of silently abandoning the owner.
fn main(): int32 =
    var store: phase.PhaseArenaStore
    phase.PhaseArenaStoreInit(store, 1, 64, 4)
    var arena = phase.PhaseArenaStoreOpenArena(store, 1, 64, 4)
    let text = phase.PhaseArenaStoreStrPut(store, arena, "leaked")
    if !phase.PhaseArenaStoreStrEqual(store, arena, text, "leaked"):
        return 2
    phase.PhaseArenaStoreDestroy(store)
    return 0
