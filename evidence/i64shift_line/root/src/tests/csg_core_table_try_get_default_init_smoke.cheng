import std/os as os

fn ResetToImplicitDefault[V](value: var V) =
    var defaultValue: V
    value = defaultValue

fn main(): int32 =
    var value: int32 = 73
    ResetToImplicitDefault[int32](value)
    if value != 0:
        return 1
    os.WriteLine(
        os.Get_stdout(),
        "csg_core_table_try_get_default_init_smoke ok")
    return 0
