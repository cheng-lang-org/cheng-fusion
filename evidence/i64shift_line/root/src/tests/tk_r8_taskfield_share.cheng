type
    R8Task =
        objectPath: str
        logPath: str

fn R8ObjectPath(index: int32): str =
    return Fmt"out.provider.{index}.o"

fn R8Build(tasks: var R8Task[]): bool =
    tasks = []
    for i in 0..<2:
        let providerObjectPath = R8ObjectPath(int32(i))
        var task: R8Task
        task.objectPath = share(providerObjectPath)
        task.logPath = Fmt"{providerObjectPath}.compile.log"
        add(tasks, task)
    return true

fn main(): int32 =
    var tasks: R8Task[]
    if !R8Build(tasks):
        return 10
    if tasks.len != 2:
        return 11
    if tasks[0].objectPath != "out.provider.0.o":
        return 12
    if tasks[1].logPath != "out.provider.1.o.compile.log":
        return 13
    echo(Fmt"r8_taskfield_reuse ok obj={tasks[0].objectPath} log={tasks[1].logPath}")
    return 0
