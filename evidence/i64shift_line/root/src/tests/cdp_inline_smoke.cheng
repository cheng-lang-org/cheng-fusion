# cdp_inline_smoke.cheng - Everything inlined into one function to avoid call drift

import std/strings
import std/strutils as su
import std/rawmem_support as rm

@importc("libc_socket")
fn socketCreate(domain: int32, typ: int32, protocol: int32): int32

@importc("libc_connect")
fn socketConnect(fd: int32, addr: ptr, len: int32): int32

@importc("libc_write")
fn socketWrite(fd: int32, buf: ptr, count: int64): int64

@importc("libc_read")
fn socketRead(fd: int32, buf: ptr, count: int64): int64

@importc("libc_shutdown")
fn socketShutdown(fd: int32, how: int32): int32

@importc("cheng_epoch_time_seconds")
fn epochSeconds(): int64

@importc("malloc")
fn rawMalloc(size: int64): ptr

@importc("free")
fn rawFree(p: ptr)

fn main(): int32 =
    # Create socket and connect to localhost:9222
    var fd = socketCreate(2, 1, 6)
    if fd < 0:
        return 1
    # Build sockaddr_in for 127.0.0.1:9222
    var addr = rawMalloc(16)
    if addr == ptr(0):
        var _sd = socketShutdown(fd, 2)
        return 2
    rm.RawmemWriteI8(addr, 0, int8(16))
    rm.RawmemWriteI8(addr, 1, int8(2))
    rm.RawmemWriteI8(addr, 2, int8((9222 >> 8) & 0xff))
    rm.RawmemWriteI8(addr, 3, int8(9222 & 0xff))
    rm.RawmemWriteI8(addr, 4, int8(127))
    rm.RawmemWriteI8(addr, 5, int8(0))
    rm.RawmemWriteI8(addr, 6, int8(0))
    rm.RawmemWriteI8(addr, 7, int8(1))
    var i: int32
    i = 8
    while i < 16:
        rm.RawmemWriteI8(addr, i, int8(0))
        i = i + 1
    var cr = socketConnect(fd, addr, 16)
    rawFree(addr)
    if cr < 0:
        var _sd2 = socketShutdown(fd, 2)
        return 3

    # Send HTTP GET /json
    var httpReq = su.Join([
        "GET /json HTTP/1.1\r\n",
        "Host: 127.0.0.1:9222\r\n",
        "Connection: close\r\n",
        "Accept: application/json\r\n",
        "\r\n"
    ], "")
    var rawText = rm.RawmemAsVoid(httpReq)
    var totalLen = int64(len(httpReq))
    var sent: int64
    while sent < totalLen:
        var chunk = socketWrite(fd, rm.RawmemPtrAdd(rawText, int32(sent)), totalLen - sent)
        if chunk < 0:
            var _sd3 = socketShutdown(fd, 2)
            return 4
        sent = sent + chunk

    # Read response
    var buf = rawMalloc(4096)
    if buf == ptr(0):
        var _sd4 = socketShutdown(fd, 2)
        return 5
    var n = socketRead(fd, buf, int64(4096))
    if n <= 0:
        rawFree(buf)
        var _sd5 = socketShutdown(fd, 2)
        return 6

    # Success: received data from Chrome
    var _sd6 = socketShutdown(fd, 2)
    rawFree(buf)
    return 0
