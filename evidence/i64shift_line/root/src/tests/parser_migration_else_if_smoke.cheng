import cheng/core/lang/parser as parser
import cheng/core/tooling/path as chengpath
import std/strutils as strutil

fn LegacyMigrationSource(): str =
    return "fn Select(v: int32): int32 =\n    if v == 0:\n        return 10\n    else if v == 1:\n        return 20\n    else if v == 2:\n        return 30\n    else:\n        return 40\n"

fn CanonicalSource(): str =
    return "fn Select(v: int32): int32 =\n    if v == 0:\n        return 10\n    elif v == 1:\n        return 20\n    elif v == 2:\n        return 30\n    else:\n        return 40\n"

fn LegacyAliasSource(): str =
    return "proc main(): int32 =\n    return 0\n\nmethod Helper(): int32 =\n    return 1\n\nconverter Convert(): int32 =\n    return 2\n"

fn ProtectedMigrationSource(): str =
    return "fn Guard(v: int32): int32 =\n    let plain = \"else if\"\n    let quote: char = '\\''\n    let formatted = Fmt\"else if {v}\"\n    let multiline = \"\"\"\n        else if\n        \"\"\"\n    # else if\n    // else if\n    if v == 0:\n        return len(plain) + len(formatted) + len(multiline)\n    else  if v == 1:\n        return 11\n    else\tif v == 2:\n        return 12\n    else if v == 3:\n        return 13\n    else:\n        return Int32(quote)\n"

fn CloneInts(items: int32[]): int32[] =
    var out: int32[]
    for index in 0..<items.len:
        add(out, items[index])
    return out

fn ElifSurfaces(layer: parser.NormalizedExprLayer): str[] =
    var out: str[]
    for index in 0..<layer.exprs.len:
        if layer.exprs[index].kind == parser.NormalizedExprElifStmt:
            add(out, layer.exprs[index].surfaceText)
    return out

fn main(): int32 =
    let legacySource = LegacyMigrationSource()
    let frozenLegacySource = LegacyMigrationSource()

    var ordinaryTree: parser.ParserValueExprTree
    var err: str
    assert(!parser.ParserValueExprReadTreeFromText(legacySource,
                                                    ordinaryTree,
                                                    err),
           "parser migration else-if: ordinary tree admitted legacy syntax")
    assert(err == "parser value expr: statement else separator missing",
           Fmt"parser migration else-if: ordinary tree diagnostic drift {err}")

    let legacyAliases = LegacyAliasSource()
    let legacyAliasLines = parser.ParserSplitChar(legacyAliases, '\n')
    var aliasDecls: parser.NormalizedFunctionDecl[]
    err = ""
    assert(!parser.ParserReadNormalizedFunctionDeclsLines(
                legacyAliasLines, legacyAliases, aliasDecls, err),
           "parser migration aliases: ordinary declaration reader admitted proc")
    assert(err == "unsupported top-level function alias 'proc'",
           Fmt"parser migration aliases: ordinary diagnostic drift {err}")
    err = ""
    assert(parser.ParserReadMigrationSourceFunctionDeclsLines(
               legacyAliasLines, legacyAliases, aliasDecls, err),
           Fmt"parser migration aliases: migration declaration reader rejected {err}")
    assert(aliasDecls.len == 3 &&
           aliasDecls[0].name == "main" &&
           aliasDecls[1].name == "Helper" &&
           aliasDecls[2].name == "Convert" &&
           aliasDecls[0].surfaceKeyword == "fn" &&
           aliasDecls[1].surfaceKeyword == "fn" &&
           aliasDecls[2].surfaceKeyword == "fn",
           "parser migration aliases: canonical declaration projection drift")
    assert(!parser.ParserMainFunctionPresent(legacyAliases) &&
           parser.ParserMigrationSourceMainFunctionPresent(legacyAliases),
           "parser migration aliases: main admission mode drift")
    var aliasTree: parser.ParserValueExprTree
    err = ""
    assert(parser.ParserValueExprReadMigrationSourceTreeFromText(
               legacyAliases, aliasTree, err),
           Fmt"parser migration aliases: migration tree rejected {err}")
    parser.ParserValueExprTreeRelease(aliasTree)
    var forbiddenAliasDecls: parser.NormalizedFunctionDecl[]
    err = ""
    assert(!parser.ParserReadMigrationSourceFunctionDeclsLines(
                parser.ParserSplitChar(
                    "func main(): int32 =\n    return 0\n", '\n'),
                "func main(): int32 =\n    return 0\n",
                forbiddenAliasDecls,
                err) &&
           err == "unsupported top-level function alias 'func'",
           "parser migration aliases: unsupported func admitted")

    var migrationTree: parser.ParserValueExprTree
    err = ""
    assert(parser.ParserValueExprReadMigrationSourceTreeFromText(
               legacySource,
               migrationTree,
               err),
           Fmt"parser migration else-if: migration tree rejected {err}")
    assert(parser.ParserValueExprTreeStatementRootCount(migrationTree) > 0,
           "parser migration else-if: migration tree has no statement roots")
    parser.ParserValueExprTreeRelease(migrationTree)

    var ordinaryLayer: parser.NormalizedExprLayer
    err = ""
    assert(!parser.ParserReadNormalizedExprLayerFromText(
               "/workspace/src/select.cheng",
               legacySource,
               ordinaryLayer,
               err),
           "parser migration else-if: ordinary normalized reader admitted legacy syntax")
    parser.NormalizedExprLayerReset(ordinaryLayer)

    var migrationLayer: parser.NormalizedExprLayer
    err = ""
    assert(parser.ParserReadMigrationSourceNormalizedExprLayerFromText(
               "/workspace/src/select.cheng",
               legacySource,
               migrationLayer,
               err),
           Fmt"parser migration else-if: migration normalized reader rejected {err}")
    assert(parser.NormalizedExprLayerIfStmtCount(migrationLayer) == 1 &&
           parser.NormalizedExprLayerElifStmtCount(migrationLayer) == 2 &&
           parser.NormalizedExprLayerElseStmtCount(migrationLayer) == 1,
           "parser migration else-if: migration branch kinds are not canonical")

    var canonicalLayer: parser.NormalizedExprLayer
    err = ""
    assert(parser.ParserReadNormalizedExprLayerFromText(
               "/workspace/src/select.cheng",
               CanonicalSource(),
               canonicalLayer,
               err),
           Fmt"parser migration else-if: canonical source rejected {err}")
    let migrationElifSurfaces = ElifSurfaces(migrationLayer)
    let canonicalElifSurfaces = ElifSurfaces(canonicalLayer)
    assert(migrationElifSurfaces.len == 2 &&
           canonicalElifSurfaces.len == 2 &&
           migrationElifSurfaces[0] == canonicalElifSurfaces[0] &&
           migrationElifSurfaces[1] == canonicalElifSurfaces[1] &&
           migrationElifSurfaces[0] == "v == 1" &&
           migrationElifSurfaces[1] == "v == 2",
           "parser migration else-if: canonical elif payload drift")
    assert(legacySource == frozenLegacySource,
           "parser migration else-if: source bytes were rewritten")

    let protectedSource = ProtectedMigrationSource()
    var spanStarts: int32[]
    var spanEnds: int32[]
    err = ""
    assert(parser.ParserMigrationElseIfRewriteSpansInto(
               protectedSource,
               spanStarts,
               spanEnds,
               err),
           Fmt"parser migration else-if: protected source rejected {err}")
    assert(spanStarts.len == 3 && spanEnds.len == 3,
           "parser migration else-if: protected text changed rewrite count")
    assert(spanStarts[0] < spanEnds[0] &&
           spanEnds[0] < spanStarts[1] &&
           spanStarts[1] < spanEnds[1] &&
           spanEnds[1] < spanStarts[2] &&
           spanStarts[2] < spanEnds[2],
           "parser migration else-if: rewrite spans are not strictly ordered")
    assert(chengpath.TextSlice(protectedSource,
                               spanStarts[0],
                               spanEnds[0] - spanStarts[0]) == "else  if" &&
           chengpath.TextSlice(protectedSource,
                               spanStarts[1],
                               spanEnds[1] - spanStarts[1]) == "else\tif" &&
           chengpath.TextSlice(protectedSource,
                               spanStarts[2],
                               spanEnds[2] - spanStarts[2]) == "else if",
           "parser migration else-if: protected token span drift")
    assert(parser.ParserMigrationElseIfRewriteSpansValidateInto(
               protectedSource,
               spanStarts,
               spanEnds,
               err),
           "parser migration else-if: exact rewrite spans rejected")

    var byteMutationStarts = CloneInts(spanStarts)
    byteMutationStarts[0] = byteMutationStarts[0] + 1
    assert(!parser.ParserMigrationElseIfRewriteSpansValidateInto(
                protectedSource,
                byteMutationStarts,
                spanEnds,
                err),
           "parser migration else-if: span byte mutation accepted")
    var countMutationEnds = CloneInts(spanEnds)
    setLen(countMutationEnds, countMutationEnds.len - 1)
    assert(!parser.ParserMigrationElseIfRewriteSpansValidateInto(
                protectedSource,
                spanStarts,
                countMutationEnds,
                err),
           "parser migration else-if: span count mutation accepted")
    var orderMutationStarts = CloneInts(spanStarts)
    var orderMutationEnds = CloneInts(spanEnds)
    let firstStart = orderMutationStarts[0]
    let firstEnd = orderMutationEnds[0]
    orderMutationStarts[0] = orderMutationStarts[1]
    orderMutationEnds[0] = orderMutationEnds[1]
    orderMutationStarts[1] = firstStart
    orderMutationEnds[1] = firstEnd
    assert(!parser.ParserMigrationElseIfRewriteSpansValidateInto(
                protectedSource,
                orderMutationStarts,
                orderMutationEnds,
                err),
           "parser migration else-if: span order mutation accepted")
    let commentGapMutation = strutil.Replace(
        protectedSource,
        "else  if v == 1",
        "else # gap if v == 1")
    assert(!parser.ParserMigrationElseIfRewriteSpansValidateInto(
                commentGapMutation,
                spanStarts,
                spanEnds,
                err),
           "parser migration else-if: source/token mutation reused spans")

    parser.NormalizedExprLayerReset(migrationLayer)
    parser.NormalizedExprLayerReset(canonicalLayer)
    echo("PARSER_MIGRATION_ELSE_IF_OK")
    return 0
