# ptr-field-read probe for the scalar-pointer-read gate (cli-mig lane).
import std/rawbytes as rawbytes
import std/system as system

@borrows
fn probeBorrowedParamRead(b: rawbytes.Bytes, off: int32): int32 =
    let p = system.SystemPtrAdd(b.data, off)
    if p == nil:
        return 0
    return 1

fn main(): int32 =
    var b = rawbytes.BytesAlloc(8)
    if b.data == nil:
        return -1
    let r1 = probeBorrowedParamRead(b, 1)
    rawbytes.BytesFree(b)
    return r1
