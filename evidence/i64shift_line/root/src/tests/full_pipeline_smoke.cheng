# full pipeline smoke: the DoD-1/DoD-2 core path in one run.
#
# Four validators each hold an independent serial state machine, apply the
# same ordered tx set, order the tx events through the DAG view, sign the
# (sequence, appHash) proposal, and produce a finality certificate. A light
# client holding ONLY the certificate plus the committee key list confirms
# the commit - no DAG view, no state machine, no tx replay.

import std/os
import std/system
import std/rawbytes
import std/strutils as strutil
import std/crypto/sha512 as sha512
import cheng/std/bytes_layout as layout
import cheng/chain/dag_ordering as dord
import cheng/chain/committee_vote as cvt
import cheng/chain/finality_certificate as fcert
import cheng/apps/rwad/rwad_serial_state_machine as serial

fn CidTag(b: int32, salt: int32): layout.FixedBytes32 =
    var raw = BytesAlloc(32)
    BytesSet(raw, 0, b)
    BytesSet(raw, 1, salt)
    let res = layout.FixedBytes32FromBytes(raw)
    return res.value

fn Owner(b: int32): layout.FixedBytes32 =
    return CidTag(b, 0)

# One ordered tx set: 3 mints then 1 transfer, applied identically by every
# validator. Events for the DAG carry the tx cid as payload identity.
fn ApplyTxSet(m: var serial.RwadStateMachine, mintANote: var int64): int32 =
    var rc: int32 = 0
    let mA = serial.RwadStateMachineApplyMint(m, Int64(1), serial.RwadMintTxMake(Owner(1), Int64(100)))
    let mB = serial.RwadStateMachineApplyMint(m, Int64(2), serial.RwadMintTxMake(Owner(2), Int64(50)))
    let mC = serial.RwadStateMachineApplyMint(m, Int64(3), serial.RwadMintTxMake(Owner(3), Int64(30)))
    if !mA.accepted or !mB.accepted or !mC.accepted:
        rc = rc + 1
    mintANote = mA.primaryNoteId
    let xfer = serial.RwadTransferTxMake(mA.primaryNoteId, Owner(1), Owner(2), Int64(1), Int64(40))
    let t = serial.RwadStateMachineApplyTransfer(m, Int64(4), xfer)
    if !t.accepted:
        rc = rc + 1
    return rc

fn BuildDagView(): dord.DagOrderView =
    var view = dord.DagOrderView()
    let zero = layout.FixedBytes32()
    # tx events in causal chain: mint1 <- mint2 <- mint3 <- transfer
    dord.DagOrderPush(view, CidTag(1, 7), zero, false, zero, false, 1, Int64(1), 0)
    dord.DagOrderPush(view, CidTag(2, 7), CidTag(1, 7), true, zero, false, 1, Int64(2), 0)
    dord.DagOrderPush(view, CidTag(3, 7), CidTag(2, 7), true, zero, false, 1, Int64(3), 0)
    dord.DagOrderPush(view, CidTag(4, 7), CidTag(3, 7), true, zero, false, 1, Int64(4), 0)
    return view

fn SeqHash(seq: layout.FixedBytes32[]): layout.FixedBytes32 =
    var buf = BytesAlloc(seq.len * 32)
    var i: int32
    while i < seq.len:
        let b = layout.FixedBytes32ToBytes(seq[i])
        var k: int32
        while k < 32:
            BytesSet(buf, i * 32 + k, BytesGet(b, k))
            k = k + 1
        i = i + 1
    let d = sha512.Sha512Digest(buf)
    BytesFree(buf)
    let res = layout.FixedBytes32FromBytes(BytesSlice(d, 0, 32))
    return res.value

fn main(): int32 =
    var rc: int32 = 0
    let epoch: int32 = 21
    let round: int32 = 5

    let sk0 = BytesFromHex("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
    let sk1 = BytesFromHex("4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb")
    let sk2 = BytesFromHex("c5aa8df43f9f837bedb7442f31dcb7b166d38535076f094b85ce3a2e0b4458f7")
    let sk3 = BytesFromHex("3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c")

    var v0 = cvt.CommitteeDraw(sk0, 100, 100, epoch, round)
    var v1 = cvt.CommitteeDraw(sk1, 100, 100, epoch, round)
    var v2 = cvt.CommitteeDraw(sk2, 100, 100, epoch, round)
    var v3 = cvt.CommitteeDraw(sk3, 100, 100, epoch, round)
    if !v0.ok or !v1.ok or !v2.ok or !v3.ok:
        os.WriteLine(os.Get_stderr(), "draw failed")
        return 1
    var members: cvt.CommitteeMember[]
    add(members, v0.value)
    add(members, v1.value)
    add(members, v2.value)
    add(members, v3.value)

    # every validator applies the tx set independently
    var apps: serial.RwadStateMachine[]
    var proposals: layout.FixedBytes32[]
    var vi: int32
    while vi < 4:
        var m = serial.RwadStateMachineInit("full-pipeline")
        var noteA: int64 = 0
        let arc: int32 = ApplyTxSet(m, noteA)
        if arc != 0:
            os.WriteLine(os.Get_stderr(), "tx application failed")
            rc = rc + 1
        var view = BuildDagView()
        var seq: layout.FixedBytes32[]
        let orc = dord.DagOrderCommitSequence(view, seq)
        if orc != 0 or seq.len != 4:
            os.WriteLine(os.Get_stderr(), "ordering failed")
            rc = rc + 1
        # proposal binds BOTH the commit sequence and the resulting appHash
        let seqH = SeqHash(seq)
        let appH = serial.RwadAppHash(m)
        let phBytes = layout.FixedBytes32ToBytes(seqH)
        let apBytes = layout.FixedBytes32ToBytes(appH)
        let d = sha512.Sha512Digest2(phBytes, apBytes)
        let bound = layout.FixedBytes32FromBytes(BytesSlice(d, 0, 32))
        if !bound.ok:
            rc = rc + 1
        add(proposals, bound.value)
        add(apps, m)
        vi = vi + 1

    # all four validators agree on the bound proposal
    vi = 1
    while vi < 4:
        if !layout.FixedBytes32Equal(proposals[0], proposals[vi]):
            os.WriteLine(os.Get_stderr(), strutil.Join(["validator ", IntToStr(vi), " diverged"], ""))
            rc = rc + 1
        vi = vi + 1

    # sign and certify
    var votes: cvt.SignedVote[]
    var pks: Bytes[]
    vi = 0
    while vi < members.len:
        let vres = cvt.CommitteeSignVote(members[vi], proposals[0])
        if vres.ok:
            add(votes, vres.value)
            add(pks, members[vi].pk)
        vi = vi + 1
    var vp: Bytes[]
    var vs: Bytes[]
    vi = 0
    while vi < votes.len:
        add(vp, votes[vi].voterPk)
        add(vs, votes[vi].sig)
        vi = vi + 1
    let cert = fcert.FcertCreate(proposals[0], epoch, round, vp, vs)
    if !cert.ok:
        os.WriteLine(os.Get_stderr(), "cert create failed")
        rc = rc + 1
    else:
        # light client: verify with cert + committee keys only
        let vf = fcert.FcertVerify(cert.value, pks, 1)
        if !vf.ok:
            os.WriteLine(os.Get_stderr(), "light client rejected valid cert")
            rc = rc + 1

    # post-commit supply invariant on the canonical machine: 180 total
    if serial.RwadOwnerBalance(apps[0], Owner(1)) != 60:
        os.WriteLine(os.Get_stderr(), "owner A balance wrong after spend")
        rc = rc + 1
    if serial.RwadOwnerBalance(apps[0], Owner(2)) != 90:
        os.WriteLine(os.Get_stderr(), "owner B balance wrong after receive")
        rc = rc + 1

    if rc == 0:
        echo("full_pipeline_smoke ok")
    return rc
