// Ownership proof 9: dominator proof test
// Tests that variables written in a dominator block are safely usable
// in dominated blocks for rewrite rules.
// - Variable defined before conditional, used inside both branches
// - Nested dominator: variable from grandparent block available in grandchild
// - Cross-block dominator chain for COPY forwarding
// - Self-comparison rewrites in dominated blocks

fn main(): int32 =
    // Level 1: dominator-defined variable used in nested if-else
    let outer = 42

    if outer > 0:
        // outer dominates this block: identity rewrites using outer are safe
        let inner1 = outer + 0
        if inner1 != 42: return 1

        let inner2 = outer - 0
        if inner2 != 42: return 2

        // Nested if: 3-level dominator chain (main -> if -> nested if)
        if inner1 == 42:
            let inner3 = outer * 1
            if inner3 != 42: return 3

            let inner4 = outer & -1
            if inner4 != 42: return 4
        else:
            return 5
    else:
        // outer also dominates else block
        let inner5 = outer * 1
        if inner5 != 42: return 6

        let inner6 = outer | 0
        if inner6 != 42: return 7

    // After if-else, outer still valid (its writer dominates all paths)
    let final_chk = outer + 0
    if final_chk != 42: return 8

    // Test cross-block COPY forwarding chain
    let base = 100
    if base == 100:
        // base's CONST writer dominates this block
        let fwd = base + 0
        if fwd != 100: return 9
    else:
        let fwd2 = base * 1
        if fwd2 != 100: return 10

    // Multi-variable dominator: two variables defined before conditional
    let x = 7
    let y = 3
    if x > y:
        let r1 = x - y     // cross-variable op in dominated block
        if r1 != 4: return 11
    else:
        return 12

    // Self-comparison in sub-block (dominator check for CMP rewrites)
    if 1 == 1:
        let sc = 55
        if sc == sc:          // x == x -> 1, must be true
            let ok = 0
        else:
            return 13
        if sc != sc:          // x != x -> 0, must be false
            return 14

    // Skip-else: false condition branch still gets correct dominator
    let skip_val = 77
    if false:
        let should_not_run = skip_val + 0
        if should_not_run != 77: return 15

    echo(" ownership_proof_9 ok")
    return 0
