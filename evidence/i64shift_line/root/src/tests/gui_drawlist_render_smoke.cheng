import std/gui as gui

fn fail(msg: str): int32 =
    gui.Log(msg)
    return 1

fn main(): int32 =
    gui.Init()
    var win = gui.CreateWindow("Cheng DrawList Render", 500, 400)
    gui.ShowWindow(win)

    var list = gui.DrawListNew(64)
    if list <= 0:
        return fail("gui drawlist render: list handle")
    if !gui.DrawListIsActive(list):
        return fail("gui drawlist render: active list")
    if gui.DrawListCount(list) != 0:
        return fail("gui drawlist render: initial count")
    if gui.DrawListRectCount(list) != 0:
        return fail("gui drawlist render: initial rect count")
    if gui.DrawListBorderCount(list) != 0:
        return fail("gui drawlist render: initial border count")
    if gui.DrawListTextCount(list) != 0:
        return fail("gui drawlist render: initial text count")

    if !gui.DrawListPushRect(list, 10, 10, 480, 380, 30, 30, 50, 255):
        return fail("gui drawlist render: push background rect")
    if gui.DrawListCount(list) != 1:
        return fail("gui drawlist render: count after background rect")
    if gui.DrawListRectCount(list) != 1:
        return fail("gui drawlist render: rect count after background rect")
    if gui.DrawListLastCommandKind(list) != gui.DRAWLIST_COMMAND_RECT:
        return fail("gui drawlist render: background rect kind")

    if !gui.DrawListPushRect(list, 50, 50, 150, 100, 220, 50, 50, 255):
        return fail("gui drawlist render: push red rect")
    if gui.DrawListCount(list) != 2:
        return fail("gui drawlist render: count after red rect")
    if gui.DrawListRectCount(list) != 2:
        return fail("gui drawlist render: rect count after red rect")
    if gui.DrawListLastCommandKind(list) != gui.DRAWLIST_COMMAND_RECT:
        return fail("gui drawlist render: red rect kind")

    if !gui.DrawListPushRect(list, 250, 50, 150, 100, 50, 180, 50, 255):
        return fail("gui drawlist render: push green rect")
    if gui.DrawListCount(list) != 3:
        return fail("gui drawlist render: count after green rect")
    if gui.DrawListRectCount(list) != 3:
        return fail("gui drawlist render: rect count after green rect")
    if gui.DrawListLastCommandKind(list) != gui.DRAWLIST_COMMAND_RECT:
        return fail("gui drawlist render: green rect kind")

    if !gui.DrawListPushBorder(list, 50, 200, 350, 80, 200, 200, 200, 255, 2, 12):
        return fail("gui drawlist render: push border")
    if gui.DrawListCount(list) != 4:
        return fail("gui drawlist render: count after border")
    if gui.DrawListBorderCount(list) != 1:
        return fail("gui drawlist render: border count")
    if gui.DrawListLastCommandKind(list) != gui.DRAWLIST_COMMAND_BORDER:
        return fail("gui drawlist render: border kind")

    if !gui.DrawListPushText(list, "Hello from DrawList!", 60, 260, 18, 255, 255, 255, 255):
        return fail("gui drawlist render: push text")
    if gui.DrawListCount(list) != 5:
        return fail("gui drawlist render: count after text")
    if gui.DrawListTextCount(list) != 1:
        return fail("gui drawlist render: text count")
    if gui.DrawListLastCommandKind(list) != gui.DRAWLIST_COMMAND_TEXT:
        return fail("gui drawlist render: text kind")

    var canvas = gui.CreateDrawListCanvas(0, 0, 500, 400)
    gui.SetCanvasDrawList(canvas, list)
    gui.AddView(win, canvas)

    var frame: int32
    while frame < 180:
        gui.ProcessFrame()
        gui.SleepMs(16)
        frame = frame + 1

    gui.DrawListClear(list)
    if gui.DrawListCount(list) != 0:
        return fail("gui drawlist render: cleared count")
    if gui.DrawListRectCount(list) != 0:
        return fail("gui drawlist render: cleared rect count")
    if gui.DrawListBorderCount(list) != 0:
        return fail("gui drawlist render: cleared border count")
    if gui.DrawListTextCount(list) != 0:
        return fail("gui drawlist render: cleared text count")
    if gui.DrawListLastCommandKind(list) != gui.DRAWLIST_COMMAND_NONE:
        return fail("gui drawlist render: cleared command kind")

    gui.ReleaseView(canvas)
    gui.DrawListFree(list)
    gui.CloseWindow(win)
    gui.Log("gui_drawlist_render_smoke ok")
    return 0
