import std/os as os
import std/rawbytes
import std/strings
import cheng/core/csg_core/csgc
import cheng/core/csg_core/json_field as field
import cheng/core/csg_core/merkle_builder
import cheng/core/csg_core/merkle_query
import cheng/core/csg_core/merkle_store
import cheng/core/csg_core/merkle_store_codec
import cheng/core/csg_core/merkle_store_pipeline

const
    Standard: str = "csg_core::v1"
    BaseProfile: str = "csg_core"
    ReportDomain: str = "csg_core.store.local_query_report"
    ReportKind: str = "csg.merkle.local_query_report"
    StepKind: str = "csg.merkle.local_query_proof_step"
    WrongCid: str = "sha256:1111111111111111111111111111111111111111111111111111111111111111"

@borrows
fn fail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

@borrows
fn cat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

@borrows
fn findText(text: str, needle: str): int32 =
    if needle.len == 0 || needle.len > text.len:
        return -1
    for start in 0..<(text.len - needle.len + 1):
        var equal = true
        for i in 0..<needle.len:
            if text[start + i] != needle[i]:
                equal = false
                break
        if equal:
            return start
    return -1

@borrows
fn replaceFirst(
        text: str,
        needle: str,
        replacement: str): str =
    let start = findText(text, needle)
    if start < 0:
        return ""
    return cat(
        cat(
            strings.CloneStrRange(text, 0, start),
            replacement),
        strings.CloneStrRange(
            text,
            start + needle.len,
            text.len - start - needle.len))

@borrows
fn sourceCid(text: str): str =
    var bytes = rawbytes.BytesAlloc(text.len)
    for i in 0..<text.len:
        rawbytes.BytesSet(
            bytes, i, int32(text[i]) & 255)
    let cid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            "csg_core.external.source", bytes)
    rawbytes.BytesFree(bytes)
    return cid

@borrows
fn makeSource(
        sourceId: str,
        sourceCidValue: str,
        facts: str[]): merkle_builder.CsgCoreMerkleBuilderSource =
    var out: merkle_builder.CsgCoreMerkleBuilderSource
    out.sourceId = strings.CloneStr(sourceId)
    out.sourceCid = strings.CloneStr(sourceCidValue)
    for i in 0..<facts.len:
        add(out.facts, strings.CloneStr(facts[i]))
    return out

@borrows
fn cloneBytes(bytes: rawbytes.Bytes): rawbytes.Bytes =
    var out = rawbytes.BytesAlloc(rawbytes.BytesLen(bytes))
    rawbytes.BytesCopyInto(out, 0, bytes)
    return out

@borrows
fn reportCid(bytes: rawbytes.Bytes): str =
    return merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
        ReportDomain, bytes)

@borrows
fn cloneBinding(
        value: merkle_query.CsgCoreMerkleQueryExpectedBinding):
        merkle_query.CsgCoreMerkleQueryExpectedBinding =
    var out: merkle_query.CsgCoreMerkleQueryExpectedBinding
    out.headGeneration = value.headGeneration
    out.headCid = strings.CloneStr(value.headCid)
    out.manifestCid = strings.CloneStr(value.manifestCid)
    out.csgcByteCount = value.csgcByteCount
    out.csgcDirectoryCid =
        strings.CloneStr(value.csgcDirectoryCid)
    out.csgcObjectCid = strings.CloneStr(value.csgcObjectCid)
    out.factsRoot = strings.CloneStr(value.factsRoot)
    out.subgraphCid = strings.CloneStr(value.subgraphCid)
    out.queryBucket = strings.CloneStr(value.queryBucket)
    out.queryShardRoot = strings.CloneStr(value.queryShardRoot)
    out.queryShardCid = strings.CloneStr(value.queryShardCid)
    out.queryShardContentRoot =
        strings.CloneStr(value.queryShardContentRoot)
    out.queryShardEntryCount = value.queryShardEntryCount
    out.queryKeyRoot = strings.CloneStr(value.queryKeyRoot)
    out.resultRoot = strings.CloneStr(value.resultRoot)
    out.indexKind = strings.CloneStr(value.indexKind)
    out.term = strings.CloneStr(value.term)
    return out

@borrows
fn rejectedWith(
        bytes: rawbytes.Bytes,
        cid: str,
        expected:
            merkle_query.CsgCoreMerkleQueryExpectedBinding,
        expectedError: str): bool =
    let verified =
        merkle_query.CsgCoreMerkleQueryReportVerify(
            bytes, cid, expected)
    return !verified.ok &&
        strings.StrContains(verified.error, expectedError)

@borrows
fn removeFirstStep(
        lines: str[],
        removed: var bool): str[] =
    var out: str[]
    removed = false
    for i in 0..<lines.len:
        let kind = field.CsgCoreJsonKind(lines[i])
        if !removed && kind.found && kind.value == StepKind:
            removed = true
        else:
            add(out, strings.CloneStr(lines[i]))
    return out

@borrows
fn mutateFirstSibling(
        lines: str[],
        mutated: var bool): str[] =
    var out: str[]
    mutated = false
    let prefix: str = "\"sibling_hash\":\""
    for i in 0..<lines.len:
        let kind = field.CsgCoreJsonKind(lines[i])
        if mutated || !kind.found || kind.value != StepKind:
            add(out, strings.CloneStr(lines[i]))
            continue
        let prefixAt = findText(lines[i], prefix)
        let nibbleAt = prefixAt + prefix.len
        if prefixAt < 0 || nibbleAt >= lines[i].len:
            add(out, strings.CloneStr(lines[i]))
            continue
        let replacement =
            if lines[i][nibbleAt] == '0':
                "1"
            else:
                "0"
        let changed = cat(
            cat(
                strings.CloneStrRange(lines[i], 0, nibbleAt),
                replacement),
            strings.CloneStrRange(
                lines[i],
                nibbleAt + 1,
                lines[i].len - nibbleAt - 1))
        add(out, changed)
        mutated = true
    return out

@borrows
fn mutateHeaderRoot(
        lines: str[],
        factsRoot: str,
        mutated: var bool): str[] =
    var out: str[]
    mutated = false
    for i in 0..<lines.len:
        let kind = field.CsgCoreJsonKind(lines[i])
        if !mutated && kind.found && kind.value == ReportKind:
            let changed = replaceFirst(
                lines[i], factsRoot, WrongCid)
            if changed.len > 0:
                add(out, changed)
                mutated = true
                continue
        add(out, strings.CloneStr(lines[i]))
    return out

fn main(): int32 =
    let parentPath = os.GetEnv("CSG_QUERY_REPORT_PARENT")
    if parentPath.len == 0:
        return fail("CSG_QUERY_REPORT_PARENT missing")
    let schemaFact =
        "{\"features\":[\"core-facts\"],\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}"
    let alphaFact =
        "{\"file\":\"pkg://cheng/query-report/a.cheng\",\"id\":\"symbol:query-report-alpha\",\"kind\":\"csg.symbol\",\"name\":\"collision-9\",\"symbol\":\"alpha\",\"symbolKind\":\"fn\"}"
    let betaFact =
        "{\"file\":\"pkg://cheng/query-report/b.cheng\",\"id\":\"symbol:query-report-beta\",\"kind\":\"csg.symbol\",\"name\":\"collision-10\",\"symbol\":\"beta\",\"symbolKind\":\"fn\"}"
    let sourceA = makeSource(
        "source:query-report-a",
        sourceCid("module query_report_a\nfn alpha() = 1\n"),
        [schemaFact, alphaFact])
    let sourceB = makeSource(
        "source:query-report-b",
        sourceCid("module query_report_b\nfn beta() = 2\n"),
        [betaFact])
    var closure = merkle_builder.CsgCoreMerkleBuildClosure(
        Standard, [BaseProfile], [sourceA, sourceB], [])
    if !closure.ok:
        return fail(cat("query report build failed: ", closure.error))
    let bootstrap =
        merkle_store_pipeline.CsgCoreMerkleStoreBootstrap(
            parentPath, "store", closure)
    if !bootstrap.ok || !bootstrap.published:
        merkle_builder.CsgCoreMerkleBuilderFree(closure)
        return fail(
            cat("query report bootstrap failed: ", bootstrap.error))

    var first = merkle_query.CsgCoreMerkleStoreQuery(
        parentPath, "store", "kind", "csg.symbol")
    var second = merkle_query.CsgCoreMerkleStoreQuery(
        parentPath, "store", "kind", "csg.symbol")
    if !first.ok || !second.ok ||
       first.hits.len != 2 || second.hits.len != 2 ||
       first.reportCid != second.reportCid ||
       !rawbytes.BytesEqual(first.reportBytes, second.reportBytes) ||
       first.reportCid != reportCid(first.reportBytes) ||
       first.generationRecordsRead != 2 ||
       first.manifestObjectsRead != 2 ||
       first.queryKeyRoot != second.queryKeyRoot ||
       first.resultRoot != second.resultRoot ||
       first.proofNodeObjectsRead <= 0 ||
       first.proofNodeBytesRead <= 0 ||
       first.contentObjectBytesRead <= 0:
        return fail(
            cat(
                "query report deterministic query failed: ",
                cat(first.error, second.error)))
    let emptyTerm = merkle_query.CsgCoreMerkleStoreQuery(
        parentPath, "store", "name", "")
    if emptyTerm.ok ||
       !strings.StrContains(emptyTerm.error, "merkle_query_term_empty"):
        return fail("query report empty term accepted")
    var collisionLeft = merkle_query.CsgCoreMerkleStoreQuery(
        parentPath, "store", "name", "collision-9")
    var collisionRight = merkle_query.CsgCoreMerkleStoreQuery(
        parentPath, "store", "name", "collision-10")
    if !collisionLeft.ok || !collisionRight.ok ||
       collisionLeft.hits.len != 1 || collisionRight.hits.len != 1 ||
       collisionLeft.term == collisionRight.term ||
       collisionLeft.queryBucket != collisionRight.queryBucket ||
       collisionLeft.queryShardCid != collisionRight.queryShardCid ||
       collisionLeft.queryShardContentRoot !=
           collisionRight.queryShardContentRoot ||
       collisionLeft.queryShardEntryCount !=
           collisionRight.queryShardEntryCount ||
       collisionLeft.queryKeyRoot ==
           collisionRight.queryKeyRoot ||
       collisionLeft.resultRoot ==
           collisionRight.resultRoot ||
       collisionLeft.queryShardObjectsRead != 1 ||
       collisionRight.queryShardObjectsRead != 1 ||
       collisionLeft.hits[0].factKey ==
           collisionRight.hits[0].factKey ||
       collisionLeft.productionAdmission ||
       collisionRight.productionAdmission:
        return fail(
            cat(
                "query report bucket collision isolation failed: ",
                cat(collisionLeft.error, collisionRight.error)))
    let reportHead =
        merkle_store.CsgCoreMerkleStoreReadManifestOnlyHead(
            parentPath, "store")
    if !reportHead.ok || !reportHead.present:
        return fail("query report manifest-only head failed")
    second.queryShardCid = WrongCid
    var shardSubstitution =
        merkle_query.CsgCoreMerkleQueryReportEncode(
            reportHead, second)
    if shardSubstitution.ok ||
       !strings.StrContains(
           shardSubstitution.error,
           "merkle_query_report_query_shard_binding_mismatch"):
        if shardSubstitution.ok:
            rawbytes.BytesFree(shardSubstitution.bytes)
        return fail("query report shard substitution accepted")
    second.queryShardCid = strings.CloneStr(first.queryShardCid)
    second.queryShardContentRoot = WrongCid
    var shardRootSubstitution =
        merkle_query.CsgCoreMerkleQueryReportEncode(
            reportHead, second)
    if shardRootSubstitution.ok ||
       !strings.StrContains(
           shardRootSubstitution.error,
           "merkle_query_report_query_shard_binding_mismatch"):
        if shardRootSubstitution.ok:
            rawbytes.BytesFree(shardRootSubstitution.bytes)
        return fail("query report shard root substitution accepted")
    second.queryShardContentRoot =
        strings.CloneStr(first.queryShardContentRoot)
    second.queryShardEntryCount = first.queryShardEntryCount + 1
    var shardCountSubstitution =
        merkle_query.CsgCoreMerkleQueryReportEncode(
            reportHead, second)
    if shardCountSubstitution.ok ||
       !strings.StrContains(
           shardCountSubstitution.error,
           "merkle_query_report_query_shard_binding_mismatch"):
        if shardCountSubstitution.ok:
            rawbytes.BytesFree(shardCountSubstitution.bytes)
        return fail("query report shard count substitution accepted")
    second.queryShardEntryCount = first.queryShardEntryCount
    second.queryBucket = ""
    var bucketSubstitution =
        merkle_query.CsgCoreMerkleQueryReportEncode(
            reportHead, second)
    if bucketSubstitution.ok ||
       !strings.StrContains(
           bucketSubstitution.error,
           "merkle_query_report_query_shard_binding_mismatch"):
        if bucketSubstitution.ok:
            rawbytes.BytesFree(bucketSubstitution.bytes)
        return fail("query report bucket substitution accepted")
    second.queryBucket = strings.CloneStr(first.queryBucket)
    let binding =
        merkle_query.CsgCoreMerkleQueryExpectedBindingFromResult(
            first)
    let verified =
        merkle_query.CsgCoreMerkleQueryReportVerify(
            first.reportBytes,
            first.reportCid,
            binding)
    if !verified.ok || verified.completeReport ||
       verified.fullClosureVerified ||
       verified.productionAdmission ||
       verified.headGeneration != first.headGeneration ||
       verified.headCid != first.headCid ||
       verified.hitCount != 2 ||
       verified.pathStepCount <= 0 ||
       verified.objectsRead != first.objectsRead ||
       verified.contentObjectBytesRead !=
           first.contentObjectBytesRead ||
       verified.csgcByteCount != first.csgcByteCount ||
       verified.csgcDirectoryCid != first.csgcDirectoryCid ||
       verified.csgcObjectCid != first.csgcObjectCid ||
       verified.subgraphCid != first.subgraphCid ||
       verified.queryBucket != first.queryBucket ||
       verified.queryShardRoot != first.queryShardRoot ||
       verified.queryShardCid != first.queryShardCid ||
       verified.queryShardContentRoot !=
           first.queryShardContentRoot ||
       verified.queryShardEntryCount !=
           first.queryShardEntryCount ||
       verified.queryKeyRoot != first.queryKeyRoot ||
       verified.resultRoot != first.resultRoot ||
       verified.indexKind != first.indexKind ||
       verified.term != first.term:
        return fail(
            cat("query report verification failed: ", verified.error))

    let decoded = csgc.CsgCoreCsgcDecodeLines(first.reportBytes)
    var canonical =
        csgc.CsgCoreCsgcEncodeCanonicalLines(decoded.lines)
    if !decoded.ok || !canonical.ok ||
       !rawbytes.BytesEqual(first.reportBytes, canonical.bytes):
        return fail("query report canonical roundtrip failed")

    var byteTamper = cloneBytes(first.reportBytes)
    let last = rawbytes.BytesLen(byteTamper) - 1
    rawbytes.BytesSet(
        byteTamper,
        last,
        (rawbytes.BytesGet(byteTamper, last) & 255) ^ 1)
    var wrongManifest = cloneBinding(binding)
    wrongManifest.manifestCid = WrongCid
    var wrongHeadGeneration = cloneBinding(binding)
    wrongHeadGeneration.headGeneration =
        binding.headGeneration + int64(1)
    var wrongHeadCid = cloneBinding(binding)
    wrongHeadCid.headCid = WrongCid
    var wrongByteCount = cloneBinding(binding)
    wrongByteCount.csgcByteCount = binding.csgcByteCount + 1
    var wrongDirectory = cloneBinding(binding)
    wrongDirectory.csgcDirectoryCid = WrongCid
    var wrongObject = cloneBinding(binding)
    wrongObject.csgcObjectCid = WrongCid
    var wrongFactsRoot = cloneBinding(binding)
    wrongFactsRoot.factsRoot = WrongCid
    var wrongSubgraph = cloneBinding(binding)
    wrongSubgraph.subgraphCid = WrongCid
    var wrongBucket = cloneBinding(binding)
    wrongBucket.queryBucket = ""
    var wrongShardRoot = cloneBinding(binding)
    wrongShardRoot.queryShardRoot = WrongCid
    var wrongShardCid = cloneBinding(binding)
    wrongShardCid.queryShardCid = WrongCid
    var wrongShardContentRoot = cloneBinding(binding)
    wrongShardContentRoot.queryShardContentRoot = WrongCid
    var wrongShardEntryCount = cloneBinding(binding)
    wrongShardEntryCount.queryShardEntryCount =
        binding.queryShardEntryCount + 1
    var wrongQueryKeyRoot = cloneBinding(binding)
    wrongQueryKeyRoot.queryKeyRoot = WrongCid
    var wrongResultRoot = cloneBinding(binding)
    wrongResultRoot.resultRoot = WrongCid
    var wrongIndexKind = cloneBinding(binding)
    wrongIndexKind.indexKind = "symbol"
    var wrongTerm = cloneBinding(binding)
    wrongTerm.term = "csg.type"
    if !rejectedWith(
           byteTamper,
           first.reportCid,
           binding,
           "merkle_query_report_cid_mismatch") ||
       !rejectedWith(
           first.reportBytes,
           WrongCid,
           binding,
           "merkle_query_report_cid_mismatch") ||
       !rejectedWith(
           first.reportBytes,
           first.reportCid,
           wrongHeadGeneration,
           "merkle_query_report_head_generation_mismatch") ||
       !rejectedWith(
           first.reportBytes,
           first.reportCid,
           wrongHeadCid,
           "merkle_query_report_head_cid_mismatch") ||
       !rejectedWith(
           first.reportBytes,
           first.reportCid,
           wrongManifest,
           "merkle_query_report_manifest_cid_mismatch") ||
       !rejectedWith(
           first.reportBytes,
           first.reportCid,
           wrongByteCount,
           "merkle_query_report_csgc_byte_count_mismatch") ||
       !rejectedWith(
           first.reportBytes,
           first.reportCid,
           wrongDirectory,
           "merkle_query_report_csgc_directory_cid_mismatch") ||
       !rejectedWith(
           first.reportBytes,
           first.reportCid,
           wrongObject,
           "merkle_query_report_csgc_object_cid_mismatch") ||
       !rejectedWith(
           first.reportBytes,
           first.reportCid,
           wrongFactsRoot,
           "merkle_query_report_facts_root_mismatch") ||
       !rejectedWith(
           first.reportBytes,
           first.reportCid,
           wrongSubgraph,
           "merkle_query_report_subgraph_cid_mismatch") ||
       !rejectedWith(
           first.reportBytes,
           first.reportCid,
           wrongBucket,
           "merkle_query_report_expected_binding_invalid") ||
       !rejectedWith(
           first.reportBytes,
           first.reportCid,
           wrongShardRoot,
           "merkle_query_report_query_shard_root_mismatch") ||
       !rejectedWith(
           first.reportBytes,
           first.reportCid,
           wrongShardCid,
           "merkle_query_report_query_shard_cid_mismatch") ||
       !rejectedWith(
           first.reportBytes,
           first.reportCid,
           wrongShardContentRoot,
           "merkle_query_report_query_shard_content_root_mismatch") ||
       !rejectedWith(
           first.reportBytes,
           first.reportCid,
           wrongShardEntryCount,
           "merkle_query_report_query_shard_entry_count_mismatch") ||
       !rejectedWith(
           first.reportBytes,
           first.reportCid,
           wrongQueryKeyRoot,
           "merkle_query_report_expected_binding_invalid") ||
       !rejectedWith(
           first.reportBytes,
           first.reportCid,
           wrongResultRoot,
           "merkle_query_report_result_root_mismatch") ||
       !rejectedWith(
           first.reportBytes,
           first.reportCid,
           wrongIndexKind,
           "merkle_query_report_expected_binding_invalid") ||
       !rejectedWith(
           first.reportBytes,
           first.reportCid,
           wrongTerm,
           "merkle_query_report_expected_binding_invalid"):
        return fail("query report direct binding mutation accepted")

    var removed: bool
    let missingLines = removeFirstStep(decoded.lines, removed)
    var missing = csgc.CsgCoreCsgcEncodeCanonicalLines(missingLines)
    if !removed || !missing.ok ||
       !rejectedWith(
           missing.bytes,
           reportCid(missing.bytes),
           binding,
           "merkle_query_report_line_count_mismatch"):
        return fail("query report missing sibling accepted")

    var siblingMutated: bool
    let siblingLines =
        mutateFirstSibling(decoded.lines, siblingMutated)
    var sibling =
        csgc.CsgCoreCsgcEncodeCanonicalLines(siblingLines)
    if !siblingMutated || !sibling.ok ||
       !rejectedWith(
           sibling.bytes,
           reportCid(sibling.bytes),
           binding,
           "merkle_query_report_path_invalid"):
        return fail("query report sibling mutation accepted")

    var rootMutated: bool
    let rootLines = mutateHeaderRoot(
        decoded.lines, first.factsRoot, rootMutated)
    var rootAttack = csgc.CsgCoreCsgcEncodeCanonicalLines(rootLines)
    if !rootMutated || !rootAttack.ok ||
       !rejectedWith(
           rootAttack.bytes,
           reportCid(rootAttack.bytes),
           binding,
           "merkle_query_report_root_binding_invalid"):
        return fail("query report embedded root mutation accepted")

    rawbytes.BytesFree(rootAttack.bytes)
    rawbytes.BytesFree(sibling.bytes)
    rawbytes.BytesFree(missing.bytes)
    rawbytes.BytesFree(byteTamper)
    rawbytes.BytesFree(canonical.bytes)
    rawbytes.BytesFree(collisionRight.reportBytes)
    rawbytes.BytesFree(collisionLeft.reportBytes)
    rawbytes.BytesFree(second.reportBytes)
    rawbytes.BytesFree(first.reportBytes)
    merkle_builder.CsgCoreMerkleBuilderFree(closure)
    os.WriteLine(
        os.Get_stdout(),
        "csg_core_merkle_query_report_smoke ok")
    return 0
