import std/rawbytes
import std/result

const
    msQuicTls13MaxMessages: int32 = 32

type
    MsQuicTls13HandshakeMessage =
        kind: int32
        body: Bytes
        raw: Bytes

    MsQuicTls13HandshakeMessages =
        count: int32
        items: MsQuicTls13HandshakeMessage[32]

fn msquicTls13HandshakeMessageFresh(): MsQuicTls13HandshakeMessage =
    var out: MsQuicTls13HandshakeMessage
    out.kind = 0
    out.body = emptyBytes()
    out.raw = emptyBytes()
    return out

@borrows
fn msquicTls13HandshakeMessageClear(out: var MsQuicTls13HandshakeMessage) =
    out.kind = 0
    out.body = emptyBytes()
    out.raw = emptyBytes()

fn initMsQuicTls13HandshakeMessagesInto(out: var MsQuicTls13HandshakeMessages) =
    for i in 0..<msQuicTls13MaxMessages:
        out.items[i] = msquicTls13HandshakeMessageFresh()
    out.count = 0

@borrows
fn msquicTls13HandshakeMessageCopyInto(out: var MsQuicTls13HandshakeMessage,
                                       src: MsQuicTls13HandshakeMessage) =
    out.kind = src.kind
    out.body = BytesSlice(src.body, 0, BytesLen(src.body))
    out.raw = BytesSlice(src.raw, 0, BytesLen(src.raw))

@borrows
fn msquicTls13HandshakeMessagesAdd(
    messages: var MsQuicTls13HandshakeMessages,
    msg: var MsQuicTls13HandshakeMessage
): Result[bool] =
    let countNow: int32 = messages.count
    if countNow >= msQuicTls13MaxMessages:
        return Err[bool]("tls13: handshake message buffer full")
    let idx: int32 = countNow
    msquicTls13HandshakeMessageCopyInto(messages.items[idx], msg)
    messages.count = countNow + 1
    return Ok[bool](true)
