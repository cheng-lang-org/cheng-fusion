import cheng/core/backend/primary_object_plan as pobj

fn main(): int32 =
    assert(pobj.PrimaryFunctionTailName("a::b.c") == "b.c",
           " last namespace separator owns the tail")
    assert(pobj.PrimaryFunctionTailName("a.b::") == "a.b::",
           " trailing separator is rejected as a split")
    assert(pobj.PrimaryFunctionTailName("a:::b") == "b",
           " overlapping namespace separator")
    assert(pobj.PrimaryFunctionTailName("foo.") == "foo.",
           " trailing dot is rejected as a split")
    assert(pobj.PrimaryFunctionTailName("::foo") == "foo",
           " leading namespace separator")
    assert(pobj.PrimaryFunctionTailName("") == "",
           " empty tail")

    assert(pobj.PrimaryCallTargetTailName("a::b.c") ==
           pobj.PrimaryFunctionTailName("a::b.c"),
           " function and call tails agree")
    assert(pobj.PrimaryCallTargetTailName("foo.") ==
           pobj.PrimaryFunctionTailName("foo."),
           " invalid trailing split agrees")

    assert(pobj.PrimaryPathNormalizedEquals("src/a.cheng/", "src/a.cheng"),
           " trailing separator normalization")
    assert(pobj.PrimaryPathNormalizedEquals("/root/src/a.cheng", "src/a.cheng"),
           " absolute-relative anchored equality")
    assert(!pobj.PrimaryPathNormalizedEquals("/x/src/a.cheng",
                                             "/y/src/a.cheng"),
           " distinct absolute owners stay distinct")
    assert(!pobj.PrimaryPathNormalizedEquals("/xya/b.cheng", "a/b.cheng"),
           " relative suffix requires a separator anchor")

    echo(" tailname_index_contract_smoke ok")
    return 0
