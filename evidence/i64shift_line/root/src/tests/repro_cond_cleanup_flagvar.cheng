import std/system
import std/cmdline as cmdline

fn main(): int32 =
    var readyPathRaw: str
    let hasReady: bool = cmdline.ReadFirstFlagValue("--ready-path", readyPathRaw)
    let readyPath: str = if hasReady: readyPathRaw else: ""
    let extra: str = "x"
    return len(readyPath) + len(extra)
