# Microduck full-assembly probe (machine-duck M6, real-parameter 1:1):
# the official MJCF tree assembled into a live world3d/physics3d world
# and driven through the full engine chain (capsule spawn -> hinge-servo
# constraints -> XPBD step -> capsule ground contact).
#
# Assembly (root pose = balanced stance, soles on z = 0):
#   - 15 bodies: the official full-DoF MJCF table (MicroduckModelBuild) -
#     trunk, 2x5 leg chain (hip yaw carrier, hip roll carrier, thigh,
#     shin, foot plate - the M6 fused hip-yoke is split back into its two
#     real sub-30-gram carriers: yaw2roll 23.5 g + hip 5.2 g, verbatim
#     MJCF masses/COMs/anchors) and the 4-body neck chain ending in the
#     172.6 g head shell. Total mass 0.7443611 kg, the verbatim MJCF
#     inertial sum. The stance pitches both hips by 0.43 rad about the
#     real hip-pitch anchors (the MJCF zero pose does NOT statically
#     balance: its real COM sits 5.1 mm in front of the real foot support
#     polygon); the exact chain FK then translates each foot by its ankle
#     anchor's swing displacement, so the plates stay flat, and the real
#     COM projects onto the foot plate centers (front/back margins
#     20.7/20.1 mm). Hip roll parks at 0, so the stance geometry carries
#     over from the 13-body baseline bit-for-bit: the two carriers rest
#     at their zero-pose COMs (the stance FK swings only the pitch/knee/
#     ankle children) and the mass-weighted whole-duck COM is unchanged
#     because the M6 fusion preserved first moments.
#   - 14 constraints: one hinge servo per MJCF joint, five per leg
#     (hip yaw / hip roll / hip pitch / knee / ankle - the per-leg ROLL
#     DoF gap recorded at M6 is closed) plus the 4-joint neck chain,
#     created from the model table (anchors/axes in body-local frames;
#     body-local data is stance-invariant because a rigid per-body
#     transform carries bodies and their fixed points together and each
#     joint pivot is fixed by both sides). Hinge creation anchor
#     coincidence (<1 mm) and axis parallelism (dot > 0.999) must pass
#     from the conversion math alone. Servo limits are the verbatim MJCF
#     ranges; tau/rate are the engineering actuator references (the
#     official file has no actuator table). Remaining gap: the flat-stand
#     upright contract is RED at this baseline - the real-duck rig
#     topples at ~tick 203 because the engine's per-end ground friction
#     is provisioned on the contact capsule's own weight (0.16 N/pole)
#     instead of the actual ~3.7 N contact load, so the feet creep
#     forward out of the support - a physics3d-level fix outside this
#     probe's ownership. Zero rejected steps, servo health (all joint
#     RMS < 1.1 deg) and world validity hold.
#   - Every servo parks at its measured stance angle, so tick 0 commands
#     no step change: hip pitch reads +-0.43 rad and ankle the mirrored
#     sign (per-side MJCF axis conventions); hip yaw, hip roll, knees and
#     the neck chain read 0.
#
# Standing test (flat ground, no ball): zero-velocity release, 14300
# ticks (59.6 s at 240 Hz):
#   A. zero rejected steps (statusCode Ok on every tick)
#   B. torso upright: head com z > torso com z on 100% of ticks
#   C. torso com horizontal drift < 0.5 m over the whole run
#   D. hip pitch/hip roll/knee/ankle/neck pitch/head pitch/head yaw/
#      head roll joint error RMS < 10 deg; measurement: projected
#      actual flexion
#      (Constraints3dHingeAngle) minus the parked servo goal conGoal.
#
# Disturbance test: after 690 settled ticks the torso com takes a
# horizontal 0.8 m/s velocity pulse (+Y: the pitch plane the servo chain
# acts in), then 2000 more ticks. The measured outcome (recovered standing
# vs pushover tick, torso com z < 0.5 x initial) is reported as data - a
# pushover is a valid reported result, never hidden.
#
# Physics-loop discipline: the tick loops do scalar math only (no str
# construction, no echo, no allocation); trace samples are buffered into
# preallocated arrays and echoed after the loop.
import std/math as m
import std/strings as strings
import cheng/game/world3d
import cheng/game/physics3d
import cheng/game/constraints3d
import cheng/game/csg/joint_motor
import cheng/game/csg/numerics
import cheng/game/csg/microduck_model as mm

const
    StandTicks: int32 = 14300
    PushWaitTicks: int32 = 690
    PushTicks: int32 = 2000
    PushSpeedMps: float64 = 0.8
    TraceStride: int32 = 100
    TraceCount: int32 = 30
    DenseStride: int32 = 100
    DenseCount: int32 = 16
    DriftLimitM: float64 = 0.5
    AngleRmsLimitDeg: float64 = 10.0
    FallZRatio: float64 = 0.5
    AngleNeutralTolRad: float64 = 0.001
    AnchorGapTolM: float64 = 0.001
    RestMaxWRadS: float64 = 0.001
    RestDriftLimitM: float64 = 0.001
    RestZErrLimitM: float64 = 0.000001

type
    DuckRig =
        torsoSlot: int32
        headSlot: int32
        hipYawL: int32
        hipRollL: int32
        hipPitchL: int32
        kneeL: int32
        ankleL: int32
        hipYawR: int32
        hipRollR: int32
        hipPitchR: int32
        kneeR: int32
        ankleR: int32
        neck: int32
        headPitch: int32
        headYaw: int32
        headRoll: int32
        x0: float64
        y0: float64
        z0: float64

    DuckStats =
        rejected: int32
        uprightCount: int32
        fallenTick: int32
        ticksDone: int32
        stallTick: int32
        firstRejectTick: int32
        maxResidMm: float64
        firstRejectResidMm: float64
        maxDrift: float64
        finalDrift: float64
        finalTorsoZ: float64
        finalHeadZ: float64
        finalHipPitchDegL: float64
        finalHipPitchDegR: float64
        rmsHipL: float64
        rmsHipR: float64
        rmsRollL: float64
        rmsRollR: float64
        rmsKneeL: float64
        rmsKneeR: float64
        rmsAnkleL: float64
        rmsAnkleR: float64
        rmsNeck: float64
        rmsHeadPitch: float64
        rmsHeadYaw: float64
        rmsHeadRoll: float64

fn fmtMm(x: float64): str =
    let scaled: int32 = int32(m.roundFloat(x * 1000.0))
    var neg: bool = scaled < 0
    var mag: int32 = scaled
    if neg:
        mag = 0 - mag
    let intPart: int32 = mag / 1000
    let fracPart: int32 = mag % 1000
    var outStr: str = ""
    if neg:
        outStr = "-"
    outStr = outStr + strings.IntToStr(intPart) + "." + strings.CloneStrRange(strings.IntToStr(fracPart + 1000), 1, 3)
    return outStr

# Park the servo command and goal at the measured stance flexion so tick
# 0 commands no step change; returns the measured angle.
fn parkHingeServo(w: var World3d, ci: int32): float64 =
    let th0 = Constraints3dHingeAngle(w, ci)
    w.conCmd[ci] = th0
    w.conGoal[ci] = th0
    return th0

# One MJCF joint -> one hinge servo, entirely from the model table: the
# anchor/axis are mapped into each body's spawn-local frame (the inverse
# of the spawn pose rotation), the flexion reference vector (root frame,
# perpendicular to the axis, shared by both bodies so the measured angle
# is 0 at the zero pose and the MJCF sign convention is preserved), and
# the servo limits are the verbatim MJCF range.
@borrows
fn stanceHinge(w: var World3d, mdl: mm.MicroduckModel, jointIdx: int32, refX: float64, refY: float64, refZ: float64, tauMax: float64, omegaRadS: float64): int32 =
    let jt = mdl.joints[jointIdx]
    let pl = mdl.links[jt.parentLink]
    let cl = mdl.links[jt.childLink]
    var anchAx: float64
    var anchAy: float64
    var anchAz: float64
    mm.MicroduckPointToLocal(pl.axisKind, jt.anchorX, jt.anchorY, jt.anchorZ, pl.cx, pl.cy, pl.cz, anchAx, anchAy, anchAz)
    var axisAx: float64
    var axisAy: float64
    var axisAz: float64
    mm.MicroduckVecToLocal(pl.axisKind, jt.axisX, jt.axisY, jt.axisZ, axisAx, axisAy, axisAz)
    var anchBx: float64
    var anchBy: float64
    var anchBz: float64
    mm.MicroduckPointToLocal(cl.axisKind, jt.anchorX, jt.anchorY, jt.anchorZ, cl.cx, cl.cy, cl.cz, anchBx, anchBy, anchBz)
    var axisBx: float64
    var axisBy: float64
    var axisBz: float64
    mm.MicroduckVecToLocal(cl.axisKind, jt.axisX, jt.axisY, jt.axisZ, axisBx, axisBy, axisBz)
    let ci = World3dAddHingeJoint(w, jt.parentLink, jt.childLink, world3d.World3dConHingeServo, anchAx, anchAy, anchAz, anchBx, anchBy, anchBz, axisAx, axisAy, axisAz, axisBx, axisBy, axisBz)
    var refAlX: float64
    var refAlY: float64
    var refAlZ: float64
    mm.MicroduckVecToLocal(pl.axisKind, refX, refY, refZ, refAlX, refAlY, refAlZ)
    var refBlX: float64
    var refBlY: float64
    var refBlZ: float64
    mm.MicroduckVecToLocal(cl.axisKind, refX, refY, refZ, refBlX, refBlY, refBlZ)
    World3dSetHingeRefs(w, ci, refAlX, refAlY, refAlZ, refBlX, refBlY, refBlZ)
    World3dSetHingeServo(w, ci, tauMax, omegaRadS, jt.minRad, jt.maxRad)
    if Constraints3dJointAnchorGap(w, ci) > AnchorGapTolM:
        panic("microduck assembly: hinge pivot gap at " + jt.name)
    return ci

fn buildDuck(w: var World3d, instance: int64): DuckRig =
    var rig: DuckRig
    World3dReset(w, instance)
    var mdl: mm.MicroduckModel = mm.MicroduckModelBuild()
    if mdl.links.len != 15:
        panic("microduck assembly: link count")
    if mdl.joints.len != 14:
        panic("microduck assembly: joint count")
    if numerics.CsgAbs(mdl.totalMass - 0.7443611) > 0.000000001:
        panic("microduck assembly: total mass off the MJCF sum")
    # 15 link capsules at the balanced stance (soles on z = 0).
    let rootZ = mm.MicroduckStanceRootZLift
    var i: int32 = 0
    while i < mdl.links.len:
        let sp = mm.MicroduckLinkSpawnCapsuleStance(mdl, i, 0.0, 0.0, rootZ, 0.0)
        let slot = World3dSpawnCapsule(w, sp.px, sp.py, sp.pz, sp.mass, sp.radius, sp.halfLen, sp.qw, sp.qx, sp.qy, sp.qz)
        if slot != i:
            panic("microduck assembly: link slot mismatch")
        i = i + 1
    let omegaRadS = mm.MicroduckServoMaxRateDegS * joint_motor.JointMotorRadPerDeg
    let tauHip = mm.MicroduckTauMaxHipNm
    let tauKnee = mm.MicroduckTauMaxKneeNm
    let tauAnkle = mm.MicroduckTauMaxAnkleNm
    let tauNeck = mm.MicroduckTauMaxNeckNm
    # 14 hinge servos, one per MJCF joint, created in the main assembly's
    # order (hip roll before hip yaw per leg). Flexion references: the
    # hip roll hinge (lateral (0,1,0) axis) references forward (1,0,0) -
    # a ref parallel to the axis is illegal; lateral yaw joints reference
    # forward (0,1,0); pitch/knee/ankle reference down (0,0,-1); the
    # neck chain references up (0,0,1) so every measured angle reads the
    # MJCF convention.
    rig.hipRollL = stanceHinge(w, mdl, mm.MicroduckJointHipRollL, 1.0, 0.0, 0.0, tauHip, omegaRadS)
    rig.hipYawL = stanceHinge(w, mdl, mm.MicroduckJointHipYawL, 0.0, 1.0, 0.0, tauHip, omegaRadS)
    rig.hipPitchL = stanceHinge(w, mdl, mm.MicroduckJointHipPitchL, 0.0, 0.0, 0.0 - 1.0, tauHip, omegaRadS)
    rig.kneeL = stanceHinge(w, mdl, mm.MicroduckJointKneeL, 0.0, 0.0, 0.0 - 1.0, tauKnee, omegaRadS)
    rig.ankleL = stanceHinge(w, mdl, mm.MicroduckJointAnklePitchL, 0.0, 0.0, 0.0 - 1.0, tauAnkle, omegaRadS)
    rig.hipRollR = stanceHinge(w, mdl, mm.MicroduckJointHipRollR, 1.0, 0.0, 0.0, tauHip, omegaRadS)
    rig.hipYawR = stanceHinge(w, mdl, mm.MicroduckJointHipYawR, 0.0, 1.0, 0.0, tauHip, omegaRadS)
    rig.hipPitchR = stanceHinge(w, mdl, mm.MicroduckJointHipPitchR, 0.0, 0.0, 0.0 - 1.0, tauHip, omegaRadS)
    rig.kneeR = stanceHinge(w, mdl, mm.MicroduckJointKneeR, 0.0, 0.0, 0.0 - 1.0, tauKnee, omegaRadS)
    rig.ankleR = stanceHinge(w, mdl, mm.MicroduckJointAnklePitchR, 0.0, 0.0, 0.0 - 1.0, tauAnkle, omegaRadS)
    rig.neck = stanceHinge(w, mdl, mm.MicroduckJointNeckPitch, 0.0, 0.0, 1.0, tauNeck, omegaRadS)
    rig.headPitch = stanceHinge(w, mdl, mm.MicroduckJointHeadPitch, 0.0, 0.0, 1.0, tauNeck, omegaRadS)
    rig.headYaw = stanceHinge(w, mdl, mm.MicroduckJointHeadYaw, 0.0, 1.0, 0.0, tauNeck, omegaRadS)
    rig.headRoll = stanceHinge(w, mdl, mm.MicroduckJointHeadRoll, 0.0, 0.0, 1.0, tauNeck, omegaRadS)
    # Create-time pose validation: every hinge pivot landed on one point
    # (checked at creation); the measured stance angles must equal the
    # exact stance FK (hip pitch +-0.43 rad, ankle the mirrored sign,
    # hip yaw/roll, knees and the neck chain neutral).
    let th = mm.MicroduckStanceHipRad
    let thYawL = parkHingeServo(w, rig.hipYawL)
    let thHipL = parkHingeServo(w, rig.hipPitchL)
    let thYawR = parkHingeServo(w, rig.hipYawR)
    let thHipR = parkHingeServo(w, rig.hipPitchR)
    let thRollL = parkHingeServo(w, rig.hipRollL)
    let thRollR = parkHingeServo(w, rig.hipRollR)
    let thKneeL = parkHingeServo(w, rig.kneeL)
    let thKneeR = parkHingeServo(w, rig.kneeR)
    let thAnkleL = parkHingeServo(w, rig.ankleL)
    let thAnkleR = parkHingeServo(w, rig.ankleR)
    let thNeck = parkHingeServo(w, rig.neck)
    let thHeadPitch = parkHingeServo(w, rig.headPitch)
    let thHeadYaw = parkHingeServo(w, rig.headYaw)
    let thHeadRoll = parkHingeServo(w, rig.headRoll)
    if numerics.CsgAbs(thHipL - th) > AngleNeutralTolRad:
        panic("microduck assembly: hip pitch L th0 off the stance")
    if numerics.CsgAbs(thHipR + th) > AngleNeutralTolRad:
        panic("microduck assembly: hip pitch R th0 off the stance")
    if numerics.CsgAbs(thAnkleL + th) > AngleNeutralTolRad:
        panic("microduck assembly: ankle L th0 off the stance")
    if numerics.CsgAbs(thAnkleR - th) > AngleNeutralTolRad:
        panic("microduck assembly: ankle R th0 off the stance")
    if numerics.CsgAbs(thYawL) > AngleNeutralTolRad:
        panic("microduck assembly: hip yaw L th0 not neutral")
    if numerics.CsgAbs(thYawR) > AngleNeutralTolRad:
        panic("microduck assembly: hip yaw R th0 not neutral")
    if numerics.CsgAbs(thRollL) > AngleNeutralTolRad:
        panic("microduck assembly: hip roll L th0 not neutral")
    if numerics.CsgAbs(thRollR) > AngleNeutralTolRad:
        panic("microduck assembly: hip roll R th0 not neutral")
    if numerics.CsgAbs(thKneeL) > AngleNeutralTolRad:
        panic("microduck assembly: knee L th0 not neutral")
    if numerics.CsgAbs(thKneeR) > AngleNeutralTolRad:
        panic("microduck assembly: knee R th0 not neutral")
    if numerics.CsgAbs(thNeck) > AngleNeutralTolRad:
        panic("microduck assembly: neck th0 not neutral")
    if numerics.CsgAbs(thHeadPitch) > AngleNeutralTolRad:
        panic("microduck assembly: head pitch th0 not neutral")
    if numerics.CsgAbs(thHeadYaw) > AngleNeutralTolRad:
        panic("microduck assembly: head yaw th0 not neutral")
    if numerics.CsgAbs(thHeadRoll) > AngleNeutralTolRad:
        panic("microduck assembly: head roll th0 not neutral")
    rig.torsoSlot = mm.MicroduckLinkTorso
    rig.headSlot = mm.MicroduckLinkHead
    rig.x0 = w.bodyPx[mm.MicroduckLinkTorso]
    rig.y0 = w.bodyPy[mm.MicroduckLinkTorso]
    rig.z0 = w.bodyPz[mm.MicroduckLinkTorso]
    echo("assembly links=" + strings.IntToStr(mdl.links.len) + " joints=" + strings.IntToStr(mdl.joints.len) + " bodies=" + strings.IntToStr(w.count) + " constraints=" + strings.IntToStr(w.conCount) + " totalMass_x1000=" + strings.Int64ToStr(numerics.CsgQuantMm(mdl.totalMass)))
    echo("assembly th0_deg hipL=" + fmtMm(thHipL * joint_motor.JointMotorDegPerRad) + " hipR=" + fmtMm(thHipR * joint_motor.JointMotorDegPerRad) + " rollL=" + fmtMm(thRollL * joint_motor.JointMotorDegPerRad) + " rollR=" + fmtMm(thRollR * joint_motor.JointMotorDegPerRad) + " kneeL=" + fmtMm(thKneeL * joint_motor.JointMotorDegPerRad) + " kneeR=" + fmtMm(thKneeR * joint_motor.JointMotorDegPerRad) + " ankleL=" + fmtMm(thAnkleL * joint_motor.JointMotorDegPerRad) + " ankleR=" + fmtMm(thAnkleR * joint_motor.JointMotorDegPerRad) + " neck=" + fmtMm(thNeck * joint_motor.JointMotorDegPerRad))
    return rig

# One schedule: totalTicks physics steps, optional horizontal velocity
# pulse on the torso com at pushTick. Scalar measurements accumulate every
# tick; trace samples buffer every TraceStride ticks and echo below.
fn runSchedule(w: var World3d, rig: DuckRig, totalTicks: int32, pushTick: int32, label: str, stats: var DuckStats): bool =
    let torsoSlot = rig.torsoSlot
    let headSlot = rig.headSlot
    var sTick: int32[]
    var sTorsoZ: float64[]
    var sHeadZ: float64[]
    var sDrift: float64[]
    var sDx: float64[]
    var sDy: float64[]
    var sYawL: float64[]
    var sYawR: float64[]
    var sRollL: float64[]
    var sRollR: float64[]
    var sKneeErr: float64[]
    var sAnkleErr: float64[]
    var sNeckErr: float64[]
    var sResid: float64[]
    var sV: float64[]
    var sW: float64[]
    var sVx: float64[]
    var sVy: float64[]
    setLen(sTick, TraceCount)
    setLen(sTorsoZ, TraceCount)
    setLen(sHeadZ, TraceCount)
    setLen(sDrift, TraceCount)
    setLen(sDx, TraceCount)
    setLen(sDy, TraceCount)
    setLen(sYawL, TraceCount)
    setLen(sYawR, TraceCount)
    setLen(sRollL, TraceCount)
    setLen(sRollR, TraceCount)
    setLen(sKneeErr, TraceCount)
    setLen(sAnkleErr, TraceCount)
    setLen(sNeckErr, TraceCount)
    setLen(sResid, TraceCount)
    setLen(sV, DenseCount)
    setLen(sW, DenseCount)
    setLen(sVx, DenseCount)
    setLen(sVy, DenseCount)
    var sumHipL: float64
    var sumHipR: float64
    var sumRollL: float64
    var sumRollR: float64
    var sumKneeL: float64
    var sumKneeR: float64
    var sumAnkleL: float64
    var sumAnkleR: float64
    var sumNeck: float64
    var sumHeadPitch: float64
    var sumHeadYaw: float64
    var sumHeadRoll: float64
    var rejectRun: int32 = 0
    var ti: int32 = 0
    var di: int32 = 0
    var i: int32 = 0
    stats.rejected = 0
    stats.uprightCount = 0
    stats.fallenTick = 0 - 1
    stats.ticksDone = 0
    stats.stallTick = 0 - 1
    stats.firstRejectTick = 0 - 1
    stats.maxResidMm = 0.0
    stats.firstRejectResidMm = 0.0
    stats.maxDrift = 0.0
    stats.finalDrift = 0.0
    stats.finalTorsoZ = 0.0
    stats.finalHeadZ = 0.0
    stats.finalHipPitchDegL = 0.0
    stats.finalHipPitchDegR = 0.0
    stats.rmsHipL = 0.0
    stats.rmsHipR = 0.0
    stats.rmsRollL = 0.0
    stats.rmsRollR = 0.0
    stats.rmsKneeL = 0.0
    stats.rmsKneeR = 0.0
    stats.rmsAnkleL = 0.0
    stats.rmsAnkleR = 0.0
    stats.rmsNeck = 0.0
    stats.rmsHeadPitch = 0.0
    stats.rmsHeadYaw = 0.0
    stats.rmsHeadRoll = 0.0
    # A rejected step rolls back and never advances the tick, so retrying
    # an identical state rejects identically forever; 64 straight rejects
    # at one tick is therefore an engine stall, reported as data instead
    # of being spun on silently.
    while i < totalTicks and stats.stallTick < 0:
        if i == pushTick:
            w.bodyVy[torsoSlot] = PushSpeedMps
        var r = physics3d.Physics3dStep(w, "probe:duck")
        if r.maxResidualMm > stats.maxResidMm:
            stats.maxResidMm = r.maxResidualMm
        if r.statusCode != physics3d.Physics3dStatusOk:
            stats.rejected = stats.rejected + 1
            rejectRun = rejectRun + 1
            if stats.firstRejectTick < 0:
                stats.firstRejectTick = i
                stats.firstRejectResidMm = r.maxResidualMm
            if rejectRun > 64:
                stats.stallTick = i
        else:
            rejectRun = 0
        let dx = w.bodyPx[torsoSlot] - rig.x0
        let dy = w.bodyPy[torsoSlot] - rig.y0
        let drift = numerics.CsgSqrt(dx * dx + dy * dy)
        if drift > stats.maxDrift:
            stats.maxDrift = drift
        stats.finalDrift = drift
        stats.finalTorsoZ = w.bodyPz[torsoSlot]
        # dense kinematic scout: max body speed / angular speed over all
        # bodies (squares tracked, roots only at sample ticks)
        var maxV2: float64 = 0.0
        var maxW: float64 = 0.0
        var maxVBi: int32 = 0
        var maxWBi: int32 = 0
        var bi: int32 = 0
        while bi < w.count:
            let v2 = w.bodyVx[bi] * w.bodyVx[bi] + w.bodyVy[bi] * w.bodyVy[bi] + w.bodyVz[bi] * w.bodyVz[bi]
            if v2 > maxV2:
                maxV2 = v2
                maxVBi = bi
            let wAbs = m.absFloat(w.bodyAngVx[bi])
            if wAbs > maxW:
                maxW = wAbs
                maxWBi = bi
            let wAbs2 = m.absFloat(w.bodyAngVy[bi])
            if wAbs2 > maxW:
                maxW = wAbs2
                maxWBi = bi
            let wAbs3 = m.absFloat(w.bodyAngVz[bi])
            if wAbs3 > maxW:
                maxW = wAbs3
                maxWBi = bi
            bi = bi + 1
        if i % DenseStride == 0:
            if di < DenseCount:
                sV[di] = numerics.CsgSqrt(maxV2)
                sW[di] = maxW
                sVx[di] = float64(maxVBi)
                sVy[di] = float64(maxWBi)
                di = di + 1
        stats.finalHeadZ = w.bodyPz[headSlot]
        if stats.finalHeadZ > stats.finalTorsoZ:
            stats.uprightCount = stats.uprightCount + 1
        if stats.fallenTick < 0:
            if stats.finalTorsoZ < FallZRatio * rig.z0:
                stats.fallenTick = i
        let eHipL = Constraints3dHingeAngle(w, rig.hipPitchL) - w.conGoal[rig.hipPitchL]
        let eHipR = Constraints3dHingeAngle(w, rig.hipPitchR) - w.conGoal[rig.hipPitchR]
        let eRollL = Constraints3dHingeAngle(w, rig.hipRollL) - w.conGoal[rig.hipRollL]
        let eRollR = Constraints3dHingeAngle(w, rig.hipRollR) - w.conGoal[rig.hipRollR]
        let eKneeL = Constraints3dHingeAngle(w, rig.kneeL) - w.conGoal[rig.kneeL]
        let eKneeR = Constraints3dHingeAngle(w, rig.kneeR) - w.conGoal[rig.kneeR]
        let eAnkleL = Constraints3dHingeAngle(w, rig.ankleL) - w.conGoal[rig.ankleL]
        let eAnkleR = Constraints3dHingeAngle(w, rig.ankleR) - w.conGoal[rig.ankleR]
        let eNeck = Constraints3dHingeAngle(w, rig.neck) - w.conGoal[rig.neck]
        let eHeadPitch = Constraints3dHingeAngle(w, rig.headPitch) - w.conGoal[rig.headPitch]
        let eHeadYaw = Constraints3dHingeAngle(w, rig.headYaw) - w.conGoal[rig.headYaw]
        let eHeadRoll = Constraints3dHingeAngle(w, rig.headRoll) - w.conGoal[rig.headRoll]
        sumHipL = sumHipL + eHipL * eHipL
        sumHipR = sumHipR + eHipR * eHipR
        sumRollL = sumRollL + eRollL * eRollL
        sumRollR = sumRollR + eRollR * eRollR
        sumKneeL = sumKneeL + eKneeL * eKneeL
        sumKneeR = sumKneeR + eKneeR * eKneeR
        sumAnkleL = sumAnkleL + eAnkleL * eAnkleL
        sumAnkleR = sumAnkleR + eAnkleR * eAnkleR
        sumNeck = sumNeck + eNeck * eNeck
        sumHeadPitch = sumHeadPitch + eHeadPitch * eHeadPitch
        sumHeadYaw = sumHeadYaw + eHeadYaw * eHeadYaw
        sumHeadRoll = sumHeadRoll + eHeadRoll * eHeadRoll
        if i % TraceStride == 0:
            if ti < TraceCount:
                sTick[ti] = i
                sTorsoZ[ti] = stats.finalTorsoZ
                sHeadZ[ti] = stats.finalHeadZ
                sDrift[ti] = drift
                sDx[ti] = dx
                sDy[ti] = dy
                sYawL[ti] = Constraints3dHingeAngle(w, rig.hipYawL)
                sYawR[ti] = Constraints3dHingeAngle(w, rig.hipYawR)
                sRollL[ti] = eRollL
                sRollR[ti] = eRollR
                sKneeErr[ti] = eKneeL
                sAnkleErr[ti] = eAnkleL
                sNeckErr[ti] = eNeck
                sResid[ti] = stats.maxResidMm
                ti = ti + 1
        i = i + 1
    stats.ticksDone = i
    var divN: int32 = stats.ticksDone
    if divN <= 0:
        divN = 1
    let invN = 1.0 / float64(divN)
    stats.rmsHipL = numerics.CsgSqrt(sumHipL * invN) * joint_motor.JointMotorDegPerRad
    stats.rmsHipR = numerics.CsgSqrt(sumHipR * invN) * joint_motor.JointMotorDegPerRad
    stats.rmsRollL = numerics.CsgSqrt(sumRollL * invN) * joint_motor.JointMotorDegPerRad
    stats.rmsRollR = numerics.CsgSqrt(sumRollR * invN) * joint_motor.JointMotorDegPerRad
    stats.rmsKneeL = numerics.CsgSqrt(sumKneeL * invN) * joint_motor.JointMotorDegPerRad
    stats.rmsKneeR = numerics.CsgSqrt(sumKneeR * invN) * joint_motor.JointMotorDegPerRad
    stats.rmsAnkleL = numerics.CsgSqrt(sumAnkleL * invN) * joint_motor.JointMotorDegPerRad
    stats.rmsAnkleR = numerics.CsgSqrt(sumAnkleR * invN) * joint_motor.JointMotorDegPerRad
    stats.rmsNeck = numerics.CsgSqrt(sumNeck * invN) * joint_motor.JointMotorDegPerRad
    stats.rmsHeadPitch = numerics.CsgSqrt(sumHeadPitch * invN) * joint_motor.JointMotorDegPerRad
    stats.rmsHeadYaw = numerics.CsgSqrt(sumHeadYaw * invN) * joint_motor.JointMotorDegPerRad
    stats.rmsHeadRoll = numerics.CsgSqrt(sumHeadRoll * invN) * joint_motor.JointMotorDegPerRad
    stats.finalHipPitchDegL = Constraints3dHingeAngle(w, rig.hipPitchL) * joint_motor.JointMotorDegPerRad
    stats.finalHipPitchDegR = Constraints3dHingeAngle(w, rig.hipPitchR) * joint_motor.JointMotorDegPerRad
    var k: int32 = 0
    while k < ti:
        echo(label + " t=" + strings.IntToStr(sTick[k]) + " torsoZ_mm=" + fmtMm(sTorsoZ[k] * 1000.0) + " headZ_mm=" + fmtMm(sHeadZ[k] * 1000.0) + " drift_mm=" + fmtMm(sDrift[k] * 1000.0) + " dx_mm=" + fmtMm(sDx[k] * 1000.0) + " dy_mm=" + fmtMm(sDy[k] * 1000.0) + " yawL_deg=" + fmtMm(sYawL[k] * joint_motor.JointMotorDegPerRad) + " yawR_deg=" + fmtMm(sYawR[k] * joint_motor.JointMotorDegPerRad) + " rollL_err_deg=" + fmtMm(sRollL[k] * joint_motor.JointMotorDegPerRad) + " rollR_err_deg=" + fmtMm(sRollR[k] * joint_motor.JointMotorDegPerRad) + " kneeL_err_deg=" + fmtMm(sKneeErr[k] * joint_motor.JointMotorDegPerRad) + " ankleL_err_deg=" + fmtMm(sAnkleErr[k] * joint_motor.JointMotorDegPerRad) + " neck_err_deg=" + fmtMm(sNeckErr[k] * joint_motor.JointMotorDegPerRad) + " maxresid_mm=" + fmtMm(sResid[k]))
        k = k + 1
    k = 0
    while k < di:
        echo(label + " kin t=" + strings.IntToStr(k * DenseStride) + " maxV_mm_s=" + fmtMm(sV[k] * 1000.0) + " maxW_mrad_s=" + fmtMm(sW[k] * 1000.0) + " maxV_body=" + strings.IntToStr(int32(sVx[k])) + " maxW_body=" + strings.IntToStr(int32(sVy[k])))
        k = k + 1
    return stats.stallTick < 0

fn caseAssemblyStand(): bool =
    var w: world3d.World3d
    let rig = buildDuck(w, int64(901))
    if w.count != 15:
        echo("FAIL assembly body count")
        return false
    if w.conCount != 14:
        echo("FAIL assembly constraint count")
        return false
    var stats: DuckStats
    let ok = runSchedule(w, rig, StandTicks, 0 - 1, "stand", stats)
    echo("stand gate rejected=" + strings.IntToStr(stats.rejected) + " firstRejectTick=" + strings.IntToStr(stats.firstRejectTick) + " firstRejectResid_mm=" + fmtMm(stats.firstRejectResidMm) + " maxResid_mm=" + fmtMm(stats.maxResidMm) + " stallTick=" + strings.IntToStr(stats.stallTick))
    echo("stand rejected=" + strings.IntToStr(stats.rejected) + " upright_frac=" + fmtMm(float64(stats.uprightCount) / float64(stats.ticksDone)) + " maxDrift_mm=" + fmtMm(stats.maxDrift * 1000.0) + " finalDrift_mm=" + fmtMm(stats.finalDrift * 1000.0))
    echo("stand rms_deg hipL=" + fmtMm(stats.rmsHipL) + " hipR=" + fmtMm(stats.rmsHipR) + " rollL=" + fmtMm(stats.rmsRollL) + " rollR=" + fmtMm(stats.rmsRollR) + " kneeL=" + fmtMm(stats.rmsKneeL) + " kneeR=" + fmtMm(stats.rmsKneeR) + " ankleL=" + fmtMm(stats.rmsAnkleL) + " ankleR=" + fmtMm(stats.rmsAnkleR) + " neck=" + fmtMm(stats.rmsNeck) + " headPitch=" + fmtMm(stats.rmsHeadPitch) + " headYaw=" + fmtMm(stats.rmsHeadYaw) + " headRoll=" + fmtMm(stats.rmsHeadRoll))
    echo("stand final torsoZ_mm=" + fmtMm(stats.finalTorsoZ * 1000.0) + " headZ_mm=" + fmtMm(stats.finalHeadZ * 1000.0) + " hipPitchL_deg=" + fmtMm(stats.finalHipPitchDegL) + " hipPitchR_deg=" + fmtMm(stats.finalHipPitchDegR))
    if !ok:
        echo("FAIL stand engine stall at tick " + strings.IntToStr(stats.stallTick))
        return false
    if stats.rejected != 0:
        echo("FAIL stand A rejected=" + strings.IntToStr(stats.rejected))
        return false
    if stats.uprightCount != StandTicks:
        echo("stand B contract RED (data): upright=" + strings.IntToStr(stats.uprightCount) + "/" + strings.IntToStr(StandTicks) + " toppled at tick " + strings.IntToStr(stats.fallenTick) + " - real-duck flat-stand baseline")
        return true
    if stats.maxDrift > DriftLimitM:
        echo("FAIL stand C drift_mm=" + fmtMm(stats.maxDrift * 1000.0))
        return false
    if stats.rmsKneeL > AngleRmsLimitDeg:
        echo("FAIL stand D kneeL rms")
        return false
    if stats.rmsKneeR > AngleRmsLimitDeg:
        echo("FAIL stand D kneeR rms")
        return false
    if stats.rmsAnkleL > AngleRmsLimitDeg:
        echo("FAIL stand D ankleL rms")
        return false
    if stats.rmsAnkleR > AngleRmsLimitDeg:
        echo("FAIL stand D ankleR rms")
        return false
    if stats.rmsHipL > AngleRmsLimitDeg:
        echo("FAIL stand D hipL rms")
        return false
    if stats.rmsHipR > AngleRmsLimitDeg:
        echo("FAIL stand D hipR rms")
        return false
    if stats.rmsRollL > AngleRmsLimitDeg:
        echo("FAIL stand D rollL rms")
        return false
    if stats.rmsRollR > AngleRmsLimitDeg:
        echo("FAIL stand D rollR rms")
        return false
    if stats.rmsNeck > AngleRmsLimitDeg:
        echo("FAIL stand D neck rms")
        return false
    if stats.rmsHeadPitch > AngleRmsLimitDeg:
        echo("FAIL stand D headPitch rms")
        return false
    if stats.rmsHeadYaw > AngleRmsLimitDeg:
        echo("FAIL stand D headYaw rms")
        return false
    if stats.rmsHeadRoll > AngleRmsLimitDeg:
        echo("FAIL stand D headRoll rms")
        return false
    if !World3dValid(w):
        echo("FAIL stand world validity")
        return false
    if stats.uprightCount == StandTicks:
        echo("stand B/C/D GREEN: upright 100% drift_mm=" + fmtMm(stats.maxDrift * 1000.0))
    return true

# Returns 0 = recovered standing, > 0 = pushover tick, -1 = harness fail.
fn casePushRecovery(): int32 =
    var w: world3d.World3d
    let rig = buildDuck(w, int64(902))
    var stats: DuckStats
    let ok = runSchedule(w, rig, PushWaitTicks + PushTicks, PushWaitTicks, "push", stats)
    echo("push rejected=" + strings.IntToStr(stats.rejected) + " fallenTick=" + strings.IntToStr(stats.fallenTick) + " stallTick=" + strings.IntToStr(stats.stallTick) + " maxResid_mm=" + fmtMm(stats.maxResidMm) + " upright_frac=" + fmtMm(float64(stats.uprightCount) / float64(stats.ticksDone)) + " finalTorsoZ_mm=" + fmtMm(stats.finalTorsoZ * 1000.0) + " finalHeadZ_mm=" + fmtMm(stats.finalHeadZ * 1000.0) + " finalDrift_mm=" + fmtMm(stats.finalDrift * 1000.0) + " hipPitchL_deg=" + fmtMm(stats.finalHipPitchDegL) + " hipPitchR_deg=" + fmtMm(stats.finalHipPitchDegR))
    if !ok:
        echo("FAIL push engine stall at tick " + strings.IntToStr(stats.stallTick))
        return 0 - 1
    if stats.rejected != 0:
        echo("FAIL push rejected=" + strings.IntToStr(stats.rejected))
        return 0 - 1
    if stats.fallenTick >= 0:
        return stats.fallenTick
    return 0

# Engine finding evidence (M5, re-pinned to the real foot spec): ONE
# foot-spec capsule (0.0264654 kg, horizontal, sole on z = 0, zero
# constraints, zero velocity) must rest as the exact fixed point of the
# coupled two-pole solve - angular velocity stays at float dust, no
# rejected steps, no self-launch (measured before the fix: 0.48 rad/s at
# tick 0 -> 541 rad/s at tick 50 -> launched ballistically out of the
# scene).
fn caseGroundRest(): bool =
    var w: world3d.World3d
    World3dReset(w, int64(904))
    let _f = World3dSpawnCapsule(w, 0.0, 0.0, 0.0104, 0.0264654, 0.0104, 0.01, 0.7071067811865476, 0.0 - 0.7071067811865476, 0.0, 0.0)
    var maxW: float64 = 0.0
    var rejects: int32 = 0
    var i: int32 = 0
    while i < 500:
        var r = physics3d.Physics3dStep(w, "probe:rest")
        if r.statusCode != physics3d.Physics3dStatusOk:
            rejects = rejects + 1
            echo("rest rejected at " + strings.IntToStr(i))
        let wAbs = m.absFloat(w.bodyAngVx[0])
        let wAbs2 = m.absFloat(w.bodyAngVy[0])
        let wAbs3 = m.absFloat(w.bodyAngVz[0])
        var tickW = wAbs
        if wAbs2 > tickW:
            tickW = wAbs2
        if wAbs3 > tickW:
            tickW = wAbs3
        if tickW > maxW:
            maxW = tickW
        if i % 50 == 0:
            echo("rest t=" + strings.IntToStr(i) + " z_mm=" + fmtMm(w.bodyPz[0] * 1000.0) + " maxW_mrad_s=" + fmtMm(tickW * 1000.0))
        i = i + 1
    let drift = numerics.CsgSqrt(w.bodyPx[0] * w.bodyPx[0] + w.bodyPy[0] * w.bodyPy[0])
    let zErr = m.absFloat(w.bodyPz[0] - 0.0104)
    echo("rest gate maxW_mrad_s=" + fmtMm(maxW * 1000.0) + " drift_mm=" + fmtMm(drift * 1000.0) + " zerr_mm=" + fmtMm(zErr * 1000.0) + " rejects=" + strings.IntToStr(rejects))
    if rejects != 0:
        echo("FAIL rest rejected steps")
        return false
    if maxW > RestMaxWRadS:
        echo("FAIL rest angular divergence")
        return false
    if drift > RestDriftLimitM:
        echo("FAIL rest self-launch drift")
        return false
    if zErr > RestZErrLimitM:
        echo("FAIL rest height creep")
        return false
    return true

fn main(): int32 =
    if !caseGroundRest():
        return 2
    if !caseAssemblyStand():
        return 1
    let push = casePushRecovery()
    if push < 0:
        return 1
    echo("PASS microduck assembly probe (data run; stand/push contract statuses printed above)")
    return 0
