# Runtime probes for the exact broken if/return shapes (bool + u64 compare).
# New test-only file.

fn looks_safe_u(v: uint64): bool =
    if v == uint64(0):
        return false
    return v >= uint64(0x100000000)

fn get_marker(): int32 =
    return 777

fn safe_write_u(v: uint64): int32 =
    if looks_safe_u(v):
        return 1
    return get_marker()

fn main(): int32 =
    if !looks_safe_u(uint64(0x200000000)):
        return 1                     # BUG#1: huge value misjudged unsafe
    if looks_safe_u(uint64(4)):
        return 2                     # tiny value misjudged safe
    if looks_safe_u(uint64(0)):
        return 3
    if safe_write_u(uint64(4)) != 777:
        return 4                     # BUG#2: get_marker() branch dead
    if safe_write_u(uint64(0x200000000)) != 1:
        return 5
    return 0
