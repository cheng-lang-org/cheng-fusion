import cheng/core/backend/aarch64_encode as a64
import cheng/core/backend/codegen_contract as contract
import cheng/core/backend/regalloc_production_artifacts as artifacts
import cheng/core/backend/regalloc_production_emitter as emitter
import cheng/core/ir/core_types as coreir
import cheng/core/lang/parser as parser
import cheng/core/lang/typed_expr_type_arena as typearena
import cheng/core/backend/regalloc_aarch64_adapter as rega64

fn bindExactTypeArena(body: var coreir.BodyIR) =
    let source = "type Backend2CanonicalScalar = int32\n"
    var tree: parser.ParserValueExprTree
    var authority: typearena.TypedExprTypeResolutionAuthority
    var arena: typearena.TypedExprTypeArena
    var err: str
    assert(parser.ParserValueExprReadTreeFromText(source, tree, err) &&
           typearena.TypedExprTypeResolutionAuthorityBuildSameSourceInto(
               tree, authority, err) &&
           typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               tree, authority, arena, err) &&
           typearena.TypedExprTypeArenaComplete(arena) &&
           typearena.TypedExprTypeArenaStrictValidateInto(arena, err),
           "large frame str eq exact TypeArena fixture")
    assert(coreir.BodyIRBindTypeArenaArtifactCid(
               body, arena.artifactRaw32),
           "large frame str eq TypeArena bind")
    typearena.TypedExprTypeArenaRelease(arena)
    parser.ParserValueExprTreeRelease(tree)

fn makeSlot(id: int32,
            typeKind: int32,
            stackOffset: int32,
            sizeBytes: int32,
            alignBytes: int32): coreir.LocalSlot =
    var slot: coreir.LocalSlot
    slot.id = id
    slot.name = "v"
    slot.typeKind = typeKind
    slot.stackOffset = stackOffset
    slot.sizeBytes = sizeBytes
    slot.alignBytes = alignBytes
    coreir.BodyIRApplyLocalSlotDefaultProof(slot)
    return slot

fn main(): int32 =
    # B1: codegen unit composition root (dispatch fails closed without registration)
    if !rega64.RegallocA64CodegenUnitRegister():
        return 90
    var body = coreir.BodyIRNew()
    bindExactTypeArena(body)
    add(body.localSlots,
        makeSlot(0, coreir.LocalAggregateTag, 16, 32768, 8))
    add(body.localSlots,
        makeSlot(1, coreir.LocalStrTag, -1, 24, 8))
    add(body.localSlots,
        makeSlot(2, coreir.LocalStrTag, -2, 24, 8))
    add(body.localSlots,
        makeSlot(3, coreir.LocalI32Tag, 32784, 4, 4))
    var op: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = coreir.BodyOpStrEqTag
    op.target = 3
    add(op.operands, 1)
    add(op.operands, 2)
    add(body.ops, op)
    var term: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = coreir.BodyTermReturnTag
    term.resultSlot = 3
    add(term.operands, coreir.LocalI32Tag)
    let termIndex = coreir.BodyIRAppendTerm(body, term)
    let _ = coreir.BodyIRAppendBlock(body, 0, 1, termIndex)
    var callTargets: str[]
    var dataTargets: str[]
    let emission = emitter.RegallocProductionEmitFunction(
        "arm64-apple-darwin", body, "Backend2LargeFrameStrEq",
        0, callTargets, dataTargets, 0,
        artifacts.RegallocProductionFunctionKindNormal)
    if !emission.valid || !emission.receipt.valid ||
       emission.recipes.functionWords.len <= 0 ||
       emission.receipt.symbolByteLength !=
           emission.recipes.functionWords.len * 4 ||
       emission.recipes.frameBytes <= 32768 ||
       len(emission.frozenSnapshotPayloadSha256) != 64:
        return 1
    var sawStrEqOwner = false
    for recipeIndex in 0..<emission.recipes.recipes.len:
        let recipe = emission.recipes.recipes[recipeIndex]
        if !recipe.ownsBodyOp ||
           recipe.producerOpKind != coreir.BodyOpStrEqTag:
            continue
        var sawX7 = false
        var sawX8 = false
        var sawX16 = false
        var sawX17 = false
        for regIndex in 0..<recipe.writtenRegs.len:
            let reg = recipe.writtenRegs[regIndex]
            if reg == a64.A64X7:
                sawX7 = true
            elif reg == a64.A64X8:
                sawX8 = true
            elif reg == a64.A64X16:
                sawX16 = true
            elif reg == a64.A64X17:
                sawX17 = true
        if !sawX7 || !sawX8 || !sawX16 || !sawX17 ||
           (recipe.effectMask &
                (contract.RegallocA64EffectX16 |
                 contract.RegallocA64EffectX17)) !=
                (contract.RegallocA64EffectX16 |
                 contract.RegallocA64EffectX17) ||
           recipe.words.len <= 0:
            return 2
        sawStrEqOwner = true
    if !sawStrEqOwner:
        return 3
    return 0
