# Joint motor probe: the angle -> distance joint-motor primitive, verified
# in two layers (no execution.cheng dependency anywhere).
#   part 1 math: law-of-cosines round trips (0/30/90/150 deg) recover the
#     input angle to < 1e-9 deg for equal and unequal bone pairs; d is
#     monotonically decreasing from L1+L2 (0 deg, straight) to |L1-L2|
#     (180 deg, folded); JointMotorStep walks the command at the rate cap
#     and clamps exactly on the goal from both sides (P saturated, D = the
#     rate bound itself, no overshoot).
#   part 2 physics: minimal three-mass leg on the public world3d/physics3d
#     API only — static pelvis anchor, 0.5 m pelvis-knee and knee-foot
#     ConJoint bones, plus a bilateral pelvis-foot "muscle" constraint whose
#     conTarget is driven each tick by JointMotorStateTick from 1.0 m
#     (straight) toward the 90 deg cosine distance 0.7071 m. The motor is
#     effective iff the measured pelvis-foot distance enters goal +/- 0.02
#     within 100 ticks and stays there, with the realized angle within 3 deg
#     of the command.
import cheng/game/world3d
import cheng/game/physics3d
import cheng/game/csg/numerics
import cheng/game/csg/joint_motor
import std/math as m
import std/strings as strings

fn fmtMm(x: float64): str =
    let scaled: int32 = int32(m.roundFloat(x * 1000.0))
    var neg: bool = scaled < 0
    var mag: int32 = scaled
    if neg:
        mag = 0 - mag
    let intPart: int32 = mag / 1000
    let fracPart: int32 = mag % 1000
    var outStr: str = ""
    if neg:
        outStr = "-"
    outStr = outStr + strings.IntToStr(intPart) + "." + strings.CloneStrRange(strings.IntToStr(fracPart + 1000), 1, 3)
    return outStr

fn roundTripErrDeg(l1: float64, l2: float64, angleDeg: float64): float64 =
    let d = joint_motor.JointMotorAngleToDist(l1, l2, angleDeg)
    let back = joint_motor.JointMotorDistToAngle(l1, l2, d)
    return m.absFloat(back - angleDeg)

# part 1a: conversions. Round trips at 0/30/90/150 deg under 1e-9 deg,
# endpoints exact (0 = straight = L1+L2, 180 = fold = |L1-L2|), d strictly
# decreasing across the sweep.
fn caseMath(): bool =
    let tolDeg: float64 = 0.000000001
    let tolLen: float64 = 0.000000000001
    var maxErr: float64 = 0.0
    let a0 = roundTripErrDeg(0.5, 0.5, 0.0)
    let a30 = roundTripErrDeg(0.5, 0.5, 30.0)
    let a90 = roundTripErrDeg(0.5, 0.5, 90.0)
    let a150 = roundTripErrDeg(0.5, 0.5, 150.0)
    let b0 = roundTripErrDeg(0.5, 0.45, 0.0)
    let b30 = roundTripErrDeg(0.5, 0.45, 30.0)
    let b90 = roundTripErrDeg(0.5, 0.45, 90.0)
    let b150 = roundTripErrDeg(0.5, 0.45, 150.0)
    echo("case math roundtrip_nanodeg l1=0.5 l2=0.5: 0=" + strings.IntToStr(int32(m.roundFloat(a0 * 1000000000.0))) + " 30=" + strings.IntToStr(int32(m.roundFloat(a30 * 1000000000.0))) + " 90=" + strings.IntToStr(int32(m.roundFloat(a90 * 1000000000.0))) + " 150=" + strings.IntToStr(int32(m.roundFloat(a150 * 1000000000.0))))
    echo("case math roundtrip_nanodeg l1=0.5 l2=0.45: 0=" + strings.IntToStr(int32(m.roundFloat(b0 * 1000000000.0))) + " 30=" + strings.IntToStr(int32(m.roundFloat(b30 * 1000000000.0))) + " 90=" + strings.IntToStr(int32(m.roundFloat(b90 * 1000000000.0))) + " 150=" + strings.IntToStr(int32(m.roundFloat(b150 * 1000000000.0))))
    if a0 > maxErr:
        maxErr = a0
    if a30 > maxErr:
        maxErr = a30
    if a90 > maxErr:
        maxErr = a90
    if a150 > maxErr:
        maxErr = a150
    if b0 > maxErr:
        maxErr = b0
    if b30 > maxErr:
        maxErr = b30
    if b90 > maxErr:
        maxErr = b90
    if b150 > maxErr:
        maxErr = b150
    echo("case math max_roundtrip_err_nanodeg=" + strings.IntToStr(int32(m.roundFloat(maxErr * 1000000000.0))))
    if maxErr >= tolDeg:
        echo("FAIL math roundtrip over tolerance")
        return false
    # endpoints for both bone pairs
    let straight1 = joint_motor.JointMotorAngleToDist(0.5, 0.5, 0.0)
    let fold1 = joint_motor.JointMotorAngleToDist(0.5, 0.5, 180.0)
    let straight2 = joint_motor.JointMotorAngleToDist(0.5, 0.45, 0.0)
    let fold2 = joint_motor.JointMotorAngleToDist(0.5, 0.45, 180.0)
    echo("case math endpoints straight_m=" + fmtMm(straight1) + "/" + fmtMm(straight2) + " fold_m=" + fmtMm(fold1) + "/" + fmtMm(fold2))
    if m.absFloat(straight1 - 1.0) > tolLen:
        echo("FAIL math straight endpoint l1=0.5 l2=0.5")
        return false
    if m.absFloat(fold1 - 0.0) > tolLen:
        echo("FAIL math fold endpoint l1=0.5 l2=0.5")
        return false
    if m.absFloat(straight2 - 0.95) > tolLen:
        echo("FAIL math straight endpoint l1=0.5 l2=0.45")
        return false
    if m.absFloat(fold2 - 0.05) > tolLen:
        echo("FAIL math fold endpoint l1=0.5 l2=0.45")
        return false
    # strictly decreasing sweep
    let d0 = joint_motor.JointMotorAngleToDist(0.5, 0.45, 0.0)
    let d30 = joint_motor.JointMotorAngleToDist(0.5, 0.45, 30.0)
    let d90 = joint_motor.JointMotorAngleToDist(0.5, 0.45, 90.0)
    let d150 = joint_motor.JointMotorAngleToDist(0.5, 0.45, 150.0)
    let d180 = joint_motor.JointMotorAngleToDist(0.5, 0.45, 180.0)
    if !(d0 > d30):
        echo("FAIL math monotonic 0-30")
        return false
    if !(d30 > d90):
        echo("FAIL math monotonic 30-90")
        return false
    if !(d90 > d150):
        echo("FAIL math monotonic 90-150")
        return false
    if !(d150 > d180):
        echo("FAIL math monotonic 150-180")
        return false
    return true

# part 1b: the rate-capped step decision walks toward the 90 deg goal from
# both sides at exactly maxRatePerTick and clamps exactly on the goal.
fn caseStep(): bool =
    let rate: float64 = 0.01
    let goal = joint_motor.JointMotorAngleToDist(0.5, 0.5, 90.0)
    var cmd: float64 = 1.0
    let firstDown = joint_motor.JointMotorStep(cmd, 90.0, 0.5, 0.5, rate)
    var reachDown: int32 = -1
    var i: int32 = 0
    while i < 100:
        cmd = joint_motor.JointMotorStep(cmd, 90.0, 0.5, 0.5, rate)
        if reachDown < 0:
            if cmd == goal:
                reachDown = i
        i = i + 1
    echo("case step goal_m=" + fmtMm(goal) + " first_down_m=" + fmtMm(firstDown) + " reach_down_tick=" + strings.IntToStr(reachDown))
    if m.absFloat(firstDown - 0.99) > 0.000000000001:
        echo("FAIL step first downward move not one rate step")
        return false
    if reachDown < 0:
        echo("FAIL step downward walk never clamped on goal")
        return false
    if reachDown > 40:
        echo("FAIL step downward walk too slow")
        return false
    if cmd != goal:
        echo("FAIL step final command not exactly goal")
        return false
    # upward walk from an over-folded command
    var up: float64 = 0.5
    let firstUp = joint_motor.JointMotorStep(up, 90.0, 0.5, 0.5, rate)
    var reachUp: int32 = -1
    var j: int32 = 0
    while j < 100:
        up = joint_motor.JointMotorStep(up, 90.0, 0.5, 0.5, rate)
        if reachUp < 0:
            if up == goal:
                reachUp = j
        if up > goal:
            echo("FAIL step upward overshoot")
            return false
        j = j + 1
    echo("case step first_up_m=" + fmtMm(firstUp) + " reach_up_tick=" + strings.IntToStr(reachUp))
    if m.absFloat(firstUp - 0.51) > 0.000000000001:
        echo("FAIL step first upward move not one rate step")
        return false
    if reachUp < 0:
        echo("FAIL step upward walk never clamped on goal")
        return false
    if up != goal:
        echo("FAIL step upward final command not exactly goal")
        return false
    return true

# part 2: three-mass leg. pelvis static anchor at (0,0,2); knee/foot 1 kg
# each, collinear straight start (0.3,0,1.6)/(0.6,0,1.2); bones 0.5 m
# ConJoint, pelvis-foot muscle ConJoint rest 1.0 m. The motor drives the
# muscle target to the 90 deg cosine distance at 0.01 m/tick.
fn caseLeg(): bool =
    var w: world3d.World3d
    World3dReset(w, int64(31))
    let pelvis = World3dSpawnBody(w, 0.0, 0.0, 2.0, 0.0, 0.02, world3d.World3dBodyStatic)
    let knee = World3dSpawnBody(w, 0.3, 0.0, 1.6, 1.0, 0.02, world3d.World3dBodyDynamic)
    let foot = World3dSpawnBody(w, 0.6, 0.0, 1.2, 1.0, 0.02, world3d.World3dBodyDynamic)
    let _c1 = World3dAddConstraint(w, pelvis, knee, 0.5, world3d.World3dConJoint)
    let _c2 = World3dAddConstraint(w, knee, foot, 0.5, world3d.World3dConJoint)
    let muscle = World3dAddConstraint(w, pelvis, foot, 1.0, world3d.World3dConJoint)
    var motor: joint_motor.JointMotorState
    joint_motor.JointMotorStateInit(motor, 0.5, 0.5, 0.01, 0.0)
    joint_motor.JointMotorStateCommand(motor, 90.0)
    let goalDist = joint_motor.JointMotorAngleToDist(0.5, 0.5, 90.0)
    var tickI: int32 = 0
    var firstInBand: int32 = -1
    var leftBand: bool = false
    var stepRejected: bool = false
    var maxDrift: float64 = 0.0
    var finalD: float64 = 1.0
    while tickI < 240:
        let cmdDist = joint_motor.JointMotorStateTick(motor)
        w.conTarget[muscle] = cmdDist
        var r = physics3d.Physics3dStep(w, "jointmotor:probe")
        if r.statusCode != physics3d.Physics3dStatusOk:
            stepRejected = true
        let dx = w.bodyPx[foot] - w.bodyPx[pelvis]
        let dy = w.bodyPy[foot] - w.bodyPy[pelvis]
        let dz = w.bodyPz[foot] - w.bodyPz[pelvis]
        finalD = numerics.CsgSqrt(dx * dx + dy * dy + dz * dz)
        let drift = m.absFloat(finalD - cmdDist)
        if drift > maxDrift:
            maxDrift = drift
        let off = m.absFloat(finalD - goalDist)
        if firstInBand < 0:
            if off <= 0.02:
                firstInBand = tickI
        if firstInBand >= 0:
            if off > 0.02:
                leftBand = true
        tickI = tickI + 1
    let finalAngle = joint_motor.JointMotorDistToAngle(0.5, 0.5, finalD)
    let angleErr = m.absFloat(finalAngle - 90.0)
    echo("case leg goal_m=" + fmtMm(goalDist) + " first_in_band_tick=" + strings.IntToStr(firstInBand) + " final_d_m=" + fmtMm(finalD) + " final_angle_deg=" + fmtMm(finalAngle) + " max_drift_m=" + fmtMm(maxDrift))
    if stepRejected:
        echo("FAIL leg physics step rejected")
        return false
    if firstInBand < 0:
        echo("FAIL leg distance never entered goal band")
        return false
    if firstInBand > 100:
        echo("FAIL leg distance entered band too late")
        return false
    if leftBand:
        echo("FAIL leg distance left goal band after entry")
        return false
    if angleErr > 3.0:
        echo("FAIL leg realized angle off command")
        return false
    return true

fn main(): int32 =
    if !caseMath():
        echo("FAIL caseMath")
        return 1
    if !caseStep():
        echo("FAIL caseStep")
        return 1
    if !caseLeg():
        echo("FAIL caseLeg")
        return 1
    echo("PASS joint motor probe")
    return 0
