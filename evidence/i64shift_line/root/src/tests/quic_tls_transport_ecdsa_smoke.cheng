import std/system
import std/result
import std/rawbytes
import std/crypto/ecnist
import std/tls/x509
import cheng/quic/tls/test_pki

fn main(): int32 =
    let policy = test_pki.msquicMakeLocalhostTransportTlsPolicy()
    assert(policy.certLeafKeyKind == x509.X509KeyEcdsaP256, " quic transport ecdsa: policy key kind")
    assert(BytesLen(policy.certPrivateKey) == 32, " quic transport ecdsa: policy private key")

    var root: x509.X509Certificate = x509.initX509Certificate()
    let rootParseRes = x509.x509ParseCertificateInto(root, policy.trustRoot0)
    if IsErr(rootParseRes):
        panic(ErrorText(rootParseRes))
    assert(root.publicKey.kind == x509.X509KeyEcdsaP256, " quic transport ecdsa: root key kind")
    let rootCaRes = x509.x509VerifyCaConstraints(root)
    if IsErr(rootCaRes):
        panic(ErrorText(rootCaRes))

    var leaf: x509.X509Certificate = x509.initX509Certificate()
    let leafParseRes = x509.x509ParseCertificateInto(leaf, policy.certChain0)
    if IsErr(leafParseRes):
        panic(ErrorText(leafParseRes))
    assert(leaf.publicKey.kind == x509.X509KeyEcdsaP256, " quic transport ecdsa: leaf key kind")
    let leafConstraintRes = x509.x509VerifyLeafConstraints(leaf)
    if IsErr(leafConstraintRes):
        panic(ErrorText(leafConstraintRes))

    let derivedLeafPubRes = ecnist.ecdsaPublicKeyFromPrivateBytes(policy.certPrivateKey)
    if IsErr(derivedLeafPubRes):
        panic(ErrorText(derivedLeafPubRes))
    assert(BytesEqual(Value(derivedLeafPubRes), leaf.publicKey.ecdsaBytes),
        " quic transport ecdsa: derived pub key")

    let msg = BytesFromString(" quic transport ecdsa sign verify")
    let signedMsgRes = ecnist.ecdsaSignBytes(policy.certPrivateKey, msg)
    if IsErr(signedMsgRes):
        panic(ErrorText(signedMsgRes))
    assert(ecnist.ecdsaVerifyTrustedBytes(leaf.publicKey.ecdsaBytes, msg, Value(signedMsgRes)),
        " quic transport ecdsa: direct sign verify")

    let rawSigRes = x509.x509DecodeEcdsaSignature(leaf.signature)
    if IsErr(rawSigRes):
        panic(ErrorText(rawSigRes))
    assert(BytesLen(Value(rawSigRes)) == 64, " quic transport ecdsa: raw signature len")
    assert(ecnist.ecdsaVerifyTrustedBytes(root.publicKey.ecdsaBytes, leaf.tbs, Value(rawSigRes)),
        " quic transport ecdsa: direct cert verify")

    let certSigRes = x509.x509VerifySignature(leaf, root)
    if IsErr(certSigRes):
        panic(ErrorText(certSigRes))
    assert(Value(certSigRes), " quic transport ecdsa: x509 signature")

    var roots = x509.initX509CertList()
    let addRootRes = x509.x509CertListAdd(roots, root)
    if IsErr(addRootRes):
        panic(ErrorText(addRootRes))
    var intermediates = x509.initX509CertList()
    let chainRes = x509.x509VerifyChain(leaf, intermediates, roots, 1800000000)
    if IsErr(chainRes):
        panic(ErrorText(chainRes))
    assert(Value(chainRes), " quic transport ecdsa: x509 chain")
    echo(" quic_tls_transport_ecdsa_smoke ok")
    return 0
