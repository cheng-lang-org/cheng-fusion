type
    R12Box =
        v: str

    R12Request =
        outputPath: str
        paths: R12Box[]

fn R12Collect(n: int32, out: var R12Box[]): bool =
    for i in 0..<n:
        var b: R12Box
        b.v = Fmt"canon_{i}"
        add(out, b)
    return true

fn R12Run(n: int32, aOut: var str, bOut: var str, cOut: var str): int32 =
    var providerCanonicalPaths: R12Box[]
    if !R12Collect(n, providerCanonicalPaths):
        return -1
    var request: R12Request
    request.outputPath = "out.exe"
    request.paths = share(providerCanonicalPaths)
    if request.paths.len != providerCanonicalPaths.len:
        return -2
    aOut = request.paths[0].v
    bOut = providerCanonicalPaths[providerCanonicalPaths.len - 1].v
    cOut = request.outputPath
    return providerCanonicalPaths.len

fn main(): int32 =
    var a: str
    var b: str
    var c: str
    let n = R12Run(3, a, b, c)
    if n != 3:
        return 10
    if a != "canon_0":
        return 11
    if b != "canon_1":
        return 12
    if c != "out.exe":
        return 13
    echo(Fmt"r12_share ok n={n} a={a} b={b} c={c}")
    return 0
