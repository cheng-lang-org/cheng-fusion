import std/os
import std/result
import std/net/transports/tcp_syscall as tcp

fn main(): int32 =
    var conn: tcp.TcpConnectionHandle
    let startRes: Result[bool] = tcp.TcpConnect4StartNonblocking("142.251.152.119", 443, conn)
    if IsErr(startRes):
        echo(ErrorText(startRes))
        return 1
    if Value(startRes):
        echo("vpn_proxy_tcp_connect_poll_live_smoke immediate ok")
        tcp.TcpClose(conn)
        return 0
    echo("vpn_proxy_tcp_connect_poll_live_smoke pending")
    var waited: int32
    while waited < 8000:
        let ready: int32 = os.fdWaitWritable(conn.fd, 20)
        if ready < 0:
            echo("vpn_proxy_tcp_connect_poll_live_smoke wait failed")
            tcp.TcpClose(conn)
            return 1
        if ready > 0:
            let pollRes: Result[bool] = tcp.TcpConnectPoll(conn)
            if IsErr(pollRes):
                echo(ErrorText(pollRes))
                tcp.TcpClose(conn)
                return 1
            if Value(pollRes):
                echo("vpn_proxy_tcp_connect_poll_live_smoke ok")
                tcp.TcpClose(conn)
                return 0
        os.SleepMs(100)
        waited = waited + 100
    echo("vpn_proxy_tcp_connect_poll_live_smoke timeout")
    tcp.TcpClose(conn)
    return 1
