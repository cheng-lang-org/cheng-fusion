type
    NestedSeqState = ref object
        marks: int32[]
        labels: str[]

    NestedSeqOwner = ref object
        state: NestedSeqState

    InlineSeqState =
        pad: int32
        marks: int32[]

    InlineSeqOwner =
        prefix: int32
        state: InlineSeqState

var nestedSeqGlobalOwner: InlineSeqOwner

fn main(): int32 =
    var state: NestedSeqState = new(NestedSeqState)
    var owner: NestedSeqOwner = new(NestedSeqOwner)
    owner.state = state

    # A fixed int32 literal array must become a real dynamic-sequence header
    # before the whole field is stored through the nested ref chain.
    owner.state.marks = [3, 5, 7]
    owner.state.labels = ["left", "right"]

    let markIndex = 1
    owner.state.marks[markIndex] = 42
    owner.state.labels[0] = "updated"

    if owner.state.marks.len != 3 || owner.state.marks[1] != 42:
        return 1
    if owner.state.labels.len != 2 || owner.state.labels[0] != "updated":
        return 2
    if owner.state.marks[0] != 3 || owner.state.marks[2] != 7:
        return 3
    if owner.state.labels[1] != "right":
        return 4

    var inlineOwner: InlineSeqOwner
    inlineOwner.prefix = 13
    inlineOwner.state.pad = 17
    inlineOwner.state.marks = [19, 23, 29]
    inlineOwner.state.marks[1] = 31
    if inlineOwner.prefix != 13 || inlineOwner.state.pad != 17:
        return 5
    if inlineOwner.state.marks.len != 3 || inlineOwner.state.marks[1] != 31:
        return 6
    if inlineOwner.state.marks[0] != 19 || inlineOwner.state.marks[2] != 29:
        return 7

    nestedSeqGlobalOwner.prefix = 37
    nestedSeqGlobalOwner.state.pad = 41
    nestedSeqGlobalOwner.state.marks = [43, 47, 53]
    let globalIndex = 2
    nestedSeqGlobalOwner.state.marks[globalIndex] = 67
    if nestedSeqGlobalOwner.prefix != 37 || nestedSeqGlobalOwner.state.pad != 41:
        return 8
    if nestedSeqGlobalOwner.state.marks.len != 3 ||
       nestedSeqGlobalOwner.state.marks[2] != 67:
        return 9
    if nestedSeqGlobalOwner.state.marks[0] != 43 ||
       nestedSeqGlobalOwner.state.marks[1] != 47:
        return 10
    return 0
