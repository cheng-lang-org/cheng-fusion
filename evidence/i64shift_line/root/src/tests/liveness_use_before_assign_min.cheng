# Parser pendingAnnotationCount shape: naked var read inside while before first assign.
fn useBefore(n: int32): int32 =
    var pending: int32
    var cursor: int32
    cursor = 0
    while cursor < n:
        if pending > 0:
            pending = 0
        if cursor - (cursor / 2) * 2 == 0:
            pending = cursor
        cursor = cursor + 1
    return pending

fn main(): int32 =
    return useBefore(8)
