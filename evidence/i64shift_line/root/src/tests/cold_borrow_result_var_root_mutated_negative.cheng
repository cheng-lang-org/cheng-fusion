@borrows
@borrow_result
fn ColdBorrowRootInvalidView(
        first: var str, second: var str,
        chooseFirst: bool): str =
    if chooseFirst:
        return first
    return second

fn main(): int32 =
    var first = "first"
    var second = "second"
    let borrowed = ColdBorrowRootInvalidView(
        first, second, true)
    return len(borrowed)
