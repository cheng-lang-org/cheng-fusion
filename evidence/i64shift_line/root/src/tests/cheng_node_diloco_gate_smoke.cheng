# D2 done 项门禁: chain_node tag 拼 CID 路径已删除, 工件引用必须来自真实字节。
#   (a) 未挂工件仓 -> OpenJob 硬错
#   (b) 挂仓后 open 用真实 genesis 字节 -> Ok
#   (c) quorum 未齐就 publish -> Err
#   (d) 两工人真实 SGD delta 提交后 publish -> Ok, 合并 ref 在仓内可解析, 外步推进

import std/result
import std/os
import std/rawbytes as rawbytes
import std/strings as strings
import cheng/std/bytes_layout as layout
import cheng/apps/chain_node/cheng_node as node
import cheng/apps/chain_node/cheng_node_domains as cdomain
import cheng/DiLoCo/core/diloco as dcore
import cheng/DiLoCo/artifact/store as dstore
import cheng/DiLoCo/train/codec as dcodec
import cheng/DiLoCo/train/inner_step as dinner

fn tinyBatchFill(xs: var int32[], ys: var int32[], flip: bool) =
    for s in 0..<3:
        if flip:
            add(xs, 0)
            add(xs, 1000)
            add(xs, 0)
            add(ys, 0)
            add(ys, 1000)
        else:
            add(xs, 1000)
            add(xs, 0)
            add(xs, 0)
            add(ys, 1000)
            add(ys, 0)

@borrows
fn zerosPayload(): rawbytes.Bytes =
    var zeros: int32[]
    for i in 0..<8:
        add(zeros, 0)
    var packedBytes = rawbytes.EmptyBytes()
    let packRes = dcodec.DiLoCoTrainPackI32Fill(packedBytes, zeros)
    assert(IsOk(packRes), " diloco gate smoke: pack zeros")
    return packedBytes

@borrows
fn realDeltaPayload(flip: bool): rawbytes.Bytes =
    var base: int32[]
    for i in 0..<8:
        add(base, 0)
    var xs: int32[]
    var ys: int32[]
    tinyBatchFill(xs, ys, flip)
    var wOut: int32[]
    var deltaOut: int32[]
    let sgdRes = dinner.DiLoCoInnerSgdLinearFill(wOut, deltaOut, base, xs, ys, 3, 4, 2, 3, 1, 2)
    assert(IsOk(sgdRes), " diloco gate smoke: real inner sgd")
    var packedBytes = rawbytes.EmptyBytes()
    let packRes = dcodec.DiLoCoTrainPackI32Fill(packedBytes, deltaOut)
    assert(IsOk(packRes), " diloco gate smoke: pack delta")
    return packedBytes

fn main(): int32 =
    let tmpRoot = os.GetEnvDefault("CHENG_TASK_TMPDIR", "")
    if tmpRoot == "":
        echo(" diloco gate smoke: CHENG_TASK_TMPDIR missing")
        return 1

    # ---- (a) 未挂仓: OpenJob 必须硬错 ----
    var coldNodeInit = node.ChengNodeInit("gate-cold-seed")
    assert(IsOk(coldNodeInit), " diloco gate smoke: init cold node")
    var coldNode = Value(coldNodeInit)
    let coldOpenRes = node.ChengNodeDilocoOpenJob(coldNode,
                                                    strings.CloneStr("gate-cold"),
                                                    2,
                                                    4,
                                                    60,
                                                    zerosPayload(),
                                                    zerosPayload())
    assert(IsErr(coldOpenRes), " diloco gate smoke: unattached store must fail open")

    # ---- (b) 挂仓后真实 open ----
    var gateNodeInit = node.ChengNodeInit("gate-seed")
    assert(IsOk(gateNodeInit), " diloco gate smoke: init node")
    var gateNode = Value(gateNodeInit)
    let attachRes = cdomain.ChengNodeDilocoAttachArtifactStore(gateNode.diloco,
                                                                 strings.ConcatStr(tmpRoot, "/gate-diloco-artifacts"))
    assert(IsOk(attachRes), " diloco gate smoke: attach store")
    let jobKey = "gate-job"
    assert(IsOk(node.ChengNodeDilocoOpenJob(gateNode,
                                              strings.CloneStr(jobKey),
                                              2,
                                              4,
                                              60,
                                              zerosPayload(),
                                              zerosPayload())),
           " diloco gate smoke: open with real genesis")

    assert(IsOk(node.ChengNodeDilocoJoinCohort(gateNode, strings.CloneStr(jobKey), "peer-alpha")),
           " diloco gate smoke: join alpha")
    assert(IsOk(node.ChengNodeDilocoJoinCohort(gateNode, strings.CloneStr(jobKey), "peer-bravo")),
           " diloco gate smoke: join bravo")
    assert(IsOk(node.ChengNodeDilocoFetchLease(gateNode, strings.CloneStr(jobKey), "peer-alpha")),
           " diloco gate smoke: lease alpha")
    assert(IsOk(node.ChengNodeDilocoFetchLease(gateNode, strings.CloneStr(jobKey), "peer-bravo")),
           " diloco gate smoke: lease bravo")
    assert(IsOk(node.ChengNodeDilocoReportBarrier(gateNode, strings.CloneStr(jobKey), "peer-alpha")),
           " diloco gate smoke: barrier alpha")
    let barrierBravoRes = node.ChengNodeDilocoReportBarrier(gateNode, strings.CloneStr(jobKey), "peer-bravo")
    if IsErr(barrierBravoRes):
        echo(strings.ConcatStr(" diloco gate smoke: barrier bravo error:", Error(barrierBravoRes)))
        return 1

    # ---- (c) quorum 未齐 publish 必须硬错 ----
    assert(IsOk(node.ChengNodeDilocoSubmitOuterDelta(gateNode,
                                                       strings.CloneStr(jobKey),
                                                       "peer-alpha",
                                                       128,
                                                       256,
                                                       4,
                                                       1,
                                                       2,
                                                       realDeltaPayload(false),
                                                       zerosPayload())),
           " diloco gate smoke: submit alpha")
    let earlyMergeRes = node.ChengNodeDilocoPublishMerge(gateNode, strings.CloneStr(jobKey), "peer-alpha")
    assert(IsErr(earlyMergeRes), " diloco gate smoke: merge before quorum must fail")

    # ---- (d) 齐后真实合并 ----
    assert(IsOk(node.ChengNodeDilocoSubmitOuterDelta(gateNode,
                                                       strings.CloneStr(jobKey),
                                                       "peer-bravo",
                                                       96,
                                                       192,
                                                       4,
                                                       1,
                                                       2,
                                                       realDeltaPayload(true),
                                                       zerosPayload())),
           " diloco gate smoke: submit bravo")
    assert(IsOk(node.ChengNodeDilocoPublishMerge(gateNode, strings.CloneStr(jobKey), "peer-alpha")),
           " diloco gate smoke: real merge")
    let statusRes = node.ChengNodeDilocoStatusText(gateNode, strings.CloneStr(jobKey))
    assert(IsOk(statusRes), " diloco gate smoke: status")
    let status = Value(statusRes)
    assert(strings.StrContains(status, "job_current_outer_step=1"),
           " diloco gate smoke: outer step advanced")
    assert(strings.StrContains(status, "lineage_count=2"),
           " diloco gate smoke: lineage has merged version")
    let jobBundleCid = cdomain.ChengNodeDilocoJobBundleCid(strings.CloneStr(jobKey))
    var version = dcore.DiLoCoGlobalVersion()
    let versionRes = dcore.DiLoCoFetchGlobalVersionFill(version, gateNode.diloco.state, jobBundleCid)
    assert(IsOk(versionRes), " diloco gate smoke: fetch version")
    let resolvableRes = dstore.DiLoCoArtifactStoreRefResolvable(gateNode.diloco.artifactStore, version.modelRef)
    assert(IsOk(resolvableRes), " diloco gate smoke: merged ref resolvable in store")

    echo(" diloco_gate_smoke ok")
    return 0
