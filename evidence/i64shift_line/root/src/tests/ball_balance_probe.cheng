# Ball-balance probe (milestone B1 -> B2): standing on a rolling ball.
# The facts chain cannot express a rigid ball body (the materializer
# spawns every facts part as World3dBodyDynamic and the facts schema has
# no body-kind or angular-velocity columns), so both cases inject the
# ball on the execution side with the frozen producer ball parameters:
# one solid sphere r = 0.35 m, m = 30 kg resting on the ground plane at
# (0, 0.85, r), directly under the figure's apex stance. Self-collision
# is switched on for this world so the figure-ball pair resolves through
# Contacts3dResolveBodyPairs. Protocol per case: settle anchored 0..99
# (the stations hang the figure 12 mm above the ball apex), release at
# tick 100, run to 14400.
#
#   case A (v1 surf baseline): the v1 following-target upright servo,
#     capture reflex disarmed via the per-state surface. The ball is
#     pumped into a steady roll (B1: 275.9 m at 4.75 m/s); the drift is
#     the contact proof, kept as the live control arm.
#   case B (ball-top stand): CsgBalanceSetBallMode retargets the servo
#     onto the ball frame — mass-weighted figure CoM held over the ball
#     center, ball-relative velocity damping, weak gains. Contract:
#     never toppled (head z > pelvis z at every tick), ball drift < 2 m
#     at tick 2000 (vs the v1 4.75 m/s roll), zero rejected physics
#     steps.
#
# Every 50 ticks record pelvis z / ball center z / ball x drift / ball
# wx wy / ball speed / CoM-over-ball error / head-below-pelvis; the
# trace is buffered and printed after the loop (no str work inside the
# physics loop).
import cheng/game/csg/schema
import cheng/game/csg/validation
import cheng/game/csg/producer
import cheng/game/csg/materializer
import cheng/game/csg/execution
import cheng/game/csg/numerics
import cheng/game/contacts3d
import cheng/game/world3d
import cheng/game/physics3d
import std/strings as strings
import std/math as m

const
    ProbeTotalTicks = 14400
    ProbeRecordEvery = 50
    ProbePrintEvery = 200
    ProbeDriftPassM = 0.005
    ProbeBallDriftPassM = 2.0
    ProbeBallDriftCheckTick = 2000
    ProbePelvis = 0
    ProbeHead = 2

fn fmtMm(x: float64): str =
    let scaled: int32 = int32(m.roundFloat(x * 1000.0))
    var neg: bool = scaled < 0
    var mag: int32 = scaled
    if neg:
        mag = 0 - mag
    let intPart: int32 = mag / 1000
    let fracPart: int32 = mag % 1000
    var outStr: str = ""
    if neg:
        outStr = "-"
    outStr = outStr + strings.IntToStr(intPart) + "." + strings.CloneStrRange(strings.IntToStr(fracPart + 1000), 1, 3)
    return outStr

fn reportRow(t: int32,
             pz: float64,
             bz: float64,
             drift: float64,
             wy: float64,
             wx: float64,
             bspd: float64,
             comErr: float64,
             fall: int32) =
    echo("ball t=" + strings.IntToStr(t)
        + " pelvis_z_mm=" + fmtMm(pz * 1000.0)
        + " ball_z_mm=" + fmtMm(bz * 1000.0)
        + " drift_mm=" + fmtMm(drift * 1000.0)
        + " wy_mrad=" + fmtMm(wy * 1000.0)
        + " wx_mrad=" + fmtMm(wx * 1000.0)
        + " bspd_mms=" + fmtMm(bspd * 1000.0)
        + " com_err_mm=" + fmtMm(comErr * 1000.0)
        + " head_below=" + strings.IntToStr(fall))

# Mass-weighted figure CoM horizontal distance to the ball center: the
# ball-top balance property this milestone proves (read-only metric).
@borrows
fn comErrOverBall(st: execution.CsgExecutionState, ballSlot: int32): float64 =
    var mSum: float64 = 0.0
    var comX: float64 = 0.0
    var comY: float64 = 0.0
    var pi: int32 = 0
    while pi < st.mpPartCount:
        let slot: int32 = st.mpPartSlot[pi]
        let mass: float64 = 1.0 / st.w.bodyInvMass[slot]
        mSum = mSum + mass
        comX = comX + mass * st.w.bodyPx[slot]
        comY = comY + mass * st.w.bodyPy[slot]
        pi = pi + 1
    comX = comX / mSum
    comY = comY / mSum
    let ex = comX - st.w.bodyPx[ballSlot]
    let ey = comY - st.w.bodyPy[ballSlot]
    return numerics.CsgSqrt(ex * ex + ey * ey)

type
    ProbeCaseResult =
        ok: bool
        stood: int32
        fallTick: int32
        rejected: int32
        driftMax: float64
        driftCheck: float64
        driftEnd: float64
        comErrCheck: float64
        comErrEnd: float64
        ballSpeedEnd: float64

# One case of the experiment: a full ballbalance run with the v1 surf
# servo (ballMode false) or the ball-top servo (ballMode true). All
# reporting happens inside after the physics loop; metrics ride back in
# the result.
fn runCase(label: str, ballMode: bool): ProbeCaseResult =
    var out: ProbeCaseResult
    out.ok = false
    out.stood = 0
    out.fallTick = -1
    out.rejected = 0
    out.driftMax = 0.0
    out.driftCheck = 0.0
    out.driftEnd = 0.0
    out.comErrCheck = 0.0
    out.comErrEnd = 0.0
    out.ballSpeedEnd = 0.0
    var facts: schema.CsgWorldFacts = producer.CsgProducerBuildBallBalanceScene()
    var verdict = validation.CsgValidateFacts(facts)
    if verdict.statusCode != validation.CsgValidOk:
        echo("FAIL " + label + " facts validation status=" + strings.IntToStr(verdict.statusCode))
        return out
    var w: world3d.World3d
    var mp: materializer.CsgMaterializerMapping
    var err: str = ""
    if !materializer.CsgMaterialize(facts, w, mp, err):
        echo("FAIL " + label + " materialize")
        return out
    # execution-side ball injection (the chain gap): the solid sphere
    # rests on the ground plane under the figure before execution init
    # clones the world, so the balance controller and every tick see it
    let ballSlot: int32 = world3d.World3dSpawnBody(w,
        producer.CsgBallBalanceBallCenterX,
        producer.CsgBallBalanceBallCenterY,
        producer.CsgBallBalanceBallRadiusM,
        producer.CsgBallBalanceBallMassKg,
        producer.CsgBallBalanceBallRadiusM,
        world3d.World3dBodyBallRigid)
    var st: execution.CsgExecutionState
    execution.CsgExecutionInit(st, facts, w, mp.partSlot, mp.ropeNodeSlot)
    if ballMode:
        # case B: the ball-frame servo with the conservative frozen
        # defaults; capture stepping is structurally off in this mode
        execution.CsgBalanceSetBallMode(st,
            ballSlot,
            producer.CsgBallBalanceBallRadiusM,
            execution.CsgBalanceBallGain,
            execution.CsgBalanceBallFootGain,
            execution.CsgBalanceBallDamp,
            execution.CsgBalanceBallTorsoCapMps,
            execution.CsgBalanceBallCorrCapMps)
    else:
        # case A: v1 surf baseline — gain/damp/corr-cap keep the frozen
        # defaults; the capture reflex is disarmed via the official
        # per-state surface (a 100 m/s trigger never fires; on a rolling
        # ball the world-space footsteps would drag the figure off the
        # apex and exhaust the anchor budget)
        execution.CsgBalanceSetParams(st,
            execution.CsgBalanceGain,
            execution.CsgBalanceDamp,
            execution.CsgBalanceCorrCapMps,
            100.0,
            execution.CsgCaptureStepLenM,
            2.0, 30.0, 270.0)
    let pelvisSlot: int32 = mp.partSlot[ProbePelvis]
    let headSlot: int32 = mp.partSlot[ProbeHead]
    let ballX0: float64 = st.w.bodyPx[ballSlot]
    let ballY0: float64 = st.w.bodyPy[ballSlot]
    # buffered trace (50-tick granularity, printed after the loop)
    var recTick: int32[]
    var recPelvisZ: float64[]
    var recBallZ: float64[]
    var recDrift: float64[]
    var recWy: float64[]
    var recWx: float64[]
    var recBallSpd: float64[]
    var recComErr: float64[]
    var recFall: int32[]
    var fallDrift: float64 = 0.0
    var fallPelvisMinusBallX: float64 = 0.0
    var driftMax: float64 = 0.0
    var driftCheck: float64 = 0.0
    var comErrCheck: float64 = 0.0
    var tick: int32 = 0
    while tick < ProbeTotalTicks:
        var receipt = execution.CsgExecutionTick(st, facts)
        if receipt.statusCode != physics3d.Physics3dStatusOk:
            out.rejected = out.rejected + 1
        let dx = st.w.bodyPx[ballSlot] - ballX0
        let dy = st.w.bodyPy[ballSlot] - ballY0
        let drift = numerics.CsgSqrt(dx * dx + dy * dy)
        if drift > driftMax:
            driftMax = drift
        if tick == ProbeBallDriftCheckTick:
            driftCheck = drift
            comErrCheck = comErrOverBall(st, ballSlot)
        var fallFlag: int32 = 0
        if st.w.bodyPz[headSlot] < st.w.bodyPz[pelvisSlot]:
            if out.fallTick < 0:
                out.fallTick = tick
                fallDrift = drift
                fallPelvisMinusBallX = st.w.bodyPx[pelvisSlot] - st.w.bodyPx[ballSlot]
            fallFlag = 1
        if tick % ProbeRecordEvery == 0:
            let bvx = st.w.bodyVx[ballSlot]
            let bvy = st.w.bodyVy[ballSlot]
            add(recTick, tick)
            add(recPelvisZ, st.w.bodyPz[pelvisSlot])
            add(recBallZ, st.w.bodyPz[ballSlot])
            add(recDrift, drift)
            add(recWy, st.w.bodyAngVy[ballSlot])
            add(recWx, st.w.bodyAngVx[ballSlot])
            add(recBallSpd, numerics.CsgSqrt(bvx * bvx + bvy * bvy))
            add(recComErr, comErrOverBall(st, ballSlot))
            add(recFall, fallFlag)
        tick = tick + 1
    # buffered trace out (physics loop is done)
    var k: int32 = 0
    while k < recTick.len:
        if recTick[k] % ProbePrintEvery == 0 || recFall[k] == 1 || k == recTick.len - 1:
            reportRow(recTick[k], recPelvisZ[k], recBallZ[k], recDrift[k], recWy[k], recWx[k], recBallSpd[k], recComErr[k], recFall[k])
        k = k + 1
    var stood: int32 = 0
    if out.fallTick >= 0:
        stood = out.fallTick - int32(producer.CsgBallBalanceAnchorEndTick)
    else:
        stood = ProbeTotalTicks - int32(producer.CsgBallBalanceAnchorEndTick)
    let last: int32 = recTick.len - 1
    out.stood = stood
    out.driftMax = driftMax
    out.driftCheck = driftCheck
    out.comErrCheck = comErrCheck
    out.driftEnd = recDrift[last]
    out.comErrEnd = recComErr[last]
    out.ballSpeedEnd = recBallSpd[last]
    echo(label + " release_tick=" + strings.IntToStr(int32(producer.CsgBallBalanceAnchorEndTick))
        + " stood_ticks=" + strings.IntToStr(stood)
        + " fall_tick=" + strings.IntToStr(out.fallTick)
        + " drift_max_mm=" + fmtMm(driftMax * 1000.0)
        + " drift_check_mm=" + fmtMm(driftCheck * 1000.0)
        + " rejected=" + strings.IntToStr(out.rejected))
    if out.fallTick >= 0:
        var dir: str = "+x"
        if fallPelvisMinusBallX < 0.0:
            dir = "-x"
        echo(label + " figure fell at t=" + strings.IntToStr(out.fallTick)
            + " dir=" + dir
            + " pelvis_minus_ball_x_mm=" + fmtMm(fallPelvisMinusBallX * 1000.0)
            + " drift_at_fall_mm=" + fmtMm(fallDrift * 1000.0))
    out.ok = true
    return out

fn main(): int32 =
    # self-collision on: the figure-ball pair resolves through
    # Contacts3dResolveBodyPairs (without it the bodies interpenetrate
    # and the ball never feels the rider — both cases go contact-free)
    contacts3d.Contacts3dSelfCollisionSet(1)
    var surf = runCase("caseA_v1surf", false)
    var stand = runCase("caseB_balltop", true)
    if !surf.ok || !stand.ok:
        return 1
    # shared: zero rejected physics steps anywhere in either case
    if surf.rejected != 0 || stand.rejected != 0:
        echo("FAIL ball balance physics rejections")
        return 1
    # case A: the B1 contract — the ball really moved (contact proven)
    if surf.driftMax <= ProbeDriftPassM:
        echo("FAIL ball balance caseA no ball motion (contact unproven)")
        return 1
    # case B: the stand contract — never toppled, drift under the band
    # at the check tick (v1 control: 4.75 m/s steady roll)
    if stand.fallTick >= 0:
        echo("FAIL ball balance caseB figure fell at tick " + strings.IntToStr(stand.fallTick))
        return 1
    if stand.driftCheck >= ProbeBallDriftPassM:
        echo("FAIL ball balance caseB drift " + fmtMm(stand.driftCheck * 1000.0)
            + " mm at tick " + strings.IntToStr(ProbeBallDriftCheckTick))
        return 1
    echo("PASS ball balance probe (caseA drift_max=" + fmtMm(surf.driftMax * 1000.0)
        + "mm stood=" + strings.IntToStr(surf.stood)
        + "; caseB drift@" + strings.IntToStr(ProbeBallDriftCheckTick) + "=" + fmtMm(stand.driftCheck * 1000.0)
        + "mm drift_end=" + fmtMm(stand.driftEnd * 1000.0)
        + "mm com_err_end=" + fmtMm(stand.comErrEnd * 1000.0)
        + "mm ball_spd_end=" + fmtMm(stand.ballSpeedEnd * 1000.0)
        + "mm_s stood=" + strings.IntToStr(stand.stood) + ")")
    return 0
