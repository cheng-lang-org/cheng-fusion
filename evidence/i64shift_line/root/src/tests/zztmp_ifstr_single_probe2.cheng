fn pick3(c: int32): str =
    return if c == 1: "a" else: if c == 2: "b" else: "c"

fn pickv(c: bool, x: var str): str =
    let out: str = if c: x else: "fallback"
    return out

fn picki(c: bool): int32 =
    return if c: 7 else: 9

fn main(): int32 =
    if pick3(2) != "b":
        return 1
    if pick3(3) != "c":
        return 2
    var s: str
    s = "own"
    if pickv(false, s) != "fallback":
        return 3
    if pickv(true, s) != "own":
        return 6
    if picki(true) != 7:
        return 4
    if picki(false) != 9:
        return 5
    return 0
