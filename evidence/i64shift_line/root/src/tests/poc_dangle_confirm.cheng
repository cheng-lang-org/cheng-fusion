import std/crypto/ecnist as ecnist
import std/result
import std/rawbytes
import std/system
import std/strings
import std/strutils as strutil

fn hexVal(c: int32): int32 =
    if c >= int32('0') && c <= int32('9'):
        return c - int32('0')
    if c >= int32('a') && c <= int32('f'):
        return c - int32('a') + 10
    if c >= int32('A') && c <= int32('F'):
        return c - int32('A') + 10
    return 0

fn fillHex(b: var Bytes, h: str) =
    let n: int32 = strings.Len(h) / 2
    var i: int32
    while i < n:
        BytesSet(b, i, hexVal(int32(h[i*2])) * 16 + hexVal(int32(h[i*2+1])))
        i = i + 1

fn main(): int32 =
    let pkHex: str = "046B17D1F2E12C4247F8BCE6E563A440F277037D812DEB33A0F4A13945D898C2964FE342E2FE1A7F9B8EE7EB4A7C0F9E162BCE33576B315ECECBB6406837BF51F5"
    # Baseline: owned pubkey, should always pass
    var okFail: int32
    var dangleFail: int32
    var i: int32
    while i < 5000:
        # A) owned correct pubkey
        var a: Bytes = BytesAlloc(65)
        fillHex(a, pkHex)
        var outA: ecnist.EcPointFixed
        if IsErr(ecnist.EcdsaParsePublicKeyPointFixedBytes(a, true, outA)):
            okFail = okFail + 1
        # B) dangling: view into a, free a, alloc+scribble b (reuse), then check view
        var src: Bytes = BytesAlloc(65)
        fillHex(src, pkHex)
        let view: Bytes = BytesSliceView(src, 0, 65)
        BytesFree(src)
        var scribble: Bytes = BytesAlloc(65)
        var k: int32
        while k < 65:
            BytesSet(scribble, k, 0xAB)
            k = k + 1
        var outB: ecnist.EcPointFixed
        if IsErr(ecnist.EcdsaParsePublicKeyPointFixedBytes(view, true, outB)):
            dangleFail = dangleFail + 1
        BytesFree(a)
        BytesFree(scribble)
        i = i + 1
    echo(strutil.Join(["owned_fail=", IntToStr(okFail), " dangling_view_fail=", IntToStr(dangleFail), " of 5000"], ""))
    return 0
