type
    Col = object
        offset: int32
        cap: int32
        gen: int32

type
    Box = ref object
        n: int32

type
    Node = ref object
        arena: Box
        col: Col
        cnt: int32
        tag: int32

@borrows
fn compute(n: Node, k: int32): int32 =
    if n.cnt <= 0:
        return -1
    return n.cnt * k + n.tag

fn addCol(a: var Box, arr: var Col, v: int32): int32 =
    arr.offset = arr.offset + v
    arr.cap = arr.cap + 1
    a.n = a.n + v
    return v

fn outer(n: var Node, k: int32): int32 =
    addCol(n.arena, n.col, 1)
    let r1 = addCol(n.arena, n.col, compute(n, k))
    return r1

fn main(): int32 =
    var n: Node
    n = new(Node)
    n.arena = new(Box)
    n.arena.n = 100
    n.cnt = 3
    n.tag = 1
    let r = outer(n, 2)
    if r != 7:
        return 100 + r
    if n.col.cap != 2:
        return 400 + n.col.cap
    if n.col.offset != 8:
        return 200 + n.col.offset
    if n.arena.n != 108:
        return 300 + n.arena.n
    return 0
