# D7 resident experts: one DiLoCo job per expert, L0 hidden local,
# router emits token blocks to top-k, failover switches replica versionCid,
# no live replica hard-fails, hidden layer WAN payload is forbidden.

import std/result
import std/os
import std/rawbytes as rawbytes
import std/strings as strings
import cheng/std/bytes_layout as layout
import cheng/libp2p/core/types
import cheng/inference/qwen38_forward as fwd
import cheng/DiLoCo/core/diloco as core
import cheng/DiLoCo/artifact/store as astore
import cheng/DiLoCo/train/codec as codec
import cheng/DiLoCo/train/inner_step as inner
import cheng/DiLoCo/train/outer_merge as outer
import cheng/DiLoCo/train/qwen38_inner as q38
import cheng/DiLoCo/expert/resident as expert
import cheng/DiLoCo/tests/support

const
    SmokeInnerSteps: int32 = 4
    SmokeShardBytes: int32 = 64
    SmokeLrNum: int32 = 1
    SmokeLrDen: int32 = 64
    SmokeExpertOut: int32 = 2

fn die(msg: str): int32 =
    echo(msg)
    return 1

fn pairIds(a: int32, b: int32): int32[] =
    var ids: int32[]
    add(ids, a)
    add(ids, b)
    return ids

@borrows
fn putParams(store: var astore.DiLoCoArtifactStore,
             jobBundleCid: layout.FixedBytes32,
             values: int32[]): Result[core.DiLoCoArtifactRef] =
    var packed = rawbytes.EmptyBytes()
    let packRes = codec.DiLoCoTrainPackI32Fill(packed, values)
    if IsErr(packRes):
        return Err[core.DiLoCoArtifactRef](Error(packRes))
    var artifactRef = core.DiLoCoArtifactRef()
    let putRes = astore.DiLoCoArtifactStorePutFill(artifactRef, store, jobBundleCid, packed, SmokeShardBytes)
    if IsErr(putRes):
        return Err[core.DiLoCoArtifactRef](Error(putRes))
    return Ok[core.DiLoCoArtifactRef](artifactRef)

@borrows
fn hopForExpert(plan: expert.DiLoCoExpertRoutePlan, expertId: int32): Result[expert.DiLoCoExpertRouteHop] =
    for i in 0..<plan.hops.len:
        if plan.hops[i].expertId == expertId:
            var hop: expert.DiLoCoExpertRouteHop
            hop.tokenIndex = plan.hops[i].tokenIndex
            hop.expertId = plan.hops[i].expertId
            hop.replicaIndex = plan.hops[i].replicaIndex
            hop.versionCid = plan.hops[i].versionCid
            hop.payloadKind = plan.hops[i].payloadKind
            hop.tokenCount = plan.hops[i].tokenCount
            return Ok[expert.DiLoCoExpertRouteHop](hop)
    return Err[expert.DiLoCoExpertRouteHop]("diloco_expert_route_smoke: hop missing")

@borrows
fn openOneWorkerJob(store: var astore.DiLoCoArtifactStore,
                    state: var core.DiLoCoState,
                    jobBundleCid: layout.FixedBytes32,
                    peer: types.Libp2pPeerId,
                    zeros: int32[]): Result[core.DiLoCoGlobalVersion] =
    let modelPut = putParams(store, jobBundleCid, zeros)
    if IsErr(modelPut):
        return Err[core.DiLoCoGlobalVersion](Error(modelPut))
    let optPut = putParams(store, jobBundleCid, zeros)
    if IsErr(optPut):
        return Err[core.DiLoCoGlobalVersion](Error(optPut))
    var openedJob = core.DiLoCoJob()
    var genesis = core.DiLoCoGlobalVersion()
    let openRes = core.DiLoCoOpenJobFill(openedJob,
                                           genesis,
                                           state,
                                           jobBundleCid,
                                           1,
                                           SmokeInnerSteps,
                                           60,
                                           Value(modelPut),
                                           Value(optPut))
    if IsErr(openRes):
        return Err[core.DiLoCoGlobalVersion](Error(openRes))
    var cohort = core.DiLoCoCohort()
    let joinRes = core.DiLoCoJoinCohortFill(cohort, state, jobBundleCid, peer)
    if IsErr(joinRes):
        return Err[core.DiLoCoGlobalVersion](Error(joinRes))
    if !state.jobs[state.jobs.len - 1].sealed:
        return Err[core.DiLoCoGlobalVersion]("diloco_expert_route_smoke: cohort not sealed")
    return Ok[core.DiLoCoGlobalVersion](genesis)

fn main(): int32 =
    let tmpRoot = os.GetEnvDefault("CHENG_TASK_TMPDIR", "")
    if tmpRoot == "":
        return die("diloco_expert_route_smoke: CHENG_TASK_TMPDIR missing")

    let hiddenApi = expert.DiLoCoExpertHiddenLayerSyncForbidden()
    if !IsErr(hiddenApi):
        return die("diloco_expert_route_smoke: hidden sync must fail")
    let hiddenKind = expert.DiLoCoExpertAssertTokenBlockPayload(expert.DiLoCoExpertPayloadHiddenLayer)
    if !IsErr(hiddenKind):
        return die("diloco_expert_route_smoke: hidden payload kind must fail")

    let planRes = q38.DiLoCoQwen38TinyPinnedPlanBuild()
    if IsErr(planRes):
        return die(Error(planRes))
    let layerPlan = Value(planRes)
    let wRes = q38.DiLoCoQwen38TinyFrozenWeightsBuild()
    if IsErr(wRes):
        return die(Error(wRes))
    let weights = Value(wRes)
    var hidden: int32[]
    let hidOk = q38.DiLoCoQwen38TinyLastHiddenI32Fill(hidden, weights, layerPlan, pairIds(1, 2))
    if IsErr(hidOk):
        return die(Error(hidOk))
    if hidden.len != fwd.Qwen38MiniHidden:
        return die("diloco_expert_route_smoke: hidden rank")

    let storeDir = tmpRoot + "/diloco-expert-artifacts"
    var store = astore.DiLoCoArtifactStore()
    let initRes = astore.DiLoCoArtifactStoreInitFill(store, storeDir)
    if IsErr(initRes):
        return die(Error(initRes))

    var zeros: int32[]
    let zeroRes = inner.DiLoCoLinearZerosFill(zeros, SmokeExpertOut, fwd.Qwen38MiniHidden)
    if IsErr(zeroRes):
        return die(Error(zeroRes))

    let job0 = support.DiLoCoTestJobBundleCid("expert-0-job")
    let job1 = support.DiLoCoTestJobBundleCid("expert-1-job")
    var peer0: types.Libp2pPeerId
    peer0.value = support.DiLoCoTestJobBundleCid("expert-0-train")
    var peer1: types.Libp2pPeerId
    peer1.value = support.DiLoCoTestJobBundleCid("expert-1-train")
    var rep00: types.Libp2pPeerId
    rep00.value = support.DiLoCoTestJobBundleCid("expert-0-replica-0")
    var rep01: types.Libp2pPeerId
    rep01.value = support.DiLoCoTestJobBundleCid("expert-0-replica-1")
    var rep10: types.Libp2pPeerId
    rep10.value = support.DiLoCoTestJobBundleCid("expert-1-replica-0")
    if types.Libp2pPeerIdEqual(peer0, peer1) || types.Libp2pPeerIdEqual(rep00, rep01):
        return die("diloco_expert_route_smoke: peer ids collided")

    var state = core.DiLoCoStateInit("diloco.expert.resident")
    let genesis0Res = openOneWorkerJob(store, state, job0, peer0, zeros)
    if IsErr(genesis0Res):
        return die(Error(genesis0Res))
    let genesis0 = Value(genesis0Res)
    let genesis1Res = openOneWorkerJob(store, state, job1, peer1, zeros)
    if IsErr(genesis1Res):
        return die(Error(genesis1Res))
    let genesis1 = Value(genesis1Res)

    var xs: int32[]
    var ys: int32[]
    for s in 0..<3:
        for k in 0..<hidden.len:
            add(xs, hidden[k])
        add(ys, inner.DiLoCoLinearScale)
        add(ys, 0)
    var lease0 = core.DiLoCoLease()
    let leaseRes = core.DiLoCoFetchLeaseFill(lease0, state, job0, peer0)
    if IsErr(leaseRes):
        return die(Error(leaseRes))
    var w0: int32[]
    var d0: int32[]
    let inner0 = inner.DiLoCoInnerSgdLinearFill(w0, d0, zeros, xs, ys, 3, SmokeInnerSteps,
                                                 SmokeExpertOut, fwd.Qwen38MiniHidden,
                                                 SmokeLrNum, SmokeLrDen)
    if IsErr(inner0):
        return die(Error(inner0))
    var barrier = core.DiLoCoBarrier()
    let br = core.DiLoCoReportInnerStepDoneFill(barrier, state, job0, peer0)
    if IsErr(br):
        return die(Error(br))
    if !barrier.sealed:
        return die("diloco_expert_route_smoke: barrier not sealed")
    let deltaPut = putParams(store, job0, d0)
    if IsErr(deltaPut):
        return die(Error(deltaPut))
    let optPut = putParams(store, job0, zeros)
    if IsErr(optPut):
        return die(Error(optPut))
    let tokens: int32 = 3 * 2 * SmokeInnerSteps
    var deltaRec = core.DiLoCoOuterDelta()
    let sub = core.DiLoCoSubmitOuterDeltaFill(deltaRec,
                                               state,
                                               job0,
                                               lease0.baseVersionCid,
                                               lease0.outerStep,
                                               peer0,
                                               Value(deltaPut),
                                               Value(optPut),
                                               3,
                                               tokens,
                                               SmokeInnerSteps,
                                               tokens,
                                               1)
    if IsErr(sub):
        return die(Error(sub))
    var commit = core.DiLoCoMergeCommit()
    var version0 = core.DiLoCoGlobalVersion()
    let mergeRes = outer.DiLoCoOuterMergeAndPublishFill(commit, version0, store, state, job0, peer0, SmokeShardBytes)
    if IsErr(mergeRes):
        return die(Error(mergeRes))
    if layout.FixedBytes32Equal(version0.versionCid, genesis0.versionCid):
        return die("diloco_expert_route_smoke: expert0 versionCid did not change")

    var router: int32[]
    for e in 0..<2:
        for k in 0..<hidden.len:
            if e == 0:
                add(router, hidden[k])
            else:
                add(router, 0)
    var registry = expert.DiLoCoExpertRegistry()
    let regOk = expert.DiLoCoExpertRegistryInitFill(registry, 2, 2, fwd.Qwen38MiniHidden, router)
    if IsErr(regOk):
        return die(Error(regOk))

    var replica00 = expert.DiLoCoExpertReplica()
    replica00.expertId = 0
    replica00.replicaIndex = 0
    replica00.peerId.value = rep00.value
    replica00.jobBundleCid = job0
    replica00.versionCid = version0.versionCid
    replica00.modelRef.stubCid = version0.modelRef.stubCid
    replica00.modelRef.blobSummaryCid = version0.modelRef.blobSummaryCid
    replica00.modelRef.manifestCid = version0.modelRef.manifestCid
    replica00.modelRef.blobCid = version0.modelRef.blobCid
    replica00.modelRef.payloadLen = version0.modelRef.payloadLen
    replica00.modelRef.paramsCid = version0.modelRef.paramsCid
    replica00.modelRef.layoutKind = version0.modelRef.layoutKind
    replica00.modelRef.dataShardCount = version0.modelRef.dataShardCount
    replica00.modelRef.parityShardCount = version0.modelRef.parityShardCount
    replica00.modelRef.shardPayloadBytes = version0.modelRef.shardPayloadBytes
    replica00.alive = true
    let r00 = expert.DiLoCoExpertReplicaRegisterFill(registry, replica00)
    if IsErr(r00):
        return die(Error(r00))

    var replica01 = expert.DiLoCoExpertReplica()
    replica01.expertId = 0
    replica01.replicaIndex = 1
    replica01.peerId.value = rep01.value
    replica01.jobBundleCid = job0
    replica01.versionCid = genesis0.versionCid
    replica01.modelRef.stubCid = genesis0.modelRef.stubCid
    replica01.modelRef.blobSummaryCid = genesis0.modelRef.blobSummaryCid
    replica01.modelRef.manifestCid = genesis0.modelRef.manifestCid
    replica01.modelRef.blobCid = genesis0.modelRef.blobCid
    replica01.modelRef.payloadLen = genesis0.modelRef.payloadLen
    replica01.modelRef.paramsCid = genesis0.modelRef.paramsCid
    replica01.modelRef.layoutKind = genesis0.modelRef.layoutKind
    replica01.modelRef.dataShardCount = genesis0.modelRef.dataShardCount
    replica01.modelRef.parityShardCount = genesis0.modelRef.parityShardCount
    replica01.modelRef.shardPayloadBytes = genesis0.modelRef.shardPayloadBytes
    replica01.alive = true
    let r01 = expert.DiLoCoExpertReplicaRegisterFill(registry, replica01)
    if IsErr(r01):
        return die(Error(r01))

    var replica10 = expert.DiLoCoExpertReplica()
    replica10.expertId = 1
    replica10.replicaIndex = 0
    replica10.peerId.value = rep10.value
    replica10.jobBundleCid = job1
    replica10.versionCid = genesis1.versionCid
    replica10.modelRef.stubCid = genesis1.modelRef.stubCid
    replica10.modelRef.blobSummaryCid = genesis1.modelRef.blobSummaryCid
    replica10.modelRef.manifestCid = genesis1.modelRef.manifestCid
    replica10.modelRef.blobCid = genesis1.modelRef.blobCid
    replica10.modelRef.payloadLen = genesis1.modelRef.payloadLen
    replica10.modelRef.paramsCid = genesis1.modelRef.paramsCid
    replica10.modelRef.layoutKind = genesis1.modelRef.layoutKind
    replica10.modelRef.dataShardCount = genesis1.modelRef.dataShardCount
    replica10.modelRef.parityShardCount = genesis1.modelRef.parityShardCount
    replica10.modelRef.shardPayloadBytes = genesis1.modelRef.shardPayloadBytes
    replica10.alive = true
    let r10 = expert.DiLoCoExpertReplicaRegisterFill(registry, replica10)
    if IsErr(r10):
        return die(Error(r10))

    let tokensIds = pairIds(1, 2)
    var route0 = expert.DiLoCoExpertRoutePlan()
    let route0Ok = expert.DiLoCoExpertRouteTokenBlockFill(route0, registry, tokensIds, hidden)
    if IsErr(route0Ok):
        return die(Error(route0Ok))
    if route0.hopCount != 2 || route0.tokenCount != 2:
        return die("diloco_expert_route_smoke: hop count")
    let hop0aRes = hopForExpert(route0, 0)
    if IsErr(hop0aRes):
        return die(Error(hop0aRes))
    let hop0a = Value(hop0aRes)
    if hop0a.payloadKind != expert.DiLoCoExpertPayloadTokenBlock || hop0a.replicaIndex != 0:
        return die("diloco_expert_route_smoke: primary replica")
    if !layout.FixedBytes32Equal(hop0a.versionCid, version0.versionCid):
        return die("diloco_expert_route_smoke: primary versionCid")

    var yPrimary: int32[]
    let applyP = expert.DiLoCoExpertApplyFill(yPrimary, store, replica00, hidden, SmokeExpertOut, fwd.Qwen38MiniHidden)
    if IsErr(applyP):
        return die(Error(applyP))
    var yStandby: int32[]
    let applyS = expert.DiLoCoExpertApplyFill(yStandby, store, replica01, hidden, SmokeExpertOut, fwd.Qwen38MiniHidden)
    if IsErr(applyS):
        return die(Error(applyS))
    if yPrimary[0] == yStandby[0] && yPrimary[1] == yStandby[1]:
        return die("diloco_expert_route_smoke: trained expert matched genesis")

    let down0 = expert.DiLoCoExpertReplicaMarkDownFill(registry, 0, 0)
    if IsErr(down0):
        return die(Error(down0))
    var route1 = expert.DiLoCoExpertRoutePlan()
    let route1Ok = expert.DiLoCoExpertRouteTokenBlockFill(route1, registry, tokensIds, hidden)
    if IsErr(route1Ok):
        return die(Error(route1Ok))
    let hop0bRes = hopForExpert(route1, 0)
    if IsErr(hop0bRes):
        return die(Error(hop0bRes))
    let hop0b = Value(hop0bRes)
    if hop0b.replicaIndex != 1:
        return die("diloco_expert_route_smoke: failover replica")
    if !layout.FixedBytes32Equal(hop0b.versionCid, genesis0.versionCid):
        return die("diloco_expert_route_smoke: failover versionCid")
    if layout.FixedBytes32Equal(hop0b.versionCid, hop0a.versionCid):
        return die("diloco_expert_route_smoke: failover versionCid unchanged")

    let down1 = expert.DiLoCoExpertReplicaMarkDownFill(registry, 1, 0)
    if IsErr(down1):
        return die(Error(down1))
    var route2 = expert.DiLoCoExpertRoutePlan()
    let route2Ok = expert.DiLoCoExpertRouteTokenBlockFill(route2, registry, tokensIds, hidden)
    if !IsErr(route2Ok):
        return die("diloco_expert_route_smoke: no-replica must fail")

    var emptyIds: int32[]
    emptyIds = []
    var routeEmpty = expert.DiLoCoExpertRoutePlan()
    let emptyOk = expert.DiLoCoExpertRouteTokenBlockFill(routeEmpty, registry, emptyIds, hidden)
    if !IsErr(emptyOk):
        return die("diloco_expert_route_smoke: empty token block must fail")

    echo(strings.ConcatStr("diloco_expert_route_smoke failover_replica=",
                           strings.IntToStr(hop0b.replicaIndex)))
    echo("diloco_expert_route_smoke ok")
    return 0
