import std/cmdline
import std/os
import std/result
import std/strings
import std/strutils as strutil
import cheng/std/bytes_layout as layout
import cheng/core/tooling/path as chengpath
import cheng/core/tooling/compiler_request as creq
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/tooling/compiler_equivalence as ceq
import cheng/core/lang/parser
import cheng/core/backend/system_link_plan as slplan
import cheng/core/backend/system_link_exec as sexec

type
    CidEvidenceModule =
        modulePath: str
        payloadPath: str
        sourcePath: str

    CidEvidenceMigrationBuild =
        packageId: str
        entryModulePath: str
        providers: str[]
        legacyText: str
        migratedText: str
        reports: str[]

@borrows
fn CidEvidenceJoin(parts: str[]): str =
    return strutil.Join(parts, "")

@borrows
fn CidEvidenceJsonString(value: str): str =
    assert(value != "", "CID evidence: empty JSON string")
    for index in 0..<value.len:
        let ch = value[index]
        assert(Int32(ch) >= 32 && Int32(ch) != 127 &&
               ch != '"' && ch != '\\',
               "CID evidence: JSON string requires escaping")
    return CidEvidenceJoin(["\"", strings.CloneStr(value), "\""])

@borrows
fn CidEvidenceTextLess(left: str, right: str): bool =
    let shared = left.len < right.len ? left.len : right.len
    for index in 0..<shared:
        if left[index] < right[index]:
            return true
        if left[index] > right[index]:
            return false
    return left.len < right.len

fn CidEvidenceSortTexts(values: var str[]) =
    for index in 1..<values.len:
        var cursor = index
        while cursor > 0 && CidEvidenceTextLess(
                strings.CloneStr(values[cursor]),
                strings.CloneStr(values[cursor - 1])):
            let prior = strings.CloneStr(values[cursor - 1])
            values[cursor - 1] = strings.CloneStr(values[cursor])
            values[cursor] = prior
            cursor = cursor - 1

@borrows
fn CidEvidenceWrite(root: str,
                    relativePath: str,
                    text: str,
                    files: var str[]) =
    let absolute = chengpath.PathJoin(root, relativePath)
    let parent = chengpath.PathParentDir(absolute)
    if parent != "":
        os.MkdirAll(parent, 493)
    os.WriteFile(absolute, text)
    add(files, strings.CloneStr(relativePath))

@borrows
fn CidEvidenceStringArrayJson(values: str[]): str =
    var out = "["
    for index in 0..<values.len:
        if index > 0:
            out = CidEvidenceJoin([out, ","])
        out = CidEvidenceJoin([out, CidEvidenceJsonString(values[index])])
    return CidEvidenceJoin([out, "]"])

@borrows
fn CidEvidenceModulesJson(values: CidEvidenceModule[]): str =
    var out = "["
    for index in 0..<values.len:
        if index > 0:
            out = CidEvidenceJoin([out, ","])
        out = CidEvidenceJoin([
            out,
            "{\"module_path\":", CidEvidenceJsonString(values[index].modulePath),
            ",\"path\":", CidEvidenceJsonString(values[index].payloadPath),
            "}"])
    return CidEvidenceJoin([out, "]"])

@borrows
fn CidEvidenceArtifactRelativePath(role: str): str =
    if role == "binding_report":
        return "artifacts/binding-report.kv"
    if role == "compile_receipt":
        return "artifacts/compile-receipt.kv"
    if role == "csg_sidecar":
        return "artifacts/csg-sidecar.kv"
    if role == "output":
        return "artifacts/output.bin"
    if role == "semantic_receipt":
        return "artifacts/semantic-receipt.kv"
    if role == "source_receipt":
        return "artifacts/source-receipt.kv"
    if role == "consume_trace":
        return "artifacts/consume-trace.json"
    return strings.ConcatStr("artifacts/", strings.ConcatStr(strings.CloneStr(role), ".bin"))

fn CidEvidenceArtifactsJsonForRoles(roles: var str[]): str =
    CidEvidenceSortTexts(roles)
    var out = "{"
    for roleIndex in 0..<roles.len:
        if roleIndex > 0:
            out = CidEvidenceJoin([out, ","])
        out = CidEvidenceJoin([
            out,
            CidEvidenceJsonString(roles[roleIndex]),
            ":",
            CidEvidenceJsonString(
                CidEvidenceArtifactRelativePath(roles[roleIndex]))])
    return CidEvidenceJoin([out, "}"])

@borrows
fn CidEvidenceMigrationCaseIndex(
        caseId: str,
        packageId: str,
        entryModulePath: str,
        providers: str[],
        legacyModules: CidEvidenceModule[],
        migratedModules: CidEvidenceModule[],
        rootBLegacyModules: CidEvidenceModule[],
        rootBMigratedModules: CidEvidenceModule[],
        artifactsJson: str): str =
    return CidEvidenceJoin([
        "{",
        "\"artifacts\":", strings.CloneStr(artifactsJson), ",",
        "\"bootstrap_stage\":\"stage3_local\",",
        "\"case_id\":", CidEvidenceJsonString(caseId), ",",
        "\"entry_module_path\":", CidEvidenceJsonString(entryModulePath), ",",
        "\"kind\":\"migration_cross_root_fixed_point\",",
        "\"legacy_modules\":", CidEvidenceModulesJson(legacyModules), ",",
        "\"migrated_modules\":", CidEvidenceModulesJson(migratedModules), ",",
        "\"modules\":[],",
        "\"package_id\":", CidEvidenceJsonString(packageId), ",",
        "\"providers\":", CidEvidenceStringArrayJson(providers), ",",
        "\"root_b_legacy_modules\":",
        CidEvidenceModulesJson(rootBLegacyModules), ",",
        "\"root_b_migrated_modules\":",
        CidEvidenceModulesJson(rootBMigratedModules), ",",
        "\"schema\":\"cheng.cid.case_payload_index\",",
        "\"target\":\"x86_64-unknown-linux-gnu\"",
        "}\n"])

@borrows
fn CidEvidenceWriteFileList(artifactRoot: str,
                            files: var str[]) =
    add(files, "case-index.json")
    CidEvidenceSortTexts(files)
    var report = ""
    for index in 0..<files.len:
        assert(index == 0 || files[index] != files[index - 1],
               "CID evidence: duplicate payload file")
        report = CidEvidenceJoin([
            report, strings.CloneStr(files[index]), "\n"])
    let workRoot = chengpath.PathParentDir(artifactRoot)
    os.WriteFile(chengpath.PathJoin(workRoot, "case-files.list"), report)

@borrows
fn CidEvidencePrepareCase(caseId: str, caseRoot: str): bool =
    let sourceRoot = chengpath.PathJoin(caseRoot, "src")
    os.MkdirAll(sourceRoot, 493)
    os.WriteFile(
        chengpath.PathJoin(caseRoot, "cheng-package.toml"),
        "package_id = \"cheng/compiler\"\n")
    if caseId == "zero-byte-import":
        os.WriteFile(
            chengpath.PathJoin(sourceRoot, "main.cheng"),
            "import cheng/compiler/empty\n\nfn main(): int32 = 0\n")
        os.WriteFile(chengpath.PathJoin(sourceRoot, "empty.cheng"), "")
        return true
    if caseId == "source-bundle-entry" ||
       caseId == "source-csg-binding" ||
       caseId == "csg-atomic-consume":
        os.WriteFile(
            chengpath.PathJoin(sourceRoot, "main.cheng"),
            CidEvidenceJoin([
                "import cheng/compiler/helper as helper\n\n",
                "fn main(): int32 = helper.Value()\n"]))
        os.WriteFile(
            chengpath.PathJoin(sourceRoot, "helper.cheng"),
            "fn Value(): int32 = 0\n")
        return true
    if caseId == "migration-cross-root-fixed-point" ||
       caseId == "mirror-atomic-install":
        os.WriteFile(
            chengpath.PathJoin(sourceRoot, "main.cheng"),
            CidEvidenceJoin([
                "fn ExportedAdd(left: int32, right: int32): int32 =\n",
                "    return left + right\n\n",
                "fn main(): int32 =\n",
                "    if false:\n",
                "        return 1\n",
                "    elif true:\n",
                "        return ExportedAdd(20, 22) - 42\n",
                "    return 2\n"]))
        let legacyRoot = chengpath.PathJoin(caseRoot, "legacy")
        os.MkdirAll(legacyRoot, 493)
        os.WriteFile(
            chengpath.PathJoin(legacyRoot, "main.cheng"),
            CidEvidenceJoin([
                "proc ExportedAdd(left: int32, right: int32): int32 =\n",
                "    return left + right\n\n",
                "proc main(): int32 =\n",
                "    if false:\n",
                "        return 1\n",
                "    else if true:\n",
                "        return ExportedAdd(20, 22) - 42\n",
                "    return 2\n"]))
        return true
    return false

fn CidEvidenceMigrationCoreRoles(): str[] =
    return [
        "baseline_csg",
        "baseline_semantic",
        "baseline_surface",
        "migrated_csg",
        "migrated_semantic",
        "migrated_surface",
        "migration_evidence",
        "migration_proof"]

@borrows
fn CidEvidencePrepareMigrationRootForPackage(root: str,
                                             packageId: str,
                                             currentText: str,
                                             legacyText: str) =
    let sourceRoot = chengpath.PathJoin(root, "src")
    let legacyRoot = chengpath.PathJoin(root, "legacy")
    os.MkdirAll(sourceRoot, 493)
    os.MkdirAll(legacyRoot, 493)
    os.WriteFile(
        chengpath.PathJoin(root, "cheng-package.toml"),
        CidEvidenceJoin([
            "package_id = \"", strings.CloneStr(packageId), "\"\n"]))
    os.WriteFile(chengpath.PathJoin(sourceRoot, "main.cheng"), currentText)
    os.WriteFile(chengpath.PathJoin(legacyRoot, "main.cheng"), legacyText)

@borrows
fn CidEvidencePrepareMigrationRoot(root: str,
                                   currentText: str,
                                   legacyText: str) =
    CidEvidencePrepareMigrationRootForPackage(
        root, "cheng/compiler", currentText, legacyText)

@borrows
fn CidEvidenceBuildMigrationAtRoot(
        workspaceRoot: str,
        out: var CidEvidenceMigrationBuild): Result[bool] =
    let currentSourcePath = chengpath.PathJoin(
        workspaceRoot, "src/main.cheng")
    let legacySourcePath = chengpath.PathJoin(
        workspaceRoot, "legacy/main.cheng")
    let request = creq.CompilerRequestNew(
        workspaceRoot,
        currentSourcePath,
        chengpath.PathJoin(workspaceRoot, "migration-output"),
        "x86_64-unknown-linux-gnu",
        creq.EmitExe,
        "")
    var plan: slplan.SystemLinkPlanStub
    var err = ""
    if !slplan.BuildSystemLinkPlanStub(
            workspaceRoot, request, plan, err):
        return Err[bool](err)
    if plan.sourceBundleEntrySourceIndex < 0 ||
       plan.sourceBundleEntrySourceIndex >= plan.ownerModulePaths.len:
        return Err[bool]("CID evidence: migration entry index")
    let sourceBundleRes = slplan.SystemLinkPlanSourceBundleCid(plan)
    if IsErr(sourceBundleRes):
        return Err[bool](Error(sourceBundleRes))
    let packageId = strings.CloneStr(plan.packageId)
    let entryModulePath = strings.CloneStr(
        plan.ownerModulePaths[plan.sourceBundleEntrySourceIndex])
    var providers: str[]
    if !sexec.SystemLinkExecCanonicalProviderSetInto(
            plan.providerModules, providers, err):
        return Err[bool](err)
    var currentCsg: ccsg.CompilerCsg
    if !ccsg.BuildCompilerCsgInto(
            plan, Value(sourceBundleRes), currentCsg, err):
        return Err[bool](err)
    var migration: ccsg.CompilerLegacyMigration
    let migrationRes = ccsg.BuildCompilerLegacyMigrationInto(
        strings.CloneStr(workspaceRoot),
        strings.CloneStr(workspaceRoot),
        strings.CloneStr(legacySourcePath),
        packageId,
        entryModulePath,
        migration)
    if IsErr(migrationRes):
        return Err[bool](Error(migrationRes))
    if migration.units.len != 1 || migration.unitCount != 1:
        return Err[bool]("CID evidence: migration unit count")
    let currentSourceRes = os.ReadFileResult(currentSourcePath)
    let legacySourceRes = os.ReadFileResult(legacySourcePath)
    if IsErr(currentSourceRes):
        return Err[bool](Error(currentSourceRes))
    if IsErr(legacySourceRes):
        return Err[bool](Error(legacySourceRes))
    let currentText = Value(currentSourceRes)
    let legacyText = Value(legacySourceRes)
    if migration.units[0].migratedText != currentText:
        return Err[bool](
            "CID evidence: migrated bytes differ from current source")
    if !ceq.CompilerMigrationSourceReceiptEqual(
            currentCsg.sourceIdentityReceipt,
            migration.migratedArtifact.sourceIdentityReceipt) ||
       !layout.FixedBytes32Equal(
            currentCsg.canonicalGraphCid,
            migration.migratedArtifact.canonicalGraphCid):
        return Err[bool]("CID evidence: current/migrated fixed point")
    var evidence: ceq.CompilerMigrationEvidence
    let evidenceRes = ceq.CompilerMigrationEvidenceMake(
        migration, evidence)
    if IsErr(evidenceRes):
        return Err[bool](Error(evidenceRes))
    CidEvidenceSortTexts(providers)
    let canonicalOutputDigest = ccsg.CompileOutputDigest(
        request.outputPath,
        request.targetTriple,
        providers,
        currentCsg.canonicalGraphCid)
    var baselineSemantic: sexec.CompileSemanticReceipt
    if !sexec.SystemLinkExecCompileSemanticReceiptFromCanonicalCsgMakeInto(
            migration.baselineArtifact.sourceIdentityReceipt,
            migration.baselineArtifact.canonicalGraphCid,
            canonicalOutputDigest,
            request.targetTriple,
            "stage3_local",
            providers,
            baselineSemantic,
            err):
        return Err[bool](err)
    var migratedSemantic: sexec.CompileSemanticReceipt
    if !sexec.SystemLinkExecCompileSemanticReceiptFromCanonicalCsgMakeInto(
            migration.migratedArtifact.sourceIdentityReceipt,
            migration.migratedArtifact.canonicalGraphCid,
            canonicalOutputDigest,
            request.targetTriple,
            "stage3_local",
            providers,
            migratedSemantic,
            err):
        return Err[bool](err)
    var proof: ceq.CompilerMigrationSemanticProof
    let proofRes = ceq.CompilerMigrationSemanticProofMake(
        strings.CloneStr(packageId),
        "stable",
        evidence,
        migration.baselineArtifact.canonicalGraphCid,
        migration.migratedArtifact.canonicalGraphCid,
        migration.baselineArtifact.exportSurface,
        migration.migratedArtifact.exportSurface,
        baselineSemantic,
        migratedSemantic,
        request.targetTriple,
        proof)
    if IsErr(proofRes):
        return Err[bool](Error(proofRes))
    if !ceq.CompilerMigrationSemanticProofPassedStable(proof, evidence):
        return Err[bool]("CID evidence: migration proof not stable")
    let evidenceReport = ceq.CompilerMigrationEvidenceReport(evidence)
    let proofReport = ceq.CompilerMigrationSemanticProofReport(proof)
    out.packageId = strings.CloneStr(packageId)
    out.entryModulePath = strings.CloneStr(entryModulePath)
    out.providers = providers
    out.legacyText = legacyText
    out.migratedText = currentText
    out.reports = [
        strings.CloneStr(migration.baselineArtifact.canonicalCsgReport),
        strings.CloneStr(sexec.SystemLinkExecCompileSemanticReceiptReport(
            baselineSemantic)),
        strings.CloneStr(ccsg.CompilerExportSurfaceReport(
            migration.baselineArtifact.exportSurface)),
        strings.CloneStr(migration.migratedArtifact.canonicalCsgReport),
        strings.CloneStr(sexec.SystemLinkExecCompileSemanticReceiptReport(
            migratedSemantic)),
        strings.CloneStr(ccsg.CompilerExportSurfaceReport(
            migration.migratedArtifact.exportSurface)),
        strings.CloneStr(evidenceReport),
        strings.CloneStr(proofReport)]
    ccsg.CompilerCsgReleaseBackendInputPayload(currentCsg)
    return Ok[bool](true)

fn CidEvidenceMigrationArtifactsJson(): str =
    var roles = CidEvidenceMigrationCoreRoles()
    let coreRoles = CidEvidenceMigrationCoreRoles()
    for roleIndex in 0..<coreRoles.len:
        add(roles, strings.ConcatStr("root_b_", strings.CloneStr(coreRoles[roleIndex])))
    return CidEvidenceArtifactsJsonForRoles(roles)

@borrows
fn CidEvidenceMigrationCase(
        caseId: str,
        caseRoot: str,
        artifactRoot: str): Result[bool] =
    var rootA: CidEvidenceMigrationBuild
    let rootAResult = CidEvidenceBuildMigrationAtRoot(caseRoot, rootA)
    if IsErr(rootAResult):
        return Err[bool](Error(rootAResult))
    let rootBPath = strings.ConcatStr(strings.CloneStr(caseRoot), "-root-b")
    CidEvidencePrepareMigrationRoot(
        rootBPath, rootA.migratedText, rootA.legacyText)
    var rootB: CidEvidenceMigrationBuild
    let rootBResult = CidEvidenceBuildMigrationAtRoot(rootBPath, rootB)
    if IsErr(rootBResult):
        return Err[bool](Error(rootBResult))
    if rootA.packageId != rootB.packageId ||
       rootA.entryModulePath != rootB.entryModulePath ||
       rootA.providers.len != rootB.providers.len ||
       rootA.reports.len != rootB.reports.len:
        return Err[bool]("CID evidence: migration cross-root shape")
    for providerIndex in 0..<rootA.providers.len:
        if rootA.providers[providerIndex] != rootB.providers[providerIndex]:
            return Err[bool]("CID evidence: migration cross-root providers")
    for reportIndex in 0..<rootA.reports.len:
        if rootA.reports[reportIndex] != rootB.reports[reportIndex]:
            return Err[bool]("CID evidence: migration cross-root bytes")

    var files: str[]
    let coreRoles = CidEvidenceMigrationCoreRoles()
    assert(coreRoles.len == rootA.reports.len,
           "CID evidence: migration report role count")
    for roleIndex in 0..<coreRoles.len:
        CidEvidenceWrite(
            strings.CloneStr(artifactRoot),
            CidEvidenceArtifactRelativePath(
                strings.CloneStr(coreRoles[roleIndex])),
            strings.CloneStr(rootA.reports[roleIndex]),
            files)
        CidEvidenceWrite(
            strings.CloneStr(artifactRoot),
            CidEvidenceArtifactRelativePath(
                strings.ConcatStr("root_b_", strings.CloneStr(coreRoles[roleIndex]))),
            strings.CloneStr(rootB.reports[roleIndex]),
            files)
    var legacyModules: CidEvidenceModule[]
    var migratedModules: CidEvidenceModule[]
    var rootBLegacyModules: CidEvidenceModule[]
    var rootBMigratedModules: CidEvidenceModule[]
    var legacyModule: CidEvidenceModule
    legacyModule.modulePath = strings.CloneStr(rootA.entryModulePath)
    legacyModule.payloadPath = "modules/root-a-legacy-main.cheng"
    add(legacyModules, legacyModule)
    var migratedModule: CidEvidenceModule
    migratedModule.modulePath = strings.CloneStr(rootA.entryModulePath)
    migratedModule.payloadPath = "modules/root-a-migrated-main.cheng"
    add(migratedModules, migratedModule)
    var rootBLegacyModule: CidEvidenceModule
    rootBLegacyModule.modulePath = strings.CloneStr(rootB.entryModulePath)
    rootBLegacyModule.payloadPath = "modules/root-b-legacy-main.cheng"
    add(rootBLegacyModules, rootBLegacyModule)
    var rootBMigratedModule: CidEvidenceModule
    rootBMigratedModule.modulePath = strings.CloneStr(rootB.entryModulePath)
    rootBMigratedModule.payloadPath = "modules/root-b-migrated-main.cheng"
    add(rootBMigratedModules, rootBMigratedModule)
    CidEvidenceWrite(
        strings.CloneStr(artifactRoot),
        "modules/root-a-legacy-main.cheng",
        strings.CloneStr(rootA.legacyText),
        files)
    CidEvidenceWrite(
        strings.CloneStr(artifactRoot),
        "modules/root-a-migrated-main.cheng",
        strings.CloneStr(rootA.migratedText),
        files)
    CidEvidenceWrite(
        strings.CloneStr(artifactRoot),
        "modules/root-b-legacy-main.cheng",
        strings.CloneStr(rootB.legacyText),
        files)
    CidEvidenceWrite(
        strings.CloneStr(artifactRoot),
        "modules/root-b-migrated-main.cheng",
        strings.CloneStr(rootB.migratedText),
        files)
    os.WriteFile(
        chengpath.PathJoin(artifactRoot, "case-index.json"),
        CidEvidenceMigrationCaseIndex(
            strings.CloneStr(caseId),
            strings.CloneStr(rootA.packageId),
            strings.CloneStr(rootA.entryModulePath),
            rootA.providers,
            legacyModules,
            migratedModules,
            rootBLegacyModules,
            rootBMigratedModules,
            CidEvidenceMigrationArtifactsJson()))
    CidEvidenceWriteFileList(strings.CloneStr(artifactRoot), files)
    return Ok[bool](true)

fn main(): int32 =
    var caseId = ""
    var caseRoot = ""
    if cmdline.hasFlag("--prepare-case"):
        if !cmdline.readFlagValue("--case", caseId) ||
           !cmdline.readFlagValue("--case-root", caseRoot) ||
           caseId == "" || caseRoot == "":
            os.WriteLine(os.Get_stderr(), "CID evidence: missing prepare flag")
            return 2
        if !CidEvidencePrepareCase(caseId, caseRoot):
            os.WriteLine(os.Get_stderr(), "CID evidence: unknown prepare case")
            return 2
        return 0
    var artifactRoot = ""
    var compiledOutput = ""
    var evidencePrefix = ""
    if !cmdline.readFlagValue("--case", caseId) ||
       !cmdline.readFlagValue("--case-root", caseRoot) ||
       !cmdline.readFlagValue("--artifact-root", artifactRoot) ||
       !cmdline.readFlagValue("--compiled-output", compiledOutput) ||
       !cmdline.readFlagValue("--evidence-prefix", evidencePrefix):
        os.WriteLine(os.Get_stderr(), "CID evidence: missing required flag")
        return 2
    if caseId == "" || caseRoot == "" || artifactRoot == "" || compiledOutput == "" ||
       evidencePrefix == "":
        os.WriteLine(os.Get_stderr(), "CID evidence: empty required flag")
        return 2
    if caseId == "migration-cross-root-fixed-point":
        let result = CidEvidenceMigrationCase(
            caseId, caseRoot, artifactRoot)
        if IsErr(result):
            os.WriteLine(os.Get_stderr(), Error(result))
            return 1
        return 0
    os.WriteLine(
        os.Get_stderr(),
        CidEvidenceJoin([
            "CID evidence: production case not implemented; CID remains RED case=",
            caseId]))
    return 17
