import std/result
import cheng/std/bytes_layout as layout
import cheng/core/tooling/path as chengpath
import cheng/core/tooling/compiler_request as creq
import cheng/core/tooling/compiler_world as cworld
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/tooling/compiler_equivalence as ceq
import cheng/core/tooling/compiler_publish_gate as cpub
import cheng/core/lang/parser
import cheng/core/backend/system_link_plan as slplan
import cheng/core/backend/system_link_exec as sexec

fn main(): int32 =
    let root = chengpath.PathCurrentDir()
    let packageId = "cheng"
    let currentSourcePath = chengpath.PathJoin(
        root,
        "src/tests/compiler_migration_fixture_canonical_plan.cheng")
    let legacySourcePath = chengpath.PathJoin(
        root,
        "src/tests/compiler_migration_fixture_legacy_input.txt")
    var noExternalPackageRoots: parser.ParserExternalPackageRoot[]
    var entryModulePath: str
    assert(parser.ParserSourcePathToModulePathExactWithExternalPackageRootsInto(
               root,
               root,
               packageId,
               noExternalPackageRoots,
               currentSourcePath,
               entryModulePath),
           " compiler publish: exact entry identity")
    let req = creq.CompilerRequestNew(
        root,
        currentSourcePath,
        "/tmp/compiler_publish_smoke.out",
        "arm64-apple-darwin",
        creq.EmitExe,
        "")
    var linkPlan: slplan.SystemLinkPlanStub
    var linkPlanErr: str
    assert(slplan.BuildSystemLinkPlanStub(
               root,
               req,
               linkPlan,
               linkPlanErr),
           " compiler publish: link plan")
    var migration: ccsg.CompilerLegacyMigration
    let migrationRes = ccsg.BuildCompilerLegacyMigrationInto(
        root,
        root,
        legacySourcePath,
        packageId,
        entryModulePath,
        migration)
    assert(IsOk(migrationRes),
           " compiler publish: real migration")
    var evidence: ceq.CompilerMigrationEvidence
    let evidenceRes = ceq.CompilerMigrationEvidenceMake(
        migration,
        evidence)
    assert(IsOk(evidenceRes) &&
           ceq.CompilerMigrationEvidenceVerify(evidence),
           " compiler publish: evidence")
    let canonicalOutputDigest = ccsg.CompileOutputDigest(
        req.outputPath,
        req.targetTriple,
        linkPlan.providerModules,
        migration.baselineArtifact.canonicalGraphCid)
    var baselineSemantic: sexec.CompileSemanticReceipt
    var migratedSemantic: sexec.CompileSemanticReceipt
    var semanticErr: str
    assert(sexec.SystemLinkExecCompileSemanticReceiptFromCanonicalCsgMakeInto(
               migration.baselineArtifact.sourceIdentityReceipt,
               migration.baselineArtifact.canonicalGraphCid,
               canonicalOutputDigest,
               req.targetTriple,
               "stage3_local",
               linkPlan.providerModules,
               baselineSemantic,
               semanticErr),
           " compiler publish: baseline semantic receipt")
    assert(sexec.SystemLinkExecCompileSemanticReceiptFromCanonicalCsgMakeInto(
               migration.migratedArtifact.sourceIdentityReceipt,
               migration.migratedArtifact.canonicalGraphCid,
               canonicalOutputDigest,
               req.targetTriple,
               "stage3_local",
               linkPlan.providerModules,
               migratedSemantic,
               semanticErr),
           " compiler publish: migrated semantic receipt")
    var proof: ceq.CompilerMigrationSemanticProof
    let proofRes = ceq.CompilerMigrationSemanticProofMake(
        packageId,
        "stable",
        evidence,
        migration.baselineArtifact.canonicalGraphCid,
        migration.migratedArtifact.canonicalGraphCid,
        migration.baselineArtifact.exportSurface,
        migration.migratedArtifact.exportSurface,
        baselineSemantic,
        migratedSemantic,
        req.targetTriple,
        proof)
    assert(IsOk(proofRes) &&
           ceq.CompilerMigrationSemanticProofPassedStable(proof, evidence),
           " compiler publish: exact proof")
    let worldHeadCid = cworld.CompilerWorldHashText(
        "compiler_publish_world",
        [packageId, "stable"])

    var stableAllowedChannel = ""
    var stableAllowedGate = 0
    var stableAllowedChecked = 0
    var stableAllowedPassed = 0
    var stableAllowedPublish = 0
    var stableAllowedProofCid = layout.FixedBytes32()
    let stableAllowedRes = cpub.CompilerPublishDecisionEvaluate(
        "stable",
        worldHeadCid,
        true,
        proof,
        evidence,
        stableAllowedChannel,
        stableAllowedGate,
        stableAllowedChecked,
        stableAllowedPassed,
        stableAllowedPublish,
        stableAllowedProofCid)
    assert(IsOk(stableAllowedRes) &&
           stableAllowedGate != 0 &&
           stableAllowedChecked != 0 &&
           stableAllowedPassed != 0 &&
           stableAllowedPublish != 0 &&
           layout.FixedBytes32Equal(stableAllowedProofCid, proof.proofCid),
           " compiler publish: stable exact pair allowed")

    var attackedProof = proof
    attackedProof.proofCid = layout.FixedBytes32()
    var stableBlockedChannel = ""
    var stableBlockedGate = 0
    var stableBlockedChecked = 0
    var stableBlockedPassed = 0
    var stableBlockedPublish = 0
    var stableBlockedProofCid = layout.FixedBytes32()
    let stableBlockedRes = cpub.CompilerPublishDecisionEvaluate(
        "stable",
        worldHeadCid,
        true,
        attackedProof,
        evidence,
        stableBlockedChannel,
        stableBlockedGate,
        stableBlockedChecked,
        stableBlockedPassed,
        stableBlockedPublish,
        stableBlockedProofCid)
    assert(IsOk(stableBlockedRes) &&
           stableBlockedGate != 0 &&
           stableBlockedChecked != 0 &&
           stableBlockedPassed == 0 &&
           stableBlockedPublish == 0,
           " compiler publish: invalid proof blocked")

    var uncheckedProof: ceq.CompilerMigrationSemanticProof
    var uncheckedEvidence: ceq.CompilerMigrationEvidence
    var edgeChannel = ""
    var edgeGate = 0
    var edgeChecked = 0
    var edgePassed = 0
    var edgePublish = 0
    var edgeProofCid = layout.FixedBytes32()
    let edgeDecisionRes = cpub.CompilerPublishDecisionEvaluate(
        "edge",
        worldHeadCid,
        false,
        uncheckedProof,
        uncheckedEvidence,
        edgeChannel,
        edgeGate,
        edgeChecked,
        edgePassed,
        edgePublish,
        edgeProofCid)
    assert(IsOk(edgeDecisionRes) &&
           edgeGate == 0 &&
           edgeChecked == 0 &&
           edgePassed == 0 &&
           edgePublish != 0 &&
           layout.FixedBytes32Equal(edgeProofCid, layout.FixedBytes32()),
           " compiler publish: edge unchecked policy")
    let report = cpub.CompilerPublishDecisionReport(
        stableAllowedChannel,
        stableAllowedGate,
        stableAllowedChecked,
        stableAllowedPassed,
        stableAllowedPublish,
        worldHeadCid,
        stableAllowedProofCid)
    assert(chengpath.TextContains(
               report,
               "schema=compiler_publish_decision"),
           " compiler publish: canonical report schema")
    echo(" compiler_publish_smoke ok")
    return 0
