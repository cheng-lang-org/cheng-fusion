import cheng/core/lang/outline_parser as op
import std/strings

fn check(cond: bool, code: int32): int32 =
    if cond:
        return 0
    return code

fn main(): int32 =
    let source = """
module test_app

import cheng/core/tooling/path

fn add(a: int32, b: int32): int32 =
    return a + b

type Point =
    x: int32
    y: int32

var globalCounter: int32

const MaxItems: int32 = 100

const
    GroupedMaxItems: int32 = 200
    GroupedHashDomain = "cheng.outline.grouped"
"""

    let parser = op.OutlineParseSource(source, "test_app")
    let c1 = check(!op.OutlineParserHasErrors(parser), 11)
    if c1 != 0: return c1

    let c2 = check(op.OutlineParserFunctionCount(parser) == 1, 12)
    if c2 != 0: return c2

    let names = op.OutlineParserDeclarationNames(parser)
    let c3 = check(names.len >= 4, 21)
    if c3 != 0: return c3

    var hasAdd: bool
    var hasPoint: bool
    var hasCounter: bool
    var hasMax: bool
    var hasGroupedMax: bool
    var hasGroupedDomain: bool
    for i in 0..<names.len:
        if names[i] == "add": hasAdd = true
        if names[i] == "Point": hasPoint = true
        if names[i] == "globalCounter": hasCounter = true
        if names[i] == "MaxItems": hasMax = true
        if names[i] == "GroupedMaxItems": hasGroupedMax = true
        if names[i] == "GroupedHashDomain": hasGroupedDomain = true
    let c4 = check(hasAdd, 22)
    if c4 != 0: return c4
    let c5 = check(hasPoint, 23)
    if c5 != 0: return c5
    let c6 = check(hasCounter, 24)
    if c6 != 0: return c6
    let c7 = check(hasMax, 25)
    if c7 != 0: return c7
    let c7a = check(hasGroupedMax, 26)
    if c7a != 0: return c7a
    let c7b = check(hasGroupedDomain, 27)
    if c7b != 0: return c7b

    let table = op.OutlineParserBuildSymbolTable(parser)
    let c8 = check(table.names.len == names.len, 31)
    if c8 != 0: return c8
    let c9 = check(table.kinds.len == names.len, 32)
    if c9 != 0: return c9
    let c10 = check(table.sourceStarts.len == names.len, 33)
    if c10 != 0: return c10
    let c11 = check(table.sourceEnds.len == names.len, 34)
    if c11 != 0: return c11
    let c12 = check(table.modulePaths.len == names.len, 35)
    if c12 != 0: return c12

    let emptyParser = op.OutlineParseSource("", "")
    let c13 = check(op.OutlineParserFunctionCount(emptyParser) == 0, 41)
    if c13 != 0: return c13
    let c14 = check(!op.OutlineParserHasErrors(emptyParser), 42)
    if c14 != 0: return c14

    let brokenParser = op.OutlineParseSource("fn broken(\n", "broken")
    let c15 = check(op.OutlineParserHasErrors(brokenParser), 51)
    if c15 != 0: return c15
    let c16 = check(op.OutlineParserDiagnosticCount(brokenParser) == 1, 52)
    if c16 != 0: return c16
    let c17 = check(op.OutlineParserDiagnosticMessage(brokenParser, 0) ==
                    "unbalanced bracket/paren", 53)
    if c17 != 0: return c17
    let c18 = check(op.OutlineParserDiagnosticSourceStart(brokenParser, 0) == 9, 54)
    if c18 != 0: return c18

    let functions = op.OutlineParserFunctionDeclarations(parser)
    let c19 = check(functions.len == 1, 61)
    if c19 != 0: return c19
    let c20 = check(functions[0].name == "add", 62)
    if c20 != 0: return c20
    let c21 = check(functions[0].sourceStart < functions[0].bodyStart, 63)
    if c21 != 0: return c21
    let c22 = check(functions[0].bodyStart < functions[0].sourceEnd, 64)
    if c22 != 0: return c22
    let c23 = check(source[functions[0].bodyStart] == 'r', 65)
    if c23 != 0: return c23

    echo("outline_parser_smoke ok")
    return 0
