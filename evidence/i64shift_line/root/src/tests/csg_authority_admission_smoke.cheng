# CSG 权威准入 smoke (任务 05 首切片)。
#
# 验证 docs/campaigns/2026-09-21-csg-decision-computer-use/contract.md §4:
# effectClass 与确认要求从注册合同表读取, 调用方布尔/effectClass 不再签发授权;
# 确认凭证绑定 动作+参数+版本+世代 且一次性消费; 授权撤销后拒绝;
# 执行前重验快照世代; 校验通过后真实状态变化生效可查。
# 逐位判词, 0 = 全绿。

import std/strings
import cheng/core/runtime/web_scene_runtime as scene
import cheng/core/runtime/web_scene_computer_use as cu
import cheng/core/runtime/web_scene_computer_use_apply as cuapply
import cheng/core/runtime/csg_action_authority as auth

fn main(): int32 =
    var fails: int32 = 0
    var err: str = ""

    # a. effectClass 与注册表不符 -> 拒绝且错误可区分 (权威路径 + 兼容路径)
    if auth.CsgActionAuthorityAdmit("Click", "publish-to-cloud", "", err):
        fails = fails | 1
    if err != auth.CsgActionAuthorityErrEffectClass:
        fails = fails | 2
    if cu.WebSceneComputerUseAdmit("Click", "publish-to-cloud", true, err):
        fails = fails | 4
    if err != cu.WebSceneComputerUseErrEffectClass:
        fails = fails | 8

    # e. 未消费凭证的确认类动作 -> 拒绝 (确认门 token 与既有合同一致)
    if auth.CsgActionAuthorityAdmit("Toggle", "external-publish", "", err):
        fails = fails | 16
    if err != cu.WebSceneComputerUseErrConfirmationRequired:
        fails = fails | 32

    # b. 同一凭证二次执行 -> 拒绝 (复用拒绝, 判词可区分)
    if !auth.CsgActionAuthorityGrantConfirm("SetText", "42"):
        fails = fails | 64
    if !auth.CsgActionAuthorityAdmit("SetText", "external-publish", "42", err):
        fails = fails | 128
    if auth.CsgActionAuthorityAdmit("SetText", "external-publish", "42", err):
        fails = fails | 256
    if err != auth.CsgActionAuthorityErrCredentialUsed:
        fails = fails | 512

    # f. 旧合同版本凭证 -> 拒绝 (版本升级后旧凭证失配)
    if !auth.CsgActionAuthorityGrantConfirm("Select", "beta"):
        fails = fails | 1024
    if !auth.CsgActionAuthorityAdvanceContractVersion("Select", 2):
        fails = fails | 2048
    if auth.CsgActionAuthorityAdmit("Select", "payment", "beta", err):
        fails = fails | 4096
    if err != auth.CsgActionAuthorityErrVersionMismatch:
        fails = fails | 8192

    # 执行前重验快照世代: 世代前进后旧凭证拒绝 (整快照严格失效)
    if !auth.CsgActionAuthorityGrantConfirm("Click", ""):
        fails = fails | 16384
    if !auth.CsgActionAuthorityAdvanceGeneration(5):
        fails = fails | 32768
    if auth.CsgActionAuthorityAdmit("Click", "external-publish", "", err):
        fails = fails | 65536
    if err != auth.CsgActionAuthorityErrStaleGeneration:
        fails = fails | 131072

    # c. 授权撤销后 -> 拒绝 (未消费凭证全部作废)
    if !auth.CsgActionAuthorityGrantConfirm("SelectFile", "/tmp/a"):
        fails = fails | 262144
    auth.CsgActionAuthorityRevokeConfirmations()
    if auth.CsgActionAuthorityAdmit("SelectFile", "external-publish", "/tmp/a", err):
        fails = fails | 524288
    if err != auth.CsgActionAuthorityErrRevoked:
        fails = fails | 1048576

    # c 补充: 撤销后重新签发的新凭证可用 (旧撤销凭证不影子化新确认)
    if !auth.CsgActionAuthorityGrantConfirm("SelectFile", "/tmp/b"):
        fails = fails | 268435456
    if !auth.CsgActionAuthorityAdmit("SelectFile", "external-publish", "/tmp/b", err):
        fails = fails | 536870912

    # d. 校验通过后状态变化生效可查 (正例: SetText 落入场景状态并可查询)
    var graph: scene.WebSceneGraph
    scene.WebSceneGraphInit(graph)
    if !scene.WebSceneAddRouteExpectedIndex(graph, "csg_auth", 1, 1, 0):
        return 91
    if !scene.WebSceneSetActiveRouteByIndex(graph, 0):
        return 92
    if !auth.CsgActionAuthorityGrantConfirm("SetText", "hello"):
        fails = fails | 2097152
    if !cuapply.WebSceneApplyComputerUseTypedAction(
           graph, "SetText", "filter", "", "csg_auth_title", "hello", err):
        fails = fails | 4194304
    let seen = scene.WebSceneStateValueForRef(graph, "csg_auth_title")
    if seen != "hello":
        fails = fails | 8388608

    # d 补充: 确认类动作经权威路径消费凭证后通过
    if !auth.CsgActionAuthorityGrantConfirm("SetText", "world"):
        fails = fails | 16777216
    if !auth.CsgActionAuthorityAdmit("SetText", "payment", "world", err):
        fails = fails | 33554432

    # 未注册动作仍拒绝 (动作词表权威)
    if auth.CsgActionAuthorityAdmit("Screenshot", "search", "", err):
        fails = fails | 67108864
    if err != auth.CsgActionAuthorityErrActionKind:
        fails = fails | 134217728

    return fails
