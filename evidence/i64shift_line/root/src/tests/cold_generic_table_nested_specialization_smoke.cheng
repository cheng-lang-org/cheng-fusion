import std/tables as tables

fn coldGenericTablePut[V](
        table: var tables.Table[V], key: str, value: V) =
    tables.TablePut[V](table, key, value)

fn main(): int32 =
    var table = tables.TableInit[int32](8)
    coldGenericTablePut[int32](table, "answer", 42)
    var value: int32 = -1
    if !tables.TableTryGet[int32](table, "answer", value):
        return 1
    if value != 42:
        return 2
    return 0
