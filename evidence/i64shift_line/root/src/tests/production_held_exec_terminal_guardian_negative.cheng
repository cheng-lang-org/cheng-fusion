import cheng/core/runtime/production_held_exec_terminal_guardian as guardian

fn main(): int32 =
    if !guardian.CsgCoreProductionHeldExecTerminalGuardianInitializeBeforeLoop():
        return 2
    var guardianOwner: int32 = -1
    var admittedOwner: int32 = -1
    var err: str
    if guardian.CsgCoreProductionHeldExecTerminalGuardianBeginInto(
           -1, admittedOwner, guardianOwner, err):
        return 3
    if guardianOwner != -1 || err.len == 0:
        return 4
    return 0
