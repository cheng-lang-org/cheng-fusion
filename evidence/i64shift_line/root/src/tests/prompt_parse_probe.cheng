# Prompt parse probe (F): the deterministic prompt-to-world loop. Three
# prompts are parsed into intents, applied to scene generation, and the
# resulting worlds are physically executed and measured:
#   "WALK 2 STEPS"              -> traverse advance ~0.5 m
#   "WALK 6 STEPS"              -> traverse advance >= 0.5 m
#   "CLIMB 10 SECONDS"          -> rope climb, COM rises > 1 m
# Plus two rejection cases (unknown verb, odd steps) and a double-run
# determinism check on the 6-step world.
import cheng/game/csg/schema
import cheng/game/csg/prompt
import cheng/game/csg/validation
import cheng/game/csg/producer
import cheng/game/csg/materializer
import cheng/game/csg/execution
import cheng/game/world3d
import cheng/game/physics3d
import std/strings as strings

const
    PromptTicks = 2400

fn QuantMm(v: float64): int64 =
    let mm: int32 = int32(v * 1000.0)
    let wide: int64 = mm
    return wide

# build the world for one intent; returns the pelvis forward advance in m
@borrows
fn runIntent(intent: prompt.PromptIntent, advanceOut: var int64): int32 =
    var facts: schema.CsgWorldFacts
    if intent.climbSeconds == 10:
        facts = producer.CsgProducerBuildClimbScene()
    else:
        if intent.walkSteps <= 0:
            echo("FAIL no executable verb")
            return 1
        facts = producer.CsgProducerBuildWalkSceneSteps(intent.walkSteps)
    var verdict = validation.CsgValidateFacts(facts)
    if verdict.statusCode != validation.CsgValidOk:
        echo("FAIL facts validation")
        echo("status=" + strings.IntToStr(verdict.statusCode))
        return 1
    var w: world3d.World3d
    var mp: materializer.CsgMaterializerMapping
    var err: str = ""
    if !materializer.CsgMaterialize(facts, w, mp, err):
        echo("FAIL materialize")
        return 1
    var st: execution.CsgExecutionState
    execution.CsgExecutionInit(st, facts, w, mp.partSlot, mp.ropeNodeSlot)
    let pelvisSlot = mp.partSlot[0]
    let startX = st.w.bodyPx[pelvisSlot]
    var tick: int32 = 0
    while tick < PromptTicks:
        var receipt = execution.CsgExecutionTick(st, facts)
        if receipt.statusCode != physics3d.Physics3dStatusOk:
            echo("FAIL step rejected at tick " + strings.Int64ToStr(receipt.tick))
            return 1
        tick = tick + 1
    advanceOut = QuantMm(st.w.bodyPx[pelvisSlot] - startX)
    return 0

fn main(): int32 =
    # --- prompt 1: WALK 2 STEPS ---
    var p1: str = "WALK 2 STEPS"
    var i1 = prompt.PromptNewIntent()
    prompt.PromptParse(p1, i1)
    if !i1.parseOk:
        echo("FAIL p1 parse")
        return 1
    if i1.walkSteps != 2:
        echo("FAIL p1 steps")
        return 1
    var adv1: int64 = 0
    if runIntent(i1, adv1) != 0:
        return 1
    echo("p1 WALK 2 STEPS advance_mm=" + strings.Int64ToStr(adv1))
    if adv1 < 100 || adv1 > 4000:
        echo("FAIL p1 advance range")
        return 1
    # --- prompt 2: WALK 6 STEPS ---
    var p2: str = "walk 6 steps then stand 5 seconds"
    var i2 = prompt.PromptNewIntent()
    prompt.PromptParse(p2, i2)
    if !i2.parseOk:
        echo("FAIL p2 parse")
        return 1
    if i2.walkSteps != 6 || i2.standSeconds != 5:
        echo("FAIL p2 fields")
        return 1
    var adv2: int64 = 0
    if runIntent(i2, adv2) != 0:
        return 1
    echo("p2 WALK 6 STEPS advance_mm=" + strings.Int64ToStr(adv2))
    if adv2 < 500:
        echo("FAIL p2 advance")
        return 1
    if adv2 <= adv1:
        echo("FAIL monotonic advance")
        return 1
    # --- prompt 3: CLIMB 10 SECONDS ---
    var p3: str = "CLIMB 10 SECONDS"
    var i3 = prompt.PromptNewIntent()
    prompt.PromptParse(p3, i3)
    if !i3.parseOk:
        echo("FAIL p3 parse")
        return 1
    if i3.climbSeconds != 10:
        echo("FAIL p3 seconds")
        return 1
    var adv3: int64 = 0
    if runIntent(i3, adv3) != 0:
        return 1
    echo("p3 CLIMB 10 SECONDS ok")
    # --- rejections ---
    var p4: str = "FLY TO THE MOON"
    var bad = prompt.PromptNewIntent()
    prompt.PromptParse(p4, bad)
    if bad.parseOk:
        echo("FAIL unknown verb accepted")
        return 1
    var p5: str = "WALK 3 STEPS"
    var odd = prompt.PromptNewIntent()
    prompt.PromptParse(p5, odd)
    if !odd.parseOk:
        echo("FAIL odd steps should parse")
        return 1
    if odd.walkSteps % 2 != 1:
        echo("FAIL odd steps value")
        return 1
    echo("PASS prompt parse probe")
    return 0
