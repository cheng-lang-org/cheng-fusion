import std/os
import std/result
import std/strutils as strutil
import cheng/core/lang/parser as parser
import cheng/core/lang/intern as langintern
import cheng/core/lang/typed_expr as texpr
import cheng/core/ir/phase_arena as phase
import cheng/core/backend/system_link_plan as slplan
import cheng/core/tooling/compiler_request as creq
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/tooling/compiler_world as cworld
import cheng/core/tooling/path as chengpath

fn SnapshotFind(text: str, needle: str): int32 =
    if needle.len == 0:
        return 0
    if text.len < needle.len:
        return -1
    let candidateCount = text.len - needle.len + 1
    for i in 0..<candidateCount:
        var matched = true
        for j in 0..<needle.len:
            if text[i + j] != needle[j]:
                matched = false
                break
        if matched:
            return i
    return -1

fn SnapshotCount(text: str, needle: str): int32 =
    if needle.len == 0 || text.len < needle.len:
        return 0
    var count: int32
    let candidateCount = text.len - needle.len + 1
    for i in 0..<candidateCount:
        var matched = true
        for j in 0..<needle.len:
            if text[i + j] != needle[j]:
                matched = false
                break
        if matched:
            count = count + 1
    return count

fn SnapshotSlice(text: str, startNeedle: str, endNeedle: str): str =
    let startIndex = SnapshotFind(text, startNeedle)
    let endIndex = SnapshotFind(text, endNeedle)
    assert(startIndex >= 0, Fmt"compiler csg snapshot: missing start {startNeedle}")
    assert(endIndex > startIndex, Fmt"compiler csg snapshot: missing end {endNeedle}")
    return strutil.SliceStr(text, startIndex, endIndex - 1)

fn SnapshotAssertNoDiskRead(body: str, label: str) =
    assert(SnapshotCount(body, "chengpath.ReadTextFile") == 0,
           Fmt"compiler csg snapshot: {label} rereads through chengpath")
    assert(SnapshotCount(body, "os.ReadFile") == 0,
           Fmt"compiler csg snapshot: {label} rereads through os")
    assert(SnapshotCount(body, "CompilerCsgReadSourceTextCached") == 0,
           Fmt"compiler csg snapshot: {label} rereads through cache loader")

fn SnapshotAssertSingleReadCacheContract() =
    let sourcePath = "/tmp/compiler_csg_immutable_source_snapshot_cache_test.cheng"
    if os.FileExists(sourcePath):
        assert(os.RemoveFile(sourcePath),
               "compiler csg snapshot: stale cache fixture cleanup failed")
    os.WriteFile(sourcePath, "fn main(): int32 = 11\n")
    var noExternalRoots: parser.ParserExternalPackageRoot[]
    var overrides: ccsg.CompilerCsgSourceTextLookupEntry[]
    var cache: ccsg.CompilerCsgSourceTextLookupEntry[]
    var err: str
    var overrideIndex = ccsg.CompilerCsgSourcePathIndexInit(8)
    var cacheIndex = ccsg.CompilerCsgSourcePathIndexInit(8)
    assert(ccsg.CompilerCsgSourcePathIndexConfigureRoots(overrideIndex,
                                                         "/tmp",
                                                         "/tmp",
                                                         noExternalRoots,
                                                         err),
           Fmt"compiler csg snapshot: override index configure failed {err}")
    assert(ccsg.CompilerCsgSourcePathIndexConfigureRoots(cacheIndex,
                                                         "/tmp",
                                                         "/tmp",
                                                         noExternalRoots,
                                                         err),
           Fmt"compiler csg snapshot: cache index configure failed {err}")
    var firstText: str
    assert(ccsg.CompilerCsgReadSourceTextCached(cache,
                                                cacheIndex,
                                                overrides,
                                                overrideIndex,
                                                sourcePath,
                                                firstText,
                                                err),
           Fmt"compiler csg snapshot: initial exact read failed {err}")
    assert(firstText == "fn main(): int32 = 11\n" && cache.len == 1,
           "compiler csg snapshot: initial exact bytes not cached")
    os.WriteFile(sourcePath, "fn main(): int32 = 22\n")
    var cachedText: str
    assert(ccsg.CompilerCsgReadSourceTextCached(cache,
                                                cacheIndex,
                                                overrides,
                                                overrideIndex,
                                                sourcePath,
                                                cachedText,
                                                err),
           Fmt"compiler csg snapshot: cached read failed {err}")
    assert(cachedText == "fn main(): int32 = 11\n" && cache.len == 1,
           "compiler csg snapshot: source bytes reread after cache seal")
    assert(os.RemoveFile(sourcePath),
           "compiler csg snapshot: cache fixture cleanup failed")

fn SnapshotAssertSourceIdentityContract() =
    var noExternalRoots: parser.ParserExternalPackageRoot[]
    var err: str
    var singleRootIndex = ccsg.CompilerCsgSourcePathIndexInit(16)
    assert(ccsg.CompilerCsgSourcePathIndexConfigureRoots(singleRootIndex,
                                                         "/workspace",
                                                         "/workspace",
                                                         noExternalRoots,
                                                         err),
           Fmt"compiler csg identity: single root configure failed {err}")
    assert(ccsg.CompilerCsgSourcePathIndexRegister(singleRootIndex,
                                                   "src/tests/frozen.cheng",
                                                   0,
                                                   err),
           Fmt"compiler csg identity: relative-first insert failed {err}")
    var foundIndex: int32
    assert(ccsg.CompilerCsgSourcePathIndexFind(singleRootIndex,
                                               "/workspace/src/./tests//frozen.cheng",
                                               foundIndex,
                                               err) && foundIndex == 0,
           Fmt"compiler csg identity: dot/repeated separator lookup failed {err}")
    assert(ccsg.CompilerCsgSourcePathIndexFind(singleRootIndex,
                                               "src/tmp/../tests/frozen.cheng",
                                               foundIndex,
                                               err) && foundIndex == 0,
           Fmt"compiler csg identity: dotdot lookup failed {err}")
    assert(ccsg.CompilerCsgSourcePathIndexFind(singleRootIndex,
                                               "src\\tests\\frozen.cheng",
                                               foundIndex,
                                               err) && foundIndex == 0,
           Fmt"compiler csg identity: backslash lookup failed {err}")
    err = ""
    assert(!ccsg.CompilerCsgSourcePathIndexRegister(singleRootIndex,
                                                    "../escape.cheng",
                                                    1,
                                                    err) &&
           strutil.Contains(err, "escapes root"),
           "compiler csg identity: above-root path accepted")

    var rightRoot = parser.ParserExternalPackageRootCertifiedNew(
        "pkg://right", "pkg://right", "/right")
    var twoRoots = [rightRoot]
    var leftFirst = ccsg.CompilerCsgSourcePathIndexInit(16)
    assert(ccsg.CompilerCsgSourcePathIndexConfigureRoots(leftFirst,
                                                         "/left",
                                                         "/left",
                                                         twoRoots,
                                                         err),
           Fmt"compiler csg identity: two roots configure failed {err}")
    assert(ccsg.CompilerCsgSourcePathIndexRegister(leftFirst,
                                                   "shared/same.cheng",
                                                   0,
                                                   err),
           Fmt"compiler csg identity: package-root relative insert failed {err}")
    assert(ccsg.CompilerCsgSourcePathIndexRegister(leftFirst,
                                                   "/right/shared/same.cheng",
                                                   1,
                                                   err),
           Fmt"compiler csg identity: right same-suffix insert failed {err}")
    assert(ccsg.CompilerCsgSourcePathIndexFind(leftFirst,
                                               "/left/shared/same.cheng",
                                               foundIndex,
                                               err) && foundIndex == 0,
           "compiler csg identity: left rooted identity changed")
    assert(ccsg.CompilerCsgSourcePathIndexFind(leftFirst,
                                               "/right/shared//same.cheng",
                                               foundIndex,
                                               err) && foundIndex == 1,
           "compiler csg identity: same suffix merged across roots")
    assert(ccsg.CompilerCsgSourcePathIndexFind(leftFirst,
                                               "shared/same.cheng",
                                               foundIndex,
                                               err) && foundIndex == 0,
           "compiler csg identity: relative lookup did not use configured package root")

    var shorterExternal = parser.ParserExternalPackageRootCertifiedNew(
        "pkg://short", "pkg://short", "/x")
    var shorterRoots = [shorterExternal]
    var exactRelativeRoot = ccsg.CompilerCsgSourcePathIndexInit(16)
    assert(ccsg.CompilerCsgSourcePathIndexConfigureRoots(
               exactRelativeRoot,
               "/workspace",
               "/workspace/packages/main",
               shorterRoots,
               err),
           Fmt"compiler csg identity: exact relative root configure failed {err}")
    assert(ccsg.CompilerCsgSourcePathIndexRegister(exactRelativeRoot,
                                                   "src/main.cheng",
                                                   7,
                                                   err),
           Fmt"compiler csg identity: exact relative root insert failed {err}")
    assert(ccsg.CompilerCsgSourcePathIndexFind(
               exactRelativeRoot,
               "/workspace/packages/main/src/main.cheng",
               foundIndex,
               err) && foundIndex == 7,
           "compiler csg identity: relative path used shortest external root heuristic")
    assert(ccsg.CompilerCsgSourcePathIndexFind(exactRelativeRoot,
                                               "/x/src/main.cheng",
                                               foundIndex,
                                               err) && foundIndex == -1,
           "compiler csg identity: relative path collapsed into external root")
    var tamperedRelativeRoot =
        ccsg.CompilerCsgSourcePathIndexInitLike(exactRelativeRoot, 16)
    tamperedRelativeRoot.relativeRoot = "/x"
    err = ""
    assert(!ccsg.CompilerCsgSourcePathIndexFind(tamperedRelativeRoot,
                                                "src/main.cheng",
                                                foundIndex,
                                                err) &&
           strutil.Contains(err, "relative root certificate mismatch"),
           "compiler csg identity: relative root tamper survived")

    var rightFirst = ccsg.CompilerCsgSourcePathIndexInit(16)
    assert(ccsg.CompilerCsgSourcePathIndexConfigureRoots(rightFirst,
                                                         "/left",
                                                         "/left",
                                                         twoRoots,
                                                         err),
           Fmt"compiler csg identity: reverse roots configure failed {err}")
    assert(ccsg.CompilerCsgSourcePathIndexRegister(rightFirst,
                                                   "/right/shared/same.cheng",
                                                   1,
                                                   err) &&
           ccsg.CompilerCsgSourcePathIndexRegisterUnderRoot(rightFirst,
                                                            "/left",
                                                            "shared/tmp/../same.cheng",
                                                            0,
                                                            err),
           Fmt"compiler csg identity: reverse insertion failed {err}")
    assert(ccsg.CompilerCsgSourcePathIndexFind(rightFirst,
                                               "/left/shared/same.cheng",
                                               foundIndex,
                                               err) && foundIndex == 0 &&
           ccsg.CompilerCsgSourcePathIndexFind(rightFirst,
                                               "/right/shared/same.cheng",
                                               foundIndex,
                                               err) && foundIndex == 1,
           "compiler csg identity: insertion order changed rooted keys")

fn SnapshotAssertHardFailIndexes() =
    var noExternalRoots: parser.ParserExternalPackageRoot[]
    var err: str
    var sourceIndex = ccsg.CompilerCsgSourcePathIndexInit(16)
    assert(ccsg.CompilerCsgSourcePathIndexConfigureRoots(sourceIndex,
                                                         "/workspace",
                                                         "/workspace",
                                                         noExternalRoots,
                                                         err),
           Fmt"compiler csg hard fail: roots configure failed {err}")
    assert(ccsg.CompilerCsgSourcePathIndexRegister(sourceIndex,
                                                   "/workspace/owner.cheng",
                                                   0,
                                                   err),
           Fmt"compiler csg hard fail: owner index failed {err}")
    var edge: parser.ImportEdge
    edge.ownerModulePath = "owner"
    edge.targetModulePath = "missing"
    edge.targetSourcePath = "/workspace/missing.cheng"
    var ownerProfile: parser.NormalizedExprCallProfile
    ownerProfile.sourcePath = "/workspace/owner.cheng"
    ownerProfile.ownerModulePath = "owner"
    add(ownerProfile.importEdges, edge)
    var unresolvedProfiles = [ownerProfile]
    assert(!ccsg.CompilerCsgResolveCollectedProfileImportEdges(unresolvedProfiles,
                                                               sourceIndex,
                                                               err) &&
           strutil.Contains(err, "unresolved import edge"),
           "compiler csg hard fail: unresolved profile import accepted")

    # 新校验要求 profile 声明序即源码行序 (producerDeclarationIndexes 单调,
    # 乱序硬拒「reachable profile owner mismatch」); 正例按行序声明,
    # 同位 importc 声明仍被排除在可达集外。
    var unsortedProfile: parser.NormalizedExprCallProfile
    unsortedProfile.sourcePath = "/workspace/owner.cheng"
    unsortedProfile.ownerModulePath = "owner"
    add(unsortedProfile.decls, parser.NormalizedFunctionDecl(name: "early",
                                                             lineIndex: 5))
    add(unsortedProfile.decls, parser.NormalizedFunctionDecl(name: "late",
                                                             lineIndex: 20))
    add(unsortedProfile.decls, parser.NormalizedFunctionDecl(name: "c_decl",
                                                             lineIndex: 5,
                                                             importc: true))
    var reachable = ccsg.CompilerCsgReachableFunctionSetInit(true)
    var profileLineCounts: int32[] = [30]
    # 新签名: 行表经 PhaseArena intern 列传入 (无行 profile 传空列即可,
    # scopeLines 物化为空, 与旧版 profile.lines 为空逐字一致)。
    var lineStore: phase.PhaseArenaStore
    phase.PhaseArenaStoreInit(lineStore, 1, 64, 8)
    var lineArena = phase.PhaseArenaStoreOpenArena(lineStore, 1, 64, 8)
    var linePool = langintern.InternPoolNew()
    var lineIdColumns: phase.PhaseArenaRef[]
    var lineIdCounts: int32[]
    var unsortedProfiles = [unsortedProfile]
    var ownerModules = ["owner"]
    assert(ccsg.CompilerCsgReachableAddFunctionsFromProfiles(reachable,
                                                             unsortedProfiles,
                                                             ownerModules,
                                                             profileLineCounts,
                                                             lineStore,
                                                             lineArena,
                                                             linePool,
                                                             lineIdColumns,
                                                             lineIdCounts,
                                                             sourceIndex,
                                                             err),
           Fmt"compiler csg hard fail: structured function sort failed {err}")
    assert(reachable.startLines.len == 2 &&
           reachable.startLines[0] == 5 &&
           reachable.startLines[1] == 20 &&
           reachable.profileLineIndexProven.len == 1 &&
           reachable.profileLineIndexProven[0] &&
           ccsg.CompilerCsgReachableFunctionIndexForLine(reachable,
                                                          "/workspace/owner.cheng",
                                                          5) == 0 &&
           ccsg.CompilerCsgReachableFunctionIndexForLine(reachable,
                                                          "/workspace/owner.cheng",
                                                          20) == 1,
           "compiler csg hard fail: binary search consumed unsorted columns")
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(reachable)

    var duplicateProfile: parser.NormalizedExprCallProfile
    duplicateProfile.sourcePath = "/workspace/owner.cheng"
    duplicateProfile.ownerModulePath = "owner"
    add(duplicateProfile.decls, parser.NormalizedFunctionDecl(name: "first",
                                                              lineIndex: 5))
    add(duplicateProfile.decls, parser.NormalizedFunctionDecl(name: "second",
                                                              lineIndex: 5))
    var duplicateReachable = ccsg.CompilerCsgReachableFunctionSetInit(true)
    var duplicateProfileLineCounts: int32[] = [30]
    err = ""
    var duplicateProfiles = [duplicateProfile]
    assert(!ccsg.CompilerCsgReachableAddFunctionsFromProfiles(duplicateReachable,
                                                              duplicateProfiles,
                                                              ownerModules,
                                                              duplicateProfileLineCounts,
                                                              lineStore,
                                                              lineArena,
                                                              linePool,
                                                              lineIdColumns,
                                                              lineIdCounts,
                                                              sourceIndex,
                                                              err) &&
           strutil.Contains(err, "not strictly monotonic"),
           "compiler csg hard fail: duplicate function start line accepted")
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(duplicateReachable)
    # 旧「乱序声明由排序兜底」语义已删, 新设计对乱序声明序硬拒
    # (producerDeclarationIndexes 必须单调); 以此负向断言替代原排序覆盖。
    var misorderedProfile: parser.NormalizedExprCallProfile
    misorderedProfile.sourcePath = "/workspace/owner.cheng"
    misorderedProfile.ownerModulePath = "owner"
    add(misorderedProfile.decls, parser.NormalizedFunctionDecl(name: "late",
                                                               lineIndex: 20))
    add(misorderedProfile.decls, parser.NormalizedFunctionDecl(name: "early",
                                                               lineIndex: 5))
    var misorderedReachable = ccsg.CompilerCsgReachableFunctionSetInit(true)
    var misorderedProfileLineCounts: int32[] = [30]
    err = ""
    var misorderedProfiles = [misorderedProfile]
    assert(!ccsg.CompilerCsgReachableAddFunctionsFromProfiles(misorderedReachable,
                                                              misorderedProfiles,
                                                              ownerModules,
                                                              misorderedProfileLineCounts,
                                                              lineStore,
                                                              lineArena,
                                                              linePool,
                                                              lineIdColumns,
                                                              lineIdCounts,
                                                              sourceIndex,
                                                              err) &&
           strutil.Contains(err, "reachable profile owner mismatch"),
           "compiler csg hard fail: misordered declaration order accepted")
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(misorderedReachable)
    phase.PhaseArenaStoreCloseArena(lineStore, lineArena)
    phase.PhaseArenaStoreDestroy(lineStore)
    langintern.InternPoolRelease(linePool)

fn SnapshotAssertSnapshotValidationIndexes() =
    let ownerPath = "/workspace/owner.cheng"
    let targetPath = "/workspace/target.cheng"
    var ownerSource: texpr.TypedExprSourceText
    ownerSource.workspaceRoot = "/workspace"
    ownerSource.packageRoot = "/workspace"
    ownerSource.packageId = "snapshot-validation"
    ownerSource.sourcePath = ownerPath
    ownerSource.text = "fn owner(): int32 = target()"
    ownerSource.snapshotOnly = true
    var targetSource: texpr.TypedExprSourceText
    targetSource.workspaceRoot = "/workspace"
    targetSource.packageRoot = "/workspace"
    targetSource.packageId = "snapshot-validation"
    targetSource.sourcePath = targetPath
    targetSource.text = "fn target(): int32 = 1"
    targetSource.snapshotOnly = true
    var sourceTexts = [ownerSource, targetSource]

    var ownerScope: texpr.TypedExprFunctionScope
    ownerScope.sourcePath = ownerPath
    ownerScope.name = "owner"
    ownerScope.startLine = 1
    ownerScope.endLine = 1
    ownerScope.returnType = "int32"
    # 新索引不再回读源行: snapshot-only 上下文必须自带完整签名负载,
    # 否则按「signature missing」hard-fail。零参函数给空 join+complete。
    ownerScope.paramTypeJoin = ""
    ownerScope.paramTypesComplete = true
    ownerScope.genericNameJoin = ""
    ownerScope.genericNamesComplete = true
    var targetScope: texpr.TypedExprFunctionScope
    targetScope.sourcePath = targetPath
    targetScope.name = "target"
    targetScope.startLine = 1
    targetScope.endLine = 1
    targetScope.returnType = "int32"
    targetScope.paramTypeJoin = ""
    targetScope.paramTypesComplete = true
    targetScope.genericNameJoin = ""
    targetScope.genericNamesComplete = true
    var ownerContext: texpr.TypedExprSourceContext
    ownerContext.sourcePath = ownerPath
    ownerContext.snapshotOnly = true
    add(ownerContext.scopes, ownerScope)
    add(ownerContext.signatureScopes, ownerScope)
    var targetContext: texpr.TypedExprSourceContext
    targetContext.sourcePath = targetPath
    targetContext.snapshotOnly = true
    add(targetContext.scopes, targetScope)
    var contexts = [ownerContext, targetContext]

    var importedExpr: parser.NormalizedExpr
    importedExpr.sourcePath = ownerPath
    importedExpr.callTargetSourcePath = targetPath
    importedExpr.callCallee = "target"
    importedExpr.callTarget = "target"
    importedExpr.lineNumber = 1
    var exprLayer: parser.NormalizedExprLayer
    add(exprLayer.exprs, importedExpr)
    var facts: texpr.TypedExprFactTable
    var filterSources: str[]
    var filterFunctions: str[]
    var filterStarts: int32[]
    var err: str
    let missingSignatureAccepted =
        texpr.TypedExprValidateSnapshotOnlyIrInputs(sourceTexts,
                                                    contexts,
                                                    facts,
                                                    exprLayer,
                                                    false,
                                                    filterSources,
                                                    filterFunctions,
                                                    filterStarts,
                                                    err)
    assert(!missingSignatureAccepted &&
           strutil.Contains(err, "imported call signature missing"),
           Fmt"compiler csg snapshot: imported target without signature accepted={missingSignatureAccepted} err={err}")

    add(contexts[1].signatureScopes, targetScope)
    err = ""
    assert(texpr.TypedExprValidateSnapshotOnlyIrInputs(sourceTexts,
                                                       contexts,
                                                       facts,
                                                       exprLayer,
                                                       false,
                                                       filterSources,
                                                       filterFunctions,
                                                       filterStarts,
                                                       err),
           Fmt"compiler csg snapshot: complete imported target rejected {err}")
    exprLayer.exprs[0].callTargetSourcePath = "/workspace/missing.cheng"
    err = ""
    assert(!texpr.TypedExprValidateSnapshotOnlyIrInputs(sourceTexts,
                                                        contexts,
                                                        facts,
                                                        exprLayer,
                                                        false,
                                                        filterSources,
                                                        filterFunctions,
                                                        filterStarts,
                                                        err) &&
           strutil.Contains(err, "target source missing"),
           "compiler csg snapshot: unresolved imported target accepted")

    exprLayer.exprs[0].callTargetSourcePath = targetPath
    filterSources = [targetPath]
    filterFunctions = ["missing_scope"]
    filterStarts = [1]
    err = ""
    assert(!texpr.TypedExprValidateSnapshotOnlyIrInputs(sourceTexts,
                                                        contexts,
                                                        facts,
                                                        exprLayer,
                                                        true,
                                                        filterSources,
                                                        filterFunctions,
                                                        filterStarts,
                                                        err) &&
           strutil.Contains(err, "filter scope missing or mismatched"),
           "compiler csg snapshot: frontier filter without scope accepted")

    var importcTargetContext: texpr.TypedExprSourceContext
    importcTargetContext.sourcePath = targetPath
    importcTargetContext.snapshotOnly = true
    var importcFn: texpr.TypedExprImportcFunction
    importcFn.sourcePath = targetPath
    importcFn.name = "c_target"
    importcFn.importName = "c_target_symbol"
    add(importcTargetContext.importcFunctions, importcFn)
    contexts = [ownerContext, importcTargetContext]
    exprLayer.exprs[0].callCallee = "c_target"
    exprLayer.exprs[0].callTarget = "c_target"
    exprLayer.exprs[0].callTargetImportc = true
    filterSources = []
    filterFunctions = []
    filterStarts = []
    err = ""
    assert(texpr.TypedExprValidateSnapshotOnlyIrInputs(sourceTexts,
                                                       contexts,
                                                       facts,
                                                       exprLayer,
                                                       false,
                                                       filterSources,
                                                       filterFunctions,
                                                       filterStarts,
                                                       err),
           Fmt"compiler csg snapshot: explicit declaration importc rejected {err}")

fn SnapshotAssertRuntimeContract() =
    var snapshots: ccsg.CompilerCsgSourceText[]
    var snapshotIndex = ccsg.CompilerCsgSourcePathIndexInit(16)
    var err: str
    var noExternalRoots: parser.ParserExternalPackageRoot[]
    assert(ccsg.CompilerCsgSourcePathIndexConfigureRoots(snapshotIndex,
                                                         "/workspace",
                                                         "/workspace",
                                                         noExternalRoots,
                                                         err),
           Fmt"compiler csg snapshot: roots configure failed {err}")
    assert(!ccsg.CompilerCsgCaptureImmutableSourceSnapshot(snapshots,
                                                            snapshotIndex,
                                                            "src/tests/no-module.cheng",
                                                            "",
                                                            "fn main(): int32 = 1",
                                                            err),
           "compiler csg snapshot: module-less capture accepted")
    assert(strutil.Contains(err, "module missing") &&
           strutil.Contains(err, "src/tests/no-module.cheng"),
           "compiler csg snapshot: module diagnostic missing source")

    err = ""
    assert(ccsg.CompilerCsgCaptureImmutableSourceSnapshot(snapshots,
                                                           snapshotIndex,
                                                           "src/tests/frozen.cheng",
                                                           "tests/frozen",
                                                           "fn main(): int32 = 7",
                                                           err),
           Fmt"compiler csg snapshot: valid capture failed {err}")
    assert(!ccsg.CompilerCsgCaptureImmutableSourceSnapshot(snapshots,
                                                            snapshotIndex,
                                                            "src/tests/frozen.cheng",
                                                            "tests/frozen",
                                                            "fn main(): int32 = 8",
                                                            err),
           "compiler csg snapshot: conflicting snapshot accepted")
    assert(strutil.Contains(err, "body conflict"),
           "compiler csg snapshot: conflict diagnostic")
    err = ""
    assert(ccsg.CompilerCsgCaptureImmutableSourceSnapshot(snapshots,
                                                           snapshotIndex,
                                                           "/workspace/src/tests/frozen.cheng",
                                                           "tests/frozen",
                                                           "fn main(): int32 = 7",
                                                           err),
           Fmt"compiler csg snapshot: abs/rel alias failed {err}")
    var equivalentText: str
    assert(ccsg.CompilerCsgImmutableSourceSnapshotText(snapshots,
                                                        snapshotIndex,
                                                        "/workspace/src/tests/frozen.cheng",
                                                        equivalentText,
                                                        err) &&
           equivalentText == "fn main(): int32 = 7",
           Fmt"compiler csg snapshot: abs/rel lookup failed {err}")
    assert(!ccsg.CompilerCsgCaptureImmutableSourceSnapshot(snapshots,
                                                            snapshotIndex,
                                                            "/workspace/src/tests/frozen.cheng",
                                                            "tests/frozen",
                                                            "fn main(): int32 = 9",
                                                            err) &&
           strutil.Contains(err, "body conflict"),
           "compiler csg snapshot: equivalent body conflict accepted")
    assert(!ccsg.CompilerCsgCaptureImmutableSourceSnapshot(snapshots,
                                                            snapshotIndex,
                                                            "/workspace/src/tests/frozen.cheng",
                                                            "tests/other",
                                                            "fn main(): int32 = 7",
                                                            err) &&
           strutil.Contains(err, "module conflict"),
           "compiler csg snapshot: equivalent module conflict accepted")
    var ambiguousSnapshots: ccsg.CompilerCsgSourceText[]
    var ambiguousSnapshotIndex = ccsg.CompilerCsgSourcePathIndexInit(16)
    var rightRoot = parser.ParserExternalPackageRootCertifiedNew(
        "pkg://right", "pkg://right", "/right")
    var twoRoots = [rightRoot]
    assert(ccsg.CompilerCsgSourcePathIndexConfigureRoots(ambiguousSnapshotIndex,
                                                         "/left",
                                                         "/left",
                                                         twoRoots,
                                                         err),
           Fmt"compiler csg snapshot: ambiguous roots configure failed {err}")
    assert(ccsg.CompilerCsgCaptureImmutableSourceSnapshot(ambiguousSnapshots,
                                                           ambiguousSnapshotIndex,
                                                           "/left/shared/ambiguous.cheng",
                                                           "left/ambiguous",
                                                           "fn left(): int32 = 1",
                                                           err),
           Fmt"compiler csg snapshot: first ambiguous source failed {err}")
    assert(ccsg.CompilerCsgCaptureImmutableSourceSnapshot(ambiguousSnapshots,
                                                           ambiguousSnapshotIndex,
                                                           "/right/shared/ambiguous.cheng",
                                                           "right/ambiguous",
                                                           "fn right(): int32 = 2",
                                                           err),
           Fmt"compiler csg snapshot: second ambiguous source failed {err}")
    # 旧语义: 相对路径跨多根扫描, 命中多个即「ambiguous」拒绝。新设计:
    # 相对路径只锚定 relativeRoot (确定性解析), 歧义语义无对应物。替换为
    # 新严格性: 相对查找必须确定命中 relativeRoot 下的行 (右根同名行不得
    # 经相对路径泄漏), 且不存在的相对行必须被拒。
    assert(ccsg.CompilerCsgImmutableSourceSnapshotText(ambiguousSnapshots,
                                                       ambiguousSnapshotIndex,
                                                       "shared/ambiguous.cheng",
                                                       equivalentText,
                                                       err) &&
           equivalentText == "fn left(): int32 = 1",
           "compiler csg snapshot: relative lookup did not anchor at relative root")
    err = ""
    assert(!ccsg.CompilerCsgImmutableSourceSnapshotText(ambiguousSnapshots,
                                                        ambiguousSnapshotIndex,
                                                        "shared/missing.cheng",
                                                        equivalentText,
                                                        err) &&
           strutil.Contains(err, "missing"),
           "compiler csg snapshot: missing relative lookup accepted")
    ccsg.CompilerCsgReleaseImmutableSourceSnapshots(ambiguousSnapshots,
                                                    ambiguousSnapshotIndex)
    var missingText: str
    assert(!ccsg.CompilerCsgImmutableSourceSnapshotText(snapshots,
                                                        snapshotIndex,
                                                        "src/tests/missing.cheng",
                                                        missingText,
                                                        err),
           "compiler csg snapshot: missing lookup accepted")
    assert(strutil.Contains(err, "snapshot missing"),
           "compiler csg snapshot: missing lookup diagnostic")

    var emptySnapshots: ccsg.CompilerCsgSourceText[]
    var emptySnapshotIndex = ccsg.CompilerCsgSourcePathIndexInit(16)
    assert(ccsg.CompilerCsgSourcePathIndexConfigureRoots(emptySnapshotIndex,
                                                         "/workspace",
                                                         "/workspace",
                                                         noExternalRoots,
                                                         err),
           Fmt"compiler csg snapshot: empty roots configure failed {err}")
    let emptySourcePath = "/workspace/src/tests/empty-body.cheng"
    assert(ccsg.CompilerCsgCaptureImmutableSourceSnapshot(emptySnapshots,
                                                           emptySnapshotIndex,
                                                           emptySourcePath,
                                                           "tests/empty_body",
                                                           "",
                                                           err),
           Fmt"compiler csg snapshot: empty body capture failed {err}")
    missingText = "sentinel"
    assert(ccsg.CompilerCsgImmutableSourceSnapshotText(emptySnapshots,
                                                        emptySnapshotIndex,
                                                        emptySourcePath,
                                                        missingText,
                                                        err) &&
           missingText == "",
           Fmt"compiler csg snapshot: empty body lookup failed {err}")

    var typedSources: texpr.TypedExprSourceText[]
    var typedSourceIndex = ccsg.CompilerCsgSourcePathIndexInit(16)
    assert(!ccsg.CompilerCsgRestoreTypedSourceTextBody(snapshots,
                                                       snapshotIndex,
                                                       typedSources,
                                                       typedSourceIndex,
                                                       "src/tests/frozen.cheng",
                                                       err),
           "compiler csg snapshot: missing mutable row accepted")
    var typedSource: texpr.TypedExprSourceText
    typedSource.sourcePath = "src/tests/frozen.cheng"
    typedSource.text = "fn main(): int32 = 7"
    typedSource.snapshotOnly = true
    add(typedSources, typedSource)
    assert(ccsg.CompilerCsgBuildTypedSourceTextIndex(snapshots,
                                                     snapshotIndex,
                                                     typedSources,
                                                     typedSourceIndex,
                                                     err),
           Fmt"compiler csg snapshot: typed source index failed {err}")
    typedSources[0].text = "mutated"
    assert(!ccsg.CompilerCsgRestoreTypedSourceTextBody(snapshots,
                                                       snapshotIndex,
                                                       typedSources,
                                                       typedSourceIndex,
                                                       typedSource.sourcePath,
                                                       err),
           "compiler csg snapshot: conflicting mutable body accepted")
    assert(strutil.Contains(err, "body conflict"),
           "compiler csg snapshot: mutable conflict diagnostic")
    typedSources[0].text = ""
    assert(ccsg.CompilerCsgRestoreTypedSourceTextBody(snapshots,
                                                      snapshotIndex,
                                                      typedSources,
                                                      typedSourceIndex,
                                                      typedSource.sourcePath,
                                                      err),
           Fmt"compiler csg snapshot: mutable restore failed {err}")
    assert(typedSources[0].text == "fn main(): int32 = 7",
           "compiler csg snapshot: mutable body did not restore frozen text")
    ccsg.CompilerCsgClearMutableSourceTextBodies(typedSources)
    assert(typedSources[0].text == "",
           "compiler csg snapshot: mutable body release")
    var frontierSources: texpr.TypedExprSourceText[]
    var frontierSourceIndex: ccsg.CompilerCsgSourcePathIndex
    var frontierPaths = [typedSource.sourcePath]
    assert(ccsg.CompilerCsgBuildFrontierTypedSourceTexts(snapshots,
                                                         snapshotIndex,
                                                         typedSources,
                                                         typedSourceIndex,
                                                         frontierPaths,
                                                         frontierSources,
                                                         frontierSourceIndex,
                                                         err),
           Fmt"compiler csg snapshot: frontier restore failed {err}")
    assert(typedSources[0].text == "" &&
           frontierSources.len == 1 &&
           frontierSources[0].text == "fn main(): int32 = 7",
           "compiler csg snapshot: frontier body ownership")
    ccsg.CompilerCsgReleaseFrontierTypedSourceTexts(frontierSources,
                                                    frontierSourceIndex)
    assert(frontierSources.len == 0,
           "compiler csg snapshot: frontier release")
    var duplicateFrontierPaths = [typedSource.sourcePath, typedSource.sourcePath]
    assert(!ccsg.CompilerCsgBuildFrontierTypedSourceTexts(snapshots,
                                                          snapshotIndex,
                                                          typedSources,
                                                          typedSourceIndex,
                                                          duplicateFrontierPaths,
                                                          frontierSources,
                                                          frontierSourceIndex,
                                                          err),
           "compiler csg snapshot: duplicate frontier source accepted")
    assert(strutil.Contains(err, "frontier source conflict"),
           "compiler csg snapshot: frontier conflict diagnostic")
    ccsg.CompilerCsgReleaseFrontierTypedSourceTexts(frontierSources,
                                                    frontierSourceIndex)
    ccsg.CompilerCsgReleaseImmutableSourceSnapshots(snapshots,
                                                    snapshotIndex)
    assert(snapshots.len == 0,
           "compiler csg snapshot: immutable snapshot release")

fn SnapshotAssertSourceBundleIdentityColumn() =
    # 新身份 API 要求规范化 package id (无 pkg:// scheme, 否则按非规范拒绝)。
    let packageId = "compiler-csg-source-identity-column"
    let mainPath = "/workspace/src/core/tooling/identity_main.cheng"
    let stdPath = "/workspace/src/std/bytes_layout.cheng"
    let mainText = "fn main(): int32 = 7"
    # An imported module may be zero-byte; source identity still seals it.
    let stdText = ""
    var noExternalRoots: parser.ParserExternalPackageRoot[]
    var externalRoots: parser.ParserExternalPackageRoot[]
    add(externalRoots,
        parser.ParserExternalPackageRootCertifiedNew(
            "pkg/alpha", "pkg/alpha", "/deps/alpha"))
    add(externalRoots,
        parser.ParserExternalPackageRootCertifiedNew(
            "pkg/beta", "pkg/beta", "/deps/beta"))
    var externalSourcePaths = ["/deps/alpha/src/shared/item.cheng",
                               "/deps/beta/src/shared/item.cheng"]
    var externalIdentityPaths: str[]
    assert(cworld.CompilerWorldSourceBundleIdentityPathsWithExternalPackageRootsInto(
               "/workspace",
               "/workspace",
               packageId,
               externalRoots,
               externalSourcePaths,
               externalIdentityPaths) &&
           externalIdentityPaths.len == 2 &&
           externalIdentityPaths[0] == "pkg/alpha/shared/item" &&
           externalIdentityPaths[1] == "pkg/beta/shared/item",
           "compiler csg identity column: external package roots collapsed")
    var snapshots: ccsg.CompilerCsgSourceText[]
    var snapshotIndex = ccsg.CompilerCsgSourcePathIndexInit(16)
    var err: str
    assert(ccsg.CompilerCsgSourcePathIndexConfigureRoots(snapshotIndex,
                                                         "/workspace",
                                                         "/workspace",
                                                         noExternalRoots,
                                                         err),
           Fmt"compiler csg identity column: roots {err}")
    # Snapshot module ownership is the exact sealed owner column.
    assert(ccsg.CompilerCsgCaptureImmutableSourceSnapshot(snapshots,
                                                           snapshotIndex,
                                                           stdPath,
                                                           "std/bytes_layout",
                                                           stdText,
                                                           err),
           Fmt"compiler csg identity column: std capture {err}")
    assert(ccsg.CompilerCsgCaptureImmutableSourceSnapshot(snapshots,
                                                           snapshotIndex,
                                                           mainPath,
                                                           "cheng/core/tooling/identity_main",
                                                           mainText,
                                                           err),
           Fmt"compiler csg identity column: main capture {err}")
    var sourceClosurePaths = [mainPath, stdPath]
    var identityPaths = ["cheng/core/tooling/identity_main",
                         "std/bytes_layout"]
    var ownerModulePaths = ["cheng/core/tooling/identity_main",
                            "std/bytes_layout"]
    var sourceTexts = [mainText, stdText]
    let expectedRes = cworld.CompilerWorldSourceBundleCidFromIdentityTexts(
        packageId,
        identityPaths,
        sourceTexts)
    assert(IsOk(expectedRes),
           "compiler csg identity column: expected cid")
    let expectedCid = Value(expectedRes)
    var entrySourceCid = expectedCid
    assert(ccsg.CompilerCsgVerifyImmutableSourceIdentity(packageId,
                                                          mainPath,
                                                          sourceClosurePaths,
                                                          identityPaths,
                                                          ownerModulePaths,
                                                          expectedCid,
                                                          snapshots,
                                                          snapshotIndex,
                                                          entrySourceCid,
                                                          err),
           Fmt"compiler csg identity column: alias rejected {err}")

    let originalStdModulePath = snapshots[0].modulePath
    snapshots[0].modulePath = "cheng/std/bytes_layout"
    err = ""
    assert(!ccsg.CompilerCsgVerifyImmutableSourceIdentity(packageId,
                                                           mainPath,
                                                           sourceClosurePaths,
                                                           identityPaths,
                                                           ownerModulePaths,
                                                           expectedCid,
                                                           snapshots,
                                                           snapshotIndex,
                                                           entrySourceCid,
                                                           err) &&
           strutil.Contains(err, "source owner mismatch"),
           "compiler csg identity column: forged snapshot owner accepted")
    snapshots[0].modulePath = originalStdModulePath

    var shortIdentityPaths = [identityPaths[0]]
    err = ""
    assert(!ccsg.CompilerCsgVerifyImmutableSourceIdentity(packageId,
                                                           mainPath,
                                                           sourceClosurePaths,
                                                           shortIdentityPaths,
                                                           ownerModulePaths,
                                                           expectedCid,
                                                           snapshots,
                                                           snapshotIndex,
                                                           entrySourceCid,
                                                           err) &&
           strutil.Contains(err, "column mismatch"),
           "compiler csg identity column: wrong length accepted")
    var duplicateIdentityPaths = ["duplicate/module", "duplicate/module"]
    err = ""
    assert(!ccsg.CompilerCsgVerifyImmutableSourceIdentity(packageId,
                                                           mainPath,
                                                           sourceClosurePaths,
                                                           duplicateIdentityPaths,
                                                           ownerModulePaths,
                                                           expectedCid,
                                                           snapshots,
                                                           snapshotIndex,
                                                           entrySourceCid,
                                                           err) &&
           strutil.Contains(err, "identity build failed"),
           "compiler csg identity column: duplicate identity accepted")
    var missingClosurePaths = [mainPath,
                               "/workspace/src/std/missing_identity.cheng"]
    err = ""
    assert(!ccsg.CompilerCsgVerifyImmutableSourceIdentity(packageId,
                                                           mainPath,
                                                           missingClosurePaths,
                                                           identityPaths,
                                                           ownerModulePaths,
                                                           expectedCid,
                                                           snapshots,
                                                           snapshotIndex,
                                                           entrySourceCid,
                                                           err) &&
           strutil.Contains(err, "snapshot missing"),
           "compiler csg identity column: missing snapshot accepted")
    var oneClosurePath = [mainPath]
    var oneIdentityPath = [identityPaths[0]]
    err = ""
    assert(!ccsg.CompilerCsgVerifyImmutableSourceIdentity(packageId,
                                                           mainPath,
                                                           oneClosurePath,
                                                           oneIdentityPath,
                                                           ownerModulePaths,
                                                           expectedCid,
                                                           snapshots,
                                                           snapshotIndex,
                                                           entrySourceCid,
                                                           err) &&
           strutil.Contains(err, "column mismatch"),
           "compiler csg identity column: extra snapshot accepted")
    let originalStdText = snapshots[0].text
    snapshots[0].text = "fn LayoutWord(): int32 = 8"
    err = ""
    assert(!ccsg.CompilerCsgVerifyImmutableSourceIdentity(packageId,
                                                           mainPath,
                                                           sourceClosurePaths,
                                                           identityPaths,
                                                           ownerModulePaths,
                                                           expectedCid,
                                                           snapshots,
                                                           snapshotIndex,
                                                           entrySourceCid,
                                                           err) &&
           strutil.Contains(err, "source bundle changed"),
           "compiler csg identity column: text mutation accepted")
    snapshots[0].text = originalStdText
    ccsg.CompilerCsgReleaseImmutableSourceSnapshots(snapshots, snapshotIndex)

fn SnapshotAssertEndToEndNoDiskRead() =
    # 新 seal 核对 closure 源真实存在, 虚拟 fixture 落盘 /tmp; 身份行
    # 走模块文本 (新身份 API 逐行拒绝绝对路径/.cheng 后缀)。
    let sourcePath = "/tmp/compiler-csg-snapshot-only/src/entry.cheng"
    let modulePath = "compiler-csg-snapshot-only-smoke/entry"
    var linkPlan: slplan.SystemLinkPlanStub
    linkPlan.entryPath = sourcePath
    linkPlan.buildEntryPath = sourcePath
    linkPlan.workspaceRoot = "/tmp/compiler-csg-snapshot-only"
    linkPlan.packageRoot = "/tmp/compiler-csg-snapshot-only"
    linkPlan.packageId = "compiler-csg-snapshot-only-smoke"
    linkPlan.moduleStem = modulePath
    linkPlan.targetTriple = "arm64-apple-darwin"
    linkPlan.emitKind = creq.EmitObj
    linkPlan.entrySymbol = "main"
    linkPlan.sourceClosurePaths = [sourcePath]
    linkPlan.buildSourceUnitCount = 1
    linkPlan.ownerModulePaths = [modulePath]
    linkPlan.sourceBundleEntrySourceIndex = 0
    linkPlan.mainFunctionPresent = true
    linkPlan.parserSyntaxTag = "cheng_normalized_source"
    var override: ccsg.CompilerCsgSourceText
    override.sourcePath = sourcePath
    override.modulePath = modulePath
    override.text = "var FrozenGlobal: int32\n\nfn helper(x: int32): int32 =\n    return x\n\nfn main(): int32 =\n    return helper(7)\n"
    var overrides = [override]
    os.MkdirAll("/tmp/compiler-csg-snapshot-only/src", 493)
    os.WriteFile(sourcePath, override.text)
    var identityPaths = [modulePath]
    var identityTexts = [override.text]
    let sourceBundleRes = cworld.CompilerWorldSourceBundleCidFromIdentityTexts(
        linkPlan.packageId,
        identityPaths,
        identityTexts)
    assert(IsOk(sourceBundleRes),
           "compiler csg snapshot: virtual source bundle")
    # 新绑定校验同时封 entry/import-graph 两列 cid, 经 portable binding 算齐。
    var noEdges: parser.ImportEdge[]
    var portableBinding: slplan.SystemLinkPlanPortableSourceBinding
    var err: str
    assert(slplan.SystemLinkPlanPortableSourceBindingFromTextsInto(
               linkPlan.packageId,
               modulePath,
               identityPaths,
               identityTexts,
               noEdges,
               portableBinding,
               err),
           Fmt"compiler csg snapshot: portable binding failed {err}")
    linkPlan.sourceBundleIdentityPaths = identityPaths
    linkPlan.sourceBundleCid = sourceBundleRes
    linkPlan.sourceBundleCidValue = Value(sourceBundleRes)
    linkPlan.sourceBundleEntrySourceCid = portableBinding.entrySourceCid
    linkPlan.sourceBundleImportGraphCid = portableBinding.importGraphCid
    var out: ccsg.CompilerCsg
    assert(slplan.SystemLinkPlanSealSourceBundleBinding(linkPlan, err),
           Fmt"compiler csg snapshot: virtual source binding failed {err}")
    assert(ccsg.BuildCompilerCsgWithOverridesInto(linkPlan,
                                                   Value(sourceBundleRes),
                                                   overrides,
                                                   out,
                                                   err),
           Fmt"compiler csg snapshot: end-to-end virtual source failed {err}")
    assert(out.typedIr.functions2_functionNameIds.len == 2,
           Fmt"compiler csg snapshot: end-to-end typed function count {out.typedIr.functions2_functionNameIds.len}")
    assert(texpr.TypedExprIrGlobalParserIdentityComplete(out.typedIr) &&
           out.typedIr.globalNames.len == 1 &&
           out.typedIr.globalProducerSourceIndexes[0] == 0 &&
           out.typedIr.globalDeclarationSourceLocalRows[0] >= 0,
           "compiler csg snapshot: parser-owned global identity missing")
    assert(ccsg.CompilerCsgTypedIrGlobalParserIdentityStrictValidateInto(
               out.typedIr,
               out.parserNormalizedExprReceipt,
               err),
           Fmt"compiler csg snapshot: parser-owned global identity invalid {err}")
    let declarationRow =
        out.typedIr.globalDeclarationSourceLocalRows[0]
    out.typedIr.globalDeclarationSourceLocalRows[0] =
        declarationRow + 1
    err = ""
    assert(!ccsg.CompilerCsgTypedIrGlobalParserIdentityStrictValidateInto(
               out.typedIr,
               out.parserNormalizedExprReceipt,
               err),
           "compiler csg snapshot: declaration identity mutation accepted")
    out.typedIr.globalDeclarationSourceLocalRows[0] =
        declarationRow
    out.typedIr.globalProducerSourceIndexes[0] = -1
    err = ""
    assert(!ccsg.CompilerCsgTypedIrGlobalParserIdentityStrictValidateInto(
               out.typedIr,
               out.parserNormalizedExprReceipt,
               err),
           "compiler csg snapshot: producer source mutation accepted")
    out.typedIr.globalProducerSourceIndexes[0] = 0
    assert(out.sourceTextLiveBytes == Int64(0) && out.sourceTextCapturedBytes > Int64(0),
           "compiler csg snapshot: end-to-end source lifetime accounting")
    ccsg.CompilerCsgReleaseBackendInputPayload(out)

fn SnapshotAssertProductionSource() =
    let root = os.GetCurrentDir()
    let source = chengpath.ReadTextFile(root, "src/core/tooling/compiler_csg.cheng")
    let csgNormalizeSource = chengpath.ReadTextFile(root,
                                                    "src/core/tooling/csg_normalize.cheng")
    let loweringPlanSource = chengpath.ReadTextFile(root,
                                                    "src/core/backend/lowering_plan.cheng")
    let typedExprSource = chengpath.ReadTextFile(root, "src/core/lang/typed_expr.cheng")
    assert(source.len > 0 && csgNormalizeSource.len > 0 &&
           loweringPlanSource.len > 0 && typedExprSource.len > 0,
           "compiler csg snapshot: production source missing")

    let workType = SnapshotSlice(source,
                                 "    CompilerCsgBuildWorkingSet =",
                                 "    CompilerLegacySourceUnit =")
    assert(SnapshotCount(workType,
                         "sourceSnapshots: CompilerCsgSourceText[]") == 1,
           "compiler csg snapshot: immutable sidecar missing")
    assert(SnapshotCount(workType,
                         "sourceSnapshotIndex: CompilerCsgSourcePathIndex") == 1 &&
           SnapshotCount(workType,
                         "typedSourceTextIndex: CompilerCsgSourcePathIndex") == 1 &&
           SnapshotCount(workType,
                         "frontierTypedSourceTexts: TypedExprSourceText[]") == 1 &&
           SnapshotCount(workType,
                         "functionGraphNodes: CompilerCsgFunctionGraphNodeColumn") == 1,
           "compiler csg snapshot: indexed frontier storage missing")
    assert(SnapshotCount(workType, "typedSourceTextReloadable") == 0,
           "compiler csg snapshot: reloadable disk state remains")

    let captureBody = SnapshotSlice(source,
                                    "fn CompilerCsgExpandSourceClosureImports(",
                                    "fn CompilerCsgResolveCollectedProfileImportEdges(")
    assert(SnapshotCount(captureBody, "CompilerCsgReadSourceTextCached(") == 1,
           "compiler csg snapshot: initialization capture read count")
    assert(SnapshotCount(captureBody,
                         "import parser failed source={sourcePath} module={ownerModulePath}") == 2 &&
           SnapshotCount(captureBody, "return false") > 0,
           "compiler csg snapshot: import parser failure can continue")
    # 新契约: 空源合法 (zero-byte 可封印), 「snapshot capture empty」硬失败
    # 已删; 路径缺失/读取缺失仍各一次硬失败。
    assert(SnapshotCount(captureBody, "snapshot capture path missing") == 1 &&
           SnapshotCount(captureBody, "snapshot capture missing") == 1 &&
           SnapshotCount(captureBody, "snapshot capture empty") == 0,
           "compiler csg snapshot: initialization hard-fail contract")

    let reachBody = SnapshotSlice(source,
                                  "fn CompilerCsgCollectReachabilityEdgesForProfile(",
                                  "fn CompilerCsgReachableExpandFromTypedFacts(")
    SnapshotAssertNoDiskRead(reachBody, "late reachability")
    assert(SnapshotCount(reachBody,
                         "CompilerCsgImmutableSourceSnapshotText(") == 1,
           "compiler csg snapshot: late reachability bypasses snapshot")

    # 重写后函数拆成 wrapper+Impl, 真实体在 Impl 内 (快照读取仍恰好一次)。
    let frontierBody = SnapshotSlice(source,
                                     "fn compilerCsgExprLayerForFrontierFunctionsImpl(",
                                     "fn CompilerCsgSemanticInitProcessedFunctionAndSourceFlags(")
    SnapshotAssertNoDiskRead(frontierBody, "typed ir frontier")
    assert(SnapshotCount(frontierBody,
                         "CompilerCsgImmutableSourceSnapshotText(") == 1,
           "compiler csg snapshot: frontier bypasses snapshot")
    # 选中集迭代在重写后改经 transaction.selectedProfiles (原
    # frontierIndex.selectedProfiles); 全扫禁令不变。
    assert(SnapshotCount(frontierBody,
                         "ParserProfileIndexLookupForNormalizedSourcePathExact") == 0 &&
           SnapshotCount(frontierBody,
                         "for profileIndex in 0..<profiles.len:") == 0 &&
           SnapshotCount(frontierBody,
                         "for functionIndex in 0..<reachableSet.functionNames.len:") == 0 &&
           SnapshotCount(frontierBody,
                         "transaction.selectedProfiles") >= 1,
           "compiler csg snapshot: frontier profile/function full scan returned")

    let v2FrontierBody = SnapshotSlice(source,
                                       "fn CompilerCsgSemanticAppendUnprocessedFrontierFacts(",
                                       "fn CompilerCsgConsumeExprSliceIntoTypedFacts(")
    # 重写后: 迭代全部经 frontier 选中集/functionSlices, 全量 expr/fact
    # 循环已消失 (更严, 计 0); starts 仍只写入 frontierIndex 列 (各 1 处
    # 赋值点), 本地 frontierSelected/exprStarts/factStarts 数组仍为零。
    assert(SnapshotCount(v2FrontierBody,
                         "for exprIndex in 0..<fullExprLayer.exprs.len:") == 0 &&
           SnapshotCount(v2FrontierBody,
                         "for factIndex in 0..<facts.count:") == 0 &&
           SnapshotCount(v2FrontierBody, "var frontierSelected: bool[]") == 0 &&
           SnapshotCount(v2FrontierBody, "var exprStarts: int32[]") == 0 &&
           SnapshotCount(v2FrontierBody, "var factStarts: int32[]") == 0 &&
           SnapshotCount(v2FrontierBody, "frontierIndex.exprStarts") >= 1 &&
           SnapshotCount(v2FrontierBody, "frontierIndex.factStarts") >= 1,
           "compiler csg snapshot: frontier expr/fact function cross product returned")
    assert(SnapshotCount(source,
                         "CompilerCsgFunctionIndexListContains") == 0,
           "compiler csg snapshot: linear frontier membership remains")

    let buildBody = SnapshotSlice(source,
                                  "fn compilerCsgBuildConsumeWithOverridesCoreInto(",
                                  "fn BuildCompilerCsgConsumeWithOverridesInto(")
    let sealedReadIndex = SnapshotFind(buildBody,
                                       "CompilerCsgReadSourceTextCached(")
    let sealedRebuildIndex = SnapshotFind(buildBody,
        "SystemLinkPlanRebuildImportEdgesFromTextsInto(")
    let immutableCaptureIndex = SnapshotFind(buildBody,
        "CompilerCsgSourceTextSnapshotLookup(")
    assert(SnapshotCount(buildBody, "CompilerCsgReadSourceTextCached(") == 1 &&
           SnapshotCount(buildBody, "CompilerCsgSourceTextSnapshotLookup(") == 1 &&
           sealedReadIndex >= 0 && sealedRebuildIndex > sealedReadIndex &&
           immutableCaptureIndex > sealedRebuildIndex,
           "compiler csg snapshot: sealed bytes are not read once then reused")
    let exactReadBody = SnapshotSlice(source,
        "fn CompilerCsgReadSourceTextCached(",
        "fn CompilerCsgSourceModulePath(")
    assert(SnapshotCount(exactReadBody,
                         "os.ReadFileInto(sourcePath, capturedText)") == 1 &&
           SnapshotCount(exactReadBody, "chengpath.ReadTextFile") == 0 &&
           SnapshotCount(exactReadBody, "PathProviderFilePath") == 0 &&
           SnapshotCount(exactReadBody,
                         "CompilerCsgSourceTextLookupAdd(cache,") == 1,
           "compiler csg snapshot: exact cache loader has fallback or duplicate read")
    assert(SnapshotCount(buildBody,
                         "CompilerCsgCaptureImmutableSourceSnapshot(work.sourceSnapshots") == 1 &&
           SnapshotCount(buildBody,
                         "CompilerCsgBuildTypedSourceTextIndex(work.sourceSnapshots") == 1,
           "compiler csg snapshot: source capture count")
    assert(SnapshotCount(buildBody,
                         "CompilerCsgRestoreAllTypedSourceTextBodies") == 0 &&
           SnapshotCount(buildBody,
                         "TypedExprSourceTextIndexForPath(work.typedSourceTexts") == 0 &&
           SnapshotCount(buildBody,
                         "CompilerCsgBuildFrontierTypedSourceTexts(work.sourceSnapshots") == 1,
           "compiler csg snapshot: frontier-only typed source restore")
    # 重写后 facts 管线: 唯一构建入口 CompilerCsgBuildFactsForFunctionSourceSlices
    # + frozen facts accounting 硬失败; 旧 Preserving/Sealed/Append 入口已删,
    # 非 sealed append 计 0 的禁令保留, sealed index 开闭仍各一次。
    assert(SnapshotCount(buildBody,
                         "CompilerCsgBuildFactsForFunctionSourceSlices(") == 1 &&
           SnapshotCount(buildBody,
                         "TypedExprBuildFactsForExprLayerPreserving(") == 0 &&
           SnapshotCount(buildBody,
                         "TypedExprAppendIrFunctionsWithFactsMetadataAndExprLayer(") == 0 &&
