                                              "fn CompilerCsgTypedIrCoreLiveBytes(",
                                              "fn CompilerCsgTypedIrMetadataLiveBytes(")
    let memoryLedgerBody = SnapshotSlice(source,
                                         "fn CompilerCsgRefreshMemoryLedger(",
                                         "fn CompilerCsgSemanticFinalize(")
    let internPoolLedgerBody = SnapshotSlice(source,
                                             "fn CompilerCsgInternPoolBytesMode(",
                                             "fn CompilerCsgSourceTextPayloadLiveBytes(")
    assert(SnapshotCount(typedIrCoreLedgerBody, "langintern.LookupIntern") == 0 &&
           SnapshotCount(typedIrCoreLedgerBody, "Result[str]") == 0 &&
           SnapshotCount(memoryLedgerBody,
                         "CompilerCsgTypedIrCoreLiveBytes(csg.typedIr)") == 1,
           "compiler csg snapshot: memory ledger materializes interned strings")
    assert(SnapshotCount(internPoolLedgerBody,
                         "langintern.InternPoolLogicalPayloadBytes(pool)") == 1 &&
           SnapshotCount(internPoolLedgerBody, "for textIndex") == 0 &&
           SnapshotCount(internPoolLedgerBody, "pool.texts[") == 0 &&
           SnapshotCount(internPoolLedgerBody, "langintern.LookupIntern") == 0 &&
           SnapshotCount(internPoolLedgerBody, "pool.texts.len") == 1 &&
           SnapshotCount(internPoolLedgerBody, "pool.texts.cap") == 1,
           "compiler csg snapshot: intern ledger rescans payload strings")

    let legacyCidGateIndex = SnapshotFind(buildBody,
        "CHENG_COMPILER_CSG_LEGACY_CANONICAL_CID_DIAGNOSTIC")
    let legacyCidCallIndex = SnapshotFind(buildBody,
                                          "CompilerCsgCanonicalGraphCid(linkPlan.packageId")
    assert(legacyCidGateIndex >= 0 && legacyCidGateIndex < legacyCidCallIndex &&
           SnapshotCount(buildBody,
                         "CompilerCsgCanonicalGraphCid(linkPlan.packageId") == 1,
           "compiler csg snapshot: legacy canonical CID runs in production")

    let compilerMoveCloneBody = SnapshotSlice(source,
                                              "fn CompilerCsgClone(",
                                              "fn CompilerCsgReleaseBackendInputPayload(")
    let migrationMoveCloneBody = SnapshotSlice(source,
                                               "fn CompilerLegacyMigrationClone(",
                                               "fn CompilerCsgAppendU32BE(")
    assert(SnapshotCount(compilerMoveCloneBody,
                         "return CompilerCsgDeepCloneDiagnostic(csg)") == 1 &&
           SnapshotCount(compilerMoveCloneBody, "return csg") == 0 &&
           SnapshotCount(migrationMoveCloneBody,
                         "return CompilerLegacyMigrationDeepCloneDiagnostic(migration)") == 1 &&
           SnapshotCount(migrationMoveCloneBody, "return migration") == 0 &&
           SnapshotCount(source, "fn CompilerCsgDeepCloneDiagnostic(") == 1 &&
           SnapshotCount(source, "fn CompilerLegacyMigrationDeepCloneDiagnostic(") == 1,
           "compiler csg snapshot: raw-owner clone aliases source payload")
    let releasePayloadBody = SnapshotSlice(source,
        "fn CompilerCsgReleaseBackendInputPayload(",
        "fn CompilerCsgI32Bytes(")
    assert(SnapshotCount(releasePayloadBody,
                         "CompilerCsgRefreshMemoryLedger(csg)") == 1 &&
           SnapshotCount(releasePayloadBody, "csg.nodeCount = 0") == 1 &&
           SnapshotCount(releasePayloadBody, "csg.edgeCount = 0") == 1 &&
           SnapshotCount(releasePayloadBody,
                         "csg.logicalPayloadBytes = Int64(0)") == 0 &&
           SnapshotCount(releasePayloadBody,
                         "csg.retainedCapacityBytes = Int64(0)") == 0,
           "compiler csg snapshot: payload release fabricates a zero ledger")

    let typedBuildBody = SnapshotSlice(typedExprSource,
                                       "fn TypedExprBuildIrWithFactsMetadataAndExprLayerImpl(",
                                       "fn TypedExprBuildIrWithFactsMetadataAndExprLayer(")
    assert(SnapshotCount(typedBuildBody,
                         "TypedExprClearSourceTextBody(sourceTexts[i])") == 2,
           "compiler csg snapshot: typed expr destructive behavior changed")
    let typedLoadBody = SnapshotSlice(typedExprSource,
                                      "fn TypedExprEnsureSourceTextLoaded(",
                                      "fn TypedExprClearSourceTextBody(")
    assert(SnapshotFind(typedLoadBody, "if source.snapshotOnly:") >= 0 &&
           SnapshotFind(typedLoadBody, "chengpath.ReadTextFile") >
               SnapshotFind(typedLoadBody, "if source.snapshotOnly:"),
           "compiler csg snapshot: typed expr snapshot-only disk gate missing")
    assert(SnapshotFind(typedExprSource,
                        "snapshot-only imported call signature missing") >= 0 &&
           SnapshotFind(typedExprSource,
                        "snapshot-only metadata context missing") >= 0,
           "compiler csg snapshot: typed expr snapshot-only diagnostics missing")

fn main(): int32 =
    SnapshotAssertSingleReadCacheContract()
    SnapshotAssertSourceIdentityContract()
    SnapshotAssertHardFailIndexes()
    SnapshotAssertSnapshotValidationIndexes()
    SnapshotAssertRuntimeContract()
    SnapshotAssertSourceBundleIdentityColumn()
    SnapshotAssertEndToEndNoDiskRead()
    SnapshotAssertProductionSource()
    echo(" compiler_csg_immutable_source_snapshot_smoke ok")
    return 0
