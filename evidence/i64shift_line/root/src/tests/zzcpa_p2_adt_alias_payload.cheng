type MyId = int32

type IdWrap[T] = Wrap(ids: MyId[]) | Scalar(v: T)

fn main(): int32 =
    var xs: MyId[]
    add(xs, 4)
    add(xs, 5)
    let e: IdWrap[int32] = Wrap(xs)
    match e:
        Wrap(ids) =>
            if ids.len != 2:
                return 21
            return ids[0] + ids[1] - 9
        Scalar(v) =>
            return v

main()
