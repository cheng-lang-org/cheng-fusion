import cheng/std/seqs

type
    ReserveItem =
        value: int32
    ReserveOtherItem =
        value: int64
    ReserveOwner =
        items: ReserveItem[]
        otherItems: ReserveOtherItem[]
        names: str[]
        capacities: int32[]

fn main(): int32 =
    let targetCapacity: int32 = 4
    var owner: ReserveOwner
    var capacities: int32[]
    add(capacities, targetCapacity)
    add(capacities, targetCapacity)
    owner.capacities = capacities
    reserve(owner.items, owner.capacities[0])
    if owner.items.cap < targetCapacity:
        return 1
    reserve(owner.items, owner.capacities [1])
    if owner.items.cap < targetCapacity:
        return 2
    reserve(owner.otherItems, targetCapacity)
    if owner.otherItems.cap < targetCapacity:
        return 3
    reserve(owner.names, targetCapacity)
    if owner.names.cap < targetCapacity:
        return 4

    var localItems: ReserveItem[]
    reserve(localItems, targetCapacity)
    if localItems.cap < targetCapacity:
        return 5
    var localNames: str[]
    reserve(localNames, targetCapacity)
    if localNames.cap < targetCapacity:
        return 6
    return 0
