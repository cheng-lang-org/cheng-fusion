import std/atomic
import std/thread

@importc("write")
fn linuxWrite(fd: int32, raw: ptr, count: int32): int32

type
    CounterCtx = ref object
        counter: atomic.I32

    DetachCtx = ref object
        gate: atomic.I32
        done: atomic.I32

fn JoinWorker(raw: ptr) =
    let ctx: CounterCtx = CounterCtx(raw)
    let _ = atomic.AddI32(ctx.counter, 1)

fn DetachWorker(raw: ptr) =
    let ctx: DetachCtx = DetachCtx(raw)
    while atomic.LoadI32(ctx.gate) == 0:
        thread.Yield()
    let _ = atomic.AddI32(ctx.done, 1)

fn PoolWorker(raw: ptr, index: int32, worker: int32): int32 =
    let ctx: CounterCtx = CounterCtx(raw)
    let _ = index
    let _ = worker
    let _ = atomic.AddI32(ctx.counter, 1)
    return 0

fn main(): int32 =
    if thread.Parallelism() <= 0:
        return 11
    let joinPoolCounter = atomic.NewI32(0)
    if joinPoolCounter == nil:
        return 12
    let counterCtx = new(CounterCtx)
    if counterCtx == nil:
        return 12
    counterCtx.counter = joinPoolCounter
    let joinPoolCounterRaw: ptr = &counterCtx.counter

    let h0 = thread.StartPtr(&JoinWorker, joinPoolCounterRaw)
    let h1 = thread.StartPtr(&JoinWorker, joinPoolCounterRaw)
    let h2 = thread.StartPtr(&JoinWorker, joinPoolCounterRaw)
    let h3 = thread.StartPtr(&JoinWorker, joinPoolCounterRaw)
    if !thread.JoinThread(h0):
        return 13
    if !thread.JoinThread(h1):
        return 13
    if !thread.JoinThread(h2):
        return 13
    if !thread.JoinThread(h3):
        return 13
    if atomic.LoadI32(joinPoolCounter) != 4:
        return 14

    var spin = 0
    let detachGate = atomic.NewI32(0)
    let detachDone = atomic.NewI32(0)
    if detachGate == nil || detachDone == nil:
        return 19
    let detachCtx = new(DetachCtx)
    if detachCtx == nil:
        return 19
    detachCtx.gate = detachGate
    detachCtx.done = detachDone
    let detachRaw: ptr = &detachCtx.gate
    let detached = thread.StartPtr(&DetachWorker, detachRaw)
    if !thread.Detach(detached):
        return 20
    atomic.StoreI32(detachGate, 1)
    spin = 0
    while atomic.LoadI32(detachDone) != 1 && spin < 100000:
        thread.Yield()
        spin = spin + 1
    if atomic.LoadI32(detachDone) != 1:
        return 21

    atomic.StoreI32(joinPoolCounter, 0)
    for _ in 0..<4:
        if !thread.SpawnPtr(&JoinWorker, joinPoolCounterRaw):
            return 17
    spin = 0
    while atomic.LoadI32(joinPoolCounter) != 4 && spin < 100000:
        thread.Yield()
        spin = spin + 1
    if atomic.LoadI32(joinPoolCounter) != 4:
        return 18

    atomic.StoreI32(joinPoolCounter, 0)
    let pool = thread.PoolNew(4)
    if pool == nil:
        return 15
    thread.ParallelFor(pool, 1000, &PoolWorker, joinPoolCounterRaw)
    if atomic.LoadI32(joinPoolCounter) != 1000:
        return 16

    let _ = linuxWrite(1, " thread_join_pool_runtime_smoke ok\n", 35)
    return 0
