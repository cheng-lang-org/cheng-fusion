import std/strformat
import std/strutils as strutil
import cheng/core/backend/lowering_plan as lower
import cheng/core/ir/function_source_slice_index as fslice
import cheng/core/lang/parser
import cheng/core/lang/typed_expr as texpr
import cheng/core/runtime/arena as arenamod
import cheng/core/tooling/compiler_csg as ccsg

const FixturePath: str = "/tmp/compiler_csg_structured_scope_slice/main.cheng"
const EmptyFixturePath: str = "/tmp/compiler_csg_structured_scope_slice/empty.cheng"
const ThirdFixturePath: str = "/tmp/compiler_csg_structured_scope_slice/third.cheng"

fn FixtureText(): str =
    let text = """
    fn First(value: int32): int32 =
        var result: int32
        result = value
        if result > 0:
            defer:
                result = result + 1
            return result
        return result

    fn Second(limit: int32): int32 =
        var total: int32
        while total < limit:
            defer:
                total = total + 1
            if total > 2:
                break
            total = total + 1
        return total
    """
    return strutil.Strip(text)

fn ThirdFixtureText(): str =
    let text = """
    fn Third(value: int32): int32 =
        if value > 0:
            return value
        return 0
    """
    return strutil.Strip(text)

fn ConfigureSourceIndex(index: var ccsg.CompilerCsgSourcePathIndex) =
    var roots: parser.ParserExternalPackageRoot[]
    var err: str
    assert(ccsg.CompilerCsgSourcePathIndexConfigureRoots(index,
        "/tmp/compiler_csg_structured_scope_slice",
        "/tmp/compiler_csg_structured_scope_slice", roots, err), err)

fn BuildFixture(profiles: var parser.NormalizedExprCallProfile[],
                set: var ccsg.CompilerCsgReachableFunctionSet,
                snapshots: var ccsg.CompilerCsgSourceText[],
                snapshotIndex: var ccsg.CompilerCsgSourcePathIndex) =
    var profile: parser.NormalizedExprCallProfile
    profile.sourcePath = FixturePath
    profile.ownerModulePath = "scope_slice/main"
    profile.text = FixtureText()
    profile.lines = parser.ParserSplitChar(profile.text, '\n')
    var first: parser.NormalizedFunctionDecl
    first.name = "First"
    first.lineIndex = 1
    first.surfaceKeyword = "fn"
    add(profile.decls, first)
    var second: parser.NormalizedFunctionDecl
    second.name = "Second"
    second.lineIndex = 10
    second.surfaceKeyword = "fn"
    add(profile.decls, second)
    profile.localCallNames = ["First", "Second"]
    var emptyProfile: parser.NormalizedExprCallProfile
    emptyProfile.sourcePath = EmptyFixturePath
    emptyProfile.ownerModulePath = "scope_slice/empty"
    emptyProfile.text = "const EmptyValue: int32 = 1"
    emptyProfile.lines = [emptyProfile.text]
    var thirdProfile: parser.NormalizedExprCallProfile
    thirdProfile.sourcePath = ThirdFixturePath
    thirdProfile.ownerModulePath = "scope_slice/third"
    thirdProfile.text = ThirdFixtureText()
    thirdProfile.lines = parser.ParserSplitChar(thirdProfile.text, '\n')
    var third: parser.NormalizedFunctionDecl
    third.name = "Third"
    third.lineIndex = 1
    third.surfaceKeyword = "fn"
    add(thirdProfile.decls, third)
    thirdProfile.localCallNames = ["Third"]
    profiles = [profile, emptyProfile, thirdProfile]
    var modules: str[] = ["scope_slice/main", "scope_slice/empty",
                          "scope_slice/third"]
    var lineCounts: int32[] = [18, 1, 4]
    var identity = ccsg.CompilerCsgSourcePathIndexInit(4)
    ConfigureSourceIndex(identity)
    set = ccsg.CompilerCsgReachableFunctionSetInit(true)
    var err: str
    assert(ccsg.CompilerCsgReachableAddFunctionsFromProfiles(set, profiles,
        modules, lineCounts, identity, err), err)
    var marked: int32[]
    ccsg.CompilerCsgReachableMark(set, 0, marked)
    ccsg.CompilerCsgReachableMark(set, 1, marked)
    ccsg.CompilerCsgReachableMark(set, 2, marked)
    ccsg.CompilerCsgSourcePathIndexClear(identity)
    snapshotIndex = ccsg.CompilerCsgSourcePathIndexInit(4)
    ConfigureSourceIndex(snapshotIndex)
    assert(ccsg.CompilerCsgCaptureImmutableSourceSnapshot(snapshots,
        snapshotIndex, FixturePath, "scope_slice/main", FixtureText(), err), err)
    assert(ccsg.CompilerCsgCaptureImmutableSourceSnapshot(snapshots,
        snapshotIndex, ThirdFixturePath, "scope_slice/third",
        ThirdFixtureText(), err), err)

fn SourceTextNew(): texpr.TypedExprSourceText =
    var roots: parser.ParserExternalPackageRoot[]
    return texpr.TypedExprSourceTextNewWithPackageFacts(
        "/tmp/compiler_csg_structured_scope_slice",
        "/tmp/compiler_csg_structured_scope_slice",
        "pkg://compiler-csg-structured-scope-slice", "stable",
        roots, FixturePath, FixtureText())

fn AssertSourceWideContract(layer: var parser.NormalizedExprLayer) =
    var rootCount: int32
    var deferScopeCount: int32
    for scopeIndex in 0..<layer.scopes.len:
        let scope = layer.scopes[scopeIndex]
        assert(scope.sourcePath == FixturePath && scope.scopeId == scopeIndex,
               "source-wide-scope-id")
        if scopeIndex == 0:
            assert(scope.parentScopeId == -1 &&
                   scope.kind == parser.NormalizedScopeRoot,
                   "source-wide-root")
            rootCount = rootCount + 1
        else:
            assert(scope.parentScopeId >= 0 &&
                   scope.parentScopeId < scopeIndex,
                   "source-wide-scope-parent")
        if scope.kind == parser.NormalizedScopeDeferSuite:
            assert(scope.parentScopeId > 0 &&
                   (scope.ownerStatementOrdinal == 1 ||
                    scope.ownerStatementOrdinal == 3),
                   "source-wide-nested-defer-scope")
            deferScopeCount = deferScopeCount + 1
    var nextSourceOrdinal: int32
    var firstStructuredCount: int32
    var secondStructuredCount: int32
    var secondFirstSourceOrdinal: int32 = -1
    var firstDeferBodyCount: int32
    var secondDeferBodyCount: int32
    for exprIndex in 0..<layer.exprs.len:
        let expr = layer.exprs[exprIndex]
        if parser.ParserNormalizedExprKindIsSidecarStructured(expr.kind):
            assert(expr.statementOrdinal == nextSourceOrdinal,
                   "source-wide-statement-ordinal")
            if expr.lineNumber < 10:
                firstStructuredCount = firstStructuredCount + 1
            else:
                if secondFirstSourceOrdinal < 0:
                    secondFirstSourceOrdinal = expr.statementOrdinal
                secondStructuredCount = secondStructuredCount + 1
            nextSourceOrdinal = nextSourceOrdinal + 1
        if expr.deferOwnerStatementOrdinal >= 0:
            assert(expr.lexicalScopeId > 0 &&
                   expr.suiteScopeId == -1,
                   "source-wide-defer-body-scope")
            if expr.lineNumber < 10:
                assert(expr.deferOwnerStatementOrdinal == 1,
                       "source-wide-first-defer-owner")
                firstDeferBodyCount = firstDeferBodyCount + 1
            else:
                assert(expr.deferOwnerStatementOrdinal == 3,
                       "source-wide-second-defer-owner")
                secondDeferBodyCount = secondDeferBodyCount + 1
    assert(layer.sourceCount == 1 && rootCount == 1 &&
           deferScopeCount == 2 && nextSourceOrdinal == 6 &&
           firstStructuredCount == 2 && secondStructuredCount == 4 &&
           secondFirstSourceOrdinal == 2 &&
           firstDeferBodyCount > 0 && secondDeferBodyCount > 0,
           "source-wide-domain")

fn AssertFunctionSourceSlices(
        index: var fslice.FunctionSourceSliceIndex,
        layer: var parser.NormalizedExprLayer,
        profiles: var parser.NormalizedExprCallProfile[],
        expectedSourceCounts: int32[]) =
    assert(index.sealed && !index.released &&
           index.expectedSourceCount == profiles.len &&
           expectedSourceCounts.len == profiles.len &&
           index.sourceStarts.len == profiles.len,
           "function-slice-sealed-domain")
    var expectedRowStart: int32
    var selectedSourceCount: int32
    var observedStructuredStatementCount: int32
    for exprIndex in 0..<layer.exprs.len:
        if parser.ParserNormalizedExprKindIsSidecarStructured(
                layer.exprs[exprIndex].kind):
            observedStructuredStatementCount =
                observedStructuredStatementCount + 1
    for sourceIndex in 0..<profiles.len:
        let sourceStart = fslice.FunctionSourceSliceIndexSourceStart(
            index, sourceIndex)
        let sourceCount = fslice.FunctionSourceSliceIndexSourceCount(
            index, sourceIndex)
        assert(sourceStart == expectedRowStart &&
               sourceCount == expectedSourceCounts[sourceIndex],
               "function-slice-source-range")
        if sourceCount > 0:
            selectedSourceCount = selectedSourceCount + 1
            var sourceRootCount: int32
            for scopeIndex in 0..<layer.scopes.len:
                let scope = layer.scopes[scopeIndex]
                if scope.sourcePath == profiles[sourceIndex].sourcePath &&
                   scope.scopeId == 0:
                    assert(scope.parentScopeId == -1,
                           "function-slice-source-root-parent")
                    sourceRootCount = sourceRootCount + 1
            assert(sourceRootCount == 1, "function-slice-source-root")
        for sourceFunctionOrdinal in 0..<sourceCount:
            let rowIndex =
                fslice.FunctionSourceSliceIndexRowForSourceFunctionOrdinal(
                    index, sourceIndex, sourceFunctionOrdinal)
            let row = fslice.FunctionSourceSliceIndexGetRow(index, rowIndex)
            assert(row.sourceIndex == sourceIndex && row.scopeStart >= 1,
                   "function-slice-row-identity")
            for scopeId in row.scopeStart..<row.scopeStart + row.scopeCount:
                var found = false
                for scopeIndex in 0..<layer.scopes.len:
                    let scope = layer.scopes[scopeIndex]
                    if scope.sourcePath == profiles[sourceIndex].sourcePath &&
                       scope.scopeId == scopeId:
                        assert(scope.parentScopeId == 0 ||
                               (scope.parentScopeId >= row.scopeStart &&
                                scope.parentScopeId < scopeId),
                               "function-slice-parent-range")
                        found = true
                assert(found, "function-slice-scope-row")
        expectedRowStart = expectedRowStart + sourceCount
    assert(expectedRowStart == index.expectedFunctionCount &&
           index.functionRowAppendVisitCount == index.expectedFunctionCount &&
           index.exprCommitVisitCount == layer.exprs.len &&
           index.scopeCommitVisitCount + selectedSourceCount ==
               layer.scopes.len &&
           index.statementCommitVisitCount ==
               observedStructuredStatementCount &&
           index.scopeParentValidationVisitCount ==
               index.scopeCommitVisitCount &&
           index.parentValidationRowCursor == index.expectedFunctionCount,
           "function-slice-visit-closure")

fn AssertFunctionLocalContract(ir: var texpr.TypedExprIr,
                               functionIndex: int32,
                               expectedStructuredCount: int32,
                               expectedDeferOwner: int32,
                               requireNonzeroStatementStart: bool) =
    let statementStart = arenamod.ArenaArrayInt32Get(
        ir.arena, ir.functions2_statementStarts, functionIndex)
    let statementCount = arenamod.ArenaArrayInt32Get(
        ir.arena, ir.functions2_statementCounts, functionIndex)
    let scopeStart = arenamod.ArenaArrayInt32Get(
        ir.arena, ir.functions2_scopeStarts, functionIndex)
    let scopeCount = arenamod.ArenaArrayInt32Get(
        ir.arena, ir.functions2_scopeCounts, functionIndex)
    assert(statementStart >= 0 && statementCount > 0 &&
           scopeStart >= 0 && scopeCount > 0,
           "function-local-slices")
    if requireNonzeroStatementStart:
        assert(statementStart > 0, "second-function-physical-offset")
    for localScopeId in 0..<scopeCount:
        let scopeRow = scopeStart + localScopeId
        let observedScopeId = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.scopes2_scopeIds, scopeRow)
        let parentScopeId = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.scopes2_parentScopeIds, scopeRow)
        let ownerOrdinal = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.scopes2_ownerStatementOrdinals, scopeRow)
        assert(observedScopeId == localScopeId,
               "function-local-scope-dense")
        if localScopeId == 0:
            assert(parentScopeId == -1 && ownerOrdinal == -1,
                   "function-local-root")
        else:
            assert(parentScopeId >= 0 && parentScopeId < localScopeId &&
                   ownerOrdinal >= 0 &&
                   ownerOrdinal < expectedStructuredCount,
                   "function-local-scope-owner")
    var nextLocalOrdinal: int32
    var deferBodyCount: int32
    for localRow in 0..<statementCount:
        let statementRow = statementStart + localRow
        let lexicalScopeId = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.statements2_lexicalScopeIds, statementRow)
        let suiteScopeId = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.statements2_suiteScopeIds, statementRow)
        let statementOrdinal = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.statements2_statementOrdinals, statementRow)
        let deferOwner = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.statements2_deferOwnerStatementOrdinals,
            statementRow)
        assert(lexicalScopeId >= 0 && lexicalScopeId < scopeCount &&
               suiteScopeId >= -1 && suiteScopeId < scopeCount,
               "function-local-statement-scope")
        if statementOrdinal >= 0:
            assert(statementOrdinal == nextLocalOrdinal,
                   "function-local-statement-dense")
            nextLocalOrdinal = nextLocalOrdinal + 1
        if deferOwner >= 0:
            assert(deferOwner == expectedDeferOwner &&
                   deferOwner < expectedStructuredCount,
                   "function-local-defer-owner")
            deferBodyCount = deferBodyCount + 1
    assert(nextLocalOrdinal == expectedStructuredCount &&
           deferBodyCount > 0,
           "function-local-domain")

    var transport: lower.LoweringDeferScopeTransportSoA
    lower.LoweringBuildDeferScopeTransport(ir, functionIndex, transport)
    assert(transport.complete &&
           transport.sourceStatementStart == statementStart &&
           transport.sourceStatementCount == statementCount &&
           transport.sourceScopeStart == scopeStart &&
           transport.sourceScopeCount == scopeCount,
           "lowering-physical-slice")
    for localScopeId in 0..<scopeCount:
        let scopeRow = scopeStart + localScopeId
        assert(transport.scopeIds[localScopeId] == localScopeId &&
               transport.scopeOwnerStatementOrdinals[localScopeId] ==
                   arenamod.ArenaArrayInt32Get(
                       ir.arena,
                       ir.scopes2_ownerStatementOrdinals,
                       scopeRow),
               "lowering-local-scope-domain")
    for localRow in 0..<statementCount:
        let statementRow = statementStart + localRow
        assert(transport.statementOrdinals[localRow] ==
                   arenamod.ArenaArrayInt32Get(
                       ir.arena,
                       ir.statements2_statementOrdinals,
                       statementRow) &&
               transport.statementDeferOwnerStatementOrdinals[localRow] ==
                   arenamod.ArenaArrayInt32Get(
                       ir.arena,
                       ir.statements2_deferOwnerStatementOrdinals,
                       statementRow),
               "lowering-local-statement-domain")
    lower.LoweringDeferScopeTransportRelease(transport)

fn AssertTypedProductionPath(layer: var parser.NormalizedExprLayer) =
    AssertSourceWideContract(layer)
    var scopeIndex = texpr.TypedExprNormalizedScopeIndexBuild(layer)
    assert(scopeIndex.sourcePaths.len == 1 && scopeIndex.starts[0] == 0 &&
           scopeIndex.counts[0] == layer.scopes.len, "scope-index")
    var sourceTexts: texpr.TypedExprSourceText[] = [SourceTextNew()]
    var contexts: texpr.TypedExprSourceContext[]
    var context: texpr.TypedExprSourceContext
    var err: str
    assert(texpr.TypedExprBuildSourceContext(SourceTextNew(), context, err), err)
    texpr.TypedExprSourceContextAppendMove(contexts, context)
    var factsLayer = parser.NormalizedExprLayerClone(layer)
    var facts: texpr.TypedExprFactTable
    assert(texpr.TypedExprBuildFactsWithMetadataContexts(sourceTexts,
        factsLayer, contexts, facts, err), err)
    sourceTexts = [SourceTextNew()]
    var ir: texpr.TypedExprIr
    var filterSources: str[]
    var filterFunctions: str[]
    var filterLines: int32[]
    assert(texpr.TypedExprSnapshotBuild(sourceTexts, contexts, facts, layer, ir,
        false, filterSources, filterFunctions, filterLines), "v2-fast")
    assert(ir.functions2_functionNameIds.len == 2 &&
           ir.functions2_scopeStarts.len == 2, "typed-functions")
    var functionIndexes: int32[2] = [-1, -1]
    for functionIndex in 0..<ir.functions2_signatureLineNumbers.len:
        let line = arenamod.ArenaArrayInt32Get(ir.arena,
            ir.functions2_signatureLineNumbers, functionIndex)
        if line == 1:
            functionIndexes[0] = functionIndex
        elif line == 10:
            functionIndexes[1] = functionIndex
    assert(functionIndexes[0] >= 0 && functionIndexes[1] >= 0,
           "typed-function-index")
    AssertFunctionLocalContract(ir, functionIndexes[0], 2, 1, false)
    AssertFunctionLocalContract(ir, functionIndexes[1], 4, 1, true)
    AssertSourceWideContract(layer)
    texpr.TypedExprFactTableRelease(facts)
    texpr.TypedExprIrReleasePayload(ir)
    parser.NormalizedExprLayerReset(factsLayer)

fn main(): int32 =
    var profiles: parser.NormalizedExprCallProfile[]
    var set: ccsg.CompilerCsgReachableFunctionSet
    var snapshots: ccsg.CompilerCsgSourceText[]
    var snapshotIndex: ccsg.CompilerCsgSourcePathIndex
    BuildFixture(profiles, set, snapshots, snapshotIndex)
    let profileLookup = parser.ParserSourcePathIndexLookupBuild(profiles)
    var cache: ccsg.CompilerCsgProfileCallLookupStore
    var frontierIndex: ccsg.CompilerCsgFrontierIndex
    ccsg.CompilerCsgFrontierIndexBegin(frontierIndex, profiles.len,
                                      set.functionNames.len)
    var output: parser.NormalizedExprLayer
    var scratch: parser.NormalizedExprLayer
    var functionSlices: fslice.FunctionSourceSliceIndex
    var reverseFrontier: int32[] = [1, 0]
    var err: str
    assert(ccsg.CompilerCsgExprLayerForFrontierFunctions(snapshots,
        snapshotIndex, profiles, profileLookup, cache, set, reverseFrontier,
        frontierIndex, output, scratch, functionSlices, err), err)
    assert(output.sourceCount == 1 && output.scopes.len > 1 &&
           scratch.exprs.len == 0, "source-domain")
    var roots: int32
    var previousLine: int32
    var statementCount: int32
    for scopeIndex in 0..<output.scopes.len:
        let scope = output.scopes[scopeIndex]
        assert(scope.sourcePath == FixturePath &&
               scope.scopeId == scopeIndex, "dense-scope")
        if scope.scopeId == 0:
            roots = roots + 1
    for exprIndex in 0..<output.exprs.len:
        let expr = output.exprs[exprIndex]
        assert(expr.lineNumber >= previousLine, "source-order")
        previousLine = expr.lineNumber
        if parser.ParserNormalizedExprKindIsSidecarStructured(expr.kind):
            assert(expr.statementOrdinal == statementCount, "dense-statement")
            statementCount = statementCount + 1
        if expr.deferOwnerStatementOrdinal >= 0:
            assert(expr.deferOwnerStatementOrdinal < statementCount,
                   "defer-owner")
    let report = frontierIndex.lastStructuredSidecar
    assert(roots == 1 && statementCount == 6 &&
           report.sourceBuildCount == Int64(1) &&
           report.sourceReleaseCount == Int64(1) &&
           report.sliceBuildCount == Int64(2) &&
           report.activeSliceCount == Int64(0) &&
           report.activeSlicePeakCount == Int64(1) &&
           report.scopeBuildLineVisitCount == Int64(18) &&
           report.structuredBuildLineVisitCount == Int64(18) &&
           report.sliceLineVisitCount == Int64(18) &&
           report.phasePeakCapacityBytes > Int64(0) &&
           report.phasePeakLiveBytes > Int64(0) &&
           report.finalScratchCapacityBytes == Int64(0) &&
           report.finalScratchLiveBytes == Int64(0), "sidecar-ledger")
    var firstSourceCounts: int32[] = [2, 0, 0]
    AssertFunctionSourceSlices(functionSlices, output, profiles,
                               firstSourceCounts)
    let firstRow = fslice.FunctionSourceSliceIndexGetRow(functionSlices, 0)
    let secondRow = fslice.FunctionSourceSliceIndexGetRow(functionSlices, 1)
    assert(firstRow.functionIndex == 0 && secondRow.functionIndex == 1 &&
           firstRow.sourceIndex == 0 && secondRow.sourceIndex == 0,
           "function-slice-reverse-frontier-canonical")
    AssertTypedProductionPath(output)
    parser.NormalizedExprLayerReset(output)
    parser.NormalizedExprLayerReset(scratch)

    var allCache: ccsg.CompilerCsgProfileCallLookupStore
    var allFrontierIndex: ccsg.CompilerCsgFrontierIndex
    ccsg.CompilerCsgFrontierIndexBegin(allFrontierIndex, profiles.len,
                                      set.functionNames.len)
    var allOutput: parser.NormalizedExprLayer
    var allScratch: parser.NormalizedExprLayer
    var allFunctionSlices: fslice.FunctionSourceSliceIndex
    var allReverseFrontier: int32[] = [2, 1, 0]
    assert(ccsg.CompilerCsgExprLayerForFrontierFunctions(snapshots,
        snapshotIndex, profiles, profileLookup, allCache, set,
        allReverseFrontier, allFrontierIndex, allOutput, allScratch,
        allFunctionSlices, err), err)
    var allSourceCounts: int32[] = [2, 0, 1]
    AssertFunctionSourceSlices(allFunctionSlices, allOutput, profiles,
                               allSourceCounts)
    let thirdRow = fslice.FunctionSourceSliceIndexGetRow(allFunctionSlices, 2)
    assert(allOutput.sourceCount == 2 && thirdRow.sourceIndex == 2 &&
           thirdRow.functionIndex == 2 && thirdRow.exprStart == 0,
           "function-slice-multi-source-canonical")
    var multiSourceConsumerReport = allFrontierIndex.lastStructuredSidecar
    var multiSourceRootIndexes: int32[]
    var multiSourceExpectedFactCount: int32
    assert(ccsg.CompilerCsgFunctionSourceSliceRowsValidate(
               allFunctionSlices, set, allReverseFrontier, allOutput,
               multiSourceConsumerReport, multiSourceRootIndexes,
               multiSourceExpectedFactCount, err), err)
    assert(multiSourceConsumerReport.consumerIndexRowVisitCount == Int64(3) &&
           multiSourceConsumerReport.consumerExprVisitCount ==
               Int64(allOutput.exprs.len) &&
           multiSourceConsumerReport.consumerScopeVisitCount ==
               Int64(allFunctionSlices.scopeCommitVisitCount) &&
           multiSourceConsumerReport.consumerStatementVisitCount ==
               Int64(allFunctionSlices.statementCommitVisitCount) &&
           multiSourceRootIndexes.len == allFunctionSlices.expectedSourceCount &&
           multiSourceRootIndexes[0] == 0 &&
           multiSourceRootIndexes[2] > multiSourceRootIndexes[0] &&
           multiSourceExpectedFactCount >= 0,
           "function-slice-multi-source-consumer-global-cursor")

    var duplicateCache: ccsg.CompilerCsgProfileCallLookupStore
    var duplicateFrontierIndex: ccsg.CompilerCsgFrontierIndex
    ccsg.CompilerCsgFrontierIndexBegin(duplicateFrontierIndex, profiles.len,
                                      set.functionNames.len)
    var duplicateOutput: parser.NormalizedExprLayer
    var duplicateScratch: parser.NormalizedExprLayer
    parser.NormalizedExprLayerAppend(duplicateOutput, FixturePath, 30, 1,
        parser.NormalizedExprCall, parser.NormalizedExprDetailNone, "sentinel")
    parser.NormalizedExprLayerAppend(duplicateScratch, FixturePath, 31, 1,
        parser.NormalizedExprCall, parser.NormalizedExprDetailNone, "scratch")
    var preservedSlices = fslice.FunctionSourceSliceIndexInit(profiles.len, 0)
    fslice.FunctionSourceSliceIndexSeal(preservedSlices)
    var duplicateFrontier: int32[] = [0, 0]
    assert(!ccsg.CompilerCsgExprLayerForFrontierFunctions(snapshots,
        snapshotIndex, profiles, profileLookup, duplicateCache, set,
        duplicateFrontier, duplicateFrontierIndex, duplicateOutput,
        duplicateScratch, preservedSlices, err) &&
        strutil.Contains(err, "function index conflict") &&
        duplicateOutput.exprs.len == 1 &&
        duplicateOutput.exprs[0].surfaceText == "sentinel" &&
        duplicateScratch.exprs.len == 1 &&
        duplicateScratch.exprs[0].surfaceText == "scratch" &&
        preservedSlices.sealed && !preservedSlices.released &&
        preservedSlices.expectedFunctionCount == 0 &&
        fslice.FunctionSourceSliceIndexSourceCount(preservedSlices, 0) == 0 &&
        fslice.FunctionSourceSliceIndexSourceCount(preservedSlices, 1) == 0 &&
        fslice.FunctionSourceSliceIndexSourceCount(preservedSlices, 2) == 0,
        "duplicate-frontier-atomic")

    fslice.FunctionSourceSliceIndexRelease(functionSlices)
    fslice.FunctionSourceSliceIndexRelease(allFunctionSlices)
    fslice.FunctionSourceSliceIndexRelease(preservedSlices)
    assert(functionSlices.released && allFunctionSlices.released &&
           preservedSlices.released && functionSlices.sourceIndices.len == 0 &&
           allFunctionSlices.sourceIndices.len == 0 &&
           preservedSlices.sourceIndices.len == 0,
           "function-slice-release")
    parser.NormalizedExprLayerReset(allOutput)
    parser.NormalizedExprLayerReset(allScratch)
    parser.NormalizedExprLayerReset(duplicateOutput)
    parser.NormalizedExprLayerReset(duplicateScratch)
    ccsg.CompilerCsgReleaseImmutableSourceSnapshots(snapshots, snapshotIndex)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(set)

    profiles = []
    snapshots = []
    BuildFixture(profiles, set, snapshots, snapshotIndex)
    set.startLines[1] = 9
    var sealErr: str
    assert(ccsg.CompilerCsgReachableFunctionSetSealStructure(set, sealErr),
           sealErr)
    let overlapLookup = parser.ParserSourcePathIndexLookupBuild(profiles)
    cache = ccsg.CompilerCsgProfileCallLookupStore()
    frontierIndex = ccsg.CompilerCsgFrontierIndex()
    ccsg.CompilerCsgFrontierIndexBegin(frontierIndex, profiles.len,
                                      set.functionNames.len)
    parser.NormalizedExprLayerAppend(output, FixturePath, 30, 1,
        parser.NormalizedExprCall, parser.NormalizedExprDetailNone, "sentinel")
    parser.NormalizedExprLayerAppend(scratch, FixturePath, 31, 1,
        parser.NormalizedExprCall, parser.NormalizedExprDetailNone, "scratch")
    var overlapSlices = fslice.FunctionSourceSliceIndexInit(profiles.len, 0)
    fslice.FunctionSourceSliceIndexSeal(overlapSlices)
    assert(!ccsg.CompilerCsgExprLayerForFrontierFunctions(snapshots,
        snapshotIndex, profiles, overlapLookup, cache, set, reverseFrontier,
        frontierIndex, output, scratch, overlapSlices, err) &&
        strutil.Contains(err, "ranges overlap") &&
        output.exprs.len == 1 && output.exprs[0].surfaceText == "sentinel" &&
        scratch.exprs.len == 1 && scratch.exprs[0].surfaceText == "scratch" &&
        overlapSlices.sealed && !overlapSlices.released &&
        overlapSlices.expectedFunctionCount == 0 &&
        cache.entries.len == 0, "overlap-atomic")
    fslice.FunctionSourceSliceIndexRelease(overlapSlices)
    parser.NormalizedExprLayerReset(output)
    parser.NormalizedExprLayerReset(scratch)
    ccsg.CompilerCsgReleaseImmutableSourceSnapshots(snapshots, snapshotIndex)
    ccsg.CompilerCsgReachableFunctionSetReleaseIndexes(set)

    var sourceLines = parser.ParserSplitChar(FixtureText(), '\n')
    parser.ParserJoinContinuationLinesInPlace(sourceLines)
    var facts: parser.ParserStructuredSourceFacts
    var slice: parser.ParserStructuredSourceSlice
    assert(parser.ParserStructuredSourceFactsBuild(FixturePath, sourceLines,
        facts, err), err)
    assert(parser.ParserStructuredSourceFactsSliceBuild(facts, 1, 9,
        slice, err), err)
    var functionLayer: parser.NormalizedExprLayer
    assert(parser.ParserStructuredSourceSliceAppendToLayer(slice,
        functionLayer, err), err)
    var changed = false
    for scopeIndex in 0..<functionLayer.scopes.len:
        if functionLayer.scopes[scopeIndex].ownerStatementOrdinal >= 0:
            functionLayer.scopes[scopeIndex].ownerStatementOrdinal = -1
            changed = true
            break
    var domain: ccsg.CompilerCsgStructuredSourceDomain
    var stagedTarget: parser.NormalizedExprLayer
    ccsg.CompilerCsgStructuredSourceDomainInit(facts, domain)
    assert(changed && !ccsg.CompilerCsgStructuredSourceDomainStageSlice(
        facts, slice, functionLayer, 1, 9, domain, stagedTarget, err) &&
        strutil.Contains(err, "scope identity mismatch") &&
        stagedTarget.exprs.len == 0 && stagedTarget.scopes.len == 0,
        "owner-atomic")
    for scopeIndex in 0..<domain.denseScopes.len:
        assert(domain.denseScopes[scopeIndex] == -1, "owner-mutated-domain")
    var releaseReport: ccsg.CompilerCsgStructuredSidecarReport
    releaseReport.activeSliceCount = Int64(1)
    releaseReport.activeSlicePeakCount = Int64(1)
    ccsg.CompilerCsgStructuredSourceScratchRelease(facts, slice, domain,
                                                   releaseReport)
    assert(releaseReport.sourceReleaseCount == Int64(1) &&
           releaseReport.activeSliceCount == Int64(0) &&
           releaseReport.finalScratchCapacityBytes == Int64(0) &&
           releaseReport.finalScratchLiveBytes == Int64(0), "owner-release")
    parser.NormalizedExprLayerReset(functionLayer)
    parser.NormalizedExprLayerReset(stagedTarget)
    return 0
