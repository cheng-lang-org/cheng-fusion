import std/system
import std/strings
import cheng/core/lang/intern as langintern

fn main() =
    var largePool = langintern.InternPoolNew()
    var largeKeys: str[]
    let largeCount: int32 = 4096
    for i in 0..<largeCount:
        let key = Fmt"lookup-key-{i}"
        add(largeKeys, strings.CloneStr(key))
        assert(langintern.Intern(largePool, key) == i,
               "repro C: large insert id")
    langintern.InternPoolRelease(largePool)
    echo("repro_orc_intern_c ok")
