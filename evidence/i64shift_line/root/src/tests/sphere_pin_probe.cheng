# Sphere-pin + anchor-distance probe (machine-duck A-segment M3):
#   A. pin capture: a point mass flies at the capsule anchor, the pin
#      (kind 7) welds it on; the pair keeps flying and falling together
#      with the anchor gap converging under 1 mm, no step rejected
#   B. hybrid leg swing: point - capsule - point chain (hip Anchor kind 3,
#      two pins) released tilted, swinging about the hip for 50 ticks,
#      both pin gaps under 2 mm, no rejection
#   C. anchor-distance servo: pelvis - knee - capsule-shank two-bone leg,
#      the kind 8 servo walks the pelvis-to-foot-anchor distance to the
#      30 deg law-of-cosines target; measured flexion lands within 2 deg
#      and the knee pin holds under 2 mm
#   D. preimage: joint-kind worlds hash differently from joint-free ones,
#      hashing is stable
import cheng/game/world3d
import cheng/game/physics3d
import cheng/game/constraints3d
import cheng/game/csg/joint_motor
import cheng/game/csg/numerics
import std/math as m
import std/strings as strings

fn fmtMm(x: float64): str =
    let scaled: int32 = int32(m.roundFloat(x * 1000.0))
    var neg: bool = scaled < 0
    var mag: int32 = scaled
    if neg:
        mag = 0 - mag
    let intPart: int32 = mag / 1000
    let fracPart: int32 = mag % 1000
    var outStr: str = ""
    if neg:
        outStr = "-"
    outStr = outStr + strings.IntToStr(intPart) + "." + strings.CloneStrRange(strings.IntToStr(fracPart + 1000), 1, 3)
    return outStr

fn caseJointPreimage(): bool =
    var wa: world3d.World3d
    World3dReset(wa, int64(81))
    let _a = World3dSpawnCapsule(wa, 0.0, 0.0, 2.0, 2.0, 0.04, 0.12, 1.0, 0.0, 0.0, 0.0)
    let _b = World3dSpawnBody(wa, 0.0, 0.0, 2.12, 0.2, 0.02, world3d.World3dBodyDynamic)
    var wb: world3d.World3d
    World3dReset(wb, int64(81))
    let _c = World3dSpawnCapsule(wb, 0.0, 0.0, 2.0, 2.0, 0.04, 0.12, 1.0, 0.0, 0.0, 0.0)
    let _d = World3dSpawnBody(wb, 0.0, 0.0, 2.12, 0.2, 0.02, world3d.World3dBodyDynamic)
    let _ci = World3dAddSpherePin(wb, 0, 1, 0.0, 0.0, 0.12)
    let cidA = World3dCid(wa)
    let cidA2 = World3dCid(wa)
    let cidB = World3dCid(wb)
    let cidB2 = World3dCid(wb)
    echo("case pin preimage cidA(no joint)=" + cidA)
    echo("case pin preimage cidB(pin)=" + cidB)
    if cidA != cidA2:
        return false
    if cidB != cidB2:
        return false
    if cidA == cidB:
        return false
    return true

# A. point mass closing on the capsule anchor at 1 m/s, pin active from
#    tick 0: the projection welds the pair inside the first tick and the
#    compound body flies on (vx ~ 0.43 by momentum) while falling freely.
fn casePinCapture(): bool =
    var w: world3d.World3d
    World3dReset(w, int64(81))
    let _c = World3dSpawnCapsule(w, 0.0, 0.0, 2.0, 2.0, 0.04, 0.12, 1.0, 0.0, 0.0, 0.0)
    let _p = World3dSpawnBody(w, 0.03, 0.0, 2.12, 0.2, 0.02, world3d.World3dBodyDynamic)
    w.bodyVx[0] = 0.5
    w.bodyVx[1] = -0.5
    let ci = World3dAddSpherePin(w, 0, 1, 0.0, 0.0, 0.12)
    var sTick: int32[]
    var sGap: float64[]
    setLen(sTick, 7)
    setLen(sGap, 7)
    var rejected: int32 = 0
    var si: int32 = 0
    var i: int32 = 0
    while i < 120:
        var r = physics3d.Physics3dStep(w, "probe:pin")
        if r.statusCode != physics3d.Physics3dStatusOk:
            rejected = rejected + 1
        if i % 20 == 0:
            sTick[si] = i
            sGap[si] = Constraints3dJointAnchorGap(w, ci)
            si = si + 1
        i = i + 1
    var k: int32 = 0
    while k < si:
        echo("pin t=" + strings.IntToStr(sTick[k]) + " gap_mm=" + fmtMm(sGap[k] * 1000.0))
        k = k + 1
    if rejected != 0:
        echo("FAIL pin capture rejected=" + strings.IntToStr(rejected))
        return false
    k = 1
    while k < si:
        if sGap[k] > 0.002:
            echo("FAIL pin capture gap at t=" + strings.IntToStr(sTick[k]))
            return false
        k = k + 1
    if sGap[si - 1] > 0.001:
        echo("FAIL pin capture final gap")
        return false
    if w.bodyPz[0] > 1.5:
        echo("FAIL pin capture did not fall")
        return false
    echo("case pin capture end gap_mm=" + fmtMm(sGap[si - 1] * 1000.0) + " cap_z_mm=" + fmtMm(w.bodyPz[0] * 1000.0))
    return true

# B. point - capsule - point hybrid leg: hip Anchor (kind 3, invMass 0),
# thigh capsule tilted 0.4 rad about X hanging below it, foot point mass on
# the lower anchor. Released tilted it swings about the hip; both pins must
# hold for the 50-tick window.
fn caseLegSwing(): bool =
    var w: world3d.World3d
    World3dReset(w, int64(82))
    let _h = World3dSpawnBody(w, 0.0, 0.0, 1.2, 0.0, 0.01, world3d.World3dBodyAnchor)
    let s04 = m.sinFloat(0.4)
    let c04 = m.cosFloat(0.4)
    let qw = m.cosFloat(0.2)
    let qx = m.sinFloat(0.2)
    # top anchor (local +z) sits on the hip, capsule hangs from it
    let comY = 0.15 * s04
    let comZ = 1.2 - 0.15 * c04
    let _b = World3dSpawnCapsule(w, 0.0, comY, comZ, 1.0, 0.03, 0.15, qw, qx, 0.0, 0.0)
    let footY = 0.3 * s04
    let footZ = 1.2 - 0.3 * c04
    let _f = World3dSpawnBody(w, 0.0, footY, footZ, 0.2, 0.02, world3d.World3dBodyDynamic)
    let ciHip = World3dAddSpherePin(w, 1, 0, 0.0, 0.0, 0.15)
    let ciFoot = World3dAddSpherePin(w, 1, 2, 0.0, 0.0, -0.15)
    var sTick: int32[]
    var sGapH: float64[]
    var sGapF: float64[]
    setLen(sTick, 6)
    setLen(sGapH, 6)
    setLen(sGapF, 6)
    var rejected: int32 = 0
    var si: int32 = 0
    var i: int32 = 0
    while i < 50:
        var r = physics3d.Physics3dStep(w, "probe:leg")
        if r.statusCode != physics3d.Physics3dStatusOk:
            rejected = rejected + 1
        if i % 10 == 0:
            sTick[si] = i
            sGapH[si] = Constraints3dJointAnchorGap(w, ciHip)
            sGapF[si] = Constraints3dJointAnchorGap(w, ciFoot)
            si = si + 1
        i = i + 1
    var k: int32 = 0
    while k < si:
        echo("leg t=" + strings.IntToStr(sTick[k]) + " hip_mm=" + fmtMm(sGapH[k] * 1000.0) + " foot_mm=" + fmtMm(sGapF[k] * 1000.0))
        k = k + 1
    if rejected != 0:
        echo("FAIL leg swing rejected=" + strings.IntToStr(rejected))
        return false
    k = 0
    while k < si:
        if sGapH[k] > 0.002:
            echo("FAIL leg swing hip gap at t=" + strings.IntToStr(sTick[k]))
            return false
        if sGapF[k] > 0.002:
            echo("FAIL leg swing foot gap at t=" + strings.IntToStr(sTick[k]))
            return false
        k = k + 1
    # the swing stays bounded: foot stays near the hip (bone length 0.3)
    let dx = w.bodyPx[2] - w.bodyPx[0]
    let dy = w.bodyPy[2] - w.bodyPy[0]
    let dz = w.bodyPz[2] - w.bodyPz[0]
    let hipFoot = numerics.CsgSqrt(dx * dx + dy * dy + dz * dz)
    echo("case leg swing end hipfoot_mm=" + fmtMm(hipFoot * 1000.0) + " gapH_mm=" + fmtMm(sGapH[si - 1] * 1000.0) + " gapF_mm=" + fmtMm(sGapF[si - 1] * 1000.0))
    if hipFoot > 0.35:
        echo("FAIL leg swing unbounded")
        return false
    return true

# C. anchor-distance servo (kind 8) driving a two-bone hybrid leg through
#    the law-of-cosines mapping: pelvis Anchor - knee point (ConJoint) -
#    shank capsule pinned at the knee; the servo walks the pelvis-to-foot
#    anchor distance to the 30 deg flexion target at 2 mm/tick.
fn caseAnchorDistServo(): bool =
    var w: world3d.World3d
    World3dReset(w, int64(83))
    let _p = World3dSpawnBody(w, 0.0, 0.0, 1.0, 0.0, 0.01, world3d.World3dBodyAnchor)
    let _k = World3dSpawnBody(w, 0.001, 0.0, 0.5, 0.5, 0.02, world3d.World3dBodyDynamic)
    let dx0 = w.bodyPx[1] - w.bodyPx[0]
    let dy0 = w.bodyPy[1] - w.bodyPy[0]
    let dz0 = w.bodyPz[1] - w.bodyPz[0]
    let l1 = numerics.CsgSqrt(dx0 * dx0 + dy0 * dy0 + dz0 * dz0)
    let _j = World3dAddConstraint(w, 0, 1, l1, world3d.World3dConJoint)
    let _s = World3dSpawnCapsule(w, 0.001, 0.0, 0.3, 0.5, 0.03, 0.2, 1.0, 0.0, 0.0, 0.0)
    let ciKnee = World3dAddSpherePin(w, 2, 1, 0.0, 0.0, 0.2)
    let ciDist = World3dAddAnchorDist(w, 2, 0, 0.0, 0.0, -0.2, 0.002)
    let l2: float64 = 0.4
    w.conGoal[ciDist] = JointMotorAngleToDist(l1, l2, 30.0)
    var sTick: int32[]
    var sTheta: float64[]
    var sGapK: float64[]
    var sGapD: float64[]
    setLen(sTick, 6)
    setLen(sTheta, 6)
    setLen(sGapK, 6)
    setLen(sGapD, 6)
    var rejected: int32 = 0
    var si: int32 = 0
    var i: int32 = 0
    while i < 600:
        var r = physics3d.Physics3dStep(w, "probe:adist")
        if r.statusCode != physics3d.Physics3dStatusOk:
            rejected = rejected + 1
        if (i + 1) % 100 == 0:
            sTick[si] = i
            let dMeas = Constraints3dJointAnchorGap(w, ciDist)
            sTheta[si] = JointMotorDistToAngle(l1, l2, dMeas)
            sGapD[si] = dMeas
            sGapK[si] = Constraints3dJointAnchorGap(w, ciKnee)
            si = si + 1
        i = i + 1
    var k: int32 = 0
    while k < si:
        echo("adist t=" + strings.IntToStr(sTick[k]) + " th_deg=" + fmtMm(sTheta[k]) + " knee_mm=" + fmtMm(sGapK[k] * 1000.0) + " dist_mm=" + fmtMm(sGapD[k] * 1000.0))
        k = k + 1
    if rejected != 0:
        echo("FAIL anchor dist rejected=" + strings.IntToStr(rejected))
        return false
    k = 3
    while k < si:
        if m.absFloat(sTheta[k] - 30.0) > 2.0:
            echo("FAIL anchor dist angle at t=" + strings.IntToStr(sTick[k]))
            return false
        if sGapK[k] > 0.002:
            echo("FAIL anchor dist knee gap at t=" + strings.IntToStr(sTick[k]))
            return false
        k = k + 1
    echo("case anchor dist end th_deg=" + fmtMm(sTheta[si - 1]) + " knee_mm=" + fmtMm(sGapK[si - 1] * 1000.0))
    return true

fn main(): int32 =
    if !caseJointPreimage():
        echo("FAIL caseJointPreimage")
        return 1
    if !casePinCapture():
        echo("FAIL casePinCapture")
        return 1
    if !caseLegSwing():
        echo("FAIL caseLegSwing")
        return 1
    if !caseAnchorDistServo():
        echo("FAIL caseAnchorDistServo")
        return 1
    echo("PASS sphere pin probe")
    return 0
