import cheng/core/ir/body_ir_noalias as noalias
import cheng/core/ir/core_types as ir
import cheng/tests/noalias_finalize_stage_probe_lib as probe

fn main(): int32 =
    var bodyIR = ir.BodyIRNew()
    let a = probe.ProbeAddI32Slot(bodyIR, "a", true)
    let b = probe.ProbeAddI32Slot(bodyIR, "b", true)
    let c = probe.ProbeAddI32Slot(bodyIR, "c", true)
    probe.ProbeAppendLoad(bodyIR, b, a)
    probe.ProbeAppendCopy(bodyIR, c, b)
    let _ = noalias.BodyIrNoAliasForwardLocals(bodyIR)
    return 77
