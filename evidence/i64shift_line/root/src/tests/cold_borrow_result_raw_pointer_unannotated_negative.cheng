import std/system as system

@borrows
fn coldRawPointerUnannotated(s: str): ptr =
    return system.StrDataPtr(s)

@borrows
@borrow_result
fn coldRawPointerBorrowed(s: str): ptr =
    return coldRawPointerUnannotated(s)

fn main(): int32 =
    let text = "borrow-result"
    let value = coldRawPointerBorrowed(text)
    if value == nil:
        return 1
    return 0
