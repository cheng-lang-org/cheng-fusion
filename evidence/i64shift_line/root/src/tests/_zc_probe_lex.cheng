import std/system
import std/strings
import cheng/core/lang/parser as parser

fn main(): int32 =
    let target = os.GetEnv("ZC_LEX_FILE")
    if target == "":
        echo("ZC_LEX_FILE missing")
        return 1
    echo("LEXING " + target)
    var text: str
    var terr: str
    var noRoots: parser.ParserExternalPackageRoot[]
    if !parser.ParserSourceTextWithExternalPackageRootsInto(
            target, noRoots, text, terr):
        echo("TEXT FAIL " + terr)
        return 2
    var valueTree: parser.ParserValueExprTree
    var lerr: str
    if !parser.ParserValueExprReadTreeFromText(
            strings.CloneStr(text), valueTree, lerr):
        echo("LEX FAIL " + lerr)
        return 3
    parser.ParserValueExprTreeRelease(valueTree)
    echo("LEXED ok")
    return 0
