# CSG 资产管线 A2+A3 冒烟: 统一身份/来源/能力验证/打包封签/原子提交 +
# 有界读取/坐标规范化。正负例逐项断言; 样例读真实 WAV/GLB 夹具。
# 用法: csg_asset_a2_smoke <fixturesDir> <storeDir>
import std/cmdline
import std/os
import std/strings
import std/rawbytes
import cheng/game/assets/import/diagnostic
import cheng/game/assets/import/request
import cheng/game/assets/source_map
import cheng/game/assets/validation
import cheng/game/assets/pack
import cheng/game/assets/import/commit
import cheng/game/assets/import/reader
import cheng/game/assets/import/normalize

fn approxEq(a: float64, b: float64, eps: float64): bool =
    var d = a - b
    if d < 0.0:
        d = 0.0 - d
    return d < eps

fn vecEq(a: normalize.AssetVec3, b: normalize.AssetVec3, eps: float64): bool =
    return approxEq(a.x, b.x, eps) && approxEq(a.y, b.y, eps) &&
        approxEq(a.z, b.z, eps)

fn checkDiagnostic() =
    let d = diagnostic.AssetDiagnosticMake(diagnostic.AssetDiagnosticStageValidate(),
        "glb", "accessors[3].bufferView",
        diagnostic.AssetDiagnosticContractBounds(),
        "byteLength 300 exceeds quota 200", "glb<=256MiB")
    assert(diagnostic.AssetDiagnosticValid(d), "diagnostic valid")
    let line = diagnostic.AssetDiagnosticLine(d)
    assert(strings.HasPrefix(line, "stage=4|object=glb|field=accessors[3].bufferView|contract=bounded-reader-quota-exceeded"),
        "diagnostic canonical line prefix")
    var bad = diagnostic.AssetDiagnosticMake(9, "o", "f", "c", "m", "")
    assert(!diagnostic.AssetDiagnosticValid(bad), "diagnostic stage range rejected")

fn checkRequest() =
    var paths: str[]
    add(paths, "fixtures/glb/static_box.glb")
    var r = request.AssetImportRequestMake("glb", paths, int64(268435456))
    request.AssetImportRequestAddCapability(r, request.AssetCapabilityGeometry())
    request.AssetImportRequestAddCapability(r, request.AssetCapabilityCamera())
    request.AssetImportRequestAddCapability(r, request.AssetCapabilityGeometry())
    assert(request.AssetImportRequestValid(r), "request valid")
    assert(r.requestedCapabilities.len == 2, "capability dedup")
    assert(request.AssetImportRequestHasCapability(r, request.AssetCapabilityCamera()),
        "request has camera")
    let p1 = request.AssetImportRequestPreimage(r)
    let p2 = request.AssetImportRequestPreimage(r)
    assert(p1 == p2, "request preimage stable")
    var bad = r
    bad.format = "fbx"
    assert(!request.AssetImportRequestValid(bad), "unsupported format rejected")

fn checkSourceMapAndValidation() =
    var paths: str[]
    add(paths, "fixtures/glb/static_box.glb")
    var r = request.AssetImportRequestMake("glb", paths, int64(268435456))
    request.AssetImportRequestAddCapability(r, request.AssetCapabilityGeometry())
    request.AssetImportRequestAddCapability(r, request.AssetCapabilityCamera())

    var m = source_map.AssetSourceMapMake(
        "1111111111111111111111111111111111111111111111111111111111111111",
        "2222222222222222222222222222222222222222222222222222222222222222")
    m.provenance.toolName = "cheng-csg-asset-fixtures"
    m.provenance.toolVersion = "1.0"
    m.provenance.exportOptions = "deterministic"

    var e: source_map.AssetSourceMapEntry
    e.identity.kind = source_map.AssetSourceIdentityKindExchangePath()
    e.identity.sourceSystem = "glb"
    e.identity.rowKey = "/nodes/1"
    e.exchangePath = "/nodes/1"
    e.assetKind = "mesh"
    source_map.AssetSourceMapAddEntry(m, e)
    assert(source_map.AssetSourceMapValid(m), "source map valid single entry")

    var cGeom: source_map.AssetCapabilityRecord
    cGeom.cap = request.AssetCapabilityGeometry()
    cGeom.requested = true
    cGeom.sourceDeclared = true
    cGeom.verified = true
    cGeom.evidenceRef = "generator-truth-match"
    cGeom.originClass = source_map.AssetOriginClassOriginal()
    source_map.AssetSourceMapAddCap(m, cGeom)

    # 负例: requested 但未 verified => 拒绝并给具体诊断。
    var outNeg = validation.AssetValidate(r, m)
    assert(!outNeg.ok, "unverified capability rejected")
    if outNeg.diagnostics.len != 1:
        echo(Fmt"a2 neg diag count={outNeg.diagnostics.len}")
        for di in 0..<outNeg.diagnostics.len:
            echo(Fmt"a2 neg diag: {outNeg.diagnostics[di].message}")

    var cCam: source_map.AssetCapabilityRecord
    cCam.cap = request.AssetCapabilityCamera()
    cCam.requested = true
    cCam.sourceDeclared = true
    cCam.verified = true
    cCam.evidenceRef = "khronos-validator-0-errors"
    cCam.originClass = source_map.AssetOriginClassOriginal()
    source_map.AssetSourceMapAddCap(m, cCam)
    assert(source_map.AssetSourceMapValid(m), "source map valid with caps")

    let outPos = validation.AssetValidate(r, m)
    assert(outPos.ok, "verified capabilities accepted")

    let cid1 = source_map.AssetSourceMapCid(m)
    let cid2 = source_map.AssetSourceMapCid(m)
    assert(cid1 == cid2 && cid1.len == 64, "source map cid stable 64hex")

    # 负例: 身份重复行拒绝。
    var mDup = m
    var e2: source_map.AssetSourceMapEntry
    e2.identity.kind = source_map.AssetSourceIdentityKindExchangePath()
    e2.identity.sourceSystem = "glb"
    e2.identity.rowKey = "/nodes/1"
    e2.exchangePath = "/nodes/1"
    e2.assetKind = "material"
    source_map.AssetSourceMapAddEntry(mDup, e2)
    assert(!source_map.AssetSourceMapValid(mDup), "duplicate identity rejected")

# 构造即拥有: 包在函数内组装并以 move 交付 (避开 var 形参变异后的移交权威问题)。
fn buildPackA(factOrder: int32): pack.AssetPack =
    var p = pack.AssetPackMake(
        "3333333333333333333333333333333333333333333333333333333333333333",
        "4444444444444444444444444444444444444444444444444444444444444444")
    if factOrder == 0:
        pack.AssetPackAddFact(p, "mesh.count", "1")
        pack.AssetPackAddFact(p, "coordinate.system", "zup-right-handed-meter")
        pack.AssetPackAddFact(p, "node.count", "3")
    else:
        pack.AssetPackAddFact(p, "node.count", "3")
        pack.AssetPackAddFact(p, "coordinate.system", "zup-right-handed-meter")
        pack.AssetPackAddFact(p, "mesh.count", "1")
    pack.AssetPackAddResource(p,
        "5555555555555555555555555555555555555555555555555555555555555555",
        pack.AssetResourceKindGeometry(), "BoxA.mesh", int64(2164))
    return p

fn checkPack() =
    var p = buildPackA(0)
    let c1 = pack.AssetPackSealCid(p)
    assert(c1.len == 64, "pack seal cid 64hex")

    # 事实行乱序重放: 排序后封签必须同 CID (canonical 合同)。
    var q = buildPackA(1)
    let c2 = pack.AssetPackSealCid(q)
    if c2 != c1:
        var si: int32
        while si < q.facts.len:
            echo(Fmt"a2 qfact={q.facts[si]}")
            si = si + 1
        echo(Fmt"a2 seal diff c1={c1} c2={c2}")
    assert(c2 == c1, "fact order irrelevant to seal")

    # 坏资源 (cid 长度) => 封签拒绝 (空串)。
    var bad = pack.AssetPackMake("aa", "bb")
    pack.AssetPackAddResource(bad, "short", pack.AssetResourceKindGeometry(),
        "x", int64(1))
    assert(pack.AssetPackSealCid(bad).len == 0, "invalid resource rejected")

@borrows
fn checkCommit(storeDir: str) =
    var s = commit.AssetCommitSessionMake(storeDir)
    assert(commit.AssetCommitSessionValid(s), "commit session valid")

    # 负例: 未 validated 直接 admit/activate 必须失败。
    assert(!commit.AssetCommitAdmitObject(s, makeCid64(1), "payload"),
        "admit before validated rejected")
    assert(!commit.AssetCommitActivate(s), "activate before admitted rejected")

    # validated -> admit -> mark -> activate 全链。
    s.state = commit.AssetCommitStateValidated()
    let cid = makeCid64(7)
    assert(commit.AssetCommitAdmitObject(s, cid, "payload-bytes"),
        "admit object ok")
    assert(commit.AssetCommitMarkAdmitted(s, makeCid64(7)),
        "mark admitted ok")
    assert(commit.AssetCommitActivate(s), "activate ok")

    # head 重启校验: 已激活 => 有效; 破坏 head (指向不存在对象) => 拒绝。
    assert(commit.AssetCommitHeadValidOnRestart(storeDir), "head valid after activate")
    let objPath = commit.AssetCommitObjectPath(s, makeCid64(7))
    assert(strings.HasSuffix(objPath, makeCid64(7)), "object path ends with cid")
    assert(strings.HasPrefix(objPath, Fmt"{storeDir}/objects/"), "object path layout")

fn makeCid64(seed: int32): str =
    var parts: str[]
    var i: int32
    while i < 64:
        add(parts, strings.IntToStr((seed + i) % 10))
        i = i + 1
    var out: str
    for k in 0..<parts.len:
        out = out + parts[k]
    return out

@borrows
fn checkReader(fixturesDir: str) =
    let wavPath = Fmt"{fixturesDir}/media/sample_440hz_2s.wav"
    var bounds = reader.AssetReaderBoundsFor("wav")
    assert(bounds.maxBytes == reader.AssetReaderQuotaMaxMedia(),
        "media quota wired")

    # 冻结捕获 + 内容身份。
    let frozen = reader.AssetFrozenInputCapture(wavPath, bounds)
    assert(frozen.sealed, "wav captured")
    assert(frozen.sizeBytes == int64(192078), "wav size matches frozen sample")
    assert(frozen.shaCid.len == 64, "wav cid 64hex")
    assert(reader.AssetFrozenInputStillValid(frozen), "wav frozen still valid")

    # 有界载荷读取。
    var data = rawbytes.EmptyBytes()
    assert(reader.AssetReaderLoadBounded(wavPath, bounds, data), "load bounded")
    assert(int64(rawbytes.BytesLen(data)) == frozen.sizeBytes, "load size equal")

    # RIFF 头: u32le = 0x46464952。
    var fourcc: int64
    assert(reader.AssetReaderU32At(data, 0, fourcc), "u32 at 0")
    assert(fourcc == int64(1179011410), "RIFF fourcc value")
    var u16v: int32
    assert(reader.AssetReaderU16At(data, 20, u16v), "u16 fmt audioFormat")
    assert(u16v == 1, "PCM audio format=1")

    # 范围证明负例: 越界/负长度/溢出。
    assert(!reader.AssetReaderRangeProven(int64(10), int64(8), int64(4)),
        "range beyond size rejected")
    assert(!reader.AssetReaderRangeProven(int64(10), int64(-1), int64(1)),
        "negative offset rejected")
    assert(!reader.AssetReaderRangeProven(int64(2147483647), int64(2147483646),
        int64(4)), "int32 overflow proven rejected")
    var view = reader.AssetReaderViewRange(data, int64(0), int64(4))
    assert(rawbytes.BytesLen(view) == 4, "view range ok")
    var badView = reader.AssetReaderViewRange(data, int64(192077), int64(4))
    assert(rawbytes.BytesLen(badView) == 0, "view beyond size empty")

    # 超配额负例。
    var tiny = bounds
    tiny.maxBytes = int64(16)
    assert(!reader.AssetReaderLoadBounded(wavPath, tiny, data),
        "over-quota rejected")
    rawbytes.BytesFree(data)

fn checkNormalize() =
    # 轴变换: (1,2,3) -> (1,-3,2)。
    let v = normalize.AssetNormalizeVec3(normalize.AssetVec3Make(1.0, 2.0, 3.0))
    assert(vecEq(v, normalize.AssetVec3Make(1.0, -3.0, 2.0), 0.000000000001),
        "yup->zup mapping")

    # 恒等四元数 -> 恒等矩阵; 奇异 (零缩放) 拒绝; 镜像检出。
    let ident = normalize.AssetMatFromQuat(0.0, 0.0, 0.0, 1.0)
    assert(approxEq(ident.m00, 1.0, 0.000000000001) && approxEq(ident.m11, 1.0, 0.000000000001) &&
        approxEq(ident.m22, 1.0, 0.000000000001), "identity quat matrix")

    var trs: normalize.AssetNodeTrs
    trs.rx = 0.0
    trs.ry = 0.0
    trs.rz = 0.0
    trs.rw = 1.0
    trs.sx = 2.0
    trs.sy = 2.0
    trs.sz = 2.0
    trs.t = normalize.AssetVec3Make(1.0, 2.0, 3.0)
    let src = normalize.AssetMatFromTrs(trs)
    let world = normalize.AssetMatToWorld(src)
    assert(!normalize.AssetMatSingular(src), "scaled matrix not singular")

    # 不变量: world(A(p)) == A(src(p)) —— 共轭 = 坐标系变换语义 (点变换含平移)。
    let p = normalize.AssetVec3Make(0.5, -1.0, 2.0)
    let pa = normalize.AssetNormalizeVec3(p)
    let lhs = normalize.AssetMatMulVecPoint(world, pa)
    let rhs = normalize.AssetNormalizeVec3(normalize.AssetMatMulVecPoint(src, p))
    assert(vecEq(lhs, rhs, 0.000000001), "conjugation invariant")

    # 平移共轭: world.t == A * src.t。
    let expectT = normalize.AssetNormalizeVec3(trs.t)
    assert(approxEq(world.tx, expectT.x, 0.000000000001) &&
        approxEq(world.ty, expectT.y, 0.000000000001) &&
        approxEq(world.tz, expectT.z, 0.000000000001), "translation conjugated")

    var zeroS: normalize.AssetNodeTrs
    zeroS.rw = 1.0
    let zeroM = normalize.AssetMatFromTrs(zeroS)
    assert(normalize.AssetMatSingular(zeroM), "zero scale singular rejected")

    # 镜像: sx=-1 => det<0。
    var mir: normalize.AssetNodeTrs
    mir.rw = 1.0
    mir.sx = -1.0
    mir.sy = 1.0
    mir.sz = 1.0
    assert(normalize.AssetMatMirrored(normalize.AssetMatFromTrs(mir)), "mirror detected")

    # 单位: 米制恒等 (量纲独立, 禁止全字段乘比例)。
    assert(normalize.AssetNormalizeLengthMeters(2.5) == 2.5, "meter identity")

fn main(): int32 =
    let argc = cmdline.paramCount()
    if argc < 2:
        echo("usage: csg_asset_a2_smoke <fixturesDir> <storeDir>")
        return 2
    let fixturesDir = Fmt"{cmdline.paramStr(1)}"
    let storeDir = Fmt"{cmdline.paramStr(2)}"
    checkDiagnostic()
    checkRequest()
    checkSourceMapAndValidation()
    checkPack()
    checkCommit(storeDir)
    checkReader(fixturesDir)
    checkNormalize()
    echo("csg_asset_a2_smoke PASS")
    return 0
