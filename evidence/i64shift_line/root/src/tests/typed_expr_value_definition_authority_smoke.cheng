import std/cmdline as cmdline
import std/strings
import cheng/core/lang/intern as langintern
import cheng/core/lang/parser as parser
import cheng/core/lang/typed_expr as texpr
import cheng/core/lang/typed_expr_type_arena as typearena
import cheng/core/runtime/arena as arenamod

fn ProductionSource(): str =
    return "fn Run(value: int32): int32 =\n    var first: int32 = value\n    var second: int32 = first\n    return second\n"

fn CompoundPatternSource(): str =
    return "fn Run(xs: int32[]): int32 =\n    var (left, {right, named: nested}) = xs\n    return left\n"

fn CallInitializerSource(): str =
    return "fn Run(value: int32): int32 =\n    var first: int32 = int32(value)\n    return first\n"

fn ManagedSource(): str =
    return "fn Run(value: str): str =\n    var first: str = value\n    return first\n"

fn UppercaseInitializerSource(): str =
    return "fn Main(): int32 =\n    let Shared = 5\n    var Mutable = 6\n    const Fixed = 7\n    return Shared + Mutable + Fixed\n"

@borrows
fn SourceText(path: str, source: str): texpr.TypedExprSourceText =
    var roots: parser.ParserExternalPackageRoot[]
    let ownedPath = strings.CloneStr(path)
    let ownedSource = strings.CloneStr(source)
    return texpr.TypedExprSourceTextNewWithPackageFacts(
        "/work",
        "/work",
        "pkg://typed-expr-value-definition",
        "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
        roots,
        ownedPath,
        ownedSource)

fn BindExactTypeArena(
        source: str,
        ir: var texpr.TypedExprIr,
        exactArena: var typearena.TypedExprTypeArena) =
    var parserTree: parser.ParserValueExprTree
    var err: str
    assert(parser.ParserValueExprReadTreeFromText(
               source, parserTree, err),
           Fmt"typed expr value definition: parser tree failed {err}")
    let authority =
        typearena.TypedExprTypeResolutionAuthorityEmpty()
    assert(typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               parserTree, authority, exactArena, err) &&
           typearena.TypedExprTypeArenaStrictValidateInto(
               exactArena, err),
           Fmt"typed expr value definition: TypeArena failed {err}")
    assert(texpr.TypedExprIrBindExactTypeArena(
               ir, exactArena, err),
           Fmt"typed expr value definition: TypeArena bind failed {err}")
    parser.ParserValueExprTreeRelease(parserTree)

fn BuildSourceBeforeEnd(
        path: str,
        source: str,
        layer: var parser.NormalizedExprLayer,
        ir: var texpr.TypedExprIr,
        exactArena: var typearena.TypedExprTypeArena) =
    let sourceText = SourceText(path, source)
    var sourceTexts = [sourceText]
    var err: str
    assert(texpr.TypedExprReadNormalizedExprLayerForSourceTexts(
               sourceTexts, layer, err),
           Fmt"typed expr value definition: normalized layer failed {err}")
    var contexts: texpr.TypedExprSourceContext[]
    var context: texpr.TypedExprSourceContext
    assert(texpr.TypedExprBuildSourceContext(sourceText, context, err),
           Fmt"typed expr value definition: source context failed {err}")
    texpr.TypedExprSourceContextAppendMove(contexts, context)
    assert(contexts.len == 1 && contexts[0].scopes.len == 1,
           "typed expr value definition: scope domain drift")
    var facts: texpr.TypedExprFactTable
    var normalizedScopeIndex =
        texpr.TypedExprNormalizedScopeIndexBuild(layer)
    ir.internPool = langintern.InternPoolNew()
    BindExactTypeArena(source, ir, exactArena)
    texpr.TypedExprIrBeginValueExprBorrow(ir, layer)
    let initializerRoot = FirstInitializerRoot(layer)
    let parserProducerSourceIndex =
        parser.ParserValueExprNodeProducerSourceIndexAt(
            layer.valueExprTree, initializerRoot)
    let producerSourceIndex =
        texpr.TypedExprSourceContextLookup(contexts, path)
    assert(parserProducerSourceIndex >= 0 && producerSourceIndex >= 0,
           "typed expr value definition: source identity missing")
    texpr.TypedExprIrSetValueDefinitionProducerSourceIndex(
        ir, parserProducerSourceIndex, producerSourceIndex)
    var activeContext =
        texpr.TypedExprSourceContextBorrowedView(contexts[0])
    texpr.TypedExprBuildIrForScopeWithFactsAndExprLayer(
        activeContext,
        contexts,
        activeContext.scopes[0],
        facts,
        0,
        0,
        layer,
        normalizedScopeIndex,
        0,
        layer.exprs.len,
        ir)
    texpr.TypedExprClearSourceContextAllFields(activeContext)
    texpr.TypedExprFactTableRelease(facts)

fn SealExactTypeArena(
        ir: var texpr.TypedExprIr,
        exactArena: var typearena.TypedExprTypeArena) =
    var err: str
    assert(texpr.TypedExprIrSealExactTypeArena(
               ir, exactArena, err),
           Fmt"typed expr value definition: TypeArena seal failed {err}")

fn BuildProduction(
        layer: var parser.NormalizedExprLayer,
        ir: var texpr.TypedExprIr,
        exactArena: var typearena.TypedExprTypeArena) =
    BuildSourceBeforeEnd(
        "/work/production.cheng",
        ProductionSource(),
        layer,
        ir,
        exactArena)
    texpr.TypedExprIrEndValueExprBorrow(ir)
    SealExactTypeArena(ir, exactArena)

fn AssertPositiveAndDeleteAttack() =
    var layer: parser.NormalizedExprLayer
    var ir: texpr.TypedExprIr
    var exactArena: typearena.TypedExprTypeArena
    BuildProduction(layer, ir, exactArena)
    var err: str
    assert(texpr.TypedExprValueDefinitionGroupAuthorityCount(ir) == 2 &&
           texpr.TypedExprValueDefinitionAuthorityCount(ir) == 3 &&
           texpr.TypedExprValueDefinitionAuthorityStrictValidateInto(
               ir, err),
           Fmt"typed expr value definition: production coverage drift {err}")
    for groupRow in 0..<2:
        assert(arenamod.ArenaArrayInt32Get(
                   ir.arena,
                   ir.valueDefinitionGroups_bindingOffsets,
                   groupRow) == 0 &&
               arenamod.ArenaArrayInt32Get(
                   ir.arena,
                   ir.valueDefinitionGroups_bindingCounts,
                   groupRow) == 1,
               "typed expr value definition: persistent root CSR drift")
    for nodePosition in 0..<ir.nodes2_nodeIndexs.len:
        assert(arenamod.ArenaArrayInt32Get(
                   ir.arena,
                   ir.nodes2_valueKinds,
                   nodePosition) ==
                   Int32(texpr.TypedExprSnapshotValueOrdinary) &&
               arenamod.ArenaArrayInt32Get(
                   ir.arena,
                   ir.nodes2_shareKinds,
                   nodePosition) ==
                   Int32(texpr.TypedExprSnapshotShareNone) &&
               arenamod.ArenaArrayInt32Get(
                   ir.arena,
                   ir.nodes2_shareProofKinds,
                   nodePosition) ==
                   Int32(texpr.TypedExprSnapshotValueProofTypeTrait) &&
               arenamod.ArenaArrayInt32Get(
                   ir.arena,
                   ir.nodes2_captureStarts,
                   nodePosition) == 0 &&
               arenamod.ArenaArrayInt32Get(
                   ir.arena,
                   ir.nodes2_captureCounts,
                   nodePosition) == 0 &&
               texpr.TypedExprIrNodeLastUseMoveValueDefIdAt(
                   ir, nodePosition) == -1,
               "typed expr value definition: value/share producer drift")
    var shareMutation = texpr.TypedExprIrClone(ir)
    arenamod.ArenaArrayInt32Set(
        shareMutation.arena,
        shareMutation.nodes2_shareKinds,
        0,
        Int32(texpr.TypedExprSnapshotShareLocal))
    assert(!texpr.TypedExprIrCaptureAuthorityStrictValidateInto(
               shareMutation, err),
           "typed expr value definition: share mutation survived")
    var captureMutation = texpr.TypedExprIrClone(ir)
    arenamod.ArenaArrayInt32Set(
        captureMutation.arena,
        captureMutation.nodes2_captureCounts,
        0,
        1)
    assert(!texpr.TypedExprIrCaptureAuthorityStrictValidateInto(
               captureMutation, err),
           "typed expr value definition: capture omission survived")
    var lastUseMutation = texpr.TypedExprIrClone(ir)
    arenamod.ArenaArrayInt32Set(
        lastUseMutation.arena,
        lastUseMutation.nodes2_lastUseMoveValueDefIds,
        0,
        texpr.TypedExprValueDefinitionAuthorityCount(lastUseMutation))
    assert(!texpr.TypedExprValueDefinitionAuthorityStrictValidateInto(
               lastUseMutation, err),
           "typed expr value definition: invalid last-use move row survived")
    var rootCsrMutation = texpr.TypedExprIrClone(ir)
    arenamod.ArenaArrayInt32Set(
        rootCsrMutation.arena,
        rootCsrMutation.valueDefinitionGroups_bindingCounts,
        0,
        2)
    assert(!texpr.TypedExprValueDefinitionAuthorityStrictValidateInto(
               rootCsrMutation, err),
           "typed expr value definition: root CSR mutation survived")
    var deleted = texpr.TypedExprIrClone(ir)
    deleted.valueDefinitions_originKinds.len =
        deleted.valueDefinitions_originKinds.len - 1
    deleted.valueDefinitions_producerSourceIndexes.len =
        deleted.valueDefinitions_producerSourceIndexes.len - 1
    deleted.valueDefinitions_sourceLocalNodeIndexes.len =
        deleted.valueDefinitions_sourceLocalNodeIndexes.len - 1
    deleted.valueDefinitions_declarationSourceLocalRows.len =
        deleted.valueDefinitions_declarationSourceLocalRows.len - 1
    deleted.valueDefinitions_patternSourceLocalRows.len =
        deleted.valueDefinitions_patternSourceLocalRows.len - 1
    deleted.valueDefinitions_typedFunctionIndexes.len =
        deleted.valueDefinitions_typedFunctionIndexes.len - 1
    deleted.valueDefinitions_definingTypedNodeIndexes.len =
        deleted.valueDefinitions_definingTypedNodeIndexes.len - 1
    deleted.valueDefinitions_exactTypeIds.len =
        deleted.valueDefinitions_exactTypeIds.len - 1
    deleted.valueDefinitions_ownerships.len =
        deleted.valueDefinitions_ownerships.len - 1
    deleted.valueDefinitions_proofKinds.len =
        deleted.valueDefinitions_proofKinds.len - 1
    assert(!texpr.TypedExprValueDefinitionAuthorityStrictValidateInto(
               deleted, err),
           "typed expr value definition: deleted definition row survived")
    echo("typed_expr_value_definition_single_leaf_production=1")
    echo("typed_expr_value_share_producer_mutation_rejected=1")
    echo("typed_expr_closure_capture_omission_rejected=1")
    echo("typed_expr_last_use_move_value_definition_mutation_rejected=1")
    echo("typed_expr_value_definition_root_csr_mutation_rejected=1")
    echo("typed_expr_value_definition_delete_row_rejected=1")
    echo("typed_expr_value_definition_authority_smoke: ok")
    texpr.TypedExprIrReleasePayload(deleted)
    texpr.TypedExprIrReleasePayload(lastUseMutation)
    texpr.TypedExprIrReleasePayload(rootCsrMutation)
    texpr.TypedExprIrReleasePayload(captureMutation)
    texpr.TypedExprIrReleasePayload(shareMutation)
    texpr.TypedExprIrReleasePayload(ir)
    typearena.TypedExprTypeArenaRelease(exactArena)
    parser.NormalizedExprLayerReset(layer)

fn AssertCallInitializerProjectionJoin() =
    var layer: parser.NormalizedExprLayer
    var ir: texpr.TypedExprIr
    var exactArena: typearena.TypedExprTypeArena
    BuildSourceBeforeEnd(
        "/work/call-initializer.cheng",
        CallInitializerSource(),
        layer,
        ir,
        exactArena)
    texpr.TypedExprIrEndValueExprBorrow(ir)
    SealExactTypeArena(ir, exactArena)
    var err: str
    assert(texpr.TypedExprValueDefinitionGroupAuthorityCount(ir) == 1 &&
           texpr.TypedExprValueDefinitionAuthorityCount(ir) == 2 &&
           texpr.TypedExprValueDefinitionAuthorityStrictValidateInto(
               ir, err),
           Fmt"typed expr value definition: call projection join drift {err}")
    echo("typed_expr_value_definition_call_projection_join=1")
    texpr.TypedExprIrReleasePayload(ir)
    typearena.TypedExprTypeArenaRelease(exactArena)
    parser.NormalizedExprLayerReset(layer)

fn AssertManagedShareProducerAuthority() =
    var layer: parser.NormalizedExprLayer
    var ir: texpr.TypedExprIr
    var exactArena: typearena.TypedExprTypeArena
    BuildSourceBeforeEnd(
        "/work/managed.cheng",
        ManagedSource(),
        layer,
        ir,
        exactArena)
    texpr.TypedExprIrEndValueExprBorrow(ir)
    SealExactTypeArena(ir, exactArena)
    var err: str
    assert(texpr.TypedExprValueDefinitionAuthorityStrictValidateInto(
               ir, err),
           Fmt"typed expr managed share: producer authority drift {err}")
    var managedNodeCount: int32
    for nodePosition in 0..<ir.nodes2_nodeIndexs.len:
        if !ir.nodes2_resultTypeManagedFlags[nodePosition]:
            continue
        managedNodeCount = managedNodeCount + 1
        assert(arenamod.ArenaArrayInt32Get(
                   ir.arena,
                   ir.nodes2_shareKinds,
                   nodePosition) !=
                   Int32(texpr.TypedExprSnapshotShareUnknown) &&
               arenamod.ArenaArrayInt32Get(
                   ir.arena,
                   ir.nodes2_shareProofKinds,
                   nodePosition) !=
                   Int32(texpr.TypedExprSnapshotValueProofUnknown),
               "typed expr managed share: proof row missing")
    assert(managedNodeCount > 0,
           "typed expr managed share: managed producer row missing")
    var hinted = texpr.TypedExprIrClone(ir)
    arenamod.ArenaArrayInt32Set(
        hinted.arena,
        hinted.nodes2_lastUseMoveValueDefIds,
        0,
        0)
    assert(!texpr.TypedExprValueDefinitionAuthorityStrictValidateInto(
               hinted, err),
           "typed expr last-use move: unproved positive row survived")
    echo("typed_expr_managed_share_producer_authority=1")
    echo("typed_expr_last_use_move_unproved_positive_rejected=1")
    texpr.TypedExprIrReleasePayload(hinted)
    texpr.TypedExprIrReleasePayload(ir)
    typearena.TypedExprTypeArenaRelease(exactArena)
    parser.NormalizedExprLayerReset(layer)

fn AssertUppercaseInitializerAuthority() =
    var layer: parser.NormalizedExprLayer
    var ir: texpr.TypedExprIr
    var exactArena: typearena.TypedExprTypeArena
    BuildSourceBeforeEnd(
        "/work/uppercase-initializer.cheng",
        UppercaseInitializerSource(),
        layer,
        ir,
        exactArena)
    texpr.TypedExprIrEndValueExprBorrow(ir)
    SealExactTypeArena(ir, exactArena)
    var err: str
    assert(texpr.TypedExprValueDefinitionGroupAuthorityCount(ir) == 3 &&
           texpr.TypedExprValueDefinitionAuthorityCount(ir) == 3 &&
           texpr.TypedExprValueDefinitionAuthorityStrictValidateInto(
               ir, err),
           Fmt"typed expr value definition: uppercase initializer authority drift {err}")
    assert(ir.statements2_statementIndexs.len == 4,
           "typed expr value definition: uppercase initializer statement projection drift")
    echo("typed_expr_uppercase_binding_initializer_authority=1")
    texpr.TypedExprIrReleasePayload(ir)
    typearena.TypedExprTypeArenaRelease(exactArena)
    parser.NormalizedExprLayerReset(layer)

fn FirstInitializerRoot(layer: var parser.NormalizedExprLayer): int32 =
    for exprIndex in 0..<layer.exprs.len:
        if layer.exprs[exprIndex].valueExprStatementRole ==
               parser.ParserValueExprStatementBindingInitializer:
            return layer.exprs[exprIndex].valueExprRootNodeIndex
    panic("typed expr value definition: fixture initializer missing")

fn BuildRegisteredSingleLeaf(
        layer: var parser.NormalizedExprLayer,
        ir: var texpr.TypedExprIr,
        exactArena: var typearena.TypedExprTypeArena,
        groupStart: var int32,
        groupCount: var int32): int32 =
    let path = "/work/single.cheng"
    let source =
        "fn Run(value: int32): int32 =\n    var first: int32 = value\n    return first\n"
    let contextSourceText = SourceText(path, source)
    var err: str
    var context: texpr.TypedExprSourceContext
    assert(texpr.TypedExprBuildSourceContext(
               contextSourceText, context, err) &&
           context.scopes.len == 1,
           Fmt"typed expr value definition: single context failed {err}")
    var contexts: texpr.TypedExprSourceContext[]
    texpr.TypedExprSourceContextAppendMove(contexts, context)
    var sourceTexts = [SourceText(path, source)]
    assert(texpr.TypedExprReadNormalizedExprLayerForSourceTexts(
               sourceTexts, layer, err),
           Fmt"typed expr value definition: single layer failed {err}")
    ir.internPool = langintern.InternPoolNew()
    BindExactTypeArena(source, ir, exactArena)
    texpr.TypedExprIrBeginValueExprBorrow(ir, layer)
    let initializerRoot = FirstInitializerRoot(layer)
    let parserProducerSourceIndex =
        parser.ParserValueExprNodeProducerSourceIndexAt(
            layer.valueExprTree, initializerRoot)
    let producerSourceIndex =
        texpr.TypedExprSourceContextLookup(contexts, path)
    assert(parserProducerSourceIndex >= 0 && producerSourceIndex >= 0,
           "typed expr value definition: single source identity missing")
    texpr.TypedExprIrSetValueDefinitionProducerSourceIndex(
        ir, parserProducerSourceIndex, producerSourceIndex)
    texpr.TypedExprIrRegisterValueDefinitionFunctionGroups(
        ir,
        layer,
        0,
        layer.exprs.len,
        contexts[0].scopes[0],
        0,
        groupStart,
        groupCount)
    assert(groupStart == 0 && groupCount == 1,
           "typed expr value definition: single group registration drift")
    texpr.TypedExprClearSourceContextAllFields(contexts[0])
    return initializerRoot

fn AppendFixtureNode(ir: var texpr.TypedExprIr) =
    texpr.TypedExprIrAppendNode(
        ir,
        texpr.TypedExprIrNode(
            sourcePath: "/work/single.cheng",
            functionName: "Run",
            nodeIndex: 0,
            lineNumber: 2,
            originParserNodeId: -1,
            syntheticOriginKind:
                texpr.TypedExprSyntheticOriginParameter,
            spanAuthorityKind:
                texpr.TypedExprSpanAuthorityNoSource,
            opKind: texpr.TypedExprIrOpLocalRef,
            exprClass: texpr.TypedExprExprUnmanaged,
            resultType: "int32",
            resultTypeProofKind:
                texpr.TypedExprSnapshotTypeProofScalar,
            resultTypeManaged: false,
            resultTypeSend: true,
            resultTypeSync: true,
            resultStructuralTypeId:
                typearena.TypedExprTypeArenaReservedScalarTypeId(
                    ir.exactTypeArena,
                    typearena.TypedExprStructuralScalarInt32),
            surfaceText: "value",
            paramSlot: -1,
            paramName: "",
            operand0NodeIndex: -1,
            operand1NodeIndex: -1,
            operand2NodeIndex: -1,
            literalText: "",
            callTarget: "",
            callTargetSourcePath: "",
            callTargetSignatureLineNumber: 0,
            callTargetImportc: false,
            callDeclarationIndex: -1,
            fieldTypeSourcePath: "",
            fieldOffsetBytes: 0,
            fieldSizeBytes: 0,
            fieldAlignBytes: 0,
            elemSizeBytes: 0))

fn AttackCompoundPattern() =
    var layer: parser.NormalizedExprLayer
    var ir: texpr.TypedExprIr
    var exactArena: typearena.TypedExprTypeArena
    BuildSourceBeforeEnd(
        "/work/compound.cheng",
        CompoundPatternSource(),
        layer,
        ir,
        exactArena)
    panic("typed expr value definition: compound Pattern attack survived")

fn AttackMissingAppender() =
    var layer: parser.NormalizedExprLayer
    var ir: texpr.TypedExprIr
    var exactArena: typearena.TypedExprTypeArena
    var groupStart: int32
    var groupCount: int32
    let _ = BuildRegisteredSingleLeaf(
        layer, ir, exactArena, groupStart, groupCount)
    texpr.TypedExprIrAppendScope(
        ir, 0, -1, parser.NormalizedScopeRoot,
        -1, 0, 1, 1, 3, 16)
    texpr.TypedExprIrAppendFunction(
        ir,
        texpr.TypedExprIrFunction(
            sourcePath: "/work/single.cheng",
            functionName: "Run",
            signatureLineNumber: 1,
            endLineNumber: 3,
            bodyLineNumber: 2,
            returnType: "int32",
            resultExprClass: texpr.TypedExprExprOwned,
            returnExpr: "first",
            statementStart: 0,
            statementCount: 0,
            scopeStart: 0,
            scopeCount: 1,
            nodeStart: 0,
            nodeCount: 0,
            returnNodeIndex: -1,
            valueDefinitionStart: 0,
            valueDefinitionCount: 0,
            valueDefinitionGroupStart: groupStart,
            valueDefinitionGroupCount: groupCount))
    panic("typed expr value definition: missing appender attack survived")

fn AttackDuplicateConsume() =
    var layer: parser.NormalizedExprLayer
    var ir: texpr.TypedExprIr
    var exactArena: typearena.TypedExprTypeArena
    var groupStart: int32
    var groupCount: int32
    let initializerRoot = BuildRegisteredSingleLeaf(
        layer, ir, exactArena, groupStart, groupCount)
    AppendFixtureNode(ir)
    let producerSourceIndex =
        parser.ParserValueExprNodeProducerSourceIndexAt(
            ir.valueExprTree,
            initializerRoot)
    texpr.TypedExprIrAppendValueDefinitionsForBindingInitializer(
        ir,
        ir.valueExprTree,
        producerSourceIndex,
        0,
        initializerRoot,
        0)
    texpr.TypedExprIrAppendValueDefinitionsForBindingInitializer(
        ir,
        ir.valueExprTree,
        producerSourceIndex,
        0,
        initializerRoot,
        0)
    panic("typed expr value definition: duplicate consume attack survived")

fn AttackCrossFunctionRemap() =
    var layer: parser.NormalizedExprLayer
    var ir: texpr.TypedExprIr
    var exactArena: typearena.TypedExprTypeArena
    BuildSourceBeforeEnd(
        "/work/production.cheng",
        ProductionSource(),
        layer,
        ir,
        exactArena)
    arenamod.ArenaArrayInt32Set(
        ir.arena,
        ir.valueDefinitionGroups_typedFunctionIndexes,
        0,
        1)
    texpr.TypedExprIrEndValueExprBorrow(ir)
    panic("typed expr value definition: cross-function remap survived")

fn AttackCrossRootRemap() =
    var layer: parser.NormalizedExprLayer
    var ir: texpr.TypedExprIr
    var exactArena: typearena.TypedExprTypeArena
    BuildSourceBeforeEnd(
        "/work/production.cheng",
        ProductionSource(),
        layer,
        ir,
        exactArena)
    let otherRoot = arenamod.ArenaArrayInt32Get(
        ir.arena,
        ir.valueDefinitionGroups_initializerRootSourceLocalNodeIndexes,
        1)
    arenamod.ArenaArrayInt32Set(
        ir.arena,
        ir.valueDefinitionGroups_initializerRootSourceLocalNodeIndexes,
        0,
        otherRoot)
    texpr.TypedExprIrEndValueExprBorrow(ir)
    panic("typed expr value definition: cross-root remap survived")

fn main() =
    let attack = cmdline.ReadFlagOrDefault("--attack", "")
    if attack == "compound":
        AttackCompoundPattern()
        return
    if attack == "missing-appender":
        AttackMissingAppender()
        return
    if attack == "duplicate-consume":
        AttackDuplicateConsume()
        return
    if attack == "cross-function":
        AttackCrossFunctionRemap()
        return
    if attack == "cross-root":
        AttackCrossRootRemap()
        return
    AssertPositiveAndDeleteAttack()
    AssertCallInitializerProjectionJoin()
    AssertManagedShareProducerAuthority()
    AssertUppercaseInitializerAuthority()
