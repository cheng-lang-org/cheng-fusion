import std/system as system

type
    TkR1Model =
        n: int64
        tag: str

fn TkR1Join(n: int64, tag: str): str =
    return strings.ConcatStr(strings.Int64ToStr(n), tag)

fn TkR1Report(model: TkR1Model): str =
    return TkR1Join(model.n, model.tag)

fn main(): int32 =
    var m: TkR1Model
    m.n = 7
    m.tag = "-ok"
    os.WriteLine(os.Get_stdout(), TkR1Report(m))
    return 0
