# AD1 negative control `_ad1_scratch_overflow` (ar2 line; design
# .rebuild/ad1_line/ARENA_ROUTING_DESIGN.md §5.4) -- REPLICA form, inlined,
# scalar-only (platform walls recorded in report §6; scalar constructs are
# the subset proven compilable as an executable fixture on this tree).
#
# Pinned here: the AddReserved fail-closed guard predicate (arena.cheng
# :336-351 -- stale generation and exhausted capacity are hard rejections,
# never a heap fallback).  The third add into a 2-slot reservation must be
# REJECTED by the guard: exit 0 = rejected (the bound held); exit 5 = the
# add was admitted (the bound was silently broken); exit 3/4 = the guard
# wrongly rejected a legal add.

fn main(): int32 =
    # Reserved column: capacity 2, generation 1, logical len 0.
    var colCapacity: int32
    colCapacity = 2
    var colGeneration: int32
    colGeneration = 1
    var colLen: int32
    # add #1: passes the guard (generation ok, len < capacity).
    if colGeneration != 1:
        return 3
    if colLen < 0:
        return 3
    if colCapacity <= 0:
        return 3
    if colLen >= colCapacity:
        return 3
    colLen = colLen + 1
    # add #2: passes (len 1 < capacity 2).
    if colGeneration != 1:
        return 4
    if colLen < 0:
        return 4
    if colCapacity <= 0:
        return 4
    if colLen >= colCapacity:
        return 4
    colLen = colLen + 1
    # add #3 must be REJECTED by the capacity-exhausted guard: this is the
    # fail-closed bound the facade inherits (design §3.4, no heap
    # fallback).  A rejecting guard exits 0 (bound held); falling through
    # to `return 5` would mean the add was admitted -- the bound broken.
    if colGeneration != 1:
        return 0
    if colLen < 0:
        return 0
    if colCapacity <= 0:
        return 0
    if colLen >= colCapacity:
        return 0
    return 5
