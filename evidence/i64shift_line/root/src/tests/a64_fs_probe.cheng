module a64_fs_probe

import std/fs
import std/os

fn main(): int32 =
    let mk = fs.Mkdir("/tmp/a64fsprobe.d", 493)
    os.WriteFile("/tmp/a64fsprobe.d/data.txt", "hi")
    if !fs.Exists("/tmp/a64fsprobe.d/data.txt"):
        return 2
    let rm = fs.Remove("/tmp/a64fsprobe.d/data.txt")
    if IsErr(rm):
        return 4
    if fs.Exists("/tmp/a64fsprobe.d/data.txt"):
        return 5
    return 0

main()
