# Environment-parameter tune probe (machine-duck-on-ball, CEM dimension
# scan): the joint channel is exhausted (T2 verdict - the N7 three levers
# and the caseH two-lever scan are declared insufficient), so this probe
# scans the remaining free degrees of freedom, the BALL ENVIRONMENT
# parameters, over the machine duck standing on the real FIBA size-7
# basketball. The engine now exposes all three as module-level
# runtime-settable parameters (physics3d, the M-a Contacts3dBallLoadRead
# module-level channel pattern; defaults bit-identical to the frozen
# engine values):
#   - Crr: the load-aware rolling-resistance coefficient of
#     physics3dBallRollingContact (Physics3dBallRollResistSet, default
#     0.03). Unlike the caseE2 probe-side impulse this is the ENGINE
#     channel: the M-a rider-load report makes excess > 0 exactly while
#     the duck rides the ball, so the lever is live probe-free.
#   - e: the ball-ground restitution (Physics3dBallRestitutionSet,
#     default 0.0 = the engine's historical exactly-inelastic normal
#     channel; e > 0 applies the Newton impact law vz = -e*vz_in at the
#     rolling-contact site).
#   - mu: the ball's own Coulomb clamp budget in
#     physics3dBallRollingContact (Physics3dBallFrictionSet, default
#     0.6 = Contacts3dGroundFriction; the duck's capsule/foot friction
#     channels are NOT scanned - they keep Contacts3dGroundFriction
#     directly, so the grid isolates the ball's environment).
#
# Scene: the exact microduck_ball_probe caseB stack - the L4 15-link/
# 14-hinge-servo assembly (buildDuck, the same construction as
# microduck_assembly_probe), the real ball injected execution-side at
# (0, 0.85, 0.121), and the BallServoRigid torso servo at the frozen
# defaults (API takes the live world + torso/head/ball slots only, so it
# is compatible with the 15-body assembly - proven by caseG2 row 3).
# Servo/balance parameters are NEVER retuned here: the grid varies the
# three environment parameters only.
#
# Grid (degraded protocol, honestly reported): the planned 18-cell
# Crr {0.03, 0.06, 0.10} x e {0.0, 0.3} x mu {0.4, 0.6, 0.9} grid at
# 3000 ticks exceeded every harness wall limit (the standing-duck cells
# solve the full contact set every tick - minutes per cell), so the run
# of record executes the Crr x mu grid (9 cells) at 2000 ticks with e
# fixed at the engine default 0.0. The e axis carries its COMPLETED
# 3000-tick rows from the full-grid runs as supplementary evidence: at
# Crr=0.03 both e=0.0 and e=0.3 survive the whole window (alive=3000)
# with drift 941.664 mm vs 1781.306 mm - e moves the drift, not the
# survival. The (0.03, e=0.0, mu=0.6) cell is the engine-default
# control: its parameters are bit-identical to the frozen engine
# values, so its trajectory is the exact pre-parameterization caseB
# stack on the current tree (the historical 66-tick baseline predates
# the M-a rider-load wiring that made the engine Crr channel live).
#
# Data table per cell: alive ticks (before the first fall - the
# post-topple wreck's head-up oscillation is not survival), fall tick,
# ball drift end/max, rejected steps. Verdict, mechanical on the table:
# any cell alive > 660 (10x the 66-tick baseline) is annotated
# SIGNIFICANT; all cells under it annotate INSENSITIVE - reported
# honestly either way.
#
# SERIAL evaluation discipline (M-b lesson): the three environment
# parameters are plain module vars in physics3d. The grid loop below is
# a single serial main loop - one cell at a time, setters written at
# cell start, no ParallelFor, no concurrent episodes - so there is no
# concurrent writer to the module state. A parallel evaluator over this
# surface would race the setters and is forbidden by contract.
#
# Physics-loop discipline: the tick loops do scalar math only (no str
# construction, no echo, no allocation); the per-cell trace and the
# table are buffered and echoed after the loops.
import std/cmdline
import std/math as m
import std/strings as strings
import cheng/game/world3d
import cheng/game/physics3d
import cheng/game/constraints3d
import cheng/game/csg/joint_motor
import cheng/game/csg/numerics
import cheng/game/csg/ball_servo_rigid as bsr
import cheng/game/csg/microduck_model as mm

const
    # one cell: 2000 ticks. DEGRADED PROTOCOL (honestly reported): the
    # planned 18-cell x 3000-tick grid exceeded every harness wall limit
    # (the standing-duck cells solve the full contact set every tick,
    # minutes per 3000-tick cell), so per the task's load clause this
    # run executes the Crr x mu grid at 2000 ticks; the e axis keeps its
    # completed 3000-tick rows from the full-grid runs (e in {0.0, 0.3}
    # at Crr=0.03: survival at the window cap in all cells, drift
    # 941.664 -> 1781.306 mm) as supplementary evidence.
    CellTicks: int32 = 2000
    CellRecordEvery: int32 = 400
    CellRecordCount: int32 = 5
    # significance bar: 10x the 66-tick caseB baseline fall
    SignificanceBar: int32 = 660
    # real FIBA size-7 basketball (the microduck_ball_probe injection)
    BallCenterX: float64 = 0.0
    BallCenterY: float64 = 0.85
    BallCenterZ: float64 = 0.121
    BallRadiusM: float64 = 0.121
    BallMassKg: float64 = 0.62
    DuckRootZ: float64 = 0.275364117885
    ContactProofM: float64 = 0.005
    AngleNeutralTolRad: float64 = 0.001
    AnchorGapTolM: float64 = 0.001
    # degraded grid shape: 3 Crr x 1 e x 3 mu = 9 cells (e fixed at the
    # engine default 0.0; see the CellTicks note)
    GridCrrN: int32 = 3
    GridEN: int32 = 1
    GridMuN: int32 = 3
    GridCells: int32 = 9

fn fmtMm(x: float64): str =
    let scaled: int32 = int32(m.roundFloat(x * 1000.0))
    var neg: bool = scaled < 0
    var mag: int32 = scaled
    if neg:
        mag = 0 - mag
    let intPart: int32 = mag / 1000
    let fracPart: int32 = mag % 1000
    var outStr: str = ""
    if neg:
        outStr = "-"
    outStr = outStr + strings.IntToStr(intPart) + "." + strings.CloneStrRange(strings.IntToStr(fracPart + 1000), 1, 3)
    return outStr

# Grid value resolvers (if-chains, no const arrays needed).
fn gridCrr(ci: int32): float64 =
    if ci == 0:
        return 0.03
    if ci == 1:
        return 0.06
    return 0.10

fn gridE(ei: int32): float64 =
    if ei == 0:
        return 0.0
    return 0.3

fn gridMu(mi: int32): float64 =
    if mi == 0:
        return 0.4
    if mi == 1:
        return 0.6
    return 0.9

# Park the servo command and goal at the measured standing flexion so tick
# 0 commands no step change; returns the measured angle.
fn parkHingeServo(w: var World3d, ci: int32): float64 =
    let th0 = Constraints3dHingeAngle(w, ci)
    w.conCmd[ci] = th0
    w.conGoal[ci] = th0
    return th0

# One MJCF joint -> one hinge from the model table (the
# microduck_assembly_probe / microduck_ball_probe construction verbatim,
# servoMode kept: 1 = the hinge servo, every case here).
@borrows
fn stanceHinge(w: var World3d, mdl: mm.MicroduckModel, jointIdx: int32, refX: float64, refY: float64, refZ: float64, tauMax: float64, omegaRadS: float64, servoMode: int32): int32 =
    let jt = mdl.joints[jointIdx]
    let pl = mdl.links[jt.parentLink]
    let cl = mdl.links[jt.childLink]
    var anchAx: float64
    var anchAy: float64
    var anchAz: float64
    mm.MicroduckPointToLocal(pl.axisKind, jt.anchorX, jt.anchorY, jt.anchorZ, pl.cx, pl.cy, pl.cz, anchAx, anchAy, anchAz)
    var axisAx: float64
    var axisAy: float64
    var axisAz: float64
    mm.MicroduckVecToLocal(pl.axisKind, jt.axisX, jt.axisY, jt.axisZ, axisAx, axisAy, axisAz)
    var anchBx: float64
    var anchBy: float64
    var anchBz: float64
    mm.MicroduckPointToLocal(cl.axisKind, jt.anchorX, jt.anchorY, jt.anchorZ, cl.cx, cl.cy, cl.cz, anchBx, anchBy, anchBz)
    var axisBx: float64
    var axisBy: float64
    var axisBz: float64
    mm.MicroduckVecToLocal(cl.axisKind, jt.axisX, jt.axisY, jt.axisZ, axisBx, axisBy, axisBz)
    var conKind: int32 = world3d.World3dConHinge
    if servoMode == 1:
        conKind = world3d.World3dConHingeServo
    let ci = World3dAddHingeJoint(w, jt.parentLink, jt.childLink, conKind, anchAx, anchAy, anchAz, anchBx, anchBy, anchBz, axisAx, axisAy, axisAz, axisBx, axisBy, axisBz)
    var refAlX: float64
    var refAlY: float64
    var refAlZ: float64
    mm.MicroduckVecToLocal(pl.axisKind, refX, refY, refZ, refAlX, refAlY, refAlZ)
    var refBlX: float64
    var refBlY: float64
    var refBlZ: float64
    mm.MicroduckVecToLocal(cl.axisKind, refX, refY, refZ, refBlX, refBlY, refBlZ)
    World3dSetHingeRefs(w, ci, refAlX, refAlY, refAlZ, refBlX, refBlY, refBlZ)
    if servoMode == 1:
        World3dSetHingeServo(w, ci, tauMax, omegaRadS, jt.minRad, jt.maxRad)
    else:
        # passive joint: tau/omega columns stay 0 (never read for kind 10);
        # the verbatim MJCF range stays live as the passive flexion limit
        World3dSetHingeServo(w, ci, 0.0, 0.0, jt.minRad, jt.maxRad)
    if Constraints3dJointAnchorGap(w, ci) > AnchorGapTolM:
        panic("env tune: hinge pivot gap at " + jt.name)
    return ci

# The four leg pitch hinge-servo constraint indices (filled by buildDuck).
type
    DuckPitchCons =
        hipL: int32
        hipR: int32
        ankleL: int32
        ankleR: int32

# The M6a/L4 assembly at root pose (rootX, rootY, rootZ) yaw 0: 15 link
# capsules at the balanced stance, 14 hinge servos from the model table
# (five DoF per leg), every servo parked at its measured stance angle.
# Verbatim microduck_ball_probe buildDuck (servoMode collapsed to 1).
fn buildDuck(w: var World3d, rootX: float64, rootY: float64, rootZ: float64, cons: var DuckPitchCons) =
    World3dReset(w, int64(911))
    var mdl: mm.MicroduckModel = mm.MicroduckModelBuild()
    if mdl.links.len != 15:
        panic("env tune: link count")
    if mdl.joints.len != 14:
        panic("env tune: joint count")
    if numerics.CsgAbs(mdl.totalMass - 0.7443611) > 0.000000001:
        panic("env tune: total mass off the MJCF sum")
    var i: int32 = 0
    while i < mdl.links.len:
        let sp = mm.MicroduckLinkSpawnCapsuleStance(mdl, i, rootX, rootY, rootZ, 0.0)
        let slot = World3dSpawnCapsule(w, sp.px, sp.py, sp.pz, sp.mass, sp.radius, sp.halfLen, sp.qw, sp.qx, sp.qy, sp.qz)
        if slot != i:
            panic("env tune: link slot mismatch")
        i = i + 1
    let omegaRadS = mm.MicroduckServoMaxRateDegS * joint_motor.JointMotorRadPerDeg
    let tauHip = mm.MicroduckTauMaxHipNm
    let tauKnee = mm.MicroduckTauMaxKneeNm
    let tauAnkle = mm.MicroduckTauMaxAnkleNm
    let tauNeck = mm.MicroduckTauMaxNeckNm
    let ciHipYawL = stanceHinge(w, mdl, mm.MicroduckJointHipYawL, 0.0, 1.0, 0.0, tauHip, omegaRadS, 1)
    let ciHipRollL = stanceHinge(w, mdl, mm.MicroduckJointHipRollL, 0.0, 0.0, 0.0 - 1.0, tauHip, omegaRadS, 1)
    let ciHipPitchL = stanceHinge(w, mdl, mm.MicroduckJointHipPitchL, 0.0, 0.0, 0.0 - 1.0, tauHip, omegaRadS, 1)
    let ciKneeL = stanceHinge(w, mdl, mm.MicroduckJointKneeL, 0.0, 0.0, 0.0 - 1.0, tauKnee, omegaRadS, 1)
    let ciAnkleL = stanceHinge(w, mdl, mm.MicroduckJointAnklePitchL, 0.0, 0.0, 0.0 - 1.0, tauAnkle, omegaRadS, 1)
    let ciHipYawR = stanceHinge(w, mdl, mm.MicroduckJointHipYawR, 0.0, 1.0, 0.0, tauHip, omegaRadS, 1)
    let ciHipRollR = stanceHinge(w, mdl, mm.MicroduckJointHipRollR, 0.0, 0.0, 0.0 - 1.0, tauHip, omegaRadS, 1)
    let ciHipPitchR = stanceHinge(w, mdl, mm.MicroduckJointHipPitchR, 0.0, 0.0, 0.0 - 1.0, tauHip, omegaRadS, 1)
    let ciKneeR = stanceHinge(w, mdl, mm.MicroduckJointKneeR, 0.0, 0.0, 0.0 - 1.0, tauKnee, omegaRadS, 1)
    let ciAnkleR = stanceHinge(w, mdl, mm.MicroduckJointAnklePitchR, 0.0, 0.0, 0.0 - 1.0, tauAnkle, omegaRadS, 1)
    let ciNeck = stanceHinge(w, mdl, mm.MicroduckJointNeckPitch, 0.0, 0.0, 1.0, tauNeck, omegaRadS, 1)
    let ciHeadPitch = stanceHinge(w, mdl, mm.MicroduckJointHeadPitch, 0.0, 0.0, 1.0, tauNeck, omegaRadS, 1)
    let ciHeadYaw = stanceHinge(w, mdl, mm.MicroduckJointHeadYaw, 0.0, 1.0, 0.0, tauNeck, omegaRadS, 1)
    let ciHeadRoll = stanceHinge(w, mdl, mm.MicroduckJointHeadRoll, 0.0, 0.0, 1.0, tauNeck, omegaRadS, 1)
    let th = mm.MicroduckStanceHipRad
    parkHingeServo(w, ciHipPitchL)
    parkHingeServo(w, ciHipPitchR)
    parkHingeServo(w, ciKneeL)
    parkHingeServo(w, ciKneeR)
    parkHingeServo(w, ciAnkleL)
    parkHingeServo(w, ciAnkleR)
    parkHingeServo(w, ciNeck)
    parkHingeServo(w, ciHeadPitch)
    parkHingeServo(w, ciHeadYaw)
    parkHingeServo(w, ciHeadRoll)
    parkHingeServo(w, ciHipYawL)
    parkHingeServo(w, ciHipYawR)
    parkHingeServo(w, ciHipRollL)
    parkHingeServo(w, ciHipRollR)
    let thHipL = Constraints3dHingeAngle(w, ciHipPitchL)
    let thHipR = Constraints3dHingeAngle(w, ciHipPitchR)
    let thAnkleL = Constraints3dHingeAngle(w, ciAnkleL)
    let thAnkleR = Constraints3dHingeAngle(w, ciAnkleR)
    let thKneeL = Constraints3dHingeAngle(w, ciKneeL)
    let thKneeR = Constraints3dHingeAngle(w, ciKneeR)
    let thNeck = Constraints3dHingeAngle(w, ciNeck)
    cons.hipL = ciHipPitchL
    cons.hipR = ciHipPitchR
    cons.ankleL = ciAnkleL
    cons.ankleR = ciAnkleR
    if numerics.CsgAbs(thHipL - th) > AngleNeutralTolRad:
        panic("env tune: hip pitch L th0 off the stance")
    if numerics.CsgAbs(thHipR + th) > AngleNeutralTolRad:
        panic("env tune: hip pitch R th0 off the stance")
    if numerics.CsgAbs(thAnkleL + th) > AngleNeutralTolRad:
        panic("env tune: ankle L th0 off the stance")
    if numerics.CsgAbs(thAnkleR - th) > AngleNeutralTolRad:
        panic("env tune: ankle R th0 off the stance")
    if numerics.CsgAbs(thKneeL) > AngleNeutralTolRad:
        panic("env tune: knee L th0 not neutral")
    if numerics.CsgAbs(thKneeR) > AngleNeutralTolRad:
        panic("env tune: knee R th0 not neutral")
    if numerics.CsgAbs(thNeck) > AngleNeutralTolRad:
        panic("env tune: neck th0 not neutral")

# One grid-cell result: the data-table row. fallTick convention:
# -2 hard-contract failure, -1 stood the full window, >= 0 fell at that
# tick.
type
    EnvRow =
        crr: float64
        e: float64
        mu: float64
        fallTick: int32
        aliveTicks: int32
        rejected: int32
        firstRejectTick: int32
        driftEndM: float64
        driftMaxM: float64

# One grid cell: the caseB stack (assembly + ball injection + frozen
# BallServoRigid torso servo) run under one (Crr, e, mu) environment
# point. The three setters are written HERE, at cell start, and the
# caller runs cells strictly one at a time (serial main loop, M-b
# discipline: module-level state + parallel evaluation would race).
# Hard contracts: zero rejected steps, world validity, proven foot-ball
# contact (ball drift > ContactProofM). Survival and drift are REPORTED
# AS DATA. The physics loop is scalar only; the trace is buffered and
# echoed after the loop.
fn runEnvCell(rowOut: var EnvRow, tag: str, crr: float64, e: float64, mu: float64) =
    physics3d.Physics3dBallRollResistSet(crr)
    physics3d.Physics3dBallRestitutionSet(e)
    physics3d.Physics3dBallFrictionSet(mu)
    var w: world3d.World3d
    var cons: DuckPitchCons
    buildDuck(w, BallCenterX, BallCenterY, DuckRootZ, cons)
    if w.count != 15:
        echo("FAIL envcell assembly body count tag=" + tag)
        rowOut.fallTick = 0 - 2
        return
    if w.conCount != 14:
        echo("FAIL envcell assembly constraint count tag=" + tag)
        rowOut.fallTick = 0 - 2
        return
    let ballSlot = World3dSpawnBody(w, BallCenterX, BallCenterY, BallCenterZ, BallMassKg, BallRadiusM, world3d.World3dBodyBallRigid)
    let torsoSlot: int32 = mm.MicroduckLinkTorso
    let headSlot: int32 = mm.MicroduckLinkHead
    let ballX0: float64 = w.bodyPx[ballSlot]
    let ballY0: float64 = w.bodyPy[ballSlot]
    var st: bsr.BallServoRigidState
    bsr.BallServoRigidStateInit(st, w, ballSlot, torsoSlot, headSlot,
        bsr.BallServoRigidDefaultK, bsr.BallServoRigidDefaultC,
        bsr.BallServoRigidDefaultLinCapMps, bsr.BallServoRigidDefaultLinDampCapMps,
        bsr.BallServoRigidDefaultKAng, bsr.BallServoRigidDefaultCAng,
        bsr.BallServoRigidDefaultAngCapRadS, bsr.BallServoRigidDefaultAngDampCapRadS,
        bsr.BallServoRigidDefaultRampTicks)
    echo("envcellcfg tag=" + tag + " crr=" + fmtMm(crr) + " e=" + fmtMm(e) + " mu=" + fmtMm(mu) + " ticks=" + strings.IntToStr(CellTicks) + " (caseB stack, servo frozen; only the environment varies)")
    # buffered trace (500-tick granularity, echoed after the loop)
    var recTick: int32[]
    var recAlive: int32[]
    var recBallZ: float64[]
    var recDrift: float64[]
    setLen(recTick, CellRecordCount)
    setLen(recAlive, CellRecordCount)
    setLen(recBallZ, CellRecordCount)
    setLen(recDrift, CellRecordCount)
    var rejected: int32
    var firstRejectTick: int32
    var fallTick: int32
    var aliveTicks: int32
    var driftMax: float64
    var ti: int32
    var i: int32
    rejected = 0
    firstRejectTick = 0 - 1
    fallTick = 0 - 1
    aliveTicks = 0
    driftMax = 0.0
    ti = 0
    i = 0
    while i < CellTicks:
        bsr.BallServoRigidTick(st, w)
        var r = physics3d.Physics3dStep(w, "probe:envtune")
        if r.statusCode != physics3d.Physics3dStatusOk:
            if firstRejectTick < 0:
                firstRejectTick = i
            rejected = rejected + 1
        let dx = w.bodyPx[ballSlot] - ballX0
        let dy = w.bodyPy[ballSlot] - ballY0
        let drift = numerics.CsgSqrt(dx * dx + dy * dy)
        if drift > driftMax:
            driftMax = drift
        var alive: int32 = 1
        if w.bodyPz[headSlot] < w.bodyPz[torsoSlot]:
            alive = 0
            if fallTick < 0:
                fallTick = i
        # survival: ticks BEFORE the first fall only (the post-topple
        # wreck's head-up oscillation is not survival)
        if fallTick < 0:
            aliveTicks = aliveTicks + 1
        if i % CellRecordEvery == 0:
            if ti < CellRecordCount:
                recTick[ti] = i
                recAlive[ti] = alive
                recBallZ[ti] = w.bodyPz[ballSlot]
                recDrift[ti] = drift
                ti = ti + 1
        i = i + 1
    # buffered trace out (physics loop is done)
    var k: int32
    k = 0
    while k < ti:
        echo("envtrace tag=" + tag + " t=" + strings.IntToStr(recTick[k]) + " alive=" + strings.IntToStr(recAlive[k]) + " ballZ_mm=" + fmtMm(recBallZ[k] * 1000.0) + " ballDrift_mm=" + fmtMm(recDrift[k] * 1000.0))
        k = k + 1
    let edx = w.bodyPx[ballSlot] - ballX0
    let edy = w.bodyPy[ballSlot] - ballY0
    let driftEnd = numerics.CsgSqrt(edx * edx + edy * edy)
    rowOut.crr = crr
    rowOut.e = e
    rowOut.mu = mu
    rowOut.fallTick = fallTick
    rowOut.aliveTicks = aliveTicks
    rowOut.rejected = rejected
    rowOut.firstRejectTick = firstRejectTick
    rowOut.driftEndM = driftEnd
    rowOut.driftMaxM = driftMax
    echo("envrow tag=" + tag + " crr=" + fmtMm(crr) + " e=" + fmtMm(e) + " mu=" + fmtMm(mu) + " fall_tick=" + strings.IntToStr(fallTick) + " alive_ticks=" + strings.IntToStr(aliveTicks) + " driftEnd_mm=" + fmtMm(driftEnd * 1000.0) + " ballDrift_max_mm=" + fmtMm(driftMax * 1000.0) + " rejected=" + strings.IntToStr(rejected) + " firstRejectTick=" + strings.IntToStr(firstRejectTick))
    if !World3dValid(w):
        echo("FAIL envcell world validity tag=" + tag)
        rowOut.fallTick = 0 - 2
        return
    if rejected != 0:
        echo("FAIL envcell rejected steps at " + strings.IntToStr(firstRejectTick) + " tag=" + tag)
        rowOut.fallTick = 0 - 2
        return
    if driftMax <= ContactProofM:
        echo("FAIL envcell no foot-ball contact tag=" + tag + " (drift_mm=" + fmtMm(driftMax * 1000.0) + ")")
        rowOut.fallTick = 0 - 2
        return

fn main(): int32 =
    # SERIAL grid evaluation (M-b discipline): one cell at a time in this
    # single main loop; the physics3d module-level environment parameters
    # are rewritten at each cell's start and read only inside it.
    #
    # Optional wall-limit split: argv[1] "c<N>" starts the scan at cell N
    # (a chunk run prints its envrow lines only and returns; cells are
    # independent - each rebuilds its own world from the fixed reset seed
    # under its own setter values - so chunked rows are trajectory-
    # identical to the same cell in the plain run). The plain no-arg
    # acceptance run scans every cell and emits the table + verdict +
    # PASS tail line.
    var startCell: int32 = 0
    if cmdline.paramCount() >= 1:
        var sc: int32
        sc = 0
        while sc < GridCells:
            if cmdline.paramStr(1) == "c" + strings.IntToStr(sc):
                startCell = sc
            sc = sc + 1
    var aliveArr: int32[]
    var fallArr: int32[]
    var rejArr: int32[]
    var driftEndArr: float64[]
    var driftMaxArr: float64[]
    setLen(aliveArr, GridCells)
    setLen(fallArr, GridCells)
    setLen(rejArr, GridCells)
    setLen(driftEndArr, GridCells)
    setLen(driftMaxArr, GridCells)
    var k: int32
    k = startCell
    while k < GridCells:
        let kc: int32 = k / (GridEN * GridMuN)
        let kr: int32 = k % (GridEN * GridMuN)
        let ke: int32 = kr / GridMuN
        let km: int32 = kr % GridMuN
        var row: EnvRow
        var tag: str = "cell" + strings.IntToStr(k)
        runEnvCell(row, tag, gridCrr(kc), gridE(ke), gridMu(km))
        if row.fallTick == 0 - 2:
            echo("FAIL env tune hard contract (assembly/validity/rejects/contact above)")
            return 1
        aliveArr[k] = row.aliveTicks
        fallArr[k] = row.fallTick
        rejArr[k] = row.rejected
        driftEndArr[k] = row.driftEndM
        driftMaxArr[k] = row.driftMaxM
        k = k + 1
    if startCell > 0:
        echo("envtune chunk run started at cell " + strings.IntToStr(startCell) + " (rows only; the plain no-arg run carries the table + verdict + PASS line)")
        return 0
    # data table (all 18 cells) + significance verdict, mechanical on the
    # table: any cell alive > 660 (10x the 66-tick baseline) = SIGNIFICANT
    var k: int32
    k = 0
    while k < GridCells:
        let kc: int32 = k / (GridEN * GridMuN)
        let kr: int32 = k % (GridEN * GridMuN)
        let ke: int32 = kr / GridMuN
        let km: int32 = kr % GridMuN
        echo("envtable k=" + strings.IntToStr(k) + " crr=" + fmtMm(gridCrr(kc)) + " e=" + fmtMm(gridE(ke)) + " mu=" + fmtMm(gridMu(km)) + " alive=" + strings.IntToStr(aliveArr[k]) + " fall_tick=" + strings.IntToStr(fallArr[k]) + " driftEnd_mm=" + fmtMm(driftEndArr[k] * 1000.0) + " ballDrift_max_mm=" + fmtMm(driftMaxArr[k] * 1000.0) + " rejected=" + strings.IntToStr(rejArr[k]))
        k = k + 1
    # best cell: max alive, tie: min max-drift, tie: grid order
    var bestIdx: int32 = 0
    var bestAlive: int32 = aliveArr[0]
    var bestDrift: float64 = driftMaxArr[0]
    k = 1
    while k < GridCells:
        if aliveArr[k] > bestAlive:
            bestAlive = aliveArr[k]
            bestDrift = driftMaxArr[k]
            bestIdx = k
        else:
            if aliveArr[k] == bestAlive:
                if driftMaxArr[k] < bestDrift:
                    bestDrift = driftMaxArr[k]
                    bestIdx = k
        k = k + 1
    let bc: int32 = bestIdx / (GridEN * GridMuN)
    let br: int32 = bestIdx % (GridEN * GridMuN)
    let be: int32 = br / GridMuN
    let bm: int32 = br % GridMuN
    var verdict: str = "INSENSITIVE"
    if bestAlive > SignificanceBar:
        verdict = "SIGNIFICANT"
    echo("envtune verdict=" + verdict + " best_alive=" + strings.IntToStr(bestAlive) + " bar=" + strings.IntToStr(SignificanceBar) + " baseline_66x10 baseline_cell=k0_crr0.030_e0.000_mu0.600 (engine-default control; servo frozen, only the environment varies)")
    echo("PASS env tune probe (best alive=" + strings.IntToStr(bestAlive) + " cfg=" + fmtMm(gridCrr(bc)) + "/" + fmtMm(gridE(be)) + "/" + fmtMm(gridMu(bm)) + ")")
    return 0
