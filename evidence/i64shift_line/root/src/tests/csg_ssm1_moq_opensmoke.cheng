# CSG SSM1 -> MoQ 段流秒开冒烟 (opensmoke)。
#
# 验证「秒开」数据面: SSM1 manifest + 首关键帧 chunk 经 cheng libp2p MoQ 段流
# 取回即渲染就绪。一条 localhost 真 QUIC 连接 (dial+accept), 两条独立 stream
# (stream4=manifest 段, stream8=首关键帧 chunk 段, 同一 dialed session 共享
# pipeIdx)。服务侧注册两个段: manifest 段 = SSM1 manifest 字节 (纯头 484B,
# audioRef 即 EOF, v1 冻结合同); chunk 段 = 载荷 blob 内 manifest 声明的
# 首关键帧 range。服务循环 = ServerReadRequest + ServerWriteRequestedRange
# (等价 HandleRequestedRange; 该包装在当前编译器下触发 plain-copy 拒绝)。
# 客户侧顺序: 取 manifest 段 -> StreamManifestParse 解析 -> 定位首关键帧 ->
# 取 chunk 段, 逐段计时; 断言取回字节与源/独立重算期望逐字节一致。
# 托管值契约: 跨模块 MultiAddress 字段先 QuicCloneMultiAddress 中转; 托管
# Bytes 累积只经 var 形参 (bytesAppend) 填充; range 对比用 OpenSmokeRangeMatches
# (BytesSliceView 借用视图不可绑定局部)。
import std/result
import std/rawbytes
import std/monotimes
import cheng/quic/connection
import cheng/quic/multiaddress
import cheng/quic/msquicruntime
import cheng/quic/msquictransport_native
import cheng/libp2p/transports/quic_transport
import cheng/libp2p/protocols/media/moq_segment_stream
import cheng/game/assets/stream/manifest
import cheng/game/assets/stream/opensmoke

fn OsmDrainAll(reader: var moq_segment_stream.Libp2pMoqSegmentStreamReader,
               maxChunkBytes: int32): Result[rawbytes.Bytes] =
    var out = rawbytes.EmptyBytes()
    while !reader.closed:
        let readRes = moq_segment_stream.Libp2pMoqSegmentStreamRead(reader, maxChunkBytes)
        if IsErr(readRes):
            return Err[rawbytes.Bytes](ErrorText(readRes))
        let chunk = Value(readRes)
        if rawbytes.BytesLen(chunk) <= 0:
            return Ok[rawbytes.Bytes](out)
        connection.bytesAppend(out, chunk)
    return Ok[rawbytes.Bytes](out)

fn main(): int32 =
    # === 夹具: manifest 字节 (服务侧注册的 manifest 段源) + 载荷 blob ===
    var manifestBytes = opensmoke.OpenSmokeBuildManifestBytes()
    defer:
        rawbytes.BytesFree(manifestBytes)
    var blob = opensmoke.OpenSmokeBuildPayloadBlob()
    defer:
        rawbytes.BytesFree(blob)
    let manifestLen = opensmoke.OpenSmokeManifestLen()
    let blobLen = opensmoke.OpenSmokeBlobLen()
    let kfLen = opensmoke.OpenSmokeChunkPayloadLen(0)
    let kfOffset = opensmoke.OpenSmokeChunkPayloadOffset(0)
    assert(rawbytes.BytesLen(manifestBytes) == manifestLen, "manifest byte len")
    assert(rawbytes.BytesLen(blob) == blobLen, "blob byte len")
    echo(Fmt"SSM1 opensmoke fixture: chunks=4 manifest={manifestLen}B blob={blobLen}B kfChunk0=[{kfOffset},{kfLen})")

    # 服务侧注册前置自检: manifest 字节必须过 B 线解析 + 首关键帧定位。
    var srcManifest: manifest.StreamManifest
    assert(manifest.StreamManifestParse(manifestBytes, srcManifest),
        "source manifest parses")
    assert(manifest.StreamManifestChunkCount(srcManifest) == 4, "source chunk count")
    assert(manifest.StreamManifestTotalDurationMs(srcManifest) == int64(400),
        "source total duration")
    var srcKf: manifest.StreamChunk
    assert(opensmoke.OpenSmokeLocateFirstKeyframe(srcManifest, srcKf),
        "source first keyframe locates")
    assert(srcKf.index == 0 && srcKf.isKeyframe, "source first keyframe is chunk0")
    assert(srcKf.payloadOffset == int64(kfOffset), "source kf payload offset")
    assert(srcKf.payloadLen == int64(kfLen), "source kf payload len")
    echo("PASS server-side registration self-check (parse + locate)")

    # === 连接搭建: localhost 真 QUIC dial/accept + 两条 stream ===
    # native runtime 缺陷 (只读绕开, 不改源码): app-stream 二级表按全局 CurSlot
    # 索引, dial/accept conn token 恒指槽 0 而 pump 分发写在 pump 槽, 读端直接
    # 用 derive token 会读到空表 (pipe read timeout)。修复式接线: 每方向读前用
    # OpenSmokeWaitReadable 扫描定位数据槽, 经 ConnFromPipeIdx 构造读端 conn。
    var tConnStart = monotimes.GetMonoTime()

    var settings = msquicruntime.initMsQuicSettings()
    settings.allowDatagram = true

    var listener = msquictransport_native.InitMsQuicTransport()
    assert(IsOk(msquictransport_native.setMsQuicTransportSettings(listener, settings)),
        "listener settings")
    assert(IsOk(quic_transport.Libp2pQuicConfigureTls(listener)), "listener tls")
    let listenAddrRes = quic_transport.Libp2pQuicAddrFromHostPort("127.0.0.1", 0)
    assert(IsOk(listenAddrRes), "listen addr")
    msquictransport_native.start(listener, Value(listenAddrRes))

    var client = msquictransport_native.InitMsQuicTransport()
    assert(IsOk(msquictransport_native.setMsQuicTransportSettings(client, settings)),
        "client settings")
    assert(IsOk(quic_transport.Libp2pQuicConfigureTls(client)), "client tls")
    var dialAddr = multiaddress.QuicCloneMultiAddress(listener.listenAddr)
    let dialRes = msquictransport_native.dial(client, dialAddr)
    assert(IsOk(dialRes), "dial")
    var clientLegacy = Value(dialRes)
    let acceptRes = msquictransport_native.accept(listener)
    assert(IsOk(acceptRes), "accept")
    var serverLegacy = Value(acceptRes)

    # stream4 = manifest 段 (client 写端 + server 读端按扫描槽构造)。
    var streamClient4 = connection.ConnDeriveStream(clientLegacy, 4, 4)
    assert(IsOk(moq_segment_stream.Libp2pMoqSegmentStreamClientSendNegotiate(client,
        streamClient4)), "manifest negotiate send")
    let ks4 = opensmoke.OpenSmokeWaitReadable(1, 4, 45, 300)
    assert(ks4 >= 0, "server stream4 data slot not found")
    var streamServer4 = connection.ConnFromPipeIdx(1000001 + ks4, 1, 4, 4)
    assert(IsOk(moq_segment_stream.Libp2pMoqSegmentStreamServerNegotiate(listener,
        streamServer4)), "manifest negotiate server")
    let kc4 = opensmoke.OpenSmokeWaitReadable(0, 4, 45, 300)
    assert(kc4 >= 0, "client stream4 ack slot not found")
    var clientReader4 = connection.ConnFromPipeIdx(1000001 + kc4, 0, 4, 4)
    assert(IsOk(moq_segment_stream.Libp2pMoqSegmentStreamClientReadNegotiateAck(client,
        clientReader4)), "manifest negotiate ack")

    # stream8 = 首关键帧 chunk 段, 同一 dialed session 派生。
    var streamClient8 = connection.ConnDeriveStream(clientLegacy, 8, 8)
    assert(IsOk(moq_segment_stream.Libp2pMoqSegmentStreamClientSendNegotiate(client,
        streamClient8)), "chunk negotiate send")
    let ks8 = opensmoke.OpenSmokeWaitReadable(1, 8, 45, 300)
    assert(ks8 >= 0, "server stream8 data slot not found")
    var streamServer8 = connection.ConnFromPipeIdx(1000001 + ks8, 1, 8, 8)
    assert(IsOk(moq_segment_stream.Libp2pMoqSegmentStreamServerNegotiate(listener,
        streamServer8)), "chunk negotiate server")
    let kc8 = opensmoke.OpenSmokeWaitReadable(0, 8, 45, 300)
    assert(kc8 >= 0, "client stream8 ack slot not found")
    var clientReader8 = connection.ConnFromPipeIdx(1000001 + kc8, 0, 8, 8)
    assert(IsOk(moq_segment_stream.Libp2pMoqSegmentStreamClientReadNegotiateAck(client,
        clientReader8)), "chunk negotiate ack")

    var tReady = monotimes.GetMonoTime()

    # === 段 1: manifest 段 (stream4, [0, manifestLen)) ===
    var manifestReq: moq_segment_stream.Libp2pMoqSegmentStreamRequest
    manifestReq.streamId = "ssm1-opensmoke"
    manifestReq.segmentKey = "ssm1-manifest"
    manifestReq.offsetBytes = 0
    manifestReq.lengthBytes = manifestLen
    manifestReq.readChunkBytes = 64

    var tManifestStart = monotimes.GetMonoTime()
    var manifestReader: moq_segment_stream.Libp2pMoqSegmentStreamReader
    assert(IsOk(moq_segment_stream.Libp2pMoqSegmentStreamClientOpen(manifestReader,
        clientReader4, manifestReq)), "manifest client open")
    let manifestGotReq = moq_segment_stream.Libp2pMoqSegmentStreamServerReadRequest(
        streamServer4)
    assert(IsOk(manifestGotReq), "manifest server read req")
    var manifestServed = Value(manifestGotReq)
    assert(manifestServed.segmentKey == manifestReq.segmentKey, "served manifest key")
    assert(manifestServed.offsetBytes == 0, "served manifest offset")
    assert(manifestServed.lengthBytes == manifestLen, "served manifest length")
    assert(IsOk(moq_segment_stream.Libp2pMoqSegmentStreamServerWriteRequestedRange(
        streamServer4, manifestBytes, manifestServed)), "manifest server write")
    let manifestGotRes = OsmDrainAll(manifestReader, 64)
    assert(IsOk(manifestGotRes), "manifest drain")
    var manifestSeg = Value(manifestGotRes)
    var tManifestDone = monotimes.GetMonoTime()
    assert(opensmoke.OpenSmokeBytesEq(manifestSeg, manifestBytes),
        "manifest segment bytes equal source")
    echo("PASS manifest segment fetched byte-exact")

    # === B 线解析 + 首关键帧定位 (对取回的 manifest 段) ===
    var fetchedManifest: manifest.StreamManifest
    assert(manifest.StreamManifestParse(manifestSeg, fetchedManifest),
        "fetched manifest parses")
    assert(manifest.StreamManifestChunkCount(fetchedManifest) == 4,
        "fetched chunk count")
    var kf: manifest.StreamChunk
    assert(opensmoke.OpenSmokeLocateFirstKeyframe(fetchedManifest, kf),
        "fetched manifest locates first keyframe")
    assert(kf.index == 0 && kf.isKeyframe, "first keyframe is chunk0")
    assert(kf.payloadOffset == int64(kfOffset), "kf payload offset from fetch")
    assert(kf.payloadLen == int64(kfLen), "kf payload len from fetch")
    var tParseDone = monotimes.GetMonoTime()
    echo("PASS B-line parse + first keyframe locate on fetched manifest")

    # === 段 2: 首关键帧 chunk 段 (stream8, manifest 声明的 blob range) ===
    var chunkReq: moq_segment_stream.Libp2pMoqSegmentStreamRequest
    chunkReq.streamId = "ssm1-opensmoke"
    chunkReq.segmentKey = "ssm1-keyframe-chunk0"
    chunkReq.offsetBytes = int32(kf.payloadOffset)
    chunkReq.lengthBytes = int32(kf.payloadLen)
    chunkReq.readChunkBytes = 32

    var tChunkStart = monotimes.GetMonoTime()
    var chunkReader: moq_segment_stream.Libp2pMoqSegmentStreamReader
    assert(IsOk(moq_segment_stream.Libp2pMoqSegmentStreamClientOpen(chunkReader,
        clientReader8, chunkReq)), "chunk client open")
    let chunkGotReq = moq_segment_stream.Libp2pMoqSegmentStreamServerReadRequest(
        streamServer8)
    assert(IsOk(chunkGotReq), "chunk server read req")
    var chunkServed = Value(chunkGotReq)
    assert(chunkServed.segmentKey == chunkReq.segmentKey, "served chunk key")
    assert(chunkServed.offsetBytes == int32(kf.payloadOffset), "served chunk offset")
    assert(chunkServed.lengthBytes == int32(kf.payloadLen), "served chunk length")
    assert(IsOk(moq_segment_stream.Libp2pMoqSegmentStreamServerWriteRequestedRange(
        streamServer8, blob, chunkServed)), "chunk server write")
    let chunkGotRes = OsmDrainAll(chunkReader, 32)
    assert(IsOk(chunkGotRes), "chunk drain")
    var chunkSeg = Value(chunkGotRes)
    var tChunkDone = monotimes.GetMonoTime()

    # 断言 1: 与独立重算的期望 payload 逐字节一致 (不依赖服务端源)。
    var expectKf = opensmoke.OpenSmokeExpectChunkPayload(0)
    defer:
        rawbytes.BytesFree(expectKf)
    assert(opensmoke.OpenSmokeBytesEq(chunkSeg, expectKf),
        "keyframe chunk bytes equal recomputed expectation")
    # 断言 2: 服务端 serve 的正是 blob 内 manifest 声明的 range (容器身份自洽)。
    assert(opensmoke.OpenSmokeRangeMatches(blob, int32(kf.payloadOffset), chunkSeg),
        "keyframe chunk bytes equal manifest-declared blob range")
    echo("PASS keyframe chunk segment fetched byte-exact (expectation + declared range)")

    # === 时间线 ===
    let connectReadyNs = monotimes.MonoTimeNs(tReady) - monotimes.MonoTimeNs(tConnStart)
    let manifestNs = monotimes.MonoTimeNs(tManifestDone) - monotimes.MonoTimeNs(tManifestStart)
    let parseNs = monotimes.MonoTimeNs(tParseDone) - monotimes.MonoTimeNs(tManifestDone)
    let chunkNs = monotimes.MonoTimeNs(tChunkDone) - monotimes.MonoTimeNs(tChunkStart)
    let totalNs = monotimes.MonoTimeNs(tChunkDone) - monotimes.MonoTimeNs(tConnStart)
    let afterReadyNs = monotimes.MonoTimeNs(tChunkDone) - monotimes.MonoTimeNs(tReady)
    let chunkBytesReq = chunkReq.lengthBytes
    echo("SSM1 MoQ opensmoke timeline:")
    echo(Fmt"  t0 connect ready (dial+accept+negotiate x2): {connectReadyNs} ns")
    echo(Fmt"  manifest segment ({manifestLen} bytes): {manifestNs} ns")
    echo(Fmt"  parse + locate first keyframe: {parseNs} ns")
    echo(Fmt"  keyframe chunk segment ({chunkBytesReq} bytes): {chunkNs} ns")
    echo(Fmt"  total connect->first-frame ready: {totalNs} ns")
    echo(Fmt"  ready->first-frame ready: {afterReadyNs} ns")

    # teardown: 每 stream handle 共享 pipeIdx, 只关 dialed 连接与 listener。
    connection.ConnClose(serverLegacy)
    connection.ConnClose(clientLegacy)
    msquictransport_native.Stop(listener)
    echo("csg_ssm1_moq_opensmoke ALL PASS")
    return 0
