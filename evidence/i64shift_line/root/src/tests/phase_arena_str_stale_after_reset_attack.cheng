import cheng/core/ir/phase_arena as phase

# Attack: a text row handled before the batch reset is generation-stale.
# Comparing through the stale row after the reset must hard-fail instead of
# reading reclaimed payload bytes.
fn main(): int32 =
    var store: phase.PhaseArenaStore
    phase.PhaseArenaStoreInit(store, 1, 64, 4)
    var arena = phase.PhaseArenaStoreOpenArena(store, 1, 64, 4)
    let text = phase.PhaseArenaStoreStrPut(store, arena, "dangling")
    phase.PhaseArenaStoreResetArena(store, arena)
    if phase.PhaseArenaStoreStrEqual(store, arena, text, "dangling"):
        return 0
    return 1
