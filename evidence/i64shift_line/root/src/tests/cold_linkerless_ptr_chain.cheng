module cold_linkerless_ptr_chain

fn readRef(v: var int32): int32 =
    return v

fn writeRef(v: var int32, val: int32): int32 =
    v = val
    return 0

fn chainRead(inner: var int32): int32 =
    return readRef(inner)

fn chainWrite(inner: var int32, val: int32): int32 =
    let _ = writeRef(inner, val)
    return 0

fn swapRefs(a: var int32, b: var int32): int32 =
    let tmp = readRef(a)
    a = b
    b = tmp
    return 0

fn test_direct(): int32 =
    var x: int32 = 42
    let v = readRef(x)
    if v != 42:
        return 1
    return 0

fn test_write(): int32 =
    var x: int32 = 7
    let _ = writeRef(x, 99)
    if x != 99:
        return 1
    return 0

fn test_chain_read(): int32 =
    var x: int32 = 123
    let v = chainRead(x)
    if v != 123:
        return 1
    return 0

fn test_chain_write(): int32 =
    var x: int32
    let _ = chainWrite(x, 77)
    if x != 77:
        return 1
    return 0

fn test_swap(): int32 =
    var a: int32 = 10
    var b: int32 = 20
    let _ = swapRefs(a, b)
    if a != 20:
        return 1
    if b != 10:
        return 2
    return 0

fn test_triple_swap(): int32 =
    var a: int32 = 1
    var b: int32 = 2
    var c: int32 = 3
    let _ = tripleSwap(a, b, c)
    if a != 1:
        return 1
    if b != 2:
        return 2
    if c != 3:
        return 3
    return 0

fn main(): int32 =
    let r1 = test_direct()
    if r1 != 0:
        return r1
    let r2 = test_write()
    if r2 != 0:
        return 10 + r2
    let r3 = test_chain_read()
    if r3 != 0:
        return 20 + r3
    let r4 = test_chain_write()
    if r4 != 0:
        return 30 + r4
    let r5 = test_swap()
    if r5 != 0:
        return 40 + r5
    return 0

main()
