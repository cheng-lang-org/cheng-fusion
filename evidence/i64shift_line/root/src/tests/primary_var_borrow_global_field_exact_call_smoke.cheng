import std/strutils as strutil
import cheng/tests/primary_exact_call_authority_support as support

type Box =
    title: str
    nums: int32[]

type Cell =
    code: int32

var gTitle: str
var gNums: int32[]
var gSupportCell: support.Cell

fn setCell(cell: var int32, value: int32) =
    cell = value

fn record(box: var Box, holder: var support.Holder) =
    gTitle = box.title
    gNums = box.nums
    gSupportCell = holder.Value

fn main(): int32 =
    var cell: int32
    setCell(cell, 7)
    if cell != 7:
        return 1

    var box: Box
    box.title = "field-text"
    add(box.nums, 11)
    add(box.nums, 22)
    var holder: support.Holder
    holder.Value.Text = "owner-exact"
    var localCell: Cell
    localCell.code = 9
    record(box, holder)
    if gTitle != "field-text":
        return 2
    if gNums.len != 2 || gNums[0] != 11 || gNums[1] != 22:
        return 3
    if gSupportCell.Text != "owner-exact" || localCell.code != 9:
        return 4

    let charPick = support.Pick("x")
    if charPick != 'x':
        return 5
    let joined = strutil.Join([support.Pick(7)], "")
    if joined != "picked":
        return 6
    return 0
