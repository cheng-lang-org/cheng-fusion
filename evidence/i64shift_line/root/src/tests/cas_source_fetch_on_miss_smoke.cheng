# libp2p S3 消费面门禁 (fetch-on-miss oracle): CAS blob miss 时经 CAS admission 拉源落库。
# 正典 docs/beat-c.md §1.11.6 P2 S3。照 cas_store_determinism_smoke 模式:
# exe run 非 census, 断言失败即 abort 非零, 末行 "ok" 才打印。
#
# ★ 验证边界 (实测定谳): stage3/cheng_cold 不 lower 函数值调用 (fetcher(cidHex) 落
# SLOT kind:4, 间接调用只支持 SLOT_PTR/OPAQUE 且假定返回 i32) — libp2p 全部 handler
# 派发 (dcutrHandlerImpl(req)) 同类, 仅经全后端 driver 可 lower。故 fetcher 函数值调用
# 那一行是 driver-gated, 本 smoke 不经 fn-value 触发, 而是直接调 WithFetch 的公开构件:
#   HAVE 预筛(CasStoreHas) + CAS admission(CasAdmitFetchedBytes) + 物化(CasResolveDependencyPath)
# 这三件正是 CasResolveDependencyPathWithFetch 内部去掉 fetcher(cidHex) 那行后的全部逻辑。
# fetched 字节 = 生产里 fetcher 会返回的东西, 此处由本地 BytesFromString 直供 (测试夹具)。
#
# 覆盖:
#   (1) CasStoreHas 预筛: 无 blob → false; admission 后 → true (廉价存在检查)
#   (2) ★ admission-on-miss oracle: 空 store + lock 有 modulePath=cid, blob 缺 →
#       CasAdmitFetchedBytes(校验 cid + ingest) → CasResolveDependencyPath 物化 →
#       物化字节 == 原始; get 重校验通过
#   (3) ★ 负路径: fetched 错字节 (sha256 != cid) → CasAdmitFetchedBytes Err,
#       不 ingest 错 blob, CasStoreHas 事后仍 false (拒收污染, let-it-crash)
#   (4) admission 幂等: 同 cid 二次 admit → Ok (内容寻址 dedup, 不重写)

import std/system
import std/result
import std/os as os
import std/rawbytes as rawbytes
import cheng/std/bytes_layout as layout
import cheng/libp2p/cas_store as cas

fn main(): int32 =
    let base = os.GetEnvDefault("TMPDIR", "/tmp") + "/cheng_cas_s3_fetch"
    let storeRoot = base + "/store"
    os.MkdirAll(base, 493)

    let goodSrc = "fn mul(a: int32, b: int32): int32 =\n    return a * b\n"
    let goodModule = "cheng/mypkg/util_mul"
    let goodCid = cas.CasContentCidHex(goodSrc)
    var goodBytes = rawbytes.BytesFromString(goodSrc)

    # hermetic: 清本测试上轮残留 (blob/lock/materialized), 使 !CasStoreHas 前置跨运行成立
    let _ = os.RemoveFile(cas.CasBlobPath(storeRoot, goodCid))
    let _ = os.RemoveFile(cas.CasLockPath(storeRoot))
    let _ = os.RemoveFile(cas.CasMaterializedPath(storeRoot, goodCid))

    # ---- (1) CasStoreHas 预筛: 尚无 blob → false ----
    assert(!cas.CasStoreHas(storeRoot, goodCid), " CasStoreHas 无 blob -> false (HAVE 预筛)")

    # 只记 lock (不 ingest blob) — 制造 blob miss 的 fetch-on-miss 触发条件
    var recRes: Result[bool] = cas.CasLockRecord(storeRoot, goodModule, goodCid)
    assert(!IsErr(recRes), " lock 记录 goodModule=goodCid 成功: " + Error(recRes))
    assert(!cas.CasStoreHas(storeRoot, goodCid), " lock 记录后仍无 blob (只 lock 无 blob)")

    # ---- (2) ★ admission-on-miss oracle ----
    # fetched = 生产里 fetcher(goodCid) 会返回的字节 (测试夹具本地直供)
    var fetched = rawbytes.BytesFromString(goodSrc)
    var admitRes: Result[bool] = cas.CasAdmitFetchedBytes(storeRoot, goodCid, fetched)
    assert(!IsErr(admitRes), " ★ CAS admission: cid 校验通过 + ingest 成功: " + Error(admitRes))
    assert(cas.CasStoreHas(storeRoot, goodCid), " admission 后 CasStoreHas -> true (blob 已落)")

    # blob 已在 → resolve 物化 (与 WithFetch 尾段同一路径)
    var resRes: Result[str] = cas.CasResolveDependencyPath(storeRoot, goodModule, "/nonexistent")
    assert(!IsErr(resRes), " ★ 物化成功 (fetch-on-miss 尾段): " + Error(resRes))
    let matPath = Value(resRes)

    var readMat: Result[Bytes] = os.ReadFileBytesResult(matPath)
    assert(!IsErr(readMat), " 读物化字节成功")
    var matBytes = Value(readMat)
    assert(rawbytes.BytesEqual(goodBytes, matBytes), " ★ oracle: admit+物化 后字节 == 原始字节")

    var getRes: Result[Bytes] = cas.CasStoreGet(storeRoot, goodCid)
    assert(!IsErr(getRes), " CasStoreGet 命中 (admit 落的 blob 重校验通过): " + Error(getRes))
    assert(rawbytes.BytesEqual(goodBytes, Value(getRes)), " CasStoreGet 字节 == 原始字节")

    # ---- (4) admission 幂等: 同 cid 再 admit → Ok (内容寻址 dedup) ----
    var fetched2 = rawbytes.BytesFromString(goodSrc)
    var admitAgain: Result[bool] = cas.CasAdmitFetchedBytes(storeRoot, goodCid, fetched2)
    assert(!IsErr(admitAgain), " admission 幂等: 同 cid 二次 admit -> Ok (dedup)")

    # ---- (3) ★ 负路径: fetched 错字节 (sha256 != cid) → Err, 不 ingest 错 blob ----
    let badSrc = "fn sub(a: int32, b: int32): int32 =\n    return a - b\n"
    let badCid = cas.CasContentCidHex(badSrc)              # 请求这个 cid
    let wrongSrc = "fn wrong(): int32 =\n    return 0\n"    # 但夹具供这个 (hash 不符 badCid)
    var wrongBytes = rawbytes.BytesFromString(wrongSrc)
    assert(badCid != cas.CasContentCidHex(wrongSrc), " 前提: badCid != wrong 字节的 cid")
    assert(!cas.CasStoreHas(storeRoot, badCid), " 负路径前: badCid 无 blob")

    var badAdmit: Result[bool] = cas.CasAdmitFetchedBytes(storeRoot, badCid, wrongBytes)
    assert(IsErr(badAdmit), " ★ 负路径: fetched 供错字节 (sha!=cid) -> Err (拒收污染)")
    assert(!cas.CasStoreHas(storeRoot, badCid), " ★ 负路径: 错 blob 未 ingest (CasStoreHas 仍 false)")

    echo(" cas_source_fetch_on_miss_smoke ok")
    return 0
