type
    R14Item =
        a: int32
        b: int32

fn R14ObjSeqLocal(): R14Item[] =
    var x: R14Item
    x.a = 1
    x.b = 2
    var v: R14Item[] = [x]
    return v

fn main(): int32 =
    let v = R14ObjSeqLocal()
    if v.len != 1:
        return 10
    echo("r14_objseq_local ok")
    return 0
