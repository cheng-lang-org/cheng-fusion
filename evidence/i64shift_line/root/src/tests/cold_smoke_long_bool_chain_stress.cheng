import std/system

// Mimics the exact pattern from the bug: return x == a || x == b || x == c
// with multiple surrounding functions to increase register pressure

fn helperA(x: int32): int32 = return x * 2
fn helperB(x: int32): int32 = return x + 1
fn helperC(x: int32): int32 = return x * x

fn isWhitespace(ch: int32): bool =
    return ch == 32 || ch == 9 || ch == 13 || ch == 10

fn isDigit(ch: int32): bool =
    return ch >= 48 && ch <= 57

fn isHexDigit(ch: int32): bool =
    let d = helperA(ch)
    return ch >= 48 && ch <= 57 || ch >= 65 && ch <= 70 || ch >= 97 && ch <= 102

fn canWrite(mode: int32): bool =
    return mode == 1 || mode == 2 || mode == 3

fn checkFlags(f1: int32, f2: int32): bool =
    return f1 == 1 || f1 == 2 || f2 == 1 || f2 == 2

fn main(): int32 =
    // Test isWhitespace (4-element ||)
    assert(isWhitespace(32) == true, " ws: space")
    assert(isWhitespace(9) == true, " ws: tab")
    assert(isWhitespace(13) == true, " ws: cr")
    assert(isWhitespace(10) == true, " ws: lf")
    assert(isWhitespace(65) == false, " ws: A")
    assert(isWhitespace(0) == false, " ws: NUL")

    // Test isDigit (&&)
    assert(isDigit(48) == true, " digit: 0")
    assert(isDigit(57) == true, " digit: 9")
    assert(isDigit(58) == false, " digit: colon")
    assert(isDigit(47) == false, " digit: slash")

    // Test isHexDigit (mixed && / ||)
    assert(isHexDigit(48) == true, " hex: 0")
    assert(isHexDigit(57) == true, " hex: 9")
    assert(isHexDigit(65) == true, " hex: A")
    assert(isHexDigit(70) == true, " hex: F")
    assert(isHexDigit(97) == true, " hex: a")
    assert(isHexDigit(102) == true, " hex: f")
    assert(isHexDigit(71) == false, " hex: G")
    assert(isHexDigit(47) == false, " hex: slash")

    // Test canWrite (exact bug pattern)
    assert(canWrite(1) == true, " cw: 1")
    assert(canWrite(2) == true, " cw: 2")
    assert(canWrite(3) == true, " cw: 3")
    assert(canWrite(0) == false, " cw: 0")
    assert(canWrite(4) == false, " cw: 4")
    assert(canWrite(99) == false, " cw: 99")

    // Test checkFlags (cross-variable ||)
    assert(checkFlags(1, 0) == true, " cf: f1=1")
    assert(checkFlags(0, 2) == true, " cf: f2=2")
    assert(checkFlags(3, 3) == false, " cf: neither")

    echo(" cold_smoke_long_bool_chain_stress ok")
    return 0
