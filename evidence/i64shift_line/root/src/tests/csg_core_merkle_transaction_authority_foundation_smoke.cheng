import std/os
import std/cmdline
import cheng/core/csg_core/csgc
import cheng/core/csg_core/merkle_admission
import cheng/core/csg_core/merkle_store_identity
import cheng/core/csg_core/merkle_transaction_authority as authority
import cheng/core/csg_core/merkle_transaction_receipt as receipt
import cheng/core/csg_core/merkle_transaction_request as request

fn fail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

fn main(argc: int32, argv: str*): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    let semanticError =
        authority.CsgCoreMerkleTransactionAuthorityVerifyInMemory(
            authority.CsgCoreMerkleTransactionSemanticInput(),
            request.CsgCoreMerkleSemanticPlan(),
            merkle_admission.CsgCoreMerkleSealedBeforeReadCandidate())
    if semanticError.ok || semanticError.error !=
           "merkle_transaction_authority_admission_invalid":
        return fail("zero semantic authority accepted")
    var invalidGenerationPlan: request.CsgCoreMerkleSemanticPlan
    invalidGenerationPlan.beforeGeneration = int64(-1)
    let planError = request.CsgCoreMerkleSemanticPlanRoot(
        invalidGenerationPlan)
    if planError.ok || planError.error !=
           "merkle_semantic_plan_generation_invalid":
        return fail("negative semantic plan generation accepted")
    var parent: str
    var storeName: str
    if cmdline.ReadFirstFlagValue("--parent", parent) &&
       cmdline.ReadFirstFlagValue("--store", storeName):
        var opened =
            merkle_store_identity.CsgCoreMerkleStoreAcquirePathAuthority(
                parent,
                storeName,
                merkle_store_identity.CsgCoreMerkleStoreExistingOnly)
        if !opened.ok:
            return fail("legal path authority fixture unavailable")
        var pathAuthority = opened.authority
        opened.authority =
            merkle_store_identity.CsgCoreMerkleStorePathAuthority()
        var planningMove =
            merkle_store_identity.CsgCoreMerkleStorePathAuthorityMoveToPlanning(
                pathAuthority)
        if !planningMove.ok:
            return fail("legal planning authority fixture unavailable")
        var planningAuthority = planningMove.authority
        planningMove.authority =
            merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthority()
        var snapshotIssue =
            merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthorityIssueBeforeSnapshot(
                planningAuthority)
        if !snapshotIssue.ok:
            return fail("legal before snapshot fixture unavailable")
        var snapshotAuthority = snapshotIssue.authority
        snapshotIssue.authority =
            merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotAuthority()
        var snapshotClaim =
            merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotClaim(
                snapshotAuthority)
        if !snapshotClaim.ok:
            return fail("legal claimed snapshot fixture unavailable")
        snapshotAuthority = snapshotClaim.authority
        snapshotClaim.authority =
            merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotAuthority()
        var zeroSealed: merkle_admission.CsgCoreMerkleSealedBeforeIssueResult
        var zeroInput: authority.CsgCoreMerkleTransactionSemanticInput
        let failedPrepare =
            authority.CsgCoreMerkleTransactionPrepare(
                zeroInput,
                request.CsgCoreMerkleSemanticPlan(),
                planningAuthority,
                snapshotAuthority,
                zeroSealed)
        if failedPrepare.ok ||
           merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthorityIsValid(
               planningAuthority) ||
           merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotLockedSummary(
               snapshotAuthority).ok:
            return fail("failed Prepare retained before authority")
    else:
        var zeroPlanning: merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthority
        var zeroSnapshot: merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotAuthority
        var zeroSealed: merkle_admission.CsgCoreMerkleSealedBeforeIssueResult
        var zeroInput: authority.CsgCoreMerkleTransactionSemanticInput
        let failedPrepare =
            authority.CsgCoreMerkleTransactionPrepare(
                zeroInput,
                request.CsgCoreMerkleSemanticPlan(),
                zeroPlanning,
                zeroSnapshot,
                zeroSealed)
        if failedPrepare.ok:
            return fail("zero before authority Prepare accepted")
    let projectionError =
        csgc.CsgCoreCsgcProjectionReceiptError(
            csgc.CsgCoreCsgcProjectionReceipt())
    if projectionError != "csgc_projection_receipt_failed":
        return fail("zero projection receipt accepted")
    let receiptError =
        receipt.CsgCoreMerkleTransactionAuthorityReceiptError(
            receipt.CsgCoreMerkleTransactionAuthorityReceipt())
    if receiptError !=
       "merkle_transaction_authority_receipt_count_invalid":
        return fail("zero transaction receipt accepted")
    if authority.CsgCoreMerkleTransactionArtifactClosureCid([]) !=
       "invalid:merkle_transaction_artifact_closure_empty":
        return fail("empty artifact closure accepted")
    if authority.CsgCoreMerklePreparedTransactionIsValid(
           authority.CsgCoreMerklePreparedTransaction()):
        return fail("zero prepared capability accepted")
    var zeroPrepared: authority.CsgCoreMerklePreparedTransaction
    let failedPrepublish =
        authority.CsgCoreMerkleTransactionPrepublishVerifyInMemory(
            zeroPrepared)
    if failedPrepublish.ok || zeroPrepared.ownerId != 0:
        return fail("zero prepared prepublish accepted")
    if authority.CsgCoreMerklePrepublishSessionIsValid(
           authority.CsgCoreMerklePrepublishSession()):
        return fail("zero prepublish session accepted")
    os.WriteLine(
        os.Get_stdout(),
        "csg_core_merkle_transaction_authority_foundation_smoke ok")
    return 0
