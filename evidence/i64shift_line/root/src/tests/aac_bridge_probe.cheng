# AAC bridge probe: encode 1 s of 440 Hz sine (48 kHz mono s16) through
# the pure-Cheng AudioConverter bridge and assert the raw AAC packet
# structure. Optional argv[1] writes the raw stream for external decode.
import cheng/game/cinema/aac
import std/cmdline
import std/os
import std/math as m
import std/strings as strings

const
    ProbeSamples = 48000

fn main(): int32 =
    var pcm: uint8[]
    setLen(pcm, ProbeSamples * 2)
    let dphase: float64 = 2.0 * 3.14159265358979 * 440.0 / 48000.0
    var phase: float64 = 0.0
    var i: int32 = 0
    while i < ProbeSamples:
        let v: float64 = m.sinFloat(phase) * 12000.0
        let s: int32 = int32(v)
        let biased: int32 = s + 32768
        pcm[i * 2] = uint8(biased % 256)
        pcm[i * 2 + 1] = uint8((biased / 256) % 256)
        phase = phase + dphase
        i = i + 1
    var payload: uint8[]
    setLen(payload, 0)
    var sizes: int32[]
    setLen(sizes, 0)
    let rc = aac.AacEncodePcm16(pcm, ProbeSamples * 2, payload, sizes)
    if rc != 0:
        echo("FAIL encode rc=" + strings.IntToStr(rc))
        return 1
    # 48000 samples / 1024 per packet: the tail partial frame is dropped
    # by converter design -> 46 packets
    if sizes.len < 40 || sizes.len > 50:
        echo("FAIL packet count " + strings.IntToStr(sizes.len))
        return 1
    var total: int32 = 0
    var k: int32 = 0
    while k < sizes.len:
        # a highly compressible first frame can be a few bytes
        if sizes[k] < 2 || sizes[k] > 800:
            echo("FAIL packet size " + strings.IntToStr(sizes[k]) + " at " + strings.IntToStr(k))
            return 1
        total = total + sizes[k]
        k = k + 1
    if total < 1000 || total != payload.len:
        echo("FAIL payload bytes total=" + strings.IntToStr(total) + " len=" + strings.IntToStr(payload.len))
        return 1
    var args: str[]
    var ai: int32 = 0
    while ai < cmdline.paramCount():
        add(args, cmdline.paramStr(ai))
        ai = ai + 1
    if args.len > 0:
        os.WriteFileBytes(args[0], payload)
    echo("PASS aac bridge probe: packets=" + strings.IntToStr(sizes.len) + " bytes=" + strings.IntToStr(total))
    return 0
