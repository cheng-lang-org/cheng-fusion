# P5: hoist the shared projection into a named let before the mixed call.
import std/rawbytes as rawbytes

type
    Holder =
        payload: rawbytes.Bytes
        table: rawbytes.Bytes

@borrows
fn sinkMix2(a: var rawbytes.Bytes, k: rawbytes.Bytes) =
    if a.len < 0 || k.len < 0:
        panic("probe sink")

@borrows
fn wrapperP5(h: var Holder, block: rawbytes.Bytes) =
    let kTable = h.table
    sinkMix2(h.payload, kTable)
    if block.len < 0:
        panic("probe block")

fn main(): int32 =
    var h: Holder
    h.payload = rawbytes.BytesAlloc(8)
    h.table = rawbytes.BytesAlloc(256)
    wrapperP5(h, h.payload)
    rawbytes.BytesFree(h.payload)
    rawbytes.BytesFree(h.table)
    return 0
