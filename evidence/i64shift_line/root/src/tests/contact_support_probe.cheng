# Contact support probe (phase-2 physical walking risk preflight).
# Experiment A: a dynamic point body (sphere impostor, r = 0.05) free-drops
# from z = 1.0 onto the analytic ground plane z = 0 and must come to rest at
# the contact height with quelled normal velocity and a converging 5-frame
# tail. Experiment B: the same body starts with a 1 m/s tangential velocity
# and, once in ground contact, must stop within a bounded slide via
# position-level Coulomb friction (ground mu = Contacts3dGroundFriction
# = 0.6, friction cone bound mu * penetration) with the tangential velocity
# quenched to zero. PASS prints
# "PASS contact support probe"; a capability gap prints the audit finding
# and "PASS contact audit (gaps documented)".
# Frame traces are buffered during stepping (no string work inside the
# physics loop) and printed after each experiment finishes.
import cheng/game/world3d
import cheng/game/physics3d
import std/math as m
import std/strings as strings

fn fmtQ(x: float64): str =
    let scaled: int32 = int32(m.roundFloat(x * 1000.0))
    var neg: bool = scaled < 0
    var mag: int32 = scaled
    if neg:
        mag = 0 - mag
    let intPart: int32 = mag / 1000
    let fracPart: int32 = mag % 1000
    var outStr: str = ""
    if neg:
        outStr = "-"
    outStr = outStr + strings.IntToStr(intPart) + "." + strings.CloneStrRange(strings.IntToStr(fracPart + 1000), 1, 3)
    return outStr

fn echoFrameA(i: int32, z: float64, vz: float64) =
    echo("A frame i=" + strings.IntToStr(i) + " z_mm=" + fmtQ(z * 1000.0) + " vz_mms=" + fmtQ(vz * 1000.0))

fn echoFrameB(i: int32, x: float64, vx: float64) =
    echo("B frame i=" + strings.IntToStr(i) + " x_mm=" + fmtQ(x * 1000.0) + " vx_mms=" + fmtQ(vx * 1000.0))

# Experiment A: free drop onto the analytic ground plane; must settle at the
# contact height z = r with normal velocity quelled (e = 0 contact support).
fn expDropSupport(): bool =
    var w: world3d.World3d
    World3dReset(w, int64(21))
    let _b = World3dSpawnBody(w, 0.0, 0.0, 1.0, 1.0, 0.05, world3d.World3dBodyDynamic)
    let r: float64 = 0.05
    var traceI: int32[]
    var traceZ: float64[]
    var traceVz: float64[]
    var firstContact: int32 = -1
    var rejected: int32 = -1
    var i: int32 = 0
    while i < 720:
        var rcpt = physics3d.Physics3dStep(w, "probe:drop")
        if rcpt.statusCode != physics3d.Physics3dStatusOk:
            rejected = i
            break
        if firstContact < 0:
            if rcpt.contactCount > 0:
                firstContact = i
        if firstContact >= 0:
            if i <= firstContact + 5:
                add(traceI, i)
                add(traceZ, w.bodyPz[0])
                add(traceVz, w.bodyVz[0])
        i = i + 1
    var k: int32 = 0
    while k < traceI.len:
        echoFrameA(traceI[k], traceZ[k], traceVz[k])
        k = k + 1
    if rejected >= 0:
        echo("A FAIL step rejected i=" + strings.IntToStr(rejected) + " z_mm=" + fmtQ(w.bodyPz[0] * 1000.0) + " vz_mms=" + fmtQ(w.bodyVz[0] * 1000.0))
        return false
    if firstContact < 0:
        echo("A FAIL no ground contact detected")
        return false
    let sinkMm = m.absFloat(r - w.bodyPz[0]) * 1000.0
    echo("A rest z_mm=" + fmtQ(w.bodyPz[0] * 1000.0) + " sink_mm=" + fmtQ(sinkMm) + " vz_mms=" + fmtQ(w.bodyVz[0] * 1000.0))
    if sinkMm > 5.0:
        return false
    if m.absFloat(w.bodyVz[0]) > 50.0:
        return false
    return true

# Experiment B: land with a 1 m/s tangential velocity; position-level
# Coulomb friction must stop the slide within a bounded distance after
# first ground contact and quench the tangential velocity.
fn expSlideFriction(): bool =
    var w: world3d.World3d
    World3dReset(w, int64(22))
    let _b = World3dSpawnBody(w, 0.0, 0.0, 0.30, 1.0, 0.05, world3d.World3dBodyDynamic)
    w.bodyVx[0] = 1.0
    var traceI: int32[]
    var traceX: float64[]
    var traceVx: float64[]
    var firstContact: int32 = -1
    var xAtContact: float64 = 0.0
    var rejected: int32 = -1
    var i: int32 = 0
    while i < 720:
        var rcpt = physics3d.Physics3dStep(w, "probe:slide")
        if rcpt.statusCode != physics3d.Physics3dStatusOk:
            rejected = i
            break
        if firstContact < 0:
            if rcpt.contactCount > 0:
                firstContact = i
                xAtContact = w.bodyPx[0]
        if firstContact >= 0:
            if i <= firstContact + 5:
                add(traceI, i)
                add(traceX, w.bodyPx[0])
                add(traceVx, w.bodyVx[0])
        i = i + 1
    var k: int32 = 0
    while k < traceI.len:
        echoFrameB(traceI[k], traceX[k], traceVx[k])
        k = k + 1
    if rejected >= 0:
        echo("B FAIL step rejected i=" + strings.IntToStr(rejected))
        return false
    # slide distance is measured from first ground contact onward: the
    # ballistic fall phase is friction-free by construction and must not
    # count against the contact friction budget.
    let slideMm = (w.bodyPx[0] - xAtContact) * 1000.0
    echo("B contact x_mm=" + fmtQ(xAtContact * 1000.0) + " final x_mm=" + fmtQ(w.bodyPx[0] * 1000.0) + " vx_mms=" + fmtQ(w.bodyVx[0] * 1000.0) + " slide_mm=" + fmtQ(slideMm))
    if m.absFloat(w.bodyVx[0]) > 20.0:
        return false
    if slideMm > 300.0:
        return false
    return true

fn main(): int32 =
    let supportOk = expDropSupport()
    let frictionOk = expSlideFriction()
    echo("audit supportOk=" + strings.IntToStr(int32(supportOk)) + " frictionOk=" + strings.IntToStr(int32(frictionOk)))
    if supportOk:
        if frictionOk:
            echo("PASS contact support probe")
            return 0
        echo("GAP friction: ground slide does not stop within the friction bound or tangential velocity does not quench")
        echo("PASS contact audit (gaps documented)")
        return 0
    echo("GAP support: dynamic point body does not settle on the ground plane")
    echo("PASS contact audit (gaps documented)")
    return 0
