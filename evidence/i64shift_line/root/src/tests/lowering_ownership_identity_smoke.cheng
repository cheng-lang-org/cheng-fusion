import cheng/core/backend/lowering_plan as lower
import cheng/core/ir/core_types as coreir
import cheng/core/lang/typed_expr as texpr
import cheng/core/lang/typed_expr_type_arena as typearena
import cheng/std/bytes_layout as layout
import std/os
import std/result

fn typeArenaCid(): layout.FixedBytes32 =
    let parsed = layout.FixedBytes32FromHex(
        "abababababababababababababababababababababababababababababababab")
    assert(IsOk(parsed), "TypeArena CID fixture")
    return Value(parsed)

fn loweringPlan(): lower.LoweringPlanStub =
    var out: lower.LoweringPlanStub
    out.typeArenaArtifactCid = typeArenaCid()
    for typeId in 0..<42:
        add(
            out.typeArenaStructuralKinds,
            int32(typearena.TypedExprStructuralTypeScalar))
        var scalarKind =
            int32(typearena.TypedExprStructuralScalarInt32)
        var sizeBytes: int32 = 4
        var alignBytes: int32 = 4
        if typeId == 37 || typeId == 41:
            scalarKind =
                int32(typearena.TypedExprStructuralScalarStr)
            sizeBytes = 24
            alignBytes = 8
        add(out.typeArenaScalarKinds, scalarKind)
        add(out.typeArenaChildTypeIds, -1)
        add(out.typeArenaFixedLengths, 0)
        add(out.typeArenaSizeBytes, sizeBytes)
        add(out.typeArenaAlignBytes, alignBytes)
        add(out.typeArenaLayoutPresent, 1)
    return out

fn transportWithStatementCollision():
        lower.LoweringOwnershipTransportSoA =
    var out: lower.LoweringOwnershipTransportSoA
    out.typedFunctionIndex = 3
    out.sourceValueDefinitionStart = 11
    out.sourceValueDefinitionCount = 2
    out.typeArenaArtifactCid = typeArenaCid()
    lower.LoweringOwnershipTransportAppendExactRow(
        out,
        7,
        11,
        int32(texpr.TypedExprValueDefinitionOriginBindingInitializer),
        23,
        13,
        17,
        19,
        23,
        37,
        texpr.TypedExprExprOwned,
        -1,
        texpr.TypedExprSnapshotTypeProofManagedValue,
        true,
        texpr.TypedExprIrOpCallExpr,
        29)
    lower.LoweringOwnershipTransportAppendExactRow(
        out,
        8,
        12,
        int32(texpr.TypedExprValueDefinitionOriginBindingInitializer),
        31,
        14,
        18,
        19,
        31,
        41,
        texpr.TypedExprExprOwned,
        -1,
        texpr.TypedExprSnapshotTypeProofManagedValue,
        true,
        texpr.TypedExprIrOpCallExpr,
        30)
    out.complete = true
    return out

fn callBody(): coreir.BodyIR =
    var out: coreir.BodyIR
    var slot: coreir.LocalSlot
    slot.id = 0
    slot.typeKind = coreir.LocalStrTag
    slot.sizeBytes = 24
    slot.alignBytes = 8
    coreir.BodyIRApplyLocalSlotDefaultProof(slot)
    add(out.localSlots, slot)
    var call: coreir.CallOp
    coreir.BodyIRApplyCallOpDefaultProof(call)
    call.resultSlot = 0
    call.resultPassKind = coreir.BodyCallPassStackValueTag
    add(out.callSequence, call)
    var op: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = coreir.BodyOpCallTag
    op.target = 0
    add(op.operands, 0)
    add(out.ops, op)
    return out

fn main() =
    let transport = transportWithStatementCollision()
    assert(
        lower.LoweringOwnershipTransportRowForDefinition(
            transport, 19, 23) == 0,
        "first exact TypedExpr definition identity lost")
    assert(
        lower.LoweringOwnershipTransportRowForDefinition(
            transport, 19, 31) == 1,
        "second exact TypedExpr definition identity lost")
    assert(
        lower.LoweringOwnershipTransportRowForDefinition(
            transport, 19, 24) == -1,
        "forged TypedExpr definition identity accepted")
    var body = callBody()
    var lowering = loweringPlan()
    lower.LoweringBindManagedCallResultDefinition(
        body, lowering, transport, 19, 23, 0, 0)
    assert(body.callSequence[0].resultExprNodeIndex == 23 &&
           body.callSequence[0].resultValueDefinitionRow == 11 &&
           body.ops[0].valueDefExprNodeIndex == 23 &&
           body.ops[0].valueDefSemanticRow == 11 &&
           coreir.BodyIRCanonicalTypeFactRow(body, 37) >= 0,
           "BodyIR lost exact TypedExpr definition identity")
    os.WriteLine(
        os.GetStdout(),
        "lowering_ownership_identity_smoke: ok")
