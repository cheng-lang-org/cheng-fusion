# SSM1 真包播放调度探针 (胡广生实战包)。
# 用法: csg_ssm1_playback_probe.exe <stream.ssm1 路径>
# 全链: 内嵌解析 → PlayerInit → 秒开定位(t=0 关键帧) → 顺序播放取数 →
# 拖拽吸附关键帧 → 倍速推进 → EOF 门闩三规则 → 回退续播。
import std/cmdline
import std/rawbytes
import cheng/game/assets/import/reader
import cheng/game/assets/stream/manifest
import cheng/game/assets/stream/player

fn main(): int32 =
    let path = cmdline.paramStr(1)
    var bounds = reader.AssetReaderBoundsFor("manifest")
    bounds.maxBytes = manifest.StreamManifestQuotaMaxBytes()
    var data = rawbytes.EmptyBytes()
    assert(reader.AssetReaderLoadBounded(path, bounds, data), "load pack")
    defer:
        rawbytes.BytesFree(data)
    var m: manifest.StreamManifest
    assert(manifest.StreamManifestParseEx(data, m, true), "embedded parse")
    let n = manifest.StreamManifestChunkCount(m)
    echo(Fmt"pack chunks={n} duration={manifest.StreamManifestTotalDurationMs(m)}ms")

    var p: player.StreamPlayerQ
    assert(player.PlayerInit(p, manifest.StreamManifestTotalDurationMs(m), int64(2000)),
        "player init 22500ms window 2000ms")

    # 秒开: t=0 应取首关键帧 chunk。
    var fetch: int32
    var pre: int32[]
    assert(player.PlayerSeek(p, int64(0)), "seek 0")
    assert(player.PlayerTick(p, int64(0), m, fetch, pre), "open tick")
    echo(Fmt"OPEN fetch={fetch} (秒开定位) pre={pre.len} bufferedTo={p.bufferedToMs}")
    assert(fetch == 0, "open lands keyframe chunk 0")

    # 顺序播放 2s (4x500ms): 取数随时间切换。
    assert(player.PlayerPlay(p), "play")
    var t: int64
    t = int64(500)
    for i in 0..<4:
        assert(player.PlayerTick(p, int64(500), m, fetch, pre), "seq tick")
        echo(Fmt"SEQ t={t} fetch={fetch} pos={p.posMs}")
        t = t + int64(500)

    # 拖拽 12000ms: 吸附最近关键帧 (关键帧每 5 chunk = 每 2500ms -> chunk 20)。
    assert(player.PlayerSeek(p, int64(12000)), "seek 12000")
    assert(player.PlayerTick(p, int64(0), m, fetch, pre), "snap tick")
    echo(Fmt"SEEK 12000 snapFetch={fetch}")
    assert(fetch == 20, "snap to keyframe chunk 20")

    # 倍速 2x: 500ms tick 推进 1000ms。
    assert(player.PlayerSetRate(p, 20), "rate 2x")
    assert(player.PlayerTick(p, int64(500), m, fetch, pre), "rate tick")
    echo(Fmt"RATE2X pos={p.posMs} fetch={fetch}")

    # EOF 门闩: 播到末端闩上 -> play 拒 -> 回退复位续播。
    assert(player.PlayerSeek(p, int64(22400)), "seek near end")
    assert(player.PlayerSetRate(p, 10), "rate 1x")
    assert(player.PlayerTick(p, int64(500), m, fetch, pre), "eof tick")
    echo(Fmt"NEAR-END pos={p.posMs} eof={p.eofLatched}")
    assert(player.PlayerTick(p, int64(500), m, fetch, pre), "eof tick2")
    assert(p.eofLatched, "eof latched at duration")
    assert(!player.PlayerPlay(p), "play after eof rejected")
    assert(player.PlayerSeek(p, int64(0)), "seek back resets latch")
    assert(player.PlayerTick(p, int64(250), m, fetch, pre), "resume tick")
    echo(Fmt"RESUME pos={p.posMs} fetch={fetch} eof={p.eofLatched}")
    assert(!p.eofLatched, "latch cleared")

    echo("csg_ssm1_playback_probe PASS")
    return 0
