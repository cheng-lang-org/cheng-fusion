import std/strutils as strutil

fn test_strip_basic(): int32 =
    let s = "  hello  "
    let stripped = strutil.Strip(s)
    if stripped.len != 5: return 1
    if stripped != "hello": return 2
    return 0

fn test_strip_left(): int32 =
    let s = "  world"
    let stripped = strutil.Strip(s)
    if stripped.len != 5: return 1
    if stripped != "world": return 2
    return 0

fn test_strip_right(): int32 =
    let s = "xyz   "
    let stripped = strutil.Strip(s)
    if stripped.len != 3: return 1
    if stripped != "xyz": return 2
    return 0

fn test_strip_both_sides(): int32 =
    let s = "\n\tmiddle\n\t"
    let stripped = strutil.Strip(s)
    if stripped.len != 6: return 1
    if stripped != "middle": return 2
    return 0

fn test_strip_no_change(): int32 =
    let s = "unchanged"
    let stripped = strutil.Strip(s)
    if stripped.len != 9: return 1
    if stripped != "unchanged": return 2
    return 0

fn test_strip_empty(): int32 =
    let s = ""
    let stripped = strutil.Strip(s)
    if stripped.len != 0: return 1
    return 0

fn test_strip_all_ws(): int32 =
    let s = "   \t  \n  "
    let stripped = strutil.Strip(s)
    if stripped.len != 0: return 1
    if stripped != "": return 2
    return 0

fn test_split_basic(): int32 =
    let s = "a,b,c"
    let parts = strutil.Split(s, ',')
    if parts.len != 3: return 1
    if parts[0] != "a": return 2
    if parts[1] != "b": return 3
    if parts[2] != "c": return 4
    return 0

fn test_split_empty_input(): int32 =
    let s = ""
    let parts = strutil.Split(s, ',')
    if parts.len != 0: return 1
    return 0

fn test_split_no_delim(): int32 =
    let s = "hello"
    let parts = strutil.Split(s, ',')
    if parts.len != 1: return 1
    if parts[0] != "hello": return 2
    return 0

fn test_split_trailing(): int32 =
    let s = "a,b,"
    let parts = strutil.Split(s, ',')
    if parts.len != 3: return 1
    if parts[0] != "a": return 2
    if parts[1] != "b": return 3
    if parts[2] != "": return 4
    return 0

fn test_split_leading(): int32 =
    let s = ",a,b"
    let parts = strutil.Split(s, ',')
    if parts.len != 3: return 1
    if parts[0] != "": return 2
    if parts[1] != "a": return 3
    if parts[2] != "b": return 4
    return 0

fn test_split_consecutive(): int32 =
    let s = "a,,b"
    let parts = strutil.Split(s, ',')
    if parts.len != 3: return 1
    if parts[0] != "a": return 2
    if parts[1] != "": return 3
    if parts[2] != "b": return 4
    return 0

fn main(): int32 =
    if test_strip_basic() != 0: return 1
    if test_strip_left() != 0: return 2
    if test_strip_right() != 0: return 3
    if test_strip_both_sides() != 0: return 4
    if test_strip_no_change() != 0: return 5
    if test_strip_empty() != 0: return 6
    if test_strip_all_ws() != 0: return 7
    if test_split_basic() != 0: return 8
    if test_split_empty_input() != 0: return 9
    if test_split_no_delim() != 0: return 10
    if test_split_trailing() != 0: return 11
    if test_split_leading() != 0: return 12
    if test_split_consecutive() != 0: return 13
    return 0
