import std/atomic

type
    CounterCtx = ref object
        counter: atomic.I32

fn ProbeWorker(raw: ptr) =
    let ctx: CounterCtx = CounterCtx(raw)
    let _ = atomic.AddI32(ctx.counter, 1)

fn main(): int32 =
    let counter = atomic.NewI32(0)
    if counter == nil:
        return 11
    let ctx = new(CounterCtx)
    if ctx == nil:
        return 12
    ctx.counter = counter
    ProbeWorker(&ctx.counter)
    if atomic.LoadI32(counter) != 1:
        return 13
    return 0
