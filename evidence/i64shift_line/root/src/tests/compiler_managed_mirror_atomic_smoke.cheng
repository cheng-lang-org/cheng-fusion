import std/cmdline
import std/os
import std/result
import std/strutils as strutil
import cheng/std/bytes_layout as layout
import cheng/core/tooling/path as chengpath
import cheng/core/tooling/compiler_request as creq
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/tooling/compiler_equivalence as ceq
import cheng/core/tooling/compiler_world as cworld
import cheng/core/tooling/compiler_world_libp2p as cwlp
import cheng/core/lang/parser
import cheng/core/backend/system_link_plan as slplan
import cheng/core/backend/system_link_exec as sexec

fn MirrorAtomicInstallRoot(): str =
    var root: str
    if !cmdline.readFlagValue("--install-root", root) || root == "":
        root = chengpath.PathJoin(
            chengpath.PathCurrentDir(),
            "artifacts/compiler_managed_mirror_atomic")
    return root

fn MirrorAtomicBuildBundle(
        workspaceRoot: str,
        out: var cwlp.CompilerManagedMirrorBundle): Result[bool] =
    let packageId = "cheng"
    let canonicalSourcePath = chengpath.PathJoin(
        workspaceRoot,
        "src/tests/compiler_migration_fixture_canonical_plan.cheng")
    let legacySourcePath = chengpath.PathJoin(
        workspaceRoot,
        "src/tests/compiler_migration_fixture_legacy_input.txt")
    var noExternalPackageRoots: parser.ParserExternalPackageRoot[]
    var entryModulePath: str
    if !parser.ParserSourcePathToModulePathExactWithExternalPackageRootsInto(
            workspaceRoot,
            workspaceRoot,
            packageId,
            noExternalPackageRoots,
            canonicalSourcePath,
            entryModulePath):
        return Err[bool](
            " compiler managed mirror atomic: exact entry identity")
    let req = creq.CompilerRequestNew(
        workspaceRoot,
        canonicalSourcePath,
        "/tmp/compiler_managed_mirror_atomic.out",
        "arm64-apple-darwin",
        creq.EmitExe,
        "")
    var linkPlan: slplan.SystemLinkPlanStub
    var err: str
    if !slplan.BuildSystemLinkPlanStub(workspaceRoot,
                                        req,
                                        linkPlan,
                                        err):
        return Err[bool](err)
    let sourceBundleRes = slplan.SystemLinkPlanSourceBundleCid(linkPlan)
    if IsErr(sourceBundleRes):
        return Err[bool](Error(sourceBundleRes))
    let baselineCsgRes = ccsg.BuildCompilerCsg(linkPlan,
                                               Value(sourceBundleRes))
    if IsErr(baselineCsgRes):
        return Err[bool](Error(baselineCsgRes))
    let baselineCsg = ccsg.CompilerCsgClone(Value(baselineCsgRes))
    let migrationRes = ccsg.BuildCompilerLegacyMigration(
        workspaceRoot,
        workspaceRoot,
        legacySourcePath,
        packageId,
        entryModulePath)
    if IsErr(migrationRes):
        return Err[bool](Error(migrationRes))
    let migration = ccsg.CompilerLegacyMigrationClone(Value(migrationRes))
    var evidence: ceq.CompilerMigrationEvidence
    let evidenceRes = ceq.CompilerMigrationEvidenceMake(
        migration,
        evidence)
    if IsErr(evidenceRes):
        return Err[bool](Error(evidenceRes))
    let stage = "stage3_local"
    let canonicalOutputDigest = ccsg.CompileOutputDigest(
        req.outputPath,
        req.targetTriple,
        linkPlan.providerModules,
        baselineCsg.canonicalGraphCid)
    var baselineSemantic: sexec.CompileSemanticReceipt
    if !sexec.SystemLinkExecCompileSemanticReceiptFromCanonicalCsgMakeInto(
            migration.baselineArtifact.sourceIdentityReceipt,
            migration.baselineArtifact.canonicalGraphCid,
            canonicalOutputDigest,
            req.targetTriple,
            stage,
            linkPlan.providerModules,
            baselineSemantic,
            err):
        return Err[bool](err)
    var migratedSemantic: sexec.CompileSemanticReceipt
    if !sexec.SystemLinkExecCompileSemanticReceiptFromCanonicalCsgMakeInto(
            migration.migratedArtifact.sourceIdentityReceipt,
            migration.migratedArtifact.canonicalGraphCid,
            canonicalOutputDigest,
            req.targetTriple,
            stage,
            linkPlan.providerModules,
            migratedSemantic,
            err):
        return Err[bool](err)
    var proof: ceq.CompilerMigrationSemanticProof
    let proofRes = ceq.CompilerMigrationSemanticProofMake(
        packageId,
        "stable",
        evidence,
        migration.baselineArtifact.canonicalGraphCid,
        migration.migratedArtifact.canonicalGraphCid,
        migration.baselineArtifact.exportSurface,
        migration.migratedArtifact.exportSurface,
        baselineSemantic,
        migratedSemantic,
        req.targetTriple,
        proof)
    if IsErr(proofRes):
        return Err[bool](Error(proofRes))
    let currentSurface = ccsg.CompilerExportSurfaceFromCsg(baselineCsg)
    if !ceq.CompilerMigrationSourceReceiptEqual(
            baselineCsg.sourceIdentityReceipt,
            migration.migratedArtifact.sourceIdentityReceipt) ||
       !layout.FixedBytes32Equal(
            baselineCsg.canonicalGraphCid,
            migration.migratedArtifact.canonicalGraphCid) ||
       !layout.FixedBytes32Equal(
            currentSurface.surfaceCid,
            migration.migratedArtifact.exportSurface.surfaceCid):
        return Err[bool](
            " compiler managed mirror atomic: current plan is not migrated fixed point")
    var plan: sexec.SystemLinkExecPlan
    plan.systemLinkPlan = linkPlan
    plan.compilerCsg = baselineCsg
    plan.exportSurface = currentSurface
    plan.semanticReceipt = migratedSemantic
    plan.compileReceipt.bootstrapStage = stage
    plan.localUniverse.worldHead.channel = "stable"
    return cwlp.CompilerWorldManagedMirrorBundleMake(
        plan,
        migration,
        evidence,
        proof,
        out)

fn MirrorAtomicParentAndFinal(
        installRoot: str,
        bundle: cwlp.CompilerManagedMirrorBundle,
        outParent: var str,
        outFinal: var str) =
    outFinal = cworld.CompilerManagedMirrorRoot(
        installRoot,
        bundle.channel,
        bundle.packageId,
        bundle.bundleCid)
    outParent = chengpath.PathParentDir(outFinal)

fn MirrorAtomicProvisionParent(parent: str) =
    assert(chengpath.MkdirP("", parent),
           " compiler managed mirror atomic: trusted parent provisioning")

fn MirrorAtomicWriteExisting(
        finalRoot: str,
        files: cwlp.CompilerManagedMirrorMaterializedFile[],
        mutateBundle: bool,
        stopBeforeCommit: bool) =
    assert(chengpath.MkdirP("", finalRoot),
           " compiler managed mirror atomic: existing root")
    for fileIndex in 0..<files.len:
        let relativePath = files[fileIndex].relativePath
        if stopBeforeCommit &&
           relativePath == ".cheng-mirror/commit.txt":
            continue
        let absolutePath = chengpath.PathJoin(finalRoot, relativePath)
        let parent = chengpath.PathParentDir(absolutePath)
        if parent != "":
            assert(chengpath.MkdirP("", parent),
                   " compiler managed mirror atomic: existing parent")
        var text = files[fileIndex].text
        if mutateBundle && relativePath == "bundle.txt":
            text = strutil.Join([text, "\nattacker=1"], "")
        os.WriteFile(absolutePath, text)

fn MirrorAtomicWriteSourceManifestAttack(
        finalRoot: str,
        bundleCid: layout.FixedBytes32,
        files: cwlp.CompilerManagedMirrorMaterializedFile[]) =
    assert(chengpath.MkdirP("", finalRoot),
           " compiler managed mirror atomic: manifest attack root")
    var commitFiles: cworld.CompilerManagedMirrorCommitFile[]
    var sourceMutated = false
    for fileIndex in 0..<files.len:
        let relativePath = files[fileIndex].relativePath
        if relativePath == ".cheng-mirror/commit.txt":
            continue
        var text = files[fileIndex].text
        if chengpath.TextStartsWith(relativePath, "src/"):
            text = strutil.Join([text, "\n# attacker"], "")
            sourceMutated = true
        let absolutePath = chengpath.PathJoin(finalRoot, relativePath)
        let parent = chengpath.PathParentDir(absolutePath)
        if parent != "":
            assert(chengpath.MkdirP("", parent),
                   " compiler managed mirror atomic: manifest attack parent")
        os.WriteFile(absolutePath, text)
        var commitFile: cworld.CompilerManagedMirrorCommitFile
        commitFile.relativePath = relativePath
        commitFile.rawByteLength = text.len
        commitFile.contentCid = cworld.CompilerWorldSourceRawBytesCid(text)
        add(commitFiles, commitFile)
    assert(sourceMutated,
           " compiler managed mirror atomic: manifest attack source absent")
    var commit: cworld.CompilerManagedMirrorCommit
    commit.bundleCid = bundleCid
    commit.fileCount = commitFiles.len
    commit.files = commitFiles
    let markerPath = chengpath.PathJoin(
        finalRoot,
        ".cheng-mirror/commit.txt")
    assert(chengpath.MkdirP("", chengpath.PathParentDir(markerPath)),
           " compiler managed mirror atomic: manifest attack marker parent")
    os.WriteFile(markerPath,
                 cworld.CompilerManagedMirrorCommitReport(commit))

fn MirrorAtomicManagedLock(
        bundle: cwlp.CompilerManagedMirrorBundle): cworld.CompilerLockSnapshot =
    var entry: cworld.CompilerUniverseManifestEntry
    entry.packageId = bundle.packageId
    entry.snapshotCid = cworld.CompilerWorldHashText(
        "managed_mirror_locator_snapshot",
        [bundle.packageId])
    entry.syntaxSurfaceCid = cworld.CompilerWorldHashText(
        "managed_mirror_locator_syntax",
        [bundle.packageId])
    entry.migrationProofCid = bundle.migrationProofCid
    entry.managedMirrorBundleCid = bundle.bundleCid
    var lock: cworld.CompilerLockSnapshot
    lock.channel = bundle.channel
    lock.worldHeadCid = cworld.CompilerWorldHashText(
        "managed_mirror_locator_world",
        [bundle.channel])
    lock.manifestRootCid = cworld.CompilerWorldHashText(
        "managed_mirror_locator_manifest",
        [bundle.channel])
    lock.compilerPkgCid = cworld.CompilerWorldHashText(
        "managed_mirror_locator_compiler",
        [bundle.channel])
    lock.stdPkgCid = cworld.CompilerWorldHashText(
        "managed_mirror_locator_std",
        [bundle.channel])
    lock.runtimePkgCid = cworld.CompilerWorldHashText(
        "managed_mirror_locator_runtime",
        [bundle.channel])
    lock.managedDependencyReceiptCid = cworld.CompilerWorldHashText(
        "managed_mirror_locator_dependency",
        [layout.FixedBytes32Hex(bundle.bundleCid)])
    lock.entryCount = 1
    lock.entries = [entry]
    return lock

fn MirrorAtomicAssertSystemLinkLocator(
        installRoot: str,
        bundle: cwlp.CompilerManagedMirrorBundle,
        files: cwlp.CompilerManagedMirrorMaterializedFile[]) =
    assert(!layout.FixedBytes32Equal(bundle.migrationProofCid,
                                     bundle.bundleCid),
           " compiler managed mirror locator: proof/bundle fixture collapsed")
    let lock = MirrorAtomicManagedLock(bundle)
    var roots: parser.ParserExternalPackageRoot[]
    var handles: os.AtomicTree[]
    var err: str
    assert(sexec.SystemLinkExecExternalPackageRootsInto(
               installRoot,
               lock,
               roots,
               handles,
               err),
           strutil.Join([
               " compiler managed mirror locator: bundle root rejected: ",
               err
           ], ""))
    assert(roots.len == 1 &&
           roots[0].packageRoot == cworld.CompilerManagedMirrorRoot(
               installRoot,
               bundle.channel,
               bundle.packageId,
               bundle.bundleCid),
           " compiler managed mirror locator: bundle cid did not select source root")
    assert(roots[0].verifiedSnapshotRequired,
           " compiler managed mirror locator: verified source snapshot absent")
    assert(sexec.SystemLinkExecManagedMirrorHandlesCloseInto(handles, err),
           strutil.Join([
               " compiler managed mirror locator: verified handle close failed: ",
               err
           ], ""))

    let missingInstallRoot = strutil.Join(
        [installRoot, ".locator_missing"],
        "")
    roots = []
    handles = []
    err = ""
    assert(!sexec.SystemLinkExecExternalPackageRootsInto(
                missingInstallRoot,
                lock,
                roots,
                handles,
                err),
           " compiler managed mirror locator: missing bundle root accepted")

    let wrongInstallRoot = strutil.Join(
        [installRoot, ".locator_proof_root"],
        "")
    let wrongRoot = cworld.CompilerManagedMirrorRoot(
        wrongInstallRoot,
        bundle.channel,
        bundle.packageId,
        bundle.migrationProofCid)
    MirrorAtomicProvisionParent(chengpath.PathParentDir(wrongRoot))
    MirrorAtomicWriteExisting(wrongRoot, files, false, false)
    roots = []
    handles = []
    err = ""
    assert(!sexec.SystemLinkExecExternalPackageRootsInto(
                wrongInstallRoot,
                lock,
                roots,
                handles,
                err),
           " compiler managed mirror locator: proof cid root accepted")

    let manifestAttackInstallRoot = strutil.Join(
        [installRoot, ".locator_manifest_source"],
        "")
    let manifestAttackRoot = cworld.CompilerManagedMirrorRoot(
        manifestAttackInstallRoot,
        bundle.channel,
        bundle.packageId,
        bundle.bundleCid)
    MirrorAtomicProvisionParent(chengpath.PathParentDir(manifestAttackRoot))
    MirrorAtomicWriteSourceManifestAttack(manifestAttackRoot,
                                          bundle.bundleCid,
                                          files)
    roots = []
    handles = []
    err = ""
    assert(!sexec.SystemLinkExecExternalPackageRootsInto(
                manifestAttackInstallRoot,
                lock,
                roots,
                handles,
                err),
           " compiler managed mirror locator: source/manifest drift accepted")

fn main(argc: int32, argv: str*): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    let workspaceRoot = chengpath.PathCurrentDir()
    let installRoot = MirrorAtomicInstallRoot()
    let mode = cmdline.ReadFlagOrDefault("--mode", "full")
    var bundle: cwlp.CompilerManagedMirrorBundle
    let bundleRes = MirrorAtomicBuildBundle(workspaceRoot, bundle)
    if IsErr(bundleRes):
        echo(Error(bundleRes))
    assert(IsOk(bundleRes),
           " compiler managed mirror atomic: build real bundle")
    if mode == "print-cid":
        echo(layout.FixedBytes32Hex(bundle.bundleCid))
        return 0
    var parent: str
    var finalRoot: str
    MirrorAtomicParentAndFinal(installRoot,
                               bundle,
                               parent,
                               finalRoot)
    if mode == "symlink-parent" || mode == "symlink-final":
        assert(IsErr(cwlp.CompilerWorldManagedMirrorMaterialize(
                         installRoot,
                         bundle)),
               " compiler managed mirror atomic: symlink accepted")
        echo("compiler_managed_mirror_atomic_symlink_ok")
        return 0
    MirrorAtomicProvisionParent(parent)
    if mode == "path-attack":
        bundle.units[0].modulePath = "../escape"
        assert(IsErr(cwlp.CompilerWorldManagedMirrorMaterialize(
                         installRoot,
                         bundle)),
               " compiler managed mirror atomic: path attack accepted")
        echo("compiler_managed_mirror_atomic_path_ok")
        return 0
    var files: cwlp.CompilerManagedMirrorMaterializedFile[]
    assert(IsOk(cwlp.CompilerWorldManagedMirrorMaterializedFiles(
                    bundle,
                    files)),
           " compiler managed mirror atomic: materialized manifest")
    if mode == "different":
        MirrorAtomicWriteExisting(finalRoot, files, true, false)
        assert(IsErr(cwlp.CompilerWorldManagedMirrorMaterialize(
                         installRoot,
                         bundle)),
               " compiler managed mirror atomic: different existing accepted")
    elif mode == "half":
        MirrorAtomicWriteExisting(finalRoot, files, false, true)
        assert(IsErr(cwlp.CompilerWorldManagedMirrorMaterialize(
                         installRoot,
                         bundle)),
               " compiler managed mirror atomic: half install accepted")
    else:
        let firstRes = cwlp.CompilerWorldManagedMirrorMaterialize(
            installRoot,
            bundle)
        assert(IsOk(firstRes) && Value(firstRes) == finalRoot,
               " compiler managed mirror atomic: first install")
        if mode == "extra":
            os.WriteFile(chengpath.PathJoin(finalRoot, "attacker-extra"),
                         "extra")
            assert(IsErr(cwlp.CompilerWorldManagedMirrorMaterialize(
                             installRoot,
                             bundle)),
                   " compiler managed mirror atomic: extra file accepted")
        elif mode == "tamper":
            os.WriteFile(chengpath.PathJoin(
                             finalRoot,
                             ".cheng-mirror/proof.txt"),
                         "tampered")
            assert(IsErr(cwlp.CompilerWorldManagedMirrorMaterialize(
                             installRoot,
                             bundle)),
                   " compiler managed mirror atomic: tamper accepted")
        else:
            assert(mode == "full",
                   " compiler managed mirror atomic: unknown mode")
            MirrorAtomicAssertSystemLinkLocator(
                installRoot,
                bundle,
                files)
            let secondRes = cwlp.CompilerWorldManagedMirrorMaterialize(
                installRoot,
                bundle)
            assert(IsOk(secondRes) && Value(secondRes) == finalRoot,
                   " compiler managed mirror atomic: identical existing")
    echo(strutil.Join(["compiler_managed_mirror_atomic_",
                       mode,
                       "_ok"], ""))
    return 0
