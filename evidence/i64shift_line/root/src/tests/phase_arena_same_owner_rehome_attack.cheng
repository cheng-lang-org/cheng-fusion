import cheng/core/ir/phase_arena as phase

fn main(): int32 =
    var store: phase.PhaseArenaStore
    phase.PhaseArenaStoreInit(store, 1, 32, 2)
    let arena = phase.PhaseArenaStoreOpenArena(store, 1, 32, 2)
    var region = phase.PhaseArenaStoreAllocRef(store, arena, 8)
    let survivor = phase.PhaseArenaStoreRehome(
        store, arena, region, arena)
    return phase.PhaseArenaStoreGetByte(store, arena, survivor, 0)
