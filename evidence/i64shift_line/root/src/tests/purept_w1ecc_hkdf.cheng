# W1-ECC pure-Cheng transport campaign: HKDF-SHA256 vectors (RFC 5869).
#
# Vector source: RFC 5869 Appendix A.1, A.2, A.3 (all three are SHA-256 per
# the RFC; the SHA-1 cases are A.4-A.7 and out of scope for this task),
# fetched verbatim from rfc-editor.org and hardcoded byte-identical.
# A.3 exercises the zero-length salt/info path (extract substitutes an
# all-zero HashLen salt per RFC 2104/5869).
#
# Exit code: 0 = PRK/OKM byte-exact for all three cases; 1 = any mismatch.

import std/system
import std/result
import std/rawbytes
import std/strutils as strutil
import std/strings
import cheng/std/crypto/hkdf

var w1eccFailures: int32

fn w1eccExpect(got: Bytes, wantHex: str, label: str) =
    if BytesEqual(got, BytesFromHex(wantHex)):
        echo(strutil.Join(["PASS ", label], ""))
    else:
        w1eccFailures = w1eccFailures + 1
        echo(strutil.Join(["FAIL ", label, " want=", wantHex, " got=", BytesToHex(got)], ""))

const
    # A.1
    w1eccA1Ikm = "0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b"
    w1eccA1Salt = "000102030405060708090a0b0c"
    w1eccA1Info = "f0f1f2f3f4f5f6f7f8f9"
    w1eccA1Prk = "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5"
    w1eccA1Okm = "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865"
    # A.2 (80-byte sequential inputs)
    w1eccA2Ikm = "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f"
    w1eccA2Salt = "606162636465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9fa0a1a2a3a4a5a6a7a8a9aaabacadaeaf"
    w1eccA2Info = "b0b1b2b3b4b5b6b7b8b9babbbcbdbebfc0c1c2c3c4c5c6c7c8c9cacbcccdcecfd0d1d2d3d4d5d6d7d8d9dadbdcdddedfe0e1e2e3e4e5e6e7e8e9eaebecedeeeff0f1f2f3f4f5f6f7f8f9fafbfcfdfeff"
    w1eccA2Prk = "06a6b88c5853361a06104c9ceb35b45cef760014904671014a193f40c15fc244"
    w1eccA2Okm = "b11e398dc80327a1c8e7f78c596a49344f012eda2d4efad8a050cc4c19afa97c59045a99cac7827271cb41c65e590e09da3275600c2f09b8367793a9aca3db71cc30c58179ec3e87c14c01d5c1f3434f1d87"
    # A.3 (zero-length salt/info)
    w1eccA3Ikm = "0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b"
    w1eccA3Prk = "19ef24a32c717b167f33a91d6f648bdf96596776afdb6377ac434c1c293ccb04"
    w1eccA3Okm = "8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d9d201395faa4b61a96c8"

fn main(): int32 =
    echo("purept_w1ecc_hkdf: HKDF-SHA256 RFC 5869 A.1-A.3")

    # A.1
    let a1Prk: Bytes = hkdf.hkdfExtractSha256(BytesFromHex(w1eccA1Ikm), BytesFromHex(w1eccA1Salt))
    w1eccExpect(a1Prk, w1eccA1Prk, "a1 prk")
    let a1OkmRes: Result[Bytes] = hkdf.hkdfExpandSha256(a1Prk, BytesFromHex(w1eccA1Info), 42)
    if IsOk(a1OkmRes):
        w1eccExpect(Value(a1OkmRes), w1eccA1Okm, "a1 okm")
    else:
        w1eccFailures = w1eccFailures + 1
        echo("FAIL a1 okm expand returned Err")

    # A.2
    let a2Prk: Bytes = hkdf.hkdfExtractSha256(BytesFromHex(w1eccA2Ikm), BytesFromHex(w1eccA2Salt))
    w1eccExpect(a2Prk, w1eccA2Prk, "a2 prk")
    let a2OkmRes: Result[Bytes] = hkdf.hkdfExpandSha256(a2Prk, BytesFromHex(w1eccA2Info), 82)
    if IsOk(a2OkmRes):
        w1eccExpect(Value(a2OkmRes), w1eccA2Okm, "a2 okm")
    else:
        w1eccFailures = w1eccFailures + 1
        echo("FAIL a2 okm expand returned Err")

    # A.3
    let a3Prk: Bytes = hkdf.hkdfExtractSha256(BytesFromHex(w1eccA3Ikm), EmptyBytes())
    w1eccExpect(a3Prk, w1eccA3Prk, "a3 prk")
    let a3OkmRes: Result[Bytes] = hkdf.hkdfExpandSha256(a3Prk, EmptyBytes(), 42)
    if IsOk(a3OkmRes):
        w1eccExpect(Value(a3OkmRes), w1eccA3Okm, "a3 okm")
    else:
        w1eccFailures = w1eccFailures + 1
        echo("FAIL a3 okm expand returned Err")

    echo(strutil.Join(["purept_w1ecc_hkdf failures=", strings.IntToStr(w1eccFailures)], ""))
    if w1eccFailures == 0:
        return 0
    return 1
