import std/strutils as strutil
import cheng/core/lang/parser
import cheng/core/lang/typed_expr_type_arena as typearena
import cheng/core/runtime/arena as arenamod
import cheng/std/bytes_layout as layout

fn TypeArenaPositiveSource(): str =
    return "type ScalarAlias = int32\ntype GroupedAlias = (((int32)))\ntype SeqAlias = int32[]\ntype FixedLiteralAlias = int32[4]\ntype FixedExprAlias = int32[1 + 3]\ntype BorrowAlias = var int32\ntype TupleAlias = tuple[left: int32, right: str]\ntype FunctionAlias = fn(value: int32): bool\ntype OptionalScalarAlias = int32?\ntype OptionalSeqAlias = int32[]?\n"

fn TypeArenaDeclarationRoot(
        tree: parser.ParserValueExprTree,
        name: str): int32 =
    for declarationRow in 0..<tree.declarationCount:
        if arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationKinds,
               declarationRow) !=
               Int32(parser.ParserDeclarationType):
            continue
        let nameToken = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationNameTokenIndexes,
            declarationRow)
        if parser.ParserValueExprTokenText(tree, nameToken) == name:
            return arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.declarationTypeSyntaxRootIndexes,
                declarationRow)
    return -1

fn TypeArenaBuildPositive(
        tree: var parser.ParserValueExprTree,
        arena: var typearena.TypedExprTypeArena) =
    var err: str
    var parsedTree: parser.ParserValueExprTree
    assert(parser.ParserValueExprReadTreeFromText(
               TypeArenaPositiveSource(), parsedTree, err),
           Fmt"typed expr type arena: parser failed {err}")
    let authority = typearena.TypedExprTypeResolutionAuthorityEmpty()
    var builtArena: typearena.TypedExprTypeArena
    assert(typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               parsedTree, authority, builtArena, err),
           Fmt"typed expr type arena: build failed {err}")
    assert(typearena.TypedExprTypeArenaStrictValidateInto(builtArena, err),
           Fmt"typed expr type arena: strict validate failed {err}")
    assert(typearena.TypedExprTypeArenaComplete(builtArena) &&
           typearena.TypedExprTypeArenaTypeCount(builtArena) > 0,
           "typed expr type arena: completed snapshot was not published")
    tree = parsedTree
    arena = builtArena

fn TypeArenaPositive() =
    var tree: parser.ParserValueExprTree
    var arena: typearena.TypedExprTypeArena
    TypeArenaBuildPositive(tree, arena)
    var scalarTypeId: int32 = -1
    var literalFixedTypeId: int32 = -1
    var exprFixedTypeId: int32 = -1
    var aliasCount: int32
    var sawSeq = false
    var sawBorrow = false
    var sawTuple = false
    var sawFunction = false
    var groupedCount: int32
    var optionalCount: int32
    var optionalRow: int32 = -1
    var optionalRows: int32[]
    for row in 0..<tree.typeSyntaxCount:
        let parserKind = parser.ParserValueExprTypeSyntaxKindAt(tree, row)
        let typeId = typearena.TypedExprTypeArenaTypeIdForTypeSyntax(arena, row)
        if parserKind == parser.ParserTypeSyntaxNominal &&
           parser.ParserValueExprTokenText(
               tree,
               parser.ParserValueExprTypeSyntaxNameTokenAt(tree, row)) ==
               "int32":
            if scalarTypeId < 0:
                scalarTypeId = typeId
            else:
                assert(scalarTypeId == typeId,
                       "typed expr type arena: scalar TypeId was not interned")
        elif parserKind == parser.ParserTypeSyntaxFixedArray:
            literalFixedTypeId = typeId
            assert(typearena.TypedExprTypeArenaFixedLengthAt(arena, typeId) == 4,
                   "typed expr type arena: literal fixed length drift")
        elif parserKind == parser.ParserTypeSyntaxBracketApply:
            exprFixedTypeId = typeId
            assert(typearena.TypedExprTypeArenaKindAt(arena, typeId) ==
                       typearena.TypedExprStructuralTypeFixedArray &&
                   typearena.TypedExprTypeArenaFixedLengthAt(arena, typeId) == 4,
                   "typed expr type arena: const AST did not produce FixedArray")
        elif parserKind == parser.ParserTypeSyntaxSeq:
            sawSeq = true
            assert(typearena.TypedExprTypeArenaManagedAt(arena, typeId) &&
                   !typearena.TypedExprTypeArenaSendAt(arena, typeId) &&
                   !typearena.TypedExprTypeArenaSyncAt(arena, typeId) &&
                   typearena.TypedExprTypeArenaTraitRuleAt(arena, typeId) ==
                       typearena.TypedExprTypeTraitRuleLocalSequence,
                   "typed expr type arena: sequence trait rule drift")
            assert(typearena.TypedExprTypeArenaTraitPremiseCountAt(
                       arena, typeId) == 1 &&
                   typearena.TypedExprTypeArenaTraitPremiseTypeIdAt(
                       arena, typeId, 0) < typeId,
                   "typed expr type arena: sequence premise CSR drift")
        elif parserKind == parser.ParserTypeSyntaxVarBorrow:
            sawBorrow = true
            assert(!typearena.TypedExprTypeArenaManagedAt(arena, typeId) &&
                   !typearena.TypedExprTypeArenaSendAt(arena, typeId) &&
                   !typearena.TypedExprTypeArenaSyncAt(arena, typeId),
                   "typed expr type arena: borrowed trait drift")
        elif parserKind == parser.ParserTypeSyntaxGrouped:
            groupedCount = groupedCount + 1
            let child = parser.ParserValueExprTypeSyntaxChildAt(tree, row, 0)
            assert(parser.ParserValueExprTypeSyntaxChildCountAt(tree, row) ==
                       1 &&
                   child >= 0 && child < row &&
                   typeId ==
                       typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
                           arena, child),
                   "typed expr type arena: grouped semantic identity drift")
        elif parserKind == parser.ParserTypeSyntaxTuple:
            sawTuple = true
            assert(typearena.TypedExprTypeArenaManagedAt(arena, typeId) &&
                   !typearena.TypedExprTypeArenaSendAt(arena, typeId) &&
                   !typearena.TypedExprTypeArenaSyncAt(arena, typeId),
                   "typed expr type arena: tuple premise derivation drift")
        elif parserKind == parser.ParserTypeSyntaxFunction:
            sawFunction = true
            assert(!typearena.TypedExprTypeArenaManagedAt(arena, typeId) &&
                   typearena.TypedExprTypeArenaSendAt(arena, typeId) &&
                   typearena.TypedExprTypeArenaSyncAt(arena, typeId),
                   "typed expr type arena: function trait rule drift")
        elif parserKind == parser.ParserTypeSyntaxOptional:
            optionalCount = optionalCount + 1
            optionalRow = row
            add(optionalRows, row)
            let child = parser.ParserValueExprTypeSyntaxChildAt(tree, row, 0)
            let childTypeId =
                typearena.TypedExprTypeArenaTypeIdForTypeSyntax(arena, child)
            assert(typearena.TypedExprTypeArenaKindAt(arena, typeId) ==
                       typearena.TypedExprStructuralTypeOptional &&
                   typearena.TypedExprTypeArenaTraitRuleAt(arena, typeId) ==
                       typearena.TypedExprTypeTraitRuleOptionalRecursive &&
                   typearena.TypedExprTypeArenaTraitPremiseCountAt(
                       arena, typeId) == 1 &&
                   typearena.TypedExprTypeArenaTraitPremiseTypeIdAt(
                       arena, typeId, 0) == childTypeId &&
                   arenamod.ArenaArrayInt32Get(
                       arena.arena,
                       arena.typeSyntaxQuestionTokenIndexes,
                       row) ==
                       parser.ParserValueExprTypeSyntaxQuestionTokenAt(
                           tree, row) &&
                   typearena.TypedExprTypeArenaManagedAt(arena, typeId) ==
                       typearena.TypedExprTypeArenaManagedAt(
                           arena, childTypeId) &&
                   typearena.TypedExprTypeArenaSendAt(arena, typeId) ==
                       typearena.TypedExprTypeArenaSendAt(
                           arena, childTypeId) &&
                   typearena.TypedExprTypeArenaSyncAt(arena, typeId) ==
                       typearena.TypedExprTypeArenaSyncAt(
                           arena, childTypeId),
                   "typed expr type arena: optional structural proof drift")
        elif parserKind == parser.ParserTypeSyntaxAlias:
            aliasCount = aliasCount + 1
            assert(typearena.TypedExprTypeArenaTraitRuleAt(arena, typeId) ==
                       typearena.TypedExprTypeTraitRuleAliasForward,
                   "typed expr type arena: alias premise rule missing")
    assert(scalarTypeId >= 0 && literalFixedTypeId >= 0 &&
           exprFixedTypeId >= 0 && literalFixedTypeId == exprFixedTypeId &&
           aliasCount == 10 && groupedCount == 3 && optionalCount == 2 &&
           optionalRow >= 0 && optionalRows.len == 2 &&
           sawSeq && sawBorrow && sawTuple && sawFunction,
           "typed expr type arena: structural coverage incomplete")
    for typeId in 0..<arena.typeCount:
        let originKind = arenamod.ArenaArrayInt32Get(
            arena.arena, arena.typeOriginKinds, typeId)
        var expectedProducerSourceIndex: int32 = -1
        if originKind !=
               int32(typearena.TypedExprTypeOriginSemanticBuiltin):
            expectedProducerSourceIndex = 0
        assert(arenamod.ArenaArrayInt32Get(
                   arena.arena,
                   arena.originProducerSourceIndexes,
                   typeId) == expectedProducerSourceIndex,
               "typed expr type arena: producer source edge drift")
    var err: str
    var questionTamper = typearena.TypedExprTypeArenaClone(arena)
    let forgedQuestionToken = arenamod.ArenaArrayInt32Get(
        questionTamper.arena,
        questionTamper.typeSyntaxQuestionTokenIndexes,
        optionalRows[1])
    arenamod.ArenaArrayInt32Set(
        questionTamper.arena,
        questionTamper.typeSyntaxQuestionTokenIndexes,
        optionalRows[0],
        forgedQuestionToken)
    questionTamper.artifactRaw32 =
        typearena.TypedExprTypeArenaArtifactCidForCurrentState(
            questionTamper)
    assert(!typearena.TypedExprTypeArenaStrictValidateInto(
               questionTamper, err) &&
           strutil.Contains(err, "optional origin authority drift"),
           "typed expr type arena: recomputed-CID optional token drift survived")
    typearena.TypedExprTypeArenaRelease(questionTamper)
    arenamod.ArenaArrayInt32Set(
        arena.arena, arena.fixedLengths, exprFixedTypeId, 5)
    assert(!typearena.TypedExprTypeArenaStrictValidateInto(arena, err) &&
           strutil.Contains(err, "artifact CID mismatch"),
           "typed expr type arena: structurally valid CID tamper survived")
    typearena.TypedExprTypeArenaRelease(arena)
    parser.ParserValueExprTreeRelease(tree)
    echo("typed_expr_type_arena_structural=1")
    echo("typed_expr_type_arena_trait_premises=1")
    echo("typed_expr_type_arena_cid_tamper=1")
    echo("typed_expr_type_arena_optional_exact=1")
    echo("typed_expr_type_arena_grouped_exact=1")
    echo("typed_expr_type_arena_optional_recomputed_cid_mutation=1")

fn TypeArenaDeterministic() =
    var firstTree: parser.ParserValueExprTree
    var secondTree: parser.ParserValueExprTree
    var first: typearena.TypedExprTypeArena
    var second: typearena.TypedExprTypeArena
    TypeArenaBuildPositive(firstTree, first)
    TypeArenaBuildPositive(secondTree, second)
    assert(layout.FixedBytes32Equal(first.artifactRaw32, second.artifactRaw32),
           "typed expr type arena: identical parser snapshot CID drift")
    typearena.TypedExprTypeArenaRelease(second)
    typearena.TypedExprTypeArenaRelease(first)
    parser.ParserValueExprTreeRelease(secondTree)
    parser.ParserValueExprTreeRelease(firstTree)
    echo("typed_expr_type_arena_deterministic=1")

fn TypeArenaBracketAuthorityNegative() =
    let source = "type Bad = int32[Missing]\n"
    var tree: parser.ParserValueExprTree
    var err: str
    assert(parser.ParserValueExprReadTreeFromText(source, tree, err),
           Fmt"typed expr type arena: negative parser failed {err}")
    var bracketNode: int32 = -1
    for row in 0..<tree.typeSyntaxCount:
        if parser.ParserValueExprTypeSyntaxKindAt(tree, row) ==
               parser.ParserTypeSyntaxBracketApply:
            bracketNode = row
    assert(bracketNode >= 0 &&
           parser.ParserValueExprTypeSyntaxBracketArgTypeNodeAt(
               tree, bracketNode, 0) >= 0,
           "typed expr type arena: ambiguous identifier was not preserved as exact TypeSyntax")
    var arena: typearena.TypedExprTypeArena
    let authority = typearena.TypedExprTypeResolutionAuthorityEmpty()
    assert(!typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               tree, authority, arena, err) &&
           strutil.Contains(err, "bracket apply authority incomplete") &&
           arena == nil,
           "typed expr type arena: unresolved BracketApply survived")
    parser.ParserValueExprTreeRelease(tree)
    echo("typed_expr_type_arena_bracket_hard_fail=1")

fn TypeArenaExactGenericApply() =
    let source =
        "type Pair[T, U] = int32\ntype Use = Pair[int32, str]\n"
    var tree: parser.ParserValueExprTree
    var err: str
    assert(parser.ParserValueExprReadTreeFromText(source, tree, err),
           Fmt"typed expr type arena: symbol parser failed {err}")
    var pairRoot: int32 = -1
    var pairUseNode: int32 = -1
    var applyNode: int32 = -1
    for row in 0..<tree.typeSyntaxCount:
        if parser.ParserValueExprTypeSyntaxRootKindAt(tree, row) ==
               parser.ParserTypeSyntaxRootTypeDeclarationRhs &&
           parser.ParserValueExprTokenText(
               tree,
               parser.ParserValueExprTypeSyntaxDeclarationOwnerTokenAt(
                   tree, row)) == "Pair":
            pairRoot = row
        if parser.ParserValueExprTypeSyntaxKindAt(tree, row) ==
               parser.ParserTypeSyntaxNominal &&
           parser.ParserValueExprTokenText(
               tree,
               parser.ParserValueExprTypeSyntaxNameTokenAt(tree, row)) ==
               "Pair":
            pairUseNode = row
        if parser.ParserValueExprTypeSyntaxKindAt(tree, row) ==
               parser.ParserTypeSyntaxBracketApply:
            applyNode = row
    assert(pairRoot >= 0 && pairUseNode > pairRoot &&
           applyNode > pairUseNode &&
           parser.ParserValueExprTypeSyntaxBracketArgCountAt(
               tree, applyNode) == 2 &&
           parser.ParserValueExprTypeSyntaxBracketArgTypeNodeAt(
               tree, applyNode, 0) ==
               parser.ParserValueExprTypeSyntaxChildAt(tree, applyNode, 1) &&
           parser.ParserValueExprTypeSyntaxBracketArgTypeNodeAt(
               tree, applyNode, 1) ==
               parser.ParserValueExprTypeSyntaxChildAt(tree, applyNode, 2),
           "typed expr type arena: exact symbol fixture missing")
    var authority: typearena.TypedExprTypeResolutionAuthority
    add(authority.typeSyntaxNodeIndexes, pairUseNode)
    add(authority.declarationRootTypeSyntaxNodeIndexes, pairRoot)
    authority.sealed = true
    var arena: typearena.TypedExprTypeArena
    assert(typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               tree, authority, arena, err),
           Fmt"typed expr type arena: exact generic apply failed {err}")
    let pairTypeId = typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
        arena, pairRoot)
    let applyTypeId = typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
        arena, applyNode)
    let firstArgumentTypeSyntaxNode =
        parser.ParserValueExprTypeSyntaxBracketArgTypeNodeAt(
            tree, applyNode, 0)
    let secondArgumentTypeSyntaxNode =
        parser.ParserValueExprTypeSyntaxBracketArgTypeNodeAt(
            tree, applyNode, 1)
    assert(typearena.TypedExprTypeArenaKindAt(arena, applyTypeId) ==
               typearena.TypedExprStructuralTypeApply &&
           typearena.TypedExprTypeArenaSymbolIdAt(arena, applyTypeId) ==
               typearena.TypedExprTypeArenaSymbolIdAt(arena, pairTypeId) &&
           typearena.TypedExprTypeArenaTraitRuleAt(arena, applyTypeId) ==
               typearena.TypedExprTypeTraitRuleGenericApplication &&
           typearena.TypedExprTypeArenaTraitPremiseCountAt(
               arena, applyTypeId) == 3 &&
           typearena.TypedExprTypeArenaTraitPremiseTypeIdAt(
               arena, applyTypeId, 0) == pairTypeId &&
           typearena.TypedExprTypeArenaTraitPremiseTypeIdAt(
               arena, applyTypeId, 1) ==
               typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
                   arena, firstArgumentTypeSyntaxNode) &&
           typearena.TypedExprTypeArenaTraitPremiseTypeIdAt(
               arena, applyTypeId, 2) ==
               typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
                   arena, secondArgumentTypeSyntaxNode),
           "typed expr type arena: exact generic Apply identity drift")
    parser.ParserValueExprTreeRelease(tree)
    assert(typearena.TypedExprTypeArenaStrictValidateInto(arena, err),
           Fmt"typed expr type arena: detached generic Apply invalid {err}")
    let pairSymbolId = typearena.TypedExprTypeArenaSymbolIdAt(
        arena, pairTypeId)
    let wrongSymbolId = pairSymbolId == 0 ? 1 : 0
    assert(arena.symbolCount >= 2,
           "typed expr type arena: resolution tamper fixture missing")
    arenamod.ArenaArrayInt32Set(
        arena.arena, arena.resolutionTargetSymbolIds, 0, wrongSymbolId)
    assert(!typearena.TypedExprTypeArenaStrictValidateInto(arena, err) &&
           strutil.Contains(err, "generic declaration authority drift"),
           "typed expr type arena: generic resolution SymbolId tamper survived")
    arenamod.ArenaArrayInt32Set(
        arena.arena, arena.resolutionTargetSymbolIds, 0, pairSymbolId)
    assert(typearena.TypedExprTypeArenaStrictValidateInto(arena, err),
           Fmt"typed expr type arena: restored resolution invalid {err}")
    arenamod.ArenaArrayInt32Set(
        arena.arena,
        arena.bracketArgTypeSyntaxNodeIndexes,
        0,
        secondArgumentTypeSyntaxNode)
    arenamod.ArenaArrayInt32Set(
        arena.arena,
        arena.bracketArgTypeSyntaxNodeIndexes,
        1,
        firstArgumentTypeSyntaxNode)
    assert(!typearena.TypedExprTypeArenaStrictValidateInto(arena, err) &&
           strutil.Contains(err, "generic argument TypeId drift"),
           "typed expr type arena: generic argument receipt tamper survived")
    typearena.TypedExprTypeArenaRelease(arena)
    echo("typed_expr_type_arena_generic_apply=1")
    echo("typed_expr_type_arena_generic_resolution_tamper=1")
    echo("typed_expr_type_arena_generic_apply_tamper=1")

fn TypeArenaGenericArityNegative() =
    let sources = [
        "type Pair[T, U] = int32\ntype Bad = Pair[int32]\n",
        "type Pair[T, U] = int32\ntype Bad = Pair[int32, 1 + 3]\n"
    ]
    for sourceIndex in 0..<sources.len:
        var tree: parser.ParserValueExprTree
        var err: str
        assert(parser.ParserValueExprReadTreeFromText(
                   sources[sourceIndex], tree, err),
               Fmt"typed expr type arena: generic arity parser failed {err}")
        var pairRoot: int32 = -1
        var pairUseNode: int32 = -1
        var applyNode: int32 = -1
        for row in 0..<tree.typeSyntaxCount:
            if parser.ParserValueExprTypeSyntaxRootKindAt(tree, row) ==
                   parser.ParserTypeSyntaxRootTypeDeclarationRhs &&
               parser.ParserValueExprTokenText(
                   tree,
                   parser.ParserValueExprTypeSyntaxDeclarationOwnerTokenAt(
                       tree, row)) == "Pair":
                pairRoot = row
            if parser.ParserValueExprTypeSyntaxKindAt(tree, row) ==
                   parser.ParserTypeSyntaxNominal &&
               parser.ParserValueExprTokenText(
                   tree,
                   parser.ParserValueExprTypeSyntaxNameTokenAt(tree, row)) ==
                   "Pair":
                pairUseNode = row
            if parser.ParserValueExprTypeSyntaxKindAt(tree, row) ==
                   parser.ParserTypeSyntaxBracketApply:
                applyNode = row
        assert(pairRoot >= 0 && pairUseNode > pairRoot &&
               applyNode > pairUseNode,
               "typed expr type arena: generic arity fixture missing")
        if sourceIndex == 1:
            assert(parser.ParserValueExprTypeSyntaxBracketArgTypeNodeAt(
                       tree, applyNode, 0) >= 0 &&
                   parser.ParserValueExprTypeSyntaxBracketArgTypeNodeAt(
                       tree, applyNode, 1) == -1,
                   "typed expr type arena: mixed type/const fixture drift")
        var authority: typearena.TypedExprTypeResolutionAuthority
        add(authority.typeSyntaxNodeIndexes, pairUseNode)
        add(authority.declarationRootTypeSyntaxNodeIndexes, pairRoot)
        authority.sealed = true
        var arena: typearena.TypedExprTypeArena
        assert(!typearena.TypedExprTypeArenaBuildFromParserTreeInto(
                   tree, authority, arena, err) &&
               strutil.Contains(
                   err, "generic application arity authority mismatch") &&
               arena == nil,
               "typed expr type arena: wrong or mixed generic arity survived")
        parser.ParserValueExprTreeRelease(tree)
    echo("typed_expr_type_arena_generic_arity_hard_fail=1")
    echo("typed_expr_type_arena_generic_mixed_hard_fail=1")

fn TypeArenaNestedGenericApply() =
    let source =
        "type Pair[T, U] = int32\ntype Box[V] = str\ntype Use = Pair[Box[int32], uint8[2 + 2]]\n"
    var tree: parser.ParserValueExprTree
    var err: str
    assert(parser.ParserValueExprReadTreeFromText(source, tree, err),
           Fmt"typed expr type arena: nested parser failed {err}")
    var pairRoot: int32 = -1
    var boxRoot: int32 = -1
    var pairUse: int32 = -1
    var boxUse: int32 = -1
    var pairApply: int32 = -1
    var boxApply: int32 = -1
    var arrayApply: int32 = -1
    for row in 0..<tree.typeSyntaxCount:
        let kind = parser.ParserValueExprTypeSyntaxKindAt(tree, row)
        let rootKind = parser.ParserValueExprTypeSyntaxRootKindAt(tree, row)
        if rootKind == parser.ParserTypeSyntaxRootTypeDeclarationRhs:
            let ownerToken =
                parser.ParserValueExprTypeSyntaxDeclarationOwnerTokenAt(
                    tree, row)
            let ownerName = parser.ParserValueExprTokenText(tree, ownerToken)
            if ownerName == "Pair": pairRoot = row
            if ownerName == "Box": boxRoot = row
        if kind == parser.ParserTypeSyntaxNominal:
            let nameToken = parser.ParserValueExprTypeSyntaxNameTokenAt(
                tree, row)
            let name = parser.ParserValueExprTokenText(tree, nameToken)
            if name == "Pair": pairUse = row
            if name == "Box": boxUse = row
        if kind == parser.ParserTypeSyntaxBracketApply:
            let baseNode = parser.ParserValueExprTypeSyntaxChildAt(
                tree, row, 0)
            let baseNameToken = parser.ParserValueExprTypeSyntaxNameTokenAt(
                tree, baseNode)
            let baseName = parser.ParserValueExprTokenText(
                tree, baseNameToken)
            if baseName == "Pair": pairApply = row
            if baseName == "Box": boxApply = row
            if baseName == "uint8": arrayApply = row
    assert(pairRoot >= 0 && boxRoot >= 0 && pairUse >= 0 && boxUse >= 0 &&
           pairApply >= 0 && boxApply >= 0 && arrayApply >= 0,
           "typed expr type arena: nested fixture incomplete")
    var authority: typearena.TypedExprTypeResolutionAuthority
    if pairUse < boxUse:
        add(authority.typeSyntaxNodeIndexes, pairUse)
        add(authority.declarationRootTypeSyntaxNodeIndexes, pairRoot)
        add(authority.typeSyntaxNodeIndexes, boxUse)
        add(authority.declarationRootTypeSyntaxNodeIndexes, boxRoot)
    else:
        add(authority.typeSyntaxNodeIndexes, boxUse)
        add(authority.declarationRootTypeSyntaxNodeIndexes, boxRoot)
        add(authority.typeSyntaxNodeIndexes, pairUse)
        add(authority.declarationRootTypeSyntaxNodeIndexes, pairRoot)
    authority.sealed = true
    var arena: typearena.TypedExprTypeArena
    assert(typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               tree, authority, arena, err),
           Fmt"typed expr type arena: nested build failed {err}")
    let pairTypeId = typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
        arena, pairRoot)
    let boxTypeId = typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
        arena, boxRoot)
    let pairApplyTypeId = typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
        arena, pairApply)
    let boxApplyTypeId = typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
        arena, boxApply)
    let arrayTypeId = typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
        arena, arrayApply)
    assert(typearena.TypedExprTypeArenaKindAt(arena, pairApplyTypeId) ==
               typearena.TypedExprStructuralTypeApply &&
           typearena.TypedExprTypeArenaKindAt(arena, boxApplyTypeId) ==
               typearena.TypedExprStructuralTypeApply &&
           typearena.TypedExprTypeArenaKindAt(arena, arrayTypeId) ==
               typearena.TypedExprStructuralTypeFixedArray &&
           typearena.TypedExprTypeArenaFixedLengthAt(arena, arrayTypeId) == 4 &&
           typearena.TypedExprTypeArenaSymbolIdAt(arena, pairApplyTypeId) ==
               typearena.TypedExprTypeArenaSymbolIdAt(arena, pairTypeId) &&
           typearena.TypedExprTypeArenaSymbolIdAt(arena, boxApplyTypeId) ==
               typearena.TypedExprTypeArenaSymbolIdAt(arena, boxTypeId) &&
           typearena.TypedExprTypeArenaTraitPremiseTypeIdAt(
               arena, pairApplyTypeId, 1) == boxApplyTypeId &&
           typearena.TypedExprTypeArenaTraitPremiseTypeIdAt(
               arena, pairApplyTypeId, 2) == arrayTypeId,
           "typed expr type arena: nested ordered TypeId authority drift")
    parser.ParserValueExprTreeRelease(tree)
    assert(typearena.TypedExprTypeArenaStrictValidateInto(arena, err),
           Fmt"typed expr type arena: detached nested receipt invalid {err}")
    typearena.TypedExprTypeArenaRelease(arena)
    echo("typed_expr_type_arena_nested_generic_array=1")

fn TypeArenaGenericAuthorityTamper() =
    let source = "type Box[T, U] = int32\n"
    var tree: parser.ParserValueExprTree
    var err: str
    assert(parser.ParserValueExprReadTreeFromText(source, tree, err),
           Fmt"typed expr type arena: generic tamper parser failed {err}")
    assert(tree.typeGenericSymbolCount == 2,
           "typed expr type arena: generic tamper fixture missing")
    arenamod.ArenaArrayInt32Set(
        tree.arena,
        tree.typeGenericSymbolProducerSourceIndexes,
        0,
        tree.producerSourceCount)
    var arena: typearena.TypedExprTypeArena
    let authority = typearena.TypedExprTypeResolutionAuthorityEmpty()
    assert(!typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               tree, authority, arena, err) &&
           strutil.Contains(err, "generic symbol authority invalid") &&
           arena == nil,
           "typed expr type arena: generic producerSourceIndex tamper survived")
    parser.ParserValueExprTreeRelease(tree)
    echo("typed_expr_type_arena_generic_authority_tamper=1")

fn TypeArenaGenericReceiptTamper() =
    let source = "type Box[T] = int32\n"
    var tree: parser.ParserValueExprTree
    var err: str
    assert(parser.ParserValueExprReadTreeFromText(source, tree, err),
           Fmt"typed expr type arena: generic receipt parser failed {err}")
    var arena: typearena.TypedExprTypeArena
    let authority = typearena.TypedExprTypeResolutionAuthorityEmpty()
    assert(typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               tree, authority, arena, err),
           Fmt"typed expr type arena: generic receipt build failed {err}")
    parser.ParserValueExprTreeRelease(tree)
    assert(typearena.TypedExprTypeArenaStrictValidateInto(arena, err),
           Fmt"typed expr type arena: detached receipt invalid {err}")
    arenamod.ArenaArrayInt32Set(
        arena.arena, arena.genericSymbolOrdinals, 0, 1)
    assert(!typearena.TypedExprTypeArenaStrictValidateInto(arena, err) &&
           strutil.Contains(err, "generic origin CSR invalid"),
           "typed expr type arena: generic receipt tamper survived")
    typearena.TypedExprTypeArenaRelease(arena)
    echo("typed_expr_type_arena_generic_receipt_tamper=1")

fn TypeArenaGenericParameterExactOwner() =
    let source =
        "type Box[T] =\n    value: T\n\ntype Other[T] = int32\n\nfn ReadInt(value: Box[int32]): int32 =\n    return 1\n\nfn ReadStr(value: Box[str]): int32 =\n    return 2\n"
    var tree: parser.ParserValueExprTree
    var err: str
    assert(parser.ParserValueExprReadTreeFromText(source, tree, err),
           Fmt"typed expr type arena: generic owner parser failed {err}")
    var authority: typearena.TypedExprTypeResolutionAuthority
    assert(typearena.TypedExprTypeResolutionAuthorityBuildSameSourceInto(
               tree, authority, err),
           Fmt"typed expr type arena: generic owner authority failed {err}")
    assert(authority.genericTypeSyntaxNodeIndexes.len == 1 &&
           authority.genericSymbolRows.len == 1 &&
           authority.genericSymbolRows[0] == 0,
           "typed expr type arena: generic exact owner row missing")
    let genericUse = authority.genericTypeSyntaxNodeIndexes[0]
    var boxRoot: int32 = -1
    var applyNodes: int32[]
    for row in 0..<tree.typeSyntaxCount:
        if parser.ParserValueExprTypeSyntaxRootKindAt(tree, row) ==
               parser.ParserTypeSyntaxRootTypeDeclarationRhs &&
           parser.ParserValueExprTypeSyntaxGenericSymbolCountAt(
               tree, row) == 1 &&
           parser.ParserValueExprTypeSyntaxGenericSymbolStartAt(
               tree, row) == 0:
            boxRoot = row
        if parser.ParserValueExprTypeSyntaxKindAt(tree, row) ==
               parser.ParserTypeSyntaxBracketApply:
            add(applyNodes, row)
    assert(boxRoot >= 0 && applyNodes.len == 2,
           "typed expr type arena: generic specialization fixture missing")
    var arena: typearena.TypedExprTypeArena
    assert(typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               tree, authority, arena, err) &&
           typearena.TypedExprTypeArenaStrictValidateInto(arena, err),
           Fmt"typed expr type arena: generic exact owner build failed {err}")
    let genericTypeId =
        typearena.TypedExprTypeArenaTypeIdForTypeSyntax(arena, genericUse)
    assert(typearena.TypedExprTypeArenaKindAt(arena, genericTypeId) ==
               typearena.TypedExprStructuralTypeGenericParameter &&
           typearena.TypedExprTypeArenaTraitRuleAt(arena, genericTypeId) ==
               typearena.TypedExprTypeTraitRuleGenericParameter &&
           arenamod.ArenaArrayInt32Get(
               arena.arena, arena.genericSymbolIds, genericTypeId) == 0 &&
           arena.genericResolutionCount == 1 &&
           arenamod.ArenaArrayInt32Get(
               arena.arena,
               arena.genericResolutionTypeSyntaxNodeIndexes,
               0) == genericUse &&
           arenamod.ArenaArrayInt32Get(
               arena.arena,
               arena.genericResolutionTargetGenericSymbolRows,
               0) == 0,
           "typed expr type arena: generic resolution receipt drift")
    let firstApplyTypeId =
        typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
            arena, applyNodes[0])
    let secondApplyTypeId =
        typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
            arena, applyNodes[1])
    let firstManaged =
        typearena.TypedExprTypeArenaManagedAt(arena, firstApplyTypeId)
    let secondManaged =
        typearena.TypedExprTypeArenaManagedAt(arena, secondApplyTypeId)
    assert(firstManaged != secondManaged,
           "typed expr type arena: generic argument did not specialize managed trait")
    let unManagedApplyTypeId =
        firstManaged ? secondApplyTypeId : firstApplyTypeId
    assert(typearena.TypedExprTypeArenaSendAt(
               arena, unManagedApplyTypeId) &&
           typearena.TypedExprTypeArenaSyncAt(
               arena, unManagedApplyTypeId),
           "typed expr type arena: specialized scalar object trait drift")
    let applyChildStart = arenamod.ArenaArrayInt32Get(
        arena.arena, arena.childStarts, unManagedApplyTypeId)
    let specializedDeclarationTypeId = arenamod.ArenaArrayInt32Get(
        arena.arena, arena.childTypeIds, applyChildStart)
    let applyPremiseStart = arenamod.ArenaArrayInt32Get(
        arena.arena, arena.traitPremiseStarts, unManagedApplyTypeId)
    let unspecializedDeclarationTypeId =
        typearena.TypedExprTypeArenaTypeIdForTypeSyntax(arena, boxRoot)
    assert(specializedDeclarationTypeId !=
               unspecializedDeclarationTypeId,
           "typed expr type arena: specialized declaration TypeId missing")
    arenamod.ArenaArrayInt32Set(
        arena.arena,
        arena.childTypeIds,
        applyChildStart,
        unspecializedDeclarationTypeId)
    arenamod.ArenaArrayInt32Set(
        arena.arena,
        arena.traitPremiseTypeIds,
        applyPremiseStart,
        unspecializedDeclarationTypeId)
    assert(!typearena.TypedExprTypeArenaStrictValidateInto(arena, err) &&
           strutil.Contains(err, "generic specialization"),
           "typed expr type arena: unspecialized generic trait receipt survived")
    arenamod.ArenaArrayInt32Set(
        arena.arena,
        arena.childTypeIds,
        applyChildStart,
        specializedDeclarationTypeId)
    arenamod.ArenaArrayInt32Set(
        arena.arena,
        arena.traitPremiseTypeIds,
        applyPremiseStart,
        specializedDeclarationTypeId)
    assert(typearena.TypedExprTypeArenaStrictValidateInto(arena, err),
           Fmt"typed expr type arena: restored generic specialization invalid {err}")
    typearena.TypedExprTypeArenaRelease(arena)

    var forgedAuthority = authority
    forgedAuthority.genericSymbolRows[0] = 1
    var rejected: typearena.TypedExprTypeArena
    assert(!typearena.TypedExprTypeArenaBuildFromParserTreeInto(
                tree, forgedAuthority, rejected, err) &&
           strutil.Contains(err, "exact generic owner edge mismatch") &&
           rejected == nil,
           "typed expr type arena: forged generic owner survived")
    parser.ParserValueExprTreeRelease(tree)
    echo("typed_expr_type_arena_generic_exact_owner=1")
    echo("typed_expr_type_arena_generic_forged_owner_hard_fail=1")
    echo("typed_expr_type_arena_generic_trait_specialization=1")
    echo("typed_expr_type_arena_unspecialized_trait_hard_fail=1")

fn TypeArenaGenericConstraintDefaultExact() =
    let source =
        "type Box[T: int32 = int32] = T\n\ntype StrUse = str\n"
    var tree: parser.ParserValueExprTree
    var err: str
    assert(parser.ParserValueExprReadTreeFromText(source, tree, err),
           Fmt"typed expr type arena: generic constraint/default parser failed {err}")
    assert(tree.typeGenericSymbolCount == 1 &&
           tree.typeGenericSymbolChildCount == 2,
           "typed expr type arena: generic parameter producer count drift")
    let symbolRow: int32 = 0
    let constraintNode =
        parser.ParserValueExprTypeGenericSymbolConstraintTypeSyntaxNodeAt(
            tree, symbolRow)
    let defaultNode =
        parser.ParserValueExprTypeGenericSymbolDefaultTypeSyntaxNodeAt(
            tree, symbolRow)
    let ownerRoot =
        parser.ParserValueExprTypeGenericSymbolOwnerTypeSyntaxNodeAt(
            tree, symbolRow)
    let nameToken = parser.ParserValueExprTypeGenericSymbolNameTokenAt(
        tree, symbolRow)
    assert(parser.ParserValueExprTypeGenericSymbolProducerSourceIndexAt(
               tree, symbolRow) == 0 &&
           parser.ParserValueExprTokenText(tree, nameToken) == "T" &&
           parser.ParserValueExprTypeGenericSymbolSpanStartAt(
               tree, symbolRow) <=
               parser.ParserValueExprTokenStartAt(tree, nameToken) &&
           parser.ParserValueExprTypeGenericSymbolSpanEndAt(
               tree, symbolRow) >=
               parser.ParserValueExprTypeSyntaxSpanEndAt(tree, defaultNode) &&
           parser.ParserValueExprTypeGenericSymbolChildCountAt(
               tree, symbolRow) == 2 &&
           parser.ParserValueExprTypeGenericSymbolChildAt(
               tree, symbolRow, 0) == constraintNode &&
           parser.ParserValueExprTypeGenericSymbolChildAt(
               tree, symbolRow, 1) == defaultNode &&
           parser.ParserValueExprTypeSyntaxRootKindAt(
               tree, constraintNode) ==
               parser.ParserTypeSyntaxRootGenericConstraint &&
           parser.ParserValueExprTypeSyntaxRootKindAt(tree, defaultNode) ==
               parser.ParserTypeSyntaxRootGenericDefault &&
           parser.ParserValueExprTypeSyntaxRootKindAt(tree, ownerRoot) ==
               parser.ParserTypeSyntaxRootTypeDeclarationRhs &&
           parser.ParserValueExprTypeSyntaxGenericSymbolStartAt(
               tree, ownerRoot) == symbolRow &&
           parser.ParserValueExprTypeSyntaxGenericSymbolCountAt(
               tree, ownerRoot) == 1,
           "typed expr type arena: generic parser-owned authority drift")
    var forgedTree = parser.ParserValueExprTreeClone(tree)
    arenamod.ArenaArrayInt32Set(
        forgedTree.arena,
        forgedTree.typeGenericSymbolOwnerTypeSyntaxNodeIndexes,
        symbolRow,
        -1)
    assert(!parser.ParserValueExprTreeGenericSymbolsStrictValidateInto(
                forgedTree, err) &&
           strutil.Contains(err, "structured generic parameter owner missing"),
           "typed expr type arena: forged generic owner root survived parser receipt")
    parser.ParserValueExprTreeRelease(forgedTree)

    var authority: typearena.TypedExprTypeResolutionAuthority
    assert(typearena.TypedExprTypeResolutionAuthorityBuildSameSourceInto(
               tree, authority, err),
           Fmt"typed expr type arena: generic constraint/default authority failed {err}")
    var arena: typearena.TypedExprTypeArena
    assert(typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               tree, authority, arena, err) &&
           typearena.TypedExprTypeArenaStrictValidateInto(arena, err),
           Fmt"typed expr type arena: generic constraint/default build failed {err}")
    let constraintTypeId = arenamod.ArenaArrayInt32Get(
        arena.arena, arena.genericSymbolConstraintTypeIds, symbolRow)
    let defaultTypeId = arenamod.ArenaArrayInt32Get(
        arena.arena, arena.genericSymbolDefaultTypeIds, symbolRow)
    assert(constraintTypeId >= 0 &&
           constraintTypeId == defaultTypeId &&
           arenamod.ArenaArrayInt32Get(
               arena.arena,
               arena.genericSymbolOwnerTypeSyntaxNodeIndexes,
               symbolRow) == ownerRoot &&
           arenamod.ArenaArrayInt32Get(
               arena.arena,
               arena.genericSymbolConstraintTypeSyntaxNodeIndexes,
               symbolRow) == constraintNode &&
           arenamod.ArenaArrayInt32Get(
               arena.arena,
               arena.genericSymbolDefaultTypeSyntaxNodeIndexes,
               symbolRow) == defaultNode,
           "typed expr type arena: canonical generic constraint/default receipt missing")
    var strTypeId: int32 = -1
    for typeId in 0..<arena.typeCount:
        if typearena.TypedExprTypeArenaKindAt(arena, typeId) ==
               typearena.TypedExprStructuralTypeScalar &&
           arenamod.ArenaArrayInt32Get(
               arena.arena, arena.scalarKinds, typeId) ==
               Int32(typearena.TypedExprStructuralScalarStr):
            strTypeId = typeId
    assert(strTypeId >= 0 && strTypeId != constraintTypeId,
           "typed expr type arena: mutation scalar TypeId missing")
    let genericChildStart = arenamod.ArenaArrayInt32Get(
        arena.arena, arena.genericSymbolChildStarts, symbolRow)
    arenamod.ArenaArrayInt32Set(
        arena.arena, arena.typeSyntaxTypeIds, defaultNode, strTypeId)
    arenamod.ArenaArrayInt32Set(
        arena.arena,
        arena.genericSymbolDefaultTypeIds,
        symbolRow,
        strTypeId)
    arenamod.ArenaArrayInt32Set(
        arena.arena,
        arena.genericSymbolChildTypeIds,
        genericChildStart + 1,
        strTypeId)
    assert(!typearena.TypedExprTypeArenaStrictValidateInto(arena, err) &&
           strutil.Contains(
               err,
               "generic default does not satisfy exact constraint TypeId"),
           "typed expr type arena: default/constraint TypeId mutation survived")
    arenamod.ArenaArrayInt32Set(
        arena.arena,
        arena.typeSyntaxTypeIds,
        defaultNode,
        defaultTypeId)
    arenamod.ArenaArrayInt32Set(
        arena.arena,
        arena.genericSymbolDefaultTypeIds,
        symbolRow,
        defaultTypeId)
    arenamod.ArenaArrayInt32Set(
        arena.arena,
        arena.genericSymbolChildTypeIds,
        genericChildStart + 1,
        defaultTypeId)
    assert(typearena.TypedExprTypeArenaStrictValidateInto(arena, err),
           Fmt"typed expr type arena: restored generic receipt invalid {err}")
    typearena.TypedExprTypeArenaRelease(arena)
    parser.ParserValueExprTreeRelease(tree)

    let malformedSources = [
        "type MissingConstraint[T:] = T\n",
        "type MissingDefault[T =] = T\n"
    ]
    let malformedReasons = [
        "generic constraint type missing",
        "generic default type missing"
    ]
    for sourceIndex in 0..<malformedSources.len:
        var malformedTree: parser.ParserValueExprTree
        assert(!parser.ParserValueExprReadTreeFromText(
                    malformedSources[sourceIndex], malformedTree, err) &&
               strutil.Contains(err, malformedReasons[sourceIndex]) &&
               malformedTree == nil,
               "typed expr type arena: malformed generic type survived")

    var badTree: parser.ParserValueExprTree
    assert(parser.ParserValueExprReadTreeFromText(
               "type Bad[T: int32 = str] = T\n",
               badTree,
               err),
           Fmt"typed expr type arena: mismatched default parser failed {err}")
    var badAuthority: typearena.TypedExprTypeResolutionAuthority
    assert(typearena.TypedExprTypeResolutionAuthorityBuildSameSourceInto(
               badTree, badAuthority, err),
           Fmt"typed expr type arena: mismatched default authority failed {err}")
    var rejected: typearena.TypedExprTypeArena
    assert(!typearena.TypedExprTypeArenaBuildFromParserTreeInto(
                badTree, badAuthority, rejected, err) &&
           strutil.Contains(
               err,
               "generic default does not satisfy exact constraint TypeId") &&
           rejected == nil,
           "typed expr type arena: invalid default satisfied constraint")
    parser.ParserValueExprTreeRelease(badTree)
    echo("typed_expr_type_arena_generic_constraint_default_exact=1")
    echo("typed_expr_type_arena_generic_constraint_default_mutation=1")
    echo("typed_expr_type_arena_generic_owner_root_tamper=1")
    echo("typed_expr_type_arena_generic_missing_type_hard_fail=1")

fn TypeArenaGenericTrailingDefaultAdmission() =
    let source =
        "type Chain[A, B: A = A, C: B = B] = tuple[A, B, C]\ntype Wrap[A, B: A[] = A[]] = tuple[A, B]\n\ntype UseDefault = Chain[int32]\ntype UseExplicit = Chain[int32, int32]\ntype UseWrap = Wrap[int32]\ntype StrUse = str\n"
    var tree: parser.ParserValueExprTree
    var err: str
    assert(parser.ParserValueExprReadTreeFromText(source, tree, err),
           Fmt"typed expr type arena: trailing default parser failed {err}")
    var defaultApplyNode: int32 = -1
    for row in 0..<tree.typeSyntaxCount:
        if parser.ParserValueExprTypeSyntaxKindAt(tree, row) ==
               parser.ParserTypeSyntaxBracketApply &&
           parser.ParserValueExprTypeSyntaxBracketArgCountAt(tree, row) == 1:
            let baseNode = parser.ParserValueExprTypeSyntaxChildAt(
                tree, row, 0)
            let baseNameToken =
                parser.ParserValueExprTypeSyntaxNameTokenAt(
                    tree, baseNode)
            if baseNameToken >= 0 &&
               parser.ParserValueExprTokenText(tree, baseNameToken) ==
                   "Chain":
                defaultApplyNode = row
    assert(defaultApplyNode >= 0,
           "typed expr type arena: trailing default Apply fixture missing")
    let explicitTypeSyntaxNode =
        parser.ParserValueExprTypeSyntaxBracketArgTypeNodeAt(
            tree, defaultApplyNode, 0)
    var authority: typearena.TypedExprTypeResolutionAuthority
    assert(typearena.TypedExprTypeResolutionAuthorityBuildSameSourceInto(
               tree, authority, err),
           Fmt"typed expr type arena: trailing default authority failed {err}")
    var arena: typearena.TypedExprTypeArena
    assert(typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               tree, authority, arena, err) &&
           typearena.TypedExprTypeArenaStrictValidateInto(arena, err),
           Fmt"typed expr type arena: trailing default build failed {err}")
    let applyTypeId = typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
        arena, defaultApplyNode)
    let explicitTypeId = typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
        arena, explicitTypeSyntaxNode)
    let applyChildStart = arenamod.ArenaArrayInt32Get(
        arena.arena, arena.childStarts, applyTypeId)
    let applyPremiseStart = arenamod.ArenaArrayInt32Get(
        arena.arena, arena.traitPremiseStarts, applyTypeId)
    assert(typearena.TypedExprTypeArenaKindAt(arena, applyTypeId) ==
               typearena.TypedExprStructuralTypeApply &&
           arenamod.ArenaArrayInt32Get(
               arena.arena, arena.childCounts, applyTypeId) == 4 &&
           arenamod.ArenaArrayInt32Get(
               arena.arena,
               arena.childTypeIds,
               applyChildStart + 1) == explicitTypeId &&
           arenamod.ArenaArrayInt32Get(
               arena.arena,
               arena.childTypeIds,
               applyChildStart + 2) == explicitTypeId &&
           arenamod.ArenaArrayInt32Get(
               arena.arena,
               arena.childTypeIds,
               applyChildStart + 3) == explicitTypeId,
           "typed expr type arena: trailing default substitution vector drift")
    var strTypeId: int32 = -1
    for typeId in 0..<arena.typeCount:
        if typearena.TypedExprTypeArenaKindAt(arena, typeId) ==
               typearena.TypedExprStructuralTypeScalar &&
           arenamod.ArenaArrayInt32Get(
               arena.arena, arena.scalarKinds, typeId) ==
               Int32(typearena.TypedExprStructuralScalarStr):
            strTypeId = typeId
    assert(strTypeId >= 0 && strTypeId != explicitTypeId,
           "typed expr type arena: trailing default mutation TypeId missing")
    arenamod.ArenaArrayInt32Set(
        arena.arena,
        arena.childTypeIds,
        applyChildStart + 2,
        strTypeId)
    arenamod.ArenaArrayInt32Set(
        arena.arena,
        arena.traitPremiseTypeIds,
        applyPremiseStart + 2,
        strTypeId)
    assert(!typearena.TypedExprTypeArenaStrictValidateInto(arena, err) &&
           (strutil.Contains(err, "generic default") ||
            strutil.Contains(err, "generic constraint")),
           "typed expr type arena: trailing default receipt tamper survived")
    arenamod.ArenaArrayInt32Set(
        arena.arena,
        arena.childTypeIds,
        applyChildStart + 2,
        explicitTypeId)
    arenamod.ArenaArrayInt32Set(
        arena.arena,
        arena.traitPremiseTypeIds,
        applyPremiseStart + 2,
        explicitTypeId)
    assert(typearena.TypedExprTypeArenaStrictValidateInto(arena, err),
           Fmt"typed expr type arena: restored trailing default receipt invalid {err}")
    typearena.TypedExprTypeArenaRelease(arena)
    parser.ParserValueExprTreeRelease(tree)

    let invalidSources = [
        "type Exact[A, B: A = A] = tuple[A, B]\ntype Bad = Exact[int32, str]\n",
        "type BadDefault[A, B: A = str] = tuple[A, B]\ntype Bad = BadDefault[int32]\n",
        "type Forward[A = B, B = int32] = tuple[A, B]\n",
        "type Self[A = A] = A\n",
        "type Cycle[A = B, B = A] = tuple[A, B]\n",
        "type Hole[A = int32, B, C = int32] = tuple[A, B, C]\ntype Bad = Hole[int32]\n"
    ]
    let invalidReasons = [
        "generic actual argument does not satisfy substituted exact constraint TypeId",
        "generic default does not satisfy substituted exact constraint TypeId",
        "generic default forward/self dependency",
        "generic default forward/self dependency",
        "generic default forward/self dependency",
        "trailing default missing"
    ]
    for sourceIndex in 0..<invalidSources.len:
        var invalidTree: parser.ParserValueExprTree
        assert(parser.ParserValueExprReadTreeFromText(
                   invalidSources[sourceIndex], invalidTree, err),
               Fmt"typed expr type arena: invalid default parser failed {err}")
        var invalidAuthority: typearena.TypedExprTypeResolutionAuthority
        assert(typearena.TypedExprTypeResolutionAuthorityBuildSameSourceInto(
                   invalidTree, invalidAuthority, err),
               Fmt"typed expr type arena: invalid default authority failed {err}")
        var rejected: typearena.TypedExprTypeArena
        assert(!typearena.TypedExprTypeArenaBuildFromParserTreeInto(
                    invalidTree,
                    invalidAuthority,
                    rejected,
                    err) &&
               strutil.Contains(err, invalidReasons[sourceIndex]) &&
               rejected == nil,
               Fmt"typed expr type arena: invalid generic default survived index={sourceIndex} err={err}")
        parser.ParserValueExprTreeRelease(invalidTree)
    echo("typed_expr_type_arena_generic_trailing_default=1")
    echo("typed_expr_type_arena_generic_constraint_admission=1")
    echo("typed_expr_type_arena_generic_default_dependency_hard_fail=1")
    echo("typed_expr_type_arena_generic_default_receipt_tamper=1")

fn TypeArenaNestedGenericTraitSpecialization() =
    let source =
        "type Inner[T] =\n    value: T\n\ntype Outer[U] = Inner[U]\n\ntype UseInt = Outer[int32]\ntype UseStr = Outer[str]\n"
    var tree: parser.ParserValueExprTree
    var err: str
    assert(parser.ParserValueExprReadTreeFromText(source, tree, err),
           Fmt"typed expr type arena: nested specialization parser failed {err}")
    var authority: typearena.TypedExprTypeResolutionAuthority
    assert(typearena.TypedExprTypeResolutionAuthorityBuildSameSourceInto(
               tree, authority, err),
           Fmt"typed expr type arena: nested specialization authority failed {err}")
    var applyNodes: int32[]
    for row in 0..<tree.typeSyntaxCount:
        if parser.ParserValueExprTypeSyntaxKindAt(tree, row) ==
               parser.ParserTypeSyntaxBracketApply:
            add(applyNodes, row)
    assert(applyNodes.len == 3,
           Fmt"typed expr type arena: nested Apply producer rows missing count={applyNodes.len}")
    var arena: typearena.TypedExprTypeArena
    assert(typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               tree, authority, arena, err) &&
           typearena.TypedExprTypeArenaStrictValidateInto(arena, err),
           Fmt"typed expr type arena: nested specialization build failed {err}")
    var concreteApplyTypeIds: int32[]
    for applyIndex in 0..<applyNodes.len:
        let applyNode = applyNodes[applyIndex]
        let applyTypeId =
            typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
                arena, applyNode)
        let applyChildStart = arenamod.ArenaArrayInt32Get(
            arena.arena, arena.childStarts, applyTypeId)
        let argumentTypeId = arenamod.ArenaArrayInt32Get(
            arena.arena, arena.childTypeIds, applyChildStart + 1)
        if typearena.TypedExprTypeArenaKindAt(
               arena, argumentTypeId) !=
               typearena.TypedExprStructuralTypeGenericParameter:
            add(concreteApplyTypeIds, applyTypeId)
    assert(concreteApplyTypeIds.len == 2,
           Fmt"typed expr type arena: concrete Apply TypeIds missing count={concreteApplyTypeIds.len}")
    let firstTypeId = concreteApplyTypeIds[0]
    let secondTypeId = concreteApplyTypeIds[1]
    assert(typearena.TypedExprTypeArenaManagedAt(arena, firstTypeId) !=
               typearena.TypedExprTypeArenaManagedAt(arena, secondTypeId),
           "typed expr type arena: nested generic trait substitution drift")
    typearena.TypedExprTypeArenaRelease(arena)
    parser.ParserValueExprTreeRelease(tree)
    echo("typed_expr_type_arena_nested_generic_trait_specialization=1")

fn TypeArenaObjectEnumExact() =
    let source =
        "type Record =\n    id: int32\n    label: str\n    bytes: uint8[]\n\ntype Kind = enum\n    Alpha\n    Beta\n\ntype Heap = ref object\n    value: int32\n"
    var tree: parser.ParserValueExprTree
    var err: str
    assert(parser.ParserValueExprReadTreeFromText(source, tree, err),
           Fmt"typed expr type arena: object/enum parser failed {err}")
    var recordRoot: int32 = -1
    var enumRoot: int32 = -1
    var refObjectRoot: int32 = -1
    for row in 0..<tree.typeSyntaxCount:
        if parser.ParserValueExprTypeSyntaxRootKindAt(tree, row) !=
               parser.ParserTypeSyntaxRootTypeDeclarationRhs:
            continue
        let ownerName = parser.ParserValueExprTokenText(
            tree,
            parser.ParserValueExprTypeSyntaxDeclarationOwnerTokenAt(
                tree, row))
        if ownerName == "Record": recordRoot = row
        if ownerName == "Kind": enumRoot = row
        if ownerName == "Heap": refObjectRoot = row
    var recordFieldRows: int32[]
    var recordFieldTokens: int32[]
    var refObjectFieldRows: int32[]
    for row in 0..<tree.typeSyntaxCount:
        if parser.ParserValueExprTypeSyntaxRootKindAt(tree, row) !=
               parser.ParserTypeSyntaxRootFieldDeclaration:
            continue
        let owner = parser.ParserValueExprTypeSyntaxDeclarationOwnerAt(
            tree, row)
        if owner == recordRoot:
            add(recordFieldRows, row)
            add(recordFieldTokens,
                parser.ParserValueExprTypeSyntaxOwnerTokenAt(tree, row))
        elif owner == refObjectRoot:
            add(refObjectFieldRows, row)
    assert(recordRoot >= 0 && enumRoot >= 0 && refObjectRoot >= 0 &&
           recordFieldRows.len == 3 && refObjectFieldRows.len == 1 &&
           parser.ParserValueExprTypeSyntaxEnumVariantCountAt(
               tree, enumRoot) == 2,
           "typed expr type arena: object/enum fixture authority missing")
    let alphaToken =
        parser.ParserValueExprTypeSyntaxEnumVariantNameTokenAt(
            tree, enumRoot, 0)
    let betaToken =
        parser.ParserValueExprTypeSyntaxEnumVariantNameTokenAt(
            tree, enumRoot, 1)
    var arena: typearena.TypedExprTypeArena
    let authority = typearena.TypedExprTypeResolutionAuthorityEmpty()
    assert(typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               tree, authority, arena, err),
           Fmt"typed expr type arena: object/enum build failed {err}")
    let recordTypeId = typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
        arena, recordRoot)
    let enumTypeId = typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
        arena, enumRoot)
    let refObjectTypeId = typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
        arena, refObjectRoot)
    let recordSymbolId = typearena.TypedExprTypeArenaSymbolIdAt(
        arena, recordTypeId)
    let enumSymbolId = typearena.TypedExprTypeArenaSymbolIdAt(
        arena, enumTypeId)
    let refObjectSymbolId = typearena.TypedExprTypeArenaSymbolIdAt(
        arena, refObjectTypeId)
    let recordMemberStart = arenamod.ArenaArrayInt32Get(
        arena.arena, arena.symbolMemberStarts, recordSymbolId)
    let enumMemberStart = arenamod.ArenaArrayInt32Get(
        arena.arena, arena.symbolMemberStarts, enumSymbolId)
    assert(typearena.TypedExprTypeArenaKindAt(arena, recordTypeId) ==
               typearena.TypedExprStructuralTypeObject &&
           typearena.TypedExprTypeArenaTraitRuleAt(arena, recordTypeId) ==
               typearena.TypedExprTypeTraitRuleObjectFieldsRecursive &&
           typearena.TypedExprTypeArenaManagedAt(arena, recordTypeId) &&
           !typearena.TypedExprTypeArenaSendAt(arena, recordTypeId) &&
           !typearena.TypedExprTypeArenaSyncAt(arena, recordTypeId) &&
           typearena.TypedExprTypeArenaTraitPremiseCountAt(
               arena, recordTypeId) == 3 &&
           arenamod.ArenaArrayInt32Get(
               arena.arena, arena.symbolMemberCounts, recordSymbolId) == 3,
           "typed expr type arena: object premise proof drift")
    for fieldOffset in 0..<recordFieldRows.len:
        let memberRow = recordMemberStart + fieldOffset
        assert(arenamod.ArenaArrayInt32Get(
                   arena.arena,
                   arena.memberDeclarationSymbolIds,
                   memberRow) == recordSymbolId &&
               arenamod.ArenaArrayInt32Get(
                   arena.arena,
                   arena.memberNameTokenIndexes,
                   memberRow) == recordFieldTokens[fieldOffset] &&
               arenamod.ArenaArrayInt32Get(
                   arena.arena,
                   arena.memberOrdinals,
                   memberRow) == fieldOffset &&
               arenamod.ArenaArrayInt32Get(
                   arena.arena,
                   arena.memberTypeSyntaxNodeIndexes,
                   memberRow) == recordFieldRows[fieldOffset] &&
               arenamod.ArenaArrayInt32Get(
                   arena.arena,
                   arena.memberTypeIds,
                   memberRow) ==
                   typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
                       arena, recordFieldRows[fieldOffset]),
               "typed expr type arena: ordered object member drift")
    assert(typearena.TypedExprTypeArenaKindAt(arena, enumTypeId) ==
               typearena.TypedExprStructuralTypeEnum &&
           typearena.TypedExprTypeArenaTraitRuleAt(arena, enumTypeId) ==
               typearena.TypedExprTypeTraitRuleEnumVariantsRecursive &&
           !typearena.TypedExprTypeArenaManagedAt(arena, enumTypeId) &&
           typearena.TypedExprTypeArenaSendAt(arena, enumTypeId) &&
           typearena.TypedExprTypeArenaSyncAt(arena, enumTypeId) &&
           typearena.TypedExprTypeArenaTraitPremiseCountAt(
               arena, enumTypeId) == 0 &&
           arenamod.ArenaArrayInt32Get(
               arena.arena, arena.symbolMemberCounts, enumSymbolId) == 2 &&
           arenamod.ArenaArrayInt32Get(
               arena.arena, arena.memberNameTokenIndexes, enumMemberStart) ==
               alphaToken &&
           arenamod.ArenaArrayInt32Get(
               arena.arena,
               arena.memberNameTokenIndexes,
               enumMemberStart + 1) == betaToken &&
           arenamod.ArenaArrayInt32Get(
               arena.arena,
               arena.memberTypeSyntaxNodeIndexes,
               enumMemberStart) == -1 &&
           arenamod.ArenaArrayInt32Get(
               arena.arena,
               arena.memberTypeIds,
               enumMemberStart) == -1,
           "typed expr type arena: enum explicit variant proof drift")
    assert(typearena.TypedExprTypeArenaKindAt(arena, refObjectTypeId) ==
               typearena.TypedExprStructuralTypeRefObject &&
           typearena.TypedExprTypeArenaTraitRuleAt(arena, refObjectTypeId) ==
               typearena.TypedExprTypeTraitRuleOwnedRefObject &&
           typearena.TypedExprTypeArenaManagedAt(arena, refObjectTypeId) &&
           !typearena.TypedExprTypeArenaSendAt(arena, refObjectTypeId) &&
           !typearena.TypedExprTypeArenaSyncAt(arena, refObjectTypeId) &&
           arenamod.ArenaArrayInt32Get(
               arena.arena,
               arena.symbolMemberCounts,
               refObjectSymbolId) == 1,
           "typed expr type arena: ref object premise proof drift")
    var duplicateFieldTree = parser.ParserValueExprTreeClone(tree)
    arenamod.ArenaArrayInt32Set(
        duplicateFieldTree.arena,
        duplicateFieldTree.typeSyntaxOwnerTokenIndexes,
        recordFieldRows[1],
        recordFieldTokens[0])
    var rejectedArena: typearena.TypedExprTypeArena
    assert(!typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               duplicateFieldTree, authority, rejectedArena, err) &&
           strutil.Contains(err, "duplicate object field name") &&
           rejectedArena == nil,
           "typed expr type arena: duplicate object field survived")
    parser.ParserValueExprTreeRelease(duplicateFieldTree)
    var enumAttackTree = parser.ParserValueExprTreeClone(tree)
    let firstVariantRow =
        parser.ParserValueExprTypeSyntaxEnumVariantRowAt(
            enumAttackTree, enumRoot, 0)
    arenamod.ArenaArrayInt32Set(
        enumAttackTree.arena,
        enumAttackTree.typeEnumVariantOrdinals,
        firstVariantRow,
        1)
    assert(!typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               enumAttackTree, authority, rejectedArena, err) &&
           strutil.Contains(err, "enum variant") && rejectedArena == nil,
           "typed expr type arena: parser enum authority tamper survived")
    parser.ParserValueExprTreeRelease(enumAttackTree)
    parser.ParserValueExprTreeRelease(tree)
    assert(typearena.TypedExprTypeArenaStrictValidateInto(arena, err),
           Fmt"typed expr type arena: detached object/enum invalid {err}")
    let firstFieldTypeId = arenamod.ArenaArrayInt32Get(
        arena.arena, arena.memberTypeIds, recordMemberStart)
    let secondFieldTypeId = arenamod.ArenaArrayInt32Get(
        arena.arena, arena.memberTypeIds, recordMemberStart + 1)
    arenamod.ArenaArrayInt32Set(
        arena.arena,
        arena.memberTypeIds,
        recordMemberStart,
        secondFieldTypeId)
    assert(!typearena.TypedExprTypeArenaStrictValidateInto(arena, err),
           "typed expr type arena: object field TypeId tamper survived")
    arenamod.ArenaArrayInt32Set(
        arena.arena,
        arena.memberTypeIds,
        recordMemberStart,
        firstFieldTypeId)
    arenamod.ArenaArrayInt32Set(
        arena.arena,
        arena.memberDeclarationSymbolIds,
        recordMemberStart,
        enumSymbolId)
    assert(!typearena.TypedExprTypeArenaStrictValidateInto(arena, err),
           "typed expr type arena: object SymbolId tamper survived")
    arenamod.ArenaArrayInt32Set(
        arena.arena,
        arena.memberDeclarationSymbolIds,
        recordMemberStart,
        recordSymbolId)
    arenamod.ArenaArrayInt32Set(
        arena.arena, arena.memberOrdinals, enumMemberStart + 1, 0)
    assert(!typearena.TypedExprTypeArenaStrictValidateInto(arena, err),
           "typed expr type arena: enum ordinal tamper survived")
    arenamod.ArenaArrayInt32Set(
        arena.arena, arena.memberOrdinals, enumMemberStart + 1, 1)
    arenamod.ArenaArrayInt32Set(
        arena.arena,
        arena.memberTypeSyntaxNodeIndexes,
        enumMemberStart,
        recordFieldRows[0])
    arenamod.ArenaArrayInt32Set(
        arena.arena,
        arena.memberTypeIds,
        enumMemberStart,
        firstFieldTypeId)
    assert(!typearena.TypedExprTypeArenaStrictValidateInto(arena, err),
           "typed expr type arena: enum payload tamper survived")
    typearena.TypedExprTypeArenaRelease(arena)
    echo("typed_expr_type_arena_object_exact=1")
    echo("typed_expr_type_arena_ref_object_exact=1")
    echo("typed_expr_type_arena_enum_exact=1")
    echo("typed_expr_type_arena_object_enum_tamper=1")

fn TypeArenaObjectEnumMultiSourceExact() =
    let firstSource =
        "type Same =\n    value: int32\n\ntype Choice = enum\n    Left\n    Right\n"
    let secondSource =
        "type Same =\n    value: str\n\ntype Choice = enum\n    Left\n    Right\n"
    var firstTree: parser.ParserValueExprTree
    var secondTree: parser.ParserValueExprTree
    var combined: parser.ParserValueExprTree
    var err: str
    assert(parser.ParserValueExprReadTreeFromText(
               firstSource, firstTree, err) &&
           parser.ParserValueExprReadTreeFromText(
               secondSource, secondTree, err),
           Fmt"typed expr type arena: multi-source aggregate parse failed {err}")
    parser.ParserValueExprTreeAppendFrom(combined, firstTree)
    parser.ParserValueExprTreeAppendFrom(combined, secondTree)
    parser.ParserValueExprTreeRelease(secondTree)
    parser.ParserValueExprTreeRelease(firstTree)
    var arena: typearena.TypedExprTypeArena
    let authority = typearena.TypedExprTypeResolutionAuthorityEmpty()
    assert(typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               combined, authority, arena, err),
           Fmt"typed expr type arena: multi-source aggregate build failed {err}")
    parser.ParserValueExprTreeRelease(combined)
    var objectSymbols: int32[]
    var enumSymbols: int32[]
    for symbolId in 0..<arena.symbolCount:
        let root = arenamod.ArenaArrayInt32Get(
            arena.arena,
            arena.symbolDeclarationRootTypeSyntaxNodeIndexes,
            symbolId)
        let parserKind = arenamod.ArenaArrayInt32Get(
            arena.arena, arena.typeSyntaxParserKinds, root)
        if parserKind == Int32(parser.ParserTypeSyntaxImplicitObject):
            add(objectSymbols, symbolId)
        elif parserKind == Int32(parser.ParserTypeSyntaxEnum):
            add(enumSymbols, symbolId)
    assert(objectSymbols.len == 2 && enumSymbols.len == 2 &&
           objectSymbols[0] != objectSymbols[1] &&
           enumSymbols[0] != enumSymbols[1] &&
           arenamod.ArenaArrayInt32Get(
               arena.arena,
               arena.symbolProducerSourceIndexes,
               objectSymbols[0]) == 0 &&
           arenamod.ArenaArrayInt32Get(
               arena.arena,
               arena.symbolProducerSourceIndexes,
               objectSymbols[1]) == 1,
           "typed expr type arena: same-name cross-source SymbolId collapsed")
    let objectMemberStart = arenamod.ArenaArrayInt32Get(
        arena.arena, arena.symbolMemberStarts, objectSymbols[0])
    arenamod.ArenaArrayInt32Set(
        arena.arena,
        arena.memberProducerSourceIndexes,
        objectMemberStart,
        1)
    assert(!typearena.TypedExprTypeArenaStrictValidateInto(arena, err),
           "typed expr type arena: cross-source object member survived")
    arenamod.ArenaArrayInt32Set(
        arena.arena,
        arena.memberProducerSourceIndexes,
        objectMemberStart,
        0)
    let enumMemberStart = arenamod.ArenaArrayInt32Get(
        arena.arena, arena.symbolMemberStarts, enumSymbols[0])
    arenamod.ArenaArrayInt32Set(
        arena.arena,
        arena.memberDeclarationSymbolIds,
        enumMemberStart,
        enumSymbols[1])
    assert(!typearena.TypedExprTypeArenaStrictValidateInto(arena, err),
           "typed expr type arena: cross-source enum SymbolId survived")
    typearena.TypedExprTypeArenaRelease(arena)
    echo("typed_expr_type_arena_object_enum_multi_source=1")
    echo("typed_expr_type_arena_object_enum_cross_source_tamper=1")

fn TypeArenaEmptyComplete() =
    let source = "fn NoTypes() =\n    echo(\"ok\")\n"
    var tree: parser.ParserValueExprTree
    var err: str
    assert(parser.ParserValueExprReadTreeFromText(source, tree, err),
           Fmt"typed expr type arena: empty parser failed {err}")
    var arena: typearena.TypedExprTypeArena
    var authority: typearena.TypedExprTypeResolutionAuthority
    assert(typearena.TypedExprTypeResolutionAuthorityBuildSameSourceInto(
               tree, authority, err) &&
           typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               tree, authority, arena, err) &&
           typearena.TypedExprTypeArenaComplete(arena) &&
           typearena.TypedExprTypeArenaStrictValidateInto(arena, err),
           Fmt"typed expr type arena: empty snapshot incomplete {err}")
    typearena.TypedExprTypeArenaRelease(arena)
    parser.ParserValueExprTreeRelease(tree)
    echo("typed_expr_type_arena_empty_complete=1")

fn TypeArenaMultiSourceExact() =
    let firstSource = "type First[T] = int32\n"
    let secondSource =
        "type Second[U] = str\ntype Use = First[int32]\ntype Callback = fn(value: int32): bool\n"
    var firstTree: parser.ParserValueExprTree
    var secondTree: parser.ParserValueExprTree
    var combined: parser.ParserValueExprTree
    var err: str
    assert(parser.ParserValueExprReadTreeFromText(
               firstSource, firstTree, err) &&
           parser.ParserValueExprReadTreeFromText(
               secondSource, secondTree, err),
           Fmt"typed expr type arena: multi-source parser failed {err}")
    parser.ParserValueExprTreeAppendFrom(combined, firstTree)
    parser.ParserValueExprTreeAppendFrom(combined, secondTree)
    parser.ParserValueExprTreeRelease(secondTree)
    parser.ParserValueExprTreeRelease(firstTree)
    assert(combined.producerSourceCount == 2 &&
           combined.typeGenericSymbolCount == 2,
           "typed expr type arena: multi-source producer rows missing")
    var firstRoot: int32 = -1
    var firstUse: int32 = -1
    var useApply: int32 = -1
    var firstSourceInt32: int32 = -1
    var secondSourceFunction: int32 = -1
    for row in 0..<combined.typeSyntaxCount:
        let nameToken = parser.ParserValueExprTypeSyntaxNameTokenAt(
            combined, row)
        if parser.ParserValueExprTypeSyntaxRootKindAt(combined, row) ==
               parser.ParserTypeSyntaxRootTypeDeclarationRhs &&
           parser.ParserValueExprTokenText(
               combined,
               parser.ParserValueExprTypeSyntaxDeclarationOwnerTokenAt(
                   combined, row)) == "First":
            firstRoot = row
        if parser.ParserValueExprTypeSyntaxKindAt(combined, row) ==
               parser.ParserTypeSyntaxNominal && nameToken >= 0 &&
           parser.ParserValueExprTypeSyntaxProducerSourceIndexAt(
               combined, row) == 0 &&
           parser.ParserValueExprTokenText(combined, nameToken) == "int32":
            firstSourceInt32 = row
        if parser.ParserValueExprTypeSyntaxKindAt(combined, row) ==
               parser.ParserTypeSyntaxNominal && nameToken >= 0 &&
           parser.ParserValueExprTypeSyntaxProducerSourceIndexAt(
               combined, row) == 1 &&
           parser.ParserValueExprTokenText(combined, nameToken) == "First":
            firstUse = row
        if parser.ParserValueExprTypeSyntaxKindAt(combined, row) ==
               parser.ParserTypeSyntaxBracketApply &&
           parser.ParserValueExprTypeSyntaxProducerSourceIndexAt(
               combined, row) == 1:
            useApply = row
        if parser.ParserValueExprTypeSyntaxKindAt(combined, row) ==
               parser.ParserTypeSyntaxFunction &&
           parser.ParserValueExprTypeSyntaxProducerSourceIndexAt(
               combined, row) == 1:
            secondSourceFunction = row
    assert(firstRoot >= 0 && firstSourceInt32 >= 0 &&
           firstUse > firstRoot && useApply > firstUse &&
           secondSourceFunction > useApply,
           "typed expr type arena: multi-source exact edge fixture missing")
    var authority: typearena.TypedExprTypeResolutionAuthority
    add(authority.typeSyntaxNodeIndexes, firstUse)
    add(authority.declarationRootTypeSyntaxNodeIndexes, firstRoot)
    authority.sealed = true
    var arena: typearena.TypedExprTypeArena
    assert(typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               combined, authority, arena, err),
           Fmt"typed expr type arena: multi-source build failed {err}")
    let firstTypeId = typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
        arena, firstRoot)
    let firstSymbolId = typearena.TypedExprTypeArenaSymbolIdAt(
        arena, firstTypeId)
    let useApplyTypeId = typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
        arena, useApply)
    let secondSourceFunctionTypeId =
        typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
            arena, secondSourceFunction)
    parser.ParserValueExprTreeRelease(combined)
    assert(typearena.TypedExprTypeArenaStrictValidateInto(arena, err) &&
           typearena.TypedExprTypeArenaKindAt(arena, useApplyTypeId) ==
               typearena.TypedExprStructuralTypeApply &&
           typearena.TypedExprTypeArenaSymbolIdAt(arena, useApplyTypeId) ==
               firstSymbolId &&
           typearena.TypedExprTypeArenaKindAt(
               arena, secondSourceFunctionTypeId) ==
               typearena.TypedExprStructuralTypeFunction &&
           arenamod.ArenaArrayInt32Get(
               arena.arena,
               arena.genericSymbolProducerSourceIndexes,
               0) == 0 &&
           arenamod.ArenaArrayInt32Get(
               arena.arena,
               arena.genericSymbolProducerSourceIndexes,
               1) == 1 &&
           arena.resolutionCount == 1 &&
           arenamod.ArenaArrayInt32Get(
               arena.arena,
               arena.resolutionTypeSyntaxNodeIndexes,
               0) == firstUse &&
           arenamod.ArenaArrayInt32Get(
               arena.arena,
               arena.resolutionTargetSymbolIds,
               0) == firstSymbolId,
           Fmt"typed expr type arena: multi-source receipt drift {err}")
    let bracketArgStart = arenamod.ArenaArrayInt32Get(
        arena.arena, arena.typeSyntaxBracketArgStarts, useApply)
    arenamod.ArenaArrayInt32Set(
        arena.arena,
        arena.bracketArgTypeSyntaxNodeIndexes,
        bracketArgStart,
        firstSourceInt32)
    assert(!typearena.TypedExprTypeArenaStrictValidateInto(arena, err) &&
           strutil.Contains(err, "bracket argument origin invalid"),
           "typed expr type arena: cross-source generic argument tamper survived")
    typearena.TypedExprTypeArenaRelease(arena)
    echo("typed_expr_type_arena_multi_source_exact=1")
    echo("typed_expr_type_arena_cross_source_tamper=1")

fn TypeArenaFunctionChildIdentityExact() =
    let firstSource =
        "fn same(callback: fn(arg: int32): bool, plain: int32): int32 =\n    return 1\n"
    let secondSource =
        "fn same(value: str): str =\n    return value\n"
    var firstTree: parser.ParserValueExprTree
    var secondTree: parser.ParserValueExprTree
    var combined: parser.ParserValueExprTree
    var err: str
    assert(parser.ParserValueExprReadTreeFromText(
               firstSource, firstTree, err) &&
           parser.ParserValueExprReadTreeFromText(
               secondSource, secondTree, err),
           Fmt"typed expr type arena: function-child parser failed {err}")
    parser.ParserValueExprTreeAppendFrom(combined, firstTree)
    parser.ParserValueExprTreeAppendFrom(combined, secondTree)
    parser.ParserValueExprTreeRelease(secondTree)
    parser.ParserValueExprTreeRelease(firstTree)
    var functionTypeSyntaxNode: int32 = -1
    for row in 0..<combined.typeSyntaxCount:
        if parser.ParserValueExprTypeSyntaxKindAt(combined, row) ==
               parser.ParserTypeSyntaxFunction &&
           parser.ParserValueExprTypeSyntaxProducerSourceIndexAt(
               combined, row) == 0:
            functionTypeSyntaxNode = row
    assert(functionTypeSyntaxNode >= 0,
           "typed expr type arena: function-child fixture missing")
    var arena: typearena.TypedExprTypeArena
    let authority =
        typearena.TypedExprTypeResolutionAuthorityEmpty()
    assert(typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               combined, authority, arena, err),
           Fmt"typed expr type arena: function-child build failed {err}")
    let functionTypeId =
        typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
            arena, functionTypeSyntaxNode)
    assert(typearena.TypedExprTypeArenaStrictValidateInto(arena, err) &&
           typearena.TypedExprTypeArenaKindAt(
               arena, functionTypeId) ==
               typearena.TypedExprStructuralTypeFunction &&
           arenamod.ArenaArrayInt32Get(
               arena.arena,
               arena.functionParamCounts,
               functionTypeId) == 1 &&
           arenamod.ArenaArrayInt32Get(
               arena.arena,
               arena.childCounts,
               functionTypeId) == 2,
           Fmt"typed expr type arena: function TypeSyntax child identity drift {err}")
    typearena.TypedExprTypeArenaRelease(arena)
    parser.ParserValueExprTreeRelease(combined)
    echo("typed_expr_type_arena_function_child_identity=1")

fn TypeArenaNameIdentity() =
    let firstSource = "type Box[T] = int32\n"
    let secondSource = "type Box[U] = int32\n"
    var firstTree: parser.ParserValueExprTree
    var secondTree: parser.ParserValueExprTree
    var first: typearena.TypedExprTypeArena
    var second: typearena.TypedExprTypeArena
    var err: str
    assert(parser.ParserValueExprReadTreeFromText(
               firstSource, firstTree, err) &&
           parser.ParserValueExprReadTreeFromText(
               secondSource, secondTree, err),
           Fmt"typed expr type arena: name identity parser failed {err}")
    let authority = typearena.TypedExprTypeResolutionAuthorityEmpty()
    assert(typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               firstTree, authority, first, err) &&
           typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               secondTree, authority, second, err),
           Fmt"typed expr type arena: name identity build failed {err}")
    assert(!layout.FixedBytes32Equal(
               first.artifactRaw32, second.artifactRaw32),
           "typed expr type arena: generic name was absent from artifact CID")
    typearena.TypedExprTypeArenaRelease(second)
    typearena.TypedExprTypeArenaRelease(first)
    parser.ParserValueExprTreeRelease(secondTree)
    parser.ParserValueExprTreeRelease(firstTree)
    echo("typed_expr_type_arena_name_identity=1")

fn TypeArenaConstAuthorityNegative() =
    let sources = [
        "type Bad = int32[0]\n",
        "type Bad = int32[2147483647 + 1]\n",
        "type Bad = int32[4 / 0]\n"
    ]
    for sourceIndex in 0..<sources.len:
        let source = sources[sourceIndex]
        var tree: parser.ParserValueExprTree
        var err: str
        assert(parser.ParserValueExprReadTreeFromText(source, tree, err),
               Fmt"typed expr type arena: const negative parser failed {err}")
        var arena: typearena.TypedExprTypeArena
        let authority = typearena.TypedExprTypeResolutionAuthorityEmpty()
        assert(!typearena.TypedExprTypeArenaBuildFromParserTreeInto(
                   tree, authority, arena, err) &&
               strutil.Contains(err, "bracket apply authority incomplete") &&
               arena == nil,
               "typed expr type arena: invalid const authority survived")
        parser.ParserValueExprTreeRelease(tree)
    echo("typed_expr_type_arena_const_bounds=1")

fn TypeArenaNominalRecursiveScc() =
    let recursiveSource =
        "type A = ref object\n    b: B\n    next: A\n\ntype B =\n    a: A\n"
    let isolatedSource =
        "type A = ref object\n    value: int32\n\ntype B =\n    value: int32\n"
    var recursiveTree: parser.ParserValueExprTree
    var isolatedTree: parser.ParserValueExprTree
    var combined: parser.ParserValueExprTree
    var err: str
    assert(parser.ParserValueExprReadTreeFromText(
               recursiveSource, recursiveTree, err) &&
           parser.ParserValueExprReadTreeFromText(
               isolatedSource, isolatedTree, err),
           Fmt"typed expr type arena: recursive parser failed {err}")
    parser.ParserValueExprTreeAppendFrom(combined, recursiveTree)
    parser.ParserValueExprTreeAppendFrom(combined, isolatedTree)
    parser.ParserValueExprTreeRelease(isolatedTree)
    parser.ParserValueExprTreeRelease(recursiveTree)
    var roots: int32[]
    var uses: int32[]
    for row in 0..<combined.typeSyntaxCount:
        let sourceIndex =
            parser.ParserValueExprTypeSyntaxProducerSourceIndexAt(
                combined, row)
        if parser.ParserValueExprTypeSyntaxRootKindAt(combined, row) ==
               parser.ParserTypeSyntaxRootTypeDeclarationRhs:
            add(roots, row)
        elif sourceIndex == 0 &&
             parser.ParserValueExprTypeSyntaxKindAt(combined, row) ==
                 parser.ParserTypeSyntaxNominal:
            let nameToken = parser.ParserValueExprTypeSyntaxNameTokenAt(
                combined, row)
            let name = parser.ParserValueExprTokenText(combined, nameToken)
            if name == "A" || name == "B": add(uses, row)
    assert(roots.len == 4 && uses.len == 3,
           "typed expr type arena: recursive fixture authority missing")
    var authority: typearena.TypedExprTypeResolutionAuthority
    var sawForward = false
    for useOffset in 0..<uses.len:
        let useNode = uses[useOffset]
        let useName = parser.ParserValueExprTokenText(
            combined,
            parser.ParserValueExprTypeSyntaxNameTokenAt(combined, useNode))
        var targetRoot: int32 = -1
        for rootOffset in 0..<roots.len:
            let root = roots[rootOffset]
            if parser.ParserValueExprTypeSyntaxProducerSourceIndexAt(
                   combined, root) == 0 &&
               parser.ParserValueExprTokenText(
                   combined,
                   parser.ParserValueExprTypeSyntaxDeclarationOwnerTokenAt(
                       combined, root)) == useName:
                targetRoot = root
        assert(targetRoot >= 0,
               "typed expr type arena: recursive target root missing")
        if targetRoot > useNode: sawForward = true
        add(authority.typeSyntaxNodeIndexes, useNode)
        add(authority.declarationRootTypeSyntaxNodeIndexes, targetRoot)
    authority.sealed = true
    var arena: typearena.TypedExprTypeArena
    var deterministic: typearena.TypedExprTypeArena
    assert(typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               combined, authority, arena, err) &&
           typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               combined, authority, deterministic, err),
           Fmt"typed expr type arena: recursive build failed {err}")
    var symbols: int32[]
    for rootOffset in 0..<roots.len:
        let rootTypeId = typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
            arena, roots[rootOffset])
        add(symbols, typearena.TypedExprTypeArenaSymbolIdAt(
            arena, rootTypeId))
    var directDependencyCount: int32
    var indirectDependencyCount: int32
    for dependencyRow in 0..<arena.nominalDependencyCount:
        if arenamod.ArenaArrayInt32Get(
               arena.arena,
               arena.nominalDependencyIndirectFlags,
               dependencyRow) == 0:
            directDependencyCount = directDependencyCount + 1
        else:
            indirectDependencyCount = indirectDependencyCount + 1
    assert(sawForward && layout.FixedBytes32Equal(
               arena.artifactRaw32, deterministic.artifactRaw32) &&
           arena.nominalDependencyCount == 3 &&
           arena.symbolDependencyCount == 3 && arena.sccCount == 3 &&
           directDependencyCount == 1 && indirectDependencyCount == 2 &&
           arenamod.ArenaArrayInt32Get(
               arena.arena, arena.symbolSccIds, symbols[0]) ==
               arenamod.ArenaArrayInt32Get(
                   arena.arena, arena.symbolSccIds, symbols[1]) &&
           arenamod.ArenaArrayInt32Get(
               arena.arena, arena.symbolSccIds, symbols[0]) !=
               arenamod.ArenaArrayInt32Get(
                   arena.arena, arena.symbolSccIds, symbols[2]) &&
           typearena.TypedExprTypeArenaManagedAt(
               arena,
               typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
                   arena, roots[1])) &&
           !typearena.TypedExprTypeArenaSendAt(
               arena,
               typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
                   arena, roots[1])),
           "typed expr type arena: recursive SCC or trait proof drift")
    typearena.TypedExprTypeArenaRelease(deterministic)
    parser.ParserValueExprTreeRelease(combined)
    let firstDependencySource = arenamod.ArenaArrayInt32Get(
        arena.arena, arena.nominalDependencySourceSymbolIds, 0)
    arenamod.ArenaArrayInt32Set(
        arena.arena, arena.nominalDependencySourceSymbolIds, 0, symbols[2])
    assert(!typearena.TypedExprTypeArenaStrictValidateInto(arena, err) &&
           strutil.Contains(err, "dependency coverage drift"),
           "typed expr type arena: cross-source dependency source tamper survived")
    arenamod.ArenaArrayInt32Set(
        arena.arena, arena.nominalDependencySourceSymbolIds, 0,
        firstDependencySource)
    let recursiveSccId = arenamod.ArenaArrayInt32Get(
        arena.arena, arena.symbolSccIds, symbols[0])
    let priorSccId = arenamod.ArenaArrayInt32Get(
        arena.arena, arena.symbolSccIds, symbols[1])
    arenamod.ArenaArrayInt32Set(
        arena.arena, arena.symbolSccIds, symbols[1],
        recursiveSccId == 0 ? 1 : 0)
    assert(!typearena.TypedExprTypeArenaStrictValidateInto(arena, err) &&
           strutil.Contains(err, "SCC SymbolId assignment drift"),
           "typed expr type arena: wrong SCC assignment survived")
    arenamod.ArenaArrayInt32Set(
        arena.arena, arena.symbolSccIds, symbols[1], priorSccId)
    let memberStart = arenamod.ArenaArrayInt32Get(
        arena.arena, arena.sccStarts, recursiveSccId)
    let firstMember = arenamod.ArenaArrayInt32Get(
        arena.arena, arena.sccSymbolIds, memberStart)
    let secondMember = arenamod.ArenaArrayInt32Get(
        arena.arena, arena.sccSymbolIds, memberStart + 1)
    arenamod.ArenaArrayInt32Set(
        arena.arena, arena.sccSymbolIds, memberStart, secondMember)
    arenamod.ArenaArrayInt32Set(
        arena.arena, arena.sccSymbolIds, memberStart + 1, firstMember)
    assert(!typearena.TypedExprTypeArenaStrictValidateInto(arena, err) &&
           strutil.Contains(err, "SCC membership order drift"),
           "typed expr type arena: SCC order tamper survived")
    arenamod.ArenaArrayInt32Set(
        arena.arena, arena.sccSymbolIds, memberStart, firstMember)
    arenamod.ArenaArrayInt32Set(
        arena.arena, arena.sccSymbolIds, memberStart + 1, secondMember)
    assert(typearena.TypedExprTypeArenaStrictValidateInto(arena, err),
           Fmt"typed expr type arena: restored recursive proof invalid {err}")
    typearena.TypedExprTypeArenaRelease(arena)
    echo("typed_expr_type_arena_nominal_forward=1")
    echo("typed_expr_type_arena_recursive_scc=1")
    echo("typed_expr_type_arena_cross_source_dependency_tamper=1")
    echo("typed_expr_type_arena_scc_tamper=1")

fn TypeArenaNominalRecursiveNegative() =
    let missingSource = "type Broken = ref object\n    next: Missing\n"
    let directCycleSource =
        "type Left =\n    right: Right\n\ntype Right =\n    left: Left\n"
    var missingTree: parser.ParserValueExprTree
    var directTree: parser.ParserValueExprTree
    var err: str
    assert(parser.ParserValueExprReadTreeFromText(
               missingSource, missingTree, err) &&
           parser.ParserValueExprReadTreeFromText(
               directCycleSource, directTree, err),
           Fmt"typed expr type arena: recursive negative parser failed {err}")
    var rejected: typearena.TypedExprTypeArena
    let emptyAuthority = typearena.TypedExprTypeResolutionAuthorityEmpty()
    assert(!typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               missingTree, emptyAuthority, rejected, err) &&
           strutil.Contains(err, "nominal SymbolId authority missing") &&
           rejected == nil,
           "typed expr type arena: undeclared recursive nominal survived")
    var roots: int32[]
    var uses: int32[]
    for row in 0..<directTree.typeSyntaxCount:
        if parser.ParserValueExprTypeSyntaxRootKindAt(directTree, row) ==
               parser.ParserTypeSyntaxRootTypeDeclarationRhs:
            add(roots, row)
        elif parser.ParserValueExprTypeSyntaxKindAt(directTree, row) ==
                 parser.ParserTypeSyntaxNominal:
            let name = parser.ParserValueExprTokenText(
                directTree,
                parser.ParserValueExprTypeSyntaxNameTokenAt(directTree, row))
            if name == "Left" || name == "Right": add(uses, row)
    var authority: typearena.TypedExprTypeResolutionAuthority
    for useOffset in 0..<uses.len:
        let useNode = uses[useOffset]
        let name = parser.ParserValueExprTokenText(
            directTree,
            parser.ParserValueExprTypeSyntaxNameTokenAt(directTree, useNode))
        for rootOffset in 0..<roots.len:
            let root = roots[rootOffset]
            if parser.ParserValueExprTokenText(
                   directTree,
                   parser.ParserValueExprTypeSyntaxDeclarationOwnerTokenAt(
                       directTree, root)) == name:
                add(authority.typeSyntaxNodeIndexes, useNode)
                add(authority.declarationRootTypeSyntaxNodeIndexes, root)
    authority.sealed = true
    assert(!typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               directTree, authority, rejected, err) &&
           strutil.Contains(err, "cycle has no indirection") &&
           rejected == nil,
           "typed expr type arena: direct recursive layout cycle survived")
    parser.ParserValueExprTreeRelease(directTree)
    parser.ParserValueExprTreeRelease(missingTree)
    echo("typed_expr_type_arena_undeclared_nominal_hard_fail=1")
    echo("typed_expr_type_arena_direct_cycle_hard_fail=1")

fn TypeArenaSameSourceProductionAuthority() =
    let source =
        "type\n    Box =\n        value: int32\n\nfn ReadBox(box: Box): int32 =\n    return box.value\n"
    var tree: parser.ParserValueExprTree
    var err: str
    assert(parser.ParserValueExprReadTreeFromText(source, tree, err),
           Fmt"typed expr type arena: production authority parser failed {err}")
    var authority: typearena.TypedExprTypeResolutionAuthority
    assert(typearena.TypedExprTypeResolutionAuthorityBuildSameSourceInto(
               tree, authority, err),
           Fmt"typed expr type arena: production authority failed {err}")
    var boxRoot: int32 = -1
    var boxUse: int32 = -1
    for row in 0..<tree.typeSyntaxCount:
        if parser.ParserValueExprTypeSyntaxRootKindAt(tree, row) ==
               parser.ParserTypeSyntaxRootTypeDeclarationRhs &&
           parser.ParserValueExprTokenText(
               tree,
               parser.ParserValueExprTypeSyntaxDeclarationOwnerTokenAt(
                   tree, row)) == "Box":
            boxRoot = row
        elif parser.ParserValueExprTypeSyntaxKindAt(tree, row) ==
                 parser.ParserTypeSyntaxNominal &&
             parser.ParserValueExprTokenText(
                 tree,
                 parser.ParserValueExprTypeSyntaxNameTokenAt(
                     tree, row)) == "Box":
            boxUse = row
    assert(boxRoot >= 0 && boxUse >= 0 &&
           authority.typeSyntaxNodeIndexes.len == 1 &&
           authority.typeSyntaxNodeIndexes[0] == boxUse &&
           authority.declarationRootTypeSyntaxNodeIndexes[0] == boxRoot,
           "typed expr type arena: production authority edge is not exact")
    var arena: typearena.TypedExprTypeArena
    assert(typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               tree, authority, arena, err) &&
           typearena.TypedExprTypeArenaStrictValidateInto(arena, err),
           Fmt"typed expr type arena: production authority build failed {err}")
    let boxTypeId = typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
        arena, boxRoot)
    assert(arena.symbolCount == 1 &&
           typearena.TypedExprTypeArenaSymbolIdAt(arena, boxTypeId) == 0 &&
           typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
               arena, boxUse) == boxTypeId &&
           arena.resolutionCount == 1 &&
           arenamod.ArenaArrayInt32Get(
               arena.arena, arena.resolutionTargetSymbolIds, 0) == 0,
           "typed expr type arena: dense production SymbolId drift")
    typearena.TypedExprTypeArenaRelease(arena)
    parser.ParserValueExprTreeRelease(tree)
    echo("typed_expr_type_arena_same_source_authority=1")

fn TypeArenaSameSourceAuthorityNegatives() =
    let duplicateSource =
        "type Box = int32\ntype Box = str\n"
    let unknownSource =
        "fn ReadMissing(value: Missing): int32 =\n    return 0\n"
    let firstSource =
        "type Box =\n    value: int32\n"
    let secondSource =
        "fn ReadBox(value: Box): int32 =\n    return value.value\n"
    var duplicateTree: parser.ParserValueExprTree
    var unknownTree: parser.ParserValueExprTree
    var firstTree: parser.ParserValueExprTree
    var secondTree: parser.ParserValueExprTree
    var combined: parser.ParserValueExprTree
    var err: str
    assert(parser.ParserValueExprReadTreeFromText(
               duplicateSource, duplicateTree, err) &&
           parser.ParserValueExprReadTreeFromText(
               unknownSource, unknownTree, err) &&
           parser.ParserValueExprReadTreeFromText(
               firstSource, firstTree, err) &&
           parser.ParserValueExprReadTreeFromText(
               secondSource, secondTree, err),
           Fmt"typed expr type arena: production negative parser failed {err}")
    var duplicateAuthority: typearena.TypedExprTypeResolutionAuthority
    assert(!typearena.TypedExprTypeResolutionAuthorityBuildSameSourceInto(
                duplicateTree, duplicateAuthority, err) &&
           strutil.Contains(err, "duplicate same-source"),
           "typed expr type arena: duplicate declaration survived")
    var unknownAuthority: typearena.TypedExprTypeResolutionAuthority
    assert(!typearena.TypedExprTypeResolutionAuthorityBuildSameSourceInto(
                unknownTree, unknownAuthority, err) &&
           strutil.Contains(err, "nominal declaration is not visible"),
           "typed expr type arena: unknown nominal survived")
    parser.ParserValueExprTreeAppendFrom(combined, firstTree)
    parser.ParserValueExprTreeAppendFrom(combined, secondTree)
    var crossSourceAuthority: typearena.TypedExprTypeResolutionAuthority
    assert(!typearena.TypedExprTypeResolutionAuthorityBuildSameSourceInto(
                combined, crossSourceAuthority, err) &&
           strutil.Contains(err, "nominal declaration is not visible"),
           "typed expr type arena: cross-source nominal survived")
    parser.ParserValueExprTreeRelease(combined)
    parser.ParserValueExprTreeRelease(secondTree)
    parser.ParserValueExprTreeRelease(firstTree)
    parser.ParserValueExprTreeRelease(unknownTree)
    parser.ParserValueExprTreeRelease(duplicateTree)
    echo("typed_expr_type_arena_duplicate_declaration_hard_fail=1")
    echo("typed_expr_type_arena_unknown_nominal_hard_fail=1")
    echo("typed_expr_type_arena_cross_source_nominal_hard_fail=1")

fn TypeArenaPackageForestAuthority() =
    let consumerSource =
        "fn ReadLeft(value: left.Box): int32 =\n    return 1\n\nfn ReadRight(value: right.Box): int32 =\n    return 2\n"
    let leftSource =
        "type\n    Box =\n        leftValue: int32\n"
    let rightSource =
        "type\n    Box =\n        rightValue: int32\n"
    var consumerTree: parser.ParserValueExprTree
    var leftTree: parser.ParserValueExprTree
    var rightTree: parser.ParserValueExprTree
    var forest: parser.ParserValueExprTree
    var err: str
    assert(parser.ParserValueExprReadTreeFromText(
               consumerSource, consumerTree, err) &&
           parser.ParserValueExprReadTreeFromText(
               leftSource, leftTree, err) &&
           parser.ParserValueExprReadTreeFromText(
               rightSource, rightTree, err),
           Fmt"typed expr type arena: package forest parser failed {err}")
    parser.ParserValueExprTreeAppendFrom(forest, consumerTree)
    parser.ParserValueExprTreeAppendFrom(forest, leftTree)
    parser.ParserValueExprTreeAppendFrom(forest, rightTree)
    var imports: typearena.TypedExprTypeImportAuthority
    add(imports.ownerSourceIndexes, 0)
    add(imports.targetSourceIndexes, 1)
    add(imports.qualifiers, "left")
    add(imports.allowsUnqualified, false)
    add(imports.ownerSourceIndexes, 0)
    add(imports.targetSourceIndexes, 2)
    add(imports.qualifiers, "right")
    add(imports.allowsUnqualified, false)
    imports.sealed = true
    var authority: typearena.TypedExprTypeResolutionAuthority
    assert(typearena.TypedExprTypeResolutionAuthorityBuildPackageForestInto(
               forest, imports, authority, err),
           Fmt"typed expr type arena: package forest authority failed {err}")
    var leftRoot: int32 = -1
    var rightRoot: int32 = -1
    var leftUse: int32 = -1
    var rightUse: int32 = -1
    for row in 0..<forest.typeSyntaxCount:
        let sourceIndex =
            parser.ParserValueExprTypeSyntaxProducerSourceIndexAt(
                forest, row)
        if parser.ParserValueExprTypeSyntaxRootKindAt(forest, row) ==
               parser.ParserTypeSyntaxRootTypeDeclarationRhs:
            if sourceIndex == 1: leftRoot = row
            if sourceIndex == 2: rightRoot = row
        elif parser.ParserValueExprTypeSyntaxKindAt(forest, row) ==
                 parser.ParserTypeSyntaxQualified:
            let firstChild = parser.ParserValueExprTypeSyntaxChildAt(
                forest, row, 0)
            let qualifier = parser.ParserValueExprTokenText(
                forest,
                parser.ParserValueExprTypeSyntaxNameTokenAt(
                    forest, firstChild))
            if qualifier == "left": leftUse = row
            if qualifier == "right": rightUse = row
    var leftEdge = false
    var rightEdge = false
    for row in 0..<authority.typeSyntaxNodeIndexes.len:
        if authority.typeSyntaxNodeIndexes[row] == leftUse &&
           authority.declarationRootTypeSyntaxNodeIndexes[row] == leftRoot:
            leftEdge = true
        if authority.typeSyntaxNodeIndexes[row] == rightUse &&
           authority.declarationRootTypeSyntaxNodeIndexes[row] == rightRoot:
            rightEdge = true
    assert(leftRoot >= 0 && rightRoot >= 0 && leftUse >= 0 &&
           rightUse >= 0 && leftEdge && rightEdge,
           "typed expr type arena: exact qualified package edge drift")
    var arena: typearena.TypedExprTypeArena
    assert(typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               forest, authority, arena, err) &&
           typearena.TypedExprTypeArenaStrictValidateInto(arena, err),
           Fmt"typed expr type arena: package forest build failed {err}")
    assert(arena.symbolCount == 2 && arena.resolutionCount == 2 &&
           typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
               arena, leftUse) ==
               typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
                   arena, leftRoot) &&
           typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
               arena, rightUse) ==
               typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
                   arena, rightRoot) &&
           typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
               arena, leftRoot) !=
               typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
                   arena, rightRoot),
           "typed expr type arena: same-name package SymbolId drift")
    typearena.TypedExprTypeArenaRelease(arena)
    parser.ParserValueExprTreeRelease(forest)
    parser.ParserValueExprTreeRelease(rightTree)
    parser.ParserValueExprTreeRelease(leftTree)
    parser.ParserValueExprTreeRelease(consumerTree)
    echo("typed_expr_type_arena_alias_qualified=1")
    echo("typed_expr_type_arena_cross_module_same_name=1")

fn TypeArenaPackageForestAuthorityNegatives() =
    let wrongAliasSource =
        "fn ReadBox(value: missing.Box): int32 =\n    return 0\n"
    let importedSource =
        "type\n    Box =\n        value: int32\n"
    let otherImportedSource =
        "type\n    Box =\n        other: int32\n"
    var wrongTree: parser.ParserValueExprTree
    var importedTree: parser.ParserValueExprTree
    var otherImportedTree: parser.ParserValueExprTree
    var forest: parser.ParserValueExprTree
    var err: str
    assert(parser.ParserValueExprReadTreeFromText(
               wrongAliasSource, wrongTree, err) &&
           parser.ParserValueExprReadTreeFromText(
               importedSource, importedTree, err) &&
           parser.ParserValueExprReadTreeFromText(
               otherImportedSource, otherImportedTree, err),
           Fmt"typed expr type arena: package negative parser failed {err}")
    parser.ParserValueExprTreeAppendFrom(forest, wrongTree)
    parser.ParserValueExprTreeAppendFrom(forest, importedTree)
    parser.ParserValueExprTreeAppendFrom(forest, otherImportedTree)
    var noImports: typearena.TypedExprTypeImportAuthority
    noImports.sealed = true
    var rejected: typearena.TypedExprTypeResolutionAuthority
    assert(!typearena.TypedExprTypeResolutionAuthorityBuildPackageForestInto(
                forest, noImports, rejected, err) &&
           strutil.Contains(err, "qualified import alias is not visible"),
           "typed expr type arena: unimported qualified type survived")
    var wrongAlias: typearena.TypedExprTypeImportAuthority
    add(wrongAlias.ownerSourceIndexes, 0)
    add(wrongAlias.targetSourceIndexes, 1)
    add(wrongAlias.qualifiers, "left")
    add(wrongAlias.allowsUnqualified, false)
    wrongAlias.sealed = true
    assert(!typearena.TypedExprTypeResolutionAuthorityBuildPackageForestInto(
                forest, wrongAlias, rejected, err) &&
           strutil.Contains(err, "qualified import alias is not visible"),
           "typed expr type arena: wrong import alias survived")
    var duplicateAlias: typearena.TypedExprTypeImportAuthority
    add(duplicateAlias.ownerSourceIndexes, 0)
    add(duplicateAlias.targetSourceIndexes, 1)
    add(duplicateAlias.qualifiers, "missing")
    add(duplicateAlias.allowsUnqualified, false)
    add(duplicateAlias.ownerSourceIndexes, 0)
    add(duplicateAlias.targetSourceIndexes, 2)
    add(duplicateAlias.qualifiers, "missing")
    add(duplicateAlias.allowsUnqualified, false)
    duplicateAlias.sealed = true
    assert(!typearena.TypedExprTypeResolutionAuthorityBuildPackageForestInto(
                forest, duplicateAlias, rejected, err) &&
           strutil.Contains(err, "duplicate import qualifier authority"),
           "typed expr type arena: duplicate import alias survived")
    let shadowSource =
        "type missing = int32\n\nfn ReadBox(value: missing.Box): int32 =\n    return 0\n"
    var shadowTree: parser.ParserValueExprTree
    var shadowImportedTree: parser.ParserValueExprTree
    var shadowForest: parser.ParserValueExprTree
    assert(parser.ParserValueExprReadTreeFromText(
               shadowSource, shadowTree, err) &&
           parser.ParserValueExprReadTreeFromText(
               importedSource, shadowImportedTree, err),
           Fmt"typed expr type arena: package shadow parser failed {err}")
    parser.ParserValueExprTreeAppendFrom(shadowForest, shadowTree)
    parser.ParserValueExprTreeAppendFrom(shadowForest, shadowImportedTree)
    var shadowImport: typearena.TypedExprTypeImportAuthority
    add(shadowImport.ownerSourceIndexes, 0)
    add(shadowImport.targetSourceIndexes, 1)
    add(shadowImport.qualifiers, "missing")
    add(shadowImport.allowsUnqualified, false)
    shadowImport.sealed = true
    assert(!typearena.TypedExprTypeResolutionAuthorityBuildPackageForestInto(
                shadowForest, shadowImport, rejected, err) &&
           strutil.Contains(err, "import qualifier is shadowed"),
           "typed expr type arena: local type failed to shadow import alias")
    let privateConsumerSource =
        "fn ReadPrivate(value: left.privateBox): int32 =\n    return 0\n"
    let privateImportedSource =
        "type privateBox =\n    value: int32\n"
    var privateConsumerTree: parser.ParserValueExprTree
    var privateImportedTree: parser.ParserValueExprTree
    var privateForest: parser.ParserValueExprTree
    assert(parser.ParserValueExprReadTreeFromText(
               privateConsumerSource, privateConsumerTree, err) &&
           parser.ParserValueExprReadTreeFromText(
               privateImportedSource, privateImportedTree, err),
           Fmt"typed expr type arena: private import parser failed {err}")
    parser.ParserValueExprTreeAppendFrom(
        privateForest, privateConsumerTree)
    parser.ParserValueExprTreeAppendFrom(
        privateForest, privateImportedTree)
    var privateImport: typearena.TypedExprTypeImportAuthority
    add(privateImport.ownerSourceIndexes, 0)
    add(privateImport.targetSourceIndexes, 1)
    add(privateImport.qualifiers, "left")
    add(privateImport.allowsUnqualified, false)
    privateImport.sealed = true
    assert(!typearena.TypedExprTypeResolutionAuthorityBuildPackageForestInto(
                privateForest, privateImport, rejected, err) &&
           strutil.Contains(err, "imported type is not exported"),
           "typed expr type arena: private imported type survived")
    parser.ParserValueExprTreeRelease(privateForest)
    parser.ParserValueExprTreeRelease(privateImportedTree)
    parser.ParserValueExprTreeRelease(privateConsumerTree)
    parser.ParserValueExprTreeRelease(shadowForest)
    parser.ParserValueExprTreeRelease(shadowImportedTree)
    parser.ParserValueExprTreeRelease(shadowTree)
    parser.ParserValueExprTreeRelease(forest)
    parser.ParserValueExprTreeRelease(otherImportedTree)
    parser.ParserValueExprTreeRelease(importedTree)
    parser.ParserValueExprTreeRelease(wrongTree)
    echo("typed_expr_type_arena_unimported_qualified_hard_fail=1")
    echo("typed_expr_type_arena_wrong_alias_hard_fail=1")
    echo("typed_expr_type_arena_duplicate_alias_hard_fail=1")
    echo("typed_expr_type_arena_alias_shadow_hard_fail=1")
    echo("typed_expr_type_arena_private_import_hard_fail=1")

fn TypeArenaObjectInheritanceExact() =
    let source =
        "type Base[T] =\n    baseValue: T\n\ntype Mid[T] = of Base[T]\n    midValue: T\n\ntype Leaf = of Mid[str]\n    leafValue: int32\n\ntype RefLeaf = ref object of Mid[str]\n    refValue: int64\n"
    var tree: parser.ParserValueExprTree
    var authority: typearena.TypedExprTypeResolutionAuthority
    var arena: typearena.TypedExprTypeArena
    var err: str
    assert(parser.ParserValueExprReadTreeFromText(source, tree, err),
           Fmt"typed expr type arena: inheritance parser failed {err}")
    assert(typearena.TypedExprTypeResolutionAuthorityBuildSameSourceInto(
               tree, authority, err),
           Fmt"typed expr type arena: inheritance authority failed {err}")
    assert(typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               tree, authority, arena, err) &&
           typearena.TypedExprTypeArenaStrictValidateInto(arena, err),
           Fmt"typed expr type arena: inheritance build failed {err}")
    let baseRoot = TypeArenaDeclarationRoot(tree, "Base")
    let midRoot = TypeArenaDeclarationRoot(tree, "Mid")
    let leafRoot = TypeArenaDeclarationRoot(tree, "Leaf")
    let refLeafRoot = TypeArenaDeclarationRoot(tree, "RefLeaf")
    assert(baseRoot >= 0 && midRoot >= 0 && leafRoot >= 0 &&
           refLeafRoot >= 0,
           "typed expr type arena: inheritance declaration roots missing")
    let baseTypeId = typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
        arena, baseRoot)
    let midTypeId = typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
        arena, midRoot)
    let leafTypeId = typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
        arena, leafRoot)
    let refLeafTypeId = typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
        arena, refLeafRoot)
    let baseSymbolId = typearena.TypedExprTypeArenaSymbolIdAt(
        arena, baseTypeId)
    let midSymbolId = typearena.TypedExprTypeArenaSymbolIdAt(
        arena, midTypeId)
    let midBaseTypeSyntaxNode =
        typearena.TypedExprTypeArenaBaseTypeSyntaxNodeIndexAt(
            arena, midTypeId)
    let midBaseTypeId = typearena.TypedExprTypeArenaBaseTypeIdAt(
        arena, midTypeId)
    let leafBaseTypeSyntaxNode =
        typearena.TypedExprTypeArenaBaseTypeSyntaxNodeIndexAt(
            arena, leafTypeId)
    let leafBaseTypeId = typearena.TypedExprTypeArenaBaseTypeIdAt(
        arena, leafTypeId)
    let refLeafBaseTypeId = typearena.TypedExprTypeArenaBaseTypeIdAt(
        arena, refLeafTypeId)
    let leafGrandBaseTypeId = typearena.TypedExprTypeArenaBaseTypeIdAt(
        arena, leafBaseTypeId)
    let leafPremiseStart = arenamod.ArenaArrayInt32Get(
        arena.arena, arena.traitPremiseStarts, leafTypeId)
    assert(typearena.TypedExprTypeArenaKindAt(arena, midBaseTypeId) ==
               typearena.TypedExprStructuralTypeObject &&
           typearena.TypedExprTypeArenaSymbolIdAt(
               arena, midBaseTypeId) == baseSymbolId &&
           midBaseTypeId != baseTypeId &&
           typearena.TypedExprTypeArenaKindAt(arena, leafBaseTypeId) ==
               typearena.TypedExprStructuralTypeObject &&
           typearena.TypedExprTypeArenaSymbolIdAt(
               arena, leafBaseTypeId) == midSymbolId &&
           leafBaseTypeId != midTypeId &&
           refLeafBaseTypeId == leafBaseTypeId &&
           typearena.TypedExprTypeArenaKindAt(
               arena, leafGrandBaseTypeId) ==
               typearena.TypedExprStructuralTypeObject &&
           typearena.TypedExprTypeArenaSymbolIdAt(
               arena, leafGrandBaseTypeId) == baseSymbolId,
           "typed expr type arena: generic inherited base identity drift")
    assert(parser.ParserValueExprTypeSyntaxChildAt(
               tree, midRoot, 0) == midBaseTypeSyntaxNode &&
           parser.ParserValueExprTypeSyntaxChildAt(
               tree, leafRoot, 0) == leafBaseTypeSyntaxNode &&
           arenamod.ArenaArrayInt32Get(
               arena.arena, arena.childCounts, leafTypeId) == 1 &&
           typearena.TypedExprTypeArenaTraitPremiseCountAt(
               arena, leafTypeId) == 2 &&
           typearena.TypedExprTypeArenaTraitPremiseTypeIdAt(
               arena, leafTypeId, 0) == leafBaseTypeId &&
           arenamod.ArenaArrayInt32Get(
               arena.arena,
               arena.traitPremiseTypeIds,
               leafPremiseStart) == leafBaseTypeId &&
           typearena.TypedExprTypeArenaManagedAt(arena, leafTypeId) &&
           typearena.TypedExprTypeArenaKindAt(arena, refLeafTypeId) ==
               typearena.TypedExprStructuralTypeRefObject,
           "typed expr type arena: base/local trait premise separation drift")
    var baseMutation = typearena.TypedExprTypeArenaClone(arena)
    assert(typearena.TypedExprTypeArenaUsedBytes(arena) > 0 &&
           typearena.TypedExprTypeArenaUsedBytes(baseMutation) ==
               typearena.TypedExprTypeArenaUsedBytes(arena),
           "typed expr type arena: inheritance clone byte identity drift")
    arenamod.ArenaArrayInt32Set(
        baseMutation.arena,
        baseMutation.baseTypeIds,
        leafTypeId,
        baseTypeId)
    arenamod.ArenaArrayInt32Set(
        baseMutation.arena,
        baseMutation.traitPremiseTypeIds,
        leafPremiseStart,
        baseTypeId)
    baseMutation.artifactRaw32 =
        typearena.TypedExprTypeArenaArtifactCidForCurrentState(
            baseMutation)
    assert(!typearena.TypedExprTypeArenaStrictValidateInto(
               baseMutation, err) &&
           strutil.Contains(err, "exact object base receipt drift"),
           "typed expr type arena: recomputed-CID base TypeId mutation survived")
    typearena.TypedExprTypeArenaRelease(baseMutation)
    var syntaxMutation = typearena.TypedExprTypeArenaClone(arena)
    arenamod.ArenaArrayInt32Set(
        syntaxMutation.arena,
        syntaxMutation.baseTypeSyntaxNodeIndexes,
        leafTypeId,
        midBaseTypeSyntaxNode)
    syntaxMutation.artifactRaw32 =
        typearena.TypedExprTypeArenaArtifactCidForCurrentState(
            syntaxMutation)
    assert(!typearena.TypedExprTypeArenaStrictValidateInto(
               syntaxMutation, err) &&
           strutil.Contains(err, "exact object base receipt drift"),
           "typed expr type arena: recomputed-CID base syntax mutation survived")
    typearena.TypedExprTypeArenaRelease(syntaxMutation)
    typearena.TypedExprTypeArenaRelease(arena)
    parser.ParserValueExprTreeRelease(tree)

    let rejectedSources = [
        "type Scalar = int32\ntype Bad = of Scalar\n",
        "type Heap = ref object\ntype Bad = of Heap\n",
        "type A = of B\ntype B = of A\n",
        "type Parent =\n    same: int32\n\ntype Bad = of Parent\n    same: str\n"
    ]
    let rejectedReasons = [
        "concrete object",
        "ref object or non-object base forbidden",
        "object inheritance cycle",
        "inherited object field shadow forbidden"
    ]
    for rejectedIndex in 0..<rejectedSources.len:
        var rejectedTree: parser.ParserValueExprTree
        var rejectedAuthority: typearena.TypedExprTypeResolutionAuthority
        var rejectedArena: typearena.TypedExprTypeArena
        assert(parser.ParserValueExprReadTreeFromText(
                   rejectedSources[rejectedIndex],
                   rejectedTree,
                   err),
               Fmt"typed expr type arena: inheritance negative parser failed {err}")
        assert(typearena.TypedExprTypeResolutionAuthorityBuildSameSourceInto(
                   rejectedTree, rejectedAuthority, err),
               Fmt"typed expr type arena: inheritance negative authority failed {err}")
        assert(!typearena.TypedExprTypeArenaBuildFromParserTreeInto(
                    rejectedTree,
                    rejectedAuthority,
                    rejectedArena,
                    err) &&
               rejectedArena == nil &&
               strutil.Contains(err, rejectedReasons[rejectedIndex]),
               Fmt"typed expr type arena: inheritance negative survived index={rejectedIndex} err={err}")
        parser.ParserValueExprTreeRelease(rejectedTree)
    echo("typed_expr_type_arena_inheritance_exact=1")
    echo("typed_expr_type_arena_inheritance_generic_specialization=1")
    echo("typed_expr_type_arena_inheritance_ref_object=1")
    echo("typed_expr_type_arena_inheritance_negative=1")
    echo("typed_expr_type_arena_inheritance_clone_mutation=1")

fn TypeArenaNestedObjectIdentityExact() =
    let source =
        "type Outer = ref object:\n    left: ref object:\n        value: int32\n    right: ref object:\n        value: int32\n"
    var tree: parser.ParserValueExprTree
    var err: str
    assert(parser.ParserValueExprReadTreeFromText(source, tree, err),
           Fmt"typed expr type arena: nested object parser failed {err}")
    var outerRoot: int32 = -1
    var leftRoot: int32 = -1
    var rightRoot: int32 = -1
    for row in 0..<tree.typeSyntaxCount:
        let rootKind = parser.ParserValueExprTypeSyntaxRootKindAt(tree, row)
        if rootKind != parser.ParserTypeSyntaxRootTypeDeclarationRhs &&
           rootKind != parser.ParserTypeSyntaxRootFieldDeclaration:
            continue
        let ownerToken = parser.ParserValueExprTypeSyntaxOwnerTokenAt(
            tree, row)
        let name = parser.ParserValueExprTokenText(tree, ownerToken)
        if name == "Outer": outerRoot = row
        if name == "left": leftRoot = row
        if name == "right": rightRoot = row
    var leftValueRoot: int32 = -1
    var rightValueRoot: int32 = -1
    for row in 0..<tree.typeSyntaxCount:
        if parser.ParserValueExprTypeSyntaxRootKindAt(tree, row) !=
               parser.ParserTypeSyntaxRootFieldDeclaration:
            continue
        let ownerToken = parser.ParserValueExprTypeSyntaxOwnerTokenAt(
            tree, row)
        if parser.ParserValueExprTokenText(tree, ownerToken) != "value":
            continue
        let declarationOwner =
            parser.ParserValueExprTypeSyntaxDeclarationOwnerAt(tree, row)
        if declarationOwner == leftRoot: leftValueRoot = row
        if declarationOwner == rightRoot: rightValueRoot = row
    assert(outerRoot >= 0 && leftRoot > outerRoot &&
           rightRoot > leftRoot && leftValueRoot > leftRoot &&
           rightValueRoot > rightRoot,
           "typed expr type arena: nested object parser roots missing")
    let authority = typearena.TypedExprTypeResolutionAuthorityEmpty()
    var arena: typearena.TypedExprTypeArena
    assert(typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               tree, authority, arena, err) &&
           typearena.TypedExprTypeArenaStrictValidateInto(arena, err),
           Fmt"typed expr type arena: nested object build failed {err}")
    let outerTypeId = typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
        arena, outerRoot)
    let leftTypeId = typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
        arena, leftRoot)
    let rightTypeId = typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
        arena, rightRoot)
    let leftSymbolId =
        typearena.TypedExprTypeArenaSymbolIdAt(arena, leftTypeId)
    let rightSymbolId =
        typearena.TypedExprTypeArenaSymbolIdAt(arena, rightTypeId)
    let outerSymbolId =
        typearena.TypedExprTypeArenaSymbolIdAt(arena, outerTypeId)
    assert(outerTypeId != leftTypeId && outerTypeId != rightTypeId &&
           leftTypeId != rightTypeId &&
           outerSymbolId != leftSymbolId &&
           outerSymbolId != rightSymbolId &&
           leftSymbolId != rightSymbolId,
           "typed expr type arena: sibling nested aggregate identity shared")
    assert(arenamod.ArenaArrayInt32Get(
               arena.arena,
               arena.symbolDeclarationRootTypeSyntaxNodeIndexes,
               leftSymbolId) == leftRoot &&
           arenamod.ArenaArrayInt32Get(
               arena.arena,
               arena.symbolDeclarationRootTypeSyntaxNodeIndexes,
               rightSymbolId) == rightRoot &&
           arenamod.ArenaArrayInt32Get(
               arena.arena,
               arena.symbolDeclarationOwnerTokenIndexes,
               leftSymbolId) ==
               parser.ParserValueExprTypeSyntaxOwnerTokenAt(tree, leftRoot) &&
           arenamod.ArenaArrayInt32Get(
               arena.arena,
               arena.symbolDeclarationOwnerTokenIndexes,
               rightSymbolId) ==
               parser.ParserValueExprTypeSyntaxOwnerTokenAt(tree, rightRoot),
           "typed expr type arena: nested symbol field name token drift")
    assert(arenamod.ArenaArrayInt32Get(
               arena.arena,
               arena.typeSyntaxEnclosingSymbolIds,
               leftRoot) == leftSymbolId &&
           arenamod.ArenaArrayInt32Get(
               arena.arena,
               arena.typeSyntaxEnclosingSymbolIds,
               leftValueRoot) == leftSymbolId &&
           arenamod.ArenaArrayInt32Get(
               arena.arena,
               arena.typeSyntaxEnclosingSymbolIds,
               rightRoot) == rightSymbolId &&
           arenamod.ArenaArrayInt32Get(
               arena.arena,
               arena.typeSyntaxEnclosingSymbolIds,
               rightValueRoot) == rightSymbolId,
           "typed expr type arena: immediate nested enclosing SymbolId drift")

    var siblingTypeShare = typearena.TypedExprTypeArenaClone(arena)
    arenamod.ArenaArrayInt32Set(
        siblingTypeShare.arena,
        siblingTypeShare.typeSyntaxTypeIds,
        rightRoot,
        leftTypeId)
    assert(!typearena.TypedExprTypeArenaStrictValidateInto(
               siblingTypeShare, err),
           "typed expr type arena: sibling nested TypeId sharing survived")
    typearena.TypedExprTypeArenaRelease(siblingTypeShare)

    var siblingSymbolShare = typearena.TypedExprTypeArenaClone(arena)
    arenamod.ArenaArrayInt32Set(
        siblingSymbolShare.arena,
        siblingSymbolShare.symbolIds,
        rightTypeId,
        leftSymbolId)
    assert(!typearena.TypedExprTypeArenaStrictValidateInto(
               siblingSymbolShare, err),
           "typed expr type arena: sibling nested SymbolId sharing survived")
    typearena.TypedExprTypeArenaRelease(siblingSymbolShare)

    var inheritedNameToken = typearena.TypedExprTypeArenaClone(arena)
    arenamod.ArenaArrayInt32Set(
        inheritedNameToken.arena,
        inheritedNameToken.symbolDeclarationOwnerTokenIndexes,
        leftSymbolId,
        arenamod.ArenaArrayInt32Get(
            inheritedNameToken.arena,
            inheritedNameToken.typeSyntaxDeclarationOwnerTokenIndexes,
            leftRoot))
    assert(!typearena.TypedExprTypeArenaStrictValidateInto(
               inheritedNameToken, err),
           "typed expr type arena: inherited nested symbol name token survived")
    typearena.TypedExprTypeArenaRelease(inheritedNameToken)

    var wrongEnclosing = typearena.TypedExprTypeArenaClone(arena)
    arenamod.ArenaArrayInt32Set(
        wrongEnclosing.arena,
        wrongEnclosing.typeSyntaxEnclosingSymbolIds,
        leftValueRoot,
        outerSymbolId)
    assert(!typearena.TypedExprTypeArenaStrictValidateInto(
               wrongEnclosing, err),
           "typed expr type arena: non-immediate nested enclosing survived")
    typearena.TypedExprTypeArenaRelease(wrongEnclosing)

    var missingType = typearena.TypedExprTypeArenaClone(arena)
    arenamod.ArenaArrayInt32Set(
        missingType.arena, missingType.typeSyntaxTypeIds, rightRoot, -1)
    assert(!typearena.TypedExprTypeArenaStrictValidateInto(missingType, err),
           "typed expr type arena: nested TypeId absence survived")
    typearena.TypedExprTypeArenaRelease(missingType)

    var missingSymbol = typearena.TypedExprTypeArenaClone(arena)
    arenamod.ArenaArrayInt32Set(
        missingSymbol.arena, missingSymbol.symbolIds, rightTypeId, -1)
    assert(!typearena.TypedExprTypeArenaStrictValidateInto(
               missingSymbol, err),
           "typed expr type arena: nested SymbolId absence survived")
    typearena.TypedExprTypeArenaRelease(missingSymbol)

    var forwardOwner = typearena.TypedExprTypeArenaClone(arena)
    arenamod.ArenaArrayInt32Set(
        forwardOwner.arena,
        forwardOwner.typeSyntaxDeclarationOwnerNodeIndexes,
        leftRoot,
        rightRoot)
    assert(!typearena.TypedExprTypeArenaStrictValidateInto(forwardOwner, err),
           "typed expr type arena: nested owner forward edge survived")
    typearena.TypedExprTypeArenaRelease(forwardOwner)

    var ownerCycle = typearena.TypedExprTypeArenaClone(arena)
    arenamod.ArenaArrayInt32Set(
        ownerCycle.arena,
        ownerCycle.typeSyntaxDeclarationOwnerNodeIndexes,
        rightRoot,
        rightRoot)
    assert(!typearena.TypedExprTypeArenaStrictValidateInto(ownerCycle, err),
           "typed expr type arena: nested owner cycle survived")
    typearena.TypedExprTypeArenaRelease(ownerCycle)
    typearena.TypedExprTypeArenaRelease(arena)
    parser.ParserValueExprTreeRelease(tree)
    echo("typed_expr_type_arena_nested_object_identity=1")
    echo("typed_expr_type_arena_nested_object_mutations=8")

fn main() =
    TypeArenaPositive()
    TypeArenaDeterministic()
    TypeArenaBracketAuthorityNegative()
    TypeArenaExactGenericApply()
    TypeArenaGenericArityNegative()
    TypeArenaNestedGenericApply()
    TypeArenaGenericAuthorityTamper()
    TypeArenaGenericParameterExactOwner()
    TypeArenaGenericConstraintDefaultExact()
    TypeArenaGenericTrailingDefaultAdmission()
    TypeArenaNestedGenericTraitSpecialization()
    TypeArenaGenericReceiptTamper()
    TypeArenaObjectEnumExact()
    TypeArenaObjectEnumMultiSourceExact()
    TypeArenaObjectInheritanceExact()
    TypeArenaNestedObjectIdentityExact()
    TypeArenaConstAuthorityNegative()
    TypeArenaEmptyComplete()
    TypeArenaMultiSourceExact()
    TypeArenaFunctionChildIdentityExact()
    TypeArenaNameIdentity()
    TypeArenaNominalRecursiveScc()
    TypeArenaNominalRecursiveNegative()
    TypeArenaSameSourceProductionAuthority()
    TypeArenaSameSourceAuthorityNegatives()
    TypeArenaPackageForestAuthority()
    TypeArenaPackageForestAuthorityNegatives()
    echo("typed_expr_type_arena_smoke: ok")
