import std/system as system

# Case probe 6: pin the exact predicate, and test the candidate minimal fix.
#
# Probe 5 showed a local seq grown inside a loop survives its scope while
# straight-line growth does not.  Two questions remain before touching the
# parser: does the leak need the loop back-edge to be TAKEN (>=2 iterations),
# and does pre-sizing the buffer outside the loop remove it?  The second one
# decides whether the parser-side minimal fix is `setLen` before the loop or
# something structural.
#
# Exit code packs one base-8 digit per worker; deltas are taken ACROSS the
# worker call in `main`.
#   digit0  while 8 iterations, 8 adds                 (expect 1 = leaks)
#   digit1  while 2 iterations, 2 adds                 (back-edge taken once)
#   digit2  while 1 iteration,  1 add                  (back-edge never taken)
#   digit3  setLen(values,16) before while 8 adds      (candidate fix)
#   digit4  while 8 adds then `= []`                   (control: expect 0)
#   digit5  for-range 8 adds                           (expect 1 = leaks)

var probeSink: int32

fn WorkerWhile8(count: int32): int32 =
    var values: int32[]
    var i: int32
    while i < count:
        add(values, i)
        i = i + 1
    return values.len + values[count - 1]

fn WorkerWhile2(): int32 =
    var values: int32[]
    var i: int32
    while i < 2:
        add(values, i)
        i = i + 1
    return values.len + values[1]

fn WorkerWhile1(): int32 =
    var values: int32[]
    var i: int32
    while i < 1:
        add(values, i)
        i = i + 1
    return values.len + values[0]

fn WorkerPreSized(count: int32): int32 =
    var values: int32[]
    setLen(values, count)
    var i: int32
    while i < count:
        values[i] = i
        i = i + 1
    return values.len + values[count - 1]

fn WorkerWhile8Explicit(count: int32): int32 =
    var values: int32[]
    var i: int32
    while i < count:
        add(values, i)
        i = i + 1
    let observed = values.len + values[count - 1]
    values = []
    return observed

fn WorkerFor8(): int32 =
    var values: int32[]
    for i in 0..<8:
        add(values, i)
    return values.len + values[7]

fn Digit(value: int64, weight: int64): int64 =
    if value < 0:
        return 7 * weight
    if value > 6:
        return 6 * weight
    return value * weight

fn main(): int32 =
    var acc: int32
    let b0 = system.MemLiveAllocations()
    acc = acc + WorkerWhile8(8)
    let d0 = system.MemLiveAllocations() - b0
    let b1 = system.MemLiveAllocations()
    acc = acc + WorkerWhile2()
    let d1 = system.MemLiveAllocations() - b1
    let b2 = system.MemLiveAllocations()
    acc = acc + WorkerWhile1()
    let d2 = system.MemLiveAllocations() - b2
    let b3 = system.MemLiveAllocations()
    acc = acc + WorkerPreSized(8)
    let d3 = system.MemLiveAllocations() - b3
    let b4 = system.MemLiveAllocations()
    acc = acc + WorkerWhile8Explicit(8)
    let d4 = system.MemLiveAllocations() - b4
    let b5 = system.MemLiveAllocations()
    acc = acc + WorkerFor8()
    let d5 = system.MemLiveAllocations() - b5
    probeSink = acc
    if acc <= 0:
        return 99
    let packed = Digit(d0, 1) +
                 Digit(d1, 8) +
                 Digit(d2, 64) +
                 Digit(d3, 512) +
                 Digit(d4, 4096) +
                 Digit(d5, 32768)
    return int32(packed)
