# memory_release_workload_runner
#
# Producer for one case of the production memory-release evidence contract.
# The gate freezes the argv this binary is executed with inside the Linux
# cgroup-v2 jail (cheng_memory_release_gate.ts workloadArgv):
#
#   argv[0] /cheng-memory-release/workload
#   argv[1] caseId          argv[2] targetTriple   argv[3] backend
#   argv[4] outcome         argv[5] /cheng-memory-release/driver
#   argv[6] driverBytesRaw32
#   argv[7] compilerSourceClosureRaw32
#   argv[8] workloadRunnerRaw32
#
# stdout is the runner receipt and nothing else. The receipt embeds the exact
# official-driver child receipt plus the frozen child argv and exit status.
# Component counters never originate in this wrapper.
import std/cmdline as cmdline
import std/os as os
import std/os_host_process as hostos
import cheng/core/tooling/memory_release_receipt as receipt

fn runnerFail(message: str) =
    panic(message)

fn runnerDriverArgv(caseId: str,
                    targetTriple: str,
                    backend: str,
                    outcome: str,
                    driverBytesRaw32: str,
                    compilerSourceClosureRaw32: str,
                    workloadRunnerRaw32: str): str[] =
    return [
        "memory-release-case",
        caseId,
        targetTriple,
        backend,
        outcome,
        "/cheng-memory-release/source-closure",
        driverBytesRaw32,
        compilerSourceClosureRaw32,
        workloadRunnerRaw32,
    ]

fn runnerExecuteOfficialDriver(driverPath: str,
                               driverArgv: var str[]): str =
    let child = hostos.ExecFileCapture(
        driverPath,
        driverArgv,
        [],
        "/cheng-memory-release",
        false,
        3600)
    let childExitCode = os.ExecCmdResultExitCode(child)
    let childStdout = os.ExecCmdResultOutput(child)
    if childExitCode != 0:
        runnerFail("memory_release_workload: official driver child failed")
    return receipt.MemoryReleaseRunnerReceiptCanonicalJson(
        driverPath,
        driverArgv,
        childExitCode,
        childStdout)

fn main(argc: int32, argv: str*): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    if cmdline.paramCount() != 9:
        runnerFail("memory_release_workload: frozen argv requires the nine-element production workload argv")
    let caseId = cmdline.paramStr(1)
    let targetTriple = cmdline.paramStr(2)
    let backend = cmdline.paramStr(3)
    let outcome = cmdline.paramStr(4)
    let driverPath = cmdline.paramStr(5)
    let driverBytesRaw32 = cmdline.paramStr(6)
    let compilerSourceClosureRaw32 = cmdline.paramStr(7)
    let workloadRunnerRaw32 = cmdline.paramStr(8)
    if driverPath != "/cheng-memory-release/driver":
        runnerFail("memory_release_workload: frozen driver path mismatch")
    if caseId != receipt.MemoryReleaseCaseId(targetTriple, backend, outcome):
        runnerFail("memory_release_workload: caseId does not match the case identity")
    var driverArgv = runnerDriverArgv(caseId,
                                      targetTriple,
                                      backend,
                                      outcome,
                                      driverBytesRaw32,
                                      compilerSourceClosureRaw32,
                                      workloadRunnerRaw32)
    let document = runnerExecuteOfficialDriver(driverPath, driverArgv)
    os.Write(os.GetStdout(), document)
    return 0
