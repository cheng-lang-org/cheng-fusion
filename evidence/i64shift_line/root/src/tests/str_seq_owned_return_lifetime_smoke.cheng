import std/seqs
import std/strings

fn relay(values: str[]): str[] =
    return values

fn buildValues(): str[] =
    var values: str[]
    seqs.Add(values, strings.CloneStr("alpha"))
    seqs.Add(values, strings.CloneStr("beta"))
    let result = relay(values)
    return result

fn main(): int32 =
    let values = buildValues()
    assert(values.len == 2, " owned str sequence return count")
    assert(values[0] == "alpha", " owned str sequence first value")
    assert(values[1] == "beta", " owned str sequence second value")
    echo("str_seq_owned_return_lifetime_smoke ok")
    return 0
