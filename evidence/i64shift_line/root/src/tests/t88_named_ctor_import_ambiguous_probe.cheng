import cheng/core/lang/typed_expr as texpr

fn AddField(ctx: var texpr.TypedExprSourceContext,
            ownerType: str,
            fieldName: str,
            offsetBytes: int32) =
    var field: texpr.TypedExprTypeFieldDecl
    field.ownerType = ownerType
    field.fieldName = fieldName
    field.fieldType = "int32"
    field.offsetBytes = offsetBytes
    field.sizeBytes = 4
    field.alignBytes = 4
    add(ctx.typeFields, field)

fn AddImport(ctx: var texpr.TypedExprSourceContext,
             qualifier: str,
             targetSourcePath: str) =
    var imported: texpr.TypedExprImportedModule
    imported.qualifier = qualifier
    imported.targetSourcePath = targetSourcePath
    add(ctx.importedModules, imported)

fn main(): int32 =
    var caller: texpr.TypedExprSourceContext
    caller.sourcePath = "/work/pkg/main.cheng"
    caller.moduleConstScanned = true
    AddImport(caller, "leftModel", "/work/pkg/left_model.cheng")
    AddImport(caller, "rightModel", "/work/pkg/right_model.cheng")

    var leftModel: texpr.TypedExprSourceContext
    leftModel.sourcePath = "/work/pkg/left_model.cheng"
    leftModel.moduleConstScanned = true
    add(leftModel.declaredTypes, "Clash")
    AddField(leftModel, "Clash", "value", 0)

    var rightModel: texpr.TypedExprSourceContext
    rightModel.sourcePath = "/work/pkg/right_model.cheng"
    rightModel.moduleConstScanned = true
    add(rightModel.declaredTypes, "Clash")
    AddField(rightModel, "Clash", "value", 0)

    var contexts: texpr.TypedExprSourceContext[]
    texpr.TypedExprSourceContextAppendMove(contexts, caller)
    texpr.TypedExprSourceContextAppendMove(contexts, leftModel)
    texpr.TypedExprSourceContextAppendMove(contexts, rightModel)
    let _index = texpr.TypedExprBuildIndexForContexts(contexts, 32)

    # Expected hard error: an unqualified named constructor may not choose
    # arbitrarily between two visible imported aggregate types.
    let _typeName = texpr.TypedExprNamedAggregateConstructorTypeInContext(
        contexts[0],
        contexts,
        "Clash",
        "value: 1")
    return 1
