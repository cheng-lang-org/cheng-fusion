import std/system as system

type ColdManagedExactFixedArrayStrOwner =
    labels: str[3]

fn ColdManagedExactFixedArrayStrNew(value: str): str =
    return system.NewStringCopy(
        system.StrDataPtr(value), value.len)

fn ColdManagedExactFixedArrayStrExercise(): int32 =
    var owner: ColdManagedExactFixedArrayStrOwner
    owner.labels[0] = ColdManagedExactFixedArrayStrNew("alpha")
    owner.labels[1] = ColdManagedExactFixedArrayStrNew("beta")
    owner.labels[2] = ColdManagedExactFixedArrayStrNew("gamma")

    owner.labels[1] = owner.labels[1]
    owner.labels[0] = ColdManagedExactFixedArrayStrNew("delta")
    owner.labels[2] = ""

    if owner.labels[0] != "delta" ||
       owner.labels[1] != "beta" ||
       len(owner.labels[2]) != 0:
        return 1
    return 0

fn main(): int32 =
    let allocBefore = system.memAllocCount()
    let freeBefore = system.memFreeCount()
    let liveBefore = system.memLiveCount()
    let retainBefore = system.memRetainCount()
    let releaseBefore = system.memReleaseCount()

    if ColdManagedExactFixedArrayStrExercise() != 0:
        return 1

    let allocDelta = system.memAllocCount() - allocBefore
    let freeDelta = system.memFreeCount() - freeBefore
    let retainDelta = system.memRetainCount() - retainBefore
    let releaseDelta = system.memReleaseCount() - releaseBefore
    if allocDelta <= int64(0) || allocDelta != freeDelta:
        return 2
    if system.memLiveCount() != liveBefore:
        return 3
    if releaseDelta != retainDelta + freeDelta:
        return 4
    echo("cold_managed_exact_fixed_array_str=PASS")
    return 0
