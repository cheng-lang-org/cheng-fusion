type
    Plan =
        entries: int32[]
        names: str[]

fn Reset(plan: var Plan) =
    plan.entries = []
    plan.names = []

fn RebuildSum(): int32 =
    var x: int32[]
    add(x, 7)
    add(x, 8)
    add(x, 9)
    if x.len != 3:
        return -1
    x = []
    if x.len != 0:
        return -2
    add(x, 5)
    if x.len != 1:
        return -3
    return x[0]

fn main(): int32 =
    if RebuildSum() != 5:
        return 1
    var p: Plan
    add(p.entries, 4)
    add(p.entries, 5)
    add(p.names, "a")
    if p.entries.len != 2:
        return 2
    Reset(p)
    if p.entries.len != 0:
        return 3
    if p.names.len != 0:
        return 4
    add(p.entries, 12)
    if p.entries.len != 1:
        return 5
    if p.entries[0] != 12:
        return 6
    return 0
