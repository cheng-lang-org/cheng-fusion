import std/result
import cheng/core/analysis/ownership_body_ir_production as production
import cheng/core/ir/core_types as coreir
import cheng/std/bytes_layout as layout

fn main(): int32 =
    var body = coreir.BodyIRNew()
    let parsed = layout.FixedBytes32FromHex(
        "2222222222222222222222222222222222222222222222222222222222222222")
    if IsErr(parsed):
        return 2
    let cid = Value(parsed)
    var slot: coreir.LocalSlot
    slot.id = 0
    slot.name = "borrowed"
    slot.typeKind = coreir.LocalStrTag
    slot.stackOffset = 0
    slot.sizeBytes = 24
    slot.alignBytes = 8
    coreir.BodyIRApplyLocalSlotDefaultProof(slot)
    add(body.localSlots, slot)
    let _ = coreir.BodyIRBindLocalSlotTypeArenaProof(
        body,
        0,
        cid,
        9,
        coreir.BodyManagedStorageManagedTag)
    let _ = coreir.BodyIRBindCanonicalTypeFact(
        body, cid, 9, 1, 1, -1, 0, 24, 8)
    var call: coreir.CallOp
    coreir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = "borrowed_fixture"
    call.resultSlot = 0
    call.resultPassKind = coreir.BodyCallPassSretResultTag
    call.resultOwnership = coreir.OwnBorrowShared
    call.resultExprNodeIndex = 77
    call.resultValueDefinitionRow = 77
    call.resultDefinitionOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    call.resultDefinitionOriginId = 77
    add(body.callSequence, call)
    var op: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = coreir.BodyOpCallTag
    op.target = 0
    op.valueDefSlot = 0
    op.valueDefExprNodeIndex = 77
    op.valueDefSemanticRow = 77
    op.valueDefOwnership = coreir.OwnBorrowShared
    op.valueDefOriginKind = coreir.BodyDefinitionOriginTypedExprTag
    op.valueDefOriginId = 77
    add(op.operands, 0)
    let _ = coreir.BodyIRAppendOp(body, op)
    var ownershipKinds: int32[]
    add(ownershipKinds, int32(coreir.OwnInvalid))
    coreir.BodyIRFreezeEntryDefinitionOwnershipKinds(
        body, ownershipKinds)
    var term: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = coreir.BodyTermReturnTag
    let termIndex = coreir.BodyIRAppendTerm(body, term)
    let _ = coreir.BodyIRAppendBlock(body, 0, 1, termIndex)
    coreir.BodyIRControlFlowBegin(body, 0)
    coreir.BodyIRControlFlowBindBlockScope(body, 0, 0)
    coreir.BodyIRControlFlowBindCallTarget(
        body,
        0,
        coreir.BodyCallTargetDomainFunctionTag,
        0,
        cid)
    var successors: int32[]
    var edgeKinds: int32[]
    coreir.BodyIRControlFlowBindTermSuccessors(
        body, termIndex, successors, edgeKinds)
    coreir.BodyIRControlFlowSeal(body)
    let _ = production.OwnershipBodyIrProductionApplyOwned(body)
    return 0
