# transfer-authority family negative repro: an owned str formal consumed by
# a first by-value call and then re-transferred by a second by-value call must
# stay rejected (spec: default-move parameter passing; the fix for the
# transfer-authority walls is source migration with @borrows/CloneStr, never
# a weakening of this gate).
import std/strings

fn taNegHelper(a: str): bool =
    return strings.Len(a) > 0

fn taNegProbe(s: str): bool =
    let x: bool = taNegHelper(s)
    let y: bool = taNegHelper(s)
    return x and y
