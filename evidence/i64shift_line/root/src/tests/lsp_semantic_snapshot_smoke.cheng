import std/os
import std/result
import std/strings
import std/strutils as strutil
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/csg_core/compiler_snapshot_cargo as snapshot_cargo
import cheng/core/tooling/lsp_server as lsp
import cheng/core/tooling/compiler_execution_stage_receipt as execution
import cheng/core/tooling/compiler_world as cworld
import cheng/core/tooling/semantic_snapshot as snapshot_core

fn TestCid(label: str): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(label.len)
    for index in 0..<label.len:
        layout.ByteBufAppendByte(buf, Int32(label[index]) & 255)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn TestExecutionForSourceBundle(
        sourceBundleCid: layout.FixedBytes32):
        execution.CompilerExecutionIdentity =
    return Value(execution.CompilerExecutionIdentityMake(
        "lsp-semantic-snapshot", sourceBundleCid,
        TestCid("materializer"), TestCid("grammar"),
        TestCid("compiler-source-closure"), TestCid("driver"),
        TestCid("toolchain"), TestCid("command"),
        "arm64-apple-darwin"))

fn TestExecution(): execution.CompilerExecutionIdentity =
    return TestExecutionForSourceBundle(TestCid("compiler-source-bundle"))

fn TestUniverse(): cworld.CompilerLocalUniverse =
    var universe: cworld.CompilerLocalUniverse
    var entries: cworld.CompilerUniverseManifestEntry[]
    var err: str
    assert(cworld.CompilerLocalUniverseBuildForChannelWithManifestEntriesInto(
        universe,
        err,
        "stable",
        TestExecution().sourceBundleRaw32,
        TestCid("compiler-csg-root"),
        TestCid("compiler-export-surface"),
        layout.FixedBytes32(),
        entries), err)
    return universe

fn AssertContentModified(ok: bool, err: str, operation: str) =
    assert(!ok && strings.StrContains(err, "content modified"),
           Fmt"lsp semantic snapshot: {operation} did not fail ContentModified: {err}")

fn AssertAllSemanticRequestsContentModified(
        workspace: var lsp.LspWorkspace,
        uri: str,
        line: int32,
        column: int32) =
    var err: str
    var definition: lsp.LspExactDefinitionResult
    AssertContentModified(
        lsp.LspWorkspaceExactDefinitionInto(
            workspace, uri, line, column, definition, err),
        err, "definition")

    err = ""
    var references: lsp.LspExactReferencesResult
    AssertContentModified(
        lsp.LspWorkspaceExactReferencesInto(
            workspace, uri, line, column, true, references, err),
        err, "references")

    err = ""
    var rename: lsp.LspExactRenameResult
    AssertContentModified(
        lsp.LspWorkspaceExactRenameInto(
            workspace, uri, line, column, "Renamed", rename, err),
        err, "rename")

    err = ""
    var hover: lsp.LspExactHoverResult
    AssertContentModified(
        lsp.LspWorkspaceExactHoverInto(
            workspace, uri, line, column, hover, err),
        err, "hover")

    err = ""
    var completion: lsp.LspExactCompletionResult
    AssertContentModified(
        lsp.LspWorkspaceExactCompletionInto(
            workspace, uri, line, column, completion, err),
        err, "completion")

    err = ""
    var lineMap: lsp.LspExactLineMapResult
    AssertContentModified(
        lsp.LspWorkspaceExactLineMapInto(
            workspace, uri, lineMap, err),
        err, "lineMap")

fn AssertRejectedDiagnostics(
        workspace: var lsp.LspWorkspace,
        uri: str,
        sourceVersion: int64) =
    var diagnostics: lsp.LspExactDiagnosticsResult
    var err: str
    assert(lsp.LspWorkspaceExactDiagnosticsInto(
               workspace, uri, diagnostics, err), err)
    assert(diagnostics.receipt.rejected,
           "lsp semantic snapshot: rejection receipt not marked rejected")
    assert(diagnostics.receipt.sourceVersion == sourceVersion,
           "lsp semantic snapshot: rejection source version mismatch")
    assert(diagnostics.items.len == 1,
           "lsp semantic snapshot: rejection diagnostic count mismatch")
    assert(workspace.snapshotStore.rejectionFacts.len > 0,
           "lsp semantic snapshot: rejection facts missing")
    let latestFacts = workspace.snapshotStore.rejectionFacts[
        workspace.snapshotStore.rejectionFacts.len - 1]
    assert(latestFacts.structuredDiagnosticArtifact.producerKinds.len == 0,
           "lsp semantic snapshot: artifact leaked producer authority")
    assert(diagnostics.items[0].severity == 1 &&
           diagnostics.items[0].code != "" &&
           diagnostics.items[0].message != "",
           "lsp semantic snapshot: rejection diagnostic payload missing")
    assert(!layout.FixedBytes32Equal(
               diagnostics.receipt.failureDiagnosticRootCid,
               layout.FixedBytes32()),
           "lsp semantic snapshot: failure diagnostic root missing")
    assert(!layout.FixedBytes32Equal(
               diagnostics.receipt.failureCargoCid,
               layout.FixedBytes32()),
           "lsp semantic snapshot: failure cargo missing")
    let assessmentCompleted =
        (latestFacts.completedStageBitmap &
             snapshot_cargo.CsgCompilerSnapshotFailureStageAssessment) != 0
    assert(assessmentCompleted ==
               !layout.FixedBytes32Equal(
                   diagnostics.receipt.failureAdmissionReceiptCid,
                   layout.FixedBytes32()),
           "lsp semantic snapshot: failure admission stage mismatch")
    assert((latestFacts.structuredDiagnosticAuthority.authorityKinds.len > 0) ==
               !layout.FixedBytes32Equal(
                   diagnostics.receipt.failureParserDiagnosticAuthorityRootCid,
                   layout.FixedBytes32()),
           "lsp semantic snapshot: parser diagnostic authority stage mismatch")
    assert(strings.StrContains(
               diagnostics.items[0].message,
               Fmt"source_version={sourceVersion}"),
           "lsp semantic snapshot: rejection source version detail missing")

fn AssertUnpublishedCurrentVersion(
        workspace: lsp.LspWorkspace,
        sourceVersion: int64) =
    assert(workspace.eventState.lastAcceptedSourceVersion == sourceVersion &&
           workspace.snapshotStore.core.currentSourceVersion == sourceVersion &&
           workspace.snapshotStore.core.publishedIndex < 0 &&
           workspace.snapshotStore.core.candidateIndex == -1 &&
           workspace.snapshotStore.core.states.len > 0 &&
           workspace.snapshotStore.core.sourceVersions[
               workspace.snapshotStore.core.sourceVersions.len - 1] ==
               sourceVersion &&
           workspace.snapshotStore.core.states[
               workspace.snapshotStore.core.states.len - 1] ==
               snapshot_core.SemanticSnapshotStateRejected &&
           workspace.snapshotStore.rejectionFacts.len > 0 &&
           workspace.snapshotStore.rejectionFacts[
               workspace.snapshotStore.rejectionFacts.len - 1].sourceVersion ==
               sourceVersion &&
           workspace.metrics.candidatePublishedCount == int64(0),
           Fmt"lsp semantic snapshot: sourceVersion {sourceVersion} was not fail-closed")

fn main() =
    let workspaceRoot = "/tmp/cheng_lsp_semantic_snapshot_fixture"
    let packageRoot = workspaceRoot
    let sourceRoot = strutil.Join([workspaceRoot, "/src"], "")
    let sourceMain = strutil.Join([sourceRoot, "/main.cheng"], "")
    let sourceHelper = strutil.Join([sourceRoot, "/helper.cheng"], "")
    let uriMain = "file:///tmp/cheng_lsp_semantic_snapshot_fixture/src/main.cheng"
    let uriHelper = "file:///tmp/cheng_lsp_semantic_snapshot_fixture/src/helper.cheng"
    let textMain = strutil.Join([
        "import pkg/helper as helper\n\n",
        "fn Main(): int32 =\n",
        "    return helper.Answer()\n"], "")
    let textHelper = strutil.Join([
        "fn Answer(): int32 =\n",
        "    return 7\n"], "")
    let sealedBaseText = "disk bytes must never feed CompilerCSG\n"

    os.MkdirAll(sourceRoot, 493)
    os.WriteFile(
        strutil.Join([workspaceRoot, "/cheng-package.toml"], ""),
        "disk manifest must never feed exact CompilerCSG\n")
    os.WriteFile(sourceMain, sealedBaseText)
    os.WriteFile(sourceHelper, sealedBaseText)

    var workspace: lsp.LspWorkspace
    var err: str
    var invalidWorkspace: lsp.LspWorkspace
    assert(!lsp.LspWorkspaceInitInto(
                TestCid("lsp-semantic-snapshot/invalid-session"),
                cworld.CompilerLocalUniverse(), TestExecution(),
                invalidWorkspace, err),
           "lsp semantic snapshot: absent world head accepted")
    var forgedUniverse = TestUniverse()
    forgedUniverse.worldHead.headCid =
        TestCid("lsp-semantic-snapshot/forged-world-head")
    assert(!lsp.LspWorkspaceInitInto(
                TestCid("lsp-semantic-snapshot/invalid-session"),
                forgedUniverse, TestExecution(), invalidWorkspace, err),
           "lsp semantic snapshot: forged world head accepted")
    var forgedExecution = TestExecution()
    forgedExecution.executionRaw32 =
        TestCid("lsp-semantic-snapshot/forged-execution")
    assert(!lsp.LspWorkspaceInitInto(
                TestCid("lsp-semantic-snapshot/invalid-session"),
                TestUniverse(), forgedExecution,
                invalidWorkspace, err),
           "lsp semantic snapshot: forged compiler execution accepted")
    let mismatchedExecution = TestExecutionForSourceBundle(
        TestCid("other-compiler-source-bundle"))
    assert(!lsp.LspWorkspaceInitInto(
                TestCid("lsp-semantic-snapshot/invalid-session"),
                TestUniverse(), mismatchedExecution,
                invalidWorkspace, err) &&
           strings.StrContains(err, "source bundle mismatch"),
           "lsp semantic snapshot: universe/execution source split accepted")
    assert(lsp.LspWorkspaceInitInto(
               TestCid("lsp-semantic-snapshot/session"),
               TestUniverse(),
               TestExecution(), workspace, err), err)
    assert(lsp.LspWorkspaceBindDocumentCompilerIdentityInto(
               workspace,
               uriHelper,
               workspaceRoot,
               packageRoot,
               "pkg",
               "arm64-apple-darwin",
               sourceHelper,
               "pkg/helper",
               false,
               err), err)
    assert(lsp.LspWorkspaceBindDocumentCompilerIdentityInto(
               workspace,
               uriMain,
               workspaceRoot,
               packageRoot,
               "pkg",
               "arm64-apple-darwin",
               sourceMain,
               "pkg/main",
               true,
               err), err)

    var sourceVersion: int64
    assert(lsp.LspWorkspaceDidOpenInto(
               workspace, uriHelper, int64(1), textHelper,
               sourceVersion, err), err)
    assert(sourceVersion == int64(1),
           "lsp semantic snapshot: helper didOpen version drift")
    AssertUnpublishedCurrentVersion(workspace, int64(1))
    AssertAllSemanticRequestsContentModified(workspace, uriHelper, 0, 3)
    AssertRejectedDiagnostics(workspace, uriHelper, int64(1))

    assert(lsp.LspWorkspaceDidOpenInto(
               workspace, uriMain, int64(1), textMain,
               sourceVersion, err), err)
    assert(sourceVersion == int64(2),
           "lsp semantic snapshot: main didOpen version drift")
    AssertUnpublishedCurrentVersion(workspace, int64(2))
    let exactRejectionIndex =
        workspace.snapshotStore.rejectionFacts.len - 1
    assert(exactRejectionIndex >= 0 &&
           workspace.snapshotStore.rejectionFacts[
               exactRejectionIndex].dependencySourceIds.len == 1 &&
           workspace.snapshotStore.rejectionFacts[
               exactRejectionIndex].dependencyTargetSourceIds.len == 1 &&
           workspace.snapshotStore.rejectionFacts[
               exactRejectionIndex].dependencyProducerRows.len == 1 &&
           workspace.snapshotStore.rejectionFacts[
               exactRejectionIndex].dependencyProducerRows[0] >= 0 &&
           workspace.snapshotStore.rejectionFacts[
               exactRejectionIndex].dependencySourceIds[0] !=
               workspace.snapshotStore.rejectionFacts[
                   exactRejectionIndex].dependencyTargetSourceIds[0],
           "lsp semantic snapshot: exact dependency facts missing")
    AssertAllSemanticRequestsContentModified(workspace, uriMain, 3, 18)
    AssertRejectedDiagnostics(workspace, uriMain, int64(2))

    var change: lsp.LspContentChange
    change.rangePresent = true
    change.startLine = 1
    change.startCharacter = 11
    change.endLine = 1
    change.endCharacter = 12
    change.rangeLengthPresent = true
    change.rangeLength = 1
    change.text = "8"
    assert(lsp.LspWorkspaceDidChangeInto(
               workspace, uriHelper, int64(2), [change],
               sourceVersion, err), err)
    assert(sourceVersion == int64(3) &&
           workspace.documents[0].sourceText ==
               "fn Answer(): int32 =\n    return 8\n",
           "lsp semantic snapshot: didChange version or overlay drift")
    AssertUnpublishedCurrentVersion(workspace, int64(3))
    AssertAllSemanticRequestsContentModified(workspace, uriMain, 3, 18)
    AssertRejectedDiagnostics(workspace, uriMain, int64(3))

    assert(lsp.LspWorkspaceDidCloseInto(
               workspace, uriHelper, sourceVersion, err), err)
    assert(sourceVersion == int64(4) &&
           !workspace.documents[0].open &&
           workspace.documents[0].text == "" &&
           workspace.documents[0].sourceText == sealedBaseText,
           "lsp semantic snapshot: didClose version or sealed base drift")
    AssertUnpublishedCurrentVersion(workspace, int64(4))
    AssertAllSemanticRequestsContentModified(workspace, uriMain, 3, 18)
    AssertRejectedDiagnostics(workspace, uriMain, int64(4))

    assert(workspace.metrics.candidateAttemptCount == int64(4) &&
           workspace.metrics.candidateRejectedCount == int64(4) &&
           workspace.metrics.candidatePublishedCount == int64(0) &&
           workspace.metrics.parserBuildObserved &&
           workspace.metrics.compilerCsgBuildObserved &&
           workspace.metrics.compilerSnapshotBuilderAttemptCount > int64(0) &&
           workspace.metrics.explicitSourceFileReadCount == int64(2) &&
           workspace.metrics.explicitSourceFileReadBytes ==
               int64(sealedBaseText.len) * int64(2) &&
           workspace.snapshotStore.core.states.len == 4 &&
           workspace.snapshotStore.rejectionSnapshotIndexes.len == 4 &&
           workspace.snapshotStore.core.states[3] ==
               snapshot_core.SemanticSnapshotStateRejected &&
           !layout.FixedBytes32Equal(
               workspace.candidateAdmissionReceiptCid,
               layout.FixedBytes32()) &&
           workspace.candidateAdmissionCompletedStageBitmap != 0 &&
           workspace.candidateAdmissionMissingFactBitmap == 477 &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "missing_fact_bitmap=477") &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "type_arena_bindings=0") &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "type_arena_resolution_authorities=0") &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "source_interfaces=") &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "symbol_interfaces=") &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "function_interfaces=") &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "typed_node_proofs=") &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "reference_proofs=") &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "lexical_scope_proofs=") &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "dependency_proofs=") &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "diagnostic_proofs="),
           Fmt"lsp semantic snapshot: producer metrics drift attempts={workspace.metrics.candidateAttemptCount} rejected={workspace.metrics.candidateRejectedCount} published={workspace.metrics.candidatePublishedCount} builder={workspace.metrics.compilerSnapshotBuilderAttemptCount} reads={workspace.metrics.explicitSourceFileReadCount} blocked={workspace.candidateBlockedReason}")

    assert(lsp.LspWorkspaceReleaseInto(workspace, err) &&
           !workspace.initialized &&
           layout.FixedBytes32Equal(
               workspace.compilerUniverse.worldHead.headCid,
               layout.FixedBytes32()),
           "lsp semantic snapshot: release retained compiler universe")
    os.WriteLine(os.Get_stdout(), "lsp_semantic_snapshot_smoke: ok")
