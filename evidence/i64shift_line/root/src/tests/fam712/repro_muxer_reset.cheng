import cheng/libp2p/muxers/muxer as mx

fn main(): int32 =
    var st: mx.MuxerState
    st.streams[3].active = true
    st.streams[3].closedLocal = true
    st.streams[3].closedRemote = true
    st.streams[3].reset = true
    st.streams[3].id = 77
    st.streams[3].initiatorLocal = true
    st.streams[3].buffer.closed = true
    mx.muxerResetStreams(st)
    assert(st.streams[3].active == false, " fam712: active reset")
    assert(st.streams[3].closedLocal == false, " fam712: closedLocal reset")
    assert(st.streams[3].closedRemote == false, " fam712: closedRemote reset")
    assert(st.streams[3].reset == false, " fam712: reset flag reset")
    assert(st.streams[3].id == 0, " fam712: id reset")
    assert(st.streams[3].initiatorLocal == false, " fam712: initiatorLocal reset")
    assert(st.streams[3].buffer.closed == false, " fam712: buffer replaced with fresh (closed=false) BufferStream")
    return 0
