type
    R23BProfile =
        text: str
        lines: str[]

fn R23BRewrite(textRaw: str, rewrittenOut: var str, err: var str): bool =
    if textRaw == "":
        err = "empty source text"
        return false
    rewrittenOut = textRaw
    err = ""
    return true

fn R23BSplit(textRaw: str): str[] =
    var out: str[]
    add(out, textRaw)
    return out

fn R23BBuild(text: str, profile: var R23BProfile, err: var str): bool =
    var normalizedText: str
    if !R23BRewrite(text, normalizedText, err):
        return false
    profile.text = share(normalizedText)
    let lines = R23BSplit(normalizedText)
    profile.lines = lines
    return true

fn main(): int32 =
    var profile: R23BProfile
    var err: str
    if !R23BBuild("alpha", profile, err):
        return 10
    echo("r23 b ok")
    return 0
