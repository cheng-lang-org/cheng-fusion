import std/system

fn main(): int32 =
    let ok: int32 = 1
    let fail: int32 = 0

    // String ternary as standalone value
    let t1: str = ok != 0 ? "exists" : "missing"
    assert(t1 == "exists", " ternary: true branch")

    let t2: str = fail != 0 ? "yes" : "no"
    assert(t2 == "no", " ternary: false branch")

    // Nested ternary
    let mode: int32 = 2
    let t3: str = mode == 1 ? "a" : mode == 2 ? "b" : "c"
    assert(t3 == "b", " ternary: nested")

    // Ternary with int result
    let v: int32 = ok != 0 ? 42 : 0
    assert(v == 42, " ternary: int true")
    let v2: int32 = fail != 0 ? 42 : 99
    assert(v2 == 99, " ternary: int false")

    // Note: echo(cond ? "a" : "b") has a known parser position issue;
    // use let binding as workaround until fixed.

    echo("cold_smoke_string_ternary ok")
    return 0
