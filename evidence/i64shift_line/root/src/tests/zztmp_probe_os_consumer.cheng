# probe_int32_decl_family.cheng — int32 decl 族 × int64 impl 消费方探针
# 镜像 os.cheng:380-381 的 int32 decl,验证 libc_send/libc_recv impl 改 int64 后,
# int32 decl 消费方(调用方读 w0, 确定性截断)编译与行为不变: 死 fd 仍收 -1。
import std/strings

@importc("libc_send")
fn libc_send_i32(fd: int32, payload: ptr, payloadLen: int32, flags: int32): int32
@importc("libc_recv")
fn libc_recv_i32(fd: int32, payload: ptr, payloadLen: int32, flags: int32): int32
@importc("libc_socket")
fn libc_socket(domain: int32, typ: int32, protocol: int32): int32
@importc("libc_close")
fn libc_close(fd: int32): int32
@importc("malloc")
fn rawMalloc(size: int64): ptr

fn main(): int32 =
    let buf = rawMalloc(64)
    if buf == nil:
        return 2
    let sock = libc_socket(2, 1, 6)
    if sock < 0:
        return 3
    let closedRc = libc_close(sock)
    if closedRc != 0:
        return 4
    let sendRc: int32 = libc_send_i32(sock, buf, 16, 0)
    echo(Fmt"send_i32_deadfd={strings.IntToStr(sendRc)}")
    let recvRc: int32 = libc_recv_i32(sock, buf, 16, 0)
    echo(Fmt"recv_i32_deadfd={strings.IntToStr(recvRc)}")
    if sendRc == -1 && recvRc == -1:
        echo("probe_int32_decl_family ok")
        return 0
    echo("probe_int32_decl_family FAIL")
    return 1
