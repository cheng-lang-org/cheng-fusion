import cheng/core/lang/parser as parser
import cheng/core/tooling/compiler_parser_receipt as parser_receipt
import cheng/std/bytes_layout as layout

fn FfiHandleSource(): str =
    return """
@ffi_handle(unwind=no_unwind, arg1=consume, result=produce, arg0=borrow)
@importc("ffi_multi")
fn Multi(left: uint64, right: uint64): uint64

@ffi_handle(unwind=no_unwind, arg0=borrow)
@importc("ffi_observe")
fn Observe(handle: uint64): uint32
"""

fn BuildExactSidecar(): parser_receipt.ParserCanonicalSourceSidecar =
    let source = FfiHandleSource()
    var declarations: parser.NormalizedFunctionDecl[]
    var err: str
    assert(parser.ParserReadNormalizedFunctionDecls(
               source, declarations, err) && declarations.len == 2,
           Fmt"parser ffi sidecar declarations failed: {err}")
    var tree: parser.ParserValueExprTree
    assert(parser.ParserValueExprReadTreeFromText(source, tree, err),
           Fmt"parser ffi sidecar tree failed: {err}")
    var identities: parser_receipt.ParserNormalizedExprFunctionIdentity[]
    var sidecar: parser_receipt.ParserCanonicalSourceSidecar
    let built = parser_receipt.ParserCanonicalSourceSidecarBuildInto(
        0,
        source,
        source,
        tree,
        identities,
        declarations,
        sidecar,
        err)
    parser.ParserValueExprTreeRelease(tree)
    assert(built, Fmt"parser ffi sidecar build failed: {err}")
    assert(parser_receipt.ParserCanonicalSourceSidecarStrictValidateInto(
               sidecar, err),
           Fmt"parser ffi sidecar strict validation failed: {err}")
    return sidecar

fn AssertSealRejected(
        candidate: var parser_receipt.ParserCanonicalSourceSidecar,
        label: str) =
    var err: str
    assert(!parser_receipt.ParserCanonicalSourceSidecarSealInto(
               candidate, err),
           Fmt"parser ffi sidecar mutation survived: {label}")

fn main() =
    let sidecar = BuildExactSidecar()
    assert(sidecar.ffiHandleContractProducerSourceIds.len == 2 &&
           sidecar.ffiHandleContractFunctionDeclarationSourceLocalRows.len ==
               2 &&
           sidecar.ffiHandleContractAnnotationSourceLocalRows.len == 2 &&
           sidecar.ffiHandleContractUnwindKinds.len == 2 &&
           sidecar.ffiHandleContractResultEffects.len == 2 &&
           sidecar.ffiHandleContractParameterStarts.len == 2 &&
           sidecar.ffiHandleContractParameterCounts.len == 2 &&
           sidecar.ffiHandleParserContractCids.len == 2 &&
           sidecar.ffiHandleParameterOrdinals.len == 3 &&
           sidecar.ffiHandleParameterDeclarationSourceLocalRows.len == 3 &&
           sidecar.ffiHandleParameterEffects.len == 3,
           "parser ffi sidecar CSR shape mismatch")
    assert(sidecar.ffiHandleContractProducerSourceIds[0] == 0 &&
           sidecar.ffiHandleContractProducerSourceIds[1] == 0 &&
           sidecar.ffiHandleContractFunctionDeclarationSourceLocalRows[0] <
               sidecar.ffiHandleContractFunctionDeclarationSourceLocalRows[1] &&
           sidecar.ffiHandleContractAnnotationSourceLocalRows[0] !=
               sidecar.ffiHandleContractAnnotationSourceLocalRows[1],
           "parser ffi sidecar exact owner rows missing")
    assert(sidecar.ffiHandleContractUnwindKinds[0] ==
               Int32(parser.NormalizedFfiHandleUnwindNoUnwind) &&
           sidecar.ffiHandleContractUnwindKinds[1] ==
               Int32(parser.NormalizedFfiHandleUnwindNoUnwind) &&
           sidecar.ffiHandleContractResultEffects[0] ==
               Int32(parser.NormalizedFfiHandleEffectProduce) &&
           sidecar.ffiHandleContractResultEffects[1] ==
               Int32(parser.NormalizedFfiHandleEffectInvalid) &&
           sidecar.ffiHandleContractParameterStarts[0] == 0 &&
           sidecar.ffiHandleContractParameterCounts[0] == 2 &&
           sidecar.ffiHandleContractParameterStarts[1] == 2 &&
           sidecar.ffiHandleContractParameterCounts[1] == 1 &&
           sidecar.ffiHandleParameterOrdinals[0] == 0 &&
           sidecar.ffiHandleParameterOrdinals[1] == 1 &&
           sidecar.ffiHandleParameterOrdinals[2] == 0 &&
           sidecar.ffiHandleParameterEffects[0] ==
               Int32(parser.NormalizedFfiHandleEffectBorrow) &&
           sidecar.ffiHandleParameterEffects[1] ==
               Int32(parser.NormalizedFfiHandleEffectConsume) &&
           sidecar.ffiHandleParameterEffects[2] ==
               Int32(parser.NormalizedFfiHandleEffectBorrow),
           "parser ffi sidecar effect projection mismatch")
    assert(!layout.FixedBytes32Equal(
               sidecar.ffiHandleParserContractCids[0],
               layout.FixedBytes32()) &&
           !layout.FixedBytes32Equal(
               sidecar.ffiHandleParserContractCids[1],
               layout.FixedBytes32()) &&
           !layout.FixedBytes32Equal(
               sidecar.ffiHandleParserContractCids[0],
               sidecar.ffiHandleParserContractCids[1]),
           "parser ffi sidecar contract CID missing")

    var clone = parser_receipt.ParserCanonicalSourceSidecarClone(sidecar)
    var cloneErr: str
    assert(parser_receipt.ParserCanonicalSourceSidecarStrictValidateInto(
               clone, cloneErr) &&
           layout.FixedBytes32Equal(clone.sidecarRaw32, sidecar.sidecarRaw32),
           Fmt"parser ffi sidecar clone invalid: {cloneErr}")
    parser_receipt.ParserCanonicalSourceSidecarRelease(clone)
    assert(clone.ffiHandleContractProducerSourceIds.len == 0 &&
           clone.ffiHandleContractUnwindKinds.len == 0 &&
           clone.ffiHandleParameterOrdinals.len == 0,
           "parser ffi sidecar release retained contract storage")

    var wrongFunction =
        parser_receipt.ParserCanonicalSourceSidecarClone(sidecar)
    wrongFunction.ffiHandleContractFunctionDeclarationSourceLocalRows[0] =
        wrongFunction.ffiHandleContractFunctionDeclarationSourceLocalRows[0] + 1
    AssertSealRejected(wrongFunction, "function_row")

    var wrongAnnotation =
        parser_receipt.ParserCanonicalSourceSidecarClone(sidecar)
    wrongAnnotation.ffiHandleContractAnnotationSourceLocalRows[0] =
        wrongAnnotation.ffiHandleContractAnnotationSourceLocalRows[0] + 1
    AssertSealRejected(wrongAnnotation, "annotation_row")

    var wrongUnwind =
        parser_receipt.ParserCanonicalSourceSidecarClone(sidecar)
    wrongUnwind.ffiHandleContractUnwindKinds[0] =
        Int32(parser.NormalizedFfiHandleUnwindInvalid)
    AssertSealRejected(wrongUnwind, "unwind_kind")

    var wrongParameter =
        parser_receipt.ParserCanonicalSourceSidecarClone(sidecar)
    wrongParameter.ffiHandleParameterDeclarationSourceLocalRows[0] =
        wrongParameter.ffiHandleParameterDeclarationSourceLocalRows[0] + 1
    AssertSealRejected(wrongParameter, "parameter_row")

    var wrongOrdinal =
        parser_receipt.ParserCanonicalSourceSidecarClone(sidecar)
    wrongOrdinal.ffiHandleParameterOrdinals[0] = 1
    AssertSealRejected(wrongOrdinal, "ordinal")

    var wrongEffect =
        parser_receipt.ParserCanonicalSourceSidecarClone(sidecar)
    wrongEffect.ffiHandleParameterEffects[0] =
        Int32(parser.NormalizedFfiHandleEffectProduce)
    AssertSealRejected(wrongEffect, "effect")

    var wrongOrder =
        parser_receipt.ParserCanonicalSourceSidecarClone(sidecar)
    let priorOrdinal = wrongOrder.ffiHandleParameterOrdinals[0]
    let priorDeclaration =
        wrongOrder.ffiHandleParameterDeclarationSourceLocalRows[0]
    let priorEffect = wrongOrder.ffiHandleParameterEffects[0]
    wrongOrder.ffiHandleParameterOrdinals[0] =
        wrongOrder.ffiHandleParameterOrdinals[1]
    wrongOrder.ffiHandleParameterDeclarationSourceLocalRows[0] =
        wrongOrder.ffiHandleParameterDeclarationSourceLocalRows[1]
    wrongOrder.ffiHandleParameterEffects[0] =
        wrongOrder.ffiHandleParameterEffects[1]
    wrongOrder.ffiHandleParameterOrdinals[1] = priorOrdinal
    wrongOrder.ffiHandleParameterDeclarationSourceLocalRows[1] =
        priorDeclaration
    wrongOrder.ffiHandleParameterEffects[1] = priorEffect
    AssertSealRejected(wrongOrder, "effect_order")

    var wrongCid = parser_receipt.ParserCanonicalSourceSidecarClone(sidecar)
    wrongCid.ffiHandleParserContractCids[0].data[0] = uint8(
        Int32(wrongCid.ffiHandleParserContractCids[0].data[0]) ^ 1)
    AssertSealRejected(wrongCid, "contract_cid")

    var reparsed: parser_receipt.ParserCanonicalSourceSidecar
    var declarations: parser.NormalizedFunctionDecl[]
    var identities: parser_receipt.ParserNormalizedExprFunctionIdentity[]
    var err: str
    assert(parser.ParserReadNormalizedFunctionDecls(
               FfiHandleSource(), declarations, err), err)
    assert(!parser_receipt.ParserCanonicalSourceSidecarBuildFromSourceInto(
               0,
               FfiHandleSource(),
               false,
               identities,
               declarations,
               reparsed,
               err),
           "parser ffi sidecar source-reparse path survived")

    echo("parser_canonical_ffi_handle_sidecar_contract_rows=2")
    echo("parser_canonical_ffi_handle_sidecar_no_unwind_rows=2")
    echo("parser_canonical_ffi_handle_sidecar_effect_rows=3")
    echo("parser_canonical_ffi_handle_sidecar_mutations_rejected=8")
    echo("parser_canonical_ffi_handle_sidecar_reparse_rejected=1")
    echo("parser_canonical_ffi_handle_sidecar_smoke: ok")

main()
