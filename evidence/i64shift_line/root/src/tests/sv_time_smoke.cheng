import cheng/game/assets/semantic_video/svtime

# T2 时间合同冒烟：真实样例 timebase（1/12288、1/90000、1/1000000）、
# 巨型 tick（9e18 量级）防溢出、左闭右开区间语义、不可精确换算拒绝。

fn main(): int32 =
    # 1/12288 vs 1/1000000（存量样例 sample.mp4 / hgs_faststart.mp4 的真实 timebase）
    assert(svtime.SvTickCmp(1, 12288, int64(12288), 1, 1000000, int64(1000000)) == 0,
        " 12288 vs 1e6: 1s equal")
    assert(svtime.SvTickCmp(1, 12288, int64(6144), 1, 1000000, int64(500000)) == 0,
        " 12288 vs 1e6: 0.5s equal")
    assert(svtime.SvTickCmp(1, 12288, int64(12288), 1, 1000000, int64(999999)) == 1,
        " 12288 vs 1e6: 1s gt 0.999999s")
    assert(svtime.SvTickCmp(1, 12288, int64(12287), 1, 1000000, int64(1000000)) == -1,
        " 12288 vs 1e6: 12287 lt 1s")

    # 1/90000 vs 1/1000000（MPEG TS 常规 timebase）
    assert(svtime.SvTickCmp(1, 90000, int64(90000), 1, 1000000, int64(1000000)) == 0,
        " 90000 vs 1e6: 1s equal")
    assert(svtime.SvTickCmp(1, 90000, int64(90001), 1, 1000000, int64(1000000)) == 1,
        " 90000 vs 1e6: 90001 gt 1s")

    # tbNum > 1 的非单位 timebase
    assert(svtime.SvTickCmp(30, 1, int64(5), 1, 1, int64(150)) == 0,
        " 30/1 vs 1/1: 150s equal")
    assert(svtime.SvTickCmp(30, 1, int64(5), 1, 1, int64(151)) == -1,
        " 30/1 vs 1/1: 150 lt 151")
    assert(svtime.SvTickCmp(3, 1, int64(3000000000000000000),
        2, 1, int64(4500000000000000000)) == 0,
        " 3/1 vs 2/1 giant equal")

    # 巨型 tick（9e18 量级）：交叉积 9e24 远超 int64，必须不溢出且结果精确
    assert(svtime.SvTickCmp(1, 1000000, int64(9000000000000000000),
        1, 1000000, int64(9000000000000000000)) == 0,
        " giant equal same timebase")
    assert(svtime.SvTickCmp(1, 1000000, int64(9000000000000000001),
        1, 1000000, int64(9000000000000000000)) == 1,
        " giant adjacent gt")
    assert(svtime.SvTickCmp(1, 12288, int64(9000000000000000000),
        1, 1000000, int64(9000000000000000000)) == 1,
        " giant cross timebase gt")
    assert(svtime.SvTickCmp(3, 1, int64(9000000000000000000),
        1, 1, int64(26999999999999999999)) == 1,
        " giant tbNum3 vs 26999... gt")

    # 左闭右开区间：相等/相邻/重叠/包含
    assert(svtime.SvIntervalOverlap(int64(0), int64(10), int64(10), int64(20)) == false,
        " overlap adjacent false")
    assert(svtime.SvIntervalOverlap(int64(0), int64(10), int64(9), int64(20)) == true,
        " overlap touching true")
    assert(svtime.SvIntervalOverlap(int64(0), int64(10), int64(0), int64(10)) == true,
        " overlap self true")
    assert(svtime.SvIntervalOverlap(int64(5), int64(5), int64(0), int64(10)) == false,
        " overlap empty interval false")
    assert(svtime.SvIntervalOverlap(int64(20), int64(30), int64(0), int64(10)) == false,
        " overlap disjoint false")
    assert(svtime.SvIntervalContains(int64(0), int64(10), int64(0), int64(10)) == true,
        " contains self true")
    assert(svtime.SvIntervalContains(int64(0), int64(10), int64(1), int64(10)) == true,
        " contains inner true")
    assert(svtime.SvIntervalContains(int64(0), int64(10), int64(0), int64(11)) == false,
        " contains overshoot false")
    assert(svtime.SvIntervalContains(int64(0), int64(10), int64(10), int64(12)) == false,
        " contains right-open false")
    assert(svtime.SvIntervalContainsTick(int64(0), int64(10), int64(0)) == true,
        " point left edge in")
    assert(svtime.SvIntervalContainsTick(int64(0), int64(10), int64(9)) == true,
        " point last in")
    assert(svtime.SvIntervalContainsTick(int64(0), int64(10), int64(10)) == false,
        " point right edge out")

    # 精确换算：整除表示必须成功
    let r1 = svtime.SvTickConvert(int64(90000), 1, 90000, 1, 1000000)
    assert(r1.ok, " convert 1s 90000 to 1e6 ok")
    assert(r1.value == int64(1000000), " convert 1s 90000 to 1e6 value")
    let r2 = svtime.SvTickConvert(int64(12288), 1, 12288, 1, 1000000)
    assert(r2.ok, " convert 1s 12288 to 1e6 ok")
    assert(r2.value == int64(1000000), " convert 1s 12288 to 1e6 value")
    let r3 = svtime.SvTickConvert(int64(63000), 1, 90000, 1, 1000000)
    assert(r3.ok, " convert 0.7s ok")
    assert(r3.value == int64(700000), " convert 0.7s value")
    let r3b = svtime.SvTickConvert(int64(30000), 1, 90000, 1, 90000)
    assert(r3b.ok, " convert 1/3 s at 1/90000 identity ok")
    assert(r3b.value == int64(30000), " convert 1/3 s identity value")
    let r4 = svtime.SvTickConvert(int64(0), 1, 7, 1, 90000)
    assert(r4.ok, " convert zero tick ok")
    assert(r4.value == int64(0), " convert zero tick value")
    let r5 = svtime.SvTickConvert(int64(4500000000000000000), 1, 1, 1, 2)
    assert(r5.ok, " convert 4.5e18 s to half-second ticks ok")
    assert(r5.value == int64(9000000000000000000), " convert half-second value")
    let r6 = svtime.SvTickConvert(int64(9000000000000000000), 1, 1, 2, 1)
    assert(r6.ok, " convert 9e18 s to two-second ticks ok")
    assert(r6.value == int64(4500000000000000000), " convert two-second value")

    # 不可精确换算必须拒绝（v0.1 不舍入，宁可拒绝）
    let n1 = svtime.SvTickConvert(int64(1), 1, 7, 1, 90000)
    assert(n1.ok == false, " reject 1/7 s in 1/90000")
    let n2 = svtime.SvTickConvert(int64(30000), 1, 90000, 1, 1000000)
    assert(n2.ok == false, " reject 1/3 s in 1/1000000")
    let n3 = svtime.SvTickConvert(int64(12287), 1, 12288, 1, 1000000)
    assert(n3.ok == false, " reject 12287 in 1e6")
    let n4 = svtime.SvTickConvert(int64(9000000000000000000), 1, 1, 1, 2)
    assert(n4.ok == false, " reject giant overflow to half-second ticks")

    echo(" sv_time_smoke ok")
    return 0
