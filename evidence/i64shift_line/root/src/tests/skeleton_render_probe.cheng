# Skeleton render probe: materialize the frozen skeleton overlay scene,
# run 100 authority ticks from the standing pose, render one frame with
# the A2 character appearance to /tmp/skeleton_probe.ppm, and prove the
# visual skeleton overlay is standing-stable and visually complete:
# each knee/elbow overlay point (frozen part indices 7..10, appended
# after footR) must stay within 0.05 m of its exact initial-pose
# position, and the PPM payload must be non-degenerate (> 1 MB). The
# producer tags overlay parts 7..10 with the schema knee/elbow roles
# directly; the renderer is role-driven and consumes the facts roles
# as-is. The dark-gray joint palette (knees 60,60,70 / elbows 70,70,80)
# must land
# globally (> 200 px); per-joint counts are echoed for diagnostics
# (elbowL sits inside the 0.13 torso capsule radius in the frozen pose,
# so its dot is torso-occluded and legitimately counts 0).
import cheng/game/csg/schema
import cheng/game/csg/producer
import cheng/game/csg/materializer
import cheng/game/csg/execution
import cheng/game/csg/numerics
import cheng/game/world3d
import cheng/game/physics3d
import cheng/game/cinema/camera
import cheng/game/render/cpu_raster as raster
import cheng/game/render/character
import std/os
import std/strings as strings

const
    ProbeW = 1280
    ProbeH = 720
    ProbeOutPath = "/tmp/skeleton_probe.ppm"
    ProbeTicks = 100
    ProbeDriftLimitM = 0.05
    ProbeKneeLPart = 7
    ProbeKneeRPart = 8
    ProbeElbowLPart = 9
    ProbeElbowRPart = 10
    ProbeDarkGrayMin = 200
    ProbeJointBoxHalf = 28

fn overlayDriftM(ax: float64, ay: float64, az: float64,
                 bx: float64, by: float64, bz: float64): float64 =
    let dx = ax - bx
    let dy = ay - by
    let dz = az - bz
    return numerics.CsgSqrt(dx * dx + dy * dy + dz * dz)

fn driftMmText(drift: float64): str =
    let mm: int64 = numerics.CsgQuantMm(drift * 1000.0)
    return strings.Int64ToStr(mm)

# dark-gray joint palette window: knee base (60,60,70) and elbow base
# (70,70,80) under Lambert lum in [0.15,1] — only their bright caps and
# the gray hand/foot spheres can land here, never the navy/red limbs
fn isDarkGrayPx(r: int32, g: int32, b: int32): int32 =
    if r >= 55:
        if r <= 75:
            if g >= 55:
                if g <= 75:
                    if b >= 65:
                        if b <= 85:
                            return 1
    return 0

@borrows
fn countDarkGray(rgb: uint8[]): int32 =
    var n: int32 = 0
    var i: int32 = 0
    while i < rgb.len / 3:
        let r: int32 = int32(rgb[i * 3])
        let g: int32 = int32(rgb[i * 3 + 1])
        let b: int32 = int32(rgb[i * 3 + 2])
        n = n + isDarkGrayPx(r, g, b)
        i = i + 1
    return n

@borrows
fn countDarkGrayNear(rgb: uint8[], cx: float64, cy: float64): int32 =
    var n: int32 = 0
    var py: int32 = int32(cy) - ProbeJointBoxHalf
    if py < 0:
        py = 0
    var pyTop: int32 = int32(cy) + ProbeJointBoxHalf
    if pyTop >= ProbeH:
        pyTop = ProbeH - 1
    var pxLeft: int32 = int32(cx) - ProbeJointBoxHalf
    if pxLeft < 0:
        pxLeft = 0
    var pxRight: int32 = int32(cx) + ProbeJointBoxHalf
    if pxRight >= ProbeW:
        pxRight = ProbeW - 1
    while py <= pyTop:
        var px: int32 = pxLeft
        while px <= pxRight:
            let idx: int32 = (py * ProbeW + px) * 3
            n = n + isDarkGrayPx(int32(rgb[idx]), int32(rgb[idx + 1]), int32(rgb[idx + 2]))
            px = px + 1
        py = py + 1
    return n

fn main(): int32 =
    var facts: schema.CsgWorldFacts = producer.CsgProducerBuildSkeletonScene()
    # exact initial overlay pose (the producer's frozen coordinates)
    let kneeLx = facts.partX[ProbeKneeLPart]
    let kneeLy = facts.partY[ProbeKneeLPart]
    let kneeLz = facts.partZ[ProbeKneeLPart]
    let kneeRx = facts.partX[ProbeKneeRPart]
    let kneeRy = facts.partY[ProbeKneeRPart]
    let kneeRz = facts.partZ[ProbeKneeRPart]
    let elbowLx = facts.partX[ProbeElbowLPart]
    let elbowLy = facts.partY[ProbeElbowLPart]
    let elbowLz = facts.partZ[ProbeElbowLPart]
    let elbowRx = facts.partX[ProbeElbowRPart]
    let elbowRy = facts.partY[ProbeElbowRPart]
    let elbowRz = facts.partZ[ProbeElbowRPart]
    # materialize (validation re-checked inside) + execution state
    var w: world3d.World3d
    var mp: materializer.CsgMaterializerMapping
    var err: str = ""
    if !materializer.CsgMaterialize(facts, w, mp, err):
        echo("FAIL materialize: " + err)
        return 1
    var st: execution.CsgExecutionState
    execution.CsgExecutionInit(st, facts, w, mp.partSlot, mp.ropeNodeSlot)
    # 100 authority ticks of standing physics
    var tick: int32
    while tick < ProbeTicks:
        var receipt = execution.CsgExecutionTick(st, facts)
        if receipt.statusCode != physics3d.Physics3dStatusOk:
            echo("FAIL physics tick " + strings.IntToStr(tick) + " status " + strings.IntToStr(receipt.statusCode))
            return 1
        tick = tick + 1
    # render one frame from the post-tick world state
    var partRoles: int32[]
    setLen(partRoles, 0)
    var ri: int32
    while ri < facts.partRole.len:
        add(partRoles, facts.partRole[ri])
        ri = ri + 1
    # the producer tags overlay parts 7..10 with the semantic knee/elbow
    # roles; the renderer is role-driven and consumes the facts roles
    # as-is
    var cam = camera.CinemaCameraLookAt(-4.6, 3.2, 1.7, 0.0, 0.8, 1.35, 950.0, ProbeW, ProbeH)
    var t: raster.RasterTarget
    t = raster.RasterMake(ProbeW, ProbeH)
    raster.RasterGround(t, cam)
    raster.RasterWallFace(t, cam, 0.5, -2.0, 2.0, 0.0, 4.0)
    character.RenderCharacter(t, cam, st.w, partRoles)
    raster.RasterWritePpm(t, ProbeOutPath)
    # standing stability: overlay points vs their exact initial pose
    let kneeLSlot = mp.partSlot[ProbeKneeLPart]
    let kneeRSlot = mp.partSlot[ProbeKneeRPart]
    let elbowLSlot = mp.partSlot[ProbeElbowLPart]
    let elbowRSlot = mp.partSlot[ProbeElbowRPart]
    let driftKneeL = overlayDriftM(st.w.bodyPx[kneeLSlot], st.w.bodyPy[kneeLSlot], st.w.bodyPz[kneeLSlot], kneeLx, kneeLy, kneeLz)
    let driftKneeR = overlayDriftM(st.w.bodyPx[kneeRSlot], st.w.bodyPy[kneeRSlot], st.w.bodyPz[kneeRSlot], kneeRx, kneeRy, kneeRz)
    let driftElbowL = overlayDriftM(st.w.bodyPx[elbowLSlot], st.w.bodyPy[elbowLSlot], st.w.bodyPz[elbowLSlot], elbowLx, elbowLy, elbowLz)
    let driftElbowR = overlayDriftM(st.w.bodyPx[elbowRSlot], st.w.bodyPy[elbowRSlot], st.w.bodyPz[elbowRSlot], elbowRx, elbowRy, elbowRz)
    echo("skeleton overlay drift mm kneeL=" + driftMmText(driftKneeL) + " kneeR=" + driftMmText(driftKneeR) + " elbowL=" + driftMmText(driftElbowL) + " elbowR=" + driftMmText(driftElbowR))
    let ppm: str = os.ReadFile(ProbeOutPath)
    echo("skeleton probe ppm bytes=" + strings.IntToStr(ppm.len))
    # dark-gray joint palette: read the streamed P6 payload back (16-byte
    # header) and count it globally plus around every projected joint
    var rgb: uint8[]
    setLen(rgb, ppm.len - 16)
    var ci: int32 = 0
    while ci < ppm.len - 16:
        rgb[ci] = uint8(int32(ppm[16 + ci]) & 255)
        ci = ci + 1
    let darkGray = countDarkGray(rgb)
    let kneeLProj = camera.CameraProject(cam, st.w.bodyPx[kneeLSlot], st.w.bodyPy[kneeLSlot], st.w.bodyPz[kneeLSlot])
    let kneeRProj = camera.CameraProject(cam, st.w.bodyPx[kneeRSlot], st.w.bodyPy[kneeRSlot], st.w.bodyPz[kneeRSlot])
    let elbowLProj = camera.CameraProject(cam, st.w.bodyPx[elbowLSlot], st.w.bodyPy[elbowLSlot], st.w.bodyPz[elbowLSlot])
    let elbowRProj = camera.CameraProject(cam, st.w.bodyPx[elbowRSlot], st.w.bodyPy[elbowRSlot], st.w.bodyPz[elbowRSlot])
    let pxKneeL = countDarkGrayNear(rgb, kneeLProj.sx, kneeLProj.sy)
    let pxKneeR = countDarkGrayNear(rgb, kneeRProj.sx, kneeRProj.sy)
    let pxElbowL = countDarkGrayNear(rgb, elbowLProj.sx, elbowLProj.sy)
    let pxElbowR = countDarkGrayNear(rgb, elbowRProj.sx, elbowRProj.sy)
    echo("skeleton probe dark gray px=" + strings.IntToStr(darkGray) + " joint px kneeL=" + strings.IntToStr(pxKneeL) + " kneeR=" + strings.IntToStr(pxKneeR) + " elbowL=" + strings.IntToStr(pxElbowL) + " elbowR=" + strings.IntToStr(pxElbowR))
    if driftKneeL >= ProbeDriftLimitM:
        echo("FAIL kneeL drift " + driftMmText(driftKneeL) + " mm")
        return 1
    if driftKneeR >= ProbeDriftLimitM:
        echo("FAIL kneeR drift " + driftMmText(driftKneeR) + " mm")
        return 1
    if driftElbowL >= ProbeDriftLimitM:
        echo("FAIL elbowL drift " + driftMmText(driftElbowL) + " mm")
        return 1
    if driftElbowR >= ProbeDriftLimitM:
        echo("FAIL elbowR drift " + driftMmText(driftElbowR) + " mm")
        return 1
    if ppm.len <= 1024 * 1024:
        echo("FAIL ppm payload degenerate")
        return 1
    if darkGray <= ProbeDarkGrayMin:
        echo("FAIL dark gray joint pixels " + strings.IntToStr(darkGray))
        return 1
    echo("PASS skeleton render probe")
    return 0
