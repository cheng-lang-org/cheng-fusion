import std/system
import std/seqs

@borrows
fn ColdPostMutationConsume[V](values: V[]): int32 =
    return values.len

fn ColdPostMutationDirectCallCase[V](): int32 =
    var values: V[]
    setLen(values, 2)
    let observed = ColdPostMutationConsume[V](values)
    if observed != 2:
        return 11
    echo("cold_generic_post_mutation_direct_call=pass")
    return 0

@borrows
@borrow_result
fn ColdPostMutationBorrowReturn[V](values: V[]): V[] =
    return values

fn ColdPostMutationBorrowReturnCase[V](): int32 =
    var values: V[]
    setLen(values, 2)
    let borrowed = ColdPostMutationBorrowReturn[V](values)
    if borrowed.len != 2:
        return 12
    if values.len != 2:
        return 13
    echo("cold_generic_post_mutation_borrow_return=pass")
    return 0

fn ColdPostMutationDropSourceCase[V](): int32 =
    var values: V[]
    setLen(values, 2)
    if values.len != 2:
        return 14
    echo("cold_generic_post_mutation_drop_source=pass")
    return 0

fn ColdPostMutationMutateTwice[V](values: var V[]) =
    setLen(values, 2)
    setLen(values, 3)

fn ColdPostMutationConsecutiveVarCase[V](): int32 =
    var values: V[]
    ColdPostMutationMutateTwice[V](values)
    if values.len != 3:
        return 15
    echo("cold_generic_post_mutation_consecutive_var=pass")
    return 0

fn main(): int32 =
    return ColdPostMutationDirectCallCase[str]()
