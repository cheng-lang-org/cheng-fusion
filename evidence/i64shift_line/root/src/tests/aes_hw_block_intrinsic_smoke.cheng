# Path C MVP: prove the arm64 backend emits inline ARMv8 AESE for the AES-128 block intrinsic.
# Self-contained (hardcoded FIPS-197 key schedule + plaintext), avoids the driver's gappy crypto
# functions. Built with the from-source driver (which has the intrinsic) on arm64 → the call to the
# @importc cheng_crypto_aes_block_enc128 inside the straight-line host aesHwBlock is replaced inline
# with AESE/AESMC. Expected output = the FIPS-197 vector 69c4e0d86a7b0430d8cdb78070b4c55a.
import std/system
import std/rawbytes

@importc("cheng_crypto_aes_block_enc128")
fn aesBlockEncHw(state: ptr, roundKeys: ptr)

# Straight-line BodyIR host: exactly one recognized call + return, bare-identifier args. On arm64 the
# inline recognizer replaces the BL to aesBlockEncHw with the 33-word AESE sequence.
fn aesHwBlock(state: ptr, roundKeys: ptr): int32 =
    aesBlockEncHw(state, roundKeys)
    return 0

fn hexNib(c: int32): int32 =
    if c >= int32('0') && c <= int32('9'):
        return c - int32('0')
    if c >= int32('a') && c <= int32('f'):
        return c - int32('a') + 10
    return 0

fn bytesFromHexInto(b: Bytes, hex: str) =
    var i: int32
    while i < BytesLen(b):
        let hi: int32 = hexNib(int32(hex[i * 2]))
        let lo: int32 = hexNib(int32(hex[i * 2 + 1]))
        BytesSet(b, i, ((hi << 4) | lo) & 255)
        i = i + 1

fn main(): int32 =
    let state: Bytes = BytesAlloc(16)
    bytesFromHexInto(state, "00112233445566778899aabbccddeeff")
    let sched: Bytes = BytesAlloc(176)
    bytesFromHexInto(sched, "")
    let _ = aesHwBlock(state.data, sched.data)
    let got: str = BytesToHex(state)
    echo(got)
    if got == "69c4e0d86a7b0430d8cdb78070b4c55a":
        echo("aes_hw_block_intrinsic_smoke ok")
        return 0
    echo("aes_hw_block_intrinsic_smoke FAIL")
    return 1
