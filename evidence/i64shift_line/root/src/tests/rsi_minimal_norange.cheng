# 纯 std 无 range 语料 (F9 分流实验): 与 minimal_smoke 同构但用 while 计数。
import std/strings as strings

fn main(): int32 =
    var total: int64
    var i: int32
    while i < 200:
        total = total + int64(i * i)
        i = i + 1
    let text = strings.Int64ToStr(total)
    assert(len(text) > 0, "rsi norange: total rendered")
    return 0
