# P2P distribution architecture, slice 1 — verifies the publish-side CID pipeline
# (cheng/moq/publish_cid_pipeline.cheng) is real, not a stub: the same real MP4 fixture
# used elsewhere (ts-csg/fixtures/media/unimaker-default-video-2frame.mp4) is run through
# the real chunker/ingest, the resulting assetCid/manifestCid/posterCid must independently
# match sha256 of their own bytes, persistence must actually contain them, republishing the
# same content must be idempotent, and publishing different content must produce a different
# assetCid. No mocked bytes, no faked hashes — every byte read is a real fixture file and
# every CID is independently recomputed via media.MediaAssetSha256Hex.
#
# Asserts, in order:
#   1. Publish (PublishCidPipelineRun) succeeds against the real fixture video+poster.
#   2. Chunker output non-empty: real MoqFountainBuild object/droplet counts > 0.
#   3. All three CIDs non-empty; assetCid == sha256(video bytes), posterCid == sha256
#      (poster bytes) — the same content-addressing scheme the static fixture path uses.
#   4. Persistence: the store file actually contains a line with this taskId/contentId and
#      the same three CID values (read back and string-matched, not just "call returned ok").
#   5. Idempotent: republishing the exact same video+poster produces the exact same three
#      CIDs (and a second persisted line, since publish is append-only per task).
#   6. Different content: publishing a byte-flipped copy of the same video produces a
#      different assetCid (and therefore a different manifestCid) from the original.
# Any failure prints a reason and exits nonzero; success prints "ALL OK" and exits 0.

import std/os
import std/rawbytes
import std/strutils as strutil
import std/result
import cheng/moq/media_asset_manifest as media
import cheng/moq/publish_cid_pipeline as pipeline

fn fail(msg: str): int32 =
    os.WriteLine(os.Get_stdout(), strutil.Join(["FAIL: ", msg], ""))
    return 1

fn checkWorkDir(): str =
    return os.JoinPath(os.GetCurrentDir(), "artifacts/publish_cid_pipeline_check")

fn checkVideoFixturePath(): str =
    return os.JoinPath(os.GetCurrentDir(), "ts-csg/fixtures/media/unimaker-default-video-2frame.mp4")

fn checkPosterFixturePath(): str =
    return os.JoinPath(os.GetCurrentDir(), "ts-csg/fixtures/media/unimaker-default-video-poster.png")

# Clones the real fixture video and flips a single content byte inside the mdat payload
# (offset 829, per the fixture's own known probe: mdat=821, first payload byte=829 — see
# media_video_e2e_native_player_smoke.cheng's keyframeIndex assertion for the same fixture).
# Flipping a payload byte leaves every mp4 box header/size untouched, so MediaProbeMp4FileBytes
# still accepts it — only the content-addressed hash changes, exactly what assertion 6 needs.
fn checkMutatedVideoBytes(original: rawbytes.Bytes): rawbytes.Bytes =
    let n: int32 = rawbytes.BytesLen(original)
    var out: rawbytes.Bytes = rawbytes.BytesAlloc(n)
    rawbytes.BytesCopyInto(out, 0, original)
    let mutateOffset: int32 = 829
    let current: int32 = rawbytes.BytesGet(out, mutateOffset)
    rawbytes.BytesSet(out, mutateOffset, (current + 1) % 256)
    return out

fn main(): int32 =
    let workDir: str = checkWorkDir()
    os.MkdirAll(workDir, 493)
    let storePath: str = os.JoinPath(workDir, "published_tasks.jsonl")
    if os.FileExists(storePath):
        os.RemoveFile(storePath)

    let videoBytesRes = os.ReadFileBytesResult(checkVideoFixturePath())
    if IsErr(videoBytesRes):
        return fail(strutil.Join(["fixture video read: ", Error(videoBytesRes)], ""))
    let videoBytes = Value(videoBytesRes)
    let posterBytesRes = os.ReadFileBytesResult(checkPosterFixturePath())
    if IsErr(posterBytesRes):
        return fail(strutil.Join(["fixture poster read: ", Error(posterBytesRes)], ""))
    let posterBytes = Value(posterBytesRes)
    let posterCidExpected: str = media.MediaAssetSha256Hex(posterBytes)
    let assetCidExpected: str = media.MediaAssetSha256Hex(videoBytes)

    # 1. Publish against the real fixture.
    let runRes = pipeline.PublishCidPipelineRun(storePath, "task-a", "content-a",
        checkVideoFixturePath(), checkPosterFixturePath(),
        "publisher-alpha", "subscriber-bravo", "publish-cid-pipeline-check-v1",
        int64(22500), "h264/aac")
    if IsErr(runRes):
        return fail(strutil.Join(["publish run: ", Error(runRes)], ""))
    let receipt = Value(runRes)
    os.WriteLine(os.Get_stdout(), "step1_publish_ok")

    # 2. Chunker output non-empty.
    if receipt.objectCount <= 0:
        return fail(strutil.Join(["chunker produced zero objects, got=", IntToStr(receipt.objectCount)], ""))
    if receipt.dropletCount <= 0:
        return fail(strutil.Join(["chunker produced zero droplets, got=", IntToStr(receipt.dropletCount)], ""))
    os.WriteLine(os.Get_stdout(), strutil.Join(["step2_chunker_ok object_count=", IntToStr(receipt.objectCount),
                                                 " droplet_count=", IntToStr(receipt.dropletCount)], ""))

    # 3. Three CIDs non-empty and content-addressed.
    if len(receipt.assetCid) <= 0:
        return fail("assetCid empty")
    if len(receipt.manifestCid) <= 0:
        return fail("manifestCid empty")
    if len(receipt.posterCid) <= 0:
        return fail("posterCid empty")
    if receipt.assetCid != assetCidExpected:
        return fail(strutil.Join(["assetCid mismatch got=", receipt.assetCid, " want=", assetCidExpected], ""))
    if receipt.posterCid != posterCidExpected:
        return fail(strutil.Join(["posterCid mismatch got=", receipt.posterCid, " want=", posterCidExpected], ""))
    os.WriteLine(os.Get_stdout(), strutil.Join(["step3_cids_ok asset_cid=", receipt.assetCid,
                                                 " manifest_cid=", receipt.manifestCid,
                                                 " poster_cid=", receipt.posterCid], ""))

    # 4. Persistence actually contains this task's CIDs.
    let storedRes = os.ReadFileResult(storePath)
    if IsErr(storedRes):
        return fail(strutil.Join(["store read: ", Error(storedRes)], ""))
    let stored = Value(storedRes)
    if !strutil.Contains(stored, "task-a\tcontent-a\t"):
        return fail("store missing task-a/content-a line")
    if !strutil.Contains(stored, strutil.Join(["\"assetCid\":\"", receipt.assetCid, "\""], "")):
        return fail("store missing assetCid field")
    if !strutil.Contains(stored, strutil.Join(["\"manifestCid\":\"", receipt.manifestCid, "\""], "")):
        return fail("store missing manifestCid field")
    if !strutil.Contains(stored, strutil.Join(["\"posterCid\":\"", receipt.posterCid, "\""], "")):
        return fail("store missing posterCid field")
    os.WriteLine(os.Get_stdout(), "step4_persist_ok")

    # 5. Idempotent: same content republished under a different task id gets the same CIDs.
    let runRes2 = pipeline.PublishCidPipelineRun(storePath, "task-a-2", "content-a-2",
        checkVideoFixturePath(), checkPosterFixturePath(),
        "publisher-alpha", "subscriber-bravo", "publish-cid-pipeline-check-v1",
        int64(22500), "h264/aac")
    if IsErr(runRes2):
        return fail(strutil.Join(["republish run: ", Error(runRes2)], ""))
    let receipt2 = Value(runRes2)
    if receipt2.assetCid != receipt.assetCid:
        return fail(strutil.Join(["idempotency: assetCid changed got=", receipt2.assetCid, " want=", receipt.assetCid], ""))
    if receipt2.manifestCid != receipt.manifestCid:
        return fail(strutil.Join(["idempotency: manifestCid changed got=", receipt2.manifestCid, " want=", receipt.manifestCid], ""))
    if receipt2.posterCid != receipt.posterCid:
        return fail(strutil.Join(["idempotency: posterCid changed got=", receipt2.posterCid, " want=", receipt.posterCid], ""))
    let storedRes2 = os.ReadFileResult(storePath)
    if IsErr(storedRes2):
        return fail(strutil.Join(["store re-read: ", Error(storedRes2)], ""))
    if !strutil.Contains(Value(storedRes2), "task-a-2\tcontent-a-2\t"):
        return fail("store missing second (idempotent) publish line")
    os.WriteLine(os.Get_stdout(), "step5_idempotent_ok")

    # 6. Different content produces a different assetCid.
    let mutatedVideoPath: str = os.JoinPath(workDir, "mutated.mp4")
    var mutatedBytes: rawbytes.Bytes = checkMutatedVideoBytes(videoBytes)
    let writeRes = os.WriteFileBytesResult(mutatedVideoPath, mutatedBytes)
    if IsErr(writeRes):
        return fail(strutil.Join(["mutated fixture write: ", Error(writeRes)], ""))
    let runRes3 = pipeline.PublishCidPipelineRun(storePath, "task-b", "content-b",
        mutatedVideoPath, checkPosterFixturePath(),
        "publisher-alpha", "subscriber-bravo", "publish-cid-pipeline-check-v1",
        int64(22500), "h264/aac")
    if IsErr(runRes3):
        return fail(strutil.Join(["mutated publish run: ", Error(runRes3)], ""))
    let receipt3 = Value(runRes3)
    if receipt3.assetCid == receipt.assetCid:
        return fail("different content produced the same assetCid")
    if receipt3.manifestCid == receipt.manifestCid:
        return fail("different content produced the same manifestCid")
    if receipt3.assetCid != media.MediaAssetSha256Hex(mutatedBytes):
        return fail(strutil.Join(["mutated assetCid mismatch got=", receipt3.assetCid,
                                   " want=", media.MediaAssetSha256Hex(mutatedBytes)], ""))
    os.WriteLine(os.Get_stdout(), strutil.Join(["step6_diff_content_ok mutated_asset_cid=", receipt3.assetCid], ""))

    os.WriteLine(os.Get_stdout(), "ALL OK")
    return 0
