type
    R12Box =
        v: str

    R12Request =
        outputPath: str
        providerCanonicalPaths: R12Box[]

fn R12Collect(n: int32, out: var R12Box[]): bool =
    for i in 0..<n:
        var b: R12Box
        b.v = Fmt"canon_{i}"
        add(out, b)
    return true

fn R12Link(req: R12Request): int32 =
    return req.providerCanonicalPaths.len

fn R12Run(n: int32): int32 =
    var providerCanonicalPaths: R12Box[]
    if !R12Collect(n, providerCanonicalPaths):
        return -1
    var request: R12Request
    request.outputPath = "out.exe"
    request.providerCanonicalPaths = providerCanonicalPaths
    let linkedCount = R12Link(request)
    if linkedCount != providerCanonicalPaths.len:
        return -2
    return linkedCount

fn main(): int32 =
    let n = R12Run(3)
    if n != 3:
        return 10
    echo(Fmt"r12_seqbox ok n={n}")
    return 0
