fn coldQuestionValidResult(): Result[bool] =
    return Ok[bool](true)

fn coldQuestionInvalidUse(): Result[int32] =
    let invalid = coldQuestionValidResult()? ?
        -1
    return Ok[int32](invalid)

fn main(): int32 =
    let attempted = coldQuestionInvalidUse()
    if !attempted.ok:
        return 1
    return attempted.value
