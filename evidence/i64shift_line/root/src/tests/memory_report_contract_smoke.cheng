        " memory report contract: row receipt authority")
    MemoryReportAssertContains(
        systemLinkText,
        "SystemLinkExecOwnerLedgerReleaseStorage(",
        " memory report contract: owner table physical release")
    MemoryReportAssertContains(
        systemLinkText,
