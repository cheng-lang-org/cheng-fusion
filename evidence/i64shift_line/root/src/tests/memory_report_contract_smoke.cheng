import std/os
import std/strings
import std/strutils as strutil
import cheng/core/tooling/path as chengpath

@borrows
fn MemoryReportFind(text: str, needle: str): int32 =
    if len(needle) <= 0:
        return 0
    if len(text) < len(needle):
        return -1
    let limit = len(text) - len(needle)
    for i in 0..limit:
        var matched = true
        for j in 0..<len(needle):
            if text[i + j] != needle[j]:
                matched = false
        if matched:
            return i
    return -1

@borrows
fn MemoryReportAssertContains(text: str, needle: str, message: str) =
    assert(strings.StrContains(text, needle), message)

@borrows
fn MemoryReportAssertOrderedSnippet(text: str, snippet: str, message: str) =
    assert(MemoryReportFind(text, snippet) >= 0, message)

@borrows
fn MemoryReportCount(text: str, needle: str): int32 =
    if len(needle) <= 0 || len(text) < len(needle):
        return 0
    var count: int32
    let candidateCount = len(text) - len(needle) + 1
    for i in 0..<candidateCount:
        var matched = true
        for j in 0..<len(needle):
            if text[i + j] != needle[j]:
                matched = false
                break
        if matched:
            count = count + 1
    return count

fn main(): int32 =
    let root = os.GetCurrentDir()
    let dispatchText = chengpath.ReadTextFile(root, "src/core/tooling/backend_driver_dispatch_min.cheng")
    assert(len(dispatchText) > 0, " memory report contract: dispatch source")
    let systemLinkText = chengpath.ReadTextFile(root, "src/core/backend/system_link_exec.cheng")
    assert(len(systemLinkText) > 0, " memory report contract: system link source")
    let runtimeText = chengpath.ReadTextFile(root, "src/core/backend/system_link_exec_runtime.cheng")
    assert(len(runtimeText) > 0, " memory report contract: runtime source")
    let loweringText = chengpath.ReadTextFile(root, "src/core/backend/lowering_plan.cheng")
    assert(len(loweringText) > 0, " memory report contract: lowering source")
    let primaryText = chengpath.ReadTextFile(root, "src/core/backend/primary_object_plan.cheng")
    assert(len(primaryText) > 0, " memory report contract: primary source")
    let systemText = chengpath.ReadTextFile(root, "src/std/system.cheng")
    assert(len(systemText) > 0, " memory report contract: system source")

    MemoryReportAssertContains(
        systemLinkText,
        "storage: arenamod.Arena\n        ownerKinds: arenamod.ArenaArrayInt32\n        allocationIdHighs: arenamod.ArenaArrayInt32",
        " memory report contract: owner ledger is Arena SoA")
