        systemLinkText,
        "csglife.CompilerCsgProductionLifetimeBorrowForObjectPlan(\n        compilerCsgProductionLifetime)")
    let csgLifetimeTransfer = MemoryReportFind(
        systemLinkText,
        "csglife.CompilerCsgProductionLifetimeTransferInto(\n        compilerCsgProductionLifetime,")
    assert(csgLifetimeBegin >= 0 &&
           csgLoweringBorrow > csgLifetimeBegin &&
           csgLoweringMove > csgLoweringBorrow &&
           csgObjectBorrow > csgLoweringMove &&
           csgLifetimeTransfer > csgObjectBorrow,
