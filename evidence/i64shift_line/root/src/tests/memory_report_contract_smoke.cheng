    assert(loweringLifetimeBegin >= 0 &&
           loweringPreRelease > loweringLifetimeBegin &&
           loweringBorrow > loweringPreRelease &&
           loweringMove > loweringBorrow &&
           loweringAfterPrimary > loweringMove &&
           loweringLifetimeTransfer > loweringAfterPrimary,
           " memory report contract: lowering begin/release/borrow/move/release/transfer order")
