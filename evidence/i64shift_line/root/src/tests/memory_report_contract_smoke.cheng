    MemoryReportAssertOrderedSnippet(
        runtimeText,
        "nplan.NativeLinkPlanReleaseReceiptConsumeStrictInto(\n           plan.nativeLinkPlan,\n           nativeLinkPlanReleaseReceipt,\n           nativeLinkPlanReleaseErr):\n        panic(nativeLinkPlanReleaseErr)\n    sexec.SystemLinkExecPlanRecordOwnerReleaseReceipt(",
        " memory report contract: runtime native receipt before ledger release")
    assert(MemoryReportCount(
               runtimeText,
               "plan.objectPlan = objplan.ObjectPlanStub()") == 0 &&
           MemoryReportCount(
               runtimeText,
               "plan.nativeLinkPlan = nplan.NativeLinkPlanStub()") == 0,
           " memory report contract: runtime owner zero assignment remained")
    MemoryReportAssertContains(runtimeText,
                               "slplan.SystemLinkPlanReleaseWithReceipt(",
                               " memory report contract: runtime system link release")
    MemoryReportAssertOrderedSnippet(
        runtimeText,
        "slplan.SystemLinkPlanReleaseReceiptConsumeStrictInto(\n           plan.systemLinkPlan,\n           systemLinkPlanReleaseReceipt,\n           systemLinkPlanReleaseErr):\n        panic(systemLinkPlanReleaseErr)\n    sexec.SystemLinkExecPlanRecordOwnerReleaseReceipt(",
        " memory report contract: runtime system link receipt before ledger release")

    echo(" memory_report_contract_smoke ok")
    return 0
