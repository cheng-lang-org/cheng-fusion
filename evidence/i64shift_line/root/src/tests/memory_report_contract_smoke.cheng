        "bodylifecycle.BodyIrPayloadReleaseSequenceReceiptConsumeStrictInto(\n           plan.primaryObjectPlan.functionBodyIRs,\n           primaryBodyIrReleaseState,\n           primaryBodyIrReleaseReceipt,\n           primaryBodyIrReleaseErr):\n        panic(primaryBodyIrReleaseErr)\n    sexec.SystemLinkExecPlanRecordOwnerReleaseReceipt(",
        " memory report contract: runtime body ir receipt before ledger release")
    MemoryReportAssertContains(runtimeText,
                               "pobj.PrimaryObjectPlanReleaseWithReceipt(",
                               " memory report contract: runtime primary plan release")
    let runtimePrimaryRelease = MemoryReportFind(
        runtimeText,
        "pobj.PrimaryObjectPlanReleaseWithReceipt(\n        plan.primaryObjectPlan,")
    let runtimePrimaryReceiptConsume = MemoryReportFind(
        runtimeText,
        "pobj.PrimaryObjectPlanReleaseReceiptConsumeStrictInto(\n           plan.primaryObjectPlan,")
    let runtimePrimaryOwnerSelection = MemoryReportFind(
        runtimeText,
        "var primaryPlanOwnerKind =\n        sexec.SystemLinkExecOwnerKindPrimaryPlan")
    let runtimeBackend2OwnerSelection = MemoryReportFind(
