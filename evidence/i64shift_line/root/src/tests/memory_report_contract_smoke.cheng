        " memory report contract: early owners have real receipts")
    MemoryReportAssertContains(
        systemLinkText,
        "compilerCsgReleasedBytes + compilerCsgResidualBytes !=",
        " memory report contract: CompilerCSG byte partition")
    assert(MemoryReportCount(systemLinkText,
                             "SystemLinkExecRuntimeRequiredOwnerMask") == 0 &&
           MemoryReportCount(systemLinkText,
                             "requiredOwnerMask:") == 0 &&
           MemoryReportCount(systemLinkText,
                             "receiptOwnerMask:") == 0 &&
           MemoryReportCount(systemLinkText,
                             "systemLinkExprAllocationId:") == 0 &&
           MemoryReportCount(systemLinkText,
                             "SystemLinkExecPlanRecordReleasedOwner(") == 0,
           " memory report contract: fixed owner-mask ledger remained")

    MemoryReportAssertContains(
        dispatchText,
        "sexec.BuildSystemLinkExecPlanWithWorldAndChannelInto(",
        " memory report contract: dispatch uses formal plan producer")
    MemoryReportAssertContains(
        dispatchText,
        "sexecrt.SystemLinkExecRuntimeExecutePlanWithCompilerInto(",
        " memory report contract: dispatch uses formal runtime consumer")
    assert(MemoryReportCount(
               dispatchText,
               "BackendDriverDispatchMinCaptureCompilerCsgLifetimeReceipt(") == 0 &&
           MemoryReportCount(
               dispatchText,
               "BackendDriverDispatchMinCaptureLoweringArenaLifetimeReceipt(") == 0 &&
           MemoryReportCount(
               dispatchText,
               "BackendDriverDispatchMinWriteCompilerPayloadFailureReport(") == 0,
           " memory report contract: dispatch has no parallel lifetime/report implementation")
    MemoryReportAssertContains(
        systemLinkText,
        "\"exec_retained_payload_approx_bytes\"",
        " memory report contract: compatibility retained estimate remains")
    MemoryReportAssertContains(
        systemLinkText,
        "\"exec_retained_payload_approx_bytes_scope\",\n                                   \"diagnostic_non_authoritative_not_rss\"",
        " memory report contract: retained estimate is explicitly diagnostic")
    MemoryReportAssertContains(
        systemLinkText,
        "\"exec_retained_payload_approx_bytes_gate_eligible\",\n                                   \"0\"",
        " memory report contract: retained estimate cannot drive a gate")
    MemoryReportAssertContains(
        systemLinkText,
        "\"exec_retained_object_plan_item_count\"",
        " memory report contract: object plan retained items")
    MemoryReportAssertContains(
