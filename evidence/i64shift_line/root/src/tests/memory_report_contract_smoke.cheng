    assert(runtimeLoweringRelease >= 0 &&
           runtimeLoweringReceiptConsume > runtimeLoweringRelease &&
           runtimeLoweringLifetimeClose > runtimeLoweringReceiptConsume &&
           runtimeLoweringReceiptReady > runtimeLoweringLifetimeClose &&
           runtimeLoweringOwnerReceipt > runtimeLoweringReceiptReady,
           " memory report contract: runtime lowering release/lifetime/owner receipt order")
    let runtimeLoweringMemoryBefore = MemoryReportFind(
        runtimeText,
        "let loweringTerminalReleaseBefore =\n        sexec.SystemLinkExecPhaseMemorySnapshotFromPlan(plan)")
    let runtimeLoweringMemoryAfter = MemoryReportFind(
        runtimeText,
        "let loweringTerminalReleaseAfter =\n        sexec.SystemLinkExecPhaseMemorySnapshotFromPlan(plan)")
    let runtimeLoweringMemoryCommit = MemoryReportFind(
        runtimeText,
        "plan.phaseMemoryLedger.loweringTerminalRelease =\n        sexec.SystemLinkExecPhaseMemoryDeltaFromPlan(")
    assert(runtimeLoweringMemoryBefore >= 0 &&
           runtimeLoweringMemoryBefore < runtimeLoweringRelease &&
           runtimeLoweringMemoryAfter > runtimeLoweringOwnerReceipt &&
           runtimeLoweringMemoryCommit > runtimeLoweringMemoryAfter,
           " memory report contract: terminal lowering release has exact before/after snapshots")
    assert(MemoryReportCount(
               runtimeText,
               "lower.LoweringPlanReleaseAllPayload(plan.loweringPlan)") == 0,
           " memory report contract: runtime lowering legacy direct release remained")
    MemoryReportAssertContains(
        runtimeText,
        "sexec.SystemLinkExecRuntimeMetadataReleaseWithReceipt(",
        " memory report contract: runtime metadata receipt release")
    MemoryReportAssertOrderedSnippet(
        runtimeText,
        "sexec.SystemLinkExecRuntimeMetadataReleaseReceiptConsumeStrictInto(\n           plan,\n           runtimeMetadataReleaseReceipt,\n           runtimeMetadataReleaseErr):\n        panic(runtimeMetadataReleaseErr)\n    sexec.SystemLinkExecPlanRecordOwnerReleaseReceipt(",
        " memory report contract: runtime metadata receipt before ledger release")
    assert(MemoryReportCount(
               runtimeText,
               "plan.compilerCsg = ccsg.CompilerCsg()") == 0 &&
           MemoryReportCount(
               runtimeText,
               "plan.exportSurface = ccsg.CsgExportSurface()") == 0 &&
           MemoryReportCount(
