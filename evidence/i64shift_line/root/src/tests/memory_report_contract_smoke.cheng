        "\"compiler_csg_typed_expr_fact_count\"",
        " memory report contract: typed expression facts")
    MemoryReportAssertContains(
        systemLinkText,
        "\"compiler_csg_typed_ir_round_count\"",
        " memory report contract: deterministic typed ir work rounds")
    MemoryReportAssertContains(
        systemLinkText,
        "\"compiler_csg_expr_layer_expr_count\"",
        " memory report contract: expression layer rows")
    MemoryReportAssertContains(
        systemLinkText,
        "out = Fmt\"{out}{lower.LoweringPlanStubReport(plan.loweringPlan)}\\n\"",
        " memory report contract: lowering report comes from lowering authority")
    MemoryReportAssertContains(
