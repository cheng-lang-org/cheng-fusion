        "Fmt\"phase_{phase}_top1_bytes\"",
        " memory report contract: phase top contributor bytes")
    let dispatchCsgReleaseCount = MemoryReportCount(dispatchText,
                                                     "ccsg.CompilerCsgReleaseBackendInputPayload(csg)")
    assert(dispatchCsgReleaseCount == 0,
           Fmt" memory report contract: dispatch must not release lowering-owned csg actual={dispatchCsgReleaseCount}")
    assert(MemoryReportCount(systemLinkText,
                             "ccsg.CompilerCsgReleaseBackendInputPayload(compilerCsg)") == 0,
           " memory report contract: system link must not release lowering-owned csg")
    assert(MemoryReportCount(loweringText,
                             "ccsg.CompilerCsgReleaseBackendInputPayload(compilerCsg)") == 1,
           " memory report contract: lowering owns the unique csg release primitive")
    assert(MemoryReportCount(systemLinkText,
                             "SystemLinkExecLoweringStructuredBytesBorrowed") == 0 &&
           MemoryReportCount(systemLinkText,
                             "SystemLinkExecPrimaryStructuredBytesBorrowed") == 0,
           " memory report contract: system link must not duplicate authoritative byte ledgers")
    MemoryReportAssertContains(systemLinkText,
                               "lower.LoweringPlanStructuredLiveBytes(loweringPlan)",
                               " memory report contract: lowering authority used directly")
    MemoryReportAssertContains(systemLinkText,
                               "pobj.PrimaryObjectPlanStructuredLiveBytes(primaryPlan)",
                               " memory report contract: primary authority used directly")
    MemoryReportAssertContains(
        systemLinkText,
        "Fmt\"phase_{phase}_owner_allocator_small_tier_dirty_before_bytes\"",
        " memory report contract: allocator small-tier diagnostic before value")
    MemoryReportAssertContains(
        systemLinkText,
        "Fmt\"phase_{phase}_owner_allocator_small_tier_dirty_after_bytes\"",
        " memory report contract: allocator small-tier diagnostic after value")
    MemoryReportAssertContains(
        systemLinkText,
        "allocator_small_tier_dirty=derived_rss_minus_audited_owners_diagnostic_not_live_bytes",
        " memory report contract: residual physical class cannot impersonate live bytes")
    assert(MemoryReportCount(systemLinkText,
                             "other_string_and_intern_pools") == 0,
           " memory report contract: semantic residual basket name remained")
    assert(MemoryReportCount(loweringText,
                             "LoweringAbortCompilerCsgBind(compilerCsg, plan)") == 33,
           " memory report contract: all partial csg bind failures use cleanup")
    let csgLifetimeBegin = MemoryReportFind(
        systemLinkText,
        "csglife.CompilerCsgProductionLifetimeBegin(\n        compilerCsg,")
    let csgLoweringBorrow = MemoryReportFind(
        systemLinkText,
        "csglife.CompilerCsgProductionLifetimeBorrowForLowering(\n        compilerCsg,")
