import std/system
import std/hashmaps as hashmaps

fn main() =
    var m: hashmaps.HashMapStrInt
    hashmaps.HashMapStrIntInitInPlace(m, 64)
    hashmaps.HashMapStrIntPut(m, "alpha", 0)
    var found: bool
    let got = hashmaps.HashMapStrIntGetMutEx(m, "alpha", found)
    assert(found && got == 0, "repro B1: map roundtrip")
    echo("repro_orc_hashmap_b1 ok")
