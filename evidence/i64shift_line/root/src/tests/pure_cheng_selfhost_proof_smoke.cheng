import std/os
import std/strings
import std/strutils as strutil

fn proofReadRequired(path: str, label: str): str =
    assert(os.FileExists(path),
           strutil.Join([" pure cheng selfhost proof: missing ", label, ": ", path], ""))
    let text = os.ReadFile(path)
    assert(len(text) > 0,
           strutil.Join([" pure cheng selfhost proof: empty ", label, ": ", path], ""))
    return text

fn proofRequire(text: str, needle: str, label: str) =
    assert(strings.StrContains(text, needle),
           strutil.Join([" pure cheng selfhost proof: missing ", label, ": ", needle], ""))

fn proofReject(text: str, needle: str, label: str) =
    assert(!strings.StrContains(text, needle),
           strutil.Join([" pure cheng selfhost proof: forbidden ", label, ": ", needle], ""))

fn proofRequireFileMention(text: str, key: str, path: str, label: str) =
    proofRequire(text, strutil.Join([key, "="], ""), label)
    proofRequire(text, path, label)

fn proofExecutionEvidenceOk(report: str): bool =
    let hostExecuted =
        strings.StrContains(report, "runner=host_exec") &&
        strings.StrContains(report, "install_mode=exec_verified") &&
        strings.StrContains(report, "candidate_status=ok") &&
        strings.StrContains(report, "candidate_verify_export_visibility=ok") &&
        strings.StrContains(report, "selftest_execution=ok") &&
        strings.StrContains(report, "installed_status=ok") &&
        strings.StrContains(report, "installed_verify_export_parallel=ok") &&
        strings.StrContains(report, "installed_selfhost_progress_smoke=ok")
    let crossHostSkipped =
        strings.StrContains(report, "runner=none_cross_host") &&
        strings.StrContains(report, "install_mode=structural_cross_host_install") &&
        strings.StrContains(report, "candidate_status=not_executed_cross_host") &&
        strings.StrContains(report, "candidate_verify_export_visibility=not_executed_cross_host") &&
        strings.StrContains(report, "selftest_execution=not_executed_cross_host") &&
        strings.StrContains(report, "installed_status=not_executed_cross_host") &&
        strings.StrContains(report, "installed_verify_export_parallel=not_executed_cross_host") &&
        strings.StrContains(report, "installed_selfhost_progress_smoke=not_executed_cross_host") &&
        strings.StrContains(report, "cross_host_execution_blocker=target_not_executable_on_windows_host")
    return hostExecuted || crossHostSkipped

fn main(): int32 =
    let root = os.GetCurrentDir()
    let backendDriver = os.JoinPath(root, "artifacts/backend_driver/cheng")
    let backendMap = os.JoinPath(root, "artifacts/backend_driver/cheng.map")
    let backendReportPath = os.JoinPath(root, "artifacts/backend_driver/cheng.report.txt")
    let bootstrapEnvPath = os.JoinPath(root, "artifacts/bootstrap/bootstrap.env")
    let stage2ContractPath = os.JoinPath(root, "artifacts/bootstrap/cheng.stage2.contract.txt")
    let stage3ContractPath = os.JoinPath(root, "artifacts/bootstrap/cheng.stage3.contract.txt")
    let stage2SelfCheckPath = os.JoinPath(root, "artifacts/bootstrap/cheng.stage2.self-check.log")
    let stage3SelfCheckPath = os.JoinPath(root, "artifacts/bootstrap/cheng.stage3.self-check.log")
    let determinismReportPath = os.JoinPath(root, "artifacts/determinism/backend_driver_output_determinism.report.txt")

    assert(os.FileExists(backendDriver),
           strutil.Join([" pure cheng selfhost proof: missing backend driver: ", backendDriver], ""))

    let backendReport = proofReadRequired(backendReportPath, "backend provenance report")
    proofRequire(backendReport, "compiler_class=ordinary_compiler", "full backend compiler class")
    proofRequire(backendReport, "backend_driver_candidate=full_backend_codegen", "backend driver candidate")
    proofRequire(backendReport, "full_backend_codegen=1", "full backend codegen")
    proofRequire(backendReport, "system_link_exec_scope=selfhost_direct", "selfhost system-link scope")
    proofReject(backendReport, "compiler_class=cold_bootstrap", "cold compiler class")
    proofReject(backendReport, "backend_driver_candidate=cold_subset_backend", "cold subset candidate")
    proofReject(backendReport, "candidate_kind=cold_subset_backend", "cold subset kind")
    proofReject(backendReport, "full_backend_codegen=0", "non-full backend codegen")
    proofReject(backendReport, "system_link_exec_scope=cold_subset_direct_macho", "cold subset linker scope")
    assert(os.FileExists(backendMap),
           strutil.Join([" pure cheng selfhost proof: missing backend driver map: ", backendMap], ""))
    proofRequireFileMention(backendReport, "output", backendDriver, "installed backend output")
    proofRequireFileMention(backendReport, "output_map", backendMap, "installed backend map")
    proofRequire(backendReport, "status_log=", "command dispatch status evidence")
    proofRequire(backendReport, "verify_export_visibility_parallel_log=", "export visibility evidence")
    proofRequire(backendReport, "installed_selfhost_progress_smoke_log=", "selfhost progress evidence")
    assert(proofExecutionEvidenceOk(backendReport),
           " pure cheng selfhost proof: execution must be host-verified or explicitly cross-host skipped")

    let bootstrapEnv = proofReadRequired(bootstrapEnvPath, "bootstrap environment")
    proofRequire(bootstrapEnv, "fixed_point=stage2_stage3_contract_match", "bootstrap fixed point")
    let stage2Contract = proofReadRequired(stage2ContractPath, "stage2 contract")
    let stage3Contract = proofReadRequired(stage3ContractPath, "stage3 contract")
    assert(stage2Contract == stage3Contract,
           " pure cheng selfhost proof: stage2/stage3 contracts differ")
    let stage2SelfCheck = proofReadRequired(stage2SelfCheckPath, "stage2 self-check")
    let stage3SelfCheck = proofReadRequired(stage3SelfCheckPath, "stage3 self-check")
    proofRequire(stage2SelfCheck, "cheng_bootstrap_self_check=ok", "stage2 self-check")
    proofRequire(stage3SelfCheck, "cheng_bootstrap_self_check=ok", "stage3 self-check")

    let determinismReport = proofReadRequired(determinismReportPath, "backend determinism report")
    proofRequire(determinismReport, "output_determinism", "determinism report schema")
    proofRequire(determinismReport, "backend_driver_output_reproducible=1", "backend driver reproducible artifact hash")
    proofRequire(determinismReport, "pass=1", "determinism pass")

    echo(" pure_cheng_selfhost_proof_smoke ok")
    return 0
