# backend2_skip_lower_codec_smoke — skip-lower (Tier2-full) 纯值层契约单测。
# spec: docs/beat-c.md §8.12.8
# 覆盖: BodyIR 编解码 round-trip (含 enum/bool/cstring 字段) + funcLowerCid 6-tuple
#       确定性/敏感性 (§3.1 epoch / §3.7 triple / §3.5 注册序不变 / 指纹含体敏感 /
#       §3.2 路径敏感) + 负路径 (空 epoch/triple 硬崩)。
# 纯值层 (仅 import b2fc/b2cid/coreir/layout/b2t/rawbytes), stage3 可编 (镜像 cid_contract_smoke)。
#
# 模式 (argv[1], 缺省 unit):
#   unit        — 正路径全断言, 绿输出 B2_SKIP_LOWER_UNIT_OK, rc=0。
#   empty-epoch — 空 lowerEpochSalt → ComputeFuncLowerCid 必硬崩。
#   empty-triple— 空 targetTriple → ComputeFuncLowerCid 必硬崩。

import std/cmdline as cmdline
import std/rawbytes as rawbytes
import cheng/std/bytes_layout as layout
import cheng/core/ir/core_types as coreir
import cheng/core/backend2/backend2_types as b2t
import cheng/core/backend2/backend2_frag_codec as b2fc
import cheng/core/backend2/backend2_cid as b2cid
import cheng/core/lang/parser as parser
import cheng/core/lang/typed_expr_type_arena as typearena

fn skipLowerTypeArenaArtifactCid(): layout.FixedBytes32 =
    let source = "type Backend2SkipLowerScalar = int32\n"
    var tree: parser.ParserValueExprTree
    var authority: typearena.TypedExprTypeResolutionAuthority
    var arena: typearena.TypedExprTypeArena
    var err: str
    assert(parser.ParserValueExprReadTreeFromText(source, tree, err) &&
           typearena.TypedExprTypeResolutionAuthorityBuildSameSourceInto(
               tree, authority, err) &&
           typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               tree, authority, arena, err) &&
           typearena.TypedExprTypeArenaComplete(arena) &&
           typearena.TypedExprTypeArenaStrictValidateInto(arena, err),
           "skip-lower exact TypeArena fixture")
    let artifact = arena.artifactRaw32
    typearena.TypedExprTypeArenaRelease(arena)
    parser.ParserValueExprTreeRelease(tree)
    return artifact

fn buildView(name: str,
             paramType: str,
             returnType: str): b2t.CalleeAbiView =
    var view: b2t.CalleeAbiView
    view.functionName = name
    add(view.paramTypes, paramType)
    view.returnType = returnType
    return view

# ---- 夹具: 合成 BodyIR (多 op / 多槽含 enum+bool / call 全字段 / term operands / cstring dataLabel) ----

fn buildBodyFixture(operandValue: int32, slotName: str, globalSlotName: str): coreir.BodyIR =
    var body = coreir.BodyIRNew()
    assert(coreir.BodyIRBindTypeArenaArtifactCid(
               body,
               skipLowerTypeArenaArtifactCid()),
           "skip-lower BodyIR TypeArena identity")
    body.entryIsCAbi = true
    # 局部栈槽 (enum+bool 非默认值, 验 int32(enum)/bool 往返)
    var slot0: coreir.LocalSlot
    slot0.id = 0
    slot0.name = slotName
    slot0.typeKind = coreir.LocalI32Tag
    slot0.placeKind = coreir.BodyPlaceStackValueTag
    slot0.sizeBytes = 4
    slot0.alignBytes = 4
    slot0.stackOffset = 16
    slot0.auxValue = 7
    slot0.ownership = 2                      # OwnMove (int32 → enum 验证)
    slot0.aliasClass = 2                     # AliasNoAlias
    slot0.escapeKind = 3                     # EscapeGlobal
    slot0.noAlias = true
    coreir.BodyIRApplyLocalSlotDefaultProof(slot0)
    slot0.placeKind = coreir.BodyPlaceStackValueTag
    slot0.ownership = 2
    slot0.aliasClass = 2
    slot0.escapeKind = 3
    slot0.noAlias = true
    add(body.localSlots, slot0)
    # 全局地址槽 (name 是发射语义, 入哈希)
    var slot1: coreir.LocalSlot
    slot1.id = 1
    slot1.name = globalSlotName
    slot1.typeKind = coreir.LocalI32Tag
    slot1.placeKind = coreir.BodyPlaceGlobalAddressTag
    slot1.sizeBytes = 4
    slot1.alignBytes = 4
    slot1.ownership = coreir.OwnPlainTag
    slot1.escapeKind = coreir.EscapeNoneTag
    slot1.noAlias = false
    coreir.BodyIRApplyLocalSlotDefaultProof(slot1)
    slot1.placeKind = coreir.BodyPlaceGlobalAddressTag
    add(body.localSlots, slot1)
    # 两 op (LoadConst + BinOp, operands 非空)
    var op0: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op0)
    op0.kind = coreir.BodyOpLoadConstTag
    op0.target = 0
    op0.valueDefSlot = 0
    op0.valueDefExprNodeIndex = 71
    op0.valueDefSemanticRow = 71
    op0.valueDefOwnership = coreir.OwnMove
    op0.valueDefConsumeOpIndexPlusOne = 2
    op0.valueDefOriginKind = coreir.BodyDefinitionOriginTypedExprTag
    op0.valueDefOriginId = 71
    op0.sourceValueDefOpId = -1
    op0.consumeActionRow = -1
    add(op0.operands, operandValue)
    add(op0.operands, 0)
    add(body.ops, op0)
    var op1: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op1)
    op1.kind = coreir.BodyOpBinOpTag
    op1.target = 1
    add(op1.operands, 0)
    add(op1.operands, 1)
    add(body.ops, op1)
    # call (全字段: argSlots/argPassKinds/argAbiSizes/resultSlot/resultPassKind/relocWordOffset)
    var call0: coreir.CallOp
    coreir.BodyIRApplyCallOpDefaultProof(call0)
    call0.targetSymbol = "callee_alpha"
    add(call0.argSlots, 0)
    add(call0.argSlots, 1)
    add(call0.argPassKinds, 0)
    add(call0.argPassKinds, 1)
    add(call0.argAbiSizes, 4)
    add(call0.argAbiSizes, 8)
    call0.resultSlot = 0
    call0.resultPassKind = 1
    call0.resultOwnership = coreir.OwnBorrowShared
    call0.resultExprNodeIndex = 73
    call0.resultValueDefinitionRow = 73
    call0.resultDefinitionOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    call0.resultDefinitionOriginId = 73
    call0.sourceValueDefOpId = -1
    call0.consumeActionRow = -1
    call0.managedStoreKind = coreir.ManagedStoreStrRetainTag
    call0.relocWordOffset = 12
    add(body.callSequence, call0)
    # term (operands 非空 + 全标量字段非默认)
    var term0: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(term0)
    term0.kind = coreir.BodyTermReturnTag
    term0.conditionKind = 2
    term0.resultSlot = 0
    term0.sourceValueDefOpId = 41
    term0.lhsSlot = 1
    term0.rhsSlot = -1
    term0.trueBlock = 0
    term0.falseBlock = -1
    add(term0.operands, 0)
    add(body.terms, term0)
    # 两块
    var blk0: coreir.BodyBlock
    blk0.id = 0
    blk0.opStart = 0
    blk0.opCount = 2
    blk0.termIndex = 0
    add(body.blocks, blk0)
    var blk1: coreir.BodyBlock
    blk1.id = 1
    blk1.opStart = 2
    blk1.opCount = 0
    blk1.termIndex = 0
    add(body.blocks, blk1)
    # cstring (含 dataLabel)
    var cstr0: coreir.CStringLiteralEntry
    cstr0.id = 0
    cstr0.text = "hello"
    cstr0.dataLabel = "__cstring_hello"
    add(body.cstringLiterals, cstr0)
    return body

fn runUnit(): int32 =
    let bodyBase = buildBodyFixture(42, "x", "g_counter")

    # ── BodyIR 编解码 round-trip (编→解→再编逐字节等) + 字段抽查 ──
    b2fc.Backend2BodyIrRoundTripAssert(bodyBase)
    var enc = b2fc.Backend2BodyIrEncode(bodyBase)
    var cursor: int32
    let dec = b2fc.Backend2BodyIrDecode(enc, cursor)
    assert(cursor == enc.len, "bodyir decode consumed all bytes")
    # 抽查关键字段 (封 decode 漏读/错位, round-trip 抓不到的 双双跳字段)
    assert(dec.ops.len == 2, "ops count round-trips")
    assert(dec.ops[0].kind == coreir.BodyOpLoadConstTag, "op0 kind round-trips")
    assert(dec.ops[0].operands.len == 2, "op0 operands count round-trips")
    assert(dec.ops[0].operands[0] == 42, "op0 operand value round-trips")
    assert(dec.ops[0].valueDefSlot == 0 &&
           dec.ops[0].valueDefExprNodeIndex == 71 &&
           dec.ops[0].valueDefSemanticRow == 71 &&
           dec.ops[0].valueDefOwnership == coreir.OwnMove &&
           dec.ops[0].valueDefConsumeOpIndexPlusOne == 2 &&
           dec.ops[0].valueDefOriginKind ==
               coreir.BodyDefinitionOriginTypedExprTag &&
           dec.ops[0].valueDefOriginId == 71 &&
           dec.ops[0].sourceValueDefOpId == -1 &&
           dec.ops[0].consumeActionRow == -1,
           "immutable value-def provenance round-trips")
    assert(dec.localSlots.len == 2, "slots count round-trips")
    assert(dec.localSlots[0].name == "x", "slot name round-trips")
    assert(int32(dec.localSlots[0].ownership) == 2, "enum ownership round-trips")
    assert(dec.localSlots[0].noAlias == true, "bool noAlias round-trips")
    assert(dec.localSlots[1].placeKind == coreir.BodyPlaceGlobalAddressTag, "global slot placeKind round-trips")
    assert(dec.callSequence.len == 1, "callSequence count round-trips")
    assert(dec.callSequence[0].targetSymbol == "callee_alpha", "call targetSymbol round-trips")
    assert(dec.callSequence[0].argSlots.len == 2, "call argSlots count round-trips")
    assert(dec.callSequence[0].resultOwnership == coreir.OwnBorrowShared &&
           dec.callSequence[0].resultExprNodeIndex == 73 &&
           dec.callSequence[0].resultValueDefinitionRow == 73 &&
           dec.callSequence[0].resultDefinitionOriginKind ==
               coreir.BodyDefinitionOriginTypedExprTag &&
           dec.callSequence[0].resultDefinitionOriginId == 73 &&
           dec.callSequence[0].sourceValueDefOpId == -1 &&
           dec.callSequence[0].consumeActionRow == -1 &&
           dec.callSequence[0].managedStoreKind ==
               coreir.ManagedStoreStrRetainTag,
           "call ownership provenance round-trips")
    assert(dec.callSequence[0].relocWordOffset == 12, "call relocWordOffset round-trips")
    assert(dec.terms.len == 1, "terms count round-trips")
    assert(dec.terms[0].sourceValueDefOpId == 41,
           "term source value-def round-trips")
    assert(dec.terms[0].operands.len == 1, "term operands count round-trips")
    assert(dec.blocks.len == 2, "blocks count round-trips")
    assert(dec.cstringLiterals.len == 1, "cstring count round-trips")
    assert(dec.cstringLiterals[0].dataLabel == "__cstring_hello", "cstring dataLabel round-trips")
    assert(dec.entryIsCAbi, "entry C ABI provenance round-trips")
    # 再编 == 原编 (封 enc/dec 不对称, 含 enum/bool 编码稳定性)
    var enc2 = b2fc.Backend2BodyIrEncode(dec)
    assert(rawbytes.BytesEqual(enc, enc2), "re-encode byte-equal to original")
    rawbytes.BytesFree(enc)
    rawbytes.BytesFree(enc2)
    # 空 BodyIR round-trip (零长数组臂)
    var emptyBody = coreir.BodyIRNew()
    assert(coreir.BodyIRBindTypeArenaArtifactCid(
               emptyBody,
               skipLowerTypeArenaArtifactCid()),
           "skip-lower empty BodyIR TypeArena identity")
    b2fc.Backend2BodyIrRoundTripAssert(emptyBody)

    # ── funcLowerCid 6-tuple 确定性/敏感性 ──
    # 用 bodyIR 级 TypedFnCanonicalHash 作 typed 指纹代理 (单元级验 cid 组合逻辑; 真指纹
    # 在 pipeline 从 typed IR 构建, 同 sha256 域)。
    let fpBase = b2cid.Backend2TypedFnCanonicalHash(bodyBase, "fn_alpha")
    var bodyInternal = bodyBase
    bodyInternal.entryIsCAbi = false
    let fpInternal = b2cid.Backend2TypedFnCanonicalHash(bodyInternal, "fn_alpha")
    assert(layout.FixedBytes32Hex(fpInternal) != layout.FixedBytes32Hex(fpBase),
           "entry ABI provenance flips canonical fingerprint")
    var bodyAuxChanged = bodyBase
    bodyAuxChanged.localSlots[0].auxValue = 8
    let fpAuxChanged = b2cid.Backend2TypedFnCanonicalHash(
        bodyAuxChanged, "fn_alpha")
    assert(layout.FixedBytes32Hex(fpAuxChanged) !=
               layout.FixedBytes32Hex(fpBase),
           "allocator-visible slot auxValue flips canonical fingerprint")
    var bodyNoAliasChanged = bodyBase
    bodyNoAliasChanged.localSlots[0].noAlias = false
    let fpNoAliasChanged = b2cid.Backend2TypedFnCanonicalHash(
        bodyNoAliasChanged, "fn_alpha")
    assert(layout.FixedBytes32Hex(fpNoAliasChanged) !=
               layout.FixedBytes32Hex(fpBase),
           "allocator-visible noAlias flips canonical fingerprint")
    let pathHash = b2cid.Backend2SourcePathHash("/ws", "", "/ws/src/a.cheng")
    var callTargets: str[]
    add(callTargets, "callee_beta")
    add(callTargets, "callee_alpha")
    var importcSymbols: str[]
    add(importcSymbols, "libc_write")
    add(importcSymbols, "libc_close")
    var views: b2t.CalleeAbiView[]
    add(views, buildView("callee_beta", "i64", "bool"))
    add(views, buildView("callee_alpha", "int32", "int32"))
    let cidBase = b2cid.Backend2ComputeFuncLowerCid(
        "backend2-slice13", "arm64-apple-darwin", fpBase, pathHash,
        callTargets, importcSymbols, views)
    assert(len(cidBase) == 64, "funcLowerCid is 64-hex sha256")
    let cidInternal = b2cid.Backend2ComputeFuncLowerCid(
        "backend2-slice13", "arm64-apple-darwin", fpInternal, pathHash,
        callTargets, importcSymbols, views)
    assert(cidInternal != cidBase,
           "entry ABI provenance flips funcLowerCid through its canonical component")

    # 确定性: 同输入 → 同 cid
    let cidDup = b2cid.Backend2ComputeFuncLowerCid(
        "backend2-slice13", "arm64-apple-darwin", fpBase, pathHash,
        callTargets, importcSymbols, views)
    assert(cidDup == cidBase, "determinism: same inputs same cid")

    # §3.1 epoch: 盐变 → cid 必变
    let cidEpoch = b2cid.Backend2ComputeFuncLowerCid(
        "backend2-slice14", "arm64-apple-darwin", fpBase, pathHash,
        callTargets, importcSymbols, views)
    assert(cidEpoch != cidBase, "epoch salt flips funcLowerCid")

    # §3.7 triple: 目标变 → cid 必变
    let cidTriple = b2cid.Backend2ComputeFuncLowerCid(
        "backend2-slice13", "x86_64-apple-darwin", fpBase, pathHash,
        callTargets, importcSymbols, views)
    assert(cidTriple != cidBase, "target triple flips funcLowerCid")

    # §3.5 注册序扰动: callTargets/importc 反序 → cid 必不变
    var callTargetsRev: str[]
    add(callTargetsRev, "callee_alpha")
    add(callTargetsRev, "callee_beta")
    var importcRev: str[]
    add(importcRev, "libc_close")
    add(importcRev, "libc_write")
    var viewsRev: b2t.CalleeAbiView[]
    add(viewsRev, buildView("callee_alpha", "int32", "int32"))
    add(viewsRev, buildView("callee_beta", "i64", "bool"))
    let cidReordered = b2cid.Backend2ComputeFuncLowerCid(
        "backend2-slice13", "arm64-apple-darwin", fpBase, pathHash,
        callTargetsRev, importcRev, viewsRev)
    assert(cidReordered == cidBase, "registration order does not flip funcLowerCid")

    # Callee ABI is a lowering input (arg/result pass kind and size). A
    # signature-only edit must miss skip-lower even when caller text is stable.
    var viewsAbiChanged: b2t.CalleeAbiView[]
    add(viewsAbiChanged, buildView("callee_beta", "i64", "bool"))
    add(viewsAbiChanged, buildView("callee_alpha", "i64", "int32"))
    let cidAbiChanged = b2cid.Backend2ComputeFuncLowerCid(
        "backend2-slice13", "arm64-apple-darwin", fpBase, pathHash,
        callTargets, importcSymbols, viewsAbiChanged)
    assert(cidAbiChanged != cidBase,
           "callee signature change misses funcLowerCid")

    # 含体敏感: 指纹变 (体变 42→43) → cid 必变
    let bodyChanged = buildBodyFixture(43, "x", "g_counter")
    let fpChanged = b2cid.Backend2TypedFnCanonicalHash(bodyChanged, "fn_alpha")
    assert(layout.FixedBytes32Hex(fpChanged) != layout.FixedBytes32Hex(fpBase),
           "body change flips typed fingerprint")
    let cidBody = b2cid.Backend2ComputeFuncLowerCid(
        "backend2-slice13", "arm64-apple-darwin", fpChanged, pathHash,
        callTargets, importcSymbols, views)
    assert(cidBody != cidBase, "fingerprint change flips funcLowerCid")

    # §3.2 路径敏感: 路径变 → cid 必变; workspace 前缀剥除 → 跨根稳定
    let pathHashOtherRoot = b2cid.Backend2SourcePathHash("/other-root", "", "/other-root/src/a.cheng")
    assert(layout.FixedBytes32Hex(pathHashOtherRoot) == layout.FixedBytes32Hex(pathHash),
           "workspace prefix stripped: cross-root stable")
    let cidSameRelPath = b2cid.Backend2ComputeFuncLowerCid(
        "backend2-slice13", "arm64-apple-darwin", fpBase,
        pathHashOtherRoot, callTargets, importcSymbols, views)
    assert(cidSameRelPath == cidBase, "same rel path keeps funcLowerCid")
    let pathHashOtherFile = b2cid.Backend2SourcePathHash("/ws", "", "/ws/src/b.cheng")
    let cidOtherFile = b2cid.Backend2ComputeFuncLowerCid(
        "backend2-slice13", "arm64-apple-darwin", fpBase,
        pathHashOtherFile, callTargets, importcSymbols, views)
    assert(cidOtherFile != cidBase, "different source path flips funcLowerCid")

    # 空串 callSeq 合法 (无调用边的函数) → cid 不崩
    var emptyTargets: str[]
    var emptyImportc: str[]
    var emptyViews: b2t.CalleeAbiView[]
    let cidNoCalls = b2cid.Backend2ComputeFuncLowerCid(
        "backend2-slice13", "arm64-apple-darwin", fpBase, pathHash,
        emptyTargets, emptyImportc, emptyViews)
    assert(len(cidNoCalls) == 64, "empty callSeq is legal")

    echo("B2_SKIP_LOWER_UNIT_OK")
    return 0

fn runEmptyEpoch(): int32 =
    let fp = b2cid.Backend2TypedFnCanonicalHash(buildBodyFixture(1, "x", "g"), "fn")
    let pathHash = b2cid.Backend2SourcePathHash("/ws", "", "/ws/src/a.cheng")
    var t: str[]
    var im: str[]
    var views: b2t.CalleeAbiView[]
    let _ = b2cid.Backend2ComputeFuncLowerCid(
        "", "arm64-apple-darwin", fp, pathHash, t, im, views)
    echo("B2_SKIP_LOWER_EMPTY_EPOCH_NOT_CAUGHT")
    return 1

fn runEmptyTriple(): int32 =
    let fp = b2cid.Backend2TypedFnCanonicalHash(buildBodyFixture(1, "x", "g"), "fn")
    let pathHash = b2cid.Backend2SourcePathHash("/ws", "", "/ws/src/a.cheng")
    var t: str[]
    var im: str[]
    var views: b2t.CalleeAbiView[]
    let _ = b2cid.Backend2ComputeFuncLowerCid(
        "backend2-slice13", "", fp, pathHash, t, im, views)
    echo("B2_SKIP_LOWER_EMPTY_TRIPLE_NOT_CAUGHT")
    return 1

fn main(argc: int32, argv: str*): int32 =
    argc
    argv
    cmdline.CaptureCmdLine(argc, argv)
    var mode = ""
    if cmdline.ParamCount() >= 1:
        mode = cmdline.ParamStr(1)
    if mode == "" || mode == "unit":
        return runUnit()
    if mode == "empty-epoch":
        return runEmptyEpoch()
    if mode == "empty-triple":
        return runEmptyTriple()
    echo("B2_SKIP_LOWER_UNKNOWN_MODE")
    return 2
