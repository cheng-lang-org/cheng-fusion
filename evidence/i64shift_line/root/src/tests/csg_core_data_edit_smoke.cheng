import std/os as os
import std/strings
import cheng/core/csg_core/csgc
import cheng/core/csg_core/data_edit
import cheng/core/csg_core/json_canonical as canonical

@borrows
fn smokeFail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

@borrows
fn expect(cond: bool, message: str): int32 =
    if !cond:
        return smokeFail(message)
    return 0

@borrows
fn expectContains(text: str, needle: str, message: str): int32 =
    if !strings.StrContains(text, needle):
        os.WriteLine(os.Get_stderr(), text)
        return smokeFail(message)
    return 0

fn main(): int32 =
    var controlReceiptInput: data_edit.CsgDataEditResult
    controlReceiptInput.error = "bad:\x01"
    let controlReceipt =
        data_edit.CsgDataEditReceiptJson(
            controlReceiptInput)
    let canonicalControlReceipt =
        canonical.CsgCoreJsonCanonicalize(
            controlReceipt)
    if expect(
           canonicalControlReceipt.ok &&
           canonicalControlReceipt.value == controlReceipt,
           "data-edit receipt control bytes are not canonical") != 0:
        return 1
    if expectContains(
           controlReceipt,
           "\"error\":\"bad:\\u0001\"",
           "data-edit receipt control-byte escape mismatch") != 0:
        return 1
    let schema = "{\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\",\"features\":[\"core-facts\"]}"
    let moduleA = "{\"kind\":\"csg.module\",\"id\":\"mod_a\",\"path\":\"a.cheng\",\"sha256\":\"sha256:aaa\"}"
    let moduleAChanged = "{\"sha256\":\"sha256:bbb\",\"path\":\"a2.cheng\",\"id\":\"mod_a\",\"kind\":\"csg.module\"}"
    let symbolA = "{\"kind\":\"csg.symbol\",\"id\":\"sym_a\",\"name\":\"A\",\"symbolKind\":\"fn\"}"
    let symbolB = "{\"kind\":\"csg.symbol\",\"id\":\"sym_b\",\"name\":\"B\",\"symbolKind\":\"fn\"}"

    var ops: data_edit.CsgDataEditOperation[]
    add(
        ops,
        data_edit.CsgDataEditReplaceById(
            "mod_a",
            strings.CloneStr(moduleAChanged)))

    let edited = data_edit.CsgDataEditApplyLines([strings.CloneStr(schema), strings.CloneStr(moduleA), strings.CloneStr(symbolA)], ops)
    if expect(edited.ok, "edit should succeed") != 0:
        return 1
    if expect(edited.complete, "edit should be complete") != 0:
        return 1
    if expect(edited.lines.len == 3, "edited fact count mismatch") != 0:
        return 1
    if expect(edited.appendedCount == 0, "append count mismatch") != 0:
        return 1
    if expect(edited.replacedCount == 1, "replace count mismatch") != 0:
        return 1
    if expect(edited.deletedCount == 0, "delete count mismatch") != 0:
        return 1
    if expect(
           edited.merkleReplayCount == 1 &&
           edited.merkleReplayVerified,
           "Merkle replay admission mismatch") != 0:
        return 1
    if expect(edited.beforeRoot != edited.afterRoot, "roots should change") != 0:
        return 1
    if expect(edited.lines[0] == "{\"id\":\"mod_a\",\"kind\":\"csg.module\",\"path\":\"a2.cheng\",\"sha256\":\"sha256:bbb\"}", "replace canonical mismatch") != 0:
        return 1
    if expect(edited.lines[1] == "{\"id\":\"sym_a\",\"kind\":\"csg.symbol\",\"name\":\"A\",\"symbolKind\":\"fn\"}", "retained fact canonical mismatch") != 0:
        return 1
    if expect(edited.lines[2] == "{\"features\":[\"core-facts\"],\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}", "schema canonical mismatch") != 0:
        return 1
    if expectContains(edited.receipt, "\"schema\":\"csg_data_edit.receipt\"", "receipt schema missing") != 0:
        return 1
    if expectContains(
           edited.receipt,
           "\"merkle_replay_verified\":true",
           "Merkle replay receipt missing") != 0:
        return 1

    let encoded = csgc.CsgCoreCsgcEncodeCanonicalLines(edited.lines)
    if expect(encoded.ok, "csgc encode failed") != 0:
        return 1
    let decoded = csgc.CsgCoreCsgcDecodeLines(encoded.bytes)
    if expect(decoded.ok, "csgc decode failed") != 0:
        return 1
    if expect(decoded.lines.len == edited.lines.len, "csgc line count mismatch") != 0:
        return 1
    for i in 0..<edited.lines.len:
        if expect(decoded.lines[i] == edited.lines[i], "csgc roundtrip mismatch") != 0:
            return 1

    var noOps: data_edit.CsgDataEditOperation[]
    let csgcEdited = data_edit.CsgDataEditApplyCsgcBytes(encoded.bytes, noOps)
    if expect(!csgcEdited.ok, "csgc edit no-op must be rejected") != 0:
        return 1
    if expect(
           csgcEdited.beforeRoot.len == 0 &&
           csgcEdited.afterRoot.len == 0 &&
           csgcEdited.lines.len == 0,
           "no-op must fail before admission") != 0:
        return 1
    if expectContains(
           csgcEdited.error,
           "data_edit_requires_single_admitted_replace",
           "no-op rejection mismatch") != 0:
        return 1

    var duplicateOps: data_edit.CsgDataEditOperation[]
    add(
        duplicateOps,
        data_edit.CsgDataEditAppendFact(
            strings.CloneStr(moduleA)))
    let duplicateAppend = data_edit.CsgDataEditApplyLines([strings.CloneStr(schema), strings.CloneStr(moduleA)], duplicateOps)
    if expect(!duplicateAppend.ok, "duplicate append should fail") != 0:
        return 1
    if expectContains(duplicateAppend.error, "data_edit_requires_single_admitted_replace", "append rejection mismatch") != 0:
        return 1

    var missingOps: data_edit.CsgDataEditOperation[]
    add(missingOps, data_edit.CsgDataEditReplaceById("missing", strings.CloneStr(moduleAChanged)))
    let missingReplace = data_edit.CsgDataEditApplyLines([strings.CloneStr(schema), strings.CloneStr(moduleA)], missingOps)
    if expect(!missingReplace.ok, "missing replace should fail") != 0:
        return 1
    if expectContains(missingReplace.error, "replace_id_mismatch", "missing replace mismatch should fail first") != 0:
        return 1

    var missingExactOps: data_edit.CsgDataEditOperation[]
    add(missingExactOps, data_edit.CsgDataEditReplaceById("sym_b", strings.CloneStr(symbolB)))
    let missingExactReplace = data_edit.CsgDataEditApplyLines([strings.CloneStr(schema), strings.CloneStr(moduleA)], missingExactOps)
    if expect(!missingExactReplace.ok, "missing exact replace should fail") != 0:
        return 1
    if expectContains(missingExactReplace.error, "replace_missing_id", "missing exact replace error mismatch") != 0:
        return 1

    var deleteOps: data_edit.CsgDataEditOperation[]
    add(deleteOps, data_edit.CsgDataEditDeleteById("mod_a"))
    let duplicateDelete = data_edit.CsgDataEditApplyLines([strings.CloneStr(schema), strings.CloneStr(moduleA), strings.CloneStr(moduleA)], deleteOps)
    if expect(!duplicateDelete.ok, "duplicate delete should fail") != 0:
        return 1
    if expectContains(duplicateDelete.error, "data_edit_requires_single_admitted_replace", "delete rejection mismatch") != 0:
        return 1

    var invalidAppendOps: data_edit.CsgDataEditOperation[]
    add(
        invalidAppendOps,
        data_edit.CsgDataEditAppendFact(
            "{\"id\":\"future\",\"kind\":\"csg.future_fact\"}"))
    let invalidAppend =
        data_edit.CsgDataEditApplyLines(
            [strings.CloneStr(schema), strings.CloneStr(moduleA)], invalidAppendOps)
    if expect(
           !invalidAppend.ok &&
           invalidAppend.beforeRoot.len == 0 &&
           invalidAppend.afterRoot.len == 0 &&
           invalidAppend.lines.len == 0 &&
           invalidAppend.appendedCount == 0,
           "append must fail before admission") != 0:
        return 1
    if expectContains(
           invalidAppend.error,
           "data_edit_requires_single_admitted_replace",
           "invalid candidate admission error mismatch") != 0:
        return 1

    os.WriteLine(os.Get_stdout(), "csg_core_data_edit_smoke ok")
    return 0
