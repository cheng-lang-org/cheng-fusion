import cheng/core/lang/parser

fn Rejects(source: str): bool =
    var table: parser.NormalizedFfiHandleContractTable
    var err: str
    return !parser.ParserReadNormalizedFfiHandleContracts(
        source, table, err)

fn PositiveSource(): str =
    return """
@ffi_handle(unwind=no_unwind, result=produce)
@importc("ffi_produce")
fn Produce(): uint64

@ffi_handle(unwind=no_unwind, arg0=borrow)
@importc("ffi_borrow")
fn Borrow(handle: uint64): int32

@ffi_handle(unwind=no_unwind, arg0=consume)
@importc("ffi_consume")
fn Consume(handle: uint64): int32

@ffi_handle(unwind=no_unwind, arg1=consume, result=produce, arg0=borrow)
@importc("ffi_multi")
fn Multi(left: uint64, right: uint64): uint64
"""

fn OrderedMultiSource(): str =
    return """
@ffi_handle(unwind=no_unwind, result=produce, arg0=borrow, arg1=consume)
@importc("ffi_multi")
fn Multi(left: uint64, right: uint64): uint64
"""

fn ReorderedMultiSource(): str =
    return """
@ffi_handle(arg1=consume, unwind=no_unwind, arg0=borrow, result=produce)
@importc("ffi_multi")
fn Multi(left: uint64, right: uint64): uint64
"""

fn main(): int32 =
    var table: parser.NormalizedFfiHandleContractTable
    var err: str
    assert(parser.ParserReadNormalizedFfiHandleContracts(
               PositiveSource(), table, err),
           Fmt"ffi handle positive parse failed: {err}")
    assert(parser.ParserNormalizedFfiHandleContractTableStrictValid(table),
           "ffi handle positive table invalid")
    assert(parser.ParserNormalizedFfiHandleContractCount(table) == 4,
           "ffi handle contract count mismatch")
    for row in 0..<4:
        assert(parser.ParserNormalizedFfiHandleContractUnwindKindAt(
                   table, row) ==
                   parser.NormalizedFfiHandleUnwindNoUnwind,
               "ffi handle mandatory no_unwind contract mismatch")
    assert(parser.ParserNormalizedFfiHandleContractResultEffectAt(
               table, 0) == parser.NormalizedFfiHandleEffectProduce &&
           parser.ParserNormalizedFfiHandleContractParameterCountAt(
               table, 0) == 0,
           "ffi handle produce contract mismatch")
    assert(parser.ParserNormalizedFfiHandleContractResultEffectAt(
               table, 1) == parser.NormalizedFfiHandleEffectInvalid &&
           parser.ParserNormalizedFfiHandleContractParameterEffectAt(
               table, 1, 0) == parser.NormalizedFfiHandleEffectBorrow,
           "ffi handle borrow contract mismatch")
    assert(parser.ParserNormalizedFfiHandleContractParameterEffectAt(
               table, 2, 0) == parser.NormalizedFfiHandleEffectConsume,
           "ffi handle consume contract mismatch")
    assert(parser.ParserNormalizedFfiHandleContractResultEffectAt(
               table, 3) == parser.NormalizedFfiHandleEffectProduce &&
           parser.ParserNormalizedFfiHandleContractParameterCountAt(
               table, 3) == 2 &&
           parser.ParserNormalizedFfiHandleContractParameterOrdinalAt(
               table, 3, 0) == 0 &&
           parser.ParserNormalizedFfiHandleContractParameterOrdinalAt(
               table, 3, 1) == 1 &&
           parser.ParserNormalizedFfiHandleContractParameterEffectAt(
               table, 3, 0) == parser.NormalizedFfiHandleEffectBorrow &&
           parser.ParserNormalizedFfiHandleContractParameterEffectAt(
               table, 3, 1) == parser.NormalizedFfiHandleEffectConsume,
           "ffi handle multi-role canonical order mismatch")
    assert(parser.ParserNormalizedFfiHandleContractFunctionDeclarationRowAt(
               table, 3) >= 0 &&
           parser.ParserNormalizedFfiHandleContractAnnotationRowAt(
               table, 3) >= 0 &&
           parser.ParserNormalizedFfiHandleContractParameterDeclarationRowAt(
               table, 3, 0) >= 0 &&
           parser.ParserNormalizedFfiHandleContractParameterDeclarationRowAt(
               table, 3, 1) >= 0 &&
           parser.ParserNormalizedFfiHandleContractParameterDeclarationRowAt(
               table, 3, 0) !=
               parser.ParserNormalizedFfiHandleContractParameterDeclarationRowAt(
                   table, 3, 1),
           "ffi handle exact declaration identities missing")

    var absent: parser.NormalizedFfiHandleContractTable
    err = ""
    assert(parser.ParserReadNormalizedFfiHandleContracts("""
@importc("ffi_plain")
fn Plain(handle: uint64): int32
""", absent, err) &&
           parser.ParserNormalizedFfiHandleContractCount(absent) == 0,
           "ffi handle absent annotation created a contract row")

    var ordered: parser.NormalizedFfiHandleContractTable
    var reordered: parser.NormalizedFfiHandleContractTable
    err = ""
    assert(parser.ParserReadNormalizedFfiHandleContracts(
               OrderedMultiSource(), ordered, err),
           Fmt"ffi handle ordered source failed: {err}")
    err = ""
    assert(parser.ParserReadNormalizedFfiHandleContracts(
               ReorderedMultiSource(), reordered, err),
           Fmt"ffi handle reordered source failed: {err}")
    assert(parser.ParserNormalizedFfiHandleContractIdentityDigestAt(
               ordered, 0) ==
           parser.ParserNormalizedFfiHandleContractIdentityDigestAt(
               reordered, 0) &&
           parser.ParserNormalizedFfiHandleContractParameterCountAt(
               ordered, 0) == 2 &&
           parser.ParserNormalizedFfiHandleContractParameterCountAt(
               reordered, 0) == 2 &&
           parser.ParserNormalizedFfiHandleContractParameterOrdinalAt(
               ordered, 0, 0) ==
               parser.ParserNormalizedFfiHandleContractParameterOrdinalAt(
                   reordered, 0, 0) &&
           parser.ParserNormalizedFfiHandleContractParameterOrdinalAt(
               ordered, 0, 1) ==
               parser.ParserNormalizedFfiHandleContractParameterOrdinalAt(
                   reordered, 0, 1) &&
           parser.ParserNormalizedFfiHandleContractParameterDeclarationRowAt(
               ordered, 0, 0) ==
               parser.ParserNormalizedFfiHandleContractParameterDeclarationRowAt(
                   reordered, 0, 0) &&
           parser.ParserNormalizedFfiHandleContractParameterDeclarationRowAt(
               ordered, 0, 1) ==
               parser.ParserNormalizedFfiHandleContractParameterDeclarationRowAt(
                   reordered, 0, 1) &&
           parser.ParserNormalizedFfiHandleContractParameterEffectAt(
               ordered, 0, 0) ==
               parser.ParserNormalizedFfiHandleContractParameterEffectAt(
                   reordered, 0, 0) &&
           parser.ParserNormalizedFfiHandleContractParameterEffectAt(
               ordered, 0, 1) ==
               parser.ParserNormalizedFfiHandleContractParameterEffectAt(
                   reordered, 0, 1),
           "ffi handle source root order changed canonical identity")

    assert(Rejects("""
@ffi_handle(result=produce)
@importc("missing_unwind")
fn MissingUnwind(): uint64
"""), "ffi handle missing unwind survived")
    assert(Rejects("""
@ffi_handle(unwind=no_unwind, unwind=no_unwind, result=produce)
@importc("duplicate_unwind")
fn DuplicateUnwind(): uint64
"""), "ffi handle duplicate unwind survived")
    assert(Rejects("""
@ffi_handle(unwind=may_unwind, result=produce)
@importc("illegal_unwind")
fn IllegalUnwind(): uint64
"""), "ffi handle illegal unwind survived")
    assert(Rejects("""
@ffi_handle_consume(arg0=consume)
@importc("legacy_consume")
fn LegacyConsume(handle: uint64): int32
"""), "legacy ffi_handle_consume survived")
    assert(Rejects("""
@ffi_handle(unwind=no_unwind, result=produce, result=produce)
@importc("duplicate_result")
fn DuplicateResult(): uint64
"""), "ffi handle duplicate result survived")
    assert(Rejects("""
@ffi_handle(unwind=no_unwind, arg0=borrow, arg0=consume)
@importc("duplicate_arg")
fn DuplicateArg(handle: uint64): int32
"""), "ffi handle duplicate arg survived")
    assert(Rejects("""
@ffi_handle(unwind=no_unwind, arg1=borrow)
@importc("out_of_range")
fn OutOfRange(handle: uint64): int32
"""), "ffi handle out-of-range arg survived")
    assert(Rejects("""
@ffi_handle(unwind=no_unwind, arg00=borrow)
@importc("leading_zero")
fn LeadingZero(handle: uint64): int32
"""), "ffi handle arg00 survived")
    assert(Rejects("""
@ffi_handle(unwind=no_unwind, arg01=borrow)
@importc("leading_zero_nonzero")
fn LeadingZeroNonzero(left: uint64, right: uint64): int32
"""), "ffi handle arg01 survived")
    assert(Rejects("""
@ffi_handle(unwind=no_unwind, arg2147483648=borrow)
@importc("overflow")
fn Overflow(handle: uint64): int32
"""), "ffi handle overflowing ordinal survived")
    assert(Rejects("""
@ffi_handle(unwind=no_unwind, arg0=retain)
@importc("unknown_effect")
fn UnknownEffect(handle: uint64): int32
"""), "ffi handle unknown effect survived")
    assert(Rejects("""
@ffi_handle(unwind=no_unwind, handle=borrow)
@importc("unknown_key")
fn UnknownKey(handle: uint64): int32
"""), "ffi handle unknown key survived")
    assert(Rejects("""
@ffi_handle(unwind=no_unwind, result="produce")
@importc("non_identifier")
fn NonIdentifier(): uint64
"""), "ffi handle non-identifier effect survived")
    assert(Rejects("""
@ffi_handle(unwind=no_unwind, "arg0"=borrow)
@importc("non_identifier_key")
fn NonIdentifierKey(handle: uint64): int32
"""), "ffi handle non-identifier key survived")
    assert(Rejects("""
@ffi_handle(unwind=no_unwind, result=borrow)
@importc("bad_result")
fn BadResult(): uint64
"""), "ffi handle non-produce result survived")
    assert(Rejects("""
@ffi_handle(unwind=no_unwind, arg0=produce)
@importc("bad_arg")
fn BadArg(handle: uint64): int32
"""), "ffi handle produce parameter survived")
    assert(Rejects("""
@ffi_handle(unwind=no_unwind, arg0=borrow)
fn ChengFunction(handle: uint64): int32 =
    return 0
"""), "ffi handle Cheng function binding survived")
    assert(Rejects("""
@ffi_handle(unwind=no_unwind, arg0=borrow)
@ffi_handle(unwind=no_unwind, arg0=borrow)
@importc("duplicate_contract")
fn DuplicateContract(handle: uint64): int32
"""), "duplicate ffi handle contract survived")

    var mutated = ordered
    mutated.parameterSourceLocalDeclarationRows[0] =
        mutated.parameterSourceLocalDeclarationRows[0] + 1
    assert(!parser.ParserNormalizedFfiHandleContractTableStrictValid(mutated),
           "ffi handle wrong parameter declaration row survived digest")

    echo("parser_ffi_handle_positive_roles=4")
    echo("parser_ffi_handle_surface_negatives=18")
    echo("parser_ffi_handle_unwind_negatives=3")
    echo("parser_ffi_handle_identity_mutations=1")
    echo("parser_ffi_handle_contract_smoke: ok")
    return 0
