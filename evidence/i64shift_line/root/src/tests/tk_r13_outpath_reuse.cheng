type
    R13Request =
        targetTriple: str
        outputPath: str

fn R13Remove(path: str): bool =
    return path.len > 0

fn R13Make(dir: str, name: str): str =
    return Fmt"{dir}/{name}"

fn R13Link(request: R13Request): bool =
    return request.outputPath.len > 0

fn R13Run(): int32 =
    let outputPath = R13Make("outdir", "app.exe")
    var request: R13Request
    request.targetTriple = "arm64-apple-darwin"
    request.outputPath = outputPath
    if !R13Link(request):
        return 10
    let _ = R13Remove(outputPath)
    return 0

fn main(): int32 =
    let code = R13Run()
    if code != 0:
        return code
    echo("r13_outpath ok")
    return 0
