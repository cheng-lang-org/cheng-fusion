import cheng/tests/cold_direct_import_identity_owner as owner

fn main(): int32 =
    if sizeof(owner.DirectDerived) != 16:
        return 1
    var value: owner.DirectDerived
    value.baseValue = 7
    value.childValue = 11
    if value.baseValue != 7:
        return 2
    if value.childValue != 11:
        return 3
    if sizeof(owner.DirectHolder) <= 0:
        return 4
    return 0
