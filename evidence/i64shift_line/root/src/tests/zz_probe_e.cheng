import std/result
import cheng/inference/hf_model_graph as hfgraph

fn main(): int32 =
    let r = hfgraph.HfModelGraphBuildGlmMoeFromConfig(
        "{\"model_type\":\"glm_moe\",\"vocab_size\":4,\"num_hidden_layers\":1,\"n_layer\":1,\"num_attention_heads\":1,\"n_head\":1,\"moe_intermediate_size\":1,\"num_experts\":1,\"n_routed_experts\":1,\"num_experts_per_tok\":1}",
        "cid:p", "fp16", "none")
    echo(" glm_builder_probe reachable")
    return 0
