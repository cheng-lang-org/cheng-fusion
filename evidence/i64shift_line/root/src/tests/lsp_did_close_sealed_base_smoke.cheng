import std/os
import std/result
import std/strings
import std/system
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/csg_core/compiler_snapshot_schema as schema
import cheng/core/tooling/compiler_execution_stage_receipt as execution
import cheng/core/tooling/compiler_world as cworld
import cheng/core/tooling/lsp_server as lsp
import cheng/core/tooling/semantic_snapshot as snapshot

@borrows
fn TestCid(text: str): layout.FixedBytes32 =
    var bytes = layout.ByteBufInit(text.len)
    for index in 0..<text.len:
        layout.ByteBufAppendByte(bytes, Int32(text[index]) & 255)
    let out = hash256.Sha256Fixed(layout.ByteBufView(bytes))
    layout.ByteBufFree(bytes)
    return out

fn TestExecution(): execution.CompilerExecutionIdentity =
    return Value(execution.CompilerExecutionIdentityMake(
        "lsp-did-close-sealed-base",
        TestCid("compiler-source-bundle"),
        TestCid("materializer"),
        TestCid("grammar"),
        TestCid("compiler-source-closure"),
        TestCid("driver"),
        TestCid("toolchain"),
        TestCid("command"),
        "arm64-apple-darwin"))

fn TestUniverse(): cworld.CompilerLocalUniverse =
    var universe: cworld.CompilerLocalUniverse
    var entries: cworld.CompilerUniverseManifestEntry[]
    var err: str
    assert(cworld.CompilerLocalUniverseBuildForChannelWithManifestEntriesInto(
               universe, err, "stable",
               TestExecution().sourceBundleRaw32,
               TestCid("compiler-csg-root"),
               TestCid("compiler-export-surface"),
               layout.FixedBytes32(), entries), err)
    return universe

@borrows
fn CurrentVersionTerminal(
        workspace: lsp.LspWorkspace,
        sourceVersion: int64): bool =
    let count = workspace.snapshotStore.core.states.len
    if count <= 0 ||
       workspace.eventState.lastAcceptedSourceVersion != sourceVersion ||
       workspace.snapshotStore.core.currentSourceVersion != sourceVersion ||
       workspace.snapshotStore.core.candidateIndex != -1 ||
       workspace.snapshotStore.core.sourceVersions[count - 1] !=
           sourceVersion:
        return false
    let state = workspace.snapshotStore.core.states[count - 1]
    return state == snapshot.SemanticSnapshotStatePublished ||
        state == snapshot.SemanticSnapshotStateRejected

fn main() =
    let root = "/tmp/cheng_lsp_did_close_sealed_base_fixture"
    let sourceRoot = "/tmp/cheng_lsp_did_close_sealed_base_fixture/src"
    let sourcePath =
        "/tmp/cheng_lsp_did_close_sealed_base_fixture/src/main.cheng"
    let missingPath =
        "/tmp/cheng_lsp_did_close_sealed_base_fixture/src/missing.cheng"
    let renamedPath =
        "/tmp/cheng_lsp_did_close_sealed_base_fixture/src/renamed.cheng"
    let uri =
        "file:///tmp/cheng_lsp_did_close_sealed_base_fixture/src/main.cheng"
    let renamedUri =
        "file:///tmp/cheng_lsp_did_close_sealed_base_fixture/src/renamed.cheng"
    let baseText = "fn Main(): int32 =\n    return 1\n"
    let diskMutation = "fn Main(): int32 =\n    return 99\n"
    let openText = "fn Main(): int32 =\n    return 2\n"
    let changedText = "fn Main(): int32 =\n    return 3\n"
    os.MkdirAll(sourceRoot, 493)
    os.WriteFile(
        "/tmp/cheng_lsp_did_close_sealed_base_fixture/cheng-package.toml",
        "package_id = \"pkg://pkg\"\nmodule_prefix = \"pkg\"\n")
    os.WriteFile(sourcePath, baseText)
    let totalAllocBefore = system.memAllocCount()
    let totalFreeBefore = system.memFreeCount()
    let totalLiveBefore = system.memLiveCount()
    let totalRetainBefore = system.memRetainCount()
    let totalReleaseBefore = system.memReleaseCount()

    var missingWorkspace: lsp.LspWorkspace
    var err: str
    assert(lsp.LspWorkspaceInitInto(
               TestCid("lsp-did-close/missing-session"),
               TestUniverse(), TestExecution(), missingWorkspace, err), err)
    assert(!lsp.LspWorkspaceBindDocumentCompilerIdentityInto(
               missingWorkspace,
               "file:///tmp/cheng_lsp_did_close_sealed_base_fixture/src/missing.cheng",
               root, root, "pkg", "arm64-apple-darwin",
               missingPath, "pkg/missing", true, err) &&
           strings.StrContains(err, "base source read failed") &&
           missingWorkspace.documents.len == 0 &&
           missingWorkspace.metrics.explicitSourceFileReadCount == int64(0),
           "lsp didClose base: missing base read mutated binding")
    assert(!lsp.LspWorkspaceBindDocumentCompilerIdentityInto(
               missingWorkspace, "untitled:main.cheng",
               root, root, "pkg", "arm64-apple-darwin",
               sourcePath, "pkg/main", true, err) &&
           missingWorkspace.documents.len == 0,
           "lsp didClose base: virtual URI fabricated removal semantics")
    assert(lsp.LspWorkspaceReleaseInto(missingWorkspace, err), err)

    var workspace: lsp.LspWorkspace
    assert(lsp.LspWorkspaceInitInto(
               TestCid("lsp-did-close/session"),
               TestUniverse(), TestExecution(), workspace, err), err)
    assert(lsp.LspWorkspaceBindDocumentCompilerIdentityInto(
               workspace, uri, root, root, "pkg",
               "arm64-apple-darwin", sourcePath,
               "pkg/main", true, err), err)
    let baseCid = schema.CsgCompilerSourceContentCid(baseText)
    assert(workspace.documents.len == 1 &&
           workspace.documents[0].sealedBaseSourceBound &&
           workspace.documents[0].sealedBaseSourceText == baseText &&
           layout.FixedBytes32Equal(
               workspace.documents[0].sealedBaseSourceContentCid,
               baseCid) &&
           workspace.metrics.explicitSourceFileReadCount == int64(1) &&
           workspace.metrics.explicitSourceFileReadBytes ==
               int64(baseText.len),
           "lsp didClose base: binding did not seal exact source bytes")

    var sourceVersion: int64
    let createFailureAllocBefore = system.memAllocCount()
    let createFailureFreeBefore = system.memFreeCount()
    let createFailureLiveBefore = system.memLiveCount()
    assert(!lsp.LspWorkspaceDidCreateFileInto(
               workspace, uri, sourceVersion, err) &&
           sourceVersion == int64(0) &&
           strings.StrContains(err, "duplicate or split document identity") &&
           workspace.documents.len == 1 &&
           workspace.metrics.candidateAttemptCount == int64(0),
           "lsp file event owner: duplicate create mutated workspace")
    err = ""
    assert(system.memAllocCount() - createFailureAllocBefore ==
               system.memFreeCount() - createFailureFreeBefore &&
           system.memLiveCount() == createFailureLiveBefore,
           "lsp file event owner: create failure leaked document owner")

    os.WriteFile(renamedPath, baseText)
    let renameFailureAllocBefore = system.memAllocCount()
    let renameFailureFreeBefore = system.memFreeCount()
    let renameFailureLiveBefore = system.memLiveCount()
    let renameStoreVersion =
        workspace.snapshotStore.core.currentSourceVersion
    workspace.snapshotStore.core.currentSourceVersion =
        renameStoreVersion + int64(1)
    let renameRejected =
        !lsp.LspWorkspaceDidRenameFileInto(
            workspace, uri, renamedUri, sourceVersion, err)
    workspace.snapshotStore.core.currentSourceVersion =
        renameStoreVersion
    assert(renameRejected &&
           sourceVersion == int64(0) &&
           workspace.documents.len == 1 &&
           workspace.documents[0].uri == uri &&
           workspace.metrics.candidateAttemptCount == int64(0),
           "lsp file event owner: rejected rename mutated workspace")
    err = ""
    assert(system.memAllocCount() - renameFailureAllocBefore ==
               system.memFreeCount() - renameFailureFreeBefore &&
           system.memLiveCount() == renameFailureLiveBefore,
           "lsp file event owner: rename failure leaked local owners")

    os.WriteFile(sourcePath, diskMutation)
    assert(lsp.LspWorkspaceBindDocumentCompilerIdentityInto(
               workspace, uri, root, root, "pkg",
               "arm64-apple-darwin", sourcePath,
               "pkg/main", true, err) &&
           workspace.documents[0].sealedBaseSourceText == baseText &&
           workspace.metrics.explicitSourceFileReadCount == int64(1),
           "lsp didClose base: repeated binding reopened disk bytes")

    assert(lsp.LspWorkspaceDidOpenInto(
               workspace, uri, int64(1), openText,
               sourceVersion, err) && sourceVersion == int64(1), err)
    var sameTextChange: lsp.LspContentChange
    sameTextChange.rangePresent = true
    sameTextChange.startLine = 1
    sameTextChange.startCharacter = 11
    sameTextChange.endLine = 1
    sameTextChange.endCharacter = 12
    sameTextChange.rangeLengthPresent = true
    sameTextChange.rangeLength = 1
    sameTextChange.text = "2"
    var invalidChange: lsp.LspContentChange
    invalidChange.rangePresent = true
    invalidChange.startLine = 99
    invalidChange.startCharacter = 0
    invalidChange.endLine = 99
    invalidChange.endCharacter = 0
    invalidChange.text = "invalid"
    let firstFailureAllocBefore = system.memAllocCount()
    let firstFailureFreeBefore = system.memFreeCount()
    let firstFailureLiveBefore = system.memLiveCount()
    assert(!lsp.LspWorkspaceDidChangeInto(
               workspace, uri, int64(2), [invalidChange],
               sourceVersion, err) &&
           sourceVersion == int64(0) &&
           workspace.documents[0].text == openText &&
           workspace.metrics.candidateAttemptCount == int64(1),
           "lsp content owner: first edit failure mutated document")
    err = ""
    assert(system.memAllocCount() - firstFailureAllocBefore ==
               system.memFreeCount() - firstFailureFreeBefore &&
           system.memLiveCount() == firstFailureLiveBefore,
           "lsp content owner: first edit failure leaked scratch")
    let lateFailureAllocBefore = system.memAllocCount()
    let lateFailureFreeBefore = system.memFreeCount()
    let lateFailureLiveBefore = system.memLiveCount()
    assert(!lsp.LspWorkspaceDidChangeInto(
               workspace, uri, int64(2),
               [sameTextChange, invalidChange],
               sourceVersion, err) &&
           sourceVersion == int64(0) &&
           workspace.documents[0].text == openText &&
           workspace.metrics.candidateAttemptCount == int64(1),
           "lsp content owner: late edit failure committed partial text")
    err = ""
    assert(system.memAllocCount() - lateFailureAllocBefore ==
               system.memFreeCount() - lateFailureFreeBefore &&
           system.memLiveCount() == lateFailureLiveBefore,
           "lsp content owner: late edit failure leaked owned replacement")
    assert(lsp.LspWorkspaceDidChangeInto(
               workspace, uri, int64(2), [sameTextChange],
               sourceVersion, err) && sourceVersion == int64(2) &&
           workspace.documents[0].text == openText &&
           workspace.documents[0].sourceText == openText,
           "lsp content owner: no-op same-text edit drifted bytes")
    var change: lsp.LspContentChange
    change.rangePresent = true
    change.startLine = 1
    change.startCharacter = 11
    change.endLine = 1
    change.endCharacter = 12
    change.rangeLengthPresent = true
    change.rangeLength = 1
    change.text = "3"
    assert(lsp.LspWorkspaceDidChangeInto(
               workspace, uri, int64(3), [change],
               sourceVersion, err) && sourceVersion == int64(3) &&
           workspace.documents[0].sourceText == changedText, err)
    assert(lsp.LspWorkspaceDidCloseInto(
               workspace, uri, sourceVersion, err) &&
           sourceVersion == int64(4) &&
           CurrentVersionTerminal(workspace, sourceVersion) &&
           !workspace.documents[0].open &&
           workspace.documents[0].text == "" &&
           workspace.documents[0].sourceText == baseText &&
           layout.FixedBytes32Equal(
               workspace.documents[0].sourceContentCid, baseCid) &&
           workspace.documents[0].lineStartByteOffsets.len == 0 &&
           workspace.documents[0].sourceHashBlockStates.len == 0 &&
           workspace.documents[0].sourceHashBlockStatesMirror.len == 0 &&
           workspace.metrics.explicitSourceFileReadCount == int64(1),
           "lsp didClose base: close did not atomically restore sealed base")

    assert(lsp.LspWorkspaceDidOpenInto(
               workspace, uri, int64(4), openText,
               sourceVersion, err) && sourceVersion == int64(5), err)
    let candidateAttemptBeforeRejectedChange =
        workspace.metrics.candidateAttemptCount
    assert(!lsp.LspWorkspaceDidChangeInto(
               workspace, uri, int64(4), [change],
               sourceVersion, err) &&
           sourceVersion == int64(0) &&
           workspace.eventState.lastAcceptedSourceVersion == int64(5) &&
           workspace.snapshotStore.core.currentSourceVersion == int64(5) &&
           workspace.metrics.candidateAttemptCount ==
               candidateAttemptBeforeRejectedChange &&
           workspace.documents[0].text == openText,
           "lsp event chain: rejected client version started a candidate")
    let cacheCid =
        layout.FixedBytes32Copy(
            workspace.documents[0].sourceHashCacheContentCid)
    workspace.documents[0].sourceHashCacheContentCid.data[0] =
        uint8(Int32(
            workspace.documents[0].sourceHashCacheContentCid.data[0]) ^ 1)
    let cacheFailureAllocBefore = system.memAllocCount()
    let cacheFailureFreeBefore = system.memFreeCount()
    let cacheFailureLiveBefore = system.memLiveCount()
    assert(!lsp.LspWorkspaceDidChangeInto(
               workspace, uri, int64(5), [change],
               sourceVersion, err) &&
           sourceVersion == int64(0) &&
           strings.StrContains(err, "cache binding is corrupt") &&
           workspace.eventState.lastAcceptedSourceVersion == int64(5) &&
           workspace.documents[0].text == openText,
           "lsp content owner: cache reject committed replacement")
    workspace.documents[0].sourceHashCacheContentCid = cacheCid
    err = ""
    assert(system.memAllocCount() - cacheFailureAllocBefore ==
               system.memFreeCount() - cacheFailureFreeBefore &&
           system.memLiveCount() == cacheFailureLiveBefore,
           "lsp content owner: cache reject leaked owned replacement")
    assert(lsp.LspWorkspaceDidChangeInto(
               workspace, uri, int64(5), [change],
               sourceVersion, err) && sourceVersion == int64(6) &&
           workspace.documents[0].sourceText == changedText, err)
    var definition: lsp.LspExactDefinitionResult
    assert(!lsp.LspWorkspaceExactDefinitionInto(
               workspace, uri, 0, 3, definition, err) &&
           strings.StrContains(err, "content modified"),
           "lsp didClose base: reopened version returned stale result")
    let acceptedVersion =
        workspace.eventState.lastAcceptedSourceVersion
    let acceptedText = workspace.documents[0].text
    let sealedCid =
        workspace.documents[0].sealedBaseSourceContentCid
    workspace.documents[0].sealedBaseSourceContentCid.data[0] =
        uint8(Int32(workspace.documents[
            0].sealedBaseSourceContentCid.data[0]) ^ 1)
    assert(!lsp.LspWorkspaceDidCloseInto(
               workspace, uri, sourceVersion, err) &&
           sourceVersion == int64(0) &&
           strings.StrContains(err, "sealed base source binding is corrupt") &&
           workspace.eventState.lastAcceptedSourceVersion ==
               acceptedVersion &&
           workspace.documents[0].open &&
           workspace.documents[0].text == acceptedText,
           "lsp didClose base: base CID tamper mutated source version")
    workspace.documents[0].sealedBaseSourceContentCid = sealedCid
    workspace.documents[0].sealedBaseSourceBound = false
    assert(!lsp.LspWorkspaceDidCloseInto(
               workspace, uri, sourceVersion, err) &&
           workspace.eventState.lastAcceptedSourceVersion ==
               acceptedVersion &&
           workspace.documents[0].open,
           "lsp didClose base: missing sealed base accepted")
    workspace.documents[0].sealedBaseSourceBound = true
    assert(lsp.LspWorkspaceDidCloseInto(
               workspace, uri, sourceVersion, err) &&
           sourceVersion == int64(7) &&
           CurrentVersionTerminal(workspace, sourceVersion) &&
           workspace.documents[0].sourceText == baseText &&
           workspace.metrics.explicitSourceFileReadCount == int64(1) &&
           workspace.metrics.eventAcceptedCount == int64(7) &&
           workspace.metrics.candidateAttemptCount == int64(7) &&
           workspace.metrics.compilerSnapshotBuilderAttemptCount ==
               int64(7) &&
           workspace.metrics.candidateRejectedCount == int64(7) &&
           workspace.metrics.candidatePublishedCount == int64(0) &&
           workspace.snapshotStore.core.states.len == 7 &&
           workspace.snapshotStore.rejectionSnapshotIndexes.len == 7 &&
           strings.StrContains(
               workspace.candidateBlockedReason, "source_version=7"), err)
    let candidateAttempt =
        workspace.metrics.candidateAttemptCount
    let compilerSnapshotBuilderAttempt =
        workspace.metrics.compilerSnapshotBuilderAttemptCount
    let candidatePublished =
        workspace.metrics.candidatePublishedCount
    let candidateRejected =
        workspace.metrics.candidateRejectedCount
    assert(lsp.LspWorkspaceReleaseInto(workspace, err), err)
    err = ""
    let totalAlloc = system.memAllocCount() - totalAllocBefore
    let totalFree = system.memFreeCount() - totalFreeBefore
    let totalRetain = system.memRetainCount() - totalRetainBefore
    let totalRelease = system.memReleaseCount() - totalReleaseBefore
    assert(totalAlloc > int64(0) &&
           totalAlloc == totalFree &&
           system.memLiveCount() == totalLiveBefore &&
           totalRetain == int64(0) &&
           totalRelease == totalFree,
           "lsp event owner: alloc/free/live/retain/release drift")
    os.WriteLine(os.Get_stdout(),
        Fmt"lsp_did_close_sealed_base_smoke: ok source_version=7 reads=1 candidate_attempt={candidateAttempt} builder_attempt={compilerSnapshotBuilderAttempt} published={candidatePublished} rejected={candidateRejected} alloc={totalAlloc} free={totalFree} live=0 retain=0 release={totalRelease}")
