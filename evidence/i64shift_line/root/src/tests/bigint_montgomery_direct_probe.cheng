import std/result
import std/crypto/bigint

fn firstWord(v: bigint.BigInt): int32 =
    if v.count <= 0:
        return 0
    return v.limbs[0]

fn secondWord(v: bigint.BigInt): int32 =
    if v.count <= 1:
        return 0
    return v.limbs[1]

fn main(): int32 =
    let base: bigint.BigInt = bigint.bigFromInt(4)
    let exp: bigint.BigInt = bigint.bigFromInt(13)
    let modv: bigint.BigInt = bigint.bigFromInt(497)
    var ctx: bigint.BigMontgomeryContext
    let ctxRes: Result[bool] = bigint.bigBuildMontgomeryContextInto(ctx, modv)
    if IsErr(ctxRes):
        echo(Error(ctxRes))
        return 1
    if ctx.modulusCount != 1:
        echo(Fmt"bigint_montgomery_direct_probe: ctx modulus count={ctx.modulusCount}")
        return 1
    if ctx.r2.count <= 0:
        echo(Fmt"bigint_montgomery_direct_probe: ctx r2 zero n0={ctx.n0Inv}")
        return 1
    var scratch: bigint.BigMontgomeryScratch
    bigint.bigMontgomeryScratchSet(scratch, 1, uint64(151))
    if bigint.bigMontgomeryScratchGet(scratch, 1) != uint64(151):
        echo(Fmt"bigint_montgomery_direct_probe: scratch set/get failed value={bigint.bigMontgomeryScratchGet(scratch, 1)}")
        return 1
    var oneForScratch: bigint.BigInt = bigint.bigFromInt(1)
    bigint.bigMontgomeryAddMulAt(scratch, 0, uint64(436), oneForScratch, 1)
    if bigint.bigMontgomeryScratchGet(scratch, 0) != uint64(436):
        echo(Fmt"bigint_montgomery_direct_probe: addmul first failed s0={bigint.bigMontgomeryScratchGet(scratch, 0)}")
        return 1
    if ctx.oneMont.count <= 0:
        echo(Fmt"bigint_montgomery_direct_probe: ctx oneMont zero r2_count={ctx.r2.count} r2_word0={firstWord(ctx.r2)} n0={ctx.n0Inv}")
        return 1
    var oneBack: bigint.BigInt
    var one: bigint.BigInt = bigint.bigFromInt(1)
    var oneMontLocal: bigint.BigInt = ctx.oneMont
    let oneBackRes: Result[bool] = bigint.bigMontgomeryMulCoreInto(oneBack, oneMontLocal, one, ctx)
    if IsErr(oneBackRes):
        echo(Error(oneBackRes))
        return 1
    if oneBack.count != 1 || firstWord(oneBack) != 1:
        echo(Fmt"bigint_montgomery_direct_probe: one back mismatch count={oneBack.count} word0={firstWord(oneBack)} oneMont={firstWord(ctx.oneMont)}")
        return 1
    var out: bigint.BigInt
    let intoRes: Result[bool] = bigint.bigModExpInto(out, base, exp, modv)
    if IsErr(intoRes):
        echo(Error(intoRes))
        return 1
    if out.count != 1 || firstWord(out) != 445:
        echo(Fmt"bigint_montgomery_direct_probe: into mismatch count={out.count} word0={firstWord(out)}")
        return 1
    let res: Result[bigint.BigInt] = bigint.bigModExp(base, exp, modv)
    if IsErr(res):
        echo(Error(res))
        return 1
    let value: bigint.BigInt = Value(res)
    if value.count != 1 || firstWord(value) != 445:
        echo(Fmt"bigint_montgomery_direct_probe: result mismatch count={value.count} word0={firstWord(value)}")
        return 1
    let base2: bigint.BigInt = bigint.bigFromInt(1234567890123)
    let exp2: bigint.BigInt = bigint.bigFromInt(17)
    let mod2: bigint.BigInt = bigint.bigFromInt(1099511627791)
    var ctx2: bigint.BigMontgomeryContext
    let ctx2Res: Result[bool] = bigint.bigBuildMontgomeryContextInto(ctx2, mod2)
    if IsErr(ctx2Res):
        echo(Error(ctx2Res))
        return 1
    if ctx2.r2.count != 2 || firstWord(ctx2.r2) != -863985 || secondWord(ctx2.r2) != 255:
        echo(Fmt"bigint_montgomery_direct_probe: two-limb r2 mismatch count={ctx2.r2.count} word0={firstWord(ctx2.r2)} word1={secondWord(ctx2.r2)}")
        return 1
    if ctx2.oneMont.count != 2 || firstWord(ctx2.oneMont) != -251658225 || secondWord(ctx2.oneMont) != 255:
        echo(Fmt"bigint_montgomery_direct_probe: two-limb oneMont mismatch count={ctx2.oneMont.count} word0={firstWord(ctx2.oneMont)} word1={secondWord(ctx2.oneMont)}")
        return 1
    var base2Mod: bigint.BigInt
    let base2ModRes: Result[bool] = bigint.bigModInto(base2Mod, base2, mod2)
    if IsErr(base2ModRes):
        echo(Error(base2ModRes))
        return 1
    var r2Local: bigint.BigInt = ctx2.r2
    var base2Mont: bigint.BigInt
    let base2MontRes: Result[bool] = bigint.bigMontgomeryMulCoreInto(base2Mont, base2Mod, r2Local, ctx2)
    if IsErr(base2MontRes):
        echo(Error(base2MontRes))
        return 1
    var base2Back: bigint.BigInt
    var one2: bigint.BigInt = bigint.bigFromInt(1)
    let base2BackRes: Result[bool] = bigint.bigMontgomeryMulCoreInto(base2Back, base2Mont, one2, ctx2)
    if IsErr(base2BackRes):
        echo(Error(base2BackRes))
        return 1
    if base2Back.count != 2 || firstWord(base2Back) != 1912276156 || secondWord(base2Back) != 31:
        echo(Fmt"bigint_montgomery_direct_probe: base roundtrip mismatch count={base2Back.count} word0={firstWord(base2Back)} word1={secondWord(base2Back)}")
        return 1
    var base2SqMont: bigint.BigInt
    let base2SqMontRes: Result[bool] = bigint.bigMontgomeryMulCoreInto(base2SqMont, base2Mont, base2Mont, ctx2)
    if IsErr(base2SqMontRes):
        echo(Error(base2SqMontRes))
        return 1
    var base2SqBack: bigint.BigInt
    let base2SqBackRes: Result[bool] = bigint.bigMontgomeryMulCoreInto(base2SqBack, base2SqMont, one2, ctx2)
    if IsErr(base2SqBackRes):
        echo(Error(base2SqBackRes))
        return 1
    if base2SqBack.count != 2 || firstWord(base2SqBack) != 1353927029 || secondWord(base2SqBack) != 158:
        echo(Fmt"bigint_montgomery_direct_probe: square roundtrip mismatch count={base2SqBack.count} word0={firstWord(base2SqBack)} word1={secondWord(base2SqBack)}")
        return 1
    var pow4Mont: bigint.BigInt
    let pow4MontRes: Result[bool] = bigint.bigMontgomeryMulCoreInto(pow4Mont, base2SqMont, base2SqMont, ctx2)
    if IsErr(pow4MontRes):
        echo(Error(pow4MontRes))
        return 1
    var pow4Back: bigint.BigInt
    let pow4BackRes: Result[bool] = bigint.bigMontgomeryMulCoreInto(pow4Back, pow4Mont, one2, ctx2)
    if IsErr(pow4BackRes):
        echo(Error(pow4BackRes))
        return 1
    if pow4Back.count != 2 || firstWord(pow4Back) != 1526512523 || secondWord(pow4Back) != 40:
        echo(Fmt"bigint_montgomery_direct_probe: pow4 mismatch count={pow4Back.count} word0={firstWord(pow4Back)} word1={secondWord(pow4Back)}")
        return 1
    if pow4Mont.count != 2 || firstWord(pow4Mont) != -25692127 || secondWord(pow4Mont) != 2:
        echo(Fmt"bigint_montgomery_direct_probe: pow4Mont mismatch count={pow4Mont.count} word0={firstWord(pow4Mont)} word1={secondWord(pow4Mont)}")
        return 1
    var pow8Mont: bigint.BigInt
    let pow8MontRes: Result[bool] = bigint.bigMontgomeryMulCoreInto(pow8Mont, pow4Mont, pow4Mont, ctx2)
    if IsErr(pow8MontRes):
        echo(Error(pow8MontRes))
        return 1
    var pow8Back: bigint.BigInt
    let pow8BackRes: Result[bool] = bigint.bigMontgomeryMulCoreInto(pow8Back, pow8Mont, one2, ctx2)
    if IsErr(pow8BackRes):
        echo(Error(pow8BackRes))
        return 1
    if pow8Back.count != 2 || firstWord(pow8Back) != 312908353 || secondWord(pow8Back) != 112:
        echo(Fmt"bigint_montgomery_direct_probe: pow8 mismatch count={pow8Back.count} word0={firstWord(pow8Back)} word1={secondWord(pow8Back)}")
        return 1
    var pow16Mont: bigint.BigInt
    let pow16MontRes: Result[bool] = bigint.bigMontgomeryMulCoreInto(pow16Mont, pow8Mont, pow8Mont, ctx2)
    if IsErr(pow16MontRes):
        echo(Error(pow16MontRes))
        return 1
    var pow16Back: bigint.BigInt
    let pow16BackRes: Result[bool] = bigint.bigMontgomeryMulCoreInto(pow16Back, pow16Mont, one2, ctx2)
    if IsErr(pow16BackRes):
        echo(Error(pow16BackRes))
        return 1
    if pow16Back.count != 2 || firstWord(pow16Back) != -1738589615 || secondWord(pow16Back) != 29:
        echo(Fmt"bigint_montgomery_direct_probe: pow16 mismatch count={pow16Back.count} word0={firstWord(pow16Back)} word1={secondWord(pow16Back)}")
        return 1
    var out2: bigint.BigInt
    let intoRes2: Result[bool] = bigint.bigModExpInto(out2, base2, exp2, mod2)
    if IsErr(intoRes2):
        echo(Error(intoRes2))
        return 1
    if out2.count != 2 || firstWord(out2) != -908659211 || secondWord(out2) != 209:
        echo(Fmt"bigint_montgomery_direct_probe: two-limb mismatch count={out2.count} word0={firstWord(out2)} word1={secondWord(out2)}")
        return 1
    echo("bigint_montgomery_direct_probe ok")
    return 0
