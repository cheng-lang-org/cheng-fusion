# Runtime verification for S1 (桥接侧切片) — GOP keyframe signal read, added to
# web_scene_media_network_bridge.cheng (WebSceneMediaEsIsKeyFrame / WebSceneMediaEsSnapToKeyFrame).
# Real QUIC client against a real media_moq_publisher_main process — no mocked network,
# no faked flags: the publisher serves the real hgs_faststart.moqidx/.h264 fixture, and
# this test reads the flags word (+8 in each 12-byte frame entry) purely through the
# already-established ES open/index path (webSceneMediaEsReadLeU32), same as offset/size.
#
# Asserts, in order:
#   1. WebSceneMediaEsOpen succeeds against the real publisher.
#   2. Scanning frame 0..FrameCount()-1 with WebSceneMediaEsIsKeyFrame collects EXACTLY the
#      keyframe indices [0,120,240,360,480,600] — the blueprint §1.1 ground truth, independently
#      cross-checked by a standalone python3 struct.unpack of the same .moqidx file (not this
#      Cheng parser) in the caller shell script, so a wrong offset can't produce a false green.
#   3. WebSceneMediaEsSnapToKeyFrame snaps correctly: mid-GOP forward and backward, exact hit,
#      and out-of-range clamp.
# Any failure prints a reason and exits nonzero; success prints "ALL OK" and exits 0.

import std/os
import std/strutils as strutil
import std/cmdline as cmdline
import cheng/core/runtime/web_scene_media_network_bridge as media_bridge

# cheng_host_es_diag is imported (not defined) by web_scene_media_network_bridge.cheng
# itself (its own @importc — this file never calls it directly). On-device it is provided
# by the real host (cheng_gui_host.c / mobile_shell_codegen's generated C). This desktop
# harness has no such host, so the C-ABI symbol is provided at link time by a tiny no-op
# C stub linked in alongside the compiled objects (see the verify script for this test).

fn fail(msg: str): int32 =
    os.WriteLine(os.Get_stdout(), strutil.Join(["FAIL: ", msg], ""))
    return 1

fn main(): int32 =
    var hostRaw: str
    let hasHost: bool = cmdline.ReadFirstFlagValue("--host", hostRaw)
    let host: str = if hasHost: hostRaw else: "127.0.0.1"
    let port: int32 = cmdline.ReadInt32FlagOrDefault("--port", 38000)

    # 1. Open against the real publisher.
    if !media_bridge.WebSceneMediaEsOpen(host, port):
        return fail(strutil.Join(["es_open failed: ", media_bridge.WebSceneMediaEsLastError()], ""))
    os.WriteLine(os.Get_stdout(), "step1_open_ok")

    let frames: int32 = media_bridge.WebSceneMediaEsFrameCount()
    if frames <= 0:
        return fail("FrameCount() returned <= 0")
    os.WriteLine(os.Get_stdout(), strutil.Join(["step1b_frame_count=", IntToStr(frames)], ""))

    # 2. Scan every frame, collect keyframe indices, compare against the blueprint §1.1
    # ground truth in lockstep (no array-push needed — both sides advance in the same order).
    var expected: int32[] = [0, 120, 240, 360, 480, 600]
    var foundCount: int32 = 0
    var f: int32 = 0
    while f < frames:
        if media_bridge.WebSceneMediaEsIsKeyFrame(f):
            if foundCount >= expected.len:
                return fail(strutil.Join(["more keyframes than expected, extra at frame=", IntToStr(f)], ""))
            if f != expected[foundCount]:
                return fail(strutil.Join(["keyframe index mismatch at position=", IntToStr(foundCount),
                                           " got=", IntToStr(f), " want=", IntToStr(expected[foundCount])], ""))
            foundCount = foundCount + 1
        f = f + 1
    if foundCount != expected.len:
        return fail(strutil.Join(["found ", IntToStr(foundCount), " keyframes, want ", IntToStr(expected.len)], ""))
    os.WriteLine(os.Get_stdout(), "step2_keyframe_scan_ok")

    # 3. SnapToKeyFrame: mid-GOP backward snap, exact hit, near-start clamp-to-0, and
    # out-of-range (past last frame) clamp.
    let snap300: int32 = media_bridge.WebSceneMediaEsSnapToKeyFrame(300)
    if snap300 != 240:
        return fail(strutil.Join(["SnapToKeyFrame(300)=", IntToStr(snap300), " want 240"], ""))
    let snap119: int32 = media_bridge.WebSceneMediaEsSnapToKeyFrame(119)
    if snap119 != 0:
        return fail(strutil.Join(["SnapToKeyFrame(119)=", IntToStr(snap119), " want 0"], ""))
    let snap600: int32 = media_bridge.WebSceneMediaEsSnapToKeyFrame(600)
    if snap600 != 600:
        return fail(strutil.Join(["SnapToKeyFrame(600)=", IntToStr(snap600), " want 600"], ""))
    let snap674: int32 = media_bridge.WebSceneMediaEsSnapToKeyFrame(674)
    if snap674 != 600:
        return fail(strutil.Join(["SnapToKeyFrame(674)=", IntToStr(snap674), " want 600 (clamp)"], ""))
    os.WriteLine(os.Get_stdout(), "step3_snap_to_keyframe_ok")

    os.WriteLine(os.Get_stdout(), "ALL OK")
    return 0
