import std/system
import std/os
import std/strutils as strutil
import std/rawbytes
import std/result
import std/crypto/sha256
import std/crypto/curve25519
import std/crypto/ecnist
import std/crypto/bigint
import std/crypto/p256_fixed as pfix
import cheng/std/crypto/fixed256
import cheng/std/bytes_layout as layout

@importc("cheng_monotime_ns")
fn cryptoPerfMonoTimeNs(): int64

fn cryptoPerfEnvInt(name: str, defaultValue: int32): int32 =
    let raw: str = os.GetEnvDefault(name, "")
    if len(raw) <= 0:
        return defaultValue
    let parsed: int32 = int32(strutil.ParseInt(raw))
    if parsed <= 0:
        return defaultValue
    return parsed

fn cryptoPerfElapsedNs(startNs: int64): int64 =
    return cryptoPerfMonoTimeNs() - startNs

fn cryptoPerfNsPerOp(elapsedNs: int64, iterations: int32): int64 =
    if iterations <= 0:
        return int64(-1)
    return elapsedNs / int64(iterations)

fn cryptoPerfEmit(name: str, elapsedNs: int64, iterations: int32) =
    let nsPerOp: int64 = cryptoPerfNsPerOp(elapsedNs, iterations)
    echo(strutil.Join([name, " ns_per_op=", int64ToStr(nsPerOp), " iterations=", IntToStr(iterations)], ""))
    echo(strutil.Join([name, "_ns_per_op=", int64ToStr(nsPerOp)], ""))

fn cryptoPerfP256SignBytes(priv: fixed256.Scalar256, msg: Bytes): Result[Bytes] =
    var sigFixed: layout.FixedBytes64
    let sigRes: Result[bool] = fixed256.p256SignMessageFixed64Into(sigFixed, priv, msg)
    if IsErr(sigRes):
        return Err[Bytes](Error(sigRes))
    return Ok[Bytes](layout.FixedBytes64ToBytes(sigFixed))

fn cryptoPerfP256BackendAnchor(): bool =
    var scalarModulus: pfix.P256Fixed = pfix.p256ScalarModulus()
    let one: bigint.BigInt = bigint.bigFromInt(1)
    return !pfix.p256FixedIsZero(scalarModulus) && !bigint.bigIsZero(one)

fn cryptoPerfRunP256(p256Priv: fixed256.Scalar256,
                     p256Msg: Bytes,
                     p256PubIters: int32,
                     p256SignIters: int32): int32 =
    var sink: int32
    assert(cryptoPerfP256BackendAnchor(), " crypto perf: p256 backend anchor")
    let pPubStart = cryptoPerfMonoTimeNs()
    for i in 0..<p256PubIters:
        let pubRes: Result[layout.FixedBytes65] = fixed256.p256PublicKey65FromPrivateScalar(p256Priv)
        if IsErr(pubRes):
            echo(Error(pubRes))
        assert(IsOk(pubRes), " crypto perf: p256 pubkey")
        let pubBytes: Bytes = layout.FixedBytes65ToBytes(Value(pubRes))
        assert(BytesLen(pubBytes) == 65, " crypto perf: p256 pubkey len")
        sink = sink + BytesGet(pubBytes, i % 65)
    let pPubElapsedNs: int64 = cryptoPerfElapsedNs(pPubStart)
    cryptoPerfEmit("crypto_p256_pubkey", pPubElapsedNs, p256PubIters)

    let verifyPubRes: Result[layout.FixedBytes65] = fixed256.p256PublicKey65FromPrivateScalar(p256Priv)
    assert(IsOk(verifyPubRes), " crypto perf: p256 verify pubkey")
    let verifyPubBytes: Bytes = layout.FixedBytes65ToBytes(Value(verifyPubRes))
    var lastSig: Bytes
    let pSignStart = cryptoPerfMonoTimeNs()
    for i in 0..<p256SignIters:
        let sigRes: Result[Bytes] = cryptoPerfP256SignBytes(p256Priv, p256Msg)
        if IsErr(sigRes):
            echo(Error(sigRes))
        assert(IsOk(sigRes), " crypto perf: p256 sign")
        let sigBytes: Bytes = Value(sigRes)
        assert(BytesLen(sigBytes) == 64, " crypto perf: p256 sign len")
        let sigCopy: Bytes = BytesSlice(sigBytes, 0, 64)
        lastSig = sigCopy
        sink = sink + BytesGet(sigBytes, i % 64)
    let pSignElapsedNs: int64 = cryptoPerfElapsedNs(pSignStart)
    cryptoPerfEmit("crypto_p256_sign", pSignElapsedNs, p256SignIters)
    assert(ecnist.ecdsaVerifyTrustedBytes(verifyPubBytes, p256Msg, lastSig),
           " crypto perf: p256 sign verify")
    return sink

fn main(): int32 =
    let shaIters: int32 = cryptoPerfEnvInt("CHENG_CRYPTO_PERF_SHA256_ITERS", 200)
    let x25519Iters: int32 = cryptoPerfEnvInt("CHENG_CRYPTO_PERF_X25519_ITERS", 2)
    let p256PubIters: int32 = cryptoPerfEnvInt("CHENG_CRYPTO_PERF_P256_PUB_ITERS", 1)
    let p256SignIters: int32 = cryptoPerfEnvInt("CHENG_CRYPTO_PERF_P256_SIGN_ITERS", 1)
    let shaInput: Bytes = BytesFromString("cheng-crypto-hot-kernel-sha256-input")
    let alicePriv: Bytes = BytesFromString("12345678901234567890123456789012")
    let p256PrivRes: Result[fixed256.Scalar256] = fixed256.scalar256FromHex(
        "60d71049a0cafe01faa9948dc77ee5bc4bd5e05b8e328fdb9cc4c38237250a05")
    assert(IsOk(p256PrivRes), " crypto perf: p256 private scalar")
    let p256Priv: fixed256.Scalar256 = Value(p256PrivRes)
    let p256Msg: Bytes = BytesFromString("cheng-crypto-hot-kernel-p256-message")
    var sink: int32

    let shaStart = cryptoPerfMonoTimeNs()
    for i in 0..<shaIters:
        let digest: Bytes = sha256.Sha256Digest(shaInput)
        assert(BytesLen(digest) == 32, " crypto perf: sha256 digest len")
        sink = sink + BytesGet(digest, i % 32)
    let shaElapsedNs: int64 = cryptoPerfElapsedNs(shaStart)
    cryptoPerfEmit("crypto_sha256", shaElapsedNs, shaIters)

    let xStart = cryptoPerfMonoTimeNs()
    for i in 0..<x25519Iters:
        let pubRes: Result[Bytes] = curve25519.curve25519PublicFromPrivate(alicePriv)
        assert(IsOk(pubRes), " crypto perf: x25519 pubkey")
        let pub: Bytes = Value(pubRes)
        assert(BytesLen(pub) == 32, " crypto perf: x25519 pubkey len")
        sink = sink + BytesGet(pub, i % 32)
    let xElapsedNs: int64 = cryptoPerfElapsedNs(xStart)
    cryptoPerfEmit("crypto_x25519_pubkey", xElapsedNs, x25519Iters)

    sink = sink + cryptoPerfRunP256(p256Priv, p256Msg, p256PubIters, p256SignIters)

    echo(strutil.Join(["sink=", IntToStr(sink)], ""))
    echo(" crypto_hot_kernel_perf_smoke ok")
    return 0
