import cheng/core/lang/parser as parser
import cheng/core/tooling/compiler_parser_receipt as parser_receipt
import cheng/core/tooling/compiler_csg as compiler_csg

fn PatternReceiptLifecycleSource(): str =
    return "var (left, {right, named: nested}) = seed\n"

fn PatternReceiptLifecycleBuild(): parser_receipt.ParserNormalizedExprReceipt =
    var identities: parser_receipt.ParserNormalizedExprFunctionIdentity[]
    var declarations: parser.NormalizedFunctionDecl[]
    var sidecar: parser_receipt.ParserCanonicalSourceSidecar
    var err: str
    assert(parser_receipt.ParserCanonicalSourceSidecarBuildFromSourceInto(
               0,
               PatternReceiptLifecycleSource(),
               false,
               identities,
               declarations,
               sidecar,
               err),
           Fmt"compiler csg parser pattern lifecycle: sidecar build {err}")
    assert(sidecar.patternProducerSourceIds.len > 0 &&
           sidecar.patternSourceLocalRows.len == sidecar.patternKinds.len &&
           sidecar.patternNameTokenIds.len == sidecar.patternKinds.len &&
           sidecar.patternOwnerLexicalScopeIds.len == sidecar.patternKinds.len &&
           sidecar.patternOwnerKinds.len == sidecar.patternKinds.len &&
           sidecar.patternOwnerRows.len == sidecar.patternKinds.len &&
           sidecar.patternBindingDeclarationIds.len == sidecar.patternKinds.len &&
           sidecar.patternSpanIds.len == sidecar.patternKinds.len &&
           sidecar.patternChildStarts.len == sidecar.patternKinds.len &&
           sidecar.patternChildCounts.len == sidecar.patternKinds.len &&
           sidecar.patternChildIds.len > 0 &&
           sidecar.declarationLexicalScopeKinds.len > 0 &&
           sidecar.declarationLexicalScopeSpanIds.len ==
               sidecar.declarationLexicalScopeKinds.len,
           "compiler csg parser pattern lifecycle: pattern columns missing")
    var receipt: parser_receipt.ParserNormalizedExprReceipt
    receipt.sourceCount = 1
    add(receipt.sourceSidecars, sidecar)
    return receipt

fn main() =
    for round in 0..<64:
        var owner = PatternReceiptLifecycleBuild()
        var clone = parser_receipt.ParserNormalizedExprReceiptClone(owner)
        let patternCount = clone.sourceSidecars[0].patternKinds.len
        let patternChildCount = clone.sourceSidecars[0].patternChildIds.len
        let lexicalScopeCount =
            clone.sourceSidecars[0].declarationLexicalScopeKinds.len
        let ownerRetainedBytes =
            compiler_csg.CompilerCsgParserReceiptDynamicSequenceBytes(
                owner, true)
        assert(ownerRetainedBytes > int64(0),
               "compiler csg parser pattern lifecycle: live bytes missing")
        compiler_csg.CompilerCsgParserNormalizedExprReceiptRelease(owner)
        assert(owner.sourceSidecars.len == 0 && owner.sourceCount == 0 &&
               compiler_csg.CompilerCsgParserReceiptDynamicSequenceBytes(
                   owner, true) == int64(0),
               "compiler csg parser pattern lifecycle: owner retained")
        var cloneErr: str
        assert(clone.sourceSidecars.len == 1 &&
               clone.sourceSidecars[0].patternProducerSourceIds.len ==
                   patternCount &&
               clone.sourceSidecars[0].patternSourceLocalRows.len ==
                   patternCount &&
               clone.sourceSidecars[0].patternKinds.len == patternCount &&
               clone.sourceSidecars[0].patternNameTokenIds.len == patternCount &&
               clone.sourceSidecars[0].patternOwnerLexicalScopeIds.len ==
                   patternCount &&
               clone.sourceSidecars[0].patternOwnerKinds.len ==
                   patternCount &&
               clone.sourceSidecars[0].patternOwnerRows.len ==
                   patternCount &&
               clone.sourceSidecars[0].patternBindingDeclarationIds.len ==
                   patternCount &&
               clone.sourceSidecars[0].patternSpanIds.len == patternCount &&
               clone.sourceSidecars[0].patternChildStarts.len == patternCount &&
               clone.sourceSidecars[0].patternChildCounts.len == patternCount &&
               clone.sourceSidecars[0].patternChildIds.len == patternChildCount &&
               clone.sourceSidecars[0].declarationLexicalScopeSpanIds.len ==
                   lexicalScopeCount &&
               parser_receipt.ParserCanonicalSourceSidecarStrictValidateInto(
                   clone.sourceSidecars[0],
                   cloneErr),
               "compiler csg parser pattern lifecycle: clone aliased release")
        compiler_csg.CompilerCsgParserNormalizedExprReceiptRelease(clone)
        assert(clone.sourceSidecars.len == 0 && clone.sourceCount == 0,
               "compiler csg parser pattern lifecycle: clone retained")
        compiler_csg.CompilerCsgParserNormalizedExprReceiptRelease(owner)
        compiler_csg.CompilerCsgParserNormalizedExprReceiptRelease(clone)
    echo("compiler_csg_parser_pattern_receipt_clone_release_repeat=1")
    echo("compiler_csg_parser_lexical_scope_span_lifecycle=1")
    echo("compiler_csg_parser_pattern_receipt_lifecycle_smoke: ok")

main()
