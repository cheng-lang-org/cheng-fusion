type
    ColdManagedExactGenericFixedArrayMissingOwner[U] =
        leaves: U[2]

    ColdManagedExactGenericFixedArrayMissing =
        owner: ColdManagedExactGenericFixedArrayMissingOwner[T]

fn main(): int32 =
    var value: ColdManagedExactGenericFixedArrayMissing
    return value.owner.leaves.len
