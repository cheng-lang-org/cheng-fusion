type
    Op =
        kind: int32
        operands: int32[]
        target: int32
    Block =
        opStart: int32
        opCount: int32
    Body =
        ops: Op[]
        locals: int32[]
        blocks: Block[]
        terms: int32[]
        calls: int32[]
        literals: int32[]

fn readCopied(items: Body[]): int32 =
    let body = items[0]
    if body.ops.len != 1:
        return -1
    if body.blocks.len != 1:
        return -2
    let op = body.ops[0]
    if op.operands.len != 2:
        return -3
    return op.operands[1]

fn main(): int32 =
    var op: Op
    op.kind = 1
    op.target = 1
    add(op.operands, 1)
    add(op.operands, 42)
    var block: Block
    block.opStart = 0
    block.opCount = 1
    var body: Body
    add(body.ops, op)
    add(body.locals, 1)
    add(body.blocks, block)
    add(body.terms, 1)
    add(body.calls, 1)
    add(body.literals, 1)
    var items: Body[]
    add(items, body)
    if readCopied(items) != 42:
        return 1
    return 0
