import cheng/core/tooling/memory_release_component_receipts as components

fn main(): int32 =
    let row = components.MemoryReleaseUnenteredLedgerRow(
        "source_admission_failure",
        "compiler_csg")
    if row.pathKind != "source_admission_failure" ||
       row.component != "compiler_csg" ||
       row.entered ||
       row.allocated != int64(0) ||
       row.physicalBufferCount != int64(0) ||
       row.storageReleased:
        return 1
    return 0
