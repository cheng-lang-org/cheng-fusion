import std/system

fn TkR16HitText(kind: int32): str =
    if kind == 1:
        return "TkR16One"
    panic("tk_r16 panic reached")

fn main(): int32 =
    let ok = TkR16HitText(1)
    if ok != "TkR16One":
        return 10
    let bad = TkR16HitText(7)
    echo(Fmt"tk_r16 FALLTHROUGH bad={bad}")
    return 0
