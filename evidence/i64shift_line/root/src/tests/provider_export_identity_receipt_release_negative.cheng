import std/cmdline
import cheng/std/bytes_layout as layout
import cheng/core/backend/provider_export_identity_receipt as peir

fn negativeCid(seed: int32): layout.FixedBytes32 =
    var out: layout.FixedBytes32
    for index in 0..<32:
        out.data[index] = uint8((seed + index * 19) & 255)
    return out

fn negativeBuildSealed(): peir.ProviderExportIdentityReceipt =
    var receipt = peir.ProviderExportIdentityReceiptInit(256)
    let providerRow = peir.ProviderExportIdentityReceiptAppendProvider(
        receipt, negativeCid(1), negativeCid(2), negativeCid(3))
    assert(providerRow == 0, " release negative: provider")
    assert(peir.ProviderExportIdentityReceiptAppendExport(
        receipt, providerRow, 1, 2, 3, 4,
        negativeCid(4), negativeCid(5),
        peir.ProviderExportContractRoleSetCmdLine,
        "__cheng_setCmdLine") == 0,
        " release negative: export")
    var err: str
    assert(peir.ProviderExportIdentityReceiptSealInto(receipt, err), err)
    return receipt

fn main() =
    assert(cmdline.ParamCount() == 2, " release negative: mode required")
    let mode = cmdline.ParamStr(1)
    if mode == "double-release":
        var receipt = peir.ProviderExportIdentityReceiptInit(256)
        peir.ProviderExportIdentityReceiptRelease(receipt)
        peir.ProviderExportIdentityReceiptRelease(receipt)
        return
    assert(mode == "moved-source", " release negative: unknown mode")
    var source = negativeBuildSealed()
    var out: peir.ProviderExportIdentityReceipt
    var err: str
    assert(peir.ProviderExportIdentityReceiptMoveInto(out, source, err), err)
    peir.ProviderExportIdentityReceiptRelease(source)
