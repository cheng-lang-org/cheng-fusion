import std/os as os
import std/strings
import cheng/core/csg_core/merkle_store

fn fail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

@borrows
fn cat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

@borrows
fn readHead(parentPath: str):
        merkle_store.CsgCoreMerkleHeadReadResult =
    return merkle_store.CsgCoreMerkleStoreReadHead(
        parentPath, "store")

@borrows
fn requireReadFailure(
        parentPath: str,
        expectedError: str): int32 =
    let read = readHead(parentPath)
    if read.ok ||
       !strings.StrContains(read.error, expectedError):
        return fail(
            cat(
                cat(
                    "current HEAD read did not reject with ",
                    expectedError),
                cat("; actual=", read.error)))
    os.WriteLine(
        os.Get_stdout(),
        cat("read_rejected=", read.error))
    return 0

@borrows
fn requireAuditFailure(
        parentPath: str,
        expectedError: str): int32 =
    let audit =
        merkle_store.CsgCoreMerkleStoreAuditHeadHistory(
            parentPath, "store")
    if audit.ok ||
       !strings.StrContains(audit.error, expectedError):
        return fail(
            cat(
                cat(
                    "HEAD history audit did not reject with ",
                    expectedError),
                cat("; actual=", audit.error)))
    os.WriteLine(
        os.Get_stdout(),
        cat("audit_rejected=", audit.error))
    return 0

@borrows
fn requireReadOk(parentPath: str): int32 =
    let read = readHead(parentPath)
    if !read.ok || !read.present ||
       read.head.generation != int64(0):
        return fail(
            cat("current HEAD read failed: ", read.error))
    os.WriteLine(
        os.Get_stdout(),
        cat("read_head=", read.head.headCid))
    return 0

@borrows
fn requireAuditOk(parentPath: str): int32 =
    let audit =
        merkle_store.CsgCoreMerkleStoreAuditHeadHistory(
            parentPath, "store")
    if !audit.ok || !audit.present ||
       audit.verificationScope != "full_successor_history" ||
       audit.generationRecordsRead != 1 ||
       audit.head.generation != int64(0):
        return fail(
            cat("HEAD history audit failed: ", audit.error))
    os.WriteLine(
        os.Get_stdout(),
        "audit_generations=1")
    return 0

fn main(): int32 =
    let parentPath =
        os.GetEnv("CSG_CURRENT_HEAD_TEST_PARENT")
    let mode =
        os.GetEnv("CSG_CURRENT_HEAD_TEST_MODE")
    if parentPath.len == 0:
        return fail("CSG_CURRENT_HEAD_TEST_PARENT missing")

    if mode == "read-ok":
        return requireReadOk(parentPath)
    if mode == "read-fail":
        let expected =
            os.GetEnv("CSG_CURRENT_HEAD_EXPECT_ERROR")
        if expected.len == 0:
            return fail("CSG_CURRENT_HEAD_EXPECT_ERROR missing")
        return requireReadFailure(parentPath, expected)
    if mode == "audit-ok":
        return requireAuditOk(parentPath)
    if mode == "audit-fail":
        let expected =
            os.GetEnv("CSG_CURRENT_HEAD_EXPECT_ERROR")
        if expected.len == 0:
            return fail("CSG_CURRENT_HEAD_EXPECT_ERROR missing")
        return requireAuditFailure(parentPath, expected)
    if mode == "manifest-cid":
        let read = readHead(parentPath)
        if !read.ok || !read.present:
            return fail(
                cat("manifest CID read failed: ", read.error))
        os.WriteLine(os.Get_stdout(), read.head.manifestCid)
        return 0
    return fail("CSG_CURRENT_HEAD_TEST_MODE invalid")
