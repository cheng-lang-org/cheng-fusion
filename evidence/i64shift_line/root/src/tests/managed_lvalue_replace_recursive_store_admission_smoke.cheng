import std/os
import cheng/core/analysis/managed_lvalue_replace as replace
import cheng/core/lang/typed_expr_type_arena as typearena

fn admissionAssert(condition: bool, message: str) =
    if !condition:
        panic(message)

fn appendTypeFact(
        structuralKinds: var int32[],
        scalarKinds: var int32[],
        childTypeIds: var int32[],
        fixedLengths: var int32[],
        sizeBytes: var int32[],
        alignBytes: var int32[],
        structuralKind: int32,
        scalarKind: int32,
        childTypeId: int32,
        fixedLength: int32,
        size: int32,
        align: int32) =
    add(structuralKinds, structuralKind)
    add(scalarKinds, scalarKind)
    add(childTypeIds, childTypeId)
    add(fixedLengths, fixedLength)
    add(sizeBytes, size)
    add(alignBytes, align)

fn runStrPositive() =
    var structuralKinds: int32[]
    var scalarKinds: int32[]
    var childTypeIds: int32[]
    var fixedLengths: int32[]
    var sizeBytes: int32[]
    var alignBytes: int32[]
    appendTypeFact(
        structuralKinds,
        scalarKinds,
        childTypeIds,
        fixedLengths,
        sizeBytes,
        alignBytes,
        Int32(typearena.TypedExprStructuralTypeScalar),
        Int32(typearena.TypedExprStructuralScalarStr),
        -1,
        0,
        24,
        8)
    admissionAssert(
        replace.ManagedLvalueReplaceProductionPreflightStoreTypeExact(
            0,
            structuralKinds,
            scalarKinds,
            childTypeIds,
            fixedLengths,
            sizeBytes,
            alignBytes) ==
            replace.ManagedLvalueReplaceStorePreflightStr,
        "managed replace admission smoke: str rejected")

fn runPlainSequencePositive() =
    var structuralKinds: int32[]
    var scalarKinds: int32[]
    var childTypeIds: int32[]
    var fixedLengths: int32[]
    var sizeBytes: int32[]
    var alignBytes: int32[]
    appendTypeFact(
        structuralKinds,
        scalarKinds,
        childTypeIds,
        fixedLengths,
        sizeBytes,
        alignBytes,
        Int32(typearena.TypedExprStructuralTypeScalar),
        Int32(typearena.TypedExprStructuralScalarInt32),
        -1,
        0,
        4,
        4)
    appendTypeFact(
        structuralKinds,
        scalarKinds,
        childTypeIds,
        fixedLengths,
        sizeBytes,
        alignBytes,
        Int32(typearena.TypedExprStructuralTypeSequence),
        Int32(typearena.TypedExprStructuralScalarInvalid),
        0,
        0,
        16,
        8)
    admissionAssert(
        replace.ManagedLvalueReplaceProductionPreflightStoreTypeExact(
            1,
            structuralKinds,
            scalarKinds,
            childTypeIds,
            fixedLengths,
            sizeBytes,
            alignBytes) ==
            replace.ManagedLvalueReplaceStorePreflightPlainSequence,
        "managed replace admission smoke: plain sequence rejected")

fn runManagedSequenceNegative() =
    var structuralKinds: int32[]
    var scalarKinds: int32[]
    var childTypeIds: int32[]
    var fixedLengths: int32[]
    var sizeBytes: int32[]
    var alignBytes: int32[]
    appendTypeFact(
        structuralKinds,
        scalarKinds,
        childTypeIds,
        fixedLengths,
        sizeBytes,
        alignBytes,
        Int32(typearena.TypedExprStructuralTypeScalar),
        Int32(typearena.TypedExprStructuralScalarStr),
        -1,
        0,
        24,
        8)
    appendTypeFact(
        structuralKinds,
        scalarKinds,
        childTypeIds,
        fixedLengths,
        sizeBytes,
        alignBytes,
        Int32(typearena.TypedExprStructuralTypeSequence),
        Int32(typearena.TypedExprStructuralScalarInvalid),
        0,
        0,
        16,
        8)
    let _ =
        replace.ManagedLvalueReplaceProductionPreflightStoreTypeExact(
            1,
            structuralKinds,
            scalarKinds,
            childTypeIds,
            fixedLengths,
            sizeBytes,
            alignBytes)

fn runAggregateNegative() =
    var structuralKinds: int32[]
    var scalarKinds: int32[]
    var childTypeIds: int32[]
    var fixedLengths: int32[]
    var sizeBytes: int32[]
    var alignBytes: int32[]
    appendTypeFact(
        structuralKinds,
        scalarKinds,
        childTypeIds,
        fixedLengths,
        sizeBytes,
        alignBytes,
        Int32(typearena.TypedExprStructuralTypeObject),
        Int32(typearena.TypedExprStructuralScalarInvalid),
        -1,
        0,
        24,
        8)
    let _ =
        replace.ManagedLvalueReplaceProductionPreflightStoreTypeExact(
            0,
            structuralKinds,
            scalarKinds,
            childTypeIds,
            fixedLengths,
            sizeBytes,
            alignBytes)

fn main(): int32 =
    let mutation = os.GetEnv(
        "CHENG_MANAGED_RECURSIVE_STORE_ADMISSION_MUTATION")
    if mutation == "managed-sequence":
        runManagedSequenceNegative()
        return 0
    if mutation == "aggregate":
        runAggregateNegative()
        return 0
    runStrPositive()
    runPlainSequencePositive()
    echo("managed_lvalue_replace_recursive_store_admission_smoke ok")
    return 0
