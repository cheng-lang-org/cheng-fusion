import std/seqs as seqs

fn main(): int32 =
    var numbers: int32[]
    add(numbers, 7)
    add(numbers, 11)
    if numbers.len != 2 || numbers[0] != 7 || numbers[1] != 11:
        return 1
    seqs.chengSeqFreeTyped[int32](numbers)
    if numbers.len != 0 || numbers.cap != 0 || numbers.buffer != nil:
        return 2

    var texts: str[]
    let alphaSlot = seqs.chengSeqStringSetGrow(
        texts, 0, seqs.chengSeqStringElemBytesCompat())
    if alphaSlot == nil || texts.len != 1 || texts.cap < 1 ||
       texts.buffer == nil:
        return 3
    seqs.chengSeqStoreStrCompat(alphaSlot, "alpha")
    if texts[0] != "alpha":
        return 4
    let betaSlot = seqs.chengSeqStringSetGrow(
        texts, 1, seqs.chengSeqStringElemBytesCompat())
    if betaSlot == nil || texts.len != 2 || texts.cap < 2:
        return 5
    seqs.chengSeqStoreStrCompat(betaSlot, "beta")
    if texts[0] != "alpha":
        return 6
    if texts[1] != "beta":
        return 7
    seqs.freeSeqStrRelease(texts)
    if texts.len != 0 || texts.cap != 0 || texts.buffer != nil:
        return 8

    var initialized: str[]
    seqs.chengSeqStringInitCompat(initialized, 2, 4)
    if initialized.len != 2 || initialized.cap != 4 ||
       initialized.buffer == nil:
        return 9
    seqs.freeSeqStrRelease(initialized)
    if initialized.len != 0 || initialized.cap != 0 ||
       initialized.buffer != nil:
        return 10

    var shared: str[]
    add(shared, "left")
    add(shared, "right")
    var alias: str[] = share(shared)
    if alias.len != 2 || alias[0] != "left" || alias[1] != "right":
        return 11
    seqs.freeSeqStrRelease(shared)
    if shared.len != 0 || shared.cap != 0 || shared.buffer != nil:
        return 12
    if alias.len != 2 || alias[0] != "left" || alias[1] != "right":
        return 13
    seqs.freeSeqStrRelease(alias)
    if alias.len != 0 || alias.cap != 0 || alias.buffer != nil:
        return 14
    return 0
