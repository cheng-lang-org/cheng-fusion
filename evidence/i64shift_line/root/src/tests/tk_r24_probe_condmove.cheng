fn R19Trim(raw: str): str =
    return raw

fn R19Slice(raw: str, start: int32, count: int32): str =
    return raw

fn R19Core(lineRaw: str, prefixLen: int32): int32 =
    let line = R19Trim(lineRaw)
    var tail: str
    if prefixLen > 0:
        tail = R19Slice(line, prefixLen, line.len - prefixLen)
    else:
        tail = line
    let left = R19Trim(tail)
    return left.len

fn main(): int32 =
    let n = R19Core("abcdef", 0)
    if n != 6:
        return 10
    echo("r19 ok")
    return 0
