import cheng/core/lang/parser

fn main(): int32 =
    let source =
        "type Kind = enum\n    Alpha\n    Beta\n"
    var tree: parser.ParserValueExprTree
    var err: str
    assert(parser.ParserValueExprReadTreeFromText(source, tree, err),
           Fmt"parser enum liveness: parse failed {err}")
    assert(parser.ParserValueExprTreeEnumVariantsStrictValidateInto(
               tree, err),
           Fmt"parser enum liveness: first validation failed {err}")
    assert(parser.ParserValueExprTreeEnumVariantsStrictValidateInto(
               tree, err),
           Fmt"parser enum liveness: repeated validation failed {err}")
    parser.ParserValueExprTreeRelease(tree)
    assert(tree == nil,
           "parser enum liveness: tree owner was not released")
    echo("parser_enum_variant_liveness_smoke: ok")
    return 0
