import std/rawbytes
import std/strformat
import std/system
import cheng/core/csg_core/compiler_snapshot_schema as schema
import cheng/core/tooling/compiler_snapshot_lowering_bridge as bridge
import cheng/std/bytes_layout as layout

fn SnapshotReleaseAddTextInto(
        values: var str[],
        value: str) =
    add(values, value)

fn SnapshotReleaseFixtureInto(
        seed: int32,
        tables: var schema.CsgCompilerSnapshotTables) =
    tables.schemaVersion =
        schema.CsgCompilerSnapshotSchemaVersionLatest
    tables.semanticEpoch = int64(seed)
    tables.predecessorReceiptCid.data[0] = uint8(seed & 255)
    SnapshotReleaseAddTextInto(
        tables.texts,
        Fmt"snapshot-release-text-{seed}")
    add(tables.sources.documentCids, layout.FixedBytes32())
    add(tables.sources.modulePathTextIds, seed)
    add(tables.parserSidecars.declarationMutableFlags, true)
    add(tables.types.typeCids, layout.FixedBytes32())
    add(tables.symbols.exportedFlags, false)
    add(tables.diagnostics.proofCids, layout.FixedBytes32())
    add(tables.declarations.declIds, seed)
    SnapshotReleaseAddTextInto(
        tables.declarations.portableDocumentPackageIds,
        Fmt"pkg://snapshot-release/{seed}")
    SnapshotReleaseAddTextInto(
        tables.declarations.portableDocumentModulePaths,
        Fmt"snapshot/release/{seed}")
    SnapshotReleaseAddTextInto(
        tables.declarations.canonicalNames,
        Fmt"SnapshotRelease{seed}")
    tables.declarations.canonicalBytes = rawbytes.BytesAlloc(17)
    tables.declarations.tableCid.data[0] = uint8((seed + 1) & 255)

fn SnapshotReleaseMutationNet(): bool =
    var tables: schema.CsgCompilerSnapshotTables
    SnapshotReleaseFixtureInto(23, tables)
    var state: bridge.CompilerSnapshotForLoweringReleaseState
    var receipt: bridge.CompilerSnapshotForLoweringReleaseReceipt
    bridge.CompilerSnapshotForLoweringReleaseWithReceipt(
        tables, state, receipt)
    let releasedBytes = receipt.releasedBytes
    receipt.releasedBytes = releasedBytes + int64(1)
    var err: str
    if bridge.CompilerSnapshotForLoweringReleaseReceiptConsumeStrictInto(
           tables, state, receipt, err):
        return false
    receipt.releasedBytes = releasedBytes
    if !bridge.CompilerSnapshotForLoweringReleaseReceiptConsumeStrictInto(
           tables, state, receipt, err):
        return false
    return !bridge.CompilerSnapshotForLoweringReleaseReceiptConsumeStrictInto(
        tables, state, receipt, err)

fn main() =
    assert(SnapshotReleaseMutationNet(),
           "snapshot lowering release: warm mutation net failed")
    let allocBefore = system.memAllocCount()
    let freeBefore = system.memFreeCount()
    let liveBefore = system.memLiveCount()
    var releasedBuffers: int64
    var releasedBytes: int64
    for iteration in 0..<128:
        var tables: schema.CsgCompilerSnapshotTables
        SnapshotReleaseFixtureInto(iteration + 1, tables)
        assert(
            !bridge.CompilerSnapshotForLoweringStorageReleased(tables),
            "snapshot lowering release: live storage accepted as empty")
        var state: bridge.CompilerSnapshotForLoweringReleaseState
        var receipt: bridge.CompilerSnapshotForLoweringReleaseReceipt
        bridge.CompilerSnapshotForLoweringReleaseWithReceipt(
            tables, state, receipt)
        assert(
            receipt.schemaVersion ==
                schema.CsgCompilerSnapshotSchemaVersionLatest,
            "snapshot lowering release: schema mismatch")
        assert(
            receipt.semanticEpoch == int64(iteration + 1),
            "snapshot lowering release: epoch mismatch")
        assert(
            receipt.releasedSequenceFieldCount ==
                bridge.CompilerSnapshotForLoweringCurrentSchemaSequenceFieldCount,
            "snapshot lowering release: schema field count mismatch")
        assert(
            receipt.releasedBufferCount > 0,
            "snapshot lowering release: no released buffers")
        assert(
            receipt.releasedBytes > int64(0),
            "snapshot lowering release: no released bytes")
        assert(
            receipt.storageReleased,
            "snapshot lowering release: receipt not terminal")
        assert(
            bridge.CompilerSnapshotForLoweringStorageReleased(tables),
            "snapshot lowering release: storage remains live")
        var err: str
        assert(
            bridge.CompilerSnapshotForLoweringReleaseReceiptConsumeStrictInto(
                tables, state, receipt, err),
            err)
        releasedBuffers =
            releasedBuffers + int64(receipt.releasedBufferCount)
        releasedBytes = releasedBytes + receipt.releasedBytes
    assert(releasedBuffers > int64(0),
           "snapshot lowering release: empty buffer aggregate")
    assert(releasedBytes > int64(0),
           "snapshot lowering release: empty byte aggregate")
    assert(SnapshotReleaseMutationNet(),
           "snapshot lowering release: mutation accepted")
    let allocDelta = system.memAllocCount() - allocBefore
    let freeDelta = system.memFreeCount() - freeBefore
    let liveDelta = system.memLiveCount() - liveBefore
    echo(Fmt"compiler_snapshot_lowering_release_alloc_delta={allocDelta}")
    echo(Fmt"compiler_snapshot_lowering_release_free_delta={freeDelta}")
    echo(Fmt"compiler_snapshot_lowering_release_live_delta={liveDelta}")
    assert(allocDelta > int64(0),
           "snapshot lowering release: no tracked allocation")
    assert(allocDelta == freeDelta,
           "snapshot lowering release: ORC alloc/free imbalance")
    assert(liveDelta == int64(0),
           "snapshot lowering release: ORC live allocation leak")
    echo("compiler_snapshot_lowering_release_iterations=128")
    echo(Fmt"compiler_snapshot_lowering_release_sequence_fields={bridge.CompilerSnapshotForLoweringCurrentSchemaSequenceFieldCount}")
    echo("compiler_snapshot_lowering_release_alloc_eq_release=1")
    echo("compiler_snapshot_lowering_release_live=0")
    echo("compiler_snapshot_lowering_release_mutations_rejected=1")
