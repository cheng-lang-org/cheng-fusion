import cheng/core/lang/parser as parser
import cheng/core/lang/typed_expr as texpr
import cheng/core/lang/typed_expr_type_arena as typearena
import cheng/core/runtime/arena as arenamod

fn FixtureText(): str =
    return "fn helper_add(a: int32, b: int32): int32 =\n    return a + b\n\nfn utf8_export_symbol(value: int32): int32 =\n    return value + 1\n\nfn main(): int32 =\n    return utf8_export_symbol(helper_add(40, 2))\n"

fn main(): int32 =
    var externalRoots: parser.ParserExternalPackageRoot[]
    let source = texpr.TypedExprSourceTextNewWithPackageFacts(
        "/work",
        "/work",
        "pkg://typed-expr-nested-return-owner",
        "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
        externalRoots,
        "/work/typed_expr_nested_return_single_owner.cheng",
        FixtureText())
    var sources = [source]
    var contexts: texpr.TypedExprSourceContext[]
    var context: texpr.TypedExprSourceContext
    var err: str
    assert(texpr.TypedExprBuildSourceContext(source, context, err),
           Fmt"nested return owner: source context failed {err}")
    texpr.TypedExprSourceContextAppendMove(contexts, context)

    var layer: parser.NormalizedExprLayer
    assert(texpr.TypedExprReadNormalizedExprLayerForSourceTexts(
               sources, layer, err),
           Fmt"nested return owner: normalized layer failed {err}")
    let authority = typearena.TypedExprTypeResolutionAuthorityEmpty()
    var exactArena: typearena.TypedExprTypeArena
    assert(typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               layer.valueExprTree, authority, exactArena, err),
           Fmt"nested return owner: TypeArena failed {err}")

    var returnExprIndex: int32 = -1
    var outerOrigin: int32 = -1
    var innerOrigin: int32 = -1
    for exprIndex in 0..<layer.exprs.len:
        let expr = layer.exprs[exprIndex]
        if expr.kind == parser.NormalizedExprReturn &&
           expr.lineNumber == 8:
            returnExprIndex = exprIndex
        elif expr.kind == parser.NormalizedExprCall &&
             expr.callCallee == "utf8_export_symbol":
            outerOrigin = expr.originParserNodeId
        elif expr.kind == parser.NormalizedExprCall &&
             expr.callCallee == "helper_add":
            innerOrigin = expr.originParserNodeId
    assert(returnExprIndex >= 0 && outerOrigin >= 0 && innerOrigin >= 0 &&
           outerOrigin != innerOrigin,
           "nested return owner: parser identities missing")

    var ir: texpr.TypedExprIr
    assert(texpr.TypedExprIrBindExactTypeArena(ir, exactArena, err),
           Fmt"nested return owner: TypeArena bind failed {err}")
    texpr.TypedExprIrBeginValueExprBorrow(ir, layer)
    var emptyFacts: texpr.TypedExprFactTable
    texpr.TypedExprIrPrepareValueExprCallMetadata(ir, emptyFacts)
    texpr.TypedExprBuildSourceContextIndex(ir, contexts)
    var scope: texpr.TypedExprFunctionScope
    var scopeFound = false
    for scopeIndex in 0..<contexts[0].scopes.len:
        if contexts[0].scopes[scopeIndex].name == "main":
            scope = contexts[0].scopes[scopeIndex]
            scopeFound = true
    assert(scopeFound, "nested return owner: main scope missing")
    var ctx = texpr.TypedExprSourceContextBorrowedView(contexts[0])
    for exprIndex in 0..<layer.exprs.len:
        let expr = layer.exprs[exprIndex]
        if expr.kind != parser.NormalizedExprCall:
            continue
        let resultType =
            texpr.TypedExprLookupCallTargetReturnTypeFromExpr(
                ctx, contexts, expr)
        assert(resultType == "int32" &&
               expr.valueExprCallNodeIndex >= 0 &&
               expr.valueExprCallNodeIndex <
                   ir.valueExprCallMetaResultTypeIds.len &&
               expr.originParserNodeId >= 0,
               "nested return owner: call result type lookup drift")
        ir.valueExprCallMetaResultTypeIds[expr.valueExprCallNodeIndex] =
            texpr.TypedExprIrInternText(ir, resultType)
        ir.valueExprCallMetaOriginParserNodeIds[
            expr.valueExprCallNodeIndex] = expr.originParserNodeId
    let statementIndex = texpr.TypedExprIrAddCallStatementFromExpr(
        ir,
        ctx,
        contexts,
        scope,
        layer.exprs[returnExprIndex],
        texpr.TypedExprIrStmtReturn,
        "",
        "int32",
        4,
        -1,
        "",
        true)
    assert(statementIndex == 0,
           "nested return owner: return statement missing")

    var outerRows: int32
    var innerRows: int32
    for nodeIndex in 0..<ir.nodes2_nodeIndexs.len:
        if ir.nodes2_opKinds[nodeIndex] != texpr.TypedExprIrOpCallExpr:
            continue
        let origin = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.nodes2_originParserNodeIds, nodeIndex)
        if origin == outerOrigin:
            outerRows = outerRows + 1
        elif origin == innerOrigin:
            innerRows = innerRows + 1
    let stmt = texpr.TypedExprIrStatementAt(ir, statementIndex)
    assert(stmt.rhsNodeIndex >= 0 &&
           ir.nodes2_opKinds[stmt.rhsNodeIndex] ==
               texpr.TypedExprIrOpCallExpr &&
           stmt.callArgCount == 1 &&
           stmt.callArgNodeCount == 1 &&
           stmt.callArgNodeStart == arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.nodes2_operand0NodeIndexs,
               stmt.rhsNodeIndex),
           "nested return owner: statement arg projection drift")
    let contractOk = outerRows == 1 && innerRows == 1
    echo(Fmt"typed_expr_nested_return_owner outer={outerRows} inner={innerRows} arg_count={stmt.callArgNodeCount}")

    texpr.TypedExprIrEndValueExprBorrow(ir)
    texpr.TypedExprIrReleasePayload(ir)
    typearena.TypedExprTypeArenaRelease(exactArena)
    parser.NormalizedExprLayerReset(layer)
    for contextIndex in 0..<contexts.len:
        texpr.TypedExprClearSourceContextAllFields(contexts[contextIndex])
    if !contractOk:
        return 1
    return 0
