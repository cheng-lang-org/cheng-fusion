import std/os
import std/system
import std/hashmaps as hashmaps
import cheng/core/ir/core_types as coreir
import cheng/core/ir/body_ir_lifecycle as birlife

fn lifecycleSmokeBody(seed: int32): coreir.BodyIR =
    var body = coreir.BodyIRNew()

    var slot: coreir.LocalSlot
    slot.id = 0
    slot.name = "owned_value"
    slot.typeKind = coreir.LocalI32Tag
    slot.typeArenaTypeId = 0
    slot.managedStorageKind = coreir.BodyManagedStorageUnmanagedTag
    slot.placeKind = coreir.BodyPlaceStackValueTag
    slot.stackOffset = 0
    slot.sizeBytes = 4
    slot.alignBytes = 4
    slot.ownership = coreir.OwnPlain
    slot.aliasClass = coreir.AliasNoAlias
    slot.escapeKind = coreir.EscapeNone
    add(body.localSlots, slot)
    hashmaps.HashMapStrIntPut(body.slotNameIndex, "owned_value", 0)

    var op: coreir.BodyOp
    op.kind = coreir.BodyOpLoadConstTag
    op.target = 0
    add(op.operands, seed)
    add(body.ops, op)

    var call: coreir.CallOp
    call.targetSymbol = "lifecycle_emit_target"
    call.targetSourcePath = "src/tests/body_ir_function_lifecycle_smoke.cheng"
    call.resultSlot = -1
    add(call.argSlots, 0)
    add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(call.argAbiSizes, 4)
    add(body.callSequence, call)

    var term: coreir.BodyTerm
    term.kind = coreir.BodyTermReturnTag
    term.resultSlot = 0
    add(term.operands, 0)
    add(body.terms, term)

    var block: coreir.BodyBlock
    block.id = 0
    block.opStart = 0
    block.opCount = 1
    block.termIndex = 0
    add(body.blocks, block)

    var literal: coreir.CStringLiteralEntry
    literal.id = 0
    literal.text = "lifecycle"
    literal.dataLabel = "__lifecycle"
    add(body.cstringLiterals, literal)

    add(body.debugOpIdsByOpIndex, seed)
    add(body.debugSyntheticKindsByOpIndex, 0)
    add(body.debugOpIdsByTermIndex, seed + 1)
    add(body.debugSyntheticKindsByTermIndex, 0)
    add(body.layoutLhsElide, false)
    add(body.layoutStoreElide, false)
    add(body.layoutCopySrcElide, false)
    add(body.layoutCmpFuse, -1)
    add(body.layoutCbrFuse, -1)
    add(body.x64SlotReadCnt, 1)
    add(body.x64BlockByteStart, 0)
    return body

fn lifecycleReceiptValid(
        receipt: birlife.BodyIrFunctionLifecycleReceipt,
        expectedFunctionIrIndex: int32,
        expectedFunctionIdentityKind: int32,
        expectedFunctionIdentityIndex: int32,
        expectedOutcome: int32,
        expectedTransferCount: int64,
        expectedBorrowCount: int64): bool =
    return receipt.functionIrIndex == expectedFunctionIrIndex &&
           receipt.functionIdentityKind ==
               expectedFunctionIdentityKind &&
           receipt.functionIdentityIndex ==
               expectedFunctionIdentityIndex &&
           receipt.outcome == expectedOutcome &&
           receipt.allocated == int64(1) &&
           receipt.released == int64(1) &&
           receipt.live == int64(0) &&
           receipt.allocatedBytes > int64(0) &&
           receipt.allocatedBytes == receipt.releasedBytes &&
           receipt.liveBytes == int64(0) &&
           receipt.retained == expectedBorrowCount &&
           receipt.borrowReturnCount == expectedBorrowCount &&
           receipt.ownerTransferCount == expectedTransferCount &&
           receipt.retainedBytes == receipt.allocatedBytes &&
           receipt.physicalBufferCount > 0 &&
           receipt.bodyPhysicalFreeCount ==
               int64(receipt.physicalBufferCount) &&
           receipt.ledgerStorageReleased &&
           receipt.ledgerStorageReleasedBufferCount > 0 &&
           receipt.ledgerStorageReleasedBytes > int64(0) &&
           receipt.phaseArenaStorageReleased &&
           receipt.phaseArenaReleasedBufferCount > 0 &&
           receipt.phaseArenaReleasedBytes > int64(0) &&
           receipt.payloadReleased

fn lifecycleRunOnce(functionIrIndex: int32, outcome: int32): bool =
    var body = lifecycleSmokeBody(functionIrIndex)
    var state: birlife.BodyIrFunctionLifecycle
    var receipt: birlife.BodyIrFunctionLifecycleReceipt
    birlife.BodyIrFunctionLifecycleBegin(
        state, body, functionIrIndex)
    var expectedTransferCount: int64
    var expectedBorrowCount: int64
    if outcome == birlife.BodyIrFunctionOutcomeEmitSuccess ||
       outcome == birlife.BodyIrFunctionOutcomeEmitFailure:
        birlife.BodyIrFunctionLifecycleMoveToEmitter(state)
        birlife.BodyIrFunctionLifecycleBorrowForPrimaryPreRegalloc(
            state)
        birlife.BodyIrFunctionLifecycleReturnPrimaryPreRegallocBorrow(
            state)
        birlife.BodyIrFunctionLifecycleBorrowForRegalloc(state)
        birlife.BodyIrFunctionLifecycleReturnRegallocBorrow(state)
        birlife.BodyIrFunctionLifecycleBorrowForPrimaryPostRegalloc(
            state)
        birlife.BodyIrFunctionLifecycleReturnPrimaryPostRegallocBorrow(
            state)
        expectedTransferCount = int64(1)
        expectedBorrowCount = int64(3)
    elif outcome == birlife.BodyIrFunctionOutcomeFragmentFrozen ||
         outcome == birlife.BodyIrFunctionOutcomeCacheReuse:
        birlife.BodyIrFunctionLifecycleMoveToFrozenFragment(state)
        expectedTransferCount = int64(1)
    birlife.BodyIrFunctionLifecycleRelease(
        state, body, outcome, receipt)
    return birlife.BodyIrPayloadIsReleased(body) &&
           lifecycleReceiptValid(receipt,
                                 functionIrIndex,
                                 birlife.BodyIrFunctionIdentitySource,
                                 functionIrIndex,
                                 outcome,
                                 expectedTransferCount,
                                 expectedBorrowCount)

fn lifecycleRunSyntheticEntryBridge(seed: int32): bool =
    var body = lifecycleSmokeBody(seed)
    var state: birlife.BodyIrFunctionLifecycle
    var receipt: birlife.BodyIrFunctionLifecycleReceipt
    birlife.BodyIrFunctionLifecycleBeginSyntheticEntryBridge(
        state, body)
    birlife.BodyIrFunctionLifecycleMoveToEmitter(state)
    birlife.BodyIrFunctionLifecycleBorrowForPrimaryPreRegalloc(state)
    birlife.BodyIrFunctionLifecycleReturnPrimaryPreRegallocBorrow(state)
    birlife.BodyIrFunctionLifecycleBorrowForRegalloc(state)
    birlife.BodyIrFunctionLifecycleReturnRegallocBorrow(state)
    birlife.BodyIrFunctionLifecycleBorrowForPrimaryPostRegalloc(state)
    birlife.BodyIrFunctionLifecycleReturnPrimaryPostRegallocBorrow(state)
    birlife.BodyIrFunctionLifecycleRelease(
        state,
        body,
        birlife.BodyIrFunctionOutcomeEmitSuccess,
        receipt)
    return birlife.BodyIrPayloadIsReleased(body) &&
           lifecycleReceiptValid(
               receipt,
               -1,
               birlife.BodyIrFunctionIdentitySyntheticEntryBridge,
               birlife.BodyIrSyntheticEntryBridgeIndex,
               birlife.BodyIrFunctionOutcomeEmitSuccess,
               int64(1),
               int64(3))

fn lifecyclePayloadLocalReleaseReceipt(): bool =
    var body = lifecycleSmokeBody(8800)
    let first = birlife.BodyIrPayloadRelease(body)
    let second = birlife.BodyIrPayloadRelease(body)
    return first.releasedBytes > int64(0) &&
           first.releasedBufferCount > 0 &&
           first.releasedManagedStringValueCount > 0 &&
           first.releasedManagedStringBytes > int64(0) &&
           first.storageReleased &&
           second.releasedBytes == int64(0) &&
           second.releasedBufferCount == 0 &&
           second.releasedManagedStringValueCount == 0 &&
           second.releasedManagedStringBytes == int64(0) &&
           second.storageReleased &&
           birlife.BodyIrPayloadIsReleased(body)

fn lifecycleRunNegative(mode: str): int32 =
    var body = lifecycleSmokeBody(7000)
    var state: birlife.BodyIrFunctionLifecycle
    var receipt: birlife.BodyIrFunctionLifecycleReceipt
    if mode == "empty_payload":
        var emptyBody = coreir.BodyIRNew()
        birlife.BodyIrFunctionLifecycleBegin(state, emptyBody, 1)
    elif mode == "invalid_function_identity":
        birlife.BodyIrFunctionLifecycleBegin(state, body, -1)
    elif mode == "duplicate_begin":
        birlife.BodyIrFunctionLifecycleBegin(state, body, 1)
        birlife.BodyIrFunctionLifecycleBegin(state, body, 1)
    elif mode == "duplicate_move":
        birlife.BodyIrFunctionLifecycleBegin(state, body, 1)
        birlife.BodyIrFunctionLifecycleMoveToEmitter(state)
        birlife.BodyIrFunctionLifecycleMoveToEmitter(state)
    elif mode == "phase_outcome_mismatch":
        birlife.BodyIrFunctionLifecycleBegin(state, body, 1)
        birlife.BodyIrFunctionLifecycleRelease(
            state,
            body,
            birlife.BodyIrFunctionOutcomeEmitSuccess,
            receipt)
    elif mode == "duplicate_regalloc_borrow":
        birlife.BodyIrFunctionLifecycleBegin(state, body, 1)
        birlife.BodyIrFunctionLifecycleMoveToEmitter(state)
        birlife.BodyIrFunctionLifecycleBorrowForRegalloc(state)
        birlife.BodyIrFunctionLifecycleBorrowForRegalloc(state)
    elif mode == "duplicate_regalloc_borrow_return":
        birlife.BodyIrFunctionLifecycleBegin(state, body, 1)
        birlife.BodyIrFunctionLifecycleMoveToEmitter(state)
        birlife.BodyIrFunctionLifecycleBorrowForRegalloc(state)
        birlife.BodyIrFunctionLifecycleReturnRegallocBorrow(state)
        birlife.BodyIrFunctionLifecycleReturnRegallocBorrow(state)
    elif mode == "release_while_regalloc_borrowed":
        birlife.BodyIrFunctionLifecycleBegin(state, body, 1)
        birlife.BodyIrFunctionLifecycleMoveToEmitter(state)
        birlife.BodyIrFunctionLifecycleBorrowForRegalloc(state)
        birlife.BodyIrFunctionLifecycleRelease(
            state,
            body,
            birlife.BodyIrFunctionOutcomeEmitSuccess,
            receipt)
    elif mode == "duplicate_pre_regalloc_borrow":
        birlife.BodyIrFunctionLifecycleBegin(state, body, 1)
        birlife.BodyIrFunctionLifecycleMoveToEmitter(state)
        birlife.BodyIrFunctionLifecycleBorrowForPrimaryPreRegalloc(
            state)
        birlife.BodyIrFunctionLifecycleBorrowForPrimaryPreRegalloc(
            state)
    elif mode == "duplicate_pre_regalloc_borrow_return":
        birlife.BodyIrFunctionLifecycleBegin(state, body, 1)
        birlife.BodyIrFunctionLifecycleMoveToEmitter(state)
        birlife.BodyIrFunctionLifecycleBorrowForPrimaryPreRegalloc(
            state)
        birlife.BodyIrFunctionLifecycleReturnPrimaryPreRegallocBorrow(
            state)
        birlife.BodyIrFunctionLifecycleReturnPrimaryPreRegallocBorrow(
            state)
    elif mode == "release_while_pre_regalloc_borrowed":
        birlife.BodyIrFunctionLifecycleBegin(state, body, 1)
        birlife.BodyIrFunctionLifecycleMoveToEmitter(state)
        birlife.BodyIrFunctionLifecycleBorrowForPrimaryPreRegalloc(
            state)
        birlife.BodyIrFunctionLifecycleRelease(
            state,
            body,
            birlife.BodyIrFunctionOutcomeEmitSuccess,
            receipt)
    elif mode == "duplicate_post_regalloc_borrow":
        birlife.BodyIrFunctionLifecycleBegin(state, body, 1)
        birlife.BodyIrFunctionLifecycleMoveToEmitter(state)
        birlife.BodyIrFunctionLifecycleBorrowForPrimaryPostRegalloc(
            state)
        birlife.BodyIrFunctionLifecycleBorrowForPrimaryPostRegalloc(
            state)
    elif mode == "duplicate_post_regalloc_borrow_return":
        birlife.BodyIrFunctionLifecycleBegin(state, body, 1)
        birlife.BodyIrFunctionLifecycleMoveToEmitter(state)
        birlife.BodyIrFunctionLifecycleBorrowForPrimaryPostRegalloc(
            state)
        birlife.BodyIrFunctionLifecycleReturnPrimaryPostRegallocBorrow(
            state)
        birlife.BodyIrFunctionLifecycleReturnPrimaryPostRegallocBorrow(
            state)
    elif mode == "release_while_post_regalloc_borrowed":
        birlife.BodyIrFunctionLifecycleBegin(state, body, 1)
        birlife.BodyIrFunctionLifecycleMoveToEmitter(state)
        birlife.BodyIrFunctionLifecycleBorrowForPrimaryPostRegalloc(
            state)
        birlife.BodyIrFunctionLifecycleRelease(
            state,
            body,
            birlife.BodyIrFunctionOutcomeEmitSuccess,
            receipt)
    elif mode == "payload_changed_after_begin":
        birlife.BodyIrFunctionLifecycleBegin(state, body, 1)
        for value in 0..<1000:
            add(body.ops[0].operands, value)
        birlife.BodyIrFunctionLifecycleRelease(
            state,
            body,
            birlife.BodyIrFunctionOutcomeDiagnostic,
            receipt)
    elif mode == "duplicate_release":
        birlife.BodyIrFunctionLifecycleBegin(state, body, 1)
        birlife.BodyIrFunctionLifecycleRelease(
            state,
            body,
            birlife.BodyIrFunctionOutcomeDiagnostic,
            receipt)
        birlife.BodyIrFunctionLifecycleRelease(
            state,
            body,
            birlife.BodyIrFunctionOutcomeDiagnostic,
            receipt)
    else:
        return 91
    return 92

fn main(): int32 =
    let negativeMode = os.GetEnv("CHENG_BODY_IR_LIFECYCLE_NEGATIVE")
    if negativeMode != "":
        return lifecycleRunNegative(negativeMode)

    if !lifecycleRunOnce(
            1, birlife.BodyIrFunctionOutcomeEmitSuccess):
        return 1
    if !lifecycleRunOnce(
            2, birlife.BodyIrFunctionOutcomeDiagnostic):
        return 2
    if !lifecycleRunOnce(
            3, birlife.BodyIrFunctionOutcomeEmitFailure):
        return 3
    if !lifecycleRunOnce(
            4, birlife.BodyIrFunctionOutcomeEarlyReturn):
        return 4
    if !lifecycleRunOnce(
            5, birlife.BodyIrFunctionOutcomeCacheReuse):
        return 5
    if !lifecycleRunOnce(
            6, birlife.BodyIrFunctionOutcomeFragmentFrozen):
        return 6
    if !lifecycleRunSyntheticEntryBridge(7):
        return 7
    if !lifecyclePayloadLocalReleaseReceipt():
        return 8

    let allocBefore = system.memAllocCount()
    let freeBefore = system.memFreeCount()
    let liveBefore = system.memLiveCount()
    for iteration in 0..<5000:
        if iteration % 2 == 0:
            if !lifecycleRunOnce(
                    iteration + 100,
                    birlife.BodyIrFunctionOutcomeEmitSuccess):
                return 10
        else:
            if !lifecycleRunSyntheticEntryBridge(iteration + 100):
                return 10
    let allocDelta = system.memAllocCount() - allocBefore
    let freeDelta = system.memFreeCount() - freeBefore
    let liveAfter = system.memLiveCount()
    if allocDelta <= int64(0) ||
       allocDelta != freeDelta ||
       liveAfter != liveBefore:
        os.WriteLine(
            os.GetStderr(),
            Fmt"body_ir_function_lifecycle allocation_mismatch alloc_delta={allocDelta} free_delta={freeDelta} live_before={liveBefore} live_after={liveAfter}")
        return 11
    os.WriteLine(
        os.Get_stdout(),
        "body_ir_function_lifecycle ok paths=7 cycles=5000 ledger_live=0 alloc_free_balanced=1 phase_arena_released=1 payload_local_receipt=1")
    return 0
