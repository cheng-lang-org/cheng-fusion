# ML-DSA (FIPS 204) full signature smoke test, three levels:
#   1. Self-consistency: KeyGen_internal -> Sign (fixed injected rnd) ->
#      Verify true for 5 fixed seed groups (ML-DSA-65, varying message and
#      context lengths); tampering the signature / message / public key at
#      4 byte positions each (commitment / z / hint regions, rho / t1) must
#      yield Verify false without crashing. One round each for ML-DSA-44
#      and ML-DSA-87.
#   2. Encoding sizes: pk/sk/sig lengths match the FIPS 204 table for all
#      three parameter sets (44: 1312/2560/2420, 65: 1952/4032/3309,
#      87: 2592/4896/4627).
#   3. Official KAT: NIST ACVP vectors (github.com/usnistgov/ACVP-Server,
#      gen-val/json-files/ML-DSA-*-FIPS204/internalProjection.json,
#      vsId 42), all ML-DSA-65:
#      a) keyGen tgId=2 tcId=26/27: seed -> pk/sk;
#      b) sigGen tgId=10 (internal interface, deterministic, externalMu
#         false) tcId=139/137: Sign_internal(sk, message, rnd = 32 zero
#         bytes) -> signature;
#      c) sigGen tgId=3 (external interface, pure, deterministic) tcId=31:
#         public API with context prefix and zero rnd -> signature, plus
#         Verify roundtrip against the vector pk;
#      d) sigVer tgId=10 (internal interface) tcId=141 valid -> true and
#         tcId=140/145/149/136 (modified message / signature z / hint /
#         commitment) -> false.

import std/system
import std/strings
import std/result
import std/rawbytes
import std/crypto/sha3
import std/crypto/mldsa as mldsa

const
    kg0Seed = "1bd67dc782b2958e189e315c040dd1f64c8ab232a6a170e1a7a52c33f10851b1"
    kg0Pk = ""
    kg0Sk = ""
    kg1Seed = "b850d898a3d3d11c4e64ade5a86ffed951b237c60d2a67a2def0a792b8f6990d"
    kg1Pk = ""
    kg1Sk = ""
    sgi0Sk = ""
    sgi0Msg = "71"
    sgi0Sig = ""
    sgi1Sk = ""
    sgi1Msg = ""
    sgi1Sig = ""
    sge0Sk = ""
    sge0Pk = ""
    sge0Ctx = "0a8b9249c5794768ef495af6483c80047295783a33dbb8b1"
    sge0Msg = "a54cb4bf79ddce7d7c446f972a849dc3c75917e7ed52777590d49ba28a8171b107650cc74348c2fd5aa5327fed13bbdf514eccd477f4d5b213f8083cdb2923afc35dabe663ee12932e8fdcc3058b6d991176cbad"
    sge0Sig = ""
    svOkPk = ""
    svOkMsg = ""
    svOkSig = ""
    svMsgPk = ""
    svMsgMsg = "67"
    svMsgSig = ""
    svZPk = ""
    svZMsg = ""
    svZSig = ""
    svHintPk = ""
    svHintMsg = ""
    svHintSig = ""
    svComPk = ""
    svComMsg = ""
    svComSig = ""

fn hexVal(c: int32): int32 =
    if c >= 48 && c <= 57:
        return c - 48
    if c >= 97 && c <= 102:
        return c - 87
    if c >= 65 && c <= 70:
        return c - 55
    Assert(false, "hexToBytes: invalid hex character")
    return 0

fn hexToBytes(s: str): Bytes =
    let raw: Bytes = BytesFromString(s)
    let n: int32 = BytesLen(raw)
    Assert(n % 2 == 0, "hexToBytes: odd length")
    let out: Bytes = BytesAlloc(n / 2)
    for i in 0..<(n / 2):
        BytesSet(out, i, hexVal(BytesGet(raw, 2 * i)) * 16 + hexVal(BytesGet(raw, 2 * i + 1)))
    return out

# Deterministic test seeds: SHAKE256(group || label, 32).
fn deriveSeed(group: int32, label: int32): Bytes =
    let input: Bytes = BytesAlloc(2)
    BytesSet(input, 0, group)
    BytesSet(input, 1, label)
    return Shake256Xof(input, 32)

fn tamperedCopy(b: Bytes, pos: int32): Bytes =
    let c: Bytes = BytesSlice(b, 0, BytesLen(b))
    BytesSet(c, pos, (BytesGet(c, pos) + 1) & 255)
    return c

fn selfConsistencyRound(name: str, p: mldsa.MldsaParams, group: int32, tamper: bool): bool =
    let kp: mldsa.MldsaKeyPair = mldsa.MldsaKeyGenInternal(p, deriveSeed(group, 1))
    if BytesLen(kp.pk) != mldsa.MldsaPkLen(p) || BytesLen(kp.sk) != mldsa.MldsaSkLen(p):
        echo(Fmt"mldsa {name} group {group}: key lengths wrong: pk={BytesLen(kp.pk)} sk={BytesLen(kp.sk)}")
        return false
    let msg: Bytes = Shake256Xof(deriveSeed(group, 2), 33 + 17 * group)
    let ctx: Bytes = BytesSlice(deriveSeed(group, 3), 0, group % 8)
    let sigRes: Result[Bytes] = mldsa.MldsaSignWithRnd(p, kp.sk, msg, ctx, deriveSeed(group, 4))
    if IsErr(sigRes):
        echo(Fmt"mldsa {name} group {group}: sign failed")
        return false
    let sig: Bytes = Value(sigRes)
    if BytesLen(sig) != mldsa.MldsaSigLen(p):
        echo(Fmt"mldsa {name} group {group}: signature length wrong: {BytesLen(sig)}")
        return false
    if !mldsa.MldsaVerify(p, kp.pk, msg, sig, ctx):
        echo(Fmt"mldsa {name} group {group}: genuine signature rejected")
        return false
    if tamper:
        let sigLen: int32 = BytesLen(sig)
        let msgLen: int32 = BytesLen(msg)
        let pkLen: int32 = BytesLen(kp.pk)
        for t in 0..<4:
            let sigPos: int32 = (t * (sigLen - 1)) / 3
            if mldsa.MldsaVerify(p, kp.pk, msg, tamperedCopy(sig, sigPos), ctx):
                echo(Fmt"mldsa {name} group {group}: tampered signature byte {sigPos} accepted")
                return false
            let msgPos: int32 = (t * (msgLen - 1)) / 3
            if mldsa.MldsaVerify(p, kp.pk, tamperedCopy(msg, msgPos), sig, ctx):
                echo(Fmt"mldsa {name} group {group}: tampered message byte {msgPos} accepted")
                return false
            let pkPos: int32 = (t * (pkLen - 1)) / 3
            if mldsa.MldsaVerify(p, tamperedCopy(kp.pk, pkPos), msg, sig, ctx):
                echo(Fmt"mldsa {name} group {group}: tampered public key byte {pkPos} accepted")
                return false
    return true

fn testSelfConsistency(): bool =
    let p65: mldsa.MldsaParams = mldsa.MldsaParams65()
    for group in 0..<5:
        if !selfConsistencyRound("65", p65, group, group == 0):
            return false
    if !selfConsistencyRound("44", mldsa.MldsaParams44(), 10, false):
        return false
    if !selfConsistencyRound("87", mldsa.MldsaParams87(), 11, false):
        return false
    return true

fn checkLengths(name: str, p: mldsa.MldsaParams, pkLen: int32, skLen: int32, sigLen: int32): bool =
    if mldsa.MldsaPkLen(p) != pkLen || mldsa.MldsaSkLen(p) != skLen || mldsa.MldsaSigLen(p) != sigLen:
        echo(Fmt"mldsa {name} FIPS table mismatch: pk={mldsa.MldsaPkLen(p)} sk={mldsa.MldsaSkLen(p)} sig={mldsa.MldsaSigLen(p)}")
        return false
    return true

fn testEncodingSizes(): bool =
    if !checkLengths("44", mldsa.MldsaParams44(), 1312, 2560, 2420):
        return false
    if !checkLengths("65", mldsa.MldsaParams65(), 1952, 4032, 3309):
        return false
    if !checkLengths("87", mldsa.MldsaParams87(), 2592, 4896, 4627):
        return false
    return true

fn katKeyGen(label: str, seedHex: str, pkHex: str, skHex: str): bool =
    let p: mldsa.MldsaParams = mldsa.MldsaParams65()
    let kp: mldsa.MldsaKeyPair = mldsa.MldsaKeyGenInternal(p, hexToBytes(seedHex))
    if !streq(BytesToHex(kp.pk), pkHex):
        echo(Fmt"mldsa KAT {label}: pk mismatch")
        echo(BytesToHex(kp.pk))
        return false
    if !streq(BytesToHex(kp.sk), skHex):
        echo(Fmt"mldsa KAT {label}: sk mismatch")
        echo(BytesToHex(kp.sk))
        return false
    return true

fn katSigGenInternal(label: str, skHex: str, msgHex: str, sigHex: str): bool =
    let p: mldsa.MldsaParams = mldsa.MldsaParams65()
    let sig: Bytes = mldsa.MldsaSignInternal(p, hexToBytes(skHex), hexToBytes(msgHex), BytesAlloc(32))
    if !streq(BytesToHex(sig), sigHex):
        echo(Fmt"mldsa KAT {label}: signature mismatch")
        echo(BytesToHex(sig))
        return false
    return true

fn katSigVer(label: str, want: bool, pkHex: str, msgHex: str, sigHex: str): bool =
    let p: mldsa.MldsaParams = mldsa.MldsaParams65()
    let got: bool = mldsa.MldsaVerifyInternal(p, hexToBytes(pkHex), hexToBytes(msgHex), hexToBytes(sigHex))
    if got != want:
        echo(Fmt"mldsa KAT {label}: verify result wrong")
        return false
    return true

fn testKat(): bool =
    if !katKeyGen("keyGen tcId=26", kg0Seed, kg0Pk, kg0Sk):
        return false
    if !katKeyGen("keyGen tcId=27", kg1Seed, kg1Pk, kg1Sk):
        return false
    if !katSigGenInternal("sigGen internal tcId=139", sgi0Sk, sgi0Msg, sgi0Sig):
        return false
    if !katSigGenInternal("sigGen internal tcId=137", sgi1Sk, sgi1Msg, sgi1Sig):
        return false
    # sigGen external (public API, deterministic): ctx prefix + zero rnd.
    let p: mldsa.MldsaParams = mldsa.MldsaParams65()
    let extRes: Result[Bytes] = mldsa.MldsaSignWithRnd(p, hexToBytes(sge0Sk), hexToBytes(sge0Msg), hexToBytes(sge0Ctx), BytesAlloc(32))
    if IsErr(extRes):
        echo("mldsa KAT sigGen external tcId=31: sign failed")
        return false
    let extSig: Bytes = Value(extRes)
    if !streq(BytesToHex(extSig), sge0Sig):
        echo("mldsa KAT sigGen external tcId=31: signature mismatch")
        echo(BytesToHex(extSig))
        return false
    if !mldsa.MldsaVerify(p, hexToBytes(sge0Pk), hexToBytes(sge0Msg), extSig, hexToBytes(sge0Ctx)):
        echo("mldsa KAT sigGen external tcId=31: verify roundtrip failed")
        return false
    if !katSigVer("sigVer tcId=141 valid", true, svOkPk, svOkMsg, svOkSig):
        return false
    if !katSigVer("sigVer tcId=140 modified message", false, svMsgPk, svMsgMsg, svMsgSig):
        return false
    if !katSigVer("sigVer tcId=145 modified z", false, svZPk, svZMsg, svZSig):
        return false
    if !katSigVer("sigVer tcId=149 modified hint", false, svHintPk, svHintMsg, svHintSig):
        return false
    if !katSigVer("sigVer tcId=136 modified commitment", false, svComPk, svComMsg, svComSig):
        return false
    return true

fn main(): int32 =
    if !testSelfConsistency():
        return 1
    if !testEncodingSizes():
        return 1
    if !testKat():
        return 1
    echo("mldsa_sig_smoke ok: self-consistency(65 x5 + 44 + 87, tamper sig/msg/pk x4 each) sizes(44=1312/2560/2420 65=1952/4032/3309 87=2592/4896/4627) kat(acvp keyGen tcId=26,27; sigGen internal tcId=139,137 + external ctx tcId=31; sigVer tcId=141 valid + 140/145/149/136 invalid) all passed")
    return 0
