fn R20Make(n: int32): str =
    if n > 0:
        return "continue"
    return "break"

fn R20Append(limit: int32): int32 =
    var total: int32
    var i: int32
    while i < limit:
        let surfaceText = R20Make(i)
        i = i + 1
        if surfaceText.len > 5:
            continue
        total = total + surfaceText.len
    return total

fn main(): int32 =
    let n = R20Append(3)
    if n != 5:
        return 10
    echo("r20 ok")
    return 0
