import std/strings as strings



fn jsFloorDiv(numer: int64, denom: int64): int64 =
    let q = numer / denom
    let r = numer % denom
    if r != int64(0) && ((numer < int64(0)) != (denom < int64(0))):
        return q - int64(1)
    return q

fn jsNumToStr(value: int64): str =
    return strings.IntToStr(int32(value))



fn formatCompactCount(value: int64): str =
    if ((!true) || (value <= int64(0))):
        return ""
    if (value >= int64(10000)):
        return jsNumToStr(jsFloorDiv(value, int64(10000))) + "万"
    return jsNumToStr(value)

# Differential oracle: outputs must match JS evaluation of the original
# formatCompactCount for the same inputs.
fn main(): int32 =
    if formatCompactCount(int64(0)) != "":
        return 1
    if formatCompactCount(int64(0) - int64(5)) != "":
        return 2
    if formatCompactCount(int64(64)) != "64":
        return 3
    if formatCompactCount(int64(9999)) != "9999":
        return 4
    if formatCompactCount(int64(10000)) != "1万":
        return 5
    if formatCompactCount(int64(12800)) != "1万":
        return 6
    if formatCompactCount(int64(128000)) != "12万":
        return 7
    return 0
