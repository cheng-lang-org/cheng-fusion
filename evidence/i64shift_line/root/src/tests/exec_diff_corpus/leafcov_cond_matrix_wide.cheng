# form: comparison-in-branch-position matrix -- exercises backend2 slice-3
# leaf CondA64TrueCode arms the golden ladder never hits: i64 all six
# orderings as a Cbr condition, i32 gt/ge/le (ladder only has lt/eq/ne), and
# uint32/uint64 unsigned orderings (LO/LS/HI/HS, emit_ops:3849-3860) with the
# high bit (bit31/bit63) set so signed vs unsigned condition codes disagree.
# uint_unsigned_compare.cheng covers cmp+cset (bool return); this fixture puts
# every compare directly in `if` position so the BRANCH condition-code arm is
# what executes. Part of the backend2 slice-3 leaf coverage battery.
# expected runtime: every assert holds -> main returns 0. observable: exit code.

fn i64lt(a: int64, b: int64): int32 =
    if a < b:
        return 1
    return 0
fn i64le(a: int64, b: int64): int32 =
    if a <= b:
        return 1
    return 0
fn i64gt(a: int64, b: int64): int32 =
    if a > b:
        return 1
    return 0
fn i64ge(a: int64, b: int64): int32 =
    if a >= b:
        return 1
    return 0
fn i64eq(a: int64, b: int64): int32 =
    if a == b:
        return 1
    return 0
fn i64ne(a: int64, b: int64): int32 =
    if a != b:
        return 1
    return 0

fn i32gt(a: int32, b: int32): int32 =
    if a > b:
        return 1
    return 0
fn i32ge(a: int32, b: int32): int32 =
    if a >= b:
        return 1
    return 0
fn i32le(a: int32, b: int32): int32 =
    if a <= b:
        return 1
    return 0

fn u64lo(a: uint64, b: uint64): int32 =
    if a < b:
        return 1
    return 0
fn u64ls(a: uint64, b: uint64): int32 =
    if a <= b:
        return 1
    return 0
fn u64hi(a: uint64, b: uint64): int32 =
    if a > b:
        return 1
    return 0
fn u64hs(a: uint64, b: uint64): int32 =
    if a >= b:
        return 1
    return 0

fn u32lo(a: uint32, b: uint32): int32 =
    if a < b:
        return 1
    return 0
fn u32ls(a: uint32, b: uint32): int32 =
    if a <= b:
        return 1
    return 0
fn u32hi(a: uint32, b: uint32): int32 =
    if a > b:
        return 1
    return 0
fn u32hs(a: uint32, b: uint32): int32 =
    if a >= b:
        return 1
    return 0

fn main(): int32 =
    # i64 signed six orderings: -3 vs 4 (negative side forces signed codes).
    let m3: int64 = int64(0 - 3)
    let p4: int64 = int64(4)
    if i64lt(m3, p4) != 1:
        return 1
    if i64lt(p4, m3) != 0:
        return 2
    if i64le(m3, m3) != 1:
        return 3
    if i64le(p4, m3) != 0:
        return 4
    if i64gt(p4, m3) != 1:
        return 5
    if i64gt(m3, p4) != 0:
        return 6
    if i64ge(p4, p4) != 1:
        return 7
    if i64ge(m3, p4) != 0:
        return 8
    if i64eq(p4, p4) != 1:
        return 9
    if i64eq(m3, p4) != 0:
        return 10
    if i64ne(m3, p4) != 1:
        return 11
    if i64ne(p4, p4) != 0:
        return 12

    # i32 gt/ge/le branch arms (ladder only exercised lt/eq/ne).
    if i32gt(7, 2) != 1:
        return 13
    if i32gt(2, 7) != 0:
        return 14
    if i32ge(7, 7) != 1:
        return 15
    if i32ge(2, 7) != 0:
        return 16
    if i32le(2, 7) != 1:
        return 17
    if i32le(7, 2) != 0:
        return 18

    # uint64 with bit63 set: unsigned says big > 1, signed says big < 1.
    let big64: uint64 = 0x8000000000000000
    let one64: uint64 = 1
    if u64hi(big64, one64) != 1:
        return 21
    if u64hi(one64, big64) != 0:
        return 22
    if u64hs(big64, one64) != 1:
        return 23
    if u64hs(one64, big64) != 0:
        return 24
    if u64lo(one64, big64) != 1:
        return 25
    if u64lo(big64, one64) != 0:
        return 26
    if u64ls(one64, big64) != 1:
        return 27
    if u64ls(big64, big64) != 1:
        return 28

    # uint32 with bit31 set: same signed/unsigned divergence at 32 bits.
    let big32: uint32 = 0x80000000
    let one32: uint32 = 1
    if u32hi(big32, one32) != 1:
        return 31
    if u32hi(one32, big32) != 0:
        return 32
    if u32hs(big32, one32) != 1:
        return 33
    if u32hs(one32, big32) != 0:
        return 34
    if u32lo(one32, big32) != 1:
        return 35
    if u32lo(big32, one32) != 0:
        return 36
    if u32ls(one32, big32) != 1:
        return 37
    if u32ls(big32, big32) != 1:
        return 38

    return 0
