# form: result-ok-aggregate -- return Ok[Struct](Struct(field: v, ...)) named-field
# aggregate constructor payload, then IsOk/Value projection field reads.
# observable: process exit code.
import std/result

type
    Pt =
        x: int32
        y: int32

fn makePt(a: int32, b: int32): Result[Pt] =
    return Ok[Pt](Pt(x: a, y: b))

fn makeErr(): Result[Pt] =
    return Err[Pt]("nope")

fn main(): int32 =
    let r = makePt(11, 22)
    if IsErr(r):
        return 1
    if !IsOk(r):
        return 2
    let p = Value(r)
    if p.x != 11:
        return 3
    if p.y != 22:
        return 4
    let e = makeErr()
    if IsOk(e):
        return 5
    if !IsErr(e):
        return 6
    return 0
