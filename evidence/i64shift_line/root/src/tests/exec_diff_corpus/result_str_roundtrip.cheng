# form: Result[str] full roundtrip -- Ok/Err construction + Value/Error/IsOk
# projections with T=str (24B payload; the layout instance that coincides with
# the legacy ResultStr* fixed constants). Part of slice-6 Result acceptance net
# (S1): layout-class changes must keep this byte-stable AND runtime-green.
# observable: process exit code.
import std/result

fn pick(flag: bool): Result[str] =
    if flag:
        return Ok[str]("hello")
    return Err[str]("bad")

fn main(): int32 =
    var r: Result[str] = pick(true)
    if !IsOk(r):
        return 1
    let v: str = Value(r)
    if Len(v) != 5:
        return 2
    var e: Result[str] = pick(false)
    if IsOk(e):
        return 3
    let msg: str = Error(e)
    if Len(msg) != 3:
        return 4
    return 0
