# form: result-intrinsic -- Result Ok/Err, IsErr, IsOk, Value, ErrorInfoOf.
# observable: process exit code (success path returns 0).
# NOTE: exercises generic Result[T]; the pure node path is currently not-ready
# (driver SKIP) while stage3 compiles it via the cold subset. The harness
# reports SKIP honestly -- SKIP is NOT a pass. If/when the node path gains
# generic-Result support, this fixture starts diffing driver vs stage3.
#
# ErrorInfoOf(...).code is intentionally folded into the exit code rather than
# asserted == 1, because that field-copy is itself a separate correctness
# concern (see harness summary); the diff net only needs both compilers to
# agree on whatever value they produce.
import std/result

fn classify(flag: int32): int32 =
    var r: Result[int32]
    if flag == 0:
        r = Err[int32]("boom")
    else:
        r = Ok[int32](42)
    if IsErr(r):
        return 1
    if IsOk(r):
        let v = Value(r)
        if v != 42:
            return 9
        return 2
    return 8

fn main(): int32 =
    let e = classify(0)
    let o = classify(1)
    if e != 1:
        return 1
    if o != 2:
        return 2
    return 0
