# form (net-audit r14): a fixed-length array initialized from a BRACED LITERAL
# list — `var a: int32[N] = [v0, v1, ...]` — then read back and mutated. Existing
# fixtures zero-init fixed arrays then assign element by element; none use the
# `[...]` initializer-list form for a fixed array. Stresses: the codegen that
# lowers an N-element array literal into N consecutive element stores at
# compile-time offsets (base + k*elemSize), each from the corresponding literal,
# before any runtime use. A bug that drops a literal, mis-orders the stores, or
# uses the wrong stride leaves a slot wrong. observable: exit code.
#
# DRIVER MISCOMPILE (blame=DRIVER, net-audit r14): driver returns rc=1
# (`a[0] != 10`) while stage3 returns 0. otool on the driver's `_main` shows the
# braced-literal initializer is ENTIRELY DROPPED — the array storage at
# [sp,#0xc0..] is never written (no `mov w_,#0xa; str w_,[sp,#0xc0]` sequence
# for the six literals), so the first read of `a[0]` loads stack garbage. The
# six immediates 10/20/.. that DO appear are the COMPARISON RHS of the asserts,
# not initializer stores. stage3 emits six consecutive `mov w0,#0xa..#0x3c` +
# stores into the array region. i.e. `var a: T[N] = [lit, ...]` lowers to zero
# element-stores on the driver; the fixed-array braced-literal initializer is
# silently dropped. blame=DRIVER.
fn sumArr(a: int32[6]): int32 =
    var s: int32
    for i in 0..<6:
        s = s + a[i]
    return s
fn main(): int32 =
    var a: int32[6] = [10, 20, 30, 40, 50, 60]
    # every element landed at its slot.
    if a[0] != 10:
        return 1
    if a[1] != 20:
        return 2
    if a[2] != 30:
        return 3
    if a[3] != 40:
        return 4
    if a[4] != 50:
        return 5
    if a[5] != 60:
        return 6
    # sum via a loop (proves the whole array is contiguous and correct).
    var s: int32
    for i in 0..<6:
        s = s + a[i]
    if s != 210:
        return 7
    # pass the initialized array by value to a helper.
    if sumArr(a) != 210:
        return 8
    # mutate one slot via a variable index, neighbours untouched.
    let idx: int32 = 3
    a[idx] = 999
    if a[3] != 999:
        return 9
    if a[2] != 30:
        return 10
    if a[4] != 50:
        return 11
    # a second array with negative and zero literals.
    var b: int32[4] = [0 - 5, 0, 7, 0 - 1]
    if b[0] != (0 - 5):
        return 12
    if b[1] != 0:
        return 13
    if b[2] != 7:
        return 14
    if b[3] != (0 - 1):
        return 15
    # element-to-element copy within the initialized array.
    a[0] = a[5]
    if a[0] != 60:
        return 16
    # a literal list whose entries are simple constant expressions.
    var c: int32[3] = [1 + 1, 2 * 3, 10 - 4]
    if c[0] != 2:
        return 17
    if c[1] != 6:
        return 18
    if c[2] != 6:
        return 19
    return 0
