# form: pure i64 accumulator while-loop -- exercises the Stage5b/5c cross-block
# carry (acc carried in a callee-saved reg). Stage3 is the oracle. acc written
# ONLY by I64->I64 CopyLocal (acc = t) and read ONLY as a BinOp operand, so the
# 5c conservative gate may DROP the per-iter store (register-only loop body).
# sum(0..10) = 45; exit code derived from it.
fn sumTo(n: int64): int64 =
    var acc: int64 = int64(0)
    var i: int64 = int64(0)
    while i < n:
        let t: int64 = acc + i
        acc = t
        i = i + int64(1)
    return acc
fn main(): int32 =
    let r: int64 = sumTo(int64(10))
    if r != int64(45):
        return 1
    return 0
