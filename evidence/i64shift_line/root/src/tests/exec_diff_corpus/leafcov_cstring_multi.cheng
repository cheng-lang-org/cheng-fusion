# form: multiple cstring literals across calls -- exercises backend2 slice-3
# leaves AppendCStringDataLabels (ordinals 0..N over several literals, an
# EMPTY literal "" whose payload is the lone NUL byte, and the SAME text used
# twice -- dedup vs two-id behavior is pinned by the length observable) and
# AppendCStringArgRelocs (one call carrying TWO cstring register args ->
# subIndex 0 and 1 inside a single FillCallOp, interleaved with single-arg
# calls). sp25a_cstring_arg only has one literal per call and no empty/dup
# literal. Part of the backend2 slice-3 leaf coverage battery. Linked against
# leafcov_cstring_multi.stub.c (strlen bridges, no main).
# expected runtime: 0 / 3 / 3+5=8 / 3 -> main returns 0. observable: exit code.
@importc("leafcov_cstrlen")
fn cstrlen(p: ptr): int32

@importc("leafcov_cstrcat2len")
fn cat2(p: ptr, q: ptr): int32

fn main(): int32 =
    if cstrlen("") != 0:
        return 1
    if cstrlen("abc") != 3:
        return 2
    if cat2("abc", "hello") != 8:
        return 3
    if cstrlen("abc") != 3:
        return 4
    return 0
