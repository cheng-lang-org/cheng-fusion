# form: a GLOBAL aggregate var assigned the result of a REAL function that
# returns an aggregate by sret: `gPair = makePair(a, b)`. The callee writes its
# return bytes through x8; the caller MUST point x8 at the GLOBAL symbol's
# storage (adrp+add), not a fresh stack slot. If x8 is stack-relative the global
# stays zero and every read diverges. observable: exit code.
type Pair =
    a: int32
    b: int32

var gPair: Pair

fn makePair(x: int32, y: int32): Pair =
    return Pair(a: x + 1, b: y + 2)

fn setPair(x: int32, y: int32) =
    gPair = makePair(x, y)

fn main(): int32 =
    setPair(10, 20)
    if gPair.a != 11:
        return 1
    if gPair.b != 22:
        return 2
    setPair(100, 200)
    if gPair.a != 101:
        return 3
    if gPair.b != 202:
        return 4
    # second global to ensure label routing is per-global, not shared
    return 0
