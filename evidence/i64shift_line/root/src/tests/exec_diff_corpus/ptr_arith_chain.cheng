# form: ptr arithmetic chain -- repeated ptr<->uint64 roundtrips with offset
# adds/subs composed in one function, plus alignment-down masking. observable:
# exit code. ptr_cast_bridge did a single ptr roundtrip; cast_chain did two.
# This chains many in sequence so a clobbered live ptr temporary surfaces.
fn main(): int32 =
    let base: uint64 = uint64(0x10_0000)
    var p: ptr = ptr(base)
    # walk forward by 8 four times.
    p = ptr(uint64(p) + uint64(8))
    p = ptr(uint64(p) + uint64(8))
    p = ptr(uint64(p) + uint64(8))
    p = ptr(uint64(p) + uint64(8))
    if uint64(p) != (base + uint64(32)):
        return 1
    # step back by 16.
    p = ptr(uint64(p) - uint64(16))
    if uint64(p) != (base + uint64(16)):
        return 2
    # align p down to 64-byte boundary via mask.
    let aligned: uint64 = uint64(p) & uint64(0xFFFFFFFFFFFFFFC0)
    if aligned != base:
        return 3
    # offset chain with intermediate live values that must all survive.
    let a: uint64 = uint64(p)
    let b: uint64 = a + uint64(0x100)
    let c: uint64 = b + uint64(0x200)
    let d: uint64 = c - uint64(0x50)
    if d != (base + uint64(16) + uint64(0x100) + uint64(0x200) - uint64(0x50)):
        return 4
    # roundtrip the final value through ptr and back.
    let pf: ptr = ptr(d)
    if uint64(pf) != d:
        return 5
    # difference of two ptrs as element count.
    let lo: ptr = ptr(base)
    let hi: ptr = ptr(base + uint64(80))
    let elems: uint64 = (uint64(hi) - uint64(lo)) / uint64(8)
    if elems != uint64(10):
        return 6
    return 0
