# form: assign an enum CONSTANT to a `var <Enum>` out-parameter
#   (`opOut = SomeEnumConst`), then read that var-param back THROUGH ITS POINTER
#   (`return int32(opOut)`). The pure backend treated `var <Enum>` params as Ptr
#   slots with an UNRESOLVED pointee kind — the scalar var-pointee type-text map
#   only knew int32/bool/i64/str, NOT named enum types. So VarParamPointeeKind
#   returned Invalid, the store-through-pointer path was never taken, and the
#   assign fell through to a cold InvalidOp (wcz general-assign bail, detail0=0;
#   the exact shape of TypedExprIrRhsBinopResultMeta's `opKindOut = ...`). Fix: a
#   `var <Enum>` pointee is i32 (enums are i32-backed), enabling the store +
#   read-through-pointer.
#
#   The write and the read-back both happen INSIDE the callee where the param IS
#   the pointer, returning the result as a scalar — so the observable does not
#   depend on the caller's (orthogonal) local-var by-ref readback. Covers the
#   default ordinal members AND an explicit-valued member (OpAdd = 7).
# observable: process exit code; main returns 0 on success, distinct nonzero per
#   failed sub-check.

type
    OpKind = enum
        OpNone
        OpOr
        OpAnd
        OpAdd = 7
        OpStr

fn setAndReadBack(level: int32, opOut: var OpKind): int32 =
    opOut = OpNone
    if level == 1:
        opOut = OpOr
    if level == 2:
        opOut = OpAnd
    if level == 7:
        opOut = OpAdd
    if level == 8:
        opOut = OpStr
    return int32(opOut)

fn main(): int32 =
    var op: OpKind
    if setAndReadBack(0, op) != 0:
        return 1
    if setAndReadBack(1, op) != 1:
        return 2
    if setAndReadBack(2, op) != 2:
        return 3
    if setAndReadBack(7, op) != 7:
        return 4
    if setAndReadBack(8, op) != 8:
        return 5
    return 0
