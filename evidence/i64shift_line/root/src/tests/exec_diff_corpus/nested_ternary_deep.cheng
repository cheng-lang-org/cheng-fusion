# form: deeply-nested ternary select (4 levels) with mixed int operands and a
# ternary feeding an arithmetic expression. observable: exit code. nested_ternary
# / mixed_ternary_sum covered 2 levels; this stresses the select-chain lowering
# at depth where a clobbered branch-temp would surface.
fn grade(x: int32): int32 =
    # 4-deep ternary: classify x into 5 buckets.
    return x >= 90 ? 5 : (x >= 80 ? 4 : (x >= 70 ? 3 : (x >= 60 ? 2 : 1)))
fn combine(a: int32, b: int32, c: int32): int32 =
    # ternary result feeds arithmetic, and a ternary appears as an operand.
    let m = (a > b ? a : b)
    let n = (b > c ? b : c)
    return (m > n ? m : n) + (a < b ? a : b) + (a == b ? 100 : 0)
fn main(): int32 =
    if grade(95) != 5:
        return 1
    if grade(85) != 4:
        return 2
    if grade(75) != 3:
        return 3
    if grade(65) != 2:
        return 4
    if grade(50) != 1:
        return 5
    # combine(3,7,5): m=7, n=7, max=7; min(a,b)=3; a==b? no ->0 => 10.
    if combine(3, 7, 5) != 10:
        return 6
    # combine(8,8,2): m=8, n=8, max=8; min=8; a==b? yes ->100 => 116.
    if combine(8, 8, 2) != 116:
        return 7
    # nested ternary as array index selector style.
    let pick = (grade(95) == 5 ? grade(40) : grade(99))
    if pick != 1:
        return 8
    return 0
