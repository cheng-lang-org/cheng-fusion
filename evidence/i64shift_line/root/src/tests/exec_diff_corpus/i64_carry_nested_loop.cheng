# form: nested i64 accumulator loops. The natural-loop detector requires EXACTLY
# ONE back-edge in the whole body; a nested loop has two, so the carry/store-drop
# plan stays INERT. Verifies the multi-back-edge case still matches the stage3
# oracle (no spurious carry). acc += i*j over i,j in 0..3 -> sum = 9.
fn grid(n: int64): int64 =
    var acc: int64 = int64(0)
    var i: int64 = int64(0)
    while i < n:
        var j: int64 = int64(0)
        while j < n:
            let t: int64 = acc + (i * j)
            acc = t
            j = j + int64(1)
        i = i + int64(1)
    return acc
fn main(): int32 =
    let r: int64 = grid(int64(3))
    if r != int64(9):
        return 1
    return 0
