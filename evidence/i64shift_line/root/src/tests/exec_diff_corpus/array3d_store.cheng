# form: 3D fixed-length array store int32[2][2][2] -- zero-init then cube[i][j][k]=v
# read back. observable: exit code. Covers row-major address for 3 indices
# (base + ((i*d1 + j)*d2 + k)*elemSize) + fixed 3D zero-init. r1-3 only had 2D.
fn main(): int32 =
    var cube: int32[2][2][2]
    # every cell zero-init.
    if cube[0][0][0] != 0:
        return 1
    if cube[1][1][1] != 0:
        return 2
    if cube[0][1][0] != 0:
        return 3
    # store into corners + interior, all distinct row-major cells.
    cube[0][0][0] = 1
    cube[1][1][1] = 8
    cube[1][0][1] = 5
    cube[0][1][1] = 4
    # read back exactly.
    if cube[0][0][0] != 1:
        return 4
    if cube[1][1][1] != 8:
        return 5
    if cube[1][0][1] != 5:
        return 6
    if cube[0][1][1] != 4:
        return 7
    # untouched cells must remain zero (no overlap in address math).
    if cube[0][0][1] != 0:
        return 8
    if cube[1][0][0] != 0:
        return 9
    if cube[0][1][0] != 0:
        return 10
    if cube[1][1][0] != 0:
        return 11
    # compound store reading two cells.
    cube[1][1][0] = cube[1][1][1] + cube[1][0][1]
    if cube[1][1][0] != 13:
        return 12
    return 0
