# form: sizeof(T) -- value of sizeof for primitives and structs.
# observable: process exit code. Well-known sizes are asserted; the layout of
# Trip (alignment-dependent) is folded into the exit code so driver vs stage3
# must agree on it even though we don't hardcode the expected number.
type
    Pair =
        a: int32
        b: int32

    Trip =
        a: int32
        b: int64
        c: int32

fn main(): int32 =
    let s32 = int32(sizeof(int32))
    if s32 != 4:
        return 1
    let s64 = int32(sizeof(int64))
    if s64 != 8:
        return 2
    let sp = int32(sizeof(Pair))
    if sp != 8:
        return 3
    let stride = int32(sizeof(int32)) * 3
    if stride != 12:
        return 4
    # Trip size is alignment-dependent; encode it into the exit code so that a
    # driver-vs-stage3 disagreement on struct layout surfaces as a runtime diff.
    let st = int32(sizeof(Trip))
    if st < 16:
        return 5
    return 100 + st
