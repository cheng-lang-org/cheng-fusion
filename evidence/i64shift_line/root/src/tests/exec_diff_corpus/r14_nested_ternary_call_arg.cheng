# form (net-audit r14): a NESTED ternary appearing directly as a CALL ARGUMENT —
# `f((cond1 ? a : (cond2 ? b : c)), ...)`. nested_ternary_deep tested deep
# ternary chains as a return value / local; chained_ternary_arith tested them in
# arithmetic. This stresses the ternary-select lowering when its result must be
# materialized into the ARGUMENT-passing register/slot exactly at the call
# boundary: a clobbered branch temp, or a select result spilled to the wrong arg
# slot, surfaces as the callee receiving the wrong operand. Each ternary arg is
# parenthesized and placed on its own line — the only form the cold reference
# front-end parses as a call argument (a bare `cond ? a : b, next` makes its
# ternary-else parser swallow the comma). observable: exit code.
#
# DRIVER MISCOMPILE (blame=DRIVER, net-audit r14): driver returns rc=6 (the `r5`
# check: `add3((t!=0 ? add3(1,2,3) : add3(9,9,9)), 0, 0) != 6`) while stage3
# returns 0. Reduced trigger: a ternary whose BRANCHES are CALL expressions used
# as a call argument. otool on the driver's `_main` shows the WHOLE ternary is
# dropped: no `b.cond` on the condition, NEITHER inner add3 call is emitted, and
# the outer call's first-argument slot ([sp,#0x1c]) is loaded (`ldr w0,[sp,#0x1c]`)
# WITHOUT ever being written — the outer add3 receives uninitialized stack as its
# first arg. i.e. a `cond ? call() : call()` ternary in argument position lowers
# to nothing on the driver; the condition test, both branch calls, and the select
# are all omitted. stage3 is clean. blame=DRIVER.
fn add3(a: int32, b: int32, c: int32): int32 =
    return a + b + c
fn pick(flag: int32, lo: int32, hi: int32): int32 =
    return flag != 0 ? hi : lo
fn main(): int32 =
    let t: int32 = 1
    let z: int32 = 1 - 1
    # one ternary per argument.
    let r1 = add3(
        (t != 0 ? 10 : 99),
        (z != 0 ? 99 : 20),
        (t != 0 ? 30 : 99))
    if r1 != 60:
        return 1
    # nested ternary as one argument; the others plain.
    let x: int32 = 5
    let r2 = add3(
        (x > 10 ? 1 : (x > 3 ? 2 : 3)),
        100,
        1000)
    if r2 != 1102:
        return 2
    # nested ternary as an argument whose branch is itself a value derived from x.
    let inner: int32 = pick(t, 0, (x > 0 ? 7 : 8))
    if inner != 7:
        return 3
    # ternary args where the condition itself is a call result.
    let r3 = add3(
        (pick(t, 1, 2) == 2 ? 40 : 4),
        (pick(z, 5, 6) == 5 ? 50 : 5),
        0)
    if r3 != 90:
        return 4
    # 3-level nested ternary as a single argument among constants.
    let g: int32 = 7
    let r4 = add3(
        (g >= 9 ? 900 : (g >= 6 ? 600 : (g >= 3 ? 300 : 0))),
        1,
        1)
    if r4 != 602:
        return 5
    # ternary whose branches are themselves calls; only the selected one's value
    # matters (both branches pure).
    let r5 = add3(
        (t != 0 ? add3(1, 2, 3) : add3(9, 9, 9)),
        0,
        0)
    if r5 != 6:
        return 6
    let r6 = add3(
        (z != 0 ? add3(100, 100, 100) : add3(4, 5, 6)),
        0,
        0)
    if r6 != 15:
        return 7
    return 0
