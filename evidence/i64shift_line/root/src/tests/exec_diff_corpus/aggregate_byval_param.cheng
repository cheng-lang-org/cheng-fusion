# form: aggregate passed BY VALUE into a callee that reads multiple fields; the
# caller's copy must be unaffected (value semantics). observable: exit code.
type
    Vec3 =
        x: int32
        y: int32
        z: int32
fn sumv(v: Vec3): int32 =
    return v.x + v.y + v.z
fn scaled(v: Vec3, k: int32): int32 =
    # read same aggregate twice through different field orders.
    return (v.z * k) + (v.y * k) + (v.x * k)
fn main(): int32 =
    let v = Vec3(x: 3, y: 5, z: 7)
    if sumv(v) != 15:
        return 1
    if scaled(v, 2) != 30:
        return 2
    # caller's v must be unchanged after by-value calls.
    if v.x != 3:
        return 3
    if v.z != 7:
        return 4
    if sumv(v) != 15:
        return 5
    return 0
