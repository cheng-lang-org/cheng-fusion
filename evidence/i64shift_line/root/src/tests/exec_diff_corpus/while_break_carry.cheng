# form: while loop that BREAKs carrying an accumulated value out, plus a
# continue that skips an update -- the value computed before break must survive
# (live across the loop exit edge). observable: exit code. ctrl_flow covered a
# simple break/continue returning an accumulator; this stresses a value mutated
# right before break and a nested inner loop with its own break.
fn search(n: int32): int32 =
    var found: int32 = 0 - 1
    var i: int32
    while i < n:
        i = i + 1
        if i == 4:
            continue
        # capture the running value, then break once a condition holds.
        if (i * i) > 20:
            found = i * 100 + i
            break
    return found
fn nestedSum(rows: int32, cols: int32): int32 =
    var total: int32
    var r: int32
    while r < rows:
        var c: int32
        while c < cols:
            c = c + 1
            if c == 2:
                continue
            if c > 4:
                break
            total = total + (r * 10 + c)
        r = r + 1
    return total
fn main(): int32 =
    # i: 1,2,3,(skip4),5 -> at i=5, 25>20 -> found = 505, break.
    let f = search(10)
    if f != 505:
        return 1
    # if condition never met, found stays -1.
    let g = search(3)
    if g != (0 - 1):
        return 2
    # nested loop value carry: rows=2 cols=6, inner counts c in 1..6, skip c==2,
    # break when c>4 (so c=1,3,4 contribute). r=0: 1+3+4=8. r=1: 11+13+14=38.
    let s = nestedSum(2, 6)
    if s != 46:
        return 3
    return 0
