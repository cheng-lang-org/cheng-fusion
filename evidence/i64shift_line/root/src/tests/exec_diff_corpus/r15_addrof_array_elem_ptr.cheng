# form (net-audit r15): take the ADDRESS of a fixed-array element and bind it to
# a `ptr` local — `let p: ptr = &a[k]` — then BRANCH on pointer comparisons
# (`==` / `!=`) between such bound pointers. Existing ptr fixtures (ptr_offset_rw,
# r14_ptr_deref_assign_chain) receive an already-formed `ptr` PARAMETER from a C
# stub and deref it; none take `&a[k]` of a Cheng-local fixed array, bind it to a
# `ptr`, and compare two such bindings. Stresses: the address-of-element codegen
# (`add x_, sp, #elemOff`) feeding a `let p: ptr = …` store, then a ptr-vs-ptr
# compare driving control flow. observable: exit code.
#
# DRIVER MISCOMPILE (blame=DRIVER, net-audit r15): driver returns rc=1
# (`p0 != q0` is taken even though both are `&a[0]`) while stage3 returns 0.
# otool on the driver's `_main` shows `a` is built at [sp,#0x30] (setMem-zeroed)
# but the `let p0 = &a[0]` / `let q0 = &a[0]` bindings at [sp,#0x18] / [sp,#0x20]
# are NEVER WRITTEN — there is no `add x_,sp,#0x30 ; str x_,[sp,#0x18]` sequence.
# The compare then loads two UNINITIALIZED stack slots (`ldr x9,[sp,#0x18]` /
# `ldr x10,[sp,#0x20]`), which hold garbage and differ, so `&a[0] != &a[0]`
# wrongly evaluates true. stage3 emits the `add`+store for each address-of.
# i.e. `let p: ptr = &a[k]` (address-of a fixed-array element into a ptr local)
# is silently dropped on the driver; the ptr local is stack garbage. blame=DRIVER.
fn main(): int32 =
    var a: int32[4]
    a[0] = 11
    a[1] = 22
    a[2] = 33
    a[3] = 44
    let p0: ptr = &a[0]
    let q0: ptr = &a[0]
    let p1: ptr = &a[1]
    # same element -> identical addresses.
    if p0 != q0:
        return 1
    if p0 == p1:
        return 2
    # branch on the comparisons and accumulate.
    var hit: int32
    if p0 == q0:
        hit = hit + 10
    if p0 != p1:
        hit = hit + 20
    if hit != 30:
        return 3
    # a pointer compared to itself is always equal regardless of which element.
    let p2: ptr = &a[2]
    if p2 != p2:
        return 4
    if p1 == p2:
        return 5
    # all three element addresses are pairwise distinct (no two collapse).
    if p0 == p1:
        return 6
    if p0 == p2:
        return 7
    if p1 == p2:
        return 8
    return 0
