# form: for-range loops whose bound nodes the node-eval path must own.
# Mirrors the imported-function for-loops (hashmaps/compiler_csg) that were the
# largest `for no_node` strict family: a `for i in 0..<xs.len` accumulator plus a
# `for j in lo..<hi` local-bound loop. Before the fix the per-line repair scan
# left rhsNodeIndex=-1 for these for-headers (whole function -> cold); now the
# range start/end bound nodes are built so the loop runs on the node path.
fn sumUpTo(xs: int32[], lo: int32, hi: int32): int32 =
    var total: int32
    for i in 0..<xs.len:
        total = total + xs[i]
    for j in lo..<hi:
        total = total + j
    return total

fn main(): int32 =
    var xs: int32[]
    add(xs, 3)
    add(xs, 4)
    add(xs, 5)
    # 3+4+5 = 12, plus 2+3+4 = 9 -> 21
    return sumUpTo(xs, 2, 5)
