# form: consecutive casts in a single expression chain across i32/i64/u32/u64
# without intermediate lets -- cast(cast(cast(x))) inline. observable: exit code.
# cast_chain used named intermediates; this nests casts directly so the
# expression-tree cast lowering (no spill slot per step) is exercised.
fn roundtrip(x: int32): int32 =
    # i32 -> i64 -> u64 -> u32 -> i32, all nested in one expression.
    return int32(uint32(uint64(int64(x))))
fn widenWrap(x: int32): int64 =
    # negative i32 -> i64 (sign extend) -> u64 (reinterpret) -> i64.
    return int64(uint64(int64(x)))
fn main(): int32 =
    if roundtrip(123456) != 123456:
        return 1
    if roundtrip(0 - 7) != (0 - 7):
        return 2
    # large positive that survives the u32 narrowing only if it fits.
    if roundtrip(2000000000) != 2000000000:
        return 3
    # negative widen-wrap: -1 -> i64 -1 -> u64 all-ones -> i64 -1.
    if widenWrap(0 - 1) != int64(0 - 1):
        return 4
    # nested cast as identity on a mid-range value passed through a function so
    # both compilers agree on the operand width (no literal-cast typing quirk).
    if roundtrip(1879048192) != 1879048192:
        return 5
    # nested cast feeding a subtraction back to zero.
    if (roundtrip(123456) - roundtrip(123456)) != 0:
        return 6
    return 0
