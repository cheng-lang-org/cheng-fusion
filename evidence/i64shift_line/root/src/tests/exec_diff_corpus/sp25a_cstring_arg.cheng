# Phase 2.5+ census: a STRING LITERAL passed directly as a call ARGUMENT to a
# ptr-param function. The literal becomes a CallArgSlotCString, whose ADRP is
# emitted INSIDE the call sequence (FillCallOp), not at an op's first word. If
# that ADRP page/pageoff reloc word offset is wrong, the C side receives a bogus
# pointer and the measured length differs -> exit code changes. The fixture calls
# the same ptr-arg function with three literals of distinct lengths and checks
# each measured length, so a mis-targeted reloc on ANY of them is observable.
# observable: process exit code. driver (node path) vs stage3 (cold) must agree.
# Linked against sp25a_cstring_arg.stub.c (cstrlen over the received ptr).
@importc("sp25a_cstrlen")
fn cstrlen(p: ptr): int32

fn main(): int32 =
    if cstrlen("a") != 1:
        return 1
    if cstrlen("phase25") != 7:
        return 2
    if cstrlen("call-cstring-arg-reloc") != 22:
        return 3
    return 0
