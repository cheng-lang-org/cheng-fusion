# form: bit-population-count, count-leading-zeros, count-trailing-zeros computed
# in pure Cheng via shift+mask loops over uint32. observable: exit code. No
# popcount/clz/ctz intrinsic exists, so this is a loop that hammers the
# `& 1` mask, the `>> 1` logical shift, and a per-iteration counter increment —
# exactly the shift+bitwise+loop-counter family where a stale-slot miscompile
# (shift_edges / zero_local_shift_or class) surfaces. Each helper is asserted
# against hand-computed values.
fn popcount32(v: uint32): int32 =
    var n = v
    var count: int32
    for i in 0..<32:
        count = count + int32(n & uint32(1))
        n = n >> uint32(1)
    return count

fn clz32(v: uint32): int32 =
    if v == uint32(0):
        return 32
    var n = v
    var count: int32
    # walk from the top bit down; count leading zero bits.
    var bit: int32 = 31
    while bit >= 0:
        let mask = uint32(1) << uint32(bit)
        if (n & mask) != uint32(0):
            return count
        count = count + 1
        bit = bit - 1
    return count

fn ctz32(v: uint32): int32 =
    if v == uint32(0):
        return 32
    var n = v
    var count: int32
    while (n & uint32(1)) == uint32(0):
        count = count + 1
        n = n >> uint32(1)
    return count

fn main(): int32 =
    # popcount of 0xF0F0F0F0 = 16 one-bits.
    if popcount32(uint32(0xF0F0F0F0)) != 16:
        return 1
    # popcount of 0 = 0.
    if popcount32(uint32(0)) != 0:
        return 2
    # popcount of 0x7 = 3.
    if popcount32(uint32(7)) != 3:
        return 3
    # popcount of 0x80000000 (single high bit) = 1.
    if popcount32(uint32(0x80000000)) != 1:
        return 4

    # clz of 1 = 31 leading zeros.
    if clz32(uint32(1)) != 31:
        return 5
    # clz of 0x80000000 = 0 (top bit set).
    if clz32(uint32(0x80000000)) != 0:
        return 6
    # clz of 0x00010000 = 15 leading zeros.
    if clz32(uint32(0x00010000)) != 15:
        return 7
    # clz of 0 = 32 (special case).
    if clz32(uint32(0)) != 32:
        return 8

    # ctz of 1 = 0 trailing zeros.
    if ctz32(uint32(1)) != 0:
        return 9
    # ctz of 0x80000000 = 31 trailing zeros.
    if ctz32(uint32(0x80000000)) != 31:
        return 10
    # ctz of 0x00010000 = 16 trailing zeros.
    if ctz32(uint32(0x00010000)) != 16:
        return 11
    # ctz of 0 = 32 (special case).
    if ctz32(uint32(0)) != 32:
        return 12

    # cross-check: popcount + clz + ctz consistency on a known value.
    # for 0x00010000: 1 set bit, 15 leading zeros, 16 trailing zeros.
    let pc = popcount32(uint32(0x00010000))
    let lz = clz32(uint32(0x00010000))
    let tz = ctz32(uint32(0x00010000))
    if (pc + lz + tz) != 32:
        return 13
    return 0
