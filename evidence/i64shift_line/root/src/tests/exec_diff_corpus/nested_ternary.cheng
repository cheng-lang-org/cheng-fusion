# form: nested ternary -- a ? b ? c : d : e  (chained select).
# observable: exit code. The branchless ternary lowering must not evaluate the
# inner ternary's not-selected arm, and the precedence/associativity of nested
# `?:` must match a real branch tree.
fn pick(a: int32, b: int32): int32 =
    # classic chained ternary: outer cond a, inner cond b.
    return a ? (b ? 10 : 20) : 30
fn main(): int32 =
    if pick(1, 1) != 10:
        return 1
    if pick(1, 0) != 20:
        return 2
    if pick(0, 1) != 30:
        return 3
    if pick(0, 0) != 30:
        return 4
    # deeper: a ? b ? c ? 1 : 2 : 3 : 4
    let a: int32 = 1
    let b: int32 = 1 - 1
    let c: int32 = 1
    let r: int32 = a ? (b ? (c ? 1 : 2) : 3) : 4
    if r != 3:
        return 5
    return 0
