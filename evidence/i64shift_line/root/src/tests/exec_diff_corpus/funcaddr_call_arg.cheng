# form: pass the ADDRESS of a top-level function as a call argument
# (`takesPtr(&worker)`). The lowerer builds a `__cheng_function_address#N`
# GlobalAddress slot whose ADRP/ADD data reloc must target the FUNCTION symbol
# (allSymbolNames[N]), not cheng_global_<name>. observable: exit code.
#
# Caveat under test: the fill (PrimaryBodyIrAppendGlobalOpRelocs) rewrites the
# data reloc target to the function symbol for function-address slots. If that
# reloc were dropped (e.g. by deleting the op-scan without the fill covering it)
# the passed pointer would be nil/garbage and the assert below would diverge
# from the stage3 oracle.
fn worker(): int32 =
    return 7

fn takesPtr(p: ptr): int32 =
    if p == nil:
        return 0
    return 1

fn main(): int32 =
    if takesPtr(&worker) != 1:
        return 1
    return 0
