# form: a runtime-computed uint32 value compared (==) against a large DECIMAL
# literal that exceeds INT32_MAX. observable: exit code.
#
# DRIVER MISCOMPILE (blame=DRIVER): when the comparison RHS is a decimal literal
# > 2147483647 (e.g. 4294967294 = 0xFFFFFFFE, or 3000000000), the driver fails
# to MATERIALIZE that literal into the cmp operand slot — it allocates the stack
# slot but omits the `mov #imm ; str` pair, so `cmp` reads an uninitialized
# slot and the equality is wrong. stage3 lowers it correctly (clean rc=0).
# The HEX form of the same value (0xFFFFFFFE) and SMALL decimals work on both
# sides; only the large-decimal compare-RHS path is broken on the driver.
# Confirmed by otool: the `eq_hex` body emits `mov w9,#-0x2 ; str w9,[sp,#0x28]`
# before the cmp; the `eq_dec` body is missing that store entirely.
#
# To keep blame=DRIVER unambiguous this fixture avoids the SHARED unsigned-
# compare bug (uint_unsigned_compare) — it uses only `==` against large
# decimals, never `>`/`<` on high-bit values.
fn sub(a: uint32, b: uint32): uint32 =
    return a - b
fn main(): int32 =
    # 3 - 5 wraps unsigned to 4294967294 (0xFFFFFFFE).
    let w: uint32 = sub(uint32(3), uint32(5))
    # compare against the LARGE DECIMAL literal -> driver omits the store.
    if w != uint32(4294967294):
        return 1
    # the SAME value via the HEX literal works on both (control).
    if w != uint32(0xFFFFFFFE):
        return 2
    # a SMALL decimal compare works on both (control).
    let s: uint32 = sub(uint32(10), uint32(3))
    if s != uint32(7):
        return 3
    # a different large decimal compare-RHS (3,000,000,000) also breaks driver.
    let b: uint32 = sub(uint32(3000000005), uint32(5))
    if b != uint32(3000000000):
        return 4
    return 0
