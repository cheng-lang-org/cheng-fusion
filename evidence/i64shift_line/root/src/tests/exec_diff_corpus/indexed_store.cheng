# form: indexed store -- arr[i] = v then read back; covers indexed-store lowering.
# observable: process exit code.
fn fill(n: int32): int32[] =
    var out: int32[]
    for i in 0..<n:
        add(out, 0)
    # now write by index
    for i in 0..<n:
        out[i] = i * i
    return out

fn main(): int32 =
    let sq = fill(5)
    if sq.len != 5:
        return 1
    if sq[0] != 0:
        return 2
    if sq[1] != 1:
        return 3
    if sq[2] != 4:
        return 4
    if sq[3] != 9:
        return 5
    if sq[4] != 16:
        return 6
    # indexed store using other indices as operands
    var grid: int32[]
    add(grid, 1)
    add(grid, 1)
    add(grid, 1)
    grid[1] = grid[0] + grid[2]
    if grid[1] != 2:
        return 7
    return 0
