# Stage-8 const-widen fold: `int64(<i32 literal>)` masks inside a hot loop.
# Each `& int64(1048575)` used to lower as LoadConst-i32 + I32->I64 CopyLocal
# (str w; ldrsw x; str x). The fold materializes the constant straight into an
# i64 slot (single str x), collapsing the cast round-trip. Result must match the
# stage3 oracle exactly.
fn hot(n: int64): int64 =
    var a: int64
    var b: int64
    var c: int64
    var i: int64
    while i < n:
        a = (a + i) & int64(1048575)
        b = (b ^ a) & int64(1048575)
        c = (c + b) & int64(1048575)
        i = i + 1
    return (a ^ b) ^ c

fn main(): int32 =
    return int32(hot(int64(5000)) & int64(127))
