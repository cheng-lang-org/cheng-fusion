# form: cstring literal passed as the NINTH call argument (past the 8-register
# window, so it travels as a STACK arg) -- exercises backend2 slice-3 leaf
# AppendCStringArgRelocs stack-arg arm (>= 9th arg, emit_ops:3673, cursor
# pos + argWords + 1) which no other corpus fixture reaches: sp25a and
# leafcov_cstring_multi only pass cstrings in register-arg positions. Part of
# the backend2 slice-3 leaf coverage battery. Linked against
# leafcov_cstring_stack_arg.stub.c (no main).
# expected runtime: take9(1..8, "abcd") = 1 + 8 + 4 = 13 -> main returns 0.
# observable: exit code.
@importc("leafcov_take9")
fn take9(a1: int32, a2: int32, a3: int32, a4: int32, a5: int32, a6: int32, a7: int32, a8: int32, p: ptr): int32

fn main(): int32 =
    if take9(1, 2, 3, 4, 5, 6, 7, 8, "abcd") != 13:
        return 1
    if take9(1, 2, 3, 4, 5, 6, 7, 8, "") != 9:
        return 2
    return 0
