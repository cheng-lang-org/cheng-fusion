# form: scalar u64 `(uint64(p->field) << n) | uint64(expr)` return — the exact
# Lane 3 program_support form3 shape (cheng_ffi_handle_register_ptr_export).
# The LHS is a uint32 field read THROUGH a pointer, widened to u64 and 64-bit
# left-shifted; the RHS is a u64 cast of int32 arithmetic. A 32-bit ALU on the
# shift, or a crude paren-as-call-surface bail, drops the high word.
# Verified against stage3 via the C stub (full 64-bit packed value check).
type
    PackSlot =
        pad: ptr
        generation: uint32
    PackSlotPtr = PackSlot *

@exportc("u64_pack_slot")
fn u64_pack_slot(p: ptr, idx: int32): int64 =
    let slot: PackSlotPtr = PackSlotPtr(p)
    return int64((uint64(slot->generation) << uint64(32)) | uint64(idx + 1))
