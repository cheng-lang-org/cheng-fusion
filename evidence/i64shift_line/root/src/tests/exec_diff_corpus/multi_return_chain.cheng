# form: a struct-returning function whose result is fed (field by field) into
# ANOTHER struct-returning function, chained, with the final aggregate
# destructured. observable: exit code. multi_return_tuple destructured one
# returned aggregate; this CHAINS them -- the sret/packed-reg result of call A
# becomes the argument source for call B, so the returned aggregate must be
# materialized into a readable slot before its fields are reloaded as the next
# call's args. A bug that reuses the sret buffer for the second call, or reloads
# a field from the wrong (overwritten) slot, diverges.
type
    Pair =
        lo: int32
        hi: int32
fn mk(a: int32, b: int32): Pair =
    return Pair(lo: a, hi: b)
fn combine(p: Pair): Pair =
    # swap-and-scale: new lo = old hi, new hi = old lo + old hi.
    return Pair(lo: p.hi, hi: p.lo + p.hi)
fn addPairs(p: Pair, q: Pair): Pair =
    return Pair(lo: p.lo + q.lo, hi: p.hi + q.hi)
fn main(): int32 =
    let a = mk(3, 7)
    if a.lo != 3:
        return 1
    if a.hi != 7:
        return 2
    # chain: combine(mk(3,7)) -> Pair(lo:7, hi:10).
    let b = combine(mk(3, 7))
    if b.lo != 7:
        return 3
    if b.hi != 10:
        return 4
    # double chain: combine(combine(mk(3,7))) -> combine(Pair(7,10)) ->
    #   Pair(lo:10, hi:17).
    let c = combine(combine(mk(3, 7)))
    if c.lo != 10:
        return 5
    if c.hi != 17:
        return 6
    # feed two returned aggregates into a third call.
    let d = addPairs(mk(1, 2), mk(10, 20))
    if d.lo != 11:
        return 7
    if d.hi != 22:
        return 8
    # nested: addPairs(combine(mk(3,7)), mk(1,1)) -> addPairs(Pair(7,10),Pair(1,1))
    #   -> Pair(8, 11).
    let e = addPairs(combine(mk(3, 7)), mk(1, 1))
    if e.lo != 8:
        return 9
    if e.hi != 11:
        return 10
    # sum every field across all results to force them all live at once.
    let total: int32 = a.lo + a.hi + b.lo + b.hi + c.lo + c.hi + d.lo + d.hi + e.lo + e.hi
    # 10 + 17 + 27 + 33 + 19 = 106.
    if total != 106:
        return 11
    return 0
