# form (net-audit r16): a 3x3 MATRIX stored row-major in a flat fixed array,
# filled by a nested i/j loop (`m[i*3+j] = ...`), then a transpose and a diagonal
# trace. r15_compound_subscript_assign_2d wrote a 2d grid with compound RMW; this
# computes a flattened index `i*N+j` (a multiply-add address) in BOTH the fill
# and the transpose (`t[j*3+i] = m[i*3+j]`), and sums the diagonal `m[i*3+i]`.
# Stresses: nested-loop linear-index address arithmetic (i*N+j) where the
# transpose swaps the i/j roles in the index expression, plus the diagonal's
# i*N+i. A mis-emitted index multiply or a clobbered outer-loop counter diverges.
# observable: exit code.
fn main(): int32 =
    var m: int32[9]
    var i: int32
    # fill m[i][j] = (i+1)*10 + (j+1): row-major.
    while i < 3:
        var j: int32
        while j < 3:
            m[i * 3 + j] = (i + 1) * 10 + (j + 1)
            j = j + 1
        i = i + 1
    # m = [11 12 13; 21 22 23; 31 32 33].
    if m[0] != 11:
        return 1
    if m[4] != 22:
        return 2
    if m[8] != 33:
        return 3
    if m[5] != 23:
        return 4
    if m[6] != 31:
        return 5
    # transpose into t: t[j][i] = m[i][j].
    var t: int32[9]
    var a: int32
    while a < 3:
        var b: int32
        while b < 3:
            t[b * 3 + a] = m[a * 3 + b]
            b = b + 1
        a = a + 1
    # t = [11 21 31; 12 22 32; 13 23 33].
    if t[1] != 21:
        return 6
    if t[3] != 12:
        return 7
    if t[7] != 23:
        return 8
    # diagonal unchanged by transpose: t[k*3+k] == m[k*3+k].
    var k: int32
    while k < 3:
        if t[k * 3 + k] != m[k * 3 + k]:
            return 9
        k = k + 1
    # trace = 11+22+33 = 66.
    var trace: int32
    var d: int32
    while d < 3:
        trace = trace + m[d * 3 + d]
        d = d + 1
    if trace != 66:
        return 10
    # full sum of all 9 cells = 11+12+13+21+22+23+31+32+33 = 198.
    var sum: int32
    var e: int32
    while e < 9:
        sum = sum + m[e]
        e = e + 1
    if sum != 198:
        return 11
    return 0
