# form (net-audit r15): a WHOLE-VALUE copy of a NESTED struct via an initializer
# binding `var b: Outer = a`, where Outer embeds an Inner struct (struct-in-
# struct, not a flat aggregate). aggregate_copy / r14_struct_bubble_sort copied
# FLAT structs or single fields; this copies a struct whose layout is
# [scalar id @0, embedded Inner{x,y} @4..]. Stresses: the codegen that lowers a
# value-copy of an aggregate with a NESTED aggregate field — it must copy the
# leading scalar AND the embedded struct's words (every machine word of the
# whole 12-byte object), then prove the copy is a real DEEP copy by mutating the
# source's nested field and confirming the destination is unaffected (no shared
# storage / aliasing). observable: exit code.
#
# DRIVER MISCOMPILE (blame=DRIVER, net-audit r15): driver returns rc=1
# (`b.id != 7`) while stage3 returns 0. otool on the driver's `_main` shows the
# `var b: Outer = a` initializer copy is ENTIRELY DROPPED — `a` is built at
# [sp,#0x80] (id=7 @0x80, x=10 @0x84, y=20 @0x88) but `b` at [sp,#0x90] is never
# written; the first read `ldr w10,[sp,#0x90]` loads stack garbage for b.id, so
# the b.id==7 check fails. stage3 emits the word-by-word copy from a's slots into
# b's slots (`ldr w1,[sp,a.id]; str w1,[sp,b.id]` + the embedded Inner's words).
# i.e. the nested-struct whole-value copy initializer lowers to zero stores on
# the driver. blame=DRIVER.
type
    Inner =
        x: int32
        y: int32
    Outer =
        id: int32
        inner: Inner
fn main(): int32 =
    var a: Outer
    a.id = 7
    a.inner.x = 10
    a.inner.y = 20
    # whole-value copy of a nested struct.
    var b: Outer = a
    if b.id != 7:
        return 1
    if b.inner.x != 10:
        return 2
    if b.inner.y != 20:
        return 3
    # DEEP copy: mutating the source must not touch the destination.
    a.id = 99
    a.inner.x = 88
    a.inner.y = 77
    if b.id != 7:
        return 4
    if b.inner.x != 10:
        return 5
    if b.inner.y != 20:
        return 6
    # and mutating the destination must not touch the source.
    b.inner.y = 555
    if a.inner.y != 77:
        return 7
    if b.inner.y != 555:
        return 8
    # a second copy from the (now mutated) source carries the new values.
    var c: Outer = a
    if c.id != 99:
        return 9
    if c.inner.x != 88:
        return 10
    if c.inner.y != 77:
        return 11
    # sum of c's words proves all three landed: 99+88+77 = 264.
    if c.id + c.inner.x + c.inner.y != 264:
        return 12
    return 0
