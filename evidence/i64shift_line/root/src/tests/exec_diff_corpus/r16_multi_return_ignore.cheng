# form (net-audit r16): a function returns a multi-field aggregate but the CALLER
# uses only SOME fields, discarding the rest — `let r = divmod(a,b); use r.q;
# (ignore r.r)`. r14_multi_return_contexts consumed EVERY field of the returned
# aggregate in many contexts; this deliberately reads a SUBSET, so the result
# slot must still be fully materialized (the unused field's lane must not corrupt
# the used one, and the sret/packed-reg path must not skip writing a field just
# because the caller never reads it). Stresses: partial consumption of a
# multi-field return — a bug that only writes the fields it thinks are live, or
# packs two fields into the same lane, surfaces when a later call reads the
# previously-ignored field. observable: exit code.
type DivMod =
    q: int32
    r: int32
fn divmod(a: int32, b: int32): DivMod =
    return DivMod(q: a / b, r: a % b)
type Stats =
    mn: int32
    mx: int32
    sum: int32
fn stats3(a: int32, b: int32, c: int32): Stats =
    var lo: int32 = a
    var hi: int32 = a
    if b < lo:
        lo = b
    if c < lo:
        lo = c
    if b > hi:
        hi = b
    if c > hi:
        hi = c
    return Stats(mn: lo, mx: hi, sum: a + b + c)
fn main(): int32 =
    # take only the quotient, ignore the remainder.
    let d1 = divmod(17, 5)
    if d1.q != 3:
        return 1
    # take only the remainder of a different call, ignore the quotient.
    let d2 = divmod(23, 7)
    if d2.r != 2:
        return 2
    # now read BOTH fields of an earlier-style call to prove the ignored lane was
    # still written correctly (q=3, r=2 for 17/5).
    let d3 = divmod(17, 5)
    if d3.q != 3:
        return 3
    if d3.r != 2:
        return 4
    # stats: use only mx from one call.
    let s1 = stats3(4, 9, 2)
    if s1.mx != 9:
        return 5
    # use only mn from another call.
    let s2 = stats3(7, 3, 8)
    if s2.mn != 3:
        return 6
    # use only sum from a third.
    let s3 = stats3(1, 2, 3)
    if s3.sum != 6:
        return 7
    # read all three fields of a fresh call: the previously-ignored fields are
    # intact (mn=2, mx=9, sum=15).
    let s4 = stats3(4, 9, 2)
    if s4.mn != 2:
        return 8
    if s4.mx != 9:
        return 9
    if s4.sum != 15:
        return 10
    # chained: feed only one field of a return into the next call, ignoring the
    # other. divmod(20,6) -> q=3; stats3(q, q, q).sum = 9.
    let dm = divmod(20, 6)
    let chained = stats3(dm.q, dm.q, dm.q)
    if chained.sum != 9:
        return 11
    if chained.mn != 3:
        return 12
    return 0
