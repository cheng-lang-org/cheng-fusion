# form: `root.dynSeqField[i].subField = value` store (G6/G7). The struct field
# `slots` is a DYNAMIC seq of structs (Slot[]), so the element storage lives
# behind the seq header's data pointer at fieldOffset+8, not inline. Storing a
# value into `b.slots[i].weight` (G6, plain int rhs) or `b.slots[i].flag`
# (G7, boolean `&&` rhs) needs: load the buffer pointer, scale the index by the
# element size, add the subfield offset, FieldStore. Before the fix this whole
# form fell to cold — the fixed-array element-address helper refused dynamic
# seqs (return -1), and the cmp-assign / field-meta paths bailed (711/717/718),
# dropping TypedExprIrSortStatementRange / TypedExprIrCompactForBackend (G6) and
# BodyIrAnalyzeOwnership (G7) to cold. observable: process exit code. main
# returns 0 on success, a distinct nonzero per failed sub-check. driver (node
# path) vs stage3 (cold) runtime exit code must agree.
type
    Slot =
        weight: int32
        flag: bool

type
    Box =
        slots: Slot[]

fn fill(b: var Box, refs: int32[]) =
    for i in 0..<b.slots.len:
        # G6: plain-int rhs stored into a dynamic-seq element subfield.
        b.slots[i].weight = refs[i] * 10
        # G7: boolean `&&` (comparison-bearing) rhs stored into a bool subfield.
        b.slots[i].flag = refs[i] >= 2 && refs[i] <= 4

fn main(): int32 =
    var b: Box
    var s0: Slot
    var s1: Slot
    var s2: Slot
    add(b.slots, s0)
    add(b.slots, s1)
    add(b.slots, s2)
    if b.slots.len != 3:
        return 1
    var refs: int32[]
    add(refs, 1)
    add(refs, 3)
    add(refs, 9)
    fill(b, refs)
    # weights: 1*10, 3*10, 9*10
    if b.slots[0].weight != 10:
        return 2
    if b.slots[1].weight != 30:
        return 3
    if b.slots[2].weight != 90:
        return 4
    # flags: (1 in [2,4])=false, (3 in [2,4])=true, (9 in [2,4])=false
    if b.slots[0].flag:
        return 5
    if !b.slots[1].flag:
        return 6
    if b.slots[2].flag:
        return 7
    return 0
