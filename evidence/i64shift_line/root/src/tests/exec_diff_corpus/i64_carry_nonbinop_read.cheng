# form: i64 accumulator loop where the carried slot is read by a NON-BinOp op
# (a Cmp: `if acc == 6`). Cmp loads acc from MEMORY (not R-redirected), so the
# 5c conservative gate MUST KEEP the eager store; dropping it would let the Cmp
# read the stale pre-header value. acc sums 0..n; when acc hits 6 exactly a flag
# is bumped. sum(0..6)=21; acc==6 happens once (0+1+2+3=6) -> hit=1.
fn sumWatch(n: int64): int64 =
    var acc: int64 = int64(0)
    var hit: int64 = int64(0)
    var i: int64 = int64(0)
    while i < n:
        let t: int64 = acc + i
        acc = t
        if acc == int64(6):
            hit = hit + int64(1)
        i = i + int64(1)
    return acc + (hit * int64(1000))
fn main(): int32 =
    let r: int64 = sumWatch(int64(7))
    if r != int64(1021):
        return 1
    return 0
