# form: Result[int64] roundtrip -- compact per-T layout instance (value@8 sz8,
# err.code@16, err.msg@24, total 48) that DIFFERS from legacy ResultStr* fixed
# constants. Any surviving fixed-layout projection consumer reads garbage here.
# Part of slice-6 Result acceptance net (S1). observable: exit code.
import std/result

fn wide(flag: bool): Result[int64] =
    if flag:
        return Ok[int64](int64(70000))
    return Err[int64]("neg")

fn main(): int32 =
    var r: Result[int64] = wide(true)
    if !IsOk(r):
        return 1
    let v: int64 = Value(r)
    if v != int64(70000):
        return 2
    var e: Result[int64] = wide(false)
    if IsOk(e):
        return 3
    let msg: str = Error(e)
    if Len(msg) != 3:
        return 4
    return 0
