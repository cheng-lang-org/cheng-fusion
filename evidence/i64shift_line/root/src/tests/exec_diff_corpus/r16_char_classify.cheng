# form (net-audit r16): CHARACTER CLASSIFICATION into categories — isDigit
# ('0'..'9'), isUpper ('A'..'Z'), isLower ('a'..'z'), isSpace (32/9/10), each a
# range/membership test returning 0/1, plus a classify() that folds them into a
# single category code. r15_char_case_convert ADJUSTED bytes by ±32; this only
# TESTS membership across SEVERAL disjoint ranges and a small explicit set
# (whitespace), then dispatches on which predicate fired. Stresses: multiple
# independent two-bound range comparisons, an OR-of-equals membership test (space
# / tab / newline), and an if/elif cascade selecting a category — a predicate
# whose ranges overlap or whose boundary is off-by-one diverges. observable:
# exit code.
#
# DRIVER MISCOMPILE (blame=DRIVER, net-audit r16): driver returns rc=16
# (`letters != 52` — the letter count is 0) while stage3 returns 0. Reduced: the
# letter-count loop `letters = letters + isUpper(d) + isLower(d)` (an assignment
# whose RHS is a multi-term sum of TWO calls accumulated into a loop-carried
# local) mis-stores the result. otool on the driver's `_main` shows the final sum
# at [sp,#0x38] is written to [sp,#0x28] (`str w9,[sp,#0x28]`) — a scratch slot —
# instead of the `letters` slot [sp,#0x18], which the loop-exit `ldr w0,[sp,#0x18]`
# reads, so `letters` stays 0. The fault is STACK-SLOT-ALLOCATION dependent on the
# local's NAME hash: renaming `letters`->`total`/`counter`/`result` makes the same
# code emit `str w9,[sp,#0x18]` and return 52, but `letters` and `lettersX` both
# collide and return 0. stage3 always stores to the real slot. blame=DRIVER (slot
# allocator collision for `var = var + f(x) + g(x)` accumulation).
fn isDigit(c: int32): int32 =
    if c >= 48:
        if c <= 57:
            return 1
    return 0
fn isUpper(c: int32): int32 =
    if c >= 65:
        if c <= 90:
            return 1
    return 0
fn isLower(c: int32): int32 =
    if c >= 97:
        if c <= 122:
            return 1
    return 0
fn isSpace(c: int32): int32 =
    if c == 32:
        return 1
    if c == 9:
        return 1
    if c == 10:
        return 1
    return 0
fn classify(c: int32): int32 =
    if isDigit(c) == 1:
        return 1
    if isUpper(c) == 1:
        return 2
    if isLower(c) == 1:
        return 3
    if isSpace(c) == 1:
        return 4
    return 0
fn main(): int32 =
    # digits.
    if classify(48) != 1:
        return 1
    if classify(57) != 1:
        return 2
    if isDigit(47) != 0:
        return 3
    if isDigit(58) != 0:
        return 4
    # upper / lower.
    if classify(65) != 2:
        return 5
    if classify(90) != 2:
        return 6
    if classify(97) != 3:
        return 7
    if classify(122) != 3:
        return 8
    # whitespace set members.
    if classify(32) != 4:
        return 9
    if classify(9) != 4:
        return 10
    if classify(10) != 4:
        return 11
    # a non-whitespace control char (13, CR) is NOT in the set -> category 0.
    if classify(13) != 0:
        return 12
    # punctuation '!' (33) -> 0.
    if classify(33) != 0:
        return 13
    # the predicates are mutually exclusive: a digit is not upper/lower/space.
    if isDigit(53) + isUpper(53) + isLower(53) + isSpace(53) != 1:
        return 14
    # count digits in the ASCII range 0..127 -> exactly 10.
    var c: int32
    var digits: int32
    while c < 128:
        digits = digits + isDigit(c)
        c = c + 1
    if digits != 10:
        return 15
    # count letters (upper+lower) -> 52.
    var d: int32
    var letters: int32
    while d < 128:
        letters = letters + isUpper(d) + isLower(d)
        d = d + 1
    if letters != 52:
        return 16
    return 0
