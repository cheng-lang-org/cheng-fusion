# form: chained field-arg -- a 2-level field chain `outer.inner.value` passed as
# a (non-first) call argument. The intermediate aggregate (`outer.inner`) must be
# materialized into a slot, then the leaf field loaded off that slot's address.
# Regression for the wcz chained-field-arg base-slot bug (the buf.storage.data /
# buf.data.data class): the synthetic intermediate slot name carries a '.', which
# the field/index guard in the base-slot resolver used to reject, dropping the
# whole function to cold (word-count-zero). observable: process exit code.
type
    Inner =
        value: int32
        pad: int32

    Outer =
        inner: Inner
        tag: int32

fn combine(base: int32, v: int32, scale: int32): int32 =
    return base + v * scale

fn run(o: var Outer): int32 =
    let a = combine(o.tag, o.inner.value, 3)
    return a

fn main(): int32 =
    var o: Outer
    o.inner.value = 7
    o.inner.pad = 99
    o.tag = 5
    let r = run(o)
    if r != 26:
        return 1
    return 0
