# Stage9 temp allocator KILLER-4 spill-around-call: a temp whose live range would span a function
# call (BL) MUST NOT live in a caller-saved pool reg (x13/x14/x15) — those are clobbered by the
# call. The block-clean gate disables the pool for any block containing a Call, so t spills to its
# stack slot and is reloaded after the call. Stage3 is the oracle.
fn side(x: int64): int64 =
    return (x + int64(100)) & int64(1048575)
fn acrossCall(a: int64, b: int64): int64 =
    let t: int64 = (a * b) & int64(1048575)
    let s: int64 = side(a)
    return (t + s) & int64(1048575)
fn main(): int32 =
    let r: int64 = acrossCall(int64(6), int64(7))
    # t=(42)&M=42 ; s=side(6)=106 ; (42+106)&M=148
    if r != int64(148):
        return 1
    return 0
