# form: THREE call-bearing ternaries summed inline in one expression --
#   (n>0 ? f(n) : 0) + (n>0 ? f(n) : 0) + (n>0 ? f(n) : 0)
# observable: exit code. Companion to ternary_call_add: same root-cause family
# (a live accumulator clobbered across a ternary-selected CALL), here with THREE
# operands and an identical condition, proving the bug is not 2-operand- or
# mixed-condition-specific.
#
# DRIVER MISCOMPILE (blame=DRIVER): the driver returns just the FIRST ternary's
# value (f(5)=6) instead of 6+6+6=18 -- the 2nd and 3rd call results are dropped
# from the sum. stage3 returns the correct 18. (driver self-check -> returns 1.)
fn f(x: int32): int32 =
    return x + 1
fn main(): int32 =
    let n: int32 = 5
    # each ternary selects f(5)=6 ; 6+6+6 = 18
    let r: int32 = (n > 0 ? f(n) : 0) + (n > 0 ? f(n) : 0) + (n > 0 ? f(n) : 0)
    if r != 18:
        return 1
    return 0
