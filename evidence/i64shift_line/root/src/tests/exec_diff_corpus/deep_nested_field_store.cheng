# form: store into a field three structs deep, then read back; sibling fields
# must be untouched. observable: exit code. Exercises nested field-address
# computation for both store and load (offset chaining).
type
    A =
        v: int32
        w: int32
    B =
        tag: int32
        a: A
    C =
        id: int32
        b: B
        tail: int32
fn main(): int32 =
    var c: C
    c.id = 1
    c.tail = 9
    c.b.tag = 2
    c.b.a.v = 7
    c.b.a.w = 11
    # mutate the deepest field through the chain.
    c.b.a.v = c.b.a.v + c.b.a.w
    if c.b.a.v != 18:
        return 1
    # siblings untouched.
    if c.id != 1:
        return 2
    if c.tail != 9:
        return 3
    if c.b.tag != 2:
        return 4
    if c.b.a.w != 11:
        return 5
    # write through one level, read another.
    c.b.tag = c.id + c.b.a.v
    if c.b.tag != 19:
        return 6
    return 0
