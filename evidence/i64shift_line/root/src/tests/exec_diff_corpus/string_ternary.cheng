# form: string-ternary -- Len(s) > 0 ? a : b ; cond-expr selecting a str value.
# observable: process exit code (derived from string lengths the ternary picks).
fn pick(s: str): str =
    return Len(s) > 0 ? s : "-"

fn classify(n: int32): str =
    return n > 0 ? "pos" : (n < 0 ? "neg" : "zero")

fn main(): int32 =
    let a = pick("hello")
    let b = pick("")
    if Len(a) != 5:
        return 1
    if Len(b) != 1:
        return 2
    if Len(classify(5)) != 3:        # "pos"
        return 3
    if Len(classify(0 - 3)) != 3:    # "neg"
        return 4
    if Len(classify(0)) != 4:        # "zero"
        return 5
    # combine into a single observable code
    return Len(a) + Len(b) + Len(classify(0))
