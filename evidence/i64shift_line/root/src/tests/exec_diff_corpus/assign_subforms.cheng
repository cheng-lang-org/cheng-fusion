# form: the assign subforms the NODE_EVAL_ONLY census reports as
#   node_path_skip / no_node (Lane 1). Each `lhs = rhs` re-assignment below is
#   a form AppendI32Assign lowers (returns true) but the census never claimed as
#   owned. This fixture write-then-reads-back EVERY such subform so a silent
#   miscompile (returned-true-but-wrong, H1) diverges driver-vs-stage3.
# observable: process exit code.

type
    Box =
        head: int32
        tail: int32

var gSel: int32 = 99

fn pick(): int32 =
    return 41

fn main(): int32 =
    # --- scalar ident RHS re-assign (lhs = ident) ---
    var entryIndex: int32 = 7
    var a: int32 = 5
    a = entryIndex
    if a != 7:
        return 1

    # --- scalar literal RHS re-assign (lhs = 1) ---
    a = 1
    if a != 1:
        return 2

    # --- indexed store, scalar-ident RHS (bucketTails[bucket] = entryIndex) ---
    var bucketTails: int32[]
    add(bucketTails, 0)
    add(bucketTails, 0)
    add(bucketTails, 0)
    let bucket = 2
    bucketTails[bucket] = entryIndex
    if bucketTails[2] != 7:
        return 3
    if bucketTails[0] != 0:
        return 4

    # --- indexed store, scalar literal RHS ---
    bucketTails[1] = 5
    if bucketTails[1] != 5:
        return 5

    # --- field store, scalar-ident RHS (plan.head = entryIndex) ---
    var box: Box
    box.head = entryIndex
    box.tail = 3
    if box.head != 7:
        return 6
    if box.tail != 3:
        return 7

    # --- assign RHS = arithmetic (no_node form: scan + 1) ---
    var scan: int32 = 10
    scan = scan + 1
    if scan != 11:
        return 8
    scan = scan * 2 + 1
    if scan != 23:
        return 9

    # --- assign RHS = bool comparison (os.GetEnv(...) == "1" form) ---
    var flag: bool = true
    flag = entryIndex == 7
    if !flag:
        return 10
    flag = entryIndex == 99
    if flag:
        return 11

    # --- assign RHS = call (lhs = call()) ---
    var c: int32 = 3
    c = pick()
    if c != 41:
        return 12

    # --- assign RHS = ternary (if X: A else: B) ---
    var t: int32 = 9
    t = if entryIndex == 7: 100 else: 200
    if t != 100:
        return 13
    t = if entryIndex == 99: 100 else: 200
    if t != 200:
        return 14

    # --- global scalar re-assign ---
    gSel = entryIndex
    if gSel != 7:
        return 15

    return 0
