# form: G1 seq-add through a mixed `.field`+`[idx]` chain target -- `add` whose seq
# argument is `lookup.buckets[bi].items` (a `.field`, then a MID-CHAIN `[idx]`,
# then a trailing `.field`). Mirrors the wcz victims ParserTextLookupInsertKey and
# ParserSourcePathIndexLookupInsertExact (`add(lookup.buckets[bucketIndex].items,
# value)`) and the constructor variant CompilerCsgImportPairLookupInsert
# (`add(lookup.buckets[bi].items, Pair(...))`).
#
# Before the fix PrimaryBodyIrResolveSeqRootHeader could only walk a DOTTED-only
# field path and accumulate a fixed offset off the root slot; a mid-chain `[idx]`
# segment (which needs pointer indirection through the seq header) made it bail
# and the host function dropped to cold (word-count-zero). The shared
# PrimaryBodyIrIndexedMemberAddressSlot primitive now materializes the element's
# seq-header ADDRESS (header indirection + Madd) and the grow lands in place.
#
# The driver lowers this correctly; the stage3 cold reference miscompiles the
# nested in-place grow (loses the inserts), so exec_diff classifies this as a
# REFERENCE (oracle) miscompile with the DRIVER clean -- the driver-gate passes.
# observable: process exit code (the driver's CORRECT result is 0).
type
    Pair =
        owner: int32
        target: int32

    PairBucket =
        items: Pair[]

    PairLookup =
        buckets: PairBucket[]

    Bucket =
        items: int32[]

    Cursor =
        bucketIndex: int32

    Lookup =
        buckets: Bucket[]

# (1) scalar element via a `.field[idx].field` seq target, with the bucket index
# itself a `.field` chain (`cur.bucketIndex`).
fn insertValue(lookup: var Lookup, cur: Cursor, value: int32): bool =
    add(lookup.buckets[cur.bucketIndex].items, value)
    return true

# (2) aggregate constructor element via a `.field[idx].field` seq target.
fn insertPair(lookup: var PairLookup, bi: int32, o: int32, t: int32): bool =
    add(lookup.buckets[bi].items, Pair(owner: o, target: t))
    return true

fn main(): int32 =
    var lookup: Lookup
    var b0: Bucket
    var b1: Bucket
    add(lookup.buckets, b0)
    add(lookup.buckets, b1)
    var cur: Cursor
    cur.bucketIndex = 1
    let _ = insertValue(lookup, cur, 42)
    let _2 = insertValue(lookup, cur, 43)
    if lookup.buckets[1].items.len != 2:
        return 1
    if lookup.buckets[0].items.len != 0:
        return 2
    if lookup.buckets[1].items[0] != 42:
        return 3
    if lookup.buckets[1].items[1] != 43:
        return 4

    var plookup: PairLookup
    var pb0: PairBucket
    var pb1: PairBucket
    add(plookup.buckets, pb0)
    add(plookup.buckets, pb1)
    let _3 = insertPair(plookup, 1, 7, 8)
    let _4 = insertPair(plookup, 1, 9, 10)
    if plookup.buckets[1].items.len != 2:
        return 5
    if plookup.buckets[1].items[0].owner != 7:
        return 6
    if plookup.buckets[1].items[1].target != 10:
        return 7
    if plookup.buckets[0].items.len != 0:
        return 8
    return 0
