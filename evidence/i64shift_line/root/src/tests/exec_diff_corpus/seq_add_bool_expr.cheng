# form: add(seq, <bool comparison expr>) -- bool[] element from a relational
# expression as the add() value arg. Mirrors compiler_csg
#   add(set.exportNameExplicitFlags, decl.explicitExportName.len > 0)
# Before the fix the general seq-add lowering routed the bool value text through
# the scalar parser (PrimaryBodyIrScalarValueSlotForText), which has no
# comparison-operator support, so it returned <0 -> bail_631 (whole function ->
# cold). The fix materializes the comparison via PrimaryBodyIrCondValue01Slot so
# the element store gets a real 0/1 value on the node path.
type
    Flags =
        items: bool[]

fn build(n: int32): Flags =
    var f: Flags
    add(f.items, n > 0)
    add(f.items, n < 0)
    add(f.items, n == 0)
    return f

fn main(): int32 =
    let f = build(5)
    if f.items.len != 3:
        return 1
    # n=5 : (5>0)=true, (5<0)=false, (5==0)=false
    if !f.items[0]:
        return 2
    if f.items[1]:
        return 3
    if f.items[2]:
        return 4
    # standalone bare seq too
    var bs: bool[]
    let k: int32 = 7
    add(bs, k >= 7)
    add(bs, k < 7)
    if !bs[0]:
        return 5
    if bs[1]:
        return 6
    return 0
