# form: a `let` inside a for-range loop whose initializer is binary arithmetic
# over the induction variable (`let scan = stop - offset`), then the bound local
# is used as a string byte index (`text[scan]`) and as a call argument. Before
# the fix the binary-op binding-type inference could not type an operand that was
# the loop induction variable, so the whole let-decl was silently dropped
# (binding type empty -> statement skipped). The dropped `let scan` then made
# `text[scan]` unresolvable (build_word_count_zero) and lost the value entirely.
# The fix lets binary-op operand typing recognize a bare for-range loop variable
# as int32. Exit code is the observable; driver must match the stage3 oracle.

fn IsLower(c: char): bool =
    return c >= 'a' && c <= 'z'

# scan backward from `stop` using `stop - offset`; return the 1-based position of
# the first non-lowercase byte at-or-before stop, else 0.
fn FirstNonLowerFromEnd(text: str, stop: int32): int32 =
    var result = 0
    for offset in 0..stop:
        let scan = stop - offset
        if !IsLower(text[scan]):
            result = scan + 1
            break
    return result

# same shape but the arithmetic feeds the index directly in the call arg.
fn CountLowerPrefix(text: str, stop: int32): int32 =
    var count = 0
    for offset in 0..stop:
        let scan = stop - offset
        if IsLower(text[scan]):
            count = count + 1
    return count

fn main(): int32 =
    # "ab9cd", stop=4: offsets 0..4 -> scan 4,3,2,1,0 = 'd','c','9','b','a'.
    # first non-lower scanning from end is '9' at index 2 -> result = 3.
    if FirstNonLowerFromEnd("ab9cd", 4) != 3:
        return 1
    # "abcde", stop=4: no non-lower -> result stays 0.
    if FirstNonLowerFromEnd("abcde", 4) != 0:
        return 2
    # "ab9cd", stop=4: lower bytes among {a,b,9,c,d} = 4.
    if CountLowerPrefix("ab9cd", 4) != 4:
        return 3
    # "abcde", stop=4: all 5 lower.
    if CountLowerPrefix("abcde", 4) != 5:
        return 4
    return 0
