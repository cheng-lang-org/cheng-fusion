# form: passing a seq (and a 2-level/jagged seq-of-seq) as a function parameter
# and indexing it inside the callee. observable: exit code. Exercises seq-by-ref
# parameter passing where the callee reads elements and an inner seq's elements
# and .len. A miscompile in the seq header passing (ptr+len) or the nested index
# (outer[i] then inner[j]) diverges from the known sums.
fn sumRow(row: int32[]): int32 =
    var s: int32
    var i: int32
    while i < row.len:
        s = s + row[i]
        i = i + 1
    return s
fn sumGrid(grid: int32[][]): int32 =
    var total: int32
    var i: int32
    while i < grid.len:
        total = total + sumRow(grid[i])
        i = i + 1
    return total
fn maxOf(row: int32[]): int32 =
    var m: int32 = row[0]
    var i: int32 = 1
    while i < row.len:
        if row[i] > m:
            m = row[i]
        i = i + 1
    return m
fn main(): int32 =
    var a: int32[]
    setLen(a, 3)
    a[0] = 1
    a[1] = 2
    a[2] = 3
    if sumRow(a) != 6:
        return 1
    if maxOf(a) != 3:
        return 2
    var b: int32[]
    setLen(b, 2)
    b[0] = 10
    b[1] = 40
    if sumRow(b) != 50:
        return 3
    if maxOf(b) != 40:
        return 4
    # jagged grid: rows of different lengths
    var grid: int32[][]
    setLen(grid, 2)
    grid[0] = a
    grid[1] = b
    if sumGrid(grid) != 56:
        return 5
    if grid[0].len != 3:
        return 6
    if grid[1].len != 2:
        return 7
    if grid[1][1] != 40:
        return 8
    return 0
