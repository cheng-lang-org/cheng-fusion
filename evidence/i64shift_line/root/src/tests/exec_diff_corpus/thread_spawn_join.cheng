# form: thread / spawn-join -- minimal deterministic StartPtr + Join: two
# workers each atomic-add 1 to a shared counter, main joins BOTH handles
# before reading, so the post-join value 2 is race-free and fully determined.
# API usage copied from src/tests/thread_join_pool_runtime_smoke.cheng
# (CounterCtx ref carrying an atomic.I32, worker cast from raw ptr).
# observable: exit code.
# expected runtime: rc 0.
import std/atomic
import std/thread

type
    CounterCtx = ref object
        counter: atomic.I32

fn JoinWorker(raw: ptr) =
    let ctx: CounterCtx = CounterCtx(raw)
    let _ = atomic.AddI32(ctx.counter, 1)

fn main(): int32 =
    let counter = atomic.NewI32(0)
    if counter == nil:
        return 1
    let counterCtx = new(CounterCtx)
    if counterCtx == nil:
        return 2
    counterCtx.counter = counter
    let counterRaw: ptr = &counterCtx.counter
    let h0 = thread.StartPtr(&JoinWorker, counterRaw)
    let h1 = thread.StartPtr(&JoinWorker, counterRaw)
    if !thread.JoinThread(h0):
        return 3
    if !thread.JoinThread(h1):
        return 4
    if atomic.LoadI32(counter) != 2:
        return 5
    return 0
