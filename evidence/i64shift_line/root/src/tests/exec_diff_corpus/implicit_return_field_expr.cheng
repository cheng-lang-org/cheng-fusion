# form: implicit_return_field_expr -- a non-void function whose body is a single
# bare value-expression on the indented line after `fn f(...): T =` (no `return`
# keyword). Cheng's trailing-expression-is-return rule applies, but the typed-IR
# indented-body walk used to classify that bare expression as `Unsupported`
# (only the same-line `= <expr>` form was folded), driving the function to cold
# (build_word_count_zero bail_64). This fixture exercises the three observed
# shapes: bare scalar field load, bare wide field load, and field-load-then-arith.
# observable: process exit code. main returns 0 on success, a distinct nonzero
# code per failed sub-check. The diff net compares driver vs stage3 exit codes;
# divergence == latent miscompile of the implicit-return fold.
type
    Bytes =
        data: ptr
        len: int32

    Duration =
        ns: int64

    DateTime =
        unix: int64
        nanosecond: int32

fn BytesLen(b: Bytes): int32 =
    b.len

fn durMillis(d: Duration): int64 =
    d.ns / 1000000

fn dtUnix(t: DateTime): int64 =
    t.unix

fn main(): int32 =
    var b: Bytes
    b.len = 37
    if BytesLen(b) != 37:
        return 1

    var d: Duration
    d.ns = 5000000
    if durMillis(d) != 5:
        return 2

    var t: DateTime
    t.unix = 1718000000
    if dtUnix(t) != 1718000000:
        return 3

    # second values confirm the implicit-return functions are re-callable and
    # resolve distinct field offsets (not collapsed to a shared slot).
    b.len = 9
    if BytesLen(b) != 9:
        return 4
    d.ns = 12000000
    if durMillis(d) != 12:
        return 5
    t.unix = 42
    if dtUnix(t) != 42:
        return 6
    return 0
