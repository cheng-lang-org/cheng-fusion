# form: 32-bit rotate-left / rotate-right built from shifts + OR + mask, on a
# uint32. observable: via C stub (full 32-bit value). bit_combo_expr packed
# &|^<<>> but never composed a rotate (shift two ways and OR the wrapped bits);
# rotl(x,n) = (x << n) | (x >> (32-n)) needs BOTH a logical-left and a
# LOGICAL-right shift of the SAME live value, then OR — a 32-bit-width-sensitive
# combination. A bug that sign-extends the right shift (arithmetic vs logical) or
# drops a live operand across the two shifts corrupts the wrapped bits.
#
# REFERENCE (stage3) MISCOMPILE (blame=REFERENCE, net-audit r12): the DRIVER is
# clean (bit_rotate OK on every case). stage3 mis-lowers `rotl(0x80000001, 1)`:
# it yields 0xffffffff instead of the correct 0x00000003 — the uint32 `>> (32-n)`
# is lowered as an ARITHMETIC (sign-extending) shift rather than a LOGICAL one,
# so the high bit smears. This is an ORACLE bug, not a driver-gate failure.
@exportc("rotl32")
fn rotl32(x: uint32, n: uint32): uint32 =
    # n assumed 1..31. (x << n) | (x >> (32-n))
    return (x << n) | (x >> (uint32(32) - n))

@exportc("rotr32")
fn rotr32(x: uint32, n: uint32): uint32 =
    return (x >> n) | (x << (uint32(32) - n))

@exportc("rotl_compose")
fn rotl_compose(x: uint32): uint32 =
    # rotate left by 8 three times == rotate left by 24.
    let a: uint32 = rotl32(x, uint32(8))
    let b: uint32 = rotl32(a, uint32(8))
    return rotl32(b, uint32(8))
