# form: struct-FIELD array element store `box.cells[idx] = v` whose SUBSCRIPT is
# resolved by the node-eval path (typed_expr assignIndexNodeIndex) after phase-2
# deleted the from-text indexed-field-store subscript resolution (plain
# ScalarValueSlotForText i32 + Context field-read fallback) in
# PrimaryBodyIrAppendI32Assign:29298. Covers the flat-subscript families the two
# deleted text dispatches handled:
#   * struct field-read index   box.cells[blk.termIndex]   (the Context-only form)
#   * plain variable index      box.cells[i]
#   * arithmetic index          box.cells[i + 1]
#   * const index               box.cells[0]
# observable: process exit code. A miscompiled subscript writes the wrong cell;
# the read-backs below flip the exit code. Self-asserting (returns 0 on success).
# (the field-read-index form is bailed by the stage3 cold oracle — context-free
#  text resolver returns -1 -> 717 — so under exec_diff this fixture surfaces as a
#  SKIP/REFERENCE on the oracle side; the pure driver compiles it correctly.)
type
    Blk =
        termIndex: int32
        pad: int32

    Box =
        cells: int32[6]

fn run(): int32 =
    var box: Box
    var blk: Blk
    blk.termIndex = 3
    blk.pad = 0

    # --- struct field-read index (box.cells[blk.termIndex]) ---
    box.cells[blk.termIndex] = 7
    if box.cells[3] != 7:
        return 1

    # --- plain variable index ---
    let i = 1
    box.cells[i] = 5
    if box.cells[1] != 5:
        return 2

    # --- arithmetic index ---
    box.cells[i + 1] = 9
    if box.cells[2] != 9:
        return 3

    # --- const index ---
    box.cells[0] = 4
    if box.cells[0] != 4:
        return 4

    # --- untouched cell stays zero ---
    if box.cells[5] != 0:
        return 5

    return 0

fn main(): int32 =
    return run()
