# form: constructor-literal-to-local -- `let o = Type(field: v, agg: Inner(...))`
# with a scalar field + an aggregate (nested constructor) field.
# observable: process exit code. main returns 0 iff every field reads back
# correctly; a distinct nonzero code identifies the first wrong field. Because
# the fixture self-asserts (0 == correct), a divergence is attributable: the
# side returning nonzero is the miscompiling one.
#
# Current result: driver returns nonzero (fields not written by the node-path
# constructor lowering) while stage3 returns 0 -> a latent DRIVER (pure node
# path) miscompile of the constructor-literal-to-local form. Same H1 class as
# Wave D bail_715: compiles clean (selfhost_direct, no SKIP) but value-wrong.
type
    Inner =
        lo: int32
        hi: int32

    Outer =
        tag: int32
        inner: Inner
        scale: int32

fn main(): int32 =
    let o = Outer(tag: 7, inner: Inner(lo: 11, hi: 22), scale: 3)
    if o.tag != 7:
        return 1
    if o.inner.lo != 11:
        return 2
    if o.inner.hi != 22:
        return 3
    if o.scale != 3:
        return 4
    return 0
