import std/result as stdresult

fn mayFail(x: int32): Result[int32] =
    if x < 0:
        return Err[int32]("neg")
    return Ok[int32](x * 2)

fn checkIsErr(r: var Result[int32]): bool =
    return IsErr(r)

fn callerCheck(x: int32): bool =
    var r: Result[int32] = mayFail(x)
    return checkIsErr(r)

fn main(): int32 =
    if !callerCheck(-1):
        return 1
    if callerCheck(5):
        return 2
    return 0
