# isolate: does returning a 3xint32 struct by value (sret) copy the right size?
type
    Row =
        a: int32
        b: int32
        c: int32

fn cloneRow(e: Row): Row =
    var out: Row
    out.a = e.a + 1
    out.b = e.b + 2
    out.c = e.c + 3
    return out

fn main(): int32 =
    var e0: Row
    e0.a = 10
    e0.b = 20
    e0.c = 30
    let r = cloneRow(e0)
    if r.a != 11:
        return 1
    if r.b != 22:
        return 2
    if r.c != 33:
        return 3
    return 0
