# form (#53): a function builds a seq with add() inside a while loop, RETURNS
# the seq (return value is a seq header), and the CALLER reads back elements and
# .len of the returned seq. observable: process exit code.
#   doubleAll(src) returns a fresh seq where out[i] = src[i]*2, built by a while
#   loop calling add(out, ...). The caller then reads d[0], d[1], d.len.
# A miscompile in the seq-return-value ABI (returned header ptr+len not passed
# correctly) OR the caller computing the element address of the returned seq
# wrongly diverges driver-vs-stage3.
fn doubleAll(src: int32[]): int32[] =
    var out: int32[]
    var i: int32
    while i < src.len:
        add(out, src[i] * 2)
        i = i + 1
    return out

fn sumAll(src: int32[]): int32[] =
    var out: int32[]
    var acc: int32
    var i: int32
    while i < src.len:
        acc = acc + src[i]
        add(out, acc)
        i = i + 1
    return out

fn main(): int32 =
    var s: int32[]
    add(s, 5)
    add(s, 7)
    add(s, 9)

    # --- returned-seq element reads (the #53 form) ---
    let d = doubleAll(s)
    if d.len != 3:
        return 1
    if d[0] != 10:
        return 2
    if d[1] != 14:
        return 3
    if d[2] != 18:
        return 4

    # --- a second returned seq (running prefix sum) to exercise reuse ---
    let p = sumAll(s)
    if p.len != 3:
        return 5
    if p[0] != 5:
        return 6
    if p[1] != 12:
        return 7
    if p[2] != 21:
        return 8

    # --- read returned seq through an intermediate index expression ---
    var idx: int32 = 1
    if d[idx] != 14:
        return 9
    idx = idx + 1
    if d[idx] != 18:
        return 10

    # --- sum the whole returned seq in a loop ---
    var total: int32
    var j: int32
    while j < d.len:
        total = total + d[j]
        j = j + 1
    if total != 42:
        return 11

    return 0
