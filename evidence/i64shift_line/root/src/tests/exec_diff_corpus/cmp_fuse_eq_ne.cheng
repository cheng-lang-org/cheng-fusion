# form: integer == and != compares feeding `if` conditions via the node-eval
# path. Stage 10 fusion emits `cmp; b.eq`/`cmp; b.ne` with no bool round-trip.
# Exercises the eq/ne cond-code (EQ=0, NE=1) and the true/false-target polarity
# (LocalNonZero branches-true -> trueBlock). Stage3 oracle parity required.
fn tally(n: int64): int64 =
    var acc: int64 = int64(0)
    var i: int64 = int64(0)
    while i < n:
        if i == int64(4):
            acc = acc + int64(100)
        if i != int64(2):
            acc = acc + int64(1)
        i = i + int64(1)
    return acc
fn main(): int32 =
    # i in 0..6 : i==4 once -> +100 ; i!=2 for 5 of 6 -> +5 ; total = 105
    let r: int64 = tally(int64(6))
    if r != int64(105):
        return 1
    return 0
