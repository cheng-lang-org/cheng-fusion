# form: ctor-str-literal-field -- aggregate constructor / bare struct return with a
# string-literal field value (error: "" / error: "boom") alongside another str field.
# observable: process exit code (runtime str length confirms the literal materialized).
type
    JP =
        text: str
        pos: int32
        length: int32
        error: str

fn mk(t: str): JP =
    return JP(text: t, pos: 0, length: 7, error: "")

fn mkErr(t: str): JP =
    return JP(text: t, pos: 1, length: 0, error: "boom")

fn main(): int32 =
    let p = mk("hello")
    if p.pos != 0:
        return 1
    if p.length != 7:
        return 2
    if len(p.text) != 5:
        return 3
    if len(p.error) != 0:
        return 4
    let e = mkErr("x")
    if e.pos != 1:
        return 5
    if len(e.error) != 4:
        return 6
    if len(e.text) != 1:
        return 7
    return 0
