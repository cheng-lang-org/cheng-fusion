# form: a compile-time-ZERO uint32 local fed into a PARENTHESIZED shift
# `(g << uint32(N))`, then OR-combined. observable: exit code.
#
# DRIVER MISCOMPILE (blame=DRIVER): the driver allocates a stack slot for the
# zero local but never stores 0 into it (the zero-init write is elided), then
# `ldr w9,[sp,#g]; lsl w9,w9,#N` reads uninitialized stack garbage and shifts
# it — returning a nondeterministic value (observed 0x3770.., 0xDD50.., 0x6C37..)
# instead of 0. stage3 returns the correct 0. Minimal otool evidence: the
# `mov #0 / str` that should initialize [sp,#g] is missing on the driver side.
# Reduced from bitpack_struct (pack with a zero color channel).
fn packMid(hi: uint32, mid: uint32, lo: uint32): uint32 =
    return (hi << uint32(24)) | (mid << uint32(16)) | (lo << uint32(8))
fn zeroMidConst(): uint32 =
    let mid: uint32 = uint32(0x00)
    return (mid << uint32(16))
fn main(): int32 =
    # const-zero local shifted in parens must be 0.
    if zeroMidConst() != uint32(0):
        return 1
    # const-folded call args: middle channel 0 -> 0xFF00FF00.
    let w = packMid(uint32(0xFF), uint32(0x00), uint32(0xFF))
    if w != uint32(0xFF00FF00):
        return 2
    # nonzero middle still correct (control: must always pass).
    let w2 = packMid(uint32(0xFF), uint32(0x11), uint32(0xFF))
    if w2 != uint32(0xFF11FF00):
        return 3
    return 0
