# form: mixed signed/unsigned narrowing-wrap across the widths cold supports
# (int32/int64/uint32/uint64). observable: exit code. Exercises i64->u32
# truncation (keep low 32 bits), unsigned reinterpret of a negative, and the
# composition of several casts feeding one arithmetic expression. cast_chain
# covered i32<->i64 widening only; this adds the unsigned truncation-wrap forms.
fn main(): int32 =
    # i64 narrowed to u32 keeps only the low 32 bits.
    let big: int64 = int64(0x1_0000_0080)
    let asU32: uint32 = uint32(big)
    if asU32 != uint32(0x80):
        return 1
    # u32 widened back to i32 is the masked value.
    if int32(asU32) != 128:
        return 2
    # signed -1 narrowed to i32 stays -1.
    let neg: int64 = int64(0 - 1)
    if int32(neg) != (0 - 1):
        return 3
    # -1 reinterpreted unsigned u32 is all-ones.
    if uint32(neg) != uint32(0xFFFFFFFF):
        return 4
    # u64 holding > i32 range narrowed to u32.
    let u64v: uint64 = uint64(0xDEADBEEF_CAFEBABE)
    if uint32(u64v) != uint32(0xCAFEBABE):
        return 5
    # mixed expression: widen u32 to i64, add i64, narrow result to i32.
    let s: int64 = int64(asU32) + int64(u64v) + int64(1000)
    # 128 + 0xDEADBEEFCAFEBABE(as signed i64) + 1000
    let lo: int32 = int32(s)
    # low 32 bits of (0xCAFEBABE + 128 + 1000) = 0xCAFEBABE + 1128.
    let expect: int32 = int32(uint32(0xCAFEBABE) + uint32(1128))
    if lo != expect:
        return 6
    # double narrow chain i64 -> u32 -> i32 round-trips the low word.
    let v64: int64 = int64(0x1234_5678_9ABC_DEF0)
    let v32u: uint32 = uint32(v64)
    if v32u != uint32(0x9ABCDEF0):
        return 7
    if int32(v32u) != int32(uint32(0x9ABCDEF0)):
        return 8
    return 0
