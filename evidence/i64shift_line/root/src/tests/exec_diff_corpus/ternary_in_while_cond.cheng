# form: a ternary (`cond ? a : b`) used INSIDE a while-loop condition, so the
# select feeds the loop's branch test each iteration. observable: exit code.
# chained_ternary_arith/mixed_ternary_sum used ternaries in value position;
# here the ternary result IS the loop predicate, exercising the ternary lowering
# on the loop back-edge (the select must be re-evaluated every iteration, not
# hoisted/cached). A bug that evaluates the ternary once (or caches the wrong
# arm) either never enters or never exits the loop -> divergent exit/timeout.
fn main(): int32 =
    # 1) loop bound chosen by a ternary on a flag; flag stays constant so the
    #    bound is stable, but the select runs each iteration.
    let tight: bool = true
    var i: int32
    var cnt: int32
    while (i < (tight ? 3 : 100)):
        cnt = cnt + 1
        i = i + 1
    if cnt != 3:
        return 1

    # 2) ternary picks the comparison VALUE from the loop var itself, so the
    #    bound effectively changes as the loop progresses. Loop while
    #    i < (i < 2 ? 10 : 5): i=0,1 -> bound10 (continue); i=2,3,4 -> bound5
    #    (continue until i==5 fails 5<5). So runs for i=0..4 -> 5 iters.
    i = 0
    cnt = 0
    while (i < (i < 2 ? 10 : 5)):
        cnt = cnt + 1
        i = i + 1
    if cnt != 5:
        return 2

    # 3) nested ternary in the condition combined with an && on a second clause.
    var sum: int32
    var j: int32
    let cap: int32 = 4
    while ((j < (cap > 0 ? cap : 0)) && (j != 99)):
        sum = sum + j
        j = j + 1
    if sum != 6:        # 0+1+2+3
        return 3

    # 4) ternary whose arms are both runtime expressions in the cond.
    var a: int32
    var lo: int32 = 2
    var hi: int32 = 5
    var iters: int32
    while (a < (a % 2 == 0 ? hi : lo)):
        a = a + 1
        iters = iters + 1
    # a=0(even)->bound5; a=1(odd)->bound2 but 1<2 ok; a=2(even)->5; a=3(odd)->2,
    # 3<2 false -> stop. iters: a went 0,1,2 then stopped at a=3. -> 3 iters.
    if iters != 3:
        return 4
    return 0
