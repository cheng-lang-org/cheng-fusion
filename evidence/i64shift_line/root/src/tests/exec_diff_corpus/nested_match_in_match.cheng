# form: a match arm BODY contains a nested match (match-in-match, #44). the
# outer match dispatches on `op`; INSIDE one arm a second match dispatches on
# `sg`. observable: exit code. stresses the match→if/elif rewrite (Wave W) doing
# the arm-suite recursion: the inner match's case arms must scan back to the
# INNER match's scrutinee (`sg`), not the outer match's (`op`). cold stage3 is
# the oracle.
type Op = enum
    Add
    Sub
type Sign = enum
    Pos
    Neg
fn apply(op: Op, sg: Sign, a: int32, b: int32): int32 =
    var out: int32
    out = 0
    match op:
        Add =>
            match sg:
                Pos => out = a + b
                Neg => out = 0 - (a + b)
        Sub =>
            match sg:
                Pos => out = a - b
                Neg => out = 0 - (a - b)
    return out
fn main(): int32 =
    if apply(Op.Add, Sign.Pos, 3, 4) != 7:
        return 1
    if apply(Op.Add, Sign.Neg, 3, 4) != (0 - 7):
        return 2
    if apply(Op.Sub, Sign.Pos, 10, 3) != 7:
        return 3
    if apply(Op.Sub, Sign.Neg, 10, 3) != (0 - 7):
        return 4
    return 0
