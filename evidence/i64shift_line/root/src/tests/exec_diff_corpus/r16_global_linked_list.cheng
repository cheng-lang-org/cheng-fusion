# form (net-audit r16): an array-backed LINKED LIST in global state — two
# parallel global seqs, `gVal[i]` (payload) and `gNext[i]` (the index of the next
# node, -1 = end). Traversal follows `cur = gNext[cur]` from a global `gHead`.
# r15_global_array_selection_sort sorted a global seq by position; this follows a
# POINTER-CHAIN encoded as indices, where the next index to read is loaded from
# the array itself (data-dependent indirection), and an insert-at-head rewires
# gHead and the new node's next. Stresses: a load whose result feeds the next
# iteration's index (`cur = gNext[cur]`), the -1 sentinel terminating the walk,
# and global head/next rewiring surviving across calls. observable: exit code.
# (NOTE: globals zero-init regardless of a `= expr` initializer in this backend,
# so gHead is set to the -1 empty-list sentinel explicitly in main before any
# push — relying on a non-zero global initializer would start the list with a
# self-pointing head.)
var gVal: int32[] = []
var gNext: int32[] = []
var gHead: int32

fn pushFront(v: int32): void =
    let idx: int32 = gVal.len
    add(gVal, v)
    add(gNext, gHead)
    gHead = idx

fn sumList(): int32 =
    var s: int32
    var cur: int32 = gHead
    while cur != (0 - 1):
        s = s + gVal[cur]
        cur = gNext[cur]
    return s

fn countList(): int32 =
    var c: int32
    var cur: int32 = gHead
    while cur != (0 - 1):
        c = c + 1
        cur = gNext[cur]
    return c

fn nth(k: int32): int32 =
    var cur: int32 = gHead
    var i: int32
    while i < k:
        cur = gNext[cur]
        i = i + 1
    return gVal[cur]

fn main(): int32 =
    # empty-list sentinel: head = -1 before any node exists.
    gHead = 0 - 1
    # push 10, 20, 30 at front -> list order is 30 -> 20 -> 10.
    pushFront(10)
    pushFront(20)
    pushFront(30)
    if countList() != 3:
        return 1
    # head node is the last pushed (30).
    if nth(0) != 30:
        return 2
    if nth(1) != 20:
        return 3
    if nth(2) != 10:
        return 4
    # sum follows the whole chain: 30+20+10 = 60.
    if sumList() != 60:
        return 5
    # push two more -> 50 -> 40 -> 30 -> 20 -> 10.
    pushFront(40)
    pushFront(50)
    if countList() != 5:
        return 6
    if nth(0) != 50:
        return 7
    if nth(4) != 10:
        return 8
    if sumList() != 150:
        return 9
    # the head index points at a node whose next eventually reaches -1 (no cycle):
    # walking exactly countList() steps lands on the sentinel.
    var cur: int32 = gHead
    var steps: int32
    while cur != (0 - 1):
        cur = gNext[cur]
        steps = steps + 1
    if steps != 5:
        return 10
    return 0
