# form: structural equality of aggregates computed field-by-field, including a
# helper that returns a bool by &&-chaining every field compare, and equality
# that must be FALSE when exactly one field differs. observable: exit code.
# aggregate_copy checked value-copy; this checks the COMPARE path (loading every
# field of two aggregates and &&-folding the equalities), where a miscompiled
# field load or short-circuit gives a wrong verdict.
type Point =
    x: int32
    y: int32
    z: int32
fn eq(a: Point, b: Point): bool =
    return a.x == b.x && a.y == b.y && a.z == b.z
fn main(): int32 =
    let p = Point(x: 1, y: 2, z: 3)
    let q = Point(x: 1, y: 2, z: 3)
    let r = Point(x: 1, y: 9, z: 3)
    # identical aggregates compare equal.
    if !eq(p, q):
        return 1
    # one differing field -> not equal.
    if eq(p, r):
        return 2
    # differ in first field only.
    let s = Point(x: 0, y: 2, z: 3)
    if eq(p, s):
        return 3
    # differ in last field only.
    let t = Point(x: 1, y: 2, z: 0)
    if eq(p, t):
        return 4
    # self-equality.
    if !eq(p, p):
        return 5
    # inline field-wise comparison (not via helper) to exercise both paths.
    var alleq: bool = true
    if p.x != q.x:
        alleq = false
    if p.y != q.y:
        alleq = false
    if p.z != q.z:
        alleq = false
    if !alleq:
        return 6
    # count matching fields between p and r (should be 2).
    var matches: int32
    if p.x == r.x:
        matches = matches + 1
    if p.y == r.y:
        matches = matches + 1
    if p.z == r.z:
        matches = matches + 1
    if matches != 2:
        return 7
    return 0
