# Ordinal-alignment stress: data-reloc classes interleaved within single
# functions, multiple of each, so any cross-class ordinal mis-join shows up as a
# mis-targeted ADRP page reloc. The production source surface is no-pointer:
# string literals exercise data relocations and ordinary calls exercise BL
# relocations without @importc, ptr, or function-address escape.
fn cstrlen(value: str): int32 =
    return len(value)

var gX: int32
var gY: int32

fn worker(): int32 =
    return 7

fn helper(): int32 =
    return 11

# interleave: global store, cstring-arg call, global load+store, cstring-arg
# call, ordinary call, cstring-arg call, ordinary call — all in one fn.
fn mixed(): int32 =
    gX = 1
    if cstrlen("aa") != 2:
        return 1
    gX = gX + 3
    if cstrlen("bbbb") != 4:
        return 2
    gY = gX + 5
    if worker() != 7:
        return 3
    if cstrlen("cccccc") != 6:
        return 4
    if helper() != 11:
        return 5
    gX = gY + gX
    return 0

fn mixed2(): int32 =
    if cstrlen("zz") != 2:
        return 1
    gX = gX + 1
    gY = gY + gX
    if cstrlen("yyyy") != 4:
        return 2
    if worker() != 7:
        return 3
    return 0

fn main(): int32 =
    if mixed() != 0:
        return 1
    if mixed2() != 0:
        return 2
    return 0
