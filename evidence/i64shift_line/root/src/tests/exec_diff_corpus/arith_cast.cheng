# form: arith / int-cast -- int32<->int64 widening/truncation + arithmetic.
fn f(x: int32, y: int64): int32 =
    let w = int64(x)
    let s = w + y
    let t = int32(s)
    return t
fn main(): int32 =
    let r = f(1000000, int64(88))
    if r != 1000088:
        return 1
    let neg = 0 - 5
    if neg != 0 - 5:
        return 2
    let m = 7 * 6
    if m != 42:
        return 3
    return 0