# form: bool short-circuit chains -- `and`/`or` whose RHS is a side-effecting
# call that MUST NOT run when the chain short-circuits. observable: exit code.
# A global counter is bumped by a helper; the test asserts the counter proves
# the RHS of `and`/`or` was (or was not) evaluated. The chains live in `if`
# conditions (cold parser can't take a bool-op-with-call in a let-initializer).
# r1-3 covered plain bool compares only, never short-circuit evaluation order.
var calls: int32 = 0
fn bump(ret: bool): bool =
    calls = calls + 1
    return ret
fn main(): int32 =
    # false and X -> X must NOT be evaluated (no bump); branch not taken.
    calls = 0
    if false and bump(true):
        return 1
    if calls != 0:
        return 2
    # true and X -> X IS evaluated (one bump); branch taken.
    calls = 0
    if true and bump(true):
        if calls != 1:
            return 3
    else:
        return 4
    # true or X -> X must NOT be evaluated; branch taken.
    calls = 0
    if true or bump(true):
        if calls != 0:
            return 5
    else:
        return 6
    # false or X -> X IS evaluated; branch taken.
    calls = 0
    if false or bump(true):
        if calls != 1:
            return 7
    else:
        return 8
    # mixed chain: true and false or bump(true) -> left of `or` is false, so
    # bump runs once, result true (one bump). No parens (cold parser limit).
    calls = 0
    if true and false or bump(true):
        if calls != 1:
            return 9
    else:
        return 10
    # double-and short-circuit: false and bump and bump -> neither RHS runs.
    calls = 0
    if false and bump(true) and bump(true):
        return 11
    if calls != 0:
        return 12
    # and-chain that fully evaluates: true and bump(true) and bump(true).
    calls = 0
    if true and bump(true) and bump(true):
        if calls != 2:
            return 13
    else:
        return 14
    return 0
