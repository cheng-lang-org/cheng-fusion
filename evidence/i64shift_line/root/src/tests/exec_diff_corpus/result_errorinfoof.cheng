# form: result ErrorInfoOf projection -- extract the ErrorInfo subaggregate
# out of a Result[bool] error value and read its code.
# observable: process exit code. Exercises the ErrorInfoOf err-subaggregate
# projection intrinsic (BodyResultProjectErrInfoTag).
# NOTE: like result_intrinsic.cheng, a standalone unit importing result.cheng
# pulls the still-uninstantiated Ok/Err/Value generic templates, so the driver
# emits no .o for the whole unit (SKIP, not a pass). The ErrorInfoOf projection
# itself is proven byte-identical node-vs-text by tools/two_path_diff.sh on
# src/std/result.cheng (Error/ErrorInfoOf migrated out of cold, census wcz 14->12).
import std/result

fn errCodeOf(flag: int32): int32 =
    var r: Result[bool]
    if flag == 0:
        r = ErrCode[bool](7, "boom")
    else:
        r = Ok[bool](true)
    let info = ErrorInfoOf[bool](r)
    return ErrorCodeOf(info)

fn main(): int32 =
    # error path: ErrorInfoOf copies the err subaggregate; code field is 7.
    if errCodeOf(0) != 7:
        return 1
    # ok path: ErrorOkInto zeroed the err code.
    if errCodeOf(1) != 0:
        return 2
    return 0
