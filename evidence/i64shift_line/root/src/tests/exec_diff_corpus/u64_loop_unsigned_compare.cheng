# 断言 fixture:验证 `off + i >= thresh`(off:uint64 + i:for-range)节点路径
# 用无符号比较 codegen。off 取 2^63(bit63 置位):signed 比较视为负数,unsigned
# 比较视为大数。off+i(i 小)恒 >= 小阈值(unsigned 真),signed 则为假。
# 正确(unsigned)→ hits=4 → 返 0;错误(signed)→ hits=0 → 返 1。

fn checkLoop(off: uint64, maxSize: uint64, thresh: uint64): int32 =
    var hits: int32
    for i in 0..<maxSize:
        if off + i >= thresh:
            hits = hits + 1
    return hits

fn main(): int32 =
    let off: uint64 = uint64(1) << uint64(63)
    let hits = checkLoop(off, uint64(4), uint64(8))
    if hits == 4:
        return 0
    return 1
