# form: a GLOBAL scalar variable with an explicit NON-ZERO literal initializer.
# The initializer value must be emitted into the global's __data slot so the
# program observes it before any write. observable: exit code.
#
# DRIVER MISCOMPILE (blame=DRIVER): the driver places the global in __data but
# zero-fills it (the __data slot at the global's address reads `00 00 00 00`),
# dropping the explicit `= 42` / `= 100` initializer. stage3 emits the literal
# into the data section. So every read of an un-written global returns 0 on the
# driver. First failing assert: readGv() must return 42 but the driver reads 0.
# global_rmw passes because it only reads the global AFTER a write; this fixture
# reads the INITIAL value, exposing the dropped initializer.
#
# Only POSITIVE literal initializers are asserted: stage3 also mishandles an
# *expression* initializer like `= 0 - 7`, which would make the diff AMBIGUOUS
# (both wrong). Positive literals are stage3-clean, pinning the blame on DRIVER.
var gv: int32 = 42
var gw: int32 = 100
var gx: int32 = 7

fn readGv(): int32 =
    return gv
fn readGw(): int32 =
    return gw
fn readGx(): int32 =
    return gx

fn main(): int32 =
    # initial value visible through a function read.
    if readGv() != 42:
        return 1
    # initial value visible by direct global read in main.
    if gv != 42:
        return 2
    # a second initialized global.
    if readGw() != 100:
        return 3
    if gw != 100:
        return 4
    # a third, smaller, initialized global.
    if readGx() != 7:
        return 5
    if gx != 7:
        return 6
    # arithmetic on the initial values (all must be the declared constants).
    if (gv + gw) != 142:
        return 7
    if (gv + gw + gx) != 149:
        return 8
    # write then read still works (the RMW path is fine; only init was dropped).
    gv = gv + 8
    if gv != 50:
        return 9
    return 0
