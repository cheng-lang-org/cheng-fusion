# 漏网哨兵 ① 的组合形 — 逐字节写入 (uint8*) + 宽 return-form 读回 (uint64*).
#
# 触发点: 8 次 `*(U8P) = byte` 单字节存 (named ptr), 然后 `return *(U64P)` 一次宽读.
#   验证 (a) 字节粒度 store 落到正确偏移, (b) 宽 return-form load 拼回完整 64 位.
# 为何补: corpus 无字节序列化→宽读回的组合; 裸 `*name` 宽读若截断(旧 bug), 拼出的
#   0x1122334455667788 高 4 字节丢失 → 断言逮住. drv_base rc=1 (宽读截断), drv_fix rc=0.
# 取址: 指针全来自 malloc, 偏移用 ptr(uint64(raw)+off) 算术, 无 & 无 ->store. 期望 0.

type
    U8P = uint8 *
    U64P = uint64 *

@importc("malloc")
fn c_malloc(n: uint64): ptr

fn storeByte(raw: ptr, off: uint64, v: uint8): void =
    let bp: U8P = U8P(ptr(uint64(raw) + off))
    *bp = v

fn loadWide(raw: ptr): uint64 =
    let wp: U64P = U64P(raw)
    return *wp

fn main(): int32 =
    let raw = c_malloc(uint64(8))
    storeByte(raw, uint64(0), uint8(0x88))
    storeByte(raw, uint64(1), uint8(0x77))
    storeByte(raw, uint64(2), uint8(0x66))
    storeByte(raw, uint64(3), uint8(0x55))
    storeByte(raw, uint64(4), uint8(0x44))
    storeByte(raw, uint64(5), uint8(0x33))
    storeByte(raw, uint64(6), uint8(0x22))
    storeByte(raw, uint64(7), uint8(0x11))
    let w = loadWide(raw)
    if w != uint64(0x1122334455667788):
        return 1
    return 0
