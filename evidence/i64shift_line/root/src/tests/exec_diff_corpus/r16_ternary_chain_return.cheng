# form (net-audit r16): a DEEP right-nested ternary CHAIN as the sole return —
# a multi-way bucket classifier `c0 ? v0 : (c1 ? v1 : (c2 ? v2 : (c3 ? v3 :
# default)))`, four conditions deep, where each condition is a distinct
# comparison on the same input. chained_ternary_arith nested 2 deep feeding an
# arith op; cmp_cond_ternary_return was a single flat ternary. This is a 4-level
# right-associated ternary whose arms are plain immediates and whose chain must
# fall through exactly one level per failed condition. Stresses: the
# right-recursive ternary lowering — each `:` else-arm is itself a ternary, so a
# bug that flattens the nesting, picks the wrong arm, or evaluates a later
# condition before an earlier one short-circuits will diverge. observable: exit
# code.
fn bucket(n: int32): int32 =
    return n < 0 ? 0 : (n < 10 ? 1 : (n < 100 ? 2 : (n < 1000 ? 3 : 4)))
fn sign3(n: int32): int32 =
    return n > 0 ? 1 : (n < 0 ? (0 - 1) : 0)
fn main(): int32 =
    # each bucket boundary picks the right level of the chain.
    if bucket(0 - 5) != 0:
        return 1
    if bucket(0) != 1:
        return 2
    if bucket(9) != 1:
        return 3
    if bucket(10) != 2:
        return 4
    if bucket(99) != 2:
        return 5
    if bucket(100) != 3:
        return 6
    if bucket(999) != 3:
        return 7
    if bucket(1000) != 4:
        return 8
    if bucket(50000) != 4:
        return 9
    # sign chain: -1/0/1 across the three arms.
    if sign3(42) != 1:
        return 10
    if sign3(0 - 42) != (0 - 1):
        return 11
    if sign3(0) != 0:
        return 12
    # monotonic: bucket is non-decreasing as n increases across boundaries.
    if bucket(9) > bucket(10):
        return 13
    if bucket(99) > bucket(100):
        return 14
    if bucket(999) > bucket(1000):
        return 15
    # the chain produces all five distinct bucket values.
    let total: int32 = bucket(0 - 1) + bucket(5) + bucket(50) + bucket(500) + bucket(5000)
    if total != 10:
        return 16
    return 0
