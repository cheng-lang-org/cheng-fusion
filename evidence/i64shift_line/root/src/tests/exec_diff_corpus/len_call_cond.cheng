# form: len(s)/Len(s) builtin used inside if/elif/while CONDITIONS over a str
# operand. Before the fix the condition-node path treated `len(s)` as a generic
# CallExpr and tried to register a call ordinal for the non-function builtin
# `len`, missing with `call_ordinal` -> the whole condition (and often the
# function) fell to the cold text path. The fix lowers len/Len(str) as a pure
# FieldLoad intrinsic in the node-eval probe+eval (str len@8 w4), so the node
# path owns conditions like `if len(s) <= 0`. The same change exposed (and this
# fixture also guards) a latent node-eval elif false-edge miscompile: a single
# cmp elif (`elif Len(s) == 1`) whose Cbr false edge was patched by the bare-if
# continuation logic using the *if* body end, collapsing it into the elif body.
# Exit code is the observable; driver (node path) must match the stage3 oracle.

# `if len(s) <op> const` over a str param, with surrounding statements so the
# function does not match any whole-body shortcut, and an if/elif/else chain.
fn ClassifyStr(s: str): int32 =
    var score = 0
    score = score + 1
    if len(s) <= 0:
        score = score + 100
    elif Len(s) == 1:
        score = score + 10
    else:
        score = score + 1
    score = score + 2
    return score

# if/elif chain WITHOUT a trailing else (the bare-if continuation path).
fn Bucket(s: str): int32 =
    var b = 0
    if len(s) == 0:
        b = 1
    elif len(s) == 2:
        b = 2
    b = b + 100
    return b

# `if len(a) == len(b)` — len on both sides of a comparison.
fn SameLen(a: str, b: str): int32 =
    var flag = 0
    if len(a) == len(b):
        flag = 1
    else:
        flag = 0
    return flag

# `while i < n` driven by a str len computed once into a local.
fn DrainCount(s: str): int32 =
    var n = len(s)
    var i = 0
    var seen = 0
    while i < n:
        seen = seen + 1
        i = i + 1
    return seen

fn main(): int32 =
    # "" -> score = 1 + 100 + 2 = 103
    if ClassifyStr("") != 103:
        return 1
    # "x" -> len 1 -> 1 + 10 + 2 = 13
    if ClassifyStr("x") != 13:
        return 2
    # "xyz" -> len 3 -> else branch 1 + 1 + 2 = 4
    if ClassifyStr("xyz") != 4:
        return 3
    # Bucket("xyz"): len 3, neither 0 nor 2 -> b stays 0 + 100 = 100
    if Bucket("xyz") != 100:
        return 4
    # Bucket("ab"): len 2 -> b=2 + 100 = 102
    if Bucket("ab") != 102:
        return 5
    # Bucket(""): len 0 -> b=1 + 100 = 101
    if Bucket("") != 101:
        return 6
    # len("ab")==len("cd") -> 1
    if SameLen("ab", "cd") != 1:
        return 7
    # len("a")==len("bb") -> 0
    if SameLen("a", "bb") != 0:
        return 8
    # len("abcd") -> 4 iterations
    if DrainCount("abcd") != 4:
        return 9
    return 0
