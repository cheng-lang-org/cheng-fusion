# form: NINTH and TENTH call arguments are cstrings travelling on the STACK
# (past the 8-register window); the stub reads BOTH back byte by byte and
# folds each byte positionally, so a wrong stack-arg slot, a wrong outgoing
# stride, or an empty literal materialized as a NULL pointer (the 2026-08-22
# cold_a64_emit_string_literal_pair regression that crashed leafcov_cstring_
# multi / leafcov_cstring_stack_arg) changes the value or SIGSEGVs in the
# stub. Covers: two adjacent stack cstrings (offset 0 and 8), non-empty
# payloads, the empty payload "" (must be a lone-NUL address, never NULL),
# and an empty second stack arg. Fixture defines its own `fn main(): int32`;
# linked against leafcov_cstring_ninth_byte.stub.c (no main).
# expected runtime: probe folds -> 1531 / 9 / 253 / 1805 -> main returns 0.
# observable: exit code.
@importc("leafcov9_probe")
fn probe(a1: int32, a2: int32, a3: int32, a4: int32, a5: int32, a6: int32, a7: int32, a8: int32, p: ptr, q: ptr): int32

fn main(): int32 =
    if probe(1, 2, 3, 4, 5, 6, 7, 8, "abcd", "XY") != 1531:
        return 1
    if probe(1, 2, 3, 4, 5, 6, 7, 8, "", "") != 9:
        return 2
    if probe(1, 2, 3, 4, 5, 6, 7, 8, "", "z") != 253:
        return 3
    if probe(1, 2, 3, 4, 5, 6, 7, 8, "wxyz", "ab") != 1805:
        return 4
    return 0
