# form: 10-parameter function (8 int32 register params + bool 9th + int32
# 10th, both past the 8-register window) -- exercises backend2 slice-3 leaves
# ParamSaveCount capped at 8 (save loop runs the full 8, emit_ops:4698/4575),
# LoadSlotToReg stack-param arm (IncomingParamStackOffsetPacked: frameBytes +
# packed offset for params >= 9), the Darwin packed BOOL stack param (1-byte
# ldrb, ParamSlotAbiSize==1 arm, emit_ops:562-567), caller-side StackArgBytes>0
# with sp bias, and sparse reads (body reads only a1/a8/b/c so save-count =
# max slot + 1 semantics is observable). The ladder never passes more than 3
# params. Part of the backend2 slice-3 leaf coverage battery.
# expected runtime: f(...,true,100) = 1+100 = 101; f(...,false,100) = 8-100 =
# -92 -> main returns 0. observable: exit code.
fn f(a1: int32, a2: int32, a3: int32, a4: int32, a5: int32, a6: int32, a7: int32, a8: int32, b: bool, c: int32): int32 =
    if b:
        return a1 + c
    return a8 - c

fn main(): int32 =
    if f(1, 2, 3, 4, 5, 6, 7, 8, true, 100) != 101:
        return 1
    if f(1, 2, 3, 4, 5, 6, 7, 8, false, 100) != 0 - 92:
        return 2
    return 0
