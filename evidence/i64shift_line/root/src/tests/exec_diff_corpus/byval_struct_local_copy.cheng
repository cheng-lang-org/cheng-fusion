# form: copy a BY-VALUE struct parameter into a local `var` then read/mutate the
# local. observable: exit code. The callee receives `b: Box` by value; `var
# local = b` must materialise a full copy of the parameter aggregate into the
# local slot. Reading `local.v` must see the caller-supplied value, and mutating
# the local must not touch the parameter (or the caller's copy).
#
# This is the reduced form of a DRIVER (pure node path) miscompile: the driver
# does NOT copy the parameter aggregate into the local correctly — `local.v`
# reads a wrong offset value (observed 4 instead of 5) while stage3 is correct.
# Caught by linking the fixture .o and running it (H1 executable-diff).
type
    Box =
        v: int32
fn copyRead(b: Box): int32 =
    var local = b
    return local.v
fn copyBump(b: Box): int32 =
    var local = b
    local.v = local.v + 100
    return local.v
fn main(): int32 =
    var b: Box
    b.v = 5
    # plain copy then read: must see 5.
    if copyRead(b) != 5:
        return 1
    # copy then mutate the local: must see 105.
    if copyBump(b) != 105:
        return 2
    # the original is by value -> caller's copy is untouched.
    if b.v != 5:
        return 3
    return 0
