# form: comparison-condition ternary stored into a struct field --
# `r.v = a > b ? x : y` (Lane 2, the field-store variant of Lane B's return form).
#
# Lane B fixed the cmp-cond ternary in RETURN position by rerouting it through a
# real cbr lowering. The field-store assignment path has a separate, deeper RHS
# lowering: when the RHS is `a > b ? x : y` the eager/branchless scalar value
# slot evaluator cannot produce a cond slot from a compare, declines, and the
# whole `fill` function honestly SKIPs (driver emits no .o). This fixture drives
# the form to a real branch (cmp + cbr, only the selected arm runs) and stores
# the chosen arm value to the target field. observable: process exit code.
type
    Box =
        v: int32
        w: int32
fn fill(a: int32, b: int32, x: int32, y: int32): int32 =
    var r: Box
    r.v = a > b ? x : y
    r.w = a <= b ? x : y
    return r.v * 100 + r.w
fn main(): int32 =
    # a>b true: v picks x=3; a<=b false: w picks y=7.  3*100+7=307
    if fill(5, 1, 3, 7) != 307:
        return 1
    # a>b false: v picks y=7; a<=b true: w picks x=3.  7*100+3=703
    if fill(1, 5, 3, 7) != 703:
        return 2
    return 0
