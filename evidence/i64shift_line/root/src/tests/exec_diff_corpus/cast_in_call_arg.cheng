# form: a numeric cast (int32(...)/uint32(...)/int64(...)) applied directly to a
# CALL ARGUMENT, so the conversion must be materialized into the outgoing
# argument register, not a local slot. observable: exit code. arith_cast /
# cast_chain cast into locals/returns; this casts AT the call site
# (f(int32(x), uint32(y))) plus a cast wrapping a call RESULT used as the next
# call's arg, exercising the arg-materialization of a convert node.
#
# DRIVER MISCOMPILE (blame=DRIVER, found net-audit r11): in the FULL function
# context (many prior statements) the driver DROPS `let big: int64 = 2147483647`
# + its `int32(big)` cast — the literal is never materialized into big's slot,
# and the assert-6 call `addi(int32(big), 0)` loads its first-arg slot
# ([sp,#0x110]) which is only ever READ, never written (otool: no `str` to
# [sp,#0x110]; the lone `movk #0x7fff` nearby is the compare RHS, not big). So
# the call gets stack garbage and assert 6 fails (rc=6). stage3 is clean (rc=0).
# Same materialization-drop family as bit_combo_expr / struct_byval_manyfield;
# only manifests past some prior-statement / slot-pressure threshold (the
# isolated 2-stmt form materializes correctly). Next batch: fix the node-path
# value materialization so a constant-initialized local feeding a later call
# argument is always emitted. blame=DRIVER (stage3 oracle correct).
fn addi(a: int32, b: int32): int32 =
    return a + b
fn addu(a: uint32, b: uint32): uint32 =
    return a + b
fn widen(a: int64, b: int64): int64 =
    return a + b
fn main(): int32 =
    let x: int64 = 1000
    let y: int64 = 337
    # int64 args narrowed to int32 directly in the call argument position.
    if addi(int32(x), int32(y)) != 1337:
        return 1
    # uint32 cast in the argument position.
    let p: int32 = 7
    let q: int32 = 5
    if int32(addu(uint32(p), uint32(q))) != 12:
        return 2
    # cast wrapping a CALL RESULT, fed as the next call's argument.
    let r = addi(int32(x), int32(y))     # 1337
    if widen(int64(r), int64(3)) != 1340:
        return 3
    # nested: cast(call(cast(arg))) chain.
    if int32(widen(int64(addi(2, 3)), int64(addi(4, 6)))) != 15:
        return 4
    # cast of a literal directly in arg position (constant-fold path at call site).
    if addi(int32(0x7F), int32(1)) != 128:
        return 5
    # mixed widths: narrow a big int64 to int32 then pass.
    let big: int64 = 2147483647         # INT32_MAX
    if addi(int32(big), 0) != 2147483647:
        return 6
    # uint32 arithmetic through the call, cast result back (no high-bit operands,
    # to avoid the known unsigned-compare / large-decimal-literal bug classes).
    let w: uint32 = addu(uint32(100), uint32(23))
    if int32(w) != 123:
        return 7
    return 0
