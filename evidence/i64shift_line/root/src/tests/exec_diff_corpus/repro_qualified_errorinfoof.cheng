import std/result as stdresult

fn mayFail(x: int32): Result[int32] =
    if x < 0:
        return Err[int32]("neg")
    return Ok[int32](x * 2)

fn errText[T](r: var Result[T]): str =
    let err: ErrorInfo = stdresult.ErrorInfoOf[T](r)
    return stdresult.ErrorMessage(err)

fn callerErr(x: int32): str =
    var r: Result[int32] = mayFail(x)
    if IsErr(r):
        return errText(r)
    return ""

fn main(): int32 =
    let m = callerErr(-1)
    if m != "neg":
        return 1
    return 0
