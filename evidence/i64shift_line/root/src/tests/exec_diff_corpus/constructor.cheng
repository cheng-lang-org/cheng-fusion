# form: constructor -- Type(field: v) with scalar + aggregate field.
# observable: process exit code.
type
    Inner =
        lo: int32
        hi: int32

    Outer =
        tag: int32
        inner: Inner
        scale: int32

fn build(t: int32, lo: int32, hi: int32, s: int32): Outer =
    return Outer(tag: t, inner: Inner(lo: lo, hi: hi), scale: s)

fn main(): int32 =
    let o = build(7, 11, 22, 3)
    if o.tag != 7:
        return 1
    if o.inner.lo != 11:
        return 2
    if o.inner.hi != 22:
        return 3
    if o.scale != 3:
        return 4
    let combined = o.tag + o.inner.lo + o.inner.hi + o.scale
    if combined != 43:
        return 5
    return 0
