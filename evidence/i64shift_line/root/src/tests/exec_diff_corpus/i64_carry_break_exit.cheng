# form: i64 accumulator loop with an early break (a second exit edge). The 5c
# conservative gate requires a SINGLE normal exit (header false-edge, one pred);
# a break adds another edge into the exit, so the gate must DECLINE the store
# drop and keep the 5b eager store => correct. acc sums 0..n until acc exceeds
# the cap, then breaks; result is the first partial sum > 20.
# 0+1+2+3+4+5+6 = 21 > 20 -> break with acc=21.
fn sumUntil(n: int64, cap: int64): int64 =
    var acc: int64 = int64(0)
    var i: int64 = int64(0)
    while i < n:
        let t: int64 = acc + i
        acc = t
        if acc > cap:
            break
        i = i + int64(1)
    return acc
fn main(): int32 =
    let r: int64 = sumUntil(int64(100), int64(20))
    if r != int64(21):
        return 1
    return 0
