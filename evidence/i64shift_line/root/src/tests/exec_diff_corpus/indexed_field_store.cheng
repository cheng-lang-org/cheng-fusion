# form: fixed-length-array-of-struct element field store -- ys[i].field = v then
# read back. The exact `localSlots[idx].placeKind = coreir.X` census shape:
# the typed layer strips `[idx]` to a bare root name in stmt.assignRootName and
# resolves the field against the ELEMENT type, so a base-slot + fieldOffset store
# DROPS the index (every ys[k].f writes element 0's f). Pre-fix the driver
# COMPILES this (no STOP) but emits wrong code -- a silent miscompile; stage3 is
# correct. Const indices keep the shape inside the driver's runnable subset so
# the net catches the divergence (a not-ready bail would only SKIP, hiding it).
# observable: process exit code.
type
    Cell =
        tag: int32
        size: int32
fn run(xs: Cell[3]): int32 =
    var ys = xs
    ys[0].tag = 5
    ys[1].tag = 9
    ys[2].size = 17
    if ys[0].tag != 5:
        return 2
    if ys[1].tag != 9:
        return 3
    if ys[2].size != 17:
        return 4
    if ys[0].size != 0:
        return 6
    if ys[2].tag != 0:
        return 7
    return 0
fn main(): int32 =
    var xs: Cell[3]
    return run(xs)
