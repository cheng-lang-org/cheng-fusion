# form: dynamic seq-of-seq int32[][] nested element store grid[r][j]=v whose
# INNER (last) subscript j is resolved by the node-eval path (typed_expr
# assignIndexNodeIndex) after the phase-1 migration replaced the nested-store
# from-text subscript resolution (ScalarValueSlotForText i32/i64) in
# PrimaryBodyIrAppendI32Assign with PrimaryBodyIrNodeEvalProbe +
# PrimaryBodyIrEvalNode(stmt.assignIndexNodeIndex).
# Covers the inner-subscript families the deleted text two-way handled:
#   * plain variable index    grid[0][j]
#   * arithmetic index         grid[0][j+1], grid[0][base*2]
# Outer index kept constant so the fixture isolates the migrated inner dispatch.
# observable: process exit code. A miscompiled inner subscript writes the wrong
# cell; the read-backs below flip the exit code.
# (variable-index nested store is also miscompiled by the stage3 cold oracle, so
#  under exec_diff this fixture surfaces as a REFERENCE(stage3) divergence — the
#  pure driver compiles it correctly, the oracle does not.)

fn make_row5(): int32[] =
    var row: int32[]
    add(row, 0)
    add(row, 0)
    add(row, 0)
    add(row, 0)
    add(row, 0)
    return row

fn main(): int32 =
    var grid: int32[][]
    setLen(grid, 2)
    let row0 = make_row5()
    grid[0] = row0
    let row1 = make_row5()
    grid[1] = row1

    # --- plain variable inner index ---
    let j = 2
    grid[0][j] = 7
    if grid[0][2] != 7:
        return 1
    if grid[0][0] != 0:
        return 2

    # --- arithmetic inner index (j+1) ---
    grid[0][j + 1] = 9
    if grid[0][3] != 9:
        return 3

    # --- arithmetic inner index (base*2) ---
    let base = 2
    grid[0][base * 2] = 11
    if grid[0][4] != 11:
        return 4

    # --- second row independent (no aliasing) ---
    let k = 0
    grid[1][k] = 42
    if grid[1][0] != 42:
        return 5
    if grid[0][0] != 0:
        return 6
    if grid[1][1] != 0:
        return 7

    return 0
