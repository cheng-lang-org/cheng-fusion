# 漏网哨兵 ① — 裸 `*name` 宽解引用 (return-form), 经 @importc malloc 取指针 (无 &).
#
# 触发点: fn f(p: T*): T = return *p   (T = int64 / ptr, 裸 *name 无 cast 无括号).
# 旧 miscompile (2026-07-09 gen2 SIGSEGV): 文本路径 I32 臂无条件认领裸 *name →
#   AppendI32PtrDerefLoad 硬编码 ldr w 截断 64 位 pointee 高 32 位; driver 的
#   argv 指针 0x16fdfeba0 → 0x6fdfeba0 → strlen SIGSEGV. compile rc=0 census 干净,
#   仅运行时截断 —— 整个 corpus 无一夹具走裸 `*name` (都走 `->field` 或 stub), 故漏网.
# 取址回避: 指针来自 malloc (堆), 不用 `&局部`(bail/垃圾) 也不用 `&global`(bail 707).
# 高 32 位敏感: int64 用 4294967338 (0x1_0000_002A), 截成低 32 位=42 必被断言逮住;
#   ptr pointee 用堆地址往返恒等 (指针 64 位, 截断即身份破坏).
# 实测: drv_fix rc=0 (return-form 已修), drv_base rc=1 (return-form 截断). 期望 0.

type
    I64P = int64 *
    PtrP = ptr *

@importc("malloc")
fn c_malloc(n: uint64): ptr

fn readI64(p: I64P): int64 =
    return *p

fn readPtr(pp: PtrP): ptr =
    return *pp

fn main(): int32 =
    let a = c_malloc(uint64(8))
    let wp: I64P = I64P(a)
    *wp = 4294967338
    if readI64(wp) != 4294967338:
        return 1
    let b = c_malloc(uint64(8))
    let pp: PtrP = PtrP(b)
    let target = c_malloc(uint64(8))
    *pp = target
    if readPtr(pp) != target:
        return 2
    return 0
