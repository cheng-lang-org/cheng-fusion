# form: two typed-expr inference gaps that wcz'd whole functions.
#   1) chained subscript `outer[i].items[j]` — the let-binding type inference
#      split at the FIRST `[`, rooting the type at `outer` and yielding the
#      OUTER element type instead of the inner array element type. The mistyped
#      binding then made `.field` access unresolvable.
#   2) str-valued if-expr decl `let s = if cond: "a" else: "b"` — no resolver
#      typed the if-expr, so the binding type was empty and the whole decl was
#      dropped (no slot), leaving any later use of `s` unresolvable.
# Exit code is the observable; the driver must match the stage3 oracle.

type
    Inner =
        tag: int32

    Outer =
        items: Inner[]

fn PickTag(outers: Outer[], i: int32, j: int32): int32 =
    let chosen = outers[i].items[j]
    return chosen.tag

fn FlagText(on: bool): str =
    let s = if on: "Y" else: "N"
    return s

fn main(): int32 =
    var inners0: Inner[]
    var a: Inner
    a.tag = 41
    var b: Inner
    b.tag = 42
    add(inners0, a)
    add(inners0, b)
    var o0: Outer
    o0.items = inners0
    var outers: Outer[]
    add(outers, o0)
    if PickTag(outers, 0, 1) != 42:
        return 1
    if FlagText(true) != "Y":
        return 2
    if FlagText(false) != "N":
        return 3
    return 0
