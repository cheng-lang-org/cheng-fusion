# form: argument-shape boundary matrix around the 8-register window.
#   * leafcov9_eight: EXACTLY 8 params, cstring in the LAST register slot
#     (x7) -- the no-stack-arg boundary; an off-by-one in the register/stack
#     split would spill it or misread it.
#   * leafcov9_mix: cstrings at param positions 1,3,5,7 (register) and 9
#     (first stack slot) interleaved with scalars, including THREE empty
#     literals in one call -- pins that every cstring, register or stack,
#     empty or not, reaches the stub as a dereferenceable NUL boundary.
# Fixture defines its own `fn main(): int32`; linked against
# leafcov_cstring_arg_shape_matrix.stub.c (no main).
# expected runtime: mix/eight folds -> 1717 / 30 / 370 / 7 -> main returns 0.
# observable: exit code.
@importc("leafcov9_mix")
fn mix(s: ptr, b: int32, t: ptr, c: int32, u: ptr, d: int32, v: ptr, e: int32, w: ptr): int32

@importc("leafcov9_eight")
fn eight(a1: int32, a2: int32, a3: int32, a4: int32, a5: int32, a6: int32, a7: int32, s: ptr): int32

fn main(): int32 =
    if mix("ab", 1, "c", 2, "", 3, "de", 4, "f") != 1717:
        return 1
    if mix("", 9, "", 8, "", 7, "", 6, "") != 30:
        return 2
    if eight(7, 6, 5, 4, 3, 2, 1, "xyz") != 370:
        return 3
    if eight(7, 6, 5, 4, 3, 2, 1, "") != 7:
        return 4
    return 0
