# form: a MODULE-GLOBAL dynamic seq of a LARGE aggregate; read element `g[i]` BY
# VALUE and pass it to a non-var aggregate parameter (the `loweringParallelResults[i]`
# → `Copy...Into(src: Aggregate, ...)` family-A point). The indexed-member address
# resolver must resolve the global's element type; before the fix
# `PrimaryBodyIrBindingTypeForName` discarded the resolved global type and the
# address path bailed at the root-type step (bail_44 / bodySemanticsMissing).
# observable: exit code.
type
    Rec =
        a: int32
        b: int32
        c: int32
        d: int32
        e: int32
        f: int32
        g: int32
        h: int32
        i: int32
        j: int32

var
    gRecs: Rec[]

fn makeRec(base: int32): Rec =
    var r: Rec
    r.a = base + 0
    r.b = base + 1
    r.c = base + 2
    r.d = base + 3
    r.e = base + 4
    r.f = base + 5
    r.g = base + 6
    r.h = base + 7
    r.i = base + 8
    r.j = base + 9
    return r

# non-var aggregate parameter: receives the element BY VALUE (the family-A ABI
# form). Reads high-offset fields to catch a truncated element copy.
fn sumRec(r: Rec): int32 =
    return r.a + r.b + r.c + r.d + r.e + r.f + r.g + r.h + r.i + r.j

fn main(): int32 =
    gRecs = []
    add(gRecs, makeRec(100))
    add(gRecs, makeRec(200))
    add(gRecs, makeRec(300))

    var i: int32
    i = 1
    # `gRecs[i]` (module-global seq element) passed BY VALUE to a non-var
    # aggregate parameter. Index is a runtime variable (not a literal), matching
    # `loweringParallelResults[i]`.
    if sumRec(gRecs[i]) != 2045:
        return 1

    # read element by value into a local, then read high-offset fields.
    let e2 = gRecs[2]
    if e2.a != 300:
        return 2
    if e2.j != 309:
        return 3
    if e2.h != 307:
        return 4

    i = 0
    if sumRec(gRecs[i]) != 1045:
        return 5

    return 0
