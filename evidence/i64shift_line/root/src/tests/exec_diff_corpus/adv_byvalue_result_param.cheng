import std/result as stdresult

fn mayFail(x: int32): Result[int32] =
    if x < 0:
        return Err[int32]("neg")
    return Ok[int32](x * 2)

# by-value (move, no `var`) Result[T] parameter -- distinct physical layout
# from the var/by-address form the (c) family 2 exemption comment discusses.
fn errTextByValue(r: Result[int32]): str =
    let err: ErrorInfo = stdresult.ErrorInfoOf[int32](r)
    return stdresult.ErrorMessage(err)

fn caller(x: int32): str =
    let res: Result[int32] = mayFail(x)
    return errTextByValue(res)

fn main(): int32 =
    let m = caller(-1)
    if m != "neg":
        return 1
    let m2 = caller(5)
    if m2 != "":
        return 2
    return 0
