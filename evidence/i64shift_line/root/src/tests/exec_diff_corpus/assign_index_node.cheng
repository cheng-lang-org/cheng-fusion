# form: indexed store `arr[i] = v` whose SUBSCRIPT is resolved by the node-eval
# path (typed_expr assignIndexNodeIndex) after phase-2 deleted the from-text
# subscript resolution (ScalarValueSlotForText i32/i64 + Context field-read).
# Covers every subscript family the deleted text three-way handled:
#   * plain variable index            arr[i]
#   * arithmetic index                arr[i+1], arr[base*2]
#   * struct field-read index         arr[box.idx]   (refCount[op.target] form)
#   * fixed-length array elem store   fa[i]
# observable: process exit code. A miscompiled subscript writes the wrong cell;
# the read-backs below flip the exit code.
# (variable-index nested grid[r][c] is a SEPARATE dispatch, not this migration;
#  the stage3 cold oracle miscompiles it, so it is excluded to keep the
#  driver-vs-oracle exec_diff clean.)

type
    Sel =
        idx: int32
        pad: int32

fn main(): int32 =
    var arr: int32[]
    add(arr, 0)
    add(arr, 0)
    add(arr, 0)
    add(arr, 0)
    add(arr, 0)

    # --- plain variable index ---
    let i = 2
    arr[i] = 7
    if arr[2] != 7:
        return 1
    if arr[0] != 0:
        return 2

    # --- arithmetic index (i+1) ---
    arr[i + 1] = 9
    if arr[3] != 9:
        return 3

    # --- arithmetic index (base*2) ---
    let base = 2
    arr[base * 2] = 11
    if arr[4] != 11:
        return 4

    # --- struct field-read index (refCount[op.target] form) ---
    var sel: Sel
    sel.idx = 1
    sel.pad = 0
    arr[sel.idx] = 5
    if arr[1] != 5:
        return 5
    # untouched cells stay put.
    if arr[2] != 7:
        return 6

    # --- fixed-length array element store ---
    var fa: int32[4]
    let k = 3
    fa[k] = 42
    fa[0] = 1
    if fa[3] != 42:
        return 7
    if fa[0] != 1:
        return 8
    if fa[1] != 0:
        return 9

    return 0
