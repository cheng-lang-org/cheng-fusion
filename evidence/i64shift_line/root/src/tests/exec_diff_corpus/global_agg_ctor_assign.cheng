# form: a GLOBAL aggregate var re-initialized via a constructor-call assignment
# `gState = State()` inside a fn (the exact shape of LoweringParallelReleasePayload
# in lowering_plan.cheng). The constructor returns a zeroed aggregate that must be
# written into the GLOBAL symbol's storage (adrp+add target), not a stack slot,
# and the reset must be visible to main. observable: exit code.
type State =
    x: int32
    y: int32

var gState: State

fn bump(): int32 =
    gState.x = gState.x + 1
    gState.y = gState.y + 10
    return gState.x

fn resetState() =
    gState = State()

fn main(): int32 =
    if bump() != 1:
        return 1
    if bump() != 2:
        return 2
    if gState.y != 20:
        return 3
    resetState()
    if gState.x != 0:
        return 4
    if gState.y != 0:
        return 5
    if bump() != 1:
        return 6
    if gState.y != 10:
        return 7
    return 0
