# form (net-audit r16): DEPENDENT read-modify-write through TWO-level nested field
# chains where each store reads a sibling sub-chain the prior statement wrote —
# `o.pos.x = o.pos.x + o.vel.x`, `o.acc = o.pos.x + o.pos.y` — on a nested struct
# passed BY VALUE and RETURNED. field_chain4_assign / deep_nested_field_store did
# independent stores at depth then read back; r15_nested_struct_deepcopy did a
# whole-value copy. This CHAINS dependent RMWs across DIFFERENT sub-objects of the
# same nested aggregate (pos depends on vel, acc depends on pos), all through
# `o.sub.field` address chains, then returns the whole nested struct so the
# caller re-reads every mutated field at the call boundary. Stresses: nested
# field-chain load feeding a nested field-chain store to a DIFFERENT sub-object,
# ordering of dependent deep stores, and a by-value nested struct surviving the
# return. observable: exit code.
#
# DRIVER MISCOMPILE (blame=DRIVER, net-audit r16): driver returns rc=1
# (`b1.pos.x != 13`) while stage3 returns 0. Reduced: `fn step(b: Body): Body =
# ...; return b` where Body is a nested struct passed BY VALUE — driver yields
# b1.pos.x=32 (a stack-address-derived garbage), stage3 yields 13. otool on the
# driver's `_step` shows the in-place RMWs through the by-pointer param are CORRECT
# (`str w10,[x9]` writes pos.x=13), but the `return b` epilogue mis-copies into the
# sret buffer x8: instead of copying the 20 struct bytes it does `ldr x9,[sp,#0x70]
# (the PARAM POINTER); str x9,[x8]` then `str <sret ptr>,[x8,#0x8]` and `ldr x9,
# [sp,#0x80] (off-frame); str x9,[x8,#0x10]` — i.e. it writes the param/sret
# POINTER VALUES and stack garbage into the return aggregate rather than the
# mutated struct contents. stage3 copies the struct words. So returning a by-value
# struct that was received as a by-pointer parameter copies pointers/garbage
# instead of the struct data. blame=DRIVER (struct-param return-copy lowering).
type
    Vec2 =
        x: int32
        y: int32
    Body =
        pos: Vec2
        vel: Vec2
        acc: int32
fn step(b: Body): Body =
    # pos += vel (each component a deep-chain RMW reading vel.* and writing pos.*).
    b.pos.x = b.pos.x + b.vel.x
    b.pos.y = b.pos.y + b.vel.y
    # acc depends on the just-updated pos components.
    b.acc = b.pos.x + b.pos.y
    return b
fn main(): int32 =
    var b: Body
    b.pos.x = 10
    b.pos.y = 20
    b.vel.x = 3
    b.vel.y = 5
    b.acc = 0
    # one step.
    let b1: Body = step(b)
    # pos.x = 13, pos.y = 25, acc = 38.
    if b1.pos.x != 13:
        return 1
    if b1.pos.y != 25:
        return 2
    if b1.acc != 38:
        return 3
    # the source `b` is unchanged (by-value): pos still 10/20.
    if b.pos.x != 10:
        return 4
    if b.pos.y != 20:
        return 5
    # velocity unchanged through the step.
    if b1.vel.x != 3:
        return 6
    if b1.vel.y != 5:
        return 7
    # two steps: feed the result back in.
    let b2: Body = step(b1)
    # pos.x = 16, pos.y = 30, acc = 46.
    if b2.pos.x != 16:
        return 8
    if b2.pos.y != 30:
        return 9
    if b2.acc != 46:
        return 10
    # the dependent chain holds: acc always equals pos.x + pos.y after a step.
    if b2.acc != (b2.pos.x + b2.pos.y):
        return 11
    # ten steps move pos.x by 10*vel.x = 30 from its start of 13 after step 1.
    var cur: Body = b1
    var i: int32
    while i < 9:
        cur = step(cur)
        i = i + 1
    # after 10 total steps from b: pos.x = 10 + 10*3 = 40, pos.y = 20 + 10*5 = 70.
    if cur.pos.x != 40:
        return 12
    if cur.pos.y != 70:
        return 13
    if cur.acc != 110:
        return 14
    return 0
