# form (wcz G5): `var x = bag.rows[i].labels[j]` — a local STR initialized from a
# DOUBLE-index field/index chain whose inner index walks a seq-of-STRUCT and whose
# outer index walks a str-seq field of that struct element. The front-end type
# inference stops at the intermediate `bag.rows[i]` and mis-infers the local's
# type as the struct element type (`Row`) instead of `str` (it drops the trailing
# `.labels[j]`). That stable-but-wrong type made the backend mint an Aggregate
# slot for `x`; the str value's node-eval store then mismatched the slot shape
# (store_shape miss), the decl line lowered to a single zero-word invalid op, and
# the whole function fell to word-count-zero (cold path). Downstream reads of `x`
# also saw an Aggregate, poisoning any Fmt interpolation of it.
# Fix (primary_object_plan local_decl): for a pure field/index RHS (no call) whose
# declared type does not shape to str, consult the RHS node-eval probe — which
# walks the real field/index chain to its leaf — and re-type the slot to str when
# the probe resolves str. The existing str node-eval store path then takes over.
# observable: process exit code. main returns 0 on success, distinct nonzero per
# failed sub-check. Linked against fmt_var_indexed_struct_seq_str.stub.c (the
# seq-grow + str-add + cstr-copy runtime bridges the setup references).
type
    Row =
        labels: str[]
    Bag =
        rows: Row[]

# the wcz-carrying function: `var picked = b.rows[i].labels[j]` — double-index,
# struct-seq inner, str-seq-leaf outer. Pre-fix this was word-count-zero (cold).
fn pick(b: Bag, i: int32, j: int32): str =
    var picked = b.rows[i].labels[j]
    return picked

fn main(): int32 =
    var r0: Row
    r0.labels = []
    add(r0.labels, "AB")
    add(r0.labels, "CDE")
    var b: Bag
    b.rows = []
    add(b.rows, r0)
    # b.rows[0].labels[0] = "AB"  (len 2)
    if Len(pick(b, 0, 0)) != 2:
        return 1
    # b.rows[0].labels[1] = "CDE" (len 3)
    if Len(pick(b, 0, 1)) != 3:
        return 2
    return 0
