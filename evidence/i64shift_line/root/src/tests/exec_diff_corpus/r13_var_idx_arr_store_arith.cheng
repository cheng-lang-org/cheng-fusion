# form (net-audit r13): variable-index store into a FIXED-length local array
# where the RHS is an ARITHMETIC expression of the index and other elements —
# arr[i] = arr[i-1] + i*3. Existing array3d_store/multidim_store store a
# pre-computed scalar; this one stores a value that DEPENDS on a prior element
# at a variable index (read arr[i-1], scale by elemSize, add, store back at
# arr[i]). Stresses: variable-index load AND variable-index store in the same
# statement with arithmetic between, both addresses scaled by elemSize=4.
# observable: exit code. self-asserts 0 on success, distinct nonzero per check.
fn main(): int32 =
    var arr: int32[8]
    # zero-init check.
    for i in 0..<8:
        if arr[i] != 0:
            return 1
    arr[0] = 10
    # arr[i] = arr[i-1] + i*3 : a running recurrence at variable indices.
    var i: int32 = 1
    while i < 8:
        arr[i] = arr[i - 1] + i * 3
        i = i + 1
    # expected: 10, 13, 19, 28, 40, 55, 73, 94
    if arr[0] != 10:
        return 2
    if arr[1] != 13:
        return 3
    if arr[2] != 19:
        return 4
    if arr[3] != 28:
        return 5
    if arr[4] != 40:
        return 6
    if arr[5] != 55:
        return 7
    if arr[6] != 73:
        return 8
    if arr[7] != 94:
        return 9
    # now store arr[j] = arr[j] - arr[j-1] (a difference back at variable idx);
    # in reverse so each read uses the still-original neighbour.
    var j: int32 = 7
    while j >= 1:
        arr[j] = arr[j] - arr[j - 1]
        j = j - 1
    # diffs: arr[1..7] = 3,6,9,12,15,18,21 ; arr[0] unchanged = 10.
    if arr[0] != 10:
        return 10
    if arr[1] != 3:
        return 11
    if arr[2] != 6:
        return 12
    if arr[7] != 21:
        return 13
    return 0
