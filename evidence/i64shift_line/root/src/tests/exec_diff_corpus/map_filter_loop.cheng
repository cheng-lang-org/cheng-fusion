# form: the hand-written loop equivalent of a chained map/filter/reduce -- build
# a derived seq (map x*2), keep only those passing a predicate (filter even>4),
# then fold (sum). observable: exit code. Exercises building a fresh seq via add
# inside a loop, a guarded add (filter), and a separate reduce loop. A miscompile
# in the conditional add, the seq growth, or the running accumulator diverges.
fn doubleAll(xs: int32[]): int32[] =
    var out: int32[]
    var i: int32
    while i < xs.len:
        add(out, xs[i] * 2)
        i = i + 1
    return out
fn keepGt(xs: int32[], threshold: int32): int32[] =
    var out: int32[]
    var i: int32
    while i < xs.len:
        if xs[i] > threshold:
            add(out, xs[i])
        i = i + 1
    return out
fn sum(xs: int32[]): int32 =
    var s: int32
    var i: int32
    while i < xs.len:
        s = s + xs[i]
        i = i + 1
    return s
fn main(): int32 =
    var src: int32[]
    setLen(src, 5)
    src[0] = 1
    src[1] = 2
    src[2] = 3
    src[3] = 4
    src[4] = 5
    # map *2 -> [2,4,6,8,10]
    let doubled = doubleAll(src)
    if doubled.len != 5:
        return 1
    if doubled[0] != 2 || doubled[4] != 10:
        return 2
    # filter >5 -> [6,8,10]
    let big = keepGt(doubled, 5)
    if big.len != 3:
        return 3
    if big[0] != 6 || big[1] != 8 || big[2] != 10:
        return 4
    # reduce -> 24
    if sum(big) != 24:
        return 5
    # full chain in one expression: sum(filter(map(src)))
    if sum(keepGt(doubleAll(src), 5)) != 24:
        return 6
    # filter that removes everything -> empty -> sum 0
    let none = keepGt(src, 100)
    if none.len != 0:
        return 7
    if sum(none) != 0:
        return 8
    return 0
