# form (wcz G3): a container type (`Layer`) is embedded as a DIRECT named-struct
# field inside an outer struct (`Stub.layer`), so the type-layout pass registers
# `Layer`'s whole-size FIRST (via the outer struct's nested-field walk) but WITHOUT
# its per-field rows. The declared-type pass then saw a layout already present for
# `Layer` and SKIPPED building its field table. With no field metadata, a later
# direct field access `add(layer.exprs, e)` / `add(layer.next, -1)` on a `Layer`
# value could not resolve the seq field's offset, the seq-append op lowered to a
# single zero-word invalid op, and the whole host function (LoweringExprLayerFrom-
# TypedFacts shape) fell to word-count-zero (cold path).
#
# Fix (typed_expr declared-type layout pass): skip a type only when BOTH its
# whole-layout AND its field-row table are already present; a size-only layout
# pre-registered by an embedding struct no longer suppresses the field-table build.
#
# `Layer` mirrors parser.NormalizedExprLayer: seq-of-struct field + seq field +
# a nested-struct field (`Lookup`) that itself carries seq fields.
# observable: process exit code (CORRECT result is 0). driver (node path) and
# stage3 (cold) must agree.
type
    Expr =
        a: int32
        b: int32

    LookupBucket =
        x: int32
        y: int32

    Lookup =
        slots: int32[]
        buckets: LookupBucket[]

    Layer =
        sourceCount: int32
        exprs: Expr[]
        next: int32[]
        residual: int32
        lookup: Lookup

    # Outer struct embedding Layer as a DIRECT named-struct field. Processing this
    # type first registers Layer's size-only layout (no field rows).
    Stub =
        tag: int32
        layer: Layer

fn buildLayer(n: int32): Layer =
    var layer: Layer
    for i in 0..<n:
        var e: Expr
        e.a = i
        e.b = i + 100
        add(layer.exprs, e)
        add(layer.next, -1)
    layer.sourceCount = n
    return layer

fn main(): int32 =
    # Force Stub (and thus the embedded Layer size-only layout) into the type set.
    var stub: Stub
    stub.tag = 7
    stub.layer = buildLayer(3)
    if stub.tag != 7:
        return 10
    let layer = buildLayer(4)
    if layer.exprs.len != 4:
        return 1
    if layer.next.len != 4:
        return 2
    if layer.sourceCount != 4:
        return 3
    if layer.exprs[0].a != 0:
        return 4
    if layer.exprs[3].b != 103:
        return 5
    if stub.layer.exprs.len != 3:
        return 6
    if stub.layer.exprs[2].b != 102:
        return 7
    return 0
