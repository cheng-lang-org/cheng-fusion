# form: an INDEXED dynamic-seq element that is an aggregate struct passed BY
# VALUE as a call argument (wcz Lane 3 / bail_44: `bodyIR.ops[opIndex]`,
# `ctx.coldCsgStatementRows[i]`). The call-arg lowering must load the whole
# struct from the element address into a private stack copy and pass it by
# value; the seq's stored element must be unaffected (value semantics).
# observable: exit code.
type
    Cell =
        a: int32
        b: int32
        c: int32
fn cellSum(c: Cell): int32 =
    return c.a + c.b + c.c
fn cellWeighted(c: Cell, k: int32): int32 =
    return (c.c * k) + (c.b * k) + (c.a * k)
fn main(): int32 =
    var cells: Cell[]
    add(cells, Cell(a: 1, b: 2, c: 3))
    add(cells, Cell(a: 10, b: 20, c: 30))
    add(cells, Cell(a: 4, b: 5, c: 6))
    # pass an indexed aggregate element by value.
    if cellSum(cells[0]) != 6:
        return 1
    if cellSum(cells[1]) != 60:
        return 2
    if cellWeighted(cells[2], 2) != 30:
        return 3
    # the stored elements must be unchanged after by-value calls.
    if cells[1].a != 10:
        return 4
    if cells[2].c != 6:
        return 5
    if cellSum(cells[1]) != 60:
        return 6
    return 0
