# form (net-audit r16): INSERTION SORT of a fixed array of structs by a key field
# — the classic `while j>=0 and arr[j].key>curKey: shift arr[j] right; j=j-1` inner
# loop that COPIES struct elements rightward FIELD-BY-FIELD at variable indices,
# then drops the held element into the gap. r14_struct_bubble_sort swapped adjacent
# struct pairs; r15_struct_array_find_index only READ a field. This does a SHIFT
# (arr[j+1].key=arr[j].key, arr[j+1].tag=arr[j].tag at computed indices) and a HOLD
# of the moving element's fields (`curKey`/`curTag` read out before the shift,
# written back after). Fields are held/copied individually — whole-struct
# value-copy of an array element (`var cur: Item = a[i]`) aliases its source in
# this backend, so the per-field hold is the correct production form. The sort runs
# inline on a `main` local (cold front-end can't return a fixed array by value).
# Stresses: variable-index struct field LOAD+STORE inside a backward inner loop,
# the held fields surviving across the shift loop, and that the shift uses the
# array's own freshly-written slots. observable: exit code.
type Item =
    key: int32
    tag: int32
fn main(): int32 =
    var a: Item[6]
    a[0].key = 5
    a[0].tag = 50
    a[1].key = 2
    a[1].tag = 20
    a[2].key = 8
    a[2].tag = 80
    a[3].key = 1
    a[3].tag = 10
    a[4].key = 9
    a[4].tag = 90
    a[5].key = 3
    a[5].tag = 30
    # insertion sort by key, shifting struct elements rightward field-by-field.
    var i: int32 = 1
    while i < 6:
        var curKey: int32 = a[i].key
        var curTag: int32 = a[i].tag
        var j: int32 = i - 1
        while j >= 0:
            if a[j].key > curKey:
                a[j + 1].key = a[j].key
                a[j + 1].tag = a[j].tag
                j = j - 1
            else:
                break
        a[j + 1].key = curKey
        a[j + 1].tag = curTag
        i = i + 1
    # ascending by key: 1,2,3,5,8,9.
    if a[0].key != 1:
        return 1
    if a[1].key != 2:
        return 2
    if a[2].key != 3:
        return 3
    if a[3].key != 5:
        return 4
    if a[4].key != 8:
        return 5
    if a[5].key != 9:
        return 6
    # the tag rode along with its key (full-struct copy, not just the key field):
    # tag is always key*10.
    var k: int32
    while k < 6:
        if a[k].tag != a[k].key * 10:
            return 7
        k = k + 1
    # non-decreasing invariant across the whole array.
    var m: int32 = 1
    while m < 6:
        if a[m].key < a[m - 1].key:
            return 8
        m = m + 1
    # sum of keys preserved (no element lost/duplicated): 5+2+8+1+9+3 = 28.
    var s: int32
    var n: int32
    while n < 6:
        s = s + a[n].key
        n = n + 1
    if s != 28:
        return 9
    return 0
