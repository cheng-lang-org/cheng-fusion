# form: if/elif/while conditions over locals seeded from a for-range induction
# variable (`var lo = i`). Before the fix these untyped locals had no resolved
# type, so the condition-node builder bailed and every `if lo >= hi` / `while
# lo > 0` fell to the text path (`if_cond no_node`). The fix infers int32 for a
# local whose initializer is a bare for-range binding, letting the node path own
# the comparison. Exit code is the observable; driver (node path) must match the
# stage3 oracle.

# `if a >= b` over two for-range-derived locals (the identStart>=identEnd form).
fn CountLeadingIdents(text: str): int32 =
    let n = len(text)
    var hits: int32
    for i in 0..<n:
        if text[i] != '(':
            continue
        var identEnd = i
        var identStart = i
        while identStart > 0:
            let ch = text[identStart - 1]
            var identChar = false
            if ch >= 'a' && ch <= 'z':
                identChar = true
            if !identChar:
                break
            identStart = identStart - 1
        if identStart >= identEnd:
            continue
        hits = hits + 1
    return hits

# `if a >= 0 && a < b` (logical-and) over a for-range-derived local.
fn SumWindow(n: int32): int32 =
    var total: int32
    for i in 0..<n:
        var lo = i
        var hi = n
        if lo >= 0 && lo < hi:
            total = total + lo
    return total

# nested `if a > 0` then `if a < n` over a for-range-derived local.
fn NestedCheck(n: int32): int32 =
    var acc: int32
    for i in 0..<n:
        var cur = i
        if cur > 0:
            if cur < n:
                acc = acc + 1
    return acc

fn main(): int32 =
    # "ab(cd": one `(` preceded by lowercase run -> identStart=0,identEnd=2,
    # 0>=2 false -> hits=1.
    if CountLeadingIdents("ab(cd") != 1:
        return 1
    # i in 0..3, each lo in [0,3) passes 0<=lo<4 -> 0+1+2+3 = 6.
    if SumWindow(4) != 6:
        return 2
    # i in 0..3, cur>0 && cur<4 true for 1,2,3 -> 3.
    if NestedCheck(4) != 3:
        return 3
    return 0
