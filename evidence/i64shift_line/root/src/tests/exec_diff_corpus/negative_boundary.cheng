# form: signed boundary values -- INT32_MIN / INT32_MAX / INT64_MIN /
# INT64_MAX, negation of the min (which two's-complement-wraps back to itself),
# sign-extension across widths, and arithmetic that crosses zero. observable:
# exit code (all comparisons internal). consecutive_cast/mixed_width_arith did
# width casts but not the boundary VALUES; a materializer that mishandles the
# all-bits-set / high-bit-set immediates, or an arithmetic shift that fails to
# sign-extend, diverges here.
#
# DRIVER MISCOMPILE (blame=DRIVER, net-audit r12): driver returns rc=9 (the
# `(i64max + 1) != i64min` check) while stage3 returns 0. otool on the i64min
# decl shows `int64(0 - 9223372036854775807) - 1` is computed from TWO
# `mov x9,#0x0` immediates (sp,#0x30 and sp,#0x38) — the wide DECIMAL literal
# 9223372036854775807 is NEVER materialized when several wide int64 temporaries
# are live, so i64min becomes 0-0-1 = -1 instead of INT64_MIN. Each wide-literal
# sub-form is correct in ISOLATION (positive store, single negation, single
# subtraction all verified standalone); the drop manifests only past a
# live-wide-temporary / slot-pressure threshold — same materialization-drop
# family as cast_chain / bit_combo_expr / zero_local_shift_or. blame=DRIVER.
fn negate(x: int32): int32 =
    return 0 - x
fn widen(x: int32): int64 =
    return int64(x)
fn main(): int32 =
    let i32max: int32 = 2147483647
    let i32min: int32 = 0 - 2147483647 - 1   # avoid literal overflow: -(2^31-1)-1
    # boundary identities.
    if i32max != 2147483647:
        return 1
    if (i32max + 1) != i32min:                # wrap MAX+1 -> MIN
        return 2
    if (i32min - 1) != i32max:                # wrap MIN-1 -> MAX
        return 3
    # negating MIN wraps back to MIN (no positive representation).
    if negate(i32min) != i32min:
        return 4
    # negating MAX gives -(MAX).
    if negate(i32max) != (0 - 2147483647):
        return 5

    # sign-extension on widen: MIN widened to i64 stays negative, exact value.
    if widen(i32min) != int64(0 - 2147483648):
        return 6
    if widen(i32max) != int64(2147483647):
        return 7
    # a negative i32 widened keeps its magnitude.
    if widen(0 - 7) != int64(0 - 7):
        return 8

    # int64 boundaries.
    let i64max: int64 = int64(9223372036854775807)
    let i64min: int64 = int64(0 - 9223372036854775807) - int64(1)
    if (i64max + int64(1)) != i64min:
        return 9
    if (i64min - int64(1)) != i64max:
        return 10

    # arithmetic crossing zero with negatives.
    var acc: int32 = 5
    acc = acc - 10        # -5
    if acc != (0 - 5):
        return 11
    acc = acc * (0 - 3)   # 15
    if acc != 15:
        return 12
    acc = acc + (0 - 20)  # -5
    if acc != (0 - 5):
        return 13
    # signed division/remainder with negative operands (truncate toward zero).
    if ((0 - 7) / 2) != (0 - 3):
        return 14
    if ((0 - 7) % 2) != (0 - 1):
        return 15
    if (7 / (0 - 2)) != (0 - 3):
        return 16
    # comparison across zero.
    if !((0 - 1) < 0):
        return 17
    if !(i32min < i32max):
        return 18
    return 0
