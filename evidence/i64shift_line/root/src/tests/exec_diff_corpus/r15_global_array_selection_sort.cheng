# form (net-audit r15): a full SELECTION SORT of a GLOBAL dynamic seq `g: int32[]`
# — nested loops find the min of the unsorted tail (variable-index reads
# `g[j] < g[minIdx]`) then SWAP via three variable-index accesses
# (`tmp=g[i]; g[i]=g[minIdx]; g[minIdx]=tmp`). global_int_array_indexed_store did
# straight `g[i]=v` stores at loop-monotonic indices; this does data-dependent
# min-tracking and an element SWAP at two independently-computed indices, inside
# a multi-pass outer loop. Stresses: repeated variable-index LOAD and STORE on a
# global seq within nested loops where the store indices (`i`, `minIdx`) come
# from different sources, and the read-then-write swap must observe its own
# prior store. observable: exit code.
#
# DRIVER MISCOMPILE (blame=DRIVER, net-audit r15): driver returns rc=1
# (`g[0] != 1` — the array is UNSORTED) while stage3 returns 0. Instrumented
# (`return g[0]` after sort): driver yields 5 (the ORIGINAL first element — the
# sort had NO EFFECT), stage3 yields 1 (correctly sorted ascending). A single
# isolated swap `swapAt(i,m)` compiles+runs correctly on the driver; the no-op
# emerges only inside the nested-loop selection sort, where the in-loop
# variable-index swap / min-tracking is dropped or mis-sequenced so the global
# seq is never reordered. stage3 sorts correctly (1,2,3,5,8,9). blame=DRIVER.
var gArr: int32[] = []

fn setup(): void =
    add(gArr, 5)
    add(gArr, 2)
    add(gArr, 8)
    add(gArr, 1)
    add(gArr, 9)
    add(gArr, 3)

fn selsort(): void =
    let n: int32 = gArr.len
    var i: int32
    while i < n - 1:
        var minIdx: int32 = i
        var j: int32 = i + 1
        while j < n:
            if gArr[j] < gArr[minIdx]:
                minIdx = j
            j = j + 1
        let tmp: int32 = gArr[i]
        gArr[i] = gArr[minIdx]
        gArr[minIdx] = tmp
        i = i + 1

fn main(): int32 =
    setup()
    if gArr.len != 6:
        return 9
    selsort()
    # ascending order: 1,2,3,5,8,9.
    if gArr[0] != 1:
        return 1
    if gArr[1] != 2:
        return 2
    if gArr[2] != 3:
        return 3
    if gArr[3] != 5:
        return 4
    if gArr[4] != 8:
        return 5
    if gArr[5] != 9:
        return 6
    # non-decreasing invariant across the whole array.
    var k: int32 = 1
    while k < 6:
        if gArr[k] < gArr[k - 1]:
            return 7
        k = k + 1
    # sum preserved (no element lost/duplicated by the swaps): 5+2+8+1+9+3 = 28.
    var s: int32
    var m: int32
    while m < 6:
        s = s + gArr[m]
        m = m + 1
    if s != 28:
        return 8
    return 0
