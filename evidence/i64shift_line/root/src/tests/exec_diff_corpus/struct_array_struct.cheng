# form: struct containing a fixed array of structs -- Board has Cell[4]; store
# into nested element fields then read back. observable: exit code. Exercises
# element-address inside an aggregate field (base + fieldOff + i*elemSize) for
# both store and load, with the inner element itself being a struct.
type
    Cell =
        x: int32
        y: int32
    Board =
        id: int32
        cells: Cell[4]
        tail: int32
fn main(): int32 =
    var b: Board
    b.id = 7
    b.tail = 9
    # zero-init: every cell field must read 0.
    if b.cells[0].x != 0:
        return 1
    if b.cells[3].y != 0:
        return 2
    # store into distinct elements' distinct fields.
    b.cells[0].x = 10
    b.cells[0].y = 11
    b.cells[2].x = 20
    b.cells[3].y = 33
    # read back exactly.
    if b.cells[0].x != 10:
        return 3
    if b.cells[0].y != 11:
        return 4
    if b.cells[2].x != 20:
        return 5
    if b.cells[3].y != 33:
        return 6
    # untouched element/field must remain zero (no aliasing).
    if b.cells[1].x != 0:
        return 7
    if b.cells[2].y != 0:
        return 8
    if b.cells[3].x != 0:
        return 9
    # surrounding scalar fields untouched.
    if b.id != 7:
        return 10
    if b.tail != 9:
        return 11
    # compound across elements.
    b.cells[1].x = b.cells[0].x + b.cells[2].x
    if b.cells[1].x != 30:
        return 12
    return 0
