# form: control-flow -- while loop with break + continue; exit-code observable.
fn count(n: int32): int32 =
    var i = 0
    var acc = 0
    while i < n:
        i = i + 1
        if i == 3:
            continue
        if i == 8:
            break
        acc = acc + i
    return acc
fn main(): int32 =
    let r = count(20)
    if r != 25:
        return 1
    return 0