# form: a fixed array of bool — store true/false at indices, read back, and use
# a loaded bool element directly in an `if`. observable: exit code. No prior
# fixture stored/loaded a bool[] element (bool storage width + the truthiness of
# a loaded byte). Drives bool element store, bool element load, and bool-in-cond.
fn main(): int32 =
    var flags: bool[8]
    # zero-init: every flag false.
    for i in 0..<8:
        if flags[i]:
            return 1
    # set a few.
    flags[0] = true
    flags[3] = true
    flags[7] = true
    # the set ones read true.
    if !flags[0]:
        return 2
    if !flags[3]:
        return 3
    if !flags[7]:
        return 4
    # the unset ones stay false.
    if flags[1]:
        return 5
    if flags[2]:
        return 6
    if flags[6]:
        return 7
    # count the true flags via loop with a bool-element condition.
    var cnt: int32
    for i in 0..<8:
        if flags[i]:
            cnt = cnt + 1
    if cnt != 3:
        return 8
    # flip one off, recount.
    flags[3] = false
    var cnt2: int32
    for i in 0..<8:
        if flags[i]:
            cnt2 = cnt2 + 1
    if cnt2 != 2:
        return 9
    # store a computed bool (comparison result) into an element.
    let x: int32 = 5
    flags[1] = x > 3
    if !flags[1]:
        return 10
    flags[2] = x > 10
    if flags[2]:
        return 11
    # use two bool elements in a compound condition.
    if flags[0] and flags[1]:
        if flags[2]:
            return 12
    else:
        return 13
    return 0
