# form: typed-pointer offset READ and WRITE through a `T*` cast of a raw ptr --
# `p->field = v` (store) and `... = p->field` (load) at several struct-field
# offsets, plus walking an element pointer forward by elemSize. observable: via
# C stub (the caller passes a struct buffer, Cheng mutates it through the typed
# ptr, the stub verifies). u64_pack_shift_or only READ a field through a ptr;
# this WRITES through it too, exercising the ptr-deref-store address arithmetic
# (base + fieldOffset) for the store side, the bug class K Wave B fixed.
#
# REFERENCE (stage3) MISCOMPILE (blame=REFERENCE, net-audit r12): the DRIVER is
# clean (ptr_offset_rw OK — a=15 b=15 c=1000000000005, sums exact). stage3
# badly mis-lowers the typed-ptr offset reads/writes (a=garbage, b=1, the int64
# field c offset wrong), so its self-check fails. This is an ORACLE bug, not a
# driver-gate failure — recorded so the oracle gap is visible.
type
    Node =
        a: int32
        b: int32
        c: int64
    NodePtr = Node *

@exportc("node_fill")
fn node_fill(p: ptr, x: int32, y: int32, z: int64): void =
    let n: NodePtr = NodePtr(p)
    n->a = x
    n->b = y
    n->c = z

@exportc("node_sum")
fn node_sum(p: ptr): int64 =
    let n: NodePtr = NodePtr(p)
    # read all three fields back through the ptr and combine.
    return int64(n->a) + int64(n->b) + n->c

@exportc("node_bump")
fn node_bump(p: ptr, d: int32): void =
    let n: NodePtr = NodePtr(p)
    # read-modify-write each scalar field through the ptr.
    n->a = n->a + d
    n->b = n->b - d
    n->c = n->c + int64(d)
