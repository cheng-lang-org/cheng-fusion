# form: a function pointer returns an aggregate by sret and the caller stores
# the result in a local before reading fields. This covers the same lowering
# surface as `let h: Bytes = digest(key)`: the callee is a fnptr value, not a
# statically registered target, and the sret destination is an existing slot.
type Pair =
    a: int32
    b: int32

fn makePair(x: int32): Pair =
    return Pair(a: x + 1, b: x + 2)

fn useMaker(x: int32, maker: fn (value: int32): Pair): int32 =
    let p: Pair = maker(x)
    if p.a != x + 1:
        return 10
    if p.b != x + 2:
        return 20
    return p.a + p.b

fn main(): int32 =
    let got: int32 = useMaker(40, makePair)
    if got != 83:
        return 1
    return 0
