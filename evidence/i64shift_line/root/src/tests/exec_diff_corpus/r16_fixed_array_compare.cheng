# form (net-audit r16): element-wise EQUALITY of two fixed int32 arrays — a
# `while i<n: if x[i]!=y[i]: return 0` loop returning 1 iff every pair matches,
# plus a lexicographic compare returning -1/0/1. r15_fixed_array_param_reduce
# folded ONE array to a scalar; this consumes TWO fixed-array PARAMETERS in
# lockstep, indexing both at the same loop counter and early-returning on the
# first mismatch. Stresses: two distinct fixed-array params live simultaneously
# (their base addresses must not alias), a paired variable-index load `x[i]` vs
# `y[i]`, and an early return out of the comparison loop. observable: exit code.
fn arrEq(x: int32[5], y: int32[5]): int32 =
    var i: int32
    while i < 5:
        if x[i] != y[i]:
            return 0
        i = i + 1
    return 1
fn arrCmp(x: int32[5], y: int32[5]): int32 =
    var i: int32
    while i < 5:
        if x[i] < y[i]:
            return 0 - 1
        if x[i] > y[i]:
            return 1
        i = i + 1
    return 0
fn main(): int32 =
    var a: int32[5]
    var b: int32[5]
    var i: int32
    while i < 5:
        a[i] = i * 2
        b[i] = i * 2
        i = i + 1
    # identical arrays compare equal.
    if arrEq(a, b) != 1:
        return 1
    if arrCmp(a, b) != 0:
        return 2
    # change one element of b -> not equal, and lexicographically b > a.
    b[3] = 100
    if arrEq(a, b) != 0:
        return 3
    if arrCmp(a, b) != (0 - 1):
        return 4
    if arrCmp(b, a) != 1:
        return 5
    # restore -> equal again (no stale state from the mismatch path).
    b[3] = 6
    if arrEq(a, b) != 1:
        return 6
    # a mismatch in the FIRST element is detected (loop returns immediately).
    var c: int32[5]
    var j: int32
    while j < 5:
        c[j] = a[j]
        j = j + 1
    c[0] = 999
    if arrEq(a, c) != 0:
        return 7
    if arrCmp(c, a) != 1:
        return 8
    # a mismatch in the LAST element is detected (loop runs to the end).
    var d: int32[5]
    var k: int32
    while k < 5:
        d[k] = a[k]
        k = k + 1
    d[4] = 0 - 1
    if arrEq(a, d) != 0:
        return 9
    if arrCmp(d, a) != (0 - 1):
        return 10
    return 0
