# 801 width 对抗夹具：str 三元选出的值立即 Len + 逐字节访问。
# 若 24B 头 select 有宽度/字序/半头错（如只搬 8B/16B、cond 缩放错位），
# Len 或字节值立即变错 → 非零退出码。
fn pick(s: str): str =
    return Len(s) > 0 ? s : "-"

fn classify(n: int32): str =
    return n > 0 ? "pos" : (n < 0 ? "neg" : "zero")

fn main(): int32 =
    # then 臂：header 三词必须逐位等于 s 的头。
    let a = pick("AZ")
    if Len(a) != 2:
        return 1
    if int32(a[0]) != 65:
        return 2
    if int32(a[1]) != 90:
        return 3
    # else 臂：字面量 "-" 的头。
    let b = pick("")
    if Len(b) != 1:
        return 4
    if int32(b[0]) != 45:
        return 5
    # 嵌套三元：外 else 臂是内层三元的结果头（非 param、栈内头取词路径）。
    let c = classify(0 - 7)
    if Len(c) != 3:
        return 6
    if int32(c[0]) != 110:
        return 7
    if int32(c[2]) != 103:
        return 8
    let d = classify(0)
    if Len(d) != 4:
        return 9
    if int32(d[0]) != 122:
        return 10
    if int32(d[3]) != 111:
        return 11
    let e = classify(9)
    if Len(e) != 3:
        return 12
    if int32(e[1]) != 111:
        return 13
    return 0
