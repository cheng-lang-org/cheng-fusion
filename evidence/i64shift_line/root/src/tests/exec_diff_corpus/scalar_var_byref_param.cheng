# form: scalar LOCAL `var` passed BY REFERENCE (var int32 param). The callee
# writes through the reference; the CALLER must read the SAME slot back. The
# miscompile (#48): the caller's address-of path (passing &x into setVal) and
# the caller's value-read path (return x) resolve to DIFFERENT stack slots — the
# write lands in the by-ref slot but the read-back picks a phantom same-named
# slot, so the mutation is invisible. driver returns the phantom (pre-write 0)
# instead of the written value. stage3 (cold) is correct.
#
# All caller-side logic lives in `probe()` (a Cheng function) so the
# slot-resolution path under test is exercised in Cheng, not the C stub. The
# stub only calls probe() and checks its int32 return. Linked against
# scalar_var_byref_param.stub.c. observable: probe() return value.
fn setVal(n: int32, v: var int32) =
    v = n

fn addInto(n: int32, v: var int32) =
    v = v + n

# Returns 0 on full success; a distinct nonzero code identifies the first failed
# read-back, so a phantom-slot miscompile yields a deterministic nonzero != the
# oracle's 0.
fn probe(): int32 =
    var x: int32 = 1
    setVal(2, x)
    if x != 2:
        return 1
    # read-modify-write through the reference: the callee reads v (must see the
    # prior write of 2) then writes v+5=7; caller read-back must see 7.
    addInto(5, x)
    if x != 7:
        return 2
    # a second independent local var must not alias the first slot.
    var y: int32 = 3
    setVal(9, y)
    if y != 9:
        return 3
    if x != 7:
        return 4
    # overwrite x again through the ref; caller must observe the new value, not a
    # stale phantom.
    setVal(100, x)
    if x != 100:
        return 5
    return 0
