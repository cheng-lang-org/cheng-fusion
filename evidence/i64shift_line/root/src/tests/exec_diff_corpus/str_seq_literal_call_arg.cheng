# form: a str array literal `[a, b, ...]` passed directly as a `str[]` call
# argument (e.g. f([x, "/"])). The call-arg lowering must materialize the
# literal into a temporary dynamic-seq slot (zero-init + per-element
# cheng_seq_str_add) and pass it by value, instead of bailing. The callee reads
# .len and each element's .len; a miscompile in the materialization (wrong
# count, dropped element, or aliasing the same slot) diverges from the known
# total. Observable: exit code.
fn lenSum(parts: str[]): int32 =
    var total: int32
    var i: int32
    while i < parts.len:
        total = total + parts[i].len
        i = i + 1
    return total * 10 + parts.len

fn countWith(prefix: str): int32 =
    # element from a parameter (local str), mixed with str literals
    return lenSum([prefix, "ab", "cde"])

fn main(): int32 =
    # all-literal elements
    let a = lenSum(["x", "yy", "zzz"])
    if a != 63:
        return 1
    # two-element literal
    let b = lenSum(["foo", "bar"])
    if b != 62:
        return 2
    # element sourced from a local string variable
    let p = "hi"
    let c = lenSum([p, "world"])
    if c != 72:
        return 3
    # element sourced through a parameter inside a callee
    let d = countWith("zz")
    if d != 73:
        return 4
    return 0
