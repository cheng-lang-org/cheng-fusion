# form: cast chain i32<->i64 widening/narrowing + u64<->ptr roundtrip, several
# statements in one function. observable: exit code.
#
# DRIVER MISCOMPILE (blame=DRIVER): the driver returns rc=1 (first check fails)
# while stage3 returns 0. Each sub-form is correct IN ISOLATION (widen(5),
# narrow(...), the ptr roundtrip each verified standalone via a C stub), but
# composed in one function the driver clobbers a live value across the wide-
# immediate / cast statements — the same stale-slot family as
# zero_local_shift_or (a const/wide-immediate slot is left uninitialized when
# multiple such temporaries are live). Reduced from the original cast_chain.
fn widen(x: int32): int64 =
    return int64(x) + int64(1000000000000)
fn narrow(w: int64): int32 =
    return int32(w)
fn main(): int32 =
    if widen(5) != int64(1000000000005):
        return 1
    if narrow(int64(0x123456789)) != int32(0x23456789):
        return 2
    let base: uint64 = uint64(0x7F0011223344)
    let p: ptr = ptr(base)
    if uint64(p) != base:
        return 3
    let p2: ptr = ptr(uint64(p) + uint64(16))
    if uint64(p2) != (base + uint64(16)):
        return 4
    return 0
