# form (net-audit r15): a `match` on an enum whose every arm is `=> return <expr>`
# (each arm RETURNS a distinct value directly out of the function), rather than
# assigning into a shared local. nested_match_enum used `=> base = a + b`
# (assignment arms that fall through to one trailing `return`); this uses
# per-arm RETURN arms so the dispatch must branch INTO each arm's own return,
# each materializing a different immediate. Stresses: the match lowering when an
# arm body is itself a terminator (return) — the jump target of a matched
# discriminant is the arm's return-with-value, not a join block. observable:
# exit code.
#
# DRIVER MISCOMPILE (blame=DRIVER, net-audit r15): driver returns rc=1
# (`rank(Kind.A) != 1`) while stage3 returns 0. otool on the driver's `_rank`
# shows the discriminant chain is emitted (cmp k,#0; cset eq; b.ne …) but EVERY
# matched arm branches to the SAME post-match block at the trailing `mov w9,#0x0`
# / `return 0` — the arm BODIES (`mov w0,#1`, `mov w0,#0x16`=22, `#0x14d`=333,
# `#0x115c`=4444) are NEVER EMITTED. So `rank(k)` always returns 0 regardless of
# k. stage3 emits each arm's own `mov`+return. i.e. a `match` whose arms are
# `=> return E` lowers to "all arms jump to the fall-through return 0" on the
# driver; the per-arm return values are dropped. blame=DRIVER.
type Kind = enum
    A
    B
    C
    D
fn rank(k: Kind): int32 =
    match k:
        A => return 1
        B => return 22
        C => return 333
        D => return 4444
    return 0
fn main(): int32 =
    if rank(Kind.A) != 1:
        return 1
    if rank(Kind.B) != 22:
        return 2
    if rank(Kind.C) != 333:
        return 3
    if rank(Kind.D) != 4444:
        return 4
    # the four arms produce four DISTINCT values (not all the same fall-through).
    if rank(Kind.A) == rank(Kind.B):
        return 5
    if rank(Kind.C) == rank(Kind.D):
        return 6
    # sum proves each arm fired with its own value: 1+22+333+4444 = 4800.
    let total: int32 = rank(Kind.A) + rank(Kind.B) + rank(Kind.C) + rank(Kind.D)
    if total != 4800:
        return 7
    return 0
