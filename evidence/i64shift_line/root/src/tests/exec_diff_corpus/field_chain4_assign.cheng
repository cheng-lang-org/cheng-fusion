# form: 4-level field chain a.b.c.d = expr, then read-back through the chain.
# observable: exit code. Exercises offset-chaining for store/load four structs
# deep plus compound RMW through the full chain. Untested in r1-3 (deepest was 3).
type
    D =
        v: int32
        w: int32
    C =
        tag: int32
        d: D
    B =
        id: int32
        c: C
    A =
        head: int32
        b: B
        tail: int32
fn main(): int32 =
    var a: A
    a.head = 1
    a.tail = 2
    a.b.id = 3
    a.b.c.tag = 4
    a.b.c.d.v = 5
    a.b.c.d.w = 6
    # mutate the deepest field through the full chain (load + store same path).
    a.b.c.d.v = a.b.c.d.v + a.b.c.d.w
    if a.b.c.d.v != 11:
        return 1
    # write deepest from a shallow read.
    a.b.c.d.w = a.head + a.tail + a.b.id
    if a.b.c.d.w != 6:
        return 2
    # cross level: tag = deep.v + deep.w
    a.b.c.tag = a.b.c.d.v + a.b.c.d.w
    if a.b.c.tag != 17:
        return 3
    # siblings untouched.
    if a.head != 1:
        return 4
    if a.tail != 2:
        return 5
    if a.b.id != 3:
        return 6
    return 0
