# form: same SLOT_OBJECT_REF module global (var-block `int32[16]`, no init), with
# the dynamic index held in a var that was computed by ARITHMETIC (`k = N - 4`)
# rather than a bare literal, then mutated (`k = k - 5`). Guards that a computed
# runtime index (not a constant-folded subscript) is still scaled and loaded
# from the slot via the ARRAY_I32_INDEX_DYNAMIC READ path.
#
# REFERENCE MISCOMPILE (blame=REFERENCE / stage3 cold): Bug A returned 0 for
# gArr[k]; the fix loads the true value (12*3=36, then 7*3=21). driver already
# correct. observable: exit code (self-asserts 0 on success, nonzero per check).
const N: int32 = 16
var
    gArr: int32[N]

fn main(): int32 =
    var i: int32
    for i in 0..<N:
        gArr[i] = i * 3
    var k: int32 = N - 4       # 12 (runtime var, dynamic index)
    if gArr[k] != 36:          # 12*3
        return 1
    k = k - 5                  # 7
    if gArr[k] != 21:          # 7*3
        return 2
    return 0
