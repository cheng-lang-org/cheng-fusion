# form: a MODULE-LEVEL fixed-size int32 array declared in a var-block with NO
# initializer (`var gArr: int32[16]`). This lowers to a SLOT_OBJECT_REF global
# whose storage is a contiguous 16-word data slot (inline, not a seq header).
# After a loop-fill, a read at a RUNTIME variable index (`gArr[idx]`, idx a var)
# must scale idx by elemSize (4) and load from the slot.
#
# REFERENCE MISCOMPILE (blame=REFERENCE / stage3 cold): Bug A — the cold arm64
# ARRAY_I32_INDEX_DYNAMIC READ handler had a mirror of the STORE arm only for
# the seq-header layout and fell through to a word-count-zero op for the
# SLOT_OBJECT_REF global, so EVERY dynamic-index read returned 0. Pre-fix stage3
# returned 0 for gArr[9] (should be 27); the fix (766a7e2c5) adds the
# SLOT_OBJECT_REF branch mirroring the STORE arm. The pure driver was already
# correct, so pre-fix this fixture would FAIL blame=REFERENCE; post-fix both
# read the true value and it PASSes. observable: exit code (self-asserts 0 on
# success, distinct nonzero per failed check).
const N: int32 = 16
var
    gArr: int32[N]

fn main(): int32 =
    var i: int32
    for i in 0..<N:
        gArr[i] = i * 3
    var idx: int32 = 9
    if gArr[idx] != 27:        # 9*3
        return 1
    # a second distinct dynamic index — not a single-slot artifact.
    idx = 4
    if gArr[idx] != 12:        # 4*3
        return 2
    idx = 0
    if gArr[idx] != 0:
        return 3
    idx = 15
    if gArr[idx] != 45:        # 15*3
        return 4
    return 0
