# form: same SLOT_OBJECT_REF module global as global_fixed_array_dyn_index_single
# (var-block `int32[16]`, no initializer), but read through a LOOP-CARRIED
# dynamic index accumulating a sum. Exercises the ARRAY_I32_INDEX_DYNAMIC READ
# path once per iteration with the loop induction var as the index.
#
# REFERENCE MISCOMPILE (blame=REFERENCE / stage3 cold): under Bug A every
# `gArr[j]` read returned 0, so the accumulated sum was 0 instead of
# 3*(0+1+..+15) = 360. The fix restores the per-element load. driver already
# correct. observable: exit code (self-asserts 0 on success, nonzero per check).
const N: int32 = 16
var
    gArr: int32[N]

fn main(): int32 =
    var i: int32
    for i in 0..<N:
        gArr[i] = i * 3
    var s: int32
    var j: int32
    for j in 0..<N:
        s = s + gArr[j]
    if s != 360:               # 3 * (0+1+..+15) = 3*120
        return 1
    return 0
