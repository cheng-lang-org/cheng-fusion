# form: a comparison whose materialized bool is MULTI-USE -- the bool `f` (x < 10) is read by TWO
# separate `if f` branches. Stage 10 Cmp->Cbr fusion MUST NOT fire on `f`: its slot has more than
# one genuine reader, so the cset+store has to stay so the second `if f` sees the value. A wrong
# single-use gate that fused anyway would drop the store, leaving the second reader to load a
# never-written slot -> garbage -> diverge from the stage3 oracle. Disasm confirms the cset is
# retained (bool materialized) and read by both branches. Guards Stage 10 KILLER (3) SINGLE-USE
# BOOL. Stage3 is the oracle; both compilers must agree.
fn pick(x: int32): int32 =
    let f: bool = x < 10
    var r: int32
    if f:                   # reader 1: branch on the materialized bool
        r = r + 100
    if f:                   # reader 2: branch again -> genuinely multi-use, must NOT fuse
        r = r + 1
    return r
fn main(): int32 =
    if pick(5) != 101:      # f true -> 100 + 1
        return 1
    if pick(50) != 0:       # f false -> neither branch fires
        return 2
    return 0
