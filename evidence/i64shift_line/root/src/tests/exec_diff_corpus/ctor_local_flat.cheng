# form: flat-scalar constructor-literal-to-local -- `let f = Flat(a: 5, b: 6, c: 7)`
# all-scalar fields (no nesting). Counter-test for the local-position aggregate
# constructor lowering: the flat case must zero-init the local slot then emit a
# per-field i32 FieldStore at each offset. main returns 0 iff every field reads
# back correctly; a distinct nonzero code identifies the first wrong field.
type
    Flat =
        a: int32
        b: int32
        c: int32

fn main(): int32 =
    let f = Flat(a: 5, b: 6, c: 7)
    if f.a != 5:
        return 1
    if f.b != 6:
        return 2
    if f.c != 7:
        return 3
    return 0
