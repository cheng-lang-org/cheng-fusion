# form: for-loop body add-only -- `for i in 0..<n: add(s, 7)` then return s.len.
# Lane 1 (#25) reproducer: the add() call inside a for-range body was being
# silently dropped (no seq_add op emitted; loop body disasm was an empty i=i+1
# shell), so s.len returned 0 instead of n. observable: process exit code.
fn build(n: int32): int32[] =
    var s: int32[]
    for i in 0..<n:
        add(s, 7)
    return s

fn main(): int32 =
    let s = build(4)
    # expected: 4 elements all == 7
    if s.len != 4:
        return 1
    if s[0] != 7:
        return 2
    if s[3] != 7:
        return 3
    return 0
