# form: string byte indexing -- read individual bytes of a str via s[i] and
# accumulate, plus Len. observable: exit code. string_concat covered Len only;
# this reads byte values at positions (the str byte-load lowering) which r1-3
# never exercised on the scalar observable.
fn main(): int32 =
    let s = "ABCDE"
    if Len(s) != 5:
        return 1
    # byte values: 'A'=65 .. 'E'=69.
    if int32(s[0]) != 65:
        return 2
    if int32(s[4]) != 69:
        return 3
    # sum all bytes: 65+66+67+68+69 = 335.
    var sum: int32
    for i in 0..<Len(s):
        sum = sum + int32(s[i])
    if sum != 335:
        return 4
    # index with a computed offset.
    let mid = Len(s) / 2
    if int32(s[mid]) != 67:
        return 5
    # compare two byte loads.
    if int32(s[1]) - int32(s[0]) != 1:
        return 6
    # a different literal, read last byte via Len-1.
    let t = "xyz"
    if int32(t[Len(t) - 1]) != 122:
        return 7
    return 0
