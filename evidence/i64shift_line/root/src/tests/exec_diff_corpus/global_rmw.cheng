# form: global mutable state read-modify-write across calls. observable: exit
# code. A miscompile that reloads a stale value or fails to write back the
# global is surfaced.
var gCounter: int32 = 0
fn bump(n: int32): int32 =
    gCounter = gCounter + n
    return gCounter
fn main(): int32 =
    if bump(5) != 5:
        return 1
    if bump(3) != 8:
        return 2
    if gCounter != 8:
        return 3
    gCounter = gCounter * 2
    if gCounter != 16:
        return 4
    if bump(0 - 1) != 15:
        return 5
    return 0
