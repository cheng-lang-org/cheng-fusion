# form: i64 (int64) BinOp via the driver's a64 encoders. The driver's
# PrimaryBodyIRFillBinOp now lowers i64 arithmetic with opIs64=true through
# A64EncAddReg / A64EncSubReg / A64EncMul / A64EncAsrv / A64EncLsrv /
# A64EncLslv / A64EncAndReg / A64EncOrrReg / A64EncEorReg / A64EncSdiv /
# A64EncUdiv. The node-eval BinOp handler emits these for i64 arithmetic.
# A wrong sf bit (silent 32-bit truncation), a dropped sign-extension, or a
# swapped arithmetic/logical shift flips a result; this fixture returns a
# distinct nonzero exit code naming the bad op, and 0 only when EVERY i64
# encoding matches the stage3 cold-backend oracle (runtime diff == ground truth).
#
# Width is exercised by checking the HIGH 32 bits of each result via `>> 32`
# (avoids >= 2^31 literals the driver's const-materialization handles oddly),
# and by negative operands (sign-extension correctness, asr vs lsr). Shift
# amounts and operands are BUILT from casts/shifts, mirroring the style of
# uint_logical_shift_right.cheng.

fn main(): int32 =
    # ---- wide / sign-extended i64 building blocks ----
    let big: int64    = int64(1) << int64(32)               # 0x100000000 (high word = 1)
    let negOne: int64 = int64(0) - int64(1)                  # -1 (all ones across 64 bits)
    # bit patterns spanning BOTH 32-bit halves so a 32-bit-truncation miscompile
    # zeroes the high half and changes the result.
    let patA: int64   = (int64(65280) << int64(32)) | int64(255)    # high 0xFF00, low 0x00FF
    let patB: int64   = (int64(65535) << int64(32)) | int64(65535)  # high 0xFFFF, low 0xFFFF
    # 64-bit unsigned building blocks (exercise A64EncLsrv at full width too).
    let u64AllOnes: uint64 = uint64(0) - uint64(1)           # 0xFFFFFFFFFFFFFFFF
    let u64Hi: uint64      = uint64(1) << uint64(32)         # 0x100000000

    # ---- i64 ADD: width (high-word carry) + sign-extension ----
    if ((big + int64(7)) >> int64(32)) != int64(1):          # 0x100000007 -> high word 1
        return 1
    if (negOne + int64(1)) != int64(0):                      # -1 + 1 must be 0 (64-bit sign)
        return 1

    # ---- i64 SUB: width (high-word borrow into a negative result) ----
    # (0 - big) = -0x100000000 = 0xFFFFFFFF00000000; high word (arith >>32) = -1.
    if ((int64(0) - big) >> int64(32)) != negOne:
        return 2

    # ---- i64 MUL: width (high word of big*3) + signed mul ----
    if ((big * int64(3)) >> int64(32)) != int64(3):          # 0x300000000 -> high word 3
        return 3
    if (negOne * int64(5)) != int64(-5):                     # -1 * 5 = -5 (sign)
        return 3

    # ---- i64 SDIV: signed division, negative dividend ----
    # (0 - big)/4 = -0x40000000 = 0xFFFFFFFFC0000000; high word (arith >>32) = -1.
    if (((int64(0) - big) / int64(4)) >> int64(32)) != negOne:
        return 4
    if ((int64(0) - int64(100)) / int64(4)) != int64(-25):   # -100 / 4 = -25 (sign)
        return 4

    # ---- i64 ASR (arithmetic shift right): width + sign-extension ----
    if (big >> int64(4)) != int64(268435456):                # 0x100000000 >> 4 = 0x10000000
        return 5
    if (negOne >> int64(60)) != negOne:                      # -1 >>arith 60 = -1 (sign fill);
        return 5                                             # a logical shift would give 15.

    # ---- i64 LSL (logical shift left): width across the 32-bit boundary ----
    # 1<<48 -> 0x1000000000000; high word (>>32) = 0x10000 = 65536. A 32-bit
    # shifter (amount mod 32 -> 1<<16) or a 32-bit result truncation gives 0.
    if ((int64(1) << int64(48)) >> int64(32)) != int64(65536):
        return 6

    # ---- i64 LSR (logical shift right, zero-fill) via uint64 ----
    if (u64AllOnes >> uint64(60)) != uint64(15):             # all-ones >>log 60 = 0xF (NOT sign-fill)
        return 7
    if (u64Hi >> uint64(4)) != uint64(268435456):            # 0x100000000 >> 4 = 0x10000000
        return 7

    # ---- i64 BITAND: high half must survive (32-bit truncation zeroes it) ----
    if ((patA & patB) >> int64(32)) != int64(65280):         # 0xFF00 & 0xFFFF = 0xFF00
        return 8

    # ---- i64 BITOR: high half ----
    if ((patA | patB) >> int64(32)) != int64(65535):         # 0xFF00 | 0xFFFF = 0xFFFF
        return 9

    # ---- i64 BITXOR: high half ----
    if ((patA ^ patB) >> int64(32)) != int64(255):           # 0xFF00 ^ 0xFFFF = 0x00FF
        return 10

    # ---- top-bit width: max int64 (0x7FFFFFFFFFFFFFFF) high word ----
    let maxI64: int64 = (int64(1) << int64(63)) - int64(1)
    if (maxI64 >> int64(32)) != int64(2147483647):           # 0x7FFFFFFF
        return 11

    return 0
