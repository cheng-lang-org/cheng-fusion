# form: wide 64-bit hex literals materialized into int64. A 64-bit immediate
# whose value spans the high 32 bits requires a full movz+movk chain (one MOVK
# per nonzero 16-bit group). A truncated materializer that only emits the low
# 16-bit group (or low 32 bits) drops the upper words and returns a wrong value.
# Verified against stage3 via the C stub (full 64-bit value check).

@exportc("wide_hex_a")
fn wide_hex_a(): int64 =
    return int64(0x1234567890ABCDEF)

@exportc("wide_hex_b")
fn wide_hex_b(): int64 =
    return int64(0x100000001)

@exportc("wide_hex_c")
fn wide_hex_c(): int64 =
    return int64(0x00FF00FF00FF00FF)

@exportc("wide_hex_neg")
fn wide_hex_neg(): int64 =
    return int64(-0x1234567890ABCDEF)
