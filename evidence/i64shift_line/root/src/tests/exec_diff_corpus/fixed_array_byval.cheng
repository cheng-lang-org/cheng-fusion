# form: a FIXED-length array `int32[N]` passed BY VALUE into a callee that reads
# (and mutates its local copy of) the array; the caller's array must be
# unaffected. observable: exit code. aggregate_byval_param covered a struct by
# value and nested_array_param covered a SEQ (by-ref header) param; a fixed array
# by value is the distinct case where the WHOLE N*elemSize block is copied into
# the callee frame. A driver bug that passes the array by reference (so callee
# writes leak back) or copies only the first element diverges.
#
# DRIVER MISCOMPILE (blame=DRIVER, net-audit r12): driver returns rc=4
# (`x[0] != 1` after `mutateLocal(x)`) while stage3 returns 0. otool shows the
# driver's `_mutateLocal` does `str x0,[sp,#0x30]` (saves the incoming POINTER)
# then `ldr x9,[sp,#0x30]; str w11,[x9]` — it writes 999 THROUGH the caller's
# pointer, clobbering the caller's array. stage3 materializes the array into the
# callee's own frame (`mov x0,sp; str w2,[x0,w1,uxtw #2]`) so writes stay local.
# i.e. the driver passes a fixed-array-by-value param BY REFERENCE, violating
# value semantics. blame=DRIVER.
fn sumArr(a: int32[4]): int32 =
    return a[0] + a[1] + a[2] + a[3]
fn mutateLocal(a: int32[4]): int32 =
    # mutate the by-value copy; must NOT affect the caller's array.
    a[0] = 999
    a[1] = 888
    return a[0] + a[1]
fn dotScaled(a: int32[4], k: int32): int32 =
    # read every element of the by-value copy via a loop, scale and sum.
    var s: int32
    for i in 0..<4:
        s = s + a[i] * k
    return s
fn main(): int32 =
    var x: int32[4]
    x[0] = 1
    x[1] = 2
    x[2] = 3
    x[3] = 4

    if sumArr(x) != 10:
        return 1
    if dotScaled(x, 3) != 30:
        return 2

    # callee mutates its local copy; caller's x must be intact.
    if mutateLocal(x) != 1887:        # 999 + 888 inside callee
        return 3
    if x[0] != 1:
        return 4
    if x[1] != 2:
        return 5
    if sumArr(x) != 10:               # still the original sum
        return 6

    # build a second array (constant-index init) and pass it by value.
    var y: int32[4]
    y[0] = 10
    y[1] = 20
    y[2] = 30
    y[3] = 40
    if sumArr(y) != 100:              # 10+20+30+40
        return 7
    if dotScaled(y, 2) != 200:
        return 8

    # nested call: result of one byval pass feeds an arithmetic compare.
    if (sumArr(x) + sumArr(y)) != 110:
        return 9
    return 0
