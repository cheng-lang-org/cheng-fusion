# form: implicit_return_short_circuit_tail -- a non-void bool function whose
# body is a single bare short-circuit boolean expression (`&&` / `||`, any
# operand shape including bare bool locals) on the indented line after
# `fn f(...): bool =` (no `return` keyword). #128-r7 (supersedes REFUTED
# #128-r6): the implicit-tail-return scan in parse_fn (cold_parser.c,
# "non-void function block unterminated") only walks ops physically inside
# the function's final block, but parse_logical_expr_cfg (cold_parser.c
# ~15812) lowers `&&`/`||` as a real control-flow branch: it writes the
# boolean result inside the TRUE/FALSE predecessor blocks, then leaves an
# EMPTY join block as the function's current block. The scan found nothing
# there and died at compile time -- not a miscompile, a hard compile-time
# rejection of syntactically and semantically valid Cheng, blocking every
# consumer that writes this idiomatic shape
# (src/libp2p/transports/tcptransport.cheng:tcpListenerValid is the real-
# world instance that surfaced this). Root fix threads the bare-expression-
# statement's already-computed value up via a Parser-level side channel as a
# fallback candidate when the block-local op scan is empty, gated on
# parser->stmt_scope_depth == 0 so the candidate can only ever be the true
# last statement of the function's own top-level body block (see
# cold_defer... no -- see the stmt_tail_expr_has field comment on Parser and
# fix_verdict.md nonExhaustiveIfProof for the r6-defect this depth gate
# closes).
# observable: process exit code. main returns 0 on success, a distinct
# nonzero code per failed sub-check. The diff net compares driver vs stage3
# exit codes; divergence == latent miscompile of the short-circuit tail-
# return fold (as opposed to the pre-fix compile-time rejection, this
# fixture's real bar is that the fold, once accepted, computes the right
# runtime value -- a merged-slot dataflow bug here would still compile
# clean but return the wrong bool).

fn cmpAndTail(idx: int32, limit: int32): bool =
    idx >= 0 && idx < limit

fn orTail(a: bool, b: bool): bool =
    a || b

fn andTail(a: bool, b: bool): bool =
    a && b

fn main(): int32 =
    if cmpAndTail(5, 16) != true:
        return 1
    if cmpAndTail(-1, 16) != false:
        return 2
    if cmpAndTail(20, 16) != false:
        return 3
    if cmpAndTail(0, 16) != true:
        return 4

    if orTail(false, true) != true:
        return 5
    if orTail(false, false) != false:
        return 6
    if orTail(true, false) != true:
        return 7

    if andTail(true, true) != true:
        return 8
    if andTail(true, false) != false:
        return 9
    if andTail(false, false) != false:
        return 10

    # re-call each function a second time with different arguments to
    # confirm the merged join-block result slot is not stale/aliased across
    # calls (a shared-slot dataflow bug would show up as a leftover value
    # from the first call surviving into the second).
    if cmpAndTail(3, 4) != true:
        return 11
    if orTail(true, true) != true:
        return 12
    if andTail(false, true) != false:
        return 13
    return 0
