# form: for-loop body read-modify-write -- `for i in 0..<n: s[i] = s[i] + 1`.
# Lane 1 (#25) connected reproducer: the indexed-store inside a for-range body
# (read s[i], add 1, store back s[i]) was being silently dropped alongside the
# add() drop, leaving s unchanged. observable: process exit code.
fn build(n: int32): int32[] =
    var s: int32[]
    for i in 0..<n:
        add(s, i)
    # read-modify-write each element inside a for-range body
    for i in 0..<n:
        s[i] = s[i] + 1
    return s

fn main(): int32 =
    let s = build(4)
    if s.len != 4:
        return 1
    # original 0,1,2,3 each +1 -> 1,2,3,4
    if s[0] != 1:
        return 2
    if s[1] != 2:
        return 3
    if s[2] != 3:
        return 4
    if s[3] != 4:
        return 5
    return 0
