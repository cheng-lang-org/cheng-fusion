# Stage9 temp allocator: dependent intra-block BinOp/LoadConst chain. t1,t2,t3 are write-once
# I64 temps, each defined and used within ONE block. With the masks (LoadConst temps) in the same
# block they should allocate pool regs (x13/x14/x15) and forward result reg->reg with NO str/ldr
# round-trip. Stage3 is the oracle; main self-asserts the arithmetic.
fn chain(a: int64, b: int64, c: int64, d: int64): int64 =
    let t1: int64 = (a + b) & int64(1048575)
    let t2: int64 = (t1 * c) & int64(1048575)
    let t3: int64 = (t2 - d) & int64(1048575)
    return t3
fn main(): int32 =
    let r: int64 = chain(int64(7), int64(11), int64(3), int64(5))
    # t1=(18)&M=18 ; t2=(18*3)&M=54 ; t3=(54-5)&M=49
    if r != int64(49):
        return 1
    return 0
