# form: global_struct_field_short_circuit_bool -- #156: global `var` struct
# field(s) used as &&/|| operands computed the wrong bool value, no matter
# whether the enclosing fn used implicit or explicit `return`. Root cause
# (bootstrap/cheng_cold.c cold_collect_global_vars_from_source +
# bootstrap/cold_parser.c cold_parse_object_global_initializer): the
# text-level global-var scan only ever constant-folded a `TypeName(field:
# expr, ...)` initializer RHS into static bytes for scalar top-level
# globals (SLOT_I32/I64/F32/F64); for struct/object-kind globals it silently
# dropped the whole RHS with no diagnostic, so `symbols_add_global` zero-
# padded the storage regardless of what the source literal said -- e.g. the
# real production `bitswapContext: BitswapContext = BitswapContext(
# hasStore: false, hasLedger: false, config: BitswapConfig(...
# enableLedger: true ...))` always read back `hasLedger=false` and
# `config.enableLedger=false` no matter what the source wrote, so
# `bitswapLedgerEnabled()` (`bitswapContext.hasLedger &&
# bitswapContext.config.enableLedger`) was permanently wrong. This is the
# GLOBAL-var sibling of implicit_return_short_circuit_tail_fieldaccess.cheng
# (which deliberately used a function-PARAMETER receiver to isolate #128-r7
# and explicitly carved this defect out of its own scope, see that
# fixture's honestResidual note and fix_verdict.md).
#
# Exercises: (1) a multi-line struct-constructor-call global initializer
# (matches bitswapContext's real shape, also regression-locks the paren-
# balance multi-line-initializer-capture fix so interior `field: value,`
# lines aren't misparsed as separate bogus global declarations), (2)
# a nested struct field 2 levels deep in a && chain, (3) a 3-field &&
# chain, (4) || short-circuit, (5) runtime field mutation between calls to
# rule out a stale/shared-slot dataflow bug, (6) explicit `return`.
#
# observable: process exit code. main returns 0 on success, a distinct
# nonzero code per failed sub-check.

type
    LedgerConfig =
        enableLedger: bool
        strict: bool

    LedgerContext =
        hasStore: bool
        hasLedger: bool
        config: LedgerConfig

var
    globalCtx: LedgerContext = LedgerContext(
        hasStore: false,
        hasLedger: true,
        config: LedgerConfig(
            enableLedger: true,
            strict: false
        )
    )

fn ledgerEnabled(): bool =
    return globalCtx.hasLedger && globalCtx.config.enableLedger

fn ledgerChain3(): bool =
    globalCtx.hasStore && globalCtx.hasLedger && globalCtx.config.enableLedger

fn ledgerOr(): bool =
    globalCtx.hasStore || globalCtx.config.strict

fn main(): int32 =
    if ledgerEnabled() != true:
        return 1
    if ledgerChain3() != false:
        return 2
    if ledgerOr() != false:
        return 3

    globalCtx.hasLedger = false
    if ledgerEnabled() != false:
        return 4

    globalCtx.hasLedger = true
    globalCtx.config.enableLedger = false
    if ledgerEnabled() != false:
        return 5

    # flip back and re-check to rule out a stale/shared result slot leaking
    # a prior call's value across calls.
    globalCtx.config.enableLedger = true
    if ledgerEnabled() != true:
        return 6

    globalCtx.hasStore = true
    if ledgerChain3() != true:
        return 7
    if ledgerOr() != true:
        return 8

    return 0
