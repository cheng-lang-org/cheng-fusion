# form: assign-form scalar-ternary with a call in the not-selected arm.
# Exercises PrimaryBodyIrAppendI32Assign's ternary path (distinct from the
# let/local_decl form in scalar_ternary_call.cheng). The eager branchless
# lowering evaluates BOTH arms; when the not-selected arm is a call it runs
# anyway and the wrong value is selected. The real cbr branch must only run
# the selected arm.
fn other(flag: int32): int32 =
    return flag + 99

fn fa(): int32 =
    return 7

fn fb(): int32 =
    return 13

fn main(): int32 =
    let flag: int32 = 2
    var pick: int32
    let cond1: int32 = 1
    let cond0: int32 = cond1 - 1
    # cond true: must assign 11, the call other(flag) must NOT run/select.
    pick = cond1 ? 11 : other(flag)
    if pick != 11:
        return 1
    # cond false: must assign other(flag) = 101.
    pick = cond0 ? 11 : other(flag)
    if pick != 101:
        return 2
    # both arms calls, cond true -> fa()=7
    pick = cond1 ? fa() : fb()
    if pick != 7:
        return 3
    # both arms calls, cond false -> fb()=13
    pick = cond0 ? fa() : fb()
    if pick != 13:
        return 4
    return 0
