# form (net-audit r16): map an enum value to a multi-BYTE label and a length —
# `labelLen(d)` is a match whose every arm `=> return <len>`, and the label bytes
# are written into a `main`-local buffer by a match whose arm bodies are
# multi-statement byte stores (the cold front-end can't return a fixed array by
# value, so the buffer is a real local filled inline). r15_enum_match_return_arms
# returned a scalar per arm; this couples a per-arm RETURN-length match with a
# per-arm multi-store match into a shared local. Stresses: two matches on the same
# enum — one with terminator (return) arms, one with multi-statement store arms —
# where each arm must do its own distinct work and the post-match path must not
# swallow the per-arm stores. observable: exit code.
#
# DRIVER MISCOMPILE (blame=DRIVER, net-audit r16): driver returns rc=3 (`sb[2] !=
# 85` — South's 3rd byte missing) while stage3 returns 0. Reduced to TWO
# consecutive `match` statements each doing indexed array stores into a DIFFERENT
# `main`-local array (`buf` then `sb`): the second array's stores are dropped/
# mis-slotted (driver rc=1 on the reduced `sb[0]!=83`). otool on the driver's
# `_main` shows the two matches' element-address scratch temporaries reuse the
# SAME stack slot ([sp,#0x50] appears in both the `buf` match and the `sb` match),
# so the second match corrupts/overwrites the first array's storage and `sb` is
# left unwritten. A SINGLE multi-store match arm compiles correctly; the fault
# emerges only with two indexed-store matches coexisting. stage3 keeps the arrays'
# slots distinct. blame=DRIVER (stack-slot allocator collision across two indexed-
# store match statements — same allocator class as r16_char_classify).
type Dir = enum
    North
    East
    South
    West
fn labelLen(d: Dir): int32 =
    match d:
        North => return 2
        East => return 1
        South => return 3
        West => return 1
    return 0
fn firstByte(d: Dir): int32 =
    match d:
        North => return 78
        East => return 69
        South => return 83
        West => return 87
    return 0
fn main(): int32 =
    # fill a local buffer for North ("NO") via inline stores, cross-check length
    # and bytes.
    var buf: int32[8]
    match Dir.North:
        North =>
            buf[0] = 78
            buf[1] = 79
        East =>
            buf[0] = 69
        South =>
            buf[0] = 83
            buf[1] = 79
            buf[2] = 85
        West =>
            buf[0] = 87
    if buf[0] != 78:
        return 1
    if buf[1] != 79:
        return 2
    # South ("SOU") into a fresh buffer.
    var sb: int32[8]
    match Dir.South:
        North =>
            sb[0] = 78
            sb[1] = 79
        East =>
            sb[0] = 69
        South =>
            sb[0] = 83
            sb[1] = 79
            sb[2] = 85
        West =>
            sb[0] = 87
    if sb[0] != 83:
        return 3
    if sb[1] != 79:
        return 4
    if sb[2] != 85:
        return 5
    # lengths per arm.
    if labelLen(Dir.North) != 2:
        return 6
    if labelLen(Dir.East) != 1:
        return 7
    if labelLen(Dir.South) != 3:
        return 8
    if labelLen(Dir.West) != 1:
        return 9
    # first byte per arm (distinct discriminant -> distinct value).
    if firstByte(Dir.North) != 78:
        return 10
    if firstByte(Dir.East) != 69:
        return 11
    if firstByte(Dir.South) != 83:
        return 12
    if firstByte(Dir.West) != 87:
        return 13
    # the four lengths sum to 2+1+3+1 = 7.
    let total: int32 = labelLen(Dir.North) + labelLen(Dir.East) + labelLen(Dir.South) + labelLen(Dir.West)
    if total != 7:
        return 14
    # the filled buffer's first byte matches firstByte for the same enum.
    if buf[0] != firstByte(Dir.North):
        return 15
    if sb[0] != firstByte(Dir.South):
        return 16
    return 0
