# form (net-audit r16): REVERSE the low 8 bits of an integer — pull bit i off the
# bottom (`v & 1`), shift it into the result from the top (`r = (r<<1) | bit`),
# `v = v>>1`, eight times. r15_bit_popcount only COUNTED set bits; r14_bit_field
# _setget did fixed-position get/set. This does a shift-in/shift-out reversal loop
# where the result is built MSB-first while the source is consumed LSB-first.
# Stresses: a left-shift-accumulate of a single masked bit, a right-shift consume
# of the source, both inside the same loop body so a mis-ordered shift/or or a
# clobbered accumulator diverges. observable: exit code.
fn reverse8(x: int32): int32 =
    var v: int32 = x
    var r: int32
    var i: int32
    while i < 8:
        r = (r << 1) | (v & 1)
        v = v >> 1
        i = i + 1
    return r
fn main(): int32 =
    # 0b0000_0001 (1) reversed -> 0b1000_0000 (128).
    if reverse8(1) != 128:
        return 1
    # 0b1000_0000 (128) reversed -> 1.
    if reverse8(128) != 1:
        return 2
    # 0b0000_0000 -> 0, 0b1111_1111 (255) -> 255 (palindromic).
    if reverse8(0) != 0:
        return 3
    if reverse8(255) != 255:
        return 4
    # 0b0000_0011 (3) -> 0b1100_0000 (192).
    if reverse8(3) != 192:
        return 5
    # 0b1010_1010 (170) -> 0b0101_0101 (85).
    if reverse8(170) != 85:
        return 6
    if reverse8(85) != 170:
        return 7
    # reversal is an involution on the low byte: reverse8(reverse8(x)) == x.
    var k: int32
    while k < 256:
        if reverse8(reverse8(k)) != k:
            return 8
        k = k + 1
    # 0b0001_0010 (18) -> 0b0100_1000 (72).
    if reverse8(18) != 72:
        return 9
    return 0
