var
    gTarget: int32

# User-defined function whose bare name happens to collide with the Result
# intrinsic template name "Value". Takes a plain int32 (NOT a Result), so it
# must never be mistaken for the Result-projection intrinsic.
fn Value(x: int32): int32 =
    return x + 1000

fn callerGlobal(x: int32): int32 =
    gTarget = Value(x)
    return gTarget

fn main(): int32 =
    let r = callerGlobal(5)
    if r != 1005:
        return 1
    return 0
