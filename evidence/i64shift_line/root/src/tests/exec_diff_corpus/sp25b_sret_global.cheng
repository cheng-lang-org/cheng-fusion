# Phase 2.5+ census: an sret (struct-returning) call whose destination is a
# GLOBAL aggregate. `gBox = mk()` makes x8 (the indirect-result pointer) point at
# the global's __data storage via an adrp+add PAGE/PAGEOFF reloc emitted in the
# call sequence (FillCallOp, the IndirectResultIsGlobal path). If that x8 adrp
# reloc word offset is wrong, the callee writes the returned struct to the WRONG
# address; the global keeps its zero-init and the field reads back wrong -> exit
# code changes. We assign two distinct structs to the global and re-check each
# field after each assignment, so a mis-targeted x8 reloc is observable.
# observable: process exit code. driver (node path) vs stage3 (cold) must agree.
# No stub: main(): int32 IS the observable, linked via the shared runtime.
type Box =
    a: int32
    b: int32

var gBox: Box

fn mk(x: int32, y: int32): Box =
    return Box(a: x, b: y)

fn main(): int32 =
    gBox = mk(11, 22)
    if gBox.a != 11:
        return 1
    if gBox.b != 22:
        return 2
    gBox = mk(333, 444)
    if gBox.a != 333:
        return 3
    if gBox.b != 444:
        return 4
    return 0
