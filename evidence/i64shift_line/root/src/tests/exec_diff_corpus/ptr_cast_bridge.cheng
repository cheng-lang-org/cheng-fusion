# form: ptr-cast / StrPtr via C-stub bridge (bail_622 style).
# @exportc fns build str values internally (string literals + ternary select),
# then return a SCALAR derived from them. The C stub supplies the runtime
# bridge symbols (driver_c_str_from_utf8_copy_bridge + setMem) and verifies the
# returned scalars. This exercises the str->ChengStrBridge {ptr,len,...} ABI
# lowering and the cstring literal store WITHOUT exposing a Cheng str across the
# C ABI (which the no-pointer/SABI gate forbids). Compiled emit:obj, linked
# against ptr_cast_bridge.stub.c.
fn rawFor(n: int32): str =
    if n == 0:
        return ""
    if n == 1:
        return "hello"
    return "longer-text"

@exportc("ecd_len_of")
fn ecd_len_of(n: int32): int32 =
    let s = rawFor(n)
    return Len(s)

@exportc("ecd_pick_len")
fn ecd_pick_len(n: int32): int32 =
    let s = rawFor(n)
    let chosen = Len(s) > 0 ? s : "-"
    return Len(chosen)
