# form: branch compare against a NEGATIVE rhs constant and against a rhs
# constant > 4095 -- exercises backend2 slice-3 leaf CondA64TrueCode via the
# Cbr rhsConst arm crossed with the A64EncCmpImm domain (imm12 accepts only
# 0..4095; imm<0 or >4095 must be materialized into a register CmpReg, an
# encoder Err there yields a 0-word op -> zero-scan hard crash = designed
# signal, no silent fallback). The 7-fixture golden ladder only compares
# against small nonneg constants. Part of the backend2 slice-3 leaf coverage
# battery. expected runtime: f(0)=1, f(-10)=0, g(99999)=1, g(200000)=0 ->
# main returns 0. observable: exit code.
fn f(x: int32): int32 =
    if x > 0 - 5:
        return 1
    return 0

fn g(y: int64): int32 =
    if y <= int64(100000):
        return 1
    return 0

fn main(): int32 =
    if f(0) != 1:
        return 1
    if f(0 - 10) != 0:
        return 2
    if g(int64(99999)) != 1:
        return 3
    if g(int64(200000)) != 0:
        return 4
    return 0
