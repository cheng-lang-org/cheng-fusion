# CROSS-MODULE form of global_seq_aggregate_elem_byval: the module-global seq of a
# LARGE aggregate AND the function that reads `g[i]` by value live in an IMPORTED
# module (exec_diff_corpus_global_seq_mod), so the global's registration
# source-path normalizes differently from the accessing function's runtime
# sourcePath — the real `loweringParallelResults[i]` mismatch the single-module
# c857 fixture (exact source-path) could not reproduce. Before this fix the leaf
# aggregate type-shape resolved size 0 under the caller sourcePath → bail_44 →
# bodySemanticsMissing. observable: exit code.
import cheng/tests/exec_diff_corpus_global_seq_mod as gmod

fn main(): int32 =
    gmod.ModInit()

    var i: int32
    # element 1: base=200 → sum = 10*200 + (0+1+..+9) = 2045
    i = 1
    if gmod.ModSumAt(i) != 2045:
        return 1

    # element 0: base=100 → sum = 1045
    i = 0
    if gmod.ModSumAt(i) != 1045:
        return 2

    # element 2: base=300 → sum = 3045
    i = 2
    if gmod.ModSumAt(i) != 3045:
        return 3

    return 0
