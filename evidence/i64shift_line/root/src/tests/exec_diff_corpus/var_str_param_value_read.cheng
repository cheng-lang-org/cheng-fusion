# form: var-str param read AS A VALUE inside a concat expression. A `var str`
# param slot is built as Aggregate(24)+aux=Str holding the destination ADDRESS;
# to use its current value (`out = out + key`) the node path must FieldLoad the
# pointed-to str (same protocol the var-str ASSIGN store path already uses to
# materialize a param str). That read used to be deferred to the text path,
# which then fell to cold (bail_44) whenever it appeared inside a seq-literal /
# general expression. This fixture mutates a var-str param by appending to its
# OWN value, then observes only Len(result) (a scalar) — no str crosses the C
# ABI. driver (node path) vs stage3 (cold) runtime Len must agree.
# observable: process exit code. main returns 0 on success, distinct nonzero per
# failed sub-check. Linked against var_str_param_value_read.stub.c.
fn appendTwice(out: var str, key: str) =
    out = out + key
    out = out + key

fn build(seed: str, key: str): str =
    var acc = seed
    appendTwice(acc, key)
    return acc

fn main(): int32 =
    # "" + "ab" + "ab" -> len 4
    if Len(build("", "ab")) != 4:
        return 1
    # "x" + "yz" + "yz" -> len 5
    if Len(build("x", "yz")) != 5:
        return 2
    # empty key leaves seed unchanged -> len 5
    if Len(build("hello", "")) != 5:
        return 3
    # longer seed, single-char key appended twice -> 3 + 1 + 1 = 5
    if Len(build("foo", "q")) != 5:
        return 4
    return 0
