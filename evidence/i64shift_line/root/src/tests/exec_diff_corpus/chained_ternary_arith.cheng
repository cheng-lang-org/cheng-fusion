# form: ternary expressions used as ARITHMETIC operands — the result of a `?:`
# feeds directly into +, -, *, and is used as an array index. observable: exit
# code. nested_ternary / mixed_ternary_sum nested ternaries in plain position;
# this places a (flat) ternary inside an arithmetic expression
# (a + (cond ? x : y) * k) and a nested ternary in pure return position
# (`sign`), exercising the driver's value materialization of a select feeding an
# arith op. r1-8 never put a ternary as an arithmetic operand on the observable.
#
# NOTE: a NESTED ternary feeding an arith op directly — `(c0 ? a : (c1 ? b : c))
# + K` — is currently a DRIVER compile gap (valueOp=unsupported, plan not ready),
# so that exact form is intentionally NOT used here; it is recorded as a
# not-ready form for the next batch.
fn sign(x: int32): int32 =
    return x > 0 ? 1 : (x < 0 ? (0 - 1) : 0)

fn main(): int32 =
    # flat ternary as a multiplicand: 5 + (true ? 3 : 9) * 2 = 5 + 6 = 11.
    let r1: int32 = 5 + (1 > 0 ? 3 : 9) * 2
    if r1 != 11:
        return 1
    # flat ternary as a multiplicand, false branch: 5 + (false ? 3 : 9) * 2 = 23.
    let r2: int32 = 5 + (1 < 0 ? 3 : 9) * 2
    if r2 != 23:
        return 2
    # nested chained ternary in pure return position (sign function).
    if sign(7) != 1:
        return 3
    if sign(0 - 4) != (0 - 1):
        return 4
    if sign(0) != 0:
        return 5
    # two flat ternaries summed: (a?:) + (b?:).
    let a: int32 = 3
    let b: int32 = 8
    let s: int32 = (a > b ? a : b) + (a < b ? a : b)
    if s != 11:
        return 6
    # flat ternary whose condition is itself an arith compare, feeding subtraction.
    let t: int32 = 100 - (a + b > 10 ? 5 : 50)
    if t != 95:
        return 7
    # flat ternary result used as an array index.
    var arr: int32[4]
    arr[0] = 7
    arr[1] = 14
    arr[2] = 21
    arr[3] = 28
    let idx: int32 = a < b ? 2 : 0
    if arr[idx] != 21:
        return 8
    # flat ternary in a multiply that feeds another add.
    let u: int32 = (a < b ? 4 : 1) * 3 + 1
    if u != 13:
        return 9
    # chained via two separate flat ternaries (not nested): sel two flags.
    let f1: int32 = a > 0 ? 1 : 0
    let f2: int32 = b > 5 ? 10 : 20
    if (f1 * 100 + f2) != 110:
        return 10
    return 0
