# form: enum construction + integer-value comparison (ordinal lowering).
# observable: exit code. Uses if/elif (not `case`, which the cold reference
# can't parse) so both compilers lower it. Exercises enum->ordinal and explicit
# enum values.
type
    Color = enum
        Red
        Green
        Blue
    Code = enum
        Ok = 0
        Warn = 5
        Fail = 9
fn rank(c: Color): int32 =
    if c == Color.Red:
        return 1
    if c == Color.Green:
        return 2
    return 3
fn codeVal(c: Code): int32 =
    return int32(c)
fn main(): int32 =
    if rank(Color.Red) != 1:
        return 1
    if rank(Color.Green) != 2:
        return 2
    if rank(Color.Blue) != 3:
        return 3
    if codeVal(Code.Ok) != 0:
        return 4
    if codeVal(Code.Warn) != 5:
        return 5
    if codeVal(Code.Fail) != 9:
        return 6
    return 0
