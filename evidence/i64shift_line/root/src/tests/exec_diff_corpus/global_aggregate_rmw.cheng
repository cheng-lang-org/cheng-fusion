# form: a GLOBAL STRUCT variable read-modify-written across calls. Each call
# loads a field of the global, adds to it, and stores it back; the accumulation
# must persist in the global between calls and be visible to main. observable:
# exit code. global_rmw covered a scalar global; this covers an *aggregate*
# global, whose fields must be addressed off the global symbol (adrp+add), not a
# stack slot.
#
# DRIVER MISCOMPILE (blame=DRIVER): the driver lowers `gAcc.total`/`gAcc.count`
# to STACK slots ([sp,#0x10]/[sp,#0x14]) and never emits an `adrp` for the global
# symbol — so the "global" aggregate actually lives on add2's frame, starts as
# garbage, and the writeback is invisible to main. stage3 correctly addresses the
# global (adrp x0,<gAcc>; ldr/str [x2{,#0x4}]). First failing assert: add2(10)
# must return 10 but the driver returns a stack-garbage-derived value.
type Acc =
    total: int32
    count: int32

var gAcc: Acc

fn add2(v: int32): int32 =
    gAcc.total = gAcc.total + v
    gAcc.count = gAcc.count + 1
    return gAcc.total

fn reset(): int32 =
    gAcc.total = 0
    gAcc.count = 0
    return gAcc.total

fn main(): int32 =
    # first accumulation step: 0 + 10 = 10.
    if add2(10) != 10:
        return 1
    # second step persists the global: 10 + 5 = 15.
    if add2(5) != 15:
        return 2
    # third step: 15 + 100 = 115.
    if add2(100) != 115:
        return 3
    # the count field tracked every call.
    if gAcc.count != 3:
        return 4
    # total directly readable from the global.
    if gAcc.total != 115:
        return 5
    # reset clears the global, then re-accumulate.
    if reset() != 0:
        return 6
    if gAcc.total != 0:
        return 7
    if gAcc.count != 0:
        return 8
    if add2(7) != 7:
        return 9
    if gAcc.count != 1:
        return 10
    return 0
