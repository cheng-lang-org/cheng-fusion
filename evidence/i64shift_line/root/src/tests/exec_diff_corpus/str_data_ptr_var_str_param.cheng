# form: StrDataPtr(out) where `out` is a `var str` param (G10). A var-str param
# slot is Aggregate(24)+aux=Str holding the str RECORD ADDRESS, not the inline
# 24-byte str value. StrDataPtr(out) must therefore deref that address once,
# then read field 0 (the data pointer) — the same address-indirect FieldLoad the
# var-str `len` read already uses. Before the G10 fix the StrDataPtr-arg lowering
# required the root slot to be a PLAIN str slot (LocalStrTag) and bailed (detail
# 27) on the var-str param, dropping parser.cheng:ParserWriteByteFast to cold.
# This mirrors that exact form:
#   cheng_rawmem_write_i8(StrDataPtr(out), pos, int8(value))   # ParserWriteByteFast
#
# The writable buffer comes from a str concat ("ab"+"cd" -> fresh 4-byte malloc
# buffer via driver_c_str_concat_bridge) so the in-place byte writes are legal.
# We overwrite all 4 bytes through StrDataPtr(out), read them back via inline str
# indexing (no str crosses the C ABI), and check the values + sum.
# observable: process exit code. driver (node path) vs stage3 (cold) must agree.
# Linked against str_data_ptr_var_str_param.stub.c (concat/from_utf8 bridges +
# setMem + cheng_rawmem_write_i8). The byte writer is declared @importc so the
# fixture pulls in NO std import closure (the corpus self-containment rule).
@importc("cheng_rawmem_write_i8")
fn rawWriteI8(dst: ptr, idx: int32, v: int8)

# Local StrDataPtr definition so the fixture pulls in NO std import closure
# (which drags cold-only fns like result.ErrorInfoOf and breaks the all-or-
# nothing obj emission). The node path intercepts `StrDataPtr(out)` at the call
# site by name (inline FieldLoad off the var-str slot) and never calls this
# body; this body exists only so the cold reference path resolves the symbol. It
# is a single ptr-field return (`s.data`) so the node path can also lower it.
fn StrDataPtr(s: str): ptr =
    return s.data

fn writeByte(out: var str, pos: var int32, value: int32) =
    rawWriteI8(StrDataPtr(out), pos, int8(value))
    pos = pos + 1

fn fill(dst: var str) =
    var pos: int32
    writeByte(dst, pos, 11)
    writeByte(dst, pos, 22)
    writeByte(dst, pos, 33)
    writeByte(dst, pos, 44)

fn main(): int32 =
    var buf = "ab" + "cd"
    if Len(buf) != 4:
        return 1
    fill(buf)
    if Int32(buf[0]) != 11:
        return 2
    if Int32(buf[1]) != 22:
        return 3
    if Int32(buf[2]) != 33:
        return 4
    if Int32(buf[3]) != 44:
        return 5
    let total = Int32(buf[0]) + Int32(buf[1]) + Int32(buf[2]) + Int32(buf[3])
    if total != 110:
        return 6
    return 0
