# form (net-audit r16): a CAST chain that runs a NEGATIVE int32 through narrower
# and wider signed/unsigned types and back, checking sign-extension and
# truncation behavior. r15_cast_chain_with_bool ran a value through bool; cast
# _chain did ptr<->uint roundtrips on positives. This pushes a negative through
# int32 -> int64 (sign-extend) -> int32 (truncate back) and int32 -> int8-range
# wrap, exercising the SIGNED widening path (must replicate the sign bit) versus
# the narrowing truncation. Stresses: sign-extension on int32->int64 of a
# negative, low-byte truncation, and that `int32(int64(n)) == n` round-trips for
# negatives. observable: exit code.
fn widen(n: int32): int64 =
    return int64(n)
fn narrow(x: int64): int32 =
    return int32(x)
fn main(): int32 =
    let n: int32 = 0 - 5
    # sign-extend to int64 then truncate back: round-trips for a negative.
    let w: int64 = widen(n)
    if w != int64(0 - 5):
        return 1
    if narrow(w) != n:
        return 2
    # a large negative survives the int32->int64->int32 round trip.
    let big: int32 = 0 - 2000000000
    if narrow(widen(big)) != big:
        return 3
    # widened negative is still less than zero (sign preserved, not zero-extended
    # into a huge positive).
    if widen(0 - 1) >= int64(0):
        return 4
    # int64(-1) is all-ones; adding 1 gives 0.
    if widen(0 - 1) + int64(1) != int64(0):
        return 5
    # mixed-width arithmetic: int64 sum of two negatives stays negative.
    let s: int64 = widen(0 - 100) + widen(0 - 200)
    if s != int64(0 - 300):
        return 6
    if narrow(s) != (0 - 300):
        return 7
    # truncating a positive int64 that exceeds int32 range still equals its low
    # 32 bits round-tripped through narrow(widen()) for in-range values.
    let p: int32 = 123456
    if narrow(widen(p)) != p:
        return 8
    # negation chain: -(-(n)) == n through casts.
    let nn: int64 = int64(0) - widen(n)
    if narrow(int64(0) - nn) != n:
        return 9
    return 0
