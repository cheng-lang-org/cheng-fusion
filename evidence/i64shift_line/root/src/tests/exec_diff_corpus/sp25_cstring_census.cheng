# Phase 2.5 census: a string literal materialized into a str field, whose
# runtime LENGTH is the observable. If the cstring ADRP page/pageoff reloc word
# offset is wrong, the loaded pointer is bogus and len() (or the bytes) differ,
# changing the exit code. main(): int32 IS the observable (no stub).
type Box =
    label: str
    n: int32

fn mk(): Box =
    return Box(label: "phase25", n: 42)

fn main(): int32 =
    let b = mk()
    if b.n != 42:
        return 1
    if len(b.label) != 7:
        return 2
    return 0
