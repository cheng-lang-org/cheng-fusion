# form: ErrCode[T](code,msg) constructed error read back via ErrorInfoOf --
# exercises the ErrCode construction arm (code+msg two-arg layout) AND the
# ErrorInfoOf err-block projection. This is the runtime scaffold the 00136406
# case file asked for (str-leaf ground truth: census clean is necessary, not
# sufficient). Red on drivers where ErrCode template leaks to the frontier
# (bail=711 pre-S2). observable: exit code.
import std/result

fn boom(): Result[bool] =
    return ErrCode[bool](7, "boom")

fn main(): int32 =
    var r: Result[bool] = boom()
    if IsOk(r):
        return 1
    let info: ErrorInfo = ErrorInfoOf(r)
    if ErrorCodeOf(info) != 7:
        return 2
    let msg: str = ErrorMessage(info)
    if Len(msg) != 4:
        return 3
    return 0
