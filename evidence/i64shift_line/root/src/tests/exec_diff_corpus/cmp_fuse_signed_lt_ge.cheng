# form: signed integer < and >= compares feeding `if`/`while` conditions via the
# node-eval path (separate BodyOpCmp writes a bool slot, a LocalNonZero Cbr reads
# it). Stage 10 Cmp->Cbr fusion drops the cset+bool-store and branches straight
# from the compare flags as `b.lt`/`b.ge`. The bool is single-use (read only by
# the terminating Cbr) so fusion is provably safe. Stage3 is the oracle; both
# compilers must agree. signed lt/ge cond-code + polarity correctness.
fn classify(x: int64): int64 =
    var acc: int64 = int64(0)
    var i: int64 = int64(0)
    # `while i < n` -- signed LT fused header
    while i < x:
        if i < int64(3):
            acc = acc + int64(1)
        if i >= int64(5):
            acc = acc + int64(10)
        i = i + int64(1)
    return acc
fn main(): int32 =
    # i in 0..8 : i<3 fires for {0,1,2}=3, i>=5 fires for {5,6,7}=3 -> 3 + 3*10 = 33
    let r: int64 = classify(int64(8))
    if r != int64(33):
        return 1
    return 0
