# form: a match on one enum whose arms contain a second match on another enum
# (nested dispatch tree). observable: exit code. enum_value used if/elif; this
# uses real `match`/`=>` arms (both compilers parse it, per cold_match smoke) and
# nests them, stressing the jump-table / compare-chain lowering for a 2-level
# discriminant decision.
type Op = enum
    Add
    Sub
    Mul
type Sign = enum
    Pos
    Neg
fn apply(op: Op, sg: Sign, a: int32, b: int32): int32 =
    var base: int32
    match op:
        Add => base = a + b
        Sub => base = a - b
        Mul => base = a * b
    var out: int32
    match sg:
        Pos => out = base
        Neg => out = 0 - base
    return out
fn main(): int32 =
    if apply(Op.Add, Sign.Pos, 3, 4) != 7:
        return 1
    if apply(Op.Add, Sign.Neg, 3, 4) != (0 - 7):
        return 2
    if apply(Op.Sub, Sign.Pos, 10, 3) != 7:
        return 3
    if apply(Op.Sub, Sign.Neg, 10, 3) != (0 - 7):
        return 4
    if apply(Op.Mul, Sign.Pos, 6, 7) != 42:
        return 5
    if apply(Op.Mul, Sign.Neg, 6, 7) != (0 - 42):
        return 6
    return 0
