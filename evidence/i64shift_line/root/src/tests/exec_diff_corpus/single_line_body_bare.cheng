# form: single-line bare-expression body -- `fn f(...): T = <expr>` (implicit
# return, no `return` keyword) on the SAME line as `=`. Same broad-spectrum
# drop as single_line_body; driver returned garbage, stage3 correct.
fn dbl(x: int32): int32 = x + x
fn main(): int32 =
    let r = dbl(21)
    if r != 42:
        return 1
    return 0
