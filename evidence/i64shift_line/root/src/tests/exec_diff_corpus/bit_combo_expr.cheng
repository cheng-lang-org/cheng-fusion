# form: a single expression combining several bitwise operators (& | ^ << >>)
# with precedence, on runtime int32 operands. observable: exit code.
# bit_popcount/zero_local_shift_or cover intrinsics and shift|or; this packs &,
# |, ^, <<, >> into combined sub-expressions so the driver must order them by
# precedence and feed intermediate results forward. (Avoids ~ and 0b literals,
# which the cold reference front-end does not parse — keeps blame unambiguous.)
#
# DRIVER MISCOMPILE (blame=DRIVER, found net-audit r11): in the full function
# the driver DROPS `let flags: int32 = 45` — otool shows slot [sp,#0xb0] (where
# assert 7 reads `flags`) is only ever READ, never written, and the literal 45
# (0x2d) is never materialized anywhere. So `(flags>>3)&1` reads stack garbage
# and the result is NON-DETERMINISTIC across runs (rc flips 7<->9). stage3 is
# clean (rc=0). Same constant-local materialization-drop family as
# cast_in_call_arg; manifests only past a prior-statement / slot-pressure
# threshold (the isolated assert-9 form and a 7-statement prefix both
# materialize correctly). Next batch: ensure a constant-initialized local read
# inside a later compound expression is always materialized. blame=DRIVER.
fn mix(a: int32, b: int32, c: int32): int32 =
    # ((a & b) | (a ^ c)) with a shift on the result.
    return ((a & b) | (a ^ c)) << 1
fn main(): int32 =
    # a=12 (0xC), b=10 (0xA), c=6.
    # a&b = 8 ; a^c = 10 ; 8|10 = 10 ; <<1 = 20.
    if mix(12, 10, 6) != 20:
        return 1
    # XOR is its own inverse: (x ^ y) ^ y == x.
    let x: int32 = 0xABCD
    let y: int32 = 0x1234
    if ((x ^ y) ^ y) != x:
        return 2
    # AND masks the low byte.
    if (0x12345678 & 0xFF) != 0x78:
        return 3
    # OR sets bits, then shift-right recovers a field.
    let packed: int32 = (0x12 << 8) | 0x34
    if packed != 0x1234:
        return 4
    if (packed >> 8) != 0x12:
        return 5
    if (packed & 0xFF) != 0x34:
        return 6
    # single-bit test via shift+and on a runtime value.
    let flags: int32 = 45        # 0b101101
    if ((flags >> 3) & 1) != 1:
        return 7
    if ((flags >> 1) & 1) != 0:
        return 8
    # XOR toggles a bit, AND clears it, OR sets it — combined in one expression.
    let v: int32 = 15            # 0b1111
    if ((v & (0xFF ^ (1 << 2))) | (1 << 4)) != 27:   # clear bit2 -> 11, set bit4 -> 27
        return 9
    # shift-left then shift-right round-trips a masked field.
    let field: int32 = (300 << 4) >> 4
    if field != 300:
        return 10
    # combine AND/OR/XOR feeding a compare in one expression.
    if (((12 & 10) | 1) ^ 3) != 10:   # 8|1=9 ; 9^3 = 10.
        return 11
    return 0
