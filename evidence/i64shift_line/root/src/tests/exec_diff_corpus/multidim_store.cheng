# form: 2D fixed-length array store -- int32[3][3] zero-init then grid[i][j]=v read back.
# observable: process exit code (return 0 iff every cell reads back correctly).
# covers row-major element address (base + (i*cols + j)*elemSize) + fixed 2D zero-init.
fn main(): int32 =
    var grid: int32[3][3]
    # every cell must zero-init.
    if grid[0][0] != 0:
        return 1
    if grid[1][2] != 0:
        return 2
    if grid[2][0] != 0:
        return 3
    grid[1][2] = 5
    grid[2][0] = 9
    # the two stores must land in distinct row-major cells.
    if grid[1][2] != 5:
        return 4
    if grid[2][0] != 9:
        return 5
    # untouched cells must remain zero (no aliasing / no stack garbage).
    if grid[0][0] != 0:
        return 6
    if grid[2][2] != 0:
        return 7
    if grid[1][0] != 0:
        return 8
    return 0
