# form: i64 accumulator loop where the carried slot is ALSO read by a CopyLocal
# SOURCE (snap = acc). This is the EXACT bug the prior buggy 5c miscompiled: it
# dropped the per-iter store, so `snap = acc` (a memory load of acc) saw the
# stale pre-header value. The 5c conservative gate MUST KEEP the eager store
# here (snap=acc is a non-R-redirected memory read of acc) => stays correct.
# acc = 0+0+1+2+...+9 = 45; snap holds the final acc; exit derived from snap.
fn snapLast(n: int64): int64 =
    var acc: int64 = int64(0)
    var snap: int64 = int64(0)
    var i: int64 = int64(0)
    while i < n:
        let t: int64 = acc + i
        acc = t
        snap = acc
        i = i + int64(1)
    return snap
fn main(): int32 =
    let r: int64 = snapLast(int64(10))
    if r != int64(45):
        return 1
    return 0
