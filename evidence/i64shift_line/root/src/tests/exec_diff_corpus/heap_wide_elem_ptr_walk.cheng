# 漏网哨兵 ① 的循环形 — while 循环内按索引算偏移, named-ptr return-form 宽读元素.
#
# 触发点: 循环体每轮 `let q: I64P = I64P(ptr(raw + i*8)); return *q` (helper) 读回
#   一个 int64 元素并累加. r16_ptr_walk_array 只走 int32 且靠 C-stub; 本夹具自足
#   (malloc, 无 stub 无 &) 且元素为高 32 位敏感的 int64, 循环 + 指针偏移 + 宽读组合.
#   宽 return-form load 若截断(旧 bug), 累加和错. drv_fix rc=0, drv_base rc=1. 期望 0.

type
    I64P = int64 *

@importc("malloc")
fn c_malloc(n: uint64): ptr

fn storeAt(raw: ptr, i: uint64, v: int64): void =
    let q: I64P = I64P(ptr(uint64(raw) + i * uint64(8)))
    *q = v

fn loadAt(raw: ptr, i: uint64): int64 =
    let q: I64P = I64P(ptr(uint64(raw) + i * uint64(8)))
    return *q

fn main(): int32 =
    let raw = c_malloc(uint64(32))
    storeAt(raw, uint64(0), 4294967338)
    storeAt(raw, uint64(1), 8589934676)
    storeAt(raw, uint64(2), 100)
    storeAt(raw, uint64(3), 200)
    var i: uint64 = uint64(0)
    var s: int64 = int64(0)
    while i < uint64(4):
        s = s + loadAt(raw, i)
        i = i + uint64(1)
    if s != 4294967338 + 8589934676 + int64(100) + int64(200):
        return 1
    if loadAt(raw, uint64(0)) != 4294967338:
        return 2
    return 0
