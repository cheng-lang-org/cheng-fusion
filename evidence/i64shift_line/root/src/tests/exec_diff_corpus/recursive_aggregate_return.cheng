# form: recursion that returns an aggregate (accumulator struct) at each level.
# observable: exit code. Exercises aggregate-return through a recursive call
# chain (sret slot reuse / clobber across self-calls).
type
    Acc =
        sum: int32
        count: int32
fn walk(n: int32): Acc =
    if n <= 0:
        return Acc(sum: 0, count: 0)
    let rest = walk(n - 1)
    return Acc(sum: rest.sum + n, count: rest.count + 1)
fn main(): int32 =
    let a = walk(5)
    if a.sum != 15:
        return 1
    if a.count != 5:
        return 2
    let b = walk(10)
    if b.sum != 55:
        return 3
    if b.count != 10:
        return 4
    return 0
