# form: `>>` signedness — unsigned operands MUST emit logical shift right (lsr),
# signed operands MUST keep arithmetic shift right (asr). The bug (Lane 2): the
# context-less base scalar slot builder only recognised an unsigned *cast* LHS,
# so a bare unsigned param/local (`a >> n`) fell through to the signed `asr`
# default and sign-extended high bits into the result.
#
# This is a SHARED miscompile (driver AND stage3-binary both emitted asr), so a
# driver-vs-stage3 diff is blind to it. The fixture therefore self-asserts the
# expected VALUE directly: each check returns a distinct nonzero code on failure
# and 0 only when every shift is correct. The buggy compiler returns nonzero
# (asr fills the high bits with the sign bit instead of zero).
#
# High-bit operands are BUILT (0-1 / 1<<k) rather than passed as >=2^31 literals,
# which the driver's argument constant-materialization handles separately.

# unsigned param LHS: logical right shift, high bits MUST be zero-filled.
fn lsr32(a: uint32, n: uint32): uint32 =
    return a >> n

# unsigned 64-bit param LHS: logical right shift across the full word.
fn lsr64(a: uint64, n: uint64): uint64 =
    return a >> n

# unsigned local LHS (declared, not cast): also logical.
fn lsr32_local(p: uint32, n: uint32): uint32 =
    let x: uint32 = p
    return x >> n

# signed param LHS: arithmetic right shift, sign bit MUST be replicated.
fn asr32(a: int32, n: int32): int32 =
    return a >> n

fn main(): int32 =
    # 0xFFFFFFFF >> 28 logical == 0xF (15). asr would give 0xFFFFFFFF.
    let u32AllOnes: uint32 = uint32(0) - uint32(1)
    if lsr32(u32AllOnes, uint32(28)) != uint32(15):
        return 1
    # 0x80000000 >> 4 logical == 0x08000000 (134217728). asr would set top nibble.
    let u32Hi: uint32 = uint32(1) << uint32(31)
    if lsr32(u32Hi, uint32(4)) != uint32(134217728):
        return 2
    # local-typed unsigned LHS, same all-ones expectation.
    if lsr32_local(u32AllOnes, uint32(28)) != uint32(15):
        return 3
    # 64-bit: 0xFFFFFFFFFFFFFFFF >> 60 logical == 0xF. asr would give all-ones.
    let u64AllOnes: uint64 = uint64(0) - uint64(1)
    if lsr64(u64AllOnes, uint64(60)) != uint64(15):
        return 4
    # 64-bit high-bit value: 0x8000000000000000 >> 60 logical == 0x8 (8).
    # asr would give 0xFFFFFFFFFFFFFFF8 (high bits sign-filled).
    let u64Hi: uint64 = uint64(1) << uint64(63)
    if lsr64(u64Hi, uint64(60)) != uint64(8):
        return 5
    # signed control: -16 >> 2 arithmetic == -4 (sign replicated). Must NOT regress.
    if asr32(int32(0) - int32(16), int32(2)) != int32(0) - int32(4):
        return 6
    # signed control: -1 >> 31 arithmetic == -1.
    if asr32(int32(0) - int32(1), int32(31)) != int32(0) - int32(1):
        return 7
    return 0
