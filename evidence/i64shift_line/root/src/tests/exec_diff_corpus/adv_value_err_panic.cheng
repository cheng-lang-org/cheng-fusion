import std/result as stdresult

var
    scratchLen: int32

fn mayFail(x: int32): Result[int32] =
    if x < 0:
        return Err[int32]("neg")
    return Ok[int32](x * 2)

fn callerAssign(x: int32): int32 =
    let sigLenRes: Result[int32] = mayFail(x)
    # boundary: Value() on an Err-state Result assigned to a GLOBAL must panic,
    # not silently store garbage/zero.
    scratchLen = Value(sigLenRes)
    return scratchLen

fn main(): int32 =
    let r = callerAssign(-1)
    return r
