# form: storing the RESULT of a && / || short-circuit expression into a variable
# and a seq element (materializing the boolean, not just branching on it).
# observable: exit code. bool_shortcircuit_chain branched on the chain in `if`;
# this captures the chain's truth value into storage and reads it back, plus
# guards a side-effecting helper so the store path can't run the RHS when it
# short-circuits. A miscompile that branches correctly but materializes the
# stored bool wrong (or runs the skipped RHS) diverges.
var calls: int32 = 0
var globalResult: bool
fn bump(ret: bool): bool =
    calls = calls + 1
    return ret
fn b2i(b: bool): int32 =
    if b:
        return 1
    return 0
fn main(): int32 =
    # store the value of a short-circuited && (RHS skipped, no bump).
    calls = 0
    let r1 = false && bump(true)
    if calls != 0:
        return 1
    if b2i(r1) != 0:
        return 2
    # store the value of a fully-evaluated && (RHS runs once).
    calls = 0
    let r2 = true && bump(true)
    if calls != 1:
        return 3
    if b2i(r2) != 1:
        return 4
    # store the value of a short-circuited || (RHS skipped).
    calls = 0
    let r3 = true || bump(false)
    if calls != 0:
        return 5
    if b2i(r3) != 1:
        return 6
    # store the value of a fully-evaluated || (RHS runs, result false).
    calls = 0
    let r4 = false || bump(false)
    if calls != 1:
        return 7
    if b2i(r4) != 0:
        return 8
    # store a chained expression into a seq of ints (1/0).
    var flags: int32[]
    setLen(flags, 4)
    flags[0] = b2i(3 > 2 && 5 > 1)   # true
    flags[1] = b2i(3 > 2 && 1 > 5)   # false
    flags[2] = b2i(1 > 9 || 2 < 4)   # true
    flags[3] = b2i(1 > 9 || 4 < 2)   # false
    if flags[0] != 1 || flags[1] != 0 || flags[2] != 1 || flags[3] != 0:
        return 9
    # the stored bool drives a later branch correctly.
    let cond = (7 % 2 == 1) && (8 / 2 == 4)
    if b2i(cond) != 1:
        return 10
    var acc: int32
    if cond:
        acc = acc + 5
    if acc != 5:
        return 11
    # Reassign an existing bool. The lhs comparison must not steal the
    # top-level logical root, and the skipped call must remain unobserved.
    var reassigned: bool
    calls = 0
    reassigned = 7 == 7 && bump(true)
    if calls != 1 || !reassigned:
        return 12
    calls = 0
    reassigned = 7 != 7 && bump(true)
    if calls != 0 || reassigned:
        return 13
    calls = 0
    reassigned = ((7 == 7 && bump(true)))
    if calls != 1 || !reassigned:
        return 14
    calls = 0
    reassigned = 7 != 7 || bump(true)
    if calls != 1 || !reassigned:
        return 15
    let logicalText = "a&&b"
    reassigned = logicalText == "a&&b"
    if !reassigned:
        return 16
    calls = 0
    globalResult = 7 != 7 || bump(true)
    if calls != 1 || !globalResult:
        return 17
    calls = 0
    globalResult = true || bump(false)
    if calls != 0 || !globalResult:
        return 18
    calls = 0
    globalResult = logicalText == "a&&b" && bump(true)
    if calls != 1 || !globalResult:
        return 19
    return 0
