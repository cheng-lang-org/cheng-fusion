# form: atomic / fetch-add -- single-thread deterministic atomic fetch_add on a
# stack cell (raw importc) plus the std/atomic ref-object layer (NewI32 /
# FetchAddI32 / AddI32 / LoadI32). Mirrors
# src/tests/atomic_i32_fetch_add_direct_runtime_smoke.cheng in minimal corpus
# form: no threads, every intermediate return value asserted, so the output is
# fully determined. observable: exit code.
# expected runtime: rc 0.
import std/atomic

@importc("cheng_atomic_fetch_add_i32")
fn atomicFetchAddRaw(p: ptr, amount: int32): int32

fn main(): int32 =
    var cell: int32
    cell = 10
    if atomicFetchAddRaw(&cell, 5) != 10:
        return 1
    if cell != 15:
        return 2
    if atomicFetchAddRaw(&cell, 0 - 3) != 15:
        return 3
    if cell != 12:
        return 4
    let value = atomic.NewI32(2)
    if value == nil:
        return 5
    if atomic.FetchAddI32(value, 8) != 2:
        return 6
    if atomic.LoadI32(value) != 10:
        return 7
    if atomic.AddI32(value, 4) != 14:
        return 8
    if atomic.LoadI32(value) != 14:
        return 9
    return 0
