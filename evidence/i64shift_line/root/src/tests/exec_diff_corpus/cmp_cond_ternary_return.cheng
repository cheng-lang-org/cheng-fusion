# form: comparison-condition ternary consumed directly by `return` in a
# multi-line body (Lane B). observable: process exit code.
#
# The eager branchless return path only handles a ternary whose CONDITION is a
# plain i32 value (flag ? x : y). When the condition is a comparison (a > b) the
# eager path cannot produce a cond slot (cmp yields 0/1, not a value slot), so it
# declined and — because the cbr re-route was gated on a real-call arm — NOTHING
# was lowered: the function spilled its params and returned an uninitialized
# stack slot. selGt(5,1,42,99) came back 0 and selGt(1,5,...) returned garbage.
#
# A comparison-condition ternary in return position must lower to a real branch
# (cmp + cbr, only the selected arm runs), exactly like the plain-value form.
fn selGt(a: int32, b: int32, x: int32, y: int32): int32 =
    return a > b ? x : y

fn selLe(a: int32, b: int32, x: int32, y: int32): int32 =
    return a <= b ? x : y

fn main(): int32 =
    # cond true: a>b picks x.
    if selGt(5, 1, 42, 99) != 42:
        return 1
    # cond false: a>b picks y.
    if selGt(1, 5, 42, 99) != 99:
        return 2
    # different comparison op, true arm.
    if selLe(2, 7, 11, 13) != 11:
        return 3
    # different comparison op, false arm.
    if selLe(7, 2, 11, 13) != 13:
        return 4
    return 0
