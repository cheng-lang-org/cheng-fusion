# form: string equality comparison (s == t) and inequality, on equal-length,
# different-length, and shared-prefix strings. observable: exit code.
# string_concat/string_byte_index covered Len and byte loads; this exercises the
# str == str lowering (length check + byte compare) which nothing else did.
fn eq(a: str, b: str): int32 =
    return a == b ? 1 : 0

fn main(): int32 =
    # identical literals must compare equal.
    if eq("abc", "abc") != 1:
        return 1
    # different content, same length.
    if eq("abc", "abd") != 0:
        return 2
    # different length, shared prefix.
    if eq("abc", "abcd") != 0:
        return 3
    if eq("abcd", "abc") != 0:
        return 4
    # empty strings equal.
    if eq("", "") != 1:
        return 5
    # empty vs non-empty.
    if eq("", "x") != 0:
        return 6
    # single-char strings.
    if eq("z", "z") != 1:
        return 7
    if eq("z", "y") != 0:
        return 8
    # longer equal strings (multi-word byte compare).
    if eq("the quick brown fox", "the quick brown fox") != 1:
        return 9
    # longer strings differing only in the last byte.
    if eq("the quick brown fox", "the quick brown foy") != 0:
        return 10
    return 0
