# form: single-line function body -- `fn f(...): T = <stmt>` on the SAME line as `=`.
# Lane A: driver drops the body entirely (returns uninitialized garbage); stage3 correct.
fn compute(a: int32, b: int32): int32 = return a * b + 7
fn main(): int32 =
    let r = compute(5, 6)
    if r != 37:
        return 1
    return 0
