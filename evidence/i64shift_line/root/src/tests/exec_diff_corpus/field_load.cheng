# form: field_load -- struct with multiple fields, read each field value.
# observable: process exit code. main returns 0 on success, a distinct
# nonzero code per failed sub-check. The diff net compares driver vs stage3
# exit codes + stdout; divergence == latent miscompile.
type
    Rec =
        a: int32
        b: int32
        c: int32
        d: int32

fn sumWeighted(r: Rec): int32 =
    return r.a * 1 + r.b * 10 + r.c * 100 + r.d * 1000

fn main(): int32 =
    var r: Rec
    r.a = 1
    r.b = 2
    r.c = 3
    r.d = 4
    let s = sumWeighted(r)
    if s != 4321:
        return 1
    # second field-load shape: read after struct copy
    let r2 = r
    if r2.b != 2:
        return 2
    if r2.d != 4:
        return 3
    if r2.a + r2.c != 4:
        return 4
    return 0
