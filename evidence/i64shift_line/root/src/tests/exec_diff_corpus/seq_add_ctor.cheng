# form: add(seq, Type(field: val, ...)) -- element is an aggregate constructor
# literal (paren named-field form), not a function call. Mirrors compiler_csg
#   add(pairs, CompilerCsgImportPair(ownerModulePath: a, targetModulePath: b))
# Before the fix the seq-add whole-call path tried to resolve the ctor head as a
# call ordinal, failed, and emitted bail_631 (whole function -> cold). The fix
# materializes the constructor via PrimaryBodyIrAppendAggregateConstructorToSlot
# (the proven paren-ctor materializer) before the call path.
type
    Pair =
        a: int32
        b: int32

fn build(): Pair[] =
    var ps: Pair[]
    add(ps, Pair(a: 1, b: 2))
    add(ps, Pair(a: 30, b: 40))
    return ps

fn main(): int32 =
    let ps = build()
    if ps.len != 2:
        return 1
    if ps[0].a != 1:
        return 2
    if ps[0].b != 2:
        return 3
    if ps[1].a != 30:
        return 4
    if ps[1].b != 40:
        return 5
    # element values must survive a third element appended after a read
    var qs: Pair[]
    add(qs, Pair(a: 7, b: 8))
    let first = qs[0].a
    add(qs, Pair(a: 9, b: 10))
    if first != 7:
        return 6
    if qs[1].a != 9:
        return 7
    if qs[0].b != 8:
        return 8
    return 0
