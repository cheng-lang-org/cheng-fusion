# form: bare (no-RHS) zero-init slice local -- var ns: int32[]
# Frontend builds an EmptySeqInit node for the bare decl so the node-eval path
# owns it (was local_decl no_node before the fix). The slice must come up as an
# empty 16-byte header: len==0 first, then add() grows it and indexing reads back.
fn main(): int32 =
    var ns: int32[]
    if ns.len != 0:
        return 1
    add(ns, 7)
    add(ns, 11)
    if ns.len != 2:
        return 2
    if ns[0] != 7:
        return 3
    if ns[1] != 11:
        return 4
    var ms: int32[]
    if ms.len != 0:
        return 5
    add(ms, 99)
    if ms[0] != 99:
        return 6
    return 0
