# form (net-audit r16): WALK an array of structs by raw POINTER ARITHMETIC and
# deref-LOAD each element through a typed `Cell*` — the C stub passes the address
# of a real Cell[] buffer; Cheng computes each element's address as `base + i*8`
# and reads `q->v` at each stop, summing, and also returns the value at a computed
# offset. ptr_arith_chain did address math on fictitious bases (never deref'd real
# memory); ptr_offset_rw deref'd a single stub-supplied ptr without indexing. This
# COMBINES them: a stub-supplied base plus an index*element-size offset feeding a
# real `->v` deref-LOAD that must hit the right element. (A Cheng-local `&a[k]` of
# a struct-array element is unsound in this backend; the stub supplies a valid
# base. The offset is recomputed per iteration from the index — advancing a ptr-
# typed local inside a loop is not yet lowerable on the driver.) Stresses:
# index*size ptr-offset arithmetic feeding a typed-ptr field load whose target is
# the computed address. observable: via C stub return.
type
    Cell =
        v: int32
        pad: int32
    CellPtr = Cell *

@exportc("walk_sum")
fn walk_sum(p: ptr, n: int32): int32 =
    var s: int32
    var i: int32
    while i < n:
        let q: CellPtr = CellPtr(ptr(uint64(p) + uint64(i) * uint64(8)))
        s = s + q->v
        i = i + 1
    return s

@exportc("elem_at")
fn elem_at(p: ptr, idx: int32): int32 =
    let off: uint64 = uint64(idx) * uint64(8)
    let q: CellPtr = CellPtr(ptr(uint64(p) + off))
    return q->v
