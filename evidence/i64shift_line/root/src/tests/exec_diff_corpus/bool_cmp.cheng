# form: boolean / comparison -- &&, ||, !, range compares.
fn inRange(x: int32, lo: int32, hi: int32): bool =
    return x >= lo && x <= hi
fn main(): int32 =
    if !inRange(5, 1, 10):
        return 1
    if inRange(11, 1, 10):
        return 2
    let a = true
    let b = false
    if a && b:
        return 3
    if !(a || b):
        return 4
    return 0