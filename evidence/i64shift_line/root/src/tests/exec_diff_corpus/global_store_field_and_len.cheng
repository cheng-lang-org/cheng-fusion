# form: two GLOBAL-STORE assigns whose RHS is a field-load value the driver's
# global-store path didn't lower — matching the two K wcz victims:
#   * `gCount = items.len`  : global int32 = seq.len of a struct-element seq
#     param. The scalar value path only knew str/var-str-param `.len`; a plain
#     seq `.len` produced no value slot -> wcz (TypedExprBuildTypeContextIndexes).
#   * `gNums  = box.nums`   : global int32[] = struct field-get of a seq field.
#     The global-store path rejected aggregate LHS kinds outright -> wcz
#     (TypedExprBuildSourceContextIndex / typedExprCachedIndexSourcePaths). The
#     seq header is 16 bytes regardless of element type, so an int32[] field-get
#     global store drives the identical aggregate-copy lowering the str[] victim
#     needs, while staying inside the shared-runtime link (no str-seq bridge).
# observable: exit code. Both globals must hold the field-derived values after
# the store and read back identically on the driver and the stage3 oracle.
type Item =
    a: int32
    b: int32

type Box =
    nums: int32[]

var gCount: int32
var gNums: int32[]

fn recordCount(items: var Item[]) =
    gCount = items.len

fn recordNums(box: var Box) =
    gNums = box.nums

fn main(): int32 =
    var items: Item[]
    var it0: Item
    it0.a = 1
    it0.b = 2
    add(items, it0)
    var it1: Item
    it1.a = 3
    it1.b = 4
    add(items, it1)
    var it2: Item
    it2.a = 5
    it2.b = 6
    add(items, it2)
    recordCount(items)
    if gCount != 3:
        return 1

    var box: Box
    add(box.nums, 11)
    add(box.nums, 22)
    add(box.nums, 33)
    recordNums(box)
    if gNums.len != 3:
        return 2
    if gNums[0] != 11:
        return 3
    if gNums[1] != 22:
        return 4
    if gNums[2] != 33:
        return 5
    return 0
