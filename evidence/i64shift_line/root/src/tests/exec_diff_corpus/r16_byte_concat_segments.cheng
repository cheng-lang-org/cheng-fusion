# form (net-audit r16): MULTI-SEGMENT concatenation — append the bytes of
# several source strings end-to-end into one fixed int32 buffer, tracking a
# running write cursor `pos` that carries across segment boundaries. r14_string
# _reverse walked ONE string backward; this copies N strings forward into a
# shared buffer where each segment's start offset is the previous segment's end
# (`pos` accumulates Len(seg) across segments). The buffer is a real `main` local
# (array params pass by value, so the fill must target the caller's own buffer);
# each segment is a copy loop sharing the single running cursor. Stresses: a
# write cursor that is read-and-advanced (`buf[pos]=...; pos=pos+1`) across
# multiple independent source loops, the running offset surviving between
# segments, and a final length check that the concatenation produced exactly the
# summed lengths. observable: exit code.
fn main(): int32 =
    var buf: int32[16]
    var pos: int32
    # concat "AB" + "CDE" + "FG" -> "ABCDEFG" (7 bytes). one loop per segment, all
    # sharing the running cursor `pos`.
    let s0 = "AB"
    var i0: int32
    while i0 < Len(s0):
        buf[pos] = int32(s0[i0])
        pos = pos + 1
        i0 = i0 + 1
    if pos != 2:
        return 1
    let s1 = "CDE"
    var i1: int32
    while i1 < Len(s1):
        buf[pos] = int32(s1[i1])
        pos = pos + 1
        i1 = i1 + 1
    if pos != 5:
        return 2
    let s2 = "FG"
    var i2: int32
    while i2 < Len(s2):
        buf[pos] = int32(s2[i2])
        pos = pos + 1
        i2 = i2 + 1
    if pos != 7:
        return 3
    # bytes laid down contiguously: 'A'..'G' = 65..71.
    var i: int32
    while i < 7:
        if buf[i] != 65 + i:
            return 4
        i = i + 1
    # the segment boundary at index 2 holds 'C'(67), index 5 holds 'F'(70).
    if buf[2] != 67:
        return 5
    if buf[5] != 70:
        return 6
    # an empty segment does not move the cursor.
    let before: int32 = pos
    let se = ""
    var ie: int32
    while ie < Len(se):
        buf[pos] = int32(se[ie])
        pos = pos + 1
        ie = ie + 1
    if pos != before:
        return 7
    # one more segment after the empty still lands at the right offset.
    let s3 = "HI"
    var i3: int32
    while i3 < Len(s3):
        buf[pos] = int32(s3[i3])
        pos = pos + 1
        i3 = i3 + 1
    if pos != 9:
        return 8
    if buf[7] != 72:
        return 9
    if buf[8] != 73:
        return 10
    return 0
