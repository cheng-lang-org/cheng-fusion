# form: setMem/seq -- var int array: verify .len=0 initial + index read/write.
# observable: process exit code.
fn main(): int32 =
    var xs: int32[]
    # initial length must be zero (zero-init via setMem)
    if xs.len != 0:
        return 1
    add(xs, 10)
    add(xs, 20)
    add(xs, 30)
    if xs.len != 3:
        return 2
    # index read
    if xs[0] != 10:
        return 3
    if xs[2] != 30:
        return 4
    # index write then read back
    xs[1] = 99
    if xs[1] != 99:
        return 5
    var total = 0
    for i in 0..<xs.len:
        total = total + xs[i]
    if total != 139:
        return 6
    return 0
