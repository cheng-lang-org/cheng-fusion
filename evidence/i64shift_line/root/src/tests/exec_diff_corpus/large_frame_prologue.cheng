# form: a function with > 32760 bytes of local stack (a 5000-element int64
# fixed array = 40000 bytes). The prologue param/sret saves can no longer use
# the STR scaled-immediate form (which only reaches 32760 for 8-byte stores),
# so the frame layout used to bail to word-count-zero and the whole function
# fell to the cold path. The fix materializes the param-save base into the
# intra-procedure scratch X16 once and stores the params + sret relative to it.
# Exit code is the observable; the driver prologue must match the stage3 oracle.

fn SumWithBigFrame(a: int32, b: int32, c: int32): int64 =
    var scratch: int64[5000]
    # touch a few high-index slots so the big frame is real (not dead-stripped)
    scratch[0] = int64(a)
    scratch[2500] = int64(b)
    scratch[4999] = int64(c)
    return scratch[0] + scratch[2500] + scratch[4999]

fn main(): int32 =
    let total = SumWithBigFrame(7, 11, 13)
    if total != int64(31):
        return 1
    return 0
