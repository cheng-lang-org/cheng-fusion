# form: sumloop variant where BOTH acc and the counter i are carry-eligible.
# i is written via I64->I64 CopyLocal (let nx = i+1; i = nx) so Stage5b accepts
# it as a carried slot (the natural `i = i+1` lowers to a BinOp-direct-target
# write which Stage5b rejects). i is ALSO the header Cmp operand. Stage6 target:
# acc carried+store-dropped AND i carried (store-dropped IFF Cmp-redirect lands,
# otherwise reload-elim only). Correctness identical to the oracle either way.
# sum(0..20) = 190; exit code derived from it.
fn sumFull(n: int64): int64 =
    var acc: int64 = int64(0)
    var i: int64 = int64(0)
    while i < n:
        let t: int64 = acc + i
        acc = t
        let nx: int64 = i + int64(1)
        i = nx
    return acc
fn main(): int32 =
    let r: int64 = sumFull(int64(20))
    if r != int64(190):
        return 1
    return 0
