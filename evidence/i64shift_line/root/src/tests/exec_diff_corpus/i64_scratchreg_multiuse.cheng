# Stage9 temp allocator KILLER-1/KILLER-2 live-range + multi-use: t1 is read MULTIPLE times and
# must keep its pool reg until its LAST read, even while t2/t3 are allocated in between (competing
# for the pool). A wrong last-use point frees t1's reg early -> clobber -> miscompile. Stage3 oracle.
fn multiUse(a: int64, b: int64): int64 =
    let t1: int64 = (a + b) & int64(1048575)
    let t2: int64 = (a * int64(2)) & int64(1048575)
    let t3: int64 = (b * int64(3)) & int64(1048575)
    let s1: int64 = (t1 + t2) & int64(1048575)
    let s2: int64 = (s1 + t3) & int64(1048575)
    let s3: int64 = (t1 ^ t3) & int64(1048575)
    return (((s2 + s3) + t1)) & int64(1048575)
fn main(): int32 =
    let r: int64 = multiUse(int64(4), int64(5))
    # t1=9 t2=8 t3=15 ; s1=17 ; s2=32 ; s3=(9^15)=6 ; (32+6+9)=47
    if r != int64(47):
        return 1
    return 0
