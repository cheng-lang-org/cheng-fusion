# form: dynamic seq-of-seq int32[][] -- outer seq whose elements are themselves
# seq headers. setLen(grid, n) sizes the outer; grid[i] = inner stores a seq
# header into an outer slot; grid[i].len and grid[i][j] read it back (two-level
# header deref). Covers nested-seq element store-then-read (#54). observable:
# process exit code.
fn make_row(a: int32, b: int32, c: int32): int32[] =
    var row: int32[]
    add(row, a)
    add(row, b)
    add(row, c)
    return row

fn main(): int32 =
    var grid: int32[][]
    setLen(grid, 2)
    if grid.len != 2:
        return 1
    # store an inner seq header into outer slot 0
    let r0 = make_row(10, 20, 30)
    grid[0] = r0
    # read the inner header's length back through the outer slot
    if grid[0].len != 3:
        return 2
    # two-level element read: grid[i][j]
    if grid[0][0] != 10:
        return 3
    if grid[0][1] != 20:
        return 4
    if grid[0][2] != 30:
        return 5
    # store a second inner seq into outer slot 1
    let r1 = make_row(7, 8, 9)
    grid[1] = r1
    if grid[1].len != 3:
        return 6
    if grid[1][0] != 7:
        return 7
    if grid[1][2] != 9:
        return 8
    # the two outer slots are independent (no aliasing)
    if grid[0][0] != 10:
        return 9
    # nested element store: grid[i][j] = v then read back
    grid[0][1] = 99
    if grid[0][1] != 99:
        return 10
    if grid[1][1] != 8:
        return 11
    return 0
