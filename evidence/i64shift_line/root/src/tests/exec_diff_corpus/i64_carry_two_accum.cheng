# form: TWO independent i64 accumulators in one while-loop -- exercises Stage6
# multi-slot carry (se AND so each carried in a DISTINCT callee-saved reg).
# Both are written ONLY by I64->I64 CopyLocal and read ONLY as BinOp operands,
# so the 5c conservative gate may DROP both per-iter stores. The loop var i is
# the header Cmp operand (memory read) and stays uncarried/stored. On the
# current single-slot driver one of se/so is carried, the other reloads/stores
# each iter -- still correct (stage3 oracle). On Stage6 both are carried.
# i in 0..10: se = sum(i) = 45, so = sum(2*i) = 90. result = 45 + 90*1000 = 90045.
fn twoAcc(n: int64): int64 =
    var se: int64 = int64(0)
    var so: int64 = int64(0)
    var i: int64 = int64(0)
    while i < n:
        let e: int64 = se + i
        se = e
        let o: int64 = so + (i + i)
        so = o
        i = i + int64(1)
    return se + (so * int64(1000))
fn main(): int32 =
    let r: int64 = twoAcc(int64(10))
    if r != int64(90045):
        return 1
    return 0
