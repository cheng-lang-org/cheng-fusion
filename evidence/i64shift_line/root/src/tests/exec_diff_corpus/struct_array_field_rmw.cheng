# form: read-modify-write a FIELD of a struct-array element in place —
# `bag.items[K].weight = bag.items[K].weight + 1` — where the element index K is
# both a CONSTANT and a loop variable. observable: exit code. the compound RMW
# must compute ONE element-field address for the load and the store; a bug that
# recomputes the address differently for read vs write, or that drops the
# read-modify and stores a fresh value, diverges here. distinct from
# struct_array_sum_loop (which sums into a separate scalar): this writes back into
# the SAME nested aggregate slot it just read.
type
    Item =
        weight: int32
        kind: int32
    Bag =
        items: Item[5]
        total: int32

fn main(): int32 =
    var bag: Bag
    bag.items[0].weight = 10
    bag.items[1].weight = 20
    bag.items[2].weight = 30
    bag.items[3].weight = 40
    bag.items[4].weight = 50

    # 1) constant-index field RMW (the exact reported form).
    bag.items[2].weight = bag.items[2].weight + 1
    if bag.items[2].weight != 31:
        return 1
    # neighbours untouched.
    if bag.items[1].weight != 20:
        return 2
    if bag.items[3].weight != 40:
        return 3

    # 2) constant-index field RMW, multiplicative.
    bag.items[0].weight = bag.items[0].weight * 3
    if bag.items[0].weight != 30:
        return 4

    # 3) loop-variable-index field RMW: +1 to every element's weight.
    for i in 0..<5:
        bag.items[i].weight = bag.items[i].weight + 1
    # weights now: 31, 21, 32, 41, 51.
    if bag.items[0].weight != 31:
        return 5
    if bag.items[1].weight != 21:
        return 6
    if bag.items[2].weight != 32:
        return 7
    if bag.items[3].weight != 41:
        return 8
    if bag.items[4].weight != 51:
        return 9

    # 4) loop-variable RMW reading a sibling field as the addend.
    for i in 0..<5:
        bag.items[i].kind = i
    for i in 0..<5:
        bag.items[i].weight = bag.items[i].weight + bag.items[i].kind
    # weights += kind(=index): 31, 22, 34, 44, 55.
    if bag.items[1].weight != 22:
        return 10
    if bag.items[4].weight != 55:
        return 11

    # 5) sum to confirm no neighbour clobbered: 31+22+34+44+55 = 186.
    var sum: int32
    for i in 0..<5:
        sum = sum + bag.items[i].weight
    if sum != 186:
        return 12

    return 0
