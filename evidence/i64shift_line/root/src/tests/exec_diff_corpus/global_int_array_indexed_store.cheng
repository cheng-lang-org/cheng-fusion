# form: indexed store + read-back into a GLOBAL dynamic non-u8 seq -- g[i] = v
# where `g: int32[]`. The element address is *(headerAddr + 8) + i*elemSize:
# the index must be scaled by elemSize (4 bytes) and the header data pointer
# dereferenced. Before the fix only a global uint8[N] byte store existed, so
# `g[i] = v` for a wider/dynamic global lowered to a word-count-zero op. This is
# the WCZ-A trigger (loweringParallelResultReadyFlags[i] = 1). observable:
# process exit code (self-asserts: 0 on success, distinct nonzero per check).
var gSeq: int32[] = []

fn fillSeq(): int32 =
    var i = 0
    while i < 6:
        add(gSeq, 0)
        i = i + 1
    var j = 0
    while j < 6:
        gSeq[j] = j * 7
        j = j + 1
    return gSeq.len

fn main(): int32 =
    if fillSeq() != 6:
        return 1
    if gSeq[0] != 0:
        return 2
    if gSeq[1] != 7:
        return 3
    if gSeq[5] != 35:
        return 4
    # overwrite one slot; confirm neighbours are untouched (no index aliasing)
    gSeq[2] = 99
    if gSeq[2] != 99:
        return 5
    if gSeq[1] != 7:
        return 6
    if gSeq[3] != 21:
        return 7
    return 0
