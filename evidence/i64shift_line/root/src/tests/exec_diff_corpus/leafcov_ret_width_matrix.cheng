# form: return-width matrix -- exercises backend2 slice-3 leaf
# FillBlockTermReturn arms the golden ladder never hits: i64 wide slot return
# (8-byte x0), void return (LocalInvalidTag arm emit_ops:3384), str PARAM
# returned directly (aggregateParam=true -> X10 loads the incoming pointer
# first, arm 3342; ladder only returns a str LOCAL), and a constant > 65535
# returned (movz &65535 truncation arm 3396 -- adversarial pin: a truncating
# materializer turns 100000 into 34464). Part of the backend2 slice-3 leaf
# coverage battery. expected runtime: sum64(40000,30000)=70000, big()=100000,
# Len(passthru("hello"))=5, nothing() returns void -> main returns 0.
# observable: exit code.
fn sum64(a: int64, b: int64): int64 =
    return a + b

fn big(): int32 =
    return 100000

fn passthru(s: str): str =
    return s

fn nothing() =
    var t: int32
    t = 1

fn main(): int32 =
    if sum64(int64(40000), int64(30000)) != int64(70000):
        return 1
    if big() != 100000:
        return 2
    if Len(passthru("hello")) != 5:
        return 3
    nothing()
    return 0
