import std/result as stdresult

fn mayFail(x: int32): Result[int32] =
    if x < 0:
        return Err[int32]("neg")
    return Ok[int32](x * 2)

# var-param ErrorInfoOf on an OK-state Result: must return empty ErrorInfo
# (code=0, msg=""), never mis-project the ok payload as if it were an error.
fn errTextOnOk(r: var Result[int32]): str =
    let err: ErrorInfo = stdresult.ErrorInfoOf[int32](r)
    return stdresult.ErrorMessage(err)

fn errCodeOnOk(r: var Result[int32]): int32 =
    let err: ErrorInfo = stdresult.ErrorInfoOf[int32](r)
    return err.code

fn caller(x: int32): int32 =
    var r: Result[int32] = mayFail(x)
    let msg = errTextOnOk(r)
    let code = errCodeOnOk(r)
    if msg != "":
        return 100
    if code != 0:
        return 200
    return 0

fn main(): int32 =
    return caller(5)
