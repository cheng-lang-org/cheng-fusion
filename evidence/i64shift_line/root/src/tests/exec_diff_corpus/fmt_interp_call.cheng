# form: Fmt interpolation whose piece is a CALL (wcz Lane 3). Two shapes the
# driver previously miscompiled:
#   {twice(n)}           — a bare call returning a non-str scalar (int32). The
#                          whole-call Fmt branch forced a str value slot, so the
#                          int result was raw-copied into a 24-byte str slot and
#                          appended as garbage (segfault / wrong bytes).
#   {IntToStr(twice(n))} — the int-to-str intrinsic wrapping a call. IntToStr is
#                          not a registered fn, so the whole-call ordinal lookup
#                          returned -1 (PrimaryBodyIrResolvedOrRegisteredWhole
#                          CallOrdinal越界) and the whole function fell to wcz.
# Fix: the Fmt call branch shapes the value slot by the call's RETURN TYPE
# (str -> str slot; i32/i64 -> scalar slot + scalar-to-str bridge), and IntToStr
# /Int64ToStr pieces are peeled to their inner scalar (`{IntToStr(x)}` ≡ `{x}`,
# Fmt auto-stringifies scalars). The inner call is then evaluated normally
# (call-ordinal registered + bl emitted), root-fixing the ordinal miss.
# observable: process exit code. main returns 0 on success, distinct nonzero per
# failed sub-check. Linked against fmt_interp_call.stub.c (str-build bridges).
fn twice(n: int32): int32 =
    return n + n

# bare int call as a Fmt piece: twice(n) -> int -> auto-stringified.
fn buildBare(n: int32): str =
    var acc: str
    acc = Fmt"x={twice(n)}!"
    return acc

# IntToStr wrapping a call as a Fmt piece: IntToStr(twice(n)) -> str.
fn buildWrap(n: int32): str =
    var acc: str
    acc = Fmt"x={IntToStr(twice(n))}!"
    return acc

fn main(): int32 =
    # twice(5)=10  -> "x=10!"  len 5
    if Len(buildBare(5)) != 5:
        return 1
    # twice(50)=100 -> "x=100!" len 6
    if Len(buildBare(50)) != 6:
        return 2
    # twice(0)=0   -> "x=0!"   len 4
    if Len(buildBare(0)) != 4:
        return 3
    # same observable via the IntToStr-wrapped form.
    if Len(buildWrap(5)) != 5:
        return 4
    if Len(buildWrap(50)) != 6:
        return 5
    if Len(buildWrap(0)) != 4:
        return 6
    return 0
