# form: scalar-ternary with a call in the not-selected arm.
# observable: process exit code. The eager branchless lowering (delta=T-F;
# scaled=cond*delta; F+scaled) evaluates BOTH arms unconditionally — when the
# not-selected arm is a call it runs anyway (clobbers the cond slot + side
# effects), so the wrong value is selected. A real branch must only run the
# selected arm.
fn other(flag: int32): int32 =
    # callee returns a distinct value so a clobbered cond-slot select is
    # observable. With flag=0 this must NOT be selected when cond is true.
    return flag + 99

fn fa(): int32 =
    return 7

fn fb(): int32 =
    return 13

fn main(): int32 =
    let flag: int32 = 2
    # cond true(1): must pick 11, the call other(flag) must not be selected.
    let cond1: int32 = 1
    let pick1: int32 = cond1 ? 11 : other(flag)
    if pick1 != 11:
        return 1
    # cond false(0): must pick other(flag)=101.
    let cond0: int32 = cond1 - 1
    let pick2: int32 = cond0 ? 11 : other(flag)
    if pick2 != 101:
        return 2
    # both arms calls: cond true -> fa()=7
    let pick3: int32 = cond1 ? fa() : fb()
    if pick3 != 7:
        return 3
    # both arms calls: cond false -> fb()=13
    let pick4: int32 = cond0 ? fa() : fb()
    if pick4 != 13:
        return 4
    # cast-only arms (Int32(...) is an inline cast, NOT a real bl call): the
    # branchless fast path stays correct here; the real-branch gate must not
    # over-trigger on cast surface.
    let castpick: int32 = cond1 ? Int32(5) : Int32(9)
    if castpick != 5:
        return 5
    return pick1 + pick2 + pick3 + pick4
