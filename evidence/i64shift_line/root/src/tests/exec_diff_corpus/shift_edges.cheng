# form: mixed shift/bitwise edges in one function — arithmetic right shift of a
# negative, u64 left shift past 32 bits, uint32 AND/OR/XOR, shift roundtrip.
# observable: exit code.
#
# DRIVER MISCOMPILE (blame=DRIVER): driver returns rc=6 (the `(x ^ y)` check)
# while stage3 returns 0. Each bitwise op is correct IN ISOLATION (xor/and/or of
# the two constants verified standalone), but composed after the negative-shift
# and the u64<<40 the driver clobbers a value — same stale-slot family as
# zero_local_shift_or / cast_chain. Reduced from the original shift_edges; the
# separate uint32-`>>` arithmetic-vs-logical bug (asr emitted for unsigned) is a
# SHARED bug recorded separately, not asserted here.
fn main(): int32 =
    # arithmetic right shift of negative must sign-extend.
    let neg: int32 = 0 - 256
    let ars: int32 = neg >> 4
    if ars != (0 - 16):
        return 1
    # 64-bit left shift past 32 bits must keep the high word.
    let one: uint64 = uint64(1)
    let hi: uint64 = one << uint64(40)
    if hi != uint64(1099511627776):
        return 3
    # uint32 bitwise ops.
    let x: uint32 = uint32(0xF0F0F0F0)
    let y: uint32 = uint32(0x0F0F0F0F)
    if (x | y) != uint32(0xFFFFFFFF):
        return 4
    if (x & y) != uint32(0):
        return 5
    if (x ^ y) != uint32(0xFFFFFFFF):
        return 6
    # left then right shift roundtrip on int32.
    let v: int32 = 13
    let shifted: int32 = (v << 8) >> 8
    if shifted != 13:
        return 7
    return 0
