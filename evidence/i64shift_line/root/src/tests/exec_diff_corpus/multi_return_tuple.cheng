# form: aggregate returned by value carrying two scalars (tuple-like struct),
# destructured by the caller. observable: exit code. Exercises multi-field
# aggregate return ABI (sret vs packed-regs) and field reload.
type
    Pair =
        a: int32
        b: int32
fn divmod(x: int32, y: int32): Pair =
    return Pair(a: x / y, b: x - (x / y) * y)
fn main(): int32 =
    let r = divmod(17, 5)
    if r.a != 3:
        return 1
    if r.b != 2:
        return 2
    let r2 = divmod(100, 7)
    if r2.a != 14:
        return 3
    if r2.b != 2:
        return 4
    # sum both fields to force both to be live.
    if (r.a + r.b + r2.a + r2.b) != 21:
        return 5
    return 0
