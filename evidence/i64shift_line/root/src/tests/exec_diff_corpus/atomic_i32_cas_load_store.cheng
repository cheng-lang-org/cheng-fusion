# form: atomic / load-store-CAS -- single-thread deterministic atomic store,
# load, CAS-success and CAS-failure on a stack cell (raw importc), then the
# same shape through the std/atomic ref-object layer (StoreI32 / LoadI32 /
# CasI32). Mirrors src/tests/atomic_i32_direct_runtime_smoke.cheng in minimal
# corpus form. observable: exit code.
# expected runtime: rc 0.
import std/atomic

@importc("cheng_atomic_cas_i32")
fn atomicCasRaw(p: ptr, expect: int32, desired: int32): int32

@importc("cheng_atomic_store_i32")
fn atomicStoreRaw(p: ptr, value: int32)

@importc("cheng_atomic_load_i32")
fn atomicLoadRaw(p: ptr): int32

fn main(): int32 =
    var cell: int32
    atomicStoreRaw(&cell, 7)
    if atomicLoadRaw(&cell) != 7:
        return 1
    if atomicCasRaw(&cell, 7, 9) == 0:
        return 2
    if atomicLoadRaw(&cell) != 9:
        return 3
    if atomicCasRaw(&cell, 7, 11) != 0:
        return 4
    if atomicLoadRaw(&cell) != 9:
        return 5
    let value = atomic.NewI32(0)
    if value == nil:
        return 6
    atomic.StoreI32(value, 21)
    if atomic.LoadI32(value) != 21:
        return 7
    if !atomic.CasI32(value, 21, 34):
        return 8
    if atomic.LoadI32(value) != 34:
        return 9
    if atomic.CasI32(value, 21, 55):
        return 10
    if atomic.LoadI32(value) != 34:
        return 11
    return 0
