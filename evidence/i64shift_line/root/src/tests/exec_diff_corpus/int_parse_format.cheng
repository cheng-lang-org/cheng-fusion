# form: hand-rolled integer parse (str of digits -> int32, with sign) and format
# (int32 -> reversed digit accumulation), exercising str byte-loads in a loop,
# multiply-accumulate, and modulo/divide digit extraction. observable: exit code.
# Pure value math over a str input; no extra runtime symbols. A miscompile in
# the accumulate (acc*10 + digit) or in the div/mod digit loop diverges.
#
# MISCOMPILE — AMBIGUOUS (both diverge, net-audit r12): driver returns rc=1
# (`parseInt("0") != 0`), stage3 returns rc=2 (`parseInt("7") != 7`). Both
# compilers miscompile, at DIFFERENT asserts. parseInt ISOLATED passes on both;
# digitCount+digitSum ISOLATED pass on both; only the FULL three-function file
# (multiple str-literal call sites composed) diverges — a cross-function
# interference (str-literal pool / slot interaction). Not a clean single-side
# blame; the driver is NOT provably clean here, so it counts toward the driver
# gate. Next-batch: reduce the cross-fn str-literal-pool interaction.
fn parseInt(s: str): int32 =
    var i: int32
    var sign: int32 = 1
    if Len(s) > 0:
        if int32(s[0]) == 45:        # '-'
            sign = 0 - 1
            i = 1
    var acc: int32
    while i < Len(s):
        let d: int32 = int32(s[i]) - 48   # '0'
        acc = acc * 10 + d
        i = i + 1
    return acc * sign
# format n (n>=0) into the count of digits AND the digit-sum, to observe the
# div/mod extraction without needing to emit a str back across the ABI.
fn digitCount(n: int32): int32 =
    if n == 0:
        return 1
    var v: int32 = n
    var c: int32
    while v > 0:
        v = v / 10
        c = c + 1
    return c
fn digitSum(n: int32): int32 =
    var v: int32 = n
    if v < 0:
        v = 0 - v
    var s: int32
    while v > 0:
        s = s + (v % 10)
        v = v / 10
    return s
fn main(): int32 =
    if parseInt("0") != 0:
        return 1
    if parseInt("7") != 7:
        return 2
    if parseInt("42") != 42:
        return 3
    if parseInt("100") != 100:
        return 4
    if parseInt("305") != 305:
        return 5
    if parseInt("-58") != (0 - 58):
        return 6
    if parseInt("999999") != 999999:
        return 7
    # round-trip-ish: digitCount/digitSum on known numbers.
    if digitCount(0) != 1:
        return 8
    if digitCount(5) != 1:
        return 9
    if digitCount(42) != 2:
        return 10
    if digitCount(1000) != 4:
        return 11
    if digitSum(0) != 0:
        return 12
    if digitSum(1234) != 10:
        return 13
    if digitSum(0 - 987) != 24:
        return 14
    # compose: parse then digit-sum.
    if digitSum(parseInt("4321")) != 10:
        return 15
    # parse a value and use it as a loop bound (forces it live across a loop).
    let n: int32 = parseInt("6")
    var acc: int32
    for k in 0..<n:
        acc = acc + k
    if acc != 15:        # 0+1+2+3+4+5
        return 16
    return 0
