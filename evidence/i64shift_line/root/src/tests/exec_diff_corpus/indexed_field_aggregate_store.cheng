# form: indexed store into a struct-FIELD dynamic-seq element where the index is
# a struct-field read and the value is an aggregate-returning call --
# `box.wides[block.termIndex] = widen(box.wides[block.termIndex])`.
# Mirrors BodyIrNoAliasForwardLocalsInBlocks (body_ir_noalias:271). It bailed
# cold (717): the cold-text indexed-field-store could not resolve a field-read
# index through the plain (context-free) scalar resolver, and a >24B aggregate
# element (Wide = 48B) had no machine-code stride (MOVZ+MADD) or chunked store.
# The same index/value field-read gap also blocked LoweringFillPrimaryObjectIrParams
# (lowering_plan:1768, str element); both migrate out of cold with this fix.
# observable: exit code (self-asserting).
type
    Wide =
        p: int64
        q: int64
        r: int64
        s: int64
        t: int64
        u: int64

    Blk =
        termIndex: int32

    Box =
        wides: Wide[]
        blocks: Blk[]

fn widen(w: Wide): Wide =
    var o: Wide
    o.p = w.p + 1
    o.q = w.q + 1
    o.u = w.u + 1
    return o

fn build(): Box =
    var box: Box
    var w0: Wide
    w0.p = 10
    w0.q = 20
    w0.u = 60
    add(box.wides, w0)
    add(box.wides, w0)
    var blk: Blk
    blk.termIndex = 1
    add(box.blocks, blk)
    return box

fn main(): int32 =
    var box = build()
    let block = box.blocks[0]

    # field-read index + aggregate-call value into a 48B field-seq element ->
    # general MOVZ+MADD stride + chunked aggregate store.
    box.wides[block.termIndex] = widen(box.wides[block.termIndex])

    # element 1 mutated (p=11, q=21, u=61), element 0 untouched.
    if box.wides[1].p != 11:
        return 1
    if box.wides[1].q != 21:
        return 2
    if box.wides[1].u != 61:
        return 3
    if box.wides[0].p != 10:
        return 4
    if box.wides[0].q != 20:
        return 5
    if box.wides[0].u != 60:
        return 6
    return 0
