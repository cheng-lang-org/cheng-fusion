# form (net-audit r16): EXTRACT and SET a 4-bit field at a RUNTIME bit offset and
# then PACK four independent nibbles into one word and read them all back —
# extract = `(word >> shift) & mask`, set = clear-then-or using an XOR-built
# complement (`word & (0xFFFFFFFF ^ (mask<<shift))`). r14_bit_field_setget passed
# the field WIDTH per call and built the mask from `(1<<width)-1`; this fixes the
# width at 4 but drives a full PACK/UNPACK round of four nibbles across a 16-bit
# span and cross-checks that setting one nibble leaves the other three intact.
# Avoids `~` (cold front-end can't parse it); complement is `0xFFFFFFFF ^ m`.
# Stresses: the shifted-mask build at a runtime offset, the XOR complement for
# the clear, the AND-clear/OR-set composition, and four packed fields coexisting.
# observable: exit code.
fn getNib(word: int32, shift: int32): int32 =
    return (word >> shift) & 0xF
fn setNib(word: int32, shift: int32, val: int32): int32 =
    let m: int32 = 0xF << shift
    let cleared: int32 = word & (0xFFFFFFFF ^ m)
    return cleared | ((val & 0xF) << shift)
fn main(): int32 =
    let w: int32 = 0xABCD
    # extract each nibble.
    if getNib(w, 0) != 0xD:
        return 1
    if getNib(w, 4) != 0xC:
        return 2
    if getNib(w, 8) != 0xB:
        return 3
    if getNib(w, 12) != 0xA:
        return 4
    # set the low nibble of 0xABC0 to 0x7 -> 0xABC7.
    if setNib(0xABC0, 0, 0x7) != 0xABC7:
        return 5
    # set nibble at shift 8 of 0xA0CD to 0x3 -> 0xA3CD.
    if setNib(0xA0CD, 8, 0x3) != 0xA3CD:
        return 6
    # PACK four nibbles 1,2,3,4 into one word -> 0x4321.
    var packed: int32
    packed = setNib(packed, 0, 1)
    packed = setNib(packed, 4, 2)
    packed = setNib(packed, 8, 3)
    packed = setNib(packed, 12, 4)
    if packed != 0x4321:
        return 7
    # read all four back.
    if getNib(packed, 0) != 1:
        return 8
    if getNib(packed, 4) != 2:
        return 9
    if getNib(packed, 8) != 3:
        return 10
    if getNib(packed, 12) != 4:
        return 11
    # set/get round-trips for every nibble value at offset 4.
    var v: int32
    while v <= 15:
        if getNib(setNib(0, 4, v), 4) != v:
            return 12
        v = v + 1
    # setting one nibble leaves the other three intact: change nibble@8 of
    # 0x4321 from 3 to F -> 0x4F21.
    let mod: int32 = setNib(0x4321, 8, 0xF)
    if mod != 0x4F21:
        return 13
    if getNib(mod, 0) != 1:
        return 14
    if getNib(mod, 4) != 2:
        return 15
    if getNib(mod, 12) != 4:
        return 16
    # over-wide value is masked to 4 bits (0x1F & 0xF = 0xF).
    if getNib(setNib(0, 0, 0x1F), 0) != 0xF:
        return 17
    return 0
