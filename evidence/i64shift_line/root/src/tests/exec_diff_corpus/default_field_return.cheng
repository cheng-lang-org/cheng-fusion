# form: default_field_return -- a struct whose fields carry default-value
# initializers (`name: Type = init`). The metadata type-decl scanner used to
# misread such a field line as a sibling `Name = alias` type decl, silently
# dropping the field (and every field after it) from the owner's layout, so any
# `return obj.field` of one of those fields fell to no_node. This fixture reads
# the post-default fields back, asserting the offsets resolved on the node path
# match the cold-backed reference.
# observable: process exit code. main returns 0 on success, a distinct nonzero
# code per failed sub-check.
type
    Cfg =
        first: int32 = 11
        second: int32 = 22
        third: int32 = 33
        fourth: int32 = 44

fn cfgFirst(c: Cfg): int32 =
    return c.first

fn cfgSecond(c: Cfg): int32 =
    return c.second

fn cfgThird(c: Cfg): int32 =
    return c.third

fn cfgFourth(c: Cfg): int32 =
    return c.fourth

fn main(): int32 =
    var c: Cfg
    c.first = 1
    c.second = 2
    c.third = 3
    c.fourth = 4
    # each post-default field must resolve to its true offset, not collapse.
    if cfgFirst(c) != 1:
        return 1
    if cfgSecond(c) != 2:
        return 2
    if cfgThird(c) != 3:
        return 3
    if cfgFourth(c) != 4:
        return 4
    # combined weighted read confirms the offsets are distinct and ordered.
    let w = c.first * 1 + c.second * 10 + c.third * 100 + c.fourth * 1000
    if w != 4321:
        return 5
    return 0
