# form: seq of structs -- iterate Item[] and accumulate field products.
type
    Item =
        w: int32
        n: int32
fn total(items: Item[]): int32 =
    var sum = 0
    for i in 0..<items.len:
        sum = sum + items[i].w * items[i].n
    return sum
fn main(): int32 =
    var xs: Item[]
    var a: Item
    a.w = 2
    a.n = 3
    add(xs, a)
    var b: Item
    b.w = 5
    b.n = 4
    add(xs, b)
    let t = total(xs)
    if t != 26:
        return 1
    return 0