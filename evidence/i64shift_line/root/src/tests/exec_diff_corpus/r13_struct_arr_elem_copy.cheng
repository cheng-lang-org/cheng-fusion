# form (net-audit r13): whole-struct element-to-element copy inside a fixed
# array of structs — arr[i] = arr[j] where each element is a multi-field
# struct. The store must copy ALL fields (a memcpy of sizeof(struct)) from the
# source element address to the dest element address, both at VARIABLE indices
# scaled by sizeof(struct). aggregate_copy covered struct-by-value through a
# CALL; this covers element-to-element struct copy through an indexed array
# slot (no call boundary). observable: exit code.
type
    Pt =
        x: int32
        y: int32
        z: int32

fn main(): int32 =
    var arr: Pt[4]
    # populate each element distinctly.
    var i: int32
    while i < 4:
        arr[i].x = i * 10 + 1
        arr[i].y = i * 10 + 2
        arr[i].z = i * 10 + 3
        i = i + 1
    # sanity: arr[2] = (21,22,23).
    if arr[2].x != 21:
        return 1
    if arr[2].y != 22:
        return 2
    if arr[2].z != 23:
        return 3
    # whole-struct copy: arr[0] = arr[3] (element-to-element, all fields).
    arr[0] = arr[3]
    if arr[0].x != 31:
        return 4
    if arr[0].y != 32:
        return 5
    if arr[0].z != 33:
        return 6
    # the SOURCE element must be untouched.
    if arr[3].x != 31:
        return 7
    if arr[3].z != 33:
        return 8
    # variable-index copy: arr[a] = arr[b] with a,b computed at runtime.
    let a: int32 = 1
    let b: int32 = 2
    arr[a] = arr[b]
    if arr[1].x != 21:
        return 9
    if arr[1].y != 22:
        return 10
    if arr[1].z != 23:
        return 11
    # neighbours not aliased: arr[0] still the copied (31,..), arr[2] original.
    if arr[0].x != 31:
        return 12
    if arr[2].x != 21:
        return 13
    return 0
