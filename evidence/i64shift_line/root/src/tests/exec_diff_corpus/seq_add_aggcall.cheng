# form: G1 seq-add whose ADDED ELEMENT is a whole-call returning an aggregate by
# value (`add(dst.rows, cloneRow(e))`). The element is NOT a constructor literal
# and NOT a bare local: it is a function call whose sret result is an aggregate.
# The element-eval path must sret the call result into a temporary aggregate slot
# (same shape+capacity as the seq element type) and then append that aggregate
# value -- not treat it as a scalar / drop it.
#
# Mirrors the wcz victims that build cold-csg rows by appending a cloned row from
# a helper call (TypedExprIrAppendColdCsgRowsFromContext /
# BodyIrNoAliasForwardLocalsInBlocks family: `add(ctx.rows, cloneRow(e))`).
#
# observable: process exit code (CORRECT result is 0).

type
    Row =
        a: int32
        b: int32
        c: int32

    Rows =
        rows: Row[]

fn cloneRow(e: Row): Row =
    var out: Row
    out.a = e.a + 1
    out.b = e.b + 2
    out.c = e.c + 3
    return out

fn appendClone(dst: var Rows, e: Row): bool =
    add(dst.rows, cloneRow(e))
    return true

fn main(): int32 =
    var dst: Rows
    var e0: Row
    e0.a = 10
    e0.b = 20
    e0.c = 30
    let _ = appendClone(dst, e0)
    var e1: Row
    e1.a = 100
    e1.b = 200
    e1.c = 300
    let _2 = appendClone(dst, e1)
    if dst.rows.len != 2:
        return 1
    if dst.rows[0].a != 11:
        return 2
    if dst.rows[0].b != 22:
        return 3
    if dst.rows[0].c != 33:
        return 4
    if dst.rows[1].a != 101:
        return 5
    if dst.rows[1].b != 202:
        return 6
    if dst.rows[1].c != 303:
        return 7
    return 0
