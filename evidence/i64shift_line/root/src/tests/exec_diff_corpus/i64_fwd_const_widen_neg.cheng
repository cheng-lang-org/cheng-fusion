# Stage-8 const-widen fold sign-correctness: fold a NEGATIVE i32 literal through
# `int64(...)`. A negative i32 stays in i32 range, so the i64 LoadConst's
# movn/movz+movk must reproduce the same 64-bit (sign-extended) value the old
# ldrsw cast produced. Mixed with a non-constant value to keep both paths live.
fn run(n: int64): int64 =
    var acc: int64
    var i: int64
    while i < n:
        acc = acc + (i + int64(0 - 100000))
        acc = acc & int64(67108863)
        i = i + 1
    return acc

fn main(): int32 =
    return int32(run(int64(3000)) & int64(255))
