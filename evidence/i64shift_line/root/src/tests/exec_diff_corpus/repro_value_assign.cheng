import std/result

var
    scratchLen: int32

fn mayFail(x: int32): Result[int32] =
    if x < 0:
        return Err[int32]("neg")
    return Ok[int32](x * 2)

fn callerAssign(x: int32): int32 =
    let sigLenRes: Result[int32] = mayFail(x)
    if IsErr(sigLenRes):
        return -1
    scratchLen = Value(sigLenRes)
    return scratchLen

fn main(): int32 =
    let r = callerAssign(21)
    if r != 42:
        return 1
    return 0
