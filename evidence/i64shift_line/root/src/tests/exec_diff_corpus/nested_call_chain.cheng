# form: nested call chain f(g(h(x))) -- the return value of one call is fed
# DIRECTLY as the (sole / first) argument to the enclosing call, three levels
# deep, with no intermediate let. observable: exit code. chain_field_arg passed
# a field as a NON-first arg; this stresses the call-result-as-call-arg path
# where each inner result lives only in a temporary that must survive being
# spilled across the outer call's argument-setup. A bug that reuses the same
# argument register/slot for the inner result and the outer call clobbers it.
fn h(x: int32): int32 =
    return x + 1
fn g(x: int32): int32 =
    return x * 2
fn f(x: int32): int32 =
    return x - 3
fn main(): int32 =
    # h(5)=6 ; g(6)=12 ; f(12)=9.
    if f(g(h(5))) != 9:
        return 1
    # deeper: h(h(h(0)))=3.
    if h(h(h(0))) != 3:
        return 2
    # mixed order with two args at the outer level, inner chain on one of them.
    # add(f(g(h(2))), h(2)) where add is a 2-arg fn.
    if add2(f(g(h(2))), h(2)) != 6:
        return 3
    # chain feeding both args of a binary fn.
    # g(h(1))=4 ; h(g(1))=3 ; add2(4,3)=7.
    if add2(g(h(1)), h(g(1))) != 7:
        return 4
    # four levels deep: f(f(g(h(10)))) = f(f(g(11))) = f(f(22)) = f(19) = 16.
    if f(f(g(h(10)))) != 16:
        return 5
    # nested chain as the addend inside an arithmetic expression.
    let r: int32 = 100 + f(g(h(5))) - g(h(0))
    # f(g(h(5)))=9 ; g(h(0))=2 ; 100+9-2 = 107.
    if r != 107:
        return 6
    return 0
fn add2(a: int32, b: int32): int32 =
    return a + b
