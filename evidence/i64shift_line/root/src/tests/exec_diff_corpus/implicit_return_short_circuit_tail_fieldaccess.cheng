# form: implicit_return_short_circuit_tail_fieldaccess -- #128-r7 sibling of
# implicit_return_short_circuit_tail.cheng: the SAME implicit-tail-return
# short-circuit shape, but the statement is routed through the
# `ident.field...` continuation branch in parse_statement (#127,
# cold_parser.c ~20403) instead of the generic bare-expression-statement
# branch, because the statement starts with a struct field access
# (`ctx.hasLedger && ...`) rather than a bare identifier/literal/call. This
# is the shape of the real production consumer
# `src/libp2p/protocols/bitswap/bitswap.cheng:66-67`'s
# `bitswapLedgerEnabled(): bool = bitswapContext.hasLedger &&
# bitswapContext.config.enableLedger` that #128-r6 missed (REFUTED verdict,
# see fix_verdict.md siblingSites): r6 only wired its side channel into the
# generic bare-expression branch, leaving this structurally-identical sibling
# branch's `(void)expr_slot;` untouched. #128-r7 wires all three
# structurally-identical fallback sites (bare-expression, ident.field-led,
# call-led) through the same depth-gated side channel.
#
# Deliberately uses a function-parameter struct (`c: Ctx`), not a global
# `var`, as the field-access receiver: #128-r7 verification surfaced a
# SEPARATE, pre-existing, unrelated defect where `globalVar.f1 &&
# globalVar.f2` computes the wrong bool value regardless of implicit vs
# explicit `return` and regardless of this patch (reproduces byte-identical
# on the pristine baseline) -- that is a distinct global-struct-field &&
# codegen bug, not a #128 implicit-tail-return parsing bug, and is out of
# this fixture's scope (see fix_verdict.md honestResidual). Routing the
# receiver through a function parameter instead isolates exactly the #128-r7
# fix under test without confounding it with that separate defect.
#
# observable: process exit code. main returns 0 on success, a distinct
# nonzero code per failed sub-check; re-invokes ledgerEnabled with a mutated
# struct between calls to rule out a stale/shared-slot dataflow bug once the
# implicit-return fold is accepted.

type
    LedgerConfig =
        enableLedger: bool

    LedgerContext =
        hasLedger: bool
        config: LedgerConfig

fn ledgerEnabled(c: LedgerContext): bool =
    c.hasLedger && c.config.enableLedger

fn main(): int32 =
    var ctx: LedgerContext = LedgerContext(
        hasLedger: true,
        config: LedgerConfig(enableLedger: true)
    )
    if ledgerEnabled(ctx) != true:
        return 1

    ctx.hasLedger = false
    if ledgerEnabled(ctx) != false:
        return 2

    ctx.hasLedger = true
    ctx.config.enableLedger = false
    if ledgerEnabled(ctx) != false:
        return 3

    # flip back and re-check to rule out a stale/shared result slot leaking
    # a prior call's value across calls.
    ctx.config.enableLedger = true
    if ledgerEnabled(ctx) != true:
        return 4

    return 0
