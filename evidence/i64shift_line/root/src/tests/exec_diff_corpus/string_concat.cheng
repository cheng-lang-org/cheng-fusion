# form: string concatenation and length. observable: exit code. Exercises str
# value building (concat -> new buffer) and Len on the result. Uses only Len as
# the scalar observable (no str across the C ABI).
fn joined(a: str, b: str): str =
    return a + b
fn main(): int32 =
    let s = joined("foo", "barbaz")
    if Len(s) != 9:
        return 1
    let empty = joined("", "")
    if Len(empty) != 0:
        return 2
    let one = joined("x", "")
    if Len(one) != 1:
        return 3
    # chained concat
    let chained = joined(joined("ab", "cd"), "ef")
    if Len(chained) != 6:
        return 4
    return 0
