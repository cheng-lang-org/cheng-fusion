# form: while-loop with ONE carry accumulator (acc) plus a read-only i64 param
# (k) that is a residency candidate -- exercises backend2 slice-3 leaves
# FillBlockEntryReloads (residency reload at each block entry, skip-carried arm
# emit_ops:3455) COEXISTING with carry (FillBlockEntryCarryStore /
# FillBlockExitCarryLoad preheader load). i64_carry_sumloop has carry but its
# only loop-invariant (n) is the compare bound; here k is read ONLY as a BinOp
# operand inside the body, so residency (x19+) and carry registers must share
# the callee-saved band. Part of the backend2 slice-3 leaf coverage battery.
# expected runtime: f(10, 7) = 10*7 = 70 -> main returns 0.
# observable: exit code.
fn f(n: int64, k: int64): int64 =
    var acc: int64
    var i: int64
    while i < n:
        acc = acc + k
        i = i + int64(1)
    return acc

fn main(): int32 =
    if f(int64(10), int64(7)) != int64(70):
        return 1
    if f(int64(0), int64(7)) != int64(0):
        return 2
    return 0
