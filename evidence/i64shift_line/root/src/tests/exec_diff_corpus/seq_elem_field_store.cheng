# form: store into a *field of a dynamic-seq element* -- `s[i].flag = true`.
# Mirrors parser ParserAddUniqueTypeDecl's `out[i].refObject = true` that the
# pure backend bails on (bail_711: assign-field-type unstable for an indexed
# base whose root is a `var T[]` dynamic seq). The field-store address is
# base = seq.data + i*elemSize, then +fieldOffset; the lowering must resolve
# the element struct's field metadata through the indexed base. observable:
# exit code. Sibling fields + other elements must stay untouched.
type
    Row =
        id: int32
        flag: bool
        weight: int32

fn build(): Row[] =
    var rows: Row[]
    var a: Row
    a.id = 10
    a.flag = false
    a.weight = 100
    add(rows, a)
    var b: Row
    b.id = 20
    b.flag = false
    b.weight = 200
    add(rows, b)
    return rows

fn main(): int32 =
    var rows = build()
    if rows.len != 2:
        return 1
    # the bail form: field store into a dynamic-seq element.
    rows[1].flag = true
    rows[0].weight = rows[0].weight + 1
    # element 1 flag set, element 0 flag untouched.
    if !rows[1].flag:
        return 2
    if rows[0].flag:
        return 3
    # sibling fields of the mutated element untouched.
    if rows[1].id != 20:
        return 4
    if rows[1].weight != 200:
        return 5
    # element 0 weight bumped, id untouched.
    if rows[0].weight != 101:
        return 6
    if rows[0].id != 10:
        return 7
    return 0
