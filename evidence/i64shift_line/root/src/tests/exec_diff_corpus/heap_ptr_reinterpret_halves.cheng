# 覆盖哨兵 — 宽 store 落全 8 字节 + 小端布局, 经 32 位 named-ptr 读半字验证.
#
# 触发点: `*(I64P) = 0x1122334455667788` 宽存, 再经两个 named I32P (偏移 0 / 4)
#   inline 读回低半字 (0x55667788) 与高半字 (0x11223344). 32 位 inline load 宽度
#   正确(不触发宽截断 bug), 但能证明: 宽 store 确实写满 8 字节(截断的 store 会让高
#   半字=0) 且小端字节序正确. corpus 无 "宽存→半字重解释" 形. drv_fix/base 均 rc=0.
# 取址: malloc + ptr 算术, 无 &. 期望 0.

type
    I64P = int64 *
    I32P = int32 *

@importc("malloc")
fn c_malloc(n: uint64): ptr

fn main(): int32 =
    let raw = c_malloc(uint64(8))
    let wp: I64P = I64P(raw)
    *wp = 1234605616436508552
    let lop: I32P = I32P(ptr(uint64(raw) + uint64(0)))
    let hip: I32P = I32P(ptr(uint64(raw) + uint64(4)))
    let lo = *lop
    let hi = *hip
    if lo != 1432778632:
        return 1
    if hi != 287454020:
        return 2
    return 0
