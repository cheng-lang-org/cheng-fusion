# form: unsigned integer relational compares (> >= < <=) where the LHS has its
#   high bit set (0x80000000 for uint32, 0x8000000000000000 for uint64). With a
#   SIGNED compare those large unsigned values look NEGATIVE, so every ordering
#   inverts. observable: exit code (main returns 0 iff every assert holds).
#
# This is a SHARED backend bug for uint32 (BOTH driver AND stage3 emit the
# signed condition code `gt/ge/lt/le` instead of the unsigned `hi/hs/lo/ls`, so
# the exec_diff net sees MATCH and stays blind) and a DRIVER-ONLY bug for uint64
# (stage3 happens to emit the unsigned form there). Because of the shared half
# the fixture asserts the EXPECTED value DIRECTLY rather than relying on the
# diff: 0x80000000 > 1 is TRUE for unsigned, FALSE under a signed compare.
# Each `return N` pins the first failing assert.
#
# High-bit values use 0x8000_0000 / 0x8000_..._0000 literals (both compilers
# materialize these; the all-ones 0xFFFFFFFF form is dropped by the cold
# front-end's literal-fit check, so it is avoided here). int32 signed controls
# (return 80..83) guard against a regression that flips genuinely-signed
# compares to unsigned.

# Operands flow through runtime params so each `>`/`>=`/`<`/`<=` is a real
# register compare (cmp + cset), exactly where the wrong condition code lands.
fn u32_gt(a: uint32, b: uint32): bool =
    return a > b
fn u32_ge(a: uint32, b: uint32): bool =
    return a >= b
fn u32_lt(a: uint32, b: uint32): bool =
    return a < b
fn u32_le(a: uint32, b: uint32): bool =
    return a <= b

fn u64_gt(a: uint64, b: uint64): bool =
    return a > b
fn u64_ge(a: uint64, b: uint64): bool =
    return a >= b
fn u64_lt(a: uint64, b: uint64): bool =
    return a < b
fn u64_le(a: uint64, b: uint64): bool =
    return a <= b

fn i32_gt(a: int32, b: int32): bool =
    return a > b
fn i32_lt(a: int32, b: int32): bool =
    return a < b

fn main(): int32 =
    # uint32 high bit set: 0x80000000 (2147483648) must compare > 1 (unsigned).
    let big32: uint32 = 0x80000000
    let one32: uint32 = 1
    if big32 == 0:
        return 99
    if !u32_gt(big32, one32):
        return 1
    if u32_gt(one32, big32):
        return 2
    if !u32_ge(big32, one32):
        return 3
    if !u32_ge(big32, big32):
        return 4
    if !u32_lt(one32, big32):
        return 5
    if u32_lt(big32, one32):
        return 6
    if !u32_le(one32, big32):
        return 7
    if u32_le(big32, one32):
        return 8

    # uint64 high bit set: 0x8000000000000000 must compare > 1 (unsigned).
    let big64: uint64 = 0x8000000000000000
    let one64: uint64 = 1
    if big64 == 0:
        return 98
    if !u64_gt(big64, one64):
        return 11
    if u64_gt(one64, big64):
        return 12
    if !u64_ge(big64, one64):
        return 13
    if !u64_ge(big64, big64):
        return 14
    if !u64_lt(one64, big64):
        return 15
    if u64_lt(big64, one64):
        return 16
    if !u64_le(one64, big64):
        return 17
    if u64_le(big64, one64):
        return 18

    # int32 SIGNED control: -1 < 1 (and -1 is NOT > 1) must STAY signed.
    let neg32: int32 = -1
    let posone32: int32 = 1
    if !i32_lt(neg32, posone32):
        return 80
    if i32_gt(neg32, posone32):
        return 81
    if !i32_gt(posone32, neg32):
        return 82
    if i32_lt(posone32, neg32):
        return 83

    return 0
