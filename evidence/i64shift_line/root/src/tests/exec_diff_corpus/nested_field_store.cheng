# form: nested field store -- box.a.v = ... ; multi-level struct field assign.
type
    Inner =
        v: int32
    Box =
        a: Inner
        b: Inner
fn main(): int32 =
    var box: Box
    box.a.v = 7
    box.b.v = 11
    box.a.v = box.a.v + box.b.v
    if box.a.v != 18:
        return 1
    if box.b.v != 11:
        return 2
    return 0