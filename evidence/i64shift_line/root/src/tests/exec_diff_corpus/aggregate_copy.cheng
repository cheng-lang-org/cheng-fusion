# form: aggregate pass-by-value -- a struct passed by value is copied; mutating
# the callee's copy must not affect the caller's original. (Whole-struct
# copy-init `let r2 = r` is covered separately by field_load; this fixture uses
# field-wise init so BOTH the driver node path and stage3's cold parser accept
# it, keeping the case diffable.)
type
    P =
        x: int32
        y: int32

fn bump(p: P): P =
    var q: P
    q.x = p.x + 100
    q.y = p.y
    return q

fn main(): int32 =
    var a: P
    a.x = 1
    a.y = 2
    let b = bump(a)
    if a.x != 1:          # caller's original untouched
        return 1
    if a.y != 2:
        return 2
    if b.x != 101:        # callee's copy mutated
        return 3
    if b.y != 2:
        return 4
    return 0
