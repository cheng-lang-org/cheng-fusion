# form: manual bit-packing into a uint32 word (shift+or to pack, shift+mask to
# unpack) — the "bitfield" form done explicitly. observable: exit code.
# Exercises 32-bit shift/mask correctness and field-extract round-trips.
fn pack(r: uint32, g: uint32, b: uint32, a: uint32): uint32 =
    return (r << uint32(24)) | (g << uint32(16)) | (b << uint32(8)) | a
fn red(w: uint32): uint32 =
    return (w >> uint32(24)) & uint32(0xFF)
fn green(w: uint32): uint32 =
    return (w >> uint32(16)) & uint32(0xFF)
fn blue(w: uint32): uint32 =
    return (w >> uint32(8)) & uint32(0xFF)
fn alpha(w: uint32): uint32 =
    return w & uint32(0xFF)
fn main(): int32 =
    let w = pack(uint32(0x12), uint32(0x34), uint32(0x56), uint32(0x78))
    if w != uint32(0x12345678):
        return 1
    if red(w) != uint32(0x12):
        return 2
    if green(w) != uint32(0x34):
        return 3
    if blue(w) != uint32(0x56):
        return 4
    if alpha(w) != uint32(0x78):
        return 5
    # high bit set: ensure no sign issues on the uint32 OR.
    let hi = pack(uint32(0xFF), uint32(0x00), uint32(0xFF), uint32(0x00))
    if hi != uint32(0xFF00FF00):
        return 6
    if red(hi) != uint32(0xFF):
        return 7
    return 0
