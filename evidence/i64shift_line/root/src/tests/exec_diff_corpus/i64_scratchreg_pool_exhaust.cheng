# Stage9 temp allocator KILLER-3 pool exhaustion: many I64 temps live SIMULTANEOUSLY into one
# final combine, exceeding the 3-reg pool (x13/x14/x15). The excess MUST spill to its stack slot
# (current ldr/str) and the result MUST still be correct. Stage3 is the oracle.
fn wide(a: int64, b: int64, c: int64, d: int64, e: int64, f: int64): int64 =
    let p: int64 = (a + b) & int64(1048575)
    let q: int64 = (c + d) & int64(1048575)
    let r: int64 = (e + f) & int64(1048575)
    let s: int64 = (a ^ f) & int64(1048575)
    let u: int64 = (b ^ e) & int64(1048575)
    return ((((p + q) + r) + s) + u) & int64(1048575)
fn main(): int32 =
    let v: int64 = wide(int64(1), int64(2), int64(3), int64(4), int64(5), int64(6))
    # p=3 q=7 r=11 s=(1^6)=7 u=(2^5)=7 ; sum=35
    if v != int64(35):
        return 1
    return 0
