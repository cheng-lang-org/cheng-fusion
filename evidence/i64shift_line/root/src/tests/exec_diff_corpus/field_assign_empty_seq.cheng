# form: field-assign empty-seq RHS -- out.ops = []
# `out.ops = []` resets a struct's seq field to an empty 16-byte header.
# Frontend must build an EmptySeqInit node for the `[]` RHS so the node-eval
# path owns the field-store (was assign no_node before the fix: rhsNodeIndex=-1
# left the field-store to the text path / dropped silently).
type
    Bag =
        tag: int32
        ops: int32[]

fn reset(src: Bag): Bag =
    var out = src
    out.ops = []
    return out

fn main(): int32 =
    var b: Bag
    b.tag = 5
    add(b.ops, 7)
    add(b.ops, 11)
    if b.ops.len != 2:
        return 1
    # reset the seq field to empty via `= []` on a `var out = param` local
    let r = reset(b)
    if r.ops.len != 0:
        return 2
    if r.tag != 5:
        return 3
    # original must be untouched (copy semantics)
    if b.ops.len != 2:
        return 4
    return 0
