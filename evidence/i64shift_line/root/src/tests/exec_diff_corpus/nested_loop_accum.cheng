# form: doubly/triply nested for-range loops accumulating into a single scalar,
# with the inner bound depending on the outer index. observable: exit code.
# while_break_carry used while loops with break; this uses plain for-range with
# index-dependent inner bounds and a 3-deep nest, stressing nested loop-variable
# liveness (each level's induction var must survive the inner loops) and the
# running accumulator across loop-back edges.
fn main(): int32 =
    # 1) rectangular double loop: sum of i*j for i,j in 0..<4.
    #    = (sum i)(sum j) = 6*6 = 36.
    var s1: int32
    for i in 0..<4:
        for j in 0..<4:
            s1 = s1 + i * j
    if s1 != 36:
        return 1

    # 2) triangular: inner bound depends on outer -> sum over i<j<5 of 1
    #    = C(5,2) = 10.
    var cnt: int32
    for i in 0..<5:
        for j in (i + 1)..<5:
            cnt = cnt + 1
    if cnt != 10:
        return 2

    # 3) triple nest accumulating i+j+k for i,j,k in 0..<3.
    #    each var ranges 0..2 (sum 3), 27 triples, each coord contributes
    #    sum over the cube = 3*9*3 = 81.
    var s3: int32
    for i in 0..<3:
        for j in 0..<3:
            for k in 0..<3:
                s3 = s3 + i + j + k
    if s3 != 81:
        return 3

    # 4) nested with a carry that the inner loop reads from the outer var.
    var acc: int32
    for i in 0..<4:
        var rowBase: int32 = i * 10
        for j in 0..<3:
            acc = acc + rowBase + j
    # rows: i=0 base0:0+1+2=3 ; i=1 base10:33 ; i=2 base20:63 ; i=3 base30:93.
    # total = 3+33+63+93 = 192.
    if acc != 192:
        return 4

    # 5) nested loop where the inner loop's result feeds an outer-scope multiply.
    var prodSum: int32
    for i in 1..<4:
        var inner: int32
        for j in 1..<4:
            inner = inner + j
        prodSum = prodSum + i * inner
    # inner = 1+2+3 = 6 each row ; prodSum = (1+2+3)*6 = 36.
    if prodSum != 36:
        return 5
    return 0
