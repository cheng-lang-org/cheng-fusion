# form: in-place selection sort of a fixed array of STRUCTS, swapping the two
# struct elements FIELD BY FIELD via scalar temporaries. observable: exit code.
# struct_array_field_rmw read-modified ONE field in place; this swaps the FULL
# struct payload of two elements (both fields) at runtime-variable indices i and
# minIdx, driving struct-array element-field LOAD and STORE under loop-variable
# indices and a nested comparison loop. A miscompile in the element-field address
# (base + i*elemSize + fieldOff) for either side, or one that swaps only `key`
# and forgets `payload`, corrupts the sort and diverges from stage3.
#
# DRIVER MISCOMPILE (blame=DRIVER, net-audit r12): driver returns rc=2 while
# stage3 returns 0. Reduced to the minimal trigger `let tk = arr[i].key` where
# `i` is a local int32 holding 0: otool shows the driver emits NO load for this
# statement — the `tk` slot ([sp,#0x80]) is read by the next compare but never
# WRITTEN (no madd/ldr computing arr[i].key into it), so tk is stack garbage.
# i.e. a `let` binding whose RHS is a VARIABLE-indexed struct-array element-FIELD
# load (`arr[i].field`) is dropped entirely; the binding slot is left
# uninitialized. Constant-index field stores (the init block) lower correctly;
# only the variable-index element-field LOAD into a let is dropped. blame=DRIVER.
type
    Rec =
        key: int32
        payload: int32
fn main(): int32 =
    var arr: Rec[5]
    arr[0].key = 30
    arr[0].payload = 300
    arr[1].key = 10
    arr[1].payload = 100
    arr[2].key = 50
    arr[2].payload = 500
    arr[3].key = 20
    arr[3].payload = 200
    arr[4].key = 40
    arr[4].payload = 400

    # selection sort ascending by key, swapping element fields via scalar temps.
    for i in 0..<5:
        var minIdx: int32 = i
        for j in (i + 1)..<5:
            if arr[j].key < arr[minIdx].key:
                minIdx = j
        if minIdx != i:
            let tk: int32 = arr[i].key
            let tp: int32 = arr[i].payload
            arr[i].key = arr[minIdx].key
            arr[i].payload = arr[minIdx].payload
            arr[minIdx].key = tk
            arr[minIdx].payload = tp

    # keys must now be 10,20,30,40,50 with payloads carried along (key*10).
    if arr[0].key != 10:
        return 1
    if arr[1].key != 20:
        return 2
    if arr[2].key != 30:
        return 3
    if arr[3].key != 40:
        return 4
    if arr[4].key != 50:
        return 5
    # payload must travel WITH its key (proves whole-element swap, not just key).
    if arr[0].payload != 100:
        return 6
    if arr[1].payload != 200:
        return 7
    if arr[2].payload != 300:
        return 8
    if arr[3].payload != 400:
        return 9
    if arr[4].payload != 500:
        return 10
    # sum of keys unchanged (no element lost/duplicated): 150.
    var ksum: int32
    for i in 0..<5:
        ksum = ksum + arr[i].key
    if ksum != 150:
        return 11
    return 0
