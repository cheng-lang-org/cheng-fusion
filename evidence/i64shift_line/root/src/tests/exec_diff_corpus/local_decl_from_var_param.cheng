# form: a LOCAL declared from a `var int32` by-ref param read — `var end = pos`
# where `pos: var int32`. The local binds the VALUE read out of the reference
# (int32), never the reference itself. The miscompile (G9): the binding-type
# inference resolved `end`'s type from the RHS ident `pos`'s declared type text
# `var int32`, leaving the `var` qualifier, so the backend typed `end`'s slot as
# Ptr. A later `end = pos + 1` (I32Add to a local) is then rejected (LHS not
# I32) and the whole function falls to a word-count-zero invalid op. Fix strips
# the var qualifier in TypedExprInferLocalDeclTypeFromIdentRhs (value of an ident
# read is never a reference). stage3 (cold) is correct. observable: exit code.
fn scan(pos: var int32, limit: int32): int32 =
    let start = pos
    var end = pos
    while pos < limit:
        end = pos + 1
        pos = pos + 1
    return end - start

fn main(): int32 =
    var p: int32 = 2
    # scan advances p from 2 to 5; end tracks pos+1 each step, final end = 5.
    let span = scan(p, 5)
    if span != 3:
        return 1
    # the by-ref param must have advanced the caller's slot to the limit.
    if p != 5:
        return 2
    var q: int32 = 7
    let span2 = scan(q, 7)
    # loop body never runs (q already == limit): end stays = initial pos (7),
    # start = 7, span2 = 0.
    if span2 != 0:
        return 3
    if q != 7:
        return 4
    return 0
