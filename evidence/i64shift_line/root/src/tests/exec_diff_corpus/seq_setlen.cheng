# form: setLen(seq, n) builtin -- bare-call seq resize (was call_ordinal gap ->
# whole function fell to cold). Exercises grow+zero-tail, shrink, and an
# expression-valued length arg. observable: process exit code.
# (Field-path setLen(b.xs, n) is also lowered by the driver and verified
# host-side, but the stage3 cold reference miscompiles that form, so the shared
# corpus fixture stays on the forms where both compilers agree.)
fn main(): int32 =
    var xs: int32[]
    # grow from empty: setLen must allocate + zero-fill the new tail
    setLen(xs, 4)
    if xs.len != 4:
        return 1
    if xs[0] != 0 || xs[3] != 0:
        return 2
    xs[0] = 11
    xs[3] = 44
    # grow again: old values preserved, new tail zeroed
    setLen(xs, 6)
    if xs.len != 6:
        return 3
    if xs[0] != 11 || xs[3] != 44:
        return 4
    if xs[4] != 0 || xs[5] != 0:
        return 5
    # shrink: len drops, no realloc
    setLen(xs, 2)
    if xs.len != 2:
        return 6
    if xs[0] != 11 || xs[1] != 0:
        return 7
    # length argument as an expression
    var n: int32 = 1
    setLen(xs, n + 2)
    if xs.len != 3:
        return 8
    return 0
