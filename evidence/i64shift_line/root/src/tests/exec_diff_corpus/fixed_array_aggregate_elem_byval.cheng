# form: read a LARGE-aggregate element BY VALUE out of a fixed-size array, then
# read fields at HIGH byte offsets (well past the first 8 bytes). The IndexGet
# non-fast-path must load the FULL element shape, not a truncated scalar width —
# a truncated FieldLoad leaves the high-offset fields as zero/garbage. observable:
# exit code. Covers both a fixed array inside a struct (g.arr[i]) and a bare
# fixed-array local (arr[i]).
type
    Rec =
        a: int32
        b: int32
        c: int32
        d: int32
        e: int32
        f: int32
        g: int32
        h: int32
        i: int32
        j: int32

    Holder =
        recs: Rec[4]

fn makeRec(base: int32): Rec =
    var r: Rec
    r.a = base + 0
    r.b = base + 1
    r.c = base + 2
    r.d = base + 3
    r.e = base + 4
    r.f = base + 5
    r.g = base + 6
    r.h = base + 7
    r.i = base + 8
    r.j = base + 9
    return r

fn sumRec(r: Rec): int32 =
    return r.a + r.b + r.c + r.d + r.e + r.f + r.g + r.h + r.i + r.j

fn main(): int32 =
    var hold: Holder
    hold.recs[0] = makeRec(100)
    hold.recs[1] = makeRec(200)
    hold.recs[2] = makeRec(300)
    hold.recs[3] = makeRec(400)

    # Read element BY VALUE from struct field fixed array, then read high-offset
    # fields. If the element load truncates, h/i/j (offsets 28/32/36) read 0.
    let e1 = hold.recs[1]
    if e1.a != 200:
        return 1
    if e1.e != 204:
        return 2
    if e1.h != 207:
        return 3
    if e1.i != 208:
        return 4
    if e1.j != 209:
        return 5
    # sum of base=200 element: 10*200 + (0+1+..+9)=2000+45=2045
    if sumRec(hold.recs[1]) != 2045:
        return 6
    # last element high fields
    let e3 = hold.recs[3]
    if e3.j != 409:
        return 7
    if sumRec(e3) != 4045:
        return 8

    # Bare fixed-array local element read by value.
    var arr: Rec[3]
    arr[0] = makeRec(10)
    arr[1] = makeRec(20)
    arr[2] = makeRec(30)
    let a2 = arr[2]
    if a2.a != 30:
        return 9
    if a2.j != 39:
        return 10
    if sumRec(arr[1]) != 245:
        return 11

    return 0
