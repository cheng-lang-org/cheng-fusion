# form: two CALL-bearing ternaries added inline in one expression --
#   (n>0 ? f(n) : g(n)) + (n<0 ? f(n) : g(n))
# observable: exit code. Each ternary in isolation, and the two split into
# separate `let` statements, are correct on BOTH compilers (verified: left=6,
# right=103, r=109). The bug appears ONLY in the inline-composed form.
#
# DRIVER MISCOMPILE (blame=DRIVER): the driver drops the RIGHT operand of the
# `+` -- it returns just the left ternary's value (6) instead of 6+103=109,
# while stage3 returns the correct 109. The select+call lowering for the first
# ternary clobbers the live accumulator before the second ternary's call result
# is added (a live-value-across-call register/slot clobber, distinct from the
# call-free nested_ternary and the single-call scalar_ternary_call fixtures).
fn f(x: int32): int32 =
    return x * 2
fn g(x: int32): int32 =
    return x + 100
fn main(): int32 =
    let n: int32 = 3
    # left = f(3) = 6 ; right = g(3) = 103 ; sum = 109
    let r: int32 = (n > 0 ? f(n) : g(n)) + (n < 0 ? f(n) : g(n))
    if r != 109:
        return 1
    # reversed operand order: left arm now picks g, right arm picks f
    let r2: int32 = (n < 0 ? f(n) : g(n)) + (n > 0 ? f(n) : g(n))
    if r2 != 109:
        return 2
    return 0
