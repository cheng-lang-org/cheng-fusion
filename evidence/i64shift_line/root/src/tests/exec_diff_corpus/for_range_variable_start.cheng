# form: for-range loops with NON-literal start bounds (`for i in start..<end`,
# `start..end` inclusive, arithmetic start, nested). The node-eval for-range
# emitter materializes the start bound; this pins that the materialized start
# equals the source value at runtime. A miscompile that inits the index from 0
# (the legacy literal-start text fallback) instead of the real start value
# changes every sum below and flips the exit code.

fn sumExcl(start: int32, endv: int32): int32 =
    var total = 0
    for i in start..<endv:
        total = total + i
    return total

fn sumIncl(start: int32, endv: int32): int32 =
    var total = 0
    for i in start..endv:
        total = total + i
    return total

fn sumArithStart(a: int32, b: int32, endv: int32): int32 =
    var total = 0
    for i in (a + b)..<endv:
        total = total + i
    return total

fn sumNested(base: int32, n: int32): int32 =
    var total = 0
    for i in base..<n:
        for j in base..<n:
            total = total + 1
    return total

fn main(): int32 =
    # sum of 3,4,5,6,7 = 25
    if sumExcl(3, 8) != 25:
        return 1
    # sum of 10,11,12 = 33 (inclusive)
    if sumIncl(10, 12) != 33:
        return 2
    # start = 2+3 = 5, sum 5,6,7,8,9 = 35
    if sumArithStart(2, 3, 10) != 35:
        return 3
    # nested: (5-2)*(5-2) = 9 iterations
    if sumNested(2, 5) != 9:
        return 4
    # empty range: start >= end -> 0
    if sumExcl(9, 4) != 0:
        return 5
    return 0
