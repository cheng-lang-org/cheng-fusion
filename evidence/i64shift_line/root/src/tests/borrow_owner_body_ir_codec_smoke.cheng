import std/rawbytes as rawbytes
import std/result
import cheng/core/backend2/backend2_frag_codec as codec
import cheng/core/ir/core_types as coreir
import cheng/std/bytes_layout as layout

fn main(): int32 =
    var body = coreir.BodyIRNew()
    let parsed = layout.FixedBytes32FromHex(
        "9090909090909090909090909090909090909090909090909090909090909090")
    if IsErr(parsed) ||
       !coreir.BodyIRBindTypeArenaArtifactCid(
           body, Value(parsed)):
        return 2
    var call: coreir.CallOp
    coreir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = "borrow_owner_codec"
    call.resultSlot = 7
    call.resultPassKind = coreir.BodyCallPassSretResultTag
    call.resultOwnership = coreir.OwnBorrowShared
    call.resultExprNodeIndex = 31
    call.resultValueDefinitionRow = 41
    call.resultBorrowOwnerValueDefinitionRow = 37
    call.resultBorrowOwnerDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    call.resultBorrowOwnerDefinitionRow = 5
    call.resultDefinitionOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    call.resultDefinitionOriginId = 41
    add(body.callSequence, call)

    var op: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = coreir.BodyOpCallTag
    op.target = 7
    op.valueDefSlot = 7
    op.valueDefExprNodeIndex = 31
    op.valueDefSemanticRow = 41
    op.valueDefOwnership = coreir.OwnBorrowShared
    op.valueDefBorrowOwnerSemanticRow = 37
    op.valueDefBorrowOwnerDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    op.valueDefBorrowOwnerDefinitionRow = 5
    op.valueDefOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    op.valueDefOriginId = 41
    add(op.operands, 0)
    add(body.ops, op)

    var encoded = codec.Backend2BodyIrEncode(body)
    var cursor: int32
    let decoded = codec.Backend2BodyIrDecode(encoded, cursor)
    let decodedCall = decoded.callSequence[0]
    if cursor != rawbytes.BytesLen(encoded) ||
       decoded.ops.len != 1 ||
       decoded.callSequence.len != 1 ||
       decoded.ops[0].valueDefBorrowOwnerSemanticRow != 37 ||
       decoded.ops[0].valueDefBorrowOwnerDefinitionDomain !=
           coreir.BodyDefinitionDomainBodyOpTag ||
       decoded.ops[0].valueDefBorrowOwnerDefinitionRow != 5 ||
       decodedCall.resultBorrowOwnerValueDefinitionRow != 37 ||
       decodedCall.resultBorrowOwnerDefinitionDomain !=
           coreir.BodyDefinitionDomainBodyOpTag ||
       decodedCall.resultBorrowOwnerDefinitionRow != 5:
        rawbytes.BytesFree(encoded)
        return 1
    rawbytes.BytesFree(encoded)
    echo("borrow_owner_body_ir_codec_smoke ok")
    return 0
