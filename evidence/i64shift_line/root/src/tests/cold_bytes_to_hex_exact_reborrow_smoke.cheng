module cold_bytes_to_hex_exact_reborrow_smoke

import std/rawbytes

fn ProduceHex(outHex: var str): bool =
    var bytes = rawbytes.BytesAlloc(2)
    defer:
        rawbytes.BytesFree(bytes)
    rawbytes.BytesSet(bytes, 0, 10)
    rawbytes.BytesSet(bytes, 1, 255)
    outHex = rawbytes.BytesToHex(bytes)
    return outHex == "0aff"

fn main(): int32 =
    var outHex: str
    if !ProduceHex(outHex):
        return 1
    return 0
