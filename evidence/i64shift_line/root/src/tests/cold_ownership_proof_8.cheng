// Ownership proof 8: multi-variable no-alias test
// Tests that multiple distinct local variables are treated as non-aliasing,
// each with single-writer ownership across identity rewrites.
// - Each variable is a distinct slot with exactly one writer
// - Cross-variable operations exercise separate ownership chains
// - Single-writer property maintained across if-else blocks
// - Verify ownership report fields are populated on compilation

fn main(): int32 =
    // Distinct variables, each a separate slot with unique writer
    let a = 5
    let b = 10
    let c = 3
    let d = 7

    // x + 0 -> x (I32_ADD identity, requires single-writer on 0)
    let r1 = a + 0
    if r1 != 5: return 1

    // x - 0 -> x (I32_SUB identity)
    let r2 = b - 0
    if r2 != 10: return 2

    // x * 1 -> x (I32_MUL identity, mul by 1)
    let r3 = c * 1
    if r3 != 3: return 3

    // x * 0 -> 0 (I32_MUL identity, mul by 0)
    let r4 = a * 0
    if r4 != 0: return 4

    // x & -1 -> x (I32_AND identity, all-ones mask)
    let r5 = d & -1
    if r5 != 7: return 5

    // x | 0 -> x (I32_OR identity)
    let r6 = d | 0
    if r6 != 7: return 6

    // x ^ 0 -> x (I32_XOR identity)
    let r7 = d ^ 0
    if r7 != 7: return 7

    // x - x -> 0 (same-slot self-subtraction)
    let r8 = a - a
    if r8 != 0: return 8

    // x == x -> 1 (self-equality)
    let r9 = a == a
    if r9 != 1: return 9

    // x != x -> 0 (self-inequality)
    let r10 = a != a
    if r10 != 0: return 10

    // x | -1 -> -1 (OR with all-ones mask)
    let r11 = d | -1
    if r11 != -1: return 11

    // x % 1 -> 0 (mod by 1 is always 0)
    let r12 = a % 1
    if r12 != 0: return 12

    // Multi-block single-writer: variable defined before if,
    // used in both branches via dominator chain
    let shared = 99
    if shared == 99:
        let in_if = shared + 0
        if in_if != 99: return 11
    else:
        let in_else = shared - 0
        if in_else != 99: return 12

    // After if-else, shared is still valid (dominator preserved)
    if shared != 99: return 13

    // Two variables defined before conditional, used in sub-blocks
    let xv = 7
    let yv = 3
    if xv > yv:
        let diff = xv - yv
        if diff != 4: return 14
    else:
        return 15

    echo(" ownership_proof_8 ok")
    return 0
