# Distinct import aliases: two physical multiaddress modules can coexist.
# The feed_core wall is the default-alias form in
# identity_same_name_default_alias_collision_main.cheng.
import cheng/tests/identity_wall_libp2p/multiaddress as libp2paddr
import cheng/tests/identity_wall_quic/multiaddress as quicaddr

fn main(): int32 =
    let a = libp2paddr.readSegment("ab", 1)
    let b = quicaddr.readSegment("ab", 1)
    if a == 3 && b == -1:
        return 0
    return 1
