import std/os
import std/strutils as strutil
import cheng/std/bytes_layout as layout
import cheng/core/backend/system_link_plan as slplan
import cheng/core/backend/system_link_exec as sexec
import cheng/core/lang/parser
import cheng/core/tooling/compiler_request as creq
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/tooling/compiler_world as cworld

fn AtomicCid(label: str): layout.FixedBytes32 =
    return ccsg.CompilerCsgPortableSourcePackageIdCid(label)

fn AtomicBuildPlan(root: str,
                   plan: var slplan.SystemLinkPlanStub,
                   entryText: var str) =
    let sourceDir = Fmt"{root}/src"
    let entryPath = Fmt"{sourceDir}/main.cheng"
    os.MkdirAll(sourceDir, 493)
    os.WriteFile(Fmt"{root}/cheng-package.toml",
                 "package_id = \"pkg://cheng/compiler-csg-portable-atomic\"\n")
    entryText = strutil.Join(
        ["import cheng/compiler-csg-portable-atomic/empty as empty\n\n",
         "fn Root(): int32 =\n",
         "    return 7\n"], "")
    os.WriteFile(entryPath, entryText)
    os.WriteFile(Fmt"{sourceDir}/empty.cheng", "")
    let base = creq.CompilerRequestNew(root,
                                       entryPath,
                                       Fmt"{root}/out.o",
                                       "arm64-apple-darwin",
                                       creq.EmitObj,
                                       "")
    let request = creq.CompilerRequestWithExportRootSymbols(base, ["Root"])
    var err = ""
    assert(slplan.BuildSystemLinkPlanStub(root, request, plan, err), err)
    assert(slplan.SystemLinkPlanSourceBundleBindingValidInto(plan, err), err)

fn AtomicSourceReceipt(plan: var slplan.SystemLinkPlanStub,
                       entryText: str,
                       out: var ccsg.PortableSourceIdentityReceipt) =
    var importGraphCid: layout.FixedBytes32
    var err = ""
    assert(cworld.CompilerWorldPortableImportGraphCidInto(
               plan.packageId,
               plan.importEdges,
               plan.unresolvedImportCount,
               importGraphCid,
               err), err)
    assert(ccsg.PortableSourceIdentityReceiptMakeInto(
               plan.sourceClosurePaths.len,
               plan.importEdges.len,
               plan.unresolvedImportCount,
               plan.packageId,
               plan.ownerModulePaths[plan.sourceBundleEntrySourceIndex],
               plan.sourceBundleCidValue,
               cworld.CompilerWorldSourceRawBytesCid(entryText),
               importGraphCid,
               out,
               err), err)

fn AtomicSentinelOut(out: var ccsg.CompilerCsg) =
    out.packageId = "sentinel/package"
    out.sourceBundleCid = AtomicCid("sentinel/source-bundle")
    out.sourceSnapshotCount = 92
    out.entrySourceCid = AtomicCid("sentinel/entry")
    out.graphCid = AtomicCid("sentinel/graph")
    out.canonicalGraphCid = AtomicCid("sentinel/canonical")
    out.nodeCount = 93
    out.edgeCount = 94
    out.sourceTextCapturedBytes = int64(95)
    var node: ccsg.CompilerCsgNode
    node.nodeId = 41
    node.nodeKind = ccsg.CompilerCsgNodeKindSymbol
    node.ownerNodeId = 40
    node.modulePath = "sentinel/module"
    node.symbolText = "Sentinel"
    node.factText = "sentinel-fact"
    node.semanticSource = "sentinel/source.cheng"
    node.semanticParamTypeJoin = "int32"
    node.semanticReturnType = "int32"
    node.factCid = AtomicCid("sentinel/node")
    add(out.nodes, node)
    var edge: ccsg.CompilerCsgEdge
    edge.edgeId = 51
    edge.fromNodeId = 40
    edge.toNodeId = 41
    edge.edgeKind = ccsg.CompilerCsgEdgeKindContains
    edge.edgeCid = AtomicCid("sentinel/edge")
    add(out.edges, edge)
    add(out.typedIr.functions2_functionNameIds, 501)

fn AtomicAssertSentinelOut(out: var ccsg.CompilerCsg) =
    assert(out.packageId == "sentinel/package" &&
           layout.FixedBytes32Equal(out.sourceBundleCid,
                                    AtomicCid("sentinel/source-bundle")) &&
           out.sourceSnapshotCount == 92 &&
           layout.FixedBytes32Equal(out.entrySourceCid,
                                    AtomicCid("sentinel/entry")) &&
           layout.FixedBytes32Equal(out.graphCid,
                                    AtomicCid("sentinel/graph")) &&
           layout.FixedBytes32Equal(out.canonicalGraphCid,
                                    AtomicCid("sentinel/canonical")) &&
           out.nodeCount == 93 && out.edgeCount == 94 &&
           out.sourceTextCapturedBytes == int64(95) &&
           out.nodes.len == 1 && out.edges.len == 1 &&
           out.typedIr.functions2_functionNameIds.len == 1,
           "portable atomic consume: sentinel scalar/owned shape changed")
    let node = out.nodes[0]
    let edge = out.edges[0]
    assert(node.nodeId == 41 &&
           node.nodeKind == ccsg.CompilerCsgNodeKindSymbol &&
           node.ownerNodeId == 40 &&
           node.modulePath == "sentinel/module" &&
           node.symbolText == "Sentinel" &&
           node.factText == "sentinel-fact" &&
           node.semanticSource == "sentinel/source.cheng" &&
           node.semanticParamTypeJoin == "int32" &&
           node.semanticReturnType == "int32" &&
           layout.FixedBytes32Equal(node.factCid, AtomicCid("sentinel/node")) &&
           edge.edgeId == 51 && edge.fromNodeId == 40 &&
           edge.toNodeId == 41 &&
           edge.edgeKind == ccsg.CompilerCsgEdgeKindContains &&
           layout.FixedBytes32Equal(edge.edgeCid, AtomicCid("sentinel/edge")) &&
           out.typedIr.functions2_functionNameIds[0] == 501,
           "portable atomic consume: sentinel owned row changed")

fn main() =
    let root = "/tmp/compiler_csg_portable_atomic_consume_smoke"
    var plan: slplan.SystemLinkPlanStub
    var entryText = ""
    AtomicBuildPlan(root, plan, entryText)
    var sourceReceipt: ccsg.PortableSourceIdentityReceipt
    AtomicSourceReceipt(plan, entryText, sourceReceipt)

    var sentinelOut: ccsg.CompilerCsg
    AtomicSentinelOut(sentinelOut)
    var overrides: ccsg.CompilerCsgSourceText[]
    var err = ""
    assert(!ccsg.BuildCompilerCsgConsumePortableReceiptWithOverridesInto(
                sentinelOut,
                err,
                plan,
                sourceReceipt,
                Fmt"{root}/src/forged-entry.cheng",
                "",
                overrides),
           "portable atomic consume: forged entry unexpectedly succeeded")
    AtomicAssertSentinelOut(sentinelOut)
    assert(ccsg.PortableSourceIdentityReceiptStrictValidateInto(sourceReceipt,
                                                                 err), err)
    assert(slplan.SystemLinkPlanSourceBundleBindingValidInto(plan, err), err)

    # Compact receipt capture authenticates the already-sealed plan columns; it
    # must not reopen every source.  CompilerCSG is the next byte consumer and
    # independently rejects a helper file changed after the plan was sealed.
    let helperPath = Fmt"{root}/src/empty.cheng"
    os.WriteFile(helperPath, "fn Attacker(): int32 =\n    return 9\n")
    assert(slplan.SystemLinkPlanSourceBundleBindingStructuralValidInto(
               plan,
               err), err)
    assert(!slplan.SystemLinkPlanSourceBundleBindingValidInto(plan, err),
           "portable atomic consume: full byte validation accepted changed helper")
    var compactReceipt: sexec.SystemLinkExecSourceBundleReceipt
    assert(sexec.SystemLinkExecSourceBundleReceiptCaptureInto(
               plan,
               sourceReceipt,
               compactReceipt,
               err), err)
    var changedSourceOut: ccsg.CompilerCsg
    AtomicSentinelOut(changedSourceOut)
    var changedSourceOverrides: ccsg.CompilerCsgSourceText[]
    assert(!ccsg.BuildCompilerCsgConsumePortableReceiptWithOverridesInto(
                changedSourceOut,
                err,
                plan,
                sourceReceipt,
                Fmt"{root}/src/main.cheng",
                entryText,
                changedSourceOverrides),
           "portable atomic consume: changed helper crossed CompilerCSG boundary")
    AtomicAssertSentinelOut(changedSourceOut)
    assert(ccsg.PortableSourceIdentityReceiptStrictValidateInto(sourceReceipt,
                                                                 err), err)
    os.WriteFile(helperPath, "")
    assert(slplan.SystemLinkPlanSourceBundleBindingValidInto(plan, err), err)

    var firstOut: ccsg.CompilerCsg
    assert(ccsg.BuildCompilerCsgConsumePortableReceiptInto(firstOut,
                                                            err,
                                                            plan,
                                                            sourceReceipt), err)
    # version 字段已随 receipt 去版本化删除; moved-out receipt 归零,
    # 以零值 receiptCid/count 证明第一次 consume 确实 move。
    assert(layout.FixedBytes32Equal(sourceReceipt.receiptCid,
                                    layout.FixedBytes32()) &&
           sourceReceipt.sourceSnapshotCount == 0 &&
           firstOut.nodes.len > 0 &&
           firstOut.typedIr.functions2_functionNameIds.len > 0,
           "portable atomic consume: first consume did not commit/move")
    let firstReport = ccsg.CompilerCsgReport(firstOut)
    let firstNodeCount = firstOut.nodes.len
    let firstFunctionCount = firstOut.typedIr.functions2_functionNameIds.len
    let firstSourceReceiptCid = firstOut.sourceIdentityReceipt.receiptCid
    assert(!ccsg.BuildCompilerCsgConsumePortableReceiptInto(firstOut,
                                                             err,
                                                             plan,
                                                             sourceReceipt),
           "portable atomic consume: real second consume unexpectedly succeeded")
    # 已 move 的 receipt 全零, 二次消费在 receipt strict 校验处必拒。
    assert(strutil.Contains(err, "portable source receipt counts invalid"),
           Fmt"portable atomic consume: second consume wrong error={err}")
    assert(ccsg.CompilerCsgReport(firstOut) == firstReport &&
           firstOut.nodes.len == firstNodeCount &&
           firstOut.typedIr.functions2_functionNameIds.len ==
               firstFunctionCount &&
           layout.FixedBytes32Equal(firstOut.sourceIdentityReceipt.receiptCid,
                                    firstSourceReceiptCid),
           "portable atomic consume: second consume changed first output")
    ccsg.CompilerCsgReleaseBackendInputPayload(firstOut)
    os.WriteLine(os.Get_stdout(),
                 "compiler_csg_portable_atomic_consume_smoke: ok")
