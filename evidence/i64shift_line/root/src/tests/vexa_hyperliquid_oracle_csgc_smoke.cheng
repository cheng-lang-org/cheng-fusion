import std/os as os
import std/rawbytes
import cheng/std/bytes_layout as layout
import cheng/oracle/oracle_types as oracle_types
import cheng/oracle/oracle_plane as oracle_plane
import cheng/core/csg_asset/oracle_asset as asset
import cheng/core/csg_asset/hyperliquid_source as hyper
import cheng/core/csg_core/validator as csg
import cheng/core/csg_core/csgc
import cheng/apps/vexa/vexa_asset_discovery as discovery
import cheng/tests/oracle_smoke_support as support

@borrows
fn smokeFail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

fn smokeExpect(cond: bool, message: str): int32 =
    if !cond:
        return smokeFail(message)
    return 0

fn smokePrintValidation(result: csg.CsgCoreValidationResult) =
    os.WriteLine(os.Get_stderr(), csg.CsgCoreValidationReportJson(result))
    for i in 0..<result.errors.len:
        os.WriteLine(os.Get_stderr(), result.errors[i])

fn smokeReporterPubKeys(): layout.FixedBytes65[] =
    var pubKeys: layout.FixedBytes65[]
    for reporterSlot in 1..<8:
        add(pubKeys, support.oracleSmokePubKey(reporterSlot))
    return pubKeys

fn smokeSignedBatchFromSource(source: hyper.HyperliquidMidSourceFact,
                              reporterSlot: int32): Result[oracle_plane.OracleSignedBatch] =
    let basePrices = support.oracleSmokePrices(source.roundId, reporterSlot)
    let pricesRes = hyper.HyperliquidApplyMidToCompletePrices(source, basePrices)
    if !pricesRes.ok:
        return Err[oracle_plane.OracleSignedBatch](pricesRes.err.msg)
    let observedAtMs = source.observedAtMs
    return oracle_plane.OracleSignedBatchMake(support.oracleSmokePrivateScalar(reporterSlot),
                                              1,
                                              reporterSlot,
                                              observedAtMs,
                                              pricesRes.value)

fn smokeSignedBatchesFromSource(source: hyper.HyperliquidMidSourceFact): Result[oracle_plane.OracleSignedBatch[]] =
    var batches: oracle_plane.OracleSignedBatch[]
    for reporterSlot in 1..<6:
        let batchRes = smokeSignedBatchFromSource(source, reporterSlot)
        if !batchRes.ok:
            return Err[oracle_plane.OracleSignedBatch[]](batchRes.err.msg)
        add(batches, batchRes.value)
    return Ok[oracle_plane.OracleSignedBatch[]](batches)

fn smokeLinesEqual(left: str[], right: str[]): bool =
    if left.len != right.len:
        return false
    for i in 0..<left.len:
        if left[i] != right[i]:
            return false
    return true

fn main(): int32 =
    let capturedAllMids = "{\"BTC\":\"104250.5\",\"ETH\":\"2525.15\",\"SOL\":\"149.321\"}"
    let observedAtMs = oracle_types.OracleRoundStartMs(int64(60)) + int64(1234)
    let sourceRes = hyper.HyperliquidAllMidsPriceFromResponse(capturedAllMids,
                                                              "BTC",
                                                              oracle_types.OracleAssetBtc,
                                                              oracle_types.OracleQuoteUsd,
                                                              observedAtMs)
    if smokeExpect(sourceRes.ok, "hyperliquid allMids source should parse BTC") != 0:
        os.WriteLine(os.Get_stderr(), sourceRes.err.msg)
        return 1
    let source = sourceRes.value
    if smokeExpect(source.priceE8 == int64(10425050000000),
                   "hyperliquid BTC priceE8 mismatch") != 0:
        return 1
    if smokeExpect(asset.AssetHashLooksValid(source.requestBodyHash),
                   "hyperliquid request hash invalid") != 0:
        return 1
    if smokeExpect(asset.AssetHashLooksValid(source.rawResponseHash),
                   "hyperliquid raw response hash invalid") != 0:
        return 1
    if smokeExpect(asset.AssetHashLooksValid(source.factRoot),
                   "hyperliquid source fact root invalid") != 0:
        return 1

    let badMissing = hyper.HyperliquidAllMidsPriceFromResponse("{\"ETH\":\"2525.15\"}",
                                                               "BTC",
                                                               oracle_types.OracleAssetBtc,
                                                               oracle_types.OracleQuoteUsd,
                                                               observedAtMs)
    if smokeExpect(!badMissing.ok, "missing BTC must fail") != 0:
        return 1
    let badPrecision = hyper.HyperliquidAllMidsPriceFromResponse("{\"BTC\":\"1.123456789\"}",
                                                                 "BTC",
                                                                 oracle_types.OracleAssetBtc,
                                                                 oracle_types.OracleQuoteUsd,
                                                                 observedAtMs)
    if smokeExpect(!badPrecision.ok, "more than 8 decimals must fail") != 0:
        return 1

    var shortPrices: int64[]
    add(shortPrices, int64(1))
    let shortVector = hyper.HyperliquidApplyMidToCompletePrices(source, shortPrices)
    if smokeExpect(!shortVector.ok, "incomplete price vector must fail") != 0:
        return 1

    let batchesRes = smokeSignedBatchesFromSource(source)
    if smokeExpect(batchesRes.ok, "hyperliquid source should produce signed oracle batches") != 0:
        os.WriteLine(os.Get_stderr(), batchesRes.err.msg)
        return 1
    let batches = batchesRes.value
    var firstBatch = batches[0]
    let firstPubKey = support.oracleSmokePubKey(1)
    let firstVerify = oracle_plane.OracleSignedBatchVerify(firstBatch, layout.FixedBytes65ToBytes(firstPubKey))
    if smokeExpect(firstVerify.ok, "signed Hyperliquid batch must verify") != 0:
        os.WriteLine(os.Get_stderr(), firstVerify.err.msg)
        return 1

    let committee = support.oracleSmokeCommittee()
    let observationRes = asset.OracleAssetObservationFromSignedPriceBatchesWithPubKeys(batches,
                                                                                       committee.committeeSetId,
                                                                                       committee.quorum,
                                                                                       smokeReporterPubKeys(),
                                                                                       oracle_types.OracleAssetBtc,
                                                                                       oracle_types.OracleQuoteUsd,
                                                                                       hyper.HyperliquidAllMidsSourceUri,
                                                                                       int64(120000))
    if smokeExpect(observationRes.ok, "signed Hyperliquid quorum should build observation") != 0:
        os.WriteLine(os.Get_stderr(), observationRes.err.msg)
        return 1
    let observation = observationRes.value
    if smokeExpect(observation.reporterCount == int32(5),
                   "Hyperliquid observation reporter count mismatch") != 0:
        return 1
    if smokeExpect(observation.subjectId == asset.OracleAssetPriceSubjectId(oracle_types.OracleAssetBtc,
                                                                            oracle_types.OracleQuoteUsd),
                   "Hyperliquid observation subject mismatch") != 0:
        return 1

    let candidateRes = asset.VexaAssetFromOracleObservation(observation,
                                                            observation.observedAtMs + int64(1))
    if smokeExpect(candidateRes.ok, "observed finance oracle asset should become Vexa asset") != 0:
        os.WriteLine(os.Get_stderr(), candidateRes.err.msg)
        return 1
    let candidate = candidateRes.value
    if smokeExpect(candidate.assetKind == asset.AssetKindFinance,
                   "Vexa Hyperliquid asset kind mismatch") != 0:
        return 1
    if smokeExpect(candidate.eligibleForPlan,
                   "observed finance asset should be eligible for plan") != 0:
        return 1

    var baseLines: str[]
    add(baseLines, "{\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\",\"features\":[\"core-facts\",\"oracle-asset\",\"external-source-proof\",\"vexa\"]}")
    add(baseLines, hyper.HyperliquidMidSourceFactJson(source))
    add(baseLines, asset.OracleAssetObservationFactJson(observation))
    add(baseLines, asset.VexaAssetCandidateFactJson(candidate))
    let factsRoot = asset.CsgAssetFactsRoot(baseLines)
    let planRes = asset.VexaCompileDeterministicPlan(candidate,
                                                     factsRoot,
                                                     "vexa.finance.observe_price",
                                                     asset.AssetSha256("hyperliquid BTC-USD observation preconditions"),
                                                     observation.observedAtMs + int64(10),
                                                     observation.observedAtMs + int64(90000))
    if smokeExpect(planRes.ok, "Hyperliquid Vexa finance plan should compile") != 0:
        os.WriteLine(os.Get_stderr(), planRes.err.msg)
        return 1
    let plan = planRes.value
    let receiptRes = asset.VexaCommitExecutionReceipt(plan,
                                                      "cheng_executor_vexa_finance",
                                                      asset.AssetSha256("hyperliquid source fact admitted"),
                                                      asset.AssetSha256("vexa finance asset cell state"),
                                                      observation.observedAtMs + int64(100),
                                                      "committed")
    if smokeExpect(receiptRes.ok, "Hyperliquid Vexa finance receipt should commit") != 0:
        os.WriteLine(os.Get_stderr(), receiptRes.err.msg)
        return 1
    let receipt = receiptRes.value
    let cellRes = asset.VexaBuildRecoverableCell(factsRoot,
                                                 plan,
                                                 receipt,
                                                 asset.AssetSha256("resume token for Hyperliquid finance cell"))
    if smokeExpect(cellRes.ok, "Hyperliquid Vexa finance Cell should build") != 0:
        os.WriteLine(os.Get_stderr(), cellRes.err.msg)
        return 1
    let cell = cellRes.value
    let lines = asset.CsgAssetFinanceClosedLoopFactsDebugLines(hyper.HyperliquidMidSourceFactJson(source),
                                                               observation,
                                                               candidate,
                                                               plan,
                                                               receipt,
                                                               cell)
    let validation = csg.CsgCoreValidateFactLines(lines, csg.CsgCoreModeStrict)
    if smokeExpect(validation.valid, "Hyperliquid finance CSG facts should validate") != 0:
        smokePrintValidation(validation)
        return 1
    if smokeExpect(validation.complete, "Hyperliquid finance CSG facts should be complete") != 0:
        smokePrintValidation(validation)
        return 1
    if smokeExpect(validation.factCount == int32(7), "Hyperliquid finance fact count mismatch") != 0:
        return 1
    let encoded = asset.CsgAssetEncodeCsgc(lines)
    if smokeExpect(encoded.ok, "Hyperliquid finance facts should encode as CSGC") != 0:
        os.WriteLine(os.Get_stderr(), encoded.error)
        return 1
    if smokeExpect(rawbytes.BytesLen(encoded.bytes) > 64, "Hyperliquid finance CSGC bytes empty") != 0:
        return 1
    let decoded = csgc.CsgCoreCsgcDecodeLines(encoded.bytes)
    if smokeExpect(decoded.ok, "Hyperliquid finance CSGC should decode") != 0:
        os.WriteLine(os.Get_stderr(), decoded.error)
        return 1
    if smokeExpect(smokeLinesEqual(lines, decoded.lines),
                   "Hyperliquid finance decoded CSGC lines mismatch") != 0:
        return 1
    if smokeExpect(asset.CsgAssetFactsRoot(decoded.lines) == asset.CsgAssetFactsRoot(lines),
                   "Hyperliquid finance decoded CSGC root mismatch") != 0:
        return 1

    let admittedRes = discovery.VexaAdmitClosedLoopAssetFromCsgc(encoded.bytes)
    if smokeExpect(admittedRes.ok, "Vexa should admit Hyperliquid finance CSGC") != 0:
        os.WriteLine(os.Get_stderr(), admittedRes.err.msg)
        return 1
    if smokeExpect(admittedRes.value.assetKind == asset.AssetKindFinance,
                   "admitted Hyperliquid asset kind mismatch") != 0:
        return 1

    var malformedLines = lines
    malformedLines[1] = "{\"kind\":\"csg_dialect::oracle_asset::hyperliquid_mid_source\",\"id\":\"missing_fact_root\",\"sourceKind\":\"hyperliquid_all_mids\",\"sourceUri\":\"https://api.hyperliquid.xyz/info\",\"requestBodyHash\":\"sha256:abc\",\"rawResponseHash\":\"sha256:def\",\"coin\":\"BTC\",\"assetId\":1,\"quoteId\":1,\"pairId\":1,\"priceE8\":10425050000000,\"observedAtMs\":3601234,\"roundId\":60}"
    let malformedValidation = csg.CsgCoreValidateFactLines(malformedLines, csg.CsgCoreModeStrict)
    if smokeExpect(!malformedValidation.valid,
                   "missing Hyperliquid source factRoot must fail validation") != 0:
        return 1

    os.WriteLine(os.Get_stdout(), "vexa_hyperliquid_oracle_csgc_smoke ok")
    return 0
