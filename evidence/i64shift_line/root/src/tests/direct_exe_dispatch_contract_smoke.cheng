import std/os
import std/strings
import cheng/core/tooling/path as chengpath

fn main(): int32 =
    let root = os.GetCurrentDir()
    let dispatchPath = chengpath.PathJoin(root, "src/core/tooling/backend_driver_dispatch_min.cheng")
    let dispatchText = chengpath.ReadTextFile("", dispatchPath)
    let runtimePath = chengpath.PathJoin(root, "src/core/backend/system_link_exec_runtime.cheng")
    let runtimeText = chengpath.ReadTextFile("", runtimePath)
    assert(strings.StrContains(
               dispatchText,
               "sexec.BuildSystemLinkExecPlanWithWorldAndChannelInto(") &&
           strings.StrContains(
               dispatchText,
               "sexec_runtime.SystemLinkExecRuntimeExecutePlanWithCompilerInto("),
           "direct_exe_dispatch_contract_smoke: dispatch uses the unique formal plan/runtime path")
    assert(!strings.StrContains(dispatchText, "DirectObjectEmitStandaloneExecutable(") &&
           !strings.StrContains(dispatchText, "BackendDriverDispatchMinRunSystemLinkExecEmitExe"),
           "direct_exe_dispatch_contract_smoke: dispatch owns no direct emitter or provider route")
    assert(strings.StrContains(
               runtimeText,
               "fn SystemLinkExecRuntimeCanUseStandaloneMain(") &&
           strings.StrContains(
               runtimeText,
               "if plan.systemLinkPlan.providerModules.len > 0:\n        return false") &&
           strings.StrContains(
               runtimeText,
               "if plan.objectPlan.providerSourcePaths.len > 0:\n        return false") &&
           strings.StrContains(
               runtimeText,
               "if plan.objectPlan.providerObjectPaths.len > 0:\n        return false"),
           "direct_exe_dispatch_contract_smoke: standalone admission rejects every provider partition")
    assert(strings.StrContains(
               runtimeText,
               "let directRes: Result[direct.DirectObjectEmitResult] = direct.DirectObjectEmitStandaloneMain(ownedRoot, plan)") &&
           strings.StrContains(
               runtimeText,
               "if standaloneMain:\n        SystemLinkExecRuntimeProgressEmit(rootDir, \"line_map\", \"begin\")"),
           "direct_exe_dispatch_contract_smoke: formal runtime owns standalone executable emission")
    assert(strings.StrContains(
               runtimeText,
               "if !objectOnly && !standaloneMain && !providerFreePrimaryNativeLink && providerSourceCount > 0:") &&
           strings.StrContains(
               runtimeText,
               "let providerRes = SystemLinkExecRuntimeMaterializeProviderObjects(rootDir, out.providerCompilerPath, plan, out)") &&
           strings.StrContains(
               runtimeText,
               "let nativeOk = SystemLinkExecRuntimeRunNativeLinkInto(rootDir, plan, nativePlan, out, nativeErr)"),
           "direct_exe_dispatch_contract_smoke: provider executable route is runtime-owned and linked")
    assert(strings.StrContains(runtimeText, "\"system_link_exec_emit\", \"exe\"") &&
           strings.StrContains(runtimeText, "\"system_link_exec_runtime_standalone_no_runtime\"") &&
           strings.StrContains(runtimeText, "\"primary_object_direct\"") &&
           strings.StrContains(runtimeText, "\"provider_object_count\"") &&
           strings.StrContains(runtimeText, "\"native_link_log\""),
           "direct_exe_dispatch_contract_smoke: runtime emits formal executable/provider receipts")
    echo("direct_exe_dispatch_contract_smoke ok")
    return 0
