import cheng/core/csg_core/csgc_historical_authority

fn main(): int32 =
    let authority =
        csgc_historical_authority.
            CsgCoreCsgcHistoricalAuthorityIssue()
    if csgc_historical_authority.CsgCoreCsgcHistoricalAuthorityIsValid(
           authority):
        return 0
    let error =
        csgc_historical_authority.
            CsgCoreCsgcHistoricalAuthorityError(authority)
    if error.len > 0:
        return 1
    return 2
