import std/system
import std/strings
import std/strutils as strutil

// Try to trigger the SIGSEGV that happens when self-compiled compiler runs
// Crash is in a string processing function: ldrb at x1+x3 where x1=sp (wrong!)

fn trimLeftManual(s: str): str =
    // Manually trim leading spaces - mimics the crash pattern
    var i: int32
    let data = s
    let n: int32 = len(s)
    while i < n:
        let ch: int32 = int32(s[i])
        if ch > 32: break
        i = i + 1
    return strutil.Substring(s, i, -1)

fn main(): int32 =
    let s1: str = "   hello"
    let s2: str = ""
    let s3: str = "world"

    let t1: str = trimLeftManual(s1)
    assert(t1 == "hello", " trim: spaces")

    let t2: str = trimLeftManual(s2)
    assert(t2 == "", " trim: empty")

    let t3: str = trimLeftManual(s3)
    assert(t3 == "world", " trim: no spaces")

    let joined: str = strutil.Join([s1, s2, s3], ",")
    assert(len(joined) > 0, " join: non-empty")

    // Test strings.Contains which might trigger the crash path
    assert(strings.StrContains("hello world", "world") == true, " contains: found")
    assert(strings.StrContains("hello", "x") == false, " contains: not found")

    echo(" cold_smoke_selfhost_crash ok")
    return 0
