import std/cmdline
import cheng/std/bytes_layout as layout
import cheng/core/runtime/arena as arenamod
import cheng/core/backend/provider_export_identity_receipt as peir
import cheng/core/backend/provider_export_identity_import as pei

fn smokeCid(seed: int32): layout.FixedBytes32 =
    var out: layout.FixedBytes32
    for index in 0..<32:
        out.data[index] = uint8((seed + index * 23) & 255)
    return out

fn smokeBuildSource(): peir.ProviderExportIdentityReceipt =
    var source = peir.ProviderExportIdentityReceiptInit(256)
    let provider0 = peir.ProviderExportIdentityReceiptAppendProvider(
        source, smokeCid(1), smokeCid(2), smokeCid(3))
    assert(provider0 == 0, " provider import smoke: provider0")
    assert(peir.ProviderExportIdentityReceiptAppendExport(
        source, provider0, 7, 11, 13, 17, smokeCid(4), smokeCid(5),
        peir.ProviderExportContractRoleSetCmdLine,
        "__cheng_setCmdLine") == 0,
        " provider import smoke: role1")
    assert(peir.ProviderExportIdentityReceiptAppendExport(
        source, provider0, 8, 19, 23, 29, smokeCid(6), smokeCid(7),
        peir.ProviderExportContractRoleRegisterLineMap,
        "任意行映射") == 1,
        " provider import smoke: role2")
    let provider1 = peir.ProviderExportIdentityReceiptAppendProvider(
        source, smokeCid(8), smokeCid(9), smokeCid(10))
    assert(provider1 == 1, " provider import smoke: provider1")
    assert(peir.ProviderExportIdentityReceiptAppendExport(
        source, provider1, 3, 31, 37, 41, smokeCid(11), smokeCid(12),
        peir.ProviderExportContractRoleProfileFlush,
        "ß_配置写出") == 2,
        " provider import smoke: role3")
    var err: str
    assert(peir.ProviderExportIdentityReceiptSealInto(source, err), err)
    return source

fn smokeBuildActuals(): pei.ProviderExportIdentityActualSet =
    var actuals = pei.ProviderExportIdentityActualSetInit(128)
    assert(pei.ProviderExportIdentityActualSetAppend(
        actuals, 1, smokeCid(8), smokeCid(9), smokeCid(10)) == 0,
        " provider import smoke: actual provider1")
    assert(pei.ProviderExportIdentityActualSetAppend(
        actuals, 0, smokeCid(1), smokeCid(2), smokeCid(3)) == 1,
        " provider import smoke: actual provider0")
    var err: str
    assert(pei.ProviderExportIdentityActualSetSealInto(actuals, err), err)
    return actuals

fn smokeBuildImport(): pei.ProviderExportIdentityImportReceipt =
    var source = smokeBuildSource()
    var actuals = smokeBuildActuals()
    var imported: pei.ProviderExportIdentityImportReceipt
    var err: str
    assert(pei.ProviderExportIdentityImportBuildInto(
               source, actuals, imported, err), err)
    assert(pei.ProviderExportIdentityImportStrictValidateInto(imported, err),
           err)
    peir.ProviderExportIdentityReceiptRelease(source)
    pei.ProviderExportIdentityActualSetRelease(actuals)
    return imported

@borrows
fn smokeExpectBuildRejected(
        source: peir.ProviderExportIdentityReceipt,
        actuals: pei.ProviderExportIdentityActualSet,
        expected: str) =
    var imported: pei.ProviderExportIdentityImportReceipt
    var err: str
    assert(!pei.ProviderExportIdentityImportBuildInto(
               source, actuals, imported, err),
           " provider import smoke: invalid join accepted")
    assert(err == expected,
           Fmt" provider import smoke: wrong join error: {err}")
    assert(pei.ProviderExportIdentityImportStorageReleased(imported),
           " provider import smoke: failed join retained output")

@borrows
fn smokeExpectImportInvalid(
        imported: pei.ProviderExportIdentityImportReceipt,
        expected: str) =
    var err: str
    assert(!pei.ProviderExportIdentityImportStrictValidateInto(imported, err),
           " provider import smoke: invalid projection accepted")
    assert(err == expected,
           Fmt" provider import smoke: wrong projection error: {err}")

fn smokeBuildMismatchActuals(
        mismatchKind: int32): pei.ProviderExportIdentityActualSet =
    var actuals = pei.ProviderExportIdentityActualSetInit(128)
    var artifact0 = smokeCid(1)
    var compile0 = smokeCid(2)
    var object0 = smokeCid(3)
    if mismatchKind == 1:
        artifact0 = smokeCid(101)
    elif mismatchKind == 2:
        compile0 = smokeCid(102)
    elif mismatchKind == 3:
        object0 = smokeCid(103)
    assert(pei.ProviderExportIdentityActualSetAppend(
        actuals, 0, artifact0, compile0, object0) == 0,
        " provider import smoke: mismatch provider0")
    assert(pei.ProviderExportIdentityActualSetAppend(
        actuals, 1, smokeCid(8), smokeCid(9), smokeCid(10)) == 1,
        " provider import smoke: mismatch provider1")
    var err: str
    assert(pei.ProviderExportIdentityActualSetSealInto(actuals, err), err)
    return actuals

fn smokeBuildRowsActuals(
        firstProviderRow: int32,
        secondProviderRow: int32,
        includeSecond: bool): pei.ProviderExportIdentityActualSet =
    var actuals = pei.ProviderExportIdentityActualSetInit(128)
    assert(pei.ProviderExportIdentityActualSetAppend(
        actuals, firstProviderRow,
        smokeCid(1), smokeCid(2), smokeCid(3)) == 0,
        " provider import smoke: row actual0")
    if includeSecond:
        assert(pei.ProviderExportIdentityActualSetAppend(
            actuals, secondProviderRow,
            smokeCid(8), smokeCid(9), smokeCid(10)) == 1,
            " provider import smoke: row actual1")
    var err: str
    assert(pei.ProviderExportIdentityActualSetSealInto(actuals, err), err)
    return actuals

fn smokeJoinNegatives(mutations: var int32) =
    var source = smokeBuildSource()

    for mismatchKind in 1..3:
        var actuals = smokeBuildMismatchActuals(mismatchKind)
        if mismatchKind == 1:
            smokeExpectBuildRejected(
                source, actuals,
                " provider export identity import: artifact cid mismatch")
        elif mismatchKind == 2:
            smokeExpectBuildRejected(
                source, actuals,
                " provider export identity import: compile cid mismatch")
        else:
            smokeExpectBuildRejected(
                source, actuals,
                " provider export identity import: object cid mismatch")
        mutations = mutations + 1
        pei.ProviderExportIdentityActualSetRelease(actuals)

    var duplicate = smokeBuildRowsActuals(0, 0, true)
    smokeExpectBuildRejected(
        source, duplicate,
        " provider export identity import: duplicate provider")
    mutations = mutations + 1
    pei.ProviderExportIdentityActualSetRelease(duplicate)

    var missing = smokeBuildRowsActuals(0, 1, false)
    smokeExpectBuildRejected(
        source, missing,
        " provider export identity import: missing provider")
    mutations = mutations + 1
    pei.ProviderExportIdentityActualSetRelease(missing)

    var wrongRow = smokeBuildRowsActuals(0, 2, true)
    smokeExpectBuildRejected(
        source, wrongRow,
        " provider export identity import: actual provider row invalid")
    mutations = mutations + 1
    pei.ProviderExportIdentityActualSetRelease(wrongRow)
    peir.ProviderExportIdentityReceiptRelease(source)

fn smokeBuildIncompleteSource(
        duplicateRole: bool): peir.ProviderExportIdentityReceipt =
    var source = peir.ProviderExportIdentityReceiptInit(256)
    let provider0 = peir.ProviderExportIdentityReceiptAppendProvider(
        source, smokeCid(1), smokeCid(2), smokeCid(3))
    assert(peir.ProviderExportIdentityReceiptAppendExport(
        source, provider0, 1, 2, 3, 4, smokeCid(4), smokeCid(5),
        peir.ProviderExportContractRoleSetCmdLine, "role1") == 0,
        " provider import smoke: incomplete role1")
    assert(peir.ProviderExportIdentityReceiptAppendExport(
        source, provider0, 5, 6, 7, 8, smokeCid(6), smokeCid(7),
        peir.ProviderExportContractRoleRegisterLineMap, "role2") == 1,
        " provider import smoke: incomplete role2")
    if duplicateRole:
        let provider1 = peir.ProviderExportIdentityReceiptAppendProvider(
            source, smokeCid(8), smokeCid(9), smokeCid(10))
        assert(peir.ProviderExportIdentityReceiptAppendExport(
            source, provider1, 9, 10, 11, 12, smokeCid(11), smokeCid(12),
            peir.ProviderExportContractRoleSetCmdLine, "role1-again") == 2,
            " provider import smoke: duplicate global role")
    var err: str
    assert(peir.ProviderExportIdentityReceiptSealInto(source, err), err)
    return source

fn smokeRoleNegatives(mutations: var int32) =
    var missingSource = smokeBuildIncompleteSource(false)
    var oneActual = pei.ProviderExportIdentityActualSetInit(128)
    assert(pei.ProviderExportIdentityActualSetAppend(
        oneActual, 0, smokeCid(1), smokeCid(2), smokeCid(3)) == 0,
        " provider import smoke: missing role actual")
    var err: str
    assert(pei.ProviderExportIdentityActualSetSealInto(oneActual, err), err)
    smokeExpectBuildRejected(
        missingSource, oneActual,
        " provider export identity import: missing contract role")
    mutations = mutations + 1
    peir.ProviderExportIdentityReceiptRelease(missingSource)
    pei.ProviderExportIdentityActualSetRelease(oneActual)

    var duplicateSource = smokeBuildIncompleteSource(true)
    var duplicateActual = smokeBuildActuals()
    smokeExpectBuildRejected(
        duplicateSource, duplicateActual,
        " provider export identity import: duplicate contract role")
    mutations = mutations + 1
    peir.ProviderExportIdentityReceiptRelease(duplicateSource)
    pei.ProviderExportIdentityActualSetRelease(duplicateActual)

    var invalidSource = smokeBuildSource()
    arenamod.ArenaArrayInt32Set(
        invalidSource.arena, invalidSource.exportContractRoleKinds, 0,
        peir.ProviderExportContractRoleMax + 1)
    invalidSource.receiptCid =
        peir.ProviderExportIdentityReceiptComputeCid(invalidSource)
    var actuals = smokeBuildActuals()
    smokeExpectBuildRejected(
        invalidSource, actuals,
        " provider export identity receipt: contract role invalid")
    mutations = mutations + 1
    peir.ProviderExportIdentityReceiptRelease(invalidSource)
    pei.ProviderExportIdentityActualSetRelease(actuals)

fn smokeProjectionNegatives(mutations: var int32) =
    var role = smokeBuildImport()
    arenamod.ArenaArrayInt32Set(role.arena, role.roleKinds, 0, 2)
    smokeExpectImportInvalid(
        role, " provider export identity import: role row invalid")
    mutations = mutations + 1
    pei.ProviderExportIdentityImportRelease(role)

    var providerRow = smokeBuildImport()
    arenamod.ArenaArrayInt32Set(
        providerRow.arena, providerRow.providerRows, 0, 1)
    smokeExpectImportInvalid(
        providerRow, " provider export identity import: provider row invalid")
    mutations = mutations + 1
    pei.ProviderExportIdentityImportRelease(providerRow)

    var exportRow = smokeBuildImport()
    arenamod.ArenaArrayInt32Set(
        exportRow.arena, exportRow.roleExportRows, 0,
        exportRow.sourceExportCount)
    smokeExpectImportInvalid(
        exportRow, " provider export identity import: role row invalid")
    mutations = mutations + 1
    pei.ProviderExportIdentityImportRelease(exportRow)

    var providerCsr = smokeBuildImport()
    arenamod.ArenaArrayInt32Set(
        providerCsr.arena, providerCsr.providerExportStarts, 1, 0)
    smokeExpectImportInvalid(
        providerCsr, " provider export identity import: provider row invalid")
    mutations = mutations + 1
    pei.ProviderExportIdentityImportRelease(providerCsr)

    var roleProvider = smokeBuildImport()
    arenamod.ArenaArrayInt32Set(
        roleProvider.arena, roleProvider.roleProviderRows, 2, 0)
    smokeExpectImportInvalid(
        roleProvider,
        " provider export identity import: role provider join invalid")
    mutations = mutations + 1
    pei.ProviderExportIdentityImportRelease(roleProvider)

    var duplicateExport = smokeBuildImport()
    arenamod.ArenaArrayInt32Set(
        duplicateExport.arena, duplicateExport.roleExportRows, 1, 0)
    smokeExpectImportInvalid(
        duplicateExport,
        " provider export identity import: duplicate export row")
    mutations = mutations + 1
    pei.ProviderExportIdentityImportRelease(duplicateExport)

    var roleCid = smokeBuildImport()
    roleCid.roleProducerFactCids[0] = layout.FixedBytes32()
    smokeExpectImportInvalid(
        roleCid, " provider export identity import: role cid invalid")
    mutations = mutations + 1
    pei.ProviderExportIdentityImportRelease(roleCid)

    var sourceCid = smokeBuildImport()
    sourceCid.sourceActualSetCid = layout.FixedBytes32()
    smokeExpectImportInvalid(
        sourceCid, " provider export identity import: source cid invalid")
    mutations = mutations + 1
    pei.ProviderExportIdentityImportRelease(sourceCid)

    var receiptCid = smokeBuildImport()
    receiptCid.receiptCid.data[0] =
        uint8(int32(receiptCid.receiptCid.data[0]) ^ 1)
    smokeExpectImportInvalid(
        receiptCid, " provider export identity import: receipt cid mismatch")
    mutations = mutations + 1
    pei.ProviderExportIdentityImportRelease(receiptCid)

fn smokeMoveReleaseNegatives(mutations: var int32) =
    var source = smokeBuildImport()
    var moved: pei.ProviderExportIdentityImportReceipt
    var err: str
    assert(pei.ProviderExportIdentityImportMoveInto(moved, source, err), err)
    assert(pei.ProviderExportIdentityImportStorageReleased(source),
           " provider import smoke: moved source retained storage")
    var second: pei.ProviderExportIdentityImportReceipt
    assert(!pei.ProviderExportIdentityImportMoveInto(second, source, err),
           " provider import smoke: moved source accepted")
    mutations = mutations + 1
    pei.ProviderExportIdentityImportRelease(moved)

    var ownedSource = smokeBuildImport()
    var ownedOutput = smokeBuildImport()
    assert(!pei.ProviderExportIdentityImportMoveInto(
               ownedOutput, ownedSource, err),
           " provider import smoke: owned output accepted")
    assert(err == " provider export identity import: move output owns storage",
           " provider import smoke: wrong owned output error")
    mutations = mutations + 1
    pei.ProviderExportIdentityImportRelease(ownedSource)
    pei.ProviderExportIdentityImportRelease(ownedOutput)

    var releasedImport = smokeBuildImport()
    let retainedBuffers =
        pei.ProviderExportIdentityImportRetainedBufferCount(releasedImport)
    let retainedBytes =
        pei.ProviderExportIdentityImportRetainedBytes(releasedImport)
    var released: pei.ProviderExportIdentityImportReleaseReceipt
    assert(pei.ProviderExportIdentityImportReleaseWithReceipt(
               releasedImport, released),
           " provider import smoke: release failed")
    assert(released.releasedOwnedStorageColumnCount == 6 &&
           released.releasedBufferCount == retainedBuffers &&
           released.releasedBytes == retainedBytes &&
           pei.ProviderExportIdentityImportStorageReleased(releasedImport),
           " provider import smoke: release ledger mismatch")
    assert(pei.ProviderExportIdentityImportConsumeReleaseReceipt(
               releasedImport, released),
           " provider import smoke: release receipt rejected")
    assert(!pei.ProviderExportIdentityImportConsumeReleaseReceipt(
               releasedImport, released),
           " provider import smoke: release receipt consumed twice")
    mutations = mutations + 1

    var rebuildSource = smokeBuildSource()
    var rebuildActuals = smokeBuildActuals()
    assert(!pei.ProviderExportIdentityImportBuildInto(
               rebuildSource, rebuildActuals, releasedImport, err),
           " provider import smoke: released output reopened")
    assert(err == " provider export identity import: output owns storage",
           " provider import smoke: wrong released output error")
    mutations = mutations + 1
    peir.ProviderExportIdentityReceiptRelease(rebuildSource)
    pei.ProviderExportIdentityActualSetRelease(rebuildActuals)

fn smokeCrashMode(): bool =
    if cmdline.ParamCount() != 2:
        return false
    let mode = cmdline.ParamStr(1)
    if mode == "double-release":
        var imported = smokeBuildImport()
        pei.ProviderExportIdentityImportRelease(imported)
        pei.ProviderExportIdentityImportRelease(imported)
        return true
    assert(mode == "moved-source", " provider import smoke: unknown mode")
    var source = smokeBuildImport()
    var moved: pei.ProviderExportIdentityImportReceipt
    var err: str
    assert(pei.ProviderExportIdentityImportMoveInto(moved, source, err), err)
    pei.ProviderExportIdentityImportRelease(source)
    return true

fn main() =
    if smokeCrashMode():
        return
    var mutations: int32
    smokeJoinNegatives(mutations)
    smokeRoleNegatives(mutations)
    smokeProjectionNegatives(mutations)
    smokeMoveReleaseNegatives(mutations)

    var imported = smokeBuildImport()
    var err: str
    assert(pei.ProviderExportIdentityImportStrictValidateInto(imported, err),
           err)
    assert(pei.ProviderExportIdentityImportRoleExportRow(
               imported,
               peir.ProviderExportContractRoleSetCmdLine) == 0 &&
           pei.ProviderExportIdentityImportRoleExportRow(
               imported,
               peir.ProviderExportContractRoleRegisterLineMap) == 1 &&
           pei.ProviderExportIdentityImportRoleExportRow(
               imported,
               peir.ProviderExportContractRoleProfileFlush) == 2,
           " provider import smoke: role projection mismatch")
    let retainedBuffers =
        pei.ProviderExportIdentityImportRetainedBufferCount(imported)
    let retainedBytes = pei.ProviderExportIdentityImportRetainedBytes(imported)
    echo(Fmt"provider_export_identity_import_ok providers={imported.providerSourceArtifactCids.len} roles={imported.roleProducerFactCids.len} mutations={mutations} receipt_cid={layout.FixedBytes32Hex(imported.receiptCid)} retained_buffers={retainedBuffers} retained_bytes={retainedBytes}")
    pei.ProviderExportIdentityImportRelease(imported)
