type R5Task = object
    modulePath: str

fn R5CtlLen(tasks: R5Task[]): int32 =
    return tasks.len

fn main(): int32 =
    var made: R5Task[]
    var t: R5Task
    t.modulePath = "abc"
    add(made, t)
    let got = R5CtlLen(made)
    if got != 1:
        return 10
    echo(Fmt"r5_ctl_arr_callarg ok {got}")
    return 0
