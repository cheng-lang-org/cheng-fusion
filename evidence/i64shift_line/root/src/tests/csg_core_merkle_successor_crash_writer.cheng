import std/os as os
import std/rawbytes
import std/cmdline
import std/strings
import cheng/core/csg_core/merkle_artifacts
import cheng/core/csg_core/merkle_builder
import cheng/core/csg_core/merkle_dag
import cheng/core/csg_core/merkle_store
import cheng/core/csg_core/merkle_store_codec
import cheng/core/csg_core/merkle_store_pipeline
import cheng/core/csg_core/merkle_transaction
import cheng/core/csg_core/merkle_transaction_authority as authority

const
    Standard: str = "csg_core::v1"
    BaseProfile: str = "csg_core"
    StoreName: str = "store"
    SourceA: str = "source:transaction-app"
    SourceB: str = "source:transaction-provider"
    SourceC: str = "source:transaction-top"
    SourceD: str = "source:transaction-idle"
    SourceAText: str = "module app\nfn app() = provider()\n"
    SourceBTextV1: str = "module provider\nfn provider() = 1\n"
    SourceBTextV2: str = "module provider\nfn provider() = 2\n"
    SourceCText: str = "module top\nfn top() = app()\n"
    SourceDText: str = "module idle\nfn idle() = 0\n"
    SchemaFact: str = "{\"features\":[\"core-facts\"],\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}"
    AppFact: str = "{\"file\":\"pkg://cheng/transaction/app.cheng\",\"id\":\"symbol:transaction-app\",\"kind\":\"csg.symbol\",\"name\":\"app\",\"symbol\":\"app\",\"symbolKind\":\"fn\"}"
    ProviderFactV1: str = "{\"file\":\"pkg://cheng/transaction/provider.cheng\",\"id\":\"symbol:transaction-provider\",\"kind\":\"csg.symbol\",\"name\":\"provider\",\"symbol\":\"provider\",\"symbolKind\":\"fn\"}"
    ProviderFactV2: str = "{\"file\":\"pkg://cheng/transaction/provider.cheng\",\"id\":\"symbol:transaction-provider\",\"kind\":\"csg.symbol\",\"name\":\"provider-v2\",\"symbol\":\"provider\",\"symbolKind\":\"fn\"}"
    TopFact: str = "{\"file\":\"pkg://cheng/transaction/top.cheng\",\"id\":\"symbol:transaction-top\",\"kind\":\"csg.symbol\",\"name\":\"top\",\"symbol\":\"top\",\"symbolKind\":\"fn\"}"
    IdleFact: str = "{\"file\":\"pkg://cheng/transaction/idle.cheng\",\"id\":\"symbol:transaction-idle\",\"kind\":\"csg.symbol\",\"name\":\"idle\",\"symbol\":\"idle\",\"symbolKind\":\"fn\"}"

fn fail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

@borrows
fn cat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

@borrows
fn sourceCid(text: str): str =
    var bytes = rawbytes.BytesAlloc(text.len)
    for i in 0..<text.len:
        rawbytes.BytesSet(bytes, i, int32(text[i]) & 255)
    let out =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            "csg_core.external.source", bytes)
    rawbytes.BytesFree(bytes)
    return out

@borrows
fn source(
        sourceId: str,
        sourceCidValue: str,
        facts: str[]):
        merkle_builder.CsgCoreMerkleBuilderSource =
    var out: merkle_builder.CsgCoreMerkleBuilderSource
    out.sourceId = strings.CloneStr(sourceId)
    out.sourceCid = strings.CloneStr(sourceCidValue)
    for i in 0..<facts.len:
        add(out.facts, strings.CloneStr(facts[i]))
    return out

@borrows
fn replacementDependency(
        providerSource: str,
        providerFactKind: str,
        selector: str):
        merkle_transaction.CsgCoreMerkleTransactionDependency =
    var out: merkle_transaction.CsgCoreMerkleTransactionDependency
    out.providerSource = strings.CloneStr(providerSource)
    out.providerFactKind = strings.CloneStr(providerFactKind)
    out.selector = strings.CloneStr(selector)
    return out

@borrows
fn dependency(
        consumerSource: str,
        providerSource: str,
        selector: str,
        providerSubgraphCid: str):
        merkle_artifacts.CsgCoreMerkleDependencyRecord =
    var out: merkle_artifacts.CsgCoreMerkleDependencyRecord
    out.consumerSource = strings.CloneStr(consumerSource)
    out.providerSource = strings.CloneStr(providerSource)
    out.selector = strings.CloneStr(selector)
    out.providerSubgraphCid = strings.CloneStr(providerSubgraphCid)
    return out

@borrows
fn subgraphCid(fact: str): str =
    let dag = merkle_dag.CsgCoreMerkleBuild([strings.CloneStr(fact)])
    if !dag.ok:
        return ""
    return strings.CloneStr(dag.subgraphCid)

@borrows
fn replacement(
        sourceId: str,
        sourceCidValue: str,
        facts: str[],
        dependencies:
            merkle_transaction.CsgCoreMerkleTransactionDependency[]):
        merkle_transaction.CsgCoreMerkleTransactionReplacement =
    var out: merkle_transaction.CsgCoreMerkleTransactionReplacement
    out.sourceId = strings.CloneStr(sourceId)
    out.sourceCid = strings.CloneStr(sourceCidValue)
    for i in 0..<facts.len:
        add(out.facts, strings.CloneStr(facts[i]))
    for i in 0..<dependencies.len:
        var dependencyCopy: merkle_transaction.CsgCoreMerkleTransactionDependency
        dependencyCopy.providerSource =
            strings.CloneStr(dependencies[i].providerSource)
        dependencyCopy.providerFactKind =
            strings.CloneStr(dependencies[i].providerFactKind)
        dependencyCopy.selector = strings.CloneStr(dependencies[i].selector)
        add(out.dependencies, dependencyCopy)
    return out

fn buildInitial(): merkle_builder.CsgCoreMerkleBuilderResult =
    let sourceA =
        source(
            SourceA,
            sourceCid(SourceAText),
            [strings.CloneStr(SchemaFact), strings.CloneStr(AppFact)])
    let sourceB =
        source(
            SourceB,
            sourceCid(SourceBTextV1),
            [strings.CloneStr(ProviderFactV1)])
    let sourceC =
        source(
            SourceC,
            sourceCid(SourceCText),
            [strings.CloneStr(TopFact)])
    let sourceD =
        source(
            SourceD,
            sourceCid(SourceDText),
            [strings.CloneStr(IdleFact)])
    let appDependsOnProvider =
        dependency(
            SourceA,
            SourceB,
            "symbol:transaction-provider",
            subgraphCid(ProviderFactV1))
    let topDependsOnApp =
        dependency(
            SourceC,
            SourceA,
            "symbol:transaction-app",
            subgraphCid(AppFact))
    return merkle_builder.CsgCoreMerkleBuildClosure(
        Standard,
        [strings.CloneStr(BaseProfile)],
        [sourceD, sourceB, sourceA, sourceC],
        [topDependsOnApp, appDependsOnProvider])

fn replacementsV2():
        merkle_transaction.CsgCoreMerkleTransactionReplacement[] =
    let appDependsOnProvider =
        replacementDependency(
            SourceB,
            "csg.symbol",
            "symbol:transaction-provider")
    let topDependsOnApp =
        replacementDependency(
            SourceA,
            "csg.symbol",
            "symbol:transaction-app")
    let replaceA =
        replacement(
            SourceA,
            sourceCid(SourceAText),
            [strings.CloneStr(SchemaFact), strings.CloneStr(AppFact)],
            [appDependsOnProvider])
    let replaceB =
        replacement(
            SourceB,
            sourceCid(SourceBTextV2),
            [strings.CloneStr(ProviderFactV2)],
            [])
    let replaceC =
        replacement(
            SourceC,
            sourceCid(SourceCText),
            [strings.CloneStr(TopFact)],
            [topDependsOnApp])
    return [replaceC, replaceA, replaceB]

fn runInit(parentPath: str): int32 =
    var initial = buildInitial()
    if !initial.ok || !initial.admission.ok:
        let message = cat("writer init closure failed: ", initial.error)
        merkle_builder.CsgCoreMerkleBuilderFree(initial)
        return fail(message)
    let bootstrap =
        merkle_store_pipeline.CsgCoreMerkleStoreBootstrap(
            parentPath,
            StoreName,
            initial)
    merkle_builder.CsgCoreMerkleBuilderFree(initial)
    if !bootstrap.ok || !bootstrap.published || bootstrap.reused:
        return fail(
            cat(
                "writer init publish failed: ",
                bootstrap.error.len > 0 ?
                    bootstrap.error :
                    "store unexpectedly existed"))
    os.WriteLine(
        os.Get_stdout(),
        cat("writer_init ok head=", bootstrap.head.headCid))
    return 0

@borrows
fn failResult(error: str):
        merkle_transaction.CsgCoreMerkleTransactionResult =
    var out: merkle_transaction.CsgCoreMerkleTransactionResult
    out.error = strings.CloneStr(error)
    return out

fn applySuccessor(
        planned:
            merkle_transaction.CsgCoreMerkleTransactionResult):
        merkle_transaction.CsgCoreMerkleTransactionResult =
    var consumed = planned
    if !consumed.ok || !consumed.planReady:
        return failResult("writer successor plan invalid")
    if consumed.productionApplied:
        return consumed
    if !authority.CsgCoreMerklePreparedTransactionIsValid(
           consumed.prepared):
        return failResult("writer successor prepared capability invalid")
    var prepared = consumed.prepared
    consumed.prepared = authority.CsgCoreMerklePreparedTransaction()
    var prepublished =
        authority.CsgCoreMerkleTransactionPrepublishVerifyInMemory(prepared)
    if !prepublished.ok:
        return failResult(prepublished.error)
    var session = prepublished.session
    prepublished.session = authority.CsgCoreMerklePrepublishSession()
    var complete: bool
    var finalArtifactCount: int32
    var finalObjectWriteCount: int32
    while !complete:
        let committed =
            authority.CsgCoreMerkleTransactionStoreNextArtifact(session)
        if !committed.ok:
            return failResult(committed.error)
        complete = committed.complete
        finalArtifactCount = committed.artifactCount
        finalObjectWriteCount = committed.objectWriteCount
    if finalArtifactCount <= 0 || finalObjectWriteCount < 0 ||
       finalObjectWriteCount > finalArtifactCount:
        let terminalError =
            authority.CsgCoreMerklePrepublishSessionPoison(session)
        if terminalError.len > 0:
            panic("crash writer: completed session cleanup failed")
        return failResult("writer successor artifact completion invalid")
    os.WriteLine(
        os.Get_stdout(),
        cat("EXPECT manifest=", prepublished.finalManifestCid))
    if os.C_fflush(os.Get_stdout()) != 0:
        return failResult("writer successor expect flush failed")
    let published =
        merkle_store.CsgCoreMerkleStoreCommitPreparedSession(session)
    if !published.ok ||
       published.finalManifestCid != prepublished.finalManifestCid ||
       published.transactionReceiptCid !=
           prepublished.transactionReceiptCid:
        if !published.ok:
            return failResult(published.error)
        panic("crash writer: committed head receipt drift")
    consumed.ok = true
    consumed.planReady = true
    consumed.productionApplied = true
    consumed.reused = false
    consumed.headCid = strings.CloneStr(published.headCid)
    consumed.manifestCid = strings.CloneStr(published.finalManifestCid)
    consumed.receiptCid = strings.CloneStr(published.transactionReceiptCid)
    consumed.counters.storeObjectWriteCount = finalObjectWriteCount
    consumed.counters.storeObjectReuseCount =
        finalArtifactCount - finalObjectWriteCount
    consumed.counters.publishAttemptCount = 1
    return consumed

fn runSuccessor(parentPath: str): int32 =
    let read = merkle_store.CsgCoreMerkleStoreReadHead(
        parentPath, StoreName)
    if !read.ok || !read.present:
        return fail(
            cat("writer successor head read failed: ", read.error))
    let expectedHeadCid = read.head.headCid
    let fullReplacements = replacementsV2()
    var planned =
        merkle_transaction.CsgCoreMerkleTransactionPlanStore(
            parentPath,
            StoreName,
            expectedHeadCid,
            [strings.CloneStr(SourceB)],
            fullReplacements)
    if !planned.ok || !planned.planReady || planned.productionApplied:
        let message = strings.CloneStr(planned.error)
        merkle_transaction.CsgCoreMerkleTransactionFree(planned)
        return fail(
            cat("writer successor plan failed: ", message))
    var applied = applySuccessor(planned)
    if !applied.ok || !applied.productionApplied:
        let message = strings.CloneStr(applied.error)
        merkle_transaction.CsgCoreMerkleTransactionFree(applied)
        return fail(
            cat("writer successor apply failed: ", message))
    os.WriteLine(
        os.Get_stdout(),
        cat("writer_successor ok head=", applied.headCid))
    merkle_transaction.CsgCoreMerkleTransactionFree(applied)
    return 0

fn main(argc: int32, argv: str*): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    let parentPath = os.GetEnv("CSG_SUCCESSOR_CRASH_WRITER_PARENT")
    if parentPath.len == 0:
        return fail("CSG_SUCCESSOR_CRASH_WRITER_PARENT missing")
    if cmdline.HasFlag("--init"):
        return runInit(parentPath)
    return runSuccessor(parentPath)
