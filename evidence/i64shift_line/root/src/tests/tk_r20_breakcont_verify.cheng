fn R20Piece(n: int32): str =
    if n == 0:
        return "alpha"
    if n == 1:
        return "bravoo"
    return "charliexx"

fn R20BreakSum(limit: int32, breakAt: int32): int32 =
    var total: int32
    var i: int32
    while i < limit:
        let piece = R20Piece(i)
        if i == breakAt:
            break
        total = total + piece.len
        i = i + 1
    return total

fn R20ContinueSum(limit: int32, skipAt: int32): int32 =
    var total: int32
    var i: int32
    while i < limit:
        let piece = R20Piece(i)
        i = i + 1
        if i - 1 == skipAt:
            continue
        total = total + piece.len
    return total

fn R20NestedBreak(outerLimit: int32, innerLimit: int32): int32 =
    var total: int32
    var o: int32
    while o < outerLimit:
        var j: int32
        while j < innerLimit:
            let inner = R20Piece(j)
            if inner.len > 6:
                break
            total = total + inner.len
            j = j + 1
        o = o + 1
    return total

fn main(): int32 =
    if R20BreakSum(3, -1) != 20:
        return 10
    if R20BreakSum(3, 1) != 5:
        return 11
    if R20ContinueSum(3, -1) != 20:
        return 12
    if R20ContinueSum(3, 1) != 14:
        return 13
    if R20NestedBreak(4, 3) != 44:
        return 14
    echo("tk_r20_breakcont ok break=20/5 continue=20/14 nested=44")
    return 0
