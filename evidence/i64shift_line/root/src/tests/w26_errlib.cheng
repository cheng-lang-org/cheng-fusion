# wave-26 见证库: 复现 dispatch_min:1775 `er.bodyIrDetail.X` 两跳聚合字段形态。
# W26BodyDetail 是内嵌值聚合 (> 8 字节), 作为 W26Err 的字段; W26Plan 持 W26Err[] seq。
# 跨模块容器 var-param + 下标元素 + 两跳 Fmt piece = 中间聚合槽定尺寸缺口的复现形。
type
    W26BodyDetail =
        firstZeroOpKind: int32
        firstZeroOpOperand0: int32
        firstZeroOpOperand1: int32
        firstZeroOpOperand2: int32
        firstZeroLine: int32
        firstZeroColumn: int32
        firstZeroSlot: int32
        firstZeroReason: int32
        firstZeroKindText: str
        firstZeroDetailText: str

    W26Err =
        functionName: str
        lineNumber: int64
        bodyIrDetail: W26BodyDetail

    W26Plan =
        errors: W26Err[]
        planName: str
