# wall38 前置墙最小探针 v5：staging + 默认初始化（切断 queryPlan 来自 ptr-cast 的 provenance）。
type
    W38Plan = object
        text: str
        ok: bool

    W38Work = ref object
        plan: W38Plan
        err: str
        ok: bool

fn w38BuildPlanInto(channel: str, plan: var W38Plan, err: var str): bool =
    plan.text = channel
    plan.ok = true
    err = ""
    return true

fn w38Worker(raw: ptr) =
    if raw == nil:
        return
    let work: W38Work = W38Work(raw)
    var queryPlan = W38Plan(text: "", ok: false)
    if !w38BuildPlanInto("ch", queryPlan, work.err):
        work.ok = false
        return
    work.plan = queryPlan
    work.ok = true

fn main(): int32 =
    return 0
