# backend2_frag_codec_smoke — FunctionFragment 扁平 LE 编解码 round-trip 自测。
# 覆盖: 18 字段全非空 + 负值 word (高位 1 的指令字) + 空串/空序列边界 +
# 编→解→再编逐字节等 + 解码后逐字段语义等。
# 运行 (Mac, pinned driver): system-link-exec 编本文件为可执行后直接跑, rc=0 即过。

import cheng/core/backend2/backend2_types as b2t
import cheng/core/backend2/backend2_frag_codec as b2fc
import cheng/core/ir/core_types as ir
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256 as hash256
import std/result
import std/rawbytes as rawbytes
import std/os as os

fn codecCallTargetCid(hexValue: str): layout.FixedBytes32 =
    let parsed = layout.FixedBytes32FromHex(hexValue)
    assert(IsOk(parsed), "frag codec: call target CID parse")
    return Value(parsed)

@borrows
fn codecFixtureCid(label: str): layout.FixedBytes32 =
    assert(label != "", "frag codec: fixture CID label")
    var buf = layout.ByteBufInit(label.len)
    for index in 0..<label.len:
        layout.ByteBufAppendByte(buf, Int32(label[index]) & 255)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn codecTypeArenaCid(label: str): layout.FixedBytes32 =
    assert(label != "", "frag codec: TypeArena fixture label")
    return codecFixtureCid(label)

fn codecWrongTypeArenaCid(): layout.FixedBytes32 =
    return codecFixtureCid("backend2-codec-wrong-type-arena")

fn buildExternFfiHandleBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    let typeArenaCid = codecTypeArenaCid("ffi-handle-type-arena")
    let interfaceCid = codecFixtureCid(
        "cheng.test.backend2.ffi_handle.interface")
    assert(ir.BodyIRBindCanonicalTypeFact(
               body, typeArenaCid, 7, 1, 10, -1, 0, 4, 4),
           "frag codec: ffi handle scalar type")

    var resultSlot: ir.LocalSlot
    ir.BodyIRApplyLocalSlotDefaultProof(resultSlot)
    resultSlot.id = 0
    resultSlot.name = "ffi_handle_result"
    resultSlot.typeKind = ir.LocalI32Tag
    resultSlot.stackOffset = -4
    resultSlot.sizeBytes = 4
    resultSlot.alignBytes = 4
    add(body.localSlots, resultSlot)
    assert(ir.BodyIRBindLocalSlotTypeArenaProof(
               body, 0, typeArenaCid, 7,
               ir.BodyManagedStorageUnmanagedTag),
           "frag codec: ffi handle result type proof")

    var call: ir.CallOp
    ir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = "ffi_handle_new"
    call.targetSourcePath = "ffi/handle.cheng"
    call.resultSlot = 0
    call.resultOwnership = ir.OwnPlain
    call.resultExprNodeIndex = 41
    call.semanticCallExprNodeIndex = 41
    call.targetIsImportc = true
    add(body.callSequence, call)

    var prefixOp: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(prefixOp)
    prefixOp.kind = ir.BodyOpLoadConstTag
    prefixOp.target = 0
    add(prefixOp.operands, ir.LocalI32Tag)
    add(prefixOp.operands, 0)
    let prefixBodyOpRow = ir.BodyIRAppendOp(body, prefixOp)
    assert(prefixBodyOpRow == 0,
           "frag codec: ffi handle prefix BodyOp row")

    var callOp: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(callOp)
    callOp.kind = ir.BodyOpCallTag
    callOp.target = 0
    add(callOp.operands, 0)
    let callBodyOpRow = ir.BodyIRAppendOp(body, callOp)
    assert(callBodyOpRow == 1,
           "frag codec: ffi handle exact call BodyOp row")

    var term: ir.BodyTerm
    ir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = ir.BodyTermReturnTag
    let termIndex = ir.BodyIRAppendTerm(body, term)
    let blockId = ir.BodyIRAppendBlock(body, 0, 2, termIndex)
    ir.BodyIRControlFlowBegin(body, 17)
    ir.BodyIRControlFlowBindBlockScope(body, blockId, 0)
    var noSuccessors: int32[]
    var noEdgeKinds: int32[]
    ir.BodyIRControlFlowBindTermSuccessors(
        body, termIndex, noSuccessors, noEdgeKinds)
    ir.BodyIRControlFlowBindCallTarget(
        body, 0, ir.BodyCallTargetDomainExternFunctionTag, 3,
        interfaceCid)
    ir.BodyIRControlFlowSeal(body)

    ir.BodyIRExternFfiHandleCapabilityBegin(
        body,
        17,
        codecFixtureCid("cheng.test.backend2.ffi_handle.snapshot"),
        codecFixtureCid("cheng.test.backend2.ffi_handle.cargo"),
        codecFixtureCid("cheng.test.backend2.ffi_handle.lowering"))
    assert(body.controlFlowSealed &&
           ir.BodyIRUniqueCallBodyOpRow(body, 0) == callBodyOpRow,
           "frag codec: ffi handle sealed unique Call BodyOp")
    var callCapability: ir.BodyIRExternFfiHandleCallCapability
    callCapability.callOrdinal = 0
    callCapability.semanticCapabilityCallRow = 0
    callCapability.resolvedCallRow = 0
    callCapability.snapshotCallId = 0
    callCapability.semanticContractRow = 0
    callCapability.snapshotContractRow = 0
    callCapability.semanticEffectStart = 0
    callCapability.effectCount = 1
    callCapability.callCapabilityCid = codecFixtureCid(
        "cheng.test.backend2.ffi_handle.call_capability")
    callCapability.contractCid = codecFixtureCid(
        "cheng.test.backend2.ffi_handle.contract")
    callCapability.interfaceCid = interfaceCid
    callCapability.callBridgeCid = codecFixtureCid(
        "cheng.test.backend2.ffi_handle.call_bridge")
    ir.BodyIRExternFfiHandleCapabilityAppendCall(body, callCapability)
    assert(body.externFfiHandleCapabilities.callBodyOpRows.len == 1 &&
           body.externFfiHandleCapabilities.callBodyOpRows[0] ==
               callBodyOpRow,
           "frag codec: ffi handle API-bound Call BodyOp row")

    var effectCapability: ir.BodyIRExternFfiHandleEffectCapability
    effectCapability.semanticCapabilityEffectRow = 0
    effectCapability.contractEffectRow = 0
    effectCapability.snapshotEffectRow = 0
    effectCapability.snapshotEffectContractRow = 0
    effectCapability.effectKind =
        ir.BodyExternFfiHandleEffectProduceTag
    effectCapability.targetKind =
        ir.BodyExternFfiHandleTargetResultTag
    effectCapability.argumentSlotId = 0
    effectCapability.argumentValueNodeIndex = 41
    effectCapability.valueDefinitionRow = 0
    effectCapability.generationRootValueDefinitionRow = 0
    effectCapability.exactTypeId = 7
    effectCapability.carrierKind =
        ir.BodyExternFfiHandleCarrierUInt32Tag
    effectCapability.typeCid = codecFixtureCid(
        "cheng.test.backend2.ffi_handle.type")
    effectCapability.generationCid = codecFixtureCid(
        "cheng.test.backend2.ffi_handle.generation")
    effectCapability.definitionLineageCid = codecFixtureCid(
        "cheng.test.backend2.ffi_handle.definition_lineage")
    effectCapability.effectCapabilityCid = codecFixtureCid(
        "cheng.test.backend2.ffi_handle.effect_capability")
    effectCapability.contractEffectCid = codecFixtureCid(
        "cheng.test.backend2.ffi_handle.contract_effect")
    effectCapability.effectBridgeCid = codecFixtureCid(
        "cheng.test.backend2.ffi_handle.effect_bridge")
    ir.BodyIRExternFfiHandleCapabilityAppendEffect(
        body, effectCapability)
    ir.BodyIRExternFfiHandleCapabilitySeal(body)
    assert(ir.BodyIRExternFfiHandleCapabilitySidecarShapeValid(body),
           "frag codec: ffi handle source sidecar")
    return body

fn assertExternFfiHandleCallBodyOpRoundTrip() =
    var body = buildExternFfiHandleBody()
    assert(body.externFfiHandleCapabilities.callOrdinals.len == 1 &&
           body.externFfiHandleCapabilities.callOrdinals[0] == 0 &&
           body.externFfiHandleCapabilities.callBodyOpRows.len == 1 &&
           body.externFfiHandleCapabilities.callBodyOpRows[0] == 1 &&
           ir.BodyIRUniqueCallBodyOpRow(body, 0) == 1,
           "frag codec: producer-bound call BodyOp row")
    b2fc.Backend2BodyIrRoundTripAssert(body)
    var encoded = b2fc.Backend2BodyIrEncode(body)
    var cursor: int32
    var decoded = b2fc.Backend2BodyIrDecode(encoded, cursor)
    assert(cursor == rawbytes.BytesLen(encoded) &&
           decoded.externFfiHandleCapabilities.callOrdinals.len == 1 &&
           decoded.externFfiHandleCapabilities.callOrdinals[0] == 0 &&
           decoded.externFfiHandleCapabilities.callBodyOpRows.len == 1 &&
           decoded.externFfiHandleCapabilities.callBodyOpRows[0] == 1 &&
           ir.BodyIRUniqueCallBodyOpRow(decoded, 0) == 1 &&
           ir.BodyIRExternFfiHandleCapabilitySidecarShapeValid(decoded),
           "frag codec: nonempty ffi call BodyOp row round-trip")
    assert(decoded.ops.len == 2 &&
           decoded.ops[0].kind != ir.BodyOpCallTag &&
           decoded.ops[1].kind == ir.BodyOpCallTag,
           "frag codec: wrong-row fixture must stay in range")
    decoded.externFfiHandleCapabilities.callBodyOpRows[0] = 0
    decoded.externFfiHandleCapabilities.rootCid =
        ir.BodyIRExternFfiHandleCapabilitySidecarCid(decoded)
    assert(!ir.BodyIRExternFfiHandleCapabilitySidecarShapeValid(decoded),
           "frag codec: rehashed wrong call BodyOp row survived")
    var recoveredCursor: int32
    var recovered = b2fc.Backend2BodyIrDecode(
        encoded, recoveredCursor)
    var recoveredEncoded = b2fc.Backend2BodyIrEncode(recovered)
    assert(recoveredCursor == rawbytes.BytesLen(encoded) &&
           recovered.externFfiHandleCapabilities.callBodyOpRows.len == 1 &&
           recovered.externFfiHandleCapabilities.callBodyOpRows[0] == 1 &&
           ir.BodyIRUniqueCallBodyOpRow(recovered, 0) == 1 &&
           ir.BodyIRExternFfiHandleCapabilitySidecarShapeValid(recovered) &&
           rawbytes.BytesEqual(encoded, recoveredEncoded),
           "frag codec: canonical bytes recovery")
    rawbytes.BytesFree(recoveredEncoded)
    rawbytes.BytesFree(encoded)

fn buildCleanupCodecCanonicalEmptyBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    assert(ir.BodyIRBindTypeArenaArtifactCid(
               body,
               codecTypeArenaCid(
                   "cleanup-authority-canonical-empty-type-arena")),
           "frag codec: cleanup canonical empty TypeArena bind")
    assert(ir.BodyIRCleanupIntentSidecarIsCanonicalEmpty(
               body.cleanupIntent) &&
           ir.BodyIRCleanupScheduleSidecarIsCanonicalEmpty(
               body.cleanupSchedule) &&
           ir.BodyIRDeferReplaySidecarIsCanonicalEmpty(
               body.deferReplay) &&
           ir.BodyIRCleanupProofShapeValid(body),
           "frag codec: cleanup canonical empty source shape")
    return body

fn cleanupAuthorityCanonicalEmptyTagOffset(
        encoded: rawbytes.Bytes): int32 =
    let tagOffset = rawbytes.BytesLen(encoded) - 36 - 612
    assert(tagOffset >= 0,
           "frag codec: cleanup authority tag offset")
    var tagCursor = tagOffset
    assert(b2fc.Backend2CodecReadU32(encoded, tagCursor) == 17,
           "frag codec: cleanup authority tag")
    return tagOffset

fn assertCleanupAuthorityCanonicalEmptyRoundTrip() =
    var body = buildCleanupCodecCanonicalEmptyBody()
    b2fc.Backend2BodyIrRoundTripAssert(body)
    var encodedA = b2fc.Backend2BodyIrEncode(body)
    var encodedB = b2fc.Backend2BodyIrEncode(body)
    assert(rawbytes.BytesEqual(encodedA, encodedB),
           "frag codec: cleanup canonical empty bytes not unique")
    assert(rawbytes.BytesLen(encodedA) ==
               b2fc.Backend2BodyIrEncodedSize(body),
           "frag codec: cleanup canonical empty encoded size")
    let tagOffset =
        cleanupAuthorityCanonicalEmptyTagOffset(encodedA)
    var cursor: int32
    var decoded = b2fc.Backend2BodyIrDecode(encodedA, cursor)
    var reencoded = b2fc.Backend2BodyIrEncode(decoded)
    assert(cursor == rawbytes.BytesLen(encodedA) &&
           ir.BodyIRCleanupIntentSidecarIsCanonicalEmpty(
               decoded.cleanupIntent) &&
           ir.BodyIRCleanupScheduleSidecarIsCanonicalEmpty(
               decoded.cleanupSchedule) &&
           ir.BodyIRDeferReplaySidecarIsCanonicalEmpty(
               decoded.deferReplay) &&
           ir.BodyIRCleanupProofShapeValid(decoded) &&
           !ir.BodyIRTypeArenaArtifactCidValid(
               decoded.cleanupSourceProjectionCid) &&
           rawbytes.BytesEqual(encodedA, reencoded),
           "frag codec: cleanup canonical empty round-trip")
    assert(tagOffset + 612 + 36 == rawbytes.BytesLen(encodedA),
           "frag codec: cleanup authority fixed layout")
    rawbytes.BytesFree(reencoded)
    rawbytes.BytesFree(encodedA)
    rawbytes.BytesFree(encodedB)

fn runCleanupAuthorityNegative(mode: str) =
    var body = buildCleanupCodecCanonicalEmptyBody()
    var encoded = b2fc.Backend2BodyIrEncode(body)
    let tagOffset =
        cleanupAuthorityCanonicalEmptyTagOffset(encoded)
    let intentBuildingOffset = tagOffset + 36
    let firstIntentColumnLengthOffset = tagOffset + 192
    let firstEffectColumnLengthOffset = tagOffset + 524
    var cursor: int32
    if mode == "truncated":
        let truncated = rawbytes.BytesSliceView(
            encoded, 0, tagOffset + 35)
        let _ = b2fc.Backend2BodyIrDecode(truncated, cursor)
    elif mode == "wrong-column-length":
        b2fc.Backend2CodecPutU32(
            encoded, firstIntentColumnLengthOffset, 1)
        let _ = b2fc.Backend2BodyIrDecode(encoded, cursor)
    elif mode == "wrong-effect-column-length":
        b2fc.Backend2CodecPutU32(
            encoded, firstEffectColumnLengthOffset, 2147483647)
        let _ = b2fc.Backend2BodyIrDecode(encoded, cursor)
    elif mode == "nonempty-unauthorized":
        b2fc.Backend2CodecPutU32(
            encoded, intentBuildingOffset, 1)
        let _ = b2fc.Backend2BodyIrDecode(encoded, cursor)
    elif mode == "trailing":
        var trailing = rawbytes.BytesAlloc(
            rawbytes.BytesLen(encoded) + 1)
        rawbytes.BytesCopyRangeInto(
            trailing, 0, encoded, 0,
            rawbytes.BytesLen(encoded))
        rawbytes.BytesSet(
            trailing, rawbytes.BytesLen(encoded), 0x5a)
        let _ = b2fc.Backend2BodyIrDecode(trailing, cursor)
    else:
        panic("frag codec: unknown cleanup authority negative mode")
    panic("frag codec: cleanup authority negative unexpectedly accepted")

fn buildSampleFragment(): b2t.FunctionFragment =
    var frag: b2t.FunctionFragment
    frag.funcEmitCid = "cid_deadbeef00112233"
    frag.functionSymbol = "_cheng_sample_fn"
    frag.wordCount = 5
    add(frag.words, 0x12345678)
    add(frag.words, -1)                      # 高位全 1 指令字 (负 int32 LE 往返)
    add(frag.words, 0)
    add(frag.words, -2147483647 - 1)         # INT32_MIN (避开正字面量溢出解析边)
    add(frag.words, 2147483647)              # INT32_MAX
    add(frag.relocWordOffsets, 1)
    add(frag.relocWordOffsets, 4)
    add(frag.relocTargetSymbols, "_callee_a")
    add(frag.relocTargetSymbols, "_callee_b")
    add(frag.refSymbols, "_ref_only")
    add(frag.cstringLiterals, "hello world")
    add(frag.cstringLiterals, "")            # 空串边界
    add(frag.cstringDataLabels, "cheng_cstr_0")
    add(frag.cstringDataLabels, "cheng_cstr_1")
    add(frag.cstringPayloadRawBytes, 104)
    add(frag.cstringPayloadRawBytes, 0)
    add(frag.cstringPayloadRawByteCounts, 12)
    add(frag.cstringPayloadRawByteCounts, 1)
    add(frag.dataRelocFnRelWordOffsets, 2)
    add(frag.dataRelocTargetLabels, "cheng_cstr_0")
    add(frag.globalDataLabelsRaw, "cheng_global_counter")
    add(frag.globalDataLabelsRaw, "cheng_global_flag")
    add(frag.globalDataPayloadTexts, "hex:0000002a")
    add(frag.globalDataPayloadTexts, "zero:8")
    add(frag.globalDataPayloadByteCounts, 0)
    add(frag.globalDataPayloadByteCounts, 0)
    frag.bodyIrPayload = "body-ir-codec-payload"
    frag.contentCid = "content-cid-codec-payload"
    return frag

fn assertStrSeqEqual(a: str[], b: str[], what: str) =
    assert(a.len == b.len, what)
    for i in 0..<a.len:
        assert(a[i] == b[i], what)

fn assertI32SeqEqual(a: int32[], b: int32[], what: str) =
    assert(a.len == b.len, what)
    for i in 0..<a.len:
        assert(a[i] == b[i], what)

fn buildEntryParameterCodecBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    let typeArenaCid = codecTypeArenaCid(
        "backend2-entry-parameter-index-type-arena")
    assert(ir.BodyIRBindTypeArenaArtifactCid(body, typeArenaCid),
           "frag codec: entry parameter TypeArena bind")
    for parameterOrdinal in 0..<2:
        var slot: ir.LocalSlot
        ir.BodyIRApplyLocalSlotDefaultProof(slot)
        slot.id = parameterOrdinal
        slot.name = Fmt"parameter_{parameterOrdinal}"
        slot.typeKind = ir.LocalI32Tag
        slot.stackOffset = 0 - 1 - parameterOrdinal
        slot.sizeBytes = 4
        slot.alignBytes = 4
        add(body.localSlots, slot)
        ir.BodyIRBindEntryParameterSlot(
            body, parameterOrdinal, parameterOrdinal)
    assert(ir.BodyIREntryParameterSlotsShapeValid(body),
           "frag codec: entry parameter source shape")
    return body

fn assertEntryParameterIndexRoundTrip() =
    var body = buildEntryParameterCodecBody()
    b2fc.Backend2BodyIrRoundTripAssert(body)
    var encoded = b2fc.Backend2BodyIrEncode(body)
    var cursor: int32
    var decoded = b2fc.Backend2BodyIrDecode(encoded, cursor)
    var reencoded = b2fc.Backend2BodyIrEncode(decoded)
    assert(cursor == rawbytes.BytesLen(encoded) &&
           decoded.entryParameterSlotIds.len == 2 &&
           decoded.entryParameterSlotIds[0] == 0 &&
           decoded.entryParameterSlotIds[1] == 1 &&
           ir.BodyIREntryParameterSlotsShapeValid(decoded) &&
           rawbytes.BytesEqual(encoded, reencoded),
           "frag codec: entry parameter exact round-trip")
    rawbytes.BytesFree(reencoded)
    rawbytes.BytesFree(encoded)

fn runEntryParameterIndexNegative() =
    var body = buildEntryParameterCodecBody()
    body.entryParameterSlotIds[0] = 1
    let _ = b2fc.Backend2BodyIrEncode(body)
    panic("frag codec: entry parameter mutation unexpectedly accepted")

fn assertDebugBodyIrRoundTrip() =
    var body = ir.BodyIRNew()
    let typeArenaCid = codecTypeArenaCid("backend2-codec-type-arena")
    assert(ir.BodyIRBindTypeArenaArtifactCid(body, typeArenaCid),
           "frag codec: TypeArena artifact bind")
    assert(ir.BodyIRBindCanonicalTypeFact(
               body, typeArenaCid, 3, 4, 0, 1, 32, 256, 8),
           "frag codec: canonical TypeArena fact bind")
    assert(ir.BodyIRBindCanonicalTypeFact(
               body, typeArenaCid, 7, 1, 10, -1, 0, 4, 4),
           "frag codec: canonical scalar fact bind")
    assert(ir.BodyIRDebugProvenanceBegin(body, 7),
           "frag codec: debug provenance begin")
    assert(ir.BodyIRDebugProvenanceSetExact(body, 11),
           "frag codec: exact DebugOp bind")
    var op: ir.BodyOp
    op.kind = ir.BodyOpLoadConstTag
    op.target = 0
    add(op.operands, ir.LocalI32Tag)
    add(op.operands, 1)
    let _ = ir.BodyIRAppendOp(body, op)
    assert(ir.BodyIRDebugProvenanceSetSynthetic(
               body, ir.BodyDebugSyntheticControlFlow),
           "frag codec: synthetic control-flow bind")
    var term: ir.BodyTerm
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = -1
    let termIndex = ir.BodyIRAppendTerm(body, term)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    assert(ir.BodyIRDebugProvenanceShapeValid(body),
           "frag codec: source debug provenance shape")
    b2fc.Backend2BodyIrRoundTripAssert(body)
    var encoded = b2fc.Backend2BodyIrEncode(body)
    var cursor: int32
    var decoded = b2fc.Backend2BodyIrDecode(encoded, cursor)
    assert(cursor == rawbytes.BytesLen(encoded) &&
           ir.BodyIRDebugProvenanceShapeValid(decoded) &&
           decoded.debugFunctionId == 7 &&
           decoded.debugOpIdsByOpIndex.len == 1 &&
           decoded.debugOpIdsByOpIndex[0] == 11 &&
           decoded.debugSyntheticKindsByOpIndex.len == 1 &&
           decoded.debugSyntheticKindsByOpIndex[0] ==
               ir.BodyDebugSyntheticNone &&
           decoded.debugOpIdsByTermIndex.len == 1 &&
           decoded.debugOpIdsByTermIndex[0] == -1 &&
           decoded.debugSyntheticKindsByTermIndex.len == 1 &&
           decoded.debugSyntheticKindsByTermIndex[0] ==
               ir.BodyDebugSyntheticControlFlow &&
           decoded.typeFactTypeIds.len == 2 &&
           decoded.typeFactTypeIds[0] == 3 &&
           decoded.typeFactTypeIds[1] == 7 &&
           decoded.typeFactStructuralKinds[0] == 4 &&
           decoded.typeFactChildTypeIds[0] == 1 &&
           decoded.typeFactFixedLengths[0] == 32 &&
           decoded.typeFactSizeBytes[0] == 256 &&
           decoded.typeFactAlignBytes[0] == 8 &&
           ir.BodyIRCanonicalTypeFactShapeValid(decoded) &&
           ir.BodyIRControlFlowShapeValid(decoded) &&
           !decoded.controlFlowSealed &&
           decoded.controlFunctionRow == -1 &&
           layout.FixedBytes32Equal(
               decoded.typeArenaArtifactCid, typeArenaCid),
           "frag codec: immutable debug SoA round-trip")
    assert(b2fc.Backend2BodyIrEncodedTypeArenaArtifactMatches(
               encoded, typeArenaCid),
           "frag codec: encoded TypeArena artifact identity")
    assert(!b2fc.Backend2BodyIrEncodedTypeArenaArtifactMatches(
               encoded, codecWrongTypeArenaCid()),
           "frag codec: wrong-valid TypeArena CID survived admission")
    var trailing = rawbytes.BytesAlloc(rawbytes.BytesLen(encoded) + 1)
    rawbytes.BytesCopyRangeInto(trailing,
                                0,
                                encoded,
                                0,
                                rawbytes.BytesLen(encoded))
    rawbytes.BytesSet(trailing, rawbytes.BytesLen(encoded), 0x5a)
    assert(!b2fc.Backend2BodyIrEncodedTypeArenaArtifactMatches(
               trailing, typeArenaCid),
           "frag codec: trailing mutation survived identity admission")
    rawbytes.BytesFree(trailing)
    let tailIndex = rawbytes.BytesLen(encoded) - 1
    let savedTail = rawbytes.BytesGet(encoded, tailIndex)
    rawbytes.BytesSet(encoded, tailIndex, savedTail ^ 1)
    assert(!b2fc.Backend2BodyIrEncodedTypeArenaArtifactMatches(
               encoded, typeArenaCid),
           "frag codec: TypeArena CID tamper survived")
    rawbytes.BytesSet(encoded, tailIndex, savedTail)
    rawbytes.BytesFree(encoded)

fn assertDeferActionExactTargetIdentityRoundTrip() =
    var body = ir.BodyIRNew()
    let typeArenaCid = codecTypeArenaCid("defer-action-type-arena")
    let targetCid = codecCallTargetCid(
        "5555555555555555555555555555555555555555555555555555555555555555")
    let otherTargetCid = codecCallTargetCid(
        "6666666666666666666666666666666666666666666666666666666666666666")
    let runtimeTargetCid = codecCallTargetCid(
        "7777777777777777777777777777777777777777777777777777777777777777")
    assert(ir.BodyIRBindTypeArenaArtifactCid(body, typeArenaCid),
           "frag codec: defer TypeArena artifact bind")
    ir.BodyIRControlFlowBegin(body, 9)
    let suiteScopeId = ir.BodyIRControlFlowAddScope(body, 0)

    var call: ir.CallOp
    ir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = "_linker_spelling_a"
    call.targetSourcePath = "source/spelling/a.cheng"
    add(body.callSequence, call)
    ir.BodyIRControlFlowBindCallTarget(
        body, 0, ir.BodyCallTargetDomainFunctionTag, 23, targetCid)
    var externCall: ir.CallOp
    ir.BodyIRApplyCallOpDefaultProof(externCall)
    externCall.targetSymbol = "_extern_spelling"
    externCall.targetSourcePath = "source/extern.cheng"
    add(body.callSequence, externCall)
    ir.BodyIRControlFlowBindCallTarget(
        body, 1, ir.BodyCallTargetDomainExternFunctionTag, 31,
        otherTargetCid)
    var runtimeCall: ir.CallOp
    ir.BodyIRApplyCallOpDefaultProof(runtimeCall)
    runtimeCall.targetSymbol = "_runtime_spelling"
    runtimeCall.targetSourcePath = "source/runtime.cheng"
    add(body.callSequence, runtimeCall)
    ir.BodyIRControlFlowBindCallTarget(
        body, 2, ir.BodyCallTargetDomainRuntimeIntrinsicTag, 7,
        runtimeTargetCid)

    var actionOp: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(actionOp)
    actionOp.kind = ir.BodyOpCallTag
    add(actionOp.operands, 0)
    let _ = ir.BodyIRAppendOp(body, actionOp)

    var rootTerm: ir.BodyTerm
    ir.BodyIRApplyBodyTermDefaultProof(rootTerm)
    rootTerm.kind = ir.BodyTermReturnTag
    let rootTermIndex = ir.BodyIRAppendTerm(body, rootTerm)
    let rootBlockId = ir.BodyIRAppendBlock(body, 0, 0, rootTermIndex)

    var actionTerm: ir.BodyTerm
    ir.BodyIRApplyBodyTermDefaultProof(actionTerm)
    actionTerm.kind = ir.BodyTermReturnTag
    let actionTermIndex = ir.BodyIRAppendTerm(body, actionTerm)
    let actionBlockId = ir.BodyIRAppendBlock(
        body, 0, 1, actionTermIndex)
    ir.BodyIRControlFlowBindBlockScope(body, rootBlockId, 0)
    ir.BodyIRControlFlowBindBlockScope(
        body, actionBlockId, suiteScopeId)
    var noSuccessors: int32[]
    var noEdgeKinds: int32[]
    ir.BodyIRControlFlowBindTermSuccessors(
        body, rootTermIndex, noSuccessors, noEdgeKinds)
    ir.BodyIRControlFlowBindTermSuccessors(
        body, actionTermIndex, noSuccessors, noEdgeKinds)
    let deferId = ir.BodyIRControlFlowAddDefer(
        body, 0, suiteScopeId, 0, 9, 41)
    var activatedDefers: int32[] = [deferId]
    ir.BodyIRControlFlowAddDeferActivationSite(
        body, rootBlockId, 0, activatedDefers)
    ir.BodyIRControlFlowSeal(body)
    assert(ir.BodyIRControlFlowShapeValid(body),
           "frag codec: sealed defer control shape")
    let actionCid =
        ir.BodyIRControlFlowDeferActionCid(body, deferId)
    assert(layout.FixedBytes32Equal(
               actionCid, body.deferActionCids[deferId]),
           "frag codec: defer action CID seal")

    body.callSequence[0].targetSymbol = "_linker_spelling_b"
    body.callSequence[0].targetSourcePath = "other/spelling/b.cheng"
    assert(layout.FixedBytes32Equal(
               actionCid,
               ir.BodyIRControlFlowDeferActionCid(body, deferId)) &&
           ir.BodyIRControlFlowShapeValid(body),
           "frag codec: text spelling changed semantic action identity")
    body.callTargetInterfaceCids[0] = otherTargetCid
    assert(!layout.FixedBytes32Equal(
               actionCid,
               ir.BodyIRControlFlowDeferActionCid(body, deferId)) &&
           !ir.BodyIRControlFlowShapeValid(body),
           "frag codec: exact target interface CID mutation survived")
    body.callTargetInterfaceCids[0] = targetCid
    body.callTargetDomainKinds[0] =
        ir.BodyCallTargetDomainExternFunctionTag
    assert(!layout.FixedBytes32Equal(
               actionCid,
               ir.BodyIRControlFlowDeferActionCid(body, deferId)) &&
           !ir.BodyIRControlFlowShapeValid(body),
           "frag codec: exact target domain mutation survived")
    body.callTargetDomainKinds[0] = ir.BodyCallTargetDomainInvalidTag
    assert(!ir.BodyIRControlFlowShapeValid(body),
           "frag codec: invalid target domain survived")
    body.callTargetDomainKinds[0] =
        ir.BodyCallTargetDomainFunctionTag
    body.callTargetRows[0] = -1
    assert(!ir.BodyIRControlFlowShapeValid(body),
           "frag codec: negative target row survived")
    body.callTargetRows[0] = 23
    assert(ir.BodyIRControlFlowShapeValid(body),
           "frag codec: exact target identity restore")

    b2fc.Backend2BodyIrRoundTripAssert(body)
    var encoded = b2fc.Backend2BodyIrEncode(body)
    var cursor: int32
    let decoded = b2fc.Backend2BodyIrDecode(encoded, cursor)
    assert(cursor == rawbytes.BytesLen(encoded) &&
           decoded.callTargetDomainKinds.len == 3 &&
           decoded.callTargetDomainKinds[0] ==
               ir.BodyCallTargetDomainFunctionTag &&
           decoded.callTargetDomainKinds[1] ==
               ir.BodyCallTargetDomainExternFunctionTag &&
           decoded.callTargetDomainKinds[2] ==
               ir.BodyCallTargetDomainRuntimeIntrinsicTag &&
           decoded.callTargetRows.len == 3 &&
           decoded.callTargetRows[0] == 23 &&
           decoded.callTargetRows[1] == 31 &&
           decoded.callTargetRows[2] == 0 &&
           decoded.callTargetInterfaceCids.len == 3 &&
           layout.FixedBytes32Equal(
               decoded.callTargetInterfaceCids[0], targetCid) &&
           layout.FixedBytes32Equal(
               decoded.callTargetInterfaceCids[1], otherTargetCid) &&
           layout.FixedBytes32Equal(
               decoded.callTargetInterfaceCids[2], runtimeTargetCid) &&
           ir.BodyIRControlFlowShapeValid(decoded) &&
           layout.FixedBytes32Equal(
               decoded.deferActionCids[deferId], actionCid),
           "frag codec: exact defer target identity round-trip")
    rawbytes.BytesFree(encoded)

fn main(): int32 =
    let cleanupAuthorityNegative =
        os.GetEnv("CHENG_CLEANUP_AUTHORITY_CODEC_NEGATIVE")
    if cleanupAuthorityNegative != "":
        runCleanupAuthorityNegative(cleanupAuthorityNegative)
        return 3
    if os.GetEnv("CHENG_ENTRY_PARAMETER_CODEC_NEGATIVE") != "":
        runEntryParameterIndexNegative()
        return 4
    var frag = buildSampleFragment()

    # ① round-trip 断言 (编→解→再编逐字节等) — 失败即 panic 非零退出
    b2fc.Backend2FragmentRoundTripAssert(frag)

    # ② 解码后逐字段语义等 (round-trip 之外再钉一层字段级回读)
    var enc = b2fc.Backend2FragmentEncode(frag)
    assert(enc.len == b2fc.Backend2FragmentEncodedSize(frag),
           "frag codec: encoded size equation")
    var cursor: int32
    let dec = b2fc.Backend2FragmentDecode(enc, cursor)
    assert(cursor == enc.len, "frag codec: decode consumed all bytes")
    assert(dec.funcEmitCid == frag.funcEmitCid, "frag codec: funcEmitCid")
    assert(dec.functionSymbol == frag.functionSymbol, "frag codec: functionSymbol")
    assert(dec.wordCount == frag.wordCount, "frag codec: wordCount")
    assertI32SeqEqual(dec.words, frag.words, "frag codec: words")
    assertI32SeqEqual(dec.relocWordOffsets, frag.relocWordOffsets, "frag codec: relocWordOffsets")
    assertStrSeqEqual(dec.relocTargetSymbols, frag.relocTargetSymbols, "frag codec: relocTargetSymbols")
    assertStrSeqEqual(dec.refSymbols, frag.refSymbols, "frag codec: refSymbols")
    assertStrSeqEqual(dec.cstringLiterals, frag.cstringLiterals, "frag codec: cstringLiterals")
    assertStrSeqEqual(dec.cstringDataLabels, frag.cstringDataLabels, "frag codec: cstringDataLabels")
    assertI32SeqEqual(dec.cstringPayloadRawBytes, frag.cstringPayloadRawBytes,
                      "frag codec: cstringPayloadRawBytes")
    assertI32SeqEqual(dec.cstringPayloadRawByteCounts, frag.cstringPayloadRawByteCounts,
                      "frag codec: cstringPayloadRawByteCounts")
    assertI32SeqEqual(dec.dataRelocFnRelWordOffsets, frag.dataRelocFnRelWordOffsets,
                      "frag codec: dataRelocFnRelWordOffsets")
    assertStrSeqEqual(dec.dataRelocTargetLabels, frag.dataRelocTargetLabels,
                      "frag codec: dataRelocTargetLabels")
    assertStrSeqEqual(dec.globalDataLabelsRaw, frag.globalDataLabelsRaw,
                      "frag codec: globalDataLabelsRaw")
    assertStrSeqEqual(dec.globalDataPayloadTexts, frag.globalDataPayloadTexts,
                      "frag codec: globalDataPayloadTexts")
    assertI32SeqEqual(dec.globalDataPayloadByteCounts, frag.globalDataPayloadByteCounts,
                      "frag codec: globalDataPayloadByteCounts")
    assert(dec.bodyIrPayload == frag.bodyIrPayload,
           "frag codec: bodyIrPayload")
    assert(dec.contentCid == frag.contentCid,
           "frag codec: contentCid")
    rawbytes.BytesFree(enc)

    # ③ 空 fragment 边界 (全字段默认零值) round-trip
    var emptyFrag: b2t.FunctionFragment
    b2fc.Backend2FragmentRoundTripAssert(emptyFrag)
    assertDebugBodyIrRoundTrip()
    assertDeferActionExactTargetIdentityRoundTrip()
    assertExternFfiHandleCallBodyOpRoundTrip()
    assertCleanupAuthorityCanonicalEmptyRoundTrip()
    assertEntryParameterIndexRoundTrip()

    return 0
