import std/system
import std/seqs

type
    FlatBoxShare = ref object
        v: int32[]

@borrows
fn flatPutShare(b: FlatBoxShare, val: int32) =
    var v = share(b.v)
    b.v = []
    v[3] = val
    b.v = v
    v = []

fn main() =
    var b: FlatBoxShare = new(FlatBoxShare)
    var v0: int32[]
    seqs.setLen(v0, 8)
    for i in 0..<v0.len:
        v0[i] = 0
    b.v = v0
    flatPutShare(b, 9)
    assert(b.v[3] == 9, "flat d8: shared take value")
    echo("repro_flatcols_d8 ok")
