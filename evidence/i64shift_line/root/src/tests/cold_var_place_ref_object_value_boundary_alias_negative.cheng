type
    ColdVarPlaceValueAliasCell =
        value: int32

    ColdVarPlaceValueAliasInner = ref object
        cell: ColdVarPlaceValueAliasCell

    ColdVarPlaceValueAliasOuter = ref object
        inner: ColdVarPlaceValueAliasInner

fn ColdVarPlaceValueAliasWrite(
        first: var ColdVarPlaceValueAliasCell,
        second: var ColdVarPlaceValueAliasCell) =
    first.value = 47
    second.value = 53

fn ColdVarPlaceValueAliasMutate(
        out: var ColdVarPlaceValueAliasOuter) =
    var inner = out.inner
    ColdVarPlaceValueAliasWrite(
        inner.cell,
        inner.cell)

fn main(): int32 =
    var out = new(ColdVarPlaceValueAliasOuter)
    out.inner = new(ColdVarPlaceValueAliasInner)
    ColdVarPlaceValueAliasMutate(out)
    return 0
