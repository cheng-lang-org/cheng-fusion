import std/os as os
import std/rawbytes as rawbytes
import cheng/core/backend2/backend2_frag_codec as codec
import cheng/core/backend2/backend2_types as b2t
import cheng/core/ir/core_types as ir
import cheng/std/bytes_layout as layout
import std/result

const
    cleanupIntentColumnCount: int32 = 47
    cleanupScheduleColumnCount: int32 = 27
    cleanupReplayColumnCount: int32 = 3

fn insertHeaderWord(current: rawbytes.Bytes, word: int32): rawbytes.Bytes =
    var out = rawbytes.BytesAlloc(current.len + 4)
    rawbytes.BytesCopyRangeInto(out, 0, current, 0, 4)
    codec.Backend2CodecPutU32(out, 4, word)
    rawbytes.BytesCopyRangeInto(out, 8, current, 4, current.len - 4)
    return out

fn insertWordAt(
        current: rawbytes.Bytes,
        offset: int32,
        word: int32): rawbytes.Bytes =
    assert(offset >= 0 && offset <= current.len,
           "codec attack insertion offset")
    var out = rawbytes.BytesAlloc(current.len + 4)
    rawbytes.BytesCopyRangeInto(out, 0, current, 0, offset)
    codec.Backend2CodecPutU32(out, offset, word)
    rawbytes.BytesCopyRangeInto(
        out, offset + 4, current, offset, current.len - offset)
    return out

fn deleteWordAt(
        current: rawbytes.Bytes,
        offset: int32): rawbytes.Bytes =
    assert(offset >= 0 && offset <= current.len - 4,
           "codec attack deletion offset")
    var out = rawbytes.BytesAlloc(current.len - 4)
    rawbytes.BytesCopyRangeInto(out, 0, current, 0, offset)
    rawbytes.BytesCopyRangeInto(
        out, offset, current, offset + 4, current.len - offset - 4)
    return out

fn canonicalEmptyCleanupAuthorityBytes(): int32 =
    let intentFixedBytes = 32 + 2 * 4 + 4 * 32 + 5 * 4
    let scheduleFixedBytes = 2 * 4 + 2 * 32
    let replayFixedBytes = 2 * 4 + 32
    return 4 + intentFixedBytes + cleanupIntentColumnCount * 4 +
           scheduleFixedBytes + cleanupScheduleColumnCount * 4 +
           replayFixedBytes + cleanupReplayColumnCount * 4

fn cleanupAuthorityTagOffset(current: rawbytes.Bytes): int32 =
    # The fixture has canonical-empty columns, so its field17 byte count is
    # derived exactly from the unique 47+27+3 schema. No fact-count-dependent
    # total payload offset is embedded here.
    let trailingTypeArenaAtomBytes: int32 = 4 + 32
    let tagOffset =
        current.len - trailingTypeArenaAtomBytes -
        canonicalEmptyCleanupAuthorityBytes()
    assert(tagOffset >= 8, "codec attack cleanup authority tag offset")
    var tagCursor = tagOffset
    assert(codec.Backend2CodecReadU32(current, tagCursor) == 17,
           "codec attack cleanup authority tag missing")
    let trailingTypeArenaTag =
        tagOffset + canonicalEmptyCleanupAuthorityBytes()
    var trailingCursor = trailingTypeArenaTag
    assert(codec.Backend2CodecReadU32(current, trailingCursor) == 11 &&
           trailingTypeArenaTag + trailingTypeArenaAtomBytes == current.len,
           "codec attack trailing TypeArena atom")
    return tagOffset

fn entryDefinitionTagOffset(current: rawbytes.Bytes): int32 =
    # attackBody has canonical-empty tag15/tag16/tag17 payloads.  Derive the
    # tag15 boundary from the exact trailing schemas, never by scanning bytes.
    let trailingTypeArenaAtomBytes: int32 = 4 + 32
    let canonicalEmptyExternCapabilityBytes: int32 = 280
    let canonicalEmptyEntryDefinitionBytes: int32 = 32
    let tagOffset = current.len - trailingTypeArenaAtomBytes -
        canonicalEmptyCleanupAuthorityBytes() -
        canonicalEmptyExternCapabilityBytes -
        canonicalEmptyEntryDefinitionBytes
    assert(tagOffset >= 8, "codec attack entry definition tag offset")
    var tagCursor = tagOffset
    assert(codec.Backend2CodecReadU32(current, tagCursor) == 15,
           "codec attack entry definition tag missing")
    var externTagCursor = tagOffset + canonicalEmptyEntryDefinitionBytes
    assert(codec.Backend2CodecReadU32(current, externTagCursor) == 16,
           "codec attack extern capability tag missing")
    return tagOffset

fn cleanupColumnOffset(
        current: rawbytes.Bytes,
        domain: int32,
        column: int32): int32 =
    let tagOffset = cleanupAuthorityTagOffset(current)
    let intentFirstColumn =
        tagOffset + 4 + 32 + 2 * 4 + 4 * 32 + 5 * 4
    let scheduleFirstColumn =
        intentFirstColumn + cleanupIntentColumnCount * 4 +
        2 * 4 + 2 * 32
    let replayFirstColumn =
        scheduleFirstColumn + cleanupScheduleColumnCount * 4 +
        2 * 4 + 32
    var offset: int32
    var count: int32
    if domain == 0:
        offset = intentFirstColumn
        count = cleanupIntentColumnCount
    elif domain == 1:
        offset = scheduleFirstColumn
        count = cleanupScheduleColumnCount
    elif domain == 2:
        offset = replayFirstColumn
        count = cleanupReplayColumnCount
    else:
        panic("codec attack cleanup column domain")
    assert(column >= 0 && column < count,
           "codec attack cleanup column ordinal")
    let columnOffset = offset + column * 4
    var cursor = columnOffset
    assert(codec.Backend2CodecReadU32(current, cursor) == 0,
           "codec attack canonical empty cleanup column")
    return columnOffset

fn attackBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    let parsed = layout.FixedBytes32FromHex(
        "8888888888888888888888888888888888888888888888888888888888888888")
    assert(IsOk(parsed), "codec attack TypeArena CID fixture")
    assert(ir.BodyIRBindTypeArenaArtifactCid(body, Value(parsed)),
           "codec attack TypeArena CID bind")
    return body

fn main(): int32 =
    let mode = os.GetEnv("CHENG_CODEC_ATTACK")
    if mode == "old-fragment-header":
        var fragment: b2t.FunctionFragment
        var current = codec.Backend2FragmentEncode(fragment)
        var oldPayload = insertHeaderWord(current, 3)
        var cursor: int32
        let _ = codec.Backend2FragmentDecode(oldPayload, cursor)
    elif mode == "old-body-header":
        var body = attackBody()
        var current = codec.Backend2BodyIrEncode(body)
        codec.Backend2CodecPutU32(current, 4, 17)
        var cursor: int32
        let _ = codec.Backend2BodyIrDecode(current, cursor)
    elif mode == "old-body-magic":
        var body = attackBody()
        var current = codec.Backend2BodyIrEncode(body)
        codec.Backend2CodecPutU32(current, 0, 0x42424955)
        var cursor: int32
        let _ = codec.Backend2BodyIrDecode(current, cursor)
    elif mode == "body-binding-domain-missing":
        var body = attackBody()
        var current = codec.Backend2BodyIrEncode(body)
        let domainStartOffset = entryDefinitionTagOffset(current) + 20
        var missingStart = deleteWordAt(current, domainStartOffset)
        var missingDomain = deleteWordAt(missingStart, domainStartOffset)
        var cursor: int32
        let _ = codec.Backend2BodyIrDecode(missingDomain, cursor)
    elif mode == "body-binding-domain-start":
        var body = attackBody()
        var current = codec.Backend2BodyIrEncode(body)
        codec.Backend2CodecPutU32(
            current, entryDefinitionTagOffset(current) + 20, -1)
        var cursor: int32
        let _ = codec.Backend2BodyIrDecode(current, cursor)
    elif mode == "body-binding-domain-count":
        var body = attackBody()
        var current = codec.Backend2BodyIrEncode(body)
        codec.Backend2CodecPutU32(
            current, entryDefinitionTagOffset(current) + 24, -1)
        var cursor: int32
        let _ = codec.Backend2BodyIrDecode(current, cursor)
    elif mode == "body-binding-domain-overflow":
        var body = attackBody()
        var current = codec.Backend2BodyIrEncode(body)
        let tagOffset = entryDefinitionTagOffset(current)
        codec.Backend2CodecPutU32(current, tagOffset + 20, 2147483647)
        codec.Backend2CodecPutU32(current, tagOffset + 24, 1)
        var cursor: int32
        let _ = codec.Backend2BodyIrDecode(current, cursor)
    elif mode == "fragment-truncated":
        var fragment: b2t.FunctionFragment
        var current = codec.Backend2FragmentEncode(fragment)
        let truncated = rawbytes.BytesSliceView(current, 0, current.len - 1)
        var cursor: int32
        let _ = codec.Backend2FragmentDecode(truncated, cursor)
    elif mode == "body-truncated":
        var body = attackBody()
        var current = codec.Backend2BodyIrEncode(body)
        let truncated = rawbytes.BytesSliceView(current, 0, current.len - 1)
        var cursor: int32
        let _ = codec.Backend2BodyIrDecode(truncated, cursor)
    elif mode == "body-debug-function":
        var body = attackBody()
        var current = codec.Backend2BodyIrEncode(body)
        codec.Backend2CodecPutU32(current, 76, 17)
        var cursor: int32
        let _ = codec.Backend2BodyIrDecode(current, cursor)
    elif mode == "cleanup-intent-column-truncated":
        var body = attackBody()
        var current = codec.Backend2BodyIrEncode(body)
        let columnOffset = cleanupColumnOffset(current, 0, 0)
        let truncated = rawbytes.BytesSliceView(
            current, 0, columnOffset + 3)
        var cursor: int32
        let _ = codec.Backend2BodyIrDecode(truncated, cursor)
    elif mode == "cleanup-schedule-column-inserted":
        var body = attackBody()
        var current = codec.Backend2BodyIrEncode(body)
        let columnOffset = cleanupColumnOffset(current, 1, 18)
        var inserted = insertWordAt(current, columnOffset, 0)
        var cursor: int32
        let _ = codec.Backend2BodyIrDecode(inserted, cursor)
    elif mode == "cleanup-replay-column-deleted":
        var body = attackBody()
        var current = codec.Backend2BodyIrEncode(body)
        let columnOffset = cleanupColumnOffset(current, 2, 0)
        var deleted = deleteWordAt(current, columnOffset)
        var cursor: int32
        let _ = codec.Backend2BodyIrDecode(deleted, cursor)
    elif mode == "cleanup-intent-column-length":
        var body = attackBody()
        var current = codec.Backend2BodyIrEncode(body)
        let columnOffset = cleanupColumnOffset(current, 0, 0)
        codec.Backend2CodecPutU32(current, columnOffset, 1)
        var cursor: int32
        let _ = codec.Backend2BodyIrDecode(current, cursor)
    else:
        return 2
    return 3
