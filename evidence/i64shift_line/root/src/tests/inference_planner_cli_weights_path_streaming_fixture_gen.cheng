import std/result
import std/os
import std/rawbytes
import std/strings
import std/strutils as strutil
import cheng/inference/kernel_ir as kir
import cheng/inference/model_graph as mg
import cheng/inference/hf_model_graph as hfgraph

# 小优 S5: 为 streaming vs non-streaming 峰值内存对比生成一份够大的合成
# safetensors 夹具 (~48MB, 量级对齐历史声称的 "44MB"), 让文件读入方式的内存
# 差异跳出进程基线噪声。维度公式见同批 verdict 文档的推导, 与
# inference_planner_cli_weights_path_smoke.cheng 的极小 (~3.5KB) 夹具是两条
# 独立产物, 不覆盖彼此的 /tmp 文件。

fn fixtureConfigJson(): str =
    return strutil.Join([
        "{",
        "\"architectures\":[\"Qwen2ForCausalLM\"],",
        "\"model_type\":\"qwen2\",",
        "\"vocab_size\":640,",
        "\"hidden_size\":640,",
        "\"num_hidden_layers\":6,",
        "\"num_attention_heads\":8,",
        "\"num_key_value_heads\":8,",
        "\"intermediate_size\":1280,",
        "\"tie_word_embeddings\":false,",
        "\"rope_theta\":10000.0",
        "}"
    ], "")

fn writeU64LE(buf: var rawbytes.Bytes, offset: int32, value: int64) =
    rawbytes.BytesSet(buf, offset, int32(value & int64(255)))
    rawbytes.BytesSet(buf, offset + 1, int32((value >> 8) & int64(255)))
    rawbytes.BytesSet(buf, offset + 2, int32((value >> 16) & int64(255)))
    rawbytes.BytesSet(buf, offset + 3, int32((value >> 24) & int64(255)))
    rawbytes.BytesSet(buf, offset + 4, int32((value >> 32) & int64(255)))
    rawbytes.BytesSet(buf, offset + 5, int32((value >> 40) & int64(255)))
    rawbytes.BytesSet(buf, offset + 6, int32((value >> 48) & int64(255)))
    rawbytes.BytesSet(buf, offset + 7, int32((value >> 56) & int64(255)))

fn writeF16LE(buf: var rawbytes.Bytes, offset: int32, raw: int32) =
    rawbytes.BytesSet(buf, offset, raw & 255)
    rawbytes.BytesSet(buf, offset + 1, (raw >> 8) & 255)

# Same F16 cycle + element0 sentinel as inference_planner_cli_weights_path_smoke.
fn fixtureF16RawAt(elementIndex: int32): int32 =
    if elementIndex == 0:
        return 0x44ff
    let slot = elementIndex % 6
    if slot == 0:
        return 0x3c00
    if slot == 1:
        return 0xbc00
    if slot == 2:
        return 0x3800
    if slot == 3:
        return 0x0000
    if slot == 4:
        return 0x4000
    return 0xc000

fn fixtureShapeJson(shape: int32[]): str =
    var parts: str[]
    for i in 0..<shape.len:
        add(parts, strings.IntToStr(shape[i]))
    return strutil.Join(["[", strutil.Join(parts, ","), "]"], "")

fn fixtureTotalDataBytes(graph: mg.ModelGraph): int64 =
    var total: int64
    for i in 0..<graph.weights.len:
        total = total + graph.weights[i].sizeBytes
    return total

fn fixtureHeader(graph: mg.ModelGraph): str =
    var parts: str[]
    var cursor: int64
    for i in 0..<graph.weights.len:
        let start = cursor
        let end = cursor + graph.weights[i].sizeBytes
        add(parts, strutil.Join([
            "\"",
            graph.weights[i].tensorName,
            "\":{\"dtype\":\"F16\",\"shape\":",
            fixtureShapeJson(graph.weights[i].shape),
            ",\"data_offsets\":[",
            strings.Int64ToStr(start),
            ",",
            strings.Int64ToStr(end),
            "]}"
        ], ""))
        cursor = cursor + graph.weights[i].sizeBytes
    return strutil.Join(["{", strutil.Join(parts, ","), "}"], "")

fn fixtureSerializeGraph(graph: mg.ModelGraph): rawbytes.Bytes =
    let header = fixtureHeader(graph)
    let headerBytes = rawbytes.BytesFromString(header)
    let totalData = int32(fixtureTotalDataBytes(graph))
    let outLen = 8 + rawbytes.BytesLen(headerBytes) + totalData
    var out = rawbytes.BytesAlloc(outLen)
    writeU64LE(out, 0, int64(rawbytes.BytesLen(headerBytes)))
    rawbytes.BytesCopyInto(out, 8, headerBytes)
    let dataBase = 8 + rawbytes.BytesLen(headerBytes)
    var cursor: int32
    var elementOrdinal: int32
    for i in 0..<graph.weights.len:
        let tensorBytes = int32(graph.weights[i].sizeBytes)
        var j: int32
        while j < tensorBytes:
            writeF16LE(out, dataBase + cursor + j, fixtureF16RawAt(elementOrdinal))
            j = j + 2
            elementOrdinal = elementOrdinal + 1
        cursor = cursor + tensorBytes
    return out

fn main(): int32 =
    let graphRes = hfgraph.HfModelGraphBuildDenseTransformerFromConfig(
        fixtureConfigJson(),
        "cid:model:xiaoyou-planner-cli-streaming-fixture",
        kir.KernelDtypeFp16,
        mg.ModelQuantSchemeNone
    )
    assert(IsOk(graphRes), " streaming fixture gen: build graph")
    let graph = Value(graphRes)
    assert(IsOk(mg.ModelGraphValidate(graph)), " streaming fixture gen: graph valid")

    let configPath = "/tmp/cheng_planner_cli_weights_path_streaming_smoke_config.json"
    let weightsPath = "/tmp/cheng_planner_cli_weights_path_streaming_smoke.safetensors"
    if os.FileExists(configPath):
        assert(os.RemoveFile(configPath), " streaming fixture gen: remove old config")
    if os.FileExists(weightsPath):
        assert(os.RemoveFile(weightsPath), " streaming fixture gen: remove old weights")

    let configWrite = os.WriteFileResult(configPath, fixtureConfigJson())
    assert(IsOk(configWrite), " streaming fixture gen: write config")

    var writeBytes = fixtureSerializeGraph(graph)
    let weightsWrite = os.WriteFileBytesResult(weightsPath, writeBytes)
    assert(IsOk(weightsWrite), " streaming fixture gen: write weights")
    assert(os.FileExists(configPath) && os.FileExists(weightsPath),
           " streaming fixture gen: fixture files exist")

    echo(strutil.Join(["graph_weights: ", strings.IntToStr(graph.weights.len)], ""))
    echo(strutil.Join(["graph_ops: ", strings.IntToStr(graph.ops.len)], ""))
    echo(strutil.Join(["weights_bytes: ", strings.Int64ToStr(fixtureTotalDataBytes(graph))], ""))
    echo(strutil.Join(["config_path: ", configPath], ""))
    echo(strutil.Join(["weights_path: ", weightsPath], ""))
    echo("inference_planner_cli_weights_path_streaming_fixture_gen ok")
    return 0
