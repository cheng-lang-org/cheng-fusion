import std/result
import cheng/core/tooling/compiler_request as creq
import cheng/core/tooling/path as chengpath
import cheng/core/tooling/compiler_world as cworld
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/backend/system_link_plan as slplan
import cheng/core/lang/parser
import cheng/core/lang/typed_expr as texpr
import std/strutils as strutil

fn buildOracleLayer(workspaceRoot: str,
                    packageRoot: str,
                    linkPlan: slplan.SystemLinkPlanStub,
                    label: str): parser.NormalizedExprLayer =
    let externalPackageRoots = slplan.SystemLinkPlanExternalPackageRoots(linkPlan)
    var oracleLayer: parser.NormalizedExprLayer
    var parseErr = ""
    assert(parser.ParserReadNormalizedExprLayerForSourceClosureWithExternalPackageRoots(workspaceRoot,
                                                                                        packageRoot,
                                                                                        externalPackageRoots,
                                                                                        linkPlan.sourceClosurePaths,
                                                                                        oracleLayer,
                                                                                        parseErr),
           strutil.Join([label, " oracle layer ", parseErr], ""))
    return oracleLayer

fn buildOracleFacts(workspaceRoot: str,
                    packageRoot: str,
                    linkPlan: slplan.SystemLinkPlanStub,
                    oracleLayer: var parser.NormalizedExprLayer,
                    sourceContexts: var texpr.TypedExprSourceContext[],
                    label: str): ccsg.TypedExprFactTable =
    let externalPackageRoots = slplan.SystemLinkPlanExternalPackageRoots(linkPlan)
    var sourceTexts: texpr.TypedExprSourceText[]
    sourceContexts = []
    for i in 0..<linkPlan.sourceClosurePaths.len:
        let sourcePath = linkPlan.sourceClosurePaths[i]
        let sourceText = chengpath.ReadTextFile("", sourcePath)
        let typedSource = texpr.TypedExprSourceTextNewWithExternalPackageRoots(workspaceRoot,
                                                                               packageRoot,
                                                                               externalPackageRoots,
                                                                               sourcePath,
                                                                               sourceText)
        add(sourceTexts, typedSource)
        var sourceContext: texpr.TypedExprSourceContext
        var sourceContextErr = ""
        assert(texpr.TypedExprBuildSourceContext(typedSource, sourceContext, sourceContextErr),
               strutil.Join([label, " source context ", sourceContextErr], ""))
        add(sourceContexts, sourceContext)
    assert(sourceTexts.len == linkPlan.sourceClosurePaths.len,
           strutil.Join([label, " source closure"], ""))
    assert(sourceContexts.len == linkPlan.sourceClosurePaths.len,
           strutil.Join([label, " metadata contexts"], ""))
    oracleLayer = buildOracleLayer(workspaceRoot, packageRoot, linkPlan, label)
    var factsLayer = parser.NormalizedExprLayerClone(oracleLayer)
    var oracleFacts: ccsg.TypedExprFactTable
    var oracleErr = ""
    assert(texpr.TypedExprBuildFactsWithMetadataContexts(sourceTexts,
                                                         factsLayer,
                                                         sourceContexts,
                                                         oracleFacts,
                                                         oracleErr),
           strutil.Join([label, " oracle facts ", oracleErr], ""))
    for i in 0..<sourceTexts.len:
        texpr.TypedExprClearSourceTextAllFields(sourceTexts[i])
    return oracleFacts

fn main(): int32 =
    let workspaceRoot = chengpath.PathCurrentDir()
    let packageRoot = workspaceRoot
    let fixturePath = chengpath.PathJoin(packageRoot, "src/tests/typed_expr_fact_fixture.cheng")
    let outputPath = chengpath.PathJoin(workspaceRoot, "artifacts/compiler_csg/typed_expr_call_validate_probe")
    let req = creq.CompilerRequestNew(packageRoot, fixturePath, outputPath, "arm64-apple-darwin", creq.EmitShared, "")
    var linkPlan: slplan.SystemLinkPlanStub
    var err = ""
    assert(slplan.BuildSystemLinkPlanStub(workspaceRoot, req, linkPlan, err), "typed expr call validate probe: link plan")
    let sourceBundleRes = slplan.SystemLinkPlanSourceBundleCid(linkPlan)
    assert(IsOk(sourceBundleRes), "typed expr call validate probe: source bundle")
    let sourceBundleCid = Value(sourceBundleRes)
    let csgRes = ccsg.BuildCompilerCsg(linkPlan, sourceBundleCid)
    assert(IsOk(csgRes), "typed expr call validate probe: build csg")
    let csg = ccsg.CompilerCsgClone(Value(csgRes))
    var oracleLayer: parser.NormalizedExprLayer
    var sourceContexts: texpr.TypedExprSourceContext[]
    var oracleFacts = buildOracleFacts(workspaceRoot,
                                       packageRoot,
                                       linkPlan,
                                       oracleLayer,
                                       sourceContexts,
                                       "typed expr call validate probe")
    assert(csg.typedExprFacts.count == 0,
           "typed expr call validate probe: legacy facts released")
    assert(oracleFacts.count == csg.typedExprFactCountSnapshot,
           "typed expr call validate probe: fact snapshot")
    assert(oracleFacts.count == oracleLayer.exprs.len,
           "typed expr call validate probe: fact order")
    var resolvedCallCount: int32
    for i in 0..<oracleFacts.count:
        let fact = texpr.TypedExprFactAt(oracleFacts, i)
        if fact.lineNumber > 0 && fact.callResolved && fact.callTarget != "":
            resolvedCallCount = resolvedCallCount + 1
    assert(csg.semanticGraph.resolvedCallTable.sourcePathIds.len == resolvedCallCount,
           "typed expr call validate probe: resolved call snapshot")
    var callErr = ""
    var validateLayer = parser.NormalizedExprLayerClone(oracleLayer)
    var validateFacts = oracleFacts
    let ok = texpr.TypedExprFactsValidateCallResolution(validateLayer, sourceContexts, validateFacts, callErr)
    echo(strutil.Join(["validate_ok=", (if ok: "1" else: "0")], ""))
    echo(strutil.Join(["validate_err=", callErr], ""))
    for i in 0..<oracleLayer.exprs.len:
        let expr = oracleLayer.exprs[i]
        if expr.kind != parser.NormalizedExprCall:
            continue
        let fact = texpr.TypedExprFactAt(oracleFacts, i)
        echo(strutil.Join(["line=", IntToStr(expr.lineNumber), " kind=", parser.ParserCallSurfaceKindText(expr.callSurfaceKind), " resolved=", (if expr.callResolved: "1" else: "0"), " reason=", parser.ParserCallReasonText(expr.callReason), " target_source=", expr.callTargetSourcePath, " target_importc=", (if expr.callTargetImportc: "1" else: "0"), " type=", fact.typeText, " abi=", texpr.TypedExprAbiClassText(fact.abiClass), " lower=", texpr.TypedExprLoweringModeText(fact.loweringMode), " ret=", texpr.TypedExprReturnKindText(fact.returnKind)], ""))
    return 0
