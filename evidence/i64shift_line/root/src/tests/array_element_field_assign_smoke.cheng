import std/system

type
    Inner =
        score: int32

    Item =
        value: int32
        tail: int32
        inner: Inner

    Box =
        items: Item[]
        marks: int32[]

fn main(): int32 =
    var items: Item[]
    add(items, Item(value: 1, tail: 2, inner: Inner(score: 3)))
    add(items, Item(value: 4, tail: 5, inner: Inner(score: 6)))
    items[0].value = 7
    items[0].inner.score = 8
    assert(items[0].value == 7, " array element field assign: direct value")
    assert(items[0].tail == 2, " array element field assign: direct tail preserved")
    assert(items[0].inner.score == 8, " array element field assign: nested object field")

    var dynIndex: int32 = 1
    items[dynIndex].value = 17
    items[dynIndex].inner.score = 19
    assert(items[0].value == 7, " array element field assign: dynamic index head preserved")
    assert(items[1].value == 17, " array element field assign: dynamic index value")
    assert(items[1].tail == 5, " array element field assign: dynamic index tail preserved")
    assert(items[1].inner.score == 19, " array element field assign: dynamic index nested object field")

    var fixedItems: Item[2]
    fixedItems[0].value = 21
    fixedItems[0].tail = 22
    fixedItems[0].inner.score = 23
    fixedItems[1].value = 24
    fixedItems[1].tail = 25
    fixedItems[1].inner.score = 26
    var fixedIndex: int32 = 1
    fixedItems[fixedIndex].value = 31
    fixedItems[fixedIndex].inner.score = 33
    assert(fixedItems[0].value == 21, " array element field assign: fixed head preserved")
    assert(fixedItems[1].value == 31, " array element field assign: fixed dynamic index value")
    assert(fixedItems[1].tail == 25, " array element field assign: fixed dynamic index tail preserved")
    assert(fixedItems[1].inner.score == 33, " array element field assign: fixed dynamic index nested object field")

    var box = Box()
    add(box.items, Item(value: 3, tail: 4, inner: Inner(score: 5)))
    add(box.marks, 11)
    box.items[0].tail = 9
    assert(box.items[0].value == 3, " array element field assign: field sequence value preserved")
    assert(box.items[0].tail == 9, " array element field assign: field sequence tail")
    assert(box.marks[0] == 11, " array element field assign: sibling sequence preserved")
    echo(" array_element_field_assign_smoke ok")
    return 0
