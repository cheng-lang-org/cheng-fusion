# CSG 场景流容器 StreamManifest v1 冒烟。
#
# 手工逐字段构造 manifest 字节 (BytesBuilder 小端写入), 断言: 解析、按时间
# 定位 (t=0 / chunk 末尾 / 间隙 / t=末尾)、关键帧 seek (含 t 早于首关键帧)、
# 非法输入 (坏 magic / 坏版本 / 截断 / 越界 / 乱序 / 尾部垃圾等) 全部显式
# false 且状态复位。合法夹具: 4 chunk, 关键帧 [1,0,0,1], 间隙 150..200 与
# 300..400, 总时长 500ms。
import std/strings
import std/rawbytes
import cheng/game/assets/stream/manifest

fn SsPutByte(b: var BytesBuilder, v: int32) =
    rawbytes.BytesBuilderAppendByte(b, v)

# u32 小端 4 字节。
fn SsPutU32(b: var BytesBuilder, v: int64) =
    rawbytes.BytesBuilderAppendByte(b, int32(v % int64(256)))
    rawbytes.BytesBuilderAppendByte(b, int32((v / int64(256)) % int64(256)))
    rawbytes.BytesBuilderAppendByte(b, int32((v / int64(65536)) % int64(256)))
    rawbytes.BytesBuilderAppendByte(b, int32((v / int64(16777216)) % int64(256)))

# i64 小端 8 字节 = 低位 u32 + 高位 u32。
fn SsPutI64(b: var BytesBuilder, v: int64) =
    var hi: int64
    hi = v / int64(4294967296)
    SsPutU32(b, v % int64(4294967296))
    SsPutU32(b, hi)

fn SsPutStr(b: var BytesBuilder, s: str) =
    for i in 0..<len(s):
        rawbytes.BytesBuilderAppendByte(b, Int32(s[i]))

# 64 字符小写 hex (数字) 内容 CID。
fn SsCid(seed: int32): str =
    var parts: str[]
    for i in 0..<64:
        add(parts, strings.IntToStr((seed + i) % 10))
    var out: str
    for k in 0..<parts.len:
        out = out + parts[k]
    return out

# mode: 0=合法; 1=坏magic; 2=坏版本; 3=零chunk; 4=坏isKeyframe;
# 5=cidLen声明错误; 6=乱序重叠; 7=payload越界; 8=尾部垃圾;
# 9=合法但全部关键帧在首chunk; 10=合法无音轨; 11=合法但首关键帧在末chunk。
fn SsBuildManifest(mode: int32): rawbytes.Bytes =
    var b = rawbytes.BytesBuilderNew(0)
    if mode == 1:
        SsPutStr(b, "XSM1")
    else:
        SsPutStr(b, "SSM1")
    if mode == 2:
        SsPutU32(b, int64(9))
    else:
        SsPutU32(b, int64(1))
    if mode == 3:
        SsPutU32(b, int64(0))
    else:
        SsPutU32(b, int64(4))
    # chunk0: [0,100) kf=1
    SsPutI64(b, int64(0))
    SsPutI64(b, int64(100))
    if mode == 4:
        SsPutByte(b, 2)
    else:
        if mode == 11:
            SsPutByte(b, 0)
        else:
            SsPutByte(b, 1)
    SsPutU32(b, int64(64))
    if mode == 5:
        SsPutStr(b, SsCid(0))
        SsPutByte(b, 0)
    else:
        SsPutStr(b, SsCid(0))
    if mode == 7:
        SsPutI64(b, int64(999999999))
        SsPutI64(b, int64(1000000))
    else:
        SsPutI64(b, int64(8))
        SsPutI64(b, int64(0))
    # chunk1: [100,150) kf=0
    SsPutI64(b, int64(100))
    SsPutI64(b, int64(50))
    SsPutByte(b, 0)
    SsPutU32(b, int64(64))
    SsPutStr(b, SsCid(1))
    SsPutI64(b, int64(8))
    SsPutI64(b, int64(0))
    # chunk2: [200,300) kf=0 (mode6: start=120 与 chunk1 重叠)
    if mode == 6:
        SsPutI64(b, int64(120))
    else:
        SsPutI64(b, int64(200))
    SsPutI64(b, int64(100))
    SsPutByte(b, 0)
    SsPutU32(b, int64(64))
    SsPutStr(b, SsCid(2))
    SsPutI64(b, int64(8))
    SsPutI64(b, int64(0))
    # chunk3: [400,500) kf=1 (mode9: kf=0 => 关键帧全在首 chunk)
    SsPutI64(b, int64(400))
    SsPutI64(b, int64(100))
    if mode == 9:
        SsPutByte(b, 0)
    else:
        SsPutByte(b, 1)
    SsPutU32(b, int64(64))
    SsPutStr(b, SsCid(3))
    SsPutI64(b, int64(8))
    SsPutI64(b, int64(0))
    # 末尾 audioTrackRef
    if mode == 10:
        SsPutU32(b, int64(0))
    else:
        SsPutU32(b, int64(64))
        SsPutStr(b, SsCid(9))
    if mode == 8:
        SsPutByte(b, 0)
    return rawbytes.BytesBuilderFinish(b)

# 内嵌 payload 形态 (task_ssm1_pack.md §3)。
# mode: 0=合法; 1=chunk1 offset 破坏相接; 2=末 chunk 截 1 字节。
# 4 chunk [i*100, +100) 全关键帧, payload len 4/5/6/7, manifest 区
# 12+4*101+68=484 (含音轨), 总文件 506 字节。
fn SsBuildEmbedded(mode: int32): rawbytes.Bytes =
    var b = rawbytes.BytesBuilderNew(0)
    SsPutStr(b, "SSM1")
    SsPutU32(b, int64(1))
    SsPutU32(b, int64(4))
    var off: int64
    off = int64(12 + 4 * 101 + 68)
    for i in 0..<4:
        SsPutI64(b, int64(i) * int64(100))
        SsPutI64(b, int64(100))
        SsPutByte(b, 1)
        SsPutU32(b, int64(64))
        SsPutStr(b, SsCid(i))
        SsPutI64(b, int64(4 + i))
        if mode == 1 && i == 1:
            SsPutI64(b, off - int64(1))
        else:
            SsPutI64(b, off)
        off = off + int64(4 + i)
    SsPutU32(b, int64(64))
    SsPutStr(b, SsCid(9))
    for i in 0..<4:
        var n: int32
        n = 4 + i
        for k in 0..<n:
            SsPutByte(b, Int32('A') + i)
    var data = rawbytes.BytesBuilderFinish(b)
    if mode == 2:
        let cut: int32 = rawbytes.BytesLen(data) - 1
        var sliced = rawbytes.BytesSlice(data, 0, cut)
        rawbytes.BytesFree(data)
        return sliced
    return data

@borrows
fn SsCheckIndex(m: manifest.StreamManifest, t: int64, want: int32, label: str) =
    let got = manifest.StreamManifestChunkIndexForTime(m, t)
    assert(got == want, Fmt"{label}: got={got} want={want}")
    echo(Fmt"PASS {label} (t={t} -> chunk {got})")

@borrows
fn SsCheckKeyframe(m: manifest.StreamManifest, t: int64, want: int32,
                   label: str) =
    let got = manifest.StreamManifestNearestKeyframeIndexForTime(m, t)
    assert(got == want, Fmt"{label}: got={got} want={want}")
    echo(Fmt"PASS {label} (t={t} -> keyframe {got})")

@borrows
fn SsCheckRejectMode(mode: int32, label: str) =
    var data = SsBuildManifest(mode)
    var mm: manifest.StreamManifest
    let ok = manifest.StreamManifestParse(data, mm)
    rawbytes.BytesFree(data)
    assert(!ok, Fmt"{label}: unexpectedly parsed")
    assert(!mm.ok && mm.chunkCount == 0, Fmt"{label}: state not reset")
    echo(Fmt"PASS {label} rejected")

fn main(): int32 =
    var valid = SsBuildManifest(0)

    # 解析 + 派生字段。
    var m: manifest.StreamManifest
    assert(manifest.StreamManifestParse(valid, m), "valid manifest parses")
    echo("PASS parse valid manifest")
    assert(m.ok, "ok flag set")
    assert(manifest.StreamManifestChunkCount(m) == 4, "chunk count = 4")
    assert(manifest.StreamManifestTotalDurationMs(m) == int64(500),
        "total duration 500")
    assert(m.audioCid == SsCid(9), "audio track cid")
    echo("PASS header and derived fields")

    # ChunkAt 往返。
    var expStart: int64[]
    add(expStart, int64(0))
    add(expStart, int64(100))
    add(expStart, int64(200))
    add(expStart, int64(400))
    var expDur: int64[]
    add(expDur, int64(100))
    add(expDur, int64(50))
    add(expDur, int64(100))
    add(expDur, int64(100))
    var expKf: int32[]
    add(expKf, 1)
    add(expKf, 0)
    add(expKf, 0)
    add(expKf, 1)
    var c: manifest.StreamChunk
    for i in 0..<4:
        assert(manifest.StreamManifestChunkAt(m, i, c), "chunk at in range")
        assert(c.index == i, "chunk index roundtrip")
        assert(c.startMs == expStart[i], "chunk start roundtrip")
        assert(c.durationMs == expDur[i], "chunk duration roundtrip")
        assert(c.isKeyframe == (expKf[i] == 1), "chunk keyframe roundtrip")
        assert(c.cid == SsCid(i), "chunk cid roundtrip")
        assert(c.payloadLen == int64(8) && c.payloadOffset == int64(0),
            "chunk payload range roundtrip")
    echo("PASS chunk at roundtrip x4")
    assert(!manifest.StreamManifestChunkAt(m, 4, c), "chunk at >= count rejected")
    assert(!manifest.StreamManifestChunkAt(m, -1, c), "chunk at negative rejected")
    echo("PASS chunk at out-of-range rejected")

    # 按时间定位: 边界 t=0 / chunk 末尾 / 间隙 / t=末尾 / 越过末尾。
    SsCheckIndex(m, int64(-1), -1, "locate before stream start")
    SsCheckIndex(m, int64(0), 0, "locate t=0")
    SsCheckIndex(m, int64(99), 0, "locate inside chunk0")
    SsCheckIndex(m, int64(100), 1, "locate chunk1 start boundary")
    SsCheckIndex(m, int64(150), 1, "locate chunk1 end boundary")
    SsCheckIndex(m, int64(175), 1, "locate inside gap holds chunk1")
    SsCheckIndex(m, int64(199), 1, "locate gap end holds chunk1")
    SsCheckIndex(m, int64(200), 2, "locate gap exit enters chunk2")
    SsCheckIndex(m, int64(399), 2, "locate gap 300..400 holds chunk2")
    SsCheckIndex(m, int64(400), 3, "locate chunk3 start boundary")
    SsCheckIndex(m, int64(499), 3, "locate inside chunk3")
    SsCheckIndex(m, int64(500), 3, "locate t=stream end holds last chunk")
    SsCheckIndex(m, int64(100000), 3, "locate beyond end clamps to last")

    # 关键帧 seek: <=t 的最近关键帧。
    SsCheckKeyframe(m, int64(0), 0, "seek t=0 keyframe")
    SsCheckKeyframe(m, int64(100), 0, "seek non-keyframe chunk keeps kf0")
    SsCheckKeyframe(m, int64(150), 0, "seek boundary keeps kf0")
    SsCheckKeyframe(m, int64(250), 0, "seek gap keeps kf0")
    SsCheckKeyframe(m, int64(399), 0, "seek just before kf3 keeps kf0")
    SsCheckKeyframe(m, int64(400), 3, "seek lands on kf3")
    SsCheckKeyframe(m, int64(500), 3, "seek at end keeps kf3")

    # t 早于首关键帧 (mode11: 关键帧仅在 chunk3) => 显式 -1。
    var mLate: manifest.StreamManifest
    var lateBytes = SsBuildManifest(11)
    assert(manifest.StreamManifestParse(lateBytes, mLate), "late-kf parses")
    rawbytes.BytesFree(lateBytes)
    SsCheckKeyframe(mLate, int64(0), -1, "seek before first keyframe")
    SsCheckKeyframe(mLate, int64(150), -1, "seek mid gap before first kf")
    SsCheckKeyframe(mLate, int64(399), -1, "seek just before only kf")
    SsCheckKeyframe(mLate, int64(400), 3, "late seek finds only kf")

    # 合法变体: 无音轨 / 关键帧全在首 chunk。
    var mNoAudio: manifest.StreamManifest
    var noAudioBytes = SsBuildManifest(10)
    assert(manifest.StreamManifestParse(noAudioBytes, mNoAudio),
        "no-audio manifest parses")
    rawbytes.BytesFree(noAudioBytes)
    assert(mNoAudio.audioCid == "", "no audio track = empty cid")
    echo("PASS no-audio manifest")
    var mEarly: manifest.StreamManifest
    var earlyBytes = SsBuildManifest(9)
    assert(manifest.StreamManifestParse(earlyBytes, mEarly),
        "early-kf manifest parses")
    rawbytes.BytesFree(earlyBytes)
    SsCheckKeyframe(mEarly, int64(500), 0, "all keyframes at chunk0")

    # 非法输入: 全部显式拒绝且状态复位。
    SsCheckRejectMode(1, "bad magic")
    SsCheckRejectMode(2, "bad version")
    SsCheckRejectMode(3, "zero chunks")
    SsCheckRejectMode(4, "bad isKeyframe byte")
    SsCheckRejectMode(5, "cid length mismatch")
    SsCheckRejectMode(6, "unsorted overlapping chunks")
    SsCheckRejectMode(7, "payload range beyond file")
    SsCheckRejectMode(8, "trailing garbage byte")

    # 截断: 切掉尾部的合法字节前缀。
    var truncA = rawbytes.BytesSlice(valid, 0, 20)
    var mt: manifest.StreamManifest
    assert(!manifest.StreamManifestParse(truncA, mt),
        "truncated inside chunk entry rejected")
    rawbytes.BytesFree(truncA)
    echo("PASS truncated manifest rejected (20 bytes)")
    var truncB = rawbytes.BytesSlice(valid, 0, 40)
    assert(!manifest.StreamManifestParse(truncB, mt),
        "truncated inside cid rejected")
    rawbytes.BytesFree(truncB)
    echo("PASS truncated manifest rejected (40 bytes)")

    # 内嵌 payload 形态 (E 线打包器产物形态)。
    var e0 = SsBuildEmbedded(0)
    var me: manifest.StreamManifest
    assert(manifest.StreamManifestParseEmbedded(e0, me), "embedded parses")
    echo("PASS embedded manifest parses")
    assert(manifest.StreamManifestChunkCount(me) == 4, "embedded count = 4")
    assert(manifest.StreamManifestChunkIndexForTime(me, int64(250)) == 2,
        "embedded locate mid")
    assert(manifest.StreamManifestNearestKeyframeIndexForTime(me, int64(250)) == 2,
        "embedded kf seek")
    var ec: manifest.StreamChunk
    assert(manifest.StreamManifestChunkAt(me, 2, ec), "embedded chunk at")
    assert(ec.payloadLen == int64(6), "embedded payload len roundtrip")
    assert(ec.payloadOffset == int64(493), "embedded payload offset roundtrip")
    echo("PASS embedded payload tiling roundtrip")
    assert(!manifest.StreamManifestParse(e0, me),
        "manifest-only parse rejects embedded tail")
    echo("PASS manifest-only parse rejects embedded form")
    assert(!manifest.StreamManifestParseEmbedded(valid, me),
        "embedded parse rejects manifest-only form")
    echo("PASS embedded parse rejects manifest-only form")
    rawbytes.BytesFree(e0)
    var e1 = SsBuildEmbedded(1)
    assert(!manifest.StreamManifestParseEmbedded(e1, me),
        "embedded overlap offset rejected")
    rawbytes.BytesFree(e1)
    echo("PASS embedded broken tiling rejected")
    var e2 = SsBuildEmbedded(2)
    assert(!manifest.StreamManifestParseEmbedded(e2, me),
        "embedded short tail rejected")
    rawbytes.BytesFree(e2)
    echo("PASS embedded truncated payload rejected")

    rawbytes.BytesFree(valid)
    echo("csg_scene_stream_smoke ALL PASS")
    return 0
