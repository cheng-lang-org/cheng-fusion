import std/cmdline
import std/os
import std/rawbytes
import std/result
import std/strings
import std/crypto/hash256
import cheng/std/bytes_layout as layout
import cheng/core/tooling/path as chengpath
import cheng/core/tooling/compiler_request as creq
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/backend/system_link_plan as slplan
import cheng/core/backend/system_link_exec as sexec
import std/strutils as strutil

fn CidEvidenceJoin(parts: str[]): str =
    return strutil.Join(parts, "")

@borrows
fn CidEvidenceWrite(root: str,
                    relativePath: str,
                    text: str,
                    files: var str[]) =
    let absolute = chengpath.PathJoin(root, relativePath)
    let parent = chengpath.PathParentDir(absolute)
    if parent != "":
        os.MkdirAll(parent, 493)
    os.WriteFile(absolute, text)
    add(files, strings.CloneStr(relativePath))

@borrows
fn CidEvidenceWriteBytes(root: str,
                         relativePath: str,
                         bytes: var Bytes,
                         files: var str[]): Result[bool] =
    let absolute = chengpath.PathJoin(root, relativePath)
    let parent = chengpath.PathParentDir(absolute)
    if parent != "":
        os.MkdirAll(parent, 493)
    let writeRes = os.WriteFileBytesResult(absolute, bytes)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    add(files, strings.CloneStr(relativePath))
    return Ok[bool](true)

@borrows
fn CidEvidenceSourceReceiptReport(
        receipt: ccsg.PortableSourceIdentityReceipt): str =
    return CidEvidenceJoin([
        "source_snapshot_count=", strings.IntToStr(receipt.sourceSnapshotCount), "\n",
        "import_edge_count=", strings.IntToStr(receipt.importEdgeCount), "\n",
        "unresolved_import_count=", strings.IntToStr(receipt.unresolvedImportCount), "\n",
        "source_package_id_cid=",
        layout.FixedBytes32Hex(receipt.sourcePackageIdCid), "\n",
        "entry_module_path_cid=",
        layout.FixedBytes32Hex(receipt.entryModulePathCid), "\n",
        "source_bundle_cid=",
        layout.FixedBytes32Hex(receipt.sourceBundleCid), "\n",
        "entry_source_cid=",
        layout.FixedBytes32Hex(receipt.entrySourceCid), "\n",
        "import_graph_cid=",
        layout.FixedBytes32Hex(receipt.importGraphCid), "\n",
        "receipt_cid=", layout.FixedBytes32Hex(receipt.receiptCid)])

@borrows
fn CidEvidenceReportValueInto(reportText: str,
                              key: str,
                              out: var str,
                              err: var str): bool =
    let prefix = CidEvidenceJoin([strings.CloneStr(key), "="])
    let lines = strutil.Split(reportText, '\n')
    var found = false
    for lineIndex in 0..<lines.len:
        let line = lines[lineIndex]
        if strutil.StartsWith(line, prefix):
            if found:
                err = CidEvidenceJoin([
                    "CID evidence: duplicate candidate report field: ",
                    strings.CloneStr(key)])
                return false
            if line.len <= prefix.len:
                err = CidEvidenceJoin([
                    "CID evidence: empty candidate report field: ",
                    strings.CloneStr(key)])
                return false
            out = strings.SliceBytes(
                line, prefix.len, line.len - prefix.len)
            found = true
    if !found:
        err = CidEvidenceJoin([
            "CID evidence: missing candidate report field: ",
            strings.CloneStr(key)])
        return false
    err = ""
    return true

@borrows
fn CidEvidenceReportExpect(reportText: str,
                           key: str,
                           expected: str,
                           err: var str): bool =
    var actual: str
    if !CidEvidenceReportValueInto(reportText, key, actual, err):
        return false
    if actual != expected:
        err = CidEvidenceJoin([
            "CID evidence: candidate report binding mismatch: ",
            strings.CloneStr(key)])
        return false
    err = ""
    return true

@borrows
fn CidEvidenceReportFixed32Into(reportText: str,
                                key: str,
                                out: var layout.FixedBytes32,
                                err: var str): bool =
    var value: str
    if !CidEvidenceReportValueInto(reportText, key, value, err):
        return false
    let parsed = layout.FixedBytes32FromHex(value)
    if IsErr(parsed):
        err = CidEvidenceJoin([
            "CID evidence: invalid candidate report fixed32: ",
            strings.CloneStr(key)])
        return false
    out = Value(parsed)
    err = ""
    return true

@borrows
fn CidEvidenceSourceCoreCase(artifactRoot: str,
                             compiledOutput: str,
                             compileReportPath: str,
                             caseRoot: str): Result[bool] =
    let sourcePath = chengpath.PathJoin(caseRoot, "src/main.cheng")
    let request = creq.CompilerRequestNew(
        strings.CloneStr(caseRoot),
        sourcePath,
        strings.CloneStr(compiledOutput),
        "x86_64-unknown-linux-gnu",
        creq.EmitExe,
        "")
    var err: str
    var plan: slplan.SystemLinkPlanStub
    if !slplan.BuildSystemLinkPlanStub(
            strings.CloneStr(caseRoot), request, plan, err):
        return Err[bool](err)
    let sourceBundleRes = slplan.SystemLinkPlanSourceBundleCid(plan)
    if IsErr(sourceBundleRes):
        return Err[bool](Error(sourceBundleRes))
    var compilerCsg: ccsg.CompilerCsg
    if !ccsg.BuildCompilerCsgInto(
            share(plan), Value(sourceBundleRes), compilerCsg, err):
        return Err[bool](err)

    var providers: str[]
    if !sexec.SystemLinkExecCanonicalProviderSetInto(
            plan.providerModules, providers, err):
        return Err[bool](err)
    let canonicalOutputDigest = sexec.SystemLinkExecCanonicalOutputDigest(
        creq.EmitExe,
        plan.symbolVisibility,
        "x86_64-unknown-linux-gnu",
        providers,
        compilerCsg.canonicalGraphCid)
    var semanticReceipt: sexec.CompileSemanticReceipt
    if !sexec.SystemLinkExecCompileSemanticReceiptMakeInto(
            compilerCsg.sourceIdentityReceipt,
            compilerCsg,
            canonicalOutputDigest,
            "x86_64-unknown-linux-gnu",
            "stage3_local",
            providers,
            semanticReceipt,
            err):
        return Err[bool](err)
    let sourceToCsgBindingSeal = sexec.SystemLinkExecSourceToCsgBindingSeal(
        compilerCsg.sourceIdentityReceipt.receiptCid,
        compilerCsg.canonicalGraphCid,
        semanticReceipt.receiptCid)

    let reportReadRes = os.ReadFileResult(compileReportPath)
    if IsErr(reportReadRes):
        return Err[bool](Error(reportReadRes))
    let reportText = Value(reportReadRes)
    if !CidEvidenceReportExpect(
            reportText, "target", "x86_64-unknown-linux-gnu", err) ||
       !CidEvidenceReportExpect(reportText, "emit", "exe", err) ||
       !CidEvidenceReportExpect(
            reportText,
            "source_bundle_cid",
            layout.FixedBytes32Hex(
                compilerCsg.sourceIdentityReceipt.sourceBundleCid),
            err) ||
       !CidEvidenceReportExpect(
            reportText,
            "source_identity_receipt_cid",
            layout.FixedBytes32Hex(
                compilerCsg.sourceIdentityReceipt.receiptCid),
            err) ||
       !CidEvidenceReportExpect(
            reportText,
            "canonical_compiler_csg_cid",
            layout.FixedBytes32Hex(compilerCsg.canonicalGraphCid),
            err) ||
       !CidEvidenceReportExpect(
            reportText,
            "semantic_receipt_cid",
            layout.FixedBytes32Hex(semanticReceipt.receiptCid),
            err) ||
       !CidEvidenceReportExpect(
            reportText,
            "source_to_csg_binding_seal",
            layout.FixedBytes32Hex(sourceToCsgBindingSeal),
            err) ||
       !CidEvidenceReportExpect(
            reportText,
            "compile_receipt_source_identity_receipt_cid",
            layout.FixedBytes32Hex(
                compilerCsg.sourceIdentityReceipt.receiptCid),
            err) ||
       !CidEvidenceReportExpect(
            reportText,
            "compile_receipt_semantic_receipt_cid",
            layout.FixedBytes32Hex(semanticReceipt.receiptCid),
            err) ||
       !CidEvidenceReportExpect(
            reportText,
            "compile_receipt_canonical_output_digest",
            layout.FixedBytes32Hex(canonicalOutputDigest),
            err) ||
       !CidEvidenceReportExpect(
            reportText,
            "compile_receipt_target",
            "x86_64-unknown-linux-gnu",
            err) ||
       !CidEvidenceReportExpect(
            reportText,
            "compile_receipt_bootstrap_stage",
            "stage3_local",
            err) ||
       !CidEvidenceReportExpect(
            reportText,
            "compile_receipt_runtime_provider_count",
            strings.IntToStr(providers.len),
            err):
        return Err[bool](err)
    for providerIndex in 0..<providers.len:
        if !CidEvidenceReportExpect(
                reportText,
                CidEvidenceJoin([
                    "compile_receipt_runtime_provider.",
                    strings.IntToStr(providerIndex)]),
                providers[providerIndex],
                err):
            return Err[bool](err)

    let outputRes = os.ReadFileBytesResult(compiledOutput)
    if IsErr(outputRes):
        return Err[bool](Error(outputRes))
    var outputBytes = Value(outputRes)
    let outputSha256 = hash256.Sha256Fixed(
        layout.ByteSpanFromBytes(outputBytes))
    if !CidEvidenceReportExpect(
            reportText,
            "output_sha256",
            layout.FixedBytes32Hex(outputSha256),
            err) ||
       !CidEvidenceReportExpect(
            reportText,
            "compile_receipt_output_digest",
            layout.FixedBytes32Hex(outputSha256),
            err):
        return Err[bool](err)

    var worldHeadCid: layout.FixedBytes32
    if !CidEvidenceReportFixed32Into(
            reportText,
            "compile_receipt_world_head_cid",
            worldHeadCid,
            err):
        return Err[bool](err)
    var compileReceipt: ccsg.CompileReceipt
    if !ccsg.CompileReceiptMakeInto(
            worldHeadCid,
            compilerCsg.sourceIdentityReceipt.receiptCid,
            semanticReceipt.receiptCid,
            "x86_64-unknown-linux-gnu",
            outputSha256,
            canonicalOutputDigest,
            "stage3_local",
            providers,
            compileReceipt,
            err):
        return Err[bool](err)
    if !CidEvidenceReportExpect(
            reportText,
            "compile_receipt_cid",
            layout.FixedBytes32Hex(compileReceipt.receiptCid),
            err):
        return Err[bool](err)

    var files: str[]
    CidEvidenceWrite(
        artifactRoot,
        "artifacts/source-receipt.kv",
        CidEvidenceSourceReceiptReport(compilerCsg.sourceIdentityReceipt),
        files)
    CidEvidenceWrite(
        artifactRoot,
        "artifacts/csg-sidecar.kv",
        ccsg.CompilerCsgCanonicalSidecarReport(compilerCsg),
        files)
    CidEvidenceWrite(
        artifactRoot,
        "artifacts/semantic-receipt.kv",
        sexec.SystemLinkExecCompileSemanticReceiptReport(semanticReceipt),
        files)
    CidEvidenceWrite(
        artifactRoot,
        "artifacts/binding-report.kv",
        CidEvidenceJoin([
            "source_to_csg_binding_seal=",
            layout.FixedBytes32Hex(sourceToCsgBindingSeal)]),
        files)
    CidEvidenceWrite(
        artifactRoot,
        "artifacts/compile-receipt.kv",
        ccsg.CompileReceiptReport(compileReceipt),
        files)
    let outputWriteRes = CidEvidenceWriteBytes(
        artifactRoot,
        "artifacts/output.bin",
        outputBytes,
        files)
    if IsErr(outputWriteRes):
        return Err[bool](Error(outputWriteRes))
    ccsg.CompilerCsgReleaseBackendInputPayload(compilerCsg)
    return Ok[bool](true)

fn main(): int32 =
    var caseId = ""
    var caseRoot = ""
    var artifactRoot = ""
    var compiledOutput = ""
    var compileReport = ""
    var evidencePrefix = ""
    if !cmdline.readFlagValue("--case", caseId) ||
       !cmdline.readFlagValue("--case-root", caseRoot) ||
       !cmdline.readFlagValue("--artifact-root", artifactRoot) ||
       !cmdline.readFlagValue("--compiled-output", compiledOutput) ||
       !cmdline.readFlagValue("--compile-report", compileReport) ||
       !cmdline.readFlagValue("--evidence-prefix", evidencePrefix):
        os.WriteLine(os.Get_stderr(), "CID evidence: missing required flag")
        return 2
    if caseId == "" || caseRoot == "" || artifactRoot == "" ||
       compiledOutput == "" || compileReport == "" || evidencePrefix == "":
        os.WriteLine(os.Get_stderr(), "CID evidence: empty required flag")
        return 2
    if caseId != "source-bundle-entry" &&
       caseId != "zero-byte-import" &&
       caseId != "source-csg-binding" &&
       caseId != "csg-atomic-consume":
        os.WriteLine(os.Get_stderr(), "CID evidence: source case required")
        return 17
    let result = CidEvidenceSourceCoreCase(
        artifactRoot, compiledOutput, compileReport, caseRoot)
    if IsErr(result):
        os.WriteLine(os.Get_stderr(), Error(result))
        return 1
    return 0
