// Regression: original bug pattern from findings.md
// "return mode == 1 || mode == 2 || mode == 3" was lowered to only check mode == 1
// This is imported by cold_smoke_long_bool_chain_import

fn isWriteMode(mode: int32): bool =
    return mode == 1 || mode == 2 || mode == 3

fn isSpecial(x: int32): bool =
    return x == 0 || x == -1 || x == 255

fn isPathSep(ch: int32): bool =
    return ch == 47 || ch == 92

fn isSpace(ch: int32): bool =
    return ch == 32 || ch == 9 || ch == 13 || ch == 10
