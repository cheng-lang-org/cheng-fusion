import std/system as system

type ColdManagedExactCfgRef = ref object
    marker: int32

fn ColdManagedExactCfgMoveOnEveryPath(chooseLeft: bool): int32 =
    var value = new(ColdManagedExactCfgRef)
    value.marker = chooseLeft ? 31 : 47
    var left: ColdManagedExactCfgRef[]
    var right: ColdManagedExactCfgRef[]
    if chooseLeft:
        add(left, value)
    else:
        add(right, value)

    if chooseLeft:
        if left.len != 1 || left[0].marker != 31 || right.len != 0:
            return 1
    else:
        if right.len != 1 || right[0].marker != 47 || left.len != 0:
            return 2
    left = []
    right = []
    return 0

fn ColdManagedExactCfgKeepOrReplace(replace: bool): int32 =
    var value = ""
    var index = 0
    while index < 1:
        if replace:
            value = Fmt"owned-{index}"
        index = index + 1
    if replace:
        if value != "owned-0":
            return 1
    else:
        if value != "":
            return 2
    return 0

fn main(): int32 =
    let allocBefore = system.memAllocCount()
    let freeBefore = system.memFreeCount()
    let liveBefore = system.memLiveCount()
    let retainBefore = system.memRetainCount()
    let releaseBefore = system.memReleaseCount()

    if ColdManagedExactCfgMoveOnEveryPath(true) != 0:
        return 1
    if ColdManagedExactCfgMoveOnEveryPath(false) != 0:
        return 2
    if ColdManagedExactCfgKeepOrReplace(true) != 0:
        return 6
    if ColdManagedExactCfgKeepOrReplace(false) != 0:
        return 7
    let allocDelta = system.memAllocCount() - allocBefore
    let freeDelta = system.memFreeCount() - freeBefore
    let retainDelta = system.memRetainCount() - retainBefore
    let releaseDelta = system.memReleaseCount() - releaseBefore
    if allocDelta <= int64(0) || allocDelta != freeDelta:
        return 3
    if system.memLiveCount() != liveBefore:
        return 4
    if retainDelta != int64(0) || releaseDelta != freeDelta:
        return 5
    echo("cold_managed_exact_cfg_merge=PASS")
    return 0
