import std/result
import std/rawbytes
import std/crypto/bigint
import std/crypto/rsa
import std/crypto/minasn1 as asn1
import cheng/quic/tls/test_pki as testpki

fn firstWord(v: bigint.BigInt): int32 =
    if v.count <= 0:
        return 0
    return v.limbs[0]

fn main(): int32 =
    echo("rsa crt direct: start")
    var keyDer: Bytes
    testpki.msquicLocalhostKeyPkcs8DerInto(keyDer)
    let outerSeqRes = asn1.asn1DecodeSequence(keyDer, 0)
    if IsErr(outerSeqRes):
        echo(Fmt"rsa crt direct: outer seq err={Error(outerSeqRes)}")
        return 1
    let outerValue: Bytes = Value(outerSeqRes).value
    let outerVersionRes = asn1.asn1DecodeInteger(outerValue, 0)
    if IsErr(outerVersionRes):
        echo(Fmt"rsa crt direct: outer version err={Error(outerVersionRes)}")
        return 1
    let algRes = asn1.asn1DecodeSequence(outerValue, Value(outerVersionRes).next)
    if IsErr(algRes):
        echo(Fmt"rsa crt direct: alg err={Error(algRes)}")
        return 1
    let keyTlvRes = asn1.asn1DecodeTlv(outerValue, Value(algRes).next)
    if IsErr(keyTlvRes):
        echo(Fmt"rsa crt direct: key tlv err={Error(keyTlvRes)}")
        return 1
    if Value(keyTlvRes).tag != 0x04:
        echo(Fmt"rsa crt direct: key tag={Value(keyTlvRes).tag}")
        return 1
    let innerSeqRes = asn1.asn1DecodeSequence(Value(keyTlvRes).value, 0)
    if IsErr(innerSeqRes):
        echo(Fmt"rsa crt direct: inner seq err={Error(innerSeqRes)}")
        return 1
    let pkcs1Value: Bytes = Value(innerSeqRes).value
    var offset: int32
    let vRes = asn1.asn1DecodeInteger(pkcs1Value, offset)
    if IsErr(vRes):
        echo(Fmt"rsa crt direct: version err={Error(vRes)}")
        return 1
    offset = Value(vRes).next
    let nValRes = asn1.asn1DecodeInteger(pkcs1Value, offset)
    if IsErr(nValRes):
        echo(Fmt"rsa crt direct: n err={Error(nValRes)}")
        return 1
    let nBytes: Bytes = Value(nValRes).value
    offset = Value(nValRes).next
    let eValRes = asn1.asn1DecodeInteger(pkcs1Value, offset)
    if IsErr(eValRes):
        echo(Fmt"rsa crt direct: e err={Error(eValRes)}")
        return 1
    let eBytes: Bytes = Value(eValRes).value
    offset = Value(eValRes).next
    let dValRes = asn1.asn1DecodeInteger(pkcs1Value, offset)
    if IsErr(dValRes):
        echo(Fmt"rsa crt direct: d err={Error(dValRes)}")
        return 1
    let dBytes: Bytes = Value(dValRes).value
    offset = Value(dValRes).next
    let pValRes = asn1.asn1DecodeInteger(pkcs1Value, offset)
    if IsErr(pValRes):
        echo(Fmt"rsa crt direct: p err={Error(pValRes)}")
        return 1
    let pBytes: Bytes = Value(pValRes).value
    offset = Value(pValRes).next
    let qValRes = asn1.asn1DecodeInteger(pkcs1Value, offset)
    if IsErr(qValRes):
        echo(Fmt"rsa crt direct: q err={Error(qValRes)}")
        return 1
    let qBytes: Bytes = Value(qValRes).value
    offset = Value(qValRes).next
    let dpValRes = asn1.asn1DecodeInteger(pkcs1Value, offset)
    if IsErr(dpValRes):
        echo(Fmt"rsa crt direct: dp err={Error(dpValRes)}")
        return 1
    let dpBytes: Bytes = Value(dpValRes).value
    offset = Value(dpValRes).next
    let dqValRes = asn1.asn1DecodeInteger(pkcs1Value, offset)
    if IsErr(dqValRes):
        echo(Fmt"rsa crt direct: dq err={Error(dqValRes)}")
        return 1
    let dqBytes: Bytes = Value(dqValRes).value
    offset = Value(dqValRes).next
    let qiValRes = asn1.asn1DecodeInteger(pkcs1Value, offset)
    if IsErr(qiValRes):
        echo(Fmt"rsa crt direct: qi err={Error(qiValRes)}")
        return 1
    let qiBytes: Bytes = Value(qiValRes).value
    let nRes: Result[bigint.BigInt] = bigint.bigFromBytes(nBytes)
    let eRes: Result[bigint.BigInt] = bigint.bigFromBytes(eBytes)
    let dRes: Result[bigint.BigInt] = bigint.bigFromBytes(dBytes)
    let pRes: Result[bigint.BigInt] = bigint.bigFromBytes(pBytes)
    let qRes: Result[bigint.BigInt] = bigint.bigFromBytes(qBytes)
    let dpRes: Result[bigint.BigInt] = bigint.bigFromBytes(dpBytes)
    let dqRes: Result[bigint.BigInt] = bigint.bigFromBytes(dqBytes)
    let qiRes: Result[bigint.BigInt] = bigint.bigFromBytes(qiBytes)
    if IsErr(nRes) || IsErr(eRes) || IsErr(dRes) || IsErr(pRes) || IsErr(qRes) || IsErr(dpRes) || IsErr(dqRes) || IsErr(qiRes):
        echo("rsa crt direct: bigint parse err")
        return 1
    var nBig: bigint.BigInt = Value(nRes)
    var eBig: bigint.BigInt = Value(eRes)
    var dBig: bigint.BigInt = Value(dRes)
    var pBig: bigint.BigInt = Value(pRes)
    var qBig: bigint.BigInt = Value(qRes)
    var dpBig: bigint.BigInt = Value(dpRes)
    var dqBig: bigint.BigInt = Value(dqRes)
    var qiBig: bigint.BigInt = Value(qiRes)
    let modBits: int32 = bigint.bigBitLen(nBig)
    let modLen: int32 = (modBits + 7) / 8
    let em: Bytes = rawbytes.BytesAlloc(modLen)
    rawbytes.BytesSet(em, 0, 0)
    for i in 1..<modLen:
        rawbytes.BytesSet(em, i, (i * 37 + 19) & 255)
    let fullSig: Bytes = rawbytes.BytesAlloc(modLen)
    let fullRes: Result[int32] = rsa.rsaBigSignEmPartsFill(nBig, eBig, dBig, modLen, em, fullSig)
    if IsErr(fullRes):
        echo(Fmt"rsa crt direct: full sign err={Error(fullRes)}")
        return 1
    let fullBigRes: Result[bigint.BigInt] = bigint.bigFromBytes(fullSig)
    let emBigRes: Result[bigint.BigInt] = bigint.bigFromBytes(em)
    if IsErr(fullBigRes) || IsErr(emBigRes):
        echo("rsa crt direct: full/em bigint err")
        return 1
    var fullBig: bigint.BigInt = Value(fullBigRes)
    var emBig: bigint.BigInt = Value(emBigRes)
    var emP: bigint.BigInt
    let emPRes: Result[bool] = bigint.bigModInto(emP, emBig, pBig)
    if IsErr(emPRes):
        echo(Fmt"rsa crt direct: emP err={Error(emPRes)}")
        return 1
    var emQ: bigint.BigInt
    let emQRes: Result[bool] = bigint.bigModInto(emQ, emBig, qBig)
    if IsErr(emQRes):
        echo(Fmt"rsa crt direct: emQ err={Error(emQRes)}")
        return 1
    var fullP: bigint.BigInt
    let fullPRes: Result[bool] = bigint.bigModInto(fullP, fullBig, pBig)
    if IsErr(fullPRes):
        echo(Fmt"rsa crt direct: fullP err={Error(fullPRes)}")
        return 1
    var fullQ: bigint.BigInt
    let fullQRes: Result[bool] = bigint.bigModInto(fullQ, fullBig, qBig)
    if IsErr(fullQRes):
        echo(Fmt"rsa crt direct: fullQ err={Error(fullQRes)}")
        return 1
    var m1Fast: bigint.BigInt
    let m1FastRes: Result[bool] = bigint.bigModExpInto(m1Fast, emP, dpBig, pBig)
    if IsErr(m1FastRes):
        echo(Fmt"rsa crt direct: m1 fast err={Error(m1FastRes)}")
        return 1
    if bigint.bigCmp(m1Fast, fullP) != 0:
        echo(Fmt"rsa crt direct: m1 mismatch m1_count={m1Fast.count} m1_w0={firstWord(m1Fast)} full_count={fullP.count} full_w0={firstWord(fullP)}")
        return 1
    var m2Fast: bigint.BigInt
    let m2FastRes: Result[bool] = bigint.bigModExpInto(m2Fast, emQ, dqBig, qBig)
    if IsErr(m2FastRes):
        echo(Fmt"rsa crt direct: m2 fast err={Error(m2FastRes)}")
        return 1
    if bigint.bigCmp(m2Fast, fullQ) != 0:
        echo(Fmt"rsa crt direct: m2 mismatch m2_count={m2Fast.count} m2_w0={firstWord(m2Fast)} full_count={fullQ.count} full_w0={firstWord(fullQ)}")
        return 1
    var crtBig: bigint.BigInt
    let crtRes: Result[bool] = rsa.rsaBigCrtCombineInto(crtBig, pBig, qBig, qiBig, m1Fast, m2Fast)
    if IsErr(crtRes):
        echo(Fmt"rsa crt direct: combine err={Error(crtRes)}")
        return 1
    if bigint.bigCmp(crtBig, fullBig) != 0:
        echo(Fmt"rsa crt direct: combine mismatch crt_count={crtBig.count} crt_w0={firstWord(crtBig)} full_count={fullBig.count} full_w0={firstWord(fullBig)}")
        return 1
    let msg: Bytes = rawbytes.BytesFromString("rsa-crt-direct-pss")
    let salt: Bytes = rawbytes.BytesAlloc(32)
    for saltIdx in 0..<32:
        rawbytes.BytesSet(salt, saltIdx, (saltIdx * 13 + 7) & 255)
    let pssEm: Bytes = rawbytes.BytesAlloc(modLen)
    let pssEmRes: Result[bool] = rsa.rsaBuildPssEncodedMessageFill(msg, salt, modBits, modLen, false, pssEm)
    if IsErr(pssEmRes):
        echo(Fmt"rsa crt direct: pss em err={Error(pssEmRes)}")
        return 1
    let pssFullSig: Bytes = rawbytes.BytesAlloc(modLen)
    let pssFullRes: Result[int32] = rsa.rsaBigSignEmPartsFill(nBig, eBig, dBig, modLen, pssEm, pssFullSig)
    if IsErr(pssFullRes):
        echo(Fmt"rsa crt direct: pss full sign err={Error(pssFullRes)}")
        return 1
    let pssCrtRes: Result[Bytes] = rsa.rsaBigSignEmCrtParts(pBig, qBig, dpBig, dqBig, qiBig, modLen, pssEm)
    if IsErr(pssCrtRes):
        echo(Fmt"rsa crt direct: pss crt sign err={Error(pssCrtRes)}")
        return 1
    let pssCrtSig: Bytes = Value(pssCrtRes)
    if ! rawbytes.BytesEqual(pssFullSig, pssCrtSig):
        let pssFullBigRes: Result[bigint.BigInt] = bigint.bigFromBytes(pssFullSig)
        let pssEmBigRes: Result[bigint.BigInt] = bigint.bigFromBytes(pssEm)
        if IsErr(pssFullBigRes) || IsErr(pssEmBigRes):
            echo("rsa crt direct: pss bigint parse err")
            return 1
        var pssFullBig: bigint.BigInt = Value(pssFullBigRes)
        var pssEmBig: bigint.BigInt = Value(pssEmBigRes)
        var pssEmP: bigint.BigInt
        let pssEmPRes: Result[bool] = bigint.bigModInto(pssEmP, pssEmBig, pBig)
        if IsErr(pssEmPRes):
            echo(Fmt"rsa crt direct: pss emP err={Error(pssEmPRes)}")
            return 1
        var pssEmQ: bigint.BigInt
        let pssEmQRes: Result[bool] = bigint.bigModInto(pssEmQ, pssEmBig, qBig)
        if IsErr(pssEmQRes):
            echo(Fmt"rsa crt direct: pss emQ err={Error(pssEmQRes)}")
            return 1
        var pssFullP: bigint.BigInt
        let pssFullPRes: Result[bool] = bigint.bigModInto(pssFullP, pssFullBig, pBig)
        if IsErr(pssFullPRes):
            echo(Fmt"rsa crt direct: pss fullP err={Error(pssFullPRes)}")
            return 1
        var pssFullQ: bigint.BigInt
        let pssFullQRes: Result[bool] = bigint.bigModInto(pssFullQ, pssFullBig, qBig)
        if IsErr(pssFullQRes):
            echo(Fmt"rsa crt direct: pss fullQ err={Error(pssFullQRes)}")
            return 1
        var pssM1Fast: bigint.BigInt
        let pssM1FastRes: Result[bool] = bigint.bigModExpInto(pssM1Fast, pssEmP, dpBig, pBig)
        if IsErr(pssM1FastRes):
            echo(Fmt"rsa crt direct: pss m1 err={Error(pssM1FastRes)}")
            return 1
        if bigint.bigCmp(pssM1Fast, pssFullP) != 0:
            echo(Fmt"rsa crt direct: pss m1 mismatch m1_count={pssM1Fast.count} m1_w0={firstWord(pssM1Fast)} full_count={pssFullP.count} full_w0={firstWord(pssFullP)}")
            return 1
        var pssM2Fast: bigint.BigInt
        let pssM2FastRes: Result[bool] = bigint.bigModExpInto(pssM2Fast, pssEmQ, dqBig, qBig)
        if IsErr(pssM2FastRes):
            echo(Fmt"rsa crt direct: pss m2 err={Error(pssM2FastRes)}")
            return 1
        if bigint.bigCmp(pssM2Fast, pssFullQ) != 0:
            echo(Fmt"rsa crt direct: pss m2 mismatch m2_count={pssM2Fast.count} m2_w0={firstWord(pssM2Fast)} full_count={pssFullQ.count} full_w0={firstWord(pssFullQ)}")
            return 1
        var pssDirectCrtBig: bigint.BigInt
        let pssDirectCrtRes: Result[bool] = rsa.rsaBigCrtCombineInto(pssDirectCrtBig, pBig, qBig, qiBig, pssM1Fast, pssM2Fast)
        if IsErr(pssDirectCrtRes):
            echo(Fmt"rsa crt direct: pss direct combine err={Error(pssDirectCrtRes)}")
            return 1
        let pssDirectCmp: int32 = bigint.bigCmp(pssDirectCrtBig, pssFullBig)
        let pssCrtBigRes: Result[bigint.BigInt] = bigint.bigFromBytes(pssCrtSig)
        if IsErr(pssCrtBigRes):
            echo(Fmt"rsa crt direct: pss crt bigint err={Error(pssCrtBigRes)}")
            return 1
        var pssCrtBig: bigint.BigInt = Value(pssCrtBigRes)
        var pssCrtP: bigint.BigInt
        let pssCrtPRes: Result[bool] = bigint.bigModInto(pssCrtP, pssCrtBig, pBig)
        if IsErr(pssCrtPRes):
            echo(Fmt"rsa crt direct: pss crtP err={Error(pssCrtPRes)}")
            return 1
        var pssCrtQ: bigint.BigInt
        let pssCrtQRes: Result[bool] = bigint.bigModInto(pssCrtQ, pssCrtBig, qBig)
        if IsErr(pssCrtQRes):
            echo(Fmt"rsa crt direct: pss crtQ err={Error(pssCrtQRes)}")
            return 1
        let crtPCmp: int32 = bigint.bigCmp(pssCrtP, pssM1Fast)
        let crtQCmp: int32 = bigint.bigCmp(pssCrtQ, pssM2Fast)
        let crtNCmp: int32 = bigint.bigCmp(pssCrtBig, nBig)
        echo(Fmt"rsa crt direct: pss combine mismatch direct_cmp={pssDirectCmp} direct_count={pssDirectCrtBig.count} direct_w0={firstWord(pssDirectCrtBig)} full_count={pssFullBig.count} full_w0={firstWord(pssFullBig)} crt_count={pssCrtBig.count} crt_w0={firstWord(pssCrtBig)} crt_p_cmp={crtPCmp} crt_q_cmp={crtQCmp} crt_n_cmp={crtNCmp}")
        return 1
    let pssVerifyRes: Result[bool] = rsa.rsaBigVerifyEncodedSignature(nBig, eBig, modLen, pssEm, pssCrtSig)
    if IsErr(pssVerifyRes):
        echo(Fmt"rsa crt direct: pss verify err={Error(pssVerifyRes)}")
        return 1
    echo("rsa_crt_direct_probe ok")
    return 0
