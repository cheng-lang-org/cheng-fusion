# libp2p P5-S1 多 bootstrap 取物 env 解析门禁: CHENG_CAS_BOOTSTRAP 列表/单项/空/非法各路径 +
# 顺序保持 (OR 尝试序) + BOOTSTRAP>FETCH_FROM 优先 + 无 peer 硬错。
# exe run 非 census: 断言失败即 abort 非零, 末行 "ok" 才打印。
#
# 仅验 subprocess 侧 (cas_fetch_subprocess, 零 QUIC → stage3 cold-hybrid 可编)。env 适配器
# cas_fetch_env 同款解析逻辑 (CasFetchEnvParsePeers / CasFetchEnvPeerList, 逐字节同构) 但 import
# host_quic 闭包, 属 cold-hybrid 边界, 由 compile-probe / 件4 三进程 e2e 门覆盖 (见 P5_S1_DESIGN §2d)。
# 「列表首项坏、次项好 → 成功」的 live 取物腿需真服务 peer, 属件4 e2e 门; 本 smoke 确定性覆盖其
# 前置: 列表顺序保持 (坏在前好在后即按此序尝试) + 无 peer / CLI 缺时硬错 (无静默空手)。

import std/system
import std/os
import std/result
import cheng/core/tooling/cas_fetch_subprocess as subfetch

@borrows
fn expectPeers(got: str[], want: str[], tag: str) =
    assert(got.len == want.len, tag + " len 不符")
    for i in 0..<want.len:
        assert(got[i] == want[i], tag + " 元素/顺序不符")

fn main(): int32 =
    # ---- (1) 列表解析: 逗号 ----
    var w1: str[]
    add(w1, "a:1")
    add(w1, "b:2")
    add(w1, "c:3")
    expectPeers(subfetch.CasSubprocessParsePeers("a:1,b:2,c:3"), w1, " 逗号列表")

    # ---- (2) 列表解析: 空白 (空格/tab) ----
    expectPeers(subfetch.CasSubprocessParsePeers("a:1 b:2\tc:3"), w1, " 空白列表")

    # ---- (3) 列表解析: 混合 + 前后/多重分隔符 (空 token 丢弃) ----
    expectPeers(subfetch.CasSubprocessParsePeers("  a:1, ,b:2 ,, c:3  "), w1, " 混合分隔")

    # ---- (4) 单项 ----
    var wSingle: str[]
    add(wSingle, "h:9")
    expectPeers(subfetch.CasSubprocessParsePeers("h:9"), wSingle, " 单项")

    # ---- (5) 空 / 纯分隔符 → 空列表 (非法/退化) ----
    assert(subfetch.CasSubprocessParsePeers("").len == 0, " 空串 → 0")
    assert(subfetch.CasSubprocessParsePeers("   ").len == 0, " 纯空白 → 0")
    assert(subfetch.CasSubprocessParsePeers(" , ,, ").len == 0, " 纯逗号空白 → 0")

    # ---- (6) 顺序保持: 坏在前好在后 (OR 尝试序) ----
    var wOrder: str[]
    add(wOrder, "bad:1")
    add(wOrder, "good:2")
    let ord = subfetch.CasSubprocessParsePeers("bad:1,good:2")
    expectPeers(ord, wOrder, " 顺序保持")
    assert(ord[0] == "bad:1", " 首项=坏")
    assert(ord[1] == "good:2", " 次项=好")

    # ---- (7) env 优先级: BOOTSTRAP 优先于 FETCH_FROM ----
    os.SetEnv("CHENG_CAS_BOOTSTRAP", "x:1,y:2")
    os.SetEnv("CHENG_CAS_FETCH_FROM", "z:9")
    var wBoot: str[]
    add(wBoot, "x:1")
    add(wBoot, "y:2")
    expectPeers(subfetch.CasSubprocessPeerList(), wBoot, " BOOTSTRAP 优先")

    # ---- (8) env 回退: 仅 FETCH_FROM (BOOTSTRAP 空) → 单项 ----
    os.SetEnv("CHENG_CAS_BOOTSTRAP", "")
    os.SetEnv("CHENG_CAS_FETCH_FROM", "z:9")
    var wZ: str[]
    add(wZ, "z:9")
    expectPeers(subfetch.CasSubprocessPeerList(), wZ, " FETCH_FROM 回退")

    # ---- (9) env 皆空 → 空列表 ----
    os.SetEnv("CHENG_CAS_BOOTSTRAP", "")
    os.SetEnv("CHENG_CAS_FETCH_FROM", "")
    assert(subfetch.CasSubprocessPeerList().len == 0, " 皆空 → 0")

    # ---- (10) 无 peer → 硬 Err (绝不静默空手) ----
    var noPeer: Result[Bytes] = subfetch.CasSubprocessFetcher("00")
    assert(IsErr(noPeer), " 无 peer → Err")

    # ---- (11) 有 peer 但 CLI 缺 → 硬 Err (fork 前守卫, 不触网) ----
    os.SetEnv("CHENG_CAS_BOOTSTRAP", "bad:1 good:2")
    os.SetEnv("CHENG_CAS_CLI", "")
    os.SetEnv("CHENG_CAS_ROOT", "")
    var noCli: Result[Bytes] = subfetch.CasSubprocessFetcher("00")
    assert(IsErr(noCli), " 有 peer 无 CLI → Err")

    echo(" cas_fetch_bootstrap_env_smoke ok")
    return 0
