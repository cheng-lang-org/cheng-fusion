import std/cmdline
import std/os
import std/rawbytes
import std/strutils as strutil
import cheng/std/bytes_layout as layout
import cheng/core/lang/parser
import cheng/core/tooling/compiler_world as cworld

fn CommitVerifyRoot(): str =
    var root = cmdline.ReadFlagOrDefault("--root", "")
    if root == "":
        root = strutil.Join([
            os.GetCurrentDir(),
            "/artifacts/compiler_managed_mirror_commit_verify-",
            IntToStr(os.ProcessId())
        ], "")
    os.MkdirAll(root, 493)
    return root

fn CommitVerifyWrite(handle: os.AtomicTree,
                     path: str,
                     text: str) =
    var bytes = rawbytes.BytesFromString(text)
    assert(IsOk(os.AtomicTreeWriteExclusiveSync(handle, path, bytes)),
           strutil.Join(["managed mirror commit verify: write ", path], ""))

fn CommitVerifyManifest(bundleCid: layout.FixedBytes32,
                        bundleText: str,
                        sourceText: str): cworld.CompilerManagedMirrorCommit =
    var bundleFile: cworld.CompilerManagedMirrorCommitFile
    bundleFile.relativePath = "bundle.txt"
    bundleFile.rawByteLength = bundleText.len
    bundleFile.contentCid = cworld.CompilerWorldSourceRawBytesCid(bundleText)
    var sourceFile: cworld.CompilerManagedMirrorCommitFile
    sourceFile.relativePath = "src/main.cheng"
    sourceFile.rawByteLength = sourceText.len
    sourceFile.contentCid = cworld.CompilerWorldSourceRawBytesCid(sourceText)
    var commit: cworld.CompilerManagedMirrorCommit
    commit.bundleCid = bundleCid
    commit.fileCount = 2
    commit.files = [bundleFile, sourceFile]
    return commit

fn CommitVerifyInstall(root: str,
                       caseName: str,
                       bundleText: str,
                       sourceText: str,
                       commit: cworld.CompilerManagedMirrorCommit,
                       includeSource: bool,
                       includeExtra: bool): str =
    let stagingName = strutil.Join(["staging-", caseName], "")
    let finalName = strutil.Join(["installed-", caseName], "")
    let beginRes = os.AtomicTreeBegin(root, stagingName, finalName)
    assert(IsOk(beginRes), Error(beginRes))
    let handle = Value(beginRes)
    assert(IsOk(os.AtomicTreeMkdir(handle, ".cheng-mirror")) &&
           IsOk(os.AtomicTreeMkdir(handle, "src")),
           "managed mirror commit verify: mkdir")
    CommitVerifyWrite(handle, "bundle.txt", bundleText)
    if includeSource:
        CommitVerifyWrite(handle, "src/main.cheng", sourceText)
    if includeExtra:
        CommitVerifyWrite(handle, "attacker-extra", "extra")
    CommitVerifyWrite(handle,
                      ".cheng-mirror/commit.txt",
                      cworld.CompilerManagedMirrorCommitReport(commit))
    let commitRes = os.AtomicTreeCommitNoReplace(handle)
    assert(IsOk(commitRes) &&
           Value(commitRes) == os.AtomicTreeCommitted,
           "managed mirror commit verify: commit")
    assert(IsOk(os.AtomicTreeClose(handle)),
           "managed mirror commit verify: committed close")
    return finalName

fn CommitVerifyOpened(root: str,
                      finalName: str,
                      bundleCid: layout.FixedBytes32): bool =
    let openRes = os.AtomicTreeOpenVerified(root, finalName)
    assert(IsOk(openRes), Error(openRes))
    let handle = Value(openRes)
    let verifyRes = cworld.CompilerManagedMirrorCommittedTreeVerifyHandle(
        handle,
        bundleCid)
    let closeRes = os.AtomicTreeClose(handle)
    assert(IsOk(closeRes), Error(closeRes))
    return IsOk(verifyRes)

fn CommitVerifySnapshotOpenInto(
        root: str,
        finalName: str,
        bundleCid: layout.FixedBytes32,
        outHandle: var os.AtomicTree,
        outRoot: var parser.ParserExternalPackageRoot) =
    let openRes = os.AtomicTreeOpenVerified(root, finalName)
    assert(IsOk(openRes), Error(openRes))
    outHandle = Value(openRes)
    var verifiedCommit: cworld.CompilerManagedMirrorCommit
    assert(IsOk(cworld.CompilerManagedMirrorCommittedTreeVerifyInto(
                    outHandle,
                    bundleCid,
                    verifiedCommit)),
           "managed mirror commit verify: snapshot tree rejected")
    let sourceRes = os.AtomicTreeReadStable(outHandle, "src/main.cheng")
    assert(IsOk(sourceRes), Error(sourceRes))
    var sourceBytes = Value(sourceRes)
    let sourceText = cworld.CompilerWorldOwnText(
        rawbytes.BytesToString(sourceBytes))
    rawbytes.BytesFree(sourceBytes)
    let packageRoot = strutil.Join([root, "/", finalName], "")
    let sourcePath = strutil.Join([packageRoot, "/src/main.cheng"], "")
    outRoot = parser.ParserExternalPackageRootCertifiedSnapshotNew(
        "dep/pkg",
        "dep/pkg",
        packageRoot,
        [sourcePath],
        [sourceText])

fn CommitVerifySnapshotConsume(
        sourcePath: str,
        root: parser.ParserExternalPackageRoot,
        expected: str) =
    var roots = [root]
    var actual: str
    var err: str
    assert(parser.ParserSourceTextWithExternalPackageRootsInto(
               sourcePath,
               roots,
               actual,
               err),
           strutil.Join([
               "managed mirror commit verify: snapshot consume failed: ",
               err
           ], ""))
    assert(actual == expected,
           "managed mirror commit verify: physical mirror bytes reopened")

fn CommitVerifyWireContract() =
    let legacyText = "fn main(): int32 =\n    return 1\n"
    let migratedText = "fn main(): int32 =\n    return 0\n"
    var unit: cworld.CompilerManagedMirrorBundleWireUnit
    unit.modulePath = "dep/pkg/main"
    unit.legacySourceRawByteLength = legacyText.len
    unit.legacySourceCid = cworld.CompilerWorldSourceRawBytesCid(legacyText)
    unit.legacySourceText = legacyText
    unit.migratedSourceRawByteLength = migratedText.len
    unit.migratedSourceCid = cworld.CompilerWorldSourceRawBytesCid(
        migratedText)
    unit.migratedSourceText = migratedText
    var wire: cworld.CompilerManagedMirrorBundleWire
    wire.channel = "stable"
    wire.packageId = "dep/pkg"
    wire.migrationProofCid = cworld.CompilerWorldHashText(
        "managed_mirror_wire_proof",
        ["fixture"])
    wire.legacySourceIdentityReceiptCid = cworld.CompilerWorldHashText(
        "managed_mirror_wire_legacy_receipt",
        ["fixture"])
    wire.migratedSourceIdentityReceiptCid = cworld.CompilerWorldHashText(
        "managed_mirror_wire_migrated_receipt",
        ["fixture"])
    wire.compileSemanticReceiptCid = cworld.CompilerWorldHashText(
        "managed_mirror_wire_semantic_receipt",
        ["fixture"])
    wire.unitCount = 1
    wire.units = [unit]
    wire.baselineCsgText = "baseline-csg"
    wire.migratedCsgText = "migrated-csg"
    wire.baselineSurfaceText = "baseline-surface"
    wire.migratedSurfaceText = "migrated-surface"
    wire.baselineSemanticReceiptText = "baseline-semantic"
    wire.migratedSemanticReceiptText = "migrated-semantic"
    wire.evidenceText = "evidence"
    wire.proofText = "proof"
    wire.bundleCid = cworld.CompilerManagedMirrorBundleWireCid(wire)
    let report = cworld.CompilerManagedMirrorBundleWireReport(wire)
    var parsed: cworld.CompilerManagedMirrorBundleWire
    assert(IsOk(cworld.CompilerManagedMirrorBundleWireFromReportText(
                    report,
                    parsed)),
           "managed mirror commit verify: canonical wire rejected")
    assert(IsErr(cworld.CompilerManagedMirrorBundleWireFromReportText(
                     strutil.Join([report, "\n"], ""),
                     parsed)),
           "managed mirror commit verify: wire trailing byte accepted")
    var relativePath: str
    assert(IsOk(cworld.CompilerManagedMirrorSourceRelativePath(
                    wire.packageId,
                    unit.modulePath,
                    relativePath)) &&
           relativePath == "src/main.cheng",
           "managed mirror commit verify: source mapper drift")
    wire.units[0].migratedSourceText = legacyText
    assert(IsErr(cworld.CompilerManagedMirrorBundleWireVerify(wire)),
           "managed mirror commit verify: wire source mutation accepted")
    echo("managed_mirror_wire_manifest_binding=1")

fn main(argc: int32, argv: str*): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    CommitVerifyWireContract()
    let root = CommitVerifyRoot()
    let bundleCid = cworld.CompilerWorldHashText(
        "managed_mirror_commit_verify_bundle",
        ["fixture"])
    let bundleText = strutil.Join([
        "bundle_cid=",
        layout.FixedBytes32Hex(bundleCid)
    ], "")
    let sourceText = "fn main(): int32 =\n    return 0\n"
    let commit = CommitVerifyManifest(bundleCid,
                                      bundleText,
                                      sourceText)
    var expectedDirs: str[]
    var expectedFiles: str[]
    assert(IsOk(cworld.CompilerManagedMirrorCommitExpectedTree(
                    commit,
                    expectedDirs,
                    expectedFiles)),
           "managed mirror commit verify: expected tree")

    let validName = CommitVerifyInstall(root,
                                        "valid",
                                        bundleText,
                                        sourceText,
                                        commit,
                                        true,
                                        false)
    assert(CommitVerifyOpened(root, validName, bundleCid),
           "managed mirror commit verify: valid tree rejected")

    let tamperName = CommitVerifyInstall(root,
                                         "tamper",
                                         bundleText,
                                         sourceText,
                                         commit,
                                         true,
                                         false)
    os.WriteFile(strutil.Join([
        root,
        "/",
        tamperName,
        "/src/main.cheng"
    ], ""), "tampered")
    assert(!CommitVerifyOpened(root, tamperName, bundleCid),
           "managed mirror commit verify: content tamper accepted")

    let extraName = CommitVerifyInstall(root,
                                        "extra",
                                        bundleText,
                                        sourceText,
                                        commit,
                                        true,
                                        true)
    assert(!CommitVerifyOpened(root, extraName, bundleCid),
           "managed mirror commit verify: extra file accepted")

    let missingName = CommitVerifyInstall(root,
                                          "missing",
                                          bundleText,
                                          sourceText,
                                          commit,
                                          false,
                                          false)
    assert(!CommitVerifyOpened(root, missingName, bundleCid),
           "managed mirror commit verify: missing file accepted")

    let rewriteName = CommitVerifyInstall(root,
                                          "snapshot-rewrite",
                                          bundleText,
                                          sourceText,
                                          commit,
                                          true,
                                          false)
    var rewriteHandle: os.AtomicTree
    var rewriteRoot: parser.ParserExternalPackageRoot
    CommitVerifySnapshotOpenInto(root,
                                 rewriteName,
                                 bundleCid,
                                 rewriteHandle,
                                 rewriteRoot)
    let rewriteSourcePath = strutil.Join([
        root,
        "/",
        rewriteName,
        "/src/main.cheng"
    ], "")
    os.WriteFile(rewriteSourcePath,
                 "fn main(): int32 =\n    return 1\n")
    CommitVerifySnapshotConsume(rewriteSourcePath,
                                rewriteRoot,
                                sourceText)
    assert(IsErr(os.AtomicTreeClose(rewriteHandle)),
           "managed mirror commit verify: same-inode rewrite accepted")
    echo("managed_mirror_snapshot_same_inode_rejected=1")

    let swapName = CommitVerifyInstall(root,
                                       "snapshot-swap",
                                       bundleText,
                                       sourceText,
                                       commit,
                                       true,
                                       false)
    var swapHandle: os.AtomicTree
    var swapRoot: parser.ParserExternalPackageRoot
    CommitVerifySnapshotOpenInto(root,
                                 swapName,
                                 bundleCid,
                                 swapHandle,
                                 swapRoot)
    let attackerText = "fn main(): int32 =\n    return 2\n"
    let attackerCommit = CommitVerifyManifest(bundleCid,
                                               bundleText,
                                               attackerText)
    let attackerName = CommitVerifyInstall(root,
                                           "snapshot-swap-attacker",
                                           bundleText,
                                           attackerText,
                                           attackerCommit,
                                           true,
                                           false)
    let heldPath = strutil.Join([root, "/snapshot-swap-held"], "")
    let swapPath = strutil.Join([root, "/", swapName], "")
    assert(os.RenamePath(swapPath, heldPath),
           "managed mirror commit verify: verified root hold failed")
    assert(os.RenamePath(strutil.Join([root, "/", attackerName], ""),
                         swapPath),
           "managed mirror commit verify: verified root swap failed")
    let swapSourcePath = strutil.Join([swapPath, "/src/main.cheng"], "")
    CommitVerifySnapshotConsume(swapSourcePath,
                                swapRoot,
                                sourceText)
    assert(IsErr(os.AtomicTreeClose(swapHandle)),
           "managed mirror commit verify: verified root swap accepted")
    echo("managed_mirror_snapshot_root_swap_rejected=1")

    var nonCanonical = commit
    nonCanonical.fileCount = 1
    var parsedNonCanonical: cworld.CompilerManagedMirrorCommit
    assert(IsErr(cworld.CompilerManagedMirrorCommitFromText(
                     cworld.CompilerManagedMirrorCommitReport(nonCanonical),
                     bundleCid,
                     parsedNonCanonical)),
           "managed mirror commit verify: count/rows mismatch accepted")
    echo("COMPILER_MANAGED_MIRROR_COMMIT_VERIFY_OK")
    return 0
