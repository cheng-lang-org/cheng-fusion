    else:
        failCount = failCount + 1

    # ================= AES-128-GCM TC4 (60-byte plaintext + 20-byte AAD) =================
    let tc4KeyB: Bytes = hexToBytes(gcmTc4Key)
    var tc4KeyRes: Result[gcm.AesGcmKey] = gcm.intoAesGcmKey(tc4KeyB)
    var tc4Key: gcm.AesGcmKey = Value(tc4KeyRes)
    var tc4NonceRes: Result[gcm.AesGcmNonce] = gcm.intoAesGcmNonce(hexToBytes(gcmTc4Iv))
    var tc4Nonce: gcm.AesGcmNonce = Value(tc4NonceRes)
    var tc4Data: Bytes = hexToBytes(gcmTc4Pt)
    let tc4Aad: Bytes = hexToBytes(gcmTc4Aad)
    var tc4Tag: gcm.AesGcmTag
    var tc4Enc: Result[bool] = gcm.aesGcmEncrypt(tc4Key, tc4Nonce, tc4Tag, tc4Data, tc4Aad)
    var tc4Bad: int32 = 0
    var tc4TagV: Bytes = BytesSlice(tc4Tag.data, 0, BytesLen(tc4Tag.data))
    if IsErr(tc4Enc):
