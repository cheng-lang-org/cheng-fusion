    if tc4Bad == 0:
        echo("W1AEAD gcm_tc4 PASS")
    else:
        failCount = failCount + 1

    # ================= AES-256-GCM TC13 (empty plaintext) =================
    let tc13KeyB: Bytes = hexToBytes(gcmTc13Key)
    var tc13KeyRes: Result[gcm.AesGcmKey] = gcm.intoAesGcmKey(tc13KeyB)
    var tc13Key: gcm.AesGcmKey = Value(tc13KeyRes)
    var tc13NonceRes: Result[gcm.AesGcmNonce] = gcm.intoAesGcmNonce(hexToBytes(gcmTc13Iv))
    var tc13Nonce: gcm.AesGcmNonce = Value(tc13NonceRes)
    var tc13Data: Bytes = emptyBytes()
    let tc13Aad: Bytes = emptyBytes()
    var tc13Tag: gcm.AesGcmTag
    var tc13Enc: Result[bool] = gcm.aesGcmEncrypt(tc13Key, tc13Nonce, tc13Tag, tc13Data, tc13Aad)
    var tc13Bad: int32 = 0
    var tc13TagV: Bytes = BytesSlice(tc13Tag.data, 0, BytesLen(tc13Tag.data))
    if IsErr(tc13Enc):
        echo("W1AEAD gcm_tc13 FAIL enc " + ErrorText(tc13Enc))
        tc13Bad = 1
    let tc13TagWant: Bytes = hexToBytes(gcmTc13Tag)
    if firstDiff(tc13TagV, tc13TagWant) != -2:
        tc13Bad = 1
        dumpDiff("gcm_tc13 tag", tc13TagV, tc13TagWant)
    var tc13Dec: Result[bool] = gcm.aesGcmDecrypt(tc13Key, tc13Nonce, tc13Tag, tc13Data, tc13Aad)
    if IsErr(tc13Dec):
        echo("W1AEAD gcm_tc13 FAIL dec " + ErrorText(tc13Dec))
        tc13Bad = 1
    if tc13Bad == 0:
        echo("W1AEAD gcm_tc13 PASS")
    else:
        failCount = failCount + 1

    # ================= AES-256-GCM TC14 (one zero block) =================
    let tc14KeyB: Bytes = hexToBytes(gcmTc14Key)
    var tc14KeyRes: Result[gcm.AesGcmKey] = gcm.intoAesGcmKey(tc14KeyB)
    var tc14Key: gcm.AesGcmKey = Value(tc14KeyRes)
    var tc14NonceRes: Result[gcm.AesGcmNonce] = gcm.intoAesGcmNonce(hexToBytes(gcmTc14Iv))
    var tc14Nonce: gcm.AesGcmNonce = Value(tc14NonceRes)
    var tc14Data: Bytes = hexToBytes(gcmTc14Pt)
