# purept_w1aead_vectors.cheng — W1-AEAD RFC official vector driver (pure Cheng).
#
# Sources (transcribed verbatim, oracle-cross-checked):
#   RFC 8439 §2.4.2  ChaCha20 encryption vector
#   RFC 8439 §2.5.2  Poly1305 MAC vector
#   RFC 8439 §2.6.2  Poly1305 key generation vector (block counter 0)
#   RFC 8439 §2.8.2  AEAD_CHACHA20_POLY1305 vector
#   NIST GCM spec (McGrew-Viega, csrc.nist.gov proposedmodes/gcm) Appendix B
#   Test Cases 1-4 (AES-128) and 13-16 (AES-256), 96-bit IV subset.
#   (RFC 8439 itself contains no AES-GCM vectors; see results/purept_w1aead.md.)
#
# Exit code: 0 = all green, 1 = at least one FAIL line above.

import std/system
import std/result
import std/rawbytes
import std/crypto/aesgcm as gcm
import std/crypto/chacha20poly1305 as aead

