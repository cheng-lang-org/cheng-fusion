const aead282Tag = "1ae10b594f09e26a7e902ecbd0600691"

fn hexVal(c: int32): int32 =
    if c >= 48 && c <= 57:
        return c - 48
    if c >= 97 && c <= 102:
        return c - 87
    if c >= 65 && c <= 70:
        return c - 55
    Assert(false, "hexToBytes: invalid hex character")
    return 0

fn hexToBytes(s: str): Bytes =
    let raw: Bytes = BytesFromString(s)
    let n: int32 = BytesLen(raw)
    Assert(n % 2 == 0, "hexToBytes: odd length")
    let out: Bytes = BytesAlloc(n / 2)
    for i in 0..<(n / 2):
        BytesSet(out, i, hexVal(BytesGet(raw, 2 * i)) * 16 + hexVal(BytesGet(raw, 2 * i + 1)))
    return out

# -2 = equal, -1 = length mismatch, >=0 = first differing byte index.
fn firstDiff(a: Bytes, b: Bytes): int32 =
    if BytesLen(a) != BytesLen(b):
        return -1
    var i: int32
    while i < BytesLen(a):
        if BytesGet(a, i) != BytesGet(b, i):
            return i
        i = i + 1
    return -2

fn dumpDiff(label: str, got: Bytes, want: Bytes) =
    echo("W1AEAD " + label + " got  =" + BytesToHex(got))
    echo("W1AEAD " + label + " want =" + BytesToHex(want))

fn main(): int32 =
    echo("W1AEAD-BEGIN purept_w1aead_vectors")
    var failCount: int32 = 0

    # ================= AES-128-GCM TC1 (empty plaintext, no AAD) =================
    let tc1KeyB: Bytes = hexToBytes(gcmTc1Key)
    var tc1KeyRes: Result[gcm.AesGcmKey] = gcm.intoAesGcmKey(tc1KeyB)
    var tc1Key: gcm.AesGcmKey = Value(tc1KeyRes)
    var tc1NonceRes: Result[gcm.AesGcmNonce] = gcm.intoAesGcmNonce(hexToBytes(gcmTc1Iv))
    var tc1Nonce: gcm.AesGcmNonce = Value(tc1NonceRes)
    var tc1Data: Bytes = emptyBytes()
    let tc1Aad: Bytes = emptyBytes()
    var tc1Tag: gcm.AesGcmTag
    var tc1Enc: Result[bool] = gcm.aesGcmEncrypt(tc1Key, tc1Nonce, tc1Tag, tc1Data, tc1Aad)
    var tc1Bad: int32 = 0
    var tc1TagV: Bytes = BytesSlice(tc1Tag.data, 0, BytesLen(tc1Tag.data))
    if IsErr(tc1Enc):
        echo("W1AEAD gcm_tc1 FAIL enc " + ErrorText(tc1Enc))
        tc1Bad = 1
    let tc1TagWant: Bytes = hexToBytes(gcmTc1Tag)
    if firstDiff(tc1TagV, tc1TagWant) != -2:
        tc1Bad = 1
        dumpDiff("gcm_tc1 tag", tc1TagV, tc1TagWant)
    var tc1Dec: Result[bool] = gcm.aesGcmDecrypt(tc1Key, tc1Nonce, tc1Tag, tc1Data, tc1Aad)
    if IsErr(tc1Dec):
        echo("W1AEAD gcm_tc1 FAIL dec " + ErrorText(tc1Dec))
        tc1Bad = 1
    if tc1Bad == 0:
        echo("W1AEAD gcm_tc1 PASS")
    else:
        failCount = failCount + 1

    # ================= AES-128-GCM TC2 (one zero block) =================
    let tc2KeyB: Bytes = hexToBytes(gcmTc2Key)
    var tc2KeyRes: Result[gcm.AesGcmKey] = gcm.intoAesGcmKey(tc2KeyB)
    var tc2Key: gcm.AesGcmKey = Value(tc2KeyRes)
    var tc2NonceRes: Result[gcm.AesGcmNonce] = gcm.intoAesGcmNonce(hexToBytes(gcmTc2Iv))
    var tc2Nonce: gcm.AesGcmNonce = Value(tc2NonceRes)
    var tc2Data: Bytes = hexToBytes(gcmTc2Pt)
    let tc2Aad: Bytes = emptyBytes()
    var tc2Tag: gcm.AesGcmTag
    var tc2Enc: Result[bool] = gcm.aesGcmEncrypt(tc2Key, tc2Nonce, tc2Tag, tc2Data, tc2Aad)
    var tc2Bad: int32 = 0
    var tc2TagV: Bytes = BytesSlice(tc2Tag.data, 0, BytesLen(tc2Tag.data))
    if IsErr(tc2Enc):
        echo("W1AEAD gcm_tc2 FAIL enc " + ErrorText(tc2Enc))
        tc2Bad = 1
    let tc2CtWant: Bytes = hexToBytes(gcmTc2Ct)
    let tc2TagWant: Bytes = hexToBytes(gcmTc2Tag)
    if firstDiff(tc2Data, tc2CtWant) != -2:
        tc2Bad = 1
        dumpDiff("gcm_tc2 ct", tc2Data, tc2CtWant)
    if firstDiff(tc2TagV, tc2TagWant) != -2:
        tc2Bad = 1
        dumpDiff("gcm_tc2 tag", tc2TagV, tc2TagWant)
    var tc2Dec: Result[bool] = gcm.aesGcmDecrypt(tc2Key, tc2Nonce, tc2Tag, tc2Data, tc2Aad)
    if IsErr(tc2Dec):
        echo("W1AEAD gcm_tc2 FAIL dec " + ErrorText(tc2Dec))
        tc2Bad = 1
    let tc2PtWant: Bytes = hexToBytes(gcmTc2Pt)
    if firstDiff(tc2Data, tc2PtWant) != -2:
        tc2Bad = 1
        dumpDiff("gcm_tc2 roundtrip pt", tc2Data, tc2PtWant)
    if tc2Bad == 0:
        echo("W1AEAD gcm_tc2 PASS")
    else:
        failCount = failCount + 1

    # ================= AES-128-GCM TC3 (64-byte plaintext, no AAD) =================
    let tc3KeyB: Bytes = hexToBytes(gcmTc3Key)
    var tc3KeyRes: Result[gcm.AesGcmKey] = gcm.intoAesGcmKey(tc3KeyB)
    var tc3Key: gcm.AesGcmKey = Value(tc3KeyRes)
    var tc3NonceRes: Result[gcm.AesGcmNonce] = gcm.intoAesGcmNonce(hexToBytes(gcmTc3Iv))
    var tc3Nonce: gcm.AesGcmNonce = Value(tc3NonceRes)
    var tc3Data: Bytes = hexToBytes(gcmTc3Pt)
    let tc3Aad: Bytes = emptyBytes()
    var tc3Tag: gcm.AesGcmTag
    var tc3Enc: Result[bool] = gcm.aesGcmEncrypt(tc3Key, tc3Nonce, tc3Tag, tc3Data, tc3Aad)
    var tc3Bad: int32 = 0
    var tc3TagV: Bytes = BytesSlice(tc3Tag.data, 0, BytesLen(tc3Tag.data))
    if IsErr(tc3Enc):
        echo("W1AEAD gcm_tc3 FAIL enc " + ErrorText(tc3Enc))
        tc3Bad = 1
    let tc3CtWant: Bytes = hexToBytes(gcmTc3Ct)
    let tc3TagWant: Bytes = hexToBytes(gcmTc3Tag)
    if firstDiff(tc3Data, tc3CtWant) != -2:
        tc3Bad = 1
        dumpDiff("gcm_tc3 ct", tc3Data, tc3CtWant)
    if firstDiff(tc3TagV, tc3TagWant) != -2:
        tc3Bad = 1
        dumpDiff("gcm_tc3 tag", tc3TagV, tc3TagWant)
    var tc3Dec: Result[bool] = gcm.aesGcmDecrypt(tc3Key, tc3Nonce, tc3Tag, tc3Data, tc3Aad)
    if IsErr(tc3Dec):
        echo("W1AEAD gcm_tc3 FAIL dec " + ErrorText(tc3Dec))
        tc3Bad = 1
    let tc3PtWant: Bytes = hexToBytes(gcmTc3Pt)
    if firstDiff(tc3Data, tc3PtWant) != -2:
        tc3Bad = 1
        dumpDiff("gcm_tc3 roundtrip pt", tc3Data, tc3PtWant)
    if tc3Bad == 0:
