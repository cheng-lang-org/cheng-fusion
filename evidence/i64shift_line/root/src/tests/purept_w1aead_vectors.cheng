    var tc4Dec: Result[bool] = gcm.aesGcmDecrypt(tc4Key, tc4Nonce, tc4Tag, tc4Data, tc4Aad)
    if IsErr(tc4Dec):
        echo("W1AEAD gcm_tc4 FAIL dec " + ErrorText(tc4Dec))
