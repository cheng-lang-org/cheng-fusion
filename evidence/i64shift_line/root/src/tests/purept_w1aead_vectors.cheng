# ---- RFC 8439 §2.8.2 AEAD_CHACHA20_POLY1305 ----
const aead282Key = "808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f"
const aead282Nonce = "070000004041424344454647"
const aead282Aad = "50515253c0c1c2c3c4c5c6c7"
const aead282Pt = "4c616469657320616e642047656e746c656d656e206f662074686520636c617373206f66202739393a204966204920636f756c64206f6666657220796f75206f6e6c79206f6e652074697020666f7220746865206675747572652c2073756e73637265656e20776f756c642062652069742e"
