    var tc14Enc: Result[bool] = gcm.aesGcmEncrypt(tc14Key, tc14Nonce, tc14Tag, tc14Data, tc14Aad)
    var tc14Bad: int32 = 0
    var tc14TagV: Bytes = BytesSlice(tc14Tag.data, 0, BytesLen(tc14Tag.data))
    if IsErr(tc14Enc):
        echo("W1AEAD gcm_tc14 FAIL enc " + ErrorText(tc14Enc))
        tc14Bad = 1
    let tc14CtWant: Bytes = hexToBytes(gcmTc14Ct)
    let tc14TagWant: Bytes = hexToBytes(gcmTc14Tag)
    if firstDiff(tc14Data, tc14CtWant) != -2:
        tc14Bad = 1
        dumpDiff("gcm_tc14 ct", tc14Data, tc14CtWant)
    if firstDiff(tc14TagV, tc14TagWant) != -2:
        tc14Bad = 1
        dumpDiff("gcm_tc14 tag", tc14TagV, tc14TagWant)
    var tc14Dec: Result[bool] = gcm.aesGcmDecrypt(tc14Key, tc14Nonce, tc14Tag, tc14Data, tc14Aad)
    if IsErr(tc14Dec):
        echo("W1AEAD gcm_tc14 FAIL dec " + ErrorText(tc14Dec))
        tc14Bad = 1
    let tc14PtWant: Bytes = hexToBytes(gcmTc14Pt)
    if firstDiff(tc14Data, tc14PtWant) != -2:
        tc14Bad = 1
        dumpDiff("gcm_tc14 roundtrip pt", tc14Data, tc14PtWant)
    if tc14Bad == 0:
        echo("W1AEAD gcm_tc14 PASS")
    else:
        failCount = failCount + 1

    # ================= AES-256-GCM TC15 (64-byte plaintext, no AAD) =================
    let tc15KeyB: Bytes = hexToBytes(gcmTc15Key)
    var tc15KeyRes: Result[gcm.AesGcmKey] = gcm.intoAesGcmKey(tc15KeyB)
    var tc15Key: gcm.AesGcmKey = Value(tc15KeyRes)
    var tc15NonceRes: Result[gcm.AesGcmNonce] = gcm.intoAesGcmNonce(hexToBytes(gcmTc15Iv))
    var tc15Nonce: gcm.AesGcmNonce = Value(tc15NonceRes)
    var tc15Data: Bytes = hexToBytes(gcmTc15Pt)
    let tc15Aad: Bytes = emptyBytes()
    var tc15Tag: gcm.AesGcmTag
    var tc15Enc: Result[bool] = gcm.aesGcmEncrypt(tc15Key, tc15Nonce, tc15Tag, tc15Data, tc15Aad)
    var tc15Bad: int32 = 0
    var tc15TagV: Bytes = BytesSlice(tc15Tag.data, 0, BytesLen(tc15Tag.data))
    if IsErr(tc15Enc):
        echo("W1AEAD gcm_tc15 FAIL enc " + ErrorText(tc15Enc))
        tc15Bad = 1
    let tc15CtWant: Bytes = hexToBytes(gcmTc15Ct)
    let tc15TagWant: Bytes = hexToBytes(gcmTc15Tag)
    if firstDiff(tc15Data, tc15CtWant) != -2:
        tc15Bad = 1
        dumpDiff("gcm_tc15 ct", tc15Data, tc15CtWant)
    if firstDiff(tc15TagV, tc15TagWant) != -2:
        tc15Bad = 1
        dumpDiff("gcm_tc15 tag", tc15TagV, tc15TagWant)
    var tc15Dec: Result[bool] = gcm.aesGcmDecrypt(tc15Key, tc15Nonce, tc15Tag, tc15Data, tc15Aad)
    if IsErr(tc15Dec):
        echo("W1AEAD gcm_tc15 FAIL dec " + ErrorText(tc15Dec))
        tc15Bad = 1
    let tc15PtWant: Bytes = hexToBytes(gcmTc15Pt)
    if firstDiff(tc15Data, tc15PtWant) != -2:
        tc15Bad = 1
        dumpDiff("gcm_tc15 roundtrip pt", tc15Data, tc15PtWant)
    if tc15Bad == 0:
        echo("W1AEAD gcm_tc15 PASS")
    else:
        failCount = failCount + 1

    # ================= AES-256-GCM TC16 (60-byte plaintext + 20-byte AAD) =================
    let tc16KeyB: Bytes = hexToBytes(gcmTc16Key)
    var tc16KeyRes: Result[gcm.AesGcmKey] = gcm.intoAesGcmKey(tc16KeyB)
    var tc16Key: gcm.AesGcmKey = Value(tc16KeyRes)
    var tc16NonceRes: Result[gcm.AesGcmNonce] = gcm.intoAesGcmNonce(hexToBytes(gcmTc16Iv))
    var tc16Nonce: gcm.AesGcmNonce = Value(tc16NonceRes)
    var tc16Data: Bytes = hexToBytes(gcmTc16Pt)
    let tc16Aad: Bytes = hexToBytes(gcmTc16Aad)
    var tc16Tag: gcm.AesGcmTag
    var tc16Enc: Result[bool] = gcm.aesGcmEncrypt(tc16Key, tc16Nonce, tc16Tag, tc16Data, tc16Aad)
    var tc16Bad: int32 = 0
    var tc16TagV: Bytes = BytesSlice(tc16Tag.data, 0, BytesLen(tc16Tag.data))
    if IsErr(tc16Enc):
        echo("W1AEAD gcm_tc16 FAIL enc " + ErrorText(tc16Enc))
        tc16Bad = 1
    let tc16CtWant: Bytes = hexToBytes(gcmTc16Ct)
    let tc16TagWant: Bytes = hexToBytes(gcmTc16Tag)
    if firstDiff(tc16Data, tc16CtWant) != -2:
        tc16Bad = 1
        dumpDiff("gcm_tc16 ct", tc16Data, tc16CtWant)
    if firstDiff(tc16TagV, tc16TagWant) != -2:
        tc16Bad = 1
        dumpDiff("gcm_tc16 tag", tc16TagV, tc16TagWant)
    var tc16Dec: Result[bool] = gcm.aesGcmDecrypt(tc16Key, tc16Nonce, tc16Tag, tc16Data, tc16Aad)
    if IsErr(tc16Dec):
        echo("W1AEAD gcm_tc16 FAIL dec " + ErrorText(tc16Dec))
        tc16Bad = 1
    let tc16PtWant: Bytes = hexToBytes(gcmTc16Pt)
    if firstDiff(tc16Data, tc16PtWant) != -2:
        tc16Bad = 1
        dumpDiff("gcm_tc16 roundtrip pt", tc16Data, tc16PtWant)
    if tc16Bad == 0:
        echo("W1AEAD gcm_tc16 PASS")
    else:
        failCount = failCount + 1

    # ================= RFC 8439 §2.4.2 ChaCha20 encryption (counter=1) =================
    let ccKeyB: Bytes = hexToBytes(chacha242Key)
    var ccKeyRes: Result[aead.ChaChaPolyKey] = aead.intoChaChaPolyKey(ccKeyB)
    var ccKey: aead.ChaChaPolyKey = Value(ccKeyRes)
    var ccNonceRes: Result[aead.ChaChaPolyNonce] = aead.intoChaChaPolyNonce(hexToBytes(chacha242Nonce))
    var ccNonce: aead.ChaChaPolyNonce = Value(ccNonceRes)
    var ccKeyV: Bytes = BytesSlice(ccKey.data, 0, BytesLen(ccKey.data))
    var ccNonceV: Bytes = BytesSlice(ccNonce.data, 0, BytesLen(ccNonce.data))
    var ccData: Bytes = hexToBytes(chacha242Pt)
    var ccXorEnc: Result[bool] = aead.chacha20Xor(ccData, ccKeyV, ccNonceV, 1)
    var ccBad: int32 = 0
    if IsErr(ccXorEnc):
        echo("W1AEAD chacha_242 FAIL enc " + ErrorText(ccXorEnc))
        ccBad = 1
    let ccCtWant: Bytes = hexToBytes(chacha242Ct)
    if firstDiff(ccData, ccCtWant) != -2:
        ccBad = 1
        dumpDiff("chacha_242 ct", ccData, ccCtWant)
    var ccXorDec: Result[bool] = aead.chacha20Xor(ccData, ccKeyV, ccNonceV, 1)
    if IsErr(ccXorDec):
        echo("W1AEAD chacha_242 FAIL dec " + ErrorText(ccXorDec))
        ccBad = 1
    let ccPtWant: Bytes = hexToBytes(chacha242Pt)
    if firstDiff(ccData, ccPtWant) != -2:
        ccBad = 1
        dumpDiff("chacha_242 roundtrip pt", ccData, ccPtWant)
    if ccBad == 0:
        echo("W1AEAD chacha_242 PASS")
    else:
        failCount = failCount + 1

    # ================= RFC 8439 §2.5.2 Poly1305 MAC =================
    let polyKeyB: Bytes = hexToBytes(poly252Key)
    let polyMsg: Bytes = hexToBytes(poly252Msg)
    let polyGot: Bytes = aead.poly1305Tag(polyKeyB, polyMsg)
    let polyTagWant: Bytes = hexToBytes(poly252Tag)
    if firstDiff(polyGot, polyTagWant) != -2:
        failCount = failCount + 1
        dumpDiff("poly_252 tag", polyGot, polyTagWant)
    else:
        echo("W1AEAD poly_252 PASS")

    # ================= RFC 8439 §2.6.2 Poly1305 key generation (block counter 0) =================
    var pkKeyRes: Result[aead.ChaChaPolyKey] = aead.intoChaChaPolyKey(hexToBytes(polykey262Key))
    var pkKey: aead.ChaChaPolyKey = Value(pkKeyRes)
    var pkNonceRes: Result[aead.ChaChaPolyNonce] = aead.intoChaChaPolyNonce(hexToBytes(polykey262Nonce))
    var pkNonce: aead.ChaChaPolyNonce = Value(pkNonceRes)
    var pkKeyV: Bytes = BytesSlice(pkKey.data, 0, BytesLen(pkKey.data))
    var pkNonceV: Bytes = BytesSlice(pkNonce.data, 0, BytesLen(pkNonce.data))
    var pkBlock: Bytes = aead.Chacha20Block(pkKeyV, 0, pkNonceV)
    let pkWant: Bytes = hexToBytes(polykey262Out)
    let pkGot32: Bytes = BytesAlloc(32)
    BytesCopyInto(pkGot32, 0, BytesSlice(pkBlock, 0, 32))
    if firstDiff(pkGot32, pkWant) != -2:
        failCount = failCount + 1
        dumpDiff("polykey_262 out32", pkGot32, pkWant)
    else:
        echo("W1AEAD polykey_262 PASS")
    BytesFree(pkBlock)

    # ================= RFC 8439 §2.8.2 AEAD_CHACHA20_POLY1305 =================
    var a2KeyRes: Result[aead.ChaChaPolyKey] = aead.intoChaChaPolyKey(hexToBytes(aead282Key))
    var a2Key: aead.ChaChaPolyKey = Value(a2KeyRes)
    var a2NonceRes: Result[aead.ChaChaPolyNonce] = aead.intoChaChaPolyNonce(hexToBytes(aead282Nonce))
    var a2Nonce: aead.ChaChaPolyNonce = Value(a2NonceRes)
    let a2Aad: Bytes = hexToBytes(aead282Aad)
    var a2Data: Bytes = hexToBytes(aead282Pt)
    var a2Tag: aead.ChaChaPolyTag
    var a2Enc: Result[bool] = aead.encrypt(a2Key, a2Nonce, a2Tag, a2Data, a2Aad)
    var a2Bad: int32 = 0
    var a2TagV: Bytes = BytesSlice(a2Tag.data, 0, BytesLen(a2Tag.data))
    if IsErr(a2Enc):
        echo("W1AEAD aead_282 FAIL enc " + ErrorText(a2Enc))
        a2Bad = 1
    let a2CtWant: Bytes = hexToBytes(aead282Ct)
    let a2TagWant: Bytes = hexToBytes(aead282Tag)
    if firstDiff(a2Data, a2CtWant) != -2:
        a2Bad = 1
        dumpDiff("aead_282 ct", a2Data, a2CtWant)
    if firstDiff(a2TagV, a2TagWant) != -2:
        a2Bad = 1
        dumpDiff("aead_282 tag", a2TagV, a2TagWant)
    var a2Dec: Result[bool] = aead.decrypt(a2Key, a2Nonce, a2Tag, a2Data, a2Aad)
    if IsErr(a2Dec):
        echo("W1AEAD aead_282 FAIL dec " + ErrorText(a2Dec))
        a2Bad = 1
    let a2PtWant: Bytes = hexToBytes(aead282Pt)
    if firstDiff(a2Data, a2PtWant) != -2:
        a2Bad = 1
        dumpDiff("aead_282 roundtrip pt", a2Data, a2PtWant)
    if a2Bad == 0:
        echo("W1AEAD aead_282 PASS")
    else:
        failCount = failCount + 1

    # ============ NEG-1: AES-GCM wrong tag must fail (TC2, tag[0] ^= 0x01) ============
    var neg1Data: Bytes = hexToBytes(gcmTc2Ct)
    var neg1TagRaw: Bytes = hexToBytes(gcmTc2Tag)
    BytesSet(neg1TagRaw, 0, BytesGet(neg1TagRaw, 0) ^ 1)
    var neg1TagRes: Result[gcm.AesGcmTag] = gcm.intoAesGcmTag(neg1TagRaw)
    var neg1Tag: gcm.AesGcmTag = Value(neg1TagRes)
    var neg1Dec: Result[bool] = gcm.aesGcmDecrypt(tc2Key, tc2Nonce, neg1Tag, neg1Data, tc2Aad)
    if IsErr(neg1Dec):
        echo("W1AEAD neg_gcm_wrongtag PASS (rejected)")
    else:
        failCount = failCount + 1
        echo("W1AEAD neg_gcm_wrongtag FAIL (accepted corrupted tag)")

    # ============ NEG-2: ChaCha20-Poly1305 wrong AAD must fail (§2.8.2, aad[11] ^= 0x01) ============
    var neg2Aad: Bytes = hexToBytes(aead282Aad)
    BytesSet(neg2Aad, 11, BytesGet(neg2Aad, 11) ^ 1)
    var neg2Data: Bytes = hexToBytes(aead282Ct)
    var neg2TagRes: Result[aead.ChaChaPolyTag] = aead.intoChaChaPolyTag(hexToBytes(aead282Tag))
    var neg2Tag: aead.ChaChaPolyTag = Value(neg2TagRes)
    var neg2Dec: Result[bool] = aead.decrypt(a2Key, a2Nonce, neg2Tag, neg2Data, neg2Aad)
    if IsErr(neg2Dec):
        echo("W1AEAD neg_chacha_wrongaad PASS (rejected)")
    else:
        failCount = failCount + 1
        echo("W1AEAD neg_chacha_wrongaad FAIL (accepted wrong AAD)")

    # ============ NEG-3: ChaCha20-Poly1305 truncated ciphertext must fail (§2.8.2, 114 -> 113) ============
    var neg3Full: Bytes = hexToBytes(aead282Ct)
    var neg3Data: Bytes = BytesSlice(neg3Full, 0, 113)
    var neg3Dec: Result[bool] = aead.decrypt(a2Key, a2Nonce, neg2Tag, neg3Data, a2Aad)
    if IsErr(neg3Dec):
        echo("W1AEAD neg_chacha_truncct PASS (rejected)")
    else:
        failCount = failCount + 1
        echo("W1AEAD neg_chacha_truncct FAIL (accepted truncated ct)")

    # ============ NEG-4: AES-GCM truncated ciphertext must fail (TC4, 60 -> 59) ============
    var neg4Full: Bytes = hexToBytes(gcmTc4Ct)
    var neg4Data: Bytes = BytesSlice(neg4Full, 0, 59)
    var neg4TagRes: Result[gcm.AesGcmTag] = gcm.intoAesGcmTag(hexToBytes(gcmTc4Tag))
    var neg4Tag: gcm.AesGcmTag = Value(neg4TagRes)
    var neg4Dec: Result[bool] = gcm.aesGcmDecrypt(tc4Key, tc4Nonce, neg4Tag, neg4Data, tc4Aad)
    if IsErr(neg4Dec):
        echo("W1AEAD neg_gcm_truncct PASS (rejected)")
    else:
        failCount = failCount + 1
        echo("W1AEAD neg_gcm_truncct FAIL (accepted truncated ct)")

    if failCount == 0:
        echo("W1AEAD-END ALL GREEN")
        return 0
    echo("W1AEAD-END FAILURES PRESENT")
    return 1
