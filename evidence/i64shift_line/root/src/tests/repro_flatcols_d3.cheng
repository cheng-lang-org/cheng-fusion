import std/system
import std/seqs

type
    FlatBoxI32 = ref object
        v: int32[]

@borrows
fn flatPutI32(b: FlatBoxI32, val: int32) =
    var v = b.v
    b.v = []
    v[3] = val
    b.v = v

fn main() =
    var b: FlatBoxI32 = new(FlatBoxI32)
    var v0: int32[]
    seqs.setLen(v0, 8)
    for i in 0..<v0.len:
        v0[i] = 0
    b.v = v0
    flatPutI32(b, 9)
    assert(b.v[3] == 9, "flat d3: i32 value")
    echo("repro_flatcols_d3 ok")
