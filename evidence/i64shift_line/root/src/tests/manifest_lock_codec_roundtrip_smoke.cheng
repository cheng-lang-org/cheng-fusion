# libp2p P5-S1 manifest-as-lock codec 往返 + sha256==headCid 校验 + 非法行拒绝门禁 (正典 §11.6 P5)。
# exe run 非 census: 断言失败即 abort 非零, 末行 "ok" 才打印。
#
# 覆盖:
#   (1) encode(ManifestLock) → 字节逐字节 == 手工拼的 lock 行式 (逐字节同构 index.lock.txt)。
#   (2) encode → sha256 (ManifestLockCid) → decode 往返: entries 逐字段相等。
#   (3) ManifestLockVerifyHeadCid: cid 匹配 Ok; 篡改 headCid 一位 → Err。
#   (4) 空行容忍: 中间/末尾空行跳过, 不影响 entries (byte-identity-safe)。
#   (5) 非法行硬错: 无 '=' / 三段 / 空 key / 空 value → 一律 decode Err (无静默跳过)。
#   (6) encode 侧硬错: modulePath 含 '=' / 含换行 → Err。

import std/system
import std/result
import std/rawbytes as rawbytes
import cheng/std/bytes_layout as layout
import cheng/libp2p/protocols/cas_source/channel_head/manifest_lock_codec as mlc

fn mkEntry(mp: str, cid: str): mlc.ManifestLockEntry =
    var e: mlc.ManifestLockEntry
    e.modulePath = mp
    e.cidHex = cid
    return e

fn main(): int32 =
    let c1 = "1111111111111111111111111111111111111111111111111111111111111111"
    let c2 = "2222222222222222222222222222222222222222222222222222222222222222"
    let c3 = "3333333333333333333333333333333333333333333333333333333333333333"

    var lock: mlc.ManifestLock
    add(lock.entries, mkEntry("cheng/foo/bar", c1))
    add(lock.entries, mkEntry("cheng/foo/baz", c2))
    add(lock.entries, mkEntry("cheng/foo/qux", c3))

    # ---- (1) 逐字节同构 index.lock.txt 行式 ----
    var encRes: Result[Bytes] = mlc.ManifestLockEncode(lock)
    assert(!IsErr(encRes), " encode: " + Error(encRes))
    var bytes = Value(encRes)
    let expectText = "cheng/foo/bar=" + c1 + "\n" + "cheng/foo/baz=" + c2 + "\n" + "cheng/foo/qux=" + c3 + "\n"
    var expectBytes = rawbytes.BytesFromString(expectText)
    assert(BytesEqual(bytes, expectBytes), " encode 逐字节 == lock 行式")

    # ---- (2) sha256 + decode 往返 ----
    let cid = mlc.ManifestLockCid(bytes)
    var decRes: Result[mlc.ManifestLock] = mlc.ManifestLockDecode(bytes)
    assert(!IsErr(decRes), " decode: " + Error(decRes))
    var lock2 = Value(decRes)
    assert(lock2.entries.len == 3, " decode: 3 entry")
    for i in 0..<3:
        assert(lock.entries[i].modulePath == lock2.entries[i].modulePath, " decode modulePath 逐一相等")
        assert(lock.entries[i].cidHex == lock2.entries[i].cidHex, " decode cidHex 逐一相等")

    # re-encode 字节逐字节相等 (往返稳定)
    var reRes: Result[Bytes] = mlc.ManifestLockEncode(lock2)
    assert(!IsErr(reRes), " re-encode")
    assert(BytesEqual(bytes, Value(reRes)), " re-encode 字节逐字节相等")

    # ---- (3) sha256(manifest) == head.headCid 校验入口 ----
    var vOk: Result[bool] = mlc.ManifestLockVerifyHeadCid(bytes, cid)
    assert(!IsErr(vOk), " verify headCid==cid: " + Error(vOk))
    # 篡改 headCid 一位 → Err
    var cidBytes = layout.FixedBytes32ToBytes(cid)
    var tampered = BytesAlloc(32)
    BytesCopyInto(tampered, 0, cidBytes)
    BytesSet(tampered, 0, (BytesGet(tampered, 0) ^ 1) & 255)
    var badCidRes = layout.FixedBytes32FromBytes(tampered)
    assert(!IsErr(badCidRes), " tampered cid 32B")
    var vBad: Result[bool] = mlc.ManifestLockVerifyHeadCid(bytes, Value(badCidRes))
    assert(IsErr(vBad), " verify 篡改 headCid → Err")

    # ---- (4) 空行容忍 (中间 + 末尾空行跳过) ----
    var blankBytes = rawbytes.BytesFromString("cheng/a=" + c1 + "\n\ncheng/b=" + c2 + "\n")
    var blankRes: Result[mlc.ManifestLock] = mlc.ManifestLockDecode(blankBytes)
    assert(!IsErr(blankRes), " decode 空行容忍: " + Error(blankRes))
    assert(Value(blankRes).entries.len == 2, " 空行跳过后 2 entry")

    # ---- (5) 非法行硬错 ----
    var noEq = rawbytes.BytesFromString("cheng/a=" + c1 + "\nbadline\n")
    assert(IsErr(mlc.ManifestLockDecode(noEq)), " 非法: 无 '=' 行 → Err")
    var threeSeg = rawbytes.BytesFromString("cheng/a=" + c1 + "=extra\n")
    assert(IsErr(mlc.ManifestLockDecode(threeSeg)), " 非法: 三段 (两个 '=') → Err")
    var emptyKey = rawbytes.BytesFromString("=" + c1 + "\n")
    assert(IsErr(mlc.ManifestLockDecode(emptyKey)), " 非法: 空 key → Err")
    var emptyVal = rawbytes.BytesFromString("cheng/a=\n")
    assert(IsErr(mlc.ManifestLockDecode(emptyVal)), " 非法: 空 value → Err")

    # ---- (6) encode 侧硬错 (含分隔符) ----
    var badLock: mlc.ManifestLock
    add(badLock.entries, mkEntry("cheng/a=b", c1))
    assert(IsErr(mlc.ManifestLockEncode(badLock)), " encode: modulePath 含 '=' → Err")
    var nlLock: mlc.ManifestLock
    add(nlLock.entries, mkEntry("cheng/a\nb", c1))
    assert(IsErr(mlc.ManifestLockEncode(nlLock)), " encode: modulePath 含换行 → Err")

    echo(" manifest_lock_codec_roundtrip_smoke ok")
    return 0
