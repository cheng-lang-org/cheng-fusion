fn main(): int32 =
	// Self-cancellation tests (existing)
	let a = 5
	let b = a ^ a
	let c = a - a
	let d = a & a
	let e = a | a
	if b != 0: return 1
	if c != 0: return 2
	if d != 5: return 3
	if e != 5: return 4

	// x + 0 -> x (add identity)
	let f = a + 0
	if f != 5: return 5

	// x - 0 -> x (sub identity)
	let g = a - 0
	if g != 5: return 6

	// x * 2 -> x << 1 (strength reduction multiply to shift)
	let h = a * 2
	if h != 10: return 7

	// x != x -> 0 (false self-inequality)
	let i = a != a
	if i != 0: return 8

	// x == x -> 1 (true self-equality)
	let j = a == a
	if j != 1: return 9

	// !(x == y) -> x != y (logical NOT of comparison via nested CMP inversion)
	let k = !(a == a)     // !(true) = 0
	if k != 0: return 10

	let l = !(a == 3)     // !(false) = 1
	if l != 1: return 11

	// !(x < y) -> x >= y (negation of less-than)
	let m = !(a < 3)      // !(false) = 1, since 5 >= 3
	if m != 1: return 12

	let n = !(a < 10)     // !(true) = 0, since 5 < 10
	if n != 0: return 13

	// !(x > y) -> x <= y (negation of greater-than)
	let o = !(a > 3)      // !(true) = 0, since 5 > 3
	if o != 0: return 14

	let p = !(a > 10)     // !(false) = 1, since 5 <= 10
	if p != 1: return 15

	// x | 0 -> x (OR identity)
	let q = a | 0
	if q != 5: return 16

	// x ^ 0 -> x (XOR identity)
	let r = a ^ 0
	if r != 5: return 17

	// x & (-1) -> x (AND with all-ones)
	let s = a & (-1)
	if s != 5: return 18

	// x & (x | y) -> x (absorption AND)
	let t = 10
	let t2 = t | 3
	let t3 = t & t2
	if t3 != 10: return 20

	// x | (x & y) -> x (absorption OR)
	let u = 10
	let u2 = u & 3
	let u3 = u | u2
	if u3 != 10: return 21

	// x ^ (x ^ y) -> y (XOR cancellation, inner on a side)
	let v = 10
	let v2 = v ^ 7
	let v3 = v2 ^ v
	if v3 != 7: return 22

	// (x ^ y) ^ x -> y (XOR cancellation, inner on b side)
	let w = 10
	let w2 = 7 ^ w
	let w3 = w ^ w2
	if w3 != 7: return 23

	// x | (~x) -> -1 (OR with complement = all ones)
	let aa = 10
	let ab = aa ^ (-1)
	let ac = aa | ab
	if ac != -1: return 24

	// x & (~x) -> 0 (AND with complement = zero)
	let ad = 10
	let ae = ad ^ (-1)
	let af = ad & ae
	if af != 0: return 25

	// (x + y) - y -> x (cancel subtract of same value, I32)
	let ag = 10
	let ah = 7
	let ai = ag + ah
	let aj = ai - ah
	if aj != 10: return 26

	// (x - y) + y -> x (cancel add of same value, I32)
	let ak = 10
	let al = 7
	let am = ak - al
	let an = am + al
	if an != 10: return 27

	// (x + y) - y -> x (cancel subtract of same value, I64)
	let ao = int64(100)
	let ap = int64(70)
	let aq = ao + ap
	let ar = aq - ap
	if ar != int64(100): return 28

	// (x - y) + y -> x (cancel add of same value, I64)
	let as = int64(100)
	let at = int64(70)
	let au = as - at
	let av = au + at
	if av != int64(100): return 29

	// CONST(c) + (x - CONST(c)) -> x for I32 (constant cancel on left)
	let bx = 10
	let by = 7
	let bz = bx - by
	let ca = by + bz
	if ca != 10: return 30

	// (x - CONST(c)) + CONST(c) -> x for I32 (constant cancel on right)
	let cb = 10
	let cc = 7
	let cd = cb - cc
	let ce = cd + cc
	if ce != 10: return 31

	// (x + y) - x -> y for I32 (cancel first ADD operand)
	let cf = 10
	let cg = 7
	let ch = cf + cg
	let ci = ch - cf
	if ci != 7: return 32

	// (x + y) - y -> x for I32 (cancel second ADD operand)
	let cj = 10
	let ck = 7
	let cl = cj + ck
	let cm = cl - ck
	if cm != 10: return 33

	echo(" cold_egraph_converge_smoke ok")
	return 0
