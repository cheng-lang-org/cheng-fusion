import std/hashmaps as hashmaps
import std/strformat

fn assertInt(actual: int32, expected: int32, label: str) =
    assert(actual == expected, label)

fn assertFound(found: bool, expected: bool, label: str) =
    assert(found == expected, label)

fn main(): int32 =
    var m: hashmaps.HashMapStrInt = hashmaps.HashMapStrIntInit(4)
    var found: bool

    for i in 0..<80:
        hashmaps.HashMapStrIntPut(m, Fmt"key-{i}", i + 100)

    assertInt(hashmaps.HashMapStrIntGetMutEx(m, "key-0", found), 100, "hashmaps hash column: first value")
    assertFound(found, true, "hashmaps hash column: first found")
    assertInt(hashmaps.HashMapStrIntGetMutEx(m, "key-63", found), 163, "hashmaps hash column: grown value")
    assertFound(found, true, "hashmaps hash column: grown found")
    assertInt(hashmaps.HashMapStrIntGetMutEx(m, "key-missing", found), 0, "hashmaps hash column: missing value")
    assertFound(found, false, "hashmaps hash column: missing found")

    hashmaps.HashMapStrIntPut(m, "key-63", 777)
    assertInt(hashmaps.HashMapStrIntGetMutEx(m, "key-63", found), 777, "hashmaps hash column: updated value")
    assertFound(found, true, "hashmaps hash column: updated found")

    hashmaps.HashMapStrIntClear(m)
    assertInt(hashmaps.HashMapStrIntGetMutEx(m, "key-63", found), 0, "hashmaps hash column: cleared value")
    assertFound(found, false, "hashmaps hash column: cleared found")

    hashmaps.HashMapStrIntPut(m, "alpha", 11)
    hashmaps.HashMapStrIntPut(m, "beta", 22)
    hashmaps.HashMapStrIntPut(m, "gamma", 33)

    let alpha0: int32 = hashmaps.HashMapStrIntGetMutEx(m, "alpha", found)
    assertFound(found, true, "hashmaps hash column: alpha found")
    assertInt(alpha0, 11, "hashmaps hash column: alpha value")

    let beta0: int32 = hashmaps.HashMapStrIntGetMutEx(m, "beta", found)
    assertFound(found, true, "hashmaps hash column: beta found")
    assertInt(beta0, 22, "hashmaps hash column: beta value")

    let gamma0: int32 = hashmaps.HashMapStrIntGetMutEx(m, "gamma", found)
    assertFound(found, true, "hashmaps hash column: gamma found")
    assertInt(gamma0, 33, "hashmaps hash column: gamma value")

    hashmaps.HashMapStrIntPut(m, "alpha", 44)
    let alpha1: int32 = hashmaps.HashMapStrIntGetMutEx(m, "alpha", found)
    assertFound(found, true, "hashmaps hash column: updated alpha found")
    assertInt(alpha1, 44, "hashmaps hash column: updated alpha value")

    hashmaps.HashMapStrIntClear(m)
    let cleared: int32 = hashmaps.HashMapStrIntGetMutEx(m, "alpha", found)
    assertFound(found, false, "hashmaps hash column: clear invalidates alpha")
    assertInt(cleared, 0, "hashmaps hash column: clear value")

    echo("hashmaps_hash_column_contract_smoke ok")
    return 0
