import std/system

fn moveStr(out: var str, value: var str) =
    out.data = value.data
    out.len = value.len
    out.store_id = value.store_id
    out.flags = value.flags
    value.data = nil
    value.len = 0
    value.store_id = 0
    value.flags = 0

fn main(): int32 =
    var source = system.NewStringCopy(system.StrDataPtr("moved"), 5)
    var target = "old"
    source.store_id = 37
    if source.flags != 1:
        return 10
    moveStr(target, source)
    if target != "moved":
        return 1
    if target.len != 5 || target.data == nil:
        return 2
    if source.len != 0 || source.data != nil:
        return 3
    if target.flags != 1:
        return 4
    if target.store_id != 37:
        return 5
    if source.store_id != 0 || source.flags != 0:
        return 6
    echo("cold_var_str_field_assign_smoke ok")
    return 0
