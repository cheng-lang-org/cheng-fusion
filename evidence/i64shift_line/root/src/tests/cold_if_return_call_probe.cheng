# Discriminating probe: if-with-return-call false edge must NOT fall into then.
# New test-only file.
var g_cap: int32

fn pick(v: int32): int32 =
    return v + 100

fn choose(flag: int32): int32 =
    if flag > 0:
        return pick(flag)
    return 7

fn main(): int32 =
    # flag=0 → else path → expect 7. If false-edge collapsed: pick(0)=100.
    let r = choose(0)
    if r == 7:
        return 0
    return r
