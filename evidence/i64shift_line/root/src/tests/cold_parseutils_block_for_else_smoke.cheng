import std/parseutils

fn main(): int32 =
    var decimal: parseutils.BiggestFloat
    let decimalCount = parseutils.ParseBiggestFloat("3ms", decimal)
    if decimalCount != 1:
        return 1
    if int32(decimal) != 3:
        return 4

    var exponent: parseutils.BiggestFloat
    let exponentCount = parseutils.ParseBiggestFloat("1.25e2ms", exponent)
    if exponentCount != 6:
        return 2
    if int32(exponent) != 125:
        return 5

    var invalid: parseutils.BiggestFloat
    if parseutils.ParseBiggestFloat("oops", invalid) != 0:
        return 3
    return 0
