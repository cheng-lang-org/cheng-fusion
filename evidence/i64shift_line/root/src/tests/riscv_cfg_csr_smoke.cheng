import cheng/core/backend/codegen_contract as contract
import cheng/core/backend/regalloc_production_encoder_events as events
import cheng/core/backend/regalloc_riscv_adapter as riscv
import cheng/core/backend/regalloc_single_pass as alloc
import cheng/core/ir/core_types as ir
import cheng/core/lang/typed_expr as texpr
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import std/os

fn fixtureCid(label: str): layout.FixedBytes32 =
    var bytes = layout.ByteBufInit(label.len)
    for index in 0..<label.len:
        layout.ByteBufAppendByte(bytes, int32(label[index]))
    let out = hash256.Sha256Fixed(layout.ByteBufView(bytes))
    layout.ByteBufFree(bytes)
    return out

fn integerAddBranchBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    assert(ir.BodyIRBindTypeArenaArtifactCid(
               body, fixtureCid("riscv_cfg_csr_type_arena")),
           "cfg csr type arena")
    for slotIndex in 0..<4:
        var slot: ir.LocalSlot
        ir.BodyIRApplyLocalSlotDefaultProof(slot)
        slot.id = slotIndex
        slot.name = "v"
        slot.typeKind = ir.LocalI32Tag
        slot.stackOffset = 16 + slotIndex * 8
        slot.sizeBytes = 4
        slot.alignBytes = 4
        add(body.localSlots, slot)
    var ownershipKinds: int32[]
    for _ in 0..<body.localSlots.len:
        add(ownershipKinds, int32(ir.OwnInvalid))
    ir.BodyIRFreezeEntryDefinitionOwnershipKinds(body, ownershipKinds)
    var c0: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(c0)
    c0.kind = ir.BodyOpLoadConstTag
    c0.target = 0
    add(c0.operands, ir.LocalI32Tag)
    add(c0.operands, 40)
    let _ = ir.BodyIRAppendOp(body, c0)
    var c1: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(c1)
    c1.kind = ir.BodyOpLoadConstTag
    c1.target = 1
    add(c1.operands, ir.LocalI32Tag)
    add(c1.operands, 2)
    let _ = ir.BodyIRAppendOp(body, c1)
    var addOp: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(addOp)
    addOp.kind = ir.BodyOpBinOpTag
    addOp.target = 2
    add(addOp.operands, ir.LocalI32Tag)
    add(addOp.operands, int32(texpr.TypedExprIrOpI32Add))
    add(addOp.operands, 0)
    add(addOp.operands, 1)
    let _ = ir.BodyIRAppendOp(body, addOp)
    var cZero: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(cZero)
    cZero.kind = ir.BodyOpLoadConstTag
    cZero.target = 3
    add(cZero.operands, ir.LocalI32Tag)
    add(cZero.operands, 0)
    let _ = ir.BodyIRAppendOp(body, cZero)
    var cbr: ir.BodyTerm
    ir.BodyIRApplyBodyTermDefaultProof(cbr)
    cbr.kind = ir.BodyTermCbrTag
    cbr.conditionKind = ir.BodyCondLocalNonZeroTag
    cbr.resultSlot = 0
    cbr.lhsSlot = 0
    cbr.rhsSlot = -1
    cbr.trueBlock = 1
    cbr.falseBlock = 2
    let entryTerm = ir.BodyIRAppendTerm(body, cbr)
    var retAdd: ir.BodyTerm
    ir.BodyIRApplyBodyTermDefaultProof(retAdd)
    retAdd.kind = ir.BodyTermReturnTag
    retAdd.resultSlot = 2
    add(retAdd.operands, ir.LocalI32Tag)
    let addTerm = ir.BodyIRAppendTerm(body, retAdd)
    var retZero: ir.BodyTerm
    ir.BodyIRApplyBodyTermDefaultProof(retZero)
    retZero.kind = ir.BodyTermReturnTag
    retZero.resultSlot = 3
    add(retZero.operands, ir.LocalI32Tag)
    let zeroTerm = ir.BodyIRAppendTerm(body, retZero)
    let _ = ir.BodyIRAppendBlock(body, 0, 2, entryTerm)
    let _ = ir.BodyIRAppendBlock(body, 2, 1, addTerm)
    let _ = ir.BodyIRAppendBlock(body, 3, 1, zeroTerm)
    ir.BodyIRControlFlowBegin(body, 0)
    for blockIndex in 0..<body.blocks.len:
        ir.BodyIRControlFlowBindBlockScope(body, blockIndex, 0)
    var cbrSuccessors: int32[]
    add(cbrSuccessors, 1)
    add(cbrSuccessors, 2)
    var cbrEdgeKinds: int32[]
    add(cbrEdgeKinds, ir.BodyControlEdgeNormal)
    add(cbrEdgeKinds, ir.BodyControlEdgeNormal)
    ir.BodyIRControlFlowBindTermSuccessors(
        body, entryTerm, cbrSuccessors, cbrEdgeKinds)
    var noSuccessors: int32[]
    var noEdgeKinds: int32[]
    ir.BodyIRControlFlowBindTermSuccessors(
        body, addTerm, noSuccessors, noEdgeKinds)
    ir.BodyIRControlFlowBindTermSuccessors(
        body, zeroTerm, noSuccessors, noEdgeKinds)
    ir.BodyIRControlFlowSeal(body)
    return body

@borrows
fn wordsCid(recipes: var contract.RegallocA64FunctionRecipes):
        layout.FixedBytes32 =
    var bytes = layout.ByteBufInit(recipes.functionWords.len * 4)
    for row in 0..<recipes.functionWords.len:
        let word = recipes.functionWords[row]
        layout.ByteBufAppendByte(bytes, word & 255)
        layout.ByteBufAppendByte(bytes, (word >> 8) & 255)
        layout.ByteBufAppendByte(bytes, (word >> 16) & 255)
        layout.ByteBufAppendByte(bytes, (word >> 24) & 255)
    let out = hash256.Sha256Fixed(layout.ByteBufView(bytes))
    layout.ByteBufFree(bytes)
    return out

@borrows
fn cfgBuildReject(
        body: var ir.BodyIR,
        plan: var alloc.RegallocSinglePassValuePlan): bool =
    var order: int32[]
    var csr = riscv.RegallocRiscvCfgEdgeCsrBuild(body, plan, order)
    return !csr.valid

fn cfgMutationsReject(): bool =
    var body = integerAddBranchBody()
    var constraints = alloc.RegallocTargetConstraintsRv64()
    var plan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        body, constraints)
    if !plan.valid || !alloc.RegallocSinglePassValuePlanValidate(plan):
        return false
    var exactOrder: int32[]
    var exactCsr = riscv.RegallocRiscvCfgEdgeCsrBuild(
        body, plan, exactOrder)
    if !exactCsr.valid ||
       !riscv.RegallocRiscvCfgEdgeCsrExact(
           body, plan, exactOrder, exactCsr):
        return false
    let position1 = plan.blockEntryPositions[1]
    plan.blockEntryPositions[1] = plan.blockEntryPositions[2]
    if !cfgBuildReject(body, plan):
        return false
    plan.blockEntryPositions[1] = position1
    let edgeCount = plan.edgeSourceBlocks.len
    let lastSource = plan.edgeSourceBlocks[edgeCount - 1]
    let lastTarget = plan.edgeTargetBlocks[edgeCount - 1]
    setLen(plan.edgeSourceBlocks, edgeCount - 1)
    setLen(plan.edgeTargetBlocks, edgeCount - 1)
    if !cfgBuildReject(body, plan):
        return false
    add(plan.edgeSourceBlocks, lastSource)
    add(plan.edgeTargetBlocks, lastTarget)
    add(plan.edgeSourceBlocks, 0)
    add(plan.edgeTargetBlocks, 1)
    if !cfgBuildReject(body, plan):
        return false
    setLen(plan.edgeSourceBlocks, edgeCount)
    setLen(plan.edgeTargetBlocks, edgeCount)
    let source0 = plan.edgeSourceBlocks[0]
    plan.edgeSourceBlocks[0] = 1
    if !cfgBuildReject(body, plan):
        return false
    plan.edgeSourceBlocks[0] = source0
    let target0 = plan.edgeTargetBlocks[0]
    plan.edgeTargetBlocks[0] = body.blocks.len
    if !cfgBuildReject(body, plan):
        return false
    plan.edgeTargetBlocks[0] = 0
    if !cfgBuildReject(body, plan):
        return false
    plan.edgeTargetBlocks[0] = target0
    let target1 = plan.edgeTargetBlocks[1]
    plan.edgeTargetBlocks[0] = target1
    plan.edgeTargetBlocks[1] = target0
    if !cfgBuildReject(body, plan):
        return false
    plan.edgeTargetBlocks[0] = target0
    plan.edgeTargetBlocks[1] = target1
    let order0 = exactOrder[0]
    let order1 = exactOrder[1]
    exactOrder[0] = exactOrder[1]
    exactOrder[1] = order0
    if riscv.RegallocRiscvCfgEdgeCsrExact(
           body, plan, exactOrder, exactCsr):
        return false
    exactOrder[0] = order0
    exactOrder[1] = order1
    let exactCount0 = exactCsr.counts[0]
    exactCsr.counts[0] = exactCount0 + 1
    if riscv.RegallocRiscvCfgEdgeCsrExact(
           body, plan, exactOrder, exactCsr):
        return false
    exactCsr.counts[0] = exactCount0
    exactCsr.starts[1] = exactCsr.starts[0]
    if riscv.RegallocRiscvCfgEdgeCsrExact(
           body, plan, exactOrder, exactCsr):
        return false
    return true

fn main(): int32 =
    let sourceCid = fixtureCid("riscv_cfg_csr_encoder_source")
    var body = integerAddBranchBody()
    var constraints = alloc.RegallocTargetConstraintsRv64()
    var plan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        body, constraints)
    assert(plan.valid && alloc.RegallocSinglePassValuePlanValidate(plan),
           "cfg csr plan")
    var recipes =
        riscv.RegallocRiscvPrepareFunctionActionRecipesWithEncoderAuthority(
            body, plan, 64, 101, sourceCid)
    assert(recipes.valid &&
           events.RegallocProductionEncoderEventStrictValidate(
               recipes.encoderEvents),
           "cfg csr recipes")
    assert(recipes.blockEmissionOrder.len == 3 &&
           recipes.blockEmissionOrder[0] == 0 &&
           recipes.blockEmissionOrder[1] == 2 &&
           recipes.blockEmissionOrder[2] == 1,
           "cfg csr baseline order")
    let wordRoot = layout.FixedBytes32Hex(wordsCid(recipes))
    let eventRoot = layout.FixedBytes32Hex(
        recipes.encoderEvents.orderedRoot)
    assert(recipes.functionWords.len == 23 &&
           recipes.functionRelocs.len == 0 && plan.actions.len == 21 &&
           wordRoot ==
               "1074d490598be9508022e0be89b8234e26341ed1e2c6c71f6370b982cc140158" &&
           eventRoot ==
               "224e34fe29d66442c5e6b14eb575b21feac99fbab3647814e334bdd715305a18",
           "cfg csr byte identity")
    assert(cfgMutationsReject(), "cfg csr mutations")
    os.WriteLine(os.GetStdout(),
        Fmt"riscv_cfg_csr_smoke=pass mutations=10 byte_identity=1 words={recipes.functionWords.len} relocs={recipes.functionRelocs.len} words_root={wordRoot} event_root={eventRoot}")
    return 0
