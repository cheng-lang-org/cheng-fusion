import std/crypto/p256_fixed as pfix

fn main(): int32 =
    var aFixed: pfix.P256Fixed = pfix.p256ScalarModulus()
    var bFixed: pfix.P256Fixed = pfix.p256ScalarModulus()
    let aRes: Result[pfix.P256Fixed] = Ok[pfix.P256Fixed](aFixed)
    let bRes: Result[pfix.P256Fixed] = Ok[pfix.P256Fixed](bFixed)
    var scalarModulus: pfix.P256Fixed = pfix.p256ScalarModulus()
    let sumRes: Result[pfix.P256Fixed] = pfix.p256FixedModAdd(Value(aRes), Value(bRes), scalarModulus)
    if IsErr(sumRes):
        return 1
    return 0
