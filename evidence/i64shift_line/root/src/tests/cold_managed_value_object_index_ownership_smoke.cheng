import std/system as system

type ColdManagedIndexRecord =
    key: str
    tags: str[]

type ColdManagedIndexGroup =
    records: ColdManagedIndexRecord[]

type ColdManagedIndexPlain =
    value: int32

type ColdManagedIndexRef = ref object
    value: int32

@borrows
fn ColdManagedIndexMakeRecord(
        keyText: str,
        tagText: str): ColdManagedIndexRecord =
    var record: ColdManagedIndexRecord
    record.key = system.NewStringCopy(
        system.StrDataPtr(keyText), keyText.len)
    var tag = system.NewStringCopy(
        system.StrDataPtr(tagText), tagText.len)
    add(record.tags, tag)
    return record

@borrows
fn ColdManagedIndexRecordMatches(
        record: ColdManagedIndexRecord,
        keyText: str,
        tagText: str): bool =
    return record.key == keyText &&
           record.tags.len == 1 &&
           record.tags[0] == tagText

fn ColdManagedIndexDirect(): int32 =
    var source: ColdManagedIndexRecord[]
    var record = ColdManagedIndexMakeRecord("direct-key", "direct-tag")
    add(source, record)

    var destination: ColdManagedIndexRecord[]
    add(destination, source[0])
    source = []
    if destination.len != 1 ||
       !ColdManagedIndexRecordMatches(
           destination[0], "direct-key", "direct-tag"):
        return 1
    destination = []
    return 0

fn ColdManagedIndexRepeated(): int32 =
    var source: ColdManagedIndexRecord[]
    var record =
        ColdManagedIndexMakeRecord("repeat-key", "repeat-tag")
    add(source, record)

    var destination: ColdManagedIndexRecord[]
    add(destination, source[0])
    add(destination, source[0])
    source = []
    if destination.len != 2 ||
       !ColdManagedIndexRecordMatches(
           destination[0], "repeat-key", "repeat-tag") ||
       !ColdManagedIndexRecordMatches(
           destination[1], "repeat-key", "repeat-tag"):
        return 1
    destination = []
    return 0

fn ColdManagedIndexForIn(): int32 =
    var source: ColdManagedIndexRecord[]
    var first =
        ColdManagedIndexMakeRecord("for-a", "for-tag-a")
    var second =
        ColdManagedIndexMakeRecord("for-b", "for-tag-b")
    add(source, first)
    add(source, second)

    var destination: ColdManagedIndexRecord[]
    for record in source:
        add(destination, record)
    source = []
    if destination.len != 2 ||
       !ColdManagedIndexRecordMatches(
           destination[0], "for-a", "for-tag-a") ||
       !ColdManagedIndexRecordMatches(
           destination[1], "for-b", "for-tag-b"):
        return 1
    destination = []
    return 0

fn ColdManagedIndexAppendVar(
        source: var ColdManagedIndexRecord[],
        destination: var ColdManagedIndexRecord[]) =
    add(destination, source[0])

fn ColdManagedIndexVarParam(): int32 =
    var source: ColdManagedIndexRecord[]
    var record =
        ColdManagedIndexMakeRecord("var-key", "var-tag")
    add(source, record)
    var destination: ColdManagedIndexRecord[]
    ColdManagedIndexAppendVar(source, destination)
    source = []
    if destination.len != 1 ||
       !ColdManagedIndexRecordMatches(
           destination[0], "var-key", "var-tag"):
        return 1
    destination = []
    return 0

fn ColdManagedIndexNested(): int32 =
    var firstGroup: ColdManagedIndexGroup
    var firstRecord =
        ColdManagedIndexMakeRecord("nested-a", "tag-a")
    add(firstGroup.records, firstRecord)

    var secondGroup: ColdManagedIndexGroup
    var secondRecord =
        ColdManagedIndexMakeRecord("nested-b", "tag-b")
    add(secondGroup.records, secondRecord)

    var groups: ColdManagedIndexGroup[]
    add(groups, firstGroup)
    add(groups, secondGroup)

    var destination: ColdManagedIndexRecord[]
    for groupIndex in 0..<groups.len:
        for recordIndex in 0..<groups[groupIndex].records.len:
            add(
                destination,
                groups[groupIndex].records[recordIndex])
    groups = []
    if destination.len != 2 ||
       !ColdManagedIndexRecordMatches(
           destination[0], "nested-a", "tag-a") ||
       !ColdManagedIndexRecordMatches(
           destination[1], "nested-b", "tag-b"):
        return 1
    destination = []
    return 0

fn ColdManagedIndexPlain(): int32 =
    var source: ColdManagedIndexPlain[]
    var item: ColdManagedIndexPlain
    item.value = 73
    add(source, item)
    var destination: ColdManagedIndexPlain[]
    add(destination, source[0])
    source = []
    if destination.len != 1 || destination[0].value != 73:
        return 1
    destination = []
    return 0

fn ColdManagedIndexRefInner(): int32 =
    var source: ColdManagedIndexRef[]
    var item = new(ColdManagedIndexRef)
    item.value = 91
    add(source, share(item))
    if source.len != 1 ||
       source[0] != item ||
       source[0].value != 91:
        return 1
    source = []
    if item.value != 91:
        return 2
    return 0

fn ColdManagedIndexRefSequence(): int32 =
    let liveBefore = system.memLiveCount()
    if ColdManagedIndexRefInner() != 0:
        return 1
    if system.memLiveCount() != liveBefore:
        return 2
    return 0

fn main(): int32 =
    if ColdManagedIndexRefSequence() != 0:
        return 9
    let liveBefore = system.memLiveCount()
    let retainBefore = system.memRetainCount()
    if ColdManagedIndexDirect() != 0:
        return 1
    if ColdManagedIndexNested() != 0:
        return 2
    if ColdManagedIndexPlain() != 0:
        return 3
    if ColdManagedIndexRepeated() != 0:
        return 4
    if ColdManagedIndexForIn() != 0:
        return 5
    if ColdManagedIndexVarParam() != 0:
        return 6
    if system.memLiveCount() != liveBefore:
        return 7
    if system.memRetainCount() - retainBefore != 16:
        return 8
    echo("cold_managed_value_object_index_ownership=PASS")
    return 0
