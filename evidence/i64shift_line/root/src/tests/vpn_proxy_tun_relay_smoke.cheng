import std/rawbytes as rawbytes
import std/result
import cheng/apps/vpn_proxy/vpn_proxy_main as vpn
import cheng/apps/vpn_proxy/vpn_proxy_tun_dataplane as tun

fn put8(buf: var rawbytes.Bytes, idx: int32, value: int32) =
    rawbytes.BytesSet(buf, idx, value & 255)

fn put16(buf: var rawbytes.Bytes, idx: int32, value: int32) =
    put8(buf, idx, (value >> 8) & 255)
    put8(buf, idx + 1, value & 255)

fn put32(buf: var rawbytes.Bytes, idx: int32, value: int32) =
    put8(buf, idx, (value >> 24) & 255)
    put8(buf, idx + 1, (value >> 16) & 255)
    put8(buf, idx + 2, (value >> 8) & 255)
    put8(buf, idx + 3, value & 255)

fn tcpPacket(): rawbytes.Bytes =
    var out: rawbytes.Bytes = rawbytes.BytesAlloc(40)
    put8(out, 0, 0x45)
    put16(out, 2, 40)
    put8(out, 8, 64)
    put8(out, 9, tun.VpnTunProtoTcp)
    put8(out, 12, 10)
    put8(out, 13, 8)
    put8(out, 14, 0)
    put8(out, 15, 2)
    put8(out, 16, 198)
    put8(out, 17, 18)
    put8(out, 18, 0)
    put8(out, 19, 2)
    put16(out, 20, 40000)
    put16(out, 22, 443)
    put32(out, 24, 1000)
    put8(out, 32, 0x50)
    put8(out, 33, 0x02)
    return out

fn main(): int32 =
    let packet: rawbytes.Bytes = tcpPacket()
    let targetRes: Result[vpn.VpnProxyTarget] = vpn.VpnProxyTunPacketTarget(packet)
    assert(IsOk(targetRes), " tun relay target parse")
    assert(Value(targetRes).host == "198.18.0.2", " tun relay target host")
    assert(Value(targetRes).port == 443, " tun relay target port")

    let keyRes: Result[int64] = vpn.VpnProxyTunPacketSessionKey(packet)
    assert(IsOk(keyRes), " tun relay session key")
    var parsed: tun.VpnTunIpv4Packet
    assert(tun.VpnTunParseIpv4(packet, parsed), " tun relay parse packet")
    assert(Value(keyRes) == tun.VpnTunSessionKey(parsed.srcIp, parsed.srcPort, parsed.dstIp, parsed.dstPort),
           " tun relay session key value")

    echo(" vpn_proxy_tun_relay_smoke ok")
    return 0
