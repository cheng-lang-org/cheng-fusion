    var plan: cleanup.CleanupPlan
    cleanup.CleanupPlanPrepare(plan, limits(), 0)
    cleanup.CleanupPlanBindLocalSchema(plan, body)
    cleanup.CleanupPlanBindOwnershipPlace(plan, 1, owner, 1)
    panic("cleanup cfg smoke: missing type layout accepted")

fn bindBorrowAddressReflowFixture(plan: var cleanup.CleanupPlan,
                                  body: var coreir.BodyIR,
                                  neighborOut: var int32): int32 =
    let owner = addManagedSlot(body,
                               "reflow_owner",
                               coreir.LocalAggregateTag,
                               48)
    neighborOut = addI32Slot(body, "reflow_neighbor")
    cleanup.CleanupPlanPrepare(plan, limits(), 0)
    bindNestedTwoLeafTypeLayout(plan, 1, 2, 3)
    cleanup.CleanupPlanBindLocalSchema(plan, body)
    cleanup.CleanupPlanBindOwnershipPlace(plan, 1, owner, 3)
    let projection = cleanup.CleanupPlanBindOwnershipFieldProjection(
        plan,
        body,
        1,
        1)
    var branch: coreir.BodyTerm
    branch.kind = coreir.BodyTermBrTag
    branch.trueBlock = 1
    let termIndex = coreir.BodyIRAppendTerm(body, branch)
    let _ = coreir.BodyIRAppendBlock(body, 0, 0, termIndex)
    let targetBlock = appendReturnBlock(body, -1)
    let root = cleanup.CleanupPlanRootScopeId(plan)
    let _ = cleanup.CleanupPlanQueueUnmanagedExit(
        plan,
        0,
        0,
        root,
        root,
        odir.OwnershipDropEdgeNormal,
        targetBlock)
    return projection

fn runBorrowAddressOwnerReflow() =
    var body = coreir.BodyIRNew()
    var plan: cleanup.CleanupPlan
    var neighbor: int32
    let projection = bindBorrowAddressReflowFixture(plan, body, neighbor)
    let owner = body.localSlots[projection].auxValue
    body.localSlots[owner].stackOffset = 512
    body.localSlots[neighbor].stackOffset = 560
    cleanup.CleanupPlanRefreshBorrowAddressViewsAfterReflow(plan, body)
    smokeAssert(body.localSlots[projection].stackOffset == 536,
                "cleanup cfg smoke: owner-relative projection refresh")
    let frameEnd = cleanup.CleanupPlanReflowPhysicalStackLayout(plan,
                                                                body,
                                                                64)
    smokeAssert(body.localSlots[owner].stackOffset == 64 &&
                body.localSlots[projection].stackOffset == 88 &&
                frameEnd == 116 &&
                body.localSlots[projection].auxValue == owner &&
                body.localSlots[projection].placeKind ==
                    coreir.BodyPlaceBorrowAddressTag,
                "cleanup cfg smoke: BorrowAddress allocated physical slot")
    let _ = cleanup.CleanupPlanMaterialize(body, plan)

fn runStaleBorrowAddressFailure() =
    var body = coreir.BodyIRNew()
    var plan: cleanup.CleanupPlan
    var neighbor: int32
    let projection = bindBorrowAddressReflowFixture(plan, body, neighbor)
    let owner = body.localSlots[projection].auxValue
    body.localSlots[owner].stackOffset =
        body.localSlots[owner].stackOffset + 256
    let _ = cleanup.CleanupPlanMaterialize(body, plan)
    panic("cleanup cfg smoke: stale BorrowAddress projection accepted")

fn runOverlappingStackIntervalsFailure() =
    var body = coreir.BodyIRNew()
    let first = addI32Slot(body, "overlap_first")
    let second = addI32Slot(body, "overlap_second")
