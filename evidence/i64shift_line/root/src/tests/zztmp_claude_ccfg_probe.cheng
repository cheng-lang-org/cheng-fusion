fn linearLimits(localCount: int32): cleanup.CleanupPlanLimits =
    var out = limits()
    out.maxLocalSlotCount = localCount + 4
    return out

fn runLinearStackFixture(localCount: int32): cleanup.CleanupMaterializeReport =
    var body = coreir.BodyIRNew()
    for localIndex in 0..<localCount:
        let _ = addI32Slot(body, Fmt"linear_slot_{localIndex}")
    var branch: coreir.BodyTerm
    branch.kind = coreir.BodyTermBrTag
    branch.trueBlock = 1
    let termIndex = coreir.BodyIRAppendTerm(body, branch)
    let _ = coreir.BodyIRAppendBlock(body, 0, 0, termIndex)
    let targetBlock = appendReturnBlock(body, -1)
    var plan: cleanup.CleanupPlan
    cleanup.CleanupPlanPrepare(plan, linearLimits(localCount), 0)
    cleanup.CleanupPlanBindLocalSchema(plan, body)
    let root = cleanup.CleanupPlanRootScopeId(plan)
    let _ = cleanup.CleanupPlanQueueUnmanagedExit(
        plan,
        0,
        0,
        root,
        root,
        odir.OwnershipDropEdgeNormal,
        targetBlock)
    let frameEnd = cleanup.CleanupPlanReflowPhysicalStackLayout(plan,
                                                                body,
                                                                64)
    smokeAssert(frameEnd == 64 + localCount * 4,
                "cleanup cfg smoke: linear stack frame size")
    return cleanup.CleanupPlanMaterialize(body, plan)

fn runLinearComplexity2K() =
    let half = runLinearStackFixture(1000)
    let full = runLinearStackFixture(2000)
    smokeAssert(half.physicalIntervalVisitCount == 2000 &&
                full.physicalIntervalVisitCount == 4000 &&
                full.physicalIntervalVisitCount <=
                    half.physicalIntervalVisitCount * 2 &&
                half.independentStackSeedVisitCount == 1000 &&
                full.independentStackSeedVisitCount == 2000 &&
                full.independentStackSeedVisitCount ==
                    half.independentStackSeedVisitCount * 2 &&
                half.capturedStackAllocationCount == 0 &&
                full.capturedStackAllocationCount == 0 &&
                full.bindingLookupVisitCount == 0 &&
                full.transitionRangeVisitCount == 0,
                "cleanup cfg smoke: 1K/2K visit counter is not linear")

fn buildFlagInitializerIdentityFixture(
        body: var coreir.BodyIR,
        plan: var cleanup.CleanupPlan,
        consumeOpIndexPlusOne: int32) =
    var ownershipIr: odir.OwnershipDropIr
    odir.OwnershipDropIrInit(ownershipIr)
    let ownershipRoot =
        odir.OwnershipDropRootScopeId(ownershipIr)
    let valueType = odir.OwnershipDropRegisterLeafType(
        ownershipIr,
        "IdentityRebaseValue",
        811)
    let sourcePlace = odir.OwnershipDropAddPlace(
        ownershipIr,
        valueType,
        odir.Owned,
        ownershipRoot)
    let sinkPlace = odir.OwnershipDropAddPlace(
        ownershipIr,
        valueType,
        odir.Owned,
        ownershipRoot)
    let ownershipEntry =
        odir.OwnershipDropAddBlock(ownershipIr, ownershipRoot)
    odir.OwnershipDropSetEntryBlock(ownershipIr, ownershipEntry)
    let initializeSource = odir.OwnershipDropAppendInitialize(
        ownershipIr,
        ownershipEntry,
        sourcePlace)
    let moveOp = odir.OwnershipDropAppendMove(
        ownershipIr,
        ownershipEntry,
        sourcePlace,
        sinkPlace)
    odir.OwnershipDropBindOpDefinitionAuthority(
        ownershipIr,
        moveOp,
        odir.DefinitionOriginTypedExpr,
        17001,
        0,
        odir.Owned)
    let ownershipExit =
        odir.OwnershipDropAddBlock(ownershipIr, ownershipRoot)
    var noCleanupIds: int32[]
    var noDeferIds: int32[]
    let _ = odir.OwnershipDropAddEdge(
        ownershipIr,
        ownershipEntry,
        ownershipExit,
        odir.OwnershipDropEdgeNormal,
        -1,
        noCleanupIds,
        noDeferIds)
    let ownershipTerminal =
        odir.OwnershipDropAddBlock(ownershipIr, ownershipRoot)
    var returnCleanupIds: int32[]
    add(returnCleanupIds, sourcePlace)
    add(returnCleanupIds, sinkPlace)
    var returnDeferIds: int32[]
    let ownershipReturnEdge = odir.OwnershipDropAddEdge(
        ownershipIr,
        ownershipExit,
        ownershipTerminal,
        odir.OwnershipDropEdgeReturn,
        -1,
        returnCleanupIds,
        returnDeferIds)
    var ownershipAnalysis: odir.OwnershipDropAnalysis
    odir.OwnershipDropAnalyze(ownershipIr, ownershipAnalysis)

    let source = addStrSlot(body, "identity_rebase_source")
    let value = addStrSlot(body, "identity_rebase_value")
    let sink = addStrSlot(body, "identity_rebase_sink")
    let deferFlag = addI32Slot(body, "identity_rebase_defer_flag")
    let moveMarker = addI32Slot(body, "identity_rebase_move_marker")
    var ownershipFlagSlots = addOwnershipConditionFlagSlots(
        body,
        ownershipAnalysis)
    smokeAssert(coreir.BodyIRDebugProvenanceBegin(body, 7000),
                "cleanup cfg smoke: debug provenance begin")
    cleanup.CleanupPlanPrepare(plan, limits(), 0)
    bindSingleLeafTypeLayout(plan, valueType)
    cleanup.CleanupPlanBindLocalSchema(plan, body)
    bindOwnershipConditionFlagSlots(plan,
                                    ownershipAnalysis,
                                    ownershipFlagSlots)
    cleanup.CleanupPlanBindOwnershipPlace(plan,
                                          sourcePlace,
                                          value,
                                          valueType)
    cleanup.CleanupPlanBindOwnershipPlace(plan,
                                          sinkPlace,
                                          sink,
                                          valueType)
    cleanup.CleanupPlanBindOwnershipDropGlue(plan,
                                             811,
                                             valueType,
                                             "op_move_target_drop")
    var fragment = callFragment(body, "identity_rebase_cleanup")
    let fragmentId = cleanup.CleanupPlanCaptureFragment(plan, fragment)
    let root = cleanup.CleanupPlanRootScopeId(plan)
    let bodyScope = cleanup.CleanupPlanAddScope(plan, root)
    let suiteScope = cleanup.CleanupPlanAddScope(plan, bodyScope)
    let _ = cleanup.CleanupPlanRegisterDefer(plan,
                                             bodyScope,
                                             suiteScope,
                                             1,
                                             deferFlag,
                                             fragmentId)

    smokeAssert(coreir.BodyIRDebugProvenanceSetExact(body, 7001),
                "cleanup cfg smoke: managed definition provenance")
    var definition: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(definition)
    definition.kind = coreir.BodyOpCopyLocalTag
    definition.target = value
    definition.valueDefSlot = value
    definition.valueDefExprNodeIndex = 17001
    definition.valueDefOwnership = coreir.OwnMove
    definition.valueDefConsumeOpIndexPlusOne = consumeOpIndexPlusOne
    definition.valueDefOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    definition.valueDefOriginId = 17001
    definition.sourceValueDefOpId = -1
    if consumeOpIndexPlusOne > 0:
        definition.consumeActionRow = 9401
    add(definition.operands, source)
    let _ = coreir.BodyIRAppendOp(body, definition)

    smokeAssert(coreir.BodyIRDebugProvenanceSetExact(body, 7002),
                "cleanup cfg smoke: managed consume provenance")
    var marker: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(marker)
    marker.kind = coreir.BodyOpLoadConstTag
    marker.target = moveMarker
    add(marker.operands, coreir.LocalI32Tag)
    add(marker.operands, 1)
    let _ = coreir.BodyIRAppendOp(body, marker)

    smokeAssert(coreir.BodyIRDebugProvenanceSetExact(body, 7003),
                "cleanup cfg smoke: source term provenance")
    var branch: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(branch)
    branch.kind = coreir.BodyTermBrTag
    branch.trueBlock = 1
    let branchTermIndex = coreir.BodyIRAppendTerm(body, branch)
    let _ = coreir.BodyIRAppendBlock(body, 0, 2, branchTermIndex)
    smokeAssert(coreir.BodyIRDebugProvenanceSetExact(body, 7004),
                "cleanup cfg smoke: target term provenance")
    let targetBlock = appendReturnBlock(body, -1)
    cleanup.CleanupPlanBindOwnershipOpTransitions(plan,
                                                   body,
                                                   ownershipAnalysis,
                                                   initializeSource,
                                                   0,
                                                   0)
    cleanup.CleanupPlanBindOwnershipOpTransitions(plan,
                                                   body,
                                                   ownershipAnalysis,
                                                   moveOp,
                                                   0,
                                                   1)
    let _ = cleanup.CleanupPlanQueueUnmanagedExit(
        plan,
        0,
        0,
        bodyScope,
        root,
        odir.OwnershipDropEdgeNormal,
        targetBlock)
    let _ = cleanup.CleanupPlanQueueOwnershipReturnExit(
        plan,
        targetBlock,
        root,
        -1,
        -1,
        ownershipIr,
        ownershipAnalysis,
        ownershipReturnEdge)

fn runFlagInitializerIdentityRebase() =
    var body = coreir.BodyIRNew()
    var plan: cleanup.CleanupPlan
    buildFlagInitializerIdentityFixture(body, plan, 0)
    let _ = cleanup.CleanupPlanMaterialize(body, plan)
    var sourceDefinitionOpId = -1
    var storeDefinitionOpId = -1
    var releaseOpId = -1
    var markerOpId = -1
    var independentCallOpId = -1
    for opIndex in 0..<body.ops.len:
        let op = body.ops[opIndex]
        if op.valueDefOriginKind ==
               coreir.BodyDefinitionOriginTypedExprTag &&
           op.valueDefOriginId == 17001:
            if sourceDefinitionOpId >= 0:
                panic(
                    "cleanup cfg smoke: typed consume definition duplicated")
            sourceDefinitionOpId = opIndex
        if body.debugOpIdsByOpIndex[opIndex] == 7002:
            markerOpId = opIndex
    smokeAssert(sourceDefinitionOpId > 0 && markerOpId >= 0,
                "cleanup cfg smoke: initializer did not rebase exact ops")
    for opIndex in 0..<body.ops.len:
        let op = body.ops[opIndex]
        if op.kind == coreir.BodyOpCopyLocalTag &&
           op.valueDefOriginKind ==
               coreir.BodyDefinitionOriginCanonicalCleanupActionTag &&
           op.sourceValueDefOpId == sourceDefinitionOpId:
            if storeDefinitionOpId >= 0:
                panic(
                    "cleanup cfg smoke: managed consume definition duplicated")
            storeDefinitionOpId = opIndex
    smokeAssert(storeDefinitionOpId >= 0,
                "cleanup cfg smoke: managed consume definition missing")
    for opIndex in 0..<body.ops.len:
        let op = body.ops[opIndex]
        if op.kind == coreir.BodyOpCallTag &&
           op.operands.len == 1:
            if op.sourceValueDefOpId == storeDefinitionOpId:
                if releaseOpId >= 0:
                    panic(
                        "cleanup cfg smoke: managed consume release duplicated")
                releaseOpId = opIndex
            elif op.sourceValueDefOpId == -1:
                if independentCallOpId >= 0:
                    panic(
                        "cleanup cfg smoke: independent cleanup call duplicated")
                independentCallOpId = opIndex
    smokeAssert(releaseOpId >= 0 && independentCallOpId >= 0,
                "cleanup cfg smoke: managed consume release missing")
    let sourceDefinition = body.ops[sourceDefinitionOpId]
    let storeDefinition = body.ops[storeDefinitionOpId]
    let releaseOp = body.ops[releaseOpId]
    let releaseCallOrdinal = releaseOp.operands[0]
    let releaseCall = body.callSequence[releaseCallOrdinal]
    smokeAssert(sourceDefinition.valueDefSlot >= 0 &&
                sourceDefinition.valueDefExprNodeIndex == 17001 &&
                sourceDefinition.valueDefOwnership == coreir.OwnMove &&
                sourceDefinition.valueDefConsumeOpIndexPlusOne ==
                    storeDefinitionOpId + 1 &&
                sourceDefinition.valueDefOriginKind ==
                    coreir.BodyDefinitionOriginTypedExprTag &&
                sourceDefinition.sourceValueDefOpId == -1 &&
                sourceDefinition.consumeActionRow ==
                    storeDefinition.valueDefOriginId &&
                storeDefinition.kind == coreir.BodyOpCopyLocalTag &&
                storeDefinition.operands.len == 1 &&
                storeDefinition.operands[0] ==
                    sourceDefinition.valueDefSlot &&
                storeDefinition.valueDefOwnership == coreir.OwnMove &&
                storeDefinition.valueDefConsumeOpIndexPlusOne ==
                    releaseOpId + 1 &&
                storeDefinition.sourceValueDefOpId ==
                    sourceDefinitionOpId &&
                storeDefinition.consumeActionRow ==
                    releaseCall.consumeActionRow &&
                releaseOp.sourceValueDefOpId ==
                    storeDefinitionOpId &&
                releaseOp.consumeActionRow ==
                    releaseCall.consumeActionRow &&
                releaseCall.sourceValueDefOpId ==
                    storeDefinitionOpId &&
                releaseCall.consumeActionRow >= 0,
                "cleanup cfg smoke: managed consume op identity not rebased")
    var accessTable = bodyaccess.BodyIrAccessDecode(body)
    smokeAssert(accessTable.valid,
                "cleanup cfg smoke: exact managed consume rejected")
    body.ops[storeDefinitionOpId].sourceValueDefOpId = -1
    accessTable = bodyaccess.BodyIrAccessDecode(body)
    smokeAssert(!accessTable.valid &&
                accessTable.errorCode ==
                    bodyaccess.BodyIrAccessOwnershipInvariantErrorCode(),
                "cleanup cfg smoke: consume deletion mutation accepted")
    body.ops[storeDefinitionOpId].sourceValueDefOpId =
        sourceDefinitionOpId
    body.ops[releaseOpId].sourceValueDefOpId =
        sourceDefinitionOpId
    body.callSequence[releaseCallOrdinal].sourceValueDefOpId =
        sourceDefinitionOpId
    accessTable = bodyaccess.BodyIrAccessDecode(body)
    smokeAssert(!accessTable.valid &&
                accessTable.errorCode ==
                    bodyaccess.BodyIrAccessOwnershipInvariantErrorCode(),
                "cleanup cfg smoke: consume swap mutation accepted")
    body.ops[releaseOpId].sourceValueDefOpId =
        storeDefinitionOpId
    body.callSequence[releaseCallOrdinal].sourceValueDefOpId =
        storeDefinitionOpId
    let independentCallOrdinal =
        body.ops[independentCallOpId].operands[0]
    body.ops[independentCallOpId].sourceValueDefOpId =
        storeDefinitionOpId
    body.ops[independentCallOpId].consumeActionRow =
        releaseCall.consumeActionRow
    body.callSequence[independentCallOrdinal].sourceValueDefOpId =
        storeDefinitionOpId
    body.callSequence[independentCallOrdinal].consumeActionRow =
        releaseCall.consumeActionRow
    accessTable = bodyaccess.BodyIrAccessDecode(body)
    smokeAssert(!accessTable.valid &&
                accessTable.errorCode ==
                    bodyaccess.BodyIrAccessOwnershipInvariantErrorCode(),
                "cleanup cfg smoke: consume duplicate mutation accepted")
    body.ops[independentCallOpId].sourceValueDefOpId = -1
    body.ops[independentCallOpId].consumeActionRow = -1
    body.callSequence[independentCallOrdinal].sourceValueDefOpId = -1
    body.callSequence[independentCallOrdinal].consumeActionRow = -1
    body.ops[sourceDefinitionOpId].valueDefConsumeOpIndexPlusOne =
        storeDefinition.valueDefConsumeOpIndexPlusOne
    body.ops[storeDefinitionOpId].valueDefConsumeOpIndexPlusOne =
        sourceDefinition.valueDefConsumeOpIndexPlusOne
    accessTable = bodyaccess.BodyIrAccessDecode(body)
    smokeAssert(!accessTable.valid &&
                accessTable.errorCode ==
                    bodyaccess.BodyIrAccessOwnershipInvariantErrorCode(),
                "cleanup cfg smoke: consume reorder mutation accepted")
    body.ops[sourceDefinitionOpId].valueDefConsumeOpIndexPlusOne =
        sourceDefinition.valueDefConsumeOpIndexPlusOne
    body.ops[storeDefinitionOpId].valueDefConsumeOpIndexPlusOne =
        storeDefinition.valueDefConsumeOpIndexPlusOne
    accessTable = bodyaccess.BodyIrAccessDecode(body)
    smokeAssert(accessTable.valid,
                "cleanup cfg smoke: consume mutation restore rejected")

    var syntheticOpId = -1
    for opIndex in 0..<body.ops.len:
        if opIndex == sourceDefinitionOpId:
            smokeAssert(body.debugOpIdsByOpIndex[opIndex] == 7001 &&
                        body.debugSyntheticKindsByOpIndex[opIndex] ==
                            coreir.BodyDebugSyntheticNone,
                        "cleanup cfg smoke: definition provenance drift")
        elif opIndex == markerOpId:
            smokeAssert(body.debugOpIdsByOpIndex[opIndex] == 7002 &&
                        body.debugSyntheticKindsByOpIndex[opIndex] ==
                            coreir.BodyDebugSyntheticNone,
                        "cleanup cfg smoke: marker provenance drift")
        else:
            smokeAssert(body.debugOpIdsByOpIndex[opIndex] == -1 &&
                        body.debugSyntheticKindsByOpIndex[opIndex] ==
                            coreir.BodyDebugSyntheticCleanup,
                        "cleanup cfg smoke: synthetic cleanup op provenance")
            if syntheticOpId < 0:
                syntheticOpId = opIndex
    smokeAssert(syntheticOpId >= 0 &&
                coreir.BodyIRDebugProvenanceShapeValid(body),
                "cleanup cfg smoke: initializer debug provenance drift")
    body.debugOpIdsByOpIndex[syntheticOpId] = 7005
    smokeAssert(!coreir.BodyIRDebugProvenanceShapeValid(body),
                "cleanup cfg smoke: mixed debug provenance mutation accepted")
    body.debugOpIdsByOpIndex[syntheticOpId] = -1
    body.debugSyntheticKindsByOpIndex[syntheticOpId] =
        coreir.BodyDebugSyntheticNone
    smokeAssert(!coreir.BodyIRDebugProvenanceShapeValid(body),
                "cleanup cfg smoke: missing synthetic provenance accepted")
    body.debugSyntheticKindsByOpIndex[syntheticOpId] =
        coreir.BodyDebugSyntheticCleanup
    smokeAssert(coreir.BodyIRDebugProvenanceShapeValid(body),
                "cleanup cfg smoke: debug provenance restore")
    var locals = zeroLocals(body)
    fixtureArenaWriteI32(body,
                         locals,
                         sourceDefinition.operands[0],
                         17)
    var log: str[]
    var ledger: OwnershipResourceLedger
    ledger.allocCount = 1
    ledger.liveOwnerCount = 1
    let _ = runBodyWithLedger(body, 0, locals, log, true, ledger)
    smokeAssert(ledger.allocCount == ledger.freeCount &&
                ledger.freeCount == 1 &&
                ledger.liveOwnerCount == 0 &&
                ledger.sourceDropCount == 1,
                "cleanup cfg smoke: managed consume ledger not closed")

fn runManagedConsumeIdentityFailure() =
    var body = coreir.BodyIRNew()
    var plan: cleanup.CleanupPlan
    buildFlagInitializerIdentityFixture(body, plan, 3)
    let _ = cleanup.CleanupPlanMaterialize(body, plan)
    panic("cleanup cfg smoke: invalid managed consume identity accepted")

fn runPositive() =
    smokeAssert(cleanup.CleanupPlanCanonicalFingerprintSchemaFieldCount() ==
                    281 &&
                cleanup.CleanupPlanLimitsCanonicalFingerprintSchemaFieldCount() ==
                    34 &&
                bodyIrCanonicalFingerprintSchemaFieldCount() == 53,
                "cleanup cfg smoke: canonical fingerprint column lock")
    let report = runNotReachedAndLifo()
    smokeAssert(report.scopeCount == 4 && report.deferCount == 2 &&
                report.exitCount == 1 && report.exitDeferRefCount == 2 &&
                report.exitedScopeVisitCount == 1 &&
                report.selectedDeferVisitCount == 2 &&
                report.lcaParentStepCount == 1,
                "cleanup cfg smoke: linear complexity counters")
    smokeAssert(report.arenaCapacityBytes == report.arenaPeakBytes &&
                report.materializedOpCount > 0 &&
                report.materializedBlockCount > 0 &&
                report.materializedTermCount > 0,
                "cleanup cfg smoke: bounded arena report")
    echo("ckpt01:runSameScopeLifoActivated()")
    runSameScopeLifoActivated()
    echo("ckpt02:runCbrOneCleanupOneDirect()")
    runCbrOneCleanupOneDirect()
    echo("ckpt03:runCbrTwoDifferentCleanup()")
    runCbrTwoDifferentCleanup()
    echo("ckpt04:runBreakContinueDoubleLoop()")
    runBreakContinueDoubleLoop()
    echo("ckpt05:runReturnSnapshotOrder()")
    runReturnSnapshotOrder()
    echo("ckpt06:runOwnedStrReturnSnapshotAccounting()")
    runOwnedStrReturnSnapshotAccounting()
    echo("ckpt07:runNestedOwnerAggregateSnapshotAccounting()")
    runNestedOwnerAggregateSnapshotAccounting()
    echo("ckpt08:runPartialAggregateFieldDropMaterialization()")
    runPartialAggregateFieldDropMaterialization()
    echo("ckpt09:runOwnershipGuardMaterialization()")
    runOwnershipGuardMaterialization()
    echo("ckpt10:runOwnedLocalNormalBreakContinue()")
    runOwnedLocalNormalBreakContinue()
    echo("ckpt11:runOwnershipOpActionMaterialization()")
    runOwnershipOpActionMaterialization()
    echo("ckpt12:runCapturedPartialFieldRetainedLifecycle()")
    runCapturedPartialFieldRetainedLifecycle()
    echo("ckpt13:runRetainedAssignLifecycle()")
    runRetainedAssignLifecycle()
    echo("ckpt14:runSameSlotRetainedAssignLifecycle()")
    runSameSlotRetainedAssignLifecycle()
    echo("ckpt15:runBorrowAddressOwnerReflow()")
    runBorrowAddressOwnerReflow()
    echo("ckpt16:runLinearComplexity2K()")
    runLinearComplexity2K()
    echo("ckpt17:runFlagInitializerIdentityRebase()")
    runFlagInitializerIdentityRebase()
    echo("ckpt18:runLoopReactivation()")
    runLoopReactivation()
    echo("cleanup_cfg_defer_contract_smoke ok")

fn main(argc: int32, argv: str*): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    let mode = cmdline.ParamStr(1)
    if len(mode) == 0:
        runPositive()
        return 0
    if mode == "duplicate-source-edge":
        runDuplicateSourceEdgeFailure()
    elif mode == "lexical-order":
        runLexicalOrderFailure()
    elif mode == "missing-snapshot":
        runMissingSnapshotFailure()
    elif mode == "return-slot-mismatch":
        runReturnSlotMismatchFailure()
    elif mode == "snapshot-schema-mismatch":
        runSnapshotSchemaMismatchFailure()
    elif mode == "guard-flag-identity":
        runGuardFlagIdentityFailure()
    elif mode == "missing-type-layout":
        runMissingTypeLayoutFailure()
    elif mode == "stale-borrow-projection":
        runStaleBorrowAddressFailure()
    elif mode == "overlapping-stack-slots":
        runOverlappingStackIntervalsFailure()
    elif mode == "noncanonical-stack-order":
        runNonCanonicalStackOrderFailure()
    elif mode == "managed-consume-identity":
        runManagedConsumeIdentityFailure()
    elif mode == "exact-managed-consume":
        runFlagInitializerIdentityRebase()
    elif mode == "missing-definition-authority":
        runOwnedStrReturnSnapshotAccounting()
    elif mode == "nested-owned-return-authority":
        runNestedOwnerAggregateSnapshotAccounting()
    elif mode == "managed-move-authority":
        runOwnershipOpActionMaterialization()
    elif mode == "bodyir-definition-carrier":
        runRetainedAssignLifecycle()
    elif mode == "captured-field-authority":
        runCapturedPartialFieldRetainedLifecycle()
    elif mode == "same-slot-retained":
        runSameSlotRetainedAssignLifecycle()
    elif mode == "owned-exit-authority":
        runOwnedLocalNormalBreakContinue()
    elif mode == "captured-old-delete-definition":
        runCapturedOldReachingDefinitionFailure(1)
    elif mode == "captured-old-change-edge":
        runCapturedOldReachingDefinitionFailure(2)
    elif mode == "captured-old-diamond-conflict":
        runCapturedOldReachingDefinitionFailure(3)
    elif mode == "captured-old-loop-redefinition":
        runCapturedOldReachingDefinitionFailure(4)
    else:
        panic("cleanup cfg smoke: unknown mode")
    return 0
