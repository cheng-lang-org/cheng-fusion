import std/cmdline as cmdline
import std/system as system
import cheng/core/analysis/cleanup_cfg as cleanup
import cheng/core/analysis/ownership_drop_ir as odir
import cheng/core/ir/core_types as coreir
import cheng/core/ir/body_ir_access as bodyaccess
import cheng/std/bytes_layout as layout

type
    ExecResult =
        returned: bool
        returnValue: int32
        lastBlockId: int32
        stepCount: int32

    FixtureByteArena =
        bytes: int32[]
        localCount: int32
        frameByteCount: int32

    OwnershipResourceLedger =
        allocCount: int32
        freeCount: int32
        retainCount: int32
        cloneCount: int32
        releaseCount: int32
        liveOwnerCount: int32
        sourceDropCount: int32
        fieldDropCount: int32
        sourceMutationCount: int32
        snapshotReleaseCount: int32
        snapshotEscapeCount: int32
        fieldDropResourceIds: int32[]

fn smokeAssert(ok: bool, message: str) =
    if !ok:
        panic(message)

fn limits(): cleanup.CleanupPlanLimits =
    var out: cleanup.CleanupPlanLimits
    out.maxSourceBlockCount = 32
    out.maxLocalSlotCount = 32
    out.maxScopeCount = 32
    out.maxDeferCount = 32
    out.maxExitCount = 32
    out.maxExitDeferRefCount = 128
    out.maxFragmentCount = 32
    out.maxFragmentOpCount = 128
    out.maxFragmentOperandCount = 512
    out.maxFragmentCallCount = 128
    out.maxFragmentCallArgCount = 256
    out.maxFragmentBlockCount = 128
    out.maxFragmentTermCount = 128
    out.maxFragmentTermOperandCount = 256
    out.maxFragmentCStringCount = 64
    out.maxStringPayloadBytes = 4096
    out.maxMaterializedOpCount = 512
    out.maxMaterializedOperandCount = 2048
    out.maxMaterializedCallCount = 256
    out.maxMaterializedCallArgCount = 512
    out.maxMaterializedBlockCount = 512
    out.maxMaterializedTermCount = 512
    out.maxMaterializedTermOperandCount = 1024
    out.maxMaterializedCStringCount = 128
    out.maxOwnershipGuardProjectionCount = 64
    out.maxOwnershipPlaceBindingCount = 64
    out.maxOwnershipFieldBindingCount = 64
    out.maxOwnershipDropGlueBindingCount = 2048
    out.maxOwnershipConditionFlagBindingCount = 128
    out.maxOwnershipActionCount = 256
    out.maxOwnershipActionFlagRefCount = 512
    out.maxOwnershipFieldProjectionStepCount = 128
    out.maxOwnershipFlagTransitionCount = 512
    out.maxOwnershipOpTransitionSiteCount = 128
    return out

fn bindSingleLeafTypeLayout(plan: var cleanup.CleanupPlan,
                            ownershipTypeId: int32) =
    smokeAssert(ownershipTypeId == 1,
                "cleanup cfg smoke: single leaf type id")
    var index: cleanup.CleanupTypeLayoutIndex
    cleanup.CleanupTypeLayoutIndexPrepare(index,
                                          "csg:layout:single-leaf:v1",
                                          1,
                                          0,
                                          0,
                                          0)
    var noFieldTypes: int32[]
    var noFieldOffsets: int32[]
    cleanup.CleanupTypeLayoutIndexRegisterType(index,
                                               ownershipTypeId,
                                               ownershipTypeId,
                                               "csg:layout:str24:v1",
                                               coreir.LocalStrTag,
                                               24,
                                               8,
                                               noFieldTypes,
                                               noFieldOffsets)
    cleanup.CleanupTypeLayoutIndexSeal(index)
    cleanup.CleanupPlanBindTypeLayoutIndex(plan, index)

fn bindOpaqueAggregateTypeLayouts(plan: var cleanup.CleanupPlan,
                                  outerTypeId: int32,
                                  aggregateSizeBytes: int32) =
    smokeAssert(outerTypeId >= 2,
                "cleanup cfg smoke: opaque aggregate type id")
    var index: cleanup.CleanupTypeLayoutIndex
    cleanup.CleanupTypeLayoutIndexPrepare(index,
                                          "csg:layout:opaque-aggregate:v1",
                                          outerTypeId,
                                          0,
                                          0,
                                          0)
    var noFieldTypes: int32[]
    var noFieldOffsets: int32[]
    cleanup.CleanupTypeLayoutIndexRegisterType(index,
                                               1,
                                               1,
                                               "csg:layout:str24:v1",
                                               coreir.LocalStrTag,
                                               24,
                                               8,
                                               noFieldTypes,
                                               noFieldOffsets)
    for typeId in 2..outerTypeId:
        cleanup.CleanupTypeLayoutIndexRegisterType(
            index,
            typeId,
            typeId,
            Fmt"csg:layout:opaque-aggregate:{typeId}:v1",
            coreir.LocalAggregateTag,
            aggregateSizeBytes,
            8,
            noFieldTypes,
            noFieldOffsets)
    cleanup.CleanupTypeLayoutIndexSeal(index)
    cleanup.CleanupPlanBindTypeLayoutIndex(plan, index)

fn bindNestedTwoLeafTypeLayout(plan: var cleanup.CleanupPlan,
                               leafTypeId: int32,
                               innerTypeId: int32,
                               outerTypeId: int32) =
    smokeAssert(leafTypeId == 1 && innerTypeId == 2 && outerTypeId == 3,
                "cleanup cfg smoke: nested type ids")
    var index: cleanup.CleanupTypeLayoutIndex
    cleanup.CleanupTypeLayoutIndexPrepare(index,
                                          "csg:layout:nested-two-leaf:v1",
                                          3,
                                          3,
                                          2,
                                          4)
    var noFieldTypes: int32[]
    var noFieldOffsets: int32[]
    cleanup.CleanupTypeLayoutIndexRegisterType(index,
                                               leafTypeId,
                                               leafTypeId,
                                               "csg:layout:str24:v1",
                                               coreir.LocalStrTag,
                                               24,
                                               8,
                                               noFieldTypes,
                                               noFieldOffsets)
    var innerFieldTypes: int32[]
    var innerFieldOffsets: int32[]
    add(innerFieldTypes, leafTypeId)
    add(innerFieldTypes, leafTypeId)
    add(innerFieldOffsets, 0)
    add(innerFieldOffsets, 24)
    cleanup.CleanupTypeLayoutIndexRegisterType(index,
                                               innerTypeId,
                                               innerTypeId,
                                               "csg:layout:inner48:v1",
                                               coreir.LocalAggregateTag,
                                               48,
                                               8,
                                               innerFieldTypes,
                                               innerFieldOffsets)
    var outerFieldTypes: int32[]
    var outerFieldOffsets: int32[]
    add(outerFieldTypes, innerTypeId)
    add(outerFieldOffsets, 0)
    cleanup.CleanupTypeLayoutIndexRegisterType(index,
                                               outerTypeId,
                                               outerTypeId,
                                               "csg:layout:outer48:v1",
                                               coreir.LocalAggregateTag,
                                               48,
                                               8,
                                               outerFieldTypes,
                                               outerFieldOffsets)
    var firstPath: int32[]
    add(firstPath, 0)
    add(firstPath, 0)
    cleanup.CleanupTypeLayoutIndexRegisterProjection(index,
                                                     outerTypeId,
                                                     0,
                                                     firstPath)
    var secondPath: int32[]
    add(secondPath, 0)
    add(secondPath, 1)
    cleanup.CleanupTypeLayoutIndexRegisterProjection(index,
                                                     outerTypeId,
                                                     1,
                                                     secondPath)
    cleanup.CleanupTypeLayoutIndexSeal(index)
    cleanup.CleanupPlanBindTypeLayoutIndex(plan, index)

fn bindNestedPartialThreeLeafTypeLayout(plan: var cleanup.CleanupPlan,
                                        leafTypeId: int32,
                                        innerTypeId: int32,
                                        outerTypeId: int32) =
    smokeAssert(leafTypeId == 1 && innerTypeId == 2 && outerTypeId == 3,
                "cleanup cfg smoke: nested partial type ids")
    var index: cleanup.CleanupTypeLayoutIndex
    cleanup.CleanupTypeLayoutIndexPrepare(index,
                                          "csg:layout:nested-partial-three-leaf",
                                          3,
                                          4,
                                          3,
                                          5)
    var noFieldTypes: int32[]
    var noFieldOffsets: int32[]
    cleanup.CleanupTypeLayoutIndexRegisterType(index,
                                               leafTypeId,
                                               leafTypeId,
                                               "csg:layout:str24",
                                               coreir.LocalStrTag,
                                               24,
                                               8,
                                               noFieldTypes,
                                               noFieldOffsets)
    var innerFieldTypes: int32[]
    var innerFieldOffsets: int32[]
    add(innerFieldTypes, leafTypeId)
    add(innerFieldTypes, leafTypeId)
    add(innerFieldOffsets, 0)
    add(innerFieldOffsets, 24)
    cleanup.CleanupTypeLayoutIndexRegisterType(
        index,
        innerTypeId,
        innerTypeId,
        "csg:layout:inner48",
        coreir.LocalAggregateTag,
        48,
        8,
        innerFieldTypes,
        innerFieldOffsets)
    var outerFieldTypes: int32[]
    var outerFieldOffsets: int32[]
    add(outerFieldTypes, innerTypeId)
    add(outerFieldTypes, leafTypeId)
    add(outerFieldOffsets, 0)
    add(outerFieldOffsets, 48)
    cleanup.CleanupTypeLayoutIndexRegisterType(
        index,
        outerTypeId,
        outerTypeId,
        "csg:layout:outer72",
        coreir.LocalAggregateTag,
        72,
        8,
        outerFieldTypes,
        outerFieldOffsets)
    var firstPath: int32[]
    add(firstPath, 0)
    add(firstPath, 0)
    cleanup.CleanupTypeLayoutIndexRegisterProjection(index,
                                                     outerTypeId,
                                                     0,
                                                     firstPath)
    var secondPath: int32[]
    add(secondPath, 0)
    add(secondPath, 1)
    cleanup.CleanupTypeLayoutIndexRegisterProjection(index,
                                                     outerTypeId,
                                                     1,
                                                     secondPath)
    var thirdPath: int32[]
    add(thirdPath, 1)
    let freeBeforeThirdProjection = system.memFreeCount()
    cleanup.CleanupTypeLayoutIndexRegisterProjection(index,
                                                     outerTypeId,
                                                     2,
                                                     thirdPath)
    smokeAssert(system.memFreeCount() > freeBeforeThirdProjection,
                "cleanup cfg smoke: type layout mutation releases old Seq owners")
    cleanup.CleanupTypeLayoutIndexSeal(index)
    cleanup.CleanupPlanBindTypeLayoutIndex(plan, index)

fn nextFixtureStackOffset(bodyIR: var coreir.BodyIR): int32 =
    var requiredEnd = 64
    for slotIndex in 0..<bodyIR.localSlots.len:
        let slot = bodyIR.localSlots[slotIndex]
        if slot.placeKind == coreir.BodyPlaceBorrowAddressTag:
            continue
        let slotEnd = slot.stackOffset + slot.sizeBytes
        if slotEnd > requiredEnd:
            requiredEnd = slotEnd
    var out = 64
    while out < requiredEnd:
        out = out + 64
    return out

fn addI32Slot(bodyIR: var coreir.BodyIR, name: str): int32 =
    var slot: coreir.LocalSlot
    slot.id = bodyIR.localSlots.len
    slot.name = name
    slot.typeKind = coreir.LocalI32Tag
    slot.stackOffset = nextFixtureStackOffset(bodyIR)
    slot.sizeBytes = 4
    slot.alignBytes = 4
    coreir.BodyIRApplyLocalSlotDefaultProof(slot)
    add(bodyIR.localSlots, slot)
    return slot.id

fn addI64Slot(bodyIR: var coreir.BodyIR, name: str): int32 =
    var slot: coreir.LocalSlot
    slot.id = bodyIR.localSlots.len
    slot.name = name
    slot.typeKind = coreir.LocalI64Tag
    slot.stackOffset = nextFixtureStackOffset(bodyIR)
    slot.sizeBytes = 8
    slot.alignBytes = 8
    coreir.BodyIRApplyLocalSlotDefaultProof(slot)
    add(bodyIR.localSlots, slot)
    return slot.id

fn addManagedSlot(bodyIR: var coreir.BodyIR,
                  name: str,
                  typeKind: int32,
                  sizeBytes: int32): int32 =
    if typeKind != coreir.LocalStrTag &&
       typeKind != coreir.LocalAggregateTag:
        panic("cleanup cfg smoke: managed slot kind")
    var slot: coreir.LocalSlot
    slot.id = bodyIR.localSlots.len
    slot.name = name
    slot.typeKind = typeKind
    slot.stackOffset = nextFixtureStackOffset(bodyIR)
    slot.sizeBytes = sizeBytes
    slot.alignBytes = 8
    coreir.BodyIRApplyLocalSlotDefaultProof(slot)
    add(bodyIR.localSlots, slot)
    return slot.id

fn addStrSlot(bodyIR: var coreir.BodyIR, name: str): int32 =
    return addManagedSlot(bodyIR, name, coreir.LocalStrTag, 24)

fn addAggregateSlot(bodyIR: var coreir.BodyIR, name: str): int32 =
    return addManagedSlot(bodyIR, name, coreir.LocalAggregateTag, 24)

fn appendConstOp(bodyIR: var coreir.BodyIR,
                 targetSlot: int32,
                 value: int32): int32 =
    var op: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = coreir.BodyOpLoadConstTag
    op.target = targetSlot
    add(op.operands, bodyIR.localSlots[targetSlot].typeKind)
    add(op.operands, value)
    add(bodyIR.ops, op)
    return bodyIR.ops.len - 1

fn appendCopyOp(bodyIR: var coreir.BodyIR,
                sourceSlot: int32,
                targetSlot: int32): int32 =
    var op: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = coreir.BodyOpCopyLocalTag
    op.target = targetSlot
    add(op.operands, sourceSlot)
    add(bodyIR.ops, op)
    return bodyIR.ops.len - 1

fn bindTypedManagedDefinition(bodyIR: var coreir.BodyIR,
                              opIndex: int32,
                              slot: int32,
                              exprNodeIndex: int32) =
    smokeAssert(opIndex >= 0 && opIndex < bodyIR.ops.len &&
                slot >= 0 && slot < bodyIR.localSlots.len &&
                exprNodeIndex >= 0,
                "cleanup cfg smoke: managed definition fixture identity")
    bodyIR.ops[opIndex].valueDefSlot = slot
    bodyIR.ops[opIndex].valueDefExprNodeIndex = exprNodeIndex
    bodyIR.ops[opIndex].valueDefOwnership = coreir.OwnMove
    bodyIR.ops[opIndex].valueDefOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    bodyIR.ops[opIndex].valueDefOriginId = exprNodeIndex

fn assertCapturedOldDefinitionChain(
        bodyIR: var coreir.BodyIR,
        targetExprNodeIndex: int32,
        capturedSlot: int32,
        storeActionRow: int32,
        dropActionRow: int32) =
    var targetDefinitionOpId = -1
    var capturedDefinitionOpId = -1
    for opIndex in 0..<bodyIR.ops.len:
        let op = bodyIR.ops[opIndex]
        if op.valueDefOriginKind ==
               coreir.BodyDefinitionOriginTypedExprTag &&
           op.valueDefExprNodeIndex == targetExprNodeIndex:
            if targetDefinitionOpId >= 0:
                panic("cleanup cfg smoke: target definition duplicated")
            targetDefinitionOpId = opIndex
        if op.valueDefOriginKind ==
               coreir.BodyDefinitionOriginCanonicalCleanupActionTag &&
           op.valueDefOriginId == storeActionRow &&
           op.valueDefSlot == capturedSlot:
            if capturedDefinitionOpId >= 0:
                panic("cleanup cfg smoke: captured definition duplicated")
            capturedDefinitionOpId = opIndex
    smokeAssert(targetDefinitionOpId >= 0 &&
                capturedDefinitionOpId >= 0,
                "cleanup cfg smoke: captured definition chain missing")
    let releaseOpId =
        bodyIR.ops[capturedDefinitionOpId].valueDefConsumeOpIndexPlusOne - 1
    let definitionEdgesExact =
        bodyIR.ops[capturedDefinitionOpId].sourceValueDefOpId ==
            targetDefinitionOpId &&
        bodyIR.ops[targetDefinitionOpId].valueDefConsumeOpIndexPlusOne ==
            capturedDefinitionOpId + 1 &&
        bodyIR.ops[targetDefinitionOpId].consumeActionRow ==
            storeActionRow &&
        releaseOpId > capturedDefinitionOpId &&
        releaseOpId < bodyIR.ops.len
    smokeAssert(definitionEdgesExact &&
                bodyIR.ops[releaseOpId].kind == coreir.BodyOpCallTag &&
                bodyIR.ops[releaseOpId].sourceValueDefOpId ==
                    capturedDefinitionOpId &&
                bodyIR.ops[releaseOpId].operands.len == 1,
        "cleanup cfg smoke: captured definition op edge drift")
    let callOrdinal = bodyIR.ops[releaseOpId].operands[0]
    smokeAssert(callOrdinal >= 0 &&
                callOrdinal < bodyIR.callSequence.len &&
                bodyIR.callSequence[callOrdinal].sourceValueDefOpId ==
                    capturedDefinitionOpId &&
                bodyIR.callSequence[callOrdinal].consumeActionRow ==
                    dropActionRow &&
                bodyIR.ops[capturedDefinitionOpId].consumeActionRow ==
                    dropActionRow,
                "cleanup cfg smoke: captured release call edge drift")

fn addOwnershipConditionFlagSlots(
        bodyIR: var coreir.BodyIR,
        analysis: var odir.OwnershipDropAnalysis): int32[] =
    var out: int32[]
    let count = odir.OwnershipDropAnalysisConditionFlagCount(analysis)
    for flagId in 1..count:
        let flag = odir.OwnershipDropAnalysisConditionFlag(analysis, flagId)
        var slot = -1
        if flag.kind != odir.ConditionFlagDeferActive:
            slot = addI32Slot(bodyIR, Fmt"ownership_flag_{flagId}")
        add(out, slot)
    return out

fn bindOwnershipConditionFlagSlots(
        plan: var cleanup.CleanupPlan,
        analysis: var odir.OwnershipDropAnalysis,
        slots: var int32[]) =
    let count = odir.OwnershipDropAnalysisConditionFlagCount(analysis)
    if slots.len != count:
        panic("cleanup cfg smoke: ownership flag slot map")
    for flagId in 1..count:
        let flag = odir.OwnershipDropAnalysisConditionFlag(analysis, flagId)
        if flag.kind != odir.ConditionFlagDeferActive:
            cleanup.CleanupPlanBindOwnershipConditionFlag(plan,
                                                          analysis,
                                                          flagId,
                                                          slots[flagId - 1])

fn ownershipFlagSlot(
        analysis: var odir.OwnershipDropAnalysis,
        slots: var int32[],
        kind: odir.OwnershipDropConditionFlagKind,
        placeId: int32,
        fieldOrdinal: int32): int32 =
    let count = odir.OwnershipDropAnalysisConditionFlagCount(analysis)
    for flagId in 1..count:
        let flag = odir.OwnershipDropAnalysisConditionFlag(analysis, flagId)
        if flag.kind == kind && flag.placeId == placeId &&
           flag.fieldOrdinal == fieldOrdinal:
            return slots[flagId - 1]
    panic("cleanup cfg smoke: ownership flag lookup")
    return -1

fn copyLocalSchema(source: var coreir.BodyIR,
                   target: var coreir.BodyIR) =
    for i in 0..<source.localSlots.len:
        add(target.localSlots, source.localSlots[i])

fn callFragment(schema: var coreir.BodyIR,
                symbol: str): coreir.BodyIR =
    var out = coreir.BodyIRNew()
    copyLocalSchema(schema, out)
    var call: coreir.CallOp
    coreir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = symbol
    call.resultSlot = -1
    call.resultPassKind = coreir.BodyCallPassStackValueTag
    add(out.callSequence, call)
    var op: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = coreir.BodyOpCallTag
    op.target = -1
    add(op.operands, 0)
    add(out.ops, op)
    var exitTerm: coreir.BodyTerm
    exitTerm.kind = coreir.BodyTermReturnTag
    exitTerm.resultSlot = -1
    let termIndex = coreir.BodyIRAppendTerm(out, exitTerm)
    let _ = coreir.BodyIRAppendBlock(out, 0, 1, termIndex)
    return out

fn writeAndCallFragment(schema: var coreir.BodyIR,
                        targetSlot: int32,
                        value: int32,
                        symbol: str): coreir.BodyIR =
    var out = coreir.BodyIRNew()
    copyLocalSchema(schema, out)
    var write: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(write)
    write.kind = coreir.BodyOpLoadConstTag
    write.target = targetSlot
    add(write.operands, coreir.LocalI32Tag)
    add(write.operands, value)
    add(out.ops, write)
    var call: coreir.CallOp
    coreir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = symbol
    call.resultSlot = -1
    call.resultPassKind = coreir.BodyCallPassStackValueTag
    add(out.callSequence, call)
    var callOp: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(callOp)
    callOp.kind = coreir.BodyOpCallTag
    callOp.target = -1
    add(callOp.operands, 0)
    add(out.ops, callOp)
    var exitTerm: coreir.BodyTerm
    exitTerm.kind = coreir.BodyTermReturnTag
    exitTerm.resultSlot = -1
    let termIndex = coreir.BodyIRAppendTerm(out, exitTerm)
    let _ = coreir.BodyIRAppendBlock(out, 0, 2, termIndex)
    return out

fn ownedMutationFragment(schema: var coreir.BodyIR,
                         sourceSlot: int32,
                         symbol: str): coreir.BodyIR =
    var out = coreir.BodyIRNew()
    copyLocalSchema(schema, out)
    var call: coreir.CallOp
    coreir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = symbol
    call.resultSlot = -1
    call.resultPassKind = coreir.BodyCallPassStackValueTag
    call.relocWordOffset = -1
    add(call.argSlots, coreir.CallArgSlotAddress(sourceSlot))
    add(call.argPassKinds, coreir.BodyCallPassByAddressAggregateTag)
    add(call.argAbiSizes, 8)
    add(out.callSequence, call)
    var op: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = coreir.BodyOpCallTag
    op.target = -1
    add(op.operands, 0)
    add(out.ops, op)
    var exitTerm: coreir.BodyTerm
    exitTerm.kind = coreir.BodyTermReturnTag
    exitTerm.resultSlot = -1
    let termIndex = coreir.BodyIRAppendTerm(out, exitTerm)
    let _ = coreir.BodyIRAppendBlock(out, 0, 1, termIndex)
    return out

fn fixtureCallAddressSource(call: coreir.CallOp): int32 =
    if call.argSlots.len != 1 || call.argPassKinds.len != 1 ||
       call.argPassKinds[0] != coreir.BodyCallPassByAddressAggregateTag ||
       !coreir.CallArgSlotIsAddress(call.argSlots[0]):
        panic("cleanup cfg smoke: ownership fixture call ABI")
    return coreir.CallArgSlotAddressId(call.argSlots[0])

fn fixtureCallPhysicalSource(bodyIR: var coreir.BodyIR,
                             call: coreir.CallOp): int32 =
    let addressSlot = fixtureCallAddressSource(call)
    if addressSlot < 0 || addressSlot >= bodyIR.localSlots.len:
        panic("cleanup cfg smoke: ownership fixture address range")
    let slot = bodyIR.localSlots[addressSlot]
    if slot.placeKind == coreir.BodyPlaceBorrowAddressTag:
        if slot.auxValue < 0 || slot.auxValue >= bodyIR.localSlots.len ||
           slot.noAlias:
            panic("cleanup cfg smoke: field projection alias contract")
        return addressSlot
    return addressSlot

fn appendReturnBlock(bodyIR: var coreir.BodyIR,
                     resultSlot: int32): int32 =
    var term: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = coreir.BodyTermReturnTag
    term.resultSlot = resultSlot
    let termIndex = coreir.BodyIRAppendTerm(bodyIR, term)
    return coreir.BodyIRAppendBlock(bodyIR, bodyIR.ops.len, 0, termIndex)

fn requireOwnershipLedgerValid(ledger: var OwnershipResourceLedger) =
    if ledger.allocCount < 0 || ledger.freeCount < 0 ||
       ledger.retainCount < 0 || ledger.cloneCount < 0 ||
       ledger.releaseCount < 0 || ledger.liveOwnerCount < 0 ||
       ledger.freeCount > ledger.allocCount ||
       ledger.sourceDropCount > ledger.freeCount ||
       ledger.snapshotReleaseCount > 1:
        panic("cleanup cfg smoke: ownership resource ledger corrupt")

fn applyOwnershipFixtureCall(bodyIR: var coreir.BodyIR,
                             call: coreir.CallOp,
                             locals: var FixtureByteArena,
                             ledger: var OwnershipResourceLedger) =
    let symbol = call.targetSymbol
    if symbol == "owned_str_snapshot_retain":
        ledger.retainCount = ledger.retainCount + 1
        ledger.liveOwnerCount = ledger.liveOwnerCount + 1
    elif symbol == "nested_owner_snapshot_clone":
        ledger.cloneCount = ledger.cloneCount + 3
        ledger.allocCount = ledger.allocCount + 3
        ledger.liveOwnerCount = ledger.liveOwnerCount + 3
    elif symbol == "owned_str_defer_mutate":
        let sourceSlot = fixtureCallPhysicalSource(bodyIR, call)
        if fixtureArenaReadI32(bodyIR, locals, sourceSlot) == 0:
            panic("cleanup cfg smoke: owned str defer observed dropped source")
        ledger.releaseCount = ledger.releaseCount + 1
        ledger.liveOwnerCount = ledger.liveOwnerCount - 1
        ledger.allocCount = ledger.allocCount + 1
        ledger.liveOwnerCount = ledger.liveOwnerCount + 1
        ledger.sourceMutationCount = ledger.sourceMutationCount + 1
        fixtureArenaWriteI32(bodyIR, locals, sourceSlot, 99)
    elif symbol == "nested_owner_defer_mutate":
        let sourceSlot = fixtureCallPhysicalSource(bodyIR, call)
        if fixtureArenaReadI32(bodyIR, locals, sourceSlot) == 0:
            panic("cleanup cfg smoke: nested defer observed dropped source")
        ledger.releaseCount = ledger.releaseCount + 3
        ledger.freeCount = ledger.freeCount + 3
        ledger.liveOwnerCount = ledger.liveOwnerCount - 3
        ledger.allocCount = ledger.allocCount + 3
        ledger.liveOwnerCount = ledger.liveOwnerCount + 3
        ledger.sourceMutationCount = ledger.sourceMutationCount + 1
        fixtureArenaWriteI32(bodyIR, locals, sourceSlot, 88)
    elif symbol == "owned_str_source_drop":
        let sourceSlot = fixtureCallPhysicalSource(bodyIR, call)
        if fixtureArenaReadI32(bodyIR, locals, sourceSlot) != 99:
            panic("cleanup cfg smoke: owned str source drop missed defer mutation")
        ledger.sourceDropCount = ledger.sourceDropCount + 1
        ledger.releaseCount = ledger.releaseCount + 1
        ledger.freeCount = ledger.freeCount + 1
        ledger.liveOwnerCount = ledger.liveOwnerCount - 1
        fixtureArenaWriteI32(bodyIR, locals, sourceSlot, 0)
    elif symbol == "nested_owner_source_drop":
        let sourceSlot = fixtureCallPhysicalSource(bodyIR, call)
        if fixtureArenaReadI32(bodyIR, locals, sourceSlot) != 88:
            panic("cleanup cfg smoke: nested source drop missed defer mutation")
        ledger.sourceDropCount = ledger.sourceDropCount + 1
        ledger.releaseCount = ledger.releaseCount + 3
        ledger.freeCount = ledger.freeCount + 3
        ledger.liveOwnerCount = ledger.liveOwnerCount - 3
        fixtureArenaWriteI32(bodyIR, locals, sourceSlot, 0)
    elif symbol == "owned_str_snapshot_release":
        let snapshotSlot = fixtureCallPhysicalSource(bodyIR, call)
        if fixtureArenaReadI32(bodyIR, locals, snapshotSlot) != 7:
            panic("cleanup cfg smoke: owned str escaped snapshot changed")
        ledger.snapshotReleaseCount = ledger.snapshotReleaseCount + 1
        ledger.releaseCount = ledger.releaseCount + 1
        ledger.freeCount = ledger.freeCount + 1
        ledger.liveOwnerCount = ledger.liveOwnerCount - 1
        fixtureArenaWriteI32(bodyIR, locals, snapshotSlot, 0)
    elif symbol == "nested_owner_snapshot_release":
        let snapshotSlot = fixtureCallPhysicalSource(bodyIR, call)
        if fixtureArenaReadI32(bodyIR, locals, snapshotSlot) != 17:
            panic("cleanup cfg smoke: nested escaped snapshot changed")
        ledger.snapshotReleaseCount = ledger.snapshotReleaseCount + 1
        ledger.releaseCount = ledger.releaseCount + 3
        ledger.freeCount = ledger.freeCount + 3
        ledger.liveOwnerCount = ledger.liveOwnerCount - 3
        fixtureArenaWriteI32(bodyIR, locals, snapshotSlot, 0)
    elif symbol == "guarded_owner_drop":
        let sourceSlot = fixtureCallPhysicalSource(bodyIR, call)
        if fixtureArenaReadI32(bodyIR, locals, sourceSlot) == 0:
            panic("cleanup cfg smoke: guarded owner double drop")
        ledger.sourceDropCount = ledger.sourceDropCount + 1
        ledger.releaseCount = ledger.releaseCount + 1
        ledger.freeCount = ledger.freeCount + 1
        ledger.liveOwnerCount = ledger.liveOwnerCount - 1
        fixtureArenaWriteI32(bodyIR, locals, sourceSlot, 0)
    elif symbol == "partial_leaf_drop":
        let fieldSlot = fixtureCallPhysicalSource(bodyIR, call)
        let resourceId = fixtureArenaReadI32(bodyIR, locals, fieldSlot)
        if resourceId == 0:
            panic("cleanup cfg smoke: partial field double drop")
        add(ledger.fieldDropResourceIds, resourceId)
        ledger.fieldDropCount = ledger.fieldDropCount + 1
        ledger.releaseCount = ledger.releaseCount + 1
        ledger.freeCount = ledger.freeCount + 1
        ledger.liveOwnerCount = ledger.liveOwnerCount - 1
        fixtureArenaWriteI32(bodyIR, locals, fieldSlot, 0)
    elif symbol == "owned_exit_source_drop":
        let sourceSlot = fixtureCallPhysicalSource(bodyIR, call)
        if fixtureArenaReadI32(bodyIR, locals, sourceSlot) != 42:
            panic("cleanup cfg smoke: owned exit source value drift")
        ledger.sourceDropCount = ledger.sourceDropCount + 1
        ledger.releaseCount = ledger.releaseCount + 1
        ledger.freeCount = ledger.freeCount + 1
        ledger.liveOwnerCount = ledger.liveOwnerCount - 1
        fixtureArenaWriteI32(bodyIR, locals, sourceSlot, 0)
    elif symbol == "op_move_target_drop":
        let targetSlot = fixtureCallPhysicalSource(bodyIR, call)
        let value = fixtureArenaReadI32(bodyIR, locals, targetSlot)
        if value != 23 && value != 17:
            panic("cleanup cfg smoke: op action drop value authority drift")
        ledger.sourceDropCount = ledger.sourceDropCount + 1
        ledger.releaseCount = ledger.releaseCount + 1
        ledger.freeCount = ledger.freeCount + 1
        ledger.liveOwnerCount = ledger.liveOwnerCount - 1
        fixtureArenaWriteI32(bodyIR, locals, targetSlot, 0)
    elif symbol == "retained_assign_retain":
        let sourceSlot = fixtureCallPhysicalSource(bodyIR, call)
        if fixtureArenaReadI32(bodyIR, locals, sourceSlot) != 31:
            panic("cleanup cfg smoke: retained source value drift")
        ledger.retainCount = ledger.retainCount + 1
        ledger.liveOwnerCount = ledger.liveOwnerCount + 1
    elif symbol == "retained_assign_drop":
        let capturedSlot = fixtureCallPhysicalSource(bodyIR, call)
        if fixtureArenaReadI32(bodyIR, locals, capturedSlot) != 41:
            panic("cleanup cfg smoke: retained drop did not consume old snapshot")
        ledger.releaseCount = ledger.releaseCount + 1
        ledger.freeCount = ledger.freeCount + 1
        ledger.liveOwnerCount = ledger.liveOwnerCount - 1
        fixtureArenaWriteI32(bodyIR, locals, capturedSlot, 0)
    elif symbol == "same_slot_retained_retain":
        let sourceSlot = fixtureCallPhysicalSource(bodyIR, call)
        if fixtureArenaReadI32(bodyIR, locals, sourceSlot) != 41:
            panic("cleanup cfg smoke: same-slot retained source value drift")
        ledger.retainCount = ledger.retainCount + 1
        ledger.liveOwnerCount = ledger.liveOwnerCount + 1
    elif symbol == "same_slot_retained_drop":
        let capturedSlot = fixtureCallPhysicalSource(bodyIR, call)
        if fixtureArenaReadI32(bodyIR, locals, capturedSlot) != 41:
            panic("cleanup cfg smoke: same-slot retained drop value drift")
        ledger.releaseCount = ledger.releaseCount + 1
        ledger.freeCount = ledger.freeCount + 1
        ledger.liveOwnerCount = ledger.liveOwnerCount - 1
        fixtureArenaWriteI32(bodyIR, locals, capturedSlot, 0)
    elif symbol == "captured_partial_retain":
        let sourceSlot = fixtureCallPhysicalSource(bodyIR, call)
        if fixtureArenaReadI32At(
               bodyIR, locals, sourceSlot, 0) != 31 ||
           fixtureArenaReadI32At(
               bodyIR, locals, sourceSlot, 24) != 32 ||
           fixtureArenaReadI32At(
               bodyIR, locals, sourceSlot, 48) != 33:
            panic("cleanup cfg smoke: captured partial retain source drift")
        ledger.retainCount = ledger.retainCount + 3
        ledger.liveOwnerCount = ledger.liveOwnerCount + 3
    elif symbol == "captured_partial_leaf_drop":
        let fieldSlot = fixtureCallPhysicalSource(bodyIR, call)
        if fixtureArenaReadI32(bodyIR, locals, fieldSlot) != 41:
            panic("cleanup cfg smoke: captured partial field value drift")
        ledger.fieldDropCount = ledger.fieldDropCount + 1
        ledger.releaseCount = ledger.releaseCount + 1
        ledger.freeCount = ledger.freeCount + 1
        ledger.liveOwnerCount = ledger.liveOwnerCount - 1
        fixtureArenaWriteI32(bodyIR, locals, fieldSlot, 0)
    elif symbol == "captured_partial_owner_drop":
        let ownerSlot = fixtureCallPhysicalSource(bodyIR, call)
        if fixtureArenaReadI32At(bodyIR, locals, ownerSlot, 0) == 0 ||
           fixtureArenaReadI32At(bodyIR, locals, ownerSlot, 24) == 0 ||
           fixtureArenaReadI32At(bodyIR, locals, ownerSlot, 48) == 0:
            panic("cleanup cfg smoke: captured partial owner value drift")
        fixtureArenaWriteI32At(bodyIR, locals, ownerSlot, 0, 0)
        fixtureArenaWriteI32At(bodyIR, locals, ownerSlot, 24, 0)
        fixtureArenaWriteI32At(bodyIR, locals, ownerSlot, 48, 0)
        ledger.sourceDropCount = ledger.sourceDropCount + 1
        ledger.releaseCount = ledger.releaseCount + 3
        ledger.freeCount = ledger.freeCount + 3
        ledger.liveOwnerCount = ledger.liveOwnerCount - 3
    requireOwnershipLedgerValid(ledger)

fn runBodyWithLedger(bodyIR: var coreir.BodyIR,
                     startBlockId: int32,
                     locals: var FixtureByteArena,
                     log: var str[],
                     trackOwnership: bool,
                     ledger: var OwnershipResourceLedger): ExecResult =
    if locals.localCount != bodyIR.localSlots.len:
        panic("cleanup cfg smoke: interpreter local count")
    var out: ExecResult
    var blockId = startBlockId
    while !out.returned:
        out.stepCount = out.stepCount + 1
        if out.stepCount > 512:
            panic("cleanup cfg smoke: interpreter step bound")
        if blockId < 0 || blockId >= bodyIR.blocks.len:
            panic("cleanup cfg smoke: interpreter block range")
        out.lastBlockId = blockId
        let block = bodyIR.blocks[blockId]
        for opIndex in block.opStart..<(block.opStart + block.opCount):
            let op = bodyIR.ops[opIndex]
            if op.kind == coreir.BodyOpLoadConstTag:
                if op.target < 0 || op.target >= locals.localCount ||
                   op.operands.len < 2:
                    panic("cleanup cfg smoke: malformed const op")
                fixtureArenaWriteI32(bodyIR,
                                     locals,
                                     op.target,
                                     op.operands[1])
            elif op.kind == coreir.BodyOpCopyLocalTag:
                if op.target < 0 || op.target >= locals.localCount ||
                   op.operands.len < 1 || op.operands[0] < 0 ||
                   op.operands[0] >= locals.localCount:
                    panic("cleanup cfg smoke: malformed copy op")
                fixtureArenaCopySlot(bodyIR,
                                     locals,
                                     op.operands[0],
                                     op.target)
            elif op.kind == coreir.BodyOpCallTag:
                if op.operands.len != 1 || op.operands[0] < 0 ||
                   op.operands[0] >= bodyIR.callSequence.len:
                    panic("cleanup cfg smoke: malformed call op")
                let call = bodyIR.callSequence[op.operands[0]]
                add(log, call.targetSymbol)
                if call.resultSlot >= 0:
                    if call.resultSlot >= locals.localCount ||
                       call.resultPassKind != coreir.BodyCallPassSretResultTag:
                        panic("cleanup cfg smoke: snapshot call result ABI")
                    let sourceSlot = fixtureCallAddressSource(call)
                    if sourceSlot < 0 || sourceSlot >= locals.localCount:
                        panic("cleanup cfg smoke: snapshot call source")
                    fixtureArenaCopySlot(bodyIR,
                                         locals,
                                         sourceSlot,
                                         call.resultSlot)
                if trackOwnership:
                    applyOwnershipFixtureCall(bodyIR, call, locals, ledger)
            else:
                panic("cleanup cfg smoke: interpreter unsupported op")
        let term = bodyIR.terms[block.termIndex]
        if term.kind == coreir.BodyTermReturnTag:
            out.returned = true
            if term.resultSlot >= 0:
                out.returnValue = fixtureArenaReadI32(bodyIR,
                                                      locals,
                                                      term.resultSlot)
                if trackOwnership:
                    ledger.snapshotEscapeCount =
                        ledger.snapshotEscapeCount + 1
                    if ledger.snapshotEscapeCount != 1:
                        panic("cleanup cfg smoke: snapshot escaped more than once")
        elif term.kind == coreir.BodyTermBrTag:
            blockId = term.trueBlock
        elif term.kind == coreir.BodyTermCbrTag:
            var cond: bool
            if term.conditionKind == coreir.BodyCondLocalNonZeroTag:
                cond = fixtureArenaReadI32(bodyIR,
                                           locals,
                                           term.lhsSlot) != 0
            elif term.conditionKind == coreir.BodyCondLocalZeroTag:
                cond = fixtureArenaReadI32(bodyIR,
                                           locals,
                                           term.lhsSlot) == 0
            else:
                panic("cleanup cfg smoke: interpreter condition kind")
            if cond:
                blockId = term.trueBlock
            else:
                blockId = term.falseBlock
        else:
            panic("cleanup cfg smoke: interpreter term kind")
    return out

fn runBody(bodyIR: var coreir.BodyIR,
           startBlockId: int32,
           locals: var FixtureByteArena,
           log: var str[]): ExecResult =
    var ledger: OwnershipResourceLedger
    return runBodyWithLedger(bodyIR,
                             startBlockId,
                             locals,
                             log,
                             false,
                             ledger)

fn fixtureArenaRequireSlot(bodyIR: var coreir.BodyIR,
                           arena: var FixtureByteArena,
                           slotId: int32) =
    if arena.localCount != bodyIR.localSlots.len || slotId < 0 ||
       slotId >= bodyIR.localSlots.len:
        panic("cleanup cfg smoke: byte arena slot range")
    let slot = bodyIR.localSlots[slotId]
    if slot.stackOffset < 0 || slot.sizeBytes <= 0 ||
       slot.stackOffset + slot.sizeBytes > arena.frameByteCount:
        panic("cleanup cfg smoke: byte arena physical range")

fn fixtureArenaReadI32(bodyIR: var coreir.BodyIR,
                       arena: var FixtureByteArena,
                       slotId: int32): int32 =
    fixtureArenaRequireSlot(bodyIR, arena, slotId)
    let slot = bodyIR.localSlots[slotId]
    if slot.sizeBytes < 4:
        panic("cleanup cfg smoke: byte arena i32 slot too small")
    let base = slot.stackOffset
    return arena.bytes[base] +
           arena.bytes[base + 1] * 256 +
           arena.bytes[base + 2] * 65536 +
           arena.bytes[base + 3] * 16777216

fn fixtureArenaReadI32At(bodyIR: var coreir.BodyIR,
                         arena: var FixtureByteArena,
                         slotId: int32,
                         relativeOffset: int32): int32 =
    fixtureArenaRequireSlot(bodyIR, arena, slotId)
    if relativeOffset < 0 || relativeOffset + 4 >
       bodyIR.localSlots[slotId].sizeBytes:
        panic("cleanup cfg smoke: byte arena relative read invalid")
    let base =
        bodyIR.localSlots[slotId].stackOffset + relativeOffset
    return arena.bytes[base] +
           arena.bytes[base + 1] * 256 +
           arena.bytes[base + 2] * 65536 +
           arena.bytes[base + 3] * 16777216

fn fixtureArenaWriteI32(bodyIR: var coreir.BodyIR,
                        arena: var FixtureByteArena,
                        slotId: int32,
                        value: int32) =
    fixtureArenaRequireSlot(bodyIR, arena, slotId)
    if value < 0 || bodyIR.localSlots[slotId].sizeBytes < 4:
        panic("cleanup cfg smoke: byte arena i32 write invalid")
    let base = bodyIR.localSlots[slotId].stackOffset
    arena.bytes[base] = value % 256
    arena.bytes[base + 1] = (value / 256) % 256
    arena.bytes[base + 2] = (value / 65536) % 256
    arena.bytes[base + 3] = (value / 16777216) % 256

fn fixtureArenaWriteI32At(bodyIR: var coreir.BodyIR,
                          arena: var FixtureByteArena,
                          slotId: int32,
                          relativeOffset: int32,
                          value: int32) =
    fixtureArenaRequireSlot(bodyIR, arena, slotId)
    if relativeOffset < 0 || relativeOffset + 4 >
       bodyIR.localSlots[slotId].sizeBytes:
        panic("cleanup cfg smoke: byte arena relative write invalid")
    let absoluteOffset = bodyIR.localSlots[slotId].stackOffset +
                         relativeOffset
    if value < 0:
        panic("cleanup cfg smoke: byte arena relative value invalid")
    arena.bytes[absoluteOffset] = value % 256
    arena.bytes[absoluteOffset + 1] = (value / 256) % 256
    arena.bytes[absoluteOffset + 2] = (value / 65536) % 256
    arena.bytes[absoluteOffset + 3] = (value / 16777216) % 256

fn fixtureArenaCopySlot(bodyIR: var coreir.BodyIR,
                        arena: var FixtureByteArena,
                        sourceSlot: int32,
                        targetSlot: int32) =
    fixtureArenaRequireSlot(bodyIR, arena, sourceSlot)
    fixtureArenaRequireSlot(bodyIR, arena, targetSlot)
    let source = bodyIR.localSlots[sourceSlot]
    let target = bodyIR.localSlots[targetSlot]
    if source.sizeBytes != target.sizeBytes:
        panic("cleanup cfg smoke: byte arena copy size mismatch")
    for byteOffset in 0..<source.sizeBytes:
        arena.bytes[target.stackOffset + byteOffset] =
            arena.bytes[source.stackOffset + byteOffset]

fn zeroLocals(bodyIR: var coreir.BodyIR): FixtureByteArena =
    var out: FixtureByteArena
    out.localCount = bodyIR.localSlots.len
    for slotIndex in 0..<bodyIR.localSlots.len:
        let slot = bodyIR.localSlots[slotIndex]
        let slotEnd = slot.stackOffset + slot.sizeBytes
        if slotEnd > out.frameByteCount:
            out.frameByteCount = slotEnd
    for _ in 0..<out.frameByteCount:
        add(out.bytes, 0)
    return out

fn smokeFingerprintMix(seed: int64, value: int32): int64 =
    return (seed * int64(65599) + int64(value) +
            int64(2147483647) + int64(1)) % int64(2147483647)

fn smokeFingerprintText(seed: int64, value: str): int64 =
    var out = smokeFingerprintMix(seed, len(value))
    for i in 0..<len(value):
        out = smokeFingerprintMix(out, int32(value[i]))
    return out

fn smokeFingerprintBool(seed: int64, value: bool): int64 =
    if value:
        return smokeFingerprintMix(seed, 1)
    return smokeFingerprintMix(seed, 0)

fn smokeFingerprintFixedBytes32(
        seed: int64,
        value: layout.FixedBytes32): int64 =
    var out = seed
    for index in 0..<32:
        out = smokeFingerprintMix(out, int32(value.data[index]))
    return out

fn smokeFingerprintColumnCount(columnCount: var int32) =
    if columnCount >= 2147483647:
        panic("cleanup cfg smoke: fingerprint column overflow")
    columnCount = columnCount + 1

fn smokeFingerprintI32Field(out: var int64,
                            columnCount: var int32,
                            value: int32) =
    smokeFingerprintColumnCount(columnCount)
    out = smokeFingerprintMix(out, value)

fn smokeFingerprintBoolField(out: var int64,
                             columnCount: var int32,
                             value: bool) =
    smokeFingerprintColumnCount(columnCount)
    out = smokeFingerprintBool(out, value)

fn smokeFingerprintI32Sequence(seed: int64,
                               values: var int32[]): int64 =
    var out = smokeFingerprintMix(seed, values.len)
    for valueIndex in 0..<values.len:
        let value = values[valueIndex]
        out = smokeFingerprintMix(out, value)
    return out

fn smokeFingerprintBoolSequence(seed: int64,
                                values: var bool[]): int64 =
    var out = smokeFingerprintMix(seed, values.len)
    for valueIndex in 0..<values.len:
        let value = values[valueIndex]
        out = smokeFingerprintBool(out, value)
    return out

fn smokeFingerprintBodyOps(seed: int64,
                           values: var coreir.BodyOp[]): int64 =
    var out = smokeFingerprintMix(seed, values.len)
    for valueIndex in 0..<values.len:
        let value = values[valueIndex]
        var columnCount: int32
        smokeFingerprintI32Field(out, columnCount, value.kind)
        smokeFingerprintColumnCount(columnCount)
        out = smokeFingerprintI32Sequence(out, value.operands)
        smokeFingerprintI32Field(out, columnCount, value.target)
        smokeFingerprintI32Field(out, columnCount, value.valueDefSlot)
        smokeFingerprintI32Field(out,
                                 columnCount,
                                 value.valueDefExprNodeIndex)
        smokeFingerprintI32Field(out,
                                 columnCount,
                                 int32(value.valueDefOwnership))
        smokeFingerprintI32Field(out,
                                 columnCount,
                                 value.valueDefConsumeOpIndexPlusOne)
        smokeFingerprintI32Field(out,
                                 columnCount,
                                 value.valueDefOriginKind)
        smokeFingerprintI32Field(out,
                                 columnCount,
                                 value.valueDefOriginId)
        smokeFingerprintI32Field(out,
                                 columnCount,
                                 value.sourceValueDefOpId)
        smokeFingerprintI32Field(out,
                                 columnCount,
                                 value.consumeActionRow)
        smokeAssert(columnCount == 11,
                    "cleanup cfg smoke: BodyOp fingerprint schema drift")
    return out

fn smokeFingerprintCalls(seed: int64,
                         values: var coreir.CallOp[]): int64 =
    var out = smokeFingerprintMix(seed, values.len)
    for valueIndex in 0..<values.len:
        let value = values[valueIndex]
        var columnCount: int32
        smokeFingerprintColumnCount(columnCount)
        out = smokeFingerprintText(out, value.targetSymbol)
        smokeFingerprintColumnCount(columnCount)
        out = smokeFingerprintText(out, value.targetSourcePath)
        smokeFingerprintColumnCount(columnCount)
        out = smokeFingerprintI32Sequence(out, value.argSlots)
        smokeFingerprintColumnCount(columnCount)
        out = smokeFingerprintI32Sequence(out, value.argPassKinds)
        smokeFingerprintColumnCount(columnCount)
        out = smokeFingerprintI32Sequence(out, value.argAbiSizes)
        smokeFingerprintI32Field(out, columnCount, value.resultSlot)
        smokeFingerprintI32Field(out, columnCount, value.resultPassKind)
        smokeFingerprintI32Field(out,
                                 columnCount,
                                 int32(value.resultOwnership))
        smokeFingerprintI32Field(out,
                                 columnCount,
                                 value.resultExprNodeIndex)
        smokeFingerprintI32Field(out,
                                 columnCount,
                                 value.resultDefinitionOriginKind)
        smokeFingerprintI32Field(out,
                                 columnCount,
                                 value.resultDefinitionOriginId)
        smokeFingerprintI32Field(out,
                                 columnCount,
                                 value.sourceValueDefOpId)
        smokeFingerprintI32Field(out,
                                 columnCount,
                                 value.consumeActionRow)
        smokeFingerprintI32Field(out, columnCount, value.managedStoreKind)
        smokeFingerprintI32Field(out, columnCount, value.relocWordOffset)
        smokeFingerprintBoolField(out, columnCount, value.targetIsImportc)
        smokeFingerprintI32Field(out, columnCount, value.inlineF64FromIntKind)
        smokeFingerprintBoolField(out,
                                  columnCount,
                                  value.wholeCallF64FromIntRescue)
        smokeFingerprintBoolField(out,
                                  columnCount,
                                  value.inlineF64FromIntUnsigned)
        smokeAssert(columnCount == 19,
                    "cleanup cfg smoke: CallOp fingerprint schema drift")
    return out

fn smokeFingerprintLocalSlots(seed: int64,
                              values: var coreir.LocalSlot[]): int64 =
    var out = smokeFingerprintMix(seed, values.len)
    for valueIndex in 0..<values.len:
        let value = values[valueIndex]
        var columnCount: int32
        smokeFingerprintI32Field(out, columnCount, value.id)
        smokeFingerprintColumnCount(columnCount)
        out = smokeFingerprintText(out, value.name)
        smokeFingerprintI32Field(out, columnCount, value.typeKind)
        smokeFingerprintI32Field(out, columnCount, value.typeArenaTypeId)
        smokeFingerprintI32Field(out, columnCount, value.managedStorageKind)
        smokeFingerprintI32Field(out, columnCount, value.placeKind)
        smokeFingerprintI32Field(out, columnCount, value.stackOffset)
        smokeFingerprintI32Field(out, columnCount, value.sizeBytes)
        smokeFingerprintI32Field(out, columnCount, value.alignBytes)
        smokeFingerprintI32Field(out, columnCount, value.auxValue)
        smokeFingerprintI32Field(out, columnCount, int32(value.ownership))
        smokeFingerprintI32Field(out, columnCount, int32(value.aliasClass))
        smokeFingerprintI32Field(out, columnCount, int32(value.escapeKind))
        smokeFingerprintBoolField(out, columnCount, value.noAlias)
        smokeAssert(columnCount == 14,
                    "cleanup cfg smoke: LocalSlot fingerprint schema drift")
    return out

fn smokeFingerprintBlocks(seed: int64,
                          values: var coreir.BodyBlock[]): int64 =
    var out = smokeFingerprintMix(seed, values.len)
    for valueIndex in 0..<values.len:
        let value = values[valueIndex]
        var columnCount: int32
        smokeFingerprintI32Field(out, columnCount, value.id)
        smokeFingerprintI32Field(out, columnCount, value.opStart)
        smokeFingerprintI32Field(out, columnCount, value.opCount)
        smokeFingerprintI32Field(out, columnCount, value.termIndex)
        smokeAssert(columnCount == 4,
                    "cleanup cfg smoke: BodyBlock fingerprint schema drift")
    return out

fn smokeFingerprintTerms(seed: int64,
                         values: var coreir.BodyTerm[]): int64 =
    var out = smokeFingerprintMix(seed, values.len)
    for valueIndex in 0..<values.len:
        let value = values[valueIndex]
        var columnCount: int32
        smokeFingerprintI32Field(out, columnCount, value.kind)
        smokeFingerprintI32Field(out, columnCount, value.conditionKind)
        smokeFingerprintI32Field(out, columnCount, value.resultSlot)
        smokeFingerprintI32Field(out,
                                 columnCount,
                                 value.sourceValueDefOpId)
        smokeFingerprintI32Field(out, columnCount, value.lhsSlot)
        smokeFingerprintI32Field(out, columnCount, value.rhsSlot)
        smokeFingerprintI32Field(out, columnCount, value.trueBlock)
        smokeFingerprintI32Field(out, columnCount, value.falseBlock)
        smokeFingerprintColumnCount(columnCount)
        out = smokeFingerprintI32Sequence(out, value.operands)
        smokeAssert(columnCount == 9,
                    "cleanup cfg smoke: BodyTerm fingerprint schema drift")
    return out

fn smokeFingerprintCStrings(
        seed: int64,
        values: var coreir.CStringLiteralEntry[]): int64 =
    var out = smokeFingerprintMix(seed, values.len)
    for valueIndex in 0..<values.len:
        let value = values[valueIndex]
        var columnCount: int32
        smokeFingerprintI32Field(out, columnCount, value.id)
        smokeFingerprintColumnCount(columnCount)
        out = smokeFingerprintText(out, value.text)
        smokeFingerprintColumnCount(columnCount)
        out = smokeFingerprintText(out, value.dataLabel)
        smokeAssert(columnCount == 3,
                    "cleanup cfg smoke: CString fingerprint schema drift")
    return out

fn bodyIrCanonicalFingerprintSchemaFieldCount(): int32 =
    return 53

fn bodyIrCanonicalFingerprint(bodyIR: var coreir.BodyIR): int64 =
    var out = int64(146959810)
    var columnCount: int32
    smokeFingerprintColumnCount(columnCount)
    out = smokeFingerprintBodyOps(out, bodyIR.ops)
    smokeFingerprintColumnCount(columnCount)
    out = smokeFingerprintCalls(out, bodyIR.callSequence)
    smokeFingerprintColumnCount(columnCount)
    out = smokeFingerprintLocalSlots(out, bodyIR.localSlots)
    smokeFingerprintColumnCount(columnCount)
    out = smokeFingerprintFixedBytes32(
        out, bodyIR.typeArenaArtifactCid)
    # slotNameIndex is a derived lookup accelerator, not semantic/layout state.
    # Its canonical meaning is already represented by ordered localSlots names.
    smokeFingerprintColumnCount(columnCount)
    out = smokeFingerprintText(out, "slotNameIndex:derived-from-localSlots")
    smokeFingerprintColumnCount(columnCount)
    out = smokeFingerprintBlocks(out, bodyIR.blocks)
    smokeFingerprintColumnCount(columnCount)
    out = smokeFingerprintTerms(out, bodyIR.terms)
    smokeFingerprintColumnCount(columnCount)
    out = smokeFingerprintCStrings(out, bodyIR.cstringLiterals)
    smokeFingerprintBoolField(out,
                              columnCount,
                              bodyIR.debugProvenanceRequired)
    smokeFingerprintBoolField(out,
                              columnCount,
                              bodyIR.debugProvenanceComplete)
    smokeFingerprintI32Field(out, columnCount, bodyIR.debugFunctionId)
    smokeFingerprintColumnCount(columnCount)
    out = smokeFingerprintI32Sequence(out, bodyIR.debugOpIdsByOpIndex)
    smokeFingerprintColumnCount(columnCount)
    out = smokeFingerprintI32Sequence(
        out,
        bodyIR.debugSyntheticKindsByOpIndex)
    smokeFingerprintColumnCount(columnCount)
    out = smokeFingerprintI32Sequence(out, bodyIR.debugOpIdsByTermIndex)
    smokeFingerprintColumnCount(columnCount)
    out = smokeFingerprintI32Sequence(
        out,
        bodyIR.debugSyntheticKindsByTermIndex)
    smokeFingerprintI32Field(out, columnCount, bodyIR.debugCurrentOpId)
    smokeFingerprintI32Field(out,
                             columnCount,
                             bodyIR.debugCurrentSyntheticKind)
    smokeFingerprintBoolField(out, columnCount, bodyIR.entryIsCAbi)
    smokeFingerprintBoolField(out, columnCount, bodyIR.frameMetricsReady)
    smokeFingerprintI32Field(out, columnCount, bodyIR.frameStackByteCount)
    smokeFingerprintI32Field(out, columnCount, bodyIR.frameParamSaveCount)
    smokeFingerprintI32Field(out, columnCount, bodyIR.frameParamSaveOffset)
    smokeFingerprintI32Field(out,
                             columnCount,
                             bodyIR.frameReturnBufferSaveOffset)
    smokeFingerprintI32Field(out, columnCount, bodyIR.frameBytes)
    smokeFingerprintI32Field(out, columnCount, bodyIR.framePrologueWordCount)
    smokeFingerprintI32Field(out, columnCount, bodyIR.frameRestoreWordCount)
    smokeFingerprintColumnCount(columnCount)
    out = smokeFingerprintBoolSequence(out, bodyIR.layoutLhsElide)
    smokeFingerprintColumnCount(columnCount)
    out = smokeFingerprintBoolSequence(out, bodyIR.layoutStoreElide)
    smokeFingerprintColumnCount(columnCount)
    out = smokeFingerprintBoolSequence(out, bodyIR.layoutCopySrcElide)
    smokeFingerprintColumnCount(columnCount)
    out = smokeFingerprintI32Sequence(out, bodyIR.layoutCmpFuse)
    smokeFingerprintColumnCount(columnCount)
    out = smokeFingerprintI32Sequence(out, bodyIR.layoutCbrFuse)
    smokeFingerprintI32Field(out, columnCount, bodyIR.residencySavedRegCount)
    smokeFingerprintColumnCount(columnCount)
    out = smokeFingerprintI32Sequence(out, bodyIR.layoutSlotReg)
    smokeFingerprintColumnCount(columnCount)
    out = smokeFingerprintI32Sequence(out, bodyIR.layoutBlockRegCount)
    smokeFingerprintColumnCount(columnCount)
    out = smokeFingerprintI32Sequence(out, bodyIR.layoutResLhs)
    smokeFingerprintColumnCount(columnCount)
    out = smokeFingerprintI32Sequence(out, bodyIR.layoutResRhs)
    smokeFingerprintColumnCount(columnCount)
    out = smokeFingerprintI32Sequence(out, bodyIR.layoutResTarget)
    smokeFingerprintColumnCount(columnCount)
    out = smokeFingerprintI32Sequence(out, bodyIR.layoutTempNoStoreReg)
    smokeFingerprintColumnCount(columnCount)
    out = smokeFingerprintBoolSequence(out, bodyIR.layoutSlotCarried)
    smokeFingerprintBoolField(out, columnCount, bodyIR.loopInfoReady)
    smokeFingerprintI32Field(out, columnCount, bodyIR.loopHeaderBlock)
    smokeFingerprintI32Field(out, columnCount, bodyIR.loopLatchBlock)
    smokeFingerprintI32Field(out, columnCount, bodyIR.loopPreheaderBlock)
    smokeFingerprintColumnCount(columnCount)
    out = smokeFingerprintI32Sequence(out, bodyIR.loopCarrySlots)
    smokeFingerprintColumnCount(columnCount)
    out = smokeFingerprintI32Sequence(out, bodyIR.loopCarryRegs)
    smokeFingerprintI32Field(out, columnCount, bodyIR.loopCarryCount)
    smokeFingerprintColumnCount(columnCount)
    out = smokeFingerprintBoolSequence(out,
                                       bodyIR.layoutCopyCarryDropStore)
    smokeFingerprintI32Field(out, columnCount, bodyIR.loopExitBlock)
    smokeFingerprintBoolField(out, columnCount, bodyIR.x64ResReady)
    smokeFingerprintColumnCount(columnCount)
    out = smokeFingerprintI32Sequence(out, bodyIR.x64ResReg)
    smokeFingerprintColumnCount(columnCount)
    out = smokeFingerprintI32Sequence(out, bodyIR.x64SlotReadCnt)
    smokeFingerprintBoolField(out, columnCount, bodyIR.x64BlockStartReady)
    smokeFingerprintColumnCount(columnCount)
    out = smokeFingerprintI32Sequence(out, bodyIR.x64BlockWordStart)
    smokeAssert(columnCount == bodyIrCanonicalFingerprintSchemaFieldCount(),
                "cleanup cfg smoke: BodyIR fingerprint schema drift")
    return out

fn bodyIrFingerprint(bodyIR: var coreir.BodyIR): int64 =
    return bodyIrCanonicalFingerprint(bodyIR)

fn addOwnershipSameScopeEdge(ir: var odir.OwnershipDropIr,
                             fromBlockId: int32,
                             toBlockId: int32): int32 =
    var cleanupIds: int32[]
    var deferIds: int32[]
    return odir.OwnershipDropAddEdge(ir,
                                     fromBlockId,
                                     toBlockId,
                                     odir.OwnershipDropEdgeNormal,
                                     -1,
                                     cleanupIds,
                                     deferIds)

fn buildOwnedStrReturnAnalysis(
        ir: var odir.OwnershipDropIr,
        analysis: var odir.OwnershipDropAnalysis,
        returnEdgeOut: var int32,
        deferIdOut: var int32,
        placeIdOut: var int32,
        initializeOpOut: var int32,
        activateOpOut: var int32): odir.OwnershipDropCleanupAction =
    odir.OwnershipDropIrInit(ir)
    let root = odir.OwnershipDropRootScopeId(ir)
    let valueType = odir.OwnershipDropRegisterLeafType(ir,
                                                       "CleanupOwnedStr",
                                                       701)
    odir.OwnershipDropSetTypeReturnSnapshotPolicy(
        ir,
        valueType,
        odir.ReturnSnapshotRetain,
        1701,
        "owned_str_snapshot_retain")
    placeIdOut = odir.OwnershipDropAddPlace(ir,
                                            valueType,
                                            odir.Owned,
                                            root)
    deferIdOut = odir.OwnershipDropRegisterDeferEffect(
        ir,
        root,
        odir.DeferEffectUseWrite,
        placeIdOut,
        -1)
    let entry = odir.OwnershipDropAddBlock(ir, root)
    odir.OwnershipDropSetEntryBlock(ir, entry)
    initializeOpOut = odir.OwnershipDropAppendInitialize(ir,
                                                         entry,
                                                         placeIdOut)
    activateOpOut = odir.OwnershipDropAppendActivateDefer(ir,
                                                           entry,
                                                           deferIdOut)
    let exitBlock = odir.OwnershipDropAddBlock(ir, root)
    var cleanupIds: int32[]
    add(cleanupIds, placeIdOut)
    var deferIds: int32[]
    add(deferIds, deferIdOut)
    returnEdgeOut = odir.OwnershipDropAddEdge(
        ir,
        entry,
        exitBlock,
        odir.OwnershipDropEdgeReturn,
        placeIdOut,
        cleanupIds,
        deferIds)
    odir.OwnershipDropBindReturnDefinitionAuthority(
        ir,
        returnEdgeOut,
        17101,
        odir.Owned,
        0)
    odir.OwnershipDropAnalyze(ir, analysis)
    if odir.OwnershipDropAnalysisEdgeActionCount(analysis,
                                                 returnEdgeOut) != 3:
        panic("cleanup cfg smoke: owned str action count")
    return odir.OwnershipDropAnalysisEdgeAction(analysis,
                                                returnEdgeOut,
                                                0)

fn buildConditionalOwnershipGuard(
        ir: var odir.OwnershipDropIr,
        analysis: var odir.OwnershipDropAnalysis,
        deferIdOut: var int32,
        returnEdgeOut: var int32,
        placeIdOut: var int32,
        initializeOpOut: var int32,
        activateOpOut: var int32,
        guardedActionOut: var odir.OwnershipDropCleanupAction,
        fallbackActionOut: var odir.OwnershipDropCleanupAction) =
    odir.OwnershipDropIrInit(ir)
    let root = odir.OwnershipDropRootScopeId(ir)
    let valueType = odir.OwnershipDropRegisterLeafType(ir,
                                                       "GuardedOwner",
                                                       702)
    placeIdOut = odir.OwnershipDropAddPlace(ir,
                                            valueType,
                                            odir.Owned,
                                            root)
    deferIdOut = odir.OwnershipDropRegisterDeferEffect(
        ir,
        root,
        odir.DeferEffectDropPlace,
        placeIdOut,
        -1)
    let entry = odir.OwnershipDropAddBlock(ir, root)
    odir.OwnershipDropSetEntryBlock(ir, entry)
    initializeOpOut = odir.OwnershipDropAppendInitialize(ir,
                                                         entry,
                                                         placeIdOut)
    let activeBlock = odir.OwnershipDropAddBlock(ir, root)
    activateOpOut = odir.OwnershipDropAppendActivateDefer(ir,
                                                           activeBlock,
                                                           deferIdOut)
    let inactiveBlock = odir.OwnershipDropAddBlock(ir, root)
    let joinBlock = odir.OwnershipDropAddBlock(ir, root)
    let exitBlock = odir.OwnershipDropAddBlock(ir, root)
    let _ = addOwnershipSameScopeEdge(ir, entry, activeBlock)
    let _ = addOwnershipSameScopeEdge(ir, entry, inactiveBlock)
    let _ = addOwnershipSameScopeEdge(ir, activeBlock, joinBlock)
    let _ = addOwnershipSameScopeEdge(ir, inactiveBlock, joinBlock)
    var cleanupIds: int32[]
    add(cleanupIds, placeIdOut)
    var deferIds: int32[]
    add(deferIds, deferIdOut)
    returnEdgeOut = odir.OwnershipDropAddEdge(
        ir,
        joinBlock,
        exitBlock,
        odir.OwnershipDropEdgeReturn,
        -1,
        cleanupIds,
        deferIds)
    odir.OwnershipDropAnalyze(ir, analysis)
    var guardedFound: bool
    var fallbackFound: bool
    let actionCount = odir.OwnershipDropAnalysisEdgeActionCount(analysis,
                                                                returnEdgeOut)
    for ordinal in 0..<actionCount:
        let action = odir.OwnershipDropAnalysisEdgeAction(analysis,
                                                          returnEdgeOut,
                                                          ordinal)
        if action.kind == odir.CleanupActionDropPlace &&
           action.guardDeferId == deferIdOut:
            let projection = odir.OwnershipDropProjectActionCondition(
                ir,
                analysis,
                action)
            if projection.guardNegated:
                fallbackActionOut = action
                fallbackFound = true
            else:
                guardedActionOut = action
                guardedFound = true
    if !guardedFound || !fallbackFound:
        panic("cleanup cfg smoke: guarded ownership actions missing")

fn runNotReachedAndLifo(): cleanup.CleanupMaterializeReport =
    var body = coreir.BodyIRNew()
    let flag1 = addI32Slot(body, "flag1")
    let flag2 = addI32Slot(body, "flag2")
    var plan: cleanup.CleanupPlan
    cleanup.CleanupPlanPrepare(plan, limits(), 0)
    cleanup.CleanupPlanBindLocalSchema(plan, body)
    var firstFragment = callFragment(body, "first")
    var secondFragment = callFragment(body, "second")
    let firstFragmentId = cleanup.CleanupPlanCaptureFragment(plan, firstFragment)
    let secondFragmentId = cleanup.CleanupPlanCaptureFragment(plan, secondFragment)
    let root = cleanup.CleanupPlanRootScopeId(plan)
    let scope = cleanup.CleanupPlanAddScope(plan, root)
    let suite1 = cleanup.CleanupPlanAddScope(plan, scope)
    let suite2 = cleanup.CleanupPlanAddScope(plan, scope)
    let first = cleanup.CleanupPlanRegisterDefer(plan, scope, suite1, 10, flag1, firstFragmentId)
    let second = cleanup.CleanupPlanRegisterDefer(plan, scope, suite2, 20, flag2, secondFragmentId)
    var sourceTerm: coreir.BodyTerm
    sourceTerm.kind = coreir.BodyTermBrTag
    sourceTerm.trueBlock = 1
    let sourceTermIndex = coreir.BodyIRAppendTerm(body, sourceTerm)
    let _ = coreir.BodyIRAppendBlock(body, 0, 0, sourceTermIndex)
    let target = appendReturnBlock(body, -1)
    let exitId = cleanup.CleanupPlanQueueUnmanagedExit(plan,
                                              0,
                                              0,
                                              scope,
                                              root,
                                              odir.OwnershipDropEdgeNormal,
                                              target)
    smokeAssert(cleanup.CleanupPlanExitDeferCount(plan, exitId) == 2 &&
                cleanup.CleanupPlanExitDeferId(plan, exitId, 0) == second &&
                cleanup.CleanupPlanExitDeferId(plan, exitId, 1) == first,
                "cleanup cfg smoke: same-scope LIFO CSR")
    let report = cleanup.CleanupPlanMaterialize(body, plan)
    var locals = zeroLocals(body)
    var log: str[]
    let _ = runBody(body, 0, locals, log)
    smokeAssert(log.len == 0, "cleanup cfg smoke: unreachable defer executed")
    smokeAssert(report.liveBytesBeforeRelease > int64(0) &&
                report.liveBytesAfterRelease == int64(0) && report.released,
                "cleanup cfg smoke: planner release")
    return report

fn runSameScopeLifoActivated() =
    var body = coreir.BodyIRNew()
    let flag1 = addI32Slot(body, "flag1")
    let flag2 = addI32Slot(body, "flag2")
    var plan: cleanup.CleanupPlan
    cleanup.CleanupPlanPrepare(plan, limits(), 0)
    cleanup.CleanupPlanBindLocalSchema(plan, body)
    var firstFragment = callFragment(body, "first")
    var secondFragment = callFragment(body, "second")
    let firstFragmentId = cleanup.CleanupPlanCaptureFragment(plan, firstFragment)
    let secondFragmentId = cleanup.CleanupPlanCaptureFragment(plan, secondFragment)
    let root = cleanup.CleanupPlanRootScopeId(plan)
    let scope = cleanup.CleanupPlanAddScope(plan, root)
    let suite1 = cleanup.CleanupPlanAddScope(plan, scope)
    let suite2 = cleanup.CleanupPlanAddScope(plan, scope)
    let first = cleanup.CleanupPlanRegisterDefer(plan, scope, suite1, 1, flag1, firstFragmentId)
    let second = cleanup.CleanupPlanRegisterDefer(plan, scope, suite2, 2, flag2, secondFragmentId)
    add(body.ops, cleanup.CleanupPlanActivationOp(plan, first))
    add(body.ops, cleanup.CleanupPlanActivationOp(plan, second))
    var sourceTerm: coreir.BodyTerm
    sourceTerm.kind = coreir.BodyTermBrTag
    sourceTerm.trueBlock = 1
    let sourceTermIndex = coreir.BodyIRAppendTerm(body, sourceTerm)
    let _ = coreir.BodyIRAppendBlock(body, 0, 2, sourceTermIndex)
    let target = appendReturnBlock(body, -1)
    cleanup.CleanupPlanQueueUnmanagedExit(plan, 0, 0, scope, root,
                                          odir.OwnershipDropEdgeNormal, target)
    let _ = cleanup.CleanupPlanMaterialize(body, plan)
    var locals = zeroLocals(body)
    var log: str[]
    let _ = runBody(body, 0, locals, log)
    smokeAssert(log.len == 2 && log[0] == "second" && log[1] == "first",
                "cleanup cfg smoke: activated LIFO order")

fn appendMarkerOp(bodyIR: var coreir.BodyIR, symbol: str) =
    var call: coreir.CallOp
    coreir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = symbol
    call.resultSlot = -1
    call.resultPassKind = coreir.BodyCallPassStackValueTag
    let ordinal = bodyIR.callSequence.len
    add(bodyIR.callSequence, call)
    var op: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = coreir.BodyOpCallTag
    op.target = -1
    add(op.operands, ordinal)
    add(bodyIR.ops, op)

fn runCbrOneCleanupOneDirect() =
    var body = coreir.BodyIRNew()
    let guard = addI32Slot(body, "guard")
    let flag = addI32Slot(body, "flag")
    var plan: cleanup.CleanupPlan
    cleanup.CleanupPlanPrepare(plan, limits(), 0)
    cleanup.CleanupPlanBindLocalSchema(plan, body)
    var fragment = callFragment(body, "cleanup")
    let fragmentId = cleanup.CleanupPlanCaptureFragment(plan, fragment)
    let root = cleanup.CleanupPlanRootScopeId(plan)
    let inner = cleanup.CleanupPlanAddScope(plan, root)
    let suite = cleanup.CleanupPlanAddScope(plan, inner)
    let deferId = cleanup.CleanupPlanRegisterDefer(plan, inner, suite, 1, flag, fragmentId)
    add(body.ops, cleanup.CleanupPlanActivationOp(plan, deferId))
    var cbr: coreir.BodyTerm
    cbr.kind = coreir.BodyTermCbrTag
    cbr.conditionKind = coreir.BodyCondLocalNonZeroTag
    cbr.lhsSlot = guard
    cbr.trueBlock = 1
    cbr.falseBlock = 2
    add(cbr.operands, guard)
    let cbrIndex = coreir.BodyIRAppendTerm(body, cbr)
    let _ = coreir.BodyIRAppendBlock(body, 0, 1, cbrIndex)
    let trueTarget = appendReturnBlock(body, -1)
    let insideStart = body.ops.len
    appendMarkerOp(body, "inside")
    var insideBr: coreir.BodyTerm
    insideBr.kind = coreir.BodyTermBrTag
    insideBr.trueBlock = 3
    let insideTerm = coreir.BodyIRAppendTerm(body, insideBr)
    let insideBlock = coreir.BodyIRAppendBlock(body, insideStart, 1, insideTerm)
    let finalTarget = appendReturnBlock(body, -1)
    cleanup.CleanupPlanQueueUnmanagedExit(plan, 0, 0, inner, root,
                                          odir.OwnershipDropEdgeNormal, trueTarget)
    cleanup.CleanupPlanQueueUnmanagedExit(plan, 0, 1, inner, inner,
                                          odir.OwnershipDropEdgeNormal, insideBlock)
    cleanup.CleanupPlanQueueUnmanagedExit(plan, insideBlock, 0, inner, root,
                                          odir.OwnershipDropEdgeNormal, finalTarget)
    let _ = cleanup.CleanupPlanMaterialize(body, plan)
    smokeAssert(body.terms[body.blocks[0].termIndex].kind == coreir.BodyTermCbrTag,
                "cleanup cfg smoke: Cbr was collapsed")
    var trueLocals = zeroLocals(body)
    fixtureArenaWriteI32(body, trueLocals, guard, 1)
    var trueLog: str[]
    let _ = runBody(body, 0, trueLocals, trueLog)
    smokeAssert(trueLog.len == 1 && trueLog[0] == "cleanup",
                "cleanup cfg smoke: true edge cleanup")
    var falseLocals = zeroLocals(body)
    var falseLog: str[]
    let _ = runBody(body, 0, falseLocals, falseLog)
    smokeAssert(falseLog.len == 2 && falseLog[0] == "inside" &&
                falseLog[1] == "cleanup",
                "cleanup cfg smoke: false edge rewrote before in-scope target")

fn runCbrTwoDifferentCleanup() =
    var body = coreir.BodyIRNew()
    let guard = addI32Slot(body, "guard")
    let outerFlag = addI32Slot(body, "outer_flag")
    let innerFlag = addI32Slot(body, "inner_flag")
    var plan: cleanup.CleanupPlan
    cleanup.CleanupPlanPrepare(plan, limits(), 0)
    cleanup.CleanupPlanBindLocalSchema(plan, body)
    var outerFragment = callFragment(body, "outer")
    var innerFragment = callFragment(body, "inner")
    let outerFragmentId = cleanup.CleanupPlanCaptureFragment(plan, outerFragment)
    let innerFragmentId = cleanup.CleanupPlanCaptureFragment(plan, innerFragment)
    let root = cleanup.CleanupPlanRootScopeId(plan)
    let outer = cleanup.CleanupPlanAddScope(plan, root)
    let inner = cleanup.CleanupPlanAddScope(plan, outer)
    let outerSuite = cleanup.CleanupPlanAddScope(plan, outer)
    let innerSuite = cleanup.CleanupPlanAddScope(plan, inner)
    let outerDefer = cleanup.CleanupPlanRegisterDefer(plan, outer, outerSuite,
                                                      1, outerFlag, outerFragmentId)
    let innerDefer = cleanup.CleanupPlanRegisterDefer(plan, inner, innerSuite,
                                                      2, innerFlag, innerFragmentId)
    add(body.ops, cleanup.CleanupPlanActivationOp(plan, outerDefer))
    add(body.ops, cleanup.CleanupPlanActivationOp(plan, innerDefer))
    var cbr: coreir.BodyTerm
    cbr.kind = coreir.BodyTermCbrTag
    cbr.conditionKind = coreir.BodyCondLocalNonZeroTag
    cbr.lhsSlot = guard
    cbr.trueBlock = 1
    cbr.falseBlock = 2
    add(cbr.operands, guard)
    let cbrIndex = coreir.BodyIRAppendTerm(body, cbr)
    let _ = coreir.BodyIRAppendBlock(body, 0, 2, cbrIndex)
    let trueTarget = appendReturnBlock(body, -1)
    let outerBodyStart = body.ops.len
    appendMarkerOp(body, "outer_body")
    var outerBr: coreir.BodyTerm
    outerBr.kind = coreir.BodyTermBrTag
    outerBr.trueBlock = 3
    let outerTerm = coreir.BodyIRAppendTerm(body, outerBr)
    let outerBody = coreir.BodyIRAppendBlock(body, outerBodyStart, 1, outerTerm)
    let finalTarget = appendReturnBlock(body, -1)
    let trueExit = cleanup.CleanupPlanQueueUnmanagedExit(
        plan, 0, 0, inner, root, odir.OwnershipDropEdgeBreak, trueTarget)
    let falseExit = cleanup.CleanupPlanQueueUnmanagedExit(
        plan, 0, 1, inner, outer, odir.OwnershipDropEdgeContinue, outerBody)
    cleanup.CleanupPlanQueueUnmanagedExit(plan, outerBody, 0, outer, root,
                                          odir.OwnershipDropEdgeNormal, finalTarget)
    smokeAssert(cleanup.CleanupPlanExitDeferCount(plan, trueExit) == 2 &&
                cleanup.CleanupPlanExitDeferId(plan, trueExit, 0) == innerDefer &&
                cleanup.CleanupPlanExitDeferId(plan, trueExit, 1) == outerDefer,
                "cleanup cfg smoke: nested child-to-parent order")
    smokeAssert(cleanup.CleanupPlanExitDeferCount(plan, falseExit) == 1 &&
                cleanup.CleanupPlanExitDeferId(plan, falseExit, 0) == innerDefer,
                "cleanup cfg smoke: Cbr edge-specific LCA")
    let _ = cleanup.CleanupPlanMaterialize(body, plan)
    var trueLocals = zeroLocals(body)
    fixtureArenaWriteI32(body, trueLocals, guard, 1)
    var trueLog: str[]
    let _ = runBody(body, 0, trueLocals, trueLog)
    smokeAssert(trueLog.len == 2 && trueLog[0] == "inner" && trueLog[1] == "outer",
                "cleanup cfg smoke: true edge nested cleanup")
    var falseLocals = zeroLocals(body)
    var falseLog: str[]
    let _ = runBody(body, 0, falseLocals, falseLog)
    smokeAssert(falseLog.len == 3 && falseLog[0] == "inner" &&
                falseLog[1] == "outer_body" && falseLog[2] == "outer",
                "cleanup cfg smoke: false edge different cleanup")

fn runBreakContinueDoubleLoop() =
    var body = coreir.BodyIRNew()
    let guard = addI32Slot(body, "loop_edge_guard")
    let outerFlag = addI32Slot(body, "outer_body_flag")
    let innerLoopFlag = addI32Slot(body, "inner_loop_flag")
    let iterationFlag = addI32Slot(body, "iteration_flag")
    var plan: cleanup.CleanupPlan
    cleanup.CleanupPlanPrepare(plan, limits(), 0)
    cleanup.CleanupPlanBindLocalSchema(plan, body)
    var outerFragment = callFragment(body, "outer_body_cleanup")
    var innerLoopFragment = callFragment(body, "inner_loop_cleanup")
    var iterationFragment = callFragment(body, "iteration_cleanup")
    let outerFragmentId = cleanup.CleanupPlanCaptureFragment(plan, outerFragment)
    let innerLoopFragmentId = cleanup.CleanupPlanCaptureFragment(plan, innerLoopFragment)
    let iterationFragmentId = cleanup.CleanupPlanCaptureFragment(plan, iterationFragment)
    let root = cleanup.CleanupPlanRootScopeId(plan)
    let outerLoop = cleanup.CleanupPlanAddScope(plan, root)
    let outerBody = cleanup.CleanupPlanAddScope(plan, outerLoop)
    let outerSuite = cleanup.CleanupPlanAddScope(plan, outerBody)
    let innerLoop = cleanup.CleanupPlanAddScope(plan, outerBody)
    let innerLoopSuite = cleanup.CleanupPlanAddScope(plan, innerLoop)
    let innerBody = cleanup.CleanupPlanAddScope(plan, innerLoop)
    let iterationSuite = cleanup.CleanupPlanAddScope(plan, innerBody)
    let outerDefer = cleanup.CleanupPlanRegisterDefer(plan,
                                                      outerBody,
                                                      outerSuite,
                                                      1,
                                                      outerFlag,
                                                      outerFragmentId)
    let innerLoopDefer = cleanup.CleanupPlanRegisterDefer(plan,
                                                          innerLoop,
                                                          innerLoopSuite,
                                                          1,
                                                          innerLoopFlag,
                                                          innerLoopFragmentId)
    let iterationDefer = cleanup.CleanupPlanRegisterDefer(plan,
                                                          innerBody,
                                                          iterationSuite,
                                                          1,
                                                          iterationFlag,
                                                          iterationFragmentId)
    add(body.ops, cleanup.CleanupPlanActivationOp(plan, outerDefer))
    add(body.ops, cleanup.CleanupPlanActivationOp(plan, innerLoopDefer))
    add(body.ops, cleanup.CleanupPlanActivationOp(plan, iterationDefer))
    var branch: coreir.BodyTerm
    branch.kind = coreir.BodyTermCbrTag
    branch.conditionKind = coreir.BodyCondLocalNonZeroTag
    branch.lhsSlot = guard
    branch.trueBlock = 1
    branch.falseBlock = 2
    add(branch.operands, guard)
    let branchTerm = coreir.BodyIRAppendTerm(body, branch)
    let _ = coreir.BodyIRAppendBlock(body, 0, 3, branchTerm)

    let breakTargetStart = body.ops.len
    appendMarkerOp(body, "after_inner_break")
    var breakTargetTerm: coreir.BodyTerm
    breakTargetTerm.kind = coreir.BodyTermBrTag
    breakTargetTerm.trueBlock = 3
    let breakTargetTermId = coreir.BodyIRAppendTerm(body, breakTargetTerm)
    let breakTarget = coreir.BodyIRAppendBlock(body,
                                               breakTargetStart,
                                               1,
                                               breakTargetTermId)
    let continueTargetStart = body.ops.len
    appendMarkerOp(body, "inner_loop_header")
    var continueTargetTerm: coreir.BodyTerm
    continueTargetTerm.kind = coreir.BodyTermBrTag
    continueTargetTerm.trueBlock = 4
    let continueTargetTermId = coreir.BodyIRAppendTerm(body, continueTargetTerm)
    let continueTarget = coreir.BodyIRAppendBlock(body,
                                                  continueTargetStart,
                                                  1,
                                                  continueTargetTermId)
    let breakFinal = appendReturnBlock(body, -1)
    let continueFinal = appendReturnBlock(body, -1)

    let breakExit = cleanup.CleanupPlanQueueUnmanagedExit(plan,
                                                 0,
                                                 0,
                                                 innerBody,
                                                 outerBody,
                                                 odir.OwnershipDropEdgeBreak,
                                                 breakTarget)
    let continueExit = cleanup.CleanupPlanQueueUnmanagedExit(plan,
                                                    0,
                                                    1,
                                                    innerBody,
                                                    innerLoop,
                                                    odir.OwnershipDropEdgeContinue,
                                                    continueTarget)
    cleanup.CleanupPlanQueueUnmanagedExit(plan,
                                 breakTarget,
                                 0,
                                 outerBody,
                                 root,
                                 odir.OwnershipDropEdgeNormal,
                                 breakFinal)
    cleanup.CleanupPlanQueueUnmanagedExit(plan,
                                 continueTarget,
                                 0,
                                 innerLoop,
                                 root,
                                 odir.OwnershipDropEdgeNormal,
                                 continueFinal)
    smokeAssert(cleanup.CleanupPlanExitKind(plan, breakExit) ==
                    odir.OwnershipDropEdgeBreak &&
                cleanup.CleanupPlanExitDeferCount(plan, breakExit) == 2 &&
                cleanup.CleanupPlanExitDeferId(plan, breakExit, 0) == iterationDefer &&
                cleanup.CleanupPlanExitDeferId(plan, breakExit, 1) == innerLoopDefer,
                "cleanup cfg smoke: explicit break CSR")
    smokeAssert(cleanup.CleanupPlanExitKind(plan, continueExit) ==
                    odir.OwnershipDropEdgeContinue &&
                cleanup.CleanupPlanExitDeferCount(plan, continueExit) == 1 &&
                cleanup.CleanupPlanExitDeferId(plan, continueExit, 0) == iterationDefer,
                "cleanup cfg smoke: explicit continue CSR")
    let _ = cleanup.CleanupPlanMaterialize(body, plan)

    var breakLocals = zeroLocals(body)
    fixtureArenaWriteI32(body, breakLocals, guard, 1)
    var breakLog: str[]
    let _ = runBody(body, 0, breakLocals, breakLog)
    smokeAssert(breakLog.len == 4 &&
                breakLog[0] == "iteration_cleanup" &&
                breakLog[1] == "inner_loop_cleanup" &&
                breakLog[2] == "after_inner_break" &&
                breakLog[3] == "outer_body_cleanup",
                "cleanup cfg smoke: break cleanup execution order")
    var continueLocals = zeroLocals(body)
    var continueLog: str[]
    let _ = runBody(body, 0, continueLocals, continueLog)
    smokeAssert(continueLog.len == 4 &&
                continueLog[0] == "iteration_cleanup" &&
                continueLog[1] == "inner_loop_header" &&
                continueLog[2] == "inner_loop_cleanup" &&
                continueLog[3] == "outer_body_cleanup",
                "cleanup cfg smoke: continue cleanup execution order")

fn runReturnSnapshotOrder() =
    var body = coreir.BodyIRNew()
    let source = addI32Slot(body, "source")
    let snapshot = addI32Slot(body, "snapshot")
    let flag = addI32Slot(body, "flag")
    var plan: cleanup.CleanupPlan
    cleanup.CleanupPlanPrepare(plan, limits(), 0)
    cleanup.CleanupPlanBindLocalSchema(plan, body)
    var fragment = writeAndCallFragment(body, source, 99, "return_cleanup")
    let fragmentId = cleanup.CleanupPlanCaptureFragment(plan, fragment)
    let root = cleanup.CleanupPlanRootScopeId(plan)
    let suite = cleanup.CleanupPlanAddScope(plan, root)
    let deferId = cleanup.CleanupPlanRegisterDefer(plan, root, suite, 1, flag, fragmentId)
    var sourceValue: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(sourceValue)
    sourceValue.kind = coreir.BodyOpLoadConstTag
    sourceValue.target = source
    add(sourceValue.operands, coreir.LocalI32Tag)
    add(sourceValue.operands, 7)
    add(body.ops, sourceValue)
    add(body.ops, cleanup.CleanupPlanActivationOp(plan, deferId))
    var ret: coreir.BodyTerm
    ret.kind = coreir.BodyTermReturnTag
    ret.resultSlot = source
    let retIndex = coreir.BodyIRAppendTerm(body, ret)
    let _ = coreir.BodyIRAppendBlock(body, 0, 2, retIndex)
    cleanup.CleanupPlanQueueUnmanagedReturnExit(plan,
                                                0,
                                                root,
                                                source,
                                                snapshot)
    let _ = cleanup.CleanupPlanMaterialize(body, plan)
    var sawSnapshotCopy: bool
    for opIndex in 0..<body.ops.len:
        let op = body.ops[opIndex]
        if op.kind == coreir.BodyOpCopyLocalTag &&
           op.target == snapshot && op.operands.len == 1 &&
           op.operands[0] == source:
            sawSnapshotCopy = true
    var locals = zeroLocals(body)
    var log: str[]
    let result = runBody(body, 0, locals, log)
    smokeAssert(sawSnapshotCopy && result.returnValue == 7 &&
                fixtureArenaReadI32(body, locals, source) == 99 &&
                log.len == 1 && log[0] == "return_cleanup",
                "cleanup cfg smoke: return snapshot order")

fn runOwnedStrReturnSnapshotAccounting() =
    var ownershipIr: odir.OwnershipDropIr
    var ownershipAnalysis: odir.OwnershipDropAnalysis
    var ownershipEdgeId: int32
    var ownershipDeferId: int32
    var ownershipPlaceId: int32
    var initializeOwnershipOp: int32
    var activateOwnershipOp: int32
    let snapshotAction = buildOwnedStrReturnAnalysis(ownershipIr,
                                                     ownershipAnalysis,
                                                     ownershipEdgeId,
                                                     ownershipDeferId,
                                                     ownershipPlaceId,
                                                     initializeOwnershipOp,
                                                     activateOwnershipOp)
    let deferAction = odir.OwnershipDropAnalysisEdgeAction(ownershipAnalysis,
                                                           ownershipEdgeId,
                                                           1)
    let sourceDropAction = odir.OwnershipDropAnalysisEdgeAction(
        ownershipAnalysis,
        ownershipEdgeId,
        2)
    let snapshotProjection = odir.OwnershipDropProjectReturnSnapshot(
        ownershipIr,
        ownershipAnalysis,
        snapshotAction)
    smokeAssert(snapshotAction.kind ==
                    odir.CleanupActionSnapshotRetainOwnedReturn &&
                deferAction.kind == odir.CleanupActionDefer &&
                deferAction.actionId == ownershipDeferId &&
                sourceDropAction.kind == odir.CleanupActionDropPlace &&
                sourceDropAction.placeId == ownershipPlaceId &&
                snapshotProjection.edgeId == ownershipEdgeId &&
                snapshotProjection.actionOrdinal == 0,
                "cleanup cfg smoke: owned str ownership action order")

    var body = coreir.BodyIRNew()
    let input = addStrSlot(body, "owned_str_input")
    let source = addStrSlot(body, "owned_str_source")
    let snapshot = addStrSlot(body, "owned_str_snapshot")
    let flag = addI32Slot(body, "owned_str_defer_flag")
    let activationMarker = addI32Slot(body, "owned_str_activation_marker")
    var ownershipFlagSlots = addOwnershipConditionFlagSlots(body,
                                                             ownershipAnalysis)
    var plan: cleanup.CleanupPlan
    cleanup.CleanupPlanPrepare(plan, limits(), 0)
    bindSingleLeafTypeLayout(plan, snapshotAction.typeId)
    cleanup.CleanupPlanBindLocalSchema(plan, body)
    bindOwnershipConditionFlagSlots(plan,
                                    ownershipAnalysis,
                                    ownershipFlagSlots)
    var fragment = ownedMutationFragment(body,
                                         source,
                                         "owned_str_defer_mutate")
    let fragmentId = cleanup.CleanupPlanCaptureFragment(plan, fragment)
    let root = cleanup.CleanupPlanRootScopeId(plan)
    let suite = cleanup.CleanupPlanAddScope(plan, root)
    let deferId = cleanup.CleanupPlanRegisterDefer(plan,
                                                   root,
                                                   suite,
                                                   1,
                                                   flag,
                                                   fragmentId)
    cleanup.CleanupPlanBindOwnershipDefer(plan,
                                          deferId,
                                          ownershipDeferId)
    cleanup.CleanupPlanBindOwnershipPlace(plan,
                                          ownershipPlaceId,
                                          source,
                                          snapshotAction.typeId)
    cleanup.CleanupPlanBindOwnershipDropGlue(plan,
                                             701,
                                             snapshotAction.typeId,
                                             "owned_str_source_drop")
    let sourceValueDefOpId = appendCopyOp(body, input, source)
    var sourceDefinition = body.ops[sourceValueDefOpId]
    sourceDefinition.valueDefSlot = source
    sourceDefinition.valueDefExprNodeIndex = 17101
    sourceDefinition.valueDefOwnership = coreir.OwnMove
    sourceDefinition.valueDefOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    sourceDefinition.valueDefOriginId = 17101
    sourceDefinition.sourceValueDefOpId = -1
    sourceDefinition.consumeActionRow = -1
    body.ops[sourceValueDefOpId] = sourceDefinition
    let _ = appendConstOp(body, activationMarker, 1)
    var ret: coreir.BodyTerm
    ret.kind = coreir.BodyTermReturnTag
    ret.resultSlot = source
    let retIndex = coreir.BodyIRAppendTerm(body, ret)
    let _ = coreir.BodyIRAppendBlock(body, 0, 2, retIndex)
    cleanup.CleanupPlanBindOwnershipOpTransitions(plan,
                                                   body,
                                                   ownershipAnalysis,
                                                   initializeOwnershipOp,
                                                   0,
                                                   0)
    cleanup.CleanupPlanBindOwnershipOpTransitions(plan,
                                                   body,
                                                   ownershipAnalysis,
                                                   activateOwnershipOp,
                                                   0,
                                                   1)
    cleanup.CleanupPlanQueueOwnedReturnExit(plan,
                                            0,
                                            root,
                                            source,
                                            snapshot,
                                            ownershipIr,
                                            ownershipAnalysis,
                                            ownershipEdgeId)
    let report = cleanup.CleanupPlanMaterialize(body, plan)
    var materializedSourceValueDefOpId = -1
    var snapshotDefinitionOpIndex = -1
    var snapshotDefinitionCallIndex = -1
    for opIndex in 0..<body.ops.len:
        let op = body.ops[opIndex]
        if op.valueDefOriginKind ==
               coreir.BodyDefinitionOriginTypedExprTag &&
           op.valueDefOriginId == 17101 &&
           op.valueDefExprNodeIndex == 17101 &&
           op.valueDefSlot == source &&
           op.valueDefOwnership == coreir.OwnMove:
            if materializedSourceValueDefOpId >= 0:
                panic("cleanup cfg smoke: owned sret source definition duplicated")
            materializedSourceValueDefOpId = opIndex
        if op.kind == coreir.BodyOpCallTag &&
           op.target == snapshot &&
           op.operands.len == 1:
            snapshotDefinitionOpIndex = opIndex
            snapshotDefinitionCallIndex = op.operands[0]
    smokeAssert(materializedSourceValueDefOpId >= 0 &&
                snapshotDefinitionOpIndex >= 0 &&
                snapshotDefinitionCallIndex >= 0 &&
                snapshotDefinitionCallIndex < body.callSequence.len,
                "cleanup cfg smoke: owned sret definition carrier missing")
    let snapshotDefinitionOp = body.ops[snapshotDefinitionOpIndex]
    let snapshotDefinitionCall =
        body.callSequence[snapshotDefinitionCallIndex]
    var snapshotReturnTermIndex = -1
    for termIndex in 0..<body.terms.len:
        let term = body.terms[termIndex]
        if term.kind == coreir.BodyTermReturnTag &&
           term.resultSlot == snapshot:
            snapshotReturnTermIndex = termIndex
    var snapshotReturnAuthorityExact: bool
    if snapshotReturnTermIndex >= 0:
        let snapshotReturn =
            body.terms[snapshotReturnTermIndex]
        snapshotReturnAuthorityExact =
            snapshotReturn.sourceValueDefOpId ==
                snapshotDefinitionOpIndex
    let consumedReturnSource =
        body.ops[materializedSourceValueDefOpId]
    smokeAssert(snapshotDefinitionOp.valueDefSlot == snapshot &&
                snapshotDefinitionOp.valueDefExprNodeIndex == 17101 &&
                snapshotDefinitionOp.valueDefOwnership ==
                    coreir.OwnMove &&
                snapshotDefinitionOp.valueDefOriginKind ==
                    coreir.BodyDefinitionOriginCanonicalCleanupActionTag &&
                snapshotDefinitionOp.valueDefOriginId >= 0 &&
                snapshotDefinitionOp.sourceValueDefOpId ==
                    materializedSourceValueDefOpId &&
                consumedReturnSource.valueDefConsumeOpIndexPlusOne ==
                    snapshotDefinitionOpIndex + 1 &&
                consumedReturnSource.consumeActionRow ==
                    snapshotDefinitionOp.valueDefOriginId &&
                snapshotDefinitionCall.resultSlot == snapshot &&
                snapshotDefinitionCall.resultExprNodeIndex == 17101 &&
                snapshotDefinitionCall.resultOwnership ==
                    coreir.OwnMove &&
                snapshotDefinitionCall.resultDefinitionOriginKind ==
                    coreir.BodyDefinitionOriginCanonicalCleanupActionTag &&
                snapshotDefinitionCall.resultDefinitionOriginId ==
                    snapshotDefinitionOp.valueDefOriginId &&
                snapshotDefinitionCall.sourceValueDefOpId ==
                    materializedSourceValueDefOpId &&
                snapshotReturnAuthorityExact,
                "cleanup cfg smoke: owned sret authority drift")
    var accessTable = bodyaccess.BodyIrAccessDecode(body)
    smokeAssert(accessTable.valid,
                "cleanup cfg smoke: owned sret authority rejected")
    var mutatedSnapshotCall =
        body.callSequence[snapshotDefinitionCallIndex]
    mutatedSnapshotCall.sourceValueDefOpId = -1
    body.callSequence[snapshotDefinitionCallIndex] =
        mutatedSnapshotCall
    accessTable = bodyaccess.BodyIrAccessDecode(body)
    smokeAssert(!accessTable.valid &&
                accessTable.errorCode ==
                    bodyaccess.BodyIrAccessOwnershipInvariantErrorCode(),
                "cleanup cfg smoke: owned sret source mutation accepted")
    mutatedSnapshotCall.sourceValueDefOpId =
        materializedSourceValueDefOpId
    body.callSequence[snapshotDefinitionCallIndex] =
        mutatedSnapshotCall
    body.ops[snapshotDefinitionOpIndex].valueDefOriginId =
        snapshotDefinitionOp.valueDefOriginId + 1
    accessTable = bodyaccess.BodyIrAccessDecode(body)
    smokeAssert(!accessTable.valid &&
                accessTable.errorCode ==
                    bodyaccess.BodyIrAccessOwnershipInvariantErrorCode(),
                "cleanup cfg smoke: owned sret origin mutation accepted")
    body.ops[snapshotDefinitionOpIndex].valueDefOriginId =
        snapshotDefinitionOp.valueDefOriginId
    var mutatedReturn =
        body.terms[snapshotReturnTermIndex]
    mutatedReturn.sourceValueDefOpId = -1
    body.terms[snapshotReturnTermIndex] = mutatedReturn
    accessTable = bodyaccess.BodyIrAccessDecode(body)
    smokeAssert(!accessTable.valid &&
                accessTable.errorCode ==
                    bodyaccess.BodyIrAccessOwnershipInvariantErrorCode(),
                "cleanup cfg smoke: return value-def deletion accepted")
    mutatedReturn.sourceValueDefOpId =
        snapshotDefinitionOpIndex
    body.terms[snapshotReturnTermIndex] = mutatedReturn
    var locals = zeroLocals(body)
    fixtureArenaWriteI32(body, locals, input, 7)
    var log: str[]
    var ledger: OwnershipResourceLedger
    ledger.allocCount = 1
    ledger.liveOwnerCount = 1
    let result = runBodyWithLedger(body,
                                   0,
                                   locals,
                                   log,
                                   true,
                                   ledger)
    smokeAssert(result.returnValue == 7 &&
                fixtureArenaReadI32(body, locals, snapshot) == 7 &&
                fixtureArenaReadI32(body, locals, source) == 0 &&
                log.len == 3 &&
                log[0] == "owned_str_snapshot_retain" &&
                log[1] == "owned_str_defer_mutate" &&
                log[2] == "owned_str_source_drop" &&
                report.materializedCallCount == 3 &&
                report.ownershipOpTransitionSiteCount == 2 &&
                ledger.allocCount == 2 && ledger.freeCount == 1 &&
                ledger.retainCount == 1 && ledger.releaseCount == 2 &&
                ledger.liveOwnerCount == 1 &&
                ledger.sourceMutationCount == 1 &&
                ledger.sourceDropCount == 1 &&
                ledger.snapshotEscapeCount == 1,
                "cleanup cfg smoke: owned str materialized lifecycle")
    var callerRelease = ownedMutationFragment(body,
                                               snapshot,
                                               "owned_str_snapshot_release")
    let _ = runBodyWithLedger(callerRelease,
                              0,
                              locals,
                              log,
                              true,
                              ledger)
    smokeAssert(log.len == 4 &&
                log[3] == "owned_str_snapshot_release" &&
                ledger.allocCount == ledger.freeCount &&
                ledger.allocCount == 2 && ledger.retainCount == 1 &&
                ledger.releaseCount == 3 && ledger.liveOwnerCount == 0 &&
                ledger.sourceDropCount == 1 &&
                ledger.snapshotReleaseCount == 1 &&
                ledger.snapshotEscapeCount == 1,
                "cleanup cfg smoke: owned str caller release accounting")

fn runNestedOwnerAggregateSnapshotAccounting() =
    var ownershipIr: odir.OwnershipDropIr
    odir.OwnershipDropIrInit(ownershipIr)
    let ownershipRoot = odir.OwnershipDropRootScopeId(ownershipIr)
    let leafType = odir.OwnershipDropRegisterLeafType(ownershipIr,
                                                      "NestedOwnerLeaf",
                                                      711)
    var innerFields: int32[]
    add(innerFields, leafType)
    add(innerFields, leafType)
    let innerType = odir.OwnershipDropRegisterAggregateType(
        ownershipIr,
        "NestedOwnerInner",
        712,
        innerFields)
    var outerFields: int32[]
    add(outerFields, innerType)
    add(outerFields, leafType)
    let outerType = odir.OwnershipDropRegisterAggregateType(
        ownershipIr,
        "NestedOwnerOuter",
        713,
        outerFields)
    odir.OwnershipDropSetTypeReturnSnapshotPolicy(
        ownershipIr,
        outerType,
        odir.ReturnSnapshotClone,
        1713,
        "nested_owner_snapshot_clone")
    let ownershipPlace = odir.OwnershipDropAddPlace(ownershipIr,
                                                    outerType,
                                                    odir.Owned,
                                                    ownershipRoot)
    let ownershipDefer = odir.OwnershipDropRegisterDeferEffect(
        ownershipIr,
        ownershipRoot,
        odir.DeferEffectUseWrite,
        ownershipPlace,
        -1)
    let ownershipEntry = odir.OwnershipDropAddBlock(ownershipIr,
                                                    ownershipRoot)
    odir.OwnershipDropSetEntryBlock(ownershipIr, ownershipEntry)
    let initializeOwnershipOp = odir.OwnershipDropAppendInitialize(
        ownershipIr,
        ownershipEntry,
        ownershipPlace)
    let activateOwnershipOp = odir.OwnershipDropAppendActivateDefer(
        ownershipIr,
        ownershipEntry,
        ownershipDefer)
    let ownershipExit = odir.OwnershipDropAddBlock(ownershipIr,
                                                   ownershipRoot)
    var cleanupIds: int32[]
    add(cleanupIds, ownershipPlace)
    var deferIds: int32[]
    add(deferIds, ownershipDefer)
    let ownershipEdge = odir.OwnershipDropAddEdge(
        ownershipIr,
        ownershipEntry,
        ownershipExit,
        odir.OwnershipDropEdgeReturn,
        ownershipPlace,
        cleanupIds,
        deferIds)
    odir.OwnershipDropBindReturnDefinitionAuthority(
        ownershipIr,
        ownershipEdge,
        17201,
        odir.Owned,
        0)
    var ownershipAnalysis: odir.OwnershipDropAnalysis
    odir.OwnershipDropAnalyze(ownershipIr, ownershipAnalysis)
    smokeAssert(odir.OwnershipDropAnalysisEdgeActionCount(ownershipAnalysis,
                                                          ownershipEdge) == 3,
                "cleanup cfg smoke: nested owner action count")
    let snapshotAction = odir.OwnershipDropAnalysisEdgeAction(ownershipAnalysis,
                                                              ownershipEdge,
                                                              0)
    let sourceDropAction = odir.OwnershipDropAnalysisEdgeAction(ownershipAnalysis,
                                                                ownershipEdge,
                                                                2)
    smokeAssert(snapshotAction.kind ==
                    odir.CleanupActionSnapshotCloneOwnedReturn &&
                sourceDropAction.kind == odir.CleanupActionDropPlace &&
                sourceDropAction.typeId == outerType,
                "cleanup cfg smoke: nested owner snapshot/drop order")

    var body = coreir.BodyIRNew()
    let input = addAggregateSlot(body, "nested_owner_input")
    let source = addAggregateSlot(body, "nested_owner_source")
    let snapshot = addAggregateSlot(body, "nested_owner_snapshot")
    let flag = addI32Slot(body, "nested_owner_defer_flag")
    let activationMarker = addI32Slot(body,
                                      "nested_owner_activation_marker")
    var ownershipFlagSlots = addOwnershipConditionFlagSlots(body,
                                                             ownershipAnalysis)
    var plan: cleanup.CleanupPlan
    cleanup.CleanupPlanPrepare(plan, limits(), 0)
    bindOpaqueAggregateTypeLayouts(plan, outerType, 24)
    cleanup.CleanupPlanBindLocalSchema(plan, body)
    bindOwnershipConditionFlagSlots(plan,
                                    ownershipAnalysis,
                                    ownershipFlagSlots)
    var fragment = ownedMutationFragment(body,
                                         source,
                                         "nested_owner_defer_mutate")
    let fragmentId = cleanup.CleanupPlanCaptureFragment(plan, fragment)
    let root = cleanup.CleanupPlanRootScopeId(plan)
    let suite = cleanup.CleanupPlanAddScope(plan, root)
    let deferId = cleanup.CleanupPlanRegisterDefer(plan,
                                                   root,
                                                   suite,
                                                   1,
                                                   flag,
                                                   fragmentId)
    cleanup.CleanupPlanBindOwnershipDefer(plan,
                                          deferId,
                                          ownershipDefer)
    cleanup.CleanupPlanBindOwnershipPlace(plan,
                                          ownershipPlace,
                                          source,
                                          outerType)
    cleanup.CleanupPlanBindOwnershipDropGlue(plan,
                                             713,
                                             outerType,
                                             "nested_owner_source_drop")
    let sourceValueDefOpId = appendCopyOp(body, input, source)
    var sourceDefinition = body.ops[sourceValueDefOpId]
    sourceDefinition.valueDefSlot = source
    sourceDefinition.valueDefExprNodeIndex = 17201
    sourceDefinition.valueDefOwnership = coreir.OwnMove
    sourceDefinition.valueDefOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    sourceDefinition.valueDefOriginId = 17201
    sourceDefinition.sourceValueDefOpId = -1
    sourceDefinition.consumeActionRow = -1
    body.ops[sourceValueDefOpId] = sourceDefinition
    let _ = appendConstOp(body, activationMarker, 1)
    var ret: coreir.BodyTerm
    ret.kind = coreir.BodyTermReturnTag
    ret.resultSlot = source
    let retIndex = coreir.BodyIRAppendTerm(body, ret)
    let _ = coreir.BodyIRAppendBlock(body, 0, 2, retIndex)
    cleanup.CleanupPlanBindOwnershipOpTransitions(plan,
                                                   body,
                                                   ownershipAnalysis,
                                                   initializeOwnershipOp,
                                                   0,
                                                   0)
    cleanup.CleanupPlanBindOwnershipOpTransitions(plan,
                                                   body,
                                                   ownershipAnalysis,
                                                   activateOwnershipOp,
                                                   0,
                                                   1)
    cleanup.CleanupPlanQueueOwnedReturnExit(plan,
                                            0,
                                            root,
                                            source,
                                            snapshot,
                                            ownershipIr,
                                            ownershipAnalysis,
                                            ownershipEdge)
    let report = cleanup.CleanupPlanMaterialize(body, plan)
    var locals = zeroLocals(body)
    fixtureArenaWriteI32(body, locals, input, 17)
    var log: str[]
    var ledger: OwnershipResourceLedger
    ledger.allocCount = 3
    ledger.liveOwnerCount = 3
    let result = runBodyWithLedger(body,
                                   0,
                                   locals,
                                   log,
                                   true,
                                   ledger)
    var nestedDropFlagsCleared = true
    let nestedFlagCount =
        odir.OwnershipDropAnalysisConditionFlagCount(ownershipAnalysis)
    for flagId in 1..nestedFlagCount:
        let flagRow = odir.OwnershipDropAnalysisConditionFlag(
            ownershipAnalysis,
            flagId)
        if flagRow.placeId == ownershipPlace &&
           (flagRow.kind == odir.ConditionFlagPlaceInitialized ||
            flagRow.kind == odir.ConditionFlagFieldInitialized):
            let flagSlot = ownershipFlagSlots[flagId - 1]
            if fixtureArenaReadI32(body, locals, flagSlot) != 0:
                nestedDropFlagsCleared = false
    smokeAssert(result.returnValue == 17 &&
                fixtureArenaReadI32(body, locals, snapshot) == 17 &&
                fixtureArenaReadI32(body, locals, source) == 0 &&
                log.len == 3 &&
                log[0] == "nested_owner_snapshot_clone" &&
                log[1] == "nested_owner_defer_mutate" &&
                log[2] == "nested_owner_source_drop" &&
                report.materializedCallCount == 3 &&
                ledger.allocCount == 9 && ledger.freeCount == 6 &&
                ledger.cloneCount == 3 && ledger.releaseCount == 6 &&
                ledger.liveOwnerCount == 3 &&
                ledger.sourceMutationCount == 1 &&
                ledger.sourceDropCount == 1 &&
                ledger.snapshotEscapeCount == 1 &&
                nestedDropFlagsCleared,
                "cleanup cfg smoke: nested owner materialized lifecycle")
    var callerRelease = ownedMutationFragment(
        body,
        snapshot,
        "nested_owner_snapshot_release")
    let _ = runBodyWithLedger(callerRelease,
                              0,
                              locals,
                              log,
                              true,
                              ledger)
    smokeAssert(log.len == 4 &&
                log[3] == "nested_owner_snapshot_release" &&
                ledger.allocCount == 9 && ledger.freeCount == 9 &&
                ledger.cloneCount == 3 && ledger.releaseCount == 9 &&
                ledger.liveOwnerCount == 0 &&
                ledger.sourceDropCount == 1 &&
                ledger.snapshotReleaseCount == 1 &&
                ledger.snapshotEscapeCount == 1,
                "cleanup cfg smoke: nested owner caller release accounting")

fn runPartialAggregateFieldDropMaterialization() =
    var ownershipIr: odir.OwnershipDropIr
    odir.OwnershipDropIrInit(ownershipIr)
    let ownershipRoot = odir.OwnershipDropRootScopeId(ownershipIr)
    let leafType = odir.OwnershipDropRegisterLeafType(ownershipIr,
                                                      "PartialLeaf",
                                                      721)
    var fields: int32[]
    add(fields, leafType)
    add(fields, leafType)
    let innerType = odir.OwnershipDropRegisterAggregateType(
        ownershipIr,
        "PartialInner",
        722,
        fields)
    var ownershipFields: int32[]
    add(ownershipFields, leafType)
    add(ownershipFields, leafType)
    add(ownershipFields, leafType)
    let aggregateType = odir.OwnershipDropRegisterAggregateType(
        ownershipIr,
        "PartialAggregate",
        723,
        ownershipFields)
    let ownershipPlace = odir.OwnershipDropAddPlace(ownershipIr,
                                                    aggregateType,
                                                    odir.Owned,
                                                    ownershipRoot)
    let ownershipEntry = odir.OwnershipDropAddBlock(ownershipIr,
                                                    ownershipRoot)
    odir.OwnershipDropSetEntryBlock(ownershipIr, ownershipEntry)
    let initializeFirstFieldOp = odir.OwnershipDropAppendInitializeField(
        ownershipIr,
        ownershipEntry,
        ownershipPlace,
        0)
    let initializeSecondFieldOp = odir.OwnershipDropAppendInitializeField(
        ownershipIr,
        ownershipEntry,
        ownershipPlace,
        1)
    let ownershipExit = odir.OwnershipDropAddBlock(ownershipIr,
                                                   ownershipRoot)
    var cleanupIds: int32[]
    add(cleanupIds, ownershipPlace)
    var deferIds: int32[]
    let ownershipEdge = odir.OwnershipDropAddEdge(
        ownershipIr,
        ownershipEntry,
        ownershipExit,
        odir.OwnershipDropEdgeReturn,
        -1,
        cleanupIds,
        deferIds)
    var ownershipAnalysis: odir.OwnershipDropAnalysis
    odir.OwnershipDropAnalyze(ownershipIr, ownershipAnalysis)
    smokeAssert(odir.OwnershipDropAnalysisEdgeActionCount(ownershipAnalysis,
                                                          ownershipEdge) == 2,
                "cleanup cfg smoke: partial aggregate action count")
    let secondFieldAction = odir.OwnershipDropAnalysisEdgeAction(
        ownershipAnalysis,
        ownershipEdge,
        0)
    let firstFieldAction = odir.OwnershipDropAnalysisEdgeAction(
        ownershipAnalysis,
        ownershipEdge,
        1)
    smokeAssert(secondFieldAction.kind == odir.CleanupActionDropField &&
                secondFieldAction.placeId == ownershipPlace &&
                secondFieldAction.fieldOrdinal == 1 &&
                secondFieldAction.dropGlueId == 721 &&
                firstFieldAction.kind == odir.CleanupActionDropField &&
                firstFieldAction.fieldOrdinal == 0,
                "cleanup cfg smoke: partial field action shape")

    var body = coreir.BodyIRNew()
    let aggregateInput = addManagedSlot(body,
                                        "partial_aggregate_input",
                                        coreir.LocalAggregateTag,
                                        72)
    let aggregateBase = addManagedSlot(body,
                                       "partial_aggregate",
                                       coreir.LocalAggregateTag,
                                       72)
    let fieldInitMarker = addI32Slot(body, "partial_field_init_marker")
    var ownershipFlagSlots = addOwnershipConditionFlagSlots(body,
                                                             ownershipAnalysis)
    var plan: cleanup.CleanupPlan
    cleanup.CleanupPlanPrepare(plan, limits(), 0)
    bindNestedPartialThreeLeafTypeLayout(plan,
                                        leafType,
                                        innerType,
                                        aggregateType)
    cleanup.CleanupPlanBindLocalSchema(plan, body)
    bindOwnershipConditionFlagSlots(plan,
                                    ownershipAnalysis,
                                    ownershipFlagSlots)
    cleanup.CleanupPlanBindOwnershipPlace(plan,
                                          ownershipPlace,
                                          aggregateBase,
                                          aggregateType)
    let firstFieldProjection = cleanup.CleanupPlanBindOwnershipFieldProjection(
        plan,
        body,
        ownershipPlace,
        0)
    let secondFieldProjection =
        cleanup.CleanupPlanBindOwnershipFieldProjection(plan,
                                                        body,
                                                        ownershipPlace,
                                                        1)
    cleanup.CleanupPlanBindOwnershipDropGlue(plan,
                                             721,
                                             leafType,
                                             "partial_leaf_drop")
    var ret: coreir.BodyTerm
    ret.kind = coreir.BodyTermReturnTag
    ret.resultSlot = -1
    let _ = appendCopyOp(body, aggregateInput, aggregateBase)
    let _ = appendConstOp(body, fieldInitMarker, 1)
    let retIndex = coreir.BodyIRAppendTerm(body, ret)
    let _ = coreir.BodyIRAppendBlock(body, 0, 2, retIndex)
    cleanup.CleanupPlanBindOwnershipOpTransitions(plan,
                                                   body,
                                                   ownershipAnalysis,
                                                   initializeFirstFieldOp,
                                                   0,
                                                   0)
    cleanup.CleanupPlanBindOwnershipOpTransitions(plan,
                                                   body,
                                                   ownershipAnalysis,
                                                   initializeSecondFieldOp,
                                                   0,
                                                   1)
    let root = cleanup.CleanupPlanRootScopeId(plan)
    cleanup.CleanupPlanQueueOwnershipReturnExit(plan,
                                                0,
                                                root,
                                                -1,
                                                -1,
                                                ownershipIr,
                                                ownershipAnalysis,
                                                ownershipEdge)
    let report = cleanup.CleanupPlanMaterialize(body, plan)
    var locals = zeroLocals(body)
    fixtureArenaWriteI32At(body, locals, aggregateInput, 0, 101)
    fixtureArenaWriteI32At(body, locals, aggregateInput, 24, 202)
    var log: str[]
    var ledger: OwnershipResourceLedger
    ledger.allocCount = 2
    ledger.liveOwnerCount = 2
    let _ = runBodyWithLedger(body,
                              0,
                              locals,
                              log,
                              true,
                              ledger)
    var dropAddressSlots: int32[]
    for callIndex in 0..<body.callSequence.len:
        if body.callSequence[callIndex].targetSymbol == "partial_leaf_drop":
            add(dropAddressSlots,
                fixtureCallAddressSource(body.callSequence[callIndex]))
    smokeAssert(log.len == 2 && log[0] == "partial_leaf_drop" &&
                log[1] == "partial_leaf_drop" &&
                report.materializedCallCount == 2 &&
                report.ownershipFieldProjectionCount == 2 &&
                dropAddressSlots.len == 2 &&
                dropAddressSlots[0] == secondFieldProjection &&
                dropAddressSlots[1] == firstFieldProjection &&
                body.localSlots[firstFieldProjection].placeKind ==
                    coreir.BodyPlaceBorrowAddressTag &&
                body.localSlots[firstFieldProjection].auxValue == aggregateBase &&
                body.localSlots[firstFieldProjection].stackOffset ==
                    body.localSlots[aggregateBase].stackOffset &&
                body.localSlots[secondFieldProjection].stackOffset ==
                    body.localSlots[aggregateBase].stackOffset + 24 &&
                ledger.fieldDropResourceIds.len == 2 &&
                ledger.fieldDropResourceIds[0] == 202 &&
                ledger.fieldDropResourceIds[1] == 101 &&
                ledger.fieldDropCount == 2 &&
                ledger.releaseCount == 2 && ledger.freeCount == 2 &&
                ledger.liveOwnerCount == 0,
                "cleanup cfg smoke: nested field materialized drop order")

fn runOwnershipGuardMaterialization() =
    var ownershipIr: odir.OwnershipDropIr
    var ownershipAnalysis: odir.OwnershipDropAnalysis
    var ownershipDeferId: int32
    var ownershipEdgeId: int32
    var ownershipPlaceId: int32
    var initializeOwnershipOp: int32
    var activateOwnershipOp: int32
    var guardedAction: odir.OwnershipDropCleanupAction
    var fallbackAction: odir.OwnershipDropCleanupAction
    buildConditionalOwnershipGuard(ownershipIr,
                                   ownershipAnalysis,
                                   ownershipDeferId,
                                   ownershipEdgeId,
                                   ownershipPlaceId,
                                   initializeOwnershipOp,
                                   activateOwnershipOp,
                                   guardedAction,
                                   fallbackAction)
    let projection = odir.OwnershipDropProjectActionCondition(ownershipIr,
                                                               ownershipAnalysis,
                                                               guardedAction)
    smokeAssert(projection.conditionCount == 3 &&
                projection.guardKind == odir.DropConditionDeferActive &&
                projection.guardDeferId == ownershipDeferId &&
                projection.guardFlagId > 0 &&
                !projection.guardNegated &&
                fallbackAction.conditionKind ==
                    odir.DropConditionPlaceInitialized &&
                fallbackAction.guardDeferId == ownershipDeferId &&
                odir.OwnershipDropProjectActionCondition(
                    ownershipIr,
                    ownershipAnalysis,
                    fallbackAction).guardNegated,
                "cleanup cfg smoke: ownership guard projection")

    var body = coreir.BodyIRNew()
    let branchGuard = addI32Slot(body, "ownership_branch_guard")
    let activeFlag = addI32Slot(body, "ownership_defer_active")
    let ownerInput = addStrSlot(body, "guarded_owner_input")
    let owner = addStrSlot(body, "guarded_owner")
    let activationMarker = addI32Slot(body,
                                      "guarded_owner_activation_marker")
    var ownershipFlagSlots = addOwnershipConditionFlagSlots(body,
                                                             ownershipAnalysis)
    let placeInitializedFlag = ownershipFlagSlot(
        ownershipAnalysis,
        ownershipFlagSlots,
        odir.ConditionFlagPlaceInitialized,
        ownershipPlaceId,
        -1)
    var plan: cleanup.CleanupPlan
    cleanup.CleanupPlanPrepare(plan, limits(), 0)
    bindSingleLeafTypeLayout(plan, guardedAction.typeId)
    cleanup.CleanupPlanBindLocalSchema(plan, body)
    bindOwnershipConditionFlagSlots(plan,
                                    ownershipAnalysis,
                                    ownershipFlagSlots)
    var fragment = callFragment(body, "guarded_defer_body")
    let fragmentId = cleanup.CleanupPlanCaptureFragment(plan, fragment)
    let root = cleanup.CleanupPlanRootScopeId(plan)
    let suite = cleanup.CleanupPlanAddScope(plan, root)
    let deferId = cleanup.CleanupPlanRegisterDefer(plan,
                                                   root,
                                                   suite,
                                                   1,
                                                   activeFlag,
                                                   fragmentId)
    cleanup.CleanupPlanBindOwnershipDefer(plan,
                                          deferId,
                                          ownershipDeferId)
    cleanup.CleanupPlanBindOwnershipPlace(plan,
                                          ownershipPlaceId,
                                          owner,
                                          guardedAction.typeId)
    cleanup.CleanupPlanBindOwnershipDropGlue(plan,
                                             702,
                                             guardedAction.typeId,
                                             "guarded_owner_drop")
    let _ = appendCopyOp(body, ownerInput, owner)
    var branch: coreir.BodyTerm
    branch.kind = coreir.BodyTermCbrTag
    branch.conditionKind = coreir.BodyCondLocalNonZeroTag
    branch.lhsSlot = branchGuard
    branch.trueBlock = 1
    branch.falseBlock = 2
    add(branch.operands, branchGuard)
    let branchTerm = coreir.BodyIRAppendTerm(body, branch)
    let _ = coreir.BodyIRAppendBlock(body, 0, 1, branchTerm)
    let activeStart = body.ops.len
    let _ = appendConstOp(body, activationMarker, 1)
    var activeBr: coreir.BodyTerm
    activeBr.kind = coreir.BodyTermBrTag
    activeBr.trueBlock = 3
    let activeTerm = coreir.BodyIRAppendTerm(body, activeBr)
    let _ = coreir.BodyIRAppendBlock(body, activeStart, 1, activeTerm)
    var inactiveBr: coreir.BodyTerm
    inactiveBr.kind = coreir.BodyTermBrTag
    inactiveBr.trueBlock = 3
    let inactiveTerm = coreir.BodyIRAppendTerm(body, inactiveBr)
    let _ = coreir.BodyIRAppendBlock(body,
                                     body.ops.len,
                                     0,
                                     inactiveTerm)
    let joinBlock = appendReturnBlock(body, -1)
    smokeAssert(joinBlock == 3,
                "cleanup cfg smoke: ownership guard join block")
    cleanup.CleanupPlanBindOwnershipOpTransitions(plan,
                                                   body,
                                                   ownershipAnalysis,
                                                   initializeOwnershipOp,
                                                   0,
                                                   0)
    cleanup.CleanupPlanBindOwnershipOpTransitions(plan,
                                                   body,
                                                   ownershipAnalysis,
                                                   activateOwnershipOp,
                                                   1,
                                                   0)
    cleanup.CleanupPlanQueueOwnershipReturnExit(plan,
                                                joinBlock,
                                                root,
                                                -1,
                                                -1,
                                                ownershipIr,
                                                ownershipAnalysis,
                                                ownershipEdgeId)
    let actionFingerprintBefore =
        cleanup.CleanupPlanOwnershipActionFingerprint(plan)
    let report = cleanup.CleanupPlanMaterialize(body, plan)
    smokeAssert(report.ownershipActionFingerprintBefore ==
                    actionFingerprintBefore &&
                report.ownershipActionFingerprintAfter ==
                    actionFingerprintBefore &&
                report.ownershipGuardProjectionCount == 2 &&
                report.ownershipGuardedDeferUnitCount == 1,
                "cleanup cfg smoke: ownership action identity mutated")
    var inactiveLocals = zeroLocals(body)
    fixtureArenaWriteI32(body, inactiveLocals, ownerInput, 1)
    var inactiveLog: str[]
    var inactiveLedger: OwnershipResourceLedger
    inactiveLedger.allocCount = 1
    inactiveLedger.liveOwnerCount = 1
    let _ = runBodyWithLedger(body,
                              0,
                              inactiveLocals,
                              inactiveLog,
                              true,
                              inactiveLedger)
    smokeAssert(inactiveLog.len == 1 &&
                inactiveLog[0] == "guarded_owner_drop" &&
                inactiveLedger.allocCount == 1 &&
                inactiveLedger.freeCount == 1 &&
                inactiveLedger.liveOwnerCount == 0 &&
                inactiveLedger.sourceDropCount == 1 &&
                fixtureArenaReadI32(body, inactiveLocals, activeFlag) == 0 &&
                fixtureArenaReadI32(body,
                                    inactiveLocals,
                                    placeInitializedFlag) == 0,
                "cleanup cfg smoke: inactive guarded fallback drop")
    var activeLocals = zeroLocals(body)
    fixtureArenaWriteI32(body, activeLocals, branchGuard, 1)
    fixtureArenaWriteI32(body, activeLocals, ownerInput, 1)
    var activeLog: str[]
    var activeLedger: OwnershipResourceLedger
    activeLedger.allocCount = 1
    activeLedger.liveOwnerCount = 1
    let _ = runBodyWithLedger(body,
                              0,
                              activeLocals,
                              activeLog,
                              true,
                              activeLedger)
    smokeAssert(activeLog.len == 2 &&
                activeLog[0] == "guarded_defer_body" &&
                activeLog[1] == "guarded_owner_drop" &&
                activeLedger.allocCount == 1 &&
                activeLedger.freeCount == 1 &&
                activeLedger.liveOwnerCount == 0 &&
                activeLedger.sourceDropCount == 1 &&
                fixtureArenaReadI32(body, activeLocals, activeFlag) == 0 &&
                fixtureArenaReadI32(body,
                                    activeLocals,
                                    placeInitializedFlag) == 0,
                "cleanup cfg smoke: active guarded drop executes once")

fn runOwnershipOpActionMaterialization() =
    var ownershipIr: odir.OwnershipDropIr
    odir.OwnershipDropIrInit(ownershipIr)
    let root = odir.OwnershipDropRootScopeId(ownershipIr)
    let valueType = odir.OwnershipDropRegisterLeafType(ownershipIr,
                                                       "OpMoveValue",
                                                       811)
    let sourcePlace = odir.OwnershipDropAddPlace(ownershipIr,
                                                 valueType,
                                                 odir.Owned,
                                                 root)
    let targetPlace = odir.OwnershipDropAddPlace(ownershipIr,
                                                 valueType,
                                                 odir.Owned,
                                                 root)
    let ownershipEntry = odir.OwnershipDropAddBlock(ownershipIr, root)
    odir.OwnershipDropSetEntryBlock(ownershipIr, ownershipEntry)
    let initializeSource = odir.OwnershipDropAppendInitialize(
        ownershipIr,
        ownershipEntry,
        sourcePlace)
    let initializeTarget = odir.OwnershipDropAppendInitialize(
        ownershipIr,
        ownershipEntry,
        targetPlace)
    let moveOp = odir.OwnershipDropAppendMove(ownershipIr,
                                              ownershipEntry,
                                              sourcePlace,
                                              targetPlace)
    odir.OwnershipDropBindOpDefinitionAuthority(
        ownershipIr,
        moveOp,
        odir.DefinitionOriginTypedExpr,
        19101,
        0,
        odir.Owned)
    let ownershipExit = odir.OwnershipDropAddBlock(ownershipIr, root)
    var cleanupIds: int32[]
    var deferIds: int32[]
    let _ = odir.OwnershipDropAddEdge(ownershipIr,
                                      ownershipEntry,
                                      ownershipExit,
                                      odir.OwnershipDropEdgeNormal,
                                      -1,
                                      cleanupIds,
                                      deferIds)
    let ownershipTerminal = odir.OwnershipDropAddBlock(ownershipIr, root)
    var returnCleanupIds: int32[]
    add(returnCleanupIds, sourcePlace)
    add(returnCleanupIds, targetPlace)
    var returnDeferIds: int32[]
    let ownershipReturnEdge = odir.OwnershipDropAddEdge(
        ownershipIr,
        ownershipExit,
        ownershipTerminal,
        odir.OwnershipDropEdgeReturn,
        -1,
        returnCleanupIds,
        returnDeferIds)
    var ownershipAnalysis: odir.OwnershipDropAnalysis
    odir.OwnershipDropAnalyze(ownershipIr, ownershipAnalysis)
    smokeAssert(odir.OwnershipDropAnalysisOpActionCount(ownershipAnalysis,
                                                        moveOp) == 2 &&
                odir.OwnershipDropAnalysisOpAction(ownershipAnalysis,
                                                    moveOp,
                                                    0).kind ==
                    odir.CleanupActionDropPlace &&
                odir.OwnershipDropAnalysisOpAction(ownershipAnalysis,
                                                    moveOp,
                                                    1).kind ==
                    odir.CleanupActionStoreMove,
                "cleanup cfg smoke: move op action CSR order")
    let managedTargetDropAction =
        odir.OwnershipDropAnalysisEdgeAction(
            ownershipAnalysis,
            ownershipReturnEdge,
            0)
    let managedMoveProducerActionRow =
        ownershipAnalysis.opActionStarts[moveOp] + 1
    smokeAssert(odir.OwnershipDropAnalysisEdgeActionCount(
            ownershipAnalysis,
            ownershipReturnEdge) == 1 &&
        managedTargetDropAction.kind ==
            odir.CleanupActionDropPlace &&
        managedTargetDropAction.definitionOriginKind ==
            odir.DefinitionOriginCanonicalSyntheticAction &&
        managedTargetDropAction.definitionOriginId ==
            managedMoveProducerActionRow &&
        managedTargetDropAction.sourceValueDefOpId == -1 &&
        managedTargetDropAction.sourceOwnership == odir.Owned &&
        managedTargetDropAction.consumeActionRow >= 0,
        "cleanup cfg smoke: managed move analysis carrier drift")

    var body = coreir.BodyIRNew()
    let sourceInput = addStrSlot(body, "op_move_source_input")
    let targetInput = addStrSlot(body, "op_move_target_input")
    let source = addStrSlot(body, "op_move_source")
    let target = addStrSlot(body, "op_move_target")
    let marker = addI32Slot(body, "op_move_marker")
    var ownershipFlagSlots = addOwnershipConditionFlagSlots(body,
                                                             ownershipAnalysis)
    var plan: cleanup.CleanupPlan
    cleanup.CleanupPlanPrepare(plan, limits(), 0)
    bindSingleLeafTypeLayout(plan, valueType)
    cleanup.CleanupPlanBindLocalSchema(plan, body)
    bindOwnershipConditionFlagSlots(plan,
                                    ownershipAnalysis,
                                    ownershipFlagSlots)
    cleanup.CleanupPlanBindOwnershipPlace(plan,
                                          sourcePlace,
                                          source,
                                          valueType)
    cleanup.CleanupPlanBindOwnershipPlace(plan,
                                          targetPlace,
                                          target,
                                          valueType)
    cleanup.CleanupPlanBindOwnershipDropGlue(plan,
                                             811,
                                             valueType,
                                             "op_move_target_drop")
    let sourceValueDefOpId = appendCopyOp(body, sourceInput, source)
    var sourceDefinition = body.ops[sourceValueDefOpId]
    sourceDefinition.valueDefSlot = source
    sourceDefinition.valueDefExprNodeIndex = 19101
    sourceDefinition.valueDefOwnership = coreir.OwnMove
    sourceDefinition.valueDefOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    sourceDefinition.valueDefOriginId = 19101
    sourceDefinition.sourceValueDefOpId = -1
    sourceDefinition.consumeActionRow = -1
    body.ops[sourceValueDefOpId] = sourceDefinition
    let _ = appendCopyOp(body, targetInput, target)
    let _ = appendConstOp(body, marker, 1)
    var branch: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(branch)
    branch.kind = coreir.BodyTermBrTag
    branch.trueBlock = 1
    let branchTerm = coreir.BodyIRAppendTerm(body, branch)
    let _ = coreir.BodyIRAppendBlock(body, 0, 3, branchTerm)
    let targetBlock = appendReturnBlock(body, -1)
    cleanup.CleanupPlanBindOwnershipOpTransitions(plan,
                                                   body,
                                                   ownershipAnalysis,
                                                   initializeSource,
                                                   0,
                                                   0)
    cleanup.CleanupPlanBindOwnershipOpTransitions(plan,
                                                   body,
                                                   ownershipAnalysis,
                                                   initializeTarget,
                                                   0,
                                                   1)
    cleanup.CleanupPlanBindOwnershipOpTransitions(plan,
                                                   body,
                                                   ownershipAnalysis,
                                                   moveOp,
                                                   0,
                                                   2)
    let _ = cleanup.CleanupPlanQueueUnmanagedExit(
        plan,
        0,
        0,
        root,
        root,
        odir.OwnershipDropEdgeNormal,
        targetBlock)
    let _ = cleanup.CleanupPlanQueueOwnershipReturnExit(
        plan,
        targetBlock,
        root,
        -1,
        -1,
        ownershipIr,
        ownershipAnalysis,
        ownershipReturnEdge)
    let report = cleanup.CleanupPlanMaterialize(body, plan)
    var dropCallCount: int32
    var storeCopyCount: int32
    var storeCopyOpIndex = -1
    var oldTargetDropOpIndex = -1
    var managedTargetDropOpIndex = -1
    for opIndex in 0..<body.ops.len:
        let op = body.ops[opIndex]
        if op.kind == coreir.BodyOpCallTag && op.operands.len == 1 &&
           body.callSequence[op.operands[0]].targetSymbol ==
               "op_move_target_drop":
            dropCallCount = dropCallCount + 1
            if op.sourceValueDefOpId >= 0:
                managedTargetDropOpIndex = opIndex
            else:
                oldTargetDropOpIndex = opIndex
        if op.kind == coreir.BodyOpCopyLocalTag && op.target == target &&
           op.operands.len == 1 && op.operands[0] == source:
            storeCopyCount = storeCopyCount + 1
            storeCopyOpIndex = opIndex
    smokeAssert(dropCallCount == 2 && storeCopyCount == 1 &&
                oldTargetDropOpIndex >= 0 &&
                managedTargetDropOpIndex >= 0,
                "cleanup cfg smoke: op action CFG units missing")
    let storeCopy = body.ops[storeCopyOpIndex]
    let consumedSourceValueDefOpId =
        storeCopy.sourceValueDefOpId
    let consumedSourceDefinition =
        body.ops[consumedSourceValueDefOpId]
    let managedTargetDrop = body.ops[managedTargetDropOpIndex]
    let managedTargetDropCallOrdinal =
        managedTargetDrop.operands[0]
    let managedTargetDropCall =
        body.callSequence[managedTargetDropCallOrdinal]
    smokeAssert(storeCopy.valueDefSlot == target &&
                storeCopy.valueDefOwnership == coreir.OwnMove &&
                storeCopy.valueDefOriginKind ==
                    coreir.BodyDefinitionOriginCanonicalCleanupActionTag &&
                storeCopy.valueDefOriginId >= 0 &&
                storeCopy.sourceValueDefOpId >= 0 &&
                consumedSourceDefinition.valueDefSlot ==
                    source &&
                consumedSourceDefinition.valueDefConsumeOpIndexPlusOne ==
                    storeCopyOpIndex + 1 &&
                consumedSourceDefinition.consumeActionRow ==
                    storeCopy.valueDefOriginId &&
                storeCopy.valueDefConsumeOpIndexPlusOne ==
                    managedTargetDropOpIndex + 1 &&
                storeCopy.consumeActionRow ==
                    managedTargetDropCall.consumeActionRow &&
                managedTargetDrop.sourceValueDefOpId ==
                    storeCopyOpIndex &&
                managedTargetDropCall.sourceValueDefOpId ==
                    storeCopyOpIndex &&
                managedTargetDropCall.consumeActionRow >= 0,
                "cleanup cfg smoke: managed move carrier drift")
    var accessTable = bodyaccess.BodyIrAccessDecode(body)
    smokeAssert(accessTable.valid,
                "cleanup cfg smoke: managed move carrier rejected")
    body.ops[managedTargetDropOpIndex].sourceValueDefOpId = -1
    body.callSequence[
        managedTargetDropCallOrdinal].sourceValueDefOpId = -1
    accessTable = bodyaccess.BodyIrAccessDecode(body)
    smokeAssert(!accessTable.valid &&
                accessTable.errorCode ==
                    bodyaccess.BodyIrAccessOwnershipInvariantErrorCode(),
                "cleanup cfg smoke: managed move carrier deletion accepted")
    body.ops[managedTargetDropOpIndex].sourceValueDefOpId =
        storeCopyOpIndex
    body.callSequence[
        managedTargetDropCallOrdinal].sourceValueDefOpId =
            storeCopyOpIndex
    body.ops[managedTargetDropOpIndex].sourceValueDefOpId =
        consumedSourceValueDefOpId
    body.callSequence[
        managedTargetDropCallOrdinal].sourceValueDefOpId =
            consumedSourceValueDefOpId
    accessTable = bodyaccess.BodyIrAccessDecode(body)
    smokeAssert(!accessTable.valid &&
                accessTable.errorCode ==
                    bodyaccess.BodyIrAccessOwnershipInvariantErrorCode(),
                "cleanup cfg smoke: managed move carrier swap accepted")
    body.ops[managedTargetDropOpIndex].sourceValueDefOpId =
        storeCopyOpIndex
    body.callSequence[
        managedTargetDropCallOrdinal].sourceValueDefOpId =
            storeCopyOpIndex
    let oldTargetDropCallOrdinal =
        body.ops[oldTargetDropOpIndex].operands[0]
    body.ops[oldTargetDropOpIndex].sourceValueDefOpId =
        storeCopyOpIndex
    body.callSequence[
        oldTargetDropCallOrdinal].sourceValueDefOpId =
            storeCopyOpIndex
    body.callSequence[
        oldTargetDropCallOrdinal].consumeActionRow =
            managedTargetDropCall.consumeActionRow
    accessTable = bodyaccess.BodyIrAccessDecode(body)
    smokeAssert(!accessTable.valid &&
                accessTable.errorCode ==
                    bodyaccess.BodyIrAccessOwnershipInvariantErrorCode(),
                "cleanup cfg smoke: managed move carrier duplicate accepted")
    body.ops[oldTargetDropOpIndex].sourceValueDefOpId = -1
    body.callSequence[
        oldTargetDropCallOrdinal].sourceValueDefOpId = -1
    body.callSequence[
        oldTargetDropCallOrdinal].consumeActionRow = -1
    accessTable = bodyaccess.BodyIrAccessDecode(body)
    smokeAssert(accessTable.valid,
                "cleanup cfg smoke: managed move carrier restore rejected")
    var locals = zeroLocals(body)
    var log: str[]
    var ledger: OwnershipResourceLedger
    ledger.allocCount = 2
    ledger.liveOwnerCount = 2
    fixtureArenaWriteI32(body, locals, sourceInput, 17)
    fixtureArenaWriteI32(body, locals, targetInput, 23)
    let _ = runBodyWithLedger(body, 0, locals, log, true, ledger)
    let sourceFlag = ownershipFlagSlot(ownershipAnalysis,
                                       ownershipFlagSlots,
                                       odir.ConditionFlagPlaceInitialized,
                                       sourcePlace,
                                       -1)
    let targetFlag = ownershipFlagSlot(ownershipAnalysis,
                                       ownershipFlagSlots,
                                       odir.ConditionFlagPlaceInitialized,
                                       targetPlace,
                                       -1)
    smokeAssert(log.len == 2 &&
                log[0] == "op_move_target_drop" &&
                log[1] == "op_move_target_drop" &&
                fixtureArenaReadI32(body, locals, target) == 0 &&
                fixtureArenaReadI32(body, locals, sourceFlag) == 0 &&
                fixtureArenaReadI32(body, locals, targetFlag) == 0 &&
                ledger.freeCount == 2 &&
                ledger.liveOwnerCount == 0 &&
                ledger.sourceDropCount == 2 &&
                report.ownershipOpActionCount == 2 &&
                report.ownershipOpTransitionSiteCount == 3,
                "cleanup cfg smoke: op action executable lifecycle")

fn runCapturedPartialFieldRetainedLifecycle() =
    var ownershipIr: odir.OwnershipDropIr
    odir.OwnershipDropIrInit(ownershipIr)
    let root = odir.OwnershipDropRootScopeId(ownershipIr)
    let capturedScope = odir.OwnershipDropAddScope(ownershipIr, root)
    let leafType = odir.OwnershipDropRegisterLeafType(
        ownershipIr,
        "CapturedPartialLeaf",
        851)
    var innerFields: int32[]
    add(innerFields, leafType)
    add(innerFields, leafType)
    let innerType = odir.OwnershipDropRegisterAggregateType(
        ownershipIr,
        "CapturedPartialInner",
        852,
        innerFields)
    var aggregateFields: int32[]
    add(aggregateFields, leafType)
    add(aggregateFields, leafType)
    add(aggregateFields, leafType)
    let aggregateType = odir.OwnershipDropRegisterAggregateType(
        ownershipIr,
        "CapturedPartialAggregate",
        853,
        aggregateFields)
    let sourcePlace = odir.OwnershipDropAddPlace(
        ownershipIr, aggregateType, odir.Owned, capturedScope)
    let targetPlace = odir.OwnershipDropAddPlace(
        ownershipIr, aggregateType, odir.Owned, capturedScope)
    let entry = odir.OwnershipDropAddBlock(ownershipIr, capturedScope)
    odir.OwnershipDropSetEntryBlock(ownershipIr, entry)
    let initializeSource = odir.OwnershipDropAppendInitialize(
        ownershipIr, entry, sourcePlace)
    odir.OwnershipDropBindOpDefinitionAuthority(
        ownershipIr,
        initializeSource,
        odir.DefinitionOriginTypedExpr,
        9500,
        0,
        odir.Owned)
    let initializeTargetField =
        odir.OwnershipDropAppendInitializeField(
            ownershipIr, entry, targetPlace, 0)
    odir.OwnershipDropBindOpDefinitionAuthority(
        ownershipIr,
        initializeTargetField,
        odir.DefinitionOriginTypedExpr,
        9502,
        1,
        odir.Owned)
    let retainedOp = odir.OwnershipDropAppendRetainedAssign(
        ownershipIr, entry, targetPlace, sourcePlace)
    odir.OwnershipDropBindOpDefinitionAuthority(
        ownershipIr,
        retainedOp,
        odir.DefinitionOriginTypedExpr,
        9501,
        0,
        odir.Owned)
    let exitBlock = odir.OwnershipDropAddBlock(ownershipIr, root)
    var cleanupIds: int32[]
    add(cleanupIds, sourcePlace)
    add(cleanupIds, targetPlace)
    var deferIds: int32[]
    let ownershipEdge = odir.OwnershipDropAddEdge(
        ownershipIr,
        entry,
        exitBlock,
        odir.OwnershipDropEdgeNormal,
        -1,
        cleanupIds,
        deferIds)
    var ownershipAnalysis: odir.OwnershipDropAnalysis
    odir.OwnershipDropAnalyze(ownershipIr, ownershipAnalysis)
    smokeAssert(odir.OwnershipDropAnalysisOpActionCount(
                    ownershipAnalysis, retainedOp) == 3 &&
                odir.OwnershipDropAnalysisOpAction(
                    ownershipAnalysis, retainedOp, 2).kind ==
                    odir.CleanupActionDropField,
                "cleanup cfg smoke: captured partial action shape")

    var body = coreir.BodyIRNew()
    let sourceSeed = addManagedSlot(
        body, "captured_partial_source_seed", coreir.LocalAggregateTag, 72)
    let targetSeed = addManagedSlot(
        body, "captured_partial_target_seed", coreir.LocalAggregateTag, 72)
    let source = addManagedSlot(
        body, "captured_partial_source", coreir.LocalAggregateTag, 72)
    let target = addManagedSlot(
        body, "captured_partial_target", coreir.LocalAggregateTag, 72)
    let marker = addI32Slot(body, "captured_partial_marker")
    var ownershipFlagSlots = addOwnershipConditionFlagSlots(
        body, ownershipAnalysis)
    let sourceDefinitionOp = appendCopyOp(body, sourceSeed, source)
    bindTypedManagedDefinition(
        body, sourceDefinitionOp, source, 9500)
    let targetDefinitionOp = appendCopyOp(body, targetSeed, target)
    bindTypedManagedDefinition(
        body, targetDefinitionOp, target, 9502)
    let _ = appendConstOp(body, marker, 1)
    var branch: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(branch)
    branch.kind = coreir.BodyTermBrTag
    branch.trueBlock = 1
    let branchTerm = coreir.BodyIRAppendTerm(body, branch)
    let _ = coreir.BodyIRAppendBlock(body, 0, 3, branchTerm)
    let targetBlock = appendReturnBlock(body, -1)

    var plan: cleanup.CleanupPlan
    cleanup.CleanupPlanPrepare(plan, limits(), 0)
    bindNestedPartialThreeLeafTypeLayout(
        plan, leafType, innerType, aggregateType)
    cleanup.CleanupPlanBindLocalSchema(plan, body)
    bindOwnershipConditionFlagSlots(
        plan, ownershipAnalysis, ownershipFlagSlots)
    cleanup.CleanupPlanBindOwnershipPlace(
        plan, sourcePlace, source, aggregateType)
    cleanup.CleanupPlanBindOwnershipPlace(
        plan, targetPlace, target, aggregateType)
    let _ = cleanup.CleanupPlanBindOwnershipFieldProjection(
        plan, body, targetPlace, 0)
    cleanup.CleanupPlanBindOwnershipRetainGlue(
        plan, aggregateType, "captured_partial_retain")
    cleanup.CleanupPlanBindOwnershipDropGlue(
        plan, 851, leafType, "captured_partial_leaf_drop")
    cleanup.CleanupPlanBindOwnershipDropGlue(
        plan, 853, aggregateType, "captured_partial_owner_drop")
    cleanup.CleanupPlanBindOwnershipOpTransitions(
        plan, body, ownershipAnalysis, initializeSource, 0, 0)
    cleanup.CleanupPlanBindOwnershipOpTransitions(
        plan, body, ownershipAnalysis, initializeTargetField, 0, 1)
    cleanup.CleanupPlanBindOwnershipOpTransitions(
        plan, body, ownershipAnalysis, retainedOp, 0, 2)
    let retainedSite = plan.ownershipOpActionStarts.len - 1
    let retainedActionStart =
        plan.ownershipOpActionStarts[retainedSite]
    let retainActionRow = retainedActionStart
    let storeActionRow = retainedActionStart + 1
    let fieldDropActionRow = retainedActionStart + 2
    let rootScope = cleanup.CleanupPlanRootScopeId(plan)
    let capturedPlanScope = cleanup.CleanupPlanAddScope(plan, rootScope)
    smokeAssert(capturedPlanScope == capturedScope,
                "cleanup cfg smoke: captured partial scope identity")
    let _ = cleanup.CleanupPlanQueueOwnershipExit(
        plan,
        0,
        0,
        capturedPlanScope,
        rootScope,
        odir.OwnershipDropEdgeNormal,
        targetBlock,
        -1,
        -1,
        ownershipIr,
        ownershipAnalysis,
        ownershipEdge)
    let report = cleanup.CleanupPlanMaterialize(body, plan)
    var capturedDefinitionOpId = -1
    var retainedDefinitionOpId = -1
    var fieldDefinitionOpId = -1
    var fieldReleaseOpId = -1
    var fieldReleaseCallOrdinal = -1
    for opIndex in 0..<body.ops.len:
        let op = body.ops[opIndex]
        if op.valueDefOriginKind ==
               coreir.BodyDefinitionOriginCanonicalCleanupActionTag:
            if op.valueDefOriginId == storeActionRow &&
               op.valueDefSlot != target:
                capturedDefinitionOpId = opIndex
            elif op.valueDefOriginId == retainActionRow &&
                 op.valueDefSlot == target:
                retainedDefinitionOpId = opIndex
            elif op.valueDefOriginId == fieldDropActionRow:
                fieldDefinitionOpId = opIndex
        if op.kind == coreir.BodyOpCallTag &&
           op.operands.len == 1:
            let callOrdinal = op.operands[0]
            if body.callSequence[callOrdinal].targetSymbol ==
                   "captured_partial_leaf_drop":
                fieldReleaseOpId = opIndex
                fieldReleaseCallOrdinal = callOrdinal
    smokeAssert(capturedDefinitionOpId >= 0 &&
                retainedDefinitionOpId >= 0 &&
                fieldDefinitionOpId >= 0 &&
                fieldReleaseOpId >= 0 &&
                fieldReleaseCallOrdinal >= 0 &&
                body.ops[fieldDefinitionOpId].sourceValueDefOpId ==
                    capturedDefinitionOpId &&
                body.ops[fieldDefinitionOpId].valueDefConsumeOpIndexPlusOne ==
                    fieldReleaseOpId + 1 &&
                body.ops[fieldDefinitionOpId].consumeActionRow ==
                    fieldDropActionRow &&
                body.ops[fieldReleaseOpId].sourceValueDefOpId ==
                    fieldDefinitionOpId &&
                body.callSequence[fieldReleaseCallOrdinal].sourceValueDefOpId ==
                    fieldDefinitionOpId,
                "cleanup cfg smoke: captured field definition chain drift")
    var accessTable = bodyaccess.BodyIrAccessDecode(body)
    smokeAssert(accessTable.valid,
                "cleanup cfg smoke: captured field authority rejected")

    let originalFieldSource =
        body.ops[fieldDefinitionOpId].sourceValueDefOpId
    body.ops[fieldDefinitionOpId].sourceValueDefOpId = -1
    accessTable = bodyaccess.BodyIrAccessDecode(body)
    smokeAssert(!accessTable.valid,
                "cleanup cfg smoke: captured field deletion accepted")
    body.ops[fieldDefinitionOpId].sourceValueDefOpId =
        originalFieldSource

    body.ops[fieldReleaseOpId].sourceValueDefOpId =
        capturedDefinitionOpId
    body.callSequence[fieldReleaseCallOrdinal].sourceValueDefOpId =
        capturedDefinitionOpId
    accessTable = bodyaccess.BodyIrAccessDecode(body)
    smokeAssert(!accessTable.valid,
                "cleanup cfg smoke: captured field swap accepted")
    body.ops[fieldReleaseOpId].sourceValueDefOpId =
        fieldDefinitionOpId
    body.callSequence[fieldReleaseCallOrdinal].sourceValueDefOpId =
        fieldDefinitionOpId

    var duplicateOpId = -1
    var duplicateCallOrdinal = -1
    for opIndex in 0..<body.ops.len:
        let op = body.ops[opIndex]
        if duplicateOpId < 0 &&
           op.kind == coreir.BodyOpCallTag &&
           opIndex != fieldReleaseOpId &&
           op.operands.len == 1:
            duplicateOpId = opIndex
            duplicateCallOrdinal = op.operands[0]
    smokeAssert(duplicateOpId >= 0 && duplicateCallOrdinal >= 0,
                "cleanup cfg smoke: captured field duplicate carrier missing")
    let duplicateOpSource =
        body.ops[duplicateOpId].sourceValueDefOpId
    let duplicateOpAction =
        body.ops[duplicateOpId].consumeActionRow
    let duplicateCallSource =
        body.callSequence[duplicateCallOrdinal].sourceValueDefOpId
    let duplicateCallAction =
        body.callSequence[duplicateCallOrdinal].consumeActionRow
    body.ops[duplicateOpId].sourceValueDefOpId =
        fieldDefinitionOpId
    body.ops[duplicateOpId].consumeActionRow =
        fieldDropActionRow
    body.callSequence[duplicateCallOrdinal].sourceValueDefOpId =
        fieldDefinitionOpId
    body.callSequence[duplicateCallOrdinal].consumeActionRow =
        fieldDropActionRow
    accessTable = bodyaccess.BodyIrAccessDecode(body)
    smokeAssert(!accessTable.valid,
                "cleanup cfg smoke: captured field duplicate accepted")
    body.ops[duplicateOpId].sourceValueDefOpId =
        duplicateOpSource
    body.ops[duplicateOpId].consumeActionRow =
        duplicateOpAction
    body.callSequence[duplicateCallOrdinal].sourceValueDefOpId =
        duplicateCallSource
    body.callSequence[duplicateCallOrdinal].consumeActionRow =
        duplicateCallAction

    let parentConsumeOp =
        body.ops[capturedDefinitionOpId].valueDefConsumeOpIndexPlusOne
    let parentConsumeAction =
        body.ops[capturedDefinitionOpId].consumeActionRow
    body.ops[capturedDefinitionOpId].valueDefConsumeOpIndexPlusOne =
        fieldReleaseOpId + 1
    body.ops[capturedDefinitionOpId].consumeActionRow =
        fieldDropActionRow
    accessTable = bodyaccess.BodyIrAccessDecode(body)
    smokeAssert(!accessTable.valid,
                "cleanup cfg smoke: captured field reorder accepted")
    body.ops[capturedDefinitionOpId].valueDefConsumeOpIndexPlusOne =
        parentConsumeOp
    body.ops[capturedDefinitionOpId].consumeActionRow =
        parentConsumeAction
    accessTable = bodyaccess.BodyIrAccessDecode(body)
    smokeAssert(accessTable.valid,
                "cleanup cfg smoke: captured field restore rejected")

    var locals = zeroLocals(body)
    fixtureArenaWriteI32At(body, locals, sourceSeed, 0, 31)
    fixtureArenaWriteI32At(body, locals, sourceSeed, 24, 32)
    fixtureArenaWriteI32At(body, locals, sourceSeed, 48, 33)
    fixtureArenaWriteI32At(body, locals, targetSeed, 0, 41)
    var log: str[]
    var ledger: OwnershipResourceLedger
    ledger.allocCount = 7
    ledger.liveOwnerCount = 4
    let _ = runBodyWithLedger(
        body, 0, locals, log, true, ledger)
    smokeAssert(log.len == 4 &&
                log[0] == "captured_partial_retain" &&
                log[1] == "captured_partial_leaf_drop" &&
                log[2] == "captured_partial_owner_drop" &&
                log[3] == "captured_partial_owner_drop" &&
                ledger.fieldDropCount == 1 &&
                ledger.retainCount == 3 &&
                ledger.allocCount == ledger.freeCount &&
                ledger.liveOwnerCount == 0 &&
                report.ownershipOpActionCount == 3,
                "cleanup cfg smoke: captured partial ledger not closed")

fn runRetainedAssignLifecycle() =
    var ownershipIr: odir.OwnershipDropIr
    odir.OwnershipDropIrInit(ownershipIr)
    let root = odir.OwnershipDropRootScopeId(ownershipIr)
    let retainedScope = odir.OwnershipDropAddScope(ownershipIr, root)
    let valueType = odir.OwnershipDropRegisterLeafType(ownershipIr,
                                                       "RetainedAssignValue",
                                                       821)
    let sourcePlace = odir.OwnershipDropAddPlace(ownershipIr,
                                                 valueType,
                                                 odir.Owned,
                                                 retainedScope)
    let targetPlace = odir.OwnershipDropAddPlace(ownershipIr,
                                                 valueType,
                                                 odir.Owned,
                                                 retainedScope)
    let entry = odir.OwnershipDropAddBlock(ownershipIr, retainedScope)
    odir.OwnershipDropSetEntryBlock(ownershipIr, entry)
    let initializeSource = odir.OwnershipDropAppendInitialize(
        ownershipIr,
        entry,
        sourcePlace)
    let initializedPath = odir.OwnershipDropAddBlock(ownershipIr,
                                                      retainedScope)
    let initializeTarget = odir.OwnershipDropAppendInitialize(
        ownershipIr,
        initializedPath,
        targetPlace)
    let uninitializedPath = odir.OwnershipDropAddBlock(ownershipIr,
                                                        retainedScope)
    let retainedBlock = odir.OwnershipDropAddBlock(ownershipIr,
                                                    retainedScope)
    let retainedAssign = odir.OwnershipDropAppendRetainedAssign(
        ownershipIr,
        retainedBlock,
        targetPlace,
        sourcePlace)
    odir.OwnershipDropBindOpDefinitionAuthority(
        ownershipIr,
        retainedAssign,
        odir.DefinitionOriginTypedExpr,
        9201,
        0,
        odir.Owned)
    let ownershipExit = odir.OwnershipDropAddBlock(ownershipIr, root)
    let _ = addOwnershipSameScopeEdge(ownershipIr, entry, initializedPath)
    let _ = addOwnershipSameScopeEdge(ownershipIr, entry, uninitializedPath)
    let _ = addOwnershipSameScopeEdge(ownershipIr,
                                      initializedPath,
                                      retainedBlock)
    let _ = addOwnershipSameScopeEdge(ownershipIr,
                                      uninitializedPath,
                                      retainedBlock)
    var cleanupIds: int32[]
    add(cleanupIds, sourcePlace)
    add(cleanupIds, targetPlace)
    var deferIds: int32[]
    let _ = odir.OwnershipDropAddEdge(ownershipIr,
                                      retainedBlock,
                                      ownershipExit,
                                      odir.OwnershipDropEdgeNormal,
                                      -1,
                                      cleanupIds,
                                      deferIds)
    var ownershipAnalysis: odir.OwnershipDropAnalysis
    odir.OwnershipDropAnalyze(ownershipIr, ownershipAnalysis)
    let retainedActionCount = odir.OwnershipDropAnalysisOpActionCount(
        ownershipAnalysis,
        retainedAssign)
    smokeAssert(retainedActionCount == 3 &&
                odir.OwnershipDropAnalysisOpAction(ownershipAnalysis,
                                                    retainedAssign,
                                                    0).kind ==
                    odir.CleanupActionRetainValue &&
                odir.OwnershipDropAnalysisOpAction(ownershipAnalysis,
                                                    retainedAssign,
                                                    1).kind ==
                    odir.CleanupActionStoreOwned &&
                odir.OwnershipDropAnalysisOpAction(ownershipAnalysis,
                                                    retainedAssign,
                                                    2).actionId ==
                    retainedAssign + 1 &&
                odir.OwnershipDropAnalysisOpAction(ownershipAnalysis,
                                                    retainedAssign,
                                                    2).conditionKind ==
                    odir.DropConditionCapturedOldPlace,
                "cleanup cfg smoke: retained assign captured-old contract")
    var body = coreir.BodyIRNew()
    let selector = addI32Slot(body, "retained_assign_selector")
    let source = addStrSlot(body, "retained_assign_source")
    let target = addStrSlot(body, "retained_assign_target")
    let marker = addI32Slot(body, "retained_assign_marker")
    var ownershipFlagSlots = addOwnershipConditionFlagSlots(body,
                                                             ownershipAnalysis)
    let sourceDefinitionOp = appendConstOp(body, source, 31)
    body.ops[sourceDefinitionOp].valueDefSlot = source
    body.ops[sourceDefinitionOp].valueDefExprNodeIndex = 9201
    body.ops[sourceDefinitionOp].valueDefOwnership = coreir.OwnMove
    body.ops[sourceDefinitionOp].valueDefOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    body.ops[sourceDefinitionOp].valueDefOriginId = 9201
    let targetDefinitionOp = appendConstOp(body, target, 41)
    body.ops[targetDefinitionOp].valueDefSlot = target
    body.ops[targetDefinitionOp].valueDefExprNodeIndex = 9202
    body.ops[targetDefinitionOp].valueDefOwnership = coreir.OwnMove
    body.ops[targetDefinitionOp].valueDefOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    body.ops[targetDefinitionOp].valueDefOriginId = 9202
    let _ = appendConstOp(body, marker, 1)
    var entryTerm: coreir.BodyTerm
    entryTerm.kind = coreir.BodyTermCbrTag
    entryTerm.conditionKind = coreir.BodyCondLocalNonZeroTag
    entryTerm.lhsSlot = selector
    entryTerm.trueBlock = 1
    entryTerm.falseBlock = 2
    add(entryTerm.operands, selector)
    let entryTermIndex = coreir.BodyIRAppendTerm(body, entryTerm)
    let _ = coreir.BodyIRAppendBlock(body, 0, 1, entryTermIndex)
    var initializedTerm: coreir.BodyTerm
    initializedTerm.kind = coreir.BodyTermBrTag
    initializedTerm.trueBlock = 3
    let initializedTermIndex = coreir.BodyIRAppendTerm(body,
                                                       initializedTerm)
    let _ = coreir.BodyIRAppendBlock(body, 1, 1, initializedTermIndex)
    var uninitializedTerm: coreir.BodyTerm
    uninitializedTerm.kind = coreir.BodyTermBrTag
    uninitializedTerm.trueBlock = 3
    let uninitializedTermIndex = coreir.BodyIRAppendTerm(body,
                                                         uninitializedTerm)
    let _ = coreir.BodyIRAppendBlock(body, 2, 0, uninitializedTermIndex)
    var retainedTerm: coreir.BodyTerm
    retainedTerm.kind = coreir.BodyTermBrTag
    retainedTerm.trueBlock = 4
    let retainedTermIndex = coreir.BodyIRAppendTerm(body, retainedTerm)
    let _ = coreir.BodyIRAppendBlock(body, 2, 1, retainedTermIndex)
    let targetBlock = appendReturnBlock(body, -1)
    var plan: cleanup.CleanupPlan
    cleanup.CleanupPlanPrepare(plan, limits(), 0)
    bindSingleLeafTypeLayout(plan, valueType)
    cleanup.CleanupPlanBindLocalSchema(plan, body)
    bindOwnershipConditionFlagSlots(plan,
                                    ownershipAnalysis,
                                    ownershipFlagSlots)
    cleanup.CleanupPlanBindOwnershipPlace(plan,
                                          sourcePlace,
                                          source,
                                          valueType)
    cleanup.CleanupPlanBindOwnershipPlace(plan,
                                          targetPlace,
                                          target,
                                          valueType)
    cleanup.CleanupPlanBindOwnershipRetainGlue(plan,
                                               valueType,
                                               "retained_assign_retain")
    cleanup.CleanupPlanBindOwnershipDropGlue(plan,
                                             821,
                                             valueType,
                                             "retained_assign_drop")
    cleanup.CleanupPlanBindOwnershipOpTransitions(plan,
                                                   body,
                                                   ownershipAnalysis,
                                                   initializeSource,
                                                   0,
                                                   0)
    cleanup.CleanupPlanBindOwnershipOpTransitions(plan,
                                                   body,
                                                   ownershipAnalysis,
                                                   initializeTarget,
                                                   1,
                                                   0)
    smokeAssert(cleanup.CleanupPlanPreflightOwnershipOpSite(
                    plan,
                    body,
                    ownershipAnalysis,
                    retainedAssign,
                    3,
                    0),
                "cleanup cfg smoke: retained assign preflight rejected")
    cleanup.CleanupPlanBindOwnershipOpTransitions(plan,
                                                   body,
                                                   ownershipAnalysis,
                                                   retainedAssign,
                                                   3,
                                                   0)
    let retainedPlanSite =
        plan.ownershipOpActionStarts.len - 1
    let retainedPlanActionStart =
        plan.ownershipOpActionStarts[retainedPlanSite]
    let retainedStoreActionRow = retainedPlanActionStart + 1
    let retainedDropActionRow = retainedPlanActionStart + 2
    let retainedPlanActionCount =
        plan.ownershipOpActionCounts[retainedPlanSite]
    let retainedStoreDefinition =
        plan.ownershipActionCapturedOldSourceValueDefOpIds[
            retainedStoreActionRow]
    let retainedDropDefinition =
        plan.ownershipActionCapturedOldSourceValueDefOpIds[
            retainedDropActionRow]
    smokeAssert(retainedPlanActionCount == 3 &&
                retainedStoreDefinition == targetDefinitionOp &&
                retainedDropDefinition == targetDefinitionOp,
        "cleanup cfg smoke: partial-init captured-old carrier drift")
    let rootScope = cleanup.CleanupPlanRootScopeId(plan)
    let _ = cleanup.CleanupPlanQueueUnmanagedExit(
        plan,
        3,
        0,
        rootScope,
        rootScope,
        odir.OwnershipDropEdgeNormal,
        targetBlock)
    let report = cleanup.CleanupPlanMaterialize(body, plan)
    var capturedSlot = -1
    for localIndex in 0..<body.localSlots.len:
        if body.localSlots[localIndex].name ==
           Fmt"#cleanup_captured_old#{retainedAssign + 1}":
            capturedSlot = localIndex
    smokeAssert(capturedSlot >= 0,
                "cleanup cfg smoke: retained captured-old slot missing")
    assertCapturedOldDefinitionChain(body,
                                     9202,
                                     capturedSlot,
                                     retainedStoreActionRow,
                                     retainedDropActionRow)
    let sourceFlag = ownershipFlagSlot(ownershipAnalysis,
                                       ownershipFlagSlots,
                                       odir.ConditionFlagPlaceInitialized,
                                       sourcePlace,
                                       -1)
    let targetFlag = ownershipFlagSlot(ownershipAnalysis,
                                       ownershipFlagSlots,
                                       odir.ConditionFlagPlaceInitialized,
                                       targetPlace,
                                       -1)
    var initializedLocals = zeroLocals(body)
    fixtureArenaWriteI32(body, initializedLocals, selector, 1)
    var initializedLog: str[]
    var initializedLedger: OwnershipResourceLedger
    initializedLedger.allocCount = 2
    initializedLedger.liveOwnerCount = 2
    let _ = runBodyWithLedger(body,
                              0,
                              initializedLocals,
                              initializedLog,
                              true,
                              initializedLedger)
    smokeAssert(initializedLog.len == 2 &&
                initializedLog[0] == "retained_assign_retain" &&
                initializedLog[1] == "retained_assign_drop" &&
                fixtureArenaReadI32(body, initializedLocals, source) == 31 &&
                fixtureArenaReadI32(body, initializedLocals, target) == 31 &&
                fixtureArenaReadI32(body,
                                    initializedLocals,
                                    capturedSlot) == 0 &&
                fixtureArenaReadI32(body,
                                    initializedLocals,
                                    sourceFlag) == 1 &&
                fixtureArenaReadI32(body,
                                    initializedLocals,
                                    targetFlag) == 1 &&
                initializedLedger.retainCount == 1 &&
                initializedLedger.releaseCount == 1 &&
                initializedLedger.freeCount == 1 &&
                initializedLedger.liveOwnerCount == 2,
                "cleanup cfg smoke: initialized retained lifecycle")
    var emptyLocals = zeroLocals(body)
    fixtureArenaWriteI32(body, emptyLocals, selector, 0)
    var emptyLog: str[]
    var emptyLedger: OwnershipResourceLedger
    emptyLedger.allocCount = 1
    emptyLedger.liveOwnerCount = 1
    let _ = runBodyWithLedger(body,
                              0,
                              emptyLocals,
                              emptyLog,
                              true,
                              emptyLedger)
    smokeAssert(emptyLog.len == 1 &&
                emptyLog[0] == "retained_assign_retain" &&
                fixtureArenaReadI32(body, emptyLocals, source) == 31 &&
                fixtureArenaReadI32(body, emptyLocals, target) == 31 &&
                fixtureArenaReadI32(body, emptyLocals, capturedSlot) == 0 &&
                fixtureArenaReadI32(body, emptyLocals, sourceFlag) == 1 &&
                fixtureArenaReadI32(body, emptyLocals, targetFlag) == 1 &&
                emptyLedger.retainCount == 1 &&
                emptyLedger.releaseCount == 0 &&
                emptyLedger.freeCount == 0 &&
                emptyLedger.liveOwnerCount == 2 &&
                report.ownershipOpActionCount == 3 &&
                report.ownershipOpTransitionSiteCount == 3,
                "cleanup cfg smoke: uninitialized retained lifecycle")

fn runCapturedOldReachingDefinitionFailure(mutationKind: int32) =
    if mutationKind < 1 || mutationKind > 4:
        panic("cleanup cfg smoke: captured-old mutation kind")
    var ownershipIr: odir.OwnershipDropIr
    odir.OwnershipDropIrInit(ownershipIr)
    let root = odir.OwnershipDropRootScopeId(ownershipIr)
    let scopeId = odir.OwnershipDropAddScope(ownershipIr, root)
    let valueType = odir.OwnershipDropRegisterLeafType(
        ownershipIr,
        "CapturedOldMutationValue",
        841)
    let sourcePlace = odir.OwnershipDropAddPlace(
        ownershipIr,
        valueType,
        odir.Owned,
        scopeId)
    let targetPlace = odir.OwnershipDropAddPlace(
        ownershipIr,
        valueType,
        odir.Owned,
        scopeId)
    let ownershipEntry = odir.OwnershipDropAddBlock(ownershipIr, scopeId)
    odir.OwnershipDropSetEntryBlock(ownershipIr, ownershipEntry)
    let _ = odir.OwnershipDropAppendInitialize(
        ownershipIr,
        ownershipEntry,
        sourcePlace)
    let _ = odir.OwnershipDropAppendInitialize(
        ownershipIr,
        ownershipEntry,
        targetPlace)
    let retainedOp = odir.OwnershipDropAppendRetainedAssign(
        ownershipIr,
        ownershipEntry,
        targetPlace,
        sourcePlace)
    odir.OwnershipDropBindOpDefinitionAuthority(
        ownershipIr,
        retainedOp,
        odir.DefinitionOriginTypedExpr,
        9401,
        0,
        odir.Owned)
    let ownershipExit = odir.OwnershipDropAddBlock(ownershipIr, root)
    var cleanupIds: int32[]
    add(cleanupIds, sourcePlace)
    add(cleanupIds, targetPlace)
    var deferIds: int32[]
    let _ = odir.OwnershipDropAddEdge(
        ownershipIr,
        ownershipEntry,
        ownershipExit,
        odir.OwnershipDropEdgeNormal,
        -1,
        cleanupIds,
        deferIds)
    var ownershipAnalysis: odir.OwnershipDropAnalysis
    odir.OwnershipDropAnalyze(ownershipIr, ownershipAnalysis)

    var body = coreir.BodyIRNew()
    let selector = addI32Slot(body, "captured_old_mutation_selector")
    let source = addStrSlot(body, "captured_old_mutation_source")
    let target = addStrSlot(body, "captured_old_mutation_target")
    let marker = addI32Slot(body, "captured_old_mutation_marker")
    var ownershipFlagSlots = addOwnershipConditionFlagSlots(
        body,
        ownershipAnalysis)
    let sourceDefinitionOp = appendConstOp(body, source, 51)
    bindTypedManagedDefinition(body, sourceDefinitionOp, source, 9401)
    var siteBlockId: int32
    var siteOpOrdinal: int32
    if mutationKind == 1:
        # Delete the only semantic definition carrier while leaving the raw
        # store bytes in place.  Slot/op order must not reconstruct identity.
        let _ = appendConstOp(body, target, 61)
        let _ = appendConstOp(body, marker, 1)
        var branch: coreir.BodyTerm
        branch.kind = coreir.BodyTermBrTag
        branch.trueBlock = 1
        let termIndex = coreir.BodyIRAppendTerm(body, branch)
        siteBlockId = coreir.BodyIRAppendBlock(body, 0, 3, termIndex)
        siteOpOrdinal = 2
        let _ = appendReturnBlock(body, -1)
    elif mutationKind == 2:
        # Replace the initialized incoming edge with an uninitialized edge.
        let targetDefinitionOp = appendConstOp(body, target, 61)
        bindTypedManagedDefinition(
            body, targetDefinitionOp, target, 9402)
        let _ = appendConstOp(body, marker, 1)
        var split: coreir.BodyTerm
        split.kind = coreir.BodyTermCbrTag
        split.conditionKind = coreir.BodyCondLocalNonZeroTag
        split.lhsSlot = selector
        split.trueBlock = 1
        split.falseBlock = 2
        add(split.operands, selector)
        let splitTerm = coreir.BodyIRAppendTerm(body, split)
        let _ = coreir.BodyIRAppendBlock(body, 0, 1, splitTerm)
        var initializedExit: coreir.BodyTerm
        initializedExit.kind = coreir.BodyTermBrTag
        initializedExit.trueBlock = 3
        let initializedExitTerm =
            coreir.BodyIRAppendTerm(body, initializedExit)
        let _ = coreir.BodyIRAppendBlock(
            body, 1, 1, initializedExitTerm)
        var uninitializedJoin: coreir.BodyTerm
        uninitializedJoin.kind = coreir.BodyTermBrTag
        uninitializedJoin.trueBlock = 3
        let uninitializedJoinTerm =
            coreir.BodyIRAppendTerm(body, uninitializedJoin)
        siteBlockId = coreir.BodyIRAppendBlock(
            body, 2, 1, uninitializedJoinTerm)
        siteOpOrdinal = 0
        let _ = appendReturnBlock(body, -1)
    elif mutationKind == 3:
        # Two distinct definition rows reach the same diamond join.
        let firstDefinitionOp = appendConstOp(body, target, 61)
        bindTypedManagedDefinition(
            body, firstDefinitionOp, target, 9402)
        let secondDefinitionOp = appendConstOp(body, target, 62)
        bindTypedManagedDefinition(
            body, secondDefinitionOp, target, 9403)
        let _ = appendConstOp(body, marker, 1)
        var split: coreir.BodyTerm
        split.kind = coreir.BodyTermCbrTag
        split.conditionKind = coreir.BodyCondLocalNonZeroTag
        split.lhsSlot = selector
        split.trueBlock = 1
        split.falseBlock = 2
        add(split.operands, selector)
        let splitTerm = coreir.BodyIRAppendTerm(body, split)
        let _ = coreir.BodyIRAppendBlock(body, 0, 1, splitTerm)
        var firstJoin: coreir.BodyTerm
        firstJoin.kind = coreir.BodyTermBrTag
        firstJoin.trueBlock = 3
        let firstJoinTerm = coreir.BodyIRAppendTerm(body, firstJoin)
        let _ = coreir.BodyIRAppendBlock(body, 1, 1, firstJoinTerm)
        var secondJoin: coreir.BodyTerm
        secondJoin.kind = coreir.BodyTermBrTag
        secondJoin.trueBlock = 3
        let secondJoinTerm = coreir.BodyIRAppendTerm(body, secondJoin)
        let _ = coreir.BodyIRAppendBlock(body, 2, 1, secondJoinTerm)
        var joinExit: coreir.BodyTerm
        joinExit.kind = coreir.BodyTermBrTag
        joinExit.trueBlock = 4
        let joinExitTerm = coreir.BodyIRAppendTerm(body, joinExit)
        siteBlockId = coreir.BodyIRAppendBlock(
            body, 3, 1, joinExitTerm)
        siteOpOrdinal = 0
        let _ = appendReturnBlock(body, -1)
    else:
        # A physical definition row in a cyclic block denotes a new runtime
        # instance on each iteration and cannot be a unique old value.
        let loopDefinitionOp = appendConstOp(body, target, 61)
        bindTypedManagedDefinition(
            body, loopDefinitionOp, target, 9402)
        let _ = appendConstOp(body, marker, 1)
        var enterLoop: coreir.BodyTerm
        enterLoop.kind = coreir.BodyTermBrTag
        enterLoop.trueBlock = 1
        let enterLoopTerm = coreir.BodyIRAppendTerm(body, enterLoop)
        let _ = coreir.BodyIRAppendBlock(body, 0, 1, enterLoopTerm)
        var loopBranch: coreir.BodyTerm
        loopBranch.kind = coreir.BodyTermCbrTag
        loopBranch.conditionKind = coreir.BodyCondLocalNonZeroTag
        loopBranch.lhsSlot = selector
        loopBranch.trueBlock = 1
        loopBranch.falseBlock = 2
        add(loopBranch.operands, selector)
        let loopBranchTerm = coreir.BodyIRAppendTerm(body, loopBranch)
        let _ = coreir.BodyIRAppendBlock(body, 1, 1, loopBranchTerm)
        var siteExit: coreir.BodyTerm
        siteExit.kind = coreir.BodyTermBrTag
        siteExit.trueBlock = 3
        let siteExitTerm = coreir.BodyIRAppendTerm(body, siteExit)
        siteBlockId = coreir.BodyIRAppendBlock(body, 2, 1, siteExitTerm)
        siteOpOrdinal = 0
        let _ = appendReturnBlock(body, -1)

    var plan: cleanup.CleanupPlan
    cleanup.CleanupPlanPrepare(plan, limits(), 0)
    bindSingleLeafTypeLayout(plan, valueType)
    cleanup.CleanupPlanBindLocalSchema(plan, body)
    bindOwnershipConditionFlagSlots(
        plan,
        ownershipAnalysis,
        ownershipFlagSlots)
    cleanup.CleanupPlanBindOwnershipPlace(
        plan,
        sourcePlace,
        source,
        valueType)
    cleanup.CleanupPlanBindOwnershipPlace(
        plan,
        targetPlace,
        target,
        valueType)
    cleanup.CleanupPlanBindOwnershipRetainGlue(
        plan,
        valueType,
        "captured_old_mutation_retain")
    cleanup.CleanupPlanBindOwnershipDropGlue(
        plan,
        841,
        valueType,
        "captured_old_mutation_drop")
    cleanup.CleanupPlanBindOwnershipOpTransitions(
        plan,
        body,
        ownershipAnalysis,
        retainedOp,
        siteBlockId,
        siteOpOrdinal)
    panic("cleanup cfg smoke: captured-old reaching mutation accepted")

fn runSameSlotRetainedAssignLifecycle() =
    var ownershipIr: odir.OwnershipDropIr
    odir.OwnershipDropIrInit(ownershipIr)
    let root = odir.OwnershipDropRootScopeId(ownershipIr)
    let retainedScope = odir.OwnershipDropAddScope(ownershipIr, root)
    let valueType = odir.OwnershipDropRegisterLeafType(
        ownershipIr,
        "SameSlotRetainedValue",
        831)
    let valuePlace = odir.OwnershipDropAddPlace(ownershipIr,
                                                valueType,
                                                odir.Owned,
                                                retainedScope)
    let entry = odir.OwnershipDropAddBlock(ownershipIr, retainedScope)
    odir.OwnershipDropSetEntryBlock(ownershipIr, entry)
    let initializeOp = odir.OwnershipDropAppendInitialize(ownershipIr,
                                                           entry,
                                                           valuePlace)
    let retainedOp = odir.OwnershipDropAppendRetainedAssign(ownershipIr,
                                                             entry,
                                                             valuePlace,
                                                             valuePlace)
    odir.OwnershipDropBindOpDefinitionAuthority(
        ownershipIr,
        retainedOp,
        odir.DefinitionOriginTypedExpr,
        9301,
        0,
        odir.Owned)
    let exitBlock = odir.OwnershipDropAddBlock(ownershipIr, root)
    var cleanupIds: int32[]
    add(cleanupIds, valuePlace)
    var deferIds: int32[]
    let ownershipEdge = odir.OwnershipDropAddEdge(
        ownershipIr,
        entry,
        exitBlock,
        odir.OwnershipDropEdgeNormal,
        -1,
        cleanupIds,
        deferIds)
    var ownershipAnalysis: odir.OwnershipDropAnalysis
    odir.OwnershipDropAnalyze(ownershipIr, ownershipAnalysis)
    smokeAssert(odir.OwnershipDropAnalysisOpActionCount(ownershipAnalysis,
                                                        retainedOp) == 3,
                "cleanup cfg smoke: same-slot retained action sequence")

    var body = coreir.BodyIRNew()
    let valueSeed = addStrSlot(body, "same_slot_retained_seed")
    let value = addStrSlot(body, "same_slot_retained_value")
    let marker = addI32Slot(body, "same_slot_retained_marker")
    var ownershipFlagSlots = addOwnershipConditionFlagSlots(body,
                                                             ownershipAnalysis)
    let valueDefinitionOp = appendCopyOp(body, valueSeed, value)
    body.ops[valueDefinitionOp].valueDefSlot = value
    body.ops[valueDefinitionOp].valueDefExprNodeIndex = 9301
    body.ops[valueDefinitionOp].valueDefOwnership = coreir.OwnMove
    body.ops[valueDefinitionOp].valueDefOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    body.ops[valueDefinitionOp].valueDefOriginId = 9301
    let _ = appendConstOp(body, marker, 1)
    var branch: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(branch)
    branch.kind = coreir.BodyTermBrTag
    branch.trueBlock = 1
    let branchTerm = coreir.BodyIRAppendTerm(body, branch)
    let _ = coreir.BodyIRAppendBlock(body, 0, 2, branchTerm)
    let targetBlock = appendReturnBlock(body, -1)

    var plan: cleanup.CleanupPlan
    cleanup.CleanupPlanPrepare(plan, limits(), 0)
    bindSingleLeafTypeLayout(plan, valueType)
    cleanup.CleanupPlanBindLocalSchema(plan, body)
    bindOwnershipConditionFlagSlots(plan,
                                    ownershipAnalysis,
                                    ownershipFlagSlots)
    cleanup.CleanupPlanBindOwnershipPlace(plan,
                                          valuePlace,
                                          value,
                                          valueType)
    cleanup.CleanupPlanBindOwnershipRetainGlue(plan,
                                               valueType,
                                               "same_slot_retained_retain")
    cleanup.CleanupPlanBindOwnershipDropGlue(plan,
                                             831,
                                             valueType,
                                             "same_slot_retained_drop")
    cleanup.CleanupPlanBindOwnershipOpTransitions(plan,
                                                   body,
                                                   ownershipAnalysis,
                                                   initializeOp,
                                                   0,
                                                   0)
    let retainedActionStart =
        ownershipAnalysis.opActionStarts[retainedOp]
    var retainedAction =
        ownershipAnalysis.cleanupActions[retainedActionStart]
    let originalSnapshotGlue = retainedAction.returnSnapshotGlueId
    retainedAction.returnSnapshotGlueId = 999
    ownershipAnalysis.cleanupActions[retainedActionStart] =
        retainedAction
    let bodyBeforeReject = bodyIrCanonicalFingerprint(body)
    let planBeforeReject = cleanup.CleanupPlanCanonicalFingerprint(plan)
    let rejected =
        !cleanup.CleanupPlanTryBindOwnershipOpTransitions(
                    plan,
                    body,
                    ownershipAnalysis,
                    retainedOp,
                    0,
                    1)
    retainedAction.returnSnapshotGlueId = originalSnapshotGlue
    ownershipAnalysis.cleanupActions[retainedActionStart] =
        retainedAction
    smokeAssert(rejected &&
                bodyIrCanonicalFingerprint(body) == bodyBeforeReject &&
                cleanup.CleanupPlanCanonicalFingerprint(plan) ==
                    planBeforeReject,
                "cleanup cfg smoke: rejected mutation changed BodyIR or plan")
    cleanup.CleanupPlanBindOwnershipOpTransitions(plan,
                                                   body,
                                                   ownershipAnalysis,
                                                   retainedOp,
                                                   0,
                                                   1)
    let retainedPlanSite =
        plan.ownershipOpActionStarts.len - 1
    let retainedPlanActionStart =
        plan.ownershipOpActionStarts[retainedPlanSite]
    let retainedStoreActionRow = retainedPlanActionStart + 1
    let retainedDropActionRow = retainedPlanActionStart + 2
    let retainedPlanActionCount =
        plan.ownershipOpActionCounts[retainedPlanSite]
    let retainedStoreDefinition =
        plan.ownershipActionCapturedOldSourceValueDefOpIds[
            retainedStoreActionRow]
    let retainedDropDefinition =
        plan.ownershipActionCapturedOldSourceValueDefOpIds[
            retainedDropActionRow]
    smokeAssert(retainedPlanActionCount == 3 &&
                retainedStoreDefinition == valueDefinitionOp &&
                retainedDropDefinition == valueDefinitionOp,
        "cleanup cfg smoke: same-slot captured-old carrier drift")
    let rootScope = cleanup.CleanupPlanRootScopeId(plan)
    let retainedPlanScope = cleanup.CleanupPlanAddScope(plan, rootScope)
    smokeAssert(retainedPlanScope == retainedScope,
                "cleanup cfg smoke: retained scope identity")
    let _ = cleanup.CleanupPlanQueueOwnershipExit(plan,
                                                   0,
                                                   0,
                                                   retainedPlanScope,
                                                   rootScope,
                                                   odir.OwnershipDropEdgeNormal,
                                                   targetBlock,
                                                   -1,
                                                   -1,
                                                   ownershipIr,
                                                   ownershipAnalysis,
                                                   ownershipEdge)
    let report = cleanup.CleanupPlanMaterialize(body, plan)
    var capturedSlot = -1
    for localIndex in 0..<body.localSlots.len:
        if body.localSlots[localIndex].name ==
           Fmt"#cleanup_captured_old#{retainedOp + 1}":
            capturedSlot = localIndex
    smokeAssert(capturedSlot >= 0,
                "cleanup cfg smoke: same-slot captured-old slot missing")
    assertCapturedOldDefinitionChain(body,
                                     9301,
                                     capturedSlot,
                                     retainedStoreActionRow,
                                     retainedDropActionRow)
    let accessTable = bodyaccess.BodyIrAccessDecode(body)
    smokeAssert(accessTable.valid,
                "cleanup cfg smoke: same-slot retained authority rejected")
    var locals = zeroLocals(body)
    fixtureArenaWriteI32(body, locals, valueSeed, 41)
    var log: str[]
    var ledger: OwnershipResourceLedger
    ledger.allocCount = 2
    ledger.liveOwnerCount = 1
    let _ = runBodyWithLedger(body,
                              0,
                              locals,
                              log,
                              true,
                              ledger)
    smokeAssert(log.len == 3 &&
                log[0] == "same_slot_retained_retain" &&
                log[1] == "same_slot_retained_drop" &&
                log[2] == "same_slot_retained_drop" &&
                fixtureArenaReadI32(body, locals, value) == 0 &&
                fixtureArenaReadI32(body, locals, capturedSlot) == 0 &&
                ledger.retainCount == 1 && ledger.releaseCount == 2 &&
                ledger.freeCount == 2 && ledger.liveOwnerCount == 0 &&
                report.ownershipOpActionCount == 3,
                "cleanup cfg smoke: same-slot retained lifecycle")

fn runOwnedLocalExitKind(kind: odir.OwnershipDropEdgeKind) =
    if kind != odir.OwnershipDropEdgeNormal &&
       kind != odir.OwnershipDropEdgeBreak &&
       kind != odir.OwnershipDropEdgeContinue:
        panic("cleanup cfg smoke: owned local exit kind")
    var ownershipIr: odir.OwnershipDropIr
    odir.OwnershipDropIrInit(ownershipIr)
    let ownershipRoot = odir.OwnershipDropRootScopeId(ownershipIr)
    let ownershipInner = odir.OwnershipDropAddScope(ownershipIr,
                                                    ownershipRoot)
    let valueType = odir.OwnershipDropRegisterLeafType(ownershipIr,
                                                       "OwnedExitValue",
                                                       731)
    let ownershipPlace = odir.OwnershipDropAddPlace(ownershipIr,
                                                    valueType,
                                                    odir.Owned,
                                                    ownershipInner)
    let ownershipSource = odir.OwnershipDropAddBlock(ownershipIr,
                                                      ownershipInner)
    odir.OwnershipDropSetEntryBlock(ownershipIr, ownershipSource)
    let initializeOp = odir.OwnershipDropAppendInitialize(ownershipIr,
                                                           ownershipSource,
                                                           ownershipPlace)
    odir.OwnershipDropBindOpDefinitionAuthority(
        ownershipIr,
        initializeOp,
        odir.DefinitionOriginTypedExpr,
        73101,
        0,
        odir.Owned)
    let ownershipTarget = odir.OwnershipDropAddBlock(ownershipIr,
                                                      ownershipRoot)
    var cleanupIds: int32[]
    add(cleanupIds, ownershipPlace)
    var deferIds: int32[]
    let ownershipEdge = odir.OwnershipDropAddEdge(ownershipIr,
                                                  ownershipSource,
                                                  ownershipTarget,
                                                  kind,
                                                  -1,
                                                  cleanupIds,
                                                  deferIds)
    var ownershipAnalysis: odir.OwnershipDropAnalysis
    odir.OwnershipDropAnalyze(ownershipIr, ownershipAnalysis)
    smokeAssert(odir.OwnershipDropAnalysisEdgeActionCount(ownershipAnalysis,
                                                          ownershipEdge) == 1 &&
                odir.OwnershipDropAnalysisEdgeAction(ownershipAnalysis,
                                                     ownershipEdge,
                                                     0).kind ==
                    odir.CleanupActionDropPlace,
                "cleanup cfg smoke: owned local edge action")

    var body = coreir.BodyIRNew()
    let input = addStrSlot(body, "owned_exit_input")
    let source = addStrSlot(body, "owned_exit_source")
    var ownershipFlagSlots = addOwnershipConditionFlagSlots(body,
                                                             ownershipAnalysis)
    var plan: cleanup.CleanupPlan
    cleanup.CleanupPlanPrepare(plan, limits(), 0)
    let cleanupRoot = cleanup.CleanupPlanRootScopeId(plan)
    let cleanupInner = cleanup.CleanupPlanAddScope(plan, cleanupRoot)
    smokeAssert(cleanupRoot == ownershipRoot &&
                cleanupInner == ownershipInner,
                "cleanup cfg smoke: owned local scope identity")
    bindSingleLeafTypeLayout(plan, valueType)
    cleanup.CleanupPlanBindLocalSchema(plan, body)
    bindOwnershipConditionFlagSlots(plan,
                                    ownershipAnalysis,
                                    ownershipFlagSlots)
    cleanup.CleanupPlanBindOwnershipPlace(plan,
                                          ownershipPlace,
                                          source,
                                          valueType)
    cleanup.CleanupPlanBindOwnershipDropGlue(plan,
                                             731,
                                             valueType,
                                             "owned_exit_source_drop")
    let sourceDefinitionOp = appendCopyOp(body, input, source)
    smokeAssert(sourceDefinitionOp == 0,
                "cleanup cfg smoke: owned exit definition row drift")
    bindTypedManagedDefinition(body,
                               sourceDefinitionOp,
                               source,
                               73101)
    var branch: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(branch)
    branch.kind = coreir.BodyTermBrTag
    branch.trueBlock = 1
    let branchTerm = coreir.BodyIRAppendTerm(body, branch)
    let _ = coreir.BodyIRAppendBlock(body, 0, 1, branchTerm)
    let targetBlock = appendReturnBlock(body, -1)
    smokeAssert(targetBlock == 1,
                "cleanup cfg smoke: owned local target block")
    cleanup.CleanupPlanBindOwnershipOpTransitions(plan,
                                                   body,
                                                   ownershipAnalysis,
                                                   initializeOp,
                                                   0,
                                                   0)
    let exitId = cleanup.CleanupPlanQueueOwnershipExit(plan,
                                                       0,
                                                       0,
                                                       cleanupInner,
                                                       cleanupRoot,
                                                       kind,
                                                       targetBlock,
                                                       -1,
                                                       -1,
                                                       ownershipIr,
                                                       ownershipAnalysis,
                                                       ownershipEdge)
    smokeAssert(cleanup.CleanupPlanExitKind(plan, exitId) == kind,
                "cleanup cfg smoke: owned local exit kind ledger")
    let report = cleanup.CleanupPlanMaterialize(body, plan)
    let accessTable = bodyaccess.BodyIrAccessDecode(body)
    var locals = zeroLocals(body)
    fixtureArenaWriteI32(body, locals, input, 42)
    var log: str[]
    var ledger: OwnershipResourceLedger
    ledger.allocCount = 1
    ledger.liveOwnerCount = 1
    let _ = runBodyWithLedger(body, 0, locals, log, true, ledger)
    let placeFlagSlot = ownershipFlagSlot(ownershipAnalysis,
                                          ownershipFlagSlots,
                                          odir.ConditionFlagPlaceInitialized,
                                          ownershipPlace,
                                          -1)
    smokeAssert(log.len == 1 && log[0] == "owned_exit_source_drop" &&
                fixtureArenaReadI32(body, locals, source) == 0 &&
                fixtureArenaReadI32(body, locals, placeFlagSlot) == 0 &&
                ledger.allocCount == ledger.freeCount &&
                ledger.liveOwnerCount == 0 &&
                ledger.sourceDropCount == 1 &&
                report.ownershipFlagTransitionCount == 2,
                "cleanup cfg smoke: owned local exit lifecycle")
    smokeAssert(accessTable.valid,
                Fmt"cleanup cfg smoke: owned local exit authority rejected code={accessTable.errorCode} site={accessTable.errorSiteKind}:{accessTable.errorSiteIndex} detail={accessTable.errorDetail}")

fn runOwnedLocalNormalBreakContinue() =
    runOwnedLocalExitKind(odir.OwnershipDropEdgeNormal)
    runOwnedLocalExitKind(odir.OwnershipDropEdgeBreak)
    runOwnedLocalExitKind(odir.OwnershipDropEdgeContinue)

fn runLoopReactivation() =
    var body = coreir.BodyIRNew()
    let flag = addI32Slot(body, "loop_flag")
    var plan: cleanup.CleanupPlan
    cleanup.CleanupPlanPrepare(plan, limits(), 0)
    cleanup.CleanupPlanBindLocalSchema(plan, body)
    var fragment = callFragment(body, "iteration_cleanup")
    let fragmentId = cleanup.CleanupPlanCaptureFragment(plan, fragment)
    let root = cleanup.CleanupPlanRootScopeId(plan)
    let loopScope = cleanup.CleanupPlanAddScope(plan, root)
    let bodyScope = cleanup.CleanupPlanAddScope(plan, loopScope)
    let suite = cleanup.CleanupPlanAddScope(plan, bodyScope)
    let deferId = cleanup.CleanupPlanRegisterDefer(plan, bodyScope, suite,
                                                   1, flag, fragmentId)
    var entryBr: coreir.BodyTerm
    entryBr.kind = coreir.BodyTermBrTag
    entryBr.trueBlock = 1
    let entryTerm = coreir.BodyIRAppendTerm(body, entryBr)
    let _ = coreir.BodyIRAppendBlock(body, 0, 0, entryTerm)
    let bodyStart = body.ops.len
    add(body.ops, cleanup.CleanupPlanActivationOp(plan, deferId))
    var loopBack: coreir.BodyTerm
    loopBack.kind = coreir.BodyTermBrTag
    loopBack.trueBlock = 2
    let loopTerm = coreir.BodyIRAppendTerm(body, loopBack)
    let bodyBlock = coreir.BodyIRAppendBlock(body, bodyStart, 1, loopTerm)
    let header = appendReturnBlock(body, -1)
    cleanup.CleanupPlanQueueUnmanagedExit(
        plan, bodyBlock, 0, bodyScope, loopScope,
        odir.OwnershipDropEdgeLoopBack, header)
    let _ = cleanup.CleanupPlanMaterialize(body, plan)
    var locals = zeroLocals(body)
    var firstLog: str[]
    let _ = runBody(body, 0, locals, firstLog)
    smokeAssert(firstLog.len == 1 && firstLog[0] == "iteration_cleanup" &&
                fixtureArenaReadI32(body, locals, flag) == 0,
                "cleanup cfg smoke: first loop cleanup did not clear flag")
    var secondLog: str[]
    let _ = runBody(body, bodyBlock, locals, secondLog)
    smokeAssert(secondLog.len == 1 && secondLog[0] == "iteration_cleanup" &&
                fixtureArenaReadI32(body, locals, flag) == 0,
                "cleanup cfg smoke: defer did not reactivate next iteration")

fn runDuplicateSourceEdgeFailure() =
    var body = coreir.BodyIRNew()
    let _ = addI32Slot(body, "value")
    var plan: cleanup.CleanupPlan
    cleanup.CleanupPlanPrepare(plan, limits(), 0)
    cleanup.CleanupPlanBindLocalSchema(plan, body)
    let root = cleanup.CleanupPlanRootScopeId(plan)
    cleanup.CleanupPlanQueueUnmanagedExit(
        plan, 0, 0, root, root, odir.OwnershipDropEdgeNormal, 1)
    cleanup.CleanupPlanQueueUnmanagedExit(
        plan, 0, 0, root, root, odir.OwnershipDropEdgeNormal, 1)
    panic("cleanup cfg smoke: duplicate source edge accepted")

fn runLexicalOrderFailure() =
    var body = coreir.BodyIRNew()
    let firstFlag = addI32Slot(body, "first_flag")
    let secondFlag = addI32Slot(body, "second_flag")
    var plan: cleanup.CleanupPlan
    cleanup.CleanupPlanPrepare(plan, limits(), 0)
    cleanup.CleanupPlanBindLocalSchema(plan, body)
    var fragment = callFragment(body, "cleanup")
    let fragmentId = cleanup.CleanupPlanCaptureFragment(plan, fragment)
    let root = cleanup.CleanupPlanRootScopeId(plan)
    let scope = cleanup.CleanupPlanAddScope(plan, root)
    let suite1 = cleanup.CleanupPlanAddScope(plan, scope)
    let suite2 = cleanup.CleanupPlanAddScope(plan, scope)
    cleanup.CleanupPlanRegisterDefer(plan, scope, suite1, 2, firstFlag, fragmentId)
    cleanup.CleanupPlanRegisterDefer(plan, scope, suite2, 1, secondFlag, fragmentId)
    panic("cleanup cfg smoke: out-of-order defer accepted")

fn runMissingSnapshotFailure() =
    var body = coreir.BodyIRNew()
    let source = addI32Slot(body, "source")
    var plan: cleanup.CleanupPlan
    cleanup.CleanupPlanPrepare(plan, limits(), 0)
    cleanup.CleanupPlanBindLocalSchema(plan, body)
    let root = cleanup.CleanupPlanRootScopeId(plan)
    var ret: coreir.BodyTerm
    ret.kind = coreir.BodyTermReturnTag
    ret.resultSlot = source
    let termIndex = coreir.BodyIRAppendTerm(body, ret)
    let _ = coreir.BodyIRAppendBlock(body, 0, 0, termIndex)
    cleanup.CleanupPlanQueueUnmanagedExit(plan,
                                          0,
                                          0,
                                          root,
                                          -1,
                                          odir.OwnershipDropEdgeReturn,
                                          -1)
    panic("cleanup cfg smoke: missing return snapshot accepted")

fn runReturnSlotMismatchFailure() =
    var body = coreir.BodyIRNew()
    let source = addI32Slot(body, "bound_source")
    let actualSource = addI32Slot(body, "actual_source")
    let snapshot = addI32Slot(body, "snapshot")
    var plan: cleanup.CleanupPlan
    cleanup.CleanupPlanPrepare(plan, limits(), 0)
    cleanup.CleanupPlanBindLocalSchema(plan, body)
    var ret: coreir.BodyTerm
    ret.kind = coreir.BodyTermReturnTag
    ret.resultSlot = actualSource
    let termIndex = coreir.BodyIRAppendTerm(body, ret)
    let _ = coreir.BodyIRAppendBlock(body, 0, 0, termIndex)
    let root = cleanup.CleanupPlanRootScopeId(plan)
    cleanup.CleanupPlanQueueUnmanagedReturnExit(plan,
                                                0,
                                                root,
                                                source,
                                                snapshot)
    let _ = cleanup.CleanupPlanMaterialize(body, plan)
    panic("cleanup cfg smoke: return result slot mismatch accepted")

fn runSnapshotSchemaMismatchFailure() =
