fn runGuardFlagIdentityFailure() =
    var ownershipIr: odir.OwnershipDropIr
    var ownershipAnalysis: odir.OwnershipDropAnalysis
    var ownershipDeferId: int32
    var ownershipEdgeId: int32
    var ownershipPlaceId: int32
    var initializeOwnershipOp: int32
    var activateOwnershipOp: int32
    var guardedAction: odir.OwnershipDropCleanupAction
    var fallbackAction: odir.OwnershipDropCleanupAction
    buildConditionalOwnershipGuard(ownershipIr,
                                   ownershipAnalysis,
                                   ownershipDeferId,
                                   ownershipEdgeId,
                                   ownershipPlaceId,
                                   initializeOwnershipOp,
                                   activateOwnershipOp,
                                   guardedAction,
                                   fallbackAction)
    let projection = odir.OwnershipDropProjectActionCondition(ownershipIr,
                                                               ownershipAnalysis,
                                                               guardedAction)
    ownershipAnalysis.conditionFlags[projection.guardFlagId - 1].deferId = -1
    let _ = odir.OwnershipDropProjectActionCondition(ownershipIr,
                                                      ownershipAnalysis,
                                                      guardedAction)
    panic("cleanup cfg smoke: corrupted guard flag accepted")

fn runMissingTypeLayoutFailure() =
    var body = coreir.BodyIRNew()
