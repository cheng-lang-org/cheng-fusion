fn is_big(v: uint64): bool =
    if v == uint64(0):
        return false
    return v >= uint64(0x100000000)

fn pick_u(v: uint64): int32 =
    if is_big(v):
        return 1
    return 777

fn main(): int32 =
    if pick_u(uint64(4)) != 777:
        return 4
    if pick_u(uint64(0x200000000)) != 1:
        return 5
    return 0
