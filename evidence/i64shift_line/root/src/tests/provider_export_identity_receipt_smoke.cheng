import std/rawbytes
import std/crypto/hash256
import cheng/std/bytes_layout as layout
import cheng/core/runtime/arena as arenamod
import cheng/core/backend/provider_export_identity_receipt as peir

fn smokeCid(seed: int32): layout.FixedBytes32 =
    var out: layout.FixedBytes32
    for index in 0..<32:
        out.data[index] = uint8((seed + index * 17) & 255)
    return out

fn smokeBuildReceipt(): peir.ProviderExportIdentityReceipt =
    var receipt = peir.ProviderExportIdentityReceiptInit(256)
    let provider0 = peir.ProviderExportIdentityReceiptAppendProvider(
        receipt, smokeCid(1), smokeCid(2), smokeCid(3))
    assert(provider0 == 0, " provider receipt smoke: provider0 row")
    assert(peir.ProviderExportIdentityReceiptAppendExport(
        receipt, provider0, 7, 11, 13, 17,
        smokeCid(4), smokeCid(5),
        peir.ProviderExportContractRoleSetCmdLine,
        "__cheng_setCmdLine") == 0,
        " provider receipt smoke: export0 row")
    assert(peir.ProviderExportIdentityReceiptAppendExport(
        receipt, provider0, 8, 11, 19, 23,
        smokeCid(6), smokeCid(7),
        peir.ProviderExportContractRoleRegisterLineMap,
        "cheng_native_register_line_map_from_argv0") == 1,
        " provider receipt smoke: export1 row")
    let provider1 = peir.ProviderExportIdentityReceiptAppendProvider(
        receipt, smokeCid(8), smokeCid(9), smokeCid(10))
    assert(provider1 == 1, " provider receipt smoke: provider1 row")
    assert(peir.ProviderExportIdentityReceiptAppendExport(
        receipt, provider1, 3, 29, 31, 37,
        smokeCid(11), smokeCid(12),
        peir.ProviderExportContractRoleProfileFlush,
        "任意符号_ß") == 2,
        " provider receipt smoke: export2 row")
    var err: str
    assert(peir.ProviderExportIdentityReceiptSealInto(receipt, err), err)
    assert(peir.ProviderExportIdentityReceiptStrictValidateInto(receipt, err),
           err)
    return receipt

@borrows
fn smokeExpectInvalid(
        receipt: peir.ProviderExportIdentityReceipt,
        expected: str) =
    var err: str
    assert(!peir.ProviderExportIdentityReceiptStrictValidateInto(
               receipt, err),
           " provider receipt smoke: mutation accepted")
    assert(err == expected,
           " provider receipt smoke: wrong mutation reason: " + err)

fn smokeAppendRejections(mutations: var int32) =
    var receipt = peir.ProviderExportIdentityReceiptInit(256)
    assert(peir.ProviderExportIdentityReceiptAppendProvider(
               receipt, layout.FixedBytes32(), smokeCid(1), smokeCid(2)) == -1,
           " provider receipt smoke: zero provider cid accepted")
    mutations = mutations + 1
    let provider0 = peir.ProviderExportIdentityReceiptAppendProvider(
        receipt, smokeCid(1), smokeCid(2), smokeCid(3))
    assert(peir.ProviderExportIdentityReceiptAppendExport(
        receipt, provider0, 1, 2, 3, 4,
        smokeCid(4), smokeCid(5),
        peir.ProviderExportContractRoleSetCmdLine, "role-a") == 0,
        " provider receipt smoke: rejection fixture export")
    assert(peir.ProviderExportIdentityReceiptAppendExport(
        receipt, provider0, 5, 6, 7, 8,
        smokeCid(6), smokeCid(7),
        peir.ProviderExportContractRoleSetCmdLine, "role-b") == -1,
        " provider receipt smoke: duplicate role accepted")
    mutations = mutations + 1
    let provider1 = peir.ProviderExportIdentityReceiptAppendProvider(
        receipt, smokeCid(8), smokeCid(9), smokeCid(10))
    assert(peir.ProviderExportIdentityReceiptAppendExport(
        receipt, provider0, 5, 6, 7, 8,
        smokeCid(6), smokeCid(7),
        peir.ProviderExportContractRoleRegisterLineMap,
        "late-provider") == -1,
        " provider receipt smoke: cross-provider append accepted")
    mutations = mutations + 1

    var nulBytes = rawbytes.BytesAlloc(1)
    rawbytes.BytesSet(nulBytes, 0, 0)
    let nulText = rawbytes.BytesToString(nulBytes)
    rawbytes.BytesFree(nulBytes)
    assert(peir.ProviderExportIdentityReceiptAppendExport(
        receipt, provider1, 5, 6, 7, 8,
        smokeCid(6), smokeCid(7),
        peir.ProviderExportContractRoleProfileFlush, nulText) == -1,
        " provider receipt smoke: nul payload accepted")
    mutations = mutations + 1

    var badBytes = rawbytes.BytesAlloc(1)
    rawbytes.BytesSet(badBytes, 0, 0xc0)
    let badText = rawbytes.BytesToString(badBytes)
    rawbytes.BytesFree(badBytes)
    assert(peir.ProviderExportIdentityReceiptAppendExport(
        receipt, provider1, 5, 6, 7, 8,
        smokeCid(6), smokeCid(7),
        peir.ProviderExportContractRoleProfileFlush, badText) == -1,
        " provider receipt smoke: invalid utf8 payload accepted")
    mutations = mutations + 1
    assert(peir.ProviderExportIdentityReceiptAppendExport(
        receipt, provider1, 5, 6, 7, 8,
        smokeCid(6), smokeCid(7),
        peir.ProviderExportContractRoleMax + 1, "unknown-role") == -1,
        " provider receipt smoke: unknown contract role accepted")
    mutations = mutations + 1
    peir.ProviderExportIdentityReceiptRelease(receipt)

fn smokeStrictMutations(mutations: var int32) =
    var shape = smokeBuildReceipt()
    add(shape.exportInterfaceCids, smokeCid(99))
    smokeExpectInvalid(
        shape, " provider export identity receipt: export shape invalid")
    mutations = mutations + 1
    peir.ProviderExportIdentityReceiptRelease(shape)

    var cid = smokeBuildReceipt()
    cid.receiptCid.data[0] = uint8(int32(cid.receiptCid.data[0]) ^ 1)
    smokeExpectInvalid(
        cid, " provider export identity receipt: receipt cid mismatch")
    mutations = mutations + 1
    peir.ProviderExportIdentityReceiptRelease(cid)

    var csr = smokeBuildReceipt()
    arenamod.ArenaArrayInt32Set(
        csr.arena, csr.providerExportStarts, 1, 0)
    smokeExpectInvalid(
        csr, " provider export identity receipt: provider csr invalid")
    mutations = mutations + 1
    peir.ProviderExportIdentityReceiptRelease(csr)

    var crossProvider = smokeBuildReceipt()
    arenamod.ArenaArrayInt32Set(
        crossProvider.arena, crossProvider.exportProviderRows, 0, 1)
    smokeExpectInvalid(
        crossProvider,
        " provider export identity receipt: cross-provider export")
    mutations = mutations + 1
    peir.ProviderExportIdentityReceiptRelease(crossProvider)

    var duplicateRole = smokeBuildReceipt()
    arenamod.ArenaArrayInt32Set(
        duplicateRole.arena, duplicateRole.exportContractRoleKinds, 1,
        peir.ProviderExportContractRoleSetCmdLine)
    smokeExpectInvalid(
        duplicateRole,
        " provider export identity receipt: duplicate provider role")
    mutations = mutations + 1
    peir.ProviderExportIdentityReceiptRelease(duplicateRole)

    var zeroCid = smokeBuildReceipt()
    zeroCid.providerObjectBytesCids[0] = layout.FixedBytes32()
    smokeExpectInvalid(
        zeroCid, " provider export identity receipt: zero provider cid")
    mutations = mutations + 1
    peir.ProviderExportIdentityReceiptRelease(zeroCid)

    var nul = smokeBuildReceipt()
    arenamod.ArenaArrayU8Set(nul.arena, nul.exportUtf8Bytes, 0, 0)
    smokeExpectInvalid(
        nul, " provider export identity receipt: utf8 csr invalid")
    mutations = mutations + 1
    peir.ProviderExportIdentityReceiptRelease(nul)

    var badUtf8 = smokeBuildReceipt()
    arenamod.ArenaArrayU8Set(badUtf8.arena, badUtf8.exportUtf8Bytes, 0, 0xc0)
    smokeExpectInvalid(
        badUtf8, " provider export identity receipt: utf8 csr invalid")
    mutations = mutations + 1
    peir.ProviderExportIdentityReceiptRelease(badUtf8)

    var badRole = smokeBuildReceipt()
    arenamod.ArenaArrayInt32Set(
        badRole.arena, badRole.exportContractRoleKinds, 0,
        peir.ProviderExportContractRoleMax + 1)
    smokeExpectInvalid(
        badRole,
        " provider export identity receipt: contract role invalid")
    mutations = mutations + 1
    peir.ProviderExportIdentityReceiptRelease(badRole)

fn smokeMoveRejections(mutations: var int32) =
    var source = smokeBuildReceipt()
    var occupied = smokeBuildReceipt()
    var err: str
    assert(!peir.ProviderExportIdentityReceiptMoveInto(
               occupied, source, err) &&
           err == " provider export identity receipt: move output owns storage",
           " provider receipt smoke: occupied move output accepted: " + err)
    assert(peir.ProviderExportIdentityReceiptStrictValidateInto(source, err),
           " provider receipt smoke: rejected move damaged source: " + err)
    assert(peir.ProviderExportIdentityReceiptStrictValidateInto(occupied, err),
           " provider receipt smoke: rejected move damaged output: " + err)
    mutations = mutations + 1
    peir.ProviderExportIdentityReceiptRelease(source)
    peir.ProviderExportIdentityReceiptRelease(occupied)

@borrows
fn smokeBinaryMutations(
        encoded: rawbytes.Bytes,
        mutations: var int32) =
    var oldVersion = rawbytes.BytesSlice(
        encoded, 0, rawbytes.BytesLen(encoded))
    rawbytes.BytesSet(oldVersion, 7, 2)
    var decoded: peir.ProviderExportIdentityReceipt
    var err: str
    assert(!peir.ProviderExportIdentityReceiptDecodeStrictInto(
               oldVersion, decoded, err) &&
           err == " provider export identity receipt: magic/version invalid",
           " provider receipt smoke: old version accepted: " + err)
    mutations = mutations + 1
    rawbytes.BytesFree(oldVersion)

    var truncated = rawbytes.BytesSlice(
        encoded, 0, rawbytes.BytesLen(encoded) - 1)
    assert(!peir.ProviderExportIdentityReceiptDecodeStrictInto(
               truncated, decoded, err) &&
           err == " provider export identity receipt: binary size invalid",
           " provider receipt smoke: truncation accepted: " + err)
    mutations = mutations + 1
    rawbytes.BytesFree(truncated)

    var content = rawbytes.BytesSlice(
        encoded, 0, rawbytes.BytesLen(encoded))
    rawbytes.BytesSet(content, 20, rawbytes.BytesGet(content, 20) ^ 1)
    assert(!peir.ProviderExportIdentityReceiptDecodeStrictInto(
               content, decoded, err) &&
           err == " provider export identity receipt: receipt cid mismatch",
           " provider receipt smoke: content mutation accepted: " + err)
    mutations = mutations + 1
    rawbytes.BytesFree(content)

    var trailing = rawbytes.BytesAlloc(rawbytes.BytesLen(encoded) + 1)
    rawbytes.BytesCopyRangeInto(
        trailing, 0, encoded, 0, rawbytes.BytesLen(encoded))
    rawbytes.BytesSet(trailing, rawbytes.BytesLen(encoded), 1)
    assert(!peir.ProviderExportIdentityReceiptDecodeStrictInto(
               trailing, decoded, err) &&
           err == " provider export identity receipt: binary size invalid",
           " provider receipt smoke: trailing byte accepted: " + err)
    mutations = mutations + 1
    rawbytes.BytesFree(trailing)

    var occupied = smokeBuildReceipt()
    assert(!peir.ProviderExportIdentityReceiptDecodeStrictInto(
               encoded, occupied, err) &&
           err == " provider export identity receipt: move output owns storage",
           " provider receipt smoke: live decode output overwritten: " + err)
    mutations = mutations + 1
    peir.ProviderExportIdentityReceiptRelease(occupied)

fn main() =
    var mutations: int32
    smokeAppendRejections(mutations)
    smokeStrictMutations(mutations)
    smokeMoveRejections(mutations)

    var receipt = smokeBuildReceipt()
    var err: str
    assert(peir.ProviderExportIdentityReceiptAppendProvider(
               receipt, smokeCid(90), smokeCid(91), smokeCid(92)) == -1,
           " provider receipt smoke: sealed receipt mutated")
    mutations = mutations + 1

    var encoded = rawbytes.BytesAlloc(1)
    rawbytes.BytesSet(encoded, 0, 0xa5)
    assert(!peir.ProviderExportIdentityReceiptEncodeStrictInto(
               receipt, encoded, err) &&
           err == " provider export identity receipt: encode output not empty" &&
           rawbytes.BytesGet(encoded, 0) == 0xa5,
           " provider receipt smoke: live encode output overwritten: " + err)
    mutations = mutations + 1
    rawbytes.BytesFree(encoded)
    assert(peir.ProviderExportIdentityReceiptEncodeStrictInto(
               receipt, encoded, err), err)
    var decoded: peir.ProviderExportIdentityReceipt
    assert(peir.ProviderExportIdentityReceiptDecodeStrictInto(
               encoded, decoded, err), err)
    var reencoded: rawbytes.Bytes
    assert(peir.ProviderExportIdentityReceiptEncodeStrictInto(
               decoded, reencoded, err), err)
    assert(rawbytes.BytesEqual(encoded, reencoded),
           " provider receipt smoke: roundtrip bytes differ")
    assert(layout.FixedBytes32Equal(receipt.receiptCid, decoded.receiptCid),
           " provider receipt smoke: roundtrip cid differs")
    smokeBinaryMutations(encoded, mutations)

    let retainedBuffers =
        peir.ProviderExportIdentityReceiptRetainedBufferCount(decoded)
    let retainedBytes = peir.ProviderExportIdentityReceiptRetainedBytes(decoded)
    assert(retainedBuffers == 6 && retainedBytes > 0,
           " provider receipt smoke: retained ledger invalid")
    var releaseReceipt: peir.ProviderExportIdentityReleaseReceipt
    assert(peir.ProviderExportIdentityReceiptReleaseWithReceipt(
               decoded, releaseReceipt),
           " provider receipt smoke: release failed")
    assert(releaseReceipt.releasedOwnedStorageColumnCount == 6 &&
           releaseReceipt.releasedBufferCount == retainedBuffers &&
           releaseReceipt.releasedBytes == retainedBytes &&
           peir.ProviderExportIdentityReceiptStorageReleased(decoded),
           " provider receipt smoke: release ledger mismatch")
    assert(peir.ProviderExportIdentityReceiptConsumeReleaseReceipt(
               decoded, releaseReceipt),
           " provider receipt smoke: release receipt rejected")
    assert(!peir.ProviderExportIdentityReceiptConsumeReleaseReceipt(
               decoded, releaseReceipt),
           " provider receipt smoke: release receipt consumed twice")
    mutations = mutations + 1

    var cleanup = smokeBuildReceipt()
    peir.ProviderExportIdentityReceiptRelease(cleanup)
    assert(cleanup.terminalStorageReleased &&
           cleanup.terminalReleaseReceiptConsumed &&
           peir.ProviderExportIdentityReceiptStorageReleased(cleanup),
           " provider receipt smoke: cleanup left release receipt open")
    mutations = mutations + 1

    var polluted: peir.ProviderExportIdentityReceipt
    polluted.schemaVersion = peir.ProviderExportIdentityReceiptSchemaVersion
    polluted.terminalReleaseOwnerToken = smokeCid(77)
    var pollutedRelease: peir.ProviderExportIdentityReleaseReceipt
    assert(!peir.ProviderExportIdentityReceiptReleaseWithReceipt(
               polluted, pollutedRelease),
           " provider receipt smoke: polluted terminal owner accepted")
    mutations = mutations + 1

    let wireCid = hash256.Sha256Fixed(layout.ByteSpanFromBytes(encoded))
    echo("provider_export_identity_receipt_ok providers=" +
         IntToStr(peir.ProviderExportIdentityReceiptProviderCount(receipt)) +
         " exports=" +
         IntToStr(peir.ProviderExportIdentityReceiptExportCount(receipt)) +
         " bytes=" + IntToStr(rawbytes.BytesLen(encoded)) +
         " receipt_cid=" + layout.FixedBytes32Hex(receipt.receiptCid) +
         " wire_sha256=" + layout.FixedBytes32Hex(wireCid) +
         " mutations=" + IntToStr(mutations) +
         " retained_buffers=" + IntToStr(retainedBuffers) +
         " retained_bytes=" + Int64ToStr(retainedBytes))

    peir.ProviderExportIdentityReceiptRelease(receipt)
    rawbytes.BytesFree(encoded)
    rawbytes.BytesFree(reencoded)
