# SHA3/SHAKE known-answer tests.
# Oracle: python3 hashlib (sha3_256 / sha3_512 / shake_128 / shake_256).
# Inputs per variant: empty, "abc", pattern bytes (i & 255) of length
# rate-1 / rate / rate+1, and 1000 LCG pseudo-random bytes (seed 42,
# x = (x * 1103515245 + 12345) mod 2^31, byte = (x >> 16) & 255).
# SHAKE outputs are 200 bytes (crosses one squeeze block for both rates).

import std/system
import std/strings
import std/rawbytes
import std/crypto/sha3

fn patBytes(n: int32): Bytes =
    let out: Bytes = BytesAlloc(n)
    var i: int32
    while i < n:
        BytesSet(out, i, i & 255)
        i = i + 1
    return out

fn lcgBytes(n: int32): Bytes =
    let out: Bytes = BytesAlloc(n)
    var x: int64 = 42
    var i: int32
    while i < n:
        x = (x * 1103515245 + 12345) % 2147483648
        BytesSet(out, i, int32((x >> 16) & 255))
        i = i + 1
    return out

fn checkKat(label: str, got: Bytes, expectedHex: str): bool =
    let gotHex: str = BytesToHex(got)
    if streq(gotHex, expectedHex):
        return true
    echo("sha3 KAT mismatch at input:")
    echo(label)
    echo("got:")
    echo(gotHex)
    echo("expected:")
    echo(expectedHex)
    return false

fn main(): int32 =
    let empty: Bytes = BytesAlloc(0)
    let abc: Bytes = BytesFromString("abc")
    let rand1000: Bytes = lcgBytes(1000)

    if !checkKat("kat 0: sha3_256 empty len=0",
                 sha3.Sha3_256Digest(empty),
                 "a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a"):
        return 1
    if !checkKat("kat 1: sha3_256 abc len=3",
                 sha3.Sha3_256Digest(abc),
                 "3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532"):
        return 1
    if !checkKat("kat 2: sha3_256 rate-1 len=135",
                 sha3.Sha3_256Digest(patBytes(135)),
                 "fded8fd9d6551c601eeb3b7c6bc5e5cfd8aad1d015b7e9aaa9c9b9475231d5e2"):
        return 1
    if !checkKat("kat 3: sha3_256 rate len=136",
                 sha3.Sha3_256Digest(patBytes(136)),
                 "cf3ccff92480a29160c2d38317c430e14749bfee1788106957dfe73f8c4930e5"):
        return 1
    if !checkKat("kat 4: sha3_256 rate+1 len=137",
                 sha3.Sha3_256Digest(patBytes(137)),
                 "ce9d7dc90913ee5d92745019479a5352c6d6279bef18ed07dc0a83ee8084daca"):
        return 1
    if !checkKat("kat 5: sha3_256 rand1000 len=1000",
                 sha3.Sha3_256Digest(rand1000),
                 "b55079c02f04bb126b5e24422806f427106fb2b85c4b9f67d7e8d6b8c867d79f"):
        return 1
    if !checkKat("kat 6: sha3_512 empty len=0",
                 sha3.Sha3_512Digest(empty),
                 "a69f73cca23a9ac5c8b567dc185a756e97c982164fe25859e0d1dcc1475c80a615b2123af1f5f94c11e3e9402c3ac558f500199d95b6d3e301758586281dcd26"):
        return 1
    if !checkKat("kat 7: sha3_512 abc len=3",
                 sha3.Sha3_512Digest(abc),
                 "b751850b1a57168a5693cd924b6b096e08f621827444f70d884f5d0240d2712e10e116e9192af3c91a7ec57647e3934057340b4cf408d5a56592f8274eec53f0"):
        return 1
    if !checkKat("kat 8: sha3_512 rate-1 len=71",
                 sha3.Sha3_512Digest(patBytes(71)),
                 "3ccc850d53a1287af7b4560b2ef0d43eb5d9a80d62a0e9cf1dbc040135921104d4395168e90bfc871773ebb34bca1bd67056e1cc7dc7a48ff7c3167d389f117c"):
        return 1
    if !checkKat("kat 9: sha3_512 rate len=72",
                 sha3.Sha3_512Digest(patBytes(72)),
                 "5d63f2bbe971a983ac6847480106e4e1264ee3a0befd79954914e1d86e795b2e18238f12fc5e46cb9cc78efdec610a93647cc04e1c23d8caaa6a58c21dd26c07"):
        return 1
    if !checkKat("kat 10: sha3_512 rate+1 len=73",
                 sha3.Sha3_512Digest(patBytes(73)),
                 "921d9b7b2b0f3066a1646dbb058c979cb3925dec0f8c269faaa7f9648e73465ae55ec527257d5d5e1cfdbf5d6799bea1004b6186f5108c74e3b92fe924166558"):
        return 1
    if !checkKat("kat 11: sha3_512 rand1000 len=1000",
                 sha3.Sha3_512Digest(rand1000),
                 "128fb42de0fe0abfb022b6684d7b9cd3c8d3ccafde9eb9cab7f5b4718a0cb333b53d4b65196463383b63efaa6cb0cecbcea542c27da581d8f5e5632379af5b4c"):
        return 1
    if !checkKat("kat 12: shake128 empty len=0",
                 sha3.Shake128Xof(empty, 200),
                 ""):
        return 1
    if !checkKat("kat 13: shake128 abc len=3",
                 sha3.Shake128Xof(abc, 200),
                 ""):
        return 1
    if !checkKat("kat 14: shake128 rate-1 len=167",
                 sha3.Shake128Xof(patBytes(167), 200),
                 ""):
        return 1
    if !checkKat("kat 15: shake128 rate len=168",
                 sha3.Shake128Xof(patBytes(168), 200),
                 ""):
        return 1
    if !checkKat("kat 16: shake128 rate+1 len=169",
                 sha3.Shake128Xof(patBytes(169), 200),
                 ""):
        return 1
    if !checkKat("kat 17: shake128 rand1000 len=1000",
                 sha3.Shake128Xof(rand1000, 200),
                 ""):
        return 1
    if !checkKat("kat 18: shake256 empty len=0",
                 sha3.Shake256Xof(empty, 200),
                 ""):
        return 1
    if !checkKat("kat 19: shake256 abc len=3",
                 sha3.Shake256Xof(abc, 200),
                 ""):
        return 1
    if !checkKat("kat 20: shake256 rate-1 len=135",
                 sha3.Shake256Xof(patBytes(135), 200),
                 ""):
        return 1
    if !checkKat("kat 21: shake256 rate len=136",
                 sha3.Shake256Xof(patBytes(136), 200),
                 ""):
        return 1
    if !checkKat("kat 22: shake256 rate+1 len=137",
                 sha3.Shake256Xof(patBytes(137), 200),
                 ""):
        return 1
    if !checkKat("kat 23: shake256 rand1000 len=1000",
                 sha3.Shake256Xof(rand1000, 200),
                 ""):
        return 1
    echo(" sha3_kat_smoke ok: 24/24 KATs passed")
    return 0
