import cheng/core/backend/primary_object_plan as pobj

fn main(): int32 =
    assert(pobj.PrimaryLowerPoolBatchReceiveAtomicityContract(),
           " primary lower pool lifecycle: transactional move/release")
    assert(pobj.PrimaryLowerPoolMalformedFrameReapContract(),
           " primary lower pool lifecycle: malformed frame reap")
    echo("primary_lower_pool_lifecycle ok transactional_move=1 failure_release=1 workers_reaped=1")
    return 0
