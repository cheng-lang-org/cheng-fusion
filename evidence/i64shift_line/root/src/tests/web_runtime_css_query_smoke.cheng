import cheng/core/runtime/web_runtime as web
import cheng/core/runtime/web_style_runtime as style

fn BuildCssQueryDocument(document: var web.WebDocument,
                         root: var int32,
                         header: var int32,
                         content: var int32,
                         highlight: var int32,
                         footer: var int32): bool =
    web.WebDocumentInit(document)
    let docNode = web.WebDocumentCreateDocumentNode(document)
    root = web.WebDocumentCreateElement(document, "div")
    header = web.WebDocumentCreateElement(document, "h1")
    content = web.WebDocumentCreateElement(document, "p")
    highlight = web.WebDocumentCreateElement(document, "span")
    footer = web.WebDocumentCreateElement(document, "div")

    web.WebDocumentSetAttribute(document, root, "id", "root")
    web.WebDocumentSetAttribute(document, header, "class", "title")
    web.WebDocumentSetAttribute(document, content, "class", "content highlight")
    web.WebDocumentSetAttribute(document, highlight, "id", "hl")
    web.WebDocumentSetAttribute(document, footer, "id", "footer")

    if !web.WebDocumentAppendChild(document, docNode, root):
        return false
    if !web.WebDocumentAppendChild(document, root, header):
        return false
    if !web.WebDocumentAppendChild(document, root, content):
        return false
    if !web.WebDocumentAppendChild(document, content, highlight):
        return false
    if !web.WebDocumentAppendChild(document, root, footer):
        return false
    return true

fn VerifyDomQueries(document: var web.WebDocument,
                    root: int32,
                    header: int32,
                    content: int32,
                    highlight: int32,
                    footer: int32): int32 =
    if web.WebDocumentGetElementById(document, "root") != root:
        return 10
    if web.WebDocumentGetElementById(document, "hl") != highlight:
        return 11
    if web.WebDocumentGetElementById(document, "nonexistent") != 0:
        return 12

    var divs: int32[]
    if web.WebDocumentGetElementsByTagName(document, "div", divs) != 2:
        return 20
    if divs.len != 2:
        return 21
    if divs[0] != root || divs[1] != footer:
        return 22

    var spans: int32[]
    if web.WebDocumentGetElementsByTagName(document, "span", spans) != 1:
        return 23
    if spans[0] != highlight:
        return 24

    // ─── Test 3: getElementsByClassName ───
    var titles: int32[]
    if web.WebDocumentGetElementsByClassName(document, "title", titles) != 1:
        return 30
    if titles[0] != header:
        return 31

    var highlights: int32[]
    if web.WebDocumentGetElementsByClassName(document, "highlight", highlights) != 1:
        return 32
    if highlights[0] != content:
        return 33

    var nonexist: int32[]
    if web.WebDocumentGetElementsByClassName(document, "nonexistent", nonexist) != 0:
        return 34
    return 0

fn VerifyCssSelectors(document: var web.WebDocument,
                      root: int32,
                      header: int32,
                      content: int32,
                      highlight: int32,
                      footer: int32): int32 =
    if style.WebDocumentQuerySelector(document, "h1") != header:
        return 40
    if style.WebDocumentQuerySelector(document, "span") != highlight:
        return 41
    if style.WebDocumentQuerySelector(document, "div") != root:
        return 42

    // ─── Test 5: querySelector with id selector ───
    if style.WebDocumentQuerySelector(document, "#root") != root:
        return 50
    if style.WebDocumentQuerySelector(document, "#hl") != highlight:
        return 51
    if style.WebDocumentQuerySelector(document, "#footer") != footer:
        return 52

    // ─── Test 6: querySelector with class selector ───
    if style.WebDocumentQuerySelector(document, ".title") != header:
        return 60
    if style.WebDocumentQuerySelector(document, ".content") != content:
        return 61
    if style.WebDocumentQuerySelector(document, ".highlight") != content:
        return 62

    // ─── Test 7: querySelector with descendant combinator ───
    // h1 descendant of div → header
    if style.WebDocumentQuerySelector(document, "div h1") != header:
        return 70
    // #hl descendant of #root → highlight (span#hl in div#root)
    if style.WebDocumentQuerySelector(document, "#root #hl") != highlight:
        return 71
    // div descendant of #root → footer (div child of #root)
    if style.WebDocumentQuerySelector(document, "#root div") != footer:
        return 72

    // ─── Test 8: querySelectorAll ───
    var allDivs: int32[]
    if style.WebDocumentQuerySelectorAll(document, "div", allDivs) != 2:
        return 80
    if allDivs.len != 2:
        return 81
    if allDivs[0] != root || allDivs[1] != footer:
        return 82

    var allContent: int32[]
    if style.WebDocumentQuerySelectorAll(document, ".content", allContent) != 1:
        return 83
    if allContent[0] != content:
        return 84

    // ─── Test 9: querySelectorAll with descendant combinator ───
    var allDesc: int32[]
    if style.WebDocumentQuerySelectorAll(document, "#root span", allDesc) != 1:
        return 90
    if allDesc[0] != highlight:
        return 91

    var allRootDiv: int32[]
    if style.WebDocumentQuerySelectorAll(document, "#root div", allRootDiv) != 1:
        return 92
    if allRootDiv[0] != footer:
        return 93
    return 0

fn VerifyArrayFromDomCollections(document: var web.WebDocument,
                                 root: int32,
                                 header: int32,
                                 content: int32,
                                 footer: int32): int32 =
    var divIds: int32[]
    style.WebDocumentQuerySelectorAll(document, "div", divIds)
    var divArray: int32[]
    if web.WebArrayFromNodeIds(divIds, divArray) != 2:
        return 160
    if divArray.len != 2:
        return 161
    if divArray[0] != root:
        return 164
    if divArray[1] != footer:
        return 167

    var queryArray: int32[]
    var contentIds: int32[]
    style.WebDocumentQuerySelectorAll(document, ".content", contentIds)
    if web.WebArrayFromNodeIds(contentIds, queryArray) != 1:
        return 168
    if queryArray.len != 1:
        return 169
    if queryArray[0] != content:
        return 171

    var childArray: int32[]
    if web.WebArrayFromChildNodes(document, root, childArray) != 3:
        return 172
    if childArray.len != 3:
        return 173
    if childArray[0] != header:
        return 175

    var attrArray: web.WebAttribute[]
    if web.WebArrayFromElementAttributes(document, root, attrArray) != 1:
        return 176
    if attrArray.len != 1:
        return 177
    if attrArray[0].name != "id":
        return 181
    if attrArray[0].value != "root":
        return 183

    var files: web.WebFileList
    web.WebFileListInit(files)
    var file: web.WebFile
    web.WebFileInit(file, "report.csv", 42, "text/csv")
    web.WebFileListAdd(files, file)
    var fileArray: web.WebFileArray
    if web.WebArrayFromFileList(files, fileArray) != 1:
        return 184
    if fileArray.names.len != 1:
        return 185
    if fileArray.names[0] != "report.csv":
        return 189
    if fileArray.sizes[0] != 42:
        return 191

    var items: web.WebDataTransferItemList
    web.WebDataTransferItemListInit(items)
    var item: web.WebDataTransferItem
    web.WebDataTransferItemInit(item, "file", "image/png")
    web.WebDataTransferItemListAdd(items, item)
    var itemArray: web.WebDataTransferItemArray
    if web.WebArrayFromDataTransferItemList(items, itemArray) != 1:
        return 192
    if itemArray.kinds.len != 1:
        return 193
    if itemArray.kinds[0] != "file":
        return 197
    if itemArray.mediaTypes[0] != "image/png":
        return 199
    return 0

fn VerifyRuleMatches(document: var web.WebDocument,
	                     root: int32,
	                     header: int32,
                     highlight: int32,
                     footer: int32): int32 =
    var sheet: style.WebStyleSheet
    style.WebStyleSheetInit(sheet)
    if !style.WebStyleSheetParse("div { color: red; } h1 { color: blue; } span { color: purple; }", sheet):
        return 100
    if !style.WebStyleSheetRuleMatches(document, sheet, 0, root):
        return 101
    if !style.WebStyleSheetRuleMatches(document, sheet, 0, footer):
        return 102
    if style.WebStyleSheetRuleMatches(document, sheet, 0, header):
        return 103
    if !style.WebStyleSheetRuleMatches(document, sheet, 1, header):
        return 104
    if !style.WebStyleSheetRuleMatches(document, sheet, 2, highlight):
        return 105
    if style.WebStyleSheetRuleMatches(document, sheet, 2, root):
        return 106
    return 0

fn VerifyCascade(document: var web.WebDocument,
                 root: int32,
                 header: int32,
                 content: int32,
                 footer: int32): int32 =
    var specSheet: style.WebStyleSheet
    style.WebStyleSheetInit(specSheet)
    if !style.WebStyleSheetParse("div { color: red; } .title { color: blue; font-size: 24px; } #root { color: green; } div { color: yellow; } .content { font-size: 20px; }", specSheet):
        return 110

    // root (div#root): matches div (spec=1) and #root (spec=100)
    // #root wins → color = green
    var rootStyle: style.WebComputedStyle
    if !style.WebStyleSheetComputeStyle(document, specSheet, root, rootStyle):
        return 111
    if !style.WebComputedStyleColorEquals(rootStyle, "green"):
        return 112

    // header (h1.title): matches .title (spec=10)
    // color = blue, font-size = 24px
    var headerStyle: style.WebComputedStyle
    if !style.WebStyleSheetComputeStyle(document, specSheet, header, headerStyle):
        return 113
    if !style.WebComputedStyleColorEquals(headerStyle, "blue"):
        return 114
    if !style.WebComputedStyleFontSizeEquals(headerStyle, "24px"):
        return 115

    // content (p.content): matches .content (spec=10)
    // font-size = 20px, no color
    var contentStyle: style.WebComputedStyle
    if !style.WebStyleSheetComputeStyle(document, specSheet, content, contentStyle):
        return 116
    if contentStyle.hasColor:
        return 117
    if !style.WebComputedStyleFontSizeEquals(contentStyle, "20px"):
        return 118

    // footer (div#footer): matches div (spec=1, order=0) and div (spec=1, order=3)
    // Same specificity, later source order wins → color = yellow
    var footerStyle: style.WebComputedStyle
    if !style.WebStyleSheetComputeStyle(document, specSheet, footer, footerStyle):
        return 119
    if !style.WebComputedStyleColorEquals(footerStyle, "yellow"):
        return 120
    return 0

fn VerifyInheritance(document: var web.WebDocument,
                     root: int32,
                     content: int32,
                     highlight: int32): int32 =
    var inheritSheet: style.WebStyleSheet
    style.WebStyleSheetInit(inheritSheet)
    if !style.WebStyleSheetParse("div { color: red; font-size: 16px; } p { color: blue; }", inheritSheet):
        return 130

    var rtStyle: style.WebComputedStyle
    if !style.WebStyleSheetComputeStyle(document, inheritSheet, root, rtStyle):
        return 131
    // root (div): color=red, font-size=16px
    if !style.WebComputedStyleColorEquals(rtStyle, "red"):
        return 132
    if !style.WebComputedStyleFontSizeEquals(rtStyle, "16px"):
        return 133

    var ctStyle: style.WebComputedStyle
    if !style.WebStyleSheetComputeStyle(document, inheritSheet, content, ctStyle):
        return 134
    // content (p): color=blue from rule, no font-size set
    if !style.WebComputedStyleColorEquals(ctStyle, "blue"):
        return 135
    if ctStyle.hasFontSize:
        return 136

    // Inherit font-size from parent (root)
    style.WebComputedStyleInherit(ctStyle, rtStyle)
    if !style.WebComputedStyleFontSizeEquals(ctStyle, "16px"):
        return 137

    // highlight (span): no direct style rules, inherit all from content (parent)
    var hlStyle: style.WebComputedStyle
    if !style.WebStyleSheetComputeStyle(document, inheritSheet, highlight, hlStyle):
        return 138
    if hlStyle.hasColor || hlStyle.hasFontSize:
        return 139

    style.WebComputedStyleInherit(hlStyle, ctStyle)
    // After inherit from content (which inherited font-size from root):
    // color=blue (inherited from content), font-size=16px (inherited via content from root)
    if !style.WebComputedStyleColorEquals(hlStyle, "blue"):
        return 140
    if !style.WebComputedStyleFontSizeEquals(hlStyle, "16px"):
        return 141
    return 0

fn VerifyMutationObserver(document: var web.WebDocument, root: int32, highlight: int32): int32 =
    let observerId = web.WebMutationObserverCreate(1)
    var options: web.WebMutationObserverOptions
    options.childList = true
    options.attributes = true
    options.characterData = true
    options.subtree = true
    options.attributeFilter = []
    if !web.WebMutationObserverObserve(document, observerId, root, options):
        return 150

    var records: web.WebMutationRecord[]
    if !web.WebMutationObserverTakeRecords(document, observerId, records) || records.len != 0:
        return 150

    web.WebDocumentSetAttribute(document, highlight, "id", "hl2")
    // SetAttribute auto-notifies mutation observers via WebDocumentNotifyMutationObservers

    if !web.WebMutationObserverTakeRecords(document, observerId, records) || records.len != 1:
        return 151
    if records[0].kind != "attributes":
        return 152
    return 0

fn main(): int32 =
    var document: web.WebDocument
    var root: int32
    var header: int32
    var content: int32
    var highlight: int32
    var footer: int32
    if !BuildCssQueryDocument(document, root, header, content, highlight, footer):
        return 1

    var code = VerifyDomQueries(document, root, header, content, highlight, footer)
    if code != 0:
        return code
    code = VerifyCssSelectors(document, root, header, content, highlight, footer)
    if code != 0:
        return code
    code = VerifyArrayFromDomCollections(document, root, header, content, footer)
    if code != 0:
        return code
    code = VerifyRuleMatches(document, root, header, highlight, footer)
    if code != 0:
        return code
    code = VerifyCascade(document, root, header, content, footer)
    if code != 0:
        return code
    code = VerifyInheritance(document, root, content, highlight)
    if code != 0:
        return code
    code = VerifyMutationObserver(document, root, highlight)
    if code != 0:
        return code

    echo("web_runtime_css_query_smoke ok")
    return 0
