import cheng/core/csg_core/compiler_snapshot_schema as schema
import cheng/core/ir/phase_arena as arenamod
import cheng/core/lang/parser as parser
import cheng/core/lang/typed_expr_type_arena as typearena
import cheng/core/tooling/compiler_csg as compiler_csg
import cheng/core/tooling/compiler_parser_receipt as parser_receipt
import cheng/core/tooling/compiler_snapshot_builder as builder
import cheng/core/tooling/semantic_snapshot as semantic_snapshot
import cheng/core/tooling/semantic_snapshot_declaration_identity as declaration
import cheng/core/tooling/semantic_snapshot_incremental_plan as incremental
import cheng/core/tooling/csg_normalize as csgnorm
import cheng/std/bytes_layout as layout
import cheng/tests/compiler_snapshot_builder_smoke as fixture

fn ModuleSymbolExplicitSource(): str =
    return "module alpha_beta\n\nfn same(): str =\n    let shared = \"value\"\n    return shared\n"

fn ModuleSymbolSidecar(
        producerSourceIndex: int32,
        source: str,
        sourcePath: str,
        modulePath: str,
        functionStartLine: int32,
        functionEndLine: int32):
        parser_receipt.ParserCanonicalSourceSidecar =
    var layer: parser.NormalizedExprLayer
    var err: str
    assert(parser.ParserReadNormalizedExprLayerFromText(
               sourcePath, source, layer, err), err)
    var identities: parser_receipt.ParserNormalizedExprFunctionIdentity[]
    add(identities,
        parser_receipt.ParserNormalizedExprFunctionIdentityMake(
            producerSourceIndex,
            producerSourceIndex,
            sourcePath,
            modulePath,
            "same",
            functionStartLine,
            functionEndLine))
    var declarations: parser.NormalizedFunctionDecl[]
    assert(parser.ParserReadNormalizedFunctionDecls(
               source, declarations, err), err)
    var out: parser_receipt.ParserCanonicalSourceSidecar
    assert(parser_receipt.ParserCanonicalSourceSidecarBuildInto(
               producerSourceIndex,
               source,
               source,
               layer.valueExprTree,
               identities,
               declarations,
               out,
               err), err)
    assert(parser_receipt.ParserCanonicalSourceSidecarStrictValidateInto(
               out, err), err)
    parser.NormalizedExprLayerReset(layer)
    return out

fn ModuleSymbolInputs(
        sidecars: var parser_receipt.ParserCanonicalSourceSidecar[],
        sourceRows: var builder.CompilerSnapshotCanonicalSourceRow[],
        completeTexts: var str[],
        completeSpans: var builder.CompilerSnapshotCanonicalSpanInput[]) =
    let implicitSource = fixture.SnapshotBuilderSmokeSource(0)
    let explicitSource = ModuleSymbolExplicitSource()
    add(sidecars,
        ModuleSymbolSidecar(
            0, implicitSource, "/workspace/a.cheng",
            "pkg/zeta_alpha_6", 1, 3))
    add(sidecars,
        ModuleSymbolSidecar(
            1, explicitSource, "/workspace/b.cheng",
            "pkg/alpha_beta", 3, 5))

    var explicitRow: builder.CompilerSnapshotCanonicalSourceRow
    explicitRow.documentCid =
        fixture.SnapshotBuilderSmokeDocumentCid("pkg/alpha_beta")
    explicitRow.producerSourceIndex = 1
    explicitRow.modulePath = "pkg/alpha_beta"
    explicitRow.contentCid = sidecars[1].sourceContentRaw32
    add(sourceRows, explicitRow)

    var implicitRow: builder.CompilerSnapshotCanonicalSourceRow
    implicitRow.documentCid =
        fixture.SnapshotBuilderSmokeDocumentCid("pkg/zeta_alpha_6")
    implicitRow.producerSourceIndex = 0
    implicitRow.modulePath = "pkg/zeta_alpha_6"
    implicitRow.contentCid = sidecars[0].sourceContentRaw32
    add(sourceRows, implicitRow)

    add(completeTexts, "pkg/zeta_alpha_6::same")
    add(completeTexts, "pkg/alpha_beta::same")
    var explicitExtra: builder.CompilerSnapshotCanonicalSpanInput
    explicitExtra.sourceIndex = 0
    explicitExtra.startByte = 0
    explicitExtra.endByte = 1
    explicitExtra.startLine = 0
    explicitExtra.startColumn = 0
    explicitExtra.endLine = 0
    explicitExtra.endColumn = 1
    add(completeSpans, explicitExtra)
    var implicitExtra: builder.CompilerSnapshotCanonicalSpanInput
    implicitExtra.sourceIndex = 1
    implicitExtra.startByte = 0
    implicitExtra.endByte = 1
    implicitExtra.startLine = 0
    implicitExtra.startColumn = 0
    implicitExtra.endLine = 0
    implicitExtra.endColumn = 1
    add(completeSpans, implicitExtra)

fn ModuleSymbolTables(
        sidecars: var parser_receipt.ParserCanonicalSourceSidecar[],
        sourceRows: var builder.CompilerSnapshotCanonicalSourceRow[],
        completeTexts: var str[],
        completeSpans: var builder.CompilerSnapshotCanonicalSpanInput[]):
        schema.CsgCompilerSnapshotTables =
    ModuleSymbolInputs(sidecars, sourceRows, completeTexts, completeSpans)
    var out: schema.CsgCompilerSnapshotTables
    var err: str
    assert(builder.CompilerSnapshotParserTablesBuildInto(
               sidecars,
               sourceRows,
               completeTexts,
               completeSpans,
               fixture.SnapshotBuilderSmokeCid(21, 1),
               out,
               err), err)
    return out

fn ModuleSymbolCsg(
        sidecars: var parser_receipt.ParserCanonicalSourceSidecar[],
        out: var compiler_csg.CompilerCsg) =
    fixture.SnapshotBuilderSmokeGraphBuild(0, out)
    let explicitLine = sidecars[1].functionSignatureLineNumbers[0]
    assert(explicitLine == 3,
           "module Symbol smoke: explicit function line drift")
    out.semanticGraph.sourceTable.textBytes[1] =
        ModuleSymbolExplicitSource().len
    out.semanticGraph.declTable.lineNumbers[1] = explicitLine
    out.semanticGraph.reachableFunctionTable.startLines[1] = explicitLine
    out.semanticGraph.reachableFunctionTable.endLines[1] = explicitLine + 1
    out.semanticGraph.reachableFunctionTable.functionNameSurfaceKinds[1] =
        sidecars[1].functionNameSurfaceKinds[0]
    out.semanticGraph.reachableFunctionTable.functionNameProofCids[1] =
        sidecars[1].functionNameProofCids[0]
    out.semanticGraph.resolvedCallTable.callTargetSignatureLineNumbers[0] =
        explicitLine
    var symbol = out.nodes[4]
    symbol.semanticDeclarationLineIndex = explicitLine
    symbol.factCid = compiler_csg.CompilerCsgHashNodeRecord(symbol)
    out.nodes[4] = symbol
    arenamod.ArenaArrayInt32Set(
        out.typedIr.arena,
        out.typedIr.functions2_signatureLineNumbers,
        1,
        explicitLine)
    out.canonicalGraphCid =
        csgnorm.CsgNormalizedGraphCid(out.packageId, out.nodes, out.edges)
    typearena.TypedExprTypeArenaRelease(out.typeArena)
    fixture.SnapshotBuilderSmokeTypeArenaFromSources(
        fixture.SnapshotBuilderSmokeSource(0),
        ModuleSymbolExplicitSource(),
        out.typeArena)

fn ModuleSymbolPrebuildFacts(
        tables: var schema.CsgCompilerSnapshotTables,
        csg: var compiler_csg.CompilerCsg):
        incremental.SemanticSnapshotIncrementalPrebuildFacts =
    var eventState: semantic_snapshot.WorkspaceSourceEventState
    var err: str
    assert(semantic_snapshot.WorkspaceSourceEventStateInitInto(
               fixture.SnapshotBuilderSmokeCid(41, 1),
               eventState,
               err), err)
    var sourceVersion: int64
    for sourceId in 0..<tables.sources.documentCids.len:
        assert(semantic_snapshot.WorkspaceSourceEventAcceptInto(
                   eventState,
                   semantic_snapshot.SemanticSourceEventOpen,
                   tables.sources.documentCids[sourceId],
                   int64(0),
                   sourceVersion,
                   err), err)
    var input: incremental.SemanticSnapshotIncrementalPrebuildInput
    input.worldHeadCid = fixture.SnapshotBuilderSmokeCid(42, 1)
    input.compilerCid = fixture.SnapshotBuilderSmokeCid(43, 1)
    input.sourceBundleCid = csg.sourceBundleCid
    input.frontEndReceiptCid =
        csg.parserNormalizedExprReceipt.envelope.receiptRaw32
    for sourceId in 0..<tables.sources.documentCids.len:
        add(input.documentCids, tables.sources.documentCids[sourceId])
        add(input.sourceProducerIndexes,
            tables.parserSidecars.producerSourceIndexes[sourceId])
        add(input.sourceTexts,
            sourceId == 0 ? ModuleSymbolExplicitSource() :
                            fixture.SnapshotBuilderSmokeSource(0))
        add(input.sourceInterfaceCids,
            tables.sources.interfaceCids[sourceId])
    let nodeA = csg.nodes[3]
    let nodeB = csg.nodes[4]
    var symbolCidBySource: layout.FixedBytes32[]
    add(symbolCidBySource, fixture.SnapshotBuilderSmokeCid(70, 1))
    add(symbolCidBySource, fixture.SnapshotBuilderSmokeCid(71, 1))
    let aFirst = fixture.SnapshotBuilderSmokeCidLess(
        symbolCidBySource[1], symbolCidBySource[0])
    for symbolId in 0..<2:
        let isA = (symbolId == 0) == aFirst
        let node = isA ? nodeA : nodeB
        add(input.symbolCids, symbolCidBySource[isA ? 1 : 0])
        add(input.symbolInterfaceCids,
            fixture.SnapshotBuilderSmokeCid(50 + node.nodeId, 1))
    for functionId in 0..<2:
        let isA = (functionId == 0) == aFirst
        let sourceId = isA ? 1 : 0
        add(input.functionSymbolIds, functionId)
        add(input.functionSourceIds, sourceId)
        var bodyStart: int32
        var bodyEnd: int32
        fixture.SnapshotBuilderSmokeBodySpan(
            tables, sourceId, bodyStart, bodyEnd)
        add(input.bodyStartBytes, bodyStart)
        add(input.bodyEndBytes, bodyEnd)
        add(input.functionInterfaceCids,
            input.symbolInterfaceCids[functionId])
    var out: incremental.SemanticSnapshotIncrementalPrebuildFacts
    assert(incremental.SemanticSnapshotIncrementalPrebuildFactsMakeInto(
               eventState, input, out, err), err)
    return out

fn ModuleSymbolFind(
        tables: var schema.CsgCompilerSnapshotTables,
        sourceId: int32,
        kind: int32): int32 =
    var out: int32 = -1
    for symbolId in 0..<tables.symbols.symbolCids.len:
        if tables.symbols.sourceIds[symbolId] == sourceId &&
           tables.symbols.symbolKinds[symbolId] == kind:
            assert(out < 0,
                   "module Symbol smoke: duplicate source/kind Symbol")
            out = symbolId
    assert(out >= 0, "module Symbol smoke: source/kind Symbol missing")
    return out

fn ModuleSymbolAssertDebugBindings(
        tables: var schema.CsgCompilerSnapshotTables) =
    for row in 0..<tables.debugOps.symbolIds.len:
        let functionId = tables.debugOps.functionIds[row]
        assert(functionId >= 0 &&
               functionId < tables.functions.symbolIds.len &&
               tables.debugOps.symbolIds[row] ==
                   tables.functions.symbolIds[functionId],
               "module Symbol smoke: DebugOp SymbolId remap drift")

fn ModuleSymbolGraphProject(
        tables: var schema.CsgCompilerSnapshotTables,
        csg: var compiler_csg.CompilerCsg,
        current: incremental.SemanticSnapshotIncrementalPrebuildFacts,
        previous: schema.CsgCompilerSnapshotTables,
        plan: incremental.SemanticSnapshotIncrementalPrebuildPlan,
        err: var str): bool =
    var receipt: builder.CompilerSnapshotGraphProjectionReceipt
    return builder.CompilerSnapshotGraphFactsProduceAndProjectInto(
        tables, csg, previous, current, plan, receipt, err)

fn main() =
    var sidecars: parser_receipt.ParserCanonicalSourceSidecar[]
    var sourceRows: builder.CompilerSnapshotCanonicalSourceRow[]
    var completeTexts: str[]
    var completeSpans: builder.CompilerSnapshotCanonicalSpanInput[]
    var parserTables = ModuleSymbolTables(
        sidecars, sourceRows, completeTexts, completeSpans)
    assert(layout.FixedBytes32Equal(
               parserTables.sources.interfaceCids[0],
               layout.FixedBytes32()) &&
           layout.FixedBytes32Equal(
               parserTables.sources.interfaceCids[1],
               layout.FixedBytes32()),
           "module Symbol smoke: parser skeleton source interface prefilled")
    parserTables.sources.interfaceCids[0] =
        fixture.SnapshotBuilderSmokeCid(11, 1)
    parserTables.sources.interfaceCids[1] =
        fixture.SnapshotBuilderSmokeCid(12, 1)
    var csg: compiler_csg.CompilerCsg
    ModuleSymbolCsg(sidecars, csg)
    let current = ModuleSymbolPrebuildFacts(parserTables, csg)
    var previous: schema.CsgCompilerSnapshotTables
    var plan: incremental.SemanticSnapshotIncrementalPrebuildPlan
    var err: str
    assert(fixture.SnapshotBuilderSmokePreviousPlanInto(
               current, previous, plan, err), err)

    var tables = schema.CsgCompilerSnapshotTablesClone(parserTables)
    assert(ModuleSymbolGraphProject(
               tables, csg, current, previous, plan, err), err)
    assert(tables.symbols.symbolCids.len == 4 &&
           tables.functions.symbolIds.len == 2,
           "module Symbol smoke: Function table is not a Symbol subset")

    let explicitModule =
        ModuleSymbolFind(tables, 0, schema.CsgCompilerSymbolModule)
    let implicitModule =
        ModuleSymbolFind(tables, 1, schema.CsgCompilerSymbolModule)
    var explicitDeclaration: int32 = -1
    for row in 0..<tables.parserSidecars.declarationKinds.len:
        if tables.parserSidecars.declarationKinds[row] ==
               declaration.SemanticSnapshotDeclarationKindModule &&
           tables.parserSidecars.declarationProducerSourceIds[row] == 0:
            assert(explicitDeclaration < 0,
                   "module Symbol smoke: explicit header duplicated")
            explicitDeclaration = row
    assert(explicitDeclaration >= 0 &&
           tables.symbols.nameTokenIds[explicitModule] ==
               tables.parserSidecars.declarationNameTokenIds[
                   explicitDeclaration] &&
           tables.symbols.nameSpanIds[explicitModule] ==
               tables.parserSidecars.declarationNameSpanIds[
                   explicitDeclaration] &&
           tables.symbols.declarationSpanIds[explicitModule] ==
               tables.parserSidecars.declarationSpanIds[
                   explicitDeclaration] &&
           tables.symbols.qualifiedNameTextIds[explicitModule] ==
               tables.sources.modulePathTextIds[0] &&
           tables.symbols.nameSpanIds[implicitModule] == -1 &&
           tables.symbols.nameTokenIds[implicitModule] == -1 &&
           tables.symbols.declarationSpanIds[implicitModule] == -1 &&
           tables.symbols.nameTextIds[implicitModule] ==
               tables.sources.modulePathTextIds[1] &&
           !tables.symbols.exportedFlags[explicitModule] &&
           !tables.symbols.exportedFlags[implicitModule] &&
           tables.symbols.ownerSymbolIds[explicitModule] == -1 &&
           tables.symbols.typeIds[explicitModule] == -1 &&
           tables.symbols.functionIds[explicitModule] == -1 &&
           tables.symbols.ownerSymbolIds[implicitModule] == -1 &&
           tables.symbols.typeIds[implicitModule] == -1 &&
           tables.symbols.functionIds[implicitModule] == -1,
           "module Symbol smoke: explicit/implicit authority drift")
    for functionId in 0..<tables.functions.symbolIds.len:
        let symbolId = tables.functions.symbolIds[functionId]
        let sourceId = tables.symbols.sourceIds[symbolId]
        assert(tables.symbols.symbolKinds[symbolId] ==
                   schema.CsgCompilerSymbolFunction &&
               tables.symbols.ownerSymbolIds[symbolId] ==
                   ModuleSymbolFind(
                       tables, sourceId, schema.CsgCompilerSymbolModule),
               "module Symbol smoke: Function owner is not its Module")
    ModuleSymbolAssertDebugBindings(tables)

    var functionSourceBefore: int32[]
    var functionSpanBefore: int32[]
    var functionQualifiedNameBefore: str[]
    for functionId in 0..<tables.functions.symbolIds.len:
        let symbolId = tables.functions.symbolIds[functionId]
        add(functionSourceBefore, tables.symbols.sourceIds[symbolId])
        add(functionSpanBefore,
            tables.symbols.declarationSpanIds[symbolId])
        add(functionQualifiedNameBefore,
            tables.texts[
                tables.symbols.qualifiedNameTextIds[symbolId]])

    assert(builder.CompilerSnapshotTypeFunctionSignatureTablesProjectInto(
               tables, sidecars, csg, err), err)
    assert(schema.CsgCompilerSnapshotSymbolFunctionTablesStrictValidateInto(
               tables, err), err)
    assert(tables.symbols.symbolCids.len == 4 &&
           tables.functions.symbolIds.len == 2 &&
           tables.declarations.declIds.len == 4,
           "module Symbol smoke: declaration/Symbol coverage mismatch")
    for functionId in 0..<tables.functions.symbolIds.len:
        let symbolId = tables.functions.symbolIds[functionId]
        let sourceId = tables.symbols.sourceIds[symbolId]
        let ownerSymbolId = tables.symbols.ownerSymbolIds[symbolId]
        assert(tables.symbols.symbolKinds[symbolId] ==
                   schema.CsgCompilerSymbolFunction &&
               sourceId == functionSourceBefore[functionId] &&
               tables.symbols.declarationSpanIds[symbolId] ==
                   functionSpanBefore[functionId] &&
               tables.texts[
                   tables.symbols.qualifiedNameTextIds[symbolId]] ==
                   functionQualifiedNameBefore[functionId] &&
               ownerSymbolId ==
                   ModuleSymbolFind(
                       tables, sourceId, schema.CsgCompilerSymbolModule) &&
               tables.symbols.symbolKinds[ownerSymbolId] ==
                   schema.CsgCompilerSymbolModule,
               "module Symbol smoke: canonical Function remap drift")
    for sourceId in 0..<2:
        let moduleSymbol = ModuleSymbolFind(
            tables, sourceId, schema.CsgCompilerSymbolModule)
        let declId = tables.symbols.declIds[moduleSymbol]
        assert(tables.symbols.ownerSymbolIds[moduleSymbol] == -1 &&
               tables.symbols.typeIds[moduleSymbol] == -1 &&
               tables.symbols.functionIds[moduleSymbol] == -1 &&
               declId >= 0 &&
               tables.declarations.declarationKinds[declId] ==
                   declaration.SemanticSnapshotDeclarationKindModule &&
               layout.FixedBytes32Equal(
                   tables.symbols.symbolCids[moduleSymbol],
                   tables.symbols.declKeyCids[moduleSymbol]) &&
               layout.FixedBytes32Equal(
                   tables.symbols.declKeyCids[moduleSymbol],
                   tables.declarations.declKeyCids[declId]),
               "module Symbol smoke: portable Module DeclKey drift")
    ModuleSymbolAssertDebugBindings(tables)
    for readRow in 0..<tables.readSet.targetDomainKinds.len:
        if tables.readSet.targetDomainKinds[readRow] ==
               schema.CsgCompilerReadDomainSymbolInterface:
            var matchedFunction = false
            for functionId in 0..<tables.functions.symbolIds.len:
                if layout.FixedBytes32Equal(
                       tables.readSet.targetPortableKeyCids[readRow],
                       tables.symbols.symbolCids[
                           tables.functions.symbolIds[functionId]]):
                    matchedFunction = true
            assert(matchedFunction,
                   "module Symbol smoke: read Symbol key remap drift")

    var ownerAttack = schema.CsgCompilerSnapshotTablesClone(tables)
    ownerAttack.symbols.ownerSymbolIds[
        ownerAttack.functions.symbolIds[0]] = -1
    assert(!schema.CsgCompilerSnapshotSymbolFunctionTablesStrictValidateInto(
               ownerAttack, err),
           "module Symbol smoke: missing exact Function owner accepted")

    var missingColumn = schema.CsgCompilerSnapshotTablesClone(parserTables)
    setLen(
        missingColumn.parserSidecars.declarationNameTokenIds,
        missingColumn.parserSidecars.declarationNameTokenIds.len - 1)
    assert(!ModuleSymbolGraphProject(
               missingColumn, csg, current, previous, plan, err) &&
           missingColumn.symbols.symbolCids.len == 0,
           "module Symbol smoke: missing declaration column accepted")

    var duplicateHeader = schema.CsgCompilerSnapshotTablesClone(parserTables)
    var secondExplicitRow: int32 = -1
    for row in 0..<duplicateHeader.parserSidecars.declarationKinds.len:
        if duplicateHeader.parserSidecars.declarationProducerSourceIds[row] ==
               0 &&
           duplicateHeader.parserSidecars.declarationKinds[row] ==
               declaration.SemanticSnapshotDeclarationKindFunction:
            secondExplicitRow = row
    assert(secondExplicitRow >= 0,
           "module Symbol smoke: duplicate attack fixture missing")
    duplicateHeader.parserSidecars.declarationKinds[secondExplicitRow] =
        declaration.SemanticSnapshotDeclarationKindModule
    assert(!ModuleSymbolGraphProject(
               duplicateHeader, csg, current, previous, plan, err) &&
           duplicateHeader.symbols.symbolCids.len == 0,
           "module Symbol smoke: duplicate module header accepted")

    var crossSourceToken =
        schema.CsgCompilerSnapshotTablesClone(parserTables)
    var explicitRow: int32 = -1
    var foreignToken: int32 = -1
    for row in 0..<crossSourceToken.parserSidecars.declarationKinds.len:
        if crossSourceToken.parserSidecars.declarationKinds[row] ==
               declaration.SemanticSnapshotDeclarationKindModule:
            explicitRow = row
    for tokenId in 0..<crossSourceToken.tokens.sourceIds.len:
        if crossSourceToken.tokens.sourceIds[tokenId] == 1:
            foreignToken = tokenId
            break
    assert(explicitRow >= 0 && foreignToken >= 0,
           "module Symbol smoke: cross-source attack fixture missing")
    crossSourceToken.parserSidecars.declarationNameTokenIds[explicitRow] =
        foreignToken
    assert(!ModuleSymbolGraphProject(
               crossSourceToken, csg, current, previous, plan, err) &&
           crossSourceToken.symbols.symbolCids.len == 0,
           "module Symbol smoke: cross-source module token accepted")

    var zeroSpan = schema.CsgCompilerSnapshotTablesClone(parserTables)
    let moduleNameSpan =
        zeroSpan.parserSidecars.declarationNameSpanIds[explicitRow]
    zeroSpan.spans.endBytes[moduleNameSpan] =
        zeroSpan.spans.startBytes[moduleNameSpan]
    assert(!ModuleSymbolGraphProject(
               zeroSpan, csg, current, previous, plan, err) &&
           zeroSpan.symbols.symbolCids.len == 0,
           "module Symbol smoke: zero-width module name accepted")

    fixture.SnapshotBuilderSmokeGraphRelease(csg)
    echo("compiler_snapshot_builder_module_symbol_smoke=pass")
