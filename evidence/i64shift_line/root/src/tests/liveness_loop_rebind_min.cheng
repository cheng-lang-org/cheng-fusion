# Min legal shape of ParserValueExprProduceStatementEvents:
# naked locals assigned before while, then rebound across iterations.
fn loopRebind(n: int32): int32 =
    var cursor: int32
    var col: int32
    var acc: int32
    cursor = 0
    col = -1
    acc = 0
    while cursor < n:
        let lineCol = cursor - (cursor / 5) * 5
        if col >= 0:
            if lineCol <= col:
                col = -1
        if cursor - (cursor / 3) * 3 == 0:
            col = lineCol
            acc = acc + 1
        cursor = cursor + 1
    return acc + col

fn main(): int32 =
    return loopRebind(20)
