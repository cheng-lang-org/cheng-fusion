# committee_vote smoke: sortition determinism, stake-weighted selection,
# ranking, proposal voting tally with quorum, non-member rejection.

import std/os
import std/system
import std/rawbytes
import std/strutils as strutil
import cheng/std/bytes_layout as layout
import cheng/chain/committee_vote as cvt

fn CidFromByteTag(b: int32): layout.FixedBytes32 =
    var raw = BytesAlloc(32)
    BytesSet(raw, 0, b)
    let res = layout.FixedBytes32FromBytes(raw)
    return res.value

@borrows
fn CloneOwnedBytes(src: Bytes): Bytes =
    var out = BytesAlloc(src.len)
    var k: int32
    while k < src.len:
        BytesSet(out, k, BytesGet(src, k))
        k = k + 1
    return out

fn main(): int32 =
    var rc: int32 = 0
    let epoch: int32 = 7
    let round: int32 = 3

    # four validators with distinct seeds; stakes 40/30/20/10 of total 100.
    # keys are derived inside CommitteeDraw so priv64/pubkey always match.
    let sk0 = BytesFromHex("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
    let sk1 = BytesFromHex("4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb")
    let sk2 = BytesFromHex("c5aa8df43f9f837bedb7442f31dcb7b166d38535076f094b85ce3a2e0b4458f7")
    let sk3 = BytesFromHex("3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c")

    var m0res = cvt.CommitteeDraw(sk0, 40, 100, epoch, round)
    var m1res = cvt.CommitteeDraw(sk1, 30, 100, epoch, round)
    var m2res = cvt.CommitteeDraw(sk2, 20, 100, epoch, round)
    var m3res = cvt.CommitteeDraw(sk3, 10, 100, epoch, round)
    if !m0res.ok or !m1res.ok or !m2res.ok or !m3res.ok:
        os.WriteLine(os.Get_stderr(), "draw failed")
        return 1

    # determinism: same inputs -> identical ticket hash and selection
    var m0again = cvt.CommitteeDraw(sk0, 40, 100, epoch, round)
    if !m0again.ok:
        os.WriteLine(os.Get_stderr(), "redraw failed")
        rc = rc + 1
    else:
        if !layout.FixedBytes32Equal(m0res.value.ticket.vrfHash,
                                     m0again.value.ticket.vrfHash):
            os.WriteLine(os.Get_stderr(), "sortition not deterministic")
            rc = rc + 1
        if m0res.value.ticket.selected != m0again.value.ticket.selected:
            os.WriteLine(os.Get_stderr(), "selection not deterministic")
            rc = rc + 1

    # different round -> different ticket (collision chance ~2^-256)
    var otherRound = cvt.CommitteeDraw(sk0, 40, 100, epoch, 4)
    if otherRound.ok:
        if layout.FixedBytes32Equal(otherRound.value.ticket.vrfHash,
                                    m0res.value.ticket.vrfHash):
            os.WriteLine(os.Get_stderr(), "round change did not change ticket")
            rc = rc + 1

    # zero stake can never be selected
    var zeroStake = cvt.CommitteeDraw(sk2, 0, 100, epoch, round)
    if !zeroStake.ok:
        os.WriteLine(os.Get_stderr(), "zero-stake draw errored")
        rc = rc + 1
    else:
        if zeroStake.value.ticket.selected:
            os.WriteLine(os.Get_stderr(), "zero stake was selected")
            rc = rc + 1

    # full stake must always be selected (threshold = MaxI64 > any ticket)
    var fullStake = cvt.CommitteeDraw(sk2, 100, 100, epoch, round)
    if !fullStake.ok:
        os.WriteLine(os.Get_stderr(), "full-stake draw errored")
        rc = rc + 1
    else:
        if !fullStake.value.ticket.selected:
            os.WriteLine(os.Get_stderr(), "full stake was not selected")
            rc = rc + 1

    # invalid total stake rejected loudly
    var badStake = cvt.CommitteeDraw(sk2, 10, 0, epoch, round)
    if badStake.ok:
        os.WriteLine(os.Get_stderr(), "total stake 0 accepted")
        rc = rc + 1

    # --- committee assembly and ranking ---
    var members: cvt.CommitteeMember[]
    add(members, m0res.value)
    add(members, m1res.value)
    add(members, m2res.value)
    add(members, m3res.value)
    var selectedMembers: cvt.CommitteeMember[]
    let rankRc: int32 = cvt.CommitteeRankSelected(members, 4, selectedMembers)
    if rankRc != 0:
        os.WriteLine(os.Get_stderr(), "rank errored")
        rc = rc + 1
    if selectedMembers.len < 1:
        os.WriteLine(os.Get_stderr(), "no committee members selected")
        rc = rc + 1

    # leader determinism: re-rank from an independent copy gives same head
    # CommitteeDraw is deterministic in (sk, stake, epoch, round): re-draw to
    # obtain an independent owned copy instead of re-consuming moved values.
    var m0b = cvt.CommitteeDraw(sk0, 40, 100, epoch, round)
    var m1b = cvt.CommitteeDraw(sk1, 30, 100, epoch, round)
    var m2b = cvt.CommitteeDraw(sk2, 20, 100, epoch, round)
    var m3b = cvt.CommitteeDraw(sk3, 10, 100, epoch, round)
    var membersCopy: cvt.CommitteeMember[]
    add(membersCopy, m0b.value)
    add(membersCopy, m1b.value)
    add(membersCopy, m2b.value)
    add(membersCopy, m3b.value)
    var selectedAgain: cvt.CommitteeMember[]
    let rankRc2: int32 = cvt.CommitteeRankSelected(membersCopy, 4, selectedAgain)
    if rankRc2 != 0:
        os.WriteLine(os.Get_stderr(), "re-rank errored")
        rc = rc + 1
    if selectedMembers.len > 0 and selectedAgain.len > 0:
        if !layout.FixedBytes32Equal(selectedMembers[0].ticket.vrfHash,
                                     selectedAgain[0].ticket.vrfHash):
            os.WriteLine(os.Get_stderr(), "leader unstable across re-rank")
            rc = rc + 1

    # --- proposal voting: quorum 2f+1 with f=1 over N=4 ---
    let proposal = CidFromByteTag(77)
    var votes: cvt.SignedVote[]
    var i: int32
    while i < selectedMembers.len:
        let vres = cvt.CommitteeSignVote(selectedMembers[i], proposal)
        if vres.ok:
            add(votes, vres.value)
        i = i + 1

    var pks: Bytes[]
    i = 0
    while i < selectedMembers.len:
        # element pk was moved into its SignedVote; extract an independent copy
        add(pks, CloneOwnedBytes(selectedMembers[i].pk))
        i = i + 1

    # every selected member must have produced a countable vote
    if votes.len != selectedMembers.len:
        os.WriteLine(os.Get_stderr(), "some committee votes failed to sign")
        rc = rc + 1

    # sortition is probabilistic at small N: quorum follows the actual
    # committee size (f = (n-1)/3), never a fixed constant.
    let dynF: int32 = (selectedMembers.len - 1) / 3
    let fullTally: int32 = cvt.CommitteeTally(votes, pks, proposal)
    if fullTally != votes.len:
        os.WriteLine(os.Get_stderr(), strutil.Join(["tally lost valid votes, tally=", IntToStr(fullTally)], ""))
        rc = rc + 1
    if !cvt.CommitteeQuorumReached(fullTally, dynF):
        os.WriteLine(os.Get_stderr(), strutil.Join(["quorum not reached, tally=", IntToStr(fullTally)], ""))
        rc = rc + 1

    # wrong proposal hash -> zero valid votes
    let otherProposal = CidFromByteTag(78)
    let wrongTally: int32 = cvt.CommitteeTally(votes, pks, otherProposal)
    if wrongTally != 0:
        os.WriteLine(os.Get_stderr(), "wrong proposal counted votes")
        rc = rc + 1

    # non-member vote must not change the tally
    let outsiderSk = BytesFromHex("d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a")
    let outsider = cvt.CommitteeDraw(outsiderSk, 5, 100, epoch, round)
    if outsider.ok:
        let ovRes = cvt.CommitteeSignVote(outsider.value, proposal)
        if ovRes.ok:
            add(votes, ovRes.value)
            let stillTally: int32 = cvt.CommitteeTally(votes, pks, proposal)
            if stillTally != fullTally:
                os.WriteLine(os.Get_stderr(), "outsider vote was counted")
                rc = rc + 1

    if rc == 0:
        echo("committee_vote_smoke ok")
    return rc
