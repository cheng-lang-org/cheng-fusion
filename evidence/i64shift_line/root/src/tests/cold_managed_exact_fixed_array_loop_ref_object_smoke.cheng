import std/system as system

type
    ColdManagedExactFixedArrayLoopRefLeaf = ref object
        label: str

    ColdManagedExactFixedArrayLoopRefOwner =
        leaves: ColdManagedExactFixedArrayLoopRefLeaf[2]

fn ColdManagedExactFixedArrayLoopRefNew(
    value: str
): ColdManagedExactFixedArrayLoopRefLeaf =
    var leaf = new(ColdManagedExactFixedArrayLoopRefLeaf)
    leaf.label = system.NewStringCopy(
        system.StrDataPtr(value), value.len)
    return leaf

fn ColdManagedExactFixedArrayLoopRefExercise(): int32 =
    var owner: ColdManagedExactFixedArrayLoopRefOwner
    for step in 0..<3:
        if step == 0:
            if owner.leaves[0] != nil || owner.leaves[1] != nil:
                return 1
        elif step == 1:
            if owner.leaves[0] == nil ||
               owner.leaves[0].label != "ref-loop-0":
                return 2
        else:
            if owner.leaves[0] == nil ||
               owner.leaves[0].label != "ref-loop-1":
                return 3

        if step == 0:
            owner.leaves[0] = ColdManagedExactFixedArrayLoopRefNew("ref-loop-0")
        elif step == 1:
            owner.leaves[0] = ColdManagedExactFixedArrayLoopRefNew("ref-loop-1")
        else:
            owner.leaves[0] = ColdManagedExactFixedArrayLoopRefNew("ref-loop-2")
        owner.leaves[0] = owner.leaves[0]
        owner.leaves[1] = ColdManagedExactFixedArrayLoopRefNew("ref-clear")
        owner.leaves[1] = nil

    if owner.leaves[0] == nil ||
       owner.leaves[0].label != "ref-loop-2" ||
       owner.leaves[1] != nil:
        return 4
    return 0

fn main(): int32 =
    let allocBefore = system.memAllocCount()
    let freeBefore = system.memFreeCount()
    let liveBefore = system.memLiveCount()
    let retainBefore = system.memRetainCount()
    let releaseBefore = system.memReleaseCount()

    if ColdManagedExactFixedArrayLoopRefExercise() != 0:
        return 1

    let allocDelta = system.memAllocCount() - allocBefore
    let freeDelta = system.memFreeCount() - freeBefore
    let liveDelta = system.memLiveCount() - liveBefore
    let retainDelta = system.memRetainCount() - retainBefore
    let releaseDelta = system.memReleaseCount() - releaseBefore
    if allocDelta != int64(12) || allocDelta != freeDelta:
        return 2
    if liveDelta != int64(0):
        return 3
    if retainDelta != int64(3):
        return 4
    if releaseDelta != int64(15):
        return 5
    if releaseDelta != retainDelta + freeDelta:
        return 6

    echo(Fmt"cold_managed_exact_fixed_array_loop_ref_object_alloc_delta={allocDelta}")
    echo(Fmt"cold_managed_exact_fixed_array_loop_ref_object_free_delta={freeDelta}")
    echo(Fmt"cold_managed_exact_fixed_array_loop_ref_object_live_delta={liveDelta}")
    echo(Fmt"cold_managed_exact_fixed_array_loop_ref_object_retain_delta={retainDelta}")
    echo(Fmt"cold_managed_exact_fixed_array_loop_ref_object_release_delta={releaseDelta}")
    echo("cold_managed_exact_fixed_array_loop_ref_object=PASS")
    return 0
