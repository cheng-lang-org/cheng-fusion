import std/system
import std/strings as strings
import cheng/apps/astrology/astrology_archive_guide_core as archive

# 忠实移植 PWA buildAstrologyDailyGuideFromRuntime 的 smoke。
# 三组期望 JSON 已与 PWA (真 wasm scalar + 真 TS calculateBaziChart/calculateZiweiChart/
# deriveZiweiScore/reference builders) 逐字段对拍全等 (lunar/时柱另与 lunar-javascript 对齐)。

fn runGuide(y: int32, m: int32, d: int32, hh: int32, mm: int32,
            gender: str, tz: str, lonMilli: int32, hasLon: bool,
            trueSolar: bool, lateZi: str, nowSeconds: int32,
            out: var str): bool =
    let nowMs: int64 = Int64(nowSeconds) * Int64(1000)
    return archive.AstrologyArchiveDailyGuideJson(y, m, d, hh, mm, gender, tz, lonMilli, hasLon, trueSolar, lateZi, nowMs, out)

fn main(): int32 =
    # Vector A: bazi 型出生输入, Asia/Shanghai, 常规
    var jsonA: str
    let okA = runGuide(1990, 6, 15, 8, 30, "男", "Asia/Shanghai", 0, false, false, "00:00", 1751702400, jsonA)
    assert(okA, " archive guide A: should succeed")
    assert(jsonA == "{\"generatedAt\":1751702400000,\"currentSolar\":{\"year\":2025,\"month\":7,\"day\":5,\"hour\":16,\"minute\":0},\"currentLunar\":{\"year\":2025,\"month\":6,\"day\":11,\"leap\":false,\"monthText\":\"六\",\"dayText\":\"十一\"},\"yearGanzhiText\":\"乙巳\",\"monthGanzhiText\":\"壬午\",\"dayGanzhiText\":\"乙亥\",\"hourGanzhiText\":\"甲申\",\"hexagramIndex\":63,\"hexagramName\":\"乾\",\"upperTrigramIndex\":7,\"upperTrigramName\":\"乾\",\"lowerTrigramIndex\":7,\"lowerTrigramName\":\"乾\",\"movingLine\":6,\"changedHexagramIndex\":31,\"changedHexagramName\":\"夬\",\"actionCode\":\"外放推进\",\"bitPattern\":\"111111\",\"summary\":\"元亨利贞。\",\"calendarReference\":\"万年历参考：年柱乙巳主外部背景，月柱壬午主当月节令，日柱乙亥主当天触发，今天先看日柱，再看月柱。\",\"baziReference\":\"八字参考：日主辛。年柱乙巳耗制，整体偏耗；月柱壬午泄气，整体明显克泄；日柱乙亥耗制，整体偏耗；整体压制明显，宜先收口。\",\"ziweiReference\":\"紫微参考：年柱乙巳把重心牵到事业，巳过宫牵引命宫；月柱壬午把重心牵到健康，午三合引动身宫；日柱乙亥把重心落到事业，亥过宫牵引命宫；今天先看日柱触发，再看月柱延续。\"}",
        " archive guide A: JSON must match PWA byte-for-byte")

    # Vector B: ziwei 型出生输入, Asia/Tokyo (非上海时区偏移表), 女
    var jsonB: str
    let okB = runGuide(1985, 11, 20, 14, 45, "女", "Asia/Tokyo", 0, false, false, "00:00", 1751760000, jsonB)
    assert(okB, " archive guide B: should succeed")
    assert(jsonB == "{\"generatedAt\":1751760000000,\"currentSolar\":{\"year\":2025,\"month\":7,\"day\":6,\"hour\":9,\"minute\":0},\"currentLunar\":{\"year\":2025,\"month\":6,\"day\":12,\"leap\":false,\"monthText\":\"六\",\"dayText\":\"十二\"},\"yearGanzhiText\":\"乙巳\",\"monthGanzhiText\":\"壬午\",\"dayGanzhiText\":\"丙子\",\"hourGanzhiText\":\"癸巳\",\"hexagramIndex\":27,\"hexagramName\":\"兑\",\"upperTrigramIndex\":3,\"upperTrigramName\":\"兑\",\"lowerTrigramIndex\":3,\"lowerTrigramName\":\"兑\",\"movingLine\":5,\"changedHexagramIndex\":11,\"changedHexagramName\":\"归妹\",\"actionCode\":\"内收校准\",\"bitPattern\":\"110110\",\"summary\":\"亨，利贞。\",\"calendarReference\":\"万年历参考：年柱乙巳主外部背景，月柱壬午主当月节令，日柱丙子主当天触发，今天先看日柱，再看月柱。\",\"baziReference\":\"八字参考：日主癸。年柱乙巳泄气，整体偏耗；月柱壬午同气，整体偏扶；日柱丙子耗制，整体偏扶；整体可推，但先顺时序。\",\"ziweiReference\":\"紫微参考：年柱乙巳把重心牵到事业，巳邻位牵动命宫；月柱壬午把重心牵到健康，午直临身宫；日柱丙子把重心落到关系，子三合引动命宫；今天先看日柱触发，再看月柱延续。\"}",
        " archive guide B: JSON must match PWA byte-for-byte")

    # Vector C: 晚子跨日 (出生 23:30 + lateZi 23:00) + 真太阳时, Asia/Shanghai
    var jsonC: str
    let okC = runGuide(2000, 3, 10, 23, 30, "男", "Asia/Shanghai", 0, false, true, "23:00", 1735900200, jsonC)
    assert(okC, " archive guide C: should succeed")
    assert(jsonC == "{\"generatedAt\":1735900200000,\"currentSolar\":{\"year\":2025,\"month\":1,\"day\":3,\"hour\":18,\"minute\":30},\"currentLunar\":{\"year\":2024,\"month\":12,\"day\":4,\"leap\":false,\"monthText\":\"腊\",\"dayText\":\"初四\"},\"yearGanzhiText\":\"甲辰\",\"monthGanzhiText\":\"丙子\",\"dayGanzhiText\":\"壬申\",\"hourGanzhiText\":\"己酉\",\"hexagramIndex\":29,\"hexagramName\":\"革\",\"upperTrigramIndex\":3,\"upperTrigramName\":\"兑\",\"lowerTrigramIndex\":5,\"lowerTrigramName\":\"离\",\"movingLine\":4,\"changedHexagramIndex\":21,\"changedHexagramName\":\"既济\",\"actionCode\":\"内收校准\",\"bitPattern\":\"101110\",\"summary\":\"己日乃孚，元亨利贞，悔亡。\",\"calendarReference\":\"万年历参考：年柱甲辰主外部背景，月柱丙子主当月节令，日柱壬申主当天触发，今天先看日柱，再看月柱。\",\"baziReference\":\"八字参考：日主戊。年柱甲辰克压，整体偏耗；月柱丙子生扶，整体偏扶；日柱壬申耗制，整体偏耗；整体平平，按轻重缓急处理。\",\"ziweiReference\":\"紫微参考：年柱甲辰把重心牵到事业，辰邻位牵动命宫；月柱丙子把重心牵到关系，子过宫牵引身宫；日柱壬申把重心落到关系，申过宫牵引命宫；今天先看日柱触发，再看月柱延续。\"}",
        " archive guide C: JSON must match PWA byte-for-byte")

    # 诚实失败: 未知时区 (America/New_York 含 DST, 不在恒定偏移表) 必须返回 false, 不得默默当上海
    var jsonD: str
    let okD = runGuide(1978, 1, 5, 2, 15, "女", "America/New_York", 0, false, false, "00:00", 1751760000, jsonD)
    assert(!okD, " archive guide D: unknown DST timezone must fail honestly")

    # 诚实失败: 非法性别
    var jsonE: str
    let okE = runGuide(1990, 6, 15, 8, 30, "x", "Asia/Shanghai", 0, false, false, "00:00", 1751702400, jsonE)
    assert(!okE, " archive guide E: invalid gender must fail")

    # 诚实失败: 非法 lateZiBoundary
    var jsonF: str
    let okF = runGuide(1990, 6, 15, 8, 30, "男", "Asia/Shanghai", 0, false, false, "12:00", 1751702400, jsonF)
    assert(!okF, " archive guide F: invalid lateZiBoundary must fail")

    echo(" astrology_archive_guide_smoke ok")
    return 0
