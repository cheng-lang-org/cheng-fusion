import std/json

fn main() =
    var nested = json.NewJString("leaf")
    for depth in 0..<258:
        var parent: json.JsonNode
        parent.kind = json.JObject
        parent.okeys = ["next"]
        parent.ovalues = [nested]
        nested = parent
    var root: json.JsonNode
    root.kind = json.JObject
    root.okeys = ["value"]
    root.ovalues = [nested]
    let forbidden = json.JsonGetField(root, "value")
    assert(forbidden.kind == json.JNull,
           "json owned value: depth overflow returned")
