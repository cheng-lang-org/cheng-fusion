import std/os
import cheng/std/bytes_layout as layout
import cheng/core/csg_core/compiler_snapshot_schema as schema
import cheng/core/csg_core/compiler_snapshot_cargo as cargo
import cheng/core/tooling/compiler_world
import cheng/core/tooling/semantic_snapshot as snapshot
import cheng/core/tooling/semantic_snapshot_declaration_identity as declaration
import cheng/core/tooling/semantic_snapshot_incremental_plan as incremental

fn ExactCid(seed: int32): layout.FixedBytes32 =
    var out: layout.FixedBytes32
    out.data[0] = uint8(seed)
    return out

fn DocumentCid(modulePath: str): layout.FixedBytes32 =
    var out: layout.FixedBytes32
    var err: str
    assert(compiler_world.CompilerWorldDocumentCidInto(
               "pkg", modulePath, out, err), err)
    return out

fn CidLess(left: layout.FixedBytes32,
           right: layout.FixedBytes32): bool =
    for index in 0..<layout.FixedBytes32Size:
        if left.data[index] < right.data[index]:
            return true
        if left.data[index] > right.data[index]:
            return false
    return false

fn ProducerFactKindForDomain(domainKind: int32): int32 =
    if domainKind == schema.CsgCompilerReadDomainSourceInterface:
        return incremental.SemanticSnapshotIncrementalProducerFactSourceInterface
    if domainKind == schema.CsgCompilerReadDomainSymbolInterface:
        return incremental.SemanticSnapshotIncrementalProducerFactResolvedCall
    if domainKind == schema.CsgCompilerReadDomainTypeIdentity:
        return incremental.SemanticSnapshotIncrementalProducerFactTypeIdentity
    if domainKind == schema.CsgCompilerReadDomainLayout:
        return incremental.SemanticSnapshotIncrementalProducerFactLayout
    assert(false, " incremental read producer: unsupported test domain")
    return -1

fn BuildRebuildReadProducer(
        current: incremental.SemanticSnapshotIncrementalPrebuildFacts,
        plan: incremental.SemanticSnapshotIncrementalPrebuildPlan,
        producerFactsRootCid: layout.FixedBytes32,
        functionIds: int32[],
        readStarts: int32[],
        readCounts: int32[],
        targetDomainKinds: int32[],
        targetPortableKeyCids: layout.FixedBytes32[],
        observedValueCids: layout.FixedBytes32[]):
        incremental.SemanticSnapshotIncrementalRebuildReadInput =
    assert(functionIds.len == readStarts.len &&
           functionIds.len == readCounts.len &&
           targetDomainKinds.len == targetPortableKeyCids.len &&
           targetDomainKinds.len == observedValueCids.len,
           " incremental read producer: invalid test input")
    var out: incremental.SemanticSnapshotIncrementalRebuildReadInput
    var err: str
    assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerInitInto(
               current, plan, producerFactsRootCid,
               targetDomainKinds.len, out, err), err)
    for invocationIndex in 0..<functionIds.len:
        let functionId = functionIds[invocationIndex]
        let start = readStarts[invocationIndex]
        let count = readCounts[invocationIndex]
        assert(start >= 0 && count >= 0 &&
               start <= targetDomainKinds.len &&
               count <= targetDomainKinds.len - start,
               " incremental read producer: invalid test range")
        assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerBeginFunctionInto(
                   current, plan, out, functionId, count, err), err)
        for offset in 0..<count:
            let row = start + offset
            var readRow: int32
            assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerAppendReadInto(
                       current, plan, out, functionId,
                       targetDomainKinds[row],
                       targetPortableKeyCids[row],
                       observedValueCids[row], readRow, err), err)
            assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerAppendCompilerFactInto(
                       current, plan, out, functionId, readRow,
                       ProducerFactKindForDomain(targetDomainKinds[row]),
                       current.functionSourceIds[functionId],
                       current.functionSourceIds[functionId],
                       row, 100 + row, err), err)
        assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerEndFunctionInto(
                   current, plan, out, functionId, err), err)
    assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerSealInto(
               current, plan, out, err), err)
    assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerStrictValidateInto(
               current, plan, out, err), err)
    return out

fn PreviousSource0(): str =
    return "aaaaBBBBccccDDDD"

fn CurrentSource0(): str =
    return PreviousSource0()

fn Source1(): str =
    return "EEEEffffGGGGhhhh"

fn CurrentSource1(): str =
    return "EEEEffffzzzzhhhh"

fn AppendBodyCid(out: var schema.CsgCompilerFunctionTable,
                 documentCid: layout.FixedBytes32,
                 sourceText: str,
                 startByte: int32,
                 endByte: int32) =
    var cid: layout.FixedBytes32
    var err: str
    assert(schema.CsgCompilerFunctionBodyContentCidInto(
               documentCid, sourceText, startByte, endByte, cid, err), err)
    add(out.bodyContentCids, cid)

fn BuildPreviousTables(): schema.CsgCompilerSnapshotTables =
    var out: schema.CsgCompilerSnapshotTables
    out.schemaVersion = schema.CsgCompilerSnapshotSchemaVersionLatest
    out.semanticEpoch = 4
    out.predecessorReceiptCid = ExactCid(3)
    out.texts = ["F0", "F1", "F2", "F3", "int32", "pkg/a",
                 "pkg/a::F2", "pkg/a::F3", "pkg/b", "pkg/b::F0",
                 "pkg/b::F1"]

    out.sources.documentCids = [
        DocumentCid("pkg/b"), DocumentCid("pkg/a")]
    out.sources.modulePathTextIds = [8, 5]
    out.sources.contentCids = [
        schema.CsgCompilerSourceContentCid(PreviousSource0()),
        schema.CsgCompilerSourceContentCid(Source1())]
    out.sources.interfaceCids = [ExactCid(20), ExactCid(21)]

    out.spans.sourceIds = [0, 0, 1, 1]
    out.spans.startBytes = [0, 8, 0, 8]
    out.spans.endBytes = [4, 12, 4, 12]
    out.spans.startLines = [0, 1, 0, 1]
    out.spans.startColumns = [0, 0, 0, 0]
    out.spans.endLines = [0, 1, 0, 1]
    out.spans.endColumns = [4, 4, 4, 4]

    out.parserNodes.sourceIds = [0, 1]
    out.parserNodes.producerNodeIds = [0, 0]
    out.parserNodes.parentNodeIds = [-1, -1]
    out.parserNodes.kinds = [1, 1]
    out.parserNodes.spanIds = [0, 2]
    out.parserNodes.childStarts = [0, 0]
    out.parserNodes.childCounts = [0, 0]
    out.parserNodes.genericStarts = [0, 0]
    out.parserNodes.genericCounts = [0, 0]
    out.parserNodes.bindingResolutionKinds = [0, 0]
    out.parserNodes.bindingDeclarationSourceLocalRows = [-1, -1]
    out.parserNodes.bindingPatternSourceLocalRows = [-1, -1]
    out.tokens.sourceIds = [0, 0, 1, 1]
    out.tokens.sourceLocalRows = [0, 1, 0, 1]
    out.tokens.lexicalParentTokenIds = [-1, -1, -1, -1]
    out.tokens.spanIds = [0, 1, 2, 3]
    out.tokens.kinds = [1, 1, 1, 1]
    out.tokens.valueTextIds = [0, 1, 2, 3]
    out.parserSidecars.sourceIds = [0, 1]
    out.parserSidecars.producerSourceIndexes = [0, 1]
    out.parserSidecars.parserInputCids = [ExactCid(70), ExactCid(71)]
    out.parserSidecars.sidecarCids = [ExactCid(72), ExactCid(73)]
    out.parserSidecars.declarationLexicalScopeProducerSourceIds = [0, 1]
    out.parserSidecars.declarationLexicalScopeSourceLocalRows = [0, 0]
    out.parserSidecars.declarationLexicalScopeKinds = [1, 1]
    out.parserSidecars.declarationLexicalScopeParentIds = [-1, -1]
    out.parserSidecars.declarationLexicalScopeOwnerDeclarationIds = [-1, -1]
    out.parserSidecars.declarationProducerSourceIds = [0, 0, 1, 1]
    out.parserSidecars.declarationSourceLocalRows = [0, 1, 0, 1]
    out.parserSidecars.declarationKinds = [3, 3, 3, 3]
    out.parserSidecars.declarationNameTokenIds = [0, 1, 2, 3]
    out.parserSidecars.declarationOwnerIds = [-1, -1, -1, -1]
    out.parserSidecars.declarationLexicalScopeIds = [0, 0, 1, 1]
    out.parserSidecars.declarationFunctionRows = [0, 1, 2, 3]
    out.parserSidecars.declarationTypeSyntaxRootIds = [-1, -1, -1, -1]
    out.parserSidecars.declarationDefaultStatementRootRows =
        [-1, -1, -1, -1]
    out.parserSidecars.declarationSpanIds = [0, 1, 2, 3]
    out.parserSidecars.declarationNameSpanIds = [0, 1, 2, 3]
    out.parserSidecars.declarationMutableFlags = [false, false, false, false]
    out.parserSidecars.declarationExportedFlags = [true, true, true, true]
    out.parserSidecars.rootNodeIds = [0, 1]
    out.parserSidecars.functionIndexes = [0, 1, 2, 3]
    out.parserSidecars.functionNameTextIds = [0, 1, 2, 3]
    out.parserSidecars.functionNameSurfaceKinds = [
        declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
        declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
        declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
        declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier]
    out.parserSidecars.functionNameProofCids = [
        ExactCid(120), ExactCid(121), ExactCid(122), ExactCid(123)]
    out.parserSidecars.functionSignatureLineNumbers = [1, 2, 1, 2]
    out.parserSidecars.functionDeclarationSpanIds = [0, 1, 2, 3]
    out.parserSidecars.functionDeclarationHeaderCids = [
        ExactCid(100), ExactCid(101), ExactCid(102), ExactCid(103)]
    out.parserSidecars.functionDeclarationPathCids = [
        ExactCid(110), ExactCid(111), ExactCid(112), ExactCid(113)]
    out.parserSidecars.functionNameSpanIds = [0, 1, 2, 3]
    out.parserSidecars.functionBodySpanIds = [0, 1, 2, 3]
    for functionIndex in 0..<4:
        add(out.parserSidecars.functionAnnotationFlags, 0)

    out.types.typeCids = [layout.FixedBytes32(), layout.FixedBytes32()]
    out.types.producerTypeArenaIds = [0, -1]
    out.types.canonicalTextIds = [4, 4]
    out.types.typeKinds = [schema.CsgCompilerTypeScalar,
                           schema.CsgCompilerTypeFunction]
    out.types.scalarKinds = [schema.CsgCompilerScalarInt32, 0]
    out.types.declSymbolIds = [-1, -1]
    out.types.elementTypeIds = [-1, 0]
    out.types.arrayLengths = [-1, -1]
    out.types.argStarts = [0, 0]
    out.types.argCounts = [0, 0]
    out.types.constArgStarts = [0, 0]
    out.types.constArgCounts = [0, 0]
    out.types.aliasTargetTypeIds = [-1, -1]
    out.types.genericParameterParserRows = [-1, -1]
    add(out.types.managedFlags, false)
    add(out.types.managedFlags, false)
    add(out.types.sendFlags, true)
    add(out.types.sendFlags, false)
    add(out.types.syncFlags, true)
    add(out.types.syncFlags, false)
    out.types.traitConclusionKinds = [
        schema.CsgCompilerTraitConclusionExact,
        schema.CsgCompilerTraitConclusionNone]
    out.types.traitProofKinds = [schema.CsgCompilerTraitProofBuiltin,
                                 schema.CsgCompilerTraitProofStructural]
    out.types.traitProofCids = [layout.FixedBytes32(),
                                layout.FixedBytes32()]
    out.types.traitPremiseStarts = [0, 0]
    out.types.traitPremiseCounts = [0, 1]
    out.types.traitPremiseTypeIds = [0]
    # [phaseB-enum-schema] Zero enum variant payload rows in this fixture.
    out.types.variantStarts = [0, 0]
    out.types.variantCounts = [0, 0]
    var typeErr: str
    assert(schema.CsgCompilerTypeTraitProofCidInto(
               out, 0, out.types.traitProofCids[0], typeErr), typeErr)
    assert(schema.CsgCompilerTypeRowCidInto(
               out, 0, out.types.typeCids[0], typeErr), typeErr)
    assert(schema.CsgCompilerTypeTraitProofCidInto(
               out, 1, out.types.traitProofCids[1], typeErr), typeErr)
    assert(schema.CsgCompilerTypeRowCidInto(
               out, 1, out.types.typeCids[1], typeErr), typeErr)
    var functionTypeId: int32 = 1
    var scalarTypeId: int32 = 0
    if CidLess(out.types.typeCids[1], out.types.typeCids[0]):
        let scalarCid = out.types.typeCids[0]
        let functionCid = out.types.typeCids[1]
        let scalarProofCid = out.types.traitProofCids[0]
        let functionProofCid = out.types.traitProofCids[1]
        out.types.typeCids = [functionCid, scalarCid]
        out.types.producerTypeArenaIds = [-1, 0]
        out.types.canonicalTextIds = [4, 4]
        out.types.typeKinds = [schema.CsgCompilerTypeFunction,
                               schema.CsgCompilerTypeScalar]
        out.types.scalarKinds = [0, schema.CsgCompilerScalarInt32]
        out.types.declSymbolIds = [-1, -1]
        out.types.elementTypeIds = [1, -1]
        out.types.arrayLengths = [-1, -1]
        out.types.argStarts = [0, 0]
        out.types.argCounts = [0, 0]
        out.types.constArgStarts = [0, 0]
        out.types.constArgCounts = [0, 0]
        out.types.aliasTargetTypeIds = [-1, -1]
        out.types.genericParameterParserRows = [-1, -1]
        out.types.sendFlags[0] = false
        out.types.sendFlags[1] = true
        out.types.syncFlags[0] = false
        out.types.syncFlags[1] = true
        out.types.traitConclusionKinds = [
            schema.CsgCompilerTraitConclusionNone,
            schema.CsgCompilerTraitConclusionExact]
        out.types.traitProofKinds = [
            schema.CsgCompilerTraitProofStructural,
            schema.CsgCompilerTraitProofBuiltin]
        out.types.traitProofCids = [functionProofCid, scalarProofCid]
        out.types.traitPremiseStarts = [0, 1]
        out.types.traitPremiseCounts = [1, 0]
        out.types.traitPremiseTypeIds = [1]
        # [phaseB-enum-schema] Zero enum variant payload rows here too.
        out.types.variantStarts = [0, 0]
        out.types.variantCounts = [0, 0]
        functionTypeId = 0
        scalarTypeId = 1

    # Build the current portable declaration authority first.  Function
    # Symbol identity is the declaration key; header/path receipts remain
    # diagnostics and never substitute for that key.
    var declarationStore: declaration.SemanticSnapshotDeclarationCandidateStore
    declaration.SemanticSnapshotDeclarationCandidateStoreInitInto(
        declarationStore)
    var moduleCandidates: int32[]
    var candidateIndex: int32
    var declarationErr: str
    assert(declaration.SemanticSnapshotDeclarationCandidateAppendInto(
               declarationStore, "pkg", "pkg/b", DocumentCid("pkg/b"), "", -1,
               declaration.SemanticSnapshotDeclarationKindModule,
               declaration.SemanticSnapshotDeclarationNameSurfaceModulePath,
               "pkg/b", DocumentCid("pkg/b"), DocumentCid("pkg/b"),
               layout.FixedBytes32(), 0, 0,
               candidateIndex, declarationErr), declarationErr)
    add(moduleCandidates, candidateIndex)
    assert(declaration.SemanticSnapshotDeclarationCandidateAppendInto(
               declarationStore, "pkg", "pkg/a", DocumentCid("pkg/a"), "", -1,
               declaration.SemanticSnapshotDeclarationKindModule,
               declaration.SemanticSnapshotDeclarationNameSurfaceModulePath,
               "pkg/a", DocumentCid("pkg/a"), DocumentCid("pkg/a"),
               layout.FixedBytes32(), 0, 0,
               candidateIndex, declarationErr), declarationErr)
    add(moduleCandidates, candidateIndex)
    var functionCandidates: int32[]
    let functionNames = ["F0", "F1", "F2", "F3"]
    let functionSourceIds = [0, 0, 1, 1]
    let functionStarts = [0, 8, 0, 8]
    let functionEnds = [4, 12, 4, 12]
    for functionId in 0..<4:
        let sourceId = functionSourceIds[functionId]
        assert(declaration.SemanticSnapshotDeclarationCandidateAppendInto(
                   declarationStore, "pkg",
                   sourceId == 0 ? "pkg/b" : "pkg/a",
                   sourceId == 0 ? DocumentCid("pkg/b") :
                       DocumentCid("pkg/a"), "",
                   moduleCandidates[sourceId],
                   declaration.SemanticSnapshotDeclarationKindFunction,
                   declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
                   functionNames[functionId],
                   out.parserSidecars.functionNameProofCids[functionId],
                   out.types.typeCids[functionTypeId],
                   layout.FixedBytes32(),
                   functionStarts[functionId], functionEnds[functionId],
                   candidateIndex, declarationErr), declarationErr)
        add(functionCandidates, candidateIndex)
    var declarationMapping: declaration.SemanticSnapshotDeclarationMappingReceipt
    assert(declaration.SemanticSnapshotDeclarationTableSealInto(
               declarationStore, out.declarations, declarationMapping,
               declarationErr), declarationErr)

    # Canonical Symbol rows are sorted by exact DeclKeyCid.  The two module
    # owners and four functions share one dense Symbol domain; FunctionId is
    # kept separately and mapped through specToSymbol.
    var specDeclIds: int32[]
    add(specDeclIds,
        declarationMapping.producerCandidateToDeclIds[moduleCandidates[0]])
    add(specDeclIds,
        declarationMapping.producerCandidateToDeclIds[moduleCandidates[1]])
    for functionId in 0..<4:
        add(specDeclIds,
            declarationMapping.producerCandidateToDeclIds[
                functionCandidates[functionId]])
    var symbolOrder = [0, 1, 2, 3, 4, 5]
    for pass in 0..<5:
        for row in 0..<(5 - pass):
            let leftDecl = specDeclIds[symbolOrder[row]]
            let rightDecl = specDeclIds[symbolOrder[row + 1]]
            if CidLess(out.declarations.declKeyCids[rightDecl],
                       out.declarations.declKeyCids[leftDecl]):
                let temporary = symbolOrder[row]
                symbolOrder[row] = symbolOrder[row + 1]
                symbolOrder[row + 1] = temporary
    var specToSymbol = [-1, -1, -1, -1, -1, -1]
    for symbolId in 0..<6:
        specToSymbol[symbolOrder[symbolId]] = symbolId
    for symbolId in 0..<6:
        let spec = symbolOrder[symbolId]
        let isModule = spec < 2
        let sourceId = isModule ? spec : functionSourceIds[spec - 2]
        let declId = specDeclIds[spec]
        add(out.symbols.symbolCids, out.declarations.declKeyCids[declId])
        add(out.symbols.interfaceCids, layout.FixedBytes32())
        add(out.symbols.declIds, declId)
        add(out.symbols.declKeyCids, out.declarations.declKeyCids[declId])
        add(out.symbols.declarationHeaderCids,
            isModule ? out.sources.documentCids[sourceId] :
                out.parserSidecars.functionDeclarationHeaderCids[spec - 2])
        add(out.symbols.declarationPathCids,
            isModule ? out.sources.documentCids[sourceId] :
                out.parserSidecars.functionDeclarationPathCids[spec - 2])
        add(out.symbols.sourceIds, sourceId)
        add(out.symbols.nameTextIds,
            isModule ? (sourceId == 0 ? 8 : 5) : spec - 2)
        add(out.symbols.nameSpanIds, isModule ? -1 : spec - 2)
        add(out.symbols.nameTokenIds, isModule ? -1 : spec - 2)
        add(out.symbols.qualifiedNameTextIds,
            isModule ? (sourceId == 0 ? 8 : 5) :
                (spec == 2 ? 9 : (spec == 3 ? 10 :
                 (spec == 4 ? 6 : 7))))
        add(out.symbols.symbolKinds,
            isModule ? schema.CsgCompilerSymbolModule :
                schema.CsgCompilerSymbolFunction)
        add(out.symbols.typeIds, isModule ? -1 : functionTypeId)
        add(out.symbols.declarationSpanIds, isModule ? -1 : spec - 2)
        add(out.symbols.ownerSymbolIds,
            isModule ? -1 : specToSymbol[sourceId])
        add(out.symbols.functionIds,
            isModule ? -1 : (spec == 5 ? 0 : spec - 1))
        add(out.symbols.externFunctionIds, -1)
        add(out.symbols.exportedFlags, true)
        add(out.symbols.genericConstraintStarts, 0)
        add(out.symbols.genericConstraintCounts, 0)
        add(out.symbols.genericParameterParserRows, -1)
        add(out.symbols.genericParameterOrdinals, -1)
        add(out.symbols.genericParameterDefaultTypeIds, -1)

    out.lexicalScopes.sourceIds = [0, 1]
    out.lexicalScopes.spanIds = [0, 2]
    out.lexicalScopes.parentScopeIds = [-1, -1]
    out.lexicalScopes.visibleStarts = [0, 2]
    out.lexicalScopes.visibleCounts = [2, 2]
    out.lexicalScopes.visibleSymbolIds = [
        specToSymbol[2] < specToSymbol[3] ?
            specToSymbol[2] : specToSymbol[3],
        specToSymbol[2] < specToSymbol[3] ?
            specToSymbol[3] : specToSymbol[2],
        specToSymbol[4] < specToSymbol[5] ?
            specToSymbol[4] : specToSymbol[5],
        specToSymbol[4] < specToSymbol[5] ?
            specToSymbol[5] : specToSymbol[4]]

    out.functions.symbolIds = [
        specToSymbol[5], specToSymbol[2],
        specToSymbol[3], specToSymbol[4]]
    out.functions.typedFunctionIndexes = [0, 1, 2, 3]
    out.functions.bodySpanIds = [3, 0, 1, 2]
    AppendBodyCid(out.functions, DocumentCid("pkg/a"), Source1(), 8, 12)
    AppendBodyCid(out.functions, DocumentCid("pkg/b"),
                  PreviousSource0(), 0, 4)
    AppendBodyCid(out.functions, DocumentCid("pkg/b"),
                  PreviousSource0(), 8, 12)
    AppendBodyCid(out.functions, DocumentCid("pkg/a"), Source1(), 0, 4)
    out.functions.fragmentCids = [layout.FixedBytes32(),
                                  layout.FixedBytes32(),
                                  layout.FixedBytes32(),
                                  layout.FixedBytes32()]
    out.functions.interfaceCids = [layout.FixedBytes32(),
                                   layout.FixedBytes32(),
                                   layout.FixedBytes32(),
                                   layout.FixedBytes32()]
    for functionId in 0..<4:
        add(out.functions.annotationFlags, 0)
        add(out.functions.resultOwnershipKinds,
            schema.CsgCompilerOwnershipOwned)
        add(out.functions.parameterOwnershipStarts, 0)
        add(out.functions.parameterOwnershipCounts, 0)
        add(out.functions.valueDefinitionStarts, 0)
        add(out.functions.valueDefinitionCounts, 0)
        add(out.functions.valueDefinitionGroupStarts, 0)
        add(out.functions.valueDefinitionGroupCounts, 0)
    out.functions.readStarts = [0, 1, 2, 3]
    out.functions.readCounts = [1, 1, 1, 0]
    out.functions.nodeStarts = [0, 1, 2, 3]
    out.functions.nodeCounts = [1, 1, 1, 1]

    for symbolId in 0..<6:
        var interfaceCid: layout.FixedBytes32
        var interfaceErr: str
        assert(schema.CsgCompilerSymbolInterfaceCidInto(
                   out, symbolId, interfaceCid, interfaceErr), interfaceErr)
        out.symbols.interfaceCids[symbolId] = interfaceCid
        let functionId = out.symbols.functionIds[symbolId]
        if functionId >= 0:
            out.functions.interfaceCids[functionId] = interfaceCid
    var sourceInterfaceCids: layout.FixedBytes32[]
    var sourceInterfaceErr: str
    assert(schema.CsgCompilerSourceInterfaceCidsInto(
               out, sourceInterfaceCids, sourceInterfaceErr),
           sourceInterfaceErr)
    out.sources.interfaceCids = sourceInterfaceCids

    for functionId in 0..<4:
        add(out.typedNodes.typedIrNodeIndexes, functionId)
        add(out.typedNodes.originParserNodeIds, -1)
        add(out.typedNodes.bindingProducerSourceIndexes, -1)
        add(out.typedNodes.bindingParserSourceLocalNodeRows, -1)
        add(out.typedNodes.bindingDeclarationSourceLocalRows, -1)
        add(out.typedNodes.bindingPatternSourceLocalRows, -1)
        add(out.typedNodes.bindingValueDefinitionRows, -1)
        add(out.typedNodes.producedValueDefinitionRows, -1)
        add(out.typedNodes.ownerStatementIds, -1)
        add(out.typedNodes.syntheticOriginKinds, 1)
        add(out.typedNodes.spanAuthorityKinds, 2)
        add(out.typedNodes.functionIds, functionId)
        add(out.typedNodes.opKinds, 1)
        add(out.typedNodes.typeIds, scalarTypeId)
        add(out.typedNodes.valueKinds, schema.CsgCompilerValueOrdinary)
        add(out.typedNodes.captureStarts, 0)
        add(out.typedNodes.captureCounts, 0)
        add(out.typedNodes.ownershipKinds,
            schema.CsgCompilerOwnershipUnmanaged)
        add(out.typedNodes.ownershipProofKinds,
            schema.CsgCompilerValueProofTypeTrait)
        add(out.typedNodes.ownershipProofCids, layout.FixedBytes32())
        add(out.typedNodes.sendConclusions, true)
        add(out.typedNodes.sendProofKinds,
            schema.CsgCompilerValueProofTypeTrait)
        add(out.typedNodes.sendProofCids, layout.FixedBytes32())
        add(out.typedNodes.syncProofKinds,
            schema.CsgCompilerValueProofTypeTrait)
        add(out.typedNodes.syncProofCids, layout.FixedBytes32())
        add(out.typedNodes.syncConclusions, true)
        add(out.typedNodes.shareKinds, schema.CsgCompilerShareNone)
        add(out.typedNodes.shareProofCids, layout.FixedBytes32())
        add(out.typedNodes.spanIds, -1)
        add(out.typedNodes.operand0NodeIds, -1)
        add(out.typedNodes.operand1NodeIds, -1)
        add(out.typedNodes.operand2NodeIds, -1)
    for typedNodeId in 0..<4:
        var proofErr: str
        assert(schema.CsgCompilerTypedNodeOwnershipProofCidInto(
                   out, typedNodeId,
                   out.typedNodes.ownershipProofCids[typedNodeId],
                   proofErr), proofErr)
        assert(schema.CsgCompilerTypedNodeSendProofCidInto(
                   out, typedNodeId,
                   out.typedNodes.sendProofCids[typedNodeId], proofErr),
               proofErr)
        assert(schema.CsgCompilerTypedNodeSyncProofCidInto(
                   out, typedNodeId,
                   out.typedNodes.syncProofCids[typedNodeId], proofErr),
               proofErr)
        assert(schema.CsgCompilerTypedNodeShareProofCidInto(
                   out, typedNodeId,
                   out.typedNodes.shareProofCids[typedNodeId], proofErr),
               proofErr)
    var fragmentCids: layout.FixedBytes32[]
    var fragmentErr: str
    assert(schema.CsgCompilerFunctionFragmentCidsInto(
               out, fragmentCids, fragmentErr), fragmentErr)
    out.functions.fragmentCids = fragmentCids

    out.readSet.readerFunctionIds = [0, 1, 2]
    out.readSet.targetDomainKinds = [
        schema.CsgCompilerReadDomainSymbolInterface,
        schema.CsgCompilerReadDomainSymbolInterface,
        schema.CsgCompilerReadDomainSymbolInterface]
    out.readSet.targetPortableKeyCids = [
        out.symbols.symbolCids[out.functions.symbolIds[2]],
        out.symbols.symbolCids[out.functions.symbolIds[3]],
        out.symbols.symbolCids[out.functions.symbolIds[0]]]
    out.readSet.observedValueCids = [
        out.symbols.interfaceCids[out.functions.symbolIds[2]],
        out.symbols.interfaceCids[out.functions.symbolIds[3]],
        out.symbols.interfaceCids[out.functions.symbolIds[0]]]
    for functionId in 0..<4:
        var readCid: layout.FixedBytes32
        var readErr: str
        assert(schema.CsgCompilerReadSetPreimageCidInto(
                   out.symbols.symbolCids[
                       out.functions.symbolIds[functionId]],
                   out.readSet.targetDomainKinds,
                   out.readSet.targetPortableKeyCids,
                   out.readSet.observedValueCids,
                   out.functions.readStarts[functionId],
                   out.functions.readCounts[functionId], readCid, readErr),
               readErr)
        add(out.functions.readSetPreimageCids, readCid)
    var reverseErr: str
    assert(schema.CsgCompilerReadSetReverseBuildInto(out, reverseErr),
           reverseErr)

    out.layouts.layoutCids = [layout.FixedBytes32()]
    out.layouts.typeIds = [scalarTypeId]
    out.layouts.sizeBytes = [4]
    out.layouts.alignBytes = [4]
    out.layouts.fieldStarts = [0]
    out.layouts.fieldCounts = [0]
    var layoutErr: str
    assert(schema.CsgCompilerLayoutRowCidInto(
               out, 0, out.layouts.layoutCids[0], layoutErr), layoutErr)
    return out

fn BuildCurrentInput(
        previous: schema.CsgCompilerSnapshotTables):
        incremental.SemanticSnapshotIncrementalPrebuildInput =
    var input: incremental.SemanticSnapshotIncrementalPrebuildInput
    input.worldHeadCid = ExactCid(95)
    input.compilerCid = ExactCid(93)
    input.sourceBundleCid = ExactCid(96)
    input.frontEndReceiptCid = ExactCid(97)
    input.documentCids = [
        DocumentCid("pkg/b"), DocumentCid("pkg/a")]
    input.sourceProducerIndexes = [0, 1]
    input.sourceTexts = [CurrentSource0(), CurrentSource1()]
    input.sourceInterfaceCids = [
        previous.sources.interfaceCids[0], ExactCid(22)]
    for symbolId in 0..<previous.symbols.symbolCids.len:
        add(input.symbolCids, previous.symbols.symbolCids[symbolId])
        add(input.symbolInterfaceCids,
            previous.symbols.interfaceCids[symbolId])
    input.symbolInterfaceCids[previous.functions.symbolIds[0]] = ExactCid(51)
    input.functionSymbolIds = previous.functions.symbolIds
    input.functionSourceIds = [1, 0, 0, 1]
    input.bodyStartBytes = [8, 0, 8, 0]
    input.bodyEndBytes = [12, 4, 12, 4]
    for functionId in 0..<input.functionSymbolIds.len:
        add(input.functionInterfaceCids,
            input.symbolInterfaceCids[input.functionSymbolIds[functionId]])
    return input

fn BuildCurrentInputReverseSourceOrder(
        previous: schema.CsgCompilerSnapshotTables):
        incremental.SemanticSnapshotIncrementalPrebuildInput =
    var input = BuildCurrentInput(previous)
    input.documentCids = [
        DocumentCid("pkg/a"), DocumentCid("pkg/b")]
    input.sourceProducerIndexes = [1, 0]
    input.sourceTexts = [CurrentSource1(), CurrentSource0()]
    input.sourceInterfaceCids = [
        ExactCid(22), previous.sources.interfaceCids[0]]
    input.functionSourceIds = [0, 1, 1, 0]
    return input

fn BuildCurrentInputWithInsertedSymbol(
        previous: schema.CsgCompilerSnapshotTables):
        incremental.SemanticSnapshotIncrementalPrebuildInput =
    var input = BuildCurrentInput(previous)
    let oldSymbolCids = input.symbolCids
    let oldInterfaceCids = input.symbolInterfaceCids
    let oldFunctionSymbolIds = input.functionSymbolIds
    var insertedCid = oldSymbolCids[3]
    var byteIndex: int32 = layout.FixedBytes32Size - 1
    var changed: bool
    while byteIndex >= 0 && !changed:
        if insertedCid.data[byteIndex] > uint8(0):
            insertedCid.data[byteIndex] =
                uint8(Int32(insertedCid.data[byteIndex]) - 1)
            changed = true
        byteIndex = byteIndex - 1
    assert(changed && !layout.FixedBytes32Equal(
               insertedCid, layout.FixedBytes32()),
           " incremental prebuild: inserted SymbolCid unavailable")
    input.symbolCids = []
    input.symbolInterfaceCids = []
    var inserted: bool
    for oldSymbolId in 0..<oldSymbolCids.len:
        if !inserted && CidLess(insertedCid, oldSymbolCids[oldSymbolId]):
            add(input.symbolCids, insertedCid)
            add(input.symbolInterfaceCids, ExactCid(88))
            inserted = true
        add(input.symbolCids, oldSymbolCids[oldSymbolId])
        add(input.symbolInterfaceCids, oldInterfaceCids[oldSymbolId])
    if !inserted:
        add(input.symbolCids, insertedCid)
        add(input.symbolInterfaceCids, ExactCid(88))
    input.functionSymbolIds = []
    for functionId in 0..<oldFunctionSymbolIds.len:
        let oldFunctionSymbolId = oldFunctionSymbolIds[functionId]
        var mapped: int32 = -1
        for symbolId in 0..<input.symbolCids.len:
            if layout.FixedBytes32Equal(input.symbolCids[symbolId],
                                        oldSymbolCids[oldFunctionSymbolId]):
                mapped = symbolId
        assert(mapped >= 0,
               " incremental prebuild: inserted SymbolCid remap missing")
        add(input.functionSymbolIds, mapped)
    return input

fn main() =
    var err: str
    var previous = BuildPreviousTables()
    assert(schema.CsgCompilerSnapshotTablesStrictValidateInto(previous, err),
           err)
    var previousCargo = cargo.CsgCompilerSnapshotCargoBuild(previous)
    assert(previousCargo.ok, previousCargo.error)

    var eventState: snapshot.WorkspaceSourceEventState
    assert(snapshot.WorkspaceSourceEventStateInitInto(
               ExactCid(90), eventState, err), err)
    var sourceVersion: int64
    assert(snapshot.WorkspaceSourceEventAcceptInto(
               eventState, snapshot.SemanticSourceEventOpen,
               DocumentCid("pkg/b"), int64(0), sourceVersion, err), err)
    assert(snapshot.WorkspaceSourceEventAcceptInto(
               eventState, snapshot.SemanticSourceEventOpen,
               DocumentCid("pkg/a"), int64(0), sourceVersion, err), err)

    var previousIdentity: snapshot.PortableSemanticSnapshotIdentity
    assert(snapshot.PortableSemanticSnapshotIdentityMakeInto(
               ExactCid(91), ExactCid(92), ExactCid(93), ExactCid(94),
               previousCargo.factsRootCid, previousIdentity, err), err)
    var previousBinding: snapshot.LocalSourceVersionBinding
    assert(snapshot.LocalSourceVersionBindingMakeInto(
               eventState, previousIdentity, previousBinding, err), err)
    var previousValidation: snapshot.SemanticSnapshotValidationReceipt
    assert(snapshot.SemanticSnapshotValidationReceiptMakeInto(
               previousBinding, previousIdentity,
               previousCargo.proofRoots.parserRootCid,
               previousCargo.proofRoots.typeRootCid,
               previousCargo.proofRoots.ownershipRootCid,
               previousCargo.proofRoots.callRootCid,
               previousCargo.proofRoots.layoutRootCid,
               previousCargo.proofRoots.dependencyRootCid,
               previousCargo.proofRoots.readSetRootCid,
               previousCargo.proofRoots.reachabilityRootCid,
               previousCargo.proofRoots.lifecycleRootCid,
               ExactCid(250),
               previousValidation, err), err)

    assert(snapshot.WorkspaceSourceEventAcceptInto(
               eventState, snapshot.SemanticSourceEventChange,
               DocumentCid("pkg/a"), int64(1), sourceVersion, err), err)
    assert(sourceVersion == int64(3),
           " incremental prebuild: source version drift")
    # A newer event may cancel the version-3 candidate before publication.
    # The prebuild must compare the final event state directly with the last
    # published version instead of requiring adjacent published versions.
    assert(snapshot.WorkspaceSourceEventAcceptInto(
               eventState, snapshot.SemanticSourceEventChange,
               DocumentCid("pkg/a"), int64(2), sourceVersion, err), err)
    assert(sourceVersion == int64(4) &&
           eventState.documentLastEventSourceVersions[0] == int64(1) &&
           eventState.documentLastEventSourceVersions[1] == int64(4),
           " incremental prebuild: skipped candidate provenance drift")

    let input = BuildCurrentInput(previous)
    var facts: incremental.SemanticSnapshotIncrementalPrebuildFacts
    var secondFacts: incremental.SemanticSnapshotIncrementalPrebuildFacts
    assert(incremental.SemanticSnapshotIncrementalPrebuildFactsMakeInto(
               eventState, input, facts, err), err)
    assert(incremental.SemanticSnapshotIncrementalPrebuildFactsMakeInto(
               eventState, input, secondFacts, err), err)
    assert(incremental.SemanticSnapshotIncrementalPrebuildFactsStrictValidateInto(
               facts, err), err)
    assert(layout.FixedBytes32Equal(facts.factsCid, secondFacts.factsCid),
           " incremental prebuild: nondeterministic facts")
    assert(facts.sourceVersion == int64(4) &&
           facts.sourceLastEventVersions[0] == int64(1) &&
           facts.sourceLastEventVersions[1] == int64(4),
           " incremental prebuild: source event provenance missing")

    # Source rows are canonical by document CID, independent of didOpen
    # order. Function source indexes are remapped through the same bijection.
    var reverseEventState: snapshot.WorkspaceSourceEventState
    assert(snapshot.WorkspaceSourceEventStateInitInto(
               ExactCid(90), reverseEventState, err), err)
    assert(snapshot.WorkspaceSourceEventAcceptInto(
               reverseEventState, snapshot.SemanticSourceEventOpen,
               DocumentCid("pkg/a"), int64(0), sourceVersion, err), err)
    assert(snapshot.WorkspaceSourceEventAcceptInto(
               reverseEventState, snapshot.SemanticSourceEventOpen,
               DocumentCid("pkg/b"), int64(0), sourceVersion, err), err)
    assert(snapshot.WorkspaceSourceEventAcceptInto(
               reverseEventState, snapshot.SemanticSourceEventChange,
               DocumentCid("pkg/a"), int64(1), sourceVersion, err), err)
    assert(snapshot.WorkspaceSourceEventAcceptInto(
               reverseEventState, snapshot.SemanticSourceEventChange,
               DocumentCid("pkg/a"), int64(2), sourceVersion, err), err)
    let reverseInput = BuildCurrentInputReverseSourceOrder(previous)
    var reverseFacts: incremental.SemanticSnapshotIncrementalPrebuildFacts
    assert(incremental.SemanticSnapshotIncrementalPrebuildFactsMakeInto(
               reverseEventState, reverseInput, reverseFacts, err), err)
    assert(layout.FixedBytes32Equal(
               reverseFacts.documentCids[0], DocumentCid("pkg/b")) &&
           layout.FixedBytes32Equal(
               reverseFacts.documentCids[1], DocumentCid("pkg/a")) &&
           reverseFacts.functionSourceIds.len == 4 &&
           reverseFacts.functionSourceIds[0] == 1 &&
           reverseFacts.functionSourceIds[1] == 0 &&
           reverseFacts.functionSourceIds[2] == 0 &&
           reverseFacts.functionSourceIds[3] == 1 &&
           reverseFacts.sourceLastEventVersions.len == 2 &&
           reverseFacts.sourceLastEventVersions[0] == int64(2) &&
           reverseFacts.sourceLastEventVersions[1] == int64(4),
           " incremental prebuild: reverse didOpen source remap drift")

    # First publication uses the same schema with an explicit zero-predecessor
    # state. Every current function must be rebuilt; no fixture snapshot or
    # reusable row is admitted.
    var initialPlan: incremental.SemanticSnapshotIncrementalPrebuildPlan
    assert(incremental.SemanticSnapshotIncrementalInitialPrebuildPlanBuildInto(
               facts, initialPlan, err), err)
    assert(initialPlan.previousSourceVersion == int64(0) &&
           initialPlan.previousFunctionCount == 0 &&
           initialPlan.reusableFunctionIds.len == 0 &&
           initialPlan.rebuildFunctionIds.len ==
               facts.functionSymbolIds.len,
           " incremental prebuild: initial plan state drift")
    for functionId in 0..<facts.functionSymbolIds.len:
        assert(initialPlan.previousFunctionIds[functionId] == -1 &&
               initialPlan.partitionKinds[functionId] ==
                   incremental.SemanticSnapshotIncrementalPartitionRebuildRequired &&
               initialPlan.reasonMasks[functionId] ==
                   incremental.SemanticSnapshotIncrementalReasonNewFunction,
               " incremental prebuild: initial function reused authority")
    let initialRebuilt = BuildRebuildReadProducer(
        facts, initialPlan, ExactCid(229),
        [0, 1, 2, 3], [0, 0, 0, 0], [0, 0, 0, 0],
        [], [], [])
    var emptyPrevious: schema.CsgCompilerSnapshotTables
    var initialFinalized: incremental.SemanticSnapshotIncrementalFinalizedReadSet
    assert(incremental.SemanticSnapshotIncrementalFinalizedReadSetBuildInto(
               emptyPrevious, facts, initialPlan, initialRebuilt,
               initialFinalized, err), err)
    assert(incremental.SemanticSnapshotIncrementalFinalizedReadSetStrictValidateInto(
               emptyPrevious, facts, initialPlan, initialFinalized, err), err)
    assert(initialFinalized.initialBuild &&
           layout.FixedBytes32Equal(
               initialFinalized.previousCsgRootCid,
               layout.FixedBytes32()) &&
           initialFinalized.rebuildFunctionIds.len ==
               facts.functionSymbolIds.len,
           " incremental finalized read-set: initial state drift")
    var initialAttack = initialPlan
    initialAttack.previousCsgRootCid = ExactCid(228)
    assert(!incremental.SemanticSnapshotIncrementalPrebuildPlanStrictValidateInto(
               initialAttack, err),
           " incremental prebuild: initial predecessor attack accepted")

    var plan: incremental.SemanticSnapshotIncrementalPrebuildPlan
    var secondPlan: incremental.SemanticSnapshotIncrementalPrebuildPlan
    assert(incremental.SemanticSnapshotIncrementalPrebuildPlanBuildInto(
               previous, previousIdentity, previousBinding,
               previousValidation, facts, plan, err), err)
    assert(incremental.SemanticSnapshotIncrementalPrebuildPlanBuildInto(
               previous, previousIdentity, previousBinding,
               previousValidation, facts, secondPlan, err), err)
    assert(incremental.SemanticSnapshotIncrementalPrebuildPlanStrictValidateInto(
               plan, err), err)
    assert(layout.FixedBytes32Equal(plan.planCid, secondPlan.planCid) &&
           layout.FixedBytes32Equal(plan.receiptCid, secondPlan.receiptCid),
           " incremental prebuild: nondeterministic plan")
    assert(plan.rebuildFunctionIds.len == 2 &&
           plan.rebuildFunctionIds[0] == 0 &&
           plan.rebuildFunctionIds[1] == 2 &&
           plan.reusableFunctionIds.len == 2 &&
           plan.reusableFunctionIds[0] == 1 &&
           plan.reusableFunctionIds[1] == 3,
           " incremental prebuild: exact dependency closure drift")
    assert((plan.reasonMasks[0] &
                incremental.SemanticSnapshotIncrementalReasonBodyContent) != 0 &&
           (plan.reasonMasks[0] &
                incremental.SemanticSnapshotIncrementalReasonInterface) != 0 &&
           (plan.reasonMasks[2] &
                incremental.SemanticSnapshotIncrementalReasonDependency) != 0 &&
           plan.reasonMasks[1] == 0 && plan.reasonMasks[3] == 0,
           " incremental prebuild: reason proof drift")

    let remapInput = BuildCurrentInputWithInsertedSymbol(previous)
    var remapFacts: incremental.SemanticSnapshotIncrementalPrebuildFacts
    assert(incremental.SemanticSnapshotIncrementalPrebuildFactsMakeInto(
               eventState, remapInput, remapFacts, err), err)
    var remapPlan: incremental.SemanticSnapshotIncrementalPrebuildPlan
    assert(incremental.SemanticSnapshotIncrementalPrebuildPlanBuildInto(
               previous, previousIdentity, previousBinding,
               previousValidation, remapFacts, remapPlan, err), err)
    let remapTarget2 = remapFacts.functionSymbolIds[2]
    let remapTarget1 = remapFacts.functionSymbolIds[1]
    let remapRebuilt = BuildRebuildReadProducer(
        remapFacts, remapPlan, ExactCid(230), [0, 2], [0, 1], [1, 1],
        [schema.CsgCompilerReadDomainSymbolInterface,
         schema.CsgCompilerReadDomainSymbolInterface],
        [remapFacts.symbolCids[remapTarget2],
         remapFacts.symbolCids[remapTarget1]],
        [remapFacts.symbolInterfaceCids[remapTarget2],
         remapFacts.symbolInterfaceCids[remapTarget1]])
    var remapFinalized: incremental.SemanticSnapshotIncrementalFinalizedReadSet
    assert(incremental.SemanticSnapshotIncrementalFinalizedReadSetBuildInto(
               previous, remapFacts, remapPlan, remapRebuilt,
               remapFinalized, err), err)
    let remappedPreviousTarget = remapFacts.functionSymbolIds[3]
    assert(remappedPreviousTarget != 3 &&
           remapFinalized.readCounts[1] == 1 &&
           layout.FixedBytes32Equal(
               remapFinalized.readSet.targetPortableKeyCids[
                   remapFinalized.readStarts[1]],
               remapFacts.symbolCids[remappedPreviousTarget]),
           " incremental finalized read-set: cross-source SymbolCid remap drift")

    var sourceAttack = facts
    sourceAttack.sourceTexts[0] = "xxxxBBBBccccDDDD"
    assert(!incremental.SemanticSnapshotIncrementalPrebuildFactsStrictValidateInto(
                sourceAttack, err),
           " incremental prebuild: source-byte attack accepted")
    var eventVersionAttack = facts
    eventVersionAttack.sourceLastEventVersions[0] = int64(3)
    assert(!incremental.SemanticSnapshotIncrementalPrebuildFactsStrictValidateInto(
                eventVersionAttack, err),
           " incremental prebuild: event provenance attack accepted")
    var rangeAttack = facts
    rangeAttack.bodyStartBytes[1] = 7
    assert(!incremental.SemanticSnapshotIncrementalPrebuildFactsStrictValidateInto(
                rangeAttack, err),
           " incremental prebuild: body-range attack accepted")
    var bodyCidAttack = facts
    bodyCidAttack.bodyContentCids[1] = ExactCid(99)
    assert(!incremental.SemanticSnapshotIncrementalPrebuildFactsStrictValidateInto(
                bodyCidAttack, err),
           " incremental prebuild: body CID attack accepted")
    var receiptAttack = facts
    receiptAttack.factsCid = ExactCid(98)
    assert(!incremental.SemanticSnapshotIncrementalPrebuildFactsStrictValidateInto(
                receiptAttack, err),
           " incremental prebuild: facts receipt attack accepted")

    var planAttack = plan
    planAttack.partitionKinds[1] =
        incremental.SemanticSnapshotIncrementalPartitionRebuildRequired
    assert(!incremental.SemanticSnapshotIncrementalPrebuildPlanStrictValidateInto(
                planAttack, err),
           " incremental prebuild: plan attack accepted")
    var reverseReceiptAttack = plan
    reverseReceiptAttack.previousReadSetReverseIndexCid = ExactCid(89)
    assert(!incremental.SemanticSnapshotIncrementalPrebuildPlanStrictValidateInto(
                reverseReceiptAttack, err),
           " incremental prebuild: reverse read-set receipt attack accepted")
    var previousAttack = schema.CsgCompilerSnapshotTablesClone(previous)
    previousAttack.functions.bodyContentCids[1] = ExactCid(99)
    var rejected: incremental.SemanticSnapshotIncrementalPrebuildPlan
    assert(!incremental.SemanticSnapshotIncrementalPrebuildPlanBuildInto(
                previousAttack, previousIdentity, previousBinding,
                previousValidation, facts, rejected, err),
           " incremental prebuild: previous cache attack accepted")
    previousAttack = schema.CsgCompilerSnapshotTablesClone(previous)
    previousAttack.functions.readSetPreimageCids[0] = ExactCid(99)
    assert(!incremental.SemanticSnapshotIncrementalPrebuildPlanBuildInto(
                previousAttack, previousIdentity, previousBinding,
                previousValidation, facts, rejected, err),
           " incremental prebuild: read-set cache attack accepted")

    # Attack fixtures above intentionally share array storage in Cheng value
    # copies; restore the independently produced immutable current facts.
    let restoredInput = BuildCurrentInput(previous)
    assert(incremental.SemanticSnapshotIncrementalPrebuildFactsMakeInto(
               eventState, restoredInput, facts, err), err)
    assert(incremental.SemanticSnapshotIncrementalPrebuildPlanBuildInto(
               previous, previousIdentity, previousBinding,
               previousValidation, facts, plan, err), err)
    # Function 2 retargets after planning; its previous edge to changed symbol
    # 0 is what already forced the rebuild above. The producer transaction
    # binds each rebuilt read to one retained CompilerCSG fact row and exact
    # parser origin before the finalizer can consume it.
    let rebuilt = BuildRebuildReadProducer(
        facts, plan, ExactCid(231), [0, 2], [0, 1], [1, 1],
        [schema.CsgCompilerReadDomainSymbolInterface,
         schema.CsgCompilerReadDomainSymbolInterface],
        [facts.symbolCids[facts.functionSymbolIds[2]],
         facts.symbolCids[facts.functionSymbolIds[1]]],
        [facts.symbolInterfaceCids[facts.functionSymbolIds[2]],
         facts.symbolInterfaceCids[facts.functionSymbolIds[1]]])
    var finalized: incremental.SemanticSnapshotIncrementalFinalizedReadSet
    var secondFinalized: incremental.SemanticSnapshotIncrementalFinalizedReadSet
    assert(incremental.SemanticSnapshotIncrementalFinalizedReadSetBuildInto(
               previous, facts, plan, rebuilt, finalized, err), err)
    assert(incremental.SemanticSnapshotIncrementalFinalizedReadSetBuildInto(
               previous, facts, plan, rebuilt, secondFinalized, err), err)
    assert(incremental.SemanticSnapshotIncrementalFinalizedReadSetStrictValidateInto(
               previous, facts, plan, finalized, err), err)
    assert(finalized.rebuildFunctionIds.len == 2 &&
           finalized.rebuildFunctionIds[0] == 0 &&
           finalized.rebuildFunctionIds[1] == 2 &&
           finalized.readCounts.len == 4 &&
           finalized.readCounts[0] == 1 &&
           finalized.readCounts[1] == 1 &&
           finalized.readCounts[2] == 1 &&
           finalized.readCounts[3] == 0 &&
           finalized.readSet.targetPortableKeyCids.len == 3 &&
           layout.FixedBytes32Equal(
               finalized.readSet.targetPortableKeyCids[0],
               facts.symbolCids[facts.functionSymbolIds[2]]) &&
           layout.FixedBytes32Equal(
               finalized.readSet.targetPortableKeyCids[1],
               facts.symbolCids[facts.functionSymbolIds[3]]) &&
           layout.FixedBytes32Equal(
               finalized.readSet.targetPortableKeyCids[2],
               facts.symbolCids[facts.functionSymbolIds[1]]) &&
           incremental.SemanticSnapshotIncrementalFinalizedReverseIndexBuildCount(
               finalized) == 1 &&
           incremental.SemanticSnapshotIncrementalFinalizedReverseIndexBuildCount(
               secondFinalized) == 1 &&
           layout.FixedBytes32Equal(finalized.receiptCid,
                                    secondFinalized.receiptCid),
           " incremental finalized read-set: partition or determinism drift")
    assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerRetainedLogicalBytes(
               finalized) == int64(436) &&
           incremental.SemanticSnapshotIncrementalRebuildReadProducerValidationScratchLogicalBytes(
               finalized) == int64(136),
           " incremental read producer: retained/scratch byte ledger drift")
    var rebuiltTargetAttack = rebuilt
    rebuiltTargetAttack.targetPortableKeyCids = [
        facts.symbolCids[facts.functionSymbolIds[2]],
        facts.symbolCids[facts.functionSymbolIds[0]]]
    assert(!incremental.SemanticSnapshotIncrementalFinalizedReadSetBuildInto(
                previous, facts, plan, rebuiltTargetAttack,
                secondFinalized, err),
           " incremental finalized read-set: SymbolId/SymbolCid attack accepted")
    var rebuiltObservedAttack = rebuilt
    rebuiltObservedAttack.observedValueCids = [
        facts.symbolInterfaceCids[facts.functionSymbolIds[2]],
        facts.symbolInterfaceCids[facts.functionSymbolIds[0]]]
    assert(!incremental.SemanticSnapshotIncrementalFinalizedReadSetBuildInto(
                previous, facts, plan, rebuiltObservedAttack,
                secondFinalized, err),
           " incremental finalized read-set: observed attack accepted")
    var missingRebuildAttack = rebuilt
    missingRebuildAttack.functionIds = [0]
    assert(!incremental.SemanticSnapshotIncrementalFinalizedReadSetBuildInto(
                previous, facts, plan, missingRebuildAttack,
                secondFinalized, err),
           " incremental finalized read-set: missing rebuild accepted")
    var duplicateRebuildAttack = rebuilt
    duplicateRebuildAttack.functionIds = [0, 0]
    assert(!incremental.SemanticSnapshotIncrementalFinalizedReadSetBuildInto(
                previous, facts, plan, duplicateRebuildAttack,
                secondFinalized, err),
           " incremental finalized read-set: duplicate rebuild accepted")
    var extraRebuildAttack = rebuilt
    extraRebuildAttack.functionIds = [0, 2, 2]
    extraRebuildAttack.readStarts = [0, 1, 2]
    extraRebuildAttack.readCounts = [1, 1, 0]
    assert(!incremental.SemanticSnapshotIncrementalFinalizedReadSetBuildInto(
                previous, facts, plan, extraRebuildAttack,
                secondFinalized, err),
           " incremental finalized read-set: extra rebuild accepted")
    var finalizedAttack = finalized
    finalizedAttack.readSet.reverseIndexCid = ExactCid(99)
    assert(!incremental.SemanticSnapshotIncrementalFinalizedReadSetStrictValidateInto(
                previous, facts, plan, finalizedAttack, err),
           " incremental finalized read-set: reverse tamper accepted")
    var reverseOwnerAttack = finalized
    reverseOwnerAttack.reverseIndexOwner.buildCount = 2
    assert(!incremental.SemanticSnapshotIncrementalFinalizedReadSetStrictValidateInto(
                previous, facts, plan, reverseOwnerAttack, err),
           " incremental finalized read-set: repeated reverse build accepted")
    var compactReadOffsetAttack = finalized
    compactReadOffsetAttack.rebuildReadProducer.producerFactReadRowIds =
        [1, 0]
    assert(!incremental.SemanticSnapshotIncrementalFinalizedReadSetStrictValidateInto(
                previous, facts, plan, compactReadOffsetAttack, err),
           " incremental finalized read-set: compact read offset drift accepted")

    var producerAttackCount: int32
    var traceAttack = rebuilt
    traceAttack.producerFactTraceCids = [
        ExactCid(240), rebuilt.producerFactTraceCids[1]]
    assert(!incremental.SemanticSnapshotIncrementalRebuildReadProducerStrictValidateInto(
                facts, plan, traceAttack, err),
           " incremental read producer: forged fact trace accepted")
    producerAttackCount = producerAttackCount + 1
    var rootAttack = rebuilt
    rootAttack.producerFactsRootCid = ExactCid(241)
    assert(!incremental.SemanticSnapshotIncrementalRebuildReadProducerStrictValidateInto(
                facts, plan, rootAttack, err),
           " incremental read producer: fact root drift accepted")
    producerAttackCount = producerAttackCount + 1
    var crossFunctionAttack = rebuilt
    crossFunctionAttack.producerFactFunctionIds = [2, 2]
    assert(!incremental.SemanticSnapshotIncrementalRebuildReadProducerStrictValidateInto(
                facts, plan, crossFunctionAttack, err),
           " incremental read producer: cross-function fact accepted")
    producerAttackCount = producerAttackCount + 1
    var originAttack = rebuilt
    originAttack.producerOriginNodeIds = [-1, 101]
    assert(!incremental.SemanticSnapshotIncrementalRebuildReadProducerStrictValidateInto(
                facts, plan, originAttack, err),
           " incremental read producer: missing parser origin accepted")
    producerAttackCount = producerAttackCount + 1

    var stateAttack: incremental.SemanticSnapshotIncrementalRebuildReadInput
    var overflowAttack: incremental.SemanticSnapshotIncrementalRebuildReadInput
    assert(!incremental.SemanticSnapshotIncrementalRebuildReadProducerInitInto(
                facts, plan, ExactCid(248), int32(536870912),
                overflowAttack, err),
           " incremental read producer: fact index overflow accepted")
    producerAttackCount = producerAttackCount + 1
    assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerInitInto(
               facts, plan, ExactCid(242), 0, stateAttack, err), err)
    assert(!incremental.SemanticSnapshotIncrementalRebuildReadProducerBeginFunctionInto(
                facts, plan, stateAttack, 1, 0, err),
           " incremental read producer: reusable function invoked")
    producerAttackCount = producerAttackCount + 1
    assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerBeginFunctionInto(
               facts, plan, stateAttack, 0, 0, err), err)
    assert(!incremental.SemanticSnapshotIncrementalRebuildReadProducerBeginFunctionInto(
                facts, plan, stateAttack, 0, 0, err),
           " incremental read producer: duplicate begin accepted")
    producerAttackCount = producerAttackCount + 1
    assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerEndFunctionInto(
               facts, plan, stateAttack, 0, err), err)
    assert(!incremental.SemanticSnapshotIncrementalRebuildReadProducerSealInto(
                facts, plan, stateAttack, err),
           " incremental read producer: missing invocation accepted")
    producerAttackCount = producerAttackCount + 1

    var factAttack: incremental.SemanticSnapshotIncrementalRebuildReadInput
    assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerInitInto(
               facts, plan, ExactCid(243), 2, factAttack, err), err)
    assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerBeginFunctionInto(
               facts, plan, factAttack, 0, 2, err), err)
    var factReadRow: int32
    assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerAppendReadInto(
               facts, plan, factAttack, 0,
               schema.CsgCompilerReadDomainSymbolInterface,
               facts.symbolCids[facts.functionSymbolIds[1]],
               facts.symbolInterfaceCids[facts.functionSymbolIds[1]],
               factReadRow, err), err)
    assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerAppendCompilerFactInto(
               facts, plan, factAttack, 0, factReadRow,
               incremental.SemanticSnapshotIncrementalProducerFactResolvedCall,
               facts.functionSourceIds[0], facts.functionSourceIds[0],
               2, 302, err), err)
    assert(!incremental.SemanticSnapshotIncrementalRebuildReadProducerAppendCompilerFactInto(
                facts, plan, factAttack, 0, factReadRow,
                incremental.SemanticSnapshotIncrementalProducerFactResolvedCall,
                facts.functionSourceIds[0], facts.functionSourceIds[0],
                1, 303, err),
           " incremental read producer: unordered compiler fact accepted")
    producerAttackCount = producerAttackCount + 1

    var unconsumedReadAttack: incremental.SemanticSnapshotIncrementalRebuildReadInput
    assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerInitInto(
               facts, plan, ExactCid(244), 0,
               unconsumedReadAttack, err), err)
    assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerBeginFunctionInto(
               facts, plan, unconsumedReadAttack, 0, 0, err), err)
    var unconsumedReadRow: int32
    assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerAppendReadInto(
               facts, plan, unconsumedReadAttack, 0,
               schema.CsgCompilerReadDomainSymbolInterface,
               facts.symbolCids[facts.functionSymbolIds[1]],
               facts.symbolInterfaceCids[facts.functionSymbolIds[1]],
               unconsumedReadRow, err), err)
    assert(!incremental.SemanticSnapshotIncrementalRebuildReadProducerEndFunctionInto(
                facts, plan, unconsumedReadAttack, 0, err),
           " incremental read producer: unproved read accepted")
    producerAttackCount = producerAttackCount + 1

    var crossAppendAttack: incremental.SemanticSnapshotIncrementalRebuildReadInput
    assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerInitInto(
               facts, plan, ExactCid(245), 1,
               crossAppendAttack, err), err)
    assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerBeginFunctionInto(
               facts, plan, crossAppendAttack, 0, 1, err), err)
    var crossReadRow: int32
    assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerAppendReadInto(
               facts, plan, crossAppendAttack, 0,
               schema.CsgCompilerReadDomainSymbolInterface,
               facts.symbolCids[facts.functionSymbolIds[1]],
               facts.symbolInterfaceCids[facts.functionSymbolIds[1]],
               crossReadRow, err), err)
    assert(!incremental.SemanticSnapshotIncrementalRebuildReadProducerAppendCompilerFactInto(
                facts, plan, crossAppendAttack, 2, crossReadRow,
                incremental.SemanticSnapshotIncrementalProducerFactResolvedCall,
                facts.functionSourceIds[0], facts.functionSourceIds[0],
                0, 304, err),
           " incremental read producer: cross-function append accepted")
    producerAttackCount = producerAttackCount + 1
    assert(!incremental.SemanticSnapshotIncrementalRebuildReadProducerAppendCompilerFactInto(
                facts, plan, crossAppendAttack, 0, crossReadRow,
                incremental.SemanticSnapshotIncrementalProducerFactResolvedCall,
                facts.functionSourceIds[0], facts.functionSourceIds[0],
                0, -1, err),
           " incremental read producer: negative parser origin appended")
    producerAttackCount = producerAttackCount + 1
    assert(!incremental.SemanticSnapshotIncrementalRebuildReadProducerAppendCompilerFactInto(
                facts, plan, crossAppendAttack, 0, crossReadRow,
                incremental.SemanticSnapshotIncrementalProducerFactResolvedCall,
               facts.sourceProducerIndexes[0],
                facts.functionSourceIds[0], 0, 305, err),
           " incremental read producer: producer/canonical source split accepted")
    producerAttackCount = producerAttackCount + 1

    var duplicateOriginAttack: incremental.SemanticSnapshotIncrementalRebuildReadInput
    assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerInitInto(
               facts, plan, ExactCid(246), 2,
               duplicateOriginAttack, err), err)
    assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerBeginFunctionInto(
               facts, plan, duplicateOriginAttack, 0, 2, err), err)
    var duplicateRead0: int32
    var duplicateRead1: int32
    assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerAppendReadInto(
               facts, plan, duplicateOriginAttack, 0,
               schema.CsgCompilerReadDomainSymbolInterface,
               facts.symbolCids[facts.functionSymbolIds[1]],
               facts.symbolInterfaceCids[facts.functionSymbolIds[1]],
               duplicateRead0, err), err)
    assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerAppendReadInto(
               facts, plan, duplicateOriginAttack, 0,
               schema.CsgCompilerReadDomainSymbolInterface,
               facts.symbolCids[facts.functionSymbolIds[2]],
               facts.symbolInterfaceCids[facts.functionSymbolIds[2]],
               duplicateRead1, err), err)
    assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerAppendCompilerFactInto(
               facts, plan, duplicateOriginAttack, 0, duplicateRead0,
               incremental.SemanticSnapshotIncrementalProducerFactResolvedCall,
               facts.functionSourceIds[0], facts.functionSourceIds[0],
               0, 400, err), err)
    assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerAppendCompilerFactInto(
               facts, plan, duplicateOriginAttack, 0, duplicateRead1,
               incremental.SemanticSnapshotIncrementalProducerFactResolvedCall,
               facts.functionSourceIds[0], facts.functionSourceIds[0],
               0, 400, err), err)
    assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerEndFunctionInto(
               facts, plan, duplicateOriginAttack, 0, err), err)
    assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerBeginFunctionInto(
               facts, plan, duplicateOriginAttack, 2, 0, err), err)
    assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerEndFunctionInto(
               facts, plan, duplicateOriginAttack, 2, err), err)
    assert(!incremental.SemanticSnapshotIncrementalRebuildReadProducerSealInto(
                facts, plan, duplicateOriginAttack, err),
           " incremental read producer: one producer fact mapped to two reads")
    producerAttackCount = producerAttackCount + 1

    # One parser call node may read multiple overload candidates in the same
    # producer table. Origin is mandatory provenance, not a uniqueness key.
    var sharedOriginProducer: incremental.SemanticSnapshotIncrementalRebuildReadInput
    assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerInitInto(
               facts, plan, ExactCid(247), 2,
               sharedOriginProducer, err), err)
    assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerBeginFunctionInto(
               facts, plan, sharedOriginProducer, 0, 2, err), err)
    var sourceReadRow: int32
    var symbolReadRow: int32
    assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerAppendReadInto(
               facts, plan, sharedOriginProducer, 0,
               schema.CsgCompilerReadDomainSymbolInterface,
               facts.symbolCids[facts.functionSymbolIds[1]],
               facts.symbolInterfaceCids[facts.functionSymbolIds[1]],
               sourceReadRow, err), err)
    assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerAppendReadInto(
               facts, plan, sharedOriginProducer, 0,
               schema.CsgCompilerReadDomainSymbolInterface,
               facts.symbolCids[facts.functionSymbolIds[2]],
               facts.symbolInterfaceCids[facts.functionSymbolIds[2]],
               symbolReadRow, err), err)
    assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerAppendCompilerFactInto(
               facts, plan, sharedOriginProducer, 0, symbolReadRow,
               incremental.SemanticSnapshotIncrementalProducerFactResolvedCall,
               facts.functionSourceIds[0], facts.functionSourceIds[0],
               0, 500, err), err)
    assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerAppendCompilerFactInto(
               facts, plan, sharedOriginProducer, 0, sourceReadRow,
               incremental.SemanticSnapshotIncrementalProducerFactResolvedCall,
               facts.functionSourceIds[0], facts.functionSourceIds[0],
               1, 500, err), err)
    assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerEndFunctionInto(
               facts, plan, sharedOriginProducer, 0, err), err)
    assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerBeginFunctionInto(
               facts, plan, sharedOriginProducer, 2, 0, err), err)
    assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerEndFunctionInto(
               facts, plan, sharedOriginProducer, 2, err), err)
    assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerSealInto(
               facts, plan, sharedOriginProducer, err), err)
    assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerStrictValidateInto(
               facts, plan, sharedOriginProducer, err), err)
    assert(producerAttackCount == 14,
           " incremental read producer: attack count drift")

    cargo.CsgCompilerSnapshotCargoRelease(previousCargo)
    os.WriteLine(os.Get_stdout(),
                 "semantic_snapshot_incremental_producer_attack_count=14")
    os.WriteLine(os.Get_stdout(),
                 "semantic_snapshot_incremental_shared_origin_multi_candidate=pass")
    os.WriteLine(os.Get_stdout(),
                 "semantic_snapshot_incremental_producer_retained_logical_bytes=436")
    os.WriteLine(os.Get_stdout(),
                 "semantic_snapshot_incremental_producer_validation_scratch_logical_bytes=136")
    os.WriteLine(os.Get_stdout(),
                 "semantic_snapshot_incremental_reverse_index_build_count=1")
    os.WriteLine(os.Get_stdout(),
                 "semantic_snapshot_incremental_prebuild_smoke: ok")
