import std/strings as strings

import std/rawbytes as rawbytes



type
    DistributedContent =
        id: str
        postId: str
        taskId: str
        authorSeq: int64
        f_type: str
        publishCategory: str
        userId: str
        userName: str
        avatar: str
        title: str
        content: str
        media: str
        mediaItems: str[]
        tinyPreview: str
        coverMedia: str
        mediaAspectRatio: int64
        likes: int64
        comments: int64
        likePeerIds: str[]
        commentItems: DistributedContentComment[]
        timestamp: int64
        publishState: str
        moderationClass: str
        moderationDecision: str
        visibility: str
        homeEligible: bool
        distributionTags: str[]
        reasonCode: str
        retryCount: int64
        lastAttemptAt: int64
        publishedAt: int64
        tombstoned: bool
        viewerCanAccess: bool
        accessPolicy: str
        isDuplicate: bool
        locationHint: str
    DistributedContentComment =
        id: str
        peerId: str
        userName: str
        content: str
        timestamp: int64



# Deterministic host clock: the app tick sets this each frame; harness and
# digest replay inject fixed values.
var __jsNowMs: int64

fn jsSetNowMs(value: int64) =
    __jsNowMs = value

fn jsDateNow(): int64 =
    return __jsNowMs

fn jsFloorDiv(numer: int64, denom: int64): int64 =
    let q = numer / denom
    let r = numer % denom
    if r != int64(0) && ((numer < int64(0)) != (denom < int64(0))):
        return q - int64(1)
    return q

fn jsIntSqrt(value: int64): int64 =
    if value <= int64(0):
        return int64(0)
    var lo = int64(0)
    var hi = value
    if hi > int64(3037000499):
        hi = int64(3037000499)
    while lo < hi:
        let mid = (lo + hi + int64(1)) / int64(2)
        if mid * mid <= value:
            lo = mid
        else:
            hi = mid - int64(1)
    return lo

# ASCII lowercase; non-ASCII bytes (CJK) pass through unchanged.
@borrows
fn jsStrToLower(value: str): str =
    let n = len(value)
    if n == 0:
        return value
    var b = rawbytes.BytesAlloc(n)
    for i in 0..<n:
        var c = value[i]
        if c >= 65 && c <= 90:
            c = c + 32
        rawbytes.BytesSet(b, i, c)
    return rawbytes.BytesToString(b)



@borrows
fn homeDisplayContents(mergedContents: DistributedContent[], activeCategory: str, sortType: str, searchQuery: str, distanceValue: int64, distanceMax: int64): DistributedContent[] =
    if (!isPublishType(activeCategory)):
        return []
    let __t1_src = mergedContents
    var __t2_filtered: DistributedContent[]
    var __t3_i = 0
    while __t3_i < __t1_src.len:
        let __t4_it = __t1_src[__t3_i]
        if (__t4_it.publishCategory == activeCategory):
            add(__t2_filtered, share(__t4_it))
        __t3_i = __t3_i + 1
    var filtered = __t2_filtered
    if (sortType == "time"):
        let __t5_src = filtered
        var __t6_sorted: DistributedContent[]
        var __t7_i = 0
        while __t7_i < __t5_src.len:
            add(__t6_sorted, share(__t5_src[__t7_i]))
            __t7_i = __t7_i + 1
        __t7_i = 1
        while __t7_i < __t6_sorted.len:
            let __t9_key = __t6_sorted[__t7_i]
            var __t8_j = __t7_i - 1
            var __t10_moving = true
            while __t8_j >= 0 && __t10_moving:
                if (__t9_key.timestamp - __t6_sorted[__t8_j].timestamp) > int64(0):
                    __t6_sorted[__t8_j + 1] = __t6_sorted[__t8_j]
                    __t8_j = __t8_j - 1
                else:
                    __t10_moving = false
            __t6_sorted[__t8_j + 1] = __t9_key
            __t7_i = __t7_i + 1
        filtered = __t6_sorted
    else:
        if (sortType == "distance"):
            var now = jsDateNow()
            let __t11_src = filtered
            var __t12_sorted: DistributedContent[]
            var __t13_i = 0
            while __t13_i < __t11_src.len:
                add(__t12_sorted, share(__t11_src[__t13_i]))
                __t13_i = __t13_i + 1
            __t13_i = 1
            while __t13_i < __t12_sorted.len:
                let __t15_key = __t12_sorted[__t13_i]
                var __t14_j = __t13_i - 1
                var __t16_moving = true
                while __t14_j >= 0 && __t16_moving:
                    let __t17_scoreA = jsFloorDiv((__t12_sorted[__t14_j].likes + (__t12_sorted[__t14_j].comments * int64(2))), jsIntSqrt((jsFloorDiv((now - __t12_sorted[__t14_j].timestamp), ((int64(1000) * int64(60)) * int64(60))) + int64(1))))
                    let __t18_scoreB = jsFloorDiv((__t15_key.likes + (__t15_key.comments * int64(2))), jsIntSqrt((jsFloorDiv((now - __t15_key.timestamp), ((int64(1000) * int64(60)) * int64(60))) + int64(1))))
                    if (__t18_scoreB - __t17_scoreA) > int64(0):
                        __t12_sorted[__t14_j + 1] = __t12_sorted[__t14_j]
                        __t14_j = __t14_j - 1
                    else:
                        __t16_moving = false
                __t12_sorted[__t14_j + 1] = __t15_key
                __t13_i = __t13_i + 1
            filtered = __t12_sorted
        else:
            var now = jsDateNow()
            let __t19_src = filtered
            var __t20_sorted: DistributedContent[]
            var __t21_i = 0
            while __t21_i < __t19_src.len:
                add(__t20_sorted, share(__t19_src[__t21_i]))
                __t21_i = __t21_i + 1
            __t21_i = 1
            while __t21_i < __t20_sorted.len:
                let __t23_key = __t20_sorted[__t21_i]
                var __t22_j = __t21_i - 1
                var __t24_moving = true
                while __t22_j >= 0 && __t24_moving:
                    let __t25_scoreA = jsFloorDiv((__t20_sorted[__t22_j].likes + (__t20_sorted[__t22_j].comments * int64(2))), jsIntSqrt((jsFloorDiv((now - __t20_sorted[__t22_j].timestamp), ((int64(1000) * int64(60)) * int64(60))) + int64(1))))
                    let __t26_scoreB = jsFloorDiv((__t23_key.likes + (__t23_key.comments * int64(2))), jsIntSqrt((jsFloorDiv((now - __t23_key.timestamp), ((int64(1000) * int64(60)) * int64(60))) + int64(1))))
                    if (__t26_scoreB - __t25_scoreA) > int64(0):
                        __t20_sorted[__t22_j + 1] = __t20_sorted[__t22_j]
                        __t22_j = __t22_j - 1
                    else:
                        __t24_moving = false
                __t20_sorted[__t22_j + 1] = __t23_key
                __t21_i = __t21_i + 1
            filtered = __t20_sorted
    if len(searchQuery) > 0:
        var query = jsStrToLower(searchQuery)
        let __t27_src = filtered
        var __t28_filtered: DistributedContent[]
        var __t29_i = 0
        while __t29_i < __t27_src.len:
            let __t30_it = __t27_src[__t29_i]
            var __t31_coal = __t30_it.title
            if len(__t31_coal) == 0:
                __t31_coal = ""
            if (((strings.StrContains(jsStrToLower(__t30_it.content), query) || strings.StrContains(jsStrToLower(__t31_coal), query)) || strings.StrContains(jsStrToLower(searchableContentTags(__t30_it)), query)) && (!__t30_it.isDuplicate)):
                add(__t28_filtered, share(__t30_it))
            __t29_i = __t29_i + 1
        filtered = __t28_filtered
    else:
        let __t32_src = filtered
        var __t33_filtered: DistributedContent[]
        var __t34_i = 0
        while __t34_i < __t32_src.len:
            let __t35_it = __t32_src[__t34_i]
            if (!__t35_it.isDuplicate):
                add(__t33_filtered, share(__t35_it))
            __t34_i = __t34_i + 1
        filtered = __t33_filtered
    return filtered

# extern: PUBLISH_TYPE_VALUES membership (type guard, str domain)
@borrows
fn isPublishType(value: str): bool =
    return value == "content" || value == "movie" || value == "graphic" || value == "music" || value == "novel" || value == "product" || value == "food" || value == "ride" || value == "secondhand" || value == "live" || value == "ad"

# extern: extra(Record) container lands in M2 (recorded M1 limitation)
@borrows
fn searchableContentTags(content: DistributedContent): str =
    return ""


# Differential oracle vs JS evaluation of the displayContents useMemo.
fn mkContent(id: str, category: str, likes: int64, comments: int64, ts: int64, title: str, body: str, dup: bool): DistributedContent =
    var c: DistributedContent
    c.id = id
    c.publishCategory = category
    c.likes = likes
    c.comments = comments
    c.timestamp = ts
    c.title = title
    c.content = body
    c.isDuplicate = dup
    return c

fn main(): int32 =
    jsSetNowMs(int64(362000000))
    var xs: DistributedContent[]
    add(xs, mkContent("c1", "content", int64(10), int64(5), int64(1000000), "苹果手机", "二手苹果", false))
    add(xs, mkContent("c2", "content", int64(100), int64(0), int64(2000000), "香蕉", "新鲜香蕉", false))
    add(xs, mkContent("c3", "movie", int64(999), int64(9), int64(3000000), "电影", "电影内容", false))
    add(xs, mkContent("c4", "content", int64(50), int64(1), int64(1500000), "重复", "重复内容", true))

    # time sort, no search: category+dup filtered, ts desc -> [c2, c1]
    let r1 = homeDisplayContents(xs, "content", "time", "", int64(50), int64(50))
    if r1.len != 2:
        return 1
    if r1[0].id != "c2" || r1[1].id != "c1":
        return 2

    # search 苹果 -> [c1]
    let r2 = homeDisplayContents(xs, "content", "time", "苹果", int64(50), int64(50))
    if r2.len != 1:
        return 3
    if r2[0].id != "c1":
        return 4

    # hot: score c2=10 > c1=2 -> [c2, c1]
    let r3 = homeDisplayContents(xs, "content", "hot", "", int64(50), int64(50))
    if r3.len != 2:
        return 5
    if r3[0].id != "c2":
        return 6

    # non-publish category guard -> []
    let r4 = homeDisplayContents(xs, "bogus", "hot", "", int64(50), int64(50))
    if r4.len != 0:
        return 7
    return 0
