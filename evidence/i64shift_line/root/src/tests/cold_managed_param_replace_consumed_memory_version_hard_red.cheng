fn writeExactText(value: int32, out: var str) =
    out = Fmt"exact-{value}"

fn replaceConsumedText(out: var str) =
    var current: str
    writeExactText(7, current)
    let consumed = current
    out = current
    if len(consumed) == 0:
        out = "unreachable"

fn main(): int32 =
    var result: str
    replaceConsumedText(result)
    return 0
