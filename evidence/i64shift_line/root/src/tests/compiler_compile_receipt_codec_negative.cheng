import std/os
import cheng/core/tooling/compiler_compile_receipt_codec as receipt_codec

fn main(): int32 =
    var receipt: receipt_codec.CompileReceipt
    var err: str
    if receipt_codec.CompileReceiptCodecDecodeStrictInto(
           "", receipt, err):
        os.WriteLine(
            os.Get_stderr(),
            "compile receipt codec accepted empty canonical bytes")
        return 1
    if err.len <= 0:
        os.WriteLine(
            os.Get_stderr(),
            "compile receipt codec rejected without exact reason")
        return 1
    return 0
