# libp2p P2 S2: 真两进程 CAS-source 客户端 exe (正典 §11.6 P2 S2)。
# 空库 → 由已知内容派生 cid → 真 UDP dial 服务端 → 发 WANT → 收 BLOCK →
# 内容寻址硬校验 sha256(data)==cid + 字节精确 data==原 blob。缺块/不符即 abort 非零。
#
# 用法: --port <server bound port> --content <与服务端同一 blob文本>

import std/system
import std/cmdline as cmdline
import std/rawbytes
import cheng/std/bytes_layout as layout
import cheng/libp2p/cas_store as cas
import cheng/libp2p/protocols/cas_source/codec as codec
import cheng/libp2p/host/host_quic as hq
import std/strutils as strutil

fn main(): int32 =
    let port = cmdline.ReadInt32FlagOrDefault("--port", -1)
    let content = cmdline.ReadFlagOrDefault("--content", "")
    assert(port > 0, " client: --port required")
    assert(content != "", " client: --content required")

    # 客户端库为空: 只由已知内容派生 cid (内容寻址标识符), blob 数据靠网络取。
    let cid = cas.CasContentCid(content)
    let cidHex = layout.FixedBytes32Hex(cid)
    var wantCids: layout.FixedBytes32[]
    add(wantCids, cid)

    var outBlocks: codec.CasSourceBlockEntry[]
    let fetchRes = hq.Libp2pHostQuicFetchCasSource("127.0.0.1",
                                                     port,
                                                     "localhost",
                                                     wantCids,
                                                     outBlocks)
    assert(fetchRes.ok, " client: fetch: " + Error(fetchRes))
    assert(fetchRes.value == 1, " client: exactly 1 block returned")
    assert(outBlocks.len == 1, " client: 1 out block")
    assert(layout.FixedBytes32Equal(outBlocks[0].cid, cid), " client: block cid == requested cid")

    # 字节精确: 收到的 blob == 原 blob。
    let expected = BytesFromString(content)
    assert(BytesEqual(outBlocks[0].data, expected), " client: BLOCK bytes == original blob (byte-exact)")

    echo(strutil.Join([" cas_source client fetched cid=",
                       cidHex,
                       " bytes=",
                       IntToStr(BytesLen(outBlocks[0].data))], ""))
    echo(" cas_source_quic_twoproc_client ok")
    return 0
