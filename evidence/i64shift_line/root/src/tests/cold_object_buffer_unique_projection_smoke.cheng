import std/rawbytes
import cheng/core/backend/object_buffer as obuf

fn main(): int32 =
    var buffer = obuf.ObjectBufferInit(1)
    for value in 0..<96:
        obuf.ObjectBufferWriteU8(buffer, value)
    var bytes = obuf.ObjectBufferTakeBytes(buffer)
    if rawbytes.BytesLen(bytes) != 96 ||
       rawbytes.BytesGet(bytes, 0) != 0 ||
       rawbytes.BytesGet(bytes, 95) != 95:
        rawbytes.BytesFree(bytes)
        return 1
    rawbytes.BytesFree(bytes)
    return 0
