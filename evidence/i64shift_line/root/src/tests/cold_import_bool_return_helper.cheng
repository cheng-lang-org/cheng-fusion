import std/rawbytes

type
    ColdImportBoolFe =
        v0: int64
        v1: int64
        v2: int64
        v3: int64
        v4: int64
        v5: int64
        v6: int64
        v7: int64
        v8: int64
        v9: int64

    ColdImportBoolPoint =
        x: ColdImportBoolFe
        y: ColdImportBoolFe
        z: ColdImportBoolFe
        t: ColdImportBoolFe

fn ColdImportBoolInner(p: var ColdImportBoolPoint, b: Bytes): bool =
    p.y.v0 = int64(BytesLen(b))
    return p.y.v0 == int64(32)

fn ColdImportBoolOuter(p: var ColdImportBoolPoint, b: Bytes): bool =
    return ColdImportBoolInner(p, b)
