# Repro + regression guard for QUIC interop gap B (task #47): the 1-RTT/Short
# packet frame decoder (msquicNativeHandleAppPayloadFrame, called in a loop by
# msquicNativeProcessShortDirect) decoded every frame unconditionally as the
# codebase's uniform 5-field (kind, stream, offset, value, data) tuple, with no
# dispatch on frame type -- the same class of bug d1190e1f4 fixed for the
# Initial/Handshake-space CRYPTO frame loops, just never applied to this
# Short-space path. RFC 9000 §19.2/§19.3: PING (0x01) and PADDING (0x00) carry
# no fields at all beyond the 1-byte type -- a real peer's 1-RTT keepalive PING
# (or a padding run) walked into the 5-field decode and rejected the frame,
# and msquicNativeAppPayloadDecodeErrorIsDrop then silently discarded the
# *entire* short packet on that decode error -- including any real DATA frame
# carried in the same packet before the PING/PADDING (real data loss, not just
# a keepalive being ignored).
#
# This builds a real PADDING run + a real PING frame (both true RFC 9000
# wire bytes: a run of bare 0x00 / a bare 0x01, exactly what an independent
# peer emits -- NOT packet_model's uniform 5-tuple shape, which this
# codebase's own peer never uses for these two types), placed BEFORE one real
# DATA frame (this codebase's own uniform frame wire encoding,
# cheng/quic/core/packet_model.cheng -- "existing support", unchanged by this
# fix) carrying real payload bytes, and feeds the mix straight into
# msquicNativeProcessShortDirect. The PADDING/PING must come first: before
# the fix, the naive 5-field decode misreads their bytes as bogus
# kind/stream/offset/value/len fields, desyncing the cursor so it never lands
# back on the real DATA frame's own kind byte -- it instead starts consuming
# the DATA frame's own header/payload bytes as further bogus fields, which
# eventually produces a wildly wrong length and a "frame data truncated"
# error; that error is on the drop list, so the *entire* packet -- the real
# DATA frame included -- is silently discarded (no data received, no error
# surfaced). After the fix: PADDING/PING are each consumed as exactly the
# single byte RFC 9000 defines, the cursor never desyncs, and the DATA
# frame's bytes land in the app recv buffer intact.

import std/result
import std/rawbytes
import cheng/quic/native_runtime as qnative
import cheng/quic/core/packet_model as packet_model

fn buildPaddingRun(n: int32): rawbytes.Bytes =
    # RFC 9000 §19.3: PADDING is the single byte 0x00, repeated -- not this
    # codebase's uniform 5-tuple frame shape (real independent peers never
    # wrap PADDING that way, and BytesAlloc already zero-fills).
    return BytesAlloc(n)

fn buildPingByte(): rawbytes.Bytes =
    # RFC 9000 §19.2: PING is the single byte 0x01, nothing else.
    let b: rawbytes.Bytes = BytesAlloc(1)
    BytesSet(b, 0, 1)
    return b

fn main(): int32 =
    let recvSide: int32 = qnative.msquicNativeServerSide
    let streamId: int64 = 0 # client-initiated bidi, readable by the server.
    let appData: rawbytes.Bytes = BytesFromString("hello-1rtt-real-data-after-ping-padding")

    var pkt: packet_model.MsQuicPacket
    let addDataRes: Result[bool] = packet_model.MsQuicPacketAddFrameParts(pkt, int64(14), streamId, int64(0), int64(0), appData)
    if IsErr(addDataRes):
        panic(ErrorText(addDataRes))
    let dataFrame: rawbytes.Bytes = pkt.payload
    assert(BytesLen(dataFrame) > 0, "DATA frame built")

    let pingFrame: rawbytes.Bytes = buildPingByte()
    let padding: rawbytes.Bytes = buildPaddingRun(40)

    let payload: rawbytes.Bytes = BytesConcat3(padding, pingFrame, dataFrame)

    let ok: bool = qnative.msquicNativeProcessShortDirect(recvSide, int64(1), payload)
    assert(ok, "1-RTT frame loop did not error out on trailing PING+PADDING")

    let available: int32 = qnative.msquicNativeAppRecvAvailable(recvSide, streamId)
    assert(available == BytesLen(appData), "real DATA frame bytes survived trailing PING+PADDING, not silently dropped with the rest of the packet")
    let received: rawbytes.Bytes = qnative.msquicNativeAppRecvConsume(recvSide, streamId, available)
    assert(BytesEqual(received, appData), "received bytes match what was sent")

    echo(" quic_short_padding_ping_frame_smoke ok")
    return 0
