type
        # Deeper trivia must not define the grouped type entry indentation.
    // Same-level trivia must not become a synthetic type declaration.
    GroupedTypeLeadingCommentRecord =
        # Nested field trivia remains part of the real declaration.
        value: int32
        // Both Cheng comment forms are legal inside the object body.
        delta: int32

    # Same-level trivia between entries must not split into a fake member.
    // The following real entry must remain visible to importers.
    GroupedTypeLeadingCommentTail =
        value: int32
