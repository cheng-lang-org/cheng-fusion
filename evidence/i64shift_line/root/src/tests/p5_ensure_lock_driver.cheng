# libp2p P5-S1 三进程门: fresh node 缺锁自举 driver (设计案卷 §2d 主流程前半)。
#
# 调生产级 CasSubprocessEnsureLock(channelId, modulePath, store): 从 channelId 一跳自证展开
# 整依赖集 lock —— fork net_cas_cli fetch-head (head OR-liveness 首个自证+验签+请求绑定通过者胜
# + 撤销并集任一命中即硬拒) → head.headCid → 按 cid 拉 manifest blob (per-peer OR + admit 自校验)
# → sha256(manifest)==headCid 校验 + 解码 → 逐 entry 落 index.lock.txt。编译器进程零 QUIC
# (QUIC 闭包只活在被 fork 的 net_cas_cli 子进程)。
#
# 这是【被延后的 driver miss-hook 自举】的独立进程等价体: parser miss-hook 会调同一函数
# (parser.cheng:8622 parserCasLockEnsurerImpl), 但 dispatch_min 未接 ParserSetCasLockEnsurer
# (件4 driver wiring 延后)。本 driver 直调该生产函数, 门证 channelId→head→manifest→lock 全链。
#
# env: CHENG_CAS_CLI (net_cas_cli 路径) + CHENG_CAS_BOOTSTRAP (逗号列表) / CHENG_CAS_FETCH_FROM (单项)。
# 用法: --channel <64hex> --module <modulePath> --store <dir>
# 生产纪律: 任一步失败 (head 验签败 / headCid 不匹配 / manifest 非法 / cid 拉不到 / 撤销命中) = 非零退出。

import std/system
import std/result
import std/cmdline as cmdline
import cheng/core/tooling/cas_fetch_subprocess as ensurer
import cheng/libp2p/cas_store as cas
import std/strutils as strutil

fn main(): int32 =
    let channel = cmdline.ReadFlagOrDefault("--channel", "")
    let modulePath = cmdline.ReadFlagOrDefault("--module", "")
    let store = cmdline.ReadFlagOrDefault("--store", "")
    if channel == "":
        echo(" p5-ensure: --channel <64hex> required")
        return 2
    if modulePath == "":
        echo(" p5-ensure: --module <modulePath> required")
        return 2
    if store == "":
        echo(" p5-ensure: --store <dir> required")
        return 2

    var res: Result[bool] = ensurer.CasSubprocessEnsureLock(channel, modulePath, store)
    if IsErr(res):
        echo(strutil.Join([" p5-ensure: FAIL ", Error(res)], ""))
        return 1

    # 回读 lock 证 module cid 已落 (缺 = 硬错)。
    var loadRes = cas.CasLockLoad(store)
    if IsErr(loadRes):
        echo(strutil.Join([" p5-ensure: lock load: ", Error(loadRes)], ""))
        return 1
    let cid = cas.CasLockLookup(Value(loadRes), modulePath)
    if cid == "":
        echo(strutil.Join([" p5-ensure: lock 无 module 条目 (自举失败): ", modulePath], ""))
        return 1
    echo(strutil.Join([" p5-ensure: ENSURED module=", modulePath, " cid=", cid], ""))
    return 0
