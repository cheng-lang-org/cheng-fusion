import std/os
import std/strings
import std/strutils as strutil
import cheng/core/backend/lowering_plan as lower
import cheng/core/backend/primary_object_plan as pobj
import cheng/core/backend/system_link_plan as slplan
import cheng/core/tooling/compiler_request as creq
import cheng/core/tooling/path as chengpath
import cheng/core/lang/typed_expr as texpr

fn buildExportPlan(workspaceRoot: str,
                   packageRoot: str,
                   sourcePath: str,
                   outputPath: str,
                   exportRoot: str,
                   linkPlan: var slplan.SystemLinkPlanStub,
                   plan: var lower.LoweringPlanStub) =
    let req0 = creq.CompilerRequestNew(
        packageRoot,
        sourcePath,
        outputPath,
        "aarch64-linux-android",
        creq.EmitObj,
        ""
    )
    let req = creq.CompilerRequestWithExportRootSymbols(req0, [exportRoot])
    var err = ""
    assert(slplan.BuildSystemLinkPlanStub(workspaceRoot, req, linkPlan, err),
           strutil.Join([" primary pure cast return: link plan ", err], ""))
    assert(linkPlan.missingReasons.len == 0,
           " primary pure cast return: link plan ready")
    assert(lower.BuildLoweringPlanStub(linkPlan, plan, err),
           strutil.Join([" primary pure cast return: lowering ", err], ""))

fn findFunction(plan: lower.LoweringPlanStub,
                functionName: str,
                signatureLineNumber: int32): int32 =
    for i in 0..<plan.primaryObjectIr.functions.len:
        if plan.primaryObjectIr.functions[i].functionName == functionName &&
           plan.primaryObjectIr.functions[i].signatureLineNumber == signatureLineNumber:
            return i
    return -1

fn findPrimaryByIrIndex(primary: pobj.PrimaryObjectPlan,
                        irIndex: int32): int32 =
    for i in 0..<primary.symbolNames.len:
        if primary.functionIrIndexes[i] == irIndex:
            return i
    return -1

# 删文本路径 #1：i32 whole-fn-op bodyKind 族（BodyKindReturnI32Arg0 等）已删，i32
# pure-cast return 改走 node 路径。i64/f64 的 whole-fn-op bodyKind 仍保留，故这些函数
# 删除后仍下降为原 bodyKind 并进 primary symbol（带固定 word count）；本 helper 校验那批。
fn assertWholeFnOpReturn(root: str,
                         functionName: str,
                         signatureLineNumber: int32,
                         expectedBodyKind: str,
                         expectedWordCount: int32) =
    let sourcePath = os.JoinPath(root, "src/std/system.cheng")
    let outDir = chengpath.PathAbsolute(root, "artifacts/primary_pure_cast_return")
    assert(chengpath.MkdirP(root, outDir), " primary pure cast return: mkdir")
    let outputPath = os.JoinPath(outDir,
                                 strutil.Join([functionName,
                                               "_L",
                                               strings.IntToStr(signatureLineNumber),
                                               ".o"], ""))
    var linkPlan: slplan.SystemLinkPlanStub
    var plan: lower.LoweringPlanStub
    buildExportPlan(root,
                    root,
                    sourcePath,
                    outputPath,
                    functionName,
                    linkPlan,
                    plan)
    let functionIndex = findFunction(plan, functionName, signatureLineNumber)
    if functionIndex < 0:
        os.WriteLine(os.GetStderr(), lower.LoweringPlanStubReport(plan))
    assert(functionIndex >= 0,
           strutil.Join([" primary pure cast return: find ",
                         functionName,
                         " line ",
                         strings.IntToStr(signatureLineNumber)], ""))
    let fnIr = plan.primaryObjectIr.functions[functionIndex]
    assert(fnIr.bodyKind == expectedBodyKind,
           strutil.Join([" primary pure cast return: body kind ", functionName], ""))
    assert(fnIr.callTargets.len == 0,
           strutil.Join([" primary pure cast return: no call target ", functionName], ""))
    assert(fnIr.callArgCounts.len == 0,
           strutil.Join([" primary pure cast return: no call arg count ", functionName], ""))
    let primary = pobj.BuildPrimaryObjectPlan(linkPlan, plan)
    let primaryIndex = findPrimaryByIrIndex(primary, functionIndex)
    assert(primaryIndex >= 0,
           strutil.Join([" primary pure cast return: primary symbol ", functionName], ""))
    assert(primaryIndex < primary.functionBodyKinds.len &&
           primary.functionBodyKinds[primaryIndex] == expectedBodyKind,
           strutil.Join([" primary pure cast return: primary body kind ", functionName], ""))
    assert(primaryIndex < primary.functionWordCounts.len &&
           primary.functionWordCounts[primaryIndex] == expectedWordCount,
           strutil.Join([" primary pure cast return: primary word count ", functionName], ""))

# i32 透传 `fn Int32(x: int32) = return x`：删除 BodyKindReturnI32Arg0 后走 node 通用
# statement_sequence 形态（word count 是节点 codegen 产物，不锁死数值，断言非空 body 即可）。
fn assertNodeStatementSequenceReturn(root: str,
                                     functionName: str,
                                     signatureLineNumber: int32) =
    let sourcePath = os.JoinPath(root, "src/std/system.cheng")
    let outDir = chengpath.PathAbsolute(root, "artifacts/primary_pure_cast_return")
    assert(chengpath.MkdirP(root, outDir), " primary pure cast return: mkdir")
    let outputPath = os.JoinPath(outDir,
                                 strutil.Join([functionName,
                                               "_L",
                                               strings.IntToStr(signatureLineNumber),
                                               ".o"], ""))
    var linkPlan: slplan.SystemLinkPlanStub
    var plan: lower.LoweringPlanStub
    buildExportPlan(root,
                    root,
                    sourcePath,
                    outputPath,
                    functionName,
                    linkPlan,
                    plan)
    let functionIndex = findFunction(plan, functionName, signatureLineNumber)
    if functionIndex < 0:
        os.WriteLine(os.GetStderr(), lower.LoweringPlanStubReport(plan))
    assert(functionIndex >= 0,
           strutil.Join([" primary pure cast return: find ",
                         functionName,
                         " line ",
                         strings.IntToStr(signatureLineNumber)], ""))
    let fnIr = plan.primaryObjectIr.functions[functionIndex]
    assert(fnIr.bodyKind == texpr.BodyKindStatementSequence,
           strutil.Join([" primary pure cast return: node body kind ", functionName], ""))
    let primary = pobj.BuildPrimaryObjectPlan(linkPlan, plan)
    let primaryIndex = findPrimaryByIrIndex(primary, functionIndex)
    assert(primaryIndex >= 0,
           strutil.Join([" primary pure cast return: node primary symbol ", functionName], ""))
    assert(primaryIndex < primary.functionBodyKinds.len &&
           primary.functionBodyKinds[primaryIndex] == texpr.BodyKindStatementSequence,
           strutil.Join([" primary pure cast return: node primary body kind ", functionName], ""))
    assert(primaryIndex < primary.functionWordCounts.len &&
           primary.functionWordCounts[primaryIndex] >= 1,
           strutil.Join([" primary pure cast return: node primary non-empty body ", functionName], ""))

# i32 cast-call 透传 `fn Int8(x: int32) = return int8(x)` 等：删文本路径子系统 #4
# (return_call_*_i32 whole-fn-op) 后，这类 return-call 不再被前端特判成
# return_call_arg0_i32，改走 node 通用 statement_sequence 形态并生成独立 primary
# body symbol（primaryIndex>=0），与 assertNodeStatementSequenceReturn 行为一致。
fn assertCallPassthroughReturn(root: str,
                               functionName: str,
                               signatureLineNumber: int32) =
    let sourcePath = os.JoinPath(root, "src/std/system.cheng")
    let outDir = chengpath.PathAbsolute(root, "artifacts/primary_pure_cast_return")
    assert(chengpath.MkdirP(root, outDir), " primary pure cast return: mkdir")
    let outputPath = os.JoinPath(outDir,
                                 strutil.Join([functionName,
                                               "_L",
                                               strings.IntToStr(signatureLineNumber),
                                               ".o"], ""))
    var linkPlan: slplan.SystemLinkPlanStub
    var plan: lower.LoweringPlanStub
    buildExportPlan(root,
                    root,
                    sourcePath,
                    outputPath,
                    functionName,
                    linkPlan,
                    plan)
    let functionIndex = findFunction(plan, functionName, signatureLineNumber)
    if functionIndex < 0:
        os.WriteLine(os.GetStderr(), lower.LoweringPlanStubReport(plan))
    assert(functionIndex >= 0,
           strutil.Join([" primary pure cast return: find ",
                         functionName,
                         " line ",
                         strings.IntToStr(signatureLineNumber)], ""))
    let fnIr = plan.primaryObjectIr.functions[functionIndex]
    assert(fnIr.bodyKind == texpr.BodyKindStatementSequence,
           strutil.Join([" primary pure cast return: call passthrough body kind ", functionName], ""))
    let primary = pobj.BuildPrimaryObjectPlan(linkPlan, plan)
    let primaryIndex = findPrimaryByIrIndex(primary, functionIndex)
    assert(primaryIndex >= 0,
           strutil.Join([" primary pure cast return: call passthrough primary symbol ", functionName], ""))
    assert(primaryIndex < primary.functionBodyKinds.len &&
           primary.functionBodyKinds[primaryIndex] == texpr.BodyKindStatementSequence,
           strutil.Join([" primary pure cast return: call passthrough primary body kind ", functionName], ""))
    assert(primaryIndex < primary.functionWordCounts.len &&
           primary.functionWordCounts[primaryIndex] >= 1,
           strutil.Join([" primary pure cast return: call passthrough non-empty body ", functionName], ""))

fn main(): int32 =
    let root = os.GetCurrentDir()
    # i32 透传 `return x`：node statement_sequence。
    assertNodeStatementSequenceReturn(root, "Int32", 518)
    # i32 cast-call 透传 `return int32(x)`/`return int8(x)` 等：node call-passthrough。
    assertCallPassthroughReturn(root, "Int32", 520)
    assertCallPassthroughReturn(root, "Int32", 522)
    assertCallPassthroughReturn(root, "Int8", 510)
    assertCallPassthroughReturn(root, "UInt8", 546)
    assertCallPassthroughReturn(root, "Int16", 514)
    assertCallPassthroughReturn(root, "UInt16", 550)
    assertCallPassthroughReturn(root, "UInt32", 554)
    # i64/f64 whole-fn-op bodyKind 未删，仍下降为原 bodyKind 并进 primary symbol。
    assertWholeFnOpReturn(root, "Int64", 530, texpr.BodyKindReturnI64FromI32Arg0, 2)
    assertWholeFnOpReturn(root, "Int64", 532, texpr.BodyKindReturnI64Arg0, 1)
    assertWholeFnOpReturn(root, "UInt64", 558, texpr.BodyKindReturnI64FromI32Arg0, 2)
    assertWholeFnOpReturn(root, "UInt64", 560, texpr.BodyKindReturnI64Arg0, 1)
    assertWholeFnOpReturn(root, "UInt64", 562, texpr.BodyKindReturnI64Arg0, 1)
    assertWholeFnOpReturn(root, "Float64", 536, texpr.BodyKindReturnF64FromI32Arg0, 2)
    assertWholeFnOpReturn(root, "Float64", 538, texpr.BodyKindReturnF64FromI64Arg0, 2)
    assertWholeFnOpReturn(root, "Float64", 540, texpr.BodyKindReturnF64Arg0, 1)
    echo(" primary_pure_cast_return_smoke ok")
    return 0
