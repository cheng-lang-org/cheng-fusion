import std/seqs as seqs

fn mutateConsecutive(values: var str[]) =
    values[0] = "first"
    values[1] = "second"
    seqs.SetLen(values, 4)
    seqs.SetLen(values, 3)

fn main(): int32 =
    var values: str[] = ["old-first", "old-second"]
    mutateConsecutive(values)
    if values.len != 3:
        return 1
    if values[0] != "first" || values[1] != "second":
        return 2
    if len(values[2]) != 0:
        return 3
    return 0

main()
