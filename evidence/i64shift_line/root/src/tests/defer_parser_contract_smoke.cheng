import std/strutils as strutil
import cheng/core/lang/parser

fn findKind(layer: parser.NormalizedExprLayer,
            kind: parser.NormalizedExprKind): int32 =
    for i in 0..<layer.exprs.len:
        if layer.exprs[i].kind == kind:
            return i
    return -1

fn findKindAtLine(layer: parser.NormalizedExprLayer,
                  kind: parser.NormalizedExprKind,
                  lineNumber: int32): int32 =
    for i in 0..<layer.exprs.len:
        if layer.exprs[i].kind == kind && layer.exprs[i].lineNumber == lineNumber:
            return i
    return -1

fn findCallAtLine(layer: parser.NormalizedExprLayer,
                  lineNumber: int32): int32 =
    for i in 0..<layer.exprs.len:
        if layer.exprs[i].kind == parser.NormalizedExprCall &&
           layer.exprs[i].lineNumber == lineNumber &&
           layer.exprs[i].callCallee == "cleanup":
            return i
    return -1

fn findNamedCallAtLine(layer: parser.NormalizedExprLayer,
                       lineNumber: int32,
                       callee: str): int32 =
    for i in 0..<layer.exprs.len:
        if layer.exprs[i].kind == parser.NormalizedExprCall &&
           layer.exprs[i].lineNumber == lineNumber &&
           layer.exprs[i].callCallee == callee:
            return i
    return -1

fn deferOwnerFactCount(layer: parser.NormalizedExprLayer,
                       ownerStatementOrdinal: int32): int32 =
    var count: int32
    for i in 0..<layer.exprs.len:
        if layer.exprs[i].deferOwnerStatementOrdinal == ownerStatementOrdinal:
            count = count + 1
    return count

fn scopeAncestryHasOwner(layer: parser.NormalizedExprLayer,
                         scopeIdRaw: int32,
                         ownerStatementOrdinal: int32): bool =
    var scopeId = scopeIdRaw
    var remaining = layer.scopes.len + 1
    while scopeId >= 0 && scopeId < layer.scopes.len && remaining > 0:
        if layer.scopes[scopeId].ownerStatementOrdinal == ownerStatementOrdinal:
            return true
        scopeId = layer.scopes[scopeId].parentScopeId
        remaining = remaining - 1
    return false

fn assertRejected(label: str,
                  sourceText: str,
                  expectedError: str) =
    var layer: parser.NormalizedExprLayer
    var err = ""
    assert(!parser.ParserReadNormalizedExprLayerFromText(Fmt"defer_parser_{label}.cheng",
                                                           sourceText,
                                                           layer,
                                                           err),
           Fmt" defer parser: {label} must fail")
    assert(parser.NormalizedExprLayerCallCount(layer) == 0,
           Fmt" defer parser: {label} must not leak ordinary calls")
    assert(layer.exprs.len == 0 && layer.scopes.len == 0 &&
           layer.sourceCount == 0 && layer.questionResidualCount == 0,
           Fmt" defer parser: {label} failure must be atomic")
    assert(strutil.Contains(err, expectedError),
           Fmt" defer parser: {label} error={err}")

fn assertBlockContract() =
    let sourceText = strutil.Join([
        "fn cleanup(value: int32) =",
        "    let held = value",
        "",
        "fn sample(flag: bool): int32 =",
        "    var local: int32",
        "    defer:",
        "        local = 1",
        "        cleanup(1)",
        "        if flag:",
        "            cleanup(2)",
        "    while flag:",
        "        break",
        "    while flag:",
        "        continue",
        "    return 7"
    ], "\n")
    var layer: parser.NormalizedExprLayer
    var err = ""
    assert(parser.ParserReadNormalizedExprLayerFromText("defer_parser_block.cheng",
                                                          sourceText,
                                                          layer,
                                                          err),
           Fmt" defer parser: block parse error={err}")
    assert(parser.NormalizedExprLayerDeferStmtCount(layer) == 1,
           " defer parser: one defer statement")
    assert(parser.NormalizedExprLayerBreakStmtCount(layer) == 1,
           " defer parser: one break statement")
    assert(parser.NormalizedExprLayerContinueStmtCount(layer) == 1,
           " defer parser: one continue statement")
    assert(parser.NormalizedExprLayerCallCount(layer) == 2,
           " defer parser: deferred calls remain structured")
    let deferIndex = findKind(layer, parser.NormalizedExprDeferStmt)
    assert(deferIndex >= 0, " defer parser: defer node")
    let deferExpr = layer.exprs[deferIndex]
    assert(deferExpr.surfaceText == "defer:", " defer parser: defer surface")
    assert(deferExpr.lineNumber == 6 && deferExpr.columnNumber == 5,
           " defer parser: defer start span")
    assert(deferExpr.endLineNumber == 10 && deferExpr.endColumnNumber == 22,
           " defer parser: defer suite span")
    assert(deferExpr.statementOrdinal == 0 && deferExpr.lexicalOrdinal == 0,
           " defer parser: defer ordinals")
    assert(deferExpr.lexicalScopeId > 0,
           " defer parser: defer lexical scope")
    assert(deferExpr.suiteScopeId > deferExpr.lexicalScopeId &&
           deferExpr.suiteScopeId < layer.scopes.len,
           " defer parser: defer suite scope id")
    let suiteScope = layer.scopes[deferExpr.suiteScopeId]
    assert(suiteScope.kind == parser.NormalizedScopeDeferSuite,
           " defer parser: defer suite scope kind")
    assert(suiteScope.parentScopeId == deferExpr.lexicalScopeId,
           " defer parser: defer suite parent")
    assert(suiteScope.ownerStatementOrdinal == deferExpr.statementOrdinal,
           " defer parser: defer suite owner")
    assert(suiteScope.startLineNumber == 7 && suiteScope.startColumnNumber == 9,
           " defer parser: suite start span")
    assert(suiteScope.endLineNumber == 10 && suiteScope.endColumnNumber == 22,
           " defer parser: suite end span")
    assert(deferExpr.deferOwnerStatementOrdinal == -1,
           " defer parser: registration is not its own body")
    let assignIndex = findKindAtLine(layer, parser.NormalizedExprAssign, 7)
    let firstCallIndex = findCallAtLine(layer, 8)
    let ifStmtIndex = findKindAtLine(layer, parser.NormalizedExprIfStmt, 9)
    let secondCallIndex = findCallAtLine(layer, 10)
    assert(assignIndex >= 0 && firstCallIndex >= 0 && ifStmtIndex >= 0 && secondCallIndex >= 0,
           " defer parser: block body facts retained")
    assert(deferOwnerFactCount(layer, deferExpr.statementOrdinal) == 5,
           Fmt" defer parser: block deferred fact count={deferOwnerFactCount(layer, deferExpr.statementOrdinal)}")
    assert(layer.exprs[assignIndex].deferOwnerStatementOrdinal == deferExpr.statementOrdinal &&
           layer.exprs[assignIndex].lexicalScopeId == deferExpr.suiteScopeId,
           " defer parser: assignment owner and scope")
    assert(layer.exprs[firstCallIndex].deferOwnerStatementOrdinal == deferExpr.statementOrdinal &&
           layer.exprs[firstCallIndex].lexicalScopeId == deferExpr.suiteScopeId,
           " defer parser: first call owner and scope")
    assert(layer.exprs[ifStmtIndex].deferOwnerStatementOrdinal == deferExpr.statementOrdinal &&
           layer.exprs[ifStmtIndex].lexicalScopeId == deferExpr.suiteScopeId,
           " defer parser: control owner and scope")
    assert(layer.exprs[secondCallIndex].deferOwnerStatementOrdinal == deferExpr.statementOrdinal &&
           layer.exprs[secondCallIndex].lexicalScopeId != deferExpr.lexicalScopeId &&
           layer.scopes[layer.exprs[secondCallIndex].lexicalScopeId].parentScopeId == deferExpr.suiteScopeId,
           " defer parser: nested call owner and suite ancestry")
    let breakIndex = findKind(layer, parser.NormalizedExprBreakStmt)
    let continueIndex = findKind(layer, parser.NormalizedExprContinueStmt)
    assert(breakIndex >= 0 && layer.exprs[breakIndex].suiteScopeId == -1,
           " defer parser: break structured node")
    assert(continueIndex >= 0 && layer.exprs[continueIndex].suiteScopeId == -1,
           " defer parser: continue structured node")
    assert(layer.exprs[breakIndex].deferOwnerStatementOrdinal == -1 &&
           layer.exprs[continueIndex].deferOwnerStatementOrdinal == -1,
           " defer parser: normal control facts are not deferred")
    let ifIndex = findKindAtLine(layer, parser.NormalizedExprIfStmt, 9)
    let firstWhileIndex = findKindAtLine(layer, parser.NormalizedExprWhileStmt, 11)
    let secondWhileIndex = findKindAtLine(layer, parser.NormalizedExprWhileStmt, 13)
    assert(ifIndex >= 0 && firstWhileIndex >= 0 && secondWhileIndex >= 0,
           " defer parser: structured suite headers retained")
    assert(layer.exprs[ifIndex].statementOrdinal >= 0 &&
           layer.exprs[ifIndex].suiteScopeId >= 0 &&
           layer.scopes[layer.exprs[ifIndex].suiteScopeId].ownerStatementOrdinal == layer.exprs[ifIndex].statementOrdinal,
           " defer parser: if suite owner")
    assert(scopeAncestryHasOwner(layer,
                                 layer.exprs[breakIndex].lexicalScopeId,
                                 layer.exprs[firstWhileIndex].statementOrdinal),
           " defer parser: break ancestry reaches first while owner")
    assert(scopeAncestryHasOwner(layer,
                                 layer.exprs[continueIndex].lexicalScopeId,
                                 layer.exprs[secondWhileIndex].statementOrdinal),
           " defer parser: continue ancestry reaches second while owner")

fn assertInlineSuiteContract() =
    let sourceText = strutil.Join([
        "fn cleanup(value: int32) =",
        "    let held = value",
        "",
        "fn sample() =",
        "    defer: cleanup(1)"
    ], "\n")
    var layer: parser.NormalizedExprLayer
    var err = ""
    assert(parser.ParserReadNormalizedExprLayerFromText("defer_parser_inline.cheng",
                                                          sourceText,
                                                          layer,
                                                          err),
           Fmt" defer parser: inline suite parse error={err}")
    assert(parser.NormalizedExprLayerDeferStmtCount(layer) == 1,
           " defer parser: inline defer statement")
    assert(parser.NormalizedExprLayerCallCount(layer) == 1,
           " defer parser: inline deferred call retained")
    let deferIndex = findKind(layer, parser.NormalizedExprDeferStmt)
    assert(deferIndex >= 0, " defer parser: inline defer node")
    let deferExpr = layer.exprs[deferIndex]
    assert(deferExpr.lineNumber == deferExpr.endLineNumber,
           " defer parser: inline defer single-line span")
    assert(deferExpr.suiteScopeId >= 0 &&
           layer.scopes[deferExpr.suiteScopeId].kind == parser.NormalizedScopeDeferSuite,
           " defer parser: inline defer suite scope")
    let callIndex = findCallAtLine(layer, 5)
    assert(callIndex >= 0, " defer parser: inline call fact")
    let callExpr = layer.exprs[callIndex]
    assert(callExpr.columnNumber == 12,
           " defer parser: inline call original column")
    assert(callExpr.deferOwnerStatementOrdinal == deferExpr.statementOrdinal &&
           callExpr.lexicalScopeId == deferExpr.suiteScopeId,
           " defer parser: inline call owner and scope")
    assert(deferOwnerFactCount(layer, deferExpr.statementOrdinal) == 1,
           " defer parser: inline deferred fact count")

fn assertInvalidContracts() =
    assertRejected("shorthand",
                   strutil.Join(["fn sample() =", "    defer cleanup()"], "\n"),
                   "defer syntax requires 'defer: suite'")
    assertRejected("empty",
                   strutil.Join(["fn sample() =", "    defer:"], "\n"),
                   "defer suite is empty")
    assertRejected("bad_indent",
                   strutil.Join([
                       "fn sample() =",
                       "    defer:",
                       "        let value = 1",
                       "      let other = 2"
                   ], "\n"),
                   "defer suite indentation is invalid")
    let forbiddenBodies = [
        "return 1",
        "yield 1",
        "break",
        "continue",
        "await cleanup()",
        "defer: cleanup()",
        "if true: return 1"
    ]
    let forbiddenKeywords = [
        "return",
        "yield",
        "break",
        "continue",
        "await",
        "defer",
        "return"
    ]
    for i in 0..<forbiddenBodies.len:
        let sourceText = strutil.Join([
            "fn cleanup() =",
            "    let value = 1",
            "",
            "fn sample() =",
            "    defer:",
            strutil.Join(["        ", forbiddenBodies[i]], "")
        ], "\n")
        assertRejected(Fmt"forbidden_{i}",
                       sourceText,
                       Fmt"defer suite forbids '{forbiddenKeywords[i]}'")

fn assertSimpleEntryContract() =
    let sourceText = strutil.Join([
        "fn sample() =",
        "    defer:",
        "        value = 1"
    ], "\n")
    var layer: parser.NormalizedExprLayer
    var err = ""
    assert(parser.ParserReadSimpleSurfaceStmtExprLayerFromText("defer_parser_simple.cheng",
                                                                sourceText,
                                                                layer,
                                                                err),
           Fmt" defer parser: simple entry parse error={err}")
    assert(parser.NormalizedExprLayerDeferStmtCount(layer) == 1,
           " defer parser: simple entry defer node")
    let deferIndex = findKind(layer, parser.NormalizedExprDeferStmt)
    let assignIndex = findKind(layer, parser.NormalizedExprAssign)
    assert(deferIndex >= 0 && assignIndex >= 0 &&
           layer.exprs[assignIndex].deferOwnerStatementOrdinal == layer.exprs[deferIndex].statementOrdinal &&
           layer.exprs[assignIndex].lexicalScopeId == layer.exprs[deferIndex].suiteScopeId,
           " defer parser: simple entry assignment owner")
    let shorthand = strutil.Join(["fn sample() =", "    defer cleanup()"], "\n")
    assert(!parser.ParserReadSimpleSurfaceStmtExprLayerFromText("defer_parser_simple_bad.cheng",
                                                                 shorthand,
                                                                 layer,
                                                                 err),
           " defer parser: simple entry shorthand must fail")
    assert(layer.exprs.len == 0 && layer.scopes.len == 0 &&
           layer.sourceCount == 0 && layer.questionResidualCount == 0,
           " defer parser: simple entry failure must be atomic")
    assert(strutil.Contains(err, "defer syntax requires 'defer: suite'"),
           Fmt" defer parser: simple entry shorthand error={err}")

fn assertQualifierShadowUsesExplicitLines() =
    var currentLines = [
        "fn sample(qual: SomeType) =",
        "    qual.Run()"
    ]
    let sourceText = strutil.Join(currentLines, "\n")
    var currentProfile: parser.NormalizedExprCallProfile
    currentProfile.sourcePath = "defer_parser_shadow.cheng"
    currentProfile.text = sourceText
    currentProfile.lines = []
    var sampleDecl: parser.NormalizedFunctionDecl
    sampleDecl.name = "sample"
    sampleDecl.lineIndex = 1
    currentProfile.decls = [sampleDecl]
    currentProfile.localCallNames = ["sample"]
    var importEdge: parser.ImportEdge
    importEdge.targetSourcePath = "shadow_target.cheng"
    importEdge.targetProfileIndex = 1
    importEdge.qualifier = "qual"
    importEdge.resolved = true
    currentProfile.importEdges = [importEdge]
    var targetProfile: parser.NormalizedExprCallProfile
    targetProfile.sourcePath = "shadow_target.cheng"
    targetProfile.localCallNames = ["Run"]
    var profiles = [currentProfile, targetProfile]
    var profileIndexLookup = parser.ParserSourcePathIndexLookupBuild(profiles)
    let shadowReason = parser.ParserQualifiedTargetShadowReasonExactWithLines(currentProfile,
                                                                               currentLines,
                                                                               2,
                                                                               "qual.Run")
    assert(shadowReason == parser.NormalizedExprCallReasonShadowedQualifiedTarget,
           " defer parser: explicit lines preserve parameter shadowing")
    assert(parser.ParserQualifiedTargetShadowReasonExact(currentProfile,
                                                           2,
                                                           "qual.Run") == parser.NormalizedExprCallReasonNone,
           " defer parser: legacy wrapper reads compact profile lines only")
    var layer: parser.NormalizedExprLayer
    var err = ""
    assert(parser.ParserReadNormalizedExprLayerFromTextWithKnownCallsAndProfilesWithCurrentLines(
               currentProfile.sourcePath,
               sourceText,
               [],
               currentProfile.localCallNames,
               ["qual.Run"],
               currentProfile,
               currentLines,
               profiles,
               profileIndexLookup,
               layer,
               err),
           Fmt" defer parser: explicit-lines parse error={err}")
    let callIndex = findNamedCallAtLine(layer, 2, "Run")
    assert(callIndex >= 0,
           " defer parser: shadowed member call remains a structured fact")
    assert(!layer.exprs[callIndex].callResolved &&
           layer.exprs[callIndex].callReason == parser.NormalizedExprCallReasonShadowedQualifiedTarget &&
           layer.exprs[callIndex].callSurfaceKind == parser.NormalizedExprSurfaceCallMember,
           " defer parser: parameter qualifier must not resolve as import")

fn assertContinuationDoesNotCreateLexicalScope() =
    let sourceText = strutil.Join([
        "fn cleanup(value: int32) =",
        "    let held = value",
        "",
        "fn sample() =",
        "    let ordinary = cleanup(",
        "        1",
        "    )",
        "    let message = \"\"\"",
        "        alpha",
        "        beta",
        "    \"\"\"",
        "    defer:",
        "        cleanup(",
        "            2",
        "        )"
    ], "\n")
    var layer: parser.NormalizedExprLayer
    var err = ""
    assert(parser.ParserReadNormalizedExprLayerFromText("defer_parser_continuation.cheng",
                                                          sourceText,
                                                          layer,
                                                          err),
           Fmt" defer parser: continuation parse error={err}")
    assert(layer.scopes.len == 4,
           Fmt" defer parser: continuation created fake scope count={layer.scopes.len}")
    let normalCallIndex = findCallAtLine(layer, 5)
    let deferCallIndex = findCallAtLine(layer, 13)
    let deferIndex = findKind(layer, parser.NormalizedExprDeferStmt)
    assert(normalCallIndex >= 0 && deferCallIndex >= 0 && deferIndex >= 0,
           " defer parser: multiline calls remain structured")
    assert(layer.exprs[normalCallIndex].deferOwnerStatementOrdinal == -1 &&
           layer.exprs[normalCallIndex].lexicalScopeId == layer.exprs[deferIndex].lexicalScopeId,
           " defer parser: normal multiline call stays in function scope")
    assert(layer.exprs[deferCallIndex].deferOwnerStatementOrdinal == layer.exprs[deferIndex].statementOrdinal &&
           layer.exprs[deferCallIndex].lexicalScopeId == layer.exprs[deferIndex].suiteScopeId,
           " defer parser: deferred multiline call keeps defer owner")
    for scopeIndex in 0..<layer.scopes.len:
        let startLine = layer.scopes[scopeIndex].startLineNumber
        assert(startLine != 6 && startLine != 7 &&
               startLine != 9 && startLine != 10 && startLine != 11 &&
               startLine != 14 && startLine != 15,
               Fmt" defer parser: continuation line became scope start={startLine}")

fn assertTrailingAssignmentDoesNotCreateLexicalScope() =
    let sourceText = strutil.Join([
        "fn cleanup(value: int32) =",
        "    let held = value",
        "",
        "fn sample() =",
        "    let value =",
        "        cleanup(1)",
        "    var assigned: int32",
        "    assigned =",
        "        cleanup(2)",
        "    defer:",
        "        cleanup(3)"
    ], "\n")
    var layer: parser.NormalizedExprLayer
    var err = ""
    assert(parser.ParserReadNormalizedExprLayerFromText("defer_parser_assignment_continuation.cheng",
                                                          sourceText,
                                                          layer,
                                                          err),
           Fmt" defer parser: assignment continuation parse error={err}")
    assert(layer.scopes.len == 4,
           Fmt" defer parser: trailing assignment created fake scope count={layer.scopes.len}")
    let firstCallIndex = findCallAtLine(layer, 6)
    let secondCallIndex = findCallAtLine(layer, 9)
    let deferCallIndex = findCallAtLine(layer, 11)
    let deferIndex = findKind(layer, parser.NormalizedExprDeferStmt)
    assert(firstCallIndex >= 0 && secondCallIndex >= 0 && deferCallIndex >= 0 && deferIndex >= 0,
           " defer parser: assignment continuation calls retained")
    assert(layer.exprs[firstCallIndex].lexicalScopeId == layer.exprs[deferIndex].lexicalScopeId &&
           layer.exprs[secondCallIndex].lexicalScopeId == layer.exprs[deferIndex].lexicalScopeId,
           " defer parser: assignment RHS stays in function scope")
    assert(layer.exprs[deferCallIndex].lexicalScopeId == layer.exprs[deferIndex].suiteScopeId,
           " defer parser: only defer opens nested scope")

fn assertAllSuiteHeadersOwnScopes() =
    let sourceText = strutil.Join([
        "fn sample(flag: bool, items: int32[]) =",
        "    if flag:",
        "        let a = 1",
        "    elif items.len > 0:",
        "        let b = 2",
        "    else:",
        "        let c = 3",
        "    for item in items:",
        "        let d = item",
        "    match flag:",
        "        true =>",
        "            let e = 1",
        "        false => let f = 2",
        "    while flag:",
        "        continue"
    ], "\n")
    var layer: parser.NormalizedExprLayer
    var err = ""
    assert(parser.ParserReadNormalizedExprLayerFromText("defer_parser_suite_owners.cheng",
                                                          sourceText,
                                                          layer,
                                                          err),
           Fmt" defer parser: suite owner parse error={err}")
    assert(parser.NormalizedExprLayerIfStmtCount(layer) == 1 &&
           parser.NormalizedExprLayerElifStmtCount(layer) == 1 &&
           parser.NormalizedExprLayerElseStmtCount(layer) == 1 &&
           parser.NormalizedExprLayerForStmtCount(layer) == 1 &&
           parser.NormalizedExprLayerMatchStmtCount(layer) == 1 &&
           parser.NormalizedExprLayerCaseStmtCount(layer) == 2 &&
           parser.NormalizedExprLayerWhileStmtCount(layer) == 1,
           " defer parser: all suite headers retained exactly once")
    let suiteStatementIndices = [
        findKindAtLine(layer, parser.NormalizedExprIfStmt, 2),
        findKindAtLine(layer, parser.NormalizedExprElifStmt, 4),
        findKindAtLine(layer, parser.NormalizedExprElseStmt, 6),
        findKindAtLine(layer, parser.NormalizedExprForStmt, 8),
        findKindAtLine(layer, parser.NormalizedExprMatchStmt, 10),
        findKindAtLine(layer, parser.NormalizedExprCaseStmt, 11),
        findKindAtLine(layer, parser.NormalizedExprCaseStmt, 13),
        findKindAtLine(layer, parser.NormalizedExprWhileStmt, 14)
    ]
    var previousStatementOrdinal = -1
    for i in 0..<suiteStatementIndices.len:
        let exprIndex = suiteStatementIndices[i]
        assert(exprIndex >= 0,
               Fmt" defer parser: suite statement missing index={i}")
        let expr = layer.exprs[exprIndex]
        assert(expr.statementOrdinal > previousStatementOrdinal &&
               expr.lexicalOrdinal >= 0 &&
               expr.suiteScopeId >= 0 && expr.suiteScopeId < layer.scopes.len,
               Fmt" defer parser: suite statement metadata missing index={i}")
        assert(layer.scopes[expr.suiteScopeId].ownerStatementOrdinal == expr.statementOrdinal &&
               layer.scopes[expr.suiteScopeId].parentScopeId == expr.lexicalScopeId,
               Fmt" defer parser: suite scope owner mismatch index={i}")
        previousStatementOrdinal = expr.statementOrdinal
    let inlineCaseIndex = suiteStatementIndices[6]
    let inlineAssignIndex = findKindAtLine(layer, parser.NormalizedExprAssign, 13)
    assert(inlineCaseIndex >= 0 && inlineAssignIndex >= 0 &&
           layer.exprs[inlineAssignIndex].lexicalScopeId == layer.exprs[inlineCaseIndex].suiteScopeId,
           " defer parser: inline suite body fact uses owned suite scope")
    let continueIndex = findKindAtLine(layer, parser.NormalizedExprContinueStmt, 15)
    let whileIndex = findKindAtLine(layer, parser.NormalizedExprWhileStmt, 14)
    assert(continueIndex >= 0 && whileIndex >= 0 &&
           scopeAncestryHasOwner(layer,
                                 layer.exprs[continueIndex].lexicalScopeId,
                                 layer.exprs[whileIndex].statementOrdinal),
           " defer parser: continue resolves loop owner through scope ancestry")

fn assertLayerOwnershipLifecycle() =
    let sourceText = strutil.Join([
        "fn cleanup() =",
        "    let value = 1",
        "fn sample() =",
        "    defer: cleanup()"
    ], "\n")
    var first: parser.NormalizedExprLayer
    var second: parser.NormalizedExprLayer
    var err = ""
    assert(parser.ParserReadNormalizedExprLayerFromText("defer_parser_lifecycle_a.cheng",
                                                          sourceText,
                                                          first,
                                                          err),
           Fmt" defer parser: lifecycle first parse error={err}")
    assert(parser.ParserReadNormalizedExprLayerFromText("defer_parser_lifecycle_b.cheng",
                                                          sourceText,
                                                          second,
                                                          err),
           Fmt" defer parser: lifecycle second parse error={err}")
    var cloned = parser.NormalizedExprLayerClone(first)
    let clonedDeferIndex = findKind(cloned, parser.NormalizedExprDeferStmt)
    let clonedCallIndex = findCallAtLine(cloned, 4)
    assert(clonedDeferIndex >= 0 && clonedCallIndex >= 0 &&
           cloned.exprs[clonedCallIndex].deferOwnerStatementOrdinal == cloned.exprs[clonedDeferIndex].statementOrdinal,
           " defer parser: clone preserves owner field")
    var moved: parser.NormalizedExprLayer
    parser.NormalizedExprLayerMoveInto(moved, cloned)
    assert(cloned.exprs.len == 0 && cloned.scopes.len == 0,
           " defer parser: move resets source layer")
    assert(first.scopes.len > 0 && second.scopes.len > 0,
           " defer parser: merge fixtures own source scopes")
    let firstScopeCount = first.scopes.len
    let secondScopeCount = second.scopes.len
    let firstSourcePath = first.scopes[0].sourcePath
    let secondSourcePath = second.scopes[0].sourcePath
    var merged: parser.NormalizedExprLayer
    parser.NormalizedExprLayerAdd(merged, first)
    parser.NormalizedExprLayerAdd(merged, second)
    assert(merged.scopes.len == firstScopeCount + secondScopeCount &&
           merged.scopes[0].scopeId == 0 &&
           merged.scopes[firstScopeCount].scopeId == 0 &&
           merged.scopes[firstScopeCount].parentScopeId == -1,
           " defer parser: merge preserves per-source root identity")
    for exprIndex in 0..<merged.exprs.len:
        let expr = merged.exprs[exprIndex]
        let sourceScopeStart =
            expr.sourcePath == firstSourcePath ? 0 : firstScopeCount
        let sourceScopeCount =
            expr.sourcePath == firstSourcePath ? firstScopeCount :
                                                 secondScopeCount
        assert(expr.sourcePath == firstSourcePath ||
               expr.sourcePath == secondSourcePath,
               " defer parser: merge expression source identity")
        if expr.lexicalScopeId >= 0:
            assert(expr.lexicalScopeId < sourceScopeCount &&
                   merged.scopes[sourceScopeStart + expr.lexicalScopeId].sourcePath ==
                       expr.sourcePath,
                   " defer parser: merge preserves source-local lexical scope id")
        if expr.suiteScopeId >= 0:
            assert(expr.suiteScopeId < sourceScopeCount &&
                   merged.scopes[sourceScopeStart + expr.suiteScopeId].sourcePath ==
                       expr.sourcePath,
                   " defer parser: merge preserves source-local suite scope id")
    parser.NormalizedExprLayerReset(moved)
    assert(moved.exprs.len == 0 && moved.scopes.len == 0,
           " defer parser: reset clears ownership facts")

fn assertStructuredSourceSidecarSlices() =
    let sourceText = strutil.Join([
        "fn cleanup(value: int32) =",
        "    let held = value",
        "",
        "fn first() =",
        "    defer:",
        "        cleanup(1)",
        "",
        "fn second(flag: bool) =",
        "    if flag:",
        "        cleanup(2)"
    ], "\n")
    var sourceLines = parser.ParserSplitChar(sourceText, '\n')
    parser.ParserJoinContinuationLinesInPlace(sourceLines)
    var facts: parser.ParserStructuredSourceFacts
    var err = ""
    assert(parser.ParserStructuredSourceFactsBuild("defer_parser_sidecar.cheng",
                                                    sourceLines,
                                                    facts,
                                                    err),
           Fmt" defer parser: sidecar build error={err}")
    assert(facts.built && facts.sourceLineCount == sourceLines.len &&
           facts.scopeBuildLineVisitCount == Int64(sourceLines.len) &&
           facts.structuredBuildLineVisitCount == Int64(sourceLines.len),
           " defer parser: sidecar source passes are linear and singular")
    let sourceScopeBuildVisits = facts.scopeBuildLineVisitCount
    let sourceStructuredBuildVisits = facts.structuredBuildLineVisitCount
    assert(!parser.ParserStructuredSourceFactsBuild("defer_parser_sidecar.cheng",
                                                     sourceLines,
                                                     facts,
                                                     err) &&
           facts.built &&
           facts.scopeBuildLineVisitCount == sourceScopeBuildVisits,
           " defer parser: sidecar refuses per-function source rebuild")

    var firstSlice: parser.ParserStructuredSourceSlice
    var secondSlice: parser.ParserStructuredSourceSlice
    var firstRepeat: parser.ParserStructuredSourceSlice
    err = "stale caller error"
    assert(parser.ParserStructuredSourceFactsSliceBuild(facts,
                                                         4,
                                                         6,
                                                         firstSlice,
                                                         err),
           Fmt" defer parser: first sidecar slice error={err}")
    assert(parser.ParserStructuredSourceFactsSliceBuild(facts,
                                                         8,
                                                         10,
                                                         secondSlice,
                                                         err),
           Fmt" defer parser: second sidecar slice error={err}")
    assert(parser.ParserStructuredSourceFactsSliceBuild(facts,
                                                         4,
                                                         6,
                                                         firstRepeat,
                                                         err),
           Fmt" defer parser: repeated sidecar slice error={err}")
    assert(facts.scopeBuildLineVisitCount == sourceScopeBuildVisits &&
           facts.structuredBuildLineVisitCount == sourceStructuredBuildVisits,
           " defer parser: slicing must not rebuild source scope facts")
    assert(firstSlice.lineVisitCount == 3 && secondSlice.lineVisitCount == 3 &&
           firstRepeat.lineVisitCount == 3 &&
           firstSlice.lineVisitCount < Int64(facts.sourceLineCount),
           " defer parser: each slice visits only its function lines")
    assert(firstSlice.scopeVisitCount == Int64(firstSlice.scopes.len) &&
           secondSlice.scopeVisitCount == Int64(secondSlice.scopes.len) &&
           firstRepeat.scopeVisitCount == Int64(firstRepeat.scopes.len) &&
           firstSlice.seedVisitCount == Int64(firstSlice.seeds.len) &&
           secondSlice.seedVisitCount == Int64(secondSlice.seeds.len),
           " defer parser: slice work is linear in selected scopes and seeds")
    assert(firstSlice.scopes.len == firstRepeat.scopes.len &&
           firstSlice.seeds.len == firstRepeat.seeds.len &&
           firstSlice.sourceScopeIds.len == firstRepeat.sourceScopeIds.len,
           " defer parser: repeated slice shape is stable")
    for scopeIndex in 0..<firstSlice.scopes.len:
        assert(firstSlice.scopes[scopeIndex].scopeId == scopeIndex &&
               firstSlice.scopes[scopeIndex].sourceScopeId ==
                   firstRepeat.scopes[scopeIndex].sourceScopeId &&
               firstSlice.scopes[scopeIndex].parentScopeId ==
                   firstRepeat.scopes[scopeIndex].parentScopeId,
               Fmt" defer parser: repeated slice scope identity index={scopeIndex}")
    for seedIndex in 0..<firstSlice.seeds.len:
        assert(firstSlice.sourceStatementOrdinals[seedIndex] ==
                   firstRepeat.sourceStatementOrdinals[seedIndex] &&
               firstSlice.seeds[seedIndex].lexicalScopeId ==
                   firstRepeat.seeds[seedIndex].lexicalScopeId &&
               firstSlice.seeds[seedIndex].suiteScopeId ==
                   firstRepeat.seeds[seedIndex].suiteScopeId,
               Fmt" defer parser: repeated slice statement identity index={seedIndex}")

    var firstLayer: parser.NormalizedExprLayer
    parser.NormalizedExprLayerAppendCall(firstLayer,
                                          facts.sourcePath,
                                          6,
                                          9,
                                          "cleanup",
                                          parser.NormalizedExprSurfaceCallLocal,
                                          true,
                                          parser.NormalizedExprCallReasonNone,
                                          "",
                                          "cleanup",
                                          "cleanup",
                                          facts.sourcePath,
                                          false,
                                          "1",
                                          1,
                                          false,
                                          18)
    assert(parser.ParserStructuredSourceSliceAppendToLayer(firstSlice,
                                                            firstLayer,
                                                            err),
           Fmt" defer parser: first slice apply error={err}")
    let firstDeferIndex = findKind(firstLayer, parser.NormalizedExprDeferStmt)
    let firstCallIndex = findCallAtLine(firstLayer, 6)
    assert(firstDeferIndex >= 0 && firstCallIndex >= 0 &&
           firstLayer.exprs[firstCallIndex].deferOwnerStatementOrdinal ==
               firstLayer.exprs[firstDeferIndex].statementOrdinal &&
           firstLayer.exprs[firstCallIndex].lexicalScopeId ==
               firstLayer.exprs[firstDeferIndex].suiteScopeId &&
           firstSlice.applyExprVisitCount == 1,
           " defer parser: first slice appends defer header and body annotation")

    var secondLayer: parser.NormalizedExprLayer
    parser.NormalizedExprLayerAppendCall(secondLayer,
                                          facts.sourcePath,
                                          10,
                                          9,
                                          "cleanup",
                                          parser.NormalizedExprSurfaceCallLocal,
                                          true,
                                          parser.NormalizedExprCallReasonNone,
                                          "",
                                          "cleanup",
                                          "cleanup",
                                          facts.sourcePath,
                                          false,
                                          "2",
                                          1,
                                          false,
                                          18)
    assert(parser.ParserStructuredSourceSliceAppendToLayer(secondSlice,
                                                            secondLayer,
                                                            err),
           Fmt" defer parser: second slice apply error={err}")
    let secondIfIndex = findKind(secondLayer, parser.NormalizedExprIfStmt)
    let secondCallIndex = findCallAtLine(secondLayer, 10)
    assert(secondIfIndex >= 0 && secondCallIndex >= 0 &&
           secondLayer.exprs[secondCallIndex].deferOwnerStatementOrdinal == -1 &&
           secondLayer.exprs[secondCallIndex].lexicalScopeId ==
               secondLayer.exprs[secondIfIndex].suiteScopeId &&
           secondLayer.exprs[secondIfIndex].statementOrdinal == 0,
           " defer parser: second slice remaps scopes and statement ordinals locally")

    var incomplete: parser.ParserStructuredSourceSlice
    assert(!parser.ParserStructuredSourceFactsSliceBuild(facts,
                                                          4,
                                                          5,
                                                          incomplete,
                                                          err) &&
           !incomplete.built && incomplete.scopes.len == 0 &&
           incomplete.seeds.len == 0,
           " defer parser: incomplete structured slice fails atomically")
    parser.ParserStructuredSourceSliceReset(firstSlice)
    parser.ParserStructuredSourceSliceReset(secondSlice)
    parser.ParserStructuredSourceSliceReset(firstRepeat)
    parser.ParserStructuredSourceFactsReset(facts)
    assert(!facts.built && facts.scopes.len == 0 && facts.seeds.len == 0 &&
           facts.lineScopeIds.len == 0 && firstSlice.scopes.len == 0,
           " defer parser: sidecar and slice release reset all ownership")

fn main(): int32 =
    assertBlockContract()
    assertInlineSuiteContract()
    assertInvalidContracts()
    assertSimpleEntryContract()
    assertQualifierShadowUsesExplicitLines()
    assertContinuationDoesNotCreateLexicalScope()
    assertTrailingAssignmentDoesNotCreateLexicalScope()
    assertAllSuiteHeadersOwnScopes()
    assertLayerOwnershipLifecycle()
    assertStructuredSourceSidecarSlices()
    echo(" defer_parser_contract_smoke ok")
    return 0
