type Face =
    data: int32[]
    loaded: bool

fn initEmpty(f: var Face) =
    f.loaded = false

@borrows
fn checkBuf(buf: int32[]): bool =
    return buf.len > 0

@borrows
fn probe(f: var Face, data: int32[]): bool =
    initEmpty(f)
    if data.len < 4:
        return false
    f.data = data
    f.loaded = true
    return checkBuf(f.data)

fn main(): int32 =
    var f: Face
    var d: int32[]
    d = [1, 2, 3, 4]
    if probe(f, d):
        return 1
    return 0
