type
    ColdRefObjectDisjointRoot = ref object
        left: int32
        right: int32

fn ColdRefObjectWriteDisjoint(
        left: var int32,
        right: var int32) =
    left = 73
    right = 79

fn main(): int32 =
    var root = new(ColdRefObjectDisjointRoot)
    ColdRefObjectWriteDisjoint(
        root.left,
        root.right)
    if root.left != 73:
        return 73
    if root.right != 79:
        return 79
    return 0
