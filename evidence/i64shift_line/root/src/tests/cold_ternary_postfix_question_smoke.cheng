var coldQuestionSideEffectCount: int32

fn coldQuestionAlwaysFalse(): bool =
    return false

fn coldQuestionRecordSideEffect(): bool =
    coldQuestionSideEffectCount = coldQuestionSideEffectCount + 1
    return true

fn coldQuestionFlagResult(): Result[bool] =
    return Ok[bool](true)

fn coldQuestionRecordResultSideEffect(): Result[bool] =
    coldQuestionSideEffectCount = coldQuestionSideEffectCount + 1
    return Ok[bool](true)

fn coldQuestionErrorResult(): Result[bool] =
    return Err[bool]("expected")

fn coldQuestionNumberResult(): Result[int32] =
    return Ok[int32](7)

fn coldQuestionPostfixThenTernary(): Result[int32] =
    let value = coldQuestionFlagResult()? ?
        23 :
        29
    return Ok[int32](value)

fn coldQuestionPostfixValue(): Result[int32] =
    let value = coldQuestionNumberResult()?
    return Ok[int32](value)

fn coldQuestionThenPostfix(): Result[bool] =
    let value = true ? coldQuestionFlagResult()? : false
    return Ok[bool](value)

fn coldQuestionElsePostfix(): Result[bool] =
    let value = false ? false : coldQuestionFlagResult()?
    return Ok[bool](value)

fn coldQuestionPostfixLogical(): Result[bool] =
    let value = false && coldQuestionRecordResultSideEffect()?
    return Ok[bool](value)

fn coldQuestionPropagateError(): Result[int32] =
    let value = coldQuestionErrorResult()? ? 61 : 67
    return Ok[int32](value)

fn main(): int32 =
    let callTernary = !coldQuestionAlwaysFalse() ?
        11 :
        19
    let postfixThenTernaryResult = coldQuestionPostfixThenTernary()
    let postfixValueResult = coldQuestionPostfixValue()
    let thenPostfixResult = coldQuestionThenPostfix()
    let elsePostfixResult = coldQuestionElsePostfix()
    let postfixLogicalResult = coldQuestionPostfixLogical()
    let propagatedErrorResult = coldQuestionPropagateError()
    if !postfixThenTernaryResult.ok:
        return 10
    if !postfixValueResult.ok:
        return 11
    if !thenPostfixResult.ok:
        return 12
    if !elsePostfixResult.ok:
        return 13
    if !postfixLogicalResult.ok:
        return 14
    if postfixLogicalResult.value:
        return 15
    if propagatedErrorResult.ok:
        return 16
    let postfixThenTernary = postfixThenTernaryResult.value
    let postfixValue = postfixValueResult.value
    let thenPostfix = thenPostfixResult.value
    let elsePostfix = elsePostfixResult.value
    let nestedTernary = false ? 31 : true ? 37 : 41
    let shortAnd = false && coldQuestionRecordSideEffect() ? 43 : 47
    let shortOr = true || coldQuestionRecordSideEffect() ? 53 : 59
    if callTernary != 11:
        return 1
    if postfixThenTernary != 23:
        return 2
    if postfixValue != 7:
        return 3
    if !thenPostfix:
        return 4
    if !elsePostfix:
        return 5
    if nestedTernary != 37:
        return 6
    if shortAnd != 47:
        return 7
    if shortOr != 53:
        return 8
    if coldQuestionSideEffectCount != 0:
        return 9
    echo("cold_ternary_postfix_question_smoke ok")
    return 0
