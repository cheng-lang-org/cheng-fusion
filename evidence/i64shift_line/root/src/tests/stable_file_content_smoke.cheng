import std/cmdline
import std/fs
import std/result
import cheng/std/bytes_layout as layout
import cheng/core/tooling/stable_file_content as stablecontent

fn main(): int32 =
    let executablePathRes = fs.Realpath(cmdline.ProgramName())
    if IsErr(executablePathRes):
        return 2
    var first: layout.FixedBytes32
    var second: layout.FixedBytes32
    var err = ""
    if !stablecontent.StableFileContentSha256Into(
            Value(executablePathRes), true, first, err):
        return 3
    if !stablecontent.StableFileContentSha256Into(
            Value(executablePathRes), true, second, err):
        return 4
    if !layout.FixedBytes32Equal(first, second):
        return 5
    return 0
