type
    VarPlaceParentChildContext =
        lines: str[]
        scanned: bool

fn VarPlaceScanParentAndChild(
    context: var VarPlaceParentChildContext,
    lines: var str[]
) =
    context.scanned = lines.len > 0

fn main(): int32 =
    var contexts: VarPlaceParentChildContext[]
    var context: VarPlaceParentChildContext
    add(contexts, context)
    var contextIndex = 0
    VarPlaceScanParentAndChild(
        contexts[contextIndex],
        contexts[contextIndex].lines)
    return 0
