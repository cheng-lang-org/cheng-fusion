# SHA-384 位原语对拍探针：rotr64 / BigSigma0/1 / SmallSigma0/1 / Ch / Maj
# 在固定输入下的输出，与 FIPS 180-4 黄金实现（python 复算）对比。
import std/system
import std/result
import std/rawbytes
import std/strutils as strutil
import std/crypto/sha384 as sha384m
import std/crypto/rsa as rsacrypto

fn u64hex(v: uint64): str =
    var tmp: Bytes = BytesAlloc(8)
    sha384m.sha384SetU64BE(tmp, 0, v)
    return BytesToHex(tmp)

fn main(): int32 =
    let x: uint64 = sha384m.sha384U64FromBytes(0x80, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01)
    echo(strutil.Join(["rotr(x,1)=", u64hex(sha384m.sha384Rotr64(x, 1))], ""))
    echo(strutil.Join(["rotr(x,8)=", u64hex(sha384m.sha384Rotr64(x, 8))], ""))
    echo(strutil.Join(["rotr(x,14)=", u64hex(sha384m.sha384Rotr64(x, 14))], ""))
    echo(strutil.Join(["rotr(x,18)=", u64hex(sha384m.sha384Rotr64(x, 18))], ""))
    echo(strutil.Join(["rotr(x,19)=", u64hex(sha384m.sha384Rotr64(x, 19))], ""))
    echo(strutil.Join(["rotr(x,28)=", u64hex(sha384m.sha384Rotr64(x, 28))], ""))
    echo(strutil.Join(["rotr(x,34)=", u64hex(sha384m.sha384Rotr64(x, 34))], ""))
    echo(strutil.Join(["rotr(x,39)=", u64hex(sha384m.sha384Rotr64(x, 39))], ""))
    echo(strutil.Join(["rotr(x,41)=", u64hex(sha384m.sha384Rotr64(x, 41))], ""))
    echo(strutil.Join(["rotr(x,61)=", u64hex(sha384m.sha384Rotr64(x, 61))], ""))
    let y: uint64 = sha384m.sha384U64FromBytes(0xde, 0xad, 0xbe, 0xef, 0xca, 0xfe, 0xba, 0xbe)
    echo(strutil.Join(["bs0(y)=", u64hex(sha384m.sha384BigSigma0(y))], ""))
    echo(strutil.Join(["bs1(y)=", u64hex(sha384m.sha384BigSigma1(y))], ""))
    echo(strutil.Join(["ss0(y)=", u64hex(sha384m.sha384SmallSigma0(y))], ""))
    echo(strutil.Join(["ss1(y)=", u64hex(sha384m.sha384SmallSigma1(y))], ""))
    echo(strutil.Join(["ch(y,y,xor)=", u64hex(sha384m.sha384Ch(y, y, x))], ""))
    echo(strutil.Join(["maj(y,y,xor)=", u64hex(sha384m.sha384Maj(y, y, x))], ""))
    return 0
