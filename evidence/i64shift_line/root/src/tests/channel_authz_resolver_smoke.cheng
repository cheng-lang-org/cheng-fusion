# libp2p P3 收尾片: head 接受 resolver 直接根路径 + rotation supersede + 先取撤销 (正典 §11.6 P3)。
# exe run 非 census: 断言失败即 abort 非零。crypto 断言 DEFAULT-ON (无 env 逃生)。
#
# 三独立场景 (distinct root 避交叉污染):
#   A 直接根: root 签 v1 自证 head (channelId==L) → resolver 接受; 验签拒 (翻 sig) / 未授权 channel
#     (他人 key head presented for L, 无 cert) 硬拒。
#   B 先取撤销: root 自撤 → resolver 对自己的 head 先取撤销硬拒 (授权前)。
#   C rotation supersede (T8): recovery 签 rotation L→new → resolver 对 new head 接受 (currentRoot=new);
#     对 old L 直收 head 拒 (SUPERSEDED, currentRoot 已前进)。

import std/system
import std/result
import std/rawbytes as rawbytes
import cheng/std/bytes_layout as layout
import std/crypto/sha512 as sha512
import std/crypto/ed25519/ref10 as ref10
import std/os as os
import cheng/libp2p/protocols/cas_source/channel_head/head_codec as head
import cheng/libp2p/protocols/cas_source/channel_head/authz_codec as authz
import cheng/libp2p/protocols/cas_source/channel_head/authz_store as store
import cheng/libp2p/protocols/cas_source/channel_head/authz_resolver as resolver

fn deriveKeypair(seedv: int32, priv: var Bytes, pub: var Bytes) =
    var seed = BytesAlloc(32)
    for i in 0..<32:
        BytesSet(seed, i, (seedv + i) & 255)
    var digest = sha512.Sha512Digest(seed)
    BytesSet(digest, 0, BytesGet(digest, 0) & 248)
    BytesSet(digest, 31, (BytesGet(digest, 31) & 63) | 64)
    var r: ref10.GeP3
    ref10.geScalarMultBase(r, BytesSlice(digest, 0, 32))
    pub = ref10.geP3ToBytes(r)
    priv = BytesConcat(seed, pub)

fn pubFixed(pub: Bytes): layout.FixedBytes32 =
    let r = layout.FixedBytes32FromBytes(pub)
    assert(!IsErr(r), " pubFixed 32B")
    return Value(r)

fn mkHeadCid(seed: int32): layout.FixedBytes32 =
    var b = BytesAlloc(32)
    for i in 0..<32:
        BytesSet(b, i, (seed * 23 + i + 5) & 255)
    return pubFixed(b)

fn signHeadWire(priv: Bytes, pub: Bytes, epoch: int64): Bytes =
    let hc = mkHeadCid(int32(epoch) + 7)
    let genesis = head.ChannelHeadGenesisPrev()
    var signRes = head.ChannelHeadSign(priv, epoch, hc, genesis, pub)
    assert(!IsErr(signRes), " signHeadWire sign: " + Error(signRes))
    var encRes = head.ChannelHeadEncode(Value(signRes))
    assert(!IsErr(encRes), " signHeadWire encode: " + Error(encRes))
    return Value(encRes)

fn rmIf(path: str) =
    if os.FileExists(path):
        let _rm = os.RemoveFile(path)

fn main(): int32 =
    let base = os.GetEnvDefault("TMPDIR", "/tmp") + "/cheng_channel_authz_resolver_p3"
    let storeRoot = base + "/store"
    os.MkdirAll(storeRoot, 493)
    rmIf(store.AuthzRecoveryPath(storeRoot))
    rmIf(store.AuthzRotationPath(storeRoot))
    var empty = EmptyBytes()

    # ==== 场景 A: 直接根 ====
    var rootAPriv: Bytes
    var rootAPub: Bytes
    deriveKeypair(61, rootAPriv, rootAPub)
    let lA = head.ChannelIdForPubKey(rootAPub)
    rmIf(store.AuthzRevocationPath(storeRoot, layout.FixedBytes32Hex(lA), rawbytes.BytesToHex(rootAPub)))

    let headA = signHeadWire(rootAPriv, rootAPub, int64(1))
    var acceptA = resolver.AuthzResolveHeadAccept(storeRoot, lA, headA, false, empty)
    assert(!IsErr(acceptA), " A 直接根 head 接受: " + Error(acceptA))
    let acceptedA = Value(acceptA)
    assert(layout.FixedBytes32Equal(acceptedA.channelId, lA), " A 接受 head channelId==L")
    assert(rawbytes.BytesEqual(acceptedA.signerPubKey, rootAPub), " A 接受 head signer==root")

    # A 负: 验签拒 (翻 head sig 1 字节; channelId/binding 仍自证合法)
    var tamperedHead = BytesAlloc(201)
    for i in 0..<201:
        BytesSet(tamperedHead, i, BytesGet(headA, i))
    BytesSet(tamperedHead, 137, (BytesGet(tamperedHead, 137) ^ 0x01) & 255)   # sig 起始 @137
    var tamperAccept = resolver.AuthzResolveHeadAccept(storeRoot, lA, tamperedHead, false, empty)
    assert(IsErr(tamperAccept), " A 负: 验签拒")
    assert(Error(tamperAccept) == "resolver: head 验签拒", " A 负: 验签 rejectReason 精确")

    # A 负: 未授权 channel (他人 key head presented for L, 无 cert)
    var attackerPriv: Bytes
    var attackerPub: Bytes
    deriveKeypair(162, attackerPriv, attackerPub)
    let headAttacker = signHeadWire(attackerPriv, attackerPub, int64(1))
    var unauthAccept = resolver.AuthzResolveHeadAccept(storeRoot, lA, headAttacker, false, empty)
    assert(IsErr(unauthAccept), " A 负: 未授权 channel 拒")
    assert(Error(unauthAccept) == "resolver: 未授权 signer channel", " A 负: 未授权 rejectReason 精确")

    # ==== 场景 B: 先取撤销 (授权前) ====
    var rootBPriv: Bytes
    var rootBPub: Bytes
    deriveKeypair(71, rootBPriv, rootBPub)
    let lB = head.ChannelIdForPubKey(rootBPub)
    rmIf(store.AuthzRevocationPath(storeRoot, layout.FixedBytes32Hex(lB), rawbytes.BytesToHex(rootBPub)))

    let headB = signHeadWire(rootBPriv, rootBPub, int64(1))
    # 撤销前: 直接根接受
    var preRevoke = resolver.AuthzResolveHeadAccept(storeRoot, lB, headB, false, empty)
    assert(!IsErr(preRevoke), " B 撤销前: head 接受")
    # root 自撤
    var bRevoke = authz.AuthzRecordSign(authz.AuthzTagRevoke, rootBPriv, lB, pubFixed(rootBPub), int64(1), rootBPub)
    assert(!IsErr(bRevoke), " B 自撤 sign")
    var bRevokeAdmit = store.AuthzRevocationAdmit(storeRoot, Value(bRevoke))
    assert(!IsErr(bRevokeAdmit), " B 自撤 admit: " + Error(bRevokeAdmit))
    # 撤销后: 先取撤销硬拒 (授权前)
    var postRevoke = resolver.AuthzResolveHeadAccept(storeRoot, lB, headB, false, empty)
    assert(IsErr(postRevoke), " B 撤销后: 先取撤销硬拒")
    assert(Error(postRevoke) == "resolver: signer 已撤销 (先取撤销硬拒)", " B 负: 先取撤销 rejectReason 精确")

    # ==== 场景 C: rotation supersede (T8) ====
    var rootCPriv: Bytes
    var rootCPub: Bytes
    deriveKeypair(81, rootCPriv, rootCPub)
    let lC = head.ChannelIdForPubKey(rootCPub)

    var recCPriv: Bytes
    var recCPub: Bytes
    deriveKeypair(97, recCPriv, recCPub)
    let recCHash = head.ChannelIdForPubKey(recCPub)

    var newCPriv: Bytes
    var newCPub: Bytes
    deriveKeypair(133, newCPriv, newCPub)
    let newC = head.ChannelIdForPubKey(newCPub)

    # recovery 绑定 + rotation lC→newC
    var cBind = authz.AuthzRecordSign(authz.AuthzTagRecoveryBind, rootCPriv, lC, recCHash, int64(1), rootCPub)
    assert(!IsErr(cBind), " C recovery-bind sign")
    assert(!IsErr(store.AuthzRecoveryBindAdmit(storeRoot, Value(cBind))), " C recovery-bind admit")
    var cRot = authz.AuthzRecordSign(authz.AuthzTagRotate, recCPriv, lC, newC, int64(5), recCPub)
    assert(!IsErr(cRot), " C rotation sign")
    assert(!IsErr(store.AuthzRotationAdmit(storeRoot, Value(cRot))), " C rotation admit")

    # 对 new head 接受 (逻辑 L=lC 沿链 follow 到 newC == currentRoot)
    let headNewC = signHeadWire(newCPriv, newCPub, int64(1))
    var acceptNewC = resolver.AuthzResolveHeadAccept(storeRoot, lC, headNewC, false, empty)
    assert(!IsErr(acceptNewC), " C rotation 后: new head 接受 (currentRoot=new): " + Error(acceptNewC))
    assert(layout.FixedBytes32Equal(Value(acceptNewC).channelId, newC), " C 接受 head channelId==newC")

    # 对 old L 直收 head 拒 (SUPERSEDED: currentRoot 已前进到 newC)
    let headOldC = signHeadWire(rootCPriv, rootCPub, int64(2))
    var acceptOldC = resolver.AuthzResolveHeadAccept(storeRoot, lC, headOldC, false, empty)
    assert(IsErr(acceptOldC), " C 负: old channel 直收 head 拒 (SUPERSEDED)")
    assert(Error(acceptOldC) == "resolver: 未授权 signer channel", " C 负: SUPERSEDED rejectReason 精确")

    echo(" channel_authz_resolver_smoke ok")
    return 0
