module cold_generic_str_smoke

fn fn_echo[T](x: T): T =
    return x

fn identity[T](x: T): T =
    let y = x
    return y

fn pair[A, B](a: A, b: B): B =
    return b

fn main(): int32 =
    let s = fn_echo("hello generic")
    if s != "hello generic":
        return 1
    let s2 = identity("world")
    if s2 != "world":
        return 2
    let s3 = pair(int32(0), "second")
    if s3 != "second":
        return 3
    /* Test swapped generic param ordering (Bug 3) */
    let s4 = pair("first", int32(1))
    if s4 != int32(1):
        return 4
    return 0

main()
