import cheng/core/ir/core_types as ir
import cheng/core/ir/body_ir_access as access
import cheng/core/ir/body_ir_cfg as cfg
import cheng/std/bytes_layout as layout
import std/result

fn testTypeArenaCid(label: str): layout.FixedBytes32 =
    var value =
        "1111111111111111111111111111111111111111111111111111111111111111"
    if label == "body-ir-type-arena-b":
        value =
            "2222222222222222222222222222222222222222222222222222222222222222"
    let parsed = layout.FixedBytes32FromHex(value)
    assert(IsOk(parsed), "body ir: test TypeArena CID parse")
    return Value(parsed)

fn makeI32Slot(id: int32, name: str, isParam: bool): ir.LocalSlot =
    var slot: ir.LocalSlot
    slot.id = id
    slot.name = name
    slot.typeKind = ir.LocalI32Tag
    slot.stackOffset = 16 + id * 8
    if isParam:
        slot.stackOffset = -1
    slot.sizeBytes = 4
    slot.alignBytes = 4
    ir.BodyIRApplyLocalSlotDefaultProof(slot)
    return slot

fn appendConst(body: var ir.BodyIR, target: int32, value: int32) =
    var op: ir.BodyOp
    op.kind = ir.BodyOpLoadConstTag
    op.target = target
    add(op.operands, ir.LocalI32Tag)
    add(op.operands, value)
    add(body.ops, op)

fn appendCopy(body: var ir.BodyIR, target: int32, source: int32) =
    var op: ir.BodyOp
    op.kind = ir.BodyOpCopyLocalTag
    op.target = target
    add(op.operands, source)
    add(body.ops, op)

fn appendReturn(body: var ir.BodyIR, resultSlot: int32): int32 =
    var term: ir.BodyTerm
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = resultSlot
    add(term.operands, ir.LocalI32Tag)
    return ir.BodyIRAppendTerm(body, term)

fn appendBr(body: var ir.BodyIR, targetBlock: int32): int32 =
    var term: ir.BodyTerm
    term.kind = ir.BodyTermBrTag
    term.trueBlock = targetBlock
    return ir.BodyIRAppendTerm(body, term)

fn appendCbr(body: var ir.BodyIR,
             conditionSlot: int32,
             trueBlock: int32,
             falseBlock: int32): int32 =
    var term: ir.BodyTerm
    term.kind = ir.BodyTermCbrTag
    term.conditionKind = ir.BodyCondLocalNonZeroTag
    term.resultSlot = conditionSlot
    term.lhsSlot = conditionSlot
    term.rhsSlot = -1
    term.trueBlock = trueBlock
    term.falseBlock = falseBlock
    return ir.BodyIRAppendTerm(body, term)

fn appendOp(body: var ir.BodyIR,
            kind: int32,
            target: int32,
            operands: int32[]) =
    var op: ir.BodyOp
    op.kind = kind
    op.target = target
    for i in 0..<operands.len:
        add(op.operands, operands[i])
    add(body.ops, op)

fn buildAccessExhaustiveBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    for slotIndex in 0..<13:
        add(body.localSlots,
            makeI32Slot(slotIndex, "slot", slotIndex < 5))
    body.localSlots[11].typeKind = ir.LocalPtrTag
    body.localSlots[11].sizeBytes = 8
    body.localSlots[11].alignBytes = 8
    body.localSlots[12].placeKind = ir.BodyPlaceGlobalAddressTag
    let literal = ir.BodyIRAppendCStringLiteral(body, "x", ".L_access_x")

    var call: ir.CallOp
    call.targetSymbol = "callee"
    call.resultSlot = 1
    call.resultPassKind = ir.BodyCallPassStackValueTag
    call.relocWordOffset = -1
    add(call.argSlots, 0)
    add(call.argPassKinds, ir.BodyCallPassStackValueTag)
    add(call.argAbiSizes, 4)
    add(call.argSlots, ir.CallArgSlotAddress(2))
    add(call.argPassKinds, ir.BodyCallPassParamAddressTag)
    add(call.argAbiSizes, 8)
    add(call.argSlots, ir.CallArgSlotAddress(3))
    add(call.argPassKinds, ir.BodyCallPassBorrowAddressTag)
    add(call.argAbiSizes, 8)
    add(call.argSlots, ir.CallArgSlotAddress(4))
    add(call.argPassKinds, ir.BodyCallPassByAddressAggregateTag)
    add(call.argAbiSizes, 8)
    add(call.argSlots, 12)
    add(call.argPassKinds, ir.BodyCallPassGlobalAddressTag)
    add(call.argAbiSizes, 8)
    add(call.argSlots, ir.CallArgSlotConstPtrNil())
    add(call.argPassKinds, ir.BodyCallPassPtrNilTag)
    add(call.argAbiSizes, 8)
    add(call.argSlots, ir.CallArgSlotConstTrue())
    add(call.argPassKinds, ir.BodyCallPassStackValueTag)
    add(call.argAbiSizes, 1)
    add(call.argSlots, ir.CallArgSlotCString(literal))
    add(call.argPassKinds, ir.BodyCallPassStackValueTag)
    add(call.argAbiSizes, 8)
    add(body.callSequence, call)

    var panicCall: ir.CallOp
    panicCall.targetSymbol = "panic"
    panicCall.resultSlot = -1
    panicCall.resultPassKind = ir.BodyCallPassStackValueTag
    panicCall.relocWordOffset = -1
    add(panicCall.argSlots, 0)
    add(panicCall.argPassKinds, ir.BodyCallPassStackValueTag)
    add(panicCall.argAbiSizes, 4)
    add(body.callSequence, panicCall)

    var operands: int32[]
    add(operands, ir.LocalI32Tag)
    add(operands, 1)
    appendOp(body, ir.BodyOpLoadConstTag, 0, operands)
    operands = []
    add(operands, 0)
    appendOp(body, ir.BodyOpCallTag, 1, operands)
    operands = []
    add(operands, ir.LocalI32Tag)
    add(operands, 1)
    add(operands, 0)
    add(operands, 1)
    appendOp(body, ir.BodyOpBinOpTag, 2, operands)
    operands = []
    add(operands, ir.BodyCondI32EqTag)
    add(operands, 0)
    add(operands, 1)
    appendOp(body, ir.BodyOpCmpTag, 3, operands)
    operands = []
    add(operands, ir.BodyBranchIfLocalLeZeroCallArg0ReturnI32ConstTag)
    add(operands, 0)
    add(operands, 1)
    add(operands, 0)
    appendOp(body, ir.BodyOpBranchTag, -1, operands)
    operands = []
    add(operands, ir.LocalI32Tag)
    appendOp(body, ir.BodyOpReturnTag, 0, operands)
    operands = []
    add(operands, 0)
    appendOp(body, ir.BodyOpLoadLocalTag, 4, operands)
    operands = []
    add(operands, 4)
    appendOp(body, ir.BodyOpStoreLocalTag, 5, operands)
    appendOp(body, ir.BodyOpCopyLocalTag, 6, operands)
    operands = []
    add(operands, ir.BodyResultProjectIsErrTag)
    add(operands, 1)
    appendOp(body, ir.BodyOpResultProjectTag, 7, operands)
    operands = []
    add(operands, 0)
    add(operands, literal)
    appendOp(body, ir.BodyOpStrEqLiteralTag, 8, operands)
    operands = []
    add(operands, 11)
    add(operands, 9)
    appendOp(body, ir.BodyOpIndexedLoadTag, 9, operands)
    appendOp(body, ir.BodyOpIndexedStoreTag, 11, operands)
    operands = []
    add(operands, 11)
    add(operands, 10)
    add(operands, 0)
    add(operands, 4)
    appendOp(body, ir.BodyOpFieldLoadTag, 10, operands)
    appendOp(body, ir.BodyOpFieldStoreTag, 11, operands)
    operands = []
    add(operands, 12)
    appendOp(body, ir.BodyOpGlobalLoadTag, 10, operands)
    appendOp(body, ir.BodyOpGlobalStoreTag, 10, operands)
    operands = []
    add(operands, 0)
    add(operands, 4)
    appendOp(body, ir.BodyOpStrEqTag, 8, operands)
    operands = []
    add(operands, 0)
    add(operands, 1)
    appendOp(body, ir.BodyOpResultPanicGuardTag, -1, operands)

    let _ = appendReturn(body, 0)
    let _ = appendBr(body, 0)
    let _ = appendCbr(body, 0, 0, 0)
    return body

fn runAccessExhaustive(): int32 =
    var body = buildAccessExhaustiveBody()
    var table = access.BodyIrAccessDecode(body)
    if !table.valid:
        return 21
    if body.ops.len != 19 || table.opFactCounts.len != 19:
        return 22
    var seenKinds: bool[]
    for _ in 0..<ir.BodyOpTagCount:
        add(seenKinds, false)
    for opIndex in 0..<body.ops.len:
        if table.opFactCounts[opIndex] <= 0:
            return 23
        seenKinds[body.ops[opIndex].kind] = true
    for kind in ir.BodyOpFirstTag..<(ir.BodyOpLastTag + 1):
        if !seenKinds[kind]:
            return 24
    if table.termFactCounts.len != 3 ||
       table.callFactCounts.len != 2 || table.callFactCounts[0] <= 0 ||
       table.callFactCounts[1] <= 0:
        return 25
    var sawFixed: bool
    var sawClobber: bool
    var sawMemory: bool
    var sawAddressEscape: bool
    let callStart = table.callFactStarts[0]
    let callEnd = callStart + table.callFactCounts[0]
    for factIndex in callStart..<callEnd:
        let fact = table.facts[factIndex]
        if fact.kind == access.BodyIrAccessFactFixed:
            sawFixed = true
        if fact.kind == access.BodyIrAccessFactClobber &&
           fact.clobberKind == access.BodyIrAccessClobberCallAbi:
            sawClobber = true
        if fact.kind == access.BodyIrAccessFactMemory &&
           fact.memoryEffect == access.BodyIrAccessMemoryCallReadWrite:
            sawMemory = true
        if fact.kind == access.BodyIrAccessFactAddress && fact.addressEscapes:
            sawAddressEscape = true
    if !sawFixed:
        for factIndex in 0..<table.facts.len:
            if table.facts[factIndex].kind == access.BodyIrAccessFactFixed:
                return 65
        return 61
    if !sawClobber:
        return 62
    if !sawMemory:
        return 63
    if !sawAddressEscape:
        return 64

    var unknown = ir.BodyIRNew()
    add(unknown.localSlots, makeI32Slot(0, "x", true))
    var badOp: ir.BodyOp
    badOp.kind = 99
    badOp.target = 0
    add(unknown.ops, badOp)
    let _ = appendReturn(unknown, 0)
    var badTable = access.BodyIrAccessDecode(unknown)
    if badTable.valid || badTable.errorCode != access.BodyIrAccessErrorUnknownOp:
        return 27

    var badArity = ir.BodyIRNew()
    add(badArity.localSlots, makeI32Slot(0, "x", true))
    var shortConst: ir.BodyOp
    shortConst.kind = ir.BodyOpLoadConstTag
    shortConst.target = 0
    add(shortConst.operands, ir.LocalI32Tag)
    add(badArity.ops, shortConst)
    let _ = appendReturn(badArity, 0)
    badTable = access.BodyIrAccessDecode(badArity)
    if badTable.valid || badTable.errorCode != access.BodyIrAccessErrorArity:
        return 28

    var badPass = ir.BodyIRNew()
    add(badPass.localSlots, makeI32Slot(0, "x", true))
    var invalidCall: ir.CallOp
    invalidCall.resultSlot = 0
    invalidCall.resultPassKind = ir.BodyCallPassStackValueTag
    add(invalidCall.argSlots, 0)
    add(invalidCall.argPassKinds, 99)
    add(badPass.callSequence, invalidCall)
    var invalidCallOp: ir.BodyOp
    invalidCallOp.kind = ir.BodyOpCallTag
    invalidCallOp.target = 0
    add(invalidCallOp.operands, 0)
    add(badPass.ops, invalidCallOp)
    let _ = appendReturn(badPass, 0)
    badTable = access.BodyIrAccessDecode(badPass)
    if badTable.valid || badTable.errorCode != access.BodyIrAccessErrorPassKind:
        return 29
    return 0

fn buildBadGlobalAddressCall(encodedSlot: int32): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeI32Slot(0, "local", true))
    var call: ir.CallOp
    call.targetSymbol = "global_arg"
    call.resultSlot = 0
    call.resultPassKind = ir.BodyCallPassStackValueTag
    add(call.argSlots, encodedSlot)
    add(call.argPassKinds, ir.BodyCallPassGlobalAddressTag)
    add(call.argAbiSizes, 8)
    add(body.callSequence, call)
    var op: ir.BodyOp
    op.kind = ir.BodyOpCallTag
    op.target = 0
    add(op.operands, 0)
    add(body.ops, op)
    let _ = appendReturn(body, 0)
    return body

fn buildManagedGlobalStoreCall(typeKind: int32,
                               managedStoreKind: int32,
                               symbol: str): ir.BodyIR =
    var body = ir.BodyIRNew()
    var destination = makeI32Slot(0, "managed_destination", false)
    destination.typeKind = typeKind
    destination.placeKind = ir.BodyPlaceGlobalAddressTag
    destination.sizeBytes = 24
    if typeKind == ir.LocalAggregateTag:
        destination.sizeBytes = 16
    destination.alignBytes = 8
    var source = destination
    source.id = 1
    source.name = "managed_source"
    add(body.localSlots, destination)
    add(body.localSlots, source)
    add(body.localSlots, makeI32Slot(2, "result", true))
    var call: ir.CallOp
    call.targetSymbol = symbol
    call.resultSlot = -1
    call.resultPassKind = ir.BodyCallPassStackValueTag
    call.resultOwnership = ir.OwnInvalid
    call.resultExprNodeIndex = -1
    call.managedStoreKind = managedStoreKind
    add(call.argSlots, 0)
    add(call.argPassKinds, ir.BodyCallPassGlobalAddressTag)
    add(call.argSlots, 1)
    add(call.argPassKinds, ir.BodyCallPassGlobalAddressTag)
    add(body.callSequence, call)
    var op: ir.BodyOp
    op.kind = ir.BodyOpCallTag
    op.target = -1
    op.valueDefSlot = -1
    op.valueDefExprNodeIndex = -1
    op.valueDefOwnership = ir.OwnInvalid
    add(op.operands, 0)
    add(body.ops, op)
    let _ = appendReturn(body, 2)
    return body

fn buildRawAggregateGlobalStore(storageKind: int32,
                                destinationTypeId: int32,
                                sourceTypeId: int32): ir.BodyIR =
    var body = ir.BodyIRNew()
    let typeArenaCid = testTypeArenaCid("body-ir-type-arena-a")
    let _ = ir.BodyIRBindTypeArenaArtifactCid(body, typeArenaCid)
    var destination = makeI32Slot(0, "aggregate_destination", false)
    destination.typeKind = ir.LocalAggregateTag
    destination.placeKind = ir.BodyPlaceGlobalAddressTag
    destination.sizeBytes = 16
    destination.alignBytes = 8
    var source = makeI32Slot(1, "aggregate_source", true)
    source.typeKind = ir.LocalAggregateTag
    source.sizeBytes = 16
    source.alignBytes = 8
    add(body.localSlots, destination)
    add(body.localSlots, source)
    let _ = ir.BodyIRBindLocalSlotTypeArenaProof(
        body, 0, typeArenaCid, destinationTypeId, storageKind)
    let _ = ir.BodyIRBindLocalSlotTypeArenaProof(
        body, 1, typeArenaCid, sourceTypeId, storageKind)
    var op: ir.BodyOp
    op.kind = ir.BodyOpGlobalStoreTag
    op.target = 1
    add(op.operands, 0)
    add(body.ops, op)
    let _ = appendReturn(body, 1)
    return body

fn runSchemaNegativeTests(): int32 =
    var badGlobalPlace = buildBadGlobalAddressCall(0)
    var badTable = access.BodyIrAccessDecode(badGlobalPlace)
    if badTable.valid ||
       badTable.errorCode != access.BodyIrAccessErrorOperandShape:
        return 71
    var badGlobalRange = buildBadGlobalAddressCall(4)
    badTable = access.BodyIrAccessDecode(badGlobalRange)
    if badTable.valid || badTable.errorCode != access.BodyIrAccessErrorLocalRef:
        return 72

    var badConst = ir.BodyIRNew()
    add(badConst.localSlots, makeI32Slot(0, "i32", false))
    var constOp: ir.BodyOp
    constOp.kind = ir.BodyOpLoadConstTag
    constOp.target = 0
    add(constOp.operands, ir.LocalI64Tag)
    add(constOp.operands, 1)
    add(badConst.ops, constOp)
    let _ = appendReturn(badConst, 0)
    badTable = access.BodyIrAccessDecode(badConst)
    if badTable.valid ||
       badTable.errorCode != access.BodyIrAccessErrorOperandShape:
        return 73

    var badCopy = ir.BodyIRNew()
    var strSlot = makeI32Slot(0, "str", true)
    strSlot.typeKind = ir.LocalStrTag
    strSlot.sizeBytes = 24
    strSlot.alignBytes = 8
    add(badCopy.localSlots, strSlot)
    add(badCopy.localSlots, makeI32Slot(1, "i32", false))
    appendCopy(badCopy, 1, 0)
    let _ = appendReturn(badCopy, 1)
    badTable = access.BodyIrAccessDecode(badCopy)
    if badTable.valid ||
       badTable.errorCode != access.BodyIrAccessErrorOperandShape:
        return 74
    var badStore = badCopy
    badStore.ops[0].kind = ir.BodyOpStoreLocalTag
    badTable = access.BodyIrAccessDecode(badStore)
    if badTable.valid ||
       badTable.errorCode != access.BodyIrAccessErrorOperandShape:
        return 75

    var badField = ir.BodyIRNew()
    var fieldBase = makeI32Slot(0, "base", false)
    fieldBase.typeKind = ir.LocalAggregateTag
    fieldBase.sizeBytes = 8
    fieldBase.alignBytes = 8
    var fieldValue = makeI32Slot(1, "value", false)
    fieldValue.typeKind = ir.LocalI64Tag
    fieldValue.sizeBytes = 8
    fieldValue.alignBytes = 8
    add(badField.localSlots, fieldBase)
    add(badField.localSlots, fieldValue)
    var fieldOperands: int32[]
    add(fieldOperands, 0)
    add(fieldOperands, 1)
    add(fieldOperands, 4)
    add(fieldOperands, 8)
    appendOp(badField, ir.BodyOpFieldLoadTag, 1, fieldOperands)
    let _ = appendReturn(badField, 1)
    badTable = access.BodyIrAccessDecode(badField)
    if badTable.valid ||
       badTable.errorCode != access.BodyIrAccessErrorOperandShape:
        return 76

    var badIndexed = ir.BodyIRNew()
    var indexedBase = makeI32Slot(0, "array", true)
    indexedBase.typeKind = ir.LocalAggregateTag
    indexedBase.sizeBytes = 8
    indexedBase.alignBytes = 8
    var indexedValue = makeI32Slot(1, "wide", false)
    indexedValue.typeKind = ir.LocalAggregateTag
    indexedValue.sizeBytes = 16
    indexedValue.alignBytes = 8
    add(badIndexed.localSlots, indexedBase)
    add(badIndexed.localSlots, indexedValue)
    add(badIndexed.localSlots, makeI32Slot(2, "index", true))
    var indexedOperands: int32[]
    add(indexedOperands, 0)
    add(indexedOperands, 1)
    add(indexedOperands, 2)
    add(indexedOperands, 16)
    appendOp(badIndexed, ir.BodyOpIndexedLoadTag, 1, indexedOperands)
    let _ = appendReturn(badIndexed, 1)
    badTable = access.BodyIrAccessDecode(badIndexed)
    if badTable.valid ||
       badTable.errorCode != access.BodyIrAccessErrorOperandShape:
        return 77

    var rawStr = ir.BodyIRNew()
    var rawStrDestination = makeI32Slot(0, "str_destination", false)
    rawStrDestination.typeKind = ir.LocalStrTag
    rawStrDestination.placeKind = ir.BodyPlaceGlobalAddressTag
    rawStrDestination.sizeBytes = 24
    rawStrDestination.alignBytes = 8
    var rawStrSource = makeI32Slot(1, "str_source", true)
    rawStrSource.typeKind = ir.LocalStrTag
    rawStrSource.sizeBytes = 24
    rawStrSource.alignBytes = 8
    add(rawStr.localSlots, rawStrDestination)
    add(rawStr.localSlots, rawStrSource)
    var rawStrStore: ir.BodyOp
    rawStrStore.kind = ir.BodyOpGlobalStoreTag
    rawStrStore.target = 1
    add(rawStrStore.operands, 0)
    add(rawStr.ops, rawStrStore)
    let _ = appendReturn(rawStr, 1)
    badTable = access.BodyIrAccessDecode(rawStr)
    if badTable.valid ||
       badTable.errorCode != access.BodyIrAccessErrorOwnership:
        return 78

    var managedStrRetain = buildManagedGlobalStoreCall(
        ir.LocalStrTag,
        ir.ManagedStoreStrRetainTag,
        "cheng_str_store_managed")
    let managedStrRetainAccess = access.BodyIrAccessDecode(managedStrRetain)
    if !managedStrRetainAccess.valid:
        return 79
    var managedStrMove = buildManagedGlobalStoreCall(
        ir.LocalStrTag,
        ir.ManagedStoreStrMoveTag,
        "cheng_str_move_store_managed")
    if !access.BodyIrAccessDecode(managedStrMove).valid:
        return 80
    var managedSeqRetain = buildManagedGlobalStoreCall(
        ir.LocalAggregateTag,
        ir.ManagedStoreSeqRetainTag,
        "cheng_seq_store_plain_managed")
    if !access.BodyIrAccessDecode(managedSeqRetain).valid:
        return 81
    var managedSeqMove = buildManagedGlobalStoreCall(
        ir.LocalAggregateTag,
        ir.ManagedStoreSeqMoveTag,
        "cheng_seq_move_store_plain_managed")
    if !access.BodyIrAccessDecode(managedSeqMove).valid:
        return 82

    var rawManagedAggregate = buildRawAggregateGlobalStore(
        ir.BodyManagedStorageManagedTag, 41, 41)
    badTable = access.BodyIrAccessDecode(rawManagedAggregate)
    if badTable.valid ||
       badTable.errorCode != access.BodyIrAccessErrorOwnership:
        return 83
    var rawUnmanagedAggregate = buildRawAggregateGlobalStore(
        ir.BodyManagedStorageUnmanagedTag, 41, 41)
    if !access.BodyIrAccessDecode(rawUnmanagedAggregate).valid:
        return 84
    var rawMismatchedAggregate = buildRawAggregateGlobalStore(
        ir.BodyManagedStorageUnmanagedTag, 41, 42)
    badTable = access.BodyIrAccessDecode(rawMismatchedAggregate)
    if badTable.valid ||
       badTable.errorCode != access.BodyIrAccessErrorOwnership:
        return 85
    var domainProbe = ir.BodyIRNew()
    add(domainProbe.localSlots, makeI32Slot(0, "domain_probe", false))
    let arenaA = testTypeArenaCid("body-ir-type-arena-a")
    let arenaB = testTypeArenaCid("body-ir-type-arena-b")
    if ir.BodyIRBindTypeArenaArtifactCid(
           domainProbe, layout.FixedBytes32()):
        return 86
    if !ir.BodyIRBindTypeArenaArtifactCid(domainProbe, arenaA) ||
       ir.BodyIRBindTypeArenaArtifactCid(domainProbe, arenaB):
        return 87
    if ir.BodyIRBindLocalSlotTypeArenaProof(
           domainProbe,
           0,
           arenaB,
           41,
           ir.BodyManagedStorageUnmanagedTag):
        return 88
    if !ir.BodyIRBindLocalSlotTypeArenaProof(
           domainProbe,
           0,
           arenaA,
           41,
           ir.BodyManagedStorageUnmanagedTag) ||
       !ir.BodyIRTypeArenaProofDomainValid(domainProbe):
        return 89
    return 0

fn runSequentialRedefinition(): int32 =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeI32Slot(0, "param", true))
    add(body.localSlots, makeI32Slot(1, "value", false))
    appendCopy(body, 1, 0)
    var storeOp: ir.BodyOp
    storeOp.kind = ir.BodyOpStoreLocalTag
    storeOp.target = 1
    add(storeOp.operands, 0)
    add(body.ops, storeOp)
    appendConst(body, 1, 7)
    let termIndex = appendReturn(body, 1)
    let _ = ir.BodyIRAppendBlock(body, 0, body.ops.len, termIndex)
    var accessTable = access.BodyIrAccessDecode(body)
    if !accessTable.valid:
        return 11
    if accessTable.nextValueId != 4:
        return 12
    var analysis = cfg.BodyIrCfgAnalyze(body, accessTable)
    if !analysis.valid:
        return 13
    let useFact = accessTable.termFactStarts[termIndex]
    let lastDefFact = accessTable.opFactStarts[2]
    if cfg.BodyIrCfgReachingValueAt(analysis, useFact) !=
       accessTable.facts[lastDefFact].valueId:
        return 14
    return 0

fn buildDiamond(redefineBranches: bool): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeI32Slot(0, "condition", true))
    add(body.localSlots, makeI32Slot(1, "value", true))
    if redefineBranches:
        appendCopy(body, 1, 0)
        appendCopy(body, 1, 0)
    let entryTerm = appendCbr(body, 0, 1, 2)
    let trueTerm = appendBr(body, 3)
    let falseTerm = appendBr(body, 3)
    let joinTerm = appendReturn(body, 1)
    let _ = ir.BodyIRAppendBlock(body, 0, 0, entryTerm)
    if redefineBranches:
        let _ = ir.BodyIRAppendBlock(body, 0, 1, trueTerm)
        let _ = ir.BodyIRAppendBlock(body, 1, 1, falseTerm)
        let _ = ir.BodyIRAppendBlock(body, 2, 0, joinTerm)
    else:
        let _ = ir.BodyIRAppendBlock(body, 0, 0, trueTerm)
        let _ = ir.BodyIRAppendBlock(body, 0, 0, falseTerm)
        let _ = ir.BodyIRAppendBlock(body, 0, 0, joinTerm)
    return body

fn buildPartialDiamond(): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeI32Slot(0, "condition", true))
    add(body.localSlots, makeI32Slot(1, "value", false))
    appendCopy(body, 1, 0)
    let entryTerm = appendCbr(body, 0, 1, 2)
    let trueTerm = appendBr(body, 3)
    let falseTerm = appendBr(body, 3)
    let joinTerm = appendReturn(body, 1)
    let _ = ir.BodyIRAppendBlock(body, 0, 0, entryTerm)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, trueTerm)
    let _ = ir.BodyIRAppendBlock(body, 1, 0, falseTerm)
    let _ = ir.BodyIRAppendBlock(body, 1, 0, joinTerm)
    return body

fn runDiamondTests(): int32 =
    var sameVersion = buildDiamond(false)
    var sameAccess = access.BodyIrAccessDecode(sameVersion)
    if !sameAccess.valid:
        return 31
    var sameCfg = cfg.BodyIrCfgAnalyze(sameVersion, sameAccess)
    if !sameCfg.valid || sameCfg.edgeCount != 4 || sameCfg.hasCycle:
        return 32
    if sameCfg.predOffsets[4] - sameCfg.predOffsets[3] != 2:
        return 33
    if !cfg.BodyIrCfgLiveInAt(sameCfg, 1, 1) ||
       !cfg.BodyIrCfgLiveOutAt(sameCfg, 1, 1):
        return 34
    if cfg.BodyIrCfgEntryVersionAt(sameCfg, 3, 1) !=
       sameCfg.mergeValueByBlockSlot[7] ||
       sameCfg.mergeValueByBlockSlot[7] < sameAccess.nextValueId ||
       sameCfg.mergeInputCounts[7] != 2:
        return 35

    var doubleDefined = buildDiamond(true)
    var doubleAccess = access.BodyIrAccessDecode(doubleDefined)
    if !doubleAccess.valid:
        return 36
    var doubleCfg = cfg.BodyIrCfgAnalyze(doubleDefined, doubleAccess)
    if !doubleCfg.valid:
        return 37
    let doubleMerge = doubleCfg.mergeValueByBlockSlot[7]
    if doubleMerge < doubleAccess.nextValueId ||
       doubleCfg.mergeInputCounts[7] != 2:
        return 38
    let joinTermIndex = doubleDefined.blocks[3].termIndex
    let joinUseFact = doubleAccess.termFactStarts[joinTermIndex]
    if cfg.BodyIrCfgReachingValueAt(doubleCfg, joinUseFact) != doubleMerge:
        return 39

    var partial = buildPartialDiamond()
    var partialAccess = access.BodyIrAccessDecode(partial)
    if !partialAccess.valid:
        return 65
    var partialCfg = cfg.BodyIrCfgAnalyze(partial, partialAccess)
    if partialCfg.valid ||
       partialCfg.errorCode != cfg.BodyIrCfgErrorUninitializedUse ||
       partialCfg.errorSlot != 1:
        return 66

    var badTypeBody = buildDiamond(true)
    var badTypeAccess = access.BodyIrAccessDecode(badTypeBody)
    if !badTypeAccess.valid:
        return 67
    var badTypeFactIndex: int32 = -1
    for factIndex in 0..<badTypeAccess.facts.len:
        if badTypeAccess.facts[factIndex].kind == access.BodyIrAccessFactDef &&
           badTypeAccess.facts[factIndex].siteKind == access.BodyIrAccessSiteOp:
            badTypeFactIndex = factIndex
            break
    if badTypeFactIndex < 0:
        return 68
    let badTypeValue = badTypeAccess.facts[badTypeFactIndex].valueId
    badTypeAccess.facts[badTypeFactIndex].typeKind = ir.LocalPtrTag
    badTypeAccess.valueTypeKinds[badTypeValue] = ir.LocalPtrTag
    var badTypeCfg = cfg.BodyIrCfgAnalyze(badTypeBody, badTypeAccess)
    if badTypeCfg.valid || badTypeCfg.errorCode != cfg.BodyIrCfgErrorTypeConflict:
        return 69
    return 0

fn buildLoop(carriedUpdate: bool): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeI32Slot(0, "carried", true))
    if carriedUpdate:
        appendCopy(body, 0, 0)
    let headerTerm = appendCbr(body, 0, 1, 2)
    let latchTerm = appendBr(body, 0)
    let exitTerm = appendReturn(body, 0)
    let _ = ir.BodyIRAppendBlock(body, 0, 0, headerTerm)
    if carriedUpdate:
        let _ = ir.BodyIRAppendBlock(body, 0, 1, latchTerm)
        let _ = ir.BodyIRAppendBlock(body, 1, 0, exitTerm)
    else:
        let _ = ir.BodyIRAppendBlock(body, 0, 0, latchTerm)
        let _ = ir.BodyIRAppendBlock(body, 0, 0, exitTerm)
    return body

fn runLoopTests(): int32 =
    var stable = buildLoop(false)
    var stableAccess = access.BodyIrAccessDecode(stable)
    if !stableAccess.valid:
        return 41
    var stableCfg = cfg.BodyIrCfgAnalyze(stable, stableAccess)
    if !stableCfg.valid || !stableCfg.hasCycle || stableCfg.edgeCount != 3:
        return 42
    if !cfg.BodyIrCfgLiveInAt(stableCfg, 0, 0) ||
       !cfg.BodyIrCfgLiveOutAt(stableCfg, 1, 0):
        return 43
    let stableMerge = stableCfg.mergeValueByBlockSlot[0]
    let stableMergeStart = stableCfg.mergeInputStarts[0]
    if stableMerge < stableAccess.nextValueId ||
       stableCfg.mergeInputCounts[0] != 2 ||
       stableCfg.mergeInputValues[stableMergeStart + 1] != stableMerge:
        return 48

    var carried = buildLoop(true)
    var carriedAccess = access.BodyIrAccessDecode(carried)
    if !carriedAccess.valid:
        return 44
    var carriedCfg = cfg.BodyIrCfgAnalyze(carried, carriedAccess)
    if !carriedCfg.valid:
        return 45
    let headerMerge = carriedCfg.mergeValueByBlockSlot[0]
    if headerMerge < carriedAccess.nextValueId ||
       carriedCfg.mergeInputCounts[0] != 2:
        return 46
    let carriedMergeStart = carriedCfg.mergeInputStarts[0]
    if carriedCfg.mergeInputValues[carriedMergeStart + 1] == headerMerge:
        return 49
    let carriedUseFact = carriedAccess.opFactStarts[0]
    if cfg.BodyIrCfgReachingValueAt(carriedCfg, carriedUseFact) != headerMerge:
        return 47
    return 0

fn runMalformedCfgTests(): int32 =
    var unreachable = ir.BodyIRNew()
    add(unreachable.localSlots, makeI32Slot(0, "x", true))
    let firstReturn = appendReturn(unreachable, 0)
    let unreachableBackEdge = appendBr(unreachable, 0)
    let _ = ir.BodyIRAppendBlock(unreachable, 0, 0, firstReturn)
    let _ = ir.BodyIRAppendBlock(unreachable, 0, 0, unreachableBackEdge)
    var unreachableAccess = access.BodyIrAccessDecode(unreachable)
    if !unreachableAccess.valid:
        return 51
    var unreachableCfg = cfg.BodyIrCfgAnalyze(unreachable, unreachableAccess)
    if !unreachableCfg.valid || !unreachableCfg.reachable[0] ||
       unreachableCfg.reachable[1] ||
       unreachableCfg.reversePostorder.len != 1 ||
       cfg.BodyIrCfgLiveInAt(unreachableCfg, 1, 0):
        return 52

    var badEdge = ir.BodyIRNew()
    add(badEdge.localSlots, makeI32Slot(0, "x", true))
    let branch = appendBr(badEdge, 1)
    let _ = ir.BodyIRAppendBlock(badEdge, 0, 0, branch)
    var badEdgeAccess = access.BodyIrAccessDecode(badEdge)
    if !badEdgeAccess.valid:
        return 53
    var badEdgeCfg = cfg.BodyIrCfgAnalyze(badEdge, badEdgeAccess)
    if badEdgeCfg.valid || badEdgeCfg.errorCode != cfg.BodyIrCfgErrorEdge:
        return 54
    return 0

fn main(): int32 =
    let accessCode = runAccessExhaustive()
    if accessCode != 0:
        return accessCode
    let sequentialCode = runSequentialRedefinition()
    if sequentialCode != 0:
        return sequentialCode
    let schemaCode = runSchemaNegativeTests()
    if schemaCode != 0:
        return schemaCode
    let diamondCode = runDiamondTests()
    if diamondCode != 0:
        return diamondCode
    let loopCode = runLoopTests()
    if loopCode != 0:
        return loopCode
    return runMalformedCfgTests()
