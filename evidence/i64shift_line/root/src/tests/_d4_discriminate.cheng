import std/system as system

# D4 discriminator: separate "final buffer leaks at scope exit" from
# "each grow leaks the superseded buffer".
#
# L2: 2 adds -> cap 0->4 grow fires once with old=NULL (nothing to free),
#     no further realloc. Final buffer = exactly 1 malloc.
#       final-buffer leak    -> +1 block per call
#       grow leak            -> +0 (superseded buffer is NULL)
# L9: 9 adds -> grows: 0->4 (old NULL), 4->8 (leaks 16B buf), 8->16 (leaks 32B buf).
#       final-buffer leak    -> +1 block per call
#       grow leak            -> +2 blocks per call
# L2 rounds=400, L9 rounds=400.
# exit = 100*bucket(L9) + bucket(L2); buckets capped at 63.
#   L2=1,L9=3 -> 301 : final leaks AND grows leak (both)
#   L2=0,L9=2 -> 200 : only grow leaks   (scope drop present)  <- expected per base disasm
#   L2=1,L9=1 -> 101 : only final leaks  (grow release present)
#   L2=0,L9=0 -> 0   : neither leaks

var probeSink: int32

fn L2(count: int32): int32 =
    var values: int32[]
    var i: int32
    while i < count:
        add(values, i)
        i = i + 1
    return values.len

fn L9(count: int32): int32 =
    var values: int32[]
    var i: int32
    while i < count:
        add(values, i)
        i = i + 1
    return values.len

fn Repeat(fn_choice: int32, rounds: int32): int32 =
    var acc: int32
    var r: int32
    while r < rounds:
        if fn_choice == 2:
            acc = acc + L2(2)
        else:
            acc = acc + L9(9)
        r = r + 1
    return acc

fn Bucket(delta: int64): int64 =
    if delta <= 0:
        return 0
    if delta > 63:
        return 63
    return delta

fn main(): int32 =
    let rounds: int32 = 400
    let before2 = system.MemLiveAllocations()
    let obs2 = Repeat(2, rounds)
    let d2 = system.MemLiveAllocations() - before2
    let before9 = system.MemLiveAllocations()
    let obs9 = Repeat(9, rounds)
    let d9 = system.MemLiveAllocations() - before9
    probeSink = obs2 + obs9
    if obs2 <= 0 || obs9 <= 0:
        return 99
    return int32(Bucket(d9) * 100 + Bucket(d2))
