@profile("driver_safe")

type
    IoUInt8Ptr = uint8 *
    IoUInt32Ptr = uint32 *

@trusted_abi
fn IoLd32(base: uint64, offset: uint64): uint32 =
    let b = base
    let o = offset
    let addr = ptr(b + o)
    return *(IoUInt32Ptr(addr))

@trusted_abi
fn IoSt8(base: uint64, offset: uint64, value: int32) =
    let b = base
    let o = offset
    let addr = ptr(b + o)
    *(IoUInt8Ptr(addr)) = uint8(value & 255)

fn HexNib(v: uint32) =
    let w = v
    if w < 10:
        IoSt8(268435456, 0, int32(48 + w))
    else:
        IoSt8(268435456, 0, int32(87 + w))

fn Hex32(v: uint32) =
    var div = uint32(268435456)
    while div > uint32(0):
        HexNib((v / div) & uint32(15))
        div = div / uint32(16)

fn Sep() =
    IoSt8(268435456, 0, 32)

@trusted_abi
fn ReadMagic(base: uint64): uint32 =
    let o = uint64(0)
    let magic = IoLd32(base, o)
    return magic

fn GpuRosMain(): int32 =
    let b7 = uint64(268468224)
    let m = ReadMagic(b7)
    Hex32(m)
    Sep()
    Hex32(IoLd32(b7, uint64(8)))
    IoSt8(268435456, 0, 10)
    return 0

fn main(): int32 =
    return GpuRosMain()
