type
    ColdVarPlaceAliasInner = ref object
        value: int32

    ColdVarPlaceAliasOuter = ref object
        inner: ColdVarPlaceAliasInner

fn ColdVarPlaceAliasWrite(
        first: var int32,
        second: var int32) =
    first = 31
    second = 37

fn ColdVarPlaceAliasMutate(
        out: var ColdVarPlaceAliasOuter) =
    var inner = out.inner
    ColdVarPlaceAliasWrite(
        inner.value,
        inner.value)

fn main(): int32 =
    var out = new(ColdVarPlaceAliasOuter)
    out.inner = new(ColdVarPlaceAliasInner)
    ColdVarPlaceAliasMutate(out)
    return 0
