import std/system
import std/result

fn main(): int32 =
    // Test basic Result usage
    let ok: Result[int32] = Ok[int32](42)
    assert(IsOk(ok), " result: is ok")

    let val: int32 = Value(ok)
    assert(val == 42, " result: ok value")

    let err: Result[int32] = Err[int32]("something went wrong")
    assert(IsErr(err), " result: is err")

    // Test ErrCode - the specific pattern that failed
    let errCode: Result[int32] = ErrCode[int32](404, "not found")
    assert(IsErr(errCode), " errcode: is err")

    echo(" cold_smoke_errcode_generic ok")
    return 0
