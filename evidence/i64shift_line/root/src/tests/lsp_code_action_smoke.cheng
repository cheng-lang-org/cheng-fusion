# Code-action wire smoke only. The production server does not advertise code
# actions; semantic suggestions and name-similarity heuristics are forbidden.

import std/os
import std/json as json
import cheng/core/tooling/lsp_protocol as lsp

fn main() =
    var edit = json.NewJObject()
    edit["changes"] = json.NewJObject()
    let action = lsp.LspMakeCodeAction(
        "Apply exact compiler edit", "quickfix", [3, 7], edit)
    assert(action.title == "Apply exact compiler edit" &&
           action.kind == "quickfix" &&
           action.diagnostics.len == 2 &&
           action.diagnostics[0] == 3 &&
           action.diagnostics[1] == 7 &&
           action.edit.kind == json.JObject,
           "lsp code action: wire structure drift")
    os.WriteLine(os.Get_stdout(), "lsp_code_action_smoke: ok")
