import std/os as os
import std/rawbytes
import std/strings
import std/system
import cheng/core/csg_core/csgc
import cheng/core/csg_core/csgc_authority
import cheng/core/csg_core/merkle_dag
import cheng/core/csg_core/merkle_manifest
import cheng/core/csg_core/merkle_store
import cheng/core/csg_core/validator

const
    Cid1: str = "sha256:1111111111111111111111111111111111111111111111111111111111111111"
    Cid2: str = "sha256:2222222222222222222222222222222222222222222222222222222222222222"
    Cid3: str = "sha256:3333333333333333333333333333333333333333333333333333333333333333"
    Cid4: str = "sha256:4444444444444444444444444444444444444444444444444444444444444444"
    Cid5: str = "sha256:5555555555555555555555555555555555555555555555555555555555555555"
    Cid6: str = "sha256:6666666666666666666666666666666666666666666666666666666666666666"
    Cid7: str = "sha256:7777777777777777777777777777777777777777777777777777777777777777"
    Cid8: str = "sha256:8888888888888888888888888888888888888888888888888888888888888888"
    Cid9: str = "sha256:9999999999999999999999999999999999999999999999999999999999999999"
    CidA: str = "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

@borrows
fn fail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

@borrows
fn contains(text: str, wanted: str): bool =
    return strings.StrContains(text, wanted)

@borrows
fn endsWith(text: str, suffix: str): bool =
    if suffix.len <= 0 || text.len < suffix.len:
        return false
    let start = text.len - suffix.len
    for index in 0..<suffix.len:
        if text[start + index] != suffix[index]:
            return false
    return true

@borrows
fn subgraphFor(count: int32, dagRootCid: str): str =
    var error: str
    return merkle_dag.CsgCoreMerkleSubgraphCidForDagRoot(
        count,
        dagRootCid,
        error)

@borrows
fn partition(
        sourceId: str,
        sourceCid: str,
        factKind: str,
        factsCid: str,
        dagRootCid: str,
        membershipCid: str):
        merkle_manifest.CsgCoreMerklePartitionRecord =
    var out: merkle_manifest.CsgCoreMerklePartitionRecord
    out.sourceId = strings.CloneStr(sourceId)
    out.sourceCid = strings.CloneStr(sourceCid)
    out.factKind = strings.CloneStr(factKind)
    out.factsCid = strings.CloneStr(factsCid)
    out.factsRoot = subgraphFor(2, dagRootCid)
    out.dagRootCid = strings.CloneStr(dagRootCid)
    out.membershipCid = strings.CloneStr(membershipCid)
    out.factCount = 2
    return out

@borrows
fn descriptor(
        sourceId: str,
        cid: str,
        root: str):
        merkle_manifest.CsgCoreMerkleShardDescriptor =
    var out: merkle_manifest.CsgCoreMerkleShardDescriptor
    out.shardKey = strings.CloneStr(sourceId)
    out.cid = strings.CloneStr(cid)
    out.root = strings.CloneStr(root)
    return out

@borrows
fn manifestFor(
        factsRoot: str,
        dagRootCid: str):
        merkle_manifest.CsgCoreMerkleManifest =
    var out: merkle_manifest.CsgCoreMerkleManifest
    out.standard = validator.CsgCoreStandardIdentity()
    out.profiles = [validator.CsgCoreBaseProfileIdentity()]
    out.profileSetCid =
        validator.CsgCoreProfileSetCid(out.profiles)
    out.complete = true
    out.schemaCid = CidA
    out.factsRoot = strings.CloneStr(factsRoot)
    out.dagRootCid = strings.CloneStr(dagRootCid)
    out.factCount = 4
    out.nodeCount = 7
    add(
        out.partitions,
        partition(
            "source:A", Cid1, "csg.core.schema",
            Cid2, Cid4, Cid5))
    add(
        out.partitions,
        partition(
            "source:B", Cid2, "csg.symbol",
            Cid3, Cid5, Cid6))
    out.partitionRoot =
        merkle_manifest.CsgCoreMerklePartitionRoot(
            out.partitions)
    add(
        out.dependencyConsumerShards,
        descriptor("source:A", Cid6, Cid7))
    add(
        out.dependencyConsumerShards,
        descriptor("source:B", Cid7, Cid8))
    out.dependencyConsumerRoot =
        merkle_manifest.CsgCoreMerkleShardDescriptorRoot(
            merkle_manifest.CsgCoreMerkleDependencyConsumerShardKind(),
            out.dependencyConsumerShards)
    add(
        out.dependencyProviderShards,
        descriptor("source:A", Cid8, Cid9))
    add(
        out.dependencyProviderShards,
        descriptor("source:B", Cid9, CidA))
    out.dependencyProviderRoot =
        merkle_manifest.CsgCoreMerkleShardDescriptorRoot(
            merkle_manifest.CsgCoreMerkleDependencyProviderShardKind(),
            out.dependencyProviderShards)
    out.queryShardRoot =
        merkle_manifest.CsgCoreMerkleShardDescriptorRoot(
            merkle_manifest.CsgCoreMerkleQueryShardKind(),
            out.queryShards)
    out.summaryCid = Cid8
    return out

fn main(): int32 =
    let persistentRoot = os.PersistentUserDataRootIssue()
    if !persistentRoot.ok ||
       persistentRoot.effectiveUid != os.EffectiveUserId():
        return fail(strings.ConcatStr(
            "authenticated persistent root failed: ",
            persistentRoot.error))
    if persistentRoot.platform == "darwin":
        if !endsWith(
               persistentRoot.rootPath,
               "/Library/Application Support/Cheng"):
            return fail("Darwin persistent root suffix mismatch")
    elif persistentRoot.platform == "linux":
        if !endsWith(
               persistentRoot.rootPath,
               "/.local/share/cheng"):
            return fail("Linux persistent root suffix mismatch")
    else:
        return fail("persistent root platform unsupported")

    let schema =
        "{\"features\":[\"core-facts\"],\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}"
    let moduleA =
        "{\"id\":\"mod_a\",\"kind\":\"csg.module\",\"path\":\"a.cheng\",\"sha256\":\"sha256:aaa\"}"
    let symbolA =
        "{\"id\":\"sym_a\",\"kind\":\"csg.symbol\",\"name\":\"A\",\"symbolKind\":\"fn\"}"
    let symbolB =
        "{\"id\":\"sym_b\",\"kind\":\"csg.symbol\",\"name\":\"B\",\"symbolKind\":\"fn\"}"
    let facts = [schema, moduleA, symbolA, symbolB]
    let dag = merkle_dag.CsgCoreMerkleBuildBound(
        facts,
        "csg_core::v1",
        ["csg_core"],
        "csg_core::v1",
        CidA)
    if !dag.ok || dag.factsRoot.len == 0:
        return fail("authority DAG fixture failed")

    var encoded = csgc.CsgCoreCsgcEncodeCanonicalLines(facts)
    if !encoded.ok || encoded.factCount != facts.len:
        return fail("authority CSGC fixture failed")
    defer:
        rawbytes.BytesFree(encoded.bytes)

    var manifest = manifestFor(
        dag.factsRoot,
        merkle_dag.CsgCoreMerkleDagRootCid(dag))
    manifest.csgcDirectoryCid =
        strings.CloneStr(encoded.claimedDirectoryCid)
    manifest.csgcByteCount = rawbytes.BytesLen(encoded.bytes)
    var objectCidError: str
    manifest.csgcObjectCid =
        merkle_store.CsgCoreMerkleStoreArtifactCid(
            merkle_store.
                CsgCoreMerkleStoreCanonicalCsgcArtifactKind(),
            encoded.bytes,
            objectCidError)
    if objectCidError.len > 0 || manifest.csgcObjectCid.len == 0:
        return fail("authority object CID fixture failed")
    var manifestArtifact =
        merkle_manifest.CsgCoreMerkleManifestEncode(manifest)
    if !manifestArtifact.ok:
        return fail(strings.ConcatStr(
            "authority manifest fixture failed: ",
            manifestArtifact.error))
    defer:
        rawbytes.BytesFree(manifestArtifact.bytes)

    let untrustedMissing =
        csgc.CsgCoreCsgcDecodeFactKindClaimed(
            encoded.bytes,
            "csg.missing")
    if !untrustedMissing.ok || untrustedMissing.found ||
       untrustedMissing.claimedDirectoryCid !=
           encoded.claimedDirectoryCid:
        return fail("untrusted missing-kind claim fixture failed")

    let productionPolicy =
        csgc_authority.CsgCoreCsgcProductionPolicyIssue()
    let productionAnchor =
        csgc_authority.
            CsgCoreCsgcUpstreamTrustAnchorReadCurrentHead(
                productionPolicy)
    let productionAnchorError =
        csgc_authority.CsgCoreCsgcUpstreamTrustAnchorError(
            productionAnchor)
    if contains(
           productionAnchorError,
           "production_policy_not_admitted"):
        return fail(strings.ConcatStr(
            "canonical production policy issuance failed: ",
            productionAnchorError))

    var absentSessionOwner: system.RuntimeAllocationLedgerSessionCapability
    let unbound =
        csgc_authority.CsgCoreCsgcAuthorityVerifyAndSeal(
            absentSessionOwner,
            productionAnchor,
            manifestArtifact.bytes)
    if csgc_authority.CsgCoreCsgcAuthorityIsValid(unbound) ||
       csgc_authority.CsgCoreCsgcAuthorityError(unbound).len == 0:
        return fail(
            "self-consistent artifacts bypassed production current HEAD")
    let refusedDecode =
        csgc_authority.CsgCoreCsgcDecodeFactKindAuthorized(
            absentSessionOwner,
            "csg.symbol",
            unbound)
    if refusedDecode.ok ||
       !contains(refusedDecode.error, "authority_not_admitted"):
        return fail("unadmitted authority reached lazy decode")
    let refusedMissing =
        csgc_authority.CsgCoreCsgcDecodeFactKindAuthorized(
            absentSessionOwner,
            "csg.missing",
            unbound)
    if refusedMissing.ok ||
       !contains(refusedMissing.error, "authority_not_admitted"):
        return fail(
            "unadmitted missing-kind authority reached lazy decode")

    os.WriteLine(
        os.Get_stdout(),
        "csg_core_csgc_authority_negative_smoke ok")
    return 0
