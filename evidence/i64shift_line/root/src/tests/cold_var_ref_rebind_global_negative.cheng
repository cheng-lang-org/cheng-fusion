type
    ColdVarRefGlobalCell = ref object
        value: int32

var
    coldVarRefGlobalTarget: ColdVarRefGlobalCell

fn ColdVarRefGlobalRebind(
        target: var ColdVarRefGlobalCell,
        replacement: ColdVarRefGlobalCell) =
    target = replacement

fn main(): int32 =
    coldVarRefGlobalTarget = new(ColdVarRefGlobalCell)
    let replacement = new(ColdVarRefGlobalCell)
    ColdVarRefGlobalRebind(coldVarRefGlobalTarget, replacement)
    return 0
