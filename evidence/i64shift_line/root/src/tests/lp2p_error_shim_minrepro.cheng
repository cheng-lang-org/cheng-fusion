import cheng/libp2p/utils/result

fn main(): int32 =
    let okErr: ErrorInfo = Lp2pErrorOk()
    if Lp2pIsError(okErr):
        return 1
    if Lp2pErrorCodeOf(okErr) != 0:
        return 2

    let newErr: ErrorInfo = Lp2pErrorNew("boom")
    if ! Lp2pIsError(newErr):
        return 3
    if Lp2pErrorMessage(newErr) != "boom":
        return 4

    let codeErr: ErrorInfo = Lp2pErrorCode(7, "coded-boom")
    if ! Lp2pIsError(codeErr):
        return 5
    if Lp2pErrorCodeOf(codeErr) != 7:
        return 6
    if Lp2pErrorMessage(codeErr) != "coded-boom":
        return 7

    echo("lp2p_error_shim_minrepro ok")
    return 0
