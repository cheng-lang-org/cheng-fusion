import std/strutils as strutil
import std/result
import std/rawbytes as rawbytes
import std/net/transports/tcp_syscall as tcp

fn serveOne(listener: var tcp.TcpListenerHandle): bool =
    var conn: tcp.TcpConnectionHandle
    if !tcp.TcpAcceptInto(listener, conn):
        puts("target accept failed")
        return false
    let recvRes: Result[rawbytes.Bytes] = tcp.TcpRecv(conn, 4096)
    if IsErr(recvRes):
        puts(strutil.Join(["target recv err=", ErrorText(recvRes)], ""))
        tcp.TcpClose(conn)
        return true
    let reqBytes: rawbytes.Bytes = Value(recvRes)
    puts(strutil.Join(["target got request bytes=", IntToStr(reqBytes.len)], ""))
    let body: str = "CHENG-VPN-EGRESS-OK"
    let response: str = strutil.Join(["HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: ", IntToStr(len(body)), "\r\nConnection: close\r\n\r\n", body], "")
    var responseView: rawbytes.Bytes = rawbytes.BytesView(StrDataPtr(response), len(response))
    let sendRes: Result[int32] = tcp.TcpSend(conn, responseView)
    if IsErr(sendRes):
        puts(strutil.Join(["target send err=", ErrorText(sendRes)], ""))
    else:
        puts(strutil.Join(["target sent bytes=", IntToStr(Value(sendRes))], ""))
    tcp.TcpClose(conn)
    return true

fn main(argc: int32, argv: str*): int32 =
    argc
    argv
    var listener: tcp.TcpListenerHandle
    let listenRes: Result[bool] = tcp.TcpListen4Fill("127.0.0.1", 18080, listener)
    if IsErr(listenRes):
        puts(strutil.Join(["target listen err=", ErrorText(listenRes)], ""))
        return 1
    puts(strutil.Join(["target listening 127.0.0.1:", IntToStr(listener.addr.port)], ""))
    while true:
        if !serveOne(listener):
            break
    tcp.TcpListenerClose(listener)
    return 0
