type
    ColdVarPlaceBoundaryInner = ref object
        value: int32

    ColdVarPlaceBoundaryOuter = ref object
        outerValue: int32
        inner: ColdVarPlaceBoundaryInner

fn ColdVarPlaceBoundaryWrite(
        outerValue: var int32,
        innerValue: var int32) =
    outerValue = 17
    innerValue = 23

fn ColdVarPlaceBoundaryMutate(
        out: var ColdVarPlaceBoundaryOuter) =
    var inner = out.inner
    ColdVarPlaceBoundaryWrite(
        out.outerValue,
        inner.value)

fn main(): int32 =
    var out = new(ColdVarPlaceBoundaryOuter)
    out.inner = new(ColdVarPlaceBoundaryInner)
    ColdVarPlaceBoundaryMutate(out)
    if out.outerValue != 17:
        return 17
    if out.inner.value != 23:
        return 23
    return 0
