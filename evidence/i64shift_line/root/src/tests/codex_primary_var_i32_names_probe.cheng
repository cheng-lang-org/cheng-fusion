import cheng/core/backend/primary_object_plan as pobj
import cheng/core/backend/lowering_plan as lower

fn main(): int32 =
    pobj.PrimaryBodyIrNodeEvalOnlyEnterFunction("source.cheng",
                                                "Probe",
                                                false)
    var function: lower.PrimaryObjectIrFunction
    add(function.paramNames, "first")
    add(function.paramTypes, "var int32")
    add(function.paramNames, "ignored")
    add(function.paramTypes, "str")
    let names =
        pobj.PrimaryBodyIrCollectVarI32ParamNamesFromIrFunction(function)
    if names.len != 1 || names[0] != "first":
        return 1
    return 0
