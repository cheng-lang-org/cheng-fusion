import std/system as system
import std/os as os
import std/strings as strings

fn fail(name: str): int32 =
    os.WriteLine(os.Get_stderr(), name)
    return 1

fn main(argc: int32, argv: str*): int32 =
    var cap: system.RuntimeAllocationLedgerSessionCapability
    if !system.RuntimeAllocationLedgerSessionOwnerBegin(
           uint64(1073741824), cap):
        return fail("begin")
    let gen = cap.generation
    let closed = system.RuntimeAllocationLedgerSessionOwnerClose(cap)
    if !closed.ok:
        os.WriteLine(os.Get_stderr(), closed.error)
        if closed.receipt.complete:
            os.WriteLine(os.Get_stderr(), "complete=1")
        else:
            os.WriteLine(os.Get_stderr(), "complete=0")
        if closed.receipt.rawManagedPointerAbaProven:
            os.WriteLine(os.Get_stderr(), "aba=1")
        else:
            os.WriteLine(os.Get_stderr(), "aba=0")
        if closed.receipt.recursiveLockProven:
            os.WriteLine(os.Get_stderr(), "lock=1")
        else:
            os.WriteLine(os.Get_stderr(), "lock=0")
        return fail("ok")
    if !closed.receipt.complete:
        return fail("complete")
    if closed.receipt.active:
        return fail("active")
    if !closed.receipt.closed:
        return fail("closed")
    if closed.receipt.capabilityGeneration != gen:
        return fail("capGen")
    if closed.receipt.ownerGeneration != gen:
        return fail("ownerGen")
    if closed.receipt.controlPlaneBackingBytes == uint64(0):
        return fail("cpZero")
    if closed.receipt.liveBackingBytes !=
           closed.receipt.controlPlaneBackingBytes:
        os.WriteLine(os.Get_stderr(),
            strings.positiveInt64ToStr(closed.receipt.liveBackingBytes))
        os.WriteLine(os.Get_stderr(),
            strings.positiveInt64ToStr(
                closed.receipt.controlPlaneBackingBytes))
        return fail("liveVsCp")
    if closed.receipt.peakBackingBytes < closed.receipt.liveBackingBytes:
        return fail("peakLtLive")
    if closed.receipt.peakBackingBytes > closed.receipt.backingLimit:
        return fail("peakGtLimit")
    if closed.receipt.liveMappedVirtualBytes != uint64(0):
        return fail("liveMapped")
    if closed.receipt.liveAllocationCount != uint64(0):
        os.WriteLine(os.Get_stderr(),
            strings.positiveInt64ToStr(closed.receipt.liveAllocationCount))
        return fail("liveAlloc")
    if closed.receipt.liveMappingCount != uint64(0):
        return fail("liveMapping")
    if closed.receipt.liveHandleCount != uint64(0):
        return fail("liveHandle")
    if !closed.receipt.rawManagedPointerAbaProven:
        return fail("aba")
    if !closed.receipt.recursiveLockProven:
        return fail("lock")
    if closed.receipt.eventIndex == uint64(0):
        return fail("eventIndex")
    if closed.receipt.backingLimit != uint64(1073741824):
        return fail("backingLimit")
    os.WriteLine(os.Get_stdout(), "retire-ok")
    return 0
