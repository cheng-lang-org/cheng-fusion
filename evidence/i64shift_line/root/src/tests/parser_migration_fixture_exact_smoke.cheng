import cheng/core/lang/parser as parser
import cheng/core/lang/typed_expr as texpr
import cheng/core/runtime/arena as arenamod

fn LegacyFixtureSource(): str =
    return "fn ExportedAdd(left: int32,\n               right: int32): int32 =\n    return left + right\n\nfn main(): int32 =\n    if false:\n        echo(\"never\")\n    else if true:\n        assert(ExportedAdd(20, 22) == 42,\n               \"compiler migration legacy plan fixture: add\")\n    return 0\n"

fn NestedIfExpressionSource(): str =
    return "fn Choose(tokenKind: int32): int32 =\n    if tokenKind == 1 || tokenKind == 2:\n        let closeKind = if tokenKind == 1: 3 else: 4\n        return closeKind\n    return 0\n\nfn InlineNested(outer: bool, inner: bool): int32 =\n    if outer: return if inner: 1 else: 2 else: return 3\n\nfn InlineNestedCase(outer: bool): int32 =\n    if outer: return case 1: 2 else: 3 else: return 4\n"

fn main(): int32 =
    var nestedTree: parser.ParserValueExprTree
    var err = ""
    assert(parser.ParserValueExprReadTreeFromText(
               NestedIfExpressionSource(), nestedTree, err),
           Fmt"parser migration fixture: nested if expression rejected {err}")
    parser.ParserValueExprTreeRelease(nestedTree)

    let source = LegacyFixtureSource()
    var tree: parser.ParserValueExprTree
    err = ""
    assert(parser.ParserValueExprReadMigrationSourceTreeFromText(
               source, tree, err),
           Fmt"parser migration fixture: parser tree rejected {err}")
    assert(tree.migrationSourceSyntax,
           "parser migration fixture: syntax authority missing")
    parser.ParserValueExprTreeRelease(tree)

    var layer: parser.NormalizedExprLayer
    err = ""
    assert(parser.ParserReadMigrationSourceNormalizedExprLayerFromText(
               "/workspace/src/tests/compiler_migration_fixture_legacy_plan.cheng",
               source,
               layer,
               err),
           Fmt"parser migration fixture: normalized layer rejected {err}")
    var assertCallNode: int32 = -1
    var assertRootNode: int32 = -1
    var nestedCallNode: int32 = -1
    var nestedRootNode: int32 = -1
    for exprIndex in 0..<layer.exprs.len:
        let expr = layer.exprs[exprIndex]
        if expr.kind != parser.NormalizedExprCall:
            continue
        if expr.callCallee == "assert" && expr.lineNumber == 9:
            assertCallNode = expr.valueExprCallNodeIndex
            assertRootNode = expr.valueExprRootNodeIndex
        elif expr.callCallee == "ExportedAdd" && expr.lineNumber == 9:
            nestedCallNode = expr.valueExprCallNodeIndex
            nestedRootNode = expr.valueExprRootNodeIndex
    assert(assertCallNode >= 0 && assertRootNode == assertCallNode &&
           nestedCallNode >= 0 && nestedCallNode != assertRootNode &&
           nestedRootNode == assertRootNode,
           "parser migration fixture: nested call statement authority drift")
    assert(parser.ParserValueExprNodeEnclosingStatementRootNodeAt(
               layer.valueExprTree, nestedCallNode) == assertRootNode &&
           parser.ParserValueExprNodeEnclosingStatementRoleAt(
               layer.valueExprTree, nestedCallNode) ==
               parser.ParserValueExprStatementExpression,
           "parser migration fixture: nested call parent chain drift")
    err = ""
    assert(parser.ParserValueExprTreeNodeOriginsStrictValidateInto(
               layer.valueExprTree, err) &&
           parser.ParserValueExprTreeStatementRootsStrictValidateInto(
               layer.valueExprTree, err),
           Fmt"parser migration fixture: exact edge authority rejected {err}")
    var parentMutation =
        parser.ParserValueExprTreeClone(layer.valueExprTree)
    arenamod.ArenaArrayInt32Set(parentMutation.arena,
                                 parentMutation.parentNodeIndexes,
                                 nestedCallNode,
                                 -1)
    err = ""
    assert(!parser.ParserValueExprTreeNodeOriginsStrictValidateInto(
               parentMutation, err) && err != "",
           "parser migration fixture: detached nested call accepted")
    parser.ParserValueExprTreeRelease(parentMutation)
    var rootMutation =
        parser.ParserValueExprTreeClone(layer.valueExprTree)
    arenamod.ArenaArrayInt32Set(
        rootMutation.arena,
        rootMutation.nodeStatementRootEventIndexes,
        assertRootNode,
        -1)
    err = ""
    assert(!parser.ParserValueExprTreeStatementRootsStrictValidateInto(
               rootMutation, err) && err != "",
           "parser migration fixture: detached statement root accepted")
    parser.ParserValueExprTreeRelease(rootMutation)
    parser.NormalizedExprLayerReset(layer)

    var typedSource: texpr.TypedExprSourceText
    typedSource.sourcePath =
        "/workspace/src/tests/compiler_migration_fixture_legacy_plan.cheng"
    typedSource.text = source
    typedSource.textLoaded = true
    typedSource.snapshotOnly = true
    typedSource.migrationSourceSyntax = true
    var context: texpr.TypedExprSourceContext
    err = ""
    assert(texpr.TypedExprBuildSourceContext(
               typedSource, context, err),
           Fmt"parser migration fixture: typed context rejected {err}")
    assert(context.scopes.len == 2 &&
           context.scopes[0].name == "ExportedAdd" &&
           context.scopes[1].name == "main",
           "parser migration fixture: function scope projection drift")
    texpr.TypedExprClearSourceContextAllFields(context)
    echo("PARSER_MIGRATION_FIXTURE_EXACT_OK")
    return 0
