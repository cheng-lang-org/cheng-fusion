# W1-ECC pure-Cheng transport campaign: SHA-256/384/512 + HMAC-SHA256 vectors.
#
# Vector sources (hex hardcoded, byte-identical):
# - FIPS 180-4 style NIST examples: "" and "abc", plus the 56-byte
#   "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq" example.
# - Boundary-length messages 64/112/128 bytes (sliding-ASCII pattern), expected
#   digests cross-generated with the local OS oracle (shasum / Digest::SHA),
#   not model-transcribed.
# - HMAC-SHA256: RFC 4231 section 4.2 (Test Case 1) and 4.3 (Test Case 2),
#   fetched verbatim from rfc-editor.org.
#
# Exit code: 0 = every vector byte-exact; 1 = any mismatch (all mismatches
# printed with want/got hex before exit).

import std/system
import std/result
import std/rawbytes
import std/strutils as strutil
import std/strings
import cheng/std/crypto/sha256
import cheng/std/crypto/sha384
import cheng/std/crypto/sha512
import cheng/std/crypto/hkdf

var w1eccFailures: int32

fn w1eccExpect(got: Bytes, wantHex: str, label: str) =
    if BytesEqual(got, BytesFromHex(wantHex)):
        echo(strutil.Join(["PASS ", label], ""))
    else:
        w1eccFailures = w1eccFailures + 1
        echo(strutil.Join(["FAIL ", label, " want=", wantHex, " got=", BytesToHex(got)], ""))

const
    w1eccMsg56 = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"
    w1eccMsg64 = "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmno"
    w1eccMsg112 = "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"
    w1eccMsg128 = "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstuijklmnopjklmnopq"

    w1eccSha256Empty = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    w1eccSha256Abc = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
    w1eccSha256M56 = "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1"
    w1eccSha256M64 = "2ff100b36c386c65a1afc462ad53e25479bec9498ed00aa5a04de584bc25301b"
    w1eccSha256M112 = "cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1"
    w1eccSha256M128 = "cf5b6f75faf3514a994cd84630c079d9e7c7a4186a82f2f76cd24c3b922f151e"

    w1eccSha384Empty = "38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b"
    w1eccSha384Abc = "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7"
    w1eccSha384M56 = "3391fdddfc8dc7393707a65b1b4709397cf8b1d162af05abfe8f450de5f36bc6b0455a8520bc4e6f5fe95b1fe3c8452b"
    w1eccSha384M64 = "bdc0f4a6e0d7de88f374e6c2562441d856aeabed3f52553103f55eca811f64b422c7cb47a8067f123e45c1a8ee303635"
    w1eccSha384M112 = "09330c33f71147e83d192fc782cd1b4753111b173b3b05d22fa08086e3b0f712fcc7c71a557e2db966c3e9fa91746039"
    w1eccSha384M128 = "f8864e88eee8f26e34e9e51654a11a83f8e9dbe631483950d5de79de89924c046811c67b58c8b971eef8d68ecd392b65"

    w1eccSha512Empty = "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e"
    w1eccSha512Abc = "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f"
    w1eccSha512M56 = "204a8fc6dda82f0a0ced7beb8e08a41657c16ef468b228a8279be331a703c33596fd15c13b1b07f9aa1d3bea57789ca031ad85c7a71dd70354ec631238ca3445"
    w1eccSha512M64 = "90d1bdb9a6cbf9cb0d4a7f185ee0870456f440b81f13f514f4561a08112763523033245875b68209bb1f5d5215bac81e0d69f77374cc44d1be30f58c8b615141"
    w1eccSha512M112 = "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909"
    w1eccSha512M128 = "6475a50058312ad958e54e11c7f96d9dc6574e26b10cb7bd00b75be1b864e8872a86aaf509185f658b57c19baf0d24f9425d28273961cacc03107d82d9a4e235"

    # RFC 4231 Test Case 1: key = 0x0b x20, data = "Hi There".
    w1eccHmacTc1Key = "0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b"
    w1eccHmacTc1Data = "4869205468657265"
    w1eccHmacTc1Want = "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7"
    # RFC 4231 Test Case 2: key = "Jefe", data = "what do ya want for nothing?".
    w1eccHmacTc2Key = "4a656665"
    w1eccHmacTc2Data = "7768617420646f2079612077616e7420666f72206e6f7468696e673f"
    w1eccHmacTc2Want = "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843"

fn main(): int32 =
    echo("purept_w1ecc_sha2: SHA-2 family + HMAC-SHA256 official vectors")

    w1eccExpect(sha256.Sha256Digest(EmptyBytes()), w1eccSha256Empty, "sha256(empty)")
    w1eccExpect(sha256.Sha256Digest(BytesFromString("abc")), w1eccSha256Abc, "sha256(abc)")
    w1eccExpect(sha256.Sha256Digest(BytesFromString(w1eccMsg56)), w1eccSha256M56, "sha256(56B)")
    w1eccExpect(sha256.Sha256Digest(BytesFromString(w1eccMsg64)), w1eccSha256M64, "sha256(64B)")
    w1eccExpect(sha256.Sha256Digest(BytesFromString(w1eccMsg112)), w1eccSha256M112, "sha256(112B)")
    w1eccExpect(sha256.Sha256Digest(BytesFromString(w1eccMsg128)), w1eccSha256M128, "sha256(128B)")

    w1eccExpect(sha384.sha384Digest(EmptyBytes()), w1eccSha384Empty, "sha384(empty)")
    w1eccExpect(sha384.sha384Digest(BytesFromString("abc")), w1eccSha384Abc, "sha384(abc)")
    w1eccExpect(sha384.sha384Digest(BytesFromString(w1eccMsg56)), w1eccSha384M56, "sha384(56B)")
    w1eccExpect(sha384.sha384Digest(BytesFromString(w1eccMsg64)), w1eccSha384M64, "sha384(64B)")
    w1eccExpect(sha384.sha384Digest(BytesFromString(w1eccMsg112)), w1eccSha384M112, "sha384(112B)")
    w1eccExpect(sha384.sha384Digest(BytesFromString(w1eccMsg128)), w1eccSha384M128, "sha384(128B)")

    w1eccExpect(sha512.Sha512Digest(EmptyBytes()), w1eccSha512Empty, "sha512(empty)")
    w1eccExpect(sha512.Sha512Digest(BytesFromString("abc")), w1eccSha512Abc, "sha512(abc)")
    w1eccExpect(sha512.Sha512Digest(BytesFromString(w1eccMsg56)), w1eccSha512M56, "sha512(56B)")
    w1eccExpect(sha512.Sha512Digest(BytesFromString(w1eccMsg64)), w1eccSha512M64, "sha512(64B)")
    w1eccExpect(sha512.Sha512Digest(BytesFromString(w1eccMsg112)), w1eccSha512M112, "sha512(112B)")
    w1eccExpect(sha512.Sha512Digest(BytesFromString(w1eccMsg128)), w1eccSha512M128, "sha512(128B)")

    w1eccExpect(hkdf.hmacDigestSha256(BytesFromHex(w1eccHmacTc1Key), BytesFromHex(w1eccHmacTc1Data)),
                w1eccHmacTc1Want, "hmac-sha256(rfc4231 tc1)")
    w1eccExpect(hkdf.hmacDigestSha256(BytesFromHex(w1eccHmacTc2Key), BytesFromHex(w1eccHmacTc2Data)),
                w1eccHmacTc2Want, "hmac-sha256(rfc4231 tc2)")

    echo(strutil.Join(["purept_w1ecc_sha2 failures=", strings.IntToStr(w1eccFailures)], ""))
    if w1eccFailures == 0:
        return 0
    return 1
