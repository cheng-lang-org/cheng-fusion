import std/system
import std/hashmaps
import cheng/core/backend/primary_object_plan as pobj
import cheng/core/backend/lowering_plan as lower
import cheng/core/ir/core_types as coreir
import cheng/core/lang/intern as langintern
import cheng/core/lang/parser as parser
import cheng/core/lang/typed_expr as texpr

@importc("pthread_attr_init")
fn atomPthreadAttrInit(attr: ptr): int32
@importc("pthread_attr_setstacksize")
fn atomPthreadAttrSetStackSize(attr: ptr, stackSize: int64): int32
@importc("pthread_attr_destroy")
fn atomPthreadAttrDestroy(attr: ptr): int32
@importc("pthread_create")
fn atomPthreadCreate(threadOut: ptr, attr: ptr, startRoutine: ptr, arg: ptr): int32
@importc("pthread_join")
fn atomPthreadJoin(thread: ptr, valuePtr: ptr): int32

const
    SourcePath = "/tmp/primary_body_ir_logical_atomicity_smoke.cheng"
    FunctionName = "Atomicity"
    CalleeName = "AtomicLeaf"
    LineNumber = 41
    AtomBigStackBytes = int64(16777216)

var g_threadPhaseResult: int32

fn addNode(ir: var texpr.TypedExprIr,
           kind: texpr.TypedExprIrOpKind,
           resultType: str,
           surfaceText: str,
           literalText: str,
           operand0: int32,
           operand1: int32): int32 =
    var node = texpr.TypedExprIrNodeNew()
    node.resultStructuralTypeId = -1
    node.callDeclarationIndex = -1
    node.originParserNodeId = -1
    node.syntheticOriginKind = texpr.TypedExprSyntheticOriginDesugared
    node.spanAuthorityKind = texpr.TypedExprSpanAuthorityNoSource
    node.sourcePath = SourcePath
    node.functionName = FunctionName
    node.lineNumber = LineNumber
    node.opKind = kind
    node.exprClass = texpr.TypedExprExprUnknown
    node.resultType = resultType
    node.resultTypeProofKind = texpr.TypedExprSnapshotTypeProofScalar
    node.resultTypeManaged = false
    node.resultTypeSend = true
    node.resultTypeSync = true
    node.surfaceText = surfaceText
    node.literalText = literalText
    node.paramSlot = -1
    node.operand0NodeIndex = operand0
    node.operand1NodeIndex = operand1
    node.operand2NodeIndex = -1
    if kind == texpr.TypedExprIrOpCallExpr:
        node.callTarget = CalleeName
        node.callTargetSourcePath = SourcePath
        node.callTargetSignatureLineNumber = LineNumber
    return texpr.TypedExprIrAddNode(ir, node)

fn registerAtomicLeafFunction(ir: var texpr.TypedExprIr) =
    texpr.TypedExprIrAppendScope(ir,
                                 0,
                                 -1,
                                 parser.NormalizedScopeRoot,
                                 -1,
                                 0,
                                 1,
                                 1,
                                 1,
                                 9)
    var calleeFn: texpr.TypedExprIrFunction
    calleeFn.sourcePath = SourcePath
    calleeFn.functionName = CalleeName
    calleeFn.signatureLineNumber = LineNumber
    calleeFn.endLineNumber = LineNumber
    calleeFn.bodyLineNumber = LineNumber + 1
    calleeFn.returnType = "bool"
    calleeFn.resultExprClass = texpr.TypedExprExprOwned
    calleeFn.returnExpr = ""
    calleeFn.statementStart = 0
    calleeFn.statementCount = 0
    calleeFn.scopeStart = 0
    calleeFn.scopeCount = 1
    calleeFn.nodeStart = 0
    calleeFn.nodeCount = 0
    calleeFn.returnNodeIndex = -1
    calleeFn.valueDefinitionStart = 0
    calleeFn.valueDefinitionCount = 0
    calleeFn.valueDefinitionGroupStart = 0
    calleeFn.valueDefinitionGroupCount = 0
    calleeFn.manualConsumePresent = false
    texpr.TypedExprIrAppendFunction(ir, calleeFn)

fn initLowering(lowering: var lower.LoweringPlanStub) =
    lowering.typedIr.internPool = langintern.InternPoolNew()
    lowering.typedIr.buildIndex = texpr.TypedExprBuildIndexNew(64)
    registerAtomicLeafFunction(lowering.typedIr)

fn buildBoolAndRoot(lowering: var lower.LoweringPlanStub,
                    rootNodeOut: var int32,
                    rhsNodeOut: var int32,
                    callNodeOut: var int32) =
    let callNode = addNode(lowering.typedIr,
                           texpr.TypedExprIrOpCallExpr,
                           "bool",
                           "AtomicLeaf()",
                           CalleeName,
                           -1,
                           -1)
    let rhsNode = addNode(lowering.typedIr,
                          texpr.TypedExprIrOpBoolLit,
                          "bool",
                          "true",
                          "true",
                          -1,
                          -1)
    let rootNode = addNode(lowering.typedIr,
                           texpr.TypedExprIrOpLogAnd,
                           "bool",
                           "AtomicLeaf() && true",
                           "",
                           callNode,
                           rhsNode)
    rootNodeOut = rootNode
    rhsNodeOut = rhsNode
    callNodeOut = callNode

fn initIrFunction(irFunction: var lower.PrimaryObjectIrFunction) =
    add(irFunction.callArgCounts, 0)
    add(irFunction.callTargets, CalleeName)
    add(irFunction.callTargetSourcePaths, SourcePath)
    add(irFunction.callTargetSignatureLineNumbers, LineNumber)
    add(irFunction.callTargetImportcFlags, false)
    add(irFunction.callImportcSymbols, "")

fn sameLocalSlot(lhs: coreir.LocalSlot,
                 rhs: coreir.LocalSlot): bool =
    return lhs.id == rhs.id &&
           lhs.name == rhs.name &&
           lhs.typeKind == rhs.typeKind &&
           lhs.placeKind == rhs.placeKind &&
           lhs.stackOffset == rhs.stackOffset &&
           lhs.sizeBytes == rhs.sizeBytes &&
           lhs.alignBytes == rhs.alignBytes &&
           lhs.auxValue == rhs.auxValue &&
           lhs.ownership == rhs.ownership &&
           lhs.aliasClass == rhs.aliasClass &&
           lhs.escapeKind == rhs.escapeKind &&
           lhs.noAlias == rhs.noAlias

fn runProbePhase(): bool =
    var lowering: lower.LoweringPlanStub
    initLowering(lowering)
    var typedFn: texpr.TypedExprIrFunction
    typedFn.sourcePath = SourcePath
    typedFn.functionName = FunctionName
    typedFn.returnType = "bool"
    typedFn.returnNodeIndex = -1
    var rootNode: int32
    var rhsNode: int32
    var callNode: int32
    buildBoolAndRoot(lowering, rootNode, rhsNode, callNode)
    var irFunction: lower.PrimaryObjectIrFunction
    initIrFunction(irFunction)
    var bodyIR = coreir.BodyIRNew()
    var slotNames: str[]
    slotNames = []
    let baselineSlot = pobj.PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                          slotNames,
                                                          "baseline",
                                                          coreir.LocalI32Tag)
    let prefixMutationSlotName = Fmt"#nev{callNode}"
    let _ = pobj.PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                               slotNames,
                                               prefixMutationSlotName,
                                               coreir.LocalAggregateTag)
    var baselineOp: coreir.BodyOp
    baselineOp.kind = coreir.BodyOpLoadConstTag
    baselineOp.target = baselineSlot
    add(baselineOp.operands, coreir.LocalI32Tag)
    add(baselineOp.operands, 1)
    add(bodyIR.ops, baselineOp)
    let baselineOps = bodyIR.ops.len
    let baselineCalls = bodyIR.callSequence.len
    let baselineSlots = bodyIR.localSlots.len
    let baselineBlocks = bodyIR.blocks.len
    let baselineTerms = bodyIR.terms.len
    let baselineCstrings = bodyIR.cstringLiterals.len
    let baselineSlotNames = slotNames.len
    let baselineIrCalls = irFunction.callTargets.len
    var callOrdinal: int32
    callOrdinal = 7
    var currentBlockStart = bodyIR.ops.len
    let baselineBlockStart = currentBlockStart
    var varI32ParamNames: str[]
    if !pobj.PrimaryBodyIrNodeBoolChainTransactionCacheEntryEmpty(bodyIR):
        return false
    if !pobj.PrimaryBodyIrNodeCondChainProbe(bodyIR,
                                             slotNames,
                                             varI32ParamNames,
                                             lowering,
                                             typedFn,
                                             irFunction,
                                             rootNode):
        return false
    return bodyIR.ops.len == baselineOps &&
           bodyIR.callSequence.len == baselineCalls &&
           bodyIR.localSlots.len == baselineSlots &&
           bodyIR.blocks.len == baselineBlocks &&
           bodyIR.terms.len == baselineTerms &&
           bodyIR.cstringLiterals.len == baselineCstrings &&
           slotNames.len == baselineSlotNames &&
           irFunction.callArgCounts.len == baselineIrCalls &&
           irFunction.callTargets.len == baselineIrCalls &&
           irFunction.callTargetSourcePaths.len == baselineIrCalls &&
           irFunction.callTargetImportcFlags.len == baselineIrCalls &&
           irFunction.callImportcSymbols.len == baselineIrCalls &&
           callOrdinal == 7 &&
           currentBlockStart == baselineBlockStart

fn runFailurePhase(): bool =
    var lowering: lower.LoweringPlanStub
    initLowering(lowering)
    var typedFn: texpr.TypedExprIrFunction
    typedFn.sourcePath = SourcePath
    typedFn.functionName = FunctionName
    typedFn.returnType = "bool"
    typedFn.returnNodeIndex = -1
    var rootNode: int32
    var rhsNode: int32
    var callNode: int32
    buildBoolAndRoot(lowering, rootNode, rhsNode, callNode)
    var irFunction: lower.PrimaryObjectIrFunction
    initIrFunction(irFunction)
    var bodyIR = coreir.BodyIRNew()
    var slotNames: str[]
    slotNames = []
    let baselineSlot = pobj.PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                          slotNames,
                                                          "baseline",
                                                          coreir.LocalI32Tag)
    let prefixMutationSlotName = Fmt"#nev{callNode}"
    let prefixMutationSlot = pobj.PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                slotNames,
                                                                prefixMutationSlotName,
                                                                coreir.LocalAggregateTag)
    let prefixMutationSlotBefore = bodyIR.localSlots[prefixMutationSlot]
    var baselineOp: coreir.BodyOp
    baselineOp.kind = coreir.BodyOpLoadConstTag
    baselineOp.target = baselineSlot
    add(baselineOp.operands, coreir.LocalI32Tag)
    add(baselineOp.operands, 1)
    add(bodyIR.ops, baselineOp)
    var baselineCall: coreir.CallOp
    baselineCall.targetSymbol = "baseline_call"
    baselineCall.resultSlot = baselineSlot
    baselineCall.resultPassKind = coreir.BodyCallPassStackValueTag
    add(bodyIR.callSequence, baselineCall)
    var baselineTerm: coreir.BodyTerm
    baselineTerm.kind = coreir.BodyTermReturnTag
    baselineTerm.conditionKind = coreir.BodyCondInvalidTag
    baselineTerm.lhsSlot = -1
    baselineTerm.rhsSlot = -1
    baselineTerm.resultSlot = baselineSlot
    baselineTerm.trueBlock = -1
    baselineTerm.falseBlock = -1
    add(baselineTerm.operands, coreir.LocalI32Tag)
    let baselineTermIndex = coreir.BodyIRAppendTerm(bodyIR, baselineTerm)
    let _ = coreir.BodyIRAppendBlock(bodyIR, 0, 1, baselineTermIndex)
    let _ = coreir.BodyIRAppendCStringLiteral(bodyIR,
                                               "baseline",
                                               "baseline_data")
    let baselineOps = bodyIR.ops.len
    let baselineCalls = bodyIR.callSequence.len
    let baselineSlots = bodyIR.localSlots.len
    let baselineBlocks = bodyIR.blocks.len
    let baselineTerms = bodyIR.terms.len
    let baselineCstrings = bodyIR.cstringLiterals.len
    let baselineSlotNames = slotNames.len
    let baselineIrCalls = irFunction.callTargets.len
    var callOrdinal: int32
    callOrdinal = 7
    var currentBlockStart = bodyIR.ops.len
    let baselineBlockStart = currentBlockStart
    var varI32ParamNames: str[]
    lowering.typedIr.nodes2_opKinds[rhsNode] = texpr.TypedExprIrOpF64Const
    lowering.typedIr.nodes2_literalTextIds[rhsNode] =
        langintern.Intern(lowering.typedIr.internPool, "not-a-float")
    lowering.typedIr.nodes2_resultTypeIds[rhsNode] =
        langintern.Intern(lowering.typedIr.internPool, "float64")
    var resultSlot: int32
    var receipt: pobj.PrimaryBodyIrNodeBoolChainTransactionReceipt
    let outcome = pobj.PrimaryBodyIrAppendNodeBoolConditionChainClaimed(
        bodyIR,
        slotNames,
        varI32ParamNames,
        lowering,
        typedFn,
        irFunction,
        rootNode,
        callOrdinal,
        currentBlockStart,
        resultSlot,
        receipt)
    if outcome != pobj.PrimaryBodyIrNodeBoolChainClaimedFailed:
        return false
    if resultSlot != -1:
        return false
    if !(receipt.cacheEntryContractProved &&
         receipt.rollbackCount == 1 &&
         receipt.commitCount == 0 &&
         receipt.poisonCount == 1):
        return false
    if !(receipt.preRollbackOpDelta > 0 &&
         receipt.preRollbackCallDelta > 0 &&
         receipt.preRollbackSlotDelta > 0 &&
         receipt.preRollbackBlockDelta > 0 &&
         receipt.preRollbackTermDelta > 0 &&
         receipt.preRollbackSlotNameDelta > 0):
        return false
    if receipt.prefixSlotMutationCount <= 0:
        return false
    if bodyIR.ops.len != baselineOps + 1:
        return false
    let poison = bodyIR.ops[bodyIR.ops.len - 1]
    if !(poison.kind == coreir.BodyOpInvalidTag &&
         poison.operands.len == 3 &&
         poison.operands[1] == 6101):
        return false
    if bodyIR.callSequence.len != baselineCalls:
        return false
    if bodyIR.localSlots.len != baselineSlots:
        return false
    if bodyIR.blocks.len != baselineBlocks:
        return false
    if bodyIR.terms.len != baselineTerms:
        return false
    if bodyIR.cstringLiterals.len != baselineCstrings:
        return false
    if !(slotNames.len == baselineSlotNames &&
         slotNames[0] == "baseline" &&
         slotNames[prefixMutationSlot] == prefixMutationSlotName):
        return false
    if !sameLocalSlot(bodyIR.localSlots[prefixMutationSlot],
                      prefixMutationSlotBefore):
        return false
    if callOrdinal != 7:
        return false
    if currentBlockStart != baselineBlockStart:
        return false
    if !(irFunction.callArgCounts.len == baselineIrCalls &&
         irFunction.callTargets.len == baselineIrCalls &&
         irFunction.callTargetSourcePaths.len == baselineIrCalls &&
         irFunction.callTargetImportcFlags.len == baselineIrCalls &&
         irFunction.callImportcSymbols.len == baselineIrCalls):
        return false
    var baselineFound: bool
    let baselineLookup = hashmaps.HashMapStrIntGetMutEx(bodyIR.slotNameIndex,
                                                        "baseline",
                                                        baselineFound)
    var transientFound: bool
    let _ = hashmaps.HashMapStrIntGetMutEx(bodyIR.slotNameIndex,
                                           Fmt"#nev_bool{rootNode}",
                                           transientFound)
    var prefixMutationFound: bool
    let prefixMutationLookup = hashmaps.HashMapStrIntGetMutEx(bodyIR.slotNameIndex,
                                                              prefixMutationSlotName,
                                                              prefixMutationFound)
    return baselineFound && baselineLookup == 0 &&
           prefixMutationFound && prefixMutationLookup == prefixMutationSlot &&
           !transientFound

fn runSuccessPhase(): bool =
    var lowering: lower.LoweringPlanStub
    initLowering(lowering)
    var typedFn: texpr.TypedExprIrFunction
    typedFn.sourcePath = SourcePath
    typedFn.functionName = FunctionName
    typedFn.returnType = "bool"
    typedFn.returnNodeIndex = -1
    var rootNode: int32
    var rhsNode: int32
    var callNode: int32
    buildBoolAndRoot(lowering, rootNode, rhsNode, callNode)
    var irFunction: lower.PrimaryObjectIrFunction
    initIrFunction(irFunction)
    var bodyIR = coreir.BodyIRNew()
    var slotNames: str[]
    slotNames = []
    var varI32ParamNames: str[]
    var callOrdinal: int32
    var currentBlockStart: int32
    var resultSlot: int32
    var receipt: pobj.PrimaryBodyIrNodeBoolChainTransactionReceipt
    let outcome = pobj.PrimaryBodyIrAppendNodeBoolConditionChainClaimed(
        bodyIR,
        slotNames,
        varI32ParamNames,
        lowering,
        typedFn,
        irFunction,
        rootNode,
        callOrdinal,
        currentBlockStart,
        resultSlot,
        receipt)
    if outcome != pobj.PrimaryBodyIrNodeBoolChainSuccess:
        return false
    if resultSlot < 0:
        return false
    if !(receipt.cacheEntryContractProved &&
         receipt.commitCount == 1 &&
         receipt.rollbackCount == 0 &&
         receipt.poisonCount == 0):
        return false
    var committedResultFound: bool
    let committedResultLookup = hashmaps.HashMapStrIntGetMutEx(
        bodyIR.slotNameIndex,
        Fmt"#nev_bool{rootNode}",
        committedResultFound)
    return committedResultFound && committedResultLookup == resultSlot

fn runOnBigStack(entry: ptr): bool =
    let attrMem = system.heapNewLegacy(256)
    if attrMem == nil:
        return false
    if atomPthreadAttrInit(attrMem) != 0:
        system.heapFreeLegacy(attrMem)
        return false
    if atomPthreadAttrSetStackSize(attrMem, AtomBigStackBytes) != 0:
        atomPthreadAttrDestroy(attrMem)
        system.heapFreeLegacy(attrMem)
        return false
    var thread: ptr
    g_threadPhaseResult = 0
    if atomPthreadCreate(ptr(&thread), attrMem, entry, nil) != 0:
        atomPthreadAttrDestroy(attrMem)
        system.heapFreeLegacy(attrMem)
        return false
    let joinStatus = atomPthreadJoin(thread, nil)
    atomPthreadAttrDestroy(attrMem)
    system.heapFreeLegacy(attrMem)
    if joinStatus != 0:
        return false
    return g_threadPhaseResult == 1

fn atomFailureThreadEntry(arg: ptr): ptr =
    if runFailurePhase():
        g_threadPhaseResult = 1
    else:
        g_threadPhaseResult = 0
    return nil

fn atomSuccessThreadEntry(arg: ptr): ptr =
    if runSuccessPhase():
        g_threadPhaseResult = 1
    else:
        g_threadPhaseResult = 0
    return nil

fn main(): int32 =
    assert(runProbePhase(), "bool-chain probe is read-only")
    assert(runOnBigStack(&atomFailureThreadEntry),
           "malformed claimed bool-chain hard fails with rollback")
    assert(runOnBigStack(&atomSuccessThreadEntry),
           "valid bool-chain commits exactly once")
    echo("primary_body_ir_logical_atomicity_smoke ok")
    return 0
