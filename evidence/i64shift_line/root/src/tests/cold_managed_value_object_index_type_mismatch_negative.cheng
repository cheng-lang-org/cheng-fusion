import std/system as system

type ColdManagedIndexSource =
    key: str

type ColdManagedIndexTarget =
    key: str

fn main(): int32 =
    var sourceValue: ColdManagedIndexSource
    sourceValue.key = system.NewStringCopy(
        system.StrDataPtr("source"), 6)
    var source: ColdManagedIndexSource[]
    add(source, sourceValue)

    var target: ColdManagedIndexTarget[]
    add(target, source[0])
    return 0
