type
    RegallocMultilineSubBox =
        values: int32[2] = [3, 10]
        starts: int32[1] = [1]
        counts: int32[1]

fn main(): int32 =
    var box: RegallocMultilineSubBox
    let valueId = 0
    let useCount = box.values[valueId + 1] -
                   box.values[valueId]
    box.counts[valueId] = box.values.len -
                          box.starts[valueId]
    return 0
