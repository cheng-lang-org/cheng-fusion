fn ColdExactDeferLateOwner(takeConditional: bool,
                           early: bool): str =
    var marker: int32
    defer:
        marker = marker + 1
    let conditional = Fmt"conditional-owner"
    if takeConditional:
        return conditional
    if early:
        return ""
    let out = Fmt"late-owner"
    return out # COLD_EXACT_LATE_OWNER_TERMINAL

fn main(): int32 =
    let conditional = ColdExactDeferLateOwner(true, false)
    let early = ColdExactDeferLateOwner(false, true)
    let late = ColdExactDeferLateOwner(false, false)
    if conditional != "conditional-owner":
        return 1
    if len(early) != 0:
        return 2
    if late != "late-owner":
        return 3
    return 0
