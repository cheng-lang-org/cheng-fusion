import std/system as system

# Case probe 3: `var` out-parameter sequences.
#
# Case probe 2 (all exit=0) covered locals that are born, grown and dropped
# inside one function.  The parser's hot path instead hands sequences across a
# call boundary: `fn F(out: var int32[])` does `out = []` and fills it, and the
# caller declares `var a: int32[]` and passes it in.  That shape is not covered
# by the local case and is the remaining way a buffer can change owner without
# anyone releasing it.
#
# Every delta is taken ACROSS the worker call in `main`, so a non-zero digit
# means the buffer outlived the function that owned it.
#   digit0  callee does `out = []` + add, caller declared `var a: int32[]`
#   digit1  callee assigns a fresh literal into `out`
#   digit2  caller grows its own seq, callee appends one more element
#   digit3  callee returns a seq literal through `out` and caller replaces it

var probeSink: int32

fn FillFresh(out: var int32[]) =
    out = []
    add(out, 1)
    add(out, 2)

fn WorkerOutFresh(): int32 =
    var a: int32[]
    FillFresh(a)
    return a.len + a[0]

fn FillLiteral(out: var int32[]) =
    out = [4, 5, 6]

fn WorkerOutLiteral(): int32 =
    var b: int32[]
    FillLiteral(b)
    return b.len + b[1]

fn AppendOne(out: var int32[], extra: int32) =
    add(out, extra)

fn WorkerCallerGrew(): int32 =
    var c: int32[]
    add(c, 7)
    AppendOne(c, 9)
    return c.len + c[1]

fn ReplaceTwice(out: var int32[]) =
    out = [1, 2]
    out = [3, 4, 5, 6]

fn WorkerReplace(): int32 =
    var d: int32[]
    ReplaceTwice(d)
    return d.len + d[3]

fn Digit(value: int64, weight: int64): int64 =
    if value < 0:
        return 7 * weight
    if value > 6:
        return 6 * weight
    return value * weight

fn main(): int32 =
    var acc: int32
    let before0 = system.MemLiveAllocations()
    acc = acc + WorkerOutFresh()
    let delta0 = system.MemLiveAllocations() - before0
    let before1 = system.MemLiveAllocations()
    acc = acc + WorkerOutLiteral()
    let delta1 = system.MemLiveAllocations() - before1
    let before2 = system.MemLiveAllocations()
    acc = acc + WorkerCallerGrew()
    let delta2 = system.MemLiveAllocations() - before2
    let before3 = system.MemLiveAllocations()
    acc = acc + WorkerReplace()
    let delta3 = system.MemLiveAllocations() - before3
    probeSink = acc
    if acc <= 0:
        return 99
    let packed = Digit(delta0, 1) +
                 Digit(delta1, 8) +
                 Digit(delta2, 64) +
                 Digit(delta3, 512)
    return int32(packed)
