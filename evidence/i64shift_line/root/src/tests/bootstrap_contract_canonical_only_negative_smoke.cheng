import std/os
import std/strings
import cheng/core/tooling/host_ops as hostops
import cheng/core/tooling/path as chengpath
import std/strutils as strutil

fn containsText(text: str, needle: str): bool =
    return strings.StrContains(text, needle)

fn main(): int32 =
    let root = os.GetCurrentDir()
    let outDir = chengpath.PathAbsolute(root, "artifacts/bootstrap_contract_canonical_only_negative")
    assert(chengpath.MkdirP(root, outDir), " bootstrap canonical only: mkdir")
    let stage0 = chengpath.PathAbsolute(root, "artifacts/bootstrap/cheng.stage0")
    let obsoleteContract = chengpath.PathAbsolute(root, "src/tests/bootstrap_contract_obsolete_negative.cheng")
    assert(chengpath.FileExistsNonEmpty(root, stage0), " bootstrap canonical only: stage0 exists")
    assert(chengpath.FileExistsNonEmpty(root, obsoleteContract), " bootstrap canonical only: obsolete fixture exists")

    let selfCheckLog = chengpath.PathJoin(outDir, "self-check.log")
    if chengpath.PathFileExists(selfCheckLog):
        os.RemoveFile(selfCheckLog)
    let selfCheckRun = hostops.RunFileLogged(root,
                                               "bootstrap_obsolete_self_check_negative",
                                               stage0,
                                               ["self-check", strutil.Join(["--in:", obsoleteContract], "")],
                                               [],
                                               root,
                                               20,
                                               selfCheckLog)
    assert(selfCheckRun.exitCode != 0, " bootstrap canonical only: self-check must fail")
    assert(containsText(selfCheckRun.output, "unsupported bootstrap syntax"),
           " bootstrap canonical only: self-check rejects obsolete schema")

    let printLog = chengpath.PathJoin(outDir, "print-contract.log")
    if chengpath.PathFileExists(printLog):
        os.RemoveFile(printLog)
    let printRun = hostops.RunFileLogged(root,
                                           "bootstrap_obsolete_print_contract_negative",
                                           stage0,
                                           ["print-contract", strutil.Join(["--in:", obsoleteContract], "")],
                                           [],
                                           root,
                                           20,
                                           printLog)
    assert(printRun.exitCode != 0, " bootstrap canonical only: print-contract must fail")
    assert(containsText(printRun.output, "unsupported bootstrap syntax"),
           " bootstrap canonical only: print-contract rejects obsolete schema")
    echo(" bootstrap_contract_canonical_only_negative_smoke ok")
    return 0
