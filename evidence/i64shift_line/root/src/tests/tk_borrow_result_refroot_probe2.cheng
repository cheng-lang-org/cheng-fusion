module tk_borrow_result_refroot_probe2

import std/system

type Session = ref object
    count: int32

type Ir =
    session: Session

@borrows
@borrow_result
fn GetSession(ir: Ir): Session =
    if ir.session != nil && system.memRefCount(ir.session) != 1:
        panic("shared")
    return ir.session

fn main(): int32 =
    var x: Ir
    x.session = new(Session)
    x.session.count = 3
    let s = GetSession(x)
    return s.count

main()
