import std/os as os
import std/system

type
    ProbeSlot =
        active: int32
        closed: int32
        slotIndex: int32
        filler: int32
        heads: int32[9]
        tail: uint64
    ProbeSlotPtr = ProbeSlot *

var
    gSlot: ProbeSlotPtr

fn writeHeadFormal(slot: ProbeSlotPtr, i: int32, v: int32) =
    slot->heads[i] = v

fn readHeadFormal(slot: ProbeSlotPtr, i: int32): int32 =
    return slot->heads[i]

fn main(): int32 =
    let raw = system.heapNewLegacy(128)
    if raw == nil:
        return 9
    # formal-param write + formal-param read
    let slot = ProbeSlotPtr(raw)
    for i in 0..<9:
        writeHeadFormal(slot, i, -1)
    writeHeadFormal(slot, 5, 777)
    if readHeadFormal(slot, 5) != 777:
        os.WriteLine(os.Get_stdout(), "formal-rw-broken")
        return 3
    # global raw T* shadow receiver (OPAQUE_REF global-addr path)
    gSlot = ProbeSlotPtr(raw)
    writeHeadFormal(gSlot, 7, 888)
    if gSlot->heads[7] != 888:
        os.WriteLine(os.Get_stdout(), "global-shadow-broken")
        return 4
    # local by-value var T* receiver (OPAQUE local path)
    var lp: ProbeSlotPtr = ProbeSlotPtr(raw)
    writeHeadFormal(lp, 2, 999)
    if lp->heads[2] != 999:
        os.WriteLine(os.Get_stdout(), "local-var-broken")
        return 5
    os.WriteLine(os.Get_stdout(), "probe-ok")
    return 0
