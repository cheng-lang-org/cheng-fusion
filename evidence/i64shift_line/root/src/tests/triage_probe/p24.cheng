import std/os as os
import std/system

var
    probeWord: uint64

fn takeAddr(): ptr =
    return ptr(&probeWord)

fn takeValue(): uint64 =
    return uint64(ptr(probeWord))

fn main(): int32 =
    let cell = system.heapNewLegacy(8)
    if cell == nil:
        return 9
    probeWord = uint64(cell)
    let a = takeAddr()
    let v = takeValue()
    if uint64(a) != uint64(ptr(&probeWord)):
        return 5
    if v != probeWord:
        return 3
    os.WriteLine(os.Get_stdout(), "probe-ok")
    return 0
