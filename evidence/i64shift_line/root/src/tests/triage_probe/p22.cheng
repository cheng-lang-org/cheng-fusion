import std/os as os
import std/system

var
    probeRaw: uint64

fn checkPtrCast(): int32 =
    if probeRaw == uint64(0):
        return 0
    let viaCast = uint64(ptr(probeRaw))
    if viaCast != probeRaw:
        return 1
    return 2

fn main(): int32 =
    let cell = system.heapNewLegacy(8)
    if cell == nil:
        return 9
    probeRaw = uint64(cell)
    let rc = checkPtrCast()
    if rc == 1:
        os.WriteLine(os.Get_stdout(), "ptr-cast-lost-deref")
        return 3
    if rc == 2:
        os.WriteLine(os.Get_stdout(), "probe-ok")
        return 0
    return 4
