import std/os as os
import std/system

var
    probeRaw: uint64

fn main(): int32 =
    let cell = system.heapNewLegacy(8)
    if cell == nil:
        return 9
    probeRaw = uint64(cell)
    # local variant: same casts on a local let
    let localRaw: uint64 = probeRaw
    let viaCastLocal = uint64(ptr(localRaw))
    if viaCastLocal != localRaw:
        os.WriteLine(os.Get_stdout(), "local-also-broken")
        return 5
    # global variant
    let viaCastGlobal = uint64(ptr(probeRaw))
    if viaCastGlobal != probeRaw:
        os.WriteLine(os.Get_stdout(), "global-broken")
        return 3
    os.WriteLine(os.Get_stdout(), "probe-ok")
    return 0
