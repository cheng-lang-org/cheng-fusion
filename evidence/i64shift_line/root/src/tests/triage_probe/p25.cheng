import std/os as os
import std/system

type
    ProbeSlot =
        active: int32
        closed: int32
        slotIndex: int32
        filler: int32
        heads: int32[9]
        tail: uint64
    ProbeSlotPtr = ProbeSlot *

fn probeHeadRead(slot: ProbeSlotPtr, classIndex: int32): int32 =
    return slot->heads[classIndex]

fn main(): int32 =
    let raw = system.heapNewLegacy(128)
    if raw == nil:
        return 9
    let slot = ProbeSlotPtr(raw)
    slot->active = 1
    slot->slotIndex = 0
    for i in 0..<9:
        slot->heads[i] = -1
    slot->heads[3] = 4242
    let got = probeHeadRead(slot, 3)
    if got != 4242:
        os.WriteLine(os.Get_stdout(), "inline-array-read-broken")
        return 3
    os.WriteLine(os.Get_stdout(), "probe-ok")
    return 0
