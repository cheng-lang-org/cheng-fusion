import std/os as os
import std/system

record ProbePlane:
    magic: int32
    count: int32
    total: int64

type
    ProbePlanePtr = ProbePlane *

var
    probePlaneRaw: uint64

fn probeIdentityValid(): bool =
    if probePlaneRaw == uint64(0):
        return false
    let control = ProbePlanePtr(
        ptr(probePlaneRaw))
    return control->magic == 1129071952 &&
           control->count >= 0 &&
           control->total == uint64(7)

fn main(): int32 =
    let raw = system.heapNewLegacy(24)
    if raw == nil:
        return 2
    let cell = ProbePlanePtr(raw)
    cell->magic = 1129071952
    cell->count = 0
    cell->total = uint64(7)
    probePlaneRaw = uint64(raw)
    if !probeIdentityValid():
        return 3
    os.WriteLine(os.Get_stdout(), "probe-ok")
    return 0
