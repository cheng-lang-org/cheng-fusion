import std/cmdline as cmdline
import std/os as os
import std/strings
fn main(): int32 =
    if cmdline.ParamCount() != 3:
        return 1
    let caseName = cmdline.ParamStr(1)
    let outputPath = cmdline.ParamStr(2)
    if outputPath.len == 0:
        return 2
    if caseName == "header-size":
        os.WriteLine(os.Get_stdout(), strings.ConcatStr("case=", caseName))
    return 0
