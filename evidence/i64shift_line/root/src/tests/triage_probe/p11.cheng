import std/cmdline as cmdline
import std/os as os
import std/rawbytes
import std/result
fn main(): int32 =
    if cmdline.ParamCount() != 2:
        return 1
    let outputPath = cmdline.ParamStr(1)
    var b = rawbytes.BytesAlloc(4)
    rawbytes.BytesSet(b, 0, 65)
    var wr = os.WriteFileBytesResult(outputPath, b)
    if result.IsErr(wr):
        return 2
    os.WriteLine(os.Get_stdout(), "written")
    return 0
