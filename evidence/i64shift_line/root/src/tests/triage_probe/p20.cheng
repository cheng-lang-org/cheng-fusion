import std/os as os
import std/rawbytes
import std/result
fn main(): int32 =
    let parent = "/private/tmp/orcfix/at_probe"
    let begun = os.AtomicTreeBegin(parent, "stage", "final")
    if result.IsErr(begun):
        os.WriteLine(os.Get_stdout(), result.Error(begun))
        return 2
    let handle = result.Value(begun)
    let mk = os.AtomicTreeMkdir(handle, "sub")
    if result.IsErr(mk):
        return 3
    var writeBytes = rawbytes.BytesAlloc(5)
    rawbytes.BytesSet(writeBytes, 0, 104)
    rawbytes.BytesSet(writeBytes, 1, 101)
    rawbytes.BytesSet(writeBytes, 2, 108)
    rawbytes.BytesSet(writeBytes, 3, 108)
    rawbytes.BytesSet(writeBytes, 4, 111)
    let wr = os.AtomicTreeWriteExclusiveSync(handle, "sub/a.txt", writeBytes)
    rawbytes.BytesFree(writeBytes)
    if result.IsErr(wr):
        return 4
    let exact = os.AtomicTreeVerifyExact(handle, ["sub"], ["sub/a.txt"])
    if result.IsErr(exact):
        return 5
    if !result.Value(exact):
        return 6
    let rd = os.AtomicTreeReadStable(handle, "sub/a.txt")
    if result.IsErr(rd):
        return 7
    let committed = os.AtomicTreeCommitNoReplace(handle)
    if result.IsErr(committed):
        return 9
    let opened = os.AtomicTreeOpenVerified(parent, "final")
    if result.IsErr(opened):
        os.WriteLine(os.Get_stdout(), result.Error(opened))
        return 10
    let h2 = result.Value(opened)
    let exact2 = os.AtomicTreeVerifyExact(h2, ["sub"], ["sub/a.txt"])
    if result.IsErr(exact2):
        return 11
    let mapped = os.AtomicTreeMapReadOnly(h2, "sub/a.txt")
    if result.IsErr(mapped):
        os.WriteLine(os.Get_stdout(), result.Error(mapped))
        return 12
    let region = result.Value(mapped)
    let bl = os.ReadOnlyMappedRegionByteLength(region)
    if result.IsErr(bl):
        return 13
    if result.Value(bl) != 5:
        return 14
    os.WriteLine(os.Get_stdout(), "atprobe-ok")
    return 0
