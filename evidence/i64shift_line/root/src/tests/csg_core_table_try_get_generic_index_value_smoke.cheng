import std/os as os

type
    GenericValues[V] =
        values: V[]

fn AssignGenericIndexedValue[V](
    values: GenericValues[V],
    out: var V
) =
    out = values.values[0]

fn main(): int32 =
    var values: GenericValues[int32]
    values.values = [7]
    var out: int32
    AssignGenericIndexedValue[int32](values, out)
    if out != 7:
        return 1
    os.WriteLine(
        os.Get_stdout(),
        "csg_core_table_try_get_generic_index_value_smoke ok")
    return 0
