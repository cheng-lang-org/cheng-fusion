# D-v2 验收夹具 repro2: 复核员抓到的 crypto_stream.cheng 旁路缺陷之二
# ——drain 到空后再次 Add 触发 SIGSEGV(旧旁路: Consume 直写 .data=emptyBytes()
# 不同步 .len, 下次 Append 用旧 len 去 memcpy 一个已经是 nil 的 .data.data)。
#
# 与 repro(dbuf_bypass_repro_crypto_stream.cheng) 的区别: 那个夹具在第一步就
# 用严格 assert 抓污染值提前退出；这个夹具刻意不做严格比对，一路推进到
# "排空后再 Add" 这个真正的崩溃点，专门验证崩溃(而非污染)这个失效模式。

import std/result
import std/rawbytes
import std/strutils as strutil
import cheng/quic/core/crypto_stream as cstream

fn main(): int32 =
    var stream: cstream.MsQuicCryptoStream = cstream.initMsQuicCryptoStream()

    let addRes1 = cstream.msquicCryptoStreamAdd(stream, 0, BytesFromString("abc"))
    assert(IsOk(addRes1), " dbuf_bypass_repro2: add1")

    let avail1: int32 = cstream.msquicCryptoStreamAvailable(stream)
    let drained: Bytes = cstream.msquicCryptoStreamConsume(stream, avail1)
    echo(strutil.Join([" dbuf_bypass_repro2: drained_len=", IntToStr(BytesLen(drained))], ""))

    # 崩溃点: 排空后再次 Add。旧旁路代码在这里 SIGSEGV；修复后必须正常返回。
    let addRes2 = cstream.msquicCryptoStreamAdd(stream, 3, BytesFromString("defgh"))
    assert(IsOk(addRes2), " dbuf_bypass_repro2: add2 post-drain (this line must survive without crashing)")

    let avail2: int32 = cstream.msquicCryptoStreamAvailable(stream)
    assert(avail2 == 5, " dbuf_bypass_repro2: avail2 must equal 5")
    let got2: Bytes = cstream.msquicCryptoStreamConsume(stream, avail2)
    assert(BytesToString(got2) == "defgh", " dbuf_bypass_repro2: consume2 content exact")

    echo(" dbuf_bypass_repro2_crypto_stream_sigsegv ok")
    return 0
