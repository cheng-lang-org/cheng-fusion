import std/cmdline as cmdline
import std/strutils as strutil
import cheng/core/backend/metadata_text_authority as metadataauthority
import cheng/core/backend/primary_object_plan as primary
import cheng/core/backend2/backend2_lower_util as backend2

fn AsciiText(byteCount: int32): str =
    var bytes: str[]
    reserve(bytes, byteCount)
    for _ in 0..<byteCount:
        add(bytes, "A")
    return strutil.Join(bytes, "")

fn AssertBoth(text: str, expected: bool, label: str) =
    let primaryStable = primary.PrimaryObjectMetadataTextStable(text)
    let backend2Stable = backend2.B2PrimaryObjectMetadataTextStable(text)
    assert(primaryStable == expected,
           Fmt"regalloc metadata text: primary mismatch label={label}")
    assert(backend2Stable == expected,
           Fmt"regalloc metadata text: backend2 mismatch label={label}")
    assert(primaryStable == backend2Stable,
           Fmt"regalloc metadata text: backend mismatch label={label}")

fn main(): int32 =
    let mode = cmdline.ParamStr(1)
    if mode == "overflow":
        let _ = metadataauthority.MetadataTextCheckedAdvance(2147483647)
        return 91

    AssertBoth("", true, "empty")
    AssertBoth(AsciiText(1024), true, "1024")
    AssertBoth(AsciiText(1025), true, "1025")
    AssertBoth(AsciiText(131072), true, "large")
    AssertBoth("A\x00B", false, "embedded_nul")
    AssertBoth("A\nB", false, "control")
    AssertBoth("\x7f", false, "delete")
    AssertBoth("\x80", false, "non_ascii")
    echo("regalloc_metadata_text_authority_smoke ok")
    return 0
