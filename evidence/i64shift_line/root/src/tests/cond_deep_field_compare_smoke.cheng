# Regression: deep field paths in if/while conditions must compare the field
# VALUE, not the field ADDRESS. The text condition path lowered
# `if o.inner.a != 5:` as `add x9,sp,#off; cmp x9,w10` (address vs value);
# node-evaluated conditions load through FieldGet meta (findings.md 2026-06-12).

type
    Inner =
        a: int32
        b: int32

    Mid =
        pad: int32
        inner: Inner

    Outer =
        tag: int32
        mid: Mid

fn main(): int32 =
    var m: Mid
    m.pad = 2
    m.inner.a = 5
    m.inner.b = 7
    if m.inner.a != 5:
        return 1
    if m.inner.b == 5:
        return 2
    if m.inner.b != 7:
        return 3
    var o: Outer
    o.tag = 1
    o.mid.pad = 4
    o.mid.inner.a = 5
    o.mid.inner.b = 9
    if o.mid.inner.a != 5:
        return 4
    if o.mid.inner.b == 5:
        return 5
    var count: int32
    while count < 3:
        count = count + 1
    if count != 3:
        return 6
    while m.inner.a == 5:
        m.inner.a = m.inner.a + 1
    if m.inner.a != 6:
        return 7
    return 0
