// Ownership proof 10: composite ownership test
// Tests ownership tracking for composite types:
// - Struct field single-writer tracking
// - Array element write tracking via index assignment
// - Multiple struct objects with independent ownership chains
// - Mixed scalar and composite variable no-alias patterns

type
    Point =
        x: int32
        y: int32

fn make_point(xv: int32, yv: int32): Point =
    var p: Point
    p.x = xv
    p.y = yv
    return p

fn add_points(a: Point, b: Point): Point =
    var r: Point
    r.x = a.x + b.x
    r.y = a.y + b.y
    return r

fn main(): int32 =
    // Struct field access: each field has its own ownership chain
    let p1 = make_point(3, 7)
    if p1.x != 3: return 1
    if p1.y != 7: return 2

    // Multiple struct objects: independent no-alias ownership
    let p2 = make_point(10, 20)
    let p3 = make_point(5, 5)
    if p2.x != 10: return 3
    if p3.y != 5: return 4

    // Cross-object field arithmetic (ownership chains remain independent)
    let sum_x = p1.x + p2.x
    if sum_x != 13: return 5
    let sum_y = p1.y + p3.y
    if sum_y != 12: return 6

    // Struct returned from function: ownership tracked through return value
    let p4 = add_points(p1, p2)
    if p4.x != 13: return 7
    if p4.y != 27: return 8

    // Array literal: each element has single-writer ownership
    var fixed: int32[3] = [1, 2, 3]
    if fixed[0] != 1: return 9
    if fixed[1] != 2: return 10
    if fixed[2] != 3: return 11

    // Array index assignment: element write tracking
    fixed[1] = 99
    if fixed[1] != 99: return 12

    // Dynamic array: seq operations with ownership
    var xs: int32[] = [7, 8, 9]
    if xs[0] != 7: return 13
    if xs[2] != 9: return 14

    // Array element reassignment
    xs[2] = 42
    if xs[2] != 42: return 15

    // Struct field used in identity rewrites
    let px = p1.x
    let r_ident = px + 0
    if r_ident != 3: return 16

    let r_mul = px * 1
    if r_mul != 3: return 17

    // Array element used in identity rewrites
    let arr_val = fixed[0]
    let r_arr_id = arr_val + 0
    if r_arr_id != 1: return 18

    echo(" ownership_proof_10 ok")
    return 0
