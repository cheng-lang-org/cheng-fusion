# LSP signatureHelp and typeDefinition smoke test.
# Verifies that the protocol types and handlers compile correctly.
# Standalone test (no import of lsp_protocol needed).

import std/strings
import std/strutils as strutil

# --- Mirror of ParameterInformation type ---

type
    TestParameterInformation =
        label: str
        documentation: str

    TestSignatureInformation =
        label: str
        documentation: str
        parameters: TestParameterInformation[]

    TestSignatureHelp =
        signatures: TestSignatureInformation[]
        activeSignature: int32
        activeParameter: int32

    TestLocation =
        uri: str
        startLine: int32
        startCol: int32
        endLine: int32
        endCol: int32

    TestTypeSymbol =
        name: str
        typeText: str
        loc: TestLocation

# --- Factory functions ---

fn TestMakeParameterInformation(label: str, documentation: str): TestParameterInformation =
    var out: TestParameterInformation
    out.label = label
    out.documentation = documentation
    return out

fn TestMakeSignatureInformation(label: str, documentation: str,
                                 parameters: TestParameterInformation[]): TestSignatureInformation =
    var out: TestSignatureInformation
    out.label = label
    out.documentation = documentation
    out.parameters = parameters
    return out

fn TestMakeSignatureHelp(signatures: TestSignatureInformation[],
                          activeSignature: int32,
                          activeParameter: int32): TestSignatureHelp =
    var out: TestSignatureHelp
    out.signatures = signatures
    out.activeSignature = activeSignature
    out.activeParameter = activeParameter
    return out

fn TestMakeLocation(uri: str, sl: int32, sc: int32, el: int32, ec: int32): TestLocation =
    var out: TestLocation
    out.uri = uri
    out.startLine = sl
    out.startCol = sc
    out.endLine = el
    out.endCol = ec
    return out

fn TestMakeTypeSymbol(name: str, typeText: str, loc: TestLocation): TestTypeSymbol =
    var out: TestTypeSymbol
    out.name = name
    out.typeText = typeText
    out.loc = loc
    return out

# --- Helper: parse function params from type text (mirrors LspParseFunctionParams) ---

fn TestParseFunctionParams(typeText: str): str[] =
    var params: str[]
    let n: int32 = strings.Len(typeText)
    var parenStart: int32 = -1
    for i in 0..<n:
        if typeText[i] == '(':
            parenStart = i
            break
    if parenStart < 0:
        return params
    var parenEnd: int32 = -1
    for i in parenStart + 1..<n:
        if typeText[i] == ')':
            parenEnd = i
            break
    if parenEnd < 0 || parenEnd <= parenStart + 1:
        return params
    let inner: str = strings.SliceBytes(typeText, parenStart + 1, parenEnd - parenStart - 1)
    var start: int32
    for i in 0..<strings.Len(inner):
        if inner[i] == ',':
            let paramText: str = strings.SliceBytes(inner, start, i - start)
            let trimmed: str = strutil.Strip(paramText)
            if strings.Len(trimmed) > 0:
                add(params, trimmed)
            start = i + 1
    let last: str = strings.SliceBytes(inner, start, strings.Len(inner) - start)
    let trimmedLast: str = strutil.Strip(last)
    if strings.Len(trimmedLast) > 0:
        add(params, trimmedLast)
    return params

# --- Type definition lookup simulation ---

fn TestFindTypeDefinition(varName: str, typeText: str,
                           symbols: TestTypeSymbol[]): TestLocation =
    var emptyLoc: TestLocation
    for i in 0..<symbols.len:
        let s: TestTypeSymbol = symbols[i]
        if s.name == typeText:
            return s.loc
    return emptyLoc

fn main() =
    # 1. ParameterInformation construction
    let p1: TestParameterInformation = TestMakeParameterInformation("a: int32", "first param")
    assert(p1.label == "a: int32", "sighelp: param label")
    assert(p1.documentation == "first param", "sighelp: param doc")
    let p2: TestParameterInformation = TestMakeParameterInformation("b: str", "second param")
    assert(p2.label == "b: str", "sighelp: param2 label")

    # 2. ParameterInformation with labels array
    var params: TestParameterInformation[]
    add(params, p1)
    add(params, p2)
    assert(params.len == 2, "sighelp: param count")

    # 3. SignatureInformation construction
    let sig: TestSignatureInformation = TestMakeSignatureInformation(
        "myFunc(a: int32, b: str)", "does something", params)
    assert(sig.label == "myFunc(a: int32, b: str)", "sighelp: sig label")
    assert(sig.documentation == "does something", "sighelp: sig doc")
    assert(sig.parameters.len == 2, "sighelp: sig param count")
    assert(sig.parameters[0].label == "a: int32", "sighelp: sig param0 label")

    # 4. SignatureHelp with active parameter
    var sigs: TestSignatureInformation[]
    add(sigs, sig)
    let help: TestSignatureHelp = TestMakeSignatureHelp(sigs, 0, 1)
    assert(help.activeSignature == 0, "sighelp: active sig")
    assert(help.activeParameter == 1, "sighelp: active param")
    assert(help.signatures.len == 1, "sighelp: sig count")
    assert(help.signatures[0].parameters[1].label == "b: str", "sighelp: active param label")

    # 5. Parse function params from type text
    let parsed: str[] = TestParseFunctionParams("fn (x: int32, y: str, z: bool): int32")
    assert(parsed.len == 3, "sighelp: parsed param count")
    assert(parsed[0] == "x: int32", "sighelp: parsed param0")
    assert(parsed[1] == "y: str", "sighelp: parsed param1")
    assert(parsed[2] == "z: bool", "sighelp: parsed param2")

    # 6. Empty param list
    let empty: str[] = TestParseFunctionParams("fn (): int32")
    assert(empty.len == 0, "sighelp: empty params")

    # 7. Single param
    let single: str[] = TestParseFunctionParams("fn (value: float64): float64")
    assert(single.len == 1, "sighelp: single param")
    assert(single[0] == "value: float64", "sighelp: single param label")

    # 8. Type definition lookup simulation
    var typeSymbols: TestTypeSymbol[]
    let loc1: TestLocation = TestMakeLocation("file:///test.cheng", 5, 4, 5, 16)
    let loc2: TestLocation = TestMakeLocation("file:///test.cheng", 10, 4, 10, 18)
    add(typeSymbols, TestMakeTypeSymbol("MyStruct", "struct", loc1))
    add(typeSymbols, TestMakeTypeSymbol("MyEnum", "enum", loc2))

    let td1: TestLocation = TestFindTypeDefinition("x", "MyStruct", typeSymbols)
    assert(td1.startLine == 5, "sighelp: typedef line")
    assert(td1.startCol == 4, "sighelp: typedef col")

    let td2: TestLocation = TestFindTypeDefinition("y", "MyEnum", typeSymbols)
    assert(td2.startLine == 10, "sighelp: typedef enum line")

    # 9. Type definition not found returns empty location
    let td3: TestLocation = TestFindTypeDefinition("z", "NonExistent", typeSymbols)
    assert(td3.startLine == 0, "sighelp: not found")
    assert(td3.startCol == 0, "sighelp: not found col")

    # 10. Verify string building for signature label
    var labelText: str = "myFunc("
    var first: bool = true
    for i in 0..<params.len:
        if !first:
            labelText = strutil.Join([labelText, ", "], "")
        first = false
        labelText = strutil.Join([labelText, params[i].label], "")
    labelText = strutil.Join([labelText, ")"], "")
    assert(labelText == "myFunc(a: int32, b: str)", "sighelp: label building")
