import std/os
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/tooling/compiler_csg as ccsg

fn ColdCompilerCsgNestedReceiptTestCid(label: str): layout.FixedBytes32 =
    var bytes = layout.ByteBufInit(label.len)
    for index in 0..<label.len:
        layout.ByteBufAppendByte(bytes, Int32(label[index]) & 255)
    let out = hash256.Sha256Fixed(layout.ByteBufView(bytes))
    layout.ByteBufFree(bytes)
    return out

fn main() =
    var csg: ccsg.CompilerCsg
    csg.sourceIdentityReceipt.receiptCid =
        ColdCompilerCsgNestedReceiptTestCid("nested-receipt")
    assert(layout.FixedBytes32Equal(
               csg.sourceIdentityReceipt.receiptCid,
               csg.sourceIdentityReceipt.receiptCid),
           "CompilerCsg nested receipt read changed type")
    os.WriteLine(os.Get_stdout(),
                 "cold_compiler_csg_nested_receipt_read_smoke: ok")
