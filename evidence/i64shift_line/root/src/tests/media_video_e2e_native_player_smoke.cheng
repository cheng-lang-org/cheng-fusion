import std/os as os
import std/rawbytes
import std/result
import std/strutils as strutil
import std/gui as gui
import std/media_platform as platform
import cheng/core/ir/csg_web_facts as facts
import cheng/quic/connection as qconn
import cheng/quic/msquicruntime as qruntime
import cheng/quic/msquictransport_native as qtransport
import cheng/libp2p/transports/quic_transport
import cheng/libp2p/protocols/media/moq_segment_stream as moqstream
import cheng/moq/media_csg_web_projection as media_csg
import cheng/moq/media_asset_manifest as media
import cheng/core/runtime/web_scene_runtime as scene
import cheng/core/runtime/web_scene_gui_bridge as scene_gui

@importc("cheng_monotime_ns")
fn mediaVideoE2eMonoTimeNs(): int64

const
    mediaVideoE2eMaxRemoteFetchMs: int64 = 1000
    mediaVideoE2eMaxOpenToFirstFrameMs: int64 = 1000

fn mediaVideoE2eSetU32BE(buf: var rawbytes.Bytes, offset: int32, value: int32) =
    rawbytes.BytesSet(buf, offset, (value >> 24) & 255)
    rawbytes.BytesSet(buf, offset + 1, (value >> 16) & 255)
    rawbytes.BytesSet(buf, offset + 2, (value >> 8) & 255)
    rawbytes.BytesSet(buf, offset + 3, value & 255)

fn mediaVideoE2eSetFour(buf: var rawbytes.Bytes,
                        offset: int32,
                        a: int32,
                        b: int32,
                        c: int32,
                        d: int32) =
    rawbytes.BytesSet(buf, offset, a)
    rawbytes.BytesSet(buf, offset + 1, b)
    rawbytes.BytesSet(buf, offset + 2, c)
    rawbytes.BytesSet(buf, offset + 3, d)

fn mediaVideoE2eFixturePath(): str =
    return os.JoinPath(os.GetCurrentDir(), "ts-csg/fixtures/media/unimaker-default-video-2frame.mp4")

fn mediaVideoE2eMakeMp4(): rawbytes.Bytes =
    let readRes = os.ReadFileBytesResult(mediaVideoE2eFixturePath())
    assert(IsOk(readRes), Error(readRes))
    return Value(readRes)

fn mediaVideoE2eBytesEq(left: rawbytes.Bytes, right: rawbytes.Bytes): bool =
    if rawbytes.BytesLen(left) != rawbytes.BytesLen(right):
        return false
    for i in 0..<rawbytes.BytesLen(left):
        if rawbytes.BytesGet(left, i) != rawbytes.BytesGet(right, i):
            return false
    return true

fn mediaVideoE2eAssertElapsed(label: str,
                              startedAtMs: int64,
                              completedAtMs: int64,
                              elapsedMs: int64) =
    assert(startedAtMs > int64(0), Fmt" media video e2e: {label} start ms")
    assert(completedAtMs >= startedAtMs, Fmt" media video e2e: {label} complete ms")
    assert(elapsedMs == completedAtMs - startedAtMs,
        Fmt" media video e2e: {label} elapsed ms")

fn mediaVideoE2eNowMs(): int64 =
    return mediaVideoE2eMonoTimeNs() / 1000000

fn mediaVideoE2eReadRemoteAll(reader: var moqstream.Libp2pMoqSegmentStreamReader,
                              maxChunkBytes: int32): rawbytes.Bytes =
    var out: rawbytes.Bytes
    while !reader.closed:
        let readRes = moqstream.Libp2pMoqSegmentStreamRead(reader, maxChunkBytes)
        assert(IsOk(readRes), Error(readRes))
        let chunk = Value(readRes)
        if rawbytes.BytesLen(chunk) <= 0:
            return out
        out = moqstream.Libp2pMoqSegmentStreamAppendBytes(out, chunk)
    return out

fn mediaVideoE2eFetchRemoteSegment(segmentBytes: rawbytes.Bytes, segmentKey: str): rawbytes.Bytes =
    assert(len(segmentKey) > 0, " media video e2e: remote segment key")
    let fetchStartedAtMs = mediaVideoE2eNowMs()
    var settings = qruntime.initMsQuicSettings()
    settings.allowDatagram = true

    let transportStartedAtMs = mediaVideoE2eNowMs()
    var listener = qtransport.InitMsQuicTransport()
    assert(IsOk(qtransport.setMsQuicTransportSettings(listener, settings)),
        " media video e2e: listener settings")
    let listenerTlsStartedAtMs = mediaVideoE2eNowMs()
    assert(IsOk(quic_transport.Libp2pQuicConfigureTls(listener)),
        " media video e2e: listener tls")
    let listenerTlsCompletedAtMs = mediaVideoE2eNowMs()
    let listenAddrRes = quic_transport.Libp2pQuicAddrFromHostPort("127.0.0.1", 0)
    assert(IsOk(listenAddrRes), Error(listenAddrRes))
    let listenerStartStartedAtMs = mediaVideoE2eNowMs()
    qtransport.start(listener, Value(listenAddrRes))
    let listenerStartCompletedAtMs = mediaVideoE2eNowMs()

    var client = qtransport.InitMsQuicTransport()
    assert(IsOk(qtransport.setMsQuicTransportSettings(client, settings)),
        " media video e2e: client settings")
    let clientTlsStartedAtMs = mediaVideoE2eNowMs()
    assert(IsOk(quic_transport.Libp2pQuicConfigureTls(client)),
        " media video e2e: client tls")
    let clientTlsCompletedAtMs = mediaVideoE2eNowMs()
    let dialStartedAtMs = mediaVideoE2eNowMs()
    let dialRes = qtransport.dial(client, listener.listenAddr)
    let dialCompletedAtMs = mediaVideoE2eNowMs()
    assert(IsOk(dialRes), Error(dialRes))
    var clientLegacy = Value(dialRes)
    let acceptStartedAtMs = mediaVideoE2eNowMs()
    let acceptRes = qtransport.accept(listener)
    let acceptCompletedAtMs = mediaVideoE2eNowMs()
    assert(IsOk(acceptRes), Error(acceptRes))
    var serverLegacy = Value(acceptRes)
    let transportCompletedAtMs = mediaVideoE2eNowMs()
    echo(Fmt" media_video_e2e_transport_timing_ms listener_tls={listenerTlsCompletedAtMs - listenerTlsStartedAtMs} listener_start={listenerStartCompletedAtMs - listenerStartStartedAtMs} client_tls={clientTlsCompletedAtMs - clientTlsStartedAtMs} dial={dialCompletedAtMs - dialStartedAtMs} accept={acceptCompletedAtMs - acceptStartedAtMs} total={transportCompletedAtMs - transportStartedAtMs}")

    let streamPairStartedAtMs = mediaVideoE2eNowMs()
    let streamPairRes = qconn.newNativeConnectionPairForStreams(clientLegacy.localAddr,
                                                                clientLegacy.remoteAddr,
                                                                serverLegacy.localAddr,
                                                                serverLegacy.remoteAddr,
                                                                4,
                                                                4,
                                                                4,
                                                                4)
    assert(IsOk(streamPairRes), Error(streamPairRes))
    var clientStream = Value(streamPairRes).outbound
    var serverStream = Value(streamPairRes).inbound
    let streamPairCompletedAtMs = mediaVideoE2eNowMs()

    let negotiateStartedAtMs = mediaVideoE2eNowMs()
    assert(IsOk(moqstream.Libp2pMoqSegmentStreamClientSendNegotiate(client, clientStream)),
        " media video e2e: client moq negotiate")
    assert(IsOk(moqstream.Libp2pMoqSegmentStreamServerNegotiate(listener, serverStream)),
        " media video e2e: server moq negotiate")
    assert(IsOk(moqstream.Libp2pMoqSegmentStreamClientReadNegotiateAck(client, clientStream)),
        " media video e2e: client moq ack")
    let negotiateCompletedAtMs = mediaVideoE2eNowMs()

    var request: moqstream.Libp2pMoqSegmentStreamRequest
    request.streamId = "unimaker-video-first-frame"
    request.segmentKey = segmentKey
    request.offsetBytes = 0
    request.lengthBytes = rawbytes.BytesLen(segmentBytes)
    request.readChunkBytes = 257

    var reader: moqstream.Libp2pMoqSegmentStreamReader
    let clientOpenStartedAtMs = mediaVideoE2eNowMs()
    assert(IsOk(moqstream.Libp2pMoqSegmentStreamClientOpen(reader, clientStream, request)),
        " media video e2e: client open remote segment")
    let clientOpenCompletedAtMs = mediaVideoE2eNowMs()
    let serveStartedAtMs = mediaVideoE2eNowMs()
    let serverServeRes = moqstream.Libp2pMoqSegmentStreamServerHandleRequestedRange(serverStream,
                                                                                    segmentBytes)
    assert(IsOk(serverServeRes), Error(serverServeRes))
    assert(Value(serverServeRes).segmentKey == segmentKey,
        " media video e2e: server segment key")
    let serveCompletedAtMs = mediaVideoE2eNowMs()
    let readStartedAtMs = mediaVideoE2eNowMs()
    let remoteBytes = mediaVideoE2eReadRemoteAll(reader, 193)
    let readCompletedAtMs = mediaVideoE2eNowMs()
    qconn.ConnClose(serverStream)
    moqstream.Libp2pMoqSegmentStreamClose(reader)
    qconn.ConnClose(serverLegacy)
    qconn.ConnClose(clientLegacy)
    qtransport.Stop(listener)
    let fetchCompletedAtMs = mediaVideoE2eNowMs()
    echo(Fmt" media_video_e2e_remote_fetch_timing_ms transport={transportCompletedAtMs - transportStartedAtMs} stream_pair={streamPairCompletedAtMs - streamPairStartedAtMs} negotiate={negotiateCompletedAtMs - negotiateStartedAtMs} client_open={clientOpenCompletedAtMs - clientOpenStartedAtMs} serve={serveCompletedAtMs - serveStartedAtMs} read={readCompletedAtMs - readStartedAtMs} total={fetchCompletedAtMs - fetchStartedAtMs}")
    return remoteBytes

fn mediaVideoE2eMakeMp4MissingAvcC(): rawbytes.Bytes =
    var out = rawbytes.BytesAlloc(44)
    mediaVideoE2eSetU32BE(out, 0, 24)
    mediaVideoE2eSetFour(out, 4, int32('f'), int32('t'), int32('y'), int32('p'))
    mediaVideoE2eSetFour(out, 8, int32('i'), int32('s'), int32('o'), int32('m'))
    mediaVideoE2eSetU32BE(out, 12, 1)
    mediaVideoE2eSetFour(out, 16, int32('i'), int32('s'), int32('o'), int32('m'))
    mediaVideoE2eSetFour(out, 20, int32('a'), int32('v'), int32('c'), int32('1'))
    mediaVideoE2eSetU32BE(out, 24, 8)
    mediaVideoE2eSetFour(out, 28, int32('m'), int32('o'), int32('o'), int32('v'))
    mediaVideoE2eSetU32BE(out, 32, 12)
    mediaVideoE2eSetFour(out, 36, int32('m'), int32('d'), int32('a'), int32('t'))
    rawbytes.BytesSet(out, 40, 1)
    rawbytes.BytesSet(out, 41, 2)
    rawbytes.BytesSet(out, 42, 3)
    rawbytes.BytesSet(out, 43, 4)
    return out

fn mediaVideoE2eBuildVideoSurfaceCommands(manifest: media.MediaAssetManifest,
                                          session: media.MediaPlaybackSession,
                                          buffer: var scene.WebSceneMediaSurfaceCommandBuffer): int32 =
    var graph: scene.WebSceneGraph
    scene.WebSceneGraphInit(graph)
    if !scene.WebSceneAddRouteExpectedIndex(graph, "native_video_surface", 1, 1, 0):
        return 9101
    if !scene.WebSceneAddLayer(graph, 0, 1, "content", 0):
        return 9102
    if !scene.WebSceneAddNode(graph, 0, 1, 0, 2, "div", "", 1):
        return 9103
    if !scene.WebSceneAddNode(graph, 0, 2, 1, 2, "video", "", 1):
        return 9104
    if !scene.WebSceneAddLayoutConstraint(graph, 0, 1, 0, "display", "block"):
        return 9105
    if !scene.WebSceneAddLayoutConstraint(graph, 0, 1, 1, "width", "640px"):
        return 9106
    if !scene.WebSceneAddLayoutConstraint(graph, 0, 1, 2, "height", "360px"):
        return 9107
    if !scene.WebSceneAddLayoutConstraint(graph, 0, 2, 0, "display", "block"):
        return 9108
    if !scene.WebSceneAddLayoutConstraint(graph, 0, 2, 1, "width", "600px"):
        return 9109
    if !scene.WebSceneAddLayoutConstraint(graph, 0, 2, 2, "height", "260px"):
        return 9110

    var asset: scene.WebSceneMediaAsset
    asset.assetFactId = "media.video.e2e.asset"
    asset.assetCid = manifest.assetCid
    asset.bundleCid = manifest.bundleCid
    asset.mime = manifest.mime
    asset.kindCode = manifest.kindCode
    asset.durationMs = Fmt"{manifest.durationMs}"
    asset.codec = manifest.codec
    asset.posterCid = manifest.posterCid
    asset.initSegmentCid = manifest.initSegmentCid
    asset.initSegmentByteLength = manifest.initSegmentByteLength
    asset.keyframeIndex = manifest.keyframeIndex
    asset.transport = manifest.transport
    asset.fecScheme = manifest.fecScheme
    asset.contentSignature = manifest.contentSignature
    asset.catalogCid = manifest.catalogCid
    asset.catalogKey = manifest.catalogKey
    asset.rebuildTemplateCid = manifest.rebuildTemplateCid
    asset.rebuildTemplateKey = manifest.rebuildTemplateKey
    asset.objectTargetBytes = manifest.objectTargetBytes
    asset.sourceBlockBytes = manifest.sourceBlockBytes
    asset.objectCount = manifest.objects.len
    asset.dropletCount = manifest.droplets.len
    if !scene.WebSceneAddMediaAsset(graph, asset):
        return 9111

    var slot: scene.WebSceneMediaPlaybackSlot
    slot.slotId = session.slotId
    slot.assetFactId = "media.video.e2e.asset"
    slot.assetCid = session.assetCid
    slot.manifestCid = session.manifestCid
    slot.nodeTemplate = "template.native.video.player"
    slot.routeIndex = 0
    slot.nodeId = 2
    slot.providerKind = session.providerKind
    slot.stateRef = "media.video.e2e.state"
    slot.decodeProvider = session.decodeProvider
    slot.textureProvider = session.textureProvider
    slot.audioProvider = session.audioProvider
    slot.objectFit = "cover"
    if !scene.WebSceneAddMediaPlaybackSlot(graph, slot):
        return 9112
    if !scene.WebSceneSetActiveRouteById(graph, "native_video_surface"):
        return 9113
    if !scene.WebSceneApplyRouteLayoutToPaintOps(graph, 0, 640, 360):
        return 9114
    if !scene.WebSceneBuildActiveRouteMediaSurfaceCommands(graph, buffer):
        return 9115
    if scene.WebSceneMediaSurfaceCommandCount(buffer) != 1:
        return 9116
    let surfaceIndex = scene.WebSceneFindMediaSurfaceCommandIndex(buffer, session.slotId)
    if surfaceIndex < 0:
        return 9117
    if scene.WebSceneMediaSurfaceWidthAt(buffer, surfaceIndex) != 600 ||
       scene.WebSceneMediaSurfaceHeightAt(buffer, surfaceIndex) != 260:
        return 9118
    return 0

fn main(): int32 =
    let outDir = os.GetEnvDefault("MEDIA_VIDEO_E2E_TMPDIR",
                                  "artifacts/media_video_e2e_native_player_smoke")
    os.MkdirAll(outDir, 493)
    assert(os.DirExists(outDir), " media video e2e: artifact dir")
    var videoPath = os.JoinPath(outDir, "sample.mp4")
    if os.FileExists(videoPath):
        let _removeOld = os.RemoveFile(videoPath)

    var videoBytes = mediaVideoE2eMakeMp4()
    assert(rawbytes.BytesLen(videoBytes) == 2077, " media video e2e: h264 mp4 fixture length")
    let ftypF: int32 = rawbytes.BytesGet(videoBytes, 4)
    let ftypT: int32 = rawbytes.BytesGet(videoBytes, 5)
    let ftypY: int32 = rawbytes.BytesGet(videoBytes, 6)
    let ftypP: int32 = rawbytes.BytesGet(videoBytes, 7)
    assert(ftypF == int32('f'), Fmt" media video e2e: ftyp byte f got={ftypF}")
    assert(ftypT == int32('t'), Fmt" media video e2e: ftyp byte t got={ftypT}")
    assert(ftypY == int32('y'), Fmt" media video e2e: ftyp byte y got={ftypY}")
    assert(ftypP == int32('p'), Fmt" media video e2e: ftyp byte p got={ftypP}")
    var fixturePayload = videoBytes
    let writeRes = os.WriteFileBytesResult(videoPath, fixturePayload)
    assert(IsOk(writeRes), Error(writeRes))
    assert(os.FileExists(videoPath), " media video e2e: sample file exists")
    var fixtureReadRes: Result[rawbytes.Bytes] = os.ReadFileBytesResult(videoPath)
    assert(IsOk(fixtureReadRes), Error(fixtureReadRes))
    assert(rawbytes.BytesLen(Value(fixtureReadRes)) == rawbytes.BytesLen(videoBytes),
        " media video e2e: sample file readback size")

    let badProbeRes = media.MediaProbeMp4FileBytes("bad.mp4", rawbytes.BytesFromString("not-mp4"))
    assert(IsErr(badProbeRes), " media video e2e: bad mp4 rejected")
    let missingAvcCProbeRes = media.MediaProbeMp4FileBytes("missing-avcc.mp4",
                                                           mediaVideoE2eMakeMp4MissingAvcC())
    assert(IsErr(missingAvcCProbeRes), " media video e2e: missing avcC rejected")

    let probeRes = media.MediaProbeMp4FileBytes(videoPath, videoBytes)
    assert(IsOk(probeRes), Error(probeRes))
    let probe = Value(probeRes)
    assert(probe.hasFtyp, " media video e2e: ftyp")
    assert(probe.hasMoov, " media video e2e: moov")
    assert(probe.hasMdat, " media video e2e: mdat")
    assert(probe.hasAvcC, " media video e2e: avcC")
    assert(probe.avcCOffset == 543, " media video e2e: avcC offset")
    assert(probe.avcCSize == 44, " media video e2e: avcC size")
    assert(probe.initSegmentLength == 813, " media video e2e: init segment range")
    assert(probe.keyframeIndex == "mp4:mdat=821:first=829", " media video e2e: keyframe index")

    var index = media.MediaLocalIndexInit()
    var missingReq: media.MediaVideoFileIngestRequest
    missingReq.sourcePath = os.JoinPath(outDir, "missing.mp4")
    missingReq.ownerPeerId = "peer-alpha"
    missingReq.remotePeersCsv = "peer-bravo"
    missingReq.mime = "video/mp4"
    missingReq.durationMs = int64(1000)
    missingReq.codec = "h264/aac"
    missingReq.posterBytes = rawbytes.BytesFromString("platform-decoded-first-frame")
    missingReq.contentSignature = "sig:media-video-e2e"
    missingReq.objectTargetBytes = 1024
    missingReq.sourceBlockBytes = 8
    missingReq.repairDropletCount = 2
    let missingRes = media.MediaIngestVideoFilePin(index, missingReq)
    assert(IsErr(missingRes), " media video e2e: missing source rejected")

    var req: media.MediaVideoFileIngestRequest
    req.sourcePath = videoPath
    req.ownerPeerId = "peer-alpha"
    req.remotePeersCsv = "peer-bravo"
    req.mime = "video/mp4"
    req.durationMs = int64(1000)
    req.codec = "h264/aac"
    req.posterBytes = rawbytes.BytesFromString("platform-decoded-first-frame")
    req.contentSignature = "sig:media-video-e2e"
    req.objectTargetBytes = 1024
    req.sourceBlockBytes = 8
    req.repairDropletCount = 2

    var unsupportedCodecReq: media.MediaVideoFileIngestRequest
    unsupportedCodecReq.sourcePath = videoPath
    unsupportedCodecReq.ownerPeerId = "peer-alpha"
    unsupportedCodecReq.remotePeersCsv = "peer-bravo"
    unsupportedCodecReq.mime = "video/mp4"
    unsupportedCodecReq.durationMs = int64(1000)
    unsupportedCodecReq.codec = "vp9"
    unsupportedCodecReq.posterBytes = rawbytes.BytesFromString("platform-decoded-first-frame")
    unsupportedCodecReq.contentSignature = "sig:media-video-e2e"
    unsupportedCodecReq.objectTargetBytes = 1024
    unsupportedCodecReq.sourceBlockBytes = 8
    unsupportedCodecReq.repairDropletCount = 2
    let unsupportedCodecRes = media.MediaIngestVideoFilePin(index, unsupportedCodecReq)
    assert(IsErr(unsupportedCodecRes), " media video e2e: unsupported codec rejected")

    let ingestStartedAtMs = mediaVideoE2eNowMs()
    let ingestRes = media.MediaIngestVideoFilePin(index, req)
    let ingestCompletedAtMs = mediaVideoE2eNowMs()
    assert(IsOk(ingestRes), Error(ingestRes))
    var ingest = Value(ingestRes)
    media.MediaIngestReceiptStamp(ingest, ingestStartedAtMs, ingestCompletedAtMs)
    assert(ingest.trace == "file-read->mp4-probe->manifest->pin",
        " media video e2e: ingest trace")
    mediaVideoE2eAssertElapsed("ingest", ingest.startedAtMs, ingest.completedAtMs, ingest.elapsedMs)
    assert(ingest.assetCid == media.MediaAssetSha256Hex(videoBytes),
        " media video e2e: asset cid from file bytes")
    assert(ingest.manifestBytes > 0, " media video e2e: manifest bytes")

    let manifestRes = media.MediaLocalIndexFind(index, ingest.assetCid)
    assert(IsOk(manifestRes), Error(manifestRes))
    var manifest = Value(manifestRes)
    let initBytes = rawbytes.BytesSlice(videoBytes, 0, probe.initSegmentLength)
    assert(manifest.initSegmentCid == media.MediaAssetSha256Hex(initBytes),
        " media video e2e: init segment cid")
    assert(manifest.posterCid == media.MediaAssetSha256Hex(req.posterBytes),
        " media video e2e: poster cid")
    assert(manifest.keyframeIndex == "mp4:mdat=821:first=829",
        " media video e2e: manifest keyframe index")

    let pinRoot = os.JoinPath(outDir, "pin")
    let bundleRes = media.MediaPinBundleWrite(pinRoot,
                                              manifest,
                                              videoBytes,
                                              req.posterBytes,
                                              initBytes)
    assert(IsOk(bundleRes), Error(bundleRes))
    let bundle = Value(bundleRes)
    assert(bundle.schema == media.MediaPinBundleSchema, " media video e2e: bundle schema")
    assert(bundle.assetCid == ingest.assetCid, " media video e2e: bundle asset")
    assert(bundle.manifestCid == ingest.manifestCid, " media video e2e: bundle manifest")
    assert(bundle.objectCount == manifest.objects.len, " media video e2e: bundle objects")
    assert(bundle.dropletCount == manifest.droplets.len, " media video e2e: bundle droplets")
    assert(bundle.bytesWritten > rawbytes.BytesLen(videoBytes),
        " media video e2e: bundle bytes written")
    let bundleVerifyRes = media.MediaPinBundleVerifyCore(bundle)
    assert(IsOk(bundleVerifyRes), Error(bundleVerifyRes))
    let bundleManifestTextRes = os.ReadFileResult(bundle.manifestPath)
    assert(IsOk(bundleManifestTextRes), Error(bundleManifestTextRes))
    assert(strutil.Contains(Value(bundleManifestTextRes), "magic=unimaker.media.asset.manifest.v1"),
        " media video e2e: bundle manifest wire")

    var manifestForCsg = manifest
    let assetFactRes = media_csg.MediaManifestToCsgWebAssetFact(manifestForCsg,
                                                               "media.video.e2e.asset")
    assert(IsOk(assetFactRes), Error(assetFactRes))
    let assetFact = Value(assetFactRes)
    assert(assetFact.kind == facts.CsgWebMediaAsset, " media video e2e: csg asset")

    let publishStartedAtMs = mediaVideoE2eNowMs()
    let publishRes = media.MediaPublish(index, ingest.assetCid)
    let publishCompletedAtMs = mediaVideoE2eNowMs()
    assert(IsOk(publishRes), Error(publishRes))
    var publish = Value(publishRes)
    media.MediaOpenReceiptStamp(publish, publishStartedAtMs, publishCompletedAtMs)
    assert(publish.manifestCid == ingest.manifestCid, " media video e2e: publish manifest")
    assert(publish.transport == media.MediaAssetTransportMoq, " media video e2e: publish transport")
    mediaVideoE2eAssertElapsed("publish", publish.startedAtMs, publish.completedAtMs, publish.elapsedMs)

    let remoteFetchStartedAtMs = mediaVideoE2eNowMs()
    let remoteVideoBytes = mediaVideoE2eFetchRemoteSegment(videoBytes, ingest.assetCid)
    let remoteFetchCompletedAtMs = mediaVideoE2eNowMs()
    let remoteFetchElapsedMs = remoteFetchCompletedAtMs - remoteFetchStartedAtMs
    mediaVideoE2eAssertElapsed("remote-fetch", remoteFetchStartedAtMs,
                               remoteFetchCompletedAtMs,
                               remoteFetchElapsedMs)
    assert(remoteFetchElapsedMs < mediaVideoE2eMaxRemoteFetchMs,
        Fmt" media video e2e: remote fetch exceeded ms={remoteFetchElapsedMs} limit={mediaVideoE2eMaxRemoteFetchMs}")
    assert(mediaVideoE2eBytesEq(remoteVideoBytes, videoBytes),
        " media video e2e: remote moq segment bytes")
    assert(media.MediaAssetSha256Hex(remoteVideoBytes) == ingest.assetCid,
        " media video e2e: remote asset cid")
    var remoteIndex = media.MediaLocalIndexInit()
    let remoteProbeRes = media.MediaProbeMp4FileBytes("remote-sample.mp4", remoteVideoBytes)
    assert(IsOk(remoteProbeRes), Error(remoteProbeRes))
    let remoteProbe = Value(remoteProbeRes)
    let remoteInitBytes = rawbytes.BytesSlice(remoteVideoBytes, 0, remoteProbe.initSegmentLength)
    var remoteManifest = manifest
    let remotePinRes = media.MediaLocalIndexPinAssetBytes(remoteIndex,
                                                          remoteManifest,
                                                          remoteVideoBytes,
                                                          req.posterBytes,
                                                          remoteInitBytes,
                                                          false)
    assert(IsOk(remotePinRes), Error(remotePinRes))
    let remoteRecordRes = media.MediaLocalIndexFindAssetRecord(remoteIndex, ingest.assetCid)
    assert(IsOk(remoteRecordRes), Error(remoteRecordRes))
    assert(media.MediaAssetSha256Hex(Value(remoteRecordRes).assetBytes) == ingest.assetCid,
        " media video e2e: remote pinned asset bytes")

    let openStartedAtMs = mediaVideoE2eNowMs()
    let openRes = media.MediaOpenPinned(remoteIndex,
                                        ingest.assetCid,
                                        "slot-remote-native-video",
                                        platform.MediaPlatformDarwinVideoToolboxProvider,
                                        platform.MediaPlatformDarwinMetalTextureProvider,
                                        "coreaudio-provider")
    let openCompletedAtMs = mediaVideoE2eNowMs()
    assert(IsOk(openRes), Error(openRes))
    var session = Value(openRes)
    media.MediaPlaybackSessionStampOpen(session, openStartedAtMs, openCompletedAtMs)
    assert(session.stateCode == media.MediaPlaybackStateOpened, " media video e2e: opened")
    mediaVideoE2eAssertElapsed("open", session.openedAtMs - session.openElapsedMs,
                               session.openedAtMs,
                               session.openElapsedMs)
    var sessionForCsg = session
    let slotFactRes = media_csg.MediaSessionToCsgWebPlaybackSlotFact(sessionForCsg,
                                                                    assetFact.id,
                                                                    "template.native.video.player",
                                                                    "media.video.e2e.state")
    assert(IsOk(slotFactRes), Error(slotFactRes))
    assert(Value(slotFactRes).decodeProvider == platform.MediaPlatformDarwinVideoToolboxProvider,
        " media video e2e: csg slot decode provider")

    let posterAsPlatformRes = media.MediaFirstFrame(session,
                                                    manifest,
                                                    req.posterBytes,
                                                    media.MediaAssetFirstFrameSourcePlatformDecode)
    assert(IsErr(posterAsPlatformRes), " media video e2e: poster cannot satisfy platform decode")

    let frameStartedAtMs = mediaVideoE2eNowMs()
    let frameRes = media.MediaFirstFrameFromPinnedSession(remoteIndex, session)
    let frameCompletedAtMs = mediaVideoE2eNowMs()
    assert(IsOk(frameRes), Error(frameRes))
    var frame = Value(frameRes)
    media.MediaFrameReceiptStamp(frame, frameStartedAtMs, frameCompletedAtMs, session.openedAtMs)
    assert(frame.verified, " media video e2e: first frame verified")
    assert(frame.sourceCode == media.MediaAssetFirstFrameSourcePlatformDecode,
        " media video e2e: platform first frame source")
    assert(frame.decodedWidth == 16, " media video e2e: decoded width")
    assert(frame.decodedHeight == 16, " media video e2e: decoded height")
    assert(frame.pixelFormat > 0, " media video e2e: decoded pixel format")
    assert(frame.pixelBufferHandle != uint64(0), " media video e2e: pixel buffer handle")
    assert(frame.textureHandle != uint64(0), " media video e2e: metal texture handle")
    assert(frame.textureReady, " media video e2e: metal texture ready")
    assert(frame.platformStatusCode == 0, " media video e2e: platform status")
    assert(frame.textureProvider == platform.MediaPlatformDarwinMetalTextureProvider,
        " media video e2e: texture provider")
    mediaVideoE2eAssertElapsed("first-frame", frame.startedAtMs,
                               frame.completedAtMs,
                               frame.elapsedMs)
    assert(frame.sessionOpenedAtMs == session.openedAtMs,
        " media video e2e: frame session open timestamp")
    assert(frame.openToFrameMs == frame.completedAtMs - session.openedAtMs,
        " media video e2e: open to first-frame elapsed")
    assert(frame.openToFrameMs < mediaVideoE2eMaxOpenToFirstFrameMs,
        Fmt" media video e2e: open to first-frame exceeded ms={frame.openToFrameMs} limit={mediaVideoE2eMaxOpenToFirstFrameMs}")
    echo(Fmt" media_video_e2e_timing_ms ingest={ingest.elapsedMs} publish={publish.elapsedMs} open={session.openElapsedMs} remote_fetch={remoteFetchElapsedMs} first_frame={frame.elapsedMs} open_to_first_frame={frame.openToFrameMs}")

    var surfaceCommands: scene.WebSceneMediaSurfaceCommandBuffer
    let surfaceStatus = mediaVideoE2eBuildVideoSurfaceCommands(remoteManifest,
                                                               session,
                                                               surfaceCommands)
    assert(surfaceStatus == 0, Fmt" media video e2e: surface command status={surfaceStatus}")
    let videoSurfaceIndex = scene.WebSceneFindMediaSurfaceCommandIndex(surfaceCommands,
                                                                       session.slotId)
    assert(videoSurfaceIndex >= 0, " media video e2e: video surface command index")

    gui.Init()
    var win = gui.CreateWindow("Cheng Native Video Player", 640, 360)
    gui.ShowWindow(win)
    var list = gui.DrawListNew(16)
    assert(list > 0, " media video e2e: GUI drawlist handle")
    assert(gui.DrawListIsActive(list), " media video e2e: GUI drawlist active")
    assert(gui.MediaDarwinLastTextureReady(), " media video e2e: provider last decoded texture ready")
    assert(gui.DrawListPushLastDecodedTexture(list),
        " media video e2e: GUI drawlist consumed last decoded first-frame texture")
    assert(gui.DrawListSetLastTextureRect(list, 20, 20),
        " media video e2e: GUI drawlist texture rect")
    assert(gui.DrawListSetLastTextureSize(list, 600, 260),
        " media video e2e: GUI drawlist texture size")
    assert(gui.DrawListSetLastTextureMetrics(list,
                                             frame.decodedWidth,
                                             frame.decodedHeight,
                                             frame.pixelFormat),
        " media video e2e: GUI drawlist texture metrics")
    assert(gui.DrawListTextureCount(list) == 1,
        " media video e2e: GUI drawlist texture count")
    assert(gui.DrawListLastTextureHandle(list) == frame.textureHandle,
        " media video e2e: GUI drawlist texture handle")
    assert(gui.DrawListLastTextureWidth(list) == frame.decodedWidth,
        " media video e2e: GUI drawlist texture width")
    assert(gui.DrawListLastTextureHeight(list) == frame.decodedHeight,
        " media video e2e: GUI drawlist texture height")
    assert(gui.DrawListLastTexturePixelFormat(list) == frame.pixelFormat,
        " media video e2e: GUI drawlist texture pixel format")
    assert(gui.DrawListCount(list) == 1, " media video e2e: GUI drawlist command count")
    assert(scene_gui.WebSceneMediaSurfaceCommandCanPushLastDecodedTexture(surfaceCommands,
                                                                          videoSurfaceIndex,
                                                                          list),
        " media video e2e: surface command can push decoded texture")
    assert(!scene_gui.WebSceneMediaSurfaceCommandCanPushLastDecodedTexture(surfaceCommands,
                                                                           -1,
                                                                           list),
        " media video e2e: invalid surface command rejected")
    assert(scene_gui.WebScenePushMediaSurfaceCommandToDrawList(surfaceCommands,
                                                               videoSurfaceIndex,
                                                               list),
        " media video e2e: surface command pushed decoded texture")
    assert(gui.DrawListTextureCount(list) == 2,
        " media video e2e: surface bridge texture count")
    assert(gui.DrawListLastTextureHandle(list) == frame.textureHandle,
        " media video e2e: surface bridge texture handle")
    assert(gui.DrawListLastTextureX(list) == scene.WebSceneMediaSurfaceXAt(surfaceCommands, videoSurfaceIndex),
        " media video e2e: surface bridge texture x")
    assert(gui.DrawListLastTextureY(list) == scene.WebSceneMediaSurfaceYAt(surfaceCommands, videoSurfaceIndex),
        " media video e2e: surface bridge texture y")
    assert(gui.DrawListLastTextureDrawWidth(list) == scene.WebSceneMediaSurfaceWidthAt(surfaceCommands, videoSurfaceIndex),
        " media video e2e: surface bridge texture draw width")
    assert(gui.DrawListLastTextureDrawHeight(list) == scene.WebSceneMediaSurfaceHeightAt(surfaceCommands, videoSurfaceIndex),
        " media video e2e: surface bridge texture draw height")
    assert(gui.DrawListLastTextureWidth(list) == frame.decodedWidth,
        " media video e2e: surface bridge decoded width")
    assert(gui.DrawListLastTextureHeight(list) == frame.decodedHeight,
        " media video e2e: surface bridge decoded height")
    assert(gui.DrawListLastTexturePixelFormat(list) == frame.pixelFormat,
        " media video e2e: surface bridge pixel format")
    assert(gui.DrawListCount(list) == 2, " media video e2e: surface bridge command count")
    var canvas = gui.CreateDrawListCanvas(0, 0, 640, 360)
    gui.SetCanvasDrawList(canvas, list)
    gui.AddView(win, canvas)
    gui.ProcessFrame()

    var playReq = media.MediaControlRequest(
        slotId: session.slotId,
        actionKind: "Play",
        payload: "",
        guard: "asset-opened",
        trace: "agent:typed-action:Play"
    )
    let playRes = media.MediaControl(session, playReq)
    assert(IsOk(playRes), Error(playRes))
    assert(Value(playRes).stateCode == media.MediaPlaybackStatePlaying,
        " media video e2e: play")

    var pauseReq = media.MediaControlRequest(
        slotId: session.slotId,
        actionKind: "Pause",
        payload: "",
        guard: "asset-opened",
        trace: "agent:typed-action:Pause"
    )
    let pauseRes = media.MediaControl(session, pauseReq)
    assert(IsOk(pauseRes), Error(pauseRes))
    assert(Value(pauseRes).stateCode == media.MediaPlaybackStatePaused,
        " media video e2e: pause")

    var seekReq = media.MediaControlRequest(
        slotId: session.slotId,
        actionKind: "Seek",
        payload: "ms=480",
        guard: "asset-opened",
        trace: "agent:typed-action:Seek"
    )
    let seekRes = media.MediaControl(session, seekReq)
    assert(IsOk(seekRes), Error(seekRes))
    assert(Value(seekRes).payload == "ms=480", " media video e2e: seek")

    gui.ReleaseView(canvas)
    gui.DrawListFree(list)
    gui.CloseWindow(win)
    echo(" media_video_e2e_native_player_smoke ok")
    return 0
