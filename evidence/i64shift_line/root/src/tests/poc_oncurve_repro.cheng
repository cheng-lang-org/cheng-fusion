import std/crypto/ecnist as ecnist
import std/result
import std/rawbytes
import std/system
import std/strings
import std/strutils as strutil

fn hexVal(c: int32): int32 =
    if c >= int32('0') && c <= int32('9'):
        return c - int32('0')
    if c >= int32('a') && c <= int32('f'):
        return c - int32('a') + 10
    if c >= int32('A') && c <= int32('F'):
        return c - int32('A') + 10
    return 0

fn bytesFromHex(h: str): Bytes =
    let n: int32 = strings.Len(h) / 2
    var b: Bytes = BytesAlloc(n)
    var i: int32
    while i < n:
        let hi: int32 = hexVal(int32(h[i * 2]))
        let lo: int32 = hexVal(int32(h[i * 2 + 1]))
        BytesSet(b, i, hi * 16 + lo)
        i = i + 1
    return b

fn main(): int32 =
    let pkHex: str = "046B17D1F2E12C4247F8BCE6E563A440F277037D812DEB33A0F4A13945D898C2964FE342E2FE1A7F9B8EE7EB4A7C0F9E162BCE33576B315ECECBB6406837BF51F5"
    var pk: Bytes = bytesFromHex(pkHex)
    var fail: int32
    var i: int32
    while i < 200000:
        var out: ecnist.EcPointFixed
        let res: Result[bool] = ecnist.EcdsaParsePublicKeyPointFixedBytes(pk, true, out)
        if IsErr(res):
            fail = fail + 1
        i = i + 1
    echo(strutil.Join(["fail=", IntToStr(fail), " of 200000"], ""))
    return 0
