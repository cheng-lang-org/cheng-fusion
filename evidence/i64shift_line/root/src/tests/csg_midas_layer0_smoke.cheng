    add(wT, 96)
    add(wT, -6)
    # 直接卷积: out[oc][ih][iw] = sum RoundDiv(in[ic][iy][ix]*w, 1000)
    var outT: int32[]
    var oc: int32 = 0
    while oc < 32:
        var ih: int32 = 0
        while ih < 64:
            var iw: int32 = 0
            while iw < 64:
                var sum: int64 = int64(0)
                var ic: int32 = 0
                while ic < 3:
                    var kh: int32 = 0
                    while kh < 3:
                        var kw: int32 = 0
                        while kw < 3:
                            let iy: int32 = ih + kh - 1
                            let ix: int32 = iw + kw - 1
                            if iy >= 0 and iy < 64 and ix >= 0 and ix < 64:
                                let iv: int32 = inT[(ic * 64 + iy) * 64 + ix]
                                let wv: int32 = wT[((oc * 3 + ic) * 3 + kh) * 3 + kw]
                                sum = sum + int64(iv * wv) / int64(1000)
                            kw = kw + 1
                        kh = kh + 1
                    ic = ic + 1
                add(outT, int32(sum))
                iw = iw + 1
            ih = ih + 1
        oc = oc + 1
    assert(outT.len == 131072, Fmt"out len={outT.len}")
    assert(outT[0] == 271, Fmt"out0={outT[0]}")
    assert(outT[1] == 249, Fmt"out1={outT[1]}")
    assert(outT[2] == 249, Fmt"out2={outT[2]}")
    assert(outT[3] == 248, Fmt"out3={outT[3]}")
    var hsrc: str = ""
    var oi: int32 = 0
    while oi < 131072:
        hsrc = hsrc + strings.IntToStr(outT[oi])
        oi = oi + 1
    let receipt: str = strings.Sha256(hsrc)
    echo(Fmt"midas layer0 receipt len=131072 out0={outT[0]} sha256={receipt}")
    return 0
