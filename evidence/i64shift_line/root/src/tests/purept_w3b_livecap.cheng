# W3b golden criterion (b): decrypt REAL RFC-9001-protected Initial packets
# from the on-file capture harness/artifacts/quic_public/aioquic_udp443_tee.pcap
# (provenance in the sibling PROVENANCE.txt: live client sessions of a real
# production QUIC stack, socket-boundary tee; 21 protected Initial datagrams).
#
# The campaign's earlier layer2_en0.pcap turned out to be plaintext test-stack
# traffic (frames readable, no RFC 9001 protection), so it cannot serve as the
# decryption judge; the negative control for that finding lives in
# purept_w3b_roundtrip.cheng (a real layer2 Initial must fail with -10).
#
# Chain per packet: pcap -> Ethernet/IPv4/UDP -> coalesced walk -> Initial
# slice -> Initial keys from the packet's own DCID (RFC 9001 5.2) -> header
# protection removal + PN reconstruction + AES-128-GCM open -> W3a frame walk.
#
# Judges: every Initial opens under its DCID's keys (21/21); per-connection
# packet numbers are strictly increasing; every payload is fully consumed by
# the frame codec; at least one CRYPTO(0, >=200B) ClientHello flight; close
# packets decode as valid frames.

import std/os
import std/rawbytes
import std/result as result
import std/strings as strings
import cheng/quic/pure/frames_varint as quicvarint
import cheng/quic/pure/frames_header as quichdr
import cheng/quic/pure/frames_codec as quicframes
import cheng/quic/pure/packet_keys as qkeys
import cheng/quic/pure/packet_protect as qprot

var gFails: int32

fn fail3(tag: str, detail: str) =
    os.WriteLine(os.Get_stdout(), strings.concatStr("FAIL ", strings.concatStr(tag,
        strings.concatStr(": ", detail))))
    gFails = gFails + 1

fn pass3(tag: str, detail: str) =
    os.WriteLine(os.Get_stdout(), strings.concatStr("PASS ", strings.concatStr(tag,
        strings.concatStr(": ", detail))))

@borrows
fn be16(b: Bytes, o: int32): int32 =
    return ((BytesGet(b, o) & 255) << 8) | (BytesGet(b, o + 1) & 255)

@borrows
fn le32(b: Bytes, o: int32): int32 =
    return (BytesGet(b, o) & 255) | ((BytesGet(b, o + 1) & 255) << 8) |
        ((BytesGet(b, o + 2) & 255) << 16) | ((BytesGet(b, o + 3) & 255) << 24)

# Per-connection largest packet number tracking, keyed by DCID bytes.
var gDcid0: Bytes = EmptyBytes()
var gDcid1: Bytes = EmptyBytes()
var gDcid2: Bytes = EmptyBytes()
var gDcid3: Bytes = EmptyBytes()
var gLargest0: int64 = 0 - 1
var gLargest1: int64 = 0 - 1
var gLargest2: int64 = 0 - 1
var gLargest3: int64 = 0 - 1

# Query the tracked largest packet number of a DCID (-1 when unseen).
@borrows
fn queryLargest(dcid: Bytes): int64 =
    if gDcid0.len != 0 && BytesEqual(dcid, gDcid0):
        return gLargest0
    if gDcid1.len != 0 && BytesEqual(dcid, gDcid1):
        return gLargest1
    if gDcid2.len != 0 && BytesEqual(dcid, gDcid2):
        return gLargest2
    if gDcid3.len != 0 && BytesEqual(dcid, gDcid3):
        return gLargest3
    return 0 - 1

# Insert or update the tracked largest packet number of a DCID.
@borrows
fn storeLargest(dcid: Bytes, pn: int64) =
    if gDcid0.len == 0:
        gDcid0 = BytesSlice(dcid, 0, dcid.len)
        gLargest0 = pn
        return
    if BytesEqual(dcid, gDcid0):
        gLargest0 = pn
        return
    if gDcid1.len == 0:
        gDcid1 = BytesSlice(dcid, 0, dcid.len)
        gLargest1 = pn
        return
    if BytesEqual(dcid, gDcid1):
        gLargest1 = pn
        return
    if gDcid2.len == 0:
        gDcid2 = BytesSlice(dcid, 0, dcid.len)
        gLargest2 = pn
        return
    if BytesEqual(dcid, gDcid2):
        gLargest2 = pn
        return
    if gDcid3.len == 0:
        gDcid3 = BytesSlice(dcid, 0, dcid.len)
        gLargest3 = pn
        return
    if BytesEqual(dcid, gDcid3):
        gLargest3 = pn
        return

fn main(): int32 =
    let openRes: Result[os.FileHandle] = os.OpenReadHandleResult(
        "docs/campaigns/2026-09-21-pure-cheng-transport/harness/artifacts/quic_public/aioquic_udp443_tee.pcap")
    if result.IsErr(openRes):
        fail3("pcap_open", "handle failed")
        return 1
    let handle: os.FileHandle = result.Value(openRes)
    var bytesRes: Result[rawbytes.Bytes] = os.ReadAllBytesResult(handle)
    if result.IsErr(bytesRes):
        fail3("pcap_read", "read failed")
        return 1
    var f: Bytes = BytesTake(bytesRes.value)
    if f.len < 24 || (BytesGet(f, 0) & 255) != 0xd4 || (BytesGet(f, 1) & 255) != 0xc3:
        fail3("pcap_header", "not the expected LE pcap")
        return 1
    pass3("pcap_open", strings.concatStr("bytes=", strings.IntToStr(f.len)))

    var records: int32
    var initialTotal: int32
    var decrypted: int32
    var pnOk: bool = true
    var walkOk: bool = true
    var cryptoFlights: int32
    var closeFrames: int32
    var maxPn: int64 = 0 - 1
    var firstHello: Bytes = EmptyBytes()
    var firstHelloLen: int64 = 0 - 1
    var distinctDcids: int32

    var off: int32 = 24
    while off + 16 <= f.len:
        let incl: int32 = le32(f, off + 8)
        off = off + 16
        if incl < 0 || off + incl > f.len:
            break
        let pkt: Bytes = BytesSliceView(f, off, incl)
        off = off + incl
        records = records + 1
        if incl < 34 || be16(pkt, 12) != 0x0800:
            continue
        let ip: int32 = 14
        if (BytesGet(pkt, ip) >> 4) != 4 || (BytesGet(pkt, ip + 9) & 255) != 17:
            continue
        let ihl: int32 = (BytesGet(pkt, ip) & 15) * 4
        let udp: int32 = ip + ihl
        let ulen: int32 = be16(pkt, udp + 4)
        if ulen < 9 || udp + ulen > incl:
            continue
        let q: Bytes = BytesSliceView(pkt, udp + 8, ulen - 8)
        var o: int32
        while o < q.len:
            let b0: int32 = BytesGet(q, o) & 255
            if (b0 & 0x80) == 0:
                break
            var h: quichdr.QuicHeader = quichdr.QuicHeaderZero()
            let lv: Bytes = BytesSliceView(q, o, q.len - o)
            let consumed: int32 = quichdr.QuicHeaderParsePacket(lv, h)
            if consumed < 0:
                break
            if h.ptype != quichdr.QuicPktTypeInitial:
                o = o + consumed
                continue
            let wire: Bytes = BytesSliceView(q, o, consumed)
            let dcid: Bytes = BytesSliceView(lv, h.dcidOff, h.dcidLen)
            initialTotal = initialTotal + 1

            var keysRes: Result[qkeys.QuicPacketKeys] = qkeys.QuicInitialKeys(dcid, false)
            if result.IsErr(keysRes):
                fail3("keys", "derivation failed")
                return 1
            var keys: qkeys.QuicPacketKeys = result.Value(keysRes)
            var rec: qprot.QuicUnprotectRecord = qprot.QuicUnprotectRecordZero()
            let prior: int64 = queryLargest(dcid)
            let rc: int32 = qprot.QuicPacketUnprotect(keys, wire, 0, prior, rec)
            if rc != 0:
                fail3("unprotect", strings.concatStr("idx=", strings.concatStr(strings.IntToStr(initialTotal),
                    strings.concatStr(" rc=", strings.IntToStr(rc)))))
                o = o + consumed
                continue
            decrypted = decrypted + 1
            if rec.fullPn <= prior:
                pnOk = false
            storeLargest(dcid, rec.fullPn)
            if rec.fullPn > maxPn:
                maxPn = rec.fullPn
            # frame walk must consume the payload exactly
            var pos: int32
            var fr: quicframes.QuicFrame = quicframes.QuicFrameZero()
            while pos < rec.payloadLen:
                let fc: int32 = quicframes.QuicFrameDecodeAt(rec.plain, pos, fr)
                if fc < 0:
                    walkOk = false
                    break
                if fr.ftype == quicframes.QuicFrameCrypto && fr.offset == 0:
                    let d0: int32 = BytesGet(rec.plain, fr.dataOff) & 255
                    if d0 == 0x01 && fr.length >= 200:
                        cryptoFlights = cryptoFlights + 1
                        if firstHelloLen < 0:
                            firstHelloLen = fr.length
                            firstHello = BytesSlice(rec.plain, fr.dataOff, 32)
                if fr.ftype == 0x1c || fr.ftype == 0x1d:
                    closeFrames = closeFrames + 1
                pos = fc
            o = o + consumed

    distinctDcids = 0
    if gDcid0.len != 0:
        distinctDcids = distinctDcids + 1
    if gDcid1.len != 0:
        distinctDcids = distinctDcids + 1
    if gDcid2.len != 0:
        distinctDcids = distinctDcids + 1
    if gDcid3.len != 0:
        distinctDcids = distinctDcids + 1

    if records != 21:
        fail3("records", strings.IntToStr(records))
    if initialTotal != 21:
        fail3("initial_total", strings.IntToStr(initialTotal))
    if decrypted < 3:
        fail3("golden_minimum", strings.concatStr(strings.IntToStr(decrypted), " < 3"))
    if decrypted != initialTotal:
        fail3("unprotect_all", strings.concatStr(strings.IntToStr(decrypted),
            strings.concatStr("/", strings.IntToStr(initialTotal))))
    if distinctDcids != 3:
        fail3("distinct_dcids", strings.IntToStr(distinctDcids))
    if !pnOk:
        fail3("pn_monotonic", "per-connection packet numbers not strictly increasing")
    if !walkOk:
        fail3("frame_walk", "frame decode error inside a decrypted payload")
    if cryptoFlights < 1:
        fail3("crypto_flight", "no CRYPTO(0, ClientHello) seen")

    pass3("counts", strings.concatStr("records=", strings.concatStr(strings.IntToStr(records),
        strings.concatStr(" initial=", strings.concatStr(strings.IntToStr(initialTotal),
        strings.concatStr(" decrypted=", strings.IntToStr(decrypted)))))))
    pass3("connections", strings.concatStr("distinct_dcids=", strings.IntToStr(distinctDcids)))
    pass3("pn_max", strings.IntToStr(maxPn))
    pass3("crypto_flights", strings.concatStr(strings.IntToStr(cryptoFlights),
        strings.concatStr(" close_frames=", strings.IntToStr(closeFrames))))
    pass3("first_client_hello", strings.concatStr("crypto_len=", strings.concatStr(strings.IntToStr(firstHelloLen),
        strings.concatStr(" head=", BytesToHex(firstHello)))))

    if gFails != 0:
        os.WriteLine(os.Get_stdout(), strings.concatStr("W3B-GOLDEN RESULT: FAIL count=",
            strings.IntToStr(gFails)))
        return 1
    os.WriteLine(os.Get_stdout(), "W3B-GOLDEN RESULT: PASS")
    return 0
