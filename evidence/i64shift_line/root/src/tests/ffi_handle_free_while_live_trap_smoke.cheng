@importc("cheng_ffi_raw_release_i32")
fn cheng_ffi_raw_release_i32(p: ptr): int32

@importc("cheng_tcp_buffer_handle_register_bridge")
fn cheng_tcp_buffer_handle_register_bridge(raw: ptr): uint64

fn main(): int32 =
    let payload = cheng_ffi_raw_new_i32(51)
    if payload == nil:
        return 2
    let handle = cheng_tcp_buffer_handle_register_bridge(payload)
    if handle == uint64(0):
        return 3
    let forbiddenRc = cheng_ffi_raw_release_i32(payload)
