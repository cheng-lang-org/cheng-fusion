module cold_argv_str_owned_metadata_smoke

import std/cmdline as cmdline

fn main(argc: int32, argv: ptr): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    if cmdline.ParamCount() < 2:
        return 10
    let first = cmdline.ParamStr(1)
    let second = cmdline.ParamStr(2)
    if first != "alpha":
        return 11
    if second != "beta":
        return 12
    if first.store_id != 0 || second.store_id != 0:
        return 13
    if first.flags != 1 || second.flags != 1:
        return 14
    return 0
