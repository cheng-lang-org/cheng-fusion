import std/os as os

fn probe(buf: var uint8[64], pos: var int32): bool =
    if pos < 0 || pos >= 64:
        return false
    buf[pos] = uint8(7)
    pos = pos + 1
    return true

fn main(): int32 =
    var b: uint8[64]
    b[0] = uint8(0)
    var p: int32 = 0
    if !probe(b, p):
        os.WriteLine(os.Get_stdout(), "guard-reject")
        return 1
    if b[0] == uint8(7) && p == 1:
        os.WriteLine(os.Get_stdout(), "var-index-ok")
        return 0
    os.WriteLine(os.Get_stdout(), "var-index-bad")
    return 1
