# A-cluster repro: Fmt-string with FIELD-PATH pieces as the argument of a
# void/statement-position call (sink). Mirrors LoweringDebugLine(Fmt"...{plan.field}...")
# / AppendLine(out, Fmt"...{x.len}...") in lowering_plan.cheng.
#
# Parallel control: the SAME Fmt at an assign position (fmtAssignField*) already
# lowers CLEAN through the node-eval path; the void-call position (fmtVoidCallField*)
# is the one that fell back to the text path and produced valueOp=unsupported.
#
# Kept light (no std/strings) so it compiles standalone under system-link-exec.

type
    Plan =
        name: str
        count: int32
        functionNames: str[]

var sinkLog: str

fn sink(line: str) =
    sinkLog = line

# void-call position: Fmt field-path str piece on a VAR-PARAM root (mirrors
# LoweringDebugLine(Fmt"...{plan.name}...") with plan: var LoweringPlanStub).
fn fmtVoidCallFieldStr(plan: var Plan) =
    sink(Fmt"plan_name={plan.name};")

# void-call position: Fmt field-path int piece on a VAR-PARAM root
fn fmtVoidCallFieldInt(plan: var Plan) =
    sink(Fmt"plan_count={plan.count};")

# void-call position: Fmt field-path .len piece (aggregate field .len) on var-param
fn fmtVoidCallFieldLen(plan: var Plan) =
    sink(Fmt"fn_count={plan.functionNames.len};")

# void-call position: Fmt .len of a VAR-PARAM seq directly (buildFlags.len shape)
fn fmtVoidCallSeqLen(flags: var bool[]) =
    sink(Fmt"flags={flags.len};")

# void-call position: Fmt index-INTO-field-path piece (mirrors line 3009
# Fmt"...name={plan.functionNames[i]}..."), plus a two-piece Fmt with both a
# .len field and a seq .len (mirrors line 3004 enter line).
fn fmtVoidCallFieldIndex(plan: var Plan, i: int32) =
    sink(Fmt"nm={plan.functionNames[i]};")

fn fmtVoidCallTwoFieldLen(plan: var Plan, flags: var bool[]) =
    sink(Fmt"functions={plan.functionNames.len} flags={flags.len};")

# assign-position control (already CLEAN): same field-path Fmt pieces
fn fmtAssignFieldStr(plan: var Plan): str =
    let s: str = Fmt"plan_name={plan.name};"
    return s

fn fmtAssignFieldInt(plan: var Plan): str =
    let s: str = Fmt"plan_count={plan.count};"
    return s

fn fmtAssignFieldLen(plan: var Plan): str =
    let s: str = Fmt"fn_count={plan.functionNames.len};"
    return s

fn fmtAssignSeqLen(flags: var bool[]): str =
    let s: str = Fmt"flags={flags.len};"
    return s

fn fmtAssignFieldIndex(plan: var Plan, i: int32): str =
    let s: str = Fmt"nm={plan.functionNames[i]};"
    return s

fn fmtAssignTwoFieldLen(plan: var Plan, flags: var bool[]): str =
    let s: str = Fmt"functions={plan.functionNames.len} flags={flags.len};"
    return s

fn main(): int32 =
    var names: str[]
    add(names, "alpha")
    add(names, "beta")
    var plan = Plan(name: "demo", count: 7, functionNames: names)
    var flags: bool[]
    add(flags, true)
    add(flags, false)
    add(flags, true)

    sinkLog = ""
    fmtVoidCallFieldStr(plan)
    if sinkLog != "plan_name=demo;":
        return 1
    fmtVoidCallFieldInt(plan)
    if sinkLog != "plan_count=7;":
        return 5
    fmtVoidCallFieldLen(plan)
    if sinkLog != "fn_count=2;":
        return 6
    fmtVoidCallSeqLen(flags)
    if sinkLog != "flags=3;":
        return 7
    fmtVoidCallFieldIndex(plan, 1)
    if sinkLog != "nm=beta;":
        return 9
    fmtVoidCallTwoFieldLen(plan, flags)
    if sinkLog != "functions=2 flags=3;":
        return 10

    if fmtAssignFieldStr(plan) != "plan_name=demo;":
        return 2
    if fmtAssignFieldInt(plan) != "plan_count=7;":
        return 3
    if fmtAssignFieldLen(plan) != "fn_count=2;":
        return 4
    if fmtAssignSeqLen(flags) != "flags=3;":
        return 8
    if fmtAssignFieldIndex(plan, 1) != "nm=beta;":
        return 11
    if fmtAssignTwoFieldLen(plan, flags) != "functions=2 flags=3;":
        return 12

    return 0
