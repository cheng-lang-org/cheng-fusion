import std/system
import std/rawbytes
import std/crypto/sha256

fn main(): int32 =
    let data: Bytes = BytesAlloc(4)
    BytesSet(data, 0, 0x12)
    BytesSet(data, 1, 0x34)
    BytesSet(data, 2, 0x56)
    BytesSet(data, 3, 0x78)
    let word = sha256.GetU32BE(data, 0)
    assert(word == int64(0x12345678), " get_u32be: word")
    let out: Bytes = BytesAlloc(4)
    sha256.SetU32BE(out, 0, word)
    assert(BytesGet(out, 0) == 0x12, " get_u32be: out byte0")
    assert(BytesGet(out, 1) == 0x34, " get_u32be: out byte1")
    assert(BytesGet(out, 2) == 0x56, " get_u32be: out byte2")
    assert(BytesGet(out, 3) == 0x78, " get_u32be: out byte3")
    BytesSet(data, 0, 0xba)
    BytesSet(data, 1, 0x78)
    BytesSet(data, 2, 0x16)
    BytesSet(data, 3, 0x80)
    let wordHigh = sha256.GetU32BE(data, 0)
    assert(wordHigh == int64(0xba781680), " get_u32be: high word")
    sha256.SetU32BE(out, 0, wordHigh)
    assert(BytesGet(out, 0) == 0xba, " get_u32be: high byte0")
    assert(BytesGet(out, 1) == 0x78, " get_u32be: high byte1")
    assert(BytesGet(out, 2) == 0x16, " get_u32be: high byte2")
    assert(BytesGet(out, 3) == 0x80, " get_u32be: high byte3")
    echo(" get_u32be_smoke ok")
    return 0
