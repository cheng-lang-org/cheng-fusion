import std/system

type TypeSizeWideValue =
    first: int64
    second: int64
    third: int64

fn genericElemSizeConst[T](value: T): int32 =
    return elemSize[T]()

fn genericSizeofConst[T](value: T): int32 =
    return sizeof(T)

fn main(): int32 =
    var value: TypeSizeWideValue
    if genericElemSizeConst[TypeSizeWideValue](value) != 24:
        return 1
    if genericSizeofConst[TypeSizeWideValue](value) != 24:
        return 2
    if genericElemSizeConst[int32](7) != 4:
        return 3
    return 0

main()
