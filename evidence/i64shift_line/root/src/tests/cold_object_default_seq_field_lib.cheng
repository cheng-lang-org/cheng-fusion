type
    ColdImportedDefaultSeqPlan =
        command: str
        prompt: str
        images: str[]
        model: str
        cwd: str
        configOverrides: str[]
        addDirs: str[]
        maxTurns: int32

fn ColdImportedDefaultSeqPlanDefault(): ColdImportedDefaultSeqPlan =
    var result: ColdImportedDefaultSeqPlan
    result.command = "run"
    result.maxTurns = 7
    return result

fn ColdImportedDefaultSeqPlanParse(args: str[]): ColdImportedDefaultSeqPlan =
    var plan = ColdImportedDefaultSeqPlanDefault()
    if args.len > 0:
        plan.model = args[0]
    return plan

fn ColdImportedDefaultSeqPlanCheck(plan: var ColdImportedDefaultSeqPlan): int32 =
    if plan.configOverrides.len != 0:
        return 10
    if plan.addDirs.len != 0:
        return 11
    if plan.images.len != 0:
        return 12
    if plan.command != "run":
        return 13
    if plan.maxTurns != 7:
        return 14
    return 0

fn ColdImportedDefaultSeqPlanWrapper(plan: var ColdImportedDefaultSeqPlan): int32 =
    if plan.model == "":
        return 20
    return ColdImportedDefaultSeqPlanCheck(plan)
