import std/cmdline
import std/os
import std/rawbytes
import std/strings as strings
import std/strutils as strutil

fn RequireParent(): str =
    var parent: str
    assert(cmdline.readFlagValue("--parent", parent) && len(parent) > 0,
           "atomic tree smoke: --parent is required")
    return parent

fn RequireFlag(name: str): str =
    var value: str
    assert(cmdline.readFlagValue(name, value) && len(value) > 0,
           "atomic tree smoke: required flag missing")
    return value

fn ReadControlLine(): str =
    var out: str
    var ch: int32
    while true:
        ch = os.C_fgetc(os.Get_stdin())
        if ch < 0 || ch == 10:
            break
        if ch != 13:
            out = strutil.Join([out, strings.CharToStr(char(ch))], "")
    return out

fn AssertExclusiveAbsentInstall(parent: str) =
    let stagingName = RequireFlag("--staging")
    let finalName = RequireFlag("--final")
    let payloadText = RequireFlag("--payload")
    let openRes = os.AtomicTreeOpenVerifiedExclusiveOrAbsent(
        parent,
        finalName)
    assert(IsOk(openRes), Error(openRes))
    let openResult = Value(openRes)
    assert(openResult.kind == os.AtomicTreeExclusiveAbsent,
           "atomic tree smoke: expected exclusive ABSENT")
    var absentTree = openResult.tree
    var staleAbsentTree = absentTree
    let beginRes = os.AtomicTreeBeginFromExclusiveAbsent(
        absentTree,
        stagingName)
    assert(IsOk(beginRes), Error(beginRes))
    assert(absentTree == uint64(0),
           "atomic tree smoke: ABSENT generation was not consumed")
    let staleStagingName = strutil.Join([stagingName, "-stale"], "")
    let staleBegin = os.AtomicTreeBeginFromExclusiveAbsent(
        staleAbsentTree,
        staleStagingName)
    assert(IsErr(staleBegin) &&
           strutil.Contains(Error(staleBegin), "stale handle"),
           "atomic tree smoke: copied ABSENT generation was not stale")
    let staleAbsentClose = os.AtomicTreeClose(staleAbsentTree)
    assert(IsErr(staleAbsentClose) &&
           strutil.Contains(Error(staleAbsentClose), "stale handle"),
           "atomic tree smoke: copied ABSENT close was not stale")
    var transaction = Value(beginRes)
    var staleTransaction = transaction
    var payload = rawbytes.BytesFromString(payloadText)
    assert(IsOk(os.AtomicTreeWriteExclusiveLeaseSync(
               transaction,
               "value.txt",
               payload)),
           "atomic tree smoke: exclusive transaction write")
    let commitRes =
        os.AtomicTreeCommitExclusiveNoReplaceAndOpenVerified(transaction)
    assert(IsOk(commitRes), Error(commitRes))
    assert(transaction == uint64(0),
           "atomic tree smoke: transaction generation was not consumed")
    let staleWrite = os.AtomicTreeWriteExclusiveLeaseSync(
        staleTransaction,
        "stale.txt",
        payload)
    assert(IsErr(staleWrite) &&
           strutil.Contains(Error(staleWrite), "stale handle"),
           "atomic tree smoke: copied transaction write was not stale")
    let staleCommit =
        os.AtomicTreeCommitExclusiveNoReplaceAndOpenVerified(
            staleTransaction)
    assert(IsErr(staleCommit) &&
           strutil.Contains(Error(staleCommit), "stale handle"),
           "atomic tree smoke: copied transaction commit was not stale")
    let staleAbort = os.AtomicTreeAbort(staleTransaction)
    assert(IsErr(staleAbort) &&
           strutil.Contains(Error(staleAbort), "stale handle"),
           "atomic tree smoke: copied transaction abort was not stale")
    let staleClose = os.AtomicTreeClose(staleTransaction)
    assert(IsErr(staleClose) &&
           strutil.Contains(Error(staleClose), "stale handle"),
           "atomic tree smoke: copied transaction close was not stale")
    let opened = Value(commitRes)
    let readRes = os.AtomicTreeReadStable(opened, "value.txt")
    assert(IsOk(readRes),
           "atomic tree smoke: continuous opened read mismatch")
    var installed = Value(readRes)
    assert(rawbytes.BytesEqual(installed, payload),
           "atomic tree smoke: continuous opened read mismatch")
    rawbytes.BytesFree(installed)
    assert(IsOk(os.AtomicTreeClose(opened)),
           "atomic tree smoke: continuous opened close")

fn AssertExclusiveOpened(parent: str) =
    let finalName = RequireFlag("--final")
    let openRes = os.AtomicTreeOpenVerifiedExclusiveOrAbsent(
        parent,
        finalName)
    assert(IsOk(openRes), Error(openRes))
    let openResult = Value(openRes)
    assert(openResult.kind == os.AtomicTreeExclusiveOpened,
           "atomic tree smoke: expected exclusive OPENED")
    assert(IsOk(os.AtomicTreeClose(openResult.tree)),
           "atomic tree smoke: exclusive OPENED close")

fn AssertExclusiveInvalid(parent: str) =
    let finalName = RequireFlag("--final")
    let openRes = os.AtomicTreeOpenVerifiedExclusiveOrAbsent(
        parent,
        finalName)
    assert(IsErr(openRes),
           "atomic tree smoke: invalid exclusive final accepted")

fn AssertLeaseHolder(parent: str) =
    let finalName = RequireFlag("--final")
    let openRes = os.AtomicTreeOpenVerifiedExclusiveOrAbsent(
        parent,
        finalName)
    assert(IsOk(openRes), Error(openRes))
    let openResult = Value(openRes)
    let holder = openResult.tree
    echo("READY")
    let _ = os.C_fflush(os.Get_stdout())
    assert(ReadControlLine() == "GO",
           "atomic tree smoke: lease holder release token")
    assert(IsOk(os.AtomicTreeClose(holder)),
           "atomic tree smoke: lease holder close")
    echo("RELEASED")

fn AssertLeaseContender(parent: str) =
    let finalName = RequireFlag("--final")
    let openRes = os.AtomicTreeOpenVerifiedExclusiveOrAbsent(
        parent,
        finalName)
    assert(IsErr(openRes),
           "atomic tree smoke: parent-wide contender acquired lease")
    echo("CONTENDED")

fn AssertLeaseCrashRelease(parent: str) =
    let finalName = RequireFlag("--final")
    let openRes = os.AtomicTreeOpenVerifiedExclusiveOrAbsent(
        parent,
        finalName)
    assert(IsOk(openRes), Error(openRes))
    let openResult = Value(openRes)
    assert(IsOk(os.AtomicTreeClose(openResult.tree)),
           "atomic tree smoke: crash-released lease close")
    echo("CRASH_RELEASED")

fn AssertPrimaryInstall(parent: str) =
    let beginRes = os.AtomicTreeBegin(parent,
                                      "txn-primary",
                                      "installed")
    assert(IsOk(beginRes), Error(beginRes))
    let handle = Value(beginRes)
    var exclusiveOnly = rawbytes.BytesFromString("must-reject")
    let legacyExclusiveWrite = os.AtomicTreeWriteExclusiveLeaseSync(
        handle,
        "exclusive-only.txt",
        exclusiveOnly)
    assert(IsErr(legacyExclusiveWrite) &&
           strutil.Contains(Error(legacyExclusiveWrite),
                            "active exclusive lease transaction"),
           "atomic tree smoke: legacy transaction gained exclusive lease write authority")
    assert(IsOk(os.AtomicTreeMkdir(handle, "src/lib")),
           "atomic tree smoke: nested mkdir")
    assert(IsErr(os.AtomicTreeMkdir(handle, "../escape")),
           "atomic tree smoke: parent traversal accepted")
    var payload = rawbytes.BytesFromString("portable-bytes")
    assert(IsOk(os.AtomicTreeWriteExclusiveSync(handle,
                                                 "src/lib/main.cheng",
                                                 payload)),
           "atomic tree smoke: payload write")
    assert(IsErr(os.AtomicTreeWriteExclusiveSync(handle,
                                                  "src/lib/main.cheng",
                                                  payload)),
           "atomic tree smoke: duplicate write accepted")
    var empty = rawbytes.EmptyBytes()
    assert(IsOk(os.AtomicTreeWriteExclusiveSync(handle,
                                                 "src/zero.cheng",
                                                 empty)),
           "atomic tree smoke: zero-byte write")
    assert(IsOk(os.AtomicTreeVerifyExact(
               handle,
               ["src", "src/lib"],
               ["src/lib/main.cheng", "src/zero.cheng"])),
           "atomic tree smoke: transaction exact-tree mismatch")
    let beforeRes = os.AtomicTreeReadStable(handle,
                                             "src/lib/main.cheng")
    assert(IsOk(beforeRes),
           "atomic tree smoke: transaction read mismatch")
    var before = Value(beforeRes)
    assert(rawbytes.BytesEqual(before, payload),
           "atomic tree smoke: transaction read mismatch")
    rawbytes.BytesFree(before)
    let commitRes = os.AtomicTreeCommitNoReplace(handle)
    assert(IsOk(commitRes) &&
           Value(commitRes) == os.AtomicTreeCommitted,
           "atomic tree smoke: primary commit")
    assert(IsOk(os.AtomicTreeClose(handle)),
           "atomic tree smoke: committed close")
    assert(IsErr(os.AtomicTreeReadStable(handle,
                                          "src/lib/main.cheng")),
           "atomic tree smoke: stale handle accepted")

fn AssertVerifiedOpen(parent: str) =
    let openRes = os.AtomicTreeOpenVerified(parent, "installed")
    assert(IsOk(openRes), Error(openRes))
    let handle = Value(openRes)
    assert(IsOk(os.AtomicTreeVerifyExact(
               handle,
               ["src", "src/lib"],
               ["src/lib/main.cheng", "src/zero.cheng"])),
           "atomic tree smoke: verified exact-tree mismatch")
    var expected = rawbytes.BytesFromString("portable-bytes")
    let readRes = os.AtomicTreeReadStable(handle,
                                           "src/lib/main.cheng")
    assert(IsOk(readRes),
           "atomic tree smoke: verified payload mismatch")
    var actual = Value(readRes)
    assert(rawbytes.BytesEqual(actual, expected),
           "atomic tree smoke: verified payload mismatch")
    rawbytes.BytesFree(actual)
    let zeroRes = os.AtomicTreeReadStable(handle, "src/zero.cheng")
    assert(IsOk(zeroRes),
           "atomic tree smoke: verified zero-byte mismatch")
    var zero = Value(zeroRes)
    assert(rawbytes.BytesLen(zero) == 0,
           "atomic tree smoke: verified zero-byte mismatch")
    rawbytes.BytesFree(zero)
    assert(IsOk(os.AtomicTreeClose(handle)),
           "atomic tree smoke: verified close")

fn AssertVerifiedSameInodeRewriteRejected(parent: str) =
    let beginRes = os.AtomicTreeBegin(parent,
                                      "txn-rewrite",
                                      "rewrite-installed")
    assert(IsOk(beginRes), Error(beginRes))
    let transaction = Value(beginRes)
    var original = rawbytes.BytesFromString("stable-value")
    assert(IsOk(os.AtomicTreeWriteExclusiveSync(transaction,
                                                 "value.txt",
                                                 original)),
           "atomic tree smoke: rewrite fixture write")
    let commitRes = os.AtomicTreeCommitNoReplace(transaction)
    assert(IsOk(commitRes) &&
           Value(commitRes) == os.AtomicTreeCommitted,
           "atomic tree smoke: rewrite fixture commit")
    assert(IsOk(os.AtomicTreeClose(transaction)),
           "atomic tree smoke: rewrite transaction close")
    let openRes = os.AtomicTreeOpenVerified(parent, "rewrite-installed")
    assert(IsOk(openRes), Error(openRes))
    let verified = Value(openRes)
    let readRes = os.AtomicTreeReadStable(verified, "value.txt")
    assert(IsOk(readRes),
           "atomic tree smoke: rewrite fixture stable read")
    var readBytes = Value(readRes)
    assert(rawbytes.BytesEqual(readBytes, original),
           "atomic tree smoke: rewrite fixture stable read")
    rawbytes.BytesFree(readBytes)
    os.WriteFile(strutil.Join([
        parent,
        "/rewrite-installed/value.txt"
    ], ""), "attack-value")
    assert(IsErr(os.AtomicTreeClose(verified)),
           "atomic tree smoke: same-inode rewrite accepted")
    assert(IsErr(os.AtomicTreeReadStable(verified, "value.txt")),
           "atomic tree smoke: unstable close retained handle")

fn AssertDestinationExistsAndAbort(parent: str) =
    let beginRes = os.AtomicTreeBegin(parent,
                                      "txn-existing",
                                      "installed")
    assert(IsOk(beginRes), Error(beginRes))
    let handle = Value(beginRes)
    var payload = rawbytes.BytesFromString("portable-bytes")
    assert(IsOk(os.AtomicTreeMkdir(handle, "src/lib")) &&
           IsOk(os.AtomicTreeWriteExclusiveSync(handle,
                                                 "src/lib/main.cheng",
                                                 payload)),
           "atomic tree smoke: second tree build")
    let commitRes = os.AtomicTreeCommitNoReplace(handle)
    assert(IsOk(commitRes) &&
           Value(commitRes) == os.AtomicTreeDestinationExists,
           "atomic tree smoke: existing destination overwritten")
    let verifiedRes = os.AtomicTreeOpenVerified(parent, "installed")
    assert(IsOk(verifiedRes), Error(verifiedRes))
    let verified = Value(verifiedRes)
    assert(IsOk(os.AtomicTreeVerifyExact(
               verified,
               ["src", "src/lib"],
               ["src/lib/main.cheng", "src/zero.cheng"])),
           "atomic tree smoke: existing destination exact-tree mismatch")
    assert(IsOk(os.AtomicTreeClose(verified)),
           "atomic tree smoke: existing destination verified close")
    assert(IsOk(os.AtomicTreeAbort(handle)),
           "atomic tree smoke: existing transaction abort")
    assert(IsErr(os.AtomicTreeClose(handle)),
           "atomic tree smoke: aborted stale handle accepted")

fn AssertAbort(parent: str) =
    let beginRes = os.AtomicTreeBegin(parent,
                                      "txn-abort",
                                      "never-installed")
    assert(IsOk(beginRes), Error(beginRes))
    let handle = Value(beginRes)
    var payload = rawbytes.BytesFromString("abort-me")
    assert(IsOk(os.AtomicTreeMkdir(handle, "a/b")) &&
           IsOk(os.AtomicTreeWriteExclusiveSync(handle,
                                                 "a/b/value",
                                                 payload)),
           "atomic tree smoke: abort tree build")
    assert(IsErr(os.AtomicTreeClose(handle)),
           "atomic tree smoke: active transaction close accepted")
    assert(IsOk(os.AtomicTreeAbort(handle)),
           "atomic tree smoke: tracked abort")

fn AssertAbortResidual(parent: str) =
    let beginRes = os.AtomicTreeBegin(parent,
                                      "txn-residual",
                                      "never-installed-residual")
    assert(IsOk(beginRes), Error(beginRes))
    let handle = Value(beginRes)
    let residualPath = strutil.Join([
        parent,
        "/txn-residual/untracked"
    ], "")
    os.WriteFile(residualPath, "attacker-owned")
    assert(IsErr(os.AtomicTreeAbort(handle)),
           "atomic tree smoke: residual abort false-green")
    assert(IsErr(os.AtomicTreeClose(handle)),
           "atomic tree smoke: failed abort handle not invalidated")
    assert(os.FileExists(residualPath),
           "atomic tree smoke: abort deleted untracked node")

fn AssertExactTreeAttacks(parent: str) =
    var payload = rawbytes.BytesFromString("extra")
    let extraFileRes = os.AtomicTreeBegin(parent,
                                           "txn-exact-extra-file",
                                           "never-exact-extra-file")
    assert(IsOk(extraFileRes), Error(extraFileRes))
    let extraFile = Value(extraFileRes)
    assert(IsOk(os.AtomicTreeWriteExclusiveSync(extraFile,
                                                 "extra",
                                                 payload)),
           "atomic tree smoke: extra file setup")
    assert(IsErr(os.AtomicTreeVerifyExact(extraFile, [], [])),
           "atomic tree smoke: extra file accepted")
    assert(IsOk(os.AtomicTreeAbort(extraFile)),
           "atomic tree smoke: extra file abort")

    let extraDirRes = os.AtomicTreeBegin(parent,
                                          "txn-exact-extra-dir",
                                          "never-exact-extra-dir")
    assert(IsOk(extraDirRes), Error(extraDirRes))
    let extraDir = Value(extraDirRes)
    assert(IsOk(os.AtomicTreeMkdir(extraDir, "extra")),
           "atomic tree smoke: extra directory setup")
    assert(IsErr(os.AtomicTreeVerifyExact(extraDir, [], [])),
           "atomic tree smoke: extra directory accepted")
    assert(IsOk(os.AtomicTreeAbort(extraDir)),
           "atomic tree smoke: extra directory abort")

    let typeSwapRes = os.AtomicTreeBegin(parent,
                                          "txn-exact-type-swap",
                                          "never-exact-type-swap")
    assert(IsOk(typeSwapRes), Error(typeSwapRes))
    let typeSwap = Value(typeSwapRes)
    assert(IsOk(os.AtomicTreeMkdir(typeSwap, "leaf")),
           "atomic tree smoke: type swap setup")
    assert(IsErr(os.AtomicTreeVerifyExact(typeSwap, [], ["leaf"])),
           "atomic tree smoke: directory accepted as file")
    assert(IsOk(os.AtomicTreeAbort(typeSwap)),
           "atomic tree smoke: type swap abort")

    let schemaRes = os.AtomicTreeBegin(parent,
                                        "txn-exact-schema",
                                        "never-exact-schema")
    assert(IsOk(schemaRes), Error(schemaRes))
    let schema = Value(schemaRes)
    assert(IsErr(os.AtomicTreeVerifyExact(schema,
                                           ["missing/parent"],
                                           [])),
           "atomic tree smoke: missing expected parent accepted")
    assert(IsErr(os.AtomicTreeVerifyExact(schema,
                                           ["duplicate", "duplicate"],
                                           [])),
           "atomic tree smoke: duplicate expected directory accepted")
    assert(IsErr(os.AtomicTreeVerifyExact(schema,
                                           [],
                                           ["control\tname"])),
           "atomic tree smoke: expected control character accepted")
    assert(IsOk(os.AtomicTreeAbort(schema)),
           "atomic tree smoke: exact schema abort")

fn AssertPartialInstallRejected(parent: str) =
    let beginRes = os.AtomicTreeBegin(parent,
                                      "txn-partial-install",
                                      "partial-installed")
    assert(IsOk(beginRes), Error(beginRes))
    let transaction = Value(beginRes)
    var payload = rawbytes.BytesFromString("portable-bytes")
    assert(IsOk(os.AtomicTreeMkdir(transaction, "src/lib")) &&
           IsOk(os.AtomicTreeWriteExclusiveSync(transaction,
                                                 "src/lib/main.cheng",
                                                 payload)),
           "atomic tree smoke: partial install setup")
    let commitRes = os.AtomicTreeCommitNoReplace(transaction)
    assert(IsOk(commitRes) && Value(commitRes) == os.AtomicTreeCommitted,
           "atomic tree smoke: partial install commit")
    assert(IsOk(os.AtomicTreeClose(transaction)),
           "atomic tree smoke: partial install close")
    let openRes = os.AtomicTreeOpenVerified(parent, "partial-installed")
    assert(IsOk(openRes), Error(openRes))
    let verified = Value(openRes)
    assert(IsErr(os.AtomicTreeVerifyExact(
               verified,
               ["src", "src/lib"],
               ["src/lib/main.cheng", "src/zero.cheng"])),
           "atomic tree smoke: partial installed destination accepted")
    assert(IsOk(os.AtomicTreeClose(verified)),
           "atomic tree smoke: partial install verified close")

fn AssertTamperedContentRejected(parent: str) =
    let beginRes = os.AtomicTreeBegin(parent,
                                      "txn-tampered-install",
                                      "tampered-installed")
    assert(IsOk(beginRes), Error(beginRes))
    let transaction = Value(beginRes)
    var tampered = rawbytes.BytesFromString("tampered-bytes")
    assert(IsOk(os.AtomicTreeMkdir(transaction, "src")) &&
           IsOk(os.AtomicTreeWriteExclusiveSync(transaction,
                                                 "src/main.cheng",
                                                 tampered)),
           "atomic tree smoke: tampered install setup")
    let commitRes = os.AtomicTreeCommitNoReplace(transaction)
    assert(IsOk(commitRes) && Value(commitRes) == os.AtomicTreeCommitted,
           "atomic tree smoke: tampered install commit")
    assert(IsOk(os.AtomicTreeClose(transaction)),
           "atomic tree smoke: tampered install close")
    let openRes = os.AtomicTreeOpenVerified(parent, "tampered-installed")
    assert(IsOk(openRes), Error(openRes))
    let verified = Value(openRes)
    assert(IsOk(os.AtomicTreeVerifyExact(verified,
                                          ["src"],
                                          ["src/main.cheng"])),
           "atomic tree smoke: tampered shape unexpectedly rejected")
    let readRes = os.AtomicTreeReadStable(verified, "src/main.cheng")
    var expected = rawbytes.BytesFromString("portable-bytes")
    assert(IsOk(readRes),
           "atomic tree smoke: tampered content false-green")
    var actual = Value(readRes)
    assert(!rawbytes.BytesEqual(actual, expected),
           "atomic tree smoke: tampered content false-green")
    rawbytes.BytesFree(actual)
    assert(IsOk(os.AtomicTreeClose(verified)),
           "atomic tree smoke: tampered install verified close")

fn AssertRejectParent(parent: str) =
    let beginRes = os.AtomicTreeBegin(parent,
                                      "txn-reject-parent",
                                      "never-installed-parent")
    assert(IsErr(beginRes),
           "atomic tree smoke: symlink parent accepted")

fn AssertRejectFinal(parent: str) =
    let openRes = os.AtomicTreeOpenVerified(parent, "installed")
    assert(IsErr(openRes),
           "atomic tree smoke: symlink final accepted")

fn AssertRejectIntermediate(parent: str) =
    let openRes = os.AtomicTreeOpenVerified(parent, "installed")
    assert(IsOk(openRes), Error(openRes))
    let handle = Value(openRes)
    assert(IsErr(os.AtomicTreeReadStable(handle, "src/value")),
           "atomic tree smoke: symlink intermediate accepted")
    assert(IsOk(os.AtomicTreeClose(handle)),
           "atomic tree smoke: reject intermediate close")

fn AssertRejectLeafExact(parent: str) =
    let openRes = os.AtomicTreeOpenVerified(parent, "installed")
    assert(IsOk(openRes), Error(openRes))
    let handle = Value(openRes)
    assert(IsErr(os.AtomicTreeVerifyExact(handle,
                                           ["src"],
                                           ["src/value"])),
           "atomic tree smoke: leaf symlink accepted by exact-tree")
    assert(IsOk(os.AtomicTreeClose(handle)),
           "atomic tree smoke: reject leaf exact close")

fn main(argc: int32, argv: str*): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    let parent = RequireParent()
    let mode = cmdline.ReadFlagOrDefault("--mode", "full")
    if mode == "os-absent":
        AssertExclusiveAbsentInstall(parent)
        echo("ATOMIC_TREE_OS_ABSENT_OK")
        return 0
    if mode == "os-opened":
        AssertExclusiveOpened(parent)
        echo("ATOMIC_TREE_OS_OPENED_OK")
        return 0
    if mode == "os-invalid":
        AssertExclusiveInvalid(parent)
        echo("ATOMIC_TREE_OS_INVALID_OK")
        return 0
    if mode == "lease-holder":
        AssertLeaseHolder(parent)
        return 0
    if mode == "lease-contender":
        AssertLeaseContender(parent)
        return 0
    if mode == "lease-crash-release":
        AssertLeaseCrashRelease(parent)
        return 0
    if mode == "reject-parent":
        AssertRejectParent(parent)
        echo("ATOMIC_TREE_REJECT_PARENT_OK")
        return 0
    if mode == "reject-final":
        AssertRejectFinal(parent)
        echo("ATOMIC_TREE_REJECT_FINAL_OK")
        return 0
    if mode == "reject-intermediate":
        AssertRejectIntermediate(parent)
        echo("ATOMIC_TREE_REJECT_INTERMEDIATE_OK")
        return 0
    if mode == "reject-leaf-exact":
        AssertRejectLeafExact(parent)
        echo("ATOMIC_TREE_REJECT_LEAF_EXACT_OK")
        return 0
    assert(mode == "full", "atomic tree smoke: unknown mode")
    AssertPrimaryInstall(share(parent))
    AssertVerifiedOpen(share(parent))
    AssertVerifiedSameInodeRewriteRejected(share(parent))
    AssertDestinationExistsAndAbort(share(parent))
    AssertAbort(share(parent))
    AssertExactTreeAttacks(share(parent))
    AssertPartialInstallRejected(share(parent))
    AssertTamperedContentRejected(share(parent))
    AssertAbortResidual(parent)
    echo("ATOMIC_TREE_RUNTIME_OK")
    return 0
