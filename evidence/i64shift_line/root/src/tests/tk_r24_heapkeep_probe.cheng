import std/strutils as strutil

fn R24Join(a: str, b: str): str =
    var parts: str[]
    add(parts, a)
    add(parts, b)
    return strutil.Join(parts, "")

fn R24Tag(raw: str): str =
    if raw.len > 3:
        return R24Join("lo", "ng")
    return R24Join("sho", "rt")

fn R24HeapKeep(lineRaw: str, genericPos: int32): int32 =
    let keep = R24Join("keep-", lineRaw)
    let headRaw = R24Join("head-", lineRaw)
    var head: str
    if genericPos > 0:
        head = R24Tag(headRaw)
    else:
        head = headRaw
    if keep != "keep-abcdef":
        return 700
    if keep.len != 11:
        return 701
    return head.len * 10 + keep.len

fn main(): int32 =
    let a = R24HeapKeep("abcdef", 1)
    if a != 51:
        return 10
    let b = R24HeapKeep("abcdef", 0)
    if b != 121:
        return 11
    echo("r24 heapkeep ok a=51 b=121")
    return 0
