fn main(): int32 =
    let base: uint64 = uint64(1) << 32
    let tgt: uint64 = base + uint64(602112)
    let src: uint64 = base + uint64(2436)
    let delta: int64 = int64(tgt >> 12) - int64(src >> 12)
    if delta < -(int64(1) << 20):
        return 11
    if delta >= (int64(1) << 20):
        return 22
    if delta != 147:
        return 33
    return 0
