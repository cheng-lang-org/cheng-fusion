@exportc("repro_looks_safe_dec")
fn repro_looks_safe_dec(stream: ptr): bool =
    if stream == nil:
        return false
    return uint64(stream) >= uint64(4294967296)

@exportc("repro_looks_safe_hex")
fn repro_looks_safe_hex(stream: ptr): bool =
    if stream == nil:
        return false
    return uint64(stream) >= uint64(0x100000000)

fn main(): int32 =
    return 0
