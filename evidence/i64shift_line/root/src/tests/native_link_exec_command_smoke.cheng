import std/os
import std/strings
import std/os_host_process as hostos
import cheng/core/tooling/compiler_request as creq
import cheng/core/tooling/path as chengpath
import cheng/core/backend/native_link_exec as nlexec
import cheng/core/backend/native_link_plan as nplan
import cheng/core/backend/object_plan as oplan
import cheng/core/backend/system_link_plan as slplan
import cheng/core/backend/target_matrix as tmat
import std/strutils as strutil

fn expectArgv(actual: str[], expected: str[], label: str) =
    assert(actual.len == expected.len, strutil.Join([label, " len"], ""))
    var i: int32
    for i in i..<expected.len:
        assert(actual[i] == expected[i], strutil.Join([label, " item[", IntToStr(i), "]"], ""))

fn buildPlan(targetTriple: str,
               emitKind: creq.CompilerEmit,
               outputKind: nplan.NativeOutputKind,
               linkerProgram: str,
               linkerFlavor: str,
               outputPath: str,
               input0: str,
               input1: str): nplan.NativeLinkPlanStub =
    var plan: nplan.NativeLinkPlanStub
    plan.targetTriple = targetTriple
    plan.emitKind = emitKind
    plan.outputPath = outputPath
    plan.objectFormat = tmat.TargetPrimaryObjectFormat(targetTriple)
    plan.linkerProgram = linkerProgram
    plan.linkerFlavor = linkerFlavor
    plan.outputKind = outputKind
    plan.entrySymbol = "main"
    plan.primaryObjectPath = input0
    plan.browserBridgeObjectPath = ""
    plan.linkInputPaths = [input0, input1]
    plan.missingReasons = []
    plan.pipelineStage = "object_plan_to_native_link_plan"
    return plan

fn buildNativePlanFromTarget(targetTriple: str,
                             emitKind: creq.CompilerEmit,
                             outputKind: nplan.NativeOutputKind,
                             outputPath: str,
                             input0: str,
                             input1: str): nplan.NativeLinkPlanStub =
    var linkPlan: slplan.SystemLinkPlanStub
    linkPlan.targetTriple = targetTriple
    linkPlan.emitKind = emitKind
    linkPlan.outputPath = outputPath
    linkPlan.entrySymbol = "main"
    linkPlan.missingReasons = []
    var objectPlan: oplan.ObjectPlanStub
    objectPlan.targetTriple = targetTriple
    objectPlan.outputPath = outputPath
    objectPlan.primaryObjectPath = input0
    objectPlan.linkInputPaths = [input0, input1]
    objectPlan.missingReasons = []
    let nativePlan = nplan.BuildNativeLinkPlan(linkPlan, objectPlan)
    assert(nativePlan.outputKind == outputKind, " native link exec smoke: target output kind")
    return nativePlan

fn main(): int32 =
    let root = os.GetCurrentDir()
    let outDir = chengpath.PathAbsolute(root, "artifacts/native_link_exec_command_smoke")
    assert(chengpath.MkdirP(root, outDir), " native link exec smoke: mkdir")

    let input0 = os.JoinPath(root, "src/core/backend/native_link_exec.cheng")
    let input1 = os.JoinPath(root, "src/core/backend/target_matrix.cheng")
    let exeOut = os.JoinPath(outDir, "native-link-exe")
    let sharedOut = os.JoinPath(outDir, "native-link-shared.dylib")
    if chengpath.PathFileExists(exeOut):
        os.RemoveFile(exeOut)
    if chengpath.PathFileExists(sharedOut):
        os.RemoveFile(sharedOut)

    let exePlan = buildPlan("arm64-apple-darwin",
                             creq.EmitExe,
                             nplan.NativeOutputExecutable,
                             "cc",
                             "ld64",
                             exeOut,
                             input0,
                             input1)
    let exeArgvRes = nlexec.NativeLinkExecArgv(exePlan)
    assert(IsOk(exeArgvRes), " native link exec smoke: exe argv ok")
    let exeArgv = Value(exeArgvRes)
    expectArgv(exeArgv,
               [
                   "-arch",
                   "arm64",
                   input0,
                   input1,
                   "-o",
                   exeOut
               ],
               " native link exec smoke: exe argv")
    let exeCommandTextRes = nlexec.NativeLinkExecCommandText(exePlan)
    assert(IsOk(exeCommandTextRes), " native link exec smoke: exe command text ok")
    let exeCommandText = Value(exeCommandTextRes)
    let exeExpectedCommandText = hostos.OsHostProcessCommandText("cc", exeArgv, [])
    assert(exeCommandText == exeExpectedCommandText,
           " native link exec smoke: exe command text")
    assert(strings.StrContains(exeCommandText, "'-arch'"),
           " native link exec smoke: exe arch text")
    assert(!strings.StrContains(exeCommandText, "-dynamiclib"),
           " native link exec smoke: exe no shared flag")

    let sharedPlan = buildPlan("arm64-apple-darwin",
                               creq.EmitShared,
                               nplan.NativeOutputArtifact,
                               "cc",
                               "ld64",
                               sharedOut,
                               input0,
                               input1)
    let sharedArgvRes = nlexec.NativeLinkExecArgv(sharedPlan)
    assert(IsOk(sharedArgvRes), " native link exec smoke: shared argv ok")
    let sharedArgv = Value(sharedArgvRes)
    expectArgv(sharedArgv,
               [
                   "-dynamiclib",
                   "-arch",
                   "arm64",
                   input0,
                   input1,
                   "-o",
                   sharedOut
               ],
               " native link exec smoke: shared argv")
    let sharedCommandTextRes = nlexec.NativeLinkExecCommandText(sharedPlan)
    assert(IsOk(sharedCommandTextRes), " native link exec smoke: shared command text ok")
    let sharedCommandText = Value(sharedCommandTextRes)
    let sharedExpectedCommandText = hostos.OsHostProcessCommandText("cc", sharedArgv, [])
    assert(sharedCommandText == sharedExpectedCommandText,
           " native link exec smoke: shared command text")
    assert(strings.StrContains(sharedCommandText, "'-dynamiclib'"),
           " native link exec smoke: shared dynamiclib text")

    let linuxExeOut = os.JoinPath(outDir, "native-link-linux-aarch64")
    let linuxExePlan = buildPlan("aarch64-unknown-linux-gnu",
                                 creq.EmitExe,
                                 nplan.NativeOutputExecutable,
                                 "aarch64-linux-gnu-cc",
                                 "system_linker",
                                 linuxExeOut,
                                 input0,
                                 input1)
    let linuxExeArgvRes = nlexec.NativeLinkExecArgv(linuxExePlan)
    assert(IsOk(linuxExeArgvRes), " native link exec smoke: linux aarch64 exe argv ok")
    let linuxExeArgv = Value(linuxExeArgvRes)
    expectArgv(linuxExeArgv,
               [
                   input0,
                   input1,
                   "-o",
                   linuxExeOut
               ],
               " native link exec smoke: linux aarch64 exe argv")
    let linuxExeCommandTextRes = nlexec.NativeLinkExecCommandText(linuxExePlan)
    assert(IsOk(linuxExeCommandTextRes),
           " native link exec smoke: linux aarch64 exe command text ok")
    let linuxExeCommandText = Value(linuxExeCommandTextRes)
    assert(!strings.StrContains(linuxExeCommandText, "-dynamiclib"),
           " native link exec smoke: linux aarch64 exe no dynamiclib")
    assert(!strings.StrContains(linuxExeCommandText, "'-arch'"),
           " native link exec smoke: linux aarch64 exe no darwin arch")

    let linuxSharedOut = os.JoinPath(outDir, "libnative-link-linux-aarch64.so")
    let linuxSharedPlan = buildPlan("aarch64-unknown-linux-gnu",
                                    creq.EmitShared,
                                    nplan.NativeOutputArtifact,
                                    "aarch64-linux-gnu-cc",
                                    "system_linker",
                                    linuxSharedOut,
                                    input0,
                                    input1)
    let linuxSharedArgvRes = nlexec.NativeLinkExecArgv(linuxSharedPlan)
    assert(IsOk(linuxSharedArgvRes), " native link exec smoke: linux aarch64 shared argv ok")
    let linuxSharedArgv = Value(linuxSharedArgvRes)
    expectArgv(linuxSharedArgv,
               [
                   "-shared",
                   "-fPIC",
                   input0,
                   input1,
                   "-o",
                   linuxSharedOut
               ],
               " native link exec smoke: linux aarch64 shared argv")
    let linuxSharedCommandTextRes = nlexec.NativeLinkExecCommandText(linuxSharedPlan)
    assert(IsOk(linuxSharedCommandTextRes),
           " native link exec smoke: linux aarch64 shared command text ok")
    let linuxSharedCommandText = Value(linuxSharedCommandTextRes)
    assert(strings.StrContains(linuxSharedCommandText, "'-shared'"),
           " native link exec smoke: linux aarch64 shared flag")
    assert(strings.StrContains(linuxSharedCommandText, "'-fPIC'"),
           " native link exec smoke: linux aarch64 fpic flag")
    assert(!strings.StrContains(linuxSharedCommandText, "-dynamiclib"),
           " native link exec smoke: linux aarch64 no darwin dynamiclib")
    assert(!strings.StrContains(linuxSharedCommandText, "'-arch'"),
           " native link exec smoke: linux aarch64 no darwin arch")

    let androidSharedOut = os.JoinPath(outDir, "libnative-link-android.so")
    let androidSharedPlan = buildPlan("aarch64-linux-android",
                                      creq.EmitShared,
                                      nplan.NativeOutputArtifact,
                                      "aarch64-linux-android21-clang",
                                      "system_linker",
                                      androidSharedOut,
                                      input0,
                                      input1)
    let androidSharedArgvRes = nlexec.NativeLinkExecArgv(androidSharedPlan)
    assert(IsOk(androidSharedArgvRes), " native link exec smoke: android shared argv ok")
    let androidSharedArgv = Value(androidSharedArgvRes)
    expectArgv(androidSharedArgv,
               [
                   "-shared",
                   "-fPIC",
                   input0,
                   input1,
                   "-Wl,--no-undefined",
                   strutil.Join(["-Wl,-soname,", androidSharedOut], ""),
                   "-ldl",
                   "-lm",
                   "-o",
                   androidSharedOut
               ],
               " native link exec smoke: android shared argv")
    let androidSharedCommandTextRes = nlexec.NativeLinkExecCommandText(androidSharedPlan)
    assert(IsOk(androidSharedCommandTextRes), " native link exec smoke: android shared command text ok")
    let androidSharedCommandText = Value(androidSharedCommandTextRes)
    assert(strings.StrContains(androidSharedCommandText, "'-shared'"),
           " native link exec smoke: android shared flag")
    assert(strings.StrContains(androidSharedCommandText, "'-Wl,--no-undefined'"),
           " native link exec smoke: android no undefined flag")
    assert(!strings.StrContains(androidSharedCommandText, "-dynamiclib"),
           " native link exec smoke: android no darwin dynamiclib")
    assert(!strings.StrContains(androidSharedCommandText, "'-arch'"),
           " native link exec smoke: android no darwin arch")

    let ohosSharedOut = os.JoinPath(outDir, "libnative-link-ohos.so")
    let ohosSharedPlan = buildPlan("aarch64-linux-ohos",
                                   creq.EmitShared,
                                   nplan.NativeOutputArtifact,
                                   "aarch64-unknown-linux-ohos-clang",
                                   "system_linker",
                                   ohosSharedOut,
                                   input0,
                                   input1)
    let ohosSharedArgvRes = nlexec.NativeLinkExecArgv(ohosSharedPlan)
    assert(IsOk(ohosSharedArgvRes), " native link exec smoke: ohos shared argv ok")
    let ohosSharedArgv = Value(ohosSharedArgvRes)
    expectArgv(ohosSharedArgv,
               [
                   "-shared",
                   "-fPIC",
                   input0,
                   input1,
                   "-Wl,--no-undefined",
                   strutil.Join(["-Wl,-soname,", ohosSharedOut], ""),
                   "-ldl",
                   "-lm",
                   "-o",
                   ohosSharedOut
               ],
               " native link exec smoke: ohos shared argv")
    let ohosSharedCommandTextRes = nlexec.NativeLinkExecCommandText(ohosSharedPlan)
    assert(IsOk(ohosSharedCommandTextRes), " native link exec smoke: ohos shared command text ok")
    let ohosSharedCommandText = Value(ohosSharedCommandTextRes)
    assert(strings.StrContains(ohosSharedCommandText, "'-shared'"),
           " native link exec smoke: ohos shared flag")
    assert(strings.StrContains(ohosSharedCommandText, "'-Wl,--no-undefined'"),
           " native link exec smoke: ohos no undefined flag")
    assert(!strings.StrContains(ohosSharedCommandText, "-dynamiclib"),
           " native link exec smoke: ohos no darwin dynamiclib")
    assert(!strings.StrContains(ohosSharedCommandText, "'-arch'"),
           " native link exec smoke: ohos no darwin arch")

    assert(tmat.TargetLinkerProgram("aarch64-linux-android") == "android_aarch64_clang",
           " native link exec smoke: android matrix linker token")
    assert(tmat.TargetLinkerProgram("aarch64-linux-ohos") == "ohos_aarch64_clang",
           " native link exec smoke: ohos matrix linker token")
    assert(tmat.TargetLinkerProgram("aarch64-unknown-linux-ohos") == "ohos_aarch64_clang",
           " native link exec smoke: ohos alias matrix linker token")

    let prodAndroidPlan = buildNativePlanFromTarget("aarch64-linux-android",
                                                    creq.EmitShared,
                                                    nplan.NativeOutputArtifact,
                                                    androidSharedOut,
                                                    input0,
                                                    input1)
    assert(prodAndroidPlan.linkerProgram == "android_aarch64_clang",
           " native link exec smoke: production android linker token")
    let prodAndroidTextRes = nlexec.NativeLinkExecCommandText(prodAndroidPlan)
    if IsOk(prodAndroidTextRes):
        let prodAndroidText = Value(prodAndroidTextRes)
        assert(!strings.StrContains(prodAndroidText, "'cc'"),
               " native link exec smoke: production android no bare cc")
        assert(strings.StrContains(prodAndroidText, "'-shared'"),
               " native link exec smoke: production android shared text")
    else:
        assert(strings.StrContains(Error(prodAndroidTextRes), "missing Android AArch64 clang"),
               " native link exec smoke: production android missing clang hard fail")

    let ohosAliasSharedOut = os.JoinPath(outDir, "libnative-link-ohos-alias.so")
    let prodOhosAliasPlan = buildNativePlanFromTarget("aarch64-unknown-linux-ohos",
                                                      creq.EmitShared,
                                                      nplan.NativeOutputArtifact,
                                                      ohosAliasSharedOut,
                                                      input0,
                                                      input1)
    assert(prodOhosAliasPlan.linkerProgram == "ohos_aarch64_clang",
           " native link exec smoke: production ohos alias linker token")
    let prodOhosAliasTextRes = nlexec.NativeLinkExecCommandText(prodOhosAliasPlan)
    if IsOk(prodOhosAliasTextRes):
        let prodOhosAliasText = Value(prodOhosAliasTextRes)
        assert(!strings.StrContains(prodOhosAliasText, "'cc'"),
               " native link exec smoke: production ohos alias no bare cc")
        assert(strings.StrContains(prodOhosAliasText, "'-shared'"),
               " native link exec smoke: production ohos alias shared text")
    else:
        assert(strings.StrContains(Error(prodOhosAliasTextRes), "missing OHOS AArch64 clang"),
               " native link exec smoke: production ohos alias missing clang hard fail")

    let androidExeOut = os.JoinPath(outDir, "native-link-android-exe")
    let androidExePlan = buildNativePlanFromTarget("aarch64-linux-android",
                                                   creq.EmitExe,
                                                   nplan.NativeOutputExecutable,
                                                   androidExeOut,
                                                   input0,
                                                   input1)
    let androidExeArgvRes = nlexec.NativeLinkExecArgv(androidExePlan)
    assert(!IsOk(androidExeArgvRes),
           " native link exec smoke: production android exe rejected")
    assert(strings.StrContains(Error(androidExeArgvRes), "unsupported mobile output mode"),
           " native link exec smoke: production android exe rejection message")

    let missingInput = os.JoinPath(outDir, "missing-input.o")
    let missingRunLog = os.JoinPath(outDir, "missing-input-run.log")
    let missingInputPlan = buildPlan("aarch64-linux-android",
                                     creq.EmitShared,
                                     nplan.NativeOutputArtifact,
                                     "aarch64-linux-android21-clang",
                                     "system_linker",
                                     androidSharedOut,
                                     missingInput,
                                     input1)
    let missingRun = nlexec.NativeLinkExecRunLogged(root,
                                                    "missing-mobile-input",
                                                    missingInputPlan,
                                                    missingRunLog)
    assert(missingRun.exitCode != 0,
           " native link exec smoke: missing input hard fails before run")
    assert(strings.StrContains(missingRun.output, "missing input file"),
           " native link exec smoke: missing input error")
    assert(!strings.StrContains(missingRun.output, "aarch64-linux-android21-clang"),
           " native link exec smoke: missing input does not execute linker")

    let badTargetPlan = buildPlan("x86_64-apple-darwin",
                                  creq.EmitExe,
                                  nplan.NativeOutputExecutable,
                                  "cc",
                                  "ld64",
                                  exeOut,
                                  input0,
                                  input1)
    let badTargetRes = nlexec.NativeLinkExecArgv(badTargetPlan)
    assert(!IsOk(badTargetRes), " native link exec smoke: unsupported target rejected")
    assert(strings.StrContains(Error(badTargetRes), "unsupported target"),
           " native link exec smoke: unsupported target message")

    echo(" native_link_exec_command_smoke ok")
    return 0
