fn R13PhaseNamesLocal(): str[] =
    var names: str[] = ["system_link_plan",
                        "compiler_csg",
                        "lowering_plan"]
    return names

fn main(): int32 =
    let names = R13PhaseNamesLocal()
    if names.len != 3:
        return 10
    echo("r13_seqliteral_local ok")
    return 0
