import cheng/core/ir/core_types as ir

fn ProbeAddI32Slot(bodyIR: var ir.BodyIR,
                   name: str,
                   applyProof: bool): int32 =
    var slot: ir.LocalSlot
    slot.id = bodyIR.localSlots.len
    slot.name = name
    slot.typeKind = ir.LocalI32Tag
    slot.stackOffset = 16 + slot.id * 8
    slot.sizeBytes = 4
    slot.alignBytes = 4
    if applyProof:
        ir.BodyIRApplyLocalSlotDefaultProof(slot)
    else:
        slot.noAlias = true
    add(bodyIR.localSlots, slot)
    return slot.id

fn ProbeAppendLoad(bodyIR: var ir.BodyIR,
                   target: int32,
                   source: int32) =
    var op: ir.BodyOp
    op.kind = ir.BodyOpLoadLocalTag
    op.target = target
    add(op.operands, source)
    add(bodyIR.ops, op)
    return

fn ProbeAppendCopy(bodyIR: var ir.BodyIR,
                   target: int32,
                   source: int32) =
    var op: ir.BodyOp
    op.kind = ir.BodyOpCopyLocalTag
    op.target = target
    add(op.operands, source)
    add(bodyIR.ops, op)
    return

fn ProbeForwardBody(applyProof: bool): ir.BodyIR =
    var bodyIR = ir.BodyIRNew()
    let a = ProbeAddI32Slot(bodyIR, "a", applyProof)
    let b = ProbeAddI32Slot(bodyIR, "b", applyProof)
    let c = ProbeAddI32Slot(bodyIR, "c", applyProof)
    ProbeAppendLoad(bodyIR, b, a)
    ProbeAppendCopy(bodyIR, c, b)
    var term: ir.BodyTerm
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = c
    let termIndex = ir.BodyIRAppendTerm(bodyIR, term)
    let _ = ir.BodyIRAppendBlock(bodyIR, 0, 2, termIndex)
    return bodyIR
