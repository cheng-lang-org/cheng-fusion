           Value(hfDeviceLoadReceipt).deviceBufferLogicalHash == Value(hfPayloadReceipt).rawPayloadByteHash &&
           Value(hfDeviceLoadReceipt).sourceRangeHash == Value(hfPayloadReceipt).rawPayloadByteHash &&
           Value(hfDeviceLoadReceipt).receiptHash == dev.DeviceFileRangeBufferLoadReceiptHash(Value(hfDeviceLoadReceipt)),
