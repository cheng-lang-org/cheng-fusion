           " weight safetensors manifest smoke: hf device page binding dtype hard fail")
    var hfBadDevicePageTable = Value(hfDevicePageTable)
    hfBadDevicePageTable.pages[0].sourceRangeHash = hfBadDevicePageTable.pages[0].sourceRangeHash + int64(1)
    hfBadDevicePageTable.pages[0].pageHash = dev.DeviceFileRangePageHash(hfBadDevicePageTable.pages[0])
    hfBadDevicePageTable.pageAggregateHash = dev.DeviceFileRangePageAggregateHash(hfBadDevicePageTable.pages)
    hfBadDevicePageTable.receiptHash = dev.DeviceFileRangePageTableReceiptHash(hfBadDevicePageTable)
