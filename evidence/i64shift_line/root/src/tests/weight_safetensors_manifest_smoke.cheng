    let w4KernelPageTables = ws.WeightSafetensorsBuildDevicePageTablesFromPayloadPreflight(
        w4KernelIndex,
        w4KernelGraph,
        Value(w4KernelPreflight),
        w4KernelDevice,
        int64(2)
