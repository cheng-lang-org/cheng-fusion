import std/result
import std/os
import std/rawbytes
import std/strings
import std/strutils as strutil
import cheng/inference/kernel as infer
import cheng/inference/kernel_ir as kir
import cheng/inference/model_graph as mg
import cheng/inference/model_executor as exec
import cheng/inference/device as dev
import cheng/inference/weight_store as ws

const
    SafetensorsValid = 0
    SafetensorsDtypeDrift = 1
    SafetensorsShapeDrift = 2
    SafetensorsByteCountDrift = 3
    SafetensorsMissingTensor = 4
    SafetensorsOverlap = 5
    HfIndexValid = 0
    HfIndexMissingTensor = 1
    HfIndexPathTraversal = 2
    HfIndexAbsolutePath = 3
    HfIndexBadSuffix = 4

fn writeU64LE(buf: var rawbytes.Bytes, offset: int32, value: int64) =
    rawbytes.BytesSet(buf, offset, int32(value & int64(255)))
    rawbytes.BytesSet(buf, offset + 1, int32((value >> 8) & int64(255)))
    rawbytes.BytesSet(buf, offset + 2, int32((value >> 16) & int64(255)))
    rawbytes.BytesSet(buf, offset + 3, int32((value >> 24) & int64(255)))
    rawbytes.BytesSet(buf, offset + 4, int32((value >> 32) & int64(255)))
    rawbytes.BytesSet(buf, offset + 5, int32((value >> 40) & int64(255)))
    rawbytes.BytesSet(buf, offset + 6, int32((value >> 48) & int64(255)))
    rawbytes.BytesSet(buf, offset + 7, int32((value >> 56) & int64(255)))

fn safetensorsDtype(dtype: str, drift: bool): str =
    if drift:
        return "BF16"
    if dtype == "fp16":
        return "F16"
    if dtype == "bf16":
        return "BF16"
    if dtype == "fp8_e4m3":
        return "F8_E4M3"
    if dtype == "int8":
        return "I8"
    if dtype == "int4":
        return "U8"
    return "UNSUPPORTED"

fn safetensorsShapeJson(shape: int32[], drift: bool): str =
    var parts: str[]
    for i in 0..<shape.len:
        var dim = shape[i]
        if drift && i == 0:
            dim = dim + 1
        add(parts, strings.IntToStr(dim))
    return strutil.Join(["[", strutil.Join(parts, ","), "]"], "")

fn safetensorsTotalDataBytes(graph: mg.ModelGraph): int64 =
    var total: int64
    for i in 0..<graph.weights.len:
        total = total + graph.weights[i].sizeBytes
    return total

fn safetensorsHeader(graph: mg.ModelGraph, mode: int32): str =
    var parts: str[]
    var cursor: int64
    for i in 0..<graph.weights.len:
        if mode == SafetensorsMissingTensor && i == graph.weights.len - 1:
            continue
        var start = cursor
        var end = cursor + graph.weights[i].sizeBytes
        if mode == SafetensorsOverlap && i == 1:
            start = int64(0)
            end = graph.weights[i].sizeBytes
        if mode == SafetensorsByteCountDrift && i == 0:
            end = end + int64(1)
        let dtypeText = safetensorsDtype(graph.weights[i].dtype, mode == SafetensorsDtypeDrift && i == 0)
        let shapeText = safetensorsShapeJson(graph.weights[i].shape, mode == SafetensorsShapeDrift && i == 0)
        add(parts, strutil.Join([
            "\"",
            graph.weights[i].tensorName,
            "\":{\"dtype\":\"",
            dtypeText,
            "\",\"shape\":",
            shapeText,
            ",\"data_offsets\":[",
            strings.Int64ToStr(start),
            ",",
            strings.Int64ToStr(end),
            "]}"
        ], ""))
        cursor = cursor + graph.weights[i].sizeBytes
    return strutil.Join(["{", strutil.Join(parts, ","), "}"], "")

fn safetensorsBytesFromHeader(header: str, dataBytes: int32): rawbytes.Bytes =
    let headerBytes = rawbytes.BytesFromString(header)
    let outLen = 8 + rawbytes.BytesLen(headerBytes) + dataBytes
    var out = rawbytes.BytesAlloc(outLen)
    writeU64LE(out, 0, int64(rawbytes.BytesLen(headerBytes)))
    rawbytes.BytesCopyInto(out, 8, headerBytes)
    let dataBase = 8 + rawbytes.BytesLen(headerBytes)
    for i in 0..<dataBytes:
        rawbytes.BytesSet(out, dataBase + i, (i * 17 + 3) & 255)
    return out

fn safetensorsBytes(graph: mg.ModelGraph, mode: int32): rawbytes.Bytes =
    let header = safetensorsHeader(graph, mode)
    return safetensorsBytesFromHeader(header, int32(safetensorsTotalDataBytes(graph)))

fn writeF16LE(buf: var rawbytes.Bytes, offset: int32, raw: int32) =
    rawbytes.BytesSet(buf, offset, raw & 255)
    rawbytes.BytesSet(buf, offset + 1, (raw >> 8) & 255)

fn safetensorsF16RawAt(elementIndex: int32): int32 =
    let slot = elementIndex % 6
    if slot == 0:
        return 0x3c00
    if slot == 1:
        return 0xbc00
    if slot == 2:
        return 0x3800
    if slot == 3:
        return 0x0000
    if slot == 4:
        return 0x4000
    return 0xc000

fn safetensorsNumericBytes(graph: mg.ModelGraph): rawbytes.Bytes =
    let header = safetensorsHeader(graph, SafetensorsValid)
    let headerBytes = rawbytes.BytesFromString(header)
    let totalData = int32(safetensorsTotalDataBytes(graph))
    let outLen = 8 + rawbytes.BytesLen(headerBytes) + totalData
    var out = rawbytes.BytesAlloc(outLen)
    writeU64LE(out, 0, int64(rawbytes.BytesLen(headerBytes)))
    rawbytes.BytesCopyInto(out, 8, headerBytes)
    let dataBase = 8 + rawbytes.BytesLen(headerBytes)
    var cursor: int32
    var elementOrdinal: int32
    for i in 0..<graph.weights.len:
        let tensorBytes = int32(graph.weights[i].sizeBytes)
        var j: int32
        while j < tensorBytes:
            writeF16LE(out, dataBase + cursor + j, safetensorsF16RawAt(elementOrdinal))
            j = j + 2
            elementOrdinal = elementOrdinal + 1
        cursor = cursor + tensorBytes
    return out

fn safetensorsElementStart(graph: mg.ModelGraph, weightStart: int32): int32 =
    var total: int32
    for i in 0..<weightStart:
        total = total + int32(graph.weights[i].sizeBytes / int64(2))
    return total

fn safetensorsHeaderRange(graph: mg.ModelGraph, weightStart: int32, weightEnd: int32): str =
    var parts: str[]
    var cursor: int64
    for i in weightStart..<weightEnd:
        let start = cursor
        let end = cursor + graph.weights[i].sizeBytes
        let dtypeText = safetensorsDtype(graph.weights[i].dtype, false)
        let shapeText = safetensorsShapeJson(graph.weights[i].shape, false)
        add(parts, strutil.Join([
            "\"",
            graph.weights[i].tensorName,
            "\":{\"dtype\":\"",
            dtypeText,
            "\",\"shape\":",
            shapeText,
            ",\"data_offsets\":[",
            strings.Int64ToStr(start),
            ",",
            strings.Int64ToStr(end),
            "]}"
        ], ""))
        cursor = cursor + graph.weights[i].sizeBytes
    return strutil.Join(["{", strutil.Join(parts, ","), "}"], "")

fn safetensorsNumericBytesRange(graph: mg.ModelGraph, weightStart: int32, weightEnd: int32): rawbytes.Bytes =
    let header = safetensorsHeaderRange(graph, weightStart, weightEnd)
    let headerBytes = rawbytes.BytesFromString(header)
    var totalData: int32
    for i in weightStart..<weightEnd:
        totalData = totalData + int32(graph.weights[i].sizeBytes)
    let outLen = 8 + rawbytes.BytesLen(headerBytes) + totalData
    var out = rawbytes.BytesAlloc(outLen)
    writeU64LE(out, 0, int64(rawbytes.BytesLen(headerBytes)))
    rawbytes.BytesCopyInto(out, 8, headerBytes)
    let dataBase = 8 + rawbytes.BytesLen(headerBytes)
    var cursor: int32
    var elementOrdinal = safetensorsElementStart(graph, weightStart)
    for i in weightStart..<weightEnd:
        let tensorBytes = int32(graph.weights[i].sizeBytes)
        var j: int32
        while j < tensorBytes:
            writeF16LE(out, dataBase + cursor + j, safetensorsF16RawAt(elementOrdinal))
            j = j + 2
            elementOrdinal = elementOrdinal + 1
        cursor = cursor + tensorBytes
    return out

fn safetensorsQuantFixtureGraph(modelCid: str,
                                dtype: str,
                                quantScheme: str,
                                tensorQuantScheme: str): mg.ModelGraph =
    var sizeBytes: int64 = int64(4)
    if dtype == kir.KernelDtypeFp16 || dtype == kir.KernelDtypeBf16:
        sizeBytes = int64(8)
    if dtype == kir.KernelDtypeInt4:
        sizeBytes = int64(2)
    let tensors = [
        mg.ModelTensorDesc(name: "quant_hidden", dtype: kir.KernelDtypeFp16, shape: [1, 4], quantScheme: tensorQuantScheme)
    ]
    let weights = [
        mg.ModelWeightShard(modelCid: modelCid, shardCid: "cid:quant:int8", tensorName: "quant.weight", dtype: dtype, quantScheme: quantScheme, shape: [4], sizeBytes: sizeBytes, expectedPayloadHash: int64(0))
    ]
    let ops = [
        mg.ModelGraphOp(opKind: mg.InferenceModelOpMlp, inputNames: ["quant_hidden"], outputName: "quant_out", weightNames: ["quant.weight"], layerIndex: 0, expertId: -1)
    ]
    var graph = mg.ModelGraph(
        schema: mg.InferenceModelGraphSchema,
        modelCid: modelCid,
        architecture: "int8_quant_fixture",
        hiddenSize: 4,
        attentionHeads: 1,
        keyValueHeads: 1,
        headDim: 4,
        layerCount: 1,
        expertCount: 1,
        topK: 1,
        ropeTheta: 10000.0,
        tensors: tensors,
        weights: weights,
        ops: ops,
        graphHash: int64(0)
    )
    graph.graphHash = mg.ModelGraphHash(graph)
    return graph

