    assert(Value(hfDeviceRangeBinding).schema == "cheng.inference.weight_safetensors_device_range_binding.v1" &&
           Value(hfDeviceRangeBinding).payloadReceiptHash == Value(hfPayloadReceipt).receiptHash &&
           Value(hfDeviceRangeBinding).deviceCapabilityHash == hfDeviceCapabilityHash &&
           Value(hfDeviceRangeBinding).deviceBufferSizeBytes == Value(hfPayloadReceipt).byteCount &&
           Value(hfDeviceRangeBinding).deviceBufferLogicalHash == Value(hfPayloadReceipt).rawPayloadByteHash &&
           Value(hfDeviceRangeBinding).bindingHash == ws.WeightSafetensorsDeviceRangeBindingHash(Value(hfDeviceRangeBinding)),
           " weight safetensors manifest smoke: hf device range binding facts")
    assert(IsOk(ws.WeightSafetensorsValidateDeviceRangeBinding(hfIndex, graph, 0, Value(hfDeviceRangeBinding))),
           " weight safetensors manifest smoke: hf device range binding validate")
    let hfDeviceRangeBindingDirect = ws.WeightSafetensorsBuildDeviceRangeBinding(
        hfIndex,
        graph,
        0,
        3,
        hfDeviceCapabilityHash,
        Value(hfPayloadReceipt).byteCount,
        Value(hfPayloadReceipt).dtype,
        Value(hfPayloadReceipt).rawPayloadByteHash
    )
    assert(IsOk(hfDeviceRangeBindingDirect) &&
           Value(hfDeviceRangeBindingDirect).bindingHash == Value(hfDeviceRangeBinding).bindingHash,
           " weight safetensors manifest smoke: hf device range binding direct")
    let hfDevicePageBinding = ws.WeightSafetensorsBuildDevicePageBindingFromReceipt(
        hfIndex,
        graph,
        0,
        Value(hfPayloadReceipt),
        Value(hfDevicePageTable),
