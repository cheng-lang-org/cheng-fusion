        )
        assert(IsOk(pageTable), " weight safetensors manifest smoke: hf device page table set item")
        add(hfDevicePageTables, Value(pageTable))
    let hfDevicePageBindingChunk5 = ws.WeightSafetensorsBuildDevicePageBinding(
