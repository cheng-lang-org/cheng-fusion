    assert(Value(hfDevicePageBinding).schema == "cheng.inference.weight_safetensors_device_page_binding.v1" &&
           Value(hfDevicePageBinding).payloadReceiptHash == Value(hfPayloadReceipt).receiptHash &&
           Value(hfDevicePageBinding).deviceCapabilityHash == hfDeviceCapabilityHash &&
           Value(hfDevicePageBinding).pageAggregateHash == Value(hfDevicePageTable).pageAggregateHash &&
           Value(hfDevicePageBinding).pageTableReceiptHash == Value(hfDevicePageTable).receiptHash &&
           Value(hfDevicePageBinding).bindingHash == ws.WeightSafetensorsDevicePageBindingHash(Value(hfDevicePageBinding)),
           " weight safetensors manifest smoke: hf device page binding facts")
    assert(IsOk(ws.WeightSafetensorsValidateDevicePageBinding(
