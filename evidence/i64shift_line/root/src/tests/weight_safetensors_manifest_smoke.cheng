    )
    assert(IsOk(hfDeviceRangeBindingChunk5),
           " weight safetensors manifest smoke: hf device range binding chunk5")
    var hfDevicePageTables: dev.DeviceFileRangePageTableReceipt[]
    for i in 0..<Value(hfPayloadPreflight).tensorReceipts.len:
        let receipt = Value(hfPayloadPreflight).tensorReceipts[i]
        let pageTable = dev.DeviceBuildFileRangePageTableReceipt(
