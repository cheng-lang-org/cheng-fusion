fn safetensorsInt8QuantBytes(graph: mg.ModelGraph): rawbytes.Bytes =
    let header = safetensorsHeader(graph, SafetensorsValid)
    let headerBytes = rawbytes.BytesFromString(header)
    let outLen = 8 + rawbytes.BytesLen(headerBytes) + int32(safetensorsTotalDataBytes(graph))
    var out = rawbytes.BytesAlloc(outLen)
    writeU64LE(out, 0, int64(rawbytes.BytesLen(headerBytes)))
    rawbytes.BytesCopyInto(out, 8, headerBytes)
    let dataBase = 8 + rawbytes.BytesLen(headerBytes)
    rawbytes.BytesSet(out, dataBase, 0)
    rawbytes.BytesSet(out, dataBase + 1, 1)
    rawbytes.BytesSet(out, dataBase + 2, 255)
    rawbytes.BytesSet(out, dataBase + 3, 127)
    return out

fn safetensorsInt4QuantBytes(graph: mg.ModelGraph): rawbytes.Bytes =
    let header = safetensorsHeader(graph, SafetensorsValid)
    let headerBytes = rawbytes.BytesFromString(header)
    let outLen = 8 + rawbytes.BytesLen(headerBytes) + int32(safetensorsTotalDataBytes(graph))
    var out = rawbytes.BytesAlloc(outLen)
    writeU64LE(out, 0, int64(rawbytes.BytesLen(headerBytes)))
    rawbytes.BytesCopyInto(out, 8, headerBytes)
    let dataBase = 8 + rawbytes.BytesLen(headerBytes)
    rawbytes.BytesSet(out, dataBase, 0x10)
    rawbytes.BytesSet(out, dataBase + 1, 0x7f)
    return out

fn safetensorsW4Afp8Bytes(graph: mg.ModelGraph): rawbytes.Bytes =
    let header = safetensorsHeader(graph, SafetensorsValid)
    let headerBytes = rawbytes.BytesFromString(header)
    let outLen = 8 + rawbytes.BytesLen(headerBytes) + int32(safetensorsTotalDataBytes(graph))
    var out = rawbytes.BytesAlloc(outLen)
