        graph,
        0,
        Value(hfPayloadReceipt),
        hfDeviceCapabilityHash,
        Value(hfPayloadReceipt).byteCount,
        Value(hfPayloadReceipt).dtype,
        Value(hfPayloadReceipt).rawPayloadByteHash + int64(1)
    )),
           " weight safetensors manifest smoke: hf device range binding hash hard fail")
    let hfPayloadPreflight = ws.WeightSafetensorsBuildPayloadHashPreflight(hfIndex, graph, 5)
    assert(IsOk(hfPayloadPreflight),
