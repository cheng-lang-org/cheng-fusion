           Value(w4KernelPageSet).bindingHash == Value(w4KernelBindingSet).bindings[0].bindingHash &&
           Value(w4KernelPageSet).pageCount == Value(w4KernelPageTables)[0].pageCount &&
           Value(w4KernelPageSet).byteCount == int64(6) &&
           Value(w4KernelPageSet).pageLoadStatus == dev.InferenceDeviceBufferLoadStatusMetalBufferLoaded &&
           Value(w4KernelPageSet).receiptHash == ws.WeightSafetensorsDevicePageLoadSetReceiptHash(Value(w4KernelPageSet)),
           " weight safetensors manifest smoke: w4 page kernel page set facts")
