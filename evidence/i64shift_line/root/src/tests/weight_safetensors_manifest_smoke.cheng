    let linearInput = smokeTensor([1, 2], 10, [10, 20])
    var linearOut: infer.TensorQ
    let linearOk = exec.ModelExecutorLinearOutInPayloadFill(linearOut, linearInput, Value(linearPayload), "int4_linear")
    assert(IsOk(linearOk), " weight safetensors manifest smoke: int4 linear payload exec")
    assert(linearOut.data.len == 2 &&
           linearOut.data[0] == -30 &&
           linearOut.data[1] == 110,
           " weight safetensors manifest smoke: int4 linear payload value")
    let badLinearTensor = smokeTensor([2, 2], 10, [10, -10, 30, 40])
