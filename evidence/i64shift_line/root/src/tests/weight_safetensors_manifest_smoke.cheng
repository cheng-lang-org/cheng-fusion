           " weight safetensors manifest smoke: indexed execute hash")

    let hfBaseDir = "/tmp"
    let hfFile0 = strutil.Join([
        "cheng_weight_safetensors_hf_a_",
        strings.Int64ToStr(graph.graphHash),
        ".safetensors"
    ], "")
    let hfFile1 = strutil.Join([
        "cheng_weight_safetensors_hf_b_",
        strings.Int64ToStr(graph.graphHash),
        ".safetensors"
    ], "")
    let hfPath0 = os.JoinPath(hfBaseDir, hfFile0)
    let hfPath1 = os.JoinPath(hfBaseDir, hfFile1)
    if os.FileExists(hfPath0):
        assert(os.RemoveFile(hfPath0), " weight safetensors manifest smoke: remove hf file a")
    if os.FileExists(hfPath1):
        assert(os.RemoveFile(hfPath1), " weight safetensors manifest smoke: remove hf file b")
    var hfBytes0 = safetensorsNumericBytesRange(graph, 0, 3)
    var hfBytes1 = safetensorsNumericBytesRange(graph, 3, graph.weights.len)
    assert(IsOk(os.WriteFileBytesResult(hfPath0, hfBytes0)),
           " weight safetensors manifest smoke: write hf file a")
    assert(IsOk(os.WriteFileBytesResult(hfPath1, hfBytes1)),
           " weight safetensors manifest smoke: write hf file b")
    let hfJson = safetensorsHfIndexJson(graph, 3, hfFile0, hfFile1, HfIndexValid)
    let hfIndexRes = ws.WeightSafetensorsShardIndexFromHfWeightMap(hfJson, graph, hfBaseDir, peerIds, 1000)
    assert(IsOk(hfIndexRes), " weight safetensors manifest smoke: hf index build")
    let hfIndex = Value(hfIndexRes)
    assert(hfIndex.indexHash > int64(0),
           " weight safetensors manifest smoke: hf index hash")
    let hfLoad = ws.WeightSafetensorsLoadShardIndex(hfIndex, graph)
    assert(IsOk(hfLoad), " weight safetensors manifest smoke: hf index load")
    assert(Value(hfLoad).fileReceipts.len == 2,
           " weight safetensors manifest smoke: hf receipt count")
    assert(Value(hfLoad).store.storeHash == loadResult.store.storeHash,
           " weight safetensors manifest smoke: hf store hash")
    let hfRangePayload = ws.WeightSafetensorsBuildPayloadFromEntryRange(hfIndex, graph, 0, 64)
    assert(IsOk(hfRangePayload),
           " weight safetensors manifest smoke: hf range payload")
    assert(Value(hfRangePayload).payloadHash == Value(hfLoad).store.payloads[0].payloadHash,
           " weight safetensors manifest smoke: hf range payload hash")
    assert(IsErr(ws.WeightSafetensorsBuildPayloadFromEntryRange(hfIndex, graph, 0, 1)),
           " weight safetensors manifest smoke: hf range payload cap hard fail")
    let hfHeaderPreflight = ws.WeightSafetensorsBuildShardHeaderPreflight(hfIndex, graph)
    assert(IsOk(hfHeaderPreflight),
           " weight safetensors manifest smoke: hf header preflight")
    assert(Value(hfHeaderPreflight).schema == "cheng.inference.weight_safetensors_shard_header_preflight.v1" &&
           Value(hfHeaderPreflight).fileReceipts.len == 2 &&
           Value(hfHeaderPreflight).tensorCount == graph.weights.len &&
           Value(hfHeaderPreflight).receiptHash == ws.WeightSafetensorsShardHeaderPreflightHash(Value(hfHeaderPreflight)),
           " weight safetensors manifest smoke: hf header preflight receipt")
    assert(Value(hfHeaderPreflight).fileReceipts[0].fileByteCount == int64(rawbytes.BytesLen(hfBytes0)) &&
           Value(hfHeaderPreflight).fileReceipts[0].indexedTensorCount == 3 &&
           Value(hfHeaderPreflight).fileReceipts[0].receiptHash == ws.WeightSafetensorsShardHeaderReceiptHash(Value(hfHeaderPreflight).fileReceipts[0]),
           " weight safetensors manifest smoke: hf header file receipt")
    assert(IsOk(ws.WeightSafetensorsValidateShardHeaderPreflight(hfIndex, graph, Value(hfHeaderPreflight))),
           " weight safetensors manifest smoke: hf header preflight validate")
    var hfTruncatedBytes0 = rawbytes.BytesSlice(hfBytes0, 0, rawbytes.BytesLen(hfBytes0) - 1)
    assert(IsOk(os.WriteFileBytesResult(hfPath0, hfTruncatedBytes0)),
           " weight safetensors manifest smoke: hf header truncate write")
    assert(IsErr(ws.WeightSafetensorsBuildShardHeaderPreflight(hfIndex, graph)),
           " weight safetensors manifest smoke: hf header truncated hard fail")
    assert(IsOk(os.WriteFileBytesResult(hfPath0, hfBytes0)),
           " weight safetensors manifest smoke: hf header restore")
    let hfPayloadReceipt = ws.WeightSafetensorsBuildTensorRawPayloadHashReceipt(hfIndex, graph, 0, 3)
    assert(IsOk(hfPayloadReceipt),
