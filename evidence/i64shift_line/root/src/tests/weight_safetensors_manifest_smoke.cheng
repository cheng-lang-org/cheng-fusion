    assert(Value(hfPayloadPreflight).schema == "cheng.inference.weight_safetensors_payload_hash_preflight.v1" &&
           Value(hfPayloadPreflight).tensorReceipts.len == graph.weights.len &&
           Value(hfPayloadPreflight).tensorCount == graph.weights.len &&
           Value(hfPayloadPreflight).totalPayloadBytes == safetensorsTotalDataBytes(graph) &&
           Value(hfPayloadPreflight).chunkBytes == 5 &&
           Value(hfPayloadPreflight).tensorReceiptHash == ws.WeightSafetensorsTensorRawPayloadHashReceiptSetHash(Value(hfPayloadPreflight).tensorReceipts) &&
           Value(hfPayloadPreflight).receiptHash == ws.WeightSafetensorsPayloadHashPreflightHash(Value(hfPayloadPreflight)),
           " weight safetensors manifest smoke: hf payload hash preflight facts")
    assert(IsOk(ws.WeightSafetensorsValidatePayloadHashPreflight(hfIndex, graph, Value(hfPayloadPreflight))),
           " weight safetensors manifest smoke: hf payload hash preflight validate")
    let hfDeviceRangeBindingChunk5 = ws.WeightSafetensorsBuildDeviceRangeBinding(
        hfIndex,
