           Value(hfDevicePageTable).pageAggregateHash == dev.DeviceFileRangePageAggregateHash(Value(hfDevicePageTable).pages) &&
           Value(hfDevicePageTable).receiptHash == dev.DeviceFileRangePageTableReceiptHash(Value(hfDevicePageTable)),
