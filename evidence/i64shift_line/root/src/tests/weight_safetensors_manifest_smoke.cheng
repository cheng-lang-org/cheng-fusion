    rawbytes.BytesCopyInto(out, 8, headerBytes)
    let dataBase = 8 + rawbytes.BytesLen(headerBytes)
    rawbytes.BytesSet(out, dataBase, 0)
    rawbytes.BytesSet(out, dataBase + 1, 1)
    rawbytes.BytesSet(out, dataBase + 2, 255)
    rawbytes.BytesSet(out, dataBase + 3, 127)
    rawbytes.BytesSet(out, dataBase + 4, 56)
    rawbytes.BytesSet(out, dataBase + 5, 184)
    rawbytes.BytesSet(out, dataBase + 6, 48)
    rawbytes.BytesSet(out, dataBase + 7, 64)
    rawbytes.BytesSet(out, dataBase + 8, 56)
    rawbytes.BytesSet(out, dataBase + 9, 48)
    rawbytes.BytesSet(out, dataBase + 10, 64)
    rawbytes.BytesSet(out, dataBase + 11, 184)
    return out

fn safetensorsW4Afp8LinearKernelBytes(graph: mg.ModelGraph): rawbytes.Bytes =
    let header = safetensorsHeader(graph, SafetensorsValid)
    let headerBytes = rawbytes.BytesFromString(header)
    let outLen = 8 + rawbytes.BytesLen(headerBytes) + int32(safetensorsTotalDataBytes(graph))
    var out = rawbytes.BytesAlloc(outLen)
    writeU64LE(out, 0, int64(rawbytes.BytesLen(headerBytes)))
    rawbytes.BytesCopyInto(out, 8, headerBytes)
    let dataBase = 8 + rawbytes.BytesLen(headerBytes)
    rawbytes.BytesSet(out, dataBase, 1)
    rawbytes.BytesSet(out, dataBase + 1, 254)
    rawbytes.BytesSet(out, dataBase + 2, 3)
    rawbytes.BytesSet(out, dataBase + 3, 4)
    rawbytes.BytesSet(out, dataBase + 4, 0)
    rawbytes.BytesSet(out, dataBase + 5, 255)
    rawbytes.BytesSet(out, dataBase + 6, 56)
    rawbytes.BytesSet(out, dataBase + 7, 64)
    rawbytes.BytesSet(out, dataBase + 8, 56)
    return out

fn safetensorsInt4OddPaddingBytes(graph: mg.ModelGraph, badPadding: bool): rawbytes.Bytes =
    let header = safetensorsHeader(graph, SafetensorsValid)
    let headerBytes = rawbytes.BytesFromString(header)
    let outLen = 8 + rawbytes.BytesLen(headerBytes) + int32(safetensorsTotalDataBytes(graph))
    var out = rawbytes.BytesAlloc(outLen)
    writeU64LE(out, 0, int64(rawbytes.BytesLen(headerBytes)))
    rawbytes.BytesCopyInto(out, 8, headerBytes)
    let dataBase = 8 + rawbytes.BytesLen(headerBytes)
    rawbytes.BytesSet(out, dataBase, 0x10)
    if badPadding:
        rawbytes.BytesSet(out, dataBase + 1, 0x1f)
    else:
        rawbytes.BytesSet(out, dataBase + 1, 0x0f)
    return out

fn peersForGraph(graph: mg.ModelGraph): str[] =
    var peers: str[]
    for i in 0..<graph.weights.len:
        add(peers, strutil.Join(["peer:", strings.IntToStr(i)], ""))
    return peers

fn safetensorsShardIndexForGraph(graph: mg.ModelGraph,
                                 path0: str,
                                 path1: str,
                                 splitIndex: int32): ws.WeightSafetensorsShardIndex =
    var entries: ws.WeightSafetensorsShardIndexEntry[]
    for i in 0..<graph.weights.len:
        var path = path1
        if i < splitIndex:
            path = path0
        add(entries, ws.WeightSafetensorsShardIndexEntry(
            modelCid: graph.weights[i].modelCid,
            graphHash: graph.graphHash,
            tensorName: graph.weights[i].tensorName,
            shardCid: graph.weights[i].shardCid,
            dtype: graph.weights[i].dtype,
            quantScheme: graph.weights[i].quantScheme,
            sizeBytes: graph.weights[i].sizeBytes,
            filePath: path,
            peerId: strutil.Join(["peer:", strings.IntToStr(i)], ""),
            tensorScale: 1000
        ))
    return ws.WeightSafetensorsShardIndexBuild(graph.modelCid, graph.graphHash, entries)

fn safetensorsHfIndexShardName(mode: int32, ordinal: int32, file0: str, file1: str): str =
    if mode == HfIndexPathTraversal && ordinal == 0:
        return "../evil.safetensors"
    if mode == HfIndexAbsolutePath && ordinal == 0:
        return "/tmp/evil.safetensors"
    if mode == HfIndexBadSuffix && ordinal == 0:
        return "model.bin"
    if ordinal == 0:
        return file0
    return file1

fn safetensorsHfIndexJson(graph: mg.ModelGraph,
                          splitIndex: int32,
                          file0: str,
                          file1: str,
                          mode: int32): str =
    var parts: str[]
    for i in 0..<graph.weights.len:
        if mode == HfIndexMissingTensor && i == graph.weights.len - 1:
            continue
        var ordinal: int32 = 1
        if i < splitIndex:
            ordinal = 0
        let fileName = safetensorsHfIndexShardName(mode, ordinal, file0, file1)
        add(parts, strutil.Join([
            "\"",
            graph.weights[i].tensorName,
            "\":\"",
            fileName,
            "\""
        ], ""))
    return strutil.Join([
        "{\"metadata\":{\"total_size\":",
        strings.Int64ToStr(safetensorsTotalDataBytes(graph)),
        "},\"weight_map\":{",
        strutil.Join(parts, ","),
        "}}"
    ], "")

fn safetensorsPayloadHashesForGraph(graph: mg.ModelGraph,
                                    store: ws.WeightTensorStore): Result[int64[]] =
    if store.payloads.len != graph.weights.len:
        return Err[int64[]]("weight safetensors manifest smoke: payload hash count")
    var hashes: int64[]
    for i in 0..<graph.weights.len:
        if store.payloads[i].tensorName != graph.weights[i].tensorName:
            return Err[int64[]]("weight safetensors manifest smoke: payload hash order")
        add(hashes, store.payloads[i].payloadHash)
    return Ok[int64[]](hashes)

fn factsContain(facts: str[], needle: str): bool =
    for i in 0..<facts.len:
        if strutil.Contains(facts[i], needle):
            return true
    return false

fn smokeTensor(shape: int32[], scale: int32, data: int32[]): infer.TensorQ =
    var out: infer.TensorQ
    let ok = infer.TensorFromDataFill(out, shape, scale, data)
    assert(IsOk(ok), " weight safetensors manifest smoke: tensor")
    return out

fn smokePackedInt4(shape: int32[], scale: int32, values: int32[]): kir.KernelPackedInt4Tensor =
    let countRes = infer.TensorElementCount(shape)
    assert(IsOk(countRes) && Value(countRes) == values.len,
           " weight safetensors manifest smoke: packed int4 count")
    var bytes = rawbytes.BytesAlloc(values.len / 2 + values.len % 2)
    for i in 0..<values.len:
        assert(values[i] >= -8 && values[i] <= 7,
               " weight safetensors manifest smoke: packed int4 range")
        var nibble = values[i]
        if nibble < 0:
            nibble = nibble + 16
        let byteIndex = i / 2
        let oldByte = rawbytes.BytesGet(bytes, byteIndex)
        if i % 2 == 0:
            rawbytes.BytesSet(bytes, byteIndex, (oldByte & 240) | (nibble & 15))
        else:
            rawbytes.BytesSet(bytes, byteIndex, (oldByte & 15) | ((nibble & 15) << 4))
    let packed = kir.KernelPackedInt4Tensor(shape: shape, scale: scale, packed: bytes)
    assert(IsOk(kir.KernelIrPackedInt4TensorValidate(packed)),
           " weight safetensors manifest smoke: packed int4 validate")
    return packed

fn smokeRawBytes(values: int32[]): rawbytes.Bytes =
    var out = rawbytes.BytesAlloc(values.len)
    for i in 0..<values.len:
        assert(values[i] >= 0 && values[i] <= 255,
               " weight safetensors manifest smoke: raw byte range")
        rawbytes.BytesSet(out, i, values[i])
    return out

fn main(): int32 =
    let graph = mg.ModelGraphBuildTinyGlmMoeFixture("cid:model:safetensors-fixture")
    let validBytes = safetensorsBytes(graph, SafetensorsValid)
    let valid = ws.WeightSafetensorsValidateGraphFile(validBytes, graph)
    assert(IsOk(valid), " weight safetensors manifest smoke: valid file")
    let manifest = Value(valid)
    assert(manifest.schema == "cheng.inference.weight_safetensors_manifest.v1",
           " weight safetensors manifest smoke: schema")
    assert(manifest.headerHash > int64(0),
           " weight safetensors manifest smoke: header hash")
    assert(manifest.tensors.len == graph.weights.len,
           " weight safetensors manifest smoke: tensor count")
    assert(manifest.tensors[0].tensorName == "embedding.weight",
           " weight safetensors manifest smoke: first tensor")
    assert(manifest.tensors[0].byteCount == graph.weights[0].sizeBytes,
           " weight safetensors manifest smoke: byte count")

    let path = strutil.Join([
        "/tmp/cheng_weight_safetensors_manifest_",
        strings.Int64ToStr(graph.graphHash),
        ".safetensors"
    ], "")
    if os.FileExists(path):
        assert(os.RemoveFile(path), " weight safetensors manifest smoke: remove old file")
    var fileBytes = validBytes
    let writeOk = os.WriteFileBytesResult(path, fileBytes)
    assert(IsOk(writeOk), " weight safetensors manifest smoke: write file")
    assert(IsOk(ws.WeightSafetensorsValidateGraphFilePath(path, graph)),
           " weight safetensors manifest smoke: path validation")
    let prefix8 = os.ReadFilePrefixBytesResult(path, 8)
    assert(IsOk(prefix8) && rawbytes.BytesLen(Value(prefix8)) == 8,
           " weight safetensors manifest smoke: prefix read length")
    let prefixWhole = os.ReadFilePrefixBytesResult(path, rawbytes.BytesLen(validBytes) + 64)
    assert(IsOk(prefixWhole) && rawbytes.BytesLen(Value(prefixWhole)) == rawbytes.BytesLen(validBytes),
           " weight safetensors manifest smoke: prefix read clipped to file")
    assert(IsErr(os.ReadFilePrefixBytesResult(path, 0)),
           " weight safetensors manifest smoke: prefix read max hard fail")
    let range8 = os.ReadFileRangeBytesResult(path, 8, 7)
    assert(IsOk(range8) && rawbytes.BytesLen(Value(range8)) == 7 &&
           rawbytes.BytesGet(Value(range8), 0) == rawbytes.BytesGet(validBytes, 8),
           " weight safetensors manifest smoke: range read offset")
    assert(IsErr(os.ReadFileRangeBytesResult(path, int64(rawbytes.BytesLen(validBytes)) - int64(3), 4)),
           " weight safetensors manifest smoke: range read beyond file hard fail")
    let headerPathManifest = ws.WeightSafetensorsValidateGraphFileHeaderPath(path, graph)
    assert(IsOk(headerPathManifest),
           " weight safetensors manifest smoke: header path validation")
    assert(Value(headerPathManifest).headerHash == manifest.headerHash &&
           Value(headerPathManifest).tensors.len == graph.weights.len,
           " weight safetensors manifest smoke: header path manifest")

    assert(IsErr(ws.WeightSafetensorsValidateGraphFile(safetensorsBytes(graph, SafetensorsDtypeDrift), graph)),
           " weight safetensors manifest smoke: dtype drift hard fail")
    assert(IsErr(ws.WeightSafetensorsValidateGraphFile(safetensorsBytes(graph, SafetensorsShapeDrift), graph)),
           " weight safetensors manifest smoke: shape drift hard fail")
    assert(IsErr(ws.WeightSafetensorsValidateGraphFile(safetensorsBytes(graph, SafetensorsByteCountDrift), graph)),
           " weight safetensors manifest smoke: byte count drift hard fail")
    assert(IsErr(ws.WeightSafetensorsValidateGraphFile(safetensorsBytes(graph, SafetensorsMissingTensor), graph)),
           " weight safetensors manifest smoke: missing tensor hard fail")
    assert(IsErr(ws.WeightSafetensorsValidateGraphFile(safetensorsBytes(graph, SafetensorsOverlap), graph)),
           " weight safetensors manifest smoke: overlap hard fail")

    let truncated = rawbytes.BytesSlice(validBytes, 0, rawbytes.BytesLen(validBytes) - 1)
    assert(IsErr(ws.WeightSafetensorsValidateGraphFile(truncated, graph)),
           " weight safetensors manifest smoke: truncated file hard fail")

    let duplicateHeader = strutil.Join([
        "{\"embedding.weight\":{\"dtype\":\"F16\",\"shape\":[8,4],\"data_offsets\":[0,64]},",
        "\"embedding.weight\":{\"dtype\":\"F16\",\"shape\":[8,4],\"data_offsets\":[64,128]}}"
    ], "")
    let duplicateBytes = safetensorsBytesFromHeader(duplicateHeader, int32(128))
    assert(IsErr(ws.WeightSafetensorsValidateGraphFile(duplicateBytes, graph)),
           " weight safetensors manifest smoke: duplicate tensor hard fail")

    let numericBytes = safetensorsNumericBytes(graph)
    let peerIds = peersForGraph(graph)
    let loaded = ws.WeightSafetensorsLoadGraphFile(numericBytes, graph, peerIds, 1000)
    assert(IsOk(loaded), " weight safetensors manifest smoke: load numeric f16")
    let loadResult = Value(loaded)
    assert(loadResult.manifest.tensors.len == graph.weights.len,
           " weight safetensors manifest smoke: load manifest")
    assert(IsOk(ws.WeightTensorValidateStore(loadResult.store, loadResult.bindings, graph)),
           " weight safetensors manifest smoke: loaded store validates")
    assert(loadResult.store.payloads.len == graph.weights.len,
           " weight safetensors manifest smoke: loaded payload count")
    assert(loadResult.store.payloads[0].tensor.scale == 1000,
           " weight safetensors manifest smoke: loaded tensor scale")
    assert(loadResult.store.payloads[0].tensor.data[0] == 1000,
           " weight safetensors manifest smoke: f16 one")
    assert(loadResult.store.payloads[0].tensor.data[1] == -1000,
           " weight safetensors manifest smoke: f16 negative one")
    assert(loadResult.store.payloads[0].tensor.data[2] == 500,
           " weight safetensors manifest smoke: f16 half")
    assert(loadResult.store.payloads[0].tensor.data[3] == 0,
           " weight safetensors manifest smoke: f16 zero")
    assert(loadResult.store.payloads[0].tensor.data[4] == 2000,
           " weight safetensors manifest smoke: f16 two")
    assert(loadResult.store.payloads[0].tensor.data[5] == -2000,
           " weight safetensors manifest smoke: f16 negative two")
    let expectedPayloadHashes = safetensorsPayloadHashesForGraph(graph, loadResult.store)
    assert(IsOk(expectedPayloadHashes),
           " weight safetensors manifest smoke: expected payload hashes")
    let boundGraphRes = mg.ModelGraphBindExpectedWeightPayloadHashes(graph, Value(expectedPayloadHashes))
    assert(IsOk(boundGraphRes),
           " weight safetensors manifest smoke: bind expected payload hashes")
    let boundGraph = Value(boundGraphRes)
    assert(IsOk(mg.ModelGraphValidate(graph)),
           " weight safetensors manifest smoke: bind does not mutate source graph")
    let boundLoaded = ws.WeightSafetensorsLoadGraphFile(numericBytes, boundGraph, peerIds, 1000)
    assert(IsOk(boundLoaded),
           " weight safetensors manifest smoke: bound graph load")
    assert(Value(boundLoaded).store.storeHash == loadResult.store.storeHash,
           " weight safetensors manifest smoke: bound graph store hash")
    var payloadDriftBytes = rawbytes.BytesSlice(numericBytes, 0, rawbytes.BytesLen(numericBytes))
    let payloadDriftHeaderLen = ws.WeightSafetensorsHeaderLength(payloadDriftBytes)
    assert(IsOk(payloadDriftHeaderLen),
           " weight safetensors manifest smoke: payload drift header")
    rawbytes.BytesSet(payloadDriftBytes, 8 + Value(payloadDriftHeaderLen), 1)
    assert(IsErr(ws.WeightSafetensorsLoadGraphFile(payloadDriftBytes, boundGraph, peerIds, 1000)),
           " weight safetensors manifest smoke: expected payload hash drift hard fail")
    let bf16One = ws.WeightSafetensorsDecodeBf16Scaled(0x3f80, 1000)
    assert(IsOk(bf16One) && Value(bf16One) == 1000,
           " weight safetensors manifest smoke: bf16 one")
    let bf16NegativeOne = ws.WeightSafetensorsDecodeBf16Scaled(0xbf80, 1000)
    assert(IsOk(bf16NegativeOne) && Value(bf16NegativeOne) == -1000,
           " weight safetensors manifest smoke: bf16 negative one")
    let i8NegativeOne = ws.WeightSafetensorsDecodeI8Scaled(255, 1000)
    assert(IsOk(i8NegativeOne) && Value(i8NegativeOne) == -1000,
           " weight safetensors manifest smoke: i8 negative one")
    let i8Max = ws.WeightSafetensorsDecodeI8Scaled(127, 10)
    assert(IsOk(i8Max) && Value(i8Max) == 1270,
           " weight safetensors manifest smoke: i8 max")
    let i4NegativeOne = ws.WeightSafetensorsDecodeI4Scaled(15, 1000)
    assert(IsOk(i4NegativeOne) && Value(i4NegativeOne) == -1000,
           " weight safetensors manifest smoke: i4 negative one")
    let i4Max = ws.WeightSafetensorsDecodeI4Scaled(7, 10)
    assert(IsOk(i4Max) && Value(i4Max) == 70,
           " weight safetensors manifest smoke: i4 max")
    let fp8One = ws.WeightSafetensorsDecodeFp8E4M3Scaled(0x38, 1000)
    assert(IsOk(fp8One) && Value(fp8One) == 1000,
           " weight safetensors manifest smoke: fp8 e4m3 one")
    let fp8NegativeOne = ws.WeightSafetensorsDecodeFp8E4M3Scaled(0xb8, 1000)
    assert(IsOk(fp8NegativeOne) && Value(fp8NegativeOne) == -1000,
           " weight safetensors manifest smoke: fp8 e4m3 negative one")
    let fp8Half = ws.WeightSafetensorsDecodeFp8E4M3Scaled(0x30, 1000)
    assert(IsOk(fp8Half) && Value(fp8Half) == 500,
           " weight safetensors manifest smoke: fp8 e4m3 half")
    let fp8Two = ws.WeightSafetensorsDecodeFp8E4M3Scaled(0x40, 1000)
    assert(IsOk(fp8Two) && Value(fp8Two) == 2000,
           " weight safetensors manifest smoke: fp8 e4m3 two")
    let fp8Subnormal = ws.WeightSafetensorsDecodeFp8E4M3Scaled(0x01, 512000)
    assert(IsOk(fp8Subnormal) && Value(fp8Subnormal) == 1000,
           " weight safetensors manifest smoke: fp8 e4m3 subnormal")

    let quantGraph = safetensorsQuantFixtureGraph(
        "cid:model:safetensors-int8-quant",
        kir.KernelDtypeInt8,
        mg.ModelQuantSchemeSymmetricInt8,
        mg.ModelQuantSchemeNone
    )
    let quantBytes = safetensorsInt8QuantBytes(quantGraph)
    let quantPeers = peersForGraph(quantGraph)
    let quantLoaded = ws.WeightSafetensorsLoadGraphFile(quantBytes, quantGraph, quantPeers, 10)
    assert(IsOk(quantLoaded),
           " weight safetensors manifest smoke: int8 symmetric load")
    let quantResult = Value(quantLoaded)
    assert(quantResult.store.payloads.len == 1 &&
           quantResult.store.payloads[0].dtype == kir.KernelDtypeInt8 &&
           quantResult.store.payloads[0].quantScheme == mg.ModelQuantSchemeSymmetricInt8,
           " weight safetensors manifest smoke: int8 symmetric identity")
    assert(quantResult.store.payloads[0].tensor.data[0] == 0 &&
           quantResult.store.payloads[0].tensor.data[1] == 10 &&
           quantResult.store.payloads[0].tensor.data[2] == -10 &&
           quantResult.store.payloads[0].tensor.data[3] == 1270,
           " weight safetensors manifest smoke: int8 symmetric values")
    let quantPayloadHashes = safetensorsPayloadHashesForGraph(quantGraph, quantResult.store)
    assert(IsOk(quantPayloadHashes),
           " weight safetensors manifest smoke: int8 payload hash list")
    let quantBoundGraphRes = mg.ModelGraphBindExpectedWeightPayloadHashes(quantGraph, Value(quantPayloadHashes))
    assert(IsOk(quantBoundGraphRes),
           " weight safetensors manifest smoke: int8 bind expected payload")
    let quantBoundGraph = Value(quantBoundGraphRes)
    assert(IsOk(ws.WeightSafetensorsLoadGraphFile(quantBytes, quantBoundGraph, quantPeers, 10)),
           " weight safetensors manifest smoke: int8 bound load")
    var quantDriftBytes = rawbytes.BytesSlice(quantBytes, 0, rawbytes.BytesLen(quantBytes))
    let quantHeaderLen = ws.WeightSafetensorsHeaderLength(quantDriftBytes)
    assert(IsOk(quantHeaderLen),
           " weight safetensors manifest smoke: int8 drift header")
    rawbytes.BytesSet(quantDriftBytes, 8 + Value(quantHeaderLen) + 1, 2)
    assert(IsErr(ws.WeightSafetensorsLoadGraphFile(quantDriftBytes, quantBoundGraph, quantPeers, 10)),
           " weight safetensors manifest smoke: int8 payload drift hard fail")

    let w4Afp8Graph = safetensorsW4Afp8FixtureGraph("cid:model:safetensors-w4afp8")
    assert(IsOk(mg.ModelGraphValidate(w4Afp8Graph)),
           " weight safetensors manifest smoke: w4afp8 graph validate")
    let w4Afp8Bytes = safetensorsW4Afp8Bytes(w4Afp8Graph)
    let w4Afp8Peers = peersForGraph(w4Afp8Graph)
    let w4Afp8Loaded = ws.WeightSafetensorsLoadGraphFile(w4Afp8Bytes, w4Afp8Graph, w4Afp8Peers, 1000)
    assert(IsOk(w4Afp8Loaded),
           " weight safetensors manifest smoke: w4afp8 direct load")
    let w4Afp8Result = Value(w4Afp8Loaded)
    assert(w4Afp8Result.store.payloads.len == 3 &&
           w4Afp8Result.store.payloads[0].dtype == kir.KernelDtypeInt8 &&
           w4Afp8Result.store.payloads[0].quantScheme == mg.ModelQuantSchemeW4Afp8 &&
           w4Afp8Result.store.payloads[1].dtype == kir.KernelDtypeFp8E4M3 &&
           w4Afp8Result.store.payloads[1].quantScheme == mg.ModelQuantSchemeNone &&
           w4Afp8Result.store.payloads[2].dtype == kir.KernelDtypeFp8E4M3 &&
           w4Afp8Result.store.payloads[2].quantScheme == mg.ModelQuantSchemeNone,
           " weight safetensors manifest smoke: w4afp8 payload identity")
    assert(w4Afp8Result.store.payloads[0].tensor.data[0] == 0 &&
           w4Afp8Result.store.payloads[0].tensor.data[1] == 1000 &&
           w4Afp8Result.store.payloads[0].tensor.data[2] == -1000 &&
           w4Afp8Result.store.payloads[0].tensor.data[3] == 127000 &&
           w4Afp8Result.store.payloads[1].tensor.data[0] == 1000 &&
           w4Afp8Result.store.payloads[1].tensor.data[1] == -1000 &&
           w4Afp8Result.store.payloads[1].tensor.data[2] == 500 &&
           w4Afp8Result.store.payloads[1].tensor.data[3] == 2000 &&
           w4Afp8Result.store.payloads[2].tensor.data[0] == 1000 &&
           w4Afp8Result.store.payloads[2].tensor.data[1] == 500 &&
           w4Afp8Result.store.payloads[2].tensor.data[2] == 2000 &&
           w4Afp8Result.store.payloads[2].tensor.data[3] == -1000,
           " weight safetensors manifest smoke: w4afp8 decoded values")
    assert(w4Afp8Result.store.payloads[0].hasW4Afp8Raw &&
           w4Afp8Result.store.payloads[0].w4Afp8RawHash > int64(0) &&
           rawbytes.BytesLen(w4Afp8Result.store.payloads[0].w4Afp8Raw) == 4 &&
           rawbytes.BytesGet(w4Afp8Result.store.payloads[0].w4Afp8Raw, 0) == 0 &&
           rawbytes.BytesGet(w4Afp8Result.store.payloads[0].w4Afp8Raw, 1) == 1 &&
           rawbytes.BytesGet(w4Afp8Result.store.payloads[0].w4Afp8Raw, 2) == 255 &&
           rawbytes.BytesGet(w4Afp8Result.store.payloads[0].w4Afp8Raw, 3) == 127,
           " weight safetensors manifest smoke: w4afp8 raw payload")
    let w4Afp8RawHash = ws.WeightTensorRawBytesHash(w4Afp8Result.store.payloads[0].w4Afp8Raw)
    assert(IsOk(w4Afp8RawHash) &&
           Value(w4Afp8RawHash) == w4Afp8Result.store.payloads[0].w4Afp8RawHash,
           " weight safetensors manifest smoke: w4afp8 raw hash")
    let w4Afp8Facts = ws.WeightTensorStoreFacts(w4Afp8Result.store)
    assert(factsContain(w4Afp8Facts, strutil.Join([
               "weight_tensor_w4afp8_raw=quant.weight:",
               strings.Int64ToStr(w4Afp8Result.store.payloads[0].w4Afp8RawHash)
           ], "")),
           " weight safetensors manifest smoke: w4afp8 raw facts")
    let w4Afp8PayloadHashes = safetensorsPayloadHashesForGraph(w4Afp8Graph, w4Afp8Result.store)
    assert(IsOk(w4Afp8PayloadHashes),
           " weight safetensors manifest smoke: w4afp8 payload hashes")
    let w4Afp8BoundGraphRes = mg.ModelGraphBindExpectedWeightPayloadHashes(w4Afp8Graph, Value(w4Afp8PayloadHashes))
    assert(IsOk(w4Afp8BoundGraphRes),
           " weight safetensors manifest smoke: w4afp8 bind expected payload")
    let w4Afp8BoundGraph = Value(w4Afp8BoundGraphRes)
    assert(IsOk(ws.WeightSafetensorsLoadGraphFile(w4Afp8Bytes, w4Afp8BoundGraph, w4Afp8Peers, 1000)),
           " weight safetensors manifest smoke: w4afp8 bound load")
    let w4MaterializedPath = strutil.Join([
        "/tmp/cheng_weight_safetensors_w4afp8_materialized_",
        strings.Int64ToStr(w4Afp8Result.store.payloads[0].payloadHash),
        ".cw1"
    ], "")
    if os.FileExists(w4MaterializedPath):
        assert(os.RemoveFile(w4MaterializedPath), " weight safetensors manifest smoke: remove w4 materialized")
    assert(IsErr(ws.WeightTensorPayloadWriteMaterializedShardFile(w4MaterializedPath, w4Afp8Result.store.payloads[0])),
           " weight safetensors manifest smoke: w4afp8 materialized hard fail")

    let w4KernelGraph = safetensorsW4Afp8LinearKernelFixtureGraph("cid:model:safetensors-w4afp8-kernel-page")
    let w4KernelBytes = safetensorsW4Afp8LinearKernelBytes(w4KernelGraph)
    let w4KernelPath = strutil.Join([
        "/tmp/cheng_weight_safetensors_w4afp8_kernel_page_",
        strings.Int64ToStr(w4KernelGraph.graphHash),
