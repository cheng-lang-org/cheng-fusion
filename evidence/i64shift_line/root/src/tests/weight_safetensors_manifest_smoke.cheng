    )),
           " weight safetensors manifest smoke: hf device page metal range hard fail")
    assert(IsErr(ws.WeightSafetensorsBuildDevicePageBindingSetFromPayloadPreflightForDevice(
        hfIndex,
        graph,
        Value(hfPayloadPreflight),
        hfDevice,
        int64(0)
    )),
           " weight safetensors manifest smoke: hf device page binding set page hard fail")
    var hfPayloadDriftBytes0 = rawbytes.BytesSlice(hfBytes0, 0, rawbytes.BytesLen(hfBytes0))
    let hfPayloadHeaderLen = ws.WeightSafetensorsHeaderLength(hfPayloadDriftBytes0)
    assert(IsOk(hfPayloadHeaderLen),
           " weight safetensors manifest smoke: hf payload drift header")
    rawbytes.BytesSet(hfPayloadDriftBytes0, 8 + Value(hfPayloadHeaderLen), rawbytes.BytesGet(hfPayloadDriftBytes0, 8 + Value(hfPayloadHeaderLen)) ^ 1)
    assert(IsOk(os.WriteFileBytesResult(hfPath0, hfPayloadDriftBytes0)),
           " weight safetensors manifest smoke: hf payload drift write")
    assert(IsErr(ws.WeightSafetensorsValidateTensorRawPayloadHashReceipt(hfIndex, graph, 0, Value(hfPayloadReceipt))),
           " weight safetensors manifest smoke: hf raw payload drift hard fail")
    assert(IsErr(dev.DeviceValidateFileRangeBufferLoadReceipt(hfDevice, hfDeviceBuffer, Value(hfDeviceLoadReceipt))),
           " weight safetensors manifest smoke: hf device file range load receipt drift hard fail")
    assert(IsErr(ws.WeightSafetensorsValidateDevicePageLoadReceipt(
        hfIndex,
        graph,
        hfDevice,
        hfDevicePageTables,
        Value(hfDevicePageBindingSet),
        0,
        0,
        hfDevicePage0Loaded,
        Value(hfDevicePage0Load).receipt
    )), " weight safetensors manifest smoke: hf device page load receipt payload drift hard fail")
    assert(IsErr(ws.WeightSafetensorsLoadDevicePageFromBindingSet(
        hfIndex,
        graph,
        hfDevice,
        hfDevicePageTables,
        Value(hfDevicePageBindingSet),
        0,
        0
    )),
           " weight safetensors manifest smoke: hf device page metal payload drift hard fail")
    assert(IsErr(ws.WeightSafetensorsValidateDeviceRangeBinding(hfIndex, graph, 0, Value(hfDeviceRangeBinding))),
           " weight safetensors manifest smoke: hf device range binding drift hard fail")
    assert(IsErr(ws.WeightSafetensorsValidateDevicePageBinding(
        hfIndex,
        graph,
        0,
        Value(hfDevicePageTable),
        Value(hfDevicePageBinding)
    )), " weight safetensors manifest smoke: hf device page binding drift hard fail")
    assert(IsErr(ws.WeightSafetensorsValidatePayloadHashPreflight(hfIndex, graph, Value(hfPayloadPreflight))),
           " weight safetensors manifest smoke: hf payload hash preflight drift hard fail")
    assert(IsErr(ws.WeightSafetensorsBuildDevicePageTablesFromPayloadPreflight(
        hfIndex,
        graph,
        Value(hfPayloadPreflight),
        hfDevice,
        int64(2)
    )),
           " weight safetensors manifest smoke: hf device page tables auto drift hard fail")
    assert(IsErr(ws.WeightSafetensorsValidateDeviceRangeBindingSet(hfIndex, graph, Value(hfDeviceRangeBindingSet))),
           " weight safetensors manifest smoke: hf device range binding set drift hard fail")
    assert(IsErr(ws.WeightSafetensorsValidateDevicePageBindingSet(hfIndex, graph, hfDevicePageTables, Value(hfDevicePageBindingSet))),
           " weight safetensors manifest smoke: hf device page binding set drift hard fail")
    assert(IsOk(os.WriteFileBytesResult(hfPath0, hfBytes0)),
           " weight safetensors manifest smoke: hf payload restore")
    let hfRoute = exec.ModelExecutorBuildTinyRoutePlan(graph, Value(hfLoad).bindings, Value(hfLoad).store, tokenIds, 2)
    assert(IsOk(hfRoute), " weight safetensors manifest smoke: hf route")
    let hfExec = exec.ModelExecutorExecuteTinyGlmMoe(graph, Value(hfLoad).bindings, Value(hfLoad).store, tokenIds, Value(hfRoute))
    assert(IsOk(hfExec), " weight safetensors manifest smoke: hf execute")
    assert(Value(hfExec).executionHash == Value(execRes).executionHash,
           " weight safetensors manifest smoke: hf execute hash")

    let hfIndexPath = strutil.Join([
        "/tmp/cheng_weight_safetensors_hf_index_",
        strings.Int64ToStr(graph.graphHash),
        ".json"
    ], "")
    if os.FileExists(hfIndexPath):
        assert(os.RemoveFile(hfIndexPath), " weight safetensors manifest smoke: remove hf json")
    var hfJsonBytes = rawbytes.BytesFromString(hfJson)
    assert(IsOk(os.WriteFileBytesResult(hfIndexPath, hfJsonBytes)),
           " weight safetensors manifest smoke: write hf json")
    let hfIndexPathRes = ws.WeightSafetensorsShardIndexFromHfWeightMapPath(hfIndexPath, graph, hfBaseDir, peerIds, 1000)
    assert(IsOk(hfIndexPathRes), " weight safetensors manifest smoke: hf path build")
    assert(Value(hfIndexPathRes).indexHash == hfIndex.indexHash,
           " weight safetensors manifest smoke: hf path index hash")
    let hfBoundIndexRes = ws.WeightSafetensorsShardIndexFromHfWeightMap(hfJson, boundGraph, hfBaseDir, peerIds, 1000)
    assert(IsOk(hfBoundIndexRes),
           " weight safetensors manifest smoke: hf bound index build")
    let hfBoundLoad = ws.WeightSafetensorsLoadShardIndex(Value(hfBoundIndexRes), boundGraph)
    assert(IsOk(hfBoundLoad),
           " weight safetensors manifest smoke: hf bound index load")
    assert(Value(hfBoundLoad).store.storeHash == loadResult.store.storeHash,
           " weight safetensors manifest smoke: hf bound store hash")
    assert(IsOk(ws.WeightSafetensorsBuildPayloadFromEntryRange(Value(hfBoundIndexRes), boundGraph, 0, 64)),
           " weight safetensors manifest smoke: hf bound range payload")
    let hfRepository = ws.WeightSafetensorsLoadHfRepository(hfJson, boundGraph, hfBaseDir, peerIds, 1000)
    assert(IsOk(hfRepository),
           " weight safetensors manifest smoke: hf repository load")
    let hfRepositoryValue = Value(hfRepository)
    assert(hfRepositoryValue.receipt.schema == "cheng.inference.weight_safetensors_repository_receipt.v1",
           " weight safetensors manifest smoke: hf repository schema")
    assert(hfRepositoryValue.receipt.modelCid == boundGraph.modelCid &&
           hfRepositoryValue.receipt.graphHash == boundGraph.graphHash,
           " weight safetensors manifest smoke: hf repository graph")
    assert(hfRepositoryValue.receipt.hfConfigHash > int64(0) &&
           hfRepositoryValue.receipt.quantConfigHash > int64(0),
           " weight safetensors manifest smoke: hf repository config hash")
    assert(hfRepositoryValue.receipt.shardIndexHash == Value(hfBoundIndexRes).indexHash,
           " weight safetensors manifest smoke: hf repository shard index hash")
    assert(hfRepositoryValue.receipt.fileReceiptHash == ws.WeightSafetensorsShardFileReceiptHash(hfRepositoryValue.load.fileReceipts),
           " weight safetensors manifest smoke: hf repository file receipt hash")
    assert(hfRepositoryValue.receipt.bindingHash == hfRepositoryValue.load.bindings.bindingHash &&
           hfRepositoryValue.receipt.storeHash == hfRepositoryValue.load.store.storeHash,
           " weight safetensors manifest smoke: hf repository binding store hash")
    assert(hfRepositoryValue.receipt.payloadCount == boundGraph.weights.len &&
           hfRepositoryValue.receipt.receiptHash == ws.WeightSafetensorsRepositoryReceiptHash(hfRepositoryValue.receipt),
           " weight safetensors manifest smoke: hf repository receipt hash")
    assert(hfRepositoryValue.load.fileReceipts[0].fileByteHash > int64(0) &&
           hfRepositoryValue.load.fileReceipts[0].fileByteCount > int64(0),
           " weight safetensors manifest smoke: hf repository file bytes")
    let hfRepositoryPath = ws.WeightSafetensorsLoadHfRepositoryPath(hfIndexPath, boundGraph, hfBaseDir, peerIds, 1000)
    assert(IsOk(hfRepositoryPath),
           " weight safetensors manifest smoke: hf repository path load")
    assert(Value(hfRepositoryPath).receipt.receiptHash == hfRepositoryValue.receipt.receiptHash,
           " weight safetensors manifest smoke: hf repository path hash")
    assert(IsErr(ws.WeightSafetensorsLoadHfRepository(hfJson, graph, hfBaseDir, peerIds, 1000)),
           " weight safetensors manifest smoke: hf repository unanchored graph hard fail")
    let unsupportedQuantConfigJson = "{\"quantization_config\":{\"quant_method\":\"gptq\",\"bits\":4,\"group_size\":128}}"
    assert(IsErr(ws.WeightSafetensorsLoadHfRepositoryWithConfig(hfJson, unsupportedQuantConfigJson, boundGraph, hfBaseDir, peerIds, 1000)),
           " weight safetensors manifest smoke: unsupported quant config hard fail")
    var hfDriftBytes0 = rawbytes.BytesSlice(hfBytes0, 0, rawbytes.BytesLen(hfBytes0))
    let hfDriftHeaderLen = ws.WeightSafetensorsHeaderLength(hfDriftBytes0)
    assert(IsOk(hfDriftHeaderLen),
           " weight safetensors manifest smoke: hf repository drift header")
    rawbytes.BytesSet(hfDriftBytes0, 8 + Value(hfDriftHeaderLen), 1)
    assert(IsOk(os.WriteFileBytesResult(hfPath0, hfDriftBytes0)),
           " weight safetensors manifest smoke: hf repository drift write")
    assert(IsErr(ws.WeightSafetensorsLoadHfRepository(hfJson, boundGraph, hfBaseDir, peerIds, 1000)),
           " weight safetensors manifest smoke: hf repository drift hard fail")
    assert(IsErr(ws.WeightSafetensorsBuildPayloadFromEntryRange(Value(hfBoundIndexRes), boundGraph, 0, 64)),
           " weight safetensors manifest smoke: hf bound range payload drift hard fail")

    let quantHfFile = strutil.Join([
        "cheng_weight_safetensors_quant_hf_",
        strings.Int64ToStr(quantBoundGraph.graphHash),
        ".safetensors"
    ], "")
    let quantHfPath = os.JoinPath(hfBaseDir, quantHfFile)
    if os.FileExists(quantHfPath):
        assert(os.RemoveFile(quantHfPath), " weight safetensors manifest smoke: remove quant hf file")
    var quantHfBytes = quantBytes
    assert(IsOk(os.WriteFileBytesResult(quantHfPath, quantHfBytes)),
           " weight safetensors manifest smoke: write quant hf file")
    let quantHfJson = safetensorsHfIndexJson(quantBoundGraph, 1, quantHfFile, quantHfFile, HfIndexValid)
    let quantConfigJson = "{\"quantization_config\":{\"quant_method\":\"symmetric_int8\",\"bits\":8}}"
    assert(IsErr(ws.WeightSafetensorsLoadHfRepository(quantHfJson, quantBoundGraph, hfBaseDir, quantPeers, 10)),
           " weight safetensors manifest smoke: quant hf missing config hard fail")
    let quantHfRepository = ws.WeightSafetensorsLoadHfRepositoryWithConfig(quantHfJson, quantConfigJson, quantBoundGraph, hfBaseDir, quantPeers, 10)
    assert(IsOk(quantHfRepository),
           " weight safetensors manifest smoke: quant hf repository load")
    assert(Value(quantHfRepository).receipt.quantConfigHash > int64(0) &&
           Value(quantHfRepository).load.store.storeHash == quantResult.store.storeHash,
           " weight safetensors manifest smoke: quant hf repository receipt")
    let quantConfigPath = strutil.Join([
        "/tmp/cheng_weight_safetensors_quant_config_",
        strings.Int64ToStr(quantBoundGraph.graphHash),
        ".json"
    ], "")
    if os.FileExists(quantConfigPath):
        assert(os.RemoveFile(quantConfigPath), " weight safetensors manifest smoke: remove quant config")
    var quantConfigBytes = rawbytes.BytesFromString(quantConfigJson)
    assert(IsOk(os.WriteFileBytesResult(quantConfigPath, quantConfigBytes)),
           " weight safetensors manifest smoke: write quant config")
    let quantIndexPath = strutil.Join([
        "/tmp/cheng_weight_safetensors_quant_index_",
        strings.Int64ToStr(quantBoundGraph.graphHash),
        ".json"
    ], "")
    if os.FileExists(quantIndexPath):
        assert(os.RemoveFile(quantIndexPath), " weight safetensors manifest smoke: remove quant index")
    var quantIndexBytes = rawbytes.BytesFromString(quantHfJson)
    assert(IsOk(os.WriteFileBytesResult(quantIndexPath, quantIndexBytes)),
           " weight safetensors manifest smoke: write quant index")
    let quantHfPathRepository = ws.WeightSafetensorsLoadHfRepositoryPathWithConfigPath(quantIndexPath, quantConfigPath, quantBoundGraph, hfBaseDir, quantPeers, 10)
    assert(IsOk(quantHfPathRepository),
           " weight safetensors manifest smoke: quant hf repository path load")
    assert(Value(quantHfPathRepository).receipt.receiptHash == Value(quantHfRepository).receipt.receiptHash,
           " weight safetensors manifest smoke: quant hf repository path hash")

    let int4HfFile = strutil.Join([
        "cheng_weight_safetensors_int4_hf_",
        strings.Int64ToStr(int4BoundGraph.graphHash),
        ".safetensors"
    ], "")
    let int4HfPath = os.JoinPath(hfBaseDir, int4HfFile)
    if os.FileExists(int4HfPath):
        assert(os.RemoveFile(int4HfPath), " weight safetensors manifest smoke: remove int4 hf file")
    var int4HfBytes = int4Bytes
    assert(IsOk(os.WriteFileBytesResult(int4HfPath, int4HfBytes)),
           " weight safetensors manifest smoke: write int4 hf file")
    let int4HfJson = safetensorsHfIndexJson(int4BoundGraph, 1, int4HfFile, int4HfFile, HfIndexValid)
    let int4ConfigJson = "{\"quantization_config\":{\"quant_method\":\"symmetric_int4\",\"bits\":4}}"
    assert(IsErr(ws.WeightSafetensorsLoadHfRepository(int4HfJson, int4BoundGraph, hfBaseDir, int4Peers, 10)),
           " weight safetensors manifest smoke: int4 hf missing config hard fail")
    assert(IsErr(ws.WeightSafetensorsLoadHfRepositoryWithConfig(int4HfJson, quantConfigJson, int4BoundGraph, hfBaseDir, int4Peers, 10)),
           " weight safetensors manifest smoke: int4 hf int8 config hard fail")
    let int4HfRepository = ws.WeightSafetensorsLoadHfRepositoryWithConfig(int4HfJson, int4ConfigJson, int4BoundGraph, hfBaseDir, int4Peers, 10)
    assert(IsOk(int4HfRepository),
           " weight safetensors manifest smoke: int4 hf repository load")
    assert(Value(int4HfRepository).receipt.quantConfigHash > int64(0) &&
           Value(int4HfRepository).load.store.storeHash == int4Result.store.storeHash,
           " weight safetensors manifest smoke: int4 hf repository receipt")

    let w4Afp8HfFile = strutil.Join([
        "cheng_weight_safetensors_w4afp8_hf_",
        strings.Int64ToStr(w4Afp8BoundGraph.graphHash),
        ".safetensors"
    ], "")
    let w4Afp8HfPath = os.JoinPath(hfBaseDir, w4Afp8HfFile)
    if os.FileExists(w4Afp8HfPath):
        assert(os.RemoveFile(w4Afp8HfPath), " weight safetensors manifest smoke: remove w4afp8 hf file")
    var w4Afp8HfBytes = w4Afp8Bytes
    assert(IsOk(os.WriteFileBytesResult(w4Afp8HfPath, w4Afp8HfBytes)),
           " weight safetensors manifest smoke: write w4afp8 hf file")
    let w4Afp8HfJson = safetensorsHfIndexJson(w4Afp8BoundGraph, 3, w4Afp8HfFile, w4Afp8HfFile, HfIndexValid)
    assert(IsErr(ws.WeightSafetensorsLoadHfRepository(w4Afp8HfJson, w4Afp8BoundGraph, hfBaseDir, w4Afp8Peers, 1000)),
           " weight safetensors manifest smoke: w4afp8 hf missing config hard fail")
    assert(IsErr(ws.WeightSafetensorsLoadHfRepositoryWithConfig(w4Afp8HfJson, quantConfigJson, w4Afp8BoundGraph, hfBaseDir, w4Afp8Peers, 1000)),
           " weight safetensors manifest smoke: w4afp8 hf int8 config hard fail")
    let w4Afp8HfRepository = ws.WeightSafetensorsLoadHfRepositoryWithConfig(w4Afp8HfJson, w4ConfigJson, w4Afp8BoundGraph, hfBaseDir, w4Afp8Peers, 1000)
    assert(IsOk(w4Afp8HfRepository),
           " weight safetensors manifest smoke: w4afp8 hf repository load")
    assert(Value(w4Afp8HfRepository).receipt.quantConfigHash > int64(0) &&
           Value(w4Afp8HfRepository).load.store.storeHash == w4Afp8Result.store.storeHash,
           " weight safetensors manifest smoke: w4afp8 hf repository receipt")

    assert(IsErr(ws.WeightSafetensorsShardIndexFromHfWeightMap("{\"metadata\":{\"total_size\":1}}", graph, hfBaseDir, peerIds, 1000)),
           " weight safetensors manifest smoke: hf missing weight_map hard fail")
    assert(IsErr(ws.WeightSafetensorsShardIndexFromHfWeightMap("{\"weight_map\":[]}", graph, hfBaseDir, peerIds, 1000)),
           " weight safetensors manifest smoke: hf weight_map object hard fail")
    assert(IsErr(ws.WeightSafetensorsShardIndexFromHfWeightMap(safetensorsHfIndexJson(graph, 3, hfFile0, hfFile1, HfIndexMissingTensor), graph, hfBaseDir, peerIds, 1000)),
           " weight safetensors manifest smoke: hf missing tensor hard fail")
    assert(IsErr(ws.WeightSafetensorsShardIndexFromHfWeightMap(safetensorsHfIndexJson(graph, 3, hfFile0, hfFile1, HfIndexPathTraversal), graph, hfBaseDir, peerIds, 1000)),
           " weight safetensors manifest smoke: hf traversal hard fail")
    assert(IsErr(ws.WeightSafetensorsShardIndexFromHfWeightMap(safetensorsHfIndexJson(graph, 3, hfFile0, hfFile1, HfIndexAbsolutePath), graph, hfBaseDir, peerIds, 1000)),
           " weight safetensors manifest smoke: hf absolute path hard fail")
    assert(IsErr(ws.WeightSafetensorsShardIndexFromHfWeightMap(safetensorsHfIndexJson(graph, 3, hfFile0, hfFile1, HfIndexBadSuffix), graph, hfBaseDir, peerIds, 1000)),
           " weight safetensors manifest smoke: hf bad suffix hard fail")
    let duplicateHfJson = strutil.Join([
        "{\"weight_map\":{\"embedding.weight\":\"",
        hfFile0,
        "\",\"embedding.weight\":\"",
        hfFile1,
        "\"}}"
    ], "")
    assert(IsErr(ws.WeightSafetensorsShardIndexFromHfWeightMap(duplicateHfJson, graph, hfBaseDir, peerIds, 1000)),
           " weight safetensors manifest smoke: hf duplicate key hard fail")
    var hfShortPeers: str[]
    add(hfShortPeers, "peer:short")
    assert(IsErr(ws.WeightSafetensorsShardIndexFromHfWeightMap(hfJson, graph, hfBaseDir, hfShortPeers, 1000)),
           " weight safetensors manifest smoke: hf peer count hard fail")
    assert(IsErr(ws.WeightSafetensorsShardIndexFromHfWeightMap(hfJson, graph, hfBaseDir, peerIds, 0)),
           " weight safetensors manifest smoke: hf tensor scale hard fail")

    var badHashIndex = shardIndex
    badHashIndex.indexHash = badHashIndex.indexHash + int64(1)
    assert(IsErr(ws.WeightSafetensorsLoadShardIndex(badHashIndex, graph)),
           " weight safetensors manifest smoke: index hash hard fail")

    var missingTensorEntries: ws.WeightSafetensorsShardIndexEntry[]
    for i in 0..<shardIndex.entries.len:
        var entry = shardIndex.entries[i]
        if i == 0:
            entry.filePath = shardPath1
        add(missingTensorEntries, entry)
    let missingTensorIndex = ws.WeightSafetensorsShardIndexBuild(graph.modelCid, graph.graphHash, missingTensorEntries)
    assert(IsErr(ws.WeightSafetensorsLoadShardIndex(missingTensorIndex, graph)),
           " weight safetensors manifest smoke: index file tensor hard fail")

    var emptyPeerEntries: ws.WeightSafetensorsShardIndexEntry[]
    for i in 0..<shardIndex.entries.len:
        var entry = shardIndex.entries[i]
        if i == 0:
            entry.peerId = ""
        add(emptyPeerEntries, entry)
    let emptyPeerIndex = ws.WeightSafetensorsShardIndexBuild(graph.modelCid, graph.graphHash, emptyPeerEntries)
    assert(IsErr(ws.WeightSafetensorsLoadShardIndex(emptyPeerIndex, graph)),
           " weight safetensors manifest smoke: index peer hard fail")

    var duplicateEntries: ws.WeightSafetensorsShardIndexEntry[]
    for i in 0..<shardIndex.entries.len:
        var entry = shardIndex.entries[i]
        if i == 1:
            entry = shardIndex.entries[0]
        add(duplicateEntries, entry)
    let duplicateIndex = ws.WeightSafetensorsShardIndexBuild(graph.modelCid, graph.graphHash, duplicateEntries)
    assert(IsErr(ws.WeightSafetensorsLoadShardIndex(duplicateIndex, graph)),
           " weight safetensors manifest smoke: duplicate index hard fail")

    var shortPeers: str[]
    add(shortPeers, "peer:short")
    assert(IsErr(ws.WeightSafetensorsLoadGraphFile(numericBytes, graph, shortPeers, 1000)),
           " weight safetensors manifest smoke: peer count hard fail")
    assert(IsErr(ws.WeightSafetensorsLoadGraphFile(numericBytes, graph, peerIds, 0)),
           " weight safetensors manifest smoke: tensor scale hard fail")

    var infBytes = numericBytes
    let headerLen = ws.WeightSafetensorsHeaderLength(infBytes)
    assert(IsOk(headerLen), " weight safetensors manifest smoke: numeric header len")
    writeF16LE(infBytes, 8 + Value(headerLen), 0x7c00)
    assert(IsErr(ws.WeightSafetensorsLoadGraphFile(infBytes, graph, peerIds, 1000)),
           " weight safetensors manifest smoke: f16 inf hard fail")
    assert(IsErr(ws.WeightSafetensorsDecodeBf16Scaled(0x7f80, 1000)),
           " weight safetensors manifest smoke: bf16 inf hard fail")

    echo(" weight_safetensors_manifest_smoke ok")
    return 0
