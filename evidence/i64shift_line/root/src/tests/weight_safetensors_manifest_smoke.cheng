    ], "")
    if os.FileExists(w4KernelPath):
        assert(os.RemoveFile(w4KernelPath), " weight safetensors manifest smoke: remove w4 kernel page file")
    var w4KernelFileBytes = w4KernelBytes
    assert(IsOk(os.WriteFileBytesResult(w4KernelPath, w4KernelFileBytes)),
           " weight safetensors manifest smoke: write w4 kernel page file")
    let w4KernelIndex = safetensorsShardIndexForGraph(
