import std/result
import std/rawbytes
import cheng/quic/tls/test_pki as testpki
import cheng/quic/tls/policy as policy
import cheng/apps/vpn_proxy/transport_tcp_tls_handshake as hs

fn main(): int32 =
    let tlsPolicy: policy.MsQuicTlsPolicy = testpki.msquicMakeLocalhostTransportTlsPolicy()
    let clientHelloRes: Result[Bytes] = hs.VpnProxyTcpTlsForwardClientBuildHello("localhost",
                                                                                 tlsPolicy.trustRoot0)
    if IsErr(clientHelloRes):
        echo(ErrorText(clientHelloRes))
        return 1
    let serverFlightRes: Result[hs.VpnProxyTcpTlsServerFlight] = hs.VpnProxyTcpTlsForwardServerBuildFlight(Value(clientHelloRes),
                                                                                                           tlsPolicy)
    if IsErr(serverFlightRes):
        echo(ErrorText(serverFlightRes))
        return 2
    echo(" vpn_proxy_tcp_tls_handshake_diag ok")
    return 0
