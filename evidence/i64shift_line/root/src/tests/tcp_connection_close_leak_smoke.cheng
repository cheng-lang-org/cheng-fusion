import std/system
import std/rawbytes
import std/strutils as strutil
import std/net/transports/tcp_syscall as tcp

# Verifies TcpClose frees the per-connection sockaddr buffers (localAddr.data +
# remoteAddr.data). Before the fix TcpClose leaked both (16-28B each, per
# connection); after the fix it owns and frees them, so churning connect/accept-
# style handles through TcpClose must show zero per-iteration live-allocation
# growth.
#
# The handle is constructed directly with owned bytesAlloc buffers (matching what
# the connect path produces via tcpGetSockName/tcpSockAddrFromHostPort, and what
# the accept path produces after the deep-copy fix). fd is left <0 so TcpClose
# skips the socket shutdown/close path and only exercises the address free.

fn main(): int32 =
    let iters: int32 = 500

    # Warm up one cycle so one-time allocator state falls outside the window.
    var w: tcp.TcpConnectionHandle
    w.fd = -1
    w.open = false
    w.localAddr.data = BytesAlloc(16)
    w.localAddr.len = 16
    w.remoteAddr.data = BytesAlloc(28)
    w.remoteAddr.len = 28
    tcp.TcpClose(w)

    let before: int64 = MemLiveAllocations()
    for i in 0..<iters:
        var conn: tcp.TcpConnectionHandle
        conn.fd = -1
        conn.open = false
        conn.localAddr.data = BytesAlloc(16)
        conn.localAddr.len = 16
        conn.remoteAddr.data = BytesAlloc(28)
        conn.remoteAddr.len = 28
        tcp.TcpClose(conn)
    let after: int64 = MemLiveAllocations()
    let delta: int64 = after - before
    echo(strutil.Join(["tcp_connection_close_leak_smoke iters=", IntToStr(iters),
                       " live_delta=", IntToStr(int32(delta))], ""))
    # Before the fix each iteration leaked 2 sockaddr buffers (localAddr + remoteAddr),
    # so 500 iterations grew live allocations by ~1000. After the fix TcpClose frees
    # them, so live growth must stay flat (small slack for allocator caching only).
    if delta > int64(8):
        echo("tcp_connection_close_leak_smoke FAILED: per-connection sockaddr leak")
        return 1
    echo("tcp_connection_close_leak_smoke ok")
    return 0
