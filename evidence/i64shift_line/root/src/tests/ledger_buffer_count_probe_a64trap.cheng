import std/cmdline as cmdline
import std/system
import cheng/core/tooling/lifetime_ledger as ledger

# Probe: a borrow-free ledger (the shape body_ir_lifecycle /
# backend2_fragment_lifecycle / backend2_assembler_lifecycle actually build)
# legitimately frees only 5 physical buffers, while all 6 storage sequences
# went through the release path. The gate must assert the structural count
# (releasedSequenceCount == 6) and keep the physical count as > 0.

fn probeWithBorrow(outSeqCount: var int32): int32 =
    var observed: ledger.LifetimeLedger
    ledger.LifetimeLedgerInit(observed)
    let category = ledger.LifetimeLedgerRegisterCategory(observed, "body_ir_payload")
    let ownerA = ledger.LifetimeLedgerRegisterOwner(observed, "lowering")
    let ownerB = ledger.LifetimeLedgerRegisterOwner(observed, "emitter")
    let objectA = ledger.LifetimeLedgerReserveObject(observed, category, int64(96))
    ledger.LifetimeLedgerOwn(observed, objectA, ownerA)
    let borrowA = ledger.LifetimeLedgerBorrow(observed, objectA, ownerB)
    ledger.LifetimeLedgerReturnBorrow(observed, objectA, borrowA, ownerB)
    ledger.LifetimeLedgerMove(observed, objectA, ownerA, ownerB)
    ledger.LifetimeLedgerRelease(observed, objectA, ownerB)
    ledger.LifetimeLedgerAssertOwnerClosed(observed, ownerA)
    ledger.LifetimeLedgerAssertOwnerClosed(observed, ownerB)
    ledger.LifetimeLedgerAssertClosed(observed)
    var metrics: ledger.LifetimeLedgerMetrics
    ledger.LifetimeLedgerReadTotalMetrics(observed, metrics)
    let receipt = ledger.LifetimeLedgerReleaseStorage(observed)
    outSeqCount = receipt.releasedSequenceCount
    return receipt.releasedSequenceBufferCount

fn probeWithoutBorrow(outSeqCount: var int32): int32 =
    var observed: ledger.LifetimeLedger
    ledger.LifetimeLedgerInit(observed)
    let category = ledger.LifetimeLedgerRegisterCategory(observed, "body_ir_payload")
    let ownerA = ledger.LifetimeLedgerRegisterOwner(observed, "lowering")
    let ownerB = ledger.LifetimeLedgerRegisterOwner(observed, "emitter")
    let objectA = ledger.LifetimeLedgerReserveObject(observed, category, int64(96))
    ledger.LifetimeLedgerOwn(observed, objectA, ownerA)
    ledger.LifetimeLedgerMove(observed, objectA, ownerA, ownerB)
    ledger.LifetimeLedgerRelease(observed, objectA, ownerB)
    ledger.LifetimeLedgerAssertOwnerClosed(observed, ownerA)
    ledger.LifetimeLedgerAssertOwnerClosed(observed, ownerB)
    ledger.LifetimeLedgerAssertClosed(observed)
    var metrics: ledger.LifetimeLedgerMetrics
    ledger.LifetimeLedgerReadTotalMetrics(observed, metrics)
    let receipt = ledger.LifetimeLedgerReleaseStorage(observed)
    outSeqCount = receipt.releasedSequenceCount
    return receipt.releasedSequenceBufferCount

fn main(argc: int32, argv: str*): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    var withBorrowSeq: int32 = 0
    var withoutBorrowSeq: int32 = 0
    let withBorrow = probeWithBorrow(withBorrowSeq)
    let withoutBorrow = probeWithoutBorrow(withoutBorrowSeq)
    echo(Fmt"with_borrow_buffer_count={withBorrow}")
    echo(Fmt"with_borrow_sequence_count={withBorrowSeq}")
    echo(Fmt"without_borrow_buffer_count={withoutBorrow}")
    echo(Fmt"without_borrow_sequence_count={withoutBorrowSeq}")
    echo(Fmt"gate_requires_sequence_count=6")
    echo(Fmt"gate_requires_buffer_count_positive=1")
    if withBorrowSeq != 6 || withoutBorrowSeq != 6:
        echo(Fmt"GATE_WOULD_REJECT structural_count_not_six with_borrow={withBorrowSeq} without_borrow={withoutBorrowSeq}")
        return 1
    if withBorrow <= 0 || withoutBorrow <= 0:
        echo(Fmt"GATE_WOULD_REJECT physical_count_not_positive with_borrow={withBorrow} without_borrow={withoutBorrow}")
        return 1
    echo(Fmt"both_paths_satisfy_gate")
    return 0
