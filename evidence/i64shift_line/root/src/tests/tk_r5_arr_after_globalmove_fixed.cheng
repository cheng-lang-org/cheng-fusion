type R5Task = object
    modulePath: str

var
    r5GlobalTasks: R5Task[]

fn R5Prepare(tasks: R5Task[]) =
    r5GlobalTasks = share(tasks)
    var total = 0
    for i in 0..<tasks.len:
        total = total + tasks[i].modulePath.len
    echo(Fmt"r5 prepared count={tasks.len} chars={total} global={r5GlobalTasks.len}")

fn main(): int32 =
    var made: R5Task[]
    var t: R5Task
    t.modulePath = "abc"
    add(made, t)
    var u: R5Task
    u.modulePath = "de"
    add(made, u)
    R5Prepare(made)
    if r5GlobalTasks.len != 2:
        return 10
    if r5GlobalTasks[0].modulePath != "abc":
        return 11
    if r5GlobalTasks[1].modulePath != "de":
        return 12
    echo("r5 fixed ok")
    return 0
