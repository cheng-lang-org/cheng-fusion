import std/system as system

type
    TkR3IdentB =
        size: int64
        mode: int32
        inode: uint64

fn TkR3FillB(seed: int64, mode: int32, inode: uint64, out: var TkR3IdentB): bool =
    if seed < int64(0):
        return false
    var next: TkR3IdentB
    next.size = seed
    next.mode = mode
    next.inode = inode
    out = next
    return true

fn main(): int32 =
    var a: TkR3IdentB
    var b: TkR3IdentB
    if !TkR3FillB(int64(1), int32(2), uint64(3), a):
        return 1
    if !TkR3FillB(int64(9007199254740993), int32(-31), uint64(18446744073709551615), b):
        return 2
    if a.size != int64(1) || a.mode != int32(2) || a.inode != uint64(3):
        return 3
    os.WriteLine(os.Get_stdout(),
        strings.ConcatStr(
            strings.Int64ToStr(b.size),
            strings.ConcatStr("/",
                strings.ConcatStr(
                    strings.Int64ToStr(int64(b.mode)),
                    strings.ConcatStr("/",
                        strings.ConcatStr(
                            strings.Int64ToStr(int64(a.size)),
                            strings.ConcatStr("/",
                                strings.Int64ToStr(int64(a.mode)))))))))
    return 0
