    if expectContains(dryReportText, "dry_compile_full_theory_model=full_compile_theory_deterministic_framework", "full theory model") != 0:
        return 1
    if expectContains(dryReportText, "dry_compile_full_theory_requires_real_validation=1", "real validation marker") != 0:
        return 1
    if expectContains(dryReportText, "dry_compile_full_theory_executes_codegen=0", "full theory no codegen") != 0:
