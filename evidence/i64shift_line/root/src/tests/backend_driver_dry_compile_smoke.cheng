    if expectContains(dryReportText, "full_compile_theory_rss_phase_typed_ir_fixed_bytes=", "rss typed IR fixed") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_rss_phase_typed_ir_per_worker_bytes=0", "rss typed IR per worker") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_rss_phase_lowering_fixed_bytes=", "rss lowering fixed") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_rss_phase_lowering_per_worker_bytes=", "rss lowering per worker") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_rss_phase_primary_fixed_bytes=", "rss primary fixed") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_rss_phase_primary_per_worker_bytes=", "rss primary per worker") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_rss_memory_limited_max_jobs=", "rss memory-limited jobs") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_rss_memory_limited_effective_jobs=", "rss memory-limited effective jobs") != 0:
        return 1
    if expectNotContains(dryReportText, "full_compile_theory_rss_lower_bound_bytes=", "legacy rss lower bound key") != 0:
        return 1
    if expectNotContains(dryReportText, "full_compile_theory_rss_budget_upper_bound_bytes=", "legacy rss budget upper key") != 0:
        return 1
    if expectNotContains(dryReportText, "full_compile_theory_rss_guard_recommended_bytes=", "legacy rss guard key") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_time_phase_source_ns=", "time source") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_time_phase_typed_ir_ms=", "time typed ir") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_time_phase_provider_ns=0", "time provider zero") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_time_phase_link_ms=", "time link") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_time_phase_report_ms=", "time report") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_time_serial_phase_ms=", "time serial") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_time_parallelizable_phase_ms=", "time parallel") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_time_lower_bound_ms=", "full time lower bound") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_time_budget_upper_bound_ms=", "full time budget upper") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_time_effective_jobs=", "full time jobs") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_size_object_lower_bound_bytes=", "size object lower") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_size_provider_lower_bound_bytes=0", "size provider lower") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_size_final_artifact_budget_upper_bound_bytes=", "size final budget") != 0:
        return 1
    if expectContains(dryReportText, "exec_phase_compiler_csg_ms=0", "csg zero") != 0:
        return 1
    if expectContains(dryReportText, "exec_phase_lowering_plan_ms=0", "lowering zero") != 0:
        return 1
    if expectContains(dryReportText, "exec_phase_primary_object_plan_ms=0", "primary zero") != 0:
        return 1
    if strings.StrContains(dryRun.output, "compile_progress phase=compiler_csg status=begin"):
        return fail("dry progress reported compiler_csg")

    let badReport = os.JoinPath(outDir, "dry_compile_bad_emit.report.txt")
    let badLog = os.JoinPath(outDir, "dry_compile_bad_emit.log")
    if os.FileExists(badReport):
        os.RemoveFile(badReport)
    if os.FileExists(badLog):
        os.RemoveFile(badLog)
    let badRun = hostops.RunFileLogged(root,
                                        "backend_driver_dry_compile_smoke_bad_emit",
                                        driver,
                                        [
                                            "dry-compile",
                                            strutil.Join(["--root:", root], ""),
                                            strutil.Join(["--in:", drySource], ""),
                                            "--emit:bogus",
                                            strutil.Join(["--report-out:", badReport], "")
                                        ],
                                        [],
                                        root,
                                        0,
                                        badLog)
    if badRun.exitCode == 0:
        return fail("bad emit accepted")
    echo("cheng backend_driver_dry_compile_smoke ok")
    return 0
