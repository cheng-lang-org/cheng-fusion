    if expectContains(dryReportText, "full_compile_theory_rss_phase_source_fixed_bytes=", "rss source fixed") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_rss_phase_source_per_worker_bytes=0", "rss source per worker") != 0:
