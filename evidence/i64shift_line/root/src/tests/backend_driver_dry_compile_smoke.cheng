import std/os
import std/strings
import std/strutils as strutil
import cheng/core/tooling/host_ops as hostops
import cheng/core/tooling/path as chengpath

fn fail(message: str): int32 =
    echo(strutil.Join(["backend_driver_dry_compile_smoke FAIL: ", message], ""))
    return 1

fn boolText(value: bool): str =
    if value:
        return "1"
    return "0"

fn blocker(outDir: str,
           driver: str,
           dryReport: str,
           dryLog: str,
           exitCode: int32,
           blockerId: str,
           reason: str): int32 =
    let blockerPath = os.JoinPath(outDir, "backend_driver_dry_compile_smoke.blocker.txt")
    let blockerText = strutil.Join([
        "backend_driver_dry_compile_smoke=blocked\n",
        "blocker_id=", blockerId, "\n",
        "driver=", driver, "\n",
        "dry_report=", dryReport, "\n",
        "dry_log=", dryLog, "\n",
        "dry_exit_code=", strings.IntToStr(exitCode), "\n",
        "dry_report_exists=", boolText(os.FileExists(dryReport)), "\n",
        "rss_guard_bytes=8589934592\n",
        "expected_command=dry-compile\n",
        "expected_compiler_impl=pure_cheng_backend_driver\n",
        "reason=", reason, "\n"
    ], "")
    let _written = chengpath.WriteTextFile("", blockerPath, blockerText)
    echo(strutil.Join(["backend_driver_dry_compile_smoke BLOCKED: ", blockerId, ": ", reason], ""))
    return 2

fn looksStaleOrColdDryCompile(output: str,
                              reportText: str): bool =
    if strings.StrContains(output, "cheng_cold: FAIL"):
        return true
    if strings.StrContains(output, "unknown command"):
        return true
    if len(reportText) > 0 &&
       !strings.StrContains(reportText, "compiler_impl=pure_cheng_backend_driver"):
        return true
    return false

fn expectContains(text: str,
                  needle: str,
                  label: str): int32 =
    if strings.StrContains(text, needle):
        return 0
    return fail(strutil.Join(["missing ", label], ""))

fn expectNotContains(text: str,
                     needle: str,
                     label: str): int32 =
    if !strings.StrContains(text, needle):
        return 0
    return fail(strutil.Join(["forbidden ", label], ""))

fn main(): int32 =
    let root = os.GetCurrentDir()
    var driver = os.JoinPath(root, "artifacts/backend_driver/cheng")
    let explicitDriver = strutil.Strip(os.GetEnv("CHENG_SMOKE_COMPILER"))
    if len(explicitDriver) > 0:
        driver = chengpath.PathAbsolute(root, explicitDriver)
    if !os.FileExists(driver):
        return fail("driver missing")
    let outDir = chengpath.PathAbsolute(root, "artifacts/backend_driver_dry_compile_smoke")
    if !chengpath.MkdirP(root, outDir):
        return fail("mkdir failed")
    let drySource = os.JoinPath(root, "src/tests/int32_add_direct_object_smoke.cheng")
    let dryReport = os.JoinPath(outDir, "dry_compile.report.txt")
    let dryLog = os.JoinPath(outDir, "dry_compile.log")
    let dryOutput = os.JoinPath(root, "artifacts/dry-compile/dry-output")
    if os.FileExists(dryReport):
        os.RemoveFile(dryReport)
    if os.FileExists(dryLog):
        os.RemoveFile(dryLog)
    if os.FileExists(dryOutput):
        os.RemoveFile(dryOutput)
    let blockerPath = os.JoinPath(outDir, "backend_driver_dry_compile_smoke.blocker.txt")
    if os.FileExists(blockerPath):
        os.RemoveFile(blockerPath)
    let dryRun = hostops.RunFileLogged(root,
                                        "backend_driver_dry_compile_smoke_run",
                                        driver,
                                        [
                                            "dry-compile",
                                            strutil.Join(["--root:", root], ""),
                                            strutil.Join(["--in:", drySource], ""),
                                            "--emit:exe",
                                            "--target:arm64-apple-darwin",
                                            strutil.Join(["--report-out:", dryReport], "")
                                        ],
                                        [
                                            "CHENG_PROGRESS=1",
                                            "CHENG_PROCESS_MAX_RSS_BYTES=8589934592"
                                        ],
                                        root,
                                        0,
                                        dryLog)
    if dryRun.exitCode != 0:
        if looksStaleOrColdDryCompile(dryRun.output, "") || !os.FileExists(dryReport):
            return blocker(outDir,
                           driver,
                           dryReport,
                           dryLog,
                           dryRun.exitCode,
                           "stale_or_cold_subset_backend_driver_artifact",
                           "driver did not execute the pure Cheng dry-compile command surface")
        return fail("dry-compile rc")
    if !os.FileExists(dryReport):
        return fail("dry report missing")
    if os.FileExists(dryOutput):
        return fail("dry default output generated")
    let dryReportText = os.ReadFile(dryReport)
    if looksStaleOrColdDryCompile(dryRun.output, dryReportText):
        return blocker(outDir,
                       driver,
                       dryReport,
                       dryLog,
                       dryRun.exitCode,
                       "stale_or_cold_subset_backend_driver_artifact",
                       "dry report is not emitted by the pure Cheng backend driver")
    if expectContains(dryReportText, "dry_compile=1", "dry success") != 0:
        return 1
    if expectContains(dryReportText, "dry_compile_executes_codegen=0", "no codegen") != 0:
        return 1
    if expectContains(dryReportText, "compile_parallel_theory_scope=dry_compile_precheck", "dry theory scope") != 0:
        return 1
    if expectContains(dryReportText, "compile_parallel_theory_lower_bound_ms=", "theory lower bound") != 0:
        return 1
    if expectContains(dryReportText, "compile_parallel_real_scope=dry_compile_precheck", "real scope") != 0:
        return 1
    if expectContains(dryReportText, "compile_parallel_real_executes_codegen=0", "real no codegen") != 0:
        return 1
    if expectContains(dryReportText, "dry_compile_memory_theory_scope=dry_compile_source_scan", "memory scope") != 0:
        return 1
    if expectContains(dryReportText, "dry_compile_memory_theory_lower_bound_bytes=", "memory lower bound") != 0:
        return 1
    if expectContains(dryReportText, "dry_compile_predicts_full_compile_rss=0", "not full rss predictor") != 0:
        return 1
    if expectContains(dryReportText, "dry_compile_decision_scope=source_closure_triage_only", "dry decision scope") != 0:
        return 1
    if expectContains(dryReportText, "dry_compile_input_contract_model=full_compile_theory_deterministic_framework", "input model") != 0:
        return 1
    if expectContains(dryReportText, "dry_compile_input_contract_target_triple=arm64-apple-darwin", "input target") != 0:
        return 1
    if expectContains(dryReportText, "dry_compile_input_contract_emit_kind=exe", "input emit") != 0:
        return 1
    if expectContains(dryReportText, "dry_compile_input_contract_entry_source=", "input entry source") != 0:
        return 1
    if expectContains(dryReportText, "dry_compile_input_contract_provider_state=disabled", "input provider state") != 0:
        return 1
    if expectContains(dryReportText, "dry_compile_input_contract_link_state=disabled", "input link state") != 0:
        return 1
    if expectContains(dryReportText, "dry_compile_input_contract_cache_state=none", "input cache state") != 0:
        return 1
    if expectContains(dryReportText, "dry_compile_input_contract_backend_jobs=", "input backend jobs") != 0:
        return 1
    if expectContains(dryReportText, "dry_compile_input_contract_effective_jobs=", "input effective jobs") != 0:
        return 1
    if expectContains(dryReportText, "dry_compile_input_contract_memory_limit_bytes=", "input memory limit") != 0:
