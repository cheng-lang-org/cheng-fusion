    if expectContains(dryReportText, "full_compile_theory_phase_link_input_bytes=0", "phase link bytes") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_compiler_csg_estimated_nodes=", "csg nodes theory") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_lowering_estimated_body_ir_ops=", "lowering theory") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_primary_estimated_instruction_words=", "primary theory") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_scope=non_exhaustive_modeled_compile_estimate_without_codegen_execution", "full theory non-exhaustive scope") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_rss_model_scope=non_exhaustive_modeled_components", "rss model scope") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_rss_estimate_status=non_exhaustive_modeled_estimate_not_proven_upper_bound", "rss estimate status") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_rss_modeled_peak_estimate_bytes=", "rss peak theory") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_rss_phase_csg_structured_bytes=", "rss csg structured") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_rss_modeled_retention_model=phase_lifetime_max_with_explicit_release", "rss retention model") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_rss_single_phase_peak_name=", "rss single phase peak") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_rss_single_phase_max_structured_bytes=", "rss single phase max") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_rss_legacy_retained_cumulative_estimate_bytes=", "rss legacy retained estimate") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_rss_capacity_bytes=", "rss capacity") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_rss_orc_bytes=", "rss orc") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_rss_arena_bytes=", "rss arena") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_rss_allocator_classified_sum_bytes=", "rss allocator classified sum") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_rss_allocator_modeled_bytes=", "rss allocator modeled") != 0:
