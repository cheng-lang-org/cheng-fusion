    if expectContains(dryReportText, "full_compile_theory_requires_real_validation=1", "full theory validation required") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_calibration_source=phase_memory_ledger", "calibration source") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_validation_status=unvalidated", "validation status") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_source_closure_decl_estimate=", "decl estimate") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_source_closure_function_estimate=", "function estimate") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_source_closure_export_estimate=", "export estimate") != 0:
        return 1
    if expectContains(dryReportText, "full_compile_theory_source_closure_importc_estimate=", "importc estimate") != 0:
