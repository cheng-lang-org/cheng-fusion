type
    BoolExprBox =
        compared: bool
        combined: bool
        negated: bool

fn main(): int32 =
    let value: int32 = 7
    var box: BoolExprBox
    box.compared = value == 7
    box.combined = value == 7 && value != 8
    box.negated = !false
    if !box.compared:
        return 1
    if !box.combined:
        return 2
    if !box.negated:
        return 3
    return 0
