# shape: two-level nested FIXED-SIZE array, tail field scalar, VARIABLE
# indices (non-zero outer index, to guard against an always-index-0 collapse
# coincidentally matching a zero-valued test index).
type
    Col =
        a: int32
        b: int32

type
    Row =
        cols: Col[4]

type
    Grid =
        rows: Row[4]

fn main(): int32 =
    var g: Grid
    g.rows[0].cols[0].a = 1
    g.rows[1].cols[0].a = 3
    g.rows[1].cols[1].a = 4

    var i: int32 = 1
    var j: int32 = 1
    g.rows[i].cols[j].a = 999

    if g.rows[1].cols[1].a != 999:
        return 1
    if g.rows[1].cols[0].a != 3:
        return 2
    if g.rows[0].cols[0].a != 1:
        return 3
    return 0
