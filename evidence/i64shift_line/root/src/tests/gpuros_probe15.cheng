@profile("driver_safe")

type
    IoUInt8Ptr = uint8 *
    IoUInt32Ptr = uint32 *

@trusted_abi
fn IoLd32(base: uint64, offset: uint64): uint32 =
    let b = base
    let o = offset
    let addr = ptr(b + o)
    return *(IoUInt32Ptr(addr))

@trusted_abi
fn IoSt8(base: uint64, offset: uint64, value: int32) =
    let b = base
    let o = offset
    let addr = ptr(b + o)
    *(IoUInt8Ptr(addr)) = uint8(value & 255)

@trusted_abi
fn IoRamSt32(base: uint64, byteOffset: int32, value: uint32) =
    let b = base
    let o = byteOffset
    let addr = ptr(b + uint64(o))
    *(IoUInt32Ptr(addr)) = value

@trusted_abi
fn IoRamLd32(base: uint64, byteOffset: int32): uint32 =
    let b = base
    let o = byteOffset
    let addr = ptr(b + uint64(o))
    return *(IoUInt32Ptr(addr))

fn HexNib(v: uint32) =
    let w = v
    if w < 10:
        IoSt8(268435456, 0, int32(48 + w))
    else:
        IoSt8(268435456, 0, int32(87 + w))

fn Hex32(v: uint32) =
    var div = uint32(268435456)
    while div > uint32(0):
        HexNib((v / div) & uint32(15))
        div = div / uint32(16)

fn Sep() =
    IoSt8(268435456, 0, 32)

fn main(): int32 =
    var i = 0
    while i < 4:
        IoRamSt32(2191466496, i * 4, uint32(305419896 + uint32(i)))
        i = i + 1
    var j = 0
    while j < 4:
        Hex32(IoRamLd32(2191466496, j * 4))
        Sep()
        j = j + 1
    IoSt8(268435456, 0, 10)
    return 0
