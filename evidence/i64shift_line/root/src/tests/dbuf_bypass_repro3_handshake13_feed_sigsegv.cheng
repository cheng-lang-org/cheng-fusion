# D-v2 验收夹具 repro3: handshake13.cheng 成帧循环(msquicTls13HandshakeFeed)
# 同一类旁路缺陷同构复现——用真实生产函数(msquicTls13SideFeed/
# msquicTls13ResetClientWireState)直接驱动，不是抽象类比。
#
# 旧旁路代码在一条消息被完整消费后 `state.wire.buffer.data = emptyBytes()`
# (以及 remaining>0 分支的 BytesSlice 直写)不同步 `.len`；第二次 Feed 时
# `bytebuffer.AppendBytes` 用旧的(排空前的) stale len 去 memcpy 一个已经是
# nil 的 `.data.data` -> SIGSEGV。第一条消息用未知 kind，命中
# msquicTls13HandshakeHandleMessage 末尾的透传分支，不需要真实握手/证书。

import std/result
import std/rawbytes
import cheng/quic/tls/handshake13 as hs13

fn makeHandshakeMsg(kind: int32, body: str): Bytes =
    let bodyBytes: Bytes = BytesFromString(body)
    let bodyLen: int32 = BytesLen(bodyBytes)
    var out: Bytes = BytesAlloc(4 + bodyLen)
    BytesSet(out, 0, kind)
    BytesSet(out, 1, (bodyLen >> 16) & 255)
    BytesSet(out, 2, (bodyLen >> 8) & 255)
    BytesSet(out, 3, bodyLen & 255)
    var i: int32
    for i in 0..<bodyLen:
        BytesSet(out, 4 + i, BytesGet(bodyBytes, i))
    return out

fn main(): int32 =
    hs13.msquicTls13ResetClientWireState()

    let msg1: Bytes = makeHandshakeMsg(200, "hi")
    let feed1 = hs13.msquicTls13SideFeed(0, msg1)
    assert(IsOk(feed1), " dbuf_bypass_repro3: feed1")
    assert(Value(feed1) == 1, " dbuf_bypass_repro3: feed1 message count")
    assert(hs13.msquicTls13ClientBufferedHandshakeBytes() == 0, " dbuf_bypass_repro3: buffer drained after full message")

    # 崩溃点: 排空后再 Feed 第二条消息。旧旁路代码在这里 SIGSEGV。
    let msg2: Bytes = makeHandshakeMsg(201, "ok")
    let feed2 = hs13.msquicTls13SideFeed(0, msg2)
    assert(IsOk(feed2), " dbuf_bypass_repro3: feed2 (post-drain, crash site under bypass)")
    assert(Value(feed2) == 1, " dbuf_bypass_repro3: feed2 message count")
    assert(hs13.msquicTls13ClientBufferedHandshakeBytes() == 0, " dbuf_bypass_repro3: buffer drained again")
    assert(hs13.msquicTls13ClientHandshakeMessageCount() == 2, " dbuf_bypass_repro3: total message count")

    echo(" dbuf_bypass_repro3_handshake13_feed_sigsegv ok")
    return 0
