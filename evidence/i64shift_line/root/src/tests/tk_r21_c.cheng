type
    R21EntryC =
        profileIndex: int32
        items: str[]

fn R21AppendC(out: var str[], name: str) =
    add(out, name)

fn R21NamesC(cache: var R21EntryC[], profileIndex: int32): str[] =
    var out: str[]
    R21AppendC(out, "alpha")
    var entry: R21EntryC
    entry.profileIndex = profileIndex
    entry.items = out
    add(cache, entry)
    return out

fn main(): int32 =
    var cache: R21EntryC[]
    let names = R21NamesC(cache, 0)
    if names.len != 1:
        return 10
    echo("r21 c ok")
    return 0
