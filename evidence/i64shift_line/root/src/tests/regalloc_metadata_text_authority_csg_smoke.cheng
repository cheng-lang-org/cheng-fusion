import std/system
import cheng/core/backend/metadata_text_authority as metadataauthority

fn main(): int32 =
    assert(metadataauthority.MetadataTextStable("metadata"),
           "regalloc metadata text CSG authority")
    assert(!metadataauthority.MetadataTextStable("bad\x00metadata"),
           "regalloc metadata text CSG invalid byte")
    return 0
