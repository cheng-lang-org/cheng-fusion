import std/strutils as strutil
import std/result
import std/rawbytes as rawbytes
import std/os as os
import std/net/transports/tcp_syscall as tcp

fn main(): int32 =
    var listener: tcp.TcpListenerHandle
    let listenRes: Result[bool] = tcp.TcpListen4Fill("127.0.0.1", 18095, listener)
    if IsErr(listenRes):
        puts(strutil.Join(["listen err=", ErrorText(listenRes)], ""))
        return 1
    puts(strutil.Join(["listen ok fd=", IntToStr(listener.fd)], ""))
    for i in 0..<4:
        puts(strutil.Join(["iter ", IntToStr(i), " preconnect errno=", IntToStr(os.UdpErrno())], ""))
        let connRes: Result[tcp.TcpConnectionHandle] = tcp.TcpConnect4Timeout("127.0.0.1", 18095, 2000)
        if IsErr(connRes):
            puts(strutil.Join(["iter ", IntToStr(i), " connect err=", ErrorText(connRes), " errno=", IntToStr(os.UdpErrno())], ""))
            tcp.TcpListenerClose(listener)
            return 1
        var conn: tcp.TcpConnectionHandle = Value(connRes)
        var accepted: tcp.TcpConnectionHandle
        let okAccept: bool = tcp.TcpAcceptInto(listener, accepted)
        if okAccept:
            tcp.TcpClose(accepted)
        let recvRes: Result[rawbytes.Bytes] = tcp.TcpRecv(conn, 256)
        if IsErr(recvRes):
            puts(strutil.Join(["iter ", IntToStr(i), " recv err=", ErrorText(recvRes), " errno=", IntToStr(os.UdpErrno())], ""))
        else:
            puts(strutil.Join(["iter ", IntToStr(i), " recv bytes=", IntToStr(Value(recvRes).len), " errno=", IntToStr(os.UdpErrno())], ""))
        tcp.TcpClose(conn)
        puts(strutil.Join(["iter ", IntToStr(i), " errnoAfterConnClose=", IntToStr(os.UdpErrno())], ""))
    tcp.TcpListenerClose(listener)
    puts("loop done")
    return 0
