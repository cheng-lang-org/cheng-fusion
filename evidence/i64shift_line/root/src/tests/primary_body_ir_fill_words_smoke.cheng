import cheng/core/backend/primary_object_plan as pobj
import cheng/core/ir/core_types as coreir

fn localI32(id: int32, offset: int32): coreir.LocalSlot =
    var slot: coreir.LocalSlot
    slot.id = id
    slot.typeKind = coreir.LocalI32Tag
    slot.stackOffset = offset
    slot.sizeBytes = 4
    slot.alignBytes = 4
    coreir.BodyIRApplyLocalSlotDefaultProof(slot)
    return slot

fn main(): int32 =
    var body: coreir.BodyIR
    add(body.localSlots, localI32(0, 0))
    add(body.localSlots, localI32(1, 4))
    var op: coreir.BodyOp
    op.kind = coreir.BodyOpLoadConstTag
    op.target = 1
    add(op.operands, coreir.LocalI32Tag)
    add(op.operands, 21)
    add(body.ops, op)
    var term: coreir.BodyTerm
    term.kind = coreir.BodyTermReturnTag
    term.resultSlot = 1
    let termIndex = coreir.BodyIRAppendTerm(body, term)
    coreir.BodyIRAppendBlock(body, 0, 1, termIndex)
    let wordCount = pobj.PrimaryBodyIrWordCount(body)
    if wordCount <= 0 || wordCount > 100:
        return 100
    var words: int32[]
    for i in 0..<wordCount:
        add(words, 0)
    let prologueCount = pobj.PrimaryBodyIrPrologueWordCount(body)
    let afterPrologue = pobj.PrimaryBodyIRFillPrologue(words, 0, body)
    if afterPrologue < 0:
        return 11
    if afterPrologue != prologueCount:
        return 12
    let emitted = pobj.PrimaryBodyIRFillWords(words, 0, wordCount, body)
    if emitted < 0:
        return 10
    if emitted != wordCount:
        return 20 + emitted
    if wordCount <= 4:
        return 2
    if words[4] == 0:
        return 3
    return 0
