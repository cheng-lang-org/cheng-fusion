# libp2p P3 正片: channel-head 传输动词 (HEAD_REQ/HEAD_RESP) 线格式往返 + 畸形硬拒 (正典 §11.6 P3)。
# 自足 exe (无网络无 CAS 状态), 断言失败即 abort 非零, 末行 "ok" 才打印。照 cas_source_codec 模式。
# 覆盖: REQ 往返 (33B/tag 0x11); RESP found 往返 (203B/tag 0x12/status 1); RESP miss (2B/status 0);
#       畸形穷举 (REQ 长/tag; RESP 截断/tag/status 非法/found 帧长/head_wire 非 201) 一律 decode 拒。

import std/system
import std/result
import std/rawbytes as rawbytes
import cheng/std/bytes_layout as layout
import cheng/libp2p/protocols/cas_source/channel_head/head_transport_codec as ht

fn mkCid(seed: int32): layout.FixedBytes32 =
    var b = BytesAlloc(32)
    for i in 0..<32:
        BytesSet(b, i, (seed * 17 + i + 3) & 255)
    let r = layout.FixedBytes32FromBytes(b)
    assert(!IsErr(r), " mkCid 32B")
    return Value(r)

fn mkWire201(seed: int32): Bytes =
    var b = BytesAlloc(201)
    for i in 0..<201:
        BytesSet(b, i, (seed * 7 + i) & 255)
    BytesSet(b, 0, 0x10)   # head 记录 tag
    return b

fn main(): int32 =
    # ---- HEAD_REQ 往返 ----
    let cid = mkCid(11)
    var reqWire = ht.CasHeadReqEncode(cid)
    assert(BytesLen(reqWire) == 33, " REQ wire = 33B")
    assert(BytesGet(reqWire, 0) == 0x11, " REQ tag 0x11")
    var reqDecRes = ht.CasHeadReqDecode(reqWire)
    assert(!IsErr(reqDecRes), " REQ decode ok: " + Error(reqDecRes))
    assert(layout.FixedBytes32Equal(Value(reqDecRes), cid), " REQ 往返 channelId 精确")

    # REQ 畸形: 长度错 / tag 错
    assert(IsErr(ht.CasHeadReqDecode(BytesSlice(reqWire, 0, 32))), " REQ 畸形: 32B 截断拒")
    var reqBadTag = BytesAlloc(33)
    for i in 0..<33:
        BytesSet(reqBadTag, i, BytesGet(reqWire, i))
    BytesSet(reqBadTag, 0, 0x01)   # 冒充 WANT tag
    assert(IsErr(ht.CasHeadReqDecode(reqBadTag)), " REQ 畸形: tag 非 0x11 拒")

    # ---- HEAD_RESP found 往返 ----
    var hw = mkWire201(23)
    var respFoundRes = ht.CasHeadRespEncodeFound(hw)
    assert(!IsErr(respFoundRes), " RESP found encode: " + Error(respFoundRes))
    var respFound = Value(respFoundRes)
    assert(BytesLen(respFound) == 203, " RESP found = 203B")
    assert(BytesGet(respFound, 0) == 0x12, " RESP tag 0x12")
    assert(BytesGet(respFound, 1) == 1, " RESP status 1 (found)")
    var rfDecRes = ht.CasHeadRespDecode(respFound)
    assert(!IsErr(rfDecRes), " RESP found decode: " + Error(rfDecRes))
    var rfDec = Value(rfDecRes)
    assert(rfDec.found, " RESP found decode.found == true")
    assert(rawbytes.BytesEqual(rfDec.headWire, hw), " RESP found 往返 head_wire 精确")

    # RESP found encode 拒非 201B head_wire
    assert(IsErr(ht.CasHeadRespEncodeFound(BytesAlloc(200))), " RESP found encode 拒 200B head_wire")

    # ---- HEAD_RESP miss 往返 ----
    var respMiss = ht.CasHeadRespEncodeMiss()
    assert(BytesLen(respMiss) == 2, " RESP miss = 2B")
    assert(BytesGet(respMiss, 1) == 0, " RESP miss status 0")
    var rmDecRes = ht.CasHeadRespDecode(respMiss)
    assert(!IsErr(rmDecRes), " RESP miss decode")
    assert(!Value(rmDecRes).found, " RESP miss decode.found == false")

    # ---- RESP 畸形穷举 ----
    assert(IsErr(ht.CasHeadRespDecode(BytesAlloc(1))), " RESP 畸形: 1B header 截断拒")
    var respBadTag = BytesAlloc(2)
    BytesSet(respBadTag, 0, 0x99)
    assert(IsErr(ht.CasHeadRespDecode(respBadTag)), " RESP 畸形: tag 非 0x12 拒")
    var respBadStatus = BytesAlloc(2)
    BytesSet(respBadStatus, 0, 0x12)
    BytesSet(respBadStatus, 1, 0x05)   # status 非 0/1
    assert(IsErr(ht.CasHeadRespDecode(respBadStatus)), " RESP 畸形: status 非 0/1 拒")
    # found 但帧长非 203 (status=1, 只给 10 字节)
    var respShort = BytesAlloc(10)
    BytesSet(respShort, 0, 0x12)
    BytesSet(respShort, 1, 0x01)
    assert(IsErr(ht.CasHeadRespDecode(respShort)), " RESP 畸形: found 帧长非 203 拒")
    # miss 但帧长非 2 (status=0, 给 5 字节尾残)
    var respMissLong = BytesAlloc(5)
    BytesSet(respMissLong, 0, 0x12)
    BytesSet(respMissLong, 1, 0x00)
    assert(IsErr(ht.CasHeadRespDecode(respMissLong)), " RESP 畸形: miss 帧长非 2 拒 (尾残)")

    echo(" cas_head_transport_codec_roundtrip_smoke ok")
    return 0
