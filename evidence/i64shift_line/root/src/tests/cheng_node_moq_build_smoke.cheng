import cheng/moq/moq_fountain as moq
import std/strutils as strutil

fn main(): int32 =
    let buildRes = moq.MoqFountainBuild(BytesFromString("moq-fountain-smoke"),
                                        "peer-alpha",
                                        "peer-bravo,peer-charlie",
                                        "video/mp4",
                                        8,
                                        4,
                                        2)
    if IsErr(buildRes):
        echo(strutil.Join(["moq_build_err=", Error(buildRes)], ""))
        return 1
    let result = Value(buildRes)
    let catalogText = BytesToString(result.catalogPayload)
    assert(strutil.Contains(catalogText, "\"transport\":\"moq\""),
           "moq build: catalog transport is moq")
    assert(strutil.Contains(catalogText, "\"fountainLayout\":\"lt_xor_v1\""),
           "moq build: catalog layout is lt_xor_v1")
    assert(!strutil.Contains(catalogText, "native_media_rpc"),
           "moq build: catalog hides native media rpc carriage")
    echo(strutil.Join(["catalog_key=", result.catalogKey], ""))
    echo(strutil.Join(["object_count=", IntToStr(result.objects.len)], ""))
    echo(strutil.Join(["droplet_count=", IntToStr(result.droplets.len)], ""))
    return 0
