import std/strutils as strutil
import std/strings
import cheng/core/lang/parser
import cheng/core/lang/typed_expr as texpr
import cheng/core/lang/typed_expr_type_arena as typearena
import cheng/std/bytes_layout as layout

@borrows
fn lookupDeclaration(
        index: texpr.TypedExprBuildIndex,
        sourcePath: str,
        name: str,
        kind: texpr.TypedExprCallDeclarationKind): int32 =
    var row: int32 = -1
    var rank: int32
    var explicitMismatch: bool
    var argTypes = ["int32"]
    var noGenericTypes: str[]
    let state =
        texpr.TypedExprBuildIndexLookupCallDeclarationInSource(
            index,
            sourcePath,
            name,
            kind,
            argTypes,
            noGenericTypes,
            false,
            row,
            rank,
            explicitMismatch)
    assert(state == texpr.TypedExprBuildIndexUnique &&
           row >= 0 && rank > 0 && !explicitMismatch,
           Fmt"typed expr exact call TypeId: declaration lookup failed name={name}")
    return row

fn main(): int32 =
    let sourcePath = "/fixture/call_result_exact_type.cheng"
    let sourceText = strutil.Join(
        ["@im",
         "portc(\"native_probe\")\n",
         "fn NativeProbe(value: int32): int32\n",
         "fn Ordinary(value: int32): int32 = value\n",
         "fn Main(): int32 = Ordinary(NativeProbe(7))\n"],
        "")

    var layer: parser.NormalizedExprLayer
    var err: str
    assert(parser.ParserValueExprReadTreeFromText(
               sourceText, layer.valueExprTree, err),
           Fmt"typed expr exact call TypeId: parser failed {err}")
    let authority =
        typearena.TypedExprTypeResolutionAuthorityEmpty()
    var exactArena: typearena.TypedExprTypeArena
    assert(typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               layer.valueExprTree, authority, exactArena, err) &&
           typearena.TypedExprTypeArenaStrictValidateInto(
               exactArena, err),
           Fmt"typed expr exact call TypeId: TypeArena failed {err}")

    var externalRoots: parser.ParserExternalPackageRoot[]
    let sourcePathForContext = strings.CloneStr(sourcePath)
    let source =
        texpr.TypedExprSourceTextNewWithPackageFacts(
            "/fixture",
            "/fixture",
            "pkg://fixture/call-result-exact-type",
            "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
            externalRoots,
            sourcePathForContext,
            sourceText)
    var context: texpr.TypedExprSourceContext
    assert(texpr.TypedExprBuildSourceContext(source, context, err),
           Fmt"typed expr exact call TypeId: metadata failed {err}")
    var contexts: texpr.TypedExprSourceContext[]
    texpr.TypedExprSourceContextAppendMove(contexts, context)

    var ir: texpr.TypedExprIr
    assert(texpr.TypedExprIrBindExactTypeArena(
               ir, exactArena, err),
           Fmt"typed expr exact call TypeId: bind failed {err}")
    texpr.TypedExprIrBeginValueExprBorrow(ir, layer)
    texpr.TypedExprBuildSourceContextIndex(ir, contexts)
    let declarationIndex =
        texpr.TypedExprIrCallDeclarationBuildIndex(ir)
    assert(declarationIndex != nil &&
           declarationIndex.callDeclarationSealed,
           "typed expr exact call TypeId: declaration authority missing")

    let ordinaryRow =
        lookupDeclaration(
            declarationIndex,
            sourcePath,
            "Ordinary",
            texpr.TypedExprCallDeclarationFunction)
    let importcRow =
        lookupDeclaration(
            declarationIndex,
            sourcePath,
            "NativeProbe",
            texpr.TypedExprCallDeclarationImportc)
    assert(ordinaryRow != importcRow,
           "typed expr exact call TypeId: declaration identities collapsed")
    let ordinaryTypeId =
        texpr.TypedExprIrExactCallReturnTypeIdAt(ir, ordinaryRow)
    let importcTypeId =
        texpr.TypedExprIrExactCallReturnTypeIdAt(ir, importcRow)
    assert(ordinaryTypeId >= 0 &&
           importcTypeId >= 0 &&
           ordinaryTypeId == importcTypeId &&
           ordinaryTypeId <
               typearena.TypedExprTypeArenaTypeCount(ir.exactTypeArena),
           "typed expr exact call TypeId: exact return identity drift")
    assert(ir.valueDefinitionTypeArenaBound &&
           layout.FixedBytes32Equal(
               ir.valueDefinitionTypeArenaArtifactCid,
               ir.exactTypeArena.artifactRaw32),
           "typed expr exact call TypeId: TypeArena artifact identity drift")

    texpr.TypedExprIrEndValueExprBorrow(ir)
    assert(texpr.TypedExprIrSealExactTypeArena(
               ir, exactArena, err),
           Fmt"typed expr exact call TypeId: TypeArena seal failed {err}")
    texpr.TypedExprIrReleasePayload(ir)
    typearena.TypedExprTypeArenaRelease(exactArena)
    var releaseReceipt: parser.NormalizedExprLayerTerminalReleaseReceipt
    parser.NormalizedExprLayerTerminalReleaseWithReceipt(
        layer, releaseReceipt)
    assert(releaseReceipt.storageReleased,
           "typed expr exact call TypeId: parser layer release failed")
    echo(Fmt"typed_expr_call_result_exact_type_status=pass ordinary_type_id={ordinaryTypeId} importc_type_id={importcTypeId}")
    return 0
