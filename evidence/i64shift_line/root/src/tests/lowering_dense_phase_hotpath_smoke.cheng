import cheng/core/backend/lowering_plan as lower
import cheng/core/tooling/path as chengpath
import cheng/core/lang/parser
import cheng/core/lang/typed_expr as texpr
import std/strutils as strutil

fn reportFieldValue(report: str, key: str): str =
    let taggedReport = strutil.Join(["\n", report], "")
    let needle = strutil.Join(["\n", key, "="], "")
    let fieldPos = parser.ParserFindText(taggedReport, needle)
    if fieldPos < 0:
        return ""
    let valueStart = fieldPos + needle.len
    let tail = chengpath.TextSlice(taggedReport, valueStart, taggedReport.len - valueStart)
    let newlinePos = parser.ParserFindText(tail, "\n")
    if newlinePos < 0:
        return tail
    if newlinePos == 0:
        return ""
    return chengpath.TextSlice(tail, 0, newlinePos)

fn reportFieldPositive(report: str, key: str): bool =
    let value = reportFieldValue(report, key)
    return value != "" && value != "0"

fn makeFunction(sourcePath: str,
                functionName: str,
                statementStart: int32,
                statementCount: int32): texpr.TypedExprIrFunction =
    var fnIr: texpr.TypedExprIrFunction
    fnIr.sourcePath = sourcePath
    fnIr.functionName = functionName
    fnIr.signatureLineNumber = 1 + statementStart
    fnIr.bodyLineNumber = 2 + statementStart
    fnIr.returnType = "int32"
    fnIr.statementStart = statementStart
    fnIr.statementCount = statementCount
    fnIr.nodeStart = 0
    fnIr.nodeCount = 0
    fnIr.returnNodeIndex = -1
    return fnIr

fn makeCallStmt(sourcePath: str,
                functionName: str,
                statementIndex: int32,
                lineNumber: int32,
                target: str): texpr.TypedExprIrStatement =
    var stmt: texpr.TypedExprIrStatement
    stmt.sourcePath = sourcePath
    stmt.functionName = functionName
    stmt.statementIndex = statementIndex
    stmt.lineNumber = lineNumber
    stmt.kind = texpr.TypedExprIrStmtCall
    stmt.callKind = texpr.TypedExprCallNone
    stmt.callCallee = target
    stmt.callTarget = target
    stmt.callTargetSourcePath = sourcePath
    stmt.callArgCount = 0
    stmt.resultType = "int32"
    return stmt

fn makeReturnStmt(sourcePath: str,
                  functionName: str,
                  statementIndex: int32,
                  lineNumber: int32): texpr.TypedExprIrStatement =
    var stmt: texpr.TypedExprIrStatement
    stmt.sourcePath = sourcePath
    stmt.functionName = functionName
    stmt.statementIndex = statementIndex
    stmt.lineNumber = lineNumber
    stmt.kind = texpr.TypedExprIrStmtReturn
    stmt.resultType = "int32"
    stmt.returnRoot = true
    return stmt

fn main(): int32 =
    let sourcePath = "src/tests/lowering_dense_phase_hotpath_smoke.cheng"
    var plan: lower.LoweringPlanStub
    plan.entryPath = sourcePath
    plan.entrySymbol = "Entry"
    add(plan.functionSourcePaths, sourcePath)
    add(plan.functionNames, "Entry")
    add(plan.functionEntryFlags, 1)
    add(plan.functionSourcePaths, sourcePath)
    add(plan.functionNames, "Helper")
    add(plan.functionEntryFlags, 0)
    add(plan.typedIr.functions, makeFunction(sourcePath, "Entry", 0, 2))
    add(plan.typedIr.functions, makeFunction(sourcePath, "Helper", 2, 1))
    add(plan.typedIr.statements, makeCallStmt(sourcePath, "Entry", 0, 2, "Helper"))
    add(plan.typedIr.statements, makeReturnStmt(sourcePath, "Entry", 1, 3))
    add(plan.typedIr.statements, makeReturnStmt(sourcePath, "Helper", 2, 5))

    lower.LoweringBuildTypedFunctionIndex(plan)
    assert(lower.LoweringPlanTypedIrFunctionIndex(plan, sourcePath, "Entry") == 0,
           " lowering dense phase hotpath: entry dense lookup")
    assert(lower.LoweringPlanTypedIrFunctionIndex(plan, sourcePath, "Helper") == 1,
           " lowering dense phase hotpath: helper dense lookup")

    var sourceTexts: texpr.TypedExprSourceText[]
    var buildFlags: bool[]
    add(buildFlags, true)
    add(buildFlags, true)
    lower.LoweringBuildPrimaryObjectIrInPlan(plan, sourceTexts, buildFlags)

    let report = lower.LoweringPlanStubReport(plan)
    assert(reportFieldPositive(report, "lowering_dense_store_query_count"),
           " lowering dense phase hotpath: dense query count")
    assert(reportFieldPositive(report, "lowering_dense_store_hit_count"),
           " lowering dense phase hotpath: dense hit count")
    assert(reportFieldValue(report, "lowering_dense_store_fallback_scan_count") == "0",
           " lowering dense phase hotpath: no fallback scan")
    assert(reportFieldPositive(report, "lowering_phase_arena_reset_count"),
           " lowering dense phase hotpath: phase reset count")
    assert(reportFieldPositive(report, "lowering_phase_arena_reserve_count"),
           " lowering dense phase hotpath: phase reserve count")
    assert(reportFieldPositive(report, "lowering_phase_arena_peak_bytes"),
           " lowering dense phase hotpath: phase peak bytes")
    assert(reportFieldValue(report, "lowering_phase_arena_spill_count") == "0",
           " lowering dense phase hotpath: no phase spill")
    assert(reportFieldPositive(report, "phase_arena_peak_bytes"),
           " lowering dense phase hotpath: generic phase peak bytes")
    assert(reportFieldValue(report, "phase_arena_spill_count") == "0",
           " lowering dense phase hotpath: generic no phase spill")
    echo(" lowering_dense_phase_hotpath_smoke ok")
    return 0
