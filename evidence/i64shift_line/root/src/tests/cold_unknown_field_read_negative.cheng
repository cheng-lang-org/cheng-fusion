# Negative fixture for miscompile family member #5 (findings.md 2026-06-12):
# reading a nonexistent struct field MUST be a compile-time error.
# Before the fix the cold compiler silently emitted constant 0.
# Expected: cold compile FAILS with "unknown field 'nosuchfield'".

type
    P =
        a: int32
        b: int32

fn main(): int32 =
    var p: P
    p.a = 1
    p.b = 2
    let z: int32 = p.nosuchfield
    return z
