fn SortInts(values0: int32[]): int32[] =
    var values = values0
    var i: int32
    for i in range(values.len):

        for j in i + 1..<values.len:
            if values[j] < values[i]:
                let tmp = values[i]
                values[i] = values[j]
                values[j] = tmp

    return values

fn main(): int32 =
    var xs: int32[]
    add(xs, 3)
    add(xs, 1)
    add(xs, 2)
    let sorted = SortInts(xs)
    if sorted[0] == 1 && sorted[1] == 2 && sorted[2] == 3:
        return 0
    return 1
