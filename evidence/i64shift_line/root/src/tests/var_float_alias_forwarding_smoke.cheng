type
    VarFloatAlias = float64

fn VarFloatAliasWrite(out: var VarFloatAlias, value: float64) =
    out = value

fn VarFloatAliasForward(out: var VarFloatAlias) =
    VarFloatAliasWrite(out, 9.5)
    out = out + 0.25

fn main(): int32 =
    var value: VarFloatAlias = 1.0
    VarFloatAliasForward(value)
    if value != 9.75:
        return 1
    echo("var_float_alias_forwarding_smoke ok")
    return 0
