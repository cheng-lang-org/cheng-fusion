import cheng/core/ir/body_ir_noalias as noalias
import cheng/tests/noalias_finalize_stage_probe_lib as probe

fn main(): int32 =
    let bodyIR = probe.ProbeForwardBody(true)
    let _known = noalias.BodyIrNoAliasIntSeqInit(bodyIR.localSlots.len, -1)
    let _op = noalias.BodyIrNoAliasCloneOp(bodyIR.ops[0])
    let _term = noalias.BodyIrNoAliasForwardTerm(bodyIR.terms[0], _known)
    return 77
