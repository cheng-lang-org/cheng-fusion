# libp2p P3 正片: 请求方 (B) 客户端 exe (正典 §11.6 P3 网络接线主门)。
# B 真两进程之另一: 空库空 TOFU 从一个 channelId (内容地址) 出发, 真 UDP dial 发布方 →
# 拉签名 head → 完整验证链 (每环可观测断言) → 解出 headCid → 走既有 CAS fetch 拉源 →
# 三方 sha256 恒等 → 过校验才进 B 的 CAS。任一环失败 = 硬错拒收, B 库零污染。
#
# 验证链 (--expect positive):
#   ① FetchCasHead: 拉 head → decode (channelId==sha256(pubkey) 自证绑定) → verify (真 ed25519)
#      → 请求绑定 (返回 channelId == 请求)  —— 三重在 Libp2pHostQuicFetchCasHead 内, 返回即已验。
#   ② TofuAdmit: 首见 admit / epoch 单调前进 (换钥/回滚硬拒)。
#   ③ 解 headCid = 已验 record.headCid。
#   ④ FetchCasSource([headCid]): 拉块 + 内容寻址 sha256(data)==cid 硬校验 (既有函数内)。
#   ⑤ 三方恒等: 签名 head 的 headCid == CAS 校验的 cid == B 重算 sha256(源字节), 三者全等。
#   ⑥ CasAdmitFetchedBytes: cid 自校验后 ingest 进 B 的 CAS (幂等)。
#
# 负路径 (--expect reject-fetch / reject-tofu): 对应环硬错; 断言 IsErr + B TOFU epoch 未动
# (零污染)。reject-fetch = 验签/绑定/请求绑定拒 (forge/tamper/keychange); reject-tofu = 回滚拒。
#
# 用法: --port <bound> --store-root <B dir> --channel-id-hex <hex> --expect <mode>
#       [--expected-source-content <s>] [--prior-epoch E]

import std/system
import std/result
import std/cmdline as cmdline
import std/rawbytes as rawbytes
import cheng/std/bytes_layout as layout
import cheng/libp2p/cas_store as cas
import cheng/libp2p/protocols/cas_source/codec as codec
import cheng/libp2p/protocols/cas_source/channel_head/head_codec as head
import cheng/libp2p/protocols/cas_source/channel_head/tofu as tofu
import cheng/libp2p/host/host_quic as hq
import std/strutils as strutil
import std/strings as strings

# B 侧 TOFU epoch 快照 (零污染断言用): 缺库/缺记录 = -1。
fn tofuEpochFor(storeRoot: str, channelIdHex: str): int64 =
    var loadRes = tofu.TofuLoad(storeRoot)
    if IsErr(loadRes):
        return int64(-1)
    let look = tofu.TofuLookup(Value(loadRes), channelIdHex)
    if !look.found:
        return int64(-1)
    return look.epoch

fn main(): int32 =
    let port = cmdline.ReadInt32FlagOrDefault("--port", -1)
    let storeRoot = cmdline.ReadFlagOrDefault("--store-root", "")
    let channelIdHex = cmdline.ReadFlagOrDefault("--channel-id-hex", "")
    let expect = cmdline.ReadFlagOrDefault("--expect", "positive")
    let expectedSource = cmdline.ReadFlagOrDefault("--expected-source-content", "")
    let priorEpoch = int64(cmdline.ReadInt32FlagOrDefault("--prior-epoch", -1))
    assert(port > 0, " client: --port required")
    assert(storeRoot != "", " client: --store-root required")
    assert(channelIdHex != "", " client: --channel-id-hex required")

    let cidRes = layout.FixedBytes32FromHex(channelIdHex)
    assert(cidRes.ok, " client: channel-id-hex 非 32B hex: " + Error(cidRes))
    let channelId = cidRes.value

    # ---- ① 拉 head + 验签 + 绑定 + 请求绑定 ----
    var record: head.ChannelHeadRecord
    let fetchHeadRes = hq.Libp2pHostQuicFetchCasHead("127.0.0.1", port, "localhost", channelId, record)

    if expect == "reject-fetch":
        assert(IsErr(fetchHeadRes), " 负路径 reject-fetch: FetchCasHead 必须硬错拒收")
        # 零污染: B 的 TOFU epoch 未动 (仍为 priorEpoch)。
        let nowEpoch = tofuEpochFor(storeRoot, channelIdHex)
        assert(nowEpoch == priorEpoch, " reject-fetch 零污染: TOFU epoch 未动 (have=" + strings.Int64ToStr(nowEpoch) + " prior=" + strings.Int64ToStr(priorEpoch) + ")")
        echo(strutil.Join([" cas_head client REJECT-FETCH ok reason=", Error(fetchHeadRes)], ""))
        echo(" cas_head_source_client ok")
        return 0

    assert(fetchHeadRes.ok, " ① 拉 head + 验签/绑定链: " + Error(fetchHeadRes))
    # 已验记录: 自证绑定 (decode) + ed25519 验签 + 请求绑定 三重都在 FetchCasHead 内通过。
    assert(layout.FixedBytes32Equal(record.channelId, channelId), " ① 请求绑定: record.channelId == 请求 channelId")
    let expectSelfCid = head.ChannelIdForPubKey(record.signerPubKey)
    assert(layout.FixedBytes32Equal(expectSelfCid, record.channelId), " ① 自证绑定: channelId == sha256(signerPubKey)")
    assert(head.ChannelHeadVerify(record), " ① 复核 ed25519 verify(record) == true")

    let headCid = record.headCid
    let headCidHex = layout.FixedBytes32Hex(headCid)
    echo(strutil.Join([" cas_head client fetched+verified head epoch=", strings.Int64ToStr(record.epoch),
                       " head_cid=", headCidHex], ""))

    # ---- ② TOFU admit (首见/单调前进/回滚拒) ----
    var admitRes = tofu.TofuAdmit(storeRoot, record.channelId, record.signerPubKey, record.epoch)

    if expect == "reject-tofu":
        assert(IsErr(admitRes), " 负路径 reject-tofu: TofuAdmit 必须硬错 (回滚/换钥拒)")
        let nowEpoch = tofuEpochFor(storeRoot, channelIdHex)
        assert(nowEpoch == priorEpoch, " reject-tofu 零污染: TOFU epoch 未动 (have=" + strings.Int64ToStr(nowEpoch) + " prior=" + strings.Int64ToStr(priorEpoch) + ")")
        echo(strutil.Join([" cas_head client REJECT-TOFU ok reason=", Error(admitRes)], ""))
        echo(" cas_head_source_client ok")
        return 0

    assert(admitRes.ok, " ② TofuAdmit: " + Error(admitRes))
    let admittedEpoch = tofuEpochFor(storeRoot, channelIdHex)
    assert(admittedEpoch == record.epoch, " ② TOFU 落库 epoch == head epoch (" + strings.Int64ToStr(admittedEpoch) + ")")

    # ---- ③④ 解 headCid → 拉源 (内容寻址硬校验在 FetchCasSource 内) ----
    var wantCids: layout.FixedBytes32[]
    add(wantCids, headCid)
    var outBlocks: codec.CasSourceBlockEntry[]
    let fetchSrcRes = hq.Libp2pHostQuicFetchCasSource("127.0.0.1", port, "localhost", wantCids, outBlocks)
    assert(fetchSrcRes.ok, " ④ FetchCasSource: " + Error(fetchSrcRes))
    assert(outBlocks.len == 1, " ④ 恰好 1 块回")
    assert(layout.FixedBytes32Equal(outBlocks[0].cid, headCid), " ④ 块 cid == headCid")

    # ---- ⑤ 三方 sha256 恒等 ----
    let rederived = cas.CasContentCidBytes(outBlocks[0].data)
    assert(layout.FixedBytes32Equal(rederived, headCid), " ⑤a B 重算 sha256(源) == headCid (签名 head 所指)")
    assert(layout.FixedBytes32Equal(rederived, record.headCid), " ⑤b B 重算 sha256(源) == record.headCid")
    assert(layout.FixedBytes32Equal(record.headCid, outBlocks[0].cid), " ⑤c 签名 headCid == CAS 校验 cid (三方全等)")

    # ---- ⑥ CAS admission (cid 自校验后 ingest 进 B 库) ----
    var admitBytes = outBlocks[0].data
    let casAdmitRes = cas.CasAdmitFetchedBytes(storeRoot, headCidHex, admitBytes)
    assert(casAdmitRes.ok, " ⑥ CasAdmitFetchedBytes: " + Error(casAdmitRes))
    assert(cas.CasStoreHas(storeRoot, headCidHex), " ⑥ B 的 CAS 现有该 blob")

    if expectedSource != "":
        let expectedBytes = rawbytes.BytesFromString(expectedSource)
        assert(rawbytes.BytesEqual(outBlocks[0].data, expectedBytes), " ⑤d 源字节精确 == 期望内容")

    echo(strutil.Join([" cas_head client POSITIVE ok epoch=", strings.Int64ToStr(record.epoch),
                       " head_cid=", headCidHex,
                       " src_bytes=", IntToStr(BytesLen(outBlocks[0].data))], ""))
    echo(" cas_head_source_client ok")
    return 0
