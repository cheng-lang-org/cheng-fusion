type ColdManagedExactCfgConsumedRef = ref object
    marker: int32

fn ColdManagedExactCfgUseAfterMaybeMove(consume: bool): int32 =
    var value = new(ColdManagedExactCfgConsumedRef)
    value.marker = 73
    var sink: ColdManagedExactCfgConsumedRef[]
    if consume:
        add(sink, value)
    return value.marker

fn main(): int32 =
    return ColdManagedExactCfgUseAfterMaybeMove(true)
