type
    Prop =
        routeIndex: int32
        name: str

type
    Graph =
        props: Prop[]

var
    gGraph: Graph

fn readProp(graph: var Graph, i: int32): str =
    if i < 0 || i >= graph.props.len:
        return ""
    return graph.props[i].name

fn sumRoutes(): int32 =
    var total: int32 = 0
    for i in 0..<gGraph.props.len:
        let v = readProp(gGraph, i)
        total = total + gGraph.props[i].routeIndex
    return total

fn main(): int32 =
    return 0
