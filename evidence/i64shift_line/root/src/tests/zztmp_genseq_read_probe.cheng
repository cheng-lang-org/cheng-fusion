fn GenericSeqRead[T](vals: T[], i: int32, out: var T): bool =
    out = vals[i]
    return true

fn main(): int32 =
    var vals: str[]
    setLen(vals, 4)
    vals[1] = "value-17"
    var out: str
    if !GenericSeqRead[str](vals, 1, out):
        return 41
    echo(Fmt"generic_str_len={out.len}")
    echo(out)
    var ints: int32[]
    setLen(ints, 4)
    ints[2] = 777
    var iout: int32
    if !GenericSeqRead[int32](ints, 2, iout):
        return 43
    echo(Fmt"generic_int={iout}")
    if out == "value-17" && iout == 777:
        return 0
    return 42
