import cheng/core/ir/body_ir_noalias as noalias
import cheng/tests/noalias_finalize_stage_probe_lib as probe

fn main(): int32 =
    var bodyIR = probe.ProbeForwardBody(true)
    let report = noalias.BodyIrNoAliasFinalize(bodyIR)
    if !report.applied:
        return 51
    if report.localCount != 2:
        return 52
    if report.forwardRewriteCount != 2:
        return 53
    return report.bodyIR.terms[0].resultSlot
