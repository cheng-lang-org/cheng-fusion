    let tiedGraph = Value(tiedGraphRes)
    assert(tiedGraph.weights.len == 34 &&
           findWeightIndex(tiedGraph, "lm_head.weight") < 0 &&
           tiedGraph.ops[tiedGraph.ops.len - 1].weightNames[0] == "model.embed_tokens.weight",
           " hf model graph smoke: tied lm head")

    let execGraphRes = hfgraph.HfModelGraphBuildGlmMoeFromConfig(
        hfExecutableConfig(false),
        "cid:model:hf-glm-moe-exec",
        kir.KernelDtypeFp16,
        mg.ModelQuantSchemeNone
    )
    assert(IsOk(execGraphRes), " hf model graph smoke: executable graph")
    let execFixture = buildExecFixture(Value(execGraphRes))
    let tokenIds = makeTensor([1], 1, [0])
    let routeRes = exec.ModelExecutorBuildHfGlmMoeRoutePlan(
        execFixture.graph,
        execFixture.bindings,
        execFixture.store,
        tokenIds,
        2
    )
    assert(IsOk(routeRes), " hf model graph smoke: executable route")
    let routePlan = Value(routeRes)
    let routeSetRes = exec.ModelExecutorBuildHfGlmMoeRoutePlanSet(
        execFixture.graph,
        execFixture.bindings,
        execFixture.store,
        tokenIds,
        2
    )
    assert(IsOk(routeSetRes), " hf model graph smoke: executable route set")
    let execRes = exec.ModelExecutorExecuteHfGlmMoeSingleToken(
        execFixture.graph,
        execFixture.bindings,
        execFixture.store,
        tokenIds,
        routePlan
    )
    assert(IsOk(execRes), " hf model graph smoke: executable run")
    let execOut = Value(execRes)
    assert(execOut.logits.shape.len == 2 &&
           execOut.logits.shape[0] == 1 &&
           execOut.logits.shape[1] == 16 &&
           execOut.routePlanSet.routeSetHash == Value(routeSetRes).routeSetHash &&
           execOut.executionHash > int64(0),
           " hf model graph smoke: executable logits")
    let repeatExec = exec.ModelExecutorExecuteHfGlmMoeSingleToken(
        execFixture.graph,
        execFixture.bindings,
        execFixture.store,
        tokenIds,
        routePlan
    )
    assert(IsOk(repeatExec) &&
           Value(repeatExec).executionHash == execOut.executionHash,
           " hf model graph smoke: executable deterministic")
    let w4ExecGraph = hfGraphWithSingleW4Afp8Weight(
        Value(execGraphRes),
        "model.layers.0.self_attn.q_proj.weight"
    )
    let w4Fixture = buildExecFixture(w4ExecGraph)
    let w4RouteSet = exec.ModelExecutorBuildHfGlmMoeRoutePlanSet(
        w4Fixture.graph,
        w4Fixture.bindings,
        w4Fixture.store,
        tokenIds,
        2
    )
    assert(IsOk(w4RouteSet) &&
           Value(w4RouteSet).layerRoutes.len == 1,
           " hf model graph smoke: w4afp8 route set")
    let w4CpuExec = exec.ModelExecutorExecuteHfGlmMoeSingleTokenWithRouteSet(
        w4Fixture.graph,
        w4Fixture.bindings,
        w4Fixture.store,
        tokenIds,
        Value(w4RouteSet)
    )
    if IsErr(w4CpuExec):
        echo(Error(w4CpuExec))
    assert(IsOk(w4CpuExec) &&
           Value(w4CpuExec).routePlanSet.routeSetHash == Value(w4RouteSet).routeSetHash &&
           Value(w4CpuExec).logits.shape.len == 2 &&
           Value(w4CpuExec).logits.shape[0] == 1 &&
           Value(w4CpuExec).logits.shape[1] == 16,
           " hf model graph smoke: w4afp8 graph execution")
    var badRoute = routePlan
    badRoute.routeHash = badRoute.routeHash + int64(1)
    assert(IsErr(exec.ModelExecutorExecuteHfGlmMoeSingleToken(
        execFixture.graph,
        execFixture.bindings,
        execFixture.store,
        tokenIds,
        badRoute
    )), " hf model graph smoke: route drift hard fail")
    var badRouteSet = Value(routeSetRes)
    badRouteSet.routeSetHash = badRouteSet.routeSetHash + int64(1)
    assert(IsErr(exec.ModelExecutorExecuteHfGlmMoeSingleTokenWithRouteSet(
        execFixture.graph,
        execFixture.bindings,
        execFixture.store,
        tokenIds,
        badRouteSet
    )), " hf model graph smoke: route set drift hard fail")

    let multiLayerGraphRes = hfgraph.HfModelGraphBuildGlmMoeFromConfig(
        hfExecutableConfigLayers(false, 2),
        "cid:model:hf-glm-moe-exec-2-layer",
        kir.KernelDtypeFp16,
        mg.ModelQuantSchemeNone
    )
    assert(IsOk(multiLayerGraphRes), " hf model graph smoke: executable multilayer graph")
    let multiLayerFixture = buildExecFixture(Value(multiLayerGraphRes))
    let multiRouteSet = exec.ModelExecutorBuildHfGlmMoeRoutePlanSet(
        multiLayerFixture.graph,
        multiLayerFixture.bindings,
        multiLayerFixture.store,
        tokenIds,
        2
    )
    assert(IsOk(multiRouteSet) &&
           Value(multiRouteSet).layerRoutes.len == 2,
           " hf model graph smoke: executable multilayer route set")
    let multiExec = exec.ModelExecutorExecuteHfGlmMoeSingleTokenWithRouteSet(
        multiLayerFixture.graph,
        multiLayerFixture.bindings,
        multiLayerFixture.store,
        tokenIds,
        Value(multiRouteSet)
    )
    assert(IsOk(multiExec) &&
           Value(multiExec).routePlanSet.routeSetHash == Value(multiRouteSet).routeSetHash &&
           Value(multiExec).logits.shape[1] == 16,
           " hf model graph smoke: executable multilayer run")
    let twoLayerFixture = buildExecFixture(fp16Graph)
    let groupedRouteSet = exec.ModelExecutorBuildHfGlmMoeRoutePlanSet(
        twoLayerFixture.graph,
        twoLayerFixture.bindings,
        twoLayerFixture.store,
        tokenIds,
        2
    )
    assert(IsOk(groupedRouteSet) &&
           Value(groupedRouteSet).layerRoutes.len == 2,
           " hf model graph smoke: grouped kv route set")
    let groupedExec = exec.ModelExecutorExecuteHfGlmMoeSingleTokenWithRouteSet(
        twoLayerFixture.graph,
        twoLayerFixture.bindings,
        twoLayerFixture.store,
        tokenIds,
        Value(groupedRouteSet)
    )
    assert(IsOk(groupedExec) &&
           Value(groupedExec).routePlanSet.routeSetHash == Value(groupedRouteSet).routeSetHash &&
           Value(groupedExec).logits.shape.len == 2 &&
           Value(groupedExec).logits.shape[0] == 1 &&
           Value(groupedExec).logits.shape[1] == 32,
           " hf model graph smoke: grouped kv paged attention run")
    let tokenIds2 = makeTensor([2], 1, [0, 1])
    let groupedPrefillRouteSet = exec.ModelExecutorBuildHfGlmMoeRoutePlanSet(
        twoLayerFixture.graph,
        twoLayerFixture.bindings,
        twoLayerFixture.store,
        tokenIds2,
        4
    )
    assert(IsOk(groupedPrefillRouteSet) &&
           Value(groupedPrefillRouteSet).layerRoutes.len == 2 &&
           Value(groupedPrefillRouteSet).layerRoutes[0].routePlan.tokenCount == 2,
           " hf model graph smoke: grouped kv prefill route set")
    let groupedPrefillExec = exec.ModelExecutorExecuteHfGlmMoeTokensWithRouteSet(
        twoLayerFixture.graph,
        twoLayerFixture.bindings,
        twoLayerFixture.store,
        tokenIds2,
        Value(groupedPrefillRouteSet)
    )
    assert(IsOk(groupedPrefillExec) &&
           Value(groupedPrefillExec).routePlanSet.routeSetHash == Value(groupedPrefillRouteSet).routeSetHash &&
           Value(groupedPrefillExec).logits.shape.len == 2 &&
           Value(groupedPrefillExec).logits.shape[0] == 2 &&
           Value(groupedPrefillExec).logits.shape[1] == 32,
           " hf model graph smoke: grouped kv two token prefill")
    let repeatPrefillExec = exec.ModelExecutorExecuteHfGlmMoeTokensWithRouteSet(
        twoLayerFixture.graph,
        twoLayerFixture.bindings,
        twoLayerFixture.store,
        tokenIds2,
        Value(groupedPrefillRouteSet)
    )
    assert(IsOk(repeatPrefillExec) &&
           Value(repeatPrefillExec).executionHash == Value(groupedPrefillExec).executionHash,
           " hf model graph smoke: grouped kv prefill deterministic")
    let tokenIds3 = makeTensor([3], 1, [0, 1, 2])
    let fullPrefillRouteSet = exec.ModelExecutorBuildHfGlmMoeRoutePlanSet(
        twoLayerFixture.graph,
        twoLayerFixture.bindings,
        twoLayerFixture.store,
        tokenIds3,
        6
    )
    assert(IsOk(fullPrefillRouteSet) &&
           Value(fullPrefillRouteSet).layerRoutes.len == 2 &&
           Value(fullPrefillRouteSet).layerRoutes[0].routePlan.tokenCount == 3,
           " hf model graph smoke: kv full prefill route set")
    let fullPrefillWithKv = exec.ModelExecutorExecuteHfGlmMoePrefillWithKvState(
        twoLayerFixture.graph,
        twoLayerFixture.bindings,
        twoLayerFixture.store,
        tokenIds3,
        Value(fullPrefillRouteSet)
    )
    assert(IsOk(fullPrefillWithKv), " hf model graph smoke: kv full prefill run")
    let fullKvOut = Value(fullPrefillWithKv)
    assert(fullKvOut.kvStateSet.layerStates.len == 2 &&
           fullKvOut.kvStateSet.layerStates[0].seq.tokenCount == 3 &&
           fullKvOut.kvStateSet.layerStates[1].seq.tokenCount == 3,
           " hf model graph smoke: kv full prefill state")
    let prefixRouteSet = exec.ModelExecutorBuildHfGlmMoeRoutePlanSet(
        twoLayerFixture.graph,
        twoLayerFixture.bindings,
        twoLayerFixture.store,
        tokenIds2,
        6
    )
    assert(IsOk(prefixRouteSet), " hf model graph smoke: kv prefix route set")
    let prefixWithKv = exec.ModelExecutorExecuteHfGlmMoePrefillWithKvState(
        twoLayerFixture.graph,
        twoLayerFixture.bindings,
        twoLayerFixture.store,
        tokenIds2,
        Value(prefixRouteSet)
    )
    assert(IsOk(prefixWithKv), " hf model graph smoke: kv prefix prefill run")
    let prefixKvOut = Value(prefixWithKv)
    assert(IsOk(exec.ModelExecutorValidateKvStateSet(prefixKvOut.kvStateSet)) &&
           prefixKvOut.kvStateSet.layerStates[0].seq.tokenCount == 2,
           " hf model graph smoke: kv prefix state validates")
    let decodeToken = makeTensor([1], 1, [2])
    let decodeRouteSet = exec.ModelExecutorBuildHfGlmMoeRoutePlanSetWithKvState(
        twoLayerFixture.graph,
        twoLayerFixture.bindings,
        twoLayerFixture.store,
        decodeToken,
        6,
        prefixKvOut.kvStateSet,
        true
    )
    if IsErr(decodeRouteSet):
        echo(Error(decodeRouteSet))
    assert(IsOk(decodeRouteSet) &&
           Value(decodeRouteSet).layerRoutes.len == 2 &&
           Value(decodeRouteSet).layerRoutes[0].routePlan.tokenCount == 1,
           " hf model graph smoke: kv decode route set")
    assert(IsOk(exec.ModelExecutorValidateKvStateSet(prefixKvOut.kvStateSet)) &&
           prefixKvOut.kvStateSet.layerStates[0].seq.tokenCount == 2,
           " hf model graph smoke: kv route planning keeps prefix immutable")
    let decodeWithKv = exec.ModelExecutorExecuteHfGlmMoeDecodeWithKvState(
        twoLayerFixture.graph,
        twoLayerFixture.bindings,
        twoLayerFixture.store,
        decodeToken,
        Value(decodeRouteSet),
        prefixKvOut.kvStateSet
    )
    assert(IsOk(decodeWithKv), " hf model graph smoke: kv decode run")
    assert(IsOk(exec.ModelExecutorValidateKvStateSet(prefixKvOut.kvStateSet)) &&
           prefixKvOut.kvStateSet.layerStates[0].seq.tokenCount == 2,
           " hf model graph smoke: kv decode keeps prefix immutable")
    let decodeKvOut = Value(decodeWithKv)
    assert(decodeKvOut.kvStateSet.layerStates.len == 2 &&
           decodeKvOut.kvStateSet.layerStates[0].seq.tokenCount == 3 &&
           decodeKvOut.kvStateSet.layerStates[1].seq.tokenCount == 3 &&
           decodeKvOut.kvStateSet.stateSetHash == fullKvOut.kvStateSet.stateSetHash,
           " hf model graph smoke: kv decode state matches full prefill")
    assert(tensorRowsEqual(fullKvOut.output.logits, 2, decodeKvOut.output.logits, 0),
           " hf model graph smoke: kv decode logits match full prefill")
    let int4Fixture = buildExecFixture(int4Graph)
    let int4RouteSet = exec.ModelExecutorBuildHfGlmMoeRoutePlanSet(
        int4Fixture.graph,
        int4Fixture.bindings,
        int4Fixture.store,
        tokenIds,
        2
    )
    assert(IsOk(int4RouteSet) &&
           Value(int4RouteSet).layerRoutes.len == 2,
           " hf model graph smoke: int4 route set")
    let int4Exec = exec.ModelExecutorExecuteHfGlmMoeSingleTokenWithRouteSet(
        int4Fixture.graph,
        int4Fixture.bindings,
        int4Fixture.store,
        tokenIds,
        Value(int4RouteSet)
    )
    assert(IsOk(int4Exec) &&
           Value(int4Exec).routePlanSet.routeSetHash == Value(int4RouteSet).routeSetHash &&
           Value(int4Exec).logits.shape.len == 2 &&
           Value(int4Exec).logits.shape[0] == 1 &&
           Value(int4Exec).logits.shape[1] == 32,
           " hf model graph smoke: int4 decoded tensor execution")
    let packedInt4Fixture = buildExecFixtureWithPackedInt4(int4Graph, true)
    let packedInt4RouteSet = exec.ModelExecutorBuildHfGlmMoeRoutePlanSet(
        packedInt4Fixture.graph,
        packedInt4Fixture.bindings,
        packedInt4Fixture.store,
        tokenIds,
        2
    )
    assert(IsOk(packedInt4RouteSet) &&
           Value(packedInt4RouteSet).layerRoutes.len == 2,
           " hf model graph smoke: packed int4 route set")
    let packedInt4CpuExec = exec.ModelExecutorExecuteHfGlmMoeSingleTokenWithRouteSet(
        packedInt4Fixture.graph,
        packedInt4Fixture.bindings,
        packedInt4Fixture.store,
        tokenIds,
        Value(packedInt4RouteSet)
    )
    assert(IsOk(packedInt4CpuExec), " hf model graph smoke: packed int4 cpu execution")
    let metalDevice = device.DeviceProbeMetal()
    assert(IsOk(metalDevice), " hf model graph smoke: metal probe")
    let w4MetalExec = exec.ModelExecutorExecuteHfGlmMoeSingleTokenWithRouteSetMetalPackedInt4(
        w4Fixture.graph,
        w4Fixture.bindings,
        w4Fixture.store,
        tokenIds,
        Value(w4RouteSet),
        Value(metalDevice)
    )
    if IsErr(w4MetalExec):
        echo(Error(w4MetalExec))
    assert(IsOk(w4MetalExec) &&
           Value(w4MetalExec).routePlanSet.routeSetHash == Value(w4RouteSet).routeSetHash &&
           tensorRowsEqual(Value(w4CpuExec).logits, 0, Value(w4MetalExec).logits, 0),
           " hf model graph smoke: w4afp8 metal logits match cpu")
    assert(IsErr(exec.ModelExecutorExecuteHfGlmMoeSingleTokenWithRouteSetMetalPackedInt4(
        int4Fixture.graph,
        int4Fixture.bindings,
        int4Fixture.store,
        tokenIds,
        Value(int4RouteSet),
        Value(metalDevice)
    )), " hf model graph smoke: decoded-only int4 metal hard fail")
    let packedInt4MetalExec = exec.ModelExecutorExecuteHfGlmMoeSingleTokenWithRouteSetMetalPackedInt4(
        packedInt4Fixture.graph,
        packedInt4Fixture.bindings,
        packedInt4Fixture.store,
        tokenIds,
        Value(packedInt4RouteSet),
        Value(metalDevice)
    )
    if IsErr(packedInt4MetalExec):
        echo(Error(packedInt4MetalExec))
    assert(IsOk(packedInt4MetalExec) &&
           Value(packedInt4MetalExec).routePlanSet.routeSetHash == Value(packedInt4RouteSet).routeSetHash &&
           Value(packedInt4MetalExec).logits.shape.len == 2 &&
           Value(packedInt4MetalExec).logits.shape[0] == 1 &&
           Value(packedInt4MetalExec).logits.shape[1] == 32 &&
           Value(packedInt4MetalExec).executionHash > int64(0),
           " hf model graph smoke: packed int4 metal execution")
    assert(tensorRowsEqual(Value(packedInt4CpuExec).logits, 0, Value(packedInt4MetalExec).logits, 0),
           " hf model graph smoke: packed int4 metal logits match cpu")
    let packedPrefillRouteSet = exec.ModelExecutorBuildHfGlmMoeRoutePlanSet(
        packedInt4Fixture.graph,
        packedInt4Fixture.bindings,
        packedInt4Fixture.store,
        tokenIds2,
        4
    )
    assert(IsOk(packedPrefillRouteSet), " hf model graph smoke: packed int4 prefill route set")
    let packedCpuPrefill = exec.ModelExecutorExecuteHfGlmMoePrefillWithKvState(
        packedInt4Fixture.graph,
        packedInt4Fixture.bindings,
        packedInt4Fixture.store,
        tokenIds2,
        Value(packedPrefillRouteSet)
    )
    assert(IsOk(packedCpuPrefill), " hf model graph smoke: packed int4 cpu prefill")
    let packedMetalPrefill = exec.ModelExecutorExecuteHfGlmMoePrefillWithKvStateMetalPackedInt4(
        packedInt4Fixture.graph,
        packedInt4Fixture.bindings,
        packedInt4Fixture.store,
        tokenIds2,
        Value(packedPrefillRouteSet),
        Value(metalDevice)
    )
    if IsErr(packedMetalPrefill):
        echo(Error(packedMetalPrefill))
    assert(IsOk(packedMetalPrefill) &&
           Value(packedMetalPrefill).kvStateSet.stateSetHash == Value(packedCpuPrefill).kvStateSet.stateSetHash &&
           tensorRowsEqual(Value(packedCpuPrefill).output.logits, 1, Value(packedMetalPrefill).output.logits, 1),
           " hf model graph smoke: packed int4 metal prefill matches cpu")
    let packedDecodeRouteSet = exec.ModelExecutorBuildHfGlmMoeRoutePlanSetWithKvState(
        packedInt4Fixture.graph,
        packedInt4Fixture.bindings,
        packedInt4Fixture.store,
        decodeToken,
        4,
        Value(packedCpuPrefill).kvStateSet,
        true
    )
    assert(IsOk(packedDecodeRouteSet), " hf model graph smoke: packed int4 decode route set")
    let packedCpuDecode = exec.ModelExecutorExecuteHfGlmMoeDecodeWithKvState(
        packedInt4Fixture.graph,
        packedInt4Fixture.bindings,
        packedInt4Fixture.store,
        decodeToken,
        Value(packedDecodeRouteSet),
        Value(packedCpuPrefill).kvStateSet
    )
    assert(IsOk(packedCpuDecode), " hf model graph smoke: packed int4 cpu decode")
    let packedMetalDecode = exec.ModelExecutorExecuteHfGlmMoeDecodeWithKvStateMetalPackedInt4(
        packedInt4Fixture.graph,
        packedInt4Fixture.bindings,
        packedInt4Fixture.store,
        decodeToken,
        Value(packedDecodeRouteSet),
        Value(packedCpuPrefill).kvStateSet,
        Value(metalDevice)
    )
    if IsErr(packedMetalDecode):
        echo(Error(packedMetalDecode))
    assert(IsOk(packedMetalDecode) &&
           Value(packedMetalDecode).kvStateSet.stateSetHash == Value(packedCpuDecode).kvStateSet.stateSetHash &&
           tensorRowsEqual(Value(packedCpuDecode).output.logits, 0, Value(packedMetalDecode).output.logits, 0),
           " hf model graph smoke: packed int4 metal decode matches cpu")

    assert(IsErr(hfgraph.HfGlmMoeConfigFromJson("{\"model_type\":\"llama\",\"vocab_size\":32,\"hidden_size\":8,\"num_hidden_layers\":1,\"num_attention_heads\":2,\"num_experts\":2,\"num_experts_per_tok\":1,\"intermediate_size\":16}")),
           " hf model graph smoke: unsupported model type hard fail")
    assert(IsErr(hfgraph.HfGlmMoeConfigFromJson("{\"model_type\":\"glm5_moe\",\"vocab_size\":32,\"hidden_size\":10,\"num_hidden_layers\":1,\"num_attention_heads\":3,\"num_experts\":2,\"num_experts_per_tok\":1,\"intermediate_size\":16}")),
           " hf model graph smoke: hidden head mismatch hard fail")
    assert(IsErr(hfgraph.HfGlmMoeConfigFromJson("{\"model_type\":\"glm5_moe\",\"vocab_size\":32,\"hidden_size\":8,\"num_hidden_layers\":1,\"num_attention_heads\":2,\"num_experts\":2,\"num_experts_per_tok\":3,\"intermediate_size\":16}")),
           " hf model graph smoke: top k hard fail")
    assert(IsErr(hfgraph.HfModelGraphBuildGlmMoeFromConfig(configJson, "cid:model:bad", kir.KernelDtypeFp16, mg.ModelQuantSchemeSymmetricInt4)),
           " hf model graph smoke: bad quant dtype hard fail")

    echo(" hf_model_graph_smoke ok")
    return 0
