    let glm52ExecGraph = mg.ModelGraphBuildTinyGlm52DsaMlaMtpFixture("cid:model:tiny-glm52-dsa-mla-mtp")
    assert(IsOk(mg.ModelGraphValidate(glm52ExecGraph)),
