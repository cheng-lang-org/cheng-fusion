fn peersForGraph(graph: mg.ModelGraph): str[] =
    var peers: str[]
    for i in 0..<graph.weights.len:
        add(peers, strutil.Join(["peer:hf:", strings.IntToStr(i)], ""))
    return peers

fn findWeightIndex(graph: mg.ModelGraph, tensorName: str): int32 =
    for i in 0..<graph.weights.len:
        if graph.weights[i].tensorName == tensorName:
            return i
    return -1

fn requireWeight(graph: mg.ModelGraph, tensorName: str): mg.ModelWeightShard =
    let idx = findWeightIndex(graph, tensorName)
    assert(idx >= 0, strutil.Join([" hf model graph smoke: missing weight ", tensorName], ""))
    return graph.weights[idx]

fn makeTensor(shape: int32[], scale: int32, data: int32[]): infer.TensorQ =
    var out: infer.TensorQ
    let res = infer.TensorFromDataFill(out, shape, scale, data)
    assert(IsOk(res), " hf model graph smoke: tensor")
    return out

fn tensorRowsEqual(left: infer.TensorQ, leftRow: int32, right: infer.TensorQ, rightRow: int32): bool =
    if left.shape.len != 2 || right.shape.len != 2:
        return false
    if left.scale != right.scale || left.shape[1] != right.shape[1]:
        return false
    if leftRow < 0 || leftRow >= left.shape[0] || rightRow < 0 || rightRow >= right.shape[0]:
        return false
    for i in 0..<left.shape[1]:
        if left.data[infer.TensorOffset2(left.shape, leftRow, i)] != right.data[infer.TensorOffset2(right.shape, rightRow, i)]:
            return false
    return true

fn makeWeightTensor(weight: mg.ModelWeightShard, ordinal: int32): infer.TensorQ =
    let countRes = mg.ModelGraphTensorElementCount(weight.shape)
    assert(IsOk(countRes), " hf model graph smoke: weight count")
    assert(Value(countRes) <= int64(2147483647), " hf model graph smoke: weight count range")
    let elemCount = int32(Value(countRes))
    var data: int32[]
    for i in 0..<elemCount:
        add(data, (ordinal + 1) * 3 + (i % 7) + 1)
    return makeTensor(weight.shape, 1000, data)

fn makePackedInt4Tensor(shape: int32[], scale: int32, values: int32[]): kir.KernelPackedInt4Tensor =
    let countRes = infer.TensorElementCount(shape)
    assert(IsOk(countRes), " hf model graph smoke: packed int4 shape")
    assert(Value(countRes) == values.len, " hf model graph smoke: packed int4 count")
    let byteCount = values.len / 2 + values.len % 2
    var bytes = rawbytes.BytesAlloc(byteCount)
    assert(byteCount == 0 || bytes.data != nil, " hf model graph smoke: packed int4 allocation")
    for i in 0..<values.len:
        assert(values[i] >= -8 && values[i] <= 7, " hf model graph smoke: packed int4 range")
        var nibble = values[i]
        if nibble < 0:
            nibble = nibble + 16
        let byteIndex = i / 2
        let oldByte = rawbytes.BytesGet(bytes, byteIndex)
        if i % 2 == 0:
            rawbytes.BytesSet(bytes, byteIndex, (oldByte & 240) | (nibble & 15))
        else:
            rawbytes.BytesSet(bytes, byteIndex, (oldByte & 15) | ((nibble & 15) << 4))
    return kir.KernelPackedInt4Tensor(shape: shape, scale: scale, packed: bytes)

fn makePackedInt4Weight(weight: mg.ModelWeightShard, ordinal: int32): kir.KernelPackedInt4Tensor =
    let countRes = mg.ModelGraphTensorElementCount(weight.shape)
    assert(IsOk(countRes), " hf model graph smoke: packed int4 weight count")
    assert(Value(countRes) <= int64(2147483647), " hf model graph smoke: packed int4 weight range")
    let elemCount = int32(Value(countRes))
    var values: int32[]
    for i in 0..<elemCount:
        add(values, ((i + ordinal) % 5) - 2)
    return makePackedInt4Tensor(weight.shape, 1000, values)

fn makePackedInt4DecodedWeightTensor(packed: kir.KernelPackedInt4Tensor): infer.TensorQ =
    let countRes = infer.TensorElementCount(packed.shape)
    assert(IsOk(countRes), " hf model graph smoke: packed int4 decoded count")
    var data: int32[]
    for i in 0..<Value(countRes):
        add(data, kir.KernelIrPackedInt4ValueAtUnchecked(packed, i))
    return makeTensor(packed.shape, packed.scale, data)

fn makeW4Afp8RawWeight(weight: mg.ModelWeightShard, ordinal: int32): rawbytes.Bytes =
    let countRes = mg.ModelGraphTensorElementCount(weight.shape)
    assert(IsOk(countRes), " hf model graph smoke: w4afp8 raw count")
    assert(Value(countRes) <= int64(2147483647), " hf model graph smoke: w4afp8 raw range")
    let elemCount = int32(Value(countRes))
    var bytes = rawbytes.BytesAlloc(elemCount)
    assert(elemCount == 0 || bytes.data != nil, " hf model graph smoke: w4afp8 raw allocation")
    for i in 0..<elemCount:
        var raw = ((i + ordinal) % 5) - 2
        if raw < 0:
            raw = raw + 256
        rawbytes.BytesSet(bytes, i, raw)
    return bytes

fn makeW4Afp8DecodedWeightTensor(shape: int32[], scale: int32, raw: rawbytes.Bytes): infer.TensorQ =
    let rawTensor = kir.KernelW4Afp8Tensor(shape: shape, scale: scale, rawI8: raw)
    assert(IsOk(kir.KernelIrW4Afp8TensorValidate(rawTensor)), " hf model graph smoke: w4afp8 raw tensor")
    let countRes = infer.TensorElementCount(shape)
    assert(IsOk(countRes), " hf model graph smoke: w4afp8 decoded count")
    var data: int32[]
    for i in 0..<Value(countRes):
        add(data, kir.KernelIrW4Afp8ValueAtUnchecked(rawTensor, i))
    return makeTensor(shape, scale, data)

fn hfGraphWithSingleW4Afp8Weight(graph: mg.ModelGraph, tensorName: str): mg.ModelGraph =
    var weights: mg.ModelWeightShard[]
    var replaced: bool
    for i in 0..<graph.weights.len:
        var weight = graph.weights[i]
        if weight.tensorName == tensorName:
            let sizeBytes = mg.ModelGraphExpectedTensorBytes(kir.KernelDtypeInt8, weight.shape)
            assert(IsOk(sizeBytes), " hf model graph smoke: w4afp8 size")
            weight.dtype = kir.KernelDtypeInt8
            weight.quantScheme = mg.ModelQuantSchemeW4Afp8
            weight.sizeBytes = Value(sizeBytes)
            weight.expectedPayloadHash = int64(0)
            replaced = true
            add(weights, weight)
            let scaleName = ws.WeightSafetensorsW4Afp8ScaleTensorName(weight.tensorName)
            assert(IsOk(scaleName), " hf model graph smoke: w4afp8 scale name")
            add(weights, mg.ModelWeightShard(
                modelCid: graph.modelCid,
                shardCid: strutil.Join([weight.shardCid, ":scale-inv"], ""),
                tensorName: Value(scaleName),
                dtype: kir.KernelDtypeFp8E4M3,
                quantScheme: mg.ModelQuantSchemeNone,
                shape: [weight.shape[0]],
                sizeBytes: int64(weight.shape[0]),
                expectedPayloadHash: int64(0)
            ))
            let inputScaleName = ws.WeightSafetensorsW4Afp8InputScaleTensorName(weight.tensorName)
            assert(IsOk(inputScaleName), " hf model graph smoke: w4afp8 input scale name")
            add(weights, mg.ModelWeightShard(
                modelCid: graph.modelCid,
                shardCid: strutil.Join([weight.shardCid, ":input-scale"], ""),
                tensorName: Value(inputScaleName),
                dtype: kir.KernelDtypeFp8E4M3,
                quantScheme: mg.ModelQuantSchemeNone,
                shape: [1],
                sizeBytes: int64(1),
                expectedPayloadHash: int64(0)
            ))
        else:
            add(weights, weight)
    assert(replaced, " hf model graph smoke: w4afp8 replacement")
    var out = graph
    out.weights = weights
    out.graphHash = mg.ModelGraphHash(out)
    assert(IsOk(mg.ModelGraphValidate(out)), " hf model graph smoke: w4afp8 graph validate")
    return out

fn buildExecFixture(graph: mg.ModelGraph): HfExecFixture =
    return buildExecFixtureWithPackedInt4(graph, false)

fn buildGlm52RopeOnlyDriftFixture(fixture: HfExecFixture): HfExecFixture =
    var payloads: ws.WeightTensorPayload[]
    var bindings: wb.WeightShardBinding[]
    var changed: bool
    for i in 0..<fixture.store.payloads.len:
        var payload = fixture.store.payloads[i]
        if payload.tensorName == "model.layers.0.self_attn.kv_a_proj_with_mqa.weight":
            if payload.tensor.shape.len != 2 ||
               payload.tensor.shape[0] != fixture.graph.kvLoraRank + fixture.graph.qkRopeHeadDim:
                assert(false, " hf model graph smoke: glm52 rope drift tensor shape")
            var data: int32[]
            for row in 0..<payload.tensor.shape[0]:
                for col in 0..<payload.tensor.shape[1]:
                    var value = payload.tensor.data[infer.TensorOffset2(payload.tensor.shape, row, col)]
                    if row >= fixture.graph.kvLoraRank:
                        value = value + 7777 + col
                    add(data, value)
            let driftTensor = infer.TensorQ(shape: payload.tensor.shape, scale: payload.tensor.scale, data: data)
            assert(IsOk(infer.TensorValidate(driftTensor)), " hf model graph smoke: glm52 rope drift tensor")
            let driftPayload = ws.WeightTensorPayloadBuild(
                payload.modelCid,
                payload.tensorName,
                payload.shardCid,
                payload.dtype,
                payload.quantScheme,
                payload.peerId,
                driftTensor
            )
            assert(IsOk(driftPayload), " hf model graph smoke: glm52 rope drift payload")
            payload = Value(driftPayload)
            changed = true
        add(payloads, payload)
        add(bindings, wb.WeightShardBinding(
            modelCid: fixture.graph.weights[i].modelCid,
            tensorName: fixture.graph.weights[i].tensorName,
            shardCid: fixture.graph.weights[i].shardCid,
            dtype: fixture.graph.weights[i].dtype,
            quantScheme: fixture.graph.weights[i].quantScheme,
            sizeBytes: fixture.graph.weights[i].sizeBytes,
            peerId: payload.peerId,
            payloadHash: payload.payloadHash
        ))
    assert(changed, " hf model graph smoke: glm52 rope drift target")
    let bindingSet = wb.WeightBindingBuildSet(fixture.graph.modelCid, bindings)
    let store = ws.WeightTensorStoreBuild(fixture.graph.modelCid, payloads)
    var hashes: int64[]
    for i in 0..<payloads.len:
        add(hashes, payloads[i].payloadHash)
    let boundGraphRes = mg.ModelGraphBindExpectedWeightPayloadHashes(fixture.graph, hashes)
    assert(IsOk(boundGraphRes), " hf model graph smoke: glm52 rope drift bind")
    let boundGraph = Value(boundGraphRes)
    assert(IsOk(wb.WeightBindingValidate(bindingSet, boundGraph)), " hf model graph smoke: glm52 rope drift binding")
    assert(IsOk(ws.WeightTensorValidateStore(store, bindingSet, boundGraph)), " hf model graph smoke: glm52 rope drift store")
    return HfExecFixture(graph: boundGraph, bindings: bindingSet, store: store)

fn buildExecFixtureWithPackedInt4(graph: mg.ModelGraph, packInt4: bool): HfExecFixture =
    var payloads: ws.WeightTensorPayload[]
    var bindings: wb.WeightShardBinding[]
    for i in 0..<graph.weights.len:
        let peerId = strutil.Join(["peer:hf-exec:", strings.IntToStr(i)], "")
        var payload: ws.WeightTensorPayload
        if graph.weights[i].dtype == kir.KernelDtypeInt8 &&
           graph.weights[i].quantScheme == mg.ModelQuantSchemeW4Afp8:
            let raw = makeW4Afp8RawWeight(graph.weights[i], i)
            let tensor = makeW4Afp8DecodedWeightTensor(graph.weights[i].shape, 1000, raw)
            let payloadRes = ws.WeightTensorPayloadBuildWithW4Afp8Raw(
                graph.weights[i].modelCid,
                graph.weights[i].tensorName,
                graph.weights[i].shardCid,
                graph.weights[i].dtype,
                graph.weights[i].quantScheme,
                peerId,
                tensor,
                raw
            )
            assert(IsOk(payloadRes), " hf model graph smoke: w4afp8 payload")
            payload = Value(payloadRes)
        elif packInt4 &&
           graph.weights[i].dtype == kir.KernelDtypeInt4 &&
           graph.weights[i].quantScheme == mg.ModelQuantSchemeSymmetricInt4:
            let packed = makePackedInt4Weight(graph.weights[i], i)
            let tensor = makePackedInt4DecodedWeightTensor(packed)
            let payloadRes = ws.WeightTensorPayloadBuildWithPackedInt4(
                graph.weights[i].modelCid,
                graph.weights[i].tensorName,
                graph.weights[i].shardCid,
                graph.weights[i].dtype,
                graph.weights[i].quantScheme,
                peerId,
                tensor,
                true,
                packed
            )
            assert(IsOk(payloadRes), " hf model graph smoke: packed int4 payload")
            payload = Value(payloadRes)
        else:
            let tensor = makeWeightTensor(graph.weights[i], i)
            let payloadRes = ws.WeightTensorPayloadBuild(
                graph.weights[i].modelCid,
                graph.weights[i].tensorName,
                graph.weights[i].shardCid,
                graph.weights[i].dtype,
                graph.weights[i].quantScheme,
                peerId,
                tensor
            )
            assert(IsOk(payloadRes), " hf model graph smoke: payload")
            payload = Value(payloadRes)
        add(payloads, payload)
        add(bindings, wb.WeightShardBinding(
            modelCid: graph.weights[i].modelCid,
            tensorName: graph.weights[i].tensorName,
            shardCid: graph.weights[i].shardCid,
            dtype: graph.weights[i].dtype,
            quantScheme: graph.weights[i].quantScheme,
            sizeBytes: graph.weights[i].sizeBytes,
            peerId: peerId,
            payloadHash: payload.payloadHash
        ))
    let bindingSet = wb.WeightBindingBuildSet(graph.modelCid, bindings)
    let store = ws.WeightTensorStoreBuild(graph.modelCid, payloads)
    var hashes: int64[]
    for i in 0..<payloads.len:
        add(hashes, payloads[i].payloadHash)
    let boundGraphRes = mg.ModelGraphBindExpectedWeightPayloadHashes(graph, hashes)
    assert(IsOk(boundGraphRes), " hf model graph smoke: bind payload hashes")
    let boundGraph = Value(boundGraphRes)
    assert(IsOk(wb.WeightBindingValidate(bindingSet, boundGraph)), " hf model graph smoke: binding validate")
    assert(IsOk(ws.WeightTensorValidateStore(store, bindingSet, boundGraph)), " hf model graph smoke: store validate")
    return HfExecFixture(graph: boundGraph, bindings: bindingSet, store: store)

fn hfWeightMapJson(graph: mg.ModelGraph, missingLast: bool): str =
    var parts: str[]
    var count = graph.weights.len
    if missingLast:
        count = count - 1
    for i in 0..<count:
        add(parts, strutil.Join([
            "\"",
            graph.weights[i].tensorName,
            "\":\"model-00001-of-00001.safetensors\""
        ], ""))
    return strutil.Join([
        "{\"metadata\":{\"total_size\":",
        strings.Int64ToStr(int64(graph.weights.len) * int64(16)),
        "},\"weight_map\":{",
        strutil.Join(parts, ","),
        "}}"
    ], "")

fn hfGlm52AuditShardName(weightName: str): str =
    if strutil.Contains(weightName, "model.layers.78."):
        return "model-00041-of-00041.safetensors"
    return "model-00001-of-00040.safetensors"

fn hfGlm52AuditWeightMapJson(graph: mg.ModelGraph, missingLast: bool): str =
    var parts: str[]
    var count = graph.weights.len
    if missingLast:
        count = count - 1
    for i in 0..<count:
        add(parts, strutil.Join([
            "\"",
            graph.weights[i].tensorName,
            "\":\"",
            hfGlm52AuditShardName(graph.weights[i].tensorName),
            "\""
        ], ""))
    return strutil.Join([
        "{\"metadata\":{\"total_size\":399693862592,\"all_shards\":\"",
        hfGlm52W4Afp8ShardMarkers(),
        "\"},\"weight_map\":{",
        strutil.Join(parts, ","),
        "}}"
    ], "")

fn hfGlm52FullIndexJson(profile: hfgraph.HfGlm52W4Afp8DeployProfile,
                        mutation: int32): str =
    let namesRes = hfgraph.HfGlm52W4Afp8ExpectedWeightNames(profile)
    assert(IsOk(namesRes), " hf model graph smoke: glm52 expected names")
    let names = Value(namesRes)
    var parts: str[]
    for i in 0..<names.len:
        var include = true
        if mutation == Glm52IndexMutationMissingExpert254 &&
           names[i] == "model.layers.77.mlp.experts.254.gate_proj.weight":
            include = false
        elif mutation == Glm52IndexMutationMissingPeriodicDsa &&
             names[i] == "model.layers.74.self_attn.indexer.wq_b.weight":
            include = false
        elif mutation == Glm52IndexMutationMissingMtpSharedHead &&
             names[i] == "model.layers.78.shared_head.norm.weight":
            include = false
        if include:
            add(parts, strutil.Join([
                "\"",
                names[i],
                "\":\"",
                hfGlm52AuditShardName(names[i]),
                "\""
            ], ""))
    if mutation == Glm52IndexMutationUnexpectedLayer:
        add(parts, "\"model.layers.79.input_layernorm.weight\":\"model-00041-of-00041.safetensors\"")
    return strutil.Join([
        "{\"metadata\":{\"total_size\":399693862592,\"all_shards\":\"",
        hfGlm52W4Afp8ShardMarkers(),
        "\"},\"weight_map\":{",
        strutil.Join(parts, ","),
        "}}"
    ], "")

fn hfGlm52AnchorIndexJson(): str =
    return strutil.Join([
        "{\"metadata\":{\"total_size\":399693862592,\"all_shards\":\"",
        hfGlm52W4Afp8ShardMarkers(),
        "\"},\"weight_map\":{",
        "\"model.embed_tokens.weight\":\"model-00001-of-00040.safetensors\",",
        "\"model.norm.weight\":\"model-00001-of-00040.safetensors\",",
        "\"lm_head.weight\":\"model-00001-of-00040.safetensors\",",
        "\"model.layers.0.input_layernorm.weight\":\"model-00001-of-00040.safetensors\",",
        "\"model.layers.0.self_attn.q_a_proj.weight\":\"model-00001-of-00040.safetensors\",",
        "\"model.layers.0.self_attn.kv_a_proj_with_mqa.weight\":\"model-00001-of-00040.safetensors\",",
        "\"model.layers.0.self_attn.o_proj.weight\":\"model-00001-of-00040.safetensors\",",
        "\"model.layers.0.self_attn.indexer.wq_b.weight\":\"model-00001-of-00040.safetensors\",",
        "\"model.layers.0.mlp.down_proj.weight\":\"model-00001-of-00040.safetensors\",",
        "\"model.layers.3.mlp.gate.weight\":\"model-00001-of-00040.safetensors\",",
        "\"model.layers.3.mlp.shared_experts.down_proj.weight\":\"model-00001-of-00040.safetensors\",",
        "\"model.layers.3.mlp.experts.0.gate_proj.weight\":\"model-00001-of-00040.safetensors\",",
        "\"model.layers.3.mlp.experts.255.w1.input_scale\":\"model-00001-of-00040.safetensors\",",
        "\"model.layers.78.eh_proj.weight\":\"model-00041-of-00041.safetensors\",",
        "\"model.layers.78.hnorm.weight\":\"model-00041-of-00041.safetensors\",",
        "\"model.layers.78.shared_head.norm.weight\":\"model-00041-of-00041.safetensors\",",
        "\"model.layers.78.self_attn.q_a_proj.weight\":\"model-00041-of-00041.safetensors\",",
        "\"model.layers.78.mlp.gate.weight\":\"model-00041-of-00041.safetensors\",",
        "\"model.layers.78.mlp.experts.255.w1.input_scale\":\"model-00041-of-00041.safetensors\"",
        "}}"
    ], "")

fn hfGlm52MutatedNameInventory(names: str[], mutation: int32): str[] =
    var out: str[]
    for i in 0..<names.len:
        if mutation == Glm52IndexMutationMissingExpert254 &&
           names[i] == "model.layers.77.mlp.experts.254.gate_proj.weight":
            continue
        if mutation == Glm52IndexMutationMissingPeriodicDsa &&
           names[i] == "model.layers.74.self_attn.indexer.wq_b.weight":
            continue
        if mutation == Glm52IndexMutationMissingMtpSharedHead &&
           names[i] == "model.layers.78.shared_head.norm.weight":
            continue
        if mutation == Glm52IndexMutationUnexpectedLayer && i == 0:
            add(out, "model.layers.79.input_layernorm.weight")
        else:
            add(out, names[i])
    return out

fn traceFactsContain(facts: str[], fact: str): bool =
    for i in 0..<facts.len:
        if facts[i] == fact:
            return true
    return false

fn main(): int32 =
    let configJson = hfFixtureConfig(false)
