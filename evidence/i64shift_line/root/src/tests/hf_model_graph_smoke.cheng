    assert(Value(config).modelType == "glm5_moe" &&
           Value(config).vocabSize == 32 &&
           Value(config).hiddenSize == 8 &&
           Value(config).layerCount == 2 &&
           Value(config).attentionHeads == 2 &&
           Value(config).keyValueHeads == 1 &&
           Value(config).headDim == 4 &&
           Value(config).intermediateSize == 16 &&
           Value(config).expertCount == 3 &&
