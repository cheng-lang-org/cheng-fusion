           IsErr(hfgraph.HfGlm52W4Afp8ExpectedWeightOrdinal(glm52Profile, "model.layers.75.self_attn.indexer.wq_b.weight")) &&
           IsErr(hfgraph.HfGlm52W4Afp8ExpectedWeightOrdinal(glm52Profile, "model.layers.79.input_layernorm.weight")),
           " hf model graph smoke: glm52 inventory ordinal")
    let glm52Facts = hfgraph.HfGlm52W4Afp8DeploymentFacts(glm52Profile)
