const
    Glm52IndexMutationNone = 0
    Glm52IndexMutationMissingExpert254 = 1
    Glm52IndexMutationMissingPeriodicDsa = 2
    Glm52IndexMutationMissingMtpSharedHead = 3
    Glm52IndexMutationUnexpectedLayer = 4

type
    HfExecFixture =
        graph: mg.ModelGraph
        bindings: wb.WeightBindingSet
        store: ws.WeightTensorStore

