    assert(IsOk(fp16GraphRes), " hf model graph smoke: fp16 graph")
    let fp16Graph = Value(fp16GraphRes)
    assert(IsOk(mg.ModelGraphValidate(fp16Graph)), " hf model graph smoke: fp16 graph validates")
    assert(fp16Graph.architecture == "hf_glm_moe" &&
           fp16Graph.weights.len == 35 &&
           fp16Graph.ops.len == 27,
           " hf model graph smoke: fp16 inventory")
    let kProj = requireWeight(fp16Graph, "model.layers.0.self_attn.k_proj.weight")
    assert(kProj.dtype == kir.KernelDtypeFp16 &&
           kProj.shape.len == 2 &&
           kProj.shape[0] == 4 &&
           kProj.shape[1] == 8 &&
           kProj.sizeBytes == int64(64),
           " hf model graph smoke: kv projection shape")
    let expertDown = requireWeight(fp16Graph, "model.layers.1.mlp.experts.2.down_proj.weight")
    assert(expertDown.shape.len == 2 &&
           expertDown.shape[0] == 8 &&
           expertDown.shape[1] == 16,
           " hf model graph smoke: expert down shape")
    let lmHead = requireWeight(fp16Graph, "lm_head.weight")
    assert(lmHead.shape[0] == 32 && lmHead.shape[1] == 8,
           " hf model graph smoke: lm head shape")

    let int4GraphRes = hfgraph.HfModelGraphBuildGlmMoeFromConfig(
        configJson,
        "cid:model:hf-glm-moe-int4",
        kir.KernelDtypeInt4,
        mg.ModelQuantSchemeSymmetricInt4
    )
    assert(IsOk(int4GraphRes), " hf model graph smoke: int4 graph")
    let int4Graph = Value(int4GraphRes)
    assert(IsOk(mg.ModelGraphValidate(int4Graph)), " hf model graph smoke: int4 graph validates")
    let qProj4 = requireWeight(int4Graph, "model.layers.0.self_attn.q_proj.weight")
    assert(qProj4.dtype == kir.KernelDtypeInt4 &&
           qProj4.quantScheme == mg.ModelQuantSchemeSymmetricInt4 &&
           qProj4.sizeBytes == int64(32),
           " hf model graph smoke: int4 q projection")
    let norm4 = requireWeight(int4Graph, "model.layers.0.input_layernorm.weight")
    assert(norm4.dtype == kir.KernelDtypeFp16 &&
           norm4.quantScheme == mg.ModelQuantSchemeNone &&
           norm4.sizeBytes == int64(16),
           " hf model graph smoke: int4 keeps fp16 norm")
    let router4 = requireWeight(int4Graph, "model.layers.0.mlp.gate.weight")
    assert(router4.dtype == kir.KernelDtypeInt4 &&
           router4.sizeBytes == int64(12),
           " hf model graph smoke: int4 router bytes")

    let peers = peersForGraph(int4Graph)
    let hfIndex = ws.WeightSafetensorsShardIndexFromHfWeightMap(
        hfWeightMapJson(int4Graph, false),
