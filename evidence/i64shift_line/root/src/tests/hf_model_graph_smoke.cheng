    let glm52MissingStore = ws.WeightTensorStoreBuild(glm52ExecFixture.graph.modelCid, glm52MissingPayloads)
    assert(IsErr(exec.ModelExecutorExecuteHfGlm52DsaMlaMtpAuditTokens(
