    let glm52BadQuantConfig = "{\"architectures\":[\"GlmMoeDsaForCausalLM\"],\"model_type\":\"deepseek_v3\",\"quantization_config\":{\"quant_method\":\"fp8\"}}"
    assert(IsErr(hfgraph.HfGlm52W4Afp8DeployProfileFromConfig("PhalaCloud/GLM-5.2-W4AFP8", glm52BadQuantConfig)),
           " hf model graph smoke: glm52 w4afp8 quant hard fail")
    let glm52NoMtpConfig = hfGlm52W4Afp8ConfigNoMtp()
    assert(IsErr(hfgraph.HfGlm52W4Afp8DeployProfileFromConfig("PhalaCloud/GLM-5.2-W4AFP8", glm52NoMtpConfig)),
