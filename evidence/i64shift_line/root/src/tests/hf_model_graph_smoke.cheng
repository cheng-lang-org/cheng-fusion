    let glm52QuantConfig = ws.WeightSafetensorsHfQuantizationConfigFromJson(glm52ConfigJson)
    assert(IsOk(glm52QuantConfig) &&
           Value(glm52QuantConfig).quantMethod == "w4afp8" &&
