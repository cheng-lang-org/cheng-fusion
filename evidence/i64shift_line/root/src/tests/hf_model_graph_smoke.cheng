    assert(glm52Profile.mtpStartLayer == 78, " hf model graph smoke: glm52 mtp start")
    assert(glm52Profile.quantMethod == "w4afp8", " hf model graph smoke: glm52 quant method")
    assert(glm52Profile.expectedTotalWeightBytes > int64(0), " hf model graph smoke: glm52 total bytes")
    assert(IsOk(hfgraph.HfGlm52W4Afp8ValidateProfile(glm52Profile)),
           " hf model graph smoke: glm52 w4afp8 profile validate")
    let glm52ExpectedWeightCount = hfgraph.HfGlm52W4Afp8ExpectedWeightCount(glm52Profile)
    assert(IsOk(glm52ExpectedWeightCount) &&
           Value(glm52ExpectedWeightCount) == 176997,
           " hf model graph smoke: glm52 expected weight count")
    assert(IsOk(hfgraph.HfGlm52W4Afp8ExpectedLayerWeightCount(glm52Profile, 0)) &&
           Value(hfgraph.HfGlm52W4Afp8ExpectedLayerWeightCount(glm52Profile, 0)) == 27 &&
           IsOk(hfgraph.HfGlm52W4Afp8ExpectedLayerWeightCount(glm52Profile, 3)) &&
           Value(hfgraph.HfGlm52W4Afp8ExpectedLayerWeightCount(glm52Profile, 3)) == 2326 &&
           IsOk(hfgraph.HfGlm52W4Afp8ExpectedLayerWeightCount(glm52Profile, 6)) &&
           Value(hfgraph.HfGlm52W4Afp8ExpectedLayerWeightCount(glm52Profile, 6)) == 2333 &&
           IsOk(hfgraph.HfGlm52W4Afp8ExpectedLayerWeightCount(glm52Profile, 78)) &&
           Value(hfgraph.HfGlm52W4Afp8ExpectedLayerWeightCount(glm52Profile, 78)) == 2337,
           " hf model graph smoke: glm52 layer inventory counts")
    let glm52ExpectedNames = hfgraph.HfGlm52W4Afp8ExpectedWeightNames(glm52Profile)
    assert(IsOk(glm52ExpectedNames) &&
           Value(glm52ExpectedNames).len == 176997,
           " hf model graph smoke: glm52 expected names count")
    assert(IsOk(hfgraph.HfGlm52W4Afp8ValidateExpectedWeightNameInventory(glm52Profile, Value(glm52ExpectedNames))),
           " hf model graph smoke: glm52 expected name inventory")
    assert(IsErr(hfgraph.HfGlm52W4Afp8ValidateExpectedWeightNameInventory(
        glm52Profile,
        hfGlm52MutatedNameInventory(Value(glm52ExpectedNames), Glm52IndexMutationMissingExpert254)
    )), " hf model graph smoke: glm52 missing expert inventory hard fail")
    assert(IsErr(hfgraph.HfGlm52W4Afp8ValidateExpectedWeightNameInventory(
        glm52Profile,
        hfGlm52MutatedNameInventory(Value(glm52ExpectedNames), Glm52IndexMutationMissingPeriodicDsa)
    )), " hf model graph smoke: glm52 missing periodic dsa inventory hard fail")
    assert(IsErr(hfgraph.HfGlm52W4Afp8ValidateExpectedWeightNameInventory(
        glm52Profile,
        hfGlm52MutatedNameInventory(Value(glm52ExpectedNames), Glm52IndexMutationMissingMtpSharedHead)
    )), " hf model graph smoke: glm52 missing mtp inventory hard fail")
    assert(IsErr(hfgraph.HfGlm52W4Afp8ValidateExpectedWeightNameInventory(
