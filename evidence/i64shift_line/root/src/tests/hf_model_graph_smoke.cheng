    let glm52WrongGraph = mg.ModelGraphBuildTinyGlmMoeFixture("cid:model:glm52-wrong-graph")
    assert(IsErr(hfgraph.HfGlm52W4Afp8BuildAuditShardIndex(
        glm52Profile,
        glm52AuditIndexJson,
