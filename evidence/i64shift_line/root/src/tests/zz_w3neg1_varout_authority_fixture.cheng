import std/system

type Inner =
    tag: str
    weight: int32

type Op =
    inner: Inner
    x: int32

fn MakeOp(text: str): Op =
    return Op(inner: Inner(tag: text, weight: 1), x: 2)

fn Sink(op: Op): int32 =
    return op.x

@borrows
fn BorrowFail(o: Op): int32 =
    return Sink(o)

fn main(): int32 =
    var op = MakeOp("abc")
    var r = BorrowFail(op)
    return r
