# Focused harness: exercise the GENERATED await-split recv-done runtime end-to-end
# over a REAL QUIC loopback connection, proving:
#   - seg0 (the lowered handler prefix) flips the busy state and issues the REAL send
#     (multistream select plus the request frame transmitted out the socket), then
#     registers a recv-done async frame and SUSPENDS (returns).
#   - the completion predicate is the REAL QUIC recv done-signal (a real transport
#     read of the peer ack), NOT a timer.
#   - the resume segment runs the post-await state update (clears busy) once the real
#     ack arrives.
#
# The __async fns below are byte-identical to what scene-runtime-smoke-source.mjs
# emits for options.asyncRecvDone: the generated continuation runtime, driven here
# by a real send/peer pair instead of the cheng_app_tick render loop.

import std/system
import std/result
import std/os
import std/rawbytes
import std/strings as strings
import cheng/libp2p/core/types as types
import cheng/libp2p/core/multiaddr as multiaddr
import cheng/libp2p/transports/quic_transport as quic_transport
import cheng/core/runtime/web_scene_social_send as social

# global loopback peer (the real QUIC connection the send transmits over)
var gPair: quic_transport.Libp2pQuicLoopbackPair
var gClientSide: int32 = 0
var gClientRecvStream: int64 = int64(0)

# generated handler state slot (CHT state model): engagementBusy as str
var __chtState_engagementBusy: str = ""

# recv-done provider seam (the real QUIC done-signal). The generated runtime imports
# cheng_async_recv_try_ack; the harness provides the SAME function. It does a real,
# short-timeout transport READ of the peer ack on the client connection
# (Libp2pQuicReadExactWithTimeout, which internally drives the QUIC pump plus recv).
# Returns 1 once the ack frame is received (the real done-signal), else 0. NOT a
# sleep/timer: it really receives the acknowledgement bytes.
fn __asyncRecvTryAck(side: int32, streamId: int64, ackLen: int32): int32 =
    side
    streamId
    let rr = quic_transport.Libp2pQuicReadExactWithTimeout(gPair.client, gPair.outbound, ackLen, 4)
    if IsErr(rr):
        return 0
    if rawbytes.BytesLen(Value(rr)) >= ackLen:
        return 1
    return 0

@importc("cheng_monotime_ns")
fn __asyncHostMonotimeNs(): int64

# GENERATED await-split recv-done runtime (identical to the .mjs emit)
type ChengAsyncFrame =
    active: bool
    kind: int32
    seg: int32
    deadlineMs: int32
    waitKind: int32
    side: int32
    streamId: int64
    ackLen: int32

var __asyncFrames: ChengAsyncFrame[8]
var __asyncNowMs: int32
var __asyncBaseNs: int64
var __asyncClockStarted: bool

fn __asyncFrameAlloc(): int32 =
    var i: int32
    i = 0
    while i < 8:
        if !__asyncFrames[i].active:
            return i
        i = i + 1
    return -1

fn __asyncRegisterRecvDone(kind: int32, side: int32, streamId: int64, ackLen: int32, timeoutMs: int32) =
    let f = __asyncFrameAlloc()
    if f < 0:
        return
    __asyncFrames[f].kind = kind
    __asyncFrames[f].seg = 1
    __asyncFrames[f].waitKind = 1
    __asyncFrames[f].side = side
    __asyncFrames[f].streamId = streamId
    __asyncFrames[f].ackLen = ackLen
    __asyncFrames[f].deadlineMs = __asyncNowMs + timeoutMs
    __asyncFrames[f].active = true

fn __asyncFrameReady(frameIdx: int32): bool =
    if __asyncFrames[frameIdx].waitKind == 1:
        if __asyncRecvTryAck(__asyncFrames[frameIdx].side, __asyncFrames[frameIdx].streamId, __asyncFrames[frameIdx].ackLen) >= 1:
            return true
        return __asyncNowMs >= __asyncFrames[frameIdx].deadlineMs
    return __asyncNowMs >= __asyncFrames[frameIdx].deadlineMs

fn __asyncResume(frameIdx: int32) =
    let k = __asyncFrames[frameIdx].kind
    if k == 1:
        chtSocialLike__resume()
        return
    k

fn __asyncAnyActive(): bool =
    var i: int32
    i = 0
    while i < 8:
        if __asyncFrames[i].active:
            return true
        i = i + 1
    return false

fn __asyncPump() =
    if !__asyncClockStarted:
        __asyncBaseNs = __asyncHostMonotimeNs()
        __asyncClockStarted = true
    __asyncNowMs = int32((__asyncHostMonotimeNs() - __asyncBaseNs) / int64(1000000))
    var i: int32
    i = 0
    while i < 8:
        if __asyncFrames[i].active:
            if __asyncFrameReady(i):
                __asyncFrames[i].active = false
                __asyncResume(i)
        i = i + 1

# the lowered handler: seg0 (send plus suspend) then resume (post-await state).
# This is the shape the transpiler await-split produces for handleLike: the
# synchronous prefix sets the busy slot, issues the real send, registers the
# recv-done frame, and returns (suspends). The resume clears the busy slot.
fn chtSocialLike__seg0(like: bool) =
    __chtState_engagementBusy = "like"
    let protocol: int32 = types.Libp2pProtocolSocialMomentLike
    let selRes = quic_transport.Libp2pQuicLoopbackSelectProtocol(gPair, protocol)
    if IsErr(selRes):
        panic(ErrorText(selRes))
    let frame = social.WebSceneSocialBuildLikeFrameExport("post-await-split", like)
    let wRes = quic_transport.Libp2pQuicLoopbackWriteClient(gPair, frame)
    if IsErr(wRes):
        panic(ErrorText(wRes))
    __asyncRegisterRecvDone(1, gClientSide, gClientRecvStream, 1, 5000)

fn chtSocialLike__resume() =
    __chtState_engagementBusy = ""

# Server peer: read the request frame and write the 1-byte ack (the post owner).
fn servePeerOnce() =
    let lenRes = quic_transport.Libp2pQuicLoopbackReadServer(gPair, 4)
    if IsErr(lenRes):
        panic(ErrorText(lenRes))
    let lenBytes = Value(lenRes)
    let idLen: int32 = (rawbytes.BytesGet(lenBytes, 0) << 24) |
                       (rawbytes.BytesGet(lenBytes, 1) << 16) |
                       (rawbytes.BytesGet(lenBytes, 2) << 8) |
                       rawbytes.BytesGet(lenBytes, 3)
    let bodyRes = quic_transport.Libp2pQuicLoopbackReadServer(gPair, idLen + 1)
    if IsErr(bodyRes):
        panic(ErrorText(bodyRes))
    var ack = rawbytes.BytesAlloc(1)
    rawbytes.BytesSet(ack, 0, 1)
    let ackW = quic_transport.Libp2pQuicLoopbackWriteServer(gPair, ack)
    if IsErr(ackW):
        panic(ErrorText(ackW))

fn logLine(s: str) =
    os.WriteLine(os.Get_stdout(), s)

fn main(): int32 =
    var listenAddr: types.Libp2pMultiaddr
    multiaddr.Libp2pMultiaddrFillQuic(listenAddr, "127.0.0.1", 0)
    let openRes = quic_transport.Libp2pQuicLoopbackOpenInto(gPair, listenAddr)
    if IsErr(openRes):
        panic(ErrorText(openRes))
    gClientSide = gPair.outbound.pipeSide
    gClientRecvStream = gPair.outbound.recvStreamId
    logLine("harness: loopback peer ready")

    logLine(strings.ConcatStr("before dispatch engagementBusy=", __chtState_engagementBusy))
    chtSocialLike__seg0(true)
    logLine(strings.ConcatStr("after seg0 (suspended) engagementBusy=", __chtState_engagementBusy))
    if __chtState_engagementBusy != "like":
        panic("seg0 did not set busy")
    if !__asyncAnyActive():
        panic("seg0 did not register a recv-done frame (no suspend)")
    logLine("after seg0: 1 recv-done frame armed (real send transmitted, suspended)")

    servePeerOnce()
    logLine("peer served request + transmitted ack")

    var ticks: int32 = 0
    while __asyncAnyActive() && ticks < 2000:
        __asyncPump()
        ticks = ticks + 1
    logLine(strings.ConcatStr("pump ticks to resume=", strings.IntToStr(ticks)))
    if __asyncAnyActive():
        panic("frame never resumed (real done-signal not observed)")

    logLine(strings.ConcatStr("after resume engagementBusy=", __chtState_engagementBusy))
    quic_transport.Libp2pQuicLoopbackClose(gPair)
    if __chtState_engagementBusy != "":
        panic("resume did not clear busy")
    logLine("AWAIT_SPLIT_RECV_DONE_OK")
    return 0
