type
    R15Bundle =
        fds: int32[]
        paths: str[]
        tag: str

fn R15Open(out: var R15Bundle) =
    add(out.fds, 11)
    add(out.fds, 22)
    add(out.paths, "stage.o")
    add(out.paths, "provider.o")

fn R15Close(out: var R15Bundle): bool =
    out.fds = []
    out.paths = []
    return true

fn R15Run(fdsOut: var int32, pathsOut: var int32, firstOut: var str): int32 =
    var b: R15Bundle
    b.tag = "pins"
    R15Open(b)
    if b.fds.len != 2:
        return 10
    if b.paths.len != 2:
        return 11
    if b.fds[1] != 22:
        return 12
    firstOut = b.paths[0]
    if !R15Close(b):
        return 13
    fdsOut = b.fds.len
    pathsOut = b.paths.len
    if b.tag != "pins":
        return 14
    return 0

fn main(): int32 =
    var fds = 0
    var paths = 0
    var first: str
    let code = R15Run(fds, paths, first)
    if code != 0:
        return code
    if fds != 0:
        return 20
    if paths != 0:
        return 21
    if first != "stage.o":
        return 22
    echo(Fmt"r15_emptyseq_store ok fds={fds} paths={paths} first={first}")
    return 0
