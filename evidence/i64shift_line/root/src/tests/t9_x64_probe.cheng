import std/os
import std/strings

fn main(): int32 =
    var acc: int32 = 0
    for i in 0..<1000:
        var s: str = strings.IntToStr(i)
        acc = acc + len(s)
    var v: str = strings.int64ToStr(-987654321098)
    var q: str = os.QuoteShell("it's")
    var qe: str = os.QuoteShell("")
    var p: str = PathJoin("alpha", "beta")
    var pe: str = PathJoin("", "")
    if acc <= 0: return 1
    return 0
