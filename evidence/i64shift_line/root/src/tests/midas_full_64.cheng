# MiDaS v2.1-small 全图定点前向 (纯 Cheng; 生成于 artifacts/csg_asset_pipeline/gen_cheng_full.py)
# 契约: 权重 WS=1000000, 激活 AS=10000; conv int64 累加; trunc(acc/1000000)+bias; relu6=clamp[0,60000]
import std/cmdline
import std/rawbytes
import cheng/game/assets/import/reader

fn main(): int32 =
    let wpath = cmdline.paramStr(1)
    var data: rawbytes.Bytes
    var bounds = reader.AssetReaderBoundsFor("mp4")
    assert(reader.AssetReaderLoadBounded(wpath, bounds, data), "wload")
    var pool: int32[]
    var tOff: int32[]
    var v: int64
    assert(reader.AssetReaderU32At(data, 4, v), "cnt")
    let cnt: int32 = int32(v)
    var off: int32 = 8
    for i in 0..<cnt:
        assert(reader.AssetReaderU32At(data, off, v), "nl")
        let nl: int32 = int32(v)
        off = off + 4 + nl
        assert(reader.AssetReaderU32At(data, off, v), "nd")
        let nd: int32 = int32(v)
        off = off + 4 + nd * 4
        off = off + 4
        assert(reader.AssetReaderU32At(data, off, v), "n")
        let n: int32 = int32(v)
        off = off + 4
        add(tOff, pool.len)
        for k in 0..<n:
            assert(reader.AssetReaderU32At(data, off + k * 4, v), "wv")
            if v > 2147483647:
                v = v - 4294967296
            add(pool, int32(v))
        off = off + n * 4
    echo(Fmt"weights entries={cnt} pool={pool.len}")
    let r0: int32 = main2(pool, tOff)
    return r0

