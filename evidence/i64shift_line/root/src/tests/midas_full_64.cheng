            for ox in 0..<64:
                var acc: int64
                var first: bool = true
                for ic in 0..<32:
                    for ky in 0..<3:
                        let iy: int32 = oy * 1 + ky - 1
                        if iy >= 0 && iy < 64:
                            for kx in 0..<3:
                                let ix: int32 = ox * 1 + kx - 1
                                if ix >= 0 && ix < 64:
                                    let term: int64 = int64(t_scratch_output_conv_1[(ic * 64 + iy) * 64 + ix]) * int64(pool[w95 + oc * 288 + ic * 9 + ky * 3 + kx])
                                    if first:
                                        acc = term
                                        first = false
                                    else:
                                        acc = acc + term
                var r: int32 = int32(acc / 1000000 + int64(pool[b95 + oc]))
                add(t_scratch_output_conv_2, r)
