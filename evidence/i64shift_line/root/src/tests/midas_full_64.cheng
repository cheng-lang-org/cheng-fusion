    var t_pretrained_layer1_0: int32[]
    let w0: int32 = tOff[0]
    let b0: int32 = tOff[1]
    for oc in 0..<32:
        for oy in 0..<32:
            for ox in 0..<32:
                var acc: int64
                var first: bool = true
                for ic in 0..<3:
                    for ky in 0..<3:
                        let iy: int32 = oy * 2 + ky - 0
                        if iy >= 0 && iy < 64:
                            for kx in 0..<3:
                                let ix: int32 = ox * 2 + kx - 0
                                if ix >= 0 && ix < 64:
                                    let term: int64 = int64(x[(ic * 64 + iy) * 64 + ix]) * int64(pool[w0 + oc * 27 + ic * 9 + ky * 3 + kx])
                                    if first:
                                        acc = term
                                        first = false
                                    else:
