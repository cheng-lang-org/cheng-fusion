    var t_scratch_output_conv_1: int32[]
    for c in 0::<32:
        for i in 0..<64:
            let sy: int64 = ((int64(2 * i + 1) * int64(32) * 65536) / int64(128)) - 32768
            var y0: int32 = int32(sy >> 16)
            var fy: int32 = int32(sy - (int64(y0) << 16))
            if y0 < 0:
                y0 = 0
                fy = 0
            if y0 > 30:
                y0 = 30
                fy = 0
            let wy: int32 = 65536 - fy
            let y1: int32 = y0 + 1
            for j in 0..<64:
                let sx: int64 = ((int64(2 * j + 1) * int64(32) * 65536) / int64(128)) - 32768
                var x0: int32 = int32(sx >> 16)
                var fx: int32 = int32(sx - (int64(x0) << 16))
                if x0 < 0:
                    x0 = 0
                    fx = 0
                if x0 > 30:
                    x0 = 30
                    fx = 0
                let wx: int32 = 65536 - fx
                let x1: int32 = x0 + 1
                    let p00: int64 = int64(t_scratch_output_conv_0[(c * 32 + y0) * 32 + x0])
                    let p01: int64 = int64(t_scratch_output_conv_0[(c * 32 + y0) * 32 + x1])
                    let p10: int64 = int64(t_scratch_output_conv_0[(c * 32 + y1) * 32 + x0])
                    let p11: int64 = int64(t_scratch_output_conv_0[(c * 32 + y1) * 32 + x1])
                    let top: int64 = p00 * int64(wx) + p01 * int64(fx)
                    let bot: int64 = p10 * int64(wx) + p11 * int64(fx)
                    let vv: int64 = (top * int64(wy) + bot * int64(fy)) >> 32
                    add(t_scratch_output_conv_1, int32(vv))
