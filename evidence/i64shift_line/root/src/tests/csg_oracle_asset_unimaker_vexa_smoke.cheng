import std/os as os
import std/result
import std/rawbytes
import cheng/core/csg_asset/oracle_asset as asset
import cheng/core/csg_core/validator as csg
import cheng/core/csg_core/csgc

@borrows
fn smokeFail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

fn smokeExpect(cond: bool, message: str): int32 =
    if !cond:
        return smokeFail(message)
    return 0

fn smokePrintErrors(result: csg.CsgCoreValidationResult) =
    os.WriteLine(os.Get_stderr(), csg.CsgCoreValidationReportJson(result))
    for i in 0..<result.errors.len:
        os.WriteLine(os.Get_stderr(), result.errors[i])

fn smokeObservation(): asset.OracleAssetObservation =
    return asset.OracleAssetObservation(
        id: "obs_unimaker_product_001",
        sourceKind: "oracle_bft_committee",
        sourceUri: "oracle://cheng/mainnet/unimaker/product/001",
        subjectId: "unimaker_product_001",
        valueHash: asset.AssetSha256("product title license media price inventory"),
        observedAtMs: int64(600000),
        ttlMs: int64(60000),
        reporterCount: 7,
        quorum: 5,
        appHash: asset.AssetSha256("oracle app hash round 10"),
        receiptHash: asset.AssetSha256("oracle signed receipt round 10 product 001")
    )

fn smokeClaim(observation: asset.OracleAssetObservation): asset.UnimakerProductSourceClaim =
    return asset.UnimakerProductSourceClaim(
        id: "claim_unimaker_product_001",
        productId: "unimaker_product_001",
        sourceId: observation.id,
        sellerId: "did:unimaker:seller_alice",
        titleHash: asset.AssetSha256("UniMaker deterministic product"),
        licenseHash: asset.AssetSha256("seller authorized publish license"),
        mediaAssetCid: "bafybeigdyrztmedia001",
        priceE8: int64(1990000000),
        inventory: int64(25),
        observedAtMs: observation.observedAtMs,
        ttlMs: observation.ttlMs,
        oracleReceiptHash: observation.receiptHash,
        signerHash: asset.AssetSha256("seller passkey signature over claim"),
        authorized: true
    )

fn smokeLinesEqual(left: str[], right: str[]): bool =
    if left.len != right.len:
        return false
    for i in 0..<left.len:
        if left[i] != right[i]:
            return false
    return true

fn main(): int32 =
    var observation = smokeObservation()
    var claim = smokeClaim(observation)
    observation.valueHash = asset.UnimakerProductObservationValueHash(claim)
    if smokeExpect(!asset.OracleAssetObservationExpired(observation, int64(620000)),
                   "fresh oracle observation should not be expired") != 0:
        return 1
    if smokeExpect(asset.OracleAssetObservationExpired(observation, int64(700001)),
                   "old oracle observation must expire") != 0:
        return 1

    let observationOk = asset.OracleAssetObservationValidate(observation, int64(620000))
    if smokeExpect(observationOk.ok, "oracle observation should validate") != 0:
        os.WriteLine(os.Get_stderr(), observationOk.err.msg)
        return 1

    let certRes = asset.UnimakerCompileProductCertificateFromObservation(claim, observation, int64(620000))
    if smokeExpect(certRes.ok, "authorized fresh product claim should compile") != 0:
        os.WriteLine(os.Get_stderr(), certRes.err.msg)
        return 1
    let cert = certRes.value
    if smokeExpect(cert.complete, "product certificate must be complete") != 0:
        return 1
    if smokeExpect(cert.trustLevel == asset.AssetTrustVerified, "product certificate should be verified") != 0:
        return 1
    if smokeExpect(cert.validUntilMs == int64(660000), "product certificate validUntil mismatch") != 0:
        return 1

    let certAgain = asset.UnimakerCompileProductCertificateFromObservation(claim, observation, int64(620000))
    if smokeExpect(certAgain.ok, "repeated product claim compile should succeed") != 0:
        return 1
    if smokeExpect(certAgain.value.receiptHash == cert.receiptHash,
                   "same product claim must produce stable receipt hash") != 0:
        return 1

    let candidateRes = asset.VexaAssetFromProductCertificate(cert)
    if smokeExpect(candidateRes.ok, "verified product certificate should become Vexa asset") != 0:
        os.WriteLine(os.Get_stderr(), candidateRes.err.msg)
        return 1
    let candidate = candidateRes.value
    if smokeExpect(candidate.eligibleForPlan, "verified Vexa asset should be eligible for deterministic plan") != 0:
        return 1
    if smokeExpect(candidate.sourceProfile == asset.UnimakerProductDialectProfile,
                   "Vexa asset should preserve UniMaker source profile") != 0:
        return 1

    var attestedCert = cert
    attestedCert.trustLevel = asset.AssetTrustAttested
    let attestedCandidate = asset.VexaAssetFromProductCertificate(attestedCert)
    if smokeExpect(attestedCandidate.ok, "attested asset should still be representable") != 0:
        return 1
    if smokeExpect(!attestedCandidate.value.eligibleForPlan,
                   "attested asset must not enter deterministic plan") != 0:
        return 1

    let lines = asset.CsgAssetFactsDebugLines(observation, cert, candidate)
    let validation = csg.CsgCoreValidateFactLines(lines, csg.CsgCoreModeStrict)
    if smokeExpect(validation.valid, "oracle asset / UniMaker / Vexa facts should validate") != 0:
        smokePrintErrors(validation)
        return 1
    if smokeExpect(validation.complete, "strict asset facts should be complete") != 0:
        return 1
    if smokeExpect(validation.factCount == 4, "asset fact count mismatch") != 0:
        return 1
    let expectedProfiles = [
        csg.CsgCoreBaseProfileIdentity(),
        asset.OracleAssetDialectProfile,
        asset.UnimakerProductDialectProfile,
        asset.VexaDialectProfile
    ]
    if smokeExpect(
           csg.CsgCoreProfilesEqual(
               validation.profiles,
               expectedProfiles) &&
           validation.profileSetCid ==
               csg.CsgCoreProfileSetCid(
                   expectedProfiles),
           "asset profile set mismatch") != 0:
        return 1

    let root = asset.CsgAssetFactsRoot(lines)
    let rootAgain = asset.CsgAssetFactsRoot(asset.CsgAssetFactsDebugLines(observation, cert, candidate))
    if smokeExpect(root == rootAgain, "repeated asset facts root must be byte-stable") != 0:
        return 1

    let encoded = asset.CsgAssetEncodeCsgc(lines)
    if smokeExpect(encoded.ok, "asset facts should encode as CSGC") != 0:
        os.WriteLine(os.Get_stderr(), encoded.error)
        return 1
    if smokeExpect(rawbytes.BytesLen(encoded.bytes) > 64, "CSGC asset bytes should be non-empty") != 0:
        return 1
    let decoded = csgc.CsgCoreCsgcDecodeLines(encoded.bytes)
    if smokeExpect(decoded.ok, "CSGC asset facts should decode") != 0:
        os.WriteLine(os.Get_stderr(), decoded.error)
        return 1
    if smokeExpect(smokeLinesEqual(lines, decoded.lines), "CSGC decoded lines must equal original lines") != 0:
        return 1
    if smokeExpect(asset.CsgAssetFactsRoot(decoded.lines) == root, "decoded CSGC root must match original root") != 0:
        return 1

    let preconditionHash = asset.AssetSha256("publish route authorized and inventory locked")
    let planRes = asset.VexaCompileDeterministicPlan(candidate,
                                                     root,
                                                     "unimaker.publish_product",
                                                     preconditionHash,
                                                     int64(621000),
                                                     int64(650000))
    if smokeExpect(planRes.ok, "eligible Vexa asset should compile deterministic plan") != 0:
        os.WriteLine(os.Get_stderr(), planRes.err.msg)
        return 1
    let plan = planRes.value
    if smokeExpect(plan.complete, "Vexa plan must be complete") != 0:
        return 1
    if smokeExpect(plan.planRoot == asset.VexaDeterministicPlanRoot(plan),
                   "Vexa plan root must match canonical preimage") != 0:
        return 1
    if smokeExpect(plan.proofHash == asset.VexaDeterministicPlanProofHash(plan),
                   "Vexa plan proof must match plan root") != 0:
        return 1

    let receiptRes = asset.VexaCommitExecutionReceipt(plan,
                                                      "cheng_executor_unimaker_publish",
                                                      asset.AssetSha256("publish executor input state"),
                                                      asset.AssetSha256("published product state"),
                                                      int64(630000),
                                                      "committed")
    if smokeExpect(receiptRes.ok, "valid Vexa plan should commit execution receipt") != 0:
        os.WriteLine(os.Get_stderr(), receiptRes.err.msg)
        return 1
    let receipt = receiptRes.value
    if smokeExpect(receipt.receiptHash == asset.VexaExecutionReceiptHash(receipt),
                   "execution receipt hash must match canonical preimage") != 0:
        return 1

    let cellRes = asset.VexaBuildRecoverableCell(root,
                                                 plan,
                                                 receipt,
                                                 asset.AssetSha256("resume token for product publish cell"))
    if smokeExpect(cellRes.ok, "execution receipt should form recoverable Cell") != 0:
        os.WriteLine(os.Get_stderr(), cellRes.err.msg)
        return 1
    let cell = cellRes.value
    if smokeExpect(cell.complete, "recoverable Cell must be complete") != 0:
        return 1
    if smokeExpect(cell.recoveryRoot == asset.VexaRecoverableCellRoot(cell),
                   "recoverable Cell root must match canonical preimage") != 0:
        return 1

    let closedLines = asset.CsgAssetClosedLoopFactsDebugLines(observation, cert, candidate, plan, receipt, cell)
    let closedValidation = csg.CsgCoreValidateFactLines(closedLines, csg.CsgCoreModeStrict)
    if smokeExpect(closedValidation.valid, "closed-loop CSG facts should validate") != 0:
        smokePrintErrors(closedValidation)
        return 1
    if smokeExpect(closedValidation.complete, "closed-loop CSG facts should be complete") != 0:
        return 1
    if smokeExpect(closedValidation.factCount == 7, "closed-loop fact count mismatch") != 0:
        return 1
    let closedRoot = asset.CsgAssetFactsRoot(closedLines)
    let closedRootAgain = asset.CsgAssetFactsRoot(asset.CsgAssetClosedLoopFactsDebugLines(observation,
                                                                                         cert,
                                                                                         candidate,
                                                                                         plan,
                                                                                         receipt,
                                                                                         cell))
    if smokeExpect(closedRoot == closedRootAgain, "closed-loop facts root must be byte-stable") != 0:
        return 1
    let closedEncoded = asset.CsgAssetEncodeCsgc(closedLines)
    if smokeExpect(closedEncoded.ok, "closed-loop facts should encode as CSGC") != 0:
        os.WriteLine(os.Get_stderr(), closedEncoded.error)
        return 1
    let closedDecoded = csgc.CsgCoreCsgcDecodeLines(closedEncoded.bytes)
    if smokeExpect(closedDecoded.ok, "closed-loop CSGC should decode") != 0:
        os.WriteLine(os.Get_stderr(), closedDecoded.error)
        return 1
    if smokeExpect(smokeLinesEqual(closedLines, closedDecoded.lines),
                   "closed-loop CSGC decoded lines must equal original lines") != 0:
        return 1
    if smokeExpect(asset.CsgAssetFactsRoot(closedDecoded.lines) == closedRoot,
                   "closed-loop decoded CSGC root must match original root") != 0:
        return 1

    let attestedPlanRes = asset.VexaCompileDeterministicPlan(attestedCandidate.value,
                                                             root,
                                                             "unimaker.publish_product",
                                                             preconditionHash,
                                                             int64(621000),
                                                             int64(650000))
    if smokeExpect(!attestedPlanRes.ok, "attested Vexa asset must not compile plan") != 0:
        return 1

    let expiredReceiptRes = asset.VexaCommitExecutionReceipt(plan,
                                                             "cheng_executor_unimaker_publish",
                                                             asset.AssetSha256("publish executor input state"),
                                                             asset.AssetSha256("published product state"),
                                                             int64(660001),
                                                             "committed")
    if smokeExpect(!expiredReceiptRes.ok, "execution after plan validity must fail") != 0:
        return 1

    var tamperedPlan = plan
    tamperedPlan.planRoot = asset.AssetSha256("tampered plan root")
    let tamperedReceiptRes = asset.VexaCommitExecutionReceipt(tamperedPlan,
                                                              "cheng_executor_unimaker_publish",
                                                              asset.AssetSha256("publish executor input state"),
                                                              asset.AssetSha256("published product state"),
                                                              int64(630000),
                                                              "committed")
    if smokeExpect(!tamperedReceiptRes.ok, "tampered plan root must fail receipt commit") != 0:
        return 1

    var mismatchedReceiptForCell = receipt
    mismatchedReceiptForCell.planRoot = asset.AssetSha256("different plan root")
    let badCellRes = asset.VexaBuildRecoverableCell(root,
                                                    plan,
                                                    mismatchedReceiptForCell,
                                                    asset.AssetSha256("resume token for product publish cell"))
    if smokeExpect(!badCellRes.ok, "mismatched receipt plan root must fail Cell build") != 0:
        return 1

    var unauthorized = claim
    unauthorized.authorized = false
    var unauthorizedObservation = observation
    unauthorizedObservation.valueHash = asset.UnimakerProductObservationValueHash(unauthorized)
    let unauthorizedRes = asset.UnimakerCompileProductCertificateFromObservation(unauthorized,
                                                                                 unauthorizedObservation,
                                                                                 int64(620000))
    if smokeExpect(!unauthorizedRes.ok, "unauthorized product claim must fail") != 0:
        return 1

    var expired = claim
    expired.observedAtMs = int64(1)
    var expiredObservation = observation
    expiredObservation.valueHash = asset.UnimakerProductObservationValueHash(expired)
    let expiredRes = asset.UnimakerCompileProductCertificateFromObservation(expired,
                                                                            expiredObservation,
                                                                            int64(700000))
    if smokeExpect(!expiredRes.ok, "expired product claim must fail") != 0:
        return 1

    var missingSigner = claim
    missingSigner.signerHash = "not-a-hash"
    var missingSignerObservation = observation
    missingSignerObservation.valueHash = asset.UnimakerProductObservationValueHash(missingSigner)
    let missingSignerRes = asset.UnimakerCompileProductCertificateFromObservation(missingSigner,
                                                                                  missingSignerObservation,
                                                                                  int64(620000))
    if smokeExpect(!missingSignerRes.ok, "bad signer hash must fail") != 0:
        return 1

    var mismatchedValueObservation = observation
    mismatchedValueObservation.valueHash = asset.AssetSha256("different product claim value")
    let mismatchedValueRes = asset.UnimakerCompileProductCertificateFromObservation(claim,
                                                                                   mismatchedValueObservation,
                                                                                   int64(620000))
    if smokeExpect(!mismatchedValueRes.ok, "mismatched product value hash must fail") != 0:
        return 1

    var mismatchedReceipt = claim
    mismatchedReceipt.oracleReceiptHash = asset.AssetSha256("different oracle receipt")
    let mismatchedReceiptRes = asset.UnimakerCompileProductCertificateFromObservation(mismatchedReceipt,
                                                                                      observation,
                                                                                      int64(620000))
    if smokeExpect(!mismatchedReceiptRes.ok, "mismatched oracle receipt must fail") != 0:
        return 1

    var unknownFactLines: str[]
    add(unknownFactLines, lines[0])
    add(unknownFactLines, "{\"kind\":\"csg_dialect::vexa::unknown\",\"id\":\"bad\"}")
    let unknownValidation = csg.CsgCoreValidateFactLines(unknownFactLines, csg.CsgCoreModeStrict)
    if smokeExpect(!unknownValidation.valid, "unknown Vexa fact must fail") != 0:
        return 1
    if smokeExpect(asset.CsgAssetFactsRoot(unknownFactLines).len == 0,
                   "unknown Vexa fact must not publish a facts root") != 0:
        return 1
    let unknownEncoded = asset.CsgAssetEncodeCsgc(unknownFactLines)
    if smokeExpect(!unknownEncoded.ok,
                   "unknown Vexa fact must not encode as production CSGC") != 0:
        return 1

    var incompleteLines: str[]
    add(incompleteLines, lines[0])
    add(incompleteLines, "{\"kind\":\"csg_dialect::unimaker_product::certificate\",\"id\":\"cert_bad\",\"productId\":\"bad\",\"complete\":false,\"trustLevel\":\"verified\",\"productRoot\":\"sha256:x\",\"oracleReceiptHash\":\"sha256:y\",\"mediaAssetCid\":\"cid\",\"priceE8\":1,\"inventory\":1,\"validUntilMs\":1,\"receiptHash\":\"sha256:z\"}")
    let incompleteValidation = csg.CsgCoreValidateFactLines(incompleteLines, csg.CsgCoreModeStrict)
    if smokeExpect(!incompleteValidation.valid, "complete=false UniMaker certificate must fail") != 0:
        return 1

    var incompletePlanLines: str[]
    add(incompletePlanLines, lines[0])
    add(incompletePlanLines, "{\"kind\":\"csg_dialect::vexa::deterministic_plan\",\"id\":\"bad_plan\",\"complete\":false,\"assetId\":\"asset\",\"assetFactRoot\":\"sha256:facts\",\"actionKind\":\"unimaker.publish_product\",\"preconditionHash\":\"sha256:pre\",\"capabilityHash\":\"sha256:cap\",\"riskHash\":\"sha256:risk\",\"createdAtMs\":1,\"validUntilMs\":2,\"planRoot\":\"sha256:plan\",\"proofHash\":\"sha256:proof\"}")
    let incompletePlanValidation = csg.CsgCoreValidateFactLines(incompletePlanLines, csg.CsgCoreModeStrict)
    if smokeExpect(!incompletePlanValidation.valid, "complete=false Vexa plan must fail") != 0:
        return 1

    os.WriteLine(os.Get_stdout(), "csg_oracle_asset_unimaker_vexa_smoke ok")
    return 0
