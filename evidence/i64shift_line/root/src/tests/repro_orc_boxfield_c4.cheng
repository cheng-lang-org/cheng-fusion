import std/system
import std/hashmaps as hashmaps

type
    ReproBox4 = ref object
        m: hashmaps.HashMapStrInt

@borrows
fn reproRoundtrip4(b: ReproBox4) =
    var wrapper = b.m
    b.m = hashmaps.HashMapStrInt()
    b.m = wrapper

fn main() =
    var b: ReproBox4 = new(ReproBox4)
    hashmaps.HashMapStrIntInitInPlace(b.m, 64)
    reproRoundtrip4(b)
    echo("repro_orc_boxfield_c4 ok")
