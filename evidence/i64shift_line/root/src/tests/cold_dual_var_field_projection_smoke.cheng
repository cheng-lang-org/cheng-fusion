import std/strings as strings

type
    ColdDualVarFieldLedger =
        count: int32

    ColdDualVarFieldOwner =
        ledger: ColdDualVarFieldLedger
        counts: int32[]
        names: str[]
        paths: str[]
        flags: bool[]

@borrows
fn coldDualVarFieldAdd(
        ledger: var ColdDualVarFieldLedger,
        values: var str[],
        value: str) =
    add(values, strings.CloneStr(value))
    ledger.count = ledger.count + 1

fn coldDualVarFieldAdd(
        ledger: var ColdDualVarFieldLedger,
        values: var int32[],
        value: int32) =
    add(values, value)
    ledger.count = ledger.count + 1

fn coldDualVarFieldAdd(
        ledger: var ColdDualVarFieldLedger,
        values: var bool[],
        value: bool) =
    add(values, value)
    ledger.count = ledger.count + 1

@borrows
fn coldDualVarFieldAppend(
        owner: var ColdDualVarFieldOwner,
        value: str) =
    coldDualVarFieldAdd(owner.ledger, owner.counts, 1)
    coldDualVarFieldAdd(owner.ledger, owner.names, value)
    coldDualVarFieldAdd(owner.ledger, owner.paths, value)
    coldDualVarFieldAdd(owner.ledger, owner.flags, true)

fn main(): int32 =
    var owner: ColdDualVarFieldOwner
    coldDualVarFieldAppend(owner, "first")
    coldDualVarFieldAppend(owner, "second")
    if owner.ledger.count != 8 || owner.names.len != 2:
        return 1
    if owner.names[0] != "first" || owner.names[1] != "second":
        return 2
    return 0
