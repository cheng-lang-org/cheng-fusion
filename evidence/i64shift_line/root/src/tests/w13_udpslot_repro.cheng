import std/os

const
    maxSlots = 64

type
    Slots =
        active: bool[maxSlots]
        fd: int32[maxSlots]
        useLenField: bool[maxSlots]

fn bridgeVal(): int32 =
    return 1

fn slotResetAt(slots: var Slots, idx: int32) =
    slots.active[idx] = false
    slots.fd[idx] = -1
    slots.useLenField[idx] = bridgeVal() != 0

fn main(): int32 =
    var s: Slots
    s.useLenField[0] = false
    s.useLenField[7] = false
    slotResetAt(s, 3)
    assert(!s.active[3], "w13: active must be false")
    assert(s.fd[3] == -1, "w13: fd must be -1")
    assert(s.useLenField[3], "w13: useLenField[3] must be true when bridgeVal()!=0")
    # Address-arithmetic sanity: only index 3 should have been touched — a
    # dropped/collapsed index (miscompile always writing element 0) would
    # leave useLenField[3] false and/or corrupt neighboring elements.
    assert(!s.useLenField[0], "w13: useLenField[0] must remain untouched (false)")
    assert(!s.useLenField[7], "w13: useLenField[7] must remain untouched (false)")
    os.WriteLine(os.Get_stdout(), "w13_udpslot_repro: PASS")
    return 0
