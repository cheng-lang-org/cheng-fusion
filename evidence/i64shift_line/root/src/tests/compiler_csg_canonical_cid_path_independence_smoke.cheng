import std/system
import std/result
import cheng/core/lang/parser as parser
import cheng/core/tooling/compiler_csg as ccsg
import cheng/libp2p/cas_store as cas
import cheng/std/bytes_layout as layout
import std/os as os

# libp2p CAS producer 门禁: 钉了 package_id 的两个不同 basename 包根,
# 必产生 basename 无关的 canonical graph cid。固化 findings P1 案卷
# (2026-07-04, wf_dd94b2f3) 的 probe 方法为永久夹具, 挂 CONTEXT §12 C6-cheap。
#
# 污染契约链 (未钉 package_id 时 basename 岔开 cid, 正是本门禁守的):
#   ParserPackageId(root)                 [parser.cheng:1797; pkg:// 命中即忽略 basename,
#                                          否则 :1807-1818 basename 兜底 -> cheng/<basename>]
#   -> ParserSourcePathToModulePath       [parser.cheng:8580; packageId 拼进 modulePath]
#   -> CompilerCsgHashNode                [compiler_csg.cheng:1605; modulePath 入 factCid]
#   -> CompilerCsgCanonicalGraphCid       [compiler_csg.cheng:4316/4329; packageId+factCid 聚成 cid]
#
# 修法结论 (P1 裁决丙 = 甲 scoped 到 CAS 边界): 不改 ParserPackageId 语义 (basename
# 兜底是本地/未钉包合法机制, import 解析零影响), 而在网络/CAS admission 唯一必要点
# (cas_store.CasAdmissionPackageId) 重读 cheng-package.toml, package_id 未钉即硬错。
# 未钉包永不进共享 CAS => basename 永不进共享 cid。本仓 cheng-package.toml 已钉
# package_id = "pkg://cheng"。
#
# 翻转 (step-6): step-4 仍记录 parser 层 basename 污染现状 (证明"若被纳入会岔开 cid"),
# 但 step-6 断言同一 unpinned 根被 CAS admission 拒收 (Err) => 污染 cid 永不上共享网。
# 钉了 package_id 的两不同 basename 根则 admission 收敛到同一 pkg:// id。
# 断言失败即 abort 非零, 末行 "ok" 不打印。

# ParserPackageId 读盘 (PathReadTextFileWithHandle), 本夹具是 exe run 非 census, 读写安全。
# 临时树建在 TMPDIR 之外于仓库树, 避免仓库根 pkg://cheng manifest 干扰 shared-root 归属。

@borrows
fn writePinnedTree(base: str, name: str): str =
    let root = base + "/" + name
    os.MkdirAll(root + "/src", 493)
    os.WriteFile(root + "/cheng-package.toml", "package_id = \"pkg://cheng\"\n")
    os.WriteFile(root + "/src/foo.cheng", "fn foo() =\n    return\n")
    assert(os.FileExists(root + "/cheng-package.toml"), " pinned manifest written: " + name)
    assert(os.FileExists(root + "/src/foo.cheng"), " pinned source written: " + name)
    return root

@borrows
fn writeUnpinnedTree(base: str, name: str): str =
    let root = base + "/" + name
    os.MkdirAll(root + "/src", 493)
    # 无 cheng-package.toml -> ParserPackageId basename 兜底路径
    let _ = os.RemoveFile(root + "/cheng-package.toml")
    os.WriteFile(root + "/src/foo.cheng", "fn foo() =\n    return\n")
    assert(!os.FileExists(root + "/cheng-package.toml"), " unpinned tree has no manifest: " + name)
    return root

@borrows
fn cleanupTree(root: str) =
    let _ = os.RemoveFile(root + "/cheng-package.toml")
    let _ = os.RemoveFile(root + "/src/foo.cheng")
    os.RemoveDir(root + "/src")
    os.RemoveDir(root)

fn main(): int32 =
    let base = os.GetEnvDefault("TMPDIR", "/tmp") + "/cheng_cid_path_gate"
    os.MkdirAll(base, 493)

    let rootX = writePinnedTree(base, "nameX")
    let rootY = writePinnedTree(base, "nameY")

    # ---- (1) 钉 package_id -> basename 无关 (含尾斜杠中和) ----
    let idX = parser.ParserPackageId(rootX)
    let idY = parser.ParserPackageId(rootY)
    assert(idX == "cheng", " ParserPackageId(nameX pinned) == cheng, got " + idX)
    assert(idY == "cheng", " ParserPackageId(nameY pinned) == cheng, got " + idY)
    assert(idX == idY, " 钉 package_id: basename 无关 (nameX 与 nameY 同 id)")
    assert(parser.ParserPackageId(rootX + "/") == "cheng", " ParserPackageId 尾斜杠中和 -> cheng")

    # ---- (2) 两根同 modulePath ----
    let modX = parser.ParserSourcePathToModulePath(rootX, rootX, rootX + "/src/foo.cheng")
    let modY = parser.ParserSourcePathToModulePath(rootY, rootY, rootY + "/src/foo.cheng")
    assert(modX == "cheng/foo", " modulePath(nameX) == cheng/foo, got " + modX)
    assert(modY == "cheng/foo", " modulePath(nameY) == cheng/foo, got " + modY)
    assert(modX == modY, " 钉后两根 modulePath 相等 (cid 路径无关前置)")

    # ---- (3) load-bearing 引理: modulePath 确实入 cid (证 basename 为何污染) ----
    let cidFoo1 = ccsg.CompilerCsgHashNode(0, 0, "cheng/foo", "", "", 0, 0, 0, 0, 0, 0, "")
    let cidFoo2 = ccsg.CompilerCsgHashNode(0, 0, "cheng/foo", "", "", 0, 0, 0, 0, 0, 0, "")
    assert(layout.FixedBytes32Equal(cidFoo1, cidFoo2), " CompilerCsgHashNode 确定性 (同 modulePath 同 cid)")
    let cidPollX = ccsg.CompilerCsgHashNode(0, 0, "cheng/nameX/foo", "", "", 0, 0, 0, 0, 0, 0, "")
    let cidPollY = ccsg.CompilerCsgHashNode(0, 0, "cheng/nameY/foo", "", "", 0, 0, 0, 0, 0, 0, "")
    assert(!layout.FixedBytes32Equal(cidPollX, cidPollY), " modulePath 入 cid: 未钉时 basename 岔开 factCid")
    assert(layout.FixedBytes32Equal(
        ccsg.CompilerCsgHashNode(0, 0, modX, "", "", 0, 0, 0, 0, 0, 0, ""),
        ccsg.CompilerCsgHashNode(0, 0, modY, "", "", 0, 0, 0, 0, 0, 0, "")),
        " 钉后 factCid 收敛 (modX==modY -> 同 cid)")

    # ---- (4) 未钉 package_id -> basename 污染 (门禁守的反面; 若日后采 fail-loud 则此处翻转) ----
    let rootZ = writeUnpinnedTree(base, "nameZ")
    let idZ = parser.ParserPackageId(rootZ)
    assert(idZ == "cheng/nameZ", " 未钉 package_id -> basename 污染 cheng/nameZ, got " + idZ)
    let modZ = parser.ParserSourcePathToModulePath(rootZ, rootZ, rootZ + "/src/foo.cheng")
    assert(modZ == "cheng/nameZ/foo", " 未钉: modulePath 带 basename cheng/nameZ/foo, got " + modZ)
    assert(modZ != modX, " 未钉 vs 钉: modulePath 岔开 (污染证据)")

    # ---- (5) 确定性重跑: 全等 ----
    assert(parser.ParserPackageId(rootX) == idX, " 重跑确定性: ParserPackageId(nameX)")
    assert(parser.ParserSourcePathToModulePath(rootX, rootX, rootX + "/src/foo.cheng") == modX,
           " 重跑确定性: modulePath(nameX)")
    assert(layout.FixedBytes32Equal(
        ccsg.CompilerCsgHashNode(0, 0, "cheng/foo", "", "", 0, 0, 0, 0, 0, 0, ""), cidFoo1),
        " 重跑确定性: cid")

    # ---- (6) CAS admission 边界钉死 (裁决丙): 未钉即拒收敛, 钉了即纳且路径无关 ----
    # step-4 证 rootZ 的 basename 会岔开 cid; step-6 证同一 rootZ 被 admission 拒收,
    # 污染 cid 永不进共享 CAS。这是"未钉场景修后收敛"的翻转: 收敛到 fail-loud 拒收。
    let admitZ: Result[str] = cas.CasAdmissionPackageId(rootZ)
    assert(IsErr(admitZ), " CAS admission 拒收未钉 package_id (basename 永不进共享 cid)")
    let admitX: Result[str] = cas.CasAdmissionPackageId(rootX)
    let admitY: Result[str] = cas.CasAdmissionPackageId(rootY)
    assert(admitX.ok, " CAS admission 纳入钉了 package_id 的 nameX")
    assert(admitY.ok, " CAS admission 纳入钉了 package_id 的 nameY")
    assert(Value(admitX) == "pkg://cheng", " CAS admission 返回钉死 id pkg://cheng, got " + Value(admitX))
    assert(Value(admitX) == Value(admitY), " 两不同 basename 钉包 admission 收敛同 id (cid 路径无关网络前置)")
    # 确定性重跑
    let admitZ2: Result[str] = cas.CasAdmissionPackageId(rootZ)
    assert(IsErr(admitZ2), " 重跑确定性: admission 仍拒收未钉根")

    cleanupTree(rootX)
    cleanupTree(rootY)
    cleanupTree(rootZ)
    os.RemoveDir(base)

    echo(" compiler_csg_canonical_cid_path_independence_smoke ok")
    return 0
