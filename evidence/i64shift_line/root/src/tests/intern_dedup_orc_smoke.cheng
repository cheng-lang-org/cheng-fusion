import std/system
import std/strings
import cheng/core/lang/intern as langintern

# Minimal probe: does Intern's duplicate-hit early return release the
# moved-in owned clone? 30000 iterations interning the SAME string via a
# fresh CloneStr each time. If ORC is clean, live stays ~2-3 (pool + one
# entry). If the early-return path leaks the param, live climbs to ~30000.
fn main(): int32 =
    var pool = langintern.InternPoolNew()
    var i: int32
    i = 0
    while i < 30000:
        let id = langintern.Intern(share(pool), strings.CloneStr("SlProbeFnDedupTarget"))
        i = i + 1
    echo(Fmt"final live={system.MemLiveAllocations()} pool_count={langintern.InternPoolCount(pool)}")
    return 0
