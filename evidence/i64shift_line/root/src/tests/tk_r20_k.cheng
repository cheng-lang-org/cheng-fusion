fn R20Make(n: int32): str =
    if n > 0:
        return "continue"
    return "break"

fn R20Append(lineRaw: str): int32 =
    var total: int32
    var searchStart: int32
    while searchStart < lineRaw.len:
        let surfaceText = R20Make(searchStart)
        if searchStart > 5:
            return total
        total = total + surfaceText.len
        searchStart = searchStart + 1
    return total

fn main(): int32 =
    let n = R20Append("ab")
    if n != 13:
        return 10
    echo("r20 ok")
    return 0
