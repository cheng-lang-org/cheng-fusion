type
    ColdExactUniqueBorrowConsumeBox =
        values: str[]

fn ColdExactUniqueBorrowConsumeTake(
        box: ColdExactUniqueBorrowConsumeBox): int32 =
    return box.values.len

fn ColdExactUniqueBorrowConsumeSwap(values: var str[]) =
    let first = values[0]
    values[0] = values[1]
    values[1] = first

fn main(): int32 =
    var box = ColdExactUniqueBorrowConsumeBox()
    add(box.values, "right")
    add(box.values, "left")
    var values = box.values
    let consumedLen = ColdExactUniqueBorrowConsumeTake(box)
    if consumedLen != 2:
        return 11
    ColdExactUniqueBorrowConsumeSwap(values)
    return 0
