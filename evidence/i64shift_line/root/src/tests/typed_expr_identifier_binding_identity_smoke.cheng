import std/cmdline as cmdline
import cheng/core/lang/intern as langintern
import cheng/core/lang/parser as parser
import cheng/core/lang/typed_expr as texpr
import cheng/core/lang/typed_expr_frag_codec as fragcodec
import cheng/core/lang/typed_expr_type_arena as typearena
import cheng/core/runtime/arena as arenamod

fn Source(): str =
    return "fn Run(p0: int32, p1: int32, p2: int32, p3: int32, p4: int32, p5: int32, p6: int32, p7: int32, p8: int32, p9: int32, p10: int32, p11: int32): int32 =\n    var first: int32 = 1\n    return first + p0 + p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8 + p9 + p10 + p11 + p0 + p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8 + p9 + p10 + p11\n"

fn PaddingSourceText(): texpr.TypedExprSourceText =
    var roots: parser.ParserExternalPackageRoot[]
    return texpr.TypedExprSourceTextNewWithPackageFacts(
        "/work",
        "/work",
        "pkg://typed-expr-identifier-binding-padding",
        "1123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
        roots,
        "/work/identifier-binding-padding.cheng",
        "fn Padding(): int32 =\n    return 0\n")

fn SourceText(): texpr.TypedExprSourceText =
    var roots: parser.ParserExternalPackageRoot[]
    return texpr.TypedExprSourceTextNewWithPackageFacts(
        "/work",
        "/work",
        "pkg://typed-expr-identifier-binding",
        "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
        roots,
        "/work/identifier-binding.cheng",
        Source())

fn Build(
        layer: var parser.NormalizedExprLayer,
        ir: var texpr.TypedExprIr,
        exactArena: var typearena.TypedExprTypeArena,
        parameterTypedNode: var int32,
        localTypedNode: var int32,
        parameterOrdinalLookupCount: var int32) =
    let sourceText = SourceText()
    let paddingSourceText = PaddingSourceText()
    var sources = [paddingSourceText, sourceText]
    var err: str
    var sourceContexts: texpr.TypedExprSourceContext[]
    var paddingContext: texpr.TypedExprSourceContext
    assert(texpr.TypedExprBuildSourceContext(
               paddingSourceText, paddingContext, err),
           Fmt"typed expr binding: padding context failed {err}")
    texpr.TypedExprSourceContextAppendMove(
        sourceContexts, paddingContext)
    var sourceContext: texpr.TypedExprSourceContext
    assert(texpr.TypedExprBuildSourceContext(
               sourceText, sourceContext, err),
           Fmt"typed expr binding: source context failed {err}")
    texpr.TypedExprSourceContextAppendMove(
        sourceContexts, sourceContext)
    for contextIndex in 0..<sourceContexts.len:
        texpr.TypedExprSourceContextReleaseBuildIndex(
            sourceContexts[contextIndex])
    let sourceBuildIndex =
        texpr.TypedExprBuildIndexForContexts(sourceContexts, 64)
    for contextIndex in 1..<sourceContexts.len:
        texpr.TypedExprSourceContextSetBorrowedBuildIndex(
            sourceContexts[contextIndex], sourceBuildIndex)
    texpr.TypedExprSourceContextSetOwnedBuildIndex(
        sourceContexts[0], sourceBuildIndex)
    assert(texpr.TypedExprReadNormalizedExprLayerForSourceTexts(
               sources, layer, err),
           Fmt"typed expr binding: normalized layer failed {err}")
    let authority =
        typearena.TypedExprTypeResolutionAuthorityEmpty()
    assert(typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               layer.valueExprTree,
               authority,
               exactArena,
               err),
           Fmt"typed expr binding: TypeArena failed {err}")
    ir.internPool = langintern.InternPoolNew()
    assert(texpr.TypedExprIrBindExactTypeArena(
               ir, exactArena, err),
           Fmt"typed expr binding: TypeArena bind failed {err}")
    texpr.TypedExprIrBeginValueExprBorrow(ir, layer)
    var initializerRoot: int32 = -1
    for exprIndex in 0..<layer.exprs.len:
        if layer.exprs[exprIndex].valueExprStatementRole ==
               parser.ParserValueExprStatementBindingInitializer:
            initializerRoot =
                layer.exprs[exprIndex].valueExprRootNodeIndex
    assert(initializerRoot >= 0,
           "typed expr binding: initializer root missing")
    let parserProducerSourceIndex =
        parser.ParserValueExprNodeProducerSourceIndexAt(
            layer.valueExprTree,
            initializerRoot)
    let producerSourceIndex =
        texpr.TypedExprSourceContextLookup(
            sourceContexts, "/work/identifier-binding.cheng")
    assert(parserProducerSourceIndex >= 0 && producerSourceIndex >= 0,
           "typed expr binding: source identity missing")
    texpr.TypedExprIrSetValueDefinitionProducerSourceIndex(
        ir, parserProducerSourceIndex, producerSourceIndex)
    var ctx = texpr.TypedExprSourceContextBorrowedView(
        sourceContexts[producerSourceIndex])
    var scope: texpr.TypedExprFunctionScope
    scope.sourcePath = ctx.sourcePath
    scope.name = "Run"
    scope.producerDeclarationOrdinal = 0
    scope.startLine = 1
    scope.endLine = 3
    scope.returnType = "int32"
    var groupStart: int32
    var groupCount: int32
    texpr.TypedExprIrRegisterValueDefinitionFunctionGroups(
        ir,
        layer,
        0,
        layer.exprs.len,
        scope,
        0,
        groupStart,
        groupCount)
    assert(groupStart == 0 && groupCount == 1,
           "typed expr binding: definition group drift")
    var params = [
        texpr.TypedExprParam(
            name: "p0",
            typeText: "int32",
            mutableFlag: false),
        texpr.TypedExprParam(
            name: "p1",
            typeText: "int32",
            mutableFlag: false),
        texpr.TypedExprParam(
            name: "p2",
            typeText: "int32",
            mutableFlag: false),
        texpr.TypedExprParam(
            name: "p3",
            typeText: "int32",
            mutableFlag: false),
        texpr.TypedExprParam(
            name: "p4",
            typeText: "int32",
            mutableFlag: false),
        texpr.TypedExprParam(
            name: "p5",
            typeText: "int32",
            mutableFlag: false),
        texpr.TypedExprParam(
            name: "p6",
            typeText: "int32",
            mutableFlag: false),
        texpr.TypedExprParam(
            name: "p7",
            typeText: "int32",
            mutableFlag: false),
        texpr.TypedExprParam(
            name: "p8",
            typeText: "int32",
            mutableFlag: false),
        texpr.TypedExprParam(
            name: "p9",
            typeText: "int32",
            mutableFlag: false),
        texpr.TypedExprParam(
            name: "p10",
            typeText: "int32",
            mutableFlag: false),
        texpr.TypedExprParam(
            name: "p11",
            typeText: "int32",
            mutableFlag: false)]
    var paramDefinitionNodes: int32[]
    texpr.TypedExprIrAddParamNodes(
        ir,
        scope,
        params,
        paramDefinitionNodes)
    texpr.TypedExprIrAppendParameterValueDefinitionsExact(
        ir, scope, 0)
    let definingNode = texpr.TypedExprIrBuildValueExprNode(
        ir,
        ctx,
        sourceContexts,
        scope,
        2,
        initializerRoot,
        "int32")
    texpr.TypedExprIrAppendValueDefinitionsForBindingInitializer(
        ir,
        layer.valueExprTree,
        parserProducerSourceIndex,
        0,
        initializerRoot,
        definingNode)
    var bindingStatement: texpr.TypedExprIrStatement
    bindingStatement.sourcePath = ctx.sourcePath
    bindingStatement.functionName = scope.name
    bindingStatement.statementIndex = 0
    bindingStatement.lineNumber = 2
    bindingStatement.columnNumber = 5
    bindingStatement.endLineNumber = 2
    bindingStatement.endColumnNumber = 25
    bindingStatement.lexicalScopeId = 0
    bindingStatement.suiteScopeId = -1
    bindingStatement.statementOrdinal = 0
    bindingStatement.lexicalOrdinal = 0
    bindingStatement.deferOwnerStatementOrdinal = -1
    bindingStatement.lineIndent = 4
    bindingStatement.enclosingIfLineNumber = -1
    bindingStatement.kind = texpr.TypedExprIrStmtLocalDecl
    bindingStatement.callKind = texpr.TypedExprCallNone
    bindingStatement.detailKind = parser.NormalizedExprDetailNone
    bindingStatement.surfaceText = "var first: int32 = 1"
    bindingStatement.bindingName = "first"
    bindingStatement.resultType = "int32"
    bindingStatement.valueExprCallNodeIndex = -1
    bindingStatement.originParserNodeId = -1
    bindingStatement.valueExprArgRootStart = -1
    bindingStatement.valueExprArgRootCount = 0
    bindingStatement.valueExprRootNodeIndex = initializerRoot
    bindingStatement.valueExprStatementRole =
        parser.ParserValueExprStatementBindingInitializer
    bindingStatement.callArgNodeStart = -1
    bindingStatement.callArgNodeCount = 0
    bindingStatement.rhsNodeIndex = definingNode
    bindingStatement.rhsBailReason = texpr.RhsBailNone
    bindingStatement.forStartNodeIndex = -1
    bindingStatement.assignLvalueNodeIndex = -1
    bindingStatement.assignIndexNodeIndex = -1
    texpr.TypedExprIrAppendStatement(ir, bindingStatement)
    parameterTypedNode = -1
    localTypedNode = -1
    for parserNodeIndex in 0..<
            parser.ParserValueExprTreeNodeCount(layer.valueExprTree):
        var lexicalScopeRow: int32
        var resolutionKind =
            parser.ParserValueExprBindingResolutionNone
        var declarationRow: int32
        var patternRow: int32
        assert(parser.ParserValueExprNodeBindingResolutionAt(
                   layer.valueExprTree,
                   parserNodeIndex,
                   lexicalScopeRow,
                   resolutionKind,
                   declarationRow,
                   patternRow),
               "typed expr binding: sealed resolution unavailable")
        if resolutionKind ==
               parser.ParserValueExprBindingResolutionParameter:
            parameterTypedNode =
                texpr.TypedExprIrBuildRhsIdentifierFromParser(
                    ir, ctx, scope, 3, parserNodeIndex)
        elif resolutionKind ==
                 parser.ParserValueExprBindingResolutionPattern:
            localTypedNode =
                texpr.TypedExprIrBuildRhsIdentifierFromParser(
                    ir, ctx, scope, 3, parserNodeIndex)
    assert(parameterTypedNode >= 0 && localTypedNode >= 0 &&
           ir.originParserNodeStack.len == 0,
           "typed expr binding: exact Identifier consumers missing")
    parameterOrdinalLookupCount =
        ir.valueExprTransactionParameterOrdinalLookupCount
    assert(parameterOrdinalLookupCount == 24,
           Fmt"typed expr binding: parameter ordinal lookup count drift {parameterOrdinalLookupCount}")
    texpr.TypedExprIrAppendScope(
        ir, 0, -1, parser.NormalizedScopeRoot,
        -1, 0, 1, 1, 3, 24)
    texpr.TypedExprIrAppendFunction(
        ir,
        texpr.TypedExprIrFunction(
            sourcePath: ctx.sourcePath,
            functionName: "Run",
            signatureLineNumber: 1,
            endLineNumber: 3,
            bodyLineNumber: 2,
            returnType: "int32",
            resultExprClass: texpr.TypedExprExprOwned,
            returnExpr: "first + p0 + p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8 + p9 + p10 + p11 + p0 + p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8 + p9 + p10 + p11",
            statementStart: 0,
            statementCount: 1,
            scopeStart: 0,
            scopeCount: 1,
            nodeStart: 0,
            nodeCount: ir.nodes2_nodeIndexs.len,
            returnNodeIndex: localTypedNode,
            valueDefinitionStart: 0,
            valueDefinitionCount:
                texpr.TypedExprValueDefinitionAuthorityCount(ir),
            valueDefinitionGroupStart: groupStart,
            valueDefinitionGroupCount: groupCount))
    texpr.TypedExprClearSourceContextAllFields(ctx)
    for contextIndex in 0..<sourceContexts.len:
        texpr.TypedExprClearSourceContextAllFields(
            sourceContexts[contextIndex])
    texpr.TypedExprIrEndValueExprBorrow(ir)
    assert(texpr.TypedExprIrSealExactTypeArena(ir, exactArena, err),
           Fmt"typed expr binding: TypeArena seal failed {err}")

fn RunPositive() =
    var layer: parser.NormalizedExprLayer
    var ir: texpr.TypedExprIr
    var exactArena: typearena.TypedExprTypeArena
    var parameterTypedNode: int32
    var localTypedNode: int32
    var parameterOrdinalLookupCount: int32
    Build(
        layer,
        ir,
        exactArena,
        parameterTypedNode,
        localTypedNode,
        parameterOrdinalLookupCount)
    var err: str
    assert(texpr.TypedExprIdentifierBindingAuthorityStrictValidateInto(
               ir, err) &&
           texpr.TypedExprIdentifierBindingAuthorityStrictValidateParserTreeInto(
               ir, layer.valueExprTree, 0, err),
           Fmt"typed expr binding: strict validation failed {err}")
    assert(parameterOrdinalLookupCount == 24,
           "typed expr binding: parameter ordinal lookup is not O(refs)")
    assert(texpr.TypedExprIrNodeBindingParserProducerSourceIndexAt(
               ir, parameterTypedNode) > 0 &&
           texpr.TypedExprIrNodeBindingParserNodeIndexAt(
               ir, parameterTypedNode) ==
               arenamod.ArenaArrayInt32Get(
                   ir.arena,
                   ir.nodes2_originParserNodeIds,
                   parameterTypedNode) &&
           texpr.TypedExprIrNodeBindingParserForestNodeIndexAt(
               ir, parameterTypedNode) !=
               arenamod.ArenaArrayInt32Get(
                   ir.arena,
                   ir.nodes2_originParserNodeIds,
                   parameterTypedNode),
           "typed expr binding: multi-source global/local identity collapsed")
    let parameterDefinitionRow =
        texpr.TypedExprIrNodeBindingValueDefinitionRowAt(
            ir, parameterTypedNode)
    let localDefinitionRow =
        texpr.TypedExprIrNodeBindingValueDefinitionRowAt(
            ir, localTypedNode)
    assert(texpr.TypedExprIrNodeBindingParserNodeIndexAt(
               ir, parameterTypedNode) >= 0 &&
           texpr.TypedExprIrNodeBindingDeclarationSourceLocalRowAt(
               ir, parameterTypedNode) >= 0 &&
           texpr.TypedExprIrNodeBindingPatternSourceLocalRowAt(
               ir, parameterTypedNode) == -1 &&
           texpr.TypedExprIrNodeBindingValueDefinitionRowAt(
               ir, parameterTypedNode) >= 0,
           Fmt"typed expr binding: ParamRef sentinel contract drift node={parameterTypedNode} parser={texpr.TypedExprIrNodeBindingParserNodeIndexAt(ir, parameterTypedNode)} declaration={texpr.TypedExprIrNodeBindingDeclarationSourceLocalRowAt(ir, parameterTypedNode)} pattern={texpr.TypedExprIrNodeBindingPatternSourceLocalRowAt(ir, parameterTypedNode)} definition={texpr.TypedExprIrNodeBindingValueDefinitionRowAt(ir, parameterTypedNode)}")
    assert(texpr.TypedExprIrNodeBindingParserNodeIndexAt(
               ir, localTypedNode) >= 0 &&
           texpr.TypedExprIrNodeBindingDeclarationSourceLocalRowAt(
               ir, localTypedNode) >= 0 &&
           texpr.TypedExprIrNodeBindingPatternSourceLocalRowAt(
               ir, localTypedNode) >= 0 &&
           texpr.TypedExprIrNodeBindingValueDefinitionRowAt(
               ir, localTypedNode) >= 0,
           "typed expr binding: LocalRef exact row contract drift")
    var localMutation = texpr.TypedExprIrClone(ir)
    arenamod.ArenaArrayInt32Set(
        localMutation.arena,
        localMutation.nodes2_bindingValueDefinitionRows,
        localTypedNode,
        -1)
    assert(!texpr.TypedExprIdentifierBindingAuthorityStrictValidateInto(
               localMutation, err),
           "typed expr binding: LocalRef definition deletion survived")
    var reverseMutation = texpr.TypedExprIrClone(ir)
    arenamod.ArenaArrayInt32Set(
        reverseMutation.arena,
        reverseMutation.valueDefinitions_groupRows,
        localDefinitionRow,
        -1)
    assert(!texpr.TypedExprIdentifierBindingAuthorityStrictValidateInto(
               reverseMutation, err),
           "typed expr binding: value-definition reverse edge mutation survived")
    var parameterMutation = texpr.TypedExprIrClone(ir)
    arenamod.ArenaArrayInt32Set(
        parameterMutation.arena,
        parameterMutation.nodes2_bindingValueDefinitionRows,
        parameterTypedNode,
        localDefinitionRow)
    assert(!texpr.TypedExprIdentifierBindingAuthorityStrictValidateInto(
               parameterMutation, err),
           "typed expr binding: fabricated parameter definition survived")
    var strippedMutation = texpr.TypedExprIrClone(ir)
    for strippedNode in [parameterTypedNode, localTypedNode]:
        arenamod.ArenaArrayInt32Set(
            strippedMutation.arena,
            strippedMutation.nodes2_bindingParserNodeIndexes,
            strippedNode,
            -1)
        arenamod.ArenaArrayInt32Set(
            strippedMutation.arena,
            strippedMutation.nodes2_bindingParserForestNodeIndexes,
            strippedNode,
            -1)
        arenamod.ArenaArrayInt32Set(
            strippedMutation.arena,
            strippedMutation.nodes2_bindingParserProducerSourceIndexes,
            strippedNode,
            -1)
        arenamod.ArenaArrayInt32Set(
            strippedMutation.arena,
            strippedMutation.nodes2_bindingDeclarationSourceLocalRows,
            strippedNode,
            -1)
        arenamod.ArenaArrayInt32Set(
            strippedMutation.arena,
            strippedMutation.nodes2_bindingPatternSourceLocalRows,
            strippedNode,
            -1)
        arenamod.ArenaArrayInt32Set(
            strippedMutation.arena,
            strippedMutation.nodes2_bindingValueDefinitionRows,
            strippedNode,
            -1)
    assert(!texpr.TypedExprIdentifierBindingAuthorityStrictValidateInto(
               strippedMutation, err),
           "typed expr binding: source-backed reference identity stripping survived")
    var nonReferenceTypedNode: int32 = -1
    for nodeIndex in 0..<ir.nodes2_nodeIndexs.len:
        if ir.nodes2_opKinds[nodeIndex] !=
               texpr.TypedExprIrOpParamRef &&
           ir.nodes2_opKinds[nodeIndex] !=
               texpr.TypedExprIrOpLocalRef:
            nonReferenceTypedNode = nodeIndex
            break
    assert(nonReferenceTypedNode >= 0,
           "typed expr binding: non-reference mutation target missing")
    var nonReferenceMutation = texpr.TypedExprIrClone(ir)
    arenamod.ArenaArrayInt32Set(
        nonReferenceMutation.arena,
        nonReferenceMutation.nodes2_bindingParserNodeIndexes,
        nonReferenceTypedNode,
        texpr.TypedExprIrNodeBindingParserNodeIndexAt(
            ir, localTypedNode))
    arenamod.ArenaArrayInt32Set(
        nonReferenceMutation.arena,
        nonReferenceMutation.nodes2_bindingParserForestNodeIndexes,
        nonReferenceTypedNode,
        texpr.TypedExprIrNodeBindingParserForestNodeIndexAt(
            ir, localTypedNode))
    arenamod.ArenaArrayInt32Set(
        nonReferenceMutation.arena,
        nonReferenceMutation.nodes2_bindingParserProducerSourceIndexes,
        nonReferenceTypedNode,
        texpr.TypedExprIrNodeBindingParserProducerSourceIndexAt(
            ir, localTypedNode))
    arenamod.ArenaArrayInt32Set(
        nonReferenceMutation.arena,
        nonReferenceMutation.nodes2_bindingDeclarationSourceLocalRows,
        nonReferenceTypedNode,
        texpr.TypedExprIrNodeBindingDeclarationSourceLocalRowAt(
            ir, localTypedNode))
    arenamod.ArenaArrayInt32Set(
        nonReferenceMutation.arena,
        nonReferenceMutation.nodes2_bindingPatternSourceLocalRows,
        nonReferenceTypedNode,
        texpr.TypedExprIrNodeBindingPatternSourceLocalRowAt(
            ir, localTypedNode))
    arenamod.ArenaArrayInt32Set(
        nonReferenceMutation.arena,
        nonReferenceMutation.nodes2_bindingValueDefinitionRows,
        nonReferenceTypedNode,
        texpr.TypedExprIrNodeBindingValueDefinitionRowAt(
            ir, localTypedNode))
    assert(!texpr.TypedExprIdentifierBindingAuthorityStrictValidateInto(
               nonReferenceMutation, err),
           "typed expr binding: non-reference fabricated identity survived")
    var parserMutation = texpr.TypedExprIrClone(ir)
    arenamod.ArenaArrayInt32Set(
        parserMutation.arena,
        parserMutation.nodes2_bindingDeclarationSourceLocalRows,
        parameterTypedNode,
        texpr.TypedExprIrNodeBindingDeclarationSourceLocalRowAt(
            parserMutation, parameterTypedNode) + 1)
    assert(!texpr.TypedExprIdentifierBindingAuthorityStrictValidateParserTreeInto(
               parserMutation,
               layer.valueExprTree,
               0,
               err),
           "typed expr binding: parameter declaration mutation survived")
    var parserNodeMutation = texpr.TypedExprIrClone(ir)
    arenamod.ArenaArrayInt32Set(
        parserNodeMutation.arena,
        parserNodeMutation.nodes2_bindingParserNodeIndexes,
        parameterTypedNode,
        texpr.TypedExprIrNodeBindingParserNodeIndexAt(
            parserNodeMutation, parameterTypedNode) + 1)
    assert(!texpr.TypedExprIdentifierBindingAuthorityStrictValidateParserTreeInto(
               parserNodeMutation,
               layer.valueExprTree,
               0,
               err),
           "typed expr binding: global parser-node mutation survived")
    var moved: texpr.TypedExprIr
    var moveSource = texpr.TypedExprIrClone(ir)
    assert(texpr.TypedExprIrNodeBindingParserNodeIndexAt(
               moveSource, parameterTypedNode) ==
               texpr.TypedExprIrNodeBindingParserNodeIndexAt(
                   ir, parameterTypedNode) &&
           texpr.TypedExprIrNodeBindingParserProducerSourceIndexAt(
               moveSource, parameterTypedNode) ==
               texpr.TypedExprIrNodeBindingParserProducerSourceIndexAt(
                   ir, parameterTypedNode) &&
           texpr.TypedExprIrNodeBindingDeclarationSourceLocalRowAt(
               moveSource, parameterTypedNode) ==
               texpr.TypedExprIrNodeBindingDeclarationSourceLocalRowAt(
                   ir, parameterTypedNode) &&
           texpr.TypedExprIrNodeBindingPatternSourceLocalRowAt(
               moveSource, localTypedNode) ==
               texpr.TypedExprIrNodeBindingPatternSourceLocalRowAt(
                   ir, localTypedNode) &&
           texpr.TypedExprIrNodeBindingValueDefinitionRowAt(
               moveSource, localTypedNode) ==
               texpr.TypedExprIrNodeBindingValueDefinitionRowAt(
                   ir, localTypedNode) &&
           arenamod.ArenaArrayInt32Get(
               moveSource.arena,
               moveSource.valueDefinitions_groupRows,
               localDefinitionRow) == 0,
           "typed expr binding: clone columns drift")
    texpr.TypedExprIrMoveInto(moved, moveSource)
    assert(texpr.TypedExprIdentifierBindingAuthorityStrictValidateInto(
               moved, err) &&
           texpr.TypedExprIrNodeBindingParserNodeIndexAt(
               moved, parameterTypedNode) ==
               texpr.TypedExprIrNodeBindingParserNodeIndexAt(
                   ir, parameterTypedNode) &&
           texpr.TypedExprIrNodeBindingParserProducerSourceIndexAt(
               moved, parameterTypedNode) ==
               texpr.TypedExprIrNodeBindingParserProducerSourceIndexAt(
                   ir, parameterTypedNode) &&
           texpr.TypedExprIrNodeBindingDeclarationSourceLocalRowAt(
               moved, parameterTypedNode) ==
               texpr.TypedExprIrNodeBindingDeclarationSourceLocalRowAt(
                   ir, parameterTypedNode) &&
           texpr.TypedExprIrNodeBindingPatternSourceLocalRowAt(
               moved, localTypedNode) ==
               texpr.TypedExprIrNodeBindingPatternSourceLocalRowAt(
                   ir, localTypedNode) &&
           texpr.TypedExprIrNodeBindingValueDefinitionRowAt(
               moved, localTypedNode) ==
               texpr.TypedExprIrNodeBindingValueDefinitionRowAt(
                   ir, localTypedNode) &&
           moveSource.nodes2_bindingParserNodeIndexes.len == 0 &&
           moveSource.nodes2_bindingParserProducerSourceIndexes.len == 0 &&
           moveSource.nodes2_bindingDeclarationSourceLocalRows.len == 0 &&
           moveSource.nodes2_bindingPatternSourceLocalRows.len == 0 &&
           moveSource.nodes2_bindingValueDefinitionRows.len == 0 &&
           moveSource.valueDefinitions_groupRows.len == 0 &&
           arenamod.ArenaArrayInt32Len(
               moved.arena,
               moved.valueExprTransactionDefinitionGroupRowsByPatternRow) ==
               0,
           Fmt"typed expr binding: clone/move drift {err} parser={moveSource.nodes2_bindingParserNodeIndexes.len} producer={moveSource.nodes2_bindingParserProducerSourceIndexes.len} declaration={moveSource.nodes2_bindingDeclarationSourceLocalRows.len} pattern={moveSource.nodes2_bindingPatternSourceLocalRows.len} binding={moveSource.nodes2_bindingValueDefinitionRows.len} groups={moveSource.valueDefinitions_groupRows.len} transaction={arenamod.ArenaArrayInt32Len(moved.arena, moved.valueExprTransactionDefinitionGroupRowsByPatternRow)}")
    let fragment =
        fragcodec.TypedExprIrFunctionFragmentExtract(ir, 0)
    fragcodec.TypedExprIrFunctionFragmentRoundTripAssert(fragment)
    assert(fragment.nodes.bindingParserProducerSourceIndexes[
               parameterTypedNode] ==
               texpr.TypedExprIrNodeBindingParserProducerSourceIndexAt(
                   ir, parameterTypedNode) &&
           fragment.nodes.originParserNodeIds[
               parameterTypedNode] ==
               arenamod.ArenaArrayInt32Get(
                   ir.arena,
                   ir.nodes2_originParserNodeIds,
                   parameterTypedNode) &&
           fragment.nodes.bindingDeclarationSourceLocalRows[
               parameterTypedNode] ==
               texpr.TypedExprIrNodeBindingDeclarationSourceLocalRowAt(
                   ir, parameterTypedNode) &&
           fragment.nodes.bindingPatternSourceLocalRows[
               localTypedNode] ==
               texpr.TypedExprIrNodeBindingPatternSourceLocalRowAt(
                   ir, localTypedNode) &&
           fragment.nodes.bindingValueDefinitionRows[
               localTypedNode] == localDefinitionRow &&
           fragment.nodes.bindingValueDefinitionRows[
               parameterTypedNode] ==
               parameterDefinitionRow &&
           fragment.valueDefinitions.groupRows[localDefinitionRow] == 0,
           "typed expr binding: fragment row drift")
    echo("typed_expr_identifier_binding_exact_rows=1")
    echo("typed_expr_identifier_binding_mutation_rejected=1")
    echo("typed_expr_identifier_binding_clone_move_fragment=1")
    echo("typed_expr_identifier_binding_identity_smoke: ok")
    texpr.TypedExprIrReleasePayload(moved)
    texpr.TypedExprIrReleasePayload(nonReferenceMutation)
    texpr.TypedExprIrReleasePayload(strippedMutation)
    texpr.TypedExprIrReleasePayload(parserNodeMutation)
    texpr.TypedExprIrReleasePayload(parserMutation)
    texpr.TypedExprIrReleasePayload(parameterMutation)
    texpr.TypedExprIrReleasePayload(reverseMutation)
    texpr.TypedExprIrReleasePayload(localMutation)
    texpr.TypedExprIrReleasePayload(ir)
    assert(ir.nodes2_bindingParserNodeIndexes.len == 0 &&
           ir.nodes2_bindingParserProducerSourceIndexes.len == 0 &&
           ir.nodes2_bindingDeclarationSourceLocalRows.len == 0 &&
           ir.nodes2_bindingPatternSourceLocalRows.len == 0 &&
           ir.nodes2_bindingValueDefinitionRows.len == 0,
           "typed expr binding: release columns retained")
    typearena.TypedExprTypeArenaRelease(exactArena)
    parser.NormalizedExprLayerReset(layer)

fn AttackFragmentMutation() =
    var layer: parser.NormalizedExprLayer
    var ir: texpr.TypedExprIr
    var exactArena: typearena.TypedExprTypeArena
    var parameterTypedNode: int32
    var localTypedNode: int32
    var parameterOrdinalLookupCount: int32
    Build(
        layer,
        ir,
        exactArena,
        parameterTypedNode,
        localTypedNode,
        parameterOrdinalLookupCount)
    var fragment =
        fragcodec.TypedExprIrFunctionFragmentExtract(ir, 0)
    fragment.nodes.bindingValueDefinitionRows[localTypedNode] = -1
    fragcodec.TypedExprIrFunctionFragmentValidate(fragment)
    panic("typed expr binding: fragment mutation survived")

fn AttackFragmentStripAll() =
    var layer: parser.NormalizedExprLayer
    var ir: texpr.TypedExprIr
    var exactArena: typearena.TypedExprTypeArena
    var parameterTypedNode: int32
    var localTypedNode: int32
    var parameterOrdinalLookupCount: int32
    Build(
        layer,
        ir,
        exactArena,
        parameterTypedNode,
        localTypedNode,
        parameterOrdinalLookupCount)
    var fragment =
        fragcodec.TypedExprIrFunctionFragmentExtract(ir, 0)
    fragment.nodes.bindingParserProducerSourceIndexes[
        parameterTypedNode] = -1
    fragment.nodes.bindingDeclarationSourceLocalRows[
        parameterTypedNode] = -1
    fragment.nodes.bindingPatternSourceLocalRows[
        parameterTypedNode] = -1
    fragment.nodes.bindingValueDefinitionRows[
        parameterTypedNode] = -1
    fragcodec.TypedExprIrFunctionFragmentValidate(fragment)
    panic("typed expr binding: fragment strip-all survived")

fn AttackFragmentNonReferenceForge() =
    var layer: parser.NormalizedExprLayer
    var ir: texpr.TypedExprIr
    var exactArena: typearena.TypedExprTypeArena
    var parameterTypedNode: int32
    var localTypedNode: int32
    var parameterOrdinalLookupCount: int32
    Build(
        layer,
        ir,
        exactArena,
        parameterTypedNode,
        localTypedNode,
        parameterOrdinalLookupCount)
    var fragment =
        fragcodec.TypedExprIrFunctionFragmentExtract(ir, 0)
    var nonReferenceTypedNode: int32 = -1
    for nodeIndex in 0..<fragment.nodes.nodeIndexs.len:
        if fragment.nodes.opKinds[nodeIndex] !=
               int32(texpr.TypedExprIrOpParamRef) &&
           fragment.nodes.opKinds[nodeIndex] !=
               int32(texpr.TypedExprIrOpLocalRef):
            nonReferenceTypedNode = nodeIndex
            break
    assert(nonReferenceTypedNode >= 0,
           "typed expr binding: fragment non-reference target missing")
    fragment.nodes.bindingParserProducerSourceIndexes[
        nonReferenceTypedNode] =
        fragment.nodes.bindingParserProducerSourceIndexes[localTypedNode]
    fragment.nodes.bindingDeclarationSourceLocalRows[
        nonReferenceTypedNode] =
        fragment.nodes.bindingDeclarationSourceLocalRows[localTypedNode]
    fragment.nodes.bindingPatternSourceLocalRows[
        nonReferenceTypedNode] =
        fragment.nodes.bindingPatternSourceLocalRows[localTypedNode]
    fragment.nodes.bindingValueDefinitionRows[
        nonReferenceTypedNode] =
        fragment.nodes.bindingValueDefinitionRows[localTypedNode]
    fragcodec.TypedExprIrFunctionFragmentValidate(fragment)
    panic("typed expr binding: fragment non-reference forge survived")

fn main() =
    let attack = cmdline.ReadFlagOrDefault("--attack", "")
    if attack == "fragment":
        AttackFragmentMutation()
        return
    if attack == "fragment-strip":
        AttackFragmentStripAll()
        return
    if attack == "fragment-nonref":
        AttackFragmentNonReferenceForge()
        return
    RunPositive()
