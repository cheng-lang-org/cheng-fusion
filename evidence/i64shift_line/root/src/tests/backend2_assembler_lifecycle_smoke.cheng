import std/cmdline
import cheng/core/backend2/backend2_assembler_lifecycle as b2life
import cheng/std/bytes_layout as layout

fn AssemblerLifecycleFinalize(
        state: var b2life.Backend2AssemblerTempLifecycle,
        outcome: int32):
        b2life.Backend2AssemblerTempReleaseReceipt =
    var receipt: b2life.Backend2AssemblerTempReleaseReceipt
    var err: str
    assert(
        b2life.Backend2AssemblerTempLifecycleFinalizeStrictInto(
            state, outcome, receipt, err),
        err)
    assert(receipt.allocated == receipt.released &&
           receipt.live == int64(0) &&
           receipt.allocatedBytes == receipt.releasedBytes &&
           receipt.liveBytes == int64(0) &&
           receipt.rowStorageReleased &&
           receipt.aggregateStorageReleased &&
           receipt.allSymbolStorageReleased &&
           receipt.workerStorageReleased &&
           receipt.workerEndpointsClosedAndReaped &&
           receipt.ledgerStorageReleased &&
           receipt.ledgerStorageReleasedBufferCount > 0 &&
           receipt.ledgerStorageReleasedBytes > int64(0),
           "backend2 assembler lifecycle: terminal receipt mismatch")
    return receipt

fn AssemblerLifecycleSuccessCycle(cycle: int32) =
    var state: b2life.Backend2AssemblerTempLifecycle
    b2life.Backend2AssemblerTempLifecycleBeginInvocation(state)
    b2life.Backend2AssemblerLifecycleAppendAllSymbolName(
        state, Fmt"_function_{cycle}")
    b2life.Backend2AssemblerLifecycleAppendAllSymbolName(
        state, Fmt"_callee_{cycle}")
    b2life.Backend2AssemblerLifecycleAppendWorkerEndpoint(
        state, cycle + 1, cycle + 100)
    b2life.Backend2AssemblerLifecycleAppendWorkerEndpoint(
        state, cycle + 2001, cycle + 2100)
    b2life.Backend2AssemblerLifecycleBindWorkerArrays(state)
    b2life.Backend2AssemblerLifecycleMoveWorkerArraysToReceiver(
        state)
    b2life.Backend2AssemblerLifecycleReleaseWorkerArrays(
        state, true)
    b2life.Backend2AssemblerLifecycleMoveAllSymbolsToAssembler(
        state)
    let receipt = AssemblerLifecycleFinalize(
        state, b2life.Backend2AssemblerTempOutcomeSuccess)
    assert(receipt.completedFunctionCount == 0 &&
           receipt.failedFunctionCount == 0 &&
           receipt.ownerTransferCount > int64(0) &&
           receipt.releasedPhysicalBufferCount > 0 &&
           receipt.releasedPhysicalBytes > int64(0) &&
           receipt.releasedManagedStringValueCount == 2 &&
           receipt.releasedManagedStringBytes > int64(0) &&
           !layout.FixedBytes32Equal(
               receipt.allSymbolOwnerToken,
               layout.FixedBytes32()) &&
           !layout.FixedBytes32Equal(
               receipt.workerOwnerToken,
               layout.FixedBytes32()),
           "backend2 assembler lifecycle: success receipt mismatch")

fn AssemblerLifecycleFailureCycle(cycle: int32) =
    var state: b2life.Backend2AssemblerTempLifecycle
    b2life.Backend2AssemblerTempLifecycleBeginInvocation(state)
    b2life.Backend2AssemblerLifecycleAppendAllSymbolName(
        state, Fmt"_failure_{cycle}")
    b2life.Backend2AssemblerLifecycleAppendWorkerEndpoint(
        state, cycle + 1, cycle + 10)
    b2life.Backend2AssemblerLifecycleBindWorkerArrays(state)
    b2life.Backend2AssemblerLifecycleReleaseWorkerArrays(
        state, true)
    let receipt = AssemblerLifecycleFinalize(
        state, b2life.Backend2AssemblerTempOutcomeFailure)
    assert(receipt.ownerTransferCount == int64(0) &&
           receipt.releasedManagedStringValueCount == 1 &&
           !layout.FixedBytes32Equal(
               receipt.allSymbolOwnerToken,
               layout.FixedBytes32()) &&
           !layout.FixedBytes32Equal(
               receipt.workerOwnerToken,
               layout.FixedBytes32()),
           "backend2 assembler lifecycle: failure receipt mismatch")

fn AssemblerLifecycleIdentityMutation() =
    var state: b2life.Backend2AssemblerTempLifecycle
    b2life.Backend2AssemblerTempLifecycleBeginInvocation(state)
    b2life.Backend2AssemblerLifecycleAppendAllSymbolName(
        state, "_before")
    b2life.Backend2AssemblerLifecycleMoveAllSymbolsToAssembler(
        state)
    state.allSymbolNames[0] = "_after"
    let _receipt = AssemblerLifecycleFinalize(
        state, b2life.Backend2AssemblerTempOutcomeFailure)

fn main(argc: int32, argv: ptr): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    if cmdline.ParamCount() == 2 &&
       cmdline.ParamStr(1) == "--identity-mutation":
        AssemblerLifecycleIdentityMutation()
        return 0
    for cycle in 0..<1000:
        AssemblerLifecycleSuccessCycle(cycle)
        AssemblerLifecycleFailureCycle(cycle)
    echo("BACKEND2_ASSEMBLER_LIFECYCLE_OK success=1000 failure=1000 ledger_live=0 ledger_live_bytes=0")
    return 0
