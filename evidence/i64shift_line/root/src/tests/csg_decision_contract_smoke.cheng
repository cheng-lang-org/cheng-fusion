# CSG 统一决策合同冒烟 (任务 04 首切片)。
#
# 正例 + 反例逐条运行: 每个反例断言被显式拒绝且错误串可区分 (整串精确
# 匹配, 判词唯一)。合同: docs/campaigns/2026-09-21-csg-decision-computer-use/
# contract.md §1/§3。校验权威: src/inference/decision_validate.cheng。

import std/strings
import std/strutils as strutil
import std/result
import cheng/core/runtime/csg_decision_contract as dc
import cheng/inference/decision_validate as dv

fn smokeEmptyI32(): int32[] =
    var r: int32[]
    return r

fn smokeProb(numer: int32, precision: int32): dc.CsgDecisionProbValue =
    var p: dc.CsgDecisionProbValue
    p.numer = int64(numer)
    p.precision = precision
    return p

# 桥接: 从 Result 提取 (ok, err 串) 后走非泛型断言, 单处消费, 无泛型。
fn smokeCheckOk(label: str, okFlag: bool, got: str) =
    if !okFlag:
        echo(strutil.Join([
            "smoke FAIL expect-ok ",
            strings.CloneStr(label),
            " err=",
            strings.CloneStr(got)
        ], ""))
        assert(false, "smoke expect-ok failed")
        return
    echo(strutil.Join(["smoke ok: ", strings.CloneStr(label)], ""))

fn smokeCheckErr(label: str, expected: str, okFlag: bool, got: str) =
    if okFlag:
        echo("smoke FAIL expect-err: unexpected success")
        assert(false, "smoke expected rejection")
        return
    if got != expected:
        echo(strutil.Join([
            "smoke FAIL err-mismatch ",
            strings.CloneStr(label),
            " expected=",
            strings.CloneStr(expected),
            " got=",
            strings.CloneStr(got)
        ], ""))
        assert(false, "smoke err mismatch")
        return
    echo(strutil.Join([
        "smoke reject ok: ",
        strings.CloneStr(label),
        " -> ",
        strings.CloneStr(got)
    ], ""))

# 构造一张全绿图。槽位顺序 (索引即身份):
# 0 goal, 1 predicate, 2 actionModel, 3/4 param, 5 precondition,
# 6 effectContract, 7 evidence, 8 snapshot, 9 receipt, 10 backend,
# 11 budget, 12 authorization, 13 commitAuthority。
# 节点: observe[0], deterministic[0], learns[0]=Choice/[1]=Noul/[2]=Score,
# candidates[0..1] (同一目标), actions[0], executes[0], receipts[0],
# learnResults[0..2], facts[0], failures[0] (UnknownOutcome)。
fn smokeBuildValidGraph(): dc.CsgDecisionGraph =
    let session: int64 = 9001
    let generation: int64 = 7
    var g = dc.CsgDecisionGraphNew(session, generation)
    let goalSlot = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindGoal)
    let predicateSlot = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindPredicate)
    let actionModelSlot = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindActionModel)
    let paramSlot1 = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindParam)
    let paramSlot2 = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindParam)
    let preconditionSlot = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindPrecondition)
    let effectSlot = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindEffectContract)
    let evidenceSlot = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindEvidence)
    let snapshotSlot = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindSnapshot)
    let receiptSlot = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindReceipt)
    let backendSlot = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindBackend)
    let budgetSlot = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindBudget)
    let authSlot = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindAuthorization)
    let commitSlot = dc.CsgDecisionSlotAdd(g, dc.CsgDecisionSlotKindCommitAuthority)

    var obs: dc.CsgDecisionObserveNode
    obs.snapshotRef = snapshotSlot
    obs.generation = generation
    obs.sourceReceiptRef = receiptSlot
    obs.evidenceRef = evidenceSlot
    dc.CsgDecisionObserveAdd(g, obs)

    var det: dc.CsgDecisionDeterministicNode
    det.predicateRef = predicateSlot
    det.actionModelRef = actionModelSlot
    det.budgetRef = budgetSlot
    det.evidenceRef = evidenceSlot
    det.generation = generation
    dc.CsgDecisionDeterministicAdd(g, det)

    var ln0: dc.CsgDecisionLearnNode
    ln0.headKind = dc.CsgDecisionHeadChoice
    ln0.candidateSetRef = 0
    ln0.candidateCount = 2
    ln0.evidenceRef = evidenceSlot
    ln0.backendRef = backendSlot
    ln0.generation = generation
    dc.CsgDecisionLearnAdd(g, ln0)

    var ln1: dc.CsgDecisionLearnNode
    ln1.headKind = dc.CsgDecisionHeadNoul
    ln1.candidateSetRef = 0
    ln1.candidateCount = 0
    ln1.evidenceRef = evidenceSlot
    ln1.backendRef = backendSlot
    ln1.generation = generation
    dc.CsgDecisionLearnAdd(g, ln1)

    var ln2: dc.CsgDecisionLearnNode
    ln2.headKind = dc.CsgDecisionHeadScore
    ln2.candidateSetRef = 0
    ln2.candidateCount = 2
    ln2.evidenceRef = evidenceSlot
    ln2.backendRef = backendSlot
    ln2.generation = generation
    dc.CsgDecisionLearnAdd(g, ln2)

    var paramsA: int32[]
    add(paramsA, paramSlot1)
    add(paramsA, paramSlot2)
    var candA: dc.CsgDecisionCandidate
    candA.goalRef = goalSlot
    candA.operationRef = actionModelSlot
    candA.paramSlots = paramsA
    candA.preconditionRef = preconditionSlot
    candA.effectContractRef = effectSlot
    candA.generation = generation
    dc.CsgDecisionCandidateAdd(g, candA)

    var paramsB: int32[]
    add(paramsB, paramSlot1)
    add(paramsB, paramSlot2)
    var candB: dc.CsgDecisionCandidate
    candB.goalRef = goalSlot
    candB.operationRef = actionModelSlot
    candB.paramSlots = paramsB
    candB.preconditionRef = preconditionSlot
    candB.effectContractRef = effectSlot
    candB.generation = generation
    dc.CsgDecisionCandidateAdd(g, candB)

    var act: dc.CsgDecisionActionNode
    act.candidateRef = 0
    act.authorizationRef = authSlot
    act.preconditionRef = preconditionSlot
    act.generation = generation
    dc.CsgDecisionActionAdd(g, act)

    var exe: dc.CsgDecisionExecuteNode
    exe.actionRef = 0
    exe.commitAuthorityRef = commitSlot
    exe.generation = generation
    dc.CsgDecisionExecuteAdd(g, exe)

    var rec: dc.CsgDecisionReceiptNode
    rec.executionRef = 0
    rec.goalPredicateRef = predicateSlot
    rec.generation = generation
    dc.CsgDecisionReceiptAdd(g, rec)

    var choiceProbs: dc.CsgDecisionProbValue[]
    add(choiceProbs, smokeProb(60, 2))
    add(choiceProbs, smokeProb(40, 2))
    var res0: dc.CsgDecisionLearnResult
    res0.learnRef = 0
    res0.generation = generation
    res0.headKind = dc.CsgDecisionHeadChoice
    res0.noMatch = false
    res0.boundGoalRef = goalSlot
    res0.chosenCandidate = 0
    res0.probs = choiceProbs
    res0.ranks = smokeEmptyI32()
    res0.weighted = smokeProb(0, 2)
    dc.CsgDecisionLearnResultAdd(g, res0)

    var noulProbs: dc.CsgDecisionProbValue[]
    add(noulProbs, smokeProb(70, 2))
    var res1: dc.CsgDecisionLearnResult
    res1.learnRef = 1
    res1.generation = generation
    res1.headKind = dc.CsgDecisionHeadNoul
    res1.noMatch = false
    res1.boundGoalRef = goalSlot
    res1.chosenCandidate = dc.CsgDecisionChosenNone
    res1.probs = noulProbs
    res1.ranks = smokeEmptyI32()
    res1.weighted = smokeProb(0, 2)
    dc.CsgDecisionLearnResultAdd(g, res1)

    var scoreProbs: dc.CsgDecisionProbValue[]
    add(scoreProbs, smokeProb(50, 2))
    add(scoreProbs, smokeProb(50, 2))
    var scoreRanks: int32[]
    add(scoreRanks, 1)
    add(scoreRanks, 0)
    var res2: dc.CsgDecisionLearnResult
    res2.learnRef = 2
    res2.generation = generation
    res2.headKind = dc.CsgDecisionHeadScore
    res2.noMatch = false
    res2.boundGoalRef = goalSlot
    res2.chosenCandidate = dc.CsgDecisionChosenNone
    res2.probs = scoreProbs
    res2.ranks = scoreRanks
    res2.weighted = smokeProb(50, 2)
    dc.CsgDecisionLearnResultAdd(g, res2)

    var fact: dc.CsgDecisionFactValue
    fact.slotRef = snapshotSlot
    fact.slotKind = dc.CsgDecisionSlotKindSnapshot
    fact.generation = generation
    fact.unitCode = 1
    fact.raw = 42
    dc.CsgDecisionFactAdd(g, fact)

    let failRes = dc.CsgDecisionFailureNew(dc.CsgDecisionErrUnknownOutcome, "execute outcome unverified")
    let failOk = IsOk(failRes)
    assert(failOk, "smoke: failure new expected ok")
    let fail = Value(failRes)
    dc.CsgDecisionGraphRecordFailure(g, fail)

    return g

fn main(): int32 =
    let session: int64 = 9001
    let gen7: int64 = 7
    let gen8: int64 = 8

    # ---- 概率合同正例 ----
    let n60: int64 = 60
    let pfix = dc.CsgDecisionProbFromFixed(n60, 2)
    let pfixOk = IsOk(pfix)
    let pfixMsg = Error(pfix)
    smokeCheckOk("prob-fixed-60-p2", pfixOk, pfixMsg)
    let quarter: float64 = 0.25
    let pf = dv.DecisionProbFromFloat64(quarter, 2)
    if IsErr(pf):
        echo("smoke FAIL prob-from-float expected ok")
        assert(false, "smoke expected ok")
    let pv = Value(pf)
    assert(pv.numer == 25, "smoke: 0.25 at precision 2 must be 25")
    echo("smoke ok: prob-from-float-0.25 -> 25")

    # ---- 全图正例 ----
    let g = smokeBuildValidGraph()
    let gv = dv.DecisionValidateGraph(share(g))
    let gvOk = IsOk(gv)
    let gvMsg = Error(gv)
    smokeCheckOk("graph-valid", gvOk, gvMsg)
    var goalRef: dc.CsgDecisionRef
    goalRef.session = session
    goalRef.generation = gen7
    goalRef.index = 0
    goalRef.kind = dc.CsgDecisionSlotKindGoal
    let gr = dv.DecisionValidateRef(share(g), goalRef)
    let grOk = IsOk(gr)
    let grMsg = Error(gr)
    smokeCheckOk("ref-goal-slot", grOk, grMsg)
    var learnRef: dc.CsgDecisionRef
    learnRef.session = session
    learnRef.generation = gen7
    learnRef.index = 0
    learnRef.kind = dc.CsgDecisionRefKindLearn
    let lr = dv.DecisionValidateRef(share(g), learnRef)
    let lrOk = IsOk(lr)
    let lrMsg = Error(lr)
    smokeCheckOk("ref-learn-node", lrOk, lrMsg)
    let gc = dv.DecisionValidateCandidateAt(share(g), 0)
    let gcOk = IsOk(gc)
    let gcMsg = Error(gc)
    smokeCheckOk("candidate-0", gcOk, gcMsg)
    let gl0 = dv.DecisionValidateLearnResultAt(share(g), 0)
    let gl0Ok = IsOk(gl0)
    let gl0Msg = Error(gl0)
    smokeCheckOk("learn-result-choice", gl0Ok, gl0Msg)
    let gl1 = dv.DecisionValidateLearnResultAt(share(g), 1)
    let gl1Ok = IsOk(gl1)
    let gl1Msg = Error(gl1)
    smokeCheckOk("learn-result-noul", gl1Ok, gl1Msg)
    let gl2 = dv.DecisionValidateLearnResultAt(share(g), 2)
    let gl2Ok = IsOk(gl2)
    let gl2Msg = Error(gl2)
    smokeCheckOk("learn-result-score", gl2Ok, gl2Msg)

    # ---- 失败族合同 ----
    assert(dc.CsgDecisionFailureKindIsKnown(dc.CsgDecisionErrCancelled), "smoke: Cancelled must be known")
    let n101: int64 = 101
    let n5: int64 = 5

    # ---- 反例: NaN / 负数 / 超 1.0 / 定点越界 / 精度越界 ----
    # NaN 由 0.0/0.0 运行时构造 (位型绑定 f64ToBits/bitsToF64 在本后端
    # 实测不可靠, 不用于判定)。
    let zero: float64 = 0.0
    let nanVal: float64 = zero / zero
    let rNaN = dv.DecisionProbFromFloat64(nanVal, 2)
    let rNaNOk = IsOk(rNaN)
    let rNaNMsg = Error(rNaN)
    smokeCheckErr("prob-nan", "InvalidOutput: decision prob NaN", rNaNOk, rNaNMsg)
    let negVal: float64 = -0.5
    let rNeg = dv.DecisionProbFromFloat64(negVal, 2)
    let rNegOk = IsOk(rNeg)
    let rNegMsg = Error(rNeg)
    smokeCheckErr("prob-negative", "InvalidOutput: decision prob negative", rNegOk, rNegMsg)
    let bigVal: float64 = 1.5
    let rBig = dv.DecisionProbFromFloat64(bigVal, 2)
    let rBigOk = IsOk(rBig)
    let rBigMsg = Error(rBig)
    smokeCheckErr("prob-exceeds-one", "InvalidOutput: decision prob float out of range", rBigOk, rBigMsg)
    let rOor = dc.CsgDecisionProbFromFixed(n101, 2)
    let rOorOk = IsOk(rOor)
    let rOorMsg = Error(rOor)
    smokeCheckErr("prob-fixed-out-of-range", "InvalidOutput: decision prob numer out of range", rOorOk, rOorMsg)
    let rPre = dc.CsgDecisionProbFromFixed(n5, 0)
    let rPreOk = IsOk(rPre)
    let rPreMsg = Error(rPre)
    smokeCheckErr("prob-precision-out-of-range", "InvalidOutput: decision prob precision out of range", rPreOk, rPreMsg)

    # ---- 反例: 分布不归一 ----
    var gNN = smokeBuildValidGraph()
    var nnProbs: dc.CsgDecisionProbValue[]
    add(nnProbs, smokeProb(50, 2))
    add(nnProbs, smokeProb(40, 2))
    var nnRes: dc.CsgDecisionLearnResult
    nnRes.learnRef = 0
    nnRes.generation = gen7
    nnRes.headKind = dc.CsgDecisionHeadChoice
    nnRes.noMatch = false
    nnRes.boundGoalRef = 0
    nnRes.chosenCandidate = 0
    nnRes.probs = nnProbs
    nnRes.ranks = smokeEmptyI32()
    nnRes.weighted = smokeProb(0, 2)
    dc.CsgDecisionLearnResultAdd(gNN, nnRes)
    let rNN = dv.DecisionValidateLearnResultAt(share(gNN), 3)
    let rNNOk = IsOk(rNN)
    let rNNMsg = Error(rNN)
    smokeCheckErr("distribution-not-normalized", "InvalidOutput: decision prob distribution not normalized", rNNOk, rNNMsg)

    # ---- 反例: 分布长度与候选集不符 ----
    var gSize = smokeBuildValidGraph()
    var sizeProbs: dc.CsgDecisionProbValue[]
    add(sizeProbs, smokeProb(100, 2))
    var sizeRes: dc.CsgDecisionLearnResult
    sizeRes.learnRef = 0
    sizeRes.generation = gen7
    sizeRes.headKind = dc.CsgDecisionHeadChoice
    sizeRes.noMatch = false
    sizeRes.boundGoalRef = 0
    sizeRes.chosenCandidate = 0
    sizeRes.probs = sizeProbs
    sizeRes.ranks = smokeEmptyI32()
    sizeRes.weighted = smokeProb(0, 2)
    dc.CsgDecisionLearnResultAdd(gSize, sizeRes)
    let rSize = dv.DecisionValidateLearnResultAt(share(gSize), 3)
    let rSizeOk = IsOk(rSize)
    let rSizeMsg = Error(rSize)
    smokeCheckErr("distribution-size-mismatch", "InvalidOutput: decision prob distribution size mismatch", rSizeOk, rSizeMsg)

    # ---- 反例: chosen 候选越界 ----
    var gChosen = smokeBuildValidGraph()
    var chProbs: dc.CsgDecisionProbValue[]
    add(chProbs, smokeProb(60, 2))
    add(chProbs, smokeProb(40, 2))
    var chRes: dc.CsgDecisionLearnResult
    chRes.learnRef = 0
    chRes.generation = gen7
    chRes.headKind = dc.CsgDecisionHeadChoice
    chRes.noMatch = false
    chRes.boundGoalRef = 0
    chRes.chosenCandidate = 5
    chRes.probs = chProbs
    chRes.ranks = smokeEmptyI32()
    chRes.weighted = smokeProb(0, 2)
    dc.CsgDecisionLearnResultAdd(gChosen, chRes)
    let rCh = dv.DecisionValidateLearnResultAt(share(gChosen), 3)
    let rChOk = IsOk(rCh)
    let rChMsg = Error(rCh)
    smokeCheckErr("chosen-out-of-range", "InvalidOutput: decision learn result chosen candidate out of range", rChOk, rChMsg)

    # ---- 反例: Score 等级非排列 ----
    var gRank = smokeBuildValidGraph()
    var rkProbs: dc.CsgDecisionProbValue[]
    add(rkProbs, smokeProb(50, 2))
    add(rkProbs, smokeProb(50, 2))
    var rkRanks: int32[]
    add(rkRanks, 0)
    add(rkRanks, 0)
    var rkRes: dc.CsgDecisionLearnResult
    rkRes.learnRef = 2
    rkRes.generation = gen7
    rkRes.headKind = dc.CsgDecisionHeadScore
    rkRes.noMatch = false
    rkRes.boundGoalRef = 0
    rkRes.chosenCandidate = dc.CsgDecisionChosenNone
    rkRes.probs = rkProbs
    rkRes.ranks = rkRanks
    rkRes.weighted = smokeProb(50, 2)
    dc.CsgDecisionLearnResultAdd(gRank, rkRes)
    let rRk = dv.DecisionValidateLearnResultAt(share(gRank), 3)
    let rRkOk = IsOk(rRk)
    let rRkMsg = Error(rRk)
    smokeCheckErr("ranks-not-permutation", "InvalidOutput: decision learn result ranks not a permutation", rRkOk, rRkMsg)

    # ---- 反例: Score 加权值与等级分布不一致 ----
    var gWeighted = smokeBuildValidGraph()
    var wpProbs: dc.CsgDecisionProbValue[]
    add(wpProbs, smokeProb(50, 2))
    add(wpProbs, smokeProb(50, 2))
    var wpRanks: int32[]
    add(wpRanks, 1)
    add(wpRanks, 0)
    var wpRes: dc.CsgDecisionLearnResult
    wpRes.learnRef = 2
    wpRes.generation = gen7
    wpRes.headKind = dc.CsgDecisionHeadScore
    wpRes.noMatch = false
    wpRes.boundGoalRef = 0
    wpRes.chosenCandidate = dc.CsgDecisionChosenNone
    wpRes.probs = wpProbs
    wpRes.ranks = wpRanks
    wpRes.weighted = smokeProb(51, 2)
    dc.CsgDecisionLearnResultAdd(gWeighted, wpRes)
    let rWp = dv.DecisionValidateLearnResultAt(share(gWeighted), 3)
    let rWpOk = IsOk(rWp)
    let rWpMsg = Error(rWp)
    smokeCheckErr("weighted-inconsistent", "InvalidOutput: decision learn result weighted value inconsistent", rWpOk, rWpMsg)

    # ---- 反例: no-match 携带概率 ----
    var gNM = smokeBuildValidGraph()
    var nmProbs: dc.CsgDecisionProbValue[]
    add(nmProbs, smokeProb(100, 2))
    var nmRes: dc.CsgDecisionLearnResult
    nmRes.learnRef = 0
    nmRes.generation = gen7
    nmRes.headKind = dc.CsgDecisionHeadChoice
    nmRes.noMatch = true
    nmRes.boundGoalRef = 0
    nmRes.chosenCandidate = dc.CsgDecisionChosenNone
    nmRes.probs = nmProbs
    nmRes.ranks = smokeEmptyI32()
    nmRes.weighted = smokeProb(0, 2)
    dc.CsgDecisionLearnResultAdd(gNM, nmRes)
    let rNm = dv.DecisionValidateLearnResultAt(share(gNM), 3)
    let rNmOk = IsOk(rNm)
    let rNmMsg = Error(rNm)
    smokeCheckErr("no-match-inconsistent", "InvalidOutput: decision learn result no-match inconsistent", rNmOk, rNmMsg)

    # ---- 反例: Noul 头携带候选集 ----
    var gNoulC = smokeBuildValidGraph()
    var ln3: dc.CsgDecisionLearnNode
    ln3.headKind = dc.CsgDecisionHeadNoul
    ln3.candidateSetRef = 0
    ln3.candidateCount = 2
    ln3.evidenceRef = 7
    ln3.backendRef = 10
    ln3.generation = gen7
    dc.CsgDecisionLearnAdd(gNoulC, ln3)
    var ncProbs: dc.CsgDecisionProbValue[]
    add(ncProbs, smokeProb(70, 2))
    var ncRes: dc.CsgDecisionLearnResult
    ncRes.learnRef = 3
    ncRes.generation = gen7
    ncRes.headKind = dc.CsgDecisionHeadNoul
    ncRes.noMatch = false
    ncRes.boundGoalRef = 0
    ncRes.chosenCandidate = dc.CsgDecisionChosenNone
    ncRes.probs = ncProbs
    ncRes.ranks = smokeEmptyI32()
    ncRes.weighted = smokeProb(0, 2)
    dc.CsgDecisionLearnResultAdd(gNoulC, ncRes)
    let rNc = dv.DecisionValidateLearnResultAt(share(gNoulC), 3)
    let rNcOk = IsOk(rNc)
    let rNcMsg = Error(rNc)
    smokeCheckErr("noul-with-candidates", "InvalidOutput: decision learn candidate set inconsistent for head", rNcOk, rNcMsg)

    # ---- 反例: 候选交换 (候选与绑定目标不一致) ----
    var gSwap = smokeBuildValidGraph()
    let goal2Slot = dc.CsgDecisionSlotAdd(gSwap, dc.CsgDecisionSlotKindGoal)
    var paramsC: int32[]
    add(paramsC, 3)
    add(paramsC, 4)
    var candC: dc.CsgDecisionCandidate
    candC.goalRef = goal2Slot
    candC.operationRef = 2
    candC.paramSlots = paramsC
    candC.preconditionRef = 5
    candC.effectContractRef = 6
    candC.generation = gen7
    dc.CsgDecisionCandidateAdd(gSwap, candC)
    var ln4: dc.CsgDecisionLearnNode
    ln4.headKind = dc.CsgDecisionHeadChoice
    ln4.candidateSetRef = 2
    ln4.candidateCount = 1
    ln4.evidenceRef = 7
    ln4.backendRef = 10
    ln4.generation = gen7
    dc.CsgDecisionLearnAdd(gSwap, ln4)
    var swProbs: dc.CsgDecisionProbValue[]
    add(swProbs, smokeProb(100, 2))
    var swRes: dc.CsgDecisionLearnResult
    swRes.learnRef = 3
    swRes.generation = gen7
    swRes.headKind = dc.CsgDecisionHeadChoice
    swRes.noMatch = false
    swRes.boundGoalRef = 0
    swRes.chosenCandidate = 2
    swRes.probs = swProbs
    swRes.ranks = smokeEmptyI32()
    swRes.weighted = smokeProb(0, 2)
    dc.CsgDecisionLearnResultAdd(gSwap, swRes)
    let rSw = dv.DecisionValidateLearnResultAt(share(gSwap), 3)
    let rSwOk = IsOk(rSw)
    let rSwMsg = Error(rSw)
    smokeCheckErr("candidate-goal-swap", "InvalidOutput: decision candidate goal swap", rSwOk, rSwMsg)

    # ---- 反例: 过期世代 (引用 + 全图) ----
    var gAdv = smokeBuildValidGraph()
    dc.CsgDecisionGraphAdvanceGeneration(gAdv, gen8)
    var staleRef: dc.CsgDecisionRef
    staleRef.session = session
    staleRef.generation = gen7
    staleRef.index = 0
    staleRef.kind = dc.CsgDecisionSlotKindGoal
    let rSt = dv.DecisionValidateRef(share(gAdv), staleRef)
    let rStOk = IsOk(rSt)
    let rStMsg = Error(rSt)
    smokeCheckErr("ref-expired-generation", "InvalidOutput: decision ref expired generation", rStOk, rStMsg)
    let rGA = dv.DecisionValidateGraph(share(gAdv))
    let rGAOk = IsOk(rGA)
    let rGAMsg = Error(rGA)
    smokeCheckErr("graph-expired-node", "InvalidOutput: decision node expired generation", rGAOk, rGAMsg)

    # ---- 反例: 销毁重建 (同会话新容器同索引, 旧世代引用双键失配) ----
    var gRe = dc.CsgDecisionGraphNew(session, gen8)
    dc.CsgDecisionSlotAdd(gRe, dc.CsgDecisionSlotKindGoal)
    var oldRef: dc.CsgDecisionRef
    oldRef.session = session
    oldRef.generation = gen7
    oldRef.index = 0
    oldRef.kind = dc.CsgDecisionSlotKindGoal
    let rRe = dv.DecisionValidateRef(share(gRe), oldRef)
    let rReOk = IsOk(rRe)
    let rReMsg = Error(rRe)
    smokeCheckErr("destroy-rebuild-stale-binding", "InvalidOutput: decision ref stale generation binding (destroy/rebuild)", rReOk, rReMsg)

    # ---- 反例: 跨会话引用 ----
    var xRef: dc.CsgDecisionRef
    xRef.session = 1234
    xRef.generation = gen7
    xRef.index = 0
    xRef.kind = dc.CsgDecisionSlotKindGoal
    let rXs = dv.DecisionValidateRef(share(g), xRef)
    let rXsOk = IsOk(rXs)
    let rXsMsg = Error(rXs)
    smokeCheckErr("ref-cross-session", "InvalidOutput: decision ref cross-session", rXsOk, rXsMsg)

    # ---- 反例: 伪造索引 (越界) 与错类型槽 ----
    var oobRef: dc.CsgDecisionRef
    oobRef.session = session
    oobRef.generation = gen7
    oobRef.index = 999
    oobRef.kind = dc.CsgDecisionSlotKindGoal
    let rOob = dv.DecisionValidateRef(share(g), oobRef)
    let rOobOk = IsOk(rOob)
    let rOobMsg = Error(rOob)
    smokeCheckErr("ref-forged-index", "InvalidOutput: decision ref forged index (out of bounds)", rOobOk, rOobMsg)
    var wrongRef: dc.CsgDecisionRef
    wrongRef.session = session
    wrongRef.generation = gen7
    wrongRef.index = 7
    wrongRef.kind = dc.CsgDecisionSlotKindGoal
    let rWk = dv.DecisionValidateRef(share(g), wrongRef)
    let rWkOk = IsOk(rWk)
    let rWkMsg = Error(rWk)
    smokeCheckErr("ref-wrong-slot-kind", "InvalidOutput: decision ref slot kind mismatch", rWkOk, rWkMsg)

    # ---- 反例: 按名寻址请求 ----
    let rName = dv.DecisionRejectNameRequest("ok-button")
    let rNameOk = IsOk(rName)
    let rNameMsg = Error(rName)
    smokeCheckErr("by-name-addressing", "InvalidOutput: by-name addressing forbidden; use bound int32 indices", rNameOk, rNameMsg)

    # ---- 反例: 未知失败族 ----
    let rBogus = dc.CsgDecisionFailureNew("Bogus", "d")
    let rBogusOk = IsOk(rBogus)
    let rBogusMsg = Error(rBogus)
    smokeCheckErr("failure-kind-unknown", "InvalidOutput: decision failure kind unknown", rBogusOk, rBogusMsg)

    echo("csg_decision_contract_smoke ok")
    return 0
