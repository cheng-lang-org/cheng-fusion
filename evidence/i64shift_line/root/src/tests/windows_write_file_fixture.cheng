import std/os as os
import std/rawbytes as rawbytes
import std/result

fn main(): int32 =
    let readProbe: os.File = os.OpenRead("winwrite.report.txt")
    if readProbe == nil:
        puts("read_open_failed")
    else:
        puts("read_open_ok")
        os.Close(readProbe)
    let payload: str = "hello-windows-write"
    var view: rawbytes.Bytes = rawbytes.BytesView(StrDataPtr(payload), len(payload))
    var res: Result[bool] = os.WriteFileBytesResult("win_write_probe.txt", view)
    if IsErr(res):
        puts(Error(res))
        return 1
    puts("windows_write_ok")
    return 0
