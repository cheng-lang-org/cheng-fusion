@profile("driver_safe")

type
    IoUInt8Ptr = uint8 *
    IoUInt32Ptr = uint32 *

@trusted_abi
fn IoSt8(base: uint64, offset: uint64, value: int32) =
    let b = base
    let o = offset
    let addr = ptr(b + o)
    *(IoUInt8Ptr(addr)) = uint8(value & 255)

fn main(): int32 =
    IoSt8(268435456, 0, 75)
    IoSt8(268435456, 0, 76)
    IoSt8(268435456, 0, 10)
    return 0
