# f64 位型 ABI 冒烟 (任务: f64_bits_abi_fix)。
# 验证 program_support_backend.cheng 的 cheng_bits_to_f64 / cheng_f64_to_bits /
# cheng_f64_bits_is_nan 三个导出的位精确语义。
#
# 驱动缺陷绕行纪律 (范围外, 已登记遗留):
#   a) >32 位整型字面量截断 —— 64 位常量一律 int32 分量 + 移位构造 (mkBits);
#   b) 大指数浮点字面量 (如 1e300) 在实参位置令 cold 解析器报
#      malformed/unresolved —— 1e300/1e-300 不写字面量, 用 IEEE754 权威位型
#      (独立按 python struct 计算) 经 mkBits 构造, 全部位级判定。
import std/strings
import std/strutils as strutil

fn mkBits(hi: int32, lo: int32): int64 =
    # int64(hi) 符号扩展后在 << 32 中把高位垃圾移出, 等价无符号拼接。
    return (int64(hi) << 32) | (int64(lo) & ((int64(1) << 32) - int64(1)))

fn hi32(bits: int64): int32 =
    return int32(bits >> 32)

fn lo32(bits: int64): int32 =
    return int32(bits & ((int64(1) << 32) - int64(1)))

fn makeNaN(): float64 =
    # 经局部变量走运行时除法, 避开常量折叠路径。
    var z: float64 = 0.0
    return z / z

fn fail(label: str, detail: str) =
    echo(strutil.Join([
        "SMOKE FAIL ",
        strings.CloneStr(label),
        " ",
        strings.CloneStr(detail)
    ], ""))
    assert(false, "f64 bits smoke failed")

fn ok(label: str) =
    echo(strutil.Join(["smoke ok: ", strings.CloneStr(label)], ""))

fn checkBitsEq(label: str, got: int64, want: int64) =
    if got != want:
        fail(label, strutil.Join([
            "got hi=",
            strings.IntToStr(hi32(got)),
            " lo=",
            strings.IntToStr(lo32(got)),
            " want hi=",
            strings.IntToStr(hi32(want)),
            " lo=",
            strings.IntToStr(lo32(want))
        ], ""))
        return
    ok(label)

fn checkTrue(label: str, v: bool) =
    if !v:
        fail(label, "unexpected false")
        return
    ok(label)

fn main(): int32 =
    # 1) 读侧位型逐条 (期望位型: IEEE754 double)
    checkBitsEq("f64ToBits(0.5)", f64ToBits(0.5), mkBits(1071644672, 0))
    checkBitsEq("f64ToBits(1.0)", f64ToBits(1.0), mkBits(1072693248, 0))
    checkBitsEq("f64ToBits(-2.0)", f64ToBits(-2.0), mkBits(-1073741824, 0))
    checkBitsEq("f64ToBits(0.0)", f64ToBits(0.0), 0)
    # 2) 写侧: 位型 -> 精确值
    checkTrue("bitsToF64(0x3FE0000000000000)==0.5",
              bitsToF64(mkBits(1071644672, 0)) == 0.5)
    checkTrue("bitsToF64(0x3FF0000000000000)==1.0",
              bitsToF64(mkBits(1072693248, 0)) == 1.0)
    checkTrue("bitsToF64(0)==0.0", bitsToF64(0) == 0.0)
    # 3) 全往返: {0.5, 1.0, -2.0, 3.14159} 浮点等值 + 位级双判
    checkTrue("roundtrip 0.5", bitsToF64(f64ToBits(0.5)) == 0.5)
    checkTrue("roundtrip 1.0", bitsToF64(f64ToBits(1.0)) == 1.0)
    checkTrue("roundtrip -2.0", bitsToF64(f64ToBits(-2.0)) == -2.0)
    checkTrue("roundtrip 3.14159", bitsToF64(f64ToBits(3.14159)) == 3.14159)
    checkBitsEq("roundtrip bits 3.14159",
                f64ToBits(bitsToF64(f64ToBits(3.14159))),
                f64ToBits(3.14159))
    # 4) 大幅值往返 (位级): 1e300=0x7E37E43C8800759C, 1e-300=0x01A56E1FC2F8F359
    #    (位型经独立 IEEE754 权威计算; 字面量绕行见文件头纪律 b)
    checkBitsEq("roundtrip 1e300 (bits)",
                f64ToBits(bitsToF64(mkBits(2117592124, -2013235812))),
                mkBits(2117592124, -2013235812))
    checkBitsEq("roundtrip 1e-300 (bits)",
                f64ToBits(bitsToF64(mkBits(27618847, -1023872167))),
                mkBits(27618847, -1023872167))
    # 5) NaN 位判定: 指数字段全 1 且尾数非 0 (位逻辑, 不经浮点)
    let nanBits: int64 = f64ToBits(makeNaN())
    checkTrue("NaN exponent all ones",
              ((nanBits >> 52) & int64(2047)) == int64(2047))
    checkTrue("NaN mantissa nonzero",
              (nanBits & ((int64(1) << 52) - int64(1))) != 0)
    # 6) 新导出 cheng_f64_bits_is_nan: 链接 + 逻辑
    checkTrue("f64BitsIsNaN(nanBits)", f64BitsIsNaN(nanBits))
    checkTrue("!f64BitsIsNaN(0)", !f64BitsIsNaN(0))
    checkTrue("!f64BitsIsNaN(bits(1.0))", !f64BitsIsNaN(mkBits(1072693248, 0)))
    echo("f64_bits_abi_smoke ALL PASS")
    return 0
