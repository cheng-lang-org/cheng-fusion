fn R24Trim(raw: str): str =
    return raw

fn R24NegDouble(lineRaw: str, genericPos: int32): int32 =
    let headRaw = R24Trim(lineRaw)
    var head: str
    if genericPos > 0:
        head = R24Trim(lineRaw)
    else:
        head = headRaw
    let other = headRaw
    return head.len + other.len

fn main(): int32 =
    let n = R24NegDouble("abcdef", 1)
    if n != 12:
        return 10
    echo("neg reached")
    return 0
