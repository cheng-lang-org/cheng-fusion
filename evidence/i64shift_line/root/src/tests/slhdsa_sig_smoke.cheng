# SLH-DSA (FIPS 205) full signature smoke test for SLH-DSA-SHAKE-128s,
# three levels:
#   1. Self-consistency: KeyGen_internal -> Sign (fixed injected addrnd) ->
#      Verify true for 1 fixed seed group (128s signing costs ~2.1M Keccak
#      permutations, so the group count is reduced from 3 to 1 per the
#      >120s-per-sign rule; per-phase wall times are printed); tampering
#      the signature / message / public key at 3 byte positions each
#      (signature: one byte in each of R / SIG_FORS / SIG_HT; message and
#      pk: first / middle / last byte, covering PK.seed and PK.root) must
#      yield Verify false without crashing.
#   2. Encoding sizes: pk/sk/sig lengths match the FIPS 205 table for
#      SHAKE-128s (32/64/7856) and SHAKE-128f (32/64/17088).
#   3. Official KAT: NIST ACVP vectors (github.com/usnistgov/ACVP-Server,
#      gen-val/json-files/SLH-DSA-*-FIPS205/internalProjection.json,
#      vsId 53), all SLH-DSA-SHAKE-128s:
#      a) keyGen tgId=2 tcId=11: (skSeed, skPrf, pkSeed) -> pk/sk;
#      b) sigGen tgId=34 (internal interface, deterministic) tcId=292:
#         Sign_internal(M, sk, addrnd = PK.seed) -> signature;
#      c) sigGen tgId=25 (external interface, pure, deterministic)
#         tcId=216: public API with 219-byte context prefix -> signature,
#         plus Verify roundtrip against the vector pk;
#      d) sigVer tgId=34 (internal interface) tcId=464 valid -> true and
#         tcId=468/474/475 (modified R / SIG_FORS / SIG_HT) -> false,
#         tcId=472/476 (signature too large / too small) -> false.

import std/system
import std/strings
import std/result
import std/rawbytes
import std/crypto/sha3
import std/crypto/slhdsa as slhdsa
import std/times as times

const
    kgSkSeed = "c151951f3811029239b74add24c506af"
    kgSkPrf = "dd30363e156e6fe936ec6ed0231feb5c"
    kgPkSeed = "529ffe86200d1f32c2b60d0cd909f190"
    kgPk = "529ffe86200d1f32c2b60d0cd909f1900761f9b727afa724b47223016bb5b2ba"
    kgSk = "c151951f3811029239b74add24c506afdd30363e156e6fe936ec6ed0231feb5c529ffe86200d1f32c2b60d0cd909f1900761f9b727afa724b47223016bb5b2ba"
    sgiSk = "a08dd5fd6db64050e7dae0db3bb3fa24641930d2179ee6155c3e51fc4f696ce06146e92a0ce7c6f48876970a313c600005d6702b2c1d729e9dd5e7517d2e02fe"
    sgiMsg = "36"
    sgiSig = ""
    sgeSk = "1cf0849eef53f932a4db4bc1fc236622ef5803e521b3ebe437827ef49961f8882e3a575b3e6136284d5ed0b96f5c54693b0a6d8dc6e4adac66a546d3eec7b9bc"
    sgePk = "2e3a575b3e6136284d5ed0b96f5c54693b0a6d8dc6e4adac66a546d3eec7b9bc"
    sgeMsg = "bd"
    sgeCtx = ""
    sgeSig = ""
    svOkPk = "ea8026e4fb9ed440748c899535c24325ef42ce99f5af63fe863872e3bd5b5845"
    svOkMsg = ""
    svOkSig = ""
    svRPk = "f07fea513df90f7cd11d640759a25b7dc2ba9ebf727986bb222fdcde090929d7"
    svRMsg = "c5da8f55587835167ebf7d352125cd93d577b510c3448577a483d44f56b7e018e91a7a1ce913400d4ce5de8c827612398383a99c065b2d3ff67968988582fc5d4c00ac345f"
    svRSig = ""
    svBigPk = "a5ce6c4aac310a9edcfc2502da8a7b5c8fdd4a381bd9c22d21cb1ad37e46afa9"
    svBigMsg = ""
    svBigSig = ""
    svSmallPk = "dda7f175de47d4a4b67d07e635fda04abe46e8037dbcfa3b8aa5039ad463da01"
    svSmallMsg = ""
    svSmallSig = ""
    svForsPk = "9dd9c0d948d5c57da1f70a5cb7619e17ae22c06417e524b7c0a785a4d712dafa"
    svForsMsg = ""
    svForsSig = ""
    svHtPk = "49bc223b5dbcb2e50255afdecd0773baeacb7888c0b5a5ad9b0774a31fc82680"
    svHtMsg = "d9"
    svHtSig = ""

fn hexVal(c: int32): int32 =
    if c >= 48 && c <= 57:
        return c - 48
    if c >= 97 && c <= 102:
        return c - 87
    if c >= 65 && c <= 70:
        return c - 55
    Assert(false, "hexToBytes: invalid hex character")
    return 0

fn hexToBytes(s: str): Bytes =
    let raw: Bytes = BytesFromString(s)
    let n: int32 = BytesLen(raw)
    Assert(n % 2 == 0, "hexToBytes: odd length")
    let out: Bytes = BytesAlloc(n / 2)
    for i in 0..<(n / 2):
        BytesSet(out, i, hexVal(BytesGet(raw, 2 * i)) * 16 + hexVal(BytesGet(raw, 2 * i + 1)))
    return out

# Deterministic test seeds: SHAKE256(group || label, outLen).
fn deriveSeed(group: int32, label: int32, outLen: int32): Bytes =
    let input: Bytes = BytesAlloc(2)
    BytesSet(input, 0, group)
    BytesSet(input, 1, label)
    return Shake256Xof(input, outLen)

fn tamperedCopy(b: Bytes, pos: int32): Bytes =
    let c: Bytes = BytesSlice(b, 0, BytesLen(b))
    BytesSet(c, pos, (BytesGet(c, pos) + 1) & 255)
    return c

fn selfConsistencyRound(p: slhdsa.SlhParams, group: int32): bool =
    let seeds: Bytes = deriveSeed(group, 1, 3 * p.n)
    let t0: int64 = times.MonotimeMs()
    let kp: slhdsa.SlhKeyPair = slhdsa.SlhKeyGenInternal(p,
        BytesSlice(seeds, 0, p.n), BytesSlice(seeds, p.n, p.n), BytesSlice(seeds, 2 * p.n, p.n))
    let t1: int64 = times.MonotimeMs()
    echo(Fmt"slhdsa 128s group {group}: keygen {t1 - t0}ms")
    if BytesLen(kp.pk) != slhdsa.SlhPkLen(p) || BytesLen(kp.sk) != slhdsa.SlhSkLen(p):
        echo(Fmt"slhdsa 128s group {group}: key lengths wrong: pk={BytesLen(kp.pk)} sk={BytesLen(kp.sk)}")
        return false
    let msg: Bytes = Shake256Xof(deriveSeed(group, 2, 32), 47 + 13 * group)
    let ctx: Bytes = BytesSlice(deriveSeed(group, 3, 32), 0, 5 + group)
    let addrnd: Bytes = BytesSlice(deriveSeed(group, 4, 32), 0, p.n)
    let t2: int64 = times.MonotimeMs()
    let sigRes: Result[Bytes] = slhdsa.SlhSignWithAddrnd(p, kp.sk, msg, ctx, addrnd)
    let t3: int64 = times.MonotimeMs()
    echo(Fmt"slhdsa 128s group {group}: sign {t3 - t2}ms")
    if IsErr(sigRes):
        echo(Fmt"slhdsa 128s group {group}: sign failed")
        return false
    let sig: Bytes = Value(sigRes)
    if BytesLen(sig) != slhdsa.SlhSigLen(p):
        echo(Fmt"slhdsa 128s group {group}: signature length wrong: {BytesLen(sig)}")
        return false
    let t4: int64 = times.MonotimeMs()
    let genuine: bool = slhdsa.SlhVerify(p, kp.pk, msg, sig, ctx)
    let t5: int64 = times.MonotimeMs()
    echo(Fmt"slhdsa 128s group {group}: verify {t5 - t4}ms")
    if !genuine:
        echo(Fmt"slhdsa 128s group {group}: genuine signature rejected")
        return false
    let sigLen: int32 = BytesLen(sig)
    let msgLen: int32 = BytesLen(msg)
    let pkLen: int32 = BytesLen(kp.pk)
    for t in 0..<3:
        # Signature byte positions inside R (t=0), SIG_FORS (t=1) and
        # SIG_HT (t=2) respectively.
        var sigPos: int32 = 8
        if t == 1:
            sigPos = sigLen / 4
        if t == 2:
            sigPos = sigLen - 2
        if slhdsa.SlhVerify(p, kp.pk, msg, tamperedCopy(sig, sigPos), ctx):
            echo(Fmt"slhdsa 128s group {group}: tampered signature byte {sigPos} accepted")
            return false
        let msgPos: int32 = (t * (msgLen - 1)) / 2
        if slhdsa.SlhVerify(p, kp.pk, tamperedCopy(msg, msgPos), sig, ctx):
            echo(Fmt"slhdsa 128s group {group}: tampered message byte {msgPos} accepted")
            return false
        let pkPos: int32 = (t * (pkLen - 1)) / 2
        if slhdsa.SlhVerify(p, tamperedCopy(kp.pk, pkPos), msg, sig, ctx):
            echo(Fmt"slhdsa 128s group {group}: tampered public key byte {pkPos} accepted")
            return false
    return true

fn testSelfConsistency(): bool =
    if !selfConsistencyRound(slhdsa.SlhParamsShake128s(), 0):
        return false
    echo("slhdsa level 1 (self-consistency) ok")
    return true

fn checkLengths(name: str, p: slhdsa.SlhParams, pkLen: int32, skLen: int32, sigLen: int32): bool =
    if slhdsa.SlhPkLen(p) != pkLen || slhdsa.SlhSkLen(p) != skLen || slhdsa.SlhSigLen(p) != sigLen:
        echo(Fmt"slhdsa {name} FIPS table mismatch: pk={slhdsa.SlhPkLen(p)} sk={slhdsa.SlhSkLen(p)} sig={slhdsa.SlhSigLen(p)}")
        return false
    return true

fn testEncodingSizes(): bool =
    if !checkLengths("shake-128s", slhdsa.SlhParamsShake128s(), 32, 64, 7856):
        return false
    if !checkLengths("shake-128f", slhdsa.SlhParamsShake128f(), 32, 64, 17088):
        return false
    echo("slhdsa level 2 (encoding sizes) ok")
    return true

fn katKeyGen(): bool =
    let p: slhdsa.SlhParams = slhdsa.SlhParamsShake128s()
    let t0: int64 = times.MonotimeMs()
    let kp: slhdsa.SlhKeyPair = slhdsa.SlhKeyGenInternal(p,
        hexToBytes(kgSkSeed), hexToBytes(kgSkPrf), hexToBytes(kgPkSeed))
    let t1: int64 = times.MonotimeMs()
    echo(Fmt"slhdsa KAT keyGen tcId=11: {t1 - t0}ms")
    if !streq(BytesToHex(kp.pk), kgPk):
        echo("slhdsa KAT keyGen tcId=11: pk mismatch")
        echo(BytesToHex(kp.pk))
        return false
    if !streq(BytesToHex(kp.sk), kgSk):
        echo("slhdsa KAT keyGen tcId=11: sk mismatch")
        echo(BytesToHex(kp.sk))
        return false
    return true

fn katSigGenInternal(): bool =
    let p: slhdsa.SlhParams = slhdsa.SlhParamsShake128s()
    let sk: Bytes = hexToBytes(sgiSk)
    # Deterministic variant: addrnd = PK.seed (sk bytes [2n, 3n)).
    let t0: int64 = times.MonotimeMs()
    let sig: Bytes = slhdsa.SlhSignInternal(p, sk, hexToBytes(sgiMsg), BytesSlice(sk, 2 * p.n, p.n))
    let t1: int64 = times.MonotimeMs()
    echo(Fmt"slhdsa KAT sigGen internal tcId=292: {t1 - t0}ms")
    if !streq(BytesToHex(sig), sgiSig):
        echo("slhdsa KAT sigGen internal tcId=292: signature mismatch")
        echo(BytesToHex(BytesSlice(sig, 0, 32)))
        return false
    return true

fn katSigGenExternal(): bool =
    let p: slhdsa.SlhParams = slhdsa.SlhParamsShake128s()
    let t0: int64 = times.MonotimeMs()
    let sigRes: Result[Bytes] = slhdsa.SlhSignDeterministic(p, hexToBytes(sgeSk), hexToBytes(sgeMsg), hexToBytes(sgeCtx))
    let t1: int64 = times.MonotimeMs()
    echo(Fmt"slhdsa KAT sigGen external tcId=216: {t1 - t0}ms")
    if IsErr(sigRes):
        echo("slhdsa KAT sigGen external tcId=216: sign failed")
        return false
    let sig: Bytes = Value(sigRes)
    if !streq(BytesToHex(sig), sgeSig):
        echo("slhdsa KAT sigGen external tcId=216: signature mismatch")
        echo(BytesToHex(BytesSlice(sig, 0, 32)))
        return false
    if !slhdsa.SlhVerify(p, hexToBytes(sgePk), hexToBytes(sgeMsg), sig, hexToBytes(sgeCtx)):
        echo("slhdsa KAT sigGen external tcId=216: verify roundtrip failed")
        return false
    return true

fn katSigVer(label: str, want: bool, pkHex: str, msgHex: str, sigHex: str): bool =
    let p: slhdsa.SlhParams = slhdsa.SlhParamsShake128s()
    let got: bool = slhdsa.SlhVerifyInternal(p, hexToBytes(pkHex), hexToBytes(msgHex), hexToBytes(sigHex))
    if got != want:
        echo(Fmt"slhdsa KAT {label}: verify result wrong")
        return false
    return true

fn testKat(): bool =
    if !katKeyGen():
        return false
    if !katSigGenInternal():
        return false
    if !katSigGenExternal():
        return false
    if !katSigVer("sigVer tcId=464 valid", true, svOkPk, svOkMsg, svOkSig):
        return false
    if !katSigVer("sigVer tcId=468 modified R", false, svRPk, svRMsg, svRSig):
        return false
    if !katSigVer("sigVer tcId=474 modified SIG_FORS", false, svForsPk, svForsMsg, svForsSig):
        return false
    if !katSigVer("sigVer tcId=475 modified SIG_HT", false, svHtPk, svHtMsg, svHtSig):
        return false
    if !katSigVer("sigVer tcId=472 too large", false, svBigPk, svBigMsg, svBigSig):
        return false
    if !katSigVer("sigVer tcId=476 too small", false, svSmallPk, svSmallMsg, svSmallSig):
        return false
    echo("slhdsa level 3 (NIST ACVP KAT) ok")
    return true

fn main(): int32 =
    let t0: int64 = times.MonotimeMs()
    if !testSelfConsistency():
        return 1
    if !testEncodingSizes():
        return 1
    if !testKat():
        return 1
    let t1: int64 = times.MonotimeMs()
    echo(Fmt"slhdsa_sig_smoke ok: self-consistency(128s x1, tamper sig/msg/pk x3 each) sizes(128s=32/64/7856 128f=32/64/17088) kat(acvp vsId=53 keyGen tcId=11; sigGen internal tcId=292 + external ctx tcId=216; sigVer tcId=464 valid + 468/474/475/472/476 invalid) all passed, total {t1 - t0}ms")
    return 0
