import std/result
import std/rawbytes as rawbytes

fn wrapAllocatedBytes(): Result[Bytes] =
    var bytes = rawbytes.BytesAlloc(4)
    rawbytes.BytesSet(bytes, 0, 91)
    return Ok[Bytes](bytes)

fn wrapEmptyBytes(): Result[Bytes] =
    return Ok[Bytes](rawbytes.EmptyBytes())

fn main(): int32 =
    var allocatedResult = wrapAllocatedBytes()
    if IsErr(allocatedResult):
        return 1
    var allocated = Value(allocatedResult)
    if rawbytes.BytesLen(allocated) != 4 ||
            rawbytes.BytesGet(allocated, 0) != 91:
        rawbytes.BytesFree(allocated)
        return 2
    rawbytes.BytesFree(allocated)

    var emptyResult = wrapEmptyBytes()
    if IsErr(emptyResult):
        return 3
    var empty = Value(emptyResult)
    if rawbytes.BytesLen(empty) != 0:
        rawbytes.BytesFree(empty)
        return 4
    rawbytes.BytesFree(empty)
    return 0
