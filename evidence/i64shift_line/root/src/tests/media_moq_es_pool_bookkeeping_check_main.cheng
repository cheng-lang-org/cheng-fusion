# Pure bookkeeping verification for the per-slot ES connection pool added to
# web_scene_media_network_bridge.cheng (acquire / dedupe / pool-full / find-peer /
# getter zero-value contracts). No network, no publisher: pool acquisition is pure
# SoA bookkeeping, and this file deliberately references ONLY the non-dialing pool
# surface (Acquire + getters; Release/OpenPeer/PrefetchTick pull the QUIC dial/close
# path and are covered live by media_moq_es_pool_check_main.cheng).
#
# Oracle = the pool's own documented contract (webSceneMediaEsPoolMaxSlots slots,
# int32 slot identity, -1 on pool-full, false/zero/"" getters on unopened slots) —
# every assertion below is derivable from first principles without executing the
# code under test, so a wrong answer cannot produce a false green.
#
# Any failure prints a reason and exits nonzero; success prints "POOL_BOOKKEEPING_OK".

import std/os
import std/strutils as strutil
import cheng/core/runtime/web_scene_media_network_bridge as media_bridge

fn fail(msg: str): int32 =
    os.WriteLine(os.Get_stdout(), strutil.Join(["FAIL: ", msg], ""))
    return 1

fn main(): int32 =
    # 1. Capacity contract.
    if media_bridge.WebSceneMediaEsPoolSlotCount() != 3:
        return fail(strutil.Join(["PoolSlotCount=", IntToStr(media_bridge.WebSceneMediaEsPoolSlotCount()), " want=3"], ""))
    os.WriteLine(os.Get_stdout(), "step1_slot_count_ok")

    # 2. Acquire three distinct peers: fills the pool with three DISTINCT slot indices.
    let sA: int32 = media_bridge.WebSceneMediaEsPoolAcquire("127.0.0.1", 39301)
    let sB: int32 = media_bridge.WebSceneMediaEsPoolAcquire("127.0.0.1", 39302)
    let sC: int32 = media_bridge.WebSceneMediaEsPoolAcquire("10.0.0.9", 39301)
    if sA < 0 || sB < 0 || sC < 0:
        return fail("acquire of first three distinct peers returned < 0")
    if sA == sB || sA == sC || sB == sC:
        return fail("distinct peers collided on the same slot")
    os.WriteLine(os.Get_stdout(), "step2_three_slots_distinct_ok")

    # 3. Idempotent re-acquire: same host:port returns the SAME slot (no duplicate session);
    #    a host-only or port-only mismatch is a DIFFERENT peer (exact (host,port) identity).
    if media_bridge.WebSceneMediaEsPoolAcquire("127.0.0.1", 39301) != sA:
        return fail("re-acquire of same peer did not return the same slot")
    os.WriteLine(os.Get_stdout(), "step3_dedupe_ok")

    # 4. Pool full: a fourth distinct peer is rejected loudly with -1.
    if media_bridge.WebSceneMediaEsPoolAcquire("127.0.0.1", 39304) != -1:
        return fail("fourth distinct peer was not rejected with -1 on a full pool")
    os.WriteLine(os.Get_stdout(), "step4_pool_full_loud_ok")

    # 5. Getter zero-value contracts on reserved-but-never-opened slots (mirrors the
    #    primary session's !open -> 0/""/false getters).
    if !media_bridge.WebSceneMediaEsPoolSlotIsUsed(sA):
        return fail("IsUsed false on a reserved slot")
    if media_bridge.WebSceneMediaEsPoolSlotIsOpen(sA):
        return fail("IsOpen true on a never-opened slot")
    if media_bridge.WebSceneMediaEsPoolSlotFrameCount(sA) != 0:
        return fail("FrameCount nonzero on a never-opened slot")
    if media_bridge.WebSceneMediaEsPoolSlotAssetCid(sA).len != 0:
        return fail("AssetCid non-empty on a never-opened slot")
    if media_bridge.WebSceneMediaEsPoolSlotContentMatches(sA, "anycid"):
        return fail("ContentMatches true on a never-opened slot")
    if media_bridge.WebSceneMediaEsPoolSlotLastError(sA).len != 0:
        return fail("LastError non-empty on a slot that never attempted an open")
    os.WriteLine(os.Get_stdout(), "step5_unopened_getters_zero_ok")

    # 6. Invalid slot indices are rejected loudly by every indexed entry point.
    if media_bridge.WebSceneMediaEsPoolSlotIsUsed(-1) || media_bridge.WebSceneMediaEsPoolSlotIsUsed(7):
        return fail("IsUsed true for an out-of-range slot index")
    if media_bridge.WebSceneMediaEsPoolSlotIsOpen(7):
        return fail("IsOpen true for an out-of-range slot index")
    if media_bridge.WebSceneMediaEsPoolSlotFrameCount(7) != 0:
        return fail("FrameCount nonzero for an out-of-range slot index")
    if media_bridge.WebSceneMediaEsPoolSlotAssetCid(7).len != 0:
        return fail("AssetCid non-empty for an out-of-range slot index")
    if media_bridge.WebSceneMediaEsPoolSlotContentMatches(7, "anycid"):
        return fail("ContentMatches true for an out-of-range slot index")
    if media_bridge.WebSceneMediaEsPoolSlotLastError(7).len != 0:
        return fail("LastError non-empty for an out-of-range slot index")
    os.WriteLine(os.Get_stdout(), "step6_invalid_index_loud_ok")

    # 7. FindPeer scans OPEN sessions only: reserved-but-not-open peers are invisible.
    if media_bridge.WebSceneMediaEsPoolSlotFindPeer("127.0.0.1", 39301) != -1:
        return fail("FindPeer returned a slot for a reserved-but-not-open peer")
    if media_bridge.WebSceneMediaEsPoolSlotFindPeer("192.0.2.1", 39000) != -1:
        return fail("FindPeer returned a slot for a peer that was never acquired")
    os.WriteLine(os.Get_stdout(), "step7_find_peer_open_only_ok")

    os.WriteLine(os.Get_stdout(), "POOL_BOOKKEEPING_OK")
    return 0
