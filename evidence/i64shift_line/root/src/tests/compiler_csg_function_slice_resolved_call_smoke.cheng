import std/os
import std/strings
import std/strutils as strutil
import cheng/core/backend/system_link_plan as slplan
import cheng/core/lang/intern as langintern
import cheng/core/lang/parser
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/tooling/compiler_request as creq
import cheng/core/tooling/path as chengpath

fn main(): int32 =
    let root = os.GetCurrentDir()
    let sourcePath = chengpath.PathAbsolute(root,
                                            "src/tests/result_request_dispatch_fixture.cheng")
    let outputPath = "/tmp/compiler_csg_function_slice_resolved_call_smoke.o"
    let requestBase = creq.CompilerRequestNew(root,
                                              sourcePath,
                                              outputPath,
                                              "arm64-apple-darwin",
                                              creq.EmitObj,
                                              "")
    let request = creq.CompilerRequestWithExportRootSymbols(requestBase,
                                                            ["BackendDriverDispatchMinRunSystemLinkExecWithRequest"])
    var plan: slplan.SystemLinkPlanStub
    var planErr: str
    assert(slplan.BuildSystemLinkPlanStub(root, request, plan, planErr),
           strutil.Join([" compiler csg function slice: plan ", planErr], ""))
    let sourceBundle = slplan.SystemLinkPlanSourceBundleCid(plan)
    assert(IsOk(sourceBundle), " compiler csg function slice: source bundle")
    var csg: ccsg.CompilerCsg
    var csgErr: str
    assert(ccsg.BuildCompilerCsgInto(plan, Value(sourceBundle), csg, csgErr),
           strutil.Join([" compiler csg function slice: build ", csgErr], ""))
    var targetRowCount: int32
    var unsupportedCount: int32
    var concreteCount: int32
    for rowIndex in 0..<csg.semanticGraph.resolvedCallTable.sourcePathIds.len:
        let rowSourceRes: Result[str] = langintern.LookupIntern(csg.semanticGraph.resolvedCallTable.internPool,
                                                               csg.semanticGraph.resolvedCallTable.sourcePathIds[rowIndex])
        let targetRes: Result[str] = langintern.LookupIntern(csg.semanticGraph.resolvedCallTable.internPool,
                                                            csg.semanticGraph.resolvedCallTable.callTargetIds[rowIndex])
        let argsRes: Result[str] = langintern.LookupIntern(csg.semanticGraph.resolvedCallTable.internPool,
                                                          csg.semanticGraph.resolvedCallTable.callArgsTextIds[rowIndex])
        assert(IsOk(rowSourceRes) && IsOk(targetRes) && IsOk(argsRes),
               " compiler csg function slice: snapshot intern lookup")
        if parser.ParserNormalizePath(Value(rowSourceRes)) != parser.ParserNormalizePath(sourcePath):
            continue
        targetRowCount = targetRowCount + 1
        if Value(targetRes) == "BackendDriverDispatchMinUnsupported":
            unsupportedCount = unsupportedCount + 1
        elif Value(targetRes) == "BackendDriverDispatchMinRunSystemLinkExecConcreteRequest":
            concreteCount = concreteCount + 1
    assert(targetRowCount == 2 && unsupportedCount == 1 && concreteCount == 1,
           " compiler csg function slice: resolved calls canonical")
    assert(csg.semanticGraph.exprSliceFunctionBoundCount == 3,
           " compiler csg function slice: canonical reachable closure")
    let resultSourcePath = chengpath.PathAbsolute(root, "src/std/result.cheng")
    var reachableResultHelperCount: int32
    for functionIndex in 0..<csg.semanticGraph.reachableFunctionTable.functionNames.len:
        if functionIndex < csg.semanticGraph.reachableFunctionTable.sourcePaths.len &&
           functionIndex < csg.semanticGraph.reachableFunctionTable.reachable.len:
            if parser.ParserNormalizePath(csg.semanticGraph.reachableFunctionTable.sourcePaths[functionIndex]) ==
               parser.ParserNormalizePath(resultSourcePath):
                let functionName = csg.semanticGraph.reachableFunctionTable.functionNames[functionIndex]
                if csg.semanticGraph.reachableFunctionTable.reachable[functionIndex] &&
                   (functionName == "Error" || functionName == "ErrorMessage"):
                    reachableResultHelperCount = reachableResultHelperCount + 1
    assert(reachableResultHelperCount == 0,
           " compiler csg function slice: result intrinsics are not runtime call edges")
    var seenSliceFunctions: bool[]
    for functionIndex in 0..<csg.semanticGraph.reachableFunctionTable.functionNames.len:
        add(seenSliceFunctions, false)
    for sliceIndex in 0..<csg.semanticGraph.exprSliceTable.functionIndex.len:
        let functionIndex = csg.semanticGraph.exprSliceTable.functionIndex[sliceIndex]
        if functionIndex >= 0:
            assert(functionIndex < seenSliceFunctions.len && !seenSliceFunctions[functionIndex],
                   " compiler csg function slice: duplicate function slice")
            seenSliceFunctions[functionIndex] = true
    assert(csg.semanticGraph.exprSliceTypedFactComplete &&
           csg.semanticGraph.typedFactTable.sourceIndexes.len == csg.typedExprFactCountSnapshot,
           " compiler csg function slice: final expr/fact coverage")
    assert(csg.semanticGraph.exprSliceMaxTypedFactCount > 0 &&
           csg.semanticGraph.exprSliceMaxTypedFactCount <= csg.typedExprFactCountSnapshot,
           " compiler csg function slice: per-function fact peak bounded by total facts")
    assert(csg.typedFactsReleasedBeforeTypedIr &&
           csg.typedIrRoundFactsMaxCount > 0 &&
           csg.typedIrRoundFactsReleaseCount == 1 &&
           csg.typedIrRoundFactsResetCount == csg.typedIrRoundCount,
           " compiler csg function slice: bounded local facts lifecycle")
    assert(csg.typedIrNewFunctionCount == csg.typedIr.functions2_functionNameIds.len,
           " compiler csg function slice: fixed point processed every typed ir function once")
    echo(Fmt"resolved_target_row_count={strings.IntToStr(targetRowCount)}")
    echo(" compiler_csg_function_slice_resolved_call_smoke ok")
    return 0
