import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/csg_core/compiler_snapshot_schema as schema

fn TestCid(label: str): layout.FixedBytes32 =
    var bytes = layout.ByteBufInit(label.len)
    for index in 0..<label.len:
        layout.ByteBufAppendByte(bytes, Int32(label[index]) & 255)
    let out = hash256.Sha256Fixed(layout.ByteBufView(bytes))
    layout.ByteBufFree(bytes)
    return out

fn ExplicitModuleTables(): schema.CsgCompilerSnapshotTables =
    var out: schema.CsgCompilerSnapshotTables
    out.texts = ["pkg/main", "main"]
    out.sources.documentCids = [TestCid("document/pkg/main")]
    out.sources.modulePathTextIds = [0]

    out.spans.sourceIds = [0, 0]
    out.spans.startBytes = [0, 7]
    out.spans.endBytes = [11, 11]
    out.spans.startLines = [0, 0]
    out.spans.startColumns = [0, 7]
    out.spans.endLines = [0, 0]
    out.spans.endColumns = [11, 11]

    out.tokens.sourceIds = [0]
    out.tokens.sourceLocalRows = [0]
    out.tokens.lexicalParentTokenIds = [-1]
    out.tokens.spanIds = [1]
    out.tokens.kinds = [1]
    out.tokens.valueTextIds = [1]

    out.parserSidecars.declarationProducerSourceIds = [0]
    out.parserSidecars.declarationKinds = [1]
    out.parserSidecars.declarationNameTokenIds = [0]
    out.parserSidecars.declarationSpanIds = [0]
    out.parserSidecars.declarationNameSpanIds = [1]

    out.symbols.symbolCids = [TestCid("symbol/pkg/main")]
    out.symbols.sourceIds = [0]
    out.symbols.nameTextIds = [1]
    out.symbols.nameSpanIds = [1]
    out.symbols.nameTokenIds = [0]
    out.symbols.qualifiedNameTextIds = [0]
    out.symbols.symbolKinds = [schema.CsgCompilerSymbolModule]
    out.symbols.declarationSpanIds = [0]
    return out

fn main() =
    var err: str
    var withHeader = ExplicitModuleTables()
    assert(schema.CsgCompilerSymbolSourceCoordinateAuthorityStrictValidateInto(
               withHeader, 0, err), err)

    var removedHeaderCoordinate =
        schema.CsgCompilerSnapshotTablesClone(withHeader)
    removedHeaderCoordinate.symbols.nameSpanIds[0] = -1
    removedHeaderCoordinate.symbols.nameTokenIds[0] = -1
    removedHeaderCoordinate.symbols.declarationSpanIds[0] = -1
    assert(!schema.CsgCompilerSymbolSourceCoordinateAuthorityStrictValidateInto(
               removedHeaderCoordinate, 0, err),
           "module coordinate smoke: explicit header lost its token authority")

    var wrongHeaderToken = schema.CsgCompilerSnapshotTablesClone(withHeader)
    wrongHeaderToken.tokens.valueTextIds[0] = 0
    assert(!schema.CsgCompilerSymbolSourceCoordinateAuthorityStrictValidateInto(
               wrongHeaderToken, 0, err),
           "module coordinate smoke: wrong header token was accepted")

    var implicitModule = schema.CsgCompilerSnapshotTablesClone(withHeader)
    implicitModule.parserSidecars.declarationProducerSourceIds = []
    implicitModule.parserSidecars.declarationKinds = []
    implicitModule.parserSidecars.declarationNameTokenIds = []
    implicitModule.parserSidecars.declarationSpanIds = []
    implicitModule.parserSidecars.declarationNameSpanIds = []
    implicitModule.symbols.nameTextIds[0] = 0
    implicitModule.symbols.nameSpanIds[0] = -1
    implicitModule.symbols.nameTokenIds[0] = -1
    implicitModule.symbols.declarationSpanIds[0] = -1
    assert(schema.CsgCompilerSymbolSourceCoordinateAuthorityStrictValidateInto(
               implicitModule, 0, err), err)

    var fabricatedImplicitCoordinate =
        schema.CsgCompilerSnapshotTablesClone(implicitModule)
    fabricatedImplicitCoordinate.symbols.nameSpanIds[0] = 0
    fabricatedImplicitCoordinate.symbols.nameTokenIds[0] = 0
    fabricatedImplicitCoordinate.symbols.declarationSpanIds[0] = 0
    assert(!schema.CsgCompilerSymbolSourceCoordinateAuthorityStrictValidateInto(
               fabricatedImplicitCoordinate, 0, err),
           "module coordinate smoke: implicit module fabricated a span")

    var wrongQualifiedPath =
        schema.CsgCompilerSnapshotTablesClone(implicitModule)
    wrongQualifiedPath.symbols.qualifiedNameTextIds[0] = 1
    assert(!schema.CsgCompilerSymbolSourceCoordinateAuthorityStrictValidateInto(
               wrongQualifiedPath, 0, err),
           "module coordinate smoke: module path identity drift was accepted")

    var duplicateHeader = schema.CsgCompilerSnapshotTablesClone(withHeader)
    duplicateHeader.parserSidecars.declarationProducerSourceIds = [0, 0]
    duplicateHeader.parserSidecars.declarationKinds = [1, 1]
    duplicateHeader.parserSidecars.declarationNameTokenIds = [0, 0]
    duplicateHeader.parserSidecars.declarationSpanIds = [0, 0]
    duplicateHeader.parserSidecars.declarationNameSpanIds = [1, 1]
    assert(!schema.CsgCompilerSymbolSourceCoordinateAuthorityStrictValidateInto(
               duplicateHeader, 0, err),
           "module coordinate smoke: duplicate module authority was accepted")

    var missingProducerColumn =
        schema.CsgCompilerSnapshotTablesClone(withHeader)
    missingProducerColumn.parserSidecars.declarationProducerSourceIds = []
    assert(!schema.CsgCompilerSymbolSourceCoordinateAuthorityStrictValidateInto(
               missingProducerColumn, 0, err),
           "module coordinate smoke: missing producer column became implicit")

    var truncatedSpanColumn =
        schema.CsgCompilerSnapshotTablesClone(withHeader)
    truncatedSpanColumn.spans.endBytes = []
    assert(!schema.CsgCompilerSymbolSourceCoordinateAuthorityStrictValidateInto(
               truncatedSpanColumn, 0, err),
           "module coordinate smoke: truncated span column was accepted")
    echo("csg_compiler_module_symbol_coordinate_smoke: ok")

main()
