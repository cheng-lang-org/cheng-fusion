import cheng/std/bytes_layout as layout

type PlainReadSet =
    targetPortableKeyCids: layout.FixedBytes32[]

type PlainTables =
    readSet: PlainReadSet

fn plainCidLess(
        left: layout.FixedBytes32,
        right: layout.FixedBytes32): bool =
    return left.data[0] < right.data[0]

fn canonicalize(tables: var PlainTables) =
    let count = tables.readSet.targetPortableKeyCids.len
    for offset in 1..<count:
        let key = tables.readSet.targetPortableKeyCids[offset]
        var cursor = offset
        while cursor > 0:
            let previous = cursor - 1
            let previousKey =
                tables.readSet.targetPortableKeyCids[previous]
            if plainCidLess(previousKey, key):
                break
            tables.readSet.targetPortableKeyCids[cursor] = previousKey
            cursor = previous
        tables.readSet.targetPortableKeyCids[cursor] = key

fn main(): int32 =
    var high = layout.FixedBytes32()
    high.data[0] = 29
    var low = layout.FixedBytes32()
    low.data[0] = 7
    var tables = PlainTables(
        readSet: PlainReadSet(
            targetPortableKeyCids: [high, low]))
    canonicalize(tables)
    if tables.readSet.targetPortableKeyCids[0].data[0] != 7 ||
       tables.readSet.targetPortableKeyCids[1].data[0] != 29:
        return 1
    return 0
