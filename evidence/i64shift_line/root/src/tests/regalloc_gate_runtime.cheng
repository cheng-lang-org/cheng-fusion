type
    RegallocGateNode = ref object
        value: int32

    # Twenty-four bytes forces Darwin arm64 indirect aggregate return through x8.
    RegallocGateWideAggregate =
        a: int32
        b: int32
        c: int32
        d: int32
        e: int32
        f: int32

@importc("regalloc_gate_external_clobber")
fn regallocGateExternalClobber(value: int32): int32

fn regallocGateClobber8(a: int32,
                        b: int32,
                        c: int32,
                        d: int32,
                        e: int32,
                        f: int32,
                        g: int32,
                        h: int32): int32 =
    return a + b * 2 + c * 3 + d * 4 +
           e * 5 + f * 6 + g * 7 + h * 8

fn regallocGateStackArgs10(a: int32,
                           b: int32,
                           c: int32,
                           d: int32,
                           e: int32,
                           f: int32,
                           g: int32,
                           h: int32,
                           i: int32,
                           j: int32): int32 =
    return a + b * 2 + c * 3 + d * 4 + e * 5 +
           f * 6 + g * 7 + h * 8 + i * 9 + j * 10

fn regallocGateStackArgsRoundTrip(seed: int32): int32 =
    return regallocGateStackArgs10(
        seed + 1, seed + 2, seed + 3, seed + 4, seed + 5,
        seed + 6, seed + 7, seed + 8, seed + 9, seed + 10)

# The eight scalar values stay live across both new(RegallocGateNode), which
# lowers through heap allocation, and the following ordinary call.
fn regallocGateCrossHeapAndCall(seed: int32): int32 =
    let v0 = seed + 11
    let v1 = seed + 13
    let v2 = seed + 17
    let v3 = seed + 19
    let v4 = seed + 23
    let v5 = seed + 29
    let v6 = seed + 31
    let v7 = seed + 37
    var node: RegallocGateNode = new(RegallocGateNode)
    node.value = seed * 3 + 5
    let callPart = regallocGateClobber8(v0, v1, v2, v3, v4, v5, v6, v7)
    return callPart + v0 + v1 + v2 + v3 + v4 + v5 + v6 + v7 + node.value

# Eighteen simultaneously live values exceed the intended caller-saved pool.
# The executable result makes a missing spill/reload immediately observable.
fn regallocGatePressure(seed: int32): int32 =
    let p0 = seed
    let p1 = seed + 1
    let p2 = seed + 2
    let p3 = seed + 3
    let p4 = seed + 4
    let p5 = seed + 5
    let p6 = seed + 6
    let p7 = seed + 7
    let p8 = seed + 8
    let p9 = seed + 9
    let p10 = seed + 10
    let p11 = seed + 11
    let p12 = seed + 12
    let p13 = seed + 13
    let p14 = seed + 14
    let p15 = seed + 15
    let p16 = seed + 16
    let p17 = seed + 17
    let callPart = regallocGateClobber8(p0, p1, p2, p3, p4, p5, p6, p7)
    return callPart + p0 + p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8 +
           p9 + p10 + p11 + p12 + p13 + p14 + p15 + p16 + p17

fn regallocGateCallerSavedClobber(seed: int32): int32 =
    let q0 = seed + 2
    let q1 = seed + 3
    let q2 = seed + 5
    let q3 = seed + 7
    let q4 = seed + 11
    let q5 = seed + 13
    let q6 = seed + 17
    let q7 = seed + 19
    let callPart = regallocGateExternalClobber(seed)
    return callPart + q0 + q1 + q2 + q3 + q4 + q5 + q6 + q7

fn regallocGateLoopBranchPhi(seed: int32): int32 =
    var accumulator = seed
    for i in 0..<100:
        if i % 2 == 0:
            accumulator = accumulator + i
        else:
            accumulator = accumulator - i
    return accumulator

fn regallocGateParallelCopyCritical(seed: int32): int32 =
    var a = seed + 1
    var b = seed + 2
    var c = seed + 3
    var d = seed + 5
    for i in 0..<37:
        # The backedge rotates three simultaneously live values. The following
        # independent branch gives the join both a branch source and two preds.
        if (i & 1) == 0:
            let nextA = b
            let nextB = c
            let nextC = a
            a = nextA
            b = nextB
            c = nextC
        elif i % 3 == 0:
            a = a + d
            b = b - seed
            c = c + i
        else:
            d = d + (a & 3)
        if i % 5 == 0:
            let oldA = a
            a = c
            c = b
            b = oldA
    return a * 3 + b * 5 + c * 7 + d * 11

fn regallocGateMakeWideAggregate(seed: int32): RegallocGateWideAggregate =
    var out: RegallocGateWideAggregate
    out.a = seed + 2
    out.b = seed + 4
    out.c = seed + 8
    out.d = seed + 10
    out.e = seed + 16
    out.f = seed + 20
    return out

fn regallocGateConsumeWideAggregate(value: RegallocGateWideAggregate): int32 =
    return value.a + value.b * 2 + value.c * 3 + value.d * 4 +
           value.e * 5 + value.f * 6

fn regallocGateByAddressAcrossClobber(value: var RegallocGateWideAggregate,
                                      seed: int32): int32 =
    let addressLive = value.b * 2 + value.c * 3 + value.e * 5
    let clobbered = regallocGateExternalClobber(seed)
    value.a = value.a + clobbered
    value.f = value.f + addressLive
    return value.a + value.f + addressLive

fn regallocGateWideAggregateRoundTrip(seed: int32): int32 =
    var aggregate = regallocGateMakeWideAggregate(seed)
    let before = regallocGateConsumeWideAggregate(aggregate)
    let mutation = regallocGateByAddressAcrossClobber(aggregate, seed)
    let after = regallocGateConsumeWideAggregate(aggregate)
    return before + mutation + after

fn regallocGateDynamicSeqIndexed(values: var int32[],
                                 index: int32): int32 =
    let before = values[index]
    values[index] = before + index * 10
    return before * 100 + values[index] * 3 + values[1]
