import cheng/core/backend2/backend2_types as b2t
import cheng/core/backend2/backend2_cid as b2cid
import std/rawbytes as rawbytes

const
    LargePayloadBytes: int32 = 4194304

fn main(): int32 =
    var payloadBytes = rawbytes.BytesAlloc(LargePayloadBytes)
    if payloadBytes.data == nil || payloadBytes.len != LargePayloadBytes:
        rawbytes.BytesFree(payloadBytes)
        return 1
    for index in 0..<LargePayloadBytes:
        rawbytes.BytesSet(payloadBytes, index, 97 + (index & 15))
    var fragment: b2t.FunctionFragment
    fragment.functionSymbol = "backend2_large_fragment"
    fragment.funcEmitCid =
        "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
    fragment.bodyIrPayload = rawbytes.BytesToString(payloadBytes)
    rawbytes.BytesFree(payloadBytes)
    if len(fragment.bodyIrPayload) != LargePayloadBytes:
        return 2
    let expected = b2cid.Backend2ContentCidOfFragment(fragment)
    if len(expected) != 64:
        return 3
    for _ in 0..<16:
        if b2cid.Backend2ContentCidOfFragment(fragment) != expected ||
           len(fragment.bodyIrPayload) != LargePayloadBytes:
            return 4
    fragment.funcEmitCid =
        "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
    if b2cid.Backend2ContentCidOfFragment(fragment) != expected:
        return 5
    echo("BACKEND2_LARGE_FRAGMENT_BORROW_OK")
    return 0

main()
