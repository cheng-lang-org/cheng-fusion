import std/os as os
import std/strings
import std/json
import cheng/core/csg_core/json_field as field

fn main(): int32 =
    let line = strings.ConcatStr(
        "{\"complete\":\"1\",\"csgc_byte_count\":\"64\",\"id\":\"manifest\",",
        strings.ConcatStr(
            "\"profile_set_cid\":\"sha256:aaa\",\"profiles\":[\"csg_core\"],",
            "\"standard\":\"csg_core::v1\"}"))
    let raw =
        field.CsgCoreJsonTopRawField(line, "profiles")
    if !raw.found:
        os.WriteLine(os.Get_stderr(), "raw missing")
        return 1
    let parsed = json.ParseJsonSafe(raw.value)
    if !parsed.success ||
       parsed.value.kind != json.JArray:
        os.WriteLine(os.Get_stderr(), "parse failed")
        return 1
    var profiles: str[]
    for i in 0..<parsed.value.a.len:
        add(
            profiles,
            strings.CloneStr(parsed.value.a[i].s))
    if profiles.len != 1 || profiles[0] != "csg_core":
        os.WriteLine(os.Get_stderr(), "profiles mismatch")
        return 1
    os.WriteLine(os.Get_stdout(), "probe4 ok")
    return 0
