type
    R21EntryB =
        profileIndex: int32
        items: str[]

fn R21AppendB(out: var str[], name: str) =
    add(out, name)

fn R21NamesB(cache: var R21EntryB[], profileIndex: int32): str[] =
    var out: str[]
    if profileIndex < 0:
        return out
    R21AppendB(out, "alpha")
    var entry: R21EntryB
    entry.profileIndex = profileIndex
    entry.items = share(out)
    add(cache, entry)
    return out

fn main(): int32 =
    var cache: R21EntryB[]
    let names = R21NamesB(cache, 0)
    if names.len != 1:
        return 10
    echo("r21 b ok")
    return 0
