type
    ArrowPoint =
        x: int32
        y: int32
        tag: int64

@exportc("arrow_read_px")
fn ArrowReadPx(p: ArrowPoint*): int32 =
    return p->x

@exportc("arrow_read_py")
fn ArrowReadPy(p: ArrowPoint*): int32 =
    return p->y

@exportc("arrow_read_tag")
fn ArrowReadTag(p: ArrowPoint*): int64 =
    return p->tag

@exportc("arrow_seq_len")
fn ArrowSeqLen(s: int32[]*): int32 =
    return s->len

@exportc("arrow_seq_cap")
fn ArrowSeqCap(s: int32[]*): int32 =
    return s->cap
