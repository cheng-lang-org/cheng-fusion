import std/os
import std/strings
import std/strutils as strutil
import cheng/core/tooling/host_ops as hostops
import cheng/core/tooling/path as chengpath

fn LinkerlessReportArg(prefix: str, value: str): str =
    return strutil.Join([prefix, value], "")

fn LinkerlessReportFail(message: str): int32 =
    echo(strutil.Join(["linkerless_report_fields_smoke FAIL: ", message], ""))
    return 1

fn LinkerlessReportBoolText(value: bool): str =
    if value:
        return "1"
    return "0"

fn LinkerlessReportBlocker(outDir: str,
                           driver: str,
                           outBin: str,
                           reportPath: str,
                           compileLog: str,
                           compileExitCode: int32,
                           blockerId: str,
                           reason: str): int32 =
    let blockerPath = os.JoinPath(outDir, "linkerless_report_fields_smoke.blocker.txt")
    let mapPath = strutil.Join([outBin, ".map"], "")
    let blockerText = strutil.Join([
        "linkerless_report_fields_smoke=blocked\n",
        "blocker_id=", blockerId, "\n",
        "driver=", driver, "\n",
        "compile_report=", reportPath, "\n",
        "compile_log=", compileLog, "\n",
        "compile_exit_code=", strings.IntToStr(compileExitCode), "\n",
        "artifact=", outBin, "\n",
        "artifact_exists=", LinkerlessReportBoolText(chengpath.FileExistsNonEmpty("", outBin)), "\n",
        "map=", mapPath, "\n",
        "map_exists=", LinkerlessReportBoolText(chengpath.FileExistsNonEmpty("", mapPath)), "\n",
        "report_exists=", LinkerlessReportBoolText(chengpath.FileExistsNonEmpty("", reportPath)), "\n",
        "rss_guard_bytes=8589934592\n",
        "expected_full_backend_codegen=1\n",
        "expected_cold_system_link_exec=0\n",
        "reason=", reason, "\n"
    ], "")
    let _written = chengpath.WriteTextFile("", blockerPath, blockerText)
    echo(strutil.Join(["linkerless_report_fields_smoke BLOCKED: ", blockerId, ": ", reason], ""))
    return 2

fn LinkerlessReportContains(reportText: str,
                            needle: str,
                            message: str): int32 =
    if strings.StrContains(reportText, needle):
        return 0
    return LinkerlessReportFail(message)

fn LinkerlessReportFullBackendReady(reportText: str): bool =
    if !strings.StrContains(reportText, "full_backend_codegen=1"):
        return false
    if strings.StrContains(reportText, "full_backend_codegen=0"):
        return false
    if strings.StrContains(reportText, "cold_system_link_exec=1"):
        return false
    if strings.StrContains(reportText, "compiler_class=cold_bootstrap"):
        return false
    if strings.StrContains(reportText, "candidate_kind=cold_subset_backend"):
        return false
    if strings.StrContains(reportText, "backend_driver_candidate=cold_subset_backend"):
        return false
    if strings.StrContains(reportText, "system_link_exec_scope=cold_subset_direct_macho"):
        return false
    if strings.StrContains(reportText, "system_link_exec_scope=cold_subset_direct_elf"):
        return false
    return true

fn LinkerlessReportResolveDriver(root: str): str =
    var driver = os.JoinPath(root, "artifacts/backend_driver/cheng")
    let explicitDriver = strutil.Strip(os.GetEnv("CHENG_SMOKE_COMPILER"))
    if len(explicitDriver) > 0:
        driver = chengpath.PathAbsolute(root, explicitDriver)
    return driver

fn main(): int32 =
    let root = os.GetCurrentDir()
    let driver = LinkerlessReportResolveDriver(root)
    let source = os.JoinPath(root, "src/tests/ordinary_zero_exit_fixture.cheng")
    let outDir = chengpath.PathAbsolute(root, "artifacts/linkerless_report_fields_smoke")
    let outBin = os.JoinPath(outDir, "ordinary_zero_exit_fixture")
    let reportPath = os.JoinPath(outDir, "ordinary_zero_exit_fixture.report.txt")
    let compileLog = os.JoinPath(outDir, "ordinary_zero_exit_fixture.compile.log")
    let runLog = os.JoinPath(outDir, "ordinary_zero_exit_fixture.run.log")
    if !chengpath.MkdirP(root, outDir):
        return LinkerlessReportFail("mkdir")
    if !chengpath.FileExistsNonEmpty(root, driver):
        return LinkerlessReportFail(strutil.Join(["driver missing: ", driver], ""))
    if chengpath.PathFileExists(outBin):
        os.RemoveFile(outBin)
    if chengpath.PathFileExists(reportPath):
        os.RemoveFile(reportPath)
    if chengpath.PathFileExists(compileLog):
        os.RemoveFile(compileLog)
    if chengpath.PathFileExists(runLog):
        os.RemoveFile(runLog)
    let blockerPath = os.JoinPath(outDir, "linkerless_report_fields_smoke.blocker.txt")
    if chengpath.PathFileExists(blockerPath):
        os.RemoveFile(blockerPath)

    let compileRun = hostops.RunFileLogged(root,
                                           "linkerless_report_fields_build",
                                           driver,
                                           [
                                               "system-link-exec",
                                               LinkerlessReportArg("--root:", root),
                                               LinkerlessReportArg("--in:", source),
                                               "--emit:exe",
                                               "--target:arm64-apple-darwin",
                                               LinkerlessReportArg("--out:", outBin),
                                               LinkerlessReportArg("--report-out:", reportPath)
                                           ],
                                           [
                                               "BACKEND_INCREMENTAL=0",
                                               "BACKEND_MULTI_MODULE_CACHE=0",
                                               "CHENG_DISABLE_PRIMARY_OBJECT_CACHE=1",
                                               "CHENG_PROCESS_MAX_RSS_BYTES=8589934592"
                                           ],
                                           root,
                                           120,
                                           compileLog)
    if compileRun.exitCode != 0:
        if chengpath.FileExistsNonEmpty(root, reportPath):
            let failedReportText = chengpath.ReadTextFile(root, reportPath)
            if !LinkerlessReportFullBackendReady(failedReportText):
                return LinkerlessReportBlocker(outDir,
                                               driver,
                                               outBin,
                                               reportPath,
                                               compileLog,
                                               compileRun.exitCode,
                                               "stale_or_cold_subset_backend_driver_artifact",
                                               "compile report is not full backend codegen")
        return LinkerlessReportFail("compile rc")
    if !chengpath.FileExistsNonEmpty(root, outBin):
        return LinkerlessReportFail("output exists")
    if !chengpath.FileExistsNonEmpty(root, reportPath):
        return LinkerlessReportFail("report exists")
    let reportText = chengpath.ReadTextFile(root, reportPath)
    if !LinkerlessReportFullBackendReady(reportText):
        return LinkerlessReportBlocker(outDir,
                                       driver,
                                       outBin,
                                       reportPath,
                                       compileLog,
                                       compileRun.exitCode,
                                       "stale_or_cold_subset_backend_driver_artifact",
                                       "compile report is not full backend codegen")
    if LinkerlessReportContains(reportText, "system_link_exec=1", "system-link-exec marker") != 0:
        return 1
    if LinkerlessReportContains(reportText, "real_backend_codegen=1", "real backend marker") != 0:
        return 1
    if LinkerlessReportContains(reportText, "linkerless_image=1", "linkerless image") != 0:
        return 1
    if LinkerlessReportContains(reportText, "system_link=0", "no system linker") != 0:
        return 1
    if LinkerlessReportContains(reportText, "unresolved_symbol_count=0", "no unresolved symbols") != 0:
        return 1
    if LinkerlessReportContains(reportText, "exec_retained_payload_approx_bytes=", "exec retained payload bytes") != 0:
        return 1
    if LinkerlessReportContains(reportText, "compiler_csg_rss_bytes=", "csg rss") != 0:
        return 1
    if LinkerlessReportContains(reportText, "compiler_csg_logical_payload_bytes=", "csg logical payload") != 0:
        return 1
    if LinkerlessReportContains(reportText, "compiler_csg_rss_gap_bytes=", "csg rss gap") != 0:
        return 1
    if LinkerlessReportContains(reportText, "lowering_retained_payload_item_count=", "lowering retained payload") != 0:
        return 1
    if LinkerlessReportContains(reportText, "lowering_structured_live_bytes=", "lowering structured") != 0:
        return 1
    if LinkerlessReportContains(reportText, "primary_object_retained_body_ir_payload_item_count=", "primary body ir retained payload") != 0:
        return 1
    if LinkerlessReportContains(reportText, "primary_object_retained_compact_item_count=", "primary compact retained payload") != 0:
        return 1
    if LinkerlessReportContains(reportText, "body_ir_structured_live_bytes=", "body ir structured") != 0:
        return 1
    if LinkerlessReportContains(reportText, "primary_object_structured_live_bytes=", "primary object structured") != 0:
        return 1
    if LinkerlessReportContains(reportText, "primary_object_body_ir_phase_arena_reset_count=", "body ir phase arena") != 0:
        return 1
    if LinkerlessReportContains(reportText, "phase_memory_ledger_schema=phase_delta_ledger", "phase ledger schema") != 0:
        return 1
    if LinkerlessReportContains(reportText, "phase_memory_ledger_phase_count=5", "phase ledger count") != 0:
        return 1
    if LinkerlessReportContains(reportText, "phase_memory_ledger_source_closure_rss_before_bytes=", "source closure rss before") != 0:
        return 1
    if LinkerlessReportContains(reportText, "phase_memory_ledger_compiler_csg_structured_delta_bytes=", "csg structured delta") != 0:
        return 1
    if LinkerlessReportContains(reportText, "phase_memory_ledger_lowering_plan_unstructured_gap_after_bytes=", "lowering gap after") != 0:
        return 1
    if LinkerlessReportContains(reportText, "phase_memory_ledger_primary_object_plan_rss_delta_bytes=", "primary rss delta") != 0:
        return 1
    if LinkerlessReportContains(reportText, "phase_memory_ledger_report_payload_assembly_structured_after_bytes=", "report assembly structured") != 0:
        return 1
    if LinkerlessReportContains(reportText, "phase_memory_ledger_compiler_csg_top_contributor_0_kind=", "csg top contributor") != 0:
        return 1
    if LinkerlessReportContains(reportText, "phase_memory_ledger_primary_object_plan_top_contributor_0_kind=", "primary top contributor") != 0:
        return 1

    let run = hostops.RunFileLogged(root,
                                    "linkerless_report_fields_run",
                                    outBin,
                                    [],
                                    [],
                                    root,
                                    30,
                                    runLog)
    if run.exitCode != 0:
        return LinkerlessReportFail("run rc")
    echo(" linkerless_report_fields_smoke ok")
    return 0
