# or5: ORC registry_miss 最小触发档位定位 repro (BfsApplyFile 族)
# 背景: rwad_bridge_fs.BfsApplyFile 大函数在 ReadFileBytesResult 对不存在路径
#       返回 Err 后以 return Err[bool](rRes.err.msg) 早退时, 运行期崩溃
#         cheng_orc_release_failure code=registry_miss
#         operation=normal_release detail=wrong_object_or_owner
#       小函数同模式 (orc_repro_smoke.Probe) 不崩。
# 方法: 四档递增复杂度, main 逐档调用, 每档调用完成即向 stderr 打
#       tier<N>:ok。进程若在某档内死亡, 其后行缺失即为该档触发; 若全部
#       tier 都打印而进程 rc!=0, 结论为退出期清理崩溃。
# 判读: 本文件是 bug 复现器, 允许最终 rc!=0; 各 missing 探针应返回 Err,
#       若意外返回 Ok 则打 tier<N>:BAD-OK-RESULT (断言失败, 与崩溃无关)。
#
# 实测定谳 (2026-09 stage3, 本文件四档全跑: 全 tier ok 后退出期崩 rc=1):
#   - 最小触发不是"大函数": 档位1 小函数单跑同样退出期崩; 真正毒源是
#     return Err[T](r.err.msg) 把 os.ReadFileBytesResult 的 err.msg str
#     跨 Result 搬进新载荷。对照: 同函数改 return Err[T]("literal") rc=0;
#     函数内直读 r.err.msg 不二次包装 rc=0。
#   - BfsApplyFile 今天不崩是因为 FileExists 前置守卫拦在
#     ReadFileBytesResult 之前; 对存在但 chmod 000 的文件调真
#     BfsApplyFile 绕开守卫即复现本崩 (rc=1)。
#   - 崩点在退出清理阶段: Err[bool](r.err.msg) 之后若再发生托管分配
#     (哪怕裸 BytesAlloc) 则 rc=0 掩盖; 但再来一次成功 ReadFileBytesResult
#     不掩盖。被搬运的 err.msg 读回内容已损坏 (打印为空白)。
#   - 附带症状: 传播后的 err.msg str 内容损坏 (应为 "os file open: ..."
#       实读为全空白), 与 teardown registry_miss 同源。

import std/system
import std/rawbytes
import std/result
import std/os
import cheng/std/bytes_layout as layout
import cheng/apps/rwad/rwad_settlement as ssm
import cheng/apps/rwad/rwad_bridge_fs as bfs

fn Tag(b: int32): layout.FixedBytes32 =
    var raw = BytesAlloc(32)
    BytesSet(raw, 0, b)
    let res = layout.FixedBytes32FromBytes(raw)
    return res.value

# 档位1: 小函数 ReadFileBytesResult Err 早退 (已知不崩, Probe 同型)
fn Tier1Probe(path: str): Result[bool] =
    let r = os.ReadFileBytesResult(path)
    if !r.ok:
        return Err[bool](r.err.msg)
    if r.value.len < 1:
        return Err[bool]("or5: empty")
    return Ok[bool](true)

# 档位2: 中等函数 — 3 个本地托管数组 (add 动态数组 x2 + BytesAlloc x1)
#        + 1 个 Result[Bytes] 对不存在路径 Err 早退
fn Tier2ThreeArrays(path: str): Result[bool] =
    var arrA: layout.FixedBytes32[]
    var arrB: int64[]
    var bufC = BytesAlloc(32)
    var i: int32
    while i < 4:
        add(arrA, Tag(i))
        add(arrB, Int64(i))
        BytesSet(bufC, i, i)
        i = i + 1
    if arrA.len != 4 or arrB.len != 4:
        return Err[bool]("or5: array bookkeeping broken")
    let r = os.ReadFileBytesResult(path)
    if !r.ok:
        return Err[bool](r.err.msg)
    if r.value.len < 1:
        return Err[bool]("or5: empty")
    return Ok[bool](true)

# 档位3: 档位2 全部构造 + var Bytes 从 Result.value move 出 + 字节循环拷贝
#        + 第二个 Result 调用 (对不存在路径 Err 早退)
fn Tier3MoveCopySecond(path: str, seedPath: str): Result[bool] =
    var arrA: layout.FixedBytes32[]
    var arrB: int64[]
    var bufC = BytesAlloc(32)
    var i: int32
    while i < 4:
        add(arrA, Tag(i))
        add(arrB, Int64(i))
        BytesSet(bufC, i, i)
        i = i + 1
    let first = os.ReadFileBytesResult(seedPath)
    if !first.ok:
        return Err[bool](first.err.msg)
    var src: Bytes = first.value
    var dst = BytesAlloc(src.len)
    var k: int32
    while k < src.len:
        BytesSet(dst, k, BytesGet(src, k))
        k = k + 1
    if dst.len != src.len:
        return Err[bool]("or5: copy length mismatch")
    let second = os.ReadFileBytesResult(path)
    if !second.ok:
        return Err[bool](second.err.msg)
    return Ok[bool](true)

fn main(): int32 =
    # tier3 需要一个真实存在的种子文件走成功读取支
    var seed = BytesAlloc(8)
    BytesSet(seed, 0, 111)
    BytesSet(seed, 1, 114)
    BytesSet(seed, 2, 53)
    let sw = os.WriteFileBytesResult("/tmp/or5_seed.bin", seed)
    if !sw.ok:
        os.WriteLine(os.Get_stderr(), "or5: seed write failed")
        return 2

    let t1 = Tier1Probe("/tmp/or5_missing.bin")
    if t1.ok:
        os.WriteLine(os.Get_stderr(), "tier1:BAD-OK-RESULT")
    os.WriteLine(os.Get_stderr(), "tier1:ok")

    let t2 = Tier2ThreeArrays("/tmp/or5_missing.bin")
    if t2.ok:
        os.WriteLine(os.Get_stderr(), "tier2:BAD-OK-RESULT")
    os.WriteLine(os.Get_stderr(), "tier2:ok")

    let t3 = Tier3MoveCopySecond("/tmp/or5_missing.bin", "/tmp/or5_seed.bin")
    if t3.ok:
        os.WriteLine(os.Get_stderr(), "tier3:BAD-OK-RESULT")
    os.WriteLine(os.Get_stderr(), "tier3:ok")

    # 档位4: 已知崩 — 真实 BfsApplyFile 大函数, 不存在路径
    var st = ssm.SsmInit()
    let t4 = bfs.BfsApplyFile(st, "/tmp/or5_missing.bin", Tag(90), Int64(100), Int64(10))
    if t4.ok:
        os.WriteLine(os.Get_stderr(), "tier4:BAD-OK-RESULT")
    os.WriteLine(os.Get_stderr(), "tier4:ok")

    os.WriteLine(os.Get_stderr(), "or5: all tiers returned; reaching here with rc!=0 means exit-phase cleanup crash")
    return 0
