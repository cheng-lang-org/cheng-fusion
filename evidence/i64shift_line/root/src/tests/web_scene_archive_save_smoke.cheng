import cheng/core/runtime/web_scene_runtime as scene

fn SmokeStrContains(haystack: str, needle: str): bool =
    if needle.len == 0:
        return true
    if haystack.len < needle.len:
        return false
    for i in 0..<(haystack.len - needle.len + 1):
        var matched = true
        for j in 0..<needle.len:
            if haystack[i + j] != needle[j]:
                matched = false
                break
        if matched:
            return true
    return false

fn WebSceneArchiveSaveSmoke(): int32 =
    var graph: scene.WebSceneGraph
    scene.WebSceneGraphInit(graph)
    if !scene.WebSceneSetStateValue(graph, "year", "1990"):
        return 9001
    if !scene.WebSceneSetStateValue(graph, "month", "1"):
        return 9002
    if !scene.WebSceneSetStateValue(graph, "day", "2"):
        return 9003
    if !scene.WebSceneSetStateValue(graph, "hour", "10"):
        return 9004
    if !scene.WebSceneSetStateValue(graph, "minute", "30"):
        return 9005
    if !scene.WebSceneSetStateValue(graph, "gender", "男"):
        return 9006
    let baziCalc = "bazi_calculate:result:activeDayunIdx:year:month:day:hour:minute:gender:timezone:longitude:useTrueSolarTime:lateZiBoundary:2026"
    if scene.WebSceneApplyEventEffectSegment(graph, baziCalc, false) != 1:
        return 9010
    let resultJson = scene.WebSceneStateValueForRef(graph, "result")
    if resultJson.len == 0:
        return 9011
    if !SmokeStrContains(resultJson, "\"input\""):
        return 9012
    if !SmokeStrContains(resultJson, "\"profile\""):
        return 9013

    # guard: empty result state -> no-op, no hint
    let guardSeg = "astrology_archive_save:bazi:archives:archiveHint:resultMissing:year:month:day:hour:minute:gender:timezone:longitude:useTrueSolarTime:lateZiBoundary:bindDidOnSave:didUser:2026"
    if scene.WebSceneApplyEventEffectSegment(graph, guardSeg, false) != 0:
        return 9020
    if scene.WebSceneStateValueForRef(graph, "archives").len != 0:
        return 9021
    if scene.WebSceneStateValueForRef(graph, "archiveHint").len != 0:
        return 9022

    # first save: no DID binding
    let saveSeg = "astrology_archive_save:bazi:archives:archiveHint:result:year:month:day:hour:minute:gender:timezone:longitude:useTrueSolarTime:lateZiBoundary:bindDidOnSave:didUser:2026"
    if scene.WebSceneApplyEventEffectSegment(graph, saveSeg, false) != 1:
        return 9030
    if scene.WebSceneStateValueForRef(graph, "archiveHint") != "已保存到本地档案":
        return 9031
    let archives1 = scene.WebSceneStateValueForRef(graph, "archives")
    var count1: int32
    if !scene.WebSceneJsonTopLevelArrayItemCount(archives1, count1):
        return 9032
    if count1 != 1:
        return 9033
    if !SmokeStrContains(archives1, "\"id\":\"astro_"):
        return 9034
    if !SmokeStrContains(archives1, "\"type\":\"bazi\""):
        return 9035
    if !SmokeStrContains(archives1, "\"title\":\"1990年1月2日 八字\""):
        return 9036
    if !SmokeStrContains(archives1, "\"dailyGuide\":{"):
        return 9037
    if !SmokeStrContains(archives1, "\"createdAt\":"):
        return 9038
    if SmokeStrContains(archives1, "\"didUser\""):
        return 9039

    # second save: DID binding on
    if !scene.WebSceneSetStateValue(graph, "bindDidOnSave", "true"):
        return 9040
    if !scene.WebSceneSetStateValue(graph, "didUser", "did:cheng:abc"):
        return 9041
    if scene.WebSceneApplyEventEffectSegment(graph, saveSeg, false) != 1:
        return 9042
    if scene.WebSceneStateValueForRef(graph, "archiveHint") != "已保存到本地档案，并绑定当前 DID 用户":
        return 9043
    let archives2 = scene.WebSceneStateValueForRef(graph, "archives")
    var count2: int32
    if !scene.WebSceneJsonTopLevelArrayItemCount(archives2, count2):
        return 9044
    if count2 != 2:
        return 9045
    if !SmokeStrContains(archives2, "\"didUser\":\"did:cheng:abc\""):
        return 9046
    # newest-first prepend: the DID-bound record must appear before the first record
    if !scene.WebSceneStrStartsWith(archives2, "[{\"id\":\"astro_"):
        return 9047

    # ziwei shape
    if !scene.WebSceneSetStateValue(graph, "shichen", "5"):
        return 9050
    if !scene.WebSceneSetStateValue(graph, "calendarType", "solar"):
        return 9051
    let ziweiCalc = "ziwei_calculate:ziweiResult:year:month:day:shichen:gender:calendarType:minute:timezone:longitude:useTrueSolarTime:lateZiBoundary"
    let ziweiCalcStatus = scene.WebSceneApplyEventEffectSegment(graph, ziweiCalc, false)
    if ziweiCalcStatus < 0:
        return 9052
    if scene.WebSceneStateValueForRef(graph, "ziweiResult").len == 0:
        return 9053
    let ziweiSave = "astrology_archive_save:ziwei:ziweiArchives:archiveHint:ziweiResult:year:month:day:shichen:minute:gender:calendarType:timezone:longitude:useTrueSolarTime:lateZiBoundary:bindDidOnSave:didUser"
    if scene.WebSceneApplyEventEffectSegment(graph, ziweiSave, false) != 1:
        return 9054
    let ziweiArchives = scene.WebSceneStateValueForRef(graph, "ziweiArchives")
    if !SmokeStrContains(ziweiArchives, "\"type\":\"ziwei\""):
        return 9055
    if !SmokeStrContains(ziweiArchives, "\"title\":\"阳历 1990年1月2日 紫微\""):
        return 9056

    # malformed effect: wrong kind must hard-fail
    if scene.WebSceneApplyEventEffectSegment(graph, "astrology_archive_save:tarot:a:b:c", false) != -1:
        return 9060
    return 0

fn main(): int32 =
    let status = WebSceneArchiveSaveSmoke()
    if status != 0:
        echo(Fmt"web_scene_archive_save_smoke FAILED code={status}")
        return 1
    echo("web_scene_archive_save_smoke OK")
    return 0
