type IdWrapC[T] = WrapC(ids: int32[]) | ScalarC(v: T)

fn main(): int32 =
    var xs: int32[]
    add(xs, 4)
    add(xs, 5)
    let e: IdWrapC[int32] = WrapC(xs)
    match e:
        WrapC(ids) =>
            if ids.len != 2:
                return 21
            return ids[0] + ids[1] - 9
        ScalarC(v) =>
            return v

main()
