type
    ColdExactUniqueBorrowBox =
        values: str[]

fn ColdExactUniqueBorrowSwap(values: var str[]) =
    let first = values[0]
    values[0] = values[1]
    values[1] = first

fn main(): int32 =
    var box = ColdExactUniqueBorrowBox()
    add(box.values, "right")
    add(box.values, "left")
    var view = box.values
    ColdExactUniqueBorrowSwap(view)
    if view.len != 2 ||
       view[0] != "left" ||
       view[1] != "right":
        return 11
    if box.values.len != 2 ||
       box.values[0] != "left" ||
       box.values[1] != "right":
        return 12
    return 0
