import std/cmdline as cmdline
import std/os as os
import std/os_host_process as hostos
import std/strutils as strutil
import cheng/core/lang/intern as langintern
import cheng/core/lang/typed_expr as texpr

fn AddLeaf(ir: var texpr.TypedExprIr): int32 =
    var node: texpr.TypedExprIrNode
    node.resultStructuralTypeId = -1
    node.sourcePath = "/fixture/arglink_edges.cheng"
    node.functionName = "Probe"
    node.lineNumber = 1
    node.opKind = texpr.TypedExprIrOpI32Const
    node.resultType = "int32"
    node.surfaceText = "7"
    node.literalText = "7"
    node.paramSlot = -1
    node.operand0NodeIndex = -1
    node.operand1NodeIndex = -1
    node.operand2NodeIndex = -1
    return texpr.TypedExprIrAddNode(ir, node)

fn AddLink(ir: var texpr.TypedExprIr,
           valueNode: int32,
           nextLink: int32): int32 =
    var node: texpr.TypedExprIrNode
    node.resultStructuralTypeId = -1
    node.sourcePath = "/fixture/arglink_edges.cheng"
    node.functionName = "Probe"
    node.lineNumber = 1
    node.opKind = texpr.TypedExprIrOpArgLink
    node.resultType = "int32"
    node.surfaceText = "7"
    node.paramSlot = -1
    node.operand0NodeIndex = valueNode
    node.operand1NodeIndex = nextLink
    node.operand2NodeIndex = -1
    return texpr.TypedExprIrAddNode(ir, node)

fn RunInvalid(mode: str) =
    var ir: texpr.TypedExprIr
    ir.internPool = langintern.InternPoolNew()
    let valueNode = AddLeaf(ir)
    if mode == "endpoint":
        let _ = AddLink(ir, valueNode, -2)
    elif mode == "self":
        let _ = AddLink(ir, valueNode, ir.nodes2_nodeIndexs.len)
    elif mode == "forward":
        let _ = AddLink(ir, valueNode, ir.nodes2_nodeIndexs.len + 1)
    else:
        panic("unknown invalid ArgLink mode")

fn RequireHardFail(mode: str) =
    let result = hostos.ExecFileCapture(cmdline.ParamStr(0),
                                         [mode],
                                         [],
                                         "",
                                         true,
                                         60)
    assert(os.ExecCmdResultExitCode(result) != 0 &&
           strutil.Contains(os.ExecCmdResultOutput(result),
                            "ArgLink next edge must be -1 or a prior node"),
           "invalid ArgLink edge must hard-fail")

fn main(): int32 =
    let mode = cmdline.ParamStr(1)
    if mode != "":
        RunInvalid(mode)
        return 90
    var ir: texpr.TypedExprIr
    ir.internPool = langintern.InternPoolNew()
    let valueNode = AddLeaf(ir)
    let linkNode = AddLink(ir, valueNode, -1)
    assert(linkNode == 1,
           "-1 is the only accepted ArgLink endpoint")
    RequireHardFail("endpoint")
    RequireHardFail("self")
    RequireHardFail("forward")
    texpr.TypedExprIrReleasePayload(ir)
    return 0
