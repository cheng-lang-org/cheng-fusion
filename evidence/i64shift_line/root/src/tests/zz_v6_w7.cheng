# v6_direct1_repro.cheng —— 纯烤链 call-arg 实参物化缺陷秒级复现（parser-oob b2 席 2026-08-30）
# 触发形：var ref 参数函数 outer(n: var Node) 内，先 1 次 var 字段槽直调，
# 再 1 次嵌套 @borrows 调用作为 var 实参。
# 正确语义：run=0（r=7, col.offset=8, arena.n=108）。
# 实测：stage3 与 cbase（C 链）双链 run=99 → r=-1（compute 收到错对象）。
# v5（无直调、仅嵌套单调用）双链绿 ⇒ 触发需「直调先于嵌套」的实参 staging 序。
type
    Col = object
        offset: int32
        cap: int32
        gen: int32

type
    Box = ref object
        n: int32

type
    Node = ref object
        arena: Box
        col: Col
        cnt: int32
        tag: int32

@borrows
fn compute(n: Node, k: int32): int32 =
    if n.cnt <= 0:
        return -1
    return n.cnt * k + n.tag

fn addCol(a: var Box, arr: var Col, v: int32): int32 =
    arr.offset = arr.offset + v
    a.n = a.n + v
    return v

fn outer(n: var Node, k: int32): int32 =
    addCol(n.arena, n.col, 1)
    let r1 = addCol(n.arena, n.col, compute(n, k))
    return r1

fn main(): int32 =
    var n: Node
    n = new(Node)
    n.arena = new(Box)
    n.arena.n = 100
    n.cnt = 3
    n.tag = 1
    let r = outer(n, 2)
    if r != 7:
        return 100 + r
    if n.col.offset != 8:
        return 200 + n.col.offset
    if n.arena.n != 108:
        return 300 + n.arena.n
    return 0
