fn genericElemSize[T](value: T): int32 =
    return elemSize[T]()

fn genericSizeof[T](value: T): int32 =
    return sizeof(T)

fn genericSeqLen[T](values: T[]): int32 =
    return values.len

fn main(): int32 =
    var value: WideValue
    value.first = 11
    value.second = 22
    value.third = 33

    if genericElemSize[WideValue](value) != 24:
        return 1
    if genericSizeof[WideValue](value) != 24:
        return 2
    if genericElemSize[int32](7) != 4:
        return 3

    var ints: int32[]
    reserve(ints, 2)
    add(ints, 7)
    add(ints, 9)
    if genericSeqLen[int32](ints) != 2:
        return 4

    var values: WideValue[]
    reserve(values, 4)
    add(values, value)
    add(values, value)
    add(values, value)
    add(values, value)
    if values.len != 4:
        return 5
    if values[3].first != 11:
        return 6
    if values[3].second != 22:
        return 7
    if values[3].third != 33:
        return 8
    return 0

main()
