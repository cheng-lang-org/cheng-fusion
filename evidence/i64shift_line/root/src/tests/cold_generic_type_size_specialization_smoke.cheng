import std/system
import std/seqs

type WideValue =
    first: int64
    second: int64
    third: int64

type GateAdjacent24 =
    field0: int64
    field1: int64
    field2: int64

type GateObject24 =
    field0: int64
    field1: int64
    field2: int64

type GateObject40 =
