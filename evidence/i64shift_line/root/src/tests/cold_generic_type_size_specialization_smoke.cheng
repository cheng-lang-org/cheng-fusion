fn GateGenericLayout[T](value: T): int32 =
    return 0

fn GateManagedChain[T](value: T): int32 =
    return 0

fn GateSubwordArray[T](values: T[3]): int32 =
    return 0

fn RoundTemplate[T](value: T): int32 =
