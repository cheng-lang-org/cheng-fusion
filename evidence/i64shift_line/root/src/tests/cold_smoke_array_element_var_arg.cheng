import std/system

type
    Score =
        value: int32
        count: int32

fn markScored(s: var Score, v: int32, c: int32) =
    s.value = v
    s.count = c

fn main(): int32 =
    var scores: Score[]
    add(scores, Score(value: 10, count: 0))
    add(scores, Score(value: 20, count: 0))

    assert(scores[0].value == 10, " init: s0.value")
    assert(scores[1].value == 20, " init: s1.value")

    markScored(scores[0], 42, 1)
    assert(scores[0].value == 42, " after: s0.value")
    assert(scores[1].value == 20, " after: s1.value")
    assert(scores[0].count == 1, " after: s0.count")

    echo(" cold_smoke_array_element_var_arg ok")
    return 0
