import std/cmdline
import std/os
import std/rawbytes
import std/result
import std/system
import cheng/core/csg_core/csgc_mapped_reader as mapped_reader
import cheng/core/csg_core/merkle_store_codec
import cheng/tests/csg_core_csgc_mapped_dictionary_boundary_fixture as boundary_fixture

const
    FixtureParentDarwin: str =
        "/private/tmp/csg-core-csgc-mapped-canonical-seal"
    FixtureParentLinux: str =
        "/tmp/csg-core-csgc-mapped-canonical-seal"
    FixtureRelativePath: str = "object.csgc"
    FixtureHashDomain: str = "csg_core.store.canonical_csgc_object"
    GoodFinalName: str =
        "e2a79a63e61004c6ede0e10f269440fe446544bb8ba10ca517d429aa863f646c"
    BadTokenFinalName: str =
        "f68485b9800b349e11801b378a6634226aac654e2af27c5ad63f6ed0a32b8571"
    BadDictionaryFinalName: str =
        "33d65a8bfd1f89d7a89571c88bde6f69fdb7ad464d65830bf8314c8f1f5afeaa"
    BadVarintFinalName: str =
        "7c93ec209a0db0e8af2387c328968b92aa6aab26564f34ddce31fe71d6cb7cd4"
    GoodObjectCid: str =
        "sha256:e2a79a63e61004c6ede0e10f269440fe446544bb8ba10ca517d429aa863f646c"
    BadTokenObjectCid: str =
        "sha256:f68485b9800b349e11801b378a6634226aac654e2af27c5ad63f6ed0a32b8571"
    BadDictionaryObjectCid: str =
        "sha256:33d65a8bfd1f89d7a89571c88bde6f69fdb7ad464d65830bf8314c8f1f5afeaa"
    BadVarintObjectCid: str =
        "sha256:7c93ec209a0db0e8af2387c328968b92aa6aab26564f34ddce31fe71d6cb7cd4"
    GoodBytesHex: str =
        ""

@borrows
fn cloneBytes(bytes: rawbytes.Bytes): rawbytes.Bytes =
    var out = rawbytes.BytesAlloc(rawbytes.BytesLen(bytes))
    rawbytes.BytesCopyInto(out, 0, bytes)
    return out

fn writeU32Le(
        bytes: var rawbytes.Bytes,
        offset: int32,
        value: int32) =
    rawbytes.BytesSet(bytes, offset, value & 255)
    rawbytes.BytesSet(bytes, offset + 1, (value >> 8) & 255)
    rawbytes.BytesSet(bytes, offset + 2, (value >> 16) & 255)
    rawbytes.BytesSet(bytes, offset + 3, (value >> 24) & 255)

fn patchDigest(
        bytes: var rawbytes.Bytes,
        offset: int32,
        digestHex: str) =
    var digest = rawbytes.BytesFromHex(digestHex)
    assert(rawbytes.BytesLen(digest) == 32,
           "mapped canonical seal smoke: digest fixture")
    rawbytes.BytesCopyRangeInto(bytes, offset, digest, 0, 32)
    rawbytes.BytesFree(digest)

fn badTokenBytes(): rawbytes.Bytes =
    var good = rawbytes.BytesFromHex(GoodBytesHex)
    var out = cloneBytes(good)
    rawbytes.BytesSet(out, 600, 3)
    patchDigest(
        out,
        203,
        "68ee620a1ba880282e95a72f8d150185aa436bceea670508162d300223ceab9f")
    rawbytes.BytesFree(good)
    return out

fn badDictionaryBytes(): rawbytes.Bytes =
    var good = rawbytes.BytesFromHex(GoodBytesHex)
    var out = rawbytes.BytesAlloc(rawbytes.BytesLen(good) + 4)
    rawbytes.BytesCopyRangeInto(out, 0, good, 0, 430)
    rawbytes.BytesSet(out, 430, 3)
    rawbytes.BytesSet(out, 431, 34)
    rawbytes.BytesSet(out, 432, 122)
    rawbytes.BytesSet(out, 433, 34)
    rawbytes.BytesCopyRangeInto(
        out, 434, good, 430, rawbytes.BytesLen(good) - 430)
    writeU32Le(out, 16, 854)
    writeU32Le(out, 78, 143)
    writeU32Le(out, 82, 13)
    writeU32Le(out, 135, 370)
    writeU32Le(out, 191, 467)
    writeU32Le(out, 247, 634)
    writeU32Le(out, 291, 13)
    patchDigest(
        out,
        86,
        "011842f1615610cbb8687f3d9a75cb45b922fd076275397ba6c52e9a3cb3ec55")
    rawbytes.BytesFree(good)
    return out

fn badVarintBytes(): rawbytes.Bytes =
    var good = rawbytes.BytesFromHex(GoodBytesHex)
    var out = rawbytes.BytesAlloc(rawbytes.BytesLen(good) + 1)
    rawbytes.BytesCopyRangeInto(out, 0, good, 0, 531)
    rawbytes.BytesSet(out, 531, 153)
    rawbytes.BytesSet(out, 532, 0)
    rawbytes.BytesCopyRangeInto(
        out, 533, good, 532, rawbytes.BytesLen(good) - 532)
    writeU32Le(out, 16, 851)
    writeU32Le(out, 195, 168)
    writeU32Le(out, 247, 631)
    patchDigest(
        out,
        203,
        "af5178dbb19a92ce7c8de544c3edef4b568321c7821b0a42d1a925ae2044c08f")
    rawbytes.BytesFree(good)
    return out

@borrows
fn persistFixture(
        parentPath: str,
        stagingName: str,
        finalName: str,
        expectedCid: str,
        bytes: var rawbytes.Bytes) =
    let actualCid =
        merkle_store_codec.CsgCoreMerkleStoreCanonicalCsgcObjectCid(
            bytes)
    assert(actualCid == expectedCid,
           "mapped canonical seal smoke: object CID")
    let begun = os.AtomicTreeBegin(
        parentPath, stagingName, finalName)
    assert(IsOk(begun),
           "mapped canonical seal smoke: tree begin")
    let tree = Value(begun)
    assert(IsOk(os.AtomicTreeWriteExclusiveSync(
               tree, FixtureRelativePath, bytes)),
           "mapped canonical seal smoke: tree write")
    assert(IsOk(os.AtomicTreeSealReadOnly(
               tree, FixtureRelativePath)),
           "mapped canonical seal smoke: tree seal")
    assert(IsOk(os.AtomicTreeVerifyExact(
               tree, [], [FixtureRelativePath])),
           "mapped canonical seal smoke: tree exact")
    let committed = os.AtomicTreeCommitNoReplace(tree)
    assert(IsOk(committed) &&
           Value(committed) == os.AtomicTreeCommitted,
           "mapped canonical seal smoke: tree commit")
    assert(IsOk(os.AtomicTreeClose(tree)),
           "mapped canonical seal smoke: tree close")

@borrows
fn prepareFixturesAt(parentPath: str): int32 =
    var good = rawbytes.BytesFromHex(GoodBytesHex)
    persistFixture(
        parentPath,
        "staging-good", GoodFinalName, GoodObjectCid, good)
    rawbytes.BytesFree(good)
    var badToken = badTokenBytes()
    persistFixture(
        parentPath,
        "staging-token",
        BadTokenFinalName,
        BadTokenObjectCid,
        badToken)
    rawbytes.BytesFree(badToken)
    var badDictionary = badDictionaryBytes()
    persistFixture(
        parentPath,
        "staging-dictionary",
        BadDictionaryFinalName,
        BadDictionaryObjectCid,
        badDictionary)
    rawbytes.BytesFree(badDictionary)
    var badVarint = badVarintBytes()
    persistFixture(
        parentPath,
        "staging-varint",
        BadVarintFinalName,
        BadVarintObjectCid,
        badVarint)
    rawbytes.BytesFree(badVarint)
    echo("CSG_CORE_CSGC_MAPPED_CANONICAL_SEAL_FIXTURES_OK")
    return 0

fn openFixture(
        owner: var system.RuntimeAllocationLedgerSessionCapability,
        useDarwinParent: bool,
        finalName: str,
        expectedCid: str): Result[mapped_reader.CsgCoreCsgcMappedReader] =
    if useDarwinParent:
        return mapped_reader.CsgCoreCsgcMappedReaderOpenProductionOwned(
            owner,
            FixtureParentDarwin,
            finalName,
            FixtureRelativePath,
            FixtureHashDomain,
            expectedCid)
    return mapped_reader.CsgCoreCsgcMappedReaderOpenProductionOwned(
        owner,
        FixtureParentLinux,
        finalName,
        FixtureRelativePath,
        FixtureHashDomain,
        expectedCid)

fn verifyGood(useDarwinParent: bool): int32 =
    var owner: system.RuntimeAllocationLedgerSessionCapability
    assert(mapped_reader.CsgCoreCsgcMappedSessionOwnerBegin(
               mapped_reader.CsgCoreCsgcMappedAllocationBackingLimit,
               owner),
           "mapped canonical seal smoke: owner begin")
    let opened = openFixture(
        owner, useDarwinParent, GoodFinalName, GoodObjectCid)
    assert(IsOk(opened),
           "mapped canonical seal smoke: canonical open")
    var reader = Value(opened)
    let factCount =
        mapped_reader.CsgCoreCsgcMappedReaderFactCount(reader)
    let directoryCid =
        mapped_reader.CsgCoreCsgcMappedReaderDirectoryCid(reader)
    let decoded =
        mapped_reader.CsgCoreCsgcMappedReaderDecodeFactKind(
            reader, "csg.symbol")
    assert(IsOk(factCount) && Value(factCount) == 4 &&
           IsOk(directoryCid) && Value(directoryCid).len == 71 &&
           decoded.ok && decoded.found && decoded.lines.len == 2,
           "mapped canonical seal smoke: authority after seal")
    assert(IsOk(
           mapped_reader.CsgCoreCsgcMappedReaderSessionClose(
               reader, owner)),
           "mapped canonical seal smoke: reader close")
    let closed =
        mapped_reader.CsgCoreCsgcMappedSessionOwnerClose(owner)
    assert(closed.ok && closed.receipt.complete &&
           closed.receipt.closed,
           "mapped canonical seal smoke: owner close")
    echo("CSG_CORE_CSGC_MAPPED_CANONICAL_SEAL_OK")
    return 0

fn verifyInvalid(
        useDarwinParent: bool,
        finalName: str,
        expectedCid: str): int32 =
    var owner: system.RuntimeAllocationLedgerSessionCapability
    assert(mapped_reader.CsgCoreCsgcMappedSessionOwnerBegin(
               mapped_reader.CsgCoreCsgcMappedAllocationBackingLimit,
               owner),
           "mapped canonical seal smoke: invalid owner begin")
    let opened = openFixture(
        owner, useDarwinParent, finalName, expectedCid)
    if IsErr(opened):
        return 8
    var reader = Value(opened)
    let leakedAuthority =
        mapped_reader.CsgCoreCsgcMappedReaderFactCount(reader)
    let detached =
        mapped_reader.CsgCoreCsgcMappedReaderSessionClose(
            reader, owner)
    let closed =
        mapped_reader.CsgCoreCsgcMappedSessionOwnerClose(owner)
    if IsOk(leakedAuthority) || IsErr(detached) || !closed.ok:
        echo("CSG_CORE_CSGC_MAPPED_CANONICAL_SEAL_BYPASSED")
    return 9

fn main(argc: int32, argv: str*): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    if cmdline.RawParamEquals(1, "prepare-darwin"):
        return prepareFixturesAt(FixtureParentDarwin)
    if cmdline.RawParamEquals(1, "prepare-linux"):
        return prepareFixturesAt(FixtureParentLinux)
    if cmdline.RawParamEquals(1, "positive-darwin"):
        cmdline.ClearCapturedCmdLine()
        return verifyGood(true)
    if cmdline.RawParamEquals(1, "positive-linux"):
        cmdline.ClearCapturedCmdLine()
        return verifyGood(false)
    if cmdline.RawParamEquals(1, "boundary-writer-only"):
        cmdline.ClearCapturedCmdLine()
        return boundary_fixture.CsgCoreCsgcMappedDictionaryBoundaryWriterOnly()
    if cmdline.RawParamEquals(1, "boundary-positive-linux"):
        cmdline.ClearCapturedCmdLine()
        return boundary_fixture.CsgCoreCsgcMappedDictionaryBoundaryPositive(
            FixtureParentLinux)
    if cmdline.RawParamEquals(1, "boundary-legacy-linux"):
        cmdline.ClearCapturedCmdLine()
        return boundary_fixture.CsgCoreCsgcMappedDictionaryBoundaryLegacyReject(
            FixtureParentLinux)
    if cmdline.RawParamEquals(1, "bad-token-darwin"):
        cmdline.ClearCapturedCmdLine()
        return verifyInvalid(
            true,
            BadTokenFinalName,
            BadTokenObjectCid)
    if cmdline.RawParamEquals(1, "bad-token-linux"):
        cmdline.ClearCapturedCmdLine()
        return verifyInvalid(
            false,
            BadTokenFinalName,
            BadTokenObjectCid)
    if cmdline.RawParamEquals(1, "bad-dictionary-darwin"):
        cmdline.ClearCapturedCmdLine()
        return verifyInvalid(
            true,
            BadDictionaryFinalName,
            BadDictionaryObjectCid)
    if cmdline.RawParamEquals(1, "bad-dictionary-linux"):
        cmdline.ClearCapturedCmdLine()
        return verifyInvalid(
            false,
            BadDictionaryFinalName,
            BadDictionaryObjectCid)
    if cmdline.RawParamEquals(1, "bad-varint-darwin"):
        cmdline.ClearCapturedCmdLine()
        return verifyInvalid(
            true,
            BadVarintFinalName,
            BadVarintObjectCid)
    if cmdline.RawParamEquals(1, "bad-varint-linux"):
        cmdline.ClearCapturedCmdLine()
        return verifyInvalid(
            false,
            BadVarintFinalName,
            BadVarintObjectCid)
    return 2
