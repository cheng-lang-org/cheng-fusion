import std/os
import std/strings

fn assertNoText(text: str, needle: str, label: str) =
    assert(!strings.StrContains(text, needle), label)

fn main(): int32 =
    let deviceText = os.ReadFile("src/inference/device.cheng")
    let kernelSmokeText = os.ReadFile("src/tests/inference_kernel_metal_smoke.cheng")
    let pagedSmokeText = os.ReadFile("src/tests/paged_kv_cache_smoke.cheng")
    assertNoText(deviceText, "fn DeviceMetalVectorAddFill(", " inference zrpc surface: vector add direct export")
    assertNoText(deviceText, "fn DeviceMetalGemmFill(", " inference zrpc surface: gemm direct export")
    assertNoText(deviceText, "fn DeviceMetalGemmInt4WeightFill(", " inference zrpc surface: int4 gemm direct export")
    assertNoText(deviceText, "fn DeviceMetalLinearOutInInt4WeightFill(", " inference zrpc surface: int4 linear direct export")
    assertNoText(deviceText, "fn DeviceMetalLinearOutInW4Afp8WeightFill(", " inference zrpc surface: w4afp8 direct export")
    assertNoText(deviceText, "fn DeviceMetalRmsNormFill(", " inference zrpc surface: rmsnorm direct export")
    assertNoText(deviceText, "fn DeviceMetalPagedAttentionFill(", " inference zrpc surface: paged attention direct export")
    assertNoText(deviceText, "fn DeviceMetalPagedAttentionTensorPageBuffersFill(", " inference zrpc surface: tensor page direct export")
    assertNoText(deviceText, "fn deviceMetalLegacy", " inference zrpc surface: legacy direct helper")
    assertNoText(deviceText, "__inference_metal_vector_add_i32_bridge(", " inference zrpc surface: raw vector add bridge")
    assertNoText(deviceText, "__inference_metal_gemm_i32_bridge(", " inference zrpc surface: raw gemm bridge")
    assertNoText(deviceText, "__inference_metal_gemm_int4_weight_i32_bridge(", " inference zrpc surface: raw int4 gemm bridge")
    assertNoText(deviceText, "__inference_metal_linear_out_in_int4_weight_i32_bridge(", " inference zrpc surface: raw int4 linear bridge")
    assertNoText(deviceText, "__inference_metal_linear_out_in_w4afp8_weight_i32_bridge(", " inference zrpc surface: raw w4afp8 bridge")
    assertNoText(deviceText, "__inference_metal_linear_out_in_w4afp8_weight_i32_weight_buffer_bridge(", " inference zrpc surface: raw w4afp8 weight buffer bridge")
    assertNoText(deviceText, "__inference_metal_linear_out_in_w4afp8_weight_i32_weight_scale_buffers_bridge(", " inference zrpc surface: raw w4afp8 scale buffer bridge")
    assertNoText(deviceText, "__inference_metal_rmsnorm_i32_bridge(", " inference zrpc surface: raw rmsnorm bridge")
    assertNoText(deviceText, "__inference_metal_paged_attention_i32_bridge(", " inference zrpc surface: raw paged attention bridge")
    assertNoText(deviceText, "__inference_metal_paged_attention_i32_buffers_bridge(", " inference zrpc surface: raw paged buffer bridge")
    assertNoText(deviceText, "__inference_metal_paged_attention_i32_page_buffers_bridge(", " inference zrpc surface: raw paged page-buffer bridge")
    assertNoText(deviceText, "__inference_metal_paged_attention_i32_page_buffers_window_bridge(", " inference zrpc surface: raw window out-param bridge")
    assertNoText(deviceText, "__inference_metal_paged_attention_i32_page_buffers_output_receipt_bridge(", " inference zrpc surface: raw paged page-buffer array receipt bridge")
    assertNoText(deviceText, "__inference_metal_paged_attention_i32_page_buffers_window_output_receipt_bridge(", " inference zrpc surface: raw window array receipt bridge")
    assertNoText(deviceText, "__inference_metal_linear_out_in_w4afp8_weight_i32_activation_weight_scale_buffers_bridge(", " inference zrpc surface: raw w4afp8 activation scale bridge")
    assertNoText(deviceText, "ptr", " inference zrpc surface: device module naked pointer")
    assertNoText(deviceText, "ptr(&", " inference zrpc surface: local pointer out param")
    assertNoText(deviceText, "scoreOut: ptr", " inference zrpc surface: score out ptr")
    assertNoText(deviceText, "tokenOut: ptr", " inference zrpc surface: token out ptr")
    assertNoText(deviceText, "foundOut: ptr", " inference zrpc surface: found out ptr")
    assertNoText(deviceText, "StrDataPtr(filePath)", " inference zrpc surface: file path raw pointer bridge")
    assertNoText(deviceText, "load_file_range_buffer_bridge(path: ptr", " inference zrpc surface: file range path ptr import")
    assertNoText(deviceText, "load_file_range_buffer_chunked_bridge(path: ptr", " inference zrpc surface: chunked file range path ptr import")
    assertNoText(kernelSmokeText, "DeviceMetalGemmFill(", " inference zrpc surface: kernel smoke direct gemm")
    assertNoText(kernelSmokeText, "DeviceMetalLinearOutInInt4WeightFill(", " inference zrpc surface: kernel smoke direct int4")
    assertNoText(kernelSmokeText, "DeviceMetalLinearOutInW4Afp8WeightFill(", " inference zrpc surface: kernel smoke direct w4")
    assertNoText(kernelSmokeText, "DeviceMetalRmsNormFill(", " inference zrpc surface: kernel smoke direct rms")
    assertNoText(kernelSmokeText, "DeviceMetalPagedAttentionFill(", " inference zrpc surface: kernel smoke direct paged")
    assertNoText(kernelSmokeText, "DeviceMetalPagedAttentionTensorPageBuffersFill(", " inference zrpc surface: kernel smoke direct tensor page")
    assertNoText(pagedSmokeText, "DeviceMetalPagedAttentionFill(", " inference zrpc surface: paged smoke direct paged")
    echo(" inference_zrpc_surface_smoke ok")
    return 0
