module cold_primary_typed_expr_query_borrow_smoke

import cheng/core/backend/primary_object_plan as primary
import cheng/core/lang/typed_expr as texpr

fn main(): int32 =
    var typedIr: texpr.TypedExprIr
    add(typedIr.typeFieldOwnerTypes, "ChengMemHeader")
    add(typedIr.typeFieldNames, "rc")
    add(typedIr.typeFieldTypes, "int64")
    add(typedIr.typeFieldOffsetBytes, 0)
    add(typedIr.typeFieldSizeBytes, 8)
    add(typedIr.typeFieldAlignBytes, 8)
    add(typedIr.typeDefAliasNames, "ChengMemHeaderPtr")
    add(typedIr.typeDefAliasTargetTypes, "ptr ChengMemHeader")

    if primary.PrimaryObjectTypedIrFieldCount(
           typedIr, "ChengMemHeader", "rc") != 1 ||
       primary.PrimaryObjectTypedIrTypeDefAliasCount(
           typedIr, "ChengMemHeaderPtr", "ptr ChengMemHeader") != 1 ||
       primary.PrimaryObjectTypedIrFieldMetric(
           typedIr, "ChengMemHeader", "rc", "size") != 8 ||
       primary.PrimaryObjectPlanProgramUsesValueIntrinsic(typedIr):
        return 1

    let fieldType = primary.PrimaryObjectTypedIrFieldTypeText(
        typedIr, "ChengMemHeader", "rc")
    typedIr = texpr.TypedExprIr()
    if fieldType != "int64":
        return 2
    echo("cold_primary_typed_expr_query_borrow=PASS")
    return 0
