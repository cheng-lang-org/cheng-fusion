import std/os
import std/strformat
import std/strutils as strutil
import cheng/core/lang/parser
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/backend/system_link_plan as slplan

fn VerifiedSnapshotIndex(
        roots: parser.ParserExternalPackageRoot[],
        closure: str[]): ccsg.CompilerCsgSourcePathIndex =
    var index = ccsg.CompilerCsgSourcePathIndexInit(16)
    ccsg.CompilerCsgSourcePathIndexSealClosure(index, closure)
    var err: str
    assert(ccsg.CompilerCsgSourcePathIndexConfigureRoots(
               index,
               "/tmp/cheng-csg-verified-snapshot-workspace",
               "/tmp/cheng-csg-verified-snapshot-workspace",
               roots,
               err),
           Fmt"verified snapshot: source index roots invalid err={err}")
    return index

fn main(): int32 =
    let mirrorRoot =
        "/tmp/cheng-csg-verified-snapshot-no-reopen-913c5a/mirror"
    let emptyPath = strutil.Join([mirrorRoot, "/src/empty.cheng"], "")
    let modulePath = strutil.Join([mirrorRoot, "/src/module.cheng"], "")
    assert(!os.FileExists(emptyPath) && !os.FileExists(modulePath),
           "verified snapshot: fixture unexpectedly exists on disk")

    var snapshotPaths: str[]
    add(snapshotPaths, emptyPath)
    add(snapshotPaths, modulePath)
    var snapshotTexts: str[]
    add(snapshotTexts, "")
    add(snapshotTexts,
        "fn value(): int32 =\n    browserInputBytesRequired()\n    return 41\n")
    let root = parser.ParserExternalPackageRootCertifiedSnapshotNew(
        "managed",
        "cheng/managed",
        mirrorRoot,
        snapshotPaths,
        snapshotTexts)
    var roots: parser.ParserExternalPackageRoot[]
    add(roots, root)
    var closure: str[]
    add(closure, emptyPath)
    add(closure, modulePath)
    var owners: str[]
    add(owners, "managed/empty")
    add(owners, "managed/module")

    var index = VerifiedSnapshotIndex(roots, closure)
    var overrides: ccsg.CompilerCsgSourceText[]
    var lookup: ccsg.CompilerCsgSourceTextLookupEntry[]
    var err: str
    assert(ccsg.CompilerCsgSourceTextLookupBuild(
               overrides,
               "",
               "",
               roots,
               closure,
               owners,
               index,
               lookup,
               err),
           Fmt"verified snapshot: lookup build failed err={err}")
    assert(lookup.len == 2,
           "verified snapshot: sealed closure bytes not materialized")
    var cache: ccsg.CompilerCsgSourceTextLookupEntry[]
    var cacheIndex = ccsg.CompilerCsgSourcePathIndexInitLike(index, 8)
    var text: str
    assert(ccsg.CompilerCsgReadSourceTextCached(
               cache,
               cacheIndex,
               lookup,
               index,
               emptyPath,
               text,
               err) && text == "" && cache.len == 0,
           Fmt"verified snapshot: zero-byte source reopened err={err}")
    assert(ccsg.CompilerCsgReadSourceTextCached(
               cache,
               cacheIndex,
               lookup,
               index,
               modulePath,
               text,
               err) && text == snapshotTexts[1] && cache.len == 0,
           Fmt"verified snapshot: source bytes reopened err={err}")

    var browserPlan: slplan.SystemLinkPlanStub
    browserPlan.workspaceRoot = "/Users/lbcheng/cheng-lang"
    browserPlan.packageRoot = "/Users/lbcheng/cheng-lang"
    browserPlan.entryPath = modulePath
    browserPlan.externalPackageRoots = roots
    add(browserPlan.sourceClosurePaths, modulePath)
    add(browserPlan.sourceClosurePaths,
        "/Users/lbcheng/cheng-lang/src/libp2p/browser/browser_content_codec_abi.cheng")
    let browserRules =
        ccsg.CompilerBrowserAbiRulesForLinkPlan(browserPlan)
    assert(browserRules.len > 0,
           "verified snapshot: Browser ABI closure did not consume snapshot bytes")

    var incompletePaths: str[]
    add(incompletePaths, emptyPath)
    var incompleteTexts: str[]
    add(incompleteTexts, "")
    let incompleteRoot =
        parser.ParserExternalPackageRootCertifiedSnapshotNew(
            "managed",
            "cheng/managed",
            mirrorRoot,
            incompletePaths,
            incompleteTexts)
    var incompleteRoots: parser.ParserExternalPackageRoot[]
    add(incompleteRoots, incompleteRoot)
    var missingIndex = VerifiedSnapshotIndex(incompleteRoots, closure)
    var missingLookup: ccsg.CompilerCsgSourceTextLookupEntry[]
    assert(!ccsg.CompilerCsgSourceTextLookupBuild(
               overrides,
               "",
               "",
               incompleteRoots,
               closure,
               owners,
               missingIndex,
               missingLookup,
               err) &&
           strutil.Contains(err, "missing from snapshot"),
           "verified snapshot: missing closure source accepted")
    var missingText: str
    assert(!parser.ParserSourceTextWithExternalPackageRootsInto(
               modulePath,
               incompleteRoots,
               missingText,
               err) &&
           strutil.Contains(err, "missing from snapshot"),
           "verified snapshot: missing Browser ABI source could fall through to disk")

    var corruptRoot = root
    corruptRoot.verifiedSourceTexts = []
    var corruptRoots: parser.ParserExternalPackageRoot[]
    add(corruptRoots, corruptRoot)
    var corruptIndex = VerifiedSnapshotIndex(corruptRoots, closure)
    var corruptLookup: ccsg.CompilerCsgSourceTextLookupEntry[]
    assert(!ccsg.CompilerCsgSourceTextLookupBuild(
               overrides,
               "",
               "",
               corruptRoots,
               closure,
               owners,
               corruptIndex,
               corruptLookup,
               err) &&
           strutil.Contains(err, "snapshot invalid"),
           "verified snapshot: corrupt snapshot shape accepted")

    var conflictingOverrides: ccsg.CompilerCsgSourceText[]
    var conflictingOverride: ccsg.CompilerCsgSourceText
    conflictingOverride.sourcePath = modulePath
    conflictingOverride.modulePath = owners[1]
    conflictingOverride.text = "fn value(): int32 =\n    return 99\n"
    add(conflictingOverrides, conflictingOverride)
    var conflictIndex = VerifiedSnapshotIndex(roots, closure)
    var conflictLookup: ccsg.CompilerCsgSourceTextLookupEntry[]
    assert(!ccsg.CompilerCsgSourceTextLookupBuild(
               conflictingOverrides,
               "",
               "",
               roots,
               closure,
               owners,
               conflictIndex,
               conflictLookup,
               err) &&
           strutil.Contains(err, "multiple providers"),
           "verified snapshot: conflicting override accepted")

    echo("compiler_csg_verified_snapshot_no_reopen_smoke: ok")
    return 0
