import std/cmdline as cmdline
import std/os as os
import std/os_host_process as hostos
import std/strutils as strutil
import cheng/core/backend/lowering_plan as lower
import cheng/core/lang/intern as langintern
import cheng/core/lang/parser
import cheng/core/lang/typed_expr as texpr
import cheng/core/runtime/arena as arenamod

fn fixtureSourcePath(): str =
    return "/work/pkg/shared_defer_scope.cheng"

fn appendScope(ir: var texpr.TypedExprIr,
               scopeId: int32,
               parentScopeId: int32,
               kind: parser.NormalizedScopeKind,
               ownerStatementOrdinal: int32,
               lexicalOrdinal: int32,
               startLine: int32,
               startColumn: int32,
               endLine: int32,
               endColumn: int32) =
    texpr.TypedExprIrAppendScope(ir,
                                   scopeId,
                                   parentScopeId,
                                   kind,
                                   ownerStatementOrdinal,
                                   lexicalOrdinal,
                                   startLine,
                                   startColumn,
                                   endLine,
                                   endColumn)

fn appendStatement(ir: var texpr.TypedExprIr,
                   functionName: str,
                   kind: texpr.TypedExprIrStatementKind,
                   lineNumber: int32,
                   columnNumber: int32,
                   endColumnNumber: int32,
                   lexicalScopeId: int32,
                   suiteScopeId: int32,
                   statementOrdinal: int32,
                   lexicalOrdinal: int32,
                   deferOwnerStatementOrdinal: int32) =
    var statement: texpr.TypedExprIrStatement
    statement.sourcePath = fixtureSourcePath()
    statement.functionName = functionName
    statement.statementIndex = ir.statements2_statementIndexs.len
    statement.lineNumber = lineNumber
    statement.columnNumber = columnNumber
    statement.endLineNumber = lineNumber
    statement.endColumnNumber = endColumnNumber
    statement.lexicalScopeId = lexicalScopeId
    statement.suiteScopeId = suiteScopeId
    statement.statementOrdinal = statementOrdinal
    statement.lexicalOrdinal = lexicalOrdinal
    statement.deferOwnerStatementOrdinal = deferOwnerStatementOrdinal
    statement.lineIndent = columnNumber - 1
    statement.enclosingIfLineNumber = -1
    statement.kind = kind
    statement.callKind = texpr.TypedExprCallNone
    statement.detailKind = parser.NormalizedExprDetailNone
    statement.rhsNodeIndex = -1
    statement.rhsBailReason = texpr.RhsBailNone
    statement.forStartNodeIndex = -1
    statement.assignLvalueNodeIndex = -1
    statement.assignIndexNodeIndex = -1
    texpr.TypedExprIrAppendStatement(ir, statement)

fn appendFunction(ir: var texpr.TypedExprIr,
                  functionName: str,
                  signatureLine: int32,
                  endLine: int32,
                  statementStart: int32,
                  statementCount: int32,
                  scopeStart: int32,
                  scopeCount: int32) =
    var fnIr: texpr.TypedExprIrFunction
    fnIr.sourcePath = fixtureSourcePath()
    fnIr.functionName = functionName
    fnIr.signatureLineNumber = signatureLine
    fnIr.endLineNumber = endLine
    fnIr.bodyLineNumber = signatureLine + 1
    fnIr.returnType = "int32"
    fnIr.statementStart = statementStart
    fnIr.statementCount = statementCount
    fnIr.scopeStart = scopeStart
    fnIr.scopeCount = scopeCount
    fnIr.returnNodeIndex = -1
    texpr.TypedExprIrAppendFunction(ir, fnIr)

fn buildFixture(ir: var texpr.TypedExprIr) =
    ir.internPool = langintern.InternPoolNew()

    let firstScopeStart = ir.scopes2_scopeIds.len
    appendScope(ir, 0, -1, parser.NormalizedScopeRoot, -1, 0, 1, 1, 20, 80)
    appendScope(ir, 1, 0, parser.NormalizedScopeIndentedSuite, 1, 0, 3, 5, 14, 80)
    appendScope(ir, 2, 1, parser.NormalizedScopeDeferSuite, 2, 0, 4, 9, 5, 80)
    appendScope(ir, 3, 1, parser.NormalizedScopeIndentedSuite, 4, 1, 7, 9, 13, 80)
    appendScope(ir, 4, 3, parser.NormalizedScopeIndentedSuite, 5, 0, 8, 13, 9, 80)
    let firstStatementStart = ir.statements2_statementIndexs.len
    appendStatement(ir, "First", texpr.TypedExprIrStmtLocalDecl, 2, 5, 30, 0, -1, 0, 0, -1)
    appendStatement(ir, "First", texpr.TypedExprIrStmtIf, 3, 5, 25, 0, 1, 1, 1, -1)
    appendStatement(ir, "First", texpr.TypedExprIrStmtDefer, 4, 9, 20, 1, 2, 2, 0, -1)
    appendStatement(ir, "First", texpr.TypedExprIrStmtLocalDecl, 5, 13, 32, 2, -1, 3, 0, 2)
    appendStatement(ir, "First", texpr.TypedExprIrStmtWhile, 7, 9, 26, 1, 3, 4, 1, -1)
    appendStatement(ir, "First", texpr.TypedExprIrStmtIf, 8, 13, 28, 3, 4, 5, 0, -1)
    appendStatement(ir, "First", texpr.TypedExprIrStmtContinue, 9, 17, 25, 4, -1, 6, 0, -1)
    appendStatement(ir, "First", texpr.TypedExprIrStmtBreak, 11, 13, 20, 3, -1, 7, 1, -1)
    appendStatement(ir, "First", texpr.TypedExprIrStmtReturn, 16, 5, 24, 0, -1, 8, 2, -1)
    appendFunction(ir,
                   "First",
                   1,
                   20,
                   firstStatementStart,
                   9,
                   firstScopeStart,
                   5)

    let secondScopeStart = ir.scopes2_scopeIds.len
    appendScope(ir, 0, -1, parser.NormalizedScopeRoot, -1, 0, 30, 1, 40, 80)
    appendScope(ir, 1, 0, parser.NormalizedScopeIndentedSuite, 1, 0, 32, 5, 34, 80)
    let secondStatementStart = ir.statements2_statementIndexs.len
    appendStatement(ir, "Second", texpr.TypedExprIrStmtLocalDecl, 31, 5, 30, 0, -1, 0, 0, -1)
    appendStatement(ir, "Second", texpr.TypedExprIrStmtIf, 32, 5, 25, 0, 1, 1, 1, -1)
    appendStatement(ir, "Second", texpr.TypedExprIrStmtReturn, 33, 9, 24, 1, -1, 2, 0, -1)
    appendStatement(ir, "Second", texpr.TypedExprIrStmtReturn, 36, 5, 24, 0, -1, 3, 2, -1)
    appendFunction(ir,
                   "Second",
                   30,
                   40,
                   secondStatementStart,
                   4,
                   secondScopeStart,
                   2)

    # A function body is a lexical scope, not a statement-owned suite. A
    # declaration whose body is represented only by its return node therefore
    # legitimately carries this unowned scope with an empty statement slice.
    let unownedBodyScopeStart = ir.scopes2_scopeIds.len
    appendScope(ir, 0, -1, parser.NormalizedScopeRoot, -1, 0, 50, 1, 55, 80)
    appendScope(ir, 1, 0, parser.NormalizedScopeIndentedSuite, -1, 0, 51, 5, 55, 80)
    appendFunction(ir,
                   "UnownedBody",
                   50,
                   55,
                   ir.statements2_statementIndexs.len,
                   0,
                   unownedBodyScopeStart,
                   2)

fn primaryFunction(functionName: str,
                   typedFunctionIndex: int32): lower.PrimaryObjectIrFunction =
    var fnIr: lower.PrimaryObjectIrFunction
    fnIr.sourcePath = fixtureSourcePath()
    fnIr.functionName = functionName
    fnIr.typedFunctionIndex = typedFunctionIndex
    return fnIr

fn assertI32Column(actual: int32[], expected: int32[], label: str) =
    assert(actual.len == expected.len, label)
    for i in 0..<actual.len:
        assert(actual[i] == expected[i], label)

fn assertFirstTransport(
        transport: lower.LoweringDeferScopeTransportSoA) =
    assert(transport.complete &&
           transport.sourceScopeStart == 0 &&
           transport.sourceScopeCount == 5 &&
           transport.sourceStatementStart == 0 &&
           transport.sourceStatementCount == 9,
           "first transport slice")
    assertI32Column(transport.scopeIds,
                    [0, 1, 2, 3, 4],
                    "first transport scope ids")
    assertI32Column(transport.scopeParentIds,
                    [-1, 0, 1, 1, 3],
                    "first transport scope parents")
    assertI32Column(transport.scopeOwnerStatementOrdinals,
                    [-1, 1, 2, 4, 5],
                    "first transport scope owners")
    assertI32Column(transport.scopeLexicalOrdinals,
                    [0, 0, 0, 1, 0],
                    "first transport scope lexical ordinals")
    assertI32Column(transport.statementIndexes,
                    [0, 1, 2, 3, 4, 5, 6, 7, 8],
                    "first transport statement indexes")
    assertI32Column(transport.statementOrdinals,
                    [0, 1, 2, 3, 4, 5, 6, 7, 8],
                    "first transport statement ordinals")
    assertI32Column(transport.statementLexicalScopeIds,
                    [0, 0, 1, 2, 1, 3, 4, 3, 0],
                    "first transport statement lexical scopes")
    assertI32Column(transport.statementSuiteScopeIds,
                    [-1, 1, 2, -1, 3, 4, -1, -1, -1],
                    "first transport statement suite scopes")
    assertI32Column(transport.statementLexicalOrdinals,
                    [0, 1, 0, 0, 1, 0, 0, 1, 2],
                    "first transport statement lexical ordinals")
    assertI32Column(transport.statementDeferOwnerStatementOrdinals,
                    [-1, -1, -1, 2, -1, -1, -1, -1, -1],
                    "first transport statement defer owners")
    assert(transport.statementKinds[0] == texpr.TypedExprIrStmtLocalDecl &&
           transport.statementKinds[6] == texpr.TypedExprIrStmtContinue &&
           transport.statementKinds[7] == texpr.TypedExprIrStmtBreak &&
           transport.statementKinds[8] == texpr.TypedExprIrStmtReturn,
           "first transport control kinds")
    assert(lower.LoweringDeferScopeTransportLiveBytes(transport) == int64(576),
           "first transport live bytes")

fn assertSecondTransport(
        transport: lower.LoweringDeferScopeTransportSoA) =
    assert(transport.complete &&
           transport.sourceScopeStart == 5 &&
           transport.sourceScopeCount == 2 &&
           transport.sourceStatementStart == 9 &&
           transport.sourceStatementCount == 4,
           "second transport slice")
    assertI32Column(transport.scopeIds,
                    [0, 1],
                    "second transport scope ids")
    assertI32Column(transport.scopeParentIds,
                    [-1, 0],
                    "second transport scope parents")
    assertI32Column(transport.scopeOwnerStatementOrdinals,
                    [-1, 1],
                    "second transport scope owners")
    assertI32Column(transport.statementIndexes,
                    [9, 10, 11, 12],
                    "second transport statement indexes")
    assertI32Column(transport.statementOrdinals,
                    [0, 1, 2, 3],
                    "second transport statement ordinals")
    assertI32Column(transport.statementLexicalScopeIds,
                    [0, 0, 1, 0],
                    "second transport statement isolation")
    assert(lower.LoweringDeferScopeTransportLiveBytes(transport) == int64(248),
           "second transport live bytes")

fn assertUnownedBodyTransport(
        transport: lower.LoweringDeferScopeTransportSoA) =
    assert(transport.complete &&
           transport.sourceScopeStart == 7 &&
           transport.sourceScopeCount == 2 &&
           transport.sourceStatementStart == 13 &&
           transport.sourceStatementCount == 0,
           "unowned body transport slice")
    assertI32Column(transport.scopeIds,
                    [0, 1],
                    "unowned body transport scope ids")
    assertI32Column(transport.scopeParentIds,
                    [-1, 0],
                    "unowned body transport scope parents")
    assertI32Column(transport.scopeOwnerStatementOrdinals,
                    [-1, -1],
                    "unowned body transport scope owners")
    assert(transport.statementIndexes.len == 0 &&
           lower.LoweringDeferScopeTransportLiveBytes(transport) == int64(72),
           "unowned body transport payload")

fn runPositive() =
    var ir: texpr.TypedExprIr
    buildFixture(ir)
    var first = primaryFunction("First", 0)
    var second = primaryFunction("Second", 1)
    var unownedBody = primaryFunction("UnownedBody", 2)
    lower.LoweringAttachDeferScopeTransport(first, ir, 0)
    lower.LoweringAttachDeferScopeTransport(second, ir, 1)
    lower.LoweringAttachDeferScopeTransport(unownedBody, ir, 2)
    assertFirstTransport(first.deferScopeTransport)
    assertSecondTransport(second.deferScopeTransport)
    assertUnownedBodyTransport(unownedBody.deferScopeTransport)

    var cloned = lower.LoweringDeferScopeTransportClone(first.deferScopeTransport)
    assertFirstTransport(cloned)
    var moved: lower.LoweringDeferScopeTransportSoA
    lower.LoweringDeferScopeTransportMoveInto(moved, cloned)
    assert(lower.LoweringDeferScopeTransportLiveBytes(cloned) == int64(0) &&
           lower.LoweringDeferScopeTransportCapacityBytes(cloned) == int64(0),
           "transport move source release")
    let movedCapacity = lower.LoweringDeferScopeTransportCapacityBytes(moved)
    lower.LoweringDeferScopeTransportRelease(moved)
    assert(lower.LoweringDeferScopeTransportLiveBytes(moved) == int64(0) &&
           movedCapacity > int64(0) &&
           lower.LoweringDeferScopeTransportCapacityBytes(moved) == int64(0) &&
           lower.LoweringDeferScopeTransportRetainedBytes(moved) == int64(0),
           "transport release capacity")

    var plan: lower.LoweringPlanStub
    var firstPlanFn: lower.PrimaryObjectIrFunction
    firstPlanFn.deferScopeTransport =
        lower.LoweringDeferScopeTransportClone(
            first.deferScopeTransport)
    add(plan.primaryObjectIr.functions, firstPlanFn)
    var secondPlanFn: lower.PrimaryObjectIrFunction
    secondPlanFn.deferScopeTransport =
        lower.LoweringDeferScopeTransportClone(
            second.deferScopeTransport)
    add(plan.primaryObjectIr.functions, secondPlanFn)
    assert(lower.LoweringPlanDeferScopeTransportFunctionCount(plan) == 2 &&
           lower.LoweringPlanDeferScopeTransportScopeRowCount(plan) == 7 &&
           lower.LoweringPlanDeferScopeTransportStatementRowCount(plan) == 13 &&
           lower.LoweringPlanDeferScopeTransportLiveBytes(plan) == int64(824) &&
           lower.LoweringPlanDeferScopeTransportCapacityBytes(plan) >= int64(824) &&
           lower.LoweringPlanDeferScopeTransportRetainedBytes(plan) ==
               lower.LoweringPlanDeferScopeTransportCapacityBytes(plan) &&
           lower.LoweringPlanDeferScopeTransportRetainedItemCount(plan) >= 206,
           "plan transport accounting")
    let report = lower.LoweringPlanStubReport(plan)
    assert(strutil.Contains(report, "lowering_defer_scope_transport_function_count=2") &&
           strutil.Contains(report, "lowering_defer_scope_transport_scope_row_count=7") &&
           strutil.Contains(report, "lowering_defer_scope_transport_statement_row_count=13") &&
           strutil.Contains(report, "lowering_defer_scope_transport_retained_bytes=") &&
           strutil.Contains(report, "lowering_defer_scope_transport_live_bytes=824"),
           "plan transport report")
    lower.LoweringPrimaryObjectIrReleaseDeferScopeTransports(plan.primaryObjectIr)
    assert(lower.LoweringPlanDeferScopeTransportLiveBytes(plan) == int64(0) &&
           lower.LoweringPlanDeferScopeTransportCapacityBytes(plan) == int64(0) &&
           lower.LoweringPlanDeferScopeTransportRetainedBytes(plan) == int64(0) &&
           lower.LoweringPlanDeferScopeTransportRetainedItemCount(plan) == 0,
           "consumed plan transport release")
    lower.LoweringPrimaryObjectIrFunctionReleaseDeferScopeTransport(first)
    lower.LoweringPrimaryObjectIrFunctionReleaseDeferScopeTransport(second)
    lower.LoweringPrimaryObjectIrFunctionReleaseDeferScopeTransport(unownedBody)
    assert(lower.LoweringDeferScopeTransportLiveBytes(first.deferScopeTransport) == int64(0) &&
           lower.LoweringDeferScopeTransportLiveBytes(second.deferScopeTransport) == int64(0) &&
           lower.LoweringDeferScopeTransportLiveBytes(unownedBody.deferScopeTransport) == int64(0),
           "consumed function transport release")
    texpr.TypedExprIrReleasePayload(ir)

fn runMissingColumnNegative() =
    var ir: texpr.TypedExprIr
    buildFixture(ir)
    add(ir.scopes2_kinds, parser.NormalizedScopeRoot)
    var transport: lower.LoweringDeferScopeTransportSoA
    lower.LoweringBuildDeferScopeTransport(ir, 0, transport)

fn runRangeNegative() =
    var ir: texpr.TypedExprIr
    buildFixture(ir)
    arenamod.ArenaArrayInt32Set(ir.arena,
                                ir.functions2_scopeCounts,
                                0,
                                100)
    var transport: lower.LoweringDeferScopeTransportSoA
    lower.LoweringBuildDeferScopeTransport(ir, 0, transport)

fn runOwnerDriftNegative() =
    var ir: texpr.TypedExprIr
    buildFixture(ir)
    arenamod.ArenaArrayInt32Set(ir.arena,
                                ir.scopes2_ownerStatementOrdinals,
                                2,
                                3)
    var transport: lower.LoweringDeferScopeTransportSoA
    lower.LoweringBuildDeferScopeTransport(ir, 0, transport)

fn runIdentityDriftNegative() =
    var ir: texpr.TypedExprIr
    buildFixture(ir)
    ir.statements2_functionNameIds[0] = ir.functions2_functionNameIds[1]
    var transport: lower.LoweringDeferScopeTransportSoA
    lower.LoweringBuildDeferScopeTransport(ir, 0, transport)

fn runUnownedDeferSuiteNegative() =
    var ir: texpr.TypedExprIr
    buildFixture(ir)
    ir.scopes2_kinds[8] = parser.NormalizedScopeDeferSuite
    var transport: lower.LoweringDeferScopeTransportSoA
    lower.LoweringBuildDeferScopeTransport(ir, 2, transport)

fn requireHardFail(mode: str, diagnostic: str) =
    let result = hostos.ExecFileCapture(cmdline.ParamStr(0),
                                         [mode],
                                         [],
                                         "",
                                         true,
                                         60)
    assert(os.ExecCmdResultExitCode(result) != 0 &&
           strutil.Contains(os.ExecCmdResultOutput(result), diagnostic),
           "lowering defer scope transport hard-fail contract")

fn runHardFailMatrix() =
    requireHardFail("missing-column", "scope columns incomplete")
    requireHardFail("range", "function scope slice out of range")
    requireHardFail("owner-drift", "scope owner back-reference drift")
    requireHardFail("identity-drift", "statement source/function identity drift")
    requireHardFail("unowned-defer-suite", "defer suite owner statement missing")

fn main(): int32 =
    let mode = cmdline.ParamStr(1)
    if mode == "missing-column":
        runMissingColumnNegative()
        return 91
    if mode == "range":
        runRangeNegative()
        return 92
    if mode == "owner-drift":
        runOwnerDriftNegative()
        return 93
    if mode == "identity-drift":
        runIdentityDriftNegative()
        return 94
    if mode == "unowned-defer-suite":
        runUnownedDeferSuiteNegative()
        return 95
    runPositive()
    runHardFailMatrix()
    os.WriteLine(os.GetStdout(), "lowering_defer_scope_transport_smoke ok")
    return 0
