module cold_linkerless_int64_ops

fn test_add_sub(): int32 =
    var x: int64 = int64(100)
    x = x + int64(50)
    x = x - int64(30)
    if x != int64(120):
        return 1
    return 0

fn test_mul_div(): int32 =
    var x: int64 = int64(7)
    x = x * int64(6)
    if x != int64(42):
        return 1
    x = x / int64(2)
    if x != int64(21):
        return 2
    return 0

fn test_chain(): int32 =
    let a: int64 = int64(10)
    let b: int64 = int64(3)
    let c: int64 = int64(4)
    let r = a + b * c - int64(2)
    if r != int64(20):
        return 1
    return 0

fn test_const(): int32 =
    let v: int64 = int64(100000)
    if v != int64(100000):
        return 1
    return 0

fn test_neg(): int32 =
    let v: int64 = int64(0) - int64(42)
    if v != int64(0) - int64(42):
        return 1
    return 0

fn main(): int32 =
    let r1 = test_add_sub()
    if r1 != 0:
        return r1
    let r2 = test_mul_div()
    if r2 != 0:
        return 10 + r2
    let r3 = test_chain()
    if r3 != 0:
        return 20 + r3
    let r4 = test_const()
    if r4 != 0:
        return 30 + r4
    let r5 = test_neg()
    if r5 != 0:
        return 40 + r5
    return 0

main()
