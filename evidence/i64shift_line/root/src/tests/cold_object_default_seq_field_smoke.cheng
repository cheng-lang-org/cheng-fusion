type
    ColdDefaultSeqPlan =
        command: str
        prompt: str
        images: str[]
        model: str
        cwd: str
        configOverrides: str[]
        addDirs: str[]
        maxTurns: int32

fn ColdDefaultSeqPlanDefault(): ColdDefaultSeqPlan =
    var result: ColdDefaultSeqPlan
    result.command = "run"
    result.maxTurns = 7
    return result

fn ColdDefaultSeqPlanParse(args: str[]): ColdDefaultSeqPlan =
    var plan = ColdDefaultSeqPlanDefault()
    if args.len > 0:
        plan.model = args[0]
    return plan

fn ColdDefaultSeqPlanCheck(plan: var ColdDefaultSeqPlan): int32 =
    if plan.configOverrides.len != 0:
        return 10
    if plan.addDirs.len != 0:
        return 11
    if plan.images.len != 0:
        return 12
    if plan.command != "run":
        return 13
    if plan.maxTurns != 7:
        return 14
    return 0

fn ColdDefaultSeqPlanWrapper(plan: var ColdDefaultSeqPlan): int32 =
    if plan.model == "":
        return 20
    return ColdDefaultSeqPlanCheck(plan)

fn main(): int32 =
    var args: str[]
    add(args, "gpt-5")
    var plan = ColdDefaultSeqPlanParse(args)
    let rc = ColdDefaultSeqPlanWrapper(plan)
    if rc != 0:
        return rc
    echo("cold_object_default_seq_field_smoke ok")
    return 0
