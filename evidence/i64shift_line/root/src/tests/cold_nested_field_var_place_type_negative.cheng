type NegTypeLeaf = ref object
    value: int32

type NegTypeOther = ref object
    value: int32

type NegTypeHolder =
    other: NegTypeOther

fn NegTypeLeafBump(leaf: var NegTypeLeaf) =
    leaf.value = leaf.value + 1

# Same place shape but the field's ref type differs from the formal's: the
# per-hop exact-type proof must keep rejecting it.
fn NegTypeHolderBump(holder: var NegTypeHolder) =
    NegTypeLeafBump(holder.other)

fn main(): int32 =
    var holder: NegTypeHolder
    NegTypeHolderBump(holder)
    return 0
