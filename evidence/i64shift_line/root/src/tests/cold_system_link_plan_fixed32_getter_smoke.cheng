import cheng/std/bytes_layout as layout

type
    SystemLinkPlanStub =
        sourceBundleCidValue: layout.FixedBytes32

@borrows
fn SystemLinkPlanSourceBundleCidValue(
        plan: var SystemLinkPlanStub): layout.FixedBytes32 =
    return plan.sourceBundleCidValue

fn main(): int32 =
    var plan: SystemLinkPlanStub
    let value = SystemLinkPlanSourceBundleCidValue(plan)
    if !layout.FixedBytes32Equal(value, layout.FixedBytes32()):
        return 1
    return 0
