import std/cmdline as cmdline
import std/result
import std/strformat
import cheng/core/ir/body_ir_access as access
import cheng/core/ir/core_types as coreir
import cheng/core/lang/typed_expr_type_arena as typearena
import cheng/std/bytes_layout as layout

fn fixtureCid(): layout.FixedBytes32 =
    let parsed = layout.FixedBytes32FromHex(
        "8181818181818181818181818181818181818181818181818181818181818181")
    if IsErr(parsed):
        panic("borrow owner CFG: CID fixture")
    return Value(parsed)

fn addManagedSlot(body: var coreir.BodyIR,
                  name: str): int32 =
    var slot: coreir.LocalSlot
    slot.id = body.localSlots.len
    slot.name = name
    slot.typeKind = coreir.LocalStrTag
    slot.stackOffset = slot.id * 24
    slot.sizeBytes = 24
    slot.alignBytes = 8
    coreir.BodyIRApplyLocalSlotDefaultProof(slot)
    add(body.localSlots, slot)
    if !coreir.BodyIRBindLocalSlotTypeArenaProof(
           body,
           slot.id,
           fixtureCid(),
           7,
           coreir.BodyManagedStorageManagedTag):
        panic("borrow owner CFG: slot type proof")
    return slot.id

fn appendDefinition(body: var coreir.BodyIR,
                    slotId: int32,
                    semanticRow: int32,
                    ownership: coreir.OwnershipKind,
                    ownerSemanticRow: int32,
                    ownerOpRow: int32): int32 =
    var call: coreir.CallOp
    coreir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = "borrow_owner_cfg_definition"
    call.resultSlot = slotId
    call.resultPassKind = coreir.BodyCallPassSretResultTag
    call.resultOwnership = ownership
    call.resultExprNodeIndex = semanticRow
    call.resultValueDefinitionRow = semanticRow
    call.resultBorrowOwnerValueDefinitionRow = ownerSemanticRow
    if ownerOpRow >= 0:
        call.resultBorrowOwnerDefinitionDomain =
            coreir.BodyDefinitionDomainBodyOpTag
    call.resultBorrowOwnerDefinitionRow = ownerOpRow
    call.resultDefinitionOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    call.resultDefinitionOriginId = semanticRow
    let callRow = body.callSequence.len
    add(body.callSequence, call)

    var op: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = coreir.BodyOpCallTag
    op.target = slotId
    op.valueDefSlot = slotId
    op.valueDefExprNodeIndex = semanticRow
    op.valueDefSemanticRow = semanticRow
    op.valueDefOwnership = ownership
    op.valueDefBorrowOwnerSemanticRow = ownerSemanticRow
    if ownerOpRow >= 0:
        op.valueDefBorrowOwnerDefinitionDomain =
            coreir.BodyDefinitionDomainBodyOpTag
    op.valueDefBorrowOwnerDefinitionRow = ownerOpRow
    op.valueDefOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    op.valueDefOriginId = semanticRow
    add(op.operands, callRow)
    return coreir.BodyIRAppendOp(body, op)

fn appendOwnerConsume(body: var coreir.BodyIR,
                      ownerSlot: int32,
                      ownerOpRow: int32) =
    let actionRow = body.ops.len
    var call: coreir.CallOp
    coreir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = "borrow_owner_cfg_consume"
    add(call.argSlots, ownerSlot)
    add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(call.argAbiSizes, 8)
    call.sourceDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    call.sourceDefinitionRow = ownerOpRow
    call.consumeActionRow = actionRow
    call.managedStoreKind = coreir.ManagedStoreStrMoveTag
    let callRow = body.callSequence.len
    add(body.callSequence, call)

    var op: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = coreir.BodyOpCallTag
    add(op.operands, callRow)
    op.sourceDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    op.sourceDefinitionRow = ownerOpRow
    op.consumeActionRow = actionRow
    body.ops[ownerOpRow].valueDefConsumeOpIndexPlusOne =
        body.ops.len + 1
    body.ops[ownerOpRow].consumeActionRow = actionRow
    let _ = coreir.BodyIRAppendOp(body, op)

@borrows
fn buildBody(mode: str): coreir.BodyIR =
    var body = coreir.BodyIRNew()
    if !coreir.BodyIRBindTypeArenaArtifactCid(
           body, fixtureCid()) ||
       !coreir.BodyIRBindCanonicalTypeFact(
           body,
           fixtureCid(),
           7,
           Int32(typearena.TypedExprStructuralTypeScalar),
           Int32(typearena.TypedExprStructuralScalarStr),
           -1,
           0,
           24,
           8):
        panic("borrow owner CFG: type authority")
    let ownerSlot = addManagedSlot(body, "owner")
    let borrowSlot = addManagedSlot(body, "borrow")
    let ownerOp = appendDefinition(
        body, ownerSlot, 10, coreir.OwnMove, -1, -1)
    let borrowOp = appendDefinition(
        body,
        borrowSlot,
        11,
        coreir.OwnBorrowShared,
        10,
        ownerOp)
    if mode == "overwrite":
        appendOwnerConsume(body, ownerSlot, ownerOp)

    var ownershipKinds: int32[]
    add(ownershipKinds, int32(coreir.OwnInvalid))
    add(ownershipKinds, int32(coreir.OwnInvalid))
    coreir.BodyIRFreezeEntryDefinitionOwnershipKinds(
        body, ownershipKinds)
    var term: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = coreir.BodyTermReturnTag
    if mode == "positive":
        term.resultSlot = ownerSlot
        term.sourceDefinitionDomain =
            coreir.BodyDefinitionDomainBodyOpTag
        term.sourceDefinitionRow = ownerOp
    elif mode == "borrow-return":
        term.resultSlot = borrowSlot
        term.sourceDefinitionDomain =
            coreir.BodyDefinitionDomainBodyOpTag
        term.sourceDefinitionRow = borrowOp
    let termRow = coreir.BodyIRAppendTerm(body, term)
    let _ = coreir.BodyIRAppendBlock(
        body, 0, body.ops.len, termRow)
    coreir.BodyIRControlFlowBegin(body, 0)
    coreir.BodyIRControlFlowBindBlockScope(body, 0, 0)
    for callRow in 0..<body.callSequence.len:
        var domain = coreir.BodyCallTargetDomainFunctionTag
        var targetRow: int32
        if callRow >= 2:
            domain = coreir.BodyCallTargetDomainRuntimeIntrinsicTag
            targetRow = coreir.ManagedStoreStrMoveTag
        coreir.BodyIRControlFlowBindCallTarget(
            body,
            callRow,
            domain,
            targetRow,
            fixtureCid())
    var successors: int32[]
    var edgeKinds: int32[]
    coreir.BodyIRControlFlowBindTermSuccessors(
        body, termRow, successors, edgeKinds)
    coreir.BodyIRControlFlowSeal(body)
    return body

fn main(): int32 =
    let mode = cmdline.ParamStr(1)
    var body = buildBody(mode)
    var decoded = access.BodyIrAccessDecode(body)
    if mode == "positive":
        if !access.BodyIrAccessTableIsValid(decoded):
            panic(Fmt"borrow owner CFG positive invalid code={decoded.errorCode} site={decoded.errorSiteKind}:{decoded.errorSiteIndex} detail={decoded.errorDetail}")
        echo("borrow_owner_cfg_lifetime_smoke ok")
        return 0
    if access.BodyIrAccessTableIsValid(decoded):
        panic("borrow owner CFG negative accepted")
    panic(Fmt"borrow owner CFG rejected code={decoded.errorCode} site={decoded.errorSiteKind}:{decoded.errorSiteIndex} detail={decoded.errorDetail}")
