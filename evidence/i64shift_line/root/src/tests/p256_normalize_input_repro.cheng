import std/system
import std/result
import std/crypto/bigint
import std/crypto/p256_fixed as pfix

# Directly exercise p256FixedNormalizeInput, whose early-return arm is
# `return Ok[P256Fixed](value)` with `value: var P256Fixed`. Before the cold
# root-fix this died at compile time with "Ok value kind mismatch"; 0bd38b60f
# worked around it in the library by copying to a fresh local first. This
# fixture pins that the bare form now both compiles AND returns correct values.
fn main(): int32 =
    var small: bigint.BigInt = bigint.bigFromInt(42)
    let sfRes: Result[pfix.P256Fixed] = pfix.p256FixedFromBigInt(small)
    if IsErr(sfRes):
        echo("repro: from bigint err")
        return 1
    var sf: pfix.P256Fixed = Value(sfRes)
    var modulus: pfix.P256Fixed = pfix.p256FieldModulus()
    let normRes: Result[pfix.P256Fixed] = pfix.p256FixedNormalizeInput(sf, modulus)
    if IsErr(normRes):
        echo("repro: normalize err")
        return 1
    var norm: pfix.P256Fixed = Value(normRes)
    let back: bigint.BigInt = pfix.p256FixedToBigInt(norm)
    if bigint.bigCmp(back, small) == 0:
        echo("p256_normalize_input_repro ok value_roundtrip=42")
        return 0
    echo("p256_normalize_input_repro FAIL wrong_value")
    return 2
