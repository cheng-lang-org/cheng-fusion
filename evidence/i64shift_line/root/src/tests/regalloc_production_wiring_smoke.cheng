import cheng/core/backend/lowering_plan as lower
import cheng/core/backend/primary_object_plan as primary
import cheng/core/backend/regalloc_production_emitter as emitter
import cheng/core/backend/regalloc_production_artifacts as artifacts
import cheng/core/backend/regalloc_single_pass as alloc
import cheng/core/ir/core_types as ir
import cheng/core/ir/body_ir_access as access
import cheng/core/tooling/backend_driver_dispatch_min as driver
import cheng/std/bytes_layout as layout
import cheng/core/backend/regalloc_aarch64_adapter as rega64

fn wiringTypeArenaArtifactCid(): layout.FixedBytes32 =
    let parsed = layout.FixedBytes32FromHex(
        "7777777777777777777777777777777777777777777777777777777777777777")
    assert(parsed.ok, " regalloc wiring: type arena CID fixture invalid")
    return parsed.value

fn checkBridgeBody(bodyKind: str,
                   expectedTarget: str,
                   expectedSlotCount: int32,
                   expectedArgCount: int32,
                   expectedResultSlot: int32,
                   expectedResultPass: int32,
                   expectSretForward: bool): int32 =
    var body =
        primary.PrimaryObjectPlanRegallocCallIndirectBridgeBodyIr(
            bodyKind, wiringTypeArenaArtifactCid())
    let dod = ir.BodyIRDodSoAContractCheck(body)
    let table = access.BodyIrAccessDecode(body)
    if !dod.ok || !table.valid || !body.entryIsCAbi ||
       body.localSlots.len != expectedSlotCount ||
       body.callSequence.len != 1 || body.ops.len != 1 ||
       body.blocks.len != 1 || body.terms.len != 1:
        return 1
    let call = body.callSequence[0]
    if call.targetSymbol != expectedTarget ||
       call.argSlots.len != expectedArgCount ||
       call.argPassKinds.len != expectedArgCount ||
       call.argAbiSizes.len != expectedArgCount ||
       call.resultSlot != expectedResultSlot ||
       call.resultPassKind != expectedResultPass ||
       body.ops[0].kind != ir.BodyOpCallTag ||
       body.ops[0].target != expectedResultSlot ||
       body.ops[0].operands.len != 1 ||
       body.ops[0].operands[0] != 0 ||
       body.terms[0].kind != ir.BodyTermReturnTag ||
       body.terms[0].resultSlot != expectedResultSlot:
        return 2
    var forwardFactCount: int32
    for factIndex in 0..<table.facts.len:
        let fact = table.facts[factIndex]
        if fact.fixedKind == access.BodyIrAccessFixedSretForward:
            if fact.kind != access.BodyIrAccessFactFixed ||
               fact.passKind != ir.BodyCallPassForwardEntrySretTag ||
               fact.callOrdinal != 0:
                return 3
            forwardFactCount = forwardFactCount + 1
    if (expectSretForward && forwardFactCount != 1) ||
       (!expectSretForward && forwardFactCount != 0):
        return 4
    var callTargets: str[]
    add(callTargets, "")
    var dataTargets: str[]
    let emitted = emitter.RegallocProductionEmitFunction(
        "arm64-apple-darwin",
        body, expectedTarget, 0, callTargets, dataTargets,
        0, artifacts.RegallocProductionFunctionKindNormal)
    if !emitted.valid || !emitted.receipt.valid ||
       emitted.recipeOrigin !=
           artifacts.RegallocProductionRecipeOriginBodyIrAdapter:
        return 5
    var forwardActionCount: int32
    for actionIndex in 0..<emitted.plan.actions.len:
        let action = emitted.plan.actions[actionIndex]
        if action.kind != alloc.RegallocValueActionSretForward:
            continue
        if action.fixedKind != access.BodyIrAccessFixedSretForward ||
           action.passKind != ir.BodyCallPassForwardEntrySretTag ||
           action.semanticKind != ir.BodyOpCallTag ||
           action.semanticRegister != 8 || action.callOrdinal != 0:
            return 6
        forwardActionCount = forwardActionCount + 1
    if (expectSretForward && forwardActionCount != 1) ||
       (!expectSretForward && forwardActionCount != 0):
        return 7
    return 0

fn main(): int32 =
    # B1: codegen unit composition root (dispatch fails closed without registration)
    if !rega64.RegallocA64CodegenUnitRegister():
        return 90
    if !lower.LoweringRegallocCanonicalAllocatorImportBound():
        return 1
    if len(lower.LoweringRegallocProductionReceiptMissingDependency()) != 0:
        return 2
    var objectPlan: primary.PrimaryObjectPlan
    var receipt: driver.BackendDriverDispatchMinRegallocReceipt
    if objectPlan.regallocFunctionSymbols.len != 0 || receipt.valid:
        return 3
    primary.PrimaryObjectPlanRegallocFunctionIndexInit(
        objectPlan, 4)
    if !primary.PrimaryObjectPlanRegallocFunctionIdentityCanAppend(
           objectPlan, 7,
           artifacts.RegallocProductionFunctionKindNormal,
           "_identity_a") ||
       primary.PrimaryObjectPlanRegallocFunctionIdentityCanAppend(
           objectPlan, -1,
           artifacts.RegallocProductionFunctionKindNormal,
           "_identity_invalid_normal") ||
       primary.PrimaryObjectPlanRegallocFunctionIdentityCanAppend(
           objectPlan, 7,
           artifacts.RegallocProductionFunctionKindEntryBridge,
           "_identity_invalid_entry"):
        return 4
    if artifacts.RegallocProductionFunctionIndexAppend(
           objectPlan.regallocFunctionIndex, 7,
           artifacts.RegallocProductionFunctionKindNormal,
           "_identity_a") !=
           artifacts.RegallocProductionFunctionIndexAppendOk:
        return 5
    add(objectPlan.regallocFunctionSymbols, "_identity_a")
    add(objectPlan.regallocFunctionIrIndexes, 7)
    add(objectPlan.regallocFunctionKinds,
        artifacts.RegallocProductionFunctionKindNormal)
    if primary.PrimaryObjectPlanRegallocFunctionIdentityCanAppend(
           objectPlan, 7,
           artifacts.RegallocProductionFunctionKindNormal,
           "_identity_duplicate_id") ||
       primary.PrimaryObjectPlanRegallocFunctionIdentityCanAppend(
           objectPlan, 8,
           artifacts.RegallocProductionFunctionKindNormal,
           "_identity_a") ||
       !primary.PrimaryObjectPlanRegallocFunctionIdentityCanAppend(
           objectPlan, -1,
           artifacts.RegallocProductionFunctionKindEntryBridge,
           "_identity_entry"):
        return 6
    if artifacts.RegallocProductionFunctionIndexAppend(
           objectPlan.regallocFunctionIndex, -1,
           artifacts.RegallocProductionFunctionKindEntryBridge,
           "_identity_entry") !=
           artifacts.RegallocProductionFunctionIndexAppendOk:
        return 7
    add(objectPlan.regallocFunctionSymbols, "_identity_entry")
    add(objectPlan.regallocFunctionIrIndexes, -1)
    add(objectPlan.regallocFunctionKinds,
        artifacts.RegallocProductionFunctionKindEntryBridge)
    if primary.PrimaryObjectPlanRegallocFunctionIdentityCanAppend(
           objectPlan, -1,
           artifacts.RegallocProductionFunctionKindEntryBridge,
           "_identity_duplicate_entry") ||
       primary.PrimaryObjectPlanRegallocFunctionIdentityCanAppend(
           objectPlan, 8,
           artifacts.RegallocProductionFunctionKindNormal,
           "_identity_entry"):
        return 8
    let voidBridge = checkBridgeBody(
        primary.PrimaryBodyKindCallIndirectVoidBridge(),
        "cheng_call_ptr_void_raw", 2, 2, -1,
        ir.BodyCallPassStackValueTag, false)
    if voidBridge != 0:
        return 10 + voidBridge
    let i32Bridge = checkBridgeBody(
        primary.PrimaryBodyKindCallIndirectI32Bridge(),
        "cheng_call_ptr_i32_raw", 5, 4, 4,
        ir.BodyCallPassStackValueTag, false)
    if i32Bridge != 0:
        return 20 + i32Bridge
    let sretBridge = checkBridgeBody(
        primary.PrimaryBodyKindCallIndirectSretAgg1Bridge(),
        "cheng_call_ptr_sret_agg1_raw", 2, 2, -1,
        ir.BodyCallPassForwardEntrySretTag, true)
    if sretBridge != 0:
        return 30 + sretBridge
    return 0
