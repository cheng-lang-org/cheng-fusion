type
    R23NgProfile =
        text: str
        lines: str[]

fn R23NgSplit(textRaw: str): str[] =
    var out: str[]
    add(out, textRaw)
    return out

fn R23NgBuild(text: str, profile: var R23NgProfile): bool =
    var normalizedText: str
    normalizedText = text
    profile.text = normalizedText
    let lines = R23NgSplit(normalizedText)
    profile.lines = lines
    return true

fn main(): int32 =
    var profile: R23NgProfile
    if !R23NgBuild("alpha", profile):
        return 10
    echo("r23 noguard ok")
    return 0
