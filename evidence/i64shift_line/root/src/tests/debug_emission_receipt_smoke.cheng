fn TestCid(label: str): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(label.len)
    for index in 0..<label.len:
        layout.ByteBufAppendByte(buf, Int32(label[index]) & 255)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn TestCidLess(left: layout.FixedBytes32,
               right: layout.FixedBytes32): bool =
    for index in 0..<layout.FixedBytes32Size:
        if left.data[index] < right.data[index]:
            return true
        if left.data[index] > right.data[index]:
            return false
    return false

fn BuildSnapshot(predecessor: layout.FixedBytes32,
                 documentCid: layout.FixedBytes32):
                 schema.CsgCompilerSnapshotTables =
    var out: schema.CsgCompilerSnapshotTables
    out.schemaVersion = schema.CsgCompilerSnapshotSchemaVersionLatest
    out.semanticEpoch = 1
    out.predecessorReceiptCid = predecessor
    out.texts = ["Main", "fn Main", "int32", "pkg/main",
                 "pkg/main::Main", "zz fn() int32"]
    out.sources.documentCids = [documentCid]
    out.sources.modulePathTextIds = [3]
    out.sources.contentCids = [TestCid("emission/content")]
    out.sources.interfaceCids = [TestCid("emission/module-interface")]
    out.spans.sourceIds = [0, 0, 0, 0, 0]
    out.spans.startBytes = [0, 0, 8, 21, 28]
    out.spans.endBytes = [7, 20, 12, 32, 32]
    out.spans.startLines = [0, 0, 1, 3, 3]
    out.spans.startColumns = [0, 0, 4, 0, 7]
    out.spans.endLines = [0, 2, 1, 3, 3]
    out.spans.endColumns = [7, 0, 8, 11, 11]
    out.parserNodes.sourceIds = [0]
    out.parserNodes.producerNodeIds = [0]
    out.parserNodes.parentNodeIds = [-1]
    out.parserNodes.kinds = [1]
    out.parserNodes.spanIds = [2]
    out.parserNodes.childStarts = [0]
    out.parserNodes.childCounts = [0]
    out.parserNodes.genericStarts = [0]
    out.parserNodes.genericCounts = [0]
    out.parserNodes.bindingResolutionKinds = [0]
    out.parserNodes.bindingDeclarationSourceLocalRows = [-1]
    out.parserNodes.bindingPatternSourceLocalRows = [-1]
    out.tokens.sourceIds = [0, 0]
    out.tokens.sourceLocalRows = [0, 1]
    out.tokens.lexicalParentTokenIds = [-1, -1]
    out.tokens.spanIds = [0, 4]
    out.tokens.kinds = [1, 1]
    out.tokens.valueTextIds = [0, 3]
    out.parserSidecars.sourceIds = [0]
    out.parserSidecars.producerSourceIndexes = [0]
    out.parserSidecars.parserInputCids = [TestCid("emission/parser-input")]
    out.parserSidecars.sidecarCids = [TestCid("emission/parser-sidecar")]
    out.parserSidecars.declarationProducerSourceIds = [0, 0]
    out.parserSidecars.declarationSourceLocalRows = [0, 1]
    out.parserSidecars.declarationKinds = [1, 3]
    out.parserSidecars.declarationNameTokenIds = [1, 0]
    out.parserSidecars.declarationOwnerIds = [-1, 0]
    out.parserSidecars.declarationLexicalScopeIds = [0, 0]
    out.parserSidecars.declarationFunctionRows = [-1, 0]
    out.parserSidecars.declarationTypeSyntaxRootIds = [-1, -1]
    out.parserSidecars.declarationDefaultStatementRootRows = [-1, -1]
    out.parserSidecars.declarationSpanIds = [3, 1]
    out.parserSidecars.declarationNameSpanIds = [4, 0]
    add(out.parserSidecars.declarationMutableFlags, false)
    add(out.parserSidecars.declarationMutableFlags, false)
    add(out.parserSidecars.declarationExportedFlags, false)
    add(out.parserSidecars.declarationExportedFlags, true)
    out.parserSidecars.declarationLexicalScopeProducerSourceIds = [0]
    out.parserSidecars.declarationLexicalScopeSourceLocalRows = [0]
    out.parserSidecars.declarationLexicalScopeKinds = [1]
    out.parserSidecars.declarationLexicalScopeParentIds = [-1]
    out.parserSidecars.declarationLexicalScopeOwnerDeclarationIds = [-1]
    out.parserSidecars.rootNodeIds = [0]
    out.parserSidecars.statementRootNodeIds = [0]
    out.parserSidecars.statementRootRoles = [2]
    out.parserSidecars.statementRootAnchorTokenIds = [0]
    out.parserSidecars.statementRootBindingDeclarationStarts = [-1]
    out.parserSidecars.statementRootBindingDeclarationCounts = [0]
    out.parserSidecars.statementRootAnchorLines = [0]
    out.parserSidecars.statementRootAnchorColumns = [0]
    out.parserSidecars.statementRootEndLines = [2]
    out.parserSidecars.statementRootEndColumns = [0]
    out.parserSidecars.functionIndexes = [0]
    out.parserSidecars.functionNameTextIds = [0]
    out.parserSidecars.functionNameSurfaceKinds = [
        declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier]
    let functionNameProofCid = TestCid("emission/function-name-proof")
    out.parserSidecars.functionNameProofCids = [functionNameProofCid]
    out.parserSidecars.functionSignatureLineNumbers = [1]
    out.parserSidecars.functionDeclarationSpanIds = [1]
    out.parserSidecars.functionDeclarationHeaderCids = [
        TestCid("emission/declaration-header-main")]
    out.parserSidecars.functionDeclarationPathCids = [
        TestCid("emission/declaration-path-main")]
    out.parserSidecars.functionNameSpanIds = [0]
    out.parserSidecars.functionBodySpanIds = [2]
    add(out.parserSidecars.functionAnnotationFlags, 0)
    out.types.typeCids = [TestCid("emission/type-int32"),
                          TestCid("emission/type-main-signature")]
    out.types.producerTypeArenaIds = [0, -1]
    out.types.canonicalTextIds = [2, 5]
    out.types.typeKinds = [schema.CsgCompilerTypeScalar,
                           schema.CsgCompilerTypeFunction]
    out.types.scalarKinds = [schema.CsgCompilerScalarInt32, 0]
    out.types.declSymbolIds = [-1, -1]
    out.types.elementTypeIds = [-1, 0]
    out.types.arrayLengths = [-1, -1]
    out.types.argStarts = [0, 0]
    out.types.argCounts = [0, 0]
    out.types.constArgStarts = [0, 0]
    out.types.constArgCounts = [0, 0]
    out.types.aliasTargetTypeIds = [-1, -1]
    out.types.genericParameterParserRows = [-1, -1]
    add(out.types.managedFlags, false)
    add(out.types.managedFlags, false)
    add(out.types.sendFlags, true)
    add(out.types.sendFlags, false)
    add(out.types.syncFlags, true)
    add(out.types.syncFlags, false)
    out.types.traitConclusionKinds = [
        schema.CsgCompilerTraitConclusionExact,
        schema.CsgCompilerTraitConclusionNone]
    out.types.traitProofKinds = [
        schema.CsgCompilerTraitProofBuiltin,
        schema.CsgCompilerTraitProofStructural]
    out.types.traitProofCids = [TestCid("emission/scalar-trait"),
                                TestCid("emission/function-trait")]
    out.types.traitPremiseStarts = [0, 0]
    out.types.traitPremiseCounts = [0, 1]
    out.types.traitPremiseTypeIds = [0]
    # [phaseB-enum-schema] Enum variant payload CSR columns; zero variant
    # rows for scalar/signature fixtures.
    out.types.variantStarts = [0, 0]
    out.types.variantCounts = [0, 0]
    out.lexicalScopes.sourceIds = [0]
    out.lexicalScopes.spanIds = [1]
    out.lexicalScopes.parentScopeIds = [-1]
    out.lexicalScopes.visibleStarts = [0]
    out.lexicalScopes.visibleCounts = [1]
    out.functions.symbolIds = [-1]
    out.functions.typedFunctionIndexes = [0]
    out.functions.bodySpanIds = [2]
    out.functions.bodyContentCids = [TestCid("emission/function-body")]
    out.functions.fragmentCids = [TestCid("emission/function-fragment")]
    out.functions.interfaceCids = [
        TestCid("emission/provisional-function-interface")]
    add(out.functions.annotationFlags, 0)
    add(out.functions.resultOwnershipKinds,
        schema.CsgCompilerOwnershipOwned)
    out.functions.parameterOwnershipStarts = [0]
    out.functions.parameterOwnershipCounts = [0]
    out.functions.valueDefinitionStarts = [0]
    out.functions.valueDefinitionCounts = [0]
    out.functions.valueDefinitionGroupStarts = [0]
    out.functions.valueDefinitionGroupCounts = [0]
    out.functions.readStarts = [0]
    out.functions.readCounts = [0]
    var readSetPreimageCid: layout.FixedBytes32
    var err: str
    assert(schema.CsgCompilerReadSetPreimageCidInto(
               TestCid("emission/provisional-function-symbol"),
               out.readSet.targetDomainKinds,
               out.readSet.targetPortableKeyCids,
               out.readSet.observedValueCids,
               0, 0, readSetPreimageCid, err), err)
    out.functions.readSetPreimageCids = [readSetPreimageCid]
    out.functions.nodeStarts = [0]
    out.functions.nodeCounts = [1]
    out.layouts.layoutCids = [TestCid("emission/layout-int32")]
    out.layouts.typeIds = [0]
    out.layouts.sizeBytes = [4]
    out.layouts.alignBytes = [4]
    out.layouts.fieldStarts = [0]
    out.layouts.fieldCounts = [0]
    out.typedNodes.functionIds = [0]
    out.typedNodes.originParserNodeIds = [0]
    out.typedNodes.bindingProducerSourceIndexes = [-1]
    out.typedNodes.bindingParserSourceLocalNodeRows = [-1]
    out.typedNodes.bindingDeclarationSourceLocalRows = [-1]
    out.typedNodes.bindingPatternSourceLocalRows = [-1]
    out.typedNodes.bindingValueDefinitionRows = [-1]
    out.typedNodes.producedValueDefinitionRows = [-1]
    out.typedNodes.ownerStatementIds = [0]
    out.typedNodes.syntheticOriginKinds = [0]
    out.typedNodes.spanAuthorityKinds = [1]
    out.typedNodes.typedIrNodeIndexes = [0]
    out.typedNodes.opKinds = [int32(texpr.TypedExprIrOpI32Const)]
    out.typedNodes.typeIds = [0]
    out.typedNodes.valueKinds = [schema.CsgCompilerValueOrdinary]
    out.typedNodes.captureStarts = [0]
    out.typedNodes.captureCounts = [0]
    out.typedNodes.ownershipKinds = [schema.CsgCompilerOwnershipUnmanaged]
    out.typedNodes.ownershipProofKinds = [
        schema.CsgCompilerValueProofTypeTrait]
    out.typedNodes.ownershipProofCids = [
        TestCid("emission/ownership-proof")]
    add(out.typedNodes.sendConclusions, true)
    out.typedNodes.sendProofKinds = [
        schema.CsgCompilerValueProofTypeTrait]
    out.typedNodes.sendProofCids = [TestCid("emission/send-proof")]
    out.typedNodes.syncProofKinds = [
        schema.CsgCompilerValueProofTypeTrait]
    out.typedNodes.syncProofCids = [TestCid("emission/sync-proof")]
    add(out.typedNodes.syncConclusions, true)
    out.typedNodes.shareKinds = [schema.CsgCompilerShareNone]
    out.typedNodes.shareProofCids = [TestCid("emission/share-proof")]
    out.typedStatements.typedIrStatementIndexes = [0]
    out.typedStatements.functionIds = [0]
    out.typedStatements.rootStarts = [0]
    out.typedStatements.rootCounts = [1]
    out.typedStatements.rootTypedNodeIds = [0]
    out.typedNodes.spanIds = [2]
    out.typedNodes.operand0NodeIds = [-1]
    out.typedNodes.operand1NodeIds = [-1]
    out.typedNodes.operand2NodeIds = [-1]
    out.debugOps.typedNodeIds = [0]
    out.debugOps.functionIds = [0]
    out.debugOps.spanIds = [2]
    out.debugOps.symbolIds = [-1]
    out.debugOps.opKinds = [7]
    var proofErr: str
    var scalarTraitProofCid: layout.FixedBytes32
    assert(schema.CsgCompilerTypeTraitProofCidInto(
               out, 0, scalarTraitProofCid, proofErr), proofErr)
    out.types.traitProofCids[0] = scalarTraitProofCid
    var scalarTypeCid: layout.FixedBytes32
    assert(schema.CsgCompilerTypeRowCidInto(
               out, 0, scalarTypeCid, proofErr), proofErr)
    out.types.typeCids[0] = scalarTypeCid
    var functionTraitProofCid: layout.FixedBytes32
    assert(schema.CsgCompilerTypeTraitProofCidInto(
               out, 1, functionTraitProofCid, proofErr), proofErr)
    out.types.traitProofCids[1] = functionTraitProofCid
    var functionTypeCid: layout.FixedBytes32
    assert(schema.CsgCompilerTypeRowCidInto(
               out, 1, functionTypeCid, proofErr), proofErr)
    out.types.typeCids[1] = functionTypeCid
    var scalarTypeId: int32
    var functionTypeId: int32 = 1
    if TestCidLess(functionTypeCid, scalarTypeCid):
        out.types.typeCids = [functionTypeCid, scalarTypeCid]
        out.types.producerTypeArenaIds = [-1, 0]
        out.types.canonicalTextIds = [5, 2]
        out.types.typeKinds = [schema.CsgCompilerTypeFunction,
                               schema.CsgCompilerTypeScalar]
        out.types.scalarKinds = [0, schema.CsgCompilerScalarInt32]
        out.types.declSymbolIds = [-1, -1]
        out.types.elementTypeIds = [1, -1]
        out.types.arrayLengths = [-1, -1]
        out.types.argStarts = [0, 0]
        out.types.argCounts = [0, 0]
        out.types.constArgStarts = [0, 0]
        out.types.constArgCounts = [0, 0]
        out.types.aliasTargetTypeIds = [-1, -1]
        out.types.genericParameterParserRows = [-1, -1]
        out.types.managedFlags = []
        add(out.types.managedFlags, false)
        add(out.types.managedFlags, false)
        out.types.sendFlags = []
        add(out.types.sendFlags, false)
        add(out.types.sendFlags, true)
        out.types.syncFlags = []
        add(out.types.syncFlags, false)
        add(out.types.syncFlags, true)
        out.types.traitConclusionKinds = [
            schema.CsgCompilerTraitConclusionNone,
            schema.CsgCompilerTraitConclusionExact]
        out.types.traitProofKinds = [
            schema.CsgCompilerTraitProofStructural,
            schema.CsgCompilerTraitProofBuiltin]
        out.types.traitProofCids = [functionTraitProofCid,
                                    scalarTraitProofCid]
        out.types.traitPremiseStarts = [0, 1]
        out.types.traitPremiseCounts = [1, 0]
        out.types.traitPremiseTypeIds = [1]
        # [phaseB-enum-schema] Zero variant rows for this fixture.
        out.types.variantStarts = [0, 0]
        out.types.variantCounts = [0, 0]
        scalarTypeId = 1
        functionTypeId = 0
    out.layouts.typeIds[0] = scalarTypeId
    out.typedNodes.typeIds[0] = scalarTypeId
    var declarationCandidates: declaration.SemanticSnapshotDeclarationCandidateStore
    declaration.SemanticSnapshotDeclarationCandidateStoreInitInto(
        declarationCandidates)
    var moduleCandidateIndex: int32
    assert(declaration.SemanticSnapshotDeclarationCandidateAppendInto(
               declarationCandidates, "pkg", "pkg/main", documentCid, "",
               -1, declaration.SemanticSnapshotDeclarationKindModule,
               declaration.SemanticSnapshotDeclarationNameSurfaceModulePath,
               "pkg/main", documentCid, documentCid,
               layout.FixedBytes32(), 0, 0, moduleCandidateIndex,
               proofErr), proofErr)
    var functionCandidateIndex: int32
    assert(declaration.SemanticSnapshotDeclarationCandidateAppendInto(
               declarationCandidates, "pkg", "pkg/main", documentCid, "",
               moduleCandidateIndex,
               declaration.SemanticSnapshotDeclarationKindFunction,
               declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
               "Main", functionNameProofCid, functionTypeCid,
               layout.FixedBytes32(), 0, 20, functionCandidateIndex,
               proofErr), proofErr)
    var declarationMapping: declaration.SemanticSnapshotDeclarationMappingReceipt
    assert(declaration.SemanticSnapshotDeclarationTableSealInto(
               declarationCandidates, out.declarations,
               declarationMapping, proofErr), proofErr)
    let functionDeclId =
        declarationMapping.producerCandidateToDeclIds[functionCandidateIndex]
    let moduleDeclId =
        declarationMapping.producerCandidateToDeclIds[moduleCandidateIndex]
    let moduleSymbolCid =
        out.declarations.declKeyCids[moduleDeclId]
    let functionSymbolCid =
        out.declarations.declKeyCids[functionDeclId]
    let moduleSymbolId =
        TestCidLess(moduleSymbolCid, functionSymbolCid) ? 0 : 1
    let functionSymbolId = 1 - moduleSymbolId
    setLen(out.symbols.symbolCids, 2)
    setLen(out.symbols.interfaceCids, 2)
    setLen(out.symbols.declIds, 2)
    setLen(out.symbols.declKeyCids, 2)
    setLen(out.symbols.declarationHeaderCids, 2)
    setLen(out.symbols.declarationPathCids, 2)
    setLen(out.symbols.sourceIds, 2)
    setLen(out.symbols.nameTextIds, 2)
    setLen(out.symbols.nameSpanIds, 2)
    setLen(out.symbols.nameTokenIds, 2)
    setLen(out.symbols.qualifiedNameTextIds, 2)
    setLen(out.symbols.symbolKinds, 2)
    setLen(out.symbols.typeIds, 2)
    setLen(out.symbols.declarationSpanIds, 2)
    setLen(out.symbols.ownerSymbolIds, 2)
    setLen(out.symbols.functionIds, 2)
    out.symbols.exportedFlags = []
    add(out.symbols.exportedFlags, false)
    add(out.symbols.exportedFlags, false)
    setLen(out.symbols.genericConstraintStarts, 2)
    setLen(out.symbols.genericConstraintCounts, 2)
    out.symbols.genericParameterParserRows = [-1, -1]
    out.symbols.genericParameterOrdinals = [-1, -1]
    out.symbols.genericParameterDefaultTypeIds = [-1, -1]
    out.symbols.symbolCids[moduleSymbolId] = moduleSymbolCid
    out.symbols.declIds[moduleSymbolId] = moduleDeclId
    out.symbols.declKeyCids[moduleSymbolId] = moduleSymbolCid
    out.symbols.sourceIds[moduleSymbolId] = 0
    out.symbols.nameTextIds[moduleSymbolId] = 3
    out.symbols.nameSpanIds[moduleSymbolId] = 4
    out.symbols.nameTokenIds[moduleSymbolId] = 1
    out.symbols.qualifiedNameTextIds[moduleSymbolId] = 3
    out.symbols.symbolKinds[moduleSymbolId] =
        schema.CsgCompilerSymbolModule
    out.symbols.typeIds[moduleSymbolId] = -1
    out.symbols.declarationSpanIds[moduleSymbolId] = 3
    out.symbols.ownerSymbolIds[moduleSymbolId] = -1
    out.symbols.functionIds[moduleSymbolId] = -1
    out.symbols.symbolCids[functionSymbolId] = functionSymbolCid
    out.symbols.declIds[functionSymbolId] = functionDeclId
    out.symbols.declKeyCids[functionSymbolId] = functionSymbolCid
    out.symbols.declarationHeaderCids[functionSymbolId] =
        out.parserSidecars.functionDeclarationHeaderCids[0]
    out.symbols.declarationPathCids[functionSymbolId] =
        out.parserSidecars.functionDeclarationPathCids[0]
    out.symbols.sourceIds[functionSymbolId] = 0
    out.symbols.nameTextIds[functionSymbolId] = 0
    out.symbols.nameSpanIds[functionSymbolId] = 0
    out.symbols.nameTokenIds[functionSymbolId] = 0
    out.symbols.qualifiedNameTextIds[functionSymbolId] = 4
    out.symbols.symbolKinds[functionSymbolId] =
        schema.CsgCompilerSymbolFunction
    out.symbols.typeIds[functionSymbolId] = functionTypeId
    out.symbols.declarationSpanIds[functionSymbolId] = 1
    out.symbols.ownerSymbolIds[functionSymbolId] = moduleSymbolId
    out.symbols.functionIds[functionSymbolId] = 0
    out.symbols.exportedFlags[functionSymbolId] = true
    out.lexicalScopes.visibleSymbolIds = [functionSymbolId]
    out.functions.symbolIds = [functionSymbolId]
    out.debugOps.symbolIds = [functionSymbolId]
    var symbolCid: layout.FixedBytes32
    assert(schema.CsgCompilerSymbolRowCidInto(
               out, moduleSymbolId, symbolCid, proofErr), proofErr)
    out.symbols.symbolCids[moduleSymbolId] = symbolCid
    assert(schema.CsgCompilerSymbolRowCidInto(
               out, functionSymbolId, symbolCid, proofErr), proofErr)
    out.symbols.symbolCids[functionSymbolId] = symbolCid
    var moduleInterfaceCid: layout.FixedBytes32
    assert(schema.CsgCompilerSymbolInterfaceCidInto(
               out, moduleSymbolId, moduleInterfaceCid, proofErr), proofErr)
    out.symbols.interfaceCids[moduleSymbolId] = moduleInterfaceCid
    var interfaceCid: layout.FixedBytes32
    assert(schema.CsgCompilerSymbolInterfaceCidInto(
               out, functionSymbolId, interfaceCid, proofErr), proofErr)
    out.symbols.interfaceCids[functionSymbolId] = interfaceCid
    out.functions.interfaceCids[0] = interfaceCid
    var layoutCid: layout.FixedBytes32
    assert(schema.CsgCompilerLayoutRowCidInto(
               out, 0, layoutCid, proofErr), proofErr)
    out.layouts.layoutCids[0] = layoutCid
    var sourceInterfaceCids: layout.FixedBytes32[]
    assert(schema.CsgCompilerSourceInterfaceCidsInto(
               out, sourceInterfaceCids, proofErr), proofErr)
    out.sources.interfaceCids = sourceInterfaceCids
    var finalReadSetPreimageCid: layout.FixedBytes32
    assert(schema.CsgCompilerReadSetPreimageCidInto(
               out.symbols.symbolCids[functionSymbolId],
               out.readSet.targetDomainKinds,
               out.readSet.targetPortableKeyCids,
               out.readSet.observedValueCids, 0, 0,
               finalReadSetPreimageCid, proofErr), proofErr)
    out.functions.readSetPreimageCids[0] = finalReadSetPreimageCid
    assert(schema.CsgCompilerReadSetReverseBuildInto(out, proofErr),
           proofErr)
    var ownershipProofCid: layout.FixedBytes32
    assert(schema.CsgCompilerTypedNodeOwnershipProofCidInto(
               out, 0, ownershipProofCid, proofErr), proofErr)
    out.typedNodes.ownershipProofCids[0] = ownershipProofCid
    var sendProofCid: layout.FixedBytes32
    assert(schema.CsgCompilerTypedNodeSendProofCidInto(
               out, 0, sendProofCid, proofErr), proofErr)
    out.typedNodes.sendProofCids[0] = sendProofCid
    var syncProofCid: layout.FixedBytes32
    assert(schema.CsgCompilerTypedNodeSyncProofCidInto(
               out, 0, syncProofCid, proofErr), proofErr)
    out.typedNodes.syncProofCids[0] = syncProofCid
    var shareProofCid: layout.FixedBytes32
    assert(schema.CsgCompilerTypedNodeShareProofCidInto(
               out, 0, shareProofCid, proofErr), proofErr)
    out.typedNodes.shareProofCids[0] = shareProofCid
    var fragmentCid: layout.FixedBytes32
    assert(schema.CsgCompilerFunctionFragmentCidInto(
               out, 0, fragmentCid, proofErr), proofErr)
    out.functions.fragmentCids[0] = fragmentCid
    return out

fn FunctionSymbolId(
        tables: schema.CsgCompilerSnapshotTables): int32 =
    assert(tables.functions.symbolIds.len == 1,
           " debug emission smoke: expected one Function")
    return tables.functions.symbolIds[0]

fn ModuleSymbolId(
        tables: schema.CsgCompilerSnapshotTables,
        functionSymbolId: int32): int32 =
    assert(functionSymbolId >= 0 &&
           functionSymbolId < tables.symbols.ownerSymbolIds.len,
           " debug emission smoke: Function SymbolId out of range")
    let moduleSymbolId =
        tables.symbols.ownerSymbolIds[functionSymbolId]
    assert(moduleSymbolId >= 0 &&
           moduleSymbolId < tables.symbols.symbolKinds.len &&
           tables.symbols.symbolKinds[moduleSymbolId] ==
               schema.CsgCompilerSymbolModule,
           " debug emission smoke: exact Module owner missing")
    return moduleSymbolId

fn BuildDebugFacts(tables: schema.CsgCompilerSnapshotTables,
                   predecessor: layout.FixedBytes32,
                   documentCid: layout.FixedBytes32,
                   canonical: cargo.CsgCompilerSnapshotCargo,
                   out: var debug.DebugFactBundle) =
    var err: str
    var identity: snapshot.PortableSemanticSnapshotIdentity
    assert(snapshot.PortableSemanticSnapshotIdentityMakeInto(
               TestCid("emission/source-identity"), TestCid("emission/world"),
               TestCid("emission/compiler"), TestCid("emission/source-bundle"),
               canonical.factsRootCid, identity, err), err)
    var eventState: snapshot.WorkspaceSourceEventState
    assert(snapshot.WorkspaceSourceEventStateInitInto(
               TestCid("emission/workspace"), eventState, err), err)
    var sourceVersion: int64
    assert(snapshot.WorkspaceSourceEventAcceptInto(
               eventState, snapshot.SemanticSourceEventOpen,
               documentCid, int64(41), sourceVersion, err), err)
    var binding: snapshot.LocalSourceVersionBinding
    assert(snapshot.LocalSourceVersionBindingMakeInto(
               eventState, identity, binding, err), err)
    var validation: snapshot.SemanticSnapshotValidationReceipt
    assert(snapshot.SemanticSnapshotValidationReceiptMakeInto(
               binding, identity,
               canonical.proofRoots.parserRootCid,
               canonical.proofRoots.typeRootCid,
               canonical.proofRoots.ownershipRootCid,
               canonical.proofRoots.callRootCid,
               canonical.proofRoots.layoutRootCid,
               canonical.proofRoots.dependencyRootCid,
               canonical.proofRoots.readSetRootCid,
               canonical.proofRoots.reachabilityRootCid,
               canonical.proofRoots.lifecycleRootCid,
               TestCid("debug-emission/query-index-root"),
               validation, err), err)
    assert(debug.DebugFactsFromSemanticSnapshotInto(
               tables, identity, binding, validation, predecessor,
               "pkg://cheng/debug-emission", out, err), err)

@borrows
fn BuildBody(facts: debug.DebugFactBundle,
             loweringOut: var lower.LoweringPlanStub): ir.BodyIR =
    var lowering: lower.LoweringPlanStub
    lowering.typedIr.internPool = langintern.InternPoolNew()
    var node: texpr.TypedExprIrNode
    node.resultStructuralTypeId = -1
    node.nodeIndex = 0
    node.originParserNodeId = 0
    node.syntheticOriginKind = texpr.TypedExprSyntheticOriginNone
    node.sourcePath = "/workspace/pkg/main.cheng"
    node.functionName = "Main"
    node.lineNumber = 1
    node.opKind = texpr.TypedExprIrOpI32Const
    node.resultType = "int32"
    node.surfaceText = "7"
    node.literalText = "7"
    node.operand0NodeIndex = -1
    node.operand1NodeIndex = -1
    node.operand2NodeIndex = -1
    node.callDeclarationIndex = -1
    node.fieldOffsetBytes = -1
    node.fieldSizeBytes = -1
    node.fieldAlignBytes = -1
    node.elemSizeBytes = -1
    let nodeSourcePath = strings.CloneStr(node.sourcePath)
    let nodeFunctionName = strings.CloneStr(node.functionName)
    texpr.TypedExprIrAppendNode(lowering.typedIr, node)
    texpr.TypedExprIrAppendScope(
        lowering.typedIr,
        0,
        -1,
        parser.NormalizedScopeRoot,
        -1,
        0,
        1,
        1,
        1,
        9)
    var typedFunction: texpr.TypedExprIrFunction
    typedFunction.sourcePath = nodeSourcePath
    typedFunction.functionName = nodeFunctionName
    typedFunction.returnType = "int32"
    typedFunction.returnExpr = "return 7"
    typedFunction.signatureLineNumber = 1
    typedFunction.endLineNumber = 1
    typedFunction.bodyLineNumber = 1
    typedFunction.statementStart = 0
    typedFunction.statementCount = 1
    typedFunction.scopeStart = 0
    typedFunction.scopeCount = 1
    typedFunction.nodeStart = 0
    typedFunction.nodeCount = 1
    typedFunction.returnNodeIndex = 0
    typedFunction.resultExprClass = texpr.TypedExprExprBorrowed
    texpr.TypedExprIrAppendFunction(lowering.typedIr, typedFunction)
    var statement: lower.PrimaryObjectIrStatement
    statement.sourcePath = nodeSourcePath
    statement.functionName = nodeFunctionName
    statement.statementIndex = 0
    statement.lineNumber = 1
    statement.columnNumber = 1
    statement.endLineNumber = 1
    statement.endColumnNumber = 9
    statement.kind = texpr.TypedExprIrStmtReturn
    statement.surfaceText = "return 7"
    statement.resultType = "int32"
    statement.rhsNodeIndex = 0
    statement.callArgNodeStart = -1
    statement.forStartNodeIndex = -1
    statement.assignIndexNodeIndex = -1
    statement.returnRoot = true
    var irFunction: lower.PrimaryObjectIrFunction
    irFunction.sourcePath = nodeSourcePath
    irFunction.functionName = nodeFunctionName
    irFunction.signatureLineNumber = 1
    irFunction.bodyLineNumber = 1
    irFunction.bodyKind = texpr.BodyKindStatementSequence
    irFunction.typedFunctionIndex = 0
    irFunction.statementCount = 1
    add(irFunction.statements, statement)
    var err: str
    assert(lower.LoweringPlanBindPublishedDebugFactsInto(
               lowering, facts, err), err)
    var seqAddCandidateCount: int32
    var seqAddTypedContractCount: int32
    var structuredSeqAddConsumeCount: int32
    var seqAddNodeProbeHitCount: int32
    var seqAddTypeMismatchCount: int32
    var seqAddLegacyTextConsumeCount: int32
    var seqAddNodeEvalGapCount: int32
    var structuredResultIntrinsicConsumeCount: int32
    let body = backend2_stmt.B2PrimaryBuildBodyIrFromTypedStatements(
        lowering,
        0,
        irFunction,
        seqAddCandidateCount,
        seqAddTypedContractCount,
        structuredSeqAddConsumeCount,
        seqAddNodeProbeHitCount,
        seqAddTypeMismatchCount,
        seqAddLegacyTextConsumeCount,
        seqAddNodeEvalGapCount,
        structuredResultIntrinsicConsumeCount)
    loweringOut = lowering
    return body

fn WordsBytes(words: int32[]): rawbytes.Bytes =
    var out = rawbytes.BytesAlloc(words.len * 4)
    for index in 0..<words.len:
        let word = uint32(words[index])
        rawbytes.BytesSet(out, index * 4, int32(word & uint32(255)))
        rawbytes.BytesSet(out, index * 4 + 1,
                          int32((word >> uint32(8)) & uint32(255)))
        rawbytes.BytesSet(out, index * 4 + 2,
                          int32((word >> uint32(16)) & uint32(255)))
        rawbytes.BytesSet(out, index * 4 + 3,
                          int32((word >> uint32(24)) & uint32(255)))
    return out

fn main() =
    # B1: codegen unit composition root (dispatch fails closed without registration)
    if !rega64.RegallocA64CodegenUnitRegister():
        assert(false, "codegen unit registration failed")
    var err: str
    let predecessor = TestCid("emission/predecessor")
    var documentCid: layout.FixedBytes32
    assert(compiler_world.CompilerWorldDocumentCidInto(
               "pkg", "pkg/main", documentCid, err), err)
    var tables = BuildSnapshot(predecessor, documentCid)
    assert(schema.CsgCompilerSnapshotTablesStrictValidateInto(tables, err), err)
    let functionSymbolId = FunctionSymbolId(tables)
    let moduleSymbolId = ModuleSymbolId(tables, functionSymbolId)
    let functionDeclId = tables.symbols.declIds[functionSymbolId]
    let moduleDeclId = tables.symbols.declIds[moduleSymbolId]
    assert(tables.symbols.symbolKinds[functionSymbolId] ==
               schema.CsgCompilerSymbolFunction &&
           tables.symbols.ownerSymbolIds[functionSymbolId] ==
               moduleSymbolId &&
           tables.symbols.ownerSymbolIds[moduleSymbolId] == -1 &&
           tables.declarations.ownerDeclIds[functionDeclId] ==
               moduleDeclId &&
           tables.functions.symbolIds[0] == functionSymbolId &&
           tables.debugOps.symbolIds[0] == functionSymbolId,
           " debug emission smoke: canonical Symbol query identity mismatch")
    var canonical = cargo.CsgCompilerSnapshotCargoBuild(tables)
    assert(canonical.ok, canonical.error)
    var facts: debug.DebugFactBundle
    BuildDebugFacts(tables, predecessor, documentCid, canonical, facts)
    assert(debug.DebugFactBundleStrictValidateInto(facts, err), err)

    var lowering: lower.LoweringPlanStub
    var body = BuildBody(facts, lowering)
    let boundProjectionCid = lowering.semanticDebugProjectionCid
    lowering.typedIr.nodes2_opKinds[0] = texpr.TypedExprIrOpI64Const
    assert(!lower.LoweringPlanBindPublishedDebugFactsInto(
               lowering, facts, err) && lowering.semanticDebugBound &&
           layout.FixedBytes32Equal(
               lowering.semanticDebugProjectionCid, boundProjectionCid),
           " debug emission smoke: producer-index tamper accepted or prior binding lost")
    lowering.typedIr.nodes2_opKinds[0] = texpr.TypedExprIrOpI32Const
    var noTargets: str[]
    var emission = emitter.RegallocProductionEmitFunction(
        "arm64-apple-darwin",
        body, "_debug_emission_main", 0, noTargets, noTargets,
        0, artifacts.RegallocProductionFunctionKindNormal)
    assert(emission.valid && emission.debugProvenanceBound &&
           emission.debugFragmentOpIds.len > 0 &&
           emission.debugMachineFragmentRootSha256.len == 64,
           " debug emission smoke: strict emitter projection failed")

    var text = WordsBytes(emission.recipes.functionWords)
    var objectSymbols = symbols.ObjectSymbolsInit()
    let _ = symbols.ObjectSymbolsAddDefined(
        objectSymbols, "_debug_emission_main", 0, int64(0),
        int64(rawbytes.BytesLen(text)), true)
    var objectRelocs = relocs.ObjectRelocsInit()
    let objectPath = "/tmp/cheng_debug_emission_receipt_smoke.o"
    let writeResult = macho.MachOTextObjectWrite(
        "", objectPath, text, objectSymbols, objectRelocs)
    assert(writeResult.ok, writeResult.err.msg)
    let bytesResult = macho.MachOTextObjectBytes(
        text, objectSymbols, objectRelocs)
    assert(bytesResult.ok, bytesResult.err.msg)
    var objectBytes = bytesResult.value
    let objectCid = hash256.Sha256Fixed(
        layout.ByteSpanFromBytes(objectBytes))

    var published: receipt.DebugEmissionReceipt
    assert(receipt.DebugEmissionReceiptBuildInto(
               facts, body, emission, writeResult.value,
               objectBytes, published, err), err)
    assert(published.valid && published.sourceVersion == int64(1) &&
           published.rows.len == emission.debugFragmentOpIds.len &&
           layout.FixedBytes32Equal(published.declarationTableCid,
                                    facts.declarationTableCid) &&
           layout.FixedBytes32Equal(published.declarationIdentityCid,
                                    facts.declarationIdentityCid) &&
           published.functionId == 0 &&
           published.functionDeclId == functionDeclId &&
           published.functionSymbolId == functionSymbolId &&
           layout.FixedBytes32Equal(published.functionDeclKeyCid,
                                    tables.symbols.declKeyCids[
                                        functionSymbolId]) &&
           published.rows[0].functionDeclId ==
               functionDeclId &&
           published.rows[0].functionSymbolId == functionSymbolId &&
           published.rows[0].typedIrNodeIndex == 0 &&
           published.rows[0].sectionIndex == 1 &&
           published.textSectionFileOffset > 0 &&
           published.debugProvenanceSha256 ==
               emission.plan.debugProvenanceSha256 &&
           layout.FixedBytes32Equal(published.objectCid, objectCid) &&
           receipt.DebugEmissionReceiptStrictValidateAgainstObjectInto(
               published, facts, body, emission, writeResult.value,
               objectBytes, err), err)

    assert(lower.LoweringPlanPublishedDebugFactsStrictValidateInto(
               lowering, err), err)
    var productionPlan: planevidence.DebugEmissionPlanEvidence
    productionPlan.backendKind = "primary"
    productionPlan.symbolNames = [emission.receipt.symbolName]
    productionPlan.functionWordOffsets = [0]
    productionPlan.functionWordCounts = [
        emission.recipes.functionWords.len]
    productionPlan.frozenSnapshotPayloads =
        [emission.frozenSnapshotPayload]
    productionPlan.emissionLedgerPayloads =
        [emission.receipt.receiptSha256]
    productionPlan.bodyIrSha256s = [emission.bodyIrSha256]
    productionPlan.symbolByteStarts =
        [emission.receipt.symbolByteStart]
    productionPlan.symbolByteLengths =
        [emission.receipt.symbolByteLength]
    productionPlan.symbolBytesSha256s =
        [emission.receipt.symbolBytesSha256]
    productionPlan.planSha256s =
        [emission.receipt.frozenSemanticSha256]
    productionPlan.actionSemanticRootSha256s =
        [emission.receipt.actionSemanticRootSha256]
    productionPlan.actionBindingRootSha256s =
        [emission.receipt.actionBindingRootSha256]
    productionPlan.machineFragmentRootSha256s =
        [emission.receipt.machineFragmentRootSha256]
    productionPlan.abiIngressRootSha256s =
        [emission.receipt.abiIngressRootSha256]
    add(productionPlan.debugProvenanceBound,
        emission.debugProvenanceBound)
    productionPlan.debugFunctionIds = [emission.debugFunctionId]
    productionPlan.debugProvenanceSha256s =
        [emission.receipt.debugProvenanceSha256]
    productionPlan.debugMachineFragmentRootSha256s =
        [emission.debugMachineFragmentRootSha256]
    productionPlan.debugFragmentStarts = [0]
    productionPlan.debugFragmentCounts =
        [emission.debugFragmentOpIds.len]
    for fragmentIndex in 0..<emission.debugFragmentOpIds.len:
        add(productionPlan.fragmentFunctionIndexes, 0)
        add(productionPlan.fragmentDebugOpIds,
            emission.debugFragmentOpIds[fragmentIndex])
        add(productionPlan.fragmentSyntheticKinds,
            emission.debugFragmentSyntheticKinds[fragmentIndex])
        add(productionPlan.fragmentSiteKinds,
            emission.debugFragmentSiteKinds[fragmentIndex])
        add(productionPlan.fragmentSiteIndexes,
            emission.debugFragmentSiteIndexes[fragmentIndex])
        add(productionPlan.fragmentMachineOwnerKinds,
            emission.debugFragmentMachineOwnerKinds[fragmentIndex])
        add(productionPlan.fragmentMachineOwnerOrdinals,
            emission.debugFragmentMachineOwnerOrdinals[fragmentIndex])
        add(productionPlan.fragmentActionConsumerOrdinals,
            emission.debugFragmentActionConsumerOrdinals[fragmentIndex])
        add(productionPlan.fragmentTextByteStarts,
            emission.debugFragmentTextByteStarts[fragmentIndex])
        add(productionPlan.fragmentByteLengths,
            emission.debugFragmentByteLengths[fragmentIndex])
        add(productionPlan.fragmentBytesSha256s,
            emission.debugFragmentBytesSha256s[fragmentIndex])
    var objectReceipt: receipt.DebugObjectEmissionReceipt
    assert(receipt.DebugObjectEmissionReceiptBuildInto(
               lowering.semanticDebugFacts, productionPlan,
               objectCid, published.textSectionFileOffset,
               objectBytes, objectReceipt, err), err)
    assert(objectReceipt.valid && objectReceipt.backendKind == "primary" &&
           objectReceipt.objectFormatKind ==
               objectevidence.DebugRelocatableObjectFormatMachO &&
           objectReceipt.functions.len == 1 &&
           objectReceipt.rows.len == emission.debugFragmentOpIds.len &&
           layout.FixedBytes32Equal(objectReceipt.declarationTableCid,
                                    facts.declarationTableCid) &&
           layout.FixedBytes32Equal(objectReceipt.declarationIdentityCid,
                                    facts.declarationIdentityCid) &&
           objectReceipt.functions[0].functionId == 0 &&
           objectReceipt.functions[0].functionDeclId ==
               functionDeclId &&
           objectReceipt.functions[0].functionSymbolId ==
               functionSymbolId &&
           layout.FixedBytes32Equal(
               objectReceipt.functions[0].functionDeclKeyCid,
               tables.symbols.declKeyCids[functionSymbolId]) &&
           objectReceipt.rows[0].functionDeclId ==
               functionDeclId &&
           objectReceipt.rows[0].functionSymbolId == functionSymbolId &&
           objectReceipt.rows[0].typedNodeId == 0 &&
           receipt.DebugObjectEmissionReceiptStrictValidateInto(
               objectReceipt, lowering.semanticDebugFacts,
               productionPlan, objectCid,
               published.textSectionFileOffset,
               objectBytes, err), err)

    var lineMapText: str
    assert(linemap.LineMapTextFromValidatedDebugReceiptInto(
               objectReceipt, lowering.semanticDebugFacts,
               productionPlan, objectCid,
               published.textSectionFileOffset, objectBytes,
               lineMapText, err), err)
    assert(strutil.StartsWith(lineMapText, "cheng_line_map\n") &&
           strutil.Contains(
               lineMapText,
               strutil.Join([
                   "declaration_table_cid=",
                   layout.FixedBytes32Hex(facts.declarationTableCid),
                   "\n"
               ], "")) &&
           strutil.Contains(
               lineMapText,
               strutil.Join([
                   "binding_receipt_cid=",
                   layout.FixedBytes32Hex(facts.bindingReceiptCid), "\n",
                   "world_head_cid=",
                   layout.FixedBytes32Hex(facts.worldHeadCid), "\n",
                   "compiler_cid=",
                   layout.FixedBytes32Hex(facts.compilerCid), "\n",
                   "source_bundle_cid=",
                   layout.FixedBytes32Hex(facts.sourceBundleCid), "\n",
                   "csg_root_cid=",
                   layout.FixedBytes32Hex(facts.csgRootCid), "\n",
                   "validation_receipt_cid=",
                   layout.FixedBytes32Hex(facts.validationReceiptCid), "\n"
               ], "")) &&
           strutil.Contains(lineMapText, "function_id=0") &&
           strutil.Contains(
               lineMapText,
               strutil.Join([
                   "function_decl_id=",
                   strings.IntToStr(functionDeclId)
               ], "")) &&
           strutil.Contains(
               lineMapText,
               strutil.Join([
                   "function_symbol_id=",
                   strings.IntToStr(functionSymbolId)
               ], "")) &&
           strutil.Contains(
               lineMapText,
               strutil.Join([
                   "function_decl_key_cid=",
                   layout.FixedBytes32Hex(
                       tables.symbols.declKeyCids[functionSymbolId])
               ], "")) &&
           strutil.Contains(
               lineMapText,
               strutil.Join([
                   "object_file_byte_start=",
                   strings.IntToStr(
                       objectReceipt.rows[0].objectFileByteStart)
               ], "")) &&
           strutil.Contains(
               lineMapText,
               strutil.Join([
                   "pc_start=",
                   strings.IntToStr(
                       objectReceipt.rows[0].textSectionRelativeByteStart)
               ], "")),
           " debug emission smoke: exact receipt line map missing")
    assert(linemap.LineMapTextHasRequiredDebugFields(lineMapText),
           " debug emission smoke: exact receipt line map shape")
    let invalidLowerHexLineMap = strutil.Replace(
        lineMapText,
        strutil.Join([
            "semantic_snapshot_cid=",
            layout.FixedBytes32Hex(facts.semanticSnapshotCid)
        ], ""),
        "semantic_snapshot_cid=zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
    assert(!linemap.LineMapTextHasRequiredDebugFields(invalidLowerHexLineMap),
           " debug emission smoke: non-hex CID header accepted")
    let uppercaseHexLineMap = strutil.Replace(
        lineMapText,
        strutil.Join([
            "semantic_snapshot_cid=",
            layout.FixedBytes32Hex(facts.semanticSnapshotCid)
        ], ""),
        "semantic_snapshot_cid=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA")
    assert(!linemap.LineMapTextHasRequiredDebugFields(uppercaseHexLineMap),
           " debug emission smoke: uppercase CID header accepted")
    let duplicateHeaderLineMap = strutil.Join([
        lineMapText, "object_cid=",
        layout.FixedBytes32Hex(objectReceipt.objectCid), "\n"
    ], "")
    assert(!linemap.LineMapTextHasRequiredDebugFields(duplicateHeaderLineMap),
           " debug emission smoke: duplicate CID header accepted")
    let lineMapOutputPath =
        "/private/tmp/cheng_debug_emission_receipt_smoke_executable"
    let lineMapWrite =
        linemap.WriteExecutableLineMapFromValidatedDebugReceipt(
            "", lineMapOutputPath, objectReceipt,
            lowering.semanticDebugFacts, productionPlan, objectCid,
            published.textSectionFileOffset, objectBytes)
    assert(lineMapWrite.ok, Error(lineMapWrite))
    assert(os.ReadFile(lineMapWrite.value) == lineMapText,
           " debug emission smoke: atomic line map publish mismatch")
    let publishedLineMapText = os.ReadFile(lineMapWrite.value)
    var failedPublishReceipt = share(objectReceipt)
    failedPublishReceipt.csgRootCid =
        TestCid("emission/line-map-failed-publish-csg-root")
    let failedLineMapWrite =
        linemap.WriteExecutableLineMapFromValidatedDebugReceipt(
            "", lineMapOutputPath, failedPublishReceipt,
            lowering.semanticDebugFacts, productionPlan, objectCid,
            published.textSectionFileOffset, objectBytes)
    assert(IsErr(failedLineMapWrite) &&
           os.ReadFile(lineMapWrite.value) == publishedLineMapText,
           " debug emission smoke: failed publish changed prior line map")
    var lineMapAttack = share(objectReceipt)
    lineMapAttack.functions[0].functionDeclId =
        moduleDeclId
    assert(!linemap.LineMapTextFromValidatedDebugReceiptInto(
                lineMapAttack, lowering.semanticDebugFacts,
                productionPlan, objectCid,
                published.textSectionFileOffset, objectBytes,
                lineMapText, err),
           " debug emission smoke: line map DeclId attack accepted")
    lineMapAttack = share(objectReceipt)
    lineMapAttack.functions[0].functionDeclKeyCid =
        TestCid("emission/line-map-foreign-decl-key")
    assert(!linemap.LineMapTextFromValidatedDebugReceiptInto(
                lineMapAttack, lowering.semanticDebugFacts,
                productionPlan, objectCid,
                published.textSectionFileOffset, objectBytes,
                lineMapText, err),
           " debug emission smoke: line map DeclKeyCid attack accepted")
    lineMapAttack = share(objectReceipt)
    lineMapAttack.functions[0].functionSymbolId = moduleSymbolId
    assert(!linemap.LineMapTextFromValidatedDebugReceiptInto(
                lineMapAttack, lowering.semanticDebugFacts,
                productionPlan, objectCid,
                published.textSectionFileOffset, objectBytes,
                lineMapText, err),
           " debug emission smoke: line map SymbolId attack accepted")
    lineMapAttack = share(objectReceipt)
    lineMapAttack.declarationTableCid =
        TestCid("emission/line-map-foreign-declaration-table")
    assert(!linemap.LineMapTextFromValidatedDebugReceiptInto(
                lineMapAttack, lowering.semanticDebugFacts,
                productionPlan, objectCid,
                published.textSectionFileOffset, objectBytes,
                lineMapText, err),
           " debug emission smoke: line map declaration table attack accepted")
    lineMapAttack = share(objectReceipt)
    lineMapAttack.bindingReceiptCid =
        TestCid("emission/line-map-foreign-binding-receipt")
    assert(!linemap.LineMapTextFromValidatedDebugReceiptInto(
                lineMapAttack, lowering.semanticDebugFacts,
                productionPlan, objectCid,
                published.textSectionFileOffset, objectBytes,
                lineMapText, err),
           " debug emission smoke: line map binding receipt attack accepted")
    lineMapAttack = share(objectReceipt)
    lineMapAttack.worldHeadCid =
        TestCid("emission/line-map-foreign-world-head")
    assert(!linemap.LineMapTextFromValidatedDebugReceiptInto(
                lineMapAttack, lowering.semanticDebugFacts,
                productionPlan, objectCid,
                published.textSectionFileOffset, objectBytes,
                lineMapText, err),
           " debug emission smoke: line map world head attack accepted")
    lineMapAttack = share(objectReceipt)
    lineMapAttack.compilerCid =
        TestCid("emission/line-map-foreign-compiler")
    assert(!linemap.LineMapTextFromValidatedDebugReceiptInto(
                lineMapAttack, lowering.semanticDebugFacts,
                productionPlan, objectCid,
                published.textSectionFileOffset, objectBytes,
                lineMapText, err),
           " debug emission smoke: line map compiler attack accepted")
    lineMapAttack = share(objectReceipt)
    lineMapAttack.sourceBundleCid =
        TestCid("emission/line-map-foreign-source-bundle")
    assert(!linemap.LineMapTextFromValidatedDebugReceiptInto(
                lineMapAttack, lowering.semanticDebugFacts,
                productionPlan, objectCid,
                published.textSectionFileOffset, objectBytes,
                lineMapText, err),
           " debug emission smoke: line map source bundle attack accepted")
    lineMapAttack = share(objectReceipt)
    lineMapAttack.csgRootCid =
        TestCid("emission/line-map-foreign-csg-root")
    assert(!linemap.LineMapTextFromValidatedDebugReceiptInto(
                lineMapAttack, lowering.semanticDebugFacts,
                productionPlan, objectCid,
                published.textSectionFileOffset, objectBytes,
                lineMapText, err),
           " debug emission smoke: line map CSG root attack accepted")
    lineMapAttack = share(objectReceipt)
    lineMapAttack.validationReceiptCid =
        TestCid("emission/line-map-foreign-validation-receipt")
    assert(!linemap.LineMapTextFromValidatedDebugReceiptInto(
                lineMapAttack, lowering.semanticDebugFacts,
                productionPlan, objectCid,
                published.textSectionFileOffset, objectBytes,
                lineMapText, err),
           " debug emission smoke: line map validation receipt attack accepted")
    lineMapAttack = share(objectReceipt)
    lineMapAttack.rows[0].functionId = 1
    assert(!linemap.LineMapTextFromValidatedDebugReceiptInto(
                lineMapAttack, lowering.semanticDebugFacts,
                productionPlan, objectCid,
                published.textSectionFileOffset, objectBytes,
                lineMapText, err),
           " debug emission smoke: line map DebugOp owner attack accepted")
    lineMapAttack = share(objectReceipt)
    lineMapAttack.rows[0].objectFileByteStart =
        lineMapAttack.rows[0].objectFileByteStart + 4
    assert(!linemap.LineMapTextFromValidatedDebugReceiptInto(
                lineMapAttack, lowering.semanticDebugFacts,
                productionPlan, objectCid,
                published.textSectionFileOffset, objectBytes,
                lineMapText, err),
           " debug emission smoke: line map object range attack accepted")
    lineMapAttack = share(objectReceipt)
    lineMapAttack.rows[0].textSectionRelativeByteStart =
        lineMapAttack.rows[0].textSectionRelativeByteStart + 4
    lineMapAttack.rows[0].objectFileByteStart =
        lineMapAttack.rows[0].objectFileByteStart + 4
    let forgedRangeBytes = rawbytes.BytesSliceView(
        objectBytes, lineMapAttack.rows[0].objectFileByteStart,
        lineMapAttack.rows[0].byteLength)
    lineMapAttack.rows[0].bytesCid = hash256.Sha256Fixed(
        layout.ByteSpanFromBytes(forgedRangeBytes))
    lineMapAttack.valid = true
    assert(!linemap.LineMapTextFromValidatedDebugReceiptInto(
                lineMapAttack, lowering.semanticDebugFacts,
                productionPlan, objectCid,
                published.textSectionFileOffset, objectBytes,
                lineMapText, err),
           " debug emission smoke: line map coherent range/CID attack accepted")

    let elfObjectResult = elf.ElfTextObjectBytes(
        text, objectSymbols, objectRelocs)
    assert(elfObjectResult.ok, elfObjectResult.err.msg)
    var elfObjectBytes = elfObjectResult.value
    let elfObjectCid = hash256.Sha256Fixed(
        layout.ByteSpanFromBytes(elfObjectBytes))
    var elfObjectReceipt: receipt.DebugObjectEmissionReceipt
    assert(receipt.DebugObjectEmissionReceiptBuildInto(
               lowering.semanticDebugFacts, productionPlan,
               elfObjectCid, 64, elfObjectBytes,
               elfObjectReceipt, err) &&
           elfObjectReceipt.objectFormatKind ==
               objectevidence.DebugRelocatableObjectFormatElf &&
           elfObjectReceipt.textSectionFileOffset == 64 &&
           receipt.DebugObjectEmissionReceiptStrictValidateInto(
               elfObjectReceipt, lowering.semanticDebugFacts,
               productionPlan, elfObjectCid, 64,
               elfObjectBytes, err), err)
    assert(!receipt.DebugObjectEmissionReceiptBuildInto(
               lowering.semanticDebugFacts, productionPlan,
               elfObjectCid, 65, elfObjectBytes,
               elfObjectReceipt, err),
           " debug emission smoke: ELF writer-offset attack accepted")

    let coffObjectResult = coff.CoffTextObjectBytes(
        text, objectSymbols, objectRelocs)
    assert(coffObjectResult.ok, coffObjectResult.err.msg)
    var coffObjectBytes = coffObjectResult.value
    let coffObjectCid = hash256.Sha256Fixed(
        layout.ByteSpanFromBytes(coffObjectBytes))
    var coffObjectReceipt: receipt.DebugObjectEmissionReceipt
    assert(receipt.DebugObjectEmissionReceiptBuildInto(
               lowering.semanticDebugFacts, productionPlan,
               coffObjectCid, 60, coffObjectBytes,
               coffObjectReceipt, err) &&
           coffObjectReceipt.objectFormatKind ==
               objectevidence.DebugRelocatableObjectFormatCoff &&
           coffObjectReceipt.textSectionFileOffset == 60 &&
           receipt.DebugObjectEmissionReceiptStrictValidateInto(
               coffObjectReceipt, lowering.semanticDebugFacts,
               productionPlan, coffObjectCid, 60,
               coffObjectBytes, err), err)
    let objectReport =
        receipt.DebugObjectEmissionReceiptReportText(objectReceipt)
    assert(strutil.Contains(
               objectReport,
               "debug_emission_receipt_status=bound\n") &&
           strutil.Contains(
               objectReport,
               "debug_emission_backend_kind=primary\n") &&
           strutil.Contains(
               objectReport,
               "debug_emission_semantic_snapshot_cid="),
           " debug emission smoke: production report identity missing")
    let savedFragmentHash =
        productionPlan.fragmentBytesSha256s[0]
    productionPlan.fragmentBytesSha256s[0] =
        strings.Sha256("debug emission forged fragment")
    assert(!receipt.DebugObjectEmissionReceiptStrictValidateInto(
                objectReceipt, lowering.semanticDebugFacts,
                productionPlan, objectCid,
                published.textSectionFileOffset,
                objectBytes, err),
           " debug emission smoke: production fragment attack accepted")
    productionPlan.fragmentBytesSha256s[0] =
        savedFragmentHash
    let savedPlanHash = productionPlan.planSha256s[0]
    productionPlan.planSha256s[0] =
        strings.Sha256("debug emission forged plan")
    assert(!receipt.DebugObjectEmissionReceiptStrictValidateInto(
                objectReceipt, lowering.semanticDebugFacts,
                productionPlan, objectCid,
                published.textSectionFileOffset,
                objectBytes, err),
           " debug emission smoke: regalloc plan attack accepted")
    productionPlan.planSha256s[0] = savedPlanHash
    var attackedObjectReceipt = share(objectReceipt)
    attackedObjectReceipt.functions[0].functionSymbolId = moduleSymbolId
    assert(!receipt.DebugObjectEmissionReceiptStrictValidateInto(
                attackedObjectReceipt, lowering.semanticDebugFacts,
                productionPlan, objectCid,
                published.textSectionFileOffset,
                objectBytes, err),
           " debug emission smoke: object receipt SymbolId attack accepted")
    attackedObjectReceipt = share(objectReceipt)
    attackedObjectReceipt.functions[0].functionDeclId =
        moduleDeclId
    assert(!receipt.DebugObjectEmissionReceiptStrictValidateInto(
                attackedObjectReceipt, lowering.semanticDebugFacts,
                productionPlan, objectCid,
                published.textSectionFileOffset,
                objectBytes, err),
           " debug emission smoke: object receipt DeclId attack accepted")
    attackedObjectReceipt = share(objectReceipt)
    attackedObjectReceipt.declarationTableCid =
        TestCid("emission/foreign-declaration-table")
    assert(!receipt.DebugObjectEmissionReceiptStrictValidateInto(
                attackedObjectReceipt, lowering.semanticDebugFacts,
                productionPlan, objectCid,
                published.textSectionFileOffset,
                objectBytes, err),
           " debug emission smoke: object receipt declaration table attack accepted")
    attackedObjectReceipt = share(objectReceipt)
    attackedObjectReceipt.debugMapCid =
        TestCid("emission/forged-object-debug-receipt")
    assert(!receipt.DebugObjectEmissionReceiptStrictValidateInto(
                attackedObjectReceipt, lowering.semanticDebugFacts,
                productionPlan, objectCid,
                published.textSectionFileOffset,
                objectBytes, err),
           " debug emission smoke: object/debug receipt CID split accepted")
    let savedRetainedProjection =
        lowering.semanticDebugFacts.projectionCid
    lowering.semanticDebugFacts.projectionCid =
        TestCid("emission/forged-retained-projection")
    assert(!lower.LoweringPlanPublishedDebugFactsStrictValidateInto(
                lowering, err),
           " debug emission smoke: retained DebugFact drift accepted")
    lowering.semanticDebugFacts.projectionCid = savedRetainedProjection

    var tamperedReceipt = share(published)
    tamperedReceipt.rows[0].objectFileByteStart =
        tamperedReceipt.rows[0].objectFileByteStart + 4
    assert(!receipt.DebugEmissionReceiptStrictValidateAgainstObjectInto(
               tamperedReceipt, facts, body, emission, writeResult.value,
               objectBytes, err),
           " debug emission smoke: receipt range tamper accepted")
    tamperedReceipt = share(published)
    tamperedReceipt.rows[0].typedIrNodeIndex =
        tamperedReceipt.rows[0].typedIrNodeIndex + 1
    assert(!receipt.DebugEmissionReceiptStrictValidateAgainstObjectInto(
               tamperedReceipt, facts, body, emission, writeResult.value,
               objectBytes, err),
           " debug emission smoke: producer node identity tamper accepted")
    tamperedReceipt = share(published)
    tamperedReceipt.objectCid = TestCid("emission/forged-object")
    assert(!receipt.DebugEmissionReceiptStrictValidateAgainstObjectInto(
               tamperedReceipt, facts, body, emission, writeResult.value,
               objectBytes, err),
           " debug emission smoke: object CID tamper accepted")
    tamperedReceipt = share(published)
    tamperedReceipt.declarationTableCid =
        TestCid("emission/foreign-single-declaration-table")
    assert(!receipt.DebugEmissionReceiptStrictValidateAgainstObjectInto(
               tamperedReceipt, facts, body, emission, writeResult.value,
               objectBytes, err),
           " debug emission smoke: single receipt declaration table attack accepted")
    tamperedReceipt = share(published)
    tamperedReceipt.debugMapCid =
        TestCid("emission/forged-single-debug-receipt")
    assert(!receipt.DebugEmissionReceiptStrictValidateAgainstObjectInto(
               tamperedReceipt, facts, body, emission, writeResult.value,
               objectBytes, err),
           " debug emission smoke: single object/debug receipt CID split accepted")
    var tamperedWriter = writeResult.value
    tamperedWriter.bytesWritten = tamperedWriter.bytesWritten + 1
    assert(!receipt.DebugEmissionReceiptStrictValidateAgainstObjectInto(
               published, facts, body, emission, tamperedWriter,
               objectBytes, err),
           " debug emission smoke: writer byte-count tamper accepted")
    var tamperedObjectBytes = rawbytes.BytesAlloc(
        rawbytes.BytesLen(objectBytes))
    for byteIndex in 0..<rawbytes.BytesLen(objectBytes):
        rawbytes.BytesSet(tamperedObjectBytes, byteIndex,
                          rawbytes.BytesGet(objectBytes, byteIndex))
    let attackOffset = published.rows[0].objectFileByteStart
    rawbytes.BytesSet(tamperedObjectBytes, attackOffset,
                      rawbytes.BytesGet(tamperedObjectBytes,
                                        attackOffset) ^ 1)
    assert(!receipt.DebugEmissionReceiptStrictValidateAgainstObjectInto(
               published, facts, body, emission, writeResult.value,
               tamperedObjectBytes, err),
           " debug emission smoke: object byte tamper accepted")
    rawbytes.BytesSet(tamperedObjectBytes, attackOffset,
                      rawbytes.BytesGet(objectBytes, attackOffset))
    rawbytes.BytesSet(tamperedObjectBytes, 144, 0)
    rawbytes.BytesSet(tamperedObjectBytes, 145, 0)
    rawbytes.BytesSet(tamperedObjectBytes, 146, 0)
    rawbytes.BytesSet(tamperedObjectBytes, 147, 0)
    tamperedWriter = writeResult.value
    tamperedWriter.bytesWritten = rawbytes.BytesLen(tamperedObjectBytes)
    var malformedObjectReceipt: receipt.DebugEmissionReceipt
    assert(!receipt.DebugEmissionReceiptBuildInto(
               facts, body, emission, tamperedWriter,
               tamperedObjectBytes, malformedObjectReceipt, err),
           " debug emission smoke: malformed text section accepted")
    rawbytes.BytesFree(tamperedObjectBytes)
    var tamperedEmission = share(emission)
    tamperedEmission.debugFragmentOpIds[0] = 77
    assert(!receipt.DebugEmissionReceiptStrictValidateAgainstObjectInto(
               published, facts, body, tamperedEmission, writeResult.value,
               objectBytes, err),
           " debug emission smoke: DebugOpId tamper accepted")
    tamperedEmission = share(emission)
    tamperedEmission.plan.debugProvenanceSha256 = emission.bodyIrSha256
    assert(!receipt.DebugEmissionReceiptStrictValidateAgainstObjectInto(
               published, facts, body, tamperedEmission, writeResult.value,
               objectBytes, err),
           " debug emission smoke: frozen provenance root tamper accepted")
    var tamperedFacts = share(facts)
    tamperedFacts.csgRootCid = TestCid("emission/forged-csg")
    assert(!receipt.DebugEmissionReceiptStrictValidateAgainstObjectInto(
               published, tamperedFacts, body, emission, writeResult.value,
               objectBytes, err),
           " debug emission smoke: CSG CID tamper accepted")
    var tamperedBody = body
    tamperedBody.debugOpIdsByOpIndex[0] = 8
    assert(!receipt.DebugEmissionReceiptStrictValidateAgainstObjectInto(
               published, facts, tamperedBody, emission,
               writeResult.value, objectBytes, err),
           " debug emission smoke: BodyIR provenance tamper accepted")

    var incompleteLowering: lower.LoweringPlanStub
    var incompleteBody = BuildBody(facts, incompleteLowering)
    incompleteBody.debugOpIdsByTermIndex[0] = -1
    incompleteBody.debugSyntheticKindsByTermIndex[0] =
        ir.BodyDebugSyntheticNone
    var rejected = emitter.RegallocProductionEmitFunction(
        "arm64-apple-darwin",
        incompleteBody, "_debug_emission_rejected", 0,
        noTargets, noTargets,
        0, artifacts.RegallocProductionFunctionKindNormal)
    assert(!rejected.valid && rejected.errorCode ==
               emitter.RegallocProductionEmitPlanInvalid,
           " debug emission smoke: missing term provenance accepted")
    lower.LoweringPlanReleaseAllPayload(lowering)
    lower.LoweringPlanReleaseAllPayload(incompleteLowering)
    assert(!lowering.semanticDebugBound &&
           lowering.semanticDebugFunctionIdsByTypedFunctionIndex.len == 0 &&
           lowering.semanticDebugTypedNodeIdsByTypedIrNodeIndex.len == 0 &&
           lowering.semanticDebugOpIdsByTypedIrNodeIndex.len == 0 &&
           !incompleteLowering.semanticDebugBound,
           " debug emission smoke: semantic debug binding survived release")
    cargo.CsgCompilerSnapshotCargoRelease(canonical)
    rawbytes.BytesFree(elfObjectBytes)
    rawbytes.BytesFree(coffObjectBytes)
    rawbytes.BytesFree(text)
    rawbytes.BytesFree(objectBytes)
    os.WriteLine(os.Get_stdout(), "debug_emission_receipt_smoke: ok")
