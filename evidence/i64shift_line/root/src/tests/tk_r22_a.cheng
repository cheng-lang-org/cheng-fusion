type
    R22Edge =
        targetSourcePath: str
        targetSourcePathLen: int32

fn R22MakePath(modulePath: str): str =
    return modulePath

fn R22Append(edges: var R22Edge[], modulePath: str): bool =
    var sourcePath = ""
    if modulePath == "":
        return false
    sourcePath = R22MakePath(modulePath)
    var edge: R22Edge
    edge.targetSourcePath = sourcePath
    edge.targetSourcePathLen = sourcePath.len
    add(edges, edge)
    return true

fn main(): int32 =
    var edges: R22Edge[]
    if !R22Append(edges, "alpha/beta"):
        return 10
    if edges.len != 1:
        return 11
    echo("r22 a ok")
    return 0
