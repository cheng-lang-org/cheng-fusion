module cold_linkerless_bitwise_ops

fn test_and(): int32 =
    let a: int32 = 12
    let b: int32 = 10
    let r: int32 = a & b
    if r != 8:
        return 1
    let r2: int32 = a & a
    if r2 != 12:
        return 2
    let r3: int32 = a & 0
    if r3 != 0:
        return 3
    return 0

fn test_or(): int32 =
    let a: int32 = 12
    let b: int32 = 10
    let r: int32 = a | b
    if r != 14:
        return 1
    let r2: int32 = a | 0
    if r2 != 12:
        return 2
    let r3: int32 = 0 | 0
    if r3 != 0:
        return 3
    return 0

fn test_xor(): int32 =
    let a: int32 = 12
    let b: int32 = 10
    let r: int32 = a ^ b
    if r != 6:
        return 1
    let r2: int32 = a ^ a
    if r2 != 0:
        return 2
    let r3: int32 = 0 ^ 0
    if r3 != 0:
        return 3
    return 0

fn test_not(): int32 =
    let a: int32 = 42
    let not_a: int32 = a ^ -1
    let check: int32 = not_a ^ -1
    if check != 42:
        return 1
    return 0

fn test_shl(): int32 =
    let a: int32 = 1
    let r: int32 = a << 3
    if r != 8:
        return 1
    let r2: int32 = 5 << 2
    if r2 != 20:
        return 2
    let r3: int32 = 0 << 10
    if r3 != 0:
        return 3
    return 0

fn test_asr(): int32 =
    let a: int32 = 64
    let r: int32 = a >> 3
    if r != 8:
        return 1
    let r2: int32 = 100 >> 0
    if r2 != 100:
        return 2
    let r3: int32 = -16 >> 2
    if r3 != -4:
        return 3
    return 0

fn test_chain(): int32 =
    let a: int32 = 255
    let b: int32 = 240
    let r: int32 = (a ^ b) & 0xFF
    if r != 15:
        return 1
    return 0

fn main(): int32 =
    let r1 = test_and()
    if r1 != 0:
        return r1
    let r2 = test_or()
    if r2 != 0:
        return 10 + r2
    let r3 = test_xor()
    if r3 != 0:
        return 20 + r3
    let r4 = test_not()
    if r4 != 0:
        return 30 + r4
    let r5 = test_shl()
    if r5 != 0:
        return 40 + r5
    let r6 = test_asr()
    if r6 != 0:
        return 50 + r6
    let r7 = test_chain()
    if r7 != 0:
        return 60 + r7
    return 0

main()
