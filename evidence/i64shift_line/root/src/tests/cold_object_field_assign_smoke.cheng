module cold_object_field_assign_smoke

type Point =
    x: int32
    y: int32
    label: str

fn main(): int32 =
    var p: Point
    p.x = 10
    p.y = 20
    p.label = "pt"
    if p.x != 10:
        return 1
    if p.y != 20:
        return 2
    if p.label != "pt":
        return 3
    return 0

main()
