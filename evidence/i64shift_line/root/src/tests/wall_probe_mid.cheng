import cheng/tests/wall_probe_mod as probe

const
    WALL_PROBE_A: int32 = 40
    WALL_PROBE_UNTYPED = 512
    WALL_PROBE_N: int32 = 8

var
    wallProbeConns: probe.WallProbeConn[WALL_PROBE_N]
    wallProbeCur: int32

fn WallProbeSeed() =
    wallProbeConns[0].slot = 3

fn WallProbeCheck(): bool =
    return probe.WallProbeHasQueued(wallProbeConns[wallProbeCur])
