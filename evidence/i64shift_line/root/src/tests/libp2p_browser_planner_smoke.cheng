import std/system
import std/strings
import cheng/apps/libp2p_browser/session as sess
import cheng/apps/libp2p_browser/computer_use_planner as plan

fn fail(code: int32, msg: str): int32 =
    echo(msg)
    return code

fn fixture(): str =
    var s: str = "CLB4\n400 600 2 1\n"
    s = strings.ConcatStr(s, "4 10 20 120 32 -1 -16777216 14 1 -16777216 2 400 0 0 0 0 0 0 0 400 600\nbutton\n\nbutton\nbtnOk\nGo\nGo\nsans-serif\n\n\n")
    s = strings.ConcatStr(s, "1 10 70 200 32 -1 -16777216 14 1 -16777216 2 400 0 0 0 0 0 0 0 400 600\ntext\n\ntext\nq\n\n\nsans-serif\n\n\n")
    s = strings.ConcatStr(s, "CTL|0|3|0|button|Go\n")
    s = strings.ConcatStr(s, "CTL|1|4|0||Quantity\n")
    return s

fn main(): int32 =
    let src = fixture()
    var session = sess.BrowserSessionInit("plan-peer", 400, 600)
    if !sess.BrowserSessionOnPageSnapshot(session, "https://ex.test/plan", src):
        echo(session.lastError)
        return fail(1, "plan session snapshot")
    # begin: prompt 组装含控件树与 goal
    if plan.BrowserCusePlanBegin(session, "Set the quantity to 4 then press Go") != 0:
        echo(session.lastError)
        return fail(2, "plan begin")
    var hasTree = false
    var hasGoal = false
    var pi: int32 = 0
    while pi + 8 <= session.planPrompt.len:
        if session.planPrompt[pi] == 'Q' && session.planPrompt[pi + 1] == 'u' && session.planPrompt[pi + 2] == 'a' && session.planPrompt[pi + 3] == 'n':
            hasTree = true
        if session.planPrompt[pi] == 'G' && session.planPrompt[pi + 1] == 'o' && session.planPrompt[pi + 2] == 'a' && session.planPrompt[pi + 3] == 'l' && session.planPrompt[pi + 4] == ':':
            hasGoal = true
        pi = pi + 1
    if !hasTree || !hasGoal:
        return fail(3, "prompt shape")
    # 真实模型回复样例形态: 围栏/寒暄/编号行混合, 解析器只收协议行
    let reply = "Here are the commands:\n```" +
        "\n1. set \"Quantity\" 4" +
        "\n2. click Go" +
        "\nThis should do it.\n" +
        "```\n"
    if plan.BrowserCusePlanSubmit(session, reply) != 0:
        echo(session.lastError)
        return fail(4, "plan submit")
    if plan.BrowserCusePlanStepCount(session) != 2:
        echo(strings.IntToStr(plan.BrowserCusePlanStepCount(session)))
        return fail(5, "step count")
    if plan.BrowserCusePlanStepAt(session, 0) != "set \"Quantity\" 4":
        echo(plan.BrowserCusePlanStepAt(session, 0))
        return fail(6, "step 0")
    if plan.BrowserCusePlanStepAt(session, 1) != "click Go":
        echo(plan.BrowserCusePlanStepAt(session, 1))
        return fail(7, "step 1")
    if plan.BrowserCusePlanStepAt(session, 9).len != 0:
        return fail(8, "step oob")
    # 纯噪声回复 → 0 条协议行 → hard-fail
    if plan.BrowserCusePlanSubmit(session, "I cannot help with that.") != -11:
        return fail(9, "no steps must fail")
    if session.lastError != "plan_e_no_steps":
        return fail(10, "no steps err")
    # 空控件表 → begin hard-fail
    var empty = sess.BrowserSessionInit("plan-empty", 400, 600)
    if plan.BrowserCusePlanBegin(empty, "click anything") != -10:
        return fail(11, "empty controls must fail")
    # 允许动词集: 越权步骤解析层滤除, 合规保留; 空串=不限制
    if plan.BrowserCusePlanBegin(session, "demo") != 0:
        return fail(30, "begin for allow")
    plan.BrowserCusePlanSetAllow(session, "set,read")
    if plan.BrowserCusePlanSubmit(session, "set \"Quantity\" 9\nclick Go\nread Go\n") != 0:
        echo(session.lastError)
        return fail(31, "submit with allow")
    if plan.BrowserCusePlanStepCount(session) != 2:
        echo(strings.IntToStr(plan.BrowserCusePlanStepCount(session)))
        return fail(32, "filtered step count")
    if plan.BrowserCusePlanStepAt(session, 0) != "set \"Quantity\" 9":
        echo(plan.BrowserCusePlanStepAt(session, 0))
        return fail(33, "kept set")
    if plan.BrowserCusePlanStepAt(session, 1) != "read Go":
        echo(plan.BrowserCusePlanStepAt(session, 1))
        return fail(34, "kept read")
    plan.BrowserCusePlanSetAllow(session, "")
    if plan.BrowserCusePlanSubmit(session, "click Go") != 0:
        return fail(35, "empty allow must not filter")
    echo("libp2p_browser_planner_smoke ok")
    return 0
