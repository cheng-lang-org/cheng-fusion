# app_v0 flow test (split from mosaico_t_app to keep compile units small)
import "src/mosaico/events.cheng" as events
import "src/mosaico/app_v0.cheng" as app

fn main(): int32 =
    var fails = 0
    var st = app.InitState()

    # step 1: idle tick shows identity print, stays idle
    var r = app.Step(st, events.EvTimerTick)
    if app.ActionsOf(r) != app.ActShowIdentityPrint:
        fails = fails | 1
    st = app.NextStateOf(r)

    # step 2: key down starts recording + waveform + LED
    r = app.Step(st, events.EvButtonDown)
    if (app.ActionsOf(r) & app.ActStartRecorder) == 0:
        fails = fails | 2
    if (app.ActionsOf(r) & app.ActShowWaveform) == 0:
        fails = fails | 4
    st = app.NextStateOf(r)
    if st != app.StRecording:
        fails = fails | 8

    # step 3: key release holds for confirm gate (anti-misfiring rule)
    r = app.Step(st, events.EvButtonUp)
    if (app.ActionsOf(r) & app.ActStopRecorderKeep) == 0:
        fails = fails | 16
    st = app.NextStateOf(r)
    if st != app.StConfirming:
        fails = fails | 32

    # no send without touch confirm
    r = app.Step(st, events.EvButtonUp)
    if (app.ActionsOf(r) & app.ActSendToUniMaker) != 0:
        fails = fails | 64

    # touch tap confirms and sends
    r = app.Step(st, events.EvTouchTap)
    if (app.ActionsOf(r) & app.ActSendToUniMaker) == 0:
        fails = fails | 128
    st = app.NextStateOf(r)
    if st != app.StPublishing:
        fails = fails | 256

    return fails