import cheng/core/runtime/web_scene_runtime as scene
import cheng/core/runtime/web_font_runtime as font

# Differential oracle: the scanline inside-mask must reproduce the per-pixel
# even-odd walk (WebSceneGlyphSdfContainsAtPixel) byte-for-byte on synthetic
# polygon outlines, including horizontal edges, shared vertices, self-crossing
# contours, multiple contours (holes), and pseudo-random polygons.

fn lcgNext(state: int32): int32 =
    var x = state * 1103515245 + 12345
    if x < 0:
        x = 0 - x
    return x

fn appendPoint(outline: var font.WebFontGlyphOutline, x: int32, y: int32, endContour: bool) =
    var p: font.WebFontGlyphPoint
    p.x = x
    p.y = y
    p.onCurve = true
    p.endContour = endContour
    add(outline.points, p)

fn finishOutline(outline: var font.WebFontGlyphOutline, contourCount: int32) =
    outline.simple = true
    outline.contourCount = contourCount
    outline.pointCount = outline.points.len

fn buildOutline(kind: int32, seed: int32, outline: var font.WebFontGlyphOutline) =
    font.WebFontGlyphOutlineInit(outline)
    if kind == 0:
        # plain box
        appendPoint(outline, 100, 100, false)
        appendPoint(outline, 900, 100, false)
        appendPoint(outline, 900, 900, false)
        appendPoint(outline, 100, 900, true)
        finishOutline(outline, 1)
        return
    if kind == 1:
        # box with hole (two contours, opposite winding irrelevant for even-odd)
        appendPoint(outline, 50, 50, false)
        appendPoint(outline, 950, 50, false)
        appendPoint(outline, 950, 950, false)
        appendPoint(outline, 50, 950, true)
        appendPoint(outline, 300, 300, false)
        appendPoint(outline, 700, 300, false)
        appendPoint(outline, 700, 700, false)
        appendPoint(outline, 300, 700, true)
        finishOutline(outline, 2)
        return
    if kind == 2:
        # triangle with horizontal base and shared-vertex apex
        appendPoint(outline, 100, 100, false)
        appendPoint(outline, 900, 100, false)
        appendPoint(outline, 500, 880, true)
        finishOutline(outline, 1)
        return
    if kind == 3:
        # self-crossing bowtie
        appendPoint(outline, 100, 100, false)
        appendPoint(outline, 900, 900, false)
        appendPoint(outline, 900, 100, false)
        appendPoint(outline, 100, 900, true)
        finishOutline(outline, 1)
        return
    # kind 4: pseudo-random star-ish polygon (12 vertices)
    var st = seed
    var vi = 0
    while vi < 12:
        st = lcgNext(st)
        let x = 80 + st % 840
        st = lcgNext(st)
        let y = 80 + st % 840
        appendPoint(outline, x, y, vi == 11)
        vi = vi + 1
    finishOutline(outline, 1)

fn checkCase(kind: int32, cellSize: int32, seed: int32): int32 =
    var outline: font.WebFontGlyphOutline
    buildOutline(kind, seed, outline)
    let baselineY = cellSize - 8
    let fontSize = 48
    let unitsPerEm = 1000
    let spreadPx = 8
    var mask: int32[]
    scene.WebSceneGlyphSdfInsideMaskScanline(outline, cellSize, baselineY, fontSize, unitsPerEm, spreadPx, mask)
    if mask.len != cellSize * cellSize:
        return kind * 1000000 + 999999
    for py in 0..<cellSize:
        for px in 0..<cellSize:
            var want = 0
            if scene.WebSceneGlyphSdfContainsAtPixel(outline, px, py, baselineY, fontSize, unitsPerEm, spreadPx):
                want = 1
            if mask[py * cellSize + px] != want:
                return kind * 1000000 + py * 1000 + px
    return 0 - 1

fn main(): int32 =
    var failures = 0
    for kind in 0..<5:
        var caseIndex = 0
        while caseIndex < 3:
            let cellSize = 24 + caseIndex * 60
            let seed = 7919 + kind * 131 + caseIndex * 17
            let bad = checkCase(kind, cellSize, seed)
            if bad >= 0:
                failures = failures + 1
            caseIndex = caseIndex + 1
    if failures != 0:
        return failures
    return 0
