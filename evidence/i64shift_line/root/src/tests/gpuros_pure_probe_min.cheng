# Minimal bare-metal probe: UART 'OK' then sifive_test exit. Zero GPU code.
@importc("__cheng_mmio_load8")
fn MmioLd8(addr: uint64): uint64

@importc("__cheng_mmio_load16")
fn MmioLd16(addr: uint64): uint64

@importc("__cheng_mmio_load32")
fn MmioLd32(addr: uint64): uint64

@importc("__cheng_mmio_load64")
fn MmioLd64(addr: uint64): uint64

@importc("__cheng_mmio_store8")
fn MmioSt8(addr: uint64, value: uint64)

@importc("__cheng_mmio_store16")
fn MmioSt16(addr: uint64, value: uint64)

@importc("__cheng_mmio_store32")
fn MmioSt32(addr: uint64, value: uint64)

@importc("__cheng_mmio_store64")
fn MmioSt64(addr: uint64, value: uint64)

fn UartPutc(ch: int32) =
    MmioSt8(uint64(0x10000000), uint64(ch & 255))

fn main(): int32 =
    UartPutc(79)
    UartPutc(75)
    UartPutc(10)
    MmioSt32(uint64(0x100000), uint64(0x5555))
    return 0
