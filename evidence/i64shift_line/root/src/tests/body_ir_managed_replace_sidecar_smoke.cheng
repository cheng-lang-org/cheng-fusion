import cheng/core/ir/core_types as coreir
import cheng/core/ir/body_ir_access as access
import cheng/core/ir/body_ir_lifecycle as lifecycle
import cheng/core/analysis/managed_lvalue_replace as replace
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256

@borrows
fn digestText(value: str): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(value.len)
    for index in 0..<value.len:
        layout.ByteBufAppendByte(buf, Int32(value[index]) & 255)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn appendFieldAddressDefinition(body: var coreir.BodyIR): int32 =
    var op: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = coreir.BodyOpLoadLocalTag
    op.target = 7
    op.operands = [
        coreir.BodyLoadLocalFieldAddressTag, 3, 16, 8]
    op.valueDefSlot = 7
    op.valueDefExprNodeIndex = 100
    op.valueDefSemanticRow = 100
    op.valueDefOwnership = coreir.OwnBorrowShared
    op.valueDefBorrowOwnerSemanticRow = 100
    op.valueDefBorrowOwnerDefinitionDomain =
        coreir.BodyDefinitionDomainEntrySlotTag
    op.valueDefBorrowOwnerDefinitionRow = 3
    op.valueDefOriginKind = coreir.BodyDefinitionOriginTypedExprTag
    op.valueDefOriginId = 100
    op.sourceDefinitionDomain =
        coreir.BodyDefinitionDomainEntrySlotTag
    op.sourceDefinitionRow = 3
    return coreir.BodyIRAppendOp(body, op)

fn appendIndexedAddressDefinition(body: var coreir.BodyIR,
                                  fieldDefinitionRow: int32): int32 =
    var op: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = coreir.BodyOpLoadLocalTag
    op.target = 0
    op.operands = [
        coreir.BodyLoadLocalIndexedAddressTag, 7, 2, 24, 1]
    op.valueDefSlot = 0
    op.valueDefExprNodeIndex = 101
    op.valueDefSemanticRow = 100
    op.valueDefOwnership = coreir.OwnBorrowShared
    op.valueDefBorrowOwnerSemanticRow = 100
    op.valueDefBorrowOwnerDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    op.valueDefBorrowOwnerDefinitionRow = fieldDefinitionRow
    op.valueDefOriginKind = coreir.BodyDefinitionOriginTypedExprTag
    op.valueDefOriginId = 100
    op.sourceDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    op.sourceDefinitionRow = fieldDefinitionRow
    return coreir.BodyIRAppendOp(body, op)

fn assertSemanticMutationRejected(flat: var coreir.BodyIRFlatSoA,
                                  message: str) =
    flat.managedReplaceRootCid =
        coreir.BodyIRFlatManagedReplaceCidExact(flat)
    assert(coreir.BodyIRTypeArenaArtifactCidValid(
               flat.managedReplaceRootCid) &&
           !coreir.BodyIRFlatSoAIsAligned(flat),
           message)

fn buildBody(): coreir.BodyIR =
    var body = coreir.BodyIRNew()
    body.typeArenaArtifactCid = digestText("type-arena")
    coreir.BodyIRControlFlowBegin(body, 7)
    var target: coreir.LocalSlot
    target.id = 0
    coreir.BodyIRApplyLocalSlotDefaultProof(target)
    target.typeKind = coreir.LocalPtrTag
    target.typeArenaTypeId = 23
    target.managedStorageKind = coreir.BodyManagedStorageManagedTag
    target.placeKind = coreir.BodyPlaceBorrowAddressTag
    target.sizeBytes = 8
    target.alignBytes = 8
    var source: coreir.LocalSlot
    source.id = 1
    coreir.BodyIRApplyLocalSlotDefaultProof(source)
    source.typeKind = coreir.LocalAggregateTag
    source.typeArenaTypeId = 23
    source.managedStorageKind = coreir.BodyManagedStorageManagedTag
    source.stackOffset = -1
    source.sizeBytes = 24
    source.alignBytes = 8
    var index: coreir.LocalSlot
    index.id = 2
    coreir.BodyIRApplyLocalSlotDefaultProof(index)
    index.typeKind = coreir.LocalI32Tag
    index.typeArenaTypeId = 1
    index.managedStorageKind =
        coreir.BodyManagedStorageUnmanagedTag
    index.stackOffset = -2
    index.sizeBytes = 4
    index.alignBytes = 4
    var root: coreir.LocalSlot
    root.id = 3
    coreir.BodyIRApplyLocalSlotDefaultProof(root)
    root.typeKind = coreir.LocalPtrTag
    root.typeArenaTypeId = 19
    root.managedStorageKind = coreir.BodyManagedStorageManagedTag
    root.stackOffset = -3
    root.sizeBytes = 8
    root.alignBytes = 8
    var descriptorLen: coreir.LocalSlot
    descriptorLen.id = 4
    coreir.BodyIRApplyLocalSlotDefaultProof(descriptorLen)
    descriptorLen.typeKind = coreir.LocalI32Tag
    descriptorLen.sizeBytes = 4
    descriptorLen.alignBytes = 4
    var rootTypeId: coreir.LocalSlot
    rootTypeId.id = 5
    coreir.BodyIRApplyLocalSlotDefaultProof(rootTypeId)
    rootTypeId.typeKind = coreir.LocalI32Tag
    rootTypeId.sizeBytes = 4
    rootTypeId.alignBytes = 4
    var mode: coreir.LocalSlot
    mode.id = 6
    coreir.BodyIRApplyLocalSlotDefaultProof(mode)
    mode.typeKind = coreir.LocalI32Tag
    mode.sizeBytes = 4
    mode.alignBytes = 4
    var fieldAddress: coreir.LocalSlot
    fieldAddress.id = 7
    coreir.BodyIRApplyLocalSlotDefaultProof(fieldAddress)
    fieldAddress.typeKind = coreir.LocalPtrTag
    fieldAddress.typeArenaTypeId = 19
    fieldAddress.managedStorageKind =
        coreir.BodyManagedStorageManagedTag
    fieldAddress.placeKind = coreir.BodyPlaceBorrowAddressTag
    fieldAddress.sizeBytes = 8
    fieldAddress.alignBytes = 8
    fieldAddress.auxValue = 3
    add(body.localSlots, target)
    add(body.localSlots, source)
    add(body.localSlots, index)
    add(body.localSlots, root)
    add(body.localSlots, descriptorLen)
    add(body.localSlots, rootTypeId)
    add(body.localSlots, mode)
    add(body.localSlots, fieldAddress)
    coreir.BodyIRBindEntryParameterSlot(body, 0, 1)
    coreir.BodyIRBindEntryParameterSlot(body, 1, 2)
    coreir.BodyIRBindEntryParameterSlot(body, 2, 3)
    var entryOwnership: int32[]
    add(entryOwnership, int32(coreir.OwnInvalid))
    add(entryOwnership, int32(coreir.OwnBorrowShared))
    add(entryOwnership, int32(coreir.OwnPlain))
    add(entryOwnership, int32(coreir.OwnBorrowShared))
    add(entryOwnership, int32(coreir.OwnInvalid))
    add(entryOwnership, int32(coreir.OwnInvalid))
    add(entryOwnership, int32(coreir.OwnInvalid))
    add(entryOwnership, int32(coreir.OwnInvalid))
    var entrySemanticRows: int32[]
    add(entrySemanticRows, -1)
    add(entrySemanticRows, 102)
    add(entrySemanticRows, -1)
    add(entrySemanticRows, 100)
    add(entrySemanticRows, -1)
    add(entrySemanticRows, -1)
    add(entrySemanticRows, -1)
    add(entrySemanticRows, -1)
    coreir.BodyIRFreezeEntryDefinitionAuthority(
        body, entryOwnership, entrySemanticRows)
    let descriptorPayload = "exact-drop-glue"
    let fieldDefinitionRow = appendFieldAddressDefinition(body)
    var descriptorLenOp: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(descriptorLenOp)
    descriptorLenOp.kind = coreir.BodyOpLoadConstTag
    descriptorLenOp.target = 4
    descriptorLenOp.operands = [coreir.LocalI32Tag, len(descriptorPayload)]
    let _ = coreir.BodyIRAppendOp(body, descriptorLenOp)
    var rootTypeIdOp: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(rootTypeIdOp)
    rootTypeIdOp.kind = coreir.BodyOpLoadConstTag
    rootTypeIdOp.target = 5
    rootTypeIdOp.operands = [coreir.LocalI32Tag, 23]
    let _ = coreir.BodyIRAppendOp(body, rootTypeIdOp)
    var modeOp: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(modeOp)
    modeOp.kind = coreir.BodyOpLoadConstTag
    modeOp.target = 6
    modeOp.operands = [coreir.LocalI32Tag, 2]
    let _ = coreir.BodyIRAppendOp(body, modeOp)
    let addressDefinitionRow = appendIndexedAddressDefinition(
        body, fieldDefinitionRow)
    coreir.BodyIRManagedLvalueReplaceBegin(
        body, body.controlFunctionRow, body.typeArenaArtifactCid)
    let descriptorRow =
        coreir.BodyIRManagedLvalueReplaceDescriptorIntern(
            body,
            23,
            descriptorPayload,
            digestText(descriptorPayload))
    var pathKinds = [1, 2]
    var pathProjectionNodeIndexes = [100, 101]
    var pathParentTypeIds = [18, 19]
    var pathIdentityKinds = [2, 1]
    var pathIdentityRows = [43, 44]
    var pathSelectorOrdinals = [0, 0]
    var pathResultTypeIds = [19, 23]
    var pathByteOffsets = [16, 0]
    var pathByteWidths = [8, 24]
    var pathIndexNodeIndexes = [-1, 103]
    var pathIndexDefinitionDomains = [
        coreir.BodyDefinitionDomainInvalidTag,
        coreir.BodyDefinitionDomainEntrySlotTag]
    var pathIndexDefinitionRows = [-1, 2]
    let runtimeCid = digestText("aggregate-runtime")
    let receiptRow = coreir.BodyIRManagedLvalueReplaceAppendExact(
        body,
        0,
        body.ops.len,
        3,
        2,
        101,
        102,
        coreir.BodyDefinitionDomainBodyOpTag,
        fieldDefinitionRow,
        0,
        addressDefinitionRow,
        23,
        coreir.BodyDefinitionDomainEntrySlotTag,
        1,
        1,
        102,
        -1,
        runtimeCid,
        descriptorRow,
        pathKinds,
        pathProjectionNodeIndexes,
        pathParentTypeIds,
        pathIdentityKinds,
        pathIdentityRows,
        pathSelectorOrdinals,
        pathResultTypeIds,
        pathByteOffsets,
        pathByteWidths,
        pathIndexNodeIndexes,
        pathIndexDefinitionDomains,
        pathIndexDefinitionRows)
    var call: coreir.CallOp
    coreir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = "cheng_aggregate_store_managed"
    call.sourceDefinitionDomain =
        coreir.BodyDefinitionDomainEntrySlotTag
    call.sourceDefinitionRow = 1
    call.managedStoreKind = coreir.ManagedStoreAggregateRetainTag
    call.managedReplaceReceiptRow = receiptRow
    call.managedDropGlueDescriptorRow = descriptorRow
    add(call.argSlots, coreir.CallArgSlotAddress(0))
    add(call.argPassKinds, coreir.BodyCallPassBorrowAddressTag)
    add(call.argAbiSizes, 8)
    add(call.argSlots, coreir.CallArgSlotAddress(1))
    add(call.argPassKinds, coreir.BodyCallPassBorrowAddressTag)
    add(call.argAbiSizes, 8)
    let descriptorLiteralId = coreir.BodyIRAppendCStringLiteral(
        body, descriptorPayload, "")
    add(call.argSlots, coreir.CallArgSlotCString(descriptorLiteralId))
    add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(call.argAbiSizes, 8)
    add(call.argSlots, 4)
    add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(call.argAbiSizes, 4)
    add(call.argSlots, 5)
    add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(call.argAbiSizes, 4)
    add(call.argSlots, 6)
    add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(call.argAbiSizes, 4)
    add(body.callSequence, call)
    var callBodyOp: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(callBodyOp)
    callBodyOp.kind = coreir.BodyOpCallTag
    callBodyOp.operands = [0]
    callBodyOp.sourceDefinitionDomain =
        coreir.BodyDefinitionDomainEntrySlotTag
    callBodyOp.sourceDefinitionRow = 1
    let _ = coreir.BodyIRAppendOp(body, callBodyOp)
    coreir.BodyIRManagedLvalueReplaceSeal(body)
    var term: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = coreir.BodyTermReturnTag
    let termIndex = coreir.BodyIRAppendTerm(body, term)
    let _ = coreir.BodyIRAppendBlock(
        body, 0, body.ops.len, termIndex)
    coreir.BodyIRControlFlowBindBlockScope(body, 0, 0)
    var successorBlockIds: int32[]
    var edgeKinds: int32[]
    coreir.BodyIRControlFlowBindTermSuccessors(
        body, termIndex, successorBlockIds, edgeKinds)
    coreir.BodyIRControlFlowBindCallTarget(
        body,
        0,
        coreir.BodyCallTargetDomainRuntimeIntrinsicTag,
        0,
        runtimeCid)
    coreir.BodyIRControlFlowSeal(body)
    return body

fn main(): int32 =
    var body = buildBody()
    assert(coreir.BodyIRManagedLvalueReplaceSidecarShapeValid(body),
           "managed replace sidecar: sealed source invalid")
    var accessTable = access.BodyIrAccessDecode(body)
    assert(access.BodyIrAccessTableIsValid(accessTable),
           Fmt"managed replace sidecar: BodyIR access rejected code={accessTable.errorCode} site={accessTable.errorSiteKind}:{accessTable.errorSiteIndex} detail={accessTable.errorDetail}")
    let admission =
        replace.ManagedLvalueReplaceProductionVerifyWithAccess(
            body, accessTable)
    assert(admission.valid && admission.replaceCount == 1 &&
           admission.borrowLiftCount == 1,
           "managed replace sidecar: production admission rejected")
    let flat = coreir.BodyIRFlattenSoA(body)
    assert(coreir.BodyIRFlatSoAIsAligned(flat) &&
           flat.managedReplaceCallOrdinals.len == 1 &&
           flat.managedReplacePathKinds.len == 2 &&
           flat.managedReplaceDescriptorPayloads.len == 1,
           "managed replace sidecar: FlatSoA projection invalid")

    var misaligned = coreir.BodyIRFlattenSoA(body)
    add(misaligned.managedReplacePathCounts, 0)
    assert(!coreir.BodyIRFlatSoAIsAligned(misaligned),
           "managed replace sidecar: misaligned mutation survived")
    var cidDrift = coreir.BodyIRFlattenSoA(body)
    cidDrift.managedReplaceRootCid = digestText("wrong-root")
    assert(!coreir.BodyIRFlatSoAIsAligned(cidDrift),
           "managed replace sidecar: CID mutation survived")

    var modeDrift = coreir.BodyIRFlattenSoA(body)
    modeDrift.managedReplaceModes[0] = 3
    assertSemanticMutationRejected(
        modeDrift, "managed replace sidecar: mode mutation survived")
    var emptyPath = coreir.BodyIRFlattenSoA(body)
    emptyPath.managedReplacePathCounts[0] = 0
    assertSemanticMutationRejected(
        emptyPath, "managed replace sidecar: empty path survived")
    var rootDomain = coreir.BodyIRFlattenSoA(body)
    rootDomain.managedReplaceTargetRootDefinitionDomains[0] =
        coreir.BodyDefinitionDomainInvalidTag
    assertSemanticMutationRejected(
        rootDomain, "managed replace sidecar: invalid root domain survived")
    var rootRow = coreir.BodyIRFlattenSoA(body)
    rootRow.managedReplaceTargetRootDefinitionRows[0] = -1
    assertSemanticMutationRejected(
        rootRow, "managed replace sidecar: invalid root row survived")
    var callReceipt = coreir.BodyIRFlattenSoA(body)
    callReceipt.callManagedReplaceReceiptRows[0] = -1
    assertSemanticMutationRejected(
        callReceipt, "managed replace sidecar: call receipt drift survived")
    var callDescriptor = coreir.BodyIRFlattenSoA(body)
    callDescriptor.callManagedDropGlueDescriptorRows[0] = -1
    assertSemanticMutationRejected(
        callDescriptor,
        "managed replace sidecar: call descriptor drift survived")
    var callStoreKind = coreir.BodyIRFlattenSoA(body)
    callStoreKind.callManagedStoreKinds[0] = coreir.ManagedStoreNoneTag
    assertSemanticMutationRejected(
        callStoreKind,
        "managed replace sidecar: call store-kind drift survived")
    var consumeRelation = coreir.BodyIRFlattenSoA(body)
    consumeRelation.managedReplaceConsumeActionRows[0] = 3
    consumeRelation.callConsumeActionRows[0] = 3
    assertSemanticMutationRejected(
        consumeRelation,
        "managed replace sidecar: retain consume relation survived")
    var descriptorRoot = coreir.BodyIRFlattenSoA(body)
    descriptorRoot.managedReplaceDescriptorRootTypeIds[0] = 24
    assertSemanticMutationRejected(
        descriptorRoot,
        "managed replace sidecar: descriptor root drift survived")
    var replaceOpLink = coreir.BodyIRFlattenSoA(body)
    replaceOpLink.operands[
        replaceOpLink.opOperandStarts[
            replaceOpLink.managedReplaceOpRows[0]]] = 1
    assertSemanticMutationRejected(
        replaceOpLink,
        "managed replace sidecar: replace-op call link drift survived")
    var sourceDefinitionLink = coreir.BodyIRFlattenSoA(body)
    sourceDefinitionLink.callSourceDefinitionRows[0] =
        0
    assertSemanticMutationRejected(
        sourceDefinitionLink,
        "managed replace sidecar: source value-def link drift survived")
    var addressPlace = coreir.BodyIRFlattenSoA(body)
    addressPlace.localPlaceKinds[0] = coreir.BodyPlaceStackValueTag
    assertSemanticMutationRejected(
        addressPlace,
        "managed replace sidecar: borrow-address place drift survived")
    var addressDefinitionRow = coreir.BodyIRFlattenSoA(body)
    addressDefinitionRow.managedReplaceTargetAddressDefinitionRows[0] =
        addressDefinitionRow.managedReplaceOpRows[0]
    assertSemanticMutationRejected(
        addressDefinitionRow,
        "managed replace sidecar: address definition row drift survived")
    var addressOpKind = coreir.BodyIRFlattenSoA(body)
    let addressOpRow =
        addressOpKind.managedReplaceTargetAddressDefinitionRows[0]
    addressOpKind.opKinds[addressOpRow] = coreir.BodyOpCopyLocalTag
    assertSemanticMutationRejected(
        addressOpKind,
        "managed replace sidecar: address op kind drift survived")
    var addressOpTag = coreir.BodyIRFlattenSoA(body)
    let addressOperandStart =
        addressOpTag.opOperandStarts[
            addressOpTag.managedReplaceTargetAddressDefinitionRows[0]]
    addressOpTag.operands[addressOperandStart] =
        coreir.BodyLoadLocalAddressTag
    assertSemanticMutationRejected(
        addressOpTag,
        "managed replace sidecar: address op tag drift survived")
    var addressRoot = coreir.BodyIRFlattenSoA(body)
    addressRoot.operands[
        addressRoot.opOperandStarts[
            addressRoot.managedReplaceTargetAddressDefinitionRows[0]] + 1] = 1
    assertSemanticMutationRejected(
        addressRoot,
        "managed replace sidecar: address root definition drift survived")
    var addressIndex = coreir.BodyIRFlattenSoA(body)
    addressIndex.operands[
        addressIndex.opOperandStarts[
            addressIndex.managedReplaceTargetAddressDefinitionRows[0]] + 2] = 1
    assertSemanticMutationRejected(
        addressIndex,
        "managed replace sidecar: address index definition drift survived")
    var addressExpr = coreir.BodyIRFlattenSoA(body)
    addressExpr.opValueDefExprNodeIndexes[
        addressExpr.managedReplaceTargetAddressDefinitionRows[0]] = 100
    assertSemanticMutationRejected(
        addressExpr,
        "managed replace sidecar: address expr identity drift survived")
    var addressOwnership = coreir.BodyIRFlattenSoA(body)
    addressOwnership.opValueDefOwnershipKinds[
        addressOwnership.managedReplaceTargetAddressDefinitionRows[0]] =
            int32(coreir.OwnMove)
    assertSemanticMutationRejected(
        addressOwnership,
        "managed replace sidecar: address ownership drift survived")
    var pathKind = coreir.BodyIRFlattenSoA(body)
    pathKind.managedReplacePathKinds[0] = 9
    assertSemanticMutationRejected(
        pathKind, "managed replace sidecar: path kind mutation survived")
    var pathProjection = coreir.BodyIRFlattenSoA(body)
    pathProjection.managedReplacePathProjectionNodeIndexes[0] = -1
    assertSemanticMutationRejected(
        pathProjection,
        "managed replace sidecar: path projection mutation survived")
    var pathParent = coreir.BodyIRFlattenSoA(body)
    pathParent.managedReplacePathParentTypeIds[0] = -1
    assertSemanticMutationRejected(
        pathParent, "managed replace sidecar: path parent mutation survived")
    var pathResult = coreir.BodyIRFlattenSoA(body)
    pathResult.managedReplacePathResultTypeIds[0] = 24
    assertSemanticMutationRejected(
        pathResult, "managed replace sidecar: path result mutation survived")
    var pathIdentityKind = coreir.BodyIRFlattenSoA(body)
    pathIdentityKind.managedReplacePathIdentityKinds[0] = 1
    assertSemanticMutationRejected(
        pathIdentityKind,
        "managed replace sidecar: path identity-kind mutation survived")
    var pathIdentityRow = coreir.BodyIRFlattenSoA(body)
    pathIdentityRow.managedReplacePathIdentityRows[0] = -1
    assertSemanticMutationRejected(
        pathIdentityRow,
        "managed replace sidecar: path identity-row mutation survived")
    var pathSelector = coreir.BodyIRFlattenSoA(body)
    pathSelector.managedReplacePathSelectorOrdinals[0] = -1
    assertSemanticMutationRejected(
        pathSelector,
        "managed replace sidecar: path selector mutation survived")
    var pathWidth = coreir.BodyIRFlattenSoA(body)
    pathWidth.managedReplacePathByteWidths[0] = 0
    assertSemanticMutationRejected(
        pathWidth, "managed replace sidecar: path width mutation survived")
    var indexTriple = coreir.BodyIRFlattenSoA(body)
    indexTriple.managedReplacePathIndexNodeIndexes[1] = -1
    indexTriple.managedReplacePathIndexDefinitionDomains[1] =
        coreir.BodyDefinitionDomainInvalidTag
    indexTriple.managedReplacePathIndexDefinitionRows[1] = -1
    assertSemanticMutationRejected(
        indexTriple,
        "managed replace sidecar: indexed value-def removal survived")

    var cloned = coreir.BodyIRManagedLvalueReplaceSidecarClone(
        body.managedLvalueReplace)
    var moved = coreir.BodyIRManagedLvalueReplaceSidecarNew()
    coreir.BodyIRManagedLvalueReplaceSidecarMoveInto(moved, cloned)
    assert(coreir.BodyIRManagedLvalueReplaceSidecarIsCanonicalEmpty(
               cloned),
           "managed replace sidecar: move source retained storage")
    var cloneOwner = coreir.BodyIRNew()
    coreir.BodyIRManagedLvalueReplaceSidecarMoveInto(
        cloneOwner.managedLvalueReplace, moved)
    let cloneRelease = lifecycle.BodyIrPayloadRelease(cloneOwner)
    assert(cloneRelease.storageReleased &&
           coreir.BodyIRManagedLvalueReplaceSidecarShapeValid(body) &&
           body.managedLvalueReplace.descriptorPayloads[0] ==
               "exact-drop-glue",
           "managed replace sidecar: clone/release alias leak")

    let sourceRelease = lifecycle.BodyIrPayloadRelease(body)
    assert(sourceRelease.storageReleased &&
           coreir.BodyIRManagedLvalueReplaceSidecarIsCanonicalEmpty(
               body.managedLvalueReplace),
           "managed replace sidecar: source release incomplete")
    echo("body_ir_managed_replace_sidecar_smoke ok")
    return 0
