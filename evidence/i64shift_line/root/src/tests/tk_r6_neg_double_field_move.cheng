type
    R6Neg2Bundle =
        cacheMode: str
        cacheDir: str

fn R6Neg2Fill(out: var R6Neg2Bundle) =
    out = R6Neg2Bundle()
    var s: str = "content"
    out.cacheMode = s
    out.cacheDir = s

fn main(): int32 =
    var bundle: R6Neg2Bundle
    R6Neg2Fill(bundle)
    echo(Fmt"r6_neg2 mode={bundle.cacheMode} dir={bundle.cacheDir}")
    return 0
