import cheng/core/tooling/lifetime_ledger as lifetime

fn main(): int32 =
    var observed: lifetime.LifetimeLedger
    lifetime.LifetimeLedgerInit(observed)
    let category = lifetime.LifetimeLedgerRegisterCategory(
        observed, "production_dynamic_failure")
    let owner = lifetime.LifetimeLedgerRegisterOwner(
        observed, "production_dynamic_failure_owner")
    let objectId = lifetime.LifetimeLedgerReserveObject(
        observed, category, int64(8))
    lifetime.LifetimeLedgerOwn(observed, objectId, owner)
    lifetime.LifetimeLedgerRelease(observed, objectId, owner)
    lifetime.LifetimeLedgerRelease(observed, objectId, owner)
    panic("lifetime ledger dynamic: duplicate release accepted")
    return 0
