import cheng/core/backend/regalloc_production_encoder_events as events
import cheng/core/backend/codegen_contract as contract
import cheng/core/backend/riscv64_encode as rv
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256

fn fixtureAuthorityCid(): layout.FixedBytes32 =
    # Structural event tests intentionally use a runtime-computed fixture CID.
    # Production must obtain its source row/CID from CompilerCSG authority.
    let label = "riscv_encoder_event_receipt_test_fixture"
    var bytes = layout.ByteBufInit(label.len)
    for index in 0..<label.len:
        layout.ByteBufAppendByte(bytes, int32(label[index]))
    let out = hash256.Sha256Fixed(layout.ByteBufView(bytes))
    layout.ByteBufFree(bytes)
    return out

fn appendTwo(builder: var contract.RegallocProductionEncoderEventBuilder,
             words: var int32[]): bool =
    var addiWord: int32
    if !events.RegallocProductionEncoderEventBuilderAppend(
           builder, events.RegallocProductionEncoderEventAddi,
           64, 3, int64(10), int64(0), int64(17), int64(-1),
           rv.RvEncAddiForXlen(64, 10, 0, 17), addiWord):
        return false
    var xorWord: int32
    if !events.RegallocProductionEncoderEventBuilderAppend(
           builder, events.RegallocProductionEncoderEventXor,
           64, 3, int64(11), int64(10), int64(10), int64(-1),
           rv.RvEncXorForXlen(64, 11, 10, 10), xorWord):
        return false
    add(words, addiWord)
    add(words, xorWord)
    return true

fn swapEventRows(
        table: var contract.RegallocProductionEncoderEventTable,
        left: int32,
        right: int32) =
    let kind = table.kinds[left]
    table.kinds[left] = table.kinds[right]
    table.kinds[right] = kind
    let operandCount = table.operandCounts[left]
    table.operandCounts[left] = table.operandCounts[right]
    table.operandCounts[right] = operandCount
    let operand0 = table.operand0s[left]
    table.operand0s[left] = table.operand0s[right]
    table.operand0s[right] = operand0
    let operand1 = table.operand1s[left]
    table.operand1s[left] = table.operand1s[right]
    table.operand1s[right] = operand1
    let operand2 = table.operand2s[left]
    table.operand2s[left] = table.operand2s[right]
    table.operand2s[right] = operand2
    let operand3 = table.operand3s[left]
    table.operand3s[left] = table.operand3s[right]
    table.operand3s[right] = operand3
    let encodedWord = table.encodedWords[left]
    table.encodedWords[left] = table.encodedWords[right]
    table.encodedWords[right] = encodedWord

fn main(): int32 =
    let sourceCid = fixtureAuthorityCid()
    var builder: contract.RegallocProductionEncoderEventBuilder
    var words: int32[]
    assert(appendTwo(builder, words), "event append")
    assert(events.RegallocProductionEncoderEventBuilderBindRange(
               builder, 0, 2, 0),
           "event row bind")
    var table: contract.RegallocProductionEncoderEventTable
    assert(events.RegallocProductionEncoderEventBuildExact(
               builder, 41, sourceCid, 64, words, table),
           "event exact freeze")
    assert(events.RegallocProductionEncoderEventBuilderCanonicalEmpty(
               builder),
           "event builder moved")
    assert(events.RegallocProductionEncoderEventStrictValidate(table),
           "event exact replay")
    assert(table.kinds.len == words.len &&
           table.reservedRowCount >= table.kinds.len &&
           table.retainedBytes ==
               int64(table.reservedRowCount) * int64(44),
           "event arena receipt")

    let kind0 = table.kinds[0]
    table.kinds[0] = events.RegallocProductionEncoderEventXor
    assert(!events.RegallocProductionEncoderEventStrictValidate(table),
           "event kind mutation")
    table.kinds[0] = kind0

    let operand0 = table.operand2s[0]
    table.operand2s[0] = operand0 + int64(1)
    assert(!events.RegallocProductionEncoderEventStrictValidate(table),
           "event operand mutation")
    table.operand2s[0] = operand0

    let encoded0 = table.encodedWords[0]
    table.encodedWords[0] = encoded0 ^ 1
    assert(!events.RegallocProductionEncoderEventStrictValidate(table),
           "event result mutation")
    table.encodedWords[0] = encoded0

    table.encoderXlen = 32
    assert(!events.RegallocProductionEncoderEventStrictValidate(table),
           "event xlen mutation")
    table.encoderXlen = 64

    table.encoderSourceRow = 42
    assert(!events.RegallocProductionEncoderEventStrictValidate(table),
           "event source row mutation")
    table.encoderSourceRow = 41

    let sourceByte0 = table.encoderSourceCid.data[0]
    table.encoderSourceCid.data[0] =
        uint8(int32(sourceByte0) ^ 1)
    assert(!events.RegallocProductionEncoderEventStrictValidate(table),
           "event source CID mutation")
    table.encoderSourceCid.data[0] = sourceByte0

    swapEventRows(table, 0, 1)
    assert(!events.RegallocProductionEncoderEventStrictValidate(table),
           "event order mutation")
    swapEventRows(table, 0, 1)

    let rootByte0 = table.orderedRoot.data[0]
    table.orderedRoot.data[0] = uint8(int32(rootByte0) ^ 1)
    assert(!events.RegallocProductionEncoderEventStrictValidate(table),
           "event root mutation")
    table.orderedRoot.data[0] = rootByte0
    assert(events.RegallocProductionEncoderEventStrictValidate(table),
           "event restore")

    let reservedRows = table.reservedRowCount
    table.reservedRowCount = table.kinds.len
    assert(!events.RegallocProductionEncoderEventStrictValidate(table),
           "event arena capacity mutation")
    table.reservedRowCount = reservedRows
    let retainedBytes = table.retainedBytes
    table.retainedBytes = retainedBytes + int64(1)
    assert(!events.RegallocProductionEncoderEventStrictValidate(table),
           "event retained bytes mutation")
    table.retainedBytes = retainedBytes
    assert(events.RegallocProductionEncoderEventStrictValidate(table),
           "event arena receipt restore")
    events.RegallocProductionEncoderEventRelease(table)
    assert(events.RegallocProductionEncoderEventTableCanonicalEmpty(table),
           "event table release")

    var mismatchBuilder: contract.RegallocProductionEncoderEventBuilder
    var mismatchWord: int32
    assert(events.RegallocProductionEncoderEventBuilderAppend(
               mismatchBuilder,
               events.RegallocProductionEncoderEventAddi,
               64, 3, int64(1), int64(0), int64(1), int64(-1),
               rv.RvEncAddiForXlen(64, 1, 0, 1), mismatchWord),
           "event mismatch append")
    assert(events.RegallocProductionEncoderEventBuilderBindLast(
               mismatchBuilder, 0),
           "event mismatch bind")
    var mismatchWords: int32[]
    add(mismatchWords, mismatchWord)
    add(mismatchWords, mismatchWord)
    var mismatchTable: contract.RegallocProductionEncoderEventTable
    assert(!events.RegallocProductionEncoderEventBuildExact(
               mismatchBuilder, 41, sourceCid, 64,
               mismatchWords, mismatchTable),
           "event missing callsite mutation")
    assert(events.RegallocProductionEncoderEventBuilderCanonicalEmpty(
               mismatchBuilder) &&
           events.RegallocProductionEncoderEventTableCanonicalEmpty(
               mismatchTable),
           "event mismatch atomic release")

    var duplicateBuilder: contract.RegallocProductionEncoderEventBuilder
    var duplicateWords: int32[]
    assert(appendTwo(duplicateBuilder, duplicateWords),
           "event duplicate append")
    assert(events.RegallocProductionEncoderEventBuilderBindRange(
               duplicateBuilder, 0, 1, 0) &&
           events.RegallocProductionEncoderEventBuilderBindRange(
               duplicateBuilder, 1, 1, 0),
           "event duplicate bind")
    var duplicateTable: contract.RegallocProductionEncoderEventTable
    assert(!events.RegallocProductionEncoderEventBuildExact(
               duplicateBuilder, 41, sourceCid, 64,
               duplicateWords, duplicateTable),
           "event duplicate row mutation")
    assert(events.RegallocProductionEncoderEventBuilderCanonicalEmpty(
               duplicateBuilder) &&
           events.RegallocProductionEncoderEventTableCanonicalEmpty(
               duplicateTable),
           "event duplicate atomic release")

    echo("riscv_encoder_event_receipt_smoke=pass")
    return 0
