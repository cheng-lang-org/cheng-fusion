import cheng/tests/cold_cross_module_object_layout_plan as plan

fn ColdCrossModulePlanConfigCheck(execPlan: var plan.ColdCrossModulePlan): int32 =
    if execPlan.configOverrides.len != 0:
        return 10
    if execPlan.addDirs.len != 0:
        return 11
    if execPlan.images.len != 0:
        return 12
    if execPlan.command != "run":
        return 13
    if execPlan.maxTurns != 7:
        return 14
    return 0
