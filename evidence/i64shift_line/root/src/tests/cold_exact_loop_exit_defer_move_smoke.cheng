fn ColdExactLoopExitAppendDigit(trace: var int32, digit: int32) =
    trace = trace * 10 + digit

fn ColdExactLoopExitBreak(trace: var int32,
                          takeMove: bool): int32 =
    var rows: str[]
    var current: str = "break"
    var step: int32 = 0
    while step < 3:
        defer:
            ColdExactLoopExitAppendDigit(trace, 1)
        defer:
            ColdExactLoopExitAppendDigit(trace, 2)
        if takeMove && step == 1:
            add(rows, current)
            break
        ColdExactLoopExitAppendDigit(trace, 9)
        step = step + 1
    # COLD_EXACT_BREAK_POST_LOOP_MUTATION
    return trace

fn ColdExactLoopExitContinue(trace: var int32,
                             takeMove: bool): int32 =
    var rows: str[]
    var current: str = "continue"
    var step: int32 = 0
    while step < 3:
        defer:
            ColdExactLoopExitAppendDigit(trace, 3)
        defer:
            ColdExactLoopExitAppendDigit(trace, 4)
        # COLD_EXACT_CONTINUE_NEXT_ITERATION_MUTATION
        if takeMove && step == 0:
            add(rows, current)
            step = step + 1
            continue
        ColdExactLoopExitAppendDigit(trace, 8)
        step = step + 1
    return trace

fn main(): int32 =
    var breakTrace: int32
    if ColdExactLoopExitBreak(breakTrace, true) != 92121:
        return 1
    if breakTrace != 92121:
        return 2

    var continueTrace: int32
    if ColdExactLoopExitContinue(continueTrace, true) != 43843843:
        return 3
    if continueTrace != 43843843:
        return 4

    var noMoveTrace: int32
    if ColdExactLoopExitContinue(noMoveTrace, false) != 843843843:
        return 5
    if noMoveTrace != 843843843:
        return 6
    return 0
