# struct_str_temp_corruption_probe: by-value 双字 struct + str 临时量 +
# @borrows 规则链组合触发后端内存损坏 (kind_smoke 运行时崩溃的复现)。
# 最小复现: 500 次循环内 5 种文本分类, run5+ 起 SIGSEGV/SIGTRAP。
# 去掉 struct 或去掉 @borrows 规则链均稳定; fn 字段无关 (换成 int64 仍崩)。
import std/strings
import std/strutils as strutil

type
    Budget =
        deadlineMs: int64
        cancelPoll: int64

fn BudgetUnbounded(): Budget =
    return Budget(
        deadlineMs: int64(0),
        cancelPoll: int64(0)
    )

fn DeadlinePassed(b: Budget): bool =
    return b.deadlineMs > int64(0)

@borrows
fn ContainsAny(text: str, words: str[]): bool =
    for w in words:
        if strutil.Contains(text, w):
            return true
    return false

@borrows
fn RulesClassify(text: str): str =
    if text == "":
        return "unsupported"
    let lowered = strutil.ToLowerAscii(text)
    if ContainsAny(lowered, ["广告", "ad"]) && ContainsAny(lowered, ["视频", "video"]) && ContainsAny(text, ["发布", "上传", "发"]):
        return "ad"
    if ContainsAny(text, ["短视频", "视频"]) && ContainsAny(text, ["发布", "上传", "发"]):
        return "short"
    if ContainsAny(text, ["购买", "帮我买", "买", "下单", "加入购物车", "搜索商品"]):
        return "purchase"
    if ContainsAny(text, ["二手"]) && ContainsAny(lowered, ["距离", "最近", "公里", "km", "千米", "查看", "看"]):
        return "feed"
    if ContainsAny(text, ["搜索", "搜一下", "搜", "查找", "查一下", "找一下"]):
        return "search"
    return "unsupported"

fn ClassifyWithBudget(text: str, budget: Budget): str =
    if DeadlinePassed(budget):
        return RulesClassify(strings.CloneStr(text))
    return RulesClassify(strings.CloneStr(text))

fn Classify(text: str): str =
    return ClassifyWithBudget(strings.CloneStr(text), BudgetUnbounded())

fn main(): int32 =
    for i in 0..<500:
        let r1 = Classify("帮我搜一下附近的咖啡馆")
        let r2 = Classify("帮我买一件外套")
        let r3 = Classify("附近二手手机,查看一下距离")
        let r4 = Classify("帮我发布一个宠物视频")
        let r5 = Classify("")
        if r1 != "search" || r2 != "purchase" || r3 != "feed" || r4 != "short" || r5 != "unsupported":
            return 1
    return 0
