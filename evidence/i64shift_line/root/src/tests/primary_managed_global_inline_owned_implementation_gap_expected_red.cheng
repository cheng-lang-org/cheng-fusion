type
    ManagedAggregate =
        text: str
        numbers: int32[]

var managedAggregateGlobal: ManagedAggregate

fn makeManagedAggregate(seed: int32): ManagedAggregate =
    var value: ManagedAggregate
    value.text = Fmt"managed-inline-owned-{seed}"
    add(value.numbers, seed)
    return value

fn main(): int32 =
    # This is legal Cheng.  The fixture remains RED only while descriptor-driven
    # recursive move-store is missing; the final semantic oracle is run_green.
    managedAggregateGlobal = makeManagedAggregate(7)
    if managedAggregateGlobal.text != "managed-inline-owned-7":
        return 1
    if managedAggregateGlobal.numbers.len != 1 ||
       managedAggregateGlobal.numbers[0] != 7:
        return 2
    return 0
