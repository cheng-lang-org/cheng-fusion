import cheng/core/runtime/cdp_client as cdp

fn main(): int32 =
    let compactPages = "[{\"webSocketDebuggerUrl\":\"ws://127.0.0.1:9222/devtools/page/abc\"}]"
    assert(cdp.cdpExtractFirstWsUrl(compactPages) == "ws://127.0.0.1:9222/devtools/page/abc",
        "cdp client: compact ws url")

    let spacedPages = "[{\"title\":\"x\",\"webSocketDebuggerUrl\": \"ws://localhost:54321/devtools/page/p1\"}]"
    assert(cdp.cdpExtractFirstWsUrl(spacedPages) == "ws://localhost:54321/devtools/page/p1",
        "cdp client: spaced ws url")

    var port: int32
    assert(cdp.cdpWsUrlLocalPort("ws://127.0.0.1:54321/devtools/page/p1", port),
        "cdp client: local port parse")
    assert(port == 54321, "cdp client: local port value")

    var badPort: int32
    assert(!cdp.cdpWsUrlLocalPort("ws://10.0.0.2:54321/devtools/page/p1", badPort),
        "cdp client: reject remote ws")
    assert(!cdp.cdpWsUrlLocalPort("wss://127.0.0.1:54321/devtools/page/p1", badPort),
        "cdp client: reject unsupported wss")

    let idRead = cdp.cdpJsonTopRawField("{\"method\":\"Runtime.consoleAPICalled\",\"id\":12}", "id")
    assert(idRead.found, "cdp client: raw id found")
    assert(idRead.value == "12", "cdp client: raw id value")

    let evalJson = "{\"id\":3,\"result\":{\"result\":{\"type\":\"string\",\"value\":\"{\\\"ok\\\":true}\\n\"}}}"
    var value: str
    assert(cdp.cdpRuntimeEvaluateStringValue(evalJson, value),
        "cdp client: runtime string value")
    assert(value == "{\"ok\":true}\n", "cdp client: runtime string decoded")

    assert(cdp.cdpJsonEscapeString("a\"b\\c\n") == "a\\\"b\\\\c\\n",
        "cdp client: json escape")

    assert(cdp.cdpHttpStatusCode("HTTP/1.1 101 Switching Protocols\r\n\r\n") == 101,
        "cdp client: http 101 status")
    assert(cdp.cdpHttpStatusCode("HTTP/1.1 404 Not Found\r\n\r\n") == 404,
        "cdp client: http 404 status")

    let frame = cdp.wsBuildTextFrame("abc")
    assert(frame.len == 9, "cdp client: ws frame length")
    assert((int32(frame[0]) & 0xff) == 129, "cdp client: ws frame opcode")
    assert((int32(frame[1]) & 0x7f) == 3, "cdp client: ws frame payload length")

    echo(" cdp_client_contract_smoke ok")
    return 0
