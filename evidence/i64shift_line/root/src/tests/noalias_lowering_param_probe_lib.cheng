import cheng/core/backend/lowering_plan as lower
import cheng/core/ir/body_ir_noalias as noalias

fn ProbeTouchLoweringFn(fnIr: var lower.PrimaryObjectIrFunction) =
    fnIr.bodyIrNoAliasApplied = true
    fnIr.bodyIrNoAliasLocalCount = 2
    fnIr.bodyIrNoAliasForwardRewriteCount = 2
    return

fn ProbeFinalizeLoweringField(fnIr: var lower.PrimaryObjectIrFunction) =
    var stats: noalias.BodyIrNoAliasFinalizeStats
    noalias.BodyIrNoAliasFinalizeInPlace(fnIr.bodyIR, stats)
    fnIr.bodyIrNoAliasApplied = stats.applied
    fnIr.bodyIrNoAliasLocalCount = stats.localCount
    fnIr.bodyIrNoAliasForwardRewriteCount = stats.forwardRewriteCount
    if !stats.dodSoAContractOk:
        fnIr.bodyKind = "body_ir_dod_soa_contract_invalid"
    return
