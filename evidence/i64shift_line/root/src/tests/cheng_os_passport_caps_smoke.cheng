import "src/cheng_os/passport/caps.cheng" as caps
import "src/cheng_os/passport/wire.cheng" as wire
import "src/cheng_os/passport/syscall.cheng" as sys
import "src/cheng_os/passport/effect.cheng" as eff

fn CaseCapTable(): int32 =
    var fails = 0
    var id = 1
    while id <= caps.CapCount:
        let row = caps.CapRowById(id)
        if caps.CapIdOf(row) != id:
            fails = fails | 1
        if caps.CapHasReceipt(row) == 0:
            fails = fails | 2
        id = id + 1
    if caps.CapHasIn(caps.CapKeysRow()) == 0:
        fails = fails | 4
    if caps.CapHasOut(caps.CapDisplayRow()) == 0:
        fails = fails | 8
    if caps.CapHasOut(caps.CapAudioOutRow()) == 0:
        fails = fails | 16
    if caps.CapRowById(99) != 0:
        fails = fails | 32
    return fails

fn CaseEnvelope(): int32 =
    var fails = 0
    var buf: uint8[wire.FrameCap]
    var n = 0
    n = wire.BuildEnvelope(buf, n, wire.DirEvent, sys.SysNfcTap, 305419896, 1234567, 16)
    if n != wire.EnvelopeBytes:
        fails = fails | 1
    if wire.EnvelopeCrcOk(buf, n) == 0:
        fails = fails | 2
    if wire.EnvelopeDir(buf, n) != wire.DirEvent:
        fails = fails | 4
    if wire.EnvelopeKind(buf, n) != sys.SysNfcTap:
        fails = fails | 8
    if wire.NonceMatch(305419896, wire.EnvelopeNonce(buf, n)) == 0:
        fails = fails | 16
    var cmd: uint8[wire.FrameCap]
    var c = 0
    c = wire.BuildEnvelope(cmd, c, wire.DirCommand, eff.EffReceipt, 305419896, 99, 0)
    if wire.EnvelopeCrcOk(cmd, c) == 0:
        fails = fails | 32
    if wire.EnvelopeDir(cmd, c) != wire.DirCommand:
        fails = fails | 64
    var bad: uint8[wire.FrameCap]
    if wire.BuildEnvelope(bad, 0, 2, 1, 1, 1, 0) != wire.FrameErrRange:
        fails = fails | 128
    let saved = buf[19]
    buf[19] = uint8(0)
    if wire.EnvelopeCrcOk(buf, n) != 0:
        fails = fails | 256
    buf[19] = saved
    if wire.NonceMatch(1, 2) != 0:
        fails = fails | 512
    var k = -1
    k = wire.Crc32Add(k, 49)
    k = wire.Crc32Add(k, 50)
    k = wire.Crc32Add(k, 51)
    k = wire.Crc32Add(k, 52)
    k = wire.Crc32Add(k, 53)
    k = wire.Crc32Add(k, 54)
    k = wire.Crc32Add(k, 55)
    k = wire.Crc32Add(k, 56)
    k = wire.Crc32Add(k, 57)
    k = 0 - k - 1
    if k != -873774606:
        fails = fails | 1024
    return fails

fn main(): int32 =
    var fails = 0
    fails = fails | (CaseCapTable() & 0x3F)
    fails = fails | ((CaseEnvelope() & 0x7FF) << 6)
    return fails
