import std/os

importc fn cheng_udp_ipv4_sockaddr_byte_bridge(index: int32): int32

fn main(): int32 =
    let value: int32 = cheng_udp_ipv4_sockaddr_byte_bridge(0)
    if os.UdpPlatformUseLenFieldBridge() == 0:
        assert(value == 2, " udp sockaddr b0: linux family")
    else:
        assert(value == 16, " udp sockaddr b0: bsd len")
    echo(" udp_sockaddr_b0_smoke ok")
    return 0
