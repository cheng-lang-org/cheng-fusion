import cheng/tests/cold_const_dynamic_index_support as indexsupport

fn coldQualifiedDynamicIndexChar(packed: int32): int32 =
    return int32(indexsupport.ColdImportedDynamicIndexAlphabet[
        (packed >> 12) & 63])

fn main() =
    let actual = coldQualifiedDynamicIndexChar(3 << 12)
    if actual == int32('D'):
        echo("cold_qualified_const_dynamic_index=pass")
    else:
        echo("cold_qualified_const_dynamic_index=fail")
