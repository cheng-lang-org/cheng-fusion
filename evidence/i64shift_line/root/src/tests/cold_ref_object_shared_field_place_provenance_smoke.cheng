type
    ColdSharedFieldPlaceCell =
        value: int32

    ColdSharedFieldPlaceInner = ref object
        cell: ColdSharedFieldPlaceCell

    ColdSharedFieldPlaceOuter = ref object
        inner: ColdSharedFieldPlaceInner

fn ColdSharedFieldPlaceWrite(
        cell: var ColdSharedFieldPlaceCell) =
    cell.value = 43

fn ColdSharedFieldPlaceMutate(
        out: var ColdSharedFieldPlaceOuter) =
    var inner = out.inner
    ColdSharedFieldPlaceWrite(inner.cell)

fn main(): int32 =
    var out = new(ColdSharedFieldPlaceOuter)
    out.inner = new(ColdSharedFieldPlaceInner)
    ColdSharedFieldPlaceMutate(out)
    if out.inner.cell.value != 43:
        return 43
    return 0
