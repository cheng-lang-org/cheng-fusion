# std file IO smoke: runtime-stable FileHandle + Result surface

import std/system
import std/os as os
import std/rawbytes as rawbytes
import std/result

fn main() =
    let tmpRoot: str = os.GetEnvDefault("STD_BASELINE_TMPDIR", "artifacts/std_file_io_smoke_runtime")
    os.CreateDir(tmpRoot)
    assert(os.DirExists(tmpRoot), "std/os createDir")

    let textPath: str = os.JoinPath(tmpRoot, "data.txt")
    os.WriteFile(textPath, "cheng-file")
    assert(os.FileExists(textPath), "std/os fileExists")
    assert(os.ReadFile(textPath) == "cheng-file", "std/os readFile")
    var textResult: Result[str] = os.ReadFileResult(textPath)
    assert(result.IsOk(textResult), "std/os readFileResult ok")
    assert(result.Value(textResult) == "cheng-file", "std/os readFileResult value")
    var missingResult: Result[str] = os.ReadFileResult(os.JoinPath(tmpRoot, "missing.txt"))
    assert(result.IsErr(missingResult), "std/os readFileResult missing")

    var readIntoText: str
    let _ = os.ReadFileInto(textPath, readIntoText)
    assert(readIntoText == "cheng-file", "std/os readFileInto")
    var sizedText: str
    assert(os.ReadFileSizedInto(textPath, 10, sizedText), "std/os readFileSizedInto ok")
    assert(sizedText == "cheng-file", "std/os readFileSizedInto value")
    var wrongSizedText: str
    assert(!os.ReadFileSizedInto(textPath, 9, wrongSizedText), "std/os readFileSizedInto size mismatch")

    let resultPath: str = os.JoinPath(tmpRoot, "result.txt")
    var writeResult: Result[bool] = os.WriteFileResult(resultPath, "result-file")
    let writeResultOk: bool = result.IsOk(writeResult)
    assert(writeResultOk, "std/os writeFileResult ok")
    let resultText: str = os.ReadFile(resultPath)
    assert(resultText == "result-file", "std/os writeFileResult content")
    var emptyPathResult: Result[bool] = os.WriteFileResult("", "nope")
    assert(result.IsErr(emptyPathResult), "std/os writeFileResult empty path")

    var bytesPath: str = os.JoinPath(tmpRoot, "bytes.txt")
    var payloadBytes: rawbytes.Bytes = rawbytes.BytesFromString("abc")
    var bytesPathWriteErr: str
    let bytesPathWriteOk: bool = os.WriteFileBytesStatus(bytesPath, payloadBytes, bytesPathWriteErr)
    if ! bytesPathWriteOk:
        panic(bytesPathWriteErr)
    assert(bytesPathWriteOk, "std/os writeFileBytesStatus bytes path ok")
    let bytesPathText: str = os.ReadFile(bytesPath)
    assert(bytesPathText == "abc", "std/os writeFileBytesStatus bytes path content")

    var bytesResultPath: str = os.JoinPath(tmpRoot, "bytes-result.txt")
    var payloadBytesAgain: rawbytes.Bytes = rawbytes.BytesAlloc(3)
    rawbytes.BytesSet(payloadBytesAgain, 0, 97)
    rawbytes.BytesSet(payloadBytesAgain, 1, 98)
    rawbytes.BytesSet(payloadBytesAgain, 2, 99)
    var bytesWriteErr: str
    let bytesWriteOk: bool = os.WriteFileBytesStatus(bytesResultPath, payloadBytesAgain, bytesWriteErr)
    if ! bytesWriteOk:
        panic(bytesWriteErr)
    assert(bytesWriteOk, "std/os writeFileBytesStatus ok")
    var bytesResultAgain: Result[rawbytes.Bytes] = os.ReadFileBytesResult(bytesResultPath)
    assert(result.IsOk(bytesResultAgain), "std/os writeFileBytesStatus content read")
    let bytesResultAgainValue: rawbytes.Bytes = result.Value(bytesResultAgain)
    assert(rawbytes.BytesLen(bytesResultAgainValue) == 3, "std/os writeFileBytesStatus content len")
    assert(rawbytes.BytesGet(bytesResultAgainValue, 0) == 97, "std/os writeFileBytesStatus content byte0")
    assert(rawbytes.BytesGet(bytesResultAgainValue, 1) == 98, "std/os writeFileBytesStatus content byte1")
    assert(rawbytes.BytesGet(bytesResultAgainValue, 2) == 99, "std/os writeFileBytesStatus content byte2")

    var bytesResult: Result[rawbytes.Bytes] = os.ReadFileBytesResult(bytesPath)
    assert(result.IsOk(bytesResult), "std/os readFileBytesResult ok")
    let bytesValue: rawbytes.Bytes = result.Value(bytesResult)
    assert(rawbytes.BytesLen(bytesValue) == 3, "std/os readFileBytesResult len")
    assert(rawbytes.BytesGet(bytesValue, 0) == 97, "std/os readFileBytesResult byte0")

    let handlePath: str = os.JoinPath(tmpRoot, "handle.txt")
    var openWriteRes: Result[os.FileHandle] = os.OpenWriteTruncateResult(handlePath)
    assert(result.IsOk(openWriteRes), result.Error(openWriteRes))
    let writeHandle: os.FileHandle = result.Value(openWriteRes)
    var handlePayload: rawbytes.Bytes = rawbytes.BytesFromString("handle")
    var handleWriteRes: Result[bool] = os.WriteAllBytesResult(writeHandle, handlePayload)
    assert(result.IsOk(handleWriteRes), "std/os handle write")
    var writeHandleReadRes: Result[rawbytes.Bytes] = os.ReadAllBytesResult(writeHandle)
    assert(result.IsErr(writeHandleReadRes), "std/os write handle read rejected")
    var closeWriteRes: Result[bool] = os.CloseFileResult(writeHandle)
    assert(result.IsOk(closeWriteRes), "std/os handle close write")
    var closeAgainRes: Result[bool] = os.CloseFileResult(writeHandle)
    assert(result.IsErr(closeAgainRes), "std/os handle double close rejected")
    var staleWriteRes: Result[bool] = os.WriteAllBytesResult(writeHandle, handlePayload)
    assert(result.IsErr(staleWriteRes), "std/os stale handle write rejected")

    var openAppendRes: Result[os.FileHandle] = os.OpenAppendResult(handlePath)
    assert(result.IsOk(openAppendRes), "std/os handle open append")
    let appendHandle: os.FileHandle = result.Value(openAppendRes)
    var appendPayload: rawbytes.Bytes = rawbytes.BytesFromString("-append")
    var appendRes: Result[bool] = os.WriteAllBytesResult(appendHandle, appendPayload)
    assert(result.IsOk(appendRes), result.Error(appendRes))
    var closeAppendRes: Result[bool] = os.CloseFileResult(appendHandle)
    assert(result.IsOk(closeAppendRes), "std/os handle close append")

    var openReadRes: Result[os.FileHandle] = os.OpenReadHandleResult(handlePath)
    assert(result.IsOk(openReadRes), "std/os handle open read")
    let readHandle: os.FileHandle = result.Value(openReadRes)
    var readHandleBytesRes: Result[rawbytes.Bytes] = os.ReadAllBytesResult(readHandle)
    assert(result.IsOk(readHandleBytesRes), "std/os handle read")
    let readHandleBytes: rawbytes.Bytes = result.Value(readHandleBytesRes)
    assert(rawbytes.BytesToString(readHandleBytes) == "handle-append", "std/os handle read content")
    var readHandleWriteRes: Result[bool] = os.WriteAllBytesResult(readHandle, appendPayload)
    assert(result.IsErr(readHandleWriteRes), "std/os read handle write rejected")
    var closeReadRes: Result[bool] = os.CloseFileResult(readHandle)
    assert(result.IsOk(closeReadRes), "std/os handle close read")
    var staleReadRes: Result[rawbytes.Bytes] = os.ReadAllBytesResult(readHandle)
    assert(result.IsErr(staleReadRes), "std/os stale handle read rejected")

    var openMissingRes: Result[os.FileHandle] = os.OpenFileResult(os.JoinPath(tmpRoot, "missing-handle.txt"), Read)
    assert(result.IsErr(openMissingRes), "std/os handle missing read rejected")

    let renamedPath: str = os.JoinPath(tmpRoot, "renamed.txt")
    assert(os.RenameFile(textPath, renamedPath), "std/os renameFile")
    assert(os.FileExists(renamedPath), "std/os renameFile exists")

    let split: os.SplitFileResult = os.SplitFile(renamedPath)
    assert(split.dir == tmpRoot, "std/os splitFile dir")
    assert(split.name == "renamed", "std/os splitFile name")
    assert(split.ext == ".txt", "std/os splitFile ext")
    assert(os.JoinPath(tmpRoot, "renamed.txt") == renamedPath, "std/os joinPath")

    let walkItems: os.seq_WalkDirEntry = os.WalkDir(tmpRoot)
    assert(walkItems.len >= 1, "std/os walkDir")
    let walkPaths: str[] = os.WalkDirRec(tmpRoot)
    assert(walkPaths.len >= 1, "std/os walkDirRec")

    assert(os.RemoveFile(renamedPath), "std/os removeFile")
    assert(os.RemoveFile(bytesPath), "std/os removeFile bytes")
    assert(os.RemoveFile(resultPath), "std/os removeFile result")
    assert(os.RemoveFile(bytesResultPath), "std/os removeFile bytes result")
    assert(os.RemoveFile(handlePath), "std/os removeFile handle")
    os.RemoveDir(tmpRoot)
    assert(! os.DirExists(tmpRoot), "std/os removeDir")
