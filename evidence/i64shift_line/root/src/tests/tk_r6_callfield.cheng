type
    R6Bundle =
        cacheMode: str
        count: int32

fn R6CacheMode(): str =
    return "content"

fn R6Fill(out: var R6Bundle) =
    out = R6Bundle()
    out.cacheMode = R6CacheMode()
    out.count = 3

fn main(): int32 =
    var bundle: R6Bundle
    R6Fill(bundle)
    if bundle.cacheMode != "content":
        return 10
    if bundle.count != 3:
        return 11
    echo(Fmt"r6_callfield ok mode={bundle.cacheMode} count={bundle.count}")
    return 0
