type
    ColdVarRefRebindCell = ref object
        value: int32

fn ColdVarRefRebind(target: var ColdVarRefRebindCell) =
    target = new(ColdVarRefRebindCell)
    target.value = 29

fn ColdVarRefForwardRebind(target: var ColdVarRefRebindCell) =
    ColdVarRefRebind(target)

fn main(): int32 =
    var target = new(ColdVarRefRebindCell)
    target.value = 7
    ColdVarRefForwardRebind(target)
    if target == nil:
        return 11
    if target.value != 29:
        return 12
    return 0
