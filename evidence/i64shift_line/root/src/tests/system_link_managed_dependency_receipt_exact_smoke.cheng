import std/result
import cheng/std/bytes_layout as layout
import cheng/core/tooling/compiler_world as cworld
import cheng/core/backend/system_link_plan as slplan

fn ExactCid(text: str): layout.FixedBytes32 =
    let res = layout.FixedBytes32FromHex(text)
    assert(IsOk(res), " managed dependency receipt smoke: fixture cid")
    return Value(res)

fn ExactEntry(packageId: str,
              snapshotHex: str,
              syntaxHex: str,
              proofHex: str,
              mirrorHex: str): cworld.CompilerUniverseManifestEntry =
    var out: cworld.CompilerUniverseManifestEntry
    out.packageId = packageId
    out.snapshotCid = ExactCid(snapshotHex)
    out.syntaxSurfaceCid = ExactCid(syntaxHex)
    out.migrationProofCid = ExactCid(proofHex)
    out.managedMirrorBundleCid = ExactCid(mirrorHex)
    return out

fn main(): int32 =
    let alpha = ExactEntry(
        "cheng/alpha",
        "0101010101010101010101010101010101010101010101010101010101010101",
        "0202020202020202020202020202020202020202020202020202020202020202",
        "0303030303030303030303030303030303030303030303030303030303030303",
        "0404040404040404040404040404040404040404040404040404040404040404")
    let zeta = ExactEntry(
        "cheng/zeta",
        "1111111111111111111111111111111111111111111111111111111111111111",
        "1212121212121212121212121212121212121212121212121212121212121212",
        "1313131313131313131313131313131313131313131313131313131313131313",
        "1414141414141414141414141414141414141414141414141414141414141414")
    let expectedReceiptCid = ExactCid(
        "3ea36c6900af4cf7e7a7e5b722e4d17916d19e9cd952b9c07fbc397083288811")

    var lock: cworld.CompilerLockSnapshot
    lock.channel = "stable"
    lock.worldHeadCid = ExactCid(
        "2121212121212121212121212121212121212121212121212121212121212121")
    lock.manifestRootCid = ExactCid(
        "2222222222222222222222222222222222222222222222222222222222222222")
    lock.compilerPkgCid = ExactCid(
        "2323232323232323232323232323232323232323232323232323232323232323")
    lock.stdPkgCid = ExactCid(
        "2424242424242424242424242424242424242424242424242424242424242424")
    lock.runtimePkgCid = ExactCid(
        "2525252525252525252525252525252525252525252525252525252525252525")
    lock.entryCount = 2
    add(lock.entries, alpha)
    add(lock.entries, zeta)
    lock.managedDependencyReceiptCid = expectedReceiptCid

    var receipt: slplan.SystemLinkPlanManagedDependencyReceipt
    var err: str
    assert(slplan.SystemLinkPlanManagedDependencyReceiptFromLockInto(
               lock,
               receipt,
               err),
           err)
    assert(slplan.SystemLinkPlanManagedDependencyReceiptPresent(receipt),
           " managed dependency receipt smoke: present")
    assert(receipt.dependencyCount == 2 &&
           receipt.entries[0].canonicalPackageId == "cheng/alpha" &&
           receipt.entries[1].canonicalPackageId == "cheng/zeta",
           " managed dependency receipt smoke: canonical order")
    assert(layout.FixedBytes32Equal(receipt.receiptCid,
                                    expectedReceiptCid),
           " managed dependency receipt smoke: independent oracle cid")
    assert(slplan.SystemLinkPlanManagedDependencyReceiptVerifyInto(
               receipt,
               err),
           err)
    var plan: slplan.SystemLinkPlanStub
    assert(slplan.SystemLinkPlanBindManagedDependencyReceiptFromLockInto(
               plan,
               lock,
               err),
           err)
    assert(slplan.SystemLinkPlanManagedDependencyReceiptVerifyInto(
               slplan.SystemLinkPlanManagedDependencyReceipt(plan),
               err),
           err)

    var tamperedReceipt = receipt
    tamperedReceipt.entries[0].snapshotCid = zeta.snapshotCid
    assert(!slplan.SystemLinkPlanManagedDependencyReceiptVerifyInto(
               tamperedReceipt,
               err),
           " managed dependency receipt smoke: entry mutation rejected")

    var missingCidLock = lock
    missingCidLock.managedDependencyReceiptCid = layout.FixedBytes32()
    assert(!slplan.SystemLinkPlanManagedDependencyReceiptFromLockInto(
               missingCidLock,
               receipt,
               err),
           " managed dependency receipt smoke: missing cid rejected")

    var wrongCidLock = lock
    wrongCidLock.managedDependencyReceiptCid = alpha.snapshotCid
    assert(!slplan.SystemLinkPlanManagedDependencyReceiptFromLockInto(
               wrongCidLock,
               receipt,
               err),
           " managed dependency receipt smoke: wrong cid rejected")

    var noEntriesLock = lock
    noEntriesLock.entries[0].migrationProofCid = layout.FixedBytes32()
    noEntriesLock.entries[0].managedMirrorBundleCid = layout.FixedBytes32()
    noEntriesLock.entries[1].migrationProofCid = layout.FixedBytes32()
    noEntriesLock.entries[1].managedMirrorBundleCid = layout.FixedBytes32()
    noEntriesLock.managedDependencyReceiptCid = expectedReceiptCid
    assert(!slplan.SystemLinkPlanManagedDependencyReceiptFromLockInto(
               noEntriesLock,
               receipt,
               err),
           " managed dependency receipt smoke: cid without entries rejected")
    noEntriesLock.managedDependencyReceiptCid = layout.FixedBytes32()
    assert(slplan.SystemLinkPlanManagedDependencyReceiptFromLockInto(
               noEntriesLock,
               receipt,
               err),
           err)
    assert(!slplan.SystemLinkPlanManagedDependencyReceiptPresent(receipt),
           " managed dependency receipt smoke: explicit absence")

    echo("system_link_managed_dependency_receipt_exact_smoke ok")
    return 0
