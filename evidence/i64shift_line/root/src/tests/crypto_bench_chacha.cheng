# ChaCha20-Poly1305 isolated benchmark (ownership preflight isolation build).
import std/crypto/chacha20poly1305 as chacha
import std/crypto/sha256
import std/rawbytes
import std/strings
import std/os

@importc("cheng_monotime_ns")
fn monoNs(): int64

const benchRecordBytes = 16384
const benchRecordsPerRound = 64
const benchRounds = 6

fn benchFillRandom(buf: rawbytes.Bytes) =
    var i: int32 = 0
    var seed: int32 = 123456789
    while i < rawbytes.BytesLen(buf):
        seed = (seed * 1103515245 + 12345) & 2147483647
        rawbytes.BytesSet(buf, i, (seed >> 16) & 255)
        i = i + 1

fn benchPrint(text: str) =
    os.WriteLine(os.Get_stdout(), text)

fn benchReport(name: str, dtNs: int64) =
    let totalBytes: int64 = int64(benchRecordBytes) * int64(benchRecordsPerRound) * int64(benchRounds)
    var clamped: int64 = dtNs
    if clamped < 1:
        clamped = 1
    let ms: int64 = clamped / int64(1000000)
    let rateK: int64 = (totalBytes * int64(1000000)) / clamped
    benchPrint(name)
    benchPrint(strings.Int64ToStr(ms))
    benchPrint(strings.Int64ToStr(rateK))

fn main(): int32 =
    var keyData: rawbytes.Bytes = rawbytes.BytesAlloc(32)
    benchFillRandom(keyData)
    var nonceBuf: rawbytes.Bytes = rawbytes.BytesAlloc(12)
    benchFillRandom(nonceBuf)
    var aad: rawbytes.Bytes = rawbytes.EmptyBytes()
    var bigBuf: rawbytes.Bytes = rawbytes.BytesAlloc(benchRecordBytes * benchRecordsPerRound)
    benchFillRandom(bigBuf)

    var chachaKey: Result[chacha.ChaChaPolyKey] = chacha.intoChaChaPolyKey(keyData)
    var chachaNonce: Result[chacha.ChaChaPolyNonce] = chacha.intoChaChaPolyNonce(nonceBuf)
    let t0: int64 = monoNs()
    var r: int32 = 0
    while r < benchRounds:
        let keyRes: Result[chacha.ChaChaPolyKey] = chacha.intoChaChaPolyKey(keyData)
        let nonceRes: Result[chacha.ChaChaPolyNonce] = chacha.intoChaChaPolyNonce(nonceBuf)
        var tagOut: chacha.ChaChaPolyTag
        let enc: Result[bool] = chacha.encrypt(Value(keyRes), Value(nonceRes), tagOut, bigBuf, aad)
        r = r + 1
    benchReport("CHACHA_1MB", monoNs() - t0)

    let t1: int64 = monoNs()
    r = 0
    while r < benchRounds:
        var digest: rawbytes.Bytes = sha256.Sha256Digest(bigBuf)
        rawbytes.BytesFree(digest)
        r = r + 1
    benchReport("SHA256_1MB_control", monoNs() - t1)
    return 0
