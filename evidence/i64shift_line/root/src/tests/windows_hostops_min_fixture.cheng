import std/strutils as strutil
import std/result
import std/os as os
import std/cmdline as cmdline
import core/tooling/host_ops as hostops

fn main(): int32 =
    puts("hostops-min-alive")
    let role: str = cmdline.ReadFlagOrDefault("--role", "")
    puts("after-flag-read")
    let root: str = os.GetCurrentDir()
    puts(strutil.Join(["root=", root], ""))
    let selfPath: str = cmdline.ProgramName()
    puts(strutil.Join(["self=", selfPath], ""))
    return 0
