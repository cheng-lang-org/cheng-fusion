import "./Candle.cheng" as .

@borrows
fn __t2_mapFn(data: Candle[], period: int64, _: Candle, i: int64): int64 =
    if (i < (period - int64(1))):
        return int64(0)
    var sum = int64(0)
    var j = ((i - period) + int64(1))
    while j <= i:
        sum = data[int32(j)].close
        j = j + 1
    return j

@borrows
fn calcMA(data: Candle[], period: int64): int64[] =
    let __t1_src = data
    var __t3_mapped: int64[]
    var __t4_i = 0
    while __t4_i < __t1_src.len:
        let __t5_it = __t1_src[__t4_i]
        add(__t3_mapped, __t2_mapFn(data, period, __t5_it))
        __t4_i = __t4_i + 1
    return __t3_mapped

fn main(): int32 =
    let xs: Candle[] = []
    let out = calcMA(xs, int64(3))
    return int32(out.len)
