# Passport HAL contract. Bodies come from the FOLOTOY BSP shim at flash time.
# Host tests never link this module.

@importc("cheng_passport_hal_wait_event")
fn HalWaitEvent(timeoutMs: int32): int32

@importc("cheng_passport_hal_display_tile")
fn HalDisplayTile(kind: int32, arg0: int32, arg1: int32)

@importc("cheng_passport_hal_tone")
fn HalTone(code: int32)

@importc("cheng_passport_hal_time_ms")
fn HalTimeMs(): int64

@importc("cheng_passport_hal_abort")
fn HalAbort(code: int32)
