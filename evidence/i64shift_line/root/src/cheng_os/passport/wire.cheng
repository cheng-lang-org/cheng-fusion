# CHNG v2 envelope. Do not edit src/mosaico/publish.cheng.
#
# Layout (little-endian):
#   0..3   'C','H','N','G'
#   4      version = 2
#   5      dir: 0 uplink event / 1 downlink command
#   6      kind
#   7..10  nonce
#   11..14 timestamp ms low word
#   15..18 payload length
#   19..22 CRC32 over [0..19), IEEE reflected (poly 0xEDB88320)
#
# CRC test vector: ASCII "123456789" -> 0xCBF43926.

const FrameCap: int32 = 64
const FrameErrOverflow: int32 = -1
const FrameErrRange: int32 = -2

const EnvelopeVersion: int32 = 2
const EnvelopeBytes: int32 = 23
const CrcOffsetInEnvelope: int32 = 19
const CrcPoly: int32 = -306674912
const MagicC: int32 = 0x43
const MagicH: int32 = 0x48
const MagicN: int32 = 0x4E
const MagicG: int32 = 0x47

const DirEvent: int32 = 0
const DirCommand: int32 = 1

fn Crc32Add(crc: int32, byteVal: int32): int32 =
    var acc = crc ^ (byteVal & 0xFF)
    var i = 0
    while i < 8:
        var mask = 0 - (acc & 1)
        let shifted = (acc >> 1) & 0x7FFFFFFF
        acc = shifted ^ (mask & CrcPoly)
        i = i + 1
    return acc

fn LoadI32Le(buf: var uint8[FrameCap], idx: int32): int32 =
    let b0 = buf[idx]
    let b1 = buf[idx + 1]
    let b2 = buf[idx + 2]
    let b3 = buf[idx + 3]
    return (b0 & 0xFF) | ((b1 & 0xFF) << 8) | ((b2 & 0xFF) << 16) | ((b3 & 0xFF) << 24)

fn EnvelopeDirOk(dir: int32): int32 =
    if dir == DirEvent:
        return 1
    if dir == DirCommand:
        return 1
    return 0

fn NonceMatch(session: int32, got: int32): int32 =
    if session == got:
        return 1
    return 0

fn BuildEnvelope(buf: var uint8[FrameCap], n: int32, dir: int32, kind: int32, nonce: int32, tsLowMs: int32, payloadLen: int32): int32 =
    if EnvelopeDirOk(dir) == 0:
        return FrameErrRange
    var tmp: uint8[32]
    var m = 0
    tmp[m] = uint8(MagicC)
    m = m + 1
    tmp[m] = uint8(MagicH)
    m = m + 1
    tmp[m] = uint8(MagicN)
    m = m + 1
    tmp[m] = uint8(MagicG)
    m = m + 1
    tmp[m] = uint8(EnvelopeVersion)
    m = m + 1
    tmp[m] = uint8(dir & 0xFF)
    m = m + 1
    tmp[m] = uint8(kind & 0xFF)
    m = m + 1
    tmp[m] = uint8(nonce & 0xFF)
    m = m + 1
    tmp[m] = uint8((nonce >> 8) & 0xFF)
    m = m + 1
    tmp[m] = uint8((nonce >> 16) & 0xFF)
    m = m + 1
    tmp[m] = uint8((nonce >> 24) & 0xFF)
    m = m + 1
    tmp[m] = uint8(tsLowMs & 0xFF)
    m = m + 1
    tmp[m] = uint8((tsLowMs >> 8) & 0xFF)
    m = m + 1
    tmp[m] = uint8((tsLowMs >> 16) & 0xFF)
    m = m + 1
    tmp[m] = uint8((tsLowMs >> 24) & 0xFF)
    m = m + 1
    tmp[m] = uint8(payloadLen & 0xFF)
    m = m + 1
    tmp[m] = uint8((payloadLen >> 8) & 0xFF)
    m = m + 1
    tmp[m] = uint8((payloadLen >> 16) & 0xFF)
    m = m + 1
    tmp[m] = uint8((payloadLen >> 24) & 0xFF)
    m = m + 1
    var crc = 0xFFFFFFFF
    var i = 0
    while i < CrcOffsetInEnvelope:
        crc = Crc32Add(crc, tmp[i])
        i = i + 1
    crc = crc ^ 0xFFFFFFFF
    let c0 = m
    tmp[c0] = uint8(crc & 0xFF)
    m = m + 1
    let c1 = m
    tmp[c1] = uint8((crc >> 8) & 0xFF)
    m = m + 1
    let c2 = m
    tmp[c2] = uint8((crc >> 16) & 0xFF)
    m = m + 1
    let c3 = m
    tmp[c3] = uint8((crc >> 24) & 0xFF)
    m = m + 1
    if n + m > FrameCap:
        return FrameErrOverflow
    var k = 0
    while k < m:
        let dst = n + k
        buf[dst] = tmp[k]
        k = k + 1
    return n + m

fn EnvelopeCrcOk(buf: var uint8[FrameCap], n: int32): int32 =
    if n < EnvelopeBytes:
        return 0
    if buf[0] != uint8(MagicC):
        return 0
    if buf[1] != uint8(MagicH):
        return 0
    if buf[2] != uint8(MagicN):
        return 0
    if buf[3] != uint8(MagicG):
        return 0
    if buf[4] != uint8(EnvelopeVersion):
        return 0
    let dir = buf[5]
    if EnvelopeDirOk(dir) == 0:
        return 0
    var crc = 0xFFFFFFFF
    var i = 0
    while i < CrcOffsetInEnvelope:
        crc = Crc32Add(crc, buf[i])
        i = i + 1
    crc = crc ^ 0xFFFFFFFF
    let stored = LoadI32Le(buf, CrcOffsetInEnvelope)
    if stored != crc:
        return 0
    return 1

fn EnvelopeDir(buf: var uint8[FrameCap], n: int32): int32 =
    if n < EnvelopeBytes:
        return FrameErrRange
    return buf[5]

fn EnvelopeKind(buf: var uint8[FrameCap], n: int32): int32 =
    if n < EnvelopeBytes:
        return FrameErrRange
    return buf[6]

fn EnvelopeNonce(buf: var uint8[FrameCap], n: int32): int32 =
    if n < EnvelopeBytes:
        return FrameErrRange
    return LoadI32Le(buf, 7)
