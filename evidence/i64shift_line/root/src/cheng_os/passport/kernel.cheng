# Passport capability kernel. Pure scalars. Host tests never link HAL.

import "src/cheng_os/passport/syscall.cheng" as sys
import "src/cheng_os/passport/effect.cheng" as eff

const StIdle: int32 = 1
const StIntentArmed: int32 = 2
const StConfirming: int32 = 3
const StExecWait: int32 = 4
const StReceiptShown: int32 = 5

const ActNone: int32 = 0
const ActShowIdentity: int32 = 1
const ActStartRec: int32 = 2
const ActStopRec: int32 = 4
const ActShowConfirm: int32 = 8
const ActEmitConfirm: int32 = 16
const ActShowReceipt: int32 = 32
const ActTone: int32 = 64
const ActAckDrive: int32 = 128
const ActCancel: int32 = 256

fn InitState(): int32 =
    return StIdle

fn ActionsOf(result: int32): int32 =
    return result & 0xFFFF

fn NextStateOf(result: int32): int32 =
    return (result >> 16) & 0xFF

fn Pack(next: int32, actions: int32): int32 =
    return (next << 16) | (actions & 0xFFFF)

fn Step(state: int32, evKind: int32): int32 =
    var actions = ActNone
    var next = state

    if state == StIdle:
        if evKind == sys.SysTick:
            actions = ActShowIdentity
        if sys.SysIsIntentStart(evKind) != 0:
            actions = ActStartRec
            next = StIntentArmed

    elif state == StIntentArmed:
        if sys.SysIsIntentEnd(evKind) != 0:
            actions = ActStopRec | ActShowConfirm
            next = StConfirming
        if sys.SysIsCancel(evKind) != 0:
            actions = ActCancel | ActShowIdentity
            next = StIdle

    elif state == StConfirming:
        if sys.SysIsConfirm(evKind) != 0:
            actions = ActEmitConfirm
            next = StExecWait
        if sys.SysIsCancel(evKind) != 0:
            actions = ActCancel | ActShowIdentity
            next = StIdle

    elif state == StExecWait:
        if evKind == sys.SysTick:
            actions = ActShowConfirm
        if sys.SysIsCancel(evKind) != 0:
            actions = ActCancel | ActShowIdentity
            next = StIdle

    elif state == StReceiptShown:
        if evKind == sys.SysTick:
            actions = ActShowIdentity
        if evKind == sys.SysKey1Down:
            actions = ActShowIdentity
            next = StIdle

    return Pack(next, actions)

fn StepCommand(state: int32, cmdKind: int32): int32 =
    var actions = ActNone
    var next = state

    if cmdKind == eff.EffIdentityPrint:
        actions = ActShowIdentity | ActAckDrive
        if state == StReceiptShown:
            next = StIdle

    if cmdKind == eff.EffConfirmPrompt:
        if state == StIdle:
            actions = ActShowConfirm | ActAckDrive
            next = StConfirming
        if state == StIntentArmed:
            actions = ActShowConfirm | ActAckDrive
            next = StConfirming
        if state == StConfirming:
            actions = ActShowConfirm | ActAckDrive

    if cmdKind == eff.EffReceipt:
        if state == StExecWait:
            actions = ActShowReceipt | ActTone | ActAckDrive
            next = StReceiptShown

    if cmdKind == eff.EffTone:
        if state == StReceiptShown:
            actions = ActTone | ActAckDrive

    if cmdKind == eff.EffStepTitle:
        if state == StExecWait:
            actions = ActAckDrive

    return Pack(next, actions)
