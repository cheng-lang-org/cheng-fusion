# Uplink syscall kinds. The board produces events; the kernel waits and drains.

const SysNone: int32 = 0
const SysKey1Down: int32 = 1
const SysKey1Up: int32 = 2
const SysKey2Down: int32 = 3
const SysKey2Up: int32 = 4
const SysKey3Down: int32 = 5
const SysKey3Up: int32 = 6
const SysVoiceEnd: int32 = 7
const SysNfcTap: int32 = 8
const SysBattery: int32 = 9
const SysTick: int32 = 10

const SysCap: int32 = 32

fn SysPack(kind: int32, arg0: int32, arg1: int32): int32 =
    return (kind & 0xFF) | ((arg0 & 0xFF) << 8) | ((arg1 & 0xFFFF) << 16)

fn SysKind(item: int32): int32 =
    return item & 0xFF

fn SysArg0(item: int32): int32 =
    return (item >> 8) & 0xFF

fn SysArg1(item: int32): int32 =
    return (item >> 16) & 0xFFFF

fn SysIsConfirm(kind: int32): int32 =
    if kind == SysKey3Down:
        return 1
    if kind == SysNfcTap:
        return 1
    return 0

fn SysIsIntentStart(kind: int32): int32 =
    if kind == SysKey1Down:
        return 1
    return 0

fn SysIsIntentEnd(kind: int32): int32 =
    if kind == SysKey1Up:
        return 1
    if kind == SysVoiceEnd:
        return 1
    return 0

fn SysIsCancel(kind: int32): int32 =
    if kind == SysKey2Down:
        return 1
    return 0

fn SysPush(q: var int32[SysCap], count: int32, item: int32): int32 =
    if count < SysCap:
        q[count] = item
        return count + 1
    var i = 0
    while i < SysCap - 1:
        let j = i + 1
        q[i] = q[j]
        i = j
    q[SysCap - 1] = item
    return SysCap
