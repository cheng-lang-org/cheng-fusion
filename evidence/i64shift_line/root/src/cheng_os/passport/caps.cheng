# Capability table for the Cheng OS passport node.
# Each public hardware row packs id + in + out + receipt. Missing receipt
# is a hard product fail (see docs/cheng-os-passport-product.md).

const CapKernel: int32 = 1
const CapKeys: int32 = 2
const CapAudioIn: int32 = 3
const CapAudioOut: int32 = 4
const CapDisplay: int32 = 5
const CapWifi: int32 = 6
const CapBle: int32 = 7
const CapNfc: int32 = 8
const CapUsb: int32 = 9
const CapPower: int32 = 10
const CapCount: int32 = 10

fn CapPack(id: int32, hasIn: int32, hasOut: int32, hasReceipt: int32): int32 =
    return (id & 0xFF) | ((hasIn & 1) << 8) | ((hasOut & 1) << 9) | ((hasReceipt & 1) << 10)

fn CapIdOf(row: int32): int32 =
    return row & 0xFF

fn CapHasIn(row: int32): int32 =
    return (row >> 8) & 1

fn CapHasOut(row: int32): int32 =
    return (row >> 9) & 1

fn CapHasReceipt(row: int32): int32 =
    return (row >> 10) & 1

fn CapKernelRow(): int32 =
    return CapPack(CapKernel, 1, 1, 1)

fn CapKeysRow(): int32 =
    return CapPack(CapKeys, 1, 0, 1)

fn CapAudioInRow(): int32 =
    return CapPack(CapAudioIn, 1, 0, 1)

fn CapAudioOutRow(): int32 =
    return CapPack(CapAudioOut, 0, 1, 1)

fn CapDisplayRow(): int32 =
    return CapPack(CapDisplay, 0, 1, 1)

fn CapWifiRow(): int32 =
    return CapPack(CapWifi, 1, 1, 1)

fn CapBleRow(): int32 =
    return CapPack(CapBle, 1, 1, 1)

fn CapNfcRow(): int32 =
    return CapPack(CapNfc, 1, 0, 1)

fn CapUsbRow(): int32 =
    return CapPack(CapUsb, 1, 1, 1)

fn CapPowerRow(): int32 =
    return CapPack(CapPower, 1, 0, 1)

fn CapRowById(id: int32): int32 =
    if id == CapKernel:
        return CapKernelRow()
    if id == CapKeys:
        return CapKeysRow()
    if id == CapAudioIn:
        return CapAudioInRow()
    if id == CapAudioOut:
        return CapAudioOutRow()
    if id == CapDisplay:
        return CapDisplayRow()
    if id == CapWifi:
        return CapWifiRow()
    if id == CapBle:
        return CapBleRow()
    if id == CapNfc:
        return CapNfcRow()
    if id == CapUsb:
        return CapUsbRow()
    if id == CapPower:
        return CapPowerRow()
    return 0
