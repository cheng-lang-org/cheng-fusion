# Computer use as a passport OS syscall. Confirmation is a board event.
# Apply stays in web_scene_computer_use_apply; this module only admits
# and emits the downlink receipt. Host tests never mock Admit.
#
# 确认签发唯一权威: csg_action_authority 的确认凭证。板级确认事件
# (Key3/NFC) 触发凭证签发 (绑定动作+参数+版本+世代), 随后由权威准入
# 一次性消费; 非确认事件不签发, 确认类动作即被确认门拒绝。撤销后
# 未消费凭证由 CsgActionAuthorityRevokeConfirmations 统一作废。

import cheng/core/runtime/web_scene_computer_use as cu
import cheng/core/runtime/csg_action_authority as auth
import "src/cheng_os/passport/syscall.cheng" as sys

@borrows
fn PassportConfirmFromSyscall(evKind: int32): bool =
    return sys.SysIsConfirm(evKind) != 0

@borrows
fn PassportAdmit(
        actionKind: str,
        effectClass: str,
        evKind: int32,
        err: var str): bool =
    let confirmed = PassportConfirmFromSyscall(evKind)
    if confirmed:
        if auth.CsgActionAuthorityGrantConfirm(actionKind, ""):
            return auth.CsgActionAuthorityAdmit(actionKind, effectClass, "", err)
    return auth.CsgActionAuthorityAdmit(actionKind, effectClass, "", err)
