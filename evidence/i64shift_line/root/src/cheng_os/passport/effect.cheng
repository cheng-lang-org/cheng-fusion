# Downlink effect kinds. Host / compute peer drives the node.

const EffNone: int32 = 0
const EffIdentityPrint: int32 = 1
const EffConfirmPrompt: int32 = 2
const EffTone: int32 = 3
const EffReceipt: int32 = 4
const EffStepTitle: int32 = 5

fn EffIsDrive(kind: int32): int32 =
    if kind == EffConfirmPrompt:
        return 1
    if kind == EffReceipt:
        return 1
    if kind == EffIdentityPrint:
        return 1
    if kind == EffTone:
        return 1
    if kind == EffStepTitle:
        return 1
    return 0
