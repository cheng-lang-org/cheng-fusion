# GPUROS pure: zero-pointer bare-metal GPU rendering (riscv64-unknown-none-elf).
#
# Same pipeline as gpuros_bare.cheng, but every MMIO/RAM access goes through
# compiler-trusted volatile primitives declared as @importc with a plain
# uint64 bus address. No pointer types, no pointer operations anywhere --
# addresses are integers (DoD style); the dereference lives only inside the
# linker-provided primitives (__cheng_mmio_load/store family, emitted as
# lbu/lhu/lwu/ld + sb/sh/sw/sd + ret by elf_riscv64_linker.cheng).
#
# Boot: QEMU riscv64 virt -bios none -kernel <exe>; _start calls main and
# parks. UART 0x10000000 carries traces; sifive_test 0x100000 exits QEMU
# (0x5555 pass / 0x3333 fail).
#
# Fixed guest-physical layout (RAM 0x80000000..0x88000000):
#   0x82000000 framebuffer 640x480x4 (B8G8R8X8)
#   0x82200000 desc ring, 0x82200400 avail, 0x82201000 used (legacy, num 64)
#   0x82202000..0x82207000 five command payloads, 0x82207000 responses

# ---- compiler-trusted volatile bus primitives (linker-provided) ----------

@importc("__cheng_mmio_load8")
fn MmioLd8(addr: uint64): uint64

@importc("__cheng_mmio_load16")
fn MmioLd16(addr: uint64): uint64

@importc("__cheng_mmio_load32")
fn MmioLd32(addr: uint64): uint64

@importc("__cheng_mmio_load64")
fn MmioLd64(addr: uint64): uint64

@importc("__cheng_mmio_store8")
fn MmioSt8(addr: uint64, value: uint64)

@importc("__cheng_mmio_store16")
fn MmioSt16(addr: uint64, value: uint64)

@importc("__cheng_mmio_store32")
fn MmioSt32(addr: uint64, value: uint64)

@importc("__cheng_mmio_store64")
fn MmioSt64(addr: uint64, value: uint64)

# ---- ns16550a UART (0x10000000) ------------------------------------------

const UartBase: uint64 = 0x10000000

fn UartPutc(ch: int32) =
    var spins = 0
    while spins < 100000:
        let lsr = MmioLd8(UartBase + uint64(5))
        if (lsr & uint64(0x20)) != uint64(0):
            break
        spins = spins + 1
    MmioSt8(UartBase + uint64(0), uint64(ch & 255))

fn UartHex32(value: uint32) =
    var div: int32 = 268435456
    let v = int32(value)
    while div > 0:
        let nibble = (v / div) & 15
        if nibble < 10:
            UartPutc(48 + nibble)
        else:
            UartPutc(87 + nibble)
        div = div / 16

fn UartHex64(value: uint64) =
    UartHex32(uint32(value / uint64(4294967296)))
    UartHex32(uint32(value & uint64(4294967295)))

fn UartTag5(a: int32, b: int32, c: int32, d: int32, e: int32) =
    UartPutc(a)
    UartPutc(b)
    UartPutc(c)
    UartPutc(d)
    UartPutc(e)
    UartPutc(58)
    UartPutc(32)

# ---- sifive_test (0x100000): exit QEMU -----------------------------------

const TestBase: uint64 = 0x100000

fn ExitQemu(code: uint64) =
    MmioSt32(TestBase, code)

# ---- virtio-mmio legacy ---------------------------------------------------

const VmioSlot7: uint64 = 0x10008000
const VmioSlot6: uint64 = 0x10007000
const VirtioDevGpu: uint64 = 16
const RegStatus: uint64 = 0x070

# ring layout (legacy, align 4096, num 64):
#   desc @ 0x82200000, avail @ 0x82200400, used @ 0x82201000
const DescBase: uint64 = 0x82200000
const AvailBase: uint64 = 0x82200400
const UsedIdxAddr: uint64 = 0x82201002
const CmdBase0: uint64 = 0x82202000
const CmdBase1: uint64 = 0x82202400
const CmdBase2: uint64 = 0x82202800
const CmdBase3: uint64 = 0x82202c00
const CmdBase4: uint64 = 0x82203000
const RespBase: uint64 = 0x82207000
const FbBase: uint64 = 0x82000000

fn RamSt8(byteAddr: uint64, value: uint64) =
    MmioSt8(byteAddr, value)

fn RamSt16(byteAddr: uint64, value: int32) =
    MmioSt16(byteAddr, uint64(value & 65535))

fn RamSt32(byteAddr: uint64, value: uint64) =
    MmioSt32(byteAddr, value)

fn RamSt64(byteAddr: uint64, value: uint64) =
    MmioSt64(byteAddr, value)

fn RamLd16(byteAddr: uint64): int32 =
    return int32(MmioLd16(byteAddr))

fn RamLd32(byteAddr: uint64): uint64 =
    return MmioLd32(byteAddr)

fn DevLd32(base: uint64, reg: uint64): uint64 =
    return MmioLd32(base + reg)

fn DevSt32(base: uint64, reg: uint64, value: uint64) =
    MmioSt32(base + reg, value)

# ---- raster (B8G8R8X8: byte0=b byte1=g byte2=r byte3=x) -------------------

fn RasterPixel(x: int32, y: int32, rgb: uint64) =
    if x < 0 || y < 0 || x >= 640 || y >= 480:
        return
    let off = uint64((y * 640 + x) * 4)
    let r = (rgb / 65536) & 255
    let g = (rgb / 256) & 255
    let b = rgb & 255
    RamSt32(FbBase + off, b * 65536 + g * 256 + r + uint64(4278190080))

fn RasterBackground() =
    var y = 0
    while y < 480:
        var x = 0
        while x < 640:
            let t = x * 48 / 640
            let v = y * 20 / 480
            let r = 30 + t / 2
            let g = 38 + t / 2 + v / 2
            let b = 56 + t + v
            RasterPixel(x, y, uint64(r * 65536 + g * 256 + b))
            x = x + 1
        y = y + 1

fn RasterCard(cx: int32, cy: int32, cw: int32, ch: int32, radius: int32,
              fill: uint64, border: uint64) =
    let x1 = cx + cw
    let y1 = cy + ch
    let r2 = radius * radius
    let innerR2 = (radius - 2) * (radius - 2)
    var y = cy
    while y < y1:
        var x = cx
        while x < x1:
            var dx = x - (x1 - radius)
            if x < cx + radius:
                dx = cx + radius - x
            var dy = y - (y1 - radius)
            if y < cy + radius:
                dy = cy + radius - y
            if dx < 0:
                dx = 0 - dx
            if dy < 0:
                dy = 0 - dy
            let d2 = dx * dx + dy * dy
            if d2 <= innerR2:
                RasterPixel(x, y, fill)
            else:
                if d2 <= r2:
                    RasterPixel(x, y, border)
            x = x + 1
        y = y + 1

fn RasterBar(bx: int32, by: int32, bw: int32, bh: int32, rgb: uint64) =
    var y = by
    while y < by + bh:
        var x = bx
        while x < bx + bw:
            RasterPixel(x, y, rgb)
            x = x + 1
        y = y + 1

# ---- entry ----------------------------------------------------------------

fn main(): int32 =
    UartTag5(103, 112, 117, 114, 111)  # "gpuro: "

    # scan: highest slot first (virt device = magic 'virt' + DeviceID 16)
    var devBase = uint64(0)
    let d7 = DevLd32(VmioSlot7, uint64(8))
    if d7 == VirtioDevGpu:
        devBase = VmioSlot7
    if devBase == uint64(0):
        let d6 = DevLd32(VmioSlot6, uint64(8))
        if d6 == VirtioDevGpu:
            devBase = VmioSlot6
    if devBase == uint64(0):
        UartTag5(110, 111, 103, 112, 117)
        UartPutc(10)
        ExitQemu(uint64(0x3333))
        return 1
    UartHex64(devBase)
    UartPutc(10)

    # bring-up: reset -> ack -> driver -> features-ok -> driver-ok
    DevSt32(devBase, RegStatus, 0)
    let q0 = DevLd32(devBase, RegStatus)
    DevSt32(devBase, RegStatus, q0 | 1)
    let q1 = DevLd32(devBase, RegStatus)
    DevSt32(devBase, RegStatus, q1 | 2)
    let q2 = DevLd32(devBase, RegStatus)
    DevSt32(devBase, RegStatus, q2 | 8)
    let q3 = DevLd32(devBase, RegStatus)
    if (q3 & 8) == 0:
        UartPutc(70)
        UartPutc(49)
        UartPutc(10)
        ExitQemu(uint64(0x3333))
        return 2

    # legacy queue 0: page size -> queue select -> align -> pfns -> ready
    DevSt32(devBase, uint64(0x028), 4096)
    DevSt32(devBase, uint64(0x030), 0)
    DevSt32(devBase, uint64(0x038), 64)
    DevSt32(devBase, uint64(0x03C), 4096)
    DevSt32(devBase, uint64(0x040), uint32(DescBase / 4096))
    let q4 = DevLd32(devBase, RegStatus)
    DevSt32(devBase, RegStatus, q4 | 4)

    # render frame: gradient + card + bars
    RasterBackground()
    RasterCard(80, 120, 300, 180, 24, uint64(15779960), uint64(4294967295))
    RasterBar(460, 300, 40, 120, uint64(16024318))
    RasterBar(520, 340, 40, 80, uint64(3983440))
    RasterBar(580, 260, 40, 160, uint64(1986780))

    # command payloads (one per 1 KiB block), per virtio-gpu spec:
    #   CREATE_2D: hdr24 format@24 width@28 height@32
    #   ATTACH:    hdr24 resource_id@24 nr_entries@28 entry{addr8,len4,pad4}@32
    #   SET_SCANOUT: hdr24 r{x,y,w,h}@24 scanout_id@40 resource_id@44
    #   TRANSFER:  hdr24 offset@24 r@32 resource_id@48
    #   FLUSH:     hdr24 r@24 resource_id@40 pad@44
    RamSt32(CmdBase0 + 0, 257)
    RamSt32(CmdBase0 + 4, 0)
    RamSt64(CmdBase0 + 8, 0)
    RamSt32(CmdBase0 + 16, 0)
    RamSt32(CmdBase0 + 20, 0)
    RamSt32(CmdBase0 + 24, 1)
    RamSt32(CmdBase0 + 28, 1)
    RamSt32(CmdBase0 + 32, 640)
    RamSt32(CmdBase0 + 36, 480)
    RamSt32(CmdBase1 + 0, 262)
    RamSt32(CmdBase1 + 4, 0)
    RamSt64(CmdBase1 + 8, 0)
    RamSt32(CmdBase1 + 16, 0)
    RamSt32(CmdBase1 + 20, 0)
    RamSt32(CmdBase1 + 24, 1)
    RamSt32(CmdBase1 + 28, 1)
    RamSt32(CmdBase1 + 32, uint32(FbBase))
    RamSt32(CmdBase1 + 36, 0)
    RamSt32(CmdBase1 + 40, 1228800)
    RamSt32(CmdBase1 + 44, 0)
    # TRANSFER first (fills resource from backing), then SET_SCANOUT binds
    # the display: the scanout update shows the resource's current content.
    RamSt32(CmdBase2 + 0, 260)
    RamSt32(CmdBase2 + 4, 0)
    RamSt64(CmdBase2 + 8, 0)
    RamSt32(CmdBase2 + 16, 0)
    RamSt32(CmdBase2 + 20, 0)
    RamSt32(CmdBase2 + 24, 0)
    RamSt32(CmdBase2 + 28, 0)
    RamSt32(CmdBase2 + 32, 0)
    RamSt32(CmdBase2 + 36, 0)
    RamSt32(CmdBase2 + 40, 640)
    RamSt32(CmdBase2 + 44, 480)
    RamSt32(CmdBase2 + 48, 1)
    RamSt32(CmdBase2 + 52, 0)
    RamSt32(CmdBase3 + 0, 259)
    RamSt32(CmdBase3 + 4, 0)
    RamSt64(CmdBase3 + 8, 0)
    RamSt32(CmdBase3 + 16, 0)
    RamSt32(CmdBase3 + 20, 0)
    RamSt32(CmdBase3 + 24, 0)
    RamSt32(CmdBase3 + 28, 0)
    RamSt32(CmdBase3 + 32, 640)
    RamSt32(CmdBase3 + 36, 480)
    RamSt32(CmdBase3 + 40, 0)
    RamSt32(CmdBase3 + 44, 1)
    RamSt32(CmdBase4 + 0, 261)
    RamSt32(CmdBase4 + 4, 0)
    RamSt64(CmdBase4 + 8, 0)
    RamSt32(CmdBase4 + 16, 0)
    RamSt32(CmdBase4 + 20, 0)
    RamSt32(CmdBase4 + 24, 11)
    RamSt32(CmdBase4 + 28, 22)
    RamSt32(CmdBase4 + 32, 33)
    RamSt32(CmdBase4 + 36, 44)
    RamSt32(CmdBase4 + 40, 55)
    RamSt32(CmdBase4 + 44, 66)

    # desc chains: payload desc @ index 2*di, response desc @ index 2*di+1;
    # avail entry di points at payload desc 2*di. Legacy avail layout:
    # flags u16 @+0, idx u16 @+2, entries @+4.
    # No managed containers here: a seq literal would drag cheng_mem_release
    # (ORC runtime) into the bare-metal obj; scalar selection keeps the
    # image runtime-free.
    var di = 0
    while di < 5:
        let payloadIdx = di * 2
        let descOff = payloadIdx * 16
        # branch-free: CmdBase_i = CmdBase0 + i*0x400. The cold backend's
        # if/elif chain mis-generated here (di=2 landed in the di=4 branch,
        # QEMU saw CREATE,ATTACH,FLUSH,SCANOUT,TRANSFER in trace).
        let cmdBase = CmdBase0 + uint64(di) * 1024
        RamSt32(DescBase + uint64(descOff), uint32(cmdBase))
        RamSt32(DescBase + uint64(descOff) + 4, 0)
        # payload sizes: CREATE 24+12=40, ATTACH 24+8+16=48,
        # SET_SCANOUT 24+24=48, TRANSFER 24+8+20=52->56, FLUSH 24+20=44->48
        var plen = 48
        if di == 0:
            plen = 40
        if di == 3:
            plen = 56
        RamSt32(DescBase + uint64(descOff) + 8, plen)
        RamSt16(DescBase + uint64(descOff) + 12, 1)
        RamSt16(DescBase + uint64(descOff) + 14, payloadIdx + 1)
        # response desc (device-write) right after each payload desc
        let respDescOff = descOff + 16
        RamSt32(DescBase + uint64(respDescOff), uint32(RespBase))
        RamSt32(DescBase + uint64(respDescOff) + 4, 0)
        RamSt32(DescBase + uint64(respDescOff) + 8, 32)
        RamSt16(DescBase + uint64(respDescOff) + 12, 2)
        RamSt16(DescBase + uint64(respDescOff) + 14, 0)
        # avail entry
        RamSt16(AvailBase + uint64(4 + di * 2), payloadIdx)
        di = di + 1
    RamSt16(AvailBase + 0, 0)
    RamSt16(AvailBase + 2, 5)

    # kick
    DevSt32(devBase, uint64(0x050), 0)

    # poll used.idx == 5
    var spins = 0
    var alldone = 0
    while spins < 200000000:
        let usedIdx = RamLd16(UsedIdxAddr)
        if usedIdx == 5:
            alldone = 1
            spins = 200000000
        spins = spins + 1

    if alldone == 0:
        UartTag5(116, 105, 109, 101, 111)  # "timeo: "
        UartHex32(uint32(0))
        UartPutc(10)
        ExitQemu(uint64(0x3333))
        return 3

    # all five commands share one response buffer; the last (FLUSH) response
    # is the one left standing -- require OK_NO_DATA (0x1100)
    let respKind = RamLd32(RespBase)
    if respKind != 4352:
        UartTag5(114, 115, 112, 111, 107)  # "rspok" mismatch
        UartHex32(uint32(respKind))
        UartPutc(10)
        ExitQemu(uint64(0x3333))
        return 4

    UartTag5(71, 80, 85, 79, 75)  # "GPUOK: "
    UartHex32(uint32(5))
    UartPutc(10)
    # park: the gate screendumps the settled frame and kills QEMU. The loop
    # polls UART LSR so the load is real and cannot be dead-coded.
    var park = 1
    while park == 1:
        let lsr = MmioLd8(UartBase + uint64(5))
        park = int32(lsr & uint64(1))
    return 0
