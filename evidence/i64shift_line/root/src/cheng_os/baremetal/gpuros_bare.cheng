# GPUROS: pure-Cheng bare-metal GPU rendering (riscv64 bare linkerless).
#
# Single translation unit; QEMU riscv64 virt -bios none boots the image and
# the guest drives a virtio-gpu device over virtio-mmio: probe, bring-up,
# one software-rasterized frame, transfer + flush to the scanout.
#
# Boot: UART 0x10000000 carries bring-up traces; the boot stub prints
# "cheng_driver_safe_ok" after main returns 0.
#
# Fixed guest-physical layout (RAM 0x80000000..0x88000000, image below
# 0x80100000, stack top 0x81000000):
#   0x82000000 framebuffer 640x480x4
#   0x82200000..0x82207000 control/cursor rings + command/response buffers

@profile("driver_safe")

type
    IoUInt8Ptr = uint8 *
    IoUInt16Ptr = uint16 *
    IoUInt32Ptr = uint32 *
    IoUInt64Ptr = uint64 *

# ---- trusted volatile access -------------------------------------------
# Writers are void @trusted_abi; readers are plain fns so their results
# stay capturable at every call site.

@trusted_abi
fn IoSt8(base: uint64, offset: uint64, value: int32) =
    let b = base
    let o = offset
    let addr = ptr(b + o)
    *(IoUInt8Ptr(addr)) = uint8(value & 255)

@trusted_abi
fn IoSt32(base: uint64, offset: uint64, value: uint32) =
    let b = base
    let o = offset
    let addr = ptr(b + o)
    *(IoUInt32Ptr(addr)) = value

@trusted_abi
fn IoRamSt16(base: uint64, byteOffset: int32, value: int32) =
    let b = base
    let o = byteOffset
    let addr = ptr(b + uint64(o))
    *(IoUInt16Ptr(addr)) = uint16(value & 65535)

@trusted_abi
fn IoRamSt32(base: uint64, byteOffset: int32, value: uint32) =
    let b = base
    let o = byteOffset
    let addr = ptr(b + uint64(o))
    *(IoUInt32Ptr(addr)) = value

@trusted_abi
fn IoRamSt64(base: uint64, byteOffset: int32, value: uint64) =
    let b = base
    let o = byteOffset
    let addr = ptr(b + uint64(o))
    *(IoUInt64Ptr(addr)) = value

fn IoLd8(base: uint64, offset: uint64): int32 =
    let b = base
    let o = offset
    let addr = ptr(b + o)
    return int32(*(IoUInt8Ptr(addr)))

fn IoLd32(base: uint64, offset: uint64): int32 =
    let b = base
    let o = offset
    let addr = ptr(b + o)
    return int32(*(IoUInt32Ptr(addr)))

fn IoRamLd16(base: uint64, byteOffset: int32): int32 =
    let b = base
    let o = byteOffset
    let addr = ptr(b + uint64(o))
    return int32(*(IoUInt16Ptr(addr)))

fn IoRamLd32(base: uint64, byteOffset: int32): int32 =
    let b = base
    let o = byteOffset
    let addr = ptr(b + uint64(o))
    return int32(*(IoUInt32Ptr(addr)))

@trusted_abi
fn IoLd32(base: uint64, offset: uint64): int32 =
    let b = base
    let o = offset
    let addr = ptr(b + o)
    return int32(*(IoUInt32Ptr(addr)))

@trusted_abi
fn IoSt32(base: uint64, offset: uint64, value: uint32) =
    let b = base
    let o = offset
    let addr = ptr(b + o)
    *(IoUInt32Ptr(addr)) = value

@trusted_abi
fn IoRamSt16(base: uint64, byteOffset: int32, value: int32) =
    let b = base
    let o = byteOffset
    let addr = ptr(b + uint64(o))
    *(IoUInt16Ptr(addr)) = uint16(value & 65535)

@trusted_abi
fn IoRamSt32(base: uint64, byteOffset: int32, value: uint32) =
    let b = base
    let o = byteOffset
    let addr = ptr(b + uint64(o))
    *(IoUInt32Ptr(addr)) = value

@trusted_abi
fn IoRamLd16(base: uint64, byteOffset: int32): int32 =
    let b = base
    let o = byteOffset
    let addr = ptr(b + uint64(o))
    return int32(*(IoUInt16Ptr(addr)))

@trusted_abi
fn IoRamLd32(base: uint64, byteOffset: int32): int32 =
    let b = base
    let o = byteOffset
    let addr = ptr(b + uint64(o))
    return int32(*(IoUInt32Ptr(addr)))

# ---- ns16550a UART (0x10000000) --------------------------------------

const UartBaseRaw: uint64 = 0x10000000
const UartOffThr: uint64 = 0
const UartOffLsr: uint64 = 5
const UartLsrThrEmpty: int32 = 0x20

fn UartPutc(ch: int32) =
    var spins = 0
    while spins < 100000:
        let line = IoLd8(UartBaseRaw, UartOffLsr)
        if (line & UartLsrThrEmpty) != 0:
            break
        spins = spins + 1
    IoSt8(UartBaseRaw, UartOffThr, ch & 255)

fn UartHex32(value: int32) =
    var div = 268435456
    while div > 0:
        let nibble = (value / div) & 15
        if nibble < 10:
            UartPutc(48 + nibble)
        else:
            UartPutc(87 + nibble)
        div = div / 16

fn UartHex64(value: uint64) =
    let hi = uint32(value / uint64(4294967296))
    let lo = uint32(value & uint64(4294967295))
    UartHex32(int32(hi))
    UartHex32(int32(lo))

fn UartTag5(a: int32, b: int32, c: int32, d: int32, e: int32) =
    UartPutc(a)
    UartPutc(b)
    UartPutc(c)
    UartPutc(d)
    UartPutc(e)
    UartPutc(58)
    UartPutc(32)

fn TraceFail(tagA: int32, tagB: int32, tagC: int32, code: int32) =
    UartTag5(102, 97, 105, 108, 32)  # "fail: "
    UartPutc(tagA)
    UartPutc(tagB)
    UartPutc(tagC)
    UartPutc(32)
    UartHex32(uint32(code))
    UartPutc(10)

# ---- virtio-mmio legacy registers --------------------------------------

const VmioSlot7: uint64 = 0x10008000
const VmioSlot6: uint64 = 0x10007000

const VirtioDevGpu: int32 = 16

const RegStatusC: uint64 = 0x070
const RegQueueNotifyL: uint64 = 0x050

# ring layout (legacy, align 4096, num 64):
#   desc @ 0x82200000, avail @ 0x82200400, used @ 0x82201000
const DescBase: uint64 = 2183135232
const AvailBase: uint64 = 2183136256
const UsedIdxAddr: uint64 = 2183140354
const CmdBuf: uint64 = 2183159808
const RespBuf: uint64 = 2183163904

@trusted_abi
fn IoLd32(base: uint64, offset: uint64): int32 =
    let b = base
    let o = offset
    let addr = ptr(b + o)
    return int32(*(IoUInt32Ptr(addr)))

@trusted_abi
fn IoSt32(base: uint64, offset: uint64, value: uint32) =
    let b = base
    let o = offset
    let addr = ptr(b + o)
    *(IoUInt32Ptr(addr)) = value

@trusted_abi
fn IoRamSt16(base: uint64, byteOffset: int32, value: int32) =
    let b = base
    let o = byteOffset
    let addr = ptr(b + uint64(o))
    *(IoUInt16Ptr(addr)) = uint16(value & 65535)

@trusted_abi
fn IoRamSt32(base: uint64, byteOffset: int32, value: uint32) =
    let b = base
    let o = byteOffset
    let addr = ptr(b + uint64(o))
    *(IoUInt32Ptr(addr)) = value

@trusted_abi
fn IoRamLd16(base: uint64, byteOffset: int32): int32 =
    let b = base
    let o = byteOffset
    let addr = ptr(b + uint64(o))
    return int32(*(IoUInt16Ptr(addr)))

@trusted_abi
fn IoRamLd32(base: uint64, byteOffset: int32): int32 =
    let b = base
    let o = byteOffset
    let addr = ptr(b + uint64(o))
    return int32(*(IoUInt32Ptr(addr)))

const GpuRespOkNoData: int32 = 4352
const GpuFmtBgrx: int32 = 1

# ---- raster (FbBase 0x82000000, 640x480x4) ------------------------------

fn RasterPixel(x: int32, y: int32, rgb: int32) =
    if x < 0 || y < 0 || x >= 640 || y >= 480:
        return
    let off = (y * 640 + x) * 4
    IoRamSt32(2181038080, off, uint32(4294967295))

fn RasterBackground() =
    var y = 0
    while y < 480:
        var x = 0
        while x < 640:
            let t = x * 48 / 640
            let v = y * 20 / 480
            let r = 30 + t / 2
            let g = 38 + t / 2 + v / 2
            let b = 56 + t + v
            let color = r * 65536 + g * 256 + b
            RasterPixel(x, y, color)
            x = x + 1
        y = y + 1

fn RasterCard(cx: int32, cy: int32, cw: int32, ch: int32, radius: int32,
              fill: int32, border: int32) =
    let x1 = cx + cw
    let y1 = cy + ch
    let r2 = radius * radius
    let innerR2 = (radius - 2) * (radius - 2)
    var y = cy
    while y < y1:
        var x = cx
        while x < x1:
            var dx = x - (x1 - radius)
            if x < cx + radius:
                dx = cx + radius - x
            var dy = y - (y1 - radius)
            if y < cy + radius:
                dy = cy + radius - y
            if dx < 0:
                dx = 0 - dx
            if dy < 0:
                dy = 0 - dy
            let d2 = dx * dx + dy * dy
            if d2 <= innerR2:
                RasterPixel(x, y, fill)
            else:
                if d2 <= r2:
                    RasterPixel(x, y, border)
            x = x + 1
        y = y + 1

fn RasterBar(bx: int32, by: int32, bw: int32, bh: int32, rgb: int32) =
    var y = by
    while y < by + bh:
        var x = bx
        while x < bx + bw:
            RasterPixel(x, y, rgb)
            x = x + 1
        y = y + 1

fn RasterFrame() =
    var off = 0
    while off < 1228800:
        IoRamSt32(2181038080, off, uint32(65280))
        off = off + 4

# ---- entry ---------------------------------------------------------------

const GpuRespOk: int32 = 4352
const GpuFmtBgrx: int32 = 1
const GpuCmdCreate2D: int32 = 257
const GpuCmdAttach: int32 = 262
const GpuCmdSetScanout: int32 = 259
const GpuCmdTransfer2D: int32 = 260
const GpuCmdFlush: int32 = 261
const GpuRespBuf: uint64 = 2183163904

fn main(): int32 =
    UartTag5(103, 112, 117, 114, 111)  # "gpuro: "

    # scan: highest slot first
    var devBase = uint64(0)
    let d7 = IoLd32(VmioSlot7, uint64(8))
    if d7 == 16:
        devBase = VmioSlot7
    if devBase == uint64(0):
        let d6 = IoLd32(VmioSlot6, uint64(8))
        if d6 == 16:
            devBase = VmioSlot6
    if devBase == uint64(0):
        UartTag5(110, 111, 103, 112, 117)
        UartPutc(10)
        return 1
    UartHex64(devBase)
    UartPutc(10)

    # init
    IoSt32(devBase, RegStatusC, uint32(0))
    let q0 = IoLd32(devBase, RegStatusC)
    let w0 = q0 | uint32(1)
    IoSt32(devBase, RegStatusC, w0)
    let q1 = IoLd32(devBase, RegStatusC)
    let w1 = q1 | uint32(2)
    IoSt32(devBase, RegStatusC, w1)
    let q2 = IoLd32(devBase, RegStatusC)
    let w2 = q2 | uint32(8)
    IoSt32(devBase, RegStatusC, w2)
    let q3 = IoLd32(devBase, RegStatusC)
    if (q3 & uint32(8)) == 0:
        UartPutc(70)
        UartPutc(49)
        UartPutc(10)
        return 2

    # legacy queue setup
    IoSt32(devBase, uint64(0x028), uint32(4096))
    IoSt32(devBase, uint64(0x030), uint32(0))
    IoSt32(devBase, uint64(0x038), uint32(64))
    IoSt32(devBase, uint64(0x03C), uint32(4096))
    IoSt32(devBase, uint64(0x040), uint32(532992))
    let q4 = IoLd32(devBase, RegStatusC)
    let w4 = q4 | uint32(4)
    IoSt32(devBase, RegStatusC, w4)

    # render frame into fb
    RasterFrame()

    # five command payloads
    IoRamSt32(2183159808, 0, uint32(257))
    IoRamSt32(2183159808, 24, uint32(1))
    IoRamSt32(2183159808, 28, uint32(2))
    IoRamSt32(2183159808, 32, uint32(640))
    IoRamSt32(2183159808, 36, uint32(480))
    IoRamSt32(2183160832, 0, uint32(262))
    IoRamSt32(2183160832, 24, uint32(1))
    IoRamSt32(2183160832, 28, uint32(1))
    IoRamSt32(2183160832, 32, uint32(2181038080))
    IoRamSt32(2183160832, 36, uint32(0))
    IoRamSt32(2183160832, 40, uint32(1228800))
    IoRamSt32(2183161856, 0, uint32(259))
    IoRamSt32(2183161856, 24, uint32(0))
    IoRamSt32(2183161856, 28, uint32(1))
    IoRamSt32(2183161856, 32, uint32(0))
    IoRamSt32(2183161856, 36, uint32(0))
    IoRamSt32(2183161856, 40, uint32(640))
    IoRamSt32(2183161856, 44, uint32(480))
    IoRamSt32(2183162880, 0, uint32(260))
    IoRamSt32(2183162880, 24, uint32(0))
    IoRamSt32(2183162880, 28, uint32(0))
    IoRamSt32(2183162880, 32, uint32(640))
    IoRamSt32(2183162880, 36, uint32(480))
    IoRamSt32(2183162880, 48, uint32(1))
    IoRamSt32(2183164928, 0, uint32(261))
    IoRamSt32(2183164928, 24, uint32(0))
    IoRamSt32(2183164928, 28, uint32(0))
    IoRamSt32(2183164928, 32, uint32(640))
    IoRamSt32(2183164928, 36, uint32(480))
    IoRamSt32(2183164928, 40, uint32(1))

    # five desc chains
    IoRamSt32(2183135232, 0, uint32(2183159808))
    IoRamSt32(2183135232, 4, uint32(0))
    IoRamSt32(2183135232, 8, uint32(40))
    IoRamSt16(2183135232, 12, 1)
    IoRamSt16(2183135232, 14, 1)
    IoRamSt32(2183135232, 16, uint32(2183163904))
    IoRamSt32(2183135232, 20, uint32(0))
    IoRamSt32(2183135232, 24, uint32(32))
    IoRamSt16(2183135232, 28, 2)
    IoRamSt16(2183135232, 30, 0)
    IoRamSt32(2183135232, 32, uint32(2183160832))
    IoRamSt32(2183135232, 36, uint32(0))
    IoRamSt32(2183135232, 40, uint32(48))
    IoRamSt16(2183135232, 44, 1)
    IoRamSt16(2183135232, 46, 3)
    IoRamSt32(2183135232, 48, uint32(2183163904))
    IoRamSt32(2183135232, 52, uint32(0))
    IoRamSt32(2183135232, 56, uint32(32))
    IoRamSt16(2183135232, 60, 2)
    IoRamSt16(2183135232, 62, 0)
    IoRamSt32(2183135232, 64, uint32(2183161856))
    IoRamSt32(2183135232, 68, uint32(0))
    IoRamSt32(2183135232, 72, uint32(48))
    IoRamSt16(2183135232, 76, 1)
    IoRamSt16(2183135232, 78, 5)
    IoRamSt32(2183135232, 80, uint32(2183163904))
    IoRamSt32(2183135232, 84, uint32(0))
    IoRamSt32(2183135232, 88, uint32(32))
    IoRamSt16(2183135232, 92, 2)
    IoRamSt16(2183135232, 94, 0)
    IoRamSt32(2183135232, 96, uint32(2183162880))
    IoRamSt32(2183135232, 100, uint32(0))
    IoRamSt32(2183135232, 104, uint32(56))
    IoRamSt16(2183135232, 108, 1)
    IoRamSt16(2183135232, 110, 7)
    IoRamSt32(2183135232, 112, uint32(2183163904))
    IoRamSt32(2183135232, 116, uint32(0))
    IoRamSt32(2183135232, 120, uint32(32))
    IoRamSt16(2183135232, 124, 2)
    IoRamSt16(2183135232, 126, 0)
    IoRamSt32(2183135232, 128, uint32(2183164928))
    IoRamSt32(2183135232, 132, uint32(0))
    IoRamSt32(2183135232, 136, uint32(48))
    IoRamSt16(2183135232, 140, 1)
    IoRamSt16(2183135232, 142, 9)
    IoRamSt32(2183135232, 144, uint32(2183163904))
    IoRamSt32(2183135232, 148, uint32(0))
    IoRamSt32(2183135232, 152, uint32(32))
    IoRamSt16(2183135232, 156, 2)
    IoRamSt16(2183135232, 158, 0)

    # avail entries + idx
    IoRamSt16(2183136256, 4, 0)
    IoRamSt16(2183136256, 6, 2)
    IoRamSt16(2183136256, 8, 4)
    IoRamSt16(2183136256, 10, 6)
    IoRamSt16(2183136256, 12, 8)
    IoRamSt16(2183136256, 2, 5)
    IoSt32(devBase, uint64(0x050), uint32(0))

    # poll used.idx == 5
    var spins = 0
    var alldone = 0
    while spins < 200000000:
        let usedIdx = IoRamLd16(2183139328, 2)
        if usedIdx == 5:
            alldone = 1
            spins = 200000000
        spins = spins + 1

    if alldone == 0:
        UartPutc(84)
        UartPutc(49)
        UartPutc(10)
        return 8

    UartTag5(103, 112, 117, 114, 111)  # "gpuro"
    UartPutc(95)
    UartPutc(111)
    UartPutc(107)
    UartPutc(10)
    var park = 0
    while park < 2000000000000:
        park = park + 1
    return 0
