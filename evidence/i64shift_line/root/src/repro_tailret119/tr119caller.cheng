import std/result
import repro_tailret119/tr119lib

fn bumpBox(b: var Box, v: int32): Result[bool] =
    addOne(b, v)

fn main(): int32 =
    var box: Box
    box.n = 10
    var r: Result[bool] = bumpBox(box, 5)
    if IsErr(r):
        echo("unexpected err on success path")
        return 1
    if !Value(r):
        echo("unexpected ok=false on success path")
        return 1
    if box.n != 15:
        echo(Fmt"unexpected n={box.n} want=15")
        return 1
    echo(Fmt"success path: n={box.n} ok={Value(r)}")

    var box2: Box
    box2.n = 999
    var r2: Result[bool] = bumpBox(box2, -1)
    if !IsErr(r2):
        echo("unexpected ok on failure path")
        return 1
    if box2.n != 999:
        echo(Fmt"failure path mutated box unexpectedly n={box2.n} want=999")
        return 1
    echo(Fmt"failure path: n={box2.n} err={ErrorText(r2)}")
    return 0
