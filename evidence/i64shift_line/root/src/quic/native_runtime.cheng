# Test-only seeders: external test modules cannot index the imported gMsQuicSessions
# array directly (cold backend forbids indexing an imported global sequence), so the
# indexing happens here (same-module local) and tests call these instead.
fn msquicNativeTestSetSession0Active(v: bool) =
    gMsQuicSessions[msquicNativeCurSlot].active = v

fn msquicNativeTestSetSession0Closed(v: bool) =
    gMsQuicSessions[msquicNativeCurSlot].closed = v

fn msquicNativeTestSetSession0ServerBound(v: bool) =
    gMsQuicSessions[msquicNativeCurSlot].serverBound = v

fn msquicNativeTestSetSession0ServerFlightSent(v: bool) =
    gMsQuicSessions[msquicNativeCurSlot].serverFlightSent = v

fn msquicNativeTestSetSession0ClientAddrText(v: str) =
    gMsQuicSessions[msquicNativeCurSlot].clientAddrText = v

fn msquicNativeClientAppStreamAt(idx: int32): MsQuicNativeAppStreamSlot =
    return gClientAppStream[msquicNativeCurSlot * msquicNativeAppStreamSlotCount + idx]

fn msquicNativeServerAppStreamAt(idx: int32): MsQuicNativeAppStreamSlot =
    return gServerAppStream[msquicNativeCurSlot * msquicNativeAppStreamSlotCount + idx]

fn msquicNativeSetClientAppStreamAt(idx: int32, slot: MsQuicNativeAppStreamSlot) =
