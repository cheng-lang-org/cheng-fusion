fn msquicNativeEmptyAppStreamSlot(): MsQuicNativeAppStreamSlot =
    var slot: MsQuicNativeAppStreamSlot
    slot.used = false
    slot.streamId = 0
    slot.sendOffset = 0
    slot.writeClosed = false
    slot.ready = emptyBytes()
    slot.nextOffset = 0
    slot.peerClosed = false
    slot.peerFinalOffset = 0
    slot.pendingCount = 0
    # pending 定长数组由 var 零填充产生 (payload-less MAKE_COMPOSITE 的
    # codegen_zero_slot 语义) 即 used=false/offset=0/data=nil, 与显式逐元素
    # 写零等价; 显式循环会触发 wide fixed-array 字段元素存储, 该形状尚未被
    # 审计版本化机制支持, 删除冗余写零。
    return slot

