        listenerDatapathId: int32
        dialAddr: multiaddress.MultiAddress
        listenAddr: multiaddress.MultiAddress
        clientSettings: msquicruntime.MsQuicSettings
        serverSettings: msquicruntime.MsQuicSettings
        clientTlsPolicy: policy.MsQuicTlsPolicy
        serverTlsPolicy: policy.MsQuicTlsPolicy
        clientCid: rawbytes.Bytes
        serverCid: rawbytes.Bytes
        clientInitialNext: int64
        serverInitialNext: int64
        clientHandshakeNext: int64
        serverHandshakeNext: int64
        clientAppNext: int64
        serverAppNext: int64
        serverLargestInitialRecv: int64
        clientLargestHandshakeRecv: int64
        clientLargestAppRecv: int64
        serverLargestAppRecv: int64
        client: MsQuicNativeEndpoint
        server: MsQuicNativeEndpoint
        # --- consolidated session work-state (migrated from module-level globals) ---
        # STILL module-global (two distinct unfixed cold-backend codegen bugs):
        #  (1) crypto streams (MsQuicCryptoStream) + conn impls (MsQuicConnImpl) +
        #      app stream slots (MsQuicNativeAppStreamSlot): code does whole-struct
        #      load `var s = g.field` / store-back `g.field = s` of a struct that
        #      CONTAINS an array field. Cold backend drops the array contents when
        #      the store destination is a field of a global struct. Repro:
        #      docs/repro/cold_struct_array_field_wholestore.cheng.
        #  (2) SACK bit arrays are int32[4096]: a struct array field whose length is
        #      a power of two (>=4096) crashes on param-indexed access (SIGTRAP).
        #      Repro: docs/repro/cold_struct_array_field_pow2_4096.cheng.
        # Datagram0..15 (32 scalar Bytes) MIGRATED below (no array field, safe).
        # flow control (MsQuicFlowControl is scalar-only -> safe to embed)
        clientFlow: flow_control_model.MsQuicFlowControl
        serverFlow: flow_control_model.MsQuicFlowControl
        clientConnWindow: int64
        clientStreamWindow: int64
        serverConnWindow: int64
        serverStreamWindow: int64
        clientMaxDataSent: bool
        serverMaxDataSent: bool
        clientMaxStreamDataSent: bool
        serverMaxStreamDataSent: bool
        # SACK frontier (bits arrays stay module-global: cold backend miscompiles
        # global-struct array-field access via function-parameter index)
        clientSackFrontier: int64
        serverSackFrontier: int64
        # Highest set bitmap index + 1 (0 = no out-of-order bits). Bounds the SACK window
        # scans so in-order delivery (the common case, empty bitmap) costs O(1) instead of
        # scanning all msquicNativeSackWindowBits entries on every recorded packet / ACK build.
        clientSackHigh: int32
        serverSackHigh: int32
        # pending wire (loss-recovery retransmit state)
        clientInitialPendingActive: bool
        clientInitialPendingWire: rawbytes.Bytes
        clientInitialPendingSentAtMs: int64
        clientHandshakePendingActive: bool
        clientHandshakePendingWire: rawbytes.Bytes
        clientHandshakePendingSentAtMs: int64
        clientFinishedReadyPending: bool
        serverHandshakePendingActive: bool
        serverHandshakePendingWire: rawbytes.Bytes
        serverHandshakePendingSentAtMs: int64
        serverHandshakeFirstSentAtMs: int64
        serverHandshakeDoneSent: bool
        debugHandshakePendingLogged: bool
        # recv credit + largest recv + ready
        clientRecvConsumed: int64
        clientRecvCreditHW: int64
        serverRecvConsumed: int64
        serverRecvCreditHW: int64
        clientReady: int32
        serverReady: int32
        # Datagram queues (16 slots each side), migrated from module globals.
        clientDatagram0: rawbytes.Bytes
        clientDatagram1: rawbytes.Bytes
        clientDatagram2: rawbytes.Bytes
        clientDatagram3: rawbytes.Bytes
        clientDatagram4: rawbytes.Bytes
        clientDatagram5: rawbytes.Bytes
        clientDatagram6: rawbytes.Bytes
        clientDatagram7: rawbytes.Bytes
        clientDatagram8: rawbytes.Bytes
        clientDatagram9: rawbytes.Bytes
        clientDatagram10: rawbytes.Bytes
        clientDatagram11: rawbytes.Bytes
        clientDatagram12: rawbytes.Bytes
        clientDatagram13: rawbytes.Bytes
        clientDatagram14: rawbytes.Bytes
        clientDatagram15: rawbytes.Bytes
        serverDatagram0: rawbytes.Bytes
        serverDatagram1: rawbytes.Bytes
        serverDatagram2: rawbytes.Bytes
        serverDatagram3: rawbytes.Bytes
        serverDatagram4: rawbytes.Bytes
        serverDatagram5: rawbytes.Bytes
        serverDatagram6: rawbytes.Bytes
        serverDatagram7: rawbytes.Bytes
        serverDatagram8: rawbytes.Bytes
        serverDatagram9: rawbytes.Bytes
        serverDatagram10: rawbytes.Bytes
        serverDatagram11: rawbytes.Bytes
        serverDatagram12: rawbytes.Bytes
        serverDatagram13: rawbytes.Bytes
        serverDatagram14: rawbytes.Bytes
        serverDatagram15: rawbytes.Bytes
        # cid + policy caches
        clientCidCache: rawbytes.Bytes
        serverCidCache: rawbytes.Bytes
        clientServerNameCache: str
        # ALPN offer (client) / support (server) list, comma-joined preference
        # order; "" means unset (msquicTlsPolicyAlpnListText defaults to "dm").
        clientAlpnOfferCache: str
        serverAlpnSupportedCache: str
        clientTrustRootsCountCache: int32
        clientTrustRoot0Cache: rawbytes.Bytes
        clientTrustRoot1Cache: rawbytes.Bytes
        clientTrustRoot2Cache: rawbytes.Bytes
        clientTrustRoot3Cache: rawbytes.Bytes
        clientCertChainCountCache: int32
        clientCert0Cache: rawbytes.Bytes
        clientCert1Cache: rawbytes.Bytes
        clientCert2Cache: rawbytes.Bytes
        clientCert3Cache: rawbytes.Bytes
        clientLeafKeyKindCache: int32
        clientPrivateKeyCache: rawbytes.Bytes
        clientSendCertificateCache: bool
        serverCertChainCountCache: int32
        serverLeafDerCache: rawbytes.Bytes
        serverCert1Cache: rawbytes.Bytes
        serverCert2Cache: rawbytes.Bytes
        serverCert3Cache: rawbytes.Bytes
        serverLeafKeyKindCache: int32
