fn msquicNativeEnqueueClientDatagram(data: rawbytes.Bytes): Result[bool] =
    let count: int32 = msquicNativeClientDatagramCount
    if count >= msquicNativeDatagramQueue:
        return Err[bool]("msquic native: datagram queue full")
    msquicNativeClientDatagramSet(count, msquicNativeCopyBytes(data))
    msquicNativeClientDatagramCount = count + 1
    return Ok[bool](true)

fn msquicNativeEnqueueServerDatagram(data: rawbytes.Bytes): Result[bool] =
    let count: int32 = msquicNativeServerDatagramCount
    if count >= msquicNativeDatagramQueue:
        return Err[bool]("msquic native: datagram queue full")
    msquicNativeServerDatagramSet(count, msquicNativeCopyBytes(data))
    msquicNativeServerDatagramCount = count + 1
    return Ok[bool](true)

fn msquicNativeEnqueueDatagram(side: int32, data: rawbytes.Bytes): Result[bool] =
    if side == msquicNativeClientSide:
        return msquicNativeEnqueueClientDatagram(data)
    if side == msquicNativeServerSide:
        return msquicNativeEnqueueServerDatagram(data)
    return Err[bool]("msquic native: invalid side")

fn msquicNativeDequeueDatagram(side: int32): Result[rawbytes.Bytes] =
    if side == msquicNativeClientSide:
        if msquicNativeClientDatagramCount <= 0:
            return Err[rawbytes.Bytes]("msquic udp: queue empty")
        let out: rawbytes.Bytes = msquicNativeClientDatagramGet(0)
        for i in 1..<msquicNativeClientDatagramCount:
            msquicNativeClientDatagramSet(i - 1, msquicNativeClientDatagramGet(i))
        msquicNativeClientDatagramSet(msquicNativeClientDatagramCount - 1, emptyBytes())
        msquicNativeClientDatagramCount = msquicNativeClientDatagramCount - 1
        return Ok[rawbytes.Bytes](out)
    if side == msquicNativeServerSide:
        if msquicNativeServerDatagramCount <= 0:
            return Err[rawbytes.Bytes]("msquic udp: queue empty")
        let out: rawbytes.Bytes = msquicNativeServerDatagramGet(0)
        for i in 1..<msquicNativeServerDatagramCount:
            msquicNativeServerDatagramSet(i - 1, msquicNativeServerDatagramGet(i))
        msquicNativeServerDatagramSet(msquicNativeServerDatagramCount - 1, emptyBytes())
        msquicNativeServerDatagramCount = msquicNativeServerDatagramCount - 1
        return Ok[rawbytes.Bytes](out)
    return Err[rawbytes.Bytes]("msquic native: invalid side")

@borrows
fn msquicNativeConnWindow(settings: msquicruntime.MsQuicSettings): int64 =
    if settings.connFlowControlWindow > 0:
        return int64(settings.connFlowControlWindow)
    return 1048576

@borrows
fn msquicNativeStreamWindow(settings: msquicruntime.MsQuicSettings): int64 =
    if settings.streamRecvWindowDefault > 0:
        return int64(settings.streamRecvWindowDefault)
    if settings.streamRecvBufferDefault > 0:
        return int64(settings.streamRecvBufferDefault)
    return 1048576

@borrows
fn msquicNativePacketMtu(settings: msquicruntime.MsQuicSettings): int32 =
    if settings.minimumMtu >= 1200:
        return settings.minimumMtu
    return 1200

@borrows
fn msquicNativeInitialWindowPackets(settings: msquicruntime.MsQuicSettings): int32 =
    if settings.initialWindowPackets > 0:
        return settings.initialWindowPackets
    return 10

fn msquicNativeResetClientDatagrams() =
    msquicNativeClientDatagramCount = 0
    for i in 0..<msquicNativeDatagramQueue:
        msquicNativeClientDatagramSet(i, emptyBytes())

fn msquicNativeResetServerDatagrams() =
    msquicNativeServerDatagramCount = 0
    for i in 0..<msquicNativeDatagramQueue:
        msquicNativeServerDatagramSet(i, emptyBytes())

fn msquicNativeResetClientEndpointState() =
    gMsQuicSessions[msquicNativeCurSlot].clientReady = 0
    gMsQuicSessions[msquicNativeCurSlot].clientMaxDataSent = false
    gMsQuicSessions[msquicNativeCurSlot].clientMaxStreamDataSent = false
    gMsQuicSessions[msquicNativeCurSlot].clientRecvConsumed = 0
    gMsQuicSessions[msquicNativeCurSlot].clientRecvCreditHW = 0

fn msquicNativeResetServerEndpointState() =
    gMsQuicSessions[msquicNativeCurSlot].serverReady = 0
    gMsQuicSessions[msquicNativeCurSlot].serverMaxDataSent = false
    gMsQuicSessions[msquicNativeCurSlot].serverMaxStreamDataSent = false
    gMsQuicSessions[msquicNativeCurSlot].serverRecvConsumed = 0
    gMsQuicSessions[msquicNativeCurSlot].serverRecvCreditHW = 0

fn msquicNativeResetClientAppStreams() =
    for i in 0..<msquicNativeAppStreamSlotCount:
        msquicNativeResetClientSlotEmpty(i)
        msquicNativeSetClientAppPeerClosedAt(i, false, 0)

fn msquicNativeResetServerAppStreams() =
    for i in 0..<msquicNativeAppStreamSlotCount:
        msquicNativeResetServerSlotEmpty(i)
        msquicNativeSetServerAppPeerClosedAt(i, false, 0)

fn msquicNativeResetClientEndpoint(
    settings: var msquicruntime.MsQuicSettings,
    requireCert: bool
) =
    handshake13.msquicTls13ResetClientDefault(requireCert)
    let clientMaxData: int64 = msquicNativeConnWindow(settings)
    let clientMaxStreamData: int64 = msquicNativeStreamWindow(settings)
    gMsQuicSessions[msquicNativeCurSlot].clientConnWindow = clientMaxData
    gMsQuicSessions[msquicNativeCurSlot].clientStreamWindow = clientMaxStreamData
    var clientFlow: flow_control_model.MsQuicFlowControl
    initMsQuicFlowControlInto(clientFlow, clientMaxData, clientMaxStreamData)
    gMsQuicSessions[msquicNativeCurSlot].clientFlow = clientFlow
    initMsQuicConnImpl(msquicNativeClientImpl[msquicNativeCurSlot],
                       0,
                       clientFlow,
                       msquicNativePacketMtu(settings),
                       msquicNativeInitialWindowPackets(settings))
    gMsQuicSessions[msquicNativeCurSlot].clientFlow = clientFlow
    crypto_stream.initMsQuicCryptoStreamInto(msquicNativeClientInitialCrypto[msquicNativeCurSlot])
    crypto_stream.initMsQuicCryptoStreamInto(msquicNativeClientHandshakeCrypto[msquicNativeCurSlot])
    msquicNativeResetClientAppStreams()
    msquicNativeResetClientDatagrams()
    msquicNativeResetClientEndpointState()

fn msquicNativeResetServerEndpoint(
    settings: var msquicruntime.MsQuicSettings,
    requireCert: bool
) =
    handshake13.msquicTls13ResetServerDefault(requireCert)
    let serverMaxData: int64 = msquicNativeConnWindow(settings)
    let serverMaxStreamData: int64 = msquicNativeStreamWindow(settings)
    gMsQuicSessions[msquicNativeCurSlot].serverConnWindow = serverMaxData
    gMsQuicSessions[msquicNativeCurSlot].serverStreamWindow = serverMaxStreamData
    var serverFlow: flow_control_model.MsQuicFlowControl
    initMsQuicFlowControlInto(serverFlow, serverMaxData, serverMaxStreamData)
    gMsQuicSessions[msquicNativeCurSlot].serverFlow = serverFlow
    initMsQuicConnImpl(msquicNativeServerImpl[msquicNativeCurSlot],
                       1,
                       serverFlow,
                       msquicNativePacketMtu(settings),
                       msquicNativeInitialWindowPackets(settings))
    gMsQuicSessions[msquicNativeCurSlot].serverFlow = serverFlow
    crypto_stream.initMsQuicCryptoStreamInto(msquicNativeServerInitialCrypto[msquicNativeCurSlot])
    crypto_stream.initMsQuicCryptoStreamInto(msquicNativeServerHandshakeCrypto[msquicNativeCurSlot])
    msquicNativeResetServerAppStreams()
    msquicNativeResetServerDatagrams()
    msquicNativeResetServerEndpointState()

fn msquicNativeCryptoStreamAvailableByCode(side: int32, packetTypeCode: int32): int32 =
    if side == msquicNativeClientSide:
        if packetTypeCode == msquicNativePacketInitialCode:
            return crypto_stream.msquicCryptoStreamAvailable(msquicNativeClientInitialCrypto[msquicNativeCurSlot])
        if packetTypeCode == msquicNativePacketHandshakeCode:
            return crypto_stream.msquicCryptoStreamAvailable(msquicNativeClientHandshakeCrypto[msquicNativeCurSlot])
        return 0
    if side == msquicNativeServerSide:
        if packetTypeCode == msquicNativePacketInitialCode:
            return crypto_stream.msquicCryptoStreamAvailable(msquicNativeServerInitialCrypto[msquicNativeCurSlot])
        if packetTypeCode == msquicNativePacketHandshakeCode:
            return crypto_stream.msquicCryptoStreamAvailable(msquicNativeServerHandshakeCrypto[msquicNativeCurSlot])
        return 0
    return 0

fn msquicNativeCryptoStreamConsumeByCode(side: int32, packetTypeCode: int32, length: int32): rawbytes.Bytes =
    if side == msquicNativeClientSide:
        if packetTypeCode == msquicNativePacketInitialCode:
            return crypto_stream.msquicCryptoStreamConsume(msquicNativeClientInitialCrypto[msquicNativeCurSlot], length)
        if packetTypeCode == msquicNativePacketHandshakeCode:
            return crypto_stream.msquicCryptoStreamConsume(msquicNativeClientHandshakeCrypto[msquicNativeCurSlot], length)
        return emptyBytes()
    if side == msquicNativeServerSide:
        if packetTypeCode == msquicNativePacketInitialCode:
            return crypto_stream.msquicCryptoStreamConsume(msquicNativeServerInitialCrypto[msquicNativeCurSlot], length)
        if packetTypeCode == msquicNativePacketHandshakeCode:
            return crypto_stream.msquicCryptoStreamConsume(msquicNativeServerHandshakeCrypto[msquicNativeCurSlot], length)
        return emptyBytes()
    return emptyBytes()

fn msquicNativeCryptoStreamAddByCode(side: int32, packetTypeCode: int32, offset: int64, data: rawbytes.Bytes): Result[bool] =
    if side == msquicNativeClientSide:
        if packetTypeCode == msquicNativePacketInitialCode:
            return crypto_stream.msquicCryptoStreamAdd(msquicNativeClientInitialCrypto[msquicNativeCurSlot], offset, data)
        if packetTypeCode == msquicNativePacketHandshakeCode:
            return crypto_stream.msquicCryptoStreamAdd(msquicNativeClientHandshakeCrypto[msquicNativeCurSlot], offset, data)
        return Ok[bool](true)
    if side == msquicNativeServerSide:
        if packetTypeCode == msquicNativePacketInitialCode:
            return crypto_stream.msquicCryptoStreamAdd(msquicNativeServerInitialCrypto[msquicNativeCurSlot], offset, data)
        if packetTypeCode == msquicNativePacketHandshakeCode:
            return crypto_stream.msquicCryptoStreamAdd(msquicNativeServerHandshakeCrypto[msquicNativeCurSlot], offset, data)
        return Ok[bool](true)
    return Err[bool]("msquic native: invalid side")

fn msquicNativeFindAppStreamSlot(side: int32, streamId: int64): int32 =
    if side == msquicNativeClientSide:
        for i in 0..<msquicNativeAppStreamSlotCount:
            let slot: MsQuicNativeAppStreamSlot = msquicNativeClientAppStreamAt(i)
            if slot.used && slot.streamId == streamId:
                return i
        return -1
    if side == msquicNativeServerSide:
        for i in 0..<msquicNativeAppStreamSlotCount:
            let slot: MsQuicNativeAppStreamSlot = msquicNativeServerAppStreamAt(i)
            if slot.used && slot.streamId == streamId:
                return i
        return -1
    return -1

fn msquicNativeEnsureAppStreamSlot(side: int32, streamId: int64): Result[int32] =
    let existing: int32 = msquicNativeFindAppStreamSlot(side, streamId)
    if existing >= 0:
        return Ok[int32](existing)
    if side == msquicNativeClientSide:
        for i in 0..<msquicNativeAppStreamSlotCount:
            if ! msquicNativeClientSlotUsedAt(i):
                msquicNativeAllocClientSlot(i, streamId)
                msquicNativeSetClientAppPeerClosedAt(i, false, 0)
                return Ok[int32](i)
        return Err[int32]("msquic native: app stream slot full")
    if side == msquicNativeServerSide:
        for i in 0..<msquicNativeAppStreamSlotCount:
            if ! msquicNativeServerSlotUsedAt(i):
                msquicNativeAllocServerSlot(i, streamId)
                msquicNativeSetServerAppPeerClosedAt(i, false, 0)
                return Ok[int32](i)
        return Err[int32]("msquic native: app stream slot full")
    return Err[int32]("msquic native: invalid side")

fn msquicNativeAppRecvAvailable(side: int32, streamId: int64): int32 =
    let slotIdx: int32 = msquicNativeFindAppStreamSlot(side, streamId)
    if slotIdx < 0:
        return 0
    if side == msquicNativeClientSide:
        return msquicNativeClientReadyLen(slotIdx)
    if side == msquicNativeServerSide:
        return msquicNativeServerReadyLen(slotIdx)
    return 0

# 槽显式扫读（F-J 第三层收尾）: 旧形调用方裸写 cur 后调 AppRecvAvailable——
# 裸写无锁, 既被他线程锁内 span 的 pin-then-read 窗口撕裂, 自身读到的也是
# 他线程翻槽后的表 → 扫描 ks 错槽 (真机实测 serve 管道落到 slot 3/7 →
# "session ! ready"/写错槽)。此包装单锁 span 内钉 cur=sessionSlot 再读,
# 调用方不得再裸写 cur。
fn msquicNativeAppRecvAvailableAt(sessionSlot: int32, side: int32, streamId: int64): int32 =
    MsQuicNativeTransportLock()
    msquicNativeCurSlot = sessionSlot
    let avail: int32 = msquicNativeAppRecvAvailable(side, streamId)
    MsQuicNativeTransportUnlock()
    return avail

# Rolling QUIC flow-control credit. The initial MAX_DATA/MAX_STREAM_DATA is sent
# ONCE (msquicNativeQueueTransportCredit, gated by *MaxDataSent) advertising a 1 MiB
# window; the sender enforces it (msquicConnImplQueueData → ConsumeConn/ConsumeStream
# returns "window exceeded"). So a connection could only ever transfer ~1 MiB total
# before the sender stalled (秒开 单 256KB 在窗内→可过;整 mp4 1.8MB 累计越 1MiB→stall
# →22s timeout=-2405). Fix: as the app drains received bytes, re-advertise a higher
# absolute MAX_DATA/MAX_STREAM_DATA (consumed + window) so the window rolls ahead of
# consumption — standard QUIC. UpdateMaxData/RaiseMaxStreamData on the peer only raise
# monotonically, so this never shrinks a window; 秒开(<window/2)不触发任何增发=零回归。
# MAX_DATA/MAX_STREAM_DATA 走 QueueFrameParts(不经 ConsumeConn,纯入队),不受流控阻塞。
fn msquicNativeAdvanceRecvCredit(side: int32, streamId: int64, consumedLen: int32) =
    if consumedLen <= 0:
        return
    if side == msquicNativeClientSide:
        gMsQuicSessions[msquicNativeCurSlot].clientRecvConsumed = gMsQuicSessions[msquicNativeCurSlot].clientRecvConsumed + int64(consumedLen)
        let half: int64 = gMsQuicSessions[msquicNativeCurSlot].clientConnWindow / 2
        if half <= 0:
            return
        if gMsQuicSessions[msquicNativeCurSlot].clientRecvConsumed - gMsQuicSessions[msquicNativeCurSlot].clientRecvCreditHW >= half:
            let connLimit: int64 = gMsQuicSessions[msquicNativeCurSlot].clientRecvConsumed + gMsQuicSessions[msquicNativeCurSlot].clientConnWindow
            let streamLimit: int64 = gMsQuicSessions[msquicNativeCurSlot].clientRecvConsumed + gMsQuicSessions[msquicNativeCurSlot].clientStreamWindow
            let r1: Result[bool] = connection_impl.MsQuicConnImplQueueFrameParts(msquicNativeClientImpl[msquicNativeCurSlot], 16, 0, 0, connLimit, emptyBytes())
            if IsErr(r1):
                return
            let r2: Result[bool] = connection_impl.MsQuicConnImplQueueFrameParts(msquicNativeClientImpl[msquicNativeCurSlot], 17, msquicNativeStreamServer, 0, streamLimit, emptyBytes())
            if IsErr(r2):
                return
            gMsQuicSessions[msquicNativeCurSlot].clientRecvCreditHW = gMsQuicSessions[msquicNativeCurSlot].clientRecvConsumed
        return
    if side == msquicNativeServerSide:
        gMsQuicSessions[msquicNativeCurSlot].serverRecvConsumed = gMsQuicSessions[msquicNativeCurSlot].serverRecvConsumed + int64(consumedLen)
        let halfS: int64 = gMsQuicSessions[msquicNativeCurSlot].serverConnWindow / 2
        if halfS <= 0:
            return
        if gMsQuicSessions[msquicNativeCurSlot].serverRecvConsumed - gMsQuicSessions[msquicNativeCurSlot].serverRecvCreditHW >= halfS:
            let connLimitS: int64 = gMsQuicSessions[msquicNativeCurSlot].serverRecvConsumed + gMsQuicSessions[msquicNativeCurSlot].serverConnWindow
            let streamLimitS: int64 = gMsQuicSessions[msquicNativeCurSlot].serverRecvConsumed + gMsQuicSessions[msquicNativeCurSlot].serverStreamWindow
            let s1: Result[bool] = connection_impl.MsQuicConnImplQueueFrameParts(msquicNativeServerImpl[msquicNativeCurSlot], 16, 0, 0, connLimitS, emptyBytes())
            if IsErr(s1):
                return
            let s2: Result[bool] = connection_impl.MsQuicConnImplQueueFrameParts(msquicNativeServerImpl[msquicNativeCurSlot], 17, msquicNativeStreamClient, 0, streamLimitS, emptyBytes())
            if IsErr(s2):
                return
            gMsQuicSessions[msquicNativeCurSlot].serverRecvCreditHW = gMsQuicSessions[msquicNativeCurSlot].serverRecvConsumed
        return

fn msquicNativeAppRecvConsume(side: int32, streamId: int64, length: int32): rawbytes.Bytes =
    let slotIdx: int32 = msquicNativeFindAppStreamSlot(side, streamId)
    if slotIdx < 0:
        return emptyBytes()
    if side == msquicNativeClientSide:
        let out: rawbytes.Bytes = msquicNativeClientReadyTakePrefix(slotIdx, length)
        msquicNativeAdvanceRecvCredit(side, streamId, BytesLen(out))
        return out
    if side == msquicNativeServerSide:
        let out: rawbytes.Bytes = msquicNativeServerReadyTakePrefix(slotIdx, length)
        msquicNativeAdvanceRecvCredit(side, streamId, BytesLen(out))
        return out
    return emptyBytes()

fn msquicNativeAppRecvPeerClosed(side: int32, streamId: int64): bool =
    let slotIdx: int32 = msquicNativeFindAppStreamSlot(side, streamId)
    if slotIdx < 0:
        return false
    let readyLen: int32 = msquicNativeAppRecvAvailable(side, streamId)
    if side == msquicNativeClientSide:
        if ! msquicNativeClientAppPeerClosedAt(slotIdx):
            return false
        if readyLen > 0:
            return false
        if msquicNativeClientPendingCountAt(slotIdx) > 0:
            return false
        if msquicNativeClientNextOffsetAt(slotIdx) < msquicNativeClientAppPeerFinalAt(slotIdx):
            return false
        return true
    if side == msquicNativeServerSide:
        if ! msquicNativeServerAppPeerClosedAt(slotIdx):
            return false
        if readyLen > 0:
            return false
        if msquicNativeServerPendingCountAt(slotIdx) > 0:
            return false
        if msquicNativeServerNextOffsetAt(slotIdx) < msquicNativeServerAppPeerFinalAt(slotIdx):
            return false
        return true
    return false

# RFC 9000 §2.1: the low 2 bits of a stream ID encode initiator (bit0: 0=client,
# 1=server) and directionality (bit1: 0=bidi, 1=uni). A stream can ever have data
# for `side` to read unless it is unidirectional AND `side` itself is the
# initiator (that combination is `side`'s own write-only stream — nothing the
# peer ever writes there). Client-bidi(%4==0)/server-bidi(%4==1) are readable by
# both sides (either side can write on a bidi stream regardless of who opened
# it); the peer-initiated uni stream is readable too. Previously this hardcoded
# streamId%4==0 (client-bidi only), so server-initiated streams and the
# HTTP/3-mandatory unidirectional control/qpack streams were never observed as
# readable even though bytes were correctly received and buffered.
fn msquicNativeStreamIdReadableBySide(side: int32, streamId: int64): bool =
    let selfInitiatedUniRemainder: int64 = if side == msquicNativeClientSide: int64(2) else: int64(3)
    return (streamId % int64(4)) != selfInitiatedUniRemainder

fn msquicNativeReadableAppStreamIdCurrent(side: int32, minStreamId: int64): Result[int64] =
    if side == msquicNativeClientSide:
        for i in 0..<msquicNativeAppStreamSlotCount:
            let slot: MsQuicNativeAppStreamSlot = msquicNativeClientAppStreamAt(i)
            if slot.used &&
               slot.streamId >= minStreamId &&
               msquicNativeStreamIdReadableBySide(side, slot.streamId) &&
               BytesLen(slot.ready) > 0:
                return Ok[int64](slot.streamId)
        return Err[int64]("msquic udp: queue empty")
    if side == msquicNativeServerSide:
        for i in 0..<msquicNativeAppStreamSlotCount:
            let slot: MsQuicNativeAppStreamSlot = msquicNativeServerAppStreamAt(i)
            if slot.used &&
               slot.streamId >= minStreamId &&
               msquicNativeStreamIdReadableBySide(side, slot.streamId) &&
               BytesLen(slot.ready) > 0:
                return Ok[int64](slot.streamId)
        return Err[int64]("msquic udp: queue empty")
    return Err[int64]("msquic native: invalid side")

fn msquicNativeReadableAppStreamId(pipeIdx: int32,
                                   side: int32,
                                   minStreamId: int64): Result[int64] =
    if ! msquicNativeIsPipeIdx(pipeIdx):
        return Err[int64]("msquic native: invalid pipe")
    MsQuicNativeTransportLock()
    msquicNativeBindSlotFromPipeIdx(pipeIdx)
    if ! gMsQuicSessions[msquicNativeCurSlot].active:
        MsQuicNativeTransportUnlock()
        return Err[int64]("msquic native: session ! active")
    let currentRes: Result[int64] = msquicNativeReadableAppStreamIdCurrent(side, minStreamId)
    let pollSlot: int32 = msquicNativeCurSlot
    MsQuicNativeTransportUnlock()
    if IsOk(currentRes):
        return currentRes
    for _pumpIdx in 0..<msquicNativePumpBudget:
        let pumpRes: Result[int32] = msquicNativePump(1)
        if IsErr(pumpRes):
            return Err[int64](ErrorText(pumpRes))
        MsQuicNativeTransportLock()
        msquicNativeCurSlot = pollSlot
        let readyRes: Result[int64] = msquicNativeReadableAppStreamIdCurrent(side, minStreamId)
        let pollSlotClosed: bool = gMsQuicSessions[pollSlot].closed
        MsQuicNativeTransportUnlock()
        if IsOk(readyRes):
            return readyRes
        if pollSlotClosed:
            return Err[int64]("msquic: pipe closed")
        # The peer's request/negotiate frame for this stream is in flight (one physical RTT
        # away). A non-blocking pump misses it and would spin all budget out in microseconds,
        # bouncing the serve loop back to accept. Block on this side's fd so the frame wakes us
        # the instant it lands instead of after a fixed sleep.
        if ! msquicNativeLastPumpReceived:
            msquicNativeWaitReadableForSide(side, 8)
    return Err[int64]("msquic udp: queue empty")

fn msquicNativeAppSidePendingUsedAt(side: int32, idx: int32, i: int32): bool =
    if side == msquicNativeClientSide:
        return msquicNativeClientPendingUsedAt(idx, i)
    return msquicNativeServerPendingUsedAt(idx, i)

fn msquicNativeAppSidePendingOffsetAt(side: int32, idx: int32, i: int32): int64 =
    if side == msquicNativeClientSide:
        return msquicNativeClientPendingOffsetAt(idx, i)
    return msquicNativeServerPendingOffsetAt(idx, i)

fn msquicNativeAppSidePendingDataAt(side: int32, idx: int32, i: int32): rawbytes.Bytes =
    if side == msquicNativeClientSide:
        return msquicNativeClientPendingDataAt(idx, i)
    return msquicNativeServerPendingDataAt(idx, i)

fn msquicNativeAppSidePendingCountAt(side: int32, idx: int32): int32 =
    if side == msquicNativeClientSide:
        return msquicNativeClientPendingCountAt(idx)
    return msquicNativeServerPendingCountAt(idx)

fn msquicNativeAppSideNextOffsetAt(side: int32, idx: int32): int64 =
    if side == msquicNativeClientSide:
        return msquicNativeClientNextOffsetAt(idx)
    return msquicNativeServerNextOffsetAt(idx)

fn msquicNativeAppSideReadyLen(side: int32, idx: int32): int32 =
    if side == msquicNativeClientSide:
        return msquicNativeClientReadyLen(idx)
    return msquicNativeServerReadyLen(idx)

fn msquicNativeAppSideReadyTakePrefix(side: int32, idx: int32, count: int32): rawbytes.Bytes =
    if side == msquicNativeClientSide:
        return msquicNativeClientReadyTakePrefix(idx, count)
    return msquicNativeServerReadyTakePrefix(idx, count)

fn msquicNativeAppSideIncPendingCount(side: int32, idx: int32, d: int32) =
    if side == msquicNativeClientSide:
        msquicNativeIncClientPendingCount(idx, d)
        return
    msquicNativeIncServerPendingCount(idx, d)

fn msquicNativeAppSideSetNextOffset(side: int32, idx: int32, v: int64) =
    if side == msquicNativeClientSide:
        msquicNativeSetClientNextOffset(idx, v)
        return
    msquicNativeSetServerNextOffset(idx, v)

fn msquicNativeAppSideReadyAppend(side: int32, idx: int32, data: rawbytes.Bytes) =
    if side == msquicNativeClientSide:
        msquicNativeClientReadyAppend(idx, data)
        return
    msquicNativeServerReadyAppend(idx, data)

fn msquicNativeAppSideSetPendingChunk(side: int32, idx: int32, i: int32, used: bool, offset: int64, data: rawbytes.Bytes) =
    if side == msquicNativeClientSide:
        msquicNativeSetClientPendingChunk(idx, i, used, offset, data)
        return
    msquicNativeSetServerPendingChunk(idx, i, used, offset, data)

fn msquicNativeAppSidePeerClosedAt(side: int32, idx: int32): bool =
    if side == msquicNativeClientSide:
        return msquicNativeClientAppPeerClosedAt(idx)
    return msquicNativeServerAppPeerClosedAt(idx)

fn msquicNativeAppSidePeerFinalAt(side: int32, idx: int32): int64 =
    if side == msquicNativeClientSide:
        return msquicNativeClientAppPeerFinalAt(idx)
    return msquicNativeServerAppPeerFinalAt(idx)

fn msquicNativeAppSideSetPeerClosed(side: int32, idx: int32, finalOffset: int64) =
    if side == msquicNativeClientSide:
        msquicNativeSetClientAppPeerClosedAt(idx, true, finalOffset)
        return
    msquicNativeSetServerAppPeerClosedAt(idx, true, finalOffset)

fn msquicNativeAppStreamNormalizeAt(side: int32, idx: int32) =
    # In-order delivery (the common case) has zero out-of-order pending chunks, so the full
    # msquicNativeAppRecvMaxChunks(512)-slot scan is pure waste — it was the dominant per-packet
    # receive cost (measured ~5.8ms/packet → 0.08ms once skipped). Gate on the live count.
    if msquicNativeAppSidePendingCountAt(side, idx) <= 0:
        return
    let next: int64 = msquicNativeAppSideNextOffsetAt(side, idx)
    for i in 0..<msquicNativeAppRecvMaxChunks:
        if msquicNativeAppSidePendingUsedAt(side, idx, i):
            let poff: int64 = msquicNativeAppSidePendingOffsetAt(side, idx, i)
            if poff < next:
                let pdata: rawbytes.Bytes = msquicNativeAppSidePendingDataAt(side, idx, i)
                let trim64: int64 = next - poff
                if trim64 >= int64(BytesLen(pdata)):
                    msquicNativeAppSideSetPendingChunk(side, idx, i, false, 0, emptyBytes())
                    msquicNativeAppSideIncPendingCount(side, idx, -1)
                else:
                    let trim: int32 = int32(trim64)
                    let sliced: rawbytes.Bytes = BytesSlice(pdata, trim, BytesLen(pdata) - trim)
                    msquicNativeAppSideSetPendingChunk(side, idx, i, true, next, sliced)

fn msquicNativeAppStreamDrainAt(side: int32, idx: int32) =
    # Nothing buffered out-of-order → the next in-order bytes were already appended to ready by
    # the caller; skip the 512-slot reorder scan entirely (the per-packet hot path).
    if msquicNativeAppSidePendingCountAt(side, idx) <= 0:
        return
    var advanced: bool = true
    while advanced:
        advanced = false
        msquicNativeAppStreamNormalizeAt(side, idx)
        let next: int64 = msquicNativeAppSideNextOffsetAt(side, idx)
        for i in 0..<msquicNativeAppRecvMaxChunks:
            if msquicNativeAppSidePendingUsedAt(side, idx, i) &&
               msquicNativeAppSidePendingOffsetAt(side, idx, i) == next:
                let data: rawbytes.Bytes = msquicNativeAppSidePendingDataAt(side, idx, i)
                msquicNativeAppSideReadyAppend(side, idx, data)
                msquicNativeAppSideSetNextOffset(side, idx, next + int64(BytesLen(data)))
                msquicNativeAppSideSetPendingChunk(side, idx, i, false, 0, emptyBytes())
                msquicNativeAppSideIncPendingCount(side, idx, -1)
                advanced = true
                break

fn msquicNativeLogAppRecvAt(side: int32,
                            streamId: int64,
                            offset: int64,
                            data: rawbytes.Bytes,
                            idx: int32) =
    if ! msquicNativeDebugTls13:
        return
    var msg = "msquic_native_debug app_recv_add side="
    if side == msquicNativeClientSide:
        msg = strutil.Join([ share(msg), "client"], "")
    elif side == msquicNativeServerSide:
        msg = strutil.Join([ share(msg), "server"], "")
    else:
        msg = strutil.Join([ share(msg), "unknown"], "")
    msg = strutil.Join([ share(msg), " stream=", int64ToStr(streamId)], "")
    msg = strutil.Join([ share(msg), " cur=", IntToStr(msquicNativeCurSlot)], "")
    msg = strutil.Join([ share(msg), " offset=", int64ToStr(offset)], "")
    msg = strutil.Join([ share(msg), " len=", IntToStr(BytesLen(data))], "")
    msg = strutil.Join([ share(msg), " avail=", IntToStr(msquicNativeAppSideReadyLen(side, idx))], "")
    msg = strutil.Join([ share(msg), " next=", int64ToStr(msquicNativeAppSideNextOffsetAt(side, idx))], "")
    if msquicNativeAppSidePeerClosedAt(side, idx):
        msg = strutil.Join([ share(msg), " fin=", int64ToStr(msquicNativeAppSidePeerFinalAt(side, idx))], "")
    msg = strutil.Join([ share(msg), " pending=", IntToStr(msquicNativeAppSidePendingCountAt(side, idx))], "")
    os.WriteLine(os.Get_stderr(), msg)

fn msquicNativeAppRecvMarkFinAt(side: int32, idx: int32,
                                finalOffset: int64): Result[bool] =
    if finalOffset < 0:
        return Err[bool]("msquic native: negative app final offset")
    if msquicNativeAppSidePeerClosedAt(side, idx):
        if msquicNativeAppSidePeerFinalAt(side, idx) != finalOffset:
            return Err[bool]("msquic native: conflicting app final offset")
        return Ok[bool](true)
    if finalOffset < msquicNativeAppSideNextOffsetAt(side, idx):
        return Err[bool]("msquic native: app final offset before next offset")
    for i in 0..<msquicNativeAppRecvMaxChunks:
        if msquicNativeAppSidePendingUsedAt(side, idx, i):
            let pdata: rawbytes.Bytes = msquicNativeAppSidePendingDataAt(side, idx, i)
            let poff: int64 = msquicNativeAppSidePendingOffsetAt(side, idx, i)
            if poff + int64(BytesLen(pdata)) > finalOffset:
                return Err[bool]("msquic native: app final offset truncates pending data")
    return Ok[bool](true)

fn msquicNativeAppRecvAddAt(side: int32, idx: int32,
                            offset: int64,
                            data: rawbytes.Bytes): Result[bool] =
    if offset < 0:
        return Err[bool]("msquic native: negative app recv offset")
    if msquicNativeAppSidePeerClosedAt(side, idx) &&
       offset + int64(BytesLen(data)) > msquicNativeAppSidePeerFinalAt(side, idx):
        return Err[bool]("msquic native: app data past final offset")
    if BytesLen(data) <= 0:
        return Ok[bool](true)
    var off: int64 = offset
    # Call-result def on both merge paths.
    var payload: rawbytes.Bytes = BytesSlice(data, 0, BytesLen(data))
    let next0: int64 = msquicNativeAppSideNextOffsetAt(side, idx)
    if off < next0:
        let trim64: int64 = next0 - off
        if trim64 >= int64(BytesLen(payload)):
            return Ok[bool](true)
        let trim: int32 = int32(trim64)
        payload = BytesSlice(payload, trim, BytesLen(payload) - trim)
        off = next0
    if off == msquicNativeAppSideNextOffsetAt(side, idx):
        msquicNativeAppSideReadyAppend(side, idx, payload)
        msquicNativeAppSideSetNextOffset(side, idx, msquicNativeAppSideNextOffsetAt(side, idx) + int64(BytesLen(payload)))
        msquicNativeAppStreamDrainAt(side, idx)
        return Ok[bool](true)
    var freeIdx: int32 = -1
    for i in 0..<msquicNativeAppRecvMaxChunks:
        if msquicNativeAppSidePendingUsedAt(side, idx, i):
            if msquicNativeAppSidePendingOffsetAt(side, idx, i) == off:
                let existing: rawbytes.Bytes = msquicNativeAppSidePendingDataAt(side, idx, i)
                if BytesLen(existing) >= BytesLen(payload):
                    return Ok[bool](true)
                msquicNativeAppSideSetPendingChunk(side, idx, i, true, off, payload)
                msquicNativeAppStreamDrainAt(side, idx)
                return Ok[bool](true)
        elif freeIdx < 0:
            freeIdx = i
    if freeIdx < 0:
        return Err[bool]("msquic native: app recv chunk list full")
    msquicNativeAppSideSetPendingChunk(side, idx, freeIdx, true, off, payload)
    msquicNativeAppSideIncPendingCount(side, idx, 1)
    msquicNativeAppStreamDrainAt(side, idx)
    return Ok[bool](true)

fn msquicNativeAppRecvAdd(side: int32,
                          streamId: int64,
                          offset: int64,
                          data: rawbytes.Bytes): Result[bool] =
    let slotRes: Result[int32] = msquicNativeEnsureAppStreamSlot(side, streamId)
    if IsErr(slotRes):
        return Err[bool](ErrorText(slotRes))
    let slotIdx: int32 = Value(slotRes)
    if side != msquicNativeClientSide && side != msquicNativeServerSide:
        return Err[bool]("msquic native: invalid side")
    let addRes: Result[bool] = msquicNativeAppRecvAddAt(side, slotIdx, offset, data)
    if IsErr(addRes):
        return Err[bool](ErrorText(addRes))
    msquicNativeLogAppRecvAt(side, streamId, offset, data, slotIdx)
    return addRes

fn msquicNativeAppRecvMarkFin(side: int32,
                              streamId: int64,
                              finalOffset: int64): Result[bool] =
    let slotRes: Result[int32] = msquicNativeEnsureAppStreamSlot(side, streamId)
    if IsErr(slotRes):
        return Err[bool](ErrorText(slotRes))
    let slotIdx: int32 = Value(slotRes)
    if side != msquicNativeClientSide && side != msquicNativeServerSide:
        return Err[bool]("msquic native: invalid side")
    let finRes: Result[bool] = msquicNativeAppRecvMarkFinAt(side, slotIdx, finalOffset)
    if IsOk(finRes):
        msquicNativeAppSideSetPeerClosed(side, slotIdx, finalOffset)
    return finRes

fn msquicNativeDrainCryptoStream(side: int32, packetTypeCode: int32): Result[bool] =
    var tlsSide: int32
    if side == msquicNativeServerSide:
        tlsSide = 1
    elif side != msquicNativeClientSide:
        return Err[bool]("msquic native: invalid side")
    while msquicNativeCryptoStreamAvailableByCode(side, packetTypeCode) > 0:
        let chunkLen: int32 = msquicNativeCryptoStreamAvailableByCode(side, packetTypeCode)
        let chunk: rawbytes.Bytes = msquicNativeCryptoStreamConsumeByCode(side, packetTypeCode, chunkLen)
        if BytesLen(chunk) <= 0:
            break
        let feedRes: Result[int32] = handshake13.msquicTls13SideFeed(tlsSide, chunk)
        if IsErr(feedRes):
            return Err[bool](ErrorText(feedRes))
    return Ok[bool](true)

fn msquicNativeHandleCryptoData(side: int32, packetTypeCode: int32, offset: int64, data: rawbytes.Bytes): Result[bool] =
    let addRes: Result[bool] = msquicNativeCryptoStreamAddByCode(side, packetTypeCode, offset, data)
    if IsErr(addRes):
        return Err[bool](ErrorText(addRes))
    return msquicNativeDrainCryptoStream(side, packetTypeCode)

fn msquicNativeResetServerHandshake(requireCert: bool) =
    handshake13.msquicTls13ResetServerDefault(requireCert)

fn msquicNativeFeedServerHandshake(data: rawbytes.Bytes): Result[int32] =
    return handshake13.msquicTls13SideFeed(1, data)

fn msquicNativeServerClientKeyShareGroup(): int32 =
    return handshake13.msquicTls13ServerClientKeyShareGroup()

fn msquicNativeResetSession() =
    gMsQuicSessions[msquicNativeCurSlot].active = false
    gMsQuicSessions[msquicNativeCurSlot].closed = false
    gMsQuicSessions[msquicNativeCurSlot].serverBound = false
    gMsQuicSessions[msquicNativeCurSlot].serverFlightSent = false
    gMsQuicSessions[msquicNativeCurSlot].clientFinishedSent = false
    gMsQuicSessions[msquicNativeCurSlot].clientAddrText = ""
    gMsQuicSessions[msquicNativeCurSlot].listenerAddrText = ""
    gMsQuicSessions[msquicNativeCurSlot].clientDatapathId = 0
    gMsQuicSessions[msquicNativeCurSlot].listenerDatapathId = 0
    msquicNativeSessionClientDatapathId = 0
    # The listener datapath is PROCESS-wide, not per-slot: in a dual-role process
    # (relay) resetting the client session's slot must NOT clear the listener
    # pump id — the pump gates on this global, and zeroing it silently stops
    # draining the listener datapath (observed: the subscriber's next request was
    # never received). Restore it while the listener is live.
    if msquicNativeListenerRunning && msquicNativeListenerDatapathId > 0:
        msquicNativeSessionListenerDatapathId = msquicNativeListenerDatapathId
    else:
        msquicNativeSessionListenerDatapathId = 0
    msquicNativeClientUdpFd = -1
    MsQuicNativeEmptyAddrInto(gMsQuicSessions[msquicNativeCurSlot].dialAddr)
    MsQuicNativeEmptyAddrInto(gMsQuicSessions[msquicNativeCurSlot].listenAddr)
    var clientSettings: msquicruntime.MsQuicSettings
    initMsQuicSettingsInto(clientSettings)
    var serverSettings: msquicruntime.MsQuicSettings
    initMsQuicSettingsInto(serverSettings)
    gMsQuicSessions[msquicNativeCurSlot].clientCidCache = emptyBytes()
    gMsQuicSessions[msquicNativeCurSlot].serverCidCache = emptyBytes()
    msquicNativeResetClientPolicyCache()
    msquicNativeResetServerPolicyCache()
    gMsQuicSessions[msquicNativeCurSlot].clientInitialNext = 1
    gMsQuicSessions[msquicNativeCurSlot].serverInitialNext = 1
    gMsQuicSessions[msquicNativeCurSlot].clientHandshakeNext = 1
    gMsQuicSessions[msquicNativeCurSlot].serverHandshakeNext = 1
    gMsQuicSessions[msquicNativeCurSlot].clientAppNext = 1
    gMsQuicSessions[msquicNativeCurSlot].serverAppNext = 1
    gMsQuicSessions[msquicNativeCurSlot].serverLargestInitialRecv = 0
    gMsQuicSessions[msquicNativeCurSlot].clientLargestHandshakeRecv = 0
    gMsQuicSessions[msquicNativeCurSlot].clientLargestAppRecv = 0
    gMsQuicSessions[msquicNativeCurSlot].serverLargestAppRecv = 0
    msquicNativeSackResetBoth()
    gMsQuicSessions[msquicNativeCurSlot].clientInitialPendingActive = false
    gMsQuicSessions[msquicNativeCurSlot].clientInitialPendingWire = emptyBytes()
    gMsQuicSessions[msquicNativeCurSlot].clientInitialPendingSentAtMs = 0
    gMsQuicSessions[msquicNativeCurSlot].clientHandshakePendingActive = false
    gMsQuicSessions[msquicNativeCurSlot].clientHandshakePendingWire = emptyBytes()
    gMsQuicSessions[msquicNativeCurSlot].clientHandshakePendingSentAtMs = 0
    gMsQuicSessions[msquicNativeCurSlot].clientFinishedReadyPending = false
    gMsQuicSessions[msquicNativeCurSlot].serverHandshakePendingActive = false
    gMsQuicSessions[msquicNativeCurSlot].serverHandshakePendingWire = emptyBytes()
    gMsQuicSessions[msquicNativeCurSlot].serverHandshakePendingSentAtMs = 0
    gMsQuicSessions[msquicNativeCurSlot].serverHandshakeFirstSentAtMs = 0
    gMsQuicSessions[msquicNativeCurSlot].serverInitialPayloadCache = emptyBytes()
    gMsQuicSessions[msquicNativeCurSlot].serverHandshakeDoneSent = false
    gMsQuicSessions[msquicNativeCurSlot].serverHandshakeDoneOutstanding = false
    gMsQuicSessions[msquicNativeCurSlot].debugHandshakePendingLogged = false
    msquicNativeResetClientEndpoint(clientSettings, true)
    msquicNativeResetServerEndpoint(serverSettings, false)

fn msquicNativeResetServerHandshakeAttempt() =
    gMsQuicSessions[msquicNativeCurSlot].active = false
    gMsQuicSessions[msquicNativeCurSlot].closed = false
    gMsQuicSessions[msquicNativeCurSlot].serverBound = false
    gMsQuicSessions[msquicNativeCurSlot].serverFlightSent = false
    gMsQuicSessions[msquicNativeCurSlot].clientFinishedSent = false
    gMsQuicSessions[msquicNativeCurSlot].clientAddrText = ""
    gMsQuicSessions[msquicNativeCurSlot].listenerAddrText = ""
    gMsQuicSessions[msquicNativeCurSlot].clientDatapathId = 0
    gMsQuicSessions[msquicNativeCurSlot].listenerDatapathId = msquicNativeListenerDatapathId
    msquicNativeSessionClientDatapathId = 0
    msquicNativeSessionListenerDatapathId = msquicNativeListenerDatapathId
    msquicNativeClientUdpFd = -1
    gMsQuicSessions[msquicNativeCurSlot].clientCidCache = emptyBytes()
    gMsQuicSessions[msquicNativeCurSlot].serverCidCache = emptyBytes()
    gMsQuicSessions[msquicNativeCurSlot].clientInitialNext = 1
    gMsQuicSessions[msquicNativeCurSlot].serverInitialNext = 1
    gMsQuicSessions[msquicNativeCurSlot].clientHandshakeNext = 1
    gMsQuicSessions[msquicNativeCurSlot].serverHandshakeNext = 1
    gMsQuicSessions[msquicNativeCurSlot].clientAppNext = 1
    gMsQuicSessions[msquicNativeCurSlot].serverAppNext = 1
    gMsQuicSessions[msquicNativeCurSlot].serverLargestInitialRecv = 0
    gMsQuicSessions[msquicNativeCurSlot].clientLargestHandshakeRecv = 0
    gMsQuicSessions[msquicNativeCurSlot].clientLargestAppRecv = 0
    gMsQuicSessions[msquicNativeCurSlot].serverLargestAppRecv = 0
    msquicNativeSackResetBoth()
    gMsQuicSessions[msquicNativeCurSlot].clientFinishedReadyPending = false
    gMsQuicSessions[msquicNativeCurSlot].serverHandshakePendingActive = false
    gMsQuicSessions[msquicNativeCurSlot].serverHandshakePendingWire = emptyBytes()
    gMsQuicSessions[msquicNativeCurSlot].serverHandshakePendingSentAtMs = 0
    gMsQuicSessions[msquicNativeCurSlot].serverHandshakeFirstSentAtMs = 0
    gMsQuicSessions[msquicNativeCurSlot].serverInitialPayloadCache = emptyBytes()
    gMsQuicSessions[msquicNativeCurSlot].serverHandshakeDoneSent = false
    gMsQuicSessions[msquicNativeCurSlot].serverHandshakeDoneOutstanding = false
    gMsQuicSessions[msquicNativeCurSlot].debugHandshakePendingLogged = false
    msquicNativeResetServerEndpointState()

@borrows
fn msquicNativeStartsWith(text: str, prefix: str): bool =
    let tlen: int32 = len(text)
    let plen: int32 = len(prefix)
    if plen <= 0:
        return true
    if tlen < plen:
        return false
    if tlen > 0 && strDataPtr(text) == nil:
        return false
    if plen > 0 && strDataPtr(prefix) == nil:
        return false
    for i in 0..<plen:
        if text[i] != prefix[i]:
            return false
    return true

@borrows
fn msquicNativeFindUdpMarker(addr: str): int32 =
    let marker: str = "/udp/"
    let mlen: int32 = len(marker)
    let alen: int32 = len(addr)
    if alen < mlen:
        return -1
    if alen > 0 && strDataPtr(addr) == nil:
        return -1
    if mlen > 0 && strDataPtr(marker) == nil:
        return -1
    for i in 0..alen-mlen:
        var matched: bool = true
        for j in 0..<mlen:
            if addr[i + j] != marker[j]:
                matched = false
                break
        if matched:
            return i
    return -1

@borrows
fn msquicNativePeerHostKey(addr: str): str =
    if len(addr) > 0 && strDataPtr(addr) == nil:
        return ""
    let pos: int32 = msquicNativeFindUdpMarker(addr)
    if pos > 0:
        return strings.CloneStrRange(addr, 0, pos)
    return strings.CloneStr(addr)

@borrows
fn msquicNativePeerHostChanged(oldAddr: str, newAddr: str): bool =
    if len(oldAddr) > 0 && strDataPtr(oldAddr) == nil:
        return len(newAddr) > 0
    if len(newAddr) > 0 && strDataPtr(newAddr) == nil:
        return len(oldAddr) > 0
    if len(oldAddr) <= 0:
        return len(newAddr) > 0
    return msquicNativePeerHostKey(oldAddr) != msquicNativePeerHostKey(newAddr)

@borrows
fn msquicNativePeerPortChanged(oldAddr: str, newAddr: str): bool =
    if len(oldAddr) <= 0 || len(newAddr) <= 0:
        return false
    if len(oldAddr) > 0 && strDataPtr(oldAddr) == nil:
        return false
    if len(newAddr) > 0 && strDataPtr(newAddr) == nil:
        return false
    if msquicNativePeerHostChanged(oldAddr, newAddr):
        return false
    return oldAddr != newAddr

@borrows
fn msquicNativeInitialClientCidChanged(header: packet_header_model.QuicPacketHeader): bool =
    if BytesLen(gMsQuicSessions[msquicNativeCurSlot].clientCidCache) <= 0:
        return false
    if BytesLen(header.scid) <= 0:
        return false
    return !BytesEqual(gMsQuicSessions[msquicNativeCurSlot].clientCidCache, header.scid)

@borrows
fn msquicNativeCopyAddrInto(out: var multiaddress.MultiAddress, src: multiaddress.MultiAddress) =
    MsQuicNativeCopyAddrInto(out, src)

fn msquicNativeAddrFromDatapathTextInto(out: var multiaddress.MultiAddress, text: str, fallback: multiaddress.MultiAddress) =
    if len(text) <= 0:
        msquicNativeCopyAddrInto(out, fallback)
        return
    if msquicNativeStartsWith(text, "/"):
        MsQuicNativeAssignAddrTextInto(out, text)
        return
    if msquicNativeStartsWith(text, "udp://"):
        let n: int32 = len(text)
        var colon: int32 = n - 1
        while colon > 6 && text[colon] != ':':
            colon = colon - 1
        if colon > 6 && colon + 1 < n:
            let host: str = strings.CloneStrRange(text, 6, colon - 6)
            let portText: str = strings.CloneStrRange(text, colon + 1, n - colon - 1)
            var multiaddrText: str = "/ip4/"
            multiaddrText = strutil.Join([ share(multiaddrText), share(host)], "")
            multiaddrText = strutil.Join([ share(multiaddrText), "/udp/"], "")
            multiaddrText = strutil.Join([ share(multiaddrText), share(portText)], "")
            multiaddrText = strutil.Join([ share(multiaddrText), "/quic-v1"], "")
            MsQuicNativeAssignAddrTextInto(out, multiaddrText)
            return
    msquicNativeCopyAddrInto(out, fallback)

fn msquicNativeAddrFromDatapathText(text: str, fallback: multiaddress.MultiAddress): multiaddress.MultiAddress =
    var out: multiaddress.MultiAddress
    msquicNativeAddrFromDatapathTextInto(out, text, fallback)
    return out

fn msquicNativeTaggedAddr(addr: multiaddress.MultiAddress): bool =
    if BytesLen(addr.data) < 4:
        return false
    let head: int32 = BytesGet(addr.data, 0)
    let delta: int32 = head - 81
    if delta != 0:
        return false
    return true

fn msquicNativeMultiAddressBindTextFromText(text: str): str =
    if len(text) <= 0:
        return "/ip4/127.0.0.1/udp/0/quic-v1"
    if text[0] == '/':
        return text
    if msquicNativeStartsWith(text, "udp://"):
        return text
    return text

fn msquicNativeMultiAddressBindText(addr: multiaddress.MultiAddress): str =
    if len(addr.raw) > 0:
        return msquicNativeMultiAddressBindTextFromText(addr.raw)
    if BytesLen(addr.data) > 0:
        return msquicNativeMultiAddressBindTextFromText(BytesToString(addr.data))
    return msquicNativeMultiAddressBindTextFromText("")

var
    msquicNativeDebugTls13: bool
    msquicNativeReady: bool
    msquicNativeListenerRunning: bool
    msquicNativeAcceptPending: bool
    msquicNativeDropNextAppSend: bool
    msquicNativeLastPumpDroppedMalformed: bool
    msquicNativeLastPumpReceived: bool
    msquicNativeLocalRole: int32 = msquicNativeRoleNone
    msquicNativeListenerDatapathId: int32
    msquicNativeSessionClientDatapathId: int32
    msquicNativeSessionListenerDatapathId: int32
    msquicNativeListenerUdpFd: int32 = -1
    msquicNativeClientUdpFd: int32 = -1
    msquicNativeCidEpoch: int32 = 1
    msquicNativeDatapathRt: MsQuicDatapathRuntime
    msquicNativeListenerSettings: msquicruntime.MsQuicSettings
    msquicNativeListenerTlsPolicy: policy.MsQuicTlsPolicy
    msquicNativeListenAddr: multiaddress.MultiAddress
    msquicNativeClientDatagramCount: int32
    msquicNativeServerDatagramCount: int32
    msquicNativeResultErrorScratch: str
    msquicNativeProcessOutcomeScratch: int32
    gMsQuicSessions: MsQuicNativeSession[N_SLOTS]
    msquicNativeCurSlot: int32 = 0
    # v2 扫描停靠信号（darwin_quic_fix 第二版 gate, 按读方分形态; 语义与线程
    # 模型见 msquicNativePumpCodeUnlocked listener 分支注释与
    # docs/campaigns/2026-09-16-csg-semantic-video-standard/results/
    # darwin_quic_fix_v2_scanpark.md）: per-side 单槽 int32,
    # >=0=数据面扫描环停靠在该 bind 槽, -2=扫描活动中（等待窗）, -1=无扫描。
    msquicNativeScanParkListener: int32 = -1
    msquicNativeScanParkClient: int32 = -1
    # dual-role 角色分槽: accept 尾写 Server、dial 尾写 Client（单一
    # lastSessionSlot 全局被两线程互写会把 pipe 标到对方角色槽，自连实测
    # serve_manifest_write 即时败），Retag 系列持锁重放 cur=本角色槽再取 pipe。
    msquicNativeLastServerSessionSlot: int32 = -1
    msquicNativeLastClientSessionSlot: int32 = -1
    msquicNativeClientImpl: connection_impl.MsQuicConnImpl[N_SLOTS]
    msquicNativeServerImpl: connection_impl.MsQuicConnImpl[N_SLOTS]
    msquicNativeClientInitialCrypto: crypto_stream.MsQuicCryptoStream[N_SLOTS]
    msquicNativeServerInitialCrypto: crypto_stream.MsQuicCryptoStream[N_SLOTS]
    msquicNativeClientHandshakeCrypto: crypto_stream.MsQuicCryptoStream[N_SLOTS]
    msquicNativeServerHandshakeCrypto: crypto_stream.MsQuicCryptoStream[N_SLOTS]
    msquicNativeClientAppStreams: MsQuicNativeAppStreamSlot[msquicNativeAppStreamSlotCount]
    msquicNativeServerAppStreams: MsQuicNativeAppStreamSlot[msquicNativeAppStreamSlotCount]
    # SACK recv state per side. frontier = largest pn with all of [1,frontier]
    # received contiguously; flag slots record received pns in (frontier, frontier+window].
    msquicNativeClientSackBits: int32[msquicNativeSackWindowBitsAll]
    msquicNativeServerSackBits: int32[msquicNativeSackWindowBitsAll]

fn msquicNativeSackBitGet(side: int32, idx: int32): bool =
    let slotIdx: int32 = msquicNativeCurSlot * msquicNativeSackWindowBits + idx
    if side == msquicNativeClientSide:
        return msquicNativeClientSackBits[slotIdx] != 0
    return msquicNativeServerSackBits[slotIdx] != 0

fn msquicNativeSackHighAt(side: int32): int32 =
    if side == msquicNativeClientSide:
        return gMsQuicSessions[msquicNativeCurSlot].clientSackHigh
    return gMsQuicSessions[msquicNativeCurSlot].serverSackHigh

fn msquicNativeSackSetHigh(side: int32, value: int32) =
    if side == msquicNativeClientSide:
        gMsQuicSessions[msquicNativeCurSlot].clientSackHigh = value
    else:
        gMsQuicSessions[msquicNativeCurSlot].serverSackHigh = value

fn msquicNativeSackBitSet(side: int32, idx: int32) =
    let slotIdx: int32 = msquicNativeCurSlot * msquicNativeSackWindowBits + idx
    if side == msquicNativeClientSide:
        msquicNativeClientSackBits[slotIdx] = 1
    else:
        msquicNativeServerSackBits[slotIdx] = 1
    if idx + 1 > msquicNativeSackHighAt(side):
        msquicNativeSackSetHigh(side, idx + 1)

fn msquicNativeSackBitClear(side: int32, idx: int32) =
    let slotIdx: int32 = msquicNativeCurSlot * msquicNativeSackWindowBits + idx
    if side == msquicNativeClientSide:
        msquicNativeClientSackBits[slotIdx] = 0
    else:
        msquicNativeServerSackBits[slotIdx] = 0

fn msquicNativeSackFrontierAt(side: int32): int64 =
    if side == msquicNativeClientSide:
        return gMsQuicSessions[msquicNativeCurSlot].clientSackFrontier
    return gMsQuicSessions[msquicNativeCurSlot].serverSackFrontier

fn msquicNativeSackSetFrontier(side: int32, value: int64) =
    if side == msquicNativeClientSide:
        gMsQuicSessions[msquicNativeCurSlot].clientSackFrontier = value
    else:
        gMsQuicSessions[msquicNativeCurSlot].serverSackFrontier = value

fn msquicNativeSackReset(side: int32) =
    msquicNativeSackSetFrontier(side, 0)
    var i: int32
    for i in 0..<msquicNativeSackWindowBits:
        if side == msquicNativeClientSide:
            msquicNativeClientSackBits[i] = 0
        else:
            msquicNativeServerSackBits[i] = 0
    msquicNativeSackSetHigh(side, 0)

fn msquicNativeSackResetBoth() =
    msquicNativeSackReset(msquicNativeClientSide)
    msquicNativeSackReset(msquicNativeServerSide)

# Record an app short-packet number. Advances the contiguous frontier and
# folds bitmap bits as gaps fill. Returns true if newly recorded.
fn msquicNativeSackRecord(side: int32, pn: int64): bool =
    if pn <= 0:
        return false
    var frontier: int64 = msquicNativeSackFrontierAt(side)
    if pn <= frontier:
        return false
    if pn == frontier + 1:
        # pn delivered fills the frontier gap. bitmap index i maps to pn=F+1+i,
        # so pn just delivered is index 0 (always treated as filled). Advance
        # frontier across contiguous set bits starting at old index 1.
        var oldIdx: int32 = 1
        var advanced: int64 = 1
        while oldIdx < msquicNativeSackWindowBits && msquicNativeSackBitGet(side, oldIdx):
            advanced = advanced + 1
            oldIdx = oldIdx + 1
        frontier = frontier + advanced
        # Shift bitmap down by `advanced` (bits below new frontier are consumed).
        msquicNativeSackShiftDown(side, int32(advanced))
        msquicNativeSackSetFrontier(side, frontier)
        return true
    # pn > frontier+1: out-of-order above a gap. Record in bitmap.
    let rel: int64 = pn - frontier - 1
    if rel >= int64(msquicNativeSackWindowBits):
        # Beyond window: cannot record without losing gap info. Conservatively
        # advance frontier to pn-1 region is unsafe; instead drop (will be
        # re-acked when frontier catches up / on retransmit). Idempotent.
        return false
    let idx: int32 = int32(rel)
    if msquicNativeSackBitGet(side, idx):
        return false
    msquicNativeSackBitSet(side, idx)
    return true

# Shift the whole bitmap down by `count` bit positions (used after the frontier
# advances past contiguous filled bits).
fn msquicNativeSackShiftDown(side: int32, count: int32) =
    if count <= 0:
        return
    # Only indices below the high-water mark can hold (or receive) a set bit; everything
    # above is already zero. In-order delivery keeps high-water 0, so this is a no-op.
    let high: int32 = msquicNativeSackHighAt(side)
    var i: int32
    for i in 0..<high:
        let src: int32 = i + count
        if src < msquicNativeSackWindowBits && msquicNativeSackBitGet(side, src):
            msquicNativeSackBitSet(side, i)
        else:
            msquicNativeSackBitClear(side, i)
    var newHigh: int32 = high - count
    if newHigh < 0:
        newHigh = 0
    msquicNativeSackSetHigh(side, newHigh)

# Build the SACK ACK-frame payload from the recv state: varint range_count,
# then (first,last) varint pairs (descending). Always includes cumulative
# [0,frontier]; adds gap ranges above the frontier from the bitmap.
fn msquicNativeSackBuildPayload(side: int32): rawbytes.Bytes =
    let frontier: int64 = msquicNativeSackFrontierAt(side)
    # Collect ranges into parallel arrays (highest first).
    var rangeFirst: int64[msquicNativeSackMaxRanges]
    var rangeLast: int64[msquicNativeSackMaxRanges]
    var count: int32
    count = 0
    # Scan bitmap for contiguous set runs (these are higher than frontier). Bounded by the
    # high-water mark: in-order delivery leaves it 0, so the scan is skipped entirely and the
    # ACK carries just the cumulative [0, frontier] range — O(1) per ACK instead of O(window).
    var i: int32 = msquicNativeSackHighAt(side) - 1
    while i >= 0 && count < msquicNativeSackMaxRanges - 1:
        if msquicNativeSackBitGet(side, i):
            # End of a run at i; find its start.
            var runEnd: int32 = i
            var runStart: int32 = i
            while runStart > 0 && msquicNativeSackBitGet(side, runStart - 1):
                runStart = runStart - 1
            let pnLast: int64 = frontier + 1 + int64(runEnd)
            let pnFirst: int64 = frontier + 1 + int64(runStart)
            rangeFirst[count] = pnFirst
            rangeLast[count] = pnLast
            count = count + 1
            i = runStart - 1
        else:
            i = i - 1
    # Cumulative range [0, frontier] last (lowest).
    rangeFirst[count] = int64(0)
    rangeLast[count] = frontier
    count = count + 1
    # Encode.
    var total: int32 = quic_varint.quicVarIntEncodedLen(int64(count))
    var r: int32
    for r in 0..<count:
        total = total + quic_varint.quicVarIntEncodedLen(rangeFirst[r]) + quic_varint.quicVarIntEncodedLen(rangeLast[r])
    let out: rawbytes.Bytes = BytesAlloc(total)
    var cursor: int32
    cursor = 0
    cursor = msquicNativeSackPutVarint(out, cursor, int64(count))
    for r in 0..<count:
        cursor = msquicNativeSackPutVarint(out, cursor, rangeFirst[r])
        cursor = msquicNativeSackPutVarint(out, cursor, rangeLast[r])
    return out

# Writes directly into the presized `out` scratch buffer via quicVarIntWriteInto
# (no intermediate Bytes alloc). The old form called quicVarIntEncode, which
# BytesAlloc'd a small buffer per varint and never freed it after copying its
# bytes out — a leak on every ACK-eliciting packet (msquicNativeQueueSackFor
# calls this 3+ times per ACK for the common in-order case).
# Writes through out's data pointer (via quicVarIntWriteInto @borrows).
@borrows
fn msquicNativeSackPutVarint(out: rawbytes.Bytes, cursor: int32, value: int64): int32 =
    let writeRes: Result[int32] = quic_varint.quicVarIntWriteInto(out, cursor, value)
    if IsErr(writeRes):
        return cursor
    return Value(writeRes)

fn msquicNativeSetDebugTls13(enabled: bool) =
    msquicNativeDebugTls13 = enabled
    handshake13.msquicTls13SetDebug(enabled)

fn msquicNativeResetResultScratch() =
    msquicNativeResultErrorScratch = ""
    msquicNativeProcessOutcomeScratch = msquicNativeProcessOutcomeNone

fn msquicNativeResetClientPolicyCache() =
    gMsQuicSessions[msquicNativeCurSlot].clientServerNameCache = ""
    gMsQuicSessions[msquicNativeCurSlot].clientAlpnOfferCache = ""
    gMsQuicSessions[msquicNativeCurSlot].clientTrustRootsCountCache = 0
    gMsQuicSessions[msquicNativeCurSlot].clientTrustRoot0Cache = emptyBytes()
    gMsQuicSessions[msquicNativeCurSlot].clientTrustRoot1Cache = emptyBytes()
    gMsQuicSessions[msquicNativeCurSlot].clientTrustRoot2Cache = emptyBytes()
    gMsQuicSessions[msquicNativeCurSlot].clientTrustRoot3Cache = emptyBytes()
    gMsQuicSessions[msquicNativeCurSlot].clientCertChainCountCache = 0
    gMsQuicSessions[msquicNativeCurSlot].clientCert0Cache = emptyBytes()
    gMsQuicSessions[msquicNativeCurSlot].clientCert1Cache = emptyBytes()
    gMsQuicSessions[msquicNativeCurSlot].clientCert2Cache = emptyBytes()
    gMsQuicSessions[msquicNativeCurSlot].clientCert3Cache = emptyBytes()
    gMsQuicSessions[msquicNativeCurSlot].clientPrivateKeyCache = emptyBytes()
    gMsQuicSessions[msquicNativeCurSlot].clientSendCertificateCache = false

@borrows
fn msquicNativeCopyTlsPolicy(policy: policy.MsQuicTlsPolicy): policy.MsQuicTlsPolicy =
    # Deep copy: a bare struct return aliases every str/Bytes field, and the
    # caller's param release then frees the buffers the copy still points at
    # (observed: the listener policy global dangled, the server flight parsed
    # garbage DER and failed x509 leaf parse with NUL-corrupted error text).
    var out: policy.MsQuicTlsPolicy
    out.serverName = strings.CloneStr(policy.serverName)
    out.allowInsecure = policy.allowInsecure
    out.requireClientCertificate = policy.requireClientCertificate
    out.sendClientCertificate = policy.sendClientCertificate
    out.revocationMode = policy.revocationMode
    out.crlCount = policy.crlCount
    out.crl0 = msquicNativeCopyBytes(policy.crl0)
    out.crl1 = msquicNativeCopyBytes(policy.crl1)
    out.crl2 = msquicNativeCopyBytes(policy.crl2)
    out.crl3 = msquicNativeCopyBytes(policy.crl3)
    out.certChainCount = policy.certChainCount
    out.certChain0 = msquicNativeCopyBytes(policy.certChain0)
    out.certChain1 = msquicNativeCopyBytes(policy.certChain1)
    out.certChain2 = msquicNativeCopyBytes(policy.certChain2)
    out.certChain3 = msquicNativeCopyBytes(policy.certChain3)
    out.certPrivateKey = msquicNativeCopyBytes(policy.certPrivateKey)
    out.certLeafKeyKind = policy.certLeafKeyKind
    out.trustRootsCount = policy.trustRootsCount
    out.trustRoot0 = msquicNativeCopyBytes(policy.trustRoot0)
    out.trustRoot1 = msquicNativeCopyBytes(policy.trustRoot1)
    out.trustRoot2 = msquicNativeCopyBytes(policy.trustRoot2)
    out.trustRoot3 = msquicNativeCopyBytes(policy.trustRoot3)
    out.alpnCount = policy.alpnCount
    out.alpn0 = strings.CloneStr(policy.alpn0)
    out.alpn1 = strings.CloneStr(policy.alpn1)
    return out

@borrows
fn msquicNativeSetClientPolicyCache(policy: policy.MsQuicTlsPolicy) =
    gMsQuicSessions[msquicNativeCurSlot].clientServerNameCache = policy.serverName
    gMsQuicSessions[msquicNativeCurSlot].clientAlpnOfferCache = msquicTlsPolicyAlpnListText(policy)
    gMsQuicSessions[msquicNativeCurSlot].clientTrustRootsCountCache = policy.trustRootsCount
    gMsQuicSessions[msquicNativeCurSlot].clientTrustRoot0Cache = msquicNativeCopyBytes(policy.trustRoot0)
    gMsQuicSessions[msquicNativeCurSlot].clientTrustRoot1Cache = msquicNativeCopyBytes(policy.trustRoot1)
    gMsQuicSessions[msquicNativeCurSlot].clientTrustRoot2Cache = msquicNativeCopyBytes(policy.trustRoot2)
    gMsQuicSessions[msquicNativeCurSlot].clientTrustRoot3Cache = msquicNativeCopyBytes(policy.trustRoot3)
    gMsQuicSessions[msquicNativeCurSlot].clientCertChainCountCache = policy.certChainCount
    gMsQuicSessions[msquicNativeCurSlot].clientCert0Cache = msquicNativeCopyBytes(policy.certChain0)
    gMsQuicSessions[msquicNativeCurSlot].clientCert1Cache = msquicNativeCopyBytes(policy.certChain1)
    gMsQuicSessions[msquicNativeCurSlot].clientCert2Cache = msquicNativeCopyBytes(policy.certChain2)
    gMsQuicSessions[msquicNativeCurSlot].clientCert3Cache = msquicNativeCopyBytes(policy.certChain3)
    gMsQuicSessions[msquicNativeCurSlot].clientPrivateKeyCache = msquicNativeCopyBytes(policy.certPrivateKey)
    gMsQuicSessions[msquicNativeCurSlot].clientSendCertificateCache = policy.sendClientCertificate
    gMsQuicSessions[msquicNativeCurSlot].clientLeafKeyKindCache = msquicNativeX509KeyKindCodeFromCertificate(gMsQuicSessions[msquicNativeCurSlot].clientCert0Cache,
                                                                                    policy.certLeafKeyKind)
    if gMsQuicSessions[msquicNativeCurSlot].clientLeafKeyKindCache == 0:
        gMsQuicSessions[msquicNativeCurSlot].clientLeafKeyKindCache = msquicNativeX509KeyKindCodeFromPrivateKey(gMsQuicSessions[msquicNativeCurSlot].clientPrivateKeyCache,
                                                                                       policy.certLeafKeyKind)

@borrows
fn msquicNativeClientTrustRootAtCache(idx: int32): rawbytes.Bytes =
    if idx == 0:
        return msquicCloneBytes(gMsQuicSessions[msquicNativeCurSlot].clientTrustRoot0Cache)
    if idx == 1:
        return msquicCloneBytes(gMsQuicSessions[msquicNativeCurSlot].clientTrustRoot1Cache)
    if idx == 2:
        return msquicCloneBytes(gMsQuicSessions[msquicNativeCurSlot].clientTrustRoot2Cache)
    if idx == 3:
        return msquicCloneBytes(gMsQuicSessions[msquicNativeCurSlot].clientTrustRoot3Cache)
    return emptyBytes()

fn msquicNativeClientCertAtCache(idx: int32): rawbytes.Bytes =
    if idx == 0:
        return msquicCloneBytes(gMsQuicSessions[msquicNativeCurSlot].clientCert0Cache)
    if idx == 1:
        return msquicCloneBytes(gMsQuicSessions[msquicNativeCurSlot].clientCert1Cache)
    if idx == 2:
        return msquicCloneBytes(gMsQuicSessions[msquicNativeCurSlot].clientCert2Cache)
    if idx == 3:
        return msquicCloneBytes(gMsQuicSessions[msquicNativeCurSlot].clientCert3Cache)
    return emptyBytes()

fn msquicNativeResetServerPolicyCache() =
    gMsQuicSessions[msquicNativeCurSlot].serverAlpnSupportedCache = ""
    gMsQuicSessions[msquicNativeCurSlot].serverCertChainCountCache = 0
    gMsQuicSessions[msquicNativeCurSlot].serverLeafDerCache = emptyBytes()
    gMsQuicSessions[msquicNativeCurSlot].serverCert1Cache = emptyBytes()
    gMsQuicSessions[msquicNativeCurSlot].serverCert2Cache = emptyBytes()
    gMsQuicSessions[msquicNativeCurSlot].serverCert3Cache = emptyBytes()
    gMsQuicSessions[msquicNativeCurSlot].serverPrivateKeyCache = emptyBytes()
    gMsQuicSessions[msquicNativeCurSlot].serverRequireClientCertificateCache = false
    gMsQuicSessions[msquicNativeCurSlot].serverTrustRootsCountCache = 0
    gMsQuicSessions[msquicNativeCurSlot].serverTrustRoot0Cache = emptyBytes()
    gMsQuicSessions[msquicNativeCurSlot].serverTrustRoot1Cache = emptyBytes()
    gMsQuicSessions[msquicNativeCurSlot].serverTrustRoot2Cache = emptyBytes()
    gMsQuicSessions[msquicNativeCurSlot].serverTrustRoot3Cache = emptyBytes()

fn msquicNativeSetServerPolicyCache(policy: var policy.MsQuicTlsPolicy) =
    gMsQuicSessions[msquicNativeCurSlot].serverAlpnSupportedCache = msquicTlsPolicyAlpnListText(policy)
    gMsQuicSessions[msquicNativeCurSlot].serverCertChainCountCache = policy.certChainCount
    gMsQuicSessions[msquicNativeCurSlot].serverPrivateKeyCache = msquicNativeCopyBytes(policy.certPrivateKey)
    gMsQuicSessions[msquicNativeCurSlot].serverRequireClientCertificateCache = policy.requireClientCertificate
    gMsQuicSessions[msquicNativeCurSlot].serverTrustRootsCountCache = policy.trustRootsCount
    gMsQuicSessions[msquicNativeCurSlot].serverTrustRoot0Cache = msquicNativeCopyBytes(policy.trustRoot0)
    gMsQuicSessions[msquicNativeCurSlot].serverTrustRoot1Cache = msquicNativeCopyBytes(policy.trustRoot1)
    gMsQuicSessions[msquicNativeCurSlot].serverTrustRoot2Cache = msquicNativeCopyBytes(policy.trustRoot2)
    gMsQuicSessions[msquicNativeCurSlot].serverTrustRoot3Cache = msquicNativeCopyBytes(policy.trustRoot3)
    if policy.certChainCount > 0:
        gMsQuicSessions[msquicNativeCurSlot].serverLeafDerCache = msquicNativeCopyBytes(policy.certChain0)
    else:
        gMsQuicSessions[msquicNativeCurSlot].serverLeafDerCache = emptyBytes()
    gMsQuicSessions[msquicNativeCurSlot].serverCert1Cache = msquicNativeCopyBytes(policy.certChain1)
    gMsQuicSessions[msquicNativeCurSlot].serverCert2Cache = msquicNativeCopyBytes(policy.certChain2)
    gMsQuicSessions[msquicNativeCurSlot].serverCert3Cache = msquicNativeCopyBytes(policy.certChain3)
    gMsQuicSessions[msquicNativeCurSlot].serverLeafKeyKindCache = msquicNativeX509KeyKindCodeFromCertificate(gMsQuicSessions[msquicNativeCurSlot].serverLeafDerCache,
                                                                                    policy.certLeafKeyKind)
    if gMsQuicSessions[msquicNativeCurSlot].serverLeafKeyKindCache == 0:
        gMsQuicSessions[msquicNativeCurSlot].serverLeafKeyKindCache = msquicNativeX509KeyKindCodeFromPrivateKey(gMsQuicSessions[msquicNativeCurSlot].serverPrivateKeyCache,
                                                                                       policy.certLeafKeyKind)

fn msquicNativeServerCertAtCache(idx: int32): rawbytes.Bytes =
    if idx == 0:
        return msquicCloneBytes(gMsQuicSessions[msquicNativeCurSlot].serverLeafDerCache)
    if idx == 1:
        return msquicCloneBytes(gMsQuicSessions[msquicNativeCurSlot].serverCert1Cache)
    if idx == 2:
        return msquicCloneBytes(gMsQuicSessions[msquicNativeCurSlot].serverCert2Cache)
    if idx == 3:
        return msquicCloneBytes(gMsQuicSessions[msquicNativeCurSlot].serverCert3Cache)
    return emptyBytes()

fn msquicNativeServerTrustRootAtCache(idx: int32): rawbytes.Bytes =
    if idx == 0:
        return msquicCloneBytes(gMsQuicSessions[msquicNativeCurSlot].serverTrustRoot0Cache)
    if idx == 1:
        return msquicCloneBytes(gMsQuicSessions[msquicNativeCurSlot].serverTrustRoot1Cache)
    if idx == 2:
        return msquicCloneBytes(gMsQuicSessions[msquicNativeCurSlot].serverTrustRoot2Cache)
    if idx == 3:
        return msquicCloneBytes(gMsQuicSessions[msquicNativeCurSlot].serverTrustRoot3Cache)
    return emptyBytes()

fn msquicNativeServerRequiresClientCertificate(): bool =
    return gMsQuicSessions[msquicNativeCurSlot].serverRequireClientCertificateCache
fn msquicNativeSeededBytes(tag: int32): rawbytes.Bytes =
    let out: rawbytes.Bytes = BytesAlloc(32)
    for i in 0..<32:
        let v: int32 = (tag * 41 + i * 17 + 29) & 255
        BytesSet(out, i, v)
    return out

fn msquicNativeConnId(tag: int32): rawbytes.Bytes =
    let out: rawbytes.Bytes = BytesAlloc(msquicNativeConnIdLen)
    for i in 0..<msquicNativeConnIdLen:
        let shift: int32 = (msquicNativeConnIdLen - 1 - i) * 8
        BytesSet(out, i, int32((int64(tag) >> shift) & 0xff))
    return out

fn msquicNativeCidForSlotClient(slot: int32): rawbytes.Bytes =
    return msquicNativeConnId(286331153 + slot)

fn msquicNativeCidForSlotServer(slot: int32): rawbytes.Bytes =
    return msquicNativeConnId(572662306 + slot)

fn msquicNativeNextCidTag(slot: int32): int32 =
    if msquicNativeCidEpoch <= 0:
        msquicNativeCidEpoch = 1
    let tag: int32 = msquicNativeCidEpoch * 16 + slot
    msquicNativeCidEpoch = msquicNativeCidEpoch + 1
    return tag

fn msquicNativeAssignFreshSessionCids() =
    let tag: int32 = msquicNativeNextCidTag(msquicNativeCurSlot)
    gMsQuicSessions[msquicNativeCurSlot].clientCidCache = msquicNativeConnId(286331153 + tag)
    gMsQuicSessions[msquicNativeCurSlot].serverCidCache = msquicNativeConnId(572662306 + tag)

fn msquicNativeSlotFindFree(): int32 =
    for i in 0..<N_SLOTS:
        if ! gMsQuicSessions[i].active:
            return i
    return -1

fn msquicNativeSlotByClientDatapath(dpId: int32): int32 =
    if dpId <= 0:
        return -1
    for i in 0..<N_SLOTS:
        if gMsQuicSessions[i].clientDatapathId == dpId:
            return i
    return -1

fn msquicNativeSlotByListenerDatapath(dpId: int32): int32 =
    if dpId <= 0:
        return -1
    for i in 0..<N_SLOTS:
        if gMsQuicSessions[i].listenerDatapathId == dpId && gMsQuicSessions[i].serverBound:
            return i
    return -1

@borrows
fn msquicNativeSlotFindByClientCid(cid: rawbytes.Bytes): int32 =
    for i in 0..<N_SLOTS:
        if gMsQuicSessions[i].active && ! gMsQuicSessions[i].closed:
            if BytesLen(gMsQuicSessions[i].clientCidCache) > 0:
                if BytesEqual(gMsQuicSessions[i].clientCidCache, cid):
                    return i
    return -1

@borrows
fn msquicNativeSlotFindByServerCid(dcid: rawbytes.Bytes): int32 =
    if BytesLen(dcid) <= 0:
        return -1
    for i in 0..<N_SLOTS:
        if gMsQuicSessions[i].active:
            if !gMsQuicSessions[i].closed:
                if gMsQuicSessions[i].serverBound:
                    if BytesLen(gMsQuicSessions[i].serverCidCache) > 0:
                        if BytesEqual(gMsQuicSessions[i].serverCidCache, dcid):
                            return i
    return -1

fn msquicNativeEnsureInit() =
    if msquicNativeReady:
        return
    # TLS1.3 debug stays off in production. (Reading CHENG_MSQUIC_DEBUG via
    # os.GetEnv/libc_getenv crashes when this transport runs inside the GUI app
    # .so: the app process's environ is not the one the Cheng getenv walks, so it
    # dereferences a -1 entry. The debug gate was only a development aid.)
    msquicNativeSetDebugTls13(false)
    handshake13.msquicTls13SetPhaseDebug(false)
    handshake13.msquicTls13SetFinishedDebug(false)
    handshake13.msquicTls13SetCertVerifyDebug(false)
    datapath_runtime.MsQuicDatapathGlobalInit()
    initMsQuicSettingsInto(msquicNativeListenerSettings)
    MsQuicNativeEmptyAddrInto(msquicNativeListenAddr)
    msquicNativeListenerRunning = false
    msquicNativeListenerDatapathId = 0
    msquicNativeListenerUdpFd = -1
    msquicNativeAcceptPending = false
    msquicNativeDropNextAppSend = false
    msquicNativeLocalRole = msquicNativeRoleNone
    msquicNativeReady = true

fn msquicNativeResetListenerOnly() =
    msquicNativeEnsureInit()
    if msquicNativeListenerDatapathId > 0:
        datapath_runtime.MsQuicDatapathGlobalUnbindUdp(msquicNativeListenerDatapathId)
        let _ = datapath_runtime.MsQuicDatapathGlobalStopCode(msquicNativeListenerDatapathId)
    msquicNativeListenerRunning = false
    msquicNativeListenerDatapathId = 0
    msquicNativeListenerUdpFd = -1
    MsQuicNativeEmptyAddrInto(msquicNativeListenAddr)
    initMsQuicSettingsInto(msquicNativeListenerSettings)

fn msquicNativeResetAll() =
    msquicNativeEnsureInit()
    for slot in 0..<N_SLOTS:
        msquicNativeCurSlot = slot
        if gMsQuicSessions[msquicNativeCurSlot].clientDatapathId > 0:
            datapath_runtime.MsQuicDatapathGlobalUnbindUdp(gMsQuicSessions[msquicNativeCurSlot].clientDatapathId)
            let _ = datapath_runtime.MsQuicDatapathGlobalStopCode(gMsQuicSessions[msquicNativeCurSlot].clientDatapathId)
        if gMsQuicSessions[msquicNativeCurSlot].listenerDatapathId > 0:
            datapath_runtime.MsQuicDatapathGlobalUnbindUdp(gMsQuicSessions[msquicNativeCurSlot].listenerDatapathId)
            let _ = datapath_runtime.MsQuicDatapathGlobalStopCode(gMsQuicSessions[msquicNativeCurSlot].listenerDatapathId)
    datapath_runtime.MsQuicDatapathGlobalInit()
    msquicNativeListenerRunning = false
    msquicNativeAcceptPending = false
    msquicNativeDropNextAppSend = false
    msquicNativeLocalRole = msquicNativeRoleNone
    msquicNativeListenerDatapathId = 0
    msquicNativeSessionClientDatapathId = 0
    msquicNativeSessionListenerDatapathId = 0
    msquicNativeListenerUdpFd = -1
    msquicNativeClientUdpFd = -1
    MsQuicNativeEmptyAddrInto(msquicNativeListenAddr)
    for slot in 0..<N_SLOTS:
        msquicNativeCurSlot = slot
        msquicNativeResetSession()
    msquicNativeCurSlot = 0

fn msquicNativeClientNextPacketNumber(packetTypeCode: int32): int64 =
    if packetTypeCode == msquicNativePacketInitialCode:
        let pn: int64 = gMsQuicSessions[msquicNativeCurSlot].clientInitialNext
        gMsQuicSessions[msquicNativeCurSlot].clientInitialNext = pn + 1
        return pn
    if packetTypeCode == msquicNativePacketHandshakeCode:
        let pn: int64 = gMsQuicSessions[msquicNativeCurSlot].clientHandshakeNext
        gMsQuicSessions[msquicNativeCurSlot].clientHandshakeNext = pn + 1
        return pn
    let pn: int64 = gMsQuicSessions[msquicNativeCurSlot].clientAppNext
    gMsQuicSessions[msquicNativeCurSlot].clientAppNext = pn + 1
    return pn

fn msquicNativeServerNextPacketNumber(packetTypeCode: int32): int64 =
    if packetTypeCode == msquicNativePacketInitialCode:
        let pn: int64 = gMsQuicSessions[msquicNativeCurSlot].serverInitialNext
        gMsQuicSessions[msquicNativeCurSlot].serverInitialNext = pn + 1
        return pn
    if packetTypeCode == msquicNativePacketHandshakeCode:
        let pn: int64 = gMsQuicSessions[msquicNativeCurSlot].serverHandshakeNext
        gMsQuicSessions[msquicNativeCurSlot].serverHandshakeNext = pn + 1
        return pn
    let pn: int64 = gMsQuicSessions[msquicNativeCurSlot].serverAppNext
    gMsQuicSessions[msquicNativeCurSlot].serverAppNext = pn + 1
    return pn

fn msquicNativeNextPacketNumber(side: int32, packetTypeCode: int32): int64 =
    if side == msquicNativeClientSide:
        return msquicNativeClientNextPacketNumber(packetTypeCode)
    return msquicNativeServerNextPacketNumber(packetTypeCode)

fn msquicNativeHeaderDestCid(side: int32): rawbytes.Bytes =
    if side == msquicNativeClientSide:
        return msquicCloneBytes(gMsQuicSessions[msquicNativeCurSlot].serverCidCache)
    return msquicCloneBytes(gMsQuicSessions[msquicNativeCurSlot].clientCidCache)

fn msquicNativeHeaderSrcCid(side: int32): rawbytes.Bytes =
    if side == msquicNativeClientSide:
        return msquicCloneBytes(gMsQuicSessions[msquicNativeCurSlot].clientCidCache)
    return msquicCloneBytes(gMsQuicSessions[msquicNativeCurSlot].serverCidCache)

fn msquicNativePacketTypeFromCode(packetTypeCode: int32): packet_header_model.QuicPacketType =
    var out: packet_header_model.QuicPacketType
    if packetTypeCode == msquicNativePacketInitialCode:
        return packet_header_model.quicPacketTypeFromBits(0)
    if packetTypeCode == msquicNativePacket0RttCode:
        return packet_header_model.quicPacketTypeFromBits(1)
    if packetTypeCode == msquicNativePacketHandshakeCode:
        return packet_header_model.quicPacketTypeFromBits(2)
    if packetTypeCode == msquicNativePacketRetryCode:
        return packet_header_model.quicPacketTypeFromBits(3)
    return out

fn msquicNativeBuildHeaderCommon(
    out: var packet_header_model.QuicPacketHeader,
    side: int32,
    packetTypeCode: int32,
    longHeader: bool,
    packetNumber: int64,
    payloadLen: int32
) =
    out.longHeader = longHeader
    out.packetType = msquicNativePacketTypeFromCode(packetTypeCode)
    if longHeader:
        out.version = msquicNativeVersion
        out.scid = msquicNativeHeaderSrcCid(side)
        out.payloadLength = int64(payloadLen + 2)
    else:
        out.version = 0
        out.scid = emptyBytes()
        out.payloadLength = 0
    out.dcid = msquicNativeHeaderDestCid(side)
    out.token = emptyBytes()
    out.packetNumber = packetNumber
    out.packetNumberLen = 2
    out.spinBit = false
    out.keyPhase = false

fn msquicNativeBuildShortHeaderInto(out: var packet_header_model.QuicPacketHeader, side: int32, packetNumber: int64) =
    msquicNativeBuildHeaderCommon(out, side, msquicNativePacketShortCode, false, packetNumber, 0)

fn msquicNativeBuildInitialHeaderInto(out: var packet_header_model.QuicPacketHeader, side: int32, packetNumber: int64, payloadLen: int32) =
    msquicNativeBuildHeaderCommon(out, side, msquicNativePacketInitialCode, true, packetNumber, payloadLen)

fn msquicNativeBuildHandshakeHeaderInto(out: var packet_header_model.QuicPacketHeader, side: int32, packetNumber: int64, payloadLen: int32) =
    msquicNativeBuildHeaderCommon(out, side, msquicNativePacketHandshakeCode, true, packetNumber, payloadLen)

fn msquicNativeBuildRetryHeaderInto(out: var packet_header_model.QuicPacketHeader, side: int32, packetNumber: int64, payloadLen: int32) =
    msquicNativeBuildHeaderCommon(out, side, msquicNativePacketRetryCode, true, packetNumber, payloadLen)

fn msquicNativeBuild0RttHeaderInto(out: var packet_header_model.QuicPacketHeader, side: int32, packetNumber: int64, payloadLen: int32) =
    msquicNativeBuildHeaderCommon(out, side, msquicNativePacket0RttCode, true, packetNumber, payloadLen)

fn msquicNativeBuildHeader(side: int32, packetTypeCode: int32, packetNumber: int64, payloadLen: int32): packet_header_model.QuicPacketHeader =
    var out: packet_header_model.QuicPacketHeader
    if packetTypeCode == msquicNativePacketShortCode:
        msquicNativeBuildShortHeaderInto(out, side, packetNumber)
        return out
    if packetTypeCode == msquicNativePacketInitialCode:
        msquicNativeBuildInitialHeaderInto(out, side, packetNumber, payloadLen)
        return out
    if packetTypeCode == msquicNativePacketHandshakeCode:
        msquicNativeBuildHandshakeHeaderInto(out, side, packetNumber, payloadLen)
        return out
    if packetTypeCode == msquicNativePacketRetryCode:
        msquicNativeBuildRetryHeaderInto(out, side, packetNumber, payloadLen)
        return out
    msquicNativeBuild0RttHeaderInto(out, side, packetNumber, payloadLen)
    return out

fn msquicNativeFrameAckEliciting(frameCode: int64): bool =
    if frameCode == 2:
        return false
    if frameCode == 0x00:
        return false
    if frameCode == 28:
        return false
    if frameCode == 29:
        return false
    return true

@borrows
fn msquicNativePacketAddCryptoFrame(pkt: var packet_model.MsQuicPacket, offset: int64, data: rawbytes.Bytes): Result[bool] =
    if msquicNativeDebugTls13:
        let frameDebugText: str = strutil.Join(["msquic_native_debug add_crypto_frame kind=",
                                                IntToStr(msquicNativeFrameCryptoCode),
                                                " data_len=",
                                                IntToStr(BytesLen(data))], "")
        msquicNativeDebugWriteLine(frameDebugText)
    return MsQuicPacketAddFrameParts(pkt, int64(msquicNativeFrameCryptoCode), 0, offset, 0, data)

fn msquicNativePacketAddAckFrame(pkt: var packet_model.MsQuicPacket, number: int64): Result[bool] =
    if msquicNativeDebugTls13:
        msquicNativeDebugWriteLine("msquic_native_debug add_ack_frame_start")
    if msquicNativeDebugTls13:
        let frameDebugText: str = strutil.Join(["msquic_native_debug add_ack_frame kind=",
                                                "2",
                                                " data_len=",
                                                "0"], "")
        msquicNativeDebugWriteLine(frameDebugText)
    return MsQuicPacketAddFrameParts(pkt, 2, 0, 0, number, emptyBytes())

@borrows
fn msquicNativePacketAddConnectionCloseFrame(pkt: var packet_model.MsQuicPacket, reason: rawbytes.Bytes): Result[bool] =
    return MsQuicPacketAddFrameParts(pkt, int64(msquicNativeFrameConnectionCloseCode), 0, 0, 0, reason)

@borrows
fn msquicNativeSendWire(side: int32, wire: rawbytes.Bytes, dropAppSend: bool): Result[bool] =
    var fromId: int32
    # send 链槽显式锚定（F-I 第三层缺陷清偿）: toAddr 不再经全局 cur 寻址
    # （调用方 pin-then-call 的锁间窗被他线程翻 cur → 读到空对端地址
    # "send: to addr"，真机自连轮 2b/3 实测），改在单一锁 span 内从角色锚点
    # 槽取地址——client=dial 前奏/尾锚定的 Client 槽, server=server 路由/
    # accept 尾锚定的 Server 槽, 与 RetagPipeIdxFor{Server,Client}Session 同型。
    var toAddr: str
    MsQuicNativeTransportLock()
    if side == msquicNativeClientSide:
        fromId = msquicNativeSessionClientDatapathId
        let clientSlot: int32 = msquicNativeLastClientSessionSlot
        if clientSlot >= 0 && clientSlot < N_SLOTS:
            toAddr = strings.ConcatStr(gMsQuicSessions[clientSlot].listenerAddrText, "")
    else:
        fromId = msquicNativeSessionListenerDatapathId
        let serverSlot: int32 = msquicNativeLastServerSessionSlot
        if serverSlot >= 0 && serverSlot < N_SLOTS:
            toAddr = strings.ConcatStr(gMsQuicSessions[serverSlot].clientAddrText, "")
    MsQuicNativeTransportUnlock()
    if fromId <= 0:
        return Err[bool]("msquic native send: from id")
    if len(toAddr) <= 0:
        return Err[bool]("msquic native send: to addr")
    if msquicNativeDebugTls13:
        var msg = "msquic_native_debug send_wire side="
        if side == msquicNativeClientSide:
            msg = strutil.Join([ share(msg), "client"], "")
        else:
            msg = strutil.Join([ share(msg), "server"], "")
        msg = strutil.Join([ share(msg), " from_id=", IntToStr(fromId)], "")
        msg = strutil.Join([ share(msg), " to=", strings.CloneStr(toAddr)], "")
        msg = strutil.Join([ share(msg), " len=", IntToStr(BytesLen(wire))], "")
        os.WriteLine(os.Get_stderr(), msg)
    if dropAppSend && msquicNativeDropNextAppSend:
        msquicNativeDropNextAppSend = false
        return Ok[bool](true)
    let sendRes: Result[bool] = datapath_runtime.MsQuicDatapathGlobalSendUdp(fromId, toAddr, wire, -1)
    if IsErr(sendRes):
        return Err[bool](ErrorText(sendRes))
    return Ok[bool](true)

fn msquicNativeRememberLongPacket(side: int32, packetTypeCode: int32, wire: rawbytes.Bytes, ackEliciting: bool) =
    if !ackEliciting:
        return
    let nowMs: int64 = MsQuicNativeNowMs()
    if side == msquicNativeClientSide && packetTypeCode == msquicNativePacketInitialCode:
        gMsQuicSessions[msquicNativeCurSlot].clientInitialPendingActive = true
        gMsQuicSessions[msquicNativeCurSlot].clientInitialPendingWire = wire
        gMsQuicSessions[msquicNativeCurSlot].clientInitialPendingSentAtMs = nowMs
        return
    if side == msquicNativeClientSide && packetTypeCode == msquicNativePacketHandshakeCode:
        gMsQuicSessions[msquicNativeCurSlot].clientHandshakePendingActive = true
        gMsQuicSessions[msquicNativeCurSlot].clientHandshakePendingWire = wire
        gMsQuicSessions[msquicNativeCurSlot].clientHandshakePendingSentAtMs = nowMs
        if msquicNativeDebugTls13:
            let debugText: str = strutil.Join(["msquic_native_debug remember=client-handshake len=", IntToStr(BytesLen(wire))], "")
            msquicNativeDebugWriteLine(debugText)
        return
    if side == msquicNativeServerSide && packetTypeCode == msquicNativePacketHandshakeCode:
        gMsQuicSessions[msquicNativeCurSlot].serverHandshakePendingActive = true
        gMsQuicSessions[msquicNativeCurSlot].serverHandshakePendingWire = wire
        gMsQuicSessions[msquicNativeCurSlot].serverHandshakePendingSentAtMs = nowMs
        if gMsQuicSessions[msquicNativeCurSlot].serverHandshakeFirstSentAtMs <= 0:
            gMsQuicSessions[msquicNativeCurSlot].serverHandshakeFirstSentAtMs = nowMs

fn msquicNativeRetransmitClientInitial(nowMs: int64): Result[bool] =
    if !gMsQuicSessions[msquicNativeCurSlot].clientInitialPendingActive || BytesLen(gMsQuicSessions[msquicNativeCurSlot].clientInitialPendingWire) <= 0:
        return Ok[bool](false)
    if nowMs - gMsQuicSessions[msquicNativeCurSlot].clientInitialPendingSentAtMs < int64(msquicNativeLongPacketRetransmitMs):
        return Ok[bool](false)
    if msquicNativeDebugTls13:
        msquicNativeDebugWriteLine("msquic_native_debug retransmit=initial side=client")
    let sendRes: Result[bool] = msquicNativeSendWire(msquicNativeClientSide,
                                                     gMsQuicSessions[msquicNativeCurSlot].clientInitialPendingWire,
                                                     false)
    if IsErr(sendRes):
        return Err[bool](ErrorText(sendRes))
    gMsQuicSessions[msquicNativeCurSlot].clientInitialPendingSentAtMs = nowMs
    return Ok[bool](true)

fn msquicNativeRetransmitClientHandshake(nowMs: int64): Result[bool] =
    if !gMsQuicSessions[msquicNativeCurSlot].clientHandshakePendingActive || BytesLen(gMsQuicSessions[msquicNativeCurSlot].clientHandshakePendingWire) <= 0:
        return Ok[bool](false)
    if nowMs - gMsQuicSessions[msquicNativeCurSlot].clientHandshakePendingSentAtMs < int64(msquicNativeLongPacketRetransmitMs):
        return Ok[bool](false)
    if msquicNativeDebugTls13:
        msquicNativeDebugWriteLine("msquic_native_debug retransmit=handshake side=client")
    let sendRes: Result[bool] = msquicNativeSendWire(msquicNativeClientSide,
                                                     gMsQuicSessions[msquicNativeCurSlot].clientHandshakePendingWire,
                                                     false)
    if IsErr(sendRes):
        return Err[bool](ErrorText(sendRes))
    gMsQuicSessions[msquicNativeCurSlot].clientHandshakePendingSentAtMs = nowMs
    return Ok[bool](true)

fn msquicNativeRetransmitServerHandshake(nowMs: int64): Result[bool] =
    if !gMsQuicSessions[msquicNativeCurSlot].serverHandshakePendingActive || BytesLen(gMsQuicSessions[msquicNativeCurSlot].serverHandshakePendingWire) <= 0:
        return Ok[bool](false)
    if nowMs - gMsQuicSessions[msquicNativeCurSlot].serverHandshakePendingSentAtMs < int64(msquicNativeLongPacketRetransmitMs):
        return Ok[bool](false)
    if msquicNativeDebugTls13:
        msquicNativeDebugWriteLine("msquic_native_debug retransmit=handshake side=server")
    let sendRes: Result[bool] = msquicNativeSendWire(msquicNativeServerSide,
                                                     gMsQuicSessions[msquicNativeCurSlot].serverHandshakePendingWire,
                                                     false)
    if IsErr(sendRes):
        return Err[bool](ErrorText(sendRes))
    gMsQuicSessions[msquicNativeCurSlot].serverHandshakePendingSentAtMs = nowMs
    return Ok[bool](true)

# Owned byte copy that borrows its source (rawbytes has no owned clone).
@borrows
fn msquicCloneBytes(b: rawbytes.Bytes): rawbytes.Bytes =
    var out = rawbytes.BytesAlloc(rawbytes.BytesLen(b))
    rawbytes.BytesCopyInto(out, 0, b)
    return out

@borrows
fn msquicNativeSendPayload(
    side: int32,
    packetTypeCode: int32,
    packetNumber: int64,
    payload: rawbytes.Bytes,
    ackEliciting: bool
): Result[bool] =
    let header: packet_header_model.QuicPacketHeader = msquicNativeBuildHeader(side, packetTypeCode, packetNumber, BytesLen(payload))
    let encRes: Result[rawbytes.Bytes] = quicPacketHeaderEncode(header)
    if IsErr(encRes):
        return Err[bool](ErrorText(encRes))
    let encBytes: rawbytes.Bytes = Value(encRes)
    let wire: rawbytes.Bytes = BytesConcat3(msquicCloneBytes(encBytes), msquicCloneBytes(payload), emptyBytes())
    var headerFirst: int32
    if BytesLen(encBytes) > 0:
        headerFirst = BytesGet(encBytes, 0)
    var wireFirst: int32
    if BytesLen(wire) > 0:
        wireFirst = BytesGet(wire, 0)
    if msquicNativeDebugTls13:
        msquicNativeDebugWriteLine(strutil.Join(["msquic native debug: send wire header_len=", IntToStr(BytesLen(encBytes)), " header_first=", IntToStr(headerFirst), " payload_len=", IntToStr(BytesLen(payload)), " wire_len=", IntToStr(BytesLen(wire)), " wire_first=", IntToStr(wireFirst)], ""))
        var sendPayloadDebug: str = "msquic_native_debug send_payload header_len="
        sendPayloadDebug = strutil.Join([sendPayloadDebug, IntToStr(BytesLen(encBytes))], "")
        sendPayloadDebug = strutil.Join([sendPayloadDebug, " payload_len="], "")
        sendPayloadDebug = strutil.Join([sendPayloadDebug, IntToStr(BytesLen(payload))], "")
        sendPayloadDebug = strutil.Join([sendPayloadDebug, " wire_len="], "")
        sendPayloadDebug = strutil.Join([sendPayloadDebug, IntToStr(BytesLen(wire))], "")
        if BytesLen(wire) > 0:
            sendPayloadDebug = strutil.Join([sendPayloadDebug, " first="], "")
            sendPayloadDebug = strutil.Join([sendPayloadDebug, IntToStr(BytesGet(wire, 0))], "")
        msquicNativeDebugWriteLine(sendPayloadDebug)
    let sendRes: Result[bool] = msquicNativeSendWire(side,
                                                     msquicCloneBytes(wire),
                                                     packetTypeCode == msquicNativePacketShortCode && ackEliciting)
    if IsErr(sendRes):
        return sendRes
    msquicNativeRememberLongPacket(side, packetTypeCode, wire, ackEliciting)
    return Ok[bool](true)

fn msquicNativeQueueTransportCredit(side: int32, peerStreamId: int64): Result[bool] =
    if side == msquicNativeClientSide:
        if gMsQuicSessions[msquicNativeCurSlot].clientMaxDataSent:
            return Ok[bool](true)
        let maxDataRes: Result[bool] = connection_impl.MsQuicConnImplQueueFrameParts(msquicNativeClientImpl[msquicNativeCurSlot],
                                                                                      16,
                                                                                      0,
                                                                                      0,
                                                                                      gMsQuicSessions[msquicNativeCurSlot].clientConnWindow,
                                                                                      emptyBytes())
        if IsErr(maxDataRes):
            return Err[bool](ErrorText(maxDataRes))
        let maxStreamRes: Result[bool] = connection_impl.MsQuicConnImplQueueFrameParts(msquicNativeClientImpl[msquicNativeCurSlot],
                                                                                      17,
                                                                                      peerStreamId,
                                                                                      0,
                                                                                      gMsQuicSessions[msquicNativeCurSlot].clientStreamWindow,
                                                                                      emptyBytes())
        if IsErr(maxStreamRes):
            return Err[bool](ErrorText(maxStreamRes))
        gMsQuicSessions[msquicNativeCurSlot].clientMaxDataSent = true
        gMsQuicSessions[msquicNativeCurSlot].clientMaxStreamDataSent = true
        return Ok[bool](true)
    if side == msquicNativeServerSide:
        if gMsQuicSessions[msquicNativeCurSlot].serverMaxDataSent:
            return Ok[bool](true)
        let maxDataRes: Result[bool] = connection_impl.MsQuicConnImplQueueFrameParts(msquicNativeServerImpl[msquicNativeCurSlot],
                                                                                      16,
                                                                                      0,
                                                                                      0,
                                                                                      gMsQuicSessions[msquicNativeCurSlot].serverConnWindow,
                                                                                      emptyBytes())
        if IsErr(maxDataRes):
            return Err[bool](ErrorText(maxDataRes))
        let maxStreamRes: Result[bool] = connection_impl.MsQuicConnImplQueueFrameParts(msquicNativeServerImpl[msquicNativeCurSlot],
                                                                                      17,
                                                                                      peerStreamId,
                                                                                      0,
                                                                                      gMsQuicSessions[msquicNativeCurSlot].serverStreamWindow,
                                                                                      emptyBytes())
        if IsErr(maxStreamRes):
            return Err[bool](ErrorText(maxStreamRes))
        gMsQuicSessions[msquicNativeCurSlot].serverMaxDataSent = true
        gMsQuicSessions[msquicNativeCurSlot].serverMaxStreamDataSent = true
        return Ok[bool](true)
    return Err[bool]("msquic native: invalid side")

fn msquicNativeFlushClientShortPacketsLoop(): bool =
    for flushIdx in 0..<msquicNativeShortPacketFlushBudget:
        if ! connection_impl.MsQuicConnImplHasQueued(msquicNativeClientImpl[msquicNativeCurSlot]):
            return true
        if ! connection_impl.MsQuicConnImplFlushAllowed(msquicNativeClientImpl[msquicNativeCurSlot]):
            if msquicNativeDebugTls13:
                let debugText: str = strutil.Join(["msquic_native_debug flush_short_blocked side=client in_flight=", int64ToStr(connection_impl.MsQuicConnImplBytesInFlight(msquicNativeClientImpl[msquicNativeCurSlot]))], "")
                msquicNativeDebugWriteLine(debugText)
            return true
        var packetNumber: int64
        var payload: rawbytes.Bytes
        var ackEliciting: bool
        var frameCount: int32
        let pktRes: Result[bool] = connection_impl.MsQuicConnImplBuildPacketPartsInto(msquicNativeClientImpl[msquicNativeCurSlot],
                                                                                      packetNumber,
                                                                                      payload,
                                                                                      ackEliciting,
                                                                                      frameCount)
        if IsErr(pktRes):
            msquicNativeResultErrorScratch = ErrorText(pktRes)
            return false
        if msquicNativeDebugTls13:
            let debugText: str = strutil.Join(["msquic_native_debug flush_short_send side=client pn=", int64ToStr(packetNumber), " len=", IntToStr(BytesLen(payload)), " frames=", IntToStr(frameCount)], "")
            msquicNativeDebugWriteLine(debugText)
        let sendRes: Result[bool] = msquicNativeSendPayload(msquicNativeClientSide, msquicNativePacketShortCode, packetNumber, payload, ackEliciting)
        if IsErr(sendRes):
            msquicNativeResultErrorScratch = ErrorText(sendRes)
            return false
        let recRes: Result[bool] = connection_impl.MsQuicConnImplRecordSentParts(msquicNativeClientImpl[msquicNativeCurSlot], packetNumber, ackEliciting, payload)
        if IsErr(recRes):
            msquicNativeResultErrorScratch = ErrorText(recRes)
            return false
    return true

fn msquicNativeFlushClientShortPacketsFill(): bool =
    msquicNativeResetResultScratch()
    let creditRes: Result[bool] = msquicNativeQueueTransportCredit(msquicNativeClientSide, msquicNativeStreamServer)
    if IsErr(creditRes):
        msquicNativeResultErrorScratch = ErrorText(creditRes)
        return false
    return msquicNativeFlushClientShortPacketsLoop()

fn msquicNativeFlushClientShortPackets(): Result[bool] =
    let ok: bool = msquicNativeFlushClientShortPacketsFill()
    if ! ok:
        return Err[bool](msquicNativeResultErrorScratch)
    return Ok[bool](true)

fn msquicNativeFlushServerShortPacketsLoop(): bool =
    for flushIdx in 0..<msquicNativeShortPacketFlushBudget:
        if ! connection_impl.MsQuicConnImplHasQueued(msquicNativeServerImpl[msquicNativeCurSlot]):
            return true
        if ! connection_impl.MsQuicConnImplFlushAllowed(msquicNativeServerImpl[msquicNativeCurSlot]):
            if msquicNativeDebugTls13:
                let debugText: str = strutil.Join(["msquic_native_debug flush_short_blocked side=server in_flight=", int64ToStr(connection_impl.MsQuicConnImplBytesInFlight(msquicNativeServerImpl[msquicNativeCurSlot]))], "")
                msquicNativeDebugWriteLine(debugText)
            return true
        var packetNumber: int64
        var payload: rawbytes.Bytes
        var ackEliciting: bool
        var frameCount: int32
        let pktRes: Result[bool] = connection_impl.MsQuicConnImplBuildPacketPartsInto(msquicNativeServerImpl[msquicNativeCurSlot],
                                                                                      packetNumber,
                                                                                      payload,
                                                                                      ackEliciting,
                                                                                      frameCount)
        if IsErr(pktRes):
            msquicNativeResultErrorScratch = ErrorText(pktRes)
            return false
        if msquicNativeDebugTls13:
            let debugText: str = strutil.Join(["msquic_native_debug flush_short_send side=server pn=", int64ToStr(packetNumber), " len=", IntToStr(BytesLen(payload)), " frames=", IntToStr(frameCount)], "")
            msquicNativeDebugWriteLine(debugText)
        let sendRes: Result[bool] = msquicNativeSendPayload(msquicNativeServerSide, msquicNativePacketShortCode, packetNumber, payload, ackEliciting)
        if IsErr(sendRes):
            msquicNativeResultErrorScratch = ErrorText(sendRes)
            return false
        let recRes: Result[bool] = connection_impl.MsQuicConnImplRecordSentParts(msquicNativeServerImpl[msquicNativeCurSlot], packetNumber, ackEliciting, payload)
        if IsErr(recRes):
            msquicNativeResultErrorScratch = ErrorText(recRes)
            return false
    return true

fn msquicNativeFlushServerShortPacketsFill(): bool =
    msquicNativeResetResultScratch()
    let creditRes: Result[bool] = msquicNativeQueueTransportCredit(msquicNativeServerSide, msquicNativeStreamClient)
    if IsErr(creditRes):
        msquicNativeResultErrorScratch = ErrorText(creditRes)
        return false
    return msquicNativeFlushServerShortPacketsLoop()

fn msquicNativeFlushServerShortPackets(): Result[bool] =
    let ok: bool = msquicNativeFlushServerShortPacketsFill()
    if ! ok:
        return Err[bool](msquicNativeResultErrorScratch)
    return Ok[bool](true)

fn msquicNativeFlushShortPackets(side: int32): Result[bool] =
    if ! gMsQuicSessions[msquicNativeCurSlot].active || gMsQuicSessions[msquicNativeCurSlot].closed:
        return Ok[bool](false)
    if side == msquicNativeClientSide && gMsQuicSessions[msquicNativeCurSlot].clientReady <= 0:
        if msquicNativeDebugTls13:
            msquicNativeDebugWriteLine("msquic_native_debug flush_short_skip side=client ready=false")
        return Ok[bool](false)
    if side == msquicNativeServerSide && gMsQuicSessions[msquicNativeCurSlot].serverReady <= 0:
        if msquicNativeDebugTls13:
            msquicNativeDebugWriteLine("msquic_native_debug flush_short_skip side=server ready=false")
        return Ok[bool](false)
    if side == msquicNativeClientSide:
        return msquicNativeFlushClientShortPackets()
    return msquicNativeFlushServerShortPackets()

fn msquicNativeSendClientHelloFill(): bool =
    msquicNativeResetResultScratch()
    msquicNativeDebugWriteLine("msquic native debug: client hello x25519")
    let genRes: Result[bool] = handshake13.msquicTls13ClientGenerateX25519()
    if IsErr(genRes):
        msquicNativeResultErrorScratch = ErrorText(genRes)
        return false
    if msquicNativeDebugTls13:
        let clientPrivText: str = strutil.Join(["msquic_native_debug client_priv=", BytesToHex(handshake13.msquicTls13ClientLocalKeySharePriv())], "")
        msquicNativeDebugWriteLine(clientPrivText)
        let clientPubText: str = strutil.Join(["msquic_native_debug client_pub=", BytesToHex(handshake13.msquicTls13ClientLocalKeySharePub())], "")
        msquicNativeDebugWriteLine(clientPubText)
    handshake13.msquicTls13ClientSetServerName(gMsQuicSessions[msquicNativeCurSlot].clientServerNameCache)
    let randomSeed: rawbytes.Bytes = msquicNativeSeededBytes(17)
    let emptyContext: rawbytes.Bytes = emptyBytes()
    msquicNativeDebugWriteLine("msquic native debug: client hello build")
    let helloRes: Result[rawbytes.Bytes] = handshake13.msquicTls13ClientBuildClientHello(
        randomSeed,
        gMsQuicSessions[msquicNativeCurSlot].clientAlpnOfferCache,
        gMsQuicSessions[msquicNativeCurSlot].clientServerNameCache,
        emptyContext
    )
    if IsErr(helloRes):
        msquicNativeResultErrorScratch = ErrorText(helloRes)
        return false
    let raw: rawbytes.Bytes = Value(helloRes)
    msquicNativeDebugWriteLine("msquic native debug: client hello transcript")
    if msquicNativeDebugTls13:
        let rawDebugText: str = strutil.Join(["msquic_native_debug client_hello_raw_len=", IntToStr(BytesLen(raw))], "")
        msquicNativeDebugWriteLine(rawDebugText)
    handshake13.msquicTls13ClientAppendTranscript(raw)
    msquicNativeDebugWriteLine("msquic native debug: client hello packet")
    var pkt: packet_model.MsQuicPacket
    let packetNumber: int64 = msquicNativeNextPacketNumber(msquicNativeClientSide, msquicNativePacketInitialCode)
    msquicPacketReset(pkt, packetNumber)
    let addRes: Result[bool] = msquicNativePacketAddCryptoFrame(pkt, 0, raw)
    if IsErr(addRes):
        msquicNativeResultErrorScratch = ErrorText(addRes)
        return false
    if msquicNativeDebugTls13:
        let frameDebugText: str = strutil.Join(["msquic_native_debug client_hello_pkt_frames=",
                                                "1",
                                                " data_len=",
                                                IntToStr(BytesLen(raw))], "")
        msquicNativeDebugWriteLine(frameDebugText)
    msquicNativeDebugWriteLine("msquic native debug: client hello payload encode")
    let payloadRes: Result[rawbytes.Bytes] = msquicPacketPayloadEncode(pkt)
    if IsErr(payloadRes):
        msquicNativeResultErrorScratch = ErrorText(payloadRes)
        return false
    let payload: rawbytes.Bytes = Value(payloadRes)
    if msquicNativeDebugTls13:
        var payloadDebugText: str = strutil.Join(["msquic_native_debug client_hello_payload_len=", IntToStr(BytesLen(payload))], "")
        if BytesLen(payload) > 0:
            payloadDebugText = strutil.Join([ share(payloadDebugText), " first=", IntToStr(BytesGet(payload, 0))], "")
        msquicNativeDebugWriteLine(payloadDebugText)
    msquicNativeDebugWriteLine("msquic native debug: client hello send payload")
    let sendRes: Result[bool] = msquicNativeSendPayload(
        msquicNativeClientSide,
        msquicNativePacketInitialCode,
        packetNumber,
        payload,
        true
    )
    if IsErr(sendRes):
        msquicNativeResultErrorScratch = ErrorText(sendRes)
        return false
    return true

fn msquicNativeSendClientHello(): Result[bool] =
    let ok: bool = msquicNativeSendClientHelloFill()
    if ! ok:
        return Err[bool](msquicNativeResultErrorScratch)
    return Ok[bool](true)

fn msquicNativeDebugBuildClientHelloPayload(): Result[rawbytes.Bytes] =
    let genRes: Result[bool] = handshake13.msquicTls13ClientGenerateX25519()
    if IsErr(genRes):
        return Err[rawbytes.Bytes](ErrorText(genRes))
    handshake13.msquicTls13ClientSetServerName(gMsQuicSessions[msquicNativeCurSlot].clientServerNameCache)
    let randomSeed: rawbytes.Bytes = msquicNativeSeededBytes(17)
    let helloRes: Result[rawbytes.Bytes] = handshake13.msquicTls13ClientBuildClientHello(
        randomSeed,
        gMsQuicSessions[msquicNativeCurSlot].clientAlpnOfferCache,
        gMsQuicSessions[msquicNativeCurSlot].clientServerNameCache,
        emptyBytes()
    )
    if IsErr(helloRes):
        return Err[rawbytes.Bytes](ErrorText(helloRes))
    let raw: rawbytes.Bytes = Value(helloRes)
    var pkt: packet_model.MsQuicPacket
    msquicPacketReset(pkt, 1)
    let addRes: Result[bool] = msquicNativePacketAddCryptoFrame(pkt, 0, raw)
    if IsErr(addRes):
        return Err[rawbytes.Bytes](ErrorText(addRes))
    return msquicPacketPayloadEncode(pkt)

fn msquicNativeDebugBuildClientHelloWire(): Result[rawbytes.Bytes] =
    if BytesLen(gMsQuicSessions[msquicNativeCurSlot].clientCidCache) <= 0:
        msquicNativeAssignFreshSessionCids()
    elif BytesLen(gMsQuicSessions[msquicNativeCurSlot].serverCidCache) <= 0:
        msquicNativeAssignFreshSessionCids()
    let payloadRes: Result[rawbytes.Bytes] = msquicNativeDebugBuildClientHelloPayload()
    if IsErr(payloadRes):
        return Err[rawbytes.Bytes](ErrorText(payloadRes))
    let payload: rawbytes.Bytes = Value(payloadRes)
    let header: packet_header_model.QuicPacketHeader = msquicNativeBuildHeader(
        msquicNativeClientSide,
        msquicNativePacketInitialCode,
        1,
        BytesLen(payload)
    )
    let headerRes: Result[rawbytes.Bytes] = quicPacketHeaderEncode(header)
    if IsErr(headerRes):
        return Err[rawbytes.Bytes](ErrorText(headerRes))
    return Ok[rawbytes.Bytes](BytesConcat3(Value(headerRes), payload, emptyBytes()))

fn msquicNativeDebugExtractFirstCryptoData(payload: rawbytes.Bytes): Result[rawbytes.Bytes] =
    let kindRes: Result[quic_varint.QuicVarIntDecoded] = quic_varint.quicVarIntDecode(payload, 0)
    if IsErr(kindRes):
        return Err[rawbytes.Bytes](ErrorText(kindRes))
    let kindDec: quic_varint.QuicVarIntDecoded = Value(kindRes)
    if kindDec.value != 6:
        return Err[rawbytes.Bytes]("msquic native: debug first frame ! crypto")
    let streamRes: Result[quic_varint.QuicVarIntDecoded] = quic_varint.quicVarIntDecode(payload, kindDec.next)
    if IsErr(streamRes):
        return Err[rawbytes.Bytes](ErrorText(streamRes))
    let streamDec: quic_varint.QuicVarIntDecoded = Value(streamRes)
    let offsetRes: Result[quic_varint.QuicVarIntDecoded] = quic_varint.quicVarIntDecode(payload, streamDec.next)
    if IsErr(offsetRes):
        return Err[rawbytes.Bytes](ErrorText(offsetRes))
    let offsetDec: quic_varint.QuicVarIntDecoded = Value(offsetRes)
    let lenRes: Result[quic_varint.QuicVarIntDecoded] = quic_varint.quicVarIntDecode(payload, offsetDec.next)
    if IsErr(lenRes):
        return Err[rawbytes.Bytes](ErrorText(lenRes))
    let lenDec: quic_varint.QuicVarIntDecoded = Value(lenRes)
    let dataLen: int32 = int32(lenDec.value)
    if dataLen <= 0:
        return Err[rawbytes.Bytes]("msquic native: debug crypto payload empty")
    let dataStart: int32 = lenDec.next
    let dataEnd: int32 = dataStart + dataLen
    if dataEnd > BytesLen(payload):
        return Err[rawbytes.Bytes]("msquic native: debug crypto payload truncated")
    let out: rawbytes.Bytes = BytesSlice(payload, dataStart, dataLen)
    return Ok[rawbytes.Bytes](out)

fn msquicNativeDebugFeedClientHelloPayload(): Result[bool] =
    msquicNativeResetServerHandshake(false)
    let payloadRes: Result[rawbytes.Bytes] = msquicNativeDebugBuildClientHelloPayload()
    if IsErr(payloadRes):
        return Err[bool](ErrorText(payloadRes))
    let payload: rawbytes.Bytes = Value(payloadRes)
    let helloRes: Result[rawbytes.Bytes] = msquicNativeDebugExtractFirstCryptoData(payload)
    if IsErr(helloRes):
        return Err[bool](ErrorText(helloRes))
    let hello: rawbytes.Bytes = Value(helloRes)
    let feedRes: Result[int32] = msquicNativeFeedServerHandshake(hello)
    if IsErr(feedRes):
        return Err[bool](ErrorText(feedRes))
    let messageCount: int32 = Value(feedRes)
    if messageCount != 1:
        return Err[bool]("msquic native: debug initial expected one handshake message")
    let keyShareGroup: int32 = msquicNativeServerClientKeyShareGroup()
    if keyShareGroup <= 0:
        return Err[bool]("msquic native: debug initial missing server client key share")
    return Ok[bool](true)

fn msquicNativeDebugRoundtripClientHelloInitial(): Result[bool] =
    msquicNativeResetServerHandshake(false)
    let wireRes: Result[rawbytes.Bytes] = msquicNativeDebugBuildClientHelloWire()
    if IsErr(wireRes):
        return Err[bool](ErrorText(wireRes))
    let wire: rawbytes.Bytes = Value(wireRes)
    let decodeHeaderRes: Result[QuicPacketHeaderDecoded] = quicPacketHeaderDecode(wire, msquicNativeConnIdLen)
    if IsErr(decodeHeaderRes):
        return Err[bool](ErrorText(decodeHeaderRes))
    let payloadOffset: int32 = Value(decodeHeaderRes).next
    let payloadLen: int32 = int32(Value(decodeHeaderRes).header.payloadLength) - Value(decodeHeaderRes).header.packetNumberLen
    if payloadLen <= 0:
        return Err[bool]("msquic native: debug roundtrip payload empty")
    let payload: rawbytes.Bytes = BytesSlice(wire, payloadOffset, payloadLen)
    let helloRes: Result[rawbytes.Bytes] = msquicNativeDebugExtractFirstCryptoData(payload)
    if IsErr(helloRes):
        return Err[bool](ErrorText(helloRes))
    let hello: rawbytes.Bytes = Value(helloRes)
    let feedRes: Result[int32] = msquicNativeFeedServerHandshake(hello)
    if IsErr(feedRes):
        return Err[bool](ErrorText(feedRes))
    let messageCount: int32 = Value(feedRes)
    if messageCount != 1:
        return Err[bool]("msquic native: debug roundtrip expected one handshake message")
    let keyShareGroup: int32 = msquicNativeServerClientKeyShareGroup()
    if keyShareGroup <= 0:
        return Err[bool]("msquic native: debug roundtrip missing server client key share")
    return Ok[bool](true)

fn msquicNativeSendServerFlightFill(): bool =
    msquicNativeResetResultScratch()
    let alreadySent: bool = gMsQuicSessions[msquicNativeCurSlot].serverFlightSent
    if alreadySent:
        if gMsQuicSessions[msquicNativeCurSlot].serverHandshakePendingActive && BytesLen(gMsQuicSessions[msquicNativeCurSlot].serverHandshakePendingWire) > 0:
            if msquicNativeDebugTls13:
                msquicNativeDebugWriteLine("msquic_native_debug resend=handshake side=server duplicate_initial")
            let resendRes: Result[bool] = msquicNativeSendWire(msquicNativeServerSide,
                                                               gMsQuicSessions[msquicNativeCurSlot].serverHandshakePendingWire,
                                                               false)
            if IsErr(resendRes):
                msquicNativeResultErrorScratch = ErrorText(resendRes)
                return false
            gMsQuicSessions[msquicNativeCurSlot].serverHandshakePendingSentAtMs = MsQuicNativeNowMs()
        return true
    let flightStartedAtMs: int64 = MsQuicNativeNowMs()
    let keygenStartedAtMs: int64 = MsQuicNativeNowMs()
    let serverClientGroup: int32 = handshake13.msquicTls13ServerClientKeyShareGroup()
    if serverClientGroup <= 0:
        msquicNativeResultErrorScratch = "msquic native: server client key share missing before flight"
        return false
    let genRes: Result[bool] = handshake13.msquicTls13ServerGenerateForClientKeyShare()
    if IsErr(genRes):
        msquicNativeResultErrorScratch = ErrorText(genRes)
        return false
    let serverLocalGroup: int32 = handshake13.msquicTls13ServerLocalKeyShareGroup()
    if msquicNativeDebugTls13:
        let serverGroupText: str = strutil.Join(["msquic_native_debug server_key_share_group local=", IntToStr(serverLocalGroup), " client=", IntToStr(serverClientGroup)], "")
        msquicNativeDebugWriteLine(serverGroupText)
    if serverLocalGroup != serverClientGroup:
        msquicNativeResultErrorScratch = strutil.Join(["msquic native: server key share diverged local=", IntToStr(serverLocalGroup), " client=", IntToStr(serverClientGroup)], "")
        return false
    if msquicNativeDebugTls13:
        let serverPrivText: str = strutil.Join(["msquic_native_debug server_priv=", BytesToHex(handshake13.msquicTls13ServerLocalKeySharePriv())], "")
        msquicNativeDebugWriteLine(serverPrivText)
        let serverPubText: str = strutil.Join(["msquic_native_debug server_pub=", BytesToHex(handshake13.msquicTls13ServerLocalKeySharePub())], "")
        msquicNativeDebugWriteLine(serverPubText)
        let serverClientPubText: str = strutil.Join(["msquic_native_debug server_client_pub=", BytesToHex(handshake13.msquicTls13ServerClientKeyShare())], "")
        msquicNativeDebugWriteLine(serverClientPubText)
        if serverLocalGroup == 29:
            let sharedRes = curve25519.curve25519SharedKey(handshake13.msquicTls13ServerLocalKeySharePriv(),
                                                           handshake13.msquicTls13ServerClientKeyShare())
            if IsOk(sharedRes):
                let serverSharedText: str = strutil.Join(["msquic_native_debug server_shared=", BytesToHex(Value(sharedRes))], "")
                msquicNativeDebugWriteLine(serverSharedText)
    let keygenCompletedAtMs: int64 = MsQuicNativeNowMs()

    let ackStartedAtMs: int64 = MsQuicNativeNowMs()
    if msquicNativeDebugTls13:
        msquicNativeDebugWriteLine("msquic_native_debug server_ack_start")
    var ackPkt: packet_model.MsQuicPacket
    let ackPacketNumber: int64 = msquicNativeNextPacketNumber(msquicNativeServerSide, msquicNativePacketInitialCode)
    msquicPacketReset(ackPkt, ackPacketNumber)
    if msquicNativeDebugTls13:
        msquicNativeDebugWriteLine("msquic_native_debug server_ack_reset")
    let ackRes: Result[bool] = msquicNativePacketAddAckFrame(ackPkt, gMsQuicSessions[msquicNativeCurSlot].serverLargestInitialRecv)
    if IsErr(ackRes):
        msquicNativeResultErrorScratch = ErrorText(ackRes)
        return false
    if msquicNativeDebugTls13:
        msquicNativeDebugWriteLine("msquic_native_debug server_ack_added")
    let ackPayloadRes: Result[rawbytes.Bytes] = msquicPacketPayloadEncode(ackPkt)
    if IsErr(ackPayloadRes):
        msquicNativeResultErrorScratch = ErrorText(ackPayloadRes)
        return false
    let ackPayload: rawbytes.Bytes = Value(ackPayloadRes)
    if msquicNativeDebugTls13:
        let ackPayloadDebugText: str = strutil.Join(["msquic_native_debug server_ack_payload_len=", IntToStr(BytesLen(ackPayload))], "")
        msquicNativeDebugWriteLine(ackPayloadDebugText)
    let sendAckRes: Result[bool] = msquicNativeSendPayload(
        msquicNativeServerSide,
        msquicNativePacketInitialCode,
        ackPacketNumber,
        ackPayload,
        false
    )
    if IsErr(sendAckRes):
        msquicNativeResultErrorScratch = ErrorText(sendAckRes)
        return false
    let ackCompletedAtMs: int64 = MsQuicNativeNowMs()

    let serverHelloStartedAtMs: int64 = MsQuicNativeNowMs()
    msquicNativeDebugWriteLine("msquic native debug: server hello seed")
    let serverRandomSeed: rawbytes.Bytes = msquicNativeSeededBytes(23)
    msquicNativeDebugWriteLine("msquic native debug: server hello build")
    let shRes: Result[rawbytes.Bytes] = handshake13.msquicTls13ServerBuildServerHello(serverRandomSeed, false)
    msquicNativeDebugWriteLine("msquic native debug: server hello build returned")
    if IsErr(shRes):
        msquicNativeResultErrorScratch = ErrorText(shRes)
        return false
    msquicNativeDebugWriteLine("msquic native debug: server hello value")
    let sh: rawbytes.Bytes = Value(shRes)
    if msquicNativeDebugTls13:
        msquicNativeDebugWriteLine(strutil.Join(["msquic native debug: server hello len=", IntToStr(BytesLen(sh))], ""))
    handshake13.msquicTls13ServerAppendTranscript(sh)
    handshake13.msquicTls13ServerEnsureAes128Cipher()
    let serverHelloCompletedAtMs: int64 = MsQuicNativeNowMs()
    let secretsStartedAtMs: int64 = MsQuicNativeNowMs()
    msquicNativeDebugWriteLine("msquic native debug: server secrets")
    let secRes: Result[bool] = handshake13.msquicTls13SideComputeHandshakeSecrets(1)
    if IsErr(secRes):
        msquicNativeResultErrorScratch = ErrorText(secRes)
        return false
    let secretsCompletedAtMs: int64 = MsQuicNativeNowMs()

    let encryptedExtensionsStartedAtMs: int64 = MsQuicNativeNowMs()
    let emptyExtensions: rawbytes.Bytes = emptyBytes()
    # Real server-preference ALPN negotiation: pick the first protocol in our
    # own supported set (serverAlpnSupportedCache) that the client also
    # offered (msquicTls13ServerPeerAlpn). No match is a hard handshake
    # failure -- never silently echo back a protocol the client didn't ask
    # for.
    let negotiatedAlpn: str = handshake13.msquicTls13NegotiateAlpn(
        handshake13.msquicTls13ServerPeerAlpn(),
        gMsQuicSessions[msquicNativeCurSlot].serverAlpnSupportedCache
    )
    if len(negotiatedAlpn) <= 0:
        msquicNativeResultErrorScratch = "tls13: no_application_protocol"
        return false
    let eeRes: Result[rawbytes.Bytes] = handshake13.msquicTls13BuildEncryptedExtensions(negotiatedAlpn, emptyExtensions)
    if IsErr(eeRes):
        msquicNativeResultErrorScratch = ErrorText(eeRes)
        return false
    let ee: rawbytes.Bytes = Value(eeRes)
    handshake13.msquicTls13ServerAppendTranscript(ee)
    let encryptedExtensionsCompletedAtMs: int64 = MsQuicNativeNowMs()

    if gMsQuicSessions[msquicNativeCurSlot].serverCertChainCountCache <= 0 || BytesLen(gMsQuicSessions[msquicNativeCurSlot].serverLeafDerCache) <= 0:
        msquicNativeResultErrorScratch = "msquic tls policy: leaf certificate missing"
        return false
    var certReq = emptyBytes()
    let certReqStartedAtMs: int64 = MsQuicNativeNowMs()
    if msquicNativeServerRequiresClientCertificate():
        let certReqRes: Result[rawbytes.Bytes] = handshake13.msquicTls13BuildCertificateRequest()
        if IsErr(certReqRes):
            msquicNativeResultErrorScratch = ErrorText(certReqRes)
            return false
        certReq = Value(certReqRes)
        handshake13.msquicTls13ServerAppendTranscript(certReq)
    let certReqCompletedAtMs: int64 = MsQuicNativeNowMs()
    let certChainStartedAtMs: int64 = MsQuicNativeNowMs()
    let certRes: Result[rawbytes.Bytes] = handshake13.msquicTls13BuildCertificateChain(
        gMsQuicSessions[msquicNativeCurSlot].serverCertChainCountCache,
        msquicNativeServerCertAtCache(0),
        msquicNativeServerCertAtCache(1),
        msquicNativeServerCertAtCache(2),
        msquicNativeServerCertAtCache(3)
    )
    if IsErr(certRes):
        msquicNativeResultErrorScratch = ErrorText(certRes)
        return false
    let cert: rawbytes.Bytes = Value(certRes)
    handshake13.msquicTls13ServerAppendTranscript(cert)
    let certChainCompletedAtMs: int64 = MsQuicNativeNowMs()

    if gMsQuicSessions[msquicNativeCurSlot].serverLeafKeyKindCache == 0 && BytesLen(gMsQuicSessions[msquicNativeCurSlot].serverPrivateKeyCache) == 32:
        gMsQuicSessions[msquicNativeCurSlot].serverLeafKeyKindCache = 2
    if msquicNativeDebugTls13:
        let keyKindText: str = strutil.Join(["msquic_native_debug server_leaf_key_kind=", IntToStr(gMsQuicSessions[msquicNativeCurSlot].serverLeafKeyKindCache)], "")
        msquicNativeDebugWriteLine(keyKindText)
    var serverLeafPublicKey: rawbytes.Bytes = emptyBytes()
    if gMsQuicSessions[msquicNativeCurSlot].serverLeafKeyKindCache == 2:
        var leafCert: x509.X509Certificate
        let leafParseRes: Result[bool] = x509.x509ParseCertificateInto(leafCert, gMsQuicSessions[msquicNativeCurSlot].serverLeafDerCache)
        if IsErr(leafParseRes):
            msquicNativeDebugWriteLine("msquic_native_debug flight_fail=leaf_parse")
            msquicNativeResultErrorScratch = ErrorText(leafParseRes)
            return false
        serverLeafPublicKey = leafCert.publicKey.ecdsaBytes
    let certVerifyStartedAtMs: int64 = MsQuicNativeNowMs()
    let cvRes: Result[rawbytes.Bytes] = handshake13.msquicTls13ServerBuildCertificateVerifyCodeWithPublic(
        gMsQuicSessions[msquicNativeCurSlot].serverLeafKeyKindCache,
        serverLeafPublicKey,
        gMsQuicSessions[msquicNativeCurSlot].serverPrivateKeyCache,
        true
    )
    if IsErr(cvRes):
        msquicNativeDebugWriteLine("msquic_native_debug flight_fail=cert_verify")
        msquicNativeResultErrorScratch = ErrorText(cvRes)
        return false
    let cv: rawbytes.Bytes = Value(cvRes)
    handshake13.msquicTls13ServerAppendTranscript(cv)
    let certVerifyCompletedAtMs: int64 = MsQuicNativeNowMs()

    let finishedStartedAtMs: int64 = MsQuicNativeNowMs()
    let finRes: Result[rawbytes.Bytes] = handshake13.msquicTls13ServerBuildFinished(true)
    if IsErr(finRes):
        msquicNativeDebugWriteLine("msquic_native_debug flight_fail=finished")
        msquicNativeResultErrorScratch = ErrorText(finRes)
        return false
    let fin: rawbytes.Bytes = Value(finRes)
    if msquicNativeDebugTls13:
        let serverFinishedText: str = strutil.Join(["msquic_native_debug server_finished=", BytesToHex(msquicCloneBytes(fin))], "")
        msquicNativeDebugWriteLine(serverFinishedText)
    handshake13.msquicTls13ServerAppendTranscript(fin)
    let finishedCompletedAtMs: int64 = MsQuicNativeNowMs()

    let packetStartedAtMs: int64 = MsQuicNativeNowMs()
    # Owned concat chain instead of the bytebuffer's in-place read-modify-write
    # (its internal store published no exact definition, so every following
    # AppendBytes read a stale carrier).
    var cryptoBytes: rawbytes.Bytes = BytesConcat3(msquicCloneBytes(sh), msquicCloneBytes(ee), emptyBytes())
    if BytesLen(certReq) > 0:
        cryptoBytes = BytesConcat3(cryptoBytes, msquicCloneBytes(certReq), emptyBytes())
    cryptoBytes = BytesConcat3(cryptoBytes, msquicCloneBytes(cert), emptyBytes())
    cryptoBytes = BytesConcat3(cryptoBytes, msquicCloneBytes(cv), emptyBytes())
    cryptoBytes = BytesConcat3(cryptoBytes, msquicCloneBytes(fin), emptyBytes())

    var pkt: packet_model.MsQuicPacket
    let packetNumber: int64 = msquicNativeNextPacketNumber(msquicNativeServerSide, msquicNativePacketHandshakeCode)
    msquicPacketReset(pkt, packetNumber)
    let addCryptoRes: Result[bool] = msquicNativePacketAddCryptoFrame(pkt, 0, cryptoBytes)
    if IsErr(addCryptoRes):
        msquicNativeResultErrorScratch = ErrorText(addCryptoRes)
        return false
    let payloadRes: Result[rawbytes.Bytes] = msquicPacketPayloadEncode(pkt)
    if IsErr(payloadRes):
        msquicNativeResultErrorScratch = ErrorText(payloadRes)
        return false
    let sendRes: Result[bool] = msquicNativeSendPayload(
        msquicNativeServerSide,
        msquicNativePacketHandshakeCode,
        packetNumber,
        Value(payloadRes),
        true
    )
    if IsErr(sendRes):
        msquicNativeResultErrorScratch = ErrorText(sendRes)
        return false
    let packetCompletedAtMs: int64 = MsQuicNativeNowMs()
    gMsQuicSessions[msquicNativeCurSlot].serverFlightSent = true
    let flightCompletedAtMs: int64 = MsQuicNativeNowMs()
    if msquicNativeDebugTls13:
        var timingText: str = "msquic_native_server_flight_timing_ms keygen="
        timingText = strutil.Join([ share(timingText), int64ToStr(keygenCompletedAtMs - keygenStartedAtMs)], "")
        timingText = strutil.Join([ share(timingText), " ack="], "")
        timingText = strutil.Join([ share(timingText), int64ToStr(ackCompletedAtMs - ackStartedAtMs)], "")
        timingText = strutil.Join([ share(timingText), " server_hello="], "")
        timingText = strutil.Join([ share(timingText), int64ToStr(serverHelloCompletedAtMs - serverHelloStartedAtMs)], "")
        timingText = strutil.Join([ share(timingText), " secrets="], "")
        timingText = strutil.Join([ share(timingText), int64ToStr(secretsCompletedAtMs - secretsStartedAtMs)], "")
        timingText = strutil.Join([ share(timingText), " encrypted_extensions="], "")
        timingText = strutil.Join([ share(timingText), int64ToStr(encryptedExtensionsCompletedAtMs - encryptedExtensionsStartedAtMs)], "")
        timingText = strutil.Join([ share(timingText), " cert_req="], "")
        timingText = strutil.Join([ share(timingText), int64ToStr(certReqCompletedAtMs - certReqStartedAtMs)], "")
        timingText = strutil.Join([ share(timingText), " cert_chain="], "")
        timingText = strutil.Join([ share(timingText), int64ToStr(certChainCompletedAtMs - certChainStartedAtMs)], "")
        timingText = strutil.Join([ share(timingText), " cert_verify="], "")
        timingText = strutil.Join([ share(timingText), int64ToStr(certVerifyCompletedAtMs - certVerifyStartedAtMs)], "")
        timingText = strutil.Join([ share(timingText), " finished="], "")
        timingText = strutil.Join([ share(timingText), int64ToStr(finishedCompletedAtMs - finishedStartedAtMs)], "")
        timingText = strutil.Join([ share(timingText), " packet_send="], "")
        timingText = strutil.Join([ share(timingText), int64ToStr(packetCompletedAtMs - packetStartedAtMs)], "")
        timingText = strutil.Join([ share(timingText), " total="], "")
        timingText = strutil.Join([ share(timingText), int64ToStr(flightCompletedAtMs - flightStartedAtMs)], "")
        msquicNativeDebugWriteLine(timingText)
    return true

fn msquicNativeSendServerFlight(): Result[bool] =
    let ok: bool = msquicNativeSendServerFlightFill()
    if ! ok:
        return Err[bool](msquicNativeResultErrorScratch)
    return Ok[bool](true)

fn msquicNativeSendClientFinishedFill(): bool =
    msquicNativeResetResultScratch()
    let alreadySent: bool = gMsQuicSessions[msquicNativeCurSlot].clientFinishedSent
    if alreadySent:
        return true
    var crypto: bytebuffer.GrowByteBuffer = bytebuffer.NewByteBuffer()
    if handshake13.msquicTls13ClientPeerRequestedCertificate():
        if !gMsQuicSessions[msquicNativeCurSlot].clientSendCertificateCache:
            msquicNativeResultErrorScratch = "msquic tls policy: peer requested client certificate but client_cert_mode is off"
            return false
        if gMsQuicSessions[msquicNativeCurSlot].clientCertChainCountCache <= 0 || BytesLen(msquicNativeClientCertAtCache(0)) <= 0:
            msquicNativeResultErrorScratch = "msquic tls policy: client certificate missing"
            return false
        if BytesLen(gMsQuicSessions[msquicNativeCurSlot].clientPrivateKeyCache) <= 0:
            msquicNativeResultErrorScratch = "msquic tls policy: client private key missing"
            return false
        let certRes: Result[rawbytes.Bytes] = handshake13.msquicTls13BuildCertificateChain(
            gMsQuicSessions[msquicNativeCurSlot].clientCertChainCountCache,
            msquicNativeClientCertAtCache(0),
            msquicNativeClientCertAtCache(1),
            msquicNativeClientCertAtCache(2),
            msquicNativeClientCertAtCache(3)
        )
        if IsErr(certRes):
            msquicNativeResultErrorScratch = ErrorText(certRes)
            return false
        let cert: rawbytes.Bytes = Value(certRes)
        handshake13.msquicTls13ClientAppendTranscript(cert)
        bytebuffer.AppendBytes(crypto, cert)
        let cvRes: Result[rawbytes.Bytes] = handshake13.msquicTls13ClientBuildCertificateVerifyCode(gMsQuicSessions[msquicNativeCurSlot].clientLeafKeyKindCache,
                                                                           gMsQuicSessions[msquicNativeCurSlot].clientPrivateKeyCache,
                                                                           false)
        if IsErr(cvRes):
            msquicNativeResultErrorScratch = ErrorText(cvRes)
            return false
        let cv: rawbytes.Bytes = Value(cvRes)
        handshake13.msquicTls13ClientAppendTranscript(cv)
        bytebuffer.AppendBytes(crypto, cv)
    let finRes: Result[rawbytes.Bytes] = handshake13.msquicTls13ClientBuildFinished(false)
    if IsErr(finRes):
        msquicNativeResultErrorScratch = ErrorText(finRes)
        return false
    let fin: rawbytes.Bytes = Value(finRes)
    if msquicNativeDebugTls13:
        let clientFinishedText: str = strutil.Join(["msquic_native_debug client_finished=", BytesToHex(fin)], "")
        msquicNativeDebugWriteLine(clientFinishedText)
    bytebuffer.AppendBytes(crypto, fin)
    var pkt: packet_model.MsQuicPacket
    let packetNumber: int64 = msquicNativeNextPacketNumber(msquicNativeClientSide, msquicNativePacketHandshakeCode)
    msquicPacketReset(pkt, packetNumber)
    if gMsQuicSessions[msquicNativeCurSlot].clientLargestHandshakeRecv > 0:
        let ackRes: Result[bool] = msquicNativePacketAddAckFrame(pkt, gMsQuicSessions[msquicNativeCurSlot].clientLargestHandshakeRecv)
        if IsErr(ackRes):
            msquicNativeResultErrorScratch = ErrorText(ackRes)
            return false
    let addRes: Result[bool] = msquicNativePacketAddCryptoFrame(pkt, 0, bytebuffer.ToBytes(crypto))
    if IsErr(addRes):
        msquicNativeResultErrorScratch = ErrorText(addRes)
        return false
    let payloadRes: Result[rawbytes.Bytes] = msquicPacketPayloadEncode(pkt)
    if IsErr(payloadRes):
        msquicNativeResultErrorScratch = ErrorText(payloadRes)
        return false
    let sendRes: Result[bool] = msquicNativeSendPayload(
        msquicNativeClientSide,
        msquicNativePacketHandshakeCode,
        packetNumber,
        Value(payloadRes),
        true
    )
    if IsErr(sendRes):
        msquicNativeResultErrorScratch = ErrorText(sendRes)
        return false
    handshake13.msquicTls13ClientAppendTranscript(fin)
    gMsQuicSessions[msquicNativeCurSlot].clientReady = 1
    gMsQuicSessions[msquicNativeCurSlot].clientFinishedSent = true
    return true

fn msquicNativeSendClientFinished(): Result[bool] =
    let ok: bool = msquicNativeSendClientFinishedFill()
    if ! ok:
        return Err[bool](msquicNativeResultErrorScratch)
    return Ok[bool](true)

fn msquicNativeFlushPendingClientFinished(): Result[bool] =
    if !gMsQuicSessions[msquicNativeCurSlot].clientFinishedReadyPending:
        return Ok[bool](false)
    if gMsQuicSessions[msquicNativeCurSlot].clientFinishedSent:
        gMsQuicSessions[msquicNativeCurSlot].clientFinishedReadyPending = false
        return Ok[bool](true)
    if !handshake13.msquicTls13ClientFinishedOk():
        return Ok[bool](false)
    let finRes: Result[bool] = msquicNativeSendClientFinished()
    if IsErr(finRes):
        return Err[bool](ErrorText(finRes))
    gMsQuicSessions[msquicNativeCurSlot].clientFinishedReadyPending = false
    return Ok[bool](true)

# Queue HANDSHAKE_DONE on the server connection's frame queue so it rides the
# normal short-packet flush path: it is recorded in the retransmit window
# (RecordSentParts) and re-sent on RTO until the client ACKs it, then dropped on
# ack. This replaces the old direct-send + permanent alreadySent guard, which
# made DONE non-retransmittable: if the carrying short packet was lost on the
# real UDP path the client would retransmit ClientFinished forever while the
# server refused to re-send DONE. We also re-queue a fresh DONE on each duplicate
# ClientFinished (which only keeps arriving while the client has not yet seen
# DONE) when none is still outstanding, as an accelerator on top of the RTO
# retransmit; once the client ACKs DONE the queued copy drains and re-arrival of
# duplicate ClientFinished stops.
fn msquicNativeSendServerHandshakeDoneFill(): bool =
    msquicNativeResetResultScratch()
    # Skip if a DONE we already queued is still outstanding in the retransmit
    # window (the RTO timer in msquicNativePumpServerShortRetransmit will re-send
    # it on loss). Only queue a fresh DONE when none is in flight, i.e. the first
    # time or after the previous DONE was acked/pruned.
    if gMsQuicSessions[msquicNativeCurSlot].serverHandshakeDoneOutstanding &&
       connection_impl.MsQuicConnImplSentCount(msquicNativeServerImpl[msquicNativeCurSlot]) > 0:
        return true
    let queueRes: Result[bool] = connection_impl.MsQuicConnImplQueueFrameParts(
        msquicNativeServerImpl[msquicNativeCurSlot],
        int64(msquicNativeFrameHandshakeDoneCode),
        0,
        0,
        0,
        emptyBytes()
    )
    if IsErr(queueRes):
        msquicNativeResultErrorScratch = ErrorText(queueRes)
        return false
    gMsQuicSessions[msquicNativeCurSlot].serverHandshakeDoneSent = true
    gMsQuicSessions[msquicNativeCurSlot].serverHandshakeDoneOutstanding = true
    if msquicNativeDebugTls13:
        msquicNativeDebugWriteLine("msquic_native_debug server_handshake_done_resend")
    let flushRes: Result[bool] = msquicNativeFlushServerShortPackets()
    if IsErr(flushRes):
        msquicNativeResultErrorScratch = ErrorText(flushRes)
        return false
    return true

fn msquicNativeSendServerHandshakeDone(): Result[bool] =
    let ok: bool = msquicNativeSendServerHandshakeDoneFill()
    if ! ok:
        return Err[bool](msquicNativeResultErrorScratch)
    return Ok[bool](true)

fn msquicNativeSessionReady(): bool =
    if ! gMsQuicSessions[msquicNativeCurSlot].active:
        return false
    if gMsQuicSessions[msquicNativeCurSlot].closed:
        return false
    if msquicNativeLocalRole == msquicNativeRoleClient:
        return gMsQuicSessions[msquicNativeCurSlot].clientReady > 0
    if msquicNativeLocalRole == msquicNativeRoleServer:
        return gMsQuicSessions[msquicNativeCurSlot].serverReady > 0
    return false

fn msquicNativeSideReady(side: int32): bool =
    if ! gMsQuicSessions[msquicNativeCurSlot].active:
        return false
    if gMsQuicSessions[msquicNativeCurSlot].closed:
        return false
    if side == msquicNativeClientSide:
        return gMsQuicSessions[msquicNativeCurSlot].clientReady > 0
    if side == msquicNativeServerSide:
        return gMsQuicSessions[msquicNativeCurSlot].serverReady > 0
    return false

fn msquicNativeQueueAcceptIfReady() =
    if msquicNativeDebugTls13:
        var msg = "msquic_native_debug queue_accept listener="
        if msquicNativeListenerRunning:
            msg = strutil.Join([ share(msg), "true"], "")
        else:
            msg = strutil.Join([ share(msg), "false"], "")
        msg = strutil.Join([ share(msg), " active="], "")
        if gMsQuicSessions[msquicNativeCurSlot].active:
            msg = strutil.Join([ share(msg), "true"], "")
        else:
            msg = strutil.Join([ share(msg), "false"], "")
        msg = strutil.Join([ share(msg), " closed="], "")
        if gMsQuicSessions[msquicNativeCurSlot].closed:
            msg = strutil.Join([ share(msg), "true"], "")
        else:
            msg = strutil.Join([ share(msg), "false"], "")
        msg = strutil.Join([ share(msg), " ready="], "")
        if gMsQuicSessions[msquicNativeCurSlot].serverReady > 0:
            msg = strutil.Join([ share(msg), "true"], "")
        else:
            msg = strutil.Join([ share(msg), "false"], "")
        os.WriteLine(os.Get_stderr(), msg)
    if ! msquicNativeListenerRunning:
        return
    if ! gMsQuicSessions[msquicNativeCurSlot].active:
        return
    if gMsQuicSessions[msquicNativeCurSlot].closed:
        return
    if gMsQuicSessions[msquicNativeCurSlot].serverReady > 0:
        msquicNativeAcceptPending = true
        if msquicNativeDebugTls13:
            msquicNativeDebugWriteLine("msquic_native_debug accept_pending=true")

fn msquicNativeAcceptReady(): bool =
    if !msquicNativeListenerRunning:
        return false
    if !gMsQuicSessions[msquicNativeCurSlot].active:
        return false
    if gMsQuicSessions[msquicNativeCurSlot].closed:
        return false
    return msquicNativeAcceptPending

fn msquicNativeDialReadyForReturn(): bool =
    if ! msquicNativeSessionReady():
        return false
    if ! msquicNativeListenerRunning:
        return true
    if gMsQuicSessions[msquicNativeCurSlot].serverReady <= 0:
        return false
    msquicNativeQueueAcceptIfReady()
    return msquicNativeAcceptReady()

@borrows
fn msquicNativeInitServerSession(fromAddr: str, header: packet_header_model.QuicPacketHeader): Result[bool] =
    let stableFromAddr: str = msquicNativeStableString(fromAddr)
    msquicNativeDebugWriteLine("msquic native debug: init server enter")
    if msquicNativeListenerRunning && msquicNativeListenerDatapathId > 0 && msquicNativeSessionClientDatapathId <= 0:
        msquicNativeResetServerHandshakeAttempt()
    elif msquicNativeSessionClientDatapathId <= 0:
        msquicNativeResetSession()
    msquicNativeDebugWriteLine("msquic native debug: init server after reset")
    gMsQuicSessions[msquicNativeCurSlot].active = true
    gMsQuicSessions[msquicNativeCurSlot].closed = false
    if msquicNativeLocalRole == msquicNativeRoleNone:
        msquicNativeLocalRole = msquicNativeRoleServer
    msquicNativeSetSessionListenAddr(msquicNativeListenAddr)
    msquicNativeDebugWriteLine("msquic native debug: init server parse peer")
    let peerAddrRes = parseMultiAddress(strings.CloneStr(stableFromAddr))
    if IsOk(peerAddrRes):
        let peerAddr: multiaddress.MultiAddress = Value(peerAddrRes)
        msquicNativeSetSessionDialAddr(peerAddr)
    else:
        let emptyAddr: multiaddress.MultiAddress = MsQuicNativeEmptyAddr()
        msquicNativeSetSessionDialAddr(emptyAddr)
    msquicNativeDebugWriteLine("msquic native debug: init server policy")
    var serverSettingsLocal = msquicNativeListenerSettings
    msquicNativeSetServerPolicyCache(msquicNativeListenerTlsPolicy)
    gMsQuicSessions[msquicNativeCurSlot].listenerDatapathId = msquicNativeListenerDatapathId
    gMsQuicSessions[msquicNativeCurSlot].listenerAddrText = datapath_runtime.MsQuicDatapathGlobalUdpAddr(msquicNativeListenerDatapathId)
    gMsQuicSessions[msquicNativeCurSlot].clientAddrText = stableFromAddr
    msquicNativeDebugWriteLine("msquic native debug: init server cids")
    gMsQuicSessions[msquicNativeCurSlot].clientCidCache = msquicNativeCopyBytes(header.scid)
    gMsQuicSessions[msquicNativeCurSlot].serverCidCache = msquicNativeCopyBytes(header.dcid)
    msquicNativeDebugWriteLine("msquic native debug: init server endpoint")
    let requireClientCert: bool = msquicNativeServerRequiresClientCertificate()
    msquicNativeResetServerEndpoint(serverSettingsLocal, requireClientCert)
    msquicNativeDebugWriteLine("msquic native debug: init server roots")
    handshake13.msquicTls13ServerClearTrustRoots()
    for i in 0..<gMsQuicSessions[msquicNativeCurSlot].serverTrustRootsCountCache:
        let addRes: Result[bool] = handshake13.msquicTls13ServerAddTrustRoot(msquicNativeServerTrustRootAtCache(i))
        if IsErr(addRes):
            return Err[bool](ErrorText(addRes))
    gMsQuicSessions[msquicNativeCurSlot].serverBound = true
    msquicNativeSessionListenerDatapathId = msquicNativeListenerDatapathId
    msquicNativeDebugWriteLine("msquic native debug: init server done")
    return Ok[bool](true)

fn msquicNativeHandleAppFrameParts(recvSide: int32,
                                   frameKind: int32,
                                   streamId: int64,
                                   offset: int64,
                                   value: int64,
                                   data: rawbytes.Bytes): Result[bool] =
    if msquicNativeFrameCodeEquals(frameKind, msquicNativeFrameAckCode):
        if recvSide == msquicNativeClientSide:
            connection_impl.MsQuicConnImplAckSack(msquicNativeClientImpl[msquicNativeCurSlot], value, data, 0)
        else:
            connection_impl.MsQuicConnImplAckSack(msquicNativeServerImpl[msquicNativeCurSlot], value, data, 0)
        return Ok[bool](true)
    if msquicNativeFrameCodeEquals(frameKind, msquicNativeFrameDataCode) ||
       msquicNativeFrameCodeEquals(frameKind, msquicNativeFrameDataFinCode):
        if msquicNativeDebugTls13:
            var msg = "msquic_native_debug data_frame side="
            if recvSide == msquicNativeClientSide:
                msg = strutil.Join([ share(msg), "client"], "")
            else:
                msg = strutil.Join([ share(msg), "server"], "")
            msg = strutil.Join([ share(msg), " stream=", int64ToStr(streamId)], "")
            msg = strutil.Join([ share(msg), " len=", IntToStr(BytesLen(data))], "")
            msg = strutil.Join([ share(msg), " offset=", int64ToStr(offset)], "")
            if msquicNativeFrameCodeEquals(frameKind, msquicNativeFrameDataFinCode):
                msg = strutil.Join([ share(msg), " fin=true"], "")
            os.WriteLine(os.Get_stderr(), msg)
        let addRes: Result[bool] = msquicNativeAppRecvAdd(recvSide, streamId, offset, data)
        if IsErr(addRes):
            return Err[bool](ErrorText(addRes))
        if msquicNativeFrameCodeEquals(frameKind, msquicNativeFrameDataFinCode):
            let finRes: Result[bool] = msquicNativeAppRecvMarkFin(recvSide,
                                                                  streamId,
                                                                  offset + int64(BytesLen(data)))
            if IsErr(finRes):
                return Err[bool](ErrorText(finRes))
        return Ok[bool](true)
    if msquicNativeFrameCodeEquals(frameKind, msquicNativeFrameDatagramCode):
        if recvSide == msquicNativeClientSide:
            return msquicNativeEnqueueDatagram(msquicNativeClientSide, data)
        return msquicNativeEnqueueDatagram(msquicNativeServerSide, data)
    if msquicNativeFrameCodeEquals(frameKind, msquicNativeFrameMaxDataCode):
        if recvSide == msquicNativeClientSide:
            connection_impl.MsQuicConnImplUpdateMaxData(msquicNativeClientImpl[msquicNativeCurSlot], value)
        else:
            connection_impl.MsQuicConnImplUpdateMaxData(msquicNativeServerImpl[msquicNativeCurSlot], value)
        return Ok[bool](true)
    if msquicNativeFrameCodeEquals(frameKind, msquicNativeFrameMaxStreamDataCode):
        if recvSide == msquicNativeClientSide:
            connection_impl.MsQuicConnImplRaiseMaxStreamData(msquicNativeClientImpl[msquicNativeCurSlot], value)
        else:
            connection_impl.MsQuicConnImplRaiseMaxStreamData(msquicNativeServerImpl[msquicNativeCurSlot], value)
        return Ok[bool](true)
    if msquicNativeFrameCodeEquals(frameKind, msquicNativeFrameHandshakeDoneCode):
        if recvSide == msquicNativeClientSide:
            gMsQuicSessions[msquicNativeCurSlot].clientHandshakePendingActive = false
            if msquicNativeDebugTls13:
                msquicNativeDebugWriteLine("msquic_native_debug client_handshake_done")
        return Ok[bool](true)
    if msquicNativeFrameCodeEquals(frameKind, msquicNativeFramePingCode):
        return Ok[bool](true)
    if msquicNativeFrameCodeEquals(frameKind, msquicNativeFrameConnectionCloseCode) ||
       msquicNativeFrameCodeEquals(frameKind, msquicNativeFrameConnectionCloseAppCode):
        gMsQuicSessions[msquicNativeCurSlot].closed = true
        return Ok[bool](true)
    return Ok[bool](true)

fn msquicNativeHandleAppPayloadFrame(recvSide: int32,
                                     payload: rawbytes.Bytes,
                                     offsetIn: int32,
                                     clientReadyNow: var bool,
                                     ackElicitingNow: var bool): Result[int32] =
    var frameKindValue: int64
    var afterKind: int32
    if msquicNativeVarintDecodeCode(payload, offsetIn, frameKindValue, afterKind) <= 0:
        return Err[int32]("msquic payload: frame kind decode failed")
    let frameKind: int32 = int32(frameKindValue)
    # RFC 9000 §19.3/§19.2: PADDING(0)/PING(1) carry no fields beyond the
    # 1-byte type. A real peer's 1-RTT keepalive PING (or a padding run)
    # walked into the 5-field decode below and rejected the whole short
    # packet -- same family as the Initial/Handshake-space fix in
    # msquicNativeProcessCryptoPayloadFrames et al. (d1190e1f4), just never
    # applied to this 1-RTT/Short path. PADDING is not ack-eliciting; PING
    # is (msquicNativeFrameAckEliciting's default branch already covers it,
    # this just has to actually reach it instead of erroring out first).
    if frameKind == msquicNativeFramePaddingCode:
        return Ok[int32](afterKind)
    if frameKind == msquicNativeFramePingCode:
        ackElicitingNow = true
        return Ok[int32](afterKind)
    var streamValue: int64
    var next: int32
    if msquicNativeVarintDecodeCode(payload, afterKind, streamValue, next) <= 0:
        return Err[int32]("msquic payload: frame stream decode failed")
    var offValue: int64
    if msquicNativeVarintDecodeCode(payload, next, offValue, next) <= 0:
        return Err[int32]("msquic payload: frame offset decode failed")
    var valueValue: int64
    if msquicNativeVarintDecodeCode(payload, next, valueValue, next) <= 0:
        return Err[int32]("msquic payload: frame value decode failed")
    var dataLenValue: int64
    if msquicNativeVarintDecodeCode(payload, next, dataLenValue, next) <= 0:
        return Err[int32]("msquic payload: frame len decode failed")
    let dataLen: int32 = int32(dataLenValue)
    if dataLen < 0:
        return Err[int32]("msquic payload: negative frame length")
    let dataStart: int32 = next
    let nextOffset: int32 = dataStart + dataLen
    if nextOffset > BytesLen(payload):
        return Err[int32]("msquic payload: frame data truncated")
    let frameData: rawbytes.Bytes = if dataLen > 0: BytesSlice(payload, dataStart, dataLen) else: emptyBytes()
    if msquicNativeFrameAckEliciting(int64(frameKind)):
        ackElicitingNow = true
    if recvSide == msquicNativeClientSide &&
       msquicNativeFrameCodeEquals(frameKind, msquicNativeFrameHandshakeDoneCode):
        clientReadyNow = true
    let frameRes: Result[bool] = msquicNativeHandleAppFrameParts(recvSide,
                                                                 frameKind,
                                                                 streamValue,
                                                                 offValue,
                                                                 valueValue,
                                                                 frameData)
    if IsErr(frameRes):
        return Err[int32](ErrorText(frameRes))
    return Ok[int32](nextOffset)

fn msquicNativeProcessCryptoPayloadFrames(recvSide: int32,
                                          packetTypeCode: int32,
                                          payload: rawbytes.Bytes,
                                          cryptoBytesSeen: var int32,
                                          firstFrameKind: var int64,
                                          firstFrameLen: var int32): Result[int32] =
    var frameOffset: int32
    var frameIndex: int32
    while frameOffset < BytesLen(payload):
        var frameKindValue: int64
        var afterKind: int32
        if msquicNativeVarintDecodeCode(payload, frameOffset, frameKindValue, afterKind) <= 0:
            return Err[int32]("msquic payload: frame kind decode failed")
        let frameKind: int32 = int32(frameKindValue)
        if frameIndex == 0:
            firstFrameKind = int64(frameKind)
        # RFC 9000 §19.3/§19.2: PADDING and PING carry no fields at all (just the
        # 1-byte type). A real Initial datagram from an independent QUIC stack is
        # padded with runs of PADDING to the 1200-byte §14.1 minimum; decoding
        # them via the CRYPTO-shaped 5-field layout below walked past the buffer
        # and rejected the whole packet.
        if frameKind == msquicNativeFramePaddingCode || frameKind == msquicNativeFramePingCode:
            if frameIndex == 0:
                firstFrameLen = 0
            frameIndex = frameIndex + 1
            frameOffset = afterKind
            continue
        var streamValue: int64
        var next: int32
        if msquicNativeVarintDecodeCode(payload, afterKind, streamValue, next) <= 0:
            return Err[int32]("msquic payload: frame stream decode failed")
        var offValue: int64
        if msquicNativeVarintDecodeCode(payload, next, offValue, next) <= 0:
            return Err[int32]("msquic payload: frame offset decode failed")
        var valueValue: int64
        if msquicNativeVarintDecodeCode(payload, next, valueValue, next) <= 0:
            return Err[int32]("msquic payload: frame value decode failed")
        var dataLenValue: int64
        if msquicNativeVarintDecodeCode(payload, next, dataLenValue, next) <= 0:
            return Err[int32]("msquic payload: frame len decode failed")
        let dataLen: int32 = int32(dataLenValue)
        if dataLen < 0:
            return Err[int32]("msquic payload: negative frame length")
        let dataStart: int32 = next
        let nextOffset: int32 = dataStart + dataLen
        if nextOffset > BytesLen(payload):
            return Err[int32]("msquic payload: frame data truncated")
        if nextOffset <= frameOffset:
            return Err[int32]("msquic payload: frame cursor stalled")
        if frameIndex == 0:
            firstFrameLen = dataLen
        if msquicNativeIsCryptoFrameCode(frameKind):
            let frameData: rawbytes.Bytes = if dataLen > 0: BytesSlice(payload, dataStart, dataLen) else: emptyBytes()
            cryptoBytesSeen = cryptoBytesSeen + dataLen
            if msquicNativeDebugTls13:
                msquicNativeDebugWriteLine(strutil.Join(["msquic native debug: crypto frame len=", IntToStr(dataLen)], ""))
            let feedRes: Result[bool] = msquicNativeHandleCryptoData(recvSide, packetTypeCode, offValue, frameData)
            if IsErr(feedRes):
                return Err[int32](ErrorText(feedRes))
        # Any other kind (e.g. ACK, legitimately sent alongside CRYPTO in this
        # codebase's own Handshake-space flights) decodes fine through this
        # 5-field shape -- every frame kind this codebase's own peer emits
        # uses it uniformly -- it is just not acted on by this CRYPTO-only
        # loop, same as before this fix.
        frameIndex = frameIndex + 1
        frameOffset = nextOffset
    return Ok[int32](frameIndex)

@borrows
fn msquicNativeAppPayloadDecodeErrorIsDrop(err: str): bool =
    if err == "msquic payload: frame kind decode failed":
        return true
    if err == "msquic payload: frame stream decode failed":
        return true
    if err == "msquic payload: frame offset decode failed":
        return true
    if err == "msquic payload: frame value decode failed":
        return true
    if err == "msquic payload: frame len decode failed":
        return true
    if err == "msquic payload: negative frame length":
        return true
    if err == "msquic payload: frame data truncated":
        return true
    return false

fn msquicNativePacketDecodeErrorIsDrop(err: str): bool =
    if msquicNativeAppPayloadDecodeErrorIsDrop(err):
        return true
    if err == "msquic packet: frame kind decode failed":
        return true
    if err == "msquic packet: frame stream decode failed":
        return true
    if err == "msquic packet: frame offset decode failed":
        return true
    if err == "msquic packet: frame value decode failed":
        return true
    if err == "msquic packet: frame len decode failed":
        return true
    if err == "msquic packet: negative frame length":
        return true
    if err == "msquic packet: frame data truncated":
        return true
    if err == "msquic native: negative payload length":
        return true
    if err == "msquic native: initial payload truncated":
        return true
    if err == "msquic native: initial frame data truncated":
        return true
    if err == "msquic native: handshake frame data truncated":
        return true
    if err == "msquic native: server handshake frame data truncated":
        return true
    return false

@borrows
# ProcessPacketFill 加锁外壳 = 「server 半环 slot 显式锚定」的执行点: 路由
# (ServerCid→cur) → 填 policy cache → ALPN/EE/证书 → flight 发送整段对另一
# 线程独占，dual-role 下 T_FETCH 的 pump/dial 无法再把 cur 翻走导致读空
# serverAlpnSupportedCache（tls13: no_application_protocol 根因）。
fn msquicNativeProcessPacketFill(
    recvSide: int32,
    fromAddr: str,
    wire: rawbytes.Bytes
): bool =
    MsQuicNativeTransportLock()
    let ok: bool = msquicNativeProcessPacketFillUnlocked(recvSide, fromAddr, wire)
    MsQuicNativeTransportUnlock()
    return ok

fn msquicNativeProcessPacketFillUnlocked(
    recvSide: int32,
    fromAddr: str,
    wire: rawbytes.Bytes
): bool =
    let stableFromAddr: str = msquicNativeStableString(fromAddr)
    msquicNativeResetResultScratch()
    if BytesLen(wire) <= 0:
        return true
    let preFirstByte: int32 = BytesGet(wire, 0)
    if recvSide == msquicNativeClientSide && preFirstByte >= 128:
        let preTypeBits: int32 = (preFirstByte / 16) % 4
        if preTypeBits == 0:
            return true
    let inputWireLen: int32 = BytesLen(wire)
    if msquicNativeDebugTls13:
        msquicNativeDebugWriteLine(strutil.Join(["msquic native debug: process packet side=", IntToStr(recvSide), " wire_len=", IntToStr(inputWireLen)], ""))
    if inputWireLen < 2:
        if msquicNativeDebugTls13:
            msquicNativeDebugWriteLine(strutil.Join(["msquic native debug: drop malformed packet len=", IntToStr(inputWireLen)], ""))
        return true
    let headerRes = quicPacketHeaderDecode(wire, msquicNativeConnIdLen)
    if IsErr(headerRes):
        msquicNativeDebugWriteLine("msquic native debug: drop malformed packet header")
        return true
    let headerDec = Value(headerRes)
    let firstPacketByte: int32 = if BytesLen(wire) > 0: BytesGet(wire, 0) else: 0
    var packetTypeCode: int32 = msquicNativePacketShortCode
    if firstPacketByte >= 128:
        let firstTypeBits: int32 = (firstPacketByte / 16) % 4
        if firstTypeBits == 0:
            packetTypeCode = msquicNativePacketInitialCode
        elif firstTypeBits == 1:
            packetTypeCode = msquicNativePacket0RttCode
        elif firstTypeBits == 2:
            packetTypeCode = msquicNativePacketHandshakeCode
        else:
            packetTypeCode = msquicNativePacketRetryCode
    if msquicNativeDebugTls13:
        msquicNativeDebugWriteLine(strutil.Join(["msquic native debug: packet type=", IntToStr(packetTypeCode), " payload_next=", IntToStr(headerDec.next)], ""))
    if recvSide == msquicNativeServerSide:
        # Multi-slot server routing: every inbound server packet carries dcid =
        # the per-slot server CID (ConnId(572662306+slot)), which is stable for the
        # whole connection in this static-CID scheme. Bind curSlot to the slot that
        # owns this dcid before any per-slot state is read/written below. For an
        # Initial whose dcid matches no active slot (a brand-new connection) a free
        # slot is taken so the handshake starts fresh; non-Initial packets that miss
        # are left on the current slot (they will be rejected by the active/closed
        # guards as before). N=1: first Initial finds no match -> FindFree -> slot 0,
        # every later packet (Initial/Handshake/Short) matches slot 0 by dcid, so
        # curSlot stays 0 and the path is bit-identical to the single-slot baseline.
        let routedSlot: int32 = msquicNativeSlotFindByServerCid(headerDec.header.dcid)
        if routedSlot >= 0:
            msquicNativeCurSlot = routedSlot
            # server 路由即锚定（本锁壳内, 原子）: accept 尾写之前的首个
            # server flight 发送也依赖 SendWire 角色锚点取址, 锚点必须先于
            # flight 存在。
            msquicNativeLastServerSessionSlot = routedSlot
        elif packetTypeCode == msquicNativePacketInitialCode:
            let freeServerSlot: int32 = msquicNativeSlotFindFree()
            if freeServerSlot >= 0:
                msquicNativeCurSlot = freeServerSlot
                msquicNativeLastServerSessionSlot = freeServerSlot
        else:
            return true
        if packetTypeCode == msquicNativePacketInitialCode:
            let initialPayloadOffset: int32 = headerDec.next
            let initialPayloadLen: int32 = BytesLen(wire) - initialPayloadOffset
            if initialPayloadLen < 0 || initialPayloadOffset > BytesLen(wire):
                msquicNativeResultErrorScratch = "msquic native: initial payload truncated"
                return false
            let initialPayload: rawbytes.Bytes = if initialPayloadLen > 0: BytesSlice(wire, initialPayloadOffset, initialPayloadLen) else: emptyBytes()
            var needInit: bool = !gMsQuicSessions[msquicNativeCurSlot].active ||
                                 gMsQuicSessions[msquicNativeCurSlot].closed ||
                                 !gMsQuicSessions[msquicNativeCurSlot].serverBound
            if !needInit &&
               gMsQuicSessions[msquicNativeCurSlot].serverFlightSent &&
               BytesLen(gMsQuicSessions[msquicNativeCurSlot].serverInitialPayloadCache) > 0:
                let firstFlightAtMs: int64 = gMsQuicSessions[msquicNativeCurSlot].serverHandshakeFirstSentAtMs
                let flightAgeMs: int64 = if firstFlightAtMs > 0: MsQuicNativeNowMs() - firstFlightAtMs else: int64(0)
                if BytesEqual(gMsQuicSessions[msquicNativeCurSlot].serverInitialPayloadCache, initialPayload):
                    if msquicNativePeerPortChanged(gMsQuicSessions[msquicNativeCurSlot].clientAddrText, stableFromAddr):
                        if msquicNativeDebugTls13:
                            let debugText: str = strutil.Join(["msquic_native_debug migrate_server_peer_port old=", strings.CloneStr(gMsQuicSessions[msquicNativeCurSlot].clientAddrText), " new=", strings.CloneStr(stableFromAddr)], "")
                            msquicNativeDebugWriteLine(debugText)
                        gMsQuicSessions[msquicNativeCurSlot].clientAddrText = strings.CloneStr(stableFromAddr)
                    if msquicNativeDebugTls13:
                        msquicNativeDebugWriteLine("msquic_native_debug resend=handshake side=server same_initial_after_flight")
                    let resendRes: Result[bool] = msquicNativeSendServerFlight()
                    if IsErr(resendRes):
                        msquicNativeResultErrorScratch = ErrorText(resendRes)
                        return false
                elif firstFlightAtMs <= 0 || flightAgeMs > int64(msquicNativeParallelInitialGraceMs):
                    if msquicNativeDebugTls13:
                        let debugText: str = strutil.Join(["msquic_native_debug replace_server_session reason=stale_initial_after_flight age_ms=", int64ToStr(flightAgeMs)], "")
                        msquicNativeDebugWriteLine(debugText)
                    msquicNativeResetServerHandshakeAttempt()
                    needInit = true
                else:
                    if msquicNativeDebugTls13:
                        msquicNativeDebugWriteLine("msquic_native_debug drop=initial side=server reason=parallel_initial_after_flight")
                if !needInit:
                    return true
            let hostChanged: bool = !needInit &&
                                    len(gMsQuicSessions[msquicNativeCurSlot].clientAddrText) > 0 &&
                                    msquicNativePeerHostChanged(gMsQuicSessions[msquicNativeCurSlot].clientAddrText, stableFromAddr)
            let cidChanged: bool = !needInit &&
                                   msquicNativeInitialClientCidChanged(headerDec.header)
            let replaceSession: bool = hostChanged || cidChanged
            if replaceSession:
                if msquicNativeDebugTls13:
                    let debugText: str = strutil.Join(["msquic_native_debug replace_server_session old=", strings.CloneStr(gMsQuicSessions[msquicNativeCurSlot].clientAddrText), " new=", strings.CloneStr(stableFromAddr)], "")
                    msquicNativeDebugWriteLine(debugText)
                if msquicNativeListenerRunning && msquicNativeListenerDatapathId > 0:
                    msquicNativeResetServerHandshakeAttempt()
                else:
                    gMsQuicSessions[msquicNativeCurSlot].closed = true
                    msquicNativeRecycleClosedSession()
                needInit = true
            elif msquicNativePeerPortChanged(gMsQuicSessions[msquicNativeCurSlot].clientAddrText, stableFromAddr):
                if msquicNativeDebugTls13:
                    let debugText: str = strutil.Join(["msquic_native_debug migrate_server_peer_port old=", strings.CloneStr(gMsQuicSessions[msquicNativeCurSlot].clientAddrText), " new=", strings.CloneStr(stableFromAddr)], "")
                    msquicNativeDebugWriteLine(debugText)
                gMsQuicSessions[msquicNativeCurSlot].clientAddrText = strings.CloneStr(stableFromAddr)
            if needInit:
                let initRes: Result[bool] = msquicNativeInitServerSession(strings.CloneStr(stableFromAddr), headerDec.header)
                if IsErr(initRes):
                    msquicNativeResultErrorScratch = ErrorText(initRes)
                    return false
            if msquicNativeDebugTls13:
                msquicNativeDebugWriteLine(strutil.Join(["msquic native debug: initial direct early len=", IntToStr(initialPayloadLen)], ""))
            return msquicNativeProcessServerInitialDirect(headerDec, initialPayload)
        elif !gMsQuicSessions[msquicNativeCurSlot].active || gMsQuicSessions[msquicNativeCurSlot].closed || !gMsQuicSessions[msquicNativeCurSlot].serverBound:
            return true
        elif len(gMsQuicSessions[msquicNativeCurSlot].clientAddrText) > 0 &&
             msquicNativePeerHostChanged(gMsQuicSessions[msquicNativeCurSlot].clientAddrText, stableFromAddr):
            return true
        elif msquicNativePeerPortChanged(gMsQuicSessions[msquicNativeCurSlot].clientAddrText, stableFromAddr):
            gMsQuicSessions[msquicNativeCurSlot].clientAddrText = stableFromAddr
    let payloadOffset: int32 = headerDec.next
    let wireLen: int32 = BytesLen(wire)
    var payloadLen: int32 = wireLen - payloadOffset
    if payloadLen < 0 || payloadOffset > wireLen:
        msquicNativeResultErrorScratch = "msquic native: negative payload length"
        return false
    let firstByte: int32 = if BytesLen(wire) > 0: BytesGet(wire, 0) else: 0
    let directLong: bool = firstByte >= 128
    let directTypeBits: int32 = (firstByte / 16) % 4
    if packetTypeCode == msquicNativePacketShortCode:
        if recvSide == msquicNativeClientSide:
            let clientRoutedSlot: int32 = msquicNativeSlotFindByClientCid(headerDec.header.dcid)
            if clientRoutedSlot < 0:
                return true
            msquicNativeCurSlot = clientRoutedSlot
        let shortPayload: rawbytes.Bytes = if payloadLen > 0: BytesSlice(wire, payloadOffset, payloadLen) else: emptyBytes()
        return msquicNativeProcessShortDirect(recvSide, headerDec.header.packetNumber, shortPayload)
    if recvSide == msquicNativeClientSide:
        if firstByte >= 128:
            if directTypeBits == 2:
                if msquicNativeDebugTls13:
                    msquicNativeDebugWriteLine(strutil.Join(["msquic native debug: client handshake direct branch offset=", IntToStr(payloadOffset), " len=", IntToStr(payloadLen)], ""))
                let payload: rawbytes.Bytes = if payloadLen > 0: BytesSlice(wire, payloadOffset, payloadLen) else: emptyBytes()
                return msquicNativeProcessClientHandshakeDirect(headerDec, payload)
    if recvSide == msquicNativeServerSide:
        if firstByte >= 128:
            if directTypeBits == 2:
                if msquicNativeDebugTls13:
                    msquicNativeDebugWriteLine(strutil.Join(["msquic native debug: server handshake direct branch offset=", IntToStr(payloadOffset), " len=", IntToStr(payloadLen)], ""))
                let payload: rawbytes.Bytes = if payloadLen > 0: BytesSlice(wire, payloadOffset, payloadLen) else: emptyBytes()
                return msquicNativeProcessServerHandshakeDirect(headerDec, payload)
    if msquicNativeDebugTls13:
        msquicNativeDebugWriteLine(strutil.Join(["msquic native debug: payload view offset=", IntToStr(payloadOffset), " len=", IntToStr(payloadLen), " directLong=", IntToStr(if directLong: 1 else: 0), " typeBits=", IntToStr(directTypeBits)], ""))
    if recvSide == msquicNativeServerSide:
        if firstByte >= 128:
            if directTypeBits == 0:
                let payload: rawbytes.Bytes = if payloadLen > 0: BytesSlice(wire, payloadOffset, payloadLen) else: emptyBytes()
                return msquicNativeProcessServerInitialDirect(headerDec, payload)
    let payload: rawbytes.Bytes = if payloadLen > 0: BytesSlice(wire, payloadOffset, payloadLen) else: emptyBytes()
    if msquicNativeDebugTls13:
        msquicNativeDebugWriteLine(strutil.Join(["msquic native debug: packet payload_len=", IntToStr(BytesLen(payload))], ""))

    if packetTypeCode == msquicNativePacketInitialCode:
        if recvSide != msquicNativeServerSide:
            return true
        msquicNativeDebugWriteLine("msquic native debug: server initial begin")
        gMsQuicSessions[msquicNativeCurSlot].serverLargestInitialRecv = headerDec.header.packetNumber
        var cryptoBytesSeen: int32
        var firstFrameKind: int64 = -1
        var firstFrameLen: int32 = -1
        let frameCountRes: Result[int32] = msquicNativeProcessCryptoPayloadFrames(
            msquicNativeServerSide,
            msquicNativePacketInitialCode,
            payload,
            cryptoBytesSeen,
            firstFrameKind,
            firstFrameLen
        )
        if IsErr(frameCountRes):
            msquicNativeResultErrorScratch = ErrorText(frameCountRes)
            return false
        msquicNativeDebugWriteLine("msquic native debug: server crypto feed done")
        let frameCount: int32 = Value(frameCountRes)
        if handshake13.msquicTls13ServerClientKeyShareGroup() <= 0:
            msquicNativeResultErrorScratch = "msquic native: server client key share missing after initial"
            msquicNativeResultErrorScratch = strutil.Join([strings.CloneStr(msquicNativeResultErrorScratch), " crypto=", IntToStr(cryptoBytesSeen)], "")
            msquicNativeResultErrorScratch = strutil.Join([strings.CloneStr(msquicNativeResultErrorScratch), " frames=", IntToStr(frameCount)], "")
            msquicNativeResultErrorScratch = strutil.Join([strings.CloneStr(msquicNativeResultErrorScratch), " firstKind=", int64ToStr(firstFrameKind)], "")
            msquicNativeResultErrorScratch = strutil.Join([strings.CloneStr(msquicNativeResultErrorScratch), " firstLen=", IntToStr(firstFrameLen)], "")
            msquicNativeResultErrorScratch = strutil.Join([strings.CloneStr(msquicNativeResultErrorScratch), " messages=", IntToStr(handshake13.msquicTls13ServerHandshakeMessageCount())], "")
            msquicNativeResultErrorScratch = strutil.Join([strings.CloneStr(msquicNativeResultErrorScratch), " buffered=", IntToStr(handshake13.msquicTls13ServerBufferedHandshakeBytes())], "")
            msquicNativeResultErrorScratch = strutil.Join([strings.CloneStr(msquicNativeResultErrorScratch), " last=", handshake13.msquicTls13ServerLastErrorText()], "")
            return false
        msquicNativeDebugWriteLine("msquic native debug: server flight begin")
        let flightRes: Result[bool] = msquicNativeSendServerFlight()
        if IsErr(flightRes):
            msquicNativeResultErrorScratch = ErrorText(flightRes)
            return false
        msquicNativeDebugWriteLine("msquic native debug: server flight done")
        return true

    if packetTypeCode == msquicNativePacketHandshakeCode:
        if recvSide == msquicNativeClientSide:
            gMsQuicSessions[msquicNativeCurSlot].clientInitialPendingActive = false
            gMsQuicSessions[msquicNativeCurSlot].clientLargestHandshakeRecv = headerDec.header.packetNumber
            var cryptoBytesSeen: int32
            var firstFrameKind: int64 = -1
            var firstFrameLen: int32 = -1
            let frameCountRes: Result[int32] = msquicNativeProcessCryptoPayloadFrames(
                msquicNativeClientSide,
                msquicNativePacketHandshakeCode,
                payload,
                cryptoBytesSeen,
                firstFrameKind,
                firstFrameLen
            )
            if IsErr(frameCountRes):
                msquicNativeResultErrorScratch = ErrorText(frameCountRes)
                return false
            let clientServerKeyShare: rawbytes.Bytes = handshake13.msquicTls13ClientServerKeyShare()
            if msquicNativeDebugTls13 && BytesLen(clientServerKeyShare) > 0:
                let clientServerPubText: str = strutil.Join(["msquic_native_debug client_server_pub=", BytesToHex(clientServerKeyShare)], "")
                msquicNativeDebugWriteLine(clientServerPubText)
                let sharedRes = curve25519.curve25519SharedKey(handshake13.msquicTls13ClientLocalKeySharePriv(),
                                                               clientServerKeyShare)
                if IsOk(sharedRes):
                    let clientSharedText: str = strutil.Join(["msquic_native_debug client_shared=", BytesToHex(Value(sharedRes))], "")
                    msquicNativeDebugWriteLine(clientSharedText)
            if handshake13.msquicTls13ClientFinishedOk():
                let finRes: Result[bool] = msquicNativeSendClientFinished()
                if IsErr(finRes):
                    msquicNativeResultErrorScratch = ErrorText(finRes)
                    return false
            return true

        var cryptoBytesSeen: int32
        var firstFrameKind: int64 = -1
        var firstFrameLen: int32 = -1
        let frameCountRes: Result[int32] = msquicNativeProcessCryptoPayloadFrames(
            msquicNativeServerSide,
            msquicNativePacketHandshakeCode,
            payload,
            cryptoBytesSeen,
            firstFrameKind,
            firstFrameLen
        )
        if IsErr(frameCountRes):
            msquicNativeResultErrorScratch = ErrorText(frameCountRes)
            return false
        if handshake13.msquicTls13ServerFinishedOk():
            gMsQuicSessions[msquicNativeCurSlot].serverHandshakePendingActive = false
            gMsQuicSessions[msquicNativeCurSlot].serverReady = 1
            if msquicNativeDebugTls13:
                let debugText: str = "msquic_native_debug server_finished_ok=true"
                msquicNativeDebugWriteLine(debugText)
            let doneRes: Result[bool] = msquicNativeSendServerHandshakeDone()
            if IsErr(doneRes):
                msquicNativeResultErrorScratch = ErrorText(doneRes)
                return false
            msquicNativeQueueAcceptIfReady()
            msquicNativeProcessOutcomeScratch = msquicNativeProcessOutcomeServerAccept
            return true
        return true

    if packetTypeCode != msquicNativePacketShortCode:
        return true

    if recvSide == msquicNativeClientSide:
        gMsQuicSessions[msquicNativeCurSlot].clientLargestAppRecv = headerDec.header.packetNumber
    else:
        gMsQuicSessions[msquicNativeCurSlot].serverLargestAppRecv = headerDec.header.packetNumber

    var clientReadyNow: bool
    var ackElicitingNow: bool
    var appFrameOffset: int32
    while appFrameOffset < BytesLen(payload):
        let frameRes: Result[int32] = msquicNativeHandleAppPayloadFrame(recvSide,
                                                                        payload,
                                                                        appFrameOffset,
                                                                        clientReadyNow,
                                                                        ackElicitingNow)
        if IsErr(frameRes):
            msquicNativeResultErrorScratch = ErrorText(frameRes)
            return false
        let nextOffset: int32 = Value(frameRes)
        if nextOffset <= appFrameOffset:
            msquicNativeResultErrorScratch = "msquic payload: frame cursor stalled"
            return false
        appFrameOffset = nextOffset
    if ackElicitingNow && ! gMsQuicSessions[msquicNativeCurSlot].closed:
        if recvSide == msquicNativeClientSide:
            let ackRes: Result[bool] = msquicNativeQueueSackFor(msquicNativeClientSide, headerDec.header.packetNumber)
            if IsErr(ackRes):
                msquicNativeResultErrorScratch = ErrorText(ackRes)
                return false
            let flushRes: Result[bool] = msquicNativeFlushShortPackets(msquicNativeClientSide)
            if IsErr(flushRes):
                msquicNativeResultErrorScratch = ErrorText(flushRes)
                return false
            if clientReadyNow:
                msquicNativeProcessOutcomeScratch = msquicNativeProcessOutcomeClientReady
            return true
        let ackRes: Result[bool] = msquicNativeQueueSackFor(msquicNativeServerSide, headerDec.header.packetNumber)
        if IsErr(ackRes):
            msquicNativeResultErrorScratch = ErrorText(ackRes)
            return false
        let flushRes: Result[bool] = msquicNativeFlushShortPackets(msquicNativeServerSide)
        if IsErr(flushRes):
            msquicNativeResultErrorScratch = ErrorText(flushRes)
            return false
        return true
    if clientReadyNow:
        msquicNativeProcessOutcomeScratch = msquicNativeProcessOutcomeClientReady
    return true

# Record an app short-packet number into the side's SACK recv state and queue
# an ACK frame carrying value=largest + SACK range payload.
fn msquicNativeQueueSackFor(side: int32, packetNumber: int64): Result[bool] =
    msquicNativeSackRecord(side, packetNumber)
    let largest: int64 = side == msquicNativeClientSide ? gMsQuicSessions[msquicNativeCurSlot].clientLargestAppRecv : gMsQuicSessions[msquicNativeCurSlot].serverLargestAppRecv
    let payload: rawbytes.Bytes = msquicNativeSackBuildPayload(side)
    if side == msquicNativeClientSide:
        return connection_impl.MsQuicConnImplQueueFrameParts(msquicNativeClientImpl[msquicNativeCurSlot], int64(msquicNativeFrameAckCode), 0, 0, largest, payload)
    return connection_impl.MsQuicConnImplQueueFrameParts(msquicNativeServerImpl[msquicNativeCurSlot], int64(msquicNativeFrameAckCode), 0, 0, largest, payload)

fn msquicNativeProcessPacket(recvSide: int32, fromAddr: str, wire: rawbytes.Bytes): Result[int32] =
    if BytesLen(wire) <= 0:
        return Ok[int32](msquicNativeProcessOutcomeNone)
    if msquicNativeDebugTls13:
        msquicNativeDebugWriteLine(strutil.Join(["msquic native debug: process wrapper len=", IntToStr(BytesLen(wire)), " side=", IntToStr(recvSide)], ""))
    let ok: bool = msquicNativeProcessPacketFill(recvSide, fromAddr, wire)
    if ! ok:
        if msquicNativePacketDecodeErrorIsDrop(msquicNativeResultErrorScratch):
            if msquicNativeDebugTls13:
                msquicNativeDebugWriteLine(strutil.Join(["msquic native debug: drop malformed packet: ", share(msquicNativeResultErrorScratch)], ""))
            msquicNativeResultErrorScratch = ""
            return Ok[int32](msquicNativeProcessOutcomeNone)
        return Err[int32](msquicNativeResultErrorScratch)
    let outcome: int32 = msquicNativeProcessOutcomeScratch
    return Ok[int32](outcome)

fn msquicNativeReadI32LE(raw: rawbytes.Bytes): int32 =
    if BytesLen(raw) < 4:
        return 0
    return BytesGet(raw, 0) | (BytesGet(raw, 1) << 8) | (BytesGet(raw, 2) << 16) | (BytesGet(raw, 3) << 24)

fn msquicNativeRawSockaddrText(raw: rawbytes.Bytes, rawLen: int32): Result[str] =
    if rawLen < 8 || BytesLen(raw) < rawLen:
        return Err[str]("msquic native: short peer sockaddr")
    let b0: int32 = BytesGet(raw, 0)
    let b1: int32 = BytesGet(raw, 1)
    var family: int32
    if (b0 == 16 || b0 == 28) && (b1 == msquicNativeUdpAfInet || b1 == msquicNativeUdpAfInet6Linux || b1 == msquicNativeUdpAfInet6Bsd):
        family = b1
    else:
        family = b0 | (b1 << 8)
    let port: int32 = (BytesGet(raw, 2) << 8) | BytesGet(raw, 3)
    if family == msquicNativeUdpAfInet:
        if rawLen < 16:
            return Err[str]("msquic native: short ipv4 sockaddr")
        return Ok[str](strutil.Join([
            "/ip4/",
            IntToStr(BytesGet(raw, 4)), ".", IntToStr(BytesGet(raw, 5)), ".", IntToStr(BytesGet(raw, 6)), ".", IntToStr(BytesGet(raw, 7)),
            "/udp/", IntToStr(port), "/quic-v1"
        ], ""))
    if family == msquicNativeUdpAfInet6Linux || family == msquicNativeUdpAfInet6Bsd:
        if rawLen < 28:
            return Err[str]("msquic native: short ipv6 sockaddr")
        let ipView: rawbytes.Bytes = BytesSlice(raw, 8, 16)
        let hostText: str = os.udpInetNtop(family, ipView)
        if len(hostText) <= 0:
            return Err[str]("msquic native: invalid ipv6 peer")
        return Ok[str](strutil.Join(["/ip6/", share(hostText), "/udp/", IntToStr(port), "/quic-v1"], ""))
    return Err[str]("msquic native: unsupported peer sockaddr")

fn msquicNativeUdpErrWouldBlockOrIntr(code: int32): bool =
    var normalized: int32 = code
    if normalized < 0:
        normalized = 0 - normalized
    if normalized == 0:
        return true
    if normalized == msquicNativeUdpErrIntr:
        return true
    if normalized == msquicNativeUdpErrIntrWindows:
        return true
    if normalized == msquicNativeUdpErrAgainLinux || normalized == msquicNativeUdpErrAgainBsd:
        return true
    if normalized == msquicNativeUdpErrWouldBlockLinux || normalized == msquicNativeUdpErrWouldBlockBsd:
        return true
    if normalized == msquicNativeUdpErrWouldBlockMingw:
        return true
    if normalized == msquicNativeUdpErrWouldBlockWindows:
        return true
    return false

fn msquicNativeUdpErrTransientRecv(code: int32): bool =
    var normalized: int32 = code
    if normalized < 0:
        normalized = 0 - normalized
    if msquicNativeUdpErrWouldBlockOrIntr(normalized):
        return true
    if normalized == msquicNativeUdpErrConnResetWindows:
        return true
    return false

fn msquicNativeRecvDatagramDirectInto(id: int32, waitMs: int32, outData: var rawbytes.Bytes, outFromAddr: var str): int32 =
    let fd: int32 = msquicNativeDatapathUdpFd(id)
    if fd < 0:
        return -1
    var deadlineMs: int64
    if waitMs > 0:
        deadlineMs = MsQuicNativeNowMs() + int64(waitMs)
    while true:
        if waitMs >= 0:
            let readable: int32 = msquicNativeMobileUdpFdWaitReadable(fd, waitMs)
            msquicNativeUdpDebugEvent(7, fd, waitMs, readable, 0)
            if readable <= 0:
                return 0
        var dataBuf: rawbytes.Bytes = BytesAlloc(msquicNativeUdpRecvMaxBytes)
        let rawAddr: rawbytes.Bytes = BytesAlloc(64)
        let rawLenBuf: rawbytes.Bytes = BytesAlloc(4)
        let recvErrBuf: rawbytes.Bytes = BytesAlloc(4)
        BytesSet(rawLenBuf, 0, BytesLen(rawAddr) & 255)
        BytesSet(rawLenBuf, 1, (BytesLen(rawAddr) >> 8) & 255)
        BytesSet(rawLenBuf, 2, (BytesLen(rawAddr) >> 16) & 255)
        BytesSet(rawLenBuf, 3, (BytesLen(rawAddr) >> 24) & 255)
        let recvLenRaw: int32 = msquicNativeMobileUdpRecvFromAddrPtrBridge(
            fd,
            dataBuf.data,
            BytesLen(dataBuf),
            0,
            rawAddr.data,
            BytesLen(rawAddr),
            rawLenBuf.data,
            recvErrBuf.data
        )
        if recvLenRaw < 0:
            let recvErr: int32 = msquicNativeReadI32LE(recvErrBuf)
            msquicNativeUdpDebugEvent(8, fd, 0, recvLenRaw, recvErr)
            if msquicNativeUdpErrTransientRecv(recvErr):
                if waitMs == 0:
                    return 0
                if waitMs > 0 && MsQuicNativeNowMs() >= deadlineMs:
                    return 0
                os.SleepMs(1)
                msquicNativeFreeBytesMove(dataBuf)
                msquicNativeFreeBytesMove(rawAddr)
                msquicNativeFreeBytesMove(rawLenBuf)
                continue
            msquicNativeResultErrorScratch = strutil.Join(["msquic native: datapath recv failed err=", IntToStr(recvErr)], "")
            return -1
        if recvLenRaw == 0:
            msquicNativeUdpDebugEvent(9, fd, 0, recvLenRaw, 0)
            if waitMs == 0:
                return 0
            if waitMs > 0 && MsQuicNativeNowMs() >= deadlineMs:
                return 0
            os.SleepMs(1)
            msquicNativeFreeBytesMove(dataBuf)
            msquicNativeFreeBytesMove(rawAddr)
            msquicNativeFreeBytesMove(rawLenBuf)
            msquicNativeFreeBytesMove(recvErrBuf)
            continue
        var recvLen: int32 = recvLenRaw
        if recvLen > BytesLen(dataBuf):
            recvLen = BytesLen(dataBuf)
        if recvLen <= 0:
            return 0
        msquicNativeUdpDebugEvent(9, fd, recvLen, recvLen, 0)
        var rawLen: int32 = msquicNativeReadI32LE(rawLenBuf)
        if rawLen > BytesLen(rawAddr):
            rawLen = BytesLen(rawAddr)
        let fromRes: Result[str] = msquicNativeRawSockaddrText(rawAddr, rawLen)
        if IsErr(fromRes):
            return -1
        let fromAddrRaw: str = Value(fromRes)
        outFromAddr = strFromBytesCopy(strDataPtr(fromAddrRaw), len(fromAddrRaw))
        outData = BytesSlice(dataBuf, 0, recvLen)
        msquicNativeFreeBytesMove(dataBuf)
        return recvLen

fn msquicNativeVarintDecodeCode(data: rawbytes.Bytes, offset: int32, outValue: var int64, outNext: var int32): int32 =
    outValue = int64(0)
    outNext = offset
    if offset < 0 || offset >= BytesLen(data):
        return -1
    let first: int32 = BytesGet(data, offset)
    let tag: int32 = first >> 6
    var size: int32 = 8
    if tag == 0:
        size = 1
    elif tag == 1:
        size = 2
    elif tag == 2:
        size = 4
    if offset + size > BytesLen(data):
        return -1
    var value: int64 = int64(first & 0x3f)
    for i in 1..<size:
        value = (value << 8) | int64(BytesGet(data, offset + i))
    outValue = value
    outNext = offset + size
    return 1

fn msquicNativeProcessServerInitialDirect(headerDec: packet_header_model.QuicPacketHeaderDecoded, payload: rawbytes.Bytes): bool =
    msquicNativeDebugWriteLine("msquic native debug: server initial direct begin")
    gMsQuicSessions[msquicNativeCurSlot].serverInitialPayloadCache = BytesSlice(payload, 0, BytesLen(payload))
    gMsQuicSessions[msquicNativeCurSlot].serverLargestInitialRecv = headerDec.header.packetNumber
    var offset: int32
    var framesCount: int32
    var cryptoBytesSeen: int32
    var firstFrameKind: int64 = -1
    var firstFrameLen: int32 = -1
    while offset < BytesLen(payload):
        var kindValue: int64
        var afterKind: int32
        if msquicNativeVarintDecodeCode(payload, offset, kindValue, afterKind) <= 0:
            msquicNativeResultErrorScratch = "msquic native: initial frame kind decode failed"
            return false
        # RFC 9000 §19.3/§19.2: PADDING/PING carry no fields beyond the 1-byte
        # type. A real independent client pads its Initial datagram with runs of
        # PADDING to the 1200-byte §14.1 minimum; decoding that run via the
        # CRYPTO-shaped 5-field layout below walked past the buffer and rejected
        # the whole (otherwise valid) packet outright.
        if kindValue == int64(msquicNativeFramePaddingCode) || kindValue == int64(msquicNativeFramePingCode):
            if framesCount == 0:
                firstFrameKind = kindValue
                firstFrameLen = 0
            framesCount = framesCount + 1
            offset = afterKind
            continue
        var streamValue: int64
        var next: int32
        if msquicNativeVarintDecodeCode(payload, afterKind, streamValue, next) <= 0:
            msquicNativeResultErrorScratch = "msquic native: initial frame stream decode failed"
            return false
        var offValue: int64
        if msquicNativeVarintDecodeCode(payload, next, offValue, next) <= 0:
            msquicNativeResultErrorScratch = "msquic native: initial frame offset decode failed"
            return false
        var valueValue: int64
        if msquicNativeVarintDecodeCode(payload, next, valueValue, next) <= 0:
            msquicNativeResultErrorScratch = "msquic native: initial frame value decode failed"
            return false
        var dataLenValue: int64
        if msquicNativeVarintDecodeCode(payload, next, dataLenValue, next) <= 0:
            msquicNativeResultErrorScratch = "msquic native: initial frame len decode failed"
            return false
        let dataLen: int32 = int32(dataLenValue)
        if dataLen < 0 || next + dataLen > BytesLen(payload):
            msquicNativeResultErrorScratch = "msquic native: initial frame data truncated"
            return false
        if framesCount == 0:
            firstFrameKind = kindValue
            firstFrameLen = dataLen
        if kindValue == int64(msquicNativeFrameCryptoCode):
            let frameData: rawbytes.Bytes = if dataLen > 0: BytesSlice(payload, next, dataLen) else: emptyBytes()
            cryptoBytesSeen = cryptoBytesSeen + dataLen
            msquicNativeDebugWriteLine(strutil.Join(["msquic native debug: server direct crypto len=", IntToStr(dataLen)], ""))
            let feedRes: Result[bool] = msquicNativeHandleCryptoData(
                msquicNativeServerSide,
                msquicNativePacketInitialCode,
                offValue,
                frameData
            )
            if IsErr(feedRes):
                msquicNativeResultErrorScratch = ErrorText(feedRes)
                return false
        # Any other kind (e.g. ACK) decodes fine through this 5-field shape --
        # every frame kind this codebase's own peer emits uses it uniformly --
        # it is just not acted on here, same as before this fix.
        framesCount = framesCount + 1
        offset = next + dataLen
    if handshake13.msquicTls13ServerClientKeyShareGroup() <= 0:
        msquicNativeResultErrorScratch = "msquic native: server client key share missing after initial"
        msquicNativeResultErrorScratch = strutil.Join([strings.CloneStr(msquicNativeResultErrorScratch), " crypto=", IntToStr(cryptoBytesSeen)], "")
        msquicNativeResultErrorScratch = strutil.Join([strings.CloneStr(msquicNativeResultErrorScratch), " frames=", IntToStr(framesCount)], "")
        msquicNativeResultErrorScratch = strutil.Join([strings.CloneStr(msquicNativeResultErrorScratch), " firstKind=", int64ToStr(firstFrameKind)], "")
        msquicNativeResultErrorScratch = strutil.Join([strings.CloneStr(msquicNativeResultErrorScratch), " firstLen=", IntToStr(firstFrameLen)], "")
        msquicNativeResultErrorScratch = strutil.Join([strings.CloneStr(msquicNativeResultErrorScratch), " messages=", IntToStr(handshake13.msquicTls13ServerHandshakeMessageCount())], "")
        msquicNativeResultErrorScratch = strutil.Join([strings.CloneStr(msquicNativeResultErrorScratch), " buffered=", IntToStr(handshake13.msquicTls13ServerBufferedHandshakeBytes())], "")
        msquicNativeResultErrorScratch = strutil.Join([strings.CloneStr(msquicNativeResultErrorScratch), " last=", handshake13.msquicTls13ServerLastErrorText()], "")
        return false
    msquicNativeDebugWriteLine("msquic native debug: server direct flight begin")
    let flightRes: Result[bool] = msquicNativeSendServerFlight()
    if IsErr(flightRes):
        msquicNativeResultErrorScratch = ErrorText(flightRes)
        return false
    msquicNativeDebugWriteLine("msquic native debug: server direct flight done")
    return true

fn msquicNativeProcessClientHandshakeDirect(headerDec: packet_header_model.QuicPacketHeaderDecoded, payload: rawbytes.Bytes): bool =
    msquicNativeDebugWriteLine("msquic native debug: client handshake direct begin")
    gMsQuicSessions[msquicNativeCurSlot].clientInitialPendingActive = false
    gMsQuicSessions[msquicNativeCurSlot].clientLargestHandshakeRecv = headerDec.header.packetNumber
    var offset: int32
    var clientFinishedOkAfterFeed: bool
    while offset < BytesLen(payload):
        var kindValue: int64
        var afterKind: int32
        if msquicNativeVarintDecodeCode(payload, offset, kindValue, afterKind) <= 0:
            msquicNativeResultErrorScratch = "msquic native: handshake frame kind decode failed"
            return false
        # RFC 9000 §19.3/§19.2: PADDING/PING carry no fields beyond the 1-byte type.
        if kindValue == int64(msquicNativeFramePaddingCode) || kindValue == int64(msquicNativeFramePingCode):
            offset = afterKind
            continue
        var streamValue: int64
        var next: int32
        if msquicNativeVarintDecodeCode(payload, afterKind, streamValue, next) <= 0:
            msquicNativeResultErrorScratch = "msquic native: handshake frame stream decode failed"
            return false
        var offValue: int64
        if msquicNativeVarintDecodeCode(payload, next, offValue, next) <= 0:
            msquicNativeResultErrorScratch = "msquic native: handshake frame offset decode failed"
            return false
        var valueValue: int64
        if msquicNativeVarintDecodeCode(payload, next, valueValue, next) <= 0:
            msquicNativeResultErrorScratch = "msquic native: handshake frame value decode failed"
            return false
        var dataLenValue: int64
        if msquicNativeVarintDecodeCode(payload, next, dataLenValue, next) <= 0:
            msquicNativeResultErrorScratch = "msquic native: handshake frame len decode failed"
            return false
        let dataLen: int32 = int32(dataLenValue)
        if dataLen < 0 || next + dataLen > BytesLen(payload):
            msquicNativeResultErrorScratch = "msquic native: handshake frame data truncated"
            return false
        if kindValue == int64(msquicNativeFrameCryptoCode):
            let frameData: rawbytes.Bytes = if dataLen > 0: BytesSlice(payload, next, dataLen) else: emptyBytes()
            if msquicNativeDebugTls13:
                msquicNativeDebugWriteLine(strutil.Join(["msquic native debug: client direct crypto len=", IntToStr(dataLen)], ""))
            let feedStartedAtMs: int64 = MsQuicNativeNowMs()
            let feedRes: Result[bool] = msquicNativeHandleCryptoData(
                msquicNativeClientSide,
                msquicNativePacketHandshakeCode,
                offValue,
                frameData
            )
            let feedCompletedAtMs: int64 = MsQuicNativeNowMs()
            var finishedOkCode: int32
            if handshake13.msquicTls13ClientFinishedOk():
                finishedOkCode = 1
                clientFinishedOkAfterFeed = true
            if msquicNativeDebugTls13:
                var feedTimingText: str = "msquic_native_client_handshake_feed_timing_ms len="
                feedTimingText = strutil.Join([ share(feedTimingText), IntToStr(dataLen)], "")
                feedTimingText = strutil.Join([ share(feedTimingText), " feed="], "")
                feedTimingText = strutil.Join([ share(feedTimingText), int64ToStr(feedCompletedAtMs - feedStartedAtMs)], "")
                feedTimingText = strutil.Join([ share(feedTimingText), " finished_ok="], "")
                feedTimingText = strutil.Join([ share(feedTimingText), IntToStr(finishedOkCode)], "")
                msquicNativeDebugWriteLine(feedTimingText)
            if IsErr(feedRes):
                msquicNativeResultErrorScratch = ErrorText(feedRes)
                return false
        # Any other kind (e.g. ACK, legitimately sent alongside CRYPTO in this
        # codebase's own Handshake-space flights) decodes fine through this
        # 5-field shape -- every frame kind this codebase's own peer emits
        # uses it uniformly -- it is just not acted on here, same as before
        # this fix.
        offset = next + dataLen
    if clientFinishedOkAfterFeed:
        gMsQuicSessions[msquicNativeCurSlot].clientFinishedReadyPending = true
    msquicNativeDebugWriteLine("msquic native debug: client handshake direct done")
    return true

fn msquicNativeProcessServerHandshakeDirect(headerDec: packet_header_model.QuicPacketHeaderDecoded, payload: rawbytes.Bytes): bool =
    msquicNativeDebugWriteLine("msquic native debug: server handshake direct begin")
    var offset: int32
    while offset < BytesLen(payload):
        var kindValue: int64
        var afterKind: int32
        if msquicNativeVarintDecodeCode(payload, offset, kindValue, afterKind) <= 0:
            msquicNativeResultErrorScratch = "msquic native: server handshake frame kind decode failed"
            return false
        # RFC 9000 §19.3/§19.2: PADDING/PING carry no fields beyond the 1-byte type.
        if kindValue == int64(msquicNativeFramePaddingCode) || kindValue == int64(msquicNativeFramePingCode):
            offset = afterKind
            continue
        var streamValue: int64
        var next: int32
        if msquicNativeVarintDecodeCode(payload, afterKind, streamValue, next) <= 0:
            msquicNativeResultErrorScratch = "msquic native: server handshake frame stream decode failed"
            return false
        var offValue: int64
        if msquicNativeVarintDecodeCode(payload, next, offValue, next) <= 0:
            msquicNativeResultErrorScratch = "msquic native: server handshake frame offset decode failed"
            return false
        var valueValue: int64
        if msquicNativeVarintDecodeCode(payload, next, valueValue, next) <= 0:
            msquicNativeResultErrorScratch = "msquic native: server handshake frame value decode failed"
            return false
        var dataLenValue: int64
        if msquicNativeVarintDecodeCode(payload, next, dataLenValue, next) <= 0:
            msquicNativeResultErrorScratch = "msquic native: server handshake frame len decode failed"
            return false
        let dataLen: int32 = int32(dataLenValue)
        if dataLen < 0 || next + dataLen > BytesLen(payload):
            msquicNativeResultErrorScratch = "msquic native: server handshake frame data truncated"
            return false
        if kindValue == int64(msquicNativeFrameCryptoCode):
            let frameData: rawbytes.Bytes = if dataLen > 0: BytesSlice(payload, next, dataLen) else: emptyBytes()
            if msquicNativeDebugTls13:
                msquicNativeDebugWriteLine(strutil.Join(["msquic native debug: server direct crypto len=", IntToStr(dataLen)], ""))
        # Any other kind (e.g. ACK) decodes fine through this 5-field shape --
        # every frame kind this codebase's own peer emits uses it uniformly --
        # it is just not acted on here, same as before this fix.
        offset = next + dataLen
    gMsQuicSessions[msquicNativeCurSlot].serverHandshakePendingActive = false
    gMsQuicSessions[msquicNativeCurSlot].serverReady = 1
    let doneRes: Result[bool] = msquicNativeSendServerHandshakeDone()
    if IsErr(doneRes):
        msquicNativeResultErrorScratch = ErrorText(doneRes)
        return false
    msquicNativeQueueAcceptIfReady()
    msquicNativeProcessOutcomeScratch = msquicNativeProcessOutcomeServerAccept
    msquicNativeDebugWriteLine("msquic native debug: server handshake direct done")
    return true

fn msquicNativeProcessShortDirect(recvSide: int32, packetNumber: int64, payload: rawbytes.Bytes): bool =
    if msquicNativeDebugTls13:
        msquicNativeDebugWriteLine(strutil.Join(["msquic native debug: short direct side=", IntToStr(recvSide), " len=", IntToStr(BytesLen(payload))], ""))
    if recvSide == msquicNativeClientSide:
        gMsQuicSessions[msquicNativeCurSlot].clientLargestAppRecv = packetNumber
    else:
        gMsQuicSessions[msquicNativeCurSlot].serverLargestAppRecv = packetNumber
    # Advance the cumulative SACK frontier for EVERY received 1-RTT packet on the
    # RECEIVER (client) side, including non-ack-eliciting ones (e.g. the peer's pure-ACK
    # packets). Recording only ack-eliciting packets left the peer's ACK packets as false
    # gaps, so the frontier stalled and the cumulative [0,frontier] ack never covered the
    # bulk data packets → sender's in-flight/cwnd never advanced. (The out-of-order bitmap
    # is unreliable — the cold backend miscompiles its global scalar-array stores — so the
    # contiguous frontier is load-bearing; real loss stalls the frontier and recovers via
    # RTO.)
    let _ = msquicNativeSackRecord(recvSide, packetNumber)
    var clientReadyNow: bool
    var ackElicitingNow: bool
    var appFrameOffset: int32
    while appFrameOffset < BytesLen(payload):
        let frameRes: Result[int32] = msquicNativeHandleAppPayloadFrame(recvSide, payload, appFrameOffset, clientReadyNow, ackElicitingNow)
        if IsErr(frameRes):
            let frameErr: str = ErrorText(frameRes)
            if msquicNativeAppPayloadDecodeErrorIsDrop(frameErr):
                # Unconditional (not gated on msquicNativeDebugTls13): this
                # drops the whole 1-RTT packet -- any real frame bytes after
                # a genuinely malformed frame are lost, not just the bad one.
                # PADDING/PING no longer reach here (handled above), so
                # anything landing here is either off-wire corruption or an
                # actual codec gap; either way it must not vanish silently.
                os.WriteLine(os.Get_stderr(), strutil.Join(["msquic native: drop malformed short payload: ", share(frameErr)], ""))
                return true
            msquicNativeResultErrorScratch = strings.CloneStr(frameErr)
            return false
        let nextOffset: int32 = Value(frameRes)
        if nextOffset <= appFrameOffset:
            msquicNativeResultErrorScratch = "msquic payload: frame cursor stalled"
            return false
        appFrameOffset = nextOffset
    if ! ackElicitingNow:
        if clientReadyNow:
            msquicNativeProcessOutcomeScratch = msquicNativeProcessOutcomeClientReady
        return true
    if recvSide == msquicNativeClientSide:
        let ackRes: Result[bool] = msquicNativeQueueSackFor(msquicNativeClientSide, packetNumber)
        if IsErr(ackRes):
            msquicNativeResultErrorScratch = ErrorText(ackRes)
            return false
        let flushRes: Result[bool] = msquicNativeFlushShortPackets(msquicNativeClientSide)
        if IsErr(flushRes):
            msquicNativeResultErrorScratch = ErrorText(flushRes)
            return false
        if clientReadyNow:
            msquicNativeProcessOutcomeScratch = msquicNativeProcessOutcomeClientReady
        return true
    let ackRes: Result[bool] = msquicNativeQueueSackFor(msquicNativeServerSide, packetNumber)
    if IsErr(ackRes):
        msquicNativeResultErrorScratch = ErrorText(ackRes)
        return false
    let flushRes: Result[bool] = msquicNativeFlushShortPackets(msquicNativeServerSide)
    if IsErr(flushRes):
        msquicNativeResultErrorScratch = ErrorText(flushRes)
        return false
    return true

fn msquicNativePumpDatapathCode(id: int32, recvSide: int32): int32 =
    msquicNativeLastPumpDroppedMalformed = false
    msquicNativeLastPumpReceived = false
    if id <= 0:
        return msquicNativeProcessOutcomeNone
    var data: rawbytes.Bytes
    var fromAddr: str
    let recvCode: int32 = msquicNativeRecvDatagramDirectInto(id, 0, data, fromAddr)
    if recvCode == 0:
        return msquicNativeProcessOutcomeNone
    if recvCode < 0:
        if len(msquicNativeResultErrorScratch) <= 0:
            msquicNativeResultErrorScratch = "msquic native: datapath recv failed"
        return -1
    msquicNativeLastPumpReceived = true
    if msquicNativeDebugTls13:
        msquicNativeDebugWriteLine(strutil.Join(["msquic native debug: recv direct code=", IntToStr(recvCode), " data_len=", IntToStr(BytesLen(data)), " side=", IntToStr(recvSide)], ""))
    if BytesLen(data) <= 0:
        return msquicNativeProcessOutcomeNone
    if BytesLen(data) < 2:
        if msquicNativeDebugTls13:
            msquicNativeDebugWriteLine(strutil.Join(["msquic native debug: drop malformed packet len=", IntToStr(BytesLen(data))], ""))
        msquicNativeLastPumpDroppedMalformed = true
        return msquicNativeProcessOutcomeNone
    if msquicNativeDebugTls13:
        var msg = "msquic_native_debug recv_wire side="
        if recvSide == msquicNativeClientSide:
            msg = strutil.Join([ share(msg), "client"], "")
        else:
            msg = strutil.Join([ share(msg), "server"], "")
        msg = strutil.Join([ share(msg), " from=", strings.CloneStr(fromAddr)], "")
        msg = strutil.Join([ share(msg), " len=", IntToStr(BytesLen(data))], "")
        os.WriteLine(os.Get_stderr(), msg)
    if msquicNativeDebugTls13:
        msquicNativeDebugWriteLine(strutil.Join(["msquic native debug: process direct len=", IntToStr(BytesLen(data)), " side=", IntToStr(recvSide)], ""))
    let procOk: bool = msquicNativeProcessPacketFill(recvSide, fromAddr, data)
    if ! procOk:
        return -1
    return msquicNativeProcessOutcomeScratch

fn msquicNativePumpDatapath(id: int32, recvSide: int32): Result[int32] =
    let code: int32 = msquicNativePumpDatapathCode(id, recvSide)
    if code < 0:
        return Err[int32](msquicNativeResultErrorScratch)
    return Ok[int32](code)

fn msquicNativePumpClientShortRetransmit(nowMs: int64): Result[bool] =
    var rt: connection_impl.MsQuicRetransmitPacket
    if connection_impl.MsQuicConnImplNextRetransmitInto(rt, msquicNativeClientImpl[msquicNativeCurSlot], nowMs) && rt.number > 0 && BytesLen(rt.payload) > 0:
        return msquicNativeSendPayload(msquicNativeClientSide, msquicNativePacketShortCode, rt.number, rt.payload, true)
    return Ok[bool](false)

fn msquicNativePumpServerShortRetransmit(nowMs: int64): Result[bool] =
    var rt: connection_impl.MsQuicRetransmitPacket
    if connection_impl.MsQuicConnImplNextRetransmitInto(rt, msquicNativeServerImpl[msquicNativeCurSlot], nowMs) && rt.number > 0 && BytesLen(rt.payload) > 0:
        return msquicNativeSendPayload(msquicNativeServerSide, msquicNativePacketShortCode, rt.number, rt.payload, true)
    return Ok[bool](false)

fn msquicNativePumpRetransmit(side: int32): Result[bool] =
    let nowMs: int64 = MsQuicNativeNowMs()
    if side == msquicNativeClientSide:
        let rtInitialRes: Result[bool] = msquicNativeRetransmitClientInitial(nowMs)
        if IsErr(rtInitialRes):
            return rtInitialRes
        let rtHandshakeRes: Result[bool] = msquicNativeRetransmitClientHandshake(nowMs)
        if IsErr(rtHandshakeRes):
            return rtHandshakeRes
        return msquicNativePumpClientShortRetransmit(nowMs)
    let rtHandshakeRes: Result[bool] = msquicNativeRetransmitServerHandshake(nowMs)
    if IsErr(rtHandshakeRes):
        return rtHandshakeRes
    return msquicNativePumpServerShortRetransmit(nowMs)

# Pump 加锁外壳: rebind（SlotByDatapath→cur）→ poll → flush/retransmit 原子，
# dual-role 下 T_SERVE 的 ProcessPacketFill span 与之互斥（recv waitMs=0
# 非阻塞，span 内无等待）。
fn msquicNativePumpCode(count: int32): int32 =
    MsQuicNativeTransportLock()
    let code: int32 = msquicNativePumpCodeUnlocked(count)
    MsQuicNativeTransportUnlock()
    return code

fn msquicNativePumpCodeUnlocked(count: int32): int32 =
    # F-H5: 泵门改数据面存在性判定。原形 gate 在 cur 槽会话 active/closed 上，
    # serve-only 形态（PUBLISH 无 client 半环）cur 槽会话未激活 → 泵恒短路，
    # 入站 Initial 永不处理（真机实证 rx_queue 411KB 积压/跨机零受理）。dual-role
    # 自连被 client 半环"顺带解锁"掩蔽。数据面 id 才是泵的真实前置；槽级
    # active/closed 由各分支绑定后的 SlotBy* >= 0 与 datapath 泵内部语义把关。
    if msquicNativeSessionClientDatapathId <= 0 && msquicNativeSessionListenerDatapathId <= 0:
        return msquicNativeProcessOutcomeNone
    var budget: int32 = count
    if budget <= 0:
        budget = msquicNativePumpBudget
    var outcome: int32 = msquicNativeProcessOutcomeNone
    var pumpReceivedAny: bool
    for i in 0..<budget:
        var iterReceived: bool
        if msquicNativeSessionClientDatapathId > 0:
            # Dual-role slot discipline: bind cur to the session that owns this
            # datapath BEFORE polling it. The client-side decrypt/conn state is
            # per-slot, and the previous iteration's listener processing can leave
            # cur on the server session (client short packets route by CID, but
            # handshake/flush helpers use cur directly).
            let clientSlot: int32 = msquicNativeSlotByClientDatapath(msquicNativeSessionClientDatapathId)
            # recv 所有权 (client 分支与 listener 分支同型, 见下方 listener 注):
            # 数据面扫描按 bind k 定位数据槽并按 k 构造读端, 泵在别的 bind 上
            # recv 会把数据落 owner 槽而 ks 停在当下 bind (错槽)。gate 判定先于
            # 重绑。
            var clientRecvAllowed: bool = clientSlot >= 0 && msquicNativeCurSlot == clientSlot
            # v2 扫描停靠（语义见下方 listener 分支注）: 停靠期间泵 recv 只准
            # 停靠者自己（cur==park, 即扫描环 bind k 后的自泵）——谁停靠谁读,
            # 泵只在无人停靠时收; 堵「他泵扫描中途 recv→数据落 owner 槽→扫描
            # 按序停在非 owner bind→ks 错槽」毒窗。gate 判定先于重绑。
            if clientRecvAllowed && msquicNativeScanParkClient != -1:
                clientRecvAllowed = msquicNativeCurSlot == msquicNativeScanParkClient
            if clientSlot >= 0:
                msquicNativeCurSlot = clientSlot
            if clientRecvAllowed:
                let clientCode: int32 = msquicNativePumpDatapathCode(msquicNativeSessionClientDatapathId, msquicNativeClientSide)
                if clientCode < 0:
                    return -1
                if msquicNativeLastPumpReceived:
                    iterReceived = true
                    pumpReceivedAny = true
                if msquicNativeLastPumpDroppedMalformed:
                    continue
                if clientCode > outcome:
                    outcome = clientCode
            let pendingClientFinishedRes: Result[bool] = msquicNativeFlushPendingClientFinished()
            if IsErr(pendingClientFinishedRes):
                msquicNativeResultErrorScratch = ErrorText(pendingClientFinishedRes)
                return -1
            if IsOk(pendingClientFinishedRes) && Value(pendingClientFinishedRes):
                outcome = msquicNativeProcessOutcomeClientReady
            let rtClient: Result[bool] = msquicNativePumpRetransmit(msquicNativeClientSide)
            if IsErr(rtClient):
                msquicNativeResultErrorScratch = ErrorText(rtClient)
                return -1
            # Incoming acks free congestion-window space; re-flush any data frames
            # that pipeWrite left queued because cwnd was full at write time.
            # Without this, a transfer larger than cwnd leaves an un-flushed tail
            # queued forever (peer stalls mid-stream → "pipe closed").
            if clientSlot >= 0:
                msquicNativeCurSlot = clientSlot
            let flushClient: Result[bool] = msquicNativeFlushShortPackets(msquicNativeClientSide)
            if IsErr(flushClient):
                msquicNativeResultErrorScratch = ErrorText(flushClient)
                return -1
        if msquicNativeSessionListenerDatapathId > 0:
            # Same discipline on the listener side: server SHORT packets are
            # processed with cur as-is (no CID routing), so cur must be the
            # server session's slot before the poll, not the drifted client slot.
            let serverSlot: int32 = msquicNativeSlotByListenerDatapath(msquicNativeSessionListenerDatapathId)
            # recv 所有权分形态（darwin 零受理回归落地, 归因见
            # docs/campaigns/2026-09-16-csg-semantic-video-standard/results/
            # darwin_quic_regression_triage.md §5 候选 2 落地修订）: 会话在册时
            # listener recv 只准发生在被 bind 到会话槽自身的泵调用里——数据面扫描
            # 循环 (ServeWaitReadable/FetchWaitReadable 等) 以 bind k +
            # AppRecvAvailable (全局 side/stream 键) 定位数据槽并按 k 构造读端,
            # 泵若在别的 bind 上 recv, 数据落 owner 槽而 ks 停在当下 bind, 读端
            # 错槽 = 受理完成后 negotiate 静默死 (darwin RAW 探针实证 ks=3/6 而
            # 会话在 0, conn 恒不打印 / 客户端 negotiate_ack_slot_N)。会话未在册
            # (serverSlot<0, serve-only 入站首个 Initial) 维持 F-H5: 泵可 recv。
            # gate 判定必须先于 cur=owner 重绑, 否则恒真被架空。timer/flush
            # (重传/冲刷) 恒以 owner 槽推进, 两形态都不收缩。
            var listenerRecvAllowed: bool = serverSlot < 0
            if ! listenerRecvAllowed:
                listenerRecvAllowed = msquicNativeCurSlot == serverSlot
            # v2 扫描停靠（darwin_quic_fix 第二版, 层3 定谳: 第一版位置门把
            # ohos 双角色扫描形饿死——QWaitReadable q_listening 形轮首单泵不绑
            # 槽, cur 恒≠serverSlot→全程零 recv→scan_failed spins=3000, 见
            # results/darwin_quic_fix_ohos_regression.md 与 rounds/dor_pub_*.log）。
            # 数据面扫描环扫描窗内声明停靠: park>=0=停靠 bind 槽 / -2=扫描活动
            # 中（等待窗）/ -1=无扫描。停靠期间泵 recv 只准停靠者自己
            # （cur==park）——谁停靠谁读, 泵只在无人停靠时收。v1 位置门保留: 它
            # 是 ks 正确性的承重墙（recv 只在 owner bind 发生→avail 置位与扫描
            # 位置精确对齐→ks≡owner）; 若取消它仅靠 park, 扫描在非 owner bind
            # 的自泵 recv 会让数据落 owner 槽而扫描返回当下 bind, 错槽彩票复
            # 活（逐 bind 推演在 v2 报告 §1）。timer/flush 恒以 owner 槽推进,
            # 两门都不收缩。
            if listenerRecvAllowed && msquicNativeScanParkListener != -1:
                listenerRecvAllowed = msquicNativeCurSlot == msquicNativeScanParkListener
            if serverSlot >= 0:
                msquicNativeCurSlot = serverSlot
            if listenerRecvAllowed:
                let listenerCode: int32 = msquicNativePumpDatapathCode(msquicNativeSessionListenerDatapathId, msquicNativeServerSide)
                if listenerCode < 0:
                    return -1
                if msquicNativeLastPumpReceived:
                    iterReceived = true
                    pumpReceivedAny = true
                if msquicNativeLastPumpDroppedMalformed:
                    continue
                if listenerCode > outcome:
                    outcome = listenerCode
            let rtServer: Result[bool] = msquicNativePumpRetransmit(msquicNativeServerSide)
            if IsErr(rtServer):
                msquicNativeResultErrorScratch = ErrorText(rtServer)
                return -1
            let flushServer: Result[bool] = msquicNativeFlushShortPackets(msquicNativeServerSide)
            if IsErr(flushServer):
                msquicNativeResultErrorScratch = ErrorText(flushServer)
                return -1
        if outcome == msquicNativeProcessOutcomeClientReady:
            msquicNativeLastPumpReceived = pumpReceivedAny
            return outcome
        if ! iterReceived:
            msquicNativeLastPumpReceived = pumpReceivedAny
            return outcome
    msquicNativeLastPumpReceived = pumpReceivedAny
    return outcome

# Event-driven idle wait: block on this side's own UDP fd so an arriving datagram wakes us
# immediately (microsecond latency) instead of a fixed SleepMs gap, then the caller re-pumps.
# Only safe when this process owns exactly ONE role's datapath: if both client AND listener
# datapaths are live in one process (single-process loopback smokes), blocking one fd would
# starve the other role's pump and deadlock, so fall back to a plain 1ms yield there.
fn msquicNativeWaitReadableForSide(side: int32, maxWaitMs: int32) =
    if msquicNativeSessionClientDatapathId > 0 && msquicNativeSessionListenerDatapathId > 0:
        os.SleepMs(1)
        return
    var dpId: int32 = msquicNativeSessionListenerDatapathId
    if side == msquicNativeClientSide:
        dpId = msquicNativeSessionClientDatapathId
    if dpId <= 0:
        os.SleepMs(1)
        return
    let fd: int32 = msquicNativeDatapathUdpFd(dpId)
    if fd < 0:
        os.SleepMs(1)
        return
    let _: int32 = msquicNativeMobileUdpFdWaitReadable(fd, maxWaitMs)

fn msquicNativePump(count: int32): Result[int32] =
    let code: int32 = msquicNativePumpCode(count)
    if code < 0:
        return Err[int32](msquicNativeResultErrorScratch)
    return Ok[int32](code)

fn msquicNativePumpClientBlocking(): Result[int32] =
    if msquicNativeSessionClientDatapathId <= 0:
        return Err[int32]("msquic native: client datapath ! ready")
    var data: rawbytes.Bytes
    var fromAddr: str
    let recvCode: int32 = msquicNativeRecvDatagramDirectInto(msquicNativeSessionClientDatapathId, -1, data, fromAddr)
    if recvCode <= 0:
        return Err[int32]("msquic native: client recv failed")
    let ok: bool = msquicNativeProcessPacketFill(msquicNativeClientSide,
                                                 fromAddr,
                                                 data)
    if ! ok:
        return Err[int32](msquicNativeResultErrorScratch)
    let outcome: int32 = msquicNativeProcessOutcomeScratch
    let rtRes: Result[bool] = msquicNativePumpRetransmit(msquicNativeClientSide)
    if IsErr(rtRes):
        return Err[int32](ErrorText(rtRes))
    return Ok[int32](outcome)

fn msquicNativePumpSideBlocking(side: int32): Result[int32] =
    if side == msquicNativeClientSide:
        return msquicNativePumpClientBlocking()
    if side == msquicNativeServerSide:
        if msquicNativeListenerDatapathId <= 0:
            return Err[int32]("msquic native: listener datapath ! ready")
        var data: rawbytes.Bytes
        var fromAddr: str
        let recvCode: int32 = msquicNativeRecvDatagramDirectInto(msquicNativeListenerDatapathId, -1, data, fromAddr)
        if recvCode <= 0:
            return Err[int32]("msquic native: server recv failed")
        let ok: bool = msquicNativeProcessPacketFill(msquicNativeServerSide,
                                                     fromAddr,
                                                     data)
        if ! ok:
            return Err[int32](msquicNativeResultErrorScratch)
        let outcome: int32 = msquicNativeProcessOutcomeScratch
        let rtRes: Result[bool] = msquicNativePumpRetransmit(msquicNativeServerSide)
        if IsErr(rtRes):
            return Err[int32](ErrorText(rtRes))
        return Ok[int32](outcome)
    return Err[int32]("msquic native: local role ! ready")

fn msquicNativePumpHandshakeBlocking(): Result[bool] =
    let pumpRes: Result[int32] = msquicNativePump(msquicNativePumpBudget)
    if IsErr(pumpRes):
        return Err[bool](ErrorText(pumpRes))
    if msquicNativeSessionReady():
        return Ok[bool](true)
    if gMsQuicSessions[msquicNativeCurSlot].serverReady <= 0:
        let serverRes: Result[int32] = msquicNativePumpSideBlocking(msquicNativeServerSide)
        if IsErr(serverRes):
            return Err[bool](ErrorText(serverRes))
        if msquicNativeSessionReady():
            return Ok[bool](true)
    if gMsQuicSessions[msquicNativeCurSlot].clientReady <= 0:
        let clientRes: Result[int32] = msquicNativePumpSideBlocking(msquicNativeClientSide)
        if IsErr(clientRes):
            return Err[bool](ErrorText(clientRes))
    return Ok[bool](true)

@borrows
fn msquicNativeHandshakeTimeoutMs(settings: msquicruntime.MsQuicSettings): int64 =
    if settings.handshakeIdleTimeoutMs > 0:
        return settings.handshakeIdleTimeoutMs
    return int64(msquicNativeDialReadyTimeoutMs)

# listener 起面加锁外壳（ResetAll/datapath add/start/bind 原子; 全程无
# fd 等待）。Unlocked 体在下方。
@borrows
fn msquicNativeStartListener(addr: multiaddress.MultiAddress, settings: msquicruntime.MsQuicSettings, tlsPolicy: policy.MsQuicTlsPolicy): Result[int32] =
    MsQuicNativeTransportLock()
    let startRes: Result[int32] = msquicNativeStartListenerUnlocked(addr, settings, tlsPolicy)
    MsQuicNativeTransportUnlock()
    return startRes

@borrows
fn msquicNativeStartListenerUnlocked(addr: multiaddress.MultiAddress, settings: msquicruntime.MsQuicSettings, tlsPolicy: policy.MsQuicTlsPolicy): Result[int32] =
    msquicNativeEnsureInit()
    let serverRes: Result[bool] = msquicTlsPolicyValidateForServer(tlsPolicy)
    if IsErr(serverRes):
        return Err[int32](ErrorText(serverRes))
    msquicNativeResetAll()
    var id: int32
    if ! datapath_runtime.MsQuicDatapathGlobalAddCodeInto(0, id):
        return Err[int32]("msquic native: listener datapath add failed")
    if id <= 0:
        return Err[int32]("msquic native: listener datapath add failed")
    if ! datapath_runtime.MsQuicDatapathGlobalStart(id):
        return Err[int32]("msquic native: listener datapath start failed")
    var bindText: str = "/ip4/127.0.0.1/udp/0/quic-v1"
    if len(addr.raw) > 0:
        bindText = addr.raw
    elif BytesLen(addr.data) > 0:
        bindText = BytesToString(addr.data)
    let bindErrText: str = strings.CloneStr(bindText)
    let bindCode: int32 = datapath_runtime.MsQuicDatapathGlobalBindUdpCode(id, bindText)
    if bindCode <= 0:
        return Err[int32](strutil.Join(["msquic native: listener bind failed addr=", share(bindErrText), " err=", datapath_udp.msquicUdpLastBindErrorText()], ""))
    msquicNativeListenerUdpFd = bindCode - 1
    msquicNativeListenerDatapathId = id
    # The serve-loop pump only receives the listener datapath when the *session*
    # listener id is set; the msquicNativeResetSession() above cleared it, so the
    # accept loop skipped recv and the kernel queue filled without the Initial
    # ever being processed. Set it here so serving starts draining immediately.
    msquicNativeSessionListenerDatapathId = id
    msquicNativeListenerRunning = true
    msquicNativeListenerSettings = settings
    msquicNativeListenerTlsPolicy = msquicNativeCopyTlsPolicy(tlsPolicy)
    let boundText: str = datapath_runtime.MsQuicDatapathGlobalUdpAddr(id)
    var boundIsUdpUrl: bool
    if len(boundText) > 0:
        boundIsUdpUrl = msquicNativeStartsWith(boundText, "udp://")
    if boundIsUdpUrl:
        var boundPort: int32
        datapath_runtime.MsQuicDatapathGlobalUdpPortInto(id, boundPort)
        if boundPort > 0:
            let portText: str = IntToStr(boundPort)
            var multiaddrText: str = "/ip4/127.0.0.1/udp/"
            multiaddrText = strutil.Join([ share(multiaddrText), share(portText)], "")
            multiaddrText = strutil.Join([ share(multiaddrText), "/quic-v1"], "")
            MsQuicNativeAssignAddrTextInto(msquicNativeListenAddr, multiaddrText)
        else:
            msquicNativeCopyAddrInto(msquicNativeListenAddr, addr)
    else:
        msquicNativeCopyAddrInto(msquicNativeListenAddr, addr)
    return Ok[int32](id)

@borrows
fn msquicNativeStartListenerDefault(addr: multiaddress.MultiAddress, tlsPolicy: policy.MsQuicTlsPolicy): Result[int32] =
    MsQuicNativeTransportLock()
    let startRes: Result[int32] = msquicNativeStartListenerDefaultUnlocked(addr, tlsPolicy)
    MsQuicNativeTransportUnlock()
    return startRes

@borrows
fn msquicNativeStartListenerDefaultUnlocked(addr: multiaddress.MultiAddress, tlsPolicy: policy.MsQuicTlsPolicy): Result[int32] =
    msquicNativeEnsureInit()
    let serverRes: Result[bool] = msquicTlsPolicyValidateForServer(tlsPolicy)
    if IsErr(serverRes):
        return Err[int32](ErrorText(serverRes))
    msquicNativeResetAll()
    var id: int32
    if ! datapath_runtime.MsQuicDatapathGlobalAddCodeInto(0, id):
        return Err[int32]("msquic native: listener datapath add failed")
    if id <= 0:
        return Err[int32]("msquic native: listener datapath add failed")
    if ! datapath_runtime.MsQuicDatapathGlobalStart(id):
        return Err[int32]("msquic native: listener datapath start failed")
    var bindText: str = "/ip4/127.0.0.1/udp/0/quic-v1"
    if len(addr.raw) > 0:
        bindText = addr.raw
    elif BytesLen(addr.data) > 0:
        bindText = BytesToString(addr.data)
    let bindErrText: str = strings.CloneStr(bindText)
    let bindCode: int32 = datapath_runtime.MsQuicDatapathGlobalBindUdpCode(id, bindText)
    if bindCode <= 0:
        return Err[int32](strutil.Join(["msquic native: listener bind failed addr=", share(bindErrText), " err=", datapath_udp.msquicUdpLastBindErrorText()], ""))
    msquicNativeListenerUdpFd = bindCode - 1
    msquicNativeListenerDatapathId = id
    # The serve-loop pump only receives the listener datapath when the *session*
    # listener id is set; the msquicNativeResetSession() above cleared it, so the
    # accept loop skipped recv and the kernel queue filled without the Initial
    # ever being processed. Set it here so serving starts draining immediately.
    msquicNativeSessionListenerDatapathId = id
    msquicNativeListenerRunning = true
    initMsQuicSettingsInto(msquicNativeListenerSettings)
    msquicNativeListenerTlsPolicy = msquicNativeCopyTlsPolicy(tlsPolicy)
    let boundText: str = datapath_runtime.MsQuicDatapathGlobalUdpAddr(id)
    var boundIsUdpUrl: bool
    if len(boundText) > 0:
        boundIsUdpUrl = msquicNativeStartsWith(boundText, "udp://")
    if boundIsUdpUrl:
        var boundPort: int32
        datapath_runtime.MsQuicDatapathGlobalUdpPortInto(id, boundPort)
        if boundPort > 0:
            let portText: str = IntToStr(boundPort)
            var multiaddrText: str = "/ip4/127.0.0.1/udp/"
            multiaddrText = strutil.Join([ share(multiaddrText), share(portText)], "")
            multiaddrText = strutil.Join([ share(multiaddrText), "/quic-v1"], "")
            MsQuicNativeAssignAddrTextInto(msquicNativeListenAddr, multiaddrText)
        else:
            msquicNativeCopyAddrInto(msquicNativeListenAddr, addr)
    else:
        msquicNativeCopyAddrInto(msquicNativeListenAddr, addr)
    return Ok[int32](id)

fn msquicNativeValidateServerPolicyRef(tlsPolicy: var policy.MsQuicTlsPolicy): Result[bool] =
    if len(tlsPolicy.serverName) <= 0:
        return Err[bool]("msquic tls policy: serverName missing")
    if tlsPolicy.certChainCount <= 0:
        return Err[bool]("msquic tls policy: certificate missing")
    if BytesLen(tlsPolicy.certChain0) <= 0:
        return Err[bool]("msquic tls policy: certificate missing")
    if BytesLen(tlsPolicy.certPrivateKey) <= 0:
        return Err[bool]("msquic tls policy: private key missing")
    if tlsPolicy.certLeafKeyKind == 0:
        return Err[bool]("msquic tls policy: leaf key kind missing")
    if tlsPolicy.requireClientCertificate:
        if tlsPolicy.trustRootsCount <= 0:
            return Err[bool]("msquic tls policy: client certificate trust roots missing")
    return Ok[bool](true)

fn msquicNativeSetListenerTlsPolicyRef(tlsPolicy: var policy.MsQuicTlsPolicy) =
    var localPolicy: policy.MsQuicTlsPolicy
    localPolicy.serverName = strings.CloneStr(tlsPolicy.serverName)
    localPolicy.allowInsecure = tlsPolicy.allowInsecure
    localPolicy.requireClientCertificate = tlsPolicy.requireClientCertificate
    localPolicy.sendClientCertificate = tlsPolicy.sendClientCertificate
    localPolicy.revocationMode = tlsPolicy.revocationMode
    localPolicy.crlCount = tlsPolicy.crlCount
    localPolicy.crl0 = rawbytes.BytesSlice(tlsPolicy.crl0, 0, rawbytes.BytesLen(tlsPolicy.crl0))
    localPolicy.crl1 = rawbytes.BytesSlice(tlsPolicy.crl1, 0, rawbytes.BytesLen(tlsPolicy.crl1))
    localPolicy.crl2 = rawbytes.BytesSlice(tlsPolicy.crl2, 0, rawbytes.BytesLen(tlsPolicy.crl2))
    localPolicy.crl3 = rawbytes.BytesSlice(tlsPolicy.crl3, 0, rawbytes.BytesLen(tlsPolicy.crl3))
    localPolicy.certChainCount = tlsPolicy.certChainCount
    localPolicy.certChain0 = rawbytes.BytesSlice(tlsPolicy.certChain0, 0, rawbytes.BytesLen(tlsPolicy.certChain0))
    localPolicy.certChain1 = rawbytes.BytesSlice(tlsPolicy.certChain1, 0, rawbytes.BytesLen(tlsPolicy.certChain1))
    localPolicy.certChain2 = rawbytes.BytesSlice(tlsPolicy.certChain2, 0, rawbytes.BytesLen(tlsPolicy.certChain2))
    localPolicy.certChain3 = rawbytes.BytesSlice(tlsPolicy.certChain3, 0, rawbytes.BytesLen(tlsPolicy.certChain3))
    localPolicy.certPrivateKey = rawbytes.BytesSlice(tlsPolicy.certPrivateKey, 0, rawbytes.BytesLen(tlsPolicy.certPrivateKey))
    localPolicy.certLeafKeyKind = tlsPolicy.certLeafKeyKind
    localPolicy.trustRootsCount = tlsPolicy.trustRootsCount
    localPolicy.trustRoot0 = rawbytes.BytesSlice(tlsPolicy.trustRoot0, 0, rawbytes.BytesLen(tlsPolicy.trustRoot0))
    localPolicy.trustRoot1 = rawbytes.BytesSlice(tlsPolicy.trustRoot1, 0, rawbytes.BytesLen(tlsPolicy.trustRoot1))
    localPolicy.trustRoot2 = rawbytes.BytesSlice(tlsPolicy.trustRoot2, 0, rawbytes.BytesLen(tlsPolicy.trustRoot2))
    localPolicy.trustRoot3 = rawbytes.BytesSlice(tlsPolicy.trustRoot3, 0, rawbytes.BytesLen(tlsPolicy.trustRoot3))
    msquicNativeListenerTlsPolicy = localPolicy

@borrows
fn msquicNativeStartListenerDefaultRef(addr: multiaddress.MultiAddress, tlsPolicy: var policy.MsQuicTlsPolicy): Result[int32] =
    MsQuicNativeTransportLock()
    let startRes: Result[int32] = msquicNativeStartListenerDefaultRefUnlocked(addr, tlsPolicy)
    MsQuicNativeTransportUnlock()
    return startRes

@borrows
fn msquicNativeStartListenerDefaultRefUnlocked(addr: multiaddress.MultiAddress, tlsPolicy: var policy.MsQuicTlsPolicy): Result[int32] =
    msquicNativeEnsureInit()
    let serverRes: Result[bool] = msquicNativeValidateServerPolicyRef(tlsPolicy)
    if IsErr(serverRes):
        return Err[int32](ErrorText(serverRes))
    msquicNativeResetAll()
    var id: int32
    if ! datapath_runtime.MsQuicDatapathGlobalAddCodeInto(0, id):
        return Err[int32]("msquic native: listener datapath add failed")
    if id <= 0:
        return Err[int32]("msquic native: listener datapath add failed")
    if ! datapath_runtime.MsQuicDatapathGlobalStart(id):
        return Err[int32]("msquic native: listener datapath start failed")
    var bindText: str = "/ip4/127.0.0.1/udp/0/quic-v1"
    if len(addr.raw) > 0:
        bindText = addr.raw
    elif BytesLen(addr.data) > 0:
        bindText = BytesToString(addr.data)
    let bindErrText: str = strings.CloneStr(bindText)
    let bindCode: int32 = datapath_runtime.MsQuicDatapathGlobalBindUdpCode(id, bindText)
    if bindCode <= 0:
        return Err[int32](strutil.Join(["msquic native: listener bind failed addr=", share(bindErrText), " err=", datapath_udp.msquicUdpLastBindErrorText()], ""))
    msquicNativeListenerUdpFd = bindCode - 1
    msquicNativeListenerDatapathId = id
    # The serve-loop pump only receives the listener datapath when the *session*
    # listener id is set; the msquicNativeResetSession() above cleared it, so the
    # accept loop skipped recv and the kernel queue filled without the Initial
    # ever being processed. Set it here so serving starts draining immediately.
    msquicNativeSessionListenerDatapathId = id
    msquicNativeListenerRunning = true
    initMsQuicSettingsInto(msquicNativeListenerSettings)
    msquicNativeSetListenerTlsPolicyRef(tlsPolicy)
    let boundText: str = datapath_runtime.MsQuicDatapathGlobalUdpAddr(id)
    var boundIsUdpUrl: bool
    if len(boundText) > 0:
        boundIsUdpUrl = msquicNativeStartsWith(boundText, "udp://")
    if boundIsUdpUrl:
        var boundPort: int32
        datapath_runtime.MsQuicDatapathGlobalUdpPortInto(id, boundPort)
        if boundPort > 0:
            let portText: str = IntToStr(boundPort)
            var multiaddrText: str = "/ip4/127.0.0.1/udp/"
            multiaddrText = strutil.Join([ share(multiaddrText), share(portText)], "")
            multiaddrText = strutil.Join([ share(multiaddrText), "/quic-v1"], "")
            MsQuicNativeAssignAddrTextInto(msquicNativeListenAddr, multiaddrText)
        else:
            msquicNativeCopyAddrInto(msquicNativeListenAddr, addr)
    else:
        msquicNativeCopyAddrInto(msquicNativeListenAddr, addr)
    return Ok[int32](id)

# listener 停面加锁外壳。
fn msquicNativeStopListener() =
    MsQuicNativeTransportLock()
    msquicNativeStopListenerUnlocked()
    MsQuicNativeTransportUnlock()

fn msquicNativeStopListenerUnlocked() =
    msquicNativeEnsureInit()
    if msquicNativeListenerDatapathId > 0:
        datapath_runtime.MsQuicDatapathGlobalUnbindUdp(msquicNativeListenerDatapathId)
    datapath_runtime.MsQuicDatapathGlobalInit()
    msquicNativeListenerRunning = false
    msquicNativeListenerDatapathId = 0
    MsQuicNativeEmptyAddrInto(msquicNativeListenAddr)

fn msquicNativeListenerStartErrorText(code: int32): str =
    if code == -1:
        return "msquic tls policy: serverName missing"
    if code == -2:
        return "msquic tls policy: certificate missing"
    if code == -3:
        return "msquic tls policy: private key missing"
    if code == -4:
        return "msquic native: listener datapath add failed"
    if code == -5:
        return "msquic native: listener datapath start failed"
    if code == -6:
        return "msquic native: listener bind failed"
    return "msquic native: listener start failed"

# ServerInputs listener 起面加锁外壳。
fn msquicNativeStartListenerServerInputsCode(
    addr: multiaddress.MultiAddress,
    settings: msquicruntime.MsQuicSettings,
    serverName: str,
    certDer: rawbytes.Bytes,
    keyDer: rawbytes.Bytes
): int32 =
    MsQuicNativeTransportLock()
    let code: int32 = msquicNativeStartListenerServerInputsCodeUnlocked(addr, settings, serverName, certDer, keyDer)
    MsQuicNativeTransportUnlock()
    return code

fn msquicNativeStartListenerServerInputsCodeUnlocked(
    addr: multiaddress.MultiAddress,
    settings: msquicruntime.MsQuicSettings,
    serverName: str,
    certDer: rawbytes.Bytes,
    keyDer: rawbytes.Bytes
): int32 =
    if ! msquicNativeReady:
        datapath_runtime.MsQuicDatapathGlobalInit()
        initMsQuicSettingsInto(msquicNativeListenerSettings)
        MsQuicNativeEmptyAddrInto(msquicNativeListenAddr)
        msquicNativeListenerRunning = false
        msquicNativeListenerDatapathId = 0
        msquicNativeAcceptPending = false
        msquicNativeDropNextAppSend = false
        msquicNativeLocalRole = msquicNativeRoleNone
        msquicNativeReady = true
    if len(serverName) <= 0:
        return -1
    if BytesLen(certDer) <= 0:
        return -2
    if BytesLen(keyDer) <= 0:
        return -3
    msquicNativeResetAll()
    initMsQuicSettingsInto(msquicNativeListenerSettings)
    var id: int32
    if ! datapath_runtime.MsQuicDatapathGlobalAddCodeInto(0, id):
        return -4
    if id <= 0:
        return -4
    if ! datapath_runtime.MsQuicDatapathGlobalStart(id):
        return -5
    var bindText: str = "/ip4/127.0.0.1/udp/0/quic-v1"
    if len(addr.raw) > 0:
        bindText = addr.raw
    elif BytesLen(addr.data) > 0:
        bindText = BytesToString(addr.data)
    let bindCode: int32 = datapath_runtime.MsQuicDatapathGlobalBindUdpCode(id, bindText)
    if bindCode <= 0:
        return -6
    msquicNativeListenerUdpFd = bindCode - 1
    msquicNativeListenerDatapathId = id
    # The serve-loop pump only receives the listener datapath when the *session*
    # listener id is set; the msquicNativeResetSession() above cleared it, so the
    # accept loop skipped recv and the kernel queue filled without the Initial
    # ever being processed. Set it here so serving starts draining immediately.
    msquicNativeSessionListenerDatapathId = id
    msquicNativeListenerRunning = true
    msquicNativeListenerSettings = settings
    let boundText: str = datapath_runtime.MsQuicDatapathGlobalUdpAddr(id)
    var boundIsUdpUrl: bool
    if len(boundText) > 0:
        boundIsUdpUrl = msquicNativeStartsWith(boundText, "udp://")
    if boundIsUdpUrl:
        var boundPort: int32
        datapath_runtime.MsQuicDatapathGlobalUdpPortInto(id, boundPort)
        if boundPort > 0:
            let host: str = "127.0.0.1"
            let portText: str = IntToStr(boundPort)
            var multiaddrText: str = "/ip4/"
            multiaddrText = strutil.Join([multiaddrText, host], "")
            multiaddrText = strutil.Join([multiaddrText, "/udp/"], "")
            multiaddrText = strutil.Join([multiaddrText, portText], "")
            multiaddrText = strutil.Join([multiaddrText, "/quic-v1"], "")
            MsQuicNativeAssignAddrTextInto(msquicNativeListenAddr, multiaddrText)
        else:
            msquicNativeCopyAddrInto(msquicNativeListenAddr, addr)
    else:
        msquicNativeCopyAddrInto(msquicNativeListenAddr, addr)
    return id

fn msquicNativeStartListenerServerInputs(
    addr: multiaddress.MultiAddress,
    settings: msquicruntime.MsQuicSettings,
    serverName: str,
    certDer: rawbytes.Bytes,
    keyDer: rawbytes.Bytes
): Result[int32] =
    let code: int32 = msquicNativeStartListenerServerInputsCode(addr, settings, serverName, certDer, keyDer)
    if code > 0:
        return Ok[int32](code)
    return Err[int32](msquicNativeListenerStartErrorText(code))

fn msquicNativeStartListenerServerInputsMust(
    addr: multiaddress.MultiAddress,
    settings: msquicruntime.MsQuicSettings,
    serverName: str,
    certDer: rawbytes.Bytes,
    keyDer: rawbytes.Bytes
): int32 =
    let startRes: Result[int32] = msquicNativeStartListenerServerInputs(addr, settings, serverName, certDer, keyDer)
    if IsErr(startRes):
        panic(ErrorText(startRes))
    return Value(startRes)

fn msquicNativeDialAllocClientDatapath(): Result[int32] =
    var clientId: int32
    if ! datapath_runtime.MsQuicDatapathGlobalAddCodeInto(0, clientId):
        return Err[int32]("msquic native dial: datapath add failed")
    if clientId <= 0:
        return Err[int32]("msquic native dial: datapath add failed")
    return Ok[int32](clientId)

fn msquicNativeDialStartClientDatapath(clientId: int32): Result[bool] =
    if ! datapath_runtime.MsQuicDatapathGlobalStart(clientId):
        return Err[bool]("msquic native dial: datapath start failed")
    return Ok[bool](true)

fn msquicNativeDialBindUdp(clientId: int32, bindText: str): Result[bool] =
    let bindCode: int32 = datapath_runtime.MsQuicDatapathGlobalBindUdpCode(clientId, bindText)
    if bindCode <= 0:
        return Err[bool]("msquic native dial: datapath bind failed")
    msquicNativeClientUdpFd = bindCode - 1
    return Ok[bool](true)

@borrows
fn msquicNativeDialSetupSession(
    clientId: int32,
    clientSettings: msquicruntime.MsQuicSettings,
    clientTlsPolicy: policy.MsQuicTlsPolicy,
    addr: multiaddress.MultiAddress
): Result[bool] =
    msquicNativeDebugWriteLine("msquic native debug: setup remote text")
    var remoteAddrText: str = "/ip4/127.0.0.1/udp/0/quic-v1"
    if len(addr.raw) > 0:
        remoteAddrText = strings.CloneStr(addr.raw)
    elif BytesLen(addr.data) > 0:
        remoteAddrText = BytesToString(addr.data)
    if msquicNativeDebugTls13:
        msquicNativeDebugWriteLine(strutil.Join(["msquic native debug: setup remote=", strings.CloneStr(remoteAddrText)], ""))
    msquicNativeDebugWriteLine("msquic native debug: setup reset")
    msquicNativeResetSession()
    var clientSettingsLocal = clientSettings
    msquicNativeLocalRole = msquicNativeRoleClient
    gMsQuicSessions[msquicNativeCurSlot].active = true
    gMsQuicSessions[msquicNativeCurSlot].clientSettings = clientSettingsLocal
    msquicNativeSetSessionListenAddr(msquicNativeListenAddr)
    msquicNativeSetSessionDialAddr(addr)
    msquicNativeDebugWriteLine("msquic native debug: setup policy cache")
    msquicNativeSetClientPolicyCache(clientTlsPolicy)
    msquicNativeResetServerPolicyCache()
    gMsQuicSessions[msquicNativeCurSlot].listenerDatapathId = 0
    gMsQuicSessions[msquicNativeCurSlot].clientDatapathId = clientId
    msquicNativeSessionListenerDatapathId = 0
    msquicNativeSessionClientDatapathId = clientId
    gMsQuicSessions[msquicNativeCurSlot].listenerAddrText = remoteAddrText
    gMsQuicSessions[msquicNativeCurSlot].clientAddrText = datapath_runtime.MsQuicDatapathGlobalUdpAddr(clientId)
    msquicNativeAssignFreshSessionCids()
    msquicNativeDebugWriteLine("msquic native debug: setup parse client addr")
    let clientAddrRes = parseMultiAddress(gMsQuicSessions[msquicNativeCurSlot].clientAddrText)
    var clientAddr = MsQuicNativeEmptyAddr()
    if IsOk(clientAddrRes):
        clientAddr = Value(clientAddrRes)
    if msquicNativeListenerRunning && msquicNativeListenerDatapathId > 0:
        gMsQuicSessions[msquicNativeCurSlot].listenerDatapathId = msquicNativeListenerDatapathId
        msquicNativeSessionListenerDatapathId = msquicNativeListenerDatapathId
    msquicNativeDebugWriteLine("msquic native debug: setup reset endpoint")
    msquicNativeResetClientEndpoint(clientSettingsLocal, true)
    msquicNativeDebugWriteLine("msquic native debug: setup trust roots")
    handshake13.msquicTls13ClientSetServerName(gMsQuicSessions[msquicNativeCurSlot].clientServerNameCache)
    handshake13.msquicTls13ClientClearTrustRoots()
    for i in 0..<gMsQuicSessions[msquicNativeCurSlot].clientTrustRootsCountCache:
        var trustRootBorrow: Bytes = msquicNativeClientTrustRootAtCache(i)
        let addRes: Result[bool] = handshake13.msquicTls13ClientAddTrustRoot(trustRootBorrow)
        if IsErr(addRes):
            return Err[bool](ErrorText(addRes))
    msquicNativeDebugWriteLine("msquic native debug: setup done")
    return Ok[bool](true)

fn msquicNativeDialSendHello(): Result[bool] =
    return msquicNativeSendClientHello()

fn msquicNativeDialPumpReadyCode(): int32 =
    # Pin the dial's own session slot: the pump now rebinds cur per datapath
    # (dual-role), so after each pump iteration cur may point at the server
    # session — the dial's readiness must still be read from ITS slot.
    let dialSlot: int32 = msquicNativeCurSlot
    let deadlineMs: int64 = MsQuicNativeNowMs() + msquicNativeHandshakeTimeoutMs(gMsQuicSessions[dialSlot].clientSettings)
    var loops: int32
    while MsQuicNativeNowMs() <= deadlineMs:
        let pumpCode: int32 = msquicNativePumpCode(msquicNativePumpBudget)
        # 泵的 recv 所有权 gate (见 msquicNativePumpCodeUnlocked) 以"bound cur 即
        # 本 datapath 会话槽"为准; dual-role 下 listener 分支会在泵调用内把 cur
        # 重绑到 server 槽, 此处每轮重钉回 dial 槽, 保证下一轮 client 分支仍可
        # recv (拨号半环是这些泵调用的所有者)。
        msquicNativeCurSlot = dialSlot
        loops = loops + 1
        if pumpCode > 0 || gMsQuicSessions[dialSlot].clientReady > 0 || gMsQuicSessions[dialSlot].serverReady > 0:
            var acceptPendingCode: int32
            if msquicNativeAcceptPending:
                acceptPendingCode = 1
            if msquicNativeDebugTls13:
                var pumpText: str = "msquic_native_dial_pump_state loop="
                pumpText = strutil.Join([ share(pumpText), IntToStr(loops)], "")
                pumpText = strutil.Join([ share(pumpText), " pump_code="], "")
                pumpText = strutil.Join([ share(pumpText), IntToStr(pumpCode)], "")
                pumpText = strutil.Join([ share(pumpText), " client_ready="], "")
                pumpText = strutil.Join([ share(pumpText), IntToStr(gMsQuicSessions[msquicNativeCurSlot].clientReady)], "")
                pumpText = strutil.Join([ share(pumpText), " server_ready="], "")
                pumpText = strutil.Join([ share(pumpText), IntToStr(gMsQuicSessions[msquicNativeCurSlot].serverReady)], "")
                pumpText = strutil.Join([ share(pumpText), " accept_pending="], "")
                pumpText = strutil.Join([ share(pumpText), IntToStr(acceptPendingCode)], "")
                pumpText = strutil.Join([ share(pumpText), " local_role="], "")
                pumpText = strutil.Join([ share(pumpText), IntToStr(msquicNativeLocalRole)], "")
                msquicNativeDebugWriteLine(pumpText)
        if pumpCode < 0:
            return -1
        if pumpCode == msquicNativeProcessOutcomeClientReady:
            if msquicNativeDebugTls13:
                msquicNativeDebugWriteLine("msquic_native_debug dial_return=client_ready")
            msquicNativeQueueAcceptIfReady()
        if gMsQuicSessions[dialSlot].clientReady > 0:
            return 1
        if msquicNativeDialReadyForReturn():
            msquicNativeQueueAcceptIfReady()
            return 1
        if MsQuicNativeNowMs() <= deadlineMs:
            let clientFd: int32 = msquicNativeDatapathUdpFd(msquicNativeSessionClientDatapathId)
            if clientFd >= 0:
                let waitRc: int32 = msquicNativeMobileUdpFdWaitReadable(clientFd, 10)
                msquicNativeUdpDebugEvent(10, clientFd, 10, waitRc, 0)
            else:
                os.SleepMs(1)
    msquicNativeResultErrorScratch = "msquic native: handshake ! ready"
    return -1

fn msquicNativeDialPumpReady(): Result[int32] =
    let code: int32 = msquicNativeDialPumpReadyCode()
    if code < 0:
        return Err[int32](msquicNativeResultErrorScratch)
    return Ok[int32](code)

fn msquicNativeStopClientDatapathIfAny() =
    # Prefer the session slot's own clientDatapathId: the process-global id is
    # only set at SetupSession time, so a dial that fails at Start/Bind has a
    # live datapath recorded ONLY on the slot column. Falling back to the
    # global keeps the post-Setup paths behaving exactly as before.
    var stopId: int32 = gMsQuicSessions[msquicNativeCurSlot].clientDatapathId
    if stopId <= 0:
        stopId = msquicNativeSessionClientDatapathId
    if stopId <= 0:
        return
    datapath_runtime.MsQuicDatapathGlobalUnbindUdp(stopId)
    let _ = datapath_runtime.MsQuicDatapathGlobalStopCode(stopId)
    gMsQuicSessions[msquicNativeCurSlot].clientDatapathId = 0
    msquicNativeSessionClientDatapathId = 0
    msquicNativeClientUdpFd = -1

fn msquicNativeAbortDialAttempt() =
    gMsQuicSessions[msquicNativeCurSlot].closed = true
    msquicNativeStopClientDatapathIfAny()
    msquicNativeAcceptPending = false
    msquicNativeResetSession()

fn msquicNativeRecycleClosedSession() =
    if ! gMsQuicSessions[msquicNativeCurSlot].active:
        return
    if ! gMsQuicSessions[msquicNativeCurSlot].closed:
        return
    msquicNativeStopClientDatapathIfAny()
    msquicNativeAcceptPending = false
    msquicNativeResetSession()

@borrows
fn msquicNativeDial(clientSettings: msquicruntime.MsQuicSettings, clientTlsPolicy: policy.MsQuicTlsPolicy, addr: multiaddress.MultiAddress): Result[int32] =
    let dialStartedAtMs: int64 = MsQuicNativeNowMs()
    msquicNativeDebugWriteLine("msquic native debug: dial enter")
    # dial 前奏（EnsureInit→Recycle→SlotFindFree→cur=槽→Reset/Setup/Hello）
    # 整段持锁: 否则 T_SERVE 的 accept/pump span 会在 Setup 与 Hello 之间
    # 把 ResetServerPolicyCache 过的槽整槽重置/翻走 cur。就绪轮（pump+fd
    # 等待）在锁外, pump 自锁。
    MsQuicNativeTransportLock()
    msquicNativeEnsureInit()
    msquicNativeRecycleClosedSession()
    # Multi-slot dial: pick a free session slot before the active-session guard.
    # For N=1 the first dial finds slot 0 free, so msquicNativeCurSlot stays 0 and
    # the path is bit-identical to the single-slot baseline.
    let dialFreeSlot: int32 = msquicNativeSlotFindFree()
    if dialFreeSlot < 0:
        MsQuicNativeTransportUnlock()
        return Err[int32]("msquic native: all session slots busy")
    msquicNativeCurSlot = dialFreeSlot
    # dial 前奏即锚定 Client 角色槽（锁内, 原子）: client hello/flight 早于
    # dial 尾写, SendWire 角色锚点取址依赖此写先行存在。
    msquicNativeLastClientSessionSlot = dialFreeSlot
    # A previous dial that stalled (e.g. handshake never confirmed because the
    # HANDSHAKE_DONE path dropped) leaves a half-open client session that was
    # never marked closed. Without this it would block every subsequent dial with
    # "active session exists" until the process is cold-restarted (the observed
    # self-heal). If the lingering session is not ready (handshake never
    # completed), it is dead: abort and recycle it so we can dial fresh. A
    # genuinely ready session is left intact and still rejected below.
    if gMsQuicSessions[msquicNativeCurSlot].active && ! gMsQuicSessions[msquicNativeCurSlot].closed && ! msquicNativeSessionReady():
        if msquicNativeDebugTls13:
            msquicNativeDebugWriteLine("msquic_native_debug dial_abort_stalled_session")
        msquicNativeAbortDialAttempt()
    if gMsQuicSessions[msquicNativeCurSlot].active && ! gMsQuicSessions[msquicNativeCurSlot].closed:
        MsQuicNativeTransportUnlock()
        return Err[int32]("msquic native: active session exists")
    let validateStartedAtMs: int64 = MsQuicNativeNowMs()
    msquicNativeDebugWriteLine("msquic native debug: validate client policy")
    let clientRes: Result[bool] = msquicTlsPolicyValidateForClient(clientTlsPolicy)
    if IsErr(clientRes):
        MsQuicNativeTransportUnlock()
        return Err[int32](ErrorText(clientRes))
    let validateCompletedAtMs: int64 = MsQuicNativeNowMs()
    let allocStartedAtMs: int64 = MsQuicNativeNowMs()
    msquicNativeDebugWriteLine("msquic native debug: alloc datapath")
    let clientIdRes: Result[int32] = msquicNativeDialAllocClientDatapath()
    if IsErr(clientIdRes):
        MsQuicNativeTransportUnlock()
        return Err[int32](ErrorText(clientIdRes))
    let clientId: int32 = Value(clientIdRes)
    # Record the freshly-allocated datapath on the session slot IMMEDIATELY:
    # abort's stop path keys off this column, and a Start/Bind failure below
    # would otherwise leak the datapath slot (global id is still 0 until
    # SetupSession), permanently burning one of maxMsQuicDatapaths entries per
    # failed dial until the table fills and every later dial fails locally.
    gMsQuicSessions[msquicNativeCurSlot].clientDatapathId = clientId
    let allocCompletedAtMs: int64 = MsQuicNativeNowMs()
    let startStartedAtMs: int64 = MsQuicNativeNowMs()
    msquicNativeDebugWriteLine("msquic native debug: start datapath")
    let startRes: Result[bool] = msquicNativeDialStartClientDatapath(clientId)
    if IsErr(startRes):
        msquicNativeAbortDialAttempt()
        MsQuicNativeTransportUnlock()
        return Err[int32](ErrorText(startRes))
    let startCompletedAtMs: int64 = MsQuicNativeNowMs()
    var remoteAddrText: str = "/ip4/127.0.0.1/udp/0/quic-v1"
    if len(addr.raw) > 0:
        remoteAddrText = addr.raw
    elif BytesLen(addr.data) > 0:
        remoteAddrText = BytesToString(addr.data)
    var bindText: str = "/ip4/0.0.0.0/udp/0/quic-v1"
    if msquicNativeStartsWith(remoteAddrText, "/ip6/"):
        bindText = "/ip6/::/udp/0/quic-v1"
    elif msquicNativeStartsWith(remoteAddrText, "udp://["):
        bindText = "/ip6/::/udp/0/quic-v1"
    elif msquicNativeStartsWith(remoteAddrText, "/ip4/127.0.0.1/"):
        # Dialing a loopback peer: bind the client to loopback too. On Android's
        # per-UID fwmark routing, a 0.0.0.0-bound socket sends 127.0.0.1 out the
        # default network (dropped) instead of via lo; a loopback-bound source
        # forces the lo route so the two on-device processes actually exchange.
        bindText = "/ip4/127.0.0.1/udp/0/quic-v1"
    let bindStartedAtMs: int64 = MsQuicNativeNowMs()
    if msquicNativeDebugTls13:
        msquicNativeDebugWriteLine(strutil.Join(["msquic native debug: bind datapath ", strings.CloneStr(bindText)], ""))
    let bindRes: Result[bool] = msquicNativeDialBindUdp(clientId, bindText)
    if IsErr(bindRes):
        msquicNativeAbortDialAttempt()
        MsQuicNativeTransportUnlock()
        return Err[int32](ErrorText(bindRes))
    if !datapath_runtime.MsQuicDatapathGlobalUdpBound(clientId):
        msquicNativeAbortDialAttempt()
        MsQuicNativeTransportUnlock()
        return Err[int32]("msquic native dial: bind lost")
    let bindCompletedAtMs: int64 = MsQuicNativeNowMs()
    # DialSetupSession runs msquicNativeResetSession() which clears
    # msquicNativeClientUdpFd to -1, but the bound client datapath socket
    # stays bound (verified below). Preserve the just-bound fd and restore it
    # after setup so the handshake send/recv have a valid client fd instead of
    # failing with "datapath recv failed" (fd<0).
    let savedClientUdpFd: int32 = msquicNativeClientUdpFd
    let setupStartedAtMs: int64 = MsQuicNativeNowMs()
    msquicNativeDebugWriteLine("msquic native debug: setup session")
    let setupRes: Result[bool] = msquicNativeDialSetupSession(clientId, clientSettings, clientTlsPolicy, addr)
    if IsErr(setupRes):
        msquicNativeAbortDialAttempt()
        MsQuicNativeTransportUnlock()
        return Err[int32](ErrorText(setupRes))
    if !datapath_runtime.MsQuicDatapathGlobalUdpBound(clientId):
        msquicNativeAbortDialAttempt()
        MsQuicNativeTransportUnlock()
        return Err[int32]("msquic native dial: bind lost after setup")
    msquicNativeClientUdpFd = savedClientUdpFd
    let setupCompletedAtMs: int64 = MsQuicNativeNowMs()
    let helloStartedAtMs: int64 = MsQuicNativeNowMs()
    msquicNativeDebugWriteLine("msquic native debug: send hello")
    let helloRes: Result[bool] = msquicNativeDialSendHello()
    if IsErr(helloRes):
        msquicNativeAbortDialAttempt()
        MsQuicNativeTransportUnlock()
        return Err[int32](ErrorText(helloRes))
    # 前奏到此完成: 就绪轮（pump 自锁 + fd 等待锁外）不放锁内执行。
    MsQuicNativeTransportUnlock()
    let helloCompletedAtMs: int64 = MsQuicNativeNowMs()
    let pumpStartedAtMs: int64 = MsQuicNativeNowMs()
    msquicNativeDebugWriteLine("msquic native debug: pump ready")
    let readyCode: int32 = msquicNativeDialPumpReadyCode()
    if readyCode < 0:
        MsQuicNativeTransportLock()
        msquicNativeAbortDialAttempt()
        let pumpErrText: str = strings.CloneStr(msquicNativeResultErrorScratch)
        MsQuicNativeTransportUnlock()
        return Err[int32](pumpErrText)
    let pumpCompletedAtMs: int64 = MsQuicNativeNowMs()
    let dialCompletedAtMs: int64 = MsQuicNativeNowMs()
    if msquicNativeDebugTls13:
        var dialTimingText: str = "msquic_native_dial_timing_ms validate="
        dialTimingText = strutil.Join([ share(dialTimingText), int64ToStr(validateCompletedAtMs - validateStartedAtMs)], "")
        dialTimingText = strutil.Join([ share(dialTimingText), " alloc="], "")
        dialTimingText = strutil.Join([ share(dialTimingText), int64ToStr(allocCompletedAtMs - allocStartedAtMs)], "")
        dialTimingText = strutil.Join([ share(dialTimingText), " start="], "")
        dialTimingText = strutil.Join([ share(dialTimingText), int64ToStr(startCompletedAtMs - startStartedAtMs)], "")
        dialTimingText = strutil.Join([ share(dialTimingText), " bind="], "")
        dialTimingText = strutil.Join([ share(dialTimingText), int64ToStr(bindCompletedAtMs - bindStartedAtMs)], "")
        dialTimingText = strutil.Join([ share(dialTimingText), " setup="], "")
        dialTimingText = strutil.Join([ share(dialTimingText), int64ToStr(setupCompletedAtMs - setupStartedAtMs)], "")
        dialTimingText = strutil.Join([ share(dialTimingText), " hello="], "")
        dialTimingText = strutil.Join([ share(dialTimingText), int64ToStr(helloCompletedAtMs - helloStartedAtMs)], "")
        dialTimingText = strutil.Join([ share(dialTimingText), " pump="], "")
        dialTimingText = strutil.Join([ share(dialTimingText), int64ToStr(pumpCompletedAtMs - pumpStartedAtMs)], "")
        dialTimingText = strutil.Join([ share(dialTimingText), " total="], "")
        dialTimingText = strutil.Join([ share(dialTimingText), int64ToStr(dialCompletedAtMs - dialStartedAtMs)], "")
        msquicNativeDebugWriteLine(dialTimingText)
    # The ready pump polls BOTH datapaths and can rebind msquicNativeCurSlot to
    # another live session (dual-role relay: the listener datapath). PipeIdxForSession
    # derives the new conn's pipe from the CURRENT slot, so a stale cur would tag the
    # dialed conn's pipe with the wrong session — its later close would then reset
    # the other session (observed: relay's upstream close killed the subscriber
    # session). Re-bind cur to THIS dial's slot before returning so the caller's
    # newNativeConnectionPair tags the pipe correctly. dial 尾持锁写 Client
    # 角色槽（accept 尾写 Server 槽, 两线程各写各的角色槽不再互踩）。
    MsQuicNativeTransportLock()
    msquicNativeCurSlot = dialFreeSlot
    msquicNativeLastClientSessionSlot = dialFreeSlot
    MsQuicNativeTransportUnlock()
    return Ok[int32](readyCode)

# accept 判读 helper: recv（锁外）之后 处理+判读+回收 在一个锁 span 内完成,
# 消除 accept 轮与 T_FETCH dial/pump 的交错窗口。返回码:
#   0 = 继续轮询; 1 = accept 完成（Server 角色槽已锚定）; -1 = Err（文本在
#   msquicNativeAcceptErrScratch, 持锁内定格）。
var
    msquicNativeAcceptErrScratch: str

fn msquicNativeAcceptJudge(data: rawbytes.Bytes, fromAddr: str): int32 =
    let procOk: bool = msquicNativeProcessPacketFill(msquicNativeServerSide,
                                                     fromAddr,
                                                     data)
    var judgeStatus: int32
    MsQuicNativeTransportLock()
    if ! procOk:
        if msquicNativeDebugTls13:
            var dbgJudgeErr: str = strings.CloneStr(msquicNativeResultErrorScratch)
            msquicNativeDebugWriteLine(strutil.Join(["msquic native debug: accept judge process err=", share(dbgJudgeErr)], ""))
        msquicNativeAcceptErrScratch = strings.CloneStr(msquicNativeResultErrorScratch)
        gMsQuicSessions[msquicNativeCurSlot].closed = true
        msquicNativeRecycleClosedSession()
        judgeStatus = -1
    else:
        let procOutcome: int32 = msquicNativeProcessOutcomeScratch
        if procOutcome == msquicNativeProcessOutcomeServerAccept:
            msquicNativeAcceptPending = false
            msquicNativeLastServerSessionSlot = msquicNativeCurSlot
            if msquicNativeDebugTls13:
                msquicNativeDebugWriteLine("msquic_native_debug accept_return=proc")
            judgeStatus = 1
        elif msquicNativeAcceptReady():
            msquicNativeAcceptPending = false
            msquicNativeLastServerSessionSlot = msquicNativeCurSlot
            if msquicNativeDebugTls13:
                msquicNativeDebugWriteLine("msquic_native_debug accept_return=ready")
            judgeStatus = 1
        elif gMsQuicSessions[msquicNativeCurSlot].closed:
            msquicNativeRecycleClosedSession()
            judgeStatus = 0
        else:
            judgeStatus = 0
    MsQuicNativeTransportUnlock()
    return judgeStatus

fn msquicNativeAcceptBlocking(): Result[int32] =
    while true:
        var data: rawbytes.Bytes
        var fromAddr: str
        let recvCode: int32 = msquicNativeRecvDatagramDirectInto(msquicNativeListenerDatapathId, -1, data, fromAddr)
        if recvCode <= 0:
            if recvCode < 0:
                return Err[int32]("msquic native: datapath recv failed")
            os.SleepMs(1)
            continue
        var blockingFirst: int32
        if BytesLen(data) > 0:
            blockingFirst = BytesGet(data, 0)
        if msquicNativeDebugTls13:
            msquicNativeDebugWriteLine(strutil.Join(["msquic native debug: accept blocking recv len=", IntToStr(BytesLen(data)), " first=", IntToStr(blockingFirst), " from=", share(fromAddr)], ""))
        let judgeCode: int32 = msquicNativeAcceptJudge(data, fromAddr)
        if judgeCode < 0:
            return Err[int32](strings.CloneStr(msquicNativeAcceptErrScratch))
        if judgeCode == 1:
            return Ok[int32](1)
    return Err[int32]("msquic native: accept failed")

# AcceptTimed 判读 helper（处理+判读+回收同 span）: 0=继续; 1=Ok(1);
# 2=Ok(0) idle 超时; -1=Err（文本在 msquicNativeAcceptErrScratch）。
fn msquicNativeAcceptJudgeTimed(data: rawbytes.Bytes,
                                fromAddr: str,
                                handshakeDeadlineMs: var int64,
                                idleDeadlineMs: int64): int32 =
    let procOk: bool = msquicNativeProcessPacketFill(msquicNativeServerSide,
                                                     fromAddr,
                                                     data)
    var judgeStatus: int32
    MsQuicNativeTransportLock()
    if ! procOk:
        if msquicNativeDebugTls13:
            var dbgTimedErr: str = strings.CloneStr(msquicNativeResultErrorScratch)
            msquicNativeDebugWriteLine(strutil.Join(["msquic native debug: accept process err=", share(dbgTimedErr)], ""))
        msquicNativeAcceptErrScratch = strings.CloneStr(msquicNativeResultErrorScratch)
        gMsQuicSessions[msquicNativeCurSlot].closed = true
        msquicNativeRecycleClosedSession()
        judgeStatus = -1
    else:
        let procOutcome: int32 = msquicNativeProcessOutcomeScratch
        if msquicNativeDebugTls13:
            msquicNativeDebugWriteLine(strutil.Join(["msquic native debug: accept process outcome=", IntToStr(procOutcome)], ""))
        if gMsQuicSessions[msquicNativeCurSlot].active &&
           !gMsQuicSessions[msquicNativeCurSlot].closed &&
           gMsQuicSessions[msquicNativeCurSlot].serverBound &&
           !msquicNativeAcceptReady() &&
           handshakeDeadlineMs <= 0:
            handshakeDeadlineMs = MsQuicNativeNowMs() + msquicNativeHandshakeTimeoutMs(msquicNativeListenerSettings)
        if procOutcome == msquicNativeProcessOutcomeServerAccept:
            msquicNativeAcceptPending = false
            msquicNativeLastServerSessionSlot = msquicNativeCurSlot
            if msquicNativeDebugTls13:
                msquicNativeDebugWriteLine("msquic_native_debug accept_return=proc")
            judgeStatus = 1
        elif msquicNativeAcceptReady():
            msquicNativeAcceptPending = false
            msquicNativeLastServerSessionSlot = msquicNativeCurSlot
            if msquicNativeDebugTls13:
                msquicNativeDebugWriteLine("msquic_native_debug accept_return=ready")
            judgeStatus = 1
        else:
            if gMsQuicSessions[msquicNativeCurSlot].closed:
                msquicNativeRecycleClosedSession()
                handshakeDeadlineMs = 0
            # A half-open server session whose handshake never completes (e.g. the
            # client tore down after a lost HANDSHAKE_DONE / ClientFinished exchange)
            # would otherwise keep this loop pinned forever: it is active+serverBound
            # but never ready, so the idle-deadline return below never fires. Enforce
            # the handshake deadline: abort the stalled session and recycle so the
            # next accept starts clean instead of inheriting a residual active session
            # (the source of the publisher rc=5 "active session exists" fall-through).
            if handshakeDeadlineMs > 0 &&
               gMsQuicSessions[msquicNativeCurSlot].active &&
               !gMsQuicSessions[msquicNativeCurSlot].closed &&
               gMsQuicSessions[msquicNativeCurSlot].serverBound &&
               !msquicNativeAcceptReady() &&
               MsQuicNativeNowMs() > handshakeDeadlineMs:
                if msquicNativeDebugTls13:
                    msquicNativeDebugWriteLine("msquic_native_debug accept_handshake_stalled_recycle")
                gMsQuicSessions[msquicNativeCurSlot].closed = true
                msquicNativeRecycleClosedSession()
                handshakeDeadlineMs = 0
            if !(gMsQuicSessions[msquicNativeCurSlot].active &&
                 !gMsQuicSessions[msquicNativeCurSlot].closed &&
                 gMsQuicSessions[msquicNativeCurSlot].serverBound &&
                 !msquicNativeAcceptReady()) &&
               MsQuicNativeNowMs() > idleDeadlineMs:
                judgeStatus = 2
            else:
                judgeStatus = 0
    MsQuicNativeTransportUnlock()
    return judgeStatus

fn msquicNativeAcceptTimed(waitMs: int32): Result[int32] =
    if ! msquicNativeListenerRunning:
        return Err[int32]("msquic native: listener ! running")
    var preAccept: int32
    MsQuicNativeTransportLock()
    msquicNativeRecycleClosedSession()
    if msquicNativeAcceptReady():
        msquicNativeAcceptPending = false
        msquicNativeLastServerSessionSlot = msquicNativeCurSlot
        preAccept = 1
    else:
        preAccept = 0
    MsQuicNativeTransportUnlock()
    if preAccept == 1:
        if msquicNativeDebugTls13:
            msquicNativeDebugWriteLine("msquic_native_debug accept_return=ready_preloop")
        return Ok[int32](1)
    if waitMs < 0:
        return msquicNativeAcceptBlocking()
    let idleDeadlineMs: int64 = MsQuicNativeNowMs() + int64(waitMs)
    var handshakeDeadlineMs: int64
    while true:
        var data: rawbytes.Bytes
        var fromAddr: str
        # fromAddr 每轮被 RecvDatagramDirectInto 重写、被 ProcessPacketFill 按值消费,
        # 保持在循环体内按迭代声明, 避免跨回边共享同一个 def 触发 consumed-value 审计。
        let recvCode: int32 = msquicNativeRecvDatagramDirectInto(msquicNativeListenerDatapathId, 10, data, fromAddr)
        if recvCode <= 0:
            if recvCode < 0:
                msquicNativeDebugWriteLine("msquic native debug: accept recv failed")
                return Err[int32]("msquic native: datapath recv failed")
            let nowMs: int64 = MsQuicNativeNowMs()
            if nowMs > idleDeadlineMs:
                return Ok[int32](0)
            continue
        if msquicNativeDebugTls13:
            msquicNativeDebugWriteLine(strutil.Join(["msquic native debug: accept recv len=", IntToStr(BytesLen(data)), " from=", share(fromAddr)], ""))
        let judgeCode: int32 = msquicNativeAcceptJudgeTimed(data, fromAddr, handshakeDeadlineMs, idleDeadlineMs)
        if judgeCode < 0:
            return Err[int32](strings.CloneStr(msquicNativeAcceptErrScratch))
        if judgeCode == 1:
            return Ok[int32](1)
        if judgeCode == 2:
            return Ok[int32](0)
    return Err[int32]("msquic native: accept timed failed")

fn msquicNativeAccept(): Result[int32] =
    return msquicNativeAcceptTimed(-1)

fn msquicNativeBuildLoopbackAddrInto(out: var multiaddress.MultiAddress, port: int32) =
    if port <= 0:
        MsQuicNativeEmptyAddrInto(out)
        return
    let portText: str = IntToStr(port)
    var multiaddrText: str = "/ip4/127.0.0.1/udp/"
    multiaddrText = strutil.Join([ share(multiaddrText), share(portText)], "")
    multiaddrText = strutil.Join([ share(multiaddrText), "/quic-v1"], "")
    MsQuicNativeAssignAddrTextInto(out, multiaddrText)

fn msquicNativeClientBoundAddrInto(out: var multiaddress.MultiAddress) =
    MsQuicNativeTransportLock()
    if ! gMsQuicSessions[msquicNativeCurSlot].active:
        MsQuicNativeTransportUnlock()
        MsQuicNativeEmptyAddrInto(out)
        return
    var port: int32
    if ! datapath_runtime.MsQuicDatapathGlobalUdpPortInto(msquicNativeSessionClientDatapathId, port):
        MsQuicNativeTransportUnlock()
        MsQuicNativeEmptyAddrInto(out)
        return
    MsQuicNativeTransportUnlock()
    msquicNativeBuildLoopbackAddrInto(out, port)

fn msquicNativeClientBoundAddr(): multiaddress.MultiAddress =
    var out: multiaddress.MultiAddress
    msquicNativeClientBoundAddrInto(out)
    return out

fn msquicNativeListenerBoundAddrInto(out: var multiaddress.MultiAddress) =
    MsQuicNativeTransportLock()
    if msquicNativeListenerRunning:
        MsQuicNativeCopyAddrInto(out, msquicNativeListenAddr)
        MsQuicNativeTransportUnlock()
        return
    MsQuicNativeTransportUnlock()
    MsQuicNativeEmptyAddrInto(out)

fn msquicNativeListenerBoundAddr(): multiaddress.MultiAddress =
    var out: multiaddress.MultiAddress
    msquicNativeListenerBoundAddrInto(out)
    return out

fn msquicNativePeerDialAddrInto(out: var multiaddress.MultiAddress) =
    # accept 侧(serverBound=true)的会话必须只报告真实采集到的对端地址(dialAddr, 见
    # msquicNativeInitServerSession/msquicNativeSetSessionDialAddr): client-datapath
    # loopback 自造分支只对本机主动拨出的会话有意义, 绝不允许在 accept 侧生效, 否则会用
    # 本机 client-datapath 端口伪造出「地址」而不是真实对端地址。全程非阻塞, 单 span。
    MsQuicNativeTransportLock()
    if msquicNativeSessionClientDatapathId > 0 && ! gMsQuicSessions[msquicNativeCurSlot].serverBound:
        var port: int32
        if datapath_runtime.MsQuicDatapathGlobalUdpPortInto(msquicNativeSessionClientDatapathId, port):
            if port > 0:
                msquicNativeBuildLoopbackAddrInto(out, port)
                MsQuicNativeTransportUnlock()
                return
    if gMsQuicSessions[msquicNativeCurSlot].active:
        MsQuicNativeCopyAddrInto(out, gMsQuicSessions[msquicNativeCurSlot].dialAddr)
        MsQuicNativeTransportUnlock()
        return
    MsQuicNativeTransportUnlock()
    MsQuicNativeEmptyAddrInto(out)

fn msquicNativePeerDialAddr(): multiaddress.MultiAddress =
    var out: multiaddress.MultiAddress
    msquicNativePeerDialAddrInto(out)
    return out

fn msquicNativePipeIdxForSession(token: int32): int32 =
    if token <= 0:
        return -1
    return 1000001 + msquicNativeCurSlot

# 角色分槽 retag: 持锁重放 cur=本角色槽再取 pipe idx。accept 尾写
# LastServerSessionSlot、dial 尾写 LastClientSessionSlot, 单连接对不再共用
# 一个被两线程互写的 lastSessionSlot（自连 serve_manifest_write 即时败根因）。
fn msquicNativeRetagPipeIdxForServerSession(): int32 =
    MsQuicNativeTransportLock()
    let serverSlot: int32 = msquicNativeLastServerSessionSlot
    var serverPipeIdx: int32 = -1
    if serverSlot >= 0:
        msquicNativeCurSlot = serverSlot
        serverPipeIdx = msquicNativePipeIdxForSession(1)
    MsQuicNativeTransportUnlock()
    return serverPipeIdx

fn msquicNativeRetagPipeIdxForClientSession(): int32 =
    MsQuicNativeTransportLock()
    let clientSlot: int32 = msquicNativeLastClientSessionSlot
    var clientPipeIdx: int32 = -1
    if clientSlot >= 0:
        msquicNativeCurSlot = clientSlot
        clientPipeIdx = msquicNativePipeIdxForSession(1)
    MsQuicNativeTransportUnlock()
    return clientPipeIdx

fn msquicNativeIsPipeIdx(pipeIdx: int32): bool =
    if pipeIdx >= 1000001 && pipeIdx < 1000001 + N_SLOTS:
        return true
    return false

fn msquicNativeBindSlotFromPipeIdx(pipeIdx: int32) =
    msquicNativeCurSlot = pipeIdx - 1000001

# 扫描停靠声明（v2 gate, 供数据面扫描环调用; 语义见
# msquicNativePumpCodeUnlocked listener 分支注释）。slot: >=0=停靠在该 bind 槽,
# -2=扫描活动中（等待窗, 全部泵让路）, -1=扫描退出。普通 int32 无内存序依赖:
# darwin exe / ohos PUBLISH 扫描与泵同线程交错; ohos dual 双线程下最坏宽松
# 可见滞后一个泵 tick（毫秒级）或一次多余让路, 而扫描烧尽是微秒级量级, 不影响
# 判定（见 results/darwin_quic_fix_v2_scanpark.md §2）。
fn msquicNativeScanParkSet(side: int32, slot: int32) =
    if side == msquicNativeClientSide:
        msquicNativeScanParkClient = slot
        return
    if side == msquicNativeServerSide:
        msquicNativeScanParkListener = slot
        return

fn msquicNativePipeIsClosed(pipeIdx: int32): bool =
    if ! msquicNativeIsPipeIdx(pipeIdx):
        return true
    MsQuicNativeTransportLock()
    msquicNativeBindSlotFromPipeIdx(pipeIdx)
    let closedNow: bool = ! gMsQuicSessions[msquicNativeCurSlot].active ||
                          gMsQuicSessions[msquicNativeCurSlot].closed
    MsQuicNativeTransportUnlock()
    return closedNow

# PipeWrite 细粒度 span（F-H4 §14.6 形态）: 入口 + 逐批队列 + flush 各自
# 小 span, pump 在锁外自持锁; 阻塞形态（对端 ACK 等待/DrainSideSend）零锁
# 等待。每 span 内显式 pin cur=writeSlot, 消除他线程 PPF/Pump span 翻 cur
# 的窗口。
fn msquicNativePipeWrite(pipeIdx: int32, side: int32, streamId: int64, data: rawbytes.Bytes): Result[int32] =
    if ! msquicNativeIsPipeIdx(pipeIdx):
        return Err[int32]("msquic native: invalid pipe")
    MsQuicNativeTransportLock()
    msquicNativeBindSlotFromPipeIdx(pipeIdx)
    let writeSlot: int32 = msquicNativeCurSlot
    if ! msquicNativeSideReady(side):
        MsQuicNativeTransportUnlock()
        return Err[int32]("msquic native: session ! ready")
    let slotRes: Result[int32] = msquicNativeEnsureAppStreamSlot(side, streamId)
    if IsErr(slotRes):
        MsQuicNativeTransportUnlock()
        return Err[int32](ErrorText(slotRes))
    let slotIdx: int32 = Value(slotRes)
    MsQuicNativeTransportUnlock()
    if msquicNativeDebugTls13:
        var msg = "msquic_native_debug pipe_write side="
        if side == msquicNativeClientSide:
            msg = strutil.Join([ share(msg), "client"], "")
        else:
            msg = strutil.Join([ share(msg), "server"], "")
        msg = strutil.Join([ share(msg), " stream=", int64ToStr(streamId)], "")
        msg = strutil.Join([ share(msg), " len=", IntToStr(BytesLen(data))], "")
        os.WriteLine(os.Get_stderr(), msg)
    var remaining: int32 = BytesLen(data)
    var cursor: int32
    while remaining > 0:
        var batchLen: int32
        # Never let the queued payload accumulate past ONE packet. BuildPacketInto
        # serialises the WHOLE queued payload into a single packet, so a queue that grew
        # across several batches (because the flush was cwnd-blocked) overflows
        # maxPacketSize → "packet too small". Before queuing the next batch, drain the
        # already-queued one: pump(1) processes an inbound ACK that frees cwnd, then flush
        # sends the freed bytes. Bounded so a genuinely stalled peer can't spin forever.
        var drainGuard: int32
        while drainGuard < 8192:
            MsQuicNativeTransportLock()
            msquicNativeCurSlot = writeSlot
            var hasQ: bool
            if side == msquicNativeClientSide:
                hasQ = connection_impl.MsQuicConnImplHasQueued(msquicNativeClientImpl[msquicNativeCurSlot])
            else:
                hasQ = connection_impl.MsQuicConnImplHasQueued(msquicNativeServerImpl[msquicNativeCurSlot])
            MsQuicNativeTransportUnlock()
            if ! hasQ:
                break
            let dpump: Result[int32] = msquicNativePump(msquicNativePumpBudget)
            if IsErr(dpump):
                return Err[int32](ErrorText(dpump))
            MsQuicNativeTransportLock()
            msquicNativeCurSlot = writeSlot
            let dflush: Result[bool] = msquicNativeFlushShortPackets(side)
            MsQuicNativeTransportUnlock()
            if IsErr(dflush):
                return Err[int32](ErrorText(dflush))
            drainGuard = drainGuard + 1
        if side == msquicNativeClientSide:
            MsQuicNativeTransportLock()
            msquicNativeCurSlot = writeSlot
            if msquicNativeClientWriteClosedAt(slotIdx):
                MsQuicNativeTransportUnlock()
                return Err[int32]("msquic native: stream write closed")
            var frameBudget: int32
            connection_impl.MsQuicConnImplFrameBudgetInto(msquicNativeClientImpl[msquicNativeCurSlot], frameBudget)
            var batchCap: int32
            if frameBudget > 32:
                batchCap = frameBudget - 32
            if batchCap <= 0:
                MsQuicNativeTransportUnlock()
                return Err[int32]("msquic native: send queue stalled")
            batchLen = remaining
            if batchLen > batchCap:
                batchLen = batchCap
            let chunk: rawbytes.Bytes = BytesSlice(data, cursor, batchLen)
            let qRes: Result[bool] = connection_impl.MsQuicConnImplQueueFrameParts(msquicNativeClientImpl[msquicNativeCurSlot],
                                                                                  14,
                                                                                  streamId,
                                                                                  msquicNativeClientSendOffsetAt(slotIdx),
                                                                                  0,
                                                                                  chunk)
            if IsErr(qRes):
                MsQuicNativeTransportUnlock()
                return Err[int32](ErrorText(qRes))
            if msquicNativeDebugTls13:
                var dbg = "msquic_native_debug pipe_queue side=client batch="
                dbg = strutil.Join([ share(dbg), IntToStr(batchLen)], "")
                dbg = strutil.Join([ share(dbg), " has_queued="], "")
                if connection_impl.MsQuicConnImplHasQueued(msquicNativeClientImpl[msquicNativeCurSlot]):
                    dbg = strutil.Join([ share(dbg), "true"], "")
                else:
                    dbg = strutil.Join([ share(dbg), "false"], "")
                dbg = strutil.Join([ share(dbg), " ack_only="], "")
                if connection_impl.MsQuicConnImplQueuedAckOnly(msquicNativeClientImpl[msquicNativeCurSlot]):
                    dbg = strutil.Join([ share(dbg), "true"], "")
                else:
                    dbg = strutil.Join([ share(dbg), "false"], "")
                os.WriteLine(os.Get_stderr(), dbg)
            msquicNativeSetClientSendOffset(slotIdx, msquicNativeClientSendOffsetAt(slotIdx) + int64(batchLen))
            let flushRes: Result[bool] = msquicNativeFlushShortPackets(msquicNativeClientSide)
            MsQuicNativeTransportUnlock()
            if IsErr(flushRes):
                return Err[int32](ErrorText(flushRes))
        elif side == msquicNativeServerSide:
            MsQuicNativeTransportLock()
            msquicNativeCurSlot = writeSlot
            if msquicNativeServerWriteClosedAt(slotIdx):
                MsQuicNativeTransportUnlock()
                return Err[int32]("msquic native: stream write closed")
            var frameBudget: int32
            connection_impl.MsQuicConnImplFrameBudgetInto(msquicNativeServerImpl[msquicNativeCurSlot], frameBudget)
            var batchCap: int32
            if frameBudget > 32:
                batchCap = frameBudget - 32
            if batchCap <= 0:
                MsQuicNativeTransportUnlock()
                return Err[int32]("msquic native: send queue stalled")
            batchLen = remaining
            if batchLen > batchCap:
                batchLen = batchCap
            let chunk: rawbytes.Bytes = BytesSlice(data, cursor, batchLen)
            let qRes: Result[bool] = connection_impl.MsQuicConnImplQueueFrameParts(msquicNativeServerImpl[msquicNativeCurSlot],
                                                                                  14,
                                                                                  streamId,
                                                                                  msquicNativeServerSendOffsetAt(slotIdx),
                                                                                  0,
                                                                                  chunk)
            if IsErr(qRes):
                MsQuicNativeTransportUnlock()
                return Err[int32](ErrorText(qRes))
            if msquicNativeDebugTls13:
                var dbg = "msquic_native_debug pipe_queue side=server batch="
                dbg = strutil.Join([ share(dbg), IntToStr(batchLen)], "")
                dbg = strutil.Join([ share(dbg), " has_queued="], "")
                if connection_impl.MsQuicConnImplHasQueued(msquicNativeServerImpl[msquicNativeCurSlot]):
                    dbg = strutil.Join([ share(dbg), "true"], "")
                else:
                    dbg = strutil.Join([ share(dbg), "false"], "")
                dbg = strutil.Join([ share(dbg), " ack_only="], "")
                if connection_impl.MsQuicConnImplQueuedAckOnly(msquicNativeServerImpl[msquicNativeCurSlot]):
                    dbg = strutil.Join([ share(dbg), "true"], "")
                else:
                    dbg = strutil.Join([ share(dbg), "false"], "")
                os.WriteLine(os.Get_stderr(), dbg)
            msquicNativeSetServerSendOffset(slotIdx, msquicNativeServerSendOffsetAt(slotIdx) + int64(batchLen))
            let flushRes: Result[bool] = msquicNativeFlushShortPackets(msquicNativeServerSide)
            MsQuicNativeTransportUnlock()
            if IsErr(flushRes):
                return Err[int32](ErrorText(flushRes))
        else:
            return Err[int32]("msquic native: local role ! ready")
        cursor = cursor + batchLen
        remaining = remaining - batchLen
        let pumpMidRes: Result[int32] = msquicNativePump(1)
        if IsErr(pumpMidRes):
            return Err[int32](ErrorText(pumpMidRes))
    let pumpTailRes: Result[int32] = msquicNativePump(1)
    if IsErr(pumpTailRes):
        return Err[int32](ErrorText(pumpTailRes))
    # Small control frames (e.g. the multistream-select / negotiate frame) fit in
    # a single packet inside the congestion window and are already flushed and
    # recorded in the retransmit window above. Synchronously draining them to ACK
    # would block the GUI render thread up to msquicNativePipeReadTimeoutMs while
    # waiting for the peer's reactive ACK — exactly the negotiate-stall symptom.
    # Return immediately: the recorded packet is retransmitted on RTO by the
    # client/server short-retransmit pump driven by subsequent read pumps, so a
    # lost control frame still recovers without holding the render thread.
    if BytesLen(data) <= msquicNativeControlFrameMaxBytes:
        return Ok[int32](BytesLen(data))
    # Drain the send side: keep pumping (which re-flushes cwnd-freed queued data
    # and harvests acks) until everything queued is flushed AND acknowledged.
    # Otherwise a transfer larger than the congestion window leaves a queued/
    # in-flight tail that only dribbles out during the peer's reactive pumps,
    # so a big object never finishes before the per-request read idle timeout.
    let drainRes: Result[bool] = msquicNativeDrainSideSend(side, writeSlot)
    if IsErr(drainRes):
        return Err[int32](ErrorText(drainRes))
    return Ok[int32](BytesLen(data))

# Pump until the given side's queued + in-flight app data is fully sent and acked,
# bounded by the pipe read timeout. Used after a bulk write so the bytes are
# actually delivered (not merely queued) before control returns to the caller.
# sessionSlot 由调用方（PipeWrite 的 writeSlot）显式传入: 旧形各 span 读裸
# cur（pump 翻槽后残留值）→ drain 中段 flush/send 用错槽（§15.5/§16.4 轮 3
# manifest/chunk write 失败形）。每个 span 入口重钉 cur=sessionSlot, 与
# PipeWrite 细粒度 span 同一纪律。
fn msquicNativeDrainSideSend(side: int32, sessionSlot: int32): Result[bool] =
    MsQuicNativeTransportLock()
    msquicNativeCurSlot = sessionSlot
    let drainEntryActive: bool = gMsQuicSessions[msquicNativeCurSlot].active
    let drainEntryClosed: bool = gMsQuicSessions[msquicNativeCurSlot].closed
    MsQuicNativeTransportUnlock()
    if ! drainEntryActive || drainEntryClosed:
        return Ok[bool](false)
    let deadlineMs: int64 = MsQuicNativeNowMs() + int64(msquicNativePipeReadTimeoutMs)
    while MsQuicNativeNowMs() <= deadlineMs:
        MsQuicNativeTransportLock()
        msquicNativeCurSlot = sessionSlot
        var pending: int32
        if side == msquicNativeClientSide:
            pending = connection_impl.MsQuicConnImplSentCount(msquicNativeClientImpl[msquicNativeCurSlot])
            if connection_impl.MsQuicConnImplHasQueued(msquicNativeClientImpl[msquicNativeCurSlot]):
                pending = pending + 1
        else:
            pending = connection_impl.MsQuicConnImplSentCount(msquicNativeServerImpl[msquicNativeCurSlot])
            if connection_impl.MsQuicConnImplHasQueued(msquicNativeServerImpl[msquicNativeCurSlot]):
                pending = pending + 1
        MsQuicNativeTransportUnlock()
        if pending <= 0:
            return Ok[bool](true)
        # flush/pump 各自小 span（pump 自锁）: 等 ACK 的整段等待零锁持有,
        # 对端线程（serve accept/pump）不被饿死（§14.6 活锁修复形态）。
        MsQuicNativeTransportLock()
        msquicNativeCurSlot = sessionSlot
        let flushRes: Result[bool] = msquicNativeFlushShortPackets(side)
        MsQuicNativeTransportUnlock()
        if IsErr(flushRes):
            return Err[bool](ErrorText(flushRes))
        let pumpRes: Result[int32] = msquicNativePump(1)
        if IsErr(pumpRes):
            return Err[bool](ErrorText(pumpRes))
        MsQuicNativeTransportLock()
        msquicNativeCurSlot = sessionSlot
        let drainClosed: bool = gMsQuicSessions[msquicNativeCurSlot].closed
        MsQuicNativeTransportUnlock()
        if drainClosed:
            return Ok[bool](false)
    return Ok[bool](true)

fn msquicNativePipeCloseWrite(pipeIdx: int32, side: int32, streamId: int64): Result[bool] =
    if ! msquicNativeIsPipeIdx(pipeIdx):
        return Err[bool]("msquic native: invalid pipe")
    MsQuicNativeTransportLock()
    msquicNativeBindSlotFromPipeIdx(pipeIdx)
    if ! msquicNativeSideReady(side):
        MsQuicNativeTransportUnlock()
        return Err[bool]("msquic native: session ! ready")
    let slotRes: Result[int32] = msquicNativeEnsureAppStreamSlot(side, streamId)
    if IsErr(slotRes):
        MsQuicNativeTransportUnlock()
        return Err[bool](ErrorText(slotRes))
    let slotIdx: int32 = Value(slotRes)
    if side == msquicNativeClientSide:
        if msquicNativeClientWriteClosedAt(slotIdx):
            MsQuicNativeTransportUnlock()
            return Ok[bool](true)
        let qRes: Result[bool] = connection_impl.MsQuicConnImplQueueFrameParts(msquicNativeClientImpl[msquicNativeCurSlot],
                                                                              15,
                                                                              streamId,
                                                                              msquicNativeClientSendOffsetAt(slotIdx),
                                                                              0,
                                                                              emptyBytes())
        if IsErr(qRes):
            MsQuicNativeTransportUnlock()
            return Err[bool](ErrorText(qRes))
        msquicNativeSetClientWriteClosed(slotIdx, true)
        let flushRes: Result[bool] = msquicNativeFlushShortPackets(msquicNativeClientSide)
        MsQuicNativeTransportUnlock()
        if IsErr(flushRes):
            return Err[bool](ErrorText(flushRes))
    elif side == msquicNativeServerSide:
        if msquicNativeServerWriteClosedAt(slotIdx):
            MsQuicNativeTransportUnlock()
            return Ok[bool](true)
        let qRes: Result[bool] = connection_impl.MsQuicConnImplQueueFrameParts(msquicNativeServerImpl[msquicNativeCurSlot],
                                                                              15,
                                                                              streamId,
                                                                              msquicNativeServerSendOffsetAt(slotIdx),
                                                                              0,
                                                                              emptyBytes())
        if IsErr(qRes):
            MsQuicNativeTransportUnlock()
            return Err[bool](ErrorText(qRes))
        msquicNativeSetServerWriteClosed(slotIdx, true)
        let flushRes: Result[bool] = msquicNativeFlushShortPackets(msquicNativeServerSide)
        MsQuicNativeTransportUnlock()
        if IsErr(flushRes):
            return Err[bool](ErrorText(flushRes))
    else:
        MsQuicNativeTransportUnlock()
        return Err[bool]("msquic native: local role ! ready")
    let pumpRes: Result[int32] = msquicNativePump(1)
    if IsErr(pumpRes):
        return Err[bool](ErrorText(pumpRes))
    return Ok[bool](true)

fn msquicNativePipeRead(pipeIdx: int32, side: int32, streamId: int64, count: int32): Result[rawbytes.Bytes] =
    if ! msquicNativeIsPipeIdx(pipeIdx):
        return Err[rawbytes.Bytes]("msquic native: invalid pipe")
    MsQuicNativeTransportLock()
    msquicNativeBindSlotFromPipeIdx(pipeIdx)
    if ! gMsQuicSessions[msquicNativeCurSlot].active:
        MsQuicNativeTransportUnlock()
        return Err[rawbytes.Bytes]("msquic native: session ! active")
    let readSlot: int32 = msquicNativeCurSlot
    MsQuicNativeTransportUnlock()
    if count <= 0:
        return Ok[rawbytes.Bytes](emptyBytes())
    MsQuicNativeTransportLock()
    msquicNativeCurSlot = readSlot
    let buffered: rawbytes.Bytes = msquicNativeAppRecvConsume(side, streamId, count)
    MsQuicNativeTransportUnlock()
    if BytesLen(buffered) > 0:
        if msquicNativeDebugTls13:
            var msg = "msquic_native_debug pipe_read_ready side="
            if side == msquicNativeClientSide:
                msg = strutil.Join([ share(msg), "client"], "")
            else:
                msg = strutil.Join([ share(msg), "server"], "")
            msg = strutil.Join([ share(msg), " stream=", int64ToStr(streamId)], "")
            msg = strutil.Join([ share(msg), " avail=", IntToStr(BytesLen(buffered))], "")
            os.WriteLine(os.Get_stderr(), msg)
        return Ok[rawbytes.Bytes](buffered)
    MsQuicNativeTransportLock()
    msquicNativeCurSlot = readSlot
    let peerClosed0: bool = msquicNativeAppRecvPeerClosed(side, streamId)
    MsQuicNativeTransportUnlock()
    if peerClosed0:
        return Err[rawbytes.Bytes]("msquic: stream closed")
    if msquicNativeDebugTls13:
        var enter = "msquic_native_debug pipe_read_enter side="
        if side == msquicNativeClientSide:
            enter = strutil.Join([ share(enter), "client"], "")
        else:
            enter = strutil.Join([ share(enter), "server"], "")
        enter = strutil.Join([ share(enter), " stream=", int64ToStr(streamId)], "")
        enter = strutil.Join([ share(enter), " count=", IntToStr(count)], "")
        enter = strutil.Join([ share(enter), " avail=", IntToStr(msquicNativeAppRecvAvailable(side, streamId))], "")
        os.WriteLine(os.Get_stderr(), enter)
    let deadlineMs: int64 = MsQuicNativeNowMs() + int64(msquicNativePipeReadTimeoutMs)
    while MsQuicNativeNowMs() <= deadlineMs:
        # The pump rebinds cur per datapath; the app-stream tables are keyed by
        # (cur, side, stream), so EVERY app-stream access in this loop must run
        # with cur bound to THIS pipe's session slot. 判读段持锁、fd 等待锁外。
        MsQuicNativeTransportLock()
        msquicNativeCurSlot = readSlot
        if msquicNativeDebugTls13 &&
           side == msquicNativeClientSide &&
           gMsQuicSessions[msquicNativeCurSlot].clientFinishedSent &&
           !gMsQuicSessions[msquicNativeCurSlot].debugHandshakePendingLogged:
            var dbg = "msquic_native_debug pending_handshake active="
            if gMsQuicSessions[msquicNativeCurSlot].clientHandshakePendingActive:
                dbg = strutil.Join([ share(dbg), "true"], "")
            else:
                dbg = strutil.Join([ share(dbg), "false"], "")
            dbg = strutil.Join([ share(dbg), " len=", IntToStr(BytesLen(gMsQuicSessions[msquicNativeCurSlot].clientHandshakePendingWire))], "")
            dbg = strutil.Join([ share(dbg), " age_ms=", int64ToStr(MsQuicNativeNowMs() - gMsQuicSessions[msquicNativeCurSlot].clientHandshakePendingSentAtMs)], "")
            os.WriteLine(os.Get_stderr(), dbg)
            gMsQuicSessions[msquicNativeCurSlot].debugHandshakePendingLogged = true
        MsQuicNativeTransportUnlock()
        # Drain up to a full budget of datagrams per spin (not one): the previous one-per-
        # spin + unconditional 1ms sleep throttled receive to ~1 datagram/ms ≈ 64KB/s, far
        # below the 244KB/s realtime video bitrate → ES FIFO underrun → stutter. Pumping the
        # budget scales ACK ingest + cwnd-freed re-flush with the link.
        let pumpRes: Result[int32] = msquicNativePump(msquicNativePumpBudget)
        if IsErr(pumpRes):
            return Err[rawbytes.Bytes](ErrorText(pumpRes))
        MsQuicNativeTransportLock()
        msquicNativeCurSlot = readSlot
        let chunk: rawbytes.Bytes = msquicNativeAppRecvConsume(side, streamId, count)
        MsQuicNativeTransportUnlock()
        if BytesLen(chunk) > 0:
            if msquicNativeDebugTls13:
                var msg = "msquic_native_debug pipe_read_ready side="
                if side == msquicNativeClientSide:
                    msg = strutil.Join([ share(msg), "client"], "")
                else:
                    msg = strutil.Join([ share(msg), "server"], "")
                msg = strutil.Join([ share(msg), " stream=", int64ToStr(streamId)], "")
                msg = strutil.Join([ share(msg), " avail=", IntToStr(BytesLen(chunk))], "")
                os.WriteLine(os.Get_stderr(), msg)
            return Ok[rawbytes.Bytes](chunk)
        MsQuicNativeTransportLock()
        msquicNativeCurSlot = readSlot
        let loopPeerClosed: bool = msquicNativeAppRecvPeerClosed(side, streamId)
        let slotClosed: bool = gMsQuicSessions[readSlot].closed
        MsQuicNativeTransportUnlock()
        if loopPeerClosed:
            return Err[rawbytes.Bytes]("msquic: stream closed")
        if slotClosed:
            return Err[rawbytes.Bytes]("msquic: pipe closed")
        if MsQuicNativeNowMs() <= deadlineMs:
            # When datagrams are flowing, spin straight to the next drain — never insert a gap
            # mid-burst (outcome stays None for ordinary data/ack packets, so gate on the real
            # recv signal). When truly idle, block on this side's fd so the next arriving packet
            # wakes us immediately (physical RTT) instead of a fixed 1ms sleep.
            if ! msquicNativeLastPumpReceived:
                msquicNativeWaitReadableForSide(side, 8)
            continue
    return Err[rawbytes.Bytes]("msquic native: pipe read timeout")

fn msquicNativePipeReadNonblocking(pipeIdx: int32, side: int32, streamId: int64, count: int32): Result[rawbytes.Bytes] =
    if ! msquicNativeIsPipeIdx(pipeIdx):
        return Err[rawbytes.Bytes]("msquic native: invalid pipe")
    MsQuicNativeTransportLock()
    msquicNativeBindSlotFromPipeIdx(pipeIdx)
    if ! gMsQuicSessions[msquicNativeCurSlot].active:
        MsQuicNativeTransportUnlock()
        return Err[rawbytes.Bytes]("msquic native: session ! active")
    let nbReadSlot: int32 = msquicNativeCurSlot
    MsQuicNativeTransportUnlock()
    if count <= 0:
        return Ok[rawbytes.Bytes](emptyBytes())
    MsQuicNativeTransportLock()
    msquicNativeCurSlot = nbReadSlot
    let buffered: rawbytes.Bytes = msquicNativeAppRecvConsume(side, streamId, count)
    MsQuicNativeTransportUnlock()
    if BytesLen(buffered) > 0:
        return Ok[rawbytes.Bytes](buffered)
    MsQuicNativeTransportLock()
    msquicNativeCurSlot = nbReadSlot
    let nbPeerClosed0: bool = msquicNativeAppRecvPeerClosed(side, streamId)
    MsQuicNativeTransportUnlock()
    if nbPeerClosed0:
        return Err[rawbytes.Bytes]("msquic: stream closed")
    for pumpIdx in 0..<msquicNativePumpBudget:
        let pumpRes: Result[int32] = msquicNativePump(1)
        if IsErr(pumpRes):
            return Err[rawbytes.Bytes](ErrorText(pumpRes))
        MsQuicNativeTransportLock()
        msquicNativeCurSlot = nbReadSlot
        let chunk: rawbytes.Bytes = msquicNativeAppRecvConsume(side, streamId, count)
        MsQuicNativeTransportUnlock()
        if BytesLen(chunk) > 0:
            return Ok[rawbytes.Bytes](chunk)
        MsQuicNativeTransportLock()
        msquicNativeCurSlot = nbReadSlot
        let nbPeerClosed: bool = msquicNativeAppRecvPeerClosed(side, streamId)
        let nbSlotClosed: bool = gMsQuicSessions[nbReadSlot].closed
        MsQuicNativeTransportUnlock()
        if nbPeerClosed:
            return Err[rawbytes.Bytes]("msquic: stream closed")
        if nbSlotClosed:
            return Err[rawbytes.Bytes]("msquic: pipe closed")
    return Err[rawbytes.Bytes]("msquic udp: queue empty")

fn msquicNativeSendConnectionClosePacketFill(side: int32, reason: str): bool =
    msquicNativeResetResultScratch()
    let reasonBytes: rawbytes.Bytes = BytesFromString(reason)
    var pkt: packet_model.MsQuicPacket
    var packetNumber: int64
    if side == msquicNativeClientSide:
        packetNumber = msquicNativeNextPacketNumber(msquicNativeClientSide, msquicNativePacketShortCode)
        msquicPacketReset(pkt, packetNumber)
    else:
        packetNumber = msquicNativeNextPacketNumber(msquicNativeServerSide, msquicNativePacketShortCode)
        msquicPacketReset(pkt, packetNumber)
    let closeRes: Result[bool] = msquicNativePacketAddConnectionCloseFrame(pkt, reasonBytes)
    if IsErr(closeRes):
        msquicNativeResultErrorScratch = ErrorText(closeRes)
        return false
    let payloadRes: Result[rawbytes.Bytes] = msquicPacketPayloadEncode(pkt)
    if IsErr(payloadRes):
        msquicNativeResultErrorScratch = ErrorText(payloadRes)
        return false
    if side == msquicNativeClientSide:
        let sendRes: Result[bool] = msquicNativeSendPayload(
            msquicNativeClientSide,
            msquicNativePacketShortCode,
            packetNumber,
            Value(payloadRes),
            false
        )
        if IsErr(sendRes):
            msquicNativeResultErrorScratch = ErrorText(sendRes)
            return false
    else:
        let sendRes: Result[bool] = msquicNativeSendPayload(
            msquicNativeServerSide,
            msquicNativePacketShortCode,
            packetNumber,
            Value(payloadRes),
            false
        )
        if IsErr(sendRes):
            msquicNativeResultErrorScratch = ErrorText(sendRes)
            return false
    return true

fn msquicNativeSendConnectionCloseFill(reason: str): bool =
    msquicNativeResetResultScratch()
    let sessionInactive: bool = ! gMsQuicSessions[msquicNativeCurSlot].active || gMsQuicSessions[msquicNativeCurSlot].closed
    if sessionInactive:
        gMsQuicSessions[msquicNativeCurSlot].closed = true
        return true
    let role: int32 = msquicNativeLocalRole
    let clientReady: bool = role == msquicNativeRoleClient && gMsQuicSessions[msquicNativeCurSlot].clientReady > 0
    if clientReady:
        if ! msquicNativeSendConnectionClosePacketFill(msquicNativeClientSide, strings.CloneStr(reason)):
            return false
    let serverReady: bool = role == msquicNativeRoleServer && gMsQuicSessions[msquicNativeCurSlot].serverReady > 0
    if serverReady:
        if ! msquicNativeSendConnectionClosePacketFill(msquicNativeServerSide, reason):
            return false
    gMsQuicSessions[msquicNativeCurSlot].closed = true
    return true

fn msquicNativeSendConnectionClose(reason: str): Result[bool] =
    MsQuicNativeTransportLock()
    let ok: bool = msquicNativeSendConnectionCloseFill(reason)
    MsQuicNativeTransportUnlock()
    if ! ok:
        return Err[bool](msquicNativeResultErrorScratch)
    return Ok[bool](true)

# Drain unacked app stream data before closing: pump recv (to harvest SACKs)
# and fire retransmits until every sent ack-eliciting packet is acknowledged,
# or a bounded deadline elapses. Without this, a FIN+CONNECTION_CLOSE abandons
# in-flight/lost tail bytes and the peer sees a truncated stream ("pipe closed").
fn msquicNativeDrainSentBeforeClose() =
    MsQuicNativeTransportLock()
    let drainSlot: int32 = msquicNativeCurSlot
    let entryActive: bool = gMsQuicSessions[drainSlot].active
    let entryClosed: bool = gMsQuicSessions[drainSlot].closed
    MsQuicNativeTransportUnlock()
    if ! entryActive || entryClosed:
        return
    let deadlineMs: int64 = MsQuicNativeNowMs() + int64(msquicNativePipeReadTimeoutMs)
    while MsQuicNativeNowMs() <= deadlineMs:
        # The pump processes BOTH datapaths and per-packet CID routing can rebind
        # msquicNativeCurSlot to another live session (dual-role relay: a subscriber
        # datagram lands while draining the upstream client session). Pin this
        # session's slot across the drain so the unacked-sent counters are read
        # from the session being closed, not a drifted one. 判读段持锁、等待锁外。
        MsQuicNativeTransportLock()
        msquicNativeCurSlot = drainSlot
        let clientPending: int32 = connection_impl.MsQuicConnImplSentCount(msquicNativeClientImpl[drainSlot])
        let serverPending: int32 = connection_impl.MsQuicConnImplSentCount(msquicNativeServerImpl[drainSlot])
        MsQuicNativeTransportUnlock()
        if clientPending <= 0 && serverPending <= 0:
            return
        let pumpRes: Result[int32] = msquicNativePump(1)
        if IsErr(pumpRes):
            return
        os.SleepMs(1)

fn msquicNativePipeClose(pipeIdx: int32) =
    if ! msquicNativeIsPipeIdx(pipeIdx):
        return
    MsQuicNativeTransportLock()
    msquicNativeBindSlotFromPipeIdx(pipeIdx)
    let closeSlot: int32 = msquicNativeCurSlot
    MsQuicNativeTransportUnlock()
    msquicNativeDrainSentBeforeClose()
    # The drain's pumps can rebind cur (dual-role listener traffic); the close
    # packet and the recycle MUST target the session this pipe belongs to.
    MsQuicNativeTransportLock()
    msquicNativeCurSlot = closeSlot
    let _ = msquicNativeSendConnectionClose("closed")
    msquicNativeCurSlot = closeSlot
    msquicNativeRecycleClosedSession()
    MsQuicNativeTransportUnlock()

fn msquicNativeDatagramWrite(pipeIdx: int32, side: int32, data: rawbytes.Bytes): Result[int32] =
    if ! msquicNativeIsPipeIdx(pipeIdx):
        return Err[int32]("msquic native: invalid pipe")
    MsQuicNativeTransportLock()
    msquicNativeBindSlotFromPipeIdx(pipeIdx)
    if ! msquicNativeSideReady(side):
        MsQuicNativeTransportUnlock()
        return Err[int32]("msquic native: session ! ready")
    if side == msquicNativeClientSide:
        let qRes: Result[bool] = connection_impl.MsQuicConnImplQueueFrameParts(msquicNativeClientImpl[msquicNativeCurSlot],
                                                                              48,
                                                                              0,
                                                                              0,
                                                                              0,
                                                                              data)
        if IsErr(qRes):
            MsQuicNativeTransportUnlock()
            return Err[int32](ErrorText(qRes))
        let flushRes: Result[bool] = msquicNativeFlushShortPackets(msquicNativeClientSide)
        if IsErr(flushRes):
            MsQuicNativeTransportUnlock()
            return Err[int32](ErrorText(flushRes))
    elif side == msquicNativeServerSide:
        let qRes: Result[bool] = connection_impl.MsQuicConnImplQueueFrameParts(msquicNativeServerImpl[msquicNativeCurSlot],
                                                                              48,
                                                                              0,
                                                                              0,
                                                                              0,
                                                                              data)
        if IsErr(qRes):
            MsQuicNativeTransportUnlock()
            return Err[int32](ErrorText(qRes))
        let flushRes: Result[bool] = msquicNativeFlushShortPackets(msquicNativeServerSide)
        if IsErr(flushRes):
            MsQuicNativeTransportUnlock()
            return Err[int32](ErrorText(flushRes))
    else:
        MsQuicNativeTransportUnlock()
        return Err[int32]("msquic native: local role ! ready")
    let pumpRes: Result[int32] = msquicNativePump(1)
    if IsErr(pumpRes):
        MsQuicNativeTransportUnlock()
        return Err[int32](ErrorText(pumpRes))
    let dataLen: int32 = BytesLen(data)
    MsQuicNativeTransportUnlock()
    return Ok[int32](dataLen)

fn msquicNativeDatagramRead(pipeIdx: int32, side: int32): Result[rawbytes.Bytes] =
    if ! msquicNativeIsPipeIdx(pipeIdx):
        return Err[rawbytes.Bytes]("msquic native: invalid pipe")
    MsQuicNativeTransportLock()
    msquicNativeBindSlotFromPipeIdx(pipeIdx)
    let pumpRes: Result[int32] = msquicNativePump(1)
    if IsErr(pumpRes):
        MsQuicNativeTransportUnlock()
        return Err[rawbytes.Bytes](ErrorText(pumpRes))
    if gMsQuicSessions[msquicNativeCurSlot].closed:
        MsQuicNativeTransportUnlock()
        return Err[rawbytes.Bytes]("msquic: pipe closed")
    var readRes: Result[rawbytes.Bytes]
    if side == msquicNativeClientSide:
        readRes = msquicNativeDequeueDatagram(msquicNativeClientSide)
    elif side == msquicNativeServerSide:
        readRes = msquicNativeDequeueDatagram(msquicNativeServerSide)
    else:
        MsQuicNativeTransportUnlock()
        return Err[rawbytes.Bytes]("msquic native: local role ! ready")
    MsQuicNativeTransportUnlock()
    return readRes

fn msquicNativeTestDropNextAppPacket() =
    msquicNativeDropNextAppSend = true

fn msquicNativeTestForceRetransmit(pipeIdx: int32): Result[bool] =
    if ! msquicNativeIsPipeIdx(pipeIdx):
        return Err[bool]("msquic native: invalid pipe")
    msquicNativeBindSlotFromPipeIdx(pipeIdx)
    let nowMs: int64 = MsQuicNativeNowMs()
    if msquicNativeLocalRole == msquicNativeRoleClient:
        connection_impl.MsQuicConnImplForceRetransmit(msquicNativeClientImpl[msquicNativeCurSlot], nowMs)
    elif msquicNativeLocalRole == msquicNativeRoleServer:
        connection_impl.MsQuicConnImplForceRetransmit(msquicNativeServerImpl[msquicNativeCurSlot], nowMs)
    let pumpRes: Result[int32] = msquicNativePump(1)
    if IsErr(pumpRes):
        return Err[bool](ErrorText(pumpRes))
    return Ok[bool](true)

@borrows
fn MsQuicNativeStartListener(addr: multiaddress.MultiAddress,
                             settings: msquicruntime.MsQuicSettings,
                             tlsPolicy: policy.MsQuicTlsPolicy): result.Result[int32] =
    return msquicNativeStartListener(addr, settings, tlsPolicy)

fn MsQuicNativeStartListenerDefault(addr: multiaddress.MultiAddress,
                                    tlsPolicy: policy.MsQuicTlsPolicy): result.Result[int32] =
    return msquicNativeStartListenerDefault(addr, tlsPolicy)

fn MsQuicNativeStartListenerDefaultRef(addr: multiaddress.MultiAddress,
                                       tlsPolicy: var policy.MsQuicTlsPolicy): result.Result[int32] =
    return msquicNativeStartListenerDefaultRef(addr, tlsPolicy)

fn MsQuicNativeStopListener() =
    msquicNativeStopListener()

fn MsQuicNativeResetAll() =
    msquicNativeResetAll()

fn MsQuicNativeAccept(): result.Result[int32] =
    return msquicNativeAccept()

fn MsQuicNativeAcceptTimed(waitMs: int32): result.Result[int32] =
    return msquicNativeAcceptTimed(waitMs)

fn MsQuicNativeAcceptTimedCode(waitMs: int32): int32 =
    let res: result.Result[int32] = msquicNativeAcceptTimed(waitMs)
    if result.IsErr(res):
        return -1
    return result.Value(res)

@borrows
fn MsQuicNativeDial(clientSettings: msquicruntime.MsQuicSettings,
                    clientTlsPolicy: policy.MsQuicTlsPolicy,
                    addr: multiaddress.MultiAddress): result.Result[int32] =
    return msquicNativeDial(clientSettings, clientTlsPolicy, addr)

fn MsQuicNativeDialCode(clientSettings: msquicruntime.MsQuicSettings,
                        clientTlsPolicy: policy.MsQuicTlsPolicy,
                        addr: multiaddress.MultiAddress): int32 =
    let res: result.Result[int32] = msquicNativeDial(clientSettings, clientTlsPolicy, addr)
    if result.IsErr(res):
        return -1
    return result.Value(res)

fn MsQuicNativeDialDefaultCode(addr: multiaddress.MultiAddress): int32 =
    var settings: msquicruntime.MsQuicSettings
    initMsQuicSettingsInto(settings)
    var clientTlsPolicy: policy.MsQuicTlsPolicy
    initMsQuicTlsPolicyInto(clientTlsPolicy)
    msquicTlsPolicySetAllowInsecure(clientTlsPolicy, true)
    let res: result.Result[int32] = msquicNativeDial(settings, clientTlsPolicy, addr)
    if result.IsErr(res):
        return -1
    return result.Value(res)

