        serverTrustRoot2Cache: rawbytes.Bytes
        serverTrustRoot3Cache: rawbytes.Bytes
        serverInitialPayloadCache: rawbytes.Bytes

fn MsQuicNativeEmptyAddrInto(out: var multiaddress.MultiAddress) =
    BytesFree(out.data)
    out.raw = ""
    out.data = emptyBytes()

fn MsQuicNativeAssignAddrTextInto(out: var multiaddress.MultiAddress, text: str) =
    let data = BytesSlice(BytesFromString(text), 0, len(text))
    BytesFree(out.data)
    out.raw = text
    out.data = data

@borrows
fn MsQuicNativeCopyAddrInto(out: var multiaddress.MultiAddress, src: multiaddress.MultiAddress) =
    let raw = strings.stringsNewStringCopy(src.raw.data, src.raw.len)
    let data = BytesSlice(src.data, 0, BytesLen(src.data))
    BytesFree(out.data)
    out.raw = raw
    out.data = data

fn MsQuicNativeEmptyAddr(): multiaddress.MultiAddress =
    var out: multiaddress.MultiAddress
    MsQuicNativeEmptyAddrInto(out)
    return out

@borrows
fn msquicNativeSetSessionDialAddr(src: multiaddress.MultiAddress) =
    MsQuicNativeCopyAddrInto(gMsQuicSessions[msquicNativeCurSlot].dialAddr, src)

@borrows
fn msquicNativeSetSessionListenAddr(src: multiaddress.MultiAddress) =
    MsQuicNativeCopyAddrInto(gMsQuicSessions[msquicNativeCurSlot].listenAddr, src)

# (cur 基 msquicNativeSession{Client,Listener}AddrText 已删: send 地址寻址
# 统一走 msquicNativeSendWire 内的角色锚点单锁 span, 全文件 send 链零 cur 读。)

@borrows
fn msquicNativeStableString(text: str): str =
    if len(text) <= 0:
        return ""
    return strings.CloneStrRange(text, 0, len(text))

fn msquicNativePacketTypeCode(packetType: packet_header_model.QuicPacketType): int32 =
    if packetType == packet_header_model.QuicPacketInitial:
        return msquicNativePacketInitialCode
    if packetType == packet_header_model.QuicPacket0Rtt:
        return msquicNativePacket0RttCode
    if packetType == packet_header_model.QuicPacketHandshake:
        return msquicNativePacketHandshakeCode
    if packetType == packet_header_model.QuicPacketRetry:
        return msquicNativePacketRetryCode
    return msquicNativePacketShortCode

fn msquicNativeDatapathUdpFd(id: int32): int32 =
    # Prefer the datapath runtime's LIVE socket fd over the cached client/listener
    # fd. When the transport runs inside the GUI app process the cached
    # msquicNativeClientUdpFd can go stale (the datapath socket is rebound during
    # session setup) so the handshake recv hit a closed fd -> EBADF (err=9). The
    # datapath slot's udpSocketId is the source of truth; fall back to the cached
    # value only if the slot has no live fd.
    if id > 0 && id == msquicNativeSessionClientDatapathId:
        let liveClientFd: int32 = datapath_runtime.MsQuicDatapathGlobalUdpFd(id)
        if liveClientFd >= 0:
            return liveClientFd
        return msquicNativeClientUdpFd
    if id > 0 && id == msquicNativeSessionListenerDatapathId:
        let liveListenerFd: int32 = datapath_runtime.MsQuicDatapathGlobalUdpFd(id)
        if liveListenerFd >= 0:
            return liveListenerFd
        return msquicNativeListenerUdpFd
    if id > 0 && id == msquicNativeListenerDatapathId:
        let liveListenerFd2: int32 = datapath_runtime.MsQuicDatapathGlobalUdpFd(id)
        if liveListenerFd2 >= 0:
            return liveListenerFd2
        return msquicNativeListenerUdpFd
    return -1

fn msquicNativeFrameCodeEquals(frameCode: int32, expectedCode: int32): bool =
    return frameCode == expectedCode

fn msquicNativeX509KeyKindFromCode(kindCode: int32): x509.X509PublicKeyKind =
    if kindCode == 1:
        return x509.X509KeyRsa
    if kindCode == 2:
        return x509.X509KeyEcdsaP256
    return x509.X509KeyUnknown

fn msquicNativeX509KeyKindCode(kind: x509.X509PublicKeyKind): int32 =
    if kind == x509.X509KeyRsa:
        return 1
    if kind == x509.X509KeyEcdsaP256:
        return 2
    return 0

@borrows
fn msquicNativeX509KeyKindCodeFromPrivateKey(privateKey: rawbytes.Bytes,
                                             declaredKind: x509.X509PublicKeyKind): int32 =
    if declaredKind != x509.X509KeyUnknown:
        return msquicNativeX509KeyKindCode(declaredKind)
    if BytesLen(privateKey) == 32:
        return 2
    if rsacrypto.validateRsaPrivateKeyBytes(privateKey):
        return 1
    if ecnist.ValidateEcdsaPrivateKeyBytes(privateKey):
        return 2
    return 0

@borrows
fn msquicNativeX509KeyKindCodeFromCertificate(der: rawbytes.Bytes,
                                              declaredKind: x509.X509PublicKeyKind): int32 =
    if BytesLen(der) > 0:
        var cert: x509.X509Certificate
        let parseRes: Result[bool] = x509.x509ParseCertificateInto(cert, der)
        if IsOk(parseRes) && cert.publicKey.kind != x509.X509KeyUnknown:
            return msquicNativeX509KeyKindCode(cert.publicKey.kind)
    return msquicNativeX509KeyKindCode(declaredKind)

fn msquicNativeIsCryptoFrameCode(frameCode: int32): bool =
    return msquicNativeFrameCodeEquals(frameCode, msquicNativeFrameCryptoCode)

@borrows
fn msquicNativeCopyBytes(src: rawbytes.Bytes): rawbytes.Bytes =
    let srcLen: int32 = BytesLen(src)
    if srcLen <= 0:
        return emptyBytes()
    let out: rawbytes.Bytes = BytesAlloc(srcLen)
    for i in 0..<srcLen:
        BytesSet(out, i, BytesGet(src, i))
    return out

# Consume-and-release a scratch Bytes: takes the value by move so the exact
# consume schema sees the caller's def end at this call, then frees it.
fn msquicNativeFreeBytesMove(b: rawbytes.Bytes) =
    var tmp: rawbytes.Bytes = b
    BytesFree(tmp)

fn msquicNativeBytesAppend(dst: var rawbytes.Bytes, extra: rawbytes.Bytes) =
    let addLen: int32 = BytesLen(extra)
    if addLen <= 0:
        return
    if BytesLen(dst) <= 0:
        dst = BytesSlice(extra, 0, addLen)
        return
    # Bulk concat (native copy) instead of a byte-by-byte bounds-checked loop. The receive
    # reassembly burst appends ~1200B per packet to a growing buffer; the per-byte loop made
    # that O(n^2) with a ~50-100ns/byte constant (measured ~6ms/packet, the dominant recv
    # cost). bytesConcat3 copies in bulk, collapsing the constant ~100x.
    # Free the prior buffer: bytesConcat3 returns a fresh allocation, so without this
    # every append leaks the old .ready block — geometric native-heap growth on a stream.
    # Free THROUGH the by-ref param (not via a `var old = dst` local copy: the cold
    # frontend lowers a typed local bound from a by-ref struct param as the raw
    # (address, next-arg) pair, so BytesFree on such a copy frees the caller's
    # storage address — a static/globals pointer — instead of the owned buffer).
    let merged: rawbytes.Bytes = BytesConcat3(dst, extra, emptyBytes())
    BytesFree(dst)
    dst = merged

fn msquicNativeBytesTakePrefix(buf: var rawbytes.Bytes, count: int32): rawbytes.Bytes =
    if count <= 0:
        return emptyBytes()
    let curLen: int32 = BytesLen(buf)
    if curLen <= 0:
        return emptyBytes()
    var take: int32 = count
    if take > curLen:
        take = curLen
    let out: rawbytes.Bytes = BytesSlice(buf, 0, take)
    let remain: int32 = curLen - take
    if remain <= 0:
        # Whole buffer consumed into `out` (a fresh copy); free the original.
        # Free THROUGH the by-ref param (see msquicNativeBytesAppend: a typed local
        # bound from a by-ref struct param lowers to the raw (address, next-arg)
        # pair, so BytesFree on such a copy frees the caller's storage address).
        BytesFree(buf)
        buf = emptyBytes()
        return out
    # Bulk slice for the remainder (native copy) instead of a byte-by-byte loop — the app-read
    # path shifts the unread tail every read; per-byte made it O(n^2) on large reads.
    # bytesSlice returns a fresh allocation, so free the prior buffer or the take path
    # leaks the old .ready block on every read.
    let rest: rawbytes.Bytes = BytesSlice(buf, take, remain)
    BytesFree(buf)
    buf = rest
    return out

fn msquicNativeDebugWriteLine(text: str) =
    if ! msquicNativeDebugTls13:
        return
    let stderrOut = os.Get_stderr()
    os.WriteLine(stderrOut, text)

