@importc("cheng_mobile_udp_debug_event")
fn msquicNativeUdpDebugEvent(kind: int32, fd: int32, dataLen: int32, rc: int32, err: int32)

# --- QUIC transport 递归锁（dual-role 同进程 serve+client 并发互斥） ---
# 桥实现: darwin exe = core_runtime_provider_darwin.cheng (os_unfair_lock
# guard + owner/depth + 50us 退避); ohos/android = ssm1_ohos_shim.c
# (PTHREAD_MUTEX_RECURSIVE)。递归 = 锁 span 嵌套合法; fd 等待一律锁外。
@importc("cheng_native_quic_transport_lock_bridge")
fn msquicNativeTransportLockBridge()

@importc("cheng_native_quic_transport_unlock_bridge")
fn msquicNativeTransportUnlockBridge()

fn MsQuicNativeTransportLock() =
    msquicNativeTransportLockBridge()

fn MsQuicNativeTransportUnlock() =
    msquicNativeTransportUnlockBridge()

const
    msquicNativePipeBase = 1000000
    msquicNativePipeToken = msquicNativePipeBase + 1
    msquicNativeDatagramQueue = 16
    msquicNativeConnIdLen = 8
    msquicNativeShortPacketFlushBudget = 128
    msquicNativeVersion = 1
