# Native UDP + QUIC runtime for cheng.

@importc("cheng_monotime_ns")
fn msquicNativeRuntimeMonotimeNs(): int64

fn MsQuicNativeNowMs(): int64 =
    return msquicNativeRuntimeMonotimeNs() / 1000000

importc fn cheng_udp_recvfrom_addr_ptr_bridge(fd: int32, payload: ptr, payloadLen: int32, flags: int32, addr: ptr, addrCap: int32, outAddrLen: ptr, outErr: ptr): int32
