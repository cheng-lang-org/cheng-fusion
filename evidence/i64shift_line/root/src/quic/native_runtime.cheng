    MsQuicNativeAppStreamSlot =
        used: bool
        streamId: int64
        sendOffset: int64
        writeClosed: bool
        ready: rawbytes.Bytes
        nextOffset: int64
        peerClosed: bool
        peerFinalOffset: int64
        pendingCount: int32
