    msquicNativeDialReadyTimeoutMs = 20000
    msquicNativePipeReadTimeoutMs = 20000
    msquicNativeLongPacketRetransmitMs = 250
    msquicNativeParallelInitialGraceMs = 100
    msquicNativeControlFrameMaxBytes = 1200
    msquicNativePacketShortCode = 0
    msquicNativePacketInitialCode = 1
    msquicNativePacket0RttCode = 2
    msquicNativePacketHandshakeCode = 3
    msquicNativePacketRetryCode = 4
    msquicNativeProcessOutcomeNone = 0
    msquicNativeProcessOutcomeServerAccept = 1
    msquicNativeProcessOutcomeClientReady = 2
    msquicNativeFramePaddingCode: int32 = 0
    msquicNativeFramePingCode: int32 = 1
    msquicNativeFrameAckCode: int32 = 2
    # SACK recv window: tracks app short-packet numbers above the contiguous
    # frontier so the ACK frame can report gaps. One flag slot per pn, window
    # comfortably covers in-flight + reorder (cwnd cap 192KB / ~1200B ≈ 160).
    msquicNativeSackWindowBits: int32 = 4096
    msquicNativeSackMaxRanges: int32 = 64
    msquicNativeFrameCryptoCode: int32 = 6
    msquicNativeFrameDataCode: int32 = 14
    msquicNativeFrameDataFinCode: int32 = 15
    msquicNativeFrameMaxDataCode: int32 = 16
    msquicNativeFrameMaxStreamDataCode: int32 = 17
    msquicNativeFrameConnectionCloseCode: int32 = 28
    msquicNativeFrameConnectionCloseAppCode: int32 = 29
    msquicNativeFrameHandshakeDoneCode: int32 = 30
    msquicNativeFrameDatagramCode: int32 = 48
    msquicNativeAppRecvMaxChunks = 512
    msquicNativeAppStreamSlotCount = 16
    N_SLOTS: int32 = 8
    msquicNativeSackWindowBitsAll: int32 = 32768
    # 8 slots * 16 streams. Keep this as a literal until the cold backend
    # handles const*const fixed-array lengths for the second same-type global.
    msquicNativeAppStreamSlotTotal: int32 = 128
    msquicNativeUdpAfInet = 2
    msquicNativeUdpAfInet6Linux = 10
    msquicNativeUdpAfInet6Bsd = 30
    msquicNativeUdpRecvMaxBytes = 2048
    msquicNativeUdpErrAgainLinux = 11
    msquicNativeUdpErrAgainBsd = 35
    msquicNativeUdpErrWouldBlockLinux = 11
    msquicNativeUdpErrWouldBlockBsd = 35
    msquicNativeUdpErrWouldBlockMingw = 17
    msquicNativeUdpErrIntr = 4
    msquicNativeUdpErrWouldBlockWindows = 10035
    msquicNativeUdpErrIntrWindows = 10004
    msquicNativeUdpErrConnResetWindows = 10054

type
    MsQuicNativeEndpoint =
        datagramCount: int32
        sendOffset: int64
        ready: bool
        maxDataSent: bool
        maxStreamDataSent: bool

    MsQuicNativeAppRecvChunk =
        used: bool
