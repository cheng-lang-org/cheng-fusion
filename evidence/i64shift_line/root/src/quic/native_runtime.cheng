    MsQuicNativeAppStreamSlots =
        client: MsQuicNativeAppStreamSlot[msquicNativeAppStreamSlotCount]
        server: MsQuicNativeAppStreamSlot[msquicNativeAppStreamSlotCount]

    MsQuicNativeSession =
        active: bool
        closed: bool
        serverBound: bool
        serverFlightSent: bool
        clientFinishedSent: bool
        serverHandshakeDoneOutstanding: bool
