import std/strutils as strutil
# MsQuic datapath runtime (in-process loopback runtime).

import std/result
import std/rawbytes
import std/strings
import std/os
import cheng/quic/platform/common as platform_common
import cheng/quic/platform/datapath_model
import cheng/quic/platform/datapath_udp as udpdp

const
    maxMsQuicDatapaths = 16

type
    MsQuicDatapathRuntimeSlot =
        id: int32
        kind: int32
        active: bool
        udpSocketId: int32
        udpUseLenField: bool
        udpLastTos: int32
        udpLastTosIsV6: bool
        udpAddr: str
        packetsSent: int64
        packetsRecv: int64
        bytesSent: int64
        bytesRecv: int64

    MsQuicDatapathRuntime =
        count: int32
        nextId: int32
        slots: MsQuicDatapathRuntimeSlot[maxMsQuicDatapaths]

var
    msquicDatapathGlobalRt: MsQuicDatapathRuntime
    msquicDatapathGlobalUdpAddrId0: int32
    msquicDatapathGlobalUdpAddrText0: str
    msquicDatapathGlobalUdpPort0: int32
    msquicDatapathGlobalUdpAddrId1: int32
    msquicDatapathGlobalUdpAddrText1: str
    msquicDatapathGlobalUdpPort1: int32
    msquicDatapathGlobalUdpAddrId2: int32
    msquicDatapathGlobalUdpAddrText2: str
    msquicDatapathGlobalUdpPort2: int32
    msquicDatapathGlobalUdpAddrId3: int32
    msquicDatapathGlobalUdpAddrText3: str
    msquicDatapathGlobalUdpPort3: int32

fn initMsQuicDatapathRuntimeSlotInto(out: var MsQuicDatapathRuntime, i: int32) =
    out.slots[i].id = 0
    out.slots[i].kind = 0
    out.slots[i].active = false
    out.slots[i].udpSocketId = -1
    out.slots[i].udpUseLenField = false
    out.slots[i].udpLastTos = -1
    out.slots[i].udpLastTosIsV6 = false
    out.slots[i].udpAddr = ""
    out.slots[i].packetsSent = int64(0)
    out.slots[i].packetsRecv = int64(0)
    out.slots[i].bytesSent = int64(0)
    out.slots[i].bytesRecv = int64(0)

fn initMsQuicDatapathRuntimeInto(out: var MsQuicDatapathRuntime) =
    out.count = 0
    out.nextId = 1
    for i in 0..<maxMsQuicDatapaths:
        initMsQuicDatapathRuntimeSlotInto(out, i)

fn initMsQuicDatapathRuntime(): MsQuicDatapathRuntime =
    var out: MsQuicDatapathRuntime
    initMsQuicDatapathRuntimeInto(out)
    return out

fn MsQuicDatapathGlobalInit() =
    for i in 0..<msquicDatapathGlobalRt.count:
        if msquicDatapathGlobalRt.slots[i].udpSocketId >= 0:
            udpdp.msquicUdpUnbind(msquicDatapathGlobalRt.slots[i].udpSocketId)
    initMsQuicDatapathRuntimeInto(msquicDatapathGlobalRt)
    msquicDatapathGlobalUdpAddrId0 = 0
    msquicDatapathGlobalUdpAddrText0 = ""
    msquicDatapathGlobalUdpPort0 = 0
    msquicDatapathGlobalUdpAddrId1 = 0
    msquicDatapathGlobalUdpAddrText1 = ""
    msquicDatapathGlobalUdpPort1 = 0
    msquicDatapathGlobalUdpAddrId2 = 0
    msquicDatapathGlobalUdpAddrText2 = ""
    msquicDatapathGlobalUdpPort2 = 0
    msquicDatapathGlobalUdpAddrId3 = 0
    msquicDatapathGlobalUdpAddrText3 = ""
    msquicDatapathGlobalUdpPort3 = 0

fn msquicDatapathGlobalInit() =
    MsQuicDatapathGlobalInit()

@borrows
fn msquicDatapathGlobalRememberUdpAddr(id: int32, text: str, port: int32) =
    if msquicDatapathGlobalUdpAddrId0 == id || msquicDatapathGlobalUdpAddrId0 == 0:
        msquicDatapathGlobalUdpAddrId0 = id
        msquicDatapathGlobalUdpAddrText0 = strings.CloneStr(text)
        msquicDatapathGlobalUdpPort0 = port
        return
    if msquicDatapathGlobalUdpAddrId1 == id || msquicDatapathGlobalUdpAddrId1 == 0:
        msquicDatapathGlobalUdpAddrId1 = id
        msquicDatapathGlobalUdpAddrText1 = strings.CloneStr(text)
        msquicDatapathGlobalUdpPort1 = port
        return
    if msquicDatapathGlobalUdpAddrId2 == id || msquicDatapathGlobalUdpAddrId2 == 0:
        msquicDatapathGlobalUdpAddrId2 = id
        msquicDatapathGlobalUdpAddrText2 = strings.CloneStr(text)
        msquicDatapathGlobalUdpPort2 = port
        return
    if msquicDatapathGlobalUdpAddrId3 == id || msquicDatapathGlobalUdpAddrId3 == 0:
        msquicDatapathGlobalUdpAddrId3 = id
        msquicDatapathGlobalUdpAddrText3 = strings.CloneStr(text)
        msquicDatapathGlobalUdpPort3 = port
        return

# Free the remembered-addr slot for a datapath id when it is unbound/closed. Without
# this the 4-slot table fills after ~4 dials (monotonic ids never recycle), so the 5th
# dial cannot record its bound addr → handshake never readies / datapath churn crash.
fn msquicDatapathGlobalForgetUdpAddr(id: int32) =
    if id == 0:
        return
    if msquicDatapathGlobalUdpAddrId0 == id:
        msquicDatapathGlobalUdpAddrId0 = 0
        msquicDatapathGlobalUdpAddrText0 = ""
        msquicDatapathGlobalUdpPort0 = 0
    if msquicDatapathGlobalUdpAddrId1 == id:
        msquicDatapathGlobalUdpAddrId1 = 0
        msquicDatapathGlobalUdpAddrText1 = ""
        msquicDatapathGlobalUdpPort1 = 0
    if msquicDatapathGlobalUdpAddrId2 == id:
        msquicDatapathGlobalUdpAddrId2 = 0
        msquicDatapathGlobalUdpAddrText2 = ""
        msquicDatapathGlobalUdpPort2 = 0
    if msquicDatapathGlobalUdpAddrId3 == id:
        msquicDatapathGlobalUdpAddrId3 = 0
        msquicDatapathGlobalUdpAddrText3 = ""
        msquicDatapathGlobalUdpPort3 = 0

fn msquicDatapathGlobalRememberedUdpAddr(id: int32): str =
    if msquicDatapathGlobalUdpAddrId0 == id:
        return strings.CloneStr(msquicDatapathGlobalUdpAddrText0)
    if msquicDatapathGlobalUdpAddrId1 == id:
        return strings.CloneStr(msquicDatapathGlobalUdpAddrText1)
    if msquicDatapathGlobalUdpAddrId2 == id:
        return strings.CloneStr(msquicDatapathGlobalUdpAddrText2)
    if msquicDatapathGlobalUdpAddrId3 == id:
        return strings.CloneStr(msquicDatapathGlobalUdpAddrText3)
    return ""

fn MsQuicDatapathGlobalUdpPort(id: int32): int32 =
    if msquicDatapathGlobalUdpAddrId0 == id:
        return msquicDatapathGlobalUdpPort0
    if msquicDatapathGlobalUdpAddrId1 == id:
        return msquicDatapathGlobalUdpPort1
    if msquicDatapathGlobalUdpAddrId2 == id:
        return msquicDatapathGlobalUdpPort2
    if msquicDatapathGlobalUdpAddrId3 == id:
        return msquicDatapathGlobalUdpPort3
    return 0

fn msquicDatapathGlobalUdpPort(id: int32): int32 =
    return MsQuicDatapathGlobalUdpPort(id)

fn MsQuicDatapathGlobalUdpPortInto(id: int32, outPort: var int32): bool =
    if msquicDatapathGlobalUdpAddrId0 == id:
        outPort = msquicDatapathGlobalUdpPort0
        return outPort > 0
    if msquicDatapathGlobalUdpAddrId1 == id:
        outPort = msquicDatapathGlobalUdpPort1
        return outPort > 0
    if msquicDatapathGlobalUdpAddrId2 == id:
        outPort = msquicDatapathGlobalUdpPort2
        return outPort > 0
    if msquicDatapathGlobalUdpAddrId3 == id:
        outPort = msquicDatapathGlobalUdpPort3
        return outPort > 0
    outPort = 0
    return false

fn msquicDatapathGlobalUdpPortInto(id: int32, outPort: var int32): bool =
    return MsQuicDatapathGlobalUdpPortInto(id, outPort)

fn msquicDatapathFind(rt: var MsQuicDatapathRuntime, id: int32): int32 =
    for i in 0..<rt.count:
        if rt.slots[i].id == id:
            return i
    return -1

fn msquicDatapathFindMut(rt: var MsQuicDatapathRuntime, id: int32): int32 =
    for i in 0..<rt.count:
        if rt.slots[i].id == id:
            return i
    return -1

fn msquicDatapathAdd(rt: var MsQuicDatapathRuntime, kind: int32): Result[int32] =
    if rt.count >= maxMsQuicDatapaths:
        return Err[int32]("msquic datapath: runtime full")
    let idx: int32 = rt.count
    if rt.nextId < 1:
        rt.nextId = 1
    let id: int32 = rt.nextId
    rt.nextId = rt.nextId + 1
    rt.slots[idx].id = id
    rt.slots[idx].kind = kind
    rt.slots[idx].active = false
    rt.slots[idx].udpSocketId = -1
    rt.slots[idx].udpUseLenField = false
    rt.slots[idx].udpLastTos = -1
    rt.slots[idx].udpLastTosIsV6 = false
    rt.slots[idx].udpAddr = ""
    rt.slots[idx].packetsSent = int64(0)
    rt.slots[idx].packetsRecv = int64(0)
    rt.slots[idx].bytesSent = int64(0)
    rt.slots[idx].bytesRecv = int64(0)
    rt.count = rt.count + 1
    return Ok[int32](id)

fn msquicDatapathAddCode(rt: var MsQuicDatapathRuntime, kind: int32): int32 =
    if rt.count >= maxMsQuicDatapaths:
        return -1
    let idx: int32 = rt.count
    if rt.nextId < 1:
        rt.nextId = 1
    let id: int32 = rt.nextId
    rt.nextId = rt.nextId + 1
    initMsQuicDatapathRuntimeSlotInto(rt, idx)
    rt.slots[idx].id = id
    rt.slots[idx].kind = kind
    rt.slots[idx].active = false
    rt.slots[idx].udpSocketId = -1
    rt.slots[idx].udpUseLenField = false
    rt.slots[idx].udpLastTos = -1
    rt.slots[idx].udpLastTosIsV6 = false
    rt.slots[idx].udpAddr = ""
    rt.count = rt.count + 1
    return id

fn MsQuicDatapathGlobalAddCode(kind: int32): int32 =
    if msquicDatapathGlobalRt.count >= maxMsQuicDatapaths:
        return -1
    let idx: int32 = msquicDatapathGlobalRt.count
    if msquicDatapathGlobalRt.nextId < 1:
        msquicDatapathGlobalRt.nextId = 1
    let id: int32 = msquicDatapathGlobalRt.nextId
    msquicDatapathGlobalRt.nextId = msquicDatapathGlobalRt.nextId + 1
    initMsQuicDatapathRuntimeSlotInto(msquicDatapathGlobalRt, idx)
    msquicDatapathGlobalRt.slots[idx].id = id
    msquicDatapathGlobalRt.slots[idx].kind = kind
    msquicDatapathGlobalRt.slots[idx].active = false
    msquicDatapathGlobalRt.slots[idx].udpSocketId = -1
    msquicDatapathGlobalRt.slots[idx].udpUseLenField = false
    msquicDatapathGlobalRt.slots[idx].udpLastTos = -1
    msquicDatapathGlobalRt.slots[idx].udpLastTosIsV6 = false
    msquicDatapathGlobalRt.slots[idx].udpAddr = ""
    msquicDatapathGlobalRt.count = msquicDatapathGlobalRt.count + 1
    return id

fn msquicDatapathGlobalAddCode(kind: int32): int32 =
    return MsQuicDatapathGlobalAddCode(kind)

fn MsQuicDatapathGlobalAddCodeInto(kind: int32, outId: var int32): bool =
    if msquicDatapathGlobalRt.count >= maxMsQuicDatapaths:
        outId = -1
        return false
    let idx: int32 = msquicDatapathGlobalRt.count
    if msquicDatapathGlobalRt.nextId < 1:
        msquicDatapathGlobalRt.nextId = 1
    let id: int32 = msquicDatapathGlobalRt.nextId
    msquicDatapathGlobalRt.nextId = msquicDatapathGlobalRt.nextId + 1
    initMsQuicDatapathRuntimeSlotInto(msquicDatapathGlobalRt, idx)
    msquicDatapathGlobalRt.slots[idx].id = id
    msquicDatapathGlobalRt.slots[idx].kind = kind
    msquicDatapathGlobalRt.slots[idx].active = false
    msquicDatapathGlobalRt.slots[idx].udpSocketId = -1
    msquicDatapathGlobalRt.slots[idx].udpUseLenField = false
    msquicDatapathGlobalRt.slots[idx].udpLastTos = -1
    msquicDatapathGlobalRt.slots[idx].udpLastTosIsV6 = false
    msquicDatapathGlobalRt.slots[idx].udpAddr = ""
    msquicDatapathGlobalRt.count = msquicDatapathGlobalRt.count + 1
    outId = id
    return true

fn msquicDatapathStart(rt: var MsQuicDatapathRuntime, id: int32): Result[bool] =
    let idx: int32 = msquicDatapathFindMut(rt, id)
    if idx < 0:
        return Err[bool]("msquic datapath: ! found")
    rt.slots[idx].active = true
    return Ok[bool](true)

fn msquicDatapathStartCode(rt: var MsQuicDatapathRuntime, id: int32): int32 =
    let idx: int32 = msquicDatapathFindMut(rt, id)
    if idx < 0:
        return -1
    rt.slots[idx].active = true
    return 1

fn MsQuicDatapathGlobalStartCode(id: int32): int32 =
    let idx: int32 = msquicDatapathFindMut(msquicDatapathGlobalRt, id)
    if idx < 0:
        return -1
    msquicDatapathGlobalRt.slots[idx].active = true
    return 1

fn msquicDatapathGlobalStartCode(id: int32): int32 =
    return MsQuicDatapathGlobalStartCode(id)

fn MsQuicDatapathGlobalStart(id: int32): bool =
    let idx: int32 = msquicDatapathFindMut(msquicDatapathGlobalRt, id)
    if idx < 0:
        return false
    msquicDatapathGlobalRt.slots[idx].active = true
    return true

fn msquicDatapathGlobalStart(id: int32): bool =
    return MsQuicDatapathGlobalStart(id)

fn msquicDatapathDropAt(rt: var MsQuicDatapathRuntime, idx: int32) =
    if idx < 0 || idx >= rt.count:
        return
    let last = rt.count - 1
    if idx != last:
        rt.slots[idx].id = rt.slots[last].id
        rt.slots[idx].kind = rt.slots[last].kind
        rt.slots[idx].active = rt.slots[last].active
        rt.slots[idx].udpSocketId = rt.slots[last].udpSocketId
        rt.slots[idx].udpUseLenField = rt.slots[last].udpUseLenField
        rt.slots[idx].udpLastTos = rt.slots[last].udpLastTos
        rt.slots[idx].udpLastTosIsV6 = rt.slots[last].udpLastTosIsV6
        rt.slots[idx].udpAddr = strings.ConcatStr(rt.slots[last].udpAddr, "")
        rt.slots[idx].packetsSent = rt.slots[last].packetsSent
        rt.slots[idx].packetsRecv = rt.slots[last].packetsRecv
        rt.slots[idx].bytesSent = rt.slots[last].bytesSent
        rt.slots[idx].bytesRecv = rt.slots[last].bytesRecv
    initMsQuicDatapathRuntimeSlotInto(rt, last)
    rt.count = rt.count - 1

fn msquicDatapathStop(rt: var MsQuicDatapathRuntime, id: int32): Result[bool] =
    let idx: int32 = msquicDatapathFindMut(rt, id)
    if idx < 0:
        return Err[bool]("msquic datapath: ! found")
    if rt.slots[idx].udpSocketId >= 0:
        udpdp.msquicUdpUnbind(rt.slots[idx].udpSocketId)
    msquicDatapathDropAt(rt, idx)
    return Ok[bool](true)

fn msquicDatapathStopCode(rt: var MsQuicDatapathRuntime, id: int32): int32 =
    let idx: int32 = msquicDatapathFindMut(rt, id)
    if idx < 0:
        return -1
    if rt.slots[idx].udpSocketId >= 0:
        udpdp.msquicUdpUnbind(rt.slots[idx].udpSocketId)
    msquicDatapathDropAt(rt, idx)
    return 1

fn MsQuicDatapathGlobalStopCode(id: int32): int32 =
    let idx: int32 = msquicDatapathFindMut(msquicDatapathGlobalRt, id)
    if idx < 0:
        return -1
    if msquicDatapathGlobalRt.slots[idx].udpSocketId >= 0:
        udpdp.msquicUdpUnbind(msquicDatapathGlobalRt.slots[idx].udpSocketId)
    msquicDatapathGlobalForgetUdpAddr(id)
    msquicDatapathDropAt(msquicDatapathGlobalRt, idx)
    return 1

fn msquicDatapathGlobalStopCode(id: int32): int32 =
    return MsQuicDatapathGlobalStopCode(id)

fn msquicDatapathRecordSend(rt: var MsQuicDatapathRuntime, id: int32, bytes: int64): Result[bool] =
    let idx: int32 = msquicDatapathFindMut(rt, id)
    if idx < 0:
        return Err[bool]("msquic datapath: ! found")
    rt.slots[idx].packetsSent = rt.slots[idx].packetsSent + 1
    if bytes > 0:
        rt.slots[idx].bytesSent = rt.slots[idx].bytesSent + bytes
    return Ok[bool](true)

fn msquicDatapathRecordRecv(rt: var MsQuicDatapathRuntime, id: int32, bytes: int64): Result[bool] =
    let idx: int32 = msquicDatapathFindMut(rt, id)
    if idx < 0:
        return Err[bool]("msquic datapath: ! found")
    rt.slots[idx].packetsRecv = rt.slots[idx].packetsRecv + 1
    if bytes > 0:
        rt.slots[idx].bytesRecv = rt.slots[idx].bytesRecv + bytes
    return Ok[bool](true)

fn msquicDatapathSummary(rt: var MsQuicDatapathRuntime, id: int32): str =
    let idx: int32 = msquicDatapathFind(rt, id)
    if idx < 0:
        return ""
    var out: str = if rt.slots[idx].kind == 1: "highperf" else: "basic"
    out = strutil.Join([ share(out), " id=", platform_common.msquicPlatformIntToString(rt.slots[idx].id)], "")
    out = strutil.Join([ share(out), " packetsSent=", platform_common.msquicPlatformIntToString(rt.slots[idx].packetsSent)], "")
    out = strutil.Join([ share(out), " packetsRecv=", platform_common.msquicPlatformIntToString(rt.slots[idx].packetsRecv)], "")
    return out

fn msquicDatapathPacketsSent(rt: var MsQuicDatapathRuntime, id: int32): int64 =
    let idx: int32 = msquicDatapathFind(rt, id)
    if idx < 0:
        return int64(0)
    return rt.slots[idx].packetsSent

fn msquicDatapathPacketsRecv(rt: var MsQuicDatapathRuntime, id: int32): int64 =
    let idx: int32 = msquicDatapathFind(rt, id)
    if idx < 0:
        return int64(0)
    return rt.slots[idx].packetsRecv

fn msquicDatapathBindUdp(rt: var MsQuicDatapathRuntime, id: int32, addrText: str): Result[bool] =
    let idx: int32 = msquicDatapathFindMut(rt, id)
    if idx < 0:
        return Err[bool]("msquic datapath: ! found")
    if rt.slots[idx].udpSocketId >= 0:
        return Ok[bool](true)
    var bound: udpdp.MsQuicUdpBound
    let sockRes: Result[bool] = udpdp.msquicUdpBindInto(bound, addrText)
    if IsErr(sockRes):
        return Err[bool](ErrorText(sockRes))
    rt.slots[idx].udpSocketId = bound.fd
    rt.slots[idx].udpUseLenField = bound.useLenField
    rt.slots[idx].udpLastTos = -1
    rt.slots[idx].udpLastTosIsV6 = false
    rt.slots[idx].udpAddr = bound.addr
    msquicDatapathGlobalRememberUdpAddr(id, bound.addr, bound.port)
    return Ok[bool](true)

fn msquicDatapathGlobalBindUdp(id: int32, addrText: str): Result[bool] =
    return msquicDatapathBindUdp(msquicDatapathGlobalRt, id, addrText)

fn msquicDatapathBindUdpCode(rt: var MsQuicDatapathRuntime, id: int32, addrText: str): int32 =
    let idx: int32 = msquicDatapathFindMut(rt, id)
    if idx < 0:
        return -1
    var bound: udpdp.MsQuicUdpBound
    let sockRes: Result[bool] = udpdp.msquicUdpBindInto(bound, addrText)
    if IsErr(sockRes):
        return -2
    rt.slots[idx].udpSocketId = bound.fd
    rt.slots[idx].udpUseLenField = bound.useLenField
    rt.slots[idx].udpLastTos = -1
    rt.slots[idx].udpLastTosIsV6 = false
    rt.slots[idx].udpAddr = bound.addr
    msquicDatapathGlobalRememberUdpAddr(id, bound.addr, bound.port)
    return bound.fd + 1

fn MsQuicDatapathGlobalBindUdpCode(id: int32, addrText: str): int32 =
    let idx: int32 = msquicDatapathFindMut(msquicDatapathGlobalRt, id)
    if idx < 0:
        return -1
    var bound: udpdp.MsQuicUdpBound
    let sockRes: Result[bool] = udpdp.msquicUdpBindInto(bound, addrText)
    if IsErr(sockRes):
        return -2
    msquicDatapathGlobalRt.slots[idx].udpSocketId = bound.fd
    msquicDatapathGlobalRt.slots[idx].udpUseLenField = bound.useLenField
    msquicDatapathGlobalRt.slots[idx].udpLastTos = -1
    msquicDatapathGlobalRt.slots[idx].udpLastTosIsV6 = false
    msquicDatapathGlobalRt.slots[idx].udpAddr = bound.addr
    msquicDatapathGlobalRememberUdpAddr(id, bound.addr, bound.port)
    return bound.fd + 1

fn msquicDatapathGlobalBindUdpCode(id: int32, addrText: str): int32 =
    return MsQuicDatapathGlobalBindUdpCode(id, addrText)

fn msquicDatapathUdpAddr(rt: var MsQuicDatapathRuntime, id: int32): str =
    let remembered: str = msquicDatapathGlobalRememberedUdpAddr(id)
    if len(remembered) > 0:
        return remembered
    let idx: int32 = msquicDatapathFind(rt, id)
    if idx < 0:
        return ""
    return rt.slots[idx].udpAddr

fn MsQuicDatapathGlobalUdpAddr(id: int32): str =
    let remembered: str = msquicDatapathGlobalRememberedUdpAddr(id)
    if len(remembered) > 0:
        return remembered
    let idx: int32 = msquicDatapathFind(msquicDatapathGlobalRt, id)
    if idx < 0:
        return ""
    return strings.ConcatStr(msquicDatapathGlobalRt.slots[idx].udpAddr, "")

fn msquicDatapathGlobalUdpAddr(id: int32): str =
    return MsQuicDatapathGlobalUdpAddr(id)

fn msquicDatapathUdpBound(rt: var MsQuicDatapathRuntime, id: int32): bool =
    let idx: int32 = msquicDatapathFind(rt, id)
    if idx < 0:
        return false
    return rt.slots[idx].udpSocketId >= 0

fn MsQuicDatapathGlobalUdpBound(id: int32): bool =
    let idx: int32 = msquicDatapathFind(msquicDatapathGlobalRt, id)
    if idx < 0:
        return false
    return msquicDatapathGlobalRt.slots[idx].udpSocketId >= 0

fn msquicDatapathGlobalUdpBound(id: int32): bool =
    return MsQuicDatapathGlobalUdpBound(id)

fn msquicDatapathGlobalUdpFd(id: int32): int32 =
    let idx: int32 = msquicDatapathFind(msquicDatapathGlobalRt, id)
    if idx < 0:
        return -1
    if !msquicDatapathGlobalRt.slots[idx].active:
        return -1
    return msquicDatapathGlobalRt.slots[idx].udpSocketId

fn MsQuicDatapathGlobalUdpFd(id: int32): int32 =
    return msquicDatapathGlobalUdpFd(id)

fn msquicDatapathUnbindUdp(rt: var MsQuicDatapathRuntime, id: int32) =
    let idx: int32 = msquicDatapathFindMut(rt, id)
    if idx < 0:
        return
    if rt.slots[idx].udpSocketId >= 0:
        udpdp.msquicUdpUnbind(rt.slots[idx].udpSocketId)
    rt.slots[idx].udpSocketId = -1
    rt.slots[idx].udpUseLenField = false
    rt.slots[idx].udpLastTos = -1
    rt.slots[idx].udpLastTosIsV6 = false
    rt.slots[idx].udpAddr = ""

fn MsQuicDatapathGlobalUnbindUdp(id: int32) =
    let idx: int32 = msquicDatapathFindMut(msquicDatapathGlobalRt, id)
    if idx < 0:
        return
    if msquicDatapathGlobalRt.slots[idx].udpSocketId >= 0:
        udpdp.msquicUdpUnbind(msquicDatapathGlobalRt.slots[idx].udpSocketId)
    msquicDatapathGlobalRt.slots[idx].udpSocketId = -1
    msquicDatapathGlobalRt.slots[idx].udpUseLenField = false
    msquicDatapathGlobalRt.slots[idx].udpLastTos = -1
    msquicDatapathGlobalRt.slots[idx].udpLastTosIsV6 = false
    msquicDatapathGlobalRt.slots[idx].udpAddr = ""
    # Recycle the remembered-addr slot so rapid re-dial doesn't overflow the 4-slot table.
    msquicDatapathGlobalForgetUdpAddr(id)

fn msquicDatapathGlobalUnbindUdp(id: int32) =
    MsQuicDatapathGlobalUnbindUdp(id)

fn msquicDatapathSendUdp(
    rt: var MsQuicDatapathRuntime,
    id: int32,
    toAddr: str,
    data: Bytes,
    dscp: int32
): Result[bool] =
    let idx: int32 = msquicDatapathFindMut(rt, id)
    if idx < 0:
        return Err[bool]("msquic datapath send: !found")
    if ! rt.slots[idx].active:
        return Err[bool]("msquic datapath send: closed")
    if rt.slots[idx].udpSocketId < 0:
        return Err[bool]("msquic datapath send: !bound")
    var lastTos: int32 = rt.slots[idx].udpLastTos
    var lastTosIsV6: bool = rt.slots[idx].udpLastTosIsV6
    let sendRes: Result[bool] = udpdp.msquicUdpSend(
        rt.slots[idx].udpSocketId,
        rt.slots[idx].udpUseLenField,
        lastTos,
        lastTosIsV6,
        toAddr,
        data,
        dscp
    )
    rt.slots[idx].udpLastTos = lastTos
    rt.slots[idx].udpLastTosIsV6 = lastTosIsV6
    if IsErr(sendRes):
        return Err[bool](ErrorText(sendRes))
    let recordSendRes: Result[bool] = msquicDatapathRecordSend(rt, id, int64(BytesLen(data)))
    if IsErr(recordSendRes):
        return Err[bool](ErrorText(recordSendRes))
    return Ok[bool](true)

@borrows
fn MsQuicDatapathGlobalSendUdp(
    id: int32,
    toAddr: str,
    data: Bytes,
    dscp: int32
): Result[bool] =
    let idx: int32 = msquicDatapathFindMut(msquicDatapathGlobalRt, id)
    if idx < 0:
        return Err[bool]("msquic datapath send: !found")
    if ! msquicDatapathGlobalRt.slots[idx].active:
        return Err[bool]("msquic datapath send: closed")
    if msquicDatapathGlobalRt.slots[idx].udpSocketId < 0:
        return Err[bool]("msquic datapath send: !bound")
    var lastTos: int32 = msquicDatapathGlobalRt.slots[idx].udpLastTos
    var lastTosIsV6: bool = msquicDatapathGlobalRt.slots[idx].udpLastTosIsV6
    let sendRes: Result[bool] = udpdp.msquicUdpSend(
        msquicDatapathGlobalRt.slots[idx].udpSocketId,
        msquicDatapathGlobalRt.slots[idx].udpUseLenField,
        lastTos,
        lastTosIsV6,
        toAddr,
        data,
        dscp
    )
    msquicDatapathGlobalRt.slots[idx].udpLastTos = lastTos
    msquicDatapathGlobalRt.slots[idx].udpLastTosIsV6 = lastTosIsV6
    if IsErr(sendRes):
        return Err[bool](ErrorText(sendRes))
    let recordSendRes: Result[bool] = msquicDatapathRecordSend(msquicDatapathGlobalRt, id, int64(BytesLen(data)))
    if IsErr(recordSendRes):
        return Err[bool](ErrorText(recordSendRes))
    return Ok[bool](true)

fn msquicDatapathGlobalSendUdp(
    id: int32,
    toAddr: str,
    data: Bytes,
    dscp: int32
): Result[bool] =
    return MsQuicDatapathGlobalSendUdp(id, toAddr, data, dscp)

fn msquicDatapathRecvUdp(rt: var MsQuicDatapathRuntime, id: int32): Result[udpdp.MsQuicUdpDatagram] =
    let idx: int32 = msquicDatapathFindMut(rt, id)
    if idx < 0:
        return Err[udpdp.MsQuicUdpDatagram]("msquic datapath: ! found")
    if ! rt.slots[idx].active:
        return Err[udpdp.MsQuicUdpDatagram]("msquic datapath: closed")
    if rt.slots[idx].udpSocketId < 0:
        return Err[udpdp.MsQuicUdpDatagram]("msquic datapath: udp ! bound")
    let recvRes: Result[udpdp.MsQuicUdpDatagram] = udpdp.msquicUdpRecv(rt.slots[idx].udpSocketId)
    if IsErr(recvRes):
        return Err[udpdp.MsQuicUdpDatagram](ErrorText(recvRes))
    let recvBytes: int64 = int64(BytesLen(Value(recvRes).data))
    let recordRecvRes: Result[bool] = msquicDatapathRecordRecv(rt, id, recvBytes)
    if IsErr(recordRecvRes):
        return Err[udpdp.MsQuicUdpDatagram](ErrorText(recordRecvRes))
    return recvRes

fn msquicDatapathGlobalRecvUdp(id: int32): Result[udpdp.MsQuicUdpDatagram] =
    return msquicDatapathRecvUdp(msquicDatapathGlobalRt, id)

fn msquicDatapathRecvUdpInto(rt: var MsQuicDatapathRuntime, id: int32, out: var udpdp.MsQuicUdpDatagram): int32 =
    let idx: int32 = msquicDatapathFindMut(rt, id)
    if idx < 0:
        return -1
    if ! rt.slots[idx].active:
        return -1
    if rt.slots[idx].udpSocketId < 0:
        return -1
    let recvCode: int32 = udpdp.msquicUdpRecvBlockingInto(rt.slots[idx].udpSocketId, out)
    if recvCode <= 0:
        return recvCode
    let recvBytes: int64 = int64(BytesLen(out.data))
    let recordRecvRes: Result[bool] = msquicDatapathRecordRecv(rt, id, recvBytes)
    if IsErr(recordRecvRes):
        return -1
    return 1

fn msquicDatapathGlobalRecvUdpInto(id: int32, out: var udpdp.MsQuicUdpDatagram): int32 =
    return msquicDatapathRecvUdpInto(msquicDatapathGlobalRt, id, out)

fn msquicDatapathRecvUdpBlocking(rt: var MsQuicDatapathRuntime, id: int32): Result[udpdp.MsQuicUdpDatagram] =
    let idx: int32 = msquicDatapathFindMut(rt, id)
    if idx < 0:
        return Err[udpdp.MsQuicUdpDatagram]("msquic datapath: ! found")
    if ! rt.slots[idx].active:
        return Err[udpdp.MsQuicUdpDatagram]("msquic datapath: closed")
    if rt.slots[idx].udpSocketId < 0:
        return Err[udpdp.MsQuicUdpDatagram]("msquic datapath: udp ! bound")
    let recvRes: Result[udpdp.MsQuicUdpDatagram] = udpdp.msquicUdpRecvBlocking(rt.slots[idx].udpSocketId)
    if IsErr(recvRes):
        return Err[udpdp.MsQuicUdpDatagram](ErrorText(recvRes))
    let recvBytes: int64 = int64(BytesLen(Value(recvRes).data))
    let recordRecvRes: Result[bool] = msquicDatapathRecordRecv(rt, id, recvBytes)
    if IsErr(recordRecvRes):
        return Err[udpdp.MsQuicUdpDatagram](ErrorText(recordRecvRes))
    return recvRes

fn msquicDatapathGlobalRecvUdpBlocking(id: int32): Result[udpdp.MsQuicUdpDatagram] =
    return msquicDatapathRecvUdpBlocking(msquicDatapathGlobalRt, id)
