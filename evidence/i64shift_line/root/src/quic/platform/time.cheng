# MsQuic platform time helpers(port scaffold).

@importc("cheng_monotime_ns")
fn msquicPlatformMonotimeNs(): int64

fn msquicPlatformNowMs(): int64 =
    return msquicPlatformMonotimeNs() / 1000000

fn msquicPlatformNowUs(): int64 =
    return msquicPlatformMonotimeNs() / 1000

fn MsQuicPlatformNowMsForProbe(): int64 =
    return msquicPlatformNowMs()
