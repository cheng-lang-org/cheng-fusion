fn msquicLocalhostPublicKeyBytes(): Bytes =
    var out: Bytes
    msquicLocalhostPublicKeyBytesInto(out)
    return out

fn msquicLocalhostPublicKeyBytesInto(out: var Bytes) =
    var certDer: Bytes
    var cert: x509.X509Certificate = x509.initX509Certificate()
    msquicLocalhostCertDerInto(certDer)
    let parseRes: Result[bool] = x509.x509ParseCertificateInto(cert, certDer)
    assert(IsOk(parseRes), "msquic test pki: parse leaf cert public key")
    let pubBytesRes: Result[bool] = x509.x509PublicKeyBytesInto(out, cert.publicKey)
    assert(IsOk(pubBytesRes), "msquic test pki: encode leaf public key")

fn msquicLocalhostRsaPublicKeyPartsInto(outN: var Bytes, outE: var Bytes) =
    var certDer: Bytes
    var cert: x509.X509Certificate = x509.initX509Certificate()
    msquicLocalhostCertDerInto(certDer)
    let parseRes: Result[bool] = x509.x509ParseCertificateInto(cert, certDer)
    assert(IsOk(parseRes), "msquic test pki: parse leaf cert rsa parts")
    assert(cert.publicKey.kind == x509.X509KeyRsa, "msquic test pki: leaf key kind rsa")
    outN = BytesSlice(cert.publicKey.rsaN, 0, BytesLen(cert.publicKey.rsaN))
    outE = BytesSlice(cert.publicKey.rsaE, 0, BytesLen(cert.publicKey.rsaE))

fn msquicMakeLocalhostTlsPolicy(): policy.MsQuicTlsPolicy =
    var out: policy.MsQuicTlsPolicy
    out.serverName = "localhost"
    out.allowInsecure = false
    out.certChainCount = 1
    out.certChain0 = msquicLocalhostCertDer()
    out.certPrivateKey = msquicLocalhostKeyPkcs8Der()
    out.certLeafKeyKind = x509.X509KeyRsa
    out.trustRootsCount = 1
    out.trustRoot0 = msquicLocalhostTrustRootDer()
    return out

fn msquicMakeLocalhostTlsPolicyInto(out: var policy.MsQuicTlsPolicy) =
    out.serverName = "localhost"
    out.allowInsecure = false
    out.certChainCount = 1
    msquicLocalhostCertDerInto(out.certChain0)
    msquicLocalhostKeyPkcs8DerInto(out.certPrivateKey)
    out.certLeafKeyKind = x509.X509KeyRsa
    out.trustRootsCount = 1
    msquicLocalhostTrustRootDerInto(out.trustRoot0)

