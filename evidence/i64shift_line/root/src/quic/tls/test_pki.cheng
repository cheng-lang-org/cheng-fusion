fn msquicTestPkiHexValue(c: char): int32 =
    if c >= '0' && c <= '9':
        return int32(c) - int32('0')
    if c >= 'a' && c <= 'f':
        return 10 + int32(c) - int32('a')
    if c >= 'A' && c <= 'F':
        return 10 + int32(c) - int32('A')
    return -1

fn msquicTestPkiHexDecode(text: str): Bytes =
    let textLen: int32 = len(text)
    let pairCount: int32 = textLen / 2
    assert(pairCount * 2 == textLen, "msquic test pki: hex length must be even")
    let out: Bytes = BytesAlloc(pairCount)
    for i in 0..<pairCount:
        let src: int32 = i * 2
        let hi: int32 = msquicTestPkiHexValue(text[src])
        let lo: int32 = msquicTestPkiHexValue(text[src + 1])
        assert(hi >= 0, "msquic test pki: invalid hex hi")
        assert(lo >= 0, "msquic test pki: invalid hex lo")
        BytesSet(out, i, (hi << 4) | lo)
    return out

fn msquicTestPkiHexDecodeInto(out: var Bytes, text: str) =
    let textLen: int32 = len(text)
    let pairCount: int32 = textLen / 2
    assert(pairCount * 2 == textLen, "msquic test pki: hex length must be even")
    out = BytesAlloc(pairCount)
    for i in 0..<pairCount:
        let src: int32 = i * 2
        let hi: int32 = msquicTestPkiHexValue(text[src])
        let lo: int32 = msquicTestPkiHexValue(text[src + 1])
        assert(hi >= 0, "msquic test pki: invalid hex hi")
        assert(lo >= 0, "msquic test pki: invalid hex lo")
        BytesSet(out, i, (hi << 4) | lo)

fn msquicTestPkiFixedHexDecodeInto(out: var Bytes, text: str, pairCount: int32) =
    out = BytesAlloc(pairCount)
    for i in 0..<pairCount:
        let src: int32 = i * 2
        let hiChar: char = text[src]
        let loChar: char = text[src + 1]
        let hi: int32 = msquicTestPkiHexValue(hiChar)
        let lo: int32 = msquicTestPkiHexValue(loChar)
        assert(hi >= 0, "msquic test pki: fixed hex hi")
        assert(lo >= 0, "msquic test pki: fixed hex lo")
        BytesSet(out, i, (hi << 4) | lo)

fn msquicLocalhostAllowInsecure(): bool =
    return false

fn msquicLocalhostLeafKeyKind(): int32 =
    var certDer: Bytes
    var leafCert: x509.X509Certificate = x509.initX509Certificate()
    msquicLocalhostCertDerInto(certDer)
    let leafParseRes: Result[bool] = x509.x509ParseCertificateInto(leafCert, certDer)
    assert(IsOk(leafParseRes), "msquic test pki: parse leaf cert")
    return leafCert.publicKey.kind

fn msquicLocalhostCertDer(): Bytes =
    var out: Bytes
    msquicLocalhostCertDerInto(out)
    return out

fn msquicLocalhostCertDerInto(out: var Bytes) =
    let text: str = msquicLocalhostCertDerHexText()
    msquicTestPkiFixedHexDecodeInto(out, text, msquicLocalhostCertDerPairCount)

