fn msquicMakeLocalhostTransportTlsPolicy(): policy.MsQuicTlsPolicy =
    var out: policy.MsQuicTlsPolicy
    out.serverName = "localhost"
    out.allowInsecure = false
    out.certChainCount = 1
    out.certChain0 = msquicLocalhostTransportCertDerSeed(0)
    out.certPrivateKey = msquicLocalhostTransportKeyPkcs8DerSeed(0)
    out.certLeafKeyKind = msquicLocalhostTransportLeafKeyKind()
    out.trustRootsCount = 1
    out.trustRoot0 = msquicLocalhostTransportTrustRootDerSeed(0)
    return out

fn msquicMakeLocalhostTransportTlsPolicyInto(out: var policy.MsQuicTlsPolicy) =
    out.serverName = "localhost"
    out.allowInsecure = false
    out.certChainCount = 1
    msquicLocalhostTransportCertDerInto(out.certChain0)
    msquicLocalhostTransportKeyPkcs8DerInto(out.certPrivateKey)
    out.certLeafKeyKind = msquicLocalhostTransportLeafKeyKind()
    out.trustRootsCount = 1
    msquicLocalhostTransportTrustRootDerInto(out.trustRoot0)

fn msquicMakePublicTransportTlsPolicy(serverName: str): policy.MsQuicTlsPolicy =
    var out: policy.MsQuicTlsPolicy
    var leafServerName = msquicPublicTransportServerNameDefault()
    if len(serverName) > 0:
        leafServerName = serverName
    out.serverName = leafServerName
    out.allowInsecure = false
    out.certChainCount = 1
    out.certChain0 = msquicPublicTransportCertDer()
    out.certPrivateKey = msquicPublicTransportKeyPkcs8Der()
    out.certLeafKeyKind = msquicPublicTransportLeafKeyKind()
    out.trustRootsCount = 1
    out.trustRoot0 = msquicPublicTransportTrustRootDer()
    return out

fn msquicMakePublicTransportTlsPolicyInto(out: var policy.MsQuicTlsPolicy, serverName: str) =
    out = msquicMakePublicTransportTlsPolicy(serverName)
