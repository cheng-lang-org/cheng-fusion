    msquicLocalhostCertDerPairCount = 475
    msquicLocalhostKeyPkcs8DerPairCount = 364
    msquicLocalhostTransportRootCertDerPairCount = 425
    msquicLocalhostTransportCertDerPairCount = 463
    msquicLocalhostTransportKeyPkcs8DerPairCount = 32
    msquicPublicTransportRootCertDerPairCount = 422
    msquicPublicTransportCertDerPairCount = 562
    msquicPublicTransportKeyPkcs8DerPairCount = 32

