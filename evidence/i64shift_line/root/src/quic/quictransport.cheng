# QUIC transport adapter (delegates to MsQuicTransport).

import std/result
import cheng/quic/multiaddress as qaddr
import cheng/quic/connection as qconn
import cheng/quic/msquictransport_native as msquic
import cheng/quic/native_runtime as qnative

const
    # 后端选择 (W6 注册骨架)。0 = msquic 桥 (现行唯一真实引擎);
    # 1 = 纯 Cheng 后端 (M2-M3 落地于 src/quic/pure/, M4 接线; 骨架期
    # 各分派分支暂路由 msquic, 行为零变化, 接口冻结见 results/purept_w6_audit.md)。
    quicBackendMsquic = 0
    quicBackendPureCheng = 1

type
    QuicTransport =
        msquic: msquic.MsQuicTransport
        backend: int32

fn initQuicTransport(): QuicTransport =
    QuicTransport(msquic: msquic.InitMsQuicTransport(), backend: quicBackendMsquic)

# 注册点: 后端选择从此口进入 (M4 接线处)。缺省 msquic。
fn initQuicTransportWithBackend(backend: int32): QuicTransport =
    var out: QuicTransport = initQuicTransport()
    out.backend = backend
    return out

fn setQuicTransportBackend(t: var QuicTransport, backend: int32) =
    t.backend = backend

fn quicTransportBackend(t: QuicTransport): int32 =
    return t.backend

fn start(t: var QuicTransport, addr: qaddr.MultiAddress) =
    if t.backend == quicBackendPureCheng:
        # W6 stub: M4 替换为纯 Cheng listener 启动。
        msquic.start(t.msquic, addr)
        return
    msquic.start(t.msquic, addr)

fn stop(t: var QuicTransport) =
    if t.backend == quicBackendPureCheng:
        # W6 stub: M4 替换为纯 Cheng listener 停机。
        msquic.Stop(t.msquic)
        return
    msquic.Stop(t.msquic)

fn accept(t: var QuicTransport): Result[qconn.Connection] =
    if t.backend == quicBackendPureCheng:
        # W6 stub: M4 替换为纯 Cheng accept。
        return msquic.accept(t.msquic)
    return msquic.accept(t.msquic)

@borrows
fn handles(t: QuicTransport, addr: qaddr.MultiAddress): bool =
    if ! msquic.handles(t.msquic, addr):
        return false
    return qaddr.quicMultiAddressKind(addr) == qaddr.quicAddrKindQuic

fn dial(t: var QuicTransport, addr: qaddr.MultiAddress): Result[qconn.Connection] =
    if ! handles(t, addr):
        return Err[qconn.Connection]("quictransport: unsupported address")
    if t.backend == quicBackendPureCheng:
        # W6 stub: M4 替换为纯 Cheng dial (含本后端签发的 pipe token)。
        return msquic.dial(t.msquic, addr)
    return msquic.dial(t.msquic, addr)

fn dropQuicPendingByPipe(t: var QuicTransport, addr: qaddr.MultiAddress, pipeIdx: int32): Result[bool] =
    # W6 骨架: stub 期唯一实现 = msquic 按管拆除; M4 在此分派 pureCheng 臂。
    # 展开为等价自由函数形: msquic.dropMsQuicPendingByPipe 的 t 形参实证未用
    # (函数体 `t; addr` 空转), 而托管记录部分投影只绑 @borrows 形参, 无法前送
    # owned 形参——同语义直调其内部自由函数 + 同款 token 门。
    if ! qnative.MsQuicNativeIsPipeIdx(pipeIdx):
        return Ok[bool](false)
    msquic.dropMsQuicConnectionsByPipe(pipeIdx)
    return Ok[bool](true)
