# MsQuic transport full path -> native UDP + QUIC runtime.

import std/result
import std/rawbytes
import std/system
import std/os
import std/strutils as strutil
import cheng/quic/multiaddress as qaddr
import cheng/quic/connection as qconn
import cheng/quic/msquicruntime
import cheng/quic/tls/policy
import cheng/quic/native_runtime

type
    MsQuicTransport =
        running: bool
        listenerId: int32
        settings: msquicruntime.MsQuicSettings
        tlsPolicy: policy.MsQuicTlsPolicy
        listenAddr: qaddr.MultiAddress
        addr: qaddr.MultiAddress
        lastError: str

fn MsQuicSimNetReset() =
    return

fn ResetNativeRuntime() =
    native_runtime.MsQuicNativeResetAll()

fn MsQuicSimNodeForAddrNum(addrNum: int32): int32 =
    addrNum
    return -1

fn InitMsQuicTransport(): MsQuicTransport =
    var out: MsQuicTransport
    InitMsQuicTransportInto(out)
    return out

fn InitMsQuicTransportInto(out: var MsQuicTransport) =
    out.running = false
    out.listenerId = -1
    initMsQuicSettingsInto(out.settings)
    initMsQuicTlsPolicyInto(out.tlsPolicy)
    qaddr.InitMultiAddressEmptyInto(out.listenAddr)
    qaddr.InitMultiAddressEmptyInto(out.addr)
    out.lastError = ""

@borrows
fn msquicTransportSettings(t: MsQuicTransport): msquicruntime.MsQuicSettings =
    # All-scalar field-wise copy: a bare `t.settings` read is a borrow.
    var out: msquicruntime.MsQuicSettings
    out.maxPending = t.settings.maxPending
    out.maxBytesPerKey = t.settings.maxBytesPerKey
    out.handshakeIdleTimeoutMs = t.settings.handshakeIdleTimeoutMs
    out.idleTimeoutMs = t.settings.idleTimeoutMs
    out.mtuDiscoverySearchCompleteTimeoutUs = t.settings.mtuDiscoverySearchCompleteTimeoutUs
    out.tlsClientMaxSendBuffer = t.settings.tlsClientMaxSendBuffer
    out.tlsServerMaxSendBuffer = t.settings.tlsServerMaxSendBuffer
    out.streamRecvWindowDefault = t.settings.streamRecvWindowDefault
    out.streamRecvBufferDefault = t.settings.streamRecvBufferDefault
    out.connFlowControlWindow = t.settings.connFlowControlWindow
    out.maxWorkerQueueDelayUs = t.settings.maxWorkerQueueDelayUs
    out.maxStatelessOperations = t.settings.maxStatelessOperations
    out.initialWindowPackets = t.settings.initialWindowPackets
    out.sendIdleTimeoutMs = t.settings.sendIdleTimeoutMs
    out.initialRttMs = t.settings.initialRttMs
    out.maxAckDelayMs = t.settings.maxAckDelayMs
    out.disconnectTimeoutMs = t.settings.disconnectTimeoutMs
    out.keepAliveIntervalMs = t.settings.keepAliveIntervalMs
    out.maxDatagram = t.settings.maxDatagram
    out.minimumMtu = t.settings.minimumMtu
    out.maximumMtu = t.settings.maximumMtu
    return out

@borrows
fn setMsQuicTransportSettings(t: var MsQuicTransport, settings: msquicruntime.MsQuicSettings): Result[bool] =
    var next: msquicruntime.MsQuicSettings = settings
    let validRes: Result[bool] = validateMsQuicSettings(next)
    if IsErr(validRes):
        return Err[bool](ErrorText(validRes))
    t.settings = next
    return Ok[bool](true)

fn msquicTransportTlsPolicy(t: MsQuicTransport): policy.MsQuicTlsPolicy =
    return t.tlsPolicy

@borrows
fn setMsQuicTransportTlsPolicy(t: var MsQuicTransport, policy: policy.MsQuicTlsPolicy): Result[bool] =
    t.tlsPolicy.serverName = policy.serverName
    t.tlsPolicy.allowInsecure = policy.allowInsecure
    t.tlsPolicy.requireClientCertificate = policy.requireClientCertificate
    t.tlsPolicy.sendClientCertificate = policy.sendClientCertificate
    t.tlsPolicy.revocationMode = policy.revocationMode
    t.tlsPolicy.crlCount = policy.crlCount
    t.tlsPolicy.crl0 = policy.crl0
    t.tlsPolicy.crl1 = policy.crl1
    t.tlsPolicy.crl2 = policy.crl2
    t.tlsPolicy.crl3 = policy.crl3
    t.tlsPolicy.certChainCount = policy.certChainCount
    t.tlsPolicy.certChain0 = policy.certChain0
    t.tlsPolicy.certChain1 = policy.certChain1
    t.tlsPolicy.certChain2 = policy.certChain2
    t.tlsPolicy.certChain3 = policy.certChain3
    t.tlsPolicy.certPrivateKey = policy.certPrivateKey
    t.tlsPolicy.certLeafKeyKind = policy.certLeafKeyKind
    t.tlsPolicy.trustRootsCount = policy.trustRootsCount
    t.tlsPolicy.trustRoot0 = policy.trustRoot0
    t.tlsPolicy.trustRoot1 = policy.trustRoot1
    t.tlsPolicy.trustRoot2 = policy.trustRoot2
    t.tlsPolicy.trustRoot3 = policy.trustRoot3
    t.tlsPolicy.alpnCount = policy.alpnCount
    t.tlsPolicy.alpn0 = policy.alpn0
    t.tlsPolicy.alpn1 = policy.alpn1
    return Ok[bool](true)

fn setMsQuicTransportTlsPolicyRef(t: var MsQuicTransport, source: var policy.MsQuicTlsPolicy): Result[bool] =
    t.tlsPolicy.serverName = source.serverName
    t.tlsPolicy.allowInsecure = source.allowInsecure
    t.tlsPolicy.requireClientCertificate = source.requireClientCertificate
    t.tlsPolicy.sendClientCertificate = source.sendClientCertificate
    t.tlsPolicy.revocationMode = source.revocationMode
    t.tlsPolicy.crlCount = source.crlCount
    t.tlsPolicy.crl0 = source.crl0
    t.tlsPolicy.crl1 = source.crl1
    t.tlsPolicy.crl2 = source.crl2
    t.tlsPolicy.crl3 = source.crl3
    t.tlsPolicy.certChainCount = source.certChainCount
    t.tlsPolicy.certChain0 = source.certChain0
    t.tlsPolicy.certChain1 = source.certChain1
    t.tlsPolicy.certChain2 = source.certChain2
    t.tlsPolicy.certChain3 = source.certChain3
    t.tlsPolicy.certPrivateKey = source.certPrivateKey
    t.tlsPolicy.certLeafKeyKind = source.certLeafKeyKind
    t.tlsPolicy.trustRootsCount = source.trustRootsCount
    t.tlsPolicy.trustRoot0 = source.trustRoot0
    t.tlsPolicy.trustRoot1 = source.trustRoot1
    t.tlsPolicy.trustRoot2 = source.trustRoot2
    t.tlsPolicy.trustRoot3 = source.trustRoot3
    t.tlsPolicy.alpnCount = source.alpnCount
    t.tlsPolicy.alpn0 = source.alpn0
    t.tlsPolicy.alpn1 = source.alpn1
    return Ok[bool](true)

@borrows
fn handles(t: MsQuicTransport, addr: qaddr.MultiAddress): bool =
    if qaddr.quicMultiAddressKind(addr) < 1:
        return false
    if qaddr.quicMultiAddressKind(addr) > 3:
        return false
    return true

fn start(t: var MsQuicTransport, addr: qaddr.MultiAddress) =
    StartWithSettingsPolicy(t, addr, t.settings, t.tlsPolicy)

@borrows
fn StartWithSettingsPolicy(t: var MsQuicTransport,
                           addr: qaddr.MultiAddress,
                           settings: msquicruntime.MsQuicSettings,
                           tlsPolicy: policy.MsQuicTlsPolicy) =
    t.running = false
    t.listenerId = -1
    var addrForListen: qaddr.MultiAddress
    native_runtime.MsQuicNativeCopyAddrInto(addrForListen, addr)
    t.listenAddr = addrForListen
    var addrForField: qaddr.MultiAddress
    native_runtime.MsQuicNativeCopyAddrInto(addrForField, addr)
    t.addr = addrForField
    t.lastError = ""
    let settingsRes: Result[bool] = setMsQuicTransportSettings(t, settings)
    if IsErr(settingsRes):
        t.lastError = ErrorText(settingsRes)
        return
    let tlsRes: Result[bool] = setMsQuicTransportTlsPolicy(t, tlsPolicy)
    if IsErr(tlsRes):
        t.lastError = ErrorText(tlsRes)
        return
    var addrForStart: qaddr.MultiAddress
    native_runtime.MsQuicNativeCopyAddrInto(addrForStart, addr)
    let startRes: Result[int32] = MsQuicNativeStartListener(addrForStart, settings, tlsPolicy)
    if IsErr(startRes):
        t.lastError = ErrorText(startRes)
        return
    t.listenerId = Value(startRes)
    MsQuicNativeListenerBoundAddrInto(t.listenAddr)
    t.addr = t.listenAddr
    t.running = true

fn StartWithDefaultSettingsPolicy(t: var MsQuicTransport,
                                  addr: qaddr.MultiAddress,
                                  tlsPolicy: policy.MsQuicTlsPolicy) =
    var settings: msquicruntime.MsQuicSettings
    initMsQuicSettingsInto(settings)
    if settings.allow0Rtt:
        t.running = false
        t.listenerId = -1
        t.lastError = "msquic: 0-rtt disabled"
        return
    StartWithSettingsPolicy(t, addr, settings, tlsPolicy)

fn startWithDefaultSettingsPolicy(t: var MsQuicTransport,
                                  addr: qaddr.MultiAddress,
                                  tlsPolicy: policy.MsQuicTlsPolicy): Result[bool] =
    t.running = false
    t.listenerId = -1
    t.listenAddr = addr
    t.addr = addr
    t.lastError = ""
    initMsQuicSettingsInto(t.settings)
    if t.settings.allow0Rtt:
        t.lastError = "msquic: 0-rtt disabled"
        return Err[bool](t.lastError)
    let tlsRes: Result[bool] = setMsQuicTransportTlsPolicy(t, tlsPolicy)
    if IsErr(tlsRes):
        t.lastError = ErrorText(tlsRes)
        return Err[bool](t.lastError)
    let startRes: Result[int32] = MsQuicNativeStartListenerDefault(addr, tlsPolicy)
    if IsErr(startRes):
        t.lastError = ErrorText(startRes)
        return Err[bool](t.lastError)
    t.listenerId = Value(startRes)
    MsQuicNativeListenerBoundAddrInto(t.listenAddr)
    t.addr = t.listenAddr
    t.running = true
    return Ok[bool](true)

fn startWithDefaultSettingsPolicyRef(t: var MsQuicTransport,
                                     addr: qaddr.MultiAddress,
                                     tlsPolicy: var policy.MsQuicTlsPolicy): Result[bool] =
    t.running = false
    t.listenerId = -1
    var addrForListen: qaddr.MultiAddress
    native_runtime.MsQuicNativeCopyAddrInto(addrForListen, addr)
    t.listenAddr = addrForListen
    var addrForField: qaddr.MultiAddress
    native_runtime.MsQuicNativeCopyAddrInto(addrForField, addr)
    t.addr = addrForField
    t.lastError = ""
    initMsQuicSettingsInto(t.settings)
    if t.settings.allow0Rtt:
        t.lastError = "msquic: 0-rtt disabled"
        return Err[bool](t.lastError)
    let tlsRes: Result[bool] = setMsQuicTransportTlsPolicyRef(t, tlsPolicy)
    if IsErr(tlsRes):
        t.lastError = ErrorText(tlsRes)
        return Err[bool](t.lastError)
    var addrForStart: qaddr.MultiAddress
    native_runtime.MsQuicNativeCopyAddrInto(addrForStart, addr)
    let startRes: Result[int32] = MsQuicNativeStartListenerDefaultRef(addrForStart, t.tlsPolicy)
    if IsErr(startRes):
        t.lastError = ErrorText(startRes)
        return Err[bool](t.lastError)
    t.listenerId = Value(startRes)
    MsQuicNativeListenerBoundAddrInto(t.listenAddr)
    t.addr = t.listenAddr
    t.running = true
    return Ok[bool](true)

fn Stop(t: var MsQuicTransport) =
    if t.running:
        MsQuicNativeStopListener()
    t.running = false
    t.listenerId = -1
    t.lastError = ""

fn accept(t: var MsQuicTransport): Result[qconn.Connection] =
    if ! t.running:
        t.lastError = "msquic: ! running"
        return Err[qconn.Connection]("msquic: ! running")
    t.lastError = ""
    let acceptRes: Result[int32] = MsQuicNativeAccept()
    if IsErr(acceptRes):
        t.lastError = ErrorText(acceptRes)
        return Err[qconn.Connection](ErrorText(acceptRes))
    var localAddr: qaddr.MultiAddress
    MsQuicNativeListenerBoundAddrInto(localAddr)
    var remoteAddr: qaddr.MultiAddress
    MsQuicNativePeerDialAddrInto(remoteAddr)
    # server 半环: 显式路由 Server 角色槽取 pipe（角色分槽 retag）。
    let serverPipeIdx: int32 = native_runtime.msquicNativeRetagPipeIdxForServerSession()
    let pairRes: Result[qconn.ConnectionPair] = qconn.newNativeConnectionPairForSlot(serverPipeIdx, localAddr, remoteAddr, localAddr, remoteAddr, 0, 1, 1, 0)
    if IsErr(pairRes):
        t.lastError = ErrorText(pairRes)
        return Err[qconn.Connection](ErrorText(pairRes))
    return Ok[qconn.Connection](qconn.ConnDup(Value(pairRes).inbound))

fn AcceptTimed(t: var MsQuicTransport, waitMs: int32): Result[qconn.Connection] =
    if ! t.running:
        t.lastError = "msquic: ! running"
        return Err[qconn.Connection]("msquic: ! running")
    t.lastError = ""
    let acceptRes: Result[int32] = MsQuicNativeAcceptTimed(waitMs)
    if IsErr(acceptRes):
        t.lastError = ErrorText(acceptRes)
        return Err[qconn.Connection](ErrorText(acceptRes))
    if Value(acceptRes) <= 0:
        os.WriteLine(os.Get_stderr(), strutil.Join(["msquic transport debug: accept timed code=", IntToStr(Value(acceptRes))], ""))
        t.lastError = "msquic: accept timeout"
        return Err[qconn.Connection](t.lastError)
    var localAddr: qaddr.MultiAddress
    MsQuicNativeListenerBoundAddrInto(localAddr)
    var remoteAddr: qaddr.MultiAddress
    MsQuicNativePeerDialAddrInto(remoteAddr)
    # server 半环: 显式路由 Server 角色槽取 pipe（角色分槽 retag）。
    let timedServerPipeIdx: int32 = native_runtime.msquicNativeRetagPipeIdxForServerSession()
    let pairRes: Result[qconn.ConnectionPair] = qconn.newNativeConnectionPairForSlot(timedServerPipeIdx, localAddr, remoteAddr, localAddr, remoteAddr, 0, 1, 1, 0)
    if IsErr(pairRes):
        t.lastError = ErrorText(pairRes)
        return Err[qconn.Connection](ErrorText(pairRes))
    return Ok[qconn.Connection](qconn.ConnDup(Value(pairRes).inbound))

fn AcceptGlobalTimed(waitMs: int32): Result[qconn.Connection] =
    var safeWait: int32 = waitMs
    if safeWait < 0:
        safeWait = 0
    let acceptRes: Result[int32] = MsQuicNativeAcceptTimed(safeWait)
    if IsErr(acceptRes):
        return Err[qconn.Connection](ErrorText(acceptRes))
    if Value(acceptRes) <= 0:
        return Err[qconn.Connection]("msquic: accept timeout")
    var localAddr: qaddr.MultiAddress
    MsQuicNativeListenerBoundAddrInto(localAddr)
    var remoteAddr: qaddr.MultiAddress
    MsQuicNativePeerDialAddrInto(remoteAddr)
    # server 半环: 显式路由 Server 角色槽取 pipe（角色分槽 retag）。
    let globalServerPipeIdx: int32 = native_runtime.msquicNativeRetagPipeIdxForServerSession()
    let pairRes: Result[qconn.ConnectionPair] = qconn.newNativeConnectionPairForSlot(globalServerPipeIdx, localAddr, remoteAddr, localAddr, remoteAddr, 0, 1, 1, 0)
    if IsErr(pairRes):
        return Err[qconn.Connection](ErrorText(pairRes))
    return Ok[qconn.Connection](qconn.ConnDup(Value(pairRes).inbound))

fn acceptGlobalTimed(waitMs: int32): Result[qconn.Connection] =
    return AcceptGlobalTimed(waitMs)

fn dial(t: var MsQuicTransport, addr: qaddr.MultiAddress): Result[qconn.Connection] =
    if ! handles(t, addr):
        t.lastError = "msquic: unsupported address"
        return Err[qconn.Connection]("msquic: unsupported address")
    t.lastError = ""
    # addr is reused by newNativeConnectionPair below; hand NativeDial a copy.
    var addrForDial: qaddr.MultiAddress
    native_runtime.MsQuicNativeCopyAddrInto(addrForDial, addr)
    let dialRes: Result[int32] = MsQuicNativeDial(t.settings, t.tlsPolicy, addrForDial)
    if IsErr(dialRes):
        t.lastError = ErrorText(dialRes)
        return Err[qconn.Connection](ErrorText(dialRes))
    var clientAddr: qaddr.MultiAddress
    MsQuicNativeClientBoundAddrInto(clientAddr)
    # client 半环: 显式路由 Client 角色槽取 pipe（角色分槽 retag）。
    let clientPipeIdx: int32 = native_runtime.msquicNativeRetagPipeIdxForClientSession()
    let pairRes: Result[qconn.ConnectionPair] = qconn.newNativeConnectionPairForSlot(clientPipeIdx, clientAddr, addr, addr, clientAddr, 0, 1, 1, 0)
    if IsErr(pairRes):
        t.lastError = ErrorText(pairRes)
        return Err[qconn.Connection](ErrorText(pairRes))
    return Ok[qconn.Connection](qconn.ConnDup(Value(pairRes).outbound))

fn MsQuicTransportDial(t: var MsQuicTransport, addr: qaddr.MultiAddress): Result[qconn.Connection] =
    return dial(t, addr)

@borrows
fn msquicTransportWrite(t: var MsQuicTransport, conn: var qconn.Connection, data: rawbytes.Bytes): Result[int32] =
    t.lastError = ""
    let writeRes: Result[int32] = qconn.quicConnWrite(conn, data)
    if IsErr(writeRes):
        t.lastError = ErrorText(writeRes)
    return writeRes

fn msquicTransportRead(t: var MsQuicTransport, conn: var qconn.Connection, count: int32): Result[rawbytes.Bytes] =
    t.lastError = ""
    let readRes: Result[rawbytes.Bytes] = qconn.quicConnRead(conn, count)
    if IsErr(readRes):
        t.lastError = ErrorText(readRes)
    return readRes

fn msquicTransportReadNonblocking(t: var MsQuicTransport, conn: var qconn.Connection, count: int32): Result[rawbytes.Bytes] =
    t.lastError = ""
    let readRes: Result[rawbytes.Bytes] = qconn.quicConnReadNonblocking(conn, count)
    if IsErr(readRes):
        t.lastError = ErrorText(readRes)
    return readRes

fn dropMsQuicPendingByPipe(t: MsQuicTransport, addr: qaddr.MultiAddress, pipeIdx: int32): Result[bool] =
    t
    addr
    if ! MsQuicNativeIsPipeIdx(pipeIdx):
        return Ok[bool](false)
    dropMsQuicConnectionsByPipe(pipeIdx)
    return Ok[bool](true)

fn dropMsQuicConnectionsByPipe(pipeIdx: int32) =
    if ! MsQuicNativeIsPipeIdx(pipeIdx):
        return
    MsQuicNativePipeClose(pipeIdx)

@borrows
fn msquicTransportDatagramWrite(t: var MsQuicTransport, conn: var qconn.Connection, data: rawbytes.Bytes): Result[int32] =
    t.lastError = ""
    if ! t.settings.allowDatagram:
        t.lastError = "msquic: datagram disabled"
        return Err[int32](t.lastError)
    if t.settings.maxDatagram > 0 && BytesLen(data) > t.settings.maxDatagram:
        t.lastError = "msquic: datagram too large"
        return Err[int32](t.lastError)
    if ! conn.open:
        t.lastError = "msquic: connection closed"
        return Err[int32](t.lastError)
    let writeRes: Result[int32] = MsQuicNativeDatagramWrite(conn.pipeIdx, conn.pipeSide, data)
    if IsErr(writeRes):
        t.lastError = ErrorText(writeRes)
    return writeRes

@borrows
fn msquicTransportDatagramRead(t: var MsQuicTransport, conn: var qconn.Connection): Result[rawbytes.Bytes] =
    t.lastError = ""
    if ! conn.open:
        t.lastError = "msquic: connection closed"
        return Err[rawbytes.Bytes](t.lastError)
    let readRes: Result[rawbytes.Bytes] = MsQuicNativeDatagramRead(conn.pipeIdx, conn.pipeSide)
    if IsErr(readRes):
        t.lastError = ErrorText(readRes)
    return readRes
