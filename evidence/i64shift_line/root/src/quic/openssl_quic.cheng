# OpenSSL QUIC adapter (delegates to MsQuicTransport).

import std/result
import cheng/quic/multiaddress as qaddr
import cheng/quic/connection as qconn
import cheng/quic/msquictransport_native as msquic

type
    OpenSslQuicTransport =
        msquic: msquic.MsQuicTransport

fn initOpenSslQuicTransport(): OpenSslQuicTransport =
    OpenSslQuicTransport(msquic: msquic.InitMsQuicTransport())

fn start(t: var OpenSslQuicTransport, addr: qaddr.MultiAddress) =
    msquic.start(t.msquic, addr)

fn stop(t: var OpenSslQuicTransport) =
    msquic.Stop(t.msquic)

fn accept(t: var OpenSslQuicTransport): Result[qconn.Connection] =
    return msquic.accept(t.msquic)

fn handles(t: OpenSslQuicTransport, addr: qaddr.MultiAddress): bool =
    if ! msquic.handles(t.msquic, addr):
        return false
    return qaddr.quicMultiAddressKind(addr) == qaddr.quicAddrKindQuicTls

fn dial(t: var OpenSslQuicTransport, addr: qaddr.MultiAddress): Result[qconn.Connection] =
    if ! handles(t, addr):
        return Err[qconn.Connection]("openssl quic: unsupported address")
    return msquic.dial(t.msquic, addr)

fn dropOpenSslQuicPendingByPipe(t: OpenSslQuicTransport, addr: qaddr.MultiAddress, pipeIdx: int32): Result[bool] =
    return msquic.dropMsQuicPendingByPipe(t.msquic, addr, pipeIdx)
