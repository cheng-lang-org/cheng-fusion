# TLS 1.3 key schedule (RFC 8446 section 7.1) on pure Cheng primitives.
#
# W2 first slice (i1) of the pure-Cheng transport campaign. Judged against
# RFC 8448 section 3 official vectors (see src/tests/purept_w2i1_*.cheng).
# Primitives are imported, never modified: std/crypto/hkdf, std/crypto/sha256.
#
# Scope: HKDF-Expand-Label / Derive-Secret, early/handshake/master secret
# chain, application/expansion/resumption secrets, traffic key+iv, finished
# key and finished verify_data. Single suite: TLS_AES_128_GCM_SHA256.

import std/result
import std/rawbytes
import std/crypto/hkdf
import std/crypto/sha256

const
    tls13HashLen: int32 = 32
    tls13Aes128KeyLen: int32 = 16
    tls13AesGcmIvLen: int32 = 12
    tls13LabelPrefix: str = "tls13 "

type
    Tls13TrafficKeys =
        key: Bytes
        iv: Bytes

fn tls13TrafficKeyOf(k: Tls13TrafficKeys): Bytes =
    let n: int32 = BytesLen(k.key)
    let out: Bytes = BytesAlloc(n)
    if n > 0:
        BytesCopyInto(out, 0, k.key)
    return out

fn tls13TrafficIvOf(k: Tls13TrafficKeys): Bytes =
    let n: int32 = BytesLen(k.iv)
    let out: Bytes = BytesAlloc(n)
    if n > 0:
        BytesCopyInto(out, 0, k.iv)
    return out

fn tls13OwnedCopy(src: Bytes): Bytes =
    let n: int32 = BytesLen(src)
    let out: Bytes = BytesAlloc(n)
    if n <= 0:
        return out
    BytesCopyInto(out, 0, src)
    return out

fn tls13Zero32(): Bytes =
    return BytesAlloc(tls13HashLen)

# HKDF-Extract with TLS 1.3 argument order (salt first).
fn tls13Extract(salt: Bytes, ikm: Bytes): Bytes =
    return hkdfExtractSha256(ikm, salt)

# HkdfLabel wire form (RFC 8446 section 7.1):
#   struct { uint16 length; opaque label<7..255>; opaque context<0..255>; }
# with label = "tls13 " + Label.
fn tls13HkdfLabel(length: int32, label: str, context: Bytes): Bytes =
    let labelLen: int32 = len(label)
    let contextLen: int32 = BytesLen(context)
    let out: Bytes = BytesAlloc(2 + 1 + labelLen + 1 + contextLen)
    let hi: int32 = length / 256
    let lo: int32 = length - hi * 256
    BytesSet(out, 0, hi)
    BytesSet(out, 1, lo)
    BytesSet(out, 2, labelLen)
    var i: int32
    while i < labelLen:
        BytesSet(out, 3 + i, int32(label[i]))
        i = i + 1
    BytesSet(out, 3 + labelLen, contextLen)
    if contextLen > 0:
        BytesCopyInto(out, 4 + labelLen, context)
    return out

fn tls13ExpandLabel(secret: Bytes, label: str, context: Bytes, length: int32): Result[Bytes] =
    let info: Bytes = tls13HkdfLabel(length, tls13LabelPrefix + label, context)
    return hkdfExpandSha256(secret, info, length)

# Derive-Secret over an already computed transcript hash.
fn tls13DeriveSecretHash(prk: Bytes, label: str, transcriptHash: Bytes): Result[Bytes] =
    return tls13ExpandLabel(prk, label, transcriptHash, tls13HashLen)

# Derive-Secret(Secret, Label, Hash(messages)).
fn tls13DeriveSecret(prk: Bytes, label: str, messages: Bytes): Result[Bytes] =
    let th: Bytes = Sha256Digest(messages)
    return tls13DeriveSecretHash(prk, label, th)

# Secret chain. psk is all-zero for a plain (non-PSK) 1-RTT handshake.
fn tls13EarlySecret(psk: Bytes): Bytes =
    let zero: Bytes = tls13Zero32()
    return tls13Extract(zero, psk)

# Derive-Secret(secret, "derived", Transcript-Hash("")) — the salt hop.
fn tls13DerivedSalt(secret: Bytes): Bytes =
    let r: Result[Bytes] = tls13DeriveSecret(secret, "derived", EmptyBytes())
    if IsErr(r):
        return tls13Zero32()
    return Value(r)

fn tls13HandshakeSecret(earlySecret: Bytes, sharedSecret: Bytes): Bytes =
    let salt: Bytes = tls13DerivedSalt(earlySecret)
    return tls13Extract(salt, sharedSecret)

fn tls13MasterSecret(handshakeSecret: Bytes): Bytes =
    let salt: Bytes = tls13DerivedSalt(handshakeSecret)
    let zero: Bytes = tls13Zero32()
    return tls13Extract(salt, zero)

fn tls13TrafficKeysFor(secret: Bytes): Result[Tls13TrafficKeys] =
    var out: Tls13TrafficKeys
    let keyRes: Result[Bytes] = tls13ExpandLabel(secret, "key", EmptyBytes(), tls13Aes128KeyLen)
    if IsErr(keyRes):
        return Err[Tls13TrafficKeys](ErrorText(keyRes))
    out.key = Value(keyRes)
    let ivRes: Result[Bytes] = tls13ExpandLabel(secret, "iv", EmptyBytes(), tls13AesGcmIvLen)
    if IsErr(ivRes):
        return Err[Tls13TrafficKeys](ErrorText(ivRes))
    out.iv = Value(ivRes)
    return Ok[Tls13TrafficKeys](out)

# finished_key = HKDF-Expand-Label(base_key, "finished", "", Hash.length)
fn tls13FinishedKey(baseSecret: Bytes): Result[Bytes] =
    return tls13ExpandLabel(baseSecret, "finished", EmptyBytes(), tls13HashLen)

# finished verify_data = HMAC(finished_key, Transcript-Hash(...)). The caller
# picks the transcript window (through CertificateVerify for the sender's own
# Finished, through the peer Finished for verification).
fn tls13FinishedVerifyData(finishedKey: Bytes, transcriptHash: Bytes): Bytes =
    return hmacDigestSha256(finishedKey, transcriptHash)

# Resumption secret: HKDF-Expand-Label(res_master, "resumption", nonce, 32).
# RFC 8448 section 3 exercises it with the 2-byte zero nonce context.
fn tls13ResumptionSecret(resMasterSecret: Bytes, nonce: Bytes): Result[Bytes] =
    return tls13ExpandLabel(resMasterSecret, "resumption", nonce, tls13HashLen)
