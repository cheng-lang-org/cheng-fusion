# QUIC variable-length integer (RFC 9000, Section 16).
#
# The two most significant bits of the first octet are the base-2 logarithm
# of the encoded length: 00=1B(0..63), 01=2B(0..16383), 10=4B(0..2^30-1),
# 11=8B(0..2^62-1). Value bits follow in network byte order. Senders use the
# minimal encoding except for the Frame Type field, where minimal encoding is
# mandatory (Section 12.4); receivers MUST accept non-minimal encodings for
# every other field.

import std/rawbytes

const
    QuicVarintMax: int64 = 0x3fffffffffffffff

# Logical (not arithmetic) right shift for int64. Cheng `>>` propagates the
# sign bit; the top-mask trick keeps the result unsigned. Values that appear
# in QUIC varints never reach bit 63, but the helper is exact for any input.
fn QuicLshr64(x: int64, n: int32): int64 =
    if n <= 0:
        return x
    let topMask: int64 = (int64(1) << 63) ^ (0 - 1)
    return ((x >> 1) & topMask) >> (n - 1)

# Encoded length for value: 1, 2, 4 or 8. -1 when the value cannot be a QUIC
# varint (negative or >= 2^62).
fn QuicVarintSize(value: int64): int32 =
    if value < 0:
        return -1
    if value <= 63:
        return 1
    if value <= 16383:
        return 2
    if value <= 1073741823:
        return 4
    if value <= QuicVarintMax:
        return 8
    return -1

# Append the minimal encoding of value to b. Returns the number of bytes
# appended, or -1 when value is out of range.
fn QuicVarintAppend(b: var BytesBuilder, value: int64): int32 =
    let n: int32 = QuicVarintSize(value)
    if n < 0:
        return -1
    if n == 1:
        BytesBuilderAppendByte(b, int32(value & 0x3f))
        return 1
    if n == 2:
        BytesBuilderAppendByte(b, int32(0x40 | (QuicLshr64(value, 8) & 0x3f)))
        BytesBuilderAppendByte(b, int32(value & 0xff))
        return 2
    if n == 4:
        BytesBuilderAppendByte(b, int32(0x80 | (QuicLshr64(value, 24) & 0x3f)))
        BytesBuilderAppendByte(b, int32(QuicLshr64(value, 16) & 0xff))
        BytesBuilderAppendByte(b, int32(QuicLshr64(value, 8) & 0xff))
        BytesBuilderAppendByte(b, int32(value & 0xff))
        return 4
    BytesBuilderAppendByte(b, int32(0xc0 | (QuicLshr64(value, 56) & 0x3f)))
    BytesBuilderAppendByte(b, int32(QuicLshr64(value, 48) & 0xff))
    BytesBuilderAppendByte(b, int32(QuicLshr64(value, 40) & 0xff))
    BytesBuilderAppendByte(b, int32(QuicLshr64(value, 32) & 0xff))
    BytesBuilderAppendByte(b, int32(QuicLshr64(value, 24) & 0xff))
    BytesBuilderAppendByte(b, int32(QuicLshr64(value, 16) & 0xff))
    BytesBuilderAppendByte(b, int32(QuicLshr64(value, 8) & 0xff))
    BytesBuilderAppendByte(b, int32(value & 0xff))
    return 8

# Append value in an explicit encoding size (non-minimal encodings are legal
# for every field except Frame Type). Returns bytes appended, -1 on out-of-
# range value, -2 on an illegal size (not 1/2/4/8), -3 when the value does
# not fit the requested size.
fn QuicVarintAppendSized(b: var BytesBuilder, value: int64, size: int32): int32 =
    if size != 1 && size != 2 && size != 4 && size != 8:
        return -2
    let minimal: int32 = QuicVarintSize(value)
    if minimal < 0:
        return -1
    if minimal > size:
        return -3
    if size == minimal:
        return QuicVarintAppend(b, value)
    let bodyMask: int64 = (int64(1) << (size * 8 - 2)) ^ (0 - 1)
    let body: int64 = value & bodyMask
    if size == 2:
        BytesBuilderAppendByte(b, int32(0x40 | (QuicLshr64(body, 8) & 0x3f)))
        BytesBuilderAppendByte(b, int32(body & 0xff))
        return 2
    if size == 4:
        BytesBuilderAppendByte(b, int32(0x80 | (QuicLshr64(body, 24) & 0x3f)))
        BytesBuilderAppendByte(b, int32(QuicLshr64(body, 16) & 0xff))
        BytesBuilderAppendByte(b, int32(QuicLshr64(body, 8) & 0xff))
        BytesBuilderAppendByte(b, int32(body & 0xff))
        return 4
    BytesBuilderAppendByte(b, int32(0xc0 | (QuicLshr64(body, 56) & 0x3f)))
    BytesBuilderAppendByte(b, int32(QuicLshr64(body, 48) & 0xff))
    BytesBuilderAppendByte(b, int32(QuicLshr64(body, 40) & 0xff))
    BytesBuilderAppendByte(b, int32(QuicLshr64(body, 32) & 0xff))
    BytesBuilderAppendByte(b, int32(QuicLshr64(body, 24) & 0xff))
    BytesBuilderAppendByte(b, int32(QuicLshr64(body, 16) & 0xff))
    BytesBuilderAppendByte(b, int32(QuicLshr64(body, 8) & 0xff))
    BytesBuilderAppendByte(b, int32(body & 0xff))
    return 8

type
    QuicVarintRead =
        ok: bool
        value: int64
        size: int32

# Read a varint at offset. The two MSBs of the first byte decide the length;
# a buffer too short for that length is truncated (ok=false). Non-minimal
# encodings decode to their value (Section 16 allows them on the wire).
fn QuicVarintReadAt(b: Bytes, offset: int32): QuicVarintRead =
    var out: QuicVarintRead
    out.ok = false
    out.value = 0
    out.size = 0
    if offset < 0 || offset >= b.len:
        return out
    let first: int32 = BytesGet(b, offset)
    let n: int32 = 1 << (int32(first) >> 6)
    if offset + n > b.len:
        return out
    var v: int64 = int64(first & 0x3f)
    var i: int32 = 1
    while i < n:
        v = (v << 8) | int64(BytesGet(b, offset + i) & 255)
        i = i + 1
    out.ok = true
    out.value = v
    out.size = n
    return out

# Read a Frame Type varint: the one field where non-minimal encodings are a
# FRAME_ENCODING_ERROR (Section 12.4 via Section 16). ok=false covers both
# truncation and non-minimal form; callers distinguish via size (0=trunc).
fn QuicVarintReadMinimalAt(b: Bytes, offset: int32): QuicVarintRead =
    var r: QuicVarintRead = QuicVarintReadAt(b, offset)
    if !r.ok:
        return r
    if QuicVarintSize(r.value) != r.size:
        r.ok = false
        r.size = 0 - r.size
    return r
