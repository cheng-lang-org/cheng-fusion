# TLS 1.3 transcript (RFC 8446 section 7.1): replay buffer of handshake
# messages plus Hash(message buffer). W2 first slice (i1).
#
# Two slots (0 = client-side chain, 1 = server-side chain) cover the 1-RTT
# handshake. Slot state is a set of separate module-level globals and every
# operation comes in slot-suffixed variants (tls13TranscriptAppend0/1, ...):
# this compiler generation rejects managed stores through array elements and
# var-parameters, and dispatchers whose arms both mutate memory fail the
# body-store-freeze contract, so no `which` parameter is used.
#
# The buffer grows by doubling; transcript_hash is always the SHA-256 of the
# used window, recomputed from the replay buffer (messages stay small in the
# 1-RTT handshake, and re-hashing the buffer is the definition in RFC 8446).

import std/rawbytes
import std/crypto/sha256

var
    tls13Tr0Data: Bytes
    tls13Tr0Used: int32
    tls13Tr0Cap: int32
    tls13Tr1Data: Bytes
    tls13Tr1Used: int32
    tls13Tr1Cap: int32

fn tls13TrGrowCap(oldCap: int32, need: int32): int32 =
    var newCap: int32 = oldCap * 2
    if newCap < 128:
        newCap = 128
    if newCap < need:
        newCap = need
    return newCap

fn tls13TranscriptBegin0() =
    tls13Tr0Data = EmptyBytes()
    tls13Tr0Used = 0
    tls13Tr0Cap = 0

fn tls13TranscriptBegin1() =
    tls13Tr1Data = EmptyBytes()
    tls13Tr1Used = 0
    tls13Tr1Cap = 0

fn tls13TranscriptAppend0(message: Bytes) =
    let n: int32 = BytesLen(message)
    if n <= 0:
        return
    if tls13Tr0Cap < tls13Tr0Used + n:
        let next: Bytes = BytesAlloc(tls13TrGrowCap(tls13Tr0Cap, tls13Tr0Used + n))
        var i: int32
        while i < tls13Tr0Used:
            BytesSet(next, i, BytesGet(tls13Tr0Data, i))
            i = i + 1
        tls13Tr0Data = next
        tls13Tr0Cap = tls13TrGrowCap(tls13Tr0Cap, tls13Tr0Used + n)
    BytesCopyInto(tls13Tr0Data, tls13Tr0Used, message)
    tls13Tr0Used = tls13Tr0Used + n

fn tls13TranscriptAppend1(message: Bytes) =
    let n: int32 = BytesLen(message)
    if n <= 0:
        return
    if tls13Tr1Cap < tls13Tr1Used + n:
        let next: Bytes = BytesAlloc(tls13TrGrowCap(tls13Tr1Cap, tls13Tr1Used + n))
        var i: int32
        while i < tls13Tr1Used:
            BytesSet(next, i, BytesGet(tls13Tr1Data, i))
            i = i + 1
        tls13Tr1Data = next
        tls13Tr1Cap = tls13TrGrowCap(tls13Tr1Cap, tls13Tr1Used + n)
    BytesCopyInto(tls13Tr1Data, tls13Tr1Used, message)
    tls13Tr1Used = tls13Tr1Used + n

fn tls13TranscriptReset0() =
    tls13Tr0Used = 0

fn tls13TranscriptReset1() =
    tls13Tr1Used = 0

# Full replay buffer (owned copy of the used window).
fn tls13TranscriptBytes0(): Bytes =
    if tls13Tr0Used <= 0:
        return EmptyBytes()
    return BytesSlice(tls13Tr0Data, 0, tls13Tr0Used)

fn tls13TranscriptBytes1(): Bytes =
    if tls13Tr1Used <= 0:
        return EmptyBytes()
    return BytesSlice(tls13Tr1Data, 0, tls13Tr1Used)

# Transcript-Hash(messages) = Hash(replay buffer).
fn tls13TranscriptHash0(): Bytes =
    if tls13Tr0Used <= 0:
        let empty0: Bytes = EmptyBytes()
        return Sha256Digest(empty0)
    let window0: Bytes = BytesSlice(tls13Tr0Data, 0, tls13Tr0Used)
    return Sha256Digest(window0)

fn tls13TranscriptHash1(): Bytes =
    if tls13Tr1Used <= 0:
        let empty1: Bytes = EmptyBytes()
        return Sha256Digest(empty1)
    let window1: Bytes = BytesSlice(tls13Tr1Data, 0, tls13Tr1Used)
    return Sha256Digest(window1)
