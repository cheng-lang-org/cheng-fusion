# QUIC packet protection key derivation (RFC 9001, Section 5).
#
# Covers, for every packet number space (Initial / Handshake / 0-RTT / 1-RTT):
#   - the TLS 1.3 HKDF-Expand-Label construction (RFC 8446, Section 7.1) with
#     its exact HkdfLabel wire form: uint16 length | 0x07+len "tls13 "+label |
#     empty context (RFC 9001 Appendix A.1 publishes the five wire forms);
#   - the Initial secrets (RFC 9001, Section 5.2): HKDF-Extract over the
#     QUIC v1 salt with the client's first Destination Connection ID as IKM,
#     then "client in" / "server in" expansion to 32-byte secrets;
#   - "quic key" / "quic iv" / "quic hp" derivation (Section 5.1) into the
#     QuicPacketKeys record consumed by the packet_protect module.
#
# The hash for all derivations here is SHA-256; the AEAD for the AES suite is
# AES-128-GCM (key 16, iv 12, hp 16). A 32-byte key (ChaCha20-Poly1305 or
# AES-256-GCM spaces, RFC 9001 Appendix A.5 shape) flows through the same
# expansion with keyLen=32.

import std/result as result
import std/rawbytes
import std/crypto/hkdf as qhkdf
import cheng/quic/pure/frames_varint as quicvarint

const
    # RFC 9001, Section 5.2: QUIC v1 Initial salt.
    QuicInitialSaltHex: str = "38762cf7f55934b34d179ae6a4c80cadccbb7f0a"
    # "tls13 " prefix is part of every label; constants below are the
    # concatenated ("tls13 " + Label) byte strings in hex.
    QuicLabelClientInHex: str = "746c73313320636c69656e7420696e"
    QuicLabelServerInHex: str = "746c7331332073657276657220696e"
    QuicLabelQuicKeyHex: str = "746c7331332071756963206b6579"
    QuicLabelQuicIvHex: str = "746c7331332071756963206976"
    QuicLabelQuicHpHex: str = "746c7331332071756963206870"
    QuicAeadKeyLen: int32 = 16
    QuicAeadIvLen: int32 = 12
    QuicHpKeyLen: int32 = 16
    QuicSecretLen: int32 = 32

# Derived packet protection key set for one packet number space.
type QuicPacketKeys =
    key: Bytes    # AEAD key (16 for AES-128-GCM; 32 for the A.5-shaped suites)
    iv: Bytes     # 12-byte AEAD IV; per-packet nonce = iv xor (64-bit pn)
    hp: Bytes     # header protection key

# The Initial secret triple derived from one Destination Connection ID.
type QuicInitialSecrets =
    initialSecret: Bytes
    clientSecret: Bytes
    serverSecret: Bytes

# Append the RFC 8446 Section 7.1 HkdfLabel wire form for (label, outLen)
# with an empty context. Exposed separately so the Appendix A.1 published
# wire forms are directly assertable.
@borrows
fn QuicHkdfLabelAppend(b: var BytesBuilder, label: Bytes, outLen: int32): int32 =
    if label.len <= 0 || label.len > 255:
        return -4
    if outLen < 1 || outLen > 255:
        return -4
    BytesBuilderAppendByte(b, (outLen >> 8) & 255)
    BytesBuilderAppendByte(b, outLen & 255)
    BytesBuilderAppendByte(b, label.len)
    BytesBuilderAppend(b, label)
    BytesBuilderAppendByte(b, 0)
    return BytesBuilderLen(b)

# HKDF-Expand-Label (RFC 8446 Section 7.1) over SHA-256.
@borrows
fn QuicHkdfExpandLabel(secret: Bytes, label: Bytes, outLen: int32): Result[Bytes] =
    var b: BytesBuilder = BytesBuilderNew(label.len + 4)
    if QuicHkdfLabelAppend(b, label, outLen) < 0:
        return Err[Bytes]("quic keys: bad label or length")
    let info: Bytes = BytesBuilderFinish(b)
    let res: Result[Bytes] = qhkdf.hkdfExpandSha256(secret, info, outLen)
    return res

# "quic key" / "quic iv" / "quic hp" expansion (RFC 9001, Section 5.1).
@borrows
fn QuicKeysFromSecret(secret: Bytes, keyLen: int32, ivLen: int32, hpLen: int32): Result[QuicPacketKeys] =
    var out: QuicPacketKeys
    var keyRes: Result[Bytes] = QuicHkdfExpandLabel(secret, BytesFromHex(QuicLabelQuicKeyHex), keyLen)
    if result.IsErr(keyRes):
        return Err[QuicPacketKeys](result.ErrorText(keyRes))
    var ivRes: Result[Bytes] = QuicHkdfExpandLabel(secret, BytesFromHex(QuicLabelQuicIvHex), ivLen)
    if result.IsErr(ivRes):
        return Err[QuicPacketKeys](result.ErrorText(ivRes))
    var hpRes: Result[Bytes] = QuicHkdfExpandLabel(secret, BytesFromHex(QuicLabelQuicHpHex), hpLen)
    if result.IsErr(hpRes):
        return Err[QuicPacketKeys](result.ErrorText(hpRes))
    out.key = BytesTake(keyRes.value)
    out.iv = BytesTake(ivRes.value)
    out.hp = BytesTake(hpRes.value)
    return Ok[QuicPacketKeys](out)

# Initial secrets for one connection (RFC 9001, Section 5.2): both directional
# secrets come from the Destination Connection ID of the client's first
# Initial packet (post-Retry: the server-chosen DCID).
@borrows
fn QuicInitialSecretsForCid(cid: Bytes): Result[QuicInitialSecrets] =
    var out: QuicInitialSecrets
    let salt: Bytes = BytesFromHex(QuicInitialSaltHex)
    let prk: Bytes = qhkdf.hkdfExtractSha256(cid, salt)
    var cRes: Result[Bytes] = QuicHkdfExpandLabel(prk, BytesFromHex(QuicLabelClientInHex), QuicSecretLen)
    if result.IsErr(cRes):
        return Err[QuicInitialSecrets](result.ErrorText(cRes))
    var sRes: Result[Bytes] = QuicHkdfExpandLabel(prk, BytesFromHex(QuicLabelServerInHex), QuicSecretLen)
    if result.IsErr(sRes):
        return Err[QuicInitialSecrets](result.ErrorText(sRes))
    out.initialSecret = prk
    out.clientSecret = BytesTake(cRes.value)
    out.serverSecret = BytesTake(sRes.value)
    return Ok[QuicInitialSecrets](out)

# AES-128-GCM Initial key set for one side of one connection.
@borrows
fn QuicInitialKeys(cid: Bytes, isServer: bool): Result[QuicPacketKeys] =
    var secRes: Result[QuicInitialSecrets] = QuicInitialSecretsForCid(cid)
    if result.IsErr(secRes):
        return Err[QuicPacketKeys](result.ErrorText(secRes))
    if isServer:
        return QuicKeysFromSecret(secRes.value.serverSecret, QuicAeadKeyLen, QuicAeadIvLen, QuicHpKeyLen)
    return QuicKeysFromSecret(secRes.value.clientSecret, QuicAeadKeyLen, QuicAeadIvLen, QuicHpKeyLen)

# Per-packet AEAD nonce (RFC 9001, Section 5.3): the 12-byte IV with the
# 64-bit big-endian packet number XORed into its last 8 bytes.
@borrows
fn QuicPacketNonce(iv: Bytes, pn: int64): Bytes =
    let out: Bytes = BytesAlloc(12)
    var i: int32
    while i < 12:
        BytesSet(out, i, BytesGet(iv, i))
        i = i + 1
    var shift: int32 = 56
    var j: int32 = 4
    while j < 12:
        let maskByte: int64 = quicvarint.QuicLshr64(pn, shift) & 255
        BytesSet(out, j, BytesGet(out, j) ^ int32(maskByte))
        shift = shift - 8
        j = j + 1
    return out
