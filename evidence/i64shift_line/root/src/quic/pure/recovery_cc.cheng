# W4 recovery: NewReno congestion control, RFC 9002 Section 7.3.1 with the
# Appendix A control law (pure logic layer; ECN is out of this slice's
# boundary — no ECN-CE reaction, no BBR/cubic).
#
# - Slow start: cwnd < ssthresh -> cwnd += acked bytes.
# - Congestion avoidance: cwnd += max_datagram_size^2 / cwnd per ack round
#   (integer floored, Appendix A form).
# - Loss (non-persistent): ssthresh = max(min_cwnd, cwnd/2); cwnd = ssthresh.
# - Persistent congestion: cwnd = min_cwnd (Section 7.6).
#
# cwnd only ever decreases inside QuicCcOnPacketsLost — the driver's
# monotonicity invariant keys on exactly that. Transition ids match the
# recovery_loss numbering (10 persistent, 11 slow start, 12 congestion
# avoidance, 13 loss reduction) in this module's own trans table.

import cheng/quic/pure/recovery_loss as recoveryloss

const
    QuicCcMaxDatagramSize: int64 = 1200
    QuicCcInitialCwnd: int64 = 12000
    QuicCcMinimumCwnd: int64 = 2400
    QuicCcInitialSsthresh: int64 = 1099511627776
    QuicCcDgSquared: int64 = 1440000

type
    QuicCc =
        cwnd: int64
        ssthresh: int64
        lossEvents: int64
        persistentEvents: int64
        skippedReductions: int64
        lastReduceTime: int64
        ackedBytesSlowStart: int64
        ackedBytesCa: int64
        trans: int64[32]

fn QuicCcInit(cc: var QuicCc) =
    cc.cwnd = QuicCcInitialCwnd
    cc.ssthresh = QuicCcInitialSsthresh
    cc.lossEvents = 0
    cc.persistentEvents = 0
    cc.skippedReductions = 0
    cc.lastReduceTime = 0
    cc.ackedBytesSlowStart = 0
    cc.ackedBytesCa = 0
    var i: int32
    while i < 32:
        cc.trans[i] = 0
        i = i + 1

fn QuicCcCount(cc: var QuicCc, id: int32) =
    cc.trans[id] = cc.trans[id] + 1

# Per-acked-bytes window growth (Appendix A OnPacketAckedCC). The mss^2/cwnd
# congestion-avoidance increment is applied PER ACKED PACKET, so a batched
# ACK frame carrying N packets yields N increments (Section 7.3.1
# semantics); slow start stays byte-based.
fn QuicCcOnAckedBytes(cc: var QuicCc, size: int64) =
    if size <= 0:
        return
    if cc.cwnd < cc.ssthresh:
        cc.cwnd = cc.cwnd + size
        cc.ackedBytesSlowStart = cc.ackedBytesSlowStart + size
        QuicCcCount(cc, 11)
        return
    var pkts: int64 = (size + QuicCcMaxDatagramSize - 1) / QuicCcMaxDatagramSize
    cc.cwnd = cc.cwnd + pkts * (QuicCcDgSquared / cc.cwnd)
    cc.ackedBytesCa = cc.ackedBytesCa + size
    QuicCcCount(cc, 12)

# Per-loss-round window reduction (Appendix A OnPacketsLostCC + the Section
# 7.3.2 once-per-RTT reduction throttle). The driver calls this at most once
# per detection round with inPersistent from the loss state's round output
# and rttUs = the current smoothed RTT. Within one RTT of the previous
# reduction only persistent congestion still resets the window.
fn QuicCcOnPacketsLost(cc: var QuicCc, inPersistent: bool, nowUs: int64,
                       rttUs: int64) =
    if inPersistent:
        cc.persistentEvents = cc.persistentEvents + 1
        cc.cwnd = QuicCcMinimumCwnd
        QuicCcCount(cc, 10)
        return
    if cc.lastReduceTime != 0 && nowUs - cc.lastReduceTime < rttUs:
        cc.skippedReductions = cc.skippedReductions + 1
        return
    cc.lossEvents = cc.lossEvents + 1
    cc.lastReduceTime = nowUs
    var half: int64 = cc.cwnd / 2
    if half < QuicCcMinimumCwnd:
        half = QuicCcMinimumCwnd
    cc.ssthresh = half
    cc.cwnd = half
    QuicCcCount(cc, 13)
