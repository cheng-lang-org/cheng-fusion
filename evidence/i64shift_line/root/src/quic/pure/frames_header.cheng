# QUIC packet header forms (RFC 9000, Section 17) at the unprotected (plaintext)
# layer: Version Negotiation (17.2.1), long headers incl. Initial with token
# length and Length field (17.2/17.2.2), and 1-RTT short header parsing (17.3).
#
# Packet numbers: header protection is NOT removed here (that is the packet
# protection module's job, W3b). The low two bits of byte 0 are treated as
# plaintext Packet Number Length bits; for a short header they are protected
# values, so the parser records the raw byte and leaves removal to W3b via
# QuicHeader.byte0. Packet number truncation/encoding (17.1, Appendix A.2/A.3)
# is provided here because it is plaintext-layer logic.
#
# Decode error codes (negative return):
#   -1 truncated            -2 fixed bit clear (not a QUIC v1 packet)
#   -3 version-specific violation (reserved bits set where v1 requires 0)
#   -4 field out of range (CID length > 20, PN length illegal)
#   -5 structurally invalid (VN version list empty/not 4-byte aligned)
#   -6 Retry packet: type-specific integrity tag belongs to the packet
#      protection module, not parsed here.

import std/rawbytes
import cheng/quic/pure/frames_varint as quicvarint

const
    QuicVersion1: int64 = 0x00000001
    QuicVersionNegotiation: int64 = 0x00000000
    QuicPktTypeInitial: int32 = 0
    QuicPktTypeZeroRtt: int32 = 1
    QuicPktTypeHandshake: int32 = 2
    QuicPktTypeRetry: int32 = 3
    QuicCidMaxLen: int32 = 20
    QuicRetryIntegrityLen: int32 = 16

type
    QuicHeader =
        isLong: bool
        ptype: int32           # long: 0 Initial, 1 0-RTT, 2 Handshake, 3 Retry; short: -1
        byte0: int32           # raw first octet (short header: protected bits inside)
        version: int64         # long headers, unsigned 32-bit value; 0 for VN
        isVn: bool             # long header with version 0x00000000
        dcidOff: int32
        dcidLen: int32
        scidOff: int32         # long headers only; short headers carry no SCID
        scidLen: int32
        tokenOff: int32        # Initial token view; -1 elsewhere
        tokenLen: int32
        length: int64          # Length field of Initial/Handshake/0-RTT; -1 if none
        pnLen: int32           # 1..4 (short header: raw protected bits + 1)
        pnOff: int32           # offset of the packet number field
        payloadOff: int32      # first byte after the packet number field
        versionsOff: int32     # VN supported-version list view; -1 elsewhere
        versionsCount: int32   # VN: number of 32-bit versions; 0 elsewhere
        hdrEnd: int32          # offset just past the parsed header

fn QuicHeaderZero(): QuicHeader =
    var out: QuicHeader
    out.isLong = false
    out.ptype = -1
    out.byte0 = 0
    out.version = 0
    out.isVn = false
    out.dcidOff = -1
    out.dcidLen = 0
    out.scidOff = -1
    out.scidLen = 0
    out.tokenOff = -1
    out.tokenLen = 0
    out.length = 0 - 1
    out.pnLen = 0
    out.pnOff = -1
    out.payloadOff = -1
    out.versionsOff = -1
    out.versionsCount = 0
    out.hdrEnd = -1
    return out

fn quicReadU32(b: Bytes, pos: int32): int64 =
    # Caller guarantees 4 bytes are present. Kept in int64 so the unsigned
    # 32-bit value never overflows a signed int32.
    let v0: int64 = int64(BytesGet(b, pos) & 255)
    let v1: int64 = int64(BytesGet(b, pos + 1) & 255)
    let v2: int64 = int64(BytesGet(b, pos + 2) & 255)
    let v3: int64 = int64(BytesGet(b, pos + 3) & 255)
    return (v0 << 24) | (v1 << 16) | (v2 << 8) | v3

fn quicAppendU32(b: var BytesBuilder, v: int64) =
    BytesBuilderAppendByte(b, (quicvarint.QuicLshr64(v, 24) & 255))
    BytesBuilderAppendByte(b, (quicvarint.QuicLshr64(v, 16) & 255))
    BytesBuilderAppendByte(b, (quicvarint.QuicLshr64(v, 8) & 255))
    BytesBuilderAppendByte(b, (v & 255))

# Parse any packet header. Long headers and Version Negotiation are decoded
# fully; a short header (form bit 0) is dispatched to QuicShortHeaderParse
# which needs the DCID length (only known from transport parameters), so here
# it fails with -7 and the caller re-invokes with the length.
@borrows
fn QuicHeaderParse(buf: Bytes, h: var QuicHeader): int32 =
    var cand: QuicHeader = QuicHeaderZero()
    if buf.len < 1:
        return -1
    let byte0: int32 = BytesGet(buf, 0) & 255
    cand.byte0 = byte0
    if (byte0 & 0x80) == 0:
        return -7
    # ---- long header form ----
    cand.isLong = true
    if (byte0 & 0x40) == 0:
        return -2
    if buf.len < 5:
        return -1
    let version: int32 = quicReadU32(buf, 1)
    cand.version = version
    if version == QuicVersionNegotiation:
        cand.isVn = true
        cand.ptype = -1
        var p: int32 = 5
        if p >= buf.len: return -1
        let dcil: int32 = BytesGet(buf, p) & 255
        p = p + 1
        if dcil > buf.len - p: return -1
        cand.dcidOff = p
        cand.dcidLen = dcil
        p = p + dcil
        if p >= buf.len: return -1
        let scil: int32 = BytesGet(buf, p) & 255
        p = p + 1
        if scil > buf.len - p: return -1
        cand.scidOff = p
        cand.scidLen = scil
        p = p + scil
        let rest: int32 = buf.len - p
        if rest < 4 || (rest % 4) != 0:
            return -5
        cand.versionsOff = p
        cand.versionsCount = rest / 4
        cand.hdrEnd = buf.len
        h = cand
        return buf.len
    let ptype: int32 = (byte0 >> 4) & 0x03
    cand.ptype = ptype
    let pnLen: int32 = (byte0 & 0x03) + 1
    cand.pnLen = pnLen
    var p: int32 = 5
    if p >= buf.len: return -1
    let dcil: int32 = BytesGet(buf, p) & 255
    p = p + 1
    if dcil > QuicCidMaxLen:
        return -4
    if dcil > buf.len - p: return -1
    cand.dcidOff = p
    cand.dcidLen = dcil
    p = p + dcil
    if p >= buf.len: return -1
    let scil: int32 = BytesGet(buf, p) & 255
    p = p + 1
    if scil > QuicCidMaxLen:
        return -4
    if scil > buf.len - p: return -1
    cand.scidOff = p
    cand.scidLen = scil
    p = p + scil
    if ptype == QuicPktTypeRetry:
        # Retry token + 16-byte integrity tag: verified by packet protection.
        let rest: int32 = buf.len - p
        if rest < QuicRetryIntegrityLen:
            return -1
        cand.tokenOff = p
        cand.tokenLen = rest - QuicRetryIntegrityLen
        cand.hdrEnd = buf.len
        h = cand
        return -6
    if ptype == QuicPktTypeInitial:
        let tl: quicvarint.QuicVarintRead = quicvarint.QuicVarintReadAt(buf, p)
        if !tl.ok: return -1
        if tl.value > int64(buf.len - p - tl.size):
            return -1
        cand.tokenLen = int32(tl.value)
        p = p + tl.size
        cand.tokenOff = p
        p = p + cand.tokenLen
    let ln: quicvarint.QuicVarintRead = quicvarint.QuicVarintReadAt(buf, p)
    if !ln.ok: return -1
    cand.length = ln.value
    p = p + ln.size
    # Length covers PN + payload + auth tag from this point on. Whether the
    # buffer actually carries that many bytes is packet completeness, not
    # header structure: the RFC 9001 A.2/A.3 sample headers are published
    # without their payloads. Use QuicHeaderParsePacket for the datagram
    # walker contract.
    if ln.value < int64(pnLen):
        return -5
    cand.pnOff = p
    cand.payloadOff = p + pnLen
    cand.hdrEnd = p
    h = cand
    return p

# Packet-level parse: header plus the completeness contract that the buffer
# carries the full Length field. Returns the number of bytes this packet
# occupies (hdrEnd + Length), so a coalesced UDP datagram walker can slice
# packet after packet; -1 when the datagram ends mid-packet.
@borrows
fn QuicHeaderParsePacket(buf: Bytes, h: var QuicHeader): int32 =
    let r: int32 = QuicHeaderParse(buf, h)
    if r < 0:
        return r
    let total: int64 = int64(h.hdrEnd) + h.length
    if total > int64(buf.len):
        return -1
    return int32(total)

# Fixed-width read of the packet number field at h.pnOff (pnLen bytes,
# big-endian). At this layer the bytes are still header-protection masked;
# the packet protection module re-invokes this after removing protection.
@borrows
fn QuicHeaderPnRead(buf: Bytes, h: QuicHeader): int64 =
    var v: int64
    var i: int32
    while i < h.pnLen:
        v = (v << 8) | int64(BytesGet(buf, h.pnOff + i) & 255)
        i = i + 1
    return v

# Fixed-width 32-bit read (Version field, VN supported-version list).
@borrows
fn QuicHeaderVersionAt(buf: Bytes, off: int32): int64 =
    return quicReadU32(buf, off)

# Parse a 1-RTT short header. dcidLen is the negotiated destination connection
# ID length (0..20). Protection bits (reserved, key phase, PN length bits) are
# NOT decrypted here: byte0 keeps the raw protected octet and pnLen the raw
# bits' plaintext interpretation; packet protection removes header protection
# and then re-reads these fields (interface left to the W3b module).
@borrows
fn QuicShortHeaderParse(buf: Bytes, dcidLen: int32, h: var QuicHeader): int32 =
    var cand: QuicHeader = QuicHeaderZero()
    if buf.len < 1:
        return -1
    let byte0: int32 = BytesGet(buf, 0) & 255
    cand.byte0 = byte0
    if (byte0 & 0x80) != 0:
        return -8
    if (byte0 & 0x40) == 0:
        return -2
    if dcidLen < 0 || dcidLen > QuicCidMaxLen:
        return -4
    let pnLen: int32 = (byte0 & 0x03) + 1
    cand.pnLen = pnLen
    if buf.len < 1 + dcidLen + pnLen:
        return -1
    cand.ptype = -1
    cand.dcidOff = 1
    cand.dcidLen = dcidLen
    cand.pnOff = 1 + dcidLen
    cand.payloadOff = cand.pnOff + pnLen
    cand.hdrEnd = cand.pnOff
    h = cand
    return cand.pnOff

# ---- packet number encoding (Section 17.1, Appendix A.2/A.3) ----

# Bits needed to represent v (> 0): floor(log2(v)) + 1.
fn quicBitLen64(v: int64): int32 =
    var n: int32
    var x: int64 = v
    if x <= 0:
        return 0
    while x > 0:
        x = quicvarint.QuicLshr64(x, 1)
        n = n + 1
    return n

# Encoding size in bytes for a full packet number given the largest acked in
# the same packet number space. hasAcked=false means nothing was acked yet;
# the full packet number must then be included (Section 17.1).
fn QuicPnEncodeSize(fullPn: int64, largestAcked: int64, hasAcked: bool): int32 =
    var numUnacked: int64
    if !hasAcked:
        numUnacked = fullPn + 1
    else:
        if largestAcked > fullPn:
            return -4
        numUnacked = fullPn - largestAcked
    if numUnacked < 1:
        numUnacked = 1
    let minBits: int32 = quicBitLen64(numUnacked) + 1
    var numBytes: int32 = (minBits + 7) / 8
    if numBytes < 1:
        numBytes = 1
    if numBytes > 4:
        numBytes = 4
    return numBytes

# Full-width minimal size (used before any ACK in a packet number space).
fn QuicPnFullSize(fullPn: int64): int32 =
    let bits: int32 = quicBitLen64(fullPn + 1)
    var n: int32 = (bits + 7) / 8
    if n < 1:
        n = 1
    if n > 4:
        n = 4
    return n

# Append the pnLen low bytes of the packet number, big-endian.
fn QuicPnAppend(b: var BytesBuilder, fullPn: int64, pnLen: int32): int32 =
    if pnLen < 1 || pnLen > 4:
        return -4
    var shift: int32 = (pnLen - 1) * 8
    var i: int32
    while i < pnLen:
        BytesBuilderAppendByte(b, (quicvarint.QuicLshr64(fullPn, shift) & 255))
        shift = shift - 8
        i = i + 1
    return pnLen

# Recover the full packet number (Appendix A.3), after header protection is
# removed by the packet protection module.
fn QuicPnDecode(largestPn: int64, truncatedPn: int64, pnBits: int32): int64 =
    let expectedPn: int64 = largestPn + 1
    let pnWin: int64 = int64(1) << pnBits
    let pnHwin: int64 = pnWin / 2
    let pnMask: int64 = pnWin - 1
    let notMask: int64 = (int64(1) << 63) ^ (0 - 1) ^ pnMask
    let candidate: int64 = (expectedPn & notMask) | truncatedPn
    if candidate <= expectedPn - pnHwin && candidate < (int64(1) << 62) - pnWin:
        return candidate + pnWin
    if candidate > expectedPn + pnHwin && candidate >= pnWin:
        return candidate - pnWin
    return candidate

# ---- header encode ----

# Append a Version Negotiation packet: 0xc0 byte (header form + fixed bit),
# version 0, DCID, SCID, then the 4-byte-per-entry supported version list.
# versions must be a non-empty multiple of 4 bytes.
@borrows
fn QuicVnAppend(b: var BytesBuilder, dcid: Bytes, scid: Bytes, versions: Bytes): int32 =
    if versions.len < 4 || (versions.len % 4) != 0:
        return -5
    if dcid.len > 255 || scid.len > 255:
        return -4
    BytesBuilderAppendByte(b, 0xc0)
    quicAppendU32(b, QuicVersionNegotiation)
    BytesBuilderAppendByte(b, dcid.len)
    BytesBuilderAppend(b, dcid)
    BytesBuilderAppendByte(b, scid.len)
    BytesBuilderAppend(b, scid)
    BytesBuilderAppend(b, versions)
    return BytesBuilderLen(b)

# Append an Initial packet header through the Token field: type 0, reserved
# bits 0, PN length bits from pnLen, version, DCID, SCID, token. The Length
# field, packet number and payload are appended by the caller (they cover the
# AEAD tag, so they belong with payload assembly).
@borrows
fn QuicInitialHeaderAppend(b: var BytesBuilder, version: int64, dcid: Bytes,
                           scid: Bytes, token: Bytes, pnLen: int32): int32 =
    if pnLen < 1 || pnLen > 4:
        return -4
    if dcid.len > QuicCidMaxLen || scid.len > QuicCidMaxLen:
        return -4
    BytesBuilderAppendByte(b, 0xc0 | (pnLen - 1))
    quicAppendU32(b, version)
    BytesBuilderAppendByte(b, dcid.len)
    BytesBuilderAppend(b, dcid)
    BytesBuilderAppendByte(b, scid.len)
    BytesBuilderAppend(b, scid)
    if quicvarint.QuicVarintAppend(b, int64(token.len)) < 0:
        return -1
    BytesBuilderAppend(b, token)
    return BytesBuilderLen(b)

# Append the Length field + truncated packet number. payloadLen counts
# frames + auth tag (everything after the packet number).
fn QuicInitialLengthPnAppend(b: var BytesBuilder, payloadLen: int32, fullPn: int64, pnLen: int32): int32 =
    if quicvarint.QuicVarintAppend(b, int64(payloadLen) + int64(pnLen)) < 0:
        return -1
    return QuicPnAppend(b, fullPn, pnLen)
