# TLS 1.3 server handshake state machine (RFC 8446 section 4.1) — W2 slice i2.
#
# Mirror of tls13_state_client: Configure -> Feed(ClientHello) produces the
# whole server flight (ServerHello || EncryptedExtensions || Certificate ||
# CertificateVerify || ServerFinished, concatenated); Feed(ClientFinished)
# verifies it and completes. One call, one state transition, produced bytes
# via the produced accessor. The caller (QUIC CRYPTO pump in W3b) owns the
# byte stream and splits the flight by handshake headers.
#
# The server signs its CertificateVerify with ed25519 (RFC 8032 semantics,
# epoch-1 entry) over the RFC 8446 final content order
# (context || 0x00 || 64 spaces || Transcript-Hash(CH..Cert)).
# The end-entity certificate defaults to a minimal well-formed self certificate
# embedding the signing public key (free-PKI model of this campaign); a full
# DER can be supplied instead.
#
# Machine state lives in module globals; accessors return scalars / owned
# views. Transcript: this machine owns slot 1 of tls13_transcript.
#
# Known boundaries (documented, not hidden): no HelloRetryRequest, no 0-RTT,
# no client certificate requests, session id echo fixed to the empty session
# id (the codec layer does not expose the received echo bytes).

import std/result
import std/rawbytes
import std/strings
import std/buffer as bytebuffer
import std/crypto/curve25519 as x25519
import std/crypto/minasn1 as asn1
import cheng/libp2p/crypto/ed25519/ed25519 as edsig
import cheng/quic/pure/tls13_keyschedule as ks
import cheng/quic/pure/tls13_transcript as tr
import cheng/quic/pure/tls13_messages as msg

const
    tls13SrvStateIdle: int32 = 0
    tls13SrvStateExpectCfin: int32 = 1
    tls13SrvStateComplete: int32 = 2

    tls13SrvErrBadState: int32 = 1
    tls13SrvErrDecode: int32 = 2
    tls13SrvErrNoSuite: int32 = 3
    tls13SrvErrChKeyShare: int32 = 4
    tls13SrvErrChVersion: int32 = 5
    tls13SrvErrDerive: int32 = 6
    tls13SrvErrCfinMismatch: int32 = 7
    tls13SrvErrSign: int32 = 8
    tls13SrvErrDead: int32 = 9

    tls13SrvKindClientHello: int32 = 1
    tls13SrvKindCertificate: int32 = 11
    tls13SrvKindCertificateVerify: int32 = 15
    tls13SrvKindFinished: int32 = 20
    tls13SrvSuiteAes128GcmSha256: int32 = 4865
    tls13SrvGroupX25519: int32 = 29
    tls13SrvSigEd25519: int32 = 2055
    tls13SrvVersion: int32 = 772

var
    tls13SrvState: int32 = tls13SrvStateIdle
    tls13SrvErr: int32 = 0
    tls13SrvErrText: str = ""

    tls13SrvPriv: Bytes
    tls13SrvPub: Bytes
    tls13SrvRandom: Bytes
    tls13SrvSigPriv: Bytes
    tls13SrvSigPub: Bytes
    tls13SrvCertDer: Bytes
    tls13SrvEeGroups: int32 = 1

    tls13SrvShared: Bytes
    tls13SrvHsSecret: Bytes
    tls13SrvChsTraffic: Bytes
    tls13SrvShsTraffic: Bytes
    tls13SrvFinKey: Bytes
    tls13SrvCliFinKey: Bytes
    tls13SrvFinVd: Bytes
    tls13SrvMaster: Bytes
    tls13SrvCap: Bytes
    tls13SrvSap: Bytes
    tls13SrvExp: Bytes
    tls13SrvCapKey: Bytes
    tls13SrvCapIv: Bytes
    tls13SrvSapKey: Bytes
    tls13SrvSapIv: Bytes
    tls13SrvResMaster: Bytes

    tls13SrvProduced: Bytes

# ---------- accessors ----------

fn tls13SrvStateOf(): int32 = tls13SrvState
fn tls13SrvErrCodeOf(): int32 = tls13SrvErr
fn tls13SrvErrTextOf(): str = strings.CloneStr(tls13SrvErrText)

fn tls13SrvProducedOf(): Bytes =
    return BytesSlice(tls13SrvProduced, 0, BytesLen(tls13SrvProduced))
fn tls13SrvSharedOf(): Bytes =
    return BytesSlice(tls13SrvShared, 0, BytesLen(tls13SrvShared))
fn tls13SrvHsSecretOf(): Bytes =
    return BytesSlice(tls13SrvHsSecret, 0, BytesLen(tls13SrvHsSecret))
fn tls13SrvChsTrafficOf(): Bytes =
    return BytesSlice(tls13SrvChsTraffic, 0, BytesLen(tls13SrvChsTraffic))
fn tls13SrvShsTrafficOf(): Bytes =
    return BytesSlice(tls13SrvShsTraffic, 0, BytesLen(tls13SrvShsTraffic))
fn tls13SrvFinKeyOf(): Bytes =
    return BytesSlice(tls13SrvFinKey, 0, BytesLen(tls13SrvFinKey))
fn tls13SrvCliFinKeyOf(): Bytes =
    return BytesSlice(tls13SrvCliFinKey, 0, BytesLen(tls13SrvCliFinKey))
fn tls13SrvFinVdOf(): Bytes =
    return BytesSlice(tls13SrvFinVd, 0, BytesLen(tls13SrvFinVd))
fn tls13SrvCapOf(): Bytes =
    return BytesSlice(tls13SrvCap, 0, BytesLen(tls13SrvCap))
fn tls13SrvSapOf(): Bytes =
    return BytesSlice(tls13SrvSap, 0, BytesLen(tls13SrvSap))
fn tls13SrvExpMasterOf(): Bytes =
    return BytesSlice(tls13SrvExp, 0, BytesLen(tls13SrvExp))
fn tls13SrvCapKeyOf(): Bytes =
    return BytesSlice(tls13SrvCapKey, 0, BytesLen(tls13SrvCapKey))
fn tls13SrvCapIvOf(): Bytes =
    return BytesSlice(tls13SrvCapIv, 0, BytesLen(tls13SrvCapIv))
fn tls13SrvSapKeyOf(): Bytes =
    return BytesSlice(tls13SrvSapKey, 0, BytesLen(tls13SrvSapKey))
fn tls13SrvSapIvOf(): Bytes =
    return BytesSlice(tls13SrvSapIv, 0, BytesLen(tls13SrvSapIv))
fn tls13SrvResMasterOf(): Bytes =
    return BytesSlice(tls13SrvResMaster, 0, BytesLen(tls13SrvResMaster))
fn tls13SrvSigPubOf(): Bytes =
    return BytesSlice(tls13SrvSigPub, 0, BytesLen(tls13SrvSigPub))

# ---------- small builders ----------

fn tls13SrvPutU16(b: var bytebuffer.GrowByteBuffer, v: int32) =
    bytebuffer.AppendByte(b, v / 256)
    bytebuffer.AppendByte(b, v - (v / 256) * 256)

fn tls13SrvPutU24(b: var bytebuffer.GrowByteBuffer, v: int32) =
    bytebuffer.AppendByte(b, v / 65536)
    bytebuffer.AppendByte(b, (v / 256) - (v / 65536) * 256)
    bytebuffer.AppendByte(b, v - (v / 256) * 256)

fn tls13SrvOwned(b: var bytebuffer.GrowByteBuffer): Bytes =
    let view: Bytes = bytebuffer.ToBytes(b)
    let n: int32 = BytesLen(view)
    let out: Bytes = BytesAlloc(n)
    if n > 0:
        BytesCopyInto(out, 0, view)
    return out

# ServerHello wire form, RFC 8448 vector shape (u8 session-id length vector,
# empty here). Built here rather than through the i1 builder so encoder and
# decoder agree on every field length.
@borrows
fn tls13SrvBuildServerHello(random: Bytes, keyShare: Bytes): Bytes =
    var vl: bytebuffer.GrowByteBuffer = bytebuffer.NewByteBuffer()
    tls13SrvPutU16(vl, tls13SrvVersion)
    let vlData: Bytes = tls13SrvOwned(vl)
    var kl: bytebuffer.GrowByteBuffer = bytebuffer.NewByteBuffer()
    tls13SrvPutU16(kl, tls13SrvGroupX25519)
    tls13SrvPutU16(kl, BytesLen(keyShare))
    bytebuffer.AppendBytes(kl, keyShare)
    let klData: Bytes = tls13SrvOwned(kl)
    var ext: bytebuffer.GrowByteBuffer = bytebuffer.NewByteBuffer()
    tls13SrvPutU16(ext, 43)
    tls13SrvPutU16(ext, BytesLen(vlData))
    bytebuffer.AppendBytes(ext, vlData)
    tls13SrvPutU16(ext, 51)
    tls13SrvPutU16(ext, BytesLen(klData))
    bytebuffer.AppendBytes(ext, klData)
    let extData: Bytes = tls13SrvOwned(ext)
    var body: bytebuffer.GrowByteBuffer = bytebuffer.NewByteBuffer()
    tls13SrvPutU16(body, 771)
    bytebuffer.AppendBytes(body, random)
    bytebuffer.AppendByte(body, 0)
    tls13SrvPutU16(body, tls13SrvSuiteAes128GcmSha256)
    bytebuffer.AppendByte(body, 0)
    tls13SrvPutU16(body, BytesLen(extData))
    bytebuffer.AppendBytes(body, extData)
    let bodyData: Bytes = tls13SrvOwned(body)
    return msg.tls13HandshakeFrame(2, bodyData)

# Certificate handshake message carrying one DER entry (empty extensions).
fn tls13SrvCertMessage(): Bytes =
    var list: bytebuffer.GrowByteBuffer = bytebuffer.NewByteBuffer()
    let derView: Bytes = BytesSlice(tls13SrvCertDer, 0, BytesLen(tls13SrvCertDer))
    tls13SrvPutU24(list, BytesLen(derView))
    bytebuffer.AppendBytes(list, derView)
    tls13SrvPutU16(list, 0)
    let listOwned: Bytes = tls13SrvOwned(list)
    var b: bytebuffer.GrowByteBuffer = bytebuffer.NewByteBuffer()
    bytebuffer.AppendByte(b, 0)
    tls13SrvPutU24(b, BytesLen(listOwned))
    bytebuffer.AppendBytes(b, listOwned)
    let body: Bytes = tls13SrvOwned(b)
    return msg.tls13HandshakeFrame(tls13SrvKindCertificate, body)

# CertificateVerify handshake message with a real ed25519 signature.
fn tls13SrvCvMessage(sig: Bytes): Bytes =
    var b: bytebuffer.GrowByteBuffer = bytebuffer.NewByteBuffer()
    tls13SrvPutU16(b, tls13SrvSigEd25519)
    tls13SrvPutU16(b, BytesLen(sig))
    bytebuffer.AppendBytes(b, sig)
    let body: Bytes = tls13SrvOwned(b)
    return msg.tls13HandshakeFrame(tls13SrvKindCertificateVerify, body)

# Minimal well-formed self certificate (DER) embedding the ed25519 key:
# Certificate ::= SEQUENCE { tbsCertificate } with the SPKI at child index 5,
# exactly the shape tls13CliExtractSpki walks (serial + 4 filler SEQs + SPKI).
fn tls13SrvBuildSelfCert(): Bytes =
    let oid: Bytes = BytesAlloc(3)
    BytesSet(oid, 0, 0x2b)
    BytesSet(oid, 1, 0x65)
    BytesSet(oid, 2, 0x70)
    let oidTlv: Bytes = asn1.asn1EncodeOid(oid)
    let algTlv: Bytes = asn1.asn1EncodeSequence(oidTlv)
    let sigPubLocal: Bytes = BytesSlice(tls13SrvSigPub, 0, BytesLen(tls13SrvSigPub))
    let spkTlv: Bytes = asn1.asn1EncodeBitString(sigPubLocal)
    let algIn: Bytes = BytesConcat(algTlv, spkTlv)
    let spki: Bytes = asn1.asn1EncodeSequence(algIn)
    let serialVal: Bytes = BytesAlloc(1)
    BytesSet(serialVal, 0, 1)
    let serial: Bytes = asn1.asn1EncodeInteger(serialVal)
    let tbs1: Bytes = BytesConcat(serial, algTlv)
    let tbs2: Bytes = BytesConcat(tbs1, algTlv)
    let tbs3: Bytes = BytesConcat(tbs2, algTlv)
    let tbs4: Bytes = BytesConcat(tbs3, algTlv)
    let tbs5: Bytes = BytesConcat(tbs4, spki)
    let tbs: Bytes = asn1.asn1EncodeSequence(tbs5)
    return asn1.asn1EncodeSequence(tbs)

# RFC 8446 section 4.4.3 CertificateVerify content, final order.
fn tls13SrvCvContent(transcriptHash: Bytes): Bytes =
    let ctxText: str = "TLS 1.3, server CertificateVerify"
    var ctx: bytebuffer.GrowByteBuffer = bytebuffer.NewByteBuffer()
    var i: int32
    while i < len(ctxText):
        bytebuffer.AppendByte(ctx, int32(ctxText[i]))
        i = i + 1
    bytebuffer.AppendByte(ctx, 0)
    var j: int32
    while j < 64:
        bytebuffer.AppendByte(ctx, 32)
        j = j + 1
    let ctxView: Bytes = bytebuffer.ToBytes(ctx)
    let prefix: Bytes = tls13SrvOwned(ctx)
    return BytesConcat(prefix, transcriptHash)

fn tls13SrvStoreKeys(secret: Bytes, keyDst: int32): int32 =
    let keysRes: Result[ks.Tls13TrafficKeys] = ks.tls13TrafficKeysFor(secret)
    if IsErr(keysRes):
        return 1
    let keys: ks.Tls13TrafficKeys = Value(keysRes)
    if keyDst == 1:
        tls13SrvSapKey = ks.tls13TrafficKeyOf(keys)
        tls13SrvSapIv = ks.tls13TrafficIvOf(keys)
    if keyDst == 2:
        tls13SrvCapKey = ks.tls13TrafficKeyOf(keys)
        tls13SrvCapIv = ks.tls13TrafficIvOf(keys)
    return 0

# ---------- configuration and transitions ----------

# certDer empty => build the minimal self certificate from the signing key.
fn tls13SrvConfigure(priv: Bytes, random: Bytes, sigPriv: Bytes, sigPub: Bytes, certDer: Bytes, eeGroups: int32): int32 =
    tls13SrvState = tls13SrvStateIdle
    tls13SrvErr = 0
    tls13SrvErrText = ""
    tls13SrvPriv = priv
    tls13SrvRandom = random
    tls13SrvSigPriv = sigPriv
    tls13SrvSigPub = sigPub
    tls13SrvCertDer = certDer
    tls13SrvEeGroups = eeGroups
    tls13SrvShared = EmptyBytes()
    tls13SrvHsSecret = EmptyBytes()
    tls13SrvChsTraffic = EmptyBytes()
    tls13SrvShsTraffic = EmptyBytes()
    tls13SrvFinKey = EmptyBytes()
    tls13SrvCliFinKey = EmptyBytes()
    tls13SrvFinVd = EmptyBytes()
    tls13SrvMaster = EmptyBytes()
    tls13SrvCap = EmptyBytes()
    tls13SrvSap = EmptyBytes()
    tls13SrvExp = EmptyBytes()
    tls13SrvCapKey = EmptyBytes()
    tls13SrvCapIv = EmptyBytes()
    tls13SrvSapKey = EmptyBytes()
    tls13SrvSapIv = EmptyBytes()
    tls13SrvResMaster = EmptyBytes()
    tls13SrvProduced = EmptyBytes()
    let privView: Bytes = BytesSlice(tls13SrvPriv, 0, BytesLen(tls13SrvPriv))
    let pubRes: Result[Bytes] = x25519.curve25519PublicFromPrivate(privView)
    if IsErr(pubRes):
        return 1
    tls13SrvPub = Value(pubRes)
    if BytesLen(tls13SrvCertDer) <= 0:
        tls13SrvCertDer = tls13SrvBuildSelfCert()
    return 0

fn tls13SrvFail(code: int32, text: str): Result[bool] =
    tls13SrvErr = code
    tls13SrvErrText = strings.CloneStr(text)
    return Err[bool](text)

fn tls13SrvHandleClientHello(raw: Bytes): Result[bool] =
    if BytesLen(raw) < 1 || BytesGet(raw, 0) != tls13SrvKindClientHello:
        return tls13SrvFail(tls13SrvErrBadState, "tls13 server: expected ClientHello")
    let dec: Result[bool] = msg.tls13DecodeClientHello(raw)
    if IsErr(dec):
        return tls13SrvFail(tls13SrvErrDecode, ErrorText(dec))
    var suiteOk: bool = false
    let suiteCount: int32 = msg.tls13ChCipherCountOf()
    var si: int32
    while si < suiteCount:
        if msg.tls13ChCipherAtOf(si) == tls13SrvSuiteAes128GcmSha256:
            suiteOk = true
        si = si + 1
    if !suiteOk:
        return tls13SrvFail(tls13SrvErrNoSuite, "tls13 server: no common cipher suite")
    if msg.tls13ChSelectedVersionOf() != tls13SrvVersion:
        return tls13SrvFail(tls13SrvErrChVersion, "tls13 server: no TLS 1.3 version offered")
    if msg.tls13ChKeyShareGroupOf() != tls13SrvGroupX25519:
        return tls13SrvFail(tls13SrvErrChKeyShare, "tls13 server: ClientHello key share group mismatch")
    let chKey: Bytes = msg.tls13ChKeyShareOf()
    if BytesLen(chKey) != 32:
        return tls13SrvFail(tls13SrvErrChKeyShare, "tls13 server: ClientHello key share length invalid")
    let ssRes: Result[Bytes] = x25519.curve25519SharedKey(tls13SrvPriv, chKey)
    if IsErr(ssRes):
        return tls13SrvFail(tls13SrvErrDerive, ErrorText(ssRes))
    let ss: Bytes = Value(ssRes)
    tls13SrvShared = ss
    tr.tls13TranscriptBegin1()
    tr.tls13TranscriptAppend1(raw)
    let sh: Bytes = tls13SrvBuildServerHello(tls13SrvRandom, tls13SrvPub)
    tr.tls13TranscriptAppend1(sh)
    let zero: Bytes = ks.tls13Zero32()
    let early: Bytes = ks.tls13EarlySecret(zero)
    let hs: Bytes = ks.tls13HandshakeSecret(early, ss)
    tls13SrvHsSecret = hs
    let chsHash: Bytes = tr.tls13TranscriptHash1()
    let chsRes: Result[Bytes] = ks.tls13DeriveSecretHash(hs, "c hs traffic", chsHash)
    if IsErr(chsRes):
        return tls13SrvFail(tls13SrvErrDerive, ErrorText(chsRes))
    let chs: Bytes = Value(chsRes)
    tls13SrvChsTraffic = chs
    let shsRes: Result[Bytes] = ks.tls13DeriveSecretHash(hs, "s hs traffic", chsHash)
    if IsErr(shsRes):
        return tls13SrvFail(tls13SrvErrDerive, ErrorText(shsRes))
    let shs: Bytes = Value(shsRes)
    tls13SrvShsTraffic = shs
    let srvFinKeyRes: Result[Bytes] = ks.tls13FinishedKey(shs)
    if IsErr(srvFinKeyRes):
        return tls13SrvFail(tls13SrvErrDerive, ErrorText(srvFinKeyRes))
    tls13SrvFinKey = Value(srvFinKeyRes)
    let cliFinKeyRes: Result[Bytes] = ks.tls13FinishedKey(chs)
    if IsErr(cliFinKeyRes):
        return tls13SrvFail(tls13SrvErrDerive, ErrorText(cliFinKeyRes))
    tls13SrvCliFinKey = Value(cliFinKeyRes)
    if tls13SrvStoreKeys(shs, 1) != 0:
        return tls13SrvFail(tls13SrvErrDerive, "tls13 server: handshake traffic keys derive failed")
    if tls13SrvStoreKeys(chs, 2) != 0:
        return tls13SrvFail(tls13SrvErrDerive, "tls13 server: handshake traffic keys derive failed")
    let ee: Bytes = msg.tls13BuildEncryptedExtensionsFrame(tls13SrvEeGroups)
    tr.tls13TranscriptAppend1(ee)
    let cert: Bytes = tls13SrvCertMessage()
    tr.tls13TranscriptAppend1(cert)
    let thCert: Bytes = tr.tls13TranscriptHash1()
    let content: Bytes = tls13SrvCvContent(thCert)
    let sigRes: Result[Bytes] = edsig.signEd25519RawEpoch(tls13SrvSigPriv, content, 1)
    if IsErr(sigRes):
        return tls13SrvFail(tls13SrvErrSign, ErrorText(sigRes))
    let sig: Bytes = Value(sigRes)
    let cv: Bytes = tls13SrvCvMessage(sig)
    tr.tls13TranscriptAppend1(cv)
    let thCv: Bytes = tr.tls13TranscriptHash1()
    let finKeyView: Bytes = BytesSlice(tls13SrvFinKey, 0, BytesLen(tls13SrvFinKey))
    let finVd: Bytes = ks.tls13FinishedVerifyData(finKeyView, thCv)
    tls13SrvFinVd = finVd
    let sfin: Bytes = msg.tls13BuildFinishedFrame(finVd)
    tr.tls13TranscriptAppend1(sfin)
    let flight1: Bytes = BytesConcat(sh, ee)
    let flight2: Bytes = BytesConcat(flight1, cert)
    let flight3: Bytes = BytesConcat(flight2, cv)
    let flight: Bytes = BytesConcat(flight3, sfin)
    tls13SrvProduced = flight
    let thSfin: Bytes = tr.tls13TranscriptHash1()
    let hsView: Bytes = BytesSlice(tls13SrvHsSecret, 0, BytesLen(tls13SrvHsSecret))
    let master: Bytes = ks.tls13MasterSecret(hsView)
    tls13SrvMaster = master
    let capRes: Result[Bytes] = ks.tls13DeriveSecretHash(master, "c ap traffic", thSfin)
    if IsErr(capRes):
        return tls13SrvFail(tls13SrvErrDerive, ErrorText(capRes))
    let cap: Bytes = Value(capRes)
    tls13SrvCap = cap
    let sapRes: Result[Bytes] = ks.tls13DeriveSecretHash(master, "s ap traffic", thSfin)
    if IsErr(sapRes):
        return tls13SrvFail(tls13SrvErrDerive, ErrorText(sapRes))
    let sap: Bytes = Value(sapRes)
    tls13SrvSap = sap
    let expRes: Result[Bytes] = ks.tls13DeriveSecretHash(master, "exp master", thSfin)
    if IsErr(expRes):
        return tls13SrvFail(tls13SrvErrDerive, ErrorText(expRes))
    tls13SrvExp = Value(expRes)
    if tls13SrvStoreKeys(sap, 1) != 0:
        return tls13SrvFail(tls13SrvErrDerive, "tls13 server: application traffic keys derive failed")
    if tls13SrvStoreKeys(cap, 2) != 0:
        return tls13SrvFail(tls13SrvErrDerive, "tls13 server: application traffic keys derive failed")
    tls13SrvState = tls13SrvStateExpectCfin
    return Ok[bool](true)

fn tls13SrvHandleClientFinished(raw: Bytes): Result[bool] =
    if BytesLen(raw) < 1 || BytesGet(raw, 0) != tls13SrvKindFinished:
        return tls13SrvFail(tls13SrvErrBadState, "tls13 server: expected client Finished")
    let dec: Result[bool] = msg.tls13DecodeFinished(raw)
    if IsErr(dec):
        return tls13SrvFail(tls13SrvErrDecode, ErrorText(dec))
    let thSfin: Bytes = tr.tls13TranscriptHash1()
    let cliFinKeyView: Bytes = BytesSlice(tls13SrvCliFinKey, 0, BytesLen(tls13SrvCliFinKey))
    let expected: Bytes = ks.tls13FinishedVerifyData(cliFinKeyView, thSfin)
    let got: Bytes = msg.tls13FinVerifyDataOf()
    if !BytesEqual(expected, got):
        return tls13SrvFail(tls13SrvErrCfinMismatch, "tls13 server: client Finished verify_data mismatch")
    tr.tls13TranscriptAppend1(raw)
    let thCfin: Bytes = tr.tls13TranscriptHash1()
    let masterView: Bytes = BytesSlice(tls13SrvMaster, 0, BytesLen(tls13SrvMaster))
    let resRes: Result[Bytes] = ks.tls13DeriveSecretHash(masterView, "res master", thCfin)
    if IsErr(resRes):
        return tls13SrvFail(tls13SrvErrDerive, ErrorText(resRes))
    tls13SrvResMaster = Value(resRes)
    tls13SrvState = tls13SrvStateComplete
    return Ok[bool](true)

# Feed exactly one handshake message; one call, one state transition.
fn tls13SrvFeed(raw: Bytes): Result[bool] =
    if tls13SrvErr != 0:
        return tls13SrvFail(tls13SrvErrDead, "tls13 server: machine already rejected")
    if tls13SrvState == tls13SrvStateIdle:
        return tls13SrvHandleClientHello(raw)
    if tls13SrvState == tls13SrvStateExpectCfin:
        return tls13SrvHandleClientFinished(raw)
    return tls13SrvFail(tls13SrvErrBadState, "tls13 server: feed in non-awaiting state")
