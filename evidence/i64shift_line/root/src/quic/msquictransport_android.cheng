# Android production MsQuic transport: native UDP/QUIC only.

import cheng/quic/multiaddress as qaddr
import cheng/quic/connection as qconn
import cheng/quic/native_runtime

fn handles(addr: qaddr.MultiAddress): bool =
    if qaddr.quicMultiAddressKind(addr) < 1:
        return false
    if qaddr.quicMultiAddressKind(addr) > 3:
        return false
    return true

fn msquicAndroidAcceptConnectionWithWaitInto(outConn: var qconn.Connection,
                                             safeWait: int32,
                                             outErrorText: var str): bool =
    let acceptCode: int32 = MsQuicNativeAcceptTimedCode(safeWait)
    if acceptCode < 0:
        outErrorText = "msquic: accept failed"
        return false
    if acceptCode <= 0:
        outErrorText = "msquic: accept timeout"
        return false
    var localAddr: qaddr.MultiAddress
    MsQuicNativeListenerBoundAddrInto(localAddr)
    var remoteAddr: qaddr.MultiAddress
    MsQuicNativePeerDialAddrInto(remoteAddr)
    if !qconn.MsQuicNativeInboundConnectionCodeInto(outConn, localAddr, remoteAddr):
        outErrorText = "msquic native: invalid pipe token"
        return false
    return true

fn MsQuicAndroidAcceptConnectionInto(outConn: var qconn.Connection,
                                     waitMs: int32,
                                     outErrorText: var str): bool =
    if waitMs < 0:
        return msquicAndroidAcceptConnectionWithWaitInto(outConn, 0, outErrorText)
    return msquicAndroidAcceptConnectionWithWaitInto(outConn, waitMs, outErrorText)

fn MsQuicAndroidDialConnectionInto(outConn: var qconn.Connection,
                                   addr: qaddr.MultiAddress,
                                   outErrorText: var str): bool =
    if ! handles(addr):
        outErrorText = "msquic: unsupported address"
        return false
    let dialCode: int32 = MsQuicNativeDialDefaultCode(addr)
    if dialCode < 0:
        outErrorText = "msquic: dial failed"
        return false
    var clientAddr: qaddr.MultiAddress
    MsQuicNativeClientBoundAddrInto(clientAddr)
    if !qconn.MsQuicNativeOutboundConnectionCodeInto(outConn, clientAddr, addr):
        outErrorText = "msquic native: invalid pipe token"
        return false
    return true
