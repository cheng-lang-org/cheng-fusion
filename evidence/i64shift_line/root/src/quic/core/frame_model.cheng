# MsQuic core frame model(pure Cheng, in-process).

import std/result
import std/rawbytes
import cheng/quic/core/quic_varint
type
    MsQuicFrameType = enum
        # Values follow QUIC frame type ids (RFC 9000 + extensions used here).
        FramePadding = 0x00
        FramePing = 0x01
        FrameAck = 0x02
        FrameReset = 0x04
        FrameStopSending = 0x05
        FrameCrypto = 0x06
        FrameNewToken = 0x07
        FrameData = 0x0e
        FrameDataFin = 0x0f
        FrameMaxData = 0x10
        FrameMaxStreamData = 0x11
        FrameMaxStreamsBidi = 0x12
        FrameMaxStreamsUni = 0x13
        FrameDataBlocked = 0x14
        FrameStreamDataBlocked = 0x15
        FrameStreamsBlockedBidi = 0x16
        FrameStreamsBlockedUni = 0x17
        FrameNewConnectionId = 0x18
        FrameRetireConnectionId = 0x19
        FramePathChallenge = 0x1a
        FramePathResponse = 0x1b
        FrameConnectionClose = 0x1c
        FrameConnectionCloseApp = 0x1d
        FrameHandshakeDone = 0x1e
        FrameImmediateAck = 0x1f
        FrameDatagram = 0x30
        FrameAckFrequency = 0xaf

    MsQuicFrame =
        kind: MsQuicFrameType
        wireKind: int64 = -1
        streamId: int64
        offset: int64
        value: int64
        data: Bytes

fn msquicFrameSize(frame: MsQuicFrame): int32 =
    let kindLen: int32 = quicVarIntEncodedLen(msquicFrameWireKind(frame))
    let streamLen: int32 = quicVarIntEncodedLen(frame.streamId)
    let offsetLen: int32 = quicVarIntEncodedLen(frame.offset)
    let valueLen: int32 = quicVarIntEncodedLen(frame.value)
    let dataLen: int32 = BytesLen(frame.data)
    let payloadLenLen: int32 = quicVarIntEncodedLen(int64(dataLen))
    if kindLen <= 0 || streamLen <= 0 || offsetLen <= 0 || valueLen <= 0 || payloadLenLen <= 0:
        return 0
    return kindLen + streamLen + offsetLen + valueLen + payloadLenLen + dataLen

fn msquicFrameTypeWireCode(kind: MsQuicFrameType): int64 =
    let code: int64 = int64(kind)
    if code >= 0 && code <= 0x1f:
        return code
    if code == 0x30:
        return code
    if code == 0xaf:
        return code
    if kind == FramePadding:
        return 0x00
    if kind == FramePing:
        return 0x01
    if kind == FrameAck:
        return 0x02
    if kind == FrameReset:
        return 0x04
    if kind == FrameStopSending:
        return 0x05
    if kind == FrameCrypto:
        return 0x06
    if kind == FrameNewToken:
        return 0x07
    if kind == FrameData:
        return 0x0e
    if kind == FrameDataFin:
        return 0x0f
    if kind == FrameMaxData:
        return 0x10
    if kind == FrameMaxStreamData:
        return 0x11
    if kind == FrameMaxStreamsBidi:
        return 0x12
    if kind == FrameMaxStreamsUni:
        return 0x13
    if kind == FrameDataBlocked:
        return 0x14
    if kind == FrameStreamDataBlocked:
        return 0x15
    if kind == FrameStreamsBlockedBidi:
        return 0x16
    if kind == FrameStreamsBlockedUni:
        return 0x17
    if kind == FrameNewConnectionId:
        return 0x18
    if kind == FrameRetireConnectionId:
        return 0x19
    if kind == FramePathChallenge:
        return 0x1a
    if kind == FramePathResponse:
        return 0x1b
    if kind == FrameConnectionClose:
        return 0x1c
    if kind == FrameConnectionCloseApp:
        return 0x1d
    if kind == FrameHandshakeDone:
        return 0x1e
    if kind == FrameImmediateAck:
        return 0x1f
    if kind == FrameDatagram:
        return 0x30
    if kind == FrameAckFrequency:
        return 0xaf
    return -1

fn msquicFrameTypeFromInt(value: int64): Result[MsQuicFrameType] =
    if value == 0x00:
        return Ok[MsQuicFrameType](FramePadding)
    if value == 0x01:
        return Ok[MsQuicFrameType](FramePing)
    if value == 0x02:
        return Ok[MsQuicFrameType](FrameAck)
    if value == 0x04:
        return Ok[MsQuicFrameType](FrameReset)
    if value == 0x05:
        return Ok[MsQuicFrameType](FrameStopSending)
    if value == 0x06:
        return Ok[MsQuicFrameType](FrameCrypto)
    if value == 0x07:
        return Ok[MsQuicFrameType](FrameNewToken)
    if value == 0x0e:
        return Ok[MsQuicFrameType](FrameData)
    if value == 0x0f:
        return Ok[MsQuicFrameType](FrameDataFin)
    if value == 0x10:
        return Ok[MsQuicFrameType](FrameMaxData)
    if value == 0x11:
        return Ok[MsQuicFrameType](FrameMaxStreamData)
    if value == 0x12:
        return Ok[MsQuicFrameType](FrameMaxStreamsBidi)
    if value == 0x13:
        return Ok[MsQuicFrameType](FrameMaxStreamsUni)
    if value == 0x14:
        return Ok[MsQuicFrameType](FrameDataBlocked)
    if value == 0x15:
        return Ok[MsQuicFrameType](FrameStreamDataBlocked)
    if value == 0x16:
        return Ok[MsQuicFrameType](FrameStreamsBlockedBidi)
    if value == 0x17:
        return Ok[MsQuicFrameType](FrameStreamsBlockedUni)
    if value == 0x18:
        return Ok[MsQuicFrameType](FrameNewConnectionId)
    if value == 0x19:
        return Ok[MsQuicFrameType](FrameRetireConnectionId)
    if value == 0x1a:
        return Ok[MsQuicFrameType](FramePathChallenge)
    if value == 0x1b:
        return Ok[MsQuicFrameType](FramePathResponse)
    if value == 0x1c:
        return Ok[MsQuicFrameType](FrameConnectionClose)
    if value == 0x1d:
        return Ok[MsQuicFrameType](FrameConnectionCloseApp)
    if value == 0x1e:
        return Ok[MsQuicFrameType](FrameHandshakeDone)
    if value == 0x1f:
        return Ok[MsQuicFrameType](FrameImmediateAck)
    if value == 0x30:
        return Ok[MsQuicFrameType](FrameDatagram)
    if value == 0xaf:
        return Ok[MsQuicFrameType](FrameAckFrequency)
    return Err[MsQuicFrameType]("msquic frame: invalid type")

fn msquicFrameWireKind(frame: MsQuicFrame): int64 =
    if frame.wireKind >= 0:
        return frame.wireKind
    return msquicFrameTypeWireCode(frame.kind)

fn msquicFrameAck(): MsQuicFrame =
    var out: MsQuicFrame
    out.kind = FrameAck
    out.wireKind = 2
    out.streamId = 0
    out.offset = 0
    out.value = 0
    out.data = emptyBytes()
    return out

fn msquicFrameAckNumber(number: int64): MsQuicFrame =
    var out: MsQuicFrame
    out.kind = FrameAck
    out.wireKind = 2
    out.streamId = 0
    out.offset = 0
    out.value = number
    out.data = emptyBytes()
    return out

fn msquicFramePing(): MsQuicFrame =
    var out: MsQuicFrame
    out.kind = FramePing
    out.wireKind = 1
    out.streamId = 0
    out.offset = 0
    out.value = 0
    out.data = emptyBytes()
    return out

fn msquicFrameData(streamId: int64, offset: int64, data: Bytes): MsQuicFrame =
    var out: MsQuicFrame
    out.kind = FrameData
    out.wireKind = 14
    out.streamId = streamId
    out.offset = offset
    out.value = 0
    out.data = data
    return out

fn msquicFrameDataFin(streamId: int64, offset: int64, data: Bytes): MsQuicFrame =
    var out: MsQuicFrame
    out.kind = FrameDataFin
    out.wireKind = 15
    out.streamId = streamId
    out.offset = offset
    out.value = 0
    out.data = data
    return out

fn msquicFrameMaxData(value: int64): MsQuicFrame =
    var out: MsQuicFrame
    out.kind = FrameMaxData
    out.wireKind = 16
    out.streamId = 0
    out.offset = 0
    out.value = value
    out.data = emptyBytes()
    return out

fn msquicFrameMaxStreamData(streamId: int64, value: int64): MsQuicFrame =
    var out: MsQuicFrame
    out.kind = FrameMaxStreamData
    out.wireKind = 17
    out.streamId = streamId
    out.offset = 0
    out.value = value
    out.data = emptyBytes()
    return out

fn msquicFrameReset(streamId: int64, errCode: int64): MsQuicFrame =
    var out: MsQuicFrame
    out.kind = FrameReset
    out.wireKind = 4
    out.streamId = streamId
    out.offset = 0
    out.value = errCode
    out.data = emptyBytes()
    return out

fn msquicFrameStopSending(streamId: int64, errCode: int64): MsQuicFrame =
    var out: MsQuicFrame
    out.kind = FrameStopSending
    out.wireKind = 5
    out.streamId = streamId
    out.offset = 0
    out.value = errCode
    out.data = emptyBytes()
    return out

fn msquicFrameResetFinal(streamId: int64, errCode: int64, finalSize: int64): MsQuicFrame =
    var out: MsQuicFrame
    out.kind = FrameReset
    out.wireKind = 4
    out.streamId = streamId
    out.offset = finalSize
    out.value = errCode
    out.data = emptyBytes()
    return out

fn msquicFrameCrypto(offset: int64, data: Bytes): MsQuicFrame =
    var out: MsQuicFrame
    out.kind = FrameCrypto
    out.wireKind = 6
    out.streamId = 0
    out.offset = offset
    out.value = 0
    out.data = data
    return out

fn msquicFrameDatagram(data: Bytes): MsQuicFrame =
    var out: MsQuicFrame
    out.kind = FrameDatagram
    out.wireKind = 48
    out.streamId = 0
    out.offset = 0
    out.value = 0
    out.data = data
    return out

fn msquicFrameHandshakeDone(): MsQuicFrame =
    var out: MsQuicFrame
    out.kind = FrameHandshakeDone
    out.wireKind = 30
    out.streamId = 0
    out.offset = 0
    out.value = 0
    out.data = emptyBytes()
    return out

fn msquicFrameImmediateAck(): MsQuicFrame =
    var out: MsQuicFrame
    out.kind = FrameImmediateAck
    out.wireKind = 31
    out.streamId = 0
    out.offset = 0
    out.value = 0
    out.data = emptyBytes()
    return out

fn msquicFrameMaxStreamsBidi(value: int64): MsQuicFrame =
    var out: MsQuicFrame
    out.kind = FrameMaxStreamsBidi
    out.wireKind = 18
    out.streamId = 0
    out.offset = 0
    out.value = value
    out.data = emptyBytes()
    return out

fn msquicFrameMaxStreamsUni(value: int64): MsQuicFrame =
    var out: MsQuicFrame
    out.kind = FrameMaxStreamsUni
    out.wireKind = 19
    out.streamId = 0
    out.offset = 0
    out.value = value
    out.data = emptyBytes()
    return out

fn msquicFramePathResponse(token: Bytes): MsQuicFrame =
    var out: MsQuicFrame
    out.kind = FramePathResponse
    out.wireKind = 27
    out.streamId = 0
    out.offset = 0
    out.value = 0
    out.data = token
    return out

fn msquicFrameConnectionClose(errCode: int64, frameType: int64, reason: Bytes): MsQuicFrame =
    var out: MsQuicFrame
    out.kind = FrameConnectionClose
    out.wireKind = 28
    out.streamId = 0
    out.offset = frameType
    out.value = errCode
    out.data = reason
    return out

fn msquicFrameConnectionCloseApp(errCode: int64, reason: Bytes): MsQuicFrame =
    var out: MsQuicFrame
    out.kind = FrameConnectionCloseApp
    out.wireKind = 29
    out.streamId = 0
    out.offset = 0
    out.value = errCode
    out.data = reason
    return out

fn msquicFrameAckFrequency(seq: int64, ackThreshold: int64, maxDelayUs: int64, reorderThreshold: int64): MsQuicFrame =
    let encRes: Result[Bytes] = quicVarIntEncode(reorderThreshold)
    let data: Bytes = if IsErr(encRes): emptyBytes() else: Value(encRes)
    var out: MsQuicFrame
    out.kind = FrameAckFrequency
    out.wireKind = 175
    out.streamId = ackThreshold
    out.offset = maxDelayUs
    out.value = seq
    out.data = data
    return out

fn MsQuicFrameSize(frame: MsQuicFrame): int32 =
    return msquicFrameSize(frame)

fn MsQuicFrameTypeWireCode(kind: MsQuicFrameType): int64 =
    return msquicFrameTypeWireCode(kind)

fn MsQuicFrameTypeFromInt(value: int64): Result[MsQuicFrameType] =
    return msquicFrameTypeFromInt(value)

fn MsQuicFrameWireKind(frame: MsQuicFrame): int64 =
    return msquicFrameWireKind(frame)

fn MsQuicFrameAck(): MsQuicFrame =
    return msquicFrameAck()

fn MsQuicFrameAckNumber(number: int64): MsQuicFrame =
    return msquicFrameAckNumber(number)

fn MsQuicFramePing(): MsQuicFrame =
    return msquicFramePing()

fn MsQuicFrameData(streamId: int64, offset: int64, data: Bytes): MsQuicFrame =
    return msquicFrameData(streamId, offset, data)

fn MsQuicFrameDataFin(streamId: int64, offset: int64, data: Bytes): MsQuicFrame =
    return msquicFrameDataFin(streamId, offset, data)

fn MsQuicFrameMaxData(value: int64): MsQuicFrame =
    return msquicFrameMaxData(value)

fn MsQuicFrameMaxStreamData(streamId: int64, value: int64): MsQuicFrame =
    return msquicFrameMaxStreamData(streamId, value)

fn MsQuicFrameReset(streamId: int64, errCode: int64): MsQuicFrame =
    return msquicFrameReset(streamId, errCode)

fn MsQuicFrameStopSending(streamId: int64, errCode: int64): MsQuicFrame =
    return msquicFrameStopSending(streamId, errCode)

fn MsQuicFrameResetFinal(streamId: int64, errCode: int64, finalSize: int64): MsQuicFrame =
    return msquicFrameResetFinal(streamId, errCode, finalSize)

fn MsQuicFrameCrypto(offset: int64, data: Bytes): MsQuicFrame =
    return msquicFrameCrypto(offset, data)

fn MsQuicFrameDatagram(data: Bytes): MsQuicFrame =
    return msquicFrameDatagram(data)

fn MsQuicFrameHandshakeDone(): MsQuicFrame =
    return msquicFrameHandshakeDone()

fn MsQuicFrameImmediateAck(): MsQuicFrame =
    return msquicFrameImmediateAck()

fn MsQuicFrameMaxStreamsBidi(value: int64): MsQuicFrame =
    return msquicFrameMaxStreamsBidi(value)

fn MsQuicFrameMaxStreamsUni(value: int64): MsQuicFrame =
    return msquicFrameMaxStreamsUni(value)

fn MsQuicFramePathResponse(token: Bytes): MsQuicFrame =
    return msquicFramePathResponse(token)

fn MsQuicFrameConnectionClose(errCode: int64, frameType: int64, reason: Bytes): MsQuicFrame =
    return msquicFrameConnectionClose(errCode, frameType, reason)

fn MsQuicFrameConnectionCloseApp(errCode: int64, reason: Bytes): MsQuicFrame =
    return msquicFrameConnectionCloseApp(errCode, reason)

fn MsQuicFrameAckFrequency(seq: int64, ackThreshold: int64, maxDelayUs: int64, reorderThreshold: int64): MsQuicFrame =
    return msquicFrameAckFrequency(seq, ackThreshold, maxDelayUs, reorderThreshold)

fn MsQuicFrameKind(frame: MsQuicFrame): MsQuicFrameType =
    return frame.kind

fn MsQuicFrameStreamId(frame: MsQuicFrame): int64 =
    return frame.streamId

fn MsQuicFrameOffset(frame: MsQuicFrame): int64 =
    return frame.offset

fn MsQuicFrameValue(frame: MsQuicFrame): int64 =
    return frame.value

fn MsQuicFramePayload(frame: MsQuicFrame): Bytes =
    return frame.data
