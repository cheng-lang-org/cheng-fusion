# MsQuic CRYPTO stream reassembly(pure Cheng).

import std/result
import std/rawbytes
import std/buffer as bytebuffer
const
    msQuicCryptoMaxChunks = 64

type
    MsQuicCryptoChunk =
        used: bool
        offset: int64
        data: rawbytes.Bytes

    MsQuicCryptoStream =
        nextOffset: int64
        pendingCount: int32
        chunks: MsQuicCryptoChunk[msQuicCryptoMaxChunks]
        ready: bytebuffer.GrowByteBuffer

fn initMsQuicCryptoStreamInto(out: var MsQuicCryptoStream) =
    out.nextOffset = 0
    out.pendingCount = 0
    out.ready = bytebuffer.NewByteBuffer()
    for i in 0..<msQuicCryptoMaxChunks:
        out.chunks[i] = MsQuicCryptoChunk(used: false, offset: 0, data: emptyBytes())

fn initMsQuicCryptoStream(): MsQuicCryptoStream =
    var out: MsQuicCryptoStream
    initMsQuicCryptoStreamInto(out)
    return out

fn msquicCryptoStreamReset(stream: var MsQuicCryptoStream) =
    stream.nextOffset = 0
    stream.pendingCount = 0
    stream.ready = bytebuffer.NewByteBuffer()
    for i in 0..<msQuicCryptoMaxChunks:
        stream.chunks[i] = MsQuicCryptoChunk(used: false, offset: 0, data: emptyBytes())

fn msquicCryptoStreamAvailable(stream: var MsQuicCryptoStream): int32 =
    return bytebuffer.ByteBufferLen(stream.ready)

fn msquicCryptoStreamConsume(stream: var MsQuicCryptoStream, length: int32): rawbytes.Bytes =
    if length <= 0:
        return emptyBytes()
    var ready: bytebuffer.GrowByteBuffer = stream.ready
    let out: rawbytes.Bytes = bytebuffer.ByteBufferConsume(ready, length)
    stream.ready = ready
    return out

fn msquicCryptoStreamNormalize(stream: var MsQuicCryptoStream) =
    for i in 0..<msQuicCryptoMaxChunks:
        var chunk: MsQuicCryptoChunk = stream.chunks[i]
        if chunk.used && chunk.offset < stream.nextOffset:
            let trim64: int64 = stream.nextOffset - chunk.offset
            if trim64 >= int64(BytesLen(chunk.data)):
                chunk.used = false
                chunk.data = emptyBytes()
                stream.chunks[i] = chunk
                stream.pendingCount = stream.pendingCount - 1
            else:
                let trim: int32 = int32(trim64)
                chunk.data = BytesSlice(chunk.data, trim, BytesLen(chunk.data) - trim)
                chunk.offset = stream.nextOffset
                stream.chunks[i] = chunk

fn msquicCryptoStreamDrain(stream: var MsQuicCryptoStream) =
    var advanced: bool = true
    while advanced:
        advanced = false
        msquicCryptoStreamNormalize(stream)
        for i in 0..<msQuicCryptoMaxChunks:
            var chunk: MsQuicCryptoChunk = stream.chunks[i]
            if chunk.used && chunk.offset == stream.nextOffset:
                let data: rawbytes.Bytes = chunk.data
                var ready: bytebuffer.GrowByteBuffer = stream.ready
                bytebuffer.AppendBytes(ready, data)
                stream.ready = ready
                stream.nextOffset = stream.nextOffset + int64(BytesLen(data))
                chunk.used = false
                chunk.data = emptyBytes()
                stream.chunks[i] = chunk
                stream.pendingCount = stream.pendingCount - 1
                advanced = true
                break

fn msquicCryptoStreamAdd(stream: var MsQuicCryptoStream, offset: int64, data: rawbytes.Bytes): Result[bool] =
    if offset < 0:
        return Err[bool]("msquic crypto: negative offset")
    if BytesLen(data) <= 0:
        return Ok[bool](true)
    var off: int64 = offset
    # Call-result def on both merge paths.
    var payload: rawbytes.Bytes = BytesSlice(data, 0, BytesLen(data))
    if off < stream.nextOffset:
        let trim64: int64 = stream.nextOffset - off
        if trim64 >= int64(BytesLen(payload)):
            return Ok[bool](true)
        let trim: int32 = int32(trim64)
        payload = BytesSlice(payload, trim, BytesLen(payload) - trim)
        off = stream.nextOffset
    if off == stream.nextOffset:
        var ready: bytebuffer.GrowByteBuffer = stream.ready
        bytebuffer.AppendBytes(ready, payload)
        stream.ready = ready
        stream.nextOffset = stream.nextOffset + int64(BytesLen(payload))
        msquicCryptoStreamDrain(stream)
        return Ok[bool](true)
    var freeIdx: int32 = -1
    for i in 0..<msQuicCryptoMaxChunks:
        var chunk: MsQuicCryptoChunk = stream.chunks[i]
        if chunk.used:
            if chunk.offset == off:
                if BytesLen(chunk.data) >= BytesLen(payload):
                    return Ok[bool](true)
                chunk.data = payload
                stream.chunks[i] = chunk
                msquicCryptoStreamDrain(stream)
                return Ok[bool](true)
        else:
            if freeIdx < 0:
                freeIdx = i
    if freeIdx < 0:
        return Err[bool]("msquic crypto: chunk list full")
    stream.chunks[freeIdx] = MsQuicCryptoChunk(used: true, offset: off, data: payload)
    stream.pendingCount = stream.pendingCount + 1
    msquicCryptoStreamDrain(stream)
    return Ok[bool](true)
