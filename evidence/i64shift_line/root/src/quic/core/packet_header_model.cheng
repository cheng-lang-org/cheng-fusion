# QUIC packet header model(RFC 9000, minimal).

import std/result
import std/rawbytes
import std/buffer as bytebuffer
import cheng/quic/core/quic_varint
const
    quicLongHeaderFormBit: int32 = 0x80
    quicFixedBit: int32 = 0x40
    quicSpinBit: int32 = 0x20
    quicKeyPhaseBit: int32 = 0x04
    quicPnlMask: int32 = 0x03
    quicReservedBitsLongMask: int32 = 0x0c
    quicReservedBitsShortMask: int32 = 0x18

type
    QuicPacketType = enum
        QuicPacketShort = 0
        QuicPacketInitial = 1
        QuicPacket0Rtt = 2
        QuicPacketHandshake = 3
        QuicPacketRetry = 4

    QuicPacketHeader =
        longHeader: bool
        packetType: QuicPacketType
        version: int32
        dcid: Bytes
        scid: Bytes
        token: Bytes
        payloadLength: int64
        packetNumber: int64
        packetNumberLen: int32
        spinBit: bool
        keyPhase: bool

    QuicPacketHeaderDecoded =
        header: QuicPacketHeader
        next: int32

    QuicPacketHeaderVarIntDecoded = quic_varint.QuicVarIntDecoded

fn quicPacketTypeToBits(packetType: QuicPacketType): int32 =
    if packetType == QuicPacketInitial:
        return 0
    if packetType == QuicPacket0Rtt:
        return 1
    if packetType == QuicPacketHandshake:
        return 2
    if packetType == QuicPacketRetry:
        return 3
    return -1

fn quicPacketTypeFromBits(bits: int32): QuicPacketType =
    if bits == 0:
        return QuicPacketInitial
    if bits == 1:
        return QuicPacket0Rtt
    if bits == 2:
        return QuicPacketHandshake
    return QuicPacketRetry

fn quicPacketNumberEncode(number: int64, length: int32): Result[Bytes] =
    if length < 1 || length > 4:
        return Err[Bytes]("quic header: invalid packet number length")
    if number < 0:
        return Err[Bytes]("quic header: negative packet number")
    let out: Bytes = BytesAlloc(length)
    for i in 0..<length:
        var divisor: int64 = 1
        let remaining: int32 = length - 1 - i
        for j in 0..<remaining:
            divisor = divisor * 256
        let b: int32 = int32((number / divisor) % 256)
        BytesSet(out, i, b)
    return Ok[Bytes](out)

@borrows
fn quicPacketNumberDecode(data: Bytes,
                          offset: int32,
                          length: int32): Result[QuicPacketHeaderVarIntDecoded] =
    if length < 1 || length > 4:
        return Err[QuicPacketHeaderVarIntDecoded]("quic header: invalid packet number length")
    if offset < 0 || offset + length > BytesLen(data):
        return Err[QuicPacketHeaderVarIntDecoded]("quic header: packet number truncated")
    var value: int64
    for i in 0..<length:
        value = value * 256 + int64(BytesGet(data, offset + i))
    return Ok[QuicPacketHeaderVarIntDecoded](quic_varint.QuicVarIntDecoded(value: value, next: offset + length))

fn quicPacketHeaderEncode(header: QuicPacketHeader): Result[Bytes] =
    if BytesLen(header.dcid) > 255 || BytesLen(header.scid) > 255:
        return Err[Bytes]("quic header: connection id too long")
    var buf: bytebuffer.GrowByteBuffer = bytebuffer.NewByteBuffer()
    if header.longHeader:
        if header.packetType == QuicPacketShort:
            return Err[Bytes]("quic header: short type in long header")
        let typeBits: int32 = quicPacketTypeToBits(header.packetType)
        if typeBits < 0:
            return Err[Bytes]("quic header: invalid long header type")
        if header.packetType == QuicPacketRetry:
            var first: int32 = 192
            first = first + typeBits * 16
            bytebuffer.AppendByte(buf, first)
            bytebuffer.AppendByte(buf, (header.version / 16777216) % 256)
            bytebuffer.AppendByte(buf, (header.version / 65536) % 256)
            bytebuffer.AppendByte(buf, (header.version / 256) % 256)
            bytebuffer.AppendByte(buf, header.version % 256)
            bytebuffer.AppendByte(buf, BytesLen(header.dcid))
            if BytesLen(header.dcid) > 0:
                let dcid: Bytes = header.dcid
                bytebuffer.byteBufferAppendBytesImpl(buf, dcid)
            bytebuffer.AppendByte(buf, BytesLen(header.scid))
            if BytesLen(header.scid) > 0:
                let scid: Bytes = header.scid
                bytebuffer.byteBufferAppendBytesImpl(buf, scid)
            if BytesLen(header.token) > 0:
                let token: Bytes = header.token
                bytebuffer.byteBufferAppendBytesImpl(buf, token)
            return Ok[Bytes](rawbytes.BytesSlice(bytebuffer.ToBytes(buf), 0, rawbytes.BytesLen(bytebuffer.ToBytes(buf))))
        if header.packetNumberLen < 1 || header.packetNumberLen > 4:
            return Err[Bytes]("quic header: invalid packet number length")
        var first: int32 = 192
        first = first + typeBits * 16
        first = first + header.packetNumberLen - 1
        bytebuffer.AppendByte(buf, first)
        bytebuffer.AppendByte(buf, (header.version / 16777216) % 256)
        bytebuffer.AppendByte(buf, (header.version / 65536) % 256)
        bytebuffer.AppendByte(buf, (header.version / 256) % 256)
        bytebuffer.AppendByte(buf, header.version % 256)
        bytebuffer.AppendByte(buf, BytesLen(header.dcid))
        if BytesLen(header.dcid) > 0:
            let dcid: Bytes = header.dcid
            bytebuffer.byteBufferAppendBytesImpl(buf, dcid)
        bytebuffer.AppendByte(buf, BytesLen(header.scid))
        if BytesLen(header.scid) > 0:
            let scid: Bytes = header.scid
            bytebuffer.byteBufferAppendBytesImpl(buf, scid)
        if header.packetType == QuicPacketInitial:
            let tokenLen: int64 = int64(BytesLen(header.token))
            let tokenRes: Result[bool] = quicVarIntAppend(buf, tokenLen)
            if IsErr(tokenRes):
                return Err[Bytes](ErrorText(tokenRes))
            if tokenLen > 0:
                let token: Bytes = header.token
                bytebuffer.byteBufferAppendBytesImpl(buf, token)
        let lenRes: Result[bool] = quicVarIntAppend(buf, header.payloadLength)
        if IsErr(lenRes):
            return Err[Bytes](ErrorText(lenRes))
        let pnRes: Result[Bytes] = quicPacketNumberEncode(header.packetNumber, header.packetNumberLen)
        if IsErr(pnRes):
            return Err[Bytes](ErrorText(pnRes))
        let pnBytes: Bytes = Value(pnRes)
        bytebuffer.byteBufferAppendBytesImpl(buf, pnBytes)
        return Ok[Bytes](rawbytes.BytesSlice(bytebuffer.ToBytes(buf), 0, rawbytes.BytesLen(bytebuffer.ToBytes(buf))))
    # Short header: built directly into one presized buffer instead of via
    # GrowByteBuffer appends (which reallocated + copied the whole growing
    # header on every append) plus a separate quicPacketNumberEncode alloc
    # that was never freed after being copied in — this runs on every packet
    # sent in both directions, so the leak/churn was per-packet.
    if header.packetNumberLen < 1 || header.packetNumberLen > 4:
        return Err[Bytes]("quic header: invalid packet number length")
    if header.packetNumber < 0:
        return Err[Bytes]("quic header: negative packet number")
    var spinBitValue: int32
    if header.spinBit:
        spinBitValue = 0x20
    var keyPhaseValue: int32
    if header.keyPhase:
        keyPhaseValue = 0x04
    var first: int32 = 64
    first = first + spinBitValue
    first = first + keyPhaseValue
    first = first + header.packetNumberLen - 1
    let dcidLen: int32 = BytesLen(header.dcid)
    let pnLen: int32 = header.packetNumberLen
    let out: Bytes = BytesAlloc(1 + dcidLen + pnLen)
    BytesSet(out, 0, first)
    if dcidLen > 0:
        BytesCopyInto(out, 1, header.dcid)
    let pnOffset: int32 = 1 + dcidLen
    for i in 0..<pnLen:
        var divisor: int64 = 1
        let remaining: int32 = pnLen - 1 - i
        for j in 0..<remaining:
            divisor = divisor * 256
        BytesSet(out, pnOffset + i, int32((header.packetNumber / divisor) % 256))
    return Ok[Bytes](out)

@borrows
fn quicPacketHeaderDecode(data: Bytes, shortDcidLen: int32): Result[QuicPacketHeaderDecoded] =
    if BytesLen(data) <= 0:
        return Err[QuicPacketHeaderDecoded]("quic header: empty input")
    let first: int32 = BytesGet(data, 0)
    let isLong: bool = first >= 128
    let fixedBucket: int32 = first % 128
    if fixedBucket < 64:
        return Err[QuicPacketHeaderDecoded]("quic header: fixed bit ! set")
    if isLong:
        let typeBits: int32 = (first / 16) % 4
        let packetType: QuicPacketType = quicPacketTypeFromBits(typeBits)
        if BytesLen(data) < 6:
            return Err[QuicPacketHeaderDecoded]("quic header: truncated long header")
        let version: int32 = BytesGet(data, 1) * 16777216 +
                             BytesGet(data, 2) * 65536 +
                             BytesGet(data, 3) * 256 +
                             BytesGet(data, 4)
        var offset: int32 = 5
        let dcidLen: int32 = BytesGet(data, offset)
        offset = offset + 1
        if offset + dcidLen > BytesLen(data):
            return Err[QuicPacketHeaderDecoded]("quic header: dcid truncated")
        let dcid: Bytes = if dcidLen > 0: BytesSlice(data, offset, dcidLen) else: emptyBytes()
        offset = offset + dcidLen
        if offset >= BytesLen(data):
            return Err[QuicPacketHeaderDecoded]("quic header: scid length missing")
        let scidLen: int32 = BytesGet(data, offset)
        offset = offset + 1
        if offset + scidLen > BytesLen(data):
            return Err[QuicPacketHeaderDecoded]("quic header: scid truncated")
        let scid: Bytes = if scidLen > 0: BytesSlice(data, offset, scidLen) else: emptyBytes()
        offset = offset + scidLen
        if packetType == QuicPacketRetry:
            let token: Bytes = if offset < BytesLen(data): BytesSlice(data, offset, BytesLen(data) - offset) else: emptyBytes()
            let header: QuicPacketHeader = QuicPacketHeader(
                longHeader: true,
                packetType: packetType,
                version: version,
                dcid: dcid,
                scid: scid,
                token: token,
                payloadLength: 0,
                packetNumber: 0,
                packetNumberLen: 0,
                spinBit: false,
                keyPhase: false
            )
            return Ok[QuicPacketHeaderDecoded](QuicPacketHeaderDecoded(header: header, next: BytesLen(data)))
        let pnLen: int32 = (first % 4) + 1
        var token: Bytes = emptyBytes()
        if packetType == QuicPacketInitial:
            let tokenLenRes: Result[QuicPacketHeaderVarIntDecoded] = quic_varint.quicVarIntDecode(data, offset)
            if IsErr(tokenLenRes):
                return Err[QuicPacketHeaderDecoded](ErrorText(tokenLenRes))
            let tokenLen: int64 = Value(tokenLenRes).value
            offset = Value(tokenLenRes).next
            if tokenLen < 0 || offset + int32(tokenLen) > BytesLen(data):
                return Err[QuicPacketHeaderDecoded]("quic header: token truncated")
            if tokenLen > 0:
                token = BytesSlice(data, offset, int32(tokenLen))
            else:
                token = emptyBytes()
            offset = offset + int32(tokenLen)
        let payloadRes: Result[QuicPacketHeaderVarIntDecoded] = quic_varint.quicVarIntDecode(data, offset)
        if IsErr(payloadRes):
            return Err[QuicPacketHeaderDecoded](ErrorText(payloadRes))
        let payloadLength: int64 = Value(payloadRes).value
        offset = Value(payloadRes).next
        let pnRes: Result[QuicPacketHeaderVarIntDecoded] = quicPacketNumberDecode(data, offset, pnLen)
        if IsErr(pnRes):
            return Err[QuicPacketHeaderDecoded](ErrorText(pnRes))
        let packetNumber: int64 = Value(pnRes).value
        offset = Value(pnRes).next
        let header: QuicPacketHeader = QuicPacketHeader(
            longHeader: true,
            packetType: packetType,
            version: version,
            dcid: dcid,
            scid: scid,
            token: token,
            payloadLength: payloadLength,
            packetNumber: packetNumber,
            packetNumberLen: pnLen,
            spinBit: false,
            keyPhase: false
        )
        return Ok[QuicPacketHeaderDecoded](QuicPacketHeaderDecoded(header: header, next: offset))
    if shortDcidLen < 0:
        return Err[QuicPacketHeaderDecoded]("quic header: invalid short dcid length")
    let pnLen: int32 = (first % 4) + 1
    let spinBit: bool = ((first / 32) % 2) == 1
    let keyPhase: bool = ((first / 4) % 2) == 1
    var offset: int32 = 1
    if offset + shortDcidLen > BytesLen(data):
        return Err[QuicPacketHeaderDecoded]("quic header: short dcid truncated")
    let dcid: Bytes = if shortDcidLen > 0: BytesSlice(data, offset, shortDcidLen) else: emptyBytes()
    offset = offset + shortDcidLen
    let pnRes: Result[QuicPacketHeaderVarIntDecoded] = quicPacketNumberDecode(data, offset, pnLen)
    if IsErr(pnRes):
        return Err[QuicPacketHeaderDecoded](ErrorText(pnRes))
    let header: QuicPacketHeader = QuicPacketHeader(
        longHeader: false,
        packetType: QuicPacketShort,
        version: 0,
        dcid: dcid,
        scid: emptyBytes(),
        token: emptyBytes(),
        payloadLength: 0,
        packetNumber: Value(pnRes).value,
        packetNumberLen: pnLen,
        spinBit: spinBit,
        keyPhase: keyPhase
    )
    return Ok[QuicPacketHeaderDecoded](QuicPacketHeaderDecoded(header: header, next: Value(pnRes).next))
