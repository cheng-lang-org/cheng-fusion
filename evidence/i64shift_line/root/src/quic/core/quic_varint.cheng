# QUIC variable-length integers(RFC 9000).

import std/result
import std/rawbytes
import std/buffer as bytebuffer
const
    quicVarIntMax: int64 = 4611686018427387903

type
    QuicVarIntDecoded =
        value: int64
        next: int32

fn quicVarIntEncodedLen(value: int64): int32 =
    if value < 0:
        return 0
    if value <= 63:
        return 1
    if value <= 16383:
        return 2
    if value <= 1073741823:
        return 4
    if value <= quicVarIntMax:
        return 8
    return 0

fn quicVarIntEncode(value: int64): Result[Bytes] =
    let size: int32 = quicVarIntEncodedLen(value)
    if size <= 0:
        return Err[Bytes]("quic varint: value out of range")
    let out: Bytes = BytesAlloc(size)
    if size == 1:
        BytesSet(out, 0, int32(value))
        return Ok[Bytes](out)
    if size == 2:
        BytesSet(out, 0, 0x40 | int32((value >> 8) & 0x3f))
        BytesSet(out, 1, int32(value & 0xff))
        return Ok[Bytes](out)
    if size == 4:
        BytesSet(out, 0, 0x80 | int32((value >> 24) & 0x3f))
        BytesSet(out, 1, int32((value >> 16) & 0xff))
        BytesSet(out, 2, int32((value >> 8) & 0xff))
        BytesSet(out, 3, int32(value & 0xff))
        return Ok[Bytes](out)
    BytesSet(out, 0, 0xc0 | int32((value >> 56) & 0x3f))
    BytesSet(out, 1, int32((value >> 48) & 0xff))
    BytesSet(out, 2, int32((value >> 40) & 0xff))
    BytesSet(out, 3, int32((value >> 32) & 0xff))
    BytesSet(out, 4, int32((value >> 24) & 0xff))
    BytesSet(out, 5, int32((value >> 16) & 0xff))
    BytesSet(out, 6, int32((value >> 8) & 0xff))
    BytesSet(out, 7, int32(value & 0xff))
    return Ok[Bytes](out)

# Encode `value` directly into a caller-owned, presized buffer at `cursor`
# (no intermediate Bytes allocation). Returns the cursor advanced past the
# written varint. Same wire format / same range validation as quicVarIntEncode;
# callers that already know the total length (kind+streamId+offset+value+len+
# data, etc.) use this to build the whole frame in one BytesAlloc instead of
# allocating+copying+freeing one small Bytes per field.
# Writes through out's data pointer; does not consume the struct.
@borrows
fn quicVarIntWriteInto(out: Bytes, cursor: int32, value: int64): Result[int32] =
    let size: int32 = quicVarIntEncodedLen(value)
    if size <= 0:
        return Err[int32]("quic varint: value out of range")
    if size == 1:
        BytesSet(out, cursor, int32(value))
        return Ok[int32](cursor + 1)
    if size == 2:
        BytesSet(out, cursor, 0x40 | int32((value >> 8) & 0x3f))
        BytesSet(out, cursor + 1, int32(value & 0xff))
        return Ok[int32](cursor + 2)
    if size == 4:
        BytesSet(out, cursor, 0x80 | int32((value >> 24) & 0x3f))
        BytesSet(out, cursor + 1, int32((value >> 16) & 0xff))
        BytesSet(out, cursor + 2, int32((value >> 8) & 0xff))
        BytesSet(out, cursor + 3, int32(value & 0xff))
        return Ok[int32](cursor + 4)
    BytesSet(out, cursor, 0xc0 | int32((value >> 56) & 0x3f))
    BytesSet(out, cursor + 1, int32((value >> 48) & 0xff))
    BytesSet(out, cursor + 2, int32((value >> 40) & 0xff))
    BytesSet(out, cursor + 3, int32((value >> 32) & 0xff))
    BytesSet(out, cursor + 4, int32((value >> 24) & 0xff))
    BytesSet(out, cursor + 5, int32((value >> 16) & 0xff))
    BytesSet(out, cursor + 6, int32((value >> 8) & 0xff))
    BytesSet(out, cursor + 7, int32(value & 0xff))
    return Ok[int32](cursor + 8)

fn quicVarIntAppend(buf: var bytebuffer.GrowByteBuffer, value: int64): Result[bool] =
    let encRes: Result[Bytes] = quicVarIntEncode(value)
    if IsErr(encRes):
        return Err[bool](ErrorText(encRes))
    let enc: Bytes = Value(encRes)
    bytebuffer.AppendBytes(buf, enc)
    return Ok[bool](true)

@borrows
fn quicVarIntDecode(data: Bytes, offset: int32): Result[QuicVarIntDecoded] =
    if offset < 0:
        return Err[QuicVarIntDecoded]("quic varint: negative offset")
    if offset >= BytesLen(data):
        return Err[QuicVarIntDecoded]("quic varint: truncated input")
    let first: int32 = BytesGet(data, offset)
    let tag: int32 = first >> 6
    var size: int32 = 8
    if tag == 0:
        size = 1
    elif tag == 1:
        size = 2
    elif tag == 2:
        size = 4
    if offset + size > BytesLen(data):
        return Err[QuicVarIntDecoded]("quic varint: truncated input")
    var value: int64 = int64(first & 0x3f)
    for i in 1..<size:
        value = (value << 8) | int64(BytesGet(data, offset + i))
    return Ok[QuicVarIntDecoded](QuicVarIntDecoded(value: value, next: offset + size))
