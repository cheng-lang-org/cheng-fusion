import std/strutils as strutil
# MsQuic core common helpers(pure Cheng, in-process).

import std/result
import std/strings
type
    MsQuicCoreState = enum
        MsQuicCoreIdle = 0
        MsQuicCoreActive = 1
        MsQuicCoreClosing = 2

    MsQuicCoreDirection = enum
        MsQuicDirBidi = 0
        MsQuicDirUni = 1

    MsQuicCoreStatus = enum
        MsQuicOk = 0
        MsQuicError = 1

@importc("cheng_monotime_ns")
fn msquicCoreMonotimeNs(): int64

fn msquicCoreNowMs(): int64 =
    # Monotonic ms. sentAtMs stamped here is later compared as `nowMs - packet.sentAtMs`
    # by the retransmit RTO judge, whose nowMs is native_runtime MsQuicNativeNowMs =
    # cheng_monotime_ns/1e6. It MUST be the same clock domain, else the diff is a huge
    # negative constant and lost packets never re-fire (they stay pending until timeout).
    # Bind cheng_monotime_ns directly via @importc (the idiom native_runtime.cheng:28 uses);
    # std/times.monotimeNs() mis-binds to cheng_epoch_time_ms here and returns wall-clock ms.
    let ns: int64 = msquicCoreMonotimeNs()
    return ns / 1000000

fn msquicCoreClampInt32(value: int32, minVal: int32, maxVal: int32): int32 =
    var v: int32 = value
    if v < minVal:
        v = minVal
    if v > maxVal:
        v = maxVal
    return v

fn msquicCoreCheckRange(value: int32, minVal: int32, maxVal: int32, name: str): Result[bool] =
    if value < minVal || value > maxVal:
        let head: str = "msquic core: "
        let msg: str = strutil.Join([ share(head), name, " out of range"], "")
        return Err[bool](msg)
    return Ok[bool](true)
