module ip_purity_score

import std/result
import std/system
import std/strings
import cheng/ip_purity/score as purity

fn exampleHash(label: str): str =
    return strings.Sha256(label)

fn mustPrefix(res: Result[purity.IpPurityPrefixRecord]): purity.IpPurityPrefixRecord =
    assert(IsOk(res), "ip purity example: prefix")
    return Value(res)

fn buildExampleDataset(): purity.IpPurityDataset =
    var prefixes: purity.IpPurityPrefixRecord[]
    add(prefixes, mustPrefix(purity.IpPurityMakeCidrPrefix(
        "67.103.168.0",
        21,
        20115,
        "US",
        875,
        125,
        0,
        -8,
        "example:caller-supplied-cidr-source",
        exampleHash("charter-67-103-168-21")
    )))

    var asns: purity.IpPurityAsnRecord[]
    add(asns, purity.IpPurityAsnRecord(
        asn: 20115,
        organization: "Charter Communications LLC",
        networkClass: purity.IpNetworkResidential,
        origin: purity.IpOriginNative,
        riskPrior: -6,
        source: "example:caller-supplied-asn-source",
        evidenceHash: exampleHash("asn-20115")
    ))

    var raw: purity.IpPurityDataset
    raw.generatedDay = 19730
    raw.maxEventAgeDays = 180
    raw.eventHalfLifeDays = 30
    raw.sourceSnapshotHash = exampleHash("example source snapshot")
    raw.prefixes = prefixes
    raw.asns = asns
    let finalized = purity.IpPurityFinalizeDataset(raw)
    assert(IsOk(finalized), "ip purity example: finalize dataset")
    return Value(finalized)

fn main(): int32 =
    let dataset = buildExampleDataset()
    let resultRes = purity.IpPurityScoreIpText(dataset, "67.103.169.151", 20115, 19730)
    assert(IsOk(resultRes), "ip purity example: score")
    let result = Value(resultRes)
    echo(Fmt"ip={result.ipText}")
    echo(Fmt"asn={result.asn}")
    echo(Fmt"risk_score={result.riskScore}")
    echo(Fmt"purity_score={result.purityScore}")
    echo(Fmt"band={result.band}")
    echo(Fmt"dataset_hash={result.datasetHash}")
    echo(Fmt"reason_hash={result.reasonHash}")
    return 0
