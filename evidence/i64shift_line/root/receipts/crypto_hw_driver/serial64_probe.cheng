# Probe: 4096B LCG pattern digest — bulk-path correctness + timing.
import std/crypto/sha256
import std/rawbytes
import std/strings
import std/os

@importc("cheng_monotime_ns")
fn monoNs(): int64

fn fillLcg(buf: rawbytes.Bytes, n: int32) =
    var seed: int32 = 123456789
    var i: int32 = 0
    while i < n:
        seed = (seed * 1103515245 + 12345) & 2147483647
        rawbytes.BytesSet(buf, i, (seed >> 16) & 255)
        i = i + 1

fn main(): int32 =
    var msg: rawbytes.Bytes = rawbytes.BytesAlloc(4096)
    fillLcg(msg, 4096)

    # correctness of the bulk path (4096B = exactly one serial64 call)
    var digest: rawbytes.Bytes = sha256.Sha256Digest(msg)
    let hex: str = rawbytes.BytesToHex(digest)
    os.WriteLine(os.Get_stdout(), "digest4096=" + hex)
    if hex == "83f91a1108596afbd284247ea2d5ecb72a1761a013392d9fe340426d7a56e124":
        os.WriteLine(os.Get_stdout(), "BULK_KAT_PASS")
    else:
        os.WriteLine(os.Get_stdout(), "BULK_KAT_FAIL")

    # timing: 4096B x 20000 = 80MiB through Sha256Digest
    let t0: int64 = monoNs()
    var r: int32 = 0
    while r < 20000:
        rawbytes.BytesFree(sha256.Sha256Digest(msg))
        r = r + 1
    let dtNs: int64 = monoNs() - t0
    let mbs: int64 = (int64(20000) * 4096 * int64(1000)) / (dtNs / int64(1000))
    os.WriteLine(os.Get_stdout(), "rate_MB_s=" + strings.Int64ToStr(mbs / int64(1000)))
    return 0
