# bootstrap manifest —— codegen plugin: aarch64 草案
# DRAFT: 未过 ci_gate
#
# Step 2 草案：aarch64 代码生成单元 = 计划「插件面」表 aarch64 行文件 + 从
# min_driver_manifest 移入的 backend_aarch64_encode_source。依赖的内核/
# shared-format 项只声明，不重复列条目。
# 缺位说明：aarch64 无独立 body_emit 与对象 writer 文件（计划风险 #2），
# 发射逻辑散在中立层、darwin-arm64 走内核 macho_object_writer；Step0 裁定后
# 若拆分出新文件，回填本清单并同步 codegen_contract 的 TODO 签名。

# Step 4 取件接线（设计卷 step4-fetch-design-20260827 §5.1）：manifest 只声明
# 事实（triple + 源集），不钉 CID 字面量——静态字面量随源演进必腐坏；信任来自
# 字节门+provenance，组合根每次现场重派生闭包（CsgPluginPickupDeriveSourceClosureHash）。
composition_schema = cheng.composition.v1
composition_kind = plugin
kernel_manifest = bootstrap/kernel_manifest.cheng
compiler_entry_source = src/core/tooling/compiler_composition_aarch64_main.cheng
plugin_canonical_triple = arm64-apple-darwin    # PLUGIN_TARGET 语义的 manifest 化

backend_aarch64_encode_source = src/core/backend/aarch64_encode.cheng              # arch/编码器（自 min_driver_manifest 移入；80 公开 fn + 寄存器/条件码 const）
backend_regalloc_aarch64_adapter_source = src/core/backend/regalloc_aarch64_adapter.cheng  # arch/regalloc adapter + recipe carrier 类型权威（x86_64/riscv adapter 经 carrier 别名引用其记录类型，见契约要素4 TODO）
backend_codegen_a64_fill_units_source = src/core/backend/codegen_a64_fill_units.cheng  # arch/B6 迁出接收单元（tsv: aarch64；34 fns verbatim 自 aarch64_encode 迁出：B6a runtime-bridge 簇 + B6b 纯 fill fns + B6d FillSpAdd/FillFrameRestore/CondArm64TrueCode/Emit 字助手；内核经 codegen_a64_body_units 门面到达）
backend_darwin_syscall_provider_source = src/core/backend/darwin_syscall_provider.cheng  # arch/B9 归属（2026-08-29 补入，此前 Step0 覆盖缺口）；Darwin arm64 syscall/atomic shim 提供者对象写出器，import aarch64_encode；内核与 driver 经 codegen_darwin_provider_units 门面消费

# ---- 依赖的内核/shared-format 项（声明于 kernel_manifest.cheng，不在此重复）----
# cheng/core/ir/core_types、body_ir_access、lang/typed_expr、regalloc_single_pass、regalloc_production_encoder_events、
# std/bytes_layout、object_model（writer 面待 Step0）、codegen_contract.cheng（Step1 接线后唯一耦合面）。
