# bootstrap manifest —— codegen plugin: riscv64 草案
# DRAFT: 未过 ci_gate
#
# Step 2 草案：riscv64 代码生成单元 = 计划「插件面」表 riscv64 行全部文件。
# min_driver_manifest 中无 riscv64 专属条目，本清单条目全部为新增收录。
# 缺位说明：riscv64 无独立 body_emit 文件，机器字经 regalloc adapter 的
# action recipe 路径产出（等价关系在 codegen_contract 要素3 显式化，待 Step0）。

# Step 4 取件接线（设计卷 step4-fetch-design-20260827 §5.1）：manifest 只声明
# 事实（triple + 源集），不钉 CID 字面量——静态字面量随源演进必腐坏；信任来自
# 字节门+provenance，组合根每次现场重派生闭包（CsgPluginPickupDeriveSourceClosureHash）。
composition_schema = cheng.composition.v1
composition_kind = plugin
kernel_manifest = bootstrap/kernel_manifest.cheng
compiler_entry_source = src/core/tooling/compiler_composition_riscv64_main.cheng
plugin_canonical_triple = riscv64-unknown-linux-gnu    # PLUGIN_TARGET 语义的 manifest 化

backend_riscv64_encode_source = src/core/backend/riscv64_encode.cheng          # arch/编码器（XLEN 参数化家族；backend2_assemble/regalloc 生产链现直接 import，Step1 契约路由）
backend_elf_riscv64_writer_source = src/core/backend/elf_riscv64_writer.cheng  # arch/ELF 对象 writer（direct_object_emit 现直接 import，Step1 契约路由）
backend_elf_riscv64_linker_source = src/core/backend/elf_riscv64_linker.cheng  # arch/ELF 链接入口 ElfRiscv64LinkExe（native_link_exec 现直接 import，Step1 契约路由）
backend_regalloc_riscv_adapter_source = src/core/backend/regalloc_riscv_adapter.cheng  # arch/regalloc adapter（含 CFG-edge/action CSR 校验入口）
backend_regalloc_production_encoder_events_source = src/core/backend/regalloc_production_encoder_events.cheng  # arch/riscv 编码器事件重放（tsv B3 裁定 2026-08-25：28/28 rv.* 整体迁 riscv64 单元，无中立混居；carrier 两类型收口 codegen_contract，内核经 codegen_encoder_event_units 门面直调）

# ---- 依赖的内核/shared-format 项（声明于 kernel_manifest.cheng，不在此重复）----
# cheng/core/ir/core_types、body_ir_access、lang/typed_expr、regalloc_single_pass、
# regalloc_aarch64_adapter 的 recipe/carrier 记录类型（归属上收见契约要素4 TODO）、std/bytes_layout、
# object_buffer / object_symbols / object_relocs / tooling/path、codegen_contract.cheng（Step1 接线后唯一耦合面）。
