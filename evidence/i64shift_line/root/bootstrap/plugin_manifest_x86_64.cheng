# bootstrap manifest —— codegen plugin: x86_64 草案
# DRAFT: 未过 ci_gate
#
# Step 2 草案：x86_64 代码生成单元 = 计划「插件面」表 x86_64 行全部文件。
# min_driver_manifest 中无 x86_64 专属条目（该清单目标为 arm64-darwin），
# 故本清单条目全部为新增收录，与 kernel_manifest.cheng 组合成 per-triple 驱动。
# 依赖的内核/shared-format 项只在本头注声明，不重复列条目（组合时以
# kernel_manifest 为准，避免同一源文件双份编译）。

# Step 4 取件接线（设计卷 step4-fetch-design-20260827 §5.1）：manifest 只声明
# 事实（triple + 源集），不钉 CID 字面量——静态字面量随源演进必腐坏；信任来自
# 字节门+provenance，组合根每次现场重派生闭包（CsgPluginPickupDeriveSourceClosureHash）。
composition_schema = cheng.composition.v1
composition_kind = plugin
kernel_manifest = bootstrap/kernel_manifest.cheng
compiler_entry_source = src/core/tooling/compiler_composition_x86_64_main.cheng
plugin_canonical_triple = x86_64-unknown-linux-gnu    # PLUGIN_TARGET 语义的 manifest 化

backend_x86_64_encode_source = src/core/backend/x86_64_encode.cheng            # arch/编码器（计划插件面收录；实测 45 fn 全小写私有且零导入方，Step0 复核项，见契约要素2 TODO）
backend_x86_64_body_emit_source = src/core/backend/x86_64_body_emit.cheng      # arch/body 发射器（中立层现直接 import 本文件，Step1 改经 codegen_contract）
backend_elf_x86_64_writer_source = src/core/backend/elf_x86_64_writer.cheng    # arch/ELF 对象 writer（direct_object_emit 现直接 import，Step1 契约路由）
backend_coff_x86_64_writer_source = src/core/backend/coff_x86_64_writer.cheng  # arch/COFF 对象 writer（当前仅 tests 消费；随单元整体并入）
backend_regalloc_x86_64_adapter_source = src/core/backend/regalloc_x86_64_adapter.cheng  # arch/regalloc adapter（regalloc_production_emitter 现直接 import，Step1 契约路由）

# ---- 依赖的内核/shared-format 项（声明于 kernel_manifest.cheng，不在此重复）----
# cheng/core/ir/core_types（BodyIR/CallOp）、cheng/core/backend/regalloc_single_pass（canonical allocator plan）、
# object_buffer / object_symbols / object_relocs / rawbytes（对象模型）、macho_object_writer（shared-format 候选，Step0 归属待判）、
# codegen_contract.cheng（Step1 接线后为本单元唯一内核耦合面）。
