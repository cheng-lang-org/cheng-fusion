# bootstrap manifest —— kernel-only composition
#
# Step 2 草案：从 bootstrap/min_driver_manifest.cheng（实测 33 行 = 1 注释 +
# 1 空行 + 31 条目）裁剪。剔除全部 arch 专属项，保留 kernel + shared-format。
# 行尾注释为归属依据；被剔除条目以注释形式留在文件尾部并注明剔除理由与去向。
# 本阶段只新增本草案文件，不改任何既有 import/语义；组合构建脚本属后续步骤。
#
# 对账口径见文件尾「对账」段。

composition_schema = cheng.composition.v1
composition_kind = kernel-only
compiler_entry_source = src/core/tooling/compiler_composition_kernel_main.cheng    # production root；经 compiler_main held-exec authority
compiler_main_source = src/core/tooling/compiler_main.cheng                         # production held-exec parent/child authority
composition_manifest_source = src/core/tooling/composition_manifest.cheng           # --composition-manifest 精确闭包门与回执
compiler_runtime_source = src/core/tooling/compiler_runtime.cheng                   # keep/kernel 入口运行时
compiler_support_matrix_source = src/core/tooling/support_matrix.cheng              # keep/kernel 支持矩阵
compiler_request_source = src/core/tooling/compiler_request.cheng                   # keep/kernel 请求面
lang_parser_source = src/core/lang/parser.cheng                                     # keep/kernel 前端
lang_typed_expr_source = src/core/lang/typed_expr.cheng                             # keep/kernel 前端语义
core_ir_types_source = src/core/ir/core_types.cheng                                 # keep/kernel 中端（BodyIR 等 DOD 类型权威）
