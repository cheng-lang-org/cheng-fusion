backend_system_link_plan_source = src/core/backend/system_link_plan.cheng           # keep/kernel 系统链接计划
backend_lowering_plan_source = src/core/backend/lowering_plan.cheng                 # keep/kernel 中立 lowering（内埋 arch 分叉=计划风险#1，Step0 结构化拆分）
backend_codegen_contract_source = src/core/backend/codegen_contract.cheng          # keep/kernel 唯一耦合面（B0 已承载 regalloc 生产 carrier）
backend_codegen_writer_units_source = src/core/backend/codegen_writer_units.cheng  # keep/shared-format B2 writer/linker unit 直连门面（tsv: shared-format；doe/nle/noep 经此直抵各 arch writer，cf coff_object_linker arch 钩子先例）
backend_codegen_encoder_event_units_source = src/core/backend/codegen_encoder_event_units.cheng  # keep/shared-format B3 编码器事件 unit 直连门面（tsv: shared-format；内核经此直调 riscv64 事件回放/校验）
backend_codegen_x64_body_units_source = src/core/backend/codegen_x64_body_units.cheng  # keep/shared-format B4 x86_64 body 布局/sizing unit 直连门面（tsv: shared-format；pop 经此直抵 x86_64_body_emit 布局入口）
backend_codegen_a64_body_units_source = src/core/backend/codegen_a64_body_units.cheng  # keep/shared-format B6 aarch64 body unit 直连门面（tsv: shared-format；编码原语 re-export + 迁出簇 slots，pop 经此清 aarch64_encode 直依）
backend_primary_object_plan_source = src/core/backend/primary_object_plan.cheng     # keep/kernel 中立对象计划（arch 直依已清：x86_64/aarch64 经 codegen_*_units 门面、regalloc 经 codegen_contract，B0-B7 后 closure direct_violations=0）
backend_direct_object_emit_source = src/core/backend/direct_object_emit.cheng       # keep/kernel 直发对象（现 import elf_x86_64/elf_riscv64 writer，Step1 改经契约路由）
backend_object_buffer_source = src/core/backend/object_buffer.cheng                 # keep/kernel 对象模型（插件依赖的中立面）
backend_object_symbols_source = src/core/backend/object_symbols.cheng               # keep/kernel 对象模型（writer 契约签名引用）
backend_object_relocs_source = src/core/backend/object_relocs.cheng                 # keep/kernel 对象模型（writer 契约签名引用）
backend_macho_object_writer_source = src/core/backend/macho_object_writer.cheng     # keep/shared-format 候选（计划列为共享格式层，Step0 归属待判；暂归内核以保证与 min_driver 不重不漏）
backend_object_plan_source = src/core/backend/object_plan.cheng                     # keep/kernel 对象计划
backend_native_link_plan_source = src/core/backend/native_link_plan.cheng           # keep/kernel 本地链接计划
