_codex() {
  local cur=${COMP_WORDS[COMP_CWORD]}
  local prev=${COMP_WORDS[COMP_CWORD-1]}
  local opts="--model -m --cwd -C --cd --profile -p --config -c --color --json --ask-for-approval -a --search --no-alt-screen --dangerously-bypass-approvals-and-sandbox --resume --skip-git-repo-check --help -h"
  COMPREPLY=($(compgen -W "$opts" -- "$cur"))
}
complete -F _codex codex

