{"jsonrpc":"2.0","id":2,"result":{"tools":[{"name":"rust_csg_status","title":"Rust CSG Status","description":"Report the current codex MCP server status.","inputSchema":{"type":"object","properties":{},"additionalProperties":false}},{"name":"rust_csg_capabilities","title":"Rust CSG Capabilities","description":"Report the MCP methods, tools, and resources currently implemented by codex.","inputSchema":{"type":"object","properties":{},"additionalProperties":false}},{"name":"rust_csg_package","title":"Rust CSG Package","description":"Report the codex Cheng package identity exposed by this MCP server.","inputSchema":{"type":"object","properties":{},"additionalProperties":false}},{"name":"rust_csg_inventory","title":"Rust CSG Inventory","description":"Report the current codex source inventory facts exposed by this MCP server.","inputSchema":{"type":"object","properties":{},"additionalProperties":false}},{"name":"codex","title":"Codex","description":"Run a Codex session. Accepts configuration parameters matching the Codex Config struct.","inputSchema":{"additionalProperties":false,"properties":{"approval-policy":{"description":"Approval policy for shell commands generated by the model: `untrusted`, `on-failure`, `on-request`, `never`.","enum":["untrusted","on-failure","on-request","never"],"type":"string"},"base-instructions":{"description":"The set of instructions to use instead of the default ones.","type":"string"},"compact-prompt":{"description":"Prompt used when compacting the conversation.","type":"string"},"config":{"additionalProperties":true,"description":"Individual config settings that will override what is in CODEX_HOME/config.toml.","type":"object"},"cwd":{"description":"Working directory for the session. If relative, it is resolved against the server process's current working directory.","type":"string"},"developer-instructions":{"description":"Developer instructions that should be injected as a developer role message.","type":"string"},"model":{"description":"Optional override for the model name (e.g. 'gpt-5.2', 'gpt-5.2-codex').","type":"string"},"prompt":{"description":"The *initial user prompt* to start the Codex conversation.","type":"string"},"sandbox":{"description":"Sandbox mode: `read-only`, `workspace-write`, or `danger-full-access`.","enum":["read-only","workspace-write","danger-full-access"],"type":"string"}},"required":["prompt"],"type":"object"},"outputSchema":{"type":"object","properties":{"content":{"type":"string"},"threadId":{"type":"string"}},"required":["threadId","content"]}},{"name":"codex-reply","title":"Codex Reply","description":"Continue a Codex conversation by providing the thread id and prompt.","inputSchema":{"type":"object","properties":{"conversationId":{"description":"DEPRECATED: use threadId instead.","type":"string"},"prompt":{"description":"The *next user prompt* to continue the Codex conversation.","type":"string"},"threadId":{"description":"The thread id for this Codex session. This field is required, but we keep it optional here for backward compatibility for clients that still use conversationId.","type":"string"}},"required":["prompt"],"type":"object"},"outputSchema":{"type":"object","properties":{"content":{"type":"string"},"threadId":{"type":"string"}},"required":["threadId","content"]}},{"name":"exec_approval","title":"Exec Approval","description":"Review and approve command execution.","inputSchema":{"type":"object","properties":{"command":{"type":"string"},"cwd":{"type":"string"}},"required":["command","cwd"],"additionalProperties":false}},{"name":"patch_approval","title":"Patch Approval","description":"Review and approve file patch application.","inputSchema":{"type":"object","properties":{"changes":{"type":"object"}},"required":["changes"],"additionalProperties":false}},{"name":"codex/health","title":"Codex Health","description":"Check app-server health status.","inputSchema":{"type":"object","properties":{},"additionalProperties":false}},{"name":"completion/chat","title":"Completion Chat","description":"Send a chat completion request to the app-server.","inputSchema":{"type":"object","properties":{"messages":{"type":"array","items":{"type":"object","properties":{"role":{"type":"string"},"content":{"type":"string"}}}},"model":{"type":"string"}},"required":["messages"],"additionalProperties":false}},{"name":"embedding/create","title":"Embedding Create","description":"Create an embedding vector for the given input text.","inputSchema":{"type":"object","properties":{"input":{"type":"string"},"model":{"type":"string"}},"required":["input"],"additionalProperties":false}},{"name":"image/generate","title":"Image Generate","description":"Generate an image from a text prompt.","inputSchema":{"type":"object","properties":{"prompt":{"type":"string"},"size":{"type":"string"}},"required":["prompt"],"additionalProperties":false}}]}}