import std/strings
import std/strutils as strutil
import cheng/codex/config/home
import cheng/codex/core/text
import cheng/codex/protocol/types
import cheng/codex/protocol/wire

@abi_internal
@importc("WalkDirRec")
fn RustCsgInventoryWalkDirRec(path: str): str[]

const
    RustCsgSourceRoot: str = "/Users/lbcheng/codex-lbcheng"
    RustCsgCodexRsRoot: str = "/Users/lbcheng/codex-lbcheng/codex-rs"
    RustCsgExpectedCargoMembers: int32 = 87
    RustCsgExpectedRustFiles: int32 = 1403
    RustCsgExpectedTypeScriptFiles: int32 = 425
    RustCsgExpectedTuiSnapshots: int32 = 85
    RustCsgExpectedTuiRecursiveSnapshots: int32 = 327
    RustCsgExpectedTuiFrames: int32 = 360
    RustCsgExpectedProductPackageJson: int32 = 4

fn RustCsgPathUnder(path: str, prefix: str): bool =
    if path == prefix:
        return true
    return strutil.StartsWith(path, strutil.Join([prefix, "/"], ""))

fn RustCsgPathContains(path: str, needle: str): bool =
    let n = strings.Len(path)
    let m = strings.Len(needle)
    if m == 0:
        return true
    if m > n:
        return false
    var i: int32
    while i <= n - m:
        var j: int32
        var matched = true
        while j < m:
            if path[i + j] != needle[j]:
                matched = false
                break
            j = j + 1
        if matched:
            return true
        i = i + 1
    return false

fn RustCsgSkipVendoredPackageJson(path: str): bool =
    if RustCsgPathContains(path, "/node_modules/"):
        return true
    if RustCsgPathContains(path, "/target/"):
        return true
    if RustCsgPathContains(path, "/.cargo-home/"):
        return true
    if RustCsgPathContains(path, "/codex-rs/.cargo/"):
        return true
    return false

fn RustCsgCountCargoMembers(cargoTomlPath: str): int32 =
    let members = RustCsgCollectCargoMembers(cargoTomlPath)
    return int32(members.len)

fn RustCsgInventorySourceRoot(): str =
    let sourceRoot = home.RustCsgGetEnv("RUST_CSG_SOURCE_ROOT")
    if sourceRoot != "":
        return sourceRoot
    return RustCsgSourceRoot

fn RustCsgInventoryCodexRsRoot(sourceRoot: str): str =
    if strings.HasSuffix(sourceRoot, "/"):
        return strutil.Join([sourceRoot, "codex-rs"], "")
    return strutil.Join([sourceRoot, "/codex-rs"], "")

fn RustCsgCargoMemberLineName(lineRaw: str): str =
    let line = strutil.Strip(lineRaw)
    if line.len < 2:
        return ""
    if line[0] != '"':
        return ""
    var stop = line.len - 1
    if line[stop] == ',':
        stop = stop - 1
    if stop <= 0 || line[stop] != '"':
        return ""
    return strutil.SliceStr(line, 1, stop - 1)

fn RustCsgCollectCargoMembers(cargoTomlPath: str): str[] =
    let body = home.RustCsgReadFile(cargoTomlPath)
    let lines = strutil.Split(body, '\n')
    var out: str[]
    var inside: bool
    for i in 0..<lines.len:
        let line = strutil.Strip(lines[i])
        if line == "members = [":
            inside = true
            continue
        if inside && line == "]":
            break
        if inside:
            let name = RustCsgCargoMemberLineName(line)
            if name != "":
                add(out, name)
    return out

fn RustCsgCollectCargoMembersChecked(cargoTomlPath: str, outReason: var str): str[] =
    outReason = ""
    let body = home.RustCsgReadFile(cargoTomlPath)
    if body == "":
        outReason = strutil.Join(["cargo_toml_empty_or_unreadable=", cargoTomlPath], "")
        var empty: str[]
        return empty
    let lines = strutil.Split(body, '\n')
    var out: str[]
    var inside: bool
    var sawMembers: bool
    for i in 0..<lines.len:
        let line = strutil.Strip(lines[i])
        if line == "members = [":
            inside = true
            sawMembers = true
            continue
        if inside && line == "]":
            break
        if inside:
            let name = RustCsgCargoMemberLineName(line)
            if name != "":
                add(out, name)
    if !sawMembers:
        outReason = strutil.Join(["cargo_toml_members_missing=", cargoTomlPath], "")
    return out

