fn RustCsgStringSeqContainsExact(items: str[], needle: str): bool =
    for i in 0..<items.len:
        if items[i] == needle:
            return true
    return false

fn RustCsgCargoMembersOk(outReason: var str): bool =
    outReason = ""
    let expected = RustCsgExpectedCargoMembersList()
    let sourceRoot = RustCsgInventorySourceRoot()
    let cargoTomlPath = home.RustCsgPathJoinChild(
        RustCsgInventoryCodexRsRoot(sourceRoot),
        "Cargo.toml")
    let found = RustCsgCollectCargoMembersChecked(cargoTomlPath, outReason)
    if outReason != "":
        return false
    if found.len != expected.len:
        outReason = strutil.Join([
            "cargo_member_name_count=",
            RustCsgInt32Text(int32(found.len)),
            " expected=",
            RustCsgInt32Text(int32(expected.len))
        ], "")
        return false
    for i in 0..<found.len:
        for j in i + 1..<found.len:
            if found[i] == found[j]:
                outReason = strutil.Join(["duplicate_cargo_member=", found[i]], "")
                return false
        if found[i] != expected[i]:
            outReason = strutil.Join([
                "cargo_member[",
                RustCsgInt32Text(int32(i)),
                "]=",
                found[i],
                " expected=",
                expected[i]
            ], "")
            return false
        if !RustCsgStringSeqContainsExact(expected, found[i]):
            outReason = strutil.Join(["unknown_cargo_member=", found[i]], "")
            return false
    return true

fn RustCsgFillSourceStats(out: var types.RustCsgSourceStats) =
    out.cargoMemberCount = 0
    out.rustSourceFileCount = 0
    out.typeScriptFileCount = 0
    out.tuiSnapshotCount = 0
    out.tuiFrameCount = 0
    out.productPackageJsonCount = 0
    out.unknownRuntimeFileCount = 0
    let sourceRoot = RustCsgInventorySourceRoot()
    let codexRsRoot = RustCsgInventoryCodexRsRoot(sourceRoot)
    out.cargoMemberCount = RustCsgCountCargoMembers(home.RustCsgPathJoinChild(codexRsRoot, "Cargo.toml"))
    let codexRsFiles = RustCsgInventoryWalkDirRec(codexRsRoot)
    for i in 0..<codexRsFiles.len:
        let path = codexRsFiles[i]
        if text.RustCsgContains(path, "/target/"):
            continue
        if text.RustCsgContains(path, "/node_modules/"):
            continue
        if text.RustCsgContains(path, "/.cargo/"):
            continue
        if strings.HasSuffix(path, ".rs"):
            out.rustSourceFileCount = out.rustSourceFileCount + 1
        elif strings.HasSuffix(path, ".ts"):
            out.typeScriptFileCount = out.typeScriptFileCount + 1
        elif RustCsgPathUnder(path, home.RustCsgPathJoinChild(codexRsRoot, "tui/src/snapshots")) &&
             strings.HasSuffix(path, ".snap"):
            out.tuiSnapshotCount = out.tuiSnapshotCount + 1
        if RustCsgPathUnder(path, home.RustCsgPathJoinChild(codexRsRoot, "tui/frames")) &&
           strings.HasSuffix(path, ".txt"):
            out.tuiFrameCount = out.tuiFrameCount + 1
    let sourceFiles = RustCsgInventoryWalkDirRec(sourceRoot)
    for i in 0..<sourceFiles.len:
        let path = sourceFiles[i]
        if strings.HasSuffix(path, "package.json") && !RustCsgSkipVendoredPackageJson(path):
            out.productPackageJsonCount = out.productPackageJsonCount + 1

fn RustCsgCollectSourceStats(): types.RustCsgSourceStats =
    var out: types.RustCsgSourceStats
    RustCsgFillSourceStats(out)
    return out

fn RustCsgInventoryOk(stats: var types.RustCsgSourceStats, outReason: var str): bool =
    outReason = ""
    if stats.cargoMemberCount != RustCsgExpectedCargoMembers:
        outReason = strutil.Join(["cargo_member_count=", RustCsgInt32Text(stats.cargoMemberCount)], "")
        return false
    if stats.rustSourceFileCount != RustCsgExpectedRustFiles:
        outReason = strutil.Join(["rust_source_file_count=", RustCsgInt32Text(stats.rustSourceFileCount)], "")
        return false
    if stats.typeScriptFileCount != RustCsgExpectedTypeScriptFiles:
        outReason = strutil.Join(["typescript_file_count=", RustCsgInt32Text(stats.typeScriptFileCount)], "")
        return false
    if stats.tuiSnapshotCount != RustCsgExpectedTuiSnapshots:
        outReason = strutil.Join(["tui_snapshot_count=", RustCsgInt32Text(stats.tuiSnapshotCount)], "")
        return false
    if stats.tuiFrameCount != RustCsgExpectedTuiFrames:
        outReason = strutil.Join(["tui_frame_count=", RustCsgInt32Text(stats.tuiFrameCount)], "")
        return false
    if stats.productPackageJsonCount != RustCsgExpectedProductPackageJson:
        outReason = strutil.Join(["product_package_json_count=", RustCsgInt32Text(stats.productPackageJsonCount)], "")
        return false
    return true

fn RustCsgSourceInventoryOk(outReason: var str): bool =
    outReason = ""
    let sourceRoot = RustCsgInventorySourceRoot()
    let codexRsRoot = RustCsgInventoryCodexRsRoot(sourceRoot)
    let cargoMemberCount = RustCsgCountCargoMembers(home.RustCsgPathJoinChild(codexRsRoot, "Cargo.toml"))
    var rustSourceFileCount: int32
    var typeScriptFileCount: int32
    var tuiSnapshotCount: int32
    var tuiFrameCount: int32
    var productPackageJsonCount: int32
    let codexRsTargetRoot = strutil.Join([codexRsRoot, "/target"], "")
    let codexRsNodeModulesRoot = strutil.Join([codexRsRoot, "/node_modules"], "")
    let codexRsCargoRoot = strutil.Join([codexRsRoot, "/.cargo"], "")
    let codexRsFiles = RustCsgInventoryWalkDirRec(codexRsRoot)
    if codexRsFiles.len <= 0:
        outReason = strutil.Join(["codex_rs_walk_count=0 root=", codexRsRoot], "")
        return false
    for i in 0..<codexRsFiles.len:
        let path = codexRsFiles[i]
        if RustCsgPathUnder(path, codexRsTargetRoot):
            continue
        if RustCsgPathUnder(path, codexRsNodeModulesRoot):
            continue
        if RustCsgPathUnder(path, codexRsCargoRoot):
            continue
        if strings.HasSuffix(path, ".rs"):
            rustSourceFileCount = rustSourceFileCount + 1
        elif strings.HasSuffix(path, ".ts"):
            typeScriptFileCount = typeScriptFileCount + 1
        elif RustCsgPathUnder(path, home.RustCsgPathJoinChild(codexRsRoot, "tui/src/snapshots")) &&
             strings.HasSuffix(path, ".snap"):
            tuiSnapshotCount = tuiSnapshotCount + 1
        if RustCsgPathUnder(path, home.RustCsgPathJoinChild(codexRsRoot, "tui/frames")) &&
           strings.HasSuffix(path, ".txt"):
            tuiFrameCount = tuiFrameCount + 1
    let sourceFiles = RustCsgInventoryWalkDirRec(sourceRoot)
    for i in 0..<sourceFiles.len:
        let path = sourceFiles[i]
        if strings.HasSuffix(path, "package.json") && !RustCsgSkipVendoredPackageJson(path):
            productPackageJsonCount = productPackageJsonCount + 1
    if cargoMemberCount != RustCsgExpectedCargoMembers:
        outReason = strutil.Join(["cargo_member_count=", RustCsgInt32Text(cargoMemberCount)], "")
        return false
    if rustSourceFileCount != RustCsgExpectedRustFiles:
        outReason = strutil.Join(["rust_source_file_count=", RustCsgInt32Text(rustSourceFileCount)], "")
        return false
    if typeScriptFileCount != RustCsgExpectedTypeScriptFiles:
        outReason = strutil.Join(["typescript_file_count=", RustCsgInt32Text(typeScriptFileCount)], "")
        return false
    if tuiSnapshotCount != RustCsgExpectedTuiSnapshots:
        outReason = strutil.Join(["tui_snapshot_count=", RustCsgInt32Text(tuiSnapshotCount)], "")
        return false
    if tuiFrameCount != RustCsgExpectedTuiFrames:
        outReason = strutil.Join(["tui_frame_count=", RustCsgInt32Text(tuiFrameCount)], "")
        return false
    if productPackageJsonCount != RustCsgExpectedProductPackageJson:
        outReason = strutil.Join(["product_package_json_count=", RustCsgInt32Text(productPackageJsonCount)], "")
        return false
    return true

fn RustCsgCountTuiRecursiveSnapshots(sourceRoot: str, outReason: var str): int32 =
    outReason = ""
    let codexRsRoot = RustCsgInventoryCodexRsRoot(sourceRoot)
    let tuiRoot = home.RustCsgPathJoinChild(codexRsRoot, "tui")
    let files = RustCsgInventoryWalkDirRec(tuiRoot)
    if files.len <= 0:
        outReason = strutil.Join(["tui_recursive_walk_count=0 root=", tuiRoot], "")
        return -1
    let targetRoot = strutil.Join([tuiRoot, "/target"], "")
    let nodeModulesRoot = strutil.Join([tuiRoot, "/node_modules"], "")
    let cargoRoot = strutil.Join([tuiRoot, "/.cargo"], "")
    var count: int32
    for i in 0..<files.len:
        let path = files[i]
        if RustCsgPathUnder(path, targetRoot):
            continue
        if RustCsgPathUnder(path, nodeModulesRoot):
            continue
        if RustCsgPathUnder(path, cargoRoot):
            continue
        if strings.HasSuffix(path, ".snap"):
            count = count + 1
    if count <= 0:
        outReason = strutil.Join(["tui_recursive_snapshot_count=0 root=", tuiRoot], "")
        return -1
    return count

fn RustCsgTuiRecursiveSnapshotsOk(outReason: var str): bool =
    outReason = ""
    let count = RustCsgCountTuiRecursiveSnapshots(RustCsgInventorySourceRoot(), outReason)
    if outReason != "":
        return false
    if count != RustCsgExpectedTuiRecursiveSnapshots:
        outReason = strutil.Join(["tui_recursive_snapshot_count=", RustCsgInt32Text(count)], "")
        return false
    return true

fn RustCsgInt32Text(value: int32): str =
    return strings.Int64ToStr(int64(value))

fn RustCsgStatsText(stats: var types.RustCsgSourceStats): str =
    var out = wire.RustCsgCat("cargo_members=", RustCsgInt32Text(stats.cargoMemberCount))
    out = wire.RustCsgCat(out, "\nrust_files=")
    out = wire.RustCsgCat(out, RustCsgInt32Text(stats.rustSourceFileCount))
    out = wire.RustCsgCat(out, "\ntypescript_files=")
    out = wire.RustCsgCat(out, RustCsgInt32Text(stats.typeScriptFileCount))
    out = wire.RustCsgCat(out, "\ntui_snapshots=")
    out = wire.RustCsgCat(out, RustCsgInt32Text(stats.tuiSnapshotCount))
    out = wire.RustCsgCat(out, "\ntui_frames=")
    out = wire.RustCsgCat(out, RustCsgInt32Text(stats.tuiFrameCount))
    out = wire.RustCsgCat(out, "\nproduct_package_json=")
    out = wire.RustCsgCat(out, RustCsgInt32Text(stats.productPackageJsonCount))
    return out
