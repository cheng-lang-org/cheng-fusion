import std/strings

@importc("getenv")
fn keyringGetEnv(name: ptr): cstring
@importc("strlen")
fn keyringStrLen(p: ptr): int64
@importc("fopen")
fn keyringFopen(path: ptr, mode: ptr): ptr
@importc("fread")
fn keyringFread(buf: ptr, size: int64, count: int64, stream: ptr): int64
@importc("fseek")
fn keyringFseek(stream: ptr, offset: int64, whence: int32): int32
@importc("ftell")
fn keyringFtell(stream: ptr): int64
@importc("fwrite")
fn keyringFwrite(buf: ptr, size: int64, count: int64, stream: ptr): int64
@importc("fclose")
fn keyringFclose(stream: ptr): int32
@importc("mkdir")
fn keyringMkdir(path: ptr, mode: int64): int32
@importc("unlink")
fn keyringUnlink(path: ptr): int32
@importc("access")
fn keyringAccess(path: ptr, mode: int32): int32
@importc("calloc")
fn keyringCalloc(count: int64, size: int64): ptr
@importc("free")
fn keyringFree(p: ptr)
@importc("memcpy")
fn keyringMemcpy(dst: ptr, src: ptr, n: int64): ptr

fn keyringCString(text: str): ptr =
    let raw = keyringCalloc(int64(text.len) + int64(1), int64(1))
    if raw == nil:
        return nil
    if text.len > 0:
        keyringMemcpy(raw, text.data, int64(text.len))
    return raw

fn keyringStrFromCString(raw: ptr): str =
    if raw == nil:
        return ""
    let len64 = keyringStrLen(raw)
    if len64 <= int64(0) || len64 >= int64(2147483647):
        return ""
    var out: str
    out.data = raw
    out.len = int32(len64)
    return out

fn keyringEnv(name: str): str =
    let rawName = keyringCString(name)
    if rawName == nil:
        return ""
    let rawValue = keyringGetEnv(rawName)
    keyringFree(rawName)
    return keyringStrFromCString(rawValue)

fn keyringPathJoin(a: str, b: str): str =
    if a.len <= 0:
        return b
    if a[a.len - 1] == '/':
        return strings.ConcatStr(a, b)
    return strings.ConcatStr(strings.ConcatStr(a, "/"), b)

fn keyringStoreDir(): str =
    let codexHome = keyringEnv("CODEX_HOME")
    if codexHome.len > 0:
        return codexHome
    let home = keyringEnv("HOME")
    if home.len > 0:
        return keyringPathJoin(home, ".codex")
    return ""

fn keyringStorePath(): str =
    let dir = keyringStoreDir()
    if dir.len <= 0:
        return ""
    return keyringPathJoin(dir, "keyring_store.db")

fn keyringEnsureDir(): int32 =
    let dir = keyringStoreDir()
    if dir.len <= 0:
        return 0
    let rawDir = keyringCString(dir)
    if rawDir == nil:
        return 0
    keyringMkdir(rawDir, int64(448))
    keyringFree(rawDir)
    return 1

fn keyringFileExists(path: str): bool =
    let rawPath = keyringCString(path)
    if rawPath == nil:
        return false
    let ok = keyringAccess(rawPath, 0)
    keyringFree(rawPath)
    return ok == 0

fn keyringDeleteFile(path: str): int32 =
    let rawPath = keyringCString(path)
    if rawPath == nil:
        return 0
    let rc = keyringUnlink(rawPath)
    keyringFree(rawPath)
    if rc == 0:
        return 1
    return 1

fn keyringReadFile(path: str): str =
    let rawPath = keyringCString(path)
    let rawMode = keyringCString("rb")
    if rawPath == nil || rawMode == nil:
        if rawPath != nil:
            keyringFree(rawPath)
        if rawMode != nil:
            keyringFree(rawMode)
        return ""
    let stream = keyringFopen(rawPath, rawMode)
    keyringFree(rawPath)
    keyringFree(rawMode)
    if stream == nil:
        return ""
    if keyringFseek(stream, int64(0), 2) != 0:
        keyringFclose(stream)
        return ""
    let size = keyringFtell(stream)
    if size <= int64(0):
        keyringFclose(stream)
        return ""
    keyringFseek(stream, int64(0), 0)
    let buf = keyringCalloc(size + int64(1), int64(1))
    if buf == nil:
        keyringFclose(stream)
        return ""
    let n = keyringFread(buf, int64(1), size, stream)
    keyringFclose(stream)
    if n <= int64(0):
        keyringFree(buf)
        return ""
    var out: str
    out.data = buf
    out.len = int32(n)
    return out

fn keyringWriteFile(path: str, content: str): int32 =
    if keyringEnsureDir() == 0:
        return 0
    let rawPath = keyringCString(path)
    let rawMode = keyringCString("wb")
    if rawPath == nil || rawMode == nil:
        if rawPath != nil:
            keyringFree(rawPath)
        if rawMode != nil:
            keyringFree(rawMode)
        return 0
    let stream = keyringFopen(rawPath, rawMode)
    keyringFree(rawPath)
    keyringFree(rawMode)
    if stream == nil:
        return 0
    if content.len > 0:
        let n = keyringFwrite(content.data, int64(1), int64(content.len), stream)
        if n != int64(content.len):
            keyringFclose(stream)
            return 0
    keyringFclose(stream)
    return 1

fn keyringSafeName(name: str): bool =
    if name.len <= 0:
        return false
    var i: int32
    while i < name.len:
        let ch = name[i]
        let ok = (ch >= 'a' && ch <= 'z') ||
                 (ch >= 'A' && ch <= 'Z') ||
                 (ch >= '0' && ch <= '9') ||
                 ch == '_' || ch == '-' || ch == '.'
        if !ok:
            return false
        i = i + 1
    return true

fn keyringEntryDir(): str =
    return keyringPathJoin(keyringStoreDir(), "keyring_store")

fn keyringEnsureEntryDir(): int32 =
    if keyringEnsureDir() == 0:
        return 0
    let dir = keyringEntryDir()
    let rawDir = keyringCString(dir)
    if rawDir == nil:
        return 0
    keyringMkdir(rawDir, int64(448))
    keyringFree(rawDir)
    return 1

fn keyringEntryPath(service: str, key: str): str =
    return keyringPathJoin(keyringEntryDir(), strings.ConcatStr(strings.ConcatStr(service, "__"), key))

fn keyringServiceIndexPath(service: str): str =
    return keyringPathJoin(keyringEntryDir(), strings.ConcatStr(service, ".keys"))

fn keyringAppendFile(path: str, itemJson: str): int32 =
    let current = keyringReadFile(path)
    var next: str
    if current.len > 0:
        next = strings.ConcatStr(strings.ConcatStr(current, ","), itemJson)
    else:
        next = itemJson
    return keyringWriteFile(path, next)

fn keyringAppendExport(service: str, key: str, value: str): int32 =
    var entry = "{"
    entry = strings.ConcatStr(entry, strings.ConcatStr("\"service\":", keyringJsonQuote(service)))
    entry = strings.ConcatStr(entry, strings.ConcatStr(",\"key\":", keyringJsonQuote(key)))
    entry = strings.ConcatStr(entry, strings.ConcatStr(",\"value\":", keyringJsonQuote(value)))
    entry = strings.ConcatStr(entry, "}")
    return keyringAppendFile(keyringStorePath(), entry)

fn keyringSaveValue(service: str, key: str, value: str): int32 =
    if !keyringSafeName(service) || !keyringSafeName(key):
        return 0
    if keyringEnsureEntryDir() == 0:
        return 0
    let entryPath = keyringEntryPath(service, key)
    let existed = keyringFileExists(entryPath)
    if keyringWriteFile(entryPath, value) == 0:
        return 0
    if !existed:
        if keyringAppendFile(keyringServiceIndexPath(service), keyringJsonQuote(key)) == 0:
            return 0
    return keyringAppendExport(service, key, value)

fn keyringLoadValue(service: str, key: str, outValue: var str, outOk: var int32) =
    outValue = ""
    outOk = 0
    if !keyringSafeName(service) || !keyringSafeName(key):
        return
    let entryPath = keyringEntryPath(service, key)
    if !keyringFileExists(entryPath):
        return
    outValue = keyringReadFile(entryPath)
    outOk = 1

fn keyringDeleteValue(service: str, key: str): int32 =
    if !keyringSafeName(service) || !keyringSafeName(key):
        return 0
    return keyringDeleteFile(keyringEntryPath(service, key))

fn keyringJsonQuote(text: str): str =
    return strings.ConcatStr(strings.ConcatStr("\"", text), "\"")

@abi_internal
@exportc("RustCsgKeyringSave")
fn RustCsgKeyringSaveExport(service: str, key: str, value: str): int32 =
    return keyringSaveValue(service, key, value)

@abi_internal
@exportc("RustCsgKeyringLoad")
fn RustCsgKeyringLoadExport(service: str, key: str, outValue: var str, outOk: var int32) =
    keyringLoadValue(service, key, outValue, outOk)

@abi_internal
@exportc("RustCsgKeyringDelete")
fn RustCsgKeyringDeleteExport(service: str, key: str): int32 =
    return keyringDeleteValue(service, key)

@abi_internal
@exportc("RustCsgKeyringListKeys")
fn RustCsgKeyringListKeysExport(service: str): str =
    if !keyringSafeName(service):
        return "[]"
    let content = keyringReadFile(keyringServiceIndexPath(service))
    if content.len <= 0:
        return "[]"
    return strings.ConcatStr(strings.ConcatStr("[", content), "]")

@abi_internal
@exportc("RustCsgKeyringExport")
fn RustCsgKeyringExportExport(): str =
    let content = keyringReadFile(keyringStorePath())
    if content.len <= 0:
        return "[]"
    return strings.ConcatStr(strings.ConcatStr("[", content), "]")
