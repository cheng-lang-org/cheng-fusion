import std/strings

@importc("getenv")
fn secretsGetEnv(name: ptr): cstring
@importc("strlen")
fn secretsStrLen(p: ptr): int64
@importc("fopen")
fn secretsFopen(path: ptr, mode: ptr): ptr
@importc("fread")
fn secretsFread(buf: ptr, size: int64, count: int64, stream: ptr): int64
@importc("fseek")
fn secretsFseek(stream: ptr, offset: int64, whence: int32): int32
@importc("ftell")
fn secretsFtell(stream: ptr): int64
@importc("fwrite")
fn secretsFwrite(buf: ptr, size: int64, count: int64, stream: ptr): int64
@importc("fclose")
fn secretsFclose(stream: ptr): int32
@importc("mkdir")
fn secretsMkdir(path: ptr, mode: int64): int32
@importc("unlink")
fn secretsUnlink(path: ptr): int32
@importc("access")
fn secretsAccess(path: ptr, mode: int32): int32
@importc("calloc")
fn secretsCalloc(count: int64, size: int64): ptr
@importc("free")
fn secretsFree(p: ptr)
@importc("memcpy")
fn secretsMemcpy(dst: ptr, src: ptr, n: int64): ptr

fn secretsCString(text: str): ptr =
    let raw = secretsCalloc(int64(text.len) + int64(1), int64(1))
    if raw == nil:
        return nil
    if text.len > 0:
        secretsMemcpy(raw, text.data, int64(text.len))
    return raw

fn secretsStrFromCString(raw: ptr): str =
    if raw == nil:
        return ""
    let len64 = secretsStrLen(raw)
    if len64 <= int64(0) || len64 >= int64(2147483647):
        return ""
    var out: str
    out.data = raw
    out.len = int32(len64)
    return out

fn secretsEnv(name: str): str =
    let rawName = secretsCString(name)
    if rawName == nil:
        return ""
    let rawValue = secretsGetEnv(rawName)
    secretsFree(rawName)
    return secretsStrFromCString(rawValue)

fn secretsPathJoin(a: str, b: str): str =
    if a.len <= 0:
        return b
    if a[a.len - 1] == '/':
        return strings.ConcatStr(a, b)
    return strings.ConcatStr(strings.ConcatStr(a, "/"), b)

fn secretsStoreDir(): str =
    let codexHome = secretsEnv("CODEX_HOME")
    if codexHome.len > 0:
        return codexHome
    let home = secretsEnv("HOME")
    if home.len > 0:
        return secretsPathJoin(home, ".codex")
    return ""

fn secretsStorePath(): str =
    let dir = secretsStoreDir()
    if dir.len <= 0:
        return ""
    return secretsPathJoin(dir, "secrets.json")

fn secretsEnsureDir(): int32 =
    let dir = secretsStoreDir()
    if dir.len <= 0:
        return 0
    let rawDir = secretsCString(dir)
    if rawDir == nil:
        return 0
    secretsMkdir(rawDir, int64(448))
    secretsFree(rawDir)
    return 1

fn secretsFileExists(path: str): bool =
    let rawPath = secretsCString(path)
    if rawPath == nil:
        return false
    let ok = secretsAccess(rawPath, 0)
    secretsFree(rawPath)
    return ok == 0

fn secretsDeleteFile(path: str): int32 =
    let rawPath = secretsCString(path)
    if rawPath == nil:
        return 0
    let rc = secretsUnlink(rawPath)
    secretsFree(rawPath)
    if rc == 0:
        return 1
    return 1

fn secretsReadFile(path: str): str =
    let rawPath = secretsCString(path)
    let rawMode = secretsCString("rb")
    if rawPath == nil || rawMode == nil:
        if rawPath != nil:
            secretsFree(rawPath)
        if rawMode != nil:
            secretsFree(rawMode)
        return ""
    let stream = secretsFopen(rawPath, rawMode)
    secretsFree(rawPath)
    secretsFree(rawMode)
    if stream == nil:
        return ""
    if secretsFseek(stream, int64(0), 2) != 0:
        secretsFclose(stream)
        return ""
    let size = secretsFtell(stream)
    if size <= int64(0):
        secretsFclose(stream)
        return ""
    secretsFseek(stream, int64(0), 0)
    let buf = secretsCalloc(size + int64(1), int64(1))
    if buf == nil:
        secretsFclose(stream)
        return ""
    let n = secretsFread(buf, int64(1), size, stream)
    secretsFclose(stream)
    if n <= int64(0):
        secretsFree(buf)
        return ""
    var out: str
    out.data = buf
    out.len = int32(n)
    return out

fn secretsWriteFile(path: str, content: str): int32 =
    if secretsEnsureDir() == 0:
        return 0
    let rawPath = secretsCString(path)
    let rawMode = secretsCString("wb")
    if rawPath == nil || rawMode == nil:
        if rawPath != nil:
            secretsFree(rawPath)
        if rawMode != nil:
            secretsFree(rawMode)
        return 0
    let stream = secretsFopen(rawPath, rawMode)
    secretsFree(rawPath)
    secretsFree(rawMode)
    if stream == nil:
        return 0
    if content.len > 0:
        let n = secretsFwrite(content.data, int64(1), int64(content.len), stream)
        if n != int64(content.len):
            secretsFclose(stream)
            return 0
    secretsFclose(stream)
    return 1

fn secretsSafeName(name: str): bool =
    if name.len <= 0:
        return false
    var i: int32
    while i < name.len:
        let ch = name[i]
        let ok = (ch >= 'a' && ch <= 'z') ||
                 (ch >= 'A' && ch <= 'Z') ||
                 (ch >= '0' && ch <= '9') ||
                 ch == '_' || ch == '-' || ch == '.'
        if !ok:
            return false
        i = i + 1
    return true

fn secretsEntryDir(): str =
    return secretsPathJoin(secretsStoreDir(), "secrets_store")

fn secretsEnsureEntryDir(): int32 =
    if secretsEnsureDir() == 0:
        return 0
    let dir = secretsEntryDir()
    let rawDir = secretsCString(dir)
    if rawDir == nil:
        return 0
    secretsMkdir(rawDir, int64(448))
    secretsFree(rawDir)
    return 1

fn secretsEntryPath(name: str): str =
    return secretsPathJoin(secretsEntryDir(), name)

fn secretsAppendIndex(name: str): int32 =
    let path = secretsStorePath()
    let current = secretsReadFile(path)
    let quoted = secretsJsonQuote(name)
    var next: str
    if current.len > 0:
        next = strings.ConcatStr(strings.ConcatStr(current, ","), quoted)
    else:
        next = quoted
    return secretsWriteFile(path, next)

fn secretsSetValue(name: str, value: str): int32 =
    if !secretsSafeName(name):
        return 0
    if secretsEnsureEntryDir() == 0:
        return 0
    let entryPath = secretsEntryPath(name)
    let existed = secretsFileExists(entryPath)
    if secretsWriteFile(entryPath, value) == 0:
        return 0
    if !existed:
        return secretsAppendIndex(name)
    return 1

fn secretsGetValue(name: str, outValue: var str, outOk: var int32) =
    outValue = ""
    outOk = 0
    if !secretsSafeName(name):
        return
    let entryPath = secretsEntryPath(name)
    if !secretsFileExists(entryPath):
        return
    outValue = secretsReadFile(entryPath)
    outOk = 1

fn secretsDeleteValue(name: str): int32 =
    if !secretsSafeName(name):
        return 0
    return secretsDeleteFile(secretsEntryPath(name))

fn secretsJsonQuote(text: str): str =
    return strings.ConcatStr(strings.ConcatStr("\"", text), "\"")

@abi_internal
@exportc("RustCsgSecretSet")
fn RustCsgSecretSetExport(name: str, value: str): int32 =
    return secretsSetValue(name, value)

@abi_internal
@exportc("RustCsgSecretGet")
fn RustCsgSecretGetExport(name: str, outValue: var str, outOk: var int32) =
    secretsGetValue(name, outValue, outOk)

@abi_internal
@exportc("RustCsgSecretDelete")
fn RustCsgSecretDeleteExport(name: str): int32 =
    return secretsDeleteValue(name)

@abi_internal
@exportc("RustCsgSecretRotate")
fn RustCsgSecretRotateExport(name: str, newValue: str): int32 =
    var oldValue: str
    var ok: int32
    secretsGetValue(name, oldValue, ok)
    if ok == 0:
        return 0
    if secretsSetValue(strings.ConcatStr(name, ".previous"), oldValue) == 0:
        return 0
    return secretsSetValue(name, newValue)

@abi_internal
@exportc("RustCsgSecretList")
fn RustCsgSecretListExport(): str =
    let content = secretsReadFile(secretsStorePath())
    if content.len <= 0:
        return "[]"
    return strings.ConcatStr(strings.ConcatStr("[", content), "]")
