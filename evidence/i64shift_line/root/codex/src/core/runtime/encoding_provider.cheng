# Pure Cheng base64 encoding + UUID v4 provider.

# Builtins from cold compiler syscall provider
@importc("cheng_malloc")
fn rawMalloc(size: int64): ptr
@importc("cheng_fopen")
fn rawFopen(path: ptr, mode: ptr): int32
@importc("cheng_fread")
fn rawFread(fd: int32, buf: ptr, size: int64): int64
@importc("cheng_fclose")
fn rawFclose(fd: int32): int32
@importc("cheng_fwrite")
fn rawFwrite(fd: int32, buf: ptr, size: int64): int64
@importc("calloc")
fn encodingCalloc(count: int64, size: int64): ptr
@importc("memcpy")
fn encodingMemcpy(dst: ptr, src: ptr, n: int64): ptr
@importc("CC_SHA256")
fn encodingCCSha256(data: ptr, len: uint32, md: ptr): ptr
@importc("arc4random_buf")
fn encodingArc4RandomBuf(buf: ptr, len: int64)
@importc("ptr_add")
fn encodingPtrAddRaw(p: ptr, off: int32): ptr
@importc("cheng_rawmem_write_i8")
fn encodingWriteI8Raw(dst: ptr, idx: int32, v: int8)

type
    EncodingUInt8Ptr = uint8 *

const BASE64_CHARS: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

fn encodingPtrAdd(p: ptr, off: int32): ptr =
    return encodingPtrAddRaw(p, off)

fn encodingWriteByte(raw: ptr, index: int32, value: int32) =
    encodingWriteI8Raw(raw, index, int8(value & 255))

fn encodingConcat(a: str, b: str): str =
    let lenA: int32 = a.len
    let lenB: int32 = b.len
    let total: int32 = lenA + lenB
    if total <= 0:
        return ""
    let raw = encodingCalloc(int64(total) + int64(1), int64(1))
    if raw == nil:
        return ""
    if lenA > 0 && a.data != nil:
        encodingMemcpy(raw, a.data, int64(lenA))
    if lenB > 0 && b.data != nil:
        encodingMemcpy(encodingPtrAdd(raw, lenA), b.data, int64(lenB))
    var out: str
    out.data = raw
    out.len = total
    return out

fn encodingSliceBytes(text: str, start: int32, count: int32): str =
    if text.data == nil || text.len <= 0 || count <= 0:
        return ""
    var start0: int32 = start
    if start0 < 0:
        start0 = 0
    if start0 >= text.len:
        return ""
    var kept: int32 = count
    if start0 + kept > text.len:
        kept = text.len - start0
    if kept <= 0:
        return ""
    var out: str
    out.data = encodingPtrAdd(text.data, start0)
    out.len = kept
    return out

fn encodingHexNibble(value: int32): str =
    let table: str = "0123456789ABCDEF"
    return encodingSliceBytes(table, value & 15, 1)

fn encodingHexNibbleLower(value: int32): str =
    let table: str = "0123456789abcdef"
    return encodingSliceBytes(table, value & 15, 1)

fn encodingReadByte(raw: ptr, index: int32): int32 =
    return int32(*(EncodingUInt8Ptr(encodingPtrAdd(raw, index)))) & 255

fn encodingAppendUuidByte(out: var str, value: int32) =
    out = encodingConcat(out, encodingHexNibbleLower((value >> 4) & 15))
    out = encodingConcat(out, encodingHexNibbleLower(value & 15))

fn encodingIsUrlUnreserved(ch: char): bool =
    if ch >= 'A' && ch <= 'Z':
        return true
    if ch >= 'a' && ch <= 'z':
        return true
    if ch >= '0' && ch <= '9':
        return true
    return ch == '-' || ch == '_' || ch == '.' || ch == '~'

fn hexChar(val: int32): int32 =
    if val < 10: return int32('0') + val
    return int32('a') + (val - 10)

fn encodingStringFromRaw(data: ptr, n: int32): str =
    if data == nil || n <= 0:
        return ""
    var out: str
    out.data = data
    out.len = n
    return out

fn encodingByteToStr(value: int32): str =
    if value < 0 || value > 255:
        return ""
    let raw = encodingCalloc(int64(2), int64(1))
    if raw == nil:
        return ""
    encodingWriteByte(raw, 0, value & 255)
    var out: str
    out.data = raw
    out.len = 1
    return out

@abi_internal
@exportc("RustCsgBase64Encode")
fn RustCsgBase64EncodeExport(data: str): str =
    var out: str
    var table: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    let n: int32 = data.len
    var i: int32
    while i < n:
        let b0: int32 = int32(data[i])
        i = i + 1
        var b1: int32
        var b2: int32
        var hasB1: bool
        var hasB2: bool
        if i < n:
            b1 = int32(data[i])
            i = i + 1
            hasB1 = true
        if i < n:
            b2 = int32(data[i])
            i = i + 1
            hasB2 = true
        let q0: int32 = (b0 >> 2) & 0x3F
        out = encodingConcat(out, encodingSliceBytes(table, q0, 1))
        if hasB1:
            let q1: int32 = ((b0 & 0x03) << 4) | ((b1 >> 4) & 0x0F)
            out = encodingConcat(out, encodingSliceBytes(table, q1, 1))
            if hasB2:
                let q2: int32 = ((b1 & 0x0F) << 2) | ((b2 >> 6) & 0x03)
                let q3: int32 = b2 & 0x3F
                out = encodingConcat(out, encodingSliceBytes(table, q2, 1))
                out = encodingConcat(out, encodingSliceBytes(table, q3, 1))
            else:
                let q2: int32 = ((b1 & 0x0F) << 2)
                out = encodingConcat(out, encodingSliceBytes(table, q2, 1))
                out = encodingConcat(out, "=")
        else:
            let q1: int32 = (b0 & 0x03) << 4
            out = encodingConcat(out, encodingSliceBytes(table, q1, 1))
            out = encodingConcat(out, "==")
    return out

fn rustCsgBase64CharValue(ch: char): int32 =
    if ch >= 'A' && ch <= 'Z':
        return int32(ch) - int32('A')
    if ch >= 'a' && ch <= 'z':
        return int32(ch) - int32('a') + 26
    if ch >= '0' && ch <= '9':
        return int32(ch) - int32('0') + 52
    if ch == '+':
        return 62
    if ch == '/':
        return 63
    return -1

@abi_internal
@exportc("RustCsgBase64Decode")
fn RustCsgBase64DecodeExport(data: str): str =
    var out: str
    var i: int32
    var q0: int32
    var q1: int32
    var q2: int32
    var q3: int32
    var qCount: int32
    var padCount: int32
    let n: int32 = data.len
    while i < n:
        let ch: char = data[i]
        i = i + 1
        if ch == ' ' || ch == '\n' || ch == '\r' || ch == '\t':
            continue
        if ch == '=':
            padCount = padCount + 1
            if qCount == 0:
                q0 = 0
            elif qCount == 1:
                q1 = 0
            elif qCount == 2:
                q2 = 0
            else:
                q3 = 0
            qCount = qCount + 1
        else:
            let bv: int32 = rustCsgBase64CharValue(ch)
            if bv < 0:
                continue
            if qCount == 0:
                q0 = bv
            elif qCount == 1:
                q1 = bv
            elif qCount == 2:
                q2 = bv
            else:
                q3 = bv
            qCount = qCount + 1
        if qCount == 4:
            let b0v: int32 = (q0 << 2) | (q1 >> 4)
            out = encodingConcat(out, encodingByteToStr(b0v))
            if padCount <= 1:
                let b1v: int32 = ((q1 << 4) & 0xFF) | (q2 >> 2)
                out = encodingConcat(out, encodingByteToStr(b1v))
            if padCount == 0:
                let b2v: int32 = ((q2 << 6) & 0xFF) | q3
                out = encodingConcat(out, encodingByteToStr(b2v))
            qCount = 0
            padCount = 0
    if qCount == 2:
        let b0vTail: int32 = (q0 << 2) | (q1 >> 4)
        out = encodingConcat(out, encodingByteToStr(b0vTail))
    elif qCount == 3:
        let b0vTail3: int32 = (q0 << 2) | (q1 >> 4)
        out = encodingConcat(out, encodingByteToStr(b0vTail3))
        let b1vTail3: int32 = ((q1 << 4) & 0xFF) | (q2 >> 2)
        out = encodingConcat(out, encodingByteToStr(b1vTail3))
    return out

@abi_internal
@exportc("RustCsgBase64UrlEncode")
fn RustCsgBase64UrlEncodeExport(data: str): str =
    let b64 = RustCsgBase64EncodeExport(data)
    var out: str
    var i: int32
    while i < b64.len:
        let ch = b64[i]
        if ch == '+':
            out = encodingConcat(out, "-")
        elif ch == '/':
            out = encodingConcat(out, "_")
        elif ch == '=':
            return out
        else:
            out = encodingConcat(out, encodingSliceBytes(b64, i, 1))
        i = i + 1
    return out

@abi_internal
@exportc("cheng_auth_base64url_encode")
fn ChengAuthBase64UrlEncodeExport(data: str): str =
    return RustCsgBase64UrlEncodeExport(data)

@abi_internal
@exportc("cheng_auth_url_encode")
fn ChengAuthUrlEncodeExport(data: str): str =
    var out: str
    var i: int32
    while i < data.len:
        let ch = data[i]
        if encodingIsUrlUnreserved(ch):
            out = encodingConcat(out, encodingSliceBytes(data, i, 1))
        else:
            let b = int32(ch) & 255
            out = encodingConcat(out, "%")
            out = encodingConcat(out, encodingHexNibble(b >> 4))
            out = encodingConcat(out, encodingHexNibble(b))
        i = i + 1
    return out

@abi_internal
@exportc("cheng_auth_sha256")
fn ChengAuthSha256Export(data: str): str =
    let digest = encodingCalloc(int64(32), int64(1))
    if digest == nil:
        return ""
    var input = data.data
    if input == nil:
        input = digest
    let outPtr = encodingCCSha256(input, uint32(data.len), digest)
    if outPtr == nil:
        return ""
    return encodingStringFromRaw(digest, 32)

@abi_internal
@exportc("RustCsgPkceChallenge")
fn RustCsgPkceChallengeExport(verifier: str): str =
    return RustCsgBase64UrlEncodeExport(ChengAuthSha256Export(verifier))

@abi_internal
@exportc("RustCsgUuidV4")
fn RustCsgUuidV4Export(): str =
    let raw = encodingCalloc(int64(16), int64(1))
    if raw == nil:
        return ""
    encodingArc4RandomBuf(raw, int64(16))
    let versionByte = (encodingReadByte(raw, 6) & 15) | 64
    let variantByte = (encodingReadByte(raw, 8) & 63) | 128
    encodingWriteByte(raw, 6, versionByte & 255)
    encodingWriteByte(raw, 8, variantByte & 255)
    var out: str
    encodingAppendUuidByte(out, encodingReadByte(raw, 0))
    encodingAppendUuidByte(out, encodingReadByte(raw, 1))
    encodingAppendUuidByte(out, encodingReadByte(raw, 2))
    encodingAppendUuidByte(out, encodingReadByte(raw, 3))
    out = encodingConcat(out, "-")
    encodingAppendUuidByte(out, encodingReadByte(raw, 4))
    encodingAppendUuidByte(out, encodingReadByte(raw, 5))
    out = encodingConcat(out, "-")
    encodingAppendUuidByte(out, encodingReadByte(raw, 6))
    encodingAppendUuidByte(out, encodingReadByte(raw, 7))
    out = encodingConcat(out, "-")
    encodingAppendUuidByte(out, encodingReadByte(raw, 8))
    encodingAppendUuidByte(out, encodingReadByte(raw, 9))
    out = encodingConcat(out, "-")
    encodingAppendUuidByte(out, encodingReadByte(raw, 10))
    encodingAppendUuidByte(out, encodingReadByte(raw, 11))
    encodingAppendUuidByte(out, encodingReadByte(raw, 12))
    encodingAppendUuidByte(out, encodingReadByte(raw, 13))
    encodingAppendUuidByte(out, encodingReadByte(raw, 14))
    encodingAppendUuidByte(out, encodingReadByte(raw, 15))
    return out
