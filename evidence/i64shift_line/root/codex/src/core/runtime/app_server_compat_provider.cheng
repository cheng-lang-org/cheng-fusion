@importc("RustCsgGetEnvRaw")
fn appServerCompatGetEnvRaw(name: cstring): cstring

@importc("ReadFileRaw")
fn appServerCompatReadFileRaw(path: cstring): cstring

@importc("strlen")
fn appServerCompatStrlen(raw: ptr): int64

@importc("calloc")
fn appServerCompatCalloc(count: int64, size: int64): ptr

@importc("memcpy")
fn appServerCompatMemcpy(dst: ptr, src: ptr, count: int64): ptr

@importc("free")
fn appServerCompatFree(raw: ptr)

type
    AppServerCompatUInt8Ptr = uint8 *

fn appServerCompatCString(text: str): cstring =
    let raw = appServerCompatCalloc(int64(text.len) + int64(1), int64(1))
    if raw == nil:
        return cstring(nil)
    if text.len > 0:
        appServerCompatMemcpy(raw, text.data, int64(text.len))
    return cstring(raw)

fn appServerCompatFreeCString(raw: cstring) =
    if ptr(raw) != nil:
        appServerCompatFree(ptr(raw))

fn appServerCompatStrFromCStringCopy(raw: cstring): str =
    if ptr(raw) == nil:
        return ""
    let count64 = appServerCompatStrlen(ptr(raw))
    if count64 <= int64(0) || count64 > int64(2147483647):
        return ""
    let count = int32(count64)
    let data = appServerCompatCalloc(int64(count) + int64(1), int64(1))
    if data == nil:
        return ""
    appServerCompatMemcpy(data, ptr(raw), int64(count))
    var out: str
    out.data = data
    out.len = count
    return out

@abi_internal
@exportc("RustCsgGetEnv")
fn RustCsgGetEnvExport(name: str): str =
    let rawName = appServerCompatCString(name)
    let rawValue = appServerCompatGetEnvRaw(rawName)
    appServerCompatFreeCString(rawName)
    return appServerCompatStrFromCStringCopy(rawValue)

@abi_internal
@exportc("ReadFile")
fn ReadFileExport(path: str): str =
    let rawPath = appServerCompatCString(path)
    let rawValue = appServerCompatReadFileRaw(rawPath)
    appServerCompatFreeCString(rawPath)
    return appServerCompatStrFromCStringCopy(rawValue)

@exportc("cheng_rawmem_write_i8")
fn cheng_rawmem_write_i8_export(dst: ptr, idx: int32, value: int8) =
    if dst == nil:
        return
    if idx < 0:
        return
    *(AppServerCompatUInt8Ptr(ptr(uint64(dst) + uint64(idx)))) = uint8(value)
