    sqliteSetError("")
    return 0

@abi_internal
@exportc("cheng_sqlite_bind_text")
fn ChengSqliteBindTextExport(stmtHandle: uint64, index: int32, value: str): int32 =
    if sqliteActiveStmtHandle == uint64(0):
        sqliteSetError("sqlite bind text on closed statement")
        return 1
    let rc = sqliteActiveSetBind(index, value, 1)
    if rc != 0:
        return rc
    sqliteActiveStmtExecuted = 0
    return 0

@abi_internal
@exportc("cheng_sqlite_bind_int64")
fn ChengSqliteBindInt64Export(stmtHandle: uint64, index: int32, value: int64): int32 =
    if sqliteActiveStmtHandle == uint64(0):
        sqliteSetError("sqlite bind int64 on closed statement")
        return 1
    let rc = sqliteActiveSetBind(index, sqliteInt64ToDecStr(value), 2)
    if rc != 0:
        return rc
    sqliteActiveStmtExecuted = 0
    return 0

@abi_internal
@exportc("cheng_sqlite_step")
fn ChengSqliteStepExport(stmtHandle: uint64): int32 =
    if sqliteActiveStmtHandle == uint64(0):
        sqliteSetError("sqlite step on closed statement")
        return 1
    if sqliteActiveStmtExecuted == 0:
        if !sqliteExecuteActiveStmt():
            return 1
    if sqliteRowsEmpty(sqliteActiveStmtResultJson):
        return 101
    let nextRow = sqliteActiveStmtRowIndex + 1
    let rowObject = sqliteRowObject(sqliteActiveStmtResultJson, nextRow)
    if rowObject == "":
        return 101
    sqliteActiveStmtRowIndex = nextRow
    sqliteSetError("")
    return 100

@abi_internal
@exportc("cheng_sqlite_column_text")
fn ChengSqliteColumnTextExport(stmtHandle: uint64, index: int32): str =
    if sqliteActiveStmtHandle == uint64(0):
        return ""
    let rowObject = sqliteRowObject(sqliteActiveStmtResultJson, sqliteActiveStmtRowIndex)
    if rowObject == "":
        return ""
    return sqliteObjectValueByIndex(rowObject, index)

@abi_internal
@exportc("cheng_sqlite_column_int64")
fn ChengSqliteColumnInt64Export(stmtHandle: uint64, index: int32): int64 =
    return sqliteParseInt64(ChengSqliteColumnTextExport(stmtHandle, index))

@abi_internal
@exportc("cheng_sqlite_last_error")
fn ChengSqliteLastErrorExport(): str =
    return sqliteLastError
