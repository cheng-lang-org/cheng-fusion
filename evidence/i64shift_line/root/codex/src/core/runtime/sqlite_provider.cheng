# Pure Cheng SQLite provider.
#
# Uses the system sqlite3 command in JSON mode while preserving the std/sqlite
# handle-shaped API expected by translated app-server code. Bound parameters are
# materialized into SQL literals before invoking sqlite3; the sqlite CLI
# `.parameter` command evaluates UUID-like text as arithmetic and cannot be used
# as the provider contract.

@abi_internal
@importc("cheng_process_spawn_blocking")
fn sqliteProcessSpawnBlocking(command: str, args: str, cwd: str, env: str): str

@abi_internal
@importc("RustCsgGetEnvRaw")
fn sqliteRuntimeGetEnvRaw(name: cstring): cstring

@abi_internal
@importc("cheng_cstrlen")
fn sqliteCStringLen(raw: cstring): int32

@abi_internal
@importc("RustCsgMkdir")
fn sqliteRuntimeMkdir(path: str): int32

@abi_internal
@importc("RustCsgWriteFile")
fn sqliteRuntimeWriteFile(path: str, content: str): int32

@abi_internal
@importc("RustCsgNormalizePathRelativeToCurrentDir")
fn sqliteRuntimeNormalizePathRelativeToCurrentDir(path: str): str
@importc("calloc")
fn sqliteCalloc(count: int64, size: int64): ptr
@importc("memcpy")
fn sqliteMemcpy(dst: ptr, src: ptr, count: int64): ptr
@importc("ptr_add")
fn sqlitePtrAddRaw(p: ptr, off: int32): ptr
@importc("cheng_rawmem_write_i8")
fn sqliteWriteI8Raw(dst: ptr, idx: int32, v: int8)

var sqliteNextDbHandle: uint64 = 1
var sqliteLastError: str
var sqliteActiveDbHandle: uint64
var sqliteActiveDbPath: str
var sqliteActiveDbReadonly: int32
var sqliteActiveStmtHandle: uint64
var sqliteActiveStmtSql: str
var sqliteActiveStmtExecuted: int32
var sqliteActiveStmtRowIndex: int32
var sqliteActiveStmtResultJson: str
var sqliteActiveBindRecords: str

fn sqlitePtrAdd(p: ptr, off: int32): ptr =
    return sqlitePtrAddRaw(p, off)

fn sqliteWriteByte(raw: ptr, index: int32, value: int32) =
    sqliteWriteI8Raw(raw, index, int8(value & 255))

fn sqliteConcat(a: str, b: str): str =
    let lenA: int32 = a.len
    let lenB: int32 = b.len
    let total: int32 = lenA + lenB
    if total <= 0:
        return ""
    let raw = sqliteCalloc(int64(total) + int64(1), int64(1))
    if raw == nil:
        return ""
    if lenA > 0 && a.data != nil:
        sqliteMemcpy(raw, a.data, int64(lenA))
    if lenB > 0 && b.data != nil:
        sqliteMemcpy(sqlitePtrAdd(raw, lenA), b.data, int64(lenB))
    var out: str
    out.data = raw
    out.len = total
    return out

fn sqliteCString(text: str): cstring =
    if text.len <= 0 || text.data == nil:
        return cstring(nil)
    let raw = sqliteCalloc(int64(text.len) + int64(1), int64(1))
    if raw == nil:
        return cstring(nil)
    sqliteMemcpy(raw, text.data, int64(text.len))
    return cstring(raw)

fn sqliteStrFromCString(raw: cstring): str =
    var out: str
    if raw != nil:
        out.data = ptr(raw)
        out.len = sqliteCStringLen(raw)
    return out

fn sqliteRuntimeGetEnv(name: str): str =
    let rawName = sqliteCString(name)
    if rawName == nil:
        return ""
    return sqliteStrFromCString(sqliteRuntimeGetEnvRaw(rawName))

fn sqliteSliceBytes(text: str, start: int32, count: int32): str =
    if text.data == nil || text.len <= 0 || count <= 0:
        return ""
    var start0: int32 = start
    if start0 < 0:
        start0 = 0
    if start0 >= text.len:
        return ""
    var kept: int32 = count
    if start0 + kept > text.len:
        kept = text.len - start0
    if kept <= 0:
        return ""
    var out: str
    out.data = sqlitePtrAdd(text.data, start0)
    out.len = kept
    return out

fn sqliteInt64ToDecStr(value: int64): str =
    if value < int64(-9223372036854775807):
        return "-9223372036854775808"
    let raw = sqliteCalloc(int64(32), int64(1))
    if raw == nil:
        return ""
    var negative: bool
    var n: uint64
    if value < int64(0):
        negative = true
        n = uint64(int64(0) - value)
    else:
        n = uint64(value)
    var digits: int32[24]
    var digitCount: int32
    if n == uint64(0):
        digits[0] = 0
        digitCount = 1
    else:
        while n > uint64(0):
            digits[digitCount] = int32(n % uint64(10))
            digitCount = digitCount + 1
            n = n / uint64(10)
    var pos: int32
    if negative:
        sqliteWriteByte(raw, pos, int32('-'))
        pos = pos + 1
    while digitCount > 0:
        digitCount = digitCount - 1
        sqliteWriteByte(raw, pos, int32('0') + digits[digitCount])
        pos = pos + 1
    var out: str
    out.data = raw
    out.len = pos
    return out

fn sqliteInt32ToDecStr(value: int32): str =
    return sqliteInt64ToDecStr(int64(value))

fn sqliteSetError(message: str) =
    sqliteLastError = message

fn sqliteJsonEscape(value: str): str =
    var out: str
    var i: int32
    while i < value.len:
        let ch = value[i]
        if ch == '"':
            out = sqliteConcat(out, "\\\"")
        elif ch == '\\':
            out = sqliteConcat(out, "\\\\")
        elif ch == '\n':
            out = sqliteConcat(out, "\\n")
        elif ch == '\r':
            out = sqliteConcat(out, "\\r")
        elif ch == '\t':
            out = sqliteConcat(out, "\\t")
        else:
            out = sqliteConcat(out, sqliteSliceBytes(value, i, 1))
        i = i + 1
    return out

fn sqliteArgJson(items: str[]): str =
    var out: str = "["
    for i in 0..<items.len:
        if i > 0:
            out = sqliteConcat(out, ",")
        out = sqliteConcat(out, sqliteConcat("\"", sqliteJsonEscape(items[i])))
        out = sqliteConcat(out, "\"")
    return sqliteConcat(out, "]")

fn sqliteAppendArg(out: var str, first: var bool, item: str) =
    if !first:
        out = sqliteConcat(out, ",")
    first = false
    out = sqliteConcat(out, sqliteConcat("\"", sqliteJsonEscape(item)))
    out = sqliteConcat(out, "\"")

fn sqliteSqlQuote(value: str): str =
    var out: str = "'"
    var i: int32
    while i < value.len:
        if value[i] == '\'':
            out = sqliteConcat(out, "''")
        else:
            out = sqliteConcat(out, sqliteSliceBytes(value, i, 1))
        i = i + 1
    return sqliteConcat(out, "'")

fn sqliteActiveBindLiteral(index: int32): str =
    if index <= 0:
        sqliteSetError("sqlite bind index must be positive")
        return ""
    var start: int32
    var i: int32
    while i <= sqliteActiveBindRecords.len:
        if i == sqliteActiveBindRecords.len || sqliteActiveBindRecords[i] == '\n':
            if i > start:
                let line = sqliteSliceBytes(sqliteActiveBindRecords, start, i - start)
                let recordIndex = sqliteActiveRecordIndex(line)
                if recordIndex == index:
                    let kind = sqliteActiveRecordKind(line)
                    let value = sqliteActiveRecordValue(line)
                    if sqliteLastError != "":
                        return ""
                    if kind == 1:
                        return sqliteSqlQuote(value)
                    if kind == 2:
                        return value
                    sqliteSetError("sqlite bind record kind is invalid")
                    return ""
            start = i + 1
        i = i + 1
    sqliteSetError(sqliteConcat("sqlite bind parameter missing: ?", sqliteInt32ToDecStr(index)))
    return ""

fn sqliteActiveRecordIndex(line: str): int32 =
    var i: int32
    var value: int32
    while i < line.len && line[i] >= '0' && line[i] <= '9':
        value = value * 10 + (int32(line[i]) - int32('0'))
        i = i + 1
    if i == 0 || i >= line.len || line[i] != '|':
        return -1
    return value

fn sqliteActiveRecordKind(line: str): int32 =
    var i: int32
    while i < line.len && line[i] != '|':
        i = i + 1
    if i >= line.len:
        return -1
    i = i + 1
    var value: int32
    var sawDigit: bool
    while i < line.len && line[i] >= '0' && line[i] <= '9':
        sawDigit = true
        value = value * 10 + (int32(line[i]) - int32('0'))
        i = i + 1
    if !sawDigit || i >= line.len || line[i] != '|':
        return -1
    return value

fn sqliteActiveRecordValue(line: str): str =
    var separators: int32
    var i: int32
    while i < line.len:
        if line[i] == '|':
            separators = separators + 1
            if separators == 2:
                var value: str
                if sqliteDecodeJsonStringAt(line, i + 1, value) < 0:
                    sqliteSetError("sqlite bind record value is invalid")
                    return ""
                return value
        i = i + 1
    sqliteSetError("sqlite bind record is invalid")
    return ""

fn sqliteActiveRecordLine(index: int32, value: str, kind: int32): str =
    var out = sqliteInt32ToDecStr(index)
    out = sqliteConcat(out, "|")
    out = sqliteConcat(out, sqliteInt32ToDecStr(kind))
    out = sqliteConcat(out, "|\"")
    out = sqliteConcat(out, sqliteJsonEscape(value))
    return sqliteConcat(out, "\"")

fn sqliteActiveBindIndexOutOfRange(maxIndex: int32): int32 =
    var start: int32
    var i: int32
    while i <= sqliteActiveBindRecords.len:
        if i == sqliteActiveBindRecords.len || sqliteActiveBindRecords[i] == '\n':
            if i > start:
                let line = sqliteSliceBytes(sqliteActiveBindRecords, start, i - start)
                let recordIndex = sqliteActiveRecordIndex(line)
                if recordIndex <= 0 || recordIndex > maxIndex:
                    return recordIndex
            start = i + 1
        i = i + 1
    return 0

fn sqliteActiveSetBind(index: int32, value: str, kind: int32): int32 =
    if index <= 0:
        sqliteSetError("sqlite bind index must be positive")
        return 1
    var nextRecords: str
    var start: int32
    var i: int32
    while i <= sqliteActiveBindRecords.len:
        if i == sqliteActiveBindRecords.len || sqliteActiveBindRecords[i] == '\n':
            if i > start:
                let line = sqliteSliceBytes(sqliteActiveBindRecords, start, i - start)
                if sqliteActiveRecordIndex(line) != index:
                    if nextRecords != "":
                        nextRecords = sqliteConcat(nextRecords, "\n")
                    nextRecords = sqliteConcat(nextRecords, line)
            start = i + 1
        i = i + 1
    if nextRecords != "":
        nextRecords = sqliteConcat(nextRecords, "\n")
    nextRecords = sqliteConcat(nextRecords, sqliteActiveRecordLine(index, value, kind))
    sqliteActiveBindRecords = nextRecords
    sqliteSetError("")
    return 0

fn sqliteMaterializeSql(sql: str): str =
    var out: str
    var i: int32
    var nextAnonymousIndex: int32 = 1
    var maxIndex: int32
    var inSingleQuote: bool
    var inDoubleQuote: bool
    var inLineComment: bool
    var inBlockComment: bool
    while i < sql.len:
        let ch = sql[i]
        if inLineComment:
            out = sqliteConcat(out, sqliteSliceBytes(sql, i, 1))
            if ch == '\n':
                inLineComment = false
            i = i + 1
            continue
        if inBlockComment:
            if ch == '*' && i + 1 < sql.len && sql[i + 1] == '/':
                out = sqliteConcat(out, "*/")
                i = i + 2
                inBlockComment = false
            else:
                out = sqliteConcat(out, sqliteSliceBytes(sql, i, 1))
                i = i + 1
            continue
        if inSingleQuote:
            out = sqliteConcat(out, sqliteSliceBytes(sql, i, 1))
            if ch == '\'':
                if i + 1 < sql.len && sql[i + 1] == '\'':
                    out = sqliteConcat(out, "'")
                    i = i + 2
                else:
                    inSingleQuote = false
                    i = i + 1
            else:
                i = i + 1
            continue
        if inDoubleQuote:
            out = sqliteConcat(out, sqliteSliceBytes(sql, i, 1))
            if ch == '"':
                if i + 1 < sql.len && sql[i + 1] == '"':
                    out = sqliteConcat(out, "\"")
                    i = i + 2
                else:
                    inDoubleQuote = false
                    i = i + 1
            else:
                i = i + 1
            continue
        if ch == '\'':
            inSingleQuote = true
            out = sqliteConcat(out, "'")
            i = i + 1
            continue
        if ch == '"':
            inDoubleQuote = true
            out = sqliteConcat(out, "\"")
            i = i + 1
            continue
        if ch == '-' && i + 1 < sql.len && sql[i + 1] == '-':
            inLineComment = true
            out = sqliteConcat(out, "--")
            i = i + 2
            continue
        if ch == '/' && i + 1 < sql.len && sql[i + 1] == '*':
            inBlockComment = true
            out = sqliteConcat(out, "/*")
            i = i + 2
            continue
        if ch == '?':
            var index: int32
            var j = i + 1
            while j < sql.len && sql[j] >= '0' && sql[j] <= '9':
                index = index * 10 + (int32(sql[j]) - int32('0'))
                j = j + 1
            if j == i + 1:
                index = nextAnonymousIndex
                nextAnonymousIndex = nextAnonymousIndex + 1
            if index > maxIndex:
                maxIndex = index
            let literal = sqliteActiveBindLiteral(index)
            if literal == "":
                return ""
            out = sqliteConcat(out, literal)
            i = j
            continue
        out = sqliteConcat(out, sqliteSliceBytes(sql, i, 1))
        i = i + 1
    let outOfRangeIndex = sqliteActiveBindIndexOutOfRange(maxIndex)
    if outOfRangeIndex != 0:
        sqliteSetError(sqliteConcat("sqlite bind index out of range: ?", sqliteInt32ToDecStr(outOfRangeIndex)))
        return ""
    return out

fn sqliteDecodeJsonStringAt(text: str, start: int32, outValue: var str): int32 =
    outValue = ""
    if start < 0 || start >= text.len || text[start] != '"':
        return -1
    var i: int32 = start + 1
    while i < text.len:
        let ch = text[i]
        if ch == '\\':
            i = i + 1
            if i >= text.len:
                return -1
            let esc = text[i]
            if esc == '"' || esc == '\\' || esc == '/':
                outValue = sqliteConcat(outValue, sqliteSliceBytes(text, i, 1))
            elif esc == 'n':
                outValue = sqliteConcat(outValue, "\n")
            elif esc == 'r':
                outValue = sqliteConcat(outValue, "\r")
            elif esc == 't':
                outValue = sqliteConcat(outValue, "\t")
            else:
                return -1
        elif ch == '"':
            return i + 1
        else:
            outValue = sqliteConcat(outValue, sqliteSliceBytes(text, i, 1))
        i = i + 1
    return -1

fn sqliteJsonFindString(json: str, key: str): str =
    var pattern = sqliteConcat("\"", key)
    pattern = sqliteConcat(pattern, "\":")
    var i: int32
    while i + pattern.len <= json.len:
        if sqliteSliceBytes(json, i, pattern.len) == pattern:
            var pos = i + pattern.len
            while pos < json.len && (json[pos] == ' ' || json[pos] == '\t' || json[pos] == '\n' || json[pos] == '\r'):
                pos = pos + 1
            var out: str
            if sqliteDecodeJsonStringAt(json, pos, out) < 0:
                return ""
            return out
        i = i + 1
    return ""

fn sqliteJsonFindInt(json: str, key: str): int32 =
    var pattern = sqliteConcat("\"", key)
    pattern = sqliteConcat(pattern, "\":")
    var i: int32
    while i + pattern.len <= json.len:
        if sqliteSliceBytes(json, i, pattern.len) == pattern:
            i = i + pattern.len
            var sign: int32 = 1
            if i < json.len && json[i] == '-':
                sign = -1
                i = i + 1
            var value: int32
            while i < json.len && json[i] >= '0' && json[i] <= '9':
                value = value * 10 + (int32(json[i]) - int32('0'))
                i = i + 1
            return value * sign
        i = i + 1
    return 0

fn sqliteRowsEmpty(json: str): bool =
    var i: int32
    while i < json.len:
        if json[i] == '{':
            return false
        i = i + 1
    return true

fn sqliteRowObject(json: str, rowIndex: int32): str =
    var i: int32
    var row: int32
    while i < json.len:
        if json[i] == '{':
            let start = i
            var depth: int32 = 1
            i = i + 1
            while i < json.len && depth > 0:
                if json[i] == '"':
                    var ignored: str
                    let next = sqliteDecodeJsonStringAt(json, i, ignored)
                    if next < 0:
                        return ""
                    i = next
                    continue
                if json[i] == '{':
                    depth = depth + 1
                elif json[i] == '}':
                    depth = depth - 1
                i = i + 1
            if depth == 0:
                if row == rowIndex:
                    return sqliteSliceBytes(json, start, i - start)
                row = row + 1
        else:
            i = i + 1
    return ""

fn sqliteObjectValueByIndex(objectJson: str, columnIndex: int32): str =
    var i: int32
    var col: int32
    while i < objectJson.len:
        if objectJson[i] == '"':
            var key: str
            let afterKey = sqliteDecodeJsonStringAt(objectJson, i, key)
            if afterKey < 0:
                return ""
            i = afterKey
            while i < objectJson.len && objectJson[i] != ':':
                i = i + 1
            if i >= objectJson.len:
                return ""
            i = i + 1
            while i < objectJson.len && (objectJson[i] == ' ' || objectJson[i] == '\t' || objectJson[i] == '\n' || objectJson[i] == '\r'):
                i = i + 1
            var value: str
            if i < objectJson.len && objectJson[i] == '"':
                let afterValue = sqliteDecodeJsonStringAt(objectJson, i, value)
                if afterValue < 0:
                    return ""
                if col == columnIndex:
                    return value
                i = afterValue
            else:
                let start = i
                while i < objectJson.len && objectJson[i] != ',' && objectJson[i] != '}':
                    i = i + 1
                value = sqliteSliceBytes(objectJson, start, i - start)
                if col == columnIndex:
                    return value
            col = col + 1
        else:
            i = i + 1
    return ""

fn sqliteParseInt64(text: str): int64 =
    var i: int32
    var sign: int64 = int64(1)
    if text.len > 0 && text[0] == '-':
        sign = int64(-1)
        i = 1
    var value: int64
    while i < text.len && text[i] >= '0' && text[i] <= '9':
        value = value * int64(10) + int64(int32(text[i]) - int32('0'))
        i = i + 1
    return value * sign

fn sqliteBuildActiveArgs(): str =
    if sqliteActiveDbHandle == uint64(0) || sqliteActiveStmtHandle == uint64(0):
        return ""
    let sql = sqliteMaterializeSql(sqliteActiveStmtSql)
    if sql == "":
        return ""
    var out: str = "["
    var first: bool = true
    sqliteAppendArg(out, first, "-json")
    if sqliteActiveDbReadonly != 0:
        sqliteAppendArg(out, first, "-readonly")
    sqliteAppendArg(out, first, sqliteActiveDbPath)
    sqliteAppendArg(out, first, sql)
    return sqliteConcat(out, "]")

fn sqliteExecuteActiveStmt(): bool =
    let args = sqliteBuildActiveArgs()
    if args == "":
        if sqliteLastError == "":
            sqliteSetError("sqlite active statement not prepared")
        return false
    let raw = sqliteProcessSpawnBlocking("/usr/bin/sqlite3", args, "", "{}")
    let exitCode = sqliteJsonFindInt(raw, "exit_code")
    let stdoutText = sqliteJsonFindString(raw, "stdout")
    let stderrText = sqliteJsonFindString(raw, "stderr")
    if exitCode != 0:
        if stderrText != "":
            sqliteSetError(stderrText)
        else:
            sqliteSetError(sqliteConcat(sqliteConcat("sqlite3 command failed args=", args), sqliteConcat(" raw=", raw)))
        return false
    sqliteActiveStmtResultJson = stdoutText
    sqliteActiveStmtRowIndex = -1
    sqliteActiveStmtExecuted = 1
    sqliteSetError("")
    return true

fn sqliteTrimTrailingNewlines(text: str): str =
    var n = text.len
    while n > 0 && (text[n - 1] == '\n' || text[n - 1] == '\r'):
        n = n - 1
    return sqliteSliceBytes(text, 0, n)

fn sqlitePathJoin(base: str, child: str): str =
    if base == "":
        return child
    if child == "":
        return base
    if base[base.len - 1] == '/':
        return sqliteConcat(base, child)
    return sqliteConcat(sqliteConcat(base, "/"), child)

fn sqliteParentDir(path: str): str =
    var i = path.len - 1
    while i >= 0:
        if path[i] == '/':
            return sqliteSliceBytes(path, 0, i)
        i = i - 1
    return ""

fn sqliteProcessFailure(raw: str, fallback: str): str =
    let stderrText = sqliteJsonFindString(raw, "stderr")
    if stderrText != "":
        sqliteSetError(stderrText)
        return stderrText
    sqliteSetError(fallback)
    return fallback

fn sqliteCreateFixtureDir(prefix: str): str =
    let tmp = sqliteRuntimeGetEnv("TMPDIR")
    if tmp == "":
        sqliteSetError("TMPDIR is required for sqlite fixture")
        return ""
    let templatePath = sqlitePathJoin(tmp, sqliteConcat(prefix, ".XXXXXX"))
    let args: str[] = ["-d", templatePath]
    let raw = sqliteProcessSpawnBlocking("/usr/bin/mktemp", sqliteArgJson(args), "", "{}")
    if sqliteJsonFindInt(raw, "exit_code") != 0:
        sqliteProcessFailure(raw, "sqlite fixture mktemp failed")
        return ""
    let dir = sqliteTrimTrailingNewlines(sqliteJsonFindString(raw, "stdout"))
    if dir == "":
        sqliteSetError("sqlite fixture mktemp returned empty path")
        return ""
    sqliteSetError("")
    return dir

fn sqliteExecSql(path: str, sql: str): str =
    let args: str[] = [path, sql]
    let raw = sqliteProcessSpawnBlocking("/usr/bin/sqlite3", sqliteArgJson(args), "", "{}")
    if sqliteJsonFindInt(raw, "exit_code") != 0:
        return sqliteProcessFailure(raw, "sqlite3 fixture command failed")
    sqliteSetError("")
    return ""

fn sqliteWriteTextFixture(path: str, content: str, message: str): str =
    if sqliteRuntimeWriteFile(path, content) == 1:
        sqliteSetError("")
        return ""
    sqliteSetError(message)
    return message

fn sqliteMakeDirFixture(path: str, message: str): str =
    if sqliteRuntimeMkdir(path) == 1:
        sqliteSetError("")
        return ""
    sqliteSetError(message)
    return message

fn sqliteCreateSymlink(target: str, linkPath: str): str =
    let args: str[] = ["-s", target, linkPath]
    let raw = sqliteProcessSpawnBlocking("/bin/ln", sqliteArgJson(args), "", "{}")
    if sqliteJsonFindInt(raw, "exit_code") != 0:
        return sqliteProcessFailure(raw, "symlink fixture create failed")
    sqliteSetError("")
    return ""

fn sqliteAppendThreadText(out: str, value: str): str =
    return sqliteConcat(sqliteConcat(out, sqliteSqlQuote(value)), ",")

fn sqliteAppendThreadRaw(out: str, value: str): str =
    return sqliteConcat(sqliteConcat(out, value), ",")

fn sqliteThreadInsertSql(id: str,
                         rolloutPath: str,
                         createdAtMs: str,
                         updatedAtMs: str,
                         source: str,
                         modelProvider: str,
                         cwd: str,
                         title: str,
                         tokensUsed: str,
                         firstUserMessage: str,
                         archived: str): str =
    var out = "INSERT INTO threads (id,rollout_path,created_at_ms,updated_at_ms,source,model_provider,cwd,cli_version,title,sandbox_policy,approval_mode,tokens_used,first_user_message,archived) VALUES ("
    out = sqliteAppendThreadText(out, id)
    out = sqliteAppendThreadText(out, rolloutPath)
    out = sqliteAppendThreadRaw(out, createdAtMs)
    out = sqliteAppendThreadRaw(out, updatedAtMs)
    out = sqliteAppendThreadText(out, source)
    out = sqliteAppendThreadText(out, modelProvider)
    out = sqliteAppendThreadText(out, cwd)
    out = sqliteAppendThreadText(out, "1.0.0")
    out = sqliteAppendThreadText(out, title)
    out = sqliteAppendThreadText(out, "workspace-write")
    out = sqliteAppendThreadText(out, "never")
    out = sqliteAppendThreadRaw(out, tokensUsed)
    out = sqliteAppendThreadText(out, firstUserMessage)
    out = sqliteConcat(out, archived)
    return sqliteConcat(out, ");")

fn sqliteInsertThread(path: str,
                      id: str,
                      rolloutPath: str,
                      createdAtMs: str,
                      updatedAtMs: str,
                      source: str,
                      modelProvider: str,
                      cwd: str,
                      title: str,
                      tokensUsed: str,
                      firstUserMessage: str,
                      archived: str): str =
    return sqliteExecSql(path,
                         sqliteThreadInsertSql(id,
                                               rolloutPath,
                                               createdAtMs,
                                               updatedAtMs,
                                               source,
                                               modelProvider,
                                               cwd,
                                               title,
                                               tokensUsed,
                                               firstUserMessage,
                                               archived))

fn sqliteCreateThreadTable(path: str): str =
    let sql = """
CREATE TABLE threads (
id TEXT PRIMARY KEY,
rollout_path TEXT NOT NULL,
created_at_ms INTEGER NOT NULL,
updated_at_ms INTEGER NOT NULL,
source TEXT NOT NULL,
agent_nickname TEXT,
agent_role TEXT,
agent_path TEXT,
model_provider TEXT NOT NULL,
model TEXT,
reasoning_effort TEXT,
cwd TEXT NOT NULL,
cli_version TEXT,
title TEXT NOT NULL,
sandbox_policy TEXT NOT NULL,
approval_mode TEXT NOT NULL,
tokens_used INTEGER NOT NULL DEFAULT 0,
first_user_message TEXT NOT NULL,
archived INTEGER NOT NULL DEFAULT 0,
archived_at INTEGER,
git_sha TEXT,
git_branch TEXT,
git_origin_url TEXT
);
CREATE INDEX threads_updated_at_idx ON threads(updated_at_ms);
CREATE INDEX threads_created_at_idx ON threads(created_at_ms);
CREATE INDEX threads_cwd_idx ON threads(cwd);
"""
    return sqliteExecSql(path, sql)

