fn ChengSqliteFinalizeExport(stmtHandle: uint64): int32 =
    if sqliteActiveStmtHandle != uint64(0):
        sqliteActiveStmtHandle = uint64(0)
        sqliteActiveStmtSql = ""
        sqliteActiveStmtResultJson = ""
        sqliteActiveStmtExecuted = 0
        sqliteActiveStmtRowIndex = -1
