    content = sqliteConcat(content, "{\"timestamp\":\"2026-05-17T00:00:04Z\",\"type\":\"event_msg\",\"payload\":{\"type\":\"agent_message\",\"message\":\"rollout reply\",\"phase\":null,\"memory_citation\":null}}\n")
    content = sqliteConcat(content, "{\"timestamp\":\"2026-05-17T00:00:04.500Z\",\"type\":\"event_msg\",\"payload\":{\"type\":\"token_count\",\"info\":{\"total_token_usage\":{\"input_tokens\":120,\"cached_input_tokens\":20,\"output_tokens\":30,\"reasoning_output_tokens\":10,\"total_tokens\":150},\"last_token_usage\":{\"input_tokens\":70,\"cached_input_tokens\":10,\"output_tokens\":20,\"reasoning_output_tokens\":5,\"total_tokens\":90},\"model_context_window\":200000},\"rate_limits\":null}}\n")
    content = sqliteConcat(content, "{\"timestamp\":\"2026-05-17T00:00:05Z\",\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"rollout second\",\"text_elements\":[],\"local_images\":[]}}\n")
    let writeErr = sqliteWriteTextFixture(rolloutPath, content, "sqlite latest rollout fixture write failed")
    if writeErr != "":
        return writeErr
    return sqliteInsertThread(path, "thread-latest-rollout-cwd", rolloutPath, "1700000003000", "1700000000400", "cli", "openai", "/db-old", "latest rollout cwd thread", "1", "latest rollout cwd hello", "0")

@abi_internal
@exportc("RustCsgAddSqliteThreadListBulkRows")
fn RustCsgAddSqliteThreadListBulkRowsExport(path: str): str =
    var i: int32 = 6
    while i <= 30:
        let suffix = sqliteInt32ToDecStr(i)
        let id = sqliteConcat("thread-", suffix)
        let rolloutPath = sqliteConcat(sqliteConcat("/codex/sessions/thread-", suffix), ".jsonl")
        let created = sqliteInt64ToDecStr(int64(1699999999) * int64(1000) + int64(i - 5))
        let updated = sqliteInt64ToDecStr(int64(1700000000) * int64(1000) + int64(100) - int64(i - 5))
        let title = sqliteConcat("bulk thread ", suffix)
        let first = sqliteConcat("bulk hello ", suffix)
        let err = sqliteInsertThread(path, id, rolloutPath, created, updated, "cli", "openai", "/repo", title, "1", first, "0")
        if err != "":
            return err
        i = i + 1
    sqliteSetError("")
    return ""

