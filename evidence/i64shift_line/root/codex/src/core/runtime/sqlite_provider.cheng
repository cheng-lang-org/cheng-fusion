    let handle = sqliteNextDbHandle
    sqliteNextDbHandle = sqliteNextDbHandle + uint64(1)
    sqliteActiveDbHandle = handle
    sqliteActiveDbPath = path
    sqliteActiveDbReadonly = 0
    sqliteSetError("")
    return handle

@abi_internal
@exportc("cheng_sqlite_close")
fn ChengSqliteCloseExport(handle: uint64): int32 =
    if sqliteActiveDbHandle != uint64(0):
        sqliteActiveDbHandle = uint64(0)
        sqliteActiveDbPath = ""
        sqliteActiveDbReadonly = 0
    sqliteSetError("")
    return 0

@abi_internal
@exportc("cheng_sqlite_prepare")
fn ChengSqlitePrepareExport(dbHandle: uint64, sql: str): uint64 =
    if sqliteActiveDbPath == "":
        sqliteSetError("sqlite prepare on closed connection")
        return uint64(0)
    let handle = uint64(10001)
    sqliteActiveStmtHandle = handle
    sqliteActiveStmtSql = sql
    sqliteActiveStmtExecuted = 0
    sqliteActiveStmtRowIndex = -1
    sqliteActiveStmtResultJson = ""
    sqliteActiveBindRecords = ""
    sqliteSetError("")
    return handle

@abi_internal
@exportc("cheng_sqlite_prepare_path")
fn ChengSqlitePreparePathExport(path: str, readonly: int32, sql: str): uint64 =
    if path == "":
        sqliteSetError("sqlite prepare on closed connection")
        return uint64(0)
    let handle = uint64(10001)
    sqliteActiveDbHandle = uint64(1)
    sqliteActiveDbPath = path
    sqliteActiveDbReadonly = readonly
    sqliteActiveStmtHandle = handle
    sqliteActiveStmtSql = sql
    sqliteActiveStmtExecuted = 0
    sqliteActiveStmtRowIndex = -1
    sqliteActiveStmtResultJson = ""
    sqliteActiveBindRecords = ""
    sqliteSetError("")
