    content = sqliteConcat(content, "{\"timestamp\":\"2026-05-17T00:00:02Z\",\"type\":\"turn_context\",\"payload\":{\"cwd\":\"")
    content = sqliteConcat(content, sqliteJsonEscape(latestCwd))
    content = sqliteConcat(content, "\",\"approval_policy\":\"never\",\"sandbox_policy\":{\"type\":\"workspace-write\"},\"model\":\"gpt-5.4\",\"summary\":\"auto\"}}\n")
