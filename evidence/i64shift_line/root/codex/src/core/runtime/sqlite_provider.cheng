@abi_internal
@exportc("cheng_sqlite_open_readonly")
fn ChengSqliteOpenReadonlyExport(path: str): uint64 =
    if path == "":
        sqliteSetError("sqlite path is empty")
        return uint64(0)
    let handle = sqliteNextDbHandle
    sqliteNextDbHandle = sqliteNextDbHandle + uint64(1)
    sqliteActiveDbHandle = handle
    sqliteActiveDbPath = path
    sqliteActiveDbReadonly = 1
    sqliteSetError("")
    return handle

