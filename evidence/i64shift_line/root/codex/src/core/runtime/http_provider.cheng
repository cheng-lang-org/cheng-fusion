# Pure Cheng HTTP provider for local app-server/runtime smokes.

import std/rawmem_support

@importc("socket")
fn clib_socket(domain: int32, kind: int32, protocol: int32): int32
@importc("connect")
fn clib_connect(fd: int32, addr: ptr, addrLen: int32): int32
@importc("close")
fn clib_close(fd: int32): int32
@importc("calloc")
fn clib_calloc(count: int64, size: int64): ptr
@importc("free")
fn clib_free(raw: ptr)
@importc("memcpy")
fn clib_memcpy(dst: ptr, src: ptr, n: int64): ptr
@importc("read")
fn clib_read(fd: int32, buf: ptr, count: int64): int64
@importc("recv")
fn clib_recv(fd: int32, buf: ptr, count: int64, flags: int32): int64
@importc("write")
fn clib_write(fd: int32, buf: ptr, count: int64): int64
@importc("poll")
fn clib_poll(fds: ptr, nfds: int32, timeoutMs: int32): int32
@importc("mkstemp")
fn clib_mkstemp(templatePath: ptr): int32
@importc("unlink")
fn clib_unlink(path: ptr): int32
@importc("popen")
fn clib_popen(command: ptr, mode: ptr): ptr
@importc("pclose")
fn clib_pclose(stream: ptr): int32
@importc("fread")
fn clib_fread(buf: ptr, size: int64, count: int64, stream: ptr): int64
@importc("strlen")
fn clib_strlen(raw: ptr): int64
@importc("__error")
fn clib_errno_ptr(): ptr
@importc("strerror")
fn clib_strerror(err: int32): ptr
type
    HttpUInt8Ptr = uint8 *
    HttpInt32Ptr = int32 *

const HttpAfInet: int32 = 2
const HttpSockStream: int32 = 1
const HttpIpProtoTcp: int32 = 6
const HttpSockaddrLen: int32 = 16
const HttpRecvChunkBytes: int32 = 4096
const HttpPollfdSize: int32 = 8
const HttpPollIn: int32 = 1
const HttpCurlMaxResponseBytes: int32 = 16777216
const HttpByteLf: int32 = 10
const HttpByteCr: int32 = 13
const HttpByteSpace: int32 = 32
const HttpByteColon: int32 = 58
const HttpByteD: int32 = 100
const HttpByteA: int32 = 97
const HttpByteT: int32 = 116
const HttpAsciiPrintable: str = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
const HttpCurlStatusMarker: str = "__CHENG_HTTP_STATUS__:"
const HttpCurlStatusMarkerLen: int32 = 22
const HttpCurlConfigTemplate: str = "/tmp/cheng_http_cfg_XXXXXX"
const HttpCurlBodyTemplate: str = "/tmp/cheng_http_body_XXXXXX"
const HttpProviderStrFlagOwned: int32 = 1
var httpSseActive: bool
var httpSseHandle: int32
var httpSseFd: int32 = -1
var httpNdjsonCursorStable: int32
var httpSseBuffer: str
var httpSseLen: int32
var httpSseCap: int32
var httpSseLines: str
var httpSseCursor: int32
var httpSseDone: bool
var httpSseStatusCode: int32
var httpSseError: str
var httpSseScan: int32
var httpSsePayloadSkip: int32
var httpSsePayloadEnd: int32
var httpSseLineEnd: int32
var httpSseFramePayloadStart: int32
var httpSseFramePayloadLen: int32
var httpSseFrameWriteIndex: int32
var httpNextSseHandle: int32 = 1

fn httpProviderOwnedStr(raw: ptr, count: int32): str =
    var out: str
    if raw == nil || count <= 0:
        return out
    out.data = raw
    out.len = count
    out.store_id = 0
    out.flags = HttpProviderStrFlagOwned
    return out

fn httpProviderPtrAdd(raw: ptr, index: int32): ptr =
    return rawmem_support.RawmemPtrAdd(raw, index)

fn httpProviderOwnedStringAlloc(count: int32): str =
    if count <= 0:
        var out: str
        return out
    var out: str
    let raw = clib_calloc(int64(count) + int64(1), int64(1))
    if raw == nil:
        return out
    return httpProviderOwnedStr(raw, count)

fn httpProviderRawByte(raw: ptr, index: int32): int32 =
    let p = httpProviderPtrAdd(raw, index)
    let b = int32(*(HttpUInt8Ptr(p)))
    return b & 255

fn httpProviderStrFromBytesCopy(raw: ptr, count: int32): str =
    if raw == nil || count <= 0:
        return ""
    let outRaw = clib_calloc(int64(count) + int64(1), int64(1))
    if outRaw == nil:
        return ""
    var i: int32
    while i < count:
        httpProviderWriteByte(outRaw, i, httpProviderReadByte(raw, i))
        i = i + 1
    return httpProviderOwnedStr(outRaw, count)

fn httpProviderCString(text: str): ptr =
    let raw = clib_calloc(int64(text.len) + int64(1), int64(1))
    if raw == nil:
        return nil
    if text.len > 0:
        clib_memcpy(raw, text.data, int64(text.len))
    return raw

fn httpProviderCStringReturn(text: str): cstring =
    let raw = httpProviderCString(text)
    return cstring(raw)

fn httpProviderStrFromCStringCopy(raw: ptr): str =
    if raw == nil:
        return ""
    let count = int32(clib_strlen(raw))
    return httpProviderStrFromBytesCopy(raw, count)

fn httpProviderBoundaryStr(raw: cstring): str =
    if ptr(raw) == nil:
        return ""
    return httpProviderStrFromCStringCopy(ptr(raw))

fn httpProviderErrnoCode(): int32 =
    let raw = clib_errno_ptr()
    if raw == nil:
        return 0
    let p = HttpInt32Ptr(raw)
    return int32(*p)

fn httpProviderErrnoMessage(prefix: str): str =
    let code = httpProviderErrnoCode()
    var out = httpProviderConcat(prefix, ": errno=")
    out = httpProviderConcat(out, httpProviderIntToStr(code))
    let text = httpProviderStrFromCStringCopy(clib_strerror(code))
    if text != "":
        out = httpProviderConcat(out, ": ")
        out = httpProviderConcat(out, text)
    return out

fn httpProviderSliceBytes(text: str, start: int32, count: int32): str =
    if count <= 0:
        return ""
    let textLen = text.len
    if start < 0 || start >= textLen:
        return ""
    var actual = count
    if start + actual > textLen:
        actual = textLen - start
    if actual <= 0:
        return ""
    let raw = clib_calloc(int64(actual) + int64(1), int64(1))
    if raw == nil:
        return ""
    var i: int32
    while i < actual:
        httpProviderWriteByte(raw, i, int32(text[start + i]))
        i = i + 1
    return httpProviderOwnedStr(raw, actual)

fn httpProviderConcat(a: str, b: str): str =
    let total = a.len + b.len
    if total <= 0:
        return ""
    let raw = clib_calloc(int64(total) + int64(1), int64(1))
    if raw == nil:
        return ""
    var i: int32
    while i < a.len:
        httpProviderWriteByte(raw, i, int32(a[i]))
        i = i + 1
    var j: int32
    while j < b.len:
        httpProviderWriteByte(raw, a.len + j, int32(b[j]))
        j = j + 1
    return httpProviderOwnedStr(raw, total)

fn httpProviderStartsWith(text: str, prefix: str): bool =
    if prefix.len > text.len:
        return false
    var i: int32
    while i < prefix.len:
        if text[i] != prefix[i]:
            return false
        i = i + 1
    return true

fn httpProviderCat3(a: str, b: str, c: str): str =
    return httpProviderConcat(httpProviderConcat(a, b), c)

fn httpProviderIntToStr(value: int32): str =
    if value == -2147483648:
        return "-2147483648"
    let raw = clib_calloc(int64(16), int64(1))
    if raw == nil:
        return ""
    var n = value
    var negative: bool
    if n < 0:
        negative = true
        n = 0 - n
    var digits: int32[12]
    var digitCount: int32
    if n == 0:
        digits[0] = 0
        digitCount = 1
    else:
        while n > 0:
            digits[digitCount] = n % 10
            digitCount = digitCount + 1
            n = n / 10
    var pos: int32
    if negative:
        httpProviderWriteByte(raw, pos, int32('-'))
        pos = pos + 1
    while digitCount > 0:
        digitCount = digitCount - 1
        httpProviderWriteByte(raw, pos, int32('0') + digits[digitCount])
        pos = pos + 1
    return httpProviderOwnedStr(raw, pos)

fn httpProviderJsonEscape(value: str): str =
    var out: str
    var i: int32
    let valueLen = value.len
    while i < valueLen:
        let ch = value[i]
        if ch == '"':
            out = httpProviderConcat(out, "\\\"")
        elif ch == '\\':
            out = httpProviderConcat(out, "\\\\")
        elif ch == '\n':
            out = httpProviderConcat(out, "\\n")
        elif ch == '\r':
            out = httpProviderConcat(out, "\\r")
        elif ch == '\t':
            out = httpProviderConcat(out, "\\t")
        else:
            out = httpProviderConcat(out, httpProviderSliceBytes(value, i, 1))
        i = i + 1
    return out

fn httpProviderJsonError(message: str): str =
    let cap = int64(message.len) * int64(6) + int64(32)
    let raw = clib_calloc(cap, int64(1))
    if raw == nil:
        return "{\"error\":\"json-alloc\"}"
    var pos: int32
    httpProviderAppendRawText(raw, pos, "{\"error\":\"")
    httpProviderAppendRawEscapedText(raw, pos, message)
    httpProviderAppendRawText(raw, pos, "\"}")
    return httpProviderOwnedStr(raw, pos)

fn httpProviderJsonSuccess(statusCode: int32, body: str): str =
    let cap = int64(body.len) * int64(6) + int64(96)
    let raw = clib_calloc(cap, int64(1))
    if raw == nil:
        return "{\"error\":\"json-alloc\"}"
    var pos: int32
    httpProviderAppendRawText(raw, pos, "{\"status\":")
    httpProviderAppendRawInt(raw, pos, statusCode)
    httpProviderAppendRawText(raw, pos, ",\"body\":\"")
    httpProviderAppendRawEscapedText(raw, pos, body)
    httpProviderAppendRawText(raw, pos, "\"}")
    return httpProviderOwnedStr(raw, pos)

fn httpProviderJsonEscapeRaw(raw: ptr, count: int32): str =
    var out: str
    var i: int32
    while i < count:
        let ch = httpProviderReadByte(raw, i)
        if ch == int32('"'):
            out = httpProviderConcat(out, "\\\"")
        elif ch == int32('\\'):
            out = httpProviderConcat(out, "\\\\")
        elif ch == int32('\n'):
            out = httpProviderConcat(out, "\\n")
        elif ch == int32('\r'):
            out = httpProviderConcat(out, "\\r")
        elif ch == int32('\t'):
            out = httpProviderConcat(out, "\\t")
        else:
            let part = httpProviderAsciiByteToStr(ch)
            if part == "":
                return ""
            out = httpProviderConcat(out, part)
        i = i + 1
    return out

fn httpProviderAppendRawByte(out: ptr, pos: var int32, value: int32) =
    httpProviderWriteByte(out, pos, value)
    pos = pos + 1

fn httpProviderAppendRawText(out: ptr, pos: var int32, text: str) =
    var i: int32
    while i < text.len:
        httpProviderAppendRawByte(out, pos, int32(text[i]))
        i = i + 1

fn httpProviderAppendRawInt(out: ptr, pos: var int32, value: int32) =
    if value == 0:
        httpProviderAppendRawByte(out, pos, int32('0'))
        return
    var digits: int32[12]
    var n: int32
    var v = value
    if v < 0:
        httpProviderAppendRawByte(out, pos, int32('-'))
        v = 0 - v
    while v > 0:
        digits[n] = v % 10
        n = n + 1
        v = v / 10
    while n > 0:
        n = n - 1
        httpProviderAppendRawByte(out, pos, int32('0') + digits[n])

fn httpProviderHexDigit(value: int32): int32 =
    if value < 10:
        return int32('0') + value
    return int32('a') + (value - 10)

fn httpProviderAppendRawEscapedText(out: ptr, pos: var int32, text: str) =
    var i: int32
    while i < text.len:
        let ch = int32(text[i])
        if ch == int32('"'):
            httpProviderAppendRawText(out, pos, "\\\"")
        elif ch == int32('\\'):
            httpProviderAppendRawText(out, pos, "\\\\")
        elif ch == int32('\n'):
            httpProviderAppendRawText(out, pos, "\\n")
        elif ch == int32('\r'):
            httpProviderAppendRawText(out, pos, "\\r")
        elif ch == int32('\t'):
            httpProviderAppendRawText(out, pos, "\\t")
        elif ch >= 32:
            httpProviderAppendRawByte(out, pos, ch)
        else:
            httpProviderAppendRawText(out, pos, "\\u00")
            httpProviderAppendRawByte(out, pos, httpProviderHexDigit((ch >> 4) & 15))
            httpProviderAppendRawByte(out, pos, httpProviderHexDigit(ch & 15))
        i = i + 1

fn httpProviderAppendRawEscapedBody(out: ptr, pos: var int32, bodyRaw: ptr, bodyLen: int32) =
    var i: int32
    while i < bodyLen:
        let ch = httpProviderReadByte(bodyRaw, i)
        if ch == int32('"'):
            httpProviderAppendRawText(out, pos, "\\\"")
        elif ch == int32('\\'):
            httpProviderAppendRawText(out, pos, "\\\\")
        elif ch == int32('\n'):
            httpProviderAppendRawText(out, pos, "\\n")
        elif ch == int32('\r'):
            httpProviderAppendRawText(out, pos, "\\r")
        elif ch == int32('\t'):
            httpProviderAppendRawText(out, pos, "\\t")
        elif ch >= 32:
            httpProviderAppendRawByte(out, pos, ch)
        else:
            httpProviderAppendRawText(out, pos, "\\u00")
            httpProviderAppendRawByte(out, pos, httpProviderHexDigit((ch >> 4) & 15))
            httpProviderAppendRawByte(out, pos, httpProviderHexDigit(ch & 15))
        i = i + 1

fn httpProviderJsonSuccessRaw(statusCode: int32, bodyRaw: ptr, bodyLen: int32): str =
    let cap = int64(bodyLen) * int64(6) + int64(96)
    let raw = clib_calloc(cap, int64(1))
    if raw == nil:
        return "{\"error\":\"json-alloc\"}"
    var pos: int32
    httpProviderAppendRawText(raw, pos, "{\"status\":")
    httpProviderAppendRawInt(raw, pos, statusCode)
    httpProviderAppendRawText(raw, pos, ",\"body\":\"")
    httpProviderAppendRawEscapedBody(raw, pos, bodyRaw, bodyLen)
    httpProviderAppendRawText(raw, pos, "\"}")
    return httpProviderOwnedStr(raw, pos)

fn httpProviderParseDecimal(text: str, start: int32, end: int32): int32 =
    var out: int32
    var i = start
    while i < end:
        let ch = text[i]
        if ch < '0' || ch > '9':
            return -1
        out = out * 10 + (int32(ch) - int32('0'))
        i = i + 1
    return out

fn httpProviderFindByte(text: str, start: int32, needle: char): int32 =
    var i = start
    let textLen = text.len
    while i < textLen:
        if text[i] == needle:
            return i
        i = i + 1
    return -1

fn httpProviderParseUrlBounds(url: str, outHostStart: var int32, outHostLen: var int32, outPort: var int32, outPathStart: var int32, outPathLen: var int32): bool =
    outHostStart = 0
    outHostLen = 0
    outPort = 80
    outPathStart = -1
    outPathLen = 1
    let urlLen = url.len
    if urlLen < 7:
        return false
    if url[0] != 'h' || url[1] != 't' || url[2] != 't' || url[3] != 'p' || url[4] != ':' || url[5] != '/' || url[6] != '/':
        return false
    var pos: int32 = 7
    let hostStart: int32 = pos
    while pos < urlLen && url[pos] != ':' && url[pos] != '/':
        pos = pos + 1
    if pos <= hostStart:
        return false
    outHostStart = hostStart
    outHostLen = pos - hostStart
    if pos < urlLen && url[pos] == ':':
        pos = pos + 1
        let portStart: int32 = pos
        var parsedPort: int32
        while pos < urlLen && url[pos] >= '0' && url[pos] <= '9':
            parsedPort = parsedPort * 10 + (int32(url[pos]) - int32('0'))
            pos = pos + 1
        if pos <= portStart || parsedPort <= 0:
            return false
        outPort = parsedPort
    if pos < urlLen:
        if url[pos] != '/':
            return false
        outPathStart = pos
        outPathLen = urlLen - pos
    return true

fn httpProviderParseIpv4Packed(host: str): int64 =
    let hostLen = host.len
    if hostLen == 9 && host[0] == 'l' && host[1] == 'o' && host[2] == 'c' && host[3] == 'a' && host[4] == 'l' && host[5] == 'h' && host[6] == 'o' && host[7] == 's' && host[8] == 't':
        return int64(2130706433)
    var partIndex: int32
    var value: int32
    var sawDigit: bool
    var p0: int32
    var p1: int32
    var p2: int32
    var i: int32
    while i < hostLen:
        let ch = host[i]
        if ch >= '0' && ch <= '9':
            sawDigit = true
            value = value * 10 + (int32(ch) - int32('0'))
            if value > 255:
                return int64(-1)
        elif ch == '.':
            if !sawDigit || partIndex >= 3:
                return int64(-1)
            if partIndex == 0:
                p0 = value
            elif partIndex == 1:
                p1 = value
            elif partIndex == 2:
                p2 = value
            partIndex = partIndex + 1
            value = 0
            sawDigit = false
        else:
            return int64(-1)
        i = i + 1
    if !sawDigit || partIndex != 3:
        return int64(-1)
    return int64(p0) * int64(16777216) + int64(p1) * int64(65536) + int64(p2) * int64(256) + int64(value)

fn httpProviderWriteByte(raw: ptr, index: int32, value: int32) =
    rawmem_support.RawmemWriteI8(raw, index, int8(value & 255))

fn httpProviderWriteI16(raw: ptr, index: int32, value: int32) =
    httpProviderWriteByte(raw, index, value)
    httpProviderWriteByte(raw, index + 1, value >> 8)

fn httpProviderWriteI32(raw: ptr, index: int32, value: int32) =
    httpProviderWriteByte(raw, index, value)
    httpProviderWriteByte(raw, index + 1, value >> 8)
    httpProviderWriteByte(raw, index + 2, value >> 16)
    httpProviderWriteByte(raw, index + 3, value >> 24)

fn httpProviderReadByte(raw: ptr, index: int32): int32 =
    return httpProviderRawByte(raw, index)

fn httpProviderPollReadable(fd: int32, timeoutMs: int32): int32 =
    if fd < 0:
        return -1
    let pollfd = clib_calloc(int64(HttpPollfdSize), int64(1))
    if pollfd == nil:
        return -1
    httpProviderWriteI32(pollfd, 0, fd)
    httpProviderWriteI16(pollfd, 4, HttpPollIn)
    var timeout = timeoutMs
    if timeout < 0:
        timeout = 0
    let result = clib_poll(pollfd, 1, timeout)
    clib_free(pollfd)
    if result < 0:
        return -1
    if result == 0:
        return 0
    return 1

fn httpProviderEnsureSseCapacity(needed: int32): bool =
    if needed <= httpSseCap:
        return true
    var nextCap = httpSseCap
    if nextCap < HttpRecvChunkBytes:
        nextCap = HttpRecvChunkBytes
    while nextCap < needed:
        nextCap = nextCap * 2
    var nextBuffer: str = httpProviderOwnedStringAlloc(nextCap)
    let nextRaw = nextBuffer.data
    if nextRaw == nil:
        return false
    if httpSseLen > 0:
        var copyIndex: int32
        while copyIndex < httpSseLen:
            let copyByte = httpProviderRawByte(httpSseBuffer.data, copyIndex)
            httpProviderWriteByte(nextRaw, copyIndex, copyByte)
            copyIndex = copyIndex + 1
    httpSseBuffer = nextBuffer
    httpSseCap = nextCap
    return true

fn httpProviderAppendSseBytes(data: ptr, count: int32): bool =
    if count <= 0:
        return true
    let needed = httpSseLen + count + 1
    if !httpProviderEnsureSseCapacity(needed):
        return false
    let raw = httpSseBuffer.data
    var i: int32
    while i < count:
        let value = httpProviderRawByte(data, i)
        httpProviderWriteByte(raw, httpSseLen + i, value)
        i = i + 1
    httpSseLen = httpSseLen + count
    httpProviderWriteByte(raw, httpSseLen, 0)
    return true

fn httpProviderReadSocketIntoSseBuffer(fd: int32, timeoutMs: int32, outError: var str): int32 =
    outError = ""
    let ready = httpProviderPollReadable(fd, timeoutMs)
    if ready < 0:
        outError = "http poll failed"
        return -1
    if ready == 0:
        return 0
    let buf = clib_calloc(int64(HttpRecvChunkBytes), int64(1))
    if buf == nil:
        outError = "http read alloc failed"
        return -1
    let n = clib_recv(fd, buf, int64(HttpRecvChunkBytes), 0)
    if n < int64(0):
        clib_free(buf)
        outError = "http read failed"
        return -1
    if n == int64(0):
        clib_free(buf)
        return 2
    if !httpProviderAppendSseBytes(buf, int32(n)):
        clib_free(buf)
        outError = "http sse buffer append failed"
        return -1
    clib_free(buf)
    return 1

fn httpProviderRawFindByte(raw: ptr, totalLen: int32, start: int32, needle: int32): int32 =
    var i = start
    while i < totalLen:
        if httpProviderReadByte(raw, i) == needle:
            return i
        i = i + 1
    return -1

fn httpProviderRawParseStatus(raw: ptr, totalLen: int32): int32 =
    let firstSpace = httpProviderRawFindByte(raw, totalLen, 0, int32(' '))
    if firstSpace < 0 || firstSpace + 4 > totalLen:
        return 0
    return httpProviderRawParseDecimal(raw, firstSpace + 1, firstSpace + 4)

fn httpProviderReadSseInitialResponse(fd: int32, outStatus: var int32, outClosed: var bool, outError: var str): bool =
    outStatus = 0
    outClosed = false
    outError = ""
    var headerEnd = -1
    var idlePolls: int32
    while headerEnd < 0:
        var chunkError: str
        let readResult = httpProviderReadSocketIntoSseBuffer(fd, 250, chunkError)
        if chunkError != "":
            outError = chunkError
            return false
        if readResult == 0:
            idlePolls = idlePolls + 1
            if idlePolls > 40:
                outError = "http response timed out before headers"
                return false
            continue
        idlePolls = 0
        if readResult == 2:
            outClosed = true
        headerEnd = httpProviderRawBodyOffset(httpSseBuffer.data, httpSseLen)
        if headerEnd < 0 && outClosed:
            outError = "http response ended before headers"
            return false
    outStatus = httpProviderRawParseStatus(httpSseBuffer.data, httpSseLen)
    if outStatus <= 0:
        outError = "invalid http response"
        return false
    httpSseCursor = 0
    return true

fn httpProviderRawParseDecimal(raw: ptr, start: int32, end: int32): int32 =
    var out: int32
    var i = start
    while i < end:
        let ch = httpProviderReadByte(raw, i)
        if ch < int32('0') || ch > int32('9'):
            return -1
        out = out * 10 + (ch - int32('0'))
        i = i + 1
    return out

fn httpProviderRawBodyOffset(raw: ptr, totalLen: int32): int32 =
    var i: int32
    var result: int32 = -1
    while i + 3 < totalLen && result < 0:
        if httpProviderReadByte(raw, i) == HttpByteCr &&
           httpProviderReadByte(raw, i + 1) == HttpByteLf &&
           httpProviderReadByte(raw, i + 2) == HttpByteCr &&
           httpProviderReadByte(raw, i + 3) == HttpByteLf:
            result = i + 4
        else:
            i = i + 1
    return result

fn httpProviderRawHeaderNameMatches(raw: ptr, start: int32, lineEnd: int32, name: str): bool =
    if start + name.len >= lineEnd:
        return false
    var i: int32
    while i < name.len:
        if httpProviderReadByte(raw, start + i) != int32(name[i]):
            return false
        i = i + 1
    return httpProviderReadByte(raw, start + name.len) == int32(':')

fn httpProviderRawHeaderContentLength(raw: ptr, bodyOffset: int32): int32 =
    var lineStart: int32
    while lineStart + 2 < bodyOffset:
        var lineEnd = lineStart
        while lineEnd < bodyOffset && httpProviderReadByte(raw, lineEnd) != int32('\r') && httpProviderReadByte(raw, lineEnd) != int32('\n'):
            lineEnd = lineEnd + 1
        if httpProviderRawHeaderNameMatches(raw, lineStart, lineEnd, "Content-Length") ||
           httpProviderRawHeaderNameMatches(raw, lineStart, lineEnd, "content-length"):
            var valueStart = lineStart + 15
            while valueStart < lineEnd && (httpProviderReadByte(raw, valueStart) == int32(' ') || httpProviderReadByte(raw, valueStart) == int32('\t')):
                valueStart = valueStart + 1
            if valueStart >= lineEnd:
                return -1
            return httpProviderRawParseDecimal(raw, valueStart, lineEnd)
        lineStart = lineEnd + 1
        if lineStart < bodyOffset && httpProviderReadByte(raw, lineStart) == int32('\n'):
            lineStart = lineStart + 1
    return -1

fn httpProviderParseIpv4Range(text: str, start: int32, count: int32): int64 =
    if count == 9:
        if text[start + 0] == 'l' && text[start + 1] == 'o' && text[start + 2] == 'c' && text[start + 3] == 'a' && text[start + 4] == 'l' && text[start + 5] == 'h' && text[start + 6] == 'o' && text[start + 7] == 's' && text[start + 8] == 't':
            return int64(2130706433)
    var partIndex: int32
    var value: int32
    var sawDigit: bool
    var p0: int32
    var p1: int32
    var p2: int32
    var pos: int32
    var invalid: bool
    while pos < count && !invalid:
        let ch = text[start + pos]
        if ch >= '0' && ch <= '9':
            sawDigit = true
            value = value * 10 + (int32(ch) - int32('0'))
            if value > 255:
                invalid = true
        elif ch == '.':
            if !sawDigit || partIndex >= 3:
                invalid = true
            elif partIndex == 0:
                p0 = value
            elif partIndex == 1:
                p1 = value
            elif partIndex == 2:
                p2 = value
            partIndex = partIndex + 1
            value = 0
            sawDigit = false
        else:
            invalid = true
        pos = pos + 1
    if invalid || !sawDigit || partIndex != 3:
        return int64(-1)
    return int64(p0) * int64(16777216) + int64(p1) * int64(65536) + int64(p2) * int64(256) + int64(value)

fn httpProviderConnectPacked(packed: int64, port: int32): int32 =
    if packed < int64(0):
        httpProviderLastError = "invalid packed ipv4 address"
        return -10
    let b0 = int32(packed / int64(16777216))
    let b1 = int32((packed / int64(65536)) % int64(256))
    let b2 = int32((packed / int64(256)) % int64(256))
    let b3 = int32(packed % int64(256))
    let addr = clib_calloc(int64(HttpSockaddrLen), int64(1))
    if addr == nil:
        return -11
    httpProviderWriteByte(addr, 0, HttpSockaddrLen)
    httpProviderWriteByte(addr, 1, HttpAfInet)
    httpProviderWriteByte(addr, 2, (port >> 8) & 255)
    httpProviderWriteByte(addr, 3, port & 255)
    httpProviderWriteByte(addr, 4, b0)
    httpProviderWriteByte(addr, 5, b1)
    httpProviderWriteByte(addr, 6, b2)
    httpProviderWriteByte(addr, 7, b3)
    var i: int32 = 8
    while i < HttpSockaddrLen:
        httpProviderWriteByte(addr, i, 0)
        i = i + 1
    let fd = clib_socket(HttpAfInet, HttpSockStream, HttpIpProtoTcp)
    if fd < 0:
        clib_free(addr)
        httpProviderLastError = httpProviderErrnoMessage("socket failed")
        return -12
    if clib_connect(fd, addr, HttpSockaddrLen) != 0:
        httpProviderLastError = httpProviderErrnoMessage("connect failed")
        clib_free(addr)
        clib_close(fd)
        return -13
    clib_free(addr)
    return fd

# httpProviderBuildSockaddr inlined into httpProviderConnect to avoid cold compiler
# ptr return ABI issue (x3 misinterpreted as return slot).  Once cold compiler
# ptr-return codegen is fixed, the separate function can be restored.
fn httpProviderConnect(host: str, port: int32): int32 =
    var packed: int64 = int64(-1)
    let hostLen = host.len
    var isLocalhost: bool
    if hostLen == 9:
        if host[0] == 'l' && host[1] == 'o' && host[2] == 'c' && host[3] == 'a' && host[4] == 'l' && host[5] == 'h' && host[6] == 'o' && host[7] == 's' && host[8] == 't':
            isLocalhost = true
    if isLocalhost:
        packed = int64(2130706433)
    elif hostLen > 0:
        var partIndex: int32
        var value: int32
        var sawDigit: bool
        var p0: int32
        var p1: int32
        var p2: int32
        var pos: int32
        var invalid: bool
        while pos < hostLen && !invalid:
            let ch = host[pos]
            if ch >= '0' && ch <= '9':
                sawDigit = true
                value = value * 10 + (int32(ch) - int32('0'))
                if value > 255:
                    invalid = true
            elif ch == '.':
                if !sawDigit || partIndex >= 3:
                    invalid = true
                elif partIndex == 0:
                    p0 = value
                elif partIndex == 1:
                    p1 = value
                elif partIndex == 2:
                    p2 = value
                partIndex = partIndex + 1
                value = 0
                sawDigit = false
            else:
                invalid = true
            pos = pos + 1
        if !invalid && sawDigit && partIndex == 3:
            packed = int64(p0) * int64(16777216) + int64(p1) * int64(65536) + int64(p2) * int64(256) + int64(value)
    if packed < int64(0):
        httpProviderLastError = httpProviderConcat("invalid ipv4 host: ", host)
        return -10
    let b0 = int32(packed / int64(16777216))
    let b1 = int32((packed / int64(65536)) % int64(256))
    let b2 = int32((packed / int64(256)) % int64(256))
    let b3 = int32(packed % int64(256))
    let addr = clib_calloc(int64(HttpSockaddrLen), int64(1))
    if addr == nil:
        return -11
    httpProviderWriteByte(addr, 0, HttpSockaddrLen)
    httpProviderWriteByte(addr, 1, HttpAfInet)
    httpProviderWriteByte(addr, 2, (port >> 8) & 255)
    httpProviderWriteByte(addr, 3, port & 255)
    httpProviderWriteByte(addr, 4, b0)
    httpProviderWriteByte(addr, 5, b1)
    httpProviderWriteByte(addr, 6, b2)
    httpProviderWriteByte(addr, 7, b3)
    var i: int32 = 8
    while i < HttpSockaddrLen:
        httpProviderWriteByte(addr, i, 0)
        i = i + 1
    let fd = clib_socket(HttpAfInet, HttpSockStream, HttpIpProtoTcp)
    if fd < 0:
        clib_free(addr)
        httpProviderLastError = httpProviderErrnoMessage("socket failed")
        return -12
    if clib_connect(fd, addr, HttpSockaddrLen) != 0:
        httpProviderLastError = httpProviderErrnoMessage("connect failed")
        clib_free(addr)
        clib_close(fd)
        return -13
    clib_free(addr)
    return fd

fn httpProviderSendAll(fd: int32, data: str): bool =
    var sent: int32
    while sent < data.len:
        let chunk = httpProviderPtrAdd(data.data, sent)
        let wrote = clib_write(fd, chunk, int64(data.len - sent))
        if wrote <= int64(0):
            return false
        sent = sent + int32(wrote)
    return true

fn httpProviderWriteAllRaw(fd: int32, raw: ptr, count: int32): bool =
    if count <= 0:
        return true
    if raw == nil:
        return false
    var sent: int32
    while sent < count:
        let chunk = httpProviderPtrAdd(raw, sent)
        let wrote = clib_write(fd, chunk, int64(count - sent))
        if wrote <= int64(0):
            return false
        sent = sent + int32(wrote)
    return true

fn httpProviderWriteAllStr(fd: int32, text: str): bool =
    if text.len <= 0:
        return true
    return httpProviderWriteAllRaw(fd, text.data, text.len)

fn httpProviderWriteOneByte(fd: int32, scratch: ptr, value: int32): bool =
    if scratch == nil:
        return false
    httpProviderWriteByte(scratch, 0, value)
    return httpProviderWriteAllRaw(fd, scratch, 1)

fn httpProviderWriteTextRange(fd: int32, text: str, start: int32, count: int32, scratch: ptr): bool =
    if count <= 0:
        return true
    var i: int32
    while i < count:
        if !httpProviderWriteOneByte(fd, scratch, int32(text[start + i])):
            return false
        i = i + 1
    return true

fn httpProviderWriteHeadersJson(fd: int32, headersJson: str, scratch: ptr): bool =
    var i: int32
    while i < headersJson.len:
        if headersJson[i] != '"':
            i = i + 1
            continue
        i = i + 1
        while i < headersJson.len:
            let ch = headersJson[i]
            if ch == '\\':
                i = i + 1
                if i >= headersJson.len:
                    return false
                let esc = headersJson[i]
                if esc == '"' || esc == '\\' || esc == '/':
                    if !httpProviderWriteOneByte(fd, scratch, int32(esc)):
                        return false
                else:
                    return false
            elif ch == '"':
                if !httpProviderWriteAllStr(fd, "\r\n"):
                    return false
                break
            else:
                if !httpProviderWriteOneByte(fd, scratch, int32(ch)):
                    return false
            i = i + 1
        i = i + 1
    return true

fn httpProviderSendRequestDirect(fd: int32, method: str, url: str, hostStart: int32, hostLen: int32, pathStart: int32, pathLen: int32, body: str, headersJson: str): bool =
    let scratch = clib_calloc(int64(1), int64(1))
    if scratch == nil:
        return false
    if !httpProviderWriteAllStr(fd, method):
        clib_free(scratch)
        return false
    if !httpProviderWriteAllStr(fd, " "):
        clib_free(scratch)
        return false
    if pathStart >= 0:
        if !httpProviderWriteTextRange(fd, url, pathStart, pathLen, scratch):
            clib_free(scratch)
            return false
    elif !httpProviderWriteAllStr(fd, "/"):
        clib_free(scratch)
        return false
    if !httpProviderWriteAllStr(fd, " HTTP/1.1\r\nHost: "):
        clib_free(scratch)
        return false
    if !httpProviderWriteTextRange(fd, url, hostStart, hostLen, scratch):
        clib_free(scratch)
        return false
    if !httpProviderWriteAllStr(fd, "\r\n"):
        clib_free(scratch)
        return false
    if !httpProviderWriteHeadersJson(fd, headersJson, scratch):
        clib_free(scratch)
        return false
    if body.len > 0 || method == "POST":
        if !httpProviderWriteAllStr(fd, "Content-Length: "):
            clib_free(scratch)
            return false
        if !httpProviderWriteAllStr(fd, httpProviderIntToStr(body.len)):
            clib_free(scratch)
            return false
        if !httpProviderWriteAllStr(fd, "\r\n"):
            clib_free(scratch)
            return false
    if !httpProviderWriteAllStr(fd, "Connection: close\r\n\r\n"):
        clib_free(scratch)
        return false
    if body.len > 0:
        if !httpProviderWriteAllRaw(fd, body.data, body.len):
            clib_free(scratch)
            return false
    clib_free(scratch)
    return true

fn httpProviderRecvAll(fd: int32): str =
    let buf = clib_calloc(int64(HttpRecvChunkBytes), int64(1))
    if buf == nil:
        return ""
    var cap = HttpRecvChunkBytes
    var totalLen: int32
    var totalRaw = clib_calloc(int64(cap) + int64(1), int64(1))
    if totalRaw == nil:
        clib_free(buf)
        return ""
    var expectedTotal: int32 = -1
    while true:
        let n = clib_recv(fd, buf, int64(HttpRecvChunkBytes), 0)
        if n <= int64(0):
            break
        let n32 = int32(n)
        let needed = totalLen + n32 + 1
        if needed > cap:
            var nextCap = cap
            while nextCap < needed:
                nextCap = nextCap * 2
            let grown = clib_calloc(int64(nextCap) + int64(1), int64(1))
            if grown == nil:
                clib_free(totalRaw)
                clib_free(buf)
                return ""
            clib_memcpy(grown, totalRaw, int64(totalLen))
            clib_free(totalRaw)
            totalRaw = grown
            cap = nextCap
        clib_memcpy(httpProviderPtrAdd(totalRaw, totalLen), buf, int64(n32))
        totalLen = totalLen + n32
        if expectedTotal < 0:
            let bodyOffset = httpProviderRawBodyOffset(totalRaw, totalLen)
            if bodyOffset >= 0:
                let contentLength = httpProviderRawHeaderContentLength(totalRaw, bodyOffset)
                if contentLength >= 0:
                    expectedTotal = bodyOffset + contentLength
        if expectedTotal >= 0 && totalLen >= expectedTotal:
            break
    clib_free(buf)
    if totalLen <= 0:
        clib_free(totalRaw)
        return ""
    return httpProviderOwnedStr(totalRaw, totalLen)

fn httpProviderRecvAllJson(fd: int32): str =
    let buf = clib_calloc(int64(HttpRecvChunkBytes), int64(1))
    if buf == nil:
        return httpProviderJsonError("http read alloc failed")
    var cap = HttpRecvChunkBytes
    var totalLen: int32
    var totalRaw = clib_calloc(int64(cap) + int64(1), int64(1))
    if totalRaw == nil:
        clib_free(buf)
        return httpProviderJsonError("http response alloc failed")
    var expectedTotal: int32 = -1
    var parsedStatus: int32
    var parsedBodyOffset: int32 = -1
    while true:
        let n = clib_recv(fd, buf, int64(HttpRecvChunkBytes), 0)
        if n <= int64(0):
            break
        let n32 = int32(n)
        let needed = totalLen + n32 + 1
        if needed > cap:
            var nextCap = cap
            while nextCap < needed:
                nextCap = nextCap * 2
            let grown = clib_calloc(int64(nextCap) + int64(1), int64(1))
            if grown == nil:
                clib_free(totalRaw)
                clib_free(buf)
                return httpProviderJsonError("http response grow failed")
            clib_memcpy(grown, totalRaw, int64(totalLen))
            clib_free(totalRaw)
            totalRaw = grown
            cap = nextCap
        var copyIndex: int32
        while copyIndex < n32:
            httpProviderWriteByte(totalRaw, totalLen + copyIndex, httpProviderReadByte(buf, copyIndex))
            copyIndex = copyIndex + 1
        totalLen = totalLen + n32
        httpProviderWriteByte(totalRaw, totalLen, 0)
        if expectedTotal < 0:
            let bodyOffset = httpProviderRawBodyOffset(totalRaw, totalLen)
            if bodyOffset >= 0:
                parsedBodyOffset = bodyOffset
                parsedStatus = httpProviderRawParseStatus(totalRaw, totalLen)
                let contentLen = httpProviderRawHeaderContentLength(totalRaw, bodyOffset)
                if contentLen >= 0:
                    expectedTotal = bodyOffset + contentLen
        if expectedTotal >= 0 && totalLen >= expectedTotal:
            break
    clib_free(buf)
    if totalLen <= 0:
        clib_free(totalRaw)
        return httpProviderJsonError("empty response")
    var status = parsedStatus
    if status <= 0:
        status = httpProviderRawParseStatus(totalRaw, totalLen)
    var bodyOffset = parsedBodyOffset
    if bodyOffset < 0:
        bodyOffset = httpProviderRawBodyOffset(totalRaw, totalLen)
    if status <= 0 || bodyOffset < 0:
        var error = "invalid http response status="
        error = httpProviderConcat(error, httpProviderIntToStr(status))
        error = httpProviderConcat(error, " body_offset=")
        error = httpProviderConcat(error, httpProviderIntToStr(bodyOffset))
        error = httpProviderConcat(error, " total_len=")
        error = httpProviderConcat(error, httpProviderIntToStr(totalLen))
        clib_free(totalRaw)
        return httpProviderJsonError(error)
    let out = httpProviderJsonSuccessRaw(status, httpProviderPtrAdd(totalRaw, bodyOffset), totalLen - bodyOffset)
    clib_free(totalRaw)
    return out

fn httpProviderAppendDecodedJsonString(input: str, start: int32, outValue: var str): int32 =
    var i = start
    outValue = ""
    while i < input.len:
        let ch = input[i]
        if ch == '\\':
            i = i + 1
            if i >= input.len:
                return -1
            let esc = input[i]
            if esc == '"' || esc == '\\' || esc == '/':
                outValue = httpProviderConcat(outValue, httpProviderSliceBytes(input, i, 1))
            elif esc == 'n':
                outValue = httpProviderConcat(outValue, "\n")
            elif esc == 'r':
                outValue = httpProviderConcat(outValue, "\r")
            elif esc == 't':
                outValue = httpProviderConcat(outValue, "\t")
            else:
                return -1
        elif ch == '"':
            return i + 1
        else:
            outValue = httpProviderConcat(outValue, httpProviderSliceBytes(input, i, 1))
        i = i + 1
    return -1

fn httpProviderHeaderLines(headersJson: str): str =
    var out: str
    var i: int32
    while i < headersJson.len:
        if headersJson[i] != '"':
            i = i + 1
            continue
        var value: str
        let next = httpProviderAppendDecodedJsonString(headersJson, i + 1, value)
        if next < 0:
            return out
        out = httpProviderConcat(out, value)
        out = httpProviderConcat(out, "\r\n")
        i = next
    return out

fn httpProviderBuildRequest(method: str, host: str, path: str, body: str, headersJson: str): str =
    var out = httpProviderConcat(method, " ")
    out = httpProviderConcat(out, path)
    out = httpProviderConcat(out, " HTTP/1.1\r\nHost: ")
    out = httpProviderConcat(out, host)
    out = httpProviderConcat(out, "\r\n")
    out = httpProviderConcat(out, httpProviderHeaderLines(headersJson))
    if body.len > 0 || method == "POST":
        out = httpProviderConcat(out, "Content-Length: ")
        out = httpProviderConcat(out, httpProviderIntToStr(body.len))
        out = httpProviderConcat(out, "\r\n")
    out = httpProviderConcat(out, "Connection: close\r\n\r\n")
    out = httpProviderConcat(out, body)
    return out

fn httpProviderParseStatus(raw: str): int32 =
    let firstSpace = httpProviderFindByte(raw, 0, ' ')
    if firstSpace < 0 || firstSpace + 4 > raw.len:
        return 0
    return httpProviderParseDecimal(raw, firstSpace + 1, firstSpace + 4)

fn httpProviderBodyOffset(raw: str): int32 =
    var i: int32
    while i + 3 < raw.len:
        if raw[i] == '\r' && raw[i + 1] == '\n' && raw[i + 2] == '\r' && raw[i + 3] == '\n':
            return i + 4
        i = i + 1
    return -1

fn httpProviderHeaderNameMatches(raw: str, start: int32, lineEnd: int32, name: str): bool =
    if start + name.len >= lineEnd:
        return false
    var i: int32
    while i < name.len:
        let actual = raw[start + i]
        let expected = name[i]
        if actual != expected:
            return false
        i = i + 1
    return raw[start + name.len] == ':'

fn httpProviderHeaderContentLength(raw: str, bodyOffset: int32): int32 =
    var lineStart: int32
    while lineStart + 2 < bodyOffset:
        var lineEnd = lineStart
        while lineEnd < bodyOffset && raw[lineEnd] != '\r' && raw[lineEnd] != '\n':
            lineEnd = lineEnd + 1
        if httpProviderHeaderNameMatches(raw, lineStart, lineEnd, "Content-Length") ||
           httpProviderHeaderNameMatches(raw, lineStart, lineEnd, "content-length"):
            var valueStart = lineStart + 15
            while valueStart < lineEnd && (raw[valueStart] == ' ' || raw[valueStart] == '\t'):
                valueStart = valueStart + 1
            if valueStart >= lineEnd:
                return -1
            return httpProviderParseDecimal(raw, valueStart, lineEnd)
        lineStart = lineEnd + 1
        if lineStart < bodyOffset && raw[lineStart] == '\n':
            lineStart = lineStart + 1
    return -1

fn httpProviderReadPipeAll(stream: ptr): str =
    if stream == nil:
        return ""
    let buf = clib_calloc(int64(HttpRecvChunkBytes), int64(1))
    if buf == nil:
        return ""
    let cap = HttpCurlMaxResponseBytes
    var totalLen: int32
    var totalRaw = clib_calloc(int64(cap) + int64(1), int64(1))
    if totalRaw == nil:
        clib_free(buf)
        return ""
    while true:
        let n = clib_fread(buf, int64(1), int64(HttpRecvChunkBytes), stream)
        if n <= int64(0):
            break
        let n32 = int32(n)
        let needed = totalLen + n32 + 1
        if needed > cap:
            clib_free(totalRaw)
            clib_free(buf)
            return ""
        clib_memcpy(httpProviderPtrAdd(totalRaw, totalLen), buf, int64(n32))
        totalLen = totalLen + n32
    clib_free(buf)
    if totalLen <= 0:
        clib_free(totalRaw)
        return ""
    return httpProviderOwnedStr(totalRaw, totalLen)

fn httpProviderCreateTempFile(templateText: str, outPath: var str, outFd: var int32): bool =
    outPath = ""
    outFd = -1
    let templateRaw = httpProviderCString(templateText)
    if templateRaw == nil:
        return false
    let fd = clib_mkstemp(templateRaw)
    if fd < 0:
        clib_free(templateRaw)
        return false
    outPath = httpProviderStrFromCStringCopy(templateRaw)
    clib_free(templateRaw)
    outFd = fd
    return true

fn httpProviderUnlinkPath(path: str) =
    if path == "":
        return
    let raw = httpProviderCString(path)
    if raw == nil:
        return
    clib_unlink(raw)
    clib_free(raw)

fn httpProviderCurlConfigEscape(value: str, outEscaped: var str): bool =
    outEscaped = ""
    var i: int32
    while i < value.len:
        let ch = value[i]
        if ch == '\r' || ch == '\n' || ch == '\0':
            return false
        if ch == '"':
            outEscaped = httpProviderConcat(outEscaped, "\\\"")
        elif ch == '\\':
            outEscaped = httpProviderConcat(outEscaped, "\\\\")
        else:
            outEscaped = httpProviderConcat(outEscaped, httpProviderSliceBytes(value, i, 1))
        i = i + 1
    return true

fn httpProviderCurlAppendConfigValue(outConfig: var str, key: str, value: str, outError: var str): bool =
    var escaped: str
    if !httpProviderCurlConfigEscape(value, escaped):
        outError = httpProviderConcat("invalid https curl config value for ", key)
        return false
    outConfig = httpProviderConcat(outConfig, key)
    outConfig = httpProviderConcat(outConfig, " = \"")
    outConfig = httpProviderConcat(outConfig, escaped)
    outConfig = httpProviderConcat(outConfig, "\"\n")
    return true

fn httpProviderCurlAppendHeaderConfig(headersJson: str, outConfig: var str, outError: var str): bool =
    var i: int32
    while i < headersJson.len:
        if headersJson[i] != '"':
            i = i + 1
            continue
        var value: str
        let next = httpProviderAppendDecodedJsonString(headersJson, i + 1, value)
        if next < 0:
            outError = "invalid https header json"
            return false
        if !httpProviderCurlAppendConfigValue(outConfig, "header", value, outError):
            return false
        i = next
    return true

fn httpProviderCurlBuildConfig(method: str, url: str, bodyPath: str, headersJson: str, outConfig: var str, outError: var str): bool =
    outConfig = ""
    outError = ""
    if !httpProviderCurlAppendConfigValue(outConfig, "url", url, outError):
        return false
    if !httpProviderCurlAppendConfigValue(outConfig, "request", method, outError):
        return false
    if !httpProviderCurlAppendConfigValue(outConfig, "connect-timeout", "10", outError):
        return false
    if !httpProviderCurlAppendConfigValue(outConfig, "max-time", "120", outError):
        return false
    if !httpProviderCurlAppendHeaderConfig(headersJson, outConfig, outError):
        return false
    if bodyPath != "":
        let bodyRef = httpProviderConcat("@", bodyPath)
        if !httpProviderCurlAppendConfigValue(outConfig, "data-binary", bodyRef, outError):
            return false
    return true

fn httpProviderFindLastSub(text: str, needle: str): int32 =
    if needle.len <= 0 || needle.len > text.len:
        return -1
    var last: int32 = -1
    var i: int32
    while i + needle.len <= text.len:
        var ok: int32 = 1
        var j: int32
        while j < needle.len:
            if ok != 0:
                if text[i + j] != needle[j]:
                    ok = 0
            j = j + 1
        if ok != 0:
            last = i
        i = i + 1
    return last

fn httpProviderCurlParseStatus(text: str, start: int32): int32 =
    var code: int32
    var digits: int32
    var i = start
    while i < text.len && digits < 3:
        let ch = text[i]
        if ch < '0' || ch > '9':
            return 0
        code = code * 10 + (int32(ch) - int32('0'))
        digits = digits + 1
        i = i + 1
    if digits != 3:
        return 0
    return code

fn httpProviderCurlFailureDetail(output: str, markerAt: int32): str =
    if markerAt > 0:
        return httpProviderSliceBytes(output, 0, markerAt)
    if output != "":
        return output
    return "curl returned http status 000"

fn httpProviderCurlRun(configPath: str): str =
    var command = "/usr/bin/curl --silent --show-error --config "
    command = httpProviderConcat(command, configPath)
    command = httpProviderConcat(command, " --output - --write-out '__CHENG_HTTP_STATUS__:%{http_code}' 2>&1")
    let commandRaw = httpProviderCString(command)
    if commandRaw == nil:
        return httpProviderJsonError("https request command allocation failed")
    let modeRaw = httpProviderCString("r")
    if modeRaw == nil:
        clib_free(commandRaw)
        return httpProviderJsonError("https request mode allocation failed")
    let stream = clib_popen(commandRaw, modeRaw)
    clib_free(commandRaw)
    clib_free(modeRaw)
    if stream == nil:
        return httpProviderJsonError("failed to start https request")
    let output = httpProviderReadPipeAll(stream)
    let closeStatus = clib_pclose(stream)
    let markerAt = httpProviderFindLastSub(output, HttpCurlStatusMarker)
    if markerAt < 0:
        if output == "":
            return httpProviderJsonError("https request failed")
        return httpProviderJsonError(httpProviderConcat("https request failed: ", output))
    let status = httpProviderCurlParseStatus(output, markerAt + HttpCurlStatusMarkerLen)
    if status <= 0:
        var detail = httpProviderCurlFailureDetail(output, markerAt)
        if detail == "":
            detail = httpProviderConcat("curl exit status ", httpProviderIntToStr(closeStatus))
        return httpProviderJsonError(httpProviderConcat("https request failed: ", detail))
    return httpProviderJsonSuccessRaw(status, output.data, markerAt)

fn httpProviderCurlHttpsRequest(method: str, url: str, body: str, headers: str): str =
    var bodyPath: str
    var bodyFd: int32
    var needsBodyFile: bool
    if body.len > 0:
        needsBodyFile = true
    if method == "POST":
        needsBodyFile = true
    if needsBodyFile:
        let createdBodyFile = httpProviderCreateTempFile(HttpCurlBodyTemplate, bodyPath, bodyFd)
        if createdBodyFile == false:
            return httpProviderJsonError("failed to create https body temp file")
        let wroteBodyFile = httpProviderSendAll(bodyFd, body)
        if wroteBodyFile == false:
            clib_close(bodyFd)
            httpProviderUnlinkPath(bodyPath)
            return httpProviderJsonError("failed to write https body temp file")
        clib_close(bodyFd)
    var config: str
    var configError: str
    let builtConfig = httpProviderCurlBuildConfig(method, url, bodyPath, headers, config, configError)
    if builtConfig == false:
        httpProviderUnlinkPath(bodyPath)
        return httpProviderJsonError(configError)
    var configPath: str
    var configFd: int32
    let createdConfigFile = httpProviderCreateTempFile(HttpCurlConfigTemplate, configPath, configFd)
    if createdConfigFile == false:
        httpProviderUnlinkPath(bodyPath)
        return httpProviderJsonError("failed to create https config temp file")
    let wroteConfigFile = httpProviderSendAll(configFd, config)
    if wroteConfigFile == false:
        clib_close(configFd)
        httpProviderUnlinkPath(configPath)
        httpProviderUnlinkPath(bodyPath)
        return httpProviderJsonError("failed to write https config temp file")
    clib_close(configFd)
    let result = httpProviderCurlRun(configPath)
    httpProviderUnlinkPath(configPath)
    httpProviderUnlinkPath(bodyPath)
    return result

fn httpProviderRequest(method: str, url: str, body: str, headers: str): str =
    if method != "GET" && method != "POST" && method != "DELETE":
        return httpProviderJsonError("unsupported http method")
    if httpProviderStartsWith(url, "https://"):
        return httpProviderCurlHttpsRequest(method, url, body, headers)
    let urlLen = url.len
    if urlLen < 7:
        return httpProviderJsonError("unsupported or invalid http url")
    if url[0] != 'h' || url[1] != 't' || url[2] != 't' || url[3] != 'p' || url[4] != ':' || url[5] != '/' || url[6] != '/':
        return httpProviderJsonError("unsupported or invalid http url")
    var pos: int32 = 7
    let hostStart: int32 = pos
    while pos < urlLen && url[pos] != ':' && url[pos] != '/':
        pos = pos + 1
    if pos <= hostStart:
        return httpProviderJsonError("unsupported or invalid http url")
    let hostLen: int32 = pos - hostStart
    var port: int32 = 80
    if pos < urlLen && url[pos] == ':':
        pos = pos + 1
        let portStart = pos
        while pos < urlLen && url[pos] >= '0' && url[pos] <= '9':
            pos = pos + 1
        if pos <= portStart:
            return httpProviderJsonError("unsupported or invalid http url")
        port = httpProviderParseDecimal(url, portStart, pos)
        if port <= 0:
            return httpProviderJsonError("unsupported or invalid http url")
    var pathStart: int32 = -1
    var pathLen: int32 = 1
    if pos < urlLen:
        if url[pos] != '/':
            return httpProviderJsonError("unsupported or invalid http url")
        pathStart = pos
        pathLen = urlLen - pos
    let fd = httpProviderConnectPacked(httpProviderParseIpv4Range(url, hostStart, hostLen), port)
    if fd < 0:
        if fd == -10:
            return httpProviderJsonError("connect parse failed")
        if fd == -11:
            return httpProviderJsonError("connect address allocation failed")
        if fd == -12:
            return httpProviderJsonError("socket failed")
        if fd == -13:
            return httpProviderJsonError("connect failed")
        return httpProviderJsonError("connect failed")
    if !httpProviderSendRequestDirect(fd, method, url, hostStart, hostLen, pathStart, pathLen, body, headers):
        clib_close(fd)
        return httpProviderJsonError("send failed")
    let result = httpProviderRecvAllJson(fd)
    clib_close(fd)
    return result

fn httpProviderSseLinePayload(line: str): str =
    if line.len >= 6 && httpProviderSliceBytes(line, 0, 6) == "data: ":
        return httpProviderSliceBytes(line, 6, line.len - 6)
    if line.len >= 5 && httpProviderSliceBytes(line, 0, 5) == "data:":
        return httpProviderSliceBytes(line, 5, line.len - 5)
    return ""

fn httpProviderSseAppendPayload(lines: str, payload: str): str =
    if payload == "":
        return lines
    return httpProviderCat3(lines, payload, "\n")

fn httpProviderSseExtractLines(body: str): str =
    var lines: str
    var start: int32
    var i: int32
    while i <= body.len:
        if i == body.len || body[i] == '\n':
            var end = i
            if end > start && body[end - 1] == '\r':
                end = end - 1
            let line = httpProviderSliceBytes(body, start, end - start)
            lines = httpProviderSseAppendPayload(lines, httpProviderSseLinePayload(line))
            start = i + 1
        i = i + 1
    return lines

fn httpProviderSseFindSlot(handle: int32): int32 =
    if httpSseActive && httpSseHandle == handle:
        return 0
    return -1

fn httpProviderSseAllocSlot(): int32 =
    if !httpSseActive:
        return 0
    return -1

fn httpProviderAsciiByteToStr(value: int32): str =
    if value < 32 || value > 126:
        return ""
    return httpProviderSliceBytes(HttpAsciiPrintable, value - 32, 1)

fn httpProviderSseFrameFromCurrentPayload(): str =
    let raw = httpSseBuffer.data
    if httpSseFramePayloadLen <= 0:
        return ""
    let outRaw = clib_calloc(int64(httpSseFramePayloadLen) + int64(2), int64(1))
    if outRaw == nil:
        return "Ehttp sse frame alloc failed"
    httpProviderWriteByte(outRaw, 0, int32('D'))
    httpSseFrameWriteIndex = 0
    while httpSseFrameWriteIndex < httpSseFramePayloadLen:
        let ch = httpProviderReadByte(raw, httpSseFramePayloadStart + httpSseFrameWriteIndex)
        if ch < 32 || ch > 126:
            clib_free(outRaw)
            return httpProviderConcat("Ehttp sse non-printable payload byte ", httpProviderIntToStr(ch))
        httpProviderWriteByte(outRaw, httpSseFrameWriteIndex + 1, ch)
        httpSseFrameWriteIndex = httpSseFrameWriteIndex + 1
    return httpProviderOwnedStr(outRaw, httpSseFramePayloadLen + 1)

fn httpProviderSseScanAtLineStart(): bool =
    let raw = httpSseBuffer.data
    if httpSseScan == 0:
        return true
    return httpProviderReadByte(raw, httpSseScan - 1) == HttpByteLf

fn httpProviderSseDataAtScan(): bool =
    let raw = httpSseBuffer.data
    if !httpProviderSseScanAtLineStart():
        return false
    return httpProviderReadByte(raw, httpSseScan) == HttpByteD &&
           httpProviderReadByte(raw, httpSseScan + 1) == HttpByteA &&
           httpProviderReadByte(raw, httpSseScan + 2) == HttpByteT &&
           httpProviderReadByte(raw, httpSseScan + 3) == HttpByteA &&
           httpProviderReadByte(raw, httpSseScan + 4) == HttpByteColon

fn httpProviderSseFindNextData(): int32 =
    let raw = httpSseBuffer.data
    httpSseScan = httpSseCursor
    while httpSseScan + 4 < httpSseLen:
        if httpProviderSseDataAtScan():
            httpSsePayloadSkip = 5
            if httpSseScan + httpSsePayloadSkip < httpSseLen && httpProviderReadByte(raw, httpSseScan + httpSsePayloadSkip) == HttpByteSpace:
                httpSsePayloadSkip = 6
            httpSsePayloadEnd = httpSseScan + httpSsePayloadSkip
            while httpSsePayloadEnd < httpSseLen:
                if httpProviderReadByte(raw, httpSsePayloadEnd) == HttpByteLf:
                    break
                httpSsePayloadEnd = httpSsePayloadEnd + 1
            if httpSsePayloadEnd >= httpSseLen && !httpSseDone:
                return 0
            httpSseLineEnd = httpSsePayloadEnd
            if httpSseLineEnd > httpSseScan + httpSsePayloadSkip && httpProviderReadByte(raw, httpSseLineEnd - 1) == HttpByteCr:
                httpSseLineEnd = httpSseLineEnd - 1
            if httpSsePayloadEnd < httpSseLen:
                httpSseCursor = httpSsePayloadEnd + 1
            else:
                httpSseCursor = httpSsePayloadEnd
            httpSseFramePayloadStart = httpSseScan + httpSsePayloadSkip
            httpSseFramePayloadLen = httpSseLineEnd - httpSseFramePayloadStart
            if httpSseFramePayloadLen <= 0:
                return 0
            return 1
        httpSseScan = httpSseScan + 1
    if httpSseDone:
        httpSseCursor = httpSseLen
        return 2
    return 0

fn httpProviderSseNextLine(slot: int32): str =
    let found = httpProviderSseFindNextData()
    if found == 1:
        return httpProviderSseFrameFromCurrentPayload()
    if found == 2:
        return httpProviderConcat("S", httpProviderIntToStr(httpSseStatusCode))
    return ""

@exportc("cheng_http_get")
fn chengHttpGetExport(url: cstring, headers: cstring): cstring =
    let out = httpProviderRequest("GET", httpProviderBoundaryStr(url), "", httpProviderBoundaryStr(headers))
    return httpProviderCStringReturn(out)

@exportc("cheng_http_post")
fn chengHttpPostExport(url: cstring, body: cstring, headers: cstring): cstring =
    let out = httpProviderRequest("POST",
                                  httpProviderBoundaryStr(url),
                                  httpProviderBoundaryStr(body),
                                  httpProviderBoundaryStr(headers))
    return httpProviderCStringReturn(out)

@exportc("cheng_http_delete")
fn chengHttpDeleteExport(url: cstring, headers: cstring): cstring =
    let out = httpProviderRequest("DELETE", httpProviderBoundaryStr(url), "", httpProviderBoundaryStr(headers))
    return httpProviderCStringReturn(out)

@exportc("cheng_http_request_with_timeout")
fn chengHttpRequestWithTimeoutExport(method: cstring, url: cstring, body: cstring, headers: cstring, timeoutSeconds: int32): cstring =
    if timeoutSeconds <= 0:
        return httpProviderCStringReturn(httpProviderJsonError("http timeout_seconds must be positive"))
    let methodText = httpProviderBoundaryStr(method)
    let urlText = httpProviderBoundaryStr(url)
    let bodyText = httpProviderBoundaryStr(body)
    let headersText = httpProviderBoundaryStr(headers)
    let out = httpProviderRequest(methodText, urlText, bodyText, headersText)
    return httpProviderCStringReturn(out)


fn chengHttpSsePostStartInternal(url: str, body: str, headers: str): int32 =
    var hostStart: int32
    var hostLen: int32
    var port: int32
    var pathStart: int32
    var pathLen: int32
    if !httpProviderParseUrlBounds(url, hostStart, hostLen, port, pathStart, pathLen):
        httpProviderLastError = "invalid sse url"
        return -1
    let host = httpProviderSliceBytes(url, hostStart, hostLen)
    var path: str = "/"
    if pathStart >= 0:
        path = httpProviderSliceBytes(url, pathStart, pathLen)
    let fd = httpProviderConnect(host, port)
    if fd < 0:
        let connectError = httpProviderLastError
        if connectError != "":
            httpProviderLastError = httpProviderConcat("sse connect failed: ", connectError)
        else:
            httpProviderLastError = "sse connect failed"
        return -1
    let request = httpProviderBuildRequest("POST", host, path, body, headers)
    if !httpProviderSendAll(fd, request):
        clib_close(fd)
        httpProviderLastError = "sse send failed"
        return -1
    var status: int32
    var closed: bool
    var initialError: str
    httpSseBuffer = ""
    httpSseLen = 0
    httpSseCap = 0
    httpSseCursor = 0
    if !httpProviderReadSseInitialResponse(fd, status, closed, initialError):
        clib_close(fd)
        httpProviderLastError = initialError
        httpSseBuffer = ""
        httpSseLen = 0
        httpSseCap = 0
        return -1
    let slot = httpProviderSseAllocSlot()
    if slot < 0:
        clib_close(fd)
        httpProviderLastError = "sse slot unavailable"
        httpSseBuffer = ""
        httpSseLen = 0
        httpSseCap = 0
        return -1
    let handle = fd
    httpSseActive = true
    httpSseHandle = handle
    httpSseFd = fd
    httpSseLines = ""
    httpSseDone = closed
    httpSseStatusCode = status
    httpSseError = ""
    httpProviderLastError = ""
    return handle

@exportc("cheng_http_sse_poll")
fn chengHttpSsePollExport(handle: int32, timeoutMs: int32): cstring =
    return httpProviderCStringReturn(chengHttpSsePollInternal(handle, timeoutMs))

fn chengHttpSsePollInternal(handle: int32, timeoutMs: int32): str =
    let slot = httpProviderSseFindSlot(handle)
    if slot < 0:
        return "Eunknown sse handle"
    if httpSseError != "":
        return httpProviderConcat("E", httpSseError)
    let buffered = httpProviderSseNextLine(slot)
    if buffered != "":
        return buffered
    if httpSseDone:
        return httpProviderSseNextLine(slot)
    var readError: str
    let readResult = httpProviderReadSocketIntoSseBuffer(handle, timeoutMs, readError)
    if readError != "":
        httpSseError = readError
        return httpProviderConcat("E", readError)
    if readResult == 2:
        httpSseDone = true
        if httpSseFd >= 0:
            clib_close(handle)
            httpSseFd = -1
    return httpProviderSseNextLine(slot)

@exportc("cheng_http_sse_close")
fn chengHttpSseCloseExport(handle: int32): int32 =
    let slot = httpProviderSseFindSlot(handle)
    if slot < 0:
        return -1
    if httpSseFd >= 0:
        clib_close(httpSseFd)
    httpSseActive = false
    httpSseHandle = 0
    httpSseFd = -1
    httpSseBuffer = ""
    httpSseLen = 0
    httpSseCap = 0
    httpSseLines = ""
    httpSseCursor = 0
    httpSseDone = false
    httpSseStatusCode = 0
    httpSseError = ""
    return 0

# ── NDJSON streaming (reuses SSE slot tables, different line format) ───

var httpNdjsonDone: bool

fn httpProviderNdjsonFindNextLine(): int32 =
    let raw = httpSseBuffer.data
    let bodyOffset = httpProviderRawBodyOffset(raw, httpSseLen)
    if bodyOffset < 0:
        return 0
    if httpNdjsonCursorStable < bodyOffset:
        httpNdjsonCursorStable = bodyOffset
    var start: int32
    start = httpNdjsonCursorStable
    if start >= httpSseLen:
        if httpNdjsonDone:
            return 2
        return 0
    let firstByte = httpProviderReadByte(raw, start)
    if firstByte == HttpByteLf:
        httpNdjsonCursorStable = start + 1
        return 0
    if firstByte == HttpByteCr:
        httpNdjsonCursorStable = start + 1
        return 0
    var lineEnd: int32
    lineEnd = start
    while lineEnd < httpSseLen && httpProviderReadByte(raw, lineEnd) != HttpByteLf:
        lineEnd = lineEnd + 1
    if lineEnd >= httpSseLen && !httpNdjsonDone:
        return 0
    var payloadEnd: int32
    payloadEnd = lineEnd
    if payloadEnd > start && httpProviderReadByte(raw, payloadEnd - 1) == HttpByteCr:
        payloadEnd = payloadEnd - 1
    httpSseFramePayloadStart = start
    httpSseFramePayloadLen = payloadEnd - start
    if lineEnd < httpSseLen:
        httpNdjsonCursorStable = lineEnd + 1
    else:
        httpNdjsonCursorStable = lineEnd
    if httpSseFramePayloadLen <= 0:
        return 0
    return 1

fn chengHttpNdjsonPostStartInternal(url: str, body: str, headers: str): int32 =
    httpProviderLastError = ""
    var hostStart: int32
    var hostLen: int32
    var port: int32
    var pathStart: int32
    var pathLen: int32
    if !httpProviderParseUrlBounds(url, hostStart, hostLen, port, pathStart, pathLen):
        httpProviderLastError = "invalid ndjson url"
        return -1
    let host = httpProviderSliceBytes(url, hostStart, hostLen)
    var path: str = "/"
    if pathStart >= 0:
        path = httpProviderSliceBytes(url, pathStart, pathLen)
    let fd = httpProviderConnect(host, port)
    if fd < 0:
        let connectError = httpProviderLastError
        if connectError != "":
            httpProviderLastError = httpProviderConcat("ndjson connect failed: ", connectError)
        else:
            httpProviderLastError = "ndjson connect failed"
        return -1
    let req = httpProviderBuildRequest("POST", host, path, body, headers)
    if !httpProviderSendAll(fd, req):
        clib_close(fd)
        httpProviderLastError = "ndjson send failed"
        return -1
    var status: int32
    var closed: bool
    var initialError: str
    httpSseBuffer = ""
    httpSseLen = 0
    httpSseCap = 0
    httpSseCursor = 0
    if !httpProviderReadSseInitialResponse(fd, status, closed, initialError):
        clib_close(fd)
        httpProviderLastError = initialError
        return -1
    let slot = httpProviderSseAllocSlot()
    if slot < 0:
        clib_close(fd)
        httpProviderLastError = "ndjson slot unavailable"
        return -1
    let bodyOffset = httpProviderRawBodyOffset(httpSseBuffer.data, httpSseLen)
    if bodyOffset < 0:
        clib_close(fd)
        httpProviderLastError = "ndjson response missing body"
        return -1
    let contentLength = httpProviderRawHeaderContentLength(httpSseBuffer.data, bodyOffset)
    if contentLength >= 0:
        let expectedTotal = bodyOffset + contentLength
        let buf = clib_calloc(int64(HttpRecvChunkBytes), int64(1))
        if buf == nil:
            clib_close(fd)
            httpProviderLastError = "ndjson read alloc failed"
            return -1
        while httpSseLen < expectedTotal:
            let n = clib_read(fd, buf, int64(HttpRecvChunkBytes))
            if n <= int64(0):
                clib_free(buf)
                clib_close(fd)
                httpProviderLastError = "ndjson body ended early"
                return -1
            if !httpProviderAppendSseBytes(buf, int32(n)):
                clib_free(buf)
                clib_close(fd)
                httpProviderLastError = "ndjson response grow failed"
                return -1
        clib_free(buf)
        clib_close(fd)
        closed = true
    let handle = httpNextSseHandle
    httpNextSseHandle = httpNextSseHandle + 1
    httpSseActive = true
    httpSseFd = closed ? -1 : fd
    httpSseCursor = bodyOffset
    httpNdjsonCursorStable = bodyOffset
    httpSseHandle = handle
    httpSseDone = closed
    httpNdjsonDone = closed
    httpSseStatusCode = status
    return handle

@exportc("cheng_http_ndjson_poll")
fn chengHttpNdjsonPollExport(handle: int32, timeoutMs: int32): cstring =
    return httpProviderCStringReturn(chengHttpNdjsonPollInternal(handle, timeoutMs))

fn chengHttpNdjsonPollInternal(handle: int32, timeoutMs: int32): str =
    if !httpSseActive || httpSseHandle != handle:
        return "Eunknown ndjson handle"
    var found = httpProviderNdjsonFindNextLine()
    if found == 1:
        return httpProviderSseFrameFromCurrentPayload()
    if found == 2:
        return httpProviderConcat("S", httpProviderIntToStr(httpSseStatusCode))
    var readError: str
    let readResult = httpProviderReadSocketIntoSseBuffer(httpSseFd, timeoutMs, readError)
    if readError != "":
        return httpProviderConcat("E", readError)
    if readResult == 2:
        httpNdjsonDone = true
        httpSseDone = true
        if httpSseFd >= 0:
            clib_close(httpSseFd)
            httpSseFd = -1
    found = httpProviderNdjsonFindNextLine()
    if found == 1:
        return httpProviderSseFrameFromCurrentPayload()
    if found == 2:
        return httpProviderConcat("S", httpProviderIntToStr(httpSseStatusCode))
    return ""

@exportc("cheng_http_ndjson_close")
fn chengHttpNdjsonCloseExport(handle: int32): int32 =
    if !httpSseActive:
        return -1
    httpSseActive = false
    httpSseHandle = 0
    if !httpSseDone && httpSseFd >= 0:
        clib_close(httpSseFd)
    httpSseFd = -1
    httpNdjsonCursorStable = 0
    httpNdjsonDone = false
    httpSseStatusCode = 0
    return 0

# ── Last error ─────────────────────────────────────────────────────────

var httpProviderLastError: str

@exportc("cheng_http_last_error")
fn chengHttpLastErrorExport(): cstring =
    return httpProviderCStringReturn(httpProviderLastError)

@exportc("cheng_http_sse_post_start")
fn chengHttpSsePostStartExport(url: cstring, body: cstring, headers: cstring): int32 =
    let urlText = httpProviderBoundaryStr(url)
    let bodyText = httpProviderBoundaryStr(body)
    let headersText = httpProviderBoundaryStr(headers)
    return chengHttpSsePostStartInternal(urlText, bodyText, headersText)

@exportc("cheng_http_ndjson_post_start")
fn chengHttpNdjsonPostStartExport(url: cstring, body: cstring, headers: cstring): int32 =
    let urlText = httpProviderBoundaryStr(url)
    let bodyText = httpProviderBoundaryStr(body)
    let headersText = httpProviderBoundaryStr(headers)
    return chengHttpNdjsonPostStartInternal(urlText, bodyText, headersText)
