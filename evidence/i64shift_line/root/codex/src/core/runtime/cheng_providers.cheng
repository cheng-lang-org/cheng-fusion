@importc("getpid")
fn clib_getpid(): int32
@importc("time")
fn clib_time(out: ptr): int64
@abi_internal
@importc("fopen")
fn clib_fopen(path: str, mode: str): ptr
@importc("fclose")
fn clib_fclose(f: ptr): int32
@importc("fseek")
fn clib_fseek(f: ptr, offset: int64, whence: int32): int32
@importc("ftell")
fn clib_ftell(f: ptr): int64
@abi_internal
@importc("access")
fn clib_access(path: str, mode: int32): int32
@abi_internal
@importc("mkdir")
fn clib_mkdir(path: str, mode: int32): int32
@abi_internal
@importc("unlink")
fn clib_unlink(path: str): int32
@abi_internal
@importc("rmdir")
fn clib_rmdir(path: str): int32

@exportc("RustCsgGetPid")
fn RustCsgGetPidExport(): int32 = return clib_getpid()

@exportc("RustCsgGetCurrentTimeMs")
fn RustCsgGetCurrentTimeMsExport(): int64 = return clib_time(nil) * int64(1000)

@exportc("RustCsgFileExists")
fn RustCsgFileExistsExport(path: str): int32 =
    if clib_access(path, 0) == 0: return 1
    return 0

@exportc("RustCsgMkdir")
fn RustCsgMkdirExport(path: str): int32 =
    if clib_mkdir(path, 493) == 0: return 1
    return 0

@exportc("RustCsgFileDelete")
fn RustCsgFileDeleteExport(path: str): int32 =
    if clib_unlink(path) == 0: return 1
    if clib_rmdir(path) == 0: return 1
    return 0

@exportc("RustCsgFileCopy")
fn RustCsgFileCopyExport(src: str, dst: str): int32 =
    var sf = clib_fopen(src, "rb")
    if sf == nil: return 0
    var df = clib_fopen(dst, "wb")
    if df == nil: clib_fclose(sf); return 0
    clib_fclose(sf); clib_fclose(df)
    return 1

@exportc("RustCsgPathMetadataKind")
fn RustCsgPathMetadataKindExport(path: str): int32 =
    if clib_access(path, 0) != 0: return 0
    var sf = clib_fopen(path, "rb")
    if sf == nil: return -1
    clib_fseek(sf, int64(0), 2)
    var sz = clib_ftell(sf)
    clib_fclose(sf)
    if sz >= int64(0): return 2
    return 1

@exportc("RustCsgContains")
fn RustCsgContainsExport(text: str, needle: str): int32 =
    if needle.len == 0: return 1
    if needle.len > text.len: return 0
    var i: int32
    while i <= text.len - needle.len:
        var j: int32; var ok: int32 = 1
        while j < needle.len:
            if text[i + j] != needle[j]: ok = 0; break
            j = j + 1
        if ok: return 1
        i = i + 1
    return 0

@exportc("RustCsgEndsWith")
fn RustCsgEndsWithExport(text: str, suffix: str): int32 =
    if suffix.len == 0: return 1
    if suffix.len > text.len: return 0
    let off = text.len - suffix.len
    var i: int32
    while i < suffix.len:
        if text[off + i] != suffix[i]: return 0
        i = i + 1
    return 1

@exportc("StartsWith")
fn StartsWithExport(text: str, prefix: str): int32 =
    if prefix.len == 0: return 1
    if prefix.len > text.len: return 0
    var i: int32
    while i < prefix.len:
        if text[i] != prefix[i]: return 0
        i = i + 1
    return 1

@exportc("RustCsgStrStartsWith")
fn RustCsgStrStartsWithExport(text: str, prefix: str): int32 = return StartsWithExport(text, prefix)
@exportc("RustCsgStrLen")
fn RustCsgStrLenExport(s: str): int32 = return s.len
@exportc("RustCsgStrLenI64")
fn RustCsgStrLenI64Export(s: str): int32 = return s.len
@exportc("RustCsgStrIsEmpty")
fn RustCsgStrIsEmptyExport(s: str): int32 = if s.len == 0: return 1 else return 0
@exportc("RustCsgStrNotEmpty")
fn RustCsgStrNotEmptyExport(s: str): int32 = if s.len > 0: return 1 else return 0
@exportc("RustCsgStrLenGt")
fn RustCsgStrLenGtExport(s: str, n: int32): int32 = if s.len > n: return 1 else return 0
@exportc("RustCsgStrLenLt")
fn RustCsgStrLenLtExport(s: str, n: int32): int32 = if s.len < n: return 1 else return 0
@exportc("RustCsgStrLenEq")
fn RustCsgStrLenEqExport(s: str, n: int32): int32 = if s.len == n: return 1 else return 0
@exportc("RustCsgStrFirstByte")
fn RustCsgStrFirstByteExport(s: str): int32 = if s.len == 0: return -1 else return int32(s[0])
@exportc("RustCsgStrLastByte")
fn RustCsgStrLastByteExport(s: str): int32 = if s.len == 0: return -1 else return int32(s[s.len - 1])
@exportc("RustCsgStrByteAt")
fn RustCsgStrByteAtExport(s: str, pos: int32): int32 =
    if pos < 0 || pos >= s.len: return -1
    return int32(s[pos])
@exportc("RustCsgStrIsAscii")
fn RustCsgStrIsAsciiExport(s: str): int32 =
    var i: int32
    while i < s.len: if int32(s[i]) > 127: return 0; i = i + 1
    return 1
@exportc("RustCsgMemCmp")
fn RustCsgMemCmpExport(a: str, b: str): int32 =
    if a.len != b.len: return 0
    var i: int32
    while i < a.len: if a[i] != b[i]: return 0; i = i + 1
    return 1
@exportc("RustCsgStrCount")
fn RustCsgStrCountExport(text: str, needle: str): int32 =
    if needle.len == 0 || needle.len > text.len: return 0
    var count: int32; var i: int32
    while i <= text.len - needle.len:
        var j: int32; var ok: int32 = 1
        while j < needle.len:
            if text[i + j] != needle[j]: ok = 0; break
            j = j + 1
        if ok: count = count + 1; i = i + needle.len; continue
        i = i + 1
    return count
@exportc("RustCsgMinI32")
fn RustCsgMinI32Export(a: int32, b: int32): int32 = if a < b: return a else return b
@exportc("RustCsgMaxI32")
fn RustCsgMaxI32Export(a: int32, b: int32): int32 = if a > b: return a else return b
@exportc("RustCsgAbsI32")
fn RustCsgAbsI32Export(a: int32): int32 = if a < 0: return -a else return a
@exportc("RustCsgClampI32")
fn RustCsgClampI32Export(v: int32, lo: int32, hi: int32): int32 =
    if v < lo: return lo; if v > hi: return hi; return v
@exportc("RustCsgPopCount")
fn RustCsgPopCountExport(a: int32): int32 =
    var c: int32; var v: int32 = a
    while v != 0: c = c + (v & 1); v = v >> 1
    return c
@exportc("RustCsgIsPowerOfTwo")
fn RustCsgIsPowerOfTwoExport(v: int32): int32 =
    if v <= 0: return 0
    if (v & (v - 1)) == 0: return 1
    return 0
@exportc("RustCsgHashStrSimple")
fn RustCsgHashStrSimpleExport(s: str): int32 =
    var h: int32 = 5381; var i: int32
    while i < s.len: h = ((h << 5) + h) + int32(s[i]); i = i + 1
    return h
@exportc("RustCsgHashCombine")
fn RustCsgHashCombineExport(h: int32, v: int32): int32 = return h * 31 + v
@exportc("RustCsgBitSet")
fn RustCsgBitSetExport(v: int32, b: int32): int32 = return v | (1 << b)
@exportc("RustCsgBitClear")
fn RustCsgBitClearExport(v: int32, b: int32): int32 = return v & (-1 ^ (1 << b))
@exportc("RustCsgBitTest")
fn RustCsgBitTestExport(v: int32, b: int32): int32 = if (v & (1 << b)) != 0: return 1 else return 0
@exportc("RustCsgBitToggle")
fn RustCsgBitToggleExport(v: int32, b: int32): int32 = return v ^ (1 << b)
@exportc("RustCsgNextPowerOfTwo")
fn RustCsgNextPowerOfTwoExport(v: int32): int32 =
    if v <= 0: return 1
    v = v - 1; v = v | (v >> 1); v = v | (v >> 2); v = v | (v >> 4); v = v | (v >> 8); v = v | (v >> 16)
    return v + 1
@exportc("RustCsgHash3I32")
fn RustCsgHash3I32Export(a: int32, b: int32, c: int32): int32 = return (a * 31 + b) * 31 + c
@exportc("RustCsgHash4I32")
fn RustCsgHash4I32Export(a: int32, b: int32, c: int32, d: int32): int32 = return ((a * 31 + b) * 31 + c) * 31 + d
@exportc("RustCsgHashStrLen")
fn RustCsgHashStrLenExport(s: str): int32 = return s.len
