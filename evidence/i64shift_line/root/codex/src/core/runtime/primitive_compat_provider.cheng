    hdr->cap = 0

@exportc("cheng_seq_str_add")
fn cheng_seq_str_add_export(seqPtr: ptr, valuePtr: ptr) =
    if seqPtr == nil:
        primitiveCompatExit(1)
        return
    if valuePtr == nil:
        primitiveCompatExit(1)
        return
    let hdr = PrimitiveCompatSeqHeaderPtr(seqPtr)
    let nextLen = hdr->len + 1
    primitiveCompatSeqGrowInst(seqPtr, nextLen, int32(sizeof(str)))
    let slotRaw = primitiveCompatPtrAdd(hdr->buffer, hdr->len * int32(sizeof(str)))
    primitiveCompatMemcpy(slotRaw, valuePtr, int64(sizeof(str)))
    hdr->len = nextLen

@exportc("cheng_seq_header_len_get")
fn cheng_seq_header_len_get_export(seqPtr: ptr): int32 =
    if seqPtr == nil:
        return 0
    return PrimitiveCompatSeqHeaderPtr(seqPtr)->len

@exportc("cheng_seq_header_len_set")
fn cheng_seq_header_len_set_export(seqPtr: ptr, value: int32) =
    if seqPtr != nil:
        let hdr = PrimitiveCompatSeqHeaderPtr(seqPtr)
        hdr->len = value

@exportc("cheng_seq_header_cap_get")
fn cheng_seq_header_cap_get_export(seqPtr: ptr): int32 =
    if seqPtr == nil:
        return 0
    return PrimitiveCompatSeqHeaderPtr(seqPtr)->cap

@exportc("cheng_seq_header_cap_set")
fn cheng_seq_header_cap_set_export(seqPtr: ptr, value: int32) =
    if seqPtr != nil:
        let hdr = PrimitiveCompatSeqHeaderPtr(seqPtr)
        hdr->cap = value

@exportc("cheng_seq_header_buffer_get")
fn cheng_seq_header_buffer_get_export(seqPtr: ptr): ptr =
    if seqPtr == nil:
        return nil
    return PrimitiveCompatSeqHeaderPtr(seqPtr)->buffer

@exportc("cheng_seq_header_buffer_set")
fn cheng_seq_header_buffer_set_export(seqPtr: ptr, value: ptr) =
    if seqPtr != nil:
        let hdr = PrimitiveCompatSeqHeaderPtr(seqPtr)
        hdr->buffer = value

@exportc("cheng_ptr_seq_get_compat")
fn cheng_ptr_seq_get_compat_export(seqInst: PrimitiveCompatSeqHeader, idx: int32): ptr =
    let slot = cheng_seq_get_export(seqInst.buffer, seqInst.len, idx, int32(sizeof(ptr)))
    if slot == nil:
        return nil
    return load_ptr_export(slot)

@exportc("cheng_ptr_seq_set_compat")
fn cheng_ptr_seq_set_compat_export(seqPtr: PrimitiveCompatSeqHeaderPtr, idx: int32, value: ptr) =
    if seqPtr == nil:
        return
    let slot = cheng_seq_set_export(seqPtr->buffer, seqPtr->len, idx, int32(sizeof(ptr)))
    if slot == nil:
        return
    store_ptr_export(slot, value)

fn primitiveCompatCharAt(text: ptr, index: int32): char =
    return *(ptr(primitiveCompatPtrAdd(text, index)))

fn primitiveCompatIsDigit(c: char): bool =
    if c < '0':
        return false
    if c > '9':
        return false
    return true

fn primitiveCompatIsSpace(c: char): bool =
    if c == ' ':
        return true
    if c == '\t':
        return true
    if c == '\n':
        return true
    if c == '\r':
        return true
    return false

fn primitiveCompatU64Clz(x0: uint64): int32 =
    if x0 == 0:
        return 64
    var x: uint64 = x0
    var n: int32
    while (x & (uint64(1) << uint64(63))) == 0:
        x = x << uint64(1)
        n = n + 1
    return n

fn primitiveCompatU64MaskLoBits(count: int32): uint64 =
    if count <= 0:
        return uint64(0)
    if count >= 64:
        return uint64(0xffffffffffffffff)
    return (uint64(1) << uint64(count)) - uint64(1)

fn primitiveCompatU64ToF64Bits(x: uint64): int64 =
    if x == 0:
        return 0
    let msb = 63 - primitiveCompatU64Clz(x)
    var expBits: uint64 = uint64(msb + 1023)
    var sig: uint64
    if msb <= 52:
        sig = x << uint64(52 - msb)
    else:
        let shift = msb - 52
        let base = x >> uint64(shift)
        let remMask = primitiveCompatU64MaskLoBits(shift)
        let rem = x & remMask
        var rounded: uint64 = base
        if shift > 0:
            let half = uint64(1) << uint64(shift - 1)
            if rem > half:
                rounded = rounded + uint64(1)
            elif rem == half:
                if (base & uint64(1)) == uint64(1):
                    rounded = rounded + uint64(1)
        if rounded >= (uint64(1) << uint64(53)):
            rounded = rounded >> uint64(1)
            expBits = expBits + uint64(1)
        sig = rounded
    let frac = sig & uint64(0x000fffffffffffff)
    return int64((expBits << uint64(52)) | frac)

fn primitiveCompatCanAppendDigit(value: uint64, digit: int32): bool =
    let maxBefore = uint64(0xffffffffffffffff) / uint64(10)
    if value < maxBefore:
        return true
    if value > maxBefore:
        return false
    let maxDigit = uint64(0xffffffffffffffff) - (maxBefore * uint64(10))
    if uint64(digit) <= maxDigit:
        return true
    return false

fn primitiveCompatRatioToF64Bits(num0: uint64, den0: uint64): int64 =
    if num0 == 0:
        return 0
    if den0 == 0:
        return int64(uint64(0x7ff) << uint64(52))

    var n: uint64 = num0
    var d: uint64 = den0
    var exp: int32
    if n >= d:
        var scalingDen: bool = true
        while scalingDen:
            if d <= (uint64(0xffffffffffffffff) >> uint64(1)):
                let doubled = d << uint64(1)
                if n >= doubled:
                    d = doubled
                    exp = exp + 1
                else:
                    scalingDen = false
            else:
                scalingDen = false
    else:
        var scalingNum: bool = true
        while scalingNum:
            if n < d:
                n = n << uint64(1)
                exp = exp - 1
            else:
                scalingNum = false

    var sig: uint64
    var bit: int32 = 52
    while bit >= 0:
        if n >= d:
            sig = sig | (uint64(1) << uint64(bit))
            n = n - d
        n = n << uint64(1)
        bit = bit - 1

    if n > d:
        sig = sig + uint64(1)
    elif n == d:
        if (sig & uint64(1)) == uint64(1):
            sig = sig + uint64(1)

    if sig >= (uint64(1) << uint64(53)):
        sig = sig >> uint64(1)
        exp = exp + 1

    let biased = exp + 1023
    if biased >= 2047:
        return int64(uint64(0x7ff) << uint64(52))
    if biased <= 0:
        return 0
    let frac = sig & uint64(0x000fffffffffffff)
    return int64((uint64(biased) << uint64(52)) | frac)

@exportc("driver_c_chr_i32_compat")
fn driver_c_chr_i32_compat_export(x: int32): char =
    return char(x)

@exportc("driver_c_ord_char_compat")
fn driver_c_ord_char_compat_export(c: char): int32 =
    return int32(c)

@exportc("driver_c_bool_identity")
fn driver_c_bool_identity_export(x: bool): bool =
    return x

@exportc("cheng_bits_to_f64")
fn cheng_bits_to_f64_export(bits: int64): float64 =
    var value: float64
    var copy: int64 = bits
    primitiveCompatMemcpy(&value, &copy, 8)
    return value

@exportc("cheng_f64_to_bits")
fn cheng_f64_to_bits_export(value: float64): int64 =
    var copy: float64 = value
    var bits: int64
    primitiveCompatMemcpy(&bits, &copy, 8)
    return bits

@exportc("cheng_i64_to_f64_bits")
fn primitiveCompatI64ToF64Bits(value: int64): int64 =
    if value == 0:
        return 0
    var sign: uint64
    var mag: uint64
    if value < 0:
        sign = uint64(1) << uint64(63)
        mag = uint64(0) - uint64(value)
    else:
        mag = uint64(value)
    let magBits = uint64(primitiveCompatU64ToF64Bits(mag))
    return int64(sign | magBits)

@exportc("cheng_parse_f64_bits")
fn cheng_parse_f64_bits_export(text: ptr): int64 =
    if text == nil:
        return 0

    var i: int32
    var scanningSpace: bool = true
    while scanningSpace:
        let c = primitiveCompatCharAt(text, i)
        if primitiveCompatIsSpace(c):
            i = i + 1
        else:
            scanningSpace = false

    var neg: bool
    let c0 = primitiveCompatCharAt(text, i)
    if c0 == '-':
        neg = true
        i = i + 1
    elif c0 == '+':
        i = i + 1

    var mantissa: uint64
    var scale: int32
    var anyDigit: bool
    var readingInt: bool = true
    while readingInt:
        let ch = primitiveCompatCharAt(text, i)
        if primitiveCompatIsDigit(ch):
            anyDigit = true
            let d = int32(ch) - int32('0')
            if primitiveCompatCanAppendDigit(mantissa, d):
                mantissa = (mantissa * uint64(10)) + uint64(d)
            i = i + 1
        else:
            readingInt = false

    var anyFrac: bool
    let dot = primitiveCompatCharAt(text, i)
    if dot == '.':
        i = i + 1
        var readingFrac: bool = true
        while readingFrac:
            let ch = primitiveCompatCharAt(text, i)
            if primitiveCompatIsDigit(ch):
                anyDigit = true
                anyFrac = true
                let d = int32(ch) - int32('0')
                if scale < 18:
                    if primitiveCompatCanAppendDigit(mantissa, d):
                        mantissa = (mantissa * uint64(10)) + uint64(d)
                        scale = scale + 1
                i = i + 1
            else:
                readingFrac = false

    if !anyDigit:
        if neg:
            return int64(uint64(1) << uint64(63))
        return 0
    var den: uint64 = uint64(1)
    var scaleIndex: int32
    while scaleIndex < scale:
        den = den * uint64(10)
        scaleIndex = scaleIndex + 1
    var outBits = primitiveCompatRatioToF64Bits(mantissa, den)
    if neg:
        outBits = int64(uint64(outBits) | (uint64(1) << uint64(63)))
    return outBits

@exportc("cheng_f64_bits_is_nan")
fn cheng_f64_bits_is_nan_export(bits: int64): bool =
    let value = cheng_bits_to_f64_export(bits)
    return value != value

@exportc("cheng_f64_bits_is_zero")
fn cheng_f64_bits_is_zero_export(bits: int64): bool =
    let value = cheng_bits_to_f64_export(bits)
    return value == 0.0

@exportc("cheng_f64_bits_order")
fn cheng_f64_bits_order_export(bits: int64): uint64 =
    let raw = uint64(bits)
    let signMask = uint64(1) << uint64(63)
    if (raw & signMask) != 0:
        return raw ^ uint64(0xffffffffffffffff)
    return raw | signMask
