        return nil
    primitiveCompatWriteByte(out, 0, uint8(int32('-')))
    if digitCount > 0:
        primitiveCompatMemcpy(primitiveCompatPtrAdd(out, 1), digits, int64(digitCount))
    cheng_free_export(digits)
    return out

