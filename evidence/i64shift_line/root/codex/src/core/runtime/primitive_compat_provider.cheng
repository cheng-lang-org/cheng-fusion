fn primitiveCompatSeqAllocBytes(cap: int32, elemSize: int32): int32 =
    if cap <= 0:
        return 0
    if elemSize <= 0:
        primitiveCompatExit(1)
        return 0
    let bytes = int64(cap) * int64(elemSize)
    if bytes <= 0:
        primitiveCompatExit(1)
        return 0
    if bytes > 2147483647:
        primitiveCompatExit(1)
        return 0
    return int32(bytes)

fn primitiveCompatSeqNextCap(curCap: int32, needLen: int32): int32 =
    var out: int32 = curCap
    if out < 4:
        out = 4
    while out < needLen:
        let grown = out + (out / 2)
        if grown <= out:
            out = needLen
        else:
            out = grown
    return out

fn primitiveCompatSeqGrowInst(seqPtr: ptr, minCap: int32, elemSize: int32) =
    if seqPtr == nil:
        primitiveCompatExit(1)
        return
    if elemSize <= 0:
        primitiveCompatExit(1)
        return
    let hdr = PrimitiveCompatSeqHeaderPtr(seqPtr)
    if hdr->len < 0:
        primitiveCompatExit(1)
        return
    if hdr->cap < hdr->len:
        primitiveCompatExit(1)
        return
    if minCap <= hdr->cap:
        if hdr->buffer != nil:
            return
    let newCap = primitiveCompatSeqNextCap(hdr->cap, minCap)
    let newBytes = primitiveCompatSeqAllocBytes(newCap, elemSize)
    let newBuffer = cheng_malloc_export(newBytes)
    if newBuffer == nil:
        primitiveCompatExit(1)
        return
    primitiveCompatMemset(newBuffer, 0, int64(newBytes))
    if hdr->buffer != nil:
        let oldBytes = primitiveCompatSeqAllocBytes(hdr->len, elemSize)
        if oldBytes > 0:
            primitiveCompatMemcpy(newBuffer, hdr->buffer, int64(oldBytes))
        cheng_free_export(hdr->buffer)
    hdr->buffer = newBuffer
    hdr->cap = newCap

