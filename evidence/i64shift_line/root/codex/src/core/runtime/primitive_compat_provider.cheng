fn primitiveCompatU64ToCString(value0: uint64): ptr =
    if value0 == uint64(0):
        return driver_c_new_string_copy_n_export("0", 1)
    var value: uint64 = value0
    var scratch: uint8[32]
    var pos: int32 = 32
    while value > uint64(0):
        pos = pos - 1
        let digit = int32(value % uint64(10))
        scratch[pos] = uint8(int32('0') + digit)
        value = value / uint64(10)
    let count = 32 - pos
    let out = driver_c_new_string_export(count)
    if out == nil:
        return nil
    var i: int32
    while i < count:
        primitiveCompatWriteByte(out, i, scratch[pos + i])
        i = i + 1
    return out

