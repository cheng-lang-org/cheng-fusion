@importc("socket")
fn clib_socket(domain: int32, kind: int32, protocol: int32): int32
@importc("bind")
fn clib_bind(fd: int32, addr: ptr, addrLen: int32): int32
@importc("listen")
fn clib_listen(fd: int32, backlog: int32): int32
@importc("accept")
fn clib_accept(fd: int32, addr: ptr, addrLen: ptr): int32
@importc("send")
fn clib_send(fd: int32, buf: ptr, len: int64, flags: int32): int64
@importc("recv")
fn clib_recv(fd: int32, buf: ptr, len: int64, flags: int32): int64
@importc("close")
fn clib_close(fd: int32): int32
@importc("select")
fn clib_select(nfds: int32, readfds: ptr, writefds: ptr, exceptfds: ptr, timeout: ptr): int32
@importc("poll")
fn clib_poll(fds: ptr, nfds: int32, timeoutMs: int32): int32
@importc("calloc")
fn clib_calloc(count: int64, size: int64): ptr
@importc("free")
fn clib_free(raw: ptr)
@importc("getsockname")
fn clib_getsockname(fd: int32, addr: ptr, addrLen: ptr): int32
@importc("setsockopt")
fn clib_setsockopt(fd: int32, level: int32, optname: int32, optval: ptr, optlen: int32): int32
@importc("unlink")
fn clib_unlink(pathname: ptr): int32
@importc("open")
fn clib_open(path: ptr, flags: int32): int32
@importc("read")
fn clib_read(fd: int32, buf: ptr, count: int64): int64
@importc("memcpy")
fn clib_memcpy(dst: ptr, src: ptr, n: int64): ptr
@importc("getenv")
fn clib_getenv(name: ptr): ptr
@importc("CC_SHA1")
fn clibCCSha1(data: ptr, len: uint32, md: ptr): ptr
@importc("ptr_add")
fn sockPtrAddRaw(p: ptr, off: int32): ptr
@importc("cheng_rawmem_write_i8")
fn sockWriteI8Raw(dst: ptr, idx: int32, v: int8)

type
    SocketUInt8Ptr = uint8 *

const AF_INET: int32 = 2
const AF_UNIX: int32 = 1
const SOCK_STREAM: int32 = 1
const SOMAXCONN: int32 = 128
const POLLIN: int32 = 1
const POLLERR: int32 = 8
const POLLHUP: int32 = 16
const POLLNVAL: int32 = 32
const SOL_SOCKET: int32 = 65535
const SO_REUSEADDR: int32 = 4
const SO_NOSIGPIPE: int32 = 4130
const MSG_PEEK: int32 = 2
const MSG_DONTWAIT: int32 = 128
const SOCKADDR_LEN: int32 = 16
const SOCKADDR_UN_LEN: int32 = 106
const SOCKADDR_UN_MAX: int32 = 104
var wsFrameStashRecords: str

fn sockPtrAdd(p: ptr, off: int32): ptr =
    return sockPtrAddRaw(p, off)

fn sockWriteByte(raw: ptr, index: int32, value: int32) =
    sockWriteI8Raw(raw, index, int8(value & 255))

fn sockReadByte(raw: ptr, index: int32): int32 =
    return int32(*(SocketUInt8Ptr(sockPtrAdd(raw, index)))) & 255

fn sockMemSet(raw: ptr, value: int32, count: int32) =
    var i: int32
    while i < count:
        sockWriteByte(raw, i, value)
        i = i + 1

fn sockConcat(a: str, b: str): str =
    let lenA: int32 = a.len
    let lenB: int32 = b.len
    let total: int32 = lenA + lenB
    if total <= 0:
        return ""
    let raw = clib_calloc(int64(total) + int64(1), int64(1))
    if raw == nil:
        return ""
    if lenA > 0 && a.data != nil:
        clib_memcpy(raw, a.data, int64(lenA))
    if lenB > 0 && b.data != nil:
        clib_memcpy(sockPtrAdd(raw, lenA), b.data, int64(lenB))
    var out: str
    out.data = raw
    out.len = total
    return out

fn sockSliceBytes(text: str, start: int32, count: int32): str =
    if text.data == nil || text.len <= 0 || count <= 0:
        return ""
    var start0: int32 = start
    if start0 < 0:
        start0 = 0
    if start0 >= text.len:
        return ""
    var kept: int32 = count
    if start0 + kept > text.len:
        kept = text.len - start0
    if kept <= 0:
        return ""
    var out: str
    out.data = sockPtrAdd(text.data, start0)
    out.len = kept
    return out

fn sockInt32ToDecStr(value: int32): str =
    if value == -2147483648:
        return "-2147483648"
    let raw = clib_calloc(int64(16), int64(1))
    if raw == nil:
        return ""
    var n: int32 = value
    var negative: bool
    if n < 0:
        negative = true
        n = 0 - n
    var digits: int32[12]
    var digitCount: int32
    if n == 0:
        digits[0] = 0
        digitCount = 1
    else:
        while n > 0:
            digits[digitCount] = n % 10
            digitCount = digitCount + 1
            n = n / 10
    var pos: int32
    if negative:
        sockWriteByte(raw, pos, int32('-'))
        pos = pos + 1
    while digitCount > 0:
        digitCount = digitCount - 1
        sockWriteByte(raw, pos, int32('0') + digits[digitCount])
        pos = pos + 1
    var out: str
    out.data = raw
    out.len = pos
    return out

fn providerCString(s: str): ptr =
    let len: int64 = int64(s.len)
    let buf = clib_calloc(len + int64(1), int64(1))
    if buf == nil: return nil
    var i: int64
    while i < len:
        sockWriteI8Raw(buf, int32(i), int8(int32(s[int32(i)])))
        i = i + int64(1)
    sockWriteI8Raw(buf, int32(len), int8(0))
    return buf

fn sockDisableSigpipe(fd: int32) =
    let opt = clib_calloc(int64(4), int64(1))
    if opt == nil:
        return
    sockWriteI8Raw(opt, 0, int8(1))
    clib_setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, opt, 4)
    clib_free(opt)

fn sockSetReuseAddr(fd: int32) =
    let opt = clib_calloc(int64(4), int64(1))
    if opt == nil:
        return
    sockWriteI8Raw(opt, 0, int8(1))
    clib_setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, opt, 4)
    clib_free(opt)

fn sockStrFromBytes(raw: ptr, count: int32): str =
    if raw == nil || count <= 0:
        return ""
    var out: str
    out.data = raw
    out.len = count
    return out

fn wsHexDigit(value: int32): str =
    return sockSliceBytes("0123456789abcdef", value & 15, 1)

fn wsHexValue(ch: int32): int32 =
    if ch >= int32('0') && ch <= int32('9'):
        return ch - int32('0')
    if ch >= int32('a') && ch <= int32('f'):
        return ch - int32('a') + 10
    if ch >= int32('A') && ch <= int32('F'):
        return ch - int32('A') + 10
    return -1

fn wsHexEncode(data: str): str =
    var out: str
    var i: int32
    while i < data.len:
        let byte = int32(data[i]) & 255
        out = sockConcat(out, wsHexDigit((byte >> 4) & 15))
        out = sockConcat(out, wsHexDigit(byte & 15))
        i = i + 1
    return out

fn wsHexDecode(hex: str): str =
    if hex.len == 0:
        return ""
    if (hex.len % 2) != 0:
        return ""
    let outLen = hex.len / 2
    let raw = clib_calloc(int64(outLen) + int64(1), int64(1))
    if raw == nil:
        return ""
    var i: int32
    while i < outLen:
        let hi = wsHexValue(int32(hex[i * 2]))
        let lo = wsHexValue(int32(hex[i * 2 + 1]))
        if hi < 0 || lo < 0:
            clib_free(raw)
            return ""
        sockWriteI8Raw(raw, i, int8(((hi << 4) | lo) & 255))
        i = i + 1
    let out = sockStrFromBytes(raw, outLen)
    return out

fn wsStartsWith(text: str, prefix: str): bool =
    if prefix.len > text.len:
        return false
    var i: int32
    while i < prefix.len:
        if text[i] != prefix[i]:
            return false
        i = i + 1
    return true

fn wsFrameStashPrefix(fd: int32): str =
    return sockConcat(sockInt32ToDecStr(fd), ":")

fn wsFrameStashTake(fd: int32): str =
    let prefix = wsFrameStashPrefix(fd)
    var nextRecords: str
    var out: str
    var start: int32
    while start <= wsFrameStashRecords.len:
        var endPos = start
        while endPos < wsFrameStashRecords.len && wsFrameStashRecords[endPos] != '\n':
            endPos = endPos + 1
        if endPos > start:
            let line = sockSliceBytes(wsFrameStashRecords, start, endPos - start)
            if wsStartsWith(line, prefix):
                let encoded = sockSliceBytes(line, prefix.len, line.len - prefix.len)
                out = sockConcat(out, wsHexDecode(encoded))
            else:
                nextRecords = sockConcat(nextRecords, line)
                nextRecords = sockConcat(nextRecords, "\n")
        start = endPos + 1
    wsFrameStashRecords = nextRecords
    return out

fn wsFrameStashClear(fd: int32) =
    let _ = wsFrameStashTake(fd)

fn wsFrameStashPut(fd: int32, data: str) =
    if data.len == 0:
        return
    let existing = wsFrameStashTake(fd)
    let merged = sockConcat(existing, data)
    wsFrameStashRecords = sockConcat(wsFrameStashRecords, wsFrameStashPrefix(fd))
    wsFrameStashRecords = sockConcat(wsFrameStashRecords, wsHexEncode(merged))
    wsFrameStashRecords = sockConcat(wsFrameStashRecords, "\n")

fn sockPollRevents(fd: int32, timeoutMs: int32): int32 =
    if fd < 0:
        return -1
    let pollFd = clib_calloc(int64(8), int64(1))
    if pollFd == nil:
        return -1
    sockWriteByte(pollFd, 0, fd & 255)
    sockWriteByte(pollFd, 1, (fd >> 8) & 255)
    sockWriteByte(pollFd, 2, (fd >> 16) & 255)
    sockWriteByte(pollFd, 3, (fd >> 24) & 255)
    let events = POLLIN | POLLHUP | POLLERR | POLLNVAL
    sockWriteByte(pollFd, 4, events & 255)
    sockWriteByte(pollFd, 5, (events >> 8) & 255)
    let ready = clib_poll(pollFd, 1, timeoutMs)
    let revents = sockReadByte(pollFd, 6) | (sockReadByte(pollFd, 7) << 8)
    clib_free(pollFd)
    if ready < 0:
        return -1
    if ready == 0:
        return 0
    return revents

fn parseint32(text: str, start: int32, end: int32): int32 =
    var out: int32
    var i = start
    while i < end:
        let ch = int32(text[i])
        if ch < int32('0') || ch > int32('9'): return -1
        out = out * 10 + (ch - int32('0'))
        i = i + 1
    return out

fn buildSockaddrIn(host: str, port: int32): ptr =
    # Parse IPv4 on the fly into sockaddr bytes
    let addr = clib_calloc(int64(SOCKADDR_LEN), int64(1))
    if addr == nil: return nil
    sockMemSet(addr, 0, SOCKADDR_LEN)
    sockWriteByte(addr, 1, AF_INET)
    sockWriteByte(addr, 2, (port >> 8) & 255)
    sockWriteByte(addr, 3, port & 255)
    if host == "localhost":
        sockWriteByte(addr, 4, 127)
        sockWriteByte(addr, 5, 0)
        sockWriteByte(addr, 6, 0)
        sockWriteByte(addr, 7, 1)
        return addr
    var part: int32 = -1
    var octet: int32
    var i: int32
    while i <= host.len:
        if i < host.len && host[i] >= '0' && host[i] <= '9':
            octet = octet * 10 + (int32(host[i]) - int32('0'))
            if octet > 255: clib_free(addr); return nil
            i = i + 1
        elif i == host.len || host[i] == '.':
            part = part + 1
            if part > 3: clib_free(addr); return nil
            if part == 3: sockWriteByte(addr, 7, octet)
            elif part == 2: sockWriteByte(addr, 6, octet)
            elif part == 1: sockWriteByte(addr, 5, octet)
            else: sockWriteByte(addr, 4, octet)
            octet = 0
            i = i + 1
        else: clib_free(addr); return nil
    if part != 3: clib_free(addr); return nil
    return addr

fn buildSockaddrUn(path: str, outLen: var int32): ptr =
    let addr = clib_calloc(int64(SOCKADDR_UN_LEN), int64(1))
    if addr == nil: outLen = 0; return nil
    outLen = 2 + path.len
    sockMemSet(addr, 0, SOCKADDR_UN_LEN)
    sockWriteByte(addr, 1, AF_UNIX)
    var i: int32
    while i < path.len && i < SOCKADDR_UN_MAX:
        sockWriteByte(addr, 2 + i, int32(path[i]))
        i = i + 1
    return addr

# ── TCP ──

@abi_internal
@exportc("RustCsgTcpListen")
fn RustCsgTcpListenExport(host: str, port: int32): int32 =
    let fd = clib_socket(AF_INET, SOCK_STREAM, 0)
    if fd < 0: return -1
    sockSetReuseAddr(fd)
    let addr = buildSockaddrIn(host, port)
    if addr == nil: clib_close(fd); return -1
    if clib_bind(fd, addr, SOCKADDR_LEN) != 0: clib_free(addr); clib_close(fd); return -1
    clib_free(addr)
    if clib_listen(fd, SOMAXCONN) != 0: clib_close(fd); return -1
    return fd

@abi_internal
@exportc("RustCsgTcpAccept")
fn RustCsgTcpAcceptExport(listenFd: int32): int32 =
    let fd = clib_accept(listenFd, nil, nil)
    if fd < 0: return -1
    sockDisableSigpipe(fd)
    wsFrameStashClear(fd)
    return fd

@abi_internal
@exportc("RustCsgTcpLocalPort")
fn RustCsgTcpLocalPortExport(listenFd: int32): int32 =
    let addr = clib_calloc(int64(SOCKADDR_LEN), int64(1))
    if addr == nil: return -1
    let lenSlot = clib_calloc(int64(4), int64(1))
    if lenSlot == nil: clib_free(addr); return -1
    sockWriteI8Raw(lenSlot, 0, int8(SOCKADDR_LEN))
    if clib_getsockname(listenFd, addr, lenSlot) != 0: clib_free(addr); clib_free(lenSlot); return -1
    let portHi = sockReadByte(addr, 2)
    let portLo = sockReadByte(addr, 3)
    clib_free(addr); clib_free(lenSlot)
    return (portHi << 8) | portLo

# ── Unix ──

@abi_internal
@exportc("RustCsgUnixListen")
fn RustCsgUnixListenExport(path: str): int32 =
    let fd = clib_socket(AF_UNIX, SOCK_STREAM, 0)
    if fd < 0: return -1
    var addrLen: int32
    let addr = buildSockaddrUn(path, addrLen)
    if addr == nil: clib_close(fd); return -1
    let cPath = providerCString(path)
    if cPath != nil: clib_unlink(cPath); clib_free(cPath)
    if clib_bind(fd, addr, addrLen) != 0: clib_free(addr); clib_close(fd); return -1
    clib_free(addr)
    if clib_listen(fd, SOMAXCONN) != 0: clib_close(fd); return -1
    return fd

@abi_internal
@exportc("RustCsgUnixAccept")
fn RustCsgUnixAcceptExport(listenFd: int32): int32 =
    let fd = clib_accept(listenFd, nil, nil)
    if fd < 0: return -1
    sockDisableSigpipe(fd)
    wsFrameStashClear(fd)
    return fd

# ── Socket ──

@abi_internal
@exportc("RustCsgSocketClose")
fn RustCsgSocketCloseExport(fd: int32): int32 =
    wsFrameStashClear(fd)
    return clib_close(fd)

@abi_internal
@exportc("RustCsgSocketRead")
fn RustCsgSocketReadExport(fd: int32, maxBytes: int32): str =
    if fd < 0 || maxBytes <= 0:
        return ""
    var readMax = maxBytes
    if readMax > 65536:
        readMax = 65536
    let buf = clib_calloc(int64(readMax), int64(1))
    if buf == nil:
        return ""
    let n = clib_read(fd, buf, int64(readMax))
    if n <= int64(0):
        clib_free(buf)
        return ""
    let out = sockStrFromBytes(buf, int32(n))
    return out

fn sockSendAllRaw(fd: int32, data: ptr, dataLen: int32): bool =
    if dataLen <= 0:
        return true
    if data == nil:
        return false
    sockDisableSigpipe(fd)
    var sent: int32
    while sent < dataLen:
        let n: int64 = clib_send(fd, sockPtrAdd(data, sent), int64(dataLen - sent), 0)
        if n <= int64(0):
            return false
        sent = sent + int32(n)
    return true

fn sockSendAllStr(fd: int32, data: str): bool =
    return sockSendAllRaw(fd, data.data, data.len)

@abi_internal
@exportc("RustCsgSocketWrite")
fn RustCsgSocketWriteExport(fd: int32, data: str): int32 =
    let dLen = data.len
    if dLen == 0: return 0
    if !sockSendAllStr(fd, data):
        return -1
    return dLen

@abi_internal
@exportc("RustCsgSocketReadable")
fn RustCsgSocketReadableExport(fd: int32, timeoutMs: int32): int32 =
    let revents = sockPollRevents(fd, timeoutMs)
    if revents < 0:
        return -1
    if (revents & (POLLIN | POLLHUP | POLLERR | POLLNVAL)) != 0:
        return 1
    return 0

# ── WebSocket ──

fn wsSendAll(fd: int32, data: str): bool =
    return sockSendAllStr(fd, data)

fn wsRecvByte(fd: int32, outByte: var int32): bool =
    let buf = clib_calloc(int64(1), int64(1))
    if buf == nil: return false
    let n = clib_read(fd, buf, int64(1))
    if n != int64(1): clib_free(buf); return false
    outByte = sockReadByte(buf, 0)
    clib_free(buf)
    return true

fn wsRecvExact(fd: int32, len: int32): str =
    var out: str
    var total: int32
    let buf = clib_calloc(int64(1), int64(1))
    if buf == nil: return ""
    while total < len:
        let n = clib_read(fd, buf, int64(1))
        if n != int64(1): clib_free(buf); return ""
        let ch = sockReadByte(buf, 0)
        out = sockConcat(out, wsByteToStr(ch))
        total = total + 1
    clib_free(buf)
    return out

fn wsBase64Encode20(hashBuf: ptr): str =
    var out: str
    var pos: int32
    while pos < 20:
        let b0 = sockReadByte(hashBuf, pos)
        var b1: int32
        var b2: int32
        if pos + 1 < 20: b1 = sockReadByte(hashBuf, pos + 1)
        if pos + 2 < 20: b2 = sockReadByte(hashBuf, pos + 2)
        let trip = (b0 << 16) | (b1 << 8) | b2
        out = sockConcat(out, sockSliceBytes("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/", (trip >> 18) & 63, 1))
        out = sockConcat(out, sockSliceBytes("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/", (trip >> 12) & 63, 1))
        if pos + 1 < 20:
            out = sockConcat(out, sockSliceBytes("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/", (trip >> 6) & 63, 1))
        else: out = sockConcat(out, "=")
        if pos + 2 < 20:
            out = sockConcat(out, sockSliceBytes("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/", trip & 63, 1))
        else: out = sockConcat(out, "=")
        pos = pos + 3
    return out

fn wsByteToStr(value: int32): str =
    let raw = clib_calloc(int64(1), int64(1))
    if raw == nil:
        return ""
    sockWriteI8Raw(raw, 0, int8(value & 255))
    return sockStrFromBytes(raw, 1)

fn wsBase64EncodeBytes(data: str): str =
    var out: str
    let table = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    var i: int32
    while i < data.len:
        let b0 = int32(data[i]) & 255
        i = i + 1
        var b1: int32
        var b2: int32
        var hasB1: bool
        var hasB2: bool
        if i < data.len:
            b1 = int32(data[i]) & 255
            hasB1 = true
            i = i + 1
        if i < data.len:
            b2 = int32(data[i]) & 255
            hasB2 = true
            i = i + 1
        out = sockConcat(out, sockSliceBytes(table, (b0 >> 2) & 63, 1))
        if hasB1:
            out = sockConcat(out, sockSliceBytes(table, ((b0 & 3) << 4) | ((b1 >> 4) & 15), 1))
            if hasB2:
                out = sockConcat(out, sockSliceBytes(table, ((b1 & 15) << 2) | ((b2 >> 6) & 3), 1))
                out = sockConcat(out, sockSliceBytes(table, b2 & 63, 1))
            else:
                out = sockConcat(out, sockSliceBytes(table, (b1 & 15) << 2, 1))
                out = sockConcat(out, "=")
        else:
            out = sockConcat(out, sockSliceBytes(table, (b0 & 3) << 4, 1))
            out = sockConcat(out, "==")
    return out

fn wsStrByteAt(text: str, pos: int32): str =
    if pos < 0 || pos >= text.len:
        return ""
    return sockSliceBytes(text, pos, 1)

fn wsFindHeader(requestHeaders: str, headerName: str): str =
    var i: int32
    while i < requestHeaders.len:
        var atLineStart: bool
        if i == 0:
            atLineStart = true
        else:
            if wsStrByteAt(requestHeaders, i - 1) == "\n":
                atLineStart = true
        if atLineStart:
            var matched: bool = true
            var j: int32
            while j < headerName.len:
                if i + j >= requestHeaders.len:
                    matched = false
                    break
                if wsStrByteAt(requestHeaders, i + j) != wsStrByteAt(headerName, j):
                    matched = false
                    break
                j = j + 1
            if matched:
                var pos = i + headerName.len
                while pos < requestHeaders.len:
                    let ch = wsStrByteAt(requestHeaders, pos)
                    if ch != ":" && ch != " " && ch != "\t":
                        break
                    pos = pos + 1
                let start = pos
                while pos < requestHeaders.len:
                    let ch = wsStrByteAt(requestHeaders, pos)
                    if ch == "\r" || ch == "\n":
                        break
                    pos = pos + 1
                var endPos = pos
                while endPos > start:
                    let ch = wsStrByteAt(requestHeaders, endPos - 1)
                    if ch != " " && ch != "\t":
                        break
                    endPos = endPos - 1
                return sockSliceBytes(requestHeaders, start, endPos - start)
        i = i + 1
    return ""

@abi_internal
@exportc("RustCsgWebSocketAcceptRequest")
fn RustCsgWebSocketAcceptRequestExport(clientFd: int32, requestHeaders: str): int32 =
    if clientFd < 0:
        return -1
    let key = wsFindHeader(requestHeaders, "Sec-WebSocket-Key")
    if key == "":
        return -1
    let combined = sockConcat(key, "258EAFA5-E914-47DA-95CA-C5AB0DC85B11")
    let combinedRaw = providerCString(combined)
    if combinedRaw == nil:
        return -1
    let digest = clib_calloc(int64(20), int64(1))
    if digest == nil:
        clib_free(combinedRaw)
        return -1
    let digestPtr = clibCCSha1(combinedRaw, uint32(combined.len), digest)
    clib_free(combinedRaw)
    if digestPtr == nil:
        clib_free(digest)
        return -1
    let acceptValue = wsBase64Encode20(digest)
    clib_free(digest)
    var response = "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: "
    response = sockConcat(response, acceptValue)
    response = sockConcat(response, "\r\n\r\n")
    if !wsSendAll(clientFd, response):
        return -1
    return 0

@abi_internal
@exportc("RustCsgWebSocketAccept")
fn RustCsgWebSocketAcceptExport(clientFd: int32): int32 =
    let request = RustCsgHttpReadRequestExport(clientFd)
    if request == "":
        return -1
    return RustCsgWebSocketAcceptRequestExport(clientFd, request)

fn wsTryParseFrame(data: str, outPayload: var str, outFrameEnd: var int32, outOpcode: var int32): int32 =
    outPayload = ""
    outFrameEnd = 0
    outOpcode = 0
    if data.len < 2:
        return 0
    let b0 = int32(data[0]) & 255
    let b1 = int32(data[1]) & 255
    outOpcode = b0 & 15
    let masked = (b1 & 128) != 0
    var payloadLen: int32 = b1 & 127
    var offset: int32 = 2
    if payloadLen == 126:
        if data.len < 4:
            return 0
        payloadLen = ((int32(data[2]) & 255) << 8) | (int32(data[3]) & 255)
        offset = 4
    elif payloadLen == 127:
        if data.len < 10:
            return 0
        var i64: int32 = 2
        payloadLen = 0
        while i64 < 10:
            let part = int32(data[i64]) & 255
            if payloadLen > 8388607:
                return -1
            payloadLen = (payloadLen << 8) | part
            i64 = i64 + 1
        offset = 10
    if payloadLen < 0 || payloadLen > 1048576:
        return -1
    var maskOffset = offset
    if masked:
        offset = offset + 4
    let frameEnd = offset + payloadLen
    if data.len < frameEnd:
        return 0
    outPayload = wsPayloadString(data, offset, payloadLen, masked, maskOffset)
    if outPayload.len != payloadLen:
        return -1
    outFrameEnd = frameEnd
    return 1

fn wsReadAvailableChunk(fd: int32, maxBytes: int32): str =
    return RustCsgSocketReadExport(fd, maxBytes)

fn wsPeekAvailableChunk(fd: int32, maxBytes: int32): str =
    if fd < 0 || maxBytes <= 0:
        return ""
    var readMax = maxBytes
    if readMax > 65536:
        readMax = 65536
    let buf = clib_calloc(int64(readMax), int64(1))
    if buf == nil:
        return ""
    let n = clib_recv(fd, buf, int64(readMax), MSG_PEEK | MSG_DONTWAIT)
    if n <= int64(0):
        clib_free(buf)
        return ""
    let out = sockStrFromBytes(buf, int32(n))
    return out

fn wsFrameTargetLen(data: str): int32 =
    if data.len < 2:
        return 2
    let b1 = int32(data[1]) & 255
    let masked = (b1 & 128) != 0
    var payloadLen: int32 = b1 & 127
    var offset: int32 = 2
    if payloadLen == 126:
        if data.len < 4:
            return 4
        payloadLen = ((int32(data[2]) & 255) << 8) | (int32(data[3]) & 255)
        offset = 4
    elif payloadLen == 127:
        return -1
    if payloadLen < 0 || payloadLen > 1048576:
        return -1
    if masked:
        offset = offset + 4
    return offset + payloadLen

fn wsReadFrameNonblocking(fd: int32, timeoutMs: int32): str =
    var waitMs = timeoutMs
    while true:
        let revents = sockPollRevents(fd, waitMs)
        if revents < 0:
            return ""
        if (revents & (POLLERR | POLLNVAL)) != 0:
            return ""
        if (revents & POLLIN) == 0:
            if (revents & POLLHUP) != 0:
                return ""
            return "__RUST_CSG_WS_FRAME_BLOCKED__"
        let peek = wsPeekAvailableChunk(fd, 4096)
        if peek == "":
            if (revents & POLLHUP) != 0:
                return ""
            return "__RUST_CSG_WS_FRAME_BLOCKED__"
        let targetLen = wsFrameTargetLen(peek)
        if targetLen < 0:
            return ""
        if peek.len < targetLen:
            if (revents & POLLHUP) != 0:
                return ""
            return "__RUST_CSG_WS_FRAME_BLOCKED__"
        let frame = wsReadAvailableChunk(fd, targetLen)
        if frame.len < targetLen:
            return ""
        let b0 = int32(frame[0]) & 255
        let b1 = int32(frame[1]) & 255
        let opcode = b0 & 15
        let masked = (b1 & 128) != 0
        var payloadLen: int32 = b1 & 127
        var offset: int32 = 2
        if payloadLen == 126:
            payloadLen = ((int32(frame[2]) & 255) << 8) | (int32(frame[3]) & 255)
            offset = 4
        elif payloadLen == 127:
            return ""
        let maskOffset = offset
        if masked:
            offset = offset + 4
        let payload = wsPayloadString(frame, offset, payloadLen, masked, maskOffset)
        if payload.len != payloadLen:
            return ""
        if opcode == 8:
            var closeFrame = wsByteToStr(136)
            closeFrame = sockConcat(closeFrame, wsByteToStr(0))
            wsSendAll(fd, closeFrame)
            return ""
        if opcode == 9:
            var pong = wsByteToStr(138)
            pong = sockConcat(pong, wsByteToStr(payload.len & 255))
            pong = sockConcat(pong, payload)
            wsSendAll(fd, pong)
            waitMs = 0
            continue
        return payload

fn wsPayloadString(data: str, offset: int32, payloadLen: int32, masked: bool, maskOffset: int32): str =
    if payloadLen <= 0:
        return ""
    let raw = clib_calloc(int64(payloadLen), int64(1))
    if raw == nil:
        return ""
    var j: int32
    while j < payloadLen:
        var ch = int32(data[offset + j]) & 255
        if masked:
            ch = ch ^ (int32(data[maskOffset + (j % 4)]) & 255)
        sockWriteI8Raw(raw, j, int8(ch & 255))
        j = j + 1
    return sockStrFromBytes(raw, payloadLen)

fn wsPayloadStringRaw(data: ptr, offset: int32, payloadLen: int32, masked: bool, maskOffset: int32): str =
    if payloadLen <= 0:
        return ""
    let raw = clib_calloc(int64(payloadLen), int64(1))
    if raw == nil:
        return ""
    var j: int32
    while j < payloadLen:
        var ch = sockReadByte(data, offset + j)
        if masked:
            ch = ch ^ sockReadByte(data, maskOffset + (j % 4))
        sockWriteI8Raw(raw, j, int8(ch & 255))
        j = j + 1
    return sockStrFromBytes(raw, payloadLen)

fn wsReadFrameNonblockingRaw(fd: int32, timeoutMs: int32): str =
    let revents = sockPollRevents(fd, timeoutMs)
    if revents < 0:
        return ""
    if (revents & (POLLERR | POLLNVAL)) != 0:
        return ""
    if (revents & POLLIN) == 0:
        if (revents & POLLHUP) != 0:
            return ""
        return "__RUST_CSG_WS_FRAME_BLOCKED__"
    let headerRaw = clib_calloc(int64(14), int64(1))
    if headerRaw == nil:
        return ""
    let headerRead = clib_recv(fd, headerRaw, int64(14), MSG_PEEK | MSG_DONTWAIT)
    if headerRead < int64(2):
        clib_free(headerRaw)
        if (revents & POLLHUP) != 0:
            return ""
        return "__RUST_CSG_WS_FRAME_BLOCKED__"
    let b0 = sockReadByte(headerRaw, 0)
    let b1 = sockReadByte(headerRaw, 1)
    let opcode = b0 & 15
    let masked = (b1 & 128) != 0
    var payloadLen: int32 = b1 & 127
    var offset: int32 = 2
    if payloadLen == 126:
        if headerRead < int64(4):
            clib_free(headerRaw)
            if (revents & POLLHUP) != 0:
                return ""
            return "__RUST_CSG_WS_FRAME_BLOCKED__"
        payloadLen = (sockReadByte(headerRaw, 2) << 8) | sockReadByte(headerRaw, 3)
        offset = 4
    elif payloadLen == 127:
        clib_free(headerRaw)
        return ""
    if payloadLen < 0 || payloadLen > 1048576:
        clib_free(headerRaw)
        return ""
    let maskOffset = offset
    if masked:
        offset = offset + 4
    let targetLen = offset + payloadLen
    clib_free(headerRaw)
    let frameRaw = clib_calloc(int64(targetLen) + int64(1), int64(1))
    if frameRaw == nil:
        return ""
    let peekRead = clib_recv(fd, frameRaw, int64(targetLen), MSG_PEEK | MSG_DONTWAIT)
    if peekRead < int64(targetLen):
        clib_free(frameRaw)
        if (revents & POLLHUP) != 0:
            return ""
        return "__RUST_CSG_WS_FRAME_BLOCKED__"
    let consumed = clib_read(fd, frameRaw, int64(targetLen))
    if consumed < int64(targetLen):
        clib_free(frameRaw)
        return ""
    let payload = wsPayloadStringRaw(frameRaw, offset, payloadLen, masked, maskOffset)
    clib_free(frameRaw)
    if payload.len != payloadLen:
        return ""
    if opcode == 8:
        var closeFrame = wsByteToStr(136)
        closeFrame = sockConcat(closeFrame, wsByteToStr(0))
        wsSendAll(fd, closeFrame)
        return ""
    if opcode == 9:
        var pong = wsByteToStr(138)
        pong = sockConcat(pong, wsByteToStr(payload.len & 255))
        pong = sockConcat(pong, payload)
        wsSendAll(fd, pong)
        return "__RUST_CSG_WS_FRAME_BLOCKED__"
    return payload

fn wsReadFrameCore(fd: int32, timeoutMs: int32, blocking: bool): str =
    var data = wsFrameStashTake(fd)
    var waitMs = timeoutMs
    while true:
        var targetLen: int32 = 2
        if data.len >= 2:
            let b0 = int32(data[0]) & 255
            let b1 = int32(data[1]) & 255
            let opcode = b0 & 15
            let masked = (b1 & 128) != 0
            var payloadLen = b1 & 127
            var offset: int32 = 2
            if payloadLen == 126:
                if data.len >= 4:
                    payloadLen = ((int32(data[2]) & 255) << 8) | (int32(data[3]) & 255)
                    offset = 4
                else:
                    payloadLen = -1
            elif payloadLen == 127:
                return ""
            if payloadLen >= 0:
                let maskOffset = offset
                if masked:
                    offset = offset + 4
                let frameEnd = offset + payloadLen
                targetLen = frameEnd
                if data.len >= frameEnd:
                    let payload = wsPayloadString(data, offset, payloadLen, masked, maskOffset)
                    if data.len > frameEnd:
                        wsFrameStashPut(fd, sockSliceBytes(data, frameEnd, data.len - frameEnd))
                    if opcode == 8:
                        var closeFrame = wsByteToStr(136)
                        closeFrame = sockConcat(closeFrame, wsByteToStr(0))
                        wsSendAll(fd, closeFrame)
                        return ""
                    if opcode == 9:
                        var pong = wsByteToStr(138)
                        pong = sockConcat(pong, wsByteToStr(payload.len & 255))
                        pong = sockConcat(pong, payload)
                        wsSendAll(fd, pong)
                        data = wsFrameStashTake(fd)
                        continue
                    return payload
            else:
                targetLen = 4
        let readMax = targetLen - data.len
        var chunkMax = readMax
        if chunkMax <= 0:
            chunkMax = 1
        if chunkMax > 4096:
            chunkMax = 4096
        if !blocking:
            if RustCsgSocketReadableExport(fd, waitMs) != 1:
                wsFrameStashPut(fd, data)
                return "__RUST_CSG_WS_FRAME_BLOCKED__"
        let chunk = wsReadAvailableChunk(fd, chunkMax)
        if chunk == "":
            return ""
        data = sockConcat(data, chunk)
        waitMs = 0
    return ""

fn wsReadExactBlocking(fd: int32, count: int32): str =
    var data: str
    while data.len < count:
        let chunk = RustCsgSocketReadExport(fd, count - data.len)
        if chunk == "":
            return ""
        data = sockConcat(data, chunk)
    return data

fn wsReadFrameBlockingRaw(fd: int32): str =
    let header = wsReadExactBlocking(fd, 2)
    if header.len < 2:
        return ""
    let b0 = int32(header[0]) & 255
    let b1 = int32(header[1]) & 255
    let opcode = b0 & 15
    let masked = (b1 & 128) != 0
    var payloadLen = b1 & 127
    var frame = header
    var offset: int32 = 2
    if payloadLen == 126:
        let extended = wsReadExactBlocking(fd, 2)
        if extended.len < 2:
            return ""
        frame = sockConcat(frame, extended)
        payloadLen = ((int32(extended[0]) & 255) << 8) | (int32(extended[1]) & 255)
        offset = 4
    elif payloadLen == 127:
        return ""
    if payloadLen < 0 || payloadLen > 1048576:
        return ""
    let maskOffset = offset
    if masked:
        let mask = wsReadExactBlocking(fd, 4)
        if mask.len < 4:
            return ""
        frame = sockConcat(frame, mask)
        offset = offset + 4
    if payloadLen > 0:
        let payloadBytes = wsReadExactBlocking(fd, payloadLen)
        if payloadBytes.len < payloadLen:
            return ""
        frame = sockConcat(frame, payloadBytes)
    let payload = wsPayloadString(frame, offset, payloadLen, masked, maskOffset)
    if payload.len != payloadLen:
        return ""
    if opcode == 8:
        var closeFrame = wsByteToStr(136)
        closeFrame = sockConcat(closeFrame, wsByteToStr(0))
        wsSendAll(fd, closeFrame)
        return ""
    if opcode == 9:
        var pong = wsByteToStr(138)
        pong = sockConcat(pong, wsByteToStr(payload.len & 255))
        pong = sockConcat(pong, payload)
        wsSendAll(fd, pong)
        return wsReadFrameBlockingRaw(fd)
    return payload

@abi_internal
@exportc("RustCsgWebSocketReadFrame")
fn RustCsgWebSocketReadFrameExport(fd: int32): str =
    return wsReadFrameBlockingRaw(fd)

@abi_internal
@exportc("RustCsgWebSocketTryReadFrame")
fn RustCsgWebSocketTryReadFrameExport(fd: int32, timeoutMs: int32): str =
    return wsReadFrameNonblockingRaw(fd, timeoutMs)

@abi_internal
@exportc("RustCsgWebSocketWriteFrame")
fn RustCsgWebSocketWriteFrameExport(fd: int32, data: str): int32 =
    var frame = wsByteToStr(129)
    let dLen = data.len
    if dLen < 126: frame = sockConcat(frame, wsByteToStr(dLen))
    elif dLen < 65536:
        frame = sockConcat(frame, wsByteToStr(126))
        frame = sockConcat(frame, wsByteToStr((dLen >> 8) & 255))
        frame = sockConcat(frame, wsByteToStr(dLen & 255))
    else: return -1
    frame = sockConcat(frame, data)
    if !wsSendAll(fd, frame): return -1
    return 0

# ── HTTP read / Misc ──

@abi_internal
@exportc("RustCsgHttpReadRequest")
fn RustCsgHttpReadRequestExport(clientFd: int32): str =
    var data: str
    var waitMs: int32 = 1000
    while data.len < 65536:
        if RustCsgSocketReadableExport(clientFd, waitMs) != 1:
            return ""
        let chunk = RustCsgSocketReadExport(clientFd, 4096)
        if chunk == "":
            return ""
        data = sockConcat(data, chunk)
        var i: int32
        while i + 4 <= data.len:
            if data[i] == '\r' && data[i + 1] == '\n' && data[i + 2] == '\r' && data[i + 3] == '\n':
                return data
            i = i + 1
        waitMs = 1000
    return ""
