# Pure Cheng provider - string/math/bitwise functions.
import std/rawmem_support
import std/strings

type
    StringOpsUInt8Ptr = uint8 *

fn stringOpsI32MinValue(): int32 =
    var out: int32 = int32(-2147483647)
    out = out - int32(1)
    return out

fn stringOpsBitMask(bit: int32): int32 =
    if bit < 0:
        return 0
    if bit > 31:
        return 0
    if bit == 31:
        return stringOpsI32MinValue()
    return 1 << bit

@abi_internal
@exportc("ConcatStr")
fn ConcatStrExport(a: str, b: str): str =
    return strings.ConcatStr(a, b)

@abi_internal
@exportc("RustCsgSliceBytes")
fn RustCsgSliceBytesExport(text: str, start: int32, count: int32): str =
    return strings.SliceBytes(text, start, count)

@abi_internal
@exportc("RustCsgContains")
fn RustCsgContainsExport(text: str, needle: str): int32 =
    if needle.len == 0: return 1
    if needle.len > text.len: return 0
    var i: int32
    while i <= text.len - needle.len:
        var j: int32
        var ok: int32 = 1
        while j < needle.len:
            if text[i + j] != needle[j]:
                ok = 0
                break
            j = j + 1
        if ok:
            return 1
        i = i + 1
    return 0

@abi_internal
@exportc("RustCsgEndsWith")
fn RustCsgEndsWithExport(text: str, suffix: str): int32 =
    if suffix.len == 0: return 1
    if suffix.len > text.len: return 0
    let off = text.len - suffix.len
    var i: int32
    while i < suffix.len:
        if text[off + i] != suffix[i]: return 0
        i = i + 1
    return 1

@abi_internal
@exportc("StartsWith")
fn StartsWithExport(text: str, prefix: str): int32 =
    if prefix.len == 0: return 1
    if prefix.len > text.len: return 0
    var i: int32
    while i < prefix.len:
        if text[i] != prefix[i]: return 0
        i = i + 1
    return 1

@abi_internal
@exportc("RustCsgStrStartsWith")
fn RustCsgStrStartsWithExport(text: str, prefix: str): int32 =
    return StartsWithExport(text, prefix)

@abi_internal
@exportc("RustCsgStrLen")
fn RustCsgStrLenExport(s: str): int32 =
    return s.len

@abi_internal
@exportc("RustCsgStrLenI64")
fn RustCsgStrLenI64Export(s: str): int32 =
    return s.len

@abi_internal
@exportc("RustCsgStrIsEmpty")
fn RustCsgStrIsEmptyExport(s: str): int32 =
    if s.len == 0:
        return 1
    return 0

@abi_internal
@exportc("RustCsgStrNotEmpty")
fn RustCsgStrNotEmptyExport(s: str): int32 =
    if s.len > 0:
        return 1
    return 0

@abi_internal
@exportc("RustCsgStrLenGt")
fn RustCsgStrLenGtExport(s: str, n: int32): int32 =
    if s.len > n:
        return 1
    return 0

@abi_internal
@exportc("RustCsgStrLenLt")
fn RustCsgStrLenLtExport(s: str, n: int32): int32 =
    if s.len < n:
        return 1
    return 0

@abi_internal
@exportc("RustCsgStrLenEq")
fn RustCsgStrLenEqExport(s: str, n: int32): int32 =
    if s.len == n:
        return 1
    return 0

@abi_internal
@exportc("RustCsgStrFirstByte")
fn RustCsgStrFirstByteExport(s: str): int32 =
    if s.len == 0:
        return -1
    return int32(s[0])

@abi_internal
@exportc("RustCsgStrLastByte")
fn RustCsgStrLastByteExport(s: str): int32 =
    if s.len == 0:
        return -1
    return int32(s[s.len - 1])

@abi_internal
@exportc("RustCsgStrByteAt")
fn RustCsgStrByteAtExport(s: str, pos: int32): int32 =
    if pos < 0:
        return -1
    if pos >= s.len:
        return -1
    return int32(s[pos])

@abi_internal
@exportc("RustCsgStrIsAscii")
fn RustCsgStrIsAsciiExport(s: str): int32 =
    var i: int32
    while i < s.len:
        if int32(s[i]) > 127:
            return 0
        i = i + 1
    return 1

@abi_internal
@exportc("RustCsgMemCmp")
fn RustCsgMemCmpExport(a: str, b: str): int32 =
    if a.len != b.len:
        return 0
    var i: int32
    while i < a.len:
        if a[i] != b[i]:
            return 0
        i = i + 1
    return 1

fn ChengStrCmpExport(a: ptr, b: ptr): int32 =
    var i: int32
    while true:
        var av: int32
        var bv: int32
        if a != nil:
            av = int32(*(StringOpsUInt8Ptr(rawmem_support.RawmemPtrAdd(a, i))))
        if b != nil:
            bv = int32(*(StringOpsUInt8Ptr(rawmem_support.RawmemPtrAdd(b, i))))
        if av < bv:
            return -1
        if av > bv:
            return 1
        if av == 0:
            return 0
        i = i + 1

@abi_internal
@exportc("RustCsgStrCount")
fn RustCsgStrCountExport(text: str, needle: str): int32 =
    if needle.len == 0:
        return 0
    if needle.len > text.len:
        return 0
    var count: int32
    var i: int32
    while i <= text.len - needle.len:
        var j: int32
        var ok: int32 = 1
        while j < needle.len:
            if text[i + j] != needle[j]:
                ok = 0
                break
            j = j + 1
        if ok:
            count = count + 1
            i = i + needle.len
            continue
        i = i + 1
    return count

@abi_internal
@exportc("RustCsgMinI32")
fn RustCsgMinI32Export(a: int32, b: int32): int32 =
    if a < b:
        return a
    return b

@abi_internal
@exportc("RustCsgMaxI32")
fn RustCsgMaxI32Export(a: int32, b: int32): int32 =
    if a > b:
        return a
    return b

@abi_internal
@exportc("RustCsgAbsI32")
fn RustCsgAbsI32Export(a: int32): int32 =
    if a == stringOpsI32MinValue():
        return a
    if a < 0:
        return -a
    return a

@abi_internal
@exportc("RustCsgClampI32")
fn RustCsgClampI32Export(v: int32, lo: int32, hi: int32): int32 =
    if v < lo:
        return lo
    if v > hi:
        return hi
    return v

@abi_internal
@exportc("RustCsgPopCount")
fn RustCsgPopCountExport(a: int32): int32 =
    var count: int32
    var bit: int32
    while bit < 32:
        if (a & stringOpsBitMask(bit)) != 0:
            count = count + 1
        bit = bit + 1
    return count

@abi_internal
@exportc("RustCsgIsPowerOfTwo")
fn RustCsgIsPowerOfTwoExport(v: int32): int32 =
    if v <= 0:
        return 0
    if (v & (v - 1)) == 0:
        return 1
    return 0

@abi_internal
@exportc("RustCsgHashStrSimple")
fn RustCsgHashStrSimpleExport(s: str): int32 =
    var h: int32 = 5381
    var i: int32
    while i < s.len:
        h = ((h << 5) + h) + int32(s[i])
        i = i + 1
    return h

@abi_internal
@exportc("RustCsgHashCombine")
fn RustCsgHashCombineExport(h: int32, v: int32): int32 =
    return h * 31 + v

@abi_internal
@exportc("RustCsgBitSet")
fn RustCsgBitSetExport(v: int32, b: int32): int32 =
    let mask = stringOpsBitMask(b)
    if mask == 0:
        return v
    return v | mask

@abi_internal
@exportc("RustCsgBitClear")
fn RustCsgBitClearExport(v: int32, b: int32): int32 =
    let mask = stringOpsBitMask(b)
    if mask == 0:
        return v
    return v & (-1 ^ mask)

@abi_internal
@exportc("RustCsgBitTest")
fn RustCsgBitTestExport(v: int32, b: int32): int32 =
    let mask = stringOpsBitMask(b)
    if mask == 0:
        return 0
    if (v & mask) != 0:
        return 1
    return 0

@abi_internal
@exportc("RustCsgBitToggle")
fn RustCsgBitToggleExport(v: int32, b: int32): int32 =
    let mask = stringOpsBitMask(b)
    if mask == 0:
        return v
    return v ^ mask

@abi_internal
@exportc("RustCsgNextPowerOfTwo")
fn RustCsgNextPowerOfTwoExport(v: int32): int32 =
    if v <= 0:
        return 1
    if v >= 1073741824:
        return 1073741824
    v = v - 1
    v = v | (v >> 1)
    v = v | (v >> 2)
    v = v | (v >> 4)
    v = v | (v >> 8)
    v = v | (v >> 16)
    return v + 1

@abi_internal
@exportc("RustCsgHash3I32")
fn RustCsgHash3I32Export(a: int32, b: int32, c: int32): int32 =
    return (a * 31 + b) * 31 + c

@abi_internal
@exportc("RustCsgHash4I32")
fn RustCsgHash4I32Export(a: int32, b: int32, c: int32, d: int32): int32 =
    return ((a * 31 + b) * 31 + c) * 31 + d

@abi_internal
@exportc("RustCsgHashStrLen")
fn RustCsgHashStrLenExport(s: str): int32 =
    return s.len
