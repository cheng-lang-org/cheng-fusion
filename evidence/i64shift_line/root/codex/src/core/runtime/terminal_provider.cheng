import std/strings
import std/rawmem_support

@importc("calloc")
fn termCalloc(count: int64, size: int64): ptr
@importc("free")
fn termFree(p: ptr)
@importc("tcgetattr")
fn termTcGetAttr(fd: int32, termios: ptr): int32
@importc("tcsetattr")
fn termTcSetAttr(fd: int32, optionalActions: int32, termios: ptr): int32
@importc("__ioctl")
fn termIoctl(fd: int32, request: int32, arg: ptr): int32
@importc("poll")
fn termPoll(fds: ptr, nfds: int32, timeoutMs: int32): int32
@importc("read")
fn termRead(fd: int32, buf: ptr, count: int64): int64
@importc("write")
fn termWrite(fd: int32, buf: ptr, count: int64): int64
@importc("gettimeofday")
fn termGetTimeOfDay(tv: ptr, tz: ptr): int32
@importc("memcpy")
fn termMemcpy(dst: ptr, src: ptr, size: int64): ptr

type
    TerminalUInt8Ptr = uint8 *

const TerminalStdinFd: int32 = 0
const TerminalStdoutFd: int32 = 1
const TerminalTcsaflush: int32 = 2
const TerminalTermiosSize: int32 = 72
const TerminalWinsizeSize: int32 = 8
const TerminalPollfdSize: int32 = 8
const TerminalTiocgwinsz: int32 = 1074295912
const TerminalPollIn: int32 = 1

const TerminalIflagOffset: int32 = 0
const TerminalOflagOffset: int32 = 4
const TerminalCflagOffset: int32 = 8
const TerminalLflagOffset: int32 = 12
const TerminalCcOffset: int32 = 16
const TerminalVmin: int32 = 16
const TerminalVtime: int32 = 17

const TerminalBrkint: int32 = 2
const TerminalEcho: int32 = 8
const TerminalEchonl: int32 = 16
const TerminalInpck: int32 = 16
const TerminalIstrip: int32 = 32
const TerminalIsig: int32 = 128
const TerminalIcanon: int32 = 256
const TerminalIcrnl: int32 = 256
const TerminalIxon: int32 = 512
const TerminalIexten: int32 = 1024
const TerminalOpost: int32 = 1
const TerminalCs8: int32 = 768
const TerminalCread: int32 = 2048

var terminalOriginalTermiosRaw: uint64
var terminalRawActive: bool

fn terminalReadByte(raw: ptr, index: int32): int32 =
    return int32(*(TerminalUInt8Ptr(rawmem_support.RawmemPtrAdd(raw, index)))) & 255

fn terminalWriteByte(raw: ptr, index: int32, value: int32) =
    rawmem_support.RawmemWriteI8(raw, index, Int8(value & 255))

fn terminalReadI16(raw: ptr, index: int32): int32 =
    let b0 = terminalReadByte(raw, index)
    let b1 = terminalReadByte(raw, index + 1)
    return b0 | (b1 << 8)

fn terminalWriteI16(raw: ptr, index: int32, value: int32) =
    terminalWriteByte(raw, index, value)
    terminalWriteByte(raw, index + 1, value >> 8)

fn terminalReadI32(raw: ptr, index: int32): int32 =
    let b0 = terminalReadByte(raw, index)
    let b1 = terminalReadByte(raw, index + 1)
    let b2 = terminalReadByte(raw, index + 2)
    let b3 = terminalReadByte(raw, index + 3)
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)

fn terminalWriteI32(raw: ptr, index: int32, value: int32) =
    terminalWriteByte(raw, index, value)
    terminalWriteByte(raw, index + 1, value >> 8)
    terminalWriteByte(raw, index + 2, value >> 16)
    terminalWriteByte(raw, index + 3, value >> 24)

fn terminalBitNot(value: int32): int32 =
    return 0 - value - 1

fn terminalWriteAllRaw(data: ptr, len: int32): int32 =
    if data == nil || len <= 0:
        return 0
    var written: int32
    while written < len:
        let n = termWrite(TerminalStdoutFd, rawmem_support.RawmemPtrAdd(data, written), int64(len - written))
        if n <= int64(0):
            return -1
        written = written + int32(n)
    return 0

fn terminalWriteAllStr(text: str): int32 =
    return terminalWriteAllRaw(text.data, text.len)

fn terminalWriteEscSeq(rest: str): int32 =
    let total = rest.len + 1
    let raw = termCalloc(int64(total), int64(1))
    if raw == nil:
        return -1
    terminalWriteByte(raw, 0, 27)
    if rest.len > 0:
        termMemcpy(rawmem_support.RawmemPtrAdd(raw, 1), rest.data, int64(rest.len))
    let result = terminalWriteAllRaw(raw, total)
    termFree(raw)
    return result

fn terminalEnsureOriginalTermios(): bool =
    if terminalOriginalTermiosRaw == uint64(0):
        let original = termCalloc(int64(TerminalTermiosSize), int64(1))
        if original == nil:
            return false
        if termTcGetAttr(TerminalStdinFd, original) != 0:
            termFree(original)
            return false
        terminalOriginalTermiosRaw = uint64(original)
    return true

@abi_internal
@exportc("cheng_terminal_raw_enable")
fn chengTerminalRawEnableExport() =
    if !terminalEnsureOriginalTermios():
        return
    let raw = termCalloc(int64(TerminalTermiosSize), int64(1))
    if raw == nil:
        return
    termMemcpy(raw, ptr(terminalOriginalTermiosRaw), int64(TerminalTermiosSize))
    var iflag = terminalReadI32(raw, TerminalIflagOffset)
    var oflag = terminalReadI32(raw, TerminalOflagOffset)
    var cflag = terminalReadI32(raw, TerminalCflagOffset)
    var lflag = terminalReadI32(raw, TerminalLflagOffset)
    iflag = iflag & terminalBitNot(TerminalBrkint | TerminalIcrnl | TerminalInpck | TerminalIstrip | TerminalIxon)
    oflag = oflag & terminalBitNot(TerminalOpost)
    cflag = cflag | TerminalCs8 | TerminalCread
    lflag = lflag & terminalBitNot(TerminalEcho | TerminalEchonl | TerminalIcanon | TerminalIsig | TerminalIexten)
    terminalWriteI32(raw, TerminalIflagOffset, iflag)
    terminalWriteI32(raw, TerminalOflagOffset, oflag)
    terminalWriteI32(raw, TerminalCflagOffset, cflag)
    terminalWriteI32(raw, TerminalLflagOffset, lflag)
    terminalWriteByte(raw, TerminalCcOffset + TerminalVmin, 1)
    terminalWriteByte(raw, TerminalCcOffset + TerminalVtime, 0)
    if termTcSetAttr(TerminalStdinFd, TerminalTcsaflush, raw) == 0:
        terminalRawActive = true
    termFree(raw)

@abi_internal
@exportc("cheng_terminal_raw_disable")
fn chengTerminalRawDisableExport() =
    if terminalOriginalTermiosRaw == uint64(0):
        return
    termTcSetAttr(TerminalStdinFd, TerminalTcsaflush, ptr(terminalOriginalTermiosRaw))
    terminalRawActive = false

@abi_internal
@exportc("cheng_terminal_get_size_rows")
fn chengTerminalGetSizeRowsExport(): int32 =
    let raw = termCalloc(int64(TerminalWinsizeSize), int64(1))
    if raw == nil:
        return 24
    if termIoctl(TerminalStdoutFd, TerminalTiocgwinsz, raw) == 0:
        let rows = terminalReadI16(raw, 0)
        termFree(raw)
        if rows > 0:
            return rows
        return 24
    termFree(raw)
    return 24

@abi_internal
@exportc("cheng_terminal_get_size_cols")
fn chengTerminalGetSizeColsExport(): int32 =
    let raw = termCalloc(int64(TerminalWinsizeSize), int64(1))
    if raw == nil:
        return 80
    if termIoctl(TerminalStdoutFd, TerminalTiocgwinsz, raw) == 0:
        let cols = terminalReadI16(raw, 2)
        termFree(raw)
        if cols > 0:
            return cols
        return 80
    termFree(raw)
    return 80

@abi_internal
@exportc("cheng_terminal_read_key")
fn chengTerminalReadKeyExport(): int32 =
    let raw = termCalloc(int64(1), int64(1))
    if raw == nil:
        return -1
    let n = termRead(TerminalStdinFd, raw, int64(1))
    if n <= int64(0):
        termFree(raw)
        return -1
    let ch = terminalReadByte(raw, 0)
    termFree(raw)
    return ch

@abi_internal
@exportc("cheng_terminal_read_byte_timeout")
fn chengTerminalReadByteTimeoutExport(deciseconds: int32): int32 =
    let pollfd = termCalloc(int64(TerminalPollfdSize), int64(1))
    if pollfd == nil:
        return -1
    terminalWriteI32(pollfd, 0, TerminalStdinFd)
    terminalWriteI16(pollfd, 4, TerminalPollIn)
    var timeoutMs = deciseconds * 100
    if timeoutMs < 0:
        timeoutMs = 0
    let readable = termPoll(pollfd, 1, timeoutMs)
    termFree(pollfd)
    if readable <= 0:
        return -1
    return chengTerminalReadKeyExport()

@abi_internal
@exportc("cheng_terminal_write")
fn chengTerminalWriteExport(data: ptr, len: int32) =
    terminalWriteAllRaw(data, len)

@abi_internal
@exportc("cheng_terminal_clear_screen")
fn chengTerminalClearScreenExport() =
    terminalWriteEscSeq("[2J")
    terminalWriteEscSeq("[H")

@abi_internal
@exportc("cheng_terminal_move_to")
fn chengTerminalMoveToExport(row: int32, col: int32) =
    var out = "["
    out = strings.ConcatStr(out, strings.IntToStr(row + 1))
    out = strings.ConcatStr(out, ";")
    out = strings.ConcatStr(out, strings.IntToStr(col + 1))
    out = strings.ConcatStr(out, "H")
    terminalWriteEscSeq(out)

@abi_internal
@exportc("cheng_terminal_set_fg")
fn chengTerminalSetFgExport(color: int32) =
    var out = "[38;5;"
    out = strings.ConcatStr(out, strings.IntToStr(color))
    out = strings.ConcatStr(out, "m")
    terminalWriteEscSeq(out)

@abi_internal
@exportc("cheng_terminal_set_bg")
fn chengTerminalSetBgExport(color: int32) =
    var out = "[48;5;"
    out = strings.ConcatStr(out, strings.IntToStr(color))
    out = strings.ConcatStr(out, "m")
    terminalWriteEscSeq(out)

@abi_internal
@exportc("cheng_terminal_set_bold")
fn chengTerminalSetBoldExport() =
    terminalWriteEscSeq("[1m")

@abi_internal
@exportc("cheng_terminal_set_underline")
fn chengTerminalSetUnderlineExport() =
    terminalWriteEscSeq("[4m")

@abi_internal
@exportc("cheng_terminal_set_reverse")
fn chengTerminalSetReverseExport() =
    terminalWriteEscSeq("[7m")

@abi_internal
@exportc("cheng_terminal_reset_attrs")
fn chengTerminalResetAttrsExport() =
    terminalWriteEscSeq("[0m")

@abi_internal
@exportc("cheng_epoch_time")
fn chengEpochTimeExport(): int64 =
    return chengEpochTimeSecondsExport()

@abi_internal
@exportc("cheng_epoch_time_ms")
fn chengEpochTimeMsExport(): int64 =
    let tv = termCalloc(int64(16), int64(1))
    if tv == nil:
        return int64(0)
    if termGetTimeOfDay(tv, nil) != 0:
        termFree(tv)
        return int64(0)
    var sec: int64
    var i: int32
    while i < 8:
        sec = sec | (int64(terminalReadByte(tv, i)) << (i * 8))
        i = i + 1
    var usec: int64
    i = 0
    while i < 4:
        usec = usec | (int64(terminalReadByte(tv, 8 + i)) << (i * 8))
        i = i + 1
    termFree(tv)
    return sec * int64(1000) + usec / int64(1000)

@abi_internal
@exportc("cheng_epoch_time_seconds")
fn chengEpochTimeSecondsExport(): int64 =
    return chengEpochTimeMsExport() / int64(1000)
