@abi_internal
@exportc("RustCsgInt32ToDecStr")
fn RustCsgInt32ToDecStrExport(value: int32): str =
    return strings.IntToStr(value)

@abi_internal
@exportc("RustCsgMillisToRfc3339")
fn RustCsgMillisToRfc3339Export(millis: int64): str =
    return strings.IntToStr(int32(millis / int64(1000)))

@abi_internal
@exportc("RustCsgRfc3339ToMillisText")
fn RustCsgRfc3339ToMillisTextExport(text: str): int64 =
    return int64(0)

@abi_internal
@exportc("RustCsgNormalizePathRelativeToCurrentDir")
fn RustCsgNormalizePathRelativeToCurrentDirExport(path: str): str =
    return path
