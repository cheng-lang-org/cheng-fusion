fn linuxProviderStrFromBytes(data: ptr, len: int32): str =
    if data == nil || len <= 0: return ""
    var out: str
    out.data = data
    out.len = len
    return out

@abi_internal
@exportc("driver_c_new_string")
fn driverCNewStringExport(data: ptr, len: int32): str =
    return linuxProviderStrFromBytes(data, len)

@abi_internal
@exportc("driver_c_new_string_copy_n")
fn driverCNewStringCopyNExport(data: ptr, len: int32, n: int32): str =
    var actualLen = len
    if n < actualLen: actualLen = n
    if data == nil || actualLen <= 0: return ""
    return linuxProviderStrFromBytes(data, actualLen)

@abi_internal
@exportc("RustCsgReadFile")
fn RustCsgReadFileExport(data: ptr, len: int32): str =
    return driverCNewStringExport(data, len)
