# Pure Cheng filesystem + time + env provider using libc @importc.
# Replaces the retired inventory C provider exports.
# Placed in codex/src/core/runtime/ for ZRPC str @exportc exemption.

@importc("fopen")
fn raw_fopen(path: ptr, mode: ptr): ptr
@importc("fread")
fn raw_fread(buf: ptr, size: int64, count: int64, stream: ptr): int64
@importc("fwrite")
fn raw_fwrite(buf: ptr, size: int64, count: int64, stream: ptr): int64
@importc("fclose")
fn raw_fclose(stream: ptr): int32
@importc("fseek")
fn raw_fseek(stream: ptr, offset: int64, whence: int32): int32
@importc("ftell")
fn raw_ftell(stream: ptr): int64
@importc("mkdir")
fn raw_mkdir(path: ptr, mode: int32): int32
@importc("opendir")
fn raw_opendir(path: ptr): ptr
@importc("closedir")
fn raw_closedir(dir: ptr): int32
@importc("unlink")
fn raw_unlink(path: ptr): int32
@importc("rmdir")
fn raw_rmdir(path: ptr): int32
@importc("access")
fn raw_access(path: ptr, mode: int32): int32
@importc("getenv")
fn raw_getenv(name: ptr): ptr
@importc("time")
fn raw_time(out: ptr): int64
@importc("calloc")
fn raw_calloc(count: int64, size: int64): ptr
@importc("free")
fn raw_free(p: ptr)
@importc("memcpy")
fn raw_memcpy(dst: ptr, src: ptr, n: int64): ptr
@importc("strlen")
fn raw_strlen(p: ptr): int64

fn provider_cstring(text: str): ptr =
    let n = int64(text.len)
    let raw = raw_calloc(n + int64(1), int64(1))
    if raw == nil:
        return nil
    if n > int64(0):
        raw_memcpy(raw, text.data, n)
    return raw

fn provider_fopen(path: str, mode: str): ptr =
    let rawPath = provider_cstring(path)
    if rawPath == nil:
        return nil
    let rawMode = provider_cstring(mode)
    if rawMode == nil:
        raw_free(rawPath)
        return nil
    let f = raw_fopen(rawPath, rawMode)
    raw_free(rawPath)
    raw_free(rawMode)
    return f

fn provider_str_view_owned(raw: ptr, count: int32): str =
    if raw == nil || count <= 0:
        return ""
    var out: str
    out.data = raw
    out.len = count
    return out

fn provider_str_copy(raw: ptr, count: int32): str =
    if raw == nil || count <= 0:
        return ""
    var out: str
    out.data = raw
    out.len = count
    return out

fn cstr_copy(p: ptr): str =
    if p == nil:
        return ""
    let n = raw_strlen(p)
    if n <= int64(0) || n > int64(2147483647):
        return ""
    return provider_str_copy(p, Int32(n))

fn provider_write_file_mode(path: str, content: str, mode: str): int32 =
    var f = provider_fopen(path, mode)
    if f == nil:
        return 0
    var n: int64
    if content.len > 0:
        n = raw_fwrite(content.data, int64(1), int64(content.len), f)
    raw_fclose(f)
    if n == int64(content.len):
        return 1
    return 0

# -- read file --

@abi_internal
@exportc("ReadFile")
fn ReadFileExport(path: str): str =
    var f = provider_fopen(path, "rb")
    if f == nil:
        return ""
    raw_fseek(f, int64(0), 2)
    var sz = raw_ftell(f)
    raw_fseek(f, int64(0), 0)
    if sz <= 0 || sz > int64(104857600):
        raw_fclose(f)
        return ""
    let count = Int32(sz)
    var buf = raw_calloc(int64(count) + int64(1), int64(1))
    if buf == nil:
        raw_fclose(f)
        return ""
    var n = raw_fread(buf, int64(1), int64(count), f)
    raw_fclose(f)
    if n != int64(count):
        raw_free(buf)
        return ""
    return provider_str_view_owned(buf, count)

@abi_internal
@exportc("RustCsgWriteFile")
fn RustCsgWriteFileExport(path: str, content: str): int32 =
    return provider_write_file_mode(path, content, "wb")

@abi_internal
@exportc("RustCsgFileAppend")
fn RustCsgFileAppendExport(path: str, content: str): int32 =
    return provider_write_file_mode(path, content, "ab")

@abi_internal
@exportc("RustCsgMkdir")
fn RustCsgMkdirExport(path: str): int32 =
    let rawPath = provider_cstring(path)
    if rawPath == nil:
        return 0
    var rc = raw_mkdir(rawPath, 493)
    raw_free(rawPath)
    if rc == 0:
        return 1
    return 0

@abi_internal
@exportc("RustCsgFileDelete")
fn RustCsgFileDeleteExport(path: str): int32 =
    let rawPath = provider_cstring(path)
    if rawPath == nil:
        return 0
    if raw_unlink(rawPath) == 0:
        raw_free(rawPath)
        return 1
    if raw_rmdir(rawPath) == 0:
        raw_free(rawPath)
        return 1
    raw_free(rawPath)
    return 0

@abi_internal
@exportc("RustCsgFileExists")
fn RustCsgFileExistsExport(path: str): int32 =
    let rawPath = provider_cstring(path)
    if rawPath == nil:
        return 0
    let ok = raw_access(rawPath, 0)
    raw_free(rawPath)
    if ok == 0:
        return 1
    return 0

@abi_internal
@exportc("RustCsgFileSize")
fn RustCsgFileSizeExport(path: str): int64 =
    var f = provider_fopen(path, "rb")
    if f == nil:
        return int64(-1)
    raw_fseek(f, int64(0), 2)
    var sz = raw_ftell(f)
    raw_fclose(f)
    if sz < int64(0):
        return int64(-1)
    return sz

@abi_internal
@exportc("RustCsgPathMetadataKind")
fn RustCsgPathMetadataKindExport(path: str): int32 =
    let rawPath = provider_cstring(path)
    if rawPath == nil:
        return 0
    if raw_access(rawPath, 0) != 0:
        raw_free(rawPath)
        return 0
    let dir = raw_opendir(rawPath)
    if dir != nil:
        raw_closedir(dir)
        raw_free(rawPath)
        return 1
    raw_free(rawPath)
    return 2

@abi_internal
@exportc("RustCsgGetEnv")
fn RustCsgGetEnvExport(name: str): str =
    let rawName = provider_cstring(name)
    if rawName == nil:
        return ""
    var p = raw_getenv(rawName)
    raw_free(rawName)
    if p == nil:
        return ""
    return cstr_copy(p)

@exportc("RustCsgGetCurrentTimeMs")
fn RustCsgGetCurrentTimeMsExport(): int64 =
    var t = raw_time(nil)
    return t * int64(1000)

@abi_internal
@exportc("RustCsgCreateTempFile")
fn RustCsgCreateTempFileExport(prefix: str): str =
    return ""
