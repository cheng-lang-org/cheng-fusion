@importc("getpid")
fn clib_getpid(): int32
@importc("time")
fn clib_time(out: ptr): int64
@abi_internal
@importc("access")
fn clib_access(path: str, mode: int32): int32

@exportc("RustCsgGetPid")
fn RustCsgGetPidExport(): int32 =
    return clib_getpid()

@exportc("RustCsgGetCurrentTimeMs")
fn RustCsgGetCurrentTimeMsExport(): int64 =
    return clib_time(nil) * int64(1000)

@exportc("RustCsgFileExists")
fn RustCsgFileExistsExport(path: str): int32 =
    if clib_access(path, 0) == 0:
        return 1
    return 0
