@abi_internal
@exportc("RustCsgCommandInPathIsFile")
fn RustCsgCommandInPathIsFileExport(command: str): int32 =
    if command != "npx":
        return 0
    let rawCommand = darwinProviderCString("command -v npx 2>/dev/null")
    if rawCommand == nil:
        return 0
    let rawMode = darwinProviderCString("r")
    if rawMode == nil:
        clib_free(rawCommand)
        return 0
    let pipe = clib_popen(rawCommand, rawMode)
    clib_free(rawMode)
    clib_free(rawCommand)
    if pipe == nil:
        return 0
    var sawOutput: bool
    while true:
        let ch = clib_fgetc(pipe)
        if ch < 0:
            break
        if ch != int32('\n') && ch != int32('\r') && ch != int32(' ') && ch != int32('\t'):
            sawOutput = true
    let status = clib_pclose(pipe)
    if sawOutput && status == 0:
        return 1
    return 0

@abi_internal
@exportc("RustCsgExecCommand")
fn RustCsgExecCommandExport(command: str): str =
    let rawCommand = darwinProviderCString(command)
    if rawCommand == nil:
        return ""
    let rawMode = darwinProviderCString("r")
    if rawMode == nil:
        clib_free(rawCommand)
        return ""
    let stream: ptr = clib_popen(rawCommand, rawMode)
    clib_free(rawCommand)
    clib_free(rawMode)
    if stream == nil:
        return ""
    var cap: int64
    cap = 4096
    var total: int64
    var outBuf: ptr = clib_calloc(cap + int64(1), int64(1))
    if outBuf == nil:
        clib_pclose(stream)
        return ""
    while true:
        let ch = clib_fgetc(stream)
        if ch < 0:
            break
        let needed: int64 = total + int64(2)
        if needed >= int64(2147483647):
            clib_free(outBuf)
            clib_pclose(stream)
            return ""
        if needed > cap:
            var nextCap: int64
            nextCap = cap
            while nextCap < needed:
                nextCap = nextCap * int64(2)
            let grown: ptr = clib_realloc(outBuf, nextCap + int64(1))
            if grown == nil:
                clib_free(outBuf)
                clib_pclose(stream)
                return ""
            outBuf = grown
            cap = nextCap
        darwinRawmemWriteI8(outBuf, int32(total), int8(ch))
        total = total + int64(1)
    if clib_ferror(stream) != 0:
        clib_free(outBuf)
        clib_pclose(stream)
        return ""
    clib_pclose(stream)
    let out: str = darwinProviderStrFromBytesCopy(outBuf, int32(total))
    return out

fn darwinProviderReadTextFile(path: str): str =
    let rawPath = darwinProviderCString(path)
    if rawPath == nil:
        return ""
    let rawMode = darwinProviderCString("rb")
    if rawMode == nil:
        clib_free(rawPath)
        return ""
    let file: ptr = clib_fopen(rawPath, rawMode)
    clib_free(rawPath)
    clib_free(rawMode)
    if file == nil:
        return ""
    if clib_fseek(file, int64(0), 2) != 0:
        clib_fclose(file)
        return ""
    let fileSize: int64 = clib_ftell(file)
    if fileSize < int64(0) || fileSize >= int64(2147483647):
        clib_fclose(file)
        return ""
    if clib_fseek(file, int64(0), 0) != 0:
        clib_fclose(file)
        return ""
    if fileSize == int64(0):
        clib_fclose(file)
        return ""
    let outBuf: ptr = clib_calloc(fileSize + int64(1), int64(1))
    if outBuf == nil:
        clib_fclose(file)
        return ""
    let got: int64 = clib_fread(outBuf, int64(1), fileSize, file)
    if clib_ferror(file) != 0:
        clib_free(outBuf)
        clib_fclose(file)
        return ""
    clib_fclose(file)
    let out: str = darwinProviderStrFromBytesCopy(outBuf, int32(got))
    return out

