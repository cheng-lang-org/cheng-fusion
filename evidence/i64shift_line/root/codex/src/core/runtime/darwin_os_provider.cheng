# Pure Cheng Darwin OS provider for app-server runtime symbols.

@importc("getpid")
fn clib_getpid(): int32
@importc("gettimeofday")
fn clib_gettimeofday(tv: ptr, tz: ptr): int32
@importc("getenv")
fn clib_getenv(name: ptr): cstring
@importc("signal")
fn clib_signal(sig: int32, handler: ptr): ptr
@importc("sigaction")
fn clib_sigaction(sig: int32, action: ptr, oldAction: ptr): int32
@importc("_dyld_get_image_vmaddr_slide")
fn clib_dyld_get_image_vmaddr_slide(imageIndex: int32): int64
@importc("write")
fn clib_write(fd: int32, buf: ptr, count: int64): int64
@importc("_exit")
fn clib_exit_immediate(code: int32)
@importc("setenv")
fn clib_setenv(name: ptr, value: ptr, overwrite: int32): int32
@importc("getcwd")
fn clib_getcwd(buf: ptr, size: int64): cstring
@importc("realpath")
fn clib_realpath(path: ptr, resolved: ptr): ptr
@importc("strlen")
fn clib_strlen(p: ptr): int64
@importc("isatty")
fn clib_isatty(fd: int32): int32
@importc("getchar")
fn clib_getchar(): int32
@importc("mkstemp")
fn clib_mkstemp(templatePath: ptr): int32
@importc("close")
fn clib_close(fd: int32): int32
@importc("access")
fn clib_access(path: ptr, mode: int32): int32
@importc("mkdir")
fn clib_mkdir(path: ptr, mode: int64): int32
@importc("unlink")
fn clib_unlink(path: ptr): int32
@importc("rename")
fn clib_rename(oldPath: ptr, newPath: ptr): int32
@importc("truncate")
fn clib_truncate(path: ptr, size: int64): int32
@importc("rmdir")
fn clib_rmdir(path: ptr): int32
@importc("opendir")
fn clib_opendir(path: ptr): ptr
@importc("readdir")
fn clib_readdir(dir: ptr): ptr
@importc("closedir")
fn clib_closedir(dir: ptr): int32
@importc("lstat")
fn clib_lstat(path: ptr, out: ptr): int32
@importc("usleep")
fn clib_usleep(usec: uint32): int32
@importc("arc4random_buf")
fn clib_arc4random_buf(buf: ptr, len: int64)
@importc("fopen")
fn clib_fopen(path: ptr, mode: ptr): ptr
@importc("popen")
fn clib_popen(command: ptr, mode: ptr): ptr
@importc("pclose")
fn clib_pclose(stream: ptr): int32
@importc("fgetc")
fn clib_fgetc(stream: ptr): int32
@importc("fread")
fn clib_fread(buf: ptr, size: int64, count: int64, stream: ptr): int64
@importc("fseek")
fn clib_fseek(stream: ptr, offset: int64, whence: int32): int32
@importc("ftell")
fn clib_ftell(stream: ptr): int64
@importc("fwrite")
fn clib_fwrite(buf: ptr, size: int64, count: int64, stream: ptr): int64
@importc("fclose")
fn clib_fclose(stream: ptr): int32
@importc("ferror")
fn clib_ferror(stream: ptr): int32
@importc("calloc")
fn clib_calloc(count: int64, size: int64): ptr
@importc("realloc")
fn clib_realloc(p: ptr, size: int64): ptr
@importc("free")
fn clib_free(p: ptr)
@importc("memcpy")
fn clib_memcpy(dst: ptr, src: ptr, n: int64): ptr
@importc("ptr_add")
fn darwin_ptr_add(p: ptr, off: int32): ptr
@importc("cheng_rawmem_write_i8")
fn darwin_rawmem_write_i8(dst: ptr, idx: int32, v: int8)

type
    DarwinTimeval =
        tv_sec: int64
        tv_usec: int32
    DarwinTimespec =
        tv_sec: int64
        tv_nsec: int64
    DarwinStat =
        st_dev: int32
        st_mode: uint16
        st_nlink: uint16
        st_ino: uint64
        st_uid: uint32
        st_gid: uint32
        st_rdev: int32
        st_pad0: int32
        st_atimespec: DarwinTimespec
        st_mtimespec: DarwinTimespec
        st_ctimespec: DarwinTimespec
        st_birthtimespec: DarwinTimespec
        st_size: int64
        st_blocks: int64
        st_blksize: int32
        st_flags: uint32
        st_gen: uint32
        st_lspare: int32
        st_qspare0: int64
        st_qspare1: int64
    DarwinCivilDate =
        year: int32
        month: int32
        day: int32
    DarwinSigAction =
        handler: ptr
        mask: uint32
        flags: int32
    DarwinUInt8Ptr = uint8 *

var
    darwinCrashSignalHandlersReady: bool
    darwinCrashLastMark: str
    darwinCrashImageSlide: uint64

fn darwinPtrAdd(p: ptr, off: int32): ptr =
    return darwin_ptr_add(p, off)

fn darwinRawmemWriteI8(dst: ptr, idx: int32, v: int8) =
    darwin_rawmem_write_i8(dst, idx, v)

fn darwinRawmemCopy(dst: ptr, src: ptr, n: int32) =
    let _ = clib_memcpy(dst, src, int64(n))

fn darwinConcat2(a: str, b: str): str =
    let lenA: int32 = a.len
    let lenB: int32 = b.len
    let total: int32 = lenA + lenB
    if total <= 0:
        return ""
    let raw = clib_calloc(int64(total) + int64(1), int64(1))
    if raw == nil:
        return ""
    if lenA > 0 && a.data != nil:
        clib_memcpy(raw, a.data, int64(lenA))
    if lenB > 0 && b.data != nil:
        clib_memcpy(darwinPtrAdd(raw, lenA), b.data, int64(lenB))
    var out: str
    out.data = raw
    out.len = total
    return out

fn darwinSliceBytes(text: str, start: int32, count: int32): str =
    if text.data == nil || text.len <= 0 || count <= 0:
        return ""
    var start0: int32 = start
    if start0 < 0:
        start0 = 0
    if start0 >= text.len:
        return ""
    var kept: int32 = count
    if start0 + kept > text.len:
        kept = text.len - start0
    if kept <= 0:
        return ""
    var out: str
    out.data = darwinPtrAdd(text.data, start0)
    out.len = kept
    return out

fn darwinInt64ToDecStr(value: int64): str =
    if value < int64(-9223372036854775807):
        return "-9223372036854775808"
    let raw = clib_calloc(int64(32), int64(1))
    if raw == nil:
        return ""
    var negative: bool
    var n: uint64
    if value < int64(0):
        negative = true
        n = uint64(int64(0) - value)
    else:
        n = uint64(value)
    var digits: int32[24]
    var digitCount: int32
    if n == uint64(0):
        digits[0] = 0
        digitCount = 1
    else:
        while n > uint64(0):
            digits[digitCount] = int32(n % uint64(10))
            digitCount = digitCount + 1
            n = n / uint64(10)
    var pos: int32
    if negative:
        darwinRawmemWriteI8(raw, pos, int8(int32('-')))
        pos = pos + 1
    while digitCount > 0:
        digitCount = digitCount - 1
        darwinRawmemWriteI8(raw, pos, int8(int32('0') + digits[digitCount]))
        pos = pos + 1
    var out: str
    out.data = raw
    out.len = pos
    return out

fn darwinProviderCString(text: str): ptr =
    let len = int64(text.len)
    let raw: ptr = clib_calloc(len + int64(1), int64(1))
    if raw == nil:
        return nil
    if len > int64(0):
        clib_memcpy(raw, text.data, len)
    return raw

fn darwinProviderStrFromCStringCopy(raw: ptr): str =
    if raw == nil:
        return ""
    let len64: int64 = clib_strlen(raw)
    if len64 <= int64(0) || len64 >= int64(2147483647):
        return ""
    let len32: int32 = int32(len64)
    var out: str
    out.data = raw
    out.len = len32
    return out

fn darwinProviderStrFromBytesCopy(raw: ptr, count: int32): str =
    if raw == nil || count <= 0:
        return ""
    var out: str
    out.data = raw
    out.len = count
    return out

fn darwinProviderByteToStr(value: int32): str =
    let raw = clib_calloc(int64(2), int64(1))
    if raw == nil:
        return ""
    darwinRawmemWriteI8(raw, 0, int8(value & 255))
    var out: str
    out.data = raw
    out.len = 1
    return out

fn darwinConcat3(a: str, b: str, c: str): str =
    return darwinConcat2(darwinConcat2(a, b), c)

fn darwinCrashTraceEnvTextEnabled(raw: cstring): bool =
    if raw == nil:
        return false
    let n: int64 = clib_strlen(ptr(raw))
    if n <= int64(0):
        return false
    if n == int64(1) && *(DarwinUInt8Ptr(ptr(raw))) == uint8('0'):
        return false
    return true

fn darwinCrashTraceEnabled(): bool =
    if darwinCrashTraceEnvTextEnabled(clib_getenv("CHENG_CRASH_TRACE")):
        return true
    if darwinCrashTraceEnvTextEnabled(clib_getenv("CHENG_CRASH_TRACE_ENABLE")):
        return true
    return false

fn darwinCrashSignalWrite(text: ptr) =
    if text == nil:
        return
    let n: int64 = clib_strlen(text)
    if n > int64(0):
        let _ = clib_write(1, text, n)

fn darwinCrashSignalWriteStr(text: str) =
    if text.len <= 0:
        return
    if text.data == nil:
        return
    let _ = clib_write(1, text.data, int64(text.len))

fn darwinCrashSignalWriteHex64(value: uint64) =
    let table: str = "0123456789abcdef"
    darwinCrashSignalWrite("0x")
    var i: int32
    while i < 16:
        let shift: int32 = (15 - i) * 4
        let nibble: int32 = int32((value >> shift) & uint64(15))
        let _ = clib_write(1, darwinPtrAdd(table.data, nibble), int64(1))
        i = i + 1

fn darwinCrashSignalWriteDigit(value: int32) =
    let table: str = "0123456789"
    if value >= 0 && value <= 9:
        let _ = clib_write(1, darwinPtrAdd(table.data, value), int64(1))
    else:
        let _ = clib_write(1, darwinPtrAdd(table.data, 0), int64(1))

fn darwinCrashRawReadU64(raw: ptr, offset: int32): uint64 =
    if raw == nil:
        return uint64(0)
    var out: uint64
    darwinRawmemCopy(ptr(&out), darwinPtrAdd(raw, offset), 8)
    return out

fn darwinCrashContextMcontext(context: ptr): ptr =
    if context == nil:
        return nil
    return ptr(darwinCrashRawReadU64(context, 48))

fn darwinCrashContextReg(context: ptr, threadOffset: int32): uint64 =
    let mcontext = darwinCrashContextMcontext(context)
    if mcontext == nil:
        return uint64(0)
    return darwinCrashRawReadU64(mcontext, 16 + threadOffset)

fn darwinCrashSignalFault(info: ptr): uint64 =
    if info == nil:
        return uint64(0)
    return darwinCrashRawReadU64(info, 24)

fn darwinCrashSignalWriteMachineFrame(index: int32, pc: uint64) =
    if pc == uint64(0):
        return
    darwinCrashSignalWrite("m#")
    darwinCrashSignalWriteDigit(index)
    darwinCrashSignalWrite(" pc=")
    darwinCrashSignalWriteHex64(pc)
    darwinCrashSignalWrite(" symbol=frame off=0x0 fn=<unknown> src=<unknown>:1-1\n")

fn darwinCrashStackFrameLooksReadable(sp: uint64, fp: uint64): bool =
    if fp == uint64(0):
        return false
    if (fp & uint64(15)) != uint64(0):
        return false
    if sp != uint64(0):
        if fp < sp:
            return false
        if fp - sp > uint64(16777216):
            return false
    return true

fn darwinCrashSignalWriteFrameChain(fp: uint64, sp: uint64, lr: uint64) =
    darwinCrashSignalWriteMachineFrame(1, lr)
    var frame = fp
    var index: int32 = 2
    while index <= 9 && darwinCrashStackFrameLooksReadable(sp, frame):
        let savedFp = darwinCrashRawReadU64(ptr(frame), 0)
        let savedLr = darwinCrashRawReadU64(ptr(frame), 8)
        darwinCrashSignalWriteMachineFrame(index, savedLr)
        if savedFp <= frame:
            return
        frame = savedFp
        index = index + 1

fn darwinCrashSignalWriteRegs(info: ptr, context: ptr) =
    let fp: uint64 = darwinCrashContextReg(context, 232)
    let lr: uint64 = darwinCrashContextReg(context, 240)
    let sp: uint64 = darwinCrashContextReg(context, 248)
    let pc: uint64 = darwinCrashContextReg(context, 256)
    let fault: uint64 = darwinCrashSignalFault(info)
    darwinCrashSignalWrite("regs pc=")
    darwinCrashSignalWriteHex64(pc)
    darwinCrashSignalWrite(" fp=")
    darwinCrashSignalWriteHex64(fp)
    darwinCrashSignalWrite(" sp=")
    darwinCrashSignalWriteHex64(sp)
    darwinCrashSignalWrite(" lr=")
    darwinCrashSignalWriteHex64(lr)
    darwinCrashSignalWrite(" fault=")
    darwinCrashSignalWriteHex64(fault)
    darwinCrashSignalWrite("\n")
    darwinCrashSignalWrite("m#0 pc=")
    darwinCrashSignalWriteHex64(pc)
    darwinCrashSignalWrite(" symbol=signal off=0x0 fn=signal src=<unknown>:1-1\n")
    darwinCrashSignalWriteFrameChain(fp, sp, lr)
    darwinCrashSignalWrite("#0 signal <unknown>:1-1 +0x0\n")

fn darwinCrashTraceWriteMark(tag: str, a: int32, b: int32, c: int32, d: int32) =
    if !darwinCrashTraceEnabled():
        return
    darwinCrashLastMark = tag
    let rawTag = darwinProviderCString(tag)
    if rawTag == nil:
        return
    darwinCrashSignalWrite("[cheng-crash-trace] mark=")
    darwinCrashSignalWrite(rawTag)
    darwinCrashSignalWrite("\n")
    clib_free(rawTag)

fn darwinCrashSignalActionHandler(sig: int32, info: ptr, context: ptr) =
    darwinCrashSignalWrite("[cheng-crash-trace] reason=signal\n")
    darwinCrashSignalWrite("cheng_crash_raw_v1\n")
    darwinCrashSignalWrite("reason=signal mode=signal\n")
    if darwinCrashLastMark.len > 0:
        darwinCrashSignalWrite("last_mark=")
        darwinCrashSignalWriteStr(darwinCrashLastMark)
        darwinCrashSignalWrite("\n")
    if sig == 4:
        darwinCrashSignalWrite("signal=SIGILL\n")
    elif sig == 5:
        darwinCrashSignalWrite("signal=SIGTRAP\n")
    elif sig == 6:
        darwinCrashSignalWrite("signal=SIGABRT\n")
    elif sig == 10:
        darwinCrashSignalWrite("signal=SIGBUS\n")
    elif sig == 11:
        darwinCrashSignalWrite("signal=SIGSEGV\n")
    else:
        darwinCrashSignalWrite("signal=UNKNOWN\n")
    darwinCrashSignalWrite("image_slide=")
    darwinCrashSignalWriteHex64(darwinCrashImageSlide)
    darwinCrashSignalWrite("\n")
    darwinCrashSignalWriteRegs(info, context)
    clib_exit_immediate(128 + sig)

fn darwinCrashSignalHandler(sig: int32) =
    darwinCrashSignalActionHandler(sig, nil, nil)

fn darwinInstallCrashSignalAction(sig: int32) =
    let actionRaw = clib_calloc(int64(16), int64(1))
    if actionRaw == nil:
        let _fallback = clib_signal(sig, &darwinCrashSignalHandler)
        return
    var handler: ptr = &darwinCrashSignalActionHandler
    clib_memcpy(actionRaw, ptr(&handler), int64(8))
    darwinRawmemWriteI8(actionRaw, 12, int8(64))
    let rc = clib_sigaction(sig, actionRaw, nil)
    clib_free(actionRaw)
    if rc != 0:
        let _fallback = clib_signal(sig, &darwinCrashSignalHandler)

fn darwinInstallCrashSignalHandlers() =
    if darwinCrashSignalHandlersReady:
        return
    darwinCrashSignalHandlersReady = true
    if !darwinCrashTraceEnabled():
        return
    let slide = clib_dyld_get_image_vmaddr_slide(0)
    if slide >= int64(0):
        darwinCrashImageSlide = uint64(slide)
    darwinInstallCrashSignalAction(4)
    darwinInstallCrashSignalAction(5)
    darwinInstallCrashSignalAction(6)
    darwinInstallCrashSignalAction(10)
    darwinInstallCrashSignalAction(11)

fn darwinPathJoin(a: str, b: str): str =
    if a.len <= 0:
        return b
    if b.len <= 0:
        return a
    if a[a.len - 1] == '/':
        return darwinConcat2(a, b)
    return darwinConcat3(a, "/", b)

fn darwinJsonBool(value: bool): str =
    if value:
        return "true"
    return "false"

fn darwinHexNibble(value: int32): str =
    return darwinSliceBytes("0123456789abcdef", value & 15, 1)

fn darwinJsonString(text: str): str =
    var out: str = "\""
    var i: int32
    while i < text.len:
        let ch: char = text[i]
        if ch == '"':
            out = darwinConcat2(out, "\\\"")
        elif ch == '\\':
            out = darwinConcat2(out, "\\\\")
        elif ch == '\n':
            out = darwinConcat2(out, "\\n")
        elif ch == '\r':
            out = darwinConcat2(out, "\\r")
        elif ch == '\t':
            out = darwinConcat2(out, "\\t")
        elif int32(ch) < 32:
            let v: int32 = int32(ch)
            out = darwinConcat3(out, "\\u00", darwinConcat2(darwinHexNibble(v >> 4), darwinHexNibble(v)))
        else:
            out = darwinConcat2(out, darwinSliceBytes(text, i, 1))
        i = i + 1
    return darwinConcat2(out, "\"")

fn darwinModeKind(mode: uint16): int32 =
    let raw: int32 = int32(mode)
    let masked: int32 = raw & 61440
    return masked

fn darwinRawByte(raw: ptr, offset: int32): int64 =
    let p: ptr = darwinPtrAdd(raw, offset)
    let rawByte: int32 = int32(*(DarwinUInt8Ptr(p)))
    let masked: int32 = rawByte & 255
    return int64(masked)

fn darwinRawReadU16LE(raw: ptr, offset: int32): int32 =
    var out: uint16
    darwinRawmemCopy(ptr(&out), darwinPtrAdd(raw, offset), 2)
    return int32(out)

fn darwinRawReadI64LE(raw: ptr, offset: int32): int64 =
    var out: int64
    darwinRawmemCopy(ptr(&out), darwinPtrAdd(raw, offset), 8)
    return out

fn darwinRawTimespecMs(raw: ptr, offset: int32): int64 =
    let sec = darwinRawReadI64LE(raw, offset)
    let nsec = darwinRawReadI64LE(raw, offset + 8)
    return sec * int64(1000) + nsec / int64(1000000)

fn darwinPathModeKind(path: str): int32 =
    let rawPath = darwinProviderCString(path)
    if rawPath == nil:
        return 0
    let statRaw = clib_calloc(int64(256), int64(1))
    if statRaw == nil:
        clib_free(rawPath)
        return 0
    let ok: int32 = clib_lstat(rawPath, statRaw)
    clib_free(rawPath)
    if ok != 0:
        clib_free(statRaw)
        return 0
    let mode = darwinRawReadU16LE(statRaw, 4)
    clib_free(statRaw)
    return mode & 0xF000

fn darwinPathLstat(path: str, outStat: var DarwinStat): int32 =
    let rawPath = darwinProviderCString(path)
    if rawPath == nil:
        return 0
    let ok: int32 = clib_lstat(rawPath, ptr(&outStat))
    clib_free(rawPath)
    if ok == 0:
        return 1
    return 0

fn darwinPathIsDirectory(path: str): bool =
    return darwinPathModeKind(path) == 0x4000

fn darwinDirentName(entry: ptr): str =
    if entry == nil:
        return ""
    return darwinProviderStrFromCStringCopy(darwinPtrAdd(entry, 21))

fn darwinDirentDType(entry: ptr): int32 =
    if entry == nil:
        return 0
    var tmp: int32
    darwinRawmemCopy(ptr(&tmp), darwinPtrAdd(entry, 20), 1)
    return tmp

fn darwinPathPopLast(path: str): str =
    if path.len <= 1:
        return "/"
    var pos: int32 = path.len - 1
    while pos > 0 && path[pos] == '/':
        pos = pos - 1
    while pos > 0 && path[pos] != '/':
        pos = pos - 1
    if pos <= 0:
        return "/"
    return darwinSliceBytes(path, 0, pos)

fn darwinNormalizeCombinedPath(combined: str): str =
    var out: str = "/"
    var i: int32
    let n: int32 = combined.len
    while i < n:
        while i < n && combined[i] == '/':
            i = i + 1
        if i >= n:
            break
        let start: int32 = i
        while i < n && combined[i] != '/':
            i = i + 1
        let count: int32 = i - start
        if count == 1 && combined[start] == '.':
            continue
        if count == 2 && combined[start] == '.' && combined[start + 1] == '.':
            out = darwinPathPopLast(out)
            continue
        let part: str = darwinSliceBytes(combined, start, count)
        if out.len > 1:
            out = darwinConcat2(out, "/")
        out = darwinConcat2(out, part)
    return out

fn darwinCurrentDir(): str =
    let raw: ptr = clib_calloc(int64(4096), int64(1))
    if raw == nil:
        return ""
    let got: cstring = clib_getcwd(raw, int64(4096))
    if got == nil:
        clib_free(raw)
        return ""
    let out: str = darwinProviderStrFromCStringCopy(raw)
    return out

fn darwinExpandHome(path: str): str =
    if path.len <= 0:
        return path
    if path[0] != '~':
        return path
    if path.len > 1 && path[1] != '/':
        return path
    let home: str = darwinProviderStrFromCStringCopy(ptr(RustCsgGetEnvExport("HOME")))
    if home.len <= 0:
        return path
    if path.len == 1:
        return home
    return darwinConcat2(home, darwinSliceBytes(path, 1, path.len - 1))

fn darwinInt32ToDecStr(value: int32): str =
    if value == -2147483648:
        return "-2147483648"
    let raw = clib_calloc(int64(16), int64(1))
    if raw == nil:
        return ""
    var n: int32 = value
    var negative: bool
    if n < 0:
        negative = true
        n = 0 - n
    var digits: int32[12]
    var digitCount: int32
    if n == 0:
        digits[0] = 0
        digitCount = 1
    else:
        while n > 0:
            digits[digitCount] = n % 10
            digitCount = digitCount + 1
            n = n / 10
    var pos: int32
    if negative:
        darwinRawmemWriteI8(raw, pos, int8(int32('-')))
        pos = pos + 1
    while digitCount > 0:
        digitCount = digitCount - 1
        darwinRawmemWriteI8(raw, pos, int8(int32('0') + digits[digitCount]))
        pos = pos + 1
    var out: str
    out.data = raw
    out.len = pos
    return out

fn darwinPad2(value: int32): str =
    let raw: str = darwinInt32ToDecStr(value)
    if raw.len >= 2:
        return raw
    return darwinConcat2("0", raw)

fn darwinPad3(value: int32): str =
    let raw: str = darwinInt32ToDecStr(value)
    if raw.len >= 3:
        return raw
    if raw.len == 2:
        return darwinConcat2("0", raw)
    return darwinConcat2("00", raw)

fn darwinPad4(value: int32): str =
    let raw: str = darwinInt32ToDecStr(value)
    if raw.len >= 4:
        return raw
    if raw.len == 3:
        return darwinConcat2("0", raw)
    if raw.len == 2:
        return darwinConcat2("00", raw)
    return darwinConcat2("000", raw)

fn darwinCivilFromDays(daysSinceEpoch: int64): DarwinCivilDate =
    var z: int64 = daysSinceEpoch + int64(719468)
    var era: int64
    if z >= int64(0):
        era = z / int64(146097)
    else:
        era = (z - int64(146096)) / int64(146097)
    let doe: int64 = z - era * int64(146097)
    let yoe: int64 = (doe - doe / int64(1460) + doe / int64(36524) - doe / int64(146096)) / int64(365)
    var year: int64 = yoe + era * int64(400)
    let doy: int64 = doe - (int64(365) * yoe + yoe / int64(4) - yoe / int64(100))
    let mp: int64 = (int64(5) * doy + int64(2)) / int64(153)
    let day: int64 = doy - (int64(153) * mp + int64(2)) / int64(5) + int64(1)
    var month: int64
    if mp < int64(10):
        month = mp + int64(3)
    else:
        month = mp - int64(9)
    if month <= int64(2):
        year = year + int64(1)
    var out: DarwinCivilDate
    out.year = int32(year)
    out.month = int32(month)
    out.day = int32(day)
    return out

fn darwinDaysFromCivil(yearIn: int32, monthIn: int32, dayIn: int32): int64 =
    var year: int64 = int64(yearIn)
    let month: int64 = int64(monthIn)
    if month <= int64(2):
        year = year - int64(1)
    var era: int64
    if year >= int64(0):
        era = year / int64(400)
    else:
        era = (year - int64(399)) / int64(400)
    let yoe: int64 = year - era * int64(400)
    var mp: int64
    if month > int64(2):
        mp = month - int64(3)
    else:
        mp = month + int64(9)
    let doy: int64 = (int64(153) * mp + int64(2)) / int64(5) + int64(dayIn) - int64(1)
    let doe: int64 = yoe * int64(365) + yoe / int64(4) - yoe / int64(100) + doy
    return era * int64(146097) + doe - int64(719468)

fn darwinParseNDigits(text: str, start: int32, count: int32): int32 =
    if start < 0 || count <= 0 || start + count > text.len:
        return -1
    var out: int32
    var i: int32
    while i < count:
        let ch: char = text[start + i]
        if ch < '0' || ch > '9':
            return -1
        out = out * 10 + (int32(ch) - int32('0'))
        i = i + 1
    return out

