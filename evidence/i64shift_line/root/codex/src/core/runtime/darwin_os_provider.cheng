@abi_internal
@exportc("RustCsgMillisToRfc3339")
fn RustCsgMillisToRfc3339Export(millis: int64): str =
    var seconds: int64 = millis / int64(1000)
    var ms: int64 = millis % int64(1000)
    if ms < int64(0):
        ms = ms + int64(1000)
        seconds = seconds - int64(1)
    var days: int64 = seconds / int64(86400)
    var rem: int64 = seconds % int64(86400)
    if rem < int64(0):
        rem = rem + int64(86400)
        days = days - int64(1)
    let civil: DarwinCivilDate = darwinCivilFromDays(days)
    let hour: int32 = int32(rem / int64(3600))
    rem = rem % int64(3600)
    let minute: int32 = int32(rem / int64(60))
    let second: int32 = int32(rem % int64(60))
    var out: str = darwinConcat3(darwinPad4(civil.year), "-", darwinPad2(civil.month))
    out = darwinConcat3(out, "-", darwinPad2(civil.day))
    out = darwinConcat3(out, "T", darwinPad2(hour))
    out = darwinConcat3(out, ":", darwinPad2(minute))
    out = darwinConcat3(out, ":", darwinPad2(second))
    if ms == int64(0):
        return darwinConcat2(out, "Z")
    return darwinConcat3(out, ".", darwinConcat2(darwinPad3(int32(ms)), "Z"))

@abi_internal
@exportc("RustCsgRfc3339ToMillisText")
fn RustCsgRfc3339ToMillisTextExport(text: str): str =
    if text.len < 20:
        return ""
    if text[4] != '-' || text[7] != '-' || text[10] != 'T' || text[13] != ':' || text[16] != ':':
        return ""
    let year: int32 = darwinParseNDigits(text, 0, 4)
    let month: int32 = darwinParseNDigits(text, 5, 2)
    let day: int32 = darwinParseNDigits(text, 8, 2)
    let hour: int32 = darwinParseNDigits(text, 11, 2)
    let minute: int32 = darwinParseNDigits(text, 14, 2)
    let second: int32 = darwinParseNDigits(text, 17, 2)
    var ms: int32
    if text.len == 20:
        if text[19] != 'Z':
            return ""
    else:
        if text[19] != '.' || text.len < 22 || text.len > 24 || text[text.len - 1] != 'Z':
            return ""
        let fracLen: int32 = text.len - 21
        ms = darwinParseNDigits(text, 20, fracLen)
    if year < 1970 || month < 1 || month > 12 || day < 1 || day > 31:
        return ""
    if hour < 0 || hour > 23 || minute < 0 || minute > 59 || second < 0 || second > 60 || ms < 0 || ms > 999:
        return ""
    let days: int64 = darwinDaysFromCivil(year, month, day)
    let totalSeconds: int64 = days * int64(86400) + int64(hour) * int64(3600) + int64(minute) * int64(60) + int64(second)
    if totalSeconds < int64(0):
        return ""
    return darwinInt64ToDecStr(totalSeconds * int64(1000) + int64(ms))

