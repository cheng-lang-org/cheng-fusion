        return 0
    let dir: ptr = clib_opendir(rawPath)
    if dir != nil:
        clib_closedir(dir)
        return 1
    let readMode = darwinProviderCString("rb")
    if readMode != nil:
        let file = clib_fopen(rawPath, readMode)
        clib_free(readMode)
        if file != nil:
            clib_fclose(file)
            return 2
    return 0

@abi_internal
@exportc("RustCsgPathStat")
fn RustCsgPathStatExport(path: str): str =
    let rawPath = darwinProviderCString(path)
    if rawPath == nil:
        return ""
    let statRaw = clib_calloc(int64(256), int64(1))
    if statRaw == nil:
        clib_free(rawPath)
        return ""
    let ok: int32 = clib_lstat(rawPath, statRaw)
    clib_free(rawPath)
    if ok != 0:
        clib_free(statRaw)
        return ""
    let rawModeKind: int32 = darwinRawReadU16LE(statRaw, 4)
    let modeKind: int32 = rawModeKind & 61440
    if modeKind == 0:
        clib_free(statRaw)
        return ""
    var createdAtMs = darwinRawTimespecMs(statRaw, 80)
    let modifiedAtMs = darwinRawTimespecMs(statRaw, 48)
    if createdAtMs <= int64(0):
        createdAtMs = modifiedAtMs
    clib_free(statRaw)
    var out: str = "{\"isDirectory\":"
    out = darwinConcat2(out, darwinJsonBool(modeKind == 16384))
    out = darwinConcat2(out, ",\"isFile\":")
    out = darwinConcat2(out, darwinJsonBool(modeKind == 32768))
    out = darwinConcat2(out, ",\"isSymlink\":")
    out = darwinConcat2(out, darwinJsonBool(modeKind == 40960))
    out = darwinConcat2(out, ",\"createdAtMs\":")
    out = darwinConcat2(out, darwinInt64ToDecStr(createdAtMs))
    out = darwinConcat2(out, ",\"modifiedAtMs\":")
    out = darwinConcat2(out, darwinInt64ToDecStr(modifiedAtMs))
    return darwinConcat2(out, "}")

@abi_internal
@exportc("RustCsgReadDir")
fn RustCsgReadDirExport(path: str): str =
    let rawPath = darwinProviderCString(path)
    if rawPath == nil:
        return ""
    let dir: ptr = clib_opendir(rawPath)
    clib_free(rawPath)
    if dir == nil:
        return ""
    var out: str = "["
    var first: bool = true
    while true:
        let entry: ptr = clib_readdir(dir)
        if entry == nil:
            break
        let name: str = darwinDirentName(entry)
        if name == "." || name == "..":
            continue
        let dType: int32 = darwinDirentDType(entry)
        if !first:
            out = darwinConcat2(out, ",")
        first = false
        out = darwinConcat2(out, "{\"fileName\":")
        out = darwinConcat2(out, darwinJsonString(name))
        out = darwinConcat2(out, ",\"isDirectory\":")
        out = darwinConcat2(out, darwinJsonBool(dType == 4))
        out = darwinConcat2(out, ",\"isFile\":")
        out = darwinConcat2(out, darwinJsonBool(dType == 8))
        out = darwinConcat2(out, "}")
    clib_closedir(dir)
    return darwinConcat2(out, "]")

fn darwinWalkDirRecInto(path: str, outPaths: var str[]) =
    let rawPath = darwinProviderCString(path)
    if rawPath == nil:
        return
    let dir: ptr = clib_opendir(rawPath)
    clib_free(rawPath)
    if dir == nil:
        return
    while true:
        let entry: ptr = clib_readdir(dir)
        if entry == nil:
            break
        let name: str = darwinDirentName(entry)
        if name == "." || name == "..":
            continue
        let child: str = darwinPathJoin(path, name)
        add(outPaths, child)
        if darwinPathIsDirectory(child):
            darwinWalkDirRecInto(child, outPaths)
    clib_closedir(dir)

@abi_internal
@exportc("WalkDirRec")
fn WalkDirRecExport(path: str): str[] =
    var out: str[]
    darwinWalkDirRecInto(path, out)
    return out

