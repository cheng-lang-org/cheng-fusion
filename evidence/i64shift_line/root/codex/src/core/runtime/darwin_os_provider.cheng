@exportc("RustCsgGetCurrentTimeMs")
fn RustCsgGetCurrentTimeMsExport(): int64 =
    darwinInstallCrashSignalHandlers()
    var tv: DarwinTimeval
    if clib_gettimeofday(ptr(&tv), nil) != 0:
        return int64(0)
    let sec: int64 = tv.tv_sec
    let usec: int64 = tv.tv_usec
    let secMs: int64 = sec * 1000
    let usecMs: int64 = usec / 1000
    return secMs + usecMs

