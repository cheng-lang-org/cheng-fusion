@exportc("RustCsgCreateTempFile")
fn RustCsgCreateTempFileExport(prefix: str): str =
    let tmpDir: str = darwinProviderStrFromCStringCopy(ptr(RustCsgGetEnvExport("TMPDIR")))
    if tmpDir.len <= 0:
        return ""
    var templateText: str
    if tmpDir[tmpDir.len - 1] == '/':
        templateText = darwinConcat2(darwinConcat2(tmpDir, prefix), "XXXXXX")
    else:
        templateText = darwinConcat3(tmpDir, "/", darwinConcat2(prefix, "XXXXXX"))
    let rawTemplate = darwinProviderCString(templateText)
    if rawTemplate == nil:
        return ""
    let fd: int32 = clib_mkstemp(rawTemplate)
    if fd < 0:
        clib_free(rawTemplate)
        return ""
    clib_close(fd)
    let out: str = darwinProviderStrFromCStringCopy(rawTemplate)
    return out

