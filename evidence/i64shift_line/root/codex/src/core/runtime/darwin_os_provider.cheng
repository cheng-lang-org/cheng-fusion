fn RustCsgNormalizePathRelativeToCurrentDirExport(path: str): str =
    let expanded: str = darwinExpandHome(path)
    if expanded.len > 0 && expanded[0] == '/':
        return darwinNormalizeCombinedPath(expanded)
    let cwd: str = darwinCurrentDir()
    if cwd.len <= 0:
        return ""
    return darwinNormalizeCombinedPath(darwinConcat3(cwd, "/", expanded))

