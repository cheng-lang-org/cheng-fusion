@exportc("cheng_auth_remove_file")
fn ChengAuthRemoveFileExport(path: str): int32 =
    return RustCsgFileDeleteExport(path)

@abi_internal
@exportc("cheng_auth_mkdir")
fn ChengAuthMkdirExport(path: str): int32 =
    return RustCsgMkdirExport(path)
