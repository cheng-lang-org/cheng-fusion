    if rawMode == nil:
        clib_free(rawPath)
        return 0
    let f: ptr = clib_fopen(rawPath, rawMode)
    clib_free(rawPath)
    clib_free(rawMode)
    if f == nil:
        return 0
    var wrote: int64 = int64(0)
    if content.len > 0:
        wrote = clib_fwrite(content.data, int64(1), int64(content.len), f)
    if wrote != int64(content.len):
        clib_fclose(f)
        return 0
    if clib_fclose(f) != 0:
        return 0
    return 1

