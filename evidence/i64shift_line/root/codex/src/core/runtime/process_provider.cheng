# Pure Cheng POSIX process provider for app-server runtime.

@importc("fork")
fn processFork(): int32
@importc("forkpty")
fn processForkPty(master: ptr, name: ptr, termp: ptr, winp: ptr): int32
@importc("setsid")
fn processSetSid(): int32
@importc("setpgid")
fn processSetPgid(pid: int32, pgid: int32): int32
@importc("getpgid")
fn processGetPgid(pid: int32): int32
@importc("pipe")
fn processPipe(fds: ptr): int32
@importc("dup2")
fn processDup2(oldFd: int32, newFd: int32): int32
@importc("execvp")
fn processExecVp(file: ptr, argv: ptr): int32
@importc("_exit")
fn processExit(status: int32)
@importc("chdir")
fn processChdir(path: ptr): int32
@importc("setenv")
fn processSetEnv(name: ptr, value: ptr, overwrite: int32): int32
# Darwin fcntl is varargs; __fcntl is the fixed-arity libsystem entry.
@importc("__fcntl")
fn processFcntl(fd: int32, cmd: int32, value: int32): int32
@importc("waitpid")
fn processWaitPid(pid: int32, status: ptr, options: int32): int32
@importc("kill")
fn processKillPid(pid: int32, signal: int32): int32
# Darwin ioctl is varargs; __ioctl is the fixed-arity libsystem entry.
@importc("__ioctl")
fn processIoctl(fd: int32, request: int32, arg: ptr): int32
@importc("read")
fn processRead(fd: int32, buf: ptr, count: int64): int64
@importc("write")
fn processWrite(fd: int32, buf: ptr, count: int64): int64
@importc("close")
fn processClose(fd: int32): int32
@importc("poll")
fn processPoll(fds: ptr, nfds: int32, timeoutMs: int32): int32
@importc("calloc")
fn processCalloc(count: int64, size: int64): ptr
@importc("free")
fn processFree(p: ptr)
@importc("memcpy")
fn processMemcpy(dst: ptr, src: ptr, count: int64): ptr
@importc("ptr_add")
fn processPtrAddRaw(p: ptr, off: int32): ptr
@importc("cheng_rawmem_write_i8")
fn processWriteI8Raw(dst: ptr, idx: int32, v: int8)

const ProcessMaxFdRead: int32 = 4096
const ProcessFGetFl: int32 = 3
const ProcessFSetFl: int32 = 4
const ProcessONonBlock: int32 = 4
const ProcessPollIn: int32 = 1
const ProcessPollErr: int32 = 8
const ProcessPollHup: int32 = 16
const ProcessPollNVal: int32 = 32
const ProcessWnohang: int32 = 1
const ProcessTiocswinsz: int32 = -2146929561

type
    ProcessUInt8Ptr = uint8 *
    ProcessInt32Ptr = int32 *

var processTable: uint64
var processLastError: str

fn processPtrAdd(p: ptr, off: int32): ptr =
    return processPtrAddRaw(p, off)

fn processWriteByte(raw: ptr, index: int32, value: int32) =
    processWriteI8Raw(raw, index, int8(value & 255))

fn processConcat(a: str, b: str): str =
    let lenA: int32 = a.len
    let lenB: int32 = b.len
    let total: int32 = lenA + lenB
    if total <= 0:
        return ""
    let raw = processCalloc(int64(total) + int64(1), int64(1))
    if raw == nil:
        return ""
    if lenA > 0 && a.data != nil:
        processMemcpy(raw, a.data, int64(lenA))
    if lenB > 0 && b.data != nil:
        processMemcpy(processPtrAdd(raw, lenA), b.data, int64(lenB))
    var out: str
    out.data = raw
    out.len = total
    return out

fn processSliceBytes(text: str, start: int32, count: int32): str =
    if text.data == nil || text.len <= 0 || count <= 0:
        return ""
    var start0: int32 = start
    if start0 < 0:
        start0 = 0
    if start0 >= text.len:
        return ""
    var kept: int32 = count
    if start0 + kept > text.len:
        kept = text.len - start0
    if kept <= 0:
        return ""
    var out: str
    out.data = processPtrAdd(text.data, start0)
    out.len = kept
    return out

fn processInt32ToDecStr(value: int32): str =
    if value == -2147483648:
        return "-2147483648"
    let raw = processCalloc(int64(16), int64(1))
    if raw == nil:
        return ""
    var n: int32 = value
    var negative: bool
    if n < 0:
        negative = true
        n = 0 - n
    var digits: int32[12]
    var digitCount: int32
    if n == 0:
        digits[0] = 0
        digitCount = 1
    else:
        while n > 0:
            digits[digitCount] = n % 10
            digitCount = digitCount + 1
            n = n / 10
    var pos: int32
    if negative:
        processWriteByte(raw, pos, int32('-'))
        pos = pos + 1
    while digitCount > 0:
        digitCount = digitCount - 1
        processWriteByte(raw, pos, int32('0') + digits[digitCount])
        pos = pos + 1
    var out: str
    out.data = raw
    out.len = pos
    return out

fn processReadByte(raw: ptr, index: int32): int32 =
    return int32(*(ProcessUInt8Ptr(processPtrAdd(raw, index)))) & 255

fn processHasPrefix(text: str, prefix: str): bool =
    if prefix.len > text.len:
        return false
    var i: int32
    while i < prefix.len:
        if text[i] != prefix[i]:
            return false
        i = i + 1
    return true

fn processReadI32(raw: ptr, index: int32): int32 =
    let p = ProcessInt32Ptr(processPtrAdd(raw, index * 4))
    return int32(*p)

fn processWriteI32(raw: ptr, index: int32, value: int32) =
    processWriteByte(raw, index * 4 + 0, value & 255)
    processWriteByte(raw, index * 4 + 1, (value >> 8) & 255)
    processWriteByte(raw, index * 4 + 2, (value >> 16) & 255)
    processWriteByte(raw, index * 4 + 3, (value >> 24) & 255)

fn processWritePtr(raw: ptr, index: int32, value: ptr) =
    var tmp: ptr = value
    processMemcpy(processPtrAdd(raw, index * 8), ptr(&tmp), int64(8))

fn processCString(text: str): ptr =
    let raw = processCalloc(int64(text.len) + int64(1), int64(1))
    if raw == nil:
        return nil
    if text.len > 0:
        processMemcpy(raw, text.data, int64(text.len))
    return raw

fn processStrFromBytes(raw: ptr, count: int32): str =
    if raw == nil || count <= 0:
        return ""
    let outRaw = processCalloc(int64(count) + int64(1), int64(1))
    if outRaw == nil:
        return ""
    processMemcpy(outRaw, raw, int64(count))
    var out: str
    out.data = outRaw
    out.len = count
    return out

fn processSetError(message: str) =
    processLastError = message

fn processEnsureTable(): bool =
    if processTable != uint64(0):
        return true
    let raw = processCalloc(int64(64 * 7), int64(4))
    if raw == nil:
        return false
    processTable = uint64(raw)
    return true

fn processSlotOffset(index: int32, field: int32): int32 =
    return index * 7 + field

fn processSlotGet(index: int32, field: int32): int32 =
    if !processEnsureTable() || index < 0 || index >= 64:
        return 0
    return processReadI32(ptr(processTable), processSlotOffset(index, field))

fn processSlotSet(index: int32, field: int32, value: int32) =
    if !processEnsureTable() || index < 0 || index >= 64:
        return
    processWriteI32(ptr(processTable), processSlotOffset(index, field), value)

fn processJsonEscape(value: str): str =
    var out: str
    var i: int32
    while i < value.len:
        let ch = value[i]
        if ch == '"':
            out = processConcat(out, "\\\"")
        elif ch == '\\':
            out = processConcat(out, "\\\\")
        elif ch == '\n':
            out = processConcat(out, "\\n")
        elif ch == '\r':
            out = processConcat(out, "\\r")
        elif ch == '\t':
            out = processConcat(out, "\\t")
        else:
            out = processConcat(out, processSliceBytes(value, i, 1))
        i = i + 1
    return out

fn processErrorJson(message: str): str =
    var msg = message
    if msg == "":
        msg = "process error"
    return processConcat(processConcat("{\"error\":\"", processJsonEscape(msg)), "\"}")

fn processSpawnJson(pid: int32, stdinFd: int32, stdoutFd: int32, stderrFd: int32): str =
    var out = processConcat("{\"pid\":", processInt32ToDecStr(pid))
    out = processConcat(out, processConcat(",\"stdin_fd\":", processInt32ToDecStr(stdinFd)))
    out = processConcat(out, processConcat(",\"stdout_fd\":", processInt32ToDecStr(stdoutFd)))
    out = processConcat(out, processConcat(",\"stderr_fd\":", processInt32ToDecStr(stderrFd)))
    return processConcat(out, "}")

fn processSpawnPtyJson(pid: int32, ptyFd: int32): str =
    var out = processConcat("{\"pid\":", processInt32ToDecStr(pid))
    out = processConcat(out, processConcat(",\"pty_fd\":", processInt32ToDecStr(ptyFd)))
    return processConcat(out, "}")

fn processResultJson(pid: int32, exitCode: int32, stdoutText: str, stderrText: str): str =
    var out = processConcat("{\"pid\":", processInt32ToDecStr(pid))
    out = processConcat(out, processConcat(",\"exit_code\":", processInt32ToDecStr(exitCode)))
    out = processConcat(out, processConcat(",\"stdout\":\"", processJsonEscape(stdoutText)))
    out = processConcat(out, processConcat("\",\"stderr\":\"", processJsonEscape(stderrText)))
    return processConcat(out, "\"}")

fn processDecodeJsonStringAt(text: str, start: int32, outValue: var str): int32 =
    outValue = ""
    if start < 0 || start >= text.len || text[start] != '"':
        return -1
    var i: int32 = start + 1
    while i < text.len:
        let ch = text[i]
        if ch == '\\':
            i = i + 1
            if i >= text.len:
                return -1
            let esc = text[i]
            if esc == '"' || esc == '\\' || esc == '/':
                outValue = processConcat(outValue, processSliceBytes(text, i, 1))
            elif esc == 'n':
                outValue = processConcat(outValue, "\n")
            elif esc == 'r':
                outValue = processConcat(outValue, "\r")
            elif esc == 't':
                outValue = processConcat(outValue, "\t")
            else:
                return -1
        elif ch == '"':
            return i + 1
        else:
            outValue = processConcat(outValue, processSliceBytes(text, i, 1))
        i = i + 1
    return -1

fn processSkipWs(text: str, pos: int32): int32 =
    var i = pos
    while i < text.len && (text[i] == ' ' || text[i] == '\t' || text[i] == '\n' || text[i] == '\r'):
        i = i + 1
    return i

fn processParsePositiveInt32(text: str): int32 =
    var value: int32
    var i: int32
    var saw: bool
    while i < text.len:
        let ch = text[i]
        if ch < '0' || ch > '9':
            return 0
        value = value * 10 + (int32(ch) - int32('0'))
        saw = true
        i = i + 1
    if !saw:
        return 0
    return value

fn processEnvValue(keys: str[], values: str[], key: str): str =
    var count = keys.len
    if values.len < count:
        count = values.len
    var i: int32
    while i < count:
        if keys[i] == key:
            return values[i]
        i = i + 1
    return ""

fn processParseJsonArray(text: str, outValues: var str[]): bool =
    outValues = []
    var i = processSkipWs(text, 0)
    if i >= text.len || text[i] != '[':
        return text == ""
    i = processSkipWs(text, i + 1)
    if i < text.len && text[i] == ']':
        return true
    while i < text.len:
        var value: str
        let next = processDecodeJsonStringAt(text, i, value)
        if next < 0:
            return false
        add(outValues, value)
        i = processSkipWs(text, next)
        if i < text.len && text[i] == ',':
            i = processSkipWs(text, i + 1)
            continue
        if i < text.len && text[i] == ']':
            return true
        return false
    return false

fn processParseJsonObject(text: str, outKeys: var str[], outValues: var str[]): bool =
    outKeys = []
    outValues = []
    var i = processSkipWs(text, 0)
    if i >= text.len || text[i] != '{':
        return text == ""
    i = processSkipWs(text, i + 1)
    if i < text.len && text[i] == '}':
        return true
    while i < text.len:
        var key: str
        var value: str
        let afterKey = processDecodeJsonStringAt(text, i, key)
        if afterKey < 0:
            return false
        i = processSkipWs(text, afterKey)
        if i >= text.len || text[i] != ':':
            return false
        i = processSkipWs(text, i + 1)
        let afterValue = processDecodeJsonStringAt(text, i, value)
        if afterValue < 0:
            return false
        add(outKeys, key)
        add(outValues, value)
        i = processSkipWs(text, afterValue)
        if i < text.len && text[i] == ',':
            i = processSkipWs(text, i + 1)
            continue
        if i < text.len && text[i] == '}':
            return true
        return false
    return false

fn processRegister(pid: int32, pgid: int32, stdinFd: int32, stdoutFd: int32, stderrFd: int32): int32 =
    if !processEnsureTable():
        return -1
    for i in 0..<64:
        if processSlotGet(i, 0) == 0:
            processSlotSet(i, 0, pid)
            processSlotSet(i, 1, pgid)
            processSlotSet(i, 2, stdinFd)
            processSlotSet(i, 3, stdoutFd)
            processSlotSet(i, 4, stderrFd)
            processSlotSet(i, 5, 0)
            processSlotSet(i, 6, -1)
            return i
    return -1

fn processFind(pid: int32): int32 =
    if !processEnsureTable():
        return -1
    for i in 0..<64:
        if processSlotGet(i, 0) == pid:
            return i
    return -1

fn processCloseTracked(index: int32) =
    if index < 0 || index >= 64:
        return
    let stdinFd = processSlotGet(index, 2)
    let stdoutFd = processSlotGet(index, 3)
    let stderrFd = processSlotGet(index, 4)
    if stdinFd >= 0:
        processClose(stdinFd)
    if stdoutFd >= 0:
        processClose(stdoutFd)
    if stderrFd >= 0:
        processClose(stderrFd)
    processSlotSet(index, 0, 0)
    processSlotSet(index, 1, 0)
    processSlotSet(index, 2, -1)
    processSlotSet(index, 3, -1)
    processSlotSet(index, 4, -1)
    processSlotSet(index, 5, 0)
    processSlotSet(index, 6, -1)

fn processSetNonBlocking(fd: int32) =
    if fd < 0:
        return
    let flags = processFcntl(fd, ProcessFGetFl, 0)
    if flags >= 0:
        processFcntl(fd, ProcessFSetFl, flags | ProcessONonBlock)

fn processMarkFdClosed(fd: int32) =
    if fd < 0:
        return
    for i in 0..<64:
        if processSlotGet(i, 2) == fd:
            processSlotSet(i, 2, -1)
        if processSlotGet(i, 3) == fd:
            processSlotSet(i, 3, -1)
        if processSlotGet(i, 4) == fd:
            processSlotSet(i, 4, -1)

fn processAllocArgv(command: str, args: str[], allocated: var ptr[]): ptr =
    allocated = []
    let argv = processCalloc(int64(args.len + 2), int64(8))
    if argv == nil:
        return nil
    let commandPtr = processCString(command)
    if commandPtr == nil:
        processFree(argv)
        return nil
    add(allocated, commandPtr)
    processWritePtr(argv, 0, commandPtr)
    for i in 0..<args.len:
        let argPtr = processCString(args[i])
        if argPtr == nil:
            return nil
        add(allocated, argPtr)
        processWritePtr(argv, i + 1, argPtr)
    return argv

fn processFreePtrList(items: ptr[]) =
    for i in 0..<items.len:
        if items[i] != nil:
            processFree(items[i])

fn processApplyEnv(keys: ptr[], values: ptr[]) =
    var count = keys.len
    if values.len < count:
        count = values.len
    for i in 0..<count:
        if keys[i] != nil && values[i] != nil:
            processSetEnv(keys[i], values[i], 1)

fn processBuildEnvPtrs(keys: str[], values: str[], outKeys: var ptr[], outValues: var ptr[]): bool =
    outKeys = []
    outValues = []
    if keys.len != values.len:
        return false
    for i in 0..<keys.len:
        let keyPtr = processCString(keys[i])
        let valuePtr = processCString(values[i])
        if keyPtr == nil || valuePtr == nil:
            return false
        add(outKeys, keyPtr)
        add(outValues, valuePtr)
    return true

fn processReadPipePair(outFd: int32, errFd: int32, outText: var str, errText: var str, outOpen: var bool, errOpen: var bool) =
    let pollCount = (outOpen ? 1 : 0) + (errOpen ? 1 : 0)
    if pollCount <= 0:
        return
    let fds = processCalloc(int64(pollCount * 8), int64(1))
    if fds == nil:
        return
    var slot: int32
    if outOpen:
        processWriteByte(fds, slot * 8 + 0, outFd & 255)
        processWriteByte(fds, slot * 8 + 1, (outFd >> 8) & 255)
        processWriteByte(fds, slot * 8 + 2, (outFd >> 16) & 255)
        processWriteByte(fds, slot * 8 + 3, (outFd >> 24) & 255)
        processWriteByte(fds, slot * 8 + 4, ProcessPollIn | ProcessPollHup)
        slot = slot + 1
    if errOpen:
        processWriteByte(fds, slot * 8 + 0, errFd & 255)
        processWriteByte(fds, slot * 8 + 1, (errFd >> 8) & 255)
        processWriteByte(fds, slot * 8 + 2, (errFd >> 16) & 255)
        processWriteByte(fds, slot * 8 + 3, (errFd >> 24) & 255)
        processWriteByte(fds, slot * 8 + 4, ProcessPollIn | ProcessPollHup)
    processPoll(fds, pollCount, 50)
    processFree(fds)
    let buf = processCalloc(int64(ProcessMaxFdRead), int64(1))
    if buf == nil:
        return
    if outOpen:
        let n = processRead(outFd, buf, int64(ProcessMaxFdRead))
        if n > int64(0):
            outText = processConcat(outText, processStrFromBytes(buf, int32(n)))
        elif n == int64(0):
            outOpen = false
            processClose(outFd)
            processMarkFdClosed(outFd)
    if errOpen:
        let n = processRead(errFd, buf, int64(ProcessMaxFdRead))
        if n > int64(0):
            errText = processConcat(errText, processStrFromBytes(buf, int32(n)))
        elif n == int64(0):
            errOpen = false
            processClose(errFd)
            processMarkFdClosed(errFd)
    processFree(buf)

fn processStatusToExitCode(status: int32): int32 =
    if (status & 127) == 0:
        return (status >> 8) & 255
    return 0 - (status & 127)

@abi_internal
@exportc("cheng_process_spawn")
fn ChengProcessSpawnExport(command: str, argsJson: str, cwd: str, envJson: str): str =
    if command == "":
        return processErrorJson("empty command")
    var args: str[]
    var envKeys: str[]
    var envValues: str[]
    if !processParseJsonArray(argsJson, args):
        return processErrorJson("invalid args JSON")
    if !processParseJsonObject(envJson, envKeys, envValues):
        return processErrorJson("invalid env JSON")
    var argvAllocs: ptr[]
    let argv = processAllocArgv(command, args, argvAllocs)
    if argv == nil:
        processFreePtrList(argvAllocs)
        return processErrorJson("argv allocation failed")
    var envKeyPtrs: ptr[]
    var envValuePtrs: ptr[]
    if !processBuildEnvPtrs(envKeys, envValues, envKeyPtrs, envValuePtrs):
        processFreePtrList(argvAllocs)
        processFree(argv)
        processFreePtrList(envKeyPtrs)
        processFreePtrList(envValuePtrs)
        return processErrorJson("env allocation failed")
    let cwdPtr = processCString(cwd)
    let stdinPipe = processCalloc(int64(8), int64(1))
    let stdoutPipe = processCalloc(int64(8), int64(1))
    let stderrPipe = processCalloc(int64(8), int64(1))
    if stdinPipe == nil || stdoutPipe == nil || stderrPipe == nil:
        return processErrorJson("pipe allocation failed")
    if processPipe(stdinPipe) != 0 || processPipe(stdoutPipe) != 0 || processPipe(stderrPipe) != 0:
        return processErrorJson("pipe failed")
    let stdinRead = processReadI32(stdinPipe, 0)
    let stdinWrite = processReadI32(stdinPipe, 1)
    let stdoutRead = processReadI32(stdoutPipe, 0)
    let stdoutWrite = processReadI32(stdoutPipe, 1)
    let stderrRead = processReadI32(stderrPipe, 0)
    let stderrWrite = processReadI32(stderrPipe, 1)
    let pid = processFork()
    if pid < 0:
        return processErrorJson("fork failed")
    if pid == 0:
        processSetSid()
        processClose(stdinWrite)
        processClose(stdoutRead)
        processClose(stderrRead)
        if stdinRead != 0:
            processDup2(stdinRead, 0)
            processClose(stdinRead)
        if stdoutWrite != 1:
            processDup2(stdoutWrite, 1)
            processClose(stdoutWrite)
        if stderrWrite != 2:
            processDup2(stderrWrite, 2)
            processClose(stderrWrite)
        if cwdPtr != nil && cwd != "":
            processChdir(cwdPtr)
        processApplyEnv(envKeyPtrs, envValuePtrs)
        processExecVp(argvAllocs[0], argv)
        processExit(127)
    processSetPgid(pid, pid)
    processClose(stdinRead)
    processClose(stdoutWrite)
    processClose(stderrWrite)
    processSetNonBlocking(stdoutRead)
    processSetNonBlocking(stderrRead)
    processRegister(pid, pid, stdinWrite, stdoutRead, stderrRead)
    processFreePtrList(argvAllocs)
    processFreePtrList(envKeyPtrs)
    processFreePtrList(envValuePtrs)
    processFree(argv)
    if cwdPtr != nil:
        processFree(cwdPtr)
    processFree(stdinPipe)
    processFree(stdoutPipe)
    processFree(stderrPipe)
    processSetError("")
    return processSpawnJson(pid, stdinWrite, stdoutRead, stderrRead)

@abi_internal
@exportc("cheng_process_spawn_pty")
fn ChengProcessSpawnPtyExport(command: str, argsJson: str, cwd: str, envJson: str): str =
    if command == "":
        return processErrorJson("empty command")
    var args: str[]
    var envKeys: str[]
    var envValues: str[]
    if !processParseJsonArray(argsJson, args):
        return processErrorJson("invalid args JSON")
    if !processParseJsonObject(envJson, envKeys, envValues):
        return processErrorJson("invalid env JSON")
    var argvAllocs: ptr[]
    let argv = processAllocArgv(command, args, argvAllocs)
    if argv == nil:
        return processErrorJson("argv allocation failed")
    var envKeyPtrs: ptr[]
    var envValuePtrs: ptr[]
    if !processBuildEnvPtrs(envKeys, envValues, envKeyPtrs, envValuePtrs):
        return processErrorJson("env allocation failed")
    let cwdPtr = processCString(cwd)
    let masterSlot = processCalloc(int64(4), int64(1))
    let winsize = processCalloc(int64(8), int64(1))
    if masterSlot == nil || winsize == nil:
        return processErrorJson("pty allocation failed")
    var rows: int32 = 24
    var cols: int32 = 80
    let rowsEnv = processParsePositiveInt32(processEnvValue(envKeys, envValues, "CHENG_PROCESS_PTY_ROWS"))
    let colsEnv = processParsePositiveInt32(processEnvValue(envKeys, envValues, "CHENG_PROCESS_PTY_COLS"))
    if rowsEnv > 0:
        rows = rowsEnv
    if colsEnv > 0:
        cols = colsEnv
    processWriteByte(winsize, 0, rows & 255)
    processWriteByte(winsize, 1, (rows >> 8) & 255)
    processWriteByte(winsize, 2, cols & 255)
    processWriteByte(winsize, 3, (cols >> 8) & 255)
    let pid = processForkPty(masterSlot, nil, nil, winsize)
    if pid < 0:
        return processErrorJson("forkpty failed")
    if pid == 0:
        if cwdPtr != nil && cwd != "":
            processChdir(cwdPtr)
        processApplyEnv(envKeyPtrs, envValuePtrs)
        processExecVp(argvAllocs[0], argv)
        processExit(127)
    let masterFd = processReadI32(masterSlot, 0)
    processSetPgid(pid, pid)
    processSetNonBlocking(masterFd)
    processRegister(pid, pid, -1, masterFd, -1)
    processFreePtrList(argvAllocs)
    processFreePtrList(envKeyPtrs)
    processFreePtrList(envValuePtrs)
    processFree(argv)
    if cwdPtr != nil:
        processFree(cwdPtr)
    processFree(masterSlot)
    processFree(winsize)
    processSetError("")
    return processSpawnPtyJson(pid, masterFd)

@exportc("cheng_process_wait_raw")
fn ChengProcessWaitRawExport(pid: int32): int32 =
    let index = processFind(pid)
    if index >= 0 && processSlotGet(index, 5) != 0:
        let code = processSlotGet(index, 6)
        processCloseTracked(index)
        return code
    if index >= 0 && processSlotGet(index, 6) != -1:
        let code = processSlotGet(index, 6)
        processCloseTracked(index)
        return code
    let status = processCalloc(int64(4), int64(1))
    if status == nil:
        return -1
    let ret = processWaitPid(pid, status, 0)
    if ret < 0:
        processFree(status)
        if index >= 0 && processSlotGet(index, 6) != -1:
            let code = processSlotGet(index, 6)
            if index >= 0:
                processCloseTracked(index)
            return code
        if index >= 0:
            processCloseTracked(index)
        return -1
    let code = processStatusToExitCode(processReadI32(status, 0))
    processFree(status)
    if index >= 0:
        processCloseTracked(index)
    return code

@exportc("cheng_process_try_wait_raw")
fn ChengProcessTryWaitRawExport(pid: int32): int32 =
    let index = processFind(pid)
    if index >= 0 && processSlotGet(index, 5) != 0:
        return processSlotGet(index, 6)
    let status = processCalloc(int64(4), int64(1))
    if status == nil:
        return -1
    let ret = processWaitPid(pid, status, ProcessWnohang)
    if ret == 0:
        processFree(status)
        return -2
    if ret < 0:
        processFree(status)
        return -1
    let code = processStatusToExitCode(processReadI32(status, 0))
    processFree(status)
    if index >= 0:
        processSlotSet(index, 6, code)
        processSlotSet(index, 5, 1)
    return code

@exportc("cheng_process_kill_group")
fn ChengProcessKillGroupExport(pid: int32, signal: int32): int32 =
    let index = processFind(pid)
    var pgid = pid
    if index >= 0 && processSlotGet(index, 1) > 0:
        pgid = processSlotGet(index, 1)
    else:
        let found = processGetPgid(pid)
        if found > 0:
            pgid = found
    if pgid > 0 && processKillPid(0 - pgid, signal) == 0:
        return 0
    return processKillPid(pid, signal)

@exportc("cheng_process_resize_pty")
fn ChengProcessResizePtyExport(fd: int32, rows: int32, cols: int32): int32 =
    if fd < 0 || rows <= 0 || cols <= 0:
        return -1
    let winsize = processCalloc(int64(8), int64(1))
    if winsize == nil:
        return -1
    processWriteByte(winsize, 0, rows & 255)
    processWriteByte(winsize, 1, (rows >> 8) & 255)
    processWriteByte(winsize, 2, cols & 255)
    processWriteByte(winsize, 3, (cols >> 8) & 255)
    let rc = processIoctl(fd, ProcessTiocswinsz, winsize)
    processFree(winsize)
    return rc

@abi_internal
@exportc("cheng_process_read_fd")
fn ChengProcessReadFdExport(fd: int32): str =
    if fd < 0:
        return ""
    let buf = processCalloc(int64(ProcessMaxFdRead), int64(1))
    if buf == nil:
        return ""
    let n = processRead(fd, buf, int64(ProcessMaxFdRead))
    if n <= int64(0):
        processFree(buf)
        return ""
    let out = processStrFromBytes(buf, int32(n))
    processFree(buf)
    return out

@abi_internal
@exportc("cheng_process_read_fd_blocking")
fn ChengProcessReadFdBlockingExport(fd: int32, timeoutMs: int32): str =
    if fd < 0:
        return ""
    let fds = processCalloc(int64(8), int64(1))
    if fds == nil:
        return ""
    processWriteByte(fds, 0, fd & 255)
    processWriteByte(fds, 1, (fd >> 8) & 255)
    processWriteByte(fds, 2, (fd >> 16) & 255)
    processWriteByte(fds, 3, (fd >> 24) & 255)
    processWriteByte(fds, 4, ProcessPollIn | ProcessPollHup)
    let rc = processPoll(fds, 1, timeoutMs)
    processFree(fds)
    if rc <= 0:
        return ""
    return ChengProcessReadFdExport(fd)

@abi_internal
@exportc("cheng_process_read_fd_blocking_event")
fn ChengProcessReadFdBlockingEventExport(fd: int32, timeoutMs: int32): str =
    if fd < 0:
        return "Ebad fd"
    let fds = processCalloc(int64(8), int64(1))
    if fds == nil:
        return "Ealloc"
    processWriteByte(fds, 0, fd & 255)
    processWriteByte(fds, 1, (fd >> 8) & 255)
    processWriteByte(fds, 2, (fd >> 16) & 255)
    processWriteByte(fds, 3, (fd >> 24) & 255)
    processWriteByte(fds, 4, ProcessPollIn | ProcessPollHup)
    let rc = processPoll(fds, 1, timeoutMs)
    let revents = processReadByte(fds, 6) | (processReadByte(fds, 7) << 8)
    processFree(fds)
    if rc < 0:
        return "Epoll failed"
    if rc == 0:
        return "T"
    if (revents & ProcessPollErr) != 0:
        return "Epoll error"

    let buf = processCalloc(int64(ProcessMaxFdRead), int64(1))
    if buf == nil:
        return "Ealloc"
    let n = processRead(fd, buf, int64(ProcessMaxFdRead))
    if n > int64(0):
        let data = processStrFromBytes(buf, int32(n))
        let out = processConcat("D", data)
        processFree(buf)
        return out
    processFree(buf)
    if n == int64(0):
        return "F"
    return "Eread failed"

@abi_internal
@exportc("cheng_process_write_fd")
fn ChengProcessWriteFdExport(fd: int32, data: str): int32 =
    if fd < 0:
        return -1
    var written: int32
    while written < data.len:
        let n = processWrite(fd, processPtrAdd(data.data, written), int64(data.len - written))
        if n <= int64(0):
            return written > 0 ? written : -1
        written = written + int32(n)
    return written

@exportc("cheng_process_close_fd")
fn ChengProcessCloseFdExport(fd: int32): int32 =
    if fd < 0:
        return -1
    let rc = processClose(fd)
    processMarkFdClosed(fd)
    return rc

@abi_internal
@exportc("cheng_process_spawn_blocking")
fn ChengProcessSpawnBlockingExport(command: str, argsJson: str, cwd: str, envJson: str): str =
    let spawned = ChengProcessSpawnExport(command, argsJson, cwd, envJson)
    if processHasPrefix(spawned, "{\"error\":"):
        return spawned
    let pid = processJsonInt(spawned, "pid")
    let stdinFd = processJsonInt(spawned, "stdin_fd")
    let stdoutFd = processJsonInt(spawned, "stdout_fd")
    let stderrFd = processJsonInt(spawned, "stderr_fd")
    if stdinFd >= 0:
        ChengProcessCloseFdExport(stdinFd)
    var outText: str
    var errText: str
    var outOpen: bool = stdoutFd >= 0
    var errOpen: bool = stderrFd >= 0
    var exitCode: int32 = -2
    while outOpen || errOpen || exitCode == -2:
        processReadPipePair(stdoutFd, stderrFd, outText, errText, outOpen, errOpen)
        if exitCode == -2:
            exitCode = ChengProcessTryWaitRawExport(pid)
            if exitCode == -1:
                exitCode = ChengProcessWaitRawExport(pid)
        if exitCode != -2 && !outOpen && !errOpen:
            break
    let index = processFind(pid)
    if index >= 0:
        processCloseTracked(index)
    return processResultJson(pid, exitCode, outText, errText)

fn processJsonInt(json: str, key: str): int32 =
    var pattern = processConcat("\"", key)
    pattern = processConcat(pattern, "\":")
    var i: int32
    while i + pattern.len <= json.len:
        if processSliceBytes(json, i, pattern.len) == pattern:
            i = i + pattern.len
            var sign: int32 = 1
            if i < json.len && json[i] == '-':
                sign = -1
                i = i + 1
            var value: int32
            while i < json.len && json[i] >= '0' && json[i] <= '9':
                value = value * 10 + (int32(json[i]) - int32('0'))
                i = i + 1
            return value * sign
        i = i + 1
    return -1

@abi_internal
@exportc("cheng_process_spawn_seatbelt")
fn ChengProcessSpawnSeatbeltExport(command: str, argsJson: str, cwd: str, envJson: str, profile: str): str =
    var args: str[]
    if !processParseJsonArray(argsJson, args):
        return processErrorJson("invalid args JSON")
    var wrapped: str[] = ["-p", profile, command]
    for i in 0..<args.len:
        add(wrapped, args[i])
    return ChengProcessSpawnExport("/usr/bin/sandbox-exec", processStringArrayJson(wrapped), cwd, envJson)

@abi_internal
@exportc("cheng_process_spawn_seatbelt_pty")
fn ChengProcessSpawnSeatbeltPtyExport(command: str, argsJson: str, cwd: str, envJson: str, profile: str): str =
    var args: str[]
    if !processParseJsonArray(argsJson, args):
        return processErrorJson("invalid args JSON")
    var wrapped: str[] = ["-p", profile, command]
    for i in 0..<args.len:
        add(wrapped, args[i])
    return ChengProcessSpawnPtyExport("/usr/bin/sandbox-exec", processStringArrayJson(wrapped), cwd, envJson)

@abi_internal
@exportc("cheng_process_spawn_seatbelt_blocking")
fn ChengProcessSpawnSeatbeltBlockingExport(command: str, argsJson: str, cwd: str, envJson: str, profile: str): str =
    var args: str[]
    if !processParseJsonArray(argsJson, args):
        return processErrorJson("invalid args JSON")
    var wrapped: str[] = ["-p", profile, command]
    for i in 0..<args.len:
        add(wrapped, args[i])
    return ChengProcessSpawnBlockingExport("/usr/bin/sandbox-exec", processStringArrayJson(wrapped), cwd, envJson)

fn processStringArrayJson(items: str[]): str =
    var out: str = "["
    for i in 0..<items.len:
        if i > 0:
            out = processConcat(out, ",")
        out = processConcat(out, processConcat("\"", processJsonEscape(items[i])))
        out = processConcat(out, "\"")
    return processConcat(out, "]")

@abi_internal
@exportc("cheng_process_kill")
fn ChengProcessKillExport(pid: int32, signal: int32): int32 =
    var rc = processKillPid(pid, signal)
    if rc < 0:
        processSetError("kill failed")
        return -1
    processSetError("")
    return 0

@abi_internal
@exportc("cheng_process_last_error")
fn ChengProcessLastErrorExport(): str =
    return processLastError
