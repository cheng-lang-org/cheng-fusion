import std/strings

fn shellNeedsQuoting(text: str): bool =
    for i in 0..<text.len:
        let ch = text[i]
        if ch >= 'a' && ch <= 'z': continue
        if ch >= 'A' && ch <= 'Z': continue
        if ch >= '0' && ch <= '9': continue
        var safe = false
        let safeChars = "%+-./:@_~=,"
        for j in 0..<safeChars.len:
            if safeChars[j] == ch: safe = true
        if !safe: return true
    return false

fn shellQuoteToken(text: str): str =
    if !shellNeedsQuoting(text): return text
    var out: str = "'"
    for i in 0..<text.len:
        if text[i] == '\'':
            out = strings.ConcatStr(out, "'\\''")
        else:
            out = strings.ConcatStr(out, strings.SliceBytes(text, i, 1))
    return strings.ConcatStr(out, "'")

fn shellSkipSpaces(text: str, start: int32): int32 =
    var i = start
    while i < text.len && text[i] == ' ': i = i + 1
    return i

fn shellWordEnd(text: str, start: int32): int32 =
    var i = start
    while i < text.len && text[i] != ' ': i = i + 1
    return i

fn shellNextWordStart(text: str, start: int32): int32 =
    return shellSkipSpaces(text, shellWordEnd(text, shellSkipSpaces(text, start)))

fn shellWordEqAt(text: str, start: int32, word: str): bool =
    let s = shellSkipSpaces(text, start)
    let e = shellWordEnd(text, s)
    if e - s != word.len: return false
    for i in 0..<word.len:
        if text[s + i] != word[i]: return false
    return true

fn shellRmFlagDangerousAt(text: str, start: int32): bool =
    let s = shellSkipSpaces(text, start)
    if s >= text.len: return false
    if text[s] != '-': return false
    if s + 1 >= text.len: return false
    if text[s + 1] == 'r' || text[s + 1] == 'f': return true
    return false

@abi_internal
@exportc("ShlexJoinTwo")
fn ShlexJoinTwoExport(a: str, b: str): str =
    if a == "": return b
    if b == "": return a
    var qa = shellQuoteToken(a)
    var qb = shellQuoteToken(b)
    return strings.ConcatStr(strings.ConcatStr(qa, " "), qb)

@abi_internal
@exportc("ShellIsDangerousCommand")
fn ShellIsDangerousCommandExport(cmd: str): int32 =
    if cmd.len <= 0: return 0
    let first = shellSkipSpaces(cmd, 0)
    if first >= cmd.len: return 0
    if shellWordEqAt(cmd, first, "sudo"):
        let sub1 = shellNextWordStart(cmd, first)
        let sub2 = shellNextWordStart(cmd, sub1)
        if shellWordEqAt(cmd, sub1, "rm") && shellRmFlagDangerousAt(cmd, sub2): return 1
        return 0
    if shellWordEqAt(cmd, first, "rm"):
        let flags = shellNextWordStart(cmd, first)
        if shellRmFlagDangerousAt(cmd, flags): return 1
    return 0

@abi_internal
@exportc("ShellIsSafeCommand")
fn ShellIsSafeCommandExport(cmd: str): int32 =
    if cmd.len <= 0: return 0
    let first = shellSkipSpaces(cmd, 0)
    if first >= cmd.len: return 0
    let safeCmds: str[] = [
        "cat","cd","cut","echo","expr","false",
        "grep","head","id","ls","nl","pwd",
        "rev","seq","stat","tail","tr","true",
        "uname","uniq","wc","which","whoami","sed",
        "base64","find","rg","git"
    ]
    for i in 0..<safeCmds.len:
        if shellWordEqAt(cmd, first, safeCmds[i]): return 1
    return 0
