# Pure Cheng model provider.
#
# Keeps embedding/image generation on the real HTTP provider path and exports
# the model runtime symbols consumed by app-server.

@importc("strlen")
fn modelClibStrlen(raw: ptr): int64

@importc("calloc")
fn modelClibCalloc(count: int64, size: int64): ptr

@importc("memcpy")
fn modelClibMemcpy(dst: ptr, src: ptr, count: int64): ptr

@importc("free")
fn modelClibFree(raw: ptr)

@importc("cheng_http_post")
fn modelHttpPostAbi(url: cstring, body: cstring, headers: cstring): cstring

@importc("ptr_add")
fn modelPtrAddRaw(p: ptr, off: int32): ptr

@importc("cheng_rawmem_write_i8")
fn modelWriteI8Raw(dst: ptr, idx: int32, v: int8)

fn modelPtrAdd(p: ptr, off: int32): ptr =
    return modelPtrAddRaw(p, off)

fn modelWriteByte(raw: ptr, index: int32, value: int32) =
    modelWriteI8Raw(raw, index, int8(value & 255))

fn modelConcat(a: str, b: str): str =
    let lenA: int32 = a.len
    let lenB: int32 = b.len
    let total: int32 = lenA + lenB
    if total <= 0:
        return ""
    let raw = modelClibCalloc(int64(total) + int64(1), int64(1))
    if raw == nil:
        return ""
    if lenA > 0 && a.data != nil:
        modelClibMemcpy(raw, a.data, int64(lenA))
    if lenB > 0 && b.data != nil:
        modelClibMemcpy(modelPtrAdd(raw, lenA), b.data, int64(lenB))
    var out: str
    out.data = raw
    out.len = total
    return out

fn modelSliceBytes(text: str, start: int32, count: int32): str =
    if text.data == nil || text.len <= 0 || count <= 0:
        return ""
    var start0: int32 = start
    if start0 < 0:
        start0 = 0
    if start0 >= text.len:
        return ""
    var kept: int32 = count
    if start0 + kept > text.len:
        kept = text.len - start0
    if kept <= 0:
        return ""
    var out: str
    out.data = modelPtrAdd(text.data, start0)
    out.len = kept
    return out

fn modelInt32ToDecStr(value: int32): str =
    if value == -2147483648:
        return "-2147483648"
    let raw = modelClibCalloc(int64(16), int64(1))
    if raw == nil:
        return ""
    var n: int32 = value
    var negative: bool
    if n < 0:
        negative = true
        n = 0 - n
    var digits: int32[12]
    var digitCount: int32
    if n == 0:
        digits[0] = 0
        digitCount = 1
    else:
        while n > 0:
            digits[digitCount] = n % 10
            digitCount = digitCount + 1
            n = n / 10
    var pos: int32
    if negative:
        modelWriteByte(raw, pos, int32('-'))
        pos = pos + 1
    while digitCount > 0:
        digitCount = digitCount - 1
        modelWriteByte(raw, pos, int32('0') + digits[digitCount])
        pos = pos + 1
    var out: str
    out.data = raw
    out.len = pos
    return out

fn modelStrFromCStringCopy(raw: cstring): str =
    var out: str
    if ptr(raw) == nil:
        return out
    let count = int32(modelClibStrlen(ptr(raw)))
    if count <= 0:
        return out
    let outRaw = modelClibCalloc(int64(count) + int64(1), int64(1))
    if outRaw == nil:
        return out
    modelClibMemcpy(outRaw, ptr(raw), int64(count))
    out.data = outRaw
    out.len = count
    return out

fn modelCString(text: str): cstring =
    let raw = modelClibCalloc(int64(text.len) + int64(1), int64(1))
    if raw == nil:
        return cstring(nil)
    if text.len > 0:
        modelClibMemcpy(raw, text.data, int64(text.len))
    return cstring(raw)

fn modelHttpPost(url: str, body: str, headers: str): str =
    let urlRaw = modelCString(url)
    let bodyRaw = modelCString(body)
    let headersRaw = modelCString(headers)
    let raw = modelHttpPostAbi(urlRaw, bodyRaw, headersRaw)
    if ptr(urlRaw) != nil:
        modelClibFree(ptr(urlRaw))
    if ptr(bodyRaw) != nil:
        modelClibFree(ptr(bodyRaw))
    if ptr(headersRaw) != nil:
        modelClibFree(ptr(headersRaw))
    let out = modelStrFromCStringCopy(raw)
    if ptr(raw) != nil:
        modelClibFree(ptr(raw))
    return out

fn modelCat3(a: str, b: str, c: str): str =
    return modelConcat(modelConcat(a, b), c)

fn modelHexNibble(value: int32): str =
    return modelSliceBytes("0123456789abcdef", value & 15, 1)

fn modelJsonQuote(value: str): str =
    var out: str = "\""
    var i: int32
    while i < value.len:
        let ch = value[i]
        if ch == '"':
            out = modelConcat(out, "\\\"")
        elif ch == '\\':
            out = modelConcat(out, "\\\\")
        elif ch == '\n':
            out = modelConcat(out, "\\n")
        elif ch == '\r':
            out = modelConcat(out, "\\r")
        elif ch == '\t':
            out = modelConcat(out, "\\t")
        elif int32(ch) < 32:
            let v = int32(ch)
            out = modelCat3(out, "\\u00", modelConcat(modelHexNibble(v >> 4), modelHexNibble(v)))
        else:
            out = modelConcat(out, modelSliceBytes(value, i, 1))
        i = i + 1
    return modelConcat(out, "\"")

fn modelErrorJson(message: str): str =
    var msg = message
    if msg == "":
        msg = "model provider error"
    return modelCat3("{\"error\":", modelJsonQuote(msg), "}")

fn modelStartsWith(text: str, prefix: str): bool =
    if prefix.len > text.len:
        return false
    var i: int32
    while i < prefix.len:
        if text[i] != prefix[i]:
            return false
        i = i + 1
    return true

fn modelSkipWs(text: str, pos: int32): int32 =
    var i = pos
    while i < text.len && (text[i] == ' ' || text[i] == '\t' || text[i] == '\n' || text[i] == '\r'):
        i = i + 1
    return i

fn modelParseInt(text: str): int32 =
    var i: int32
    var sign: int32 = 1
    if text.len > 0 && text[0] == '-':
        sign = -1
        i = 1
    var value: int32
    while i < text.len:
        let ch = text[i]
        if ch < '0' || ch > '9':
            break
        value = value * 10 + (int32(ch) - int32('0'))
        i = i + 1
    return value * sign

fn modelDecodeJsonStringAt(text: str, start: int32, outValue: var str): int32 =
    outValue = ""
    if start < 0 || start >= text.len || text[start] != '"':
        return -1
    var i: int32 = start + 1
    while i < text.len:
        let ch = text[i]
        if ch == '\\':
            i = i + 1
            if i >= text.len:
                return -1
            let esc = text[i]
            if esc == '"' || esc == '\\' || esc == '/':
                outValue = modelConcat(outValue, modelSliceBytes(text, i, 1))
            elif esc == 'n':
                outValue = modelConcat(outValue, "\n")
            elif esc == 'r':
                outValue = modelConcat(outValue, "\r")
            elif esc == 't':
                outValue = modelConcat(outValue, "\t")
            else:
                return -1
        elif ch == '"':
            return i + 1
        else:
            outValue = modelConcat(outValue, modelSliceBytes(text, i, 1))
        i = i + 1
    return -1

fn modelFindKeyValueStart(json: str, key: str): int32 =
    if key.len <= 0:
        return -1
    var i: int32
    while i + key.len + 2 <= json.len:
        if json[i] == '"':
            var matched: bool = true
            var j: int32
            while j < key.len:
                if json[i + 1 + j] != key[j]:
                    matched = false
                    break
                j = j + 1
            if matched && i + 1 + key.len < json.len && json[i + 1 + key.len] == '"':
                var p = modelSkipWs(json, i + key.len + 2)
                if p < json.len && json[p] == ':':
                    return modelSkipWs(json, p + 1)
        i = i + 1
    return -1

fn modelFindJsonString(json: str, key: str): str =
    let start = modelFindKeyValueStart(json, key)
    if start < 0 || start >= json.len || json[start] != '"':
        return ""
    var out: str
    let end = modelDecodeJsonStringAt(json, start, out)
    if end < 0:
        return ""
    return out

fn modelFindJsonRawEnd(json: str, start: int32): int32 =
    if start < 0 || start >= json.len:
        return -1
    if json[start] == '"':
        var ignored: str
        return modelDecodeJsonStringAt(json, start, ignored)
    if json[start] == '[' || json[start] == '{':
        let open = json[start]
        var close: char = ']'
        if open == '{':
            close = '}'
        var depth: int32 = 1
        var i: int32 = start + 1
        while i < json.len && depth > 0:
            if json[i] == '"':
                var ignored: str
                let next = modelDecodeJsonStringAt(json, i, ignored)
                if next < 0:
                    return -1
                i = next
                continue
            if json[i] == open:
                depth = depth + 1
            elif json[i] == close:
                depth = depth - 1
            i = i + 1
        if depth == 0:
            return i
        return -1
    var i = start
    while i < json.len && json[i] != ',' && json[i] != '}' && json[i] != ']' && json[i] != ' ' && json[i] != '\t' && json[i] != '\n' && json[i] != '\r':
        i = i + 1
    return i

fn modelFindJsonRaw(json: str, key: str): str =
    let start = modelFindKeyValueStart(json, key)
    let end = modelFindJsonRawEnd(json, start)
    if start < 0 || end < start:
        return ""
    return modelSliceBytes(json, start, end - start)

fn modelExtractHttpBody(response: str, outError: var str): str =
    outError = ""
    if response == "":
        outError = "empty HTTP response"
        return ""
    if modelStartsWith(response, "{\"error\":"):
        outError = modelFindJsonString(response, "error")
        if outError == "":
            outError = "unknown transport error"
        return ""
    var status: int32 = 200
    let statusText = modelFindJsonRaw(response, "status")
    if statusText != "":
        status = modelParseInt(statusText)
    let body = modelFindJsonString(response, "body")
    if body == "":
        outError = "missing body in HTTP response"
        return ""
    if status != 200:
        outError = modelFindJsonString(body, "message")
        if outError == "":
            outError = modelConcat("HTTP status ", modelInt32ToDecStr(status))
        return ""
    return body

fn modelPostJsonAndExtractBody(url: str, body: str, headers: str, outError: var str): str =
    let raw = modelHttpPost(url, body, headers)
    if raw == "":
        outError = "HTTP provider returned empty response"
        return ""
    return modelExtractHttpBody(raw, outError)

fn modelBearerHeaders(apiKey: str): str =
    return modelCat3("[\"Content-Type: application/json\",\"Authorization: Bearer ", apiKey, "\"]")

fn modelBoundaryStr(raw: cstring): str =
    var out: str
    if ptr(raw) == nil:
        return out
    let count: int32 = int32(modelClibStrlen(ptr(raw)))
    if count <= 0:
        return out
    out.data = ptr(raw)
    out.len = count
    return out

fn RustCsgModelEmbeddingInternal(model: str, input: str, apiKey: str, apiUrl: str): str =
    if model == "" || input == "" || apiKey == "":
        return modelErrorJson("missing required arguments")
    var url = apiUrl
    if url == "":
        url = "https://api.openai.com/v1/embeddings"
    let body = modelCat3("{\"model\":", modelJsonQuote(model), modelCat3(",\"input\":", modelJsonQuote(input), "}"))
    let headers = modelBearerHeaders(apiKey)
    var errorText: str
    let responseBody = modelPostJsonAndExtractBody(url, body, headers, errorText)
    if responseBody == "":
        if errorText == "":
            errorText = "API call failed"
        return modelErrorJson(errorText)
    let dataArray = modelFindJsonRaw(responseBody, "data")
    var embedding: str
    if dataArray != "":
        embedding = modelFindJsonRaw(dataArray, "embedding")
    if embedding == "":
        return modelErrorJson("no embedding found in response")
    return embedding

fn RustCsgModelImageGenerateInternal(model: str, prompt: str, apiKey: str, apiUrl: str): str =
    if model == "" || prompt == "" || apiKey == "":
        return modelErrorJson("missing required arguments")
    var url = apiUrl
    if url == "":
        url = "https://api.openai.com/v1/images/generations"
    var body = modelCat3("{\"model\":", modelJsonQuote(model), modelCat3(",\"prompt\":", modelJsonQuote(prompt), ""))
    body = modelConcat(body, ",\"n\":1,\"size\":\"1024x1024\"}")
    let headers = modelBearerHeaders(apiKey)
    var errorText: str
    let responseBody = modelPostJsonAndExtractBody(url, body, headers, errorText)
    if responseBody == "":
        if errorText == "":
            errorText = "API call failed"
        return modelErrorJson(errorText)
    let dataArray = modelFindJsonRaw(responseBody, "data")
    var urlValue: str
    var b64Value: str
    if dataArray != "":
        urlValue = modelFindJsonString(dataArray, "url")
        b64Value = modelFindJsonString(dataArray, "b64_json")
    if urlValue == "" && b64Value == "":
        return modelErrorJson("no image data found in response")
    var out: str = "{"
    var hasField: bool
    if urlValue != "":
        out = modelConcat(out, modelCat3("\"url\":", modelJsonQuote(urlValue), ""))
        hasField = true
    if b64Value != "":
        if hasField:
            out = modelConcat(out, ",")
        out = modelConcat(out, modelCat3("\"b64_json\":", modelJsonQuote(b64Value), ""))
    out = modelConcat(out, "}")
    return out

@exportc("RustCsgModelEmbedding")
fn RustCsgModelEmbeddingExport(model: cstring, input: cstring, apiKey: cstring, apiUrl: cstring): cstring =
    let modelText: str = modelBoundaryStr(model)
    let inputText: str = modelBoundaryStr(input)
    let apiKeyText: str = modelBoundaryStr(apiKey)
    let apiUrlText: str = modelBoundaryStr(apiUrl)
    let out: str = RustCsgModelEmbeddingInternal(modelText, inputText, apiKeyText, apiUrlText)
    return modelCString(out)

@exportc("RustCsgModelImageGenerate")
fn RustCsgModelImageGenerateExport(model: cstring, prompt: cstring, apiKey: cstring, apiUrl: cstring): cstring =
    let modelText: str = modelBoundaryStr(model)
    let promptText: str = modelBoundaryStr(prompt)
    let apiKeyText: str = modelBoundaryStr(apiKey)
    let apiUrlText: str = modelBoundaryStr(apiUrl)
    let out: str = RustCsgModelImageGenerateInternal(modelText, promptText, apiKeyText, apiUrlText)
    return modelCString(out)
