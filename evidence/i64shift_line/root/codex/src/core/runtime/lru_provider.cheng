import std/strings

const LruMaxCaches: int32 = 32
const LruMaxEntries: int32 = 64

var lruNextHandle: int32 = 1
var lruClock: int32
var lruState: str

fn lruInt(value: int32): str =
    return strings.Int64ToStr(int64(value))

fn lruParseIntField(text: str, pos: var int32, delimiter: char): int32 =
    var sign: int32 = 1
    if pos < text.len && text[pos] == '-':
        sign = -1
        pos = pos + 1
    var value: int32
    while pos < text.len && text[pos] != delimiter:
        let digit = int32(text[pos]) - int32('0')
        if digit >= 0 && digit <= 9:
            value = value * 10 + digit
        pos = pos + 1
    if pos < text.len && text[pos] == delimiter:
        pos = pos + 1
    return value * sign

fn lruLoad(
    cacheHandles: var int32[], cacheCaps: var int32[], cacheHits: var int32[],
    cacheMisses: var int32[], cacheEvictions: var int32[],
    entryHandles: var int32[], entryAccess: var int32[], entryKeys: var str[], entryValues: var str[]
) =
    var pos: int32
    while pos < lruState.len:
        let kind = lruState[pos]
        pos = pos + 1
        if pos < lruState.len && lruState[pos] == '|':
            pos = pos + 1
        if kind == 'C':
            add(cacheHandles, lruParseIntField(lruState, pos, '|'))
            add(cacheCaps, lruParseIntField(lruState, pos, '|'))
            add(cacheHits, lruParseIntField(lruState, pos, '|'))
            add(cacheMisses, lruParseIntField(lruState, pos, '|'))
            add(cacheEvictions, lruParseIntField(lruState, pos, '\n'))
        elif kind == 'E':
            let handle = lruParseIntField(lruState, pos, '|')
            let access = lruParseIntField(lruState, pos, '|')
            let keyLen = lruParseIntField(lruState, pos, '|')
            let valueLen = lruParseIntField(lruState, pos, '|')
            let key = strings.SliceBytes(lruState, pos, keyLen)
            pos = pos + keyLen
            let value = strings.SliceBytes(lruState, pos, valueLen)
            pos = pos + valueLen
            if pos < lruState.len && lruState[pos] == '\n':
                pos = pos + 1
            add(entryHandles, handle)
            add(entryAccess, access)
            add(entryKeys, key)
            add(entryValues, value)
        else:
            while pos < lruState.len && lruState[pos] != '\n':
                pos = pos + 1
            if pos < lruState.len:
                pos = pos + 1

fn lruBuild(
    cacheHandles: int32[], cacheCaps: int32[], cacheHits: int32[],
    cacheMisses: int32[], cacheEvictions: int32[],
    entryHandles: int32[], entryAccess: int32[], entryKeys: str[], entryValues: str[]
) =
    var out: str
    for i in 0..<cacheHandles.len:
        if cacheCaps[i] > 0:
            out = strings.ConcatStr(out, "C|")
            out = strings.ConcatStr(out, lruInt(cacheHandles[i]))
            out = strings.ConcatStr(out, "|")
            out = strings.ConcatStr(out, lruInt(cacheCaps[i]))
            out = strings.ConcatStr(out, "|")
            out = strings.ConcatStr(out, lruInt(cacheHits[i]))
            out = strings.ConcatStr(out, "|")
            out = strings.ConcatStr(out, lruInt(cacheMisses[i]))
            out = strings.ConcatStr(out, "|")
            out = strings.ConcatStr(out, lruInt(cacheEvictions[i]))
            out = strings.ConcatStr(out, "\n")
    for i in 0..<entryHandles.len:
        if entryHandles[i] > 0:
            out = strings.ConcatStr(out, "E|")
            out = strings.ConcatStr(out, lruInt(entryHandles[i]))
            out = strings.ConcatStr(out, "|")
            out = strings.ConcatStr(out, lruInt(entryAccess[i]))
            out = strings.ConcatStr(out, "|")
            out = strings.ConcatStr(out, lruInt(entryKeys[i].len))
            out = strings.ConcatStr(out, "|")
            out = strings.ConcatStr(out, lruInt(entryValues[i].len))
            out = strings.ConcatStr(out, "|")
            out = strings.ConcatStr(out, entryKeys[i])
            out = strings.ConcatStr(out, entryValues[i])
            out = strings.ConcatStr(out, "\n")
    lruState = out

fn lruFindCache(cacheHandles: int32[], handle: int32): int32 =
    for i in 0..<cacheHandles.len:
        if cacheHandles[i] == handle:
            return i
    return -1

fn lruFindEntry(entryHandles: int32[], entryKeys: str[], handle: int32, key: str): int32 =
    for i in 0..<entryHandles.len:
        if entryHandles[i] == handle && entryKeys[i] == key:
            return i
    return -1

fn lruEntryCount(entryHandles: int32[], handle: int32): int32 =
    var count: int32
    for i in 0..<entryHandles.len:
        if entryHandles[i] == handle:
            count = count + 1
    return count

fn lruFindLruEntry(entryHandles: int32[], entryAccess: int32[], handle: int32): int32 =
    var out: int32 = -1
    var minAccess: int32 = 2147483647
    for i in 0..<entryHandles.len:
        if entryHandles[i] == handle && entryAccess[i] < minAccess:
            minAccess = entryAccess[i]
            out = i
    return out

fn lruNextAccess(): int32 =
    lruClock = lruClock + 1
    return lruClock

@exportc("RustCsgLruNew")
fn RustCsgLruNewExport(capacity: int32): int32 =
    if capacity <= 0 || capacity > LruMaxEntries:
        return 0
    var cacheHandles: int32[]
    var cacheCaps: int32[]
    var cacheHits: int32[]
    var cacheMisses: int32[]
    var cacheEvictions: int32[]
    var entryHandles: int32[]
    var entryAccess: int32[]
    var entryKeys: str[]
    var entryValues: str[]
    lruLoad(cacheHandles, cacheCaps, cacheHits, cacheMisses, cacheEvictions, entryHandles, entryAccess, entryKeys, entryValues)
    if cacheHandles.len >= LruMaxCaches:
        return 0
    lruNextHandle = lruNextHandle + 1
    let handle: int32 = lruNextHandle - 1
    add(cacheHandles, handle)
    add(cacheCaps, capacity)
    add(cacheHits, 0)
    add(cacheMisses, 0)
    add(cacheEvictions, 0)
    lruBuild(cacheHandles, cacheCaps, cacheHits, cacheMisses, cacheEvictions, entryHandles, entryAccess, entryKeys, entryValues)
    return handle

@abi_internal
@exportc("RustCsgLruPut")
fn RustCsgLruPutExport(handle: int32, key: str, value: str, outEvictedKey: var str, outOk: var bool) =
    outEvictedKey = ""
    outOk = false
    var cacheHandles: int32[]
    var cacheCaps: int32[]
    var cacheHits: int32[]
    var cacheMisses: int32[]
    var cacheEvictions: int32[]
    var entryHandles: int32[]
    var entryAccess: int32[]
    var entryKeys: str[]
    var entryValues: str[]
    lruLoad(cacheHandles, cacheCaps, cacheHits, cacheMisses, cacheEvictions, entryHandles, entryAccess, entryKeys, entryValues)
    let cacheIdx = lruFindCache(cacheHandles, handle)
    if cacheIdx < 0:
        return
    let existing = lruFindEntry(entryHandles, entryKeys, handle, key)
    if existing >= 0:
        entryValues[existing] = value
        entryAccess[existing] = lruNextAccess()
        lruBuild(cacheHandles, cacheCaps, cacheHits, cacheMisses, cacheEvictions, entryHandles, entryAccess, entryKeys, entryValues)
        outOk = true
        return
    if lruEntryCount(entryHandles, handle) >= cacheCaps[cacheIdx]:
        let victim = lruFindLruEntry(entryHandles, entryAccess, handle)
        if victim < 0:
            return
        outEvictedKey = entryKeys[victim]
        entryHandles[victim] = -1
        cacheEvictions[cacheIdx] = cacheEvictions[cacheIdx] + 1
    add(entryHandles, handle)
    add(entryAccess, lruNextAccess())
    add(entryKeys, key)
    add(entryValues, value)
    lruBuild(cacheHandles, cacheCaps, cacheHits, cacheMisses, cacheEvictions, entryHandles, entryAccess, entryKeys, entryValues)
    outOk = true

@abi_internal
@exportc("RustCsgLruGet")
fn RustCsgLruGetExport(handle: int32, key: str, outValue: var str, outOk: var bool) =
    outValue = ""
    outOk = false
    var cacheHandles: int32[]
    var cacheCaps: int32[]
    var cacheHits: int32[]
    var cacheMisses: int32[]
    var cacheEvictions: int32[]
    var entryHandles: int32[]
    var entryAccess: int32[]
    var entryKeys: str[]
    var entryValues: str[]
    lruLoad(cacheHandles, cacheCaps, cacheHits, cacheMisses, cacheEvictions, entryHandles, entryAccess, entryKeys, entryValues)
    let cacheIdx = lruFindCache(cacheHandles, handle)
    if cacheIdx < 0:
        return
    let entryIdx = lruFindEntry(entryHandles, entryKeys, handle, key)
    if entryIdx < 0:
        cacheMisses[cacheIdx] = cacheMisses[cacheIdx] + 1
        lruBuild(cacheHandles, cacheCaps, cacheHits, cacheMisses, cacheEvictions, entryHandles, entryAccess, entryKeys, entryValues)
        return
    cacheHits[cacheIdx] = cacheHits[cacheIdx] + 1
    entryAccess[entryIdx] = lruNextAccess()
    outValue = entryValues[entryIdx]
    lruBuild(cacheHandles, cacheCaps, cacheHits, cacheMisses, cacheEvictions, entryHandles, entryAccess, entryKeys, entryValues)
    outOk = true

@abi_internal
@exportc("RustCsgLruRemove")
fn RustCsgLruRemoveExport(handle: int32, key: str, outOk: var bool) =
    outOk = false
    var cacheHandles: int32[]
    var cacheCaps: int32[]
    var cacheHits: int32[]
    var cacheMisses: int32[]
    var cacheEvictions: int32[]
    var entryHandles: int32[]
    var entryAccess: int32[]
    var entryKeys: str[]
    var entryValues: str[]
    lruLoad(cacheHandles, cacheCaps, cacheHits, cacheMisses, cacheEvictions, entryHandles, entryAccess, entryKeys, entryValues)
    let entryIdx = lruFindEntry(entryHandles, entryKeys, handle, key)
    if entryIdx < 0:
        return
    entryHandles[entryIdx] = -1
    lruBuild(cacheHandles, cacheCaps, cacheHits, cacheMisses, cacheEvictions, entryHandles, entryAccess, entryKeys, entryValues)
    outOk = true

@exportc("RustCsgLruClear")
fn RustCsgLruClearExport(handle: int32) =
    var cacheHandles: int32[]
    var cacheCaps: int32[]
    var cacheHits: int32[]
    var cacheMisses: int32[]
    var cacheEvictions: int32[]
    var entryHandles: int32[]
    var entryAccess: int32[]
    var entryKeys: str[]
    var entryValues: str[]
    lruLoad(cacheHandles, cacheCaps, cacheHits, cacheMisses, cacheEvictions, entryHandles, entryAccess, entryKeys, entryValues)
    for i in 0..<entryHandles.len:
        if entryHandles[i] == handle:
            entryHandles[i] = -1
    lruBuild(cacheHandles, cacheCaps, cacheHits, cacheMisses, cacheEvictions, entryHandles, entryAccess, entryKeys, entryValues)

@exportc("RustCsgLruStats")
fn RustCsgLruStatsExport(handle: int32, outHits: var int32, outMisses: var int32, outEvictions: var int32) =
    outHits = 0
    outMisses = 0
    outEvictions = 0
    var cacheHandles: int32[]
    var cacheCaps: int32[]
    var cacheHits: int32[]
    var cacheMisses: int32[]
    var cacheEvictions: int32[]
    var entryHandles: int32[]
    var entryAccess: int32[]
    var entryKeys: str[]
    var entryValues: str[]
    lruLoad(cacheHandles, cacheCaps, cacheHits, cacheMisses, cacheEvictions, entryHandles, entryAccess, entryKeys, entryValues)
    let cacheIdx = lruFindCache(cacheHandles, handle)
    if cacheIdx < 0:
        return
    outHits = cacheHits[cacheIdx]
    outMisses = cacheMisses[cacheIdx]
    outEvictions = cacheEvictions[cacheIdx]

@abi_internal
@exportc("RustCsgLruPeek")
fn RustCsgLruPeekExport(handle: int32, key: str, outValue: var str, outOk: var bool) =
    outValue = ""
    outOk = false
    var cacheHandles: int32[]
    var cacheCaps: int32[]
    var cacheHits: int32[]
    var cacheMisses: int32[]
    var cacheEvictions: int32[]
    var entryHandles: int32[]
    var entryAccess: int32[]
    var entryKeys: str[]
    var entryValues: str[]
    lruLoad(cacheHandles, cacheCaps, cacheHits, cacheMisses, cacheEvictions, entryHandles, entryAccess, entryKeys, entryValues)
    let entryIdx = lruFindEntry(entryHandles, entryKeys, handle, key)
    if entryIdx < 0:
        return
    outValue = entryValues[entryIdx]
    outOk = true

@exportc("RustCsgLruResize")
fn RustCsgLruResizeExport(handle: int32, newCapacity: int32, outEvictedCount: var int32) =
    outEvictedCount = 0
    if newCapacity <= 0 || newCapacity > LruMaxEntries:
        return
    var cacheHandles: int32[]
    var cacheCaps: int32[]
    var cacheHits: int32[]
    var cacheMisses: int32[]
    var cacheEvictions: int32[]
    var entryHandles: int32[]
    var entryAccess: int32[]
    var entryKeys: str[]
    var entryValues: str[]
    lruLoad(cacheHandles, cacheCaps, cacheHits, cacheMisses, cacheEvictions, entryHandles, entryAccess, entryKeys, entryValues)
    let cacheIdx = lruFindCache(cacheHandles, handle)
    if cacheIdx < 0:
        return
    while lruEntryCount(entryHandles, handle) > newCapacity:
        let victim = lruFindLruEntry(entryHandles, entryAccess, handle)
        if victim < 0:
            break
        entryHandles[victim] = -1
        cacheEvictions[cacheIdx] = cacheEvictions[cacheIdx] + 1
        outEvictedCount = outEvictedCount + 1
    cacheCaps[cacheIdx] = newCapacity
    lruBuild(cacheHandles, cacheCaps, cacheHits, cacheMisses, cacheEvictions, entryHandles, entryAccess, entryKeys, entryValues)

@abi_internal
@exportc("RustCsgLruContains")
fn RustCsgLruContainsExport(handle: int32, key: str): bool =
    var cacheHandles: int32[]
    var cacheCaps: int32[]
    var cacheHits: int32[]
    var cacheMisses: int32[]
    var cacheEvictions: int32[]
    var entryHandles: int32[]
    var entryAccess: int32[]
    var entryKeys: str[]
    var entryValues: str[]
    lruLoad(cacheHandles, cacheCaps, cacheHits, cacheMisses, cacheEvictions, entryHandles, entryAccess, entryKeys, entryValues)
    return lruFindEntry(entryHandles, entryKeys, handle, key) >= 0

@exportc("RustCsgLruCapacity")
fn RustCsgLruCapacityExport(handle: int32): int32 =
    var cacheHandles: int32[]
    var cacheCaps: int32[]
    var cacheHits: int32[]
    var cacheMisses: int32[]
    var cacheEvictions: int32[]
    var entryHandles: int32[]
    var entryAccess: int32[]
    var entryKeys: str[]
    var entryValues: str[]
    lruLoad(cacheHandles, cacheCaps, cacheHits, cacheMisses, cacheEvictions, entryHandles, entryAccess, entryKeys, entryValues)
    let cacheIdx = lruFindCache(cacheHandles, handle)
    if cacheIdx < 0:
        return 0
    return cacheCaps[cacheIdx]

@abi_internal
@exportc("RustCsgLruKeys")
fn RustCsgLruKeysExport(handle: int32): str =
    var cacheHandles: int32[]
    var cacheCaps: int32[]
    var cacheHits: int32[]
    var cacheMisses: int32[]
    var cacheEvictions: int32[]
    var entryHandles: int32[]
    var entryAccess: int32[]
    var entryKeys: str[]
    var entryValues: str[]
    lruLoad(cacheHandles, cacheCaps, cacheHits, cacheMisses, cacheEvictions, entryHandles, entryAccess, entryKeys, entryValues)
    return lruOrdered(entryHandles, entryAccess, entryKeys, handle)

fn lruOrdered(entryHandles: int32[], entryAccess: int32[], values: str[], handle: int32): str =
    var used: int32[]
    for i in 0..<entryHandles.len:
        add(used, 0)
    var out: str
    var emitted: int32
    let count = lruEntryCount(entryHandles, handle)
    while emitted < count:
        var best: int32 = -1
        var bestAccess: int32 = -1
        for i in 0..<entryHandles.len:
            if entryHandles[i] == handle && used[i] == 0 && entryAccess[i] > bestAccess:
                best = i
                bestAccess = entryAccess[i]
        if best < 0:
            break
        used[best] = 1
        if emitted > 0:
            out = strings.ConcatStr(out, "\n")
        out = strings.ConcatStr(out, values[best])
        emitted = emitted + 1
    return out

@abi_internal
@exportc("RustCsgLruValues")
fn RustCsgLruValuesExport(handle: int32): str =
    var cacheHandles: int32[]
    var cacheCaps: int32[]
    var cacheHits: int32[]
    var cacheMisses: int32[]
    var cacheEvictions: int32[]
    var entryHandles: int32[]
    var entryAccess: int32[]
    var entryKeys: str[]
    var entryValues: str[]
    lruLoad(cacheHandles, cacheCaps, cacheHits, cacheMisses, cacheEvictions, entryHandles, entryAccess, entryKeys, entryValues)
    return lruOrdered(entryHandles, entryAccess, entryValues, handle)
