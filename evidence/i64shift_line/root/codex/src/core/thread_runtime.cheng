import std/strings
import cheng/codex/protocol/wire

var CoreThreadPendingThreadIds: str[]
var CoreThreadPendingOpTypes: str[]
var CoreThreadPendingApprovalIds: str[]
var CoreThreadPendingTurnIds: str[]
var CoreThreadClosedPendingIndices: int32[]
var CoreThreadClosedPendingReasons: str[]
var CoreThreadResolvedThreadIds: str[]
var CoreThreadResolvedOpTypes: str[]
var CoreThreadResolvedApprovalIds: str[]
var CoreThreadResolvedTurnIds: str[]
var CoreThreadResolvedOps: str[]
var CoreThreadSubmissionIds: str[]
var CoreThreadSubmissionThreadIds: str[]
var CoreThreadSubmissionOps: str[]
var CoreThreadSubmissionTraceparents: str[]
var CoreThreadSubmissionTracestates: str[]
var CoreThreadNextDispatchIndex: int32
var CoreThreadInterruptThreadIds: str[]
var CoreThreadInterruptOpTypes: str[]
var CoreThreadInterruptApprovalIds: str[]
var CoreThreadInterruptTurnIds: str[]
var CoreThreadMissingNotifyThreadIds: str[]
var CoreThreadMissingNotifyOpTypes: str[]
var CoreThreadMissingNotifyApprovalIds: str[]
var CoreThreadMissingNotifyTurnIds: str[]
var CoreThreadMissingNotifyOps: str[]

fn RustCsgCoreThreadRuntimeReset() =
    CoreThreadPendingThreadIds = []
    CoreThreadPendingOpTypes = []
    CoreThreadPendingApprovalIds = []
    CoreThreadPendingTurnIds = []
    CoreThreadClosedPendingIndices = []
    CoreThreadClosedPendingReasons = []
    CoreThreadResolvedThreadIds = []
    CoreThreadResolvedOpTypes = []
    CoreThreadResolvedApprovalIds = []
    CoreThreadResolvedTurnIds = []
    CoreThreadResolvedOps = []
    CoreThreadSubmissionIds = []
    CoreThreadSubmissionThreadIds = []
    CoreThreadSubmissionOps = []
    CoreThreadSubmissionTraceparents = []
    CoreThreadSubmissionTracestates = []
    CoreThreadNextDispatchIndex = 0
    CoreThreadInterruptThreadIds = []
    CoreThreadInterruptOpTypes = []
    CoreThreadInterruptApprovalIds = []
    CoreThreadInterruptTurnIds = []
    CoreThreadMissingNotifyThreadIds = []
    CoreThreadMissingNotifyOpTypes = []
    CoreThreadMissingNotifyApprovalIds = []
    CoreThreadMissingNotifyTurnIds = []
    CoreThreadMissingNotifyOps = []

fn coreThreadSubmissionId(index: int32): str =
    return wire.RustCsgCat("submission-", strings.Int64ToStr(int64(index)))

fn coreThreadPendingMatches(index: int32,
                            threadId: str,
                            opType: str,
                            approvalId: str,
                            turnId: str): bool =
    if CoreThreadPendingThreadIds[index] != threadId:
        return false
    if CoreThreadPendingOpTypes[index] != opType:
        return false
    if CoreThreadPendingApprovalIds[index] != approvalId:
        return false
    if opType == "exec_approval":
        return CoreThreadPendingTurnIds[index] == turnId
    return true

fn coreThreadPendingKeyMatches(index: int32, threadId: str, approvalId: str): bool =
    if CoreThreadPendingThreadIds[index] != threadId:
        return false
    return CoreThreadPendingApprovalIds[index] == approvalId

fn coreThreadPendingIndex(threadId: str,
                          opType: str,
                          approvalId: str,
                          turnId: str): int32 =
    var i = CoreThreadPendingThreadIds.len - 1
    while i >= 0:
        if coreThreadPendingMatches(i, threadId, opType, approvalId, turnId):
            return i
        i = i - 1
    return -1

fn coreThreadPendingClosed(index: int32): bool =
    var i = CoreThreadClosedPendingIndices.len - 1
    while i >= 0:
        if CoreThreadClosedPendingIndices[i] == index:
            return true
        i = i - 1
    return false

fn coreThreadClosePending(index: int32, reason: str) =
    if index < 0:
        return
    if coreThreadPendingClosed(index):
        return
    add(CoreThreadClosedPendingIndices, index)
    add(CoreThreadClosedPendingReasons, reason)

fn coreThreadActivePendingIndex(threadId: str,
                                opType: str,
                                approvalId: str,
                                turnId: str): int32 =
    var i = CoreThreadPendingThreadIds.len - 1
    while i >= 0:
        if !coreThreadPendingClosed(i) &&
           coreThreadPendingKeyMatches(i, threadId, approvalId):
            return i
        i = i - 1
    return -1

fn coreThreadCloseAllPendingForThread(threadId: str, reason: str) =
    var i: int32
    while i < CoreThreadPendingThreadIds.len:
        if !coreThreadPendingClosed(i) && CoreThreadPendingThreadIds[i] == threadId:
            coreThreadClosePending(i, reason)
        i = i + 1

fn coreThreadClosedReceiverDecision(index: int32, reason: str): str =
    if reason == "overwritten":
        if CoreThreadPendingOpTypes[index] == "patch_approval":
            return "denied"
        return "abort"
    if reason == "interrupt":
        return "abort"
    if reason == "resolved":
        return "notified"
    return ""

fn coreThreadResolvedIndex(threadId: str,
                           opType: str,
                           approvalId: str,
                           turnId: str): int32 =
    var i = CoreThreadResolvedThreadIds.len - 1
    while i >= 0:
        if CoreThreadResolvedThreadIds[i] == threadId &&
           CoreThreadResolvedOpTypes[i] == opType &&
           CoreThreadResolvedApprovalIds[i] == approvalId:
            if opType != "exec_approval" || CoreThreadResolvedTurnIds[i] == turnId:
                return i
        i = i - 1
    return -1

fn RustCsgCoreThreadRegisterPendingApproval(threadId: str,
                                            opType: str,
                                            approvalId: str,
                                            turnId: str,
                                            outError: var str): bool =
    outError = ""
    if threadId == "":
        outError = "core pending approval missing thread id"
        return false
    if approvalId == "":
        outError = "core pending approval missing approval id"
        return false
    if opType != "exec_approval" && opType != "patch_approval":
        outError = wire.RustCsgCat("unsupported core approval op type: ", opType)
        return false
    if opType == "exec_approval" && turnId == "":
        outError = "core exec approval pending waiter missing turn id"
        return false
    let existing = coreThreadActivePendingIndex(threadId, opType, approvalId, turnId)
    if existing >= 0:
        coreThreadClosePending(existing, "overwritten")
    add(CoreThreadPendingThreadIds, threadId)
    add(CoreThreadPendingOpTypes, opType)
    add(CoreThreadPendingApprovalIds, approvalId)
    add(CoreThreadPendingTurnIds, turnId)
    return true

fn coreThreadApprovalOpFields(opJson: str,
                              outOpType: var str,
                              outApprovalId: var str,
                              outTurnId: var str,
                              outDecisionRaw: var str,
                              outError: var str): bool =
    outOpType = wire.RustCsgJsonFindOptionalStr(opJson, "type")
    outApprovalId = wire.RustCsgJsonFindOptionalStr(opJson, "id")
    outTurnId = wire.RustCsgJsonFindOptionalStr(opJson, "turn_id")
    outDecisionRaw = wire.RustCsgJsonFindOptionalValueRaw(opJson, "decision")
    outError = ""
    if outOpType != "exec_approval" && outOpType != "patch_approval":
        outError = wire.RustCsgCat("unsupported core approval submit op type: ", outOpType)
        return false
    if outApprovalId == "":
        outError = "core approval submit op missing id"
        return false
    if outOpType == "exec_approval" && outTurnId == "":
        outError = "core exec approval submit op missing turn id"
        return false
    if outDecisionRaw == "":
        outError = "core approval submit op missing decision"
        return false
    return true

fn RustCsgCoreThreadSubmitApprovalOpWithTrace(threadId: str,
                                              submissionId: str,
                                              traceparent: str,
                                              tracestate: str,
                                              opJson: str,
                                              outError: var str): bool =
    outError = ""
    if threadId == "":
        outError = "core approval submit missing thread id"
        return false
    if submissionId == "":
        outError = "core approval submit missing submission id"
        return false
    var opType: str
    var approvalId: str
    var turnId: str
    var decisionRaw: str
    if !coreThreadApprovalOpFields(opJson, opType, approvalId, turnId, decisionRaw, outError):
        return false
    add(CoreThreadSubmissionIds, submissionId)
    add(CoreThreadSubmissionThreadIds, threadId)
    add(CoreThreadSubmissionOps, opJson)
    add(CoreThreadSubmissionTraceparents, traceparent)
    add(CoreThreadSubmissionTracestates, tracestate)
    return true

fn RustCsgCoreThreadSubmitApprovalOp(threadId: str,
                                     opJson: str,
                                     outError: var str): bool =
    let nextId = coreThreadSubmissionId(CoreThreadSubmissionIds.len)
    return RustCsgCoreThreadSubmitApprovalOpWithTrace(threadId, nextId, "", "", opJson, outError)

fn coreThreadResolveSubmission(threadId: str,
                               opType: str,
                               approvalId: str,
                               turnId: str,
                               opJson: str,
                               outError: var str): bool =
    outError = ""
    let pendingIndex = coreThreadActivePendingIndex(threadId, opType, approvalId, turnId)
    if pendingIndex < 0:
        add(CoreThreadMissingNotifyThreadIds, threadId)
        add(CoreThreadMissingNotifyOpTypes, opType)
        add(CoreThreadMissingNotifyApprovalIds, approvalId)
        add(CoreThreadMissingNotifyTurnIds, turnId)
        add(CoreThreadMissingNotifyOps, opJson)
        return true
    coreThreadClosePending(pendingIndex, "resolved")
    add(CoreThreadResolvedThreadIds, threadId)
    add(CoreThreadResolvedOpTypes, opType)
    add(CoreThreadResolvedApprovalIds, approvalId)
    add(CoreThreadResolvedTurnIds, turnId)
    add(CoreThreadResolvedOps, opJson)
    return true

fn coreThreadRecordInterrupt(threadId: str,
                             opType: str,
                             approvalId: str,
                             turnId: str) =
    coreThreadCloseAllPendingForThread(threadId, "interrupt")
    add(CoreThreadInterruptThreadIds, threadId)
    add(CoreThreadInterruptOpTypes, opType)
    add(CoreThreadInterruptApprovalIds, approvalId)
    add(CoreThreadInterruptTurnIds, turnId)

fn RustCsgCoreThreadSubmitInterruptOpWithTrace(threadId: str,
                                               submissionId: str,
                                               traceparent: str,
                                               tracestate: str,
                                               outError: var str): bool =
    outError = ""
    if threadId == "":
        outError = "core interrupt submit missing thread id"
        return false
    if submissionId == "":
        outError = "core interrupt submit missing submission id"
        return false
    add(CoreThreadSubmissionIds, submissionId)
    add(CoreThreadSubmissionThreadIds, threadId)
    add(CoreThreadSubmissionOps, "{\"type\":\"interrupt\"}")
    add(CoreThreadSubmissionTraceparents, traceparent)
    add(CoreThreadSubmissionTracestates, tracestate)
    return true

fn RustCsgCoreThreadSubmitInterruptOp(threadId: str,
                                      outError: var str): bool =
    let nextId = coreThreadSubmissionId(CoreThreadSubmissionIds.len)
    return RustCsgCoreThreadSubmitInterruptOpWithTrace(threadId, nextId, "", "", outError)

fn RustCsgCoreThreadDispatchNextSubmission(outDispatched: var bool,
                                           outError: var str): bool =
    outDispatched = false
    outError = ""
    if CoreThreadNextDispatchIndex >= CoreThreadSubmissionOps.len:
        return true
    let index = CoreThreadNextDispatchIndex
    let threadId = CoreThreadSubmissionThreadIds[index]
    let opJson = CoreThreadSubmissionOps[index]
    let submissionOpType = wire.RustCsgJsonFindOptionalStr(opJson, "type")
    if submissionOpType == "interrupt":
        coreThreadRecordInterrupt(threadId, "interrupt", "", "")
        CoreThreadNextDispatchIndex = CoreThreadNextDispatchIndex + 1
        outDispatched = true
        return true
    var opType: str
    var approvalId: str
    var turnId: str
    var decisionRaw: str
    if !coreThreadApprovalOpFields(opJson, opType, approvalId, turnId, decisionRaw, outError):
        return false
    if decisionRaw == "\"abort\"":
        coreThreadRecordInterrupt(threadId, opType, approvalId, turnId)
    elif !coreThreadResolveSubmission(threadId, opType, approvalId, turnId, opJson, outError):
        return false
    CoreThreadNextDispatchIndex = CoreThreadNextDispatchIndex + 1
    outDispatched = true
    return true

fn RustCsgCoreThreadDispatchAllSubmissions(outError: var str): bool =
    outError = ""
    while CoreThreadNextDispatchIndex < CoreThreadSubmissionOps.len:
        var dispatched: bool
        if !RustCsgCoreThreadDispatchNextSubmission(dispatched, outError):
            return false
        if !dispatched:
            return true
    return true

fn RustCsgCoreThreadSubmittedApprovalCount(): int32 =
    return CoreThreadSubmissionIds.len

fn RustCsgCoreThreadDispatchedSubmissionCount(): int32 =
    return CoreThreadNextDispatchIndex

fn RustCsgCoreThreadInterruptCount(): int32 =
    return CoreThreadInterruptThreadIds.len

fn RustCsgCoreThreadActivePendingApprovalCount(): int32 =
    var count: int32
    var i: int32
    while i < CoreThreadPendingThreadIds.len:
        if !coreThreadPendingClosed(i):
            count = count + 1
        i = i + 1
    return count

fn RustCsgCoreThreadOverwrittenPendingApprovalCount(): int32 =
    var count: int32
    var i: int32
    while i < CoreThreadClosedPendingReasons.len:
        if CoreThreadClosedPendingReasons[i] == "overwritten":
            count = count + 1
        i = i + 1
    return count

fn RustCsgCoreThreadMissingNotifyCount(): int32 =
    return CoreThreadMissingNotifyThreadIds.len

fn RustCsgCoreThreadLastClosedPendingJson(): str =
    if CoreThreadClosedPendingIndices.len == 0:
        return ""
    let closeIndex = CoreThreadClosedPendingIndices.len - 1
    let pendingIndex = CoreThreadClosedPendingIndices[closeIndex]
    let reason = CoreThreadClosedPendingReasons[closeIndex]
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("thread_id", CoreThreadPendingThreadIds[pendingIndex]))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("op_type", CoreThreadPendingOpTypes[pendingIndex]))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("approval_id", CoreThreadPendingApprovalIds[pendingIndex]))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("turn_id", CoreThreadPendingTurnIds[pendingIndex]))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("reason", reason))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("receiver_decision", coreThreadClosedReceiverDecision(pendingIndex, reason)))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgCoreThreadLastSubmittedApprovalOp(): str =
    if CoreThreadSubmissionOps.len == 0:
        return ""
    return CoreThreadSubmissionOps[CoreThreadSubmissionOps.len - 1]

fn RustCsgCoreThreadLastSubmissionJson(): str =
    if CoreThreadSubmissionOps.len == 0:
        return ""
    let index = CoreThreadSubmissionOps.len - 1
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("id", CoreThreadSubmissionIds[index]))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("op", CoreThreadSubmissionOps[index]))
    if CoreThreadSubmissionTraceparents[index] != "" || CoreThreadSubmissionTracestates[index] != "":
        out = wire.RustCsgCat(out, ",\"trace\":{")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("traceparent", CoreThreadSubmissionTraceparents[index]))
        out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldStr("tracestate", CoreThreadSubmissionTracestates[index]))
        out = wire.RustCsgCat(out, "}")
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgCoreThreadPendingApprovalResolvedOp(threadId: str,
                                              opType: str,
                                              approvalId: str,
                                              turnId: str): str =
    let index = coreThreadResolvedIndex(threadId, opType, approvalId, turnId)
    if index < 0:
        return ""
    return CoreThreadResolvedOps[index]

fn RustCsgCoreThreadLastInterruptJson(): str =
    if CoreThreadInterruptThreadIds.len == 0:
        return ""
    let index = CoreThreadInterruptThreadIds.len - 1
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("thread_id", CoreThreadInterruptThreadIds[index]))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("op_type", CoreThreadInterruptOpTypes[index]))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("approval_id", CoreThreadInterruptApprovalIds[index]))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("turn_id", CoreThreadInterruptTurnIds[index]))
    out = wire.RustCsgCat(out, "}")
    return out
