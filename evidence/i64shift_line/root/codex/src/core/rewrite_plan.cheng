import cheng/codex/core/inventory_static as inventory
import cheng/codex/core/module_map
import cheng/codex/protocol/types
import cheng/codex/protocol/wire

const
    RustCsgRewriteFactsHeader: str = "RUST_CSG_PROJECT_REWRITE"
    RustCsgRewriteFactsSchema: str = "project_rewrite"
    RustCsgRewriteNotReadyStatus: str = "project rewrite is not one-click equivalent yet"

fn RustCsgRewritePlanUnits(): types.RustCsgMigrationUnit[] =
    let members = inventory.RustCsgExpectedCargoMembersList()
    var units: types.RustCsgMigrationUnit[]
    for i in 0..<members.len:
        add(units, module_map.RustCsgCargoMemberUnit(members[i]))
    return units

fn RustCsgRewritePlanValidate(units: var types.RustCsgMigrationUnit[], outReason: var str): bool =
    outReason = ""
    if units.len != inventory.RustCsgExpectedCargoMembers:
        outReason = wire.RustCsgCat4(
            "rewrite_unit_count=",
            inventory.RustCsgInt32Text(int32(units.len)),
            " expected=",
            inventory.RustCsgInt32Text(inventory.RustCsgExpectedCargoMembers)
        )
        return false
    for i in 0..<units.len:
        var unit = units[i]
        if !module_map.RustCsgMigrationUnitOk(unit, outReason):
            outReason = wire.RustCsgCat4(
                "rewrite_unit[",
                inventory.RustCsgInt32Text(int32(i)),
                "] ",
                outReason
            )
            return false
    return true

fn RustCsgRewritePlanFirstBlocked(units: var types.RustCsgMigrationUnit[]): str =
    for i in 0..<units.len:
        if units[i].status == module_map.RustCsgExplicitlyBlocked:
            return wire.RustCsgCat3(
                units[i].sourcePath,
                ": ",
                units[i].reason
            )
    return ""

fn RustCsgRewritePlanOneClickReady(units: var types.RustCsgMigrationUnit[], outReason: var str): bool =
    if !RustCsgRewritePlanValidate(units, outReason):
        return false
    let firstBlocked = RustCsgRewritePlanFirstBlocked(units)
    if firstBlocked != "":
        outReason = wire.RustCsgCat3(RustCsgRewriteNotReadyStatus, ": ", firstBlocked)
        return false
    let firstCoreGap = RustCsgRewritePlanFirstCoreRelfactsGap(units)
    if firstCoreGap != "":
        let verifiedMembers = RustCsgRewritePlanRelfactsVerifiedCount(units)
        let expectedCoreModules = RustCsgRewritePlanExpectedRelfactsCoreMembers()
        outReason = wire.RustCsgCat4(
            "core modules not fully verified: ",
            inventory.RustCsgInt32Text(verifiedMembers),
            "/",
            inventory.RustCsgInt32Text(expectedCoreModules)
        )
        outReason = wire.RustCsgCat3(outReason, " first_gap=", firstCoreGap)
        return false
    outReason = ""
    return true

fn RustCsgRewritePlanExpectedTotalMembers(): int32 =
    return inventory.RustCsgExpectedCargoMembers

fn RustCsgRewritePlanExpectedStatusCount(status: str): int32 =
    let members = inventory.RustCsgExpectedCargoMembersList()
    var count: int32
    for i in 0..<members.len:
        let unit = module_map.RustCsgCargoMemberUnit(members[i])
        if unit.status == status:
            count = count + 1
    return count

fn RustCsgRewritePlanExpectedPortedMembers(): int32 =
    return RustCsgRewritePlanExpectedStatusCount("ported")

fn RustCsgRewritePlanExpectedBlockedMembers(): int32 =
    return RustCsgRewritePlanExpectedStatusCount(module_map.RustCsgExplicitlyBlocked)

fn RustCsgRewritePlanExpectedRelfactsCoreMembers(): int32 =
    let members = inventory.RustCsgExpectedCargoMembersList()
    var count: int32
    for i in 0..<members.len:
        if module_map.RustCsgCargoMemberInTranslationCore(members[i]):
            count = count + 1
    return count

fn RustCsgRewritePlanHasVerifiedCoreUnit(units: var types.RustCsgMigrationUnit[], memberName: str): bool =
    if !module_map.RustCsgCargoMemberTranslationCoreRelfactsVerified(memberName):
        return false
    for i in 0..<units.len:
        if units[i].sourcePath == memberName:
            return units[i].status == "ported"
    return false

fn RustCsgRewritePlanFirstCoreRelfactsGap(units: var types.RustCsgMigrationUnit[]): str =
    let members = inventory.RustCsgExpectedCargoMembersList()
    for i in 0..<members.len:
        if module_map.RustCsgCargoMemberInTranslationCore(members[i]) &&
           !RustCsgRewritePlanHasVerifiedCoreUnit(units, members[i]):
            return members[i]
    return ""

fn RustCsgRewritePlanStatusCount(units: var types.RustCsgMigrationUnit[], status: str): int32 =
    var count: int32
    for i in 0..<units.len:
        if units[i].status == status:
            count = count + 1
    return count

fn RustCsgRewritePlanRelfactsVerifiedCount(units: var types.RustCsgMigrationUnit[]): int32 =
    let members = inventory.RustCsgExpectedCargoMembersList()
    var count: int32
    for i in 0..<members.len:
        if RustCsgRewritePlanHasVerifiedCoreUnit(units, members[i]):
            count = count + 1
    return count

fn RustCsgRewritePlanUnitFact(index: int32, unit: var types.RustCsgMigrationUnit): str =
    var out = wire.RustCsgCat4("unit\t", inventory.RustCsgInt32Text(index), "\t", unit.sourcePath)
    out = wire.RustCsgCat4(out, "\t", unit.chengModule, "\t")
    out = wire.RustCsgCat4(out, unit.status, "\t", unit.reason)
    return out

fn RustCsgRewritePlanFacts(units: var types.RustCsgMigrationUnit[]): str =
    var out = wire.RustCsgCat4(RustCsgRewriteFactsHeader, "\nschema\t", RustCsgRewriteFactsSchema, "\nsource_root\t")
    out = wire.RustCsgCat(out, inventory.RustCsgSourceRoot)
    out = wire.RustCsgCat4(out, "\nunit_count\t", inventory.RustCsgInt32Text(int32(units.len)), "\nported_count\t")
    out = wire.RustCsgCat(out, inventory.RustCsgInt32Text(RustCsgRewritePlanStatusCount(units, "ported")))
    out = wire.RustCsgCat(out, "\nblocked_count\t")
    out = wire.RustCsgCat(out, inventory.RustCsgInt32Text(RustCsgRewritePlanStatusCount(units, module_map.RustCsgExplicitlyBlocked)))
    out = wire.RustCsgCat4(out, "\nverified_members\t", inventory.RustCsgInt32Text(RustCsgRewritePlanRelfactsVerifiedCount(units)), "\nverified_modules\t")
    out = wire.RustCsgCat(out, inventory.RustCsgInt32Text(RustCsgRewritePlanExpectedRelfactsCoreMembers()))
    for i in 0..<units.len:
        out = wire.RustCsgCat3(out, "\n", RustCsgRewritePlanUnitFact(int32(i), units[i]))
    return out
