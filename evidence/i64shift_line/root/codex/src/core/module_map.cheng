import cheng/codex/protocol/types
import cheng/codex/protocol/wire

const
    RustCsgCrateModulePrefix: str = "rust_csg/crates/"
    RustCsgExplicitlyBlocked: str = "explicitly_blocked"
    RustCsgBlockedUntilPorted: str = "source member is not ported to Cheng yet"

fn RustCsgNormalizeSourceName(sourceName: str): str =
    var out: str
    for i in 0..<sourceName.len:
        let ch = sourceName[i]
        if ch == '/' || ch == '-':
            out = wire.RustCsgCat(out, "_")
        else:
            out = wire.RustCsgCat(out, wire.RustCsgSliceBytes(sourceName, i, 1))
    return out

fn RustCsgCargoMemberModule(memberName: str): str =
    if memberName == "collaboration-mode-templates":
        return wire.RustCsgCat(RustCsgCrateModulePrefix, "collab_templates")
    if memberName == "codex-experimental-api-macros":
        return wire.RustCsgCat(RustCsgCrateModulePrefix, "experimental_api_macros")
    if memberName == "utils/approval-presets":
        return wire.RustCsgCat(RustCsgCrateModulePrefix, "approval_presets")
    if memberName == "utils/fuzzy-match":
        return wire.RustCsgCat(RustCsgCrateModulePrefix, "fuzzy_match")
    if memberName == "utils/output-truncation":
        return wire.RustCsgCat(RustCsgCrateModulePrefix, "output_truncation")
    if memberName == "utils/rustls-provider":
        return wire.RustCsgCat(RustCsgCrateModulePrefix, "rustls_provider")
    if memberName == "utils/stream-parser":
        return wire.RustCsgCat(RustCsgCrateModulePrefix, "stream_parser")
    if memberName == "utils/template":
        return wire.RustCsgCat(RustCsgCrateModulePrefix, "template")
    return wire.RustCsgCat(RustCsgCrateModulePrefix, RustCsgNormalizeSourceName(memberName))

