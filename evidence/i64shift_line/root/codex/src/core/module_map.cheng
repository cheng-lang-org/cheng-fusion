# 转译核心边界：离开这些模块 Codex 不可运行的执行链路 + 支撑层
# 核心内的 member 在 translate 层面必须达到 relfacts 验证级别
# 核心外的 member 只需 marker 级别（one_click_ready 分类层面 ported）
fn RustCsgCargoMemberInTranslationCore(memberName: str): bool =
    # -- CLI/入口 --
    if memberName == "cli":
        return true
    elif memberName == "arg0":
        return true
    # -- 执行引擎 --
    elif memberName == "exec":
        return true
    elif memberName == "exec-server":
        return true
    # -- 应用服务 --
    elif memberName == "app-server":
        return true
    elif memberName == "app-server-protocol":
        return true
    elif memberName == "app-server-client":
        return true
    elif memberName == "app-server-transport":
        return true
    elif memberName == "app_server_stream_parser":
        return true
    elif memberName == "app-server-test-client":
        return true
    # -- 协议 / 状态 / 配置 --
    elif memberName == "protocol":
        return true
    elif memberName == "config":
        return true
    elif memberName == "state":
        return true
    elif memberName == "thread-store":
        return true
    # -- 核心基础库 --
    elif memberName == "core":
        return true
    elif memberName == "core-api":
        return true
    elif memberName == "core-plugins":
        return true
    elif memberName == "core-skills":
        return true
    # -- 模型 / 后端 --
    elif memberName == "model-provider":
        return true
    elif memberName == "model-provider-info":
        return true
    elif memberName == "backend-client":
        return true
    elif memberName == "http_client":
        return true
    elif memberName == "codex-api":
        return true
    elif memberName == "codex-client":
        return true
    # -- MCP --
    elif memberName == "mcp-server":
        return true
    elif memberName == "codex-mcp":
        return true
    elif memberName == "rmcp-client":
        return true
    # -- TUI --
    elif memberName == "tui":
        return true
    elif memberName == "tui_terminal":
        return true
    # -- 部署 / 发布 --
    elif memberName == "rollout":
        return true
    elif memberName == "rollout-trace":
        return true
    # -- 工具（被核心链路深度依赖） --
    elif memberName == "apply-patch":
        return true
    elif memberName == "shell-command":
        return true
    elif memberName == "file-system":
        return true
    elif memberName == "stdio-to-uds":
        return true
    elif memberName == "uds":
        return true
    elif memberName == "utils/string":
        return true
    elif memberName == "utils/http":
        return true
    elif memberName == "utils/stream-parser":
        return true
    elif memberName == "utils/path-utils":
        return true
    elif memberName == "utils/home-dir":
        return true
    elif memberName == "utils/elapsed":
        return true
    elif memberName == "utils/absolute-path":
        return true
    elif memberName == "utils/plugins":
        return true
    elif memberName == "utils/template":
        return true
    # -- 登录 / 认证 --
    elif memberName == "login":
        return true
    elif memberName == "login_oauth":
        return true
    elif memberName == "agent-identity":
        return true
    return false

fn RustCsgCargoMemberTranslationCoreRelfactsVerified(memberName: str): bool =
    return RustCsgCargoMemberInTranslationCore(memberName) &&
           RustCsgCargoMemberRelfactsVerified(memberName)

fn RustCsgCargoMemberNonRuntime(memberName: str): bool =
    if memberName == "test-binary-support":
        return true
    elif memberName == "v8-poc":
        return true
    elif memberName == "ext/goal":
        return true
    elif memberName == "thread-manager-sample":
        return true
    elif memberName == "aws-auth":
        return true
    return false

fn RustCsgCargoMemberUnit(memberName: str): types.RustCsgMigrationUnit =
    var out: types.RustCsgMigrationUnit
    out.sourcePath = memberName
    out.chengModule = RustCsgCargoMemberModule(memberName)
    if RustCsgCargoMemberPorted(memberName):
        out.status = "ported"
        out.reason = ""
    elif RustCsgCargoMemberNonRuntime(memberName):
        out.status = "non-runtime asset"
        out.reason = ""
    else:
        out.status = RustCsgExplicitlyBlocked
        out.reason = RustCsgBlockedUntilPorted
    return out

fn RustCsgMigrationUnitOk(unit: var types.RustCsgMigrationUnit, outReason: var str): bool =
    outReason = ""
    if unit.sourcePath == "":
        outReason = "empty_source_path"
        return false
    if unit.chengModule == "":
        outReason = "empty_cheng_module"
        return false
    if unit.status != "ported" &&
       unit.status != "non-runtime asset" &&
       unit.status != RustCsgExplicitlyBlocked:
        outReason = wire.RustCsgCat("invalid_status=", unit.status)
        return false
    if unit.status == RustCsgExplicitlyBlocked && unit.reason == "":
        outReason = "blocked_unit_missing_reason"
        return false
    return true
