# Backend Client — HTTP transport layer for Codex backend API
#
# Ported from codex-rs/backend-client/src/client.rs
# Covers: Client, headers, request execution, URL building with PathStyle
#
# Uses std/http for HTTP transport.
# All requests are JSON. Responses are returned as HttpResult.
#
# NOTE: Avoids strutl.Join (not supported by cold compiler).
# Uses strings.ConcatStr instead.

import std/strings
import cheng/codex/std/http

# ── Constants ─────────────────────────────────────────────────────────────

const DefaultUserAgent: str = "codex-cli/1.0"
const DefaultBackendUrl: str = "https://chatgpt.com/backend-api/"
const ContentTypeJson: str = "application/json"

# ── Minimal string contains ──────────────────────────────────────────────
# strContains is available in strings module as StrContains

# ── PathStyle detection ──────────────────────────────────────────────────
# CodexApi:   {baseUrl}/api/codex/...
# ChatGptApi: {baseUrl}/wham/... (when base_url contains "/backend-api")

fn detectPathStyle(baseUrl: str): str =
    if strings.StrContains(baseUrl, "/backend-api"):
        return "ChatGptApi"
    return "CodexApi"

fn normalizeBaseUrl(baseUrl: str): str =
    var out: str = trimTrailingSlash(baseUrl)
    let isChatGptHost = rustCsgBackendClientStartsWith(out, "https://chatgpt.com") || rustCsgBackendClientStartsWith(out, "https://chat.openai.com")
    if isChatGptHost && !strings.StrContains(out, "/backend-api"):
        out = strings.ConcatStr(out, "/backend-api")
    return out

fn rustCsgBackendClientStartsWith(text: str, prefix: str): bool =
    if prefix.len > text.len:
        return false
    return strings.SliceBytes(text, 0, prefix.len) == prefix

fn trimTrailingSlash(s: str): str =
    var out: str = s
    while out.len > 0 && out[out.len - 1] == '/':
        out = strings.SliceBytes(out, 0, out.len - 1)
    return out

fn buildApiUrl(baseUrl: str, pathStyle: str, path: str): str =
    var trimmed: str = trimTrailingSlash(baseUrl)
    if pathStyle == "CodexApi":
        return strings.ConcatStr(strings.ConcatStr(trimmed, "/api/codex"), path)
    return strings.ConcatStr(strings.ConcatStr(trimmed, "/wham"), path)

# ── Headers ──────────────────────────────────────────────────────────────
# Build headers JSON string for HTTP requests.
# The HTTP provider consumes a JSON array of raw header lines.

fn buildRequestHeaders(authToken: str, userAgent: str): str =
    return buildRequestHeadersWithAccountId(authToken, userAgent, "")

fn buildRequestHeadersWithAccountId(authToken: str, userAgent: str, accountId: str): str =
    var out: str = "[\"Authorization: Bearer "
    out = strings.ConcatStr(out, authToken)
    out = strings.ConcatStr(out, "\",\"Content-Type: ")
    out = strings.ConcatStr(out, ContentTypeJson)
    out = strings.ConcatStr(out, "\",\"User-Agent: ")
    out = strings.ConcatStr(out, userAgent)
    if accountId != "":
        out = strings.ConcatStr(out, "\",\"ChatGPT-Account-Id: ")
        out = strings.ConcatStr(out, accountId)
    out = strings.ConcatStr(out, "\"]")
    return out

# ── Minimal JSON string field extraction ─────────────────────────────────
# Extracts a string value for a given key from a flat JSON object.
# JSON format: {"key1":"value1","key2":"value2"}
# Returns "" if key not found or value is not a string.

fn jsonExtractStr(json: str, key: str): str =
    if json.len == 0 || key.len == 0:
        return ""
    var pattern: str = strings.ConcatStr(strings.ConcatStr("\"", key), "\":")
    let n: int32 = json.len
    let plen: int32 = pattern.len
    var i: int32 = 0
    var found: bool = false
    while i <= n - plen && !found:
        if strings.SliceBytes(json, i, plen) == pattern:
            found = true
        else:
            i = i + 1
    if !found:
        return ""
    i = i + plen
    while i < n && (strings.SliceBytes(json, i, 1) == " " || strings.SliceBytes(json, i, 1) == "\t" || strings.SliceBytes(json, i, 1) == "\n" || strings.SliceBytes(json, i, 1) == "\r"):
        i = i + 1
    if i >= n || strings.SliceBytes(json, i, 1) != "\"":
        return ""
    i = i + 1
    var value: str = ""
    while i < n && strings.SliceBytes(json, i, 1) != "\"":
        if strings.SliceBytes(json, i, 1) == "\\":
            i = i + 1
            if i < n:
                value = strings.ConcatStr(value, strings.SliceBytes(json, i, 1))
                i = i + 1
        else:
            value = strings.ConcatStr(value, strings.SliceBytes(json, i, 1))
            i = i + 1
    return value

# ── BackendClient JSON state ─────────────────────────────────────────────
# Since Cheng does not support string-keyed structs, we represent the client
# as a JSON string:
# {"baseUrl":"...","authToken":"...","userAgent":"...","accountId":"...","pathStyle":"..."}

fn backendClientToJson(baseUrl: str, authToken: str, userAgent: str, accountId: str, pathStyle: str): str =
    var out: str = "{\"baseUrl\":\""
    out = strings.ConcatStr(out, baseUrl)
    out = strings.ConcatStr(out, "\",\"authToken\":\"")
    out = strings.ConcatStr(out, authToken)
    out = strings.ConcatStr(out, "\"")
    if userAgent != "":
        out = strings.ConcatStr(out, ",\"userAgent\":\"")
        out = strings.ConcatStr(out, userAgent)
        out = strings.ConcatStr(out, "\"")
    if accountId != "":
        out = strings.ConcatStr(out, ",\"accountId\":\"")
        out = strings.ConcatStr(out, accountId)
        out = strings.ConcatStr(out, "\"")
    out = strings.ConcatStr(out, ",\"pathStyle\":\"")
    out = strings.ConcatStr(out, pathStyle)
    out = strings.ConcatStr(out, "\"}")
    return out

# ── New backend client from explicit params ──────────────────────────────

fn BackendClientNew(baseUrl: str, authToken: str, userAgent: str): str =
    return BackendClientNewWithAccountId(baseUrl, authToken, userAgent, "")

fn BackendClientNewWithAccountId(baseUrl: str, authToken: str, userAgent: str, accountId: str): str =
    var url: str = baseUrl
    if url == "":
        url = DefaultBackendUrl
    url = normalizeBaseUrl(url)
    var ua: str = userAgent
    if ua == "":
        ua = DefaultUserAgent
    let style: str = detectPathStyle(url)
    return backendClientToJson(url, authToken, ua, accountId, style)

# ── New backend client from auth token ───────────────────────────────────

fn BackendClientFromAuth(baseUrl: str, authToken: str): str =
    var url: str = baseUrl
    if url == "":
        url = DefaultBackendUrl
    url = normalizeBaseUrl(url)
    var ua: str = DefaultUserAgent
    let style: str = detectPathStyle(url)
    return backendClientToJson(url, authToken, ua, "", style)

# ── Execute request — POST with JSON body ────────────────────────────────

fn BackendClientPost(clientJson: str, path: str, body: str): http.HttpResult =
    let baseUrl: str = jsonExtractStr(clientJson, "baseUrl")
    let authToken: str = jsonExtractStr(clientJson, "authToken")
    let userAgent: str = jsonExtractStr(clientJson, "userAgent")
    let accountId: str = jsonExtractStr(clientJson, "accountId")
    let pathStyle: str = jsonExtractStr(clientJson, "pathStyle")

    if baseUrl == "":
        var errResult: http.HttpResult
        errResult.error = "BackendClient: baseUrl is empty"
        return errResult

    let url: str = buildApiUrl(baseUrl, pathStyle, path)
    let headers: str = buildRequestHeadersWithAccountId(authToken, userAgent, accountId)
    return http.HttpPost(url, body, headers)

# ── Execute request — GET ────────────────────────────────────────────────

fn BackendClientGet(clientJson: str, path: str): http.HttpResult =
    let baseUrl: str = jsonExtractStr(clientJson, "baseUrl")
    let authToken: str = jsonExtractStr(clientJson, "authToken")
    let userAgent: str = jsonExtractStr(clientJson, "userAgent")
    let accountId: str = jsonExtractStr(clientJson, "accountId")
    let pathStyle: str = jsonExtractStr(clientJson, "pathStyle")

    if baseUrl == "":
        var errResult: http.HttpResult
        errResult.error = "BackendClient: baseUrl is empty"
        return errResult

    let url: str = buildApiUrl(baseUrl, pathStyle, path)
    let headers: str = buildRequestHeadersWithAccountId(authToken, userAgent, accountId)
    return http.HttpGet(url, headers)

# ── Check response — returns error string if non-2xx, empty string on success ──

fn BackendClientCheckResponse(result: http.HttpResult): str =
    if result.error != "":
        return result.error
    if result.statusCode < 200 || result.statusCode >= 300:
        return strings.ConcatStr(strings.ConcatStr(
            strings.ConcatStr("backend returned status ", strings.IntToStr(result.statusCode)),
            ": "),
            result.body)
    return ""

# ── Build full path components ───────────────────────────────────────────

fn BackendPathTasks(): str =
    return "/tasks"

fn BackendPathTask(taskId: str): str =
    return strings.ConcatStr("/tasks/", taskId)

fn BackendPathTaskList(): str =
    return "/tasks/list"

fn BackendPathUsage(): str =
    return "/usage"

fn BackendPathConfigRequirements(): str =
    return "/config/requirements"

fn BackendPathSiblingTurns(taskId: str, turnId: str): str =
    return strings.ConcatStr(strings.ConcatStr(
        strings.ConcatStr(strings.ConcatStr("/tasks/", taskId), "/turns/"),
        turnId),
        "/sibling_turns")

fn BackendPathAddCreditsNudgeEmail(): str =
    return "/accounts/send_add_credits_nudge_email"
