# Backend API — endpoint definitions for Codex backend
#
# Ported from codex-rs/backend-client/src/client.rs API methods.
# Each function calls the appropriate backend endpoint and returns the response.
#
# Error handling: non-2xx responses return error string, success returns body JSON.
#
# NOTE: Uses strings.ConcatStr instead of strutl.Join (cold compiler compat).

import std/strings
import cheng/codex/std/http
import cheng/codex/backend_client/client as bclient

# ── Minimal JSON string value extraction from response bodies ────────────
# Looks for "key":" in JSON and extracts the string value.

fn extractStrValue(json: str, key: str): str =
    if json.len == 0 || key.len == 0:
        return ""
    var pattern: str = strings.ConcatStr(strings.ConcatStr("\"", key), "\":")
    let n: int32 = json.len
    let plen: int32 = pattern.len
    var i: int32 = 0
    var found: bool = false
    while i <= n - plen && !found:
        var j: int32 = 0
        var matched: bool = true
        while j < plen && matched:
            if json[i + j] != pattern[j]:
                matched = false
            j = j + 1
        if matched:
            found = true
        else:
            i = i + 1
    if !found:
        return ""
    i = i + plen
    while i < n && (json[i] == ' ' || json[i] == '\t' || json[i] == '\n' || json[i] == '\r'):
        i = i + 1
    if i >= n || json[i] != '"':
        return ""
    i = i + 1
    var value: str = ""
    while i < n && json[i] != '"':
        if json[i] == '\\':
            i = i + 1
            if i < n:
                value = strings.ConcatStr(value, strings.SliceBytes(json, i, 1))
                i = i + 1
        else:
            value = strings.ConcatStr(value, strings.SliceBytes(json, i, 1))
            i = i + 1
    return value

# ── Get nested string value: finds outerKey, looks for innerKey inside it ──

fn extractNestedStrValue(json: str, outerKey: str, innerKey: str): str =
    if json.len == 0:
        return ""
    var outerPattern: str = strings.ConcatStr(strings.ConcatStr("\"", outerKey), "\":")
    let n: int32 = json.len
    let olen: int32 = outerPattern.len
    var i: int32 = 0
    var found: bool = false
    while i <= n - olen && !found:
        var j: int32 = 0
        var matched: bool = true
        while j < olen && matched:
            if json[i + j] != outerPattern[j]:
                matched = false
            j = j + 1
        if matched:
            found = true
        else:
            i = i + 1
    if !found:
        return ""
    i = i + olen
    while i < n && (json[i] == ' ' || json[i] == '\t' || json[i] == '\n' || json[i] == '\r'):
        i = i + 1
    if i >= n || json[i] != '{':
        return ""
    let sub: str = strings.SliceBytes(json, i, n - i)
    return extractStrValue(sub, innerKey)

# ── Response body for error messages ─────────────────────────────────────

fn buildError(prefix: str, statusCode: int32, body: str): str =
    return strings.ConcatStr(strings.ConcatStr(
        strings.ConcatStr(strings.ConcatStr(prefix, " status "), strings.IntToStr(statusCode)),
        ": "),
        body)

fn buildTransportError(prefix: str, err: str): str =
    return strings.ConcatStr(strings.ConcatStr(prefix, " error: "), err)

# ── Create a new task (user turn) ────────────────────────────────────────
# POST {baseUrl}/api/codex/tasks or {baseUrl}/wham/tasks
# requestBody: JSON string with the task creation payload
# Returns: task id string, or error string

fn BackendCreateTask(clientJson: str, requestBody: str): str =
    let path: str = bclient.BackendPathTasks()
    let result: http.HttpResult = bclient.BackendClientPost(clientJson, path, requestBody)
    if result.error != "":
        return buildTransportError("BackendCreateTask", result.error)
    if result.statusCode < 200 || result.statusCode >= 300:
        return buildError("BackendCreateTask", result.statusCode, result.body)
    var taskId: str = extractNestedStrValue(result.body, "task", "id")
    if taskId == "":
        taskId = extractStrValue(result.body, "id")
    if taskId == "":
        return strings.ConcatStr("BackendCreateTask: no task id in response: ", result.body)
    return taskId

# ── Get task details ─────────────────────────────────────────────────────
# GET {baseUrl}/api/codex/tasks/{taskId} or {baseUrl}/wham/tasks/{taskId}
# Returns: JSON response body string with task details, or error string

fn BackendGetTask(clientJson: str, taskId: str): str =
    let path: str = bclient.BackendPathTask(taskId)
    let result: http.HttpResult = bclient.BackendClientGet(clientJson, path)
    if result.error != "":
        return buildTransportError("BackendGetTask", result.error)
    if result.statusCode < 200 || result.statusCode >= 300:
        return buildError("BackendGetTask", result.statusCode, result.body)
    return result.body

# ── List tasks ───────────────────────────────────────────────────────────
# GET {baseUrl}/api/codex/tasks/list or {baseUrl}/wham/tasks/list
# Returns: JSON response body string with task list, or error string

fn BackendListTasks(clientJson: str): str =
    let path: str = bclient.BackendPathTaskList()
    let result: http.HttpResult = bclient.BackendClientGet(clientJson, path)
    if result.error != "":
        return buildTransportError("BackendListTasks", result.error)
    if result.statusCode < 200 || result.statusCode >= 300:
        return buildError("BackendListTasks", result.statusCode, result.body)
    return result.body

