# ── List sibling turns ───────────────────────────────────────────────────
# GET {baseUrl}/api/codex/tasks/{taskId}/turns/{turnId}/sibling_turns
# Returns: JSON response body string, or error string

fn BackendListSiblingTurns(clientJson: str, taskId: str, turnId: str): str =
    let path: str = bclient.BackendPathSiblingTurns(taskId, turnId)
    let result: http.HttpResult = bclient.BackendClientGet(clientJson, path)
    if result.error != "":
        return buildTransportError("BackendListSiblingTurns", result.error)
    if result.statusCode < 200 || result.statusCode >= 300:
        return buildError("BackendListSiblingTurns", result.statusCode, result.body)
    return result.body

# ── Send add credits nudge email ─────────────────────────────────────────
# POST {baseUrl}/api/codex/accounts/send_add_credits_nudge_email
# creditType: "Credits" or "UsageLimit"
# Returns: empty string on success, error string on failure

fn BackendSendAddCreditsNudgeEmail(clientJson: str, creditType: str): str =
    var body: str = "{\"credit_type\":\""
    body = strings.ConcatStr(body, creditType)
    body = strings.ConcatStr(body, "\"}")
    let path: str = bclient.BackendPathAddCreditsNudgeEmail()
    let result: http.HttpResult = bclient.BackendClientPost(clientJson, path, body)
    if result.error != "":
        return buildTransportError("BackendSendAddCreditsNudgeEmail", result.error)
    if result.statusCode < 200 || result.statusCode >= 300:
        return buildError("BackendSendAddCreditsNudgeEmail", result.statusCode, result.body)
    return ""
