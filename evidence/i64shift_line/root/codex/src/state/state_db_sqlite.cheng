fn RustCsgStateDbVisiblePageRowsFilteredDynamicWithCwd(dbPath: str,
                                                       sortKey: str,
                                                       sortDirection: str,
                                                       archived: bool,
                                                       allowedSourcesJson: str,
                                                       modelProvidersJson: str,
                                                       cwdFilter: str,
                                                       searchTerm: str,
                                                       cursorMillisText: str,
                                                       scanLimit: int32): RustCsgStateDbThreadPageResult =
    var cwdFiltersJson: str
    if cwdFilter != "":
        cwdFiltersJson = RustCsgStateDbJsonStringArrayOne(cwdFilter)
    return RustCsgStateDbVisiblePageRowsFilteredDynamicWithCwds(dbPath,
                                                                sortKey,
                                                                sortDirection,
                                                                archived,
                                                                allowedSourcesJson,
                                                                modelProvidersJson,
                                                                cwdFiltersJson,
                                                                searchTerm,
                                                                cursorMillisText,
                                                                scanLimit)

fn RustCsgStateDbVisiblePageRowsFilteredDynamicWithCwds(dbPath: str,
                                                        sortKey: str,
                                                        sortDirection: str,
                                                        archived: bool,
                                                        allowedSourcesJson: str,
                                                        modelProvidersJson: str,
                                                        cwdFiltersJson: str,
                                                        searchTerm: str,
                                                        cursorMillisText: str,
                                                        scanLimit: int32): RustCsgStateDbThreadPageResult =
    if scanLimit < 1:
        return RustCsgStateDbThreadPageError("state db filtered page scan limit must be positive")
    let modelProviders = RustCsgStateDbStringArrayFromRaw(modelProvidersJson)
    let cwdFilters = RustCsgStateDbStringArrayFromRaw(cwdFiltersJson)
    let sql = RustCsgStateDbVisiblePageFilteredSql(sortKey,
                                                   sortDirection,
                                                   archived,
                                                   allowedSourcesJson,
                                                   modelProviders.len,
                                                   cwdFilters.len,
                                                   searchTerm,
                                                   cursorMillisText)
    if sql == "":
        return RustCsgStateDbThreadPageError("unsupported state db filtered visible page query")
    var openResult = sqlite.OpenReadonly(dbPath)
    if !openResult.ok:
        return RustCsgStateDbThreadPageError(openResult.error)
    var prepareResult = sqlite.Prepare(openResult.db, sql)
    if !prepareResult.ok:
        let closeAfterPrepareError = sqlite.Close(openResult.db)
        closeAfterPrepareError
        return RustCsgStateDbThreadPageError(prepareResult.error)

    var bindIndex: int32
    bindIndex = 1
    for i in 0..<modelProviders.len:
        let bindProvider = sqlite.BindText(prepareResult.stmt, bindIndex, modelProviders[i])
        if !bindProvider.ok:
            let finalizeAfterProviderBindError = sqlite.Finalize(prepareResult.stmt)
            finalizeAfterProviderBindError
            let closeAfterProviderBindError = sqlite.Close(openResult.db)
            closeAfterProviderBindError
            return RustCsgStateDbThreadPageError(bindProvider.error)
        bindIndex = bindIndex + 1
    for i in 0..<cwdFilters.len:
        let bindCwd = sqlite.BindText(prepareResult.stmt, bindIndex, cwdFilters[i])
        if !bindCwd.ok:
            let finalizeAfterCwdBindError = sqlite.Finalize(prepareResult.stmt)
            finalizeAfterCwdBindError
            let closeAfterCwdBindError = sqlite.Close(openResult.db)
            closeAfterCwdBindError
            return RustCsgStateDbThreadPageError(bindCwd.error)
        bindIndex = bindIndex + 1
    if searchTerm != "":
        let bindSearch = sqlite.BindText(prepareResult.stmt, bindIndex, searchTerm)
        if !bindSearch.ok:
            let finalizeAfterSearchBindError = sqlite.Finalize(prepareResult.stmt)
            finalizeAfterSearchBindError
            let closeAfterSearchBindError = sqlite.Close(openResult.db)
            closeAfterSearchBindError
            return RustCsgStateDbThreadPageError(bindSearch.error)
        bindIndex = bindIndex + 1
    if cursorMillisText != "":
        let bindCursor = sqlite.BindText(prepareResult.stmt, bindIndex, cursorMillisText)
        if !bindCursor.ok:
            let finalizeAfterCursorBindError = sqlite.Finalize(prepareResult.stmt)
            finalizeAfterCursorBindError
            let closeAfterCursorBindError = sqlite.Close(openResult.db)
            closeAfterCursorBindError
            return RustCsgStateDbThreadPageError(bindCursor.error)
        bindIndex = bindIndex + 1
    let bindLimit = sqlite.BindInt64(prepareResult.stmt, bindIndex, int64(scanLimit))
    if !bindLimit.ok:
        let finalizeAfterLimitBindError = sqlite.Finalize(prepareResult.stmt)
        finalizeAfterLimitBindError
        let closeAfterLimitBindError = sqlite.Close(openResult.db)
        closeAfterLimitBindError
        return RustCsgStateDbThreadPageError(bindLimit.error)

    var rows: RustCsgStateDbThreadRowResult[]
    rows = []
    while true:
        let step = sqlite.Step(prepareResult.stmt)
        if step.row:
            add(rows, RustCsgStateDbThreadRowFromStatement(prepareResult.stmt))
            continue
        if step.done:
            let finalizeStatus = sqlite.Finalize(prepareResult.stmt)
            if !finalizeStatus.ok:
                let closeAfterFinalizeError = sqlite.Close(openResult.db)
                closeAfterFinalizeError
                return RustCsgStateDbThreadPageError(finalizeStatus.error)
            let closeStatus = sqlite.Close(openResult.db)
            if !closeStatus.ok:
                return RustCsgStateDbThreadPageError(closeStatus.error)
            var result: RustCsgStateDbThreadPageResult
            result.rows = rows
            result.ok = true
            return result
        let finalizeAfterStepError = sqlite.Finalize(prepareResult.stmt)
        finalizeAfterStepError
        let closeAfterStepError = sqlite.Close(openResult.db)
        closeAfterStepError
        return RustCsgStateDbThreadPageError(step.error)

fn RustCsgStateDbVisiblePageRowsFromStart(dbPath: str,
                                          sortKey: str,
                                          sortDirection: str): RustCsgStateDbPageRows =
    var result: RustCsgStateDbPageRows
    result.row0 = RustCsgStateDbVisibleThreadAt(dbPath, sortKey, sortDirection, false, 0)
    result.row1 = RustCsgStateDbVisibleThreadAt(dbPath, sortKey, sortDirection, false, 1)
    result.row2 = RustCsgStateDbVisibleThreadAt(dbPath, sortKey, sortDirection, false, 2)
    return result

fn RustCsgStateDbVisiblePageRowsAfter(dbPath: str,
                                      sortKey: str,
                                      sortDirection: str,
                                      cursorMillisText: str): RustCsgStateDbPageRows =
    var result: RustCsgStateDbPageRows
    result.row0 = RustCsgStateDbVisibleThreadAfter(dbPath, sortKey, sortDirection, cursorMillisText, 0)
    result.row1 = RustCsgStateDbVisibleThreadAfter(dbPath, sortKey, sortDirection, cursorMillisText, 1)
    result.row2 = RustCsgStateDbVisibleThreadAfter(dbPath, sortKey, sortDirection, cursorMillisText, 2)
    return result

fn RustCsgStateDbVisiblePageRowsFromStartFiltered(dbPath: str,
                                                  sortKey: str,
                                                  sortDirection: str,
                                                  archived: bool,
                                                  allowedSourcesJson: str,
                                                  modelProvider: str,
                                                  searchTerm: str): RustCsgStateDbPageRows =
    return RustCsgStateDbVisiblePageRowsFromStartFilteredWithCwd(dbPath,
                                                                 sortKey,
                                                                 sortDirection,
                                                                 archived,
                                                                 allowedSourcesJson,
                                                                 modelProvider,
                                                                 "",
                                                                 searchTerm)

fn RustCsgStateDbVisiblePageRowsFromStartFilteredWithCwd(dbPath: str,
                                                         sortKey: str,
                                                         sortDirection: str,
                                                         archived: bool,
                                                         allowedSourcesJson: str,
                                                         modelProvider: str,
                                                         cwdFilter: str,
                                                         searchTerm: str): RustCsgStateDbPageRows =
    var result: RustCsgStateDbPageRows
    result.row0 = RustCsgStateDbVisibleThreadFilteredWithCwd(dbPath, sortKey, sortDirection, archived, 0, allowedSourcesJson, modelProvider, cwdFilter, searchTerm, "")
    result.row1 = RustCsgStateDbVisibleThreadFilteredWithCwd(dbPath, sortKey, sortDirection, archived, 1, allowedSourcesJson, modelProvider, cwdFilter, searchTerm, "")
    result.row2 = RustCsgStateDbVisibleThreadFilteredWithCwd(dbPath, sortKey, sortDirection, archived, 2, allowedSourcesJson, modelProvider, cwdFilter, searchTerm, "")
    return result

fn RustCsgStateDbVisiblePageRowsAfterFiltered(dbPath: str,
                                              sortKey: str,
                                              sortDirection: str,
                                              cursorMillisText: str,
                                              archived: bool,
                                              allowedSourcesJson: str,
                                              modelProvider: str,
                                              searchTerm: str): RustCsgStateDbPageRows =
    return RustCsgStateDbVisiblePageRowsAfterFilteredWithCwd(dbPath,
                                                             sortKey,
                                                             sortDirection,
                                                             cursorMillisText,
                                                             archived,
                                                             allowedSourcesJson,
                                                             modelProvider,
                                                             "",
                                                             searchTerm)

fn RustCsgStateDbVisiblePageRowsAfterFilteredWithCwd(dbPath: str,
                                                     sortKey: str,
                                                     sortDirection: str,
                                                     cursorMillisText: str,
                                                     archived: bool,
                                                     allowedSourcesJson: str,
                                                     modelProvider: str,
                                                     cwdFilter: str,
                                                     searchTerm: str): RustCsgStateDbPageRows =
    var result: RustCsgStateDbPageRows
    result.row0 = RustCsgStateDbVisibleThreadFilteredWithCwd(dbPath, sortKey, sortDirection, archived, 0, allowedSourcesJson, modelProvider, cwdFilter, searchTerm, cursorMillisText)
    result.row1 = RustCsgStateDbVisibleThreadFilteredWithCwd(dbPath, sortKey, sortDirection, archived, 1, allowedSourcesJson, modelProvider, cwdFilter, searchTerm, cursorMillisText)
    result.row2 = RustCsgStateDbVisibleThreadFilteredWithCwd(dbPath, sortKey, sortDirection, archived, 2, allowedSourcesJson, modelProvider, cwdFilter, searchTerm, cursorMillisText)
    return result
