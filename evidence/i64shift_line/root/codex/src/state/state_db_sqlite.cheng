import std/sqlite
import std/strings as strings

@abi_internal
@importc("RustCsgInt32ToDecStr")
fn RustCsgInt32ToDecStr(value: int32): str

type
    RustCsgStateDbCountResult =
        ok: bool
        count: int64
        error: str

    RustCsgStateDbStringResult =
        ok: bool
        notFound: bool
        present: bool
        value: str
        error: str

    RustCsgStateDbThreadRowResult =
        ok: bool
        notFound: bool
        id: str
        title: str
        cwd: str
        modelProvider: str
        source: str
        rolloutPath: str
        createdAtMs: int64
        updatedAtMs: int64
        cliVersion: str
        firstUserMessage: str
        error: str

    RustCsgStateDbPageRows =
        row0: RustCsgStateDbThreadRowResult
        row1: RustCsgStateDbThreadRowResult
        row2: RustCsgStateDbThreadRowResult

    RustCsgStateDbThreadPageResult =
        ok: bool
        rows: RustCsgStateDbThreadRowResult[]
        error: str

    RustCsgStateDbWriteResult =
        ok: bool
        notFound: bool
        error: str

fn RustCsgStateDbCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

fn RustCsgStateDbSelectColumns(): str =
    return "SELECT id, title, cwd, model_provider, source, rollout_path, created_at_ms, updated_at_ms, cli_version, first_user_message FROM threads"

fn RustCsgStateDbOffsetSql(offset: int32): str =
    if offset >= 0:
        return RustCsgInt32ToDecStr(offset)
    return ""

fn RustCsgStateDbOrderColumn(sortKey: str): str =
    if sortKey == "created_at":
        return "created_at_ms"
    if sortKey == "updated_at":
        return "updated_at_ms"
    return ""

fn RustCsgStateDbOrderDirection(sortDirection: str): str =
    if sortDirection == "asc":
        return "ASC"
    if sortDirection == "desc":
        return "DESC"
    return ""

fn RustCsgStateDbSourcePredicate(allowedSourcesJson: str): str =
    if allowedSourcesJson == "":
        return ""
    if allowedSourcesJson == "[]":
        return ""
    if allowedSourcesJson == "[\"cli\"]":
        return " AND threads.source IN ('cli')"
    if allowedSourcesJson == "[\"vscode\"]":
        return " AND threads.source IN ('vscode')"
    if allowedSourcesJson == "[\"exec\"]":
        return " AND threads.source IN ('exec')"
    if allowedSourcesJson == "[\"mcp\"]":
        return " AND threads.source IN ('mcp')"
    if allowedSourcesJson == "[\"unknown\"]":
        return " AND threads.source IN ('unknown')"
    if allowedSourcesJson == "[\"subagent\"]":
        return " AND threads.source LIKE 'subagent_%'"
    if allowedSourcesJson == "[\"subagent_review\"]":
        return " AND threads.source IN ('subagent_review')"
    if allowedSourcesJson == "[\"subagent_compact\"]":
        return " AND threads.source IN ('subagent_compact')"
    if allowedSourcesJson == "[\"subagent_thread_spawn\"]":
        return " AND threads.source LIKE 'subagent_thread_spawn_%'"
    if allowedSourcesJson == "[\"cli\",\"vscode\"]":
        return " AND threads.source IN ('cli','vscode')"
    if allowedSourcesJson == "[\"cli\",\"vscode\",\"{\\\"custom\\\":\\\"atlas\\\"}\",\"{\\\"custom\\\":\\\"chatgpt\\\"}\"]":
        return " AND threads.source IN ('cli','vscode','{\"custom\":\"atlas\"}','{\"custom\":\"chatgpt\"}')"
    return "__unsupported_source_filter__"

fn RustCsgStateDbVisibleThreadFilteredSql(sortKey: str,
                                          sortDirection: str,
                                          archived: bool,
                                          offset: int32,
                                          allowedSourcesJson: str,
                                          modelProvider: str,
                                          cwdFilter: str,
                                          searchTerm: str,
                                          cursorMillisText: str): str =
    let offsetSql = RustCsgStateDbOffsetSql(offset)
    let orderColumn = RustCsgStateDbOrderColumn(sortKey)
    let orderDirection = RustCsgStateDbOrderDirection(sortDirection)
    let sourcePredicate = RustCsgStateDbSourcePredicate(allowedSourcesJson)
    if offsetSql == "" || orderColumn == "" || orderDirection == "":
        return ""
    if sourcePredicate == "__unsupported_source_filter__":
        return ""

    var sql = RustCsgStateDbSelectColumns()
    if archived:
        sql = RustCsgStateDbCat(sql, " WHERE threads.archived = 1 AND threads.first_user_message <> ''")
    else:
        sql = RustCsgStateDbCat(sql, " WHERE threads.archived = 0 AND threads.first_user_message <> ''")
    sql = RustCsgStateDbCat(sql, sourcePredicate)
    if modelProvider != "":
        sql = RustCsgStateDbCat(sql, " AND threads.model_provider = ?")
    if cwdFilter != "":
        sql = RustCsgStateDbCat(sql, " AND threads.cwd = ?")
    if searchTerm != "":
        sql = RustCsgStateDbCat(sql, " AND instr(threads.title, ?) > 0")
    if cursorMillisText != "":
        if sortDirection == "asc":
            sql = RustCsgStateDbCat(sql, RustCsgStateDbCat(" AND threads.", orderColumn))
            sql = RustCsgStateDbCat(sql, " > CAST(? AS INTEGER)")
        else:
            sql = RustCsgStateDbCat(sql, RustCsgStateDbCat(" AND threads.", orderColumn))
            sql = RustCsgStateDbCat(sql, " < CAST(? AS INTEGER)")
    sql = RustCsgStateDbCat(sql, RustCsgStateDbCat(" ORDER BY ", orderColumn))
    sql = RustCsgStateDbCat(sql, RustCsgStateDbCat(" ", orderDirection))
    sql = RustCsgStateDbCat(sql, RustCsgStateDbCat(" LIMIT 1 OFFSET ", offsetSql))
    return sql

fn RustCsgStateDbCountError(message: str): RustCsgStateDbCountResult =
    var result: RustCsgStateDbCountResult
    result.error = message
    return result

fn RustCsgStateDbThreadRowError(message: str): RustCsgStateDbThreadRowResult =
    var result: RustCsgStateDbThreadRowResult
    result.error = message
    return result

fn RustCsgStateDbStringError(message: str): RustCsgStateDbStringResult =
    var result: RustCsgStateDbStringResult
    result.error = message
    return result

fn RustCsgStateDbStringNotFound(): RustCsgStateDbStringResult =
    var result: RustCsgStateDbStringResult
    result.notFound = true
    return result

fn RustCsgStateDbThreadPageError(message: str): RustCsgStateDbThreadPageResult =
    var result: RustCsgStateDbThreadPageResult
    result.error = message
    return result

fn RustCsgStateDbWriteError(message: str): RustCsgStateDbWriteResult =
    var result: RustCsgStateDbWriteResult
    result.error = message
    return result

fn RustCsgStateDbWriteNotFound(): RustCsgStateDbWriteResult =
    var result: RustCsgStateDbWriteResult
    result.notFound = true
    return result

fn RustCsgStateDbWriteOk(): RustCsgStateDbWriteResult =
    var result: RustCsgStateDbWriteResult
    result.ok = true
    return result

fn RustCsgStateDbThreadRowNotFound(): RustCsgStateDbThreadRowResult =
    var result: RustCsgStateDbThreadRowResult
    result.notFound = true
    return result

fn RustCsgStateDbThreadRowFromStatement(stmt: sqlite.Statement): RustCsgStateDbThreadRowResult =
    var result: RustCsgStateDbThreadRowResult
    result.id = sqlite.ColumnText(stmt, 0)
    result.title = sqlite.ColumnText(stmt, 1)
    result.cwd = sqlite.ColumnText(stmt, 2)
    result.modelProvider = sqlite.ColumnText(stmt, 3)
    result.source = sqlite.ColumnText(stmt, 4)
    result.rolloutPath = sqlite.ColumnText(stmt, 5)
    result.createdAtMs = sqlite.ColumnInt64(stmt, 6)
    result.updatedAtMs = sqlite.ColumnInt64(stmt, 7)
    result.cliVersion = sqlite.ColumnText(stmt, 8)
    result.firstUserMessage = sqlite.ColumnText(stmt, 9)
    result.ok = true
    return result

fn RustCsgStateDbQuestionMarks(count: int32): str =
    var out = ""
    for i in 0..<count:
        if i > 0:
            out = RustCsgStateDbCat(out, ",")
        out = RustCsgStateDbCat(out, "?")
    return out

fn RustCsgStateDbJsonStringArrayOne(value: str): str =
    return RustCsgStateDbCat(RustCsgStateDbCat("[\"", value), "\"]")

fn RustCsgStateDbSkipJsonSpace(raw: str, start: int32): int32 =
    var pos = start
    while pos < raw.len:
        let ch = raw[pos]
        if ch == ' ' || ch == '\n' || ch == '\r' || ch == '\t':
            pos = pos + 1
            continue
        return pos
    return pos

fn RustCsgStateDbStringArrayFromRaw(raw: str): str[] =
    var out: str[]
    out = []
    if raw == "" || raw == "[]":
        return out
    var pos: int32
    pos = RustCsgStateDbSkipJsonSpace(raw, 0)
    assert(pos < raw.len && raw[pos] == '[', "state db json string array must start with [")
    pos = RustCsgStateDbSkipJsonSpace(raw, pos + 1)
    if pos < raw.len && raw[pos] == ']':
        return out
    while pos < raw.len:
        assert(raw[pos] == '"', "state db json array item is not string")
        var value: str
        var i: int32
        i = pos + 1
        while i < raw.len:
            let ch = raw[i]
            if ch == '\\':
                assert(i + 1 < raw.len, "unterminated state db json string escape")
                let escaped = raw[i + 1]
                if escaped == '"' || escaped == '\\' || escaped == '/':
                    value = RustCsgStateDbCat(value, strings.CharToStr(escaped))
                elif escaped == 'n':
                    value = RustCsgStateDbCat(value, "\n")
                elif escaped == 'r':
                    value = RustCsgStateDbCat(value, "\r")
                elif escaped == 't':
                    value = RustCsgStateDbCat(value, "\t")
                else:
                    assert(false, "unsupported state db json string escape")
                i = i + 2
                continue
            if ch == '"':
                add(out, value)
                pos = RustCsgStateDbSkipJsonSpace(raw, i + 1)
                if pos < raw.len && raw[pos] == ',':
                    pos = RustCsgStateDbSkipJsonSpace(raw, pos + 1)
                    break
                if pos < raw.len && raw[pos] == ']':
                    return out
                assert(false, "malformed state db json string array")
            value = RustCsgStateDbCat(value, strings.CharToStr(ch))
            i = i + 1
        if i >= raw.len:
            assert(false, "unterminated state db json string array item")
    assert(false, "unterminated state db json string array")
    return out

fn RustCsgStateDbVisiblePageFilteredSql(sortKey: str,
                                        sortDirection: str,
                                        archived: bool,
                                        allowedSourcesJson: str,
                                        modelProviderCount: int32,
                                        cwdFilterCount: int32,
                                        searchTerm: str,
                                        cursorMillisText: str): str =
    let orderColumn = RustCsgStateDbOrderColumn(sortKey)
    let orderDirection = RustCsgStateDbOrderDirection(sortDirection)
    let sourcePredicate = RustCsgStateDbSourcePredicate(allowedSourcesJson)
    if orderColumn == "" || orderDirection == "":
        return ""
    if sourcePredicate == "__unsupported_source_filter__":
        return ""

    var sql = RustCsgStateDbSelectColumns()
    if archived:
        sql = RustCsgStateDbCat(sql, " WHERE threads.archived = 1 AND threads.first_user_message <> ''")
    else:
        sql = RustCsgStateDbCat(sql, " WHERE threads.archived = 0 AND threads.first_user_message <> ''")
    sql = RustCsgStateDbCat(sql, sourcePredicate)
    if modelProviderCount > 0:
        sql = RustCsgStateDbCat(sql, " AND threads.model_provider IN (")
        sql = RustCsgStateDbCat(sql, RustCsgStateDbQuestionMarks(modelProviderCount))
        sql = RustCsgStateDbCat(sql, ")")
    if cwdFilterCount > 0:
        sql = RustCsgStateDbCat(sql, " AND threads.cwd IN (")
        sql = RustCsgStateDbCat(sql, RustCsgStateDbQuestionMarks(cwdFilterCount))
        sql = RustCsgStateDbCat(sql, ")")
    if searchTerm != "":
        sql = RustCsgStateDbCat(sql, " AND instr(threads.title, ?) > 0")
    if cursorMillisText != "":
        if sortDirection == "asc":
            sql = RustCsgStateDbCat(sql, RustCsgStateDbCat(" AND threads.", orderColumn))
            sql = RustCsgStateDbCat(sql, " > CAST(? AS INTEGER)")
        else:
            sql = RustCsgStateDbCat(sql, RustCsgStateDbCat(" AND threads.", orderColumn))
            sql = RustCsgStateDbCat(sql, " < CAST(? AS INTEGER)")
    sql = RustCsgStateDbCat(sql, RustCsgStateDbCat(" ORDER BY ", orderColumn))
    sql = RustCsgStateDbCat(sql, RustCsgStateDbCat(" ", orderDirection))
    sql = RustCsgStateDbCat(sql, " LIMIT ?")
    return sql

fn RustCsgStateDbCountVisibleThreads(dbPath: str): RustCsgStateDbCountResult =
    var openResult = sqlite.OpenReadonly(dbPath)
    if !openResult.ok:
        return RustCsgStateDbCountError(openResult.error)
    var prepareResult = sqlite.Prepare(openResult.db,
                                       "SELECT COUNT(*) FROM threads WHERE archived = 0 AND first_user_message <> ''")
    if !prepareResult.ok:
        let closeAfterPrepareError = sqlite.Close(openResult.db)
        closeAfterPrepareError
        return RustCsgStateDbCountError(prepareResult.error)
    let step = sqlite.Step(prepareResult.stmt)
    if !step.row:
        let finalizeAfterStepError = sqlite.Finalize(prepareResult.stmt)
        finalizeAfterStepError
        let closeAfterStepError = sqlite.Close(openResult.db)
        closeAfterStepError
        if step.error != "":
            return RustCsgStateDbCountError(step.error)
        return RustCsgStateDbCountError("state db count query returned no row")
    var result: RustCsgStateDbCountResult
    result.count = sqlite.ColumnInt64(prepareResult.stmt, 0)
    let finalizeStatus = sqlite.Finalize(prepareResult.stmt)
    if !finalizeStatus.ok:
        let closeAfterFinalizeError = sqlite.Close(openResult.db)
        closeAfterFinalizeError
        return RustCsgStateDbCountError(finalizeStatus.error)
    let closeStatus = sqlite.Close(openResult.db)
    if !closeStatus.ok:
        return RustCsgStateDbCountError(closeStatus.error)
    result.ok = true
    return result

fn RustCsgStateDbFirstVisibleThread(dbPath: str): RustCsgStateDbThreadRowResult =
    return RustCsgStateDbVisibleThreadAt(dbPath, "updated_at", "desc", false, 0)

fn RustCsgStateDbVisibleThreadSql(sortKey: str,
                                  sortDirection: str,
                                  archived: bool,
                                  offset: int32): str =
    if archived:
        return ""
    if sortKey == "created_at" && sortDirection == "asc":
        if offset == 0:
            return "SELECT id, title, cwd, model_provider, source, rollout_path, created_at_ms, updated_at_ms, cli_version, first_user_message FROM threads WHERE first_user_message <> '' AND archived = 0 ORDER BY created_at_ms ASC LIMIT 1 OFFSET 0"
        if offset == 1:
            return "SELECT id, title, cwd, model_provider, source, rollout_path, created_at_ms, updated_at_ms, cli_version, first_user_message FROM threads WHERE first_user_message <> '' AND archived = 0 ORDER BY created_at_ms ASC LIMIT 1 OFFSET 1"
        if offset == 2:
            return "SELECT id, title, cwd, model_provider, source, rollout_path, created_at_ms, updated_at_ms, cli_version, first_user_message FROM threads WHERE first_user_message <> '' AND archived = 0 ORDER BY created_at_ms ASC LIMIT 1 OFFSET 2"
    if sortKey == "created_at" && sortDirection == "desc":
        if offset == 0:
            return "SELECT id, title, cwd, model_provider, source, rollout_path, created_at_ms, updated_at_ms, cli_version, first_user_message FROM threads WHERE first_user_message <> '' AND archived = 0 ORDER BY created_at_ms DESC LIMIT 1 OFFSET 0"
        if offset == 1:
            return "SELECT id, title, cwd, model_provider, source, rollout_path, created_at_ms, updated_at_ms, cli_version, first_user_message FROM threads WHERE first_user_message <> '' AND archived = 0 ORDER BY created_at_ms DESC LIMIT 1 OFFSET 1"
        if offset == 2:
            return "SELECT id, title, cwd, model_provider, source, rollout_path, created_at_ms, updated_at_ms, cli_version, first_user_message FROM threads WHERE first_user_message <> '' AND archived = 0 ORDER BY created_at_ms DESC LIMIT 1 OFFSET 2"
    if sortKey == "updated_at" && sortDirection == "asc":
        if offset == 0:
            return "SELECT id, title, cwd, model_provider, source, rollout_path, created_at_ms, updated_at_ms, cli_version, first_user_message FROM threads WHERE first_user_message <> '' AND archived = 0 ORDER BY updated_at_ms ASC LIMIT 1 OFFSET 0"
        if offset == 1:
            return "SELECT id, title, cwd, model_provider, source, rollout_path, created_at_ms, updated_at_ms, cli_version, first_user_message FROM threads WHERE first_user_message <> '' AND archived = 0 ORDER BY updated_at_ms ASC LIMIT 1 OFFSET 1"
        if offset == 2:
            return "SELECT id, title, cwd, model_provider, source, rollout_path, created_at_ms, updated_at_ms, cli_version, first_user_message FROM threads WHERE first_user_message <> '' AND archived = 0 ORDER BY updated_at_ms ASC LIMIT 1 OFFSET 2"
    if sortKey == "updated_at" && sortDirection == "desc":
        if offset == 0:
            return "SELECT id, title, cwd, model_provider, source, rollout_path, created_at_ms, updated_at_ms, cli_version, first_user_message FROM threads WHERE first_user_message <> '' AND archived = 0 ORDER BY updated_at_ms DESC LIMIT 1 OFFSET 0"
        if offset == 1:
            return "SELECT id, title, cwd, model_provider, source, rollout_path, created_at_ms, updated_at_ms, cli_version, first_user_message FROM threads WHERE first_user_message <> '' AND archived = 0 ORDER BY updated_at_ms DESC LIMIT 1 OFFSET 1"
        if offset == 2:
            return "SELECT id, title, cwd, model_provider, source, rollout_path, created_at_ms, updated_at_ms, cli_version, first_user_message FROM threads WHERE first_user_message <> '' AND archived = 0 ORDER BY updated_at_ms DESC LIMIT 1 OFFSET 2"
    return ""

fn RustCsgStateDbVisibleThreadAfterSql(sortKey: str,
                                       sortDirection: str,
                                       offset: int32): str =
    if sortKey == "created_at" && sortDirection == "asc":
        if offset == 0:
            return "SELECT id, title, cwd, model_provider, source, rollout_path, created_at_ms, updated_at_ms, cli_version, first_user_message FROM threads WHERE first_user_message <> '' AND archived = 0 AND created_at_ms > CAST(? AS INTEGER) ORDER BY created_at_ms ASC LIMIT 1 OFFSET 0"
        if offset == 1:
            return "SELECT id, title, cwd, model_provider, source, rollout_path, created_at_ms, updated_at_ms, cli_version, first_user_message FROM threads WHERE first_user_message <> '' AND archived = 0 AND created_at_ms > CAST(? AS INTEGER) ORDER BY created_at_ms ASC LIMIT 1 OFFSET 1"
        if offset == 2:
            return "SELECT id, title, cwd, model_provider, source, rollout_path, created_at_ms, updated_at_ms, cli_version, first_user_message FROM threads WHERE first_user_message <> '' AND archived = 0 AND created_at_ms > CAST(? AS INTEGER) ORDER BY created_at_ms ASC LIMIT 1 OFFSET 2"
    if sortKey == "created_at" && sortDirection == "desc":
        if offset == 0:
            return "SELECT id, title, cwd, model_provider, source, rollout_path, created_at_ms, updated_at_ms, cli_version, first_user_message FROM threads WHERE first_user_message <> '' AND archived = 0 AND created_at_ms < CAST(? AS INTEGER) ORDER BY created_at_ms DESC LIMIT 1 OFFSET 0"
        if offset == 1:
            return "SELECT id, title, cwd, model_provider, source, rollout_path, created_at_ms, updated_at_ms, cli_version, first_user_message FROM threads WHERE first_user_message <> '' AND archived = 0 AND created_at_ms < CAST(? AS INTEGER) ORDER BY created_at_ms DESC LIMIT 1 OFFSET 1"
        if offset == 2:
            return "SELECT id, title, cwd, model_provider, source, rollout_path, created_at_ms, updated_at_ms, cli_version, first_user_message FROM threads WHERE first_user_message <> '' AND archived = 0 AND created_at_ms < CAST(? AS INTEGER) ORDER BY created_at_ms DESC LIMIT 1 OFFSET 2"
    if sortKey == "updated_at" && sortDirection == "asc":
        if offset == 0:
            return "SELECT id, title, cwd, model_provider, source, rollout_path, created_at_ms, updated_at_ms, cli_version, first_user_message FROM threads WHERE first_user_message <> '' AND archived = 0 AND updated_at_ms > CAST(? AS INTEGER) ORDER BY updated_at_ms ASC LIMIT 1 OFFSET 0"
        if offset == 1:
            return "SELECT id, title, cwd, model_provider, source, rollout_path, created_at_ms, updated_at_ms, cli_version, first_user_message FROM threads WHERE first_user_message <> '' AND archived = 0 AND updated_at_ms > CAST(? AS INTEGER) ORDER BY updated_at_ms ASC LIMIT 1 OFFSET 1"
        if offset == 2:
            return "SELECT id, title, cwd, model_provider, source, rollout_path, created_at_ms, updated_at_ms, cli_version, first_user_message FROM threads WHERE first_user_message <> '' AND archived = 0 AND updated_at_ms > CAST(? AS INTEGER) ORDER BY updated_at_ms ASC LIMIT 1 OFFSET 2"
    if sortKey == "updated_at" && sortDirection == "desc":
        if offset == 0:
            return "SELECT id, title, cwd, model_provider, source, rollout_path, created_at_ms, updated_at_ms, cli_version, first_user_message FROM threads WHERE first_user_message <> '' AND archived = 0 AND updated_at_ms < CAST(? AS INTEGER) ORDER BY updated_at_ms DESC LIMIT 1 OFFSET 0"
        if offset == 1:
            return "SELECT id, title, cwd, model_provider, source, rollout_path, created_at_ms, updated_at_ms, cli_version, first_user_message FROM threads WHERE first_user_message <> '' AND archived = 0 AND updated_at_ms < CAST(? AS INTEGER) ORDER BY updated_at_ms DESC LIMIT 1 OFFSET 1"
        if offset == 2:
            return "SELECT id, title, cwd, model_provider, source, rollout_path, created_at_ms, updated_at_ms, cli_version, first_user_message FROM threads WHERE first_user_message <> '' AND archived = 0 AND updated_at_ms < CAST(? AS INTEGER) ORDER BY updated_at_ms DESC LIMIT 1 OFFSET 2"
    return ""

fn RustCsgStateDbVisibleThreadAt(dbPath: str,
                                 sortKey: str,
                                 sortDirection: str,
                                 archived: bool,
                                 offset: int32): RustCsgStateDbThreadRowResult =
    let sql = RustCsgStateDbVisibleThreadSql(sortKey, sortDirection, archived, offset)
    if sql == "":
        return RustCsgStateDbThreadRowError("unsupported state db visible thread sort or offset")
    var openResult = sqlite.OpenReadonly(dbPath)
    if !openResult.ok:
        return RustCsgStateDbThreadRowError(openResult.error)
    var prepareResult = sqlite.Prepare(openResult.db, sql)
    if !prepareResult.ok:
        let closeAfterPrepareError = sqlite.Close(openResult.db)
        closeAfterPrepareError
        return RustCsgStateDbThreadRowError(prepareResult.error)
    let step = sqlite.Step(prepareResult.stmt)
    if !step.row:
        let finalizeAfterStepError = sqlite.Finalize(prepareResult.stmt)
        finalizeAfterStepError
        let closeAfterStepError = sqlite.Close(openResult.db)
        closeAfterStepError
        if step.error != "":
            return RustCsgStateDbThreadRowError(step.error)
        return RustCsgStateDbThreadRowNotFound()
    var result = RustCsgStateDbThreadRowFromStatement(prepareResult.stmt)
    let finalizeStatus = sqlite.Finalize(prepareResult.stmt)
    if !finalizeStatus.ok:
        let closeAfterFinalizeError = sqlite.Close(openResult.db)
        closeAfterFinalizeError
        return RustCsgStateDbThreadRowError(finalizeStatus.error)
    let closeStatus = sqlite.Close(openResult.db)
    if !closeStatus.ok:
        return RustCsgStateDbThreadRowError(closeStatus.error)
    result.ok = true
    return result

fn RustCsgStateDbVisibleThreadAfter(dbPath: str,
                                    sortKey: str,
                                    sortDirection: str,
                                    cursorMillisText: str,
                                    offset: int32): RustCsgStateDbThreadRowResult =
    let sql = RustCsgStateDbVisibleThreadAfterSql(sortKey, sortDirection, offset)
    if sql == "":
        return RustCsgStateDbThreadRowError("unsupported state db visible thread cursor sort or offset")
    var openResult = sqlite.OpenReadonly(dbPath)
    if !openResult.ok:
        return RustCsgStateDbThreadRowError(openResult.error)
    var prepareResult = sqlite.Prepare(openResult.db, sql)
    if !prepareResult.ok:
        let closeAfterPrepareError = sqlite.Close(openResult.db)
        closeAfterPrepareError
        return RustCsgStateDbThreadRowError(prepareResult.error)
    let bindCursor = sqlite.BindText(prepareResult.stmt, 1, cursorMillisText)
    if !bindCursor.ok:
        let finalizeAfterBindError = sqlite.Finalize(prepareResult.stmt)
        finalizeAfterBindError
        let closeAfterBindError = sqlite.Close(openResult.db)
        closeAfterBindError
        return RustCsgStateDbThreadRowError(bindCursor.error)
    let step = sqlite.Step(prepareResult.stmt)
    if !step.row:
        let finalizeAfterStepError = sqlite.Finalize(prepareResult.stmt)
        finalizeAfterStepError
        let closeAfterStepError = sqlite.Close(openResult.db)
        closeAfterStepError
        if step.error != "":
            return RustCsgStateDbThreadRowError(step.error)
        return RustCsgStateDbThreadRowNotFound()
    var result = RustCsgStateDbThreadRowFromStatement(prepareResult.stmt)
    let finalizeStatus = sqlite.Finalize(prepareResult.stmt)
    if !finalizeStatus.ok:
        let closeAfterFinalizeError = sqlite.Close(openResult.db)
        closeAfterFinalizeError
        return RustCsgStateDbThreadRowError(finalizeStatus.error)
    let closeStatus = sqlite.Close(openResult.db)
    if !closeStatus.ok:
        return RustCsgStateDbThreadRowError(closeStatus.error)
    result.ok = true
    return result

fn RustCsgStateDbVisibleThreadFiltered(dbPath: str,
                                       sortKey: str,
                                       sortDirection: str,
                                       archived: bool,
                                       offset: int32,
                                       allowedSourcesJson: str,
                                       modelProvider: str,
                                       searchTerm: str,
                                       cursorMillisText: str): RustCsgStateDbThreadRowResult =
    return RustCsgStateDbVisibleThreadFilteredWithCwd(dbPath,
                                                      sortKey,
                                                      sortDirection,
                                                      archived,
                                                      offset,
                                                      allowedSourcesJson,
                                                      modelProvider,
                                                      "",
                                                      searchTerm,
                                                      cursorMillisText)

fn RustCsgStateDbVisibleThreadFilteredWithCwd(dbPath: str,
                                              sortKey: str,
                                              sortDirection: str,
                                              archived: bool,
                                              offset: int32,
                                              allowedSourcesJson: str,
                                              modelProvider: str,
                                              cwdFilter: str,
                                              searchTerm: str,
                                              cursorMillisText: str): RustCsgStateDbThreadRowResult =
    let sql = RustCsgStateDbVisibleThreadFilteredSql(sortKey,
                                                     sortDirection,
                                                     archived,
                                                     offset,
                                                     allowedSourcesJson,
                                                     modelProvider,
                                                     cwdFilter,
                                                     searchTerm,
                                                     cursorMillisText)
    if sql == "":
        return RustCsgStateDbThreadRowError("unsupported state db filtered visible thread query")
    var openResult = sqlite.OpenReadonly(dbPath)
    if !openResult.ok:
        return RustCsgStateDbThreadRowError(openResult.error)
    var prepareResult = sqlite.Prepare(openResult.db, sql)
    if !prepareResult.ok:
        let closeAfterPrepareError = sqlite.Close(openResult.db)
        closeAfterPrepareError
        return RustCsgStateDbThreadRowError(prepareResult.error)
    var bindIndex: int32
    bindIndex = 1
    if modelProvider != "":
        let bindProvider = sqlite.BindText(prepareResult.stmt, bindIndex, modelProvider)
        if !bindProvider.ok:
            let finalizeAfterProviderBindError = sqlite.Finalize(prepareResult.stmt)
            finalizeAfterProviderBindError
            let closeAfterProviderBindError = sqlite.Close(openResult.db)
            closeAfterProviderBindError
            return RustCsgStateDbThreadRowError(bindProvider.error)
        bindIndex = bindIndex + 1
    if cwdFilter != "":
        let bindCwd = sqlite.BindText(prepareResult.stmt, bindIndex, cwdFilter)
        if !bindCwd.ok:
            let finalizeAfterCwdBindError = sqlite.Finalize(prepareResult.stmt)
            finalizeAfterCwdBindError
            let closeAfterCwdBindError = sqlite.Close(openResult.db)
            closeAfterCwdBindError
            return RustCsgStateDbThreadRowError(bindCwd.error)
        bindIndex = bindIndex + 1
    if searchTerm != "":
        let bindSearch = sqlite.BindText(prepareResult.stmt, bindIndex, searchTerm)
        if !bindSearch.ok:
            let finalizeAfterSearchBindError = sqlite.Finalize(prepareResult.stmt)
            finalizeAfterSearchBindError
            let closeAfterSearchBindError = sqlite.Close(openResult.db)
            closeAfterSearchBindError
            return RustCsgStateDbThreadRowError(bindSearch.error)
        bindIndex = bindIndex + 1
    if cursorMillisText != "":
        let bindCursor = sqlite.BindText(prepareResult.stmt, bindIndex, cursorMillisText)
        if !bindCursor.ok:
            let finalizeAfterCursorBindError = sqlite.Finalize(prepareResult.stmt)
            finalizeAfterCursorBindError
            let closeAfterCursorBindError = sqlite.Close(openResult.db)
            closeAfterCursorBindError
            return RustCsgStateDbThreadRowError(bindCursor.error)
    let step = sqlite.Step(prepareResult.stmt)
    if !step.row:
        let finalizeAfterStepError = sqlite.Finalize(prepareResult.stmt)
        finalizeAfterStepError
        let closeAfterStepError = sqlite.Close(openResult.db)
        closeAfterStepError
        if step.error != "":
            return RustCsgStateDbThreadRowError(step.error)
        return RustCsgStateDbThreadRowNotFound()
    var result = RustCsgStateDbThreadRowFromStatement(prepareResult.stmt)
    let finalizeStatus = sqlite.Finalize(prepareResult.stmt)
    if !finalizeStatus.ok:
        let closeAfterFinalizeError = sqlite.Close(openResult.db)
        closeAfterFinalizeError
        return RustCsgStateDbThreadRowError(finalizeStatus.error)
    let closeStatus = sqlite.Close(openResult.db)
    if !closeStatus.ok:
        return RustCsgStateDbThreadRowError(closeStatus.error)
    result.ok = true
    return result

fn RustCsgStateDbExactTitleThreadWithCwd(dbPath: str,
                                         title: str,
                                         cwdFilter: str): RustCsgStateDbThreadRowResult =
    if cwdFilter == "":
        return RustCsgStateDbThreadRowError("state db exact title lookup requires cwd filter")
    return RustCsgStateDbExactTitleThreadMaybeCwd(dbPath, title, cwdFilter)

fn RustCsgStateDbExactTitleThreadMaybeCwd(dbPath: str,
                                          title: str,
                                          cwdFilter: str): RustCsgStateDbThreadRowResult =
    var sql = RustCsgStateDbSelectColumns()
    sql = RustCsgStateDbCat(sql, " WHERE threads.archived = 0 AND threads.first_user_message <> ''")
    sql = RustCsgStateDbCat(sql, " AND threads.title = ?")
    if cwdFilter != "":
        sql = RustCsgStateDbCat(sql, " AND threads.cwd = ?")
    sql = RustCsgStateDbCat(sql, " ORDER BY threads.updated_at_ms DESC LIMIT 1")
    var openResult = sqlite.OpenReadonly(dbPath)
    if !openResult.ok:
        return RustCsgStateDbThreadRowError(openResult.error)
    var prepareResult = sqlite.Prepare(openResult.db, sql)
    if !prepareResult.ok:
        let closeAfterPrepareError = sqlite.Close(openResult.db)
        closeAfterPrepareError
        return RustCsgStateDbThreadRowError(prepareResult.error)
    let bindTitle = sqlite.BindText(prepareResult.stmt, 1, title)
    if !bindTitle.ok:
        let finalizeAfterTitleBindError = sqlite.Finalize(prepareResult.stmt)
        finalizeAfterTitleBindError
        let closeAfterTitleBindError = sqlite.Close(openResult.db)
        closeAfterTitleBindError
        return RustCsgStateDbThreadRowError(bindTitle.error)
    if cwdFilter != "":
        let bindCwd = sqlite.BindText(prepareResult.stmt, 2, cwdFilter)
        if !bindCwd.ok:
            let finalizeAfterCwdBindError = sqlite.Finalize(prepareResult.stmt)
            finalizeAfterCwdBindError
            let closeAfterCwdBindError = sqlite.Close(openResult.db)
            closeAfterCwdBindError
            return RustCsgStateDbThreadRowError(bindCwd.error)
    let step = sqlite.Step(prepareResult.stmt)
    if !step.row:
        let finalizeAfterStepError = sqlite.Finalize(prepareResult.stmt)
        finalizeAfterStepError
        let closeAfterStepError = sqlite.Close(openResult.db)
        closeAfterStepError
        if step.error != "":
            return RustCsgStateDbThreadRowError(step.error)
        return RustCsgStateDbThreadRowNotFound()
    var result = RustCsgStateDbThreadRowFromStatement(prepareResult.stmt)
    let finalizeStatus = sqlite.Finalize(prepareResult.stmt)
    if !finalizeStatus.ok:
        let closeAfterFinalizeError = sqlite.Close(openResult.db)
        closeAfterFinalizeError
        return RustCsgStateDbThreadRowError(finalizeStatus.error)
    let closeStatus = sqlite.Close(openResult.db)
    if !closeStatus.ok:
        return RustCsgStateDbThreadRowError(closeStatus.error)
    result.ok = true
    return result

