fn RustCsgStateDbInsertThread(dbPath: str,
                              threadId: str,
                              rolloutPath: str,
                              createdAtMs: int64,
                              source: str,
                              modelProvider: str,
                              cwd: str,
                              cliVersion: str,
                              title: str,
                              sandboxPolicy: str,
                              approvalMode: str,
                              firstUserMessage: str): RustCsgStateDbWriteResult =
    var openResult = sqlite.OpenReadwrite(dbPath)
    if !openResult.ok:
        return RustCsgStateDbWriteError(openResult.error)
    var prepareResult = sqlite.Prepare(openResult.db,
                                       "INSERT INTO threads (id, rollout_path, created_at_ms, updated_at_ms, source, model_provider, cwd, cli_version, title, sandbox_policy, approval_mode, tokens_used, first_user_message, archived) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 0, ?, 0)")
    if !prepareResult.ok:
        let closeAfterPrepareError = sqlite.Close(openResult.db)
        closeAfterPrepareError
        return RustCsgStateDbWriteError(prepareResult.error)
    let bindId = sqlite.BindText(prepareResult.stmt, 1, threadId)
    if !bindId.ok:
        let finalizeAfterIdBindError = sqlite.Finalize(prepareResult.stmt)
        finalizeAfterIdBindError
        let closeAfterIdBindError = sqlite.Close(openResult.db)
        closeAfterIdBindError
        return RustCsgStateDbWriteError(bindId.error)
    let bindRolloutPath = sqlite.BindText(prepareResult.stmt, 2, rolloutPath)
    if !bindRolloutPath.ok:
        let finalizeAfterRolloutPathBindError = sqlite.Finalize(prepareResult.stmt)
        finalizeAfterRolloutPathBindError
        let closeAfterRolloutPathBindError = sqlite.Close(openResult.db)
        closeAfterRolloutPathBindError
        return RustCsgStateDbWriteError(bindRolloutPath.error)
    let bindCreated = sqlite.BindInt64(prepareResult.stmt, 3, createdAtMs)
    if !bindCreated.ok:
        let finalizeAfterCreatedBindError = sqlite.Finalize(prepareResult.stmt)
        finalizeAfterCreatedBindError
        let closeAfterCreatedBindError = sqlite.Close(openResult.db)
        closeAfterCreatedBindError
        return RustCsgStateDbWriteError(bindCreated.error)
    let bindUpdated = sqlite.BindInt64(prepareResult.stmt, 4, createdAtMs)
    if !bindUpdated.ok:
        let finalizeAfterUpdatedBindError = sqlite.Finalize(prepareResult.stmt)
        finalizeAfterUpdatedBindError
        let closeAfterUpdatedBindError = sqlite.Close(openResult.db)
        closeAfterUpdatedBindError
        return RustCsgStateDbWriteError(bindUpdated.error)
    let bindSource = sqlite.BindText(prepareResult.stmt, 5, source)
    if !bindSource.ok:
        let finalizeAfterSourceBindError = sqlite.Finalize(prepareResult.stmt)
        finalizeAfterSourceBindError
        let closeAfterSourceBindError = sqlite.Close(openResult.db)
        closeAfterSourceBindError
        return RustCsgStateDbWriteError(bindSource.error)
    let bindProvider = sqlite.BindText(prepareResult.stmt, 6, modelProvider)
    if !bindProvider.ok:
        let finalizeAfterProviderBindError = sqlite.Finalize(prepareResult.stmt)
        finalizeAfterProviderBindError
        let closeAfterProviderBindError = sqlite.Close(openResult.db)
        closeAfterProviderBindError
        return RustCsgStateDbWriteError(bindProvider.error)
    let bindCwd = sqlite.BindText(prepareResult.stmt, 7, cwd)
    if !bindCwd.ok:
        let finalizeAfterCwdBindError = sqlite.Finalize(prepareResult.stmt)
        finalizeAfterCwdBindError
        let closeAfterCwdBindError = sqlite.Close(openResult.db)
        closeAfterCwdBindError
        return RustCsgStateDbWriteError(bindCwd.error)
    let bindCliVersion = sqlite.BindText(prepareResult.stmt, 8, cliVersion)
    if !bindCliVersion.ok:
        let finalizeAfterCliVersionBindError = sqlite.Finalize(prepareResult.stmt)
        finalizeAfterCliVersionBindError
        let closeAfterCliVersionBindError = sqlite.Close(openResult.db)
        closeAfterCliVersionBindError
        return RustCsgStateDbWriteError(bindCliVersion.error)
    let bindTitle = sqlite.BindText(prepareResult.stmt, 9, title)
    if !bindTitle.ok:
        let finalizeAfterTitleBindError = sqlite.Finalize(prepareResult.stmt)
        finalizeAfterTitleBindError
        let closeAfterTitleBindError = sqlite.Close(openResult.db)
        closeAfterTitleBindError
        return RustCsgStateDbWriteError(bindTitle.error)
    let bindSandbox = sqlite.BindText(prepareResult.stmt, 10, sandboxPolicy)
    if !bindSandbox.ok:
        let finalizeAfterSandboxBindError = sqlite.Finalize(prepareResult.stmt)
        finalizeAfterSandboxBindError
        let closeAfterSandboxBindError = sqlite.Close(openResult.db)
        closeAfterSandboxBindError
        return RustCsgStateDbWriteError(bindSandbox.error)
    let bindApproval = sqlite.BindText(prepareResult.stmt, 11, approvalMode)
    if !bindApproval.ok:
        let finalizeAfterApprovalBindError = sqlite.Finalize(prepareResult.stmt)
        finalizeAfterApprovalBindError
        let closeAfterApprovalBindError = sqlite.Close(openResult.db)
        closeAfterApprovalBindError
        return RustCsgStateDbWriteError(bindApproval.error)
    let bindFirstUserMessage = sqlite.BindText(prepareResult.stmt, 12, firstUserMessage)
    if !bindFirstUserMessage.ok:
        let finalizeAfterFirstUserMessageBindError = sqlite.Finalize(prepareResult.stmt)
        finalizeAfterFirstUserMessageBindError
        let closeAfterFirstUserMessageBindError = sqlite.Close(openResult.db)
        closeAfterFirstUserMessageBindError
        return RustCsgStateDbWriteError(bindFirstUserMessage.error)
    let step = sqlite.Step(prepareResult.stmt)
    if !step.done:
        let finalizeAfterStepError = sqlite.Finalize(prepareResult.stmt)
        finalizeAfterStepError
        let closeAfterStepError = sqlite.Close(openResult.db)
        closeAfterStepError
        if step.error != "":
            return RustCsgStateDbWriteError(step.error)
        return RustCsgStateDbWriteError("sqlite thread insert did not complete")
    let finalizeStatus = sqlite.Finalize(prepareResult.stmt)
    if !finalizeStatus.ok:
        let closeAfterFinalizeError = sqlite.Close(openResult.db)
        closeAfterFinalizeError
        return RustCsgStateDbWriteError(finalizeStatus.error)
    let closeStatus = sqlite.Close(openResult.db)
    if !closeStatus.ok:
        return RustCsgStateDbWriteError(closeStatus.error)
    return RustCsgStateDbWriteOk()

fn RustCsgStateDbUpdateThreadTitle(dbPath: str,
                                   threadId: str,
                                   title: str,
                                   updatedAtMs: int64): RustCsgStateDbWriteResult =
    let existing = RustCsgStateDbThreadById(dbPath, threadId)
    if !existing.ok:
        if existing.notFound:
            return RustCsgStateDbWriteNotFound()
        return RustCsgStateDbWriteError(existing.error)

    var openResult = sqlite.OpenReadwrite(dbPath)
    if !openResult.ok:
        return RustCsgStateDbWriteError(openResult.error)
    var prepareResult = sqlite.Prepare(openResult.db,
                                       "UPDATE threads SET title = ?, updated_at_ms = ? WHERE id = ? AND archived = 0")
    if !prepareResult.ok:
        let closeAfterPrepareError = sqlite.Close(openResult.db)
        closeAfterPrepareError
        return RustCsgStateDbWriteError(prepareResult.error)
    let bindTitle = sqlite.BindText(prepareResult.stmt, 1, title)
    if !bindTitle.ok:
        let finalizeAfterTitleBindError = sqlite.Finalize(prepareResult.stmt)
        finalizeAfterTitleBindError
        let closeAfterTitleBindError = sqlite.Close(openResult.db)
        closeAfterTitleBindError
        return RustCsgStateDbWriteError(bindTitle.error)
    let bindUpdated = sqlite.BindInt64(prepareResult.stmt, 2, updatedAtMs)
    if !bindUpdated.ok:
        let finalizeAfterUpdatedBindError = sqlite.Finalize(prepareResult.stmt)
        finalizeAfterUpdatedBindError
        let closeAfterUpdatedBindError = sqlite.Close(openResult.db)
        closeAfterUpdatedBindError
        return RustCsgStateDbWriteError(bindUpdated.error)
    let bindId = sqlite.BindText(prepareResult.stmt, 3, threadId)
    if !bindId.ok:
        let finalizeAfterIdBindError = sqlite.Finalize(prepareResult.stmt)
        finalizeAfterIdBindError
        let closeAfterIdBindError = sqlite.Close(openResult.db)
        closeAfterIdBindError
        return RustCsgStateDbWriteError(bindId.error)
    let step = sqlite.Step(prepareResult.stmt)
    if !step.done:
        let finalizeAfterStepError = sqlite.Finalize(prepareResult.stmt)
        finalizeAfterStepError
        let closeAfterStepError = sqlite.Close(openResult.db)
        closeAfterStepError
        if step.error != "":
            return RustCsgStateDbWriteError(step.error)
        return RustCsgStateDbWriteError("sqlite thread title update did not complete")
    let finalizeStatus = sqlite.Finalize(prepareResult.stmt)
    if !finalizeStatus.ok:
        let closeAfterFinalizeError = sqlite.Close(openResult.db)
        closeAfterFinalizeError
        return RustCsgStateDbWriteError(finalizeStatus.error)
    let closeStatus = sqlite.Close(openResult.db)
    if !closeStatus.ok:
        return RustCsgStateDbWriteError(closeStatus.error)
    return RustCsgStateDbWriteOk()

fn RustCsgStateDbArchiveThread(dbPath: str,
