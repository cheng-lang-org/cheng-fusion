fn RustCsgStateDbThreadModelByIdIncludingArchived(dbPath: str, threadId: str): RustCsgStateDbStringResult =
    var openResult = sqlite.OpenReadonly(dbPath)
    if !openResult.ok:
        return RustCsgStateDbStringError(openResult.error)
    var prepareResult = sqlite.Prepare(openResult.db,
                                       "SELECT model, model IS NOT NULL FROM threads WHERE threads.id = ? ORDER BY threads.updated_at_ms DESC LIMIT 1")
    if !prepareResult.ok:
        let closeAfterPrepareError = sqlite.Close(openResult.db)
        closeAfterPrepareError
        return RustCsgStateDbStringError(prepareResult.error)
    let bindId = sqlite.BindText(prepareResult.stmt, 1, threadId)
    if !bindId.ok:
        let finalizeAfterBindError = sqlite.Finalize(prepareResult.stmt)
        finalizeAfterBindError
        let closeAfterBindError = sqlite.Close(openResult.db)
        closeAfterBindError
        return RustCsgStateDbStringError(bindId.error)
    let step = sqlite.Step(prepareResult.stmt)
    if !step.row:
        let finalizeAfterStepError = sqlite.Finalize(prepareResult.stmt)
        finalizeAfterStepError
        let closeAfterStepError = sqlite.Close(openResult.db)
        closeAfterStepError
        if step.error != "":
            return RustCsgStateDbStringError(step.error)
        return RustCsgStateDbStringNotFound()
    var result: RustCsgStateDbStringResult
    result.value = sqlite.ColumnText(prepareResult.stmt, 0)
    result.present = sqlite.ColumnInt64(prepareResult.stmt, 1) != 0
    let finalizeStatus = sqlite.Finalize(prepareResult.stmt)
    if !finalizeStatus.ok:
        let closeAfterFinalizeError = sqlite.Close(openResult.db)
        closeAfterFinalizeError
        return RustCsgStateDbStringError(finalizeStatus.error)
    let closeStatus = sqlite.Close(openResult.db)
    if !closeStatus.ok:
        return RustCsgStateDbStringError(closeStatus.error)
    result.ok = true
    return result

