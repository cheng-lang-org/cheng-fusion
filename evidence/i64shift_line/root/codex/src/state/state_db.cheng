import cheng/codex/config/home
import cheng/codex/protocol/wire

const
    RustCsgSqliteHomeEnv: str = "CODEX_SQLITE_HOME"
    RustCsgStateDbFile: str = "state_5.sqlite"
    RustCsgStateDbBlockedReason: str = "SQLite state DB queries are not ported; this boundary only exposes Rust state_db_filename/state_db_path and sqlite_home selection."

type
    RustCsgSqliteHomeResult =
        path: str
        error: str

    RustCsgStateDbThreadListQueryPlan =
        dbPath: str
        sql: str
        bindsJson: str
        scanLimit: int32
        sortColumn: str
        orderDirection: str
        sourceKindPostFilterJson: str
        parseError: str
        blockedReason: str

fn RustCsgAsciiSpace(ch: char): bool =
    return ch == ' ' || ch == '\n' || ch == '\r' || ch == '\t'

fn RustCsgTrimAsciiSpace(text: str): str =
    var start: int32
    var end: int32
    end = text.len
    while start < end && RustCsgAsciiSpace(text[start]):
        start = start + 1
    while end > start && RustCsgAsciiSpace(text[end - 1]):
        end = end - 1
    return wire.RustCsgSliceBytes(text, start, end - start)

fn RustCsgStateDbJoinChild(parent: str, child: str): str =
    if parent == "":
        return child
    if parent[parent.len - 1] == '/':
        return wire.RustCsgCat(parent, child)
    return wire.RustCsgCat(wire.RustCsgCat(parent, "/"), child)

fn RustCsgStateDbFilename(): str =
    return RustCsgStateDbFile

fn RustCsgStateDbPath(sqliteHome: str): str =
    return RustCsgStateDbJoinChild(sqliteHome, RustCsgStateDbFilename())

fn RustCsgStateDbQueryBlockedReason(): str =
    return RustCsgStateDbBlockedReason

fn RustCsgStateDbThreadSelectColumns(): str =
    return "SELECT threads.id, threads.rollout_path, threads.created_at_ms AS created_at, threads.updated_at_ms AS updated_at, threads.source, threads.agent_nickname, threads.agent_role, threads.agent_path, threads.model_provider, threads.model, threads.reasoning_effort, threads.cwd, threads.cli_version, threads.title, threads.sandbox_policy, threads.approval_mode, threads.tokens_used, threads.first_user_message, threads.archived_at, threads.git_sha, threads.git_branch, threads.git_origin_url FROM threads"

fn RustCsgStateDbSortColumn(sortKey: str, outError: var str): str =
    outError = ""
    if sortKey == "created_at":
        return "threads.created_at_ms"
    if sortKey == "updated_at":
        return "threads.updated_at_ms"
    outError = wire.RustCsgCat("invalid state db thread sort key: ", sortKey)
    return ""

fn RustCsgStateDbOrderDirection(sortDirection: str, outError: var str): str =
    outError = ""
    if sortDirection == "asc":
        return "ASC"
    if sortDirection == "desc":
        return "DESC"
    outError = wire.RustCsgCat("invalid state db thread sort direction: ", sortDirection)
    return ""

fn RustCsgStateDbArchivedInt(archived: bool): int32 =
    if archived:
        return 1
    return 0

fn RustCsgStateDbPlaceholders(count: int32): str =
    var out = "("
    for i in 0..<count:
        if i > 0:
            out = wire.RustCsgCat(out, ", ")
        out = wire.RustCsgCat(out, "?")
    out = wire.RustCsgCat(out, ")")
    return out

fn RustCsgStateDbInClause(column: str, count: int32): str =
    if count <= 0:
        return ""
    return wire.RustCsgCat4(" AND ", column, " IN ", RustCsgStateDbPlaceholders(count))

fn RustCsgStateDbSimpleJsonString(raw: str, outError: var str): str =
    outError = ""
    let text = RustCsgTrimAsciiSpace(raw)
    if text.len < 2 || text[0] != '"' || text[text.len - 1] != '"':
        outError = wire.RustCsgCat("expected JSON string: ", raw)
        return ""
    var i: int32
    i = 1
    while i < text.len - 1:
        if text[i] == '\\':
            outError = "escaped thread/list cwd filters are not ported"
            return ""
        i = i + 1
    return wire.RustCsgSliceBytes(text, 1, text.len - 2)

fn RustCsgStateDbNormalizeCwdFilter(cwd: str, resolvedCwd: str, outError: var str): str =
    outError = ""
    if cwd == "":
        outError = "empty thread/list cwd filter"
        return ""
    if home.RustCsgPathIsAbsolute(cwd):
        return cwd
    if resolvedCwd == "":
        outError = wire.RustCsgCat("relative thread/list cwd filter requires resolved cwd: ", cwd)
        return ""
    if !home.RustCsgPathIsAbsolute(resolvedCwd):
        outError = wire.RustCsgCat("resolved cwd is not absolute for thread/list cwd filter: ", resolvedCwd)
        return ""
    return RustCsgStateDbJoinChild(resolvedCwd, cwd)

fn RustCsgStateDbStringArrayFromOptionalRaw(raw: str): str[] =
    var empty: str[]
    let text = RustCsgTrimAsciiSpace(raw)
    if text == "" || text == "null":
        return empty
    return wire.RustCsgJsonStringArrayFromRaw(text)

fn RustCsgStateDbCwdFiltersFromRaw(raw: str, resolvedCwd: str, outError: var str): str[] =
    var out: str[]
    outError = ""
    let text = RustCsgTrimAsciiSpace(raw)
    if text == "" || text == "null":
        return out
    if text == "[]":
        return out
    if text[0] == '"':
        let value = RustCsgStateDbSimpleJsonString(text, outError)
        if outError != "":
            return out
        let normalized = RustCsgStateDbNormalizeCwdFilter(value, resolvedCwd, outError)
        if outError != "":
            return out
        add(out, normalized)
        return out
    if text[0] == '[':
        let values = wire.RustCsgJsonStringArrayFromRaw(text)
        for i in 0..<values.len:
            let normalized = RustCsgStateDbNormalizeCwdFilter(values[i], resolvedCwd, outError)
            if outError != "":
                return out
            add(out, normalized)
        return out
    outError = wire.RustCsgCat("invalid thread/list cwd filter JSON: ", raw)
    return out

fn RustCsgStateDbBuildThreadListSql(sortColumn: str,
                                    orderDirection: str,
                                    allowedSourceCount: int32,
                                    modelProviderCount: int32,
                                    cwdFilterCount: int32,
                                    cwdExplicitEmpty: bool,
                                    hasSearchTerm: bool,
                                    scanLimit: int32): str =
    var sql = RustCsgStateDbThreadSelectColumns()
    sql = wire.RustCsgCat(sql, " WHERE 1 = 1")
    sql = wire.RustCsgCat(sql, " AND threads.archived = ?")
    sql = wire.RustCsgCat(sql, " AND threads.first_user_message <> ''")
    sql = wire.RustCsgCat(sql, RustCsgStateDbInClause("threads.source", allowedSourceCount))
    sql = wire.RustCsgCat(sql, RustCsgStateDbInClause("threads.model_provider", modelProviderCount))
    if cwdExplicitEmpty:
        sql = wire.RustCsgCat(sql, " AND 1 = 0")
    else:
        sql = wire.RustCsgCat(sql, RustCsgStateDbInClause("threads.cwd", cwdFilterCount))
    if hasSearchTerm:
        sql = wire.RustCsgCat(sql, " AND instr(threads.title, ?) > 0")
    sql = wire.RustCsgCat(sql, " ORDER BY ")
    sql = wire.RustCsgCat(sql, sortColumn)
    sql = wire.RustCsgCat(sql, " ")
    sql = wire.RustCsgCat(sql, orderDirection)
    sql = wire.RustCsgCat(sql, " LIMIT ?")
    return sql

fn RustCsgStateDbThreadListBindsJson(archived: bool,
                                     allowedSources: str[],
                                     modelProviders: str[],
                                     cwdFilters: str[],
                                     cwdExplicitEmpty: bool,
                                     searchTerm: str,
                                     scanLimit: int32,
                                     sourceKindPostFilterJson: str): str =
    var cwdJson = wire.RustCsgJsonStringArray(cwdFilters)
    if cwdExplicitEmpty:
        cwdJson = "[]"
    var postFilterJson = sourceKindPostFilterJson
    if postFilterJson == "":
        postFilterJson = "null"
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("archived", RustCsgStateDbArchivedInt(archived)))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("allowedSources", wire.RustCsgJsonStringArray(allowedSources)))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("modelProviders", wire.RustCsgJsonStringArray(modelProviders)))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("cwdFilters", cwdJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("cwdExplicitEmpty", cwdExplicitEmpty))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("searchTerm", searchTerm))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("scanLimit", scanLimit))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("sourceKindPostFilter", postFilterJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgStateDbThreadListQueryPlanFromValues(sqliteHome: str,
                                               pageSize: int32,
                                               sortKey: str,
                                               sortDirection: str,
                                               allowedSourcesJson: str,
                                               modelProvidersJson: str,
                                               cwdFiltersJson: str,
                                               searchTerm: str,
                                               cursor: str,
                                               archived: bool,
                                               sourceKindPostFilterJson: str,
                                               resolvedCwd: str): RustCsgStateDbThreadListQueryPlan =
    var result: RustCsgStateDbThreadListQueryPlan
    result.dbPath = RustCsgStateDbPath(sqliteHome)
    result.blockedReason = RustCsgStateDbQueryBlockedReason()
    if pageSize < 1:
        result.parseError = "state db thread/list page size must be positive"
        return result
    if cursor != "":
        result.parseError = "thread/list cursor timestamp parsing is not ported"
        return result
    var err: str
    result.sortColumn = RustCsgStateDbSortColumn(sortKey, err)
    if err != "":
        result.parseError = err
        return result
    result.orderDirection = RustCsgStateDbOrderDirection(sortDirection, err)
    if err != "":
        result.parseError = err
        return result
    let allowedSources = RustCsgStateDbStringArrayFromOptionalRaw(allowedSourcesJson)
    let modelProviders = RustCsgStateDbStringArrayFromOptionalRaw(modelProvidersJson)
    let cwdTrimmed = RustCsgTrimAsciiSpace(cwdFiltersJson)
    let cwdExplicitEmpty = cwdTrimmed == "[]"
    let cwdFilters = RustCsgStateDbCwdFiltersFromRaw(cwdFiltersJson, resolvedCwd, err)
    if err != "":
        result.parseError = err
        return result
    result.scanLimit = pageSize + 1
    result.sourceKindPostFilterJson = sourceKindPostFilterJson
    result.sql = RustCsgStateDbBuildThreadListSql(result.sortColumn,
                                                  result.orderDirection,
                                                  allowedSources.len,
                                                  modelProviders.len,
                                                  cwdFilters.len,
                                                  cwdExplicitEmpty,
                                                  searchTerm != "",
                                                  result.scanLimit)
    result.bindsJson = RustCsgStateDbThreadListBindsJson(archived,
                                                         allowedSources,
                                                         modelProviders,
                                                         cwdFilters,
                                                         cwdExplicitEmpty,
                                                         searchTerm,
                                                         result.scanLimit,
                                                         sourceKindPostFilterJson)
    return result

fn RustCsgStateDbThreadListQueryPlanToJson(plan: var RustCsgStateDbThreadListQueryPlan): str =
    var bindsJson = plan.bindsJson
    if bindsJson == "":
        bindsJson = "null"
    var postFilterJson = plan.sourceKindPostFilterJson
    if postFilterJson == "":
        postFilterJson = "null"
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("dbPath", plan.dbPath))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("sql", plan.sql))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("binds", bindsJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("scanLimit", plan.scanLimit))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("sortColumn", plan.sortColumn))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("orderDirection", plan.orderDirection))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("sourceKindPostFilter", postFilterJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("parseError", plan.parseError))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("blockedReason", plan.blockedReason))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgResolveSqliteHomeFromValues(configSqliteHome: str,
                                      sqliteHomeEnv: str,
                                      codexHome: str,
                                      resolvedCwd: str): RustCsgSqliteHomeResult =
    var result: RustCsgSqliteHomeResult
    if configSqliteHome != "":
        result.path = configSqliteHome
        return result
    let trimmedEnv = RustCsgTrimAsciiSpace(sqliteHomeEnv)
    if trimmedEnv != "":
        if home.RustCsgPathIsAbsolute(trimmedEnv):
            result.path = trimmedEnv
            return result
        if resolvedCwd == "":
            result.error = "resolved cwd is empty for relative CODEX_SQLITE_HOME"
            return result
        result.path = RustCsgStateDbJoinChild(resolvedCwd, trimmedEnv)
        return result
    if codexHome == "":
        result.error = "codex home is empty"
        return result
    result.path = codexHome
    return result

fn RustCsgResolveSqliteHome(configSqliteHome: str, resolvedCwd: str): RustCsgSqliteHomeResult =
    var result: RustCsgSqliteHomeResult
    var codexHomePath: str
    var homeError: str
    home.RustCsgFindCodexHomeInto(codexHomePath, homeError)
    if homeError != "":
        result.error = homeError
        return result
    return RustCsgResolveSqliteHomeFromValues(configSqliteHome,
                                             home.RustCsgGetEnv(RustCsgSqliteHomeEnv),
                                             codexHomePath,
                                             resolvedCwd)

# ── Standalone thread-list query builder ──────────────────────────────────
#
# Builds a complete SQL query string from a JSON filter object, sort key,
# sort direction, and limit. Returns "" and sets outError on failure.
#
# filterJson JSON schema (all fields optional):
#   { "archived": bool,
#     "allowedSources": str[],
#     "modelProviders": str[],
#     "cwdFilters": str[],
#     "searchTerm": str }
#
# sortKey: "created_at" | "updated_at"
# sortDir: "asc" | "desc"
# limit: positive int32

fn RustCsgStateDbBuildThreadListQuery(filterJson: str,
                                       sortKey: str,
                                       sortDir: str,
                                       limit: int32,
                                       outError: var str): str =
    outError = ""
    if limit < 1:
        outError = "limit must be positive"
        return ""
    # Parse filter fields (all optional)
    var archived = false
    if wire.RustCsgContains(filterJson, "\"archived\""):
        archived = wire.RustCsgJsonFindBool(filterJson, "archived")
    var allowedSourcesRaw = wire.RustCsgJsonFindOptionalArray(filterJson, "allowedSources")
    var modelProvidersRaw = wire.RustCsgJsonFindOptionalArray(filterJson, "modelProviders")
    var cwdFiltersRaw = wire.RustCsgJsonFindOptionalArray(filterJson, "cwdFilters")
    var searchTerm = wire.RustCsgJsonFindOptionalStr(filterJson, "searchTerm")
    var allowedSources: str[]
    if allowedSourcesRaw != "":
        if allowedSourcesRaw != "null":
            allowedSources = wire.RustCsgJsonStringArrayFromRaw(allowedSourcesRaw)
    var modelProviders: str[]
    if modelProvidersRaw != "":
        if modelProvidersRaw != "null":
            modelProviders = wire.RustCsgJsonStringArrayFromRaw(modelProvidersRaw)
    var cwdFilters: str[]
    var cwdExplicitEmpty = false
    if cwdFiltersRaw != "":
        if cwdFiltersRaw == "[]":
            cwdExplicitEmpty = true
        elif cwdFiltersRaw != "null":
            cwdFilters = wire.RustCsgJsonStringArrayFromRaw(cwdFiltersRaw)
    # Build SQL
    var sql = RustCsgStateDbThreadSelectColumns()
    sql = wire.RustCsgCat(sql, " WHERE 1 = 1")
    sql = wire.RustCsgCat(sql, " AND threads.archived = ?")
    sql = wire.RustCsgCat(sql, " AND threads.first_user_message <> ''")
    if allowedSources.len > 0:
        sql = wire.RustCsgCat(sql, RustCsgStateDbInClause("threads.source", allowedSources.len))
    if modelProviders.len > 0:
        sql = wire.RustCsgCat(sql, RustCsgStateDbInClause("threads.model_provider", modelProviders.len))
    if cwdExplicitEmpty:
        sql = wire.RustCsgCat(sql, " AND 1 = 0")
    elif cwdFilters.len > 0:
        sql = wire.RustCsgCat(sql, RustCsgStateDbInClause("threads.cwd", cwdFilters.len))
    if searchTerm != "":
        sql = wire.RustCsgCat(sql, " AND instr(threads.title, ?) > 0")
    # ORDER BY + LIMIT
    var err: str
    let sortColumn = RustCsgStateDbSortColumn(sortKey, err)
    if err != "":
        outError = err
        return ""
    let orderDirection = RustCsgStateDbOrderDirection(sortDir, err)
    if err != "":
        outError = err
        return ""
    sql = wire.RustCsgCat(sql, " ORDER BY ")
    sql = wire.RustCsgCat(sql, sortColumn)
    sql = wire.RustCsgCat(sql, " ")
    sql = wire.RustCsgCat(sql, orderDirection)
    sql = wire.RustCsgCat(sql, " LIMIT ?")
    return sql
