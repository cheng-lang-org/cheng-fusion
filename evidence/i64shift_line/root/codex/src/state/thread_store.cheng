import cheng/codex/config/home
import cheng/codex/protocol/types
import cheng/codex/protocol/wire

const
    RustCsgSessionIndexFile: str = "session_index.jsonl"

fn RustCsgSessionIndexEntryToJson(entry: types.RustCsgSessionIndexEntry): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("id", entry.id))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("thread_name", entry.threadName))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("updated_at", entry.updatedAt))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgSessionIndexEntryFromJson(text: str): types.RustCsgSessionIndexEntry =
    var result: types.RustCsgSessionIndexEntry
    result.id = wire.RustCsgJsonFindStr(text, "id")
    result.threadName = wire.RustCsgJsonFindStr(text, "thread_name")
    result.updatedAt = wire.RustCsgJsonFindStr(text, "updated_at")
    return result

fn RustCsgSessionIndexPath(codexHome: str): str =
    if codexHome == "":
        return RustCsgSessionIndexFile
    if codexHome[codexHome.len - 1] == '/':
        return wire.RustCsgCat(codexHome, RustCsgSessionIndexFile)
    return wire.RustCsgCat(wire.RustCsgCat(codexHome, "/"), RustCsgSessionIndexFile)

fn RustCsgSessionIndexLineLooksParseable(line: str): bool =
    if line == "":
        return false
    if !wire.RustCsgContains(line, "\"id\""):
        return false
    if !wire.RustCsgContains(line, "\"thread_name\""):
        return false
    return wire.RustCsgContains(line, "\"updated_at\"")

fn RustCsgSessionIndexEntryEmpty(entry: types.RustCsgSessionIndexEntry): bool =
    return entry.id == "" && entry.threadName == "" && entry.updatedAt == ""

fn RustCsgSessionIndexParseLine(line: str): types.RustCsgSessionIndexEntry =
    var empty: types.RustCsgSessionIndexEntry
    if !RustCsgSessionIndexLineLooksParseable(line):
        return empty
    let entry = RustCsgSessionIndexEntryFromJson(line)
    if entry.id == "" || entry.updatedAt == "":
        return empty
    return entry

fn RustCsgSessionIndexClearEntry(entry: var types.RustCsgSessionIndexEntry) =
    entry.id = ""
    entry.threadName = ""
    entry.updatedAt = ""

fn RustCsgSessionIndexParseLineInto(line: str, entry: var types.RustCsgSessionIndexEntry) =
    RustCsgSessionIndexClearEntry(entry)
    if !RustCsgSessionIndexLineLooksParseable(line):
        return
    entry.id = wire.RustCsgJsonFindStr(line, "id")
    entry.threadName = wire.RustCsgJsonFindStr(line, "thread_name")
    entry.updatedAt = wire.RustCsgJsonFindStr(line, "updated_at")
    if entry.id == "" || entry.updatedAt == "":
        RustCsgSessionIndexClearEntry(entry)

fn RustCsgSessionIndexSeenId(seenIds: str[], id: str): bool =
    for i in 0..<seenIds.len:
        if seenIds[i] == id:
            return true
    return false

fn RustCsgSessionIndexAppendEntry(entry: types.RustCsgSessionIndexEntry,
                                  outIds: var str[],
                                  outNames: var str[],
                                  outUpdateds: var str[]) =
    if RustCsgSessionIndexEntryEmpty(entry):
        return
    add(outIds, entry.id)
    add(outNames, entry.threadName)
    add(outUpdateds, entry.updatedAt)

fn RustCsgSessionIndexParseLines(text: str,
                                 outIds: var str[],
                                 outNames: var str[],
                                 outUpdateds: var str[]) =
    var lineStart: int32
    var pos: int32
    while pos < text.len:
        if text[pos] == '\n':
            if pos > lineStart:
                let line = wire.RustCsgSliceBytes(text, lineStart, pos - lineStart)
                RustCsgSessionIndexAppendEntry(RustCsgSessionIndexParseLine(line),
                                               outIds,
                                               outNames,
                                               outUpdateds)
            lineStart = pos + 1
        pos = pos + 1
    if lineStart < text.len:
        let line = wire.RustCsgSliceBytes(text, lineStart, text.len - lineStart)
        RustCsgSessionIndexAppendEntry(RustCsgSessionIndexParseLine(line),
                                       outIds,
                                       outNames,
                                       outUpdateds)

fn RustCsgSessionIndexEntryFromArrays(ids: str[],
                                      names: str[],
                                      updateds: str[],
                                      index: int32): types.RustCsgSessionIndexEntry =
    var result: types.RustCsgSessionIndexEntry
    result.id = ids[index]
    result.threadName = names[index]
    result.updatedAt = updateds[index]
    return result

fn RustCsgSessionIndexMakeEntry(id: str,
                                name: str,
                                updated: str): types.RustCsgSessionIndexEntry =
    var result: types.RustCsgSessionIndexEntry
    result.id = id
    result.threadName = name
    result.updatedAt = updated
    return result

fn RustCsgSessionIndexLoadText(codexHome: str, outError: var str): str =
    outError = ""
    if codexHome == "":
        outError = "codex home is empty"
        return ""
    var path: str
    if codexHome[codexHome.len - 1] == '/':
        path = wire.RustCsgCat(codexHome, RustCsgSessionIndexFile)
    else:
        path = wire.RustCsgCat(wire.RustCsgCat(codexHome, "/"), RustCsgSessionIndexFile)
    let metadataKind = home.RustCsgPathMetadataKind(path)
    if metadataKind == 0:
        return ""
    if metadataKind == 1:
        outError = wire.RustCsgCat("session_index.jsonl path is not a file: ", path)
        return ""
    if metadataKind < 0:
        outError = wire.RustCsgCat("failed to read session_index.jsonl metadata: ", path)
        return ""
    return home.RustCsgReadFile(path)

fn RustCsgSessionIndexLoadTextInto(codexHome: str, outText: var str, outError: var str) =
    outText = ""
    outError = ""
    if codexHome == "":
        outError = "codex home is empty"
        return
    var path: str
    if codexHome[codexHome.len - 1] == '/':
        path = wire.RustCsgCat(codexHome, RustCsgSessionIndexFile)
    else:
        path = wire.RustCsgCat(wire.RustCsgCat(codexHome, "/"), RustCsgSessionIndexFile)
    let metadataKind = home.RustCsgPathMetadataKind(path)
    if metadataKind == 0:
        return
    if metadataKind == 1:
        outError = wire.RustCsgCat("session_index.jsonl path is not a file: ", path)
        return
    if metadataKind < 0:
        outError = wire.RustCsgCat("failed to read session_index.jsonl metadata: ", path)
        return
    outText = home.RustCsgReadFile(path)

fn RustCsgSessionIndexFindLatestByIdInto(codexHome: str,
                                         threadId: str,
                                         outEntry: var types.RustCsgSessionIndexEntry,
                                         outError: var str) =
    outEntry.id = ""
    outEntry.threadName = ""
    outEntry.updatedAt = ""
    var text: str
    RustCsgSessionIndexLoadTextInto(codexHome, text, outError)
    if outError != "" || text == "" || threadId == "":
        return
    var lineStart: int32
    var pos: int32
    while pos < text.len:
        if text[pos] == '\n':
            if pos > lineStart:
                let line = wire.RustCsgSliceBytes(text, lineStart, pos - lineStart)
                var entry: types.RustCsgSessionIndexEntry
                RustCsgSessionIndexParseLineInto(line, entry)
                if entry.id == threadId:
                    outEntry.id = entry.id
                    outEntry.threadName = entry.threadName
                    outEntry.updatedAt = entry.updatedAt
            lineStart = pos + 1
        pos = pos + 1
    if lineStart < text.len:
        let line = wire.RustCsgSliceBytes(text, lineStart, text.len - lineStart)
        var entry: types.RustCsgSessionIndexEntry
        RustCsgSessionIndexParseLineInto(line, entry)
        if entry.id == threadId:
            outEntry.id = entry.id
            outEntry.threadName = entry.threadName
            outEntry.updatedAt = entry.updatedAt

fn RustCsgSessionIndexFindLatestInto(codexHome: str,
                                     outEntry: var types.RustCsgSessionIndexEntry,
                                     outError: var str) =
    outEntry.id = ""
    outEntry.threadName = ""
    outEntry.updatedAt = ""
    var text: str
    RustCsgSessionIndexLoadTextInto(codexHome, text, outError)
    if outError != "" || text == "":
        return
    var lineStart: int32
    var pos: int32
    while pos < text.len:
        if text[pos] == '\n':
            if pos > lineStart:
                let line = wire.RustCsgSliceBytes(text, lineStart, pos - lineStart)
                var entry: types.RustCsgSessionIndexEntry
                RustCsgSessionIndexParseLineInto(line, entry)
                if entry.id != "":
                    outEntry.id = entry.id
                    outEntry.threadName = entry.threadName
                    outEntry.updatedAt = entry.updatedAt
            lineStart = pos + 1
        pos = pos + 1
    if lineStart < text.len:
        let line = wire.RustCsgSliceBytes(text, lineStart, text.len - lineStart)
        var entry: types.RustCsgSessionIndexEntry
        RustCsgSessionIndexParseLineInto(line, entry)
        if entry.id != "":
