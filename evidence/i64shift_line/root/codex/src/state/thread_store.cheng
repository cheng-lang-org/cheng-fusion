fn RustCsgSessionIndexFindLatestByName(codexHome: str,
                                       threadName: str,
                                       outError: var str): types.RustCsgSessionIndexEntry =
    var empty: types.RustCsgSessionIndexEntry
    var text: str
    RustCsgSessionIndexLoadTextInto(codexHome, text, outError)
    if outError != "" || text == "" || threadName == "":
        return empty
    var matched: types.RustCsgSessionIndexEntry
    var lineStart: int32
    var pos: int32
    while pos < text.len:
        if text[pos] == '\n':
            if pos > lineStart:
                let line = wire.RustCsgSliceBytes(text, lineStart, pos - lineStart)
                var entry: types.RustCsgSessionIndexEntry
                RustCsgSessionIndexParseLineInto(line, entry)
                if entry.id != "":
                    if entry.threadName == threadName:
                        matched.id = entry.id
                        matched.threadName = entry.threadName
                        matched.updatedAt = entry.updatedAt
                    elif matched.id != "" && entry.id == matched.id:
                        matched.id = ""
                        matched.threadName = ""
                        matched.updatedAt = ""
            lineStart = pos + 1
        pos = pos + 1
    if lineStart < text.len:
        let line = wire.RustCsgSliceBytes(text, lineStart, text.len - lineStart)
        var entry: types.RustCsgSessionIndexEntry
        RustCsgSessionIndexParseLineInto(line, entry)
        if entry.id != "":
            if entry.threadName == threadName:
                matched.id = entry.id
                matched.threadName = entry.threadName
                matched.updatedAt = entry.updatedAt
            elif matched.id != "" && entry.id == matched.id:
                matched.id = ""
                matched.threadName = ""
                matched.updatedAt = ""
    if RustCsgSessionIndexEntryEmpty(matched):
        return empty
    return matched

# ── Thread metadata type and merge logic ──────────────────────────────────
#
# RustCsgThreadMetadata holds the mutable user-visible fields of a thread.
# mergeThreadMetadata merges two sets: the update's non-empty fields take
# precedence; empty fields in update fall back to the existing value.

type
    RustCsgThreadMetadata =
        title: str
        cwd: str
        status: str

fn RustCsgMergeThreadMetadata(existing: RustCsgThreadMetadata,
                               update: RustCsgThreadMetadata): RustCsgThreadMetadata =
    var result: RustCsgThreadMetadata
    if update.title != "":
        result.title = update.title
    else:
        result.title = existing.title
    if update.cwd != "":
        result.cwd = update.cwd
    else:
        result.cwd = existing.cwd
    if update.status != "":
        result.status = update.status
    else:
        result.status = existing.status
    return result

# ── Thread store merge/diff (parallel arrays) ────────────────────────────

fn RustCsgThreadStoreMerge(
    sourceIds: str[], sourceData: str[],
    targetIds: str[], targetData: str[],
    outIds: var str[], outData: var str[]
) =
    for i in 0..<sourceIds.len:
        add(outIds, sourceIds[i])
        add(outData, sourceData[i])
    for i in 0..<targetIds.len:
        var found: bool
        for j in 0..<outIds.len:
            if outIds[j] == targetIds[i]:
                outData[j] = targetData[i]
                found = true
                break
        if !found:
            add(outIds, targetIds[i])
            add(outData, targetData[i])

fn RustCsgThreadStoreDiff(
    aIds: str[], aData: str[],
    bIds: str[],
    outIds: var str[], outData: var str[]
) =
    for i in 0..<aIds.len:
        var found: bool
        for j in 0..<bIds.len:
            if aIds[i] == bIds[j]:
                found = true
                break
        if !found:
            add(outIds, aIds[i])
            add(outData, aData[i])
