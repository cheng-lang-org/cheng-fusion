            outEntry.threadName = entry.threadName
            outEntry.updatedAt = entry.updatedAt

fn RustCsgSessionIndexFindLatestFieldsInto(codexHome: str,
                                           outId: var str,
                                           outName: var str,
                                           outUpdated: var str,
                                           outError: var str) =
    outId = ""
    outName = ""
    outUpdated = ""
    var text: str
    RustCsgSessionIndexLoadTextInto(codexHome, text, outError)
    if outError != "" || text == "":
        return
    var lineStart: int32
    var pos: int32
    while pos < text.len:
        if text[pos] == '\n':
            if pos > lineStart:
                let line = wire.RustCsgSliceBytes(text, lineStart, pos - lineStart)
                let id = wire.RustCsgJsonFindStr(line, "id")
                let updated = wire.RustCsgJsonFindStr(line, "updated_at")
                if id != "" && updated != "":
                    outId = id
                    outName = wire.RustCsgJsonFindStr(line, "thread_name")
                    outUpdated = updated
            lineStart = pos + 1
        pos = pos + 1
    if lineStart < text.len:
        let line = wire.RustCsgSliceBytes(text, lineStart, text.len - lineStart)
        let id = wire.RustCsgJsonFindStr(line, "id")
        let updated = wire.RustCsgJsonFindStr(line, "updated_at")
        if id != "" && updated != "":
            outId = id
            outName = wire.RustCsgJsonFindStr(line, "thread_name")
            outUpdated = updated

fn RustCsgSessionIndexFindLatestByIdFieldsInto(codexHome: str,
                                               threadId: str,
                                               outId: var str,
                                               outName: var str,
                                               outUpdated: var str,
                                               outError: var str) =
    outId = ""
    outName = ""
    outUpdated = ""
    var text: str
    RustCsgSessionIndexLoadTextInto(codexHome, text, outError)
    if outError != "" || text == "" || threadId == "":
        return
    var lineStart: int32
    var pos: int32
    while pos < text.len:
        if text[pos] == '\n':
            if pos > lineStart:
                let line = wire.RustCsgSliceBytes(text, lineStart, pos - lineStart)
                let id = wire.RustCsgJsonFindStr(line, "id")
                let updated = wire.RustCsgJsonFindStr(line, "updated_at")
                if id == threadId && updated != "":
                    outId = id
                    outName = wire.RustCsgJsonFindStr(line, "thread_name")
                    outUpdated = updated
            lineStart = pos + 1
        pos = pos + 1
    if lineStart < text.len:
        let line = wire.RustCsgSliceBytes(text, lineStart, text.len - lineStart)
        let id = wire.RustCsgJsonFindStr(line, "id")
        let updated = wire.RustCsgJsonFindStr(line, "updated_at")
        if id == threadId && updated != "":
            outId = id
            outName = wire.RustCsgJsonFindStr(line, "thread_name")
            outUpdated = updated

fn RustCsgSessionIndexFindLatestByNameFieldsInto(codexHome: str,
                                                 threadName: str,
                                                 outId: var str,
                                                 outName: var str,
                                                 outUpdated: var str,
                                                 outError: var str) =
    outId = ""
    outName = ""
    outUpdated = ""
    var text: str
    RustCsgSessionIndexLoadTextInto(codexHome, text, outError)
    if outError != "" || text == "" || threadName == "":
        return
    var lineStart: int32
    var pos: int32
    while pos < text.len:
        if text[pos] == '\n':
            if pos > lineStart:
                let line = wire.RustCsgSliceBytes(text, lineStart, pos - lineStart)
                let id = wire.RustCsgJsonFindStr(line, "id")
                let updated = wire.RustCsgJsonFindStr(line, "updated_at")
                let name = wire.RustCsgJsonFindStr(line, "thread_name")
                if id != "" && updated != "":
                    if name == threadName:
                        outId = id
                        outName = name
                        outUpdated = updated
                    elif outId != "" && id == outId:
                        outId = ""
                        outName = ""
                        outUpdated = ""
            lineStart = pos + 1
        pos = pos + 1
    if lineStart < text.len:
        let line = wire.RustCsgSliceBytes(text, lineStart, text.len - lineStart)
        let id = wire.RustCsgJsonFindStr(line, "id")
        let updated = wire.RustCsgJsonFindStr(line, "updated_at")
        let name = wire.RustCsgJsonFindStr(line, "thread_name")
        if id != "" && updated != "":
            if name == threadName:
                outId = id
                outName = name
                outUpdated = updated
            elif outId != "" && id == outId:
                outId = ""
                outName = ""
                outUpdated = ""

fn RustCsgSessionIndexFindLatestByNameInto(codexHome: str,
                                           threadName: str,
                                           outEntry: var types.RustCsgSessionIndexEntry,
                                           outError: var str) =
    RustCsgSessionIndexClearEntry(outEntry)
    var text: str
    RustCsgSessionIndexLoadTextInto(codexHome, text, outError)
    if outError != "" || text == "" || threadName == "":
        return
    var lineStart: int32
    var pos: int32
    while pos < text.len:
        if text[pos] == '\n':
            if pos > lineStart:
                let line = wire.RustCsgSliceBytes(text, lineStart, pos - lineStart)
                var entry: types.RustCsgSessionIndexEntry
                RustCsgSessionIndexParseLineInto(line, entry)
                if entry.id != "":
                    if entry.threadName == threadName:
                        outEntry.id = entry.id
                        outEntry.threadName = entry.threadName
                        outEntry.updatedAt = entry.updatedAt
                    elif outEntry.id != "" && entry.id == outEntry.id:
                        RustCsgSessionIndexClearEntry(outEntry)
            lineStart = pos + 1
        pos = pos + 1
    if lineStart < text.len:
        let line = wire.RustCsgSliceBytes(text, lineStart, text.len - lineStart)
        var entry: types.RustCsgSessionIndexEntry
        RustCsgSessionIndexParseLineInto(line, entry)
        if entry.id != "":
            if entry.threadName == threadName:
                outEntry.id = entry.id
                outEntry.threadName = entry.threadName
                outEntry.updatedAt = entry.updatedAt
            elif outEntry.id != "" && entry.id == outEntry.id:
                RustCsgSessionIndexClearEntry(outEntry)

fn RustCsgSessionIndexFindLatestById(codexHome: str,
                                     threadId: str,
                                     outError: var str): types.RustCsgSessionIndexEntry =
    var empty: types.RustCsgSessionIndexEntry
    var text: str
    RustCsgSessionIndexLoadTextInto(codexHome, text, outError)
    if outError != "" || text == "" || threadId == "":
        return empty
    var matched: types.RustCsgSessionIndexEntry
    var lineStart: int32
    var pos: int32
    while pos < text.len:
        if text[pos] == '\n':
            if pos > lineStart:
                let line = wire.RustCsgSliceBytes(text, lineStart, pos - lineStart)
                var entry: types.RustCsgSessionIndexEntry
                RustCsgSessionIndexParseLineInto(line, entry)
                if entry.id == threadId:
                    matched.id = entry.id
                    matched.threadName = entry.threadName
                    matched.updatedAt = entry.updatedAt
            lineStart = pos + 1
        pos = pos + 1
    if lineStart < text.len:
        let line = wire.RustCsgSliceBytes(text, lineStart, text.len - lineStart)
        var entry: types.RustCsgSessionIndexEntry
        RustCsgSessionIndexParseLineInto(line, entry)
        if entry.id == threadId:
            matched.id = entry.id
            matched.threadName = entry.threadName
            matched.updatedAt = entry.updatedAt
    if RustCsgSessionIndexEntryEmpty(matched):
        return empty
    return matched

