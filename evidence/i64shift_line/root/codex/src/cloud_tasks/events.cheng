# Cloud Tasks — SSE event streaming
#
# Provides types and functions for consuming task events via
# Server-Sent Events (SSE) from the backend.
#
# SSE stream: POST {baseUrl}/v1/tasks/{taskId}/events
# Each event line: "event: <type>\ndata: <json>\n\n"

import std/strings
import cheng/codex/cloud_tasks/task as task

# ── SSE event type constants ─────────────────────────────────────────────
const RustCsgSseEventStatusChange: str = "status_change"
const RustCsgSseEventOutputDelta: str = "output_delta"
const RustCsgSseEventError: str = "error"
const RustCsgSseEventCompleted: str = "completed"
const RustCsgSseEventHeartbeat: str = "heartbeat"

const RustCsgSseEventCount: int32 = 5

fn SseEventTypeNames(): str =
    return "status_change,output_delta,error,completed,heartbeat"

# ── Local JSON helpers ───────────────────────────────────────────────────

fn jsonQuote(value: str): str =
    var out = "\""
    for i in 0..<value.len:
        let ch = value[i]
        if ch == '"':
            out = strings.ConcatStr(out, "\\\"")
        elif ch == '\\':
            out = strings.ConcatStr(out, "\\\\")
        elif ch == '\n':
            out = strings.ConcatStr(out, "\\n")
        elif ch == '\r':
            out = strings.ConcatStr(out, "\\r")
        elif ch == '\t':
            out = strings.ConcatStr(out, "\\t")
        else:
            out = strings.ConcatStr(out, strings.SliceBytes(value, i, 1))
    return strings.ConcatStr(out, "\"")

fn jsonFieldStr(key: str, value: str): str =
    return strings.ConcatStr(strings.ConcatStr(strings.ConcatStr("\"", key), "\":"), jsonQuote(value))

fn jsonFieldInt32(key: str, value: int32): str =
    return strings.ConcatStr(strings.ConcatStr(strings.ConcatStr("\"", key), "\":"), strings.IntToStr(value))

fn cat3(a: str, b: str, c: str): str =
    return strings.ConcatStr(strings.ConcatStr(a, b), c)

fn cat4(a: str, b: str, c: str, d: str): str =
    return strings.ConcatStr(cat3(a, b, c), d)

# ── isKnownSseEventType ──────────────────────────────────────────────────

fn isKnownSseEventType(eventType: str): bool =
    if eventType == RustCsgSseEventStatusChange: return true
    if eventType == RustCsgSseEventOutputDelta: return true
    if eventType == RustCsgSseEventError: return true
    if eventType == RustCsgSseEventCompleted: return true
    if eventType == RustCsgSseEventHeartbeat: return true
    return false

# ── buildEventSubscribeUrl ───────────────────────────────────────────────

fn buildEventSubscribeUrl(baseUrl: str, taskId: str): str =
    return cat4(baseUrl, "/v1/tasks/", taskId, "/events")

# ── parseSseEventLine ───────────────────────────────────────────────────

fn parseSseEventLine(line: str): task.CloudTaskEvent =
    var ev: task.CloudTaskEvent
    if strings.HasPrefix(line, "event: "):
        ev.eventType = strings.DropPrefix(line, "event: ")
    elif strings.HasPrefix(line, "data: "):
        var dataStr: str = strings.DropPrefix(line, "data: ")
        ev.data = dataStr
    return ev

# ── buildTaskEventJson ──────────────────────────────────────────────────

fn buildTaskEventJson(ev: task.CloudTaskEvent): str =
    var out: str = "{"
    out = strings.ConcatStr(out, jsonFieldStr("type", ev.eventType))
    out = strings.ConcatStr(out, ",")
    out = strings.ConcatStr(out, jsonFieldStr("data", ev.data))
    out = strings.ConcatStr(out, "}")
    return out

# ── buildSampleStatusChangeEvent ─────────────────────────────────────────

fn buildSampleStatusChangeEvent(taskId: str, status: str, output: str): task.CloudTaskEvent =
    var ev: task.CloudTaskEvent
    ev.eventType = RustCsgSseEventStatusChange
    var dataJson: str = "{"
    dataJson = strings.ConcatStr(dataJson, jsonFieldStr("status", status))
    dataJson = strings.ConcatStr(dataJson, ",")
    dataJson = strings.ConcatStr(dataJson, jsonFieldStr("taskId", taskId))
    if strings.Len(output) > 0:
        dataJson = strings.ConcatStr(dataJson, ",")
        dataJson = strings.ConcatStr(dataJson, jsonFieldStr("output", output))
    dataJson = strings.ConcatStr(dataJson, "}")
    ev.data = dataJson
    return ev

# ── buildSampleOutputDeltaEvent ──────────────────────────────────────────

fn buildSampleOutputDeltaEvent(taskId: str, delta: str): task.CloudTaskEvent =
    var ev: task.CloudTaskEvent
    ev.eventType = RustCsgSseEventOutputDelta
    var dataJson: str = "{"
    dataJson = strings.ConcatStr(dataJson, jsonFieldStr("delta", delta))
    dataJson = strings.ConcatStr(dataJson, ",")
    dataJson = strings.ConcatStr(dataJson, jsonFieldStr("taskId", taskId))
    dataJson = strings.ConcatStr(dataJson, "}")
    ev.data = dataJson
    return ev

# ── buildSampleErrorEvent ────────────────────────────────────────────────

fn buildSampleErrorEvent(taskId: str, errorMsg: str): task.CloudTaskEvent =
    var ev: task.CloudTaskEvent
    ev.eventType = RustCsgSseEventError
    var dataJson: str = "{"
    dataJson = strings.ConcatStr(dataJson, jsonFieldStr("error", errorMsg))
    dataJson = strings.ConcatStr(dataJson, ",")
    dataJson = strings.ConcatStr(dataJson, jsonFieldStr("taskId", taskId))
    dataJson = strings.ConcatStr(dataJson, "}")
    ev.data = dataJson
    return ev

# ── buildSampleCompletedEvent ────────────────────────────────────────────

fn buildSampleCompletedEvent(taskId: str, output: str, exitCode: int32): task.CloudTaskEvent =
    var ev: task.CloudTaskEvent
    ev.eventType = RustCsgSseEventCompleted
    var dataJson: str = "{"
    dataJson = strings.ConcatStr(dataJson, jsonFieldStr("output", output))
    dataJson = strings.ConcatStr(dataJson, ",")
    dataJson = strings.ConcatStr(dataJson, jsonFieldInt32("exitCode", exitCode))
    dataJson = strings.ConcatStr(dataJson, ",")
    dataJson = strings.ConcatStr(dataJson, jsonFieldStr("taskId", taskId))
    dataJson = strings.ConcatStr(dataJson, "}")
    ev.data = dataJson
    return ev
