# Cloud Tasks — HTTP client for task management
#
# Ported from codex-rs/cloud-tasks-client/src/http.rs
# Covers: CloudTasksClient, CreateTask, GetTask, PollTask, CancelTask, ListTasks
#
# Uses std/http for HTTP calls. Works with a simple REST interface that can
# later be connected to BackendClient.

import std/strings
import cheng/codex/protocol/wire as wire
import cheng/codex/std/http as http
import cheng/codex/cloud_tasks/task as task

# ── Default headers for JSON API calls ──────────────────────────────────
# Builds the standard JSON Content-Type header plus optional auth.
# authToken: bearer token (empty = no auth header)

fn buildJsonHeaders(authToken: str): str =
    var out: str = "["
    out = wire.RustCsgCat(out, wire.RustCsgJsonQuote("Content-Type: application/json"))
    if strings.Len(authToken) > 0:
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonQuote(wire.RustCsgCat("Authorization: Bearer ", authToken)))
    out = wire.RustCsgCat(out, "]")
    return out

# ── Default headers with Accept: text/event-stream for SSE ──────────────

fn buildSseHeaders(authToken: str): str =
    var out: str = "["
    out = wire.RustCsgCat(out, wire.RustCsgJsonQuote("Accept: text/event-stream"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonQuote("Content-Type: application/json"))
    if strings.Len(authToken) > 0:
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonQuote(wire.RustCsgCat("Authorization: Bearer ", authToken)))
    out = wire.RustCsgCat(out, "]")
    return out

# ── buildTasksBaseUrl ────────────────────────────────────────────────────
# Constructs the base URL for tasks API.
# baseUrl: e.g. "https://api.example.com"
# Returns: "https://api.example.com/v1/tasks"

fn buildTasksBaseUrl(baseUrl: str): str =
    if strings.HasSuffix(baseUrl, "/"):
        return strings.ConcatStr(baseUrl, "v1/tasks")
    return strings.ConcatStr(baseUrl, "/v1/tasks")

# ── CreateTask ───────────────────────────────────────────────────────────
# Creates a new cloud task by sending a POST to {baseUrl}/v1/tasks.
# Uses std/http HTTP client.
# Returns the parsed CloudTask on success.
# Hard-fails on HTTP errors or parse failures.

fn CreateTask(baseUrl: str, authToken: str, req: task.CloudTaskRequest): task.CloudTask =
    var url: str = buildTasksBaseUrl(baseUrl)
    var headers: str = buildJsonHeaders(authToken)
    var body: str = task.buildCreateTaskRequestJson(req)
    var resp: http.HttpResult = http.HttpPost(url, body, headers)
    assert(resp.ok, wire.RustCsgCat("CreateTask HTTP error: ", resp.error))
    assert(resp.statusCode == 200, wire.RustCsgCat("CreateTask unexpected status: ", strings.IntToStr(resp.statusCode)))
    return task.parseCreateTaskResponse(resp.body)

# ── GetTask ──────────────────────────────────────────────────────────────
# Gets the current state of a cloud task.
# GET {baseUrl}/v1/tasks/{taskId}
# Returns the parsed CloudTask.
# Hard-fails on HTTP errors or parse failures.

fn GetTask(baseUrl: str, authToken: str, taskId: str): task.CloudTask =
    var url: str = wire.RustCsgCat(wire.RustCsgCat(buildTasksBaseUrl(baseUrl), "/"), taskId)
    var headers: str = buildJsonHeaders(authToken)
    var resp: http.HttpResult = http.HttpGet(url, headers)
    assert(resp.ok, wire.RustCsgCat("GetTask HTTP error: ", resp.error))
    assert(resp.statusCode == 200, wire.RustCsgCat("GetTask unexpected status: ", strings.IntToStr(resp.statusCode)))
    return task.parseGetTaskResponse(resp.body)

# ── PollTask ─────────────────────────────────────────────────────────────
# Polls a task until it reaches a terminal state or the timeout expires.
# intervalMs: polling interval in milliseconds (minimum 100ms)
# timeoutMs: maximum total polling time in milliseconds
# Returns the final CloudTask state.
# Hard-fails on parse errors.
# Returns a task with status "poll_timeout" if the timeout is exceeded.

fn PollTask(baseUrl: str, authToken: str, taskId: str, intervalMs: int32, timeoutMs: int32): task.CloudTask =
    assert(intervalMs > 0, "PollTask interval must be > 0")
    assert(timeoutMs > 0, "PollTask timeout must be > 0")
    var elapsed: int32 = 0
    var url: str = wire.RustCsgCat(wire.RustCsgCat(buildTasksBaseUrl(baseUrl), "/"), taskId)
    var headers: str = buildJsonHeaders(authToken)
    while elapsed < timeoutMs:
        var resp: http.HttpResult = http.HttpGet(url, headers)
        assert(resp.ok, wire.RustCsgCat("PollTask HTTP error: ", resp.error))
        assert(resp.statusCode == 200, wire.RustCsgCat("PollTask unexpected status: ", strings.IntToStr(resp.statusCode)))
        var ct: task.CloudTask = task.parseGetTaskResponse(resp.body)
        if task.isTerminalStatus(ct.status):
            return ct
        elapsed = elapsed + intervalMs
        # In a real implementation, this would sleep for intervalMs.
        # For now, iterations serve as the polling mechanism.
        if elapsed >= timeoutMs:
            break
    var timedOut: task.CloudTask
    timedOut.status = "poll_timeout"
    return timedOut

# ── CancelTask ───────────────────────────────────────────────────────────
# Cancels a running cloud task.
# POST {baseUrl}/v1/tasks/{taskId}/cancel
# Returns true if cancellation was accepted, false otherwise.
# Hard-fails on HTTP transport errors.

fn CancelTask(baseUrl: str, authToken: str, taskId: str): bool =
    var url: str = wire.RustCsgCat(wire.RustCsgCat(wire.RustCsgCat(buildTasksBaseUrl(baseUrl), "/"), taskId), "/cancel")
    var headers: str = buildJsonHeaders(authToken)
    var body: str = task.buildCancelTaskJson(taskId)
    var resp: http.HttpResult = http.HttpPost(url, body, headers)
    assert(resp.ok, wire.RustCsgCat("CancelTask HTTP error: ", resp.error))
    return resp.statusCode == 200

# ── ListTasks ────────────────────────────────────────────────────────────
# Lists cloud tasks.
# GET {baseUrl}/v1/tasks?limit={limit}
# Returns an array of CloudTask objects.
# Hard-fails on HTTP errors or parse failures.

fn ListTasks(baseUrl: str, authToken: str, limit: int32): task.CloudTask[] =
    var url: str = wire.RustCsgCat(wire.RustCsgCat(buildTasksBaseUrl(baseUrl), "?limit="), strings.IntToStr(limit))
    var headers: str = buildJsonHeaders(authToken)
    var resp: http.HttpResult = http.HttpGet(url, headers)
    assert(resp.ok, wire.RustCsgCat("ListTasks HTTP error: ", resp.error))
    assert(resp.statusCode == 200, wire.RustCsgCat("ListTasks unexpected status: ", strings.IntToStr(resp.statusCode)))
    return task.parseListTasksResponse(resp.body)
