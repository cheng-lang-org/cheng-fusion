# ── buildTaskStatusCheckJson ─────────────────────────────────────────────

fn buildTaskStatusCheckJson(taskId: str): str =
    var out: str = "{"
    out = strings.ConcatStr(out, jsonFieldStr("taskId", taskId))
    out = strings.ConcatStr(out, "}")
    return out

# ── buildCancelTaskJson ──────────────────────────────────────────────────

fn buildCancelTaskJson(taskId: str): str =
    var out: str = "{"
    out = strings.ConcatStr(out, jsonFieldStr("taskId", taskId))
    out = strings.ConcatStr(out, "}")
    return out

# ── buildListTasksRequestJson ────────────────────────────────────────────

fn buildListTasksRequestJson(limit: int32): str =
    var out: str = "{"
    out = strings.ConcatStr(out, jsonFieldInt32("limit", limit))
    out = strings.ConcatStr(out, "}")
    return out
