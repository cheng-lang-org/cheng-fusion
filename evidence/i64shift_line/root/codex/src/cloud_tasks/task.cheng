# Cloud Tasks — task types and JSON serialization
#
# Ported from codex-rs/cloud-tasks-client/src/api.rs
# Covers: CloudTaskRequest, CloudTask, CloudTaskResult, CloudTaskEvent
#         JSON construction and parsing for each type.
#
# JSON parsing is self-contained (does not use wire's RustCsgJsonFind*
# functions because they transitively depend on a C-level ConcatStr
# that isn't linked in standalone smoke test mode).

import std/strings
import cheng/codex/protocol/wire as wire

# ── type: CloudTaskRequest ───────────────────────────────────────────────

type
    CloudTaskRequest =
        prompt: str
        model: str
        cwd: str
        sessionId: str
        environmentId: str
        branch: str
        bestOfN: int32

# ── type: CloudTaskResult ────────────────────────────────────────────────

type
    CloudTaskResult =
        output: str
        exitCode: int32

# ── type: CloudTask ──────────────────────────────────────────────────────

type
    CloudTask =
        id: str
        status: str
        createdAt: str
        updatedAt: str
        request: CloudTaskRequest
        result: CloudTaskResult

# ── type: CloudTaskEvent ─────────────────────────────────────────────────

type
    CloudTaskEvent =
        eventType: str
        data: str

# ── Struct field metadata (CloudTaskRequest) ─────────────────────────────

const RustCsgCloudTaskRequestFieldCount: int32 = 7
const RustCsgCloudTaskRequestField1: str = "prompt"
const RustCsgCloudTaskRequestField2: str = "model"
const RustCsgCloudTaskRequestField3: str = "cwd"
const RustCsgCloudTaskRequestField4: str = "sessionId"
const RustCsgCloudTaskRequestField5: str = "environmentId"
const RustCsgCloudTaskRequestField6: str = "branch"
const RustCsgCloudTaskRequestField7: str = "bestOfN"

fn CloudTaskRequestFields(): str =
    return "prompt|str,model|str,cwd|str,sessionId|str,environmentId|str,branch|str,bestOfN|int32"

# ── Struct field metadata (CloudTaskResult) ──────────────────────────────

const RustCsgCloudTaskResultFieldCount: int32 = 2
const RustCsgCloudTaskResultField1: str = "output"
const RustCsgCloudTaskResultField2: str = "exitCode"

fn CloudTaskResultFields(): str =
    return "output|str,exitCode|int32"

# ── Struct field metadata (CloudTask) ────────────────────────────────────

const RustCsgCloudTaskFieldCount: int32 = 6
const RustCsgCloudTaskField1: str = "id"
const RustCsgCloudTaskField2: str = "status"
const RustCsgCloudTaskField3: str = "createdAt"
const RustCsgCloudTaskField4: str = "updatedAt"
const RustCsgCloudTaskField5: str = "request"
const RustCsgCloudTaskField6: str = "result"

fn CloudTaskFields(): str =
    return "id|str,status|str,createdAt|str,updatedAt|str,request|box_ctr,result|opt_box_ctres"

# ── Struct field metadata (CloudTaskEvent) ───────────────────────────────

const RustCsgCloudTaskEventFieldCount: int32 = 2
const RustCsgCloudTaskEventField1: str = "eventType"
const RustCsgCloudTaskEventField2: str = "data"

fn CloudTaskEventFields(): str =
    return "eventType|str,data|str"

# ═══════════════════════════════════════════════════════════════════════════════
# Local JSON helpers (self-contained, no dependency on wire's ConcatStr import)
# ═══════════════════════════════════════════════════════════════════════════════

# ── JSON string quoting ──────────────────────────────────────────────────

fn jsonQuote(value: str): str =
    var out = "\""
    for i in 0..<value.len:
        let ch = value[i]
        if ch == '"':
            out = strings.ConcatStr(out, "\\\"")
        elif ch == '\\':
            out = strings.ConcatStr(out, "\\\\")
        elif ch == '\n':
            out = strings.ConcatStr(out, "\\n")
        elif ch == '\r':
            out = strings.ConcatStr(out, "\\r")
        elif ch == '\t':
            out = strings.ConcatStr(out, "\\t")
        else:
            out = strings.ConcatStr(out, strings.SliceBytes(value, i, 1))
    return strings.ConcatStr(out, "\"")

# ── Field-value JSON construction ────────────────────────────────────────

fn jsonFieldStr(key: str, value: str): str =
    return strings.ConcatStr(strings.ConcatStr(strings.ConcatStr("\"", key), "\":"), jsonQuote(value))

fn jsonFieldInt32(key: str, value: int32): str =
    return strings.ConcatStr(strings.ConcatStr(strings.ConcatStr("\"", key), "\":"), strings.IntToStr(value))

fn jsonFieldBool(key: str, value: bool): str =
    var boolStr: str = value ? "true" : "false"
    return strings.ConcatStr(strings.ConcatStr(strings.ConcatStr("\"", key), "\":"), boolStr)

# ── JSON key search: find position of value for a given key ──────────────
# Returns the index in text where the value starts, or asserts on missing key.

fn jsonFindValueStart(text: str, key: str): int32 =
    var pattern: str = strings.ConcatStr(strings.ConcatStr("\"", key), "\"")
    var i: int32
    while i < text.len:
        if wire.RustCsgMatchesAt(text, i, pattern):
            var p: int32 = i + strings.Len(pattern)
            p = wire.RustCsgSkipJsonSpace(text, p)
            if p < text.len && text[p] == int32(':'):
                p = wire.RustCsgSkipJsonSpace(text, p + 1)
                return p
        i = i + 1
    return -1

fn jsonHasKey(text: str, key: str): bool =
    var pattern: str = strings.ConcatStr(strings.ConcatStr("\"", key), "\"")
    return wire.RustCsgContains(text, pattern)

# ── JSON string value extraction ─────────────────────────────────────────

fn jsonFindStr(text: str, key: str): str =
    var p: int32 = jsonFindValueStart(text, key)
    if p < 0: return ""
    if p >= text.len || text[p] != int32('"'): return ""
    var start: int32 = p + 1
    var i: int32 = start
    var result: str = ""
    var copyStart: int32 = start
    while i < text.len:
        if text[i] == int32('\\'):
            # copy everything from copyStart up to this backslash
            if i > copyStart:
                result = strings.ConcatStr(result, strings.SliceBytes(text, copyStart, i - copyStart))
            i = i + 1
            if i >= text.len: break
            var ch: int32 = text[i]
            if ch == int32('"'):
                result = strings.ConcatStr(result, "\"")
            elif ch == int32('\\'):
                result = strings.ConcatStr(result, "\\")
            elif ch == int32('n'):
                result = strings.ConcatStr(result, "\n")
            elif ch == int32('r'):
                result = strings.ConcatStr(result, "\r")
            elif ch == int32('t'):
                result = strings.ConcatStr(result, "\t")
            else:
                # unknown escape — keep both characters
                result = strings.ConcatStr(result, strings.SliceBytes(text, i - 1, 2))
            i = i + 1
            copyStart = i
        elif text[i] == int32('"'):
            if i > copyStart:
                result = strings.ConcatStr(result, strings.SliceBytes(text, copyStart, i - copyStart))
            return result
        else:
            i = i + 1
    return ""

fn jsonFindOptionalStr(text: str, key: str): str =
    if jsonHasKey(text, key):
        return jsonFindStr(text, key)
    return ""

# ── JSON int32 value extraction ──────────────────────────────────────────

fn jsonFindInt32(text: str, key: str): int32 =
    var p: int32 = jsonFindValueStart(text, key)
    if p < 0: return 0
    var neg: bool = false
    if p < text.len && text[p] == int32('-'):
        neg = true
        p = p + 1
    var val: int32 = 0
    var sawDigit: bool = false
    while p < text.len:
        var digit: int32 = text[p] - int32('0')
        if digit < 0 || digit > 9:
            break
        sawDigit = true
        val = val * 10 + digit
        p = p + 1
    if !sawDigit: return 0
    if neg: return 0 - val
    return val

# ── JSON object value extraction ─────────────────────────────────────────

fn jsonFindObject(text: str, key: str): str =
    var p: int32 = jsonFindValueStart(text, key)
    if p < 0: return ""
    if p >= text.len || text[p] != int32('{'): return ""
    var depth: int32 = 0
    var inString: bool = false
    var escaped: bool = false
    var i: int32 = p
    while i < text.len:
        var ch: int32 = text[i]
        if inString:
            if escaped:
                escaped = false
            elif ch == int32('\\'):
                escaped = true
            elif ch == int32('"'):
                inString = false
        elif ch == int32('"'):
            inString = true
        elif ch == int32('{'):
            depth = depth + 1
        elif ch == int32('}'):
            depth = depth - 1
            if depth == 0:
                return strings.SliceBytes(text, p, i - p + 1)
        i = i + 1
    return ""

# ── JSON array value extraction ──────────────────────────────────────────

fn jsonFindArray(text: str, key: str): str =
    var p: int32 = jsonFindValueStart(text, key)
    if p < 0: return ""
    if p >= text.len || text[p] != int32('['): return ""
    var depth: int32 = 0
    var inString: bool = false
    var escaped: bool = false
    var i: int32 = p
    while i < text.len:
        var ch: int32 = text[i]
        if inString:
            if escaped:
                escaped = false
            elif ch == int32('\\'):
                escaped = true
            elif ch == int32('"'):
                inString = false
        elif ch == int32('"'):
            inString = true
        elif ch == int32('['):
            depth = depth + 1
        elif ch == int32(']'):
            depth = depth - 1
            if depth == 0:
                return strings.SliceBytes(text, p, i - p + 1)
        i = i + 1
    return ""

# ═══════════════════════════════════════════════════════════════════════════════
# Task JSON serialization
# ═══════════════════════════════════════════════════════════════════════════════

# ── buildCreateTaskRequestJson ──────────────────────────────────────────

fn buildCreateTaskRequestJson(req: CloudTaskRequest): str =
    var out: str = "{"
    out = strings.ConcatStr(out, jsonFieldStr("prompt", req.prompt))
    out = strings.ConcatStr(out, ",")
    out = strings.ConcatStr(out, jsonFieldStr("model", req.model))
    out = strings.ConcatStr(out, ",")
    out = strings.ConcatStr(out, jsonFieldStr("cwd", req.cwd))
    out = strings.ConcatStr(out, ",")
    out = strings.ConcatStr(out, jsonFieldStr("sessionId", req.sessionId))
    out = strings.ConcatStr(out, ",")
    out = strings.ConcatStr(out, jsonFieldStr("environmentId", req.environmentId))
    out = strings.ConcatStr(out, ",")
    out = strings.ConcatStr(out, jsonFieldStr("branch", req.branch))
    out = strings.ConcatStr(out, ",")
    out = strings.ConcatStr(out, jsonFieldInt32("bestOfN", req.bestOfN))
    out = strings.ConcatStr(out, "}")
    return out

# ── buildTaskResultJson ──────────────────────────────────────────────────

fn buildTaskResultJson(result: CloudTaskResult): str =
    var out: str = "{"
    out = strings.ConcatStr(out, jsonFieldStr("output", result.output))
    out = strings.ConcatStr(out, ",")
    out = strings.ConcatStr(out, jsonFieldInt32("exitCode", result.exitCode))
    out = strings.ConcatStr(out, "}")
    return out

# ═══════════════════════════════════════════════════════════════════════════════
# Task JSON parsing
# ═══════════════════════════════════════════════════════════════════════════════

# ── parseCreateTaskResponse ──────────────────────────────────────────────

fn parseCreateTaskResponse(json: str): CloudTask =
    var task: CloudTask
    task.id = jsonFindStr(json, "id")
    task.status = jsonFindStr(json, "status")
    task.createdAt = jsonFindStr(json, "createdAt")
    task.updatedAt = jsonFindStr(json, "updatedAt")
    return task

# ── parseGetTaskResponse ─────────────────────────────────────────────────

fn parseGetTaskResponse(json: str): CloudTask =
    var task: CloudTask
    task.id = jsonFindStr(json, "id")
    task.status = jsonFindStr(json, "status")
    task.createdAt = jsonFindStr(json, "createdAt")
    task.updatedAt = jsonFindStr(json, "updatedAt")

    var reqJson: str = jsonFindObject(json, "request")
    if strings.Len(reqJson) > 0:
        task.request.prompt = jsonFindStr(reqJson, "prompt")
        task.request.model = jsonFindOptionalStr(reqJson, "model")
        task.request.cwd = jsonFindStr(reqJson, "cwd")
        task.request.sessionId = jsonFindOptionalStr(reqJson, "sessionId")
        task.request.environmentId = jsonFindOptionalStr(reqJson, "environmentId")
        task.request.branch = jsonFindOptionalStr(reqJson, "branch")
        if jsonHasKey(reqJson, "bestOfN"):
            task.request.bestOfN = jsonFindInt32(reqJson, "bestOfN")

    if jsonHasKey(json, "result"):
        var resultJson: str = jsonFindObject(json, "result")
        if strings.Len(resultJson) > 0:
            task.result.output = jsonFindStr(resultJson, "output")
            task.result.exitCode = jsonFindInt32(resultJson, "exitCode")

    return task

# ── parseListTasksResponse ───────────────────────────────────────────────

fn parseListTasksResponse(json: str): CloudTask[] =
    var tasks: CloudTask[]
    var arrJson: str = jsonFindArray(json, "tasks")
    if strings.Len(arrJson) <= 2:
        return tasks
    var pos: int32 = 1
    var depth: int32 = 0
    var inString: bool = false
    var escaped: bool = false
    var elemStart: int32 = -1
    while pos < arrJson.len:
        var ch: int32 = arrJson[pos]
        if inString:
            if escaped:
                escaped = false
            elif ch == int32('\\'):
                escaped = true
            elif ch == int32('"'):
                inString = false
        elif ch == int32('"'):
            inString = true
            if elemStart < 0:
                elemStart = pos
        elif ch == int32('{'):
            depth = depth + 1
            if depth == 1:
                elemStart = pos
        elif ch == int32('}'):
            depth = depth - 1
            if depth == 0 && elemStart >= 0:
                var elemJson: str = strings.SliceBytes(arrJson, elemStart, pos - elemStart + 1)
                var task: CloudTask = parseGetTaskResponse(elemJson)
                add(tasks, task)
                elemStart = -1
        pos = pos + 1
    return tasks

# ── parseTaskEvent ───────────────────────────────────────────────────────

fn parseTaskEvent(json: str): CloudTaskEvent =
    var event: CloudTaskEvent
    event.eventType = jsonFindStr(json, "type")
    event.data = jsonFindStr(json, "data")
    return event

# ═══════════════════════════════════════════════════════════════════════════════
# Status helpers
# ═══════════════════════════════════════════════════════════════════════════════

# ── isValidTaskStatus ────────────────────────────────────────────────────

fn isValidTaskStatus(status: str): bool =
    if status == "pending": return true
    if status == "in_progress": return true
    if status == "completed": return true
    if status == "failed": return true
    if status == "cancelled": return true
    return false

# ── isTerminalStatus ─────────────────────────────────────────────────────

fn isTerminalStatus(status: str): bool =
    if status == "completed": return true
    if status == "failed": return true
    if status == "cancelled": return true
    return false

