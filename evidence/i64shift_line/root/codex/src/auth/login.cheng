# Auth module — token storage, CodexAuth type, auth.json management
#
# Matches the Rust codex-login crate's AuthDotJson schema at
#   $CODEX_HOME/auth.json
#
# File I/O via C provider (std/os has bootstrap compile error).

import std/strings

# ── C provider bindings ─────────────────────────────────────────────────

@abi_internal
@importc("cheng_auth_file_exists")
fn authFileExists(path: str): int32

@abi_internal
@importc("cheng_auth_write_file")
fn authWriteFile(path: str, content: str): int32

@abi_internal
@importc("cheng_auth_read_file")
fn authReadFile(path: str): str

@abi_internal
@importc("cheng_auth_remove_file")
fn authRemoveFile(path: str): int32

@abi_internal
@importc("cheng_auth_mkdir")
fn authMkdir(path: str): int32

# ── String helpers ──────────────────────────────────────────────────────

fn strcat3(a: str, b: str, c: str): str =
    return strings.ConcatStr(strings.ConcatStr(a, b), c)

# ── JSON string escaping ────────────────────────────────────────────────

# Escape a string value for JSON: backslash, quote, and control chars
fn jsonEscapeStr(s: str): str =
    let n: int32 = strings.Len(s)
    if n == 0:
        return ""
    var result: str
    var i: int32
    while i < n:
        let ch: char = s[i]
        let cv: int32 = int32(ch)
        if cv == 34:   # double quote
            result = strings.ConcatStr(result, "\\\"")
        elif cv == 92:  # backslash
            result = strings.ConcatStr(result, "\\\\")
        elif cv == 8:   # backspace
            result = strings.ConcatStr(result, "\\b")
        elif cv == 12:  # form feed
            result = strings.ConcatStr(result, "\\f")
        elif cv == 10:  # newline
            result = strings.ConcatStr(result, "\\n")
        elif cv == 13:  # carriage return
            result = strings.ConcatStr(result, "\\r")
        elif cv == 9:   # tab
            result = strings.ConcatStr(result, "\\t")
        elif cv < 32:
            # Other control chars: \uXXXX (rare in auth data)
            let hexTable: str = "0123456789abcdef"
            var nv: int32 = cv
            var d4: int32 = nv / 4096
            nv = nv % 4096
            var d3: int32 = nv / 256
            nv = nv % 256
            var d2: int32 = nv / 16
            var d1: int32 = nv % 16
            result = strings.ConcatStr(result, "\\u")
            result = strings.ConcatStr(strings.ConcatStr(result, strings.SliceBytes(hexTable, d4, 1)), strings.SliceBytes(hexTable, d3, 1))
            result = strings.ConcatStr(strings.ConcatStr(result, strings.SliceBytes(hexTable, d2, 1)), strings.SliceBytes(hexTable, d1, 1))
        else:
            result = strings.ConcatStr(result, strings.SliceBytes(s, i, 1))
        i = i + 1
    return result

# Append a JSON string field: ,"key":"value"
fn jsonAppendStrField(buf: var str, key: str, value: str) =
    buf = strings.ConcatStr(buf, ",\"")
    buf = strings.ConcatStr(buf, key)
    buf = strings.ConcatStr(buf, "\":\"")
    buf = strings.ConcatStr(buf, jsonEscapeStr(value))
    buf = strings.ConcatStr(buf, "\"")

# ── Types ───────────────────────────────────────────────────────────────

# auth.json payload (flat — nested struct types not supported in Cheng).
# Empty string = absent/null in JSON.
type
    AuthDotJson =
        authMode: str         # "ApiKey"|"Chatgpt"|"ChatgptAuthTokens"|"AgentIdentity"
        openaiApiKey: str
        rawIdToken: str       # Raw JWT id_token
        accessToken: str
        refreshToken: str
        accountId: str
        lastRefresh: str
        agentIdentity: str

fn NewAuthDotJson(): AuthDotJson =
    var result: AuthDotJson
    return result

# kind: 0=ApiKey 1=Chatgpt 2=ChatgptAuthTokens 3=AgentIdentity
type
    CodexAuth =
        kind: int32
        apiKey: str
        accessToken: str
        refreshToken: str
        accountId: str

fn NewCodexAuthFromApiKey(apiKey: str): CodexAuth =
    var result: CodexAuth
    result.apiKey = apiKey
    return result

fn NewCodexAuthFromTokens(apiKey: str, accessToken: str, refreshToken: str, accountId: str): CodexAuth =
    var result: CodexAuth
    result.kind = 1
    result.apiKey = apiKey
    result.accessToken = accessToken
    result.refreshToken = refreshToken
    result.accountId = accountId
    return result

fn CodexAuthGetToken(auth: CodexAuth): str =
    if auth.kind == 0:
        return auth.apiKey
    return auth.accessToken

# ── JSON helpers (manual parsing, std/json parser is a bootstrap stub) ──

fn skipWs(json: str, i: int32): int32 =
    var pos: int32 = i
    let n: int32 = strings.Len(json)
    while pos < n:
        let ch: str = strings.SliceBytes(json, pos, 1)
        if ch == " ":
            pos = pos + 1
        elif ch == "\t":
            pos = pos + 1
        elif ch == "\n":
            pos = pos + 1
        elif ch == "\r":
            pos = pos + 1
        else:
            break
    return pos

fn findSub(json: str, needle: str, start: int32): int32 =
    let n: int32 = strings.Len(json)
    let nl: int32 = strings.Len(needle)
    if nl == 0:
        return -1
    if start + nl > n:
        return -1
    var i: int32 = start
    while i <= n - nl:
        if strings.SliceBytes(json, i, nl) == needle:
            return i
        i = i + 1
    return -1

fn jsonGetStr(json: str, key: str): str =
    let n: int32 = strings.Len(json)
    if n == 0:
        return ""
    if key == "":
        return ""

    var keyPattern: str = strcat3("\"", key, "\":")
    var pos: int32 = findSub(json, keyPattern, 0)
    if pos < 0:
        keyPattern = strings.ConcatStr(strcat3("\"", key, "\":"), " ")
        pos = findSub(json, keyPattern, 0)
        if pos < 0:
            return ""

    var i: int32 = pos + strings.Len(keyPattern)
    i = skipWs(json, i)
    if i >= n:
        return ""
    if strings.SliceBytes(json, i, 1) == "n":
        return ""
    if strings.SliceBytes(json, i, 1) != "\"":
        return ""

    i = i + 1
    var result: str
    while i < n:
        let ch: str = strings.SliceBytes(json, i, 1)
        if ch == "\\":
            i = i + 1
            if i >= n:
                break
            let esc: str = strings.SliceBytes(json, i, 1)
            if esc == "\"":
                result = strings.ConcatStr(result, "\"")
            elif esc == "\\":
                result = strings.ConcatStr(result, "\\")
            elif esc == "n":
                result = strings.ConcatStr(result, "\n")
            elif esc == "t":
                result = strings.ConcatStr(result, "\t")
            elif esc == "/":
                result = strings.ConcatStr(result, "/")
            else:
                result = strings.ConcatStr(result, strings.SliceBytes(json, i, 1))
            i = i + 1
        elif ch == "\"":
            break
        else:
            result = strings.ConcatStr(result, strings.SliceBytes(json, i, 1))
            i = i + 1
    return result

fn jsonGetNestedStr(json: str, outerKey: str, innerKey: str): str =
    let n: int32 = strings.Len(json)
    if n == 0:
        return ""
    var outerPattern: str = strcat3("\"", outerKey, "\":")
    var pos: int32 = findSub(json, outerPattern, 0)
    if pos < 0:
        outerPattern = strings.ConcatStr(strcat3("\"", outerKey, "\":"), " ")
        pos = findSub(json, outerPattern, 0)
        if pos < 0:
            return ""
    var i: int32 = pos + strings.Len(outerPattern)
    i = skipWs(json, i)
    if i >= n:
        return ""
    if strings.SliceBytes(json, i, 1) != "{":
        return ""
    let subJson: str = strings.SliceBytes(json, i, n - i)
    return jsonGetStr(subJson, innerKey)

# ── auth.json path ──────────────────────────────────────────────────────

fn authJsonPath(codexHome: str): str =
    # Simple path join — auth.json is always directly in codexHome
    if strings.Len(codexHome) == 0:
        return "auth.json"
    if codexHome[strings.Len(codexHome) - 1] == '/':
        return strings.ConcatStr(codexHome, "auth.json")
    return strings.ConcatStr(strings.ConcatStr(codexHome, "/"), "auth.json")

# ── Write auth.json ─────────────────────────────────────────────────────

fn SaveAuth(codexHome: str, auth: AuthDotJson): bool =
    if codexHome != "":
        let made = authMkdir(codexHome)
        if made == 0 && authFileExists(codexHome) == 0:
            return false
    let path: str = authJsonPath(codexHome)

    # Build JSON manually (std/json has bootstrap compile error with struct types)
    var content: str = strcat3("{\"auth_mode\":\"", jsonEscapeStr(auth.authMode), "\"")

    if auth.openaiApiKey != "":
        jsonAppendStrField(content, "openai_api_key", auth.openaiApiKey)

    # Tokens sub-object - check if any token fields present
    var hasTokens: bool
    if auth.accessToken != "":
        hasTokens = true
    if !hasTokens:
        if auth.refreshToken != "":
            hasTokens = true
    if !hasTokens:
        if auth.accountId != "":
            hasTokens = true

    if hasTokens:
        content = strings.ConcatStr(content, ",\"tokens\":{")
        var tokFirst: bool = true
        if auth.rawIdToken != "":
            content = strcat3(content, "\"id_token\":\"", jsonEscapeStr(auth.rawIdToken))
            content = strings.ConcatStr(content, "\"")
            tokFirst = false
        if auth.accessToken != "":
            if !tokFirst:
                content = strings.ConcatStr(content, ",")
            content = strcat3(content, "\"access_token\":\"", jsonEscapeStr(auth.accessToken))
            content = strings.ConcatStr(content, "\"")
            tokFirst = false
        if auth.refreshToken != "":
            if !tokFirst:
                content = strings.ConcatStr(content, ",")
            content = strcat3(content, "\"refresh_token\":\"", jsonEscapeStr(auth.refreshToken))
            content = strings.ConcatStr(content, "\"")
            tokFirst = false
        if auth.accountId != "":
            if !tokFirst:
                content = strings.ConcatStr(content, ",")
            content = strcat3(content, "\"account_id\":\"", jsonEscapeStr(auth.accountId))
            content = strings.ConcatStr(content, "\"")
        content = strings.ConcatStr(content, "}")

    if auth.lastRefresh != "":
        jsonAppendStrField(content, "last_refresh", auth.lastRefresh)
    if auth.agentIdentity != "":
        jsonAppendStrField(content, "agent_identity", auth.agentIdentity)

    content = strings.ConcatStr(content, "}")
    return authWriteFile(path, content) != 0

# ── Read auth.json ──────────────────────────────────────────────────────

fn LoadAuth(codexHome: str): AuthDotJson =
    var result: AuthDotJson = NewAuthDotJson()
    let path: str = authJsonPath(codexHome)

    if authFileExists(path) == 0:
        return result

    let json: str = authReadFile(path)
    if json == "":
        return result

    result.authMode = jsonGetStr(json, "auth_mode")
    result.openaiApiKey = jsonGetStr(json, "openai_api_key")
    result.lastRefresh = jsonGetStr(json, "last_refresh")
    result.agentIdentity = jsonGetStr(json, "agent_identity")

    result.rawIdToken = jsonGetNestedStr(json, "tokens", "id_token")
    result.accessToken = jsonGetNestedStr(json, "tokens", "access_token")
    result.refreshToken = jsonGetNestedStr(json, "tokens", "refresh_token")
    result.accountId = jsonGetNestedStr(json, "tokens", "account_id")

    return result

# ── Delete auth.json ────────────────────────────────────────────────────

fn Logout(codexHome: str): bool =
    let path: str = authJsonPath(codexHome)
    if authFileExists(path) != 0:
        return authRemoveFile(path) != 0
    return false

# ── Query helpers ───────────────────────────────────────────────────────

fn AuthAvailable(auth: AuthDotJson): bool =
    return auth.authMode != ""

fn AuthDotJsonToCodexAuth(auth: AuthDotJson): CodexAuth =
    if auth.authMode == "ApiKey":
        return NewCodexAuthFromApiKey(auth.openaiApiKey)
    return NewCodexAuthFromTokens(auth.openaiApiKey, auth.accessToken,
                                  auth.refreshToken, auth.accountId)
