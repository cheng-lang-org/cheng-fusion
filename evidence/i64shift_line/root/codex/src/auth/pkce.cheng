# PKCE (Proof Key for Code Exchange) implementation
# Uses C provider (@importc) for SHA256, base64url, and secure random.
#
# Design:
# - code_verifier: 64 random bytes encoded as base64url (no padding) → 86 chars
# - code_challenge: SHA256(code_verifier as UTF-8 bytes) → base64url (no padding) → 43 chars
#
# The C provider lives in support/auth_provider.c and links CommonCrypto
# (macOS system framework, no dlopen).

type
    PkceCodes =
        codeVerifier: str
        codeChallenge: str

# ── C provider bindings ─────────────────────────────────────────────────

@abi_internal
@importc("cheng_auth_random_bytes")
fn authRandomBytes(count: int32): str

@abi_internal
@importc("cheng_auth_sha256")
fn authSha256(data: str): str

@abi_internal
@importc("cheng_auth_base64url_encode")
fn authBase64urlEncode(data: str): str

# ── Public API ──────────────────────────────────────────────────────────

# Generate PKCE codes using the S256 challenge method.
# code_verifier: 64 random bytes base64url-encoded (86 chars, within the
#                PKCE spec range of 43–128 chars).
# code_challenge: BASE64URL-ENCODE(SHA256(code_verifier)) without padding.
fn GeneratePkce(): PkceCodes =
    let randomBytes: str = authRandomBytes(64)
    let codeVerifier: str = authBase64urlEncode(randomBytes)

    # SHA256 of the verifier *string bytes* (as required by RFC 7636 §4.2)
    let hash: str = authSha256(codeVerifier)
    let codeChallenge: str = authBase64urlEncode(hash)

    var result: PkceCodes
    result.codeVerifier = codeVerifier
    result.codeChallenge = codeChallenge
    return result
