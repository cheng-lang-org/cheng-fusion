# ── JSON helpers ─────────────────────────────────────────────────────────

# Serialize a string array to JSON: ["a","b","c"]
fn argsToJson(items: str[]): str =
    var result: str = "["
    for i in 0..<items.len:
        if i > 0:
            result = strings.ConcatStr(result, ",")
        result = strings.ConcatStr(result, "\"")
        # Escape simple chars for JSON
        var item: str = items[i]
        for j in 0..<item.len:
            if item[j] == '"':
                result = strings.ConcatStr(result, "\\\"")
            elif item[j] == '\\':
                result = strings.ConcatStr(result, "\\\\")
            elif item[j] == '\n':
                result = strings.ConcatStr(result, "\\n")
            elif item[j] == '\r':
                result = strings.ConcatStr(result, "\\r")
            elif item[j] == '\t':
                result = strings.ConcatStr(result, "\\t")
            else:
                result = strings.ConcatStr(result, strings.SliceBytes(item, j, 1))
        result = strings.ConcatStr(result, "\"")
    result = strings.ConcatStr(result, "]")
    return result

# Serialize env pairs (KEY=VALUE) to JSON object: {"KEY":"VALUE",...}
fn envToJson(items: str[]): str =
    var result: str = "{"
    var first: bool = true
    for i in 0..<items.len:
        # Find '=' separator
        var eqIdx: int32 = -1
        for j in 0..<items[i].len:
            if items[i][j] == '=':
                eqIdx = j
                break
        if eqIdx >= 0:
            if !first:
                result = strings.ConcatStr(result, ",")
            first = false
            var key: str = strings.SliceBytes(items[i], 0, eqIdx)
            var val: str = strings.SliceBytes(items[i], eqIdx + 1, items[i].len - eqIdx - 1)

            result = strings.ConcatStr(result, "\"")
            # Escape key
            for j in 0..<key.len:
                if key[j] == '"':
                    result = strings.ConcatStr(result, "\\\"")
                elif key[j] == '\\':
                    result = strings.ConcatStr(result, "\\\\")
                else:
                    result = strings.ConcatStr(result, strings.SliceBytes(key, j, 1))
            result = strings.ConcatStr(result, "\":\"")
            # Escape value
            for j in 0..<val.len:
                if val[j] == '"':
                    result = strings.ConcatStr(result, "\\\"")
                elif val[j] == '\\':
                    result = strings.ConcatStr(result, "\\\\")
                elif val[j] == '\n':
                    result = strings.ConcatStr(result, "\\n")
                elif val[j] == '\r':
                    result = strings.ConcatStr(result, "\\r")
                elif val[j] == '\t':
                    result = strings.ConcatStr(result, "\\t")
                else:
                    result = strings.ConcatStr(result, strings.SliceBytes(val, j, 1))
            result = strings.ConcatStr(result, "\"")
    result = strings.ConcatStr(result, "}")
    return result

fn jsonUnescapeString(raw: str): str =
    var out: str
    var i: int32
    while i < raw.len:
        if raw[i] == '\\':
            assert(i + 1 < raw.len, "unterminated json string escape")
            let escaped = raw[i + 1]
            if escaped == '"':
                out = strings.ConcatStr(out, "\"")
            elif escaped == '\\':
                out = strings.ConcatStr(out, "\\")
            elif escaped == '/':
                out = strings.ConcatStr(out, "/")
            elif escaped == 'n':
                out = strings.ConcatStr(out, "\n")
            elif escaped == 'r':
                out = strings.ConcatStr(out, "\r")
            elif escaped == 't':
                out = strings.ConcatStr(out, "\t")
            else:
                assert(false, "unsupported json string escape")
            i = i + 2
            continue
        out = strings.ConcatStr(out, strings.SliceBytes(raw, i, 1))
        i = i + 1
    return out

# ── JSON response parser ────────────────────────────────────────────────

# Parse the blocking spawn response JSON.
# {"pid":N,"exit_code":N,"stdout":"...","stderr":"..."}
fn parseSpawnResponse(json: str): ProcessResult =
    var result: ProcessResult
    result.stderr = ""
    result.error = ""
    var n: int32 = strings.Len(json)
    if n == 0:
        result.error = "empty response"
        return result

    # Check for error response
    if strings.HasPrefix(json, "{\"error\":"):
        # Extract error message
        var i: int32 = 10
        # Skip to opening quote of value
        while i < n and json[i] != '"':
            i = i + 1
        i = i + 1
        var errStart: int32 = i
        while i < n and json[i] != '"':
            i = i + 1
        result.error = jsonUnescapeString(strings.SliceBytes(json, errStart, i - errStart))
        return result

    # Parse success: {"pid":123,"exit_code":0,"stdout":"...","stderr":"..."}
    # Find "pid":
    var i: int32 = 0
    while i < n:
        if i + 5 < n and json[i] == '"' and json[i+1] == 'p' and json[i+2] == 'i' and json[i+3] == 'd' and json[i+4] == '"' and json[i+5] == ':':
            i = i + 6
            break
        i = i + 1
    # Parse pid digits
    var pidVal: int32 = 0
    while i < n and json[i] >= '0' and json[i] <= '9':
        pidVal = pidVal * 10 + (int32(json[i]) - int32('0'))
        i = i + 1
    result.pid = pidVal

    # Find "exit_code":
    while i < n:
        if i + 11 < n and json[i] == '"' and json[i+1] == 'e' and json[i+2] == 'x' and json[i+3] == 'i' and json[i+4] == 't' and json[i+5] == '_' and json[i+6] == 'c' and json[i+7] == 'o' and json[i+8] == 'd' and json[i+9] == 'e' and json[i+10] == '"' and json[i+11] == ':':
            i = i + 12
            break
        i = i + 1
    var exitVal: int32 = 0
    var neg: bool = false
    if i < n and json[i] == '-':
        neg = true
        i = i + 1
    while i < n and json[i] >= '0' and json[i] <= '9':
        exitVal = exitVal * 10 + (int32(json[i]) - int32('0'))
        i = i + 1
    if neg:
        exitVal = -exitVal
    result.exitCode = exitVal

    # Find "stdout":
    while i < n:
        if i + 8 < n and json[i] == '"' and json[i+1] == 's' and json[i+2] == 't' and json[i+3] == 'd' and json[i+4] == 'o' and json[i+5] == 'u' and json[i+6] == 't' and json[i+7] == '"' and json[i+8] == ':':
            i = i + 9
            break
        i = i + 1
    # Skip to opening " of value
    while i < n and json[i] != '"':
        i = i + 1
    i = i + 1
    var outStart: int32 = i
    while i < n:
        if json[i] == '\\':
            i = i + 1
            if i < n:
                i = i + 1
        elif json[i] == '"':
            break
        else:
            i = i + 1
    var outLen: int32 = i - outStart
    if outLen > 0:
        result.stdout = jsonUnescapeString(strings.SliceBytes(json, outStart, outLen))

    # Find "stderr":
    while i < n:
        if i + 8 < n and json[i] == '"' and json[i+1] == 's' and json[i+2] == 't' and json[i+3] == 'd' and json[i+4] == 'e' and json[i+5] == 'r' and json[i+6] == 'r' and json[i+7] == '"' and json[i+8] == ':':
            i = i + 9
            break
        i = i + 1
    while i < n and json[i] != '"':
        i = i + 1
    i = i + 1
    var errStart2: int32 = i
    while i < n:
        if json[i] == '\\':
            i = i + 1
            if i < n:
                i = i + 1
        elif json[i] == '"':
            break
        else:
            i = i + 1
    var errLen2: int32 = i - errStart2
    if errLen2 > 0:
        result.stderr = jsonUnescapeString(strings.SliceBytes(json, errStart2, errLen2))
    result.ok = true
    return result

fn parseSpawnHandle(json: str): ProcessHandle =
    var result: ProcessHandle
    result.pid = -1
    result.stdinFd = -1
    result.stdoutFd = -1
    result.stderrFd = -1
    result.error = ""
    var n: int32 = strings.Len(json)
    if n == 0:
        result.error = "empty response"
        return result
    if strings.HasPrefix(json, "{\"error\":"):
        var i: int32 = 10
        while i < n and json[i] != '"':
            i = i + 1
        i = i + 1
        var errStart: int32 = i
        while i < n and json[i] != '"':
            i = i + 1
        result.error = strings.SliceBytes(json, errStart, i - errStart)
        return result
    result.pid = parseJsonIntField(json, "pid")
    result.stdinFd = parseJsonIntField(json, "stdin_fd")
    result.stdoutFd = parseJsonIntField(json, "stdout_fd")
    result.stderrFd = parseJsonIntField(json, "stderr_fd")
    if result.pid <= 0 || result.stdinFd < 0 || result.stdoutFd < 0 || result.stderrFd < 0:
        result.error = "invalid process handle response"
        return result
    result.ok = true
    return result

fn parseSpawnPtyHandle(json: str): ProcessPtyHandle =
    var result: ProcessPtyHandle
    result.pid = -1
    result.ptyFd = -1
    result.error = ""
    var n: int32 = strings.Len(json)
    if n == 0:
        result.error = "empty response"
        return result
    if strings.HasPrefix(json, "{\"error\":"):
        var i: int32 = 10
        while i < n and json[i] != '"':
            i = i + 1
        i = i + 1
        var errStart: int32 = i
        while i < n and json[i] != '"':
            i = i + 1
        result.error = strings.SliceBytes(json, errStart, i - errStart)
        return result
    result.pid = parseJsonIntField(json, "pid")
    result.ptyFd = parseJsonIntField(json, "pty_fd")
    if result.pid <= 0 || result.ptyFd < 0:
        result.error = "invalid process pty handle response"
        return result
    result.ok = true
    return result

fn parseJsonIntField(json: str, key: str): int32 =
    var pattern: str = strings.ConcatStr(strings.ConcatStr("\"", key), "\":")
    var i: int32 = 0
    var n: int32 = strings.Len(json)
    var found: bool = false
    while i + pattern.len <= n:
        var matched: bool = true
        var j: int32 = 0
        while j < pattern.len:
            if json[i + j] != pattern[j]:
                matched = false
                break
            j = j + 1
        if matched:
            i = i + pattern.len
            found = true
            break
        i = i + 1
    if !found:
        return -1
    var neg: bool = false
    if i < n:
        if json[i] == '-':
            neg = true
            i = i + 1
    var value: int32 = 0
    var saw: bool = false
    while i < n:
        let ch = json[i]
        if ch < '0':
            break
        if ch > '9':
            break
        value = value * 10 + (int32(ch) - int32('0'))
        saw = true
        i = i + 1
    if !saw:
        return -1
    if neg:
        return -value
    return value

# ── High-level synchronous spawn ────────────────────────────────────────
# Spawns a process, waits for exit, collects all output.
# Uses the blocking C provider which internally uses select() to avoid pipe
# deadlock.

fn ProcessSpawn(command: str, args: str[], cwd: str, env: str[]): ProcessResult =
    var argsJson: str = argsToJson(args)
    var envJson: str = envToJson(env)
    var json: str = processSpawnBlockingRaw(command, argsJson, cwd, envJson)
    return parseSpawnResponse(json)

fn ProcessSpawnRaw(command: str, args: str[], cwd: str, env: str[]): ProcessHandle =
    var argsJson: str = argsToJson(args)
    var envJson: str = envToJson(env)
    var json: str = processSpawnRaw(command, argsJson, cwd, envJson)
    return parseSpawnHandle(json)

fn ProcessSpawnPty(command: str, args: str[], cwd: str, env: str[], rows: int32, cols: int32): ProcessPtyHandle =
    var argsJson: str = argsToJson(args)
    var ptyEnv: str[]
    ptyEnv = []
    for i in 0..<env.len:
        add(ptyEnv, env[i])
    add(ptyEnv, strings.ConcatStr("CHENG_PROCESS_PTY_ROWS=", strings.IntToStr(rows)))
    add(ptyEnv, strings.ConcatStr("CHENG_PROCESS_PTY_COLS=", strings.IntToStr(cols)))
    var envJson: str = envToJson(ptyEnv)
    var json: str = processSpawnPtyRaw(command, argsJson, cwd, envJson)
    return parseSpawnPtyHandle(json)

fn ProcessSpawnSeatbelt(command: str, args: str[], cwd: str, env: str[], profile: str): ProcessResult =
    var argsJson: str = argsToJson(args)
    var envJson: str = envToJson(env)
    var json: str = processSpawnSeatbeltBlockingRaw(command, argsJson, cwd, envJson, profile)
    return parseSpawnResponse(json)

fn ProcessSpawnSeatbeltRaw(command: str, args: str[], cwd: str, env: str[], profile: str): ProcessHandle =
    var argsJson: str = argsToJson(args)
    var envJson: str = envToJson(env)
    var json: str = processSpawnSeatbeltRaw(command, argsJson, cwd, envJson, profile)
    return parseSpawnHandle(json)

fn ProcessSpawnSeatbeltPty(command: str, args: str[], cwd: str, env: str[], rows: int32, cols: int32, profile: str): ProcessPtyHandle =
    var argsJson: str = argsToJson(args)
    var ptyEnv: str[]
    ptyEnv = []
    for i in 0..<env.len:
        add(ptyEnv, env[i])
    add(ptyEnv, strings.ConcatStr("CHENG_PROCESS_PTY_ROWS=", strings.IntToStr(rows)))
    add(ptyEnv, strings.ConcatStr("CHENG_PROCESS_PTY_COLS=", strings.IntToStr(cols)))
    var envJson: str = envToJson(ptyEnv)
    var json: str = processSpawnSeatbeltPtyRaw(command, argsJson, cwd, envJson, profile)
    return parseSpawnPtyHandle(json)

# ── Low-level wait ──────────────────────────────────────────────────────
# Wait for a process by PID. Returns exit code.
# Hard-fails: returns -1 on error.

fn ProcessWait(pid: int32): int32 =
    var code: int32 = processWaitRaw(pid)
    if code < 0:
        return -1
    return code

# Poll for process exit without closing stdout/stderr fds.
# Returns -2 while running, exit code when exited, -1 on error.

fn ProcessTryWait(pid: int32): int32 =
    return processTryWaitRaw(pid)

# ── Kill a process ──────────────────────────────────────────────────────
# Sends a signal to a process. 0 on success, -1 on error.

fn ProcessKill(pid: int32, signal: int32): int32 =
    return processKillRaw(pid, signal)

fn ProcessKillGroup(pid: int32, signal: int32): int32 =
    return processKillGroupRaw(pid, signal)

fn ProcessResizePty(fd: int32, rows: int32, cols: int32): int32 =
    return processResizePtyRaw(fd, rows, cols)

# ── Read from fd (non-blocking) ─────────────────────────────────────────

fn ProcessReadFd(fd: int32): str =
    return processReadFdRaw(fd)

fn ProcessReadFdBlocking(fd: int32, timeoutMs: int32): str =
    return processReadFdBlockingRaw(fd, timeoutMs)

fn ProcessReadFdBlockingEvent(fd: int32, timeoutMs: int32): str =
    return processReadFdBlockingEventRaw(fd, timeoutMs)

# ── Write to fd ─────────────────────────────────────────────────────────

fn ProcessWriteFd(fd: int32, data: str): int32 =
    return processWriteFdRaw(fd, data)

# ── Close fd ────────────────────────────────────────────────────────────

fn ProcessCloseFd(fd: int32): int32 =
    return processCloseFdRaw(fd)
