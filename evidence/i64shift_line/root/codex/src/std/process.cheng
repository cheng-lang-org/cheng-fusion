@importc("cheng_process_spawn")
fn processSpawnRaw(command: str, args: str, cwd: str, env: str): str

@abi_internal
@importc("cheng_process_spawn_pty")
fn processSpawnPtyRaw(command: str, args: str, cwd: str, env: str): str

