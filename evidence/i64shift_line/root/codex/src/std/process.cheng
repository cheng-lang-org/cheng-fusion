# Process execution module — POSIX fork/exec provider bindings.
# Provides low-level (ProcessSpawnRaw) and high-level (ProcessSpawn,
# ProcessSpawnBlocking) process execution.

import std/strings

# ── Types ────────────────────────────────────────────────────────────────

type ProcessResult =
    ok: bool
    pid: int32
    exitCode: int32
    stdout: str
    stderr: str
    error: str

type ProcessHandle =
    ok: bool
    pid: int32
    stdinFd: int32
    stdoutFd: int32
    stderrFd: int32
    error: str

type ProcessPtyHandle =
    ok: bool
    pid: int32
    ptyFd: int32
    error: str

# ── C provider imports ──────────────────────────────────────────────────

