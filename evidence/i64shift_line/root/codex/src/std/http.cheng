# HTTP client - libcurl provider bindings
# C provider returns JSON: {"status":200,"body":"..."} or {"error":"..."}

import std/strings
import std/rawbytes
import std/rawmem_support
import std/system

@importc("calloc")
fn httpAbiCalloc(count: int64, size: int64): ptr

@importc("memcpy")
fn httpAbiMemcpy(dst: ptr, src: ptr, count: int64): ptr

@importc("free")
fn httpAbiFree(raw: ptr)

type
    HttpResult =
        ok: bool
        statusCode: int32
        body: str
        error: str

@ffi_owned_result(free = free)
@importc("cheng_http_get")
fn httpRawGetAbi(url: cstring, headers: cstring): owned_cstring

@ffi_owned_result(free = free)
@importc("cheng_http_post")
fn httpRawPostAbi(url: cstring, body: cstring, headers: cstring): owned_cstring

@ffi_owned_result(free = free)
@importc("cheng_http_delete")
fn httpRawDeleteAbi(url: cstring, headers: cstring): owned_cstring

@ffi_owned_result(free = free)
@importc("cheng_http_request_with_timeout")
fn httpRawRequestWithTimeoutAbi(method: cstring,
                                url: cstring,
                                body: cstring,
                                headers: cstring,
                                timeoutSeconds: int32): owned_cstring

fn httpCString(text: str): cstring =
    let raw = httpAbiCalloc(int64(text.len) + int64(1), int64(1))
    if raw == nil:
        return cstring(nil)
    if text.len > 0:
        httpAbiMemcpy(raw, text.data, int64(text.len))
    return cstring(raw)

fn httpFreeCString(raw: cstring) =
    if ptr(raw) != nil:
        httpAbiFree(ptr(raw))

fn httpRawGet(url: str, headers: str): str =
    let urlRaw = httpCString(url)
    let headersRaw = httpCString(headers)
    let out: str = httpRawGetAbi(urlRaw, headersRaw)
    httpFreeCString(urlRaw)
    httpFreeCString(headersRaw)
    return out

fn httpRawPost(url: str, body: str, headers: str): str =
    let urlRaw = httpCString(url)
    let bodyRaw = httpCString(body)
    let headersRaw = httpCString(headers)
    let out: str = httpRawPostAbi(urlRaw, bodyRaw, headersRaw)
    httpFreeCString(urlRaw)
    httpFreeCString(bodyRaw)
    httpFreeCString(headersRaw)
    return out

fn httpRawDelete(url: str, headers: str): str =
    let urlRaw = httpCString(url)
    let headersRaw = httpCString(headers)
    let out: str = httpRawDeleteAbi(urlRaw, headersRaw)
    httpFreeCString(urlRaw)
    httpFreeCString(headersRaw)
    return out

fn httpRawRequestWithTimeout(method: str, url: str, body: str, headers: str, timeoutSeconds: int32): str =
    let methodRaw = httpCString(method)
    let urlRaw = httpCString(url)
    let bodyRaw = httpCString(body)
    let headersRaw = httpCString(headers)
    let out: str = httpRawRequestWithTimeoutAbi(methodRaw,
                                                urlRaw,
                                                bodyRaw,
                                                headersRaw,
                                                timeoutSeconds)
    httpFreeCString(methodRaw)
    httpFreeCString(urlRaw)
    httpFreeCString(bodyRaw)
    httpFreeCString(headersRaw)
    return out

@importc("socket")
fn httpSocket(domain: int32, kind: int32, protocol: int32): int32
@importc("connect")
fn httpConnectRaw(fd: int32, addr: ptr, addrLen: int32): int32
@importc("send")
fn httpSendRaw(fd: int32, buf: ptr, len: int64, flags: int32): int64
@importc("recv")
fn httpRecvRaw(fd: int32, buf: ptr, len: int64, flags: int32): int64
@importc("close")
fn httpCloseRaw(fd: int32): int32

const HttpAfInet: int32 = 2
const HttpSockStream: int32 = 1
const HttpIpProtoTcp: int32 = 6
const HttpSockaddrLen: int32 = 16
const HttpRecvChunkBytes: int32 = 4096

# Parse JSON response from the C provider.
# The JSON is guaranteed to be well-formed (produced by our own C code).
fn HttpParseResponse(json: str): HttpResult =
    var result: HttpResult
    let n: int32 = strings.Len(json)
    if n == 0:
        result.error = "http provider returned empty response"
        return result

    # Check for error: {"error":"..."}
    # prefix length of {"error": is 9
    if strings.HasPrefix(json, "{\"error\":"):
        var i: int32 = 9
        # skip to opening quote of the value
        while i < n and json[i] != '"':
            i = i + 1
        i = i + 1  # skip opening quote
        let errStart: int32 = i
        while i < n and json[i] != '"':
            i = i + 1
        result.error = strings.SliceBytes(json, errStart, i - errStart)
        return result

    # Check for success: {"status":200,"body":"..."}
    # prefix length of {"status": is 10
    if strings.HasPrefix(json, "{\"status\":"):
        var i: int32 = 10
        # parse status code digits
        var code: int32 = 0
        while i < n and json[i] >= '0' and json[i] <= '9':
            code = code * 10 + (int32(json[i]) - int32('0'))
            i = i + 1
        result.statusCode = code

        # find "body": (skip to opening quote of body value)
        while i < n:
            if json[i] == '"':
                # check if this is the body key
                if i + 6 < n and json[i+1] == 'b' and json[i+2] == 'o' and json[i+3] == 'd' and json[i+4] == 'y' and json[i+5] == '"' and json[i+6] == ':':
                    i = i + 7  # skip "body":
                    break
                i = i + 1
            else:
                i = i + 1

        # skip opening " of body value
        if i < n and json[i] == '"':
            i = i + 1
            var bodyValue: str
            while i < n:
                if json[i] == '\\':
                    i = i + 1  # skip backslash
                    if i < n:
                        if json[i] == 'n':
                            bodyValue = strings.ConcatStr(bodyValue, "\n")
                        elif json[i] == 'r':
                            bodyValue = strings.ConcatStr(bodyValue, "\r")
                        elif json[i] == 't':
                            bodyValue = strings.ConcatStr(bodyValue, "\t")
                        elif json[i] == '"':
                            bodyValue = strings.ConcatStr(bodyValue, "\"")
                        elif json[i] == '\\':
                            bodyValue = strings.ConcatStr(bodyValue, "\\")
                        elif json[i] == '/':
                            bodyValue = strings.ConcatStr(bodyValue, "/")
                        else:
                            bodyValue = strings.ConcatStr(bodyValue, strings.SliceBytes(json, i, 1))
                        i = i + 1
                elif json[i] == '"':
                    break
                else:
                    bodyValue = strings.ConcatStr(bodyValue, strings.SliceBytes(json, i, 1))
                    i = i + 1
            result.body = bodyValue

        result.ok = true
        return result

    result.error = "unrecognized response from http provider"
    return result

fn httpFindByte(text: str, start: int32, needle: char): int32 =
    var i = start
    while i < text.len:
        if text[i] == needle:
            return i
        i = i + 1
    return -1

fn httpParseUrl(url: str, outHost: var str, outPort: var int32, outPath: var str): bool =
    outHost = ""
    outPort = 80
    outPath = "/"
    if url.len < 7 || strings.SliceBytes(url, 0, 7) != "http://":
        return false
    var pos: int32 = 7
    let hostStart = pos
    while pos < url.len && url[pos] != ':' && url[pos] != '/':
        pos = pos + 1
    if pos <= hostStart:
        return false
    outHost = strings.SliceBytes(url, hostStart, pos - hostStart)
    if pos < url.len && url[pos] == ':':
        pos = pos + 1
        let portStart = pos
        var parsedPort: int32
        while pos < url.len && url[pos] >= '0' && url[pos] <= '9':
            parsedPort = parsedPort * 10 + (int32(url[pos]) - int32('0'))
            pos = pos + 1
        if pos <= portStart || parsedPort <= 0:
            return false
        outPort = parsedPort
    if pos < url.len:
        if url[pos] != '/':
            return false
        outPath = strings.SliceBytes(url, pos, url.len - pos)
    return true

fn httpParseIpv4(host: str, out0: var int32, out1: var int32, out2: var int32, out3: var int32): bool =
    if host == "localhost":
        out0 = 127
        out1 = 0
        out2 = 0
        out3 = 1
        return true
    var parts: int32[4]
    var partIndex: int32
    var value: int32
    var sawDigit: bool
    var i: int32
    while i < host.len:
        let ch = host[i]
        if ch >= '0' && ch <= '9':
            sawDigit = true
            value = value * 10 + (int32(ch) - int32('0'))
            if value > 255:
                return false
        elif ch == '.':
            if !sawDigit || partIndex >= 4:
                return false
            parts[partIndex] = value
            partIndex = partIndex + 1
            value = 0
            sawDigit = false
        else:
            return false
        i = i + 1
    if !sawDigit || partIndex != 3:
        return false
    parts[3] = value
    out0 = parts[0]
    out1 = parts[1]
    out2 = parts[2]
    out3 = parts[3]
    return true

fn httpBuildSockaddr(host: str, port: int32, outAddr: var rawbytes.Bytes): bool =
    var b0: int32
    var b1: int32
    var b2: int32
    var b3: int32
    if !httpParseIpv4(host, b0, b1, b2, b3):
        return false
    outAddr = rawbytes.BytesAlloc(HttpSockaddrLen)
    if rawbytes.BytesLen(outAddr) < HttpSockaddrLen:
        return false
    rawbytes.BytesSet(outAddr, 0, 0)
    rawbytes.BytesSet(outAddr, 1, HttpAfInet)
    rawbytes.BytesSet(outAddr, 2, (port >> 8) & 255)
    rawbytes.BytesSet(outAddr, 3, port & 255)
    rawbytes.BytesSet(outAddr, 4, b0)
    rawbytes.BytesSet(outAddr, 5, b1)
    rawbytes.BytesSet(outAddr, 6, b2)
    rawbytes.BytesSet(outAddr, 7, b3)
    var i: int32 = 8
    while i < HttpSockaddrLen:
        rawbytes.BytesSet(outAddr, i, 0)
        i = i + 1
    return true

fn httpConnect(host: str, port: int32): int32 =
    var addr: rawbytes.Bytes
    if !httpBuildSockaddr(host, port, addr):
        return -1
    let fd = httpSocket(HttpAfInet, HttpSockStream, HttpIpProtoTcp)
    if fd < 0:
        return -1
    if httpConnectRaw(fd, addr.data, HttpSockaddrLen) != 0:
        httpCloseRaw(fd)
        return -1
    return fd

fn httpSendAll(fd: int32, data: str): bool =
    var sent: int32
    while sent < data.len:
        let wrote = httpSendRaw(fd, rawmem_support.RawmemPtrAdd(data.data, sent), int64(data.len - sent), 0)
        if wrote <= int64(0):
            return false
        sent = sent + int32(wrote)
    return true

fn httpRecvAll(fd: int32): str =
    var out: str
    var buf = rawbytes.BytesAlloc(HttpRecvChunkBytes)
    if rawbytes.BytesLen(buf) < HttpRecvChunkBytes:
        return ""
    while true:
        let n = httpRecvRaw(fd, buf.data, int64(HttpRecvChunkBytes), 0)
        if n <= int64(0):
            break
        out = strings.ConcatStr(out, system.StrFromBytesCopy(buf.data, int32(n)))
    return out

fn httpDecodeHeaderString(input: str, start: int32, outValue: var str): int32 =
    var i = start
    outValue = ""
    while i < input.len:
        let ch = input[i]
        if ch == '\\':
            i = i + 1
            if i >= input.len:
                return -1
            let esc = input[i]
            if esc == '"' || esc == '\\' || esc == '/':
                outValue = strings.ConcatStr(outValue, strings.SliceBytes(input, i, 1))
            elif esc == 'n':
                outValue = strings.ConcatStr(outValue, "\n")
            elif esc == 'r':
                outValue = strings.ConcatStr(outValue, "\r")
            elif esc == 't':
                outValue = strings.ConcatStr(outValue, "\t")
            else:
                return -1
        elif ch == '"':
            return i + 1
        else:
            outValue = strings.ConcatStr(outValue, strings.SliceBytes(input, i, 1))
        i = i + 1
    return -1

fn httpHeaderLines(headersJson: str): str =
    var out: str
    var i: int32
    while i < headersJson.len:
        if headersJson[i] != '"':
            i = i + 1
            continue
        var value: str
        let next = httpDecodeHeaderString(headersJson, i + 1, value)
        if next < 0:
            return out
        out = strings.ConcatStr(out, value)
        out = strings.ConcatStr(out, "\r\n")
        i = next
    return out

fn httpBuildRequest(method: str, host: str, path: str, body: str, headersJson: str): str =
    var out = strings.ConcatStr(method, " ")
    out = strings.ConcatStr(out, path)
    out = strings.ConcatStr(out, " HTTP/1.1\r\nHost: ")
    out = strings.ConcatStr(out, host)
    out = strings.ConcatStr(out, "\r\n")
    out = strings.ConcatStr(out, httpHeaderLines(headersJson))
    if body.len > 0 || method == "POST":
        out = strings.ConcatStr(out, "Content-Length: ")
        out = strings.ConcatStr(out, strings.IntToStr(body.len))
        out = strings.ConcatStr(out, "\r\n")
    out = strings.ConcatStr(out, "Connection: close\r\n\r\n")
    out = strings.ConcatStr(out, body)
    return out

fn httpParseStatus(raw: str): int32 =
    let firstSpace = httpFindByte(raw, 0, ' ')
    if firstSpace < 0 || firstSpace + 4 > raw.len:
        return 0
    var code: int32
    var i = firstSpace + 1
    while i < firstSpace + 4:
        let ch = raw[i]
        if ch < '0' || ch > '9':
            return 0
        code = code * 10 + (int32(ch) - int32('0'))
        i = i + 1
    return code

fn httpBodyOffset(raw: str): int32 =
    var i: int32
    while i + 3 < raw.len:
        if raw[i] == '\r' && raw[i + 1] == '\n' && raw[i + 2] == '\r' && raw[i + 3] == '\n':
            return i + 4
        i = i + 1
    return -1

fn httpDirectRequest(method: str, url: str, body: str, headers: str): HttpResult =
    var result: HttpResult
    if method != "GET" && method != "POST" && method != "DELETE":
        result.error = "unsupported http method"
        return result
    var host: str
    var port: int32
    var path: str
    if !httpParseUrl(url, host, port, path):
        result.error = strings.ConcatStr("unsupported or invalid http url: ", url)
        return result
    let fd = httpConnect(host, port)
    if fd < 0:
        result.error = "connect failed"
        return result
    if !httpSendAll(fd, httpBuildRequest(method, host, path, body, headers)):
        httpCloseRaw(fd)
        result.error = "send failed"
        return result
    let raw = httpRecvAll(fd)
    httpCloseRaw(fd)
    if raw == "":
        result.error = "empty response"
        return result
    let status = httpParseStatus(raw)
    let bodyOffset = httpBodyOffset(raw)
    if status <= 0 || bodyOffset < 0:
        result.error = "invalid http response"
        return result
    result.ok = true
    result.statusCode = status
    result.body = strings.SliceBytes(raw, bodyOffset, raw.len - bodyOffset)
    return result

fn HttpGet(url: str, headers: str): HttpResult =
    return HttpParseResponse(httpRawGet(url, headers))

fn HttpPost(url: str, body: str, headers: str): HttpResult =
    return HttpParseResponse(httpRawPost(url, body, headers))

fn HttpDelete(url: str, headers: str): HttpResult =
    return HttpParseResponse(httpRawDelete(url, headers))

fn HttpRequestWithTimeout(method: str, url: str, body: str, headers: str, timeoutSeconds: int32): HttpResult =
    if timeoutSeconds <= 0:
        var result: HttpResult
        result.error = "http timeout_seconds must be positive"
        return result
    return HttpParseResponse(httpRawRequestWithTimeout(method, url, body, headers, timeoutSeconds))
