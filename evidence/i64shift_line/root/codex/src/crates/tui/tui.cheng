# TUI — status line formatting.
# Ported from codex-rs/tui/src/{status/mod,status/format,bottom_pane/status_line_style}.rs
# Covers: formatTuiStatusLine

import std/strings

const RustCsgTuiFunctionCount: int32 = 1
fn RustCsgTuiFunctionNames(): str =
    return "formatTuiStatusLine"

# Format a TUI status line string.
# Example: formatTuiStatusLine("Plan Mode", "gpt-5", 3) => "Plan Mode | gpt-5 | Turn 3"
fn RustCsgFormatTuiStatusLine(mode: str, model: str, turnCount: int32): str =
    let turnStr = strings.ConcatStr("Turn ", strings.IntToStr(turnCount))
    return strings.ConcatStr(strings.ConcatStr(strings.ConcatStr(mode, " | "), model), strings.ConcatStr(" | ", turnStr))
