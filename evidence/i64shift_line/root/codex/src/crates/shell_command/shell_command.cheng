# ═══════════════════════════════════════════════════════════════════════════════
# shell_command: shell command parsing, type definitions, and safety detection
# Ported from codex-rs/shell-command/src/ and codex-rs/protocol/src/
# ═══════════════════════════════════════════════════════════════════════════════

import std/strings
import std/strutils as strutil

# ═══════════════════════════════════════════════════════════════════════════════
# ShlexJoinTwo — pure Cheng implementation
# ═══════════════════════════════════════════════════════════════════════════════

fn shellIsSafeChar(ch: int32): bool =
    if ch >= 'a' && ch <= 'z': return true
    if ch >= 'A' && ch <= 'Z': return true
    if ch >= '0' && ch <= '9': return true
    let safe = "%+-./:@_~=,"
    for i in 0..<safe.len:
        if safe[i] == ch: return true
    return false

fn shellNeedsQuoting(text: str): bool =
    for i in 0..<text.len:
        if !shellIsSafeChar(text[i]): return true
    return false

fn shellQuoteToken(text: str): str =
    if !shellNeedsQuoting(text): return text
    var out: str = "'"
    for i in 0..<text.len:
        if text[i] == '\'':
            out = strings.ConcatStr(out, "'\\''")
        else:
            out = strings.ConcatStr(out, strings.SliceBytes(text, i, 1))
    return strings.ConcatStr(out, "'")

# ═══════════════════════════════════════════════════════════════════════════════
# ShlexJoinTwo — join two tokens with shell quoting
# ═══════════════════════════════════════════════════════════════════════════════

fn RustCsgShlexJoinTwoImpl(a: str, b: str): str =
    if a == "": return b
    if b == "": return a
    var qa = shellQuoteToken(a)
    var qb = shellQuoteToken(b)
    return strings.ConcatStr(strings.ConcatStr(qa, " "), qb)

# ═══════════════════════════════════════════════════════════════════════════════
# ShellIsDangerousCommand — detect destructive commands (rm -rf, etc.)
# ═══════════════════════════════════════════════════════════════════════════════

fn skipSpaces(text: str, start: int32): int32 =
    var i = start
    while i < text.len && text[i] == ' ': i = i + 1
    return i

fn wordEnd(text: str, start: int32): int32 =
    var i = start
    while i < text.len && text[i] != ' ': i = i + 1
    return i

fn nextWordStart(text: str, start: int32): int32 =
    return skipSpaces(text, wordEnd(text, skipSpaces(text, start)))

fn tokenEqAt(text: str, start: int32, word: str): bool =
    let s = skipSpaces(text, start)
    let e = wordEnd(text, s)
    if e - s != word.len: return false
    for i in 0..<word.len:
        if text[s + i] != word[i]: return false
    return true

fn rmFlagDangerousAt(text: str, start: int32): bool =
    let s = skipSpaces(text, start)
    if s >= text.len: return false
    if text[s] != '-': return false
    if s + 1 >= text.len: return false
    if text[s + 1] == 'r' || text[s + 1] == 'f': return true
    return false

fn RustCsgShellIsDangerousImpl(cmd: str): bool =
    if cmd.len <= 0: return false
    let first = skipSpaces(cmd, 0)
    if first >= cmd.len: return false
    if tokenEqAt(cmd, first, "sudo"):
        let sub1 = nextWordStart(cmd, first)
        let sub2 = nextWordStart(cmd, sub1)
        if tokenEqAt(cmd, sub1, "rm") && rmFlagDangerousAt(cmd, sub2): return true
        return false
    if tokenEqAt(cmd, first, "rm"):
        let flags = nextWordStart(cmd, first)
        if rmFlagDangerousAt(cmd, flags): return true
    return false

# ═══════════════════════════════════════════════════════════════════════════════
# ShellIsSafeCommand — detect known-safe read-only commands
# ═══════════════════════════════════════════════════════════════════════════════

fn RustCsgShellIsSafeImpl(cmd: str): bool =
    if cmd.len <= 0: return false
    let first = skipSpaces(cmd, 0)
    if first >= cmd.len: return false
    let safeCmds: str[] = [
        "cat","cd","cut","echo","expr","false",
        "grep","head","id","ls","nl","pwd",
        "rev","seq","stat","tail","tr","true",
        "uname","uniq","wc","which","whoami","sed",
        "base64","find","rg","git"
    ]
    for i in 0..<safeCmds.len:
        if tokenEqAt(cmd, first, safeCmds[i]): return true
    return false

# ═══════════════════════════════════════════════════════════════════════════════
# ShellType enumeration — matches Rust shell_detect::ShellType
# ═══════════════════════════════════════════════════════════════════════════════

const
    RustCsgShellTypeZsh: int32 = 0
    RustCsgShellTypeBash: int32 = 1
    RustCsgShellTypeSh: int32 = 2
    RustCsgShellTypePowerShell: int32 = 3
    RustCsgShellTypeCmd: int32 = 4
    RustCsgShellTypeUnknown: int32 = 5

fn RustCsgShellTypeToString(t: int32): str =
    if t == RustCsgShellTypeZsh:
        return "zsh"
    elif t == RustCsgShellTypeBash:
        return "bash"
    elif t == RustCsgShellTypeSh:
        return "sh"
    elif t == RustCsgShellTypePowerShell:
        return "powershell"
    elif t == RustCsgShellTypeCmd:
        return "cmd"
    else:
        return "unknown"

# ═══════════════════════════════════════════════════════════════════════════════
# Shell detection — ported from Rust shell_detect.rs
# ═══════════════════════════════════════════════════════════════════════════════

# Detect shell type from a path or executable name.
# Returns one of the RustCsgShellType* constants.
fn RustCsgDetectShellType(shellPath: str): int32 =
    if shellPath == "":
        return RustCsgShellTypeUnknown

    # Extract the last path component (file name)
    var slashIdx: int32 = -1
    for i in 0..<shellPath.len:
        if shellPath[i] == '/':
            slashIdx = i
    var name: str
    if slashIdx >= 0:
        name = strings.SliceBytes(shellPath, slashIdx + 1, shellPath.len - slashIdx - 1)
    else:
        name = shellPath

    if name == "":
        return RustCsgShellTypeUnknown

    # Remove extension (.exe, .cmd, .bat, .com) for matching
    var base: str = name
    let extensions: str[] = [".exe", ".cmd", ".bat", ".com"]
    for ei in 0..<extensions.len:
        let ext = extensions[ei]
        let extLen = ext.len
        if base.len > extLen:
            let dotIdx = base.len - extLen
            var suffixMatch: bool = true
            for si in 0..<extLen:
                if base[dotIdx + si] != ext[si]:
                    suffixMatch = false
                    break
            if suffixMatch:
                base = strings.SliceBytes(base, 0, dotIdx)
                break

    # Check known shell names
    if base == "zsh":
        return RustCsgShellTypeZsh
    elif base == "bash":
        return RustCsgShellTypeBash
    elif base == "sh":
        return RustCsgShellTypeSh
    elif base == "pwsh" || base == "powershell":
        return RustCsgShellTypePowerShell
    elif base == "cmd":
        return RustCsgShellTypeCmd
    else:
        return RustCsgShellTypeUnknown

# ═══════════════════════════════════════════════════════════════════════════════
# ShellCommand type — a structured command with tokens and metadata
# ═══════════════════════════════════════════════════════════════════════════════

type
    RustCsgShellCommand =
        tokens: str[]
        raw: str
        shellType: int32
        executable: str
        cwd: str
        envCount: int32

fn RustCsgShellCommandNew(tokens: str[]): RustCsgShellCommand =
    var result: RustCsgShellCommand
    result.tokens = tokens
    if tokens.len > 0:
        result.executable = tokens[0]
        result.raw = RustCsgShlexJoinTwoImpl(tokens[0], "")
    result.shellType = RustCsgShellTypeUnknown
    result.cwd = ""
    result.envCount = 0
    return result

fn RustCsgShellCommandDetectShell(cmd: var RustCsgShellCommand) =
    if cmd.tokens.len > 0:
        cmd.shellType = RustCsgDetectShellType(cmd.executable)

fn RustCsgShellCommandIsDangerous(cmd: RustCsgShellCommand): bool =
    return RustCsgShellIsDangerousImpl(cmd.raw)

fn RustCsgShellCommandIsSafe(cmd: RustCsgShellCommand): bool =
    return RustCsgShellIsSafeImpl(cmd.raw)

# ═══════════════════════════════════════════════════════════════════════════════
# ExitStatus type — exit code and signal information
# ═══════════════════════════════════════════════════════════════════════════════

type
    RustCsgExitStatus =
        code: int32
        signal: int32
        signaled: bool
        success: bool

const
    RustCsgExitStatusCodeSuccess: int32 = 0

fn RustCsgExitStatusNew(): RustCsgExitStatus =
    var result: RustCsgExitStatus
    result.code = -1
    result.signal = 0
    result.signaled = false
    result.success = false
    return result

fn RustCsgExitStatusFromCode(code: int32): RustCsgExitStatus =
    var result: RustCsgExitStatus
    result.code = code
    result.signal = 0
    result.signaled = false
    result.success = code == RustCsgExitStatusCodeSuccess
    return result

fn RustCsgExitStatusFromSignal(signal: int32): RustCsgExitStatus =
    var result: RustCsgExitStatus
    result.code = -1
    result.signal = signal
    result.signaled = true
    result.success = false
    return result

fn RustCsgExitStatusIsOk(es: RustCsgExitStatus): bool =
    return es.success

# ═══════════════════════════════════════════════════════════════════════════════
# CommandResult type — full output from a shell command execution
# ═══════════════════════════════════════════════════════════════════════════════

type
    RustCsgCommandResult =
        exitStatus: RustCsgExitStatus
        stdout: str
        stderr: str
        command: str
        durationMs: int32

fn RustCsgCommandResultNew(): RustCsgCommandResult =
    var result: RustCsgCommandResult
    result.exitStatus = RustCsgExitStatusNew()
    result.stdout = ""
    result.stderr = ""
    result.command = ""
    result.durationMs = 0
    return result

fn RustCsgCommandResultSucceeded(r: RustCsgCommandResult): bool =
    return RustCsgExitStatusIsOk(r.exitStatus)

# ═══════════════════════════════════════════════════════════════════════════════
# Command extraction — ported from parse_command.rs
# ═══════════════════════════════════════════════════════════════════════════════

# Extract bash -lc or -c command from a tokenized shell command.
# Returns (shell, script) if the command starts with bash/zsh/sh followed by -lc or -c.
# Otherwise returns ("", "").
fn RustCsgExtractBashCommand(tokens: str[]): (str, str) =
    if tokens.len < 3:
        return ("", "")
    let shell = tokens[0]
    let flag = tokens[1]
    let detected = RustCsgDetectShellType(shell)
    if detected != RustCsgShellTypeBash && detected != RustCsgShellTypeZsh && detected != RustCsgShellTypeSh:
        return ("", "")
    if flag != "-lc" && flag != "-c":
        return ("", "")
    let script = tokens[tokens.len - 1]
    return (shell, script)

# Extract PowerShell -Command or -c command from a tokenized command array.
# Returns (shell, script) if the command starts with pwsh/powershell followed
# by -Command/-c flag.
# Otherwise returns ("", "").
fn RustCsgExtractPowershellCommand(tokens: str[]): (str, str) =
    if tokens.len < 3:
        return ("", "")
    let shell = tokens[0]
    let detected = RustCsgDetectShellType(shell)
    if detected != RustCsgShellTypePowerShell:
        return ("", "")

    # Known PowerShell flags we tolerate before -Command
    let knownFlags: str[] = ["-nologo", "-noprofile", "-noninteractive", "-mta", "-sta"]
    var i: int32 = 1
    while i + 1 < tokens.len:
        let arg = tokens[i]
        # Manual ASCII lowercase for comparison
        var argLower: str = ""
        for ci in 0..<arg.len:
            let ch = arg[ci]
            if ch >= 'A' && ch <= 'Z':
                argLower = strutil.Join([argLower, strings.SliceBytes("abcdefghijklmnopqrstuvwxyz", ch - 'A', 1)], "")
            else:
                argLower = strutil.Join([argLower, strings.SliceBytes(arg, ci, 1)], "")
        var isKnown: bool = false
        for j in 0..<knownFlags.len:
            if argLower == knownFlags[j]:
                isKnown = true
                break
        if isKnown:
            i = i + 1
            continue
        # Check for -Command or -c
        if argLower == "-command" || argLower == "-c":
            return (shell, tokens[i + 1])
        # Unknown flag or non-flag token — bail
        return ("", "")
    return ("", "")

# Extract shell and script from a tokenized command array.
# Tries bash/zsh/sh -lc/-c first, then PowerShell -Command/-c.
fn RustCsgExtractShellCommand(tokens: str[]): (str, str) =
    let (shell, script) = RustCsgExtractBashCommand(tokens)
    if shell != "":
        return (shell, script)
    return RustCsgExtractPowershellCommand(tokens)

# ═══════════════════════════════════════════════════════════════════════════════
# Shlex operations
# ═══════════════════════════════════════════════════════════════════════════════

# Join command tokens into a single shell command string.
# Uses the pure Cheng ShlexJoinTwo implementation pairwise.
fn RustCsgShlexJoin(tokens: str[]): str =
    if tokens.len == 0:
        return ""
    var result: str = tokens[0]
    var i: int32 = 1
    while i < tokens.len:
        result = RustCsgShlexJoinTwoImpl(result, tokens[i])
        i = i + 1
    return result

# Join two tokens into a shell-escaped command string.
fn RustCsgShlexJoinTwo(a: str, b: str): str =
    return RustCsgShlexJoinTwoImpl(a, b)

# ── Provider ABI exports ───────────────────────────────────────────────
@abi_internal
@exportc("ShlexJoinTwo")
fn ShlexJoinTwoExport(a: str, b: str): str =
    return RustCsgShlexJoinTwoImpl(a, b)

@abi_internal
@exportc("ShellIsDangerousCommand")
fn ShellIsDangerousCommandExport(cmd: str): int32 =
    if RustCsgShellIsDangerousImpl(cmd): return 1
    return 0

@abi_internal
@exportc("ShellIsSafeCommand")
fn ShellIsSafeCommandExport(cmd: str): int32 =
    if RustCsgShellIsSafeImpl(cmd): return 1
    return 0

# Check if a command string is known-dangerous (rm -rf, sudo rm -rf, etc.)
fn RustCsgShellIsDangerousCommand(cmd: str): bool =
    return RustCsgShellIsDangerousImpl(cmd)

# Check if a command string is known-safe (read-only commands like cat, ls, grep, etc.)
fn RustCsgShellIsSafeCommand(cmd: str): bool =
    return RustCsgShellIsSafeImpl(cmd)

# ═══════════════════════════════════════════════════════════════════════════════
# ParsedCommand type — matches Rust codex_protocol::parse_command::ParsedCommand
# ═══════════════════════════════════════════════════════════════════════════════

const
    RustCsgParsedCommandUnknown: int32 = 0
    RustCsgParsedCommandRead: int32 = 1
    RustCsgParsedCommandListFiles: int32 = 2
    RustCsgParsedCommandSearch: int32 = 3

# ═══════════════════════════════════════════════════════════════════════════════
# Approval type constants
# These map to concepts in codex-rs/protocol/src/approvals.rs
# ═══════════════════════════════════════════════════════════════════════════════

# Approval decision status
const
    RustCsgApprovalDecisionApproved: int32 = 0
    RustCsgApprovalDecisionDenied: int32 = 1
    RustCsgApprovalDecisionPending: int32 = 2

# ApprovalRequest — a request to execute a shell command that requires approval
type
    RustCsgApprovalRequest =
        command: RustCsgShellCommand
        reason: str
        decision: int32
        requestId: str

fn RustCsgApprovalRequestNew(cmd: RustCsgShellCommand, reason: str): RustCsgApprovalRequest =
    var result: RustCsgApprovalRequest
    result.command = cmd
    result.reason = reason
    result.decision = RustCsgApprovalDecisionPending
    result.requestId = ""
    return result

fn RustCsgApprovalRequestIsApproved(req: RustCsgApprovalRequest): bool =
    return req.decision == RustCsgApprovalDecisionApproved

fn RustCsgApprovalRequestIsDenied(req: RustCsgApprovalRequest): bool =
    return req.decision == RustCsgApprovalDecisionDenied

fn RustCsgApprovalRequestIsPending(req: RustCsgApprovalRequest): bool =
    return req.decision == RustCsgApprovalDecisionPending

# ApprovalResponse — the result of an approval decision
type
    RustCsgApprovalResponse =
        approved: bool
        requestId: str
        reason: str
        sandboxOverride: int32

fn RustCsgApprovalResponseNew(approved: bool, requestId: str, reason: str): RustCsgApprovalResponse =
    var result: RustCsgApprovalResponse
    result.approved = approved
    result.requestId = requestId
    result.reason = reason
    result.sandboxOverride = RustCsgSandboxPermissionsUseDefault
    return result

# ═══════════════════════════════════════════════════════════════════════════════
# Sandbox permission override enum — maps to models.rs SandboxPermissions
# ═══════════════════════════════════════════════════════════════════════════════

const
    RustCsgSandboxPermissionsUseDefault: int32 = 0
    RustCsgSandboxPermissionsRequireEscalated: int32 = 1
    RustCsgSandboxPermissionsWithAdditionalPermissions: int32 = 2

fn RustCsgSandboxPermissionsRequiresEscalated(v: int32): bool =
    return v == RustCsgSandboxPermissionsRequireEscalated

fn RustCsgSandboxPermissionsRequestsOverride(v: int32): bool =
    return v != RustCsgSandboxPermissionsUseDefault

# ═══════════════════════════════════════════════════════════════════════════════
# Module metadata
# ═══════════════════════════════════════════════════════════════════════════════

const RustCsgShellCommandFunctionCount: int32 = 20

fn RustCsgShellCommandFunctionNames(): str =
    return "detectShellType,extractBashCommand,extractPowershellCommand,extractShellCommand,shlexJoin,shlexJoinTwo,shellIsDangerousCommand,shellIsSafeCommand,shellCommandNew,shellCommandDetectShell,shellCommandIsDangerous,shellCommandIsSafe,exitStatusFromCode,exitStatusFromSignal,exitStatusIsOk,commandResultNew,commandResultSucceeded,approvalRequestNew,approvalRequestIsApproved,approvalResponseNew"
