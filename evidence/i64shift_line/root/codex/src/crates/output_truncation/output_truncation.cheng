import std/strings
import std/strutils as strutil

# ── Output truncation library (ported from codex-rs utils/output-truncation) ──

const ApproxBytesPerToken: int32 = 4

fn utf8CharLen(firstByte: int32): int32 =
    if firstByte & 0x80 == 0:
        return 1
    elif firstByte & 0xE0 == 0xC0:
        return 2
    elif firstByte & 0xF0 == 0xE0:
        return 3
    else:
        return 4

fn countChars(s: str): int32 =
    var count: int32 = 0
    var i: int32 = 0
    while i < s.len:
        let cl = utf8CharLen(Int32(s[i]))
        i = i + cl
        count = count + 1
    return count

fn splitBudget(budget: int32, outLeft: var int32, outRight: var int32) =
    outLeft = budget / 2
    outRight = budget - outLeft

fn splitString(s: str, beginningBytes: int32, endBytes: int32,
               outRemovedChars: var int32, outLeft: var str, outRight: var str) =
    let n = s.len
    let tailStartTarget = n - endBytes
    var prefixEnd: int32 = 0
    var suffixStart: int32 = n
    var removedChars: int32 = 0
    var suffixStarted: bool = false
    var i: int32 = 0
    while i < n:
        let cl = utf8CharLen(Int32(s[i]))
        let charEnd = i + cl
        if charEnd <= beginningBytes:
            prefixEnd = charEnd
        elif i >= tailStartTarget:
            if !suffixStarted:
                suffixStart = i
                suffixStarted = true
        else:
            removedChars = removedChars + 1
        i = charEnd
    if suffixStart < prefixEnd:
        suffixStart = prefixEnd
    outRemovedChars = removedChars
    if prefixEnd == 0:
        outLeft = ""
    else:
        outLeft = strings.SliceBytes(s, 0, prefixEnd)
    if suffixStart >= n:
        outRight = ""
    else:
        outRight = strings.SliceBytes(s, suffixStart, n - suffixStart)

fn formatTruncationMarker(useTokens: bool, removedCount: int64): str =
    let countStr = strings.Int64ToStr(removedCount)
    if useTokens:
        return strutil.Join(["...", countStr, " tokens truncated..."], "")
    else:
        return strutil.Join(["...", countStr, " chars truncated..."], "")

fn removedUnits(useTokens: bool, removedBytes: int32, removedChars: int32): int64 =
    if useTokens:
        return RustCsgUtilsStringApproxTokensFromByteCount(int64(removedBytes))
    else:
        return int64(removedChars)

fn assembleTruncatedOutput(prefix: str, suffix: str, marker: str): str =
    return strutil.Join([prefix, marker, suffix], "")

fn truncateWithByteEstimate(s: str, maxBytes: int32, useTokens: bool): str =
    if s.len == 0:
        return ""
    if maxBytes == 0:
        let totalChars = countChars(s)
        let marker = formatTruncationMarker(useTokens, removedUnits(useTokens, s.len, totalChars))
        return marker
    if s.len <= maxBytes:
        return s
    var leftBudget: int32
    var rightBudget: int32
    splitBudget(maxBytes, leftBudget, rightBudget)
    var removedChars: int32
    var left: str
    var right: str
    splitString(s, leftBudget, rightBudget, removedChars, left, right)
    let removedBytes = s.len - maxBytes
    let marker = formatTruncationMarker(useTokens, removedUnits(useTokens, removedBytes, removedChars))
    return assembleTruncatedOutput(left, right, marker)

fn RustCsgUtilsStringApproxTokenCount(text: str): int64 =
    let l = int64(text.len)
    return (l + int64(ApproxBytesPerToken) - 1) / int64(ApproxBytesPerToken)

fn RustCsgUtilsStringApproxBytesForTokens(tokens: int64): int64 =
    return tokens * int64(ApproxBytesPerToken)

fn RustCsgUtilsStringApproxTokensFromByteCount(bytes: int64): int64 =
    return (bytes + int64(ApproxBytesPerToken) - 1) / int64(ApproxBytesPerToken)

fn RustCsgUtilsStringTruncateMiddleChars(s: str, maxBytes: int64): str =
    return truncateWithByteEstimate(s, int32(maxBytes), false)

fn RustCsgUtilsStringTruncateMiddleWithTokenBudget(s: str, maxTokens: int64,
                                                   outOriginalTokens: var int64,
                                                   outHadTruncation: var bool): str =
    outOriginalTokens = RustCsgUtilsStringApproxTokenCount(s)
    if s.len == 0:
        outHadTruncation = false
        return ""
    if maxTokens > 0 && int64(s.len) <= RustCsgUtilsStringApproxBytesForTokens(maxTokens):
        outHadTruncation = false
        return s
    let truncated = truncateWithByteEstimate(s, int32(RustCsgUtilsStringApproxBytesForTokens(maxTokens)), true)
    outHadTruncation = truncated != s
    return truncated

# ── Core API: policyKind 0=bytes, 1=tokens ──

fn countLines(s: str): int32 =
    if s.len == 0:
        return 0
    var count: int32 = 1
    for i in 0..<s.len:
        if s[i] == '\n':
            count = count + 1
    return count

fn truncateText(content: str, policyKind: int32, budget: int64): str =
    if policyKind == 0:
        return RustCsgUtilsStringTruncateMiddleChars(content, budget)
    else:
        var origTokens: int64
        var hadTrunc: bool
        return RustCsgUtilsStringTruncateMiddleWithTokenBudget(content, budget, origTokens, hadTrunc)

fn formattedTruncateText(content: str, policyKind: int32, budget: int64): str =
    if int64(content.len) <= budget:
        return content
    let totalLines = countLines(content)
    let result = truncateText(content, policyKind, budget)
    return strutil.Join(["Total output lines: ", strings.IntToStr(totalLines), "\n\n", result], "")
