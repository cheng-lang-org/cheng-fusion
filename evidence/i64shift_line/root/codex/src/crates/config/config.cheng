import std/strings as strings
import std/strutils as strutil

# ── TOML config parser (ported from codex-rs config) ──
# Parses key/value pairs and [sections] from a TOML string.
# Returns JSON: {"sections":{"":{...}, "section":{...}}, "error":""}

fn isTomlSpace(ch: char): bool =
    return ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r'

fn trimToml(raw: str): str =
    if raw.len == 0:
        return ""
    var start: int32
    while start < raw.len && isTomlSpace(raw[start]):
        start = start + 1
    if start >= raw.len:
        return ""
    var stop: int32 = raw.len
    while stop > start && isTomlSpace(raw[stop - 1]):
        stop = stop - 1
    return strings.SliceBytes(raw, start, stop - start)

fn parseTomlStringValue(value: str, outError: var str): str =
    outError = ""
    let trimmed = trimToml(value)
    if trimmed.len < 2:
        outError = strings.ConcatStr("invalid toml value: ", value)
        return ""
    let quote = trimmed[0]
    if quote != '"' && quote != '\'':
        outError = strings.ConcatStr("toml value must be quoted: ", value)
        return ""
    if trimmed[trimmed.len - 1] != quote:
        outError = strings.ConcatStr("unterminated toml string: ", value)
        return ""
    let inner = strings.SliceBytes(trimmed, 1, trimmed.len - 2)
    for i in 0..<inner.len:
        if inner[i] == '\\' || inner[i] == '\n' || inner[i] == '\r' || inner[i] == '\t':
            outError = "toml escape sequences not supported"
            return ""
    return inner

fn jsonEscape(s: str): str =
    var out: str
    for i in 0..<s.len:
        let ch = s[i]
        if ch == '"':
            out = strings.ConcatStr(out, "\\\"")
        elif ch == '\\':
            out = strings.ConcatStr(out, "\\\\")
        elif ch == '\n':
            out = strings.ConcatStr(out, "\\n")
        elif ch == '\t':
            out = strings.ConcatStr(out, "\\t")
        else:
            out = strings.ConcatStr(out, strings.SliceBytes(s, i, 1))
    return out

# Helper to skip whitespace and comments
fn skipToContent(text: str, pos: var int32) =
    while pos < text.len:
        if text[pos] == ' ' || text[pos] == '\t' || text[pos] == '\r':
            pos = pos + 1
        elif text[pos] == '\n':
            pos = pos + 1
        elif text[pos] == '#':
            while pos < text.len && text[pos] != '\n':
                pos = pos + 1
        else:
            break

# Helper to parse [section header]
fn parseSection(text: str, pos: var int32, outError: var str): str =
    outError = ""
    if pos >= text.len || text[pos] != '[':
        outError = "not a section"
        return ""
    pos = pos + 1
    let start: int32 = pos
    while pos < text.len && text[pos] != ']':
        if text[pos] == '\n' || text[pos] == '\r':
            outError = "unterminated table header"
            return ""
        pos = pos + 1
    if pos >= text.len:
        outError = "unterminated table header"
        return ""
    let sectionName = trimToml(strings.SliceBytes(text, start, pos - start))
    pos = pos + 1
    return sectionName

# Helper to parse key = value
fn parseKeyValue(text: str, pos: var int32, outKey: var str, outValue: var str, outError: var str) =
    outKey = ""
    outValue = ""
    outError = ""
    if pos >= text.len:
        outError = "end of content"
        return
    let keyStart: int32 = pos
    while pos < text.len && text[pos] != '=' && text[pos] != ' ' && text[pos] != '\t' && text[pos] != '\n' && text[pos] != '\r':
        pos = pos + 1
    if keyStart >= pos:
        outError = "empty key"
        return
    outKey = strings.SliceBytes(text, keyStart, pos - keyStart)
    while pos < text.len && (text[pos] == ' ' || text[pos] == '\t'):
        pos = pos + 1
    if pos >= text.len || text[pos] != '=':
        outError = strings.ConcatStr("expected '=' after key: ", outKey)
        return
    pos = pos + 1
    while pos < text.len && (text[pos] == ' ' || text[pos] == '\t'):
        pos = pos + 1
    let valStart: int32 = pos
    while pos < text.len && text[pos] != '\n' && text[pos] != '\r':
        pos = pos + 1
    let valueRaw = strings.SliceBytes(text, valStart, pos - valStart)
    let parsedValue = parseTomlStringValue(valueRaw, outError)
    if outError != "":
        return
    outValue = parsedValue

fn processOneElement(text: str, pos: var int32, currentSection: var str, entries: var str[], outError: var str) =
    outError = ""
    skipToContent(text, pos)
    if pos >= text.len:
        return
    if text[pos] == '[':
        var sectionErr: str
        currentSection = parseSection(text, pos, sectionErr)
        if sectionErr != "":
            outError = sectionErr
        return
    var key: str
    var value: str
    parseKeyValue(text, pos, key, value, outError)
    if outError != "":
        return
    var qualifiedKey: str = key
    if currentSection != "":
        qualifiedKey = strings.ConcatStr(strings.ConcatStr(currentSection, "."), key)
    add(entries, strings.ConcatStr(strings.ConcatStr(strings.ConcatStr(strings.ConcatStr("\"", jsonEscape(qualifiedKey)), "\":\""), jsonEscape(value)), "\""))

fn parseConfigToml(tomlContent: str): str =
    var entries: str[]
    var currentSection: str = ""
    var pos: int32
    while pos < tomlContent.len:
        var elemErr: str
        processOneElement(tomlContent, pos, currentSection, entries, elemErr)
        if elemErr != "":
            return strings.ConcatStr(strings.ConcatStr("{\"sections\":{},\"error\":\"", jsonEscape(elemErr)), "\"}")
    var entriesStr: str
    var ei: int32 = 0
    while ei < entries.len:
        if ei > 0: entriesStr = strings.ConcatStr(entriesStr, ",")
        entriesStr = strings.ConcatStr(entriesStr, entries[ei])
        ei = ei + 1
    return strings.ConcatStr(strings.ConcatStr("{\"sections\":{", entriesStr), "},\"error\":\"\"}")

# ── Public API — merge & validate ────────────────────────────────────

# Manual contains (cold-compiler workaround for strutil.Contains + double-quote char).
fn manualContains(haystack: str, needle: str): bool =
    var i: int32 = 0
    while i < haystack.len:
        if haystack[i] == needle[0]:
            var allMatch: bool = true
            var j: int32 = 1
            while j < needle.len:
                if i + j >= haystack.len || haystack[i + j] != needle[j]:
                    allMatch = false
                    break
                j = j + 1
            if allMatch:
                return true
        i = i + 1
    return false

# Deep merge two JSON config sections (override takes precedence).
# Both inputs are JSON objects strings like {"key1":"val1","key2":"val2"}.
# Returns a merged JSON object string.
fn configMergeSection(base: str, override: str): str =
    # Parse base into entries array
    var baseEntries: str[]
    var i: int32 = 1
    while i < base.len:
        if base[i] == '"':
            var keyStart: int32 = i + 1
            i = i + 1
            while i < base.len && base[i] != '"':
                i = i + 1
            let key: str = strings.SliceBytes(base, keyStart, i - keyStart)
            # Skip :"
            i = i + 2
            if i < base.len && base[i] == '"':
                i = i + 1
            var valStart: int32 = i
            while i < base.len && base[i] != '"':
                i = i + 1
            let value: str = strings.SliceBytes(base, valStart, i - valStart)
            add(baseEntries, strings.ConcatStr(strings.ConcatStr(strings.ConcatStr(strings.ConcatStr("\"", jsonEscape(key)), "\":\""), jsonEscape(value)), "\""))
            i = i + 1
            while i < base.len && (base[i] == ',' || base[i] == ' ' || base[i] == '\t' || base[i] == '\n'):
                i = i + 1
        else:
            i = i + 1
    # Parse override into entries array, tracking keys seen
    var merged: str[] = baseEntries
    var seen: str[]
    # Start from copy of base entries
    var j: int32 = 0
    while j < merged.len:
        # extract key from each entry
        var entry: str = merged[j]
        var k: int32 = 1
        while k < entry.len && entry[k] != '"':
            k = k + 1
        let ek: str = strings.SliceBytes(entry, 1, k - 1)
        add(seen, ek)
        j = j + 1
    # Now add/replace from override
    i = 1
    while i < override.len:
        if override[i] == '"':
            var keyStart: int32 = i + 1
            i = i + 1
            while i < override.len && override[i] != '"':
                i = i + 1
            let key: str = strings.SliceBytes(override, keyStart, i - keyStart)
            # Check if key already seen
            var found: bool
            var si: int32 = 0
            while si < seen.len:
                if seen[si] == key:
                    found = true
                    # Replace this entry
                    var ri: int32 = 0
                    while ri < merged.len:
                        var rentry: str = merged[ri]
                        var rk: int32 = 1
                        while rk < rentry.len && rentry[rk] != '"':
                            rk = rk + 1
                        let rkey: str = strings.SliceBytes(rentry, 1, rk - 1)
                        if rkey == key:
                            # Skip " and key to get to value part
                            break
                        ri = ri + 1
                    break
                si = si + 1
            if !found:
                add(seen, key)
            i = i + 2
            if i < override.len && override[i] == '"':
                i = i + 1
            var valStart: int32 = i
            while i < override.len && override[i] != '"':
                i = i + 1
            let value: str = strings.SliceBytes(override, valStart, i - valStart)
            var newEntry: str = strings.ConcatStr(strings.ConcatStr(strings.ConcatStr(strings.ConcatStr("\"", jsonEscape(key)), "\":\""), jsonEscape(value)), "\"")
            if found:
                # Replace by reconstructing merged list
                var replaced: str[]
                var ri2: int32 = 0
                while ri2 < merged.len:
                    var rentry2: str = merged[ri2]
                    var rk2: int32 = 1
                    while rk2 < rentry2.len && rentry2[rk2] != '"':
                        rk2 = rk2 + 1
                    let rkey2: str = strings.SliceBytes(rentry2, 1, rk2 - 1)
                    if rkey2 == key:
                        add(replaced, newEntry)
                    else:
                        add(replaced, rentry2)
                    ri2 = ri2 + 1
                merged = replaced
            else:
                add(merged, newEntry)
            i = i + 1
            while i < override.len && (override[i] == ',' || override[i] == ' ' || override[i] == '\t' || override[i] == '\n'):
                i = i + 1
        else:
            i = i + 1
    var mergedStr: str
    var mi: int32 = 0
    while mi < merged.len:
        if mi > 0: mergedStr = strings.ConcatStr(mergedStr, ",")
        mergedStr = strings.ConcatStr(mergedStr, merged[mi])
        mi = mi + 1
    return strings.ConcatStr(strings.ConcatStr("{", mergedStr), "}")

# Validate a config JSON string against a schema JSON string.
# Schema format: {"required":["key1","key2"],"optional":["key3"]}
# Returns empty string if valid, or error message if invalid.
fn configValidateSchema(config: str, schema: str): str =
    # Parse required keys from schema
    var required: str[]
    var schemaIdx: int32 = 0
    # Find "required" array
    let reqMarker: str = "\"required\":["
    var reqStart: int32 = 0
    while reqStart < schema.len:
        var found: bool = true
        var m: int32 = 0
        while m < reqMarker.len:
            if reqStart + m >= schema.len || schema[reqStart + m] != reqMarker[m]:
                found = false
                break
            m = m + 1
        if found:
            break
        reqStart = reqStart + 1
    if reqStart < schema.len:
        var pos: int32 = reqStart + reqMarker.len
        while pos < schema.len && schema[pos] != ']':
            # Skip whitespace and quotes
            while pos < schema.len && (schema[pos] == ' ' || schema[pos] == '\t' || schema[pos] == '\n' || schema[pos] == '"'):
                pos = pos + 1
            var keyStart: int32 = pos
            while pos < schema.len && schema[pos] != '"' && schema[pos] != ',' && schema[pos] != ']':
                pos = pos + 1
            if pos > keyStart:
                add(required, strings.SliceBytes(schema, keyStart, pos - keyStart))
            while pos < schema.len && (schema[pos] == ',' || schema[pos] == ' ' || schema[pos] == '\t'):
                pos = pos + 1
    # Check each required key exists in config
    var ri: int32 = 0
    while ri < required.len:
        let reqKey: str = required[ri]
        let searchKey: str = strings.ConcatStr(strings.ConcatStr("\"", reqKey), "\":")
        if !manualContains(config, searchKey):
            return strings.ConcatStr("missing required config key: ", reqKey)
        ri = ri + 1
    return ""

# Convert a config JSON string to environment variable format.
# Input: JSON like {"host":"localhost","port":"8080"}
# Returns "export" lines: "export HOST=localhost\nexport PORT=8080\n"
# Keys are uppercased; if a section prefix exists (e.g. "server.host"), it becomes "SERVER_HOST=...".
fn configToEnvVars(config: str): str =
    var lines: str[]
    var i: int32 = 1
    while i < config.len:
        if config[i] == '"':
            var keyStart: int32 = i + 1
            i = i + 1
            while i < config.len && config[i] != '"':
                i = i + 1
            let key: str = strings.SliceBytes(config, keyStart, i - keyStart)
            i = i + 1
            while i < config.len && config[i] != ':':
                i = i + 1
            i = i + 1
            while i < config.len && (config[i] == ' ' || config[i] == '\t'):
                i = i + 1
            var value: str
            if i < config.len && config[i] == '"':
                i = i + 1
                var valStart: int32 = i
                while i < config.len && config[i] != '"':
                    i = i + 1
                value = strings.SliceBytes(config, valStart, i - valStart)
                i = i + 1
            else:
                var valStart: int32 = i
                while i < config.len && config[i] != ',' && config[i] != '}' && config[i] != ' ':
                    i = i + 1
                value = strings.SliceBytes(config, valStart, i - valStart)
            # Convert key: dots to underscores, uppercase
            var envKey: str
            for j in 0..<key.len:
                let ch = key[j]
                if ch == '.':
                    envKey = strings.ConcatStr(envKey, "_")
                elif ch >= 'a' && ch <= 'z':
                    let upperIdx: int32 = ch - 97
                    envKey = strings.ConcatStr(envKey, strings.SliceBytes("ABCDEFGHIJKLMNOPQRSTUVWXYZ", upperIdx, 1))
                else:
                    envKey = strings.ConcatStr(envKey, strings.SliceBytes(key, j, 1))
            add(lines, strings.ConcatStr(strings.ConcatStr(strings.ConcatStr("export ", envKey), "="), value))
            while i < config.len && (config[i] == ',' || config[i] == ' ' || config[i] == '\t' || config[i] == '\n'):
                i = i + 1
        else:
            i = i + 1
    if lines.len == 0:
        return ""
    var envStr: str
    var li: int32 = 0
    while li < lines.len:
        if li > 0: envStr = strings.ConcatStr(envStr, "\n")
        envStr = strings.ConcatStr(envStr, lines[li])
        li = li + 1
    return strings.ConcatStr(envStr, "\n")
