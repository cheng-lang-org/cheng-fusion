import std/strings

type
    RustCsgMcpToolDef =
        name: str
        description: str
        inputSchema: str
        outputSchema: str

    RustCsgMcpResourceDef =
        uri: str
        name: str
        description: str
        mimeType: str

    RustCsgMcpResourceTemplateDef =
        uriTemplate: str
        name: str
        description: str
        mimeType: str

    RustCsgMcpServerCapabilities =
        tools: bool
        resources: bool
        resourceTemplates: bool
        prompts: bool

    RustCsgMcpServerInfo =
        name: str
        version: str

    RustCsgMcpInitializeResult =
        protocolVersion: str
        capabilities: str
        serverInfo: str

    RustCsgCodexToolCallParam =
        prompt: str
        model: str
        profile: str
        cwd: str
        approvalPolicy: int32
        sandbox: int32
        config: str
        baseInstructions: str
        developerInstructions: str
        compactPrompt: str

    RustCsgCodexToolCallReplyParam =
        conversationId: str
        threadId: str
        prompt: str

    RustCsgExecApprovalElicitRequestParams =
        message: str
        requestedSchema: str
        threadId: str
        codexElicitation: str
        codexMcpToolCallId: str
        codexEventId: str
        codexCallId: str
        codexCommand: str
        codexCwd: str
        codexParsedCmd: str

    RustCsgExecApprovalResponse =
        decision: int32

    RustCsgPatchApprovalElicitRequestParams =
        message: str
        requestedSchema: str
        threadId: str
        codexElicitation: str
        codexMcpToolCallId: str
        codexEventId: str
        codexCallId: str
        codexReason: str
        codexGrantRoot: str
        codexChanges: str

    RustCsgPatchApprovalResponse =
        decision: int32

    RustCsgMcpJsonRpcRequest =
        jsonrpc: str
        id: int32
        method: str
        params: str

    RustCsgMcpJsonRpcResponse =
        jsonrpc: str
        id: int32
        result: str

    RustCsgMcpJsonRpcError =
        jsonrpc: str
        id: int32
        errorCode: int32
        errorMessage: str

    RustCsgMcpJsonRpcNotification =
        jsonrpc: str
        method: str
        params: str

const RustCsgMcpServerChannelCapacity: int32 = 128
const RustCsgMcpServerAnalyticsDefaultEnabled: bool = true
const RustCsgMcpServerOtelServiceName: str = "codex_mcp_server"

const RustCsgApprovalPolicyUntrusted: int32 = 0
const RustCsgApprovalPolicyOnFailure: int32 = 1
const RustCsgApprovalPolicyOnRequest: int32 = 2
const RustCsgApprovalPolicyNever: int32 = 3
const RustCsgApprovalPolicyNone: int32 = -1

const RustCsgSandboxModeReadOnly: int32 = 0
const RustCsgSandboxModeWorkspaceWrite: int32 = 1
const RustCsgSandboxModeDangerFullAccess: int32 = 2
const RustCsgSandboxModeNone: int32 = -1

const RustCsgReviewDecisionApproved: int32 = 0
const RustCsgReviewDecisionDenied: int32 = 1
const RustCsgReviewDecisionNone: int32 = -1

# ── CodexToolCallParam struct fields ─────────────────────────────────────────

const RustCsgCodexToolCallParamFieldCount: int32 = 10
fn RustCsgCodexToolCallParamFields(): str =
    return "prompt|str,model|opt_str,profile|opt_str,cwd|opt_str,approval_policy|opt_approval_policy,sandbox|opt_sandbox_mode,config|opt_map_str_json,base_instructions|opt_str,developer_instructions|opt_str,compact_prompt|opt_str"

const RustCsgCodexToolCallParamMethodCount: int32 = 1
fn RustCsgCodexToolCallParamMethodNames(): str =
    return "into_config"

# ── CodexToolCallApprovalPolicy enum ────────────────────────────────────────

const RustCsgCodexToolCallApprovalPolicyVariantCount: int32 = 4
fn RustCsgCodexToolCallApprovalPolicyVariants(): str =
    return "Untrusted,OnFailure,OnRequest,Never"

# ── CodexToolCallSandboxMode enum ───────────────────────────────────────────

const RustCsgCodexToolCallSandboxModeVariantCount: int32 = 3
fn RustCsgCodexToolCallSandboxModeVariants(): str =
    return "ReadOnly,WorkspaceWrite,DangerFullAccess"

# ── CodexToolCallReplyParam struct fields ───────────────────────────────────

const RustCsgCodexToolCallReplyParamFieldCount: int32 = 3
fn RustCsgCodexToolCallReplyParamFields(): str =
    return "conversation_id|opt_str,thread_id|opt_str,prompt|str"

# ── ExecApproval types ──────────────────────────────────────────────────────

const RustCsgExecApprovalElicitRequestParamsFieldCount: int32 = 5
fn RustCsgExecApprovalElicitRequestParamsFields(): str =
    return "command|str,cwd|str,shell_type|str,env|opt_map_str_str,origin|opt_str"

const RustCsgExecApprovalResponseFieldCount: int32 = 2
fn RustCsgExecApprovalResponseFields(): str =
    return "approved|bool,reason|opt_str"

# ── PatchApproval types ─────────────────────────────────────────────────────

const RustCsgPatchApprovalElicitRequestParamsFieldCount: int32 = 3
fn RustCsgPatchApprovalElicitRequestParamsFields(): str =
    return "patch|str,file_path|str,origin|opt_str"

const RustCsgPatchApprovalResponseFieldCount: int32 = 2
fn RustCsgPatchApprovalResponseFields(): str =
    return "approved|bool,reason|opt_str"

fn RustCsgParseMcpToolName(fullName: str, outServer: var str, outTool: var str): bool =
    outServer = ""
    outTool = ""
    var slash: int32 = -1
    var i: int32 = 0
    while i < fullName.len:
        if fullName[i] == '/':
            slash = i
            break
        i = i + 1
    if slash < 0:
        return false
    outServer = strings.SliceBytes(fullName, 0, slash)
    outTool = strings.SliceBytes(fullName, slash + 1, fullName.len - slash - 1)
    return true
