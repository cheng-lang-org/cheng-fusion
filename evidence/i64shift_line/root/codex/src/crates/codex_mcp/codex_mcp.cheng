import cheng/codex/protocol/wire
const RustCsgCodexMcpCrate: str = "codex-mcp"
fn RustCsgCodexMcpBuildJsonRpc(id: str, method: str, params: str): str =
    return wire.RustCsgCat(wire.RustCsgCat(wire.RustCsgCat(
        "{\"jsonrpc\":\"2.0\",\"id\":", id), ",\"method\":\""), 
        wire.RustCsgCat4(method, "\",\"params\":", params, "}", ""))
