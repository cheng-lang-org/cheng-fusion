# Protocol — session ID validation and message serialization.
# Ported from codex-rs/protocol/src/session_id.rs and protocol types.
# Covers: validateSessionId, serializeProtocolMessage

import std/strutils as strutil
import std/strings

const RustCsgProtocolFunctionCount: int32 = 4
fn RustCsgProtocolFunctionNames(): str =
    return "validateSessionId,serializeProtocolMessage,validateProtocolVersion,negotiateProtocolVersion"

# ── jsonEscape ─────────────────────────────────────────────────────────────
# Escape a string for inclusion in a JSON string value.
fn jsonEscapeProtocol(s: str): str =
    if s.len == 0:
        return ""
    var result: str = ""
    var i: int32 = 0
    while i < s.len:
        let ch = s[i]
        if ch == '"':
            result = strutil.Join([result, "\\\""], "")
        elif ch == '\\':
            result = strutil.Join([result, "\\\\"], "")
        elif ch == '\n':
            result = strutil.Join([result, "\\n"], "")
        elif ch == '\t':
            result = strutil.Join([result, "\\t"], "")
        elif ch == '\r':
            result = strutil.Join([result, "\\r"], "")
        else:
            result = strutil.Join([result, strings.SliceBytes(s, i, 1)], "")
        i = i + 1
    return result

# ── serializeProtocolMessage ──────────────────────────────────────────────
# Serialize a protocol message to a JSON envelope.
# The msg parameter is the payload string to be wrapped.
# Produces: {"protocol":"cheng-codex","msg":"<escaped-msg>"}
fn RustCsgProtocolSerializeMessage(msg: str): str =
    return strutil.Join([
        "{\"protocol\":\"cheng-codex\",\"msg\":\"",
        jsonEscapeProtocol(msg),
        "\"}"
    ], "")

# Validate a UUID v4 string.
# Checks the format: xxxxxxxx-xxxx-4xxx-[89ab]xxx-xxxxxxxxxxxx
# Returns true if the string matches UUID v4 format, false otherwise.
fn RustCsgValidateSessionId(id: str): bool =
    if id.len != 36:
        return false

    # Check hyphens at standard UUID positions
    if id[8] != '-': return false
    if id[13] != '-': return false
    if id[18] != '-': return false
    if id[23] != '-': return false

    # Version nibble at position 14 must be '4'
    if id[14] != '4': return false

    # Variant at position 19 must be '8', '9', 'a', or 'b'
    let variant = id[19]
    if variant != '8' && variant != '9' && variant != 'a' && variant != 'b':
        return false

    # Check all remaining positions are valid hex digits
    var i: int32
    while i < 36:
        let ch = id[i]
        # Skip hyphens and already-validated version/variant positions
        if i == 8 || i == 13 || i == 18 || i == 23 || i == 14 || i == 19:
            i = i + 1
        else:
            let isDigit = ch >= '0' && ch <= '9'
            if !isDigit:
                let isLowerHex = ch >= 'a' && ch <= 'f'
                if !isLowerHex:
                    let isUpperHex = ch >= 'A' && ch <= 'F'
                    if !isUpperHex:
                        return false
            i = i + 1

    return true

# ── validateProtocolVersion ─────────────────────────────────────────────────
# Check that a version string follows the format "v<major>" or "v<major>.<minor>".
# Returns true if the version string is valid.
fn RustCsgValidateProtocolVersion(version: str): bool =
    if version.len == 0:
        return false
    if version[0] != 'v' && version[0] != 'V':
        return false
    var i: int32 = 1
    var hasDigit: bool = false
    while i < version.len:
        let ch = version[i]
        if ch >= '0' && ch <= '9':
            hasDigit = true
        elif ch != '.':
            return false
        i = i + 1
    return hasDigit

# ── negotiateProtocolVersion ────────────────────────────────────────────────
# Find the highest common version supported by both client and server.
# Versions are compared as strings (e.g. "v1", "v2", "v1.1").
fn RustCsgNegotiateProtocolVersion(clientVersions: str[], serverVersions: str[],
                                   outVersion: var str, outOk: var bool) =
    outVersion = ""
    outOk = false
    var best: str = ""
    var ci: int32 = 0
    while ci < clientVersions.len:
        let cv = clientVersions[ci]
        var si: int32 = 0
        while si < serverVersions.len:
            let sv = serverVersions[si]
            if cv == sv:
                if best == "" || cv > best:
                    best = cv
            si = si + 1
        ci = ci + 1
    if best != "":
        outVersion = best
        outOk = true
