import std/strings as strings

# ── arg0 dispatch classification (ported from codex-rs arg0) ──

fn findLastSlash(s: str): int32 =
    var found: int32 = -1
    for i in 0..<s.len:
        if s[i] == '/':
            found = i
    return found

fn extractFilename(path: str): str =
    if path.len == 0:
        return ""
    let slashIdx = findLastSlash(path)
    if slashIdx < 0:
        return path
    return strings.SliceBytes(path, slashIdx + 1, path.len - slashIdx - 1)

fn parseArg0(argv0: str): str =
    let filename = extractFilename(argv0)
    if filename == "codex":
        return "codex"
    if filename == "apply_patch" || filename == "applypatch":
        return "apply-patch"
    if filename == "codex-linux-sandbox":
        return "linux-sandbox"
    if filename == "codex-execve-wrapper":
        return "execve-wrapper"
    return "unknown"
