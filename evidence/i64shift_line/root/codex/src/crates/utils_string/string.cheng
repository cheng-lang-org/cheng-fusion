import std/strings
import std/strutils as strutil

# ── Private helpers ──────────────────────────────────────────────────────────

fn isHexDigit(ch: char): bool =
    return (ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'f') || (ch >= 'A' && ch <= 'F')

fn checkHexSeq(s: str, start: int32, count: int32): bool =
    if start + count > s.len:
        return false
    for i in 0..<count:
        if !isHexDigit(s[start + i]):
            return false
    return true

fn utf8CharLen(firstByte: int32): int32 =
    if firstByte & 0x80 == 0:
        return 1
    elif firstByte & 0xE0 == 0xC0:
        return 2
    elif firstByte & 0xF0 == 0xE0:
        return 3
    else:
        return 4

fn countChars(s: str): int32 =
    var count: int32 = 0
    var i: int32 = 0
    while i < s.len:
        let cl = utf8CharLen(Int32(s[i]))
        i = i + cl
        count = count + 1
    return count

fn splitBudget(budget: int32, outLeft: var int32, outRight: var int32) =
    outLeft = budget / 2
    outRight = budget - outLeft

fn splitString(s: str, beginningBytes: int32, endBytes: int32,
               outRemovedChars: var int32, outLeft: var str, outRight: var str) =
    let n = s.len
    let tailStartTarget = n - endBytes
    var prefixEnd: int32 = 0
    var suffixStart: int32 = n
    var removedChars: int32 = 0
    var suffixStarted: bool = false
    var i: int32 = 0
    while i < n:
        let cl = utf8CharLen(Int32(s[i]))
        let charEnd = i + cl
        if charEnd <= beginningBytes:
            prefixEnd = charEnd
        elif i >= tailStartTarget:
            if !suffixStarted:
                suffixStart = i
                suffixStarted = true
        else:
            removedChars = removedChars + 1
        i = charEnd
    if suffixStart < prefixEnd:
        suffixStart = prefixEnd
    outRemovedChars = removedChars
    if prefixEnd == 0:
        outLeft = ""
    else:
        outLeft = strutil.SliceStr(s, 0, prefixEnd - 1)
    if suffixStart >= n:
        outRight = ""
    else:
        outRight = strutil.SliceStr(s, suffixStart, n - 1)

fn formatTruncationMarker(useTokens: bool, removedCount: int64): str =
    let countStr = strings.Int64ToStr(removedCount)
    if useTokens:
        return strutil.Join(["...", countStr, " tokens truncated..."], "")
    else:
        return strutil.Join(["...", countStr, " chars truncated..."], "")

fn removedUnits(useTokens: bool, removedBytes: int32, removedChars: int32): int64 =
    if useTokens:
        return RustCsgUtilsStringApproxTokensFromByteCount(int64(removedBytes))
    else:
        return int64(removedChars)

fn assembleTruncatedOutput(prefix: str, suffix: str, marker: str): str =
    return strutil.Join([prefix, marker, suffix], "")

fn truncateWithByteEstimate(s: str, maxBytes: int32, useTokens: bool): str =
    if s.len == 0:
        return ""
    if maxBytes == 0:
        let totalChars = countChars(s)
        let marker = formatTruncationMarker(useTokens, removedUnits(useTokens, s.len, totalChars))
        return marker
    if s.len <= maxBytes:
        return s
    var leftBudget: int32
    var rightBudget: int32
    splitBudget(maxBytes, leftBudget, rightBudget)
    var removedChars: int32
    var left: str
    var right: str
    splitString(s, leftBudget, rightBudget, removedChars, left, right)
    let removedBytes = s.len - maxBytes
    let marker = formatTruncationMarker(useTokens, removedUnits(useTokens, removedBytes, removedChars))
    return assembleTruncatedOutput(left, right, marker)

fn parseMarkdownHashLocationPoint(point: str, outLine: var str, outColumn: var str, outOk: var bool) =
    outLine = ""
    outColumn = ""
    outOk = false
    if point.len == 0 || point[0] != 'L':
        return
    let afterL = strutil.SliceStr(point, 1, point.len - 1)
    var cIdx: int32 = -1
    for i in 0..<afterL.len:
        if afterL[i] == 'C':
            cIdx = i
            break
    if cIdx >= 0:
        if cIdx == 0:
            outLine = ""
        else:
            outLine = strutil.SliceStr(afterL, 0, cIdx - 1)
        if cIdx + 1 >= afterL.len:
            outColumn = ""
        else:
            outColumn = strutil.SliceStr(afterL, cIdx + 1, afterL.len - 1)
    else:
        outLine = afterL
    outOk = true

fn approxBytesPerToken(): int64 =
    return 4

# ── Public API ───────────────────────────────────────────────────────────────

fn RustCsgUtilsStringTakeBytesAtCharBoundary(s: str, maxb: int64): str =
    let n: int32 = s.len
    let maxb32: int32 = int32(maxb)
    if maxb32 <= 0:
        return ""
    if n <= maxb32:
        return s
    var lastOk: int32 = 0
    var i: int32 = 0
    while i < n:
        let cl = utf8CharLen(Int32(s[i]))
        let nextI = i + cl
        if nextI > maxb32:
            break
        lastOk = nextI
        i = nextI
    if lastOk == 0:
        return ""
    return strutil.SliceStr(s, 0, lastOk - 1)

fn RustCsgUtilsStringSanitizeMetricTagValue(value: str): str =
    let n: int32 = value.len
    if n == 0:
        return "unspecified"
    # Build sanitized string: valid chars kept, invalid replaced with '_'
    var sanitized: str = ""
    var i: int32 = 0
    while i < n:
        let ch = value[i]
        if (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') ||
           (ch >= '0' && ch <= '9') || ch == '.' || ch == '_' ||
           ch == '-' || ch == '/':
            sanitized = strutil.Join([sanitized, strings.SliceBytes(value, i, 1)], "")
            i = i + 1
        else:
            let b: int32 = Int32(ch)
            if b & 0x80 == 0:
                # ASCII invalid char
                sanitized = strutil.Join([sanitized, "_"], "")
                i = i + 1
            else:
                # Multi-byte UTF-8 char — skip all its bytes, add one '_'
                let cl = utf8CharLen(b)
                sanitized = strutil.Join([sanitized, "_"], "")
                i = i + cl
    # Trim leading/trailing underscores
    let sn: int32 = sanitized.len
    var trimStart: int32 = -1
    for j in 0..<sn:
        if sanitized[j] != '_':
            trimStart = j
            break
    if trimStart < 0:
        return "unspecified"
    var trimEnd: int32 = trimStart
    for j in trimStart..<sn:
        if sanitized[j] != '_':
            trimEnd = j
    # Check for at least one ASCII alphanumeric
    var hasAlphaNum: bool = false
    for j in trimStart..<trimEnd + 1:
        let c = sanitized[j]
        if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9'):
            hasAlphaNum = true
            break
    if !hasAlphaNum:
        return "unspecified"
    # Slice trimmed result
    var trimmed: str
    if trimStart == 0 && trimEnd == sn - 1:
        trimmed = sanitized
    else:
        trimmed = strutil.SliceStr(sanitized, trimStart, trimEnd + 1)
    # Truncate to 256 bytes (all ASCII, so byte = char)
    if trimmed.len <= 256:
        return trimmed
    return strutil.SliceStr(trimmed, 0, 256)

fn RustCsgUtilsStringFindUuids(s: str): str[] =
    let n: int32 = s.len
    var out: str[]
    if n < 36:
        return out
    var i: int32 = 0
    while i <= n - 36:
        var ok: bool = true
        var di: int32 = 0
        while di < 36 && ok:
            let ch = s[i + di]
            if di == 8 || di == 13 || di == 18 || di == 23:
                if ch != '-':
                    ok = false
            else:
                var isHex: bool = false
                if ch >= '0' && ch <= '9': isHex = true
                if !isHex && ch >= 'a' && ch <= 'f': isHex = true
                if !isHex && ch >= 'A' && ch <= 'F': isHex = true
                if !isHex:
                    ok = false
            di = di + 1
        if ok:
            let uuid = strings.SliceBytes(s, i, 36)
            add(out, uuid)
            i = i + 36
        else:
            i = i + 1
    return out

fn RustCsgUtilsStringNormalizeMarkdownHashLocationSuffix(suffix: str, out: var str, outOk: var bool) =
    out = ""
    outOk = false
    if suffix.len == 0 || suffix[0] != '#':
        return
    let fragment = strutil.SliceStr(suffix, 1, suffix.len - 1)
    # Look for range separator '-'
    var dashIdx: int32 = -1
    for i in 0..<fragment.len:
        if fragment[i] == '-':
            dashIdx = i
            break
    if dashIdx >= 0:
        # Has range
        var startPart: str
        if dashIdx == 0:
            startPart = ""
        else:
            startPart = strutil.SliceStr(fragment, 0, dashIdx - 1)
        var endPart: str
        if dashIdx + 1 >= fragment.len:
            endPart = ""
        else:
            endPart = strutil.SliceStr(fragment, dashIdx + 1, fragment.len - 1)
        var startLine: str; var startCol: str; var startOk: bool
        parseMarkdownHashLocationPoint(startPart, startLine, startCol, startOk)
        if !startOk:
            return
        var endLine: str; var endCol: str; var endOk: bool
        parseMarkdownHashLocationPoint(endPart, endLine, endCol, endOk)
        if !endOk:
            return
        var result: str = strutil.Join([":", startLine], "")
        if startCol != "":
            result = strutil.Join([result, ":", startCol], "")
        result = strutil.Join([result, "-", endLine], "")
        if endCol != "":
            result = strutil.Join([result, ":", endCol], "")
        out = result
        outOk = true
    else:
        var startLine: str; var startCol: str; var startOk: bool
        parseMarkdownHashLocationPoint(fragment, startLine, startCol, startOk)
        if !startOk:
            return
        var result: str = strutil.Join([":", startLine], "")
        if startCol != "":
            result = strutil.Join([result, ":", startCol], "")
        out = result
        outOk = true

fn RustCsgUtilsStringTruncateMiddleChars(s: str, maxBytes: int64): str =
    return truncateWithByteEstimate(s, int32(maxBytes), false)

fn RustCsgUtilsStringTruncateMiddleWithTokenBudget(s: str, maxTokens: int64,
                                                   outOriginalTokens: var int64,
                                                   outHadTruncation: var bool): str =
    outOriginalTokens = RustCsgUtilsStringApproxTokenCount(s)
    if s.len == 0:
        outHadTruncation = false
        return ""
    if maxTokens > 0 && int64(s.len) <= RustCsgUtilsStringApproxBytesForTokens(maxTokens):
        outHadTruncation = false
        return s
    let truncated = truncateWithByteEstimate(s, int32(RustCsgUtilsStringApproxBytesForTokens(maxTokens)), true)
    outHadTruncation = truncated != s
    return truncated

fn RustCsgUtilsStringApproxTokenCount(text: str): int64 =
    let l = int64(text.len)
    return (l + approxBytesPerToken() - 1) / approxBytesPerToken()

fn RustCsgUtilsStringApproxBytesForTokens(tokens: int64): int64 =
    return tokens * approxBytesPerToken()

fn RustCsgUtilsStringApproxTokensFromByteCount(bytes: int64): int64 =
    return (bytes + approxBytesPerToken() - 1) / approxBytesPerToken()

# ── splitWords ──────────────────────────────────────────────────────────────
# Split text into an array of words (sequences of non-whitespace chars).
fn RustCsgUtilsStringSplitWords(text: str): str[] =
    var result: str[]
    let n: int32 = text.len
    var i: int32 = 0
    while i < n:
        let ch = text[i]
        if ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r':
            i = i + 1
        else:
            var start: int32 = i
            while i < n:
                let c = text[i]
                if c == ' ' || c == '\t' || c == '\n' || c == '\r':
                    break
                i = i + 1
            let word = strutil.SliceStr(text, start, i - 1)
            add(result, word)
    return result

# ── commonPrefix ────────────────────────────────────────────────────────────
# Find the longest common prefix of two strings.
fn RustCsgUtilsStringCommonPrefix(a: str, b: str): str =
    var maxLen: int32 = a.len
    if b.len < maxLen:
        maxLen = b.len
    var i: int32 = 0
    while i < maxLen:
        if a[i] != b[i]:
            break
        i = i + 1
    if i == 0:
        return ""
    return strutil.SliceStr(a, 0, i)
