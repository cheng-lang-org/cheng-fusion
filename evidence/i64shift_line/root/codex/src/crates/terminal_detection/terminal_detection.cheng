import std/strings
import std/strutils as strutil
import std/os

# ═══════════════════════════════════════════════════════════════════════════════
# Terminal detection (ported from codex-rs/terminal-detection)
# ═══════════════════════════════════════════════════════════════════════════════

# Terminal type constants
const RustCsgTerminalDetectionUnknown: int32 = 0
const RustCsgTerminalDetectionApple: int32 = 1
const RustCsgTerminalDetectionIterm2: int32 = 2
const RustCsgTerminalDetectionVsCode: int32 = 3
const RustCsgTerminalDetectionWarp: int32 = 4
const RustCsgTerminalDetectionWezTerm: int32 = 5
const RustCsgTerminalDetectionKitty: int32 = 6
const RustCsgTerminalDetectionAlacritty: int32 = 7
const RustCsgTerminalDetectionGhostty: int32 = 8
const RustCsgTerminalDetectionWindowsTerminal: int32 = 9
const RustCsgTerminalDetectionDumb: int32 = 10

# Multiplexer type constants
const RustCsgTerminalDetectionMuxNone: int32 = 0
const RustCsgTerminalDetectionMuxTmux: int32 = 1
const RustCsgTerminalDetectionMuxZellij: int32 = 2

# ───────────────────────────────────────────────────────────────────────────────
# Helpers
# ───────────────────────────────────────────────────────────────────────────────

# Normalize and compare: skip separators, case-insensitive.
# Equivalent to Rust's: trim().filter(|c| !separator).map(to_ascii_lowercase)
fn RustCsgTerminalDetectionMatchesTermProgram(value: str, target: str): bool =
    var vi: int32 = 0
    var ti: int32 = 0
    let vn: int32 = value.len
    let tn: int32 = target.len
    while vi < vn:
        let ch = value[vi]
        if ch == ' ' || ch == '-' || ch == '_' || ch == '.':
            vi = vi + 1
        else:
            if ti >= tn:
                return false
            var lc = ch
            if ch >= 'A' && ch <= 'Z':
                lc = char(Int32(ch) + 32)
            if lc != target[ti]:
                return false
            vi = vi + 1
            ti = ti + 1
    # Value exhausted; ensure target has no remaining non-separator chars
    while ti < tn:
        let tc = target[ti]
        if tc != ' ' && tc != '-' && tc != '_' && tc != '.':
            return false
        ti = ti + 1
    return true

# ───────────────────────────────────────────────────────────────────────────────
# Core detection functions
# ───────────────────────────────────────────────────────────────────────────────

fn RustCsgTerminalDetectionTerminalNameFromTermProgram(termProgram: str, outName: var str, outType: var int32) =
    outName = ""
    outType = RustCsgTerminalDetectionUnknown
    if RustCsgTerminalDetectionMatchesTermProgram(termProgram, "appleterminal"):
        outName = "Apple_Terminal"
        outType = RustCsgTerminalDetectionApple
    else:
        if RustCsgTerminalDetectionMatchesTermProgram(termProgram, "ghostty"):
            outName = "Ghostty"
            outType = RustCsgTerminalDetectionGhostty
        else:
            if RustCsgTerminalDetectionMatchesTermProgram(termProgram, "iterm2") || RustCsgTerminalDetectionMatchesTermProgram(termProgram, "iterm") || RustCsgTerminalDetectionMatchesTermProgram(termProgram, "itermapp"):
                outName = "iTerm.app"
                outType = RustCsgTerminalDetectionIterm2
            else:
                if RustCsgTerminalDetectionMatchesTermProgram(termProgram, "warp") || RustCsgTerminalDetectionMatchesTermProgram(termProgram, "warpterminal"):
                    outName = "WarpTerminal"
                    outType = RustCsgTerminalDetectionWarp
                else:
                    if RustCsgTerminalDetectionMatchesTermProgram(termProgram, "vscode"):
                        outName = "vscode"
                        outType = RustCsgTerminalDetectionVsCode
                    else:
                        if RustCsgTerminalDetectionMatchesTermProgram(termProgram, "wezterm"):
                            outName = "WezTerm"
                            outType = RustCsgTerminalDetectionWezTerm
                        else:
                            if RustCsgTerminalDetectionMatchesTermProgram(termProgram, "kitty"):
                                outName = "kitty"
                                outType = RustCsgTerminalDetectionKitty
                            else:
                                if RustCsgTerminalDetectionMatchesTermProgram(termProgram, "alacritty"):
                                    outName = "Alacritty"
                                    outType = RustCsgTerminalDetectionAlacritty
                                else:
                                    if RustCsgTerminalDetectionMatchesTermProgram(termProgram, "windowsterminal"):
                                        outName = "WindowsTerminal"
                                        outType = RustCsgTerminalDetectionWindowsTerminal
                                    else:
                                        if RustCsgTerminalDetectionMatchesTermProgram(termProgram, "dumb"):
                                            outName = "dumb"
                                            outType = RustCsgTerminalDetectionDumb
                                        else:
                                            outName = termProgram
                                            outType = RustCsgTerminalDetectionUnknown

fn RustCsgTerminalDetectionTerminalNameFromTerm(term: str): int32 =
    if term == "dumb":
        return RustCsgTerminalDetectionDumb
    if term == "wezterm" || term == "wezterm-mux":
        return RustCsgTerminalDetectionWezTerm
    return RustCsgTerminalDetectionUnknown

fn RustCsgTerminalDetectionDetectFromEnv(outName: var str, outType: var int32) =
    outName = ""
    outType = RustCsgTerminalDetectionUnknown
    let termProgram = os.GetEnv("TERM_PROGRAM")
    if termProgram != "":
        RustCsgTerminalDetectionTerminalNameFromTermProgram(termProgram, outName, outType)
        return
    let kittyWin = os.GetEnv("KITTY_WINDOW_ID")
    if kittyWin != "":
        outName = "kitty"
        outType = RustCsgTerminalDetectionKitty
        return
    let alacrittyLog = os.GetEnv("ALACRITTY_LOG")
    if alacrittyLog != "":
        outName = "Alacritty"
        outType = RustCsgTerminalDetectionAlacritty
        return
    let weztermExec = os.GetEnv("WEZTERM_EXECUTABLE")
    if weztermExec != "":
        outName = "WezTerm"
        outType = RustCsgTerminalDetectionWezTerm
        return
    let wtSession = os.GetEnv("WT_SESSION")
    if wtSession != "":
        outName = "WindowsTerminal"
        outType = RustCsgTerminalDetectionWindowsTerminal
        return
    let vscodeInjection = os.GetEnv("VSCODE_INJECTION")
    if vscodeInjection != "":
        outName = "vscode"
        outType = RustCsgTerminalDetectionVsCode
        return
    let warpId = os.GetEnv("WARP_TERMINAL_ID")
    if warpId != "":
        outName = "WarpTerminal"
        outType = RustCsgTerminalDetectionWarp
        return
    let term = os.GetEnv("TERM")
    if term != "":
        let t = RustCsgTerminalDetectionTerminalNameFromTerm(term)
        outName = term
        if t != RustCsgTerminalDetectionUnknown:
            outType = t
        return

fn RustCsgTerminalDetectionDetectMultiplexerFromEnv(): int32 =
    let tmux = os.GetEnv("TMUX")
    if tmux != "":
        return RustCsgTerminalDetectionMuxTmux
    let zellij = os.GetEnv("ZELLIJ")
    if zellij != "":
        return RustCsgTerminalDetectionMuxZellij
    return RustCsgTerminalDetectionMuxNone

fn RustCsgTerminalDetectionSanitizeHeaderValue(value: str): str =
    let n = value.len
    if n == 0:
        return ""
    var result: str = ""
    var i: int32 = 0
    while i < n:
        let ch = value[i]
        if (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') ||
           (ch >= '0' && ch <= '9') || ch == '-' || ch == '_' ||
           ch == '.' || ch == '/':
            result = strutil.Join([result, strings.SliceBytes(value, i, 1)], "")
        else:
            result = strutil.Join([result, "_"], "")
        i = i + 1
    return result

fn RustCsgTerminalDetectionDetectUserAgent(): str =
    var name: str
    var termType: int32
    RustCsgTerminalDetectionDetectFromEnv(name, termType)
    if name != "":
        return RustCsgTerminalDetectionSanitizeHeaderValue(name)
    let mux = RustCsgTerminalDetectionDetectMultiplexerFromEnv()
    if mux == RustCsgTerminalDetectionMuxTmux:
        return "tmux"
    if mux == RustCsgTerminalDetectionMuxZellij:
        return "zellij"
    return "unknown"

# ── Capability constants ────────────────────────────────────────────────────
const RustCsgTerminalDetectionCapColor: int32 = 1
const RustCsgTerminalDetectionCap256Color: int32 = 2
const RustCsgTerminalDetectionCapTrueColor: int32 = 4
const RustCsgTerminalDetectionCapBracketedPaste: int32 = 8
const RustCsgTerminalDetectionCapMouseReporting: int32 = 16
const RustCsgTerminalDetectionCapHyperlinks: int32 = 32

# ── detectColorSupport ──────────────────────────────────────────────────────
# Determine color support level for a terminal type.
# Returns: 0=none, 1=basic(16), 2=256, 3=truecolor
fn RustCsgTerminalDetectionDetectColorSupport(termType: int32): int32 =
    if termType == RustCsgTerminalDetectionDumb:
        return 0
    if termType == RustCsgTerminalDetectionApple:
        return 2
    return 3

# ── getTerminalCapabilities ─────────────────────────────────────────────────
# Return capability flags bitmask for a terminal type.
fn RustCsgTerminalDetectionGetTerminalCapabilities(termType: int32): int32 =
    if termType == RustCsgTerminalDetectionDumb:
        return 0
    if termType == RustCsgTerminalDetectionApple:
        return RustCsgTerminalDetectionCapColor | RustCsgTerminalDetectionCap256Color
    if termType == RustCsgTerminalDetectionKitty || termType == RustCsgTerminalDetectionWezTerm || termType == RustCsgTerminalDetectionIterm2:
        return RustCsgTerminalDetectionCapTrueColor | RustCsgTerminalDetectionCapBracketedPaste | RustCsgTerminalDetectionCapMouseReporting | RustCsgTerminalDetectionCapHyperlinks
    if termType == RustCsgTerminalDetectionVsCode || termType == RustCsgTerminalDetectionAlacritty:
        return RustCsgTerminalDetectionCapTrueColor | RustCsgTerminalDetectionCapBracketedPaste
    if termType == RustCsgTerminalDetectionWarp || termType == RustCsgTerminalDetectionGhostty || termType == RustCsgTerminalDetectionWindowsTerminal:
        return RustCsgTerminalDetectionCapTrueColor | RustCsgTerminalDetectionCapBracketedPaste | RustCsgTerminalDetectionCapHyperlinks
    return RustCsgTerminalDetectionCapColor
