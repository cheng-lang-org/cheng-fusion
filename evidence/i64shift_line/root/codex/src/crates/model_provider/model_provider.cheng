import std/strings
import std/strutils as strutil

const ModelProviderCapChat: int32 = 1
const ModelProviderCapEmbeddings: int32 = 2
const ModelProviderCapVision: int32 = 4
const ModelProviderCapTools: int32 = 8
const ModelProviderCapStreaming: int32 = 16

const ModelProviderScoreMatch: int32 = 100
const ModelProviderScorePrefix: int32 = 50
const ModelProviderScoreFamily: int32 = 25
const ModelProviderScoreFallback: int32 = 10

type
    ModelProvider =
        name: str
        capabilities: int32
        modelPattern: str

const ModelProviderMaxProviders: int32 = 16

type
    ModelProviderList =
        provider0: ModelProvider
        provider1: ModelProvider
        provider2: ModelProvider
        provider3: ModelProvider
        provider4: ModelProvider
        provider5: ModelProvider
        provider6: ModelProvider
        provider7: ModelProvider
        provider8: ModelProvider
        provider9: ModelProvider
        provider10: ModelProvider
        provider11: ModelProvider
        provider12: ModelProvider
        provider13: ModelProvider
        provider14: ModelProvider
        provider15: ModelProvider
        count: int32

fn modelProviderListInit(): ModelProviderList =
    var l: ModelProviderList
    l.count = 0
    return l

fn modelProviderListAdd(l: var ModelProviderList, p: ModelProvider) =
    if l.count < ModelProviderMaxProviders:
        if l.count == 0:
            l.provider0 = p
        elif l.count == 1:
            l.provider1 = p
        elif l.count == 2:
            l.provider2 = p
        elif l.count == 3:
            l.provider3 = p
        elif l.count == 4:
            l.provider4 = p
        elif l.count == 5:
            l.provider5 = p
        elif l.count == 6:
            l.provider6 = p
        elif l.count == 7:
            l.provider7 = p
        elif l.count == 8:
            l.provider8 = p
        elif l.count == 9:
            l.provider9 = p
        elif l.count == 10:
            l.provider10 = p
        elif l.count == 11:
            l.provider11 = p
        elif l.count == 12:
            l.provider12 = p
        elif l.count == 13:
            l.provider13 = p
        elif l.count == 14:
            l.provider14 = p
        elif l.count == 15:
            l.provider15 = p
        l.count = l.count + 1

fn modelProviderGlobMatch(pattern: str, model: str): bool =
    if pattern == "" || pattern == "*":
        return true
    if pattern == model:
        return true
    var starPos: int32 = -1
    var si: int32
    while si < pattern.len:
        if pattern[si] == 42:
            starPos = si
            si = pattern.len
        si = si + 1
    if starPos >= 0:
        let prefix = strings.SliceBytes(pattern, 0, starPos)
        if strings.HasPrefix(model, prefix):
            return true
    return false

fn modelProviderPrefixMatch(prefix: str, model: str): bool =
    if prefix == "":
        return true
    return strings.HasPrefix(model, prefix)

fn modelProviderExtractFamily(model: str): str =
    var i: int32
    while i < model.len:
        let ch = model[i]
        if ch == 47 || ch == 46 || ch == 45 || ch == 58:
            if i > 0:
                return strings.SliceBytes(model, 0, i)
            return ""
        i = i + 1
    return model

fn modelProviderScoreMatch(provider: var ModelProvider, model: str): int32 =
    if provider.modelPattern == model:
        return 100
    if provider.modelPattern == "*" || provider.modelPattern == "":
        return 10
    if provider.modelPattern == "" || provider.modelPattern == "*":
        return 10
    var matched: bool
    if provider.modelPattern == model:
        matched = true
    if !matched:
        var starPos: int32 = -1
        var si: int32
        while si < provider.modelPattern.len:
            if provider.modelPattern[si] == 42:
                starPos = si
                si = provider.modelPattern.len
            si = si + 1
        if starPos >= 0:
            let prefix = strings.SliceBytes(provider.modelPattern, 0, starPos)
            if strings.HasPrefix(model, prefix):
                matched = true
    if matched:
        return 50
    var fam: str
    var i: int32
    while i < model.len:
        let ch = model[i]
        if ch == 47 || ch == 46 || ch == 45 || ch == 58:
            if i > 0:
                fam = strings.SliceBytes(model, 0, i)
            i = model.len
        i = i + 1
    if model != "" && fam == "":
        fam = model
    if fam != "":
        if fam == provider.modelPattern:
            return 25
        if strings.HasPrefix(provider.modelPattern, fam):
            return 25
    return 0

fn modelProviderListSelect(l: var ModelProviderList, model: str): str =
    if l.count <= 0:
        return ""
    if model == "":
        return ""
    var bestName: str
    var bestScore: int32 = -1
    var idx: int32
    while idx < l.count:
        var name: str
        var pat: str
        if idx == 0:
            name = l.provider0.name
            pat = l.provider0.modelPattern
        elif idx == 1:
            name = l.provider1.name
            pat = l.provider1.modelPattern
        elif idx == 2:
            name = l.provider2.name
            pat = l.provider2.modelPattern
        elif idx == 3:
            name = l.provider3.name
            pat = l.provider3.modelPattern
        elif idx == 4:
            name = l.provider4.name
            pat = l.provider4.modelPattern
        elif idx == 5:
            name = l.provider5.name
            pat = l.provider5.modelPattern
        elif idx == 6:
            name = l.provider6.name
            pat = l.provider6.modelPattern
        elif idx == 7:
            name = l.provider7.name
            pat = l.provider7.modelPattern
        elif idx == 8:
            name = l.provider8.name
            pat = l.provider8.modelPattern
        elif idx == 9:
            name = l.provider9.name
            pat = l.provider9.modelPattern
        elif idx == 10:
            name = l.provider10.name
            pat = l.provider10.modelPattern
        elif idx == 11:
            name = l.provider11.name
            pat = l.provider11.modelPattern
        elif idx == 12:
            name = l.provider12.name
            pat = l.provider12.modelPattern
        elif idx == 13:
            name = l.provider13.name
            pat = l.provider13.modelPattern
        elif idx == 14:
            name = l.provider14.name
            pat = l.provider14.modelPattern
        elif idx == 15:
            name = l.provider15.name
            pat = l.provider15.modelPattern

        var score: int32
        if pat == model:
            score = 100
        elif pat == "*" || pat == "":
            score = 10
        else:
            var matched: bool
            var starPos: int32 = -1
            var si: int32
            while si < pat.len:
                if pat[si] == 42:
                    starPos = si
                    si = pat.len
                si = si + 1
            if starPos >= 0:
                let prefix = strings.SliceBytes(pat, 0, starPos)
                if strings.HasPrefix(model, prefix):
                    matched = true
            if matched:
                score = 50
            else:
                var fam: str
                var mi: int32
                while mi < model.len:
                    let ch = model[mi]
                    if ch == 47 || ch == 46 || ch == 45 || ch == 58:
                        if mi > 0:
                            fam = strings.SliceBytes(model, 0, mi)
                        mi = model.len
                    mi = mi + 1
                if model != "" && fam == "":
                    fam = model
                if fam != "":
                    if strings.HasPrefix(pat, fam):
                        score = 25
        if score > bestScore:
            bestScore = score
            bestName = name
        idx = idx + 1
    return bestName

fn modelProviderSelectSimple(p0: str, p1: str, p2: str, p3: str, count: int32, model: str): str =
    if count <= 0:
        return ""
    if model == "":
        return p0
    var fam: str
    var i: int32
    while i < model.len:
        let ch = model[i]
        if ch == 47 || ch == 46 || ch == 45 || ch == 58:
            if i > 0:
                fam = strings.SliceBytes(model, 0, i)
            i = model.len
        i = i + 1
    if model != "" && fam == "":
        fam = model
    if fam == "":
        return p0
    if count >= 1 && p0 != "" && strings.HasPrefix(p0, fam):
        return p0
    if count >= 2 && p1 != "" && strings.HasPrefix(p1, fam):
        return p1
    if count >= 3 && p2 != "" && strings.HasPrefix(p2, fam):
        return p2
    if count >= 4 && p3 != "" && strings.HasPrefix(p3, fam):
        return p3
    return p0

fn modelProviderSupportsVision(provider: var ModelProvider): bool =
    return (provider.capabilities / 4) % 2 == 1

fn modelProviderSupportsStreaming(provider: var ModelProvider): bool =
    return (provider.capabilities / 16) % 2 == 1

fn modelProviderNew(name: str, capabilities: int32, modelPattern: str): ModelProvider =
    var p: ModelProvider
    p.name = name
    p.capabilities = capabilities
    p.modelPattern = modelPattern
    return p
