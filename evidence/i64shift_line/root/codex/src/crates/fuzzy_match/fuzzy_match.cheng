import std/strings
import std/strutils as strutil

# ═══════════════════════════════════════════════════════════════════════════════
# fuzzy-match: case-insensitive subsequence match with scoring
# Ported from codex-rs/fuzzy-match
# ═══════════════════════════════════════════════════════════════════════════════

const RustCsgFuzzyMatchMaxInt32: int32 = 2147483647

# Case-insensitive fuzzy subsequence match.
# Returns matching indices, a score (window size), and ok flag.
fn RustCsgFuzzyMatch(haystack: str, needle: str, outIndices: var int32[], outScore: var int32, outOk: var bool) =
    outOk = false
    outScore = 0
    if needle.len == 0:
        outOk = true
        outScore = RustCsgFuzzyMatchMaxInt32
        return
    # Lowercase haystack (byte by byte; ASCII A-Z add 32 to get a-z)
    var loweredChars: int32[]
    var loweredToOrig: int32[]
    var i: int32 = 0
    while i < haystack.len:
        let b = Int32(haystack[i])
        if b >= 65 && b <= 90:
            add(loweredChars, b + 32)
        else:
            add(loweredChars, b)
        add(loweredToOrig, i)
        i = i + 1
    # Lowercase needle
    var loweredNeedle: int32[]
    var j: int32 = 0
    while j < needle.len:
        let b = Int32(needle[j])
        if b >= 65 && b <= 90:
            add(loweredNeedle, b + 32)
        else:
            add(loweredNeedle, b)
        j = j + 1
    # Greedy left-to-right subsequence matching
    var resultOrig: int32[]
    var cur: int32 = 0
    var lastLowerPos: int32 = 0
    var hasLast: bool = false
    var ni: int32 = 0
    while ni < loweredNeedle.len:
        let nc = loweredNeedle[ni]
        var found: bool = false
        while cur < loweredChars.len:
            if loweredChars[cur] == nc:
                found = true
                add(resultOrig, loweredToOrig[cur])
                lastLowerPos = cur
                hasLast = true
                cur = cur + 1
                break
            cur = cur + 1
        if !found:
            return
        ni = ni + 1
    # Score: (lastLowerPos - firstLowerPos + 1) - needleLen, clamped >= 0
    var firstLowerPos: int32 = 0
    if resultOrig.len > 0:
        let targetOrig = resultOrig[0]
        var fi: int32 = 0
        while fi < loweredToOrig.len:
            if loweredToOrig[fi] == targetOrig:
                firstLowerPos = fi
                break
            fi = fi + 1
    if hasLast:
        let window = (lastLowerPos - firstLowerPos + 1) - loweredNeedle.len
        if window > 0:
            outScore = window
        else:
            outScore = 0
    # Sort and dedup resultOrig
    if resultOrig.len > 0:
        var sorted: int32[]
        var si: int32 = 0
        while si < resultOrig.len:
            add(sorted, resultOrig[si])
            si = si + 1
        # Bubble sort (small arrays, no built-in sort in Cheng)
        var n: int32 = sorted.len
        var swapped: bool = true
        while swapped:
            swapped = false
            var i2: int32 = 1
            while i2 < n:
                if sorted[i2 - 1] > sorted[i2]:
                    let tmp = sorted[i2 - 1]
                    sorted[i2 - 1] = sorted[i2]
                    sorted[i2] = tmp
                    swapped = true
                i2 = i2 + 1
            n = n - 1
        # Dedup
        var prev: int32 = -1
        var di: int32 = 0
        while di < sorted.len:
            if di == 0 || sorted[di] != prev:
                add(outIndices, sorted[di])
                prev = sorted[di]
            di = di + 1
    outOk = true

# ── fuzzyMatchMulti ─────────────────────────────────────────────────────────
# Match multiple needles against haystack, return the best (lowest-score) match.
fn fuzzyMatchMulti(haystack: str, needles: str[], outBestNeedle: var str, outBestScore: var int32, outOk: var bool) =
    outBestNeedle = ""
    outBestScore = 999999
    outOk = false
    var bestScore: int32 = 999999
    var foundAny: bool = false
    var bi: int32 = 0
    while bi < needles.len:
        var indices: int32[]
        var score: int32
        var ok: bool
        RustCsgFuzzyMatch(haystack, needles[bi], indices, score, ok)
        if ok:
            if !foundAny || score < bestScore:
                bestScore = score
                outBestNeedle = needles[bi]
                outBestScore = score
                foundAny = true
        bi = bi + 1
    outOk = foundAny

# ── fuzzyMatchHighlight ─────────────────────────────────────────────────────
# Highlight matched characters in haystack by wrapping them in ** markers.
fn fuzzyMatchHighlight(haystack: str, needle: str, outMarked: var str, outOk: var bool) =
    outMarked = ""
    outOk = false
    var indices: int32[]
    var score: int32
    var ok: bool
    RustCsgFuzzyMatch(haystack, needle, indices, score, ok)
    if !ok || indices.len == 0:
        outMarked = haystack
        outOk = false
        return
    var result: str = ""
    var mi: int32 = 0
    var hi: int32 = 0
    var inMarker: bool = false
    while hi < haystack.len:
        if mi < indices.len && hi == indices[mi]:
            if !inMarker:
                result = strutil.Join([result, "**"], "")
                inMarker = true
            result = strutil.Join([result, strings.SliceBytes(haystack, hi, 1)], "")
            mi = mi + 1
        else:
            if inMarker:
                result = strutil.Join([result, "**"], "")
                inMarker = false
            result = strutil.Join([result, strings.SliceBytes(haystack, hi, 1)], "")
        hi = hi + 1
    if inMarker:
        result = strutil.Join([result, "**"], "")
    outMarked = result
    outOk = true
