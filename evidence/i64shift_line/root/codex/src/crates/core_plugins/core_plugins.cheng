# core-plugins — plugin manager and marketplace types (ported from codex-rs)
#
# Pure type definitions: constant string names for the types and constants
# exported by core-plugins/src/lib.rs.

# ── Marketplace name constants ──────────────────────────────────────────

const CorePluginsOpenaiCuratedMarketplaceName: str = "openai-curated"
const CorePluginsOpenaiBundledMarketplaceName: str = "openai-bundled"

# ── Type aliases ────────────────────────────────────────────────────────

const CorePluginsLoadedPlugin: str = "LoadedPlugin"
const CorePluginsPluginLoadOutcome: str = "PluginLoadOutcome"

# ── ConfiguredMarketplace types ─────────────────────────────────────────

const CorePluginsConfiguredMarketplace: str = "ConfiguredMarketplace"
const CorePluginsConfiguredMarketplaceListOutcome: str = "ConfiguredMarketplaceListOutcome"
const CorePluginsConfiguredMarketplacePlugin: str = "ConfiguredMarketplacePlugin"

# ── Plugin detail/outcome types ─────────────────────────────────────────

const CorePluginsPluginDetail: str = "PluginDetail"
const CorePluginsPluginDetailsUnavailableReason: str = "PluginDetailsUnavailableReason"
const CorePluginsPluginInstallError: str = "PluginInstallError"
const CorePluginsPluginInstallOutcome: str = "PluginInstallOutcome"
const CorePluginsPluginInstallRequest: str = "PluginInstallRequest"
const CorePluginsPluginReadOutcome: str = "PluginReadOutcome"
const CorePluginsPluginReadRequest: str = "PluginReadRequest"
const CorePluginsPluginRemoteSyncError: str = "PluginRemoteSyncError"
const CorePluginsPluginUninstallError: str = "PluginUninstallError"
const CorePluginsPluginsConfigInput: str = "PluginsConfigInput"
const CorePluginsPluginsManager: str = "PluginsManager"
const CorePluginsRemotePluginSyncResult: str = "RemotePluginSyncResult"

# ── Marketplace upgrade types ───────────────────────────────────────────

const CorePluginsPluginMarketplaceUpgradeError: str = "PluginMarketplaceUpgradeError"
const CorePluginsPluginMarketplaceUpgradeOutcome: str = "PluginMarketplaceUpgradeOutcome"

fn RustCsgCorePluginsIsKnownMarketplaceName(name: str): bool =
    return name == CorePluginsOpenaiCuratedMarketplaceName || name == CorePluginsOpenaiBundledMarketplaceName

fn RustCsgCorePluginsIsPluginEnabled(name: str, configJson: str): bool =
    if name == "" || configJson == "":
        return false
    var i: int32 = 0
    while i < configJson.len:
        if configJson[i] == '"':
            var j: int32 = i + 1
            var k: int32 = 0
            while j < configJson.len && k < name.len && configJson[j] == name[k]:
                j = j + 1
                k = k + 1
            if k == name.len && j < configJson.len && configJson[j] == '"':
                return true
            i = j
        i = i + 1
    return false
