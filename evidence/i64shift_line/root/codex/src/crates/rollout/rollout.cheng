import std/strings

fn rolloutCat3(a: str, b: str, c: str): str =
    return strings.ConcatStr(strings.ConcatStr(a, b), c)

fn rolloutCat4(a: str, b: str, c: str, d: str): str =
    return strings.ConcatStr(rolloutCat3(a, b, c), d)

fn rolloutCat5(a: str, b: str, c: str, d: str, e: str): str =
    return strings.ConcatStr(rolloutCat4(a, b, c, d), e)

const RolloutDefaultFlushSize: int32 = 4096
const RolloutMaxBufferSize: int32 = 1048576

type
    RolloutRecorder =
        buffer: str
        flushSize: int32
        lineCount: int32
        flushedCount: int32
        totalBytesWritten: int32

fn rolloutRecorderInit(): RolloutRecorder =
    var r: RolloutRecorder
    r.buffer = ""
    r.flushSize = RolloutDefaultFlushSize
    r.lineCount = 0
    r.flushedCount = 0
    r.totalBytesWritten = 0
    return r

fn rolloutRecorderInitWithFlushSize(flushSize: int32): RolloutRecorder =
    var r: RolloutRecorder
    r.buffer = ""
    if flushSize > 0 && flushSize <= RolloutMaxBufferSize:
        r.flushSize = flushSize
    else:
        r.flushSize = RolloutDefaultFlushSize
    r.lineCount = 0
    r.flushedCount = 0
    r.totalBytesWritten = 0
    return r

fn rolloutEscapeJson(raw: str): str =
    var out: str
    var i: int32 = 0
    while i < raw.len:
        let ch = raw[i]
        if ch == 34:
            out = strings.ConcatStr(out, "\\\"")
        elif ch == 92:
            out = strings.ConcatStr(out, "\\\\")
        elif ch == 47:
            out = strings.ConcatStr(out, "\\/")
        elif ch == 10:
            out = strings.ConcatStr(out, "\\n")
        elif ch == 13:
            out = strings.ConcatStr(out, "\\r")
        elif ch == 9:
            out = strings.ConcatStr(out, "\\t")
        elif ch < 32:
            var hi = ch / 16
            var lo = ch % 16
            let hex = "0123456789abcdef"
            let hiStr = strings.SliceBytes(hex, hi, 1)
            let loStr = strings.SliceBytes(hex, lo, 1)
            out = rolloutCat4(out, "\\u00", hiStr, loStr)
        else:
            out = strings.ConcatStr(out, strings.SliceBytes(raw, i, 1))
        i = i + 1
    return out

fn rolloutBuildJsonlLineKV(key: str, value: str): str =
    var k = key
    var v = value
    var ek: str
    var ev: str
    var i: int32 = 0
    while i < k.len:
        let ch = k[i]
        if ch == 34: ek = strings.ConcatStr(ek, "\\\"")
        elif ch == 92: ek = strings.ConcatStr(ek, "\\\\")
        elif ch == 10: ek = strings.ConcatStr(ek, "\\n")
        elif ch == 13: ek = strings.ConcatStr(ek, "\\r")
        elif ch == 9: ek = strings.ConcatStr(ek, "\\t")
        else: ek = strings.ConcatStr(ek, strings.SliceBytes(k, i, 1))
        i = i + 1
    var j: int32 = 0
    while j < v.len:
        let ch = v[j]
        if ch == 34: ev = strings.ConcatStr(ev, "\\\"")
        elif ch == 92: ev = strings.ConcatStr(ev, "\\\\")
        elif ch == 10: ev = strings.ConcatStr(ev, "\\n")
        elif ch == 13: ev = strings.ConcatStr(ev, "\\r")
        elif ch == 9: ev = strings.ConcatStr(ev, "\\t")
        else: ev = strings.ConcatStr(ev, strings.SliceBytes(v, j, 1))
        j = j + 1
    return rolloutCat3(rolloutCat3("{\"", ek, "\":\""), ev, "\"}\n")

fn rolloutRecorderAppend(r: var RolloutRecorder, jsonlLine: str): int32 =
    if jsonlLine == "":
        return r.buffer.len
    r.buffer = strings.ConcatStr(r.buffer, jsonlLine)
    r.lineCount = r.lineCount + 1
    return r.buffer.len

fn rolloutRecorderAppendKV(r: var RolloutRecorder, key: str, value: str): int32 =
    var line = rolloutBuildJsonlLineKV(key, value)
    if line == "":
        return r.buffer.len
    r.buffer = strings.ConcatStr(r.buffer, line)
    r.lineCount = r.lineCount + 1
    return r.buffer.len

fn rolloutRecorderAppendJson(r: var RolloutRecorder, jsonStr: str): int32 =
    var line = jsonStr
    if line.len > 0 && line[line.len - 1] != 10:
        line = strings.ConcatStr(line, "\n")
    if line == "":
        return r.buffer.len
    r.buffer = strings.ConcatStr(r.buffer, line)
    r.lineCount = r.lineCount + 1
    return r.buffer.len

fn rolloutRecorderShouldFlush(r: var RolloutRecorder): bool =
    return r.buffer.len >= r.flushSize

fn rolloutRecorderFlush(r: var RolloutRecorder): str =
    if r.buffer == "":
        return ""
    let content = r.buffer
    r.flushedCount = r.flushedCount + r.lineCount
    r.totalBytesWritten = r.totalBytesWritten + content.len
    r.buffer = ""
    r.lineCount = 0
    return content

fn rolloutRecorderLineCount(r: var RolloutRecorder): int32 =
    return r.lineCount

fn rolloutRecorderFlushedCount(r: var RolloutRecorder): int32 =
    return r.flushedCount

fn rolloutRecorderTotalBytes(r: var RolloutRecorder): int32 =
    return r.totalBytesWritten

fn rolloutRecorderBufferSize(r: var RolloutRecorder): int32 =
    return r.buffer.len

fn rolloutRecorderRecord(r: var RolloutRecorder, jsonlLine: str): str =
    if jsonlLine != "":
        r.buffer = strings.ConcatStr(r.buffer, jsonlLine)
        r.lineCount = r.lineCount + 1
    if r.buffer.len >= r.flushSize:
        let content = r.buffer
        r.flushedCount = r.flushedCount + r.lineCount
        r.totalBytesWritten = r.totalBytesWritten + content.len
        r.buffer = ""
        r.lineCount = 0
        return content
    return ""

# ── Session index parsing ────────────────────────────────────────────────
type
    RolloutSessionEntry =
        sessionId: str
        timestamp: str
        model: str
        metadata: str

fn rolloutParseSessionIndex(line: str): RolloutSessionEntry =
    var entry: RolloutSessionEntry
    if line == "" || line[0] != '{':
        return entry
    var i: int32 = 1
    while i + 1 < line.len:
        # Find next quoted key
        while i < line.len && line[i] != '"':
            if line[i] == '}':
                return entry
            i = i + 1
        if i >= line.len:
            break
        if i > 0 && line[i - 1] == '\\':
            i = i + 1
            continue
        var keyStart: int32 = i + 1
        i = i + 1
        while i < line.len && line[i] != '"':
            if line[i] == '\\' && i + 1 < line.len:
                i = i + 1
            i = i + 1
        if i >= line.len:
            break
        var key: str = strings.SliceBytes(line, keyStart, i - keyStart)
        i = i + 1  # skip closing quote
        # Skip to colon
        while i < line.len && line[i] != ':':
            i = i + 1
        i = i + 1  # skip colon
        while i < line.len && (line[i] == ' ' || line[i] == '\t'):
            i = i + 1
        if i >= line.len:
            break
        # Read string value
        if line[i] == '"':
            var valStart: int32 = i + 1
            i = i + 1
            while i < line.len && line[i] != '"':
                if line[i] == '\\' && i + 1 < line.len:
                    i = i + 1
                i = i + 1
            if i >= line.len:
                break
            var value: str = strings.SliceBytes(line, valStart, i - valStart)
            i = i + 1
            if key == "sessionId":
                entry.sessionId = value
            elif key == "timestamp":
                entry.timestamp = value
            elif key == "model":
                entry.model = value
            else:
                if entry.metadata == "":
                    entry.metadata = strings.ConcatStr(rolloutCat4("\"", key, "\":\"", value), "\"")
                else:
                    entry.metadata = strings.ConcatStr(rolloutCat5(entry.metadata, ",\"", key, "\":\"", value), "\"")
        else:
            i = i + 1
    return entry

fn rolloutFilterByDate(entries: RolloutSessionEntry[], since: str, until: str): RolloutSessionEntry[] =
    var result: RolloutSessionEntry[]
    for i in 0..<entries.len:
        let entry = entries[i]
        if since != "":
            var ts: str = entry.timestamp
            # Check ts >= since via char-by-char comparison
            var minLen: int32 = ts.len
            if since.len < minLen:
                minLen = since.len
            var ge: bool = true
            for j in 0..<minLen:
                if ts[j] < since[j]:
                    ge = false
                    break
                if ts[j] > since[j]:
                    break
            if !ge:
                continue
            if ts.len < since.len:
                # ts is shorter prefix of since => ts < since
                continue
        if until != "":
            var ts: str = entry.timestamp
            # Check ts <= until via char-by-char comparison
            var minLen: int32 = ts.len
            if until.len < minLen:
                minLen = until.len
            var le: bool = true
            for j in 0..<minLen:
                if ts[j] > until[j]:
                    le = false
                    break
                if ts[j] < until[j]:
                    break
            if !le:
                continue
        add(result, entry)
    return result

# Compute session statistics from a list of entries.
# Returns JSON: {"count":N,"uniqueModels":N,"models":[...],"dateRange":{"from":"...","to":"..."}}
fn rolloutComputeSessionStats(entries: RolloutSessionEntry[]): str =
    var countStr: str = strings.Int64ToStr(int64(entries.len))
    var models: str[]
    var dateFrom: str = ""
    var dateTo: str = ""
    for i in 0..<entries.len:
        let entry = entries[i]
        # Collect unique models
        var found: bool
        for j in 0..<models.len:
            if models[j] == entry.model:
                found = true
                break
        if !found && entry.model != "":
            add(models, entry.model)
        # Track date range
        let ts: str = entry.timestamp
        if ts != "":
            if dateFrom == "" || ts < dateFrom:
                dateFrom = ts
            if dateTo == "" || ts > dateTo:
                dateTo = ts
    # Build models JSON array
    var modelsJson: str
    if models.len == 0:
        modelsJson = "[]"
    else:
        var modelParts: str[]
        for i in 0..<models.len:
            add(modelParts, rolloutCat3("\"", models[i], "\""))
        var modelPartsStr: str
        var mpi: int32 = 0
        while mpi < modelParts.len:
            if mpi > 0: modelPartsStr = strings.ConcatStr(modelPartsStr, ",")
            modelPartsStr = strings.ConcatStr(modelPartsStr, modelParts[mpi])
            mpi = mpi + 1
        modelsJson = rolloutCat3("[", modelPartsStr, "]")
    var uniqueCount: str = strings.Int64ToStr(int64(models.len))
    # Build dateRange
    var dateRangeJson: str
    if dateFrom == "" && dateTo == "":
        dateRangeJson = "{}"
    else:
        dateRangeJson = rolloutCat5("{\"from\":\"", dateFrom, "\",\"to\":\"", dateTo, "\"}")
    var out = rolloutCat5("{\"count\":", countStr, ",\"uniqueModels\":", uniqueCount, ",\"models\":")
    out = rolloutCat3(out, modelsJson, ",\"dateRange\":")
    return rolloutCat3(out, dateRangeJson, "}")

# Validate session entry consistency.
# Checks: sessionId not empty, timestamps are chronological within each session.
# Returns JSON: {"valid":true,"errors":[]} or {"valid":false,"errors":["..."]}
fn rolloutValidateSession(entries: RolloutSessionEntry[]): str =
    var errors: str[]
    var lastTs: str = ""
    for i in 0..<entries.len:
        let entry = entries[i]
        if entry.sessionId == "":
            add(errors, rolloutCat3("entry ", strings.Int64ToStr(int64(i)), ": sessionId is empty"))
        if entry.timestamp == "":
            add(errors, rolloutCat3("entry ", strings.Int64ToStr(int64(i)), ": timestamp is empty"))
        if lastTs != "" && entry.timestamp != "" && entry.timestamp < lastTs:
            var message = rolloutCat3("entry ", strings.Int64ToStr(int64(i)), ": timestamp out of order (")
            message = rolloutCat5(message, entry.timestamp, " < ", lastTs, ")")
            add(errors, message)
        if entry.timestamp != "":
            lastTs = entry.timestamp
    if errors.len == 0:
        return "{\"valid\":true,\"errors\":[]}"
    var errorParts: str[]
    for i in 0..<errors.len:
        add(errorParts, rolloutCat3("\"", errors[i], "\""))
    var errorPartsStr: str
    var epi: int32 = 0
    while epi < errorParts.len:
        if epi > 0: errorPartsStr = strings.ConcatStr(errorPartsStr, ",")
        errorPartsStr = strings.ConcatStr(errorPartsStr, errorParts[epi])
        epi = epi + 1
    var errorsJson: str = rolloutCat3("[", errorPartsStr, "]")
    return rolloutCat3("{\"valid\":false,\"errors\":", errorsJson, "}")
