# ── MCP Tool Call Builder ────────────────────────────────────────────────────

# Build an MCP tool call JSON string.
# Constructs {"toolName":"...","arguments":{...}} from the given toolName and
# arguments JSON string.
fn RustCsgBuildMcpToolCall(toolName: str, args: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("toolName", toolName))
    if args != "":
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("arguments", args))
    out = wire.RustCsgCat(out, "}")
    return out
