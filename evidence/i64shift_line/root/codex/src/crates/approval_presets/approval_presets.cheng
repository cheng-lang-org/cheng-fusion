import std/strings
import std/strutils as strutil

# ═══════════════════════════════════════════════════════════════════════════════
# approval_presets: built-in approval presets and permission profiles
# Ported from codex-rs/approval-presets
# ═══════════════════════════════════════════════════════════════════════════════
# NOTE: struct field access on array elements is broken in direct Mach-O mode.
# Using parallel arrays instead.

fn RustCsgApprovalPresetsBuiltinIds(): str[] =
    var out: str[]
    add(out, "read-only")
    add(out, "auto")
    add(out, "full-access")
    return out

fn RustCsgApprovalPresetsBuiltinLabels(): str[] =
    var out: str[]
    add(out, "Read Only")
    add(out, "Default")
    add(out, "Full Access")
    return out

fn RustCsgApprovalPresetsBuiltinApprovals(): str[] =
    var out: str[]
    add(out, "OnRequest")
    add(out, "OnRequest")
    add(out, "Never")
    return out

fn RustCsgApprovalPresetsBuiltinProfileIds(): str[] =
    var out: str[]
    add(out, "read-only")
    add(out, "workspace")
    add(out, "danger-full-access")
    return out

fn RustCsgApprovalPresetsBuiltinPermissionProfiles(): str[] =
    var out: str[]
    add(out, "read_only")
    add(out, "workspace_write")
    add(out, "disabled")
    return out

fn RustCsgApprovalPresetsBuiltinPermissionProfileForActivePermissionProfile(
    id: str,
    hasExtends: bool,
    outProfile: var str,
    outOk: var bool
) =
    outProfile = ""
    outOk = false
    if hasExtends:
        return
    if id == "read-only":
        outProfile = "read_only"
        outOk = true
    else:
        if id == "workspace":
            outProfile = "workspace_write"
            outOk = true
        else:
            if id == "danger-full-access":
                outProfile = "disabled"
                outOk = true
