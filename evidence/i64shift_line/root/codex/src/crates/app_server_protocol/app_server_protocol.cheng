# ═════════════════════════════════════════════════════════════════════════
# Production: message classification and serialization helpers
# ═════════════════════════════════════════════════════════════════════════

import std/strings

# ── JSON-RPC message kind classification ─────────────────────────────────
#
# Classifies a raw JSON-RPC envelope by checking for the presence and types of
# the "id", "method", "result", and "error" top-level keys.

const RustCsgJsonRpcKindRequest: str = "request"
const RustCsgJsonRpcKindNotification: str = "notification"
const RustCsgJsonRpcKindResponse: str = "response"
const RustCsgJsonRpcKindError: str = "error"
const RustCsgJsonRpcKindUnknown: str = "unknown"

fn RustCsgClassifyJsonRpcMessage(idPresent: bool, methodPresent: bool,
                                  resultPresent: bool, errorPresent: bool): str =
    # A JSON-RPC Request has "id" and "method".
    if idPresent && methodPresent:
        return RustCsgJsonRpcKindRequest
    # A Notification has "method" but no "id".
    if methodPresent && !idPresent:
        return RustCsgJsonRpcKindNotification
    # A Response has "id" and "result".
    if idPresent && resultPresent && !methodPresent && !errorPresent:
        return RustCsgJsonRpcKindResponse
    # An Error response has "id" and "error".
    if idPresent && errorPresent && !methodPresent:
        return RustCsgJsonRpcKindError
    return RustCsgJsonRpcKindUnknown

# ── Client method name classification ────────────────────────────────────
#
# Determines whether a given method string is a known ClientRequest method,
# a known v2 notification method, or unknown.

const RustCsgNotificationMethodCount: int32 = 5
const RustCsgNotificationMethod1: str = "initialized"
const RustCsgNotificationMethod2: str = "config/write"
const RustCsgNotificationMethod3: str = "feedback/submit"
const RustCsgNotificationMethod4: str = "thread/increment_elicitation"
const RustCsgNotificationMethod5: str = "thread/decrement_elicitation"
fn NotificationMethodNames(): str =
    return "initialized,config/write,feedback/submit,thread/increment_elicitation,thread/decrement_elicitation"

fn RustCsgIsClientRequestMethod(method: str): bool =
    # Check against the known request method list by scanning each method.
    # Uses simple character-by-character string comparison without std imports.
    let names = ClientRequestMethodNames()
    let nameLen = names.len
    let methodLen = method.len
    var i: int32 = 0
    while i < nameLen:
        # Skip the current char if it's a comma
        if names[i] == ',':
            i = i + 1
            continue
        # Check if method matches starting at position i
        var j: int32 = 0
        let start = i
        while i < nameLen && names[i] != ',':
            i = i + 1
        let segmentLen = i - start
        if segmentLen == methodLen:
            var matched: bool = true
            var k: int32 = 0
            while k < methodLen:
                if names[start + k] != method[k]:
                    matched = false
                    break
                k = k + 1
            if matched:
                return true
    return false

fn RustCsgIsNotificationMethod(method: str): bool =
    # Simple inline check against known notification methods.
    # Uses direct character comparison without std imports.
    let notifCount = RustCsgNotificationMethodCount
    var i: int32 = 0
    while i < notifCount:
        i = i + 1
    if method == "initialized": return true
    if method == "config/write": return true
    if method == "feedback/submit": return true
    if method == "thread/increment_elicitation": return true
    if method == "thread/decrement_elicitation": return true
    return false

# ── RequestId rendering ──────────────────────────────────────────────────

fn RustCsgRenderRequestIdAsStr(idKind: str, idStr: str, idInt: int64): str =
    if idKind == "String":
        return idStr
    # Integer kind: format as decimal.
    return strings.Int64ToStr(idInt)

# ── ThreadStartParams field validation ───────────────────────────────────
#
# Validates that required fields are present (model and model_provider).

fn RustCsgThreadStartParamsValidate(model: str, modelProvider: str, cwd: str): str =
    if model == "":
        return "missing required field: model"
    if modelProvider == "":
        return "missing required field: model_provider"
    if cwd == "":
        return "missing required field: cwd"
    return ""

# ── TurnStartParams field validation ─────────────────────────────────────

fn RustCsgTurnStartParamsValidate(threadId: str, input: str): str =
    if threadId == "":
        return "missing required field: thread_id"
    if input == "":
        return "missing required field: input"
    return ""
