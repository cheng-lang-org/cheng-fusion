#
# Ported from codex-rs/codex-cloud-tasks-mock-client/src/{lib, mock}.rs
# Covers: MockClient struct, mock data patterns

import std/strutils as strutl
import std/strings

# ── MockClient (struct implementing CloudBackend) ──────────────────────
const RustCsgMockClientFieldCount: int32 = 0

# ── CloudBackend trait method count ───────────────────────────────────
# MockClient implements all 9 CloudBackend methods
const RustCsgMockClientMethodCount: int32 = 9

# ── Mock environment-specific task counts ───────────────────────────
