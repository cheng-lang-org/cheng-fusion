const RustCsgMockGlobalTaskCount: int32 = 3
# Environment "env-A": 1 task (T-2000)
const RustCsgMockEnvATaskCount: int32 = 1
# Environment "env-B": 2 tasks (T-3000, T-3001)
const RustCsgMockEnvBTaskCount: int32 = 2

