const RustCsgMockDiffLinesRemovedDefault: int32 = 0

# ── T-1000 has attempt_total = 2, others have 1 ──────────────────────
const RustCsgMockAttemptTotalT1000: int32 = 2
const RustCsgMockAttemptTotalDefault: int32 = 1

# ── Production functions ────────────────────────────────────────────────

fn generateMockTaskId(counter: int32): str =
    return strutl.Join(["T-", strings.Int64ToStr(int64(1000 + counter))], "")

# ── simulateTaskLifecycle: returns state transitions for a mock task ──────
# Returns a JSON array of state transition objects simulating a full
# task lifecycle: pending -> ready -> applied.
# Each transition has "from", "to", and "at" fields.

fn simulateTaskLifecycle(taskId: str): str =
    var out: str = "[{\"from\":\"none\",\"to\":\"pending\",\"task_id\":\""
    out = strings.ConcatStr(out, taskId)
    out = strings.ConcatStr(out, "\"},{\"from\":\"pending\",\"to\":\"ready\",\"task_id\":\"")
    out = strings.ConcatStr(out, taskId)
    out = strings.ConcatStr(out, "\"},{\"from\":\"ready\",\"to\":\"applied\",\"task_id\":\"")
    out = strings.ConcatStr(out, taskId)
    out = strings.ConcatStr(out, "\"}]")
    return out
