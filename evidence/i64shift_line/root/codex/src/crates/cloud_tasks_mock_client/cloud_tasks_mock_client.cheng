const RustCsgMockTaskIdGlobal2: str = "T-1001"
const RustCsgMockTaskIdGlobal3: str = "T-1002"
const RustCsgMockTaskIdEnvA1: str = "T-2000"
const RustCsgMockTaskIdEnvB1: str = "T-3000"
const RustCsgMockTaskIdEnvB2: str = "T-3001"

