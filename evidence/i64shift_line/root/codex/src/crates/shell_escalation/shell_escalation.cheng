# ═══════════════════════════════════════════════════════════════════════════════
# shell-escalation: command escalation policy determination
# Ported from codex-rs/shell-escalation
#
# NOTE: Uses index-based command name matching to avoid str+char/char+str
# concatenation bugs and SliceStr start>0 crash in standalone Mach-O mode.
# ═══════════════════════════════════════════════════════════════════════════════

import std/strings
import std/strutils as strutil

# EscalationPolicy enum constants
const
    RustCsgShellEscalationPolicyNone: int32 = 0
    RustCsgShellEscalationPolicyConfirm: int32 = 1
    RustCsgShellEscalationPolicyAutoEscalate: int32 = 2
    RustCsgShellEscalationPolicyBlock: int32 = 3

# ── Index-based first-word check helper ─────────────────────────────────────
# Check if the first word of `command` (up to whitespace, stripping path prefix)
# matches `target`. All character comparisons are done in-place without building
# any substrings.
fn firstWordEquals(command: str, target: str): bool =
    if command == "" || target == "":
        return false
    # Find end of first word (up to first whitespace)
    var wordEnd: int32 = command.len
    for i in 0..<command.len:
        if command[i] == ' ' || command[i] == '\t' || command[i] == '\n':
            wordEnd = i
            break
    if wordEnd == 0:
        return false
    # Find last / in first word to strip path prefix
    var slashIdx: int32 = -1
    for i in 0..<wordEnd:
        if command[i] == '/':
            slashIdx = i
    var nameStart: int32 = slashIdx + 1
    # Compare target against command[nameStart..wordEnd)
    if nameStart + target.len != wordEnd:
        return false
    for i in 0..<target.len:
        if command[nameStart + i] != target[i]:
            return false
    return true

# ── Check if cwd is in a system directory ──────────────────────────────────
# Uses direct char prefix comparison (avoids strutil import which can cause
# issues in some standalone compile scenarios).
fn seIsSystemPath(cwd: str): bool =
    if cwd == "":
        return false
    # Exact matches for known system roots
    if cwd == "/" || cwd == "/etc" || cwd == "/usr" || cwd == "/opt" || cwd == "/var":
        return true
    if cwd == "/bin" || cwd == "/sbin":
        return true
    if cwd == "/System" || cwd == "/Library":
        return true
    # Prefix matches: check if cwd starts with known system prefixes
    if cwd.len >= 4:
        # /etc/...
        if cwd[0] == '/' && cwd[1] == 'e' && cwd[2] == 't' && cwd[3] == 'c' && (cwd.len == 4 || cwd[4] == '/'):
            return true
    if cwd.len >= 4:
        # /usr/...
        if cwd[0] == '/' && cwd[1] == 'u' && cwd[2] == 's' && cwd[3] == 'r' && (cwd.len == 4 || cwd[4] == '/'):
            return true
    if cwd.len >= 4:
        # /opt/...
        if cwd[0] == '/' && cwd[1] == 'o' && cwd[2] == 'p' && cwd[3] == 't' && (cwd.len == 4 || cwd[4] == '/'):
            return true
    if cwd.len >= 4:
        # /var/...
        if cwd[0] == '/' && cwd[1] == 'v' && cwd[2] == 'a' && cwd[3] == 'r' && (cwd.len == 4 || cwd[4] == '/'):
            return true
    if cwd.len >= 5:
        # /bin/...
        if cwd[0] == '/' && cwd[1] == 'b' && cwd[2] == 'i' && cwd[3] == 'n' && (cwd.len == 5 || cwd[4] == '/'):
            return true
        # /sbin/...
        if cwd[0] == '/' && cwd[1] == 's' && cwd[2] == 'b' && cwd[3] == 'i' && cwd[4] == 'n' && (cwd.len == 5 || cwd[5] == '/'):
            return true
    if cwd.len >= 7:
        # /System/...
        if cwd[0] == '/' && cwd[1] == 'S' && cwd[2] == 'y' && cwd[3] == 's' && cwd[4] == 't' && cwd[5] == 'e' && cwd[6] == 'm' && (cwd.len == 7 || cwd[7] == '/'):
            return true
    if cwd.len >= 8:
        # /Library/...
        if cwd[0] == '/' && cwd[1] == 'L' && cwd[2] == 'i' && cwd[3] == 'b' && cwd[4] == 'r' && cwd[5] == 'a' && cwd[6] == 'r' && cwd[7] == 'y' && (cwd.len == 8 || cwd[8] == '/'):
            return true
    return false

# ── Escalation policy for command ──────────────────────────────────────────
fn RustCsgShellEscalationPolicyForCommand(command: str, cwd: str): int32 =
    if command == "":
        return RustCsgShellEscalationPolicyBlock

    # Existing privilege escalators
    if firstWordEquals(command, "sudo"):
        return RustCsgShellEscalationPolicyConfirm
    if firstWordEquals(command, "doas"):
        return RustCsgShellEscalationPolicyConfirm
    if firstWordEquals(command, "su"):
        return RustCsgShellEscalationPolicyConfirm

    # Package managers
    if firstWordEquals(command, "apt"):
        return RustCsgShellEscalationPolicyConfirm
    if firstWordEquals(command, "apt-get"):
        return RustCsgShellEscalationPolicyConfirm
    if firstWordEquals(command, "aptitude"):
        return RustCsgShellEscalationPolicyConfirm
    if firstWordEquals(command, "yum"):
        return RustCsgShellEscalationPolicyConfirm
    if firstWordEquals(command, "dnf"):
        return RustCsgShellEscalationPolicyConfirm
    if firstWordEquals(command, "zypper"):
        return RustCsgShellEscalationPolicyConfirm
    if firstWordEquals(command, "pacman"):
        return RustCsgShellEscalationPolicyConfirm
    if firstWordEquals(command, "brew"):
        return RustCsgShellEscalationPolicyConfirm
    if firstWordEquals(command, "port"):
        return RustCsgShellEscalationPolicyConfirm
    if firstWordEquals(command, "mas"):
        return RustCsgShellEscalationPolicyConfirm
    if firstWordEquals(command, "dpkg"):
        return RustCsgShellEscalationPolicyConfirm
    if firstWordEquals(command, "rpm"):
        return RustCsgShellEscalationPolicyConfirm
    if firstWordEquals(command, "snap"):
        return RustCsgShellEscalationPolicyConfirm
    if firstWordEquals(command, "flatpak"):
        return RustCsgShellEscalationPolicyConfirm
    if firstWordEquals(command, "pip") || firstWordEquals(command, "pip3"):
        if seIsSystemPath(cwd):
            return RustCsgShellEscalationPolicyConfirm
    if firstWordEquals(command, "npm"):
        if seIsSystemPath(cwd):
            return RustCsgShellEscalationPolicyConfirm
    if firstWordEquals(command, "gem"):
        if seIsSystemPath(cwd):
            return RustCsgShellEscalationPolicyConfirm
    if firstWordEquals(command, "cargo"):
        if seIsSystemPath(cwd):
            return RustCsgShellEscalationPolicyConfirm

    # System administration commands
    if firstWordEquals(command, "chmod") || firstWordEquals(command, "chown") || firstWordEquals(command, "chgrp"):
        if seIsSystemPath(cwd):
            return RustCsgShellEscalationPolicyConfirm
    if firstWordEquals(command, "passwd") || firstWordEquals(command, "vipw") || firstWordEquals(command, "vigr"):
        return RustCsgShellEscalationPolicyConfirm
    if firstWordEquals(command, "mount") || firstWordEquals(command, "umount") || firstWordEquals(command, "mkfs") || firstWordEquals(command, "fdisk") || firstWordEquals(command, "parted"):
        return RustCsgShellEscalationPolicyConfirm
    if firstWordEquals(command, "systemctl") || firstWordEquals(command, "service") || firstWordEquals(command, "initctl"):
        return RustCsgShellEscalationPolicyConfirm
    if firstWordEquals(command, "launchctl"):
        return RustCsgShellEscalationPolicyConfirm
    if firstWordEquals(command, "rm") || firstWordEquals(command, "mv") || firstWordEquals(command, "cp") || firstWordEquals(command, "ln"):
        if seIsSystemPath(cwd):
            return RustCsgShellEscalationPolicyConfirm

    # Security-sensitive operations
    if firstWordEquals(command, "ssh") || firstWordEquals(command, "scp") || firstWordEquals(command, "sftp"):
        return RustCsgShellEscalationPolicyConfirm
    if firstWordEquals(command, "login") || firstWordEquals(command, "logout"):
        return RustCsgShellEscalationPolicyConfirm

    return RustCsgShellEscalationPolicyNone

# ── Audit log ────────────────────────────────────────────────────────────
type
    RustCsgShellEscalationEvent =
        timestamp: str
        command: str
        policy: int32
        outcome: str

fn RustCsgShellEscalationAuditLog(history: RustCsgShellEscalationEvent[]): str =
    if history.len == 0:
        return "No escalation events logged."
    var lines: str[]
    add(lines, "Escalation Audit Log")
    add(lines, "-------------------")
    for i in 0..<history.len:
        var eventLine: str = strutil.Join([
            history[i].timestamp,
            " | ",
            history[i].command,
            " | policy=",
            strings.Int64ToStr(int64(history[i].policy)),
            " | ",
            history[i].outcome
        ], "")
        add(lines, eventLine)
    return strutil.Join(lines, "\n")

fn RustCsgShellEscalationPolicyToJson(policy: int32): str =
    if policy == RustCsgShellEscalationPolicyNone:
        return "\"none\""
    elif policy == RustCsgShellEscalationPolicyConfirm:
        return "\"confirm\""
    elif policy == RustCsgShellEscalationPolicyAutoEscalate:
        return "\"auto_escalate\""
    elif policy == RustCsgShellEscalationPolicyBlock:
        return "\"block\""
    return "\"unknown\""
