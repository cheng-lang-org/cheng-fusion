import std/strings as strings
import std/strutils as strutil

# ── Install function name ───────────────────────────────────────────────

const RustCsgExtMemoriesInstallFnName: str = "install"

# Trim leading and trailing whitespace from a string.
fn trimWs(s: str): str =
    if s.len == 0:
        return ""
    var start: int32 = 0
    while start < s.len:
        let c = s[start]
        if c != ' ' && c != '\t' && c != '\n' && c != '\r':
            break
        start = start + 1
    if start >= s.len:
        return ""
    var end: int32 = s.len - 1
    while end >= start:
        let c = s[end]
        if c != ' ' && c != '\t' && c != '\n' && c != '\r':
            break
        end = end - 1
    return strings.SliceBytes(s, start, end - start + 1)

# Format a comma-separated list of memory entries into an XML-like context block.
# Each memory entry is wrapped in <entry> tags within a <memory_context> block.
# Returns empty string for empty input.
fn formatMemoryContext(memories: str): str =
    if memories.len == 0:
        return ""
    var lines: str[]
    add(lines, "<memory_context>")
    var i: int32 = 0
    var entryStart: int32 = 0
    while i < memories.len:
        if memories[i] == ',':
            var entry: str = trimWs(strings.SliceBytes(memories, entryStart, i - entryStart))
            if entry.len > 0:
                add(lines, strutil.Join(["  <entry>", entry, "</entry>"], ""))
            i = i + 1
            entryStart = i
        else:
            i = i + 1
    # Last entry
    var entry: str = trimWs(strings.SliceBytes(memories, entryStart, i - entryStart))
    if entry.len > 0:
        add(lines, strutil.Join(["  <entry>", entry, "</entry>"], ""))
    add(lines, "</memory_context>")
    return strutil.Join(lines, "\n")
