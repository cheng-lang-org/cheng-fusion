# utils/pty: Terminal size parsing and PTY command construction
# Ported from codex-rs/utils/pty/src/lib.rs
#
# Provides parseTerminalSize for parsing "rows x cols" terminal size strings
# and buildPtyCommand for constructing PTY launch command strings.

import std/strings
import std/strutils as strutil

# ── parseTerminalSize ──────────────────────────────────────────────────────
# Parse a terminal size string in "rows x cols" format.
# Returns true on success with outRows/outCols set, false on failure.
fn RustCsgUtilsPtyParseTerminalSize(sizeStr: str, outRows: var int32, outCols: var int32): bool =
    outRows = 0
    outCols = 0
    if sizeStr.len == 0:
        return false

    var xIdx: int32 = -1
    for i in 0..<sizeStr.len:
        let ch = sizeStr[i]
        if ch == 'x' || ch == 'X':
            xIdx = i
            break

    if xIdx <= 0 || xIdx >= sizeStr.len - 1:
        return false

    let rowsPart: str = strings.SliceBytes(sizeStr, 0, xIdx)
    let colsPart: str = strings.SliceBytes(sizeStr, xIdx + 1, sizeStr.len - xIdx - 1)

    let rowsTrimmed: str = strutil.Strip(rowsPart)
    let colsTrimmed: str = strutil.Strip(colsPart)

    if rowsTrimmed.len == 0 || colsTrimmed.len == 0:
        return false

    var rows: int32 = 0

    for i in 0..<rowsTrimmed.len:
        let ch = rowsTrimmed[i]
        if ch >= '0' && ch <= '9':
            rows = rows * 10 + (int32(ch) - int32('0'))
        else:
            return false

    var cols: int32 = 0
    for i in 0..<colsTrimmed.len:
        let ch = colsTrimmed[i]
        if ch >= '0' && ch <= '9':
            cols = cols * 10 + (int32(ch) - int32('0'))
        else:
            return false

    outRows = rows
    outCols = cols
    return true

# ── buildPtyCommand ────────────────────────────────────────────────────────
# Construct a PTY launch command string from program and args array.
# Uses shell-style quoting: args containing spaces are quoted with single quotes.
# Returns the command string.
fn RustCsgUtilsPtyBuildCommand(program: str, args: str[]): str =
    var result: str = program
    var i: int32 = 0
    while i < args.len:
        let arg: str = args[i]
        if arg.len == 0:
            let emptyQuoted: str = strutil.Join(["''"], "")
            result = strutil.Join([result, emptyQuoted], " ")
        else:
            # Check if arg contains a space
            var hasSpace: bool = false
            var j: int32 = 0
            while j < arg.len:
                if arg[j] == ' ':
                    hasSpace = true
                    break
                j = j + 1
            if hasSpace:
                let quoted: str = strutil.Join(["'", arg, "'"], "")
                result = strutil.Join([result, quoted], " ")
            else:
                result = strutil.Join([result, arg], " ")
        i = i + 1
    return result

# ── ptyFormatCommand ───────────────────────────────────────────────────────
# Format a full PTY command string with environment variables and working
# directory. The result is suitable for launching via a PTY.
# Format: "cd <cwd> && <ENV1>=<VAL1> <ENV2>=<VAL2> <program> <arg1> <arg2>..."
# Each env entry must be in "KEY=VALUE" format; entries without '=' are skipped.
# Args are quoted if they contain spaces (same quoting as buildPtyCommand).
# Returns the formatted command string.
fn RustCsgUtilsPtyFormatCommand(program: str, args: str[], cwd: str, env: str[]): str =
    var cmd: str = ""

    # Prepend cd if cwd is not empty
    if cwd.len > 0:
        cmd = strutil.Join(["cd ", cwd], "")

    # Append env vars
    var ei: int32 = 0
    while ei < env.len:
        let entry: str = env[ei]
        # Skip entries without '='
        var hasEq: bool = false
        var eqPos: int32 = 0
        while eqPos < entry.len:
            if entry[eqPos] == '=':
                hasEq = true
                break
            eqPos = eqPos + 1
        if hasEq:
            if cmd.len > 0:
                cmd = strutil.Join([cmd, " && ", entry], "")
            else:
                cmd = entry
        ei = ei + 1

    # Append program
    if cmd.len > 0:
        cmd = strutil.Join([cmd, " ", program], "")
    else:
        cmd = program

    # Append args
    var ai: int32 = 0
    while ai < args.len:
        let arg: str = args[ai]
        if arg.len == 0:
            cmd = strutil.Join([cmd, " ''"], "")
        else:
            var hasSpace: bool = false
            var aj: int32 = 0
            while aj < arg.len:
                if arg[aj] == ' ':
                    hasSpace = true
                    break
                aj = aj + 1
            if hasSpace:
                cmd = strutil.Join([cmd, " '", arg, "'"], "")
            else:
                cmd = strutil.Join([cmd, " ", arg], "")
        ai = ai + 1

    return cmd
