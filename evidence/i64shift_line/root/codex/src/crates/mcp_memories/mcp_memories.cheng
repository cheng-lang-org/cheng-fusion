# ═══════════════════════════════════════════════════════════════════════════
# Production Functions
# ═══════════════════════════════════════════════════════════════════════════

# Build a JSON query string for MCP memory search.
# Produces {"query":"<escaped>"} or {} for empty input.
# Escapes " and \ in the query string for JSON safety.
fn buildMcpMemoryQuery(query: str): str =
    if query.len == 0:
        return "{}"
    var json = "{\"query\":\""
    var i: int32 = 0
    while i < query.len:
        let ch = Int32(query[i])
        if ch == 34:       # '"'
            json = strutil.Join([json, "\\\""], "")
        elif ch == 92:      # '\'
            json = strutil.Join([json, "\\\\"], "")
        else:
            json = strutil.Join([json, strings.SliceBytes(query, i, 1)], "")
        i = i + 1
    json = strutil.Join([json, "\"}"], "")
    return json

# ── mcpMemoriesBuildToolResponse: builds an MCP tool response JSON ──────────
# Takes a comma-separated list of result strings and builds an MCP-formatted
# JSON tool response. Each result is wrapped in a content item.
# Returns {"content":[{"type":"text","text":"..."}]} for non-empty results,
# or {"content":[],"isError":true} for empty results.

fn mcpMemoriesBuildToolResponse(results: str): str =
    var out: str = "{\"content\":["
    if results.len == 0:
        return "{\"content\":[],\"isError\":true}"
    var i: int32 = 0
    var start: int32 = 0
    var itemCount: int32 = 0
    while i <= results.len:
        var isSep: bool = false
        if i == results.len || results[i] == ',':
            isSep = true
        if isSep:
            var itemLen: int32 = i - start
            if itemLen > 0:
                if itemCount > 0:
                    out = strutil.Join([out, ","], "")
                # Build {"type":"text","text":"..."}
                out = strutil.Join([out, "{\"type\":\"text\",\"text\":"], "")
                var item: str
                var si: int32 = start
                while si < i:
                    let ch = Int32(results[si])
                    if ch == 34:
                        item = strutil.Join([item, "\\\""], "")
                    elif ch == 92:
                        item = strutil.Join([item, "\\\\"], "")
                    else:
                        item = strutil.Join([item, strings.SliceBytes(results, si, 1)], "")
                    si = si + 1
                out = strutil.Join([out, "\"", item, "\"}"], "")
                itemCount = itemCount + 1
            start = i + 1
        i = i + 1
    out = strutil.Join([out, "]}"], "")
    return out
