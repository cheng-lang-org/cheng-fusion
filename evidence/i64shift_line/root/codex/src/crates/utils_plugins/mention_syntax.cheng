import std/strings

// Plugin/tool mention sigils — ported from codex-rs utils/plugins mention_syntax

const
    RustCsgToolMentionSigil: char = '$'
    RustCsgPluginTextMentionSigil: char = '@'

// Parse a plugin manifest JSON string and extract name and version.
// Expects format: {"name":"x","version":"y"}
// Returns "name@version" on success, or just name if version not found.
fn parsePluginManifest(manifestJson: str): str =
    if manifestJson.len == 0:
        return ""
    var name: str
    var version: str
    var i: int32 = 0
    while i < manifestJson.len:
        if i + 6 <= manifestJson.len && manifestJson[i] == '"' && manifestJson[i+1] == 'n' && manifestJson[i+2] == 'a' && manifestJson[i+3] == 'm' && manifestJson[i+4] == 'e' && manifestJson[i+5] == '"':
            i = i + 6
            while i < manifestJson.len && manifestJson[i] != '"':
                i = i + 1
            if i < manifestJson.len:
                i = i + 1
                var ns: int32 = i
                while i < manifestJson.len && manifestJson[i] != '"':
                    i = i + 1
                if i > ns:
                    name = strings.SliceBytes(manifestJson, ns, i - ns)
        elif i + 9 <= manifestJson.len && manifestJson[i] == '"' && manifestJson[i+1] == 'v' && manifestJson[i+2] == 'e' && manifestJson[i+3] == 'r' && manifestJson[i+4] == 's' && manifestJson[i+5] == 'i' && manifestJson[i+6] == 'o' && manifestJson[i+7] == 'n' && manifestJson[i+8] == '"':
            i = i + 9
            while i < manifestJson.len && manifestJson[i] != '"':
                i = i + 1
            if i < manifestJson.len:
                i = i + 1
                var vs: int32 = i
                while i < manifestJson.len && manifestJson[i] != '"':
                    i = i + 1
                if i > vs:
                    version = strings.SliceBytes(manifestJson, vs, i - vs)
        else:
            i = i + 1
    if name.len > 0 && version.len > 0:
        return strings.ConcatStr(strings.ConcatStr(name, "@"), version)
    return name
