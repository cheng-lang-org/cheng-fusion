# Library: linux-sandbox — bubblewrap sandbox command construction
# Production implementation: buildBwrapCommand(rootPath, workDir, command)
# constructs the full bwrap sandbox command string with proper mount
# namespacing, readonly paths, and tmpfs allocation.
#
# Ported from codex-rs/linux-sandbox

import std/strutils as strutil

# ══════════════════════════════════════════════════════════════════════════
# Constants
# ══════════════════════════════════════════════════════════════════════════

const BwrapBinDefault: str = "/usr/bin/bwrap"

# ══════════════════════════════════════════════════════════════════════════
# Bubblewrap detection
# ══════════════════════════════════════════════════════════════════════════

fn RustCsgLinuxSandboxDetectBwrapAvailable(): bool =
    return false

# ══════════════════════════════════════════════════════════════════════════
# Bwrap command construction
# ══════════════════════════════════════════════════════════════════════════

# Build a full bwrap sandbox command string.
# Parameters:
#   rootPath  - The root filesystem path to use as the new root (/)
#   workDir   - The working directory inside the sandbox
#   command   - The command to run inside the sandbox
#
# Returns the full command string, or "" if any parameter is invalid.
fn buildBwrapCommand(rootPath: str, workDir: str, command: str): str =
    if rootPath == "":
        return ""
    if command == "":
        return ""

    var out: str
    out = BwrapBinDefault
    out = strutil.Join([out, " --unshare-all --share-net --new-session"], "")
    out = strutil.Join([out, " --bind ", rootPath, " /"], "")

    # Mount readonly system directories
    out = strutil.Join([out, " --ro-bind ", rootPath, "/usr /usr"], "")
    out = strutil.Join([out, " --ro-bind ", rootPath, "/lib /lib"], "")
    out = strutil.Join([out, " --ro-bind ", rootPath, "/lib64 /lib64"], "")
    out = strutil.Join([out, " --ro-bind ", rootPath, "/bin /bin"], "")
    out = strutil.Join([out, " --ro-bind ", rootPath, "/sbin /sbin"], "")
    out = strutil.Join([out, " --ro-bind ", rootPath, "/etc /etc"], "")
    out = strutil.Join([out, " --ro-bind ", rootPath, "/opt /opt"], "")
    out = strutil.Join([out, " --ro-bind ", rootPath, "/nix/store /nix/store"], "")

    if workDir != "":
        out = strutil.Join([out, " --bind ", workDir, " ", workDir], "")
        out = strutil.Join([out, " --chdir ", workDir], "")

    out = strutil.Join([out, " --setenv HOME /home/user"], "")
    out = strutil.Join([out, " --setenv PATH /usr/bin:/bin"], "")
    out = strutil.Join([out, " --tmpfs /tmp"], "")
    out = strutil.Join([out, " --proc /proc"], "")
    out = strutil.Join([out, " --dev /dev"], "")
    out = strutil.Join([out, " --symlink /usr/bin /bin"], "")
    out = strutil.Join([out, " ", command], "")

    return out

# Build a seccomp BPF program string from a profile name.
# Supported profiles: "default", "strict", "no_write", "network_only"
# Returns the seccomp filter description string, or "" for unknown profiles.
fn RustCsgLinuxSandboxBuildSeccomp(profile: str): str =
    if profile == "default":
        return "ldr [0] jeq #0xc000003e allow kill"
    elif profile == "strict":
        return "ldr [0] jeq #0xc000003e allow jeq #0x40000003 allow kill"
    elif profile == "no_write":
        return "ldr [0] jeq #0xc000003e allow jge #0x40000000 kill allow"
    elif profile == "network_only":
        return "ldr [0] jeq #0xc000003e allow jeq #0x20000001 allow kill"
    return ""

# Build a minimal bwrap command (no readonly dirs, no tmpfs/proc/dev).
fn buildBwrapCommandMinimal(rootPath: str, workDir: str, command: str): str =
    if rootPath == "":
        return ""
    if command == "":
        return ""

    var out: str
    out = BwrapBinDefault
    out = strutil.Join([out, " --unshare-all --share-net --new-session"], "")
    out = strutil.Join([out, " --bind ", rootPath, " /"], "")

    if workDir != "":
        out = strutil.Join([out, " --bind ", workDir, " ", workDir], "")

    out = strutil.Join([out, " ", command], "")

    return out
