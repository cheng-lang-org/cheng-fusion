# utils/image: Image format detection and dimension formatting
# Ported from codex-rs/utils/image/src/lib.rs
#
# Provides detectImageMimeType for identifying image formats
# and getImageDimensions for formatting dimension strings.

import std/strings
import std/strutils as strutil

# ── detectImageMimeType ────────────────────────────────────────────────────
# Detect image MIME type from magic bytes.
# Checks the first bytes of the file to identify:
#   FFD8 → image/jpeg
#   8950 → image/png
#   4749 → image/gif
#   5249 → image/webp
# Returns "application/octet-stream" for unknown formats.
fn RustCsgUtilsImageDetectImageMimeType(bytes: str): str =
    if bytes.len < 2:
        return "application/octet-stream"

    let b0: int32 = Int32(bytes[0])
    let b1: int32 = Int32(bytes[1])

    # JPEG: 0xFF 0xD8
    if b0 == 0xFF && b1 == 0xD8:
        return "image/jpeg"

    # PNG: 0x89 0x50
    if b0 == 0x89 && b1 == 0x50:
        return "image/png"

    # GIF: 0x47 0x49
    if b0 == 0x47 && b1 == 0x49:
        return "image/gif"

    # WEBP: 0x52 0x49 (RIFF container)
    if b0 == 0x52 && b1 == 0x49:
        return "image/webp"

    return "application/octet-stream"

# ── getImageDimensions ─────────────────────────────────────────────────────
# Format width and height as "WxH" dimension string.
# Returns empty string if either dimension is negative.
fn RustCsgUtilsImageGetImageDimensions(width: int32, height: int32): str =
    if width < 0 || height < 0:
        return ""
    return strutil.Join([strings.IntToStr(width), "x", strings.IntToStr(height)], "")

# ── imageValidateUrl ───────────────────────────────────────────────────────
# Check if a URL points to an image by examining its file extension.
# Extracts the extension after the last dot in the URL path (ignoring query
# and fragment), and checks against known image extensions.
# Known image extensions: jpg, jpeg, png, gif, webp, bmp, svg, ico, tiff, tif
# Returns true if the URL has a recognised image extension, false otherwise.
fn RustCsgUtilsImageValidateUrl(url: str): bool =
    if url.len == 0:
        return false

    # Find the last dot
    var lastDot: int32 = -1
    var i: int32 = 0
    while i < url.len:
        if url[i] == '.':
            lastDot = i
        i = i + 1

    if lastDot < 0:
        return false

    # Extract extension from after last dot to end, or up to '?' or '#'
    var extStart: int32 = lastDot + 1
    var extEnd: int32 = url.len
    var j: int32 = extStart
    while j < url.len:
        if url[j] == '?' || url[j] == '#':
            extEnd = j
            break
        j = j + 1

    if extStart >= extEnd:
        return false

    let ext: str = strings.SliceBytes(url, extStart, extEnd - extStart)

    # Compare against known image extensions (lowercase)
    # Manual ascii lowercase (strutil.ToLowerAscii is not available)
    var lowerAlpha: str = "abcdefghijklmnopqrstuvwxyz"
    var lowerExt: str = ""
    var k: int32 = 0
    while k < ext.len:
        if ext[k] >= 'a' && ext[k] <= 'z':
            lowerExt = strutil.Join([lowerExt, strings.SliceBytes(ext, k, 1)], "")
        elif ext[k] >= 'A' && ext[k] <= 'Z':
            let idx = Int32(ext[k]) - 65
            lowerExt = strutil.Join([lowerExt, strings.SliceBytes(lowerAlpha, idx, 1)], "")
        else:
            lowerExt = strutil.Join([lowerExt, strings.SliceBytes(ext, k, 1)], "")
        k = k + 1
    if lowerExt == "jpg": return true
    if lowerExt == "jpeg": return true
    if lowerExt == "png": return true
    if lowerExt == "gif": return true
    if lowerExt == "webp": return true
    if lowerExt == "bmp": return true
    if lowerExt == "svg": return true
    if lowerExt == "ico": return true
    if lowerExt == "tiff": return true
    if lowerExt == "tif": return true
    return false
