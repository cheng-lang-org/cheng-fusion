# state: SQLite-backed rollout metadata database constants
# Ported from codex-rs/state — database filenames, env vars, and metric constants.

import std/strings
import cheng/codex/protocol/wire

const
    RustCsgStateSqliteHomeEnv: str = "CODEX_SQLITE_HOME"
    RustCsgStateLogsDbFilename: str = "logs_2.sqlite"
    RustCsgStateStateDbFilename: str = "state_5.sqlite"
    RustCsgStateDbErrorMetric: str = "codex.db.error"
    RustCsgStateDbMetricBackfill: str = "codex.db.backfill"
    RustCsgStateDbMetricBackfillDurationMs: str = "codex.db.backfill.duration_ms"
    RustCsgStateDbInitMetric: str = "codex.sqlite.init.count"
    RustCsgStateDbInitDurationMetric: str = "codex.sqlite.init.duration_ms"
    RustCsgStateDbFallbackMetric: str = "codex.sqlite.fallback.count"

fn RustCsgStateSqliteHomeEnvName(): str =
    return RustCsgStateSqliteHomeEnv

fn RustCsgStateStateDbFileName(): str =
    return RustCsgStateStateDbFilename

fn RustCsgStateLogsDbFileName(): str =
    return RustCsgStateLogsDbFilename

fn RustCsgStateDbPath(homeDir: str): str =
    if homeDir == "":
        return ""
    return wire.RustCsgCat(homeDir, wire.RustCsgCat("/", RustCsgStateStateDbFilename))

fn RustCsgStateMigrateSchema(oldVersion: int32, newVersion: int32): str =
    if oldVersion >= newVersion:
        return "[]"
    var result: str = "["
    var v: int32 = oldVersion
    var needComma: bool = false
    while v < newVersion:
        if needComma:
            result = wire.RustCsgCat(result, ",")
        result = wire.RustCsgCat(result, "{\"from\":")
        result = wire.RustCsgCat(result, strings.Int64ToStr(int64(v)))
        result = wire.RustCsgCat(result, ",\"to\":")
        result = wire.RustCsgCat(result, strings.Int64ToStr(int64(v + 1)))
        result = wire.RustCsgCat(result, "}")
        needComma = true
        v = v + 1
    result = wire.RustCsgCat(result, "]")
    return result

fn RustCsgStateValidateIntegrity(db: str): str =
    if db == "":
        return "empty database path"
    if db.len < 7:
        return "path too short for .sqlite extension"
    let extStart: int32 = db.len - 7
    if !(db[extStart] == '.' &&
          db[extStart + 1] == 's' &&
          db[extStart + 2] == 'q' &&
          db[extStart + 3] == 'l' &&
          db[extStart + 4] == 'i' &&
          db[extStart + 5] == 't' &&
          db[extStart + 6] == 'e'):
        return "invalid database extension (expected .sqlite)"
    return ""
