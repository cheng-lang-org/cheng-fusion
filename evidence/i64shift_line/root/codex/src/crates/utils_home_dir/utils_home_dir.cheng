import cheng/codex/config/home

fn RustCsgUtilsHomeDirFindCodexHomeFromEnv(codexHomeEnv: str, outPath: var str, outError: var str) =
    let homeEnv = home.RustCsgGetEnv("HOME")
    home.RustCsgFindCodexHomeFromEnvValueInto(codexHomeEnv, homeEnv, outPath, outError)

fn RustCsgUtilsHomeDirFindCodexHome(outPath: var str, outError: var str) =
    let codexHomeEnv = home.RustCsgGetEnv("CODEX_HOME")
    RustCsgUtilsHomeDirFindCodexHomeFromEnv(codexHomeEnv, outPath, outError)
