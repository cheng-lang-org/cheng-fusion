# ── parseDebugCommand: parses ":new/:resume/:use/:quit/:help" commands ────
# Returns UserCommand variant (int32) matching the UserCommand enum:
#   0: Help, 1: Quit, 2: NewThread, 3: Resume, 4: Use, 5: RefreshThread
# outArg receives the command argument (thread ID for :resume/:use).
# Returns -1 and empty outArg on parse error.

fn parseDebugCommand(input: str, outArg: var str): int32 =
    outArg = ""
    if input.len == 0:
        return -1
    if input[0] != ':':
        return -1

    # Extract command name (from after ':' to first space or end)
    var cmdStart: int32 = 1
    var cmdEnd: int32 = cmdStart
    while cmdEnd < input.len && input[cmdEnd] != ' ':
        cmdEnd = cmdEnd + 1

    # Extract argument (after the space, if any)
    var argStart: int32 = cmdEnd
    while argStart < input.len && input[argStart] == ' ':
        argStart = argStart + 1

    # Compare command by length and content
    var cmdLen: int32 = cmdEnd - cmdStart

    # :new — exact match
    if cmdLen == 3:
        if input[cmdStart] == 'n' && input[cmdStart+1] == 'e' && input[cmdStart+2] == 'w':
            return 2  # NewThread

    # :use — exact match
    if cmdLen == 3:
        if input[cmdStart] == 'u' && input[cmdStart+1] == 's' && input[cmdStart+2] == 'e':
            # Extract the thread ID argument
            if argStart < input.len:
                outArg = wire.RustCsgSliceBytes(input, argStart, input.len - argStart)
            return 4  # Use

    # :quit — exact match
    if cmdLen == 4:
        if input[cmdStart] == 'q' && input[cmdStart+1] == 'u' && input[cmdStart+2] == 'i' && input[cmdStart+3] == 't':
            return 1  # Quit

    # :help — exact match
    if cmdLen == 4:
        if input[cmdStart] == 'h' && input[cmdStart+1] == 'e' && input[cmdStart+2] == 'l' && input[cmdStart+3] == 'p':
            return 0  # Help

    # :resume — exact match
    if cmdLen == 6:
        if input[cmdStart] == 'r' && input[cmdStart+1] == 'e' && input[cmdStart+2] == 's' &&
           input[cmdStart+3] == 'u' && input[cmdStart+4] == 'm' && input[cmdStart+5] == 'e':
            if argStart < input.len:
                outArg = wire.RustCsgSliceBytes(input, argStart, input.len - argStart)
            return 3  # Resume

    return -1  # Unknown command

