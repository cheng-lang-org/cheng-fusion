# ── Compaction type enums ────────────────────────────────────────────────────

const RustCsgAnalyticsCompactionTriggerVariantCount: int32 = 7
fn RustCsgAnalyticsCompactionTriggerVariants(): str =
    return "TokenBudget,MessageCount,Manual,SessionStart,UserPrompt,PostToolUse,SubAgent"

const RustCsgAnalyticsCompactionReasonVariantCount: int32 = 6
fn RustCsgAnalyticsCompactionReasonVariants(): str =
    return "TokenBudgetReached,MessageCountReached,MemoryConsolidation,SubAgentThreadResolved,SubAgentThreadSpawn,Experimental"

const RustCsgAnalyticsCompactionImplementationVariantCount: int32 = 3
fn RustCsgAnalyticsCompactionImplementationVariants(): str =
    return "Summary,Truncation,Hybrid"

const RustCsgAnalyticsCompactionPhaseVariantCount: int32 = 4
fn RustCsgAnalyticsCompactionPhaseVariants(): str =
    return "Prepare,Capture,Consolidate,Wait"

const RustCsgAnalyticsCompactionStrategyVariantCount: int32 = 6
fn RustCsgAnalyticsCompactionStrategyVariants(): str =
    return "Full,ActiveOnly,Selective,Progressive,Agentic,SubAgentSeparate"

const RustCsgAnalyticsCompactionStatusVariantCount: int32 = 4
fn RustCsgAnalyticsCompactionStatusVariants(): str =
    return "Success,Failure,Skipped,Aborted"

