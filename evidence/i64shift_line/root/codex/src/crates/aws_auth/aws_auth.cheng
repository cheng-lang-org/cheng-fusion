import std/strings as strings
import std/rawbytes
import std/strutils as strutil
import std/rawmem_support

# ── AWS Signature V4 implementation (ported from codex-rs aws-auth) ──

# Helper: XOR two byte values (int32) using int64 arithmetic
fn xorByte(a: int32, b: int32): int32 =
    let a64: int64 = Int64(a)
    let b64: int64 = Int64(b)
    let xored: int64 = a64 ^ b64
    return Int32(xored & Int64(0xFF))

fn hmacSha256Hex(key: str, data: str): str =
    const blockSize: int32 = 64
    var k: str = key
    if k.len > blockSize:
        k = strings.Sha256(k)
    var innerRaw: rawbytes.Bytes = rawbytes.BytesAlloc(blockSize)
    var outerRaw: rawbytes.Bytes = rawbytes.BytesAlloc(blockSize)
    for i in 0..<blockSize:
        var b: int32
        if i < k.len:
            b = Int32(k[i])
        else:
            b = 0
        rawbytes.BytesSet(innerRaw, i, xorByte(b, Int32(0x36)))
        rawbytes.BytesSet(outerRaw, i, xorByte(b, Int32(0x5C)))
    let dataBytes = rawbytes.BytesFromString(data)
    let innerInput = rawbytes.BytesConcat(innerRaw, dataBytes)
    let innerInputStr = rawbytes.BytesToString(innerInput)
    let innerHash: str = strings.Sha256(innerInputStr)
    let ihBytes = rawbytes.BytesFromString(innerHash)
    let outerInput = rawbytes.BytesConcat(outerRaw, ihBytes)
    let outerInputStr = rawbytes.BytesToString(outerInput)
    let result: str = strings.Sha256(outerInputStr)
    rawbytes.BytesFree(innerRaw)
    rawbytes.BytesFree(outerRaw)
    rawbytes.BytesFree(innerInput)
    rawbytes.BytesFree(outerInput)
    return result

fn sha256Hex(text: str): str =
    return strings.Sha256(text)

fn buildCanonicalRequest(method: str, canonicalUri: str, canonicalQuery: str, canonicalHeaders: str, signedHeaders: str, payloadHash: str): str =
    return strutil.Join([method, "\n", canonicalUri, "\n", canonicalQuery, "\n", canonicalHeaders, "\n", signedHeaders, "\n", payloadHash], "")

fn buildCredentialScope(dateStr: str, region: str, service: str): str =
    return strutil.Join([dateStr, "/", region, "/", service, "/aws4_request"], "")

fn buildStringToSign(algorithm: str, amzDate: str, credentialScope: str, hashedCanonicalRequest: str): str =
    return strutil.Join([algorithm, "\n", amzDate, "\n", credentialScope, "\n", hashedCanonicalRequest], "")

fn deriveSigningKeyHex(secretKey: str, dateStr: str, region: str, service: str): str =
    let kSecret = strutil.Join(["AWS4", secretKey], "")
    let kDate = hmacSha256Hex(kSecret, dateStr)
    let kRegion = hmacSha256Hex(kDate, region)
    let kService = hmacSha256Hex(kRegion, service)
    return hmacSha256Hex(kService, "aws4_request")

fn buildAwsAuthHeaders(
    accessKey: str, secretKey: str,
    region: str, service: str,
    method: str, canonicalUri: str,
    canonicalQuery: str, body: str,
    amzDate: str
): str =
    let payloadHash = sha256Hex(body)
    let signedHeaders = "host;x-amz-content-sha256;x-amz-date"
    var canonicalHeaders: str = ""
    canonicalHeaders = strutil.Join([canonicalHeaders, "host:", canonicalUri, "\n"], "")
    canonicalHeaders = strutil.Join([canonicalHeaders, "x-amz-content-sha256:", payloadHash, "\n"], "")
    canonicalHeaders = strutil.Join([canonicalHeaders, "x-amz-date:", amzDate, "\n"], "")
    let canonicalRequest = buildCanonicalRequest(method, canonicalUri, canonicalQuery, canonicalHeaders, signedHeaders, payloadHash)
    let hashedCanonicalRequest = sha256Hex(canonicalRequest)
    let dateStr = strings.SliceBytes(amzDate, 0, 8)
    let credentialScope = buildCredentialScope(dateStr, region, service)
    let signingKey = deriveSigningKeyHex(secretKey, dateStr, region, service)
    let algorithm: str = "AWS4-HMAC-SHA256"
    let stringToSign = buildStringToSign(algorithm, amzDate, credentialScope, hashedCanonicalRequest)
    let signature = hmacSha256Hex(signingKey, stringToSign)
    let credential = strutil.Join([accessKey, "/", credentialScope], "")
    let authorizationHeader = strutil.Join([algorithm, " Credential=", credential, ", SignedHeaders=", signedHeaders, ", Signature=", signature], "")
    return strutil.Join([
        "{",
        "\"Authorization\":\"", authorizationHeader, "\",",
        "\"X-Amz-Date\":\"", amzDate, "\",",
        "\"X-Amz-Content-Sha256\":\"", payloadHash, "\"",
        "}"
    ], "")
