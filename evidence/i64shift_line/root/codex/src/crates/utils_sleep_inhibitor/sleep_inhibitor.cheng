# sleep-inhibitor: Cross-platform sleep prevention while a turn is running
# Ported from codex-rs/utils/sleep-inhibitor
#
# Pure Cheng state machine logic: tracks whether sleep inhibition should be
# active based on turn-running state and enabled flag. Platform-specific
# inhibition (IOKit on macOS, systemd-inhibit on Linux, PowerRequest on
# Windows) is not ported to Cheng.

const
    RustCsgSleepInhibitorStatusInactive: int32 = 0
    RustCsgSleepInhibitorStatusActive: int32 = 1

# Use separate fields rather than struct to avoid cold compiler issues with
# struct field access across function boundaries.
# enabled: 1 = enabled, 0 = disabled
# turnRunning: 1 = running, 0 = stopped

fn RustCsgSleepInhibitorShouldInhibit(enabled: int32, turnRunning: int32): int32 =
    if enabled != 0 && turnRunning != 0:
        return 1
    return 0

fn RustCsgSleepInhibitorStatus(enabled: int32, turnRunning: int32): int32 =
    if enabled != 0 && turnRunning != 0:
        return RustCsgSleepInhibitorStatusActive
    return RustCsgSleepInhibitorStatusInactive
