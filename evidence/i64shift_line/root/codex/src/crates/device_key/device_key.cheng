fn RustCsgDeviceKeyIsAsciiAlphaNum(ch: char): bool =
    if ch >= 'a' && ch <= 'z':
        return true
    if ch >= 'A' && ch <= 'Z':
        return true
    if ch >= '0' && ch <= '9':
        return true
    return false

fn RustCsgValidateDeviceKey(key: str): bool =
    if key.len < 10 || key.len > 128:
        return false
    for i in 0..<key.len:
        let ch = key[i]
        if RustCsgDeviceKeyIsAsciiAlphaNum(ch):
            continue
        if ch == '-' || ch == '_':
            continue
        return false
    return true
