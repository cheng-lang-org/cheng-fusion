// Install context detection — ported from codex-rs install-context
// Detects whether Codex is running as standalone, npm, bun, brew, or other.
//
// Dependencies: utils/home-dir (already ported), utils/path-utils (already ported)
//
// Simplified: hardcoded for Unix/macOS (no Windows standalone detection).
// OnceLock singleton skipped; caller manages caching.

import std/os
import std/strings
import std/strutils as strutil
import cheng/codex/crates/utils_home_dir/utils_home_dir as homedir

const
    RustCsgInstallContextStandalone: int32 = 1
    RustCsgInstallContextNpm: int32 = 2
    RustCsgInstallContextBun: int32 = 3
    RustCsgInstallContextBrew: int32 = 4
    RustCsgInstallContextOther: int32 = 5

    RustCsgReleasesDirname: str = "releases"
    RustCsgResourcesDirname: str = "codex-resources"
    RustCsgStandalonePackagesDirname: str = "standalone"

// Determine install context from the current executable path.
// Returns the context kind (one of the constants above).
fn RustCsgInstallContextDetect(currentExe: str, managedByNpm: bool, managedByBun: bool): int32 =
    if managedByNpm:
        return RustCsgInstallContextNpm
    if managedByBun:
        return RustCsgInstallContextBun

    var codexHome: str
    var homeError: str
    homedir.RustCsgUtilsHomeDirFindCodexHome(codexHome, homeError)
    if codexHome != "" && currentExe != "":
        let standaloneResult = RustCsgInstallContextTryStandalone(currentExe, codexHome)
        if standaloneResult != RustCsgInstallContextOther:
            return standaloneResult

    // macOS brew detection
    if currentExe != "":
        if strutil.StartsWith(currentExe, "/opt/homebrew") || strutil.StartsWith(currentExe, "/usr/local"):
            return RustCsgInstallContextBrew

    return RustCsgInstallContextOther

// Check if the current exe is inside a standalone release directory.
fn RustCsgInstallContextTryStandalone(exePath: str, codexHome: str): int32 =
    let releasesRoot = os.JoinPath(
        os.JoinPath(
            os.JoinPath(codexHome, "packages"),
            RustCsgStandalonePackagesDirname
        ),
        RustCsgReleasesDirname
    )
    // Check if exePath starts with releasesRoot
    if strutil.StartsWith(exePath, releasesRoot):
        return RustCsgInstallContextStandalone
    return RustCsgInstallContextOther

// Get the default rg (ripgrep) command name.
fn RustCsgInstallContextDefaultRgCommand(): str =
    return "rg"
