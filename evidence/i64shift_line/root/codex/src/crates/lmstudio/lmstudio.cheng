import std/strings
import std/strutils as strutil

# LM Studio provider config (ported from codex-rs lmstudio crate).
# Provider constants, URL helpers, and request builders.

# Build the standard GET /v1/models request path for LM Studio.
# Returns the OpenAI-compatible models endpoint path.
fn RustCsgBuildLmstudioModelsRequest(): str =
    return "/v1/models"

fn RustCsgLmStudioDefaultOssModel(): str = "openai/gpt-oss-20b"
fn RustCsgLmStudioDefaultBaseUrl(): str = "http://localhost:1234"
fn RustCsgLmStudioProviderId(): str = "lm-studio"
fn RustCsgLmStudioEndpointModels(): str = "/models"
fn RustCsgLmStudioEndpointResponses(): str = "/responses"
fn RustCsgLmStudioResponseDataKey(): str = "data"
fn RustCsgLmStudioResponseModelIdKey(): str = "id"

fn RustCsgLmStudioStripTrailingSlash(s: str): str =
    if s.len > 0 && s[s.len - 1] == '/':
        return strings.SliceBytes(s, 0, s.len - 1)
    return s

fn RustCsgLmStudioModelsUrl(baseUrl: str): str =
    let trimmed = RustCsgLmStudioStripTrailingSlash(baseUrl)
    return strutil.Join([trimmed, RustCsgLmStudioEndpointModels()], "")

fn RustCsgLmStudioResponsesUrl(baseUrl: str): str =
    let trimmed = RustCsgLmStudioStripTrailingSlash(baseUrl)
    return strutil.Join([trimmed, RustCsgLmStudioEndpointResponses()], "")
