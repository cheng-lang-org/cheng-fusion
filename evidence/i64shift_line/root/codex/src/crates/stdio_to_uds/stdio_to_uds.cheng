# stdio-to-uds: relays data between stdio and a Unix domain socket.
# Ported from codex-rs/stdio-to-uds
#
# Production functions:
#   buildSocketPath(codexHome) — construct a UDS socket path from codexHome

import std/strutils as strutil
import std/strings

const StdioToUdsCrate: str = "codex-stdio-to-uds"

# Rust signature:
#   pub async fn run(socket_path: &Path) -> anyhow::Result<()>
# Connects to a Unix domain socket and relays stdin/stdout bidirectionally.
const StdioToUdsRunFn: str = "run"

fn StdioToUdsBuildSocketPath(codexHome: str): str =
    if codexHome == "":
        return "cheng.sock"
    if codexHome[codexHome.len - 1] == '/':
        return strings.ConcatStr(codexHome, "cheng.sock")
    return strings.ConcatStr(codexHome, "/cheng.sock")

# ── stdioToUdsReadFrame ────────────────────────────────────────────────────
# Parse a UDS frame from raw byte data. UDS length-prefixed framing uses a
# 4-byte big-endian unsigned integer for the payload length, followed by the
# payload bytes.
# Returns a tuple-like report string: "ok:<payload>" on success,
# "err:<reason>" on failure (e.g. data too short for frame header).
# The payload string is the raw bytes after the 4-byte length prefix.
fn StdioToUdsReadFrame(data: str): str =
    # Need at least 4 bytes for the length header
    if data.len < 4:
        return strings.ConcatStr("err:data too short, need at least 4 bytes for frame header, got ", strings.IntToStr(data.len))

    # Parse 4-byte big-endian length
    let b0: int32 = Int32(data[0])
    let b1: int32 = Int32(data[1])
    let b2: int32 = Int32(data[2])
    let b3: int32 = Int32(data[3])
    let payloadLen: int32 = (b0 << 24) | (b1 << 16) | (b2 << 8) | b3

    # Check that data contains the full frame
    let frameLen: int32 = 4 + payloadLen
    if data.len < frameLen:
        return strings.ConcatStr(strings.ConcatStr(strings.ConcatStr("err:incomplete frame, expected ", strings.IntToStr(frameLen)), " bytes, got "), strings.IntToStr(data.len))

    # Extract payload
    let payload: str = strings.SliceBytes(data, 4, payloadLen)
    return strings.ConcatStr("ok:", payload)
