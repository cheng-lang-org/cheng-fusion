# Secrets provider (ported from codex-rs secrets crate)
# XOR-encrypted file-based secret store. Core type definitions
# for the secret set/get/delete/rotate/list contract.

type
    RustCsgSecretStatus =
        ok: bool
        error: str

# ── Core operations (C provider) ─────────────────────────────────────────

@abi_internal
@importc("RustCsgSecretSet")
fn RustCsgSecretSet(name: str, value: str): int32

@abi_internal
@importc("RustCsgSecretGet")
fn RustCsgSecretGet(name: str, outValue: var str, outOk: var int32)

@abi_internal
@importc("RustCsgSecretDelete")
fn RustCsgSecretDelete(name: str): int32

@abi_internal
@importc("RustCsgSecretRotate")
fn RustCsgSecretRotate(name: str, newValue: str): int32

@abi_internal
@importc("RustCsgSecretList")
fn RustCsgSecretList(): str

# ── Public API ───────────────────────────────────────────────────────────

fn secretSet(name: str, value: str): bool =
    return RustCsgSecretSet(name, value) != 0

fn secretGet(name: str, outValue: var str): bool =
    var outOk: int32
    RustCsgSecretGet(name, outValue, outOk)
    return outOk != 0

fn secretDelete(name: str): bool =
    return RustCsgSecretDelete(name) != 0

# Atomic rotate: saves current value as <name>.previous, then sets new value.
# Returns true on success. Old value remains accessible via
# secretGet(name) for the new value and secretGet(name + ".previous")
# for rollback.
fn secretRotate(name: str, newValue: str): bool =
    return RustCsgSecretRotate(name, newValue) != 0

fn secretList(): str =
    return RustCsgSecretList()
