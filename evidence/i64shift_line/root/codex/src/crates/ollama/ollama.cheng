import std/strings
import std/strutils as strutil

# Ollama provider config (ported from codex-rs ollama crate).
# Provider constants, URL helpers, and request builders.

# Build the JSON body for an Ollama model pull request.
# Model names contain only alphanumeric, colon, dot, dash, underscore chars
# so no JSON escaping is needed.
# Returns: {"model":"<modelName>","stream":true}
fn RustCsgBuildOllamaPullRequest(modelName: str): str =
    return strutil.Join(["{\"model\":\"", modelName, "\",\"stream\":true}"], "")

fn RustCsgOllamaDefaultOssModel(): str = "gpt-oss:20b"
fn RustCsgOllamaDefaultBaseUrl(): str = "http://localhost:11434"
fn RustCsgOllamaProviderId(): str = "ollama"
fn RustCsgOllamaEndpointTags(): str = "/api/tags"
fn RustCsgOllamaEndpointPull(): str = "/api/pull"
fn RustCsgOllamaEndpointVersion(): str = "/api/version"
fn RustCsgOllamaResponseModelsKey(): str = "models"
fn RustCsgOllamaResponseModelNameKey(): str = "name"
fn RustCsgOllamaResponseVersionKey(): str = "version"

fn RustCsgOllamaStripTrailingSlash(s: str): str =
    if s.len > 0 && s[s.len - 1] == '/':
        return strings.SliceBytes(s, 0, s.len - 1)
    return s

fn RustCsgOllamaTagsUrl(baseUrl: str): str =
    let trimmed = RustCsgOllamaStripTrailingSlash(baseUrl)
    return strutil.Join([trimmed, RustCsgOllamaEndpointTags()], "")

fn RustCsgOllamaPullUrl(baseUrl: str): str =
    let trimmed = RustCsgOllamaStripTrailingSlash(baseUrl)
    return strutil.Join([trimmed, RustCsgOllamaEndpointPull()], "")

fn RustCsgOllamaVersionUrl(baseUrl: str): str =
    let trimmed = RustCsgOllamaStripTrailingSlash(baseUrl)
    return strutil.Join([trimmed, RustCsgOllamaEndpointVersion()], "")
