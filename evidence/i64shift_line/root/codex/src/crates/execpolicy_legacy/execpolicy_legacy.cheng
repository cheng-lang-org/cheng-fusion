# execpolicy-legacy: Legacy exec policy engine for validating proposed exec calls
# Ported from codex-rs/execpolicy-legacy
#
# Pure Cheng logic: check_command flow with Output variants and error codes.
# The actual Starlark policy parsing lives in Rust via the starlark crate;
# this Cheng side exposes the check-result contract and error code constants.

const
    RustCsgExecpolicyMatchedButWritesFilesExitCode: int32 = 12
    RustCsgExecpolicyMightBeSafeExitCode: int32 = 13
    RustCsgExecpolicyForbiddenExitCode: int32 = 14

# Output result types
const
    RustCsgExecpolicyResultSafe: int32 = 0
    RustCsgExecpolicyResultMatch: int32 = 1
    RustCsgExecpolicyResultForbidden: int32 = 2
    RustCsgExecpolicyResultUnverified: int32 = 3

struct RustCsgExecpolicyExecArg:
    program: str
    args: str[]

struct RustCsgExecpolicyOutput:
    result: int32
    # For Safe/Match: the match description
    matchDescription: str
    # For Forbidden: reason and cause
    forbiddenReason: str
    forbiddenCause: str
    # For Unverified: the error
    unverifiedError: str

fn RustCsgExecpolicyCheckCommand(
    exec: var RustCsgExecpolicyExecArg,
    requireSafe: bool,
    outOutput: var RustCsgExecpolicyOutput,
    outExitCode: var int32
) =
    # Pure Cheng side: we model the check_command contract.
    # The actual policy evaluation requires the Rust starlark engine.
    # For the Cheng port, we expose the shape and exit-code constants.
    #
    # When the real policy checker is unavailable, the result is "unverified"
    # and the exit code depends on requireSafe.
    outOutput.result = RustCsgExecpolicyResultUnverified
    outOutput.unverifiedError = "Starlark policy engine not ported to Cheng"
    if requireSafe:
        outExitCode = RustCsgExecpolicyMightBeSafeExitCode
    else:
        outExitCode = 0

fn RustCsgExecpolicyExitCodeForResult(result: int32, requireSafe: bool): int32 =
    if result == RustCsgExecpolicyResultSafe:
        return 0
    if result == RustCsgExecpolicyResultMatch:
        if requireSafe:
            return RustCsgExecpolicyMatchedButWritesFilesExitCode
        return 0
    if result == RustCsgExecpolicyResultForbidden:
        if requireSafe:
            return RustCsgExecpolicyForbiddenExitCode
        return 0
    # Unverified
    if requireSafe:
        return RustCsgExecpolicyMightBeSafeExitCode
    return 0
