# Guardian Extension — type definition constants
#
# Ported from codex-rs/ext/guardian
# Covers: GuardianExtension, GuardianThreadContext

# ── GuardianExtension struct fields ─────────────────────────────────────

const RustCsgGuardianExtensionFieldCount: int32 = 1
const RustCsgGuardianExtensionField1: str = "agent_spawner"
fn GuardianExtensionFields(): str = return "agent_spawner|S"

# ── GuardianThreadContext struct fields ─────────────────────────────────

const RustCsgGuardianThreadContextFieldCount: int32 = 1
const RustCsgGuardianThreadContextField1: str = "forked_from_thread_id"
fn GuardianThreadContextFields(): str = return "forked_from_thread_id|ThreadId"

# ── Install function name ───────────────────────────────────────────────

const RustCsgGuardianInstallFnName: str = "install"

# ═══════════════════════════════════════════════════════════════════════════
# Production Functions
# ═══════════════════════════════════════════════════════════════════════════

const
    GuardianActionAllow: int32 = 0
    GuardianActionDeny: int32 = 1
    GuardianActionReview: int32 = 2
    GuardianActionUnknown: int32 = -1

# Classify a guardian action string to a numeric code.
# Maps "allow" -> Allow, "deny" -> Deny, "review" -> Review, others -> Unknown.
fn classifyGuardianAction(action: str): int32 =
    if action == "allow":
        return GuardianActionAllow
    if action == "deny":
        return GuardianActionDeny
    if action == "review":
        return GuardianActionReview
    return GuardianActionUnknown

# Evaluate a guardian policy for a given action.
# Policy strings: "allow_all" -> always Allow, "deny_all" -> always Deny,
# "review_all" -> always Review. Otherwise delegates to classifyGuardianAction.
fn evaluateGuardianPolicy(action: str, policy: str): int32 =
    if policy == "allow_all":
        return GuardianActionAllow
    if policy == "deny_all":
        return GuardianActionDeny
    if policy == "review_all":
        return GuardianActionReview
    return classifyGuardianAction(action)
