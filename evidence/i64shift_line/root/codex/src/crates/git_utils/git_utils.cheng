# git-utils — real git file parsing via .git/HEAD inspection
# Ported from codex-rs/git-utils/src/info.rs
#
# Provides low-level git info without spawning the git binary.
# Parses .git/HEAD to extract branch name and commit hash.

import std/os
import std/strings
import std/strutils as strutil
import cheng/codex/config/home

# ref prefix constant for git symbolic refs
const RustCsgGitUtilsRefPrefix: str = "ref: refs/heads/"

# ── Current branch name ─────────────────────────────────────────────────
#
# Reads <cwd>/.git/HEAD and parses the symbolic ref "ref: refs/heads/<name>"
# to extract the branch name. Returns empty string on any error (not a git
# repo, detached HEAD, missing or empty HEAD file).

fn RustCsgGitUtilsCurrentBranchName(cwd: str): str =
    if cwd == "":
        return ""
    let headPath = os.JoinPath(os.JoinPath(cwd, ".git"), "HEAD")
    let headContent = home.RustCsgReadFile(headPath)
    if headContent == "":
        return ""
    if strutil.StartsWith(headContent, RustCsgGitUtilsRefPrefix):
        let branchStart: int32 = RustCsgGitUtilsRefPrefix.len
        var branchEnd: int32 = branchStart
        while branchEnd < headContent.len:
            let ch = headContent[branchEnd]
            if ch == '\n' || ch == '\r':
                break
            branchEnd = branchEnd + 1
        if branchEnd > branchStart:
            return strutil.SliceStr(headContent, branchStart, branchEnd)
    return ""

# ── HEAD commit hash ─────────────────────────────────────────────────────
#
# Returns the full SHA-1 commit hash that HEAD points to. Works for both
# symbolic refs (e.g. "ref: refs/heads/main") by following the ref file,
# and detached HEAD (direct SHA in .git/HEAD). Returns empty string on
# any error.

fn RustCsgGitUtilsGetHeadCommitHash(cwd: str): str =
    if cwd == "":
        return ""
    let gitDir = os.JoinPath(cwd, ".git")
    let headPath = os.JoinPath(gitDir, "HEAD")
    let headContent = home.RustCsgReadFile(headPath)
    if headContent == "":
        return ""
    if strutil.StartsWith(headContent, RustCsgGitUtilsRefPrefix):
        let branchStart: int32 = RustCsgGitUtilsRefPrefix.len
        var branchEnd: int32 = branchStart
        while branchEnd < headContent.len:
            let ch = headContent[branchEnd]
            if ch == '\n' || ch == '\r':
                break
            branchEnd = branchEnd + 1
        if branchEnd <= branchStart:
            return ""
        let branchName = strutil.SliceStr(headContent, branchStart, branchEnd)
        let refPath = os.JoinPath(os.JoinPath(gitDir, "refs/heads"), branchName)
        return RustCsgGitUtilsTrimHash(home.RustCsgReadFile(refPath))
    return RustCsgGitUtilsTrimHash(headContent)

# Internal: strip trailing whitespace/newline from a hash string
fn RustCsgGitUtilsTrimHash(raw: str): str =
    if raw == "":
        return ""
    var end: int32 = raw.len
    while end > 0:
        let ch = raw[end - 1]
        if ch == '\n' || ch == '\r' || ch == ' ' || ch == '\t':
            end = end - 1
        else:
            break
    if end <= 0:
        return ""
    return strutil.SliceStr(raw, 0, end)
