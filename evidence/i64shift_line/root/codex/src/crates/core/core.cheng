# Core — turn context builder.
# Ported from codex-rs/core/src/lib.rs and codex-rs/core/src/session/turn_context.rs
# Covers: buildTurnContext

import cheng/codex/protocol/types

const RustCsgCoreFunctionCount: int32 = 1
fn RustCsgCoreFunctionNames(): str =
    return "buildTurnContext"

# Build a RustCsgTurnContext struct from session ID, thread ID, and model name.
# Returns the struct with given fields populated and all other fields set to
# default/empty values.
fn RustCsgBuildTurnContext(sessionId: str, threadId: str, modelName: str): types.RustCsgTurnContext =
    var ctx: types.RustCsgTurnContext
    ctx.turnId = threadId
    ctx.traceId = sessionId
    ctx.model = modelName
    ctx.cwd = ""
    ctx.currentDate = ""
    ctx.timezone = ""
    ctx.approvalPolicy = ""
    ctx.sandboxType = ""
    ctx.sandboxNetworkAccess = false
    ctx.personality = ""
    ctx.collaborationMode = ""
    ctx.realtimeActive = false
    ctx.effort = ""
    ctx.summary = ""
    ctx.userInstructions = ""
    ctx.developerInstructions = ""
    return ctx
