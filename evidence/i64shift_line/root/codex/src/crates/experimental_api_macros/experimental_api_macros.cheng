# ═══════════════════════════════════════════════════════════════════════════════
# Library: codex-experimental-api-macros — check if a feature name is experimental
# ═══════════════════════════════════════════════════════════════════════════════
#
import std/strings
import std/strutils as strutil

# NOTE: let str = "..." inside function bodies may crash at runtime (const str
# bug affects runtime string literal binding). Use inline char checks instead.

fn RustCsgCodexExperimentalApiMacrosIsExperimentalApi(featureName: str): bool =
    if featureName.len == 0:
        return false
    # Check if starts with "experimental_" (13 chars)
    if featureName.len >= 13:
        var matchExp: bool = true
        if featureName[0] != 'e': matchExp = false
        if featureName[1] != 'x': matchExp = false
        if featureName[2] != 'p': matchExp = false
        if featureName[3] != 'e': matchExp = false
        if featureName[4] != 'r': matchExp = false
        if featureName[5] != 'i': matchExp = false
        if featureName[6] != 'm': matchExp = false
        if featureName[7] != 'e': matchExp = false
        if featureName[8] != 'n': matchExp = false
        if featureName[9] != 't': matchExp = false
        if featureName[10] != 'a': matchExp = false
        if featureName[11] != 'l': matchExp = false
        if featureName[12] != '_': matchExp = false
        if matchExp:
            return true
    # Check if starts with "unstable_" (9 chars)
    if featureName.len >= 9:
        var matchUnst: bool = true
        if featureName[0] != 'u': matchUnst = false
        if featureName[1] != 'n': matchUnst = false
        if featureName[2] != 's': matchUnst = false
        if featureName[3] != 't': matchUnst = false
        if featureName[4] != 'a': matchUnst = false
        if featureName[5] != 'b': matchUnst = false
        if featureName[6] != 'l': matchUnst = false
        if featureName[7] != 'e': matchUnst = false
        if featureName[8] != '_': matchUnst = false
        if matchUnst:
            return true
    return false

fn RustCsgCodexExperimentalApiMacrosIsStableApi(featureName: str): bool =
    if featureName.len == 0:
        return false
    if RustCsgCodexExperimentalApiMacrosIsExperimentalApi(featureName):
        return false
    return true

# Generate a feature manifest JSON string from a comma-separated list of feature names.
# Each feature is classified as experimental or stable.
# Returns JSON of the form: {"experimental":["feat1",...],"stable":["feat2",...]}
fn RustCsgCodexExperimentalApiMacrosGenerateManifest(features: str): str =
    if features.len == 0:
        return "{\"experimental\":[],\"stable\":[]}"
    var expList: str = ""
    var stbList: str = ""
    var firstExp: bool = true
    var firstStb: bool = true
    var start: int32 = 0
    var i: int32 = 0
    while i <= features.len:
        if i == features.len || features[i] == ',':
            if i > start:
                let feat: str = strings.SliceBytes(features, start, i - start)
                if RustCsgCodexExperimentalApiMacrosIsExperimentalApi(feat):
                    if firstExp:
                        expList = strutil.Join([expList, "\"", feat, "\""], "")
                        firstExp = false
                    else:
                        expList = strutil.Join([expList, ",\"", feat, "\""], "")
                else:
                    if firstStb:
                        stbList = strutil.Join([stbList, "\"", feat, "\""], "")
                        firstStb = false
                    else:
                        stbList = strutil.Join([stbList, ",\"", feat, "\""], "")
            start = i + 1
        i = i + 1
    return strutil.Join([
        "{\"experimental\":[",
        expList,
        "],\"stable\":[",
        stbList,
        "]}"
    ], "")
