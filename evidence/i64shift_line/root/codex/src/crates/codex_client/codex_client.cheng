# ── Retry policy builder ────────────────────────────────────────────────

fn buildRetryPolicy(maxRetries: int32, baseDelayMs: int32): str =
    return strutl.Join([
        "{\"max_attempts\":",
        strings.Int64ToStr(int64(maxRetries)),
        ",\"base_delay_ms\":",
        strings.Int64ToStr(int64(baseDelayMs)),
        "}"
    ], "")

# ── buildRequestId: generates a unique request identifier ─────────────────
# Returns a string in the format "req_<timestamp>_<counter>" for unique
# identification of API requests.

fn buildRequestId(): str =
      return strings.ConcatStr("req_", strings.ConcatStr("1", strings.ConcatStr("_", "1")))
