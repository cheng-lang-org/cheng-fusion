# SQLite Thread Store — in-memory abstraction for the ThreadStore API contract
# Demonstrates the insert/get/list/search/stats/backup contract
# that a real SQLite provider implements.
# Uses arrays for storage (production code would use SQLite via std/sqlite).

import cheng/codex/protocol/wire

# ── Thread store record type ─────────────────────────────────────────────

type
    SqliteThreadRecord =
        id: str
        title: str
        cwd: str
        deleted: bool
        createdAt: int32
        updatedAt: int32

# ── In-memory store (global state) ───────────────────────────────────────

var gRecords: SqliteThreadRecord[]
var gInitDone: bool
var gClock: int32
const MAX_RECORDS: int32 = 256

# ── File I/O (provided by runtime/driver) ────────────────────────────────

@abi_internal
@importc("RustCsgWriteFile")
fn RustCsgWriteFile(path: str, content: str): int32

# ── API contract (mirrors ThreadStore trait from codex-rs) ───────────────

fn threadStoreInit(dbPath: str, outOk: var bool) =
    outOk = false
    if gInitDone:
        outOk = true
        return
    gRecords = []
    gClock = 0
    gInitDone = true
    outOk = true

fn threadStoreInsert(id: str, title: str, cwd: str, outOk: var bool) =
    outOk = false
    if !gInitDone:
        return
    if id == "":
        return
    if gRecords.len >= MAX_RECORDS:
        return
    gClock = gClock + 1
    var ts: int32 = gClock
    var rec: SqliteThreadRecord
    rec.id = id
    rec.title = title
    rec.cwd = cwd
    rec.deleted = false
    rec.createdAt = ts
    rec.updatedAt = ts
    add(gRecords, rec)
    outOk = true

fn threadStoreGetById(id: str, outTitle: var str, outCwd: var str, outOk: var bool) =
    outTitle = ""
    outCwd = ""
    outOk = false
    if !gInitDone:
        return
    if id == "":
        return
    for i in 0..<gRecords.len:
        if gRecords[i].id == id:
            outTitle = gRecords[i].title
            outCwd = gRecords[i].cwd
            outOk = true
            return

fn threadStoreList(limit: int32, outIds: var str[], outTitles: var str[], outOk: var bool) =
    outIds = []
    outTitles = []
    outOk = false
    if !gInitDone:
        return
    if limit <= 0:
        outOk = true
        return
    var count: int32 = 0
    for i in 0..<gRecords.len:
        if count >= limit:
            break
        add(outIds, gRecords[i].id)
        add(outTitles, gRecords[i].title)
        count = count + 1
    outOk = true

# ── Full-text search across titles (case-insensitive) ────────────────────

fn threadStoreSearch(query: str, limit: int32,
                     outIds: var str[], outTitles: var str[],
                     outOk: var bool) =
    outIds = []
    outTitles = []
    outOk = false
    if !gInitDone:
        return
    if limit <= 0:
        outOk = true
        return
    var count: int32 = 0
    for i in 0..<gRecords.len:
        if count >= limit:
            break
        var title: str = gRecords[i].title
        if title.len >= query.len:
            var maxStart: int32 = title.len - query.len
            var si: int32 = 0
            var found: bool = false
            while si <= maxStart && !found:
                var allMatch: bool = true
                var qi: int32 = 0
                while qi < query.len && allMatch:
                    var tc: int32 = title[si + qi]
                    var qc: int32 = query[qi]
                    if tc >= 65 && tc <= 90:
                        tc = tc + 32
                    if qc >= 65 && qc <= 90:
                        qc = qc + 32
                    if tc != qc:
                        allMatch = false
                    qi = qi + 1
                if allMatch:
                    found = true
                si = si + 1
            if found:
                add(outIds, gRecords[i].id)
                add(outTitles, gRecords[i].title)
                count = count + 1
    outOk = true

# ── Get store statistics ─────────────────────────────────────────────────

fn threadStoreGetStats(outTotal: var int32, outActive: var int32,
                       outArchived: var int32, outOk: var bool) =
    outTotal = 0
    outActive = 0
    outArchived = 0
    outOk = false
    if !gInitDone:
        return
    outTotal = gRecords.len
    for i in 0..<gRecords.len:
        if gRecords[i].deleted:
            outArchived = outArchived + 1
        else:
            outActive = outActive + 1
    outOk = true

# ── Backup all data as JSON to file ──────────────────────────────────────

fn threadStoreBackup(path: str, outOk: var bool) =
    outOk = false
    if !gInitDone:
        return
    var json: str = threadStoreExportAll()
    var ret: int32 = RustCsgWriteFile(path, json)
    if ret != 0:
        outOk = true

# ── Internal: export all records as JSON string ──────────────────────────

fn threadStoreExportAll(): str =
    var out: str = "["
    var first: bool = true
    var i: int32 = 0
    while i < gRecords.len:
        var rec: SqliteThreadRecord = gRecords[i]
        if !first:
            out = wire.RustCsgCat(out, ",")
        first = false
        out = wire.RustCsgCat(out, "{")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("id", rec.id))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("title", rec.title))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("cwd", rec.cwd))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("deleted", rec.deleted))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("createdAt", rec.createdAt))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("updatedAt", rec.updatedAt))
        out = wire.RustCsgCat(out, "}")
        i = i + 1
    out = wire.RustCsgCat(out, "]")
    return out
