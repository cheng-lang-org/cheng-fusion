# ── Tool Classification ───────────────────────────────────────────────────────

# Classify a tool name into a category.
# Returns one of: "FileSystem", "Shell", "Network", "MCP", "Unknown"
fn RustCsgClassifyToolCall(toolName: str): str =
    if toolName == "read" || toolName == "write" || toolName == "edit" ||
       toolName == "create" || toolName == "delete" || toolName == "glob" ||
       toolName == "grep" || toolName == "search":
        return "FileSystem"
    if toolName == "bash" || toolName == "execute" || toolName == "run":
        return "Shell"
    if toolName == "web_fetch" || toolName == "web_search" || toolName == "http_request":
        return "Network"
    if toolName.len >= 5:
        if toolName[0] == 'm' && toolName[1] == 'c' && toolName[2] == 'p' && toolName[3] == '_' && toolName[4] == '_':
            return "MCP"
    return "Unknown"
