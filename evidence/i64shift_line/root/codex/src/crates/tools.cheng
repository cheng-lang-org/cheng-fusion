# Tools — type definitions for tool definition and JSON schema types.
# Ported from codex-rs/tools/src/{lib,json_schema,tool_call,tool_definition,tool_spec,tool_config}.rs
# Covers: JsonSchema, JsonSchemaPrimitiveType, JsonSchemaType,
#         AdditionalProperties, ToolCall, ToolDefinition, ToolSpec,
#         ToolPayload, ToolOutput, ToolConfig, ToolName,
#         parse_tool_input_schema

# ── JsonSchemaPrimitiveType enum ─────────────────────────────────────────────

const RustCsgJsonSchemaPrimitiveTypeCount: int32 = 7
const RustCsgJsonSchemaPrimitiveString: int32 = 0
const RustCsgJsonSchemaPrimitiveNumber: int32 = 1
const RustCsgJsonSchemaPrimitiveBoolean: int32 = 2
const RustCsgJsonSchemaPrimitiveInteger: int32 = 3
const RustCsgJsonSchemaPrimitiveObject: int32 = 4
const RustCsgJsonSchemaPrimitiveArray: int32 = 5
const RustCsgJsonSchemaPrimitiveNull: int32 = 6

fn RustCsgJsonSchemaPrimitiveTypeNames(): str =
    return "string,number,boolean,integer,object,array,null"

fn RustCsgJsonSchemaPrimitiveTypeName(typ: int32): str =
    if typ == RustCsgJsonSchemaPrimitiveString:
        return "string"
    if typ == RustCsgJsonSchemaPrimitiveNumber:
        return "number"
    if typ == RustCsgJsonSchemaPrimitiveBoolean:
        return "boolean"
    if typ == RustCsgJsonSchemaPrimitiveInteger:
        return "integer"
    if typ == RustCsgJsonSchemaPrimitiveObject:
        return "object"
    if typ == RustCsgJsonSchemaPrimitiveArray:
        return "array"
    if typ == RustCsgJsonSchemaPrimitiveNull:
        return "null"
    return ""

