import std/strings
import std/strutils as strutil

const HardeningLevelDisabled: int32 = 0
const HardeningLevelBasic: int32 = 1
const HardeningLevelStandard: int32 = 2
const HardeningLevelStrict: int32 = 3

const HardeningNone: int32 = 0
const HardeningDisablePtrace: int32 = 1
const HardeningDisableCoreDump: int32 = 2
const HardeningDisableProcessDump: int32 = 4
const HardeningLimitFileDescriptors: int32 = 8
const HardeningLimitProcessCount: int32 = 16
const HardeningLimitStackSize: int32 = 32
const HardeningLimitCoreSize: int32 = 64
const HardeningLimitAddressSpace: int32 = 128
const HardeningDisableExec: int32 = 256
const HardeningSeccomp: int32 = 512
const HardeningLandlock: int32 = 1024

type
    HardeningConfig =
        level: int32
        flags: int32
        maxFileDescriptors: int32
        maxProcessCount: int32
        maxStackSizeBytes: int32
        maxAddressSpaceBytes: int32

fn hardeningConfigDefault(): HardeningConfig =
    var c: HardeningConfig
    c.level = HardeningLevelDisabled
    c.flags = HardeningNone
    c.maxFileDescriptors = 0
    c.maxProcessCount = 0
    c.maxStackSizeBytes = 0
    c.maxAddressSpaceBytes = 0
    return c

fn applyHardening(level: int32): HardeningConfig =
    var cfg = hardeningConfigDefault()
    cfg.level = level
    var flags: int32 = 0
    if level >= 1:
        flags = flags + 1
        flags = flags + 2
        flags = flags + 4
    if level >= 2:
        flags = flags + 8
        flags = flags + 16
        flags = flags + 32
        flags = flags + 64
    if level >= 3:
        flags = flags + 128
        flags = flags + 256
        flags = flags + 512
        flags = flags + 1024
    cfg.flags = flags
    if level >= 2:
        cfg.maxFileDescriptors = 1024
        cfg.maxProcessCount = 64
        cfg.maxStackSizeBytes = 8388608
    elif level >= 1:
        cfg.maxFileDescriptors = 4096
        cfg.maxProcessCount = 256
        cfg.maxStackSizeBytes = 16777216
    if level >= 3:
        cfg.maxAddressSpaceBytes = 4294967296
    return cfg

fn hardeningHasFlag(cfg: var HardeningConfig, flag: int32): bool =
    return (cfg.flags / flag) % 2 == 1

fn hardeningHasDisablePtrace(cfg: var HardeningConfig): bool =
    return (cfg.flags / 1) % 2 == 1

fn hardeningHasDisableCoreDump(cfg: var HardeningConfig): bool =
    return (cfg.flags / 2) % 2 == 1

fn hardeningHasDisableProcessDump(cfg: var HardeningConfig): bool =
    return (cfg.flags / 4) % 2 == 1

fn hardeningHasSeccomp(cfg: var HardeningConfig): bool =
    return (cfg.flags / 512) % 2 == 1

fn preMainHardening(flag: var bool) =
    flag = true

fn disableProcessDumping(flag: var bool) =
    flag = true

# Format hardening audit log entries from a comma-separated list of event descriptions.
# Each event is formatted as "[HARDENING] event" on a separate line.
# Returns the formatted audit log string, or "" for empty input.
fn processHardeningAuditLog(events: str): str =
    if events.len == 0:
        return ""
    var result: str = ""
    var first: bool = true
    var start: int32 = 0
    var i: int32 = 0
    while i <= events.len:
        if i == events.len || events[i] == ',':
            if i > start:
                let event: str = strings.SliceBytes(events, start, i - start)
                if first:
                    result = strutil.Join(["[HARDENING] ", event], "")
                    first = false
                else:
                    result = strutil.Join([result, "\n[HARDENING] ", event], "")
            start = i + 1
        i = i + 1
    return result
