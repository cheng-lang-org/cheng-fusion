import std/os

# ═══════════════════════════════════════════════════════════════════════════════
# Sandboxing: platform sandbox type detection and constants.
# Ported from codex-rs/sandboxing
# ═══════════════════════════════════════════════════════════════════════════════

# SandboxType constants
const
    RustCsgSandboxTypeNone: int32 = 0
    RustCsgSandboxTypeBubblewrap: int32 = 1
    RustCsgSandboxTypeSeatbelt: int32 = 2
    RustCsgSandboxTypeLandlock: int32 = 3
    RustCsgSandboxTypeCustom: int32 = 4

# Detect the platform sandbox mechanism at runtime.
# Uses OSTYPE env var (set by the shell) for Unix detection:
#   macOS darwin  → Seatbelt
#   Linux         → Bubblewrap
#   Unknown       → None
fn RustCsgSandboxingDetectPlatformSandbox(): int32 =
    let ostype = os.GetEnv("OSTYPE")

    # macOS / Darwin
    if ostype == "darwin" || ostype == "Darwin" || ostype == "darwin2":
        return RustCsgSandboxTypeSeatbelt

    # Linux
    if ostype == "linux" || ostype == "linux-gnu" || ostype == "linux-musl":
        return RustCsgSandboxTypeBubblewrap

    # Windows (MSYS2/Cygwin may set OSTYPE differently; check OS env var)
    let osName = os.GetEnv("OS")
    if osName == "Windows_NT":
        return RustCsgSandboxTypeNone

    # FreeBSD / other Unix
    if ostype == "freebsd":
        return RustCsgSandboxTypeBubblewrap

    # Generic Unix-like: HOME is set
    let home = os.GetEnv("HOME")
    if ostype != "" || home != "":
        return RustCsgSandboxTypeBubblewrap

    return RustCsgSandboxTypeNone
