// fuzzy_match.cheng — Simple case-insensitive subsequence matcher
// Ported from codex-rs/utils/fuzzy-match/src/lib.rs
// Uses Cheng char indexing (str[i] returns int32 char code)

fn fuzzyMatch(haystack: str, needle: str, outIndices: var int32[], outSize: var int32): bool =
    outSize = 0
    if needle == "":
        return true
    
    let haystackLen = haystack.len
    let needleLen = needle.len
    if haystackLen == 0 || needleLen == 0:
        return false
    
    var needlePos: int32 = 0
    var haystackPos: int32 = 0
    
    while haystackPos < haystackLen && needlePos < needleLen:
        let hc = haystack[haystackPos]
        let nc = needle[needlePos]
        
        var matched = false
        if hc == nc:
            matched = true
        else:
            // Case-insensitive: ASCII 'A'-'Z' (65-90) -> 'a'-'z' (97-122)
            if hc >= 65 && hc <= 90 && hc + 32 == nc:
                matched = true
            elif nc >= 65 && nc <= 90 && nc + 32 == hc:
                matched = true
        
        if matched:
            add(outIndices, haystackPos)
            outSize = outSize + 1
            needlePos = needlePos + 1
        
        haystackPos = haystackPos + 1
    
    return needlePos >= needleLen

fn fuzzyMatchSimple(haystack: str, needle: str): bool =
    var dummyIndices: int32[]
    var dummySize: int32
    return fuzzyMatch(haystack, needle, dummyIndices, dummySize)
