import std/strings
import std/strutils as strutil

type
    RustCsgUtilsHttpHeader =
        name: str
        value: str

fn RustCsgUtilsHttpLowerAsciiChar(ch: char): str =
    if ch == 'A': return "a"
    if ch == 'B': return "b"
    if ch == 'C': return "c"
    if ch == 'D': return "d"
    if ch == 'E': return "e"
    if ch == 'F': return "f"
    if ch == 'G': return "g"
    if ch == 'H': return "h"
    if ch == 'I': return "i"
    if ch == 'J': return "j"
    if ch == 'K': return "k"
    if ch == 'L': return "l"
    if ch == 'M': return "m"
    if ch == 'N': return "n"
    if ch == 'O': return "o"
    if ch == 'P': return "p"
    if ch == 'Q': return "q"
    if ch == 'R': return "r"
    if ch == 'S': return "s"
    if ch == 'T': return "t"
    if ch == 'U': return "u"
    if ch == 'V': return "v"
    if ch == 'W': return "w"
    if ch == 'X': return "x"
    if ch == 'Y': return "y"
    if ch == 'Z': return "z"
    return ""

fn RustCsgUtilsHttpLowerAscii(text: str): str =
    var out: str
    for i in 0..<text.len:
        let ch = text[i]
        if ch >= 'A' && ch <= 'Z':
            out = strings.ConcatStr(out, RustCsgUtilsHttpLowerAsciiChar(ch))
        else:
            out = strings.ConcatStr(out, strings.SliceBytes(text, i, 1))
    return out

fn RustCsgUtilsHttpTrimQuote(text: str): str =
    var trimmed = strutil.Strip(text)
    while trimmed.len > 0 && trimmed[0] == '"':
        trimmed = strings.SliceBytes(trimmed, 1, trimmed.len - 1)
    while trimmed.len > 0 && trimmed[trimmed.len - 1] == '"':
        trimmed = strings.SliceBytes(trimmed, 0, trimmed.len - 1)
    while trimmed.len > 0 && trimmed[0] == '\'':
        trimmed = strings.SliceBytes(trimmed, 1, trimmed.len - 1)
    while trimmed.len > 0 && trimmed[trimmed.len - 1] == '\'':
        trimmed = strings.SliceBytes(trimmed, 0, trimmed.len - 1)
    return trimmed

fn RustCsgUtilsHttpFindChar(text: str, ch: char): int32 =
    for i in 0..<text.len:
        if text[i] == ch:
            return i
    return -1

fn RustCsgUtilsHttpTrimTrailingCr(text: str): str =
    var out = text
    while out.len > 0 && out[out.len - 1] == '\r':
        out = strings.SliceBytes(out, 0, out.len - 1)
    return out

fn RustCsgUtilsHttpParseContentType(header: str,
                                    outMimeType: var str,
                                    outCharset: var str,
                                    outHasCharset: var bool) =
    outMimeType = ""
    outCharset = ""
    outHasCharset = false
    let trimmed = strutil.Strip(header)
    let parts = strutil.Split(trimmed, ';')
    if parts.len == 0:
        return
    outMimeType = RustCsgUtilsHttpLowerAscii(strutil.Strip(parts[0]))
    for i in 1..<parts.len:
        let part = strutil.Strip(parts[i])
        if strings.HasPrefix(part, "charset="):
            let value = RustCsgUtilsHttpTrimQuote(strings.SliceBytes(part, 8, part.len - 8))
            if value != "":
                outCharset = value
                outHasCharset = true
                return
        elif strings.HasPrefix(part, "charset = "):
            let value = RustCsgUtilsHttpTrimQuote(strings.SliceBytes(part, 10, part.len - 10))
            if value != "":
                outCharset = value
                outHasCharset = true
                return

fn RustCsgUtilsHttpBuildHttpPostRequest(host: str, path: str, body: str, contentType: str): str =
    var out = "POST "
    out = strings.ConcatStr(out, path)
    out = strings.ConcatStr(out, " HTTP/1.1\r\nHost: ")
    out = strings.ConcatStr(out, host)
    out = strings.ConcatStr(out, "\r\nContent-Type: ")
    out = strings.ConcatStr(out, contentType)
    out = strings.ConcatStr(out, "\r\nContent-Length: ")
    out = strings.ConcatStr(out, strings.IntToStr(body.len))
    out = strings.ConcatStr(out, "\r\nConnection: close\r\n\r\n")
    out = strings.ConcatStr(out, body)
    return out

fn RustCsgUtilsHttpParseHeaders(rawHeaders: str): RustCsgUtilsHttpHeader[] =
    var headers: RustCsgUtilsHttpHeader[]
    let lines = strutil.Split(rawHeaders, '\n')
    for i in 0..<lines.len:
        let line = RustCsgUtilsHttpTrimTrailingCr(lines[i])
        if line == "":
            continue
        if line[0] == ' ' || line[0] == '\t':
            if headers.len > 0:
                let idx = headers.len - 1
                headers[idx].value = strings.ConcatStr(strings.ConcatStr(headers[idx].value, " "), strutil.Strip(line))
                continue
        let colon = RustCsgUtilsHttpFindChar(line, ':')
        if colon >= 0:
            var header: RustCsgUtilsHttpHeader
            header.name = RustCsgUtilsHttpLowerAscii(strutil.Strip(strings.SliceBytes(line, 0, colon)))
            header.value = strutil.Strip(strings.SliceBytes(line, colon + 1, line.len - colon - 1))
            add(headers, header)
    return headers

fn RustCsgUtilsHttpParseHeaderValue(rawHeaders: str, name: str): str =
    let wanted = RustCsgUtilsHttpLowerAscii(name)
    let headers = RustCsgUtilsHttpParseHeaders(rawHeaders)
    for i in 0..<headers.len:
        if headers[i].name == wanted:
            return headers[i].value
    return ""

fn RustCsgUtilsHttpParseHeaderCount(rawHeaders: str): int32 =
    let headers = RustCsgUtilsHttpParseHeaders(rawHeaders)
    return int32(headers.len)
