import std/strings
import std/strutils as strutil

const
    RustCsgInstructionsAgentsMdStartMarker: str = "# AGENTS.md instructions for "
    RustCsgInstructionsAgentsMdEndMarker: str = "</INSTRUCTIONS>"
    RustCsgInstructionsSkillOpenTag: str = "<skill>"
    RustCsgInstructionsSkillCloseTag: str = "</skill>"
    RustCsgInstructionsUserInstructionsPrefix: str = "# AGENTS.md instructions for "

type
    RustCsgInstructionsFragmentDefinition =
        startMarker: str
        endMarker: str

    RustCsgUserInstructions =
        directory: str
        text: str

    RustCsgSkillInstructions =
        name: str
        path: str
        contents: str

fn RustCsgInstructionsFragmentNew(startMarker: str, endMarker: str): RustCsgInstructionsFragmentDefinition =
    var out: RustCsgInstructionsFragmentDefinition
    out.startMarker = startMarker
    out.endMarker = endMarker
    return out

fn RustCsgInstructionsAgentsMdFragment(): RustCsgInstructionsFragmentDefinition =
    return RustCsgInstructionsFragmentNew(
        RustCsgInstructionsAgentsMdStartMarker,
        RustCsgInstructionsAgentsMdEndMarker)

fn RustCsgInstructionsSkillFragment(): RustCsgInstructionsFragmentDefinition =
    return RustCsgInstructionsFragmentNew(
        RustCsgInstructionsSkillOpenTag,
        RustCsgInstructionsSkillCloseTag)

fn RustCsgInstructionsFoldAscii(ch: char): int32 =
    let code = int32(ch)
    if code >= int32('A') && code <= int32('Z'):
        return code + 32
    return code

fn RustCsgInstructionsAsciiEqIgnoreCase(a: str, b: str): bool =
    if a.len != b.len:
        return false
    for i in 0..<a.len:
        if RustCsgInstructionsFoldAscii(a[i]) != RustCsgInstructionsFoldAscii(b[i]):
            return false
    return true

fn RustCsgInstructionsStartsWithIgnoreCase(text: str, prefix: str): bool =
    if text.len < prefix.len:
        return false
    return RustCsgInstructionsAsciiEqIgnoreCase(strings.SliceBytes(text, 0, prefix.len), prefix)

fn RustCsgInstructionsEndsWithIgnoreCase(text: str, suffix: str): bool =
    if text.len < suffix.len:
        return false
    return RustCsgInstructionsAsciiEqIgnoreCase(
        strings.SliceBytes(text, text.len - suffix.len, suffix.len),
        suffix)

fn RustCsgInstructionsFragmentMatchesText(fragment: RustCsgInstructionsFragmentDefinition, text: str): bool =
    let trimmedStart = strutil.Strip(text)
    if !RustCsgInstructionsStartsWithIgnoreCase(trimmedStart, fragment.startMarker):
        return false
    return RustCsgInstructionsEndsWithIgnoreCase(trimmedStart, fragment.endMarker)

fn RustCsgInstructionsFragmentWrap(fragment: RustCsgInstructionsFragmentDefinition, body: str): str =
    return strutil.Join([fragment.startMarker, "\n", body, "\n", fragment.endMarker], "")

fn RustCsgUserInstructionsSerializeToText(ui: RustCsgUserInstructions): str =
    let fragment = RustCsgInstructionsAgentsMdFragment()
    return strutil.Join([
        fragment.startMarker,
        ui.directory,
        "\n\n<INSTRUCTIONS>\n",
        ui.text,
        "\n",
        fragment.endMarker
    ], "")

fn RustCsgSkillInstructionsSerializeToText(si: RustCsgSkillInstructions): str =
    let fragment = RustCsgInstructionsSkillFragment()
    return RustCsgInstructionsFragmentWrap(fragment, strutil.Join([
        "<name>",
        si.name,
        "</name>\n<path>",
        si.path,
        "</path>\n",
        si.contents
    ], ""))

