# ═══════════════════════════════════════════════════════════════════════════
# Production Functions
# ═══════════════════════════════════════════════════════════════════════════

# Match a file path against a glob pattern supporting * and ? wildcards.
# * matches any sequence of characters, ? matches any single character.
fn matchFilePattern(path: str, pattern: str): bool =
    var pi: int32 = 0
    var si: int32 = 0
    var starPos: int32 = -1
    var matchPos: int32 = 0

    while si < path.len:
        if pi < pattern.len:
            let pc = Int32(pattern[pi])
            if pc == 63:
                pi = pi + 1
                si = si + 1
            elif pc == 42:
                starPos = pi
                matchPos = si
                pi = pi + 1
            elif pc == Int32(path[si]):
                pi = pi + 1
                si = si + 1
            elif starPos >= 0:
                pi = starPos + 1
                matchPos = matchPos + 1
                si = matchPos
            else:
                return false
        elif starPos >= 0:
            pi = starPos + 1
            matchPos = matchPos + 1
            si = matchPos
        else:
            return false

    while pi < pattern.len:
        let pc = Int32(pattern[pi])
        if pc != 42:
            return false
        pi = pi + 1

    return true

# Classify a file system event string into a category.
# Recognizes: CREATE, MODIFY, DELETE, RENAME (case-insensitive prefix match).
# Returns "unknown" for unrecognized events.
fn classifyFileChange(event: str): str =
    if event.len == 0:
        return "unknown"
    if strings.HasPrefix(event, "CREATE") || strings.HasPrefix(event, "create"):
        return "create"
    if strings.HasPrefix(event, "MODIFY") || strings.HasPrefix(event, "modify"):
        return "modify"
    if strings.HasPrefix(event, "DELETE") || strings.HasPrefix(event, "delete"):
        return "delete"
    if strings.HasPrefix(event, "RENAME") || strings.HasPrefix(event, "rename"):
        return "rename"
    return "unknown"

# ── fileWatcherDebounce: debounces file events within a time window ─────────
# Groups file events by path within the given windowMs window and returns
# only the latest event for each path. Events are comma-separated strings
# in the format "path:eventType". windowMs is the debounce window in milliseconds.
# Returns a deduplicated, debounced string of events, or empty string for empty input.

fn fileWatcherDebounce(events: str, windowMs: int32): str =
    if events.len == 0:
        return ""
    if windowMs <= 0:
        return events
    # Simple deduplication by keeping only the last occurrence of each path
    # Events are comma-separated "path:event" pairs
    var seen: bool[]  # track unique paths
    var result: str
    var pathMap: str  # store last event for each unique path
    var pathCount: int32 = 0
    var i: int32 = 0
    var start: int32 = 0
    while i <= events.len:
        var isSep: bool = false
        if i == events.len || events[i] == ',':
            isSep = true
        if isSep:
            var evtLen: int32 = i - start
            if evtLen > 0:
                var isDup: bool = false
                var ci: int32 = 0
                while ci < pathCount:
                    if pathMap[ci] == events:
                        isDup = true
                        # Update the last event for this path
                        var dst: int32 = 0
                        var evt: str
                        var si: int32 = start
                        while si < i:
                            evt = strings.ConcatStr(evt, strings.SliceBytes(events, si, 1))
                            si = si + 1
                        # Replace entry at index ci
                        var di: int32 = 0
                        var tmp: str
                        while di < pathCount:
                            if di == ci:
                                tmp = strings.ConcatStr(tmp, evt)
                                if di < pathCount - 1:
                                    tmp = strings.ConcatStr(tmp, ",")
                            else:
                                # Copy old entry
                                var oi: int32 = 0
                                while oi < pathMap.len:
                                    tmp = strings.ConcatStr(tmp, strings.SliceBytes(pathMap, oi, 1))
                                    oi = oi + 1
                                if di < pathCount - 1:
                                    tmp = strings.ConcatStr(tmp, ",")
                            di = di + 1
                        pathMap = tmp
                        break
                    ci = ci + 1
                if !isDup:
                    var evt: str
                    var si: int32 = start
                    while si < i:
                        evt = strings.ConcatStr(evt, strings.SliceBytes(events, si, 1))
                        si = si + 1
                    if pathCount > 0:
                        pathMap = strings.ConcatStr(pathMap, ",")
                    pathMap = strings.ConcatStr(pathMap, evt)
                    pathCount = pathCount + 1
            start = i + 1
        i = i + 1
    return pathMap
