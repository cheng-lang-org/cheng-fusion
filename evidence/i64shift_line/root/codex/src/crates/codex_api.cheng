# Codex API — rate limit header parser.
# Ported from codex-rs/codex-api/src/rate_limits.rs
# Covers: parseRateLimitHeaders

import cheng/codex/protocol/wire

const RustCsgCodexApiFunctionCount: int32 = 1
fn RustCsgCodexApiFunctionNames(): str =
    return "parseRateLimitHeaders"

# Parse rate limit headers from a JSON object of header-name to header-value pairs.
#
# Input format:
#   {"x-codex-primary-used-percent":"12.5","x-codex-primary-window-minutes":"60", ...}
#
# Returns a JSON string with parsed rate limit information:
#   {
#     "limitId": "codex",
#     "primary": { "usedPercent": "12.5", "windowMinutes": "60", "resetsAt": "1704069000" },
#     "secondary": { "usedPercent": "80.0", "windowMinutes": "1440" },
#     "credits": { "hasCredits": "true", "unlimited": "false", "balance": "10.50" },
#     "limitName": "gpt-5.2-codex-sonic",
#     "promoMessage": "..."
#   }
fn RustCsgParseRateLimitHeaders(headers: str): str =
    var out = "{"

    # Always include a default limitId
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("limitId", "codex"))

    # Parse primary rate limit window
    let primaryUsed = wire.RustCsgJsonFindOptionalStr(headers, "x-codex-primary-used-percent")
    if primaryUsed != "":
        out = wire.RustCsgCat(out, ",")
        var primaryObj = "{"
        primaryObj = wire.RustCsgCat(primaryObj, wire.RustCsgJsonFieldStr("usedPercent", primaryUsed))
        let primaryWindow = wire.RustCsgJsonFindOptionalStr(headers, "x-codex-primary-window-minutes")
        if primaryWindow != "":
            primaryObj = wire.RustCsgCat(primaryObj, ",")
            primaryObj = wire.RustCsgCat(primaryObj, wire.RustCsgJsonFieldStr("windowMinutes", primaryWindow))
        let primaryReset = wire.RustCsgJsonFindOptionalStr(headers, "x-codex-primary-reset-at")
        if primaryReset != "":
            primaryObj = wire.RustCsgCat(primaryObj, ",")
            primaryObj = wire.RustCsgCat(primaryObj, wire.RustCsgJsonFieldStr("resetsAt", primaryReset))
        primaryObj = wire.RustCsgCat(primaryObj, "}")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("primary", primaryObj))

    # Parse secondary rate limit window
    let secondaryUsed = wire.RustCsgJsonFindOptionalStr(headers, "x-codex-secondary-used-percent")
    if secondaryUsed != "":
        out = wire.RustCsgCat(out, ",")
        var secondaryObj = "{"
        secondaryObj = wire.RustCsgCat(secondaryObj, wire.RustCsgJsonFieldStr("usedPercent", secondaryUsed))
        let secondaryWindow = wire.RustCsgJsonFindOptionalStr(headers, "x-codex-secondary-window-minutes")
        if secondaryWindow != "":
            secondaryObj = wire.RustCsgCat(secondaryObj, ",")
            secondaryObj = wire.RustCsgCat(secondaryObj, wire.RustCsgJsonFieldStr("windowMinutes", secondaryWindow))
        let secondaryReset = wire.RustCsgJsonFindOptionalStr(headers, "x-codex-secondary-reset-at")
        if secondaryReset != "":
            secondaryObj = wire.RustCsgCat(secondaryObj, ",")
            secondaryObj = wire.RustCsgCat(secondaryObj, wire.RustCsgJsonFieldStr("resetsAt", secondaryReset))
        secondaryObj = wire.RustCsgCat(secondaryObj, "}")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("secondary", secondaryObj))

    # Parse credits snapshot headers
    let hasCredits = wire.RustCsgJsonFindOptionalStr(headers, "x-codex-credits-has-credits")
    if hasCredits != "":
        out = wire.RustCsgCat(out, ",")
        var creditsObj = "{"
        creditsObj = wire.RustCsgCat(creditsObj, wire.RustCsgJsonFieldStr("hasCredits", hasCredits))
        let unlimited = wire.RustCsgJsonFindOptionalStr(headers, "x-codex-credits-unlimited")
        if unlimited != "":
            creditsObj = wire.RustCsgCat(creditsObj, ",")
            creditsObj = wire.RustCsgCat(creditsObj, wire.RustCsgJsonFieldStr("unlimited", unlimited))
        let balance = wire.RustCsgJsonFindOptionalStr(headers, "x-codex-credits-balance")
        if balance != "":
            creditsObj = wire.RustCsgCat(creditsObj, ",")
            creditsObj = wire.RustCsgCat(creditsObj, wire.RustCsgJsonFieldStr("balance", balance))
        creditsObj = wire.RustCsgCat(creditsObj, "}")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("credits", creditsObj))

    # Parse optional limit name header
    let limitName = wire.RustCsgJsonFindOptionalStr(headers, "x-codex-limit-name")
    if limitName != "":
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("limitName", limitName))

    # Parse optional promo message header
    let promo = wire.RustCsgJsonFindOptionalStr(headers, "x-codex-promo-message")
    if promo != "":
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("promoMessage", promo))

    out = wire.RustCsgCat(out, "}")
    return out
