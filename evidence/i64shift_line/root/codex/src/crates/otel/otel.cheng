import std/strutils as strutil

# OpenTelemetry W3C trace context utilities (ported from codex-rs otel crate).
# Trace context header formatting.

# Format a W3C traceparent header value from a hex trace ID and span ID.
# Returns: "00-<traceId>-<spanId>-01"
# The "01" trace flags indicate the trace is sampled.
fn RustCsgFormatOtelSpanContext(traceId: str, spanId: str): str =
    return strutil.Join(["00-", traceId, "-", spanId, "-01"], "")
