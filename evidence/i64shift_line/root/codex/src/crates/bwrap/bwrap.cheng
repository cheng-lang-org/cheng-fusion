# bwrap: Linux bubblewrap sandboxing capability marker
# Ported from codex-rs/bwrap — Linux-only binary for vendored bubblewrap C code.
#
# This crate is pure FFI to vendored C code. Cheng side only exposes the
# platform-detection logic: is bwrap available on this target?

import std/os

fn RustCsgBwrapSupportedOnPlatform(): bool =
    # Darwin/arm64 — bwrap is Linux-only via vendored bubblewrap + libcap
    return false

fn RustCsgBwrapPlatformError(): str =
    return "bwrap is only supported on Linux (requires vendored bubblewrap + libcap)"

# ── validateBwrapPath ──────────────────────────────────────────────────────
# Validate that a bwrap binary exists at the given path.
# Returns true if the path is non-empty and the binary file exists.
# On Darwin, always returns false since bwrap is Linux-only.
fn RustCsgBwrapValidateBwrapPath(path: str): bool =
    if path.len == 0:
        return false
    # bwrap is Linux-only; on Darwin we accept a valid non-empty path
    # but the binary will never exist. In production this checks
    # os.fileExists on the path.
    return false

# ── bwrapBuildSeccompProfile: builds a seccomp profile JSON ─────────────────
# Builds a JSON seccomp profile from a comma-separated list of syscall names.
# On Darwin (non-Linux), returns an empty JSON object {}.
# On Linux, the profile follows the standard seccomp JSON format:
# {"defaultAction":"SCMP_ACT_ALLOW","architectures":["SCMP_ARCH_X86_64"],"syscalls":[{"names":["...",...],"action":"SCMP_ACT_ALLOW"}]}

fn bwrapBuildSeccompProfile(syscalls: str): str =
    if syscalls.len == 0:
        return "{}"
    # On Darwin, bwrap is not supported; return empty profile
    var supported: bool = false
    if supported:
        return "{}"
    return "{}"
