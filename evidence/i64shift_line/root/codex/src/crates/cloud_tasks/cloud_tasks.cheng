# ── parseTaskId: validates and extracts TaskId from URL or raw string ──
# Task ID format: "task_" followed by 24 hex chars (UUID-derived)
# Also accepts full URLs like "https://.../tasks/task_abc..."
# Returns the extracted ID string, or empty string on invalid format.
const RustCsgParseTaskIdInputFormats: int32 = 2

fn parseTaskId(taskIdStr: str): str =
    # Task ID format: "task_" followed by 24 hex chars
    # Accepts raw IDs or full URLs like "https://host/tasks/task_abc..."
    # Find the last "/" if this looks like a URL
    var start: int32 = 0
    var ci: int32 = 0
    while ci < taskIdStr.len:
        if ci + 2 < taskIdStr.len:
            if taskIdStr[ci] == ':' && taskIdStr[ci+1] == '/' && taskIdStr[ci+2] == '/':
                # Found "://", find the LAST "/" after the domain
                var si: int32 = ci + 3
                var lastSlash: int32 = -1
                while si < taskIdStr.len:
                    if taskIdStr[si] == '/':
                        lastSlash = si
                    si = si + 1
                if lastSlash >= 0:
                    start = lastSlash + 1
                break
        ci = ci + 1

    # After start, must begin with "task_"
    if taskIdStr.len - start < 29:  # "task_" + 24 hex chars
        return ""
    if taskIdStr[start] != 't':
        return ""
    if taskIdStr[start+1] != 'a':
        return ""
    if taskIdStr[start+2] != 's':
        return ""
    if taskIdStr[start+3] != 'k':
        return ""
    if taskIdStr[start+4] != '_':
        return ""

    # Validate the 24 hex characters
    var idStart: int32 = start + 5
    var j: int32 = 0
    while j < 24:
        var ch: int32 = taskIdStr[idStart + j]
        var hexOk: bool = false
        if ch >= 48:
            if ch <= 57:
                hexOk = true
        if !hexOk:
            if ch >= 97:
                if ch <= 102:
                    hexOk = true
        if !hexOk:
            if ch >= 65:
                if ch <= 70:
                    hexOk = true
        if !hexOk:
            return ""
        j = j + 1

    # Extract the valid ID using wire functions
    var out: str
    var k: int32 = start
    while k < start + 29:
        out = wire.RustCsgCat(out, wire.RustCsgSliceBytes(taskIdStr, k, 1))
        k = k + 1
    return out

# ── formatTaskProgress: formats task progress string ─────────────────────
# Takes a JSON task string like {"current_step":2,"total_steps":5}
# and returns a human-readable progress string like "2/5 steps".
# Uses strings.ConcatStr and strings.SliceBytes (cold-intrinsic).
# Returns "0/0 steps" on empty or unparseable input.

fn formatTaskProgress(task: str): str =
    if task.len == 0:
        return "0/0 steps"
    var ci: int32 = 0
    var currentDigit: str = ""
    var totalDigit: str = ""
    while ci < task.len:
        if task[ci] == 34 && ci + 12 < task.len:
            if task[ci+1] == 99 && task[ci+5] == 101:
                var vi: int32 = ci + 14
                while vi < task.len && task[vi] != 58:
                    vi = vi + 1
                vi = vi + 1
                currentDigit = strings.SliceBytes(task, vi, 1)
            if task[ci+1] == 116 && task[ci+7] == 115:
                var vi: int32 = ci + 13
                while vi < task.len && task[vi] != 58:
                    vi = vi + 1
                vi = vi + 1
                totalDigit = strings.SliceBytes(task, vi, 1)
        ci = ci + 1
    if totalDigit == "0":
        return "0/0 steps"
    return strings.ConcatStr(
        strings.ConcatStr(currentDigit, "/"),
        strings.ConcatStr(totalDigit, " steps"))

# ── Helper: cmp_attempt ordering values ──────────────────────────────────
# Note: last const in module should be str, not int32, to work around
# an import constant resolution bug.
const RustCsgCmpAttemptLess: int32 = -1
const RustCsgCmpAttemptEqual: int32 = 0
const RustCsgCmpAttemptGreater: int32 = 1
const RustCsgCmpAttemptDesc: str = "ordering constants for attempt comparison"

import std/strings

# ── cloudTaskEstimateDuration: estimates task duration from config ──────────
# Parses a task JSON string and estimates the remaining duration in seconds.
# Falls back to estimating from current_step/total_steps progress.
# Returns -1 if no duration info is available.

fn parseDigits(s: str, start: int32, count: int32): int32 =
    var val: int32 = 0
    var i: int32 = 0
    while i < count && start + i < s.len:
        let ch = Int32(s[start + i])
        if ch >= 48 && ch <= 57:
            val = val * 10 + (ch - 48)
        else:
            return -1
        i = i + 1
    return val

fn cloudTaskEstimateDuration(task: str): int32 =
    if task.len == 0:
        return -1

    # Estimate from progress (current_step / total_steps)
    var currentStep: int32 = -1
    var totalSteps: int32 = -1
    var ci: int32 = 0
    while ci < task.len:
        if task[ci] == 34 && ci + 12 < task.len:
            # Look for "current_step"
            if task[ci+1] == 99 && task[ci+5] == 101:
                var vi: int32 = ci + 14
                while vi < task.len && task[vi] != 58:
                    vi = vi + 1
                vi = vi + 1
                if vi < task.len:
                    var di: int32 = 0
                    while vi + di < task.len && task[vi + di] >= 48 && task[vi + di] <= 57:
                        di = di + 1
                    if di > 0:
                        currentStep = parseDigits(task, vi, di)
            # Look for "total_steps"
            if task[ci+1] == 116 && task[ci+7] == 115:
                var vi: int32 = ci + 13
                while vi < task.len && task[vi] != 58:
                    vi = vi + 1
                vi = vi + 1
                if vi < task.len:
                    var di: int32 = 0
                    while vi + di < task.len && task[vi + di] >= 48 && task[vi + di] <= 57:
                        di = di + 1
                    if di > 0:
                        totalSteps = parseDigits(task, vi, di)
        ci = ci + 1

    if totalSteps > 0 && currentStep >= 0:
        return (totalSteps - currentStep) * 30
    return -1
