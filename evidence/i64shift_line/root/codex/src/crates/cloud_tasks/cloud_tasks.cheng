# Cloud Tasks — type definitions and helper functions
#
# Ported from codex-rs/codex-cloud-tasks/src/lib.rs
# Covers: TaskStatus label helper, AttemptDiffData struct, ApplyJob struct,
#         BackendContext struct, GitInfoProvider trait method names,
#         parseTaskId validator, cmp_attempt ordering helper.

import cheng/codex/protocol/wire
import std/strings

# ── TaskStatus label helper ──────────────────────────────────────────────
# Maps int32 status code to uppercase label string (e.g. 0 -> "PENDING")
fn TaskStatusLabel(status: int32): str =
    if status == 0:
        return "PENDING"
    elif status == 1:
        return "READY"
    elif status == 2:
        return "APPLIED"
    elif status == 3:
        return "ERROR"
    return "UNKNOWN"

