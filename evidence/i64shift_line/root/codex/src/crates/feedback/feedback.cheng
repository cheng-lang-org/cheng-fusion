# Feedback — type definitions for feedback/upload system.
# Ported from codex-rs/feedback/src/lib.rs
# Covers: CodexFeedback, FeedbackSnapshot, FeedbackAttachment,
#         FeedbackUploadOptions, FeedbackRequestTags,
#         FeedbackDiagnostic/FeedbackDiagnostics.

# ── Constants ────────────────────────────────────────────────────────────────

const RustCsgFeedbackDoctorReportAttachmentFilename: str = "codex-doctor-report.json"
const RustCsgFeedbackDiagnosticsAttachmentFilename: str = "codex-connectivity-diagnostics.txt"
const RustCsgFeedbackDefaultMaxBytesValue: str = "4194304"  # 4 MiB (string repr for porting)
const RustCsgFeedbackUploadTimeoutSecs: int32 = 10
const RustCsgFeedbackMaxTags: int32 = 64
const RustCsgFeedbackSentryDsn: str = "https://ae32ed50620d7a7792c1ce5df38b3e3e@o33249.ingest.us.sentry.io/4510195390611458"

# ── Classification constants ────────────────────────────────────────────────

const RustCsgFeedbackClassificationBug: str = "bug"
const RustCsgFeedbackClassificationBadResult: str = "bad_result"
const RustCsgFeedbackClassificationGoodResult: str = "good_result"
const RustCsgFeedbackClassificationSafetyCheck: str = "safety_check"

fn RustCsgFeedbackDisplayClassification(classification: str): str =
    if classification == RustCsgFeedbackClassificationBug:
        return "Bug"
    if classification == RustCsgFeedbackClassificationBadResult:
        return "Bad result"
    if classification == RustCsgFeedbackClassificationGoodResult:
        return "Good result"
    if classification == RustCsgFeedbackClassificationSafetyCheck:
        return "Safety check"
    return "Other"

