# utils/base64: Pure Cheng base64 encode / decode

import std/strings

const RustCsgBase64Alphabet: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

# ── Character → base64 value (6-bit) ──────────────────────────────────────

fn rustCsgBase64CharValue(ch: char): int32 =
    if ch >= 'A' && ch <= 'Z':
        return int32(ch) - int32('A')
    if ch >= 'a' && ch <= 'z':
        return int32(ch) - int32('a') + 26
    if ch >= '0' && ch <= '9':
        return int32(ch) - int32('0') + 52
    if ch == '+':
        return 62
    if ch == '/':
        return 63
    return -1

# ── Helper: get base64 alphabet char as str ───────────────────────────────

fn rustCsgBase64GetChar(idx: int32): str =
    return strings.SliceBytes(RustCsgBase64Alphabet, idx, 1)

# ── Encode ────────────────────────────────────────────────────────────────

fn RustCsgBase64Encode(data: str): str =
    var out: str = ""
    let n: int32 = data.len
    var i: int32
    while i < n:
        # read up to 3 bytes
        let b0: int32 = int32(data[i])
        i = i + 1
        var b1: int32 = 0
        var b2: int32 = 0
        var hasB1: bool = false
        var hasB2: bool = false
        if i < n:
            b1 = int32(data[i])
            i = i + 1
            hasB1 = true
        if i < n:
            b2 = int32(data[i])
            i = i + 1
            hasB2 = true
        # encode 6-bit groups
        let q0: int32 = (b0 >> 2) & 0x3F
        out = strings.ConcatStr(out, rustCsgBase64GetChar(q0))
        if hasB1:
            let q1: int32 = ((b0 & 0x03) << 4) | ((b1 >> 4) & 0x0F)
            out = strings.ConcatStr(out, rustCsgBase64GetChar(q1))
            if hasB2:
                let q2: int32 = ((b1 & 0x0F) << 2) | ((b2 >> 6) & 0x03)
                let q3: int32 = b2 & 0x3F
                out = strings.ConcatStr(out, rustCsgBase64GetChar(q2))
                out = strings.ConcatStr(out, rustCsgBase64GetChar(q3))
            else:
                let q2: int32 = ((b1 & 0x0F) << 2)
                out = strings.ConcatStr(out, rustCsgBase64GetChar(q2))
                out = strings.ConcatStr(out, "=")
        else:
            let q1: int32 = (b0 & 0x03) << 4
            out = strings.ConcatStr(out, rustCsgBase64GetChar(q1))
            out = strings.ConcatStr(out, "==")
    return out

# ── Decode ────────────────────────────────────────────────────────────────

fn RustCsgBase64Decode(b64: str): str =
    var out: str = ""
    var i: int32
    var q0: int32
    var q1: int32
    var q2: int32
    var q3: int32
    var qCount: int32
    var padCount: int32
    let n: int32 = b64.len
    while i < n:
        let ch: char = b64[i]
        i = i + 1
        # skip whitespace
        if ch == ' ' || ch == '\n' || ch == '\r' || ch == '\t':
            continue
        if ch == '=':
            padCount = padCount + 1
            if qCount == 0:
                q0 = 0
            elif qCount == 1:
                q1 = 0
            elif qCount == 2:
                q2 = 0
            else:
                q3 = 0
            qCount = qCount + 1
        else:
            let bv: int32 = rustCsgBase64CharValue(ch)
            if bv < 0:
                continue
            if qCount == 0:
                q0 = bv
            elif qCount == 1:
                q1 = bv
            elif qCount == 2:
                q2 = bv
            else:
                q3 = bv
            qCount = qCount + 1
        if qCount == 4:
            let b0v: int32 = (q0 << 2) | (q1 >> 4)
            out = strings.ConcatStr(out, strings.CharToStr(Char(b0v)))
            if padCount <= 1:
                let b1v: int32 = ((q1 << 4) & 0xFF) | (q2 >> 2)
                out = strings.ConcatStr(out, strings.CharToStr(Char(b1v)))
            if padCount == 0:
                let b2v: int32 = ((q2 << 6) & 0xFF) | q3
                out = strings.ConcatStr(out, strings.CharToStr(Char(b2v)))
            qCount = 0
            padCount = 0
    # handle trailing incomplete group
    if qCount == 2:
        let b0vTail: int32 = (q0 << 2) | (q1 >> 4)
        out = strings.ConcatStr(out, strings.CharToStr(Char(b0vTail)))
    elif qCount == 3:
        let b0vTail3: int32 = (q0 << 2) | (q1 >> 4)
        out = strings.ConcatStr(out, strings.CharToStr(Char(b0vTail3)))
        let b1vTail3: int32 = ((q1 << 4) & 0xFF) | (q2 >> 2)
        out = strings.ConcatStr(out, strings.CharToStr(Char(b1vTail3)))
    return out
