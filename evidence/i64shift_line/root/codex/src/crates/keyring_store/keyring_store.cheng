# Keyring store (ported from codex-rs keyring-store crate)
# Credential storage via platform keyring / file-based fallback.
# Core type definitions for the keyring save/load/delete contract,
# including listing and export.

type
    RustCsgKeyringStatus =
        ok: bool
        error: str

# ── Core operations (C provider) ─────────────────────────────────────────

@abi_internal
@importc("RustCsgKeyringSave")
fn RustCsgKeyringSave(service: str, key: str, value: str): int32

@abi_internal
@importc("RustCsgKeyringLoad")
fn RustCsgKeyringLoad(service: str, key: str, outValue: var str, outOk: var int32)

@abi_internal
@importc("RustCsgKeyringDelete")
fn RustCsgKeyringDelete(service: str, key: str): int32

@abi_internal
@importc("RustCsgKeyringListKeys")
fn RustCsgKeyringListKeys(service: str): str

@abi_internal
@importc("RustCsgKeyringExport")
fn RustCsgKeyringExport(): str

# ── Public API ───────────────────────────────────────────────────────────

fn keyringSave(service: str, key: str, value: str): bool =
    return RustCsgKeyringSave(service, key, value) != 0

fn keyringLoad(service: str, key: str, outValue: var str): bool =
    var outOk: int32
    RustCsgKeyringLoad(service, key, outValue, outOk)
    return outOk != 0

fn keyringDelete(service: str, key: str): bool =
    return RustCsgKeyringDelete(service, key) != 0

fn keyringListKeys(service: str): str =
    return RustCsgKeyringListKeys(service)

fn keyringExport(): str =
    return RustCsgKeyringExport()
