# agent-identity: Agent identity type constants, URL construction, SSH key encoding
# Ported from codex-rs/agent-identity/src/lib.rs
#
# NOTE: encodeSshPublicKey requires runtime string allocation (driver_c_new_string)
# and is not available in cold_subset_direct_macho test mode. It works in full
# production builds.

import std/strings
import std/strutils as strutil
import std/base64

# ── Constants ──────────────────────────────────────────────────────────────

fn RustCsgAgentIdentityJwtAudience(): str =
    return "codex-app-server"

fn RustCsgAgentIdentityJwtIssuer(): str =
    return "https://chatgpt.com/codex-backend/agent-identity"

fn RustCsgAgentTaskRegistrationTimeoutSec(): int32 =
    return 30

fn RustCsgAgentIdentityJwksTimeoutSec(): int32 =
    return 10

# ── Local helpers ───────────────────────────────────────────────────────

fn stripTrailingSlash(s: str): str =
    if s.len > 0 && s[s.len - 1] == '/':
        return strings.SliceBytes(s, 0, s.len - 1)
    return s

# ── URL Construction ──────────────────────────────────────────────────────

fn RustCsgAgentIdentityJwksUrl(chatgptBaseUrl: str): str =
    let trimmed = stripTrailingSlash(chatgptBaseUrl)
    if strings.strContains(trimmed, "/backend-api"):
        return strutil.Join([trimmed, "/wham/agent-identities/jwks"], "")
    return strutil.Join([trimmed, "/agent-identities/jwks"], "")

fn RustCsgAgentRegistrationUrl(chatgptBaseUrl: str): str =
    let trimmed = stripTrailingSlash(chatgptBaseUrl)
    return strutil.Join([trimmed, "/v1/agent/register"], "")

# ── encodeSshPublicKey ────────────────────────────────────────────────────
# Format an Ed25519 public key as an SSH authorized_keys line.
# keyBytes must be a 32-byte string containing the raw Ed25519 public key.
# Returns "ssh-ed25519 <base64-of-blob>" where:
#   blob = uint32BE(11) + "ssh-ed25519" + uint32BE(32) + keyBytes

fn RustCsgAgentIdentityEncodeSshPublicKey(keyBytes: str): str =
    var blob: str = ""
    # uint32BE(11) — big-endian 32-bit length of "ssh-ed25519"
    blob = strutil.Join([blob, strings.charToStr(Char(0))], "")
    blob = strutil.Join([blob, strings.charToStr(Char(0))], "")
    blob = strutil.Join([blob, strings.charToStr(Char(0))], "")
    blob = strutil.Join([blob, strings.charToStr(Char(11))], "")
    # "ssh-ed25519" — 11 bytes
    blob = strutil.Join([blob, "ssh-ed25519"], "")
    # uint32BE(32) — big-endian 32-bit length of the 32-byte key
    blob = strutil.Join([blob, strings.charToStr(Char(0))], "")
    blob = strutil.Join([blob, strings.charToStr(Char(0))], "")
    blob = strutil.Join([blob, strings.charToStr(Char(0))], "")
    blob = strutil.Join([blob, strings.charToStr(Char(32))], "")
    # Key bytes
    blob = strutil.Join([blob, keyBytes], "")
    # Base64-encode the SSH blob and format the result
    let b64: str = base64.Encode(blob)
    return strutil.Join(["ssh-ed25519 ", b64], "")

# ── identityBuildJwtPayload ──────────────────────────────────────────────
# Construct a JWT payload JSON string from subject, audience, and expiry
# (epoch seconds). Returns a JSON object with standard JWT claims:
#   {"sub":"<subject>","aud":"<audience>","exp":<expiry>}
fn RustCsgAgentIdentityBuildJwtPayload(subject: str, audience: str, expiry: int32): str =
    var payload: str = "{"
    payload = strutil.Join([payload, "\"sub\":\"", subject, "\""], "")
    payload = strutil.Join([payload, ",\"aud\":\"", audience, "\""], "")
    payload = strutil.Join([payload, ",\"exp\":", strings.IntToStr(expiry)], "")
    payload = strutil.Join([payload, "}"], "")
    return payload

# ── AgentIdentityKey struct ──────────────────────────────────────────────

type
    RustCsgAgentIdentityKey =
        agentRuntimeId: str
        privateKeyPkcs8Base64: str
