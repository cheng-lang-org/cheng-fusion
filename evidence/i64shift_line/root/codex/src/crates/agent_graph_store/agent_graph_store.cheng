# agent-graph-store: Agent graph node ID & type validation, edge validation
# Ported from codex-rs/agent-graph-store/src/lib.rs
#
# Provides node validation and edge validation for the agent graph store.

import std/strings
import std/strutils as strutil

# Known agent-graph node types
fn RustCsgAgentGraphStoreKnownNodeTypes(): str[] =
    return ["open", "closed", "root", "agent"]

# Known edge types
fn RustCsgAgentGraphStoreKnownEdgeTypes(): str[] =
    return ["contains", "depends_on", "references", "child_of", "runs_on"]

# ── validateAgentGraphNode ────────────────────────────────────────────────
# Validate an agent graph node: nodeId must be alphanumeric (plus _ and -),
# nodeType must be one of the known types.
# Returns true on success with outError empty, false with error message on failure.
fn RustCsgAgentGraphStoreValidateAgentGraphNode(nodeId: str, nodeType: str, outError: var str): bool =
    outError = ""
    if nodeId.len == 0:
        outError = "nodeId must be non-empty"
        return false
    var i: int32 = 0
    while i < nodeId.len:
        let b = Int32(nodeId[i])
        var valid: bool = false
        if b >= 48 && b <= 57: valid = true    # 0-9
        if b >= 65 && b <= 90: valid = true    # A-Z
        if b >= 97 && b <= 122: valid = true   # a-z
        if nodeId[i] == '_' || nodeId[i] == '-': valid = true
        if !valid:
            outError = strutil.Join(["nodeId contains invalid character '", strings.SliceBytes(nodeId, i, 1), "'"], "")
            return false
        i = i + 1
    if nodeType.len == 0:
        outError = "nodeType must be non-empty"
        return false
    var found: bool = false
    let knownTypes = RustCsgAgentGraphStoreKnownNodeTypes()
    var j: int32 = 0
    while j < knownTypes.len:
        if knownTypes[j] == nodeType:
            found = true
            break
        j = j + 1
    if !found:
        outError = strutil.Join(["unknown nodeType: ", nodeType], "")
        return false
    return true

# ── graphStoreValidateEdge ────────────────────────────────────────────────
# Validate a graph edge from fromNode to toNode with the given edgeType.
# Both fromNode and toNode are validated using validateAgentGraphNode.
# edgeType must be one of the known edge types.
# Returns true on success with outError empty, false with error message on failure.
fn RustCsgAgentGraphStoreValidateEdge(fromNode: str, toNode: str, edgeType: str, outError: var str): bool =
    outError = ""

    # Validate fromNode
    var fromErr: str
    if !RustCsgAgentGraphStoreValidateAgentGraphNode(fromNode, "open", fromErr):
        outError = strutil.Join(["invalid fromNode: ", fromErr], "")
        return false

    # Validate toNode
    var toErr: str
    if !RustCsgAgentGraphStoreValidateAgentGraphNode(toNode, "open", toErr):
        outError = strutil.Join(["invalid toNode: ", toErr], "")
        return false

    # Check for self-loop
    if fromNode == toNode:
        outError = "self-loop edge is not allowed"
        return false

    # Validate edgeType
    if edgeType.len == 0:
        outError = "edgeType must be non-empty"
        return false
    var found: bool = false
    let knownEdges = RustCsgAgentGraphStoreKnownEdgeTypes()
    var k: int32 = 0
    while k < knownEdges.len:
        if knownEdges[k] == edgeType:
            found = true
            break
        k = k + 1
    if !found:
        outError = strutil.Join(["unknown edgeType: ", edgeType], "")
        return false

    return true
