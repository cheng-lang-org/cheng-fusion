# thread-store: Storage-neutral thread persistence interfaces
# Ported from codex-rs/thread-store — type definitions and thread persistence interface.
#
# Pure Cheng logic: thread store error message constants and type name markers.

const
    RustCsgThreadStoreErrorNotFound: str = "thread not found"
    RustCsgThreadStoreErrorAlreadyExists: str = "thread already exists"
    RustCsgThreadStoreErrorPersistence: str = "thread persistence error"

fn RustCsgThreadStoreErrorNotFoundMsg(): str =
    return RustCsgThreadStoreErrorNotFound

fn RustCsgThreadStoreErrorAlreadyExistsMsg(): str =
    return RustCsgThreadStoreErrorAlreadyExists

# ── Thread store merge/diff (parallel arrays) ──────────────────────────
# Uses parallel string arrays (ids[i], data[i]) to avoid struct type
# definition that can interfere with existing type field offsets.

fn RustCsgThreadStoreMerge(
    sourceIds: str[], sourceData: str[],
    targetIds: str[], targetData: str[],
    outIds: var str[], outData: var str[]
) =
    for i in 0..<sourceIds.len:
        add(outIds, sourceIds[i])
        add(outData, sourceData[i])
    for i in 0..<targetIds.len:
        var found: bool = false
        for j in 0..<outIds.len:
            if outIds[j] == targetIds[i]:
                outData[j] = targetData[i]
                found = true
                break
        if !found:
            add(outIds, targetIds[i])
            add(outData, targetData[i])

fn RustCsgThreadStoreDiff(
    aIds: str[], aData: str[],
    bIds: str[],
    outIds: var str[], outData: var str[]
) =
    for i in 0..<aIds.len:
        var found: bool = false
        for j in 0..<bIds.len:
            if aIds[i] == bIds[j]:
                found = true
                break
        if !found:
            add(outIds, aIds[i])
            add(outData, aData[i])
