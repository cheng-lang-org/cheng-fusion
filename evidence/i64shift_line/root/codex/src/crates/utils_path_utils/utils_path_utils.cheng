import std/strings
import std/strutils as strutil

@abi_internal
@importc("RustCsgRealPath")
fn RustCsgRealPath(path: str): str

# ── Path utility functions (ported from codex-rs) ──

fn asciiEqIgnoreCase(left: str, right: str): bool =
    if left.len != right.len:
        return false
    for i in 0..<left.len:
        var l: int32 = Int32(left[i])
        var r: int32 = Int32(right[i])
        if l >= 65 && l <= 90:
            l = l + 32
        if r >= 65 && r <= 90:
            r = r + 32
        if l != r:
            return false
    return true

# Compare paths after canonicalization. Uses realpath(3) for symlink
# resolution. Falls back to raw string equality if either path does not
# exist on the filesystem.
fn pathsMatchAfterNormalizationRaw(left: str, right: str): bool =
    if left == "" || right == "":
        return false
    let realLeft = RustCsgRealPath(left)
    let realRight = RustCsgRealPath(right)
    if realLeft != "" && realRight != "":
        return realLeft == realRight
    return left == right

# ── splitPathComponents ─────────────────────────────────────────────────────
# Split a path into its directory components.
# "/a/b/c" -> ["a", "b", "c"]
fn splitPathComponents(path: str): str[] =
    var result: str[]
    let n = path.len
    var i: int32 = 0
    while i < n:
        # Skip leading separators
        while i < n && (path[i] == '/' || path[i] == '\\'):
            i = i + 1
        if i >= n:
            break
        var start: int32 = i
        while i < n && path[i] != '/' && path[i] != '\\':
            i = i + 1
        if i > start:
            let component = strings.SliceBytes(path, start, i - start)
            add(result, component)
    return result

# ── commonAncestor ──────────────────────────────────────────────────────────
# Find the longest common ancestor directory of two paths.
# Scans raw path bytes to avoid str[]/add codegen issues.
# "/a/b/c" and "/a/b/d" -> "/a/b"
fn commonAncestor(path1: str, path2: str): str =
    var n1 = path1.len
    var n2 = path2.len
    var i: int32 = 0
    # Skip common prefix character by character
    while i < n1 && i < n2:
        if path1[i] != path2[i]:
            break
        i = i + 1
    # If all chars of shorter path match, return the shorter path
    var shorter = n1
    if n2 < shorter: shorter = n2
    if i == shorter:
        if path1.len < path2.len:
            return path1
        return path2
    # Backtrack to last complete path separator (/)
    while i > 0:
        if path1[i - 1] == '/':
            break
        i = i - 1
    # i is now position after the separator (or 0 if no separator found)
    if i <= 1:
        if path1.len > 0 && path1[0] == '/':
            return "/"
        return ""
    # Return prefix up to but not including the trailing separator
    return strutil.SliceStr(path1, 0, i - 1)
