const RustCsgTransportEventVariantCount: int32 = 3
const RustCsgTransportEventVariant1: str = "ConnectionOpened"
const RustCsgTransportEventVariant2: str = "ConnectionClosed"
const RustCsgTransportEventVariant3: str = "IncomingMessage"
fn TransportEventVariantNames(): str = return "ConnectionOpened,ConnectionClosed,IncomingMessage"

const RustCsgConnectionOpenedFieldCount: int32 = 4
const RustCsgConnectionOpenedField1: str = "connection_id"
const RustCsgConnectionOpenedField2: str = "origin"
const RustCsgConnectionOpenedField3: str = "writer"
const RustCsgConnectionOpenedField4: str = "disconnect_sender"
fn ConnectionOpenedFields(): str =
    return "connection_id|ConnectionId,origin|ConnectionOrigin,writer|Sender_QueuedOutgoingMessage,disconnect_sender|opt_CancellationToken"

const RustCsgConnectionClosedFieldCount: int32 = 1
const RustCsgConnectionClosedField1: str = "connection_id"
fn ConnectionClosedFields(): str = return "connection_id|ConnectionId"

const RustCsgIncomingMessageFieldCount: int32 = 2
const RustCsgIncomingMessageField1: str = "connection_id"
const RustCsgIncomingMessageField2: str = "message"
fn IncomingMessageFields(): str = return "connection_id|ConnectionId,message|JSONRPCMessage"

