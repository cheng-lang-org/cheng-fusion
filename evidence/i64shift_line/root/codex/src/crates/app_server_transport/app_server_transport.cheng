# ═════════════════════════════════════════════════════════════════════════
# Production: event classification and transport utilities
# ═════════════════════════════════════════════════════════════════════════

import std/strings

# ── Transport URL parsing ────────────────────────────────────────────────
#
# Classifies a listen URL string into the transport variant it represents.

fn RustCsgHasPrefix(s: str, prefix: str): bool =
    if prefix.len > s.len:
        return false
    var i: int32 = 0
    while i < prefix.len:
        if s[i] != prefix[i]:
            return false
        i = i + 1
    return true

fn RustCsgClassifyTransportUrl(url: str): str =
    if RustCsgHasPrefix(url, "stdio://"):
        return "Stdio"
    elif RustCsgHasPrefix(url, "unix://"):
        return "UnixSocket"
    elif RustCsgHasPrefix(url, "ws://") || RustCsgHasPrefix(url, "wss://"):
        return "WebSocket"
    return "Off"

# ── TransportEvent classification ────────────────────────────────────────

fn RustCsgIsConnectionOpened(variant: str): bool =
    return variant == "ConnectionOpened"

fn RustCsgIsConnectionClosed(variant: str): bool =
    return variant == "ConnectionClosed"

fn RustCsgIsIncomingMessage(variant: str): bool =
    return variant == "IncomingMessage"

# ── ConnectionOrigin classification ──────────────────────────────────────

fn RustCsgIsStdioConnection(origin: str): bool =
    return origin == "Stdio"

fn RustCsgIsInProcessConnection(origin: str): bool =
    return origin == "InProcess"

fn RustCsgIsWebSocketConnection(origin: str): bool =
    return origin == "WebSocket"

fn RustCsgIsRemoteControlConnection(origin: str): bool =
    return origin == "RemoteControl"

# ── OutgoingMessage classification ───────────────────────────────────────

fn RustCsgIsServerRequest(msgVariant: str): bool =
    return msgVariant == "Request"

fn RustCsgIsAppServerNotification(msgVariant: str): bool =
    return msgVariant == "AppServerNotification"

fn RustCsgIsResponse(msgVariant: str): bool =
    return msgVariant == "Response"

fn RustCsgIsOutgoingError(msgVariant: str): bool =
    return msgVariant == "Error"

# ── RemoteControl handle availability ────────────────────────────────────

fn RustCsgRemoteControlAvailable(stateDbAvailable: bool): bool =
    return stateDbAvailable

# ── ConnectionId rendering ───────────────────────────────────────────────

fn RustCsgRenderConnectionId(id: int64): str =
    return strings.Int64ToStr(id)
