# ── buildTaskListRequest: constructs a task list JSON request ────────────
# Builds a JSON object with "filter" and "limit" fields.
# filter: optional query string to filter tasks, empty string means no filter.
# limit: maximum number of tasks to return.

fn buildTaskListRequest(filter: str, limit: int32): str =
    var out: str = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("filter", filter))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("limit", limit))
    out = wire.RustCsgCat(out, "}")
    return out

# ── buildTaskFilter: constructs a task filter JSON object ─────────────────
# Builds a JSON filter object with "status" and "since" fields.
# status: task status string (e.g. "pending", "ready"), can be empty.
# since: ISO date string (e.g. "2024-01-01"), can be empty.
# Empty fields are omitted from the output.

fn buildTaskFilter(status: str, since: str): str =
    var out: str = "{"
    var hasPrev: bool = false
    if status.len > 0:
        out = strings.ConcatStr(out, strings.ConcatStr(strings.ConcatStr("\"status\":\"", status), "\""))
        hasPrev = true
    if since.len > 0:
        if hasPrev:
            out = strings.ConcatStr(out, ",")
        out = strings.ConcatStr(out, strings.ConcatStr(strings.ConcatStr("\"since\":\"", since), "\""))
    out = strings.ConcatStr(out, "}")
    return out

# ── cloudTaskClientBuildPollRequest: constructs a task poll request JSON ─────
# Builds a JSON object with task_id and requested fields.
# taskId: the task ID string (e.g. "task_abc123...").
# Returns a JSON string like {"task_id":"task_abc...","fields":["status"]}.

fn cloudTaskClientBuildPollRequest(taskId: str): str =
    var out: str = "{"
    out = strings.ConcatStr(out, strings.ConcatStr(strings.ConcatStr("\"task_id\":\"", taskId), "\""))
    out = strings.ConcatStr(out, ",\"fields\":[\"status\"]")
    out = strings.ConcatStr(out, "}")
    return out
