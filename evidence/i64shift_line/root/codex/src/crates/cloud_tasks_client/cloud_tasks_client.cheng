# Cloud Tasks Client — API type definitions and request builder
#
# Ported from codex-rs/codex-cloud-tasks-client/src/api.rs
# Covers: TaskId, TaskStatus, AttemptStatus, ApplyStatus, DiffSummary,
#         TaskSummary, ApplyOutcome, CreatedTask, TaskListPage, TaskText,
#         TurnAttempt, CloudBackend trait method signatures,
#         buildTaskListRequest helper.

import cheng/codex/protocol/wire
import std/strings

# ── TaskId (always used as bare str; no newtype needed) ───────────────────

# ── Enum: TaskStatus ─────────────────────────────────────────────────────
const RustCsgTaskStatusPending: int32 = 0
const RustCsgTaskStatusReady: int32 = 1
const RustCsgTaskStatusApplied: int32 = 2
const RustCsgTaskStatusError: int32 = 3

const RustCsgTaskStatusCount: int32 = 4

fn TaskStatusName(v: int32): str =
    if v == RustCsgTaskStatusPending:
        return "pending"
    elif v == RustCsgTaskStatusReady:
        return "ready"
    elif v == RustCsgTaskStatusApplied:
        return "applied"
    elif v == RustCsgTaskStatusError:
        return "error"
    return "unknown"

fn TaskStatusLabel(v: int32): str =
    if v == RustCsgTaskStatusPending:
        return "PENDING"
    elif v == RustCsgTaskStatusReady:
        return "READY"
    elif v == RustCsgTaskStatusApplied:
        return "APPLIED"
    elif v == RustCsgTaskStatusError:
        return "ERROR"
    return "UNKNOWN"

