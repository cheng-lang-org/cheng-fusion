# Exec Server Types — request classification and type constants.
# Ported from codex-rs/exec-server/src/lib.rs
#
# Defines constants for exec-server process events, output streams,
# environment identifiers, and request type classification.

# ── Process event variant constants ───────────────────────────────────
const RustCsgExecProcessEventOutput: int32 = 0
const RustCsgExecProcessEventExited: int32 = 1
const RustCsgExecProcessEventClosed: int32 = 2
const RustCsgExecProcessEventFailed: int32 = 3

# ── Output stream variant constants ───────────────────────────────────
const RustCsgExecOutputStreamStdout: int32 = 0
const RustCsgExecOutputStreamStderr: int32 = 1
const RustCsgExecOutputStreamPty: int32 = 2

# Manual string contains (avoids cold-compiler bug with strutil.Contains + '"').
fn manualContains(haystack: str, needle: str): bool =
    var i: int32 = 0
    while i < haystack.len:
        if haystack[i] == needle[0]:
            var allMatch: bool = true
            var j: int32 = 1
            while j < needle.len:
                if i + j >= haystack.len || haystack[i + j] != needle[j]:
                    allMatch = false
                    break
                j = j + 1
            if allMatch:
                return true
        i = i + 1
    return false

# Classify an exec server request (JSON string) into a request type.
fn execServerClassifyRequest(request: str): str =
    if manualContains(request, "\"type\":\"execute\""):
        return "execute"
    if manualContains(request, "\"type\":\"list_files\""):
        return "list_files"
    if manualContains(request, "\"type\":\"read_file\""):
        return "read_file"
    if manualContains(request, "\"type\":\"write_file\""):
        return "write_file"
    if manualContains(request, "\"type\":\"get_environment\""):
        return "get_environment"
    return "unknown"
