import std/strings
import std/strutils as strutil

# ═══════════════════════════════════════════════════════════════════════════════
# code-mode: exec tool description builder, identifier normalization, code block parsing
# Ported from codex-rs/code-mode/src/description.rs
#
# NOTE: Standalone Mach-O mode has bugs with str+char/char+str concatenation
# and SliceStr with start>0. We use strutil.Split/Join/Strip instead.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Template functions ────────────────────────────────────────────────────────
# NOTE: Must use a single string literal. Standalone Mach-O corrupts compile-time
# string concatenation (both const and in function return expressions).

fn RustCsgCodeModeExecDescriptionTemplate(): str =
    return "Run JavaScript code to orchestrate/compose tool calls\n- Evaluates the provided JavaScript code in a fresh V8 isolate as an async module.\n- All nested tools are available on the global `tools` object."

fn RustCsgCodeModeWaitDescriptionTemplate(): str =
    return "- Use `wait` only after `exec` returns `Script running with cell ID ...`.\n- `cell_id` identifies the running `exec` cell to resume."

# ── normalizeCodeModeIdentifier ──────────────────────────────────────────────
# Convert a tool key to a valid JS identifier.
# Uses Split+Join to replace invalid chars (avoids char+str bugs).
fn RustCsgCodeModeNormalizeIdentifier(toolKey: str): str =
    if toolKey == "":
        return "_"

    var result: str = toolKey

    # Handle leading character (stricter rules: no digits allowed)
    let first: char = toolKey[0]
    if !(first == '_' || first == '$' ||
          (first >= 'a' && first <= 'z') ||
          (first >= 'A' && first <= 'Z')):
        # Replace first char with _ by splitting on it and joining with _
        result = strutil.Join(strutil.Split(toolKey, first), "_")

    # Replace common invalid identifier chars (these are never valid)
    result = strutil.Join(strutil.Split(result, '-'), "_")
    result = strutil.Join(strutil.Split(result, '.'), "_")
    result = strutil.Join(strutil.Split(result, '@'), "_")
    result = strutil.Join(strutil.Split(result, ' '), "_")

    return result

# ── buildExecToolDescription ─────────────────────────────────────────────────
# Build the exec tool description string from enabled tool definitions.
fn RustCsgCodeModeBuildExecToolDescription(
    toolsDesc: str,
    namespaceDescs: str,
    codeModeOnly: bool,
    deferredToolsAvailable: bool
): str =
    var sections: str[]
    add(sections, RustCsgCodeModeExecDescriptionTemplate())
    if deferredToolsAvailable:
        add(sections, "Some nested MCP/app tools may be omitted from this description. They are still available on the global `tools` object and listed in `ALL_TOOLS`.")
    if !codeModeOnly:
        return strutil.Join(sections, "\n\n")
    # Add individual tool sections
    if toolsDesc != "":
        var toolSection: str = ""
        # Split by comma to get individual tool names
        let toolNames: str[] = strutil.Split(toolsDesc, ',')
        for idx in 0..<toolNames.len:
            let name: str = strutil.Strip(toolNames[idx])
            if name.len > 0:
                let globalName = RustCsgCodeModeNormalizeIdentifier(name)
                if idx > 0:
                    toolSection = strutil.Join([toolSection, "\n\n"], "")
                if globalName == name:
                    toolSection = strutil.Join([toolSection, "### `", globalName, "`"], "")
                else:
                    toolSection = strutil.Join([toolSection, "### `", globalName, "` (`", name, "`)"], "")
        if toolSection != "":
            add(sections, toolSection)
    return strutil.Join(sections, "\n\n")

# ── parseCodeBlock ─────────────────────────────────────────────────────────
# Parse code blocks from markdown (``` fences).
# Returns arrays of {language: str, content: str}.
type
    RustCsgCodeModeCodeBlock =
        language: str
        content: str

fn RustCsgCodeModeParseCodeBlock(markdown: str): RustCsgCodeModeCodeBlock[] =
    var blocks: RustCsgCodeModeCodeBlock[]
    let n: int32 = markdown.len
    if n == 0:
        return blocks
    var i: int32 = 0
    while i < n:
        if i + 2 < n && markdown[i] == '`' && markdown[i + 1] == '`' && markdown[i + 2] == '`':
            let fenceStart: int32 = i
            var lineEnd: int32 = i + 3
            while lineEnd < n && markdown[lineEnd] != '\n':
                lineEnd = lineEnd + 1
            var language: str = ""
            if lineEnd > i + 3:
                language = strings.SliceBytes(markdown, i + 3, lineEnd - i - 3)
                language = strutil.Strip(language)
            var contentStart: int32 = lineEnd + 1
            if lineEnd >= n:
                i = n
                continue
            var closePos: int32 = contentStart
            var foundClose: bool = false
            while closePos + 2 < n:
                if markdown[closePos] == '`' && markdown[closePos + 1] == '`' && markdown[closePos + 2] == '`':
                    foundClose = true
                    break
                closePos = closePos + 1
            if foundClose:
                let content: str = strings.SliceBytes(markdown, contentStart, closePos - 1 - contentStart)
                var block: RustCsgCodeModeCodeBlock
                block.language = language
                block.content = content
                add(blocks, block)
                i = closePos + 3
            else:
                i = n
        else:
            i = i + 1
    return blocks

# ── detectLanguage ──────────────────────────────────────────────────────
fn RustCsgCodeModeDetectLanguage(code: str): str =
    if code == "":
        return ""
    # Check shebang (#!interpreter)
    if code.len >= 2 && code[0] == '#' && code[1] == '!':
        var shebangStart: int32 = 2
        var shebangEnd: int32 = shebangStart
        while shebangEnd < code.len && code[shebangEnd] != '\n' && code[shebangEnd] != '\r':
            shebangEnd = shebangEnd + 1
        var shebang: str = strings.SliceBytes(code, shebangStart, shebangEnd - shebangStart)
        # Find the last / to get executable name
        var lastSlash: int32 = -1
        for j in 0..<shebang.len:
            if shebang[j] == '/':
                lastSlash = j
        var cmdStart: int32 = lastSlash + 1
        var cmdEnd: int32 = cmdStart
        while cmdEnd < shebang.len && shebang[cmdEnd] != ' ' && shebang[cmdEnd] != '\t':
            cmdEnd = cmdEnd + 1
        if cmdEnd > cmdStart:
            var cmd: str = strings.SliceBytes(shebang, cmdStart, cmdEnd - cmdStart)
            # Handle /usr/bin/env case: "env python3" -> use next arg
            if cmd == "env":
                var envPos: int32 = cmdEnd
                while envPos < shebang.len && (shebang[envPos] == ' ' || shebang[envPos] == '\t'):
                    envPos = envPos + 1
                if envPos < shebang.len:
                    var interpStart: int32 = envPos
                    var interpEnd: int32 = interpStart
                    while interpEnd < shebang.len && shebang[interpEnd] != ' ' && shebang[interpEnd] != '\t':
                        interpEnd = interpEnd + 1
                    if interpEnd > interpStart:
                        return strings.SliceBytes(shebang, interpStart, interpEnd - interpStart)
            return cmd
    # No shebang — fallback to keyword heuristics on first non-blank line
    var pos: int32 = 0
    while pos < code.len && (code[pos] == ' ' || code[pos] == '\t' || code[pos] == '\n' || code[pos] == '\r'):
        pos = pos + 1
    if pos >= code.len:
        return ""
    # XML/HTML declaration
    if pos + 1 < code.len && code[pos] == '<' && code[pos + 1] == '!':
        return "xml"
    if pos + 1 < code.len && code[pos] == '<' && code[pos + 1] == 'h':
        return "html"
    # Shebang-style comment but missing ! — likely Python
    if code[pos] == '#' && (code[pos + 1] == ' ' || code[pos + 1] == '-'):
        return "python"
    # import/from/def/class — Python
    if pos + 6 < code.len && code[pos] == 'i' && code[pos + 1] == 'm' && code[pos + 2] == 'p' && code[pos + 3] == 'o' && code[pos + 4] == 'r' && code[pos + 5] == 't' && code[pos + 6] == ' ':
        return "python"
    if pos + 4 < code.len && code[pos] == 'f' && code[pos + 1] == 'r' && code[pos + 2] == 'o' && code[pos + 3] == 'm' && code[pos + 4] == ' ':
        return "python"
    if pos + 3 < code.len && code[pos] == 'd' && code[pos + 1] == 'e' && code[pos + 2] == 'f' && code[pos + 3] == ' ':
        return "python"
    if pos + 5 < code.len && code[pos] == 'c' && code[pos + 1] == 'l' && code[pos + 2] == 'a' && code[pos + 3] == 's' && code[pos + 4] == 's' && code[pos + 5] == ' ':
        return "python"
    # fn/const/type/var — Cheng
    if pos + 2 < code.len && code[pos] == 'f' && code[pos + 1] == 'n' && code[pos + 2] == ' ':
        return "cheng"
    if pos + 5 < code.len && code[pos] == 'c' && code[pos + 1] == 'o' && code[pos + 2] == 'n' && code[pos + 3] == 's' && code[pos + 4] == 't' && code[pos + 5] == ' ':
        return "cheng"
    if pos + 4 < code.len && code[pos] == 't' && code[pos + 1] == 'y' && code[pos + 2] == 'p' && code[pos + 3] == 'e' && code[pos + 4] == ' ':
        return "cheng"
    if pos + 3 < code.len && code[pos] == 'v' && code[pos + 1] == 'a' && code[pos + 2] == 'r' && code[pos + 3] == ' ':
        return "cheng"
    # #include — C/C++
    if pos + 7 < code.len && code[pos] == '#' && code[pos + 1] == 'i' && code[pos + 2] == 'n' && code[pos + 3] == 'c' && code[pos + 4] == 'l' && code[pos + 5] == 'u' && code[pos + 6] == 'd' && code[pos + 7] == 'e':
        return "cpp"
    # use/mod — Rust
    if pos + 3 < code.len && code[pos] == 'u' && code[pos + 1] == 's' && code[pos + 2] == 'e' && code[pos + 3] == ' ':
        return "rust"
    if pos + 3 < code.len && code[pos] == 'm' && code[pos + 1] == 'o' && code[pos + 2] == 'd' && code[pos + 3] == ' ':
        return "rust"
    # function/var/let/const/console — JavaScript
    if pos + 8 < code.len && code[pos] == 'f' && code[pos + 1] == 'u' && code[pos + 2] == 'n' && code[pos + 3] == 'c' && code[pos + 4] == 't' && code[pos + 5] == 'i' && code[pos + 6] == 'o' && code[pos + 7] == 'n' && code[pos + 8] == ' ':
        return "javascript"
    if pos + 3 < code.len && code[pos] == 'l' && code[pos + 1] == 'e' && code[pos + 2] == 't' && code[pos + 3] == ' ':
        return "javascript"
    if pos + 5 < code.len && code[pos] == 'c' && code[pos + 1] == 'o' && code[pos + 2] == 'n' && code[pos + 3] == 's' && code[pos + 4] == 't' && code[pos + 5] == ' ':
        return "javascript"
    if pos + 6 < code.len && code[pos] == 'c' && code[pos + 1] == 'o' && code[pos + 2] == 'n' && code[pos + 3] == 's' && code[pos + 4] == 'o' && code[pos + 5] == 'l' && code[pos + 6] == 'e':
        return "javascript"
    return ""

# ── formatOutput ─────────────────────────────────────────────────────────
fn RustCsgCodeModeFormatOutput(result: str): str =
    if result == "":
        return "No output."
    return strutil.Join(["```\n", result, "\n```\n"], "")
