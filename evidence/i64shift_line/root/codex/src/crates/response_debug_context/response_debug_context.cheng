import std/strings
import std/strutils as strutil

# ── Inline base64 decode / JSON extraction / response_debug_context ──

fn makeAsciiTable(): str =
    return " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

fn base64CharValue(ch: char): int32 =
    let c: int32 = int32(ch)
    if c >= int32('A') and c <= int32('Z'):
        return c - int32('A')
    if c >= int32('a') and c <= int32('z'):
        return c - int32('a') + 26
    if c >= int32('0') and c <= int32('9'):
        return c - int32('0') + 52
    if c == int32('+'):
        return 62
    if c == int32('/'):
        return 63
    return -1

fn byteToStr(b: int32, table: str): str =
    if b >= 32 and b <= 126:
        let slice: str = strings.SliceBytes(table, b - 32, 1)
        return strutil.Join([slice], "")
    return ""

fn base64DecodeInline(input: str): str =
    let n: int32 = input.len
    if n == 0:
        return ""
    var validCount: int32 = 0
    var paddingCount: int32 = 0
    var i: int32 = 0
    while i < n:
        let ch: char = input[i]
        if ch == '=':
            paddingCount = paddingCount + 1
        else:
            let v: int32 = base64CharValue(ch)
            if v < 0:
                return ""
            validCount = validCount + 1
        i = i + 1
    if validCount == 0:
        return ""
    if validCount % 4 != 0:
        return ""
    let totalDecoded: int32 = (validCount / 4) * 3
    let outLen: int32 = totalDecoded - paddingCount
    let tbl: str = makeAsciiTable()
    var parts: str[]
    var srcIdx: int32 = 0
    var written: int32 = 0
    while srcIdx < validCount:
        let b0: int32 = base64CharValue(input[srcIdx])
        let b1: int32 = base64CharValue(input[srcIdx + 1])
        let b2: int32 = base64CharValue(input[srcIdx + 2])
        let b3: int32 = base64CharValue(input[srcIdx + 3])
        let triple: int32 = (b0 << 18) | (b1 << 12) | (b2 << 6) | b3
        if written < outLen:
            let byteVal: int32 = (triple >> 16) & 255
            let byteStr: str = byteToStr(byteVal, tbl)
            if byteStr != "":
                add(parts, byteStr)
            written = written + 1
        if written < outLen:
            let byteVal: int32 = (triple >> 8) & 255
            let byteStr: str = byteToStr(byteVal, tbl)
            if byteStr != "":
                add(parts, byteStr)
            written = written + 1
        if written < outLen:
            let byteVal: int32 = triple & 255
            let byteStr: str = byteToStr(byteVal, tbl)
            if byteStr != "":
                add(parts, byteStr)
            written = written + 1
        srcIdx = srcIdx + 4
    if parts.len == 0:
        return ""
    return strutil.Join(parts, "")

fn startsWithAt(text: str, sub: str, pos: int32): bool =
    let sn: int32 = sub.len
    var j: int32 = 0
    while j < sn:
        if text[pos + j] != sub[j]:
            return false
        j = j + 1
    return true

fn strFind(text: str, sub: str): int32 =
    let n: int32 = text.len
    let sn: int32 = sub.len
    if sn == 0:
        return 0
    if sn > n:
        return -1
    var i: int32 = 0
    while i <= n - sn:
        if startsWithAt(text, sub, i):
            return i
        i = i + 1
    return -1

fn extractJsonStrValue(text: str, key: str): str =
    let searchKey: str = strutil.Join(["\"", key, "\":\""], "")
    let idx: int32 = strFind(text, searchKey)
    if idx < 0:
        return ""
    let valStart: int32 = idx + searchKey.len
    var valEnd: int32 = valStart
    while valEnd < text.len:
        if text[valEnd] == '"':
            break
        valEnd = valEnd + 1
    if valEnd >= text.len:
        return ""
    return strings.SliceBytes(text, valStart, valEnd - valStart)

fn extractResponseDebugContext(
    xRequestId: str, xCfRay: str, xErrorJson: str,
    outRequestId: var str, outCfRay: var str, outAuthError: var str, outAuthErrorCode: var str
) =
    outRequestId = xRequestId
    outCfRay = xCfRay
    outAuthError = ""
    outAuthErrorCode = ""
    if xErrorJson == "":
        return
    let jsonStr: str = base64DecodeInline(xErrorJson)
    if jsonStr == "":
        return
    outAuthError = extractJsonStrValue(jsonStr, "message")
    outAuthErrorCode = extractJsonStrValue(jsonStr, "code")
