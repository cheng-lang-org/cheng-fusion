# ═════════════════════════════════════════════════════════════════════════
# Production: request building utilities
# ═════════════════════════════════════════════════════════════════════════

import std/strings

# ── TypedRequestError rendering ──────────────────────────────────────────

fn RustCsgRenderTypedRequestErrorVariant(variant: str): str =
    if variant == "Transport":
        return "transport_error"
    elif variant == "Server":
        return "server_error"
    elif variant == "Deserialize":
        return "deserialize_error"
    return "unknown_error"

# ── In-process client start args builder ─────────────────────────────────
#
# Validates the required fields of InProcessClientStartArgs and returns a
# comma-separated diagnostics string of missing fields.

const RustCsgInProcessStartArgsRequiredFieldCount: int32 = 5
const RustCsgInProcessStartArgsRequiredField1: str = "client_name"
const RustCsgInProcessStartArgsRequiredField2: str = "client_version"
const RustCsgInProcessStartArgsRequiredField3: str = "arg0_paths"
const RustCsgInProcessStartArgsRequiredField4: str = "config"
const RustCsgInProcessStartArgsRequiredField5: str = "cli_overrides"
fn InProcessStartArgsRequiredFields(): str =
    return "client_name,client_version,arg0_paths,config,cli_overrides"

fn RustCsgValidateInProcessStartArgs(clientName: str, clientVersion: str,
                                      arg0PathsOk: bool, configOk: bool,
                                      cliOverridesOk: bool): str =
    # Simple validation - returns empty string when all required fields are present.
    if clientName == "": return "client_name"
    if clientVersion == "": return "client_version"
    if !arg0PathsOk: return "arg0_paths"
    if !configOk: return "config"
    if !cliOverridesOk: return "cli_overrides"
    return ""

fn RustCsgIsInProcessStartArgsValid(clientName: str, clientVersion: str,
                                     arg0PathsOk: bool, configOk: bool,
                                     cliOverridesOk: bool): bool =
    return RustCsgValidateInProcessStartArgs(clientName, clientVersion,
        arg0PathsOk, configOk, cliOverridesOk) == ""

# ── ClientCommand dispatch ───────────────────────────────────────────────
#
# Returns the canonical name for a ClientCommand variant.

fn RustCsgClientCommandName(variant: str): str =
    if variant == "Request":
        return "client_request"
    elif variant == "Notify":
        return "client_notify"
    elif variant == "ResolveServerRequest":
        return "resolve_server_request"
    elif variant == "RejectServerRequest":
        return "reject_server_request"
    elif variant == "Shutdown":
        return "shutdown"
    return "unknown"

# ── ForwardEventResult classification ────────────────────────────────────

fn RustCsgIsForwardContinue(variant: str): bool =
    return variant == "Continue"

fn RustCsgIsForwardDisableStream(variant: str): bool =
    return variant == "DisableStream"
