const RustCsgAppServerEventVariant1: str = "ServerNotification"
const RustCsgAppServerEventVariant2: str = "ServerRequest"
const RustCsgAppServerEventVariant3: str = "Disconnected"
fn AppServerEventVariantNames(): str = return "ServerNotification,ServerRequest,Disconnected"

