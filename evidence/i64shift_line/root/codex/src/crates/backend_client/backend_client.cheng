# ── Auth header builder ─────────────────────────────────────────────────

fn buildAuthHeader(token: str): str =
    return strings.ConcatStr("Bearer ", token)

# ── validateEndpoint: validates a backend endpoint URL format ──────────────
# Checks that the URL starts with "http://" or "https://" and has
# a minimum length (scheme + "://" + at least 1 char).
# Returns true if the URL format is valid.

fn validateEndpoint(url: str): bool =
      if url.len == 0:
            return false
      # Must start with "http://" (7 chars) or "https://" (8 chars) and have content after
      if strutl.StartsWith(url, "https://"):
            return url.len > 8
      if strutl.StartsWith(url, "http://"):
            return url.len > 7
      return false

# ── backendClientBuildRequest: constructs an HTTP request JSON ───────────────
# Builds a JSON object with method, path, and body fields for an HTTP request.
# method: HTTP method string (e.g. "GET", "POST", "PUT", "DELETE").
# path: URL path string (e.g. "/api/tasks/task_abc").
# body: JSON body string, empty string means no body field is included.
# Returns a JSON string like {"method":"GET","path":"/api/tasks"}.

fn backendClientBuildRequest(method: str, path: str, body: str): str =
    var out: str = "{"
    out = strings.ConcatStr(out, strings.ConcatStr(strings.ConcatStr("\"method\":\"", method), "\""))
    out = strings.ConcatStr(out, ",")
    out = strings.ConcatStr(out, strings.ConcatStr(strings.ConcatStr("\"path\":\"", path), "\""))
    if body.len > 0:
        out = strings.ConcatStr(out, ",")
        out = strings.ConcatStr(out, strings.ConcatStr(strings.ConcatStr("\"body\":", body), ""))
    out = strings.ConcatStr(out, "}")
    return out
