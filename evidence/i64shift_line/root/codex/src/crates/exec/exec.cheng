# Exec — execution plan builder
#
# Ported from codex-rs/exec/src/lib.rs
# Constructs an execution plan with command, args, and working directory.
# The plan is a self-contained JSON representation of what `codex exec`
# should execute.

import std/strutils as strutil

type
    RustCsgExecCratePlan =
        command: str
        prompt: str
        resumeSessionId: str
        resumeLast: bool
        model: str
        cwd: str
        json: bool
        skipGitRepoCheck: bool
        parseError: str

fn RustCsgExecCratePlanDefault(): RustCsgExecCratePlan =
    var result: RustCsgExecCratePlan
    result.command = "run"
    return result

fn RustCsgExecCrateSetParseError(plan: var RustCsgExecCratePlan, message: str) =
    if plan.parseError == "":
        plan.parseError = message

fn RustCsgExecCrateIsFlag(arg: str): bool =
    if arg.len < 2:
        return false
    return arg[0] == '-'

fn RustCsgExecCrateHasPrefix(text: str, prefix: str): bool =
    if text.len < prefix.len:
        return false
    for i in 0..<prefix.len:
        if text[i] != prefix[i]:
            return false
    return true

fn RustCsgExecCrateInlineValue(arg: str, key: str): str =
    # NOTE: cold-path limitation — strutil.sliceStr (substring extraction)
    # uses rawmem_support/NewStringCopy which is not available in the cold
    # compilation path.  Inline values (e.g. --model=gpt-5) are not supported.
    # Use --model gpt-5 (space-separated) instead.
    return ""

fn RustCsgExecCrateReadValue(args: str[], index: int32, key: str, outValue: var str, outNextIndex: var int32): bool =
    outValue = ""
    outNextIndex = index
    let arg = args[index]
    let inline = RustCsgExecCrateInlineValue(arg, key)
    if inline != "":
        outValue = inline
        return true
    if arg != key:
        return false
    let valueIndex = index + 1
    if valueIndex >= args.len:
        return true
    if RustCsgExecCrateIsFlag(args[valueIndex]):
        return true
    outValue = args[valueIndex]
    outNextIndex = valueIndex
    return true

# Build an execution plan from an explicit command, argument list, and cwd.
#
# command: the subcommand ("run", "resume", or "review")
# args: the full argument list (argv), may start with program name
# cwd: explicit working directory override (empty means use args or default)
#
# Returns a JSON plan string with all parsed fields.
fn RustCsgBuildExecPlan(command: str, args: str[], cwd: str): str =
    var plan = RustCsgExecCratePlanDefault()
    if command != "":
        plan.command = command

    var index: int32
    if args.len > 0:
        index = 1
    if index < args.len && args[index] == "exec":
        index = index + 1

    var stopOptions: bool
    while index < args.len:
        let arg = args[index]
        if !stopOptions && arg == "--":
            break
        if !stopOptions && RustCsgExecCrateIsFlag(arg):
            var value: str
            var nextIndex: int32
            if RustCsgExecCrateReadValue(args, index, "--model", value, nextIndex) ||
               RustCsgExecCrateReadValue(args, index, "-m", value, nextIndex):
                if value == "":
                    RustCsgExecCrateSetParseError(plan, "--model requires a value")
                plan.model = value
                index = nextIndex + 1
                continue
            if RustCsgExecCrateReadValue(args, index, "--cd", value, nextIndex) ||
               RustCsgExecCrateReadValue(args, index, "-C", value, nextIndex):
                if value == "":
                    RustCsgExecCrateSetParseError(plan, "--cd requires a value")
                if plan.cwd == "":
                    plan.cwd = value
                index = nextIndex + 1
                continue
            if arg == "--json" || arg == "--experimental-json":
                plan.json = true
                index = index + 1
                continue
            if arg == "--skip-git-repo-check":
                plan.skipGitRepoCheck = true
                index = index + 1
                continue
            if arg == "--last":
                plan.resumeLast = true
                index = index + 1
                continue
            RustCsgExecCrateSetParseError(plan, strings.ConcatStr("unknown flag: ", arg))
            index = index + 1
            continue
        if (arg == "resume" || arg == "review") && plan.command == arg:
            index = index + 1
            continue
        if plan.command == "run":
            if arg == "resume":
                plan.command = "resume"
                index = index + 1
                continue
            if arg == "review":
                plan.command = "review"
                index = index + 1
                continue
        if plan.command == "resume" && plan.resumeSessionId == "" && plan.prompt == "" && !plan.resumeLast:
            plan.resumeSessionId = arg
            index = index + 1
            continue
        if plan.prompt == "":
            plan.prompt = arg
            index = index + 1
            continue
        RustCsgExecCrateSetParseError(plan, strings.ConcatStr("unexpected arg: ", arg))
        index = index + 1

    if cwd != "":
        plan.cwd = cwd

    return RustCsgExecCratePlanToJson(plan)

fn RustCsgExecCrateJsonEscape(value: str): str =
    # NOTE: cold-path limitation — strutil.replace uses charToStr which is
    # not available in the cold compilation path.  This function relies on
    # values not containing JSON-significant control characters.  For the
    # model-name / cwd / session-id inputs used in practice this is safe.
    return strings.ConcatStr(strings.ConcatStr("\"", value), "\"")

fn RustCsgExecCratePlanToJson(plan: RustCsgExecCratePlan): str =
    var parts: str[]
    add(parts, strings.ConcatStr("\"command\":", RustCsgExecCrateJsonEscape(plan.command)))
    if plan.prompt != "":
        add(parts, strings.ConcatStr("\"prompt\":", RustCsgExecCrateJsonEscape(plan.prompt)))
    if plan.resumeSessionId != "":
        add(parts, strings.ConcatStr("\"resumeSessionId\":", RustCsgExecCrateJsonEscape(plan.resumeSessionId)))
    if plan.resumeLast:
        add(parts, "\"resumeLast\":true")
    if plan.model != "":
        add(parts, strings.ConcatStr("\"model\":", RustCsgExecCrateJsonEscape(plan.model)))
    if plan.cwd != "":
        add(parts, strings.ConcatStr("\"cwd\":", RustCsgExecCrateJsonEscape(plan.cwd)))
    if plan.json:
        add(parts, "\"json\":true")
    if plan.skipGitRepoCheck:
        add(parts, "\"skipGitRepoCheck\":true")
    if plan.parseError != "":
        add(parts, strings.ConcatStr("\"parseError\":", RustCsgExecCrateJsonEscape(plan.parseError)))
    var innerJson: str
    var pj: int32 = 0
    while pj < parts.len:
        if pj > 0: innerJson = strings.ConcatStr(innerJson, ",")
        innerJson = strings.ConcatStr(innerJson, parts[pj])
        pj = pj + 1
    return strings.ConcatStr(strings.ConcatStr("{", innerJson), "}")

# ── Public API ────────────────────────────────────────────────────────

fn execPlanToJson(plan: RustCsgExecCratePlan): str =
    return RustCsgExecCratePlanToJson(plan)

fn execValidatePlan(plan: RustCsgExecCratePlan): str =
    if plan.command == "":
        return "command is required"
    if plan.parseError != "":
        return strings.ConcatStr("plan has parse error: ", plan.parseError)
    if plan.command == "run" && plan.prompt == "":
        return "prompt is required for run command"
    return ""

# Convert an exec plan to a command line string representation.
# Returns a string like "codex exec --model gpt-5 --cd /workspace Fix the bug"
fn execPlanToCommandLine(plan: RustCsgExecCratePlan): str =
    var parts: str[]
    add(parts, "codex")
    add(parts, plan.command)
    if plan.model != "":
        add(parts, "--model")
        add(parts, plan.model)
    if plan.cwd != "":
        add(parts, "--cd")
        add(parts, plan.cwd)
    if plan.json:
        add(parts, "--json")
    if plan.skipGitRepoCheck:
        add(parts, "--skip-git-repo-check")
    if plan.resumeSessionId != "":
        add(parts, plan.resumeSessionId)
    elif plan.resumeLast:
        add(parts, "--last")
    if plan.prompt != "":
        add(parts, plan.prompt)
    var cmdLine: str
    var cli: int32 = 0
    while cli < parts.len:
        if cli > 0: cmdLine = strings.ConcatStr(cmdLine, " ")
        cmdLine = strings.ConcatStr(cmdLine, parts[cli])
        cli = cli + 1
    return cmdLine

# Estimate resource usage for an exec plan based on its fields.
# Returns JSON: {"cpu":"low|medium|high","memoryMb":N,"priority":"normal|high"}
fn execEstimateResourceUsage(plan: RustCsgExecCratePlan): str =
    var cpu: str = "low"
    var memoryMb: int = 256
    var priority: str = "normal"
    # Model-based estimation
    let model: str = plan.model
    if model != "":
        if strutil.Contains(model, "opus") || strutil.Contains(model, "sonnet") || strutil.Contains(model, "gpt-4") || strutil.Contains(model, "claude-3.5") || strutil.Contains(model, "claude-4"):
            cpu = "high"
            memoryMb = 1024
            priority = "high"
        elif strutil.Contains(model, "haiku") || strutil.Contains(model, "gpt-4o-mini") || strutil.Contains(model, "gpt-5-mini"):
            cpu = "low"
            memoryMb = 256
        else:
            cpu = "medium"
            memoryMb = 512
    # Command-based adjustments
    if plan.command == "review":
        if memoryMb < 1024:
            memoryMb = 1024
    if plan.resumeSessionId != "" || plan.resumeLast:
        priority = "high"
        if memoryMb < 512:
            memoryMb = 512
    # JSON output needs more memory
    if plan.json:
        memoryMb = memoryMb + 128
    return strings.ConcatStr(strings.ConcatStr(strings.ConcatStr(strings.ConcatStr(strings.ConcatStr(strings.ConcatStr("{\"cpu\":\"", cpu), "\",\"memoryMb\":"), strings.Int64ToStr(int64(memoryMb))), ",\"priority\":\""), priority), "\"}")
