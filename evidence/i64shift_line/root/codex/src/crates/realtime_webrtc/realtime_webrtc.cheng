# realtime-webrtc: WebRTC audio session management.
# Ported from codex-rs/realtime-webrtc
#
# Production functions:
#   buildSdpOffer(sessionId) — construct a basic SDP offer for WebRTC

import std/strutils as strutil
import std/strings

# Type names
const RealtimeWebrtcSessionType: str = "RealtimeWebrtcSession"
const RealtimeWebrtcStartedSessionType: str = "StartedRealtimeWebrtcSession"
const RealtimeWebrtcSessionHandleType: str = "RealtimeWebrtcSessionHandle"

# Event variant names
const RealtimeWebrtcConnectedEvent: str = "Connected"
const RealtimeWebrtcLocalAudioLevelEvent: str = "LocalAudioLevel"
const RealtimeWebrtcClosedEvent: str = "Closed"
const RealtimeWebrtcFailedEvent: str = "Failed"

# Error variant name
const RealtimeWebrtcUnsupportedPlatform: str = "UnsupportedPlatform"

# Key function names
const RealtimeWebrtcStartFn: str = "start"
const RealtimeWebrtcApplyAnswerSdpFn: str = "apply_answer_sdp"
const RealtimeWebrtcCloseFn: str = "close"

fn RealtimeWebrtcBuildSdpOffer(sessionId: str): str =
    if sessionId == "":
        return "v=0\no=-  2 IN IP4 127.0.0.1\ns=-\nt=0 0"
    return strutil.Join([
        "v=0",
        strutil.Join(["o=- ", sessionId, " 2 IN IP4 127.0.0.1"], ""),
        "s=-",
        "t=0 0"
    ], "\n")

# ── webrtcParseSdp ────────────────────────────────────────────────────────
# Parse an SDP string and extract media section descriptions.
# Each media section starts with an "m=" line and includes all subsequent
# lines until the next "m=" line or end of SDP.
# Returns an array of strings, each being an "m=" line describing a media
# section (e.g. "m=audio 9 UDP/TLS/RTP/SAVPF 0 1").
# Returns an empty array if no media sections are found.
fn RealtimeWebrtcParseSdp(sdp: str): str[] =
    var out: str[]
    if sdp.len == 0:
        return out

    # Split by newlines and look for lines starting with "m="
    var i: int32 = 0
    while i < sdp.len:
        # Check if line starts with "m="
        if sdp[i] == 'm' && i + 1 < sdp.len && sdp[i + 1] == '=':
            # Extract the full "m=" line
            var lineStart: int32 = i
            var lineEnd: int32 = i
            while lineEnd < sdp.len && sdp[lineEnd] != '\n':
                lineEnd = lineEnd + 1
            let mLine: str = strings.SliceBytes(sdp, lineStart, lineEnd - lineStart)
            add(out, mLine)
            i = lineEnd
        else:
            i = i + 1

    return out
