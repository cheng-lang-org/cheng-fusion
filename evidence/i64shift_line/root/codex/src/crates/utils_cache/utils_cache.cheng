# utils/cache — re-exports the LRU cache and SHA1 digest primitives
#
# Core: LRU cache backed by parallel arrays + SHA1 from std/sha1.

import cheng/codex/crates/lru_cache/lru_cache as lru

# ── LRU Cache (re-exported from lru_cache) ───────────────────────────

fn lruCacheNew(capacity: int32): int32 =
    return lru.lruCacheNew(capacity)

fn lruCachePut(handle: int32, key: str, value: str, outEvictedKey: var str, outOk: var bool) =
    lru.lruCachePut(handle, key, value, outEvictedKey, outOk)

fn lruCacheGet(handle: int32, key: str, outValue: var str, outOk: var bool) =
    lru.lruCacheGet(handle, key, outValue, outOk)

fn lruCacheRemove(handle: int32, key: str, outOk: var bool) =
    lru.lruCacheRemove(handle, key, outOk)

fn lruCacheClear(handle: int32) =
    lru.lruCacheClear(handle)

fn RustCsgUtilsCacheNew(capacity: int32): int32 =
    return lruCacheNew(capacity)

fn RustCsgUtilsCachePut(handle: int32, key: str, value: str, outEvictedKey: var str, outOk: var bool) =
    lruCachePut(handle, key, value, outEvictedKey, outOk)

fn RustCsgUtilsCacheGet(handle: int32, key: str, outValue: var str, outOk: var bool) =
    lruCacheGet(handle, key, outValue, outOk)

fn RustCsgUtilsCacheRemove(handle: int32, key: str, outOk: var bool) =
    lruCacheRemove(handle, key, outOk)

fn RustCsgUtilsCacheClear(handle: int32) =
    lruCacheClear(handle)
