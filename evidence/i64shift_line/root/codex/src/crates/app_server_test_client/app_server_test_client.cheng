# App Server Test Client — type definition constants
#
# Ported from codex-rs/app-server-test-client/src/lib.rs
# Covers: notification opt-out list, timeout constants, CLI command variants,
#         ClientTransport, CommandApprovalBehavior, TraceSummary

# ── Notification opt-out list ────────────────────────────────────────────

const RustCsgNotificationsToOptOutCount: int32 = 6
const RustCsgNotificationsToOptOut1: str = "command/exec/outputDelta"
const RustCsgNotificationsToOptOut2: str = "item/agentMessage/delta"
const RustCsgNotificationsToOptOut3: str = "item/plan/delta"
const RustCsgNotificationsToOptOut4: str = "item/fileChange/outputDelta"
const RustCsgNotificationsToOptOut5: str = "item/reasoning/summaryTextDelta"
const RustCsgNotificationsToOptOut6: str = "item/reasoning/textDelta"
fn NotificationsToOptOutList(): str =
    return "command/exec/outputDelta,item/agentMessage/delta,item/plan/delta,item/fileChange/outputDelta,item/reasoning/summaryTextDelta,item/reasoning/textDelta"

# ── Timeout and config constants ─────────────────────────────────────────

const RustCsgAppServerGracefulShutdownTimeoutSec: int32 = 5
const RustCsgAppServerGracefulShutdownPollIntervalMs: int32 = 100
const RustCsgDefaultAnalyticsEnabled: bool = true
const RustCsgOtelServiceName: str = "codex-app-server-test-client"
const RustCsgTraceDisabledMessage: str = "Not enabled - enable tracing in $CODEX_HOME/config.toml to get a trace URL!"

