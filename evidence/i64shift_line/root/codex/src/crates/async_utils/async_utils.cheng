fn asyncUtilsIsCancelled(cancelToken: bool): bool =
    return cancelToken

fn asyncUtilsOrCancel(value: int32, cancelToken: bool, outCancelled: var bool): int32 =
    outCancelled = cancelToken
    if cancelToken:
        return 0
    return value

fn asyncUtilsOrCancelStr(value: str, cancelToken: bool, outCancelled: var bool): str =
    outCancelled = cancelToken
    if cancelToken:
        return ""
    return value

fn asyncUtilsOrCancelBool(value: bool, cancelToken: bool, outCancelled: var bool): bool =
    outCancelled = cancelToken
    if cancelToken:
        return false
    return value

fn asyncUtilsRace(valueA: int32, readyA: bool, valueB: int32, readyB: bool, outReady: var bool): int32 =
    if readyA:
        outReady = true
        return valueA
    if readyB:
        outReady = true
        return valueB
    outReady = false
    return 0

fn asyncUtilsIsTimeout(currentTimeMs: int32, deadlineMs: int32): bool =
    return currentTimeMs >= deadlineMs

fn asyncUtilsWithTimeout(value: int32, currentTimeMs: int32, deadlineMs: int32, outCancelled: var bool): int32 =
    outCancelled = currentTimeMs >= deadlineMs
    if outCancelled:
        return 0
    return value

const AsyncUtilsMaxSequence: int32 = 32

type
    AsyncUtilsSequence =
        stepResults: int32[AsyncUtilsMaxSequence]
        stepCount: int32
        cancelledAt: int32

fn asyncUtilsSequenceInit(): AsyncUtilsSequence =
    var s: AsyncUtilsSequence
    s.stepCount = 0
    s.cancelledAt = -1
    return s

fn asyncUtilsSequenceAdd(s: var AsyncUtilsSequence, value: int32, cancelToken: bool) =
    if s.cancelledAt >= 0:
        return
    if s.stepCount >= AsyncUtilsMaxSequence:
        return
    if cancelToken:
        s.cancelledAt = s.stepCount
        return
    s.stepResults[s.stepCount] = value
    s.stepCount = s.stepCount + 1

fn asyncUtilsSequenceAllOk(s: var AsyncUtilsSequence): bool =
    return s.cancelledAt < 0

fn asyncUtilsSequenceCancelledAt(s: var AsyncUtilsSequence): int32 =
    return s.cancelledAt
