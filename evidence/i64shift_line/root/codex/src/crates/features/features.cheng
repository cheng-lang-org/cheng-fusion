fn RustCsgFeaturesPadRight(value: str, width: int32): str =
    var out = value
    while out.len < width:
        out = strings.ConcatStr(out, " ")
    return out

fn RustCsgFeaturesBoolText(value: bool): str =
    if value:
        return "true"
    return "false"

fn RustCsgFeatureCanonicalKnown(key: str): bool =
    let rows = RustCsgFeatureRows()
    for i in 0..<rows.len:
        if rows[i].key == key:
            return true
    return false

fn RustCsgFeatureKnown(key: str): bool =
    if RustCsgFeatureCanonicalKnown(key):
        return true
    return key == "connectors" ||
           key == "enable_experimental_windows_sandbox" ||
           key == "experimental_use_unified_exec_tool" ||
           key == "experimental_use_freeform_apply_patch" ||
           key == "include_apply_patch_tool" ||
           key == "request_permissions" ||
           key == "web_search" ||
           key == "collab" ||
           key == "memory_tool"

fn RustCsgFeatureCanonicalDefaultFalse(key: str): bool =
    let rows = RustCsgFeatureRows()
    for i in 0..<rows.len:
        if rows[i].key == key:
            return !rows[i].enabled
    return false

fn RustCsgFeatureUnderDevelopment(key: str): bool =
    let rows = RustCsgFeatureRows()
    for i in 0..<rows.len:
        if rows[i].key == key:
            return rows[i].stage == "under development"
    return false

fn RustCsgFeaturesTomlLineIsAnySection(line: str): bool =
    var pos: int32
    while pos < line.len && (line[pos] == ' ' || line[pos] == '\t'):
        pos = pos + 1
    return pos < line.len && line[pos] == '['

fn RustCsgFeaturesTomlLineIsSection(line: str, section: str): bool =
    var pos: int32
    while pos < line.len && (line[pos] == ' ' || line[pos] == '\t'):
        pos = pos + 1
    var endPos: int32 = line.len
    while endPos > pos && (line[endPos - 1] == ' ' || line[endPos - 1] == '\t' || line[endPos - 1] == '\r'):
        endPos = endPos - 1
    if endPos - pos != section.len + 2:
        return false
    if line[pos] != '[' || line[endPos - 1] != ']':
        return false
    return strings.SliceBytes(line, pos + 1, section.len) == section

fn RustCsgFeaturesTomlLineMatchesBareKey(line: str, key: str): bool =
    var pos: int32
    while pos < line.len && (line[pos] == ' ' || line[pos] == '\t'):
        pos = pos + 1
    if pos >= line.len || line[pos] == '[' || line[pos] == '#':
        return false
    let trimmed = strings.SliceBytes(line, pos, line.len - pos)
    if trimmed.len <= key.len:
        return false
    if strings.SliceBytes(trimmed, 0, key.len) != key:
        return false
    var afterKey: int32 = key.len
    while afterKey < trimmed.len && (trimmed[afterKey] == ' ' || trimmed[afterKey] == '\t'):
        afterKey = afterKey + 1
    return afterKey < trimmed.len && trimmed[afterKey] == '='

fn RustCsgFeaturesTomlBareKeyBoolValue(line: str, key: str, outValue: var bool): bool =
    if !RustCsgFeaturesTomlLineMatchesBareKey(line, key):
        return false
    var pos: int32
    while pos < line.len && line[pos] != '=':
        pos = pos + 1
    if pos >= line.len:
        return false
    pos = pos + 1
    while pos < line.len && (line[pos] == ' ' || line[pos] == '\t'):
        pos = pos + 1
    if pos + 4 <= line.len && strings.SliceBytes(line, pos, 4) == "true":
        outValue = true
        return true
    if pos + 5 <= line.len && strings.SliceBytes(line, pos, 5) == "false":
        outValue = false
        return true
    return false

fn RustCsgFeaturesConfigBool(content: str, key: str, outValue: var bool): bool =
    if content == "":
        return false
    var inSection: bool
    var i: int32
    var lineStart: int32
    while i < content.len:
        if content[i] == '\n':
            let line = strings.SliceBytes(content, lineStart, i - lineStart)
            if RustCsgFeaturesTomlLineIsAnySection(line):
                inSection = RustCsgFeaturesTomlLineIsSection(line, "features")
            elif inSection && RustCsgFeaturesTomlBareKeyBoolValue(line, key, outValue):
                return true
            i = i + 1
            lineStart = i
            continue
        i = i + 1
    if lineStart < content.len:
        let line = strings.SliceBytes(content, lineStart, content.len - lineStart)
        if RustCsgFeaturesTomlLineIsAnySection(line):
            inSection = RustCsgFeaturesTomlLineIsSection(line, "features")
        elif inSection && RustCsgFeaturesTomlBareKeyBoolValue(line, key, outValue):
            return true
    return false

fn RustCsgFeaturesConfigBoolWithAliases(content: str, key: str, outValue: var bool): bool =
    if RustCsgFeaturesConfigBool(content, key, outValue):
        return true
    if key == "apps":
        return RustCsgFeaturesConfigBool(content, "connectors", outValue)
    if key == "experimental_windows_sandbox":
        return RustCsgFeaturesConfigBool(content, "enable_experimental_windows_sandbox", outValue)
    if key == "unified_exec":
        return RustCsgFeaturesConfigBool(content, "experimental_use_unified_exec_tool", outValue)
    if key == "apply_patch_freeform":
        if RustCsgFeaturesConfigBool(content, "experimental_use_freeform_apply_patch", outValue):
            return true
        return RustCsgFeaturesConfigBool(content, "include_apply_patch_tool", outValue)
    if key == "exec_permission_approvals":
        return RustCsgFeaturesConfigBool(content, "request_permissions", outValue)
    if key == "web_search_request":
        return RustCsgFeaturesConfigBool(content, "web_search", outValue)
    if key == "multi_agent":
        return RustCsgFeaturesConfigBool(content, "collab", outValue)
    if key == "memories":
        return RustCsgFeaturesConfigBool(content, "memory_tool", outValue)
    return false

fn RustCsgFeaturesEnabledFromConfig(content: str, key: str, defaultEnabled: bool): bool =
    var enabled = defaultEnabled
    var configured: bool
    if RustCsgFeaturesConfigBoolWithAliases(content, key, configured):
        enabled = configured
    if key == "code_mode":
        var codeModeOnly: bool
        if RustCsgFeaturesConfigBoolWithAliases(content, "code_mode_only", codeModeOnly) && codeModeOnly:
            enabled = true
    if key == "multi_agent":
        var enableFanout: bool
        if RustCsgFeaturesConfigBoolWithAliases(content, "enable_fanout", enableFanout) && enableFanout:
            enabled = true
    return enabled

fn RustCsgFeaturesListText(): str =
    let rows = RustCsgFeatureRows()
    var lines: str[]
    for i in 0..<rows.len:
        var line = RustCsgFeaturesPadRight(rows[i].key, 31)
        line = strings.ConcatStr(line, "  ")
        line = strings.ConcatStr(line, RustCsgFeaturesPadRight(rows[i].stage, 17))
        line = strings.ConcatStr(line, "  ")
        line = strings.ConcatStr(line, RustCsgFeaturesBoolText(rows[i].enabled))
        add(lines, line)
    return strutil.Join(lines, "\n")

fn RustCsgFeaturesListTextWithConfig(configToml: str): str =
    let rows = RustCsgFeatureRows()
    var lines: str[]
    for i in 0..<rows.len:
        let enabled = RustCsgFeaturesEnabledFromConfig(configToml, rows[i].key, rows[i].enabled)
        var line = RustCsgFeaturesPadRight(rows[i].key, 31)
        line = strings.ConcatStr(line, "  ")
        line = strings.ConcatStr(line, RustCsgFeaturesPadRight(rows[i].stage, 17))
        line = strings.ConcatStr(line, "  ")
        line = strings.ConcatStr(line, RustCsgFeaturesBoolText(enabled))
        add(lines, line)
    return strutil.Join(lines, "\n")
