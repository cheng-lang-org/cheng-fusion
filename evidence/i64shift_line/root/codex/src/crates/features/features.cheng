import std/strings
import std/strutils as strutil

# ── Feature Flags System (port of codex-rs/features, int64 bitmask) ──

type
    RustCsgFeatureRow =
        key: str
        stage: str
        enabled: bool

const F_SHELL_TOOL: int64 = 1
const F_CODEX_HOOKS: int64 = 2
const F_CODE_MODE: int64 = 4
const F_CODE_MODE_ONLY: int64 = 8
const F_WEB_SEARCH_REQ: int64 = 16
const F_COLLAB: int64 = 32
const F_SPAWN_CSV: int64 = 64
const F_MULTI_AGENT_V2: int64 = 128
const F_APPS: int64 = 256
const F_NETWORK_PROXY: int64 = 512
const F_MEMORY_TOOL: int64 = 1024
const F_PLUGINS: int64 = 2048
const F_LEGACY_LANDLOCK: int64 = 4096
const F_COUNT: int32 = 13

fn bitForKey(key: str): int64 =
    if key == "shell_tool":
        return F_SHELL_TOOL
    if key == "hooks":
        return F_CODEX_HOOKS
    if key == "code_mode":
        return F_CODE_MODE
    if key == "code_mode_only":
        return F_CODE_MODE_ONLY
    if key == "web_search_request":
        return F_WEB_SEARCH_REQ
    if key == "multi_agent":
        return F_COLLAB
    if key == "enable_fanout":
        return F_SPAWN_CSV
    if key == "multi_agent_v2":
        return F_MULTI_AGENT_V2
    if key == "apps":
        return F_APPS
    if key == "network_proxy":
        return F_NETWORK_PROXY
    if key == "memories":
        return F_MEMORY_TOOL
    if key == "plugins":
        return F_PLUGINS
    if key == "use_legacy_landlock":
        return F_LEGACY_LANDLOCK
    return 0

fn keyForBit(bit: int64): str =
    if bit == F_SHELL_TOOL:
        return "shell_tool"
    if bit == F_CODEX_HOOKS:
        return "hooks"
    if bit == F_CODE_MODE:
        return "code_mode"
    if bit == F_CODE_MODE_ONLY:
        return "code_mode_only"
    if bit == F_WEB_SEARCH_REQ:
        return "web_search_request"
    if bit == F_COLLAB:
        return "multi_agent"
    if bit == F_SPAWN_CSV:
        return "enable_fanout"
    if bit == F_MULTI_AGENT_V2:
        return "multi_agent_v2"
    if bit == F_APPS:
        return "apps"
    if bit == F_NETWORK_PROXY:
        return "network_proxy"
    if bit == F_MEMORY_TOOL:
        return "memories"
    if bit == F_PLUGINS:
        return "plugins"
    if bit == F_LEGACY_LANDLOCK:
        return "use_legacy_landlock"
    return ""

fn defaultsMask(): int64 =
    return F_SHELL_TOOL | F_CODEX_HOOKS | F_COLLAB | F_APPS | F_PLUGINS

fn isEnabled(features: int64, featureBit: int64): bool =
    return (features & featureBit) != 0

fn enable(features: var int64, featureBit: int64) =
    features = features | featureBit

fn disable(features: var int64, featureBit: int64) =
    if isEnabled(features, featureBit):
        features = features ^ featureBit

fn withDefaults(): int64 =
    return defaultsMask()

fn countEnabled(features: int64): int32 =
    var count: int32 = 0
    var bits: int64 = features
    while bits != 0:
        bits = bits & (bits - 1)
        count = count + 1
    return count

fn fromSources(sources: str): int64 =
    var result: int64 = defaultsMask()
    let trimmed = strutil.Strip(sources)
    if trimmed.len == 0:
        return result
    let tokens = strutil.Split(trimmed, ',')
    for i in 0..<tokens.len:
        let token = strutil.Strip(tokens[i])
        if token.len == 0:
            continue
        var bit: int64 = 0
        var enableFlag: bool = true
        if strutil.StartsWith(token, "enable:"):
            let key = strutil.Strip(strings.SliceBytes(token, 7, token.len - 7))
            bit = bitForKey(key)
        else:
            if strutil.StartsWith(token, "disable:"):
                let key = strutil.Strip(strings.SliceBytes(token, 8, token.len - 8))
                bit = bitForKey(key)
                enableFlag = false
            else:
                if strutil.StartsWith(token, "+"):
                    let key = strutil.Strip(strings.SliceBytes(token, 1, token.len - 1))
                    bit = bitForKey(key)
                else:
                    if strutil.StartsWith(token, "-"):
                        let key = strutil.Strip(strings.SliceBytes(token, 1, token.len - 1))
                        bit = bitForKey(key)
                        enableFlag = false
                    else:
                        bit = bitForKey(token)
        if bit != 0:
            if enableFlag:
                result = result | bit
            else:
                if isEnabled(result, bit):
                    result = result ^ bit
    return result

fn normalizeDependencies(features: var int64) =
    if isEnabled(features, F_SPAWN_CSV) && !isEnabled(features, F_COLLAB):
        enable(features, F_COLLAB)
    if isEnabled(features, F_CODE_MODE_ONLY) && !isEnabled(features, F_CODE_MODE):
        enable(features, F_CODE_MODE)

# ── featureDependencies ─────────────────────────────────────────────────────
# Return dependency feature bits for a given feature bit.
# If featureBit depends on other features, returns their bits OR'd together.
fn featureDependencies(featureBit: int64): int64 =
    if featureBit == F_SPAWN_CSV:
        return F_COLLAB
    if featureBit == F_CODE_MODE_ONLY:
        return F_CODE_MODE
    return 0

# ── featureConflicts ────────────────────────────────────────────────────────
# Return conflicting feature bits for a given feature bit.
# Returns 0 if no conflicts are defined.
fn featureConflicts(featureBit: int64): int64 =
    return 0

fn RustCsgFeaturesAddRow(rows: var RustCsgFeatureRow[], key: str, stage: str, enabled: bool) =
    var row = RustCsgFeatureRow(key: key, stage: stage, enabled: enabled)
    add(rows, row)

