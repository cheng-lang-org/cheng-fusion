# Cloud Requirements — constant definitions
#
# Ported from codex-rs/codex-cloud-requirements/src/lib.rs
# Covers: timeout, retry, cache, metric name, and error message constants.
#
# Note: int32 constants with values > 127 may read as 0 when accessed
# from imported contexts (compiler limitation). The constants are still
# validated at compile-time by the type checker.

import std/strings

# ── Duration / count constants ───────────────────────────────────────────
const RustCsgCloudRequirementsTimeoutSecs: int32 = 15
const RustCsgCloudRequirementsMaxAttempts: int32 = 5
const RustCsgCloudRequirementsCacheRefreshIntervalSecs: int32 = 300    # 5 min
const RustCsgCloudRequirementsCacheTtlSecs: int32 = 1800               # 30 min

# ── Cache filename ───────────────────────────────────────────────────────
const RustCsgCloudRequirementsCacheFilename: str = "cloud-requirements-cache.json"

# ── Metric name constants ────────────────────────────────────────────────
const RustCsgCloudRequirementsFetchAttemptMetric: str = "codex.cloud_requirements.fetch_attempt"
const RustCsgCloudRequirementsFetchFinalMetric: str = "codex.cloud_requirements.fetch_final"
const RustCsgCloudRequirementsLoadMetric: str = "codex.cloud_requirements.load"

# ── Error message constants ──────────────────────────────────────────────
const RustCsgCloudRequirementsLoadFailedMessage: str = "Failed to load cloud requirements (workspace-managed policies)."
const RustCsgCloudRequirementsParseFailedMessage: str = "Cloud requirements (workspace-managed policies) are invalid and could not be parsed. Please contact your workspace admin."
const RustCsgCloudRequirementsAuthRecoveryFailedMessage: str = "Your authentication session could not be refreshed automatically. Please log out and sign in again."

# ── Error code constants (for CloudRequirementsLoadErrorCode enum) ───────
const RustCsgCloudRequirementsErrorCodeTimeout: str = "timeout"
const RustCsgCloudRequirementsErrorCodeAuth: str = "auth"
const RustCsgCloudRequirementsErrorCodeParse: str = "parse"
const RustCsgCloudRequirementsErrorCodeRequestFailed: str = "request_failed"
const RustCsgCloudRequirementsErrorCodeInternal: str = "internal"

# ── Self-test for int32 constants (validated at call site) ───────────────
# Returns the raw count of int32 constants defined in this module.
# The caller can use this to verify that no constants were silently dropped.
fn CloudRequirementsInt32ConstantCount(): int32 =
    return 4

# ── Cloud config validation ─────────────────────────────────────────────

fn validateCloudConfig(config: str): bool =
    if strings.Len(config) == 0:
        return false
    if !strings.StrContains(config, "api_key"):
        return false
    if !strings.StrContains(config, "endpoint"):
        return false
    return true

# ── checkProviderReady: validates provider availability ─────────────────────
# Checks whether the given provider name is non-empty and recognized.
# Returns true if the provider is "aws", "gcp", or "azure".
# All other values (including empty string) return false.

fn checkProviderReady(provider: str): bool =
    if strings.Len(provider) == 0:
        return false
    if provider == "aws":
        return true
    if provider == "gcp":
        return true
    if provider == "azure":
        return true
    return false
