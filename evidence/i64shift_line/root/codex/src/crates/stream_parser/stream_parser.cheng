import std/strings
import std/strutils as strutil

# ── Inline hidden-tag parser (core engine for citation extraction) ──

fn strFindAt(haystack: str, start: int32, needle: str, outPos: var int32, outFound: var bool) =
    outFound = false
    outPos = -1
    let n = haystack.len
    let m = needle.len
    if m == 0:
        outPos = start
        outFound = true
        return
    if start + m > n:
        return
    let limit = n - m
    var i: int32 = start
    while i <= limit:
        var mismatched: int32 = 0
        var j: int32 = 0
        while j < m:
            if haystack[i + j] != needle[j]:
                mismatched = 1
                break
            j = j + 1
        if mismatched == 0:
            outPos = i
            outFound = true
            return
        i = i + 1

fn strFind(haystack: str, needle: str, outPos: var int32, outFound: var bool) =
    outFound = false
    outPos = -1
    let n = haystack.len
    let m = needle.len
    if m == 0:
        outPos = 0
        outFound = true
        return
    if m > n:
        return
    let limit = n - m
    var i: int32 = 0
    while i <= limit:
        var mismatched: int32 = 0
        var j: int32 = 0
        while j < m:
            if haystack[i + j] != needle[j]:
                mismatched = 1
                break
            j = j + 1
        if mismatched == 0:
            outPos = i
            outFound = true
            return
        i = i + 1

fn longestSuffixPrefixLen(s: str, needle: str): int32 =
    let sLen = s.len
    let nLen = needle.len
    var maxCheck: int32 = sLen
    let nMinus1 = nLen - 1
    if nMinus1 < maxCheck:
        maxCheck = nMinus1
    var k: int32 = maxCheck
    while k >= 1:
        var mismatched: int32 = 0
        var j: int32 = 0
        while j < k:
            if s[sLen - k + j] != needle[j]:
                mismatched = 1
                break
            j = j + 1
        if mismatched == 0:
            return k
        k = k - 1
    return 0

fn findNextOpen(pending: str, specOpens: str[], outPos: var int32, outSpecIdx: var int32, outFound: var bool) =
    outFound = false
    outPos = -1
    outSpecIdx = -1
    var bestPos: int32 = -1
    var bestLen: int32 = -1
    var bestIdx: int32 = -1
    var i: int32 = 0
    while i < specOpens.len:
        let open = specOpens[i]
        var pos: int32
        var found: bool
        strFind(pending, open, pos, found)
        if found:
            if bestPos < 0:
                bestPos = pos
                bestLen = open.len
                bestIdx = i
            else:
                if pos < bestPos:
                    bestPos = pos
                    bestLen = open.len
                    bestIdx = i
                else:
                    if pos == bestPos && open.len > bestLen:
                        bestPos = pos
                        bestLen = open.len
                        bestIdx = i
        i = i + 1
    if bestPos >= 0:
        outPos = bestPos
        outSpecIdx = bestIdx
        outFound = true

fn maxOpenPrefixSuffixLen(pending: str, specOpens: str[]): int32 =
    var best: int32 = 0
    var i: int32 = 0
    while i < specOpens.len:
        let candidate = longestSuffixPrefixLen(pending, specOpens[i])
        if candidate > best:
            best = candidate
        i = i + 1
    return best

fn inlinePushStr(pending: var str, activeId: var int32, activeClose: var str, activeContent: var str,
                 specOpens: str[], specCloses: str[], chunk: str,
                 outVisible: var str, outExtracts: var str[]) =
    var localPend: str = strings.ConcatStr(pending, chunk)
    pending = localPend
    var localVis: str = ""
    var iter: int32 = 0
    while iter < 50:
        if activeId >= 0:
            var closePos: int32
            var closeFound: bool
            strFind(pending, activeClose, closePos, closeFound)
            if closeFound:
                let content = strings.SliceBytes(pending, 0, closePos)
                activeContent = strings.ConcatStr(activeContent, content)
                add(outExtracts, activeContent)
                let closeEnd = closePos + activeClose.len
                var tmpPend: str
                if closeEnd < pending.len:
                    tmpPend = strings.SliceBytes(pending, closeEnd, pending.len - closeEnd)
                else:
                    tmpPend = ""
                pending = tmpPend
                activeId = -1
                activeClose = ""
                activeContent = ""
                iter = 0
            else:
                let keep = longestSuffixPrefixLen(pending, activeClose)
                let take = pending.len - keep
                if take > 0:
                    let buf = strings.SliceBytes(pending, 0, take)
                    activeContent = strings.ConcatStr(activeContent, buf)
                    var tmpPend: str
                    if take < pending.len:
                        tmpPend = strings.SliceBytes(pending, take, pending.len - take)
                    else:
                        tmpPend = ""
                    pending = tmpPend
                break
        else:
            var openPos: int32
            var openIdx: int32
            var openFound: bool
            findNextOpen(pending, specOpens, openPos, openIdx, openFound)
            if openFound:
                if openPos > 0:
                    let visible = strings.SliceBytes(pending, 0, openPos)
                    localVis = strings.ConcatStr(localVis, visible)
                let open = specOpens[openIdx]
                let drainLen = openPos + open.len
                var tmpPend: str
                if drainLen < pending.len:
                    tmpPend = strings.SliceBytes(pending, drainLen, pending.len - drainLen)
                else:
                    tmpPend = ""
                pending = tmpPend
                activeId = openIdx
                activeClose = specCloses[openIdx]
                activeContent = ""
                iter = 0
            else:
                let keep = maxOpenPrefixSuffixLen(pending, specOpens)
                let take = pending.len - keep
                if take > 0:
                    let visible = strings.SliceBytes(pending, 0, take)
                    localVis = strings.ConcatStr(localVis, visible)
                    var tmpPend: str
                    if take < pending.len:
                        tmpPend = strings.SliceBytes(pending, take, pending.len - take)
                    else:
                        tmpPend = ""
                    pending = tmpPend
                break
        iter = iter + 1
    outVisible = localVis

fn inlineFinish(activeId: var int32, activeClose: var str, activeContent: var str,
                pending: var str, outVisible: var str, outExtracts: var str[]) =
    outVisible = ""
    if activeId >= 0:
        if pending != "":
            activeContent = strings.ConcatStr(activeContent, pending)
            pending = ""
        add(outExtracts, activeContent)
        activeId = -1
        activeClose = ""
        activeContent = ""
    else:
        if pending != "":
            outVisible = pending
            pending = ""

fn collectInline(specOpens: str[], specCloses: str[], chunks: str[],
                 outVisible: var str, outExtracts: var str[]) =
    var pending: str
    var activeId: int32 = -1
    var activeClose: str
    var activeContent: str
    outVisible = ""
    var i: int32 = 0
    while i < chunks.len:
        var chunkVis: str
        var chunkExt: str[]
        inlinePushStr(pending, activeId, activeClose, activeContent, specOpens, specCloses, chunks[i], chunkVis, chunkExt)
        outVisible = strings.ConcatStr(outVisible, chunkVis)
        var j: int32 = 0
        while j < chunkExt.len:
            add(outExtracts, chunkExt[j])
            j = j + 1
        i = i + 1
    var finVis: str
    var finExt: str[]
    inlineFinish(activeId, activeClose, activeContent, pending, finVis, finExt)
    outVisible = strings.ConcatStr(outVisible, finVis)
    var j: int32 = 0
    while j < finExt.len:
        add(outExtracts, finExt[j])
        j = j + 1

fn stripCitations(text: str, outCitations: var str[]): str =
    var specOpens: str[]
    add(specOpens, "<oai-mem-citation>")
    var specCloses: str[]
    add(specCloses, "</oai-mem-citation>")
    var pending: str
    var activeId: int32 = -1
    var activeClose: str
    var activeContent: str
    var vis: str
    var extracts: str[]
    inlinePushStr(pending, activeId, activeClose, activeContent, specOpens, specCloses, text, vis, extracts)
    var finVis: str
    var finExtracts: str[]
    inlineFinish(activeId, activeClose, activeContent, pending, finVis, finExtracts)
    var allVisible = strings.ConcatStr(vis, finVis)
    var i: int32 = 0
    while i < extracts.len:
        add(outCitations, extracts[i])
        i = i + 1
    var j: int32 = 0
    while j < finExtracts.len:
        add(outCitations, finExtracts[j])
        j = j + 1
    return allVisible

# ── Generic inline tag parser ──

fn parseInlineTags(text: str, openTag: str, closeTag: str, outVisible: var str, outExtracts: var str[]) =
    var specOpens: str[]
    add(specOpens, openTag)
    var specCloses: str[]
    add(specCloses, closeTag)
    var pending: str
    var activeId: int32 = -1
    var activeClose: str
    var activeContent: str
    var vis: str
    var extracts: str[]
    inlinePushStr(pending, activeId, activeClose, activeContent, specOpens, specCloses, text, vis, extracts)
    var finVis: str
    var finExtracts: str[]
    inlineFinish(activeId, activeClose, activeContent, pending, finVis, finExtracts)
    outVisible = strings.ConcatStr(vis, finVis)
    var i: int32 = 0
    while i < extracts.len:
        add(outExtracts, extracts[i])
        i = i + 1
    var j: int32 = 0
    while j < finExtracts.len:
        add(outExtracts, finExtracts[j])
        j = j + 1

fn extractTagContent(text: str, tagName: str, outContents: var str[]): bool =
    let openTag = strings.ConcatStr(strings.ConcatStr("<", tagName), ">")
    let closeTag = strings.ConcatStr(strings.ConcatStr("</", tagName), ">")
    var visible: str
    parseInlineTags(text, openTag, closeTag, visible, outContents)
    return outContents.len > 0

# ── Plan-block parser (line-based <proposed_plan> blocks) ──

fn planProcessLine(line: str, active: var int32, outVisible: var str, outDelta: var str): int32 =
    let n = line.len
    var content: str
    if n > 0 && line[n - 1] == '\n':
        if n - 1 > 0:
            content = strings.SliceBytes(line, 0, n - 1)
        else:
            content = ""
    else:
        content = line
    let trimmed = strutil.Strip(content)
    if trimmed == "<proposed_plan>":
        if active == 0:
            active = 1
            outVisible = ""
            outDelta = ""
            return 1
        outVisible = ""
        outDelta = line
        return 2
    if trimmed == "</proposed_plan>":
        if active != 0:
            active = 0
            outVisible = ""
            outDelta = ""
            return 3
        outVisible = line
        outDelta = ""
        return 0
    if active != 0:
        outVisible = ""
        outDelta = line
        return 2
    else:
        outVisible = line
        outDelta = ""
        return 0

fn planPushStr(pending: var str, active: var int32, chunk: str,
               outVisible: var str, outPlanDeltas: var str[]) =
    pending = strings.ConcatStr(pending, chunk)
    outVisible = ""
    var lastNewline: int32 = -1
    var i: int32 = 0
    while i < pending.len:
        if pending[i] == '\n':
            lastNewline = i
        i = i + 1
    if lastNewline < 0:
        return
    var lineStart: int32 = 0
    var j: int32 = 0
    while j <= lastNewline:
        if pending[j] == '\n':
            let lineLen = j - lineStart + 1
            let line = strings.SliceBytes(pending, lineStart, lineLen)
            var vis: str
            var delta: str
            let segType = planProcessLine(line, active, vis, delta)
            if segType == 2:
                add(outPlanDeltas, delta)
            if segType == 0:
                outVisible = strings.ConcatStr(outVisible, vis)
            lineStart = j + 1
        j = j + 1
    pending = strings.SliceBytes(pending, lineStart, pending.len - lineStart)

fn planFinish(pending: var str, active: var int32, outVisible: var str, outPlanDeltas: var str[]) =
    outVisible = ""
    if pending != "":
        let trimmed = strutil.Strip(pending)
        if trimmed == "<proposed_plan>":
            if active == 0:
                active = 1
            else:
                add(outPlanDeltas, pending)
        else:
            if trimmed == "</proposed_plan>":
                if active != 0:
                    active = 0
                else:
                    outVisible = pending
            else:
                if active != 0:
                    add(outPlanDeltas, pending)
                else:
                    outVisible = pending
        pending = ""
    if active != 0:
        active = 0

fn stripProposedPlan(text: str): str =
    var result: str = ""
    var i: int32 = 0
    let n = text.len
    while i < n:
        var foundOpen: bool = false
        var openPos: int32 = -1
        strFindAt(text, i, "<proposed_plan>", openPos, foundOpen)
        if foundOpen:
            var prefixEnd: int32 = openPos
            if prefixEnd > i && text[prefixEnd - 1] == '\n':
                prefixEnd = prefixEnd - 1
            if prefixEnd > i:
                result = strings.ConcatStr(result, strings.SliceBytes(text, i, prefixEnd - i))
            var foundClose: bool = false
            var closePos: int32 = -1
            strFindAt(text, openPos, "</proposed_plan>", closePos, foundClose)
            if foundClose:
                i = closePos + 17
                while i < n && text[i] == '\n':
                    i = i + 1
            else:
                i = n
        else:
            result = strings.ConcatStr(result, strings.SliceBytes(text, i, n - i))
            break
    return result

fn extractProposedPlan(text: str, outPlanText: var str): bool =
    var pending: str
    var active: int32 = 0
    var vis: str
    var planDeltas: str[]
    planPushStr(pending, active, text, vis, planDeltas)
    var finVis: str
    planFinish(pending, active, finVis, planDeltas)
    var result: str = ""
    var i: int32 = 0
    while i < planDeltas.len:
        result = strings.ConcatStr(result, planDeltas[i])
        i = i + 1
    var hadPlan: bool = result != ""
    outPlanText = result
    return hadPlan

# ── Assistant text stream parser (citations + plans combined) ──

fn assistantPushStr(citPending: var str, citActiveId: var int32, citActiveClose: var str, citActiveContent: var str,
                    planPending: var str, planActive: var int32, planMode: bool,
                    chunk: str,
                    outVisible: var str, outCitations: var str[], outPlanDeltas: var str[]) =
    var specOpens: str[]
    add(specOpens, "<oai-mem-citation>")
    var specCloses: str[]
    add(specCloses, "</oai-mem-citation>")
    var citVis: str
    var citExtracts: str[]
    inlinePushStr(citPending, citActiveId, citActiveClose, citActiveContent,
                  specOpens, specCloses, chunk, citVis, citExtracts)
    var i: int32 = 0
    while i < citExtracts.len:
        add(outCitations, citExtracts[i])
        i = i + 1
    if planMode:
        var planVis: str
        planPushStr(planPending, planActive, citVis, planVis, outPlanDeltas)
        outVisible = planVis
    else:
        outVisible = citVis

fn assistantFinish(citPending: var str, citActiveId: var int32, citActiveClose: var str, citActiveContent: var str,
                   planPending: var str, planActive: var int32, planMode: bool,
                   outVisible: var str, outCitations: var str[], outPlanDeltas: var str[]) =
    var specOpens: str[]
    add(specOpens, "<oai-mem-citation>")
    var specCloses: str[]
    add(specCloses, "</oai-mem-citation>")
    var citVis: str
    var citExtracts: str[]
    inlineFinish(citActiveId, citActiveClose, citActiveContent, citPending, citVis, citExtracts)
    var i: int32 = 0
    while i < citExtracts.len:
        add(outCitations, citExtracts[i])
        i = i + 1
    if planMode:
        var planVis: str
        planFinish(planPending, planActive, planVis, outPlanDeltas)
        outVisible = strings.ConcatStr(citVis, planVis)
    else:
        outVisible = citVis

# ── XML Document types ──

type
    XmlNodeType = enum
        xnElement
        xnText

type
    XmlAttr =
        name: str
        value: str

type
    XmlNode =
        nodeType: int32            # 0=element, 1=text
        tag: str                   # element tag name (for xnElement)
        text: str                  # text content (for xnText)
        attrs: XmlAttr[]           # attributes (for xnElement)
        children: XmlNode[]        # child nodes (for xnElement)

# ── Simple XML document parser ──
# Parses a well-formed XML string into a tree of XmlNode values.
# Handles: elements, text content, double-quoted attributes, self-closing tags.
# Limitations: no CDATA, no namespaces, no single-quoted attrs, no DTD.

fn parseXmlDocument(xml: str, outRoot: var XmlNode, outError: var str) =
    outError = ""
    var pos: int32 = 0
    let n = xml.len

    # Skip leading whitespace
    while pos < n && (xml[pos] == ' ' || xml[pos] == '\t' || xml[pos] == '\n' || xml[pos] == '\r'):
        pos = pos + 1

    # Expect '<'
    if pos >= n || xml[pos] != '<':
        outError = "expected '<' at start of XML document"
        return

    # Forward declarations for nested recursion
    fn parseAttrs(xml: str, startPos: int32, n: int32, outPos: var int32, outAttrs: var XmlAttr[]) =
        outAttrs = []
        var p: int32 = startPos
        while p < n:
            # Skip whitespace
            while p < n && (xml[p] == ' ' || xml[p] == '\t' || xml[p] == '\n' || xml[p] == '\r'):
                p = p + 1
            if p >= n || xml[p] == '>' || xml[p] == '/':
                outPos = p
                return
            # Parse attribute name
            var nameStart: int32 = p
            while p < n && xml[p] != '=' && xml[p] != ' ' && xml[p] != '\t' && xml[p] != '\n' && xml[p] != '\r' && xml[p] != '>' && xml[p] != '/':
                p = p + 1
            if p >= n || xml[p] != '=':
                outPos = p
                return
            var name: str = strings.SliceBytes(xml, nameStart, p - nameStart)
            p = p + 1  # skip '='
            # Expect double-quoted value
            if p >= n || xml[p] != '"':
                outPos = p
                return
            p = p + 1  # skip opening quote
            var valStart: int32 = p
            while p < n && xml[p] != '"':
                p = p + 1
            if p >= n:
                outPos = p
                return
            var value: str = strings.SliceBytes(xml, valStart, p - valStart)
            p = p + 1  # skip closing quote
            var attr: XmlAttr
            attr.name = name
            attr.value = value
            add(outAttrs, attr)
        outPos = p

    fn parseElement(xml: str, posIn: int32, n: int32, outPos: var int32, outNode: var XmlNode, outErr: var str) =
        outNode.nodeType = 0
        outNode.tag = ""
        outNode.text = ""
        outNode.attrs = []
        outNode.children = []
        outErr = ""
        var p: int32 = posIn
        if p >= n || xml[p] != '<':
            outErr = "expected '<'"
            return
        p = p + 1
        # Parse tag name
        var tagStart: int32 = p
        while p < n && xml[p] != ' ' && xml[p] != '\t' && xml[p] != '\n' && xml[p] != '\r' && xml[p] != '>' && xml[p] != '/':
            p = p + 1
        if p <= tagStart:
            outErr = "expected tag name"
            return
        var tag: str = strings.SliceBytes(xml, tagStart, p - tagStart)
        outNode.tag = tag
        # Parse attributes
        parseAttrs(xml, p, n, p, outNode.attrs)
        # Check for self-closing
        if p < n && xml[p] == '/':
            p = p + 1
            if p < n && xml[p] == '>':
                p = p + 1
                outPos = p
                return
            outErr = "expected '>' after self-close"
            return
        if p < n && xml[p] == '>':
            p = p + 1
            # Parse children (text and elements)
            var children: XmlNode[]
            while p < n:
                # Capture text content
                var textStart: int32 = p
                while p < n && xml[p] != '<':
                    p = p + 1
                if p > textStart:
                    var rawText: str = strings.SliceBytes(xml, textStart, p - textStart)
                    # Trim whitespace for text nodes
                    var ts: int32 = 0
                    var te: int32 = rawText.len
                    while ts < te && (rawText[ts] == ' ' || rawText[ts] == '\t' || rawText[ts] == '\n' || rawText[ts] == '\r'):
                        ts = ts + 1
                    while te > ts && (rawText[te - 1] == ' ' || rawText[te - 1] == '\t' || rawText[te - 1] == '\n' || rawText[te - 1] == '\r'):
                        te = te - 1
                    if ts < te:
                        var textNode: XmlNode
                        textNode.nodeType = 1
                        textNode.text = strings.SliceBytes(rawText, ts, te - ts)
                        add(children, textNode)
                if p >= n:
                    outErr = "unexpected end of XML"
                    return
                # Check for closing tag
                if p + 1 < n && xml[p] == '<' && xml[p+1] == '/':
                    p = p + 2
                    var closeTagStart: int32 = p
                    while p < n && xml[p] != '>':
                        p = p + 1
                    if p >= n:
                        outErr = "unexpected end of XML in closing tag"
                        return
                    var closeTag: str = strings.SliceBytes(xml, closeTagStart, p - closeTagStart)
                    if closeTag != tag:
                        outErr = strings.ConcatStr(strings.ConcatStr(strings.ConcatStr(strings.ConcatStr("mismatched closing tag: expected </", tag), "> got </"), closeTag), ">")
                        return
                    p = p + 1
                    outPos = p
                    outNode.children = children
                    return
                # Child element
                var childNode: XmlNode
                parseElement(xml, p, n, p, childNode, outErr)
                if outErr != "":
                    return
                add(children, childNode)
            outErr = "unexpected end of XML"
            return
        outErr = "expected '>'"
        return

    parseElement(xml, pos, n, pos, outRoot, outError)

# ── Stream parser state type and reset ──

type
    StreamParserState =
        pending: str
        activeId: int32
        activeClose: str
        activeContent: str

fn streamParserReset(state: var StreamParserState) =
    state.pending = ""
    state.activeId = -1
    state.activeClose = ""
    state.activeContent = ""
