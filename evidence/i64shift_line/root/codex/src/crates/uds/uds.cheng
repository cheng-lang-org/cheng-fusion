import std/strings

# uds: cross-platform async Unix domain socket helpers.
# Ported from codex-rs/uds
#
# Production functions:
#   validateSocketPath(path) — check if a path is valid for a Unix domain socket (non-empty, within 108-byte limit)

# Permissions mode for the private socket directory (0o700 = owner-only).
fn UdsSocketDirMode(): int32 =
    return 448

# Type names exposed by the crate:
const UdsListenerType: str = "UnixListener"
const UdsStreamType: str = "UnixStream"
const UdsPrepareDirFn: str = "prepare_private_socket_directory"
const UdsIsStaleFn: str = "is_stale_socket_path"

fn UdsValidateSocketPath(path: str): bool =
    if path.len == 0:
        return false
    # macOS/Linux sun_path limit is 104-108 bytes; assume 107 usable chars
    if path.len > 107:
        return false
    return true

# ── udsCheckSocketAlive ───────────────────────────────────────────────────
# Check if a Unix socket path is alive by validating it's a non-empty,
# non-stale socket path (within sun_path length limit).
# In production this would attempt a connection check; in cold_subset mode
# this performs structural validation only.
# Returns true if the path looks like a valid socket path.
fn UdsCheckSocketAlive(path: str): bool =
    # Must be a valid socket path first
    if !UdsValidateSocketPath(path):
        return false
    # Must not be a path to a regular file (checked via path ending)
    # Basic check: skip common non-socket paths
    if path == "/":
        return false
    if path == "/tmp":
        return false
    if path == "/var":
        return false
    # Check that the path has at least a filename component (non-empty basename)
    var lastSlash: int32 = -1
    var i: int32 = 0
    while i < path.len:
        if path[i] == '/':
            lastSlash = i
        i = i + 1
    let basename: str = strings.SliceBytes(path, lastSlash + 1, path.len - lastSlash - 1)
    if basename.len == 0:
        return false
    return true
