# utils/cargo-bin: Cargo binary name resolution
# Ported from codex-rs/utils/cargo-bin/src/lib.rs
#
# Provides resolveCargoBin for mapping common cargo binary names to paths.

import std/os
import std/strutils as strutil
import std/strings

# ── resolveCargoBin ────────────────────────────────────────────────────────
# Resolve a cargo binary by checking CARGO_BIN_EXE_<NAME> environment variable.
# Returns the path if found, or empty string if not found.
fn RustCsgUtilsCargoBinResolve(name: str): str =
    if name.len == 0:
        return ""

    # Build env var name: CARGO_BIN_EXE_<name>
    let envKey: str = strutil.Join(["CARGO_BIN_EXE_", name], "")
    let value: str = os.getEnv(envKey)

    if value.len > 0:
        return value

    # Try with underscore name (cargo replaces dashes with underscores)
    let underscoreName: str = strutil.Join(strutil.Split(name, '-'), "_")
    if underscoreName != name:
        let altKey: str = strutil.Join(["CARGO_BIN_EXE_", underscoreName], "")
        let altValue: str = os.getEnv(altKey)
        if altValue.len > 0:
            return altValue

    return ""

# ── resolveCargoBinary (production) ────────────────────────────────────────
# Resolve a cargo binary path from common locations:
#   1. CARGO_BIN_EXE_<NAME> env var
#   2. ~/.cargo/bin/<name>
#   3. /usr/local/cargo/bin/<name>
#   4. /opt/homebrew/bin/<name> (Darwin ARM64)
#
# Returns true on success with outPath set, false otherwise.
fn RustCsgUtilsCargoBinResolveBinary(name: str, outPath: var str): bool =
    outPath = ""
    if name.len == 0:
        return false

    # 1. Check env var
    let envKey: str = strutil.Join(["CARGO_BIN_EXE_", name], "")
    let envVal: str = os.getEnv(envKey)
    if envVal.len > 0:
        outPath = envVal
        return true

    # 2. Check ~/.cargo/bin/<name>
    let home: str = os.getEnv("HOME")
    if home.len > 0:
        let homePath: str = strutil.Join([home, "/.cargo/bin/", name], "")
        if os.fileExists(homePath):
            outPath = homePath
            return true

    # 3. Check /usr/local/cargo/bin/<name>
    let usrPath: str = strutil.Join(["/usr/local/cargo/bin/", name], "")
    if os.fileExists(usrPath):
        outPath = usrPath
        return true

    # 4. Check /opt/homebrew/bin/<name>
    let brewPath: str = strutil.Join(["/opt/homebrew/bin/", name], "")
    if os.fileExists(brewPath):
        outPath = brewPath
        return true

    return false

# ── cargoBinListTargets ────────────────────────────────────────────────────
# Parse a Cargo.toml manifest string and extract build target names.
# Looks for [[bin]] and [lib] sections and returns their "name =" values.
# Returns an empty array if no targets are found or the manifest is empty.
# NOTE: This is a simplified parser that handles basic Cargo.toml syntax.
fn RustCsgUtilsCargoBinListTargets(manifest: str): str[] =
    var out: str[]
    if manifest.len == 0:
        return out

    var inSection: bool = false
    var lookingForName: bool = false
    var i: int32 = 0
    while i < manifest.len:
        # Detect section headers: [lib] or [[bin]]
        if manifest[i] == '[':
            var closeBracket: int32 = i + 1
            while closeBracket < manifest.len && manifest[closeBracket] != ']':
                closeBracket = closeBracket + 1
            if closeBracket < manifest.len && closeBracket > i + 1:
                let headerRaw: str = strings.SliceBytes(manifest, i + 1, closeBracket - i - 1)
                let header: str = strutil.Strip(headerRaw)
                # Check for [[bin]] or [lib]
                if header == "[bin" || header == "bin":
                    lookingForName = true
                elif header == "lib":
                    lookingForName = true
                else:
                    lookingForName = false
                i = closeBracket
        elif lookingForName:
            # Look for name = "..." in current section
            var lineEnd: int32 = i
            while lineEnd < manifest.len && manifest[lineEnd] != '\n':
                lineEnd = lineEnd + 1
            let line: str = strings.SliceBytes(manifest, i, lineEnd - i)
            let trimmed: str = strutil.Strip(line)
            # Check if line starts with name =
            if trimmed.len > 6:
                let namePrefix: str = strings.SliceBytes(trimmed, 0, 5)
                if namePrefix == "name " || namePrefix == "name=" || namePrefix == "name\t":
                    # Find the = sign
                    var eqIdx: int32 = 0
                    while eqIdx < trimmed.len && trimmed[eqIdx] != '=':
                        eqIdx = eqIdx + 1
                    if eqIdx < trimmed.len - 1:
                        let valPart: str = strutil.Strip(strings.SliceBytes(trimmed, eqIdx + 1, trimmed.len - eqIdx - 1))
                        # Strip surrounding quotes
                        var valStart: int32 = 0
                        var valEnd: int32 = valPart.len
                        if valPart.len > 0 && (valPart[0] == '"' || valPart[0] == '\''):
                            valStart = 1
                        if valPart.len > 1 && (valPart[valPart.len - 1] == '"' || valPart[valPart.len - 1] == '\''):
                            valEnd = valPart.len - 1
                        if valStart < valEnd:
                            let targetName: str = strings.SliceBytes(valPart, valStart, valEnd - valStart)
                            add(out, targetName)
                            lookingForName = false  # Only first name per section
            i = lineEnd
        i = i + 1

    return out
