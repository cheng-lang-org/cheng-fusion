# CLI — common argument parser
#
# Ported from codex-rs/cli/src/lib.rs
# Parses common CLI flags (--model, --cwd, --resume, etc.) into a
# JSON config struct representation.

import std/strutils as strutil

type
    RustCsgCliConfig =
        model: str
        cwd: str
        resume: bool
        resumeSessionId: str
        profile: str
        configOverrides: str[]
        json: bool
        color: str
        approvalPolicySet: bool
        dangerouslyBypassApprovalsAndSandbox: bool
        noAltScreen: bool
        skipGitRepoCheck: bool
        help: bool
        version: bool
        parseError: str

fn RustCsgCliConfigDefault(): RustCsgCliConfig =
    var result: RustCsgCliConfig
    result.color = "auto"
    return result

fn RustCsgCliSetParseError(config: var RustCsgCliConfig, message: str) =
    if config.parseError == "":
        config.parseError = message

fn RustCsgCliHasPrefix(text: str, prefix: str): bool =
    if text.len < prefix.len:
        return false
    for i in 0..<prefix.len:
        if text[i] != prefix[i]:
            return false
    return true

fn RustCsgCliIsFlag(arg: str): bool =
    if arg.len < 2:
        return false
    return arg[0] == '-'

fn RustCsgCliInlineValue(arg: str, key: str): str =
    if arg.len <= key.len:
        return ""
    if !RustCsgCliHasPrefix(arg, key):
        return ""
    if arg[key.len] != '=':
        return ""
    return strings.SliceBytes(arg, key.len + 1, arg.len - key.len - 1)

fn RustCsgCliReadNextArg(args: str[], index: int32, key: str, outValue: var str, outNextIndex: var int32): bool =
    outValue = ""
    outNextIndex = index
    let arg = args[index]
    if arg.len > key.len && RustCsgCliHasPrefix(arg, key) && arg[key.len] == '=':
        outValue = strings.SliceBytes(arg, key.len + 1, arg.len - key.len - 1)
        return true
    if arg != key:
        return false
    let valueIndex = index + 1
    if valueIndex >= args.len:
        return true
    if args[valueIndex].len >= 2 && args[valueIndex][0] == '-':
        return true
    outValue = args[valueIndex]
    outNextIndex = valueIndex
    return true

fn RustCsgParseCliArgs(args: str[]): RustCsgCliConfig =
    var config = RustCsgCliConfigDefault()
    # Skip index 0 (program name), same as exec crate
    var i: int32 = 1
    var stopOptions: bool
    while i < args.len:
        let arg = args[i]
        if !stopOptions && arg == "--":
            stopOptions = true
            i = i + 1
            continue
        if !stopOptions && RustCsgCliIsFlag(arg):
            var value: str
            var nextIndex: int32
            if RustCsgCliReadNextArg(args, i, "--model", value, nextIndex) ||
               RustCsgCliReadNextArg(args, i, "-m", value, nextIndex):
                if value == "":
                    RustCsgCliSetParseError(config, "--model requires a value")
                config.model = value
                i = nextIndex + 1
                continue
            if RustCsgCliReadNextArg(args, i, "--cwd", value, nextIndex) ||
               RustCsgCliReadNextArg(args, i, "-C", value, nextIndex) ||
               RustCsgCliReadNextArg(args, i, "--cd", value, nextIndex):
                if value == "":
                    RustCsgCliSetParseError(config, "--cwd requires a value")
                config.cwd = value
                i = nextIndex + 1
                continue
            if RustCsgCliReadNextArg(args, i, "--profile", value, nextIndex) ||
               RustCsgCliReadNextArg(args, i, "-p", value, nextIndex):
                if value == "":
                    RustCsgCliSetParseError(config, "--profile requires a value")
                config.profile = value
                i = nextIndex + 1
                continue
            if RustCsgCliReadNextArg(args, i, "--config", value, nextIndex) ||
               RustCsgCliReadNextArg(args, i, "-c", value, nextIndex):
                if value == "":
                    RustCsgCliSetParseError(config, "--config requires a value")
                add(config.configOverrides, value)
                i = nextIndex + 1
                continue
            if RustCsgCliReadNextArg(args, i, "--color", value, nextIndex):
                if value != "auto" && value != "always" && value != "never":
                    RustCsgCliSetParseError(config, strings.ConcatStr("invalid --color: ", value))
                config.color = value
                i = nextIndex + 1
                continue
            if arg == "--json" || arg == "--experimental-json":
                config.json = true
                i = i + 1
                continue
            if arg == "--search":
                add(config.configOverrides, "web_search=live")
                i = i + 1
                continue
            if arg == "--no-alt-screen":
                config.noAltScreen = true
                i = i + 1
                continue
            if RustCsgCliReadNextArg(args, i, "--ask-for-approval", value, nextIndex) ||
               RustCsgCliReadNextArg(args, i, "-a", value, nextIndex):
                if config.dangerouslyBypassApprovalsAndSandbox:
                    RustCsgCliSetParseError(config, "--dangerously-bypass-approvals-and-sandbox conflicts with --ask-for-approval")
                if value == "":
                    RustCsgCliSetParseError(config, "--ask-for-approval requires a value")
                config.approvalPolicySet = true
                add(config.configOverrides, strings.ConcatStr("approval_policy=", value))
                i = nextIndex + 1
                continue
            if arg == "--dangerously-bypass-approvals-and-sandbox" || arg == "--yolo":
                if config.approvalPolicySet:
                    RustCsgCliSetParseError(config, "--dangerously-bypass-approvals-and-sandbox conflicts with --ask-for-approval")
                config.dangerouslyBypassApprovalsAndSandbox = true
                add(config.configOverrides, "approval_policy=never")
                add(config.configOverrides, "sandbox_mode=danger-full-access")
                i = i + 1
                continue
            if arg == "--skip-git-repo-check":
                config.skipGitRepoCheck = true
                i = i + 1
                continue
            if arg == "--help" || arg == "-h":
                config.help = true
                i = i + 1
                continue
            if arg == "--version" || arg == "-V":
                config.version = true
                return config
            if arg == "--resume":
                config.resume = true
                i = i + 1
                continue
            RustCsgCliSetParseError(config, strings.ConcatStr("unknown flag: ", arg))
            i = i + 1
            continue
        if arg == "resume" && !config.resume:
            config.resume = true
            i = i + 1
            continue
        if arg != "" && config.resumeSessionId == "" && !RustCsgCliHasPrefix(arg, "-"):
            config.resumeSessionId = arg
            i = i + 1
            continue
        i = i + 1
    return config

fn RustCsgCliJsonEscape(value: str): str =
    # NOTE: cold-path limitation — strutil.replace uses charToStr which is
    # not available in the cold compilation path.  This function relies on
    # values not containing JSON-significant control characters.  For the
    # model-name / cwd / session-id inputs used in practice this is safe.
    return strings.ConcatStr(strings.ConcatStr("\"", value), "\"")

fn RustCsgCliConfigToJson(config: RustCsgCliConfig): str =
    var parts: str[]
    if config.model != "":
        add(parts, strings.ConcatStr("\"model\":", RustCsgCliJsonEscape(config.model)))
    if config.cwd != "":
        add(parts, strings.ConcatStr("\"cwd\":", RustCsgCliJsonEscape(config.cwd)))
    if config.resume:
        add(parts, "\"resume\":true")
    if config.resumeSessionId != "":
        add(parts, strings.ConcatStr("\"resumeSessionId\":", RustCsgCliJsonEscape(config.resumeSessionId)))
    if config.profile != "":
        add(parts, strings.ConcatStr("\"profile\":", RustCsgCliJsonEscape(config.profile)))
    if config.configOverrides.len > 0:
        add(parts, strings.ConcatStr("\"configOverrides\":", RustCsgCliJsonStringArray(config.configOverrides)))
    if config.json:
        add(parts, "\"json\":true")
    if config.color != "" && config.color != "auto":
        add(parts, strings.ConcatStr("\"color\":", RustCsgCliJsonEscape(config.color)))
    if config.dangerouslyBypassApprovalsAndSandbox:
        add(parts, "\"dangerouslyBypassApprovalsAndSandbox\":true")
    if config.noAltScreen:
        add(parts, "\"noAltScreen\":true")
    if config.skipGitRepoCheck:
        add(parts, "\"skipGitRepoCheck\":true")
    if config.help:
        add(parts, "\"help\":true")
    if config.version:
        add(parts, "\"version\":true")
    if config.parseError != "":
        add(parts, strings.ConcatStr("\"parseError\":", RustCsgCliJsonEscape(config.parseError)))
    if parts.len == 0:
        return "{}"
    var jsonStr: str
    var pi: int32 = 0
    while pi < parts.len:
        if pi > 0: jsonStr = strings.ConcatStr(jsonStr, ",")
        jsonStr = strings.ConcatStr(jsonStr, parts[pi])
        pi = pi + 1
    return strings.ConcatStr(strings.ConcatStr("{", jsonStr), "}")

fn RustCsgCliJsonStringArray(values: str[]): str =
    var elements: str[]
    for i in 0..<values.len:
        add(elements, RustCsgCliJsonEscape(values[i]))
    var arrStr: str
    var ei: int32 = 0
    while ei < elements.len:
        if ei > 0: arrStr = strings.ConcatStr(arrStr, ",")
        arrStr = strings.ConcatStr(arrStr, elements[ei])
        ei = ei + 1
    return strings.ConcatStr(strings.ConcatStr("[", arrStr), "]")

fn RustCsgCliFormatHelp(command: str): str =
    var result: str
    if command == "":
        result = "Usage: codex [options]\n\nOptions:\n"
    else:
        result = strings.ConcatStr(strings.ConcatStr("Usage: codex ", command), " [options]\n\nOptions:\n")
    result = strings.ConcatStr(result, "  --model, -m <name>       Set the model name\n")
    result = strings.ConcatStr(result, "  --cwd, -C, --cd <path>   Set working directory\n")
    result = strings.ConcatStr(result, "  --profile, -p <name>     Set profile name\n")
    result = strings.ConcatStr(result, "  --config, -c <key=val>   Set config override\n")
    result = strings.ConcatStr(result, "  --color <auto|always|never>  Set color mode\n")
    result = strings.ConcatStr(result, "  --json                   Enable JSON output\n")
    result = strings.ConcatStr(result, "  --ask-for-approval, -a <mode> Configure command approval policy\n")
    result = strings.ConcatStr(result, "  --search                 Enable live web search\n")
    result = strings.ConcatStr(result, "  --no-alt-screen          Disable alternate screen mode\n")
    result = strings.ConcatStr(result, "  --dangerously-bypass-approvals-and-sandbox  Disable approval and sandbox protections\n")
    result = strings.ConcatStr(result, "  --resume [session-id]    Resume a session\n")
    result = strings.ConcatStr(result, "  --skip-git-repo-check    Skip git repo check\n")
    result = strings.ConcatStr(result, "  --help, -h               Show this help\n")
    return result

fn RustCsgCliValidateArgs(args: str[], spec: str): str =
    if args.len < 1:
        return "missing program name"
    let config = RustCsgParseCliArgs(args)
    if config.parseError != "":
        return config.parseError
    if spec == "":
        return ""
    var specFields: str[] = strutil.Split(spec, ',')
    for i in 0..<specFields.len:
        let field: str = strutil.Strip(specFields[i])
        if field == "":
            continue
        if field == "model" && config.model == "":
            return strings.ConcatStr(strings.ConcatStr("required flag --", field), " is missing")
        if field == "cwd" && config.cwd == "":
            return strings.ConcatStr(strings.ConcatStr("required flag --", field), " is missing")
        if field == "profile" && config.profile == "":
            return strings.ConcatStr(strings.ConcatStr("required flag --", field), " is missing")
    return ""

# Generate shell completion script for a given shell.
# command: the CLI command name (e.g. "codex").
# shell: "bash", "zsh", or "fish".
# Returns the completion script as a string.
fn cliGenerateCompletion(command: str, shell: str): str =
    if shell == "bash":
        return strings.ConcatStr(strings.ConcatStr(strings.ConcatStr(strings.ConcatStr(strings.ConcatStr(strings.ConcatStr("_", command), "() {\n  local cur=${COMP_WORDS[COMP_CWORD]}\n  local prev=${COMP_WORDS[COMP_CWORD-1]}\n  local opts=\"--model -m --cwd -C --cd --profile -p --config -c --color --json --ask-for-approval -a --search --no-alt-screen --dangerously-bypass-approvals-and-sandbox --resume --skip-git-repo-check --help -h\"\n  COMPREPLY=($(compgen -W \"$opts\" -- \"$cur\"))\n}\ncomplete -F _"), command), " "), command), "\n")
    if shell == "zsh":
        return strings.ConcatStr(strings.ConcatStr("#compdef ", command), "\nlocal -a opts\nopts=(\n  '--model[Set the model name]:model:->models'\n  '--cwd[Set working directory]:dir:_files'\n  '--cd[Set working directory]:dir:_files'\n  '--profile[Set profile]:profile:->profiles'\n  '--config[Set config override]:config:->configs'\n  '--color[Set color mode]:color:(auto always never)'\n  '--json[Enable JSON output]'\n  '--ask-for-approval[Configure command approval policy]:mode:(untrusted on-failure on-request never)'\n  '--search[Enable live web search]'\n  '--no-alt-screen[Disable alternate screen mode]'\n  '--dangerously-bypass-approvals-and-sandbox[Disable approval and sandbox protections]'\n  '--resume[Resume a session]'\n  '--skip-git-repo-check[Skip git repo check]'\n  '--help[Show help]'\n)\n_arguments $opts\n")
    if shell == "fish":
        var fishOut: str
        fishOut = strings.ConcatStr("complete -c ", strings.ConcatStr(command, " -l model -d 'Set the model name' -x\n"))
        fishOut = strings.ConcatStr(fishOut, strings.ConcatStr("complete -c ", strings.ConcatStr(command, " -l cwd -d 'Set working directory' -x\n")))
        fishOut = strings.ConcatStr(fishOut, strings.ConcatStr("complete -c ", strings.ConcatStr(command, " -l cd -d 'Set working directory' -x\n")))
        fishOut = strings.ConcatStr(fishOut, strings.ConcatStr("complete -c ", strings.ConcatStr(command, " -l profile -d 'Set profile name' -x\n")))
        fishOut = strings.ConcatStr(fishOut, strings.ConcatStr("complete -c ", strings.ConcatStr(command, " -l config -d 'Set config override' -x\n")))
        fishOut = strings.ConcatStr(fishOut, strings.ConcatStr("complete -c ", strings.ConcatStr(command, " -l color -d 'Set color mode' -x -a 'auto always never'\n")))
        fishOut = strings.ConcatStr(fishOut, strings.ConcatStr("complete -c ", strings.ConcatStr(command, " -l json -d 'Enable JSON output'\n")))
        fishOut = strings.ConcatStr(fishOut, strings.ConcatStr("complete -c ", strings.ConcatStr(command, " -l ask-for-approval -s a -d 'Configure command approval policy' -x -a 'untrusted on-failure on-request never'\n")))
        fishOut = strings.ConcatStr(fishOut, strings.ConcatStr("complete -c ", strings.ConcatStr(command, " -l search -d 'Enable live web search'\n")))
        fishOut = strings.ConcatStr(fishOut, strings.ConcatStr("complete -c ", strings.ConcatStr(command, " -l no-alt-screen -d 'Disable alternate screen mode'\n")))
        fishOut = strings.ConcatStr(fishOut, strings.ConcatStr("complete -c ", strings.ConcatStr(command, " -l dangerously-bypass-approvals-and-sandbox -d 'Disable approval and sandbox protections'\n")))
        fishOut = strings.ConcatStr(fishOut, strings.ConcatStr("complete -c ", strings.ConcatStr(command, " -l resume -d 'Resume a session'\n")))
        fishOut = strings.ConcatStr(fishOut, strings.ConcatStr("complete -c ", strings.ConcatStr(command, " -l skip-git-repo-check -d 'Skip git repo check'\n")))
        fishOut = strings.ConcatStr(fishOut, strings.ConcatStr("complete -c ", strings.ConcatStr(command, " -l help -d 'Show help'\n")))
        return fishOut
    return ""

# Apply ANSI color codes to text.
# color: "red", "green", "yellow", "blue", "magenta", "cyan", "white", "bold", "dim", or "reset".
# Returns text with ANSI escape codes.
fn cliColorizeOutput(text: str, color: str): str =
    var code: str
    if color == "red":
        code = "31"
    elif color == "green":
        code = "32"
    elif color == "yellow":
        code = "33"
    elif color == "blue":
        code = "34"
    elif color == "magenta":
        code = "35"
    elif color == "cyan":
        code = "36"
    elif color == "white":
        code = "37"
    elif color == "bold":
        code = "1"
    elif color == "dim":
        code = "2"
    else:
        # reset or unknown
        return text
    return strings.ConcatStr(strings.ConcatStr(strings.ConcatStr(strings.ConcatStr("\033[", code), "m"), text), "\033[0m")
