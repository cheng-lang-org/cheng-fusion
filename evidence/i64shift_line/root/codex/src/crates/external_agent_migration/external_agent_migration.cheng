import std/strings
import std/strutils as strutil

# ── External Agent Migration (ported from codex-rs) ──

fn eqFold(a: str, b: str): bool =
    if a.len != b.len:
        return false
    var i: int32 = 0
    while i < a.len:
        var ac: int32 = Int32(a[i])
        var bc: int32 = Int32(b[i])
        if ac >= 65 && ac <= 90:
            ac = ac + 32
        if bc >= 65 && bc <= 90:
            bc = bc + 32
        if ac != bc:
            return false
        i = i + 1
    return true

fn hookMigrationEventNames(): str[] =
    return ["PreToolUse", "PermissionRequest", "PostToolUse", "PreCompact",
            "PostCompact", "SessionStart", "UserPromptSubmit", "Stop"]

fn isHookMigrationEvent(name: str): bool =
    let events = hookMigrationEventNames()
    var i: int32 = 0
    while i < events.len:
        if events[i] == name:
            return true
        i = i + 1
    return false

fn mapMcpConfigKey(externalKey: str, outInternalKey: var str): bool =
    if externalKey == "mcpServers":
        outInternalKey = "mcp_servers"
        return true
    if externalKey == "command":
        outInternalKey = "command"
        return true
    if externalKey == "args":
        outInternalKey = "args"
        return true
    if externalKey == "env":
        outInternalKey = "env"
        return true
    if externalKey == "url":
        outInternalKey = "url"
        return true
    if externalKey == "headers":
        outInternalKey = "http_headers"
        return true
    if externalKey == "type":
        outInternalKey = "transport_type"
        return true
    if externalKey == "disabled":
        outInternalKey = "disabled"
        return true
    if externalKey == "enabled":
        outInternalKey = "enabled"
        return true
    outInternalKey = ""
    return false

fn matchName(externalName: str): str =
    let events = hookMigrationEventNames()
    var i: int32 = 0
    while i < events.len:
        if eqFold(externalName, events[i]):
            return events[i]
        i = i + 1
    return ""

# ── Public API — validate & estimate ─────────────────────────────────

# Validate a migration target format string.
# Target format: "provider_name" or "provider_name:version"
# Returns empty string if valid, or error message if invalid.
fn migrationValidateTarget(target: str): str =
    if target == "":
        return "target must not be empty"
    var validChars: str = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-.:"
    var i: int32 = 0
    while i < target.len:
        var ch: char = target[i]
        var found: bool
        var j: int32 = 0
        while j < validChars.len:
            if ch == validChars[j]:
                found = true
                break
            j = j + 1
        if !found:
            return "invalid character in target"
        i = i + 1
    return ""

# Estimate migration complexity based on a migration config JSON.
# Config format: {"servers":N,"hooks":N,"tools":N}
# Returns complexity score as string: "low", "medium", "high", or "unknown".
fn migrationEstimateComplexity(config: str): str =
    var serverCount: int32
    var hookCount: int32
    var toolCount: int32
    # Extract server count
    if strutil.Contains(config, "\"servers\":"):
        var pos: int32 = 0
        let marker: str = "\"servers\":"
        while pos < config.len:
            if config[pos] == marker[0]:
                var allMatch: bool = true
                var mi: int32 = 1
                while mi < marker.len:
                    if pos + mi >= config.len || config[pos + mi] != marker[mi]:
                        allMatch = false
                        break
                    mi = mi + 1
                if allMatch:
                    var vStart: int32 = pos + marker.len
                    while vStart < config.len && (config[vStart] == ' ' || config[vStart] == '\t'):
                        vStart = vStart + 1
                    if vStart < config.len:
                        var dv: int32 = Int32(config[vStart])
                        if dv >= 48 && dv <= 57:
                            var vEnd: int32 = vStart
                            while vEnd < config.len:
                                var de: int32 = Int32(config[vEnd])
                                if de >= 48 && de <= 57:
                                    vEnd = vEnd + 1
                                else:
                                    break
                            let numStr: str = strings.SliceBytes(config, vStart, vEnd - vStart)
                            var cv: int32 = 0
                            var di: int32 = 0
                            while di < numStr.len:
                                cv = cv * 10 + (Int32(numStr[di]) - 48)
                                di = di + 1
                            serverCount = cv
                    break
            pos = pos + 1
    # Extract hook count
    if strutil.Contains(config, "\"hooks\":"):
        var pos: int32 = 0
        let marker: str = "\"hooks\":"
        while pos < config.len:
            if config[pos] == marker[0]:
                var allMatch: bool = true
                var mi: int32 = 1
                while mi < marker.len:
                    if pos + mi >= config.len || config[pos + mi] != marker[mi]:
                        allMatch = false
                        break
                    mi = mi + 1
                if allMatch:
                    var vStart: int32 = pos + marker.len
                    while vStart < config.len && (config[vStart] == ' ' || config[vStart] == '\t'):
                        vStart = vStart + 1
                    if vStart < config.len:
                        var dv: int32 = Int32(config[vStart])
                        if dv >= 48 && dv <= 57:
                            var vEnd: int32 = vStart
                            while vEnd < config.len:
                                var de: int32 = Int32(config[vEnd])
                                if de >= 48 && de <= 57:
                                    vEnd = vEnd + 1
                                else:
                                    break
                            let numStr: str = strings.SliceBytes(config, vStart, vEnd - vStart)
                            var cv: int32 = 0
                            var di: int32 = 0
                            while di < numStr.len:
                                cv = cv * 10 + (Int32(numStr[di]) - 48)
                                di = di + 1
                            hookCount = cv
                    break
            pos = pos + 1
    # Extract tool count
    if strutil.Contains(config, "\"tools\":"):
        var pos: int32 = 0
        let marker: str = "\"tools\":"
        while pos < config.len:
            if config[pos] == marker[0]:
                var allMatch: bool = true
                var mi: int32 = 1
                while mi < marker.len:
                    if pos + mi >= config.len || config[pos + mi] != marker[mi]:
                        allMatch = false
                        break
                    mi = mi + 1
                if allMatch:
                    var vStart: int32 = pos + marker.len
                    while vStart < config.len && (config[vStart] == ' ' || config[vStart] == '\t'):
                        vStart = vStart + 1
                    if vStart < config.len:
                        var dv: int32 = Int32(config[vStart])
                        if dv >= 48 && dv <= 57:
                            var vEnd: int32 = vStart
                            while vEnd < config.len:
                                var de: int32 = Int32(config[vEnd])
                                if de >= 48 && de <= 57:
                                    vEnd = vEnd + 1
                                else:
                                    break
                            let numStr: str = strings.SliceBytes(config, vStart, vEnd - vStart)
                            var cv: int32 = 0
                            var di: int32 = 0
                            while di < numStr.len:
                                cv = cv * 10 + (Int32(numStr[di]) - 48)
                                di = di + 1
                            toolCount = cv
                    break
            pos = pos + 1
    # Score complexity
    let total: int32 = serverCount + hookCount + toolCount
    if total == 0:
        return "low"
    if total <= 3:
        return "medium"
    return "high"
