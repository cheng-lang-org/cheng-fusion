import std/strings
import std/strutils as strutil

# ── CLI utility functions (ported from codex-rs utils/cli) ──

fn formatEnvDisplay(name: str, value: str): str =
    if value.len == 0:
        return strutil.Join([name, "=<set>"], "")
    else:
        return strutil.Join([name, "=", value], "")

fn resumeCommand(): str =
    return "codex resume my-thread"

fn resumeHint(): str =
    return "resume"

fn parseApprovalMode(s: str): int32 =
    if s == "never":
        return 0
    else:
        if s == "on-request":
            return 1
        else:
            if s == "on-failure":
                return 2
            else:
                if s == "always":
                    return 3
                else:
                    return -1

fn parseSandboxMode(s: str): int32 =
    if s == "workspace":
        return 0
    else:
        if s == "danger-full-access":
            return 1
        else:
            if s == "custom":
                return 2
            else:
                return -1
