// OSS provider utilities — ported from codex-rs utils/oss
// Provider ID strings and default model selection.

const
    RustCsgOssLmstudioProviderId: str = "lmstudio"
    RustCsgOssOllamaProviderId: str = "ollama"
    RustCsgOssLmstudioDefaultModel: str = "openai/gpt-oss-20b"
    RustCsgOssOllamaDefaultModel: str = "gpt-oss:20b"

// Returns the default model name for a given OSS provider ID.
// Returns empty string for unknown providers.
fn RustCsgOssGetDefaultModel(providerId: str): str =
    if providerId == RustCsgOssLmstudioProviderId:
        return RustCsgOssLmstudioDefaultModel
    elif providerId == RustCsgOssOllamaProviderId:
        return RustCsgOssOllamaDefaultModel
    return ""

// Check char by char for "lmstudio" or "lm-studio" or "lm_studio" (case-insensitive).
fn matchLmstudio(s: str): bool =
    var i: int32 = 0
    while i < s.len:
        var c = Int32(s[i])
        if c >= 65 && c <= 90:
            c = c + 32
        if c == 108:
            // 'l' found, check if followed by 'm'
            if i + 1 < s.len:
                var c2 = Int32(s[i+1])
                if c2 >= 65 && c2 <= 90:
                    c2 = c2 + 32
                if c2 == 109:
                    // 'm' found, check remaining
                    if i + 7 <= s.len:
                        // "lmstudio" = l(108)m(109)s(115)t(116)u(117)d(100)i(105)o(111)
                        var p2 = Int32(s[i+2])
                        if p2 >= 65 && p2 <= 90: p2 = p2 + 32
                        var p3 = Int32(s[i+3])
                        if p3 >= 65 && p3 <= 90: p3 = p3 + 32
                        var p4 = Int32(s[i+4])
                        if p4 >= 65 && p4 <= 90: p4 = p4 + 32
                        var p5 = Int32(s[i+5])
                        if p5 >= 65 && p5 <= 90: p5 = p5 + 32
                        var p6 = Int32(s[i+6])
                        if p6 >= 65 && p6 <= 90: p6 = p6 + 32
                        if p2 == 115 && p3 == 116 && p4 == 117 && p5 == 100 && p6 == 105:
                            // Need to check for 'o' at position i+7 or end for "lm-studio"/"lm_studio"
                            if i + 7 == s.len:
                                return true
                            var p7 = Int32(s[i+7])
                            if p7 >= 65 && p7 <= 90: p7 = p7 + 32
                            if p7 == 111:
                                return true
                            if p7 == 45 || p7 == 95:
                                // "lm-studio" or "lm_studio" - check for 'studio'
                                if i + 8 <= s.len:
                                    return true
                    if i + 9 <= s.len:
                        // "lm-studio" or "lm_studio" after separator
                        var dash = Int32(s[i+2])
                        if dash >= 65 && dash <= 90: dash = dash + 32
                        var p3 = Int32(s[i+3])
                        if p3 >= 65 && p3 <= 90: p3 = p3 + 32
                        var p4 = Int32(s[i+4])
                        if p4 >= 65 && p4 <= 90: p4 = p4 + 32
                        var p5 = Int32(s[i+5])
                        if p5 >= 65 && p5 <= 90: p5 = p5 + 32
                        var p6 = Int32(s[i+6])
                        if p6 >= 65 && p6 <= 90: p6 = p6 + 32
                        var p7 = Int32(s[i+7])
                        if p7 >= 65 && p7 <= 90: p7 = p7 + 32
                        var p8 = Int32(s[i+8])
                        if p8 >= 65 && p8 <= 90: p8 = p8 + 32
                        if (dash == 45 || dash == 95) && p3 == 115 && p4 == 116 && p5 == 117 && p6 == 100 && p7 == 105 && p8 == 111:
                            return true
        i = i + 1
    return false

// Check char by char for "ollama" (case-insensitive).
fn matchOllama(s: str): bool =
    var i: int32 = 0
    while i < s.len:
        var c = Int32(s[i])
        if c >= 65 && c <= 90:
            c = c + 32
        if c == 111:
            // 'o' found, check rest of "ollama" = o(111)l(108)l(108)a(97)m(109)a(97)
            if i + 6 <= s.len:
                var p1 = Int32(s[i+1])
                if p1 >= 65 && p1 <= 90: p1 = p1 + 32
                var p2 = Int32(s[i+2])
                if p2 >= 65 && p2 <= 90: p2 = p2 + 32
                var p3 = Int32(s[i+3])
                if p3 >= 65 && p3 <= 90: p3 = p3 + 32
                var p4 = Int32(s[i+4])
                if p4 >= 65 && p4 <= 90: p4 = p4 + 32
                var p5 = Int32(s[i+5])
                if p5 >= 65 && p5 <= 90: p5 = p5 + 32
                if p1 == 108 && p2 == 108 && p3 == 97 && p4 == 109 && p5 == 97:
                    return true
        i = i + 1
    return false

// Detect the OSS provider from a model name string.
// Checks for known provider indicators (case-insensitive).
// Returns provider ID string or empty string if unknown.
fn detectOssProvider(modelName: str): str =
    if modelName.len == 0:
        return ""
    if matchLmstudio(modelName):
        return "lmstudio"
    if matchOllama(modelName):
        return "ollama"
    return ""
