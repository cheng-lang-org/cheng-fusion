# ── Glob pattern matching ───────────────────────────────────────────────
#
# Matches `path` against `pattern` using glob rules:
#   *  — matches any sequence of characters except /
#   ?  — matches any single character except /
#   [abc]   — matches one character from the set
#   [a-z]   — matches one character from the range
#   [!abc]  — matches one character NOT in the set (negation)
#   [^abc]  — same as [!abc]
# All other characters match literally.  Empty pattern matches only empty
# path.  Uses iterative backtracking for correct * matching.

fn RustCsgFileSearchMatchGlobPattern(path: str, pattern: str): bool =
    var si: int32
    var pi: int32
    var bsi: int32
    var bpi: int32
    var hasStar: bool

    si = 0
    pi = 0
    bsi = -1
    bpi = -1
    hasStar = false

    while si < path.len:
        var did_match: bool
        did_match = false

        if pi < pattern.len:
            let pc = pattern[pi]
            if pc == '*':
                while pi < pattern.len && pattern[pi] == '*':
                    pi = pi + 1
                bsi = si
                bpi = pi
                hasStar = true
                did_match = true
            elif pc == '?':
                if path[si] != '/':
                    pi = pi + 1
                    si = si + 1
                    did_match = true
            elif pc == '[':
                var cp: int32 = pi + 1
                var neg: bool
                var cm: bool
                neg = false
                cm = false
                if cp < pattern.len && (pattern[cp] == '!' || pattern[cp] == '^'):
                    neg = true
                    cp = cp + 1
                while cp < pattern.len && pattern[cp] != ']':
                    if cp + 2 < pattern.len && pattern[cp + 1] == '-' && pattern[cp + 2] != ']':
                        if path[si] >= pattern[cp] && path[si] <= pattern[cp + 2]:
                            cm = true
                        cp = cp + 3
                    else:
                        if path[si] == pattern[cp]:
                            cm = true
                        cp = cp + 1
                if cp < pattern.len && pattern[cp] == ']':
                    cp = cp + 1
                if neg:
                    cm = !cm
                if cm && path[si] != '/':
                    pi = cp
                    si = si + 1
                    did_match = true
            else:
                if path[si] == pc:
                    pi = pi + 1
                    si = si + 1
                    did_match = true

        if !did_match:
            if hasStar:
                bsi = bsi + 1
                if bsi < path.len && path[bsi] == '/' && bpi >= pattern.len:
                    return false
                si = bsi
                pi = bpi
            else:
                return false

    while pi < pattern.len && pattern[pi] == '*':
        pi = pi + 1
    return pi == pattern.len

# Rank search results by relevance to a query string.
# Results is a comma-separated list of file paths. Query is a search term.
# Returns a comma-separated list sorted by relevance (exact filename matches first,
# then prefix matches, then substring matches, then the rest).
fn RustCsgFileSearchRankResults(results: str, query: str): str =
    if results.len == 0 || query.len == 0:
        return results
    # Simple ranking: split results into exact matches, prefix, substring, others
    var exact: str = ""
    var prefix: str = ""
    var substr: str = ""
    var other: str = ""
    var firstExact: bool = true
    var firstPrefix: bool = true
    var firstSubstr: bool = true
    var firstOther: bool = true

    var start: int32 = 0
    var i: int32 = 0
    while i <= results.len:
        if i == results.len || results[i] == ',':
            if i > start:
                let path: str = strings.SliceBytes(results, start, i - start)
                # Extract filename (part after last '/' or '\')
                var lastSep: int32 = -1
                var j: int32 = 0
                while j < path.len:
                    if path[j] == '/' || path[j] == '\\':
                        lastSep = j
                    j = j + 1
                let fname: str = strings.SliceBytes(path, lastSep + 1, path.len - lastSep - 1)
                if fname == query:
                    if firstExact:
                        exact = path
                        firstExact = false
                    else:
                        exact = strutil.Join([exact, ",", path], "")
                elif fname.len >= query.len && strings.SliceBytes(fname, 0, query.len) == query:
                    if firstPrefix:
                        prefix = path
                        firstPrefix = false
                    else:
                        prefix = strutil.Join([prefix, ",", path], "")
                elif strutil.Contains(fname, query):
                    if firstSubstr:
                        substr = path
                        firstSubstr = false
                    else:
                        substr = strutil.Join([substr, ",", path], "")
                else:
                    if firstOther:
                        other = path
                        firstOther = false
                    else:
                        other = strutil.Join([other, ",", path], "")
            start = i + 1
        i = i + 1

    # Combine: exact + prefix + substring + other
    var result: str = ""
    var firstRes: bool = true
    if exact.len > 0:
        result = exact
        firstRes = false
    if prefix.len > 0:
        if firstRes:
            result = prefix
            firstRes = false
        else:
            result = strutil.Join([result, ",", prefix], "")
    if substr.len > 0:
        if firstRes:
            result = substr
            firstRes = false
        else:
            result = strutil.Join([result, ",", substr], "")
    if other.len > 0:
        if firstRes:
            result = other
        else:
            result = strutil.Join([result, ",", other], "")
    return result
