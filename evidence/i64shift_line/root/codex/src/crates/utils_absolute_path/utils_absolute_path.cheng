# Port of codex-rs/utils/absolute-path normalization logic to Cheng.
# Core path normalization: remove . and .. components, handle root.
# Unix-only (no Windows device path / prefix / verbatim handling).

import std/strings
import std/os

fn RustCsgUtilsAbsolutePathIsAbsolute(path: str): bool =
    return strings.Len(path) > 0 && path[0] == '/'

fn RustCsgUtilsAbsolutePathSlice(path: str, start: int32, stopExclusive: int32): str =
    if stopExclusive <= start:
        return ""
    return strings.SliceBytes(path, start, stopExclusive - start)

fn RustCsgUtilsAbsolutePathAppendSegment(out: str, segment: str): str =
    if strings.Len(out) == 0:
        return segment
    if out == "/":
        return strings.ConcatStr("/", segment)
    return strings.ConcatStr(strings.ConcatStr(out, "/"), segment)

fn RustCsgUtilsAbsolutePathPopSegment(out: str): str =
    let n = strings.Len(out)
    if n == 0:
        return ""
    let absolute = out[0] == '/'
    if absolute && n == 1:
        return "/"
    var cursor = n - 1
    while cursor > 0 && out[cursor] != '/':
        cursor = cursor - 1
    if absolute:
        if cursor <= 0:
            return "/"
        return strings.SliceBytes(out, 0, cursor)
    if cursor <= 0:
        return ""
    return strings.SliceBytes(out, 0, cursor)

# ------------------------------------------------------------------
# normalize_path(path)  —  remove `.` and `..` components
#
#   ""          → "."
#   "."         → "."
#   ".."        → "."
#   "/"         → "/"
#   "/foo/.."   → "/"
#   "/../foo"   → "/foo"
#   "a/b/../c"  → "a/c"
#   "/a/./b"    → "/a/b"
# ------------------------------------------------------------------
fn RustCsgUtilsAbsolutePathNormalize(path: str): str =
    let n = strings.Len(path)
    if n == 0:
        return "."
    let isAbsolute = RustCsgUtilsAbsolutePathIsAbsolute(path)
    var out: str
    if isAbsolute:
        out = "/"

    var i: int32
    while i < n:
        while i < n && path[i] == '/':
            i = i + 1
        if i >= n:
            break
        let start = i
        while i < n && path[i] != '/':
            i = i + 1
        let stop = i
        let segLen = stop - start
        if segLen == 1 && path[start] == '.':
            continue
        if segLen == 2 && path[start] == '.' && path[start + 1] == '.':
            out = RustCsgUtilsAbsolutePathPopSegment(out)
            continue
        let segment = RustCsgUtilsAbsolutePathSlice(path, start, stop)
        out = RustCsgUtilsAbsolutePathAppendSegment(out, segment)

    if strings.Len(out) == 0:
        return "."
    return out


# ------------------------------------------------------------------
# path_with_base(path, base_path)
#
# If path is absolute → return path as-is.
# Otherwise → join base_path / path (normalize will clean later).
# ------------------------------------------------------------------
fn RustCsgUtilsAbsolutePathPathWithBase(path: str, basePath: str): str =
    if RustCsgUtilsAbsolutePathIsAbsolute(path):
        return path
    let baseLen0 = strings.Len(basePath)
    if baseLen0 == 0:
        return path
    var baseLen = baseLen0
    while baseLen > 1 && basePath[baseLen - 1] == '/':
        baseLen = baseLen - 1
    if baseLen == 1 && basePath[0] == '/':
        return strings.ConcatStr("/", path)
    let baseClean = baseLen == baseLen0 ? basePath : strings.SliceBytes(basePath, 0, baseLen)
    return strings.ConcatStr(strings.ConcatStr(baseClean, "/"), path)


# ------------------------------------------------------------------
# absolutize_from(path, base_path)
#
# Resolve path against base_path, then normalize.
# ------------------------------------------------------------------
fn RustCsgUtilsAbsolutePathAbsolutizeFrom(path: str, basePath: str): str =
    let withBase = RustCsgUtilsAbsolutePathPathWithBase(path, basePath)
    return RustCsgUtilsAbsolutePathNormalize(withBase)


# ------------------------------------------------------------------
# expand_home(path, outExpanded)
#
# Expand `~` or `~/...` to the user's HOME directory.
# `~foo` is NOT expanded (POSIX user-directory shorthand).
# Returns true when expansion happened, false otherwise.
# ------------------------------------------------------------------
fn RustCsgUtilsAbsolutePathExpandHome(path: str, outExpanded: var str): bool =
    let n = strings.Len(path)
    if n == 0 || path[0] != '~':
        return false
    if n > 1 && path[1] != '/':
        return false
    let home = os.GetEnv("HOME")
    if home == "":
        return false
    if n == 1:
        outExpanded = home
        return true
    var cursor: int32 = 1
    while cursor < n && path[cursor] == '/':
        cursor = cursor + 1
    if cursor >= n:
        outExpanded = home
        return true
    let suffix = RustCsgUtilsAbsolutePathSlice(path, cursor, n)
    outExpanded = strings.ConcatStr(strings.ConcatStr(home, "/"), suffix)
    return true
    return false


# ------------------------------------------------------------------
# resolve_against_base(path, base_path)
#
# Expand home directory, then absolutize against base.
# ------------------------------------------------------------------
fn RustCsgUtilsAbsolutePathResolveAgainstBase(path: str, basePath: str): str =
    var expanded: str
    if RustCsgUtilsAbsolutePathExpandHome(path, expanded):
        return RustCsgUtilsAbsolutePathAbsolutizeFrom(expanded, basePath)
    else:
        return RustCsgUtilsAbsolutePathAbsolutizeFrom(path, basePath)


# ------------------------------------------------------------------
# from_absolute_path(path, cwd)
#
# Make path absolute:
#   1. Expand home directory if present.
#   2. If the result is absolute → normalize it.
#   3. If relative → resolve against the provided cwd.
# ------------------------------------------------------------------
fn RustCsgUtilsAbsolutePathFromAbsolutePath(path: str, cwd: str): str =
    var expanded: str
    let actualPath = RustCsgUtilsAbsolutePathExpandHome(path, expanded) ? expanded : path
    return RustCsgUtilsAbsolutePathAbsolutizeFrom(actualPath, cwd)
