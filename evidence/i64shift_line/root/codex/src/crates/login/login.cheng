import std/strings
import std/strutils as strutil

const HexDigits: str = "0123456789ABCDEF"

fn loginUrlEncode(raw: str): str =
    var out: str
    var i: int32 = 0
    while i < raw.len:
        let ch = raw[i]
        if (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || (ch >= 48 && ch <= 57) || ch == 45 || ch == 46 || ch == 95 || ch == 126:
            out = strutil.Join([out, strings.SliceBytes(raw, i, 1)], "")
        elif ch == 32:
            out = strutil.Join([out, "+"], "")
        else:
            var hexDigits: str = "0123456789ABCDEF"
            var hi: int32 = ch / 16
            var lo: int32 = ch % 16
            out = strutil.Join([out, "%", strings.SliceBytes(hexDigits, hi, 1), strings.SliceBytes(hexDigits, lo, 1)], "")
        i = i + 1
    return out

fn loginStartFlow(authUrl: str, clientId: str, redirectUri: str, scope: str, state: str): str =
    var url = authUrl
    url = strutil.Join([url, "?response_type=code&client_id="], "")
    var ci = clientId
    var ciEnc: str
    var i: int32 = 0
    while i < ci.len:
        let ch = ci[i]
        if (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || (ch >= 48 && ch <= 57) || ch == 45 || ch == 46 || ch == 95 || ch == 126:
            ciEnc = strutil.Join([ciEnc, strings.SliceBytes(ci, i, 1)], "")
        elif ch == 32:
            ciEnc = strutil.Join([ciEnc, "+"], "")
        else:
            var hi = ch / 16
            var lo = ch % 16
            ciEnc = strutil.Join([ciEnc, "%", strings.SliceBytes(HexDigits, hi, 1), strings.SliceBytes(HexDigits, lo, 1)], "")
        i = i + 1
    url = strutil.Join([url, ciEnc], "")
    url = strutil.Join([url, "&redirect_uri="], "")
    var ru = redirectUri
    var ruEnc: str
    var j: int32 = 0
    while j < ru.len:
        let ch = ru[j]
        if (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || (ch >= 48 && ch <= 57) || ch == 45 || ch == 46 || ch == 95 || ch == 126:
            ruEnc = strutil.Join([ruEnc, strings.SliceBytes(ru, j, 1)], "")
        elif ch == 32:
            ruEnc = strutil.Join([ruEnc, "+"], "")
        else:
            var hi = ch / 16
            var lo = ch % 16
            ruEnc = strutil.Join([ruEnc, "%", strings.SliceBytes(HexDigits, hi, 1), strings.SliceBytes(HexDigits, lo, 1)], "")
        j = j + 1
    url = strutil.Join([url, ruEnc], "")
    if scope != "":
        url = strutil.Join([url, "&scope="], "")
        var sc = scope
        var scEnc: str
        var k: int32 = 0
        while k < sc.len:
            let ch = sc[k]
            if (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || (ch >= 48 && ch <= 57) || ch == 45 || ch == 46 || ch == 95 || ch == 126:
                scEnc = strutil.Join([scEnc, strings.SliceBytes(sc, k, 1)], "")
            elif ch == 32:
                scEnc = strutil.Join([scEnc, "+"], "")
            else:
                var hi = ch / 16
                var lo = ch % 16
                scEnc = strutil.Join([scEnc, "%", strings.SliceBytes(HexDigits, hi, 1), strings.SliceBytes(HexDigits, lo, 1)], "")
            k = k + 1
        url = strutil.Join([url, scEnc], "")
    if state != "":
        url = strutil.Join([url, "&state="], "")
        var st = state
        var stEnc: str
        var m: int32 = 0
        while m < st.len:
            let ch = st[m]
            if (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || (ch >= 48 && ch <= 57) || ch == 45 || ch == 46 || ch == 95 || ch == 126:
                stEnc = strutil.Join([stEnc, strings.SliceBytes(st, m, 1)], "")
            elif ch == 32:
                stEnc = strutil.Join([stEnc, "+"], "")
            else:
                var hi = ch / 16
                var lo = ch % 16
                stEnc = strutil.Join([stEnc, "%", strings.SliceBytes(HexDigits, hi, 1), strings.SliceBytes(HexDigits, lo, 1)], "")
            m = m + 1
        url = strutil.Join([url, stEnc], "")
    return url

fn loginStartFlowWithPkce(authUrl: str, clientId: str, redirectUri: str, scope: str, state: str, codeChallenge: str): str =
    var url = authUrl
    url = strutil.Join([url, "?response_type=code&client_id="], "")
    var ci = clientId
    var ciEnc: str
    var i: int32 = 0
    while i < ci.len:
        let ch = ci[i]
        if (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || (ch >= 48 && ch <= 57) || ch == 45 || ch == 46 || ch == 95 || ch == 126:
            ciEnc = strutil.Join([ciEnc, strings.SliceBytes(ci, i, 1)], "")
        elif ch == 32:
            ciEnc = strutil.Join([ciEnc, "+"], "")
        else:
            var hi = ch / 16
            var lo = ch % 16
            ciEnc = strutil.Join([ciEnc, "%", strings.SliceBytes(HexDigits, hi, 1), strings.SliceBytes(HexDigits, lo, 1)], "")
        i = i + 1
    url = strutil.Join([url, ciEnc], "")
    url = strutil.Join([url, "&redirect_uri="], "")
    var ru = redirectUri
    var ruEnc: str
    var j: int32 = 0
    while j < ru.len:
        let ch = ru[j]
        if (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || (ch >= 48 && ch <= 57) || ch == 45 || ch == 46 || ch == 95 || ch == 126:
            ruEnc = strutil.Join([ruEnc, strings.SliceBytes(ru, j, 1)], "")
        elif ch == 32:
            ruEnc = strutil.Join([ruEnc, "+"], "")
        else:
            var hi = ch / 16
            var lo = ch % 16
            ruEnc = strutil.Join([ruEnc, "%", strings.SliceBytes(HexDigits, hi, 1), strings.SliceBytes(HexDigits, lo, 1)], "")
        j = j + 1
    url = strutil.Join([url, ruEnc], "")
    if scope != "":
        url = strutil.Join([url, "&scope="], "")
        var sc = scope
        var scEnc: str
        var k: int32 = 0
        while k < sc.len:
            let ch = sc[k]
            if (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || (ch >= 48 && ch <= 57) || ch == 45 || ch == 46 || ch == 95 || ch == 126:
                scEnc = strutil.Join([scEnc, strings.SliceBytes(sc, k, 1)], "")
            elif ch == 32:
                scEnc = strutil.Join([scEnc, "+"], "")
            else:
                var hi = ch / 16
                var lo = ch % 16
                scEnc = strutil.Join([scEnc, "%", strings.SliceBytes(HexDigits, hi, 1), strings.SliceBytes(HexDigits, lo, 1)], "")
            k = k + 1
        url = strutil.Join([url, scEnc], "")
    if state != "":
        url = strutil.Join([url, "&state="], "")
        var st = state
        var stEnc: str
        var m: int32 = 0
        while m < st.len:
            let ch = st[m]
            if (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || (ch >= 48 && ch <= 57) || ch == 45 || ch == 46 || ch == 95 || ch == 126:
                stEnc = strutil.Join([stEnc, strings.SliceBytes(st, m, 1)], "")
            elif ch == 32:
                stEnc = strutil.Join([stEnc, "+"], "")
            else:
                var hi = ch / 16
                var lo = ch % 16
                stEnc = strutil.Join([stEnc, "%", strings.SliceBytes(HexDigits, hi, 1), strings.SliceBytes(HexDigits, lo, 1)], "")
            m = m + 1
        url = strutil.Join([url, stEnc], "")
    url = strutil.Join([url, "&code_challenge="], "")
    var cc = codeChallenge
    var ccEnc: str
    var n: int32 = 0
    while n < cc.len:
        let ch = cc[n]
        if (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || (ch >= 48 && ch <= 57) || ch == 45 || ch == 46 || ch == 95 || ch == 126:
            ccEnc = strutil.Join([ccEnc, strings.SliceBytes(cc, n, 1)], "")
        elif ch == 32:
            ccEnc = strutil.Join([ccEnc, "+"], "")
        else:
            var hi = ch / 16
            var lo = ch % 16
            ccEnc = strutil.Join([ccEnc, "%", strings.SliceBytes(HexDigits, hi, 1), strings.SliceBytes(HexDigits, lo, 1)], "")
        n = n + 1
    url = strutil.Join([url, ccEnc], "")
    url = strutil.Join([url, "&code_challenge_method=S256"], "")
    return url

fn loginGithubDeviceFlow(clientId: str): str =
    var url = "https://github.com/login/device/code"
    url = strutil.Join([url, "?client_id="], "")
    var ci = clientId
    var ciEnc: str
    var i: int32 = 0
    while i < ci.len:
        let ch = ci[i]
        if (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || (ch >= 48 && ch <= 57) || ch == 45 || ch == 46 || ch == 95 || ch == 126:
            ciEnc = strutil.Join([ciEnc, strings.SliceBytes(ci, i, 1)], "")
        elif ch == 32:
            ciEnc = strutil.Join([ciEnc, "+"], "")
        else:
            var hi = ch / 16
            var lo = ch % 16
            ciEnc = strutil.Join([ciEnc, "%", strings.SliceBytes(HexDigits, hi, 1), strings.SliceBytes(HexDigits, lo, 1)], "")
        i = i + 1
    url = strutil.Join([url, ciEnc], "")
    url = strutil.Join([url, "&scope=read%3Auser+repo"], "")
    return url

fn loginValidateAuthUrl(authUrl: str): bool =
    if authUrl.len < 8:
        return false
    if strings.HasPrefix(authUrl, "https://"):
        return true
    if strings.HasPrefix(authUrl, "http://localhost"):
        return true
    if strings.HasPrefix(authUrl, "http://127.0.0.1"):
        return true
    return false

fn loginValidateParams(clientId: str, redirectUri: str): bool =
    if clientId == "":
        return false
    if redirectUri == "":
        return false
    return true
