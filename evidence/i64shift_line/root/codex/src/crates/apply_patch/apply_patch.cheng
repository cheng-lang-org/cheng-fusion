import std/strings
import std/strutils as strutil

# Apply-patch parser (ported from codex-rs apply-patch crate)
# Parses unified diff format into structured hunk data.

type
    RustCsgParsePatchResult =
        ok: bool
        error: str
        hunkTags: int32[]
        hunkPaths: str[]
        hunkContents: str[]
        oldStarts: int32[]
        oldCounts: int32[]
        newStarts: int32[]
        newCounts: int32[]
        lineCounts: int32[]
        hunkLines: str[]

# Generate unified diff from old and new content using LCS-based diff
fn generateUnifiedDiff(oldFile: str, newFile: str, oldContent: str, newContent: str): str =
    var result: str = strutil.Join(["--- ", oldFile, "\n+++ ", newFile, "\n"], "")
    if oldContent == "" && newContent == "":
        return result
    var oldLines: str[]
    var newLines: str[]
    var oldN: int32 = 0
    var newN: int32 = 0
    if oldContent != "":
        oldLines = strutil.Split(oldContent, '\n')
        oldN = oldLines.len
    if newContent != "":
        newLines = strutil.Split(newContent, '\n')
        newN = newLines.len
    let stride = newN + 1
    var tableSize = (oldN + 1) * stride
    var dp: int32[]
    var dpIdx: int32 = 0
    while dpIdx < tableSize:
        add(dp, 0)
        dpIdx = dpIdx + 1
    var i: int32 = 0
    while i < oldN:
        var j: int32 = 0
        while j < newN:
            let cell = (i + 1) * stride + (j + 1)
            if oldLines[i] == newLines[j]:
                dp[cell] = dp[i * stride + j] + 1
            else:
                let up = dp[i * stride + (j + 1)]
                let left = dp[(i + 1) * stride + j]
                if up >= left:
                    dp[cell] = up
                else:
                    dp[cell] = left
            j = j + 1
        i = i + 1
    var rOps: int32[]
    var rOldTxt: str[]
    var rNewTxt: str[]
    i = oldN
    var j: int32 = newN
    while i > 0 || j > 0:
        if i > 0 && j > 0 && oldLines[i - 1] == newLines[j - 1]:
            add(rOps, 0)
            add(rOldTxt, oldLines[i - 1])
            add(rNewTxt, oldLines[i - 1])
            i = i - 1
            j = j - 1
        else:
            if i > 0 && (j == 0 || dp[(i - 1) * stride + j] >= dp[i * stride + (j - 1)]):
                add(rOps, 1)
                add(rOldTxt, oldLines[i - 1])
                add(rNewTxt, "")
                i = i - 1
            else:
                add(rOps, 2)
                add(rOldTxt, "")
                add(rNewTxt, newLines[j - 1])
                j = j - 1
    let totalOps = rOps.len
    var firstChange: int32 = totalOps
    var idx: int32 = totalOps - 1
    while idx >= 0:
        if rOps[idx] != 0:
            firstChange = totalOps - 1 - idx
            break
        idx = idx - 1
    if firstChange >= totalOps:
        return result
    var oldTrack: int32 = 1
    var newTrack: int32 = 1
    idx = totalOps - 1
    while idx >= 0:
        let fwdIdx = totalOps - 1 - idx
        if fwdIdx >= firstChange:
            break
        if rOps[idx] == 0 || rOps[idx] == 1:
            oldTrack = oldTrack + 1
        if rOps[idx] == 0 || rOps[idx] == 2:
            newTrack = newTrack + 1
        idx = idx - 1
    let hunkOldStart: int32 = oldTrack
    let hunkNewStart: int32 = newTrack
    var hunkLines: str[]
    while idx >= 0:
        if rOps[idx] == 0:
            add(hunkLines, strutil.Join([" ", rOldTxt[idx], "\n"], ""))
            oldTrack = oldTrack + 1
            newTrack = newTrack + 1
        else:
            if rOps[idx] == 1:
                add(hunkLines, strutil.Join(["-", rOldTxt[idx], "\n"], ""))
                oldTrack = oldTrack + 1
            else:
                add(hunkLines, strutil.Join(["+", rNewTxt[idx], "\n"], ""))
                newTrack = newTrack + 1
        idx = idx - 1
    let oldCnt = oldTrack - hunkOldStart
    let newCnt = newTrack - hunkNewStart
    let hdr = strutil.Join(["@@ -", strings.IntToStr(hunkOldStart), ",", strings.IntToStr(oldCnt),
                            " +", strings.IntToStr(hunkNewStart), ",", strings.IntToStr(newCnt), " @@\n"], "")
    result = strutil.Join([result, hdr], "")
    idx = 0
    while idx < hunkLines.len:
        result = strutil.Join([result, hunkLines[idx]], "")
        idx = idx + 1
    return result

# Apply a single parsed hunk to file content
fn applyHunkToContent(content: str, oldStart: int32, oldCount: int32, newStart: int32, newCount: int32, hunkOps: str[], outResult: var str): bool =
    outResult = ""
    if content == "":
        return false
    let lines = strutil.Split(content, '\n')
    let n = lines.len
    let pos = oldStart - 1
    if pos < 0 || pos + oldCount > n:
        return false
    var opIdx: int32 = 0
    var lineIdx: int32 = pos
    var allMatch: bool = true
    while opIdx < hunkOps.len && allMatch:
        let op = hunkOps[opIdx]
        if op.len > 0:
            let prefix = op[0]
            if prefix == ' ' || prefix == '-':
                if lineIdx >= n || lines[lineIdx] != strings.SliceBytes(op, 1, op.len - 1):
                    allMatch = false
                else:
                    lineIdx = lineIdx + 1
        opIdx = opIdx + 1
    if !allMatch:
        return false
    var newLines: str[]
    var i: int32 = 0
    while i < pos:
        add(newLines, lines[i])
        i = i + 1
    opIdx = 0
    while opIdx < hunkOps.len:
        let op = hunkOps[opIdx]
        if op.len > 0:
            let prefix = op[0]
            if prefix == ' ' || prefix == '+':
                add(newLines, strings.SliceBytes(op, 1, op.len - 1))
        opIdx = opIdx + 1
    i = pos + oldCount
    while i < n:
        add(newLines, lines[i])
        i = i + 1
    var res: str = ""
    i = 0
    while i < newLines.len:
        if i > 0:
            res = strutil.Join([res, "\n"], "")
        res = strutil.Join([res, newLines[i]], "")
        i = i + 1
    outResult = res
    return true

# ── Patch syntax validation ──
# Validates unified diff format without applying.
# Checks: file headers (---/+++), hunk headers (@@), line prefixes (+/-/space).

fn patchValidateSyntax(patch: str, outError: var str): bool =
    outError = ""
    if patch == "":
        outError = "empty patch"
        return false
    let lines = strutil.Split(patch, '\n')
    let n = lines.len
    if n == 0:
        outError = "empty patch"
        return false
    var i: int32 = 0
    var expectHeader: bool = true
    var hadHeader: bool = false
    var hadHunk: bool = false
    while i < n:
        let line = lines[i]
        if line == "":
            i = i + 1
            continue
        if strutil.StartsWith(line, "--- "):
            hadHeader = true
            expectHeader = false
            # Check that the --- line has content after the prefix
            if line.len <= 4:
                outError = "--- header missing filename"
                return false
        elif strutil.StartsWith(line, "+++ "):
            if !hadHeader:
                outError = "+++ without preceding ---"
                return false
            if line.len <= 4:
                outError = "+++ header missing filename"
                return false
            expectHeader = false
        elif strutil.StartsWith(line, "@@"):
            if !hadHeader:
                outError = "hunk without file header"
                return false
            hadHunk = true
            expectHeader = false
            # Validate hunk header format: @@ -a,b +c,d @@
            var pos: int32 = 2
            # skip to first number after -
            while pos < line.len && line[pos] == ' ':
                pos = pos + 1
            if pos >= line.len || line[pos] != '-':
                outError = "hunk header missing '-'"
                return false
            pos = pos + 1
            var foundDigit: bool = false
            while pos < line.len && line[pos] >= '0' && line[pos] <= '9':
                foundDigit = true
                pos = pos + 1
            if !foundDigit:
                outError = "hunk header missing old-start number"
                return false
            if pos < line.len && line[pos] == ',':
                pos = pos + 1
                foundDigit = false
                while pos < line.len && line[pos] >= '0' && line[pos] <= '9':
                    foundDigit = true
                    pos = pos + 1
                if !foundDigit:
                    outError = "hunk header missing old-count number"
                    return false
            while pos < line.len && line[pos] == ' ':
                pos = pos + 1
            if pos >= line.len || line[pos] != '+':
                outError = "hunk header missing '+'"
                return false
            pos = pos + 1
            foundDigit = false
            while pos < line.len && line[pos] >= '0' && line[pos] <= '9':
                foundDigit = true
                pos = pos + 1
            if !foundDigit:
                outError = "hunk header missing new-start number"
                return false
            if pos < line.len && line[pos] == ',':
                pos = pos + 1
                foundDigit = false
                while pos < line.len && line[pos] >= '0' && line[pos] <= '9':
                    foundDigit = true
                    pos = pos + 1
                if !foundDigit:
                    outError = "hunk header missing new-count number"
                    return false
            while pos < line.len && line[pos] == ' ':
                pos = pos + 1
            if pos >= line.len || line[pos] != '@' || pos + 1 >= line.len || line[pos+1] != '@':
                outError = "hunk header missing trailing @@"
                return false
        elif strutil.StartsWith(line, "---"):
            outError = "--- without space after marker"
            return false
        elif strutil.StartsWith(line, "+++"):
            outError = "+++ without space after marker"
            return false
        elif strutil.StartsWith(line, "@"):
            outError = "@ without @ after it"
            return false
        else:
            # Content line: must start with ' ', '+', or '-'
            let c0 = line[0]
            if c0 != ' ' && c0 != '+' && c0 != '-':
                outError = "line does not start with ' ', '+', or '-'"
                return false
            if !hadHeader:
                outError = "content line without file header"
                return false
        i = i + 1
    if !hadHeader && !hadHunk:
        outError = "patch has no headers or hunks"
        return false
    return true

# ── Patch statistics ──
# Counts additions, deletions, and files changed in a unified diff.

fn patchComputeStats(patch: str, outAdditions: var int32, outDeletions: var int32, outFilesChanged: var int32, outError: var str) =
    outAdditions = 0
    outDeletions = 0
    outFilesChanged = 0
    outError = ""
    if patch == "":
        return
    let lines = strutil.Split(patch, '\n')
    let n = lines.len
    var i: int32 = 0
    var fileCounted: bool = false
    while i < n:
        let line = lines[i]
        if line == "":
            i = i + 1
            continue
        if strutil.StartsWith(line, "--- "):
            fileCounted = false
        elif strutil.StartsWith(line, "+++ "):
            if !fileCounted:
                outFilesChanged = outFilesChanged + 1
                fileCounted = true
        else:
            if line.len > 0:
                let c0 = line[0]
                if c0 == '+':
                    outAdditions = outAdditions + 1
                elif c0 == '-':
                    outDeletions = outDeletions + 1
        i = i + 1
