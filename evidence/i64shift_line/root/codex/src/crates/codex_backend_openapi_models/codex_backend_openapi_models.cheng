# Validate a model name and version string.
# Model name must be non-empty and start with a letter or digit.
# Version must be non-empty and match "major.minor" or "major.minor.patch" pattern.
# Returns "" on success, or an error message string describing the validation failure.
fn RustCsgOpenApiValidateModel(name: str, version: str): str =
    if name.len == 0:
        return "model name must not be empty"
    let first = name[0]
    if !(first >= 'a' && first <= 'z') && !(first >= 'A' && first <= 'Z') && !(first >= '0' && first <= '9'):
        return "model name must start with a letter or digit"
    if version.len == 0:
        return "model version must not be empty"
    # Check version format: digit(s).digit(s)[.digit(s)]
    var dotCount: int32 = 0
    var segStart: int32 = 0
    var i: int32 = 0
    while i <= version.len:
        if i == version.len || version[i] == '.':
            if i == segStart:
                return "model version has empty segment"
            segStart = i + 1
            if i < version.len:
                dotCount = dotCount + 1
        else:
            let ch = version[i]
            if ch < '0' || ch > '9':
                return "model version contains non-digit character"
        i = i + 1
    if dotCount < 1 || dotCount > 2:
        return "model version must have 1 or 2 dots"
    return ""

