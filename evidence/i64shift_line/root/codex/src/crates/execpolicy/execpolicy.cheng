# ═══════════════════════════════════════════════════════════════════════════════
# execpolicy: execution policy evaluation for path-based access rules
# Ported from codex-rs/execpolicy
# ═══════════════════════════════════════════════════════════════════════════════

# ── Decision enum constants ──────────────────────────────────────────────────
const
    RustCsgExecpolicyDecisionAllow: int32 = 0
    RustCsgExecpolicyDecisionPrompt: int32 = 1
    RustCsgExecpolicyDecisionForbidden: int32 = 2

# ── NetworkRuleProtocol enum constants ──────────────────────────────────────
const
    RustCsgExecpolicyNetworkRuleProtocolHttp: int32 = 0
    RustCsgExecpolicyNetworkRuleProtocolHttps: int32 = 1
    RustCsgExecpolicyNetworkRuleProtocolSocks5Tcp: int32 = 2
    RustCsgExecpolicyNetworkRuleProtocolSocks5Udp: int32 = 3

# ── PatternToken enum constants ─────────────────────────────────────────────
const
    RustCsgExecpolicyPatternTokenSingle: int32 = 0
    RustCsgExecpolicyPatternTokenAlts: int32 = 1

# ── RuleMatch enum constants ────────────────────────────────────────────────
const
    RustCsgExecpolicyRuleMatchPrefixRuleMatch: int32 = 0
    RustCsgExecpolicyRuleMatchHeuristicsRuleMatch: int32 = 1

# ── Evaluate prefix rule ─────────────────────────────────────────────────────
# Evaluate a path-based prefix rule against a requested path.
# rulePrefix may contain '*' as a wildcard matching any character(s) including '/'.
# For rules without wildcards, the requested path must match at a path boundary.
fn RustCsgExecpolicyEvaluatePrefixRule(requestedPath: str, rulePrefix: str, ruleDecision: int32): bool =
    var starIdx: int32 = -1
    for i in 0..<rulePrefix.len:
        if rulePrefix[i] == '*':
            starIdx = i
            break
    if starIdx < 0:
        # No wildcard: match at path boundary via direct char comparison
        if rulePrefix.len > requestedPath.len:
            return false
        for i in 0..<rulePrefix.len:
            if requestedPath[i] != rulePrefix[i]:
                return false
        if requestedPath.len == rulePrefix.len:
            return true
        if rulePrefix.len > 0 && rulePrefix[rulePrefix.len - 1] == '/':
            return true
        if requestedPath[rulePrefix.len] == '/':
            return true
        return false
    # Wildcard at starIdx: left part must be a prefix (path boundary)
    if starIdx > 0:
        if starIdx > requestedPath.len:
            return false
        for i in 0..<starIdx:
            if requestedPath[i] != rulePrefix[i]:
                return false
        # Path boundary: left part ends with / or next char is /
        if starIdx < requestedPath.len:
            if rulePrefix[starIdx - 1] != '/' && requestedPath[starIdx] != '/':
                return false
    # Right part (after *) must be contained in requestedPath
    let rightStart: int32 = starIdx + 1
    if rightStart < rulePrefix.len:
        let needleLen: int32 = rulePrefix.len - rightStart
        var found: bool = false
        var j: int32 = 0
        while j + needleLen <= requestedPath.len && !found:
            var matched: bool = true
            for k in 0..<needleLen:
                if requestedPath[j + k] != rulePrefix[rightStart + k]:
                    matched = false
                    break
            if matched:
                found = true
            j = j + 1
        if !found:
            return false
    return true

# ── Decision predicates ─────────────────────────────────────────────────────
fn RustCsgExecpolicyDecisionIsAllowed(v: int32): bool = v == RustCsgExecpolicyDecisionAllow
fn RustCsgExecpolicyDecisionRequiresPrompt(v: int32): bool = v == RustCsgExecpolicyDecisionPrompt
fn RustCsgExecpolicyDecisionIsForbidden(v: int32): bool = v == RustCsgExecpolicyDecisionForbidden
