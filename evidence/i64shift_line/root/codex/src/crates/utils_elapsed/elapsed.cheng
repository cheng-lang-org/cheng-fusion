import std/strings
import std/strutils as strutil

fn RustCsgUtilsElapsedFormatDurationMillis(duration_ms: int64): str =
    if duration_ms < 1000:
        return strutil.Join([strings.Int64ToStr(duration_ms), "ms"], "")
    if duration_ms < 60000:
        let millis = int32(duration_ms)
        let hundredths = (millis + 5) / 10
        let whole = hundredths / 100
        let frac = hundredths % 100
        var fracStr: str
        if frac < 10:
            fracStr = strutil.Join(["0", strings.IntToStr(frac)], "")
        else:
            fracStr = strings.IntToStr(frac)
        return strutil.Join([strings.IntToStr(whole), ".", fracStr, "s"], "")
    let minutes = duration_ms / 60000
    let seconds = (duration_ms % 60000) / 1000
    var secStr: str
    if seconds < 10:
        secStr = strutil.Join(["0", strings.Int64ToStr(seconds)], "")
    else:
        secStr = strings.Int64ToStr(seconds)
    return strutil.Join([strings.Int64ToStr(minutes), "m ", secStr, "s"], "")

fn format_duration(duration_ms: int64): str =
    return RustCsgUtilsElapsedFormatDurationMillis(duration_ms)
