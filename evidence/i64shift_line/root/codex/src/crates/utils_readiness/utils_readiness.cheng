import std/strings as strings

# ── ReadinessFlag: state machine with subscribe/mark_ready semantics ──
# State machine: NotReady -> Ready (one-way transition)

type
    ReadinessFlagState = enum
        NotReady
        Ready

type
    ReadinessFlag =
        state: ReadinessFlagState

fn newReadinessFlag(): ReadinessFlag =
    var flag: ReadinessFlag
    flag.state = ReadinessFlagState.NotReady
    return flag

fn isReady(flag: var ReadinessFlag): bool =
    return flag.state == ReadinessFlagState.Ready

fn markReady(flag: var ReadinessFlag): bool =
    # Returns true if transition happened, false if already ready
    if flag.state == ReadinessFlagState.Ready:
        return false
    flag.state = ReadinessFlagState.Ready
    return true

fn readinessStateToString(flag: var ReadinessFlag): str =
    if flag.state == ReadinessFlagState.Ready:
        return "ready"
    return "not_ready"

# Poll/simulate waiting for flag to be ready with timeout in ms.
# Always checks at least once, even with 0 timeout.
fn readinessWaitUntilReady(flag: var ReadinessFlag, timeoutMs: int32): bool =
    var elapsed: int32 = 0
    while true:
        if isReady(flag):
            return true
        elapsed = elapsed + 10
        if elapsed > timeoutMs:
            return false
    return false
