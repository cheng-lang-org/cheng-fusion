import std/strings
import std/strutils as strutil

# LRU Cache — production implementation backed by C parallel arrays
#
# Uses a monotonic clock (global counter incremented on each access) to track
# recency. The cache with the smallest accessTime is the LRU victim.

@importc("RustCsgLruNew")
fn RustCsgLruNew(capacity: int32): int32

@abi_internal
@importc("RustCsgLruPut")
fn RustCsgLruPut(handle: int32, key: str, value: str, outEvictedKey: var str, outOk: var bool)

@abi_internal
@importc("RustCsgLruGet")
fn RustCsgLruGet(handle: int32, key: str, outValue: var str, outOk: var bool)

@abi_internal
@importc("RustCsgLruRemove")
fn RustCsgLruRemove(handle: int32, key: str, outOk: var bool)

@importc("RustCsgLruClear")
fn RustCsgLruClear(handle: int32)

@importc("RustCsgLruStats")
fn RustCsgLruStats(handle: int32, outHits: var int32, outMisses: var int32, outEvictions: var int32)

@abi_internal
@importc("RustCsgLruPeek")
fn RustCsgLruPeek(handle: int32, key: str, outValue: var str, outOk: var bool)

@importc("RustCsgLruResize")
fn RustCsgLruResize(handle: int32, newCapacity: int32, outEvictedCount: var int32)

@abi_internal
@importc("RustCsgLruContains")
fn RustCsgLruContains(handle: int32, key: str): bool

@importc("RustCsgLruCapacity")
fn RustCsgLruCapacity(handle: int32): int32

@abi_internal
@importc("RustCsgLruKeys")
fn RustCsgLruKeys(handle: int32): str

@abi_internal
@importc("RustCsgLruValues")
fn RustCsgLruValues(handle: int32): str

# ── Public API ──────────────────────────────────────────────────────

fn lruCacheNew(capacity: int32): int32 =
    return RustCsgLruNew(capacity)

fn lruCachePut(handle: int32, key: str, value: str, outEvictedKey: var str, outOk: var bool) =
    RustCsgLruPut(handle, key, value, outEvictedKey, outOk)

fn lruCacheGet(handle: int32, key: str, outValue: var str, outOk: var bool) =
    RustCsgLruGet(handle, key, outValue, outOk)

fn lruCacheRemove(handle: int32, key: str, outOk: var bool) =
    RustCsgLruRemove(handle, key, outOk)

fn lruCacheClear(handle: int32) =
    RustCsgLruClear(handle)

fn lruCacheStats(handle: int32, outHits: var int32, outMisses: var int32, outEvictions: var int32) =
    RustCsgLruStats(handle, outHits, outMisses, outEvictions)

fn lruCachePeek(handle: int32, key: str, outValue: var str, outOk: var bool) =
    RustCsgLruPeek(handle, key, outValue, outOk)

fn lruCacheResize(handle: int32, newCapacity: int32, outEvictedCount: var int32) =
    RustCsgLruResize(handle, newCapacity, outEvictedCount)

fn lruCacheContains(handle: int32, key: str): bool =
    return RustCsgLruContains(handle, key)

fn lruCacheCapacity(handle: int32): int32 =
    return RustCsgLruCapacity(handle)

fn lruCacheKeys(handle: int32): str =
    return RustCsgLruKeys(handle)

fn lruCacheValues(handle: int32): str =
    return RustCsgLruValues(handle)

# ── Get-or-Insert (atomic) ───────────────────────────────────────────────
# If key exists, returns its value and sets outInserted=false.
# If not, inserts (key, fallback), returns fallback, outInserted=true.

fn lruCacheGetOrInsert(handle: int32, key: str, fallback: str,
                       outValue: var str, outInserted: var bool) =
    var got: str
    var getOk: bool
    lruCacheGet(handle, key, got, getOk)
    if getOk:
        outValue = got
        outInserted = false
    else:
        var evicted: str
        var putOk: bool
        lruCachePut(handle, key, fallback, evicted, putOk)
        outValue = fallback
        outInserted = true

# ── Export All Entries as Delimited String ─────────────────────────────────
# Concatenates keys and values into a single string.
# Format: "k:<keys-delimited> v:<values-delimited>"

fn lruCacheToArray(handle: int32): str =
    let keys = RustCsgLruKeys(handle)
    let values = RustCsgLruValues(handle)
    return strutil.Join(["k:", keys, " v:", values], "")
