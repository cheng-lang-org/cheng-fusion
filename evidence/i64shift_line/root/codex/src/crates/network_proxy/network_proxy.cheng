import std/strings
import std/strutils as strutil

# ═══════════════════════════════════════════════════════════════════════════════
# Library: network-proxy — parse proxy URLs into scheme, host, port
# ═══════════════════════════════════════════════════════════════════════════════

# Find first occurrence of a character in a string, or -1 if not found.
fn RustCsgStrFindChar(text: str, ch: char): int32 =
    var i: int32 = 0
    while i < text.len:
        if text[i] == ch:
            return i
        i = i + 1
    return -1

# Find last occurrence of a character in a string, or -1 if not found.
fn RustCsgStrRFindChar(text: str, ch: char): int32 =
    var i: int32 = text.len - 1
    while i >= 0:
        if text[i] == ch:
            return i
        i = i - 1
    return -1

# Parse a positive int32 from a decimal string.
fn RustCsgParsePositiveInt32(s: str): int32 =
    if s.len == 0:
        return 0
    var val: int32 = 0
    var i: int32 = 0
    while i < s.len:
        let ch = s[i]
        if ch < '0' || ch > '9':
            break
        val = val * 10 + (Int32(ch) - 48)
        i = i + 1
    return val

# Parse a proxy URL and extract scheme, host, port via out parameters.
# Input format: scheme://host:port  or  scheme://user:pass@host:port
# On invalid input, outScheme/outHost/outPort are set to empty/0.
fn RustCsgNetworkProxyParseProxyUrl(url: str, outScheme: var str, outHost: var str, outPort: var int32) =
    outScheme = ""
    outHost = ""
    outPort = 0

    if url.len == 0:
        return

    # Find :// separator
    var schemeEnd: int32 = -1
    var i: int32 = 0
    while i + 2 < url.len:
        if url[i] == ':' && url[i + 1] == '/' && url[i + 2] == '/':
            schemeEnd = i
            break
        i = i + 1

    if schemeEnd < 0:
        return

    # Extract scheme
    outScheme = strings.SliceBytes(url, 0, schemeEnd)

    # Rest after ://
    let afterScheme = schemeEnd + 3
    let remaining = strings.SliceBytes(url, afterScheme, url.len - afterScheme)

    if remaining.len == 0:
        return

    # Skip userinfo@ if present
    let atPos = RustCsgStrFindChar(remaining, '@')
    var hostPortStart: int32 = 0
    if atPos >= 0:
        hostPortStart = atPos + 1

    let hostPortStr = strings.SliceBytes(remaining, hostPortStart, remaining.len - hostPortStart)

    if hostPortStr.len == 0:
        return

    # Find port separator (last colon)
    let colonPos = RustCsgStrRFindChar(hostPortStr, ':')
    if colonPos >= 0:
        outHost = strings.SliceBytes(hostPortStr, 0, colonPos)
        let portStr = strings.SliceBytes(hostPortStr, colonPos + 1, hostPortStr.len - colonPos - 1)
        outPort = RustCsgParsePositiveInt32(portStr)
    else:
        outHost = hostPortStr
