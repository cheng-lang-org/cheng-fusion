# rmcp-client: MCP (Model Context Protocol) client utilities
# Ported from codex-rs/rmcp-client/src/
#
# Provides buildMcpInitializeRequest for constructing MCP initialize JSON-RPC requests
# and parseMcpResponse for extracting result/error from MCP JSON-RPC responses.

import std/strutils as strutil
import std/strings

# ── buildMcpInitializeRequest ──────────────────────────────────────────────
# Build an MCP initialize JSON-RPC request.
# Returns the JSON-RPC 2.0 initialize request as a string.
fn RustCsgRmcpClientBuildInitializeRequest(clientName: str, version: str): str =
    # Build the inner clientInfo object
    let clientInfo = strutil.Join([
        "{\"name\":\"",
        jsonEscape(clientName),
        "\",\"version\":\"",
        jsonEscape(version),
        "\"}"
    ], "")

    # Build the full request
    return strutil.Join([
        "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{",
        "\"protocolVersion\":\"2024-11-05\",",
        "\"capabilities\":{},",
        "\"clientInfo\":",
        clientInfo,
        "}}"
    ], "")

# ── jsonEscape ─────────────────────────────────────────────────────────────
# Escape a string for inclusion in a JSON string value.
fn jsonEscape(s: str): str =
    if s.len == 0:
        return ""
    var result: str = ""
    var i: int32 = 0
    while i < s.len:
        let ch = s[i]
        if ch == '"':
            result = strings.ConcatStr(result, "\\\"")
        elif ch == '\\':
            result = strings.ConcatStr(result, "\\\\")
        elif ch == '\n':
            result = strings.ConcatStr(result, "\\n")
        elif ch == '\t':
            result = strings.ConcatStr(result, "\\t")
        elif ch == '\r':
            result = strings.ConcatStr(result, "\\r")
        else:
            result = strings.ConcatStr(result, strings.SliceBytes(s, i, 1))
        i = i + 1
    return result

# ── parseMcpResponse ──────────────────────────────────────────────────────
# Parse an MCP JSON-RPC response to extract result or error.
# Uses simple substring scanning to find "result" or "error" keys.
# Returns true on success with outResult/outError set appropriately.
fn RustCsgRmcpClientParseMcpResponse(json: str, outResult: var str, outError: var str): bool =
    outResult = ""
    outError = ""
    if json.len == 0:
        return false

    let n: int32 = json.len

    # Check for "error": key
    var errIdx: int32 = -1
    var i: int32 = 0
    let errEnd: int32 = n - 7
    while i < errEnd:
        if json[i] == '"' && json[i+1] == 'e' && json[i+2] == 'r' &&
           json[i+3] == 'r' && json[i+4] == 'o' && json[i+5] == 'r' &&
           json[i+6] == '"' && json[i+7] == ':':
            errIdx = i
            break
        i = i + 1

    # Check for "result": key
    var resultIdx: int32 = -1
    i = 0
    let resEnd: int32 = n - 8
    while i < resEnd:
        if json[i] == '"' && json[i+1] == 'r' && json[i+2] == 'e' &&
           json[i+3] == 's' && json[i+4] == 'u' && json[i+5] == 'l' &&
           json[i+6] == 't' && json[i+7] == '"' && json[i+8] == ':':
            resultIdx = i
            break
        i = i + 1

    # ── Error path ──────────────────────────────────────────────────────────
    if errIdx >= 0:
        var searchStart: int32 = errIdx + 8
        let msgEnd: int32 = n - 9
        if searchStart < msgEnd:
            i = searchStart
            while i < msgEnd:
                if json[i] == '"' && json[i+1] == 'm' && json[i+2] == 'e' &&
                   json[i+3] == 's' && json[i+4] == 's' && json[i+5] == 'a' &&
                   json[i+6] == 'g' && json[i+7] == 'e' && json[i+8] == '"' &&
                   json[i+9] == ':':
                    let valStart: int32 = i + 10
                    if valStart < n && json[valStart] == '"':
                        var valEnd: int32 = valStart + 1
                        while valEnd < n && json[valEnd] != '"':
                            valEnd = valEnd + 1
                        if valEnd > valStart + 1 && valEnd <= n:
                            outError = strings.SliceBytes(json, valStart + 1, valEnd - valStart - 1)
                    break
                i = i + 1
        if outError.len == 0:
            outError = "unknown error"
        return true

    # ── Result path ─────────────────────────────────────────────────────────
    if resultIdx >= 0:
        let valStart: int32 = resultIdx + 9
        # Skip whitespace
        var vPos: int32 = valStart
        while vPos < n && json[vPos] == ' ':
            vPos = vPos + 1
        if vPos < n:
            var vEnd: int32 = vPos
            var depth: int32 = 0
            while vEnd < n:
                let ch: char = json[vEnd]
                if ch == '{' || ch == '[':
                    depth = depth + 1
                    vEnd = vEnd + 1
                elif ch == '}' || ch == ']':
                    depth = depth - 1
                    vEnd = vEnd + 1
                    if depth <= 0:
                        break
                elif ch == ',' && depth == 0:
                    break
                else:
                    vEnd = vEnd + 1
            if vEnd > vPos:
                outResult = strings.SliceBytes(json, vPos, vEnd - vPos)
        if outResult.len == 0:
            outResult = "null"
        return true

    return false

# Build a JSON-RPC 2.0 notification (no "id" field).
# Returns the JSON string, or "" if method is empty.
fn RustCsgRmcpClientBuildNotification(method: str, params: str): str =
    if method.len == 0:
        return ""
    if params.len == 0:
        return strutil.Join([
            "{\"jsonrpc\":\"2.0\",\"method\":\"",
            jsonEscape(method),
            "\"}"
        ], "")
    return strutil.Join([
        "{\"jsonrpc\":\"2.0\",\"method\":\"",
        jsonEscape(method),
        "\",\"params\":",
        params,
        "}"
    ], "")
