# HTTP Foundation: URL parser, HTTP/1.1 message builder and response parser
# Production implementations with real HTTP format handling.

import std/strings
import std/strutils as strutil

# ═══════════════════════════════════════════════════════════════════════════
# URL Parser
# ═══════════════════════════════════════════════════════════════════════════

# Parse "https://host:port/path" into components.
# On success: outOk=true, outPort=0 means "no port specified" (use default).
# On failure: outOk=false, output fields are undefined.
fn parseUrl(url: str, urlLen: int32, outScheme: var str, outHost: var str,
             outPort: var int32, outPath: var str, outOk: var bool) =
    outOk = false
    outScheme = ""
    outHost = ""
    outPort = 0
    outPath = ""

    if urlLen == 0:
        return

    var i: int32 = 0
    var foundColon: bool = false
    while i < urlLen && !foundColon:
        if url[i] == ':':
            foundColon = true
        else:
            i = i + 1
    if !foundColon:
        return
    outScheme = strings.SliceBytes(url, 0, i)

    if i + 3 > urlLen:
        return
    if url[i + 1] != '/' || url[i + 2] != '/':
        return
    i = i + 3

    let authStart: int32 = i

    var foundSlash: bool = false
    while i < urlLen && !foundSlash:
        if url[i] == '/':
            foundSlash = true
        else:
            i = i + 1

    let authLen: int32 = i - authStart

    var auth: str = ""
    if authLen > 0:
        auth = strings.SliceBytes(url, authStart, authLen)

    var colonPos: int32 = -1
    var ci: int32 = 0
    while ci < auth.len:
        if auth[ci] == ':':
            colonPos = ci
        ci = ci + 1

    if colonPos >= 0:
        outHost = strings.SliceBytes(auth, 0, colonPos)
        var portStr: str = ""
        let portLen: int32 = auth.len - colonPos - 1
        if portLen > 0:
            portStr = strings.SliceBytes(auth, colonPos + 1, portLen)
            var portVal: int32 = 0
            var di: int32 = 0
            while di < portStr.len:
                let d = Int32(portStr[di])
                portVal = portVal * 10 + (d - 48)
                di = di + 1
            outPort = portVal
    else:
        outHost = auth

    if i < urlLen:
        outPath = strings.SliceBytes(url, i, urlLen - i)

    outOk = true

# ═══════════════════════════════════════════════════════════════════════════
# HTTP/1.1 Message Builder
# ═══════════════════════════════════════════════════════════════════════════

fn buildHttpGetRequest(host: str, path: str): str =
    var req = "GET "
    req = strutil.Join([req, path], "")
    req = strutil.Join([req, " HTTP/1.1\r\nHost: "], "")
    req = strutil.Join([req, host], "")
    req = strutil.Join([req, "\r\n\r\n"], "")
    return req

# ═══════════════════════════════════════════════════════════════════════════
# HTTP/1.1 Response Parser
# ═══════════════════════════════════════════════════════════════════════════

# Parse "HTTP/1.1 200 OK\r\nHeader: value\r\n\r\nbody"
fn parseHttpResponse(response: str, outStatusCode: var int32,
                     outBody: var str, outOk: var bool) =
    outOk = false
    outStatusCode = 0
    outBody = ""
    let n = response.len

    if !strings.HasPrefix(response, "HTTP/1.1 "):
        return

    var i: int32 = 9

    if i + 3 > n:
        return

    var code: int32 = 0
    var di: int32 = 0
    while di < 3:
        let d = Int32(response[i + di])
        if d < 48 || d > 57:
            return
        code = code * 10 + (d - 48)
        di = di + 1
    outStatusCode = code
    i = i + 3

    var foundSep: bool = false
    while i + 3 < n && !foundSep:
        if response[i] == '\r' && response[i + 1] == '\n' &&
           response[i + 2] == '\r' && response[i + 3] == '\n':
            i = i + 4
            foundSep = true
        else:
            i = i + 1

    if !foundSep && i + 1 < n:
        if response[i] == '\r' && response[i + 1] == '\n':
            i = i + 2
            foundSep = true

    if !foundSep:
        return

    if i < n:
        outBody = strings.SliceBytes(response, i, n - i)
    outOk = true

# ═══════════════════════════════════════════════════════════════════════
# HTTP Header Parsing
# ═══════════════════════════════════════════════════════════════════════

# Extract Content-Type value from HTTP response headers section.
# Input is the raw response including status line; scans past status line
# then searches for "\r\nContent-Type: " (case-sensitive).
fn extractContentType(response: str, outType: var str, outOk: var bool) =
    outType = ""
    outOk = false
    let n = response.len
    var i: int32 = 0

    # Skip past status line ("HTTP/1.1 xxx ...\r\n")
    var foundStatusEnd: bool = false
    while i + 1 < n && !foundStatusEnd:
        if response[i] == '\r' && response[i + 1] == '\n':
            i = i + 2
            foundStatusEnd = true
        else:
            i = i + 1
    if !foundStatusEnd:
        return

    # Search for content-type header
    let prefix: str = "content-type: "
    var ci: int32 = 0
    var matched: bool = false
    while i < n && !matched:
        # Case-insensitive match attempt
        var mi: int32 = 0
        var possible: bool = true
        while mi < prefix.len && i + mi < n && possible:
            let ch = response[i + mi]
            let expected = prefix[mi]
            # Compare lowercased
            var chNorm: int32
            var expNorm: int32
            if ch >= 65 && ch <= 90:
                chNorm = ch + 32
            else:
                chNorm = ch
            if expected >= 65 && expected <= 90:
                expNorm = expected + 32
            else:
                expNorm = expected
            if chNorm != expNorm:
                possible = false
            mi = mi + 1
        if possible:
            matched = true
            i = i + prefix.len
        else:
            i = i + 1

    if !matched:
        return

    # Read value until \r\n
    var valStart: int32 = i
    while i < n && !(response[i] == '\r' && i + 1 < n && response[i + 1] == '\n'):
        i = i + 1
    let valLen: int32 = i - valStart
    if valLen > 0:
        outType = strings.SliceBytes(response, valStart, valLen)
    outOk = true

# Extract Content-Length value from HTTP response headers section.
# Returns the integer value (0 if not found or invalid).
fn extractContentLength(response: str, outLength: var int32, outOk: var bool) =
    outLength = 0
    outOk = false
    let n = response.len
    var i: int32 = 0

    # Skip past status line
    var foundStatusEnd: bool = false
    while i + 1 < n && !foundStatusEnd:
        if response[i] == '\r' && response[i + 1] == '\n':
            i = i + 2
            foundStatusEnd = true
        else:
            i = i + 1
    if !foundStatusEnd:
        return

    # Search for content-length header (case-insensitive)
    let prefix: str = "content-length: "
    var ci: int32 = 0
    var matched: bool = false
    while i < n && !matched:
        var mi: int32 = 0
        var possible: bool = true
        while mi < prefix.len && i + mi < n && possible:
            let ch = response[i + mi]
            let expected = prefix[mi]
            var chNorm: int32
            var expNorm: int32
            if ch >= 65 && ch <= 90:
                chNorm = ch + 32
            else:
                chNorm = ch
            if expected >= 65 && expected <= 90:
                expNorm = expected + 32
            else:
                expNorm = expected
            if chNorm != expNorm:
                possible = false
            mi = mi + 1
        if possible:
            matched = true
            i = i + prefix.len
        else:
            i = i + 1

    if !matched:
        return

    # Read numeric value until \r\n
    var valStart: int32 = i
    while i < n && !(response[i] == '\r' && i + 1 < n && response[i + 1] == '\n'):
        i = i + 1
    let valLen: int32 = i - valStart
    if valLen > 0:
        var val: int32 = 0
        var di: int32 = 0
        while di < valLen:
            let d = Int32(response[valStart + di])
            if d >= 48 && d <= 57:
                val = val * 10 + (d - 48)
            else:
                return  # non-digit in content-length value
            di = di + 1
        outLength = val
    outOk = true

# ═══════════════════════════════════════════════════════════════════════
# Chunked Transfer Encoding (conceptual)
# ═══════════════════════════════════════════════════════════════════════

# Check if response uses chunked transfer encoding.
# Scans header section (between status line and \r\n\r\n)
# for "transfer-encoding" header containing "chunked".
fn isChunkedTransferEncoding(response: str): bool =
    let n = response.len

    # Skip past status line to reach headers
    var i: int32 = 0
    var foundStatusEnd: bool = false
    while i + 1 < n && !foundStatusEnd:
        if response[i] == '\r' && response[i + 1] == '\n':
            i = i + 2
            foundStatusEnd = true
        else:
            i = i + 1
    if !foundStatusEnd:
        return false

    # Scan headers until \r\n\r\n looking for "chunked"
    while i + 3 < n:
        # Check for end of headers
        if response[i] == '\r' && response[i + 1] == '\n' &&
           response[i + 2] == '\r' && response[i + 3] == '\n':
            return false

        # Check for \r\n line boundary
        if response[i] == '\r' && response[i + 1] == '\n':
            i = i + 2
        else:
            # Check if current position starts "chunked" (case-insensitive)
            let needle: str = "chunked"
            var ni: int32 = 0
            var found: bool = true
            while ni < needle.len && i + ni < n && found:
                let ch = response[i + ni]
                var chLower: int32
                if ch >= 65 && ch <= 90:
                    chLower = ch + 32
                else:
                    chLower = ch
                if chLower != Int32(needle[ni]):
                    found = false
                ni = ni + 1
            if found:
                return true
            i = i + 1
    return false

# ═══════════════════════════════════════════════════════════════════════
# HTTP Status Code Classification
# ═══════════════════════════════════════════════════════════════════════

const
    HttpStatusClassInformational: int32 = 1   # 1xx
    HttpStatusClassSuccess: int32 = 2          # 2xx
    HttpStatusClassRedirection: int32 = 3      # 3xx
    HttpStatusClassClientError: int32 = 4      # 4xx
    HttpStatusClassServerError: int32 = 5      # 5xx
    HttpStatusClassUnknown: int32 = 0          # unclassified

# Classify an HTTP status code into its class (1xx/2xx/3xx/4xx/5xx).
fn classifyHttpStatusCode(statusCode: int32): int32 =
    if statusCode >= 100 && statusCode < 200:
        return HttpStatusClassInformational
    if statusCode >= 200 && statusCode < 300:
        return HttpStatusClassSuccess
    if statusCode >= 300 && statusCode < 400:
        return HttpStatusClassRedirection
    if statusCode >= 400 && statusCode < 500:
        return HttpStatusClassClientError
    if statusCode >= 500 && statusCode < 600:
        return HttpStatusClassServerError
    return HttpStatusClassUnknown

# Check if status code indicates success (2xx).
fn isHttpSuccess(statusCode: int32): bool =
    return statusCode >= 200 && statusCode < 300

# Check if status code indicates client error (4xx).
fn isHttpClientError(statusCode: int32): bool =
    return statusCode >= 400 && statusCode < 500

# Check if status code indicates server error (5xx).
fn isHttpServerError(statusCode: int32): bool =
    return statusCode >= 500 && statusCode < 600

# Check if status code is a redirect (301, 302, 307, 308).
fn isRedirect(statusCode: int32): bool =
    return statusCode == 301 || statusCode == 302 ||
           statusCode == 307 || statusCode == 308

# ═══════════════════════════════════════════════════════════════════════════
# HTTP/1.1 Request Builder — POST, PUT, DELETE
# ═══════════════════════════════════════════════════════════════════════════

# Build an HTTP POST request. If body is empty, Content-Length is still
# set to 0. If contentType is empty, no Content-Type header is emitted.
fn buildHttpPostRequest(host: str, path: str, body: str, contentType: str): str =
    var req = "POST "
    req = strutil.Join([req, path], "")
    req = strutil.Join([req, " HTTP/1.1\r\nHost: "], "")
    req = strutil.Join([req, host], "")
    if contentType != "":
        req = strutil.Join([req, "\r\nContent-Type: "], "")
        req = strutil.Join([req, contentType], "")
    req = strutil.Join([req, "\r\nContent-Length: "], "")
    req = strutil.Join([req, strings.Int64ToStr(int64(body.len))], "")
    req = strutil.Join([req, "\r\n\r\n"], "")
    if body != "":
        req = strutil.Join([req, body], "")
    return req

# Build an HTTP PUT request.
fn buildHttpPutRequest(host: str, path: str, body: str, contentType: str): str =
    var req = "PUT "
    req = strutil.Join([req, path], "")
    req = strutil.Join([req, " HTTP/1.1\r\nHost: "], "")
    req = strutil.Join([req, host], "")
    if contentType != "":
        req = strutil.Join([req, "\r\nContent-Type: "], "")
        req = strutil.Join([req, contentType], "")
    req = strutil.Join([req, "\r\nContent-Length: "], "")
    req = strutil.Join([req, strings.Int64ToStr(int64(body.len))], "")
    req = strutil.Join([req, "\r\n\r\n"], "")
    if body != "":
        req = strutil.Join([req, body], "")
    return req

# Build an HTTP DELETE request.
fn buildHttpDeleteRequest(host: str, path: str): str =
    var req = "DELETE "
    req = strutil.Join([req, path], "")
    req = strutil.Join([req, " HTTP/1.1\r\nHost: "], "")
    req = strutil.Join([req, host], "")
    req = strutil.Join([req, "\r\n\r\n"], "")
    return req

# Build an arbitrary HTTP/1.1 request with custom headers.
# headers array contains alternating key, value strings.
# Content-Length is auto-computed from body.
fn buildHttpRequest(method: str, host: str, path: str, headers: str[],
                     body: str): str =
    var req = method
    req = strutil.Join([req, " "], "")
    req = strutil.Join([req, path], "")
    req = strutil.Join([req, " HTTP/1.1\r\nHost: "], "")
    req = strutil.Join([req, host], "")
    var hi: int32 = 0
    while hi + 1 < headers.len:
        req = strutil.Join([req, "\r\n"], "")
        req = strutil.Join([req, headers[hi]], "")
        req = strutil.Join([req, ": "], "")
        hi = hi + 1
        req = strutil.Join([req, headers[hi]], "")
        hi = hi + 1
    req = strutil.Join([req, "\r\nContent-Length: "], "")
    req = strutil.Join([req, strings.Int64ToStr(int64(body.len))], "")
    req = strutil.Join([req, "\r\n\r\n"], "")
    if body != "":
        req = strutil.Join([req, body], "")
    return req

# ═══════════════════════════════════════════════════════════════════════════
# HTTP Response Header Parser — extract all headers
# ═══════════════════════════════════════════════════════════════════════════

# Parse all headers from an HTTP response. Skips the status line, then
# extracts each "Key: Value" pair until \r\n\r\n.
# Output arrays are populated with the header keys and values.
# outCount is the number of headers found.
# MaxHeaders is the maximum number of headers to parse (to avoid unbounded
# allocation). Callers should pass a reasonable upper bound.
fn parseHttpResponseHeaders(
    response: str,
    maxHeaders: int32,
    outKeys: var str[],
    outValues: var str[],
    outCount: var int32
) =
    outKeys = []
    outValues = []
    outCount = 0
    let n = response.len

    # Skip past status line ("HTTP/1.1 xxx ...\r\n")
    var i: int32 = 0
    var foundStatusEnd: bool = false
    while i + 1 < n && !foundStatusEnd:
        if response[i] == '\r' && response[i + 1] == '\n':
            i = i + 2
            foundStatusEnd = true
        else:
            i = i + 1
    if !foundStatusEnd:
        return

    # Parse header lines until \r\n\r\n (end of headers) or EOF
    while i + 1 < n && outCount < maxHeaders:
        # Check for end of headers (\r\n\r\n)
        if response[i] == '\r' && response[i + 1] == '\n':
            # Skip the terminating \r\n
            if i + 3 < n && response[i + 2] == '\r' && response[i + 3] == '\n':
                i = i + 4
            else:
                i = i + 2
            return  # End of headers section

        # Find the colon separating key from value
        var colonPos: int32 = i
        var foundColon: bool = false
        while colonPos < n && !foundColon:
            if response[colonPos] == ':':
                foundColon = true
            elif response[colonPos] == '\r' || response[colonPos] == '\n':
                # Malformed header line (no colon before line ending)
                # Skip to end of this line
                var skip: int32 = colonPos
                while skip < n && !(response[skip] == '\r' && skip + 1 < n && response[skip + 1] == '\n'):
                    skip = skip + 1
                i = skip + 2
                colonPos = i
            else:
                colonPos = colonPos + 1

        if !foundColon:
            return

        # Extract key (trim trailing whitespace)
        let keyStart: int32 = i
        let keyEnd: int32 = colonPos
        # Trim trailing spaces/tabs from key
        var ke: int32 = keyEnd
        while ke > keyStart:
            let ch = response[ke - 1]
            if ch == 32 || ch == 9:
                ke = ke - 1
            else:
                break
        let keyLen: int32 = ke - keyStart
        var key: str = ""
        if keyLen > 0:
            key = strings.SliceBytes(response, keyStart, keyLen)

        # Move past colon
        i = colonPos + 1

        # Skip leading whitespace in value
        while i < n:
            let ch = response[i]
            if ch == 32 || ch == 9:
                i = i + 1
            else:
                break

        # Extract value until \r\n
        let valStart: int32 = i
        while i < n && !(response[i] == '\r' && i + 1 < n && response[i + 1] == '\n'):
            i = i + 1
        let valLen: int32 = i - valStart
        var value: str = ""
        if valLen > 0:
            value = strings.SliceBytes(response, valStart, valLen)

        # Add to output arrays
        if keyLen > 0 && outCount < maxHeaders:
            add(outKeys, key)
            add(outValues, value)
            outCount = outCount + 1

        # Skip past \r\n
        i = i + 2

# ═══════════════════════════════════════════════════════════════════════════
# HTTP/1.1 Status Line Parser & Cookie Parser
# ═══════════════════════════════════════════════════════════════════════════

# Parse "HTTP/1.1 200 OK" into status code and reason phrase.
fn parseHttpStatusLine(line: str, outCode: var int32,
                        outReason: var str, outOk: var bool) =
    outOk = false
    outCode = 0
    outReason = ""
    if !strings.HasPrefix(line, "HTTP/1.1 "):
        return
    var i: int32 = 9
    if i + 3 > line.len:
        return
    var code: int32 = 0
    var di: int32 = 0
    while di < 3:
        let d = Int32(line[i + di])
        if d < 48 || d > 57:
            return
        code = code * 10 + (d - 48)
        di = di + 1
    outCode = code
    i = i + 3
    # Skip space after status code
    if i < line.len && line[i] == 32:
        i = i + 1
    # Rest is reason phrase
    let reasonStart: int32 = i
    while i < line.len && line[i] != '\r' && line[i] != '\n':
        i = i + 1
    let reasonLen: int32 = i - reasonStart
    if reasonLen > 0:
        outReason = strings.SliceBytes(line, reasonStart, reasonLen)
    outOk = true

# Parse "name=value" from a Set-Cookie header value.
# Returns false if no '=' found.
fn parseSetCookie(header: str, outName: var str, outValue: var str): bool =
    outName = ""
    outValue = ""
    var eqPos: int32 = -1
    var i: int32 = 0
    while i < header.len:
        if header[i] == '=':
            eqPos = i
            i = header.len
        else:
            i = i + 1
    if eqPos <= 0:
        return false
    outName = strings.SliceBytes(header, 0, eqPos)
    let valStart: int32 = eqPos + 1
    var valEnd: int32 = valStart
    while valEnd < header.len && header[valEnd] != ';':
        valEnd = valEnd + 1
    let valLen: int32 = valEnd - valStart
    if valLen > 0:
        outValue = strings.SliceBytes(header, valStart, valLen)
    else:
        outValue = ""
    return true

# ═══════════════════════════════════════════════════════════════════════════
# URL Query String Parser
# ═══════════════════════════════════════════════════════════════════════════

# Parse a URL query string into key=value pairs.
# Input is the query part after the '?' (e.g., "q=hello&page=1").
# Output arrays are populated with decoded keys and values.
# outCount is the number of pairs found.
# MaxPairs is the maximum number of pairs to parse.
fn parseUrlQueryString(
    query: str,
    maxPairs: int32,
    outKeys: var str[],
    outValues: var str[],
    outCount: var int32
) =
    outKeys = []
    outValues = []
    outCount = 0
    let n = query.len
    if n == 0:
        return

    var i: int32 = 0
    var currentPair: int32 = 0  # which pair we're filling (0-based)

    while i < n && currentPair < maxPairs:
        # Skip leading '&' if any (handles "&key=val" edge case)
        while i < n && query[i] == '&':
            i = i + 1
        if i >= n:
            return

        # Find '=' or '&' or end
        let keyStart: int32 = i
        var foundEq: bool = false
        while i < n && query[i] != '&':
            if query[i] == '=' && !foundEq:
                foundEq = true
                i = i + 1
            else:
                i = i + 1

        # Determine key and value ranges
        var key: str = ""
        var value: str = ""

        if foundEq:
            # Find the '=' position in [keyStart, i)
            var eqPos: int32 = keyStart
            while eqPos < i && query[eqPos] != '=':
                eqPos = eqPos + 1
            let keyLen: int32 = eqPos - keyStart
            if keyLen > 0:
                key = strings.SliceBytes(query, keyStart, keyLen)
            let valStart: int32 = eqPos + 1
            let valLen: int32 = i - valStart
            if valLen > 0 && valStart < n:
                value = strings.SliceBytes(query, valStart, valLen)
        else:
            # No '=' means key with empty value
            let keyLen: int32 = i - keyStart
            if keyLen > 0:
                key = strings.SliceBytes(query, keyStart, keyLen)

        if key != "" && currentPair < maxPairs:
            add(outKeys, key)
            add(outValues, value)
            outCount = outCount + 1
            currentPair = currentPair + 1

        # Move past '&'
        if i < n && query[i] == '&':
            i = i + 1

# ═══════════════════════════════════════════════════════════════════════════════
# HTTPS Request Builder (with SNI host)
# ═══════════════════════════════════════════════════════════════════════════════

# Build an HTTPS GET request with the Host header set for SNI.
# At the HTTP/1.1 layer, the request is identical to an HTTP GET;
# the TLS SNI extension uses the same host value at a lower layer.
# This function documents the intent to use HTTPS and sets the Host header
# for both virtual hosting and SNI alignment.

fn buildHttpsRequest(host: str, path: str): str =
    var req = "GET "
    req = strutil.Join([req, path], "")
    req = strutil.Join([req, " HTTP/1.1\r\nHost: "], "")
    req = strutil.Join([req, host], "")
    req = strutil.Join([req, "\r\n\r\n"], "")
    return req

# ═══════════════════════════════════════════════════════════════════════════════
# Chunked Transfer Encoding Body Decoder
# ═══════════════════════════════════════════════════════════════════════════════

# Parse a chunked transfer-encoded body and return the decoded content.
# Input format: "<hex-size>\r\n<data>\r\n...0\r\n\r\n"
# Returns the concatenated chunk data as a single string.

fn parseChunkedBody(raw: str): str =
    var result = ""
    let n = raw.len
    var i: int32 = 0
    while i < n:
        # Read hex chunk size
        var size: int32 = 0
        var gotSize: bool = false
        while i < n && raw[i] != '\r':
            let ch = Int32(raw[i])
            var digit: int32 = -1
            if ch >= 48 && ch <= 57:
                digit = ch - 48
            elif ch >= 97 && ch <= 102:
                digit = ch - 97 + 10
            elif ch >= 65 && ch <= 70:
                digit = ch - 65 + 10
            if digit >= 0:
                size = size * 16 + digit
                gotSize = true
            i = i + 1
        if !gotSize:
            return result
        # Skip \r\n after chunk size
        if i + 1 < n && raw[i] == '\r' && raw[i + 1] == '\n':
            i = i + 2
        else:
            return result
        # Terminating chunk (size 0)
        if size == 0:
            break
        # Copy chunk data
        if i + size <= n:
            result = strutil.Join([result, strings.SliceBytes(raw, i, size)], "")
            i = i + size
        else:
            return result
        # Skip trailing \r\n after chunk data
        if i + 1 < n && raw[i] == '\r' && raw[i + 1] == '\n':
            i = i + 2
    return result

# ═══════════════════════════════════════════════════════════════════════════════
# HTTP Error Classification
# ═══════════════════════════════════════════════════════════════════════════════

# Map an HTTP status code to a human-readable error category string.
# Returns one of: "Informational", "Success", "Redirection",
# "ClientError", "ServerError", "Unknown"

fn classifyHttpError(statusCode: int32): str =
    if statusCode >= 100 && statusCode < 200:
        return "Informational"
    if statusCode >= 200 && statusCode < 300:
        return "Success"
    if statusCode >= 300 && statusCode < 400:
        return "Redirection"
    if statusCode >= 400 && statusCode < 500:
        return "ClientError"
    if statusCode >= 500 && statusCode < 600:
        return "ServerError"
    return "Unknown"
