# ansi-escape: ANSI escape sequence processing
# Ported from codex-rs/ansi-escape/src/lib.rs
#
# Provides expandTabs and classifyAnsiCode for ANSI SGR processing.

import std/strings
import std/strutils as strutil

# ── expandTabs ─────────────────────────────────────────────────────────────
# Replace each tab character (\t) with 4 spaces.
fn RustCsgAnsiEscapeExpandTabs(s: str): str =
    if s.len == 0:
        return ""
    var result: str = ""
    var i: int32 = 0
    while i < s.len:
        if s[i] == '\t':
            result = strutil.Join([result, "    "], "")
        else:
            let ch: str = strings.SliceBytes(s, i, 1)
            result = strutil.Join([result, ch], "")
        i = i + 1
    return result

# ── classifyAnsiCode ───────────────────────────────────────────────────────
# Classify ANSI SGR (Select Graphic Rendition) parameter codes.
# Returns the category name as a string.
fn RustCsgAnsiEscapeClassifyAnsiCode(code: int32): str =
    if code == 0:
        return "reset"
    if code == 1:
        return "bold"
    if code == 2:
        return "dim"
    if code == 3:
        return "italic"
    if code == 4:
        return "underline"
    if code == 5:
        return "blink"
    if code == 6:
        return "blink_rapid"
    if code == 7:
        return "reverse"
    if code == 8:
        return "hidden"
    if code == 9:
        return "strikethrough"
    if code >= 30 && code <= 37:
        return "foreground"
    if code == 38:
        return "extended_foreground"
    if code == 39:
        return "default_foreground"
    if code >= 40 && code <= 47:
        return "background"
    if code == 48:
        return "extended_background"
    if code == 49:
        return "default_background"
    if code >= 90 && code <= 97:
        return "bright_foreground"
    if code >= 100 && code <= 107:
        return "bright_background"
    return "unknown"
