# ═══════════════════════════════════════════════════════════════════════════
# Production Functions
# ═══════════════════════════════════════════════════════════════════════════

# Validate that an extension version string follows semver format.
# Accepts: <digit>.<digit>... optionally with '-' prerelease or '+' build metadata.
fn validateExtensionVersion(version: str): bool =
    if version.len == 0:
        return false
    # First char must be a digit
    let first = Int32(version[0])
    if first < 48 || first > 57:
        return false
    # Must contain at least one dot
    var hasDot: bool = false
    var i: int32 = 1
    while i < version.len:
        let c = Int32(version[i])
        if c == 46:      # '.'
            hasDot = true
        elif (c < 48 || c > 57) && (c < 65 || c > 90) &&
              (c < 97 || c > 122) && c != 45 && c != 43:
            return false
        i = i + 1
    return hasDot

# Return a comma-separated string of known extension API endpoint paths.
fn listExtensionEndpoints(): str =
    return "/extensions/register,/extensions/unregister,/extensions/list,/extensions/events,/extensions/health"
