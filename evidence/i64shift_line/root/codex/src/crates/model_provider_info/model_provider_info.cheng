import std/strings
import std/strutils as strutil
import std/os

# ── Model provider info constants (ported from codex-rs model-provider-info) ──

const DEFAULT_STREAM_IDLE_TIMEOUT_MS: int = 300000
const DEFAULT_STREAM_MAX_RETRIES: int = 5
const DEFAULT_REQUEST_MAX_RETRIES: int = 4
const DEFAULT_WEBSOCKET_CONNECT_TIMEOUT_MS: int = 15000
const MAX_STREAM_MAX_RETRIES: int = 100
const MAX_REQUEST_MAX_RETRIES: int = 100

const WIRE_API_RESPONSES: int = 0

const DEFAULT_LMSTUDIO_PORT: int = 1234
const DEFAULT_OLLAMA_PORT: int = 11434

# ── Provider factory functions ──

fn createOpenaiProvider(baseUrl: str,
                         outName: var str,
                         outRequiresOpenaiAuth: var bool,
                         outSupportsWebsockets: var bool,
                         outHasHttpHeaders: var bool,
                         outHasEnvHttpHeaders: var bool) =
    outName = "OpenAI"
    outRequiresOpenaiAuth = true
    outSupportsWebsockets = true
    outHasHttpHeaders = true
    outHasEnvHttpHeaders = true

fn createAmazonBedrockProvider(awsProfile: str, awsRegion: str,
                                outName: var str,
                                outBaseUrl: var str,
                                outRequiresOpenaiAuth: var bool,
                                outSupportsWebsockets: var bool,
                                outHasHttpHeaders: var bool,
                                outHasEnvHttpHeaders: var bool,
                                outAwsProfile: var str,
                                outAwsRegion: var str) =
    outName = "Amazon Bedrock"
    outBaseUrl = "https://bedrock-mantle.us-east-1.api.aws/openai/v1"
    outRequiresOpenaiAuth = false
    outSupportsWebsockets = false
    outHasHttpHeaders = true
    outHasEnvHttpHeaders = false
    outAwsProfile = awsProfile
    outAwsRegion = awsRegion

fn resolveOssBaseUrl(defaultPort: int,
                      codexOssPort: str,
                      codexOssBaseUrl: str): str =
    var resolvedPort = defaultPort
    if codexOssPort != "":
        let trimmed = strutil.Strip(codexOssPort)
        if trimmed != "":
            let parsed = strutil.ParseInt(trimmed)
            if parsed > 0:
                resolvedPort = parsed
    var defaultUrl = strings.ConcatStr(strings.ConcatStr("http://localhost:", strings.IntToStr(resolvedPort)), "/v1")
    var finalUrl = defaultUrl
    if codexOssBaseUrl != "":
        let trimmedUrl = strutil.Strip(codexOssBaseUrl)
        if trimmedUrl != "":
            finalUrl = trimmedUrl
    return finalUrl

fn createOssProvider(defaultPort: int,
                      wireApi: int,
                      outName: var str,
                      outBaseUrl: var str,
                      outRequiresOpenaiAuth: var bool) =
    outName = "gpt-oss"
    outRequiresOpenaiAuth = false
    let portStr = os.GetEnv("CODEX_OSS_PORT")
    let baseUrlStr = os.GetEnv("CODEX_OSS_BASE_URL")
    outBaseUrl = resolveOssBaseUrl(defaultPort, portStr, baseUrlStr)

# ── Validation logic ──

fn validateProvider(hasAws: bool,
                    hasEnvKey: bool,
                    hasBearer: bool,
                    hasAuth: bool,
                    authCmd: str,
                    requiresOpenaiAuth: bool,
                    supportsWebsockets: bool,
                    outError: var str): bool =
    if hasAws && supportsWebsockets:
        outError = "provider aws cannot be combined with supports_websockets"
        return false
    if hasAws:
        var conflicts: str[]
        if hasEnvKey:
            add(conflicts, "env_key")
        if hasBearer:
            add(conflicts, "experimental_bearer_token")
        if hasAuth:
            add(conflicts, "auth")
        if requiresOpenaiAuth:
            add(conflicts, "requires_openai_auth")
        if conflicts.len > 0:
            var conflictStr: str
            var ci: int32 = 0
            while ci < conflicts.len:
                if ci > 0: conflictStr = strings.ConcatStr(conflictStr, ", ")
                conflictStr = strings.ConcatStr(conflictStr, conflicts[ci])
                ci = ci + 1
            outError = strings.ConcatStr("provider aws cannot be combined with ", conflictStr)
            return false
    if hasAuth:
        let cmdTrimmed = strutil.Strip(authCmd)
        if cmdTrimmed == "":
            outError = "provider auth.command must not be empty"
            return false
        var authConflicts: str[]
        if hasEnvKey:
            add(authConflicts, "env_key")
        if hasBearer:
            add(authConflicts, "experimental_bearer_token")
        if requiresOpenaiAuth:
            add(authConflicts, "requires_openai_auth")
        if authConflicts.len > 0:
            var authConflictStr: str
            var aci: int32 = 0
            while aci < authConflicts.len:
                if aci > 0: authConflictStr = strings.ConcatStr(authConflictStr, ", ")
                authConflictStr = strings.ConcatStr(authConflictStr, authConflicts[aci])
                aci = aci + 1
            outError = strings.ConcatStr("provider auth cannot be combined with ", authConflictStr)
            return false
    outError = ""
    return true

# ── Merge logic ──

fn mergeBedrockOnlyAwsOverride(builtInProfile: var str, builtInRegion: var str,
                                overrideProfile: str, overrideRegion: str,
                                configuredHasNonAwsFields: bool,
                                outError: var str): bool =
    if configuredHasNonAwsFields:
        outError = "model_providers.amazon-bedrock only supports changing aws.profile and aws.region; other non-default provider fields are not supported"
        return false
    if overrideProfile != "":
        builtInProfile = overrideProfile
    if overrideRegion != "":
        builtInRegion = overrideRegion
    outError = ""
    return true

# ── Retry/timeout helpers ──

fn effectiveRequestMaxRetries(configValue: int): int =
    var v = configValue
    if v < 0:
        v = DEFAULT_REQUEST_MAX_RETRIES
    if v > MAX_REQUEST_MAX_RETRIES:
        v = MAX_REQUEST_MAX_RETRIES
    return v

fn effectiveStreamMaxRetries(configValue: int): int =
    var v = configValue
    if v < 0:
        v = DEFAULT_STREAM_MAX_RETRIES
    if v > MAX_STREAM_MAX_RETRIES:
        v = MAX_STREAM_MAX_RETRIES
    return v

fn effectiveStreamIdleTimeoutMs(configValue: int): int =
    var v = configValue
    if v < 0:
        v = DEFAULT_STREAM_IDLE_TIMEOUT_MS
    return v

fn effectiveWebsocketConnectTimeoutMs(configValue: int): int =
    var v = configValue
    if v < 0:
        v = DEFAULT_WEBSOCKET_CONNECT_TIMEOUT_MS
    return v

# ── Public API — compare & URL generation ────────────────────────────

# Compare two provider config JSON strings for field-by-field equality.
# Config format: {"name":"...","baseUrl":"...","requiresOpenaiAuth":bool,...}
# Returns true if all fields present in both configs match.
fn modelProviderCompareConfigs(a: str, b: str): bool =
    var fieldNames: str[] = ["name", "baseUrl", "requiresOpenaiAuth", "supportsWebsockets", "hasHttpHeaders", "hasEnvHttpHeaders", "awsProfile", "awsRegion"]
    var fi: int32 = 0
    while fi < fieldNames.len:
        let fname: str = fieldNames[fi]
        let searchA: str = strings.ConcatStr(strings.ConcatStr("\"", fname), "\":")
        var valA: str
        var foundA: bool
        var posA: int32 = 0
        while posA < a.len:
            var matched: bool = true
            var mi: int32 = 0
            while mi < searchA.len:
                if posA + mi >= a.len || a[posA + mi] != searchA[mi]:
                    matched = false
                    break
                mi = mi + 1
            if matched:
                foundA = true
                var vStart: int32 = posA + searchA.len
                while vStart < a.len && (a[vStart] == ' ' || a[vStart] == '\t'):
                    vStart = vStart + 1
                if vStart < a.len && a[vStart] == '"':
                    vStart = vStart + 1
                    var vEnd: int32 = vStart
                    while vEnd < a.len && a[vEnd] != '"':
                        vEnd = vEnd + 1
                    valA = strings.SliceBytes(a, vStart, vEnd - vStart)
                elif vStart < a.len:
                    var vEnd: int32 = vStart
                    while vEnd < a.len && a[vEnd] != ',' && a[vEnd] != '}' && a[vEnd] != ' ':
                        vEnd = vEnd + 1
                    valA = strings.SliceBytes(a, vStart, vEnd - vStart)
                break
            posA = posA + 1
        if !foundA:
            fi = fi + 1
            continue
        var valB: str
        var foundB: bool
        var posB: int32 = 0
        while posB < b.len:
            var matched: bool = true
            var mi: int32 = 0
            while mi < searchA.len:
                if posB + mi >= b.len || b[posB + mi] != searchA[mi]:
                    matched = false
                    break
                mi = mi + 1
            if matched:
                foundB = true
                var vStart: int32 = posB + searchA.len
                while vStart < b.len && (b[vStart] == ' ' || b[vStart] == '\t'):
                    vStart = vStart + 1
                if vStart < b.len && b[vStart] == '"':
                    vStart = vStart + 1
                    var vEnd: int32 = vStart
                    while vEnd < b.len && b[vEnd] != '"':
                        vEnd = vEnd + 1
                    valB = strings.SliceBytes(b, vStart, vEnd - vStart)
                elif vStart < b.len:
                    var vEnd: int32 = vStart
                    while vEnd < b.len && b[vEnd] != ',' && b[vEnd] != '}' && b[vEnd] != ' ':
                        vEnd = vEnd + 1
                    valB = strings.SliceBytes(b, vStart, vEnd - vStart)
                break
            posB = posB + 1
        if !foundB:
            fi = fi + 1
            continue
        if valA != valB:
            return false
        fi = fi + 1
    return true

fn modelProviderFindJsonStr(text: str, key: str): str =
    let parts = strutil.Split(text, '"')
    var i: int32 = 0
    while i + 2 < parts.len:
        if parts[i] == key:
            return parts[i + 2]
        i = i + 1
    return ""

# Generate provider API URL from a provider name/config.
# provider: provider name or JSON config string (e.g. "OpenAI", "Amazon Bedrock")
# Returns the API base URL string.
fn modelProviderToUrl(provider: str): str =
    if provider == "OpenAI":
        return "https://api.openai.com/v1"
    if provider == "Amazon Bedrock":
        return "https://bedrock-runtime.us-east-1.amazonaws.com"
    if strutil.Contains(provider, "\"name\":\"OpenAI\""):
        let parsedUrl = modelProviderFindJsonStr(provider, "baseUrl")
        if parsedUrl != "":
            return parsedUrl
        return "https://api.openai.com/v1"
    if strutil.Contains(provider, "\"name\":\"Amazon Bedrock\""):
        var region: str = "us-east-1"
        let parsedRegion = modelProviderFindJsonStr(provider, "awsRegion")
        if parsedRegion != "":
            region = parsedRegion
        return strings.ConcatStr(strings.ConcatStr("https://bedrock-runtime.", region), ".amazonaws.com")
    if strutil.Contains(provider, "gpt-oss"):
        return "http://localhost:1234/v1"
    return ""

# Serialize provider name or JSON config to normalized JSON config.
# provider: provider name ("OpenAI", "Amazon Bedrock") or JSON config string.
# Returns JSON config with all known fields, using defaults for missing fields.
fn modelProviderToConfigJson(provider: str): str =
    if provider == "OpenAI":
        return "{\"name\":\"OpenAI\",\"baseUrl\":\"https://api.openai.com/v1\",\"requiresOpenaiAuth\":true,\"supportsWebsockets\":true,\"hasHttpHeaders\":true,\"hasEnvHttpHeaders\":true}"
    if provider == "Amazon Bedrock":
        return "{\"name\":\"Amazon Bedrock\",\"baseUrl\":\"https://bedrock-runtime.us-east-1.amazonaws.com\",\"requiresOpenaiAuth\":false,\"supportsWebsockets\":false,\"hasHttpHeaders\":true,\"hasEnvHttpHeaders\":false}"
    if strutil.Contains(provider, "\"name\":\"OpenAI\""):
        var url: str = "https://api.openai.com/v1"
        var reqAuth: str = "true"
        var supportsWs: str = "true"
        var hasHeaders: str = "true"
        var hasEnvHeaders: str = "true"
        let parsedUrl = modelProviderFindJsonStr(provider, "baseUrl")
        if parsedUrl != "":
            url = parsedUrl
        return strings.ConcatStr(strings.ConcatStr(strings.ConcatStr(strings.ConcatStr(strings.ConcatStr(strings.ConcatStr("{\"name\":\"OpenAI\",\"baseUrl\":\"", url), "\",\"requiresOpenaiAuth\":"), reqAuth), ",\"supportsWebsockets\":"), supportsWs), ",\"hasHttpHeaders\":"), strings.ConcatStr(strings.ConcatStr(strings.ConcatStr(hasHeaders, ",\"hasEnvHttpHeaders\":"), hasEnvHeaders), "}")
    if strutil.Contains(provider, "\"name\":\"Amazon Bedrock\""):
        var region: str = "us-east-1"
        let parsedRegion = modelProviderFindJsonStr(provider, "awsRegion")
        if parsedRegion != "":
            region = parsedRegion
        return strings.ConcatStr(strings.ConcatStr("{\"name\":\"Amazon Bedrock\",\"baseUrl\":\"https://bedrock-runtime.", region), ".amazonaws.com\",\"requiresOpenaiAuth\":false,\"supportsWebsockets\":false,\"hasHttpHeaders\":true,\"hasEnvHttpHeaders\":false}")
    if strutil.Contains(provider, "gpt-oss") || strutil.Contains(provider, "oss"):
        return "{\"name\":\"gpt-oss\",\"baseUrl\":\"http://localhost:1234/v1\",\"requiresOpenaiAuth\":false,\"supportsWebsockets\":false,\"hasHttpHeaders\":false,\"hasEnvHttpHeaders\":false}"
    return ""

# Compute field-by-field diff between two provider config JSON strings.
# Returns JSON: {"fieldName":{"old":"...","new":"..."},...}
# Returns "{}" if identical.
fn modelProviderDiff(oldConfig: str, newConfig: str): str =
    var diffs: str[]
    var fieldNames: str[] = ["name", "baseUrl", "requiresOpenaiAuth", "supportsWebsockets", "hasHttpHeaders", "hasEnvHttpHeaders", "awsProfile", "awsRegion"]
    var fi: int32 = 0
    while fi < fieldNames.len:
        let fname: str = fieldNames[fi]
        let searchA: str = strings.ConcatStr(strings.ConcatStr("\"", fname), "\":")
        var valOld: str
        var foundOld: bool
        var posOld: int32 = 0
        while posOld < oldConfig.len:
            var matched: bool = true
            var mi: int32 = 0
            while mi < searchA.len:
                if posOld + mi >= oldConfig.len || oldConfig[posOld + mi] != searchA[mi]:
                    matched = false
                    break
                mi = mi + 1
            if matched:
                foundOld = true
                var vStart: int32 = posOld + searchA.len
                while vStart < oldConfig.len && (oldConfig[vStart] == ' ' || oldConfig[vStart] == '\t'):
                    vStart = vStart + 1
                if vStart < oldConfig.len && oldConfig[vStart] == '"':
                    vStart = vStart + 1
                    var vEnd: int32 = vStart
                    while vEnd < oldConfig.len && oldConfig[vEnd] != '"':
                        vEnd = vEnd + 1
                    valOld = strings.SliceBytes(oldConfig, vStart, vEnd - vStart)
                elif vStart < oldConfig.len:
                    var vEnd: int32 = vStart
                    while vEnd < oldConfig.len && oldConfig[vEnd] != ',' && oldConfig[vEnd] != '}' && oldConfig[vEnd] != ' ':
                        vEnd = vEnd + 1
                    valOld = strings.SliceBytes(oldConfig, vStart, vEnd - vStart)
                break
            posOld = posOld + 1
        var valNew: str
        var foundNew: bool
        var posNew: int32 = 0
        while posNew < newConfig.len:
            var matched: bool = true
            var mi: int32 = 0
            while mi < searchA.len:
                if posNew + mi >= newConfig.len || newConfig[posNew + mi] != searchA[mi]:
                    matched = false
                    break
                mi = mi + 1
            if matched:
                foundNew = true
                var vStart: int32 = posNew + searchA.len
                while vStart < newConfig.len && (newConfig[vStart] == ' ' || newConfig[vStart] == '\t'):
                    vStart = vStart + 1
                if vStart < newConfig.len && newConfig[vStart] == '"':
                    vStart = vStart + 1
                    var vEnd: int32 = vStart
                    while vEnd < newConfig.len && newConfig[vEnd] != '"':
                        vEnd = vEnd + 1
                    valNew = strings.SliceBytes(newConfig, vStart, vEnd - vStart)
                elif vStart < newConfig.len:
                    var vEnd: int32 = vStart
                    while vEnd < newConfig.len && newConfig[vEnd] != ',' && newConfig[vEnd] != '}' && newConfig[vEnd] != ' ':
                        vEnd = vEnd + 1
                    valNew = strings.SliceBytes(newConfig, vStart, vEnd - vStart)
                break
            posNew = posNew + 1
        if foundOld || foundNew:
            var oldVal: str = valOld
            var newVal: str = valNew
            if !foundOld:
                oldVal = ""
            if !foundNew:
                newVal = ""
            if oldVal != newVal:
                add(diffs, strings.ConcatStr(strings.ConcatStr(strings.ConcatStr(strings.ConcatStr(strings.ConcatStr("\"", fname), "\":{\"old\":\""), oldVal), "\",\"new\":\""), strings.ConcatStr(newVal, "\"}")))
        fi = fi + 1
    if diffs.len == 0:
        return "{}"
    var diffsStr: str
    var di: int32 = 0
    while di < diffs.len:
        if di > 0: diffsStr = strings.ConcatStr(diffsStr, ",")
        diffsStr = strings.ConcatStr(diffsStr, diffs[di])
        di = di + 1
    return strings.ConcatStr(strings.ConcatStr("{", diffsStr), "}")
