# HTTP Client — type definitions and core utility functions
#
# Ported from codex-rs/utils/http/src/lib.rs and extended with
# HTTP request/response/client type metadata.
#
# Type constants follow the codex crate pattern (backend_client, etc.)

import std/strings
import std/strutils as strutil

# ═══════════════════════════════════════════════════════════════════════════
# Type: HTTP Method
# ═══════════════════════════════════════════════════════════════════════════

const RustCsgHttpClientMethodVariantCount: int32 = 7
const RustCsgHttpClientMethodVariant1: str = "GET"
const RustCsgHttpClientMethodVariant2: str = "POST"
const RustCsgHttpClientMethodVariant3: str = "PUT"
const RustCsgHttpClientMethodVariant4: str = "DELETE"
const RustCsgHttpClientMethodVariant5: str = "HEAD"
const RustCsgHttpClientMethodVariant6: str = "OPTIONS"
const RustCsgHttpClientMethodVariant7: str = "PATCH"

fn HttpMethodVariantNames(): str =
    return "GET,POST,PUT,DELETE,HEAD,OPTIONS,PATCH"

# ═══════════════════════════════════════════════════════════════════════════
# Type: HTTP Request
# ═══════════════════════════════════════════════════════════════════════════

const RustCsgHttpClientRequestFieldCount: int32 = 4
const RustCsgHttpClientRequestField1: str = "method"
const RustCsgHttpClientRequestField2: str = "url"
const RustCsgHttpClientRequestField3: str = "headers"
const RustCsgHttpClientRequestField4: str = "body"

fn HttpRequestFields(): str =
    return "method|http_method,url|str,headers|vec_http_header,body|str"

# ═══════════════════════════════════════════════════════════════════════════
# Type: HTTP Response
# ═══════════════════════════════════════════════════════════════════════════

const RustCsgHttpClientResponseFieldCount: int32 = 4
const RustCsgHttpClientResponseField1: str = "status_code"
const RustCsgHttpClientResponseField2: str = "headers"
const RustCsgHttpClientResponseField3: str = "body"
const RustCsgHttpClientResponseField4: str = "error"

fn HttpResponseFields(): str =
    return "status_code|int32,headers|vec_http_header,body|str,error|str"

# ═══════════════════════════════════════════════════════════════════════════
# Type: HTTP Client
# ═══════════════════════════════════════════════════════════════════════════

const RustCsgHttpClientClientFieldCount: int32 = 5
const RustCsgHttpClientClientField1: str = "base_url"
const RustCsgHttpClientClientField2: str = "default_headers"
const RustCsgHttpClientClientField3: str = "timeout_s"
const RustCsgHttpClientClientField4: str = "max_redirects"
const RustCsgHttpClientClientField5: str = "follow_redirects"

fn HttpClientFields(): str =
    return "base_url|str,default_headers|vec_http_header,timeout_s|int32,max_redirects|int32,follow_redirects|bool"

# ═══════════════════════════════════════════════════════════════════════════
# Helper: HTTP header tuple
# ═══════════════════════════════════════════════════════════════════════════

type
    RustCsgHttpClientHeader =
        name: str
        value: str

# ═══════════════════════════════════════════════════════════════════════════
# Helper: lower-case ASCII character (preserved for parity with Rust impl)
# ═══════════════════════════════════════════════════════════════════════════

fn httpClientLowerAsciiChar(ch: char): str =
    if ch == 'A': return "a"
    if ch == 'B': return "b"
    if ch == 'C': return "c"
    if ch == 'D': return "d"
    if ch == 'E': return "e"
    if ch == 'F': return "f"
    if ch == 'G': return "g"
    if ch == 'H': return "h"
    if ch == 'I': return "i"
    if ch == 'J': return "j"
    if ch == 'K': return "k"
    if ch == 'L': return "l"
    if ch == 'M': return "m"
    if ch == 'N': return "n"
    if ch == 'O': return "o"
    if ch == 'P': return "p"
    if ch == 'Q': return "q"
    if ch == 'R': return "r"
    if ch == 'S': return "s"
    if ch == 'T': return "t"
    if ch == 'U': return "u"
    if ch == 'V': return "v"
    if ch == 'W': return "w"
    if ch == 'X': return "x"
    if ch == 'Y': return "y"
    if ch == 'Z': return "z"
    return ""

fn httpClientLowerAscii(text: str): str =
    var out: str
    for i in 0..<text.len:
        let ch = text[i]
        if ch >= 'A' && ch <= 'Z':
            out = strings.ConcatStr(out, httpClientLowerAsciiChar(ch))
        else:
            out = strings.ConcatStr(out, strings.SliceBytes(text, i, 1))
    return out

fn httpClientTrimQuote(text: str): str =
    var trimmed = strutil.Strip(text)
    while trimmed.len > 0 && trimmed[0] == '"':
        trimmed = strings.SliceBytes(trimmed, 1, trimmed.len - 1)
    while trimmed.len > 0 && trimmed[trimmed.len - 1] == '"':
        trimmed = strings.SliceBytes(trimmed, 0, trimmed.len - 1)
    while trimmed.len > 0 && trimmed[0] == '\'':
        trimmed = strings.SliceBytes(trimmed, 1, trimmed.len - 1)
    while trimmed.len > 0 && trimmed[trimmed.len - 1] == '\'':
        trimmed = strings.SliceBytes(trimmed, 0, trimmed.len - 1)
    return trimmed

fn httpClientFindChar(text: str, ch: char): int32 =
    for i in 0..<text.len:
        if text[i] == ch:
            return i
    return -1

fn httpClientTrimTrailingCr(text: str): str =
    var out = text
    while out.len > 0 && out[out.len - 1] == '\r':
        out = strings.SliceBytes(out, 0, out.len - 1)
    return out

# ═══════════════════════════════════════════════════════════════════════════
# RustCsgHttpClientParseContentType
#
# Ported from utils/http/src/lib.rs parse_content_type()
# Parses a Content-Type header value into its MIME type and optional charset.
# ═══════════════════════════════════════════════════════════════════════════

fn RustCsgHttpClientParseContentType(header: str,
                                      outMimeType: var str,
                                      outCharset: var str,
                                      outHasCharset: var bool) =
    outMimeType = ""
    outCharset = ""
    outHasCharset = false
    let trimmed = strutil.Strip(header)
    let parts = strutil.Split(trimmed, ';')
    if parts.len == 0:
        return
    outMimeType = httpClientLowerAscii(strutil.Strip(parts[0]))
    for i in 1..<parts.len:
        let part = strutil.Strip(parts[i])
        if strings.HasPrefix(part, "charset="):
            let value = httpClientTrimQuote(strings.SliceBytes(part, 8, part.len - 8))
            if value != "":
                outCharset = value
                outHasCharset = true
                return
        elif strings.HasPrefix(part, "charset = "):
            let value = httpClientTrimQuote(strings.SliceBytes(part, 10, part.len - 10))
            if value != "":
                outCharset = value
                outHasCharset = true
                return

# ═══════════════════════════════════════════════════════════════════════════
# RustCsgHttpClientBuildHttpPostRequest
#
# Ported from utils/http/src/lib.rs build_http_post_request()
# Builds a raw HTTP/1.1 POST request string.
# ═══════════════════════════════════════════════════════════════════════════

fn RustCsgHttpClientBuildHttpPostRequest(host: str, path: str,
                                          body: str, contentType: str): str =
    var out = "POST "
    out = strings.ConcatStr(out, path)
    out = strings.ConcatStr(out, " HTTP/1.1\r\nHost: ")
    out = strings.ConcatStr(out, host)
    out = strings.ConcatStr(out, "\r\nContent-Type: ")
    out = strings.ConcatStr(out, contentType)
    out = strings.ConcatStr(out, "\r\nContent-Length: ")
    out = strings.ConcatStr(out, strings.IntToStr(body.len))
    out = strings.ConcatStr(out, "\r\nConnection: close\r\n\r\n")
    out = strings.ConcatStr(out, body)
    return out

# ═══════════════════════════════════════════════════════════════════════════
# RustCsgHttpClientBuildHttpGetRequest
#
# Builds a raw HTTP/1.1 GET request string.
# ═══════════════════════════════════════════════════════════════════════════

fn RustCsgHttpClientBuildHttpGetRequest(host: str, path: str): str =
    var out = "GET "
    out = strings.ConcatStr(out, path)
    out = strings.ConcatStr(out, " HTTP/1.1\r\nHost: ")
    out = strings.ConcatStr(out, host)
    out = strings.ConcatStr(out, "\r\nConnection: close\r\n\r\n")
    return out

# ═══════════════════════════════════════════════════════════════════════════
# RustCsgHttpClientParseHeaders
#
# Ported from utils/http/src/lib.rs parse_http_headers()
# Parses raw HTTP response headers into name-value pairs.
# ═══════════════════════════════════════════════════════════════════════════

fn RustCsgHttpClientParseHeaders(rawHeaders: str): RustCsgHttpClientHeader[] =
    var headers: RustCsgHttpClientHeader[]
    let lines = strutil.Split(rawHeaders, '\n')
    for i in 0..<lines.len:
        let line = httpClientTrimTrailingCr(lines[i])
        if line == "":
            continue
        if line[0] == ' ' || line[0] == '\t':
            if headers.len > 0:
                let idx = headers.len - 1
                headers[idx].value = strings.ConcatStr(
                    strings.ConcatStr(headers[idx].value, " "),
                    strutil.Strip(line))
                continue
        let colon = httpClientFindChar(line, ':')
        if colon >= 0:
            var header: RustCsgHttpClientHeader
            header.name = httpClientLowerAscii(
                strutil.Strip(strings.SliceBytes(line, 0, colon)))
            header.value = strutil.Strip(
                strings.SliceBytes(line, colon + 1, line.len - colon - 1))
            add(headers, header)
    return headers

# ═══════════════════════════════════════════════════════════════════════════
# RustCsgHttpClientMethodToString
#
# Converts a method variant index (1-based) to its string name.
# Returns "" for invalid indices.
# ═══════════════════════════════════════════════════════════════════════════

fn RustCsgHttpClientMethodToString(methodIdx: int32): str =
    if methodIdx == 1: return "GET"
    if methodIdx == 2: return "POST"
    if methodIdx == 3: return "PUT"
    if methodIdx == 4: return "DELETE"
    if methodIdx == 5: return "HEAD"
    if methodIdx == 6: return "OPTIONS"
    if methodIdx == 7: return "PATCH"
    return ""

# ═══════════════════════════════════════════════════════════════════════════
# RustCsgHttpClientValidateUrl
#
# Validates a URL string starts with "http://" or "https://"
# and has content after the scheme.
# ═══════════════════════════════════════════════════════════════════════════

fn RustCsgHttpClientValidateUrl(url: str): bool =
    if url.len == 0:
        return false
    if strutil.StartsWith(url, "https://"):
        return url.len > 8
    if strutil.StartsWith(url, "http://"):
        return url.len > 7
    return false

# ═══════════════════════════════════════════════════════════════════════════
# RustCsgHttpClientFindHeaderValue
#
# Finds the value of a named header in a pre-parsed header array.
# Returns "" if the header is not found. Name comparison is case-insensitive
# (headers are already lowercased during parsing).
# ═══════════════════════════════════════════════════════════════════════════

fn RustCsgHttpClientFindHeaderValue(headers: RustCsgHttpClientHeader[],
                                     name: str): str =
    let wanted = httpClientLowerAscii(name)
    for i in 0..<headers.len:
        if headers[i].name == wanted:
            return headers[i].value
    return ""

# ═══════════════════════════════════════════════════════════════════════════
# RustCsgHttpClientClassifyStatusCode
#
# Classifies an HTTP status code into a human-readable category string.
# Returns: "Informational", "Success", "Redirection", "ClientError",
#          "ServerError", or "Unknown".
# ═══════════════════════════════════════════════════════════════════════════

fn RustCsgHttpClientClassifyStatusCode(status: int32): str =
    if status >= 100 && status < 200: return "Informational"
    if status >= 200 && status < 300: return "Success"
    if status >= 300 && status < 400: return "Redirection"
    if status >= 400 && status < 500: return "ClientError"
    if status >= 500 && status < 600: return "ServerError"
    return "Unknown"
