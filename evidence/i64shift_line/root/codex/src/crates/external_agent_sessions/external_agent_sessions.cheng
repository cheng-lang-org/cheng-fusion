# external-agent-sessions: Filesystem-safe session name normalization and
# session context building for prompts.
# Ported from codex-rs/external-agent-sessions/src/lib.rs

import std/strings as strings
import std/strutils as strutil

# NOTE: const str is broken at runtime, use functions instead.
fn RustCsgExternalAgentSessionsLowerAlpha(): str =
    return "abcdefghijklmnopqrstuvwxyz"

# ── normalizeSessionName ──────────────────────────────────────────────────
# Normalize a session name to a filesystem-safe slug.
# Lowercases, keeps alphanumeric/underscore/hyphen, replaces rest with hyphen,
# collapses consecutive hyphens, trims leading/trailing hyphens.
# Returns "unnamed-session" for empty or all-special input.
fn RustCsgExternalAgentSessionsNormalizeSessionName(name: str): str =
    if name.len == 0:
        return "unnamed-session"
    var out: str = ""
    var i: int32 = 0
    while i < name.len:
        let ch = name[i]
        let b = Int32(ch)
        if b >= 65 && b <= 90:
            let idx = b - 65
            out = strutil.Join([out, strings.SliceBytes(RustCsgExternalAgentSessionsLowerAlpha(), idx, 1)], "")
        elif (b >= 97 && b <= 122) || (b >= 48 && b <= 57):
            out = strutil.Join([out, strings.SliceBytes(name, i, 1)], "")
        elif ch == '-' || ch == '_':
            out = strutil.Join([out, strings.SliceBytes(name, i, 1)], "")
        else:
            out = strutil.Join([out, "-"], "")
        i = i + 1
    var collapsed: str = ""
    var prevHyphen: bool = false
    var ci: int32 = 0
    while ci < out.len:
        let c = out[ci]
        if c == '-':
            if !prevHyphen:
                collapsed = strutil.Join([collapsed, "-"], "")
                prevHyphen = true
        else:
            collapsed = strutil.Join([collapsed, strings.SliceBytes(out, ci, 1)], "")
            prevHyphen = false
        ci = ci + 1
    var startTrim: int32 = 0
    while startTrim < collapsed.len && collapsed[startTrim] == '-':
        startTrim = startTrim + 1
    var endTrim: int32 = collapsed.len
    while endTrim > startTrim && collapsed[endTrim - 1] == '-':
        endTrim = endTrim - 1
    if startTrim >= endTrim:
        return "unnamed-session"
    return strings.SliceBytes(collapsed, startTrim, endTrim - startTrim)

# ── agentSessionsBuildContext ──────────────────────────────────────────────
# Build a session context string for prompt from an array of session
# descriptors. Each session descriptor is in "name:<session-name>" format.
# Returns a formatted string suitable for inclusion in a prompt, e.g.:
#   <sessions>
#   <session>session-name-1</session>
#   <session>session-name-2</session>
#   </sessions>
# Empty or malformed entries (missing "name:" prefix) are silently skipped.
fn RustCsgExternalAgentSessionsBuildContext(sessions: str[]): str =
    if sessions.len == 0:
        return ""
    var result: str = ""
    var i: int32 = 0
    while i < sessions.len:
        let entry: str = sessions[i]
        # Check for "name:" prefix
        if entry.len > 5:
            let prefix: str = strings.SliceBytes(entry, 0, 5)
            if prefix == "name:":
                let sessionName: str = strings.SliceBytes(entry, 5, entry.len - 5)
                if sessionName.len > 0:
                    let normalized: str = RustCsgExternalAgentSessionsNormalizeSessionName(sessionName)
                    result = strutil.Join([result, "<session>", normalized, "</session>"], "")
        i = i + 1
    if result.len == 0:
        return ""
    return strutil.Join(["<sessions>", result, "</sessions>"], "")