# NOTE: Function instead of const for standalone Mach-O compat (const value
# can be corrupted when placed adjacent to a string const declaration).
fn RustCsgHookEventVariantCount(): int32 = return 1

const RustCsgHookEventVariantAfterAgent: str = "AfterAgent"

# ── Hook key helper ─────────────────────────────────────────────────────────

fn RustCsgHookKey(keySource: str, eventName: str, groupIndex: int32, handlerIndex: int32): str =
    return keySource + ":" + RustCsgHookEventKeyLabel(eventName) + ":" + RustCsgInt32Text(groupIndex) + ":" + RustCsgInt32Text(handlerIndex)

fn RustCsgInt32Text(value: int32): str =
    if value < 0:
        return "-" + RustCsgInt32Text(-value)
    var out: str
    var n: int32 = value
    if n == 0:
        return "0"
    while n > 0:
        let digit: int32 = n % 10
        out = char(int32('0') + digit) + out
        n = n / 10
    return out

