# ── Glob matching (range-based, no string building) ─────────────────────────
# Match text against pattern range pattern[pStart..pEnd).
# * matches any sequence, ? matches any single char.
fn globMatchRange(text: str, pattern: str, pStart: int32, pEnd: int32): bool =
    var pi: int32 = pStart
    var ti: int32 = 0
    var starPos: int32 = -1
    var matchPos: int32 = 0
    while ti < text.len:
        if pi < pEnd && (pattern[pi] == text[ti] || pattern[pi] == '?'):
            ti = ti + 1
            pi = pi + 1
        elif pi < pEnd && pattern[pi] == '*':
            starPos = pi
            matchPos = ti
            pi = pi + 1
        elif starPos >= 0:
            pi = starPos + 1
            matchPos = matchPos + 1
            ti = matchPos
        else:
            return false
    while pi < pEnd && pattern[pi] == '*':
        pi = pi + 1
    return pi == pEnd

fn RustCsgHooksGlobMatch(text: str, pattern: str): bool =
    return globMatchRange(text, pattern, 0, pattern.len)

# ── matchHookEvent: match eventName against comma-separated patterns ─────────
fn RustCsgHooksMatchHookEvent(eventName: str, registeredEvents: str): bool =
    var start: int32 = 0
    var i: int32 = 0
    while i <= registeredEvents.len:
        if i == registeredEvents.len || registeredEvents[i] == ',':
            let rawLen: int32 = i - start
            if rawLen > 0:
                # Trim whitespace from pattern range [start, i)
                var pStart: int32 = start
                var pEnd: int32 = i
                while pStart < pEnd && (registeredEvents[pStart] == ' ' || registeredEvents[pStart] == '\t'):
                    pStart = pStart + 1
                while pEnd > pStart && (registeredEvents[pEnd - 1] == ' ' || registeredEvents[pEnd - 1] == '\t'):
                    pEnd = pEnd - 1
                if pStart < pEnd && globMatchRange(eventName, registeredEvents, pStart, pEnd):
                    return true
            start = i + 1
        i = i + 1
    return false

# ── Public API — filter & execute chain ───────────────────────────────

# Filter hooks matching a given event name.
# hooks: comma-separated hook descriptors, each formatted as "hookName:eventPattern"
#   e.g. "audit:PreToolUse,rate_limit:PermissionRequest,logger:*"
# eventName: event to match (e.g. "PreToolUse")
# Returns comma-separated matching hook names (no event patterns).
fn hooksFilterByEvent(hooks: str, eventName: str): str =
    var result: str[]
    var start: int32 = 0
    var i: int32 = 0
    while i <= hooks.len:
        if i == hooks.len || hooks[i] == ',':
            let rawLen: int32 = i - start
            if rawLen > 0:
                var colonPos: int32 = -1
                var ci: int32 = start
                while ci < i:
                    if hooks[ci] == ':':
                        colonPos = ci
                        break
                    ci = ci + 1
                if colonPos >= 0:
                    let hookName: str = strings.SliceBytes(hooks, start, colonPos - start)
                    let eventPattern: str = strings.SliceBytes(hooks, colonPos + 1, i - colonPos - 1)
                    if RustCsgHooksMatchHookEvent(eventName, eventPattern):
                        add(result, hookName)
            start = i + 1
        i = i + 1
    return strutil.Join(result, ",")

# Simulate a hook execution chain.
# hooks: comma-separated hook names to execute in order.
# event: event name being triggered.
# context: JSON string representing execution context.
# Returns a JSON results array string, each entry: {"hook":"name","result":"success"}
fn hooksExecuteChain(hooks: str, event: str, context: str): str =
    var results: str[]
    var start: int32 = 0
    var i: int32 = 0
    while i <= hooks.len:
        if i == hooks.len || hooks[i] == ',':
            let rawLen: int32 = i - start
            if rawLen > 0:
                var hookName: str
                var hi: int32 = start
                while hi < i && hooks[hi] == ' ':
                    hi = hi + 1
                hookName = strings.SliceBytes(hooks, hi, i - hi)
                if hookName != "":
                    var entry: str = strutil.Join(["{\"hook\":\"", hookName, "\",\"result\":\"success\"}"], "")
                    add(results, entry)
            start = i + 1
        i = i + 1
    return strutil.Join(["[", strutil.Join(results, ","), "]"], "")
