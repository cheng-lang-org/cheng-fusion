fn RustCsgHookEventNames(): str =
    return "PreToolUse,PermissionRequest,PostToolUse,PreCompact,PostCompact,SessionStart,UserPromptSubmit,Stop"

const RustCsgHookEventNamesWithMatchersCount: int32 = 6
fn RustCsgHookEventNamesWithMatchers(): str =
    return "PreToolUse,PermissionRequest,PostToolUse,PreCompact,PostCompact,SessionStart"

