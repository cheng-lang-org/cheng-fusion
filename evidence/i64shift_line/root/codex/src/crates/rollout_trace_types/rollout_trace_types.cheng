import std/strings
import std/strutils as strutil

# Rollout-Trace Type Definitions
#
# Core type constants extracted from codex-rs/rollout-trace/src/
# Enums -> int32 constants. Type aliases -> str usage convention.

# ── Enum: RolloutStatus ─────────────────────────────────────────────
const RustCsgRolloutStatusRunning: int32 = 0
const RustCsgRolloutStatusCompleted: int32 = 1
const RustCsgRolloutStatusFailed: int32 = 2
const RustCsgRolloutStatusAborted: int32 = 3

fn RolloutStatusName(v: int32): str =
    if v == RustCsgRolloutStatusRunning:
        return "running"
    elif v == RustCsgRolloutStatusCompleted:
        return "completed"
    elif v == RustCsgRolloutStatusFailed:
        return "failed"
    elif v == RustCsgRolloutStatusAborted:
        return "aborted"
    return "unknown"

