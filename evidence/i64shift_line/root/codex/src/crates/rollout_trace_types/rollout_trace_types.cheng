const RustCsgRawTraceEventPayloadToolCallRuntimeStarted: int32 = 12
const RustCsgRawTraceEventPayloadToolCallRuntimeEnded: int32 = 13
const RustCsgRawTraceEventPayloadToolCallEnded: int32 = 14
