const RustCsgRawTraceEventPayloadAgentResultObserved: int32 = 22
const RustCsgRawTraceEventPayloadProtocolEventObserved: int32 = 23
const RustCsgRawTraceEventPayloadOther: int32 = 24

fn RawTraceEventPayloadName(v: int32): str =
    if v == RustCsgRawTraceEventPayloadRolloutStarted:
        return "rollout_started"
    elif v == RustCsgRawTraceEventPayloadRolloutEnded:
        return "rollout_ended"
    elif v == RustCsgRawTraceEventPayloadThreadStarted:
        return "thread_started"
    elif v == RustCsgRawTraceEventPayloadThreadEnded:
        return "thread_ended"
    elif v == RustCsgRawTraceEventPayloadCodexTurnStarted:
        return "codex_turn_started"
    elif v == RustCsgRawTraceEventPayloadCodexTurnEnded:
        return "codex_turn_ended"
    elif v == RustCsgRawTraceEventPayloadInferenceStarted:
        return "inference_started"
    elif v == RustCsgRawTraceEventPayloadInferenceCompleted:
        return "inference_completed"
    elif v == RustCsgRawTraceEventPayloadInferenceFailed:
        return "inference_failed"
    elif v == RustCsgRawTraceEventPayloadInferenceCancelled:
        return "inference_cancelled"
    elif v == RustCsgRawTraceEventPayloadToolCallStarted:
        return "tool_call_started"
    elif v == RustCsgRawTraceEventPayloadMcpToolCallCorrelationAssigned:
        return "mcp_tool_call_correlation_assigned"
    elif v == RustCsgRawTraceEventPayloadToolCallRuntimeStarted:
        return "tool_call_runtime_started"
    elif v == RustCsgRawTraceEventPayloadToolCallRuntimeEnded:
        return "tool_call_runtime_ended"
    elif v == RustCsgRawTraceEventPayloadToolCallEnded:
        return "tool_call_ended"
    elif v == RustCsgRawTraceEventPayloadCodeCellStarted:
        return "code_cell_started"
    elif v == RustCsgRawTraceEventPayloadCodeCellInitialResponse:
        return "code_cell_initial_response"
    elif v == RustCsgRawTraceEventPayloadCodeCellEnded:
        return "code_cell_ended"
    elif v == RustCsgRawTraceEventPayloadCompactionRequestStarted:
        return "compaction_request_started"
    elif v == RustCsgRawTraceEventPayloadCompactionRequestCompleted:
        return "compaction_request_completed"
    elif v == RustCsgRawTraceEventPayloadCompactionRequestFailed:
        return "compaction_request_failed"
    elif v == RustCsgRawTraceEventPayloadCompactionInstalled:
        return "compaction_installed"
    elif v == RustCsgRawTraceEventPayloadAgentResultObserved:
        return "agent_result_observed"
    elif v == RustCsgRawTraceEventPayloadProtocolEventObserved:
        return "protocol_event_observed"
    elif v == RustCsgRawTraceEventPayloadOther:
        return "other"
    return "unknown"

