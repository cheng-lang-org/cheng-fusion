const RustCsgRawTraceEventPayloadThreadEnded: int32 = 3
const RustCsgRawTraceEventPayloadCodexTurnStarted: int32 = 4
const RustCsgRawTraceEventPayloadCodexTurnEnded: int32 = 5
const RustCsgRawTraceEventPayloadInferenceStarted: int32 = 6
const RustCsgRawTraceEventPayloadInferenceCompleted: int32 = 7
const RustCsgRawTraceEventPayloadInferenceFailed: int32 = 8
const RustCsgRawTraceEventPayloadInferenceCancelled: int32 = 9
