import std/strings as strings
import std/strutils as strutil

# ── Plugin ID validation (ported from codex-rs plugin) ──

fn validatePluginSegment(segment: str): bool =
    if segment.len == 0:
        return false
    for i in 0..<segment.len:
        let ch = segment[i]
        if ch >= 'a' && ch <= 'z':
            continue
        if ch >= '0' && ch <= '9':
            continue
        if ch == '-' || ch == '_':
            continue
        return false
    return true

fn validatePluginId(id: str): int32 =
    # Returns 0 for valid, non-zero error code:
    # 1 = empty id
    # 2 = invalid format (no slash, wrong slash position)
    # 3 = invalid segment characters
    if id.len == 0:
        return 1
    # Format is either "/name" or "namespace/name"
    if id[0] == '/':
        if id.len <= 1:
            return 2
        let name = strings.SliceBytes(id, 1, id.len - 1)
        for i in 0..<name.len:
            if name[i] == '/':
                return 2
        if !validatePluginSegment(name):
            return 3
        return 0
    let slashIdx: int32 = -1
    for i in 0..<id.len:
        if id[i] == '/':
            if slashIdx >= 0:
                return 2
            slashIdx = i
    if slashIdx <= 0 || slashIdx >= id.len - 1:
        return 2
    let namespace = strings.SliceBytes(id, 0, slashIdx)
    let name = strings.SliceBytes(id, slashIdx + 1, id.len - slashIdx - 1)
    if !validatePluginSegment(namespace):
        return 3
    if !validatePluginSegment(name):
        return 3
    return 0
