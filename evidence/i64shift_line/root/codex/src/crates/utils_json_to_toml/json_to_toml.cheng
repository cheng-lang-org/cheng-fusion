// JSON-to-TOML value converter — ported from codex-rs utils/json-to-toml
// Converts std/json JsonNode values to TOML-compatible string representations.
//
// Simplified: returns TOML value strings rather than a TOML AST.
// Handles null, bool, int, float, string, array, and object (flat only).

import std/json
import std/strings
import std/strutils as strutil

// Convert a JSON value to its TOML string representation.
fn RustCsgJsonToTomlValue(node: json.JsonNode): str =
    if node.kind == json.JNull:
        return ""
    elif node.kind == json.JBool:
        if node.b:
            return "true"
        else:
            return "false"
    elif node.kind == json.JInt:
        return strings.Int64ToStr(node.i)
    elif node.kind == json.JFloat:
        return strutil.FormatFloat(node.f)
    elif node.kind == json.JString:
        return strutil.Join(["\"", node.s, "\""], "")
    elif node.kind == json.JArray:
        var parts: str[]
        for i in 0..<node.a.len:
            add(parts, RustCsgJsonToTomlValue(node.a[i]))
        return strutil.Join(["[", strutil.Join(parts, ", "), "]"], "")
    elif node.kind == json.JObject:
        // TOML inline table
        var parts: str[]
        for i in 0..<node.okeys.len:
            let key = node.okeys[i]
            let val = RustCsgJsonToTomlValue(node.ovalues[i])
            add(parts, strutil.Join([key, " = ", val], ""))
        return strutil.Join(["{ ", strutil.Join(parts, ", "), " }"], "")
    return ""

// Public API matching the Rust crate's main export.
fn RustCsgJsonToToml(node: json.JsonNode): str =
    return RustCsgJsonToTomlValue(node)

// Convert a simple JSON object string to TOML format.
// Handles flat objects with string, number, bool, and null values.
// Returns empty string for invalid or empty input.
fn convertJsonToToml(json: str): str =
    if json.len < 2 || json[0] != '{':
        return ""
    var parts: str[]
    var i: int32 = 1
    while i < json.len:
        while i < json.len && (json[i] == ' ' || json[i] == ',' || json[i] == '\n' || json[i] == '\r' || json[i] == '\t'):
            i = i + 1
        if i >= json.len || json[i] == '}':
            break
        if json[i] != '"':
            break
        i = i + 1
        var ks: int32 = i
        while i < json.len && json[i] != '"':
            i = i + 1
        var key: str = strings.SliceBytes(json, ks, i - ks)
        i = i + 1
        while i < json.len && json[i] == ' ':
            i = i + 1
        if i >= json.len || json[i] != ':':
            break
        i = i + 1
        while i < json.len && json[i] == ' ':
            i = i + 1
        if i >= json.len:
            break
        if json[i] == '"':
            i = i + 1
            var vs: int32 = i
            while i < json.len && json[i] != '"':
                i = i + 1
            var val: str = strings.SliceBytes(json, vs, i - vs)
            i = i + 1
            add(parts, strutil.Join([key, " = \"", val, "\""], ""))
        elif json[i] == 't' || json[i] == 'f' || json[i] == 'n':
            var vs: int32 = i
            while i < json.len && json[i] != ',' && json[i] != '}' && json[i] != ' ':
                i = i + 1
            var val: str = strings.SliceBytes(json, vs, i - vs)
            if val == "null":
                add(parts, strutil.Join([key, " = \"\""], ""))
            else:
                add(parts, strutil.Join([key, " = ", val], ""))
        else:
            var vs: int32 = i
            while i < json.len && json[i] != ',' && json[i] != '}' && json[i] != ' ':
                i = i + 1
            var val: str = strings.SliceBytes(json, vs, i - vs)
            add(parts, strutil.Join([key, " = ", val], ""))
    return strutil.Join(parts, ", ")
