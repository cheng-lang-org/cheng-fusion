# Thread Manager Sample — type definition constants and config builder
#
# Ported from codex-rs/codex-thread-manager-sample/src/main.rs
# Covers: Args struct (clap), top-level config types used,
#         buildSampleThreadConfig helper.

import std/strings

# ── Args (clap Parser struct) ─────────────────────────────────────────
const RustCsgThreadManagerSampleArgsFieldCount: int32 = 2
const RustCsgThreadManagerSampleArgsField1: str = "model"
const RustCsgThreadManagerSampleArgsField2: str = "prompt"

fn ThreadManagerSampleArgsFields(): str =
    return "model|opt_str,prompt|vec_str"

# ── Config fields tracked (from main.rs new_config) ──────────────────
# Key fields set in the Config struct for thread manager sample usage
const RustCsgThreadManagerSampleConfigRelevantFieldCount: int32 = 5
const RustCsgThreadManagerSampleConfigRelevantField1: str = "model"
const RustCsgThreadManagerSampleConfigRelevantField2: str = "model_provider_id"
const RustCsgThreadManagerSampleConfigRelevantField3: str = "cwd"
const RustCsgThreadManagerSampleConfigRelevantField4: str = "ephemeral"
const RustCsgThreadManagerSampleConfigRelevantField5: str = "codex_home"

fn ThreadManagerSampleConfigRelevantFields(): str =
    return "model|opt_str,model_provider_id|str,cwd|abs_path_buf,ephemeral|bool,codex_home|path_buf"

# ── Key function count ─────────────────────────────────────────────
const RustCsgThreadManagerSampleFunctionCount: int32 = 3
const RustCsgThreadManagerSampleFunction1: str = "main"
const RustCsgThreadManagerSampleFunction2: str = "run_main"
const RustCsgThreadManagerSampleFunction3: str = "run_turn"

fn ThreadManagerSampleFunctionNames(): str =
    return "main,run_main,run_turn"

# ── buildSampleThreadConfig: returns a default thread config JSON ────────
# Builds a JSON object with default configuration fields for a sample thread:
#   {"model":"claude-sonnet-4","modelProviderId":"anthropic",
#    "cwd":"/tmp","ephemeral":true}

fn buildSampleThreadConfig(): str =
    var out: str = "{"
    out = strings.ConcatStr(out, "\"model\":\"claude-sonnet-4\"")
    out = strings.ConcatStr(out, ",")
    out = strings.ConcatStr(out, "\"modelProviderId\":\"anthropic\"")
    out = strings.ConcatStr(out, ",")
    out = strings.ConcatStr(out, "\"cwd\":\"/tmp\"")
    out = strings.ConcatStr(out, ",")
    out = strings.ConcatStr(out, "\"ephemeral\":true")
    out = strings.ConcatStr(out, "}")
    return out

# ── createSampleThread: creates a sample thread config with title ──────────
# Builds a JSON thread config with the given thread title/name.
# Returns config with model, provider, and thread name fields.

fn createSampleThread(name: str): str =
      var out: str = "{"
      out = strings.ConcatStr(out, "\"model\":\"claude-sonnet-4\"")
      out = strings.ConcatStr(out, ",")
      out = strings.ConcatStr(out, "\"modelProviderId\":\"anthropic\"")
      out = strings.ConcatStr(out, ",")
      out = strings.ConcatStr(out, "\"thread_name\":\"")
      out = strings.ConcatStr(out, name)
      out = strings.ConcatStr(out, "\"")
      out = strings.ConcatStr(out, ",")
      out = strings.ConcatStr(out, "\"ephemeral\":true")
      out = strings.ConcatStr(out, "}")
      return out
