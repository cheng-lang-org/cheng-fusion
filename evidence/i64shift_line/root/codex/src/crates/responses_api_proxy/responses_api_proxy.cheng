# ── HTTP request parser ─────────────────────────────────────────────────

fn parseProxyRequest(rawHttp: str): str =
    # Extracts method|path|first-header-line from raw HTTP request
    var i: int32 = 0
    let n = strings.Len(rawHttp)

    # Skip leading whitespace
    while i < n && rawHttp[i] == ' ':
        i = i + 1

    # Parse method
    let methodStart = i
    while i < n && rawHttp[i] != ' ':
        i = i + 1
    let methodEnd = i

    # Skip spaces to path
    while i < n && rawHttp[i] == ' ':
        i = i + 1

    # Parse path
    let pathStart = i
    while i < n && rawHttp[i] != ' ' && rawHttp[i] != '\n' && rawHttp[i] != '\r':
        i = i + 1
    let pathEnd = i

    # Skip to headers (past the request line)
    while i < n && rawHttp[i] != '\n':
        i = i + 1
    if i < n:
        i = i + 1  # skip LF

    # Skip any blank lines (\r\n or \n)
    while i < n && (rawHttp[i] == '\r' || rawHttp[i] == '\n'):
        i = i + 1

    # Read first header line
    let headerStart = i
    while i < n && rawHttp[i] != '\n' && rawHttp[i] != '\r':
        i = i + 1
    let headerEnd = i

    let method = strutl.sliceStr(rawHttp, methodStart, methodEnd - 1)
    let path = strutl.sliceStr(rawHttp, pathStart, pathEnd - 1)
    let headerLine = strutl.sliceStr(rawHttp, headerStart, headerEnd - 1)

    return strutl.Join([method, path, headerLine], "|")

# ── formatProxyResponse: constructs an HTTP proxy response string ──────────
# Builds a minimal HTTP/1.1 response with the given status code and body.
# Returns the response as a string in "HTTP/1.1 <status>\r\n\r\n<body>" format.

fn formatProxyResponse(status: int32, body: str): str =
      var s: str
      if status == 200:
            s = "200"
      elif status == 201:
            s = "201"
      elif status == 204:
            s = "204"
      elif status == 400:
            s = "400"
      elif status == 401:
            s = "401"
      elif status == 403:
            s = "403"
      elif status == 404:
            s = "404"
      elif status == 500:
            s = "500"
      elif status == 502:
            s = "502"
      elif status == 503:
            s = "503"
      else:
            s = "200"
      var out: str = "HTTP/1.1 "
      out = strings.ConcatStr(out, s)
      out = strings.ConcatStr(out, " \r\n\r\n")
      out = strings.ConcatStr(out, body)
      return out
