# app-server-daemon: Daemon lifecycle management for app-server
# Ported from codex-rs/app-server-daemon
#
# Pure Cheng logic: enums, constants, and pure functions (restart_decision,
# should_reexec_updater, remote_control_status).

# ── Constants ─────────────────────────────────────────────────────────────────

const
    RustCsgDaemonStartPollIntervalMs: int32 = 50
    RustCsgDaemonStartTimeoutMs: int32 = 10000
    RustCsgDaemonOperationLockTimeoutMs: int32 = 75000
    RustCsgDaemonPidFileName: str = "app-server.pid"
    RustCsgDaemonUpdatePidFileName: str = "app-server-updater.pid"
    RustCsgDaemonOperationLockFileName: str = "daemon.lock"
    RustCsgDaemonSettingsFileName: str = "settings.json"
    RustCsgDaemonStateDirName: str = "app-server-daemon"

# ── LifecycleCommand enum ────────────────────────────────────────────────────

const
    RustCsgDaemonLifecycleCommandStart: int32 = 0
    RustCsgDaemonLifecycleCommandRestart: int32 = 1
    RustCsgDaemonLifecycleCommandStop: int32 = 2
    RustCsgDaemonLifecycleCommandVersion: int32 = 3

fn RustCsgDaemonLifecycleCommandText(cmd: int32): str =
    if cmd == RustCsgDaemonLifecycleCommandStart:
        return "start"
    elif cmd == RustCsgDaemonLifecycleCommandRestart:
        return "restart"
    elif cmd == RustCsgDaemonLifecycleCommandStop:
        return "stop"
    elif cmd == RustCsgDaemonLifecycleCommandVersion:
        return "version"
    return ""

# ── LifecycleStatus enum ─────────────────────────────────────────────────────

const
    RustCsgDaemonLifecycleStatusAlreadyRunning: int32 = 0
    RustCsgDaemonLifecycleStatusStarted: int32 = 1
    RustCsgDaemonLifecycleStatusRestarted: int32 = 2
    RustCsgDaemonLifecycleStatusStopped: int32 = 3
    RustCsgDaemonLifecycleStatusNotRunning: int32 = 4
    RustCsgDaemonLifecycleStatusRunning: int32 = 5

fn RustCsgDaemonLifecycleStatusText(status: int32): str =
    if status == RustCsgDaemonLifecycleStatusAlreadyRunning:
        return "alreadyRunning"
    elif status == RustCsgDaemonLifecycleStatusStarted:
        return "started"
    elif status == RustCsgDaemonLifecycleStatusRestarted:
        return "restarted"
    elif status == RustCsgDaemonLifecycleStatusStopped:
        return "stopped"
    elif status == RustCsgDaemonLifecycleStatusNotRunning:
        return "notRunning"
    elif status == RustCsgDaemonLifecycleStatusRunning:
        return "running"
    return ""

# ── RestartIfRunningOutcome enum ─────────────────────────────────────────────

const
    RustCsgDaemonRestartOutcomeBusy: int32 = 0
    RustCsgDaemonRestartOutcomeNotRunning: int32 = 1
    RustCsgDaemonRestartOutcomeNotReady: int32 = 2
    RustCsgDaemonRestartOutcomeAlreadyCurrent: int32 = 3
    RustCsgDaemonRestartOutcomeRestarted: int32 = 4

# ── RestartMode enum ─────────────────────────────────────────────────────────

const
    RustCsgDaemonRestartModeIfVersionChanged: int32 = 0
    RustCsgDaemonRestartModeAlways: int32 = 1

# ── UpdaterRefreshMode enum ──────────────────────────────────────────────────

const
    RustCsgDaemonUpdaterRefreshNone: int32 = 0
    RustCsgDaemonUpdaterRefreshReexecIfManagedBinaryChanged: int32 = 1

# ── RestartDecision enum ─────────────────────────────────────────────────────

const
    RustCsgDaemonRestartDecisionNotReady: int32 = 0
    RustCsgDaemonRestartDecisionAlreadyCurrent: int32 = 1
    RustCsgDaemonRestartDecisionRestart: int32 = 2

# ── RemoteControlMode enum ───────────────────────────────────────────────────

const
    RustCsgDaemonRemoteControlEnabled: int32 = 0
    RustCsgDaemonRemoteControlDisabled: int32 = 1

fn RustCsgDaemonRemoteControlIsEnabled(mode: int32): bool =
    return mode == RustCsgDaemonRemoteControlEnabled

# ── RemoteControlStatus enum ─────────────────────────────────────────────────

const
    RustCsgDaemonRemoteControlStatusEnabled: int32 = 0
    RustCsgDaemonRemoteControlStatusDisabled: int32 = 1
    RustCsgDaemonRemoteControlStatusAlreadyEnabled: int32 = 2
    RustCsgDaemonRemoteControlStatusAlreadyDisabled: int32 = 3

fn RustCsgDaemonRemoteControlStatusText(status: int32): str =
    if status == RustCsgDaemonRemoteControlStatusEnabled:
        return "enabled"
    elif status == RustCsgDaemonRemoteControlStatusDisabled:
        return "disabled"
    elif status == RustCsgDaemonRemoteControlStatusAlreadyEnabled:
        return "alreadyEnabled"
    elif status == RustCsgDaemonRemoteControlStatusAlreadyDisabled:
        return "alreadyDisabled"
    return ""

# ── BackendKind enum ─────────────────────────────────────────────────────────

const
    RustCsgDaemonBackendKindPid: int32 = 0

fn RustCsgDaemonBackendKindText(kind: int32): str =
    if kind == RustCsgDaemonBackendKindPid:
        return "pid"
    return ""

# ── BootstrapStatus enum ─────────────────────────────────────────────────────

const
    RustCsgDaemonBootstrapStatusBootstrapped: int32 = 0

fn RustCsgDaemonBootstrapStatusText(status: int32): str =
    if status == RustCsgDaemonBootstrapStatusBootstrapped:
        return "bootstrapped"
    return ""

# ── classifyDaemonCommand ───────────────────────────────────────────────────
# Map a command name string to the corresponding LifecycleCommand enum value.
# Returns -1 if the command name is unknown.
fn RustCsgDaemonClassifyDaemonCommand(cmd: str): int32 =
    if cmd == "start":
        return RustCsgDaemonLifecycleCommandStart
    elif cmd == "restart":
        return RustCsgDaemonLifecycleCommandRestart
    elif cmd == "stop":
        return RustCsgDaemonLifecycleCommandStop
    elif cmd == "version":
        return RustCsgDaemonLifecycleCommandVersion
    return -1

# ── Pure business logic functions ────────────────────────────────────────────
#
# restart_decision: Determines whether to restart based on mode and versions.
#
fn RustCsgDaemonRestartDecision(
    mode: int32,
    hasInfo: bool,
    appServerVersion: str,
    managedVersion: str,
    managedVersionAvailable: bool
): int32 =
    if mode == RustCsgDaemonRestartModeIfVersionChanged:
        if !hasInfo:
            return RustCsgDaemonRestartDecisionNotReady
        if managedVersionAvailable && appServerVersion == managedVersion:
            return RustCsgDaemonRestartDecisionAlreadyCurrent
    return RustCsgDaemonRestartDecisionRestart

# should_reexec_updater: Should the updater re-exec after a restart?
fn RustCsgDaemonShouldReexecUpdater(
    updaterMode: int32,
    outcome: int32
): bool =
    return updaterMode == RustCsgDaemonUpdaterRefreshReexecIfManagedBinaryChanged &&
           outcome == RustCsgDaemonRestartOutcomeRestarted

# remote_control_status: Direct mode -> status mapping
fn RustCsgDaemonRemoteControlStatus(mode: int32): int32 =
    if mode == RustCsgDaemonRemoteControlEnabled:
        return RustCsgDaemonRemoteControlStatusEnabled
    return RustCsgDaemonRemoteControlStatusDisabled

# already_remote_control_status: Already-* mode -> status mapping
fn RustCsgDaemonAlreadyRemoteControlStatus(mode: int32): int32 =
    if mode == RustCsgDaemonRemoteControlEnabled:
        return RustCsgDaemonRemoteControlStatusAlreadyEnabled
    return RustCsgDaemonRemoteControlStatusAlreadyDisabled

import std/strings

# ── daemonBuildConfig: builds daemon config JSON from parsed args ────────────
# Parses command-line arguments string (space-separated) and builds a daemon
# configuration JSON object. Recognizes: --state-dir, --log-level, --port, --pid-file.
# Returns a JSON string with config fields, or {} for empty args.

fn daemonBuildConfig(args: str): str =
    if args.len == 0:
        return "{}"
    var out: str = "{"
    var hasPrev: bool = false
    var i: int32 = 0
    var argStart: int32 = 0
    while i <= args.len:
        var isEnd: bool = false
        if i == args.len || args[i] == ' ':
            isEnd = true
        if isEnd:
            var argLen: int32 = i - argStart
            if argLen > 0:
                var arg: str
                var si: int32 = 0
                while si < argLen:
                    arg = strings.ConcatStr(arg, strings.SliceBytes(args, argStart + si, 1))
                    si = si + 1
                # Check for --key=value pattern
                if argLen > 2:
                    if arg[0] == '-' && arg[1] == '-':
                        var eqPos: int32 = -1
                        var ci: int32 = 2
                        while ci < argLen:
                            if arg[ci] == '=':
                                eqPos = ci
                                break
                            ci = ci + 1
                        if eqPos > 2:
                            var key: str
                            var ki: int32 = 2
                            while ki < eqPos:
                                key = strings.ConcatStr(key, strings.SliceBytes(arg, ki, 1))
                                ki = ki + 1
                            var val: str
                            var vi: int32 = eqPos + 1
                            while vi < argLen:
                                val = strings.ConcatStr(val, strings.SliceBytes(arg, vi, 1))
                                vi = vi + 1
                            if val.len > 0:
                                if hasPrev:
                                    out = strings.ConcatStr(out, ",")
                                out = strings.ConcatStr(out, strings.ConcatStr(strings.ConcatStr("\"", key), strings.ConcatStr("\":\"", val)))
                                out = strings.ConcatStr(out, "\"")
                                hasPrev = true
            argStart = i + 1
        i = i + 1
    out = strings.ConcatStr(out, "}")
    return out
