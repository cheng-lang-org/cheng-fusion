# v8-poc: V8 engine proof-of-concept crate.
# Ported from codex-rs/v8-poc
#
# Production functions:
#   parseV8Version(versionStr) — extract major.minor.patch from V8 version string

import std/strings
import std/strutils as strutil

# Bazel label for this proof-of-concept crate.
const V8PocBazelTarget: str = "//codex-rs/v8-poc:v8-poc"

# Function names exposed by the crate:
const V8PocEmbeddedVersionFn: str = "embedded_v8_version"
const V8PocHasSandboxFn: str = "linked_v8_has_sandbox"

fn V8PocParseV8Version(versionStr: str): str =
    if versionStr == "":
        return ""
    let parts = strutil.Split(versionStr, '.')
    if parts.len < 3:
        return versionStr
    return strutil.Join([parts[0], parts[1], parts[2]], ".")

# Parse V8 heap statistics from output string.
# Extracts the "heap_used" and "heap_total" values from a V8 --print-heap-statistics
# output line. Returns "used,total" on success, "" on failure.
fn V8PocParseHeapStats(output: str): str =
    if output.len == 0:
        return ""
    # Scan for "heap_used="
    var usedIdx: int32 = -1
    let label1: str = "heap_used="
    var i: int32 = 0
    let end1: int32 = output.len - 10
    while i < end1:
        if output[i] == 'h' &&
           output[i+1] == 'e' &&
           output[i+2] == 'a' &&
           output[i+3] == 'p' &&
           output[i+4] == '_' &&
           output[i+5] == 'u' &&
           output[i+6] == 's' &&
           output[i+7] == 'e' &&
           output[i+8] == 'd' &&
           output[i+9] == '=':
            usedIdx = i
            break
        i = i + 1
    if usedIdx < 0:
        return ""
    let valStart: int32 = usedIdx + 10
    # Read until comma or space
    var valEnd: int32 = valStart
    while valEnd < output.len && output[valEnd] != ',' && output[valEnd] != ' ':
        valEnd = valEnd + 1
    if valEnd == valStart:
        return ""
    let usedStr: str = strings.SliceBytes(output, valStart, valEnd - valStart)

    # Scan for "heap_total=" after used position
    var totalIdx: int32 = -1
    let label2: str = "heap_total="
    i = valEnd
    let end2: int32 = output.len - 11
    while i < end2:
        if output[i] == 'h' &&
           output[i+1] == 'e' &&
           output[i+2] == 'a' &&
           output[i+3] == 'p' &&
           output[i+4] == '_' &&
           output[i+5] == 't' &&
           output[i+6] == 'o' &&
           output[i+7] == 't' &&
           output[i+8] == 'a' &&
           output[i+9] == 'l' &&
           output[i+10] == '=':
            totalIdx = i
            break
        i = i + 1
    if totalIdx < 0:
        return ""
    let tStart: int32 = totalIdx + 11
    var tEnd: int32 = tStart
    while tEnd < output.len && output[tEnd] != ',' && output[tEnd] != ' ':
        tEnd = tEnd + 1
    if tEnd == tStart:
        return ""
    let totalStr: str = strings.SliceBytes(output, tStart, tEnd - tStart)

    return strutil.Join([usedStr, ",", totalStr], "")
