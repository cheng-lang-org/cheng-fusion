# ═══════════════════════════════════════════════════════════════════════════
# Production Functions
# ═══════════════════════════════════════════════════════════════════════════


# Extract a goal title from markdown goal spec text.
# Looks for a markdown heading (# Title) and extracts the title text.
# Returns the title in outTitle and sets outOk on success.
fn parseGoalSpec(goalText: str, outTitle: var str, outOk: var bool) =
    outTitle = ""
    outOk = false
    if goalText.len == 0:
        return
    # Count leading '#' markers
    var i: int32 = 0
    while i < goalText.len && goalText[i] == '#':
        i = i + 1
    if i == 0:
        return  # not a markdown heading
    # Skip whitespace after '#'
    while i < goalText.len && goalText[i] == 32:
        i = i + 1
    # Rest of line is the title
    let titleStart: int32 = i
    while i < goalText.len && goalText[i] != '\n' && goalText[i] != '\r':
        i = i + 1
    let titleLen: int32 = i - titleStart
    if titleLen > 0:
        outTitle = strings.SliceBytes(goalText, titleStart, titleLen)
        outOk = true

# Validate that a goal spec is complete.
# Checks for a markdown title and non-empty content.
fn validateGoalSpec(spec: str): bool =
    if spec.len == 0:
        return false
    var title: str
    var ok: bool
    parseGoalSpec(spec, title, ok)
    if !ok:
        return false
    if title.len == 0:
        return false
    # Must have content beyond the title line
    if spec.len < 3:
        return false
    return true
