import std/strings as strings
import std/strutils as strutil

# ── Sandbox policy summary formatting (ported from codex-rs utils/sandbox-summary) ──
# Formats a sandbox policy as human-readable text.

# Returns a line formatted as "  - <key>: <value>"
fn polLine(key: str, value: str): str =
    var r: str = "  - "
    r = strutil.Join([r, key, ": ", value], "")
    return r

fn netLine(allowed: bool, desc: str): str =
    if allowed:
        var r: str = "  - network: "
        r = strutil.Join([r, desc], "")
        return r
    return "  - network: blocked"

fn fsLine(readOk: bool, writeOk: bool, dirs: str): str =
    var p: str = ""
    if readOk:
        p = "read"
    else:
        p = "no_read"
    if writeOk:
        p = strutil.Join([p, ",write"], "")
    else:
        p = strutil.Join([p, ",no_write"], "")
    if dirs.len > 0:
        p = strutil.Join([p, ",dirs=", dirs], "")
    var r: str = "  - filesystem: "
    r = strutil.Join([r, p], "")
    return r

fn sandSummary(policy: str): str =
    var lines: str[]
    add(lines, "sandbox policy:")
    if strutil.Contains(policy, "\"network_enabled\":true") || strutil.Contains(policy, "\"networkEnabled\":true"):
        add(lines, netLine(true, "enabled"))
    elif strutil.Contains(policy, "\"network_enabled\":false") || strutil.Contains(policy, "\"networkEnabled\":false"):
        add(lines, netLine(false, ""))
    if strutil.Contains(policy, "\"filesystem_read\":true") || strutil.Contains(policy, "\"filesystemRead\":true"):
        add(lines, fsLine(true, false, ""))
    elif strutil.Contains(policy, "\"filesystem_read\":false") || strutil.Contains(policy, "\"filesystemRead\":false"):
        var d: str
        if strutil.Contains(policy, "\"allowed_directories\""):
            d = "(restricted)"
        add(lines, fsLine(false, false, d))
    add(lines, "")
    return strutil.Join(lines, "\n")

# Generate a comprehensive sandbox report from policy JSON.
# Produces a multi-line formatted report with header, policy details, and risk level.
fn generateSandboxReport(policy: str): str =
    var lines: str[]
    add(lines, "=== Sandbox Report ===")
    add(lines, sandSummary(policy))
    var networkOk: bool = false
    if strutil.Contains(policy, "\"network_enabled\":true") || strutil.Contains(policy, "\"networkEnabled\":true"):
        networkOk = true
    var fsOk: bool = false
    if strutil.Contains(policy, "\"filesystem_read\":true") || strutil.Contains(policy, "\"filesystemRead\":true"):
        fsOk = true
    if networkOk && fsOk:
        add(lines, "risk: low")
    elif !networkOk && !fsOk:
        add(lines, "risk: high")
    else:
        add(lines, "risk: medium")
    add(lines, "=== End Report ===")
    return strutil.Join(lines, "\n")
