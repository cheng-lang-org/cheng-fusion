        "• Calling search.find_docs({\"query\":\"ratatui styling\",\"limit\":3})",
    ])

fn RustCsgTuiHistoryCellByName(name: str): str =
    if name == "single_line_command_compact_when_fits":
        return RustCsgTuiHistoryCellSingleLineCommandCompact()
    if name == "single_line_command_wraps_with_four_space_continuation":
        return RustCsgTuiHistoryCellSingleLineCommandWraps()
    if name == "multiline_command_both_lines_wrap_with_correct_prefixes":
        return RustCsgTuiHistoryCellMultilineCommandBothWrap()
    if name == "multiline_command_without_wrap_uses_branch_then_eight_spaces":
        return RustCsgTuiHistoryCellMultilineCommandWithoutWrap()
    if name == "multiline_command_wraps_with_extra_indent_on_subsequent_lines":
        return RustCsgTuiHistoryCellMultilineCommandExtraIndent()
    if name == "ran_cell_multiline_with_stderr_snapshot":
        return RustCsgTuiHistoryCellRanMultilineWithStderr()
    if name == "ps_output_empty_snapshot":
        return RustCsgTuiHistoryCellPsEmpty()
    if name == "ps_output_multiline_snapshot":
        return RustCsgTuiHistoryCellPsMultiline()
    if name == "ps_output_long_command_snapshot":
        return RustCsgTuiHistoryCellPsLongCommand()
    if name == "ps_output_many_sessions_snapshot":
        return RustCsgTuiHistoryCellPsManySessions()
    if name == "ps_output_chunk_leading_whitespace_snapshot":
        return RustCsgTuiHistoryCellPsChunkLeadingWhitespace()
    if name == "plan_update_with_note_and_wrapping_snapshot":
        return RustCsgTuiHistoryCellPlanWithNote()
    if name == "plan_update_without_note_snapshot":
        return RustCsgTuiHistoryCellPlanWithoutNote()
    if name == "standalone_unix_update_available_history_cell_snapshot":
        return RustCsgTuiHistoryCellStandaloneUnixUpdateAvailable()
    if name == "standalone_windows_update_available_history_cell_snapshot":
        return RustCsgTuiHistoryCellStandaloneWindowsUpdateAvailable()
    if name == "web_search_history_cell_snapshot":
        return RustCsgTuiHistoryCellWebSearch()
    if name == "web_search_history_cell_without_detail_snapshot":
        return RustCsgTuiHistoryCellWebSearchWithoutDetail()
    if name == "web_search_history_cell_transcript_snapshot":
        return RustCsgTuiHistoryCellWebSearch()
    if name == "streamed_agent_list_paragraph_preserves_item_indent_when_wrapped":
        return RustCsgTuiHistoryCellStreamedAgentListIndent()
    if name == "user_history_cell_wraps_and_prefixes_each_line_snapshot":
        return RustCsgTuiHistoryCellUserWraps()
    if name == "user_history_cell_renders_remote_image_urls":
        return RustCsgTuiHistoryCellUserRemoteImage()
    if name == "user_history_cell_numbers_multiple_remote_images":
        return RustCsgTuiHistoryCellUserMultipleRemoteImages()
    if name == "session_header_indicates_yolo_mode":
        return RustCsgTuiHistoryCellSessionHeaderYolo()
    if name == "raw_mode_toggle_transcript":
        return RustCsgTuiHistoryCellRawModeToggleTranscript()
    if name == "cyber_policy_error_event_snapshot":
        return RustCsgTuiHistoryCellCyberPolicyErrorEvent()
    if name == "cyber_policy_error_event_narrow_snapshot":
        return RustCsgTuiHistoryCellCyberPolicyErrorEventNarrow()
    if name == "error_event_oversized_input_snapshot":
        return RustCsgTuiHistoryCellErrorOversizedInput()
    if name == "mcp_inventory_loading_snapshot":
        return RustCsgTuiHistoryCellMcpInventoryLoading()
    if name == "session_info_availability_nux_tooltip_snapshot":
        return RustCsgTuiHistoryCellSessionInfoAvailabilityNux()
    if name == "stderr_tail_more_than_five_lines_snapshot":
        return RustCsgTuiHistoryCellStderrTailMoreThanFiveLines()
    if name == "coalesced_reads_dedupe_names":
        return RustCsgTuiHistoryCellCoalescedReadsDedupeNames()
    if name == "coalesces_reads_across_multiple_calls":
        return RustCsgTuiHistoryCellCoalescesReadsAcrossMultipleCalls()
    if name == "coalesces_sequential_reads_within_one_call":
        return RustCsgTuiHistoryCellCoalescesSequentialReads()
    if name == "mcp_tools_output_lists_tools_for_hyphenated_server_names":
        return RustCsgTuiHistoryCellMcpToolsHyphenated()
    if name == "mcp_tools_output_masks_sensitive_values":
        return RustCsgTuiHistoryCellMcpToolsMasksSensitive()
    if name == "mcp_tools_output_from_statuses_renders_status_only_servers":
        return RustCsgTuiHistoryCellMcpToolsStatusOnly()
    if name == "mcp_tools_output_from_statuses_renders_verbose_inventory":
        return RustCsgTuiHistoryCellMcpToolsVerboseInventory()
    if name == "completed_mcp_tool_call_success_snapshot":
        return RustCsgTuiHistoryCellCompletedMcpSuccess()
    if name == "completed_mcp_tool_call_error_snapshot":
        return RustCsgTuiHistoryCellCompletedMcpError()
    if name == "completed_mcp_tool_call_multiple_outputs_snapshot":
        return RustCsgTuiHistoryCellCompletedMcpMultipleOutputs()
    if name == "completed_mcp_tool_call_wrapped_outputs_snapshot":
        return RustCsgTuiHistoryCellCompletedMcpWrappedOutputs()
    if name == "completed_mcp_tool_call_multiple_outputs_inline_snapshot":
        return RustCsgTuiHistoryCellCompletedMcpMultipleOutputsInline()
    if name == "active_mcp_tool_call_snapshot":
        return RustCsgTuiHistoryCellActiveMcpCall()
    return ""
