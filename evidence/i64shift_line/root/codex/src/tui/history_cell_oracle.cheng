# TUI history_cell snapshot oracle for command, ps, plan, user and search cells.

import std/strutils as strutil

fn RustCsgTuiHistoryCellLines(lines: str[]): str =
    return strutil.Join([strutil.Join(lines, "\n"), "\n"], "")

fn RustCsgTuiHistoryCellSingleLineCommandCompact(): str =
    return RustCsgTuiHistoryCellLines([
        "• Ran echo ok",
        "  └ (no output)",
    ])

fn RustCsgTuiHistoryCellSingleLineCommandWraps(): str =
    return RustCsgTuiHistoryCellLines([
        "• Ran a_very_long_token_",
        "  │ without_spaces_to_",
        "  │ force_wrapping",
        "  └ (no output)",
    ])

fn RustCsgTuiHistoryCellMultilineCommandBothWrap(): str =
    return RustCsgTuiHistoryCellLines([
        "• Ran first_token_is_long_en",
        "  │ ough_to_wrap",
        "  │ second_token_is_also_lon",
        "  │ … +1 lines",
        "  └ (no output)",
    ])

fn RustCsgTuiHistoryCellMultilineCommandWithoutWrap(): str =
    return RustCsgTuiHistoryCellLines([
        "• Ran echo one",
        "  │ echo two",
        "  └ (no output)",
    ])

fn RustCsgTuiHistoryCellMultilineCommandExtraIndent(): str =
    return RustCsgTuiHistoryCellLines([
        "• Ran set -o pipefail",
        "  │ cargo test -p codex-tui",
        "  │ --quiet",
