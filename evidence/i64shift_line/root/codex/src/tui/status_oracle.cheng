fn RustCsgTuiStatusOracleByName(name: str): str =
    if name == "status_snapshot_cached_limits_hide_credits_without_flag":
        return RustCsgTuiStatusOracleCachedLimitsHideCredits()
    if name == "status_snapshot_includes_credits_and_limits":
        return RustCsgTuiStatusOracleCreditsAndLimits()
    if name == "status_snapshot_includes_forked_from":
        return RustCsgTuiStatusOracleForkedFrom()
    if name == "status_snapshot_includes_monthly_limit":
        return RustCsgTuiStatusOracleMonthlyLimit()
    if name == "status_snapshot_includes_reasoning_details":
        return RustCsgTuiStatusOracleIncludesReasoningDetails()
    if name == "status_snapshot_shows_empty_limits_message":
        return RustCsgTuiStatusOracleEmptyLimits()
    if name == "status_snapshot_shows_missing_limits_message":
        return RustCsgTuiStatusOracleMissingLimits()
    if name == "status_snapshot_shows_refreshing_limits_notice":
        return RustCsgTuiStatusOracleRefreshingLimits()
    if name == "status_snapshot_shows_stale_limits_message":
        return RustCsgTuiStatusOracleStaleLimits()
    if name == "status_snapshot_truncates_in_narrow_terminal":
        return RustCsgTuiStatusOracleNarrowTruncated()
    return ""
