# TUI /status snapshot oracle.

import std/strings
import std/strutils as strutil

fn RustCsgTuiStatusOracleRepeat(text: str, count: int32): str =
    var out: str = ""
    var i: int32 = 0
    while i < count:
        out = strings.ConcatStr(out, text)
        i = i + 1
    return out

fn RustCsgTuiStatusOracleStartsWithAt(text: str, index: int32, prefix: str): bool =
    let prefixLen: int32 = strings.Len(prefix)
    if index < 0:
        return false
    if index + prefixLen > strings.Len(text):
        return false
    return strings.SliceBytes(text, index, prefixLen) == prefix

fn RustCsgTuiStatusOracleNextGlyph(text: str, index: int32): str =
    if RustCsgTuiStatusOracleStartsWithAt(text, index, "█"):
        return "█"
    if RustCsgTuiStatusOracleStartsWithAt(text, index, "░"):
        return "░"
    return strings.SliceBytes(text, index, 1)

fn RustCsgTuiStatusOracleDisplayWidth(text: str): int32 =
    var width: int32 = 0
    var i: int32 = 0
    let n: int32 = strings.Len(text)
    while i < n:
        let glyph: str = RustCsgTuiStatusOracleNextGlyph(text, i)
        width = width + 1
        i = i + strings.Len(glyph)
    return width

fn RustCsgTuiStatusOraclePadDisplay(text: str, width: int32): str =
    var out: str = text
    var displayWidth: int32 = RustCsgTuiStatusOracleDisplayWidth(text)
    while displayWidth < width:
        out = strings.ConcatStr(out, " ")
        displayWidth = displayWidth + 1
    return out

fn RustCsgTuiStatusOracleBox(interiorWidth: int32, bodyLines: str[]): str =
    var out: str = strutil.Join([
        "/status",
        "",
        strutil.Join(["╭", RustCsgTuiStatusOracleRepeat("─", interiorWidth), "╮"], ""),
    ], "\n")
    out = strings.ConcatStr(out, "\n")
    var i: int32 = 0
    while i < bodyLines.len:
        out = strings.ConcatStr(out, strutil.Join(["│", RustCsgTuiStatusOraclePadDisplay(bodyLines[i], interiorWidth), "│\n"], ""))
        i = i + 1
    out = strings.ConcatStr(out, strutil.Join(["╰", RustCsgTuiStatusOracleRepeat("─", interiorWidth), "╯\n"], ""))
    return out

fn RustCsgTuiStatusOracleIncludesReasoningDetails(): str =
    return RustCsgTuiStatusOracleBox(75, [
        "  >_ OpenAI Codex (v0.0.0)",
        "",
        " Visit https://chatgpt.com/codex/settings/usage for up-to-date",
        " information on rate limits and credits",
