# TUI chatwidget policy, limits, and update popup snapshot oracle.

import std/strutils as strutil

fn RustCsgTuiChatwidgetPolicyLines(lines: str[]): str =
    return strutil.Join([strutil.Join(lines, "\n"), "\n"], "")

fn RustCsgTuiChatwidgetMultiAgentEnablePrompt(): str =
    return RustCsgTuiChatwidgetPolicyLines([
        "  Enable subagents?",
        "  Subagents are currently disabled in your config.",
        "",
        "› 1. Yes, enable  Save the setting now. You will need a new session to use it.",
        "  2. Not now      Keep subagents disabled.",
        "",
        "  Press enter to confirm or esc to go back",
    ])

fn RustCsgTuiChatwidgetFullAccessConfirmationPopup(): str =
    return RustCsgTuiChatwidgetPolicyLines([
        "  Enable full access?",
        "  When Codex runs with full access, it can edit any file on your computer and",
        "  run commands with network, without your approval. Exercise caution when",
        "  enabling full access. This significantly increases the risk of data loss,",
        "  leaks, or unexpected behavior.",
        "",
        "› 1. Yes, continue anyway      Apply full access for this session",
        "  2. Yes, and don't ask again  Enable full access and remember this choice",
        "  3. Cancel                    Go back without enabling full access",
        "",
        "  Press enter to confirm or esc to go back",
    ])

fn RustCsgTuiChatwidgetProfilePermissionsSelectionPopup(): str =
    return RustCsgTuiChatwidgetPolicyLines([
        "  Update Model Permissions",
        "",
        "› 1. Ask for approval (current)  Codex can read and edit files in the current",
        "                                 workspace, and run commands. Approval is",
        "                                 required to access the internet or edit other",
        "                                 files.",
        "  2. Approve for me              Only ask for actions detected as potentially",
        "                                 unsafe.",
        "  3. Full Access                 Codex can edit files outside this workspace",
        "                                 and access the internet without asking for",
        "                                 approval. Exercise caution when using.",
        "  4. Read Only                   Codex can read files in the current",
        "                                 workspace. Approval is required to edit files",
        "                                 or access the internet.",
        "",
        "  Press enter to confirm or esc to go back",
    ])

fn RustCsgTuiChatwidgetProfilePermissionsSelectionCustomProfiles(): str =
    return RustCsgTuiChatwidgetPolicyLines([
        "  Update Model Permissions",
        "",
        "  1. Ask for approval       Codex can read and edit files in the current",
        "                            workspace, and run commands. Approval is required",
        "                            to access the internet or edit other files.",
        "  2. Approve for me         Only ask for actions detected as potentially",
        "                            unsafe.",
        "  3. Full Access            Codex can edit files outside this workspace and",
        "                            access the internet without asking for approval.",
        "                            Exercise caution when using.",
        "  4. Read Only              Codex can read files in the current workspace.",
        "                            Approval is required to edit files or access the",
        "                            internet.",
        "› 5. locked-down (current)  Inspect and patch only approved workspace files.",
        "  6. web-enabled            Workspace profile with network access.",
        "",
        "  Press enter to confirm or esc to go back",
    ])

fn RustCsgTuiChatwidgetRateLimitSwitchPromptPopup(): str =
    return RustCsgTuiChatwidgetPolicyLines([
        "  Approaching rate limits",
        "  Switch to gpt-5.1-codex-mini for lower credit usage?",
        "",
        "› 1. Switch to gpt-5.1-codex-mini           Optimized for codex. Cheaper,",
        "                                            faster, but less capable.",
        "  2. Keep current model",
        "  3. Keep current model (never show again)  Hide future rate limit reminders",
        "                                            about switching models.",
        "",
        "  Press enter to confirm or esc to go back",
    ])

fn RustCsgTuiChatwidgetWorkspaceMemberCreditsDepletedPrompt(): str =
    return RustCsgTuiChatwidgetPolicyLines([
        "  You've reached your workspace credit limit",
        "  Your workspace is out of credits. Ask your workspace owner to add more. Notify owner?",
        "",
        "  1. Yes (y)",
        "› 2. No (default) (n)",
        "",
        "  Press enter to confirm or esc to go back",
    ])

fn RustCsgTuiChatwidgetWorkspaceMemberUsageLimitPrompt(): str =
    return RustCsgTuiChatwidgetPolicyLines([
        "  Usage limit reached",
        "  Request a limit increase from your owner to continue using codex. Request increase?",
        "",
        "  1. Yes (y)",
        "› 2. No (default) (n)",
        "",
        "  Press enter to confirm or esc to go back",
    ])

fn RustCsgTuiChatwidgetWorkspaceOwnerCreditsNudgeCompletionFeedback(): str =
    return RustCsgTuiChatwidgetPolicyLines([
        "• Workspace owner notified.",
        "",
        "---",
        "• Workspace owner was already notified recently.",
        "",
        "---",
        "• Could not notify your workspace owner. Please try again.",
    ])

fn RustCsgTuiChatwidgetWorkspaceOwnerLimitStateMessages(): str =
    return RustCsgTuiChatwidgetPolicyLines([
        "■ You're out of credits. Your workspace is out of credits. Add credits to continue using Codex.",
        "",
        "---",
        "■ Usage limit reached. You've reached your usage limit. Increase your limits to continue using codex.",
    ])

fn RustCsgTuiChatwidgetWorkspaceOwnerUsageLimitNudgeCompletionFeedback(): str =
    return RustCsgTuiChatwidgetPolicyLines([
        "• Limit increase requested.",
        "",
        "---",
        "• A limit increase was already requested recently.",
        "",
        "---",
        "• Could not request a limit increase. Please try again.",
    ])

