# TUI bottom_pane/mcp_server_elicitation oracle renderer.

import std/strings
import std/strutils as strutil

fn RustCsgTuiMcpElicitationSpaces(count: int32): str =
    var out: str = ""
    var i: int32 = 0
    while i < count:
        out = strings.ConcatStr(out, " ")
        i = i + 1
    return out

fn RustCsgTuiMcpElicitationStartsWithAt(text: str, index: int32, prefix: str): bool =
    let prefixLen: int32 = strings.Len(prefix)
    if index < 0:
        return false
    if index + prefixLen > strings.Len(text):
        return false
    return strings.SliceBytes(text, index, prefixLen) == prefix

fn RustCsgTuiMcpElicitationNextGlyph(text: str, index: int32): str =
    if RustCsgTuiMcpElicitationStartsWithAt(text, index, "›"):
        return "›"
    return strings.SliceBytes(text, index, 1)

fn RustCsgTuiMcpElicitationDisplayWidth(text: str): int32 =
    var width: int32 = 0
    var i: int32 = 0
    while i < strings.Len(text):
        let glyph: str = RustCsgTuiMcpElicitationNextGlyph(text, i)
        width = width + 1
        i = i + strings.Len(glyph)
    return width

fn RustCsgTuiMcpElicitationPadDisplay(text: str, width: int32): str =
    let currentWidth: int32 = RustCsgTuiMcpElicitationDisplayWidth(text)
    if currentWidth > width:
        assert(false, "mcp elicitation line exceeds width")
    return strings.ConcatStr(text, RustCsgTuiMcpElicitationSpaces(width - currentWidth))

fn RustCsgTuiMcpElicitationSurface(width: int32, lines: str[]): str =
    var padded: str[]
    var i: int32 = 0
    while i < lines.len:
        if i == lines.len - 1:
            add(padded, lines[i])
        else:
            add(padded, RustCsgTuiMcpElicitationPadDisplay(lines[i], width))
        i = i + 1
    return strings.ConcatStr(strutil.Join(padded, "\n"), "\n")

fn RustCsgTuiMcpElicitationOption(selected: bool,
                                  number: int32,
                                  label: str,
                                  description: str,
                                  labelWidth: int32): str =
    var marker: str = "  "
    if selected:
        marker = "› "
    let labelText: str = strutil.Join([strings.IntToStr(number), ". ", label], "")
    return strutil.Join(["  ", marker, RustCsgTuiMcpElicitationPadDisplay(labelText, labelWidth), "  ", description], "")

fn RustCsgTuiMcpElicitationApprovalNoSchemaSnapshot(): str =
    return RustCsgTuiMcpElicitationSurface(120, [
        "",
        "  Field 1/1",
        "  Allow this request?",
        RustCsgTuiMcpElicitationOption(true, 1, "Allow", "Run the tool and continue.", 9),
        RustCsgTuiMcpElicitationOption(false, 2, "Cancel", "Cancel this tool call", 9),
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "  enter to submit | esc to cancel"
    ])

