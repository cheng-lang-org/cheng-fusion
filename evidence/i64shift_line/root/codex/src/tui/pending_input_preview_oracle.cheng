# TUI bottom_pane pending_input_preview Buffer Debug oracle renderer.

import cheng/codex/tui/queue_oracle as queue

fn RustCsgTuiPendingInputPreviewOneMessageSnapshot(): str =
    return queue.RustCsgTuiQueueBufferDebug(40, 3, [
        "• Queued follow-up messages",
        "  ↳ Hello, world!",
        "    ⌥ + ↑ edit last queued message"
    ], [
        queue.RustCsgTuiQueueStyle(0, 0, "DIM"),
        queue.RustCsgTuiQueueStyle(2, 0, "NONE"),
        queue.RustCsgTuiQueueStyle(0, 1, "DIM"),
        queue.RustCsgTuiQueueStyle(4, 1, "DIM | ITALIC"),
        queue.RustCsgTuiQueueStyle(17, 1, "NONE"),
        queue.RustCsgTuiQueueStyle(0, 2, "DIM"),
        queue.RustCsgTuiQueueStyle(34, 2, "NONE")
    ])

