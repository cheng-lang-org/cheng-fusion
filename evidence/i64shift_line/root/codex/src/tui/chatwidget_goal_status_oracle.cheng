# TUI chatwidget goal/status snapshot oracle.

import std/strings
import std/strutils as strutil

fn RustCsgTuiChatwidgetGoalStatusLines(lines: str[]): str =
    return strutil.Join([strutil.Join(lines, "\n"), "\n"], "")

fn RustCsgTuiChatwidgetGoalSummary(status: str, budgetLine: str, commands: str): str =
    if strings.Len(budgetLine) > 0:
        return RustCsgTuiChatwidgetGoalStatusLines([
            "Goal",
            strutil.Join(["Status: ", status], ""),
            "Objective: Keep improving the bare goal command until it feels calm and useful.",
            "Time used: 1m",
            "Tokens used: 12.5K",
            budgetLine,
            "",
            strutil.Join(["Commands: ", commands], ""),
        ])
    return RustCsgTuiChatwidgetGoalStatusLines([
        "Goal",
        strutil.Join(["Status: ", status], ""),
        "Objective: Keep improving the bare goal command until it feels calm and useful.",
        "Time used: 1m",
        "Tokens used: 12.5K",
        "",
        strutil.Join(["Commands: ", commands], ""),
    ])

fn RustCsgTuiChatwidgetGoalActive(): str =
    return RustCsgTuiChatwidgetGoalSummary("active", "Token budget: 80K", "/goal edit, /goal pause, /goal clear")

fn RustCsgTuiChatwidgetGoalPaused(): str =
    return RustCsgTuiChatwidgetGoalSummary("paused", "", "/goal edit, /goal resume, /goal clear")

fn RustCsgTuiChatwidgetGoalBlocked(): str =
    return RustCsgTuiChatwidgetGoalSummary("blocked", "", "/goal edit, /goal resume, /goal clear")

fn RustCsgTuiChatwidgetGoalBudgetLimited(): str =
    return RustCsgTuiChatwidgetGoalSummary("limited by budget", "Token budget: 80K", "/goal edit, /goal clear")

fn RustCsgTuiChatwidgetGoalUsageLimited(): str =
    return RustCsgTuiChatwidgetGoalSummary("usage limited", "", "/goal edit, /goal resume, /goal clear")

