    ])

fn RustCsgTuiChatwidgetSpaces(count: int32): str =
    var out: str = ""
    var i: int32 = 0
    while i < count:
        out = strings.ConcatStr(out, " ")
        i = i + 1
    return out

fn RustCsgTuiChatwidgetQuotedRow(text: str, trailingSpaces: int32): str =
    return strutil.Join(["\"", text, RustCsgTuiChatwidgetSpaces(trailingSpaces), "\"\n"], "")

fn RustCsgTuiChatwidgetStatusFooter(row: str, trailingSpaces: int32): str =
    return strutil.Join([
        RustCsgTuiChatwidgetQuotedRow("", 80),
        RustCsgTuiChatwidgetQuotedRow("", 80),
        RustCsgTuiChatwidgetQuotedRow("› Ask Codex to do anything", 54),
        RustCsgTuiChatwidgetQuotedRow("", 80),
        RustCsgTuiChatwidgetQuotedRow(row, trailingSpaces),
    ], "")

