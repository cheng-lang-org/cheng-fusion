# TUI chatwidget approval request snapshot oracle.

import std/strutils as strutil

fn RustCsgTuiChatwidgetApprovalLines(lines: str[]): str =
    return strutil.Join([strutil.Join(lines, "\n"), "\n"], "")

fn RustCsgTuiChatwidgetApprovalModalExec(): str =
    return RustCsgTuiChatwidgetApprovalLines([
        "Buffer {",
        "    area: Rect { x: 0, y: 0, width: 80, height: 13 },",
        "    content: [",
        "        \"                                                                                \",",
        "        \"                                                                                \",",
        "        \"  Would you like to run the following command?                                  \",",
        "        \"                                                                                \",",
        "        \"  Reason: this is a test reason such as one that would be produced by the       \",",
        "        \"  model                                                                         \",",
        "        \"                                                                                \",",
        "        \"  $ echo hello world                                                            \",",
        "        \"                                                                                \",",
        "        \"› 1. Yes, proceed (y)                                                           \",",
        "        \"  2. No, and tell Codex what to do differently (esc)                            \",",
        "        \"                                                                                \",",
        "        \"  Press enter to confirm or esc to cancel                                       \",",
        "    ],",
        "    styles: [",
        "        x: 0, y: 0, fg: Reset, bg: Reset, underline: Reset, modifier: NONE,",
        "        x: 2, y: 2, fg: Reset, bg: Reset, underline: Reset, modifier: BOLD,",
        "        x: 46, y: 2, fg: Reset, bg: Reset, underline: Reset, modifier: NONE,",
        "        x: 10, y: 4, fg: Reset, bg: Reset, underline: Reset, modifier: ITALIC,",
        "        x: 73, y: 4, fg: Reset, bg: Reset, underline: Reset, modifier: NONE,",
        "        x: 2, y: 5, fg: Reset, bg: Reset, underline: Reset, modifier: ITALIC,",
        "        x: 7, y: 5, fg: Reset, bg: Reset, underline: Reset, modifier: NONE,",
        "        x: 4, y: 7, fg: Rgb(137, 180, 250), bg: Reset, underline: Reset, modifier: NONE,",
        "        x: 8, y: 7, fg: Rgb(205, 214, 244), bg: Reset, underline: Reset, modifier: NONE,",
        "        x: 20, y: 7, fg: Reset, bg: Reset, underline: Reset, modifier: NONE,",
        "        x: 0, y: 9, fg: Cyan, bg: Reset, underline: Reset, modifier: BOLD,",
        "        x: 21, y: 9, fg: Reset, bg: Reset, underline: Reset, modifier: NONE,",
        "        x: 48, y: 10, fg: Reset, bg: Reset, underline: Reset, modifier: DIM,",
        "        x: 51, y: 10, fg: Reset, bg: Reset, underline: Reset, modifier: NONE,",
        "        x: 2, y: 12, fg: Reset, bg: Reset, underline: Reset, modifier: DIM,",
        "    ]",
        "}",
    ])

fn RustCsgTuiChatwidgetApprovalModalExecVt100(): str =
    return RustCsgTuiChatwidgetApprovalLines([
        "",
        "",
        "  Would you like to run the following command?",
        "",
        "  Reason: this is a test reason such as one that would be produced by the model",
        "",
        "  $ echo hello world",
        "",
        "› 1. Yes, proceed (y)",
        "  2. Yes, and don't ask again for commands that start with `echo hello world` (p)",
        "  3. No, and tell Codex what to do differently (esc)",
        "",
        "  Press enter to confirm or esc to cancel",
    ])

fn RustCsgTuiChatwidgetApprovalModalExecNoReason(): str =
    return RustCsgTuiChatwidgetApprovalLines([
        "",
        "",
        "  Would you like to run the following command?",
        "",
        "  $ echo hello world",
        "",
        "› 1. Yes, proceed (y)",
        "  2. Yes, and don't ask again for commands that start with `echo hello world` (p)",
        "  3. No, and tell Codex what to do differently (esc)",
        "",
        "  Press enter to confirm or esc to cancel",
    ])

fn RustCsgTuiChatwidgetApprovalModalExecMultilineNoExecPolicy(): str =
    return RustCsgTuiChatwidgetApprovalLines([
        "",
        "",
        "  Would you like to run the following command?",
        "",
        "  $ python - <<'PY'",
        "  print('hello')",
        "  PY",
        "",
        "› 1. Yes, proceed (y)",
        "  2. No, and tell Codex what to do differently (esc)",
        "",
        "  Press enter to confirm or esc to cancel",
    ])

fn RustCsgTuiChatwidgetApprovalModalPatch(): str =
    return RustCsgTuiChatwidgetApprovalLines([
        "",
        "",
        "  Would you like to make the following edits?",
        "",
        "  Reason: The model wants to apply changes",
        "",
        "  README.md (+2 -0)",
        "",
        "    1 +hello",
        "    2 +world",
        "",
        "› 1. Yes, proceed (y)",
        "  2. Yes, and don't ask again for these files (a)",
        "  3. No, and tell Codex what to do differently (esc)",
        "",
        "  Press enter to confirm or esc to cancel",
    ])

fn RustCsgTuiChatwidgetApprovalApprovedShort(): str =
    return RustCsgTuiChatwidgetApprovalLines([
        "✔ You approved codex to run echo hello world this time",
    ])

fn RustCsgTuiChatwidgetApprovalAbortedLong(): str =
    return RustCsgTuiChatwidgetApprovalLines([
        "✗ You canceled the request to run echo",
        "  aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa...",
    ])

fn RustCsgTuiChatwidgetApprovalAbortedMultiline(): str =
    return RustCsgTuiChatwidgetApprovalLines([
        "✗ You canceled the request to run echo line1 ...",
    ])

fn RustCsgTuiChatwidgetApprovalNetworkOneTime(): str =
    return RustCsgTuiChatwidgetApprovalLines([
        "✔ You approved codex network access to http://example.com this time",
    ])

fn RustCsgTuiChatwidgetApprovalNetworkSession(): str =
    return RustCsgTuiChatwidgetApprovalLines([
        "✔ You approved codex network access to https://example.com:8443 every time this",
        "  session",
    ])

fn RustCsgTuiChatwidgetApprovalNetworkCanceled(): str =
    return RustCsgTuiChatwidgetApprovalLines([
        "✗ You canceled the request for codex network access to",
        "  socks5-tcp://example.com:1080",
    ])
