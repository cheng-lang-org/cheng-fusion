import std/strings
import cheng/codex/protocol/wire

const
    RustCsgTuiChatReplayItemUserMessage: str = "userMessage"
    RustCsgTuiChatReplayItemAgentMessage: str = "agentMessage"
    RustCsgTuiChatReplayItemReasoning: str = "reasoning"
    RustCsgTuiChatReplayItemCommandExecution: str = "commandExecution"

type
    RustCsgTuiChatReplayTurn =
        id: str
        itemsJson: str
        status: str
        errorJson: str

    RustCsgTuiChatReplayPlan =
        ok: bool
        turnCount: int32
        eventCount: int32
        userMessageCount: int32
        agentMessageCount: int32
        reasoningCount: int32
        commandExecutionCount: int32
        hasInterruptedTurn: bool
        hasFailedTurn: bool
        eventsJson: str
        displayTranscriptText: str
        error: str

fn RustCsgTuiChatReplayError(message: str): RustCsgTuiChatReplayPlan =
    var plan: RustCsgTuiChatReplayPlan
    plan.error = message
    return plan

fn RustCsgTuiChatReplayStartsWithAt(text: str, index: int32, pattern: str): bool =
    if index < 0:
        return false
    if index + pattern.len > text.len:
        return false
    var i: int32
    while i < pattern.len:
        if text[index + i] != pattern[i]:
            return false
        i = i + 1
    return true

fn RustCsgTuiChatReplaySkipSpace(text: str, index: int32): int32 =
    var i = index
    while i < text.len:
        let ch = text[i]
        if ch != ' ' && ch != '\n' && ch != '\r' && ch != '\t':
            return i
        i = i + 1
    return i

fn RustCsgTuiChatReplayValueEnd(text: str, valueStart: int32): int32 =
    if valueStart < 0 || valueStart >= text.len:
        return -1
    let first = text[valueStart]
    var inString: bool
    var escaped: bool
    if first == '"':
        var s = valueStart + 1
        while s < text.len:
            let ch = text[s]
            if escaped:
                escaped = false
            elif ch == '\\':
                escaped = true
            elif ch == '"':
                return s + 1
            s = s + 1
        return -1
    if first == '{' || first == '[':
        var depth: int32
        var i = valueStart
        while i < text.len:
            let ch = text[i]
            if inString:
                if escaped:
                    escaped = false
                elif ch == '\\':
                    escaped = true
                elif ch == '"':
                    inString = false
            else:
                if ch == '"':
                    inString = true
                elif ch == '{' || ch == '[':
                    depth = depth + 1
                elif ch == '}' || ch == ']':
                    depth = depth - 1
                    if depth == 0:
                        return i + 1
            i = i + 1
        return -1
    var p = valueStart
    while p < text.len:
        let ch = text[p]
        if ch == ',' || ch == '}' || ch == ']' || ch == ' ' || ch == '\n' || ch == '\r' || ch == '\t':
            return p
        p = p + 1
    return p

fn RustCsgTuiChatReplayTopLevelValueStart(text: str, key: str): int32 =
    let start = RustCsgTuiChatReplaySkipSpace(text, 0)
    if start >= text.len || text[start] != '{':
        return -1
    let pattern = wire.RustCsgCat3("\"", key, "\"")
    var depth: int32
    var inString: bool
    var escaped: bool
    var i = start
    while i < text.len:
        let ch = text[i]
        if inString:
            if escaped:
                escaped = false
            elif ch == '\\':
                escaped = true
            elif ch == '"':
                inString = false
        else:
            if ch == '"':
                if depth == 1 && RustCsgTuiChatReplayStartsWithAt(text, i, pattern):
                    var p = i + pattern.len
                    p = RustCsgTuiChatReplaySkipSpace(text, p)
                    if p < text.len && text[p] == ':':
                        return RustCsgTuiChatReplaySkipSpace(text, p + 1)
                inString = true
            elif ch == '{' || ch == '[':
                depth = depth + 1
            elif ch == '}' || ch == ']':
                depth = depth - 1
                if depth < 0:
                    return -1
        i = i + 1
    return -1

fn RustCsgTuiChatReplayTopLevelValueRaw(text: str, key: str): str =
    let start = RustCsgTuiChatReplayTopLevelValueStart(text, key)
    if start < 0:
        return ""
    let endPos = RustCsgTuiChatReplayValueEnd(text, start)
    if endPos < start:
        return ""
    return strings.SliceBytes(text, start, endPos - start)

fn RustCsgTuiChatReplayJsonStringRaw(raw: str, ok: var bool): str =
    ok = false
    let start = RustCsgTuiChatReplaySkipSpace(raw, 0)
    if start >= raw.len || raw[start] != '"':
        return ""
    var out: str
    var i = start + 1
    while i < raw.len:
        let ch = raw[i]
        if ch == '\\':
            if i + 1 >= raw.len:
                return ""
            let escaped = raw[i + 1]
            if escaped == '"' || escaped == '\\' || escaped == '/':
                out = wire.RustCsgCat(out, strings.SliceBytes(raw, i + 1, 1))
            elif escaped == 'n':
                out = wire.RustCsgCat(out, "\n")
            elif escaped == 'r':
                out = wire.RustCsgCat(out, "\r")
            elif escaped == 't':
                out = wire.RustCsgCat(out, "\t")
            else:
                return ""
            i = i + 2
            continue
        if ch == '"':
            ok = true
            return out
        out = wire.RustCsgCat(out, strings.SliceBytes(raw, i, 1))
        i = i + 1
    return ""

fn RustCsgTuiChatReplayTopLevelStr(text: str, key: str, ok: var bool): str =
    ok = false
    let raw = RustCsgTuiChatReplayTopLevelValueRaw(text, key)
    if raw == "":
        return ""
    return RustCsgTuiChatReplayJsonStringRaw(raw, ok)

fn RustCsgTuiChatReplayArrayLen(arrayJson: str): int32 =
    let start = RustCsgTuiChatReplaySkipSpace(arrayJson, 0)
    if start >= arrayJson.len || arrayJson[start] != '[':
        assert(false, "json array expected")
    var count: int32
    var depth: int32
    var inString: bool
    var escaped: bool
    var sawValue: bool
    var i = start + 1
    while i < arrayJson.len:
        let ch = arrayJson[i]
        if inString:
            if escaped:
                escaped = false
            elif ch == '\\':
                escaped = true
            elif ch == '"':
                inString = false
        elif ch == '"':
            inString = true
            sawValue = true
        elif ch == '[' || ch == '{':
            depth = depth + 1
            sawValue = true
        elif ch == ']' || ch == '}':
            if depth == 0:
                if sawValue:
                    count = count + 1
                return count
            depth = depth - 1
        elif ch == ',' && depth == 0:
            count = count + 1
            sawValue = false
        elif ch != ' ' && ch != '\n' && ch != '\r' && ch != '\t':
            sawValue = true
        i = i + 1
    assert(false, "unterminated json array")
    return 0

fn RustCsgTuiChatReplayArrayObjectAt(arrayJson: str, target: int32): str =
    let start = RustCsgTuiChatReplaySkipSpace(arrayJson, 0)
    if start >= arrayJson.len || arrayJson[start] != '[':
        assert(false, "json object array expected")
    var pos = RustCsgTuiChatReplaySkipSpace(arrayJson, start + 1)
    if pos < arrayJson.len && arrayJson[pos] == ']':
        assert(false, "json array object index out of bounds")
    var index: int32
    while pos < arrayJson.len:
        if arrayJson[pos] != '{':
            assert(false, "json array item is not object")
        let endPos = RustCsgTuiChatReplayValueEnd(arrayJson, pos)
        if endPos <= pos:
            assert(false, "unterminated json object array item")
        if index == target:
            return strings.SliceBytes(arrayJson, pos, endPos - pos)
        index = index + 1
        pos = RustCsgTuiChatReplaySkipSpace(arrayJson, endPos)
        if pos < arrayJson.len && arrayJson[pos] == ',':
            pos = RustCsgTuiChatReplaySkipSpace(arrayJson, pos + 1)
            continue
        if pos < arrayJson.len && arrayJson[pos] == ']':
            break
        assert(false, "malformed json object array")
    assert(false, "json array object index out of bounds")
    return ""

fn RustCsgTuiChatReplayTurnFromJson(turnJson: str, ok: var bool): RustCsgTuiChatReplayTurn =
    ok = false
    var turn: RustCsgTuiChatReplayTurn
    turn.id = RustCsgTuiChatReplayTopLevelStr(turnJson, "id", ok)
    if !ok || turn.id == "":
        return turn
    let itemsRaw = RustCsgTuiChatReplayTopLevelValueRaw(turnJson, "items")
    if itemsRaw == "" || itemsRaw[0] != '[':
        ok = false
        return turn
    turn.itemsJson = itemsRaw
    turn.status = RustCsgTuiChatReplayTopLevelStr(turnJson, "status", ok)
    if !ok || turn.status == "":
        return turn
    let errorRaw = RustCsgTuiChatReplayTopLevelValueRaw(turnJson, "error")
    if errorRaw != "" && errorRaw != "null":
        turn.errorJson = errorRaw
    ok = true
    return turn

fn RustCsgTuiChatReplayFirstTextContent(contentJson: str, ok: var bool): str =
    ok = false
    if contentJson == "" || contentJson[0] != '[':
        return ""
    let count = RustCsgTuiChatReplayArrayLen(contentJson)
    var sawText: bool
    var out: str
    for i in 0..<count:
        let entry = RustCsgTuiChatReplayArrayObjectAt(contentJson, i)
        var fieldOk: bool
        let entryType = RustCsgTuiChatReplayTopLevelStr(entry, "type", fieldOk)
        if !fieldOk || entryType == "":
            return ""
        if entryType != "text":
            return ""
        let text = RustCsgTuiChatReplayTopLevelStr(entry, "text", fieldOk)
        if !fieldOk:
            return ""
        if !sawText:
            out = text
            sawText = true
    ok = true
    return out

fn RustCsgTuiChatReplayAppendDisplayLine(plan: var RustCsgTuiChatReplayPlan, line: str) =
    if line == "":
        return
    if plan.displayTranscriptText != "":
        plan.displayTranscriptText = wire.RustCsgCat(plan.displayTranscriptText, "\n")
    plan.displayTranscriptText = wire.RustCsgCat(plan.displayTranscriptText, line)

fn RustCsgTuiChatReplayAppendEvent(plan: var RustCsgTuiChatReplayPlan,
                                   turn: var RustCsgTuiChatReplayTurn,
                                   itemId: str,
                                   itemType: str,
                                   displayKind: str,
                                   displayLine: str,
                                   text: str,
                                   status: str) =
    if plan.eventsJson == "":
        plan.eventsJson = "["
    if plan.eventCount > 0:
        plan.eventsJson = wire.RustCsgCat(plan.eventsJson, ",")
    var eventJson = "{"
    eventJson = wire.RustCsgCat(eventJson, wire.RustCsgJsonFieldStr("turnId", turn.id))
    eventJson = wire.RustCsgCat(eventJson, ",")
    eventJson = wire.RustCsgCat(eventJson, wire.RustCsgJsonFieldStr("turnStatus", turn.status))
    if turn.errorJson != "":
        eventJson = wire.RustCsgCat(eventJson, ",")
        eventJson = wire.RustCsgCat(eventJson, wire.RustCsgJsonFieldRaw("turnError", turn.errorJson))
    eventJson = wire.RustCsgCat(eventJson, ",")
    eventJson = wire.RustCsgCat(eventJson, wire.RustCsgJsonFieldStr("itemId", itemId))
    eventJson = wire.RustCsgCat(eventJson, ",")
    eventJson = wire.RustCsgCat(eventJson, wire.RustCsgJsonFieldStr("itemType", itemType))
    eventJson = wire.RustCsgCat(eventJson, ",")
    eventJson = wire.RustCsgCat(eventJson, wire.RustCsgJsonFieldStr("displayKind", displayKind))
    if displayLine != "":
        eventJson = wire.RustCsgCat(eventJson, ",")
        eventJson = wire.RustCsgCat(eventJson, wire.RustCsgJsonFieldStr("displayLine", displayLine))
    if text != "":
        eventJson = wire.RustCsgCat(eventJson, ",")
        eventJson = wire.RustCsgCat(eventJson, wire.RustCsgJsonFieldStr("text", text))
    if status != "":
        eventJson = wire.RustCsgCat(eventJson, ",")
        eventJson = wire.RustCsgCat(eventJson, wire.RustCsgJsonFieldStr("status", status))
    eventJson = wire.RustCsgCat(eventJson, "}")
    plan.eventsJson = wire.RustCsgCat(plan.eventsJson, eventJson)
    plan.eventCount = plan.eventCount + 1
    RustCsgTuiChatReplayAppendDisplayLine(plan, displayLine)

fn RustCsgTuiChatReplayAppendUserMessage(plan: var RustCsgTuiChatReplayPlan,
                                         turn: var RustCsgTuiChatReplayTurn,
                                         itemJson: str,
                                         itemId: str): str =
    let contentJson = RustCsgTuiChatReplayTopLevelValueRaw(itemJson, "content")
    var ok: bool
    let text = RustCsgTuiChatReplayFirstTextContent(contentJson, ok)
    if !ok:
        return "unsupported userMessage content"
    let line = wire.RustCsgCat("› ", text)
    RustCsgTuiChatReplayAppendEvent(plan, turn, itemId, RustCsgTuiChatReplayItemUserMessage, "user", line, text, "")
    plan.userMessageCount = plan.userMessageCount + 1
    return ""

fn RustCsgTuiChatReplayAppendAgentMessage(plan: var RustCsgTuiChatReplayPlan,
                                          turn: var RustCsgTuiChatReplayTurn,
                                          itemJson: str,
                                          itemId: str): str =
    var ok: bool
    let text = RustCsgTuiChatReplayTopLevelStr(itemJson, "text", ok)
    if !ok:
        return "agentMessage text is required"
    let line = wire.RustCsgCat("• ", text)
    RustCsgTuiChatReplayAppendEvent(plan, turn, itemId, RustCsgTuiChatReplayItemAgentMessage, "agent", line, text, "")
    plan.agentMessageCount = plan.agentMessageCount + 1
    return ""

fn RustCsgTuiChatReplayFirstStringFromArray(arrayJson: str, ok: var bool): str =
    ok = false
    if arrayJson == "" || arrayJson[0] != '[':
        return ""
    let count = RustCsgTuiChatReplayArrayLen(arrayJson)
    if count == 0:
        ok = true
        return ""
    let start = RustCsgTuiChatReplaySkipSpace(arrayJson, 1)
    let endPos = RustCsgTuiChatReplayValueEnd(arrayJson, start)
    if endPos <= start:
        return ""
    return RustCsgTuiChatReplayJsonStringRaw(strings.SliceBytes(arrayJson, start, endPos - start), ok)

fn RustCsgTuiChatReplayAppendReasoning(plan: var RustCsgTuiChatReplayPlan,
                                       turn: var RustCsgTuiChatReplayTurn,
                                       itemJson: str,
                                       itemId: str): str =
    let summaryJson = RustCsgTuiChatReplayTopLevelValueRaw(itemJson, "summary")
    var ok: bool
    let summary = RustCsgTuiChatReplayFirstStringFromArray(summaryJson, ok)
    if !ok:
        return "reasoning summary array is required"
    RustCsgTuiChatReplayAppendEvent(plan, turn, itemId, RustCsgTuiChatReplayItemReasoning, "reasoning", "", summary, "")
    plan.reasoningCount = plan.reasoningCount + 1
    return ""

fn RustCsgTuiChatReplayAppendCommandExecution(plan: var RustCsgTuiChatReplayPlan,
                                              turn: var RustCsgTuiChatReplayTurn,
                                              itemJson: str,
                                              itemId: str): str =
    var ok: bool
    let command = RustCsgTuiChatReplayTopLevelStr(itemJson, "command", ok)
    if !ok || command == "":
        return "commandExecution command is required"
    let source = RustCsgTuiChatReplayTopLevelStr(itemJson, "source", ok)
    if !ok || source == "":
        return "commandExecution source is required"
    let status = RustCsgTuiChatReplayTopLevelStr(itemJson, "status", ok)
    if !ok || status == "":
        return "commandExecution status is required"
    let outputRaw = RustCsgTuiChatReplayTopLevelValueRaw(itemJson, "aggregatedOutput")
    var output: str
    if outputRaw != "" && outputRaw != "null":
        output = RustCsgTuiChatReplayJsonStringRaw(outputRaw, ok)
        if !ok:
            return "commandExecution aggregatedOutput must be string"
    var line: str
    if source == "user":
        line = wire.RustCsgCat("• You ran ", command)
    elif source == "agent":
        line = wire.RustCsgCat("• Ran ", command)
    else:
        return wire.RustCsgCat("unsupported commandExecution source: ", source)
    if output == "":
        line = wire.RustCsgCat(line, "\n  └ (no output)")
    else:
        line = wire.RustCsgCat(wire.RustCsgCat(line, "\n  └ "), output)
    RustCsgTuiChatReplayAppendEvent(plan, turn, itemId, RustCsgTuiChatReplayItemCommandExecution, "command", line, command, status)
    plan.commandExecutionCount = plan.commandExecutionCount + 1
    return ""

fn RustCsgTuiChatReplayAppendItem(plan: var RustCsgTuiChatReplayPlan,
                                  turn: var RustCsgTuiChatReplayTurn,
                                  itemJson: str): str =
    var ok: bool
    let itemType = RustCsgTuiChatReplayTopLevelStr(itemJson, "type", ok)
    if !ok || itemType == "":
        return "item type is required"
    let itemId = RustCsgTuiChatReplayTopLevelStr(itemJson, "id", ok)
    if !ok || itemId == "":
        return wire.RustCsgCat("item id is required for type: ", itemType)
    if itemType == RustCsgTuiChatReplayItemUserMessage:
        return RustCsgTuiChatReplayAppendUserMessage(plan, turn, itemJson, itemId)
    if itemType == RustCsgTuiChatReplayItemAgentMessage:
        return RustCsgTuiChatReplayAppendAgentMessage(plan, turn, itemJson, itemId)
    if itemType == RustCsgTuiChatReplayItemReasoning:
        return RustCsgTuiChatReplayAppendReasoning(plan, turn, itemJson, itemId)
    if itemType == RustCsgTuiChatReplayItemCommandExecution:
        return RustCsgTuiChatReplayAppendCommandExecution(plan, turn, itemJson, itemId)
    return wire.RustCsgCat("unsupported history item type: ", itemType)

fn RustCsgTuiChatReplayFromTurns(turnsJson: str): RustCsgTuiChatReplayPlan =
    if turnsJson == "":
        return RustCsgTuiChatReplayError("turns json is empty")
    var plan: RustCsgTuiChatReplayPlan
    plan.ok = true
    plan.eventsJson = "["
    let turnCount = RustCsgTuiChatReplayArrayLen(turnsJson)
    for i in 0..<turnCount:
        let turnJson = RustCsgTuiChatReplayArrayObjectAt(turnsJson, i)
        var turnOk: bool
        var turn = RustCsgTuiChatReplayTurnFromJson(turnJson, turnOk)
        if !turnOk:
            return RustCsgTuiChatReplayError("invalid turn json")
        plan.turnCount = plan.turnCount + 1
        if turn.status == "interrupted":
            plan.hasInterruptedTurn = true
        if turn.status == "failed" || turn.errorJson != "":
            plan.hasFailedTurn = true
        let itemCount = RustCsgTuiChatReplayArrayLen(turn.itemsJson)
        for j in 0..<itemCount:
            let itemJson = RustCsgTuiChatReplayArrayObjectAt(turn.itemsJson, j)
            let error = RustCsgTuiChatReplayAppendItem(plan, turn, itemJson)
            if error != "":
                return RustCsgTuiChatReplayError(error)
    plan.eventsJson = wire.RustCsgCat(plan.eventsJson, "]")
    return plan

fn RustCsgTuiChatReplayPlanToJson(plan: var RustCsgTuiChatReplayPlan): str =
    if !plan.ok:
        return wire.RustCsgCat(wire.RustCsgCat("{\"ok\":false,\"error\":", wire.RustCsgJsonQuote(plan.error)), "}")
    var eventsJson = plan.eventsJson
    if eventsJson == "":
        eventsJson = "[]"
    var out = "{\"ok\":true,"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("turnCount", plan.turnCount))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("eventCount", plan.eventCount))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("userMessageCount", plan.userMessageCount))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("agentMessageCount", plan.agentMessageCount))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("reasoningCount", plan.reasoningCount))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("commandExecutionCount", plan.commandExecutionCount))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("hasInterruptedTurn", plan.hasInterruptedTurn))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("hasFailedTurn", plan.hasFailedTurn))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("events", eventsJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("displayTranscriptText", plan.displayTranscriptText))
    out = wire.RustCsgCat(out, "}")
    return out
