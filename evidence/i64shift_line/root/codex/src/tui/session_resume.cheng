import cheng/codex/config/home
import cheng/codex/config/user_config
import cheng/codex/protocol/wire
import cheng/codex/rollout/reader
import cheng/codex/state/state_db_sqlite as statedb

type
    RustCsgTuiSessionResumeRolloutState =
        ok: bool
        sawRecord: bool
        threadId: str
        cwd: str
        cwdSource: str
        model: str
        modelSource: str
        error: str

    RustCsgTuiSessionResumeStringResult =
        ok: bool
        found: bool
        value: str
        source: str
        error: str

    RustCsgTuiSessionResumeCwdOutcome =
        ok: bool
        outcome: str
        cwd: str
        historyCwd: str
        source: str
        differs: bool
        error: str

    RustCsgTuiSessionResumeConfigOutcome =
        ok: bool
        outcome: str
        cwd: str
        configJson: str
        differs: bool
        error: str

fn RustCsgTuiSessionResumeRolloutError(path: str): RustCsgTuiSessionResumeRolloutState =
    var result: RustCsgTuiSessionResumeRolloutState
    result.error = wire.RustCsgCat(wire.RustCsgCat("rollout at ", path), " is empty")
    return result

fn RustCsgTuiSessionResumeStringFound(value: str, source: str): RustCsgTuiSessionResumeStringResult =
    var result: RustCsgTuiSessionResumeStringResult
    result.ok = true
    result.found = true
    result.value = value
    result.source = source
    return result

fn RustCsgTuiSessionResumeStringMissing(): RustCsgTuiSessionResumeStringResult =
    var result: RustCsgTuiSessionResumeStringResult
    result.ok = true
    return result

fn RustCsgTuiSessionResumeCwdContinue(cwd: str, historyCwd: str, source: str, differs: bool): RustCsgTuiSessionResumeCwdOutcome =
    var result: RustCsgTuiSessionResumeCwdOutcome
    result.ok = true
    result.outcome = "continue"
    result.cwd = cwd
    result.historyCwd = historyCwd
    result.source = source
    result.differs = differs
    return result

fn RustCsgTuiSessionResumeCwdPrompt(historyCwd: str, source: str): RustCsgTuiSessionResumeCwdOutcome =
    var result: RustCsgTuiSessionResumeCwdOutcome
    result.ok = true
    result.outcome = "prompt_required"
    result.historyCwd = historyCwd
    result.source = source
    result.differs = true
    return result

fn RustCsgTuiSessionResumeCwdExit(historyCwd: str, source: str): RustCsgTuiSessionResumeCwdOutcome =
    var result: RustCsgTuiSessionResumeCwdOutcome
    result.ok = true
    result.outcome = "exit"
    result.historyCwd = historyCwd
    result.source = source
    result.differs = true
    return result

fn RustCsgTuiSessionResumeConfigJson(cwd: str, userConfigJson: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("cwd", cwd))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("userConfig", userConfigJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgTuiSessionResumeConfigRebuilt(cwd: str, configJson: str, differs: bool): RustCsgTuiSessionResumeConfigOutcome =
    var result: RustCsgTuiSessionResumeConfigOutcome
    result.ok = true
    result.outcome = "rebuilt"
    result.cwd = cwd
    result.configJson = configJson
    result.differs = differs
    return result

fn RustCsgTuiSessionResumeConfigCurrent(currentCwd: str, currentConfigJson: str): RustCsgTuiSessionResumeConfigOutcome =
    var result: RustCsgTuiSessionResumeConfigOutcome
    result.ok = true
    result.outcome = "current_config"
    result.cwd = currentCwd
    result.configJson = currentConfigJson
    return result

fn RustCsgTuiSessionResumeConfigError(message: str, differs: bool): RustCsgTuiSessionResumeConfigOutcome =
    var result: RustCsgTuiSessionResumeConfigOutcome
    result.outcome = "error"
    result.error = message
    result.differs = differs
    return result

fn RustCsgTuiSessionResumeIsAsciiSpace(ch: char): bool =
    return ch == ' ' || ch == '\n' || ch == '\r' || ch == '\t'

fn RustCsgTuiSessionResumeTrimAscii(text: str): str =
    var start: int32
    var end: int32
    end = text.len
    while start < end && RustCsgTuiSessionResumeIsAsciiSpace(text[start]):
        start = start + 1
    while end > start && RustCsgTuiSessionResumeIsAsciiSpace(text[end - 1]):
        end = end - 1
    return wire.RustCsgSliceBytes(text, start, end - start)

fn RustCsgTuiSessionResumeIsHexChar(ch: char): bool =
    if ch >= '0' && ch <= '9':
        return true
    if ch >= 'a' && ch <= 'f':
        return true
    if ch >= 'A' && ch <= 'F':
        return true
    return false

fn RustCsgTuiSessionResumeLooksLikeUuid(value: str): bool =
    if value.len != 36:
        return false
    var i: int32
    while i < value.len:
        if i == 8 || i == 13 || i == 18 || i == 23:
            if value[i] != '-':
                return false
        elif !RustCsgTuiSessionResumeIsHexChar(value[i]):
            return false
        i = i + 1
    return true

fn RustCsgTuiSessionResumePayloadObject(line: str): str =
    let payloadStart = reader.RustCsgRolloutJsonTopFieldValueStart(line, "payload")
    return reader.RustCsgRolloutJsonObjectAt(line, payloadStart)

fn RustCsgTuiSessionResumeApplyRolloutLine(line: str, state: var RustCsgTuiSessionResumeRolloutState) =
    let object = reader.RustCsgRolloutJsonObjectAt(line, 0)
    if object == "" || object.len != line.len:
        return
    var ok: bool
    let itemType = reader.RustCsgRolloutJsonRequiredString(line, "type", ok)
    if !ok:
        return
    state.sawRecord = true
    let payload = RustCsgTuiSessionResumePayloadObject(line)
    if payload == "":
        return
    if itemType == "session_meta" && state.threadId == "":
        let id = reader.RustCsgRolloutJsonRequiredString(payload, "id", ok)
        if !ok || !RustCsgTuiSessionResumeLooksLikeUuid(id):
            return
        let cwd = reader.RustCsgRolloutJsonRequiredString(payload, "cwd", ok)
        if !ok:
            return
        state.threadId = id
        if state.cwd == "":
            state.cwd = cwd
            state.cwdSource = "session_meta"
        return
    if itemType == "turn_context":
        let cwd = reader.RustCsgRolloutJsonRequiredString(payload, "cwd", ok)
        if !ok:
            return
        let model = reader.RustCsgRolloutJsonRequiredString(payload, "model", ok)
        if !ok:
            return
        state.cwd = cwd
        state.cwdSource = "turn_context"
        state.model = model
        state.modelSource = "turn_context"

fn RustCsgTuiSessionResumeReadRolloutState(path: str): RustCsgTuiSessionResumeRolloutState =
    let text = home.RustCsgReadFile(path)
    var state: RustCsgTuiSessionResumeRolloutState
    var lineStart: int32
    var i: int32
    while i <= text.len:
        if i == text.len || text[i] == '\n':
            let line = RustCsgTuiSessionResumeTrimAscii(wire.RustCsgSliceBytes(text, lineStart, i - lineStart))
            if line != "":
                RustCsgTuiSessionResumeApplyRolloutLine(line, state)
            lineStart = i + 1
        i = i + 1
    if !state.sawRecord:
        return RustCsgTuiSessionResumeRolloutError(path)
    state.ok = true
    return state

fn RustCsgTuiSessionResumeResolveSessionThreadId(path: str, idStrIfUuid: str): RustCsgTuiSessionResumeStringResult =
    if idStrIfUuid != "":
        if RustCsgTuiSessionResumeLooksLikeUuid(idStrIfUuid):
            return RustCsgTuiSessionResumeStringFound(idStrIfUuid, "explicit")
        return RustCsgTuiSessionResumeStringMissing()
    let rollout = RustCsgTuiSessionResumeReadRolloutState(path)
    if rollout.ok && rollout.threadId != "":
        return RustCsgTuiSessionResumeStringFound(rollout.threadId, "rollout")
    return RustCsgTuiSessionResumeStringMissing()

fn RustCsgTuiSessionResumeReadSessionCwd(dbPath: str, threadId: str, path: str): RustCsgTuiSessionResumeStringResult =
    if dbPath != "" && threadId != "":
        let row = statedb.RustCsgStateDbThreadByIdIncludingArchived(dbPath, threadId)
        if row.ok:
            return RustCsgTuiSessionResumeStringFound(row.cwd, "state_db")
    if path != "":
        let rollout = RustCsgTuiSessionResumeReadRolloutState(path)
        if rollout.ok && rollout.cwd != "":
            return RustCsgTuiSessionResumeStringFound(rollout.cwd, rollout.cwdSource)
    return RustCsgTuiSessionResumeStringMissing()

fn RustCsgTuiSessionResumeReadSessionModel(dbPath: str, threadId: str, path: str): RustCsgTuiSessionResumeStringResult =
    if dbPath != "" && threadId != "":
        let model = statedb.RustCsgStateDbThreadModelByIdIncludingArchived(dbPath, threadId)
        if model.ok && model.present:
            return RustCsgTuiSessionResumeStringFound(model.value, "state_db")
    if path != "":
        let rollout = RustCsgTuiSessionResumeReadRolloutState(path)
        if rollout.ok && rollout.model != "":
            return RustCsgTuiSessionResumeStringFound(rollout.model, rollout.modelSource)
    return RustCsgTuiSessionResumeStringMissing()

fn RustCsgTuiSessionResumeCwdsDiffer(currentCwd: str, sessionCwd: str): bool =
    let currentReal = home.RustCsgRealPath(currentCwd)
    let sessionReal = home.RustCsgRealPath(sessionCwd)
    if currentReal != "" && sessionReal != "":
        return currentReal != sessionReal
    return currentCwd != sessionCwd

fn RustCsgTuiSessionResumeResolveCwdForResumeOrFork(dbPath: str,
                                                    currentCwd: str,
                                                    threadId: str,
                                                    path: str,
                                                    allowPrompt: bool): RustCsgTuiSessionResumeCwdOutcome =
    let history = RustCsgTuiSessionResumeReadSessionCwd(dbPath, threadId, path)
    if !history.found:
        return RustCsgTuiSessionResumeCwdContinue("", "", "", false)
    let differs = RustCsgTuiSessionResumeCwdsDiffer(currentCwd, history.value)
    if allowPrompt && differs:
        return RustCsgTuiSessionResumeCwdPrompt(history.value, history.source)
    return RustCsgTuiSessionResumeCwdContinue(history.value, history.value, history.source, differs)

fn RustCsgTuiSessionResumeResolveCwdForResumeOrForkWithPromptChoice(dbPath: str,
                                                                    currentCwd: str,
                                                                    threadId: str,
                                                                    path: str,
                                                                    allowPrompt: bool,
                                                                    promptChoice: str): RustCsgTuiSessionResumeCwdOutcome =
    let history = RustCsgTuiSessionResumeReadSessionCwd(dbPath, threadId, path)
    if !history.found:
        return RustCsgTuiSessionResumeCwdContinue("", "", "", false)
    let differs = RustCsgTuiSessionResumeCwdsDiffer(currentCwd, history.value)
    if allowPrompt && differs:
        if promptChoice == "current":
            return RustCsgTuiSessionResumeCwdContinue(currentCwd, history.value, history.source, true)
        if promptChoice == "session":
            return RustCsgTuiSessionResumeCwdContinue(history.value, history.value, history.source, true)
        if promptChoice == "exit":
            return RustCsgTuiSessionResumeCwdExit(history.value, history.source)
        return RustCsgTuiSessionResumeCwdPrompt(history.value, history.source)
    return RustCsgTuiSessionResumeCwdContinue(history.value, history.value, history.source, differs)

fn RustCsgTuiSessionResumeRebuildConfigForCwd(codexHomePath: str,
                                              cwd: str,
                                              ignoreUserConfig: bool,
                                              selectedProfile: str): RustCsgTuiSessionResumeConfigOutcome =
    var err: str
    let loadedUserConfig = user_config.RustCsgLoadUserConfigJsonFromCodexHomeWithProfile(codexHomePath,
                                                                                         ignoreUserConfig,
                                                                                         selectedProfile,
                                                                                         err)
    if err != "":
        return RustCsgTuiSessionResumeConfigError(err, false)
    if loadedUserConfig == "":
        return RustCsgTuiSessionResumeConfigError("rebuilt config is empty", false)
    return RustCsgTuiSessionResumeConfigRebuilt(cwd,
                                                RustCsgTuiSessionResumeConfigJson(cwd, loadedUserConfig),
                                                false)

fn RustCsgTuiSessionResumeRebuildConfigForResumeOrFallback(codexHomePath: str,
                                                           currentCwd: str,
                                                           currentConfigJson: str,
                                                           resumeCwd: str,
                                                           ignoreUserConfig: bool,
                                                           selectedProfile: str): RustCsgTuiSessionResumeConfigOutcome =
    var rebuilt = RustCsgTuiSessionResumeRebuildConfigForCwd(codexHomePath,
                                                             resumeCwd,
                                                             ignoreUserConfig,
                                                             selectedProfile)
    if rebuilt.ok:
        let differsOnSuccess = RustCsgTuiSessionResumeCwdsDiffer(currentCwd, resumeCwd)
        rebuilt.differs = differsOnSuccess
        return rebuilt
    let differs = RustCsgTuiSessionResumeCwdsDiffer(currentCwd, resumeCwd)
    if differs:
        return RustCsgTuiSessionResumeConfigError(rebuilt.error, true)
    if currentConfigJson == "":
        return RustCsgTuiSessionResumeConfigError("current config is empty", false)
    return RustCsgTuiSessionResumeConfigCurrent(currentCwd, currentConfigJson)
