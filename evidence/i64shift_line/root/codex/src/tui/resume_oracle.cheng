# TUI resume_picker oracle: snapshot fixtures for all 17 resume_picker snapshots.
#
# source: tui/src/resume_picker.rs
# Tests use either `snapshot`, `terminal.backend().to_string()`, `rendered`,
# `footer_snapshot(&state, ...)`, or `render_dense_row_snapshot(...)`.

import std/strings
import std/strutils as strutil

fn RustCsgTuiResumeSpaces(count: int32): str =
    var out: str = ""
    var i: int32 = 0
    while i < count:
        out = strings.ConcatStr(out, " ")
        i = i + 1
    return out

fn RustCsgTuiResumeRepeat(text: str, count: int32): str =
    var out: str = ""
    var i: int32 = 0
    while i < count:
        out = strings.ConcatStr(out, text)
        i = i + 1
    return out

fn RustCsgTuiResumeStartsWithAt(text: str, index: int32, prefix: str): bool =
    let prefixLen: int32 = strings.Len(prefix)
    if index < 0:
        return false
    if index + prefixLen > strings.Len(text):
        return false
    return strings.SliceBytes(text, index, prefixLen) == prefix

fn RustCsgTuiResumeNextGlyph(text: str, index: int32): str =
    if RustCsgTuiResumeStartsWithAt(text, index, "↑"):
        return "↑"
    if RustCsgTuiResumeStartsWithAt(text, index, "↓"):
        return "↓"
    if RustCsgTuiResumeStartsWithAt(text, index, "←"):
        return "←"
    if RustCsgTuiResumeStartsWithAt(text, index, "→"):
        return "→"
    if RustCsgTuiResumeStartsWithAt(text, index, "─"):
        return "─"
    if RustCsgTuiResumeStartsWithAt(text, index, "·"):
        return "·"
    if RustCsgTuiResumeStartsWithAt(text, index, "⌁"):
        return "⌁"
    if RustCsgTuiResumeStartsWithAt(text, index, ""):
        return ""
    if RustCsgTuiResumeStartsWithAt(text, index, "❯"):
        return "❯"
    if RustCsgTuiResumeStartsWithAt(text, index, "⌄"):
        return "⌄"
    if RustCsgTuiResumeStartsWithAt(text, index, "…"):
        return "…"
    if RustCsgTuiResumeStartsWithAt(text, index, "│"):
        return "│"
    if RustCsgTuiResumeStartsWithAt(text, index, "└"):
        return "└"
    return strings.SliceBytes(text, index, 1)

fn RustCsgTuiResumeDisplayWidth(text: str): int32 =
    var width: int32 = 0
    var i: int32 = 0
    while i < strings.Len(text):
        let glyph: str = RustCsgTuiResumeNextGlyph(text, i)
        width = width + 1
        i = i + strings.Len(glyph)
    return width

fn RustCsgTuiResumePadDisplay(text: str, width: int32): str =
    let currentWidth: int32 = RustCsgTuiResumeDisplayWidth(text)
    if currentWidth >= width:
        return text
    return strings.ConcatStr(text, RustCsgTuiResumeSpaces(width - currentWidth))

fn RustCsgTuiResumeTrimTrailingSpaces(text: str): str =
    var end: int32 = strings.Len(text)
    while end > 0 && strings.SliceBytes(text, end - 1, 1) == " ":
        end = end - 1
    return strings.SliceBytes(text, 0, end)

fn RustCsgTuiResumeTruncateText(text: str, maxGraphemes: int32): str =
    if maxGraphemes <= 0:
        return ""
    if RustCsgTuiResumeDisplayWidth(text) <= maxGraphemes:
        return text
    if maxGraphemes < 3:
        var tiny: str = ""
        var tinyUsed: int32 = 0
        var tinyIndex: int32 = 0
        while tinyIndex < strings.Len(text) && tinyUsed < maxGraphemes:
            let glyph: str = RustCsgTuiResumeNextGlyph(text, tinyIndex)
            tiny = strings.ConcatStr(tiny, glyph)
            tinyUsed = tinyUsed + 1
            tinyIndex = tinyIndex + strings.Len(glyph)
        return tiny
    let keep: int32 = maxGraphemes - 3
    var out: str = ""
    var used: int32 = 0
    var i: int32 = 0
    while i < strings.Len(text) && used < keep:
        let glyph2: str = RustCsgTuiResumeNextGlyph(text, i)
        out = strings.ConcatStr(out, glyph2)
        used = used + 1
        i = i + strings.Len(glyph2)
    return strings.ConcatStr(out, "...")

fn RustCsgTuiResumeFooterProgressLabel(position: int32, total: int32, percent: int32, width: int32): str =
    let percentText: str = strings.ConcatStr(strings.IntToStr(percent), "%")
    let wide: str = strutil.Join([" ", strings.IntToStr(position), " / ", strings.IntToStr(total), " · ", percentText, " "], "")
    if RustCsgTuiResumeDisplayWidth(wide) < width:
        return wide
    let compact: str = strutil.Join([" ", strings.IntToStr(position), "/", strings.IntToStr(total), " · ", percentText, " "], "")
    if RustCsgTuiResumeDisplayWidth(compact) < width:
        return compact
    let percentOnly: str = strutil.Join([" ", percentText, " "], "")
    if RustCsgTuiResumeDisplayWidth(percentOnly) < width:
        return percentOnly
    return ""

fn RustCsgTuiResumeFooterSeparator(width: int32, position: int32, total: int32, percent: int32): str =
    let label: str = RustCsgTuiResumeFooterProgressLabel(position, total, percent, width)
    if strings.Len(label) == 0:
        return RustCsgTuiResumeRepeat("─", width)
    let prefixWidth: int32 = width - RustCsgTuiResumeDisplayWidth(label) - 1
    if prefixWidth < 0:
        return RustCsgTuiResumeRepeat("─", width)
    return strings.ConcatStr(strings.ConcatStr(RustCsgTuiResumeRepeat("─", prefixWidth), label), "─")

fn RustCsgTuiResumeFooterHintLine(key1: str, label1: str,
                                  key2: str, label2: str,
                                  key3: str, label3: str,
                                  key4: str, label4: str,
                                  key5: str, label5: str): str =
    if strings.Len(key5) == 0:
        return strutil.Join([
            " ",
            key1,
            " ",
            label1,
            "   ",
            key2,
            " ",
            label2,
            "   ",
            key3,
            " ",
            label3,
            "   ",
            key4,
            " ",
            label4
        ], "")
    return strutil.Join([
        " ",
        key1,
        " ",
        label1,
        "   ",
        key2,
        " ",
        label2,
        "   ",
        key3,
        " ",
        label3,
        "   ",
        key4,
        " ",
        label4,
        "   ",
        key5,
        " ",
        label5
    ], "")

fn RustCsgTuiResumeFooterFirstHintLine(width: int32, query: str): str =
    if width >= 120 && strings.Len(query) == 0:
        return RustCsgTuiResumeFooterHintLine("enter", "resume", "esc", "start new", "ctrl+c", "quit", "tab", "focus sort/filter", "←/→", "change option")
    var escLabel: str = "new"
    if strings.Len(query) > 0:
        escLabel = "clear"
    return RustCsgTuiResumeFooterHintLine("enter", "resume", "esc", escLabel, "ctrl+c", "quit", "tab", "focus", "←/→", "option")

fn RustCsgTuiResumeFooterSecondHintLine(width: int32, dense: bool): str =
    if width >= 120:
        var densityWide: str = "dense view"
        if dense:
            densityWide = "comfortable view"
        return RustCsgTuiResumeFooterHintLine("ctrl+o", densityWide, "ctrl+t", "transcript", "ctrl+e", "expand", "↑/↓", "browse", "", "")
    var densityCompact: str = "dense"
    if dense:
        densityCompact = "comfy"
    return RustCsgTuiResumeFooterHintLine("ctrl+o", densityCompact, "ctrl+t", "preview", "ctrl+e", "exp", "↑/↓", "browse", "", "")

fn RustCsgTuiResumeTrimTrailingEmptyHint(text: str): str =
    return RustCsgTuiResumeTrimTrailingSpaces(text)

fn RustCsgTuiResumeRenderFooterSnapshot(width: int32,
                                        listHeight: int32,
                                        position: int32,
                                        total: int32,
                                        percent: int32,
                                        query: str,
                                        dense: bool): str =
    if width <= 0 || listHeight < 0:
        assert(false, "resume footer dimensions invalid")
    let line1: str = RustCsgTuiResumeFooterSeparator(width, position, total, percent)
    let line2: str = RustCsgTuiResumeFooterFirstHintLine(width, query)
    let line3: str = RustCsgTuiResumeTrimTrailingEmptyHint(RustCsgTuiResumeFooterSecondHintLine(width, dense))
    return strings.ConcatStr(strutil.Join([line1, line2, line3], "\n"), "\n")

fn RustCsgTuiResumeDenseColumnText(text: str, width: int32): str =
    let truncated: str = RustCsgTuiResumeTruncateText(text, width - 1)
    return RustCsgTuiResumePadDisplay(truncated, width)

fn RustCsgTuiResumeRenderDenseSummaryLine(selected: bool, expanded: bool, date: str, title: str, width: int32): str =
    var marker: str = "  "
    if selected && expanded:
        marker = "⌄ "
    elif selected:
        marker = "❯ "
    let markerWidth: int32 = RustCsgTuiResumeDisplayWidth(marker)
    let available: int32 = width - markerWidth
    let dateWidth: int32 = 12
    let titleWidth: int32 = available - dateWidth
    if titleWidth <= 0:
        return RustCsgTuiResumePadDisplay(marker, width)
    let line: str = strings.ConcatStr(strings.ConcatStr(marker, RustCsgTuiResumeDenseColumnText(date, dateWidth)), RustCsgTuiResumeDenseColumnText(title, titleWidth))
    return RustCsgTuiResumeTrimTrailingSpaces(RustCsgTuiResumeTruncateText(line, width))

fn RustCsgTuiResumeRenderDenseRows(width: int32, selectedSecond: bool, firstTitle: str, secondTitle: str): str =
    let first: str = RustCsgTuiResumeRenderDenseSummaryLine(!selectedSecond, false, "15m ago", firstTitle, width)
    let second: str = RustCsgTuiResumeRenderDenseSummaryLine(selectedSecond, false, "15m ago", secondTitle, width)
    return strings.ConcatStr(strutil.Join([first, second], "\n"), "\n")

fn RustCsgTuiResumeRenderDenseSnapshotRow(width: int32): str =
    return strings.ConcatStr(RustCsgTuiResumeRenderDenseSummaryLine(true, false, "15m ago", "Propose session picker redesign with enough title text to exercise truncation", width), "\n")

fn RustCsgTuiResumeTakeDisplay(text: str, width: int32): str =
    var out: str = ""
    var used: int32 = 0
    var i: int32 = 0
    while i < strings.Len(text) && used < width:
        let glyph: str = RustCsgTuiResumeNextGlyph(text, i)
        out = strings.ConcatStr(out, glyph)
        used = used + 1
        i = i + strings.Len(glyph)
    return out

fn RustCsgTuiResumeDropDisplay(text: str, start: int32): str =
    var out: str = ""
    var skipped: int32 = 0
    var i: int32 = 0
    while i < strings.Len(text):
        let glyph: str = RustCsgTuiResumeNextGlyph(text, i)
        if skipped >= start:
            out = strings.ConcatStr(out, glyph)
        skipped = skipped + 1
        i = i + strings.Len(glyph)
    return out

fn RustCsgTuiResumeSelectionMarker(selected: bool, expanded: bool): str =
    if selected && expanded:
        return "⌄ "
    if selected:
        return "❯ "
    return "  "

fn RustCsgTuiResumeClampCwdWidth(width: int32): int32 =
    var available: int32 = width - 18
    if available < 0:
        available = 0
    var cwdWidth: int32 = available / 2
    if cwdWidth < 30:
        cwdWidth = 30
    if cwdWidth > 72:
        cwdWidth = 72
    return cwdWidth

fn RustCsgTuiResumeFooterValue(prefix: str, value: str, targetWidth: int32, availableWidth: int32): str =
    var out: str = ""
    var used: int32 = 0
    if strings.Len(prefix) > 0:
        let prefixWidth: int32 = RustCsgTuiResumeDisplayWidth(prefix)
        if availableWidth <= prefixWidth:
            return RustCsgTuiResumeTruncateText(prefix, availableWidth)
        out = strings.ConcatStr(out, prefix)
        used = used + prefixWidth
        if strings.Len(value) > 0 && used < availableWidth:
            out = strings.ConcatStr(out, " ")
            used = used + 1
    var textWidth: int32 = availableWidth - used
    if targetWidth > 0:
        let targetTextWidth: int32 = targetWidth - used
        if targetTextWidth < textWidth:
            textWidth = targetTextWidth
    if textWidth < 0:
        textWidth = 0
    let renderedText: str = RustCsgTuiResumeTruncateText(value, textWidth)
    out = strings.ConcatStr(out, renderedText)
    let renderedWidth: int32 = used + RustCsgTuiResumeDisplayWidth(renderedText)
    if targetWidth > 0 && renderedWidth < targetWidth:
        out = strings.ConcatStr(out, RustCsgTuiResumeSpaces(targetWidth - renderedWidth))
    return out

fn RustCsgTuiResumeFooterActualWidth(prefix: str, value: str): int32 =
    var width: int32 = RustCsgTuiResumeDisplayWidth(value)
    if strings.Len(prefix) > 0:
        width = width + RustCsgTuiResumeDisplayWidth(prefix)
        if strings.Len(value) > 0:
            width = width + 1
    return width

fn RustCsgTuiResumeNormalizeCwd(cwd: str): str =
    if strings.Len(cwd) == 0:
        return "no cwd"
    return cwd

fn RustCsgTuiResumeNormalizeBranch(branch: str): str =
    if strings.Len(branch) == 0:
        return "no branch"
    return branch

fn RustCsgTuiResumeRenderComfortableTitleLine(title: str, selected: bool, expanded: bool, width: int32): str =
    let marker: str = RustCsgTuiResumeSelectionMarker(selected, expanded)
    let titleText: str = RustCsgTuiResumeTruncateText(title, width - 2)
    return strings.ConcatStr(marker, titleText)

fn RustCsgTuiResumeRenderFooterLines(date: str, cwd: str, branch: str, showCwd: bool, width: int32): str =
    let branchValue: str = RustCsgTuiResumeNormalizeBranch(branch)
    if !showCwd:
        let datePart: str = RustCsgTuiResumeFooterValue("", date, 12, width - 2)
        let branchPart: str = RustCsgTuiResumeFooterValue("", branchValue, 0, width - 16)
        return strutil.Join(["  ", datePart, "  ", branchPart], "")

    let cwdValue: str = RustCsgTuiResumeNormalizeCwd(cwd)
    let cwdWidth: int32 = RustCsgTuiResumeClampCwdWidth(width)
    let branchWidth: int32 = RustCsgTuiResumeFooterActualWidth("", branchValue)
    let oneLineWidth: int32 = 2 + 12 + 2 + cwdWidth + 2 + branchWidth
    if oneLineWidth <= width:
        let datePart2: str = RustCsgTuiResumeFooterValue("", date, 12, width - 2)
        let cwdPart2: str = RustCsgTuiResumeFooterValue("⌁", cwdValue, cwdWidth, width - 16)
        let branchPart2: str = RustCsgTuiResumeFooterValue("", branchValue, 0, width - 18 - cwdWidth)
        return strutil.Join(["  ", datePart2, "  ", cwdPart2, "  ", branchPart2], "")

    let datePart3: str = RustCsgTuiResumeFooterValue("", date, 12, width - 2)
    let cwdPart3: str = RustCsgTuiResumeFooterValue("⌁", cwdValue, 0, width - 16)
    let branchPart3: str = RustCsgTuiResumeFooterValue("", branchValue, 0, width - 2)
    return strutil.Join(["  ", datePart3, "  ", cwdPart3, "\n  ", branchPart3], "")

fn RustCsgTuiResumeRenderComfortableSession(title: str,
                                            date: str,
                                            cwd: str,
                                            branch: str,
                                            showCwd: bool,
                                            selected: bool,
                                            expanded: bool,
                                            width: int32): str =
    let titleLine: str = RustCsgTuiResumeRenderComfortableTitleLine(title, selected, expanded, width)
    if expanded:
        return titleLine
    return strutil.Join([titleLine, RustCsgTuiResumeRenderFooterLines(date, cwd, branch, showCwd, width)], "\n")

fn RustCsgTuiResumeRenderSearchLine(width: int32, query: str, cwdFilter: bool, updatedSort: bool): str =
    var search: str = "Type to search"
    if strings.Len(query) > 0:
        search = strings.ConcatStr("Search: ", query)
    var filterActive: str = "[All]"
    var filterInactive: str = ""
    if cwdFilter:
        filterActive = "[Cwd]"
        filterInactive = " All "
    var sortActive: str = "[Created]"
    var sortInactive: str = " Updated "
    if updatedSort:
        sortActive = "[Updated]"
        sortInactive = " Created "
    let toolbarFull: str = strutil.Join(["Filter: ", filterActive, filterInactive, "   Sort: ", sortActive, sortInactive], "")
    let toolbarText: str = RustCsgTuiResumeTrimTrailingSpaces(toolbarFull)
    let toolbarWidth: int32 = RustCsgTuiResumeDisplayWidth(toolbarFull)
    let searchWidth: int32 = RustCsgTuiResumeDisplayWidth(search)
    var spacerWidth: int32 = width - searchWidth - toolbarWidth
    if spacerWidth < 2:
        spacerWidth = 2
    var availableSearchWidth: int32 = width - toolbarWidth - spacerWidth
    if availableSearchWidth < 0:
        availableSearchWidth = 0
    var visibleSearch: str = search
    if searchWidth > availableSearchWidth:
        visibleSearch = RustCsgTuiResumeTruncateText(search, availableSearchWidth)
    return strutil.Join([visibleSearch, RustCsgTuiResumeSpaces(spacerWidth), toolbarText], "")

fn RustCsgTuiResumeLegacyRow(selected: bool, created: str, updated: str, branch: str, cwd: str, conversation: str): str =
    var marker: str = "  "
    if selected:
        marker = "> "
    return strutil.Join([
        marker,
        RustCsgTuiResumePadDisplay(created, 9),
        RustCsgTuiResumePadDisplay(updated, 12),
        RustCsgTuiResumePadDisplay(branch, 8),
        RustCsgTuiResumePadDisplay(cwd, 5),
        conversation
    ], "")

fn RustCsgTuiResumeLegacyHeader(): str =
    return RustCsgTuiResumeLegacyRow(false, "Created", "Updated", "Branch", "CWD", "Conversation")

fn RustCsgTuiResumeLegacyScreenHeader(): str =
    return strutil.Join([
        "  ",
        RustCsgTuiResumePadDisplay("Created at", 12),
        RustCsgTuiResumePadDisplay("Updated at", 12),
        RustCsgTuiResumePadDisplay("Branch", 8),
        RustCsgTuiResumePadDisplay("CWD", 5),
        "Conversation"
    ], "")

fn RustCsgTuiResumeOverlayBlank(line: str, overlayStart: int32, overlayWidth: int32): str =
    let prefix: str = RustCsgTuiResumeTakeDisplay(line, overlayStart)
    let suffix: str = RustCsgTuiResumeDropDisplay(line, overlayStart + overlayWidth)
    return RustCsgTuiResumeTrimTrailingSpaces(strutil.Join([prefix, RustCsgTuiResumeSpaces(overlayWidth), suffix], ""))

fn RustCsgTuiResumeOverlayMessage(line: str, overlayStart: int32, overlayWidth: int32, message: str): str =
    let messageWidth: int32 = RustCsgTuiResumeDisplayWidth(message)
    var messageStart: int32 = overlayStart
    if overlayWidth > messageWidth:
        messageStart = overlayStart + ((overlayWidth - messageWidth) / 2)
    let prefix: str = RustCsgTuiResumeTakeDisplay(line, overlayStart)
    let suffix: str = RustCsgTuiResumeDropDisplay(line, messageStart + messageWidth)
    return RustCsgTuiResumeTrimTrailingSpaces(strutil.Join([
        prefix,
        RustCsgTuiResumeSpaces(messageStart - overlayStart),
        message,
        suffix
    ], ""))

fn RustCsgTuiResumeExpandedDetailLine(label: str, value: str): str =
    return strutil.Join(["  │ ", RustCsgTuiResumePadDisplay(label, 12), value], "")

fn RustCsgTuiResumeStripMarkdownEmphasis(text: str): str =
    var out: str = ""
    var i: int32 = 0
    while i < strings.Len(text):
        let glyph: str = RustCsgTuiResumeNextGlyph(text, i)
        if glyph != "*":
            out = strings.ConcatStr(out, glyph)
        i = i + strings.Len(glyph)
    return out

fn RustCsgTuiResumeRenderExpandedSession(title: str,
                                         threadId: str,
                                         createdRelative: str,
                                         createdTimestamp: str,
                                         updatedRelative: str,
                                         updatedTimestamp: str,
                                         cwd: str,
                                         branch: str,
                                         userLine: str,
                                         assistantMarkdown: str,
                                         width: int32): str =
    let titleLine: str = RustCsgTuiResumeRenderComfortableSession(title, "", "", "", true, true, true, width)
    let createdValue: str = strutil.Join([createdRelative, " · ", createdTimestamp], "")
    let updatedValue: str = strutil.Join([updatedRelative, " · ", updatedTimestamp], "")
    let branchValue: str = strings.ConcatStr(" ", branch)
    let assistantLine: str = RustCsgTuiResumeStripMarkdownEmphasis(assistantMarkdown)
    return strings.ConcatStr(strutil.Join([
        titleLine,
        RustCsgTuiResumeExpandedDetailLine("Session:", threadId),
        RustCsgTuiResumeExpandedDetailLine("Created:", createdValue),
        RustCsgTuiResumeExpandedDetailLine("Updated:", updatedValue),
        RustCsgTuiResumeExpandedDetailLine("Directory:", cwd),
        RustCsgTuiResumeExpandedDetailLine("Branch:", branchValue),
        "  │",
        "  │ Conversation:",
        strings.ConcatStr("  │ ", userLine),
        strings.ConcatStr("  └ ", assistantLine)
    ], "\n"), "\n")

fn RustCsgTuiResumeRenderSearchError(error: str): str =
    return strings.ConcatStr(error, "\n")

