    return "\n\n■ Goals need a saved session. This session is temporary.\nRun `codex` to start a saved session, or `codex resume` / `/resume` to\nreopen one.\n"

fn RustCsgTuiAppExternalAgentConfigMigrationPromptRender(projectPath: str, leadingBlankLine: bool): str =
    var out: str = ""
    if leadingBlankLine:
        out = "\n"
    out = strings.ConcatStr(out, "  > External agent config detected\n")
    out = strings.ConcatStr(out, "  We found settings from another agent that you can add to this project.\n")
    out = strings.ConcatStr(out, "  Select what to import\n")
    out = strings.ConcatStr(out, "  Home\n")
    out = strings.ConcatStr(out, "    [x] Migrate /Users/alex/.claude/settings.json into /Users/alex/.codex/con…\n")
    out = strings.ConcatStr(out, "\n")
    out = strings.ConcatStr(out, strings.ConcatStr("  Project: ", strings.ConcatStr(projectPath, "\n")))
    out = strings.ConcatStr(out, "    [x] Migrate enabled plugins from .claude/settings.json (4 marketplaces, 6…\n")
    out = strings.ConcatStr(out, "        • acme-tools: deployer, formatter, +1 more\n")
    out = strings.ConcatStr(out, "        • team-marketplace: asana\n")
    out = strings.ConcatStr(out, "        • debug: sample\n")
    out = strings.ConcatStr(out, "        • +1 more marketplaces\n")
    out = strings.ConcatStr(out, "    [x] Migrate CLAUDE.md to AGENTS.md\n")
    out = strings.ConcatStr(out, "\n")
    out = strings.ConcatStr(out, "  Selected 3 of 3 item(s).\n")
    out = strings.ConcatStr(out, RustCsgTuiAppOraclePadAscii("    1. Proceed with selected ", 78))
    out = strings.ConcatStr(out, "\n")
    out = strings.ConcatStr(out, RustCsgTuiAppOraclePadAscii("    2. Skip for now ", 78))
    out = strings.ConcatStr(out, "\n")
    out = strings.ConcatStr(out, RustCsgTuiAppOraclePadAscii("    3. Don't ask again ", 78))
    out = strings.ConcatStr(out, "\n")
    out = strings.ConcatStr(out, "  Use ↑/↓ to move, space to toggle, 1/2/3 to choose, a/n for all/none\n")
    return out

fn RustCsgTuiAppExternalAgentConfigMigrationPromptFixture(): str =
    return RustCsgTuiAppExternalAgentConfigMigrationPromptRender("/workspace/project", false)

fn RustCsgTuiAppExternalAgentConfigMigrationPromptWindowsFixture(): str =
    return RustCsgTuiAppExternalAgentConfigMigrationPromptRender("C:\\workspace\\project", true)
