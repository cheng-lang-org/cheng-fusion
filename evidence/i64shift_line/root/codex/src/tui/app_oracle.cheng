# Cheng renderer for selected TUI app oracle slices.

import std/strings

fn RustCsgTuiAppOracleSpaces(count: int32): str =
    var out: str = ""
    var i: int32 = 0
    while i < count:
        out = strings.ConcatStr(out, " ")
        i = i + 1
    return out

fn RustCsgTuiAppOracleRepeat(glyph: str, count: int32): str =
    var out: str = ""
    var i: int32 = 0
    while i < count:
        out = strings.ConcatStr(out, glyph)
        i = i + 1
    return out

fn RustCsgTuiAppOraclePadAscii(text: str, width: int32): str =
    let n: int32 = strings.Len(text)
    if n > width:
        assert(false, "app oracle line exceeds width")
    return strings.ConcatStr(text, RustCsgTuiAppOracleSpaces(width - n))

fn RustCsgTuiAppOraclePanelLine(text: str, interiorWidth: int32): str =
    return strings.ConcatStr(strings.ConcatStr("│ ", RustCsgTuiAppOraclePadAscii(text, interiorWidth - 2)), " │")

fn RustCsgTuiAppOracleAgentPickerItem(name: str, profile: str, id: str): str =
    var label: str = name
    if strings.Len(profile) > 0:
        if strings.Len(label) > 0:
            label = strings.ConcatStr(strings.ConcatStr(label, " ["), strings.ConcatStr(profile, "]"))
        else:
            label = strings.ConcatStr(strings.ConcatStr("[", profile), "]")
    if strings.Len(label) == 0:
        label = "Agent"
    return strings.ConcatStr(strings.ConcatStr(label, " | "), strings.ConcatStr(id, "\n"))

fn RustCsgTuiAppAgentPickerItemNameFixture(): str =
    let id: str = "00000000-0000-0000-0000-000000000123"
    var out: str = RustCsgTuiAppOracleAgentPickerItem("Main", "default", id)
    out = strings.ConcatStr(out, RustCsgTuiAppOracleAgentPickerItem("Robie", "explorer", id))
    out = strings.ConcatStr(out, RustCsgTuiAppOracleAgentPickerItem("Robie", "", id))
    out = strings.ConcatStr(out, RustCsgTuiAppOracleAgentPickerItem("", "explorer", id))
    out = strings.ConcatStr(out, RustCsgTuiAppOracleAgentPickerItem("", "", id))
    return out

fn RustCsgTuiAppBypassHookTrustStartupWarningRender(flag: str): str =
    var out: str = strings.ConcatStr(strings.ConcatStr("⚠ `", flag), "` is enabled. Enabled hooks may run without\n")
    out = strings.ConcatStr(out, "  review for this invocation.\n")
    return out

fn RustCsgTuiAppBypassHookTrustStartupWarningFixture(): str =
    return RustCsgTuiAppBypassHookTrustStartupWarningRender("--dangerously-bypass-hook-trust")

fn RustCsgTuiAppRenderClearUiHeader(interiorWidth: int32, model: str, status: str, directory: str): str =
    var modelLine: str = strings.ConcatStr("model:     ", model)
    if strings.Len(status) > 0:
        modelLine = strings.ConcatStr(strings.ConcatStr(modelLine, "   "), status)
    modelLine = strings.ConcatStr(modelLine, "   /model to change")
    var out: str = strings.ConcatStr(strings.ConcatStr("╭", RustCsgTuiAppOracleRepeat("─", interiorWidth)), "╮\n")
    out = strings.ConcatStr(out, RustCsgTuiAppOraclePanelLine(">_ OpenAI Codex (v<VERSION>)", interiorWidth))
    out = strings.ConcatStr(out, "\n")
    out = strings.ConcatStr(out, RustCsgTuiAppOraclePanelLine("", interiorWidth))
    out = strings.ConcatStr(out, "\n")
    out = strings.ConcatStr(out, RustCsgTuiAppOraclePanelLine(modelLine, interiorWidth))
    out = strings.ConcatStr(out, "\n")
    out = strings.ConcatStr(out, RustCsgTuiAppOraclePanelLine(strings.ConcatStr("directory: ", directory), interiorWidth))
    out = strings.ConcatStr(out, "\n")
    out = strings.ConcatStr(out, strings.ConcatStr(strings.ConcatStr("╰", RustCsgTuiAppOracleRepeat("─", interiorWidth)), "╯\n"))
    return out

fn RustCsgTuiAppClearUIFreshHeaderOnlyFixture(): str =
    return RustCsgTuiAppRenderClearUiHeader(45, "gpt-test high", "", "/tmp/project")

fn RustCsgTuiAppClearUIHeaderFastFixture(): str =
    return RustCsgTuiAppRenderClearUiHeader(52, "gpt-5.4 xhigh", "fast", "/tmp/project")

