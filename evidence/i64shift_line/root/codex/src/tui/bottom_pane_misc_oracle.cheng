# TUI bottom_pane small-view raw render_lines and Buffer Debug oracle.

import std/strings
import std/strutils as strutil

fn RustCsgTuiBottomPaneMiscSpaces(count: int32): str =
    var out: str = ""
    var i: int32 = 0
    while i < count:
        out = strings.ConcatStr(out, " ")
        i = i + 1
    return out

fn RustCsgTuiBottomPaneMiscStartsWithAt(text: str, index: int32, prefix: str): bool =
    let prefixLen: int32 = strings.Len(prefix)
    if index < 0:
        return false
    if index + prefixLen > strings.Len(text):
        return false
    return strings.SliceBytes(text, index, prefixLen) == prefix

fn RustCsgTuiBottomPaneMiscNextGlyph(text: str, index: int32): str =
    if RustCsgTuiBottomPaneMiscStartsWithAt(text, index, "›"):
        return "›"
    if RustCsgTuiBottomPaneMiscStartsWithAt(text, index, "…"):
        return "…"
    if RustCsgTuiBottomPaneMiscStartsWithAt(text, index, "←"):
        return "←"
    if RustCsgTuiBottomPaneMiscStartsWithAt(text, index, "→"):
        return "→"
    if RustCsgTuiBottomPaneMiscStartsWithAt(text, index, "↑"):
        return "↑"
    if RustCsgTuiBottomPaneMiscStartsWithAt(text, index, "↓"):
        return "↓"
    if RustCsgTuiBottomPaneMiscStartsWithAt(text, index, "·"):
        return "·"
    if RustCsgTuiBottomPaneMiscStartsWithAt(text, index, "─"):
        return "─"
    if RustCsgTuiBottomPaneMiscStartsWithAt(text, index, "⠋"):
        return "⠋"
    return strings.SliceBytes(text, index, 1)

fn RustCsgTuiBottomPaneMiscDisplayWidth(text: str): int32 =
    var width: int32 = 0
    var i: int32 = 0
    while i < strings.Len(text):
        let glyph: str = RustCsgTuiBottomPaneMiscNextGlyph(text, i)
        width = width + 1
        i = i + strings.Len(glyph)
    return width

fn RustCsgTuiBottomPaneMiscPadLine(text: str, width: int32): str =
    let currentWidth: int32 = RustCsgTuiBottomPaneMiscDisplayWidth(text)
    if currentWidth > width:
        assert(false, "bottom pane misc oracle line exceeds width")
    return strings.ConcatStr(text, RustCsgTuiBottomPaneMiscSpaces(width - currentWidth))

fn RustCsgTuiBottomPaneMiscRenderLines(width: int32, lines: str[]): str =
    var out: str = ""
    var i: int32 = 0
    while i < lines.len:
        if i + 1 == lines.len:
            out = strings.ConcatStr(out, lines[i])
        else:
            out = strings.ConcatStr(out, RustCsgTuiBottomPaneMiscPadLine(lines[i], width))
        out = strings.ConcatStr(out, "\n")
        i = i + 1
    return out

fn RustCsgTuiBottomPaneMiscStyle(x: int32, y: int32, fg: str, modifier: str): str =
    return strutil.Join([
        "        x: ",
        strings.IntToStr(x),
        ", y: ",
        strings.IntToStr(y),
        ", fg: ",
        fg,
        ", bg: Reset, underline: Reset, modifier: ",
        modifier
    ], "")

fn RustCsgTuiBottomPaneMiscBufferDebug(width: int32, height: int32, contentLines: str[], styleLines: str[]): str =
    var out: str = "Buffer {\n"
    out = strings.ConcatStr(out, strutil.Join(["    area: Rect { x: 0, y: 0, width: ", strings.IntToStr(width), ", height: ", strings.IntToStr(height), " },\n"], ""))
    out = strings.ConcatStr(out, "    content: [\n")
    var i: int32 = 0
    while i < contentLines.len:
        out = strings.ConcatStr(out, strutil.Join(["        \"", RustCsgTuiBottomPaneMiscPadLine(contentLines[i], width), "\",\n"], ""))
        i = i + 1
    out = strings.ConcatStr(out, "    ],\n")
    out = strings.ConcatStr(out, "    styles: [\n")
    i = 0
    while i < styleLines.len:
        out = strings.ConcatStr(out, styleLines[i])
        out = strings.ConcatStr(out, ",\n")
        i = i + 1
    out = strings.ConcatStr(out, "    ]\n")
    out = strings.ConcatStr(out, "}\n")
    return out

