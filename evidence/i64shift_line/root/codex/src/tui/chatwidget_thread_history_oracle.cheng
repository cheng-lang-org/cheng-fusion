# TUI chatwidget thread history snapshot oracle.

import std/strutils as strutil

fn RustCsgTuiChatwidgetThreadHistoryLines(lines: str[]): str =
    return strutil.Join([strutil.Join(lines, "\n"), "\n"], "")

fn RustCsgTuiChatwidgetForkedThreadHistoryLine(): str =
    return RustCsgTuiChatwidgetThreadHistoryLines([
        "• Thread forked from named-thread (e9f18a88-8081-4e51-9d4e-8af5cde2d8dd)",
    ])

fn RustCsgTuiChatwidgetForkedThreadHistoryLineWithoutName(): str =
    return RustCsgTuiChatwidgetThreadHistoryLines([
        "• Thread forked from 019c2d47-4935-7423-a190-05691f566092",
    ])

fn RustCsgTuiChatwidgetAppServerForkedThreadHistoryLine(): str =
    return RustCsgTuiChatwidgetThreadHistoryLines([
        "• Thread forked from app-server-parent-thread (e9f18a88-8081-4e51-9d4e-8af5cde2d8dd)",
    ])

fn RustCsgTuiChatwidgetAppServerForkedThreadHistoryLineWithoutName(): str =
    return RustCsgTuiChatwidgetThreadHistoryLines([
        "• Thread forked from 019c2d47-4935-7423-a190-05691f566092",
    ])
