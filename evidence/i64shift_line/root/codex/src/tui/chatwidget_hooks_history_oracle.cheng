# TUI chatwidget hook and unified exec snapshot oracle.

import std/strutils as strutil

fn RustCsgTuiChatwidgetHooksHistoryLines(lines: str[]): str =
    return strutil.Join([strutil.Join(lines, "\n"), "\n"], "")

fn RustCsgTuiChatwidgetUnifiedExecNonEmptyThenEmptyActive(): str =
    return RustCsgTuiChatwidgetHooksHistoryLines([
        "↳ Interacted with background terminal · just fix",
        "  └ pwd",
    ])

fn RustCsgTuiChatwidgetUnifiedExecUnknownEndWithActiveExploringCell(): str =
    return RustCsgTuiChatwidgetHooksHistoryLines([
        "History:",
        "• Ran echo repro-marker",
        "  └ repro-marker",
        "",
        "Active:",
        "• Exploring",
        "  └ Read null",
    ])

