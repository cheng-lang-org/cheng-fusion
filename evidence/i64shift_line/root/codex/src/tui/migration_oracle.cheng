# Cheng renderer for TUI model_migration + update_prompt oracle slices.

import std/strings
import std/strutils as strutil

const RustCsgTuiMigrationBackendCustom: int32 = 0
const RustCsgTuiMigrationBackendRatatui: int32 = 1

fn RustCsgTuiMigrationSpaces(count: int32): str =
    var out: str = ""
    var i: int32 = 0
    while i < count:
        out = strings.ConcatStr(out, " ")
        i = i + 1
    return out

fn RustCsgTuiMigrationStartsWithAt(text: str, index: int32, prefix: str): bool =
    let prefixLen: int32 = strings.Len(prefix)
    if index < 0:
        return false
    if index + prefixLen > strings.Len(text):
        return false
    return strings.SliceBytes(text, index, prefixLen) == prefix

fn RustCsgTuiMigrationNextGlyph(text: str, index: int32): str =
    if RustCsgTuiMigrationStartsWithAt(text, index, "›"):
        return "›"
    if RustCsgTuiMigrationStartsWithAt(text, index, "↑"):
        return "↑"
    if RustCsgTuiMigrationStartsWithAt(text, index, "↓"):
        return "↓"
    if RustCsgTuiMigrationStartsWithAt(text, index, "✨"):
        return "✨"
    if RustCsgTuiMigrationStartsWithAt(text, index, " "):
        return " "
    return strings.SliceBytes(text, index, 1)

fn RustCsgTuiMigrationGlyphWidth(glyph: str): int32 =
    if glyph == " ":
        return 0
    if glyph == "✨":
        return 2
    return 1

fn RustCsgTuiMigrationDisplayWidth(text: str): int32 =
    var width: int32 = 0
    var i: int32 = 0
    let n: int32 = strings.Len(text)
    while i < n:
        let glyph: str = RustCsgTuiMigrationNextGlyph(text, i)
        width = width + RustCsgTuiMigrationGlyphWidth(glyph)
        i = i + strings.Len(glyph)
    return width

fn RustCsgTuiMigrationPadToColumns(text: str, width: int32): str =
    let currentWidth: int32 = RustCsgTuiMigrationDisplayWidth(text)
    if currentWidth > width:
        assert(false, "migration oracle line exceeds width")
    if currentWidth == width:
        return text
    return strings.ConcatStr(text, RustCsgTuiMigrationSpaces(width - currentWidth))

fn RustCsgTuiMigrationWords(text: str): str[] =
    var words: str[]
    var current: str = ""
    var i: int32 = 0
    let n: int32 = strings.Len(text)
    while i < n:
        let glyph: str = RustCsgTuiMigrationNextGlyph(text, i)
        if glyph == " ":
            if strings.Len(current) > 0:
                add(words, current)
                current = ""
        else:
            current = strings.ConcatStr(current, glyph)
        i = i + strings.Len(glyph)
    if strings.Len(current) > 0:
        add(words, current)
    return words

fn RustCsgTuiMigrationWrapText(text: str, width: int32, left: int32): str[] =
    if width <= left:
        assert(false, "migration oracle wrap width too small")
    let contentWidth: int32 = width - left
    let words: str[] = RustCsgTuiMigrationWords(text)
    var lines: str[]
    var line: str = ""
    var i: int32 = 0
    while i < words.len:
        let word: str = words[i]
        if strings.Len(line) == 0:
            if RustCsgTuiMigrationDisplayWidth(word) > contentWidth:
                assert(false, "migration oracle word exceeds width")
            line = word
        else:
            let candidate: str = strings.ConcatStr(strings.ConcatStr(line, " "), word)
            if RustCsgTuiMigrationDisplayWidth(candidate) <= contentWidth:
                line = candidate
            else:
                add(lines, strings.ConcatStr(RustCsgTuiMigrationSpaces(left), line))
                line = word
        i = i + 1
    if strings.Len(line) > 0:
        add(lines, strings.ConcatStr(RustCsgTuiMigrationSpaces(left), line))
    return lines

fn RustCsgTuiMigrationAppendLines(out: str, lines: str[]): str =
    var result: str = out
    var i: int32 = 0
    while i < lines.len:
        result = strings.ConcatStr(result, lines[i])
        result = strings.ConcatStr(result, "\n")
        i = i + 1
    return result

fn RustCsgTuiMigrationSelectionRow(index: int32,
                                  label: str,
                                  selected: bool,
                                  width: int32,
                                  padSelected: bool): str =
    var prefix: str = "  "
    if selected:
        prefix = "› "
    let row: str = strings.ConcatStr(strings.ConcatStr(strings.ConcatStr(prefix, strings.IntToStr(index)), ". "), label)
    if selected && padSelected:
        return RustCsgTuiMigrationPadToColumns(row, width)
    if RustCsgTuiMigrationDisplayWidth(row) > width:
        assert(false, "migration oracle selection row exceeds width")
    return row

fn RustCsgTuiRenderModelMigration(currentModel: str,
                                  targetModel: str,
                                  targetDisplayName: str,
                                  targetDescription: str,
                                  modelLink: str,
                                  migrationCopy: str,
                                  canOptOut: bool,
                                  width: int32,
                                  backend: int32): str =
    if backend != RustCsgTuiMigrationBackendCustom:
        assert(false, "model migration snapshots use custom terminal backend")
    var out: str = "\n"
    out = strings.ConcatStr(out, strings.ConcatStr(strings.ConcatStr("> Codex just got an upgrade. Introducing ", targetDisplayName), ".\n"))
    out = strings.ConcatStr(out, "\n")
    if strings.Len(migrationCopy) > 0:
        out = RustCsgTuiMigrationAppendLines(out, RustCsgTuiMigrationWrapText(migrationCopy, width, 2))
    else:
        let recommendation: str = strings.ConcatStr(strings.ConcatStr(strings.ConcatStr("We recommend switching from ", currentModel), " to "), strings.ConcatStr(targetModel, "."))
        out = RustCsgTuiMigrationAppendLines(out, RustCsgTuiMigrationWrapText(recommendation, width, 2))
    out = strings.ConcatStr(out, "\n")

    if strings.Len(targetDescription) > 0:
        var description: str = targetDescription
        if strings.Len(modelLink) > 0:
            description = strings.ConcatStr(strings.ConcatStr(strings.ConcatStr(description, " Learn more about "), targetDisplayName), strings.ConcatStr(" at ", modelLink))
        out = RustCsgTuiMigrationAppendLines(out, RustCsgTuiMigrationWrapText(description, width, 2))
        out = strings.ConcatStr(out, "\n")

    if canOptOut:
        let optOut: str = strings.ConcatStr(strings.ConcatStr("You can continue using ", currentModel), " if you prefer.")
        out = RustCsgTuiMigrationAppendLines(out, RustCsgTuiMigrationWrapText(optOut, width, 2))
        out = strings.ConcatStr(out, "\n")
        out = strings.ConcatStr(out, "  Choose how you'd like Codex to proceed.\n")
        out = strings.ConcatStr(out, "\n")
        out = strings.ConcatStr(out, RustCsgTuiMigrationSelectionRow(1, "Try new model", true, width, false))
        out = strings.ConcatStr(out, "\n")
        out = strings.ConcatStr(out, RustCsgTuiMigrationSelectionRow(2, "Use existing model", false, width, false))
        out = strings.ConcatStr(out, "\n")
        out = strings.ConcatStr(out, "\n")
        out = strings.ConcatStr(out, "  Use ↑/↓ to move, press enter to confirm\n")
    else:
        out = strings.ConcatStr(out, "  Press enter to continue\n")
    return out

fn RustCsgTuiRenderUpdatePrompt(currentVersion: str,
                                latestVersion: str,
                                updateCommand: str,
                                width: int32,
                                backend: int32): str =
    if backend != RustCsgTuiMigrationBackendRatatui:
        assert(false, "update prompt snapshots use ratatui backend")
    var out: str = strings.ConcatStr(strings.ConcatStr(strings.ConcatStr("  ✨ Update available! ", currentVersion), " -> "), strings.ConcatStr(latestVersion, "\n"))
    out = strings.ConcatStr(out, "\n")
    out = strings.ConcatStr(out, "  Release notes: https://github.com/openai/codex/releases/latest\n")
    out = strings.ConcatStr(out, "\n")
    let updateLabel: str = strings.ConcatStr(strings.ConcatStr("Update now (runs `", updateCommand), "`)")
    out = strings.ConcatStr(out, RustCsgTuiMigrationSelectionRow(1, updateLabel, true, width, true))
    out = strings.ConcatStr(out, "\n")
    out = strings.ConcatStr(out, RustCsgTuiMigrationSelectionRow(2, "Skip", false, width, true))
    out = strings.ConcatStr(out, "\n")
    out = strings.ConcatStr(out, RustCsgTuiMigrationSelectionRow(3, "Skip until next version", false, width, true))
    out = strings.ConcatStr(out, "\n")
    out = strings.ConcatStr(out, "\n")
    out = strings.ConcatStr(out, "  Press enter to continue\n")
    return out

fn RustCsgTuiModelMigrationPromptFixture(): str =
    return RustCsgTuiRenderModelMigration("gpt-5.1-codex-mini",
        "gpt-5.1-codex-max",
        "gpt-5.1-codex-max",
        "",
        "",
        "Upgrade to gpt-5.2-codex for the latest and greatest agentic coding model.",
        true,
        60,
        RustCsgTuiMigrationBackendCustom)

