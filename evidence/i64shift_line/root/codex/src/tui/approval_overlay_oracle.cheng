# TUI bottom_pane/approval_overlay raw and Buffer Debug oracle renderer.

import std/strings
import std/strutils as strutil

fn RustCsgTuiApprovalSpaces(count: int32): str =
    var out: str = ""
    var i: int32 = 0
    while i < count:
        out = strings.ConcatStr(out, " ")
        i = i + 1
    return out

fn RustCsgTuiApprovalStartsWithAt(text: str, index: int32, prefix: str): bool =
    let prefixLen: int32 = strings.Len(prefix)
    if index < 0:
        return false
    if index + prefixLen > strings.Len(text):
        return false
    return strings.SliceBytes(text, index, prefixLen) == prefix

fn RustCsgTuiApprovalNextGlyph(text: str, index: int32): str =
    if RustCsgTuiApprovalStartsWithAt(text, index, "›"):
        return "›"
    return strings.SliceBytes(text, index, 1)

fn RustCsgTuiApprovalDisplayWidth(text: str): int32 =
    var width: int32 = 0
    var i: int32 = 0
    while i < strings.Len(text):
        let glyph: str = RustCsgTuiApprovalNextGlyph(text, i)
        width = width + 1
        i = i + strings.Len(glyph)
    return width

fn RustCsgTuiApprovalPadDisplay(text: str, width: int32): str =
    let currentWidth: int32 = RustCsgTuiApprovalDisplayWidth(text)
    if currentWidth > width:
        assert(false, "approval overlay oracle line exceeds width")
    return strings.ConcatStr(text, RustCsgTuiApprovalSpaces(width - currentWidth))

fn RustCsgTuiApprovalStyle(x: int32, y: int32, fg: str, modifier: str): str =
    return strutil.Join([
        "        x: ",
        strings.IntToStr(x),
        ", y: ",
        strings.IntToStr(y),
        ", fg: ",
        fg,
        ", bg: Reset, underline: Reset, modifier: ",
        modifier
    ], "")

fn RustCsgTuiApprovalBufferDebug(width: int32, height: int32, contentLines: str[], styleLines: str[]): str =
    var out: str = "Buffer {\n"
    out = strings.ConcatStr(out, strutil.Join(["    area: Rect { x: 0, y: 0, width: ", strings.IntToStr(width), ", height: ", strings.IntToStr(height), " },\n"], ""))
    out = strings.ConcatStr(out, "    content: [\n")
    var i: int32 = 0
    while i < contentLines.len:
        out = strings.ConcatStr(out, strutil.Join(["        \"", RustCsgTuiApprovalPadDisplay(contentLines[i], width), "\",\n"], ""))
        i = i + 1
    out = strings.ConcatStr(out, "    ],\n")
    out = strings.ConcatStr(out, "    styles: [\n")
    i = 0
    while i < styleLines.len:
        out = strings.ConcatStr(out, styleLines[i])
        out = strings.ConcatStr(out, ",\n")
        i = i + 1
    out = strings.ConcatStr(out, "    ]\n")
    out = strings.ConcatStr(out, "}\n")
    return out

fn RustCsgTuiApprovalAdditionalPermissionsPromptSnapshot(): str =
    return strutil.Join([
        "",
        "  Would you like to run the following command?",
        "",
        "  Reason: need filesystem access",
        "",
        "  Permission rule: network; read `/tmp/readme.txt`; write `/tmp/out.txt`",
        "",
        "  $ cat /tmp/readme.txt",
        "",
        "› 1. Yes, proceed (y)",
        "  2. No, and tell Codex what to do differently (esc)",
        "",
        "  Press enter to confirm or esc to cancel",
        "",
    ], "\n")

fn RustCsgTuiApprovalCrossThreadPromptSnapshot(): str =
    return strutil.Join([
        "",
        "  Would you like to run the following command?",
        "",
        "  Thread: Robie [explorer]",
        "",
        "  $ echo hi",
        "",
        "› 1. Yes, proceed (y)",
        "  2. No, and tell Codex what to do differently (esc)",
        "",
        "  Press enter to confirm or esc to cancel or o to open thread",
        "",
    ], "\n")

fn RustCsgTuiApprovalPermissionsPromptSnapshot(): str =
    return strutil.Join([
        "",
        "  Would you like to grant these permissions?",
        "",
        "  Reason: need workspace access",
        "",
        "  Permission rule: network; read `/tmp/readme.txt`; write `/tmp/out.txt`",
        "",
        "› 1. Yes, grant these permissions (y)",
        "  2. Yes, grant these permissions for this session (a)",
        "  3. No, continue without permissions (n)",
        "",
        "  Press enter to confirm or esc to cancel",
        "",
    ], "\n")

fn RustCsgTuiApprovalNetworkExecPromptSnapshot(): str =
    return RustCsgTuiApprovalBufferDebug(100, 12, [
        "",
        "  Do you want to approve network access to \"example.com\"?",
        "",
        "  Reason: network request blocked",
        "",
        "",
        "› 1. Yes, just this once (y)",
        "  2. Yes, and allow this host for this conversation (a)",
        "  3. Yes, and allow this host in the future (p)",
        "  4. No, and tell Codex what to do differently (esc)",
        "",
        "  Press enter to confirm or esc to cancel"
    ], [
        RustCsgTuiApprovalStyle(0, 0, "Reset", "NONE"),
        RustCsgTuiApprovalStyle(2, 1, "Reset", "BOLD"),
        RustCsgTuiApprovalStyle(57, 1, "Reset", "NONE"),
        RustCsgTuiApprovalStyle(10, 3, "Reset", "ITALIC"),
        RustCsgTuiApprovalStyle(33, 3, "Reset", "NONE"),
        RustCsgTuiApprovalStyle(0, 6, "Cyan", "BOLD"),
        RustCsgTuiApprovalStyle(28, 6, "Reset", "NONE"),
        RustCsgTuiApprovalStyle(53, 7, "Reset", "DIM"),
        RustCsgTuiApprovalStyle(54, 7, "Reset", "NONE"),
        RustCsgTuiApprovalStyle(45, 8, "Reset", "DIM"),
        RustCsgTuiApprovalStyle(46, 8, "Reset", "NONE"),
        RustCsgTuiApprovalStyle(48, 9, "Reset", "DIM"),
        RustCsgTuiApprovalStyle(51, 9, "Reset", "NONE"),
        RustCsgTuiApprovalStyle(2, 11, "Reset", "DIM")
    ])
