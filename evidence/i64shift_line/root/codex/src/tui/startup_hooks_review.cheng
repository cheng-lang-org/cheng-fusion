# TUI startup hooks review renderer.
#
# Mirrors the Rust selection_view render slices from
# codex-rs/tui/src/startup_hooks_review.rs for byte-exact snapshot checks.

import std/strings

fn RustCsgTuiStartupHooksReviewSpaces(count: int32): str =
    var out: str = ""
    var i: int32 = 0
    while i < count:
        out = strings.ConcatStr(out, " ")
        i = i + 1
    return out

fn RustCsgTuiStartupHooksReviewStartsWithAt(text: str, index: int32, prefix: str): bool =
    let prefixLen: int32 = strings.Len(prefix)
    if index < 0:
        return false
    if index + prefixLen > strings.Len(text):
        return false
    return strings.SliceBytes(text, index, prefixLen) == prefix

fn RustCsgTuiStartupHooksReviewNextGlyph(text: str, index: int32): str =
    if RustCsgTuiStartupHooksReviewStartsWithAt(text, index, "›"):
        return "›"
    return strings.SliceBytes(text, index, 1)

fn RustCsgTuiStartupHooksReviewDisplayWidth(text: str): int32 =
    var width: int32 = 0
    var i: int32 = 0
    let n: int32 = strings.Len(text)
    while i < n:
        let glyph: str = RustCsgTuiStartupHooksReviewNextGlyph(text, i)
        width = width + 1
        i = i + strings.Len(glyph)
    return width

fn RustCsgTuiStartupHooksReviewTruncate(text: str, width: int32): str =
    if width <= 0:
        return ""
    var out: str = ""
    var used: int32 = 0
    var i: int32 = 0
    let n: int32 = strings.Len(text)
    while i < n && used < width:
        let glyph: str = RustCsgTuiStartupHooksReviewNextGlyph(text, i)
        out = strings.ConcatStr(out, glyph)
        used = used + 1
        i = i + strings.Len(glyph)
    return out

fn RustCsgTuiStartupHooksReviewPad(text: str, width: int32): str =
    var line: str = text
    if RustCsgTuiStartupHooksReviewDisplayWidth(line) > width:
        line = RustCsgTuiStartupHooksReviewTruncate(line, width)
    let displayWidth: int32 = RustCsgTuiStartupHooksReviewDisplayWidth(line)
    if displayWidth < width:
        line = strings.ConcatStr(line, RustCsgTuiStartupHooksReviewSpaces(width - displayWidth))
    return line

fn RustCsgTuiStartupHooksReviewCountLine(reviewNeededCount: int32): str =
    if reviewNeededCount == 1:
        return "1 hook is new or changed."
    return strings.ConcatStr(strings.IntToStr(reviewNeededCount), " hooks are new or changed.")

fn RustCsgTuiStartupHooksReviewRender(width: int32,
                                      reviewNeededCount: int32,
                                      trustAllError: str,
                                      trustingAll: bool): str =
    if width <= 0:
        assert(false, "startup hooks review width must be positive")
    var rows: str[]
    add(rows, "")
    add(rows, "  Hooks need review")
    add(rows, strings.ConcatStr("  ", RustCsgTuiStartupHooksReviewCountLine(reviewNeededCount)))
    add(rows, "  Hooks can run outside the sandbox after you trust them.")
    if strings.Len(trustAllError) > 0:
        add(rows, strings.ConcatStr("  ", trustAllError))
    elif trustingAll:
        add(rows, "  Trusting hooks...")
    add(rows, "")
    add(rows, "› 1. Review hooks")
    add(rows, "  2. Trust all and continue")
    add(rows, "  3. Continue without trusting (hooks won't run)")
    add(rows, "")
    add(rows, "  Press enter to confirm or esc to go back")

    var out: str = ""
    var i: int32 = 0
    while i < rows.len:
        if i == rows.len - 1:
            out = strings.ConcatStr(out, RustCsgTuiStartupHooksReviewTruncate(rows[i], width))
        else:
            out = strings.ConcatStr(out, RustCsgTuiStartupHooksReviewPad(rows[i], width))
        out = strings.ConcatStr(out, "\n")
        i = i + 1
    return out

fn RustCsgTuiStartupHooksReviewPromptSnapshot(): str =
    return RustCsgTuiStartupHooksReviewRender(80, 2, "", false)

fn RustCsgTuiStartupHooksReviewPromptTrustErrorSnapshot(): str =
    return RustCsgTuiStartupHooksReviewRender(80, 2, "Failed to trust hooks: disk full", false)
