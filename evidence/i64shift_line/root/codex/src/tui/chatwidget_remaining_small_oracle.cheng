fn RustCsgTuiChatwidgetStatusWidgetAndApprovalModal(): str =
    return strutil.Join([
        RustCsgTuiChatwidgetRemainingSmallQuotedRow("", 100),
        RustCsgTuiChatwidgetRemainingSmallQuotedRow("", 100),
        RustCsgTuiChatwidgetRemainingSmallQuotedRow("  Would you like to run the following command?", 54),
        RustCsgTuiChatwidgetRemainingSmallQuotedRow("", 100),
        RustCsgTuiChatwidgetRemainingSmallQuotedRow("  Reason: this is a test reason such as one that would be produced by the model", 21),
        RustCsgTuiChatwidgetRemainingSmallQuotedRow("", 100),
        RustCsgTuiChatwidgetRemainingSmallQuotedRow("  $ echo 'hello world'", 78),
        RustCsgTuiChatwidgetRemainingSmallQuotedRow("", 100),
        RustCsgTuiChatwidgetRemainingSmallQuotedRow("› 1. Yes, proceed (y)", 79),
        RustCsgTuiChatwidgetRemainingSmallQuotedRow("  2. Yes, and don't ask again for commands that start with `echo 'hello world'` (p)", 17),
        RustCsgTuiChatwidgetRemainingSmallQuotedRow("  3. No, and tell Codex what to do differently (esc)", 48),
        RustCsgTuiChatwidgetRemainingSmallQuotedRow("", 100),
        RustCsgTuiChatwidgetRemainingSmallQuotedRow("  Press enter to confirm or esc to cancel", 59),
    ], "")

