# TUI chatwidget small remaining snapshot oracle.

import std/strings
import std/strutils as strutil

fn RustCsgTuiChatwidgetRemainingSmallLines(lines: str[]): str =
    return strutil.Join([strutil.Join(lines, "\n"), "\n"], "")

fn RustCsgTuiChatwidgetRemainingSmallSpaces(count: int32): str =
    var out: str = ""
    var i: int32 = 0
    while i < count:
        out = strings.ConcatStr(out, " ")
        i = i + 1
    return out

fn RustCsgTuiChatwidgetRemainingSmallNewlines(count: int32): str =
    var out: str = ""
    var i: int32 = 0
    while i < count:
        out = strings.ConcatStr(out, "\n")
        i = i + 1
    return out

fn RustCsgTuiChatwidgetRemainingSmallQuotedRow(text: str, trailingSpaces: int32): str =
    return strutil.Join(["\"", text, RustCsgTuiChatwidgetRemainingSmallSpaces(trailingSpaces), "\"\n"], "")

fn RustCsgTuiChatwidgetExecApprovalHistoryApprovedShort(): str =
    return RustCsgTuiChatwidgetRemainingSmallLines([
        "✔ You approved codex to run echo hello world this time",
    ])

fn RustCsgTuiChatwidgetExecApprovalHistoryAbortedLong(): str =
    return RustCsgTuiChatwidgetRemainingSmallLines([
        "✗ You canceled the request to run echo",
        "  aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa...",
    ])

fn RustCsgTuiChatwidgetExecApprovalHistoryAbortedMultiline(): str =
    return RustCsgTuiChatwidgetRemainingSmallLines([
        "✗ You canceled the request to run echo line1 ...",
    ])

fn RustCsgTuiChatwidgetReviewSubmissionWarning(): str =
    return RustCsgTuiChatwidgetRemainingSmallLines([
        "⚠ Steer messages aren't supported during /review. Send your message after the",
        "  review finishes, or press Ctrl+C now to cancel the review.",
        "",
    ])

fn RustCsgTuiChatwidgetRenamedThreadFooterTitle(): str =
    return strutil.Join([
        RustCsgTuiChatwidgetRemainingSmallQuotedRow("", 80),
        RustCsgTuiChatwidgetRemainingSmallQuotedRow("", 80),
        RustCsgTuiChatwidgetRemainingSmallQuotedRow("› Ask Codex to do anything", 54),
        RustCsgTuiChatwidgetRemainingSmallQuotedRow("", 80),
        RustCsgTuiChatwidgetRemainingSmallQuotedRow("  gpt-5.3-codex high · Roadmap cleanup", 42),
    ], "")

