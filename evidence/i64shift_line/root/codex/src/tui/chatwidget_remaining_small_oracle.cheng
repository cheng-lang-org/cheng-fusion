            "    Read diff_render.rs",
            "",
            "• Investigating rendering code (0s • esc to interrupt)",
            "",
            "",
            "› Summarize recent commits",
            "",
        ]),
        "  tab to queue message",
        RustCsgTuiChatwidgetRemainingSmallSpaces(39),
        "100% context left\n",
    ], "")

fn RustCsgTuiChatwidgetMarkdownCodeBlocksVt100(): str =
    return strutil.Join([
        RustCsgTuiChatwidgetRemainingSmallNewlines(35),
        RustCsgTuiChatwidgetRemainingSmallLines([
            "•     -- Indented code block (4 spaces)",
            "      SELECT *",
            "      FROM \"users\"",
            "      WHERE \"email\" LIKE '%@example.com';",
            "",
            "  ```sh",
            "  printf 'fenced within fenced\\n'",
            "  ```",
            "",
            "  {",
            "    // comment allowed in jsonc",
            "    \"path\": \"C:\\\\Program Files\\\\App\",",
            "    \"regex\": \"^foo.*(bar)?$\"",
            "  }",
        ]),
    ], "")
