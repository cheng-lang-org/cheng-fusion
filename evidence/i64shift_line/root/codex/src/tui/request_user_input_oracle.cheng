    return RustCsgTuiRequestInputSurface(52, [
        "",
        RustCsgTuiRequestInputProgress(1, 2, 2),
        "  Choose an option.",
        "",
        RustCsgTuiRequestInputOption(false, 1, "Option 1", "First choice.", 11),
        RustCsgTuiRequestInputOption(true, 2, "Option 2", "Second choice.", 11),
        RustCsgTuiRequestInputOption(false, 3, "Option 3", "Third choice.", 11),
        "",
        "  tab to add notes | enter to submit answer",
        "  ←/→ to navigate questions | esc to interrupt"
    ])

