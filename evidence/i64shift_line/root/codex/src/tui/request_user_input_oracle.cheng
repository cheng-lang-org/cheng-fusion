# TUI bottom_pane/request_user_input oracle renderer.

import std/strings
import std/strutils as strutil

fn RustCsgTuiRequestInputSpaces(count: int32): str =
    var out: str = ""
    var i: int32 = 0
    while i < count:
        out = strings.ConcatStr(out, " ")
        i = i + 1
    return out

fn RustCsgTuiRequestInputStartsWithAt(text: str, index: int32, prefix: str): bool =
    let prefixLen: int32 = strings.Len(prefix)
    if index < 0:
        return false
    if index + prefixLen > strings.Len(text):
        return false
    return strings.SliceBytes(text, index, prefixLen) == prefix

fn RustCsgTuiRequestInputNextGlyph(text: str, index: int32): str =
    if RustCsgTuiRequestInputStartsWithAt(text, index, "›"):
        return "›"
    if RustCsgTuiRequestInputStartsWithAt(text, index, "←"):
        return "←"
    if RustCsgTuiRequestInputStartsWithAt(text, index, "→"):
        return "→"
    return strings.SliceBytes(text, index, 1)

fn RustCsgTuiRequestInputDisplayWidth(text: str): int32 =
    var width: int32 = 0
    var i: int32 = 0
    while i < strings.Len(text):
        let glyph: str = RustCsgTuiRequestInputNextGlyph(text, i)
        width = width + 1
        i = i + strings.Len(glyph)
    return width

fn RustCsgTuiRequestInputPadDisplay(text: str, width: int32): str =
    let currentWidth: int32 = RustCsgTuiRequestInputDisplayWidth(text)
    if currentWidth > width:
        assert(false, "request_user_input line exceeds width")
    return strings.ConcatStr(text, RustCsgTuiRequestInputSpaces(width - currentWidth))

fn RustCsgTuiRequestInputSurface(width: int32, lines: str[]): str =
    var padded: str[]
    var i: int32 = 0
    while i < lines.len:
        if i == lines.len - 1:
            add(padded, lines[i])
        else:
            add(padded, RustCsgTuiRequestInputPadDisplay(lines[i], width))
        i = i + 1
    return strings.ConcatStr(strutil.Join(padded, "\n"), "\n")

fn RustCsgTuiRequestInputProgress(current: int32, total: int32, unanswered: int32): str =
    return strutil.Join(["  Question ",
                         strings.IntToStr(current),
                         "/",
                         strings.IntToStr(total),
                         " (",
                         strings.IntToStr(unanswered),
                         " unanswered)"], "")

fn RustCsgTuiRequestInputOption(selected: bool,
                                number: int32,
                                label: str,
                                description: str,
                                labelWidth: int32): str =
    var prefix: str = "  "
    if selected:
        prefix = "› "
    let numberLabel: str = strutil.Join([strings.IntToStr(number), ". ", label], "")
    let paddedLabel: str = RustCsgTuiRequestInputPadDisplay(numberLabel, labelWidth)
    return strutil.Join(["  ", prefix, paddedLabel, "  ", description], "")

fn RustCsgTuiRequestInputRenderStandard(width: int32,
                                        current: int32,
                                        total: int32,
                                        unanswered: int32,
                                        question: str,
                                        selected: int32,
                                        footer: str): str =
    return RustCsgTuiRequestInputSurface(width, [
        "",
        RustCsgTuiRequestInputProgress(current, total, unanswered),
        strutil.Join(["  ", question], ""),
        "",
        RustCsgTuiRequestInputOption(selected == 1, 1, "Option 1", "First choice.", 11),
        RustCsgTuiRequestInputOption(selected == 2, 2, "Option 2", "Second choice.", 11),
        RustCsgTuiRequestInputOption(selected == 3, 3, "Option 3", "Third choice.", 11),
        "",
        strutil.Join(["  ", footer], "")
    ])

fn RustCsgTuiRequestInputOptionsSnapshot(): str =
    return RustCsgTuiRequestInputRenderStandard(120, 1, 1, 1, "Choose an option.", 1, "tab to add notes | enter to submit answer | esc to interrupt")

fn RustCsgTuiRequestInputTightHeightSnapshot(): str =
    return RustCsgTuiRequestInputOptionsSnapshot()

fn RustCsgTuiRequestInputMultiQuestionFirstSnapshot(): str =
    return RustCsgTuiRequestInputRenderStandard(120, 1, 2, 2, "Choose an option.", 1, "tab to add notes | enter to submit answer | ←/→ to navigate questions | esc to interrupt")

