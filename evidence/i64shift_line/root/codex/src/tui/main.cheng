# codex TUI -- terminal UI for browsing threads
#
# Shows a thread list from SQLite state DB, with color-coding by source
# and relative timestamps.  Falls back to demo data when no DB path given.
#
# Usage: ./tui [state_db_path]

import std/strings
import std/strutils as strutil
import std/cmdline
import std/times
import cheng/codex/tui/terminal as term
import cheng/codex/tui/render as render
import cheng/codex/state/state_db_sqlite as db

@abi_internal
@importc("RustCsgGetEnv")
fn RustCsgGetEnv(name: str): str

# -- Helpers -----------------------------------------------------------------

fn parsePositiveInt64(text: str, out: var int64): bool =
    if text.len == 0:
        return false
    var value: int64
    var i: int32
    while i < text.len:
        let ch = Int32(text[i])
        if ch < Int32('0') || ch > Int32('9'):
            return false
        value = value * int64(10) + int64(ch - Int32('0'))
        i = i + 1
    out = value
    return true

fn tuiNowMs(): int64 =
    let fixed = RustCsgGetEnv("RUST_CSG_TUI_FIXED_NOW_MS")
    if fixed != "":
        var parsed: int64
        if !parsePositiveInt64(fixed, parsed):
            assert(false, "RUST_CSG_TUI_FIXED_NOW_MS must be a positive millisecond timestamp")
        return parsed
    return times.epochTimeMs()

fn padRight(text: str, width: int32): str =
    let textLen: int32 = strings.Len(text)
    if textLen >= width:
        return strings.SliceBytes(text, 0, width)
    let padding: int32 = width - textLen
    var result: str = text
    var i: int32 = 0
    while i < padding:
        result = strutil.Join([result, " "], "")
        i = i + 1
    return result

fn relativeTimeStr(updatedAtMs: int64): str =
    let nowMs: int64 = tuiNowMs()
    let diffMs: int64 = nowMs - updatedAtMs
    if diffMs < 0:
        return "now"
    let diffSecs64: int64 = diffMs / 1000
    if diffSecs64 > 2147483647:
        let days64: int64 = diffSecs64 / 86400
        if days64 < 365:
            return strutil.Join([strings.IntToStr(Int32(days64)), "d"], "")
        let years64: int64 = days64 / 365
        return strutil.Join([strings.IntToStr(Int32(years64)), "y"], "")
    let diffSecs: int32 = Int32(diffSecs64)
    if diffSecs < 60:
        return strutil.Join([strings.IntToStr(diffSecs), "s"], "")
    let mins: int32 = diffSecs / 60
    if mins < 60:
        return strutil.Join([strings.IntToStr(mins), "m"], "")
    let hours: int32 = mins / 60
    if hours < 24:
        return strutil.Join([strings.IntToStr(hours), "h"], "")
    let days: int32 = hours / 24
    return strutil.Join([strings.IntToStr(days), "d"], "")

fn sourceRgb(source: str, r: var int32, g: var int32, b: var int32) =
    if source == "cli":
        r = 60; g = 140; b = 255
        return
    if source == "vscode":
        r = 80; g = 200; b = 80
        return
    if source == "exec":
        r = 220; g = 200; b = 50
        return
    r = 200; g = 200; b = 200

# -- Rendering (buffered via TuiBuffer) ---------------------------------------

fn renderHeader(buf: var render.RustCsgTuiBuffer, cols: int32) =
    let padded: str = padRight(" codex TUI ", cols)
    render.RustCsgTuiBufferWriteReverse(buf, 0, 0, padded)

fn renderThreadList(
    buf: var render.RustCsgTuiBuffer,
    ids: str[], titles: str[], sources: str[], relTimes: str[],
    selected: int32, listTopY: int32, listHeight: int32, cols: int32,
    topRow: int32
) =
    let count: int32 = ids.len
    let titleMax: int32 = cols - 9
    var y: int32 = listTopY
    var i: int32 = topRow
    while i < count && y - listTopY < listHeight:
        let bullet: str = (i == selected) ? ">" : " "
        var displayTitle: str = titles[i]
        let titleLen: int32 = strings.Len(titles[i])
        if titleLen > titleMax:
            displayTitle = strutil.Join([
                strings.SliceBytes(titles[i], 0, titleMax - 1), "~"
            ], "")
        let paddedTitle: str = padRight(displayTitle, titleMax)
        let lineText: str = strutil.Join([
            bullet, " ", paddedTitle, " ", relTimes[i]
        ], "")

        var fgR: int32 = 200
        var fgG: int32 = 200
        var fgB: int32 = 200
        sourceRgb(sources[i], fgR, fgG, fgB)

        if i == selected:
            render.RustCsgTuiBufferWriteReverse(buf, 0, y, padRight(lineText, cols))
        else:
            render.RustCsgTuiBufferWrite(buf, 0, y, padRight(lineText, cols),
                fgR, fgG, fgB, -1, -1, -1, render.RustCsgTuiAttrNone)
        y = y + 1
        i = i + 1

fn renderStatusBar(buf: var render.RustCsgTuiBuffer, cols: int32, threadCount: int32, topRow: int32, listHeight: int32) =
    let scroll: str = render.RustCsgTuiScrollIndicator(threadCount, listHeight, topRow)
    var threadCountText: str = "0"
    if threadCount > 0:
        threadCountText = strings.IntToStr(threadCount)
    let info: str = strutil.Join([
        " j/k: navigate | q: quit | threads: ",
        threadCountText,
        " | ",
        scroll
    ], "")
    let bufY: int32 = buf.height - 1
    render.RustCsgTuiBufferWriteReverse(buf, 0, bufY, padRight(info, cols))

# -- Main --------------------------------------------------------------------

fn main(): int32 =
    # ---- Init terminal --------------------------------------------------
    term.TerminalInit()

    var termRows: int32 = 24
    var termCols: int32 = 80
    let _sizeOk: bool = term.TerminalGetSize(termRows, termCols)
    _sizeOk

    if termRows < 5:
        termRows = 24
    if termCols < 20:
        termCols = 80

    # ---- Read thread data ----------------------------------------------
    var ids: str[]
    var titles: str[]
    var sources: str[]
    var relTimes: str[]
    ids = []
    titles = []
    sources = []
    relTimes = []

    let argCount: int32 = cmdline.argCount()
    var usingDemo: bool = true

    if argCount > 1:
        let dbPath: str = cmdline.argStr(1)
        if strings.Len(dbPath) > 0:
            let pageResult = db.RustCsgStateDbVisiblePageRowsFilteredDynamicWithCwd(
                dbPath,
                "updated_at",
                "desc",
                false,
                "",
                "",
                "",
                "",
                "",
                100
            )
            if pageResult.ok:
                let rowCount: int32 = pageResult.rows.len
                var i: int32 = 0
                while i < rowCount:
                    add(ids, pageResult.rows[i].id)
                    add(titles, pageResult.rows[i].title)
                    add(sources, pageResult.rows[i].source)
                    add(relTimes, relativeTimeStr(pageResult.rows[i].updatedAtMs))
                    i = i + 1
                usingDemo = false

    if usingDemo:
        let demoIds: str[] = ["101", "102", "103", "104", "105", "106", "107", "108"]
        let demoTitles: str[] = [
            "Code review - check the PR for the new widget",
            "Bug fix: null deref in parser",
            "Feature X - implement the rendering pipeline",
            "Refactor the terminal module",
            "Write documentation for the CLI tool",
            "Investigate CI failure on macOS",
            "Update dependencies for security patches",
            "Performance benchmark for the new JSON parser"
        ]
        let demoSources: str[] = [
            "cli", "vscode", "exec", "cli",
            "vscode", "exec", "cli", "vscode"
        ]
        let demoCount: int32 = 8
        let nowMs: int64 = tuiNowMs()
        var i: int32 = 0
        while i < demoCount:
            add(ids, demoIds[i])
            add(titles, demoTitles[i])
            add(sources, demoSources[i])
            let minsAgo: int32 = (demoCount - i) * 5
            let msAgo: int32 = minsAgo * 60000
            add(relTimes, relativeTimeStr(nowMs - int64(msAgo)))
            i = i + 1

    let threadCount: int32 = ids.len

    # ---- State ----------------------------------------------------------
    var selected: int32 = 0
    var topRow: int32 = 0
    let headerHeight: int32 = 2
    let statusHeight: int32 = 1
    let listHeight: int32 = termRows - headerHeight - statusHeight

    # ---- Key codes ------------------------------------------------------
    let key_q: int32 = 113
    let key_j: int32 = 106
    let key_k: int32 = 107
    let key_d: int32 = 100
    let key_p: int32 = 112

    # ---- Main loop ------------------------------------------------------
    while true:
        var buf: render.RustCsgTuiBuffer = render.RustCsgTuiBufferInit(termCols, termRows)

        renderHeader(buf, termCols)
        renderThreadList(buf, ids, titles, sources, relTimes,
                         selected, headerHeight, listHeight, termCols, topRow)
        renderStatusBar(buf, termCols, threadCount, topRow, listHeight)

        let output: str = render.RustCsgTuiBufferRender(buf)
        term.TerminalWrite(output)

        let code: int32 = term.TerminalReadKeyCode()

        if code == key_q:
            break
        if code == key_j:
            selected = selected + 1
            if selected >= threadCount:
                selected = threadCount - 1
            if topRow + listHeight <= selected:
                topRow = selected - listHeight + 1
        if code == key_k:
            selected = selected - 1
            if selected < 0:
                selected = 0
            if selected < topRow:
                topRow = selected

        if code == key_d:
            let dialogStr: str = render.RustCsgTuiDialogRender("About Codex", "Cheng Codex TUI\n\nModel: DeepSeek V4\nTransport: stdio/tcp/unix/ws\nApp-Server: 62 handlers\nMCP: 15 tools", termCols, termRows)
            term.TerminalWrite(dialogStr)
            let _ = term.TerminalReadByte()
        if code == key_p:
            let progressStr: str = render.RustCsgTuiProgressBar(selected + 1, threadCount, termCols - 4)
            term.TerminalMoveTo(1, termRows)
            term.TerminalWrite(progressStr)
            let _ = term.TerminalReadByte()

    # ---- Restore and exit -----------------------------------------------
    term.TerminalRestore()
    return 0
