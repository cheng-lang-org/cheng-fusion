# TUI chatwidget selector popup snapshot oracle.

import std/strutils as strutil

fn RustCsgTuiChatwidgetSelectorLines(lines: str[]): str =
    return strutil.Join([strutil.Join(lines, "\n"), "\n"], "")

fn RustCsgTuiChatwidgetTerminalTitlePopupHardcoded(): str =
    return RustCsgTuiChatwidgetSelectorLines([
        "  Configure Terminal Title",
        "  Select which items to display in the terminal title.",
        "",
        "  Type to search",
        "  >",
        "› [x] thread-title   Current thread title, or thread identifier when unnamed",
        "  [x] git-branch     Current Git branch (omitted when unavailable)",
        "  [x] task-progress  Latest task progress from update_plan (omitted until available)",
        "  [ ] app-name       Codex app name",
        "  [ ] project-name   Project name (falls back to current directory name)",
        "  [ ] current-dir    Current working directory",
        "  [ ] activity       Spinner while working, action-required message while blocked.",
        "  [ ] run-state      Compact session run-state text (Ready, Working, Thinking)",
        "",
        "  thread title | feat/awesome-feature | Tasks 0/0",
        "  Press space to toggle; ←/→ to move; enter to confirm and close; esc to close",
    ])

