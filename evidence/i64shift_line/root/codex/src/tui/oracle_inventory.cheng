# TUI oracle inventory.
#
# Reads the Rust TUI snapshot/frame oracle from the source checkout and reports
# the concrete file counts. This is an inventory gate only; pixel parity is
# verified by later snapshot/frame render comparisons.

import std/strings
import std/strutils as strutil

@abi_internal
@importc("WalkDirRec")
fn RustCsgTuiOracleWalkDirRec(path: str): str[]

@abi_internal
@importc("RustCsgPathMetadataKind")
fn RustCsgTuiOraclePathMetadataKind(path: str): int32

@abi_internal
@importc("RustCsgFileSize")
fn RustCsgTuiOracleFileSize(path: str): int64

@abi_internal
@importc("ReadFile")
fn RustCsgTuiOracleReadFile(path: str): str

type
    RustCsgTuiOracleInventory =
        ok: bool
        sourceRoot: str
        snapshotDir: str
        frameDir: str
        snapshotCount: int32
        frameCount: int32
        frameGroupCount: int32
        frameFilesPerGroup: int32
        frameLinesPerFile: int32
        snapshotBytes: int64
        frameBytes: int64
        firstSnapshotPath: str
        firstFramePath: str
        error: str

fn RustCsgTuiOracleStripTrailingSlash(path: str): str =
    let n: int32 = strings.Len(path)
    if n > 1 && strings.HasSuffix(path, "/"):
        return strings.SliceBytes(path, 0, n - 1)
    return path

fn RustCsgTuiOracleJoin(root: str, rel: str): str =
    let cleanRoot: str = RustCsgTuiOracleStripTrailingSlash(root)
    return strings.ConcatStr(strings.ConcatStr(cleanRoot, "/"), rel)

fn RustCsgTuiOracleFindSub(text: str, needle: str, start: int32): int32 =
    let n: int32 = strings.Len(text)
    let m: int32 = strings.Len(needle)
    if m == 0:
        return start
    if start < 0 || m > n:
        return -1
    var i: int32 = start
    while i <= n - m:
        var j: int32 = 0
        var matched: bool = true
        while j < m:
            if text[i + j] != needle[j]:
                matched = false
                break
            j = j + 1
        if matched:
            return i
        i = i + 1
    return -1

fn RustCsgTuiOracleLastSlash(path: str): int32 =
    var i: int32 = strings.Len(path) - 1
    while i >= 0:
        if path[i] == '/':
            return i
        i = i - 1
    return -1

fn RustCsgTuiOracleParentName(path: str): str =
    let lastSlash: int32 = RustCsgTuiOracleLastSlash(path)
    if lastSlash <= 0:
        return ""
    var prevSlash: int32 = lastSlash - 1
    while prevSlash >= 0:
        if path[prevSlash] == '/':
            return strings.SliceBytes(path, prevSlash + 1, lastSlash - prevSlash - 1)
        prevSlash = prevSlash - 1
    return ""

fn RustCsgTuiOracleBaseName(path: str): str =
    let lastSlash: int32 = RustCsgTuiOracleLastSlash(path)
    if lastSlash < 0:
        return path
    return strings.SliceBytes(path, lastSlash + 1, strings.Len(path) - lastSlash - 1)

fn RustCsgTuiOracleFrameNumber(path: str): int32 =
    let name: str = RustCsgTuiOracleBaseName(path)
    if !strings.HasPrefix(name, "frame_") || !strings.HasSuffix(name, ".txt"):
        return -1
    let n: int32 = strings.Len(name)
    var i: int32 = 6
    if i >= n - 4:
        return -1
    var value: int32 = 0
    while i < n - 4:
        let ch: char = name[i]
        if ch < '0' || ch > '9':
            return -1
        value = value * 10 + (int32(ch) - int32('0'))
        i = i + 1
    return value

fn RustCsgTuiOracleLineCount(text: str): int32 =
    let n: int32 = strings.Len(text)
    if n == 0:
        return 0
    var count: int32 = 0
    var i: int32 = 0
    while i < n:
        if text[i] == '\n':
            count = count + 1
        i = i + 1
    if text[n - 1] != '\n':
        count = count + 1
    return count

fn RustCsgTuiOracleSnapshotLooksValid(text: str): bool =
    if strings.Len(text) == 0:
        return false
    if !strings.HasPrefix(text, "---"):
        return false
    let firstNewline: int32 = RustCsgTuiOracleFindSub(text, "\n", 0)
    if firstNewline < 3:
        return false
    if RustCsgTuiOracleFindSub(text, "\nsource: ", 0) < 0:
        return false
    if RustCsgTuiOracleFindSub(text, "\nexpression: ", 0) < 0:
        return false
    let secondDivider: int32 = RustCsgTuiOracleFindSub(text, "\n---\n", 4)
    if secondDivider < 0:
        return false
    return strings.Len(text) > secondDivider + 5

fn RustCsgTuiOracleFindGroup(groups: str[], group: str): int32 =
    var i: int32 = 0
    while i < groups.len:
        if groups[i] == group:
            return i
        i = i + 1
    return -1

fn RustCsgTuiOracleFail(message: str, inv: var RustCsgTuiOracleInventory) =
    inv.ok = false
    inv.error = message

fn RustCsgTuiOracleCountSnapshots(dirPath: str,
                                  outFirst: var str,
                                  outBytes: var int64,
                                  outError: var str): int32 =
    if RustCsgTuiOraclePathMetadataKind(dirPath) != 1:
        outError = strutil.Join(["snapshot oracle directory missing: ", dirPath], "")
        return -1

    let paths = RustCsgTuiOracleWalkDirRec(dirPath)
    var count: int32 = 0
    var i: int32 = 0
    while i < paths.len:
        let path: str = paths[i]
        if strings.HasSuffix(path, ".snap"):
            let size: int64 = RustCsgTuiOracleFileSize(path)
            if size <= int64(0):
                outError = strutil.Join(["snapshot oracle file empty or unreadable: ", path], "")
                return -1
            let text: str = RustCsgTuiOracleReadFile(path)
            if !RustCsgTuiOracleSnapshotLooksValid(text):
                outError = strutil.Join(["snapshot oracle file has invalid insta shape: ", path], "")
                return -1
            if count == 0:
                outFirst = path
            outBytes = outBytes + size
            count = count + 1
        i = i + 1

    if count <= 0:
        outError = strutil.Join(["snapshot oracle has no .snap files: ", dirPath], "")
        return -1
    return count

fn RustCsgTuiOracleCountFrames(dirPath: str,
                               expectedFramesPerGroup: int32,
                               expectedLinesPerFrame: int32,
                               outFirst: var str,
                               outBytes: var int64,
                               outGroupCount: var int32,
                               outError: var str): int32 =
    if RustCsgTuiOraclePathMetadataKind(dirPath) != 1:
        outError = strutil.Join(["frame oracle directory missing: ", dirPath], "")
        return -1

    var groupNames: str[]
    var groupCounts: int32[]
    groupNames = []
    groupCounts = []

    let paths = RustCsgTuiOracleWalkDirRec(dirPath)
    var count: int32 = 0
    var i: int32 = 0
    while i < paths.len:
        let path: str = paths[i]
        if strings.HasSuffix(path, ".txt"):
            let group: str = RustCsgTuiOracleParentName(path)
            if strings.Len(group) == 0:
                outError = strutil.Join(["frame oracle path has no group: ", path], "")
                return -1
            let frameNo: int32 = RustCsgTuiOracleFrameNumber(path)
            if frameNo < 1 || frameNo > expectedFramesPerGroup:
                outError = strutil.Join(["frame oracle filename out of expected range: ", path], "")
                return -1
            let size: int64 = RustCsgTuiOracleFileSize(path)
            if size <= int64(0):
                outError = strutil.Join(["frame oracle file empty or unreadable: ", path], "")
                return -1
            let text: str = RustCsgTuiOracleReadFile(path)
            let lineCount: int32 = RustCsgTuiOracleLineCount(text)
            if lineCount != expectedLinesPerFrame:
                outError = strutil.Join(["frame oracle line count mismatch: ", path], "")
                return -1
            var groupIndex: int32 = RustCsgTuiOracleFindGroup(groupNames, group)
            if groupIndex < 0:
                add(groupNames, group)
                add(groupCounts, 0)
                groupIndex = groupNames.len - 1
            groupCounts[groupIndex] = groupCounts[groupIndex] + 1
            if count == 0:
                outFirst = path
            outBytes = outBytes + size
            count = count + 1
        i = i + 1

    if count <= 0:
        outError = strutil.Join(["frame oracle has no .txt files: ", dirPath], "")
        return -1

    i = 0
    while i < groupCounts.len:
        if groupCounts[i] != expectedFramesPerGroup:
            outError = strutil.Join(["frame oracle group count mismatch: ", groupNames[i]], "")
            return -1
        i = i + 1

    outGroupCount = groupNames.len
    return count

fn RustCsgTuiOracleInventoryFromSourceRoot(sourceRootRaw: str): RustCsgTuiOracleInventory =
    var inv: RustCsgTuiOracleInventory
    let sourceRoot: str = RustCsgTuiOracleStripTrailingSlash(sourceRootRaw)
    inv.sourceRoot = sourceRoot
    inv.snapshotDir = RustCsgTuiOracleJoin(sourceRoot, "codex-rs/tui/src")
    inv.frameDir = RustCsgTuiOracleJoin(sourceRoot, "codex-rs/tui/frames")

    if strings.Len(sourceRoot) == 0:
        RustCsgTuiOracleFail("source root is empty", inv)
        return inv

    if RustCsgTuiOraclePathMetadataKind(sourceRoot) != 1:
        RustCsgTuiOracleFail(strutil.Join(["source root directory missing: ", sourceRoot], ""), inv)
        return inv

    var error: str
    var firstSnapshotPath: str
    var snapshotBytes: int64
    let snapshotCount: int32 = RustCsgTuiOracleCountSnapshots(inv.snapshotDir,
                                                              firstSnapshotPath, snapshotBytes, error)
    if snapshotCount < 0:
        RustCsgTuiOracleFail(error, inv)
        return inv
    inv.snapshotCount = snapshotCount
    inv.firstSnapshotPath = firstSnapshotPath
    inv.snapshotBytes = snapshotBytes

    error = ""
    var firstFramePath: str
    var frameBytes: int64
    var frameGroupCount: int32
    let frameCount: int32 = RustCsgTuiOracleCountFrames(inv.frameDir, 36, 17,
                                                        firstFramePath, frameBytes,
                                                        frameGroupCount, error)
    if frameCount < 0:
        RustCsgTuiOracleFail(error, inv)
        return inv
    inv.frameCount = frameCount
    inv.firstFramePath = firstFramePath
    inv.frameBytes = frameBytes
    inv.frameGroupCount = frameGroupCount
    inv.frameFilesPerGroup = 36
    inv.frameLinesPerFile = 17

    inv.ok = true
    return inv
