# Full TUI oracle text gate.
#
# This walks the real Rust oracle tree and validates every snapshot/frame
# through oracle_text. It still does only oracle self-compare; Cheng rendering
# output is intentionally not compared here.

import std/strings
import std/strutils as strutil
import cheng/codex/tui/oracle_text as text

@abi_internal
@importc("WalkDirRec")
fn RustCsgTuiOracleTextFullWalkDirRec(path: str): str[]

@abi_internal
@importc("RustCsgPathMetadataKind")
fn RustCsgTuiOracleTextFullPathMetadataKind(path: str): int32

type
    RustCsgTuiOracleTextFullReport =
        ok: bool
        sourceRoot: str
        snapshotCount: int32
        frameCount: int32
        quotedSnapshotCount: int32
        rawSnapshotCount: int32
        selfCompareCount: int32
        frameLinesPerFile: int32 = 17
        firstSnapshotPath: str
        firstFramePath: str
        error: str

fn RustCsgTuiOracleTextFullStripTrailingSlash(path: str): str =
    let n: int32 = strings.Len(path)
    if n > 1 && strings.HasSuffix(path, "/"):
        return strings.SliceBytes(path, 0, n - 1)
    return path

fn RustCsgTuiOracleTextFullJoin(root: str, rel: str): str =
    return strutil.Join([RustCsgTuiOracleTextFullStripTrailingSlash(root), "/", rel], "")

fn RustCsgTuiOracleTextFullBaseName(path: str): str =
    var i: int32 = strings.Len(path) - 1
    while i >= 0:
        if path[i] == '/':
            return strings.SliceBytes(path, i + 1, strings.Len(path) - i - 1)
        i = i - 1
    return path

fn RustCsgTuiOracleTextFullIsFrameFile(path: str): bool =
    let name: str = RustCsgTuiOracleTextFullBaseName(path)
    return strings.HasPrefix(name, "frame_") && strings.HasSuffix(name, ".txt")

fn RustCsgTuiOracleTextFullFail(message: str, report: var RustCsgTuiOracleTextFullReport) =
    report.ok = false
    report.error = message

fn RustCsgTuiOracleTextFullValidateSnapshots(snapshotDir: str,
                                             report: var RustCsgTuiOracleTextFullReport): bool =
    if RustCsgTuiOracleTextFullPathMetadataKind(snapshotDir) != 1:
        RustCsgTuiOracleTextFullFail(strutil.Join(["snapshot oracle directory missing: ", snapshotDir], ""), report)
        return false

    let paths = RustCsgTuiOracleTextFullWalkDirRec(snapshotDir)
    var i: int32 = 0
    while i < paths.len:
        let path: str = paths[i]
        if strings.HasSuffix(path, ".snap"):
            let parsed = text.RustCsgTuiOracleTextParseSnapshotFile(path)
            if !parsed.ok:
                RustCsgTuiOracleTextFullFail(parsed.error, report)
                return false
            if parsed.bodyLineCount <= 0:
                RustCsgTuiOracleTextFullFail(strutil.Join(["snapshot body has no lines: ", path], ""), report)
                return false
            let diff = text.RustCsgTuiOracleTextCompare(path, parsed.body, parsed.body)
            if !diff.ok:
                RustCsgTuiOracleTextFullFail(diff.error, report)
                return false
            if parsed.bodyKind == "quoted-lines":
                report.quotedSnapshotCount = report.quotedSnapshotCount + 1
            elif parsed.bodyKind == "raw":
                report.rawSnapshotCount = report.rawSnapshotCount + 1
            else:
                RustCsgTuiOracleTextFullFail(strutil.Join(["snapshot body kind unknown: ", path], ""), report)
                return false
            if report.snapshotCount == 0:
                report.firstSnapshotPath = path
            report.snapshotCount = report.snapshotCount + 1
            report.selfCompareCount = report.selfCompareCount + 1
        i = i + 1
    return true

fn RustCsgTuiOracleTextFullValidateFrames(frameDir: str,
                                          report: var RustCsgTuiOracleTextFullReport): bool =
    if RustCsgTuiOracleTextFullPathMetadataKind(frameDir) != 1:
        RustCsgTuiOracleTextFullFail(strutil.Join(["frame oracle directory missing: ", frameDir], ""), report)
        return false

    let paths = RustCsgTuiOracleTextFullWalkDirRec(frameDir)
    var i: int32 = 0
    while i < paths.len:
        let path: str = paths[i]
        if RustCsgTuiOracleTextFullIsFrameFile(path):
            let parsed = text.RustCsgTuiOracleTextParseFrameFile(path)
            if !parsed.ok:
                RustCsgTuiOracleTextFullFail(parsed.error, report)
                return false
            if parsed.bodyLineCount != report.frameLinesPerFile:
                RustCsgTuiOracleTextFullFail(strutil.Join(["frame line count mismatch: ", path], ""), report)
                return false
            let diff = text.RustCsgTuiOracleTextCompare(path, parsed.body, parsed.body)
            if !diff.ok:
                RustCsgTuiOracleTextFullFail(diff.error, report)
                return false
            if report.frameCount == 0:
                report.firstFramePath = path
            report.frameCount = report.frameCount + 1
            report.selfCompareCount = report.selfCompareCount + 1
        i = i + 1
    return true

fn RustCsgTuiOracleTextFullValidateSourceRoot(sourceRootRaw: str): RustCsgTuiOracleTextFullReport =
    var report: RustCsgTuiOracleTextFullReport
    report.frameLinesPerFile = 17
    let sourceRoot: str = RustCsgTuiOracleTextFullStripTrailingSlash(sourceRootRaw)
    report.sourceRoot = sourceRoot
    if strings.Len(sourceRoot) == 0:
        RustCsgTuiOracleTextFullFail("source root is empty", report)
        return report
    if RustCsgTuiOracleTextFullPathMetadataKind(sourceRoot) != 1:
        RustCsgTuiOracleTextFullFail(strutil.Join(["source root directory missing: ", sourceRoot], ""), report)
        return report

    let snapshotDir: str = RustCsgTuiOracleTextFullJoin(sourceRoot, "codex-rs/tui/src")
    if !RustCsgTuiOracleTextFullValidateSnapshots(snapshotDir, report):
        return report
    if report.snapshotCount <= 0:
        RustCsgTuiOracleTextFullFail(strutil.Join(["snapshot oracle has no .snap files: ", snapshotDir], ""), report)
        return report
    if report.quotedSnapshotCount <= 0:
        RustCsgTuiOracleTextFullFail("snapshot oracle has no quoted bodies", report)
        return report
    if report.rawSnapshotCount <= 0:
        RustCsgTuiOracleTextFullFail("snapshot oracle has no raw bodies", report)
        return report

    let frameDir: str = RustCsgTuiOracleTextFullJoin(sourceRoot, "codex-rs/tui/frames")
    if !RustCsgTuiOracleTextFullValidateFrames(frameDir, report):
        return report
    if report.frameCount <= 0:
        RustCsgTuiOracleTextFullFail(strutil.Join(["frame oracle has no frame_*.txt files: ", frameDir], ""), report)
        return report

    report.ok = true
    return report
