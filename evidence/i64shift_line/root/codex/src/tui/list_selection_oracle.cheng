# TUI bottom_pane/list_selection_view raw render_lines oracle renderer.

import std/strings
import std/strutils as strutil

fn RustCsgTuiListSelectionSpaces(count: int32): str =
    var out: str = ""
    var i: int32 = 0
    while i < count:
        out = strings.ConcatStr(out, " ")
        i = i + 1
    return out

fn RustCsgTuiListSelectionStartsWithAt(text: str, index: int32, prefix: str): bool =
    let prefixLen: int32 = strings.Len(prefix)
    if index < 0:
        return false
    if index + prefixLen > strings.Len(text):
        return false
    return strings.SliceBytes(text, index, prefixLen) == prefix

fn RustCsgTuiListSelectionNextGlyph(text: str, index: int32): str =
    if RustCsgTuiListSelectionStartsWithAt(text, index, "›"):
        return "›"
    if RustCsgTuiListSelectionStartsWithAt(text, index, "…"):
        return "…"
    return strings.SliceBytes(text, index, 1)

fn RustCsgTuiListSelectionDisplayWidth(text: str): int32 =
    var width: int32 = 0
    var i: int32 = 0
    while i < strings.Len(text):
        let glyph: str = RustCsgTuiListSelectionNextGlyph(text, i)
        width = width + 1
        i = i + strings.Len(glyph)
    return width

fn RustCsgTuiListSelectionPad(text: str, width: int32): str =
    let currentWidth: int32 = RustCsgTuiListSelectionDisplayWidth(text)
    if currentWidth > width:
        assert(false, "list selection line exceeds width")
    return strings.ConcatStr(text, RustCsgTuiListSelectionSpaces(width - currentWidth))

fn RustCsgTuiListSelectionAppendLine(out: str, line: str, width: int32, pad: bool): str =
    var next: str = out
    if pad:
        next = strings.ConcatStr(next, RustCsgTuiListSelectionPad(line, width))
    else:
        next = strings.ConcatStr(next, line)
    next = strings.ConcatStr(next, "\n")
    return next

fn RustCsgTuiListSelectionPrefix(indexText: str, selected: bool): str =
    if selected:
        return strutil.Join(["› ", indexText, ". "], "")
    return strutil.Join(["  ", indexText, ". "], "")

fn RustCsgTuiListSelectionRow(indexText: str, name: str, desc: str, selected: bool, descCol: int32): str =
    let left: str = strings.ConcatStr(RustCsgTuiListSelectionPrefix(indexText, selected), name)
    let leftWidth: int32 = RustCsgTuiListSelectionDisplayWidth(left)
    if descCol <= leftWidth:
        return strutil.Join([left, " ", desc], "")
    return strutil.Join([left, RustCsgTuiListSelectionSpaces(descCol - leftWidth), desc], "")

fn RustCsgTuiListSelectionContinuation(descCol: int32, desc: str): str =
    return strings.ConcatStr(RustCsgTuiListSelectionSpaces(descCol), desc)

fn RustCsgTuiListSelectionDebugHeader(width: int32): str =
    var out: str = ""
    out = RustCsgTuiListSelectionAppendLine(out, "", width, true)
    out = RustCsgTuiListSelectionAppendLine(out, "  Debug", width, true)
    out = RustCsgTuiListSelectionAppendLine(out, "", width, true)
    return out

fn RustCsgTuiListSelectionApprovalHeader(width: int32, subtitle: str): str =
    var out: str = ""
    out = RustCsgTuiListSelectionAppendLine(out, "", width, true)
    out = RustCsgTuiListSelectionAppendLine(out, "  Select Approval Mode", width, true)
    if strings.Len(subtitle) > 0:
        out = RustCsgTuiListSelectionAppendLine(out, strings.ConcatStr("  ", subtitle), width, true)
    out = RustCsgTuiListSelectionAppendLine(out, "", width, true)
    return out

fn RustCsgTuiListSelectionScrollRows(width: int32, descCol: int32, firstIndex: int32, selectedIndex: int32, padLast: bool): str =
    var out: str = RustCsgTuiListSelectionDebugHeader(width)
    var idx: int32 = firstIndex
    while idx <= firstIndex + 6:
        let idxText: str = strings.IntToStr(idx)
        out = RustCsgTuiListSelectionAppendLine(out, RustCsgTuiListSelectionRow(idxText, strutil.Join(["Item ", idxText], ""), strutil.Join(["desc ", idxText], ""), idx == selectedIndex, descCol), width, true)
        idx = idx + 1
    let lastText: str = strings.IntToStr(firstIndex + 7)
    var lastName: str = strutil.Join(["Item ", lastText], "")
    if firstIndex != 1:
        lastName = "Item 9 with an intentionally much longer name"
    let lastRow: str = RustCsgTuiListSelectionRow(lastText, lastName, strutil.Join(["desc ", lastText], ""), firstIndex + 7 == selectedIndex, descCol)
    out = RustCsgTuiListSelectionAppendLine(out, lastRow, width, padLast)
    if padLast:
        out = RustCsgTuiListSelectionAppendLine(out, "", width, true)
    return out

fn RustCsgTuiListSelectionFixedScrollRows(width: int32, firstIndex: int32, selectedIndex: int32, padLast: bool): str =
    var out: str = RustCsgTuiListSelectionDebugHeader(width)
    var idx: int32 = firstIndex
    while idx <= firstIndex + 6:
        let idxText: str = strings.IntToStr(idx)
        out = RustCsgTuiListSelectionAppendLine(out, RustCsgTuiListSelectionRow(idxText, strutil.Join(["Item ", idxText], ""), strutil.Join(["desc ", idxText], ""), idx == selectedIndex, 28), width, true)
        idx = idx + 1
    let lastText: str = strings.IntToStr(firstIndex + 7)
    var lastName: str = strutil.Join(["Item ", lastText], "")
    if firstIndex != 1:
        lastName = "Item 9 with an intent…"
    let lastRow: str = RustCsgTuiListSelectionRow(lastText, lastName, strutil.Join(["desc ", lastText], ""), firstIndex + 7 == selectedIndex, 28)
    out = RustCsgTuiListSelectionAppendLine(out, lastRow, width, padLast)
    if padLast:
        out = RustCsgTuiListSelectionAppendLine(out, "", width, true)
    return out

fn RustCsgTuiListSelectionScrollSnapshot(descColBefore: int32, fixed: bool): str =
    var out: str = "before scroll:\n"
    if fixed:
        out = strings.ConcatStr(out, RustCsgTuiListSelectionFixedScrollRows(96, 1, 1, true))
    else:
        out = strings.ConcatStr(out, RustCsgTuiListSelectionScrollRows(96, descColBefore, 1, 1, true))
    out = strings.ConcatStr(out, "\nafter scroll:\n")
    if fixed:
        out = strings.ConcatStr(out, RustCsgTuiListSelectionFixedScrollRows(96, 2, 9, false))
    else:
        out = strings.ConcatStr(out, RustCsgTuiListSelectionScrollRows(96, 52, 2, 9, false))
    return out

fn RustCsgTuiListSelectionAutoAllRowsScrollSnapshot(): str =
    return RustCsgTuiListSelectionScrollSnapshot(52, false)

fn RustCsgTuiListSelectionAutoVisibleScrollSnapshot(): str =
    return RustCsgTuiListSelectionScrollSnapshot(13, false)

fn RustCsgTuiListSelectionFixedScrollSnapshot(): str =
    return RustCsgTuiListSelectionScrollSnapshot(28, true)

fn RustCsgTuiListSelectionFooterNoteWrapsSnapshot(): str =
    var out: str = RustCsgTuiListSelectionApprovalHeader(40, "")
    out = RustCsgTuiListSelectionAppendLine(out, RustCsgTuiListSelectionRow("1", "Read Only (current)", "Codex can", true, 26), 40, true)
    out = RustCsgTuiListSelectionAppendLine(out, RustCsgTuiListSelectionContinuation(26, "read files"), 40, true)
    out = RustCsgTuiListSelectionAppendLine(out, "", 40, true)
    out = RustCsgTuiListSelectionAppendLine(out, "  Note: Use /setup-default-sandbox to", 40, true)
    out = RustCsgTuiListSelectionAppendLine(out, "  allow network access.", 40, true)
    out = RustCsgTuiListSelectionAppendLine(out, "  Press enter to confirm or esc to go ba", 40, false)
    return out

fn RustCsgTuiListSelectionModelPickerWidth80Snapshot(): str =
    var out: str = ""
    out = RustCsgTuiListSelectionAppendLine(out, "", 80, true)
    out = RustCsgTuiListSelectionAppendLine(out, "  Select Model and Effort", 80, true)
    out = RustCsgTuiListSelectionAppendLine(out, "", 80, true)
    out = RustCsgTuiListSelectionAppendLine(out, RustCsgTuiListSelectionRow("1", "gpt-5.1-codex (current)", "Optimized for Codex. Balance of reasoning", true, 30), 80, true)
    out = RustCsgTuiListSelectionAppendLine(out, RustCsgTuiListSelectionContinuation(30, "quality and coding ability."), 80, true)
    out = RustCsgTuiListSelectionAppendLine(out, RustCsgTuiListSelectionRow("2", "gpt-5.1-codex-mini", "Optimized for Codex. Cheaper, faster, but less", false, 30), 80, true)
    out = RustCsgTuiListSelectionAppendLine(out, RustCsgTuiListSelectionContinuation(30, "capable."), 80, true)
    out = RustCsgTuiListSelectionAppendLine(out, RustCsgTuiListSelectionRow("3", "gpt-4.1-codex", "Legacy model. Use when you need compatibility", false, 30), 80, true)
    out = RustCsgTuiListSelectionAppendLine(out, RustCsgTuiListSelectionContinuation(30, "with older automations."), 80, false)
    return out

fn RustCsgTuiListSelectionNarrowWidthPreservesRowsSnapshot(): str =
    var out: str = RustCsgTuiListSelectionDebugHeader(24)
    var idx: int32 = 1
    while idx <= 3:
        let idxText: str = strings.IntToStr(idx)
        out = RustCsgTuiListSelectionAppendLine(out, RustCsgTuiListSelectionRow(idxText, strutil.Join(["Item ", idxText], ""), "", idx == 1, 13), 24, true)
        out = RustCsgTuiListSelectionAppendLine(out, RustCsgTuiListSelectionContinuation(13, "xxxxxxxxx"), 24, true)
        out = RustCsgTuiListSelectionAppendLine(out, RustCsgTuiListSelectionContinuation(13, "x"), 24, idx != 3)
        idx = idx + 1
    return out

fn RustCsgTuiListSelectionSpacingWithSubtitleSnapshot(): str =
    var out: str = RustCsgTuiListSelectionApprovalHeader(48, "Switch between Codex approval presets")
    out = RustCsgTuiListSelectionAppendLine(out, RustCsgTuiListSelectionRow("1", "Read Only (current)", "Codex can read files", true, 26), 48, true)
    out = RustCsgTuiListSelectionAppendLine(out, RustCsgTuiListSelectionRow("2", "Full Access", "Codex can edit files", false, 26), 48, true)
    out = RustCsgTuiListSelectionAppendLine(out, "", 48, true)
    out = RustCsgTuiListSelectionAppendLine(out, "  Press enter to confirm or esc to go back", 48, false)
    return out

fn RustCsgTuiListSelectionSpacingWithoutSubtitleSnapshot(): str =
    var out: str = RustCsgTuiListSelectionApprovalHeader(48, "")
    out = RustCsgTuiListSelectionAppendLine(out, RustCsgTuiListSelectionRow("1", "Read Only (current)", "Codex can read files", true, 26), 48, true)
    out = RustCsgTuiListSelectionAppendLine(out, RustCsgTuiListSelectionRow("2", "Full Access", "Codex can edit files", false, 26), 48, true)
    out = RustCsgTuiListSelectionAppendLine(out, "", 48, true)
    out = RustCsgTuiListSelectionAppendLine(out, "  Press enter to confirm or esc to go back", 48, false)
    return out
