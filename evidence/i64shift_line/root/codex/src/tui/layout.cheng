# TUI layout engine — rectangle splitting and conversation layout.
#
# Ported from codex-rs/tui/src/render/mod.rs and related modules.
#
# Rect: x, y, width, height
# Layout: split a rectangle into sub-rectangles based on constraints.

import std/strings
import std/strutils as strutil

# ── Rect type ─────────────────────────────────────────────────────────────────

type
    RustCsgTuiRect =
        x: int32
        y: int32
        width: int32
        height: int32

# Create a Rect with the given position and size.
fn RustCsgTuiRectNew(x: int32, y: int32, width: int32, height: int32): RustCsgTuiRect =
    var r: RustCsgTuiRect
    r.x = x
    r.y = y
    r.width = width
    r.height = height
    return r

# Create an empty Rect (all zero).
fn RustCsgTuiRectZero(): RustCsgTuiRect =
    var r: RustCsgTuiRect
    r.x = 0
    r.y = 0
    r.width = 0
    r.height = 0
    return r

# ── Layout constraints ────────────────────────────────────────────────────────

# Constraint type constants
const RustCsgTuiConstraintPercentage: int32 = 0
const RustCsgTuiConstraintFixed: int32 = 1
const RustCsgTuiConstraintMin: int32 = 2
const RustCsgTuiConstraintMax: int32 = 3

type
    RustCsgTuiConstraint =
        kind: int32     # one of the Constraint* constants
        value: int32    # percentage or fixed character count

# ── Layout type ───────────────────────────────────────────────────────────────

type
    RustCsgTuiLayout =
        direction: int32          # 0 = horizontal, 1 = vertical
        constraints: RustCsgTuiConstraint[]

# ── Layout functions ──────────────────────────────────────────────────────────

# Create a Layout with the given direction and constraints.
fn RustCsgTuiLayoutNew(direction: int32, constraints: RustCsgTuiConstraint[]): RustCsgTuiLayout =
    var layout: RustCsgTuiLayout
    layout.direction = direction
    layout.constraints = constraints
    return layout

# Create a percentage constraint.
fn RustCsgTuiConstraintPercent(pct: int32): RustCsgTuiConstraint =
    var c: RustCsgTuiConstraint
    c.kind = RustCsgTuiConstraintPercentage
    c.value = pct
    return c

# Create a fixed size constraint.
fn RustCsgTuiConstraintFixed(n: int32): RustCsgTuiConstraint =
    var c: RustCsgTuiConstraint
    c.kind = RustCsgTuiConstraintFixed
    c.value = n
    return c

# Split a Rect into sub-rectangles based on layout constraints.
#
# - For horizontal direction, the rect is split along the x axis (width).
# - For vertical direction, the rect is split along the y axis (height).
# - Percentage constraints are relative to the available size in the splitting dimension.
# - Fixed constraints reserve exactly N characters.
# - Returns an array of Rect sub-rectangles, one per constraint.
# - Hard-fail: if remaining area < 0 during layout, assert.
fn RustCsgTuiSplitLayout(rect: RustCsgTuiRect, lo: RustCsgTuiLayout): RustCsgTuiRect[] =
    let n: int32 = lo.constraints.len
    if n == 0:
        # No constraints -> return the full rect
        var result: RustCsgTuiRect[]
        add(result, rect)
        return result

    let totalSize: int32 = (lo.direction == 0) ? rect.width : rect.height
    var remainingSize: int32 = totalSize

    # First pass: allocate fixed and min constraints; sum percentages
    var totalPercent: int32 = 0
    var fixedSizes: int32[]
    var i: int32 = 0
    while i < n:
        let ck: int32 = lo.constraints[i].kind
        let cv: int32 = lo.constraints[i].value
        if ck == RustCsgTuiConstraintFixed:
            var s: int32 = 0
            if cv < remainingSize:
                s = cv
            else:
                s = remainingSize
            add(fixedSizes, s)
            remainingSize = remainingSize - s
        else:
            if ck == RustCsgTuiConstraintMin:
                var s: int32 = 0
                if cv < remainingSize:
                    s = cv
                else:
                    s = remainingSize
                add(fixedSizes, s)
                remainingSize = remainingSize - s
            else:
                if ck == RustCsgTuiConstraintPercentage:
                    add(fixedSizes, -1)   # placeholder
                    totalPercent = totalPercent + cv
                else:
                    # Max constraint: fill remaining
                    add(fixedSizes, -1)
        i = i + 1

    # Second pass: allocate percentages and max constraints
    var pctPool: int32 = remainingSize    # pool before percentage allocation
    var pctIndex: int32 = 0
    i = 0
    while i < n:
        let ck: int32 = lo.constraints[i].kind
        let cv: int32 = lo.constraints[i].value
        if ck == RustCsgTuiConstraintPercentage:
            var pctSize: int32 = 0
            if totalPercent > 0:
                if pctIndex < n - 1:
                    # Not the last percentage item — calculate proportionally from pool
                    pctSize = (pctPool * cv) / totalPercent
                else:
                    # Last percentage item gets remaining
                    pctSize = remainingSize
                if pctSize < 0:
                    pctSize = 0
                fixedSizes[i] = pctSize
                remainingSize = remainingSize - pctSize
                if remainingSize < 0:
                    remainingSize = 0
            pctIndex = pctIndex + 1
        else:
            if ck == RustCsgTuiConstraintMax:
                # Max: use remaining, but not more than value
                var take: int32 = remainingSize
                if take > cv:
                    take = cv
                fixedSizes[i] = take
                remainingSize = remainingSize - take
                if remainingSize < 0:
                    remainingSize = 0
        i = i + 1

    # Third pass: build results
    var result: RustCsgTuiRect[]
    var cursor: int32 = 0
    i = 0
    while i < n:
        let s = fixedSizes[i]
        if s < 0:
            # Unhandled constraint — skip
            i = i + 1
            continue
        if lo.direction == 0:
            var sub: RustCsgTuiRect
            sub.x = rect.x + cursor
            sub.y = rect.y
            sub.width = s
            sub.height = rect.height
            add(result, sub)
        else:
            var sub: RustCsgTuiRect
            sub.x = rect.x
            sub.y = rect.y + cursor
            sub.width = rect.width
            sub.height = s
            add(result, sub)
        cursor = cursor + s
        i = i + 1

    return result

# ── Predefined conversation layouts ───────────────────────────────────────────

# Compute the conversation layout for a Codex-style TUI.
#
# Returns an array of 3 Rects:
#   [0] = status bar (top, 1 row)
#   [1] = conversation view (main area)
#   [2] = input area (bottom, 3 rows)
#
# The input area height is clamped to termHeight - 1 (reserving 1 row for status bar).
fn RustCsgTuiConversationLayout(termWidth: int32, termHeight: int32): RustCsgTuiRect[] =
    var results: RustCsgTuiRect[]

    # Status bar: top line, full width
    var statusRect: RustCsgTuiRect
    statusRect.x = 0
    statusRect.y = 0
    statusRect.width = termWidth
    statusRect.height = 1
    add(results, statusRect)

    # Reserve input area (3 rows minimum)
    var inputHeight: int32 = 3
    let availableHeight: int32 = termHeight - 1   # after status bar
    if inputHeight > availableHeight:
        inputHeight = availableHeight

    # Conversation view: between status bar and input area
    var convRect: RustCsgTuiRect
    convRect.x = 0
    convRect.y = 1
    convRect.width = termWidth
    convRect.height = availableHeight - inputHeight
    add(results, convRect)

    # Input area: bottom
    var inputRect: RustCsgTuiRect
    inputRect.x = 0
    inputRect.y = 1 + availableHeight - inputHeight
    inputRect.width = termWidth
    inputRect.height = inputHeight
    add(results, inputRect)

    return results
