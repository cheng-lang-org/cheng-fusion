import std/strings
import std/strutils as strutil

const RustCsgTuiKeyEventKindPress: int32 = 1
const RustCsgTuiKeyEventKindRepeat: int32 = 2
const RustCsgTuiKeyEventKindRelease: int32 = 3

const RustCsgTuiKeyEnter: str = "Enter"
const RustCsgTuiKeyEsc: str = "Esc"
const RustCsgTuiKeyEscape: str = "Escape"
const RustCsgTuiKeyTab: str = "Tab"
const RustCsgTuiKeyBackspace: str = "Backspace"
const RustCsgTuiKeyDelete: str = "Delete"
const RustCsgTuiKeyHome: str = "Home"
const RustCsgTuiKeyEnd: str = "End"
const RustCsgTuiKeyInsert: str = "Insert"
const RustCsgTuiKeySpaceLabel: str = "space"
const RustCsgTuiKeyUp: str = "Up"
const RustCsgTuiKeyDown: str = "Down"
const RustCsgTuiKeyLeft: str = "Left"
const RustCsgTuiKeyRight: str = "Right"
const RustCsgTuiKeyPageUp: str = "PageUp"
const RustCsgTuiKeyPageDown: str = "PageDown"

const PrintableAsciiTable: str = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

type
    RustCsgTuiKeyParts =
        isChar: bool
        key: str
        charCode: int32
        ctrl: bool
        alt: bool
        shift: bool

    RustCsgTuiKeyBinding =
        parts: RustCsgTuiKeyParts

    RustCsgTuiKeyEvent =
        parts: RustCsgTuiKeyParts
        kind: int32

fn RustCsgTuiKeyPartsChar(charCode: int32, ctrl: bool, alt: bool, shift: bool): RustCsgTuiKeyParts =
    var parts: RustCsgTuiKeyParts
    parts.isChar = true
    parts.key = ""
    parts.charCode = charCode
    parts.ctrl = ctrl
    parts.alt = alt
    parts.shift = shift
    return parts

fn RustCsgTuiKeyPartsNamed(key: str, ctrl: bool, alt: bool, shift: bool): RustCsgTuiKeyParts =
    var parts: RustCsgTuiKeyParts
    parts.isChar = false
    parts.key = key
    parts.charCode = -1
    parts.ctrl = ctrl
    parts.alt = alt
    parts.shift = shift
    return parts

fn RustCsgTuiKeyBindingChar(charCode: int32, ctrl: bool, alt: bool, shift: bool): RustCsgTuiKeyBinding =
    var binding: RustCsgTuiKeyBinding
    binding.parts = RustCsgTuiKeyPartsChar(charCode, ctrl, alt, shift)
    return binding

fn RustCsgTuiKeyBindingNamed(key: str, ctrl: bool, alt: bool, shift: bool): RustCsgTuiKeyBinding =
    var binding: RustCsgTuiKeyBinding
    binding.parts = RustCsgTuiKeyPartsNamed(key, ctrl, alt, shift)
    return binding

fn RustCsgTuiKeyEventChar(charCode: int32, ctrl: bool, alt: bool, shift: bool, kind: int32): RustCsgTuiKeyEvent =
    var event: RustCsgTuiKeyEvent
    event.parts = RustCsgTuiKeyPartsChar(charCode, ctrl, alt, shift)
    event.kind = kind
    return event

fn RustCsgTuiKeyEventNamed(key: str, ctrl: bool, alt: bool, shift: bool, kind: int32): RustCsgTuiKeyEvent =
    var event: RustCsgTuiKeyEvent
    event.parts = RustCsgTuiKeyPartsNamed(key, ctrl, alt, shift)
    event.kind = kind
    return event

fn RustCsgTuiKeyBindingFromEvent(event: RustCsgTuiKeyEvent): RustCsgTuiKeyBinding =
    var binding: RustCsgTuiKeyBinding
    binding.parts = RustCsgTuiNormalizeKeyParts(event.parts)
    return binding

fn RustCsgTuiNormalizeKeyParts(parts: RustCsgTuiKeyParts): RustCsgTuiKeyParts =
    var out: RustCsgTuiKeyParts
    out.isChar = parts.isChar
    out.key = parts.key
    out.charCode = parts.charCode
    out.ctrl = parts.ctrl
    out.alt = parts.alt
    out.shift = parts.shift

    if !parts.isChar:
        return out

    if !parts.ctrl && !parts.alt && !parts.shift:
        let ctrlChar: int32 = RustCsgTuiC0ControlCharToCtrlChar(parts.charCode)
        if ctrlChar >= 0:
            out.charCode = ctrlChar
            out.ctrl = true
            return out

    if parts.charCode >= 65 && parts.charCode <= 90:
        out.charCode = parts.charCode + 32
        out.shift = true
        return out

    return out

fn RustCsgTuiC0ControlCharToCtrlChar(code: int32): int32 =
    if code == 0:
        return 32
    if code >= 1 && code <= 26:
        return code - 1 + 97
    if code >= 28 && code <= 31:
        return code - 28 + 52
    return -1

fn RustCsgTuiKeyPartsEqual(left: RustCsgTuiKeyParts, right: RustCsgTuiKeyParts): bool =
    if left.isChar != right.isChar: return false
    if left.ctrl != right.ctrl: return false
    if left.alt != right.alt: return false
    if left.shift != right.shift: return false
    if left.isChar:
        return left.charCode == right.charCode
    return left.key == right.key

fn RustCsgTuiKeyBindingIsPress(binding: RustCsgTuiKeyBinding, event: RustCsgTuiKeyEvent): bool =
    if event.kind != RustCsgTuiKeyEventKindPress && event.kind != RustCsgTuiKeyEventKindRepeat:
        return false
    let bindingParts: RustCsgTuiKeyParts = RustCsgTuiNormalizeKeyParts(binding.parts)
    let eventParts: RustCsgTuiKeyParts = RustCsgTuiNormalizeKeyParts(event.parts)
    return RustCsgTuiKeyPartsEqual(bindingParts, eventParts)

fn RustCsgTuiKeyBindingAnyIsPressed2(
    first: RustCsgTuiKeyBinding,
    second: RustCsgTuiKeyBinding,
    event: RustCsgTuiKeyEvent,
): bool =
    if RustCsgTuiKeyBindingIsPress(first, event): return true
    if RustCsgTuiKeyBindingIsPress(second, event): return true
    return false

fn RustCsgTuiIsPlainTextKeyEvent(event: RustCsgTuiKeyEvent): bool =
    if !event.parts.isChar: return false
    if event.parts.ctrl || event.parts.alt: return false
    if event.parts.charCode < 32 || event.parts.charCode == 127: return false
    return true

fn RustCsgTuiKeyBindingDisplayLabel(binding: RustCsgTuiKeyBinding): str =
    let modifiers: str = RustCsgTuiModifiersToString(binding.parts.ctrl, binding.parts.shift, binding.parts.alt)
    let key: str = RustCsgTuiKeyPartsDisplayKey(binding.parts)
    return strutil.Join([modifiers, key], "")

fn RustCsgTuiModifiersToString(ctrl: bool, shift: bool, alt: bool): str =
    var parts: str[]
    if ctrl:
        add(parts, "ctrl + ")
    if shift:
        add(parts, "shift + ")
    if alt:
        add(parts, "⌥ + ")
    return strutil.Join(parts, "")

fn RustCsgTuiKeyPartsDisplayKey(parts: RustCsgTuiKeyParts): str =
    if parts.isChar:
        if parts.charCode == 32:
            return RustCsgTuiKeySpaceLabel
        return RustCsgTuiAsciiCharLowerString(parts.charCode)
    if parts.key == RustCsgTuiKeyEnter:
        return "enter"
    if parts.key == RustCsgTuiKeyEsc || parts.key == RustCsgTuiKeyEscape:
        return "esc"
    if parts.key == RustCsgTuiKeyTab:
        return "tab"
    if parts.key == RustCsgTuiKeyBackspace:
        return "backspace"
    if parts.key == RustCsgTuiKeyDelete:
        return "delete"
    if parts.key == RustCsgTuiKeyHome:
        return "home"
    if parts.key == RustCsgTuiKeyEnd:
        return "end"
    if parts.key == RustCsgTuiKeyInsert:
        return "insert"
    if parts.key == RustCsgTuiKeyUp:
        return "↑"
    if parts.key == RustCsgTuiKeyDown:
        return "↓"
    if parts.key == RustCsgTuiKeyLeft:
        return "←"
    if parts.key == RustCsgTuiKeyRight:
        return "→"
    if parts.key == RustCsgTuiKeyPageUp:
        return "pgup"
    if parts.key == RustCsgTuiKeyPageDown:
        return "pgdn"
    return RustCsgTuiAsciiLowerString(parts.key)

fn RustCsgTuiAsciiCharLowerString(code: int32): str =
    var outCode: int32 = code
    if outCode >= 65 && outCode <= 90:
        outCode = outCode + 32
    if outCode < 32 || outCode > 126:
        return ""
    return strings.SliceBytes(PrintableAsciiTable, outCode - 32, 1)

fn RustCsgTuiAsciiLowerString(text: str): str =
    var parts: str[]
    var i: int32 = 0
    while i < strings.Len(text):
        add(parts, RustCsgTuiAsciiCharLowerString(Int32(text[i])))
        i = i + 1
    return strutil.Join(parts, "")

fn RustCsgTuiHasCtrlOrAlt(ctrl: bool, alt: bool): bool =
    return ctrl || alt
