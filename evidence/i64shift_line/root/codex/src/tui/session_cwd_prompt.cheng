import std/strings
import cheng/codex/tui/cwd_prompt_oracle as oracle

type
    RustCsgTuiSessionCwdPromptKey =
        key: str
        ctrl: bool
        ok: bool
        error: str

    RustCsgTuiSessionCwdPromptState =
        action: str
        currentCwd: str
        sessionCwd: str
        highlighted: str
        selection: str
        shouldExit: bool
        screen: str
        frameCount: int32

    RustCsgTuiSessionCwdPromptRunResult =
        ok: bool
        outcome: str
        selection: str
        screen: str
        frameCount: int32
        error: str

fn RustCsgTuiSessionCwdPromptError(message: str): RustCsgTuiSessionCwdPromptRunResult =
    var result: RustCsgTuiSessionCwdPromptRunResult
    result.outcome = "error"
    result.error = message
    return result

fn RustCsgTuiSessionCwdPromptActionCode(action: str): int32 =
    if action == "resume":
        return oracle.RustCsgTuiCwdPromptActionResume
    if action == "fork":
        return oracle.RustCsgTuiCwdPromptActionFork
    return -1

fn RustCsgTuiSessionCwdPromptSelectionCode(selection: str): int32 =
    if selection == "session":
        return oracle.RustCsgTuiCwdSelectionSession
    if selection == "current":
        return oracle.RustCsgTuiCwdSelectionCurrent
    return -1

fn RustCsgTuiSessionCwdPromptRenderState(state: var RustCsgTuiSessionCwdPromptState,
                                         width: int32) =
    state.screen = oracle.RustCsgTuiCwdPromptRender(RustCsgTuiSessionCwdPromptActionCode(state.action),
                                                    state.currentCwd,
                                                    state.sessionCwd,
                                                    RustCsgTuiSessionCwdPromptSelectionCode(state.highlighted),
                                                    width)
    state.frameCount = state.frameCount + 1

fn RustCsgTuiSessionCwdPromptInit(action: str,
                                  currentCwd: str,
                                  sessionCwd: str,
                                  width: int32): RustCsgTuiSessionCwdPromptState =
    var state: RustCsgTuiSessionCwdPromptState
    state.action = action
    state.currentCwd = currentCwd
    state.sessionCwd = sessionCwd
    state.highlighted = "session"
    RustCsgTuiSessionCwdPromptRenderState(state, width)
    return state

fn RustCsgTuiSessionCwdPromptToggle(selection: str): str =
    if selection == "session":
        return "current"
    return "session"

fn RustCsgTuiSessionCwdPromptKeyOk(key: str, ctrl: bool): RustCsgTuiSessionCwdPromptKey =
    var result: RustCsgTuiSessionCwdPromptKey
    result.ok = true
    result.key = key
    result.ctrl = ctrl
    return result

fn RustCsgTuiSessionCwdPromptParseSequence(seq: str): RustCsgTuiSessionCwdPromptKey =
    let n = strings.Len(seq)
    if n == 0:
        return RustCsgTuiSessionCwdPromptKeyOk("", false)
    if n == 1:
        let code = Int32(seq[0])
        if code == 10 || code == 13:
            return RustCsgTuiSessionCwdPromptKeyOk("Enter", false)
        if code == 27:
            return RustCsgTuiSessionCwdPromptKeyOk("Escape", false)
        if code == 3:
            return RustCsgTuiSessionCwdPromptKeyOk("C", true)
        if code == 4:
            return RustCsgTuiSessionCwdPromptKeyOk("D", true)
        if code >= 32 && code <= 126:
            return RustCsgTuiSessionCwdPromptKeyOk(strings.SliceBytes(seq, 0, 1), false)
        return RustCsgTuiSessionCwdPromptKeyOk("", false)
    if n == 3 && Int32(seq[0]) == 27 && Int32(seq[1]) == 91:
        if Int32(seq[2]) == 65:
            return RustCsgTuiSessionCwdPromptKeyOk("Up", false)
        if Int32(seq[2]) == 66:
            return RustCsgTuiSessionCwdPromptKeyOk("Down", false)
    return RustCsgTuiSessionCwdPromptKeyOk("", false)

fn RustCsgTuiSessionCwdPromptSelect(state: var RustCsgTuiSessionCwdPromptState,
                                    selection: str) =
    state.highlighted = selection
    state.selection = selection

fn RustCsgTuiSessionCwdPromptHandleKey(state: var RustCsgTuiSessionCwdPromptState,
                                       key: str,
                                       ctrl: bool) =
    if ctrl && (key == "C" || key == "c" || key == "D" || key == "d"):
        state.selection = ""
        state.shouldExit = true
        return
    if key == "Up" || key == "k":
        state.highlighted = RustCsgTuiSessionCwdPromptToggle(state.highlighted)
        return
    if key == "Down" || key == "j":
        state.highlighted = RustCsgTuiSessionCwdPromptToggle(state.highlighted)
        return
    if key == "1":
        RustCsgTuiSessionCwdPromptSelect(state, "session")
        return
    if key == "2":
        RustCsgTuiSessionCwdPromptSelect(state, "current")
        return
    if key == "Enter":
        RustCsgTuiSessionCwdPromptSelect(state, state.highlighted)
        return
    if key == "Escape":
        RustCsgTuiSessionCwdPromptSelect(state, "session")
        return

fn RustCsgTuiSessionCwdPromptDoneResult(state: var RustCsgTuiSessionCwdPromptState): RustCsgTuiSessionCwdPromptRunResult =
    var result: RustCsgTuiSessionCwdPromptRunResult
    result.ok = true
    result.screen = state.screen
    result.frameCount = state.frameCount
    if state.shouldExit:
        result.outcome = "exit"
        return result
    result.outcome = "selection"
    result.selection = state.selection
    if result.selection == "":
        result.selection = "session"
    return result

fn RustCsgTuiSessionCwdPromptRunTerminalSequences(action: str,
                                                  currentCwd: str,
                                                  sessionCwd: str,
                                                  width: int32,
                                                  sequenceStream: str): RustCsgTuiSessionCwdPromptRunResult =
    if RustCsgTuiSessionCwdPromptActionCode(action) < 0:
        return RustCsgTuiSessionCwdPromptError("unsupported cwd prompt action")
    if currentCwd == "":
        return RustCsgTuiSessionCwdPromptError("current cwd is required")
    if sessionCwd == "":
        return RustCsgTuiSessionCwdPromptError("session cwd is required")
    if width <= 0:
        return RustCsgTuiSessionCwdPromptError("cwd prompt width must be positive")

    var state = RustCsgTuiSessionCwdPromptInit(action, currentCwd, sessionCwd, width)
    var offset: int32
    let streamLen = strings.Len(sequenceStream)
    while offset < streamLen:
        var tokenEnd: int32 = offset
        while tokenEnd < streamLen && Int32(sequenceStream[tokenEnd]) != 124:
            tokenEnd = tokenEnd + 1
        let seq = strings.SliceBytes(sequenceStream, offset, tokenEnd - offset)
        let key = RustCsgTuiSessionCwdPromptParseSequence(seq)
        RustCsgTuiSessionCwdPromptHandleKey(state, key.key, key.ctrl)
        if state.shouldExit || state.selection != "":
            return RustCsgTuiSessionCwdPromptDoneResult(state)
        RustCsgTuiSessionCwdPromptRenderState(state, width)
        if tokenEnd >= streamLen:
            offset = streamLen
        else:
            offset = tokenEnd + 1
    return RustCsgTuiSessionCwdPromptDoneResult(state)
