# TUI onboarding snapshot oracle.

import std/strings
import std/strutils as strutil

fn RustCsgTuiOnboardingSpaces(count: int32): str =
    var out: str = ""
    var i: int32 = 0
    while i < count:
        out = strings.ConcatStr(out, " ")
        i = i + 1
    return out

fn RustCsgTuiOnboardingTrustDirectoryGitRepoFixture(): str =
    return strutil.Join([
        "> You are in /workspace/project\n",
        "\n",
        "  Do you trust the contents of this directory? Working with untrusted\n",
        "  contents comes with higher risk of prompt injection.\n",
        "\n",
        "› 1. Yes, continue",
        RustCsgTuiOnboardingSpaces(52),
        "\n",
        "  2. No, quit\n",
        "\n",
        "  Press enter to continue\n",
    ], "")
