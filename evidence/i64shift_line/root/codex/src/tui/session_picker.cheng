import std/strings
import std/strutils as strutil
import cheng/codex/state/state_db_sqlite as picker_state_db
import cheng/codex/tui/input as tuiinput
import cheng/codex/tui/key_hint as keyhint
import cheng/codex/tui/resume_oracle as picker_resume

type
    RustCsgTuiSessionPickerRenderResult =
        ok: bool
        rowCount: int32
        selectedThreadId: str
        screen: str
        error: str

    RustCsgTuiSessionPickerSelectionResult =
        ok: bool
        rowCount: int32
        kind: str
        threadId: str
        path: str
        displayLabel: str
        error: str

    RustCsgTuiSessionPickerEventResult =
        ok: bool
        okI: int32
        rowCount: int32
        selectedIndex: int32
        query: str
        dense: bool
        denseI: int32
        selectionKind: str
        threadId: str
        path: str
        displayLabel: str
        effect: str
        needsReload: bool
        needsReloadI: int32
        needsRender: bool
        needsRenderI: int32
        error: str

    RustCsgTuiSessionPickerScriptEventResult =
        ok: bool
        okI: int32
        event: keyhint.RustCsgTuiKeyEvent
        isChar: bool
        key: str
        charCode: int32
        ctrl: bool
        alt: bool
        shift: bool
        kind: int32
        error: str

    RustCsgTuiSessionPickerRunResult =
        ok: bool
        okI: int32
        rowCount: int32
        selectedIndex: int32
        query: str
        dense: bool
        denseI: int32
        selectionKind: str
        threadId: str
        path: str
        displayLabel: str
        effect: str
        screen: str
        frameCount: int32
        error: str

fn RustCsgTuiSessionPickerCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

fn RustCsgTuiSessionPickerError(message: str): RustCsgTuiSessionPickerRenderResult =
    var result: RustCsgTuiSessionPickerRenderResult
    result.error = message
    return result

fn RustCsgTuiSessionPickerSelectionError(message: str): RustCsgTuiSessionPickerSelectionResult =
    var result: RustCsgTuiSessionPickerSelectionResult
    result.error = message
    return result

fn RustCsgTuiSessionPickerEventError(message: str): RustCsgTuiSessionPickerEventResult =
    var result: RustCsgTuiSessionPickerEventResult
    result.error = message
    return result

fn RustCsgTuiSessionPickerScriptEventError(message: str): RustCsgTuiSessionPickerScriptEventResult =
    var result: RustCsgTuiSessionPickerScriptEventResult
    result.error = message
    return result

fn RustCsgTuiSessionPickerRunError(message: str): RustCsgTuiSessionPickerRunResult =
    var result: RustCsgTuiSessionPickerRunResult
    result.error = message
    return result

fn RustCsgTuiSessionPickerActionValid(action: str): bool =
    return action == "resume" || action == "fork"

fn RustCsgTuiSessionPickerEventBase(rowCount: int32,
                                    selectedIndex: int32,
                                    query: str,
                                    dense: bool): RustCsgTuiSessionPickerEventResult =
    var result: RustCsgTuiSessionPickerEventResult
    result.ok = true
    result.okI = 1
    result.rowCount = rowCount
    result.selectedIndex = selectedIndex
    result.query = query
    result.dense = dense
    result.denseI = dense ? 1 : 0
    result.selectionKind = "none"
    return result

fn RustCsgTuiSessionPickerAsciiSpace(ch: char): bool =
    return ch == ' ' || ch == '\n' || ch == '\r' || ch == '\t'

const RustCsgTuiSessionPickerPrintableAsciiTable: str = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

fn RustCsgTuiSessionPickerAsciiChar(code: int32): str =
    if code < 32 || code > 126:
        return ""
    return strings.SliceBytes(RustCsgTuiSessionPickerPrintableAsciiTable, code - 32, 1)

fn RustCsgTuiSessionPickerAsciiLowerCode(code: int32): int32 =
    if code >= 65 && code <= 90:
        return code + 32
    return code

fn RustCsgTuiSessionPickerInputKeyName(key: str): str =
    if key == tuiinput.RustCsgTuiKeyEscape:
        return keyhint.RustCsgTuiKeyEscape
    if key == tuiinput.RustCsgTuiKeyEnter:
        return keyhint.RustCsgTuiKeyEnter
    if key == tuiinput.RustCsgTuiKeyTab:
        return keyhint.RustCsgTuiKeyTab
    if key == tuiinput.RustCsgTuiKeyBackTab:
        return "BackTab"
    if key == tuiinput.RustCsgTuiKeyBackspace:
        return keyhint.RustCsgTuiKeyBackspace
    if key == tuiinput.RustCsgTuiKeyDelete:
        return keyhint.RustCsgTuiKeyDelete
    if key == tuiinput.RustCsgTuiKeyHome:
        return keyhint.RustCsgTuiKeyHome
    if key == tuiinput.RustCsgTuiKeyEnd:
        return keyhint.RustCsgTuiKeyEnd
    if key == tuiinput.RustCsgTuiKeyInsert:
        return keyhint.RustCsgTuiKeyInsert
    if key == tuiinput.RustCsgTuiKeyPageUp:
        return keyhint.RustCsgTuiKeyPageUp
    if key == tuiinput.RustCsgTuiKeyPageDown:
        return keyhint.RustCsgTuiKeyPageDown
    if key == tuiinput.RustCsgTuiKeyUp:
        return keyhint.RustCsgTuiKeyUp
    if key == tuiinput.RustCsgTuiKeyDown:
        return keyhint.RustCsgTuiKeyDown
    if key == tuiinput.RustCsgTuiKeyLeft:
        return keyhint.RustCsgTuiKeyLeft
    if key == tuiinput.RustCsgTuiKeyRight:
        return keyhint.RustCsgTuiKeyRight
    return key

fn RustCsgTuiSessionPickerEventFromInput(inputEvent: tuiinput.RustCsgTuiKeyEvent): keyhint.RustCsgTuiKeyEvent =
    let key = inputEvent.key
    if strings.Len(key) == 1:
        var code = Int32(key[0])
        if inputEvent.ctrl:
            code = RustCsgTuiSessionPickerAsciiLowerCode(code)
        return keyhint.RustCsgTuiKeyEventChar(code,
                                              inputEvent.ctrl,
                                              inputEvent.alt,
                                              inputEvent.shift,
                                              keyhint.RustCsgTuiKeyEventKindPress)
    return keyhint.RustCsgTuiKeyEventNamed(RustCsgTuiSessionPickerInputKeyName(key),
                                           inputEvent.ctrl,
                                           inputEvent.alt,
                                           inputEvent.shift,
                                           keyhint.RustCsgTuiKeyEventKindPress)

fn RustCsgTuiSessionPickerScriptFromInput(inputEvent: tuiinput.RustCsgTuiKeyEvent): RustCsgTuiSessionPickerScriptEventResult =
    let key = inputEvent.key
    if strings.Len(key) == 1:
        var code = Int32(key[0])
        if inputEvent.ctrl:
            code = RustCsgTuiSessionPickerAsciiLowerCode(code)
        return RustCsgTuiSessionPickerScriptChar(code, inputEvent.ctrl, inputEvent.alt, inputEvent.shift)
    return RustCsgTuiSessionPickerScriptNamed(RustCsgTuiSessionPickerInputKeyName(key))

fn RustCsgTuiSessionPickerParseTerminalSequence(seq: str): RustCsgTuiSessionPickerScriptEventResult =
    let n = strings.Len(seq)
    if n == 0:
        return RustCsgTuiSessionPickerScriptEventError("session picker terminal sequence must be non-empty")
    if n == 1:
        let code = Int32(seq[0])
        if code == 10 || code == 13:
            return RustCsgTuiSessionPickerScriptNamed(keyhint.RustCsgTuiKeyEnter)
        if code == 27:
            return RustCsgTuiSessionPickerScriptNamed(keyhint.RustCsgTuiKeyEsc)
        if code >= 1 && code <= 26:
            return RustCsgTuiSessionPickerScriptChar(code + 96, true, false, false)
        if code == 127:
            return RustCsgTuiSessionPickerScriptNamed(keyhint.RustCsgTuiKeyBackspace)
        if code >= 32 && code <= 126:
            return RustCsgTuiSessionPickerScriptChar(code, false, false, false)
        return RustCsgTuiSessionPickerScriptNamed("Null")
    if n == 3 && Int32(seq[0]) == 27 && Int32(seq[1]) == 91:
        if Int32(seq[2]) == 65:
            return RustCsgTuiSessionPickerScriptNamed(keyhint.RustCsgTuiKeyUp)
        if Int32(seq[2]) == 66:
            return RustCsgTuiSessionPickerScriptNamed(keyhint.RustCsgTuiKeyDown)
        if Int32(seq[2]) == 67:
            return RustCsgTuiSessionPickerScriptNamed(keyhint.RustCsgTuiKeyRight)
        if Int32(seq[2]) == 68:
            return RustCsgTuiSessionPickerScriptNamed(keyhint.RustCsgTuiKeyLeft)
        if Int32(seq[2]) == 72:
            return RustCsgTuiSessionPickerScriptNamed(keyhint.RustCsgTuiKeyHome)
        if Int32(seq[2]) == 70:
            return RustCsgTuiSessionPickerScriptNamed(keyhint.RustCsgTuiKeyEnd)
        if Int32(seq[2]) == 90:
            return RustCsgTuiSessionPickerScriptNamed("BackTab")
    return RustCsgTuiSessionPickerScriptNamed("Null")

fn RustCsgTuiSessionPickerPopAscii(text: str): str =
    if text.len <= 0:
        return text
    return strings.SliceBytes(text, 0, text.len - 1)

fn RustCsgTuiSessionPickerEventIsPress(event: var keyhint.RustCsgTuiKeyEvent): bool =
    return event.kind == keyhint.RustCsgTuiKeyEventKindPress || event.kind == keyhint.RustCsgTuiKeyEventKindRepeat

fn RustCsgTuiSessionPickerKindIsPress(kind: int32): bool =
    return kind == keyhint.RustCsgTuiKeyEventKindPress || kind == keyhint.RustCsgTuiKeyEventKindRepeat

fn RustCsgTuiSessionPickerKeyParts(isChar: bool,
                                   key: str,
                                   charCode: int32,
                                   ctrl: bool,
                                   alt: bool,
                                   shift: bool): keyhint.RustCsgTuiKeyParts =
    if isChar:
        return keyhint.RustCsgTuiKeyPartsChar(charCode, ctrl, alt, shift)
    return keyhint.RustCsgTuiKeyPartsNamed(key, ctrl, alt, shift)

fn RustCsgTuiSessionPickerIsPlainTextKey(isChar: bool, charCode: int32, ctrl: bool, alt: bool): bool =
    if !isChar: return false
    if ctrl || alt: return false
    if charCode < 32 || charCode == 127: return false
    return true

fn RustCsgTuiSessionPickerNormIsCtrlChar(parts: keyhint.RustCsgTuiKeyParts, code: int32): bool =
    return parts.isChar && parts.ctrl && !parts.alt && parts.charCode == code

fn RustCsgTuiSessionPickerNormIsNamed(parts: keyhint.RustCsgTuiKeyParts, key: str): bool =
    return !parts.isChar && parts.key == key

fn RustCsgTuiSessionPickerNormKeyIsCtrlChar(isChar: bool, charCode: int32, ctrl: bool, alt: bool, code: int32): bool =
    return isChar && ctrl && !alt && charCode == code

fn RustCsgTuiSessionPickerNormKeyIsNamed(isChar: bool, key: str, expected: str): bool =
    return !isChar && key == expected

fn RustCsgTuiSessionPickerValidateReducerState(rowCount: int32, selectedIndex: int32): str =
    if selectedIndex < 0:
        return "session picker selected index out of range"
    if rowCount == 0:
        if selectedIndex != 0:
            return "session picker selected index out of range"
        return ""
    if selectedIndex >= rowCount:
        return "session picker selected index out of range"
    return ""

fn RustCsgTuiSessionPickerTrim(text: str): str =
    var start: int32
    var end: int32
    end = text.len
    while start < end && RustCsgTuiSessionPickerAsciiSpace(text[start]):
        start = start + 1
    while end > start && RustCsgTuiSessionPickerAsciiSpace(text[end - 1]):
        end = end - 1
    return strings.SliceBytes(text, start, end - start)

fn RustCsgTuiSessionPickerDisplayTitle(row: var picker_state_db.RustCsgStateDbThreadRowResult): str =
    let title = RustCsgTuiSessionPickerTrim(row.title)
    let firstUserMessage = RustCsgTuiSessionPickerTrim(row.firstUserMessage)
    if title != "" && title != firstUserMessage:
        return title
    if firstUserMessage != "":
        return firstUserMessage
    return "(no message yet)"

fn RustCsgTuiSessionPickerSmallInt64Text(value: int64): str =
    if value > int64(2147483647):
        return strings.IntToStr(2147483647)
    if value < int64(-2147483647):
        return strings.IntToStr(-2147483647)
    return strings.IntToStr(Int32(value))

fn RustCsgTuiSessionPickerRelativeTime(nowMs: int64, timestampMs: int64): str =
    if timestampMs <= int64(0):
        return "-"
    var diffMs: int64
    diffMs = nowMs - timestampMs
    if diffMs < int64(0):
        diffMs = int64(0)
    let seconds = diffMs / int64(1000)
    if seconds == int64(0):
        return "now"
    if seconds < int64(60):
        return strutil.Join([RustCsgTuiSessionPickerSmallInt64Text(seconds), "s ago"], "")
    let minutes = seconds / int64(60)
    if minutes < int64(60):
        return strutil.Join([RustCsgTuiSessionPickerSmallInt64Text(minutes), "m ago"], "")
    let hours = minutes / int64(60)
    if hours < int64(24):
        return strutil.Join([RustCsgTuiSessionPickerSmallInt64Text(hours), "h ago"], "")
    let days = hours / int64(24)
    return strutil.Join([RustCsgTuiSessionPickerSmallInt64Text(days), "d ago"], "")

fn RustCsgTuiSessionPickerRowDate(row: var picker_state_db.RustCsgStateDbThreadRowResult,
                                  sortKey: str,
                                  nowMs: int64): str =
    if sortKey == "created_at":
        return RustCsgTuiSessionPickerRelativeTime(nowMs, row.createdAtMs)
    return RustCsgTuiSessionPickerRelativeTime(nowMs, row.updatedAtMs)

fn RustCsgTuiSessionPickerHeader(action: str): str =
    if action == "fork":
        return "Fork a previous session"
    return "Resume a previous session"

fn RustCsgTuiSessionPickerSelectionKind(action: str): str =
    if action == "fork":
        return "fork"
    return "resume"

fn RustCsgTuiSessionPickerPercent(selectedIndex: int32, rowCount: int32): int32 =
    if rowCount <= 0:
        return 100
    if selectedIndex <= 0:
        return 0
    if selectedIndex >= rowCount - 1:
        return 100
    return ((selectedIndex + 1) * 100) / rowCount

fn RustCsgTuiSessionPickerRenderRows(rows: picker_state_db.RustCsgStateDbThreadRowResult[],
                                     selectedIndex: int32,
                                     width: int32,
                                     dense: bool,
                                     showCwd: bool,
                                     sortKey: str,
                                     nowMs: int64): str =
    var out: str
    for i in 0..<rows.len:
        if i > 0:
            if dense:
                out = RustCsgTuiSessionPickerCat(out, "\n")
            else:
                out = RustCsgTuiSessionPickerCat(out, "\n\n")
        let selected = i == selectedIndex
        var row = rows[i]
        let title = RustCsgTuiSessionPickerDisplayTitle(row)
        let date = RustCsgTuiSessionPickerRowDate(row, sortKey, nowMs)
        if dense:
            out = RustCsgTuiSessionPickerCat(out, picker_resume.RustCsgTuiResumeRenderDenseSummaryLine(selected, false, date, title, width))
        else:
            out = RustCsgTuiSessionPickerCat(out, picker_resume.RustCsgTuiResumeRenderComfortableSession(title, date, row.cwd, "", showCwd, selected, false, width))
    return RustCsgTuiSessionPickerCat(out, "\n")

fn RustCsgTuiSessionPickerRenderStateRows(rows: picker_state_db.RustCsgStateDbThreadRowResult[],
                                          action: str,
                                          width: int32,
                                          listHeight: int32,
                                          selectedIndex: int32,
                                          dense: bool,
                                          showCwd: bool,
                                          query: str,
                                          sortKey: str,
                                          nowMs: int64): RustCsgTuiSessionPickerRenderResult =
    if !RustCsgTuiSessionPickerActionValid(action):
        return RustCsgTuiSessionPickerError("session picker action must be resume or fork")
    if width <= 0:
        return RustCsgTuiSessionPickerError("session picker width must be positive")
    if listHeight < 0:
        return RustCsgTuiSessionPickerError("session picker list height must be non-negative")
    if rows.len == 0:
        var emptyResult: RustCsgTuiSessionPickerRenderResult
        emptyResult.ok = true
        emptyResult.rowCount = 0
        emptyResult.screen = strutil.Join([
            RustCsgTuiSessionPickerHeader(action),
            "",
            picker_resume.RustCsgTuiResumeRenderSearchLine(width, query, showCwd, sortKey != "created_at"),
            "",
            "No sessions yet",
            "",
            picker_resume.RustCsgTuiResumeRenderFooterSnapshot(width, listHeight, 0, 0, 100, query, dense)
        ], "\n")
        return emptyResult
    if selectedIndex < 0 || selectedIndex >= rows.len:
        return RustCsgTuiSessionPickerError("session picker selected index out of range")
    let percent = RustCsgTuiSessionPickerPercent(selectedIndex, rows.len)
    let rowsText = RustCsgTuiSessionPickerRenderRows(rows, selectedIndex, width, dense, showCwd, sortKey, nowMs)
    var selectedRow = rows[selectedIndex]
    var result: RustCsgTuiSessionPickerRenderResult
    result.ok = true
    result.rowCount = rows.len
    result.selectedThreadId = selectedRow.id
    result.screen = strutil.Join([
        RustCsgTuiSessionPickerHeader(action),
        "",
        picker_resume.RustCsgTuiResumeRenderSearchLine(width, query, showCwd, sortKey != "created_at"),
        "",
        rowsText,
        picker_resume.RustCsgTuiResumeRenderFooterSnapshot(width, listHeight, selectedIndex + 1, rows.len, percent, query, dense)
    ], "\n")
    return result

fn RustCsgTuiSessionPickerRenderFromStateDb(dbPath: str,
                                            action: str,
                                            width: int32,
                                            listHeight: int32,
                                            selectedIndex: int32,
                                            dense: bool,
                                            showCwd: bool,
                                            query: str,
                                            cwdFilter: str,
                                            sortKey: str,
                                            nowMs: int64,
                                            limit: int32): RustCsgTuiSessionPickerRenderResult =
    if sortKey != "updated_at" && sortKey != "created_at":
        return RustCsgTuiSessionPickerError("session picker sort key must be updated_at or created_at")
    if limit < 1:
        return RustCsgTuiSessionPickerError("session picker limit must be positive")
    let page = picker_state_db.RustCsgStateDbVisiblePageRowsFilteredDynamicWithCwd(
        dbPath,
        sortKey,
        "desc",
        false,
        "",
        "",
        cwdFilter,
        query,
        "",
        limit
    )
    if !page.ok:
        return RustCsgTuiSessionPickerError(page.error)
    return RustCsgTuiSessionPickerRenderStateRows(page.rows,
                                                  action,
                                                  width,
                                                  listHeight,
                                                  selectedIndex,
                                                  dense,
                                                  showCwd,
                                                  query,
                                                  sortKey,
                                                  nowMs)

fn RustCsgTuiSessionPickerSelectStateRows(rows: picker_state_db.RustCsgStateDbThreadRowResult[],
                                          action: str,
                                          selectedIndex: int32): RustCsgTuiSessionPickerSelectionResult =
    if !RustCsgTuiSessionPickerActionValid(action):
        return RustCsgTuiSessionPickerSelectionError("session picker action must be resume or fork")
    if rows.len == 0:
        return RustCsgTuiSessionPickerSelectionError("session picker has no selectable rows")
    if selectedIndex < 0 || selectedIndex >= rows.len:
        return RustCsgTuiSessionPickerSelectionError("session picker selected index out of range")
    var row = rows[selectedIndex]
    if row.id == "":
        return RustCsgTuiSessionPickerSelectionError("session picker selected row has no thread id")
    var result: RustCsgTuiSessionPickerSelectionResult
    result.ok = true
    result.rowCount = rows.len
    result.kind = RustCsgTuiSessionPickerSelectionKind(action)
    result.threadId = row.id
    result.path = row.rolloutPath
    if row.rolloutPath != "":
        result.displayLabel = row.rolloutPath
    else:
        result.displayLabel = strutil.Join(["thread ", row.id], "")
    return result

fn RustCsgTuiSessionPickerIndexOfThread(rows: picker_state_db.RustCsgStateDbThreadRowResult[],
                                        threadId: str): int32 =
    if threadId == "":
        return -1
    for i in 0..<rows.len:
        var row = rows[i]
        if row.id == threadId:
            return i
    return -1

fn RustCsgTuiSessionPickerAcceptEvent(rows: picker_state_db.RustCsgStateDbThreadRowResult[],
                                      action: str,
                                      selectedIndex: int32,
                                      query: str,
                                      dense: bool): RustCsgTuiSessionPickerEventResult =
    var result = RustCsgTuiSessionPickerEventBase(rows.len, selectedIndex, query, dense)
    if rows.len == 0:
        return result
    let selection = RustCsgTuiSessionPickerSelectStateRows(rows, action, selectedIndex)
    if !selection.ok:
        return RustCsgTuiSessionPickerEventError(selection.error)
    result.selectionKind = selection.kind
    result.threadId = selection.threadId
    result.path = selection.path
    result.displayLabel = selection.displayLabel
    return result

fn RustCsgTuiSessionPickerScriptNamed(key: str): RustCsgTuiSessionPickerScriptEventResult =
    var result: RustCsgTuiSessionPickerScriptEventResult
    result.ok = true
    result.okI = 1
    result.event = keyhint.RustCsgTuiKeyEventNamed(key, false, false, false, keyhint.RustCsgTuiKeyEventKindPress)
    result.isChar = false
    result.key = key
    result.charCode = -1
    result.ctrl = false
    result.alt = false
    result.shift = false
    result.kind = keyhint.RustCsgTuiKeyEventKindPress
    return result

fn RustCsgTuiSessionPickerScriptChar(code: int32, ctrl: bool, alt: bool, shift: bool): RustCsgTuiSessionPickerScriptEventResult =
    var result: RustCsgTuiSessionPickerScriptEventResult
    result.ok = true
    result.okI = 1
    result.event = keyhint.RustCsgTuiKeyEventChar(code, ctrl, alt, shift, keyhint.RustCsgTuiKeyEventKindPress)
    result.isChar = true
    result.key = ""
    result.charCode = code
    result.ctrl = ctrl
    result.alt = alt
    result.shift = shift
    result.kind = keyhint.RustCsgTuiKeyEventKindPress
    return result

fn RustCsgTuiSessionPickerParseScriptToken(token: str): RustCsgTuiSessionPickerScriptEventResult =
    if token == "":
        return RustCsgTuiSessionPickerScriptEventError("session picker script token must be non-empty")
    if token == "enter":
        return RustCsgTuiSessionPickerScriptNamed(keyhint.RustCsgTuiKeyEnter)
    if token == "esc" || token == "escape":
        return RustCsgTuiSessionPickerScriptNamed(keyhint.RustCsgTuiKeyEsc)
    if token == "tab":
        return RustCsgTuiSessionPickerScriptNamed(keyhint.RustCsgTuiKeyTab)
    if token == "backtab":
        return RustCsgTuiSessionPickerScriptNamed("BackTab")
    if token == "backspace":
        return RustCsgTuiSessionPickerScriptNamed(keyhint.RustCsgTuiKeyBackspace)
    if token == "up":
        return RustCsgTuiSessionPickerScriptNamed(keyhint.RustCsgTuiKeyUp)
    if token == "down":
        return RustCsgTuiSessionPickerScriptNamed(keyhint.RustCsgTuiKeyDown)
    if token == "left":
        return RustCsgTuiSessionPickerScriptNamed(keyhint.RustCsgTuiKeyLeft)
    if token == "right":
        return RustCsgTuiSessionPickerScriptNamed(keyhint.RustCsgTuiKeyRight)
    if token == "home":
        return RustCsgTuiSessionPickerScriptNamed(keyhint.RustCsgTuiKeyHome)
    if token == "end":
        return RustCsgTuiSessionPickerScriptNamed(keyhint.RustCsgTuiKeyEnd)
    if token == "page_up" || token == "pgup":
        return RustCsgTuiSessionPickerScriptNamed(keyhint.RustCsgTuiKeyPageUp)
    if token == "page_down" || token == "pgdn":
        return RustCsgTuiSessionPickerScriptNamed(keyhint.RustCsgTuiKeyPageDown)
    if token == "space":
        return RustCsgTuiSessionPickerScriptChar(32, false, false, false)
    if strings.Len(token) == 6 && strings.SliceBytes(token, 0, 5) == "char:":
        return RustCsgTuiSessionPickerScriptChar(Int32(token[5]), false, false, false)
    if strings.Len(token) == 6 && strings.SliceBytes(token, 0, 5) == "ctrl:":
        let code = RustCsgTuiSessionPickerAsciiLowerCode(Int32(token[5]))
        if code < 32 || code > 126:
            return RustCsgTuiSessionPickerScriptEventError("session picker script ctrl token must use printable ASCII")
        return RustCsgTuiSessionPickerScriptChar(code, true, false, false)
    if strings.Len(token) == 5 && strings.SliceBytes(token, 0, 4) == "alt:":
        return RustCsgTuiSessionPickerScriptChar(Int32(token[4]), false, true, false)
    return RustCsgTuiSessionPickerScriptEventError(strutil.Join(["unsupported session picker script token: ", token], ""))

fn RustCsgTuiSessionPickerReduceStateRowsKey(rows: picker_state_db.RustCsgStateDbThreadRowResult[],
                                             action: str,
                                             selectedIndex: int32,
                                             query: str,
                                             dense: bool,
                                             viewRows: int32,
                                             isChar: bool,
                                             key: str,
                                             charCode: int32,
                                             ctrl: bool,
                                             alt: bool,
                                             shift: bool,
                                             kind: int32): RustCsgTuiSessionPickerEventResult =
    if !RustCsgTuiSessionPickerActionValid(action):
        return RustCsgTuiSessionPickerEventError("session picker action must be resume or fork")
    let stateError = RustCsgTuiSessionPickerValidateReducerState(rows.len, selectedIndex)
    if stateError != "":
        return RustCsgTuiSessionPickerEventError(stateError)
    var result = RustCsgTuiSessionPickerEventBase(rows.len, selectedIndex, query, dense)
    if !RustCsgTuiSessionPickerKindIsPress(kind):
        return result

    var normIsChar = isChar
    var normKey = key
    var normCharCode = charCode
    var normCtrl = ctrl
    var normAlt = alt
    var normShift = shift
    if isChar && !ctrl && !alt && !shift:
        let ctrlChar: int32 = keyhint.RustCsgTuiC0ControlCharToCtrlChar(charCode)
        if ctrlChar >= 0:
            normCharCode = ctrlChar
            normCtrl = true
    if isChar && charCode >= 65 && charCode <= 90:
        normCharCode = charCode + 32
        normShift = true
    let step = viewRows < 1 ? 1 : viewRows
    let allowPlainCharNavigation = !RustCsgTuiSessionPickerIsPlainTextKey(isChar, charCode, ctrl, alt)

    if RustCsgTuiSessionPickerNormKeyIsCtrlChar(normIsChar, normCharCode, normCtrl, normAlt, 99):
        result.selectionKind = "exit"
        return result

    if RustCsgTuiSessionPickerNormKeyIsNamed(normIsChar, normKey, keyhint.RustCsgTuiKeyEsc) || RustCsgTuiSessionPickerNormKeyIsNamed(normIsChar, normKey, keyhint.RustCsgTuiKeyEscape):
        result.selectionKind = "start_fresh"
        return result

    if RustCsgTuiSessionPickerNormKeyIsCtrlChar(normIsChar, normCharCode, normCtrl, normAlt, 111):
        result.dense = !dense
        result.denseI = dense ? 0 : 1
        result.needsRender = true
        result.needsRenderI = 1
        return result

    if RustCsgTuiSessionPickerNormKeyIsCtrlChar(normIsChar, normCharCode, normCtrl, normAlt, 116):
        result.effect = "open_transcript"
        result.needsRender = true
        result.needsRenderI = 1
        return result

    if RustCsgTuiSessionPickerNormKeyIsCtrlChar(normIsChar, normCharCode, normCtrl, normAlt, 101):
        result.effect = "toggle_expansion"
        result.needsRender = true
        result.needsRenderI = 1
        return result

    if RustCsgTuiSessionPickerNormKeyIsNamed(normIsChar, normKey, keyhint.RustCsgTuiKeyEnter):
        let accepted = RustCsgTuiSessionPickerAcceptEvent(rows, action, selectedIndex, query, dense)
        return accepted

    if allowPlainCharNavigation && (RustCsgTuiSessionPickerNormKeyIsNamed(normIsChar, normKey, keyhint.RustCsgTuiKeyUp) || RustCsgTuiSessionPickerNormKeyIsCtrlChar(normIsChar, normCharCode, normCtrl, normAlt, 112) || RustCsgTuiSessionPickerNormKeyIsCtrlChar(normIsChar, normCharCode, normCtrl, normAlt, 107)):
        if selectedIndex > 0:
            result.selectedIndex = selectedIndex - 1
            result.needsRender = true
            result.needsRenderI = 1
        return result

    if allowPlainCharNavigation && (RustCsgTuiSessionPickerNormKeyIsNamed(normIsChar, normKey, keyhint.RustCsgTuiKeyDown) || RustCsgTuiSessionPickerNormKeyIsCtrlChar(normIsChar, normCharCode, normCtrl, normAlt, 110) || RustCsgTuiSessionPickerNormKeyIsCtrlChar(normIsChar, normCharCode, normCtrl, normAlt, 106)):
        if selectedIndex + 1 < rows.len:
            result.selectedIndex = selectedIndex + 1
            result.needsRender = true
            result.needsRenderI = 1
        return result

    if allowPlainCharNavigation && (RustCsgTuiSessionPickerNormKeyIsNamed(normIsChar, normKey, keyhint.RustCsgTuiKeyPageUp) || RustCsgTuiSessionPickerNormKeyIsCtrlChar(normIsChar, normCharCode, normCtrl, normAlt, 98)):
        if selectedIndex > 0:
            var target = selectedIndex - step
            if target < 0:
                target = 0
            result.selectedIndex = target
            result.needsRender = true
            result.needsRenderI = 1
        return result

    if allowPlainCharNavigation && (RustCsgTuiSessionPickerNormKeyIsNamed(normIsChar, normKey, keyhint.RustCsgTuiKeyPageDown) || RustCsgTuiSessionPickerNormKeyIsCtrlChar(normIsChar, normCharCode, normCtrl, normAlt, 102)):
        if rows.len > 0:
            var target = selectedIndex + step
            let maxIndex = rows.len - 1
            if target > maxIndex:
                target = maxIndex
            result.selectedIndex = target
            result.needsRender = true
            result.needsRenderI = 1
        return result

    if allowPlainCharNavigation && RustCsgTuiSessionPickerNormKeyIsNamed(normIsChar, normKey, keyhint.RustCsgTuiKeyHome):
        if rows.len > 0:
            result.selectedIndex = 0
            result.needsRender = true
            result.needsRenderI = 1
        return result

    if allowPlainCharNavigation && RustCsgTuiSessionPickerNormKeyIsNamed(normIsChar, normKey, keyhint.RustCsgTuiKeyEnd):
        if rows.len > 0:
            result.selectedIndex = rows.len - 1
            result.needsRender = true
            result.needsRenderI = 1
        return result

    if RustCsgTuiSessionPickerNormKeyIsNamed(normIsChar, normKey, keyhint.RustCsgTuiKeyTab):
        result.effect = "toolbar_next"
        result.needsRender = true
        result.needsRenderI = 1
        return result

    if RustCsgTuiSessionPickerNormKeyIsNamed(normIsChar, normKey, "BackTab"):
        result.effect = "toolbar_previous"
        result.needsRender = true
        result.needsRenderI = 1
        return result

    if allowPlainCharNavigation && (RustCsgTuiSessionPickerNormKeyIsNamed(normIsChar, normKey, keyhint.RustCsgTuiKeyLeft) || RustCsgTuiSessionPickerNormKeyIsNamed(normIsChar, normKey, keyhint.RustCsgTuiKeyRight) || RustCsgTuiSessionPickerNormKeyIsCtrlChar(normIsChar, normCharCode, normCtrl, normAlt, 104) || RustCsgTuiSessionPickerNormKeyIsCtrlChar(normIsChar, normCharCode, normCtrl, normAlt, 108)):
        result.effect = "toolbar_change"
        result.needsRender = true
        result.needsRenderI = 1
        return result

    if RustCsgTuiSessionPickerNormKeyIsNamed(normIsChar, normKey, keyhint.RustCsgTuiKeyBackspace):
        let nextQuery = RustCsgTuiSessionPickerPopAscii(query)
        if nextQuery != query:
            result.query = nextQuery
            result.selectedIndex = 0
            result.needsReload = true
            result.needsReloadI = 1
            result.needsRender = true
            result.needsRenderI = 1
        return result

    if RustCsgTuiSessionPickerIsPlainTextKey(isChar, charCode, ctrl, alt):
        let typed = RustCsgTuiSessionPickerAsciiChar(charCode)
        if typed != "":
            result.query = strutil.Join([query, typed], "")
            result.selectedIndex = 0
            result.needsReload = true
            result.needsReloadI = 1
            result.needsRender = true
            result.needsRenderI = 1
        return result

    return result

fn RustCsgTuiSessionPickerReduceStateRows(rows: picker_state_db.RustCsgStateDbThreadRowResult[],
                                          action: str,
                                          selectedIndex: int32,
                                          query: str,
                                          dense: bool,
                                          viewRows: int32,
                                          event: var keyhint.RustCsgTuiKeyEvent): RustCsgTuiSessionPickerEventResult =
    return RustCsgTuiSessionPickerReduceStateRowsKey(rows,
                                                     action,
                                                     selectedIndex,
                                                     query,
                                                     dense,
                                                     viewRows,
                                                     event.parts.isChar,
                                                     event.parts.key,
                                                     event.parts.charCode,
                                                     event.parts.ctrl,
                                                     event.parts.alt,
                                                     event.parts.shift,
                                                     event.kind)

fn RustCsgTuiSessionPickerSelectFromStateDb(dbPath: str,
                                            action: str,
                                            selectedIndex: int32,
                                            query: str,
                                            cwdFilter: str,
                                            sortKey: str,
                                            limit: int32): RustCsgTuiSessionPickerSelectionResult =
    if sortKey != "updated_at" && sortKey != "created_at":
        return RustCsgTuiSessionPickerSelectionError("session picker sort key must be updated_at or created_at")
    if limit < 1:
        return RustCsgTuiSessionPickerSelectionError("session picker limit must be positive")
    let page = picker_state_db.RustCsgStateDbVisiblePageRowsFilteredDynamicWithCwd(
        dbPath,
        sortKey,
        "desc",
        false,
        "",
        "",
        cwdFilter,
        query,
        "",
        limit
    )
    if !page.ok:
        return RustCsgTuiSessionPickerSelectionError(page.error)
    return RustCsgTuiSessionPickerSelectStateRows(page.rows, action, selectedIndex)

fn RustCsgTuiSessionPickerReduceFromStateDbKey(dbPath: str,
                                               action: str,
                                               selectedIndex: int32,
                                               query: str,
                                               cwdFilter: str,
                                               sortKey: str,
                                               limit: int32,
                                               dense: bool,
                                               viewRows: int32,
                                               isChar: bool,
                                               key: str,
                                               charCode: int32,
                                               ctrl: bool,
                                               alt: bool,
                                               shift: bool,
                                               kind: int32): RustCsgTuiSessionPickerEventResult =
    if sortKey != "updated_at" && sortKey != "created_at":
        return RustCsgTuiSessionPickerEventError("session picker sort key must be updated_at or created_at")
    if limit < 1:
        return RustCsgTuiSessionPickerEventError("session picker limit must be positive")
    let page = picker_state_db.RustCsgStateDbVisiblePageRowsFilteredDynamicWithCwd(
        dbPath,
        sortKey,
        "desc",
        false,
        "",
        "",
        cwdFilter,
        query,
        "",
        limit
    )
    if !page.ok:
        return RustCsgTuiSessionPickerEventError(page.error)
    let reduced = RustCsgTuiSessionPickerReduceStateRowsKey(page.rows,
                                                            action,
                                                            selectedIndex,
                                                            query,
                                                            dense,
                                                            viewRows,
                                                            isChar,
                                                            key,
                                                            charCode,
                                                            ctrl,
                                                            alt,
                                                            shift,
                                                            kind)
    if reduced.okI != 1:
        return reduced
    if query != "" && reduced.query == "" && reduced.needsReloadI == 1 && selectedIndex >= 0 && selectedIndex < page.rows.len:
        var selectedRow = page.rows[selectedIndex]
        let clearedPage = picker_state_db.RustCsgStateDbVisiblePageRowsFilteredDynamicWithCwd(
            dbPath,
            sortKey,
            "desc",
            false,
            "",
            "",
            cwdFilter,
            "",
            "",
            limit
        )
        if !clearedPage.ok:
            return RustCsgTuiSessionPickerEventError(clearedPage.error)
        var preserved = reduced
        let preservedIndex = RustCsgTuiSessionPickerIndexOfThread(clearedPage.rows, selectedRow.id)
        if preservedIndex >= 0:
            preserved.selectedIndex = preservedIndex
        preserved.rowCount = clearedPage.rows.len
        return preserved
    return reduced

fn RustCsgTuiSessionPickerReduceFromStateDb(dbPath: str,
                                            action: str,
                                            selectedIndex: int32,
                                            query: str,
                                            cwdFilter: str,
                                            sortKey: str,
                                            limit: int32,
                                            dense: bool,
                                            viewRows: int32,
                                            event: var keyhint.RustCsgTuiKeyEvent): RustCsgTuiSessionPickerEventResult =
    return RustCsgTuiSessionPickerReduceFromStateDbKey(dbPath,
                                                       action,
                                                       selectedIndex,
                                                       query,
                                                       cwdFilter,
                                                       sortKey,
                                                       limit,
                                                       dense,
                                                       viewRows,
                                                       event.parts.isChar,
                                                       event.parts.key,
                                                       event.parts.charCode,
                                                       event.parts.ctrl,
                                                       event.parts.alt,
                                                       event.parts.shift,
                                                       event.kind)

fn RustCsgTuiSessionPickerRunFromStateDb(dbPath: str,
                                         action: str,
                                         selectedIndex: int32,
                                         query: str,
                                         cwdFilter: str,
                                         sortKey: str,
                                         limit: int32,
                                         dense: bool,
                                         showCwd: bool,
                                         width: int32,
                                         listHeight: int32,
                                         viewRows: int32,
                                         script: str,
                                         nowMs: int64): RustCsgTuiSessionPickerRunResult =
    var currentSelected = selectedIndex
    var currentQuery = query
    var currentDense = dense
    var lastEffect: str

    let initialRender = RustCsgTuiSessionPickerRenderFromStateDb(dbPath,
                                                                 action,
                                                                 width,
                                                                 listHeight,
                                                                 currentSelected,
                                                                 currentDense,
                                                                 showCwd,
                                                                 currentQuery,
                                                                 cwdFilter,
                                                                 sortKey,
                                                                 nowMs,
                                                                 limit)
    if !initialRender.ok:
        return RustCsgTuiSessionPickerRunError(initialRender.error)

    var screen = initialRender.screen
    var rowCount = initialRender.rowCount
    var frameCount: int32 = 1
    var offset: int32 = 0
    let scriptLen = strings.Len(script)

    while offset < scriptLen:
        var tokenEnd: int32 = offset
        while tokenEnd < scriptLen && Int32(script[tokenEnd]) != 124:
            tokenEnd = tokenEnd + 1
        let token = strings.SliceBytes(script, offset, tokenEnd - offset)
        let parsed = RustCsgTuiSessionPickerParseScriptToken(token)
        if parsed.okI != 1:
            return RustCsgTuiSessionPickerRunError(parsed.error)

        let reduced = RustCsgTuiSessionPickerReduceFromStateDbKey(dbPath,
                                                                  action,
                                                                  currentSelected,
                                                                  currentQuery,
                                                                  cwdFilter,
                                                                  sortKey,
                                                                  limit,
                                                                  currentDense,
                                                                  viewRows,
                                                                  parsed.isChar,
                                                                  parsed.key,
                                                                  parsed.charCode,
                                                                  parsed.ctrl,
                                                                  parsed.alt,
                                                                  parsed.shift,
                                                                  parsed.kind)
        if reduced.okI != 1:
            return RustCsgTuiSessionPickerRunError(reduced.error)

        currentSelected = reduced.selectedIndex
        currentQuery = reduced.query
        currentDense = reduced.denseI == 1
        rowCount = reduced.rowCount
        if reduced.effect != "":
            lastEffect = reduced.effect

        if reduced.selectionKind != "none":
            var done: RustCsgTuiSessionPickerRunResult
            done.ok = true
            done.okI = 1
            done.rowCount = rowCount
            done.selectedIndex = currentSelected
            done.query = currentQuery
            done.dense = currentDense
            done.denseI = currentDense ? 1 : 0
            done.selectionKind = reduced.selectionKind
            done.threadId = reduced.threadId
            done.path = reduced.path
            done.displayLabel = reduced.displayLabel
            done.effect = lastEffect
            done.screen = screen
            done.frameCount = frameCount
            return done

        let rendered = RustCsgTuiSessionPickerRenderFromStateDb(dbPath,
                                                                action,
                                                                width,
                                                                listHeight,
                                                                currentSelected,
                                                                currentDense,
                                                                showCwd,
                                                                currentQuery,
                                                                cwdFilter,
                                                                sortKey,
                                                                nowMs,
                                                                limit)
        if !rendered.ok:
            return RustCsgTuiSessionPickerRunError(rendered.error)
        screen = rendered.screen
        rowCount = rendered.rowCount
        frameCount = frameCount + 1

        if tokenEnd >= scriptLen:
            offset = scriptLen
        else:
            offset = tokenEnd + 1

    var result: RustCsgTuiSessionPickerRunResult
    result.ok = true
    result.okI = 1
    result.rowCount = rowCount
    result.selectedIndex = currentSelected
    result.query = currentQuery
    result.dense = currentDense
    result.denseI = currentDense ? 1 : 0
    result.selectionKind = "none"
    result.effect = lastEffect
    result.screen = screen
    result.frameCount = frameCount
    return result

fn RustCsgTuiSessionPickerRunTerminalSequencesFromStateDb(dbPath: str,
                                                          action: str,
                                                          selectedIndex: int32,
                                                          query: str,
                                                          cwdFilter: str,
                                                          sortKey: str,
                                                          limit: int32,
                                                          dense: bool,
                                                          showCwd: bool,
                                                          width: int32,
                                                          listHeight: int32,
                                                          viewRows: int32,
                                                          sequenceStream: str,
                                                          nowMs: int64): RustCsgTuiSessionPickerRunResult =
    var currentSelected = selectedIndex
    var currentQuery = query
    var currentDense = dense
    var lastEffect: str

    let initialRender = RustCsgTuiSessionPickerRenderFromStateDb(dbPath,
                                                                 action,
                                                                 width,
                                                                 listHeight,
                                                                 currentSelected,
                                                                 currentDense,
                                                                 showCwd,
                                                                 currentQuery,
                                                                 cwdFilter,
                                                                 sortKey,
                                                                 nowMs,
                                                                 limit)
    if !initialRender.ok:
        return RustCsgTuiSessionPickerRunError(initialRender.error)

    var screen = initialRender.screen
    var rowCount = initialRender.rowCount
    var frameCount: int32 = 1
    var offset: int32 = 0
    let streamLen = strings.Len(sequenceStream)

    while offset < streamLen:
        var tokenEnd: int32 = offset
        while tokenEnd < streamLen && Int32(sequenceStream[tokenEnd]) != 124:
            tokenEnd = tokenEnd + 1
        let seq = strings.SliceBytes(sequenceStream, offset, tokenEnd - offset)
        let parsed = RustCsgTuiSessionPickerParseTerminalSequence(seq)
        if parsed.okI != 1:
            return RustCsgTuiSessionPickerRunError(parsed.error)

        let reduced = RustCsgTuiSessionPickerReduceFromStateDbKey(dbPath,
                                                                  action,
                                                                  currentSelected,
                                                                  currentQuery,
                                                                  cwdFilter,
                                                                  sortKey,
                                                                  limit,
                                                                  currentDense,
                                                                  viewRows,
                                                                  parsed.isChar,
                                                                  parsed.key,
                                                                  parsed.charCode,
                                                                  parsed.ctrl,
                                                                  parsed.alt,
                                                                  parsed.shift,
                                                                  parsed.kind)
        if reduced.okI != 1:
            return RustCsgTuiSessionPickerRunError(reduced.error)

        currentSelected = reduced.selectedIndex
        currentQuery = reduced.query
        currentDense = reduced.denseI == 1
        rowCount = reduced.rowCount
        if reduced.effect != "":
            lastEffect = reduced.effect

        if reduced.selectionKind != "none":
            var done: RustCsgTuiSessionPickerRunResult
            done.ok = true
            done.okI = 1
            done.rowCount = rowCount
            done.selectedIndex = currentSelected
            done.query = currentQuery
            done.dense = currentDense
            done.denseI = currentDense ? 1 : 0
            done.selectionKind = reduced.selectionKind
            done.threadId = reduced.threadId
            done.path = reduced.path
            done.displayLabel = reduced.displayLabel
            done.effect = lastEffect
            done.screen = screen
            done.frameCount = frameCount
            return done

        let rendered = RustCsgTuiSessionPickerRenderFromStateDb(dbPath,
                                                                action,
                                                                width,
                                                                listHeight,
                                                                currentSelected,
                                                                currentDense,
                                                                showCwd,
                                                                currentQuery,
                                                                cwdFilter,
                                                                sortKey,
                                                                nowMs,
                                                                limit)
        if !rendered.ok:
            return RustCsgTuiSessionPickerRunError(rendered.error)
        screen = rendered.screen
        rowCount = rendered.rowCount
        frameCount = frameCount + 1

        if tokenEnd >= streamLen:
            offset = streamLen
        else:
            offset = tokenEnd + 1

    var result: RustCsgTuiSessionPickerRunResult
    result.ok = true
    result.okI = 1
    result.rowCount = rowCount
    result.selectedIndex = currentSelected
    result.query = currentQuery
    result.dense = currentDense
    result.denseI = currentDense ? 1 : 0
    result.selectionKind = "none"
    result.effect = lastEffect
    result.screen = screen
    result.frameCount = frameCount
    return result
