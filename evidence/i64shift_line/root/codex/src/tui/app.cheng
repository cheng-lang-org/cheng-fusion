# TUI application shell — main loop, state management, conversation rendering.
#
# Ported from codex-rs/tui/src/app.rs (App) and chatwidget rendering.
#
# TuiApp: manages the application state, render loop, and input dispatch.
# Includes word-wrapped conversation message rendering.

import std/strings
import std/strutils as strutil
import cheng/codex/protocol/wire
import cheng/codex/tui/app_session_install as install
import cheng/codex/tui/render as render
import cheng/codex/tui/layout as layout
import cheng/codex/tui/input as input
import cheng/codex/tui/terminal as term

# ── Conversation message type ─────────────────────────────────────────────────

type
    RustCsgTuiMessage =
        role: str          # "user" or "assistant"
        content: str       # markdown text content
        isCode: bool       # if true, content is a code block

    RustCsgTuiAppEffect =
        kind: str
        targetThreadId: str
        payloadJson: str

    RustCsgTuiAppRuntimeInstallResult =
        ok: bool
        activeThreadId: str
        chatWidgetThreadId: str
        threadStoreThreadId: str
        statusText: str
        messageCount: int32
        effectCount: int32
        pendingPrimaryEventReplayCount: int32
        pendingPrimaryRequestReplayCount: int32
        pendingPrimaryNotificationReplayCount: int32
        pendingPrimaryHistoryEntryResponseReplayCount: int32
        pendingPrimaryFeedbackSubmissionReplayCount: int32
        initialUserMessageSubmitQueued: bool
        firstFrameText: str
        effectsJson: str
        runLoopReady: bool
        error: str

# ── TuiApp type ───────────────────────────────────────────────────────────────

type
    RustCsgTuiApp =
        running: bool
        buffer: render.RustCsgTuiBuffer
        rects: layout.RustCsgTuiRect[]
        statusText: str
        inputText: str
        cursorPos: int32
        messages: RustCsgTuiMessage[]
        termWidth: int32
        termHeight: int32
        scrollOffset: int32    # number of lines scrolled up
        primaryThreadId: str
        primarySessionConfiguredJson: str
        activeThreadId: str
        threadStoreThreadId: str
        threadStoreSessionJson: str
        threadStoreTurnsJson: str
        chatWidgetThreadId: str
        chatWidgetInstructionSourcePathsJson: str
        chatReplayTranscriptText: str
        pendingPrimaryEventReplayJson: str
        pendingPrimaryEventReplayCount: int32
        pendingPrimaryRequestReplayCount: int32
        pendingPrimaryNotificationReplayCount: int32
        pendingPrimaryHistoryEntryResponseReplayCount: int32
        pendingPrimaryFeedbackSubmissionReplayCount: int32
        initialUserMessageSubmitQueued: bool
        effects: RustCsgTuiAppEffect[]
        runLoopReady: bool

# ── TuiApp API ────────────────────────────────────────────────────────────────

# Initialize a TuiApp with default terminal size (80x24).
fn RustCsgTuiAppInit(termWidth: int32, termHeight: int32): RustCsgTuiApp =
    var app: RustCsgTuiApp
    app.running = false
    app.buffer = render.RustCsgTuiBufferInit(termWidth, termHeight)
    app.rects = layout.RustCsgTuiConversationLayout(termWidth, termHeight)
    app.statusText = ""
    app.inputText = ""
    app.cursorPos = 0
    app.messages = RustCsgTuiMessage[]
    app.termWidth = termWidth
    app.termHeight = termHeight
    app.scrollOffset = 0
    app.effects = RustCsgTuiAppEffect[]
    return app

fn RustCsgTuiAppRuntimeInstallError(message: str): RustCsgTuiAppRuntimeInstallResult =
    var result: RustCsgTuiAppRuntimeInstallResult
    result.error = message
    return result

fn RustCsgTuiAppEffectToJson(effect: var RustCsgTuiAppEffect): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("kind", effect.kind))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("targetThreadId", effect.targetThreadId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("payload", effect.payloadJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgTuiAppEffectsToJson(app: var RustCsgTuiApp): str =
    var out = "["
    for i in 0..<app.effects.len:
        if i > 0:
            out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, RustCsgTuiAppEffectToJson(app.effects[i]))
    out = wire.RustCsgCat(out, "]")
    return out

fn RustCsgTuiAppAppendEffect(app: var RustCsgTuiApp,
                             kind: str,
                             targetThreadId: str,
                             payloadJson: str) =
    var effect: RustCsgTuiAppEffect
    effect.kind = kind
    effect.targetThreadId = targetThreadId
    effect.payloadJson = payloadJson
    add(app.effects, effect)

# Set the status bar text.
fn RustCsgTuiAppSetStatus(app: var RustCsgTuiApp, text: str) =
    app.statusText = text

# Add a message to the conversation.
fn RustCsgTuiAppAddMessage(app: var RustCsgTuiApp, role: str, content: str, isCode: bool) =
    var msg: RustCsgTuiMessage
    msg.role = role
    msg.content = content
    msg.isCode = isCode
    add(app.messages, msg)

# Clear all messages.
fn RustCsgTuiAppClearMessages(app: var RustCsgTuiApp) =
    app.messages = RustCsgTuiMessage[]

# Stop the application (next loop iteration will exit).
fn RustCsgTuiAppStop(app: var RustCsgTuiApp) =
    app.running = false

fn RustCsgTuiAppRuntimeInstallResultToJson(result: var RustCsgTuiAppRuntimeInstallResult): str =
    if !result.ok:
        return wire.RustCsgCat(wire.RustCsgCat("{\"ok\":false,\"error\":", wire.RustCsgJsonQuote(result.error)), "}")
    var out = "{\"ok\":true,"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("activeThreadId", result.activeThreadId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("chatWidgetThreadId", result.chatWidgetThreadId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("threadStoreThreadId", result.threadStoreThreadId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("statusText", result.statusText))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("messageCount", result.messageCount))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("effectCount", result.effectCount))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("pendingPrimaryEventReplayCount", result.pendingPrimaryEventReplayCount))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("pendingPrimaryRequestReplayCount", result.pendingPrimaryRequestReplayCount))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("pendingPrimaryNotificationReplayCount", result.pendingPrimaryNotificationReplayCount))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("pendingPrimaryHistoryEntryResponseReplayCount", result.pendingPrimaryHistoryEntryResponseReplayCount))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("pendingPrimaryFeedbackSubmissionReplayCount", result.pendingPrimaryFeedbackSubmissionReplayCount))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("initialUserMessageSubmitQueued", result.initialUserMessageSubmitQueued))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("runLoopReady", result.runLoopReady))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("effects", result.effectsJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("firstFrameText", result.firstFrameText))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgTuiAppRenderFrameText(app: var RustCsgTuiApp): str =
    RustCsgTuiAppRenderFrame(app)
    return render.RustCsgTuiBufferRender(app.buffer)

fn RustCsgTuiAppInstallPrimarySession(app: var RustCsgTuiApp,
                                      installResult: var install.RustCsgTuiAppSessionInstallResult): RustCsgTuiAppRuntimeInstallResult =
    if !installResult.ok:
        return RustCsgTuiAppRuntimeInstallError(installResult.error)
    if installResult.primaryThreadId == "":
        return RustCsgTuiAppRuntimeInstallError("primary thread id is required")
    if installResult.activeThreadId != installResult.primaryThreadId:
        return RustCsgTuiAppRuntimeInstallError("active thread mismatch")
    if installResult.threadStoreThreadId != installResult.primaryThreadId:
        return RustCsgTuiAppRuntimeInstallError("thread store thread mismatch")
    if installResult.chatWidgetThreadId != installResult.primaryThreadId:
        return RustCsgTuiAppRuntimeInstallError("chat widget thread mismatch")
    if installResult.beginInitialHistoryReplayBuffer != installResult.endInitialHistoryReplayBuffer:
        return RustCsgTuiAppRuntimeInstallError("initial history replay buffer mismatch")
    if installResult.pendingPrimaryEventReplayCount > 0 && !installResult.pendingPrimaryEventsClearedAfterReplay:
        return RustCsgTuiAppRuntimeInstallError("pending primary events not cleared")
    if installResult.initialUserMessageSubmittedAfterPendingReplay != installResult.submittedInitialUserMessage:
        return RustCsgTuiAppRuntimeInstallError("initial user message submission mismatch")

    app.primaryThreadId = installResult.primaryThreadId
    app.primarySessionConfiguredJson = installResult.primarySessionConfiguredJson
    app.activeThreadId = installResult.activeThreadId
    app.threadStoreThreadId = installResult.threadStoreThreadId
    app.threadStoreSessionJson = installResult.threadStoreSessionJson
    app.threadStoreTurnsJson = installResult.threadStoreTurnsJson
    app.chatWidgetThreadId = installResult.chatWidgetThreadId
    app.chatWidgetInstructionSourcePathsJson = installResult.chatWidgetInstructionSourcePathsJson
    app.chatReplayTranscriptText = installResult.chatReplayTranscriptText
    app.pendingPrimaryEventReplayJson = installResult.pendingPrimaryEventReplayJson
    app.pendingPrimaryEventReplayCount = installResult.pendingPrimaryEventReplayCount
    app.pendingPrimaryRequestReplayCount = installResult.pendingPrimaryRequestReplayCount
    app.pendingPrimaryNotificationReplayCount = installResult.pendingPrimaryNotificationReplayCount
    app.pendingPrimaryHistoryEntryResponseReplayCount = installResult.pendingPrimaryHistoryEntryResponseReplayCount
    app.pendingPrimaryFeedbackSubmissionReplayCount = installResult.pendingPrimaryFeedbackSubmissionReplayCount
    app.initialUserMessageSubmitQueued = installResult.submittedInitialUserMessage
    app.runLoopReady = false
    app.effects = RustCsgTuiAppEffect[]
    RustCsgTuiAppClearMessages(app)
    RustCsgTuiAppSetStatus(app, strutil.Join(["session ", installResult.primaryThreadId], ""))
    if installResult.chatReplayTranscriptText != "":
        RustCsgTuiAppAddMessage(app, "history", installResult.chatReplayTranscriptText, false)

    RustCsgTuiAppAppendEffect(app, "thread_store/install_primary", installResult.primaryThreadId, installResult.threadStoreSessionJson)
    RustCsgTuiAppAppendEffect(app, "chat_widget/handle_thread_session", installResult.primaryThreadId, installResult.primarySessionConfiguredJson)
    RustCsgTuiAppAppendEffect(app, "chat_widget/replay_thread_turns", installResult.primaryThreadId, installResult.chatReplayPlanJson)
    RustCsgTuiAppAppendEffect(app, "app/list_skills", installResult.primaryThreadId, "{\"forceReload\":true}")
    RustCsgTuiAppAppendEffect(app, "app/prefetch_connectors", installResult.primaryThreadId, "{\"reason\":\"session-install\"}")
    if installResult.pendingPrimaryEventReplayCount > 0:
        RustCsgTuiAppAppendEffect(app, "app_server/replay_pending_primary_events", installResult.primaryThreadId, installResult.pendingPrimaryEventReplayJson)
    if installResult.submittedInitialUserMessage:
        RustCsgTuiAppAppendEffect(app, "chat_widget/submit_initial_user_message", installResult.primaryThreadId, "{\"afterPendingReplay\":true}")
    RustCsgTuiAppAppendEffect(app, "app/request_redraw", installResult.primaryThreadId, "{\"reason\":\"session-install\"}")
    app.runLoopReady = true

    var result: RustCsgTuiAppRuntimeInstallResult
    result.ok = true
    result.activeThreadId = app.activeThreadId
    result.chatWidgetThreadId = app.chatWidgetThreadId
    result.threadStoreThreadId = app.threadStoreThreadId
    result.statusText = app.statusText
    result.messageCount = app.messages.len
    result.effectCount = app.effects.len
    result.pendingPrimaryEventReplayCount = app.pendingPrimaryEventReplayCount
    result.pendingPrimaryRequestReplayCount = app.pendingPrimaryRequestReplayCount
    result.pendingPrimaryNotificationReplayCount = app.pendingPrimaryNotificationReplayCount
    result.pendingPrimaryHistoryEntryResponseReplayCount = app.pendingPrimaryHistoryEntryResponseReplayCount
    result.pendingPrimaryFeedbackSubmissionReplayCount = app.pendingPrimaryFeedbackSubmissionReplayCount
    result.initialUserMessageSubmitQueued = app.initialUserMessageSubmitQueued
    result.effectsJson = RustCsgTuiAppEffectsToJson(app)
    result.firstFrameText = RustCsgTuiAppRenderFrameText(app)
    result.runLoopReady = app.runLoopReady
    return result

# ── Rendering ─────────────────────────────────────────────────────────────────

# Render the status bar into the buffer.
fn RustCsgTuiAppRenderStatus(app: var RustCsgTuiApp) =
    let statusRect = app.rects[0]
    var text: str = app.statusText
    if text.len == 0:
        text = " TUI "
    # Pad to full width
    if text.len < statusRect.width:
        let padLen: int32 = statusRect.width - text.len
        text = strutil.Join([text, render.RustCsgTuiStrRepeat(" ", padLen)], "")
    elif text.len > statusRect.width:
        text = strings.SliceBytes(text, 0, statusRect.width)
    # Write with reverse video
    render.RustCsgTuiBufferWrite(
        app.buffer,
        statusRect.x, statusRect.y,
        text,
        -1, -1, -1,   # default fg
        -1, -1, -1,   # default bg
        render.RustCsgTuiAttrReverse
    )

# Render a single message into the conversation area with word wrapping.
#
# buf: the buffer to render into
# rect: the area to render within
# msg: the message to render
# rowOffset: which row to start at (updated by caller across messages)
# Returns the number of lines used.
fn RustCsgTuiAppRenderMessage(buf: var render.RustCsgTuiBuffer, rect: layout.RustCsgTuiRect, msg: RustCsgTuiMessage, rowOffset: int32): int32 =
    let contentWidth: int32 = rect.width
    if contentWidth <= 0:
        return 0

    # Format role prefix
    var prefix: str = ""
    if msg.isCode:
        prefix = ">>> "
    elif msg.role == "user":
        prefix = "> "
    else:
        prefix = "  "

    # Word-wrap the content
    let wrappedLines: str[] = render.RustCsgTuiWordWrap(msg.content, contentWidth)
    var linesUsed: int32 = 0
    var i: int32 = 0
    while i < wrappedLines.len:
        let bufRow: int32 = rect.y + rowOffset + i
        if bufRow >= rect.y + rect.height:
            # Out of space
            break
        var line: str = strutil.Join([prefix, wrappedLines[i]], "")
        if line.len > buf.width:
            line = strings.SliceBytes(line, 0, buf.width)
        # User messages get a subtle background tint
        if msg.role == "user":
            render.RustCsgTuiBufferWrite(buf, rect.x, bufRow, line, -1, -1, -1, 40, 40, 50, render.RustCsgTuiAttrNone)
        else:
            render.RustCsgTuiBufferWrite(buf, rect.x, bufRow, line, -1, -1, -1, -1, -1, -1, render.RustCsgTuiAttrNone)
        linesUsed = linesUsed + 1
        i = i + 1

    # Blank line between messages
    let sepRow: int32 = rect.y + rowOffset + linesUsed
    if sepRow < rect.y + rect.height:
        linesUsed = linesUsed + 1

    return linesUsed

# Render all messages in the conversation view.
fn RustCsgTuiAppRenderConversation(app: var RustCsgTuiApp) =
    let convRect = app.rects[1]
    var row: int32 = 0
    var i: int32 = 0
    while i < app.messages.len:
        let used: int32 = RustCsgTuiAppRenderMessage(app.buffer, convRect, app.messages[i], row)
        row = row + used
        i = i + 1

# Render the input area (prompt + current text).
fn RustCsgTuiAppRenderInput(app: var RustCsgTuiApp) =
    let inputRect = app.rects[2]
    var row: int32 = 0
    # Prompt line
    if row < inputRect.height:
        var promptLine: str = strutil.Join(["> ", app.inputText], "")
        if promptLine.len > inputRect.width:
            promptLine = strings.SliceBytes(promptLine, 0, inputRect.width)
        render.RustCsgTuiBufferWrite(
            app.buffer,
            inputRect.x, inputRect.y + row,
            promptLine,
            0, 200, 0,   # green foreground
            -1, -1, -1,
            render.RustCsgTuiAttrNone
        )
        row = row + 1
    # Empty remaining input rows
    while row < inputRect.height:
        render.RustCsgTuiBufferWrite(
            app.buffer,
            inputRect.x, inputRect.y + row,
            render.RustCsgTuiStrRepeat(" ", inputRect.width),
            -1, -1, -1,
            -1, -1, -1,
            render.RustCsgTuiAttrNone
        )
        row = row + 1

# Render a full frame into the buffer.
fn RustCsgTuiAppRenderFrame(app: var RustCsgTuiApp) =
    render.RustCsgTuiBufferClear(app.buffer)
    RustCsgTuiAppRenderStatus(app)
    RustCsgTuiAppRenderConversation(app)
    RustCsgTuiAppRenderInput(app)

# ── Main loop ────────────────────────────────────────────────────────────────

# Run the TUI application.
#
# This is the main event loop:
#   1. Render current state
#   2. Read a key event
#   3. Handle the key event (update state)
#   4. Repeat until TuiAppStop is called
#
# The app starts with raw mode enabled and restores on exit.
fn RustCsgTuiAppRun(app: var RustCsgTuiApp) =
    app.running = true

    # Enable raw mode
    input.RustCsgTuiEnableRawMode()

    while app.running:
        # Render frame
        let output: str = RustCsgTuiAppRenderFrameText(app)
        term.TerminalWrite(output)

        # Read key
        let ev: input.RustCsgTuiKeyEvent = input.RustCsgTuiReadKeyEvent()

        # Handle quit
        if ev.key == input.RustCsgTuiKeyEscape:
            app.running = false
        else:
            if ev.key == "q" && !ev.ctrl:
                app.running = false
            else:
                if ev.key == input.RustCsgTuiKeyEnter:
                    # Submit current input
                    if app.inputText != "":
                        var msg: RustCsgTuiMessage
                        msg.role = "user"
                        msg.content = app.inputText
                        msg.isCode = false
                        add(app.messages, msg)
                        app.inputText = ""
                        app.cursorPos = 0
                else:
                    if ev.key == input.RustCsgTuiKeyBackspace:
                        if app.cursorPos > 0:
                            let before: str = strings.SliceBytes(app.inputText, 0, app.cursorPos - 1)
                            let after: str = strings.SliceBytes(app.inputText, app.cursorPos, app.inputText.len - app.cursorPos)
                            app.inputText = strutil.Join([before, after], "")
                            app.cursorPos = app.cursorPos - 1
                    else:
                        if ev.key == input.RustCsgTuiKeyLeft:
                            if app.cursorPos > 0:
                                app.cursorPos = app.cursorPos - 1
                        else:
                            if ev.key == input.RustCsgTuiKeyRight:
                                if app.cursorPos < app.inputText.len:
                                    app.cursorPos = app.cursorPos + 1
                            else:
                                if ev.key == input.RustCsgTuiKeyHome:
                                    app.cursorPos = 0
                                else:
                                    if ev.key == input.RustCsgTuiKeyEnd:
                                        app.cursorPos = app.inputText.len
                                    else:
                                        if ev.key == input.RustCsgTuiKeyDelete:
                                            if app.cursorPos < app.inputText.len:
                                                let before: str = strings.SliceBytes(app.inputText, 0, app.cursorPos)
                                                let after: str = strings.SliceBytes(app.inputText, app.cursorPos + 1, app.inputText.len - app.cursorPos - 1)
                                                app.inputText = strutil.Join([before, after], "")
                                        else:
                                            # Printable character
                                            if ev.key != "" && ev.key.len == 1:
                                                let ch = ev.key[0]
                                                if ch >= ' ' && ch <= '~':
                                                    let before: str = strings.SliceBytes(app.inputText, 0, app.cursorPos)
                                                    let after: str = strings.SliceBytes(app.inputText, app.cursorPos, app.inputText.len - app.cursorPos)
                                                    app.inputText = strutil.Join([before, ev.key, after], "")
                                                    app.cursorPos = app.cursorPos + 1

    # Disable raw mode
    input.RustCsgTuiDisableRawMode()
