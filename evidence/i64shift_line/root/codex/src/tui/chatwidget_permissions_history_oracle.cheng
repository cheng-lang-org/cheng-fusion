# TUI chatwidget permissions history snapshot oracle.

import std/strutils as strutil

fn RustCsgTuiChatwidgetPermissionsHistoryLines(lines: str[]): str =
    return strutil.Join([strutil.Join(lines, "\n"), "\n"], "")

fn RustCsgTuiChatwidgetPermissionsHistoryAfterModeSwitch(): str =
    return RustCsgTuiChatwidgetPermissionsHistoryLines([
        "• Permissions updated to Full Access",
    ])

fn RustCsgTuiChatwidgetPermissionsHistoryFullAccessToDefault(): str =
    return RustCsgTuiChatwidgetPermissionsHistoryLines([
        "• Permissions updated to Default",
    ])

fn RustCsgTuiChatwidgetPermissionsHistoryFullAccessToDefaultWindows(): str =
    return RustCsgTuiChatwidgetPermissionsHistoryLines([
        "• Permissions updated to Default (non-admin sandbox)",
    ])
