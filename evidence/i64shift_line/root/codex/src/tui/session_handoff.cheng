import cheng/codex/protocol/types
import cheng/codex/protocol/wire
import cheng/codex/tui/session_lifecycle as lifecycle
import cheng/codex/tui/session_resume as resume

type
    RustCsgTuiSessionHandoffContext =
        dbPath: str
        codexHomePath: str
        currentCwd: str
        currentConfigJson: str
        ignoreUserConfig: bool
        selectedProfile: str
        allowPrompt: bool
        promptChoice: str
        threadParamsMode: str
        remoteCwdOverride: str
        requestIdJson: str

    RustCsgTuiSessionHandoffSelection =
        kind: str
        threadId: str
        path: str
        displayLabel: str

    RustCsgTuiSessionHandoffResult =
        ok: bool
        outcome: str
        method: str
        requestJson: str
        paramsJson: str
        threadId: str
        path: str
        displayLabel: str
        cwd: str
        historyCwd: str
        cwdSource: str
        configOutcome: str
        rebuiltConfigJson: str
        error: str

fn RustCsgTuiSessionHandoffError(message: str): RustCsgTuiSessionHandoffResult =
    var result: RustCsgTuiSessionHandoffResult
    result.outcome = "error"
    result.error = message
    return result

fn RustCsgTuiSessionHandoffPassthrough(outcome: str): RustCsgTuiSessionHandoffResult =
    var result: RustCsgTuiSessionHandoffResult
    result.ok = true
    result.outcome = outcome
    return result

fn RustCsgTuiSessionHandoffRequestJson(requestIdJson: str, method: str, paramsJson: str): str =
    var request: types.RustCsgJsonRpcRequest
    request.idJson = requestIdJson
    request.method = method
    request.paramsJson = paramsJson
    return wire.RustCsgJsonRpcRequestToJson(request)

fn RustCsgTuiSessionHandoffRequestResult(method: str,
                                         requestIdJson: str,
                                         paramsJson: str,
                                         threadId: str,
                                         path: str,
                                         displayLabel: str,
                                         cwd: str,
                                         historyCwd: str,
                                         cwdSource: str,
                                         configOutcome: str,
                                         rebuiltConfigJson: str): RustCsgTuiSessionHandoffResult =
    var result: RustCsgTuiSessionHandoffResult
    result.ok = true
    result.outcome = "request"
    result.method = method
    result.paramsJson = paramsJson
    result.requestJson = RustCsgTuiSessionHandoffRequestJson(requestIdJson, method, paramsJson)
    result.threadId = threadId
    result.path = path
    result.displayLabel = displayLabel
    result.cwd = cwd
    result.historyCwd = historyCwd
    result.cwdSource = cwdSource
    result.configOutcome = configOutcome
    result.rebuiltConfigJson = rebuiltConfigJson
    return result

fn RustCsgTuiSessionHandoffBuildParams(selectionKind: str,
                                       config: var lifecycle.RustCsgTuiThreadHandoffConfig,
                                       threadId: str,
                                       threadParamsMode: str,
                                       remoteCwdOverride: str): lifecycle.RustCsgTuiThreadHandoffResult =
    if selectionKind == "resume":
        return lifecycle.RustCsgTuiThreadHandoffBuildResumeParams(threadId,
                                                                  threadParamsMode,
                                                                  remoteCwdOverride,
                                                                  config)
    if selectionKind == "fork":
        return lifecycle.RustCsgTuiThreadHandoffBuildForkParams(threadId,
                                                                threadParamsMode,
                                                                remoteCwdOverride,
                                                                config)
    return lifecycle.RustCsgTuiThreadHandoffError(wire.RustCsgCat("unsupported session selection: ", selectionKind))

fn RustCsgTuiSessionHandoffMethod(selectionKind: str): str =
    if selectionKind == "resume":
        return "thread/resume"
    if selectionKind == "fork":
        return "thread/fork"
    return ""

fn RustCsgTuiSessionHandoffFinalCwd(currentCwd: str, cwdOutcome: resume.RustCsgTuiSessionResumeCwdOutcome): str =
    if cwdOutcome.cwd != "":
        return cwdOutcome.cwd
    return currentCwd

fn RustCsgTuiSessionHandoffMakeSelection(kind: str,
                                         threadId: str,
                                         path: str,
                                         displayLabel: str): RustCsgTuiSessionHandoffSelection =
    var selection: RustCsgTuiSessionHandoffSelection
    selection.kind = kind
    selection.threadId = threadId
    selection.path = path
    selection.displayLabel = displayLabel
    return selection

fn RustCsgTuiSessionHandoffApplyReloadedUserConfig(config: var lifecycle.RustCsgTuiThreadHandoffConfig,
                                                   rebuiltConfigJson: str) =
    let userConfig = wire.RustCsgJsonFindOptionalObject(rebuiltConfigJson, "userConfig")
    if userConfig == "":
        return
    let model = wire.RustCsgJsonFindOptionalStr(userConfig, "model")
    if model != "":
        config.model = model
    let modelProvider = wire.RustCsgJsonFindOptionalStr(userConfig, "modelProvider")
    if modelProvider != "":
        config.modelProviderId = modelProvider
    let approvalPolicy = wire.RustCsgJsonFindOptionalStr(userConfig, "approvalPolicy")
    if approvalPolicy != "":
        config.approvalPolicyJson = wire.RustCsgJsonQuote(approvalPolicy)
    let approvalsReviewer = wire.RustCsgJsonFindOptionalStr(userConfig, "approvalsReviewer")
    if approvalsReviewer != "":
        config.approvalsReviewer = approvalsReviewer

fn RustCsgTuiSessionHandoffApplyCliOverrides(config: var lifecycle.RustCsgTuiThreadHandoffConfig) =
    if config.modelOverride != "":
        config.model = config.modelOverride
    if config.approvalPolicyJsonOverride != "":
        config.approvalPolicyJson = config.approvalPolicyJsonOverride
    if config.permissionsJsonOverride != "":
        config.permissionsJson = config.permissionsJsonOverride

fn RustCsgTuiSessionHandoffConfigWithCwd(source: var lifecycle.RustCsgTuiThreadHandoffConfig,
                                         cwd: str): lifecycle.RustCsgTuiThreadHandoffConfig =
    var config: lifecycle.RustCsgTuiThreadHandoffConfig
    config.cwd = cwd
    config.model = source.model
    config.modelProviderId = source.modelProviderId
    config.serviceTierJson = source.serviceTierJson
    config.runtimeWorkspaceRootsJson = source.runtimeWorkspaceRootsJson
    config.approvalPolicyJson = source.approvalPolicyJson
    config.approvalsReviewer = source.approvalsReviewer
    config.sandboxJson = source.sandboxJson
    config.permissionsJson = source.permissionsJson
    config.modelOverride = source.modelOverride
    config.approvalPolicyJsonOverride = source.approvalPolicyJsonOverride
    config.permissionsJsonOverride = source.permissionsJsonOverride
    config.configJson = source.configJson
    config.baseInstructions = source.baseInstructions
    config.developerInstructions = source.developerInstructions
    config.ephemeral = source.ephemeral
    return config

fn RustCsgTuiSessionHandoffFromSelection(context: var RustCsgTuiSessionHandoffContext,
                                         selection: var RustCsgTuiSessionHandoffSelection,
                                         handoffConfig: var lifecycle.RustCsgTuiThreadHandoffConfig): RustCsgTuiSessionHandoffResult =
    if selection.kind == "exit":
        return RustCsgTuiSessionHandoffPassthrough("exit")
    if selection.kind == "start_fresh":
        return RustCsgTuiSessionHandoffPassthrough("start_fresh")
    if selection.kind != "resume" && selection.kind != "fork":
        return RustCsgTuiSessionHandoffError(wire.RustCsgCat("unsupported session selection: ", selection.kind))
    if selection.threadId == "":
        return RustCsgTuiSessionHandoffError("threadId is required")
    if context.requestIdJson == "":
        return RustCsgTuiSessionHandoffError("request id is required")

    var finalCwd = context.currentCwd
    var historyCwd: str
    var cwdSource: str
    if context.threadParamsMode == lifecycle.RustCsgTuiThreadParamsModeRemote:
        finalCwd = context.currentCwd
    else:
        let cwdOutcome = resume.RustCsgTuiSessionResumeResolveCwdForResumeOrForkWithPromptChoice(context.dbPath,
                                                                                                  context.currentCwd,
                                                                                                  selection.threadId,
                                                                                                  selection.path,
                                                                                                  context.allowPrompt,
                                                                                                  context.promptChoice)
        if !cwdOutcome.ok:
            return RustCsgTuiSessionHandoffError(cwdOutcome.error)
        if cwdOutcome.outcome == "prompt_required":
            var promptResult = RustCsgTuiSessionHandoffPassthrough("prompt_required")
            promptResult.threadId = selection.threadId
            promptResult.path = selection.path
            promptResult.displayLabel = selection.displayLabel
            promptResult.historyCwd = cwdOutcome.historyCwd
            promptResult.cwdSource = cwdOutcome.source
            return promptResult
        if cwdOutcome.outcome == "exit":
            var exitResult = RustCsgTuiSessionHandoffPassthrough("exit")
            exitResult.threadId = selection.threadId
            exitResult.path = selection.path
            exitResult.displayLabel = selection.displayLabel
            exitResult.historyCwd = cwdOutcome.historyCwd
            exitResult.cwdSource = cwdOutcome.source
            return exitResult
        finalCwd = RustCsgTuiSessionHandoffFinalCwd(context.currentCwd, cwdOutcome)
        historyCwd = cwdOutcome.historyCwd
        cwdSource = cwdOutcome.source

    let configOutcome = resume.RustCsgTuiSessionResumeRebuildConfigForResumeOrFallback(context.codexHomePath,
                                                                                       context.currentCwd,
                                                                                       context.currentConfigJson,
                                                                                       finalCwd,
                                                                                       context.ignoreUserConfig,
                                                                                       context.selectedProfile)
    if !configOutcome.ok:
        return RustCsgTuiSessionHandoffError(configOutcome.error)

    var finalConfig = RustCsgTuiSessionHandoffConfigWithCwd(handoffConfig, configOutcome.cwd)
    RustCsgTuiSessionHandoffApplyReloadedUserConfig(finalConfig, configOutcome.configJson)
    RustCsgTuiSessionHandoffApplyCliOverrides(finalConfig)
    let params = RustCsgTuiSessionHandoffBuildParams(selection.kind,
                                                     finalConfig,
                                                     selection.threadId,
                                                     context.threadParamsMode,
                                                     context.remoteCwdOverride)
    if !params.ok:
        return RustCsgTuiSessionHandoffError(params.error)
    return RustCsgTuiSessionHandoffRequestResult(RustCsgTuiSessionHandoffMethod(selection.kind),
                                                 context.requestIdJson,
                                                 params.json,
                                                 selection.threadId,
                                                 selection.path,
                                                 selection.displayLabel,
                                                 configOutcome.cwd,
                                                 historyCwd,
                                                 cwdSource,
                                                 configOutcome.outcome,
                                                 configOutcome.configJson)
