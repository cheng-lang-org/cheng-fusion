# TUI chatwidget simple history and nudge snapshot oracle.

import std/strutils as strutil

fn RustCsgTuiChatwidgetSimpleHistoryLines(lines: str[]): str =
    return strutil.Join([strutil.Join(lines, "\n"), "\n"], "")

fn RustCsgTuiChatwidgetPlanModeNudge(): str =
    return RustCsgTuiChatwidgetSimpleHistoryLines([
        "› make a plan",
        "",
        "  Create a plan?  shift + tab use Plan mode   esc dismiss",
    ])

fn RustCsgTuiChatwidgetPlanModeNudgeNarrow(): str =
    return RustCsgTuiChatwidgetSimpleHistoryLines([
        "› make a plan",
        "",
        "  Create a plan?  shift + tab use P…",
    ])

fn RustCsgTuiChatwidgetFinalReasoningThenMessage(): str =
    return RustCsgTuiChatwidgetSimpleHistoryLines([
        "• Here is the result.",
    ])

fn RustCsgTuiChatwidgetDeltasThenSameFinalMessage(): str =
    return "\n"

fn RustCsgTuiChatwidgetInterruptExecMarksFailed(): str =
    return RustCsgTuiChatwidgetSimpleHistoryLines([
        "• Ran sleep 1",
        "  └ (no output)",
    ])

fn RustCsgTuiChatwidgetLocalImageAttachmentHistory(): str =
    return RustCsgTuiChatwidgetSimpleHistoryLines([
        "• Viewed Image",
        "  └ example.png",
    ])

fn RustCsgTuiChatwidgetUnifiedExecWaitingMultipleEmptyAfter(): str =
    return RustCsgTuiChatwidgetSimpleHistoryLines([
        "• Waited for background terminal · just fix",
    ])

fn RustCsgTuiChatwidgetInterruptedTurnPendingSteersMessage(): str =
    return RustCsgTuiChatwidgetSimpleHistoryLines([
        "• Model interrupted to submit steer instructions.",
    ])

fn RustCsgTuiChatwidgetLiveAppServerCommandExecutionStripsShellWrapper(): str =
    return RustCsgTuiChatwidgetSimpleHistoryLines([
        "• You ran python3 -c 'print(\"Hello, world!\")'",
        "  └ Hello, world!",
    ])

fn RustCsgTuiChatwidgetSlashCopyNoOutputInfoMessage(): str =
    return RustCsgTuiChatwidgetSimpleHistoryLines([
        "• `/copy` is unavailable before the first Codex output or right after a rollback.",
    ])

fn RustCsgTuiChatwidgetApplyPatchManualFlowHistoryApproved(): str =
    return RustCsgTuiChatwidgetSimpleHistoryLines([
        "• Added foo.txt (+1 -0)",
        "    1 +hello",
    ])

fn RustCsgTuiChatwidgetImageGenerationCallHistory(): str =
    return RustCsgTuiChatwidgetSimpleHistoryLines([
        "• Generated Image:",
        "  └ A tiny blue square",
        "  └ Saved to: file:///tmp/ig-1.png",
    ])

fn RustCsgTuiChatwidgetUnifiedExecWaitAfterFinalAgentMessage(): str =
    return RustCsgTuiChatwidgetSimpleHistoryLines([
        "• Waited for background terminal · cargo test -p codex-core",
        "",
        "• Final response.",
    ])

fn RustCsgTuiChatwidgetUnifiedExecWaitBeforeStreamedAgentMessage(): str =
    return RustCsgTuiChatwidgetSimpleHistoryLines([
        "• Waited for background terminal · cargo test -p codex-core",
        "",
        "• Streaming response.",
    ])
