# TUI chatwidget app-server and MCP startup snapshot oracle.

import std/strings
import std/strutils as strutil

fn RustCsgTuiChatwidgetAppServerMcpLines(lines: str[]): str =
    return strutil.Join([strutil.Join(lines, "\n"), "\n"], "")

fn RustCsgTuiChatwidgetAppServerMcpSpaces(count: int32): str =
    var out: str = ""
    var i: int32 = 0
    while i < count:
        out = strings.ConcatStr(out, " ")
        i = i + 1
    return out

fn RustCsgTuiChatwidgetAppServerMcpQuotedRow(text: str, trailingSpaces: int32): str =
    return strutil.Join(["\"", text, RustCsgTuiChatwidgetAppServerMcpSpaces(trailingSpaces), "\"\n"], "")

fn RustCsgTuiChatwidgetAppServerCollabSpawnCompleted(): str =
    return RustCsgTuiChatwidgetAppServerMcpLines([
        "• Spawned 019cff70-2599-75e2-af72-b91781b41a8e (gpt-5 high)",
        "  └ Explore the repo",
    ])

fn RustCsgTuiChatwidgetMcpStartupHeaderBooting(): str =
    return strutil.Join([
        RustCsgTuiChatwidgetAppServerMcpQuotedRow("", 80),
        RustCsgTuiChatwidgetAppServerMcpQuotedRow("• Booting MCP server: alpha (0s • esc to interrupt)", 29),
        RustCsgTuiChatwidgetAppServerMcpQuotedRow("", 80),
        RustCsgTuiChatwidgetAppServerMcpQuotedRow("", 80),
        RustCsgTuiChatwidgetAppServerMcpQuotedRow("› Ask Codex to do anything", 54),
        RustCsgTuiChatwidgetAppServerMcpQuotedRow("", 80),
        RustCsgTuiChatwidgetAppServerMcpQuotedRow("  gpt-5.3-codex default · 100% left · /tmp/project", 30),
    ], "")

fn RustCsgTuiChatwidgetAppServerMcpStartupFailureWarningHistory(): str =
    return RustCsgTuiChatwidgetAppServerMcpLines([
        "",
        "",
        "",
        "⚠ MCP client for `alpha` failed to start: handshake failed",
        "⚠ MCP startup incomplete (failed: alpha)",
        "",
        "",
        "› Ask Codex to do anything",
        "",
        "  gpt-5.3-codex default · 100% left · /tmp/project",
    ])
