import cheng/codex/protocol/wire
import cheng/codex/tui/chat_replay as replay
import cheng/codex/tui/session_state

type
    RustCsgTuiAppSessionInstallResult =
        ok: bool
        primaryThreadId: str
        primarySessionConfiguredJson: str
        activeThreadId: str
        threadStoreThreadId: str
        threadStoreSessionJson: str
        threadStoreTurnsJson: str
        chatWidgetThreadId: str
        chatWidgetInstructionSourcePathsJson: str
        replayKind: str
        replayedTurnCount: int32
        chatReplayPlanJson: str
        chatReplayEventCount: int32
        chatReplayUserMessageCount: int32
        chatReplayAgentMessageCount: int32
        chatReplayCommandExecutionCount: int32
        chatReplayTranscriptText: str
        chatReplayHasInterruptedTurn: bool
        chatReplayHasFailedTurn: bool
        beginInitialHistoryReplayBuffer: bool
        endInitialHistoryReplayBuffer: bool
        initialUserMessageSubmitSuppressedDuringReplay: bool
        initialUserMessageSubmitSuppressedAfterReplay: bool
        pendingPrimaryEventReplayCount: int32
        pendingPrimaryRequestReplayCount: int32
        pendingPrimaryNotificationReplayCount: int32
        pendingPrimaryHistoryEntryResponseReplayCount: int32
        pendingPrimaryFeedbackSubmissionReplayCount: int32
        pendingPrimaryEventReplayJson: str
        pendingPrimaryEventsClearedAfterReplay: bool
        initialUserMessageSubmittedAfterPendingReplay: bool
        submittedInitialUserMessage: bool
        error: str

    RustCsgTuiPendingPrimaryReplayPlan =
        ok: bool
        eventCount: int32
        requestCount: int32
        notificationCount: int32
        historyEntryResponseCount: int32
        feedbackSubmissionCount: int32
        eventsJson: str
        error: str

fn RustCsgTuiAppSessionInstallError(message: str): RustCsgTuiAppSessionInstallResult =
    var result: RustCsgTuiAppSessionInstallResult
    result.error = message
    return result

fn RustCsgTuiPendingPrimaryReplayError(message: str): RustCsgTuiPendingPrimaryReplayPlan =
    var plan: RustCsgTuiPendingPrimaryReplayPlan
    plan.error = message
    return plan

fn RustCsgTuiPendingPrimaryReplayPayload(eventJson: str, kind: str, outOk: var bool): str =
    outOk = false
    var payload = replay.RustCsgTuiChatReplayTopLevelValueRaw(eventJson, "payload")
    if payload == "":
        if kind == "request":
            payload = replay.RustCsgTuiChatReplayTopLevelValueRaw(eventJson, "request")
        elif kind == "notification":
            payload = replay.RustCsgTuiChatReplayTopLevelValueRaw(eventJson, "notification")
        elif kind == "historyEntryResponse":
            payload = replay.RustCsgTuiChatReplayTopLevelValueRaw(eventJson, "historyEntryResponse")
        elif kind == "feedbackSubmission":
            payload = replay.RustCsgTuiChatReplayTopLevelValueRaw(eventJson, "feedbackSubmission")
    let start = wire.RustCsgSkipJsonSpace(payload, 0)
    if start >= payload.len || payload[start] != '{':
        return ""
    outOk = true
    return payload

fn RustCsgTuiPendingPrimaryReplayAppendEvent(plan: var RustCsgTuiPendingPrimaryReplayPlan,
                                             index: int32,
                                             threadId: str,
                                             kind: str,
                                             payload: str) =
    if plan.eventsJson == "":
        plan.eventsJson = "["
    if plan.eventCount > 0:
        plan.eventsJson = wire.RustCsgCat(plan.eventsJson, ",")
    var eventJson = "{"
    eventJson = wire.RustCsgCat(eventJson, wire.RustCsgJsonFieldInt32("index", index))
    eventJson = wire.RustCsgCat(eventJson, ",")
    eventJson = wire.RustCsgCat(eventJson, wire.RustCsgJsonFieldStr("threadId", threadId))
    eventJson = wire.RustCsgCat(eventJson, ",")
    eventJson = wire.RustCsgCat(eventJson, wire.RustCsgJsonFieldStr("kind", kind))
    if kind == "request":
        var methodOk: bool
        let method = replay.RustCsgTuiChatReplayTopLevelStr(payload, "method", methodOk)
        if methodOk && method != "":
            eventJson = wire.RustCsgCat(eventJson, ",")
            eventJson = wire.RustCsgCat(eventJson, wire.RustCsgJsonFieldStr("method", method))
    eventJson = wire.RustCsgCat(eventJson, ",")
    eventJson = wire.RustCsgCat(eventJson, wire.RustCsgJsonFieldRaw("payload", payload))
    eventJson = wire.RustCsgCat(eventJson, "}")
    plan.eventsJson = wire.RustCsgCat(plan.eventsJson, eventJson)
    plan.eventCount = plan.eventCount + 1

fn RustCsgTuiPendingPrimaryReplayFromEvents(eventsJson: str,
                                            threadId: str): RustCsgTuiPendingPrimaryReplayPlan =
    var raw = eventsJson
    if raw == "":
        raw = "[]"
    var plan: RustCsgTuiPendingPrimaryReplayPlan
    plan.ok = true
    plan.eventsJson = "["
    let eventCount = replay.RustCsgTuiChatReplayArrayLen(raw)
    for i in 0..<eventCount:
        let eventJson = replay.RustCsgTuiChatReplayArrayObjectAt(raw, i)
        var kindOk: bool
        let kind = replay.RustCsgTuiChatReplayTopLevelStr(eventJson, "kind", kindOk)
        if !kindOk || kind == "":
            return RustCsgTuiPendingPrimaryReplayError("pending primary event kind is required")
        var payloadOk: bool
        let payload = RustCsgTuiPendingPrimaryReplayPayload(eventJson, kind, payloadOk)
        if !payloadOk:
            return RustCsgTuiPendingPrimaryReplayError(wire.RustCsgCat("pending primary event payload is required for kind: ", kind))
        if kind == "request":
            plan.requestCount = plan.requestCount + 1
        elif kind == "notification":
            plan.notificationCount = plan.notificationCount + 1
        elif kind == "historyEntryResponse":
            plan.historyEntryResponseCount = plan.historyEntryResponseCount + 1
        elif kind == "feedbackSubmission":
            plan.feedbackSubmissionCount = plan.feedbackSubmissionCount + 1
        else:
            return RustCsgTuiPendingPrimaryReplayError(wire.RustCsgCat("unsupported pending primary event kind: ", kind))
        RustCsgTuiPendingPrimaryReplayAppendEvent(plan, i, threadId, kind, payload)
    plan.eventsJson = wire.RustCsgCat(plan.eventsJson, "]")
    return plan

fn RustCsgTuiAppSessionInstallPrimary(started: var session_state.RustCsgTuiAppServerStartedThread,
                                      terminalResizeReflowEnabled: bool,
                                      pendingPrimaryEventCount: int32,
                                      initialUserMessagePending: bool): RustCsgTuiAppSessionInstallResult =
    if pendingPrimaryEventCount != 0:
        return RustCsgTuiAppSessionInstallError("pending primary event replay requires event json")
    return RustCsgTuiAppSessionInstallPrimaryWithPendingEvents(started,
                                                               terminalResizeReflowEnabled,
                                                               "[]",
                                                               initialUserMessagePending)

fn RustCsgTuiAppSessionInstallPrimaryWithPendingEvents(started: var session_state.RustCsgTuiAppServerStartedThread,
                                                       terminalResizeReflowEnabled: bool,
                                                       pendingPrimaryEventsJson: str,
                                                       initialUserMessagePending: bool): RustCsgTuiAppSessionInstallResult =
    if !started.ok:
        return RustCsgTuiAppSessionInstallError(started.error)
    var replayPlan = replay.RustCsgTuiChatReplayFromTurns(started.turnsJson)
    if !replayPlan.ok:
        return RustCsgTuiAppSessionInstallError(replayPlan.error)
    if replayPlan.turnCount != started.turnCount:
        return RustCsgTuiAppSessionInstallError("turn replay count mismatch")
    var pendingPlan = RustCsgTuiPendingPrimaryReplayFromEvents(pendingPrimaryEventsJson, started.session.threadId)
    if !pendingPlan.ok:
        return RustCsgTuiAppSessionInstallError(pendingPlan.error)
    var result: RustCsgTuiAppSessionInstallResult
    result.ok = true
    result.primaryThreadId = started.session.threadId
    result.primarySessionConfiguredJson = session_state.RustCsgTuiThreadSessionStateToJson(started.session)
    result.activeThreadId = started.session.threadId
    result.threadStoreThreadId = started.session.threadId
    result.threadStoreSessionJson = result.primarySessionConfiguredJson
    result.threadStoreTurnsJson = started.turnsJson
    result.chatWidgetThreadId = started.session.threadId
    result.chatWidgetInstructionSourcePathsJson = started.session.instructionSourcePathsJson
    result.replayKind = "ResumeInitialMessages"
    result.replayedTurnCount = replayPlan.turnCount
    result.chatReplayPlanJson = replay.RustCsgTuiChatReplayPlanToJson(replayPlan)
    result.chatReplayEventCount = replayPlan.eventCount
    result.chatReplayUserMessageCount = replayPlan.userMessageCount
    result.chatReplayAgentMessageCount = replayPlan.agentMessageCount
    result.chatReplayCommandExecutionCount = replayPlan.commandExecutionCount
    result.chatReplayTranscriptText = replayPlan.displayTranscriptText
    result.chatReplayHasInterruptedTurn = replayPlan.hasInterruptedTurn
    result.chatReplayHasFailedTurn = replayPlan.hasFailedTurn
    if terminalResizeReflowEnabled && started.turnCount > 0:
        result.beginInitialHistoryReplayBuffer = true
        result.endInitialHistoryReplayBuffer = true
    result.initialUserMessageSubmitSuppressedDuringReplay = true
    result.initialUserMessageSubmitSuppressedAfterReplay = false
    result.pendingPrimaryEventReplayCount = pendingPlan.eventCount
    result.pendingPrimaryRequestReplayCount = pendingPlan.requestCount
    result.pendingPrimaryNotificationReplayCount = pendingPlan.notificationCount
    result.pendingPrimaryHistoryEntryResponseReplayCount = pendingPlan.historyEntryResponseCount
    result.pendingPrimaryFeedbackSubmissionReplayCount = pendingPlan.feedbackSubmissionCount
    result.pendingPrimaryEventReplayJson = pendingPlan.eventsJson
    result.pendingPrimaryEventsClearedAfterReplay = true
    result.initialUserMessageSubmittedAfterPendingReplay = initialUserMessagePending
    result.submittedInitialUserMessage = initialUserMessagePending
    return result

fn RustCsgTuiAppSessionInstallResultToJson(result: var RustCsgTuiAppSessionInstallResult): str =
    if !result.ok:
        return wire.RustCsgCat(wire.RustCsgCat("{\"ok\":false,\"error\":", wire.RustCsgJsonQuote(result.error)), "}")
    var out = "{\"ok\":true,"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("primaryThreadId", result.primaryThreadId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("primarySessionConfigured", result.primarySessionConfiguredJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("activeThreadId", result.activeThreadId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("threadStoreThreadId", result.threadStoreThreadId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("threadStoreSession", result.threadStoreSessionJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("threadStoreTurns", result.threadStoreTurnsJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("chatWidgetThreadId", result.chatWidgetThreadId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("chatWidgetInstructionSourcePaths", result.chatWidgetInstructionSourcePathsJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("replayKind", result.replayKind))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("replayedTurnCount", result.replayedTurnCount))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("chatReplayPlan", result.chatReplayPlanJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("chatReplayEventCount", result.chatReplayEventCount))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("chatReplayUserMessageCount", result.chatReplayUserMessageCount))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("chatReplayAgentMessageCount", result.chatReplayAgentMessageCount))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("chatReplayCommandExecutionCount", result.chatReplayCommandExecutionCount))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("chatReplayTranscriptText", result.chatReplayTranscriptText))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("chatReplayHasInterruptedTurn", result.chatReplayHasInterruptedTurn))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("chatReplayHasFailedTurn", result.chatReplayHasFailedTurn))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("beginInitialHistoryReplayBuffer", result.beginInitialHistoryReplayBuffer))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("endInitialHistoryReplayBuffer", result.endInitialHistoryReplayBuffer))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("initialUserMessageSubmitSuppressedDuringReplay", result.initialUserMessageSubmitSuppressedDuringReplay))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("initialUserMessageSubmitSuppressedAfterReplay", result.initialUserMessageSubmitSuppressedAfterReplay))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("pendingPrimaryEventReplayCount", result.pendingPrimaryEventReplayCount))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("pendingPrimaryRequestReplayCount", result.pendingPrimaryRequestReplayCount))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("pendingPrimaryNotificationReplayCount", result.pendingPrimaryNotificationReplayCount))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("pendingPrimaryHistoryEntryResponseReplayCount", result.pendingPrimaryHistoryEntryResponseReplayCount))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("pendingPrimaryFeedbackSubmissionReplayCount", result.pendingPrimaryFeedbackSubmissionReplayCount))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("pendingPrimaryEventReplay", result.pendingPrimaryEventReplayJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("pendingPrimaryEventsClearedAfterReplay", result.pendingPrimaryEventsClearedAfterReplay))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("initialUserMessageSubmittedAfterPendingReplay", result.initialUserMessageSubmittedAfterPendingReplay))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("submittedInitialUserMessage", result.submittedInitialUserMessage))
    out = wire.RustCsgCat(out, "}")
    return out
