import std/strings
import cheng/codex/protocol/wire
import cheng/codex/tui/app_session_install as install
import cheng/codex/tui/session_handoff as handoff
import cheng/codex/tui/session_state as state

type
    RustCsgTuiSessionBootstrapConfig =
        stateConfig: state.RustCsgTuiSessionStateConfig
        threadParamsMode: str
        terminalResizeReflowEnabled: bool
        pendingPrimaryEventCount: int32
        pendingPrimaryEventsJson: str
        initialUserMessagePending: bool

    RustCsgTuiSessionBootstrapResult =
        ok: bool
        outcome: str
        method: str
        primaryThreadId: str
        startedJson: str
        installJson: str
        turnCount: int32
        error: str

fn RustCsgTuiSessionBootstrapError(message: str): RustCsgTuiSessionBootstrapResult =
    var result: RustCsgTuiSessionBootstrapResult
    result.outcome = "error"
    result.error = message
    return result

fn RustCsgTuiSessionBootstrapPassthrough(outcome: str): RustCsgTuiSessionBootstrapResult =
    var result: RustCsgTuiSessionBootstrapResult
    result.ok = true
    result.outcome = outcome
    return result

fn RustCsgTuiSessionBootstrapInstalled(method: str,
                                       started: var state.RustCsgTuiAppServerStartedThread,
                                       installResult: var install.RustCsgTuiAppSessionInstallResult): RustCsgTuiSessionBootstrapResult =
    var result: RustCsgTuiSessionBootstrapResult
    result.ok = true
    result.outcome = "installed"
    result.method = method
    result.primaryThreadId = installResult.primaryThreadId
    result.startedJson = state.RustCsgTuiAppServerStartedThreadToJson(started)
    result.installJson = install.RustCsgTuiAppSessionInstallResultToJson(installResult)
    result.turnCount = started.turnCount
    return result

fn RustCsgTuiSessionBootstrapStartsWithAt(text: str, index: int32, pattern: str): bool =
    if index < 0:
        return false
    if index + pattern.len > text.len:
        return false
    var i: int32
    while i < pattern.len:
        if text[index + i] != pattern[i]:
            return false
        i = i + 1
    return true

fn RustCsgTuiSessionBootstrapSkipSpace(text: str, index: int32): int32 =
    var i = index
    while i < text.len:
        let ch = text[i]
        if ch != ' ' && ch != '\n' && ch != '\r' && ch != '\t':
            return i
        i = i + 1
    return i

fn RustCsgTuiSessionBootstrapTopLevelValueStart(text: str, key: str): int32 =
    let start = RustCsgTuiSessionBootstrapSkipSpace(text, 0)
    if start >= text.len || text[start] != '{':
        return -1
    let pattern = wire.RustCsgCat3("\"", key, "\"")
    var depth: int32
    var inString: bool
    var escaped: bool
    var i = start
    while i < text.len:
        let ch = text[i]
        if inString:
            if escaped:
                escaped = false
            elif ch == '\\':
                escaped = true
            elif ch == '"':
                inString = false
        else:
            if ch == '"':
                if depth == 1 && RustCsgTuiSessionBootstrapStartsWithAt(text, i, pattern):
                    var p = i + pattern.len
                    p = RustCsgTuiSessionBootstrapSkipSpace(text, p)
                    if p < text.len && text[p] == ':':
                        return RustCsgTuiSessionBootstrapSkipSpace(text, p + 1)
                inString = true
            elif ch == '{' || ch == '[':
                depth = depth + 1
            elif ch == '}' || ch == ']':
                depth = depth - 1
                if depth < 0:
                    return -1
        i = i + 1
    return -1

fn RustCsgTuiSessionBootstrapValueEnd(text: str, valueStart: int32): int32 =
    if valueStart < 0 || valueStart >= text.len:
        return -1
    let first = text[valueStart]
    var inString: bool
    var escaped: bool
    if first == '"':
        var s = valueStart + 1
        while s < text.len:
            let ch = text[s]
            if escaped:
                escaped = false
            elif ch == '\\':
                escaped = true
            elif ch == '"':
                return s + 1
            s = s + 1
        return -1
    if first == '{' || first == '[':
        var depth: int32
        var i = valueStart
        while i < text.len:
            let ch = text[i]
            if inString:
                if escaped:
                    escaped = false
                elif ch == '\\':
                    escaped = true
                elif ch == '"':
                    inString = false
            else:
                if ch == '"':
                    inString = true
                elif ch == '{' || ch == '[':
                    depth = depth + 1
                elif ch == '}' || ch == ']':
                    depth = depth - 1
                    if depth == 0:
                        return i + 1
            i = i + 1
        return -1
    var p = valueStart
    while p < text.len:
        let ch = text[p]
        if ch == ',' || ch == '}' || ch == ']' || ch == ' ' || ch == '\n' || ch == '\r' || ch == '\t':
            return p
        p = p + 1
    return p

fn RustCsgTuiSessionBootstrapTopLevelValueRaw(text: str, key: str): str =
    let start = RustCsgTuiSessionBootstrapTopLevelValueStart(text, key)
    if start < 0:
        return ""
    let endPos = RustCsgTuiSessionBootstrapValueEnd(text, start)
    if endPos < start:
        return ""
    return strings.SliceBytes(text, start, endPos - start)

fn RustCsgTuiSessionBootstrapTopLevelObject(text: str, key: str): str =
    let raw = RustCsgTuiSessionBootstrapTopLevelValueRaw(text, key)
    if raw.len > 0 && raw[0] == '{':
        return raw
    return ""

fn RustCsgTuiSessionBootstrapResponseErrorMessage(responseJson: str): str =
    let errorJson = RustCsgTuiSessionBootstrapTopLevelObject(responseJson, "error")
    if errorJson == "":
        return ""
    let message = wire.RustCsgJsonFindOptionalStr(errorJson, "message")
    if message != "":
        return message
    return "app-server returned JSON-RPC error"

fn RustCsgTuiSessionBootstrapLifecycleKind(method: str): str =
    if method == "thread/resume":
        return state.RustCsgTuiSessionLifecycleResume
    if method == "thread/fork":
        return state.RustCsgTuiSessionLifecycleFork
    if method == "thread/start":
        return state.RustCsgTuiSessionLifecycleStart
    return ""

fn RustCsgTuiSessionBootstrapPendingEventsJson(config: var RustCsgTuiSessionBootstrapConfig,
                                               outError: var str): str =
    var eventsJson = config.pendingPrimaryEventsJson
    if eventsJson == "":
        if config.pendingPrimaryEventCount != 0:
            outError = "pending primary event replay requires event json"
            return ""
        return "[]"
    let count = state.RustCsgTuiSessionStateArrayItemCount(eventsJson)
    if config.pendingPrimaryEventCount != 0 && count != config.pendingPrimaryEventCount:
        outError = "pending primary event replay count mismatch"
        return ""
    return eventsJson

fn RustCsgTuiSessionBootstrapInstallFromJsonRpcResponse(handoffResult: var handoff.RustCsgTuiSessionHandoffResult,
                                                        responseJson: str,
                                                        config: var RustCsgTuiSessionBootstrapConfig): RustCsgTuiSessionBootstrapResult =
    if !handoffResult.ok:
        return RustCsgTuiSessionBootstrapError(handoffResult.error)
    if handoffResult.outcome != "request":
        return RustCsgTuiSessionBootstrapPassthrough(handoffResult.outcome)
    if responseJson == "":
        return RustCsgTuiSessionBootstrapError("missing app-server response")
    let responseError = RustCsgTuiSessionBootstrapResponseErrorMessage(responseJson)
    if responseError != "":
        return RustCsgTuiSessionBootstrapError(responseError)
    let resultJson = RustCsgTuiSessionBootstrapTopLevelValueRaw(responseJson, "result")
    if resultJson == "":
        return RustCsgTuiSessionBootstrapError("missing JSON-RPC result")
    let lifecycleKind = RustCsgTuiSessionBootstrapLifecycleKind(handoffResult.method)
    if lifecycleKind == "":
        return RustCsgTuiSessionBootstrapError(wire.RustCsgCat("unsupported lifecycle method: ", handoffResult.method))
    var started = state.RustCsgTuiSessionStateFromLifecycleResponseJson(resultJson,
                                                                        lifecycleKind,
                                                                        config.threadParamsMode,
                                                                        config.stateConfig)
    if handoffResult.method == "thread/fork":
        started = state.RustCsgTuiStartedThreadSetForkParentTitle(started, handoffResult.displayLabel)
    if !started.ok:
        return RustCsgTuiSessionBootstrapError(started.error)
    var pendingError: str
    let pendingEventsJson = RustCsgTuiSessionBootstrapPendingEventsJson(config, pendingError)
    if pendingError != "":
        return RustCsgTuiSessionBootstrapError(pendingError)
    let installResult = install.RustCsgTuiAppSessionInstallPrimaryWithPendingEvents(started,
                                                                                    config.terminalResizeReflowEnabled,
                                                                                    pendingEventsJson,
                                                                                    config.initialUserMessagePending)
    if !installResult.ok:
        return RustCsgTuiSessionBootstrapError(installResult.error)
    return RustCsgTuiSessionBootstrapInstalled(handoffResult.method, started, installResult)

fn RustCsgTuiSessionBootstrapResultToJson(result: var RustCsgTuiSessionBootstrapResult): str =
    if !result.ok:
        return wire.RustCsgCat(wire.RustCsgCat("{\"ok\":false,\"outcome\":\"error\",\"error\":", wire.RustCsgJsonQuote(result.error)), "}")
    var out = "{\"ok\":true,"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("outcome", result.outcome))
    out = wire.RustCsgCat(out, wire.RustCsgJsonNullableFieldStr("method", result.method))
    out = wire.RustCsgCat(out, wire.RustCsgJsonNullableFieldStr("primaryThreadId", result.primaryThreadId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("turnCount", result.turnCount))
    if result.startedJson != "":
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("started", result.startedJson))
    if result.installJson != "":
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("install", result.installJson))
    out = wire.RustCsgCat(out, "}")
    return out
