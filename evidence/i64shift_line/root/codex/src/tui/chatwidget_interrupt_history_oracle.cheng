# TUI chatwidget interrupt/reconnect/side-context snapshot oracle.

import std/strings
import std/strutils as strutil

fn RustCsgTuiChatwidgetInterruptHistoryLines(lines: str[]): str =
    return strutil.Join([strutil.Join(lines, "\n"), "\n"], "")

fn RustCsgTuiChatwidgetInterruptHistorySpaces(count: int32): str =
    var out: str = ""
    var i: int32 = 0
    while i < count:
        out = strings.ConcatStr(out, " ")
        i = i + 1
    return out

fn RustCsgTuiChatwidgetInterruptHistoryQuotedRow(text: str, trailingSpaces: int32): str =
    return strutil.Join(["\"", text, RustCsgTuiChatwidgetInterruptHistorySpaces(trailingSpaces), "\"\n"], "")

fn RustCsgTuiChatwidgetInterruptedTurnErrorMessage(): str =
    return RustCsgTuiChatwidgetInterruptHistoryLines([
        "■ Conversation interrupted - tell the model what to do differently. Something went wrong? Hit `/feedback` to report the issue.",
    ])

fn RustCsgTuiChatwidgetInterruptedTurnGoalBudgetLimitedMessage(): str =
    return RustCsgTuiChatwidgetInterruptHistoryLines([
        "■ Goal budget reached - the turn was stopped.",
    ])

fn RustCsgTuiChatwidgetInterruptedTurnClearsVisibleRunningHook(): str =
    return RustCsgTuiChatwidgetInterruptHistoryLines([
        "before interrupt:",
        "• Running PreToolUse hook: checking command policy",
        "after interrupt:",
        "<empty>",
    ])

fn RustCsgTuiChatwidgetSideContextFooter(statusLine: str): str =
    return strutil.Join([
        RustCsgTuiChatwidgetInterruptHistoryQuotedRow("", 80),
        RustCsgTuiChatwidgetInterruptHistoryQuotedRow("", 80),
        RustCsgTuiChatwidgetInterruptHistoryQuotedRow("› Check recently modified functions for compatibility", 27),
        RustCsgTuiChatwidgetInterruptHistoryQuotedRow("", 80),
        RustCsgTuiChatwidgetInterruptHistoryQuotedRow(statusLine, 2),
    ], "")

fn RustCsgTuiChatwidgetSideContextLabelPreservesStatusLine(): str =
    return RustCsgTuiChatwidgetSideContextFooter("  gpt-5.5                             Side from main thread · Ctrl+C to return")

fn RustCsgTuiChatwidgetSideContextLabelShowsParentStatus(): str =
    return RustCsgTuiChatwidgetSideContextFooter("  gpt-5.5 default… Side from main thread · main needs input · Ctrl+C to return")
