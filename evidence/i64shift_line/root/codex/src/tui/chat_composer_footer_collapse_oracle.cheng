# TUI bottom_pane/chat_composer.rs footer collapse terminal.backend() oracle.

import std/strings

fn RustCsgTuiChatComposerFooterCollapseSpaces(count: int32): str =
    var out: str = ""
    var i: int32 = 0
    while i < count:
        out = strings.ConcatStr(out, " ")
        i = i + 1
    return out

fn RustCsgTuiChatComposerFooterCollapseStartsWithAt(text: str, index: int32, prefix: str): bool =
    let prefixLen: int32 = strings.Len(prefix)
    if index < 0:
        return false
    if index + prefixLen > strings.Len(text):
        return false
    return strings.SliceBytes(text, index, prefixLen) == prefix

fn RustCsgTuiChatComposerFooterCollapseNextGlyph(text: str, index: int32): str =
    if RustCsgTuiChatComposerFooterCollapseStartsWithAt(text, index, "›"):
        return "›"
    if RustCsgTuiChatComposerFooterCollapseStartsWithAt(text, index, "…"):
        return "…"
    if RustCsgTuiChatComposerFooterCollapseStartsWithAt(text, index, "⌥"):
        return "⌥"
    if RustCsgTuiChatComposerFooterCollapseStartsWithAt(text, index, "·"):
        return "·"
    return strings.SliceBytes(text, index, 1)

fn RustCsgTuiChatComposerFooterCollapseDisplayWidth(text: str): int32 =
    var width: int32 = 0
    var i: int32 = 0
    while i < strings.Len(text):
        let glyph: str = RustCsgTuiChatComposerFooterCollapseNextGlyph(text, i)
        width = width + 1
        i = i + strings.Len(glyph)
    return width

fn RustCsgTuiChatComposerFooterCollapsePadLine(text: str, width: int32): str =
    let currentWidth: int32 = RustCsgTuiChatComposerFooterCollapseDisplayWidth(text)
    if currentWidth > width:
        assert(false, "chat composer footer collapse oracle line exceeds width")
    return strings.ConcatStr(text, RustCsgTuiChatComposerFooterCollapseSpaces(width - currentWidth))

fn RustCsgTuiChatComposerFooterCollapseBackend(width: int32, lines: str[]): str =
    var out: str = ""
    var i: int32 = 0
    while i < lines.len:
        out = strings.ConcatStr(out, "\"")
        out = strings.ConcatStr(out, RustCsgTuiChatComposerFooterCollapsePadLine(lines[i], width))
        out = strings.ConcatStr(out, "\"\n")
        i = i + 1
    return out

fn RustCsgTuiChatComposerFooterCollapseEmptyFullSnapshot(): str =
    return RustCsgTuiChatComposerFooterCollapseBackend(120, [
        "",
        "› Ask Codex to do anything",
        "",
        "",
        "",
        "",
        "",
        "",
        "  ? for shortcuts                                                                                    100% context left  "
    ])

