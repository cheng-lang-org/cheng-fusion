# TUI bottom_pane/chat_composer.rs basic terminal.backend() oracle.

import std/strings

fn RustCsgTuiChatComposerBasicSpaces(count: int32): str =
    var out: str = ""
    var i: int32 = 0
    while i < count:
        out = strings.ConcatStr(out, " ")
        i = i + 1
    return out

fn RustCsgTuiChatComposerBasicStartsWithAt(text: str, index: int32, prefix: str): bool =
    let prefixLen: int32 = strings.Len(prefix)
    if index < 0:
        return false
    if index + prefixLen > strings.Len(text):
        return false
    return strings.SliceBytes(text, index, prefixLen) == prefix

fn RustCsgTuiChatComposerBasicNextGlyph(text: str, index: int32): str =
    if RustCsgTuiChatComposerBasicStartsWithAt(text, index, "›"):
        return "›"
    return strings.SliceBytes(text, index, 1)

fn RustCsgTuiChatComposerBasicDisplayWidth(text: str): int32 =
    var width: int32 = 0
    var i: int32 = 0
    while i < strings.Len(text):
        let glyph: str = RustCsgTuiChatComposerBasicNextGlyph(text, i)
        width = width + 1
        i = i + strings.Len(glyph)
    return width

fn RustCsgTuiChatComposerBasicPadLine(text: str, width: int32): str =
    let currentWidth: int32 = RustCsgTuiChatComposerBasicDisplayWidth(text)
    if currentWidth > width:
        assert(false, "chat composer basic oracle line exceeds width")
    return strings.ConcatStr(text, RustCsgTuiChatComposerBasicSpaces(width - currentWidth))

fn RustCsgTuiChatComposerBasicBackend(width: int32, lines: str[]): str =
    var out: str = ""
    var i: int32 = 0
    while i < lines.len:
        out = strings.ConcatStr(out, "\"")
        out = strings.ConcatStr(out, RustCsgTuiChatComposerBasicPadLine(lines[i], width))
        out = strings.ConcatStr(out, "\"\n")
        i = i + 1
    return out

fn RustCsgTuiChatComposerBasicFooterEmpty(): str =
    return "  ? for shortcuts                                                                100% context left  "

fn RustCsgTuiChatComposerBasicFooterPlain(): str =
    return "                                                                                 100% context left  "

fn RustCsgTuiChatComposerBasicEmptySnapshot(): str =
    return RustCsgTuiChatComposerBasicBackend(100, [
        "",
        "› Ask Codex to do anything",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        RustCsgTuiChatComposerBasicFooterEmpty()
    ])

