# TUI chatwidget queued messages snapshot oracle.

import std/strutils as strutil

fn RustCsgTuiChatwidgetQueuedMessagesLines(lines: str[]): str =
    return strutil.Join([strutil.Join(lines, "\n"), "\n"], "")

fn RustCsgTuiChatwidgetCompactQueuesUserMessages(): str =
    return RustCsgTuiChatwidgetQueuedMessagesLines([
        "• Working (0s • esc to interrupt)",
        "",
        "• Messages to be submitted at end of turn",
        "  ↳ Steer submitted while /compact was running.",
        "",
        "› Ask Codex to do anything",
        "",
        "  gpt-5.3-codex default · 100% left · /tmp/project",
    ])

fn RustCsgTuiChatwidgetReviewQueuesUserMessages(): str =
    return RustCsgTuiChatwidgetQueuedMessagesLines([
        "• Working (0s • esc to interrupt)",
        "",
        "• Messages to be submitted at end of turn",
        "  ↳ Steer submitted while /review was running.",
        "",
        "› Ask Codex to do anything",
        "",
        "  gpt-5.3-codex default · 100% left · /tmp/project",
    ])
