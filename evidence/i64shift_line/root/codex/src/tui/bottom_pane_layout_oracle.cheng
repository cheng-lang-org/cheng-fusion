# TUI bottom_pane/mod.rs combined status/composer/queue raw snapshot oracle.

import std/strings

fn RustCsgTuiBottomPaneLayoutSpaces(count: int32): str =
    var out: str = ""
    var i: int32 = 0
    while i < count:
        out = strings.ConcatStr(out, " ")
        i = i + 1
    return out

fn RustCsgTuiBottomPaneLayoutStartsWithAt(text: str, index: int32, prefix: str): bool =
    let prefixLen: int32 = strings.Len(prefix)
    if index < 0:
        return false
    if index + prefixLen > strings.Len(text):
        return false
    return strings.SliceBytes(text, index, prefixLen) == prefix

fn RustCsgTuiBottomPaneLayoutNextGlyph(text: str, index: int32): str =
    if RustCsgTuiBottomPaneLayoutStartsWithAt(text, index, "•"):
        return "•"
    if RustCsgTuiBottomPaneLayoutStartsWithAt(text, index, "›"):
        return "›"
    if RustCsgTuiBottomPaneLayoutStartsWithAt(text, index, "↳"):
        return "↳"
    if RustCsgTuiBottomPaneLayoutStartsWithAt(text, index, "⌥"):
        return "⌥"
    if RustCsgTuiBottomPaneLayoutStartsWithAt(text, index, "↑"):
        return "↑"
    if RustCsgTuiBottomPaneLayoutStartsWithAt(text, index, "└"):
        return "└"
    if RustCsgTuiBottomPaneLayoutStartsWithAt(text, index, "…"):
        return "…"
    return strings.SliceBytes(text, index, 1)

fn RustCsgTuiBottomPaneLayoutDisplayWidth(text: str): int32 =
    var width: int32 = 0
    var i: int32 = 0
    while i < strings.Len(text):
        let glyph: str = RustCsgTuiBottomPaneLayoutNextGlyph(text, i)
        width = width + 1
        i = i + strings.Len(glyph)
    return width

fn RustCsgTuiBottomPaneLayoutPadLine(text: str, width: int32): str =
    let currentWidth: int32 = RustCsgTuiBottomPaneLayoutDisplayWidth(text)
    if currentWidth > width:
        assert(false, "bottom pane layout oracle line exceeds width")
    return strings.ConcatStr(text, RustCsgTuiBottomPaneLayoutSpaces(width - currentWidth))

fn RustCsgTuiBottomPaneLayoutRenderSnapshot(width: int32, lines: str[]): str =
    var out: str = ""
    var i: int32 = 0
    while i < lines.len:
        if i + 1 == lines.len:
            out = strings.ConcatStr(out, lines[i])
        else:
            out = strings.ConcatStr(out, RustCsgTuiBottomPaneLayoutPadLine(lines[i], width))
        out = strings.ConcatStr(out, "\n")
        i = i + 1
    return out

fn RustCsgTuiBottomPaneLayoutQueuedMessagesVisibleWhenStatusHiddenSnapshot(): str =
    return RustCsgTuiBottomPaneLayoutRenderSnapshot(48, [
        "• Queued follow-up messages",
        "  ↳ Queued follow-up question",
        "    ⌥ + ↑ edit last queued message",
        "",
        "› Ask Codex to do anything",
        "",
        "  ? for shortcuts            100% context left"
    ])

