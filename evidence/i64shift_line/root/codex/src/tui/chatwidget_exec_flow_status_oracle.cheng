# TUI chatwidget exec_flow status snapshot oracle.

import std/strings
import std/strutils as strutil

fn RustCsgTuiChatwidgetExecFlowStatusLines(lines: str[]): str =
    return strutil.Join([strutil.Join(lines, "\n"), "\n"], "")

fn RustCsgTuiChatwidgetExecFlowStatusSpaces(count: int32): str =
    var out: str = ""
    var i: int32 = 0
    while i < count:
        out = strings.ConcatStr(out, " ")
        i = i + 1
    return out

fn RustCsgTuiChatwidgetExecFlowStatusRepeat(text: str, count: int32): str =
    var out: str = ""
    var i: int32 = 0
    while i < count:
        out = strings.ConcatStr(out, text)
        i = i + 1
    return out

fn RustCsgTuiChatwidgetExecFlowStatusQuotedRow(text: str, trailingSpaces: int32): str =
    return strutil.Join(["\"", text, RustCsgTuiChatwidgetExecFlowStatusSpaces(trailingSpaces), "\"\n"], "")

fn RustCsgTuiChatwidgetPreambleKeepsWorkingStatus(): str =
    return strutil.Join([
        RustCsgTuiChatwidgetExecFlowStatusQuotedRow("", 80),
        RustCsgTuiChatwidgetExecFlowStatusQuotedRow("• Working (0s • esc to interrupt)", 47),
        RustCsgTuiChatwidgetExecFlowStatusQuotedRow("", 80),
        RustCsgTuiChatwidgetExecFlowStatusQuotedRow("", 80),
        RustCsgTuiChatwidgetExecFlowStatusQuotedRow("› Ask Codex to do anything", 54),
        RustCsgTuiChatwidgetExecFlowStatusQuotedRow("", 80),
        RustCsgTuiChatwidgetExecFlowStatusQuotedRow("  gpt-5.3-codex default · 100% left · /tmp/project", 30),
    ], "")

fn RustCsgTuiChatwidgetUnifiedExecBeginRestoresWorkingStatus(): str =
    return strutil.Join([
        RustCsgTuiChatwidgetExecFlowStatusQuotedRow("", 80),
        RustCsgTuiChatwidgetExecFlowStatusQuotedRow("• Working (0s • esc to interrupt) · 1 background terminal running · /ps to view…", 0),
        RustCsgTuiChatwidgetExecFlowStatusQuotedRow("", 80),
        RustCsgTuiChatwidgetExecFlowStatusQuotedRow("", 80),
        RustCsgTuiChatwidgetExecFlowStatusQuotedRow("› Ask Codex to do anything", 54),
        RustCsgTuiChatwidgetExecFlowStatusQuotedRow("", 80),
        RustCsgTuiChatwidgetExecFlowStatusQuotedRow("  gpt-5.3-codex default · 100% left · /tmp/project", 30),
    ], "")

fn RustCsgTuiChatwidgetUnifiedExecWaitStatusSingleDetailsRow(): str =
    return RustCsgTuiChatwidgetExecFlowStatusLines([
        "• Waiting for background terminal (0s • esc to …",
        "  └ cargo test -p codex-core -- --exact…",
        "",
        "",
        "› Ask Codex to do anything",
        "",
        "  gpt-5.3-codex default · 100% left · /tmp/proj…",
    ])

fn RustCsgTuiChatwidgetFinalWorkedForUsesCumulativeTurnDuration(): str =
    return RustCsgTuiChatwidgetExecFlowStatusLines([
        "• Ran echo preparing",
        "  └ preparing",
        "",
        RustCsgTuiChatwidgetExecFlowStatusRepeat("─", 80),
        "",
        "• Final response.",
        "",
        strings.ConcatStr("─ Worked for 2m 05s ", RustCsgTuiChatwidgetExecFlowStatusRepeat("─", 60)),
    ])
