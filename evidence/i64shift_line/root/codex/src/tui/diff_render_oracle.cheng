fn RustCsgTuiDiffRenderOracleRenderEditedTextFile(file: var RustCsgTuiDiffRenderEditedFile): str =
    if file.lineNumbers.len != file.markers.len:
        assert(false, "edited diff oracle lineNumbers/markers length mismatch")
    if file.lineNumbers.len != file.texts.len:
        assert(false, "edited diff oracle lineNumbers/texts length mismatch")
    if file.totalRows != file.lineNumbers.len + 1:
        assert(false, "edited diff oracle text totalRows mismatch")

    var out: str = RustCsgTuiDiffRenderOracleRenderEditedTextHeader(file)
    out = strings.ConcatStr(out, "\n")

    var index: int32 = 0
    while index < file.lineNumbers.len:
        if strings.Len(file.markers[index]) != 1:
            assert(false, "edited diff oracle marker must be one byte")
        out = strings.ConcatStr(out, RustCsgTuiDiffRenderOracleRenderTextDiffLine(file.lineNumbers[index], file.markers[index], file.texts[index]))
        out = strings.ConcatStr(out, "\n")
        index = index + 1
    return out

fn RustCsgTuiDiffRenderOracleValidateEditedRows(file: var RustCsgTuiDiffRenderEditedFile) =
    if file.lineNumbers.len != file.markers.len:
        assert(false, "edited diff oracle lineNumbers/markers length mismatch")
    if file.lineNumbers.len != file.texts.len:
        assert(false, "edited diff oracle lineNumbers/texts length mismatch")

fn RustCsgTuiDiffRenderOracleAppendMultiEditedFile(out: str,
                                                  file: var RustCsgTuiDiffRenderEditedFile): str =
    RustCsgTuiDiffRenderOracleValidateEditedRows(file)

    var result: str = out
    result = strings.ConcatStr(result, RustCsgTuiDiffRenderOracleRenderMultiEditedChildHeader(file))
    result = strings.ConcatStr(result, "\n")

    var index: int32 = 0
    while index < file.lineNumbers.len:
        if strings.Len(file.markers[index]) != 1:
            assert(false, "edited diff oracle marker must be one byte")
        result = strings.ConcatStr(result, RustCsgTuiDiffRenderOracleRenderDiffLine(file.lineNumbers[index], file.markers[index], file.texts[index]))
        result = strings.ConcatStr(result, "\n")
        index = index + 1
    return result

fn RustCsgTuiDiffRenderOracleRenderMultipleEditedFiles(files: RustCsgTuiDiffRenderEditedFile[],
                                                       totalRows: int32): str =
    if files.len <= 0:
        assert(false, "multi edited diff oracle requires at least one file")

    var addedCount: int32 = 0
    var deletedCount: int32 = 0
    var renderedRows: int32 = 1
    var index: int32 = 0
    while index < files.len:
        RustCsgTuiDiffRenderOracleValidateEditedRows(files[index])
        addedCount = addedCount + files[index].addedCount
        deletedCount = deletedCount + files[index].deletedCount
        renderedRows = renderedRows + 1 + files[index].lineNumbers.len
        if index + 1 < files.len:
            renderedRows = renderedRows + 1
        index = index + 1

    if totalRows < renderedRows:
        assert(false, "multi edited diff oracle totalRows too small")

    var out: str = RustCsgTuiDiffRenderOracleRenderMultiEditedHeader(files.len, addedCount, deletedCount)
    out = strings.ConcatStr(out, "\n")

    index = 0
    while index < files.len:
        out = RustCsgTuiDiffRenderOracleAppendMultiEditedFile(out, files[index])
        if index + 1 < files.len:
            out = strings.ConcatStr(out, RustCsgTuiDiffRenderOracleBlankLine())
            out = strings.ConcatStr(out, "\n")
        index = index + 1

    while renderedRows < totalRows:
        out = strings.ConcatStr(out, RustCsgTuiDiffRenderOracleBlankLine())
        out = strings.ConcatStr(out, "\n")
        renderedRows = renderedRows + 1
    return out

fn RustCsgTuiDiffRenderOracleHiddenAnnotation(line: str): str =
    if strings.StrContains(line, "emoji: 🚀✨ and CJK: 你好世界"):
        return " Hidden by multi-width symbols: [(29, \" \"), (31, \" \"), (43, \" \"), (45, \" \"), (47, \" \"), (49, \" \")]"
    if strings.StrContains(line, "city\t東京"):
        return " Hidden by multi-width symbols: [(13, \" \"), (15, \" \")]"
    if strings.StrContains(line, "rocket\t🚀"):
        return " Hidden by multi-width symbols: [(15, \" \")]"
    return ""

fn RustCsgTuiDiffRenderOracleQuoteTerminalLine(line: str): str =
    return strutil.Join(["\"", line, "\"", RustCsgTuiDiffRenderOracleHiddenAnnotation(line)], "")

fn RustCsgTuiDiffRenderOracleQuoteTerminalSnapshot(body: str): str =
    if strings.Len(body) == 0:
        return ""
    var out: str = ""
    var lineStart: int32 = 0
    var i: int32
    while i < strings.Len(body):
        if body[i] == '\n':
            let line = strings.SliceBytes(body, lineStart, i - lineStart)
            out = strings.ConcatStr(out, RustCsgTuiDiffRenderOracleQuoteTerminalLine(line))
            out = strings.ConcatStr(out, "\n")
            lineStart = i + 1
        i = i + 1
    if lineStart < strings.Len(body):
        out = strings.ConcatStr(out, RustCsgTuiDiffRenderOracleQuoteTerminalLine(strings.SliceBytes(body, lineStart, strings.Len(body) - lineStart)))
    return out

fn RustCsgTuiDiffRenderOracleAppendBlankRows(out: str, renderedRows: int32, totalRows: int32, width: int32): str =
    if renderedRows > totalRows:
        assert(false, "diff oracle fixture rendered too many rows")
    var result: str = out
    var row: int32 = renderedRows
    while row < totalRows:
        result = strings.ConcatStr(result, RustCsgTuiDiffRenderOracleBlankLineWidth(width))
        result = strings.ConcatStr(result, "\n")
        row = row + 1
    return result

fn RustCsgTuiDiffRenderOracleApplyAddBlockFixture(): str =
    var out: str = RustCsgTuiDiffRenderOraclePadCells("• Added new_file.txt (+2 -0)", 80)
    out = strings.ConcatStr(out, "\n")
    out = strings.ConcatStr(out, RustCsgTuiDiffRenderOracleRenderAddedLine(1, "alpha"))
    out = strings.ConcatStr(out, "\n")
    out = strings.ConcatStr(out, RustCsgTuiDiffRenderOracleRenderAddedLine(2, "beta"))
    out = strings.ConcatStr(out, "\n")
    return RustCsgTuiDiffRenderOracleQuoteTerminalSnapshot(RustCsgTuiDiffRenderOracleAppendBlankRows(out, 3, 10, 80))

fn RustCsgTuiDiffRenderOracleApplyDeleteBlockFixture(): str =
    var out: str = RustCsgTuiDiffRenderOraclePadCells("• Deleted tmp_delete_example.txt (+0 -3)", 80)
    out = strings.ConcatStr(out, "\n")
    out = strings.ConcatStr(out, RustCsgTuiDiffRenderOracleRenderDeletedLine(1, "first"))
    out = strings.ConcatStr(out, "\n")
    out = strings.ConcatStr(out, RustCsgTuiDiffRenderOracleRenderDeletedLine(2, "second"))
