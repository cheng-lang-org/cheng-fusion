# Small Cheng renderer for selected Rust TUI diff-render oracle slices.

import std/strings
import std/strutils as strutil

type
    RustCsgTuiDiffRenderAddedFile =
        name: str
        lines: str[]

    RustCsgTuiDiffRenderDeletedFile =
        name: str
        lines: str[]
        totalRows: int32

    RustCsgTuiDiffRenderEditedFile =
        name: str
        addedCount: int32
        deletedCount: int32
        lineNumbers: int32[]
        markers: str[]
        texts: str[]
        totalRows: int32

    RustCsgTuiDiffRenderRenamedFile =
        oldName: str
        newName: str
        addedCount: int32
        deletedCount: int32
        lineNumbers: int32[]
        markers: str[]
        texts: str[]
        totalRows: int32

fn RustCsgTuiDiffRenderOracleSpaces(count: int32): str =
    var out: str = ""
    var i: int32 = 0
    while i < count:
        out = strings.ConcatStr(out, " ")
        i = i + 1
    return out

fn RustCsgTuiDiffRenderOraclePadBytes(line: str, byteWidth: int32): str =
    let n = strings.Len(line)
    if n > byteWidth:
        return line
    return strings.ConcatStr(line, RustCsgTuiDiffRenderOracleSpaces(byteWidth - n))

fn RustCsgTuiDiffRenderOraclePadCells(line: str, cellWidth: int32): str =
    var byteWidth: int32 = cellWidth
    if strings.HasPrefix(line, "•"):
        byteWidth = cellWidth + 2
    if strings.StrContains(line, "└"):
        byteWidth = byteWidth + 2
    if strings.StrContains(line, "→"):
        byteWidth = byteWidth + 2
    if strings.StrContains(line, "🚀"):
        byteWidth = byteWidth + 2
    if strings.StrContains(line, "✨"):
        byteWidth = byteWidth + 1
    if strings.StrContains(line, "東京"):
        byteWidth = byteWidth + 2
    if strings.StrContains(line, "你好世界"):
        byteWidth = byteWidth + 4
    if strings.StrContains(line, "⋮"):
        byteWidth = byteWidth + 2
    return RustCsgTuiDiffRenderOraclePadBytes(line, byteWidth)

fn RustCsgTuiDiffRenderOracleLineNumberPrefixWidth(lineNumber: int32, width: int32): str =
    let digits = strings.IntToStr(lineNumber)
    if strings.Len(digits) > width:
        assert(false, "diff oracle line number width too small")
    return strings.ConcatStr(RustCsgTuiDiffRenderOracleSpaces(width - strings.Len(digits)), digits)

fn RustCsgTuiDiffRenderOracleLineNumberPrefix(lineNumber: int32): str =
    return RustCsgTuiDiffRenderOracleLineNumberPrefixWidth(lineNumber, 5)

fn RustCsgTuiDiffRenderOracleTextLineNumberPrefix(lineNumber: int32): str =
    return RustCsgTuiDiffRenderOracleLineNumberPrefixWidth(lineNumber, 7)

fn RustCsgTuiDiffRenderOracleProposedChangeLineNumberPrefix(lineNumber: int32): str =
    return strings.ConcatStr("    ", strings.IntToStr(lineNumber))

fn RustCsgTuiDiffRenderOracleRenderHeader(file: var RustCsgTuiDiffRenderAddedFile): str =
    let addedCount = strings.IntToStr(file.lines.len)
    return RustCsgTuiDiffRenderOraclePadCells(
        strutil.Join(["• Added ", file.name, " (+", addedCount, " -0)"], ""),
        80)

fn RustCsgTuiDiffRenderOracleRenderAddedLine(lineNumber: int32, text: str): str =
    return RustCsgTuiDiffRenderOraclePadCells(
        strutil.Join([RustCsgTuiDiffRenderOracleLineNumberPrefix(lineNumber), " +", text], ""),
        80)

fn RustCsgTuiDiffRenderOracleRenderDeletedHeader(file: var RustCsgTuiDiffRenderDeletedFile): str =
    let deletedCount = strings.IntToStr(file.lines.len)
    return RustCsgTuiDiffRenderOraclePadCells(
        strutil.Join(["• Deleted ", file.name, " (+0 -", deletedCount, ")"], ""),
        80)

fn RustCsgTuiDiffRenderOracleRenderDeletedLine(lineNumber: int32, text: str): str =
    return RustCsgTuiDiffRenderOraclePadCells(
        strutil.Join([RustCsgTuiDiffRenderOracleLineNumberPrefix(lineNumber), " -", text], ""),
        80)

fn RustCsgTuiDiffRenderOracleRenderDiffLine(lineNumber: int32, marker: str, text: str): str =
    return RustCsgTuiDiffRenderOraclePadCells(
        strutil.Join([RustCsgTuiDiffRenderOracleLineNumberPrefix(lineNumber), " ", marker, text], ""),
        80)

fn RustCsgTuiDiffRenderOracleRenderProposedChangeDiffLine(lineNumber: int32, marker: str, text: str): str =
    let prefix = RustCsgTuiDiffRenderOracleProposedChangeLineNumberPrefix(lineNumber)
    let spaceCount = 10 - strings.Len(prefix)
    if spaceCount < 0:
        assert(false, "proposed diff oracle line number too wide")
    return RustCsgTuiDiffRenderOraclePadCells(
        strutil.Join([prefix, RustCsgTuiDiffRenderOracleSpaces(spaceCount), marker, text], ""),
        80)

fn RustCsgTuiDiffRenderOracleRenderTextDiffLine(lineNumber: int32, marker: str, text: str): str =
    return strutil.Join([RustCsgTuiDiffRenderOracleTextLineNumberPrefix(lineNumber), " ", marker, text], "")

fn RustCsgTuiDiffRenderOracleBlankLine(): str =
    return RustCsgTuiDiffRenderOracleSpaces(80)

fn RustCsgTuiDiffRenderOracleBlankLineWidth(width: int32): str =
    if width < 0:
        assert(false, "diff oracle negative blank width")
    return RustCsgTuiDiffRenderOracleSpaces(width)

fn RustCsgTuiDiffRenderOracleRenderWrappedInsertLine(lineNumber: int32,
                                                     text: str,
                                                     contentWidth: int32,
                                                     canvasWidth: int32,
                                                     totalRows: int32): str =
    if lineNumber <= 0:
        assert(false, "wrapped insert diff oracle line number must be positive")
    if strings.Len(text) == 0:
        assert(false, "wrapped insert diff oracle text is empty")
    if contentWidth <= 0:
        assert(false, "wrapped insert diff oracle content width must be positive")
    if canvasWidth < contentWidth:
        assert(false, "wrapped insert diff oracle canvas width too small")

    let firstPrefix = strutil.Join([strings.IntToStr(lineNumber), " +"], "")
    let continuationPrefix = RustCsgTuiDiffRenderOracleSpaces(strings.Len(firstPrefix))
    var out: str = ""
    var offset: int32 = 0
    var renderedRows: int32 = 0
    let textLen = strings.Len(text)
    while offset < textLen:
        var prefix: str = firstPrefix
        if renderedRows > 0:
            prefix = continuationPrefix
        let available = contentWidth - strings.Len(prefix)
        if available <= 0:
            assert(false, "wrapped insert diff oracle content width leaves no text room")
        var take: int32 = textLen - offset
        if take > available:
            take = available
        let line = strutil.Join([prefix, strings.SliceBytes(text, offset, take)], "")
        out = strings.ConcatStr(out, RustCsgTuiDiffRenderOraclePadBytes(line, canvasWidth))
        out = strings.ConcatStr(out, "\n")
        offset = offset + take
        renderedRows = renderedRows + 1

    if totalRows < renderedRows:
        assert(false, "wrapped insert diff oracle totalRows too small")
    while renderedRows < totalRows:
        out = strings.ConcatStr(out, RustCsgTuiDiffRenderOracleBlankLineWidth(canvasWidth))
        out = strings.ConcatStr(out, "\n")
        renderedRows = renderedRows + 1
    return out

fn RustCsgTuiDiffRenderOracleProposedChangeEllipsisLine(): str =
    return RustCsgTuiDiffRenderOraclePadCells("    ⋮", 80)

fn RustCsgTuiDiffRenderOracleRenderAnsi16InsertDeleteNoBackground(file: var RustCsgTuiDiffRenderEditedFile,
                                                                  width: int32): str =
    if file.lineNumbers.len != file.markers.len:
        assert(false, "ansi16 diff oracle lineNumbers/markers length mismatch")
    if file.lineNumbers.len != file.texts.len:
        assert(false, "ansi16 diff oracle lineNumbers/texts length mismatch")
    if file.totalRows < file.lineNumbers.len:
        assert(false, "ansi16 diff oracle totalRows too small")
    if width <= 0:
        assert(false, "ansi16 diff oracle width must be positive")

    var out: str = ""
    var row: int32 = 0
    while row < file.totalRows:
        if row < file.lineNumbers.len:
            if strings.Len(file.markers[row]) != 1:
                assert(false, "ansi16 diff oracle marker must be one byte")
            let rendered = strutil.Join([strings.IntToStr(file.lineNumbers[row]), " ", file.markers[row], file.texts[row]], "")
            out = strings.ConcatStr(out, RustCsgTuiDiffRenderOraclePadCells(rendered, width))
        else:
            out = strings.ConcatStr(out, RustCsgTuiDiffRenderOracleBlankLineWidth(width))
        out = strings.ConcatStr(out, "\n")
        row = row + 1
    return out

fn RustCsgTuiDiffRenderOracleRenderAddedFile(file: var RustCsgTuiDiffRenderAddedFile): str =
    var out: str = RustCsgTuiDiffRenderOracleRenderHeader(file)
    out = strings.ConcatStr(out, "\n")

    var row: int32 = 1
    while row < 10:
        if row <= file.lines.len:
            out = strings.ConcatStr(out, RustCsgTuiDiffRenderOracleRenderAddedLine(row, file.lines[row - 1]))
        else:
            out = strings.ConcatStr(out, RustCsgTuiDiffRenderOracleBlankLine())
        out = strings.ConcatStr(out, "\n")
        row = row + 1
    return out

fn RustCsgTuiDiffRenderOracleRenderDeletedFile(file: var RustCsgTuiDiffRenderDeletedFile): str =
    if file.totalRows < file.lines.len + 1:
        assert(false, "deleted diff oracle totalRows too small")

    var out: str = RustCsgTuiDiffRenderOracleRenderDeletedHeader(file)
    out = strings.ConcatStr(out, "\n")

    var row: int32 = 1
    while row < file.totalRows:
        if row <= file.lines.len:
            out = strings.ConcatStr(out, RustCsgTuiDiffRenderOracleRenderDeletedLine(row, file.lines[row - 1]))
        else:
            out = strings.ConcatStr(out, RustCsgTuiDiffRenderOracleBlankLine())
        out = strings.ConcatStr(out, "\n")
        row = row + 1
    return out

fn RustCsgTuiDiffRenderOracleRenderEditedHeader(file: var RustCsgTuiDiffRenderEditedFile): str =
    return RustCsgTuiDiffRenderOraclePadCells(
        strutil.Join(["• Edited ", file.name, " (+", strings.IntToStr(file.addedCount),
                      " -", strings.IntToStr(file.deletedCount), ")"], ""),
        80)

fn RustCsgTuiDiffRenderOracleRenderProposedChangeHeader(file: var RustCsgTuiDiffRenderEditedFile): str =
    return RustCsgTuiDiffRenderOraclePadCells(
        strutil.Join(["• Proposed Change ", file.name, " (+", strings.IntToStr(file.addedCount),
                      " -", strings.IntToStr(file.deletedCount), ")"], ""),
        80)

fn RustCsgTuiDiffRenderOracleRenderProposedChangeRenamedHeader(file: var RustCsgTuiDiffRenderRenamedFile): str =
    return RustCsgTuiDiffRenderOraclePadCells(
        strutil.Join(["• Proposed Change ", file.oldName, " → ", file.newName, " (+",
                      strings.IntToStr(file.addedCount), " -",
                      strings.IntToStr(file.deletedCount), ")"], ""),
        80)

fn RustCsgTuiDiffRenderOracleRenderRenamedHeader(file: var RustCsgTuiDiffRenderRenamedFile): str =
    return RustCsgTuiDiffRenderOraclePadCells(
        strutil.Join(["• Edited ", file.oldName, " → ", file.newName, " (+",
                      strings.IntToStr(file.addedCount), " -",
                      strings.IntToStr(file.deletedCount), ")"], ""),
        80)

fn RustCsgTuiDiffRenderOracleRenderEditedTextHeader(file: var RustCsgTuiDiffRenderEditedFile): str =
    return strutil.Join(["• Edited ", file.name, " (+", strings.IntToStr(file.addedCount),
                         " -", strings.IntToStr(file.deletedCount), ")"], "")

fn RustCsgTuiDiffRenderOracleRenderMultiEditedHeader(fileCount: int32,
                                                     addedCount: int32,
                                                     deletedCount: int32): str =
    return RustCsgTuiDiffRenderOraclePadCells(
        strutil.Join(["• Edited ", strings.IntToStr(fileCount), " files (+",
                      strings.IntToStr(addedCount), " -", strings.IntToStr(deletedCount), ")"], ""),
        80)

fn RustCsgTuiDiffRenderOracleRenderMultiEditedChildHeader(file: var RustCsgTuiDiffRenderEditedFile): str =
    return RustCsgTuiDiffRenderOraclePadBytes(
        strutil.Join(["  └ ", file.name, " (+", strings.IntToStr(file.addedCount),
                      " -", strings.IntToStr(file.deletedCount), ")"], ""),
        82)

fn RustCsgTuiDiffRenderOracleRenderEditedFile(file: var RustCsgTuiDiffRenderEditedFile): str =
    if file.lineNumbers.len != file.markers.len:
        assert(false, "edited diff oracle lineNumbers/markers length mismatch")
    if file.lineNumbers.len != file.texts.len:
        assert(false, "edited diff oracle lineNumbers/texts length mismatch")
    if file.totalRows < file.lineNumbers.len + 1:
        assert(false, "edited diff oracle totalRows too small")

    var out: str = RustCsgTuiDiffRenderOracleRenderEditedHeader(file)
    out = strings.ConcatStr(out, "\n")

    var row: int32 = 1
    while row < file.totalRows:
        let index = row - 1
        if index < file.lineNumbers.len:
            if strings.Len(file.markers[index]) != 1:
                assert(false, "edited diff oracle marker must be one byte")
            out = strings.ConcatStr(out, RustCsgTuiDiffRenderOracleRenderDiffLine(file.lineNumbers[index], file.markers[index], file.texts[index]))
        else:
            out = strings.ConcatStr(out, RustCsgTuiDiffRenderOracleBlankLine())
        out = strings.ConcatStr(out, "\n")
        row = row + 1
    return out

fn RustCsgTuiDiffRenderOracleRenderProposedChangeFile(file: var RustCsgTuiDiffRenderEditedFile): str =
    if file.lineNumbers.len != file.markers.len:
        assert(false, "proposed diff oracle lineNumbers/markers length mismatch")
    if file.lineNumbers.len != file.texts.len:
        assert(false, "proposed diff oracle lineNumbers/texts length mismatch")
    if file.totalRows < file.lineNumbers.len + 1:
        assert(false, "proposed diff oracle totalRows too small")

    var out: str = RustCsgTuiDiffRenderOracleRenderProposedChangeHeader(file)
    out = strings.ConcatStr(out, "\n")

    var row: int32 = 1
    while row < file.totalRows:
        let index = row - 1
        if index < file.lineNumbers.len:
            if strings.Len(file.markers[index]) != 1:
                assert(false, "proposed diff oracle marker must be one byte")
            out = strings.ConcatStr(out, RustCsgTuiDiffRenderOracleRenderProposedChangeDiffLine(file.lineNumbers[index], file.markers[index], file.texts[index]))
        else:
            out = strings.ConcatStr(out, RustCsgTuiDiffRenderOracleBlankLine())
        out = strings.ConcatStr(out, "\n")
        row = row + 1
    return out

fn RustCsgTuiDiffRenderOracleRenderProposedChangeFileWithEllipsis(file: var RustCsgTuiDiffRenderEditedFile,
                                                                  ellipsisAfterRows: int32): str =
    if file.lineNumbers.len != file.markers.len:
        assert(false, "proposed ellipsis diff oracle lineNumbers/markers length mismatch")
    if file.lineNumbers.len != file.texts.len:
        assert(false, "proposed ellipsis diff oracle lineNumbers/texts length mismatch")
    if ellipsisAfterRows < 0:
        assert(false, "proposed ellipsis diff oracle negative ellipsis row")
    if ellipsisAfterRows > file.lineNumbers.len:
        assert(false, "proposed ellipsis diff oracle ellipsis row out of range")
    if file.totalRows < file.lineNumbers.len + 2:
        assert(false, "proposed ellipsis diff oracle totalRows too small")

    var out: str = RustCsgTuiDiffRenderOracleRenderProposedChangeHeader(file)
    out = strings.ConcatStr(out, "\n")

    var row: int32 = 1
    var renderedRows: int32 = 0
    var ellipsisWritten: bool = false
    while row < file.totalRows:
        if renderedRows == ellipsisAfterRows && !ellipsisWritten:
            out = strings.ConcatStr(out, RustCsgTuiDiffRenderOracleProposedChangeEllipsisLine())
            ellipsisWritten = true
        elif renderedRows < file.lineNumbers.len:
            if strings.Len(file.markers[renderedRows]) != 1:
                assert(false, "proposed ellipsis diff oracle marker must be one byte")
            out = strings.ConcatStr(out, RustCsgTuiDiffRenderOracleRenderProposedChangeDiffLine(file.lineNumbers[renderedRows], file.markers[renderedRows], file.texts[renderedRows]))
            renderedRows = renderedRows + 1
        else:
            out = strings.ConcatStr(out, RustCsgTuiDiffRenderOracleBlankLine())
        out = strings.ConcatStr(out, "\n")
        row = row + 1
    return out

