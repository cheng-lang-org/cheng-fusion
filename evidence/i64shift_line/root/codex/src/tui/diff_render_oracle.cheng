# ApplyUpdateBlockWrapsLongLines terminal backend fixture (80-col padded).
fn RustCsgTuiDiffRenderOracleApplyUpdateBlockWrapsLongLinesFixture(): str =
    var file: RustCsgTuiDiffRenderEditedFile
    file.name = "long_example.txt"
    file.addedCount = 1
    file.deletedCount = 1
    file.lineNumbers = []
    add(file.lineNumbers, 1)
    add(file.lineNumbers, 2)
    add(file.lineNumbers, 2)
    add(file.lineNumbers, 3)
    file.markers = [" ", "-", "+", " "]
    file.texts = ["line 1", "short", "short this_is_a_very_long_modified_line_that_should_wrap_across_multiple_terminal_columns_and_continue_even_further_beyond_eighty_columns_to_force_multiple_wraps", "line 3"]
    file.totalRows = 12

    if file.lineNumbers.len != file.markers.len:
        assert(false, "wrap long lines diff oracle lineNumbers/markers length mismatch")
    if file.lineNumbers.len != file.texts.len:
        assert(false, "wrap long lines diff oracle lineNumbers/texts length mismatch")
    if file.totalRows < file.lineNumbers.len + 1:
        assert(false, "wrap long lines diff oracle totalRows too small")

    var out: str = RustCsgTuiDiffRenderOracleRenderEditedHeader(file)
    out = strings.ConcatStr(out, "\n")

    var index: int32 = 0
    while index < file.lineNumbers.len:
        if strings.Len(file.markers[index]) != 1:
            assert(false, "wrap long lines diff oracle marker must be one byte")
        let prefix = strutil.Join([RustCsgTuiDiffRenderOracleLineNumberPrefix(file.lineNumbers[index]), " ", file.markers[index]], "")
        let contPrefix = RustCsgTuiDiffRenderOracleSpaces(strings.Len(prefix))
        let text = file.texts[index]
        var offset: int32 = 0
        var first: bool = true
        while offset < strings.Len(text):
            var p: str = prefix
            if !first:
                p = contPrefix
            first = false
            let avail = 72 - strings.Len(p)
            var take: int32 = strings.Len(text) - offset
            if take > avail:
                take = avail
            if take <= 0:
                assert(false, "wrap long lines diff oracle 72-col text area too narrow")
            let line = strutil.Join([p, strings.SliceBytes(text, offset, take)], "")
            out = strings.ConcatStr(out, RustCsgTuiDiffRenderOraclePadBytes(line, 80))
            out = strings.ConcatStr(out, "\n")
            offset = offset + take
        index = index + 1

    return RustCsgTuiDiffRenderOracleQuoteTerminalSnapshot(RustCsgTuiDiffRenderOracleAppendBlankRows(out, 7, file.totalRows, 80))

