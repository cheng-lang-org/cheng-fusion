fn RustCsgTuiDiffRenderOracleRenderSyntaxHighlightedInsertWrapsRaw(width: int32): str =
    if width <= 3:
        assert(false, "syntax highlighted insert wraps raw width too narrow")
    let prefix = "1 +"
    let contPrefix = "   "
    let text = "fn very_long_function_name(arg_one: String, arg_two: String, arg_three: String, arg_four: String) -> Result<String, Box<dyn std::error::Error>> { Ok(arg_one) }"

    var out: str = ""
    var offset: int32 = 0
    var first: bool = true
    while offset < strings.Len(text):
        var p: str = prefix
        if !first:
            p = contPrefix
        first = false
        let avail = width - strings.Len(p)
        var take: int32 = strings.Len(text) - offset
        if take > avail:
            take = avail
        if take <= 0:
            assert(false, "syntax highlighted insert wraps raw text area too narrow")
        let line = strutil.Join([p, strings.SliceBytes(text, offset, take)], "")
        out = strings.ConcatStr(out, line)
        if offset + take < strings.Len(text):
            out = strings.ConcatStr(out, "\n")
        offset = offset + take
    return out

