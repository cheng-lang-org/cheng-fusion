# Diff gallery: render multi-file diff at given terminal width, up to totalRows.
# Stops early if content fills totalRows; fills remaining rows with blank lines.
fn RustCsgTuiDiffRenderOracleDiffGalleryContent(width: int32, totalRows: int32): str =
    var out: str = ""
    var rows: int32 = 0

    # Header
    if rows < totalRows:
        out = strings.ConcatStr(out, RustCsgTuiDiffRenderOraclePadCells("• Edited 6 files (+9 -9)", width))
        out = strings.ConcatStr(out, "\n")
        rows = rows + 1

    # File 1: assets/banner.txt (+3 -0)
    if rows < totalRows:
        out = strings.ConcatStr(out, RustCsgTuiDiffRenderOraclePadCells("  └ assets/banner.txt (+3 -0)", width))
        out = strings.ConcatStr(out, "\n")
        rows = rows + 1
    if rows < totalRows:
        out = strings.ConcatStr(out, RustCsgTuiDiffRenderOraclePadBytes("    1 +HEADER\tVALUE", width))
        out = strings.ConcatStr(out, "\n")
        rows = rows + 1
    if rows < totalRows:
        out = strings.ConcatStr(out, RustCsgTuiDiffRenderOraclePadCells("    2 +rocket\t🚀", width))
        out = strings.ConcatStr(out, "\n")
        rows = rows + 1
    if rows < totalRows:
        out = strings.ConcatStr(out, RustCsgTuiDiffRenderOraclePadCells("    3 +city\t東京", width))
        out = strings.ConcatStr(out, "\n")
        rows = rows + 1

    # Blank separator
    if rows < totalRows:
        out = strings.ConcatStr(out, RustCsgTuiDiffRenderOraclePadBytes("", width))
        out = strings.ConcatStr(out, "\n")
        rows = rows + 1

    # File 2: examples/new_sample.rs (+3 -0)
    if rows < totalRows:
        out = strings.ConcatStr(out, RustCsgTuiDiffRenderOraclePadCells("  └ examples/new_sample.rs (+3 -0)", width))
        out = strings.ConcatStr(out, "\n")
        rows = rows + 1
    if rows < totalRows:
        out = strings.ConcatStr(out, RustCsgTuiDiffRenderOraclePadBytes("    1 +pub fn greet(name: &str) {", width))
        out = strings.ConcatStr(out, "\n")
        rows = rows + 1
    if rows < totalRows:
        out = strings.ConcatStr(out, RustCsgTuiDiffRenderOraclePadBytes("    2 +    println!(\"Hello, {name}!\");", width))
        out = strings.ConcatStr(out, "\n")
        rows = rows + 1
    if rows < totalRows:
        out = strings.ConcatStr(out, RustCsgTuiDiffRenderOraclePadBytes("    3 +}", width))
        out = strings.ConcatStr(out, "\n")
        rows = rows + 1

    # Blank separator
    if rows < totalRows:
        out = strings.ConcatStr(out, RustCsgTuiDiffRenderOraclePadBytes("", width))
        out = strings.ConcatStr(out, "\n")
        rows = rows + 1

    # File 3: legacy/old_script.py (+0 -3)
    if rows < totalRows:
        out = strings.ConcatStr(out, RustCsgTuiDiffRenderOraclePadCells("  └ legacy/old_script.py (+0 -3)", width))
        out = strings.ConcatStr(out, "\n")
        rows = rows + 1
    if rows < totalRows:
        out = strings.ConcatStr(out, RustCsgTuiDiffRenderOraclePadBytes("    1 -def legacy(x):", width))
        out = strings.ConcatStr(out, "\n")
        rows = rows + 1
    if rows < totalRows:
        out = strings.ConcatStr(out, RustCsgTuiDiffRenderOraclePadBytes("    2 -    return x + 1", width))
        out = strings.ConcatStr(out, "\n")
        rows = rows + 1
    if rows < totalRows:
        out = strings.ConcatStr(out, RustCsgTuiDiffRenderOraclePadBytes("    3 -print(legacy(3))", width))
        out = strings.ConcatStr(out, "\n")
        rows = rows + 1

    # Blank separator
    if rows < totalRows:
        out = strings.ConcatStr(out, RustCsgTuiDiffRenderOraclePadBytes("", width))
