# Render one diff line with text wrapping (text format, no fixed canvas width).
# Returns rendered lines joined by "\n".
fn RustCsgTuiDiffRenderOracleRenderWrappedDiffLine(lineNumber: int32,
                                                    marker: str,
                                                    text: str,
                                                    textAreaWidth: int32): str =
    if strings.Len(marker) != 1:
        assert(false, "wrapped diff oracle marker must be one byte")
    if textAreaWidth <= 0:
        assert(false, "wrapped diff oracle text area width must be positive")
    let firstPrefix = strutil.Join([RustCsgTuiDiffRenderOracleLineNumberPrefix(lineNumber), " ", marker], "")
    let contPrefix = RustCsgTuiDiffRenderOracleSpaces(strings.Len(firstPrefix))
    var out: str = ""
    var offset: int32 = 0
    let textLen = strings.Len(text)
    while offset < textLen:
        var prefix: str = firstPrefix
        if offset > 0:
            prefix = contPrefix
        let available = textAreaWidth - strings.Len(prefix)
        var take: int32 = textLen - offset
        if take > available:
            take = available
        if take <= 0:
            assert(false, "wrapped diff oracle text area width leaves no text room")
        var skipTrailingSpace: bool = false
        if offset + take < textLen && strings.SliceBytes(text, offset + take - 1, 1) == " ":
            take = take - 1
            skipTrailingSpace = true
        if take <= 0:
            assert(false, "wrapped diff oracle text area width consumed only whitespace")
        let line = strutil.Join([prefix, strings.SliceBytes(text, offset, take)], "")
        out = strings.ConcatStr(out, line)
        if offset + take < textLen:
            out = strings.ConcatStr(out, "\n")
        offset = offset + take
        if skipTrailingSpace:
            offset = offset + 1
    return out

# Render all lines of an edited file with text wrapping (text format).
fn RustCsgTuiDiffRenderOracleRenderWrappedEditedTextFile(file: var RustCsgTuiDiffRenderEditedFile,
                                                          textAreaWidth: int32): str =
    if file.lineNumbers.len != file.markers.len:
        assert(false, "wrapped edited text diff oracle lineNumbers/markers length mismatch")
    if file.lineNumbers.len != file.texts.len:
        assert(false, "wrapped edited text diff oracle lineNumbers/texts length mismatch")
    if file.totalRows != file.lineNumbers.len + 1:
        assert(false, "wrapped edited text diff oracle totalRows mismatch")

    var out: str = RustCsgTuiDiffRenderOracleRenderEditedTextHeader(file)
    out = strings.ConcatStr(out, "\n")

    var index: int32 = 0
    while index < file.lineNumbers.len:
        if strings.Len(file.markers[index]) != 1:
            assert(false, "wrapped edited text diff oracle marker must be one byte")
        let rendered = RustCsgTuiDiffRenderOracleRenderWrappedDiffLine(
            file.lineNumbers[index], file.markers[index], file.texts[index], textAreaWidth)
        out = strings.ConcatStr(out, rendered)
        out = strings.ConcatStr(out, "\n")
        index = index + 1
    return out

