# TUI page oracle: markdown_render, multi_agents, pager_overlay snapshot fixtures.

import std/strings
import std/strutils as strutil
import cheng/codex/tui/markdown_oracle as markdown

fn RustCsgTuiPageLines(lines: str[]): str =
    return strutil.Join([strutil.Join(lines, "\n"), "\n"], "")

fn RustCsgTuiPageSpaces(count: int32): str =
    var out: str = ""
    var i: int32 = 0
    while i < count:
        out = strings.ConcatStr(out, " ")
        i = i + 1
    return out

fn RustCsgTuiPageRepeat(text: str, count: int32): str =
    var out: str = ""
    var i: int32 = 0
    while i < count:
        out = strings.ConcatStr(out, text)
        i = i + 1
    return out

fn RustCsgTuiPageStartsWithAt(text: str, index: int32, prefix: str): bool =
    let prefixLen: int32 = strings.Len(prefix)
    if index < 0:
        return false
    if index + prefixLen > strings.Len(text):
        return false
    return strings.SliceBytes(text, index, prefixLen) == prefix

fn RustCsgTuiPageNextGlyph(text: str, index: int32): str =
    if RustCsgTuiPageStartsWithAt(text, index, "↑"):
        return "↑"
    if RustCsgTuiPageStartsWithAt(text, index, "↓"):
        return "↓"
    if RustCsgTuiPageStartsWithAt(text, index, "─"):
        return "─"
    return strings.SliceBytes(text, index, 1)

fn RustCsgTuiPageDisplayWidth(text: str): int32 =
    var width: int32 = 0
    var i: int32 = 0
    let n: int32 = strings.Len(text)
    while i < n:
        let glyph: str = RustCsgTuiPageNextGlyph(text, i)
        width = width + 1
        i = i + strings.Len(glyph)
    return width

fn RustCsgTuiPagePadDisplay(text: str, width: int32): str =
    let currentWidth: int32 = RustCsgTuiPageDisplayWidth(text)
    if currentWidth > width:
        assert(false, "page oracle line exceeds width")
    return strings.ConcatStr(text, RustCsgTuiPageSpaces(width - currentWidth))

fn RustCsgTuiPageTruncateDisplay(text: str, width: int32): str =
    if width <= 0:
        return ""
    var out: str = ""
    var used: int32 = 0
    var i: int32 = 0
    while i < strings.Len(text) && used < width:
        let glyph: str = RustCsgTuiPageNextGlyph(text, i)
        out = strings.ConcatStr(out, glyph)
        used = used + 1
        i = i + strings.Len(glyph)
    return out

fn RustCsgTuiPageQuoteLine(text: str, width: int32): str =
    return strings.ConcatStr(strings.ConcatStr("\"", RustCsgTuiPagePadDisplay(text, width)), "\"")

fn RustCsgTuiPageSpacedTitle(title: str): str =
    var out: str = ""
    var i: int32 = 0
    while i < strings.Len(title):
        if i > 0:
            out = strings.ConcatStr(out, " ")
        out = strings.ConcatStr(out, strings.SliceBytes(title, i, 1))
        i = i + 1
    return out

fn RustCsgTuiPageOverlayHeader(title: str, width: int32): str =
    var out: str = strings.ConcatStr(strings.ConcatStr("/ ", RustCsgTuiPageSpacedTitle(title)), " ")
    while RustCsgTuiPageDisplayWidth(out) < width:
        if RustCsgTuiPageDisplayWidth(out) + 2 <= width:
            out = strings.ConcatStr(out, "/ ")
        else:
            out = strings.ConcatStr(out, "/")
    return out

fn RustCsgTuiPageStatusLine(percent: str, width: int32): str =
    let suffix: str = strings.ConcatStr(strings.ConcatStr(" ", percent), " ─")
    let lineWidth: int32 = width - RustCsgTuiPageDisplayWidth(suffix)
    if lineWidth < 0:
        assert(false, "page oracle status width too small")
    return strings.ConcatStr(RustCsgTuiPageRepeat("─", lineWidth), suffix)

fn RustCsgTuiPageWords(text: str): str[] =
    var words: str[]
    var current: str = ""
    var i: int32 = 0
    while i < strings.Len(text):
        let ch: str = strings.SliceBytes(text, i, 1)
        if ch == " ":
            if strings.Len(current) > 0:
                add(words, current)
                current = ""
        else:
            current = strings.ConcatStr(current, ch)
        i = i + 1
    if strings.Len(current) > 0:
        add(words, current)
    return words

fn RustCsgTuiPageWrapAscii(text: str, width: int32): str[] =
    var lines: str[]
    let words: str[] = RustCsgTuiPageWords(text)
    var line: str = ""
    var i: int32 = 0
    while i < words.len:
        let word: str = words[i]
        if strings.Len(line) == 0:
            line = word
        else:
            let candidate: str = strings.ConcatStr(strings.ConcatStr(line, " "), word)
            if strings.Len(candidate) <= width:
                line = candidate
            else:
                add(lines, line)
                line = word
        i = i + 1
    if strings.Len(line) > 0:
        add(lines, line)
    return lines

fn RustCsgTuiPageRenderQuotedOverlay(title: str,
                                     width: int32,
                                     height: int32,
                                     content: str[],
                                     percent: str,
                                     footer2: str): str =
    let contentRows: int32 = height - 5
    if contentRows < 0:
        assert(false, "page oracle overlay height too small")
    var out: str = strings.ConcatStr(RustCsgTuiPageQuoteLine(RustCsgTuiPageOverlayHeader(title, width), width), "\n")
    var i: int32 = 0
    while i < contentRows:
        var line: str = "~"
        if i < content.len:
            line = content[i]
        out = strings.ConcatStr(out, RustCsgTuiPageQuoteLine(line, width))
        out = strings.ConcatStr(out, "\n")
        i = i + 1
    out = strings.ConcatStr(out, RustCsgTuiPageQuoteLine(RustCsgTuiPageStatusLine(percent, width), width))
    out = strings.ConcatStr(out, "\n")
    out = strings.ConcatStr(out, RustCsgTuiPageQuoteLine(RustCsgTuiPageTruncateDisplay(" ↑/↓ to scroll   pgup/pgdn to page   home/end to jump", width), width))
    out = strings.ConcatStr(out, "\n")
    out = strings.ConcatStr(out, RustCsgTuiPageQuoteLine(footer2, width))
    out = strings.ConcatStr(out, "\n")
    out = strings.ConcatStr(out, RustCsgTuiPageQuoteLine("", width))
    out = strings.ConcatStr(out, "\n")
    return out

fn RustCsgTuiPageRenderRawOverlay(title: str, width: int32, content: str[], percent: str, footer2: str): str =
    var out: str = strings.ConcatStr(RustCsgTuiPageOverlayHeader(title, width - 1), "\n")
    var i: int32 = 0
    while i < content.len:
        out = strings.ConcatStr(out, content[i])
        out = strings.ConcatStr(out, "\n")
        i = i + 1
    out = strings.ConcatStr(out, RustCsgTuiPageStatusLine(percent, width))
    out = strings.ConcatStr(out, "\n")
    out = strings.ConcatStr(out, " ↑/↓ to scroll   pgup/pgdn to page   home/end to jump\n")
    out = strings.ConcatStr(out, footer2)
    out = strings.ConcatStr(out, "\n")
    return out

fn RustCsgTuiPageRenderOrderedListAfterCodeBlock(firstTitle: str, codeLine: str, secondTitle: str, codeIndent: int32): str =
    return strings.ConcatStr(strutil.Join([
        strings.ConcatStr("1. ", firstTitle),
        "",
        strings.ConcatStr(RustCsgTuiPageSpaces(codeIndent), codeLine),
        "",
        strings.ConcatStr("2. ", secondTitle)
    ], "\n"), "\n")

fn RustCsgTuiPageStripCwdPrefix(path: str, cwd: str): str =
    let cwdLen: int32 = strings.Len(cwd)
    if cwdLen > 0 && strings.Len(path) > cwdLen && RustCsgTuiPageStartsWithAt(path, 0, cwd):
        if strings.SliceBytes(path, cwdLen, 1) == "/":
            return strings.SliceBytes(path, cwdLen + 1, strings.Len(path) - cwdLen - 1)
    return path

fn RustCsgTuiPageContainsSlash(text: str): bool =
    var i: int32 = 0
    while i < strings.Len(text):
        if strings.SliceBytes(text, i, 1) == "/":
            return true
        i = i + 1
    return false

fn RustCsgTuiPageRenderFileLinkSentence(prefix: str, label: str, targetPath: str, cwd: str, suffix: str): str =
    var renderedLabel: str = label
    if strings.Len(renderedLabel) == 0 || !RustCsgTuiPageContainsSlash(renderedLabel):
        renderedLabel = RustCsgTuiPageStripCwdPrefix(targetPath, cwd)
    return strings.ConcatStr(strutil.Join([prefix, renderedLabel, suffix], ""), "\n")

fn RustCsgTuiPageRenderInlineLinkProse(prefix: str, linkedText: str, url: str, suffix: str, width: int32): str =
    let plain: str = strutil.Join([prefix, linkedText, " (", url, ")", suffix], "")
    let lines: str[] = RustCsgTuiPageWrapAscii(plain, width)
    return strings.ConcatStr(strutil.Join(lines, "\n"), "\n")

fn RustCsgTuiPageCollabAgentLabel(nickname: str, role: str): str =
    if strings.Len(role) == 0:
        return nickname
    return strutil.Join([nickname, " [", role, "]"], "")

fn RustCsgTuiPageCollabTitle(prefix: str, nickname: str, role: str, model: str, effort: str): str =
    var title: str = strutil.Join(["• ", prefix, " ", RustCsgTuiPageCollabAgentLabel(nickname, role)], "")
    if strings.Len(model) > 0 || strings.Len(effort) > 0:
        title = strutil.Join([title, " (", model, " ", effort, ")"], "")
    return title

fn RustCsgTuiPageCollabEvent(title: str, details: str[]): str =
    if details.len == 0:
        return title
    var lines: str[] = [title]
    var i: int32 = 0
    while i < details.len:
        var prefix: str = "    "
        if i == 0:
            prefix = "  └ "
        add(lines, strings.ConcatStr(prefix, details[i]))
        i = i + 1
    return strutil.Join(lines, "\n")

fn RustCsgTuiPageCollabPromptEvent(prefix: str, nickname: str, role: str, model: str, effort: str, prompt: str): str =
    return RustCsgTuiPageCollabEvent(RustCsgTuiPageCollabTitle(prefix, nickname, role, model, effort), [prompt])

fn RustCsgTuiPageCollabStatusLine(nickname: str, role: str, status: str, message: str): str =
    var line: str = strutil.Join([RustCsgTuiPageCollabAgentLabel(nickname, role), ": ", status], "")
    if strings.Len(message) > 0:
        line = strutil.Join([line, " - ", message], "")
    return line

fn RustCsgTuiPageCollabWaitEnd(lines: str[]): str =
    return RustCsgTuiPageCollabEvent("• Finished waiting", lines)

fn RustCsgTuiPageCollabTranscript(): str =
    return strings.ConcatStr(strutil.Join([
        RustCsgTuiPageCollabPromptEvent("Spawned", "Robie", "explorer", "gpt-5", "high", "Compute 11! and reply with just the integer result."),
        RustCsgTuiPageCollabPromptEvent("Sent input to", "Robie", "explorer", "", "", "Please continue and return the answer only."),
        RustCsgTuiPageCollabEvent(RustCsgTuiPageCollabTitle("Waiting for", "Robie", "explorer", "", ""), []),
        RustCsgTuiPageCollabWaitEnd([
            RustCsgTuiPageCollabStatusLine("Robie", "explorer", "Completed", "39916800"),
            RustCsgTuiPageCollabStatusLine("Bob", "worker", "Error", "tool timeout")
        ]),
        RustCsgTuiPageCollabEvent(RustCsgTuiPageCollabTitle("Closed", "Robie", "explorer", "", ""), [])
    ], "\n\n"), "\n")

fn RustCsgTuiPageCollabResumeStatus(nickname: str, role: str, status: str): str =
    return strings.ConcatStr(RustCsgTuiPageCollabEvent(RustCsgTuiPageCollabTitle("Resumed", nickname, role, "", ""), [status]), "\n")

