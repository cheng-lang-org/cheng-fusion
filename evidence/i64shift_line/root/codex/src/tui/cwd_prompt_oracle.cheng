# Small Cheng renderer for TUI cwd_prompt oracle slices.

import std/strings

const RustCsgTuiCwdPromptActionResume: int32 = 0
const RustCsgTuiCwdPromptActionFork: int32 = 1
const RustCsgTuiCwdSelectionSession: int32 = 0
const RustCsgTuiCwdSelectionCurrent: int32 = 1

fn RustCsgTuiCwdPromptOracleSpaces(count: int32): str =
    var out: str = ""
    var i: int32 = 0
    while i < count:
        out = strings.ConcatStr(out, " ")
        i = i + 1
    return out

fn RustCsgTuiCwdPromptStartsWithAt(text: str, index: int32, prefix: str): bool =
    let prefixLen: int32 = strings.Len(prefix)
    if index < 0:
        return false
    if index + prefixLen > strings.Len(text):
        return false
    return strings.SliceBytes(text, index, prefixLen) == prefix

fn RustCsgTuiCwdPromptNextGlyph(text: str, index: int32): str =
    if RustCsgTuiCwdPromptStartsWithAt(text, index, "›"):
        return "›"
    return strings.SliceBytes(text, index, 1)

fn RustCsgTuiCwdPromptDisplayWidth(text: str): int32 =
    var width: int32 = 0
    var i: int32 = 0
    let n: int32 = strings.Len(text)
    while i < n:
        let glyph: str = RustCsgTuiCwdPromptNextGlyph(text, i)
        width = width + 1
        i = i + strings.Len(glyph)
    return width

fn RustCsgTuiCwdPromptPadRightDisplay(text: str, width: int32): str =
    let currentWidth: int32 = RustCsgTuiCwdPromptDisplayWidth(text)
    if currentWidth > width:
        assert(false, "cwd prompt line exceeds oracle width")
    if currentWidth == width:
        return text
    return strings.ConcatStr(text, RustCsgTuiCwdPromptOracleSpaces(width - currentWidth))

fn RustCsgTuiCwdPromptActionVerb(action: int32): str =
    if action == RustCsgTuiCwdPromptActionResume:
        return "resume"
    if action == RustCsgTuiCwdPromptActionFork:
        return "fork"
    assert(false, "unknown cwd prompt action")
    return ""

fn RustCsgTuiCwdPromptActionPast(action: int32): str =
    if action == RustCsgTuiCwdPromptActionResume:
        return "resumed"
    if action == RustCsgTuiCwdPromptActionFork:
        return "forked"
    assert(false, "unknown cwd prompt action")
    return ""

fn RustCsgTuiCwdPromptSelectionRow(index: int32, label: str, selected: bool, width: int32): str =
    var prefix: str = "  "
    if selected:
        prefix = "› "
    let line: str = strings.ConcatStr(strings.ConcatStr(strings.ConcatStr(prefix, strings.IntToStr(index)), ". "), label)
    if selected:
        return RustCsgTuiCwdPromptPadRightDisplay(line, width)
    if RustCsgTuiCwdPromptDisplayWidth(line) > width:
        assert(false, "cwd prompt selection line exceeds oracle width")
    return line

fn RustCsgTuiCwdPromptRender(action: int32,
                             currentCwd: str,
                             sessionCwd: str,
                             highlighted: int32,
                             width: int32): str =
    if width <= 0:
        assert(false, "cwd prompt width must be positive")
    let verb: str = RustCsgTuiCwdPromptActionVerb(action)
    let past: str = RustCsgTuiCwdPromptActionPast(action)
    var out: str = "\n"
    out = strings.ConcatStr(out, strings.ConcatStr(strings.ConcatStr("Choose working directory to ", verb), " this session\n"))
    out = strings.ConcatStr(out, "\n")
    out = strings.ConcatStr(out, RustCsgTuiCwdPromptPadRightDisplay(strings.ConcatStr(strings.ConcatStr("  Session = latest cwd recorded in the ", past), " session"), width))
    out = strings.ConcatStr(out, "\n")
    out = strings.ConcatStr(out, "  Current = your current working directory\n")
    out = strings.ConcatStr(out, "\n")
    let sessionLabel: str = strings.ConcatStr(strings.ConcatStr("Use session directory (", sessionCwd), ")")
    out = strings.ConcatStr(out, RustCsgTuiCwdPromptSelectionRow(1, sessionLabel, highlighted == RustCsgTuiCwdSelectionSession, width))
    out = strings.ConcatStr(out, "\n")
    let currentLabel: str = strings.ConcatStr(strings.ConcatStr("Use current directory (", currentCwd), ")")
    out = strings.ConcatStr(out, RustCsgTuiCwdPromptSelectionRow(2, currentLabel, highlighted == RustCsgTuiCwdSelectionCurrent, width))
    out = strings.ConcatStr(out, "\n")
    out = strings.ConcatStr(out, "\n")
    out = strings.ConcatStr(out, "  Press enter to continue\n")
    return out

fn RustCsgTuiCwdPromptModalFixture(): str =
    return RustCsgTuiCwdPromptRender(RustCsgTuiCwdPromptActionResume, "/Users/example/current", "/Users/example/session", RustCsgTuiCwdSelectionSession, 80)

fn RustCsgTuiCwdPromptForkModalFixture(): str =
    return RustCsgTuiCwdPromptRender(RustCsgTuiCwdPromptActionFork, "/Users/example/current", "/Users/example/session", RustCsgTuiCwdSelectionSession, 80)
