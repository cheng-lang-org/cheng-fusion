# Terminal control module for codex TUI
#
# Provides raw terminal I/O via C provider (tcgetattr/ioctl) and ANSI escape
# code helpers.  Does NOT link against ncurses --- all sequences are hand-rolled
# in the C provider where \x1b escape sequences work correctly.

import std/system
import std/strings

# -- C provider imports -------------------------------------------------------

@importc("cheng_terminal_raw_enable")
fn cheng_terminal_raw_enable()

@importc("cheng_terminal_raw_disable")
fn cheng_terminal_raw_disable()

@importc("cheng_terminal_get_size_rows")
fn cheng_terminal_get_size_rows_c(): int32

@importc("cheng_terminal_get_size_cols")
fn cheng_terminal_get_size_cols_c(): int32

@importc("cheng_terminal_read_key")
fn cheng_terminal_read_key_c(): int32

@importc("cheng_terminal_read_byte_timeout")
fn cheng_terminal_read_byte_timeout_c(deciseconds: int32): int32

@importc("cheng_terminal_write")
fn cheng_terminal_write(data: ptr, len: int32)

@importc("cheng_terminal_clear_screen")
fn cheng_terminal_clear_screen()

@importc("cheng_terminal_move_to")
fn cheng_terminal_move_to(row: int32, col: int32)

@importc("cheng_terminal_set_fg")
fn cheng_terminal_set_fg(color: int32)

@importc("cheng_terminal_set_bg")
fn cheng_terminal_set_bg(color: int32)

@importc("cheng_terminal_set_bold")
fn cheng_terminal_set_bold()

@importc("cheng_terminal_set_underline")
fn cheng_terminal_set_underline()

@importc("cheng_terminal_set_reverse")
fn cheng_terminal_set_reverse()

@importc("cheng_terminal_reset_attrs")
fn cheng_terminal_reset_attrs()

# -- Internal helpers ---------------------------------------------------------

fn termWrite(s: str) =
    if strings.Len(s) > 0:
        cheng_terminal_write(system.StrDataPtr(s), strings.Len(s))

# -- Public API ---------------------------------------------------------------

fn TerminalInit() =
    cheng_terminal_raw_enable()
    cheng_terminal_clear_screen()

fn TerminalRestore() =
    cheng_terminal_reset_attrs()
    cheng_terminal_clear_screen()
    cheng_terminal_raw_disable()

fn TerminalClear() =
    cheng_terminal_clear_screen()

fn TerminalMoveTo(row: int32, col: int32) =
    cheng_terminal_move_to(row, col)

fn TerminalWrite(text: str) =
    termWrite(text)

fn TerminalSetFg(color: int32) =
    cheng_terminal_set_fg(color)

fn TerminalSetBg(color: int32) =
    cheng_terminal_set_bg(color)

fn TerminalGetSize(outRows: var int32, outCols: var int32): bool =
    let rows: int32 = cheng_terminal_get_size_rows_c()
    let cols: int32 = cheng_terminal_get_size_cols_c()
    if rows <= 0 || cols <= 0:
        outRows = 24
        outCols = 80
        return false
    outRows = rows
    outCols = cols
    return true

# Return the raw key code as int32 (ASCII value, -1 on error).
# For non-ASCII: 0x1b = ESC, 0x0a = Enter, 0x7f = Backspace.
fn TerminalReadKeyCode(): int32 =
    return cheng_terminal_read_key_c()

fn TerminalReadByte(): int32 =
    return cheng_terminal_read_key_c()

# Read a full key sequence as a multi-byte string.
# For single-byte keys (printable ASCII, Enter, Tab, Backspace), returns a 1-char str.
# For multi-byte ANSI escape sequences, reads subsequent bytes with 100ms timeout
# and returns the complete sequence (including the leading ESC byte).
# Returns empty string on error.
# The caller (RustCsgTuiParseKeySequence) handles the actual sequence parsing.
fn TerminalReadKeySequence(): str =
    let first: int32 = cheng_terminal_read_key_c()
    if first <= 0:
        return ""

    # Single-byte key (including standalone ESC) — return as 1-char str
    if first != 27:
        return strings.CharToStr(Char(first))

    # ESC seen — try to read escape sequence bytes with timeout
    var seq: str = strings.CharToStr(Char(27))
    const maxExtra: int32 = 16
    var count: int32
    while count < maxExtra:
        let b: int32 = cheng_terminal_read_byte_timeout_c(1)  # 100ms timeout
        if b <= 0:
            break
        seq = strings.ConcatStr(seq, strings.CharToStr(Char(b)))
        count = count + 1

    return seq

# Return the key as a 1-char str for printable ASCII (32-126).
# Returns empty for non-printable or error --- use TerminalReadKeyCode() for
# navigation logic (q/j/k/etc).
fn TerminalReadKey(): str =
    let ch: int32 = cheng_terminal_read_key_c()
    if ch >= 32 && ch <= 126:
        let idx: int32 = ch - 32
        return strings.SliceBytes(" !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~", idx, 1)
    return ""

fn TerminalSetBold() =
    cheng_terminal_set_bold()

fn TerminalSetUnderline() =
    cheng_terminal_set_underline()

fn TerminalSetReverse() =
    cheng_terminal_set_reverse()

fn TerminalResetAttrs() =
    cheng_terminal_reset_attrs()
