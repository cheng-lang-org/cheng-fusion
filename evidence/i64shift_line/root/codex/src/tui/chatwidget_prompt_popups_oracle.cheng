# TUI chatwidget prompt and confirmation popup snapshot oracle.

import std/strutils as strutil

fn RustCsgTuiChatwidgetPromptLines(lines: str[]): str =
    return strutil.Join([strutil.Join(lines, "\n"), "\n"], "")

fn RustCsgTuiChatwidgetPlanImplementationPopup(): str =
    return RustCsgTuiChatwidgetPromptLines([
        "  Implement this plan?",
        "",
        "› 1. Yes, implement this plan  Switch to Default and start coding.",
        "  2. No, stay in Plan mode     Continue planning with the model.",
        "",
        "  Press enter to confirm or esc to go back",
    ])

fn RustCsgTuiChatwidgetPlanImplementationPopupContextUsage(): str =
    return RustCsgTuiChatwidgetPromptLines([
        "  Implement this plan?",
        "",
        "› 1. Yes, implement this plan          Switch to Default and start coding.",
        "  2. Yes, clear context and implement  Fresh thread. Context: 89% used.",
        "  3. No, stay in Plan mode             Continue planning with the model.",
        "",
        "  Press enter to confirm or esc to go back",
    ])

fn RustCsgTuiChatwidgetPlanImplementationPopupNoSelected(): str =
    return RustCsgTuiChatwidgetPromptLines([
        "  Implement this plan?",
        "",
        "  1. Yes, implement this plan  Switch to Default and start coding.",
        "› 2. No, stay in Plan mode     Continue planning with the model.",
        "",
        "  Press enter to confirm or esc to go back",
    ])

fn RustCsgTuiChatwidgetMemoriesEnablePrompt(): str =
    return RustCsgTuiChatwidgetPromptLines([
        "  Enable memories?",
        "  Memories are currently disabled in your config.",
        "",
        "› 1. Yes, enable  Save the setting now. You will need a new session to use it.",
        "  2. Not now      Keep memories disabled.",
        "",
        "  Learn more: https://developers.openai.com/codex/memories",
        "  Press enter to confirm or esc to go back",
    ])

fn RustCsgTuiChatwidgetMemoriesResetConfirmation(): str =
    return RustCsgTuiChatwidgetPromptLines([
        "  Reset all memories?",
        "",
        "› Reset all memories  Delete local memory files and rollout summaries.",
        "  Go back             Return to memory settings.",
        "",
        "",
        "",
        "  Press enter to confirm or esc to go back",
    ])

fn RustCsgTuiChatwidgetMemoriesSettingsPopup(): str =
    return RustCsgTuiChatwidgetPromptLines([
        "  Memories",
        "  Choose how Codex uses and creates memories. Changes are saved to config.toml",
        "",
        "› [x] Use memories       Use memories in the following threads. Applied at",
        "                         next thread.",
        "  [ ] Generate memories  Generate memories from the following threads. Current",
        "                         thread included.",
        "  Reset all memories     Clear local memory files and summaries. Existing",
        "                         threads stay intact.",
        "",
        "  Learn more: https://developers.openai.com/codex/memories",
        "",
        "  Press space to toggle; enter to save or select",
    ])

fn RustCsgTuiChatwidgetFeedbackSelectionPopup(): str =
    return RustCsgTuiChatwidgetPromptLines([
        "  How was this?",
        "",
        "› 1. bug           Crash, error message, hang, or broken UI/behavior.",
        "  2. bad result    Output was off-target, incorrect, incomplete, or unhelpful.",
        "  3. good result   Helpful, correct, high‑quality, or delightful result worth",
        "                   celebrating.",
        "  4. safety check  Benign usage blocked due to safety checks or refusals.",
        "  5. other         Slowness, feature suggestion, UX feedback, or anything",
        "                   else.",
    ])

fn RustCsgTuiChatwidgetFeedbackUploadConsentPopup(): str =
    return RustCsgTuiChatwidgetPromptLines([
        "  Upload logs?",
        "",
        "  The following files will be sent:",
        "    • codex-logs.log",
        "    • codex-connectivity-diagnostics.txt",
        "",
        "  Connectivity diagnostics",
        "    - Proxy environment variables are set and may affect connectivity.",
        "      - HTTPS_PROXY = hello",
        "",
        "› 1. Yes  Share the current Codex session logs with the team for",
        "          troubleshooting.",
        "  2. No",
        "",
        "  Press enter to confirm or esc to go back",
    ])
