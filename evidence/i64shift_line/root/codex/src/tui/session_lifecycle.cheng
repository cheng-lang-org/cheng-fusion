import cheng/codex/protocol/types
import cheng/codex/protocol/wire

const
    RustCsgTuiThreadParamsModeEmbedded: str = "embedded"
    RustCsgTuiThreadParamsModeRemote: str = "remote"

type
    RustCsgTuiThreadHandoffConfig =
        cwd: str
        model: str
        modelProviderId: str
        serviceTierJson: str
        runtimeWorkspaceRootsJson: str
        approvalPolicyJson: str
        approvalsReviewer: str
        sandboxJson: str
        permissionsJson: str
        modelOverride: str
        approvalPolicyJsonOverride: str
        permissionsJsonOverride: str
        configJson: str
        baseInstructions: str
        developerInstructions: str
        ephemeral: bool

    RustCsgTuiThreadHandoffResult =
        ok: bool
        json: str
        error: str

fn RustCsgTuiThreadHandoffOk(json: str): RustCsgTuiThreadHandoffResult =
    var result: RustCsgTuiThreadHandoffResult
    result.ok = true
    result.json = json
    return result

fn RustCsgTuiThreadHandoffError(message: str): RustCsgTuiThreadHandoffResult =
    var result: RustCsgTuiThreadHandoffResult
    result.error = message
    return result

fn RustCsgTuiThreadHandoffModeValid(threadParamsMode: str): bool =
    return threadParamsMode == RustCsgTuiThreadParamsModeEmbedded || threadParamsMode == RustCsgTuiThreadParamsModeRemote

fn RustCsgTuiThreadHandoffModeError(threadParamsMode: str): str =
    return wire.RustCsgCat("unsupported thread params mode: ", threadParamsMode)

fn RustCsgTuiThreadHandoffModelProvider(config: var RustCsgTuiThreadHandoffConfig, threadParamsMode: str): str =
    if threadParamsMode == RustCsgTuiThreadParamsModeRemote:
        return ""
    return config.modelProviderId

fn RustCsgTuiThreadHandoffCwd(config: var RustCsgTuiThreadHandoffConfig,
                              threadParamsMode: str,
                              remoteCwdOverride: str): str =
    if threadParamsMode == RustCsgTuiThreadParamsModeRemote:
        return remoteCwdOverride
    return config.cwd

fn RustCsgTuiThreadHandoffPermissions(config: var RustCsgTuiThreadHandoffConfig, threadParamsMode: str): str =
    if threadParamsMode == RustCsgTuiThreadParamsModeRemote:
        return ""
    return config.permissionsJson

fn RustCsgTuiThreadHandoffSandbox(config: var RustCsgTuiThreadHandoffConfig, permissionsJson: str): str =
    if permissionsJson != "":
        return ""
    return config.sandboxJson

fn RustCsgTuiThreadHandoffBoolJson(value: bool): str =
    if value:
        return "true"
    return "false"

fn RustCsgTuiThreadHandoffComma(hasField: var bool): str =
    if hasField:
        return ","
    hasField = true
    return ""

fn RustCsgTuiThreadHandoffAppendStrField(out: str, key: str, value: str, hasField: var bool): str =
    var next = out
    next = wire.RustCsgCat(next, RustCsgTuiThreadHandoffComma(hasField))
    next = wire.RustCsgCat(next, wire.RustCsgJsonFieldStr(key, value))
    return next

fn RustCsgTuiThreadHandoffAppendRawField(out: str, key: str, value: str, hasField: var bool): str =
    var next = out
    next = wire.RustCsgCat(next, RustCsgTuiThreadHandoffComma(hasField))
    next = wire.RustCsgCat(next, wire.RustCsgJsonFieldRaw(key, value))
    return next

fn RustCsgTuiThreadHandoffConfigOverridesJson(reasoningEffort: str,
                                              reasoningSummary: str,
                                              modelVerbosity: str,
                                              personality: str,
                                              webSearch: str,
                                              bypassHookTrust: bool): str =
    assert(webSearch != "", "web_search override required")
    var hasField: bool
    var out = "{"
    if reasoningEffort != "":
        out = RustCsgTuiThreadHandoffAppendStrField(out, "model_reasoning_effort", reasoningEffort, hasField)
    if reasoningSummary != "":
        out = RustCsgTuiThreadHandoffAppendStrField(out, "model_reasoning_summary", reasoningSummary, hasField)
    if modelVerbosity != "":
        out = RustCsgTuiThreadHandoffAppendStrField(out, "model_verbosity", modelVerbosity, hasField)
    if personality != "":
        out = RustCsgTuiThreadHandoffAppendStrField(out, "personality", personality, hasField)
    out = RustCsgTuiThreadHandoffAppendStrField(out, "web_search", webSearch, hasField)
    if bypassHookTrust:
        out = RustCsgTuiThreadHandoffAppendRawField(out, "bypass_hook_trust", "true", hasField)
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgTuiThreadHandoffBuildStartParams(threadParamsMode: str,
                                           remoteCwdOverride: str,
                                           config: var RustCsgTuiThreadHandoffConfig): RustCsgTuiThreadHandoffResult =
    if !RustCsgTuiThreadHandoffModeValid(threadParamsMode):
        return RustCsgTuiThreadHandoffError(RustCsgTuiThreadHandoffModeError(threadParamsMode))
    var params: types.RustCsgThreadStartParams
    params.model = config.model
    params.modelProvider = RustCsgTuiThreadHandoffModelProvider(config, threadParamsMode)
    params.serviceTierJson = config.serviceTierJson
    params.cwd = RustCsgTuiThreadHandoffCwd(config, threadParamsMode, remoteCwdOverride)
    params.runtimeWorkspaceRootsJson = config.runtimeWorkspaceRootsJson
    params.approvalPolicyJson = config.approvalPolicyJson
    params.approvalsReviewer = config.approvalsReviewer
    params.permissionsJson = RustCsgTuiThreadHandoffPermissions(config, threadParamsMode)
    params.sandboxJson = RustCsgTuiThreadHandoffSandbox(config, params.permissionsJson)
    params.configJson = config.configJson
    params.ephemeralJson = RustCsgTuiThreadHandoffBoolJson(config.ephemeral)
    params.persistExtendedHistory = true
    return RustCsgTuiThreadHandoffOk(wire.RustCsgThreadStartParamsToJson(params))

fn RustCsgTuiThreadHandoffBuildResumeParams(threadId: str,
                                            threadParamsMode: str,
                                            remoteCwdOverride: str,
                                            config: var RustCsgTuiThreadHandoffConfig): RustCsgTuiThreadHandoffResult =
    if threadId == "":
        return RustCsgTuiThreadHandoffError("threadId is required")
    if !RustCsgTuiThreadHandoffModeValid(threadParamsMode):
        return RustCsgTuiThreadHandoffError(RustCsgTuiThreadHandoffModeError(threadParamsMode))
    var params: types.RustCsgThreadResumeParams
    params.threadId = threadId
    params.model = config.model
    params.modelProvider = RustCsgTuiThreadHandoffModelProvider(config, threadParamsMode)
    params.serviceTierJson = config.serviceTierJson
    params.cwd = RustCsgTuiThreadHandoffCwd(config, threadParamsMode, remoteCwdOverride)
    params.runtimeWorkspaceRootsJson = config.runtimeWorkspaceRootsJson
    params.approvalPolicyJson = config.approvalPolicyJson
    params.approvalsReviewer = config.approvalsReviewer
    params.permissionsJson = RustCsgTuiThreadHandoffPermissions(config, threadParamsMode)
    params.sandboxJson = RustCsgTuiThreadHandoffSandbox(config, params.permissionsJson)
    params.configJson = config.configJson
    params.persistExtendedHistory = true
    return RustCsgTuiThreadHandoffOk(wire.RustCsgThreadResumeParamsToJson(params))

fn RustCsgTuiThreadHandoffBuildForkParams(threadId: str,
                                          threadParamsMode: str,
                                          remoteCwdOverride: str,
                                          config: var RustCsgTuiThreadHandoffConfig): RustCsgTuiThreadHandoffResult =
    if threadId == "":
        return RustCsgTuiThreadHandoffError("threadId is required")
    if !RustCsgTuiThreadHandoffModeValid(threadParamsMode):
        return RustCsgTuiThreadHandoffError(RustCsgTuiThreadHandoffModeError(threadParamsMode))
    var params: types.RustCsgThreadForkParams
    params.threadId = threadId
    params.model = config.model
    params.modelProvider = RustCsgTuiThreadHandoffModelProvider(config, threadParamsMode)
    params.serviceTierJson = config.serviceTierJson
    params.cwd = RustCsgTuiThreadHandoffCwd(config, threadParamsMode, remoteCwdOverride)
    params.runtimeWorkspaceRootsJson = config.runtimeWorkspaceRootsJson
    params.approvalPolicyJson = config.approvalPolicyJson
    params.approvalsReviewer = config.approvalsReviewer
    params.permissionsJson = RustCsgTuiThreadHandoffPermissions(config, threadParamsMode)
    params.sandboxJson = RustCsgTuiThreadHandoffSandbox(config, params.permissionsJson)
    params.configJson = config.configJson
    params.baseInstructions = config.baseInstructions
    params.developerInstructions = config.developerInstructions
    params.ephemeral = config.ephemeral
    params.threadSource = "user"
    params.persistExtendedHistory = true
    return RustCsgTuiThreadHandoffOk(wire.RustCsgThreadForkParamsToJson(params))
