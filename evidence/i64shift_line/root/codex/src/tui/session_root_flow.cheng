import cheng/codex/app_server/main as app_server
import cheng/codex/protocol/wire
import cheng/codex/tui/app as tui_app
import cheng/codex/tui/app_session_install as install
import cheng/codex/tui/session_bootstrap as bootstrap
import cheng/codex/tui/session_handoff as handoff
import cheng/codex/tui/session_lifecycle as lifecycle
import cheng/codex/tui/session_state as state

type
    RustCsgTuiSessionRootFlowSelection =
        kind: str
        threadId: str
        path: str
        displayLabel: str
        pickerScreen: str
        pickerFrameCount: int32

    RustCsgTuiSessionRootFlowConfig =
        handoffContext: handoff.RustCsgTuiSessionHandoffContext
        handoffConfig: lifecycle.RustCsgTuiThreadHandoffConfig
        bootstrapConfig: bootstrap.RustCsgTuiSessionBootstrapConfig
        appTermWidth: int32
        appTermHeight: int32

    RustCsgTuiSessionRootFlowResult =
        ok: bool
        outcome: str
        action: str
        selectionKind: str
        threadId: str
        path: str
        displayLabel: str
        cwd: str
        historyCwd: str
        cwdSource: str
        configOutcome: str
        method: str
        primaryThreadId: str
        pickerFrameCount: int32
        pickerScreen: str
        handoffRequestJson: str
        appServerResponseJson: str
        bootstrapJson: str
        installJson: str
        appRuntimeJson: str
        appFirstFrameText: str
        appEffectsJson: str
        error: str

fn RustCsgTuiSessionRootFlowError(message: str): RustCsgTuiSessionRootFlowResult =
    var result: RustCsgTuiSessionRootFlowResult
    result.outcome = "error"
    result.error = message
    return result

fn RustCsgTuiSessionRootFlowMakeSelection(kind: str,
                                          threadId: str,
                                          path: str,
                                          displayLabel: str,
                                          pickerScreen: str,
                                          pickerFrameCount: int32): RustCsgTuiSessionRootFlowSelection =
    var selection: RustCsgTuiSessionRootFlowSelection
    selection.kind = kind
    selection.threadId = threadId
    selection.path = path
    selection.displayLabel = displayLabel
    selection.pickerScreen = pickerScreen
    selection.pickerFrameCount = pickerFrameCount
    return selection

fn RustCsgTuiSessionRootFlowPassthrough(outcome: str,
                                        selection: var RustCsgTuiSessionRootFlowSelection,
                                        handoffResult: var handoff.RustCsgTuiSessionHandoffResult): RustCsgTuiSessionRootFlowResult =
    var result: RustCsgTuiSessionRootFlowResult
    result.ok = true
    result.outcome = outcome
    result.action = selection.kind
    result.selectionKind = selection.kind
    result.threadId = handoffResult.threadId
    result.path = handoffResult.path
    result.displayLabel = handoffResult.displayLabel
    result.cwd = handoffResult.cwd
    result.historyCwd = handoffResult.historyCwd
    result.cwdSource = handoffResult.cwdSource
    result.configOutcome = handoffResult.configOutcome
    result.pickerFrameCount = selection.pickerFrameCount
    result.pickerScreen = selection.pickerScreen
    return result

fn RustCsgTuiSessionRootFlowReady(selection: var RustCsgTuiSessionRootFlowSelection,
                                  handoffResult: var handoff.RustCsgTuiSessionHandoffResult,
                                  responseJson: str,
                                  bootstrapResult: var bootstrap.RustCsgTuiSessionBootstrapResult,
                                  installResult: var install.RustCsgTuiAppSessionInstallResult,
                                  appRuntime: var tui_app.RustCsgTuiAppRuntimeInstallResult): RustCsgTuiSessionRootFlowResult =
    var result: RustCsgTuiSessionRootFlowResult
    var selectedThreadId = selection.threadId
    if selectedThreadId == "":
        selectedThreadId = bootstrapResult.primaryThreadId
    result.ok = true
    result.outcome = "app_ready"
    result.action = selection.kind
    result.selectionKind = selection.kind
    result.threadId = selectedThreadId
    result.path = selection.path
    result.displayLabel = selection.displayLabel
    result.cwd = handoffResult.cwd
    result.historyCwd = handoffResult.historyCwd
    result.cwdSource = handoffResult.cwdSource
    result.configOutcome = handoffResult.configOutcome
    result.method = handoffResult.method
    result.primaryThreadId = bootstrapResult.primaryThreadId
    result.pickerFrameCount = selection.pickerFrameCount
    result.pickerScreen = selection.pickerScreen
    result.handoffRequestJson = handoffResult.requestJson
    result.appServerResponseJson = responseJson
    result.bootstrapJson = bootstrap.RustCsgTuiSessionBootstrapResultToJson(bootstrapResult)
    result.installJson = install.RustCsgTuiAppSessionInstallResultToJson(installResult)
    result.appRuntimeJson = tui_app.RustCsgTuiAppRuntimeInstallResultToJson(appRuntime)
    result.appFirstFrameText = appRuntime.firstFrameText
    result.appEffectsJson = appRuntime.effectsJson
    return result

fn RustCsgTuiSessionRootFlowRunStartFresh(config: var RustCsgTuiSessionRootFlowConfig,
                                          selection: var RustCsgTuiSessionRootFlowSelection): RustCsgTuiSessionRootFlowResult =
    if config.handoffContext.requestIdJson == "":
        return RustCsgTuiSessionRootFlowError("request id is required")
    var startConfig = handoff.RustCsgTuiSessionHandoffConfigWithCwd(config.handoffConfig,
                                                                    config.handoffContext.currentCwd)
    let params = lifecycle.RustCsgTuiThreadHandoffBuildStartParams(config.handoffContext.threadParamsMode,
                                                                   config.handoffContext.remoteCwdOverride,
                                                                   startConfig)
    if !params.ok:
        return RustCsgTuiSessionRootFlowError(params.error)
    var handoffResult = handoff.RustCsgTuiSessionHandoffRequestResult("thread/start",
                                                                      config.handoffContext.requestIdJson,
                                                                      params.json,
                                                                      "",
                                                                      "",
                                                                      "",
                                                                      startConfig.cwd,
                                                                      "",
                                                                      "config",
                                                                      "current_config",
                                                                      config.handoffContext.currentConfigJson)
    let responseJson = app_server.RustCsgAppServerHandleForTuiBootstrap(handoffResult.requestJson)
    if responseJson == "":
        return RustCsgTuiSessionRootFlowError("missing app-server response")
    return RustCsgTuiSessionRootFlowInstallApp(selection, handoffResult, responseJson, config)

fn RustCsgTuiSessionRootFlowResultToJson(result: var RustCsgTuiSessionRootFlowResult): str =
    if !result.ok:
        return wire.RustCsgCat(wire.RustCsgCat("{\"ok\":false,\"outcome\":\"error\",\"error\":", wire.RustCsgJsonQuote(result.error)), "}")
    var out = "{\"ok\":true,"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("outcome", result.outcome))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("action", result.action))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("selectionKind", result.selectionKind))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("threadId", result.threadId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonNullableFieldStr("method", result.method))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonNullableFieldStr("primaryThreadId", result.primaryThreadId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonNullableFieldStr("cwd", result.cwd))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonNullableFieldStr("historyCwd", result.historyCwd))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonNullableFieldStr("cwdSource", result.cwdSource))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonNullableFieldStr("configOutcome", result.configOutcome))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("pickerFrameCount", result.pickerFrameCount))
    if result.handoffRequestJson != "":
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("handoffRequest", result.handoffRequestJson))
    if result.bootstrapJson != "":
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("bootstrap", result.bootstrapJson))
    if result.appRuntimeJson != "":
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("appRuntime", result.appRuntimeJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgTuiSessionRootFlowInstallApp(selection: var RustCsgTuiSessionRootFlowSelection,
                                       handoffResult: var handoff.RustCsgTuiSessionHandoffResult,
                                       responseJson: str,
                                       config: var RustCsgTuiSessionRootFlowConfig): RustCsgTuiSessionRootFlowResult =
    let responseError = bootstrap.RustCsgTuiSessionBootstrapResponseErrorMessage(responseJson)
    if responseError != "":
        return RustCsgTuiSessionRootFlowError(responseError)
    let resultJson = bootstrap.RustCsgTuiSessionBootstrapTopLevelValueRaw(responseJson, "result")
    if resultJson == "":
        return RustCsgTuiSessionRootFlowError("missing JSON-RPC result")
    let lifecycleKind = bootstrap.RustCsgTuiSessionBootstrapLifecycleKind(handoffResult.method)
    if lifecycleKind == "":
        return RustCsgTuiSessionRootFlowError(wire.RustCsgCat("unsupported lifecycle method: ", handoffResult.method))
    var started = state.RustCsgTuiSessionStateFromLifecycleResponseJson(resultJson,
                                                                        lifecycleKind,
                                                                        config.bootstrapConfig.threadParamsMode,
                                                                        config.bootstrapConfig.stateConfig)
    if handoffResult.method == "thread/fork":
        started = state.RustCsgTuiStartedThreadSetForkParentTitle(started, handoffResult.displayLabel)
    if !started.ok:
        return RustCsgTuiSessionRootFlowError(started.error)
    var pendingError: str
    let pendingEventsJson = bootstrap.RustCsgTuiSessionBootstrapPendingEventsJson(config.bootstrapConfig, pendingError)
    if pendingError != "":
        return RustCsgTuiSessionRootFlowError(pendingError)
    var installResult = install.RustCsgTuiAppSessionInstallPrimaryWithPendingEvents(started,
                                                                                    config.bootstrapConfig.terminalResizeReflowEnabled,
                                                                                    pendingEventsJson,
                                                                                    config.bootstrapConfig.initialUserMessagePending)
    if !installResult.ok:
        return RustCsgTuiSessionRootFlowError(installResult.error)
    var bootstrapResult = bootstrap.RustCsgTuiSessionBootstrapInstalled(handoffResult.method,
                                                                        started,
                                                                        installResult)
    var app = tui_app.RustCsgTuiAppInit(config.appTermWidth, config.appTermHeight)
    var appRuntime = tui_app.RustCsgTuiAppInstallPrimarySession(app, installResult)
    if !appRuntime.ok:
        return RustCsgTuiSessionRootFlowError(appRuntime.error)
    return RustCsgTuiSessionRootFlowReady(selection,
                                          handoffResult,
                                          responseJson,
                                          bootstrapResult,
                                          installResult,
                                          appRuntime)

fn RustCsgTuiSessionRootFlowRunSelected(config: var RustCsgTuiSessionRootFlowConfig,
                                        selection: var RustCsgTuiSessionRootFlowSelection): RustCsgTuiSessionRootFlowResult =
    if selection.kind == "start_fresh":
        return RustCsgTuiSessionRootFlowRunStartFresh(config, selection)
    if selection.kind != "resume" && selection.kind != "fork":
        return RustCsgTuiSessionRootFlowError(wire.RustCsgCat("unsupported session selection: ", selection.kind))
    var handoffSelection = handoff.RustCsgTuiSessionHandoffMakeSelection(selection.kind,
                                                                         selection.threadId,
                                                                         selection.path,
                                                                         selection.displayLabel)
    var handoffResult = handoff.RustCsgTuiSessionHandoffFromSelection(config.handoffContext,
                                                                      handoffSelection,
                                                                      config.handoffConfig)
    if !handoffResult.ok:
        return RustCsgTuiSessionRootFlowError(handoffResult.error)
    if handoffResult.outcome != "request":
        return RustCsgTuiSessionRootFlowPassthrough(handoffResult.outcome, selection, handoffResult)
    let responseJson = app_server.RustCsgAppServerHandleForTuiBootstrap(handoffResult.requestJson)
    if responseJson == "":
        return RustCsgTuiSessionRootFlowError("missing app-server response")
    return RustCsgTuiSessionRootFlowInstallApp(selection, handoffResult, responseJson, config)
