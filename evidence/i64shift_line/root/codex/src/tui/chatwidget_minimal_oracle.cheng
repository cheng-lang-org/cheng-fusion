# TUI chatwidget minimal snapshot oracle.

import std/strings

fn RustCsgTuiChatwidgetMinimalSpaces(count: int32): str =
    var out: str = ""
    var i: int32 = 0
    while i < count:
        out = strings.ConcatStr(out, " ")
        i = i + 1
    return out

fn RustCsgTuiChatwidgetMinimalBackend40BlankRows(rows: int32): str =
    var out: str = ""
    var i: int32 = 0
    while i < rows:
        out = strings.ConcatStr(out, "\"")
        out = strings.ConcatStr(out, RustCsgTuiChatwidgetMinimalSpaces(40))
        out = strings.ConcatStr(out, "\"\n")
        i = i + 1
    return out

fn RustCsgTuiChatwidgetMinimalChatSmallIdleH1Snapshot(): str =
    return RustCsgTuiChatwidgetMinimalBackend40BlankRows(1)

fn RustCsgTuiChatwidgetMinimalChatSmallIdleH2Snapshot(): str =
    return RustCsgTuiChatwidgetMinimalBackend40BlankRows(2)

fn RustCsgTuiChatwidgetMinimalChatSmallIdleH3Snapshot(): str =
    return RustCsgTuiChatwidgetMinimalBackend40BlankRows(3)

fn RustCsgTuiChatwidgetMinimalChatSmallRunningH1Snapshot(): str =
    return RustCsgTuiChatwidgetMinimalBackend40BlankRows(1)

fn RustCsgTuiChatwidgetMinimalChatSmallRunningH2Snapshot(): str =
    return RustCsgTuiChatwidgetMinimalBackend40BlankRows(2)

fn RustCsgTuiChatwidgetMinimalChatSmallRunningH3Snapshot(): str =
    return RustCsgTuiChatwidgetMinimalBackend40BlankRows(3)

