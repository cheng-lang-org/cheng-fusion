# TUI bottom_pane/footer terminal.backend oracle renderer.

import std/strings
import std/strutils as strutil

fn RustCsgTuiFooterSpaces(count: int32): str =
    var out: str = ""
    var i: int32 = 0
    while i < count:
        out = strings.ConcatStr(out, " ")
        i = i + 1
    return out

fn RustCsgTuiFooterStartsWithAt(text: str, index: int32, prefix: str): bool =
    let prefixLen: int32 = strings.Len(prefix)
    if index < 0:
        return false
    if index + prefixLen > strings.Len(text):
        return false
    return strings.SliceBytes(text, index, prefixLen) == prefix

fn RustCsgTuiFooterNextGlyph(text: str, index: int32): str =
    if RustCsgTuiFooterStartsWithAt(text, index, "⌥"):
        return "⌥"
    if RustCsgTuiFooterStartsWithAt(text, index, "…"):
        return "…"
    if RustCsgTuiFooterStartsWithAt(text, index, "·"):
        return "·"
    return strings.SliceBytes(text, index, 1)

fn RustCsgTuiFooterDisplayWidth(text: str): int32 =
    var width: int32 = 0
    var i: int32 = 0
    while i < strings.Len(text):
        let glyph: str = RustCsgTuiFooterNextGlyph(text, i)
        width = width + 1
        i = i + strings.Len(glyph)
    return width

fn RustCsgTuiFooterPad(text: str, width: int32): str =
    let currentWidth: int32 = RustCsgTuiFooterDisplayWidth(text)
    if currentWidth > width:
        assert(false, "footer oracle line exceeds width")
    return strings.ConcatStr(text, RustCsgTuiFooterSpaces(width - currentWidth))

fn RustCsgTuiFooterQuoteLine(text: str, width: int32): str =
    return strutil.Join(["\"", RustCsgTuiFooterPad(text, width), "\"\n"], "")

fn RustCsgTuiFooterLeftRight(left: str, right: str, width: int32): str =
    let rightText: str = strings.ConcatStr(right, "  ")
    let leftWidth: int32 = RustCsgTuiFooterDisplayWidth(left)
    let rightWidth: int32 = RustCsgTuiFooterDisplayWidth(rightText)
    if leftWidth + rightWidth > width:
        assert(false, "footer left/right overlap")
    return strutil.Join([left, RustCsgTuiFooterSpaces(width - leftWidth - rightWidth), rightText], "")

fn RustCsgTuiFooterRightOnly(right: str, width: int32): str =
    let rightText: str = strings.ConcatStr(right, "  ")
    let rightWidth: int32 = RustCsgTuiFooterDisplayWidth(rightText)
    if rightWidth > width:
        assert(false, "footer right label exceeds width")
    return strutil.Join([RustCsgTuiFooterSpaces(width - rightWidth), rightText], "")

fn RustCsgTuiFooterShortcutPair(left: str, right: str): str =
    let leftText: str = strings.ConcatStr("  ", left)
    let leftWidth: int32 = RustCsgTuiFooterDisplayWidth(leftText)
    if leftWidth > 45:
        assert(false, "footer shortcut left column exceeds width")
    return RustCsgTuiFooterQuoteLine(strutil.Join([leftText, RustCsgTuiFooterSpaces(45 - leftWidth), right], ""), 80)

fn RustCsgTuiFooterShortcutSingle(text: str): str =
    return RustCsgTuiFooterQuoteLine(strings.ConcatStr("  ", text), 80)

fn RustCsgTuiFooterActiveAgentLabelSnapshot(): str =
    return RustCsgTuiFooterQuoteLine(RustCsgTuiFooterLeftRight("  Robie [explorer]", "100% context left", 80), 80)

