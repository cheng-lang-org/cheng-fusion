fn RustCsgTuiFooterShortcutsShiftAndEscSnapshot(): str =
    var out: str = ""
    out = strings.ConcatStr(out, RustCsgTuiFooterShortcutPair("/ for commands", "! for shell commands"))
    out = strings.ConcatStr(out, RustCsgTuiFooterShortcutPair("shift + enter for newline", "tab to queue message"))
    out = strings.ConcatStr(out, RustCsgTuiFooterShortcutPair("@ for file paths", "ctrl + v to paste images"))
    out = strings.ConcatStr(out, RustCsgTuiFooterShortcutPair("ctrl + g to edit in external editor", "esc again to edit previous message"))
    out = strings.ConcatStr(out, RustCsgTuiFooterShortcutSingle("ctrl + c to exit"))
    out = strings.ConcatStr(out, RustCsgTuiFooterShortcutSingle("ctrl + t to view transcript"))
    return out

