fn RustCsgTuiFooterShortcutsCollaborationModesEnabledSnapshot(): str =
    var out: str = ""
    out = strings.ConcatStr(out, RustCsgTuiFooterShortcutPair("/ for commands", "! for shell commands"))
    out = strings.ConcatStr(out, RustCsgTuiFooterShortcutPair("ctrl + j for newline", "tab to queue message"))
    out = strings.ConcatStr(out, RustCsgTuiFooterShortcutPair("@ for file paths", "ctrl + v to paste images"))
    out = strings.ConcatStr(out, RustCsgTuiFooterShortcutPair("ctrl + g to edit in external editor", "esc esc to edit previous message"))
    out = strings.ConcatStr(out, RustCsgTuiFooterShortcutPair("ctrl + c to exit", "shift + tab to change mode"))
    out = strings.ConcatStr(out, RustCsgTuiFooterShortcutPair("", "ctrl + t to view transcript"))
    return out

fn RustCsgTuiFooterShortcutsContextRunningSnapshot(): str =
    return RustCsgTuiFooterQuoteLine(RustCsgTuiFooterLeftRight("  ? for shortcuts", "72% context left", 80), 80)

fn RustCsgTuiFooterShortcutsDefaultSnapshot(): str =
