# TUI oracle text parser and byte-exact comparator.
#
# Inventory answers "what oracle files exist"; this module answers "what exact
# text should be compared". No trimming, ANSI stripping, width inference, or
# whitespace normalization is allowed here.

import std/strings
import std/strutils as strutil

@abi_internal
@importc("ReadFile")
fn RustCsgTuiOracleTextReadFile(path: str): str

type
    RustCsgTuiOracleTextSnapshot =
        ok: bool
        path: str
        source: str
        expression: str
        bodyKind: str
        body: str
        bodyByteLen: int32
        bodyLineCount: int32
        error: str

    RustCsgTuiOracleTextFrame =
        ok: bool
        path: str
        body: str
        bodyByteLen: int32
        bodyLineCount: int32
        error: str

    RustCsgTuiOracleTextDiff =
        ok: bool
        path: str
        line: int32
        byteCol: int32
        expected: str
        actual: str
        error: str

fn RustCsgTuiOracleTextSnapshotFail(path: str, message: str): RustCsgTuiOracleTextSnapshot =
    var out: RustCsgTuiOracleTextSnapshot
    out.ok = false
    out.path = path
    out.error = message
    return out

fn RustCsgTuiOracleTextFrameFail(path: str, message: str): RustCsgTuiOracleTextFrame =
    var out: RustCsgTuiOracleTextFrame
    out.ok = false
    out.path = path
    out.error = message
    return out

fn RustCsgTuiOracleTextFindLineEnd(text: str, start: int32): int32 =
    let n: int32 = strings.Len(text)
    var i: int32 = start
    while i < n:
        if text[i] == '\n':
            return i
        i = i + 1
    return n

fn RustCsgTuiOracleTextLineIsDivider(text: str, start: int32, stop: int32): bool =
    if stop - start < 3:
        return false
    if text[start] != '-':
        return false
    if text[start + 1] != '-':
        return false
    if text[start + 2] != '-':
        return false
    var i: int32 = start + 3
    while i < stop:
        if text[i] != ' ' && text[i] != '\r':
            return false
        i = i + 1
    return true

fn RustCsgTuiOracleTextLineHasPrefix(text: str, start: int32, stop: int32, prefix: str): bool =
    let m: int32 = strings.Len(prefix)
    if stop - start < m:
        return false
    return strings.SliceBytes(text, start, m) == prefix

fn RustCsgTuiOracleTextLineValue(text: str, start: int32, stop: int32, prefix: str): str =
    let m: int32 = strings.Len(prefix)
    return strings.SliceBytes(text, start + m, stop - start - m)

fn RustCsgTuiOracleTextLineCount(text: str): int32 =
    let n: int32 = strings.Len(text)
    if n == 0:
        return 0
    var count: int32 = 0
    var i: int32 = 0
    while i < n:
        if text[i] == '\n':
            count = count + 1
        i = i + 1
    if text[n - 1] != '\n':
        count = count + 1
    return count

fn RustCsgTuiOracleTextBodyAllQuotedLines(body: str): bool =
    let n: int32 = strings.Len(body)
    if n == 0:
        return false
    var pos: int32 = 0
    var seen: bool = false
    while pos < n:
        let lineEnd: int32 = RustCsgTuiOracleTextFindLineEnd(body, pos)
        var stop: int32 = lineEnd
        if stop > pos && body[stop - 1] == '\r':
            stop = stop - 1
        if stop - pos < 2:
            return false
        if body[pos] != '"':
            return false
        if body[stop - 1] != '"':
            return false
        seen = true
        if lineEnd >= n:
            break
        pos = lineEnd + 1
    return seen

fn RustCsgTuiOracleTextUnquoteBodyLines(body: str): str =
    let n: int32 = strings.Len(body)
    var out: str = ""
    var pos: int32 = 0
    while pos < n:
        let lineEnd: int32 = RustCsgTuiOracleTextFindLineEnd(body, pos)
        var stop: int32 = lineEnd
        if stop > pos && body[stop - 1] == '\r':
            stop = stop - 1
        out = strutil.Join([out, strings.SliceBytes(body, pos + 1, stop - pos - 2)], "")
        if lineEnd < n:
            out = strutil.Join([out, "\n"], "")
        pos = lineEnd + 1
    return out

fn RustCsgTuiOracleTextParseSnapshot(text: str, path: str): RustCsgTuiOracleTextSnapshot =
    let n: int32 = strings.Len(text)
    if n == 0:
        return RustCsgTuiOracleTextSnapshotFail(path, "snapshot file is empty")

    let firstEnd: int32 = RustCsgTuiOracleTextFindLineEnd(text, 0)
    if !RustCsgTuiOracleTextLineIsDivider(text, 0, firstEnd):
        return RustCsgTuiOracleTextSnapshotFail(path, "snapshot first line is not an insta divider")

    var source: str = ""
    var expression: str = ""
    var pos: int32 = firstEnd + 1
    while pos <= n:
        let lineEnd: int32 = RustCsgTuiOracleTextFindLineEnd(text, pos)
        if RustCsgTuiOracleTextLineIsDivider(text, pos, lineEnd):
            let bodyStart: int32 = lineEnd + 1
            if bodyStart > n:
                return RustCsgTuiOracleTextSnapshotFail(path, "snapshot body is missing")
            if strings.Len(source) == 0:
                return RustCsgTuiOracleTextSnapshotFail(path, "snapshot header missing source")
            if strings.Len(expression) == 0:
                return RustCsgTuiOracleTextSnapshotFail(path, "snapshot header missing expression")
            let rawBody: str = strings.SliceBytes(text, bodyStart, n - bodyStart)
            if strings.Len(rawBody) == 0:
                return RustCsgTuiOracleTextSnapshotFail(path, "snapshot body is empty")

            var bodyKind: str = "raw"
            var body: str = rawBody
            if RustCsgTuiOracleTextBodyAllQuotedLines(rawBody):
                bodyKind = "quoted-lines"
                body = RustCsgTuiOracleTextUnquoteBodyLines(rawBody)

            var out: RustCsgTuiOracleTextSnapshot
            out.ok = true
            out.path = path
            out.source = source
            out.expression = expression
            out.bodyKind = bodyKind
            out.body = body
            out.bodyByteLen = strings.Len(body)
            out.bodyLineCount = RustCsgTuiOracleTextLineCount(body)
            return out

        if RustCsgTuiOracleTextLineHasPrefix(text, pos, lineEnd, "source: "):
            source = RustCsgTuiOracleTextLineValue(text, pos, lineEnd, "source: ")
        if RustCsgTuiOracleTextLineHasPrefix(text, pos, lineEnd, "expression: "):
            expression = RustCsgTuiOracleTextLineValue(text, pos, lineEnd, "expression: ")

        if lineEnd >= n:
            break
        pos = lineEnd + 1

    return RustCsgTuiOracleTextSnapshotFail(path, "snapshot second insta divider missing")

fn RustCsgTuiOracleTextParseSnapshotFile(path: str): RustCsgTuiOracleTextSnapshot =
    let text: str = RustCsgTuiOracleTextReadFile(path)
    if strings.Len(text) == 0:
        return RustCsgTuiOracleTextSnapshotFail(path, strutil.Join(["snapshot file unreadable or empty: ", path], ""))
    return RustCsgTuiOracleTextParseSnapshot(text, path)

fn RustCsgTuiOracleTextParseFrameFile(path: str): RustCsgTuiOracleTextFrame =
    let body: str = RustCsgTuiOracleTextReadFile(path)
    if strings.Len(body) == 0:
        return RustCsgTuiOracleTextFrameFail(path, strutil.Join(["frame file unreadable or empty: ", path], ""))
    var out: RustCsgTuiOracleTextFrame
    out.ok = true
    out.path = path
    out.body = body
    out.bodyByteLen = strings.Len(body)
    out.bodyLineCount = RustCsgTuiOracleTextLineCount(body)
    return out

fn RustCsgTuiOracleTextByteAtOrEof(text: str, index: int32): str =
    if index < 0:
        return "<eof>"
    if index >= strings.Len(text):
        return "<eof>"
    return strings.SliceBytes(text, index, 1)

fn RustCsgTuiOracleTextDiffAt(path: str, expected: str, actual: str, index: int32): RustCsgTuiOracleTextDiff =
    var line: int32 = 1
    var col: int32 = 1
    var i: int32 = 0
    while i < index && i < strings.Len(expected):
        if expected[i] == '\n':
            line = line + 1
            col = 1
        else:
            col = col + 1
        i = i + 1

    var out: RustCsgTuiOracleTextDiff
    out.ok = false
    out.path = path
    out.line = line
    out.byteCol = col
    out.expected = RustCsgTuiOracleTextByteAtOrEof(expected, index)
    out.actual = RustCsgTuiOracleTextByteAtOrEof(actual, index)
    out.error = strutil.Join(["oracle text mismatch at ", path, ":",
                              strings.IntToStr(line), ":", strings.IntToStr(col)], "")
    return out

fn RustCsgTuiOracleTextCompare(path: str, expected: str, actual: str): RustCsgTuiOracleTextDiff =
    let expectedLen: int32 = strings.Len(expected)
    let actualLen: int32 = strings.Len(actual)
    var limit: int32 = expectedLen
    if actualLen < limit:
        limit = actualLen

    var i: int32 = 0
    while i < limit:
        if expected[i] != actual[i]:
            return RustCsgTuiOracleTextDiffAt(path, expected, actual, i)
        i = i + 1

    if expectedLen != actualLen:
        return RustCsgTuiOracleTextDiffAt(path, expected, actual, limit)

    var out: RustCsgTuiOracleTextDiff
    out.ok = true
    out.path = path
    out.line = 0
    out.byteCol = 0
    return out

fn RustCsgTuiOracleTextOk(): str =
    return "ok"

fn RustCsgTuiOracleTextFailMessage(label: str, expected: str, got: str): str =
    return strutil.Join(["FAIL ", label, " expected=", expected, " got=", got], "")

fn RustCsgTuiOracleTextFailMessageI32(label: str, expected: int32, got: int32): str =
    return strutil.Join(["FAIL ", label, " expected=", strings.IntToStr(expected),
                         " got=", strings.IntToStr(got)], "")

fn RustCsgTuiOracleTextCompareStatus(path: str, expected: str, actual: str): str =
    let expectedLen: int32 = strings.Len(expected)
    let actualLen: int32 = strings.Len(actual)
    var limit: int32 = expectedLen
    if actualLen < limit:
        limit = actualLen

    var i: int32 = 0
    while i < limit:
        if expected[i] != actual[i]:
            return RustCsgTuiOracleTextDiffStatusAt(path, expected, actual, i)
        i = i + 1
    if expectedLen != actualLen:
        return RustCsgTuiOracleTextDiffStatusAt(path, expected, actual, limit)
    return "ok"

fn RustCsgTuiOracleTextDiffStatusAt(path: str, expected: str, actual: str, index: int32): str =
    var line: int32 = 1
    var col: int32 = 1
    var i: int32 = 0
    while i < index && i < strings.Len(expected):
        if expected[i] == '\n':
            line = line + 1
            col = 1
        else:
            col = col + 1
        i = i + 1
    return strutil.Join(["first_diff line=", strings.IntToStr(line),
                         " byte_col=", strings.IntToStr(col),
                         " expected=", RustCsgTuiOracleTextByteAtOrEof(expected, index),
                         " actual=", RustCsgTuiOracleTextByteAtOrEof(actual, index),
                         " path=", path], "")

fn RustCsgTuiOracleTextSnapshotContractFile(path: str,
                                            expectedSource: str,
                                            expectedExpression: str,
                                            expectedBodyKind: str,
                                            expectedLineCount: int32,
                                            requiredNeedleA: str,
                                            requiredNeedleB: str,
                                            requireUnquoted: int32): str =
    let text: str = RustCsgTuiOracleTextReadFile(path)
    let n: int32 = strings.Len(text)
    if n == 0:
        return strutil.Join(["snapshot file unreadable or empty: ", path], "")

    let firstEnd: int32 = RustCsgTuiOracleTextFindLineEnd(text, 0)
    if !RustCsgTuiOracleTextLineIsDivider(text, 0, firstEnd):
        return "snapshot first line is not an insta divider"

    var source: str = ""
    var expression: str = ""
    var pos: int32 = firstEnd + 1
    while pos <= n:
        let lineEnd: int32 = RustCsgTuiOracleTextFindLineEnd(text, pos)
        if RustCsgTuiOracleTextLineIsDivider(text, pos, lineEnd):
            let bodyStart: int32 = lineEnd + 1
            if bodyStart > n:
                return "snapshot body is missing"
            if strings.Len(source) == 0:
                return "snapshot header missing source"
            if strings.Len(expression) == 0:
                return "snapshot header missing expression"
            let rawBody: str = strings.SliceBytes(text, bodyStart, n - bodyStart)
            if strings.Len(rawBody) == 0:
                return "snapshot body is empty"
            var bodyKind: str = "raw"
            var body: str = rawBody
            if RustCsgTuiOracleTextBodyAllQuotedLines(rawBody):
                bodyKind = "quoted-lines"
                body = RustCsgTuiOracleTextUnquoteBodyLines(rawBody)
            if strings.Len(expectedSource) > 0 && source != expectedSource:
                return RustCsgTuiOracleTextFailMessage("snapshot_source", expectedSource, source)
            if strings.Len(expectedExpression) > 0 && expression != expectedExpression:
                return RustCsgTuiOracleTextFailMessage("snapshot_expression", expectedExpression, expression)
            if strings.Len(expectedBodyKind) > 0 && bodyKind != expectedBodyKind:
                return RustCsgTuiOracleTextFailMessage("snapshot_body_kind", expectedBodyKind, bodyKind)
            let lineCount: int32 = RustCsgTuiOracleTextLineCount(body)
            if expectedLineCount >= 0 && lineCount != expectedLineCount:
                return RustCsgTuiOracleTextFailMessageI32("snapshot_body_line_count", expectedLineCount, lineCount)
            if strings.Len(requiredNeedleA) > 0 && !strings.StrContains(body, requiredNeedleA):
                return strutil.Join(["FAIL snapshot_body_missing=", requiredNeedleA], "")
            if strings.Len(requiredNeedleB) > 0 && !strings.StrContains(body, requiredNeedleB):
                return strutil.Join(["FAIL snapshot_body_missing=", requiredNeedleB], "")
            if requireUnquoted != 0 && strings.HasPrefix(body, "\""):
                return "FAIL snapshot_body_still_quoted"
            return "ok"

        if RustCsgTuiOracleTextLineHasPrefix(text, pos, lineEnd, "source: "):
            source = RustCsgTuiOracleTextLineValue(text, pos, lineEnd, "source: ")
        if RustCsgTuiOracleTextLineHasPrefix(text, pos, lineEnd, "expression: "):
            expression = RustCsgTuiOracleTextLineValue(text, pos, lineEnd, "expression: ")
        if lineEnd >= n:
            break
        pos = lineEnd + 1

    return "snapshot second insta divider missing"

fn RustCsgTuiOracleTextFrameContractFile(path: str, expectedLineCount: int32): str =
    let body: str = RustCsgTuiOracleTextReadFile(path)
    if strings.Len(body) == 0:
        return strutil.Join(["frame file unreadable or empty: ", path], "")
    let lineCount: int32 = RustCsgTuiOracleTextLineCount(body)
    if lineCount != expectedLineCount:
        return RustCsgTuiOracleTextFailMessageI32("frame_body_line_count", expectedLineCount, lineCount)
    return "ok"

fn RustCsgTuiOracleTextSelfCompareSnapshotFile(path: str): str =
    return RustCsgTuiOracleTextSnapshotContractFile(path, "", "", "", -1, "", "", 0)

fn RustCsgTuiOracleTextCompareRenderedSnapshotFile(path: str,
                                                   rendered: str,
                                                   expectedLineCount: int32,
                                                   expectedBodyKind: str): str =
    let text: str = RustCsgTuiOracleTextReadFile(path)
    let n: int32 = strings.Len(text)
    if n == 0:
        return strutil.Join(["snapshot file unreadable or empty: ", path], "")

    let firstEnd: int32 = RustCsgTuiOracleTextFindLineEnd(text, 0)
    if !RustCsgTuiOracleTextLineIsDivider(text, 0, firstEnd):
        return "snapshot first line is not an insta divider"

    var source: str = ""
    var expression: str = ""
    var pos: int32 = firstEnd + 1
    while pos <= n:
        let lineEnd: int32 = RustCsgTuiOracleTextFindLineEnd(text, pos)
        if RustCsgTuiOracleTextLineIsDivider(text, pos, lineEnd):
            let bodyStart: int32 = lineEnd + 1
            if bodyStart > n:
                return "snapshot body is missing"
            if strings.Len(source) == 0:
                return "snapshot header missing source"
            if strings.Len(expression) == 0:
                return "snapshot header missing expression"
            let rawBody: str = strings.SliceBytes(text, bodyStart, n - bodyStart)
            if strings.Len(rawBody) == 0:
                return "snapshot body is empty"
            var bodyKind: str = "raw"
            var body: str = rawBody
            if RustCsgTuiOracleTextBodyAllQuotedLines(rawBody):
                bodyKind = "quoted-lines"
                body = RustCsgTuiOracleTextUnquoteBodyLines(rawBody)
            if bodyKind != expectedBodyKind:
                return RustCsgTuiOracleTextFailMessage("snapshot_body_kind", expectedBodyKind, bodyKind)
            let lineCount: int32 = RustCsgTuiOracleTextLineCount(body)
            if lineCount != expectedLineCount:
                return RustCsgTuiOracleTextFailMessageI32("snapshot_body_line_count", expectedLineCount, lineCount)
            return RustCsgTuiOracleTextCompareStatus(path, body, rendered)

        if RustCsgTuiOracleTextLineHasPrefix(text, pos, lineEnd, "source: "):
            source = RustCsgTuiOracleTextLineValue(text, pos, lineEnd, "source: ")
        if RustCsgTuiOracleTextLineHasPrefix(text, pos, lineEnd, "expression: "):
            expression = RustCsgTuiOracleTextLineValue(text, pos, lineEnd, "expression: ")
        if lineEnd >= n:
            break
        pos = lineEnd + 1

    return "snapshot second insta divider missing"

fn RustCsgTuiOracleTextFirstDiffContract(): str =
    let status: str = RustCsgTuiOracleTextCompareStatus("contract", "alpha\nbeta", "alpha\nBeta")
    if strings.Len(status) == 0:
        return "FAIL first_diff unexpectedly ok"
    if !strings.StrContains(status, "line=2"):
        return RustCsgTuiOracleTextFailMessage("first_diff_line_marker", "line=2", status)
    if !strings.StrContains(status, "byte_col=1"):
        return RustCsgTuiOracleTextFailMessage("first_diff_col_marker", "byte_col=1", status)
    if !strings.StrContains(status, "expected=b"):
        return RustCsgTuiOracleTextFailMessage("first_diff_expected_marker", "expected=b", status)
    if !strings.StrContains(status, "actual=B"):
        return RustCsgTuiOracleTextFailMessage("first_diff_actual_marker", "actual=B", status)
    return "ok"

fn RustCsgTuiOracleTextCheckQuotedDiffAddSnapshot(path: str): str =
    return RustCsgTuiOracleTextSnapshotContractFile(path,
                                                    "tui/src/diff_render.rs",
                                                    "terminal.backend()",
                                                    "quoted-lines",
                                                    10,
                                                    "new_file.txt",
                                                    "",
                                                    1)

fn RustCsgTuiOracleTextCheckRawAppSnapshot(path: str): str =
    return RustCsgTuiOracleTextSnapshotContractFile(path,
                                                    "tui/src/app.rs",
                                                    "snapshot",
                                                    "raw",
                                                    5,
                                                    "Agent |",
                                                    "",
                                                    0)

fn RustCsgTuiOracleTextCheckBacktrackSnapshot(path: str): str =
    return RustCsgTuiOracleTextSnapshotContractFile(path,
                                                    "tui/src/app_backtrack.rs",
                                                    "rendered",
                                                    "raw",
                                                    1,
                                                    "",
                                                    "",
                                                    0)
