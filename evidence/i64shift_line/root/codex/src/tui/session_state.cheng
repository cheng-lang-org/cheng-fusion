import std/strings
import cheng/codex/protocol/types
import cheng/codex/protocol/wire
import cheng/codex/tui/session_lifecycle as lifecycle

const
    RustCsgTuiSessionLifecycleStart: str = "start"
    RustCsgTuiSessionLifecycleResume: str = "resume"
    RustCsgTuiSessionLifecycleFork: str = "fork"

type
    RustCsgTuiSessionStateConfig =
        permissionProfileJson: str
        personalityJson: str
        messageHistoryLogId: int64
        messageHistoryEntryCount: int32

    RustCsgTuiThreadSessionState =
        threadId: str
        forkedFromId: str
        forkParentTitle: str
        threadName: str
        model: str
        modelProviderId: str
        serviceTier: str
        approvalPolicyJson: str
        approvalsReviewer: str
        permissionProfileJson: str
        permissionProfileSource: str
        activePermissionProfileJson: str
        cwd: str
        runtimeWorkspaceRootsJson: str
        instructionSourcePathsJson: str
        reasoningEffort: str
        collaborationModeJson: str
        personalityJson: str
        messageHistoryLogId: int64
        messageHistoryEntryCount: int32
        networkProxyJson: str
        rolloutPath: str

    RustCsgTuiAppServerStartedThread =
        ok: bool
        session: RustCsgTuiThreadSessionState
        turnsJson: str
        turnCount: int32
        error: str

fn RustCsgTuiSessionStateError(message: str): RustCsgTuiAppServerStartedThread =
    var result: RustCsgTuiAppServerStartedThread
    result.error = message
    return result

fn RustCsgTuiSessionStateStarted(session: RustCsgTuiThreadSessionState,
                                 turnsJson: str,
                                 turnCount: int32): RustCsgTuiAppServerStartedThread =
    var result: RustCsgTuiAppServerStartedThread
    result.ok = true
    result.session = session
    result.turnsJson = turnsJson
    result.turnCount = turnCount
    return result

fn RustCsgTuiSessionStateIsHexChar(ch: char): bool =
    if ch >= '0' && ch <= '9':
        return true
    if ch >= 'a' && ch <= 'f':
        return true
    if ch >= 'A' && ch <= 'F':
        return true
    return false

fn RustCsgTuiSessionStateLooksLikeUuid(value: str): bool =
    if value.len != 36:
        return false
    var i: int32
    while i < value.len:
        if i == 8 || i == 13 || i == 18 || i == 23:
            if value[i] != '-':
                return false
        elif !RustCsgTuiSessionStateIsHexChar(value[i]):
            return false
        i = i + 1
    return true

fn RustCsgTuiSessionStatePathLooksAbsolute(path: str): bool =
    return path.len > 0 && path[0] == '/'

fn RustCsgTuiSessionStateValidateAbsolutePath(path: str, label: str): str =
    if RustCsgTuiSessionStatePathLooksAbsolute(path):
        return ""
    return wire.RustCsgCat(label, " must be absolute")

fn RustCsgTuiSessionStateValidateAbsolutePaths(values: str[], label: str): str =
    for i in 0..<values.len:
        let err = RustCsgTuiSessionStateValidateAbsolutePath(values[i], label)
        if err != "":
            return err
    return ""

fn RustCsgTuiSessionStateLifecycleValid(lifecycleKind: str): bool =
    return lifecycleKind == RustCsgTuiSessionLifecycleStart ||
           lifecycleKind == RustCsgTuiSessionLifecycleResume ||
           lifecycleKind == RustCsgTuiSessionLifecycleFork

fn RustCsgTuiSessionStateArrayItemCount(arrayJson: str): int32 =
    let start = wire.RustCsgSkipJsonSpace(arrayJson, 0)
    if start >= arrayJson.len || arrayJson[start] != '[':
        assert(false, "json array expected")
    var count: int32
    var depth: int32
    var inString: bool
    var escaped: bool
    var sawValue: bool
    var i = start + 1
    while i < arrayJson.len:
        let ch = arrayJson[i]
        if inString:
            if escaped:
                escaped = false
            elif ch == '\\':
                escaped = true
            elif ch == '"':
                inString = false
        elif ch == '"':
            inString = true
            sawValue = true
        elif ch == '[' || ch == '{':
            depth = depth + 1
            sawValue = true
        elif ch == ']' || ch == '}':
            if depth == 0:
                if sawValue:
                    count = count + 1
                return count
            depth = depth - 1
        elif ch == ',' && depth == 0:
            count = count + 1
            sawValue = false
        elif ch != ' ' && ch != '\n' && ch != '\r' && ch != '\t':
            sawValue = true
        i = i + 1
    assert(false, "unterminated json array")
    return 0

fn RustCsgTuiSessionStatePermissionProfileJson(response: var types.RustCsgThreadLifecycleResponse,
                                               config: var RustCsgTuiSessionStateConfig,
                                               lifecycleKind: str,
                                               threadParamsMode: str,
                                               outSource: var str): str =
    if threadParamsMode == lifecycle.RustCsgTuiThreadParamsModeRemote:
        outSource = "sandbox"
        return response.sandboxJson
    if lifecycleKind == RustCsgTuiSessionLifecycleResume && response.activePermissionProfileJson == "":
        outSource = "legacy_sandbox"
        return response.sandboxJson
    outSource = "config"
    return config.permissionProfileJson

fn RustCsgTuiSessionStateFromLifecycleResponseJson(responseJson: str,
                                                   lifecycleKind: str,
                                                   threadParamsMode: str,
                                                   config: var RustCsgTuiSessionStateConfig): RustCsgTuiAppServerStartedThread =
    if !RustCsgTuiSessionStateLifecycleValid(lifecycleKind):
        return RustCsgTuiSessionStateError(wire.RustCsgCat("unsupported lifecycle kind: ", lifecycleKind))
    if threadParamsMode != lifecycle.RustCsgTuiThreadParamsModeEmbedded &&
       threadParamsMode != lifecycle.RustCsgTuiThreadParamsModeRemote:
        return RustCsgTuiSessionStateError(wire.RustCsgCat("unsupported thread params mode: ", threadParamsMode))
    var response = wire.RustCsgThreadLifecycleResponseFromJson(responseJson)
    if !RustCsgTuiSessionStateLooksLikeUuid(response.thread.id):
        return RustCsgTuiSessionStateError(wire.RustCsgCat("thread id is invalid: ", response.thread.id))
    if response.thread.forkedFromId != "" && !RustCsgTuiSessionStateLooksLikeUuid(response.thread.forkedFromId):
        return RustCsgTuiSessionStateError(wire.RustCsgCat("forked_from_id is invalid: ", response.thread.forkedFromId))
    let cwdError = RustCsgTuiSessionStateValidateAbsolutePath(response.cwd, "cwd")
    if cwdError != "":
        return RustCsgTuiSessionStateError(cwdError)
    let rootsError = RustCsgTuiSessionStateValidateAbsolutePaths(response.runtimeWorkspaceRoots, "runtime workspace root")
    if rootsError != "":
        return RustCsgTuiSessionStateError(rootsError)
    let instructionError = RustCsgTuiSessionStateValidateAbsolutePaths(response.instructionSources, "instruction source")
    if instructionError != "":
        return RustCsgTuiSessionStateError(instructionError)

    var permissionSource: str
    let permissionProfileJson = RustCsgTuiSessionStatePermissionProfileJson(response,
                                                                            config,
                                                                            lifecycleKind,
                                                                            threadParamsMode,
                                                                            permissionSource)
    if permissionProfileJson == "":
        return RustCsgTuiSessionStateError("permission profile is empty")

    var state: RustCsgTuiThreadSessionState
    state.threadId = response.thread.id
    state.forkedFromId = response.thread.forkedFromId
    state.threadName = response.thread.name
    state.model = response.model
    state.modelProviderId = response.modelProvider
    state.serviceTier = response.serviceTier
    state.approvalPolicyJson = response.approvalPolicyJson
    state.approvalsReviewer = response.approvalsReviewer
    state.permissionProfileJson = permissionProfileJson
    state.permissionProfileSource = permissionSource
    state.activePermissionProfileJson = response.activePermissionProfileJson
    state.cwd = response.cwd
    state.runtimeWorkspaceRootsJson = wire.RustCsgJsonStringArray(response.runtimeWorkspaceRoots)
    state.instructionSourcePathsJson = wire.RustCsgJsonStringArray(response.instructionSources)
    state.reasoningEffort = response.reasoningEffort
    state.personalityJson = config.personalityJson
    state.messageHistoryLogId = config.messageHistoryLogId
    state.messageHistoryEntryCount = config.messageHistoryEntryCount
    state.rolloutPath = response.thread.path
    return RustCsgTuiSessionStateStarted(state,
                                         response.thread.turnsJson,
                                         RustCsgTuiSessionStateArrayItemCount(response.thread.turnsJson))

fn RustCsgTuiStartedThreadSetForkParentTitle(started: var RustCsgTuiAppServerStartedThread,
                                             forkParentTitle: str): RustCsgTuiAppServerStartedThread =
    var result: RustCsgTuiAppServerStartedThread
    result.ok = started.ok
    result.session = started.session
    result.turnsJson = started.turnsJson
    result.turnCount = started.turnCount
    result.error = started.error
    result.session.forkParentTitle = forkParentTitle
    return result

fn RustCsgTuiThreadSessionStateToJson(state: var RustCsgTuiThreadSessionState): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("threadId", state.threadId))
    out = wire.RustCsgCat(out, wire.RustCsgJsonNullableFieldStr("forkedFromId", state.forkedFromId))
    out = wire.RustCsgCat(out, wire.RustCsgJsonNullableFieldStr("forkParentTitle", state.forkParentTitle))
    out = wire.RustCsgCat(out, wire.RustCsgJsonNullableFieldStr("threadName", state.threadName))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("model", state.model))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("modelProviderId", state.modelProviderId))
    out = wire.RustCsgCat(out, wire.RustCsgJsonNullableFieldStr("serviceTier", state.serviceTier))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("approvalPolicy", state.approvalPolicyJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("approvalsReviewer", state.approvalsReviewer))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("permissionProfile", state.permissionProfileJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("permissionProfileSource", state.permissionProfileSource))
    out = wire.RustCsgCat(out, wire.RustCsgJsonNullableFieldRaw("activePermissionProfile", state.activePermissionProfileJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("cwd", state.cwd))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("runtimeWorkspaceRoots", state.runtimeWorkspaceRootsJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("instructionSourcePaths", state.instructionSourcePathsJson))
    out = wire.RustCsgCat(out, wire.RustCsgJsonNullableFieldStr("reasoningEffort", state.reasoningEffort))
    out = wire.RustCsgCat(out, wire.RustCsgJsonNullableFieldRaw("collaborationMode", state.collaborationModeJson))
    out = wire.RustCsgCat(out, wire.RustCsgJsonNullableFieldRaw("personality", state.personalityJson))
    out = wire.RustCsgCat(out, ",\"messageHistory\":{")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt64("logId", state.messageHistoryLogId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("entryCount", state.messageHistoryEntryCount))
    out = wire.RustCsgCat(out, "}")
    out = wire.RustCsgCat(out, wire.RustCsgJsonNullableFieldRaw("networkProxy", state.networkProxyJson))
    out = wire.RustCsgCat(out, wire.RustCsgJsonNullableFieldStr("rolloutPath", state.rolloutPath))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgTuiAppServerStartedThreadToJson(started: var RustCsgTuiAppServerStartedThread): str =
    if !started.ok:
        return wire.RustCsgCat(wire.RustCsgCat("{\"ok\":false,\"error\":", wire.RustCsgJsonQuote(started.error)), "}")
    var out = "{\"ok\":true,\"session\":"
    out = wire.RustCsgCat(out, RustCsgTuiThreadSessionStateToJson(started.session))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("turns", started.turnsJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("turnCount", started.turnCount))
    out = wire.RustCsgCat(out, "}")
    return out
