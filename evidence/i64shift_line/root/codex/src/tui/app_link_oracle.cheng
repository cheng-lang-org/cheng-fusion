# TUI bottom_pane/app_link_view raw render_snapshot oracle.

import std/strutils as strutil

fn RustCsgTuiAppLinkHintLine(): str =
    return "  Use tab / ↑ ↓ to move, enter to select, esc to close"

fn RustCsgTuiAppLinkSelectedAction(label: str): str =
    return strutil.Join(["  › 1. ", label], "")

fn RustCsgTuiAppLinkPlainAction(indexText: str, label: str): str =
    return strutil.Join(["    ", indexText, ". ", label], "")

fn RustCsgTuiAppLinkInstallSuggestionSnapshot(): str =
    return strutil.Join([
        "",
        "  Google Calendar",
        "  Plan events and schedules.",
        "",
        "  Plan and reference events from your calendar",
        "",
        "  Install this app in your browser, then return here.",
        "  Newly installed apps can take a few minutes to appear in /apps.",
        "  After installed, use $ to insert this app into the prompt.",
        "",
        "",
        RustCsgTuiAppLinkSelectedAction("Install on ChatGPT"),
        RustCsgTuiAppLinkPlainAction("2", "Back"),
        RustCsgTuiAppLinkHintLine(),
        "",
    ], "\n")

fn RustCsgTuiAppLinkEnableSuggestionSnapshot(): str =
    return strutil.Join([
        "",
        "  Google Calendar",
        "  Plan events and schedules.",
        "",
        "  Plan and reference events from your calendar",
        "",
        "  Use $ to insert this app into the prompt.",
        "",
        "  Enable this app to use it for the current request.",
        "  Newly installed apps can take a few minutes to appear in /apps.",
        "",
        "",
        RustCsgTuiAppLinkSelectedAction("Manage on ChatGPT"),
        RustCsgTuiAppLinkPlainAction("2", "Enable app"),
        RustCsgTuiAppLinkPlainAction("3", "Back"),
        RustCsgTuiAppLinkHintLine(),
        "",
    ], "\n")

fn RustCsgTuiAppLinkAuthSuggestionSnapshot(): str =
    return strutil.Join([
        "",
        "  Google Calendar",
        "",
        "  Reconnect Google Calendar on ChatGPT.",
        "",
        "  URL",
        "  https://chatgpt.com/apps/google-calendar/connector_google_calendar",
        "",
        "  Sign in to this app in your browser, then return here.",
        "",
        "",
        RustCsgTuiAppLinkSelectedAction("Open sign-in URL"),
        RustCsgTuiAppLinkPlainAction("2", "Back"),
        RustCsgTuiAppLinkHintLine(),
        "",
    ], "\n")

fn RustCsgTuiAppLinkGenericUrlSnapshot(): str =
    return strutil.Join([
        "",
        "  Action required",
        "  Server: payments",
        "",
        "  Review the payment details to continue.",
        "",
        "  URL",
        "  https://payments.example/checkout/123",
        "",
        "  Complete the requested action in your browser, then return here.",
        "",
        "",
        RustCsgTuiAppLinkSelectedAction("Open link"),
        RustCsgTuiAppLinkPlainAction("2", "Back"),
        RustCsgTuiAppLinkHintLine(),
        "",
    ], "\n")

fn RustCsgTuiAppLinkGenericUrlConfirmationSnapshot(): str =
    return strutil.Join([
        "",
        "  Finish in Browser",
        "",
        "  Complete the requested action in the browser window that just",
        "  opened.",
        "  Then return here and select \"I finished\".",
        "",
        "  Link:",
        "  https://payments.example/checkout/123",
        "",
        "  › 1. I finished",
        RustCsgTuiAppLinkPlainAction("2", "Back"),
        RustCsgTuiAppLinkHintLine(),
        "",
    ], "\n")
