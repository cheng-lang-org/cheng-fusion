    out = strings.ConcatStr(out, RustCsgTuiKeymapActionMenuRow("alt-shift-enter", "Replace this binding."))
    return out

# ── 2. keymap_capture_view (expression: "format!(\"{:?}\", render_capture(&view, 80, 8))") ──
# Rust Debug-formatted ratatui Buffer with 8 content lines padded to width 80.

fn RustCsgTuiKeymapCaptureViewFixture(): str =
    var out: str = "Buffer {\n"
    out = strings.ConcatStr(out, "    area: Rect { x: 0, y: 0, width: 80, height: 8 },\n")
    out = strings.ConcatStr(out, "    content: [\n")
    out = strings.ConcatStr(out, RustCsgTuiKeymapCaptureContentLine("Remap Shortcut", 80))
    out = strings.ConcatStr(out, RustCsgTuiKeymapCaptureContentLine("Action: Submit  composer.submit", 80))
    out = strings.ConcatStr(out, RustCsgTuiKeymapCaptureContentLine("Current: enter", 80))
    out = strings.ConcatStr(out, RustCsgTuiKeymapCaptureContentLine("Press the new key now. Esc cancels.", 80))
    var i: int32 = 0
    while i < 4:
        out = strings.ConcatStr(out, RustCsgTuiKeymapCaptureContentLine("", 80))
        i = i + 1
    out = strings.ConcatStr(out, "    ],\n")
    out = strings.ConcatStr(out, "    styles: [\n")
    out = strings.ConcatStr(out, "        x: 0, y: 0, fg: Reset, bg: Reset, underline: Reset, modifier: BOLD,\n")
    out = strings.ConcatStr(out, "        x: 14, y: 0, fg: Reset, bg: Reset, underline: Reset, modifier: NONE,\n")
    out = strings.ConcatStr(out, "        x: 0, y: 1, fg: Reset, bg: Reset, underline: Reset, modifier: DIM,\n")
    out = strings.ConcatStr(out, "        x: 8, y: 1, fg: Reset, bg: Reset, underline: Reset, modifier: NONE,\n")
    out = strings.ConcatStr(out, "        x: 16, y: 1, fg: Reset, bg: Reset, underline: Reset, modifier: DIM,\n")
    out = strings.ConcatStr(out, "        x: 31, y: 1, fg: Reset, bg: Reset, underline: Reset, modifier: NONE,\n")
    out = strings.ConcatStr(out, "        x: 0, y: 2, fg: Reset, bg: Reset, underline: Reset, modifier: DIM,\n")
    out = strings.ConcatStr(out, "        x: 9, y: 2, fg: Cyan, bg: Reset, underline: Reset, modifier: NONE,\n")
    out = strings.ConcatStr(out, "        x: 14, y: 2, fg: Reset, bg: Reset, underline: Reset, modifier: NONE,\n")
    out = strings.ConcatStr(out, "        x: 0, y: 3, fg: Reset, bg: Reset, underline: Reset, modifier: DIM,\n")
    out = strings.ConcatStr(out, "        x: 35, y: 3, fg: Reset, bg: Reset, underline: Reset, modifier: NONE,\n")
    out = strings.ConcatStr(out, "    ]\n")
    out = strings.ConcatStr(out, "}\n")
    return out

