# Small Cheng renderer for TUI keymap_setup oracle slices.
#
# Covers 11 snapshots from tui/src/keymap_setup.rs:
#   keymap_action_menu, keymap_capture_view,
#   keymap_debug_view_initial, keymap_debug_view_delayed_hint, keymap_debug_view_match,
#   keymap_picker_all_tab_search, keymap_picker_custom, keymap_picker_fast_mode_enabled,
#   keymap_picker_first_actions, keymap_picker_narrow, keymap_picker_wide

import std/strings
import std/strutils as strutil

# ── Helpers ────────────────────────────────────────────────────────────────────

fn RustCsgTuiKeymapOracleSpaces(count: int32): str =
    var out: str = ""
    var i: int32 = 0
    while i < count:
        out = strings.ConcatStr(out, " ")
        i = i + 1
    return out

fn RustCsgTuiKeymapPadAscii(text: str, width: int32): str =
    let n: int32 = strings.Len(text)
    if n >= width:
        return text
    return strings.ConcatStr(text, RustCsgTuiKeymapOracleSpaces(width - n))

fn RustCsgTuiKeymapActionSearchLine(name: str,
                                    binding: str,
                                    contextLabel: str,
                                    action: str,
                                    description: str,
                                    source: str): str =
    return strutil.Join([name, " | ", binding, " | ", contextLabel, " ", action, " ", name, " ", description, " ", binding, " ", source], "")

fn RustCsgTuiKeymapAppendActionSearchLine(out: str,
                                          name: str,
                                          binding: str,
                                          contextLabel: str,
                                          action: str,
                                          description: str,
                                          source: str): str =
    return strings.ConcatStr(out, strings.ConcatStr(RustCsgTuiKeymapActionSearchLine(name, binding, contextLabel, action, description, source), "\n"))

fn RustCsgTuiKeymapAllTabSearchRows(): str =
    var out: str = ""
    out = RustCsgTuiKeymapAppendActionSearchLine(out, "Open Transcript", "ctrl-t", "Global", "open_transcript", "Open the transcript overlay.", "Default")
    out = RustCsgTuiKeymapAppendActionSearchLine(out, "Open External Editor", "ctrl-g", "Global", "open_external_editor", "Open the current draft in an external editor.", "Default")
    out = RustCsgTuiKeymapAppendActionSearchLine(out, "Copy", "ctrl-o", "Global", "copy", "Copy the last agent response to the clipboard.", "Default")
    out = RustCsgTuiKeymapAppendActionSearchLine(out, "Clear Terminal", "ctrl-l", "Global", "clear_terminal", "Clear the terminal UI.", "Default")
    out = RustCsgTuiKeymapAppendActionSearchLine(out, "Toggle Vim Mode", "unbound", "Global", "toggle_vim_mode", "Turn Vim composer mode on or off.", "Default")
    out = RustCsgTuiKeymapAppendActionSearchLine(out, "Toggle Raw Output", "alt-r", "Global", "toggle_raw_output", "Toggle raw scrollback mode.", "Default")
    out = RustCsgTuiKeymapAppendActionSearchLine(out, "Interrupt Turn", "esc", "Chat", "interrupt_turn", "Interrupt the active turn.", "Default")
    out = RustCsgTuiKeymapAppendActionSearchLine(out, "Decrease Reasoning Effort", "alt-,", "Chat", "decrease_reasoning_effort", "Decrease reasoning effort.", "Default")
    out = RustCsgTuiKeymapAppendActionSearchLine(out, "Increase Reasoning Effort", "alt-.", "Chat", "increase_reasoning_effort", "Increase reasoning effort.", "Default")
    out = RustCsgTuiKeymapAppendActionSearchLine(out, "Edit Queued Message", "alt-up, shift-left", "Chat", "edit_queued_message", "Edit the most recently queued message.", "Default")
    out = RustCsgTuiKeymapAppendActionSearchLine(out, "Submit", "enter", "Composer", "submit", "Submit the current composer draft.", "Default")
    out = RustCsgTuiKeymapAppendActionSearchLine(out, "Queue", "tab", "Composer", "queue", "Queue the draft while a task is running.", "Default")
    return out

fn RustCsgTuiKeymapTabSummaryLine(label: str, selectable: int32): str =
    return strutil.Join(["tab: ", label, " (", strings.IntToStr(selectable), " selectable)\n"], "")

fn RustCsgTuiKeymapPickerTabs(customCount: int32, unboundCount: int32, width: int32): str =
    let first: str = strutil.Join(["  [All]  Common  Customized (", strings.IntToStr(customCount), ")  Unbound (", strings.IntToStr(unboundCount), ")  App  Composer  Editor  Vim"], "")
    let rest: str = "Navigation  Approval  Debug"
    if width < 100:
        return strutil.Join([first, "\n  ", rest], "")
    return strutil.Join([first, "  ", rest], "")

fn RustCsgTuiKeymapPickerRow(selected: bool, contextLabel: str, name: str, binding: str): str =
    var selector: str = "  "
    if selected:
        selector = "› "
    var indicator: str = "  "
    if binding == "unbound":
        indicator = "- "
    let rowName: str = strutil.Join([RustCsgTuiKeymapPadAscii(contextLabel, 12), " ", indicator, name], "")
    return strutil.Join([selector, RustCsgTuiKeymapPadAscii(rowName, 40), "  ", binding], "")

fn RustCsgTuiKeymapPickerVisibleRows(fastModeEnabled: bool): str =
    var out: str = ""
    out = strings.ConcatStr(out, strings.ConcatStr(RustCsgTuiKeymapPickerRow(true, "Global", "Open Transcript", "ctrl-t"), "\n"))
    out = strings.ConcatStr(out, strings.ConcatStr(RustCsgTuiKeymapPickerRow(false, "Global", "Open External Editor", "ctrl-g"), "\n"))
    out = strings.ConcatStr(out, strings.ConcatStr(RustCsgTuiKeymapPickerRow(false, "Global", "Copy", "ctrl-o"), "\n"))
    out = strings.ConcatStr(out, strings.ConcatStr(RustCsgTuiKeymapPickerRow(false, "Global", "Clear Terminal", "ctrl-l"), "\n"))
    out = strings.ConcatStr(out, strings.ConcatStr(RustCsgTuiKeymapPickerRow(false, "Global", "Toggle Vim Mode", "unbound"), "\n"))
    if fastModeEnabled:
        out = strings.ConcatStr(out, strings.ConcatStr(RustCsgTuiKeymapPickerRow(false, "Global", "Toggle Fast Mode", "unbound"), "\n"))
        out = strings.ConcatStr(out, strings.ConcatStr(RustCsgTuiKeymapPickerRow(false, "Global", "Toggle Raw Output", "alt-r"), "\n"))
        out = strings.ConcatStr(out, strings.ConcatStr(RustCsgTuiKeymapPickerRow(false, "Chat", "Interrupt Turn", "esc"), "\n"))
    else:
        out = strings.ConcatStr(out, strings.ConcatStr(RustCsgTuiKeymapPickerRow(false, "Global", "Toggle Raw Output", "alt-r"), "\n"))
        out = strings.ConcatStr(out, strings.ConcatStr(RustCsgTuiKeymapPickerRow(false, "Chat", "Interrupt Turn", "esc"), "\n"))
        out = strings.ConcatStr(out, strings.ConcatStr(RustCsgTuiKeymapPickerRow(false, "Chat", "Decrease Reasoning Effort", "alt-,"), "\n"))
    return out

fn RustCsgTuiKeymapRenderPicker(totalActions: int32,
                                customCount: int32,
                                unboundCount: int32,
                                fastModeEnabled: bool,
                                width: int32): str =
    var out: str = "\n"
    out = strings.ConcatStr(out, "  Keymap\n")
    out = strings.ConcatStr(out, "  All configurable shortcuts.\n")
    out = strings.ConcatStr(out, strutil.Join(["  ", strings.IntToStr(totalActions), " actions, ", strings.IntToStr(customCount), " customized, ", strings.IntToStr(unboundCount), " unbound.\n"], ""))
    out = strings.ConcatStr(out, "\n")
    out = strings.ConcatStr(out, RustCsgTuiKeymapPickerTabs(customCount, unboundCount, width))
    out = strings.ConcatStr(out, "\n\n")
    out = strings.ConcatStr(out, "  Type to search shortcuts\n")
    out = strings.ConcatStr(out, RustCsgTuiKeymapPickerVisibleRows(fastModeEnabled))
    out = strings.ConcatStr(out, "\n")
    out = strings.ConcatStr(out, "  left/right group · enter edit shortcut · * custom · - unbound · esc close\n")
    return out

fn RustCsgTuiKeymapDebugRender(delayedHint: bool,
                               detected: str,
                               configKey: str,
                               rawEvent: str,
                               assignedAction: str,
                               assignedLabel: str,
                               assignedDescription: str,
                               assignedSource: str): str =
    var out: str = "Keypress Inspector\n"
    out = strings.ConcatStr(out, "Press any key to see what Codex receives. Esc is inspected; Ctrl+C closes.\n")
    if delayedHint:
        out = strings.ConcatStr(out, "Still waiting? If nothing changes when you press a key, your terminal is not sending that key to\n")
        out = strings.ConcatStr(out, "Codex. Only received keys can be assigned as shortcuts.\n")
    else:
        out = strings.ConcatStr(out, "Tip: Codex can only inspect keys your terminal sends.\n")
    out = strings.ConcatStr(out, "\n")
    if strings.Len(detected) == 0:
        out = strings.ConcatStr(out, "Waiting for a keypress...\n")
        return out
    out = strings.ConcatStr(out, strutil.Join(["Detected: ", detected, "\n"], ""))
    out = strings.ConcatStr(out, strutil.Join(["Config key: ", configKey, "\n"], ""))
    out = strings.ConcatStr(out, strutil.Join(["Raw event: ", rawEvent, "\n"], ""))
    out = strings.ConcatStr(out, "\n")
    out = strings.ConcatStr(out, "Assigned actions:\n")
    out = strings.ConcatStr(out, strutil.Join(["  - ", assignedAction, " (", assignedLabel, ") - ", assignedDescription, " [", assignedSource, "]\n"], ""))
    return out

fn RustCsgTuiKeymapCaptureContentLine(text: str, width: int32): str =
    return strutil.Join(["        \"", RustCsgTuiKeymapPadAscii(text, width), "\",\n"], "")

fn RustCsgTuiKeymapActionMenuRow(name: str, description: str): str =
    return strutil.Join([name, " | ", description, " | enabled\n"], "")

