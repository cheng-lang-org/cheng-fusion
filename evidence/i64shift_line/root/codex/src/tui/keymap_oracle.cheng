    out = strings.ConcatStr(out, RustCsgTuiKeymapActionMenuRow("Add alternate binding", "Keep current bindings and add another key."))
    out = strings.ConcatStr(out, RustCsgTuiKeymapActionMenuRow("Remove custom binding", "Restore the default keymap binding."))
