import std/strings
import cheng/codex/protocol/wire
import cheng/codex/tui/session_cwd_prompt as cwd_prompt
import cheng/codex/tui/session_picker as picker
import cheng/codex/tui/session_root_flow as root_flow

type
    RustCsgTuiSessionRootTerminalPickerConfig =
        action: str
        selectedIndex: int32
        query: str
        cwdFilter: str
        sortKey: str
        limit: int32
        dense: bool
        showCwd: bool
        width: int32
        listHeight: int32
        viewRows: int32
        cwdPromptWidth: int32
        nowMs: int64

    RustCsgTuiSessionRootTerminalPickerResult =
        ok: bool
        okI: int32
        selectionKind: str
        threadId: str
        path: str
        displayLabel: str
        screen: str
        frameCount: int32
        error: str

    RustCsgTuiSessionRootTerminalFlowResult =
        ok: bool
        outcome: str
        pickerSelectionKind: str
        pickerThreadId: str
        pickerPath: str
        pickerDisplayLabel: str
        pickerScreen: str
        pickerFrameCount: int32
        cwdPromptOutcome: str
        cwdPromptSelection: str
        cwdPromptScreen: str
        cwdPromptFrameCount: int32
        rootOutcome: str
        rootJson: str
        appFirstFrameText: str
        error: str

fn RustCsgTuiSessionRootTerminalFlowError(message: str): RustCsgTuiSessionRootTerminalFlowResult =
    var result: RustCsgTuiSessionRootTerminalFlowResult
    result.outcome = "error"
    result.error = message
    return result

fn RustCsgTuiSessionRootTerminalPickerError(message: str): RustCsgTuiSessionRootTerminalPickerResult =
    var result: RustCsgTuiSessionRootTerminalPickerResult
    result.error = message
    return result

fn RustCsgTuiSessionRootTerminalPickerDone(selectionKind: str): RustCsgTuiSessionRootTerminalPickerResult =
    var result: RustCsgTuiSessionRootTerminalPickerResult
    result.ok = true
    result.okI = 1
    result.selectionKind = selectionKind
    result.frameCount = 1
    return result

fn RustCsgTuiSessionRootTerminalPickerFromSelection(selection: var picker.RustCsgTuiSessionPickerSelectionResult): RustCsgTuiSessionRootTerminalPickerResult =
    if !selection.ok:
        return RustCsgTuiSessionRootTerminalPickerError(selection.error)
    var result: RustCsgTuiSessionRootTerminalPickerResult
    result.ok = true
    result.okI = 1
    result.selectionKind = selection.kind
    result.threadId = selection.threadId
    result.path = selection.path
    result.displayLabel = selection.displayLabel
    result.frameCount = 1
    return result

fn RustCsgTuiSessionRootTerminalPickerCtrlC(): str =
    return strings.CharToStr(Char(3))

fn RustCsgTuiSessionRootTerminalPickerEsc(): str =
    return strings.CharToStr(Char(27))

fn RustCsgTuiSessionRootTerminalPickerNone(frameCount: int32): RustCsgTuiSessionRootTerminalPickerResult =
    var result: RustCsgTuiSessionRootTerminalPickerResult
    result.ok = true
    result.okI = 1
    result.selectionKind = "none"
    result.frameCount = frameCount
    return result

fn RustCsgTuiSessionRootTerminalPickerDoneFrame(selectionKind: str,
                                                frameCount: int32): RustCsgTuiSessionRootTerminalPickerResult =
    var result: RustCsgTuiSessionRootTerminalPickerResult
    result.ok = true
    result.okI = 1
    result.selectionKind = selectionKind
    result.frameCount = frameCount
    return result

fn RustCsgTuiSessionRootTerminalPickerSelectionFrame(selection: var picker.RustCsgTuiSessionPickerSelectionResult,
                                                     frameCount: int32): RustCsgTuiSessionRootTerminalPickerResult =
    let result = RustCsgTuiSessionRootTerminalPickerFromSelection(selection)
    if !result.ok:
        return result
    var framed = result
    framed.frameCount = frameCount
    return framed

fn RustCsgTuiSessionRootTerminalCanMoveTo(dbPath: str,
                                          config: var RustCsgTuiSessionRootTerminalPickerConfig,
                                          targetIndex: int32,
                                          query: str): bool =
    if targetIndex < 0:
        return false
    let probe = picker.RustCsgTuiSessionPickerSelectFromStateDb(dbPath,
                                                                config.action,
                                                                targetIndex,
                                                                query,
                                                                config.cwdFilter,
                                                                config.sortKey,
                                                                config.limit)
    return probe.ok

fn RustCsgTuiSessionRootTerminalPickerPopAscii(text: str): str =
    if strings.Len(text) <= 0:
        return text
    return strings.SliceBytes(text, 0, strings.Len(text) - 1)

fn RustCsgTuiSessionRootTerminalRunPickerStrict(dbPath: str,
                                                config: var RustCsgTuiSessionRootTerminalPickerConfig,
                                                sequenceStream: str): RustCsgTuiSessionRootTerminalPickerResult =
    var currentSelected = config.selectedIndex
    var currentQuery = config.query
    var frameCount: int32 = 1
    if sequenceStream == "":
        return RustCsgTuiSessionRootTerminalPickerNone(frameCount)

    var offset: int32
    let streamLen = strings.Len(sequenceStream)
    while offset < streamLen:
        var tokenEnd: int32 = offset
        while tokenEnd < streamLen && Int32(sequenceStream[tokenEnd]) != 124:
            tokenEnd = tokenEnd + 1
        let seq = strings.SliceBytes(sequenceStream, offset, tokenEnd - offset)
        let n = strings.Len(seq)
        if n == 0:
            return RustCsgTuiSessionRootTerminalPickerError("unsupported root terminal picker sequence")
        if n == 1:
            let code = Int32(seq[0])
            if code == 10 || code == 13:
                let selection = picker.RustCsgTuiSessionPickerSelectFromStateDb(dbPath,
                                                                                 config.action,
                                                                                 currentSelected,
                                                                                 currentQuery,
                                                                                 config.cwdFilter,
                                                                                 config.sortKey,
                                                                                 config.limit)
                return RustCsgTuiSessionRootTerminalPickerSelectionFrame(selection, frameCount)
            if code == 27:
                return RustCsgTuiSessionRootTerminalPickerDoneFrame("start_fresh", frameCount)
            if code == 3:
                return RustCsgTuiSessionRootTerminalPickerDoneFrame("exit", frameCount)
            if code == 4:
                # Ctrl-D is handled by the outer TUI, not by the resume picker.
                currentSelected = currentSelected
            elif code == 127:
                let nextQuery = RustCsgTuiSessionRootTerminalPickerPopAscii(currentQuery)
                if nextQuery != currentQuery:
                    currentQuery = nextQuery
                    currentSelected = 0
                    frameCount = frameCount + 1
            elif code >= 32 && code <= 126:
                currentQuery = strings.ConcatStr(currentQuery, strings.SliceBytes(seq, 0, 1))
                currentSelected = 0
                frameCount = frameCount + 1
            else:
                return RustCsgTuiSessionRootTerminalPickerError("unsupported root terminal picker sequence")
        elif n == 3 && Int32(seq[0]) == 27 && Int32(seq[1]) == 91:
            let csi = Int32(seq[2])
            if csi == 65:
                let target = currentSelected - 1
                if RustCsgTuiSessionRootTerminalCanMoveTo(dbPath, config, target, currentQuery):
                    currentSelected = target
                    frameCount = frameCount + 1
            elif csi == 66:
                let target = currentSelected + 1
                if RustCsgTuiSessionRootTerminalCanMoveTo(dbPath, config, target, currentQuery):
                    currentSelected = target
                    frameCount = frameCount + 1
            elif csi == 67 || csi == 68 || csi == 90:
                # Rust resume picker ignores Left/Right/BackTab in this mode.
            else:
                return RustCsgTuiSessionRootTerminalPickerError("unsupported root terminal picker sequence")
        else:
            return RustCsgTuiSessionRootTerminalPickerError("unsupported root terminal picker sequence")

        if tokenEnd >= streamLen:
            offset = streamLen
        else:
            offset = tokenEnd + 1
    return RustCsgTuiSessionRootTerminalPickerNone(frameCount)

fn RustCsgTuiSessionRootTerminalFlowJsonForRoot(result: var root_flow.RustCsgTuiSessionRootFlowResult): str =
    return root_flow.RustCsgTuiSessionRootFlowResultToJson(result)

fn RustCsgTuiSessionRootTerminalFlowDone(outcome: str,
                                         pickerResult: var RustCsgTuiSessionRootTerminalPickerResult,
                                         cwdResult: var cwd_prompt.RustCsgTuiSessionCwdPromptRunResult,
                                         rootResult: var root_flow.RustCsgTuiSessionRootFlowResult): RustCsgTuiSessionRootTerminalFlowResult =
    var result: RustCsgTuiSessionRootTerminalFlowResult
    result.ok = true
    result.outcome = outcome
    result.pickerSelectionKind = pickerResult.selectionKind
    result.pickerThreadId = pickerResult.threadId
    result.pickerPath = pickerResult.path
    result.pickerDisplayLabel = pickerResult.displayLabel
    result.pickerScreen = pickerResult.screen
    result.pickerFrameCount = pickerResult.frameCount
    result.cwdPromptOutcome = cwdResult.outcome
    result.cwdPromptSelection = cwdResult.selection
    result.cwdPromptScreen = cwdResult.screen
    result.cwdPromptFrameCount = cwdResult.frameCount
    result.rootOutcome = rootResult.outcome
    if rootResult.outcome != "":
        result.rootJson = RustCsgTuiSessionRootTerminalFlowJsonForRoot(rootResult)
    result.appFirstFrameText = rootResult.appFirstFrameText
    return result

fn RustCsgTuiSessionRootTerminalFlowResultToJson(result: var RustCsgTuiSessionRootTerminalFlowResult): str =
    if !result.ok:
        return wire.RustCsgCat(wire.RustCsgCat("{\"ok\":false,\"outcome\":\"error\",\"error\":", wire.RustCsgJsonQuote(result.error)), "}")
    var out = "{\"ok\":true,"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("outcome", result.outcome))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonNullableFieldStr("pickerSelectionKind", result.pickerSelectionKind))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonNullableFieldStr("pickerThreadId", result.pickerThreadId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("pickerFrameCount", result.pickerFrameCount))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonNullableFieldStr("cwdPromptOutcome", result.cwdPromptOutcome))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonNullableFieldStr("cwdPromptSelection", result.cwdPromptSelection))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonNullableFieldStr("rootOutcome", result.rootOutcome))
    if result.rootJson != "":
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("root", result.rootJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgTuiSessionRootTerminalFlowRunRoot(rootConfig: var root_flow.RustCsgTuiSessionRootFlowConfig,
                                            pickerResult: var RustCsgTuiSessionRootTerminalPickerResult): root_flow.RustCsgTuiSessionRootFlowResult =
    var selection = root_flow.RustCsgTuiSessionRootFlowMakeSelection(pickerResult.selectionKind,
                                                                      pickerResult.threadId,
                                                                      pickerResult.path,
                                                                      pickerResult.displayLabel,
                                                                      pickerResult.screen,
                                                                      pickerResult.frameCount)
    return root_flow.RustCsgTuiSessionRootFlowRunSelected(rootConfig, selection)

fn RustCsgTuiSessionRootTerminalFlowRun(rootConfig: var root_flow.RustCsgTuiSessionRootFlowConfig,
                                        pickerConfig: var RustCsgTuiSessionRootTerminalPickerConfig,
                                        pickerSequenceStream: str,
                                        cwdPromptSequenceStream: str): RustCsgTuiSessionRootTerminalFlowResult =
    let dbPath = rootConfig.handoffContext.dbPath
    if dbPath == "":
        return RustCsgTuiSessionRootTerminalFlowError("session root terminal flow requires state db path")
    let pickerResult = RustCsgTuiSessionRootTerminalRunPickerStrict(dbPath,
                                                                    pickerConfig,
                                                                    pickerSequenceStream)
    if pickerResult.okI != 1:
        return RustCsgTuiSessionRootTerminalFlowError(pickerResult.error)

    var emptyCwd: cwd_prompt.RustCsgTuiSessionCwdPromptRunResult
    var emptyRoot: root_flow.RustCsgTuiSessionRootFlowResult
    if pickerResult.selectionKind == "none":
        return RustCsgTuiSessionRootTerminalFlowDone("picker_idle", pickerResult, emptyCwd, emptyRoot)
    if pickerResult.selectionKind == "exit":
        return RustCsgTuiSessionRootTerminalFlowDone("exit", pickerResult, emptyCwd, emptyRoot)
    if pickerResult.selectionKind != "resume" && pickerResult.selectionKind != "fork" && pickerResult.selectionKind != "start_fresh":
        return RustCsgTuiSessionRootTerminalFlowError(wire.RustCsgCat("unsupported picker selection: ", pickerResult.selectionKind))

    var rootResult = RustCsgTuiSessionRootTerminalFlowRunRoot(rootConfig, pickerResult)
    if !rootResult.ok:
        return RustCsgTuiSessionRootTerminalFlowError(rootResult.error)
    if rootResult.outcome != "prompt_required":
        return RustCsgTuiSessionRootTerminalFlowDone(rootResult.outcome, pickerResult, emptyCwd, rootResult)

    if cwdPromptSequenceStream == "":
        return RustCsgTuiSessionRootTerminalFlowError("cwd prompt sequence required after prompt_required")
    if rootResult.historyCwd == "":
        return RustCsgTuiSessionRootTerminalFlowError("prompt_required result missing history cwd")
    let cwdResult = cwd_prompt.RustCsgTuiSessionCwdPromptRunTerminalSequences(pickerResult.selectionKind,
                                                                              rootConfig.handoffContext.currentCwd,
                                                                              rootResult.historyCwd,
                                                                              pickerConfig.cwdPromptWidth,
                                                                              cwdPromptSequenceStream)
    if !cwdResult.ok:
        return RustCsgTuiSessionRootTerminalFlowError(cwdResult.error)
    if cwdResult.outcome == "exit":
        return RustCsgTuiSessionRootTerminalFlowDone("exit", pickerResult, cwdResult, rootResult)
    if cwdResult.outcome != "selection":
        return RustCsgTuiSessionRootTerminalFlowError(wire.RustCsgCat("unsupported cwd prompt outcome: ", cwdResult.outcome))

    rootConfig.handoffContext.promptChoice = cwdResult.selection
    rootResult = RustCsgTuiSessionRootTerminalFlowRunRoot(rootConfig, pickerResult)
    if !rootResult.ok:
        return RustCsgTuiSessionRootTerminalFlowError(rootResult.error)
    return RustCsgTuiSessionRootTerminalFlowDone(rootResult.outcome, pickerResult, cwdResult, rootResult)
