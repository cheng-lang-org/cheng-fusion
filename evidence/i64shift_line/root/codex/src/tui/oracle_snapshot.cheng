# TUI insta snapshot parser.
#
# This keeps the oracle bytes intact. It only separates the insta header from
# the rendered body so later parity tests can compare Cheng output byte-for-byte.

import std/strings
import std/strutils as strutil

@abi_internal
@importc("ReadFile")
fn RustCsgTuiOracleSnapshotReadFile(path: str): str

type
    RustCsgTuiOracleSnapshot =
        ok: bool
        path: str
        source: str
        expression: str
        body: str
        bodyByteLen: int32
        bodyLineCount: int32
        error: str

fn RustCsgTuiOracleSnapshotFail(path: str, message: str): RustCsgTuiOracleSnapshot =
    var out: RustCsgTuiOracleSnapshot
    out.ok = false
    out.path = path
    out.error = message
    return out

fn RustCsgTuiOracleSnapshotFindLineEnd(text: str, start: int32): int32 =
    let n: int32 = strings.Len(text)
    var i: int32 = start
    while i < n:
        if text[i] == '\n':
            return i
        i = i + 1
    return n

fn RustCsgTuiOracleSnapshotLineIsDivider(text: str, start: int32, stop: int32): bool =
    if stop - start < 3:
        return false
    if text[start] != '-' || text[start + 1] != '-' || text[start + 2] != '-':
        return false
    var i: int32 = start + 3
    while i < stop:
        if text[i] != ' ' && text[i] != '\r':
            return false
        i = i + 1
    return true

fn RustCsgTuiOracleSnapshotLineHasPrefix(text: str, start: int32, stop: int32, prefix: str): bool =
    let m: int32 = strings.Len(prefix)
    if stop - start < m:
        return false
    return strings.SliceBytes(text, start, m) == prefix

fn RustCsgTuiOracleSnapshotLineValue(text: str, start: int32, stop: int32, prefix: str): str =
    let m: int32 = strings.Len(prefix)
    return strings.SliceBytes(text, start + m, stop - start - m)

fn RustCsgTuiOracleSnapshotLineCount(text: str): int32 =
    let n: int32 = strings.Len(text)
    if n == 0:
        return 0
    var count: int32 = 0
    var i: int32 = 0
    while i < n:
        if text[i] == '\n':
            count = count + 1
        i = i + 1
    if text[n - 1] != '\n':
        count = count + 1
    return count

fn RustCsgTuiOracleSnapshotParse(text: str, path: str): RustCsgTuiOracleSnapshot =
    let n: int32 = strings.Len(text)
    if n == 0:
        return RustCsgTuiOracleSnapshotFail(path, "snapshot file is empty")

    let firstEnd: int32 = RustCsgTuiOracleSnapshotFindLineEnd(text, 0)
    if !RustCsgTuiOracleSnapshotLineIsDivider(text, 0, firstEnd):
        return RustCsgTuiOracleSnapshotFail(path, "snapshot first line is not an insta divider")
    if firstEnd >= n:
        return RustCsgTuiOracleSnapshotFail(path, "snapshot has no header")

    var source: str = ""
    var expression: str = ""
    var pos: int32 = firstEnd + 1
    while pos <= n:
        let lineEnd: int32 = RustCsgTuiOracleSnapshotFindLineEnd(text, pos)
        if RustCsgTuiOracleSnapshotLineIsDivider(text, pos, lineEnd):
            let bodyStart: int32 = lineEnd + 1
            if bodyStart > n:
                return RustCsgTuiOracleSnapshotFail(path, "snapshot body is missing")
            let body: str = strings.SliceBytes(text, bodyStart, n - bodyStart)
            if strings.Len(body) == 0:
                return RustCsgTuiOracleSnapshotFail(path, "snapshot body is empty")
            if strings.Len(source) == 0:
                return RustCsgTuiOracleSnapshotFail(path, "snapshot header missing source")
            if strings.Len(expression) == 0:
                return RustCsgTuiOracleSnapshotFail(path, "snapshot header missing expression")

            var out: RustCsgTuiOracleSnapshot
            out.ok = true
            out.path = path
            out.source = source
            out.expression = expression
            out.body = body
            out.bodyByteLen = strings.Len(body)
            out.bodyLineCount = RustCsgTuiOracleSnapshotLineCount(body)
            return out

        if RustCsgTuiOracleSnapshotLineHasPrefix(text, pos, lineEnd, "source: "):
            source = RustCsgTuiOracleSnapshotLineValue(text, pos, lineEnd, "source: ")
        elif RustCsgTuiOracleSnapshotLineHasPrefix(text, pos, lineEnd, "expression: "):
            expression = RustCsgTuiOracleSnapshotLineValue(text, pos, lineEnd, "expression: ")

        if lineEnd >= n:
            break
        pos = lineEnd + 1

    return RustCsgTuiOracleSnapshotFail(path, "snapshot second insta divider missing")

fn RustCsgTuiOracleSnapshotParseFile(path: str): RustCsgTuiOracleSnapshot =
    let text: str = RustCsgTuiOracleSnapshotReadFile(path)
    if strings.Len(text) == 0:
        return RustCsgTuiOracleSnapshotFail(path, strutil.Join(["snapshot file unreadable or empty: ", path], ""))
    return RustCsgTuiOracleSnapshotParse(text, path)
