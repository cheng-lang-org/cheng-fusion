# TUI welcome animation frame assets.
#
# Rust uses include_str! for these frames. This loader keeps the same observable
# text bytes and fails closed on unknown group or frame number.

import std/strings
import std/strutils as strutil

@abi_internal
@importc("ReadFile")
fn RustCsgTuiFramesReadFile(path: str): str

@abi_internal
@importc("RustCsgPathMetadataKind")
fn RustCsgTuiFramesPathMetadataKind(path: str): int32

type
    RustCsgTuiFrame =
        ok: bool
        group: str
        frameNo: int32
        body: str
        error: str

fn RustCsgTuiFramesStripTrailingSlash(path: str): str =
    let n: int32 = strings.Len(path)
    if n > 1 && strings.HasSuffix(path, "/"):
        return strings.SliceBytes(path, 0, n - 1)
    return path

fn RustCsgTuiFramesGroupAt(index: int32): str =
    if index == 0:
        return "blocks"
    if index == 1:
        return "codex"
    if index == 2:
        return "default"
    if index == 3:
        return "dots"
    if index == 4:
        return "hash"
    if index == 5:
        return "hbars"
    if index == 6:
        return "openai"
    if index == 7:
        return "shapes"
    if index == 8:
        return "slug"
    if index == 9:
        return "vbars"
    return ""

fn RustCsgTuiFramesGroupCount(): int32 =
    return 10

fn RustCsgTuiFramesPerGroup(): int32 =
    return 36

fn RustCsgTuiFramesKnownGroup(group: str): bool =
    var i: int32 = 0
    while i < RustCsgTuiFramesGroupCount():
        if RustCsgTuiFramesGroupAt(i) == group:
            return true
        i = i + 1
    return false

fn RustCsgTuiFramesPath(sourceRootRaw: str, group: str, frameNo: int32): str =
    return strutil.Join([RustCsgTuiFramesStripTrailingSlash(sourceRootRaw),
                         "/codex-rs/tui/frames/",
                         group,
                         "/frame_",
                         strings.IntToStr(frameNo),
                         ".txt"], "")

fn RustCsgTuiFrameFail(group: str, frameNo: int32, message: str): RustCsgTuiFrame =
    var out: RustCsgTuiFrame
    out.ok = false
    out.group = group
    out.frameNo = frameNo
    out.error = message
    return out

fn RustCsgTuiFrameLoad(sourceRoot: str, group: str, frameNo: int32): RustCsgTuiFrame =
    if strings.Len(sourceRoot) == 0:
        return RustCsgTuiFrameFail(group, frameNo, "source root is empty")
    if !RustCsgTuiFramesKnownGroup(group):
        return RustCsgTuiFrameFail(group, frameNo, strutil.Join(["unknown frame group: ", group], ""))
    if frameNo < 1 || frameNo > RustCsgTuiFramesPerGroup():
        return RustCsgTuiFrameFail(group, frameNo, "frame number out of range")

    let path: str = RustCsgTuiFramesPath(sourceRoot, group, frameNo)
    if RustCsgTuiFramesPathMetadataKind(path) != 2:
        return RustCsgTuiFrameFail(group, frameNo, strutil.Join(["frame file missing: ", path], ""))
    let body: str = RustCsgTuiFramesReadFile(path)
    if strings.Len(body) == 0:
        return RustCsgTuiFrameFail(group, frameNo, strutil.Join(["frame file unreadable or empty: ", path], ""))

    var out: RustCsgTuiFrame
    out.ok = true
    out.group = group
    out.frameNo = frameNo
    out.body = body
    return out
