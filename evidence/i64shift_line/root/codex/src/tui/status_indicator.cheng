# TUI status indicator renderer.
#
# This models the Rust StatusIndicatorWidget snapshots from
# codex-rs/tui/src/status_indicator_widget.rs. The public helpers return the
# same TestBackend text body shape used by insta: quoted, padded terminal rows.

import std/strings

fn RustCsgTuiStatusIndicatorSpaces(count: int32): str =
    var out: str = ""
    var i: int32 = 0
    while i < count:
        out = strings.ConcatStr(out, " ")
        i = i + 1
    return out

fn RustCsgTuiStatusIndicatorStartsWithAt(text: str, index: int32, prefix: str): bool =
    let prefixLen: int32 = strings.Len(prefix)
    if index < 0:
        return false
    if index + prefixLen > strings.Len(text):
        return false
    return strings.SliceBytes(text, index, prefixLen) == prefix

fn RustCsgTuiStatusIndicatorNextGlyph(text: str, index: int32): str =
    if RustCsgTuiStatusIndicatorStartsWithAt(text, index, "•"):
        return "•"
    if RustCsgTuiStatusIndicatorStartsWithAt(text, index, "↳"):
        return "↳"
    if RustCsgTuiStatusIndicatorStartsWithAt(text, index, "↑"):
        return "↑"
    if RustCsgTuiStatusIndicatorStartsWithAt(text, index, "⌥"):
        return "⌥"
    if RustCsgTuiStatusIndicatorStartsWithAt(text, index, "└"):
        return "└"
    if RustCsgTuiStatusIndicatorStartsWithAt(text, index, "…"):
        return "…"
    return strings.SliceBytes(text, index, 1)

fn RustCsgTuiStatusIndicatorDisplayWidth(text: str): int32 =
    var width: int32 = 0
    var i: int32 = 0
    let n: int32 = strings.Len(text)
    while i < n:
        let glyph: str = RustCsgTuiStatusIndicatorNextGlyph(text, i)
        width = width + 1
        i = i + strings.Len(glyph)
    return width

fn RustCsgTuiStatusIndicatorTruncate(text: str, width: int32): str =
    if width <= 0:
        return ""
    if RustCsgTuiStatusIndicatorDisplayWidth(text) <= width:
        return text
    if width == 1:
        return "…"
    let limit: int32 = width - 1
    var out: str = ""
    var used: int32 = 0
    var i: int32 = 0
    let n: int32 = strings.Len(text)
    while i < n:
        let glyph: str = RustCsgTuiStatusIndicatorNextGlyph(text, i)
        if used + 1 > limit:
            break
        out = strings.ConcatStr(out, glyph)
        used = used + 1
        i = i + strings.Len(glyph)
    return strings.ConcatStr(out, "…")

fn RustCsgTuiStatusIndicatorPad(text: str, width: int32): str =
    var line: str = RustCsgTuiStatusIndicatorTruncate(text, width)
    let displayWidth: int32 = RustCsgTuiStatusIndicatorDisplayWidth(line)
    if displayWidth < width:
        line = strings.ConcatStr(line, RustCsgTuiStatusIndicatorSpaces(width - displayWidth))
    return line

fn RustCsgTuiStatusIndicatorQuoteLine(text: str, width: int32): str =
    return strings.ConcatStr(strings.ConcatStr("\"", RustCsgTuiStatusIndicatorPad(text, width)), "\"")

fn RustCsgTuiStatusIndicatorElapsedCompact(elapsedSeconds: int32): str =
    if elapsedSeconds < 60:
        return strings.ConcatStr(strings.IntToStr(elapsedSeconds), "s")
    if elapsedSeconds < 3600:
        let minutes: int32 = elapsedSeconds / 60
        let seconds: int32 = elapsedSeconds % 60
        var secText: str = strings.IntToStr(seconds)
        if seconds < 10:
            secText = strings.ConcatStr("0", secText)
        return strings.ConcatStr(strings.ConcatStr(strings.IntToStr(minutes), "m "), strings.ConcatStr(secText, "s"))
    let hours: int32 = elapsedSeconds / 3600
    let minutes2: int32 = (elapsedSeconds % 3600) / 60
    let seconds2: int32 = elapsedSeconds % 60
    var minText: str = strings.IntToStr(minutes2)
    var secText2: str = strings.IntToStr(seconds2)
    if minutes2 < 10:
        minText = strings.ConcatStr("0", minText)
    if seconds2 < 10:
        secText2 = strings.ConcatStr("0", secText2)
    return strings.ConcatStr(strings.ConcatStr(strings.ConcatStr(strings.IntToStr(hours), "h "), strings.ConcatStr(minText, "m ")), strings.ConcatStr(secText2, "s"))

fn RustCsgTuiStatusIndicatorHeaderLine(header: str,
                                       elapsedSeconds: int32,
                                       animationsEnabled: bool,
                                       showInterruptHint: bool): str =
    var out: str = ""
    if animationsEnabled:
        out = "• "
    out = strings.ConcatStr(out, header)
    out = strings.ConcatStr(out, " ")
    if showInterruptHint:
        out = strings.ConcatStr(out, "(")
        out = strings.ConcatStr(out, RustCsgTuiStatusIndicatorElapsedCompact(elapsedSeconds))
        out = strings.ConcatStr(out, " • esc to interrupt)")
    else:
        out = strings.ConcatStr(out, "(")
        out = strings.ConcatStr(out, RustCsgTuiStatusIndicatorElapsedCompact(elapsedSeconds))
        out = strings.ConcatStr(out, ")")
    return out

fn RustCsgTuiStatusIndicatorWords(text: str): str[] =
    var words: str[]
    var current: str = ""
    var i: int32 = 0
    let n: int32 = strings.Len(text)
    while i < n:
        let glyph: str = RustCsgTuiStatusIndicatorNextGlyph(text, i)
        if glyph == " ":
            if strings.Len(current) > 0:
                add(words, current)
                current = ""
        else:
            current = strings.ConcatStr(current, glyph)
        i = i + strings.Len(glyph)
    if strings.Len(current) > 0:
        add(words, current)
    return words

fn RustCsgTuiStatusIndicatorWrapWords(text: str, width: int32): str[] =
    var lines: str[]
    if width <= 0:
        add(lines, text)
        return lines
    let words: str[] = RustCsgTuiStatusIndicatorWords(text)
    var line: str = ""
    var i: int32 = 0
    while i < words.len:
        let word: str = words[i]
        if strings.Len(line) == 0:
            line = word
        else:
            let candidate: str = strings.ConcatStr(strings.ConcatStr(line, " "), word)
            if RustCsgTuiStatusIndicatorDisplayWidth(candidate) <= width:
                line = candidate
            else:
                add(lines, line)
                line = word
        i = i + 1
    if strings.Len(line) > 0:
        add(lines, line)
    return lines

fn RustCsgTuiStatusIndicatorRenderRows(width: int32,
                                       height: int32,
                                       header: str,
                                       elapsedSeconds: int32,
                                       animationsEnabled: bool,
                                       showInterruptHint: bool,
                                       details: str,
                                       queuedFirst: str,
                                       queuedSecond: str,
                                       useMacAlt: bool): str =
    if width <= 0 || height <= 0:
        assert(false, "status indicator dimensions must be positive")
    var rows: str[]
    add(rows, RustCsgTuiStatusIndicatorHeaderLine(header, elapsedSeconds, animationsEnabled, showInterruptHint))

    if strings.Len(details) > 0 && height > 1:
        let contentWidth: int32 = width - 4
        let wrapped: str[] = RustCsgTuiStatusIndicatorWrapWords(details, contentWidth)
        var i: int32 = 0
        while i < wrapped.len && rows.len < height:
            var prefix: str = "    "
            if i == 0:
                prefix = "  └ "
            add(rows, strings.ConcatStr(prefix, wrapped[i]))
            i = i + 1
    elif strings.Len(queuedFirst) > 0 && height > 1:
        add(rows, "")
        if rows.len < height:
            add(rows, strings.ConcatStr(" ↳ ", queuedFirst))
        if rows.len < height:
            add(rows, strings.ConcatStr(" ↳ ", queuedSecond))
        if rows.len < height:
            var keyLine: str = "   alt + ↑ edit"
            if useMacAlt:
                keyLine = "   ⌥ + ↑ edit"
            add(rows, keyLine)

    var out: str = ""
    var row: int32 = 0
    while row < height:
        var line: str = ""
        if row < rows.len:
            line = rows[row]
        out = strings.ConcatStr(out, RustCsgTuiStatusIndicatorQuoteLine(line, width))
        out = strings.ConcatStr(out, "\n")
        row = row + 1
    return out

fn RustCsgTuiStatusIndicatorRenderWorkingHeaderSnapshot(): str =
    return RustCsgTuiStatusIndicatorRenderRows(80, 2, "Working", 0, true, true, "", "", "", false)

fn RustCsgTuiStatusIndicatorRenderTruncatedSnapshot(): str =
    return RustCsgTuiStatusIndicatorRenderRows(20, 2, "Working", 0, true, true, "", "", "", false)

fn RustCsgTuiStatusIndicatorRenderQueuedMessagesSnapshot(): str =
    return RustCsgTuiStatusIndicatorRenderRows(80, 8, "Working", 0, true, true, "", "first", "second", false)

fn RustCsgTuiStatusIndicatorRenderQueuedMessagesMacOsSnapshot(): str =
    return RustCsgTuiStatusIndicatorRenderRows(80, 8, "Working", 0, true, true, "", "first", "second", true)

fn RustCsgTuiStatusIndicatorRenderWrappedDetailsSnapshot(): str =
    return RustCsgTuiStatusIndicatorRenderRows(30, 3, "Working", 0, true, false, "A man a plan a canal panama", "", "", false)
