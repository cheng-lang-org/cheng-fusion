# TUI bottom_pane/feedback_view raw render oracle.

import std/strings
import std/strutils as strutil

fn RustCsgTuiFeedbackTitle(category: str): str =
    if category == "bad_result":
        return "Tell us more (bad result)"
    if category == "good_result":
        return "Tell us more (good result)"
    if category == "bug":
        return "Tell us more (bug)"
    if category == "safety_check":
        return "Tell us more (safety check)"
    if category == "other":
        return "Tell us more (other)"
    assert(false, strutil.Join(["unknown feedback category: ", category], ""))
    return ""

fn RustCsgTuiFeedbackPlaceholder(category: str): str =
    if category == "safety_check":
        return "(optional) Share what was refused and why it should have b"
    return "(optional) Write a short description to help us further"

fn RustCsgTuiFeedbackNoteSnapshot(category: str): str =
    return strutil.Join([
        strutil.Join(["▌ ", RustCsgTuiFeedbackTitle(category)], ""),
        "▌",
        strutil.Join(["▌ ", RustCsgTuiFeedbackPlaceholder(category)], ""),
        "",
        "Press enter to confirm or esc to go back",
        "",
    ], "\n")

fn RustCsgTuiFeedbackBadResultSnapshot(): str =
    return RustCsgTuiFeedbackNoteSnapshot("bad_result")

fn RustCsgTuiFeedbackBugSnapshot(): str =
    return RustCsgTuiFeedbackNoteSnapshot("bug")

fn RustCsgTuiFeedbackGoodResultSnapshot(): str =
    return RustCsgTuiFeedbackNoteSnapshot("good_result")

fn RustCsgTuiFeedbackOtherSnapshot(): str =
    return RustCsgTuiFeedbackNoteSnapshot("other")

fn RustCsgTuiFeedbackSafetyCheckSnapshot(): str =
    return RustCsgTuiFeedbackNoteSnapshot("safety_check")

fn RustCsgTuiFeedbackWithConnectivityDiagnosticsSnapshot(): str =
    return RustCsgTuiFeedbackNoteSnapshot("bug")

fn RustCsgTuiFeedbackUploadConsentHeaderSnapshot(): str =
    return strutil.Join([
        "Upload logs?",
        "",
        "The following files will be sent:",
        "  • codex-logs.log",
        "  • codex-doctor-report.json",
        "  • rollout.jsonl",
        "  • auto-review-rollout.jsonl",
        "",
    ], "\n")

fn RustCsgTuiFeedbackLegacyUploadPromptSnapshot(): str =
    return strutil.Join([
        "  Do you want to upload logs before reporting issue?",
        "",
        "  Logs may include the full conversation history of this Codex process",
        "  These logs are retained for 90 days and are used solely for troubles",
        "",
        "  You can review the exact content of the logs before they’re uploaded",
        "  <LOG_PATH>",
        "",
        "",
        "› 1. Yes     Share the current Codex session logs with the team for",
        "             troubleshooting.",
        "  2. No",
        "  3. Cancel",
        "",
    ], "\n")
