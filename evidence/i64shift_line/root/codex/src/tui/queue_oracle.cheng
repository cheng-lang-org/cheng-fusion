# TUI bottom_pane message queue Buffer Debug oracle renderer.

import std/strings
import std/strutils as strutil

fn RustCsgTuiQueueSpaces(count: int32): str =
    var out: str = ""
    var i: int32 = 0
    while i < count:
        out = strings.ConcatStr(out, " ")
        i = i + 1
    return out

fn RustCsgTuiQueueStartsWithAt(text: str, index: int32, prefix: str): bool =
    let prefixLen: int32 = strings.Len(prefix)
    if index < 0:
        return false
    if index + prefixLen > strings.Len(text):
        return false
    return strings.SliceBytes(text, index, prefixLen) == prefix

fn RustCsgTuiQueueNextGlyph(text: str, index: int32): str =
    if RustCsgTuiQueueStartsWithAt(text, index, "•"):
        return "•"
    if RustCsgTuiQueueStartsWithAt(text, index, "↳"):
        return "↳"
    if RustCsgTuiQueueStartsWithAt(text, index, "↑"):
        return "↑"
    if RustCsgTuiQueueStartsWithAt(text, index, "←"):
        return "←"
    if RustCsgTuiQueueStartsWithAt(text, index, "⌥"):
        return "⌥"
    if RustCsgTuiQueueStartsWithAt(text, index, "…"):
        return "…"
    return strings.SliceBytes(text, index, 1)

fn RustCsgTuiQueueDisplayWidth(text: str): int32 =
    var width: int32 = 0
    var i: int32 = 0
    while i < strings.Len(text):
        let glyph: str = RustCsgTuiQueueNextGlyph(text, i)
        width = width + 1
        i = i + strings.Len(glyph)
    return width

fn RustCsgTuiQueuePadDisplay(text: str, width: int32): str =
    let currentWidth: int32 = RustCsgTuiQueueDisplayWidth(text)
    if currentWidth > width:
        assert(false, "queue oracle line exceeds width")
    return strings.ConcatStr(text, RustCsgTuiQueueSpaces(width - currentWidth))

fn RustCsgTuiQueueStyle(x: int32, y: int32, modifier: str): str =
    return strutil.Join([
        "        x: ",
        strings.IntToStr(x),
        ", y: ",
        strings.IntToStr(y),
        ", fg: Reset, bg: Reset, underline: Reset, modifier: ",
        modifier
    ], "")

fn RustCsgTuiQueueBufferDebug(width: int32, height: int32, contentLines: str[], styleLines: str[]): str =
    var out: str = "Buffer {\n"
    out = strings.ConcatStr(out, strutil.Join(["    area: Rect { x: 0, y: 0, width: ", strings.IntToStr(width), ", height: ", strings.IntToStr(height), " },\n"], ""))
    out = strings.ConcatStr(out, "    content: [\n")
    var i: int32 = 0
    while i < contentLines.len:
        out = strings.ConcatStr(out, strutil.Join(["        \"", RustCsgTuiQueuePadDisplay(contentLines[i], width), "\",\n"], ""))
        i = i + 1
    out = strings.ConcatStr(out, "    ],\n")
    out = strings.ConcatStr(out, "    styles: [\n")
    i = 0
    while i < styleLines.len:
        out = strings.ConcatStr(out, styleLines[i])
        out = strings.ConcatStr(out, ",\n")
        i = i + 1
    out = strings.ConcatStr(out, "    ]\n")
    out = strings.ConcatStr(out, "}\n")
    return out

fn RustCsgTuiMessageQueueOneSnapshot(): str =
    return RustCsgTuiQueueBufferDebug(40, 2, [
        "  ↳ Hello, world!",
        "    alt + ↑ edit"
    ], [
        RustCsgTuiQueueStyle(0, 0, "DIM"),
        RustCsgTuiQueueStyle(4, 0, "DIM | ITALIC"),
        RustCsgTuiQueueStyle(17, 0, "NONE"),
        RustCsgTuiQueueStyle(0, 1, "DIM"),
        RustCsgTuiQueueStyle(16, 1, "NONE")
    ])

fn RustCsgTuiMessageQueueTwoSnapshot(): str =
    return RustCsgTuiQueueBufferDebug(40, 3, [
        "  ↳ Hello, world!",
        "  ↳ This is another message",
        "    alt + ↑ edit"
    ], [
        RustCsgTuiQueueStyle(0, 0, "DIM"),
        RustCsgTuiQueueStyle(4, 0, "DIM | ITALIC"),
        RustCsgTuiQueueStyle(17, 0, "NONE"),
        RustCsgTuiQueueStyle(0, 1, "DIM"),
        RustCsgTuiQueueStyle(4, 1, "DIM | ITALIC"),
        RustCsgTuiQueueStyle(27, 1, "NONE"),
        RustCsgTuiQueueStyle(0, 2, "DIM"),
        RustCsgTuiQueueStyle(16, 2, "NONE")
    ])

fn RustCsgTuiMessageQueueWrappedSnapshot(): str =
    return RustCsgTuiQueueBufferDebug(40, 4, [
        "  ↳ This is a longer message that should",
        "    be wrapped",
        "  ↳ This is another message",
        "    alt + ↑ edit"
    ], [
        RustCsgTuiQueueStyle(0, 0, "DIM"),
        RustCsgTuiQueueStyle(4, 0, "DIM | ITALIC"),
        RustCsgTuiQueueStyle(0, 1, "NONE"),
        RustCsgTuiQueueStyle(4, 1, "DIM | ITALIC"),
        RustCsgTuiQueueStyle(14, 1, "NONE"),
        RustCsgTuiQueueStyle(0, 2, "DIM"),
        RustCsgTuiQueueStyle(4, 2, "DIM | ITALIC"),
        RustCsgTuiQueueStyle(27, 2, "NONE"),
        RustCsgTuiQueueStyle(0, 3, "DIM"),
        RustCsgTuiQueueStyle(16, 3, "NONE")
    ])

fn RustCsgTuiMessageQueueManyLineSnapshot(): str =
    return RustCsgTuiQueueBufferDebug(40, 5, [
        "  ↳ This is",
        "    a message",
        "    with many",
        "    …",
        "    alt + ↑ edit"
    ], [
        RustCsgTuiQueueStyle(0, 0, "DIM"),
        RustCsgTuiQueueStyle(4, 0, "DIM | ITALIC"),
        RustCsgTuiQueueStyle(11, 0, "NONE"),
        RustCsgTuiQueueStyle(4, 1, "DIM | ITALIC"),
        RustCsgTuiQueueStyle(13, 1, "NONE"),
        RustCsgTuiQueueStyle(4, 2, "DIM | ITALIC"),
        RustCsgTuiQueueStyle(13, 2, "NONE"),
        RustCsgTuiQueueStyle(0, 3, "DIM | ITALIC"),
        RustCsgTuiQueueStyle(5, 3, "NONE"),
        RustCsgTuiQueueStyle(0, 4, "DIM"),
        RustCsgTuiQueueStyle(16, 4, "NONE")
    ])
