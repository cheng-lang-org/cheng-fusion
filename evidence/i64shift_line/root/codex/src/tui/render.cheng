# TUI rendering — buffered terminal output and ANSI escape helpers.
#
# Ported from codex-rs/tui/src/tui.rs and related rendering modules.
#
# TuiBuffer type:
#   - A 2D character grid with per-cell attributes (foreground, background, bold, dim, reverse).
#   - Render converts the buffer to ANSI escape sequences for terminal output.

import std/strings
import std/strutils as strutil

# ── Attribute constants ───────────────────────────────────────────────────────

const RustCsgTuiAttrNone: int32 = 0
const RustCsgTuiAttrBold: int32 = 1       # bit 0
const RustCsgTuiAttrDim: int32 = 2        # bit 1
const RustCsgTuiAttrItalic: int32 = 4     # bit 2
const RustCsgTuiAttrUnderline: int32 = 8  # bit 3
const RustCsgTuiAttrReverse: int32 = 16   # bit 4
const RustCsgTuiAttrStrikethrough: int32 = 32  # bit 5
const RustCsgTuiAttrBlink: int32 = 64     # bit 6
# ── Cell type ─────────────────────────────────────────────────────────────────

type
    RustCsgTuiCell =
        ch: str            # single character
        reverse: int32     # 1 = reverse video
        fgR: int32         # foreground red (-1 = default)
        fgG: int32
        fgB: int32
        bgR: int32         # background red (-1 = default)
        bgG: int32
        bgB: int32
        attr: int32        # attribute bitset

# ── TuiBuffer type ────────────────────────────────────────────────────────────

type
    RustCsgTuiBuffer =
        width: int32
        height: int32
        cells: RustCsgTuiCell[]

# ── TuiBuffer API ─────────────────────────────────────────────────────────────

# Create a new TuiBuffer with the given dimensions.
# Hard-fail on invalid dimensions (<= 0).
fn RustCsgTuiBufferInit(width: int32, height: int32): RustCsgTuiBuffer =
    if width <= 0 || height <= 0:
        assert(false, "TuiBufferInit: dimensions must be positive")
    var buf: RustCsgTuiBuffer
    buf.width = width
    buf.height = height
    buf.cells = RustCsgTuiCell[]
    let total: int32 = width * height
    var i: int32 = 0
    while i < total:
        var cell: RustCsgTuiCell
        cell.ch = " "
        cell.reverse = 0
        cell.fgR = -1
        cell.fgG = -1
        cell.fgB = -1
        cell.bgR = -1
        cell.bgG = -1
        cell.bgB = -1
        cell.attr = RustCsgTuiAttrNone
        add(buf.cells, cell)
        i = i + 1
    return buf

# Write text into the buffer at position (x, y).
# x and y are 0-based.
# Hard-fail on invalid coordinates.
fn RustCsgTuiBufferWrite(buf: var RustCsgTuiBuffer, x: int32, y: int32, text: str, fgR: int32, fgG: int32, fgB: int32, bgR: int32, bgG: int32, bgB: int32, attr: int32) =
    if x < 0 || y < 0 || x >= buf.width || y >= buf.height:
        assert(false, strutil.Join(["TuiBufferWrite: invalid coordinates (", strings.IntToStr(x), ",", strings.IntToStr(y), ")"], ""))
    let textLen: int32 = strings.Len(text)
    var col: int32 = x
    var i: int32 = 0
    while i < textLen && col < buf.width:
        let ch: str = strings.SliceBytes(text, i, 1)
        let idx: int32 = y * buf.width + col
        buf.cells[idx].ch = ch
        buf.cells[idx].reverse = 0
        if fgR >= 0:
            buf.cells[idx].fgR = fgR
            buf.cells[idx].fgG = fgG
            buf.cells[idx].fgB = fgB
        if bgR >= 0:
            buf.cells[idx].bgR = bgR
            buf.cells[idx].bgG = bgG
            buf.cells[idx].bgB = bgB
        if attr != RustCsgTuiAttrNone:
            buf.cells[idx].attr = attr
        col = col + 1
        i = i + 1

fn RustCsgTuiBufferWriteReverse(buf: var RustCsgTuiBuffer, x: int32, y: int32, text: str) =
    if x < 0 || y < 0 || x >= buf.width || y >= buf.height:
        assert(false, strutil.Join(["TuiBufferWriteReverse: invalid coordinates (", strings.IntToStr(x), ",", strings.IntToStr(y), ")"], ""))
    let textLen: int32 = strings.Len(text)
    var col: int32 = x
    var i: int32 = 0
    while i < textLen && col < buf.width:
        var ch: str = strings.SliceBytes(text, i, 1)
        if i == 0:
            ch = strutil.Join([RustCsgTuiSetReverse(true), ch], "")
        if i == textLen - 1 || col == buf.width - 1:
            ch = strutil.Join([ch, RustCsgTuiResetAttrs()], "")
        let idx: int32 = y * buf.width + col
        buf.cells[idx].ch = ch
        buf.cells[idx].reverse = 0
        buf.cells[idx].fgR = -1
        buf.cells[idx].fgG = -1
        buf.cells[idx].fgB = -1
        buf.cells[idx].bgR = -1
        buf.cells[idx].bgG = -1
        buf.cells[idx].bgB = -1
        buf.cells[idx].attr = RustCsgTuiAttrNone
        col = col + 1
        i = i + 1

# Clear the buffer to spaces with default attributes.
fn RustCsgTuiBufferClear(buf: var RustCsgTuiBuffer) =
    let total: int32 = buf.width * buf.height
    var i: int32 = 0
    while i < total:
        buf.cells[i].ch = " "
        buf.cells[i].reverse = 0
        buf.cells[i].fgR = -1
        buf.cells[i].fgG = -1
        buf.cells[i].fgB = -1
        buf.cells[i].bgR = -1
        buf.cells[i].bgG = -1
        buf.cells[i].bgB = -1
        buf.cells[i].attr = RustCsgTuiAttrNone
        i = i + 1

# Return the buffer width.
fn RustCsgTuiBufferWidth(buf: var RustCsgTuiBuffer): int32 =
    return buf.width

# Return the buffer height.
fn RustCsgTuiBufferHeight(buf: var RustCsgTuiBuffer): int32 =
    return buf.height

# ── ANSI escape helpers (string builders) ─────────────────────────────────────

# ESC character (0x1b = 27)
fn RustCsgTuiEsc(): str =
    return ""

# Cursor: move to (row, col) — 1-based (terminal convention).
# row=1, col=1 is top-left.
fn RustCsgTuiCursorMoveTo(row: int32, col: int32): str =
    return strutil.Join([RustCsgTuiEsc(), "[", strings.IntToStr(row), ";", strings.IntToStr(col), "H"], "")

# Cursor: hide.
fn RustCsgTuiCursorHide(): str =
    return strutil.Join([RustCsgTuiEsc(), "[?25l"], "")

# Cursor: show.
fn RustCsgTuiCursorShow(): str =
    return strutil.Join([RustCsgTuiEsc(), "[?25h"], "")

# Clear entire screen.
fn RustCsgTuiClearScreen(): str =
    return strutil.Join([RustCsgTuiEsc(), "[2J"], "")

# Clear from cursor to end of line.
fn RustCsgTuiClearToEndOfLine(): str =
    return strutil.Join([RustCsgTuiEsc(), "[K"], "")

# Set foreground color using 24-bit RGB.
fn RustCsgTuiSetForegroundColor(r: int32, g: int32, b: int32): str =
    return strutil.Join([RustCsgTuiEsc(), "[38;2;", strings.IntToStr(r), ";", strings.IntToStr(g), ";", strings.IntToStr(b), "m"], "")

# Set background color using 24-bit RGB.
fn RustCsgTuiSetBackgroundColor(r: int32, g: int32, b: int32): str =
    return strutil.Join([RustCsgTuiEsc(), "[48;2;", strings.IntToStr(r), ";", strings.IntToStr(g), ";", strings.IntToStr(b), "m"], "")

# Set bold attribute on (true) or off (false).
fn RustCsgTuiSetBold(on: bool): str =
    if on:
        return strutil.Join([RustCsgTuiEsc(), "[1m"], "")
    return strutil.Join([RustCsgTuiEsc(), "[22m"], "")

# Set dim attribute on (true) or off (false).
fn RustCsgTuiSetDim(on: bool): str =
    if on:
        return strutil.Join([RustCsgTuiEsc(), "[2m"], "")
    return strutil.Join([RustCsgTuiEsc(), "[22m"], "")

# Set reverse video attribute on (true) or off (false).
fn RustCsgTuiSetReverse(on: bool): str =
    if on:
        return strutil.Join([RustCsgTuiEsc(), "[7m"], "")
    return strutil.Join([RustCsgTuiEsc(), "[27m"], "")

# Set italic attribute on (true) or off (false).
fn RustCsgTuiSetItalic(on: bool): str =
    if on:
        return strutil.Join([RustCsgTuiEsc(), "[3m"], "")
    return strutil.Join([RustCsgTuiEsc(), "[23m"], "")

# Set underline attribute on (true) or off (false).
fn RustCsgTuiSetUnderline(on: bool): str =
    if on:
        return strutil.Join([RustCsgTuiEsc(), "[4m"], "")
    return strutil.Join([RustCsgTuiEsc(), "[24m"], "")

# Set strikethrough attribute on (true) or off (false).
fn RustCsgTuiSetStrikethrough(on: bool): str =
    if on:
        return strutil.Join([RustCsgTuiEsc(), "[9m"], "")
    return strutil.Join([RustCsgTuiEsc(), "[29m"], "")

# Set blink attribute on (true) or off (false).
fn RustCsgTuiSetBlink(on: bool): str =
    if on:
        return strutil.Join([RustCsgTuiEsc(), "[5m"], "")
    return strutil.Join([RustCsgTuiEsc(), "[25m"], "")

# Reset all SGR attributes to default.
fn RustCsgTuiResetAttrs(): str =
    return strutil.Join([RustCsgTuiEsc(), "[0m"], "")

# Reset foreground color to default.
fn RustCsgTuiResetForeground(): str =
    return strutil.Join([RustCsgTuiEsc(), "[39m"], "")

# Reset background color to default.
fn RustCsgTuiResetBackground(): str =
    return strutil.Join([RustCsgTuiEsc(), "[49m"], "")

fn RustCsgTuiAttrContains(attr: int32, flag: int32): int32 =
    if attr <= 0 || flag <= 0:
        return 0
    var remaining: int32 = attr
    let period: int32 = flag * 2
    while remaining >= period:
        remaining = remaining - period
    if remaining >= flag:
        return 1
    return 0

# ── Buffer render ─────────────────────────────────────────────────────────────

# Render the entire TuiBuffer to ANSI escape sequences.
# Walks the buffer row by row, emitting only the delta from the previous cell state
# to minimise output size (same-cell optimisation).
# Returns a str containing ANSI sequences that, when written to the terminal,
# produce the buffer contents.
fn RustCsgTuiBufferRender(buf: var RustCsgTuiBuffer): str =
    var output: str = ""
    output = strutil.Join([output, RustCsgTuiCursorHide()], "")

    var prevFgR: int32 = -1
    var prevFgG: int32 = -1
    var prevFgB: int32 = -1
    var prevBgR: int32 = -1
    var prevBgG: int32 = -1
    var prevBgB: int32 = -1
    var prevAttr: int32 = -1

    var row: int32 = 0
    while row < buf.height:
        output = strutil.Join([output, RustCsgTuiCursorMoveTo(row + 1, 1)], "")
        prevFgR = -2
        var col: int32 = 0
        while col < buf.width:
            let idx: int32 = row * buf.width + col
            let cell = buf.cells[idx]
            var effectiveAttr: int32 = cell.attr
            if cell.reverse != 0 || cell.fgR < -1:
                effectiveAttr = RustCsgTuiAttrReverse
            let cellIsReverse: bool = cell.reverse != 0 || cell.fgR < -1 || cell.attr == 16

            # Emit SGR codes if attributes changed
            if cell.fgR != prevFgR || cell.fgG != prevFgG || cell.fgB != prevFgB:
                if cell.fgR >= 0:
                    output = strutil.Join([output, RustCsgTuiSetForegroundColor(cell.fgR, cell.fgG, cell.fgB)], "")
                else:
                    output = strutil.Join([output, RustCsgTuiResetForeground()], "")
                prevFgR = cell.fgR
                prevFgG = cell.fgG
                prevFgB = cell.fgB

            if cell.bgR != prevBgR || cell.bgG != prevBgG || cell.bgB != prevBgB:
                if cell.bgR >= 0:
                    output = strutil.Join([output, RustCsgTuiSetBackgroundColor(cell.bgR, cell.bgG, cell.bgB)], "")
                else:
                    output = strutil.Join([output, RustCsgTuiResetBackground()], "")
                prevBgR = cell.bgR
                prevBgG = cell.bgG
                prevBgB = cell.bgB

            if cellIsReverse:
                if prevAttr != 16:
                    if prevAttr >= 0:
                        output = strutil.Join([output, RustCsgTuiResetAttrs()], "")
                    output = strutil.Join([output, RustCsgTuiEsc(), "[7m"], "")
                    prevAttr = 16
            elif effectiveAttr != prevAttr:
                if prevAttr >= 0 && effectiveAttr != prevAttr:
                    # Reset on attribute change, then re-apply
                    output = strutil.Join([output, RustCsgTuiResetAttrs()], "")
                    # Re-apply colors after reset
                    if cell.fgR >= 0:
                        output = strutil.Join([output, RustCsgTuiSetForegroundColor(cell.fgR, cell.fgG, cell.fgB)], "")
                    if cell.bgR >= 0:
                        output = strutil.Join([output, RustCsgTuiSetBackgroundColor(cell.bgR, cell.bgG, cell.bgB)], "")
                if effectiveAttr != RustCsgTuiAttrNone:
                    # Emit each attribute independently via bitmask test
                    if RustCsgTuiAttrContains(effectiveAttr, RustCsgTuiAttrBold) != 0:
                        output = strutil.Join([output, RustCsgTuiSetBold(true)], "")
                    if RustCsgTuiAttrContains(effectiveAttr, RustCsgTuiAttrDim) != 0:
                        output = strutil.Join([output, RustCsgTuiSetDim(true)], "")
                    if RustCsgTuiAttrContains(effectiveAttr, RustCsgTuiAttrItalic) != 0:
                        output = strutil.Join([output, RustCsgTuiSetItalic(true)], "")
                    if RustCsgTuiAttrContains(effectiveAttr, RustCsgTuiAttrUnderline) != 0:
                        output = strutil.Join([output, RustCsgTuiSetUnderline(true)], "")
                    if RustCsgTuiAttrContains(effectiveAttr, RustCsgTuiAttrReverse) != 0:
                        output = strutil.Join([output, RustCsgTuiSetReverse(true)], "")
                    if RustCsgTuiAttrContains(effectiveAttr, RustCsgTuiAttrStrikethrough) != 0:
                        output = strutil.Join([output, RustCsgTuiSetStrikethrough(true)], "")
                    if RustCsgTuiAttrContains(effectiveAttr, RustCsgTuiAttrBlink) != 0:
                        output = strutil.Join([output, RustCsgTuiSetBlink(true)], "")
                prevAttr = effectiveAttr

            # Emit the character
            output = strutil.Join([output, cell.ch], "")
            col = col + 1
        row = row + 1

    # Reset attributes and show cursor at end
    output = strutil.Join([output, RustCsgTuiResetAttrs()], "")
    output = strutil.Join([output, RustCsgTuiCursorShow()], "")
    return output

# ── Word wrapping helper ──────────────────────────────────────────────────────

# Word-wrap a text string to fit within a specified width.
# Breaks at spaces; if a single word exceeds width, it breaks mid-word.
# Returns an array of wrapped line strings.
fn RustCsgTuiWordWrap(text: str, width: int32): str[] =
    var lines: str[]
    if width <= 0:
        add(lines, text)
        return lines
    if text == "":
        add(lines, "")
        return lines

    # Split into words by spaces
    var words: str[]
    var currentWord: str = ""
    var i: int32 = 0
    while i < text.len:
        if text[i] == ' ':
            if currentWord != "":
                add(words, currentWord)
                currentWord = ""
        else:
            currentWord = strutil.Join([currentWord, strings.SliceBytes(text, i, 1)], "")
        i = i + 1
    if currentWord != "":
        add(words, currentWord)

    if words.len == 0:
        add(lines, "")
        return lines

    var lineBuffer: str = ""
    var wi: int32 = 0
    while wi < words.len:
        let word = words[wi]
        if word.len > width:
            # Word is longer than width — flush current line buffer and break word
            if lineBuffer != "":
                add(lines, lineBuffer)
                lineBuffer = ""
            var pos: int32 = 0
            while pos < word.len:
                var chunkWidth: int32 = width
                let remaining: int32 = word.len - pos
                if remaining < chunkWidth:
                    chunkWidth = remaining
                let chunk: str = strings.SliceBytes(word, pos, chunkWidth)
                add(lines, chunk)
                pos = pos + width
            wi = wi + 1
        else:
            if lineBuffer == "":
                lineBuffer = word
            else:
                if strutil.Join([lineBuffer, " ", word], "").len <= width:
                    lineBuffer = strutil.Join([lineBuffer, " ", word], "")
                else:
                    add(lines, lineBuffer)
                    lineBuffer = word
            wi = wi + 1

    if lineBuffer != "":
        add(lines, lineBuffer)

    return lines

# ── Helper: repeat a string n times ───────────────────────────────────────────

fn RustCsgTuiStrRepeat(s: str, count: int32): str =
    var result: str = ""
    var i: int32 = 0
    while i < count:
        result = strutil.Join([result, s], "")
        i = i + 1
    return result

# ── Dialog render ──────────────────────────────────────────────────────────

# Render a centered dialog box with ASCII border (+ - |).
# Returns empty string if screen is too small.
fn RustCsgTuiDialogRender(title: str, message: str, screenWidth: int32, screenHeight: int32): str =
    if screenWidth < 20 || screenHeight < 5: return ""
    let dw: int32 = screenWidth - 4
    let iw: int32 = dw - 4
    let ml: str[] = RustCsgTuiWordWrap(message, iw)
    if ml.len + 5 > screenHeight: return ""
    let tr: int32 = (screenHeight - ml.len - 3) / 2
    let lc: int32 = (screenWidth - dw) / 2
    let dc: int32 = dw - 2
    var r: str = ""
    var top: str = "+"
    let tl: int32 = strings.Len(title)
    if tl > 0 && tl < dc - 2:
        let ld: int32 = (dc - tl) / 2
        top = strutil.Join(["+", RustCsgTuiStrRepeat("-", ld), title, RustCsgTuiStrRepeat("-", dc - tl - ld), "+"], "")
    else:
        top = strutil.Join(["+", RustCsgTuiStrRepeat("-", dc), "+"], "")
    var cr: int32 = tr
    r = strutil.Join([r, RustCsgTuiCursorMoveTo(cr + 1, lc + 1), top, "\n"], "")
    var i: int32 = 0
    while i < ml.len:
        cr = cr + 1
        r = strutil.Join([r, RustCsgTuiCursorMoveTo(cr + 1, lc + 1), "|", ml[i], RustCsgTuiStrRepeat(" ", iw - strings.Len(ml[i])), "|\n"], "")
        i = i + 1
    cr = cr + 1
    let pl: int32 = strings.Len("Press any key to close")
    r = strutil.Join([r, RustCsgTuiCursorMoveTo(cr + 1, lc + 1), "|", RustCsgTuiStrRepeat(" ", (iw - pl) / 2), "Press any key to close", RustCsgTuiStrRepeat(" ", iw - pl - (iw - pl) / 2), "|\n"], "")
    cr = cr + 1
    r = strutil.Join([r, RustCsgTuiCursorMoveTo(cr + 1, lc + 1), "+", RustCsgTuiStrRepeat("-", dc), "+"], "")
    return r

# ── Scroll indicator ───────────────────────────────────────────────────────

# Return a single character indicating scroll state:
# space if all rows fit, up-arrow if scrolled up possible,
# down-arrow if scrolled down possible, up/down if both.
fn RustCsgTuiScrollIndicator(totalRows: int32, visibleRows: int32, topRow: int32): str =
    if totalRows <= visibleRows: return " "
    let up: bool = topRow > 0
    let down: bool = (topRow + visibleRows) < totalRows
    if up && down: return "↕"
    if up: return "↑"
    if down: return "↓"
    return " "

# ── Progress bar ───────────────────────────────────────────────────────────

# Render a simple text progress bar: [====>    ] 50%
fn RustCsgTuiProgressBar(current: int32, total: int32, width: int32): str =
    if total <= 0: return ""
    var cur: int32 = current
    if cur < 0: cur = 0
    if cur > total: cur = total
    var w: int32 = width
    if w < 5: w = 5
    let filled: int32 = (cur * w) / total
    var bar: str = ""
    if filled >= w:
        bar = RustCsgTuiStrRepeat("=", w)
    else:
        if filled > 0:
            bar = strutil.Join([RustCsgTuiStrRepeat("=", filled), ">", RustCsgTuiStrRepeat(" ", w - filled - 1)], "")
        else:
            bar = RustCsgTuiStrRepeat(" ", w)
    let pct: int32 = (cur * 100) / total
    return strutil.Join(["[", bar, "] ", strings.IntToStr(pct), "%"], "")
