# TUI render/highlight snapshot oracle.

import std/strutils as strutil

fn RustCsgTuiRenderHighlightAnsiFamilyForegroundPalette(): str =
    return strutil.Join([
        "ansi:\n",
        "  Blue\n",
        "  Green\n",
        "  Magenta\n",
        "  Yellow\n",
        "base16:\n",
        "  Blue\n",
        "  Gray\n",
        "  Green\n",
        "  Indexed(9)\n",
        "  Magenta\n",
        "base16-256:\n",
        "  Blue\n",
        "  Gray\n",
        "  Green\n",
        "  Indexed(16)\n",
        "  Magenta\n",
    ], "")
