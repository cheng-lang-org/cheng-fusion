# TUI bottom_pane/hooks_browser_view raw render_lines oracle.

import std/strings
import std/strutils as strutil

fn RustCsgTuiHooksSpaces(count: int32): str =
    var out: str = ""
    var i: int32 = 0
    while i < count:
        out = strings.ConcatStr(out, " ")
        i = i + 1
    return out

fn RustCsgTuiHooksStartsWithAt(text: str, index: int32, prefix: str): bool =
    let prefixLen: int32 = strings.Len(prefix)
    if index < 0:
        return false
    if index + prefixLen > strings.Len(text):
        return false
    return strings.SliceBytes(text, index, prefixLen) == prefix

fn RustCsgTuiHooksNextGlyph(text: str, index: int32): str =
    if RustCsgTuiHooksStartsWithAt(text, index, "⚠"):
        return "⚠"
    if RustCsgTuiHooksStartsWithAt(text, index, "■"):
        return "■"
    if RustCsgTuiHooksStartsWithAt(text, index, "·"):
        return "·"
    if RustCsgTuiHooksStartsWithAt(text, index, "…"):
        return "…"
    return strings.SliceBytes(text, index, 1)

fn RustCsgTuiHooksDisplayWidth(text: str): int32 =
    var width: int32 = 0
    var i: int32 = 0
    while i < strings.Len(text):
        let glyph: str = RustCsgTuiHooksNextGlyph(text, i)
        width = width + 1
        i = i + strings.Len(glyph)
    return width

fn RustCsgTuiHooksPadLine(text: str, width: int32): str =
    let currentWidth: int32 = RustCsgTuiHooksDisplayWidth(text)
    if currentWidth > width:
        assert(false, "hooks browser oracle line exceeds width")
    return strings.ConcatStr(text, RustCsgTuiHooksSpaces(width - currentWidth))

fn RustCsgTuiHooksRenderLines(width: int32, lines: str[]): str =
    var out: str = ""
    var i: int32 = 0
    while i < lines.len:
        if i + 1 == lines.len:
            out = strings.ConcatStr(out, lines[i])
        else:
            out = strings.ConcatStr(out, RustCsgTuiHooksPadLine(lines[i], width))
        out = strings.ConcatStr(out, "\n")
        i = i + 1
    return out

fn RustCsgTuiHooksEventsSnapshot(): str =
    return RustCsgTuiHooksRenderLines(112, [
        "",
        "  Hooks",
        "  Lifecycle hooks from config and enabled plugins.",
        "",
        "  Event                 Installed   Active      Description",
        "  PreToolUse            2           1           Before a tool executes",
        "  PermissionRequest     1           1           When permission is requested",
        "  PostToolUse           0           0           After a tool executes",
        "  PreCompact            0           0           Before context compaction",
        "  PostCompact           0           0           After context compaction",
        "  SessionStart          0           0           When a new session starts",
        "  UserPromptSubmit      0           0           When the user submits a prompt",
        "  SubagentStart         0           0           When a subagent is created",
        "  SubagentStop          0           0           Right before a subagent ends its turn",
        "  Stop                  0           0           Right before Codex ends its turn",
        "",
        "  Press enter to view hooks; esc to close"
    ])

