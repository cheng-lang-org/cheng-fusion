# TUI bottom_pane/chat_composer.rs footer mode terminal.backend() oracle.

import std/strings

fn RustCsgTuiChatComposerFooterModeSpaces(count: int32): str =
    var out: str = ""
    var i: int32 = 0
    while i < count:
        out = strings.ConcatStr(out, " ")
        i = i + 1
    return out

fn RustCsgTuiChatComposerFooterModeStartsWithAt(text: str, index: int32, prefix: str): bool =
    let prefixLen: int32 = strings.Len(prefix)
    if index < 0:
        return false
    if index + prefixLen > strings.Len(text):
        return false
    return strings.SliceBytes(text, index, prefixLen) == prefix

fn RustCsgTuiChatComposerFooterModeNextGlyph(text: str, index: int32): str =
    if RustCsgTuiChatComposerFooterModeStartsWithAt(text, index, "›"):
        return "›"
    if RustCsgTuiChatComposerFooterModeStartsWithAt(text, index, "…"):
        return "…"
    if RustCsgTuiChatComposerFooterModeStartsWithAt(text, index, "⌥"):
        return "⌥"
    if RustCsgTuiChatComposerFooterModeStartsWithAt(text, index, "·"):
        return "·"
    return strings.SliceBytes(text, index, 1)

fn RustCsgTuiChatComposerFooterModeDisplayWidth(text: str): int32 =
    var width: int32 = 0
    var i: int32 = 0
    while i < strings.Len(text):
        let glyph: str = RustCsgTuiChatComposerFooterModeNextGlyph(text, i)
        width = width + 1
        i = i + strings.Len(glyph)
    return width

fn RustCsgTuiChatComposerFooterModePadLine(text: str, width: int32): str =
    let currentWidth: int32 = RustCsgTuiChatComposerFooterModeDisplayWidth(text)
    if currentWidth > width:
        assert(false, "chat composer footer mode oracle line exceeds width")
    return strings.ConcatStr(text, RustCsgTuiChatComposerFooterModeSpaces(width - currentWidth))

fn RustCsgTuiChatComposerFooterModeBackend(width: int32, lines: str[]): str =
    var out: str = ""
    var i: int32 = 0
    while i < lines.len:
        out = strings.ConcatStr(out, "\"")
        out = strings.ConcatStr(out, RustCsgTuiChatComposerFooterModePadLine(lines[i], width))
        out = strings.ConcatStr(out, "\"\n")
        i = i + 1
    return out

fn RustCsgTuiChatComposerFooterModeEmptyWithFooter(footer: str): str =
    return RustCsgTuiChatComposerFooterModeBackend(100, [
        "",
        "› Ask Codex to do anything",
        "",
        "",
        "",
        "",
        "",
        "",
        footer
    ])

