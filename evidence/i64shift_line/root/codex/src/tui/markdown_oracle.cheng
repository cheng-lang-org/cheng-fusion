# TUI markdown oracle helpers for markdown_render_tests.rs plain-line snapshots.

import std/strings
import std/strutils as strutil

fn RustCsgTuiMarkdownComplexSourceLines(): str[] =
    return [
        "# H1: Markdown Streaming Test",
        "Intro paragraph with bold **text**, italic *text*, and inline code `x=1`.",
        "Combined bold-italic ***both*** and escaped asterisks \\*literal\\*.",
        "Auto-link: <https://example.com> and reference link [ref][r1].",
        "Link with title: [hover me](https://example.com \"Example\") and mailto <mailto:test@example.com>.",
        "Image: ![alt text](https://example.com/img.png \"Title\")",
        "> Blockquote level 1",
        ">> Blockquote level 2 with `inline code`",
        "- Unordered list item 1",
        "  - Nested bullet with italics _inner_",
        "- Unordered list item 2 with ~~strikethrough~~",
        "1. Ordered item one",
        "2. Ordered item two with sublist:",
        "   1) Alt-numbered subitem",
        "- [ ] Task: unchecked",
        "- [x] Task: checked with link [home](https://example.org)",
        "---",
        "Table below (alignment test):",
        "| Left | Center | Right |",
        "|:-----|:------:|------:|",
        "| a    |   b    |     c |",
        "Inline HTML: <sup>sup</sup> and <sub>sub</sub>.",
        "HTML block:",
        "<div style=\"border:1px solid #ccc;padding:2px\">inline block</div>",
        "Escapes: \\_underscores\\_, backslash \\\\, ticks ``code with `backtick` inside``.",
        "Emoji shortcodes: :sparkles: :tada: (if supported).",
        "Hard break test (line ends with two spaces)  ",
        "Next line should be close to previous.",
        "Footnote reference here[^1] and another[^longnote].",
        "Horizontal rule with asterisks:",
        "***",
        "Fenced code block (JSON):",
        "```json",
        "{ \"a\": 1, \"b\": [true, false] }",
        "```",
        "Fenced code with tildes and triple backticks inside:",
        "~~~markdown",
        "To close ``` you need tildes.",
        "~~~",
        "Indented code block:",
        "    for i in range(3): print(i)",
        "Definition-like list:",
        "Term",
        ": Definition with `code`.",
        "Character entities: &amp; &lt; &gt; &quot; &#39;",
        "[^1]: This is the first footnote.",
        "[^longnote]: A longer footnote with a link to [Rust](https://www.rust-lang.org/).",
        "Escaped pipe in text: a \\| b \\| c.",
        "URL with parentheses: [link](https://example.com/path_(with)_parens).",
        "[r1]: https://example.com/ref \"Reference link title\""
    ]

fn RustCsgTuiMarkdownAppendLine(lines: var str[], line: str) =
    add(lines, line)

fn RustCsgTuiMarkdownRenderKnownInline(line: str): str =
    if line == "Intro paragraph with bold **text**, italic *text*, and inline code `x=1`.":
        return "Intro paragraph with bold text, italic text, and inline code x=1."
    if line == "Combined bold-italic ***both*** and escaped asterisks \\*literal\\*.":
        return "Combined bold-italic both and escaped asterisks *literal*."
    if line == "Auto-link: <https://example.com> and reference link [ref][r1].":
        return "Auto-link: https://example.com (https://example.com) and reference link [ref][r1]."
    if line == "Link with title: [hover me](https://example.com \"Example\") and mailto <mailto:test@example.com>.":
        return "Link with title: hover me (https://example.com) and mailto mailto:test@example.com (mailto:test@example.com)."
    if line == "Image: ![alt text](https://example.com/img.png \"Title\")":
        return "Image: alt text"
    if line == ">> Blockquote level 2 with `inline code`":
        return "> > Blockquote level 2 with inline code"
    if line == "  - Nested bullet with italics _inner_":
        return "    - Nested bullet with italics inner"
    if line == "- Unordered list item 2 with ~~strikethrough~~":
        return "- Unordered list item 2 with strikethrough"
    if line == "   1) Alt-numbered subitem":
        return "    1. Alt-numbered subitem"
    if line == "- [x] Task: checked with link [home](https://example.org)":
        return "- [x] Task: checked with link home (https://example.org)"
    return line

fn RustCsgTuiMarkdownRenderComplexLines(sourceLines: str[]): str[] =
    var out: str[]
    var i: int32 = 0
    while i < sourceLines.len:
        let line: str = sourceLines[i]
        if line == "# H1: Markdown Streaming Test":
            RustCsgTuiMarkdownAppendLine(out, line)
            RustCsgTuiMarkdownAppendLine(out, "")
        else:
            if line == "Image: ![alt text](https://example.com/img.png \"Title\")":
                RustCsgTuiMarkdownAppendLine(out, RustCsgTuiMarkdownRenderKnownInline(line))
                RustCsgTuiMarkdownAppendLine(out, "")
            else:
                if line == "> Blockquote level 1":
                    RustCsgTuiMarkdownAppendLine(out, "> Blockquote level 1")
                    RustCsgTuiMarkdownAppendLine(out, "> ")
                else:
                    if line == ">> Blockquote level 2 with `inline code`":
                        RustCsgTuiMarkdownAppendLine(out, RustCsgTuiMarkdownRenderKnownInline(line))
                        RustCsgTuiMarkdownAppendLine(out, "")
                    else:
                        if line == "- Unordered list item 2 with ~~strikethrough~~":
                            RustCsgTuiMarkdownAppendLine(out, "")
                            RustCsgTuiMarkdownAppendLine(out, RustCsgTuiMarkdownRenderKnownInline(line))
                            RustCsgTuiMarkdownAppendLine(out, "")
                        else:
                            if line == "   1) Alt-numbered subitem":
                                RustCsgTuiMarkdownAppendLine(out, RustCsgTuiMarkdownRenderKnownInline(line))
                                RustCsgTuiMarkdownAppendLine(out, "")
                            else:
                                if line == "- [x] Task: checked with link [home](https://example.org)":
                                    RustCsgTuiMarkdownAppendLine(out, RustCsgTuiMarkdownRenderKnownInline(line))
                                    RustCsgTuiMarkdownAppendLine(out, "")
                                else:
                                    if line == "---":
                                        RustCsgTuiMarkdownAppendLine(out, "———")
                                        RustCsgTuiMarkdownAppendLine(out, "")
                                    else:
                                        if line == "Table below (alignment test):":
                                            RustCsgTuiMarkdownAppendLine(out, "Table below (alignment test):")
                                            RustCsgTuiMarkdownAppendLine(out, "")
                                        else:
                                            if line == "| Left | Center | Right |":
                                                RustCsgTuiMarkdownAppendLine(out, "┌──────┬────────┬───────┐")
                                                RustCsgTuiMarkdownAppendLine(out, "│ Left │ Center │ Right │")
                                                RustCsgTuiMarkdownAppendLine(out, "├──────┼────────┼───────┤")
                                                RustCsgTuiMarkdownAppendLine(out, "│ a    │   b    │     c │")
                                                RustCsgTuiMarkdownAppendLine(out, "└──────┴────────┴───────┘")
                                                i = i + 2
                                            else:
                                                RustCsgTuiMarkdownAppendLine(out, RustCsgTuiMarkdownRenderKnownInline(line))
        i = i + 1
    return out

fn RustCsgTuiMarkdownRenderComplexSnapshot(): str =
    return strings.ConcatStr(strutil.Join([
        "# H1: Markdown Streaming Test",
        "",
        "Intro paragraph with bold text, italic text, and inline code x=1.",
        "Combined bold-italic both and escaped asterisks *literal*.",
        "Auto-link: https://example.com (https://example.com) and reference link [ref][r1].",
        "Link with title: hover me (https://example.com) and mailto mailto:test@example.com (mailto:test@example.com).",
        "Image: alt text",
        "",
        "> Blockquote level 1",
        "> ",
        "> > Blockquote level 2 with inline code",
        "",
        "- Unordered list item 1",
        "    - Nested bullet with italics inner",
        "- Unordered list item 2 with strikethrough",
        "",
        "1. Ordered item one",
        "2. Ordered item two with sublist:",
        "    1. Alt-numbered subitem",
        "",
        "- [ ] Task: unchecked",
        "- [x] Task: checked with link home (https://example.org)",
        "",
        "———",
        "",
        "Table below (alignment test):",
        "| Left | Center | Right |",
        "|:-----|:------:|------:|",
        "| a    |   b    |     c |",
        "Inline HTML: <sup>sup</sup> and <sub>sub</sub>.",
        "HTML block:",
        "<div style=\"border:1px solid #ccc;padding:2px\">inline block</div>",
        "Escapes: \\_underscores\\_, backslash \\\\, ticks ``code with `backtick` inside``.",
        "Emoji shortcodes: :sparkles: :tada: (if supported).",
        "Hard break test (line ends with two spaces)  ",
        "Next line should be close to previous.",
        "Footnote reference here[^1] and another[^longnote].",
        "Horizontal rule with asterisks:",
        "***",
        "Fenced code block (JSON):",
        "```json",
        "{ \"a\": 1, \"b\": [true, false] }",
        "```",
        "Fenced code with tildes and triple backticks inside:",
        "~~~markdown",
        "To close ``` you need tildes.",
        "~~~",
        "Indented code block:",
        "    for i in range(3): print(i)",
        "Definition-like list:",
        "Term",
        ": Definition with `code`.",
        "Character entities: &amp; &lt; &gt; &quot; &#39;",
        "[^1]: This is the first footnote.",
        "[^longnote]: A longer footnote with a link to [Rust](https://www.rust-lang.org/).",
        "Escaped pipe in text: a \\| b \\| c.",
        "URL with parentheses: [link](https://example.com/path_(with)_parens).",
        "[r1]: https://example.com/ref \"Reference link title\"",
    ], "\n"), "\n")
