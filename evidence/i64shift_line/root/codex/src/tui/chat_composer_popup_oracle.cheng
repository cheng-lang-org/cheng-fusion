# TUI bottom_pane/chat_composer.rs popup terminal.backend() oracle.

import std/strings

fn RustCsgTuiChatComposerPopupSpaces(count: int32): str =
    var out: str = ""
    var i: int32 = 0
    while i < count:
        out = strings.ConcatStr(out, " ")
        i = i + 1
    return out

fn RustCsgTuiChatComposerPopupStartsWithAt(text: str, index: int32, prefix: str): bool =
    let prefixLen: int32 = strings.Len(prefix)
    if index < 0:
        return false
    if index + prefixLen > strings.Len(text):
        return false
    return strings.SliceBytes(text, index, prefixLen) == prefix

fn RustCsgTuiChatComposerPopupNextGlyph(text: str, index: int32): str =
    if RustCsgTuiChatComposerPopupStartsWithAt(text, index, "›"):
        return "›"
    if RustCsgTuiChatComposerPopupStartsWithAt(text, index, "…"):
        return "…"
    return strings.SliceBytes(text, index, 1)

fn RustCsgTuiChatComposerPopupDisplayWidth(text: str): int32 =
    var width: int32 = 0
    var i: int32 = 0
    while i < strings.Len(text):
        let glyph: str = RustCsgTuiChatComposerPopupNextGlyph(text, i)
        width = width + 1
        i = i + strings.Len(glyph)
    return width

fn RustCsgTuiChatComposerPopupPadLine(text: str, width: int32): str =
    let currentWidth: int32 = RustCsgTuiChatComposerPopupDisplayWidth(text)
    if currentWidth > width:
        assert(false, "chat composer popup oracle line exceeds width")
    return strings.ConcatStr(text, RustCsgTuiChatComposerPopupSpaces(width - currentWidth))

fn RustCsgTuiChatComposerPopupBackend(width: int32, lines: str[]): str =
    var out: str = ""
    var i: int32 = 0
    while i < lines.len:
        out = strings.ConcatStr(out, "\"")
        out = strings.ConcatStr(out, RustCsgTuiChatComposerPopupPadLine(lines[i], width))
        out = strings.ConcatStr(out, "\"\n")
        i = i + 1
    return out

fn RustCsgTuiChatComposerPopupMentionPopupTypePrefixesSnapshot(): str =
    return RustCsgTuiChatComposerPopupBackend(72, [
        "",
        "› $goog",
        "",
        "",
        "  Google Calendar  [Plugin] Connect Google Calendar for scheduling, ava…",
        "  Google Calendar  [Skill] Find availability and plan event changes",
        "  Google Calendar  [App] Look up events and availability",
        "",
        "  Press enter to insert or esc to close"
    ])

