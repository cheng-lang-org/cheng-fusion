# TUI keyboard input handling — KeyEvent type and ANSI escape parsing.
#
# Ported from codex-rs/tui/src/tui.rs (event handling) and crossterm key parsing.
#
# KeyEvent: represents a single key press with modifiers.
# ReadKeyEvent: reads from stdin and parses ANSI escape sequences.
# NOTE: Raw mode (termios) requires a C provider — this provides the types and
# parsing.  The actual raw mode enable/disable delegates to terminal.cheng.

import std/strings
import std/strutils as strutil
import cheng/codex/tui/terminal as term

# ── KeyEvent type ─────────────────────────────────────────────────────────────

type
    RustCsgTuiKeyEvent =
        key: str        # character or named key like "Enter", "Escape"
        ctrl: bool
        alt: bool
        shift: bool

# ── Named key constants ───────────────────────────────────────────────────────

const RustCsgTuiKeyEnter: str = "Enter"
const RustCsgTuiKeyEscape: str = "Escape"
const RustCsgTuiKeyTab: str = "Tab"
const RustCsgTuiKeyBackTab: str = "BackTab"
const RustCsgTuiKeyBackspace: str = "Backspace"
const RustCsgTuiKeyDelete: str = "Delete"
const RustCsgTuiKeyHome: str = "Home"
const RustCsgTuiKeyEnd: str = "End"
const RustCsgTuiKeyPageUp: str = "PageUp"
const RustCsgTuiKeyPageDown: str = "PageDown"
const RustCsgTuiKeyUp: str = "Up"
const RustCsgTuiKeyDown: str = "Down"
const RustCsgTuiKeyLeft: str = "Left"
const RustCsgTuiKeyRight: str = "Right"
const RustCsgTuiKeyInsert: str = "Insert"
const RustCsgTuiKeyF1: str = "F1"
const RustCsgTuiKeyF2: str = "F2"
const RustCsgTuiKeyF3: str = "F3"
const RustCsgTuiKeyF4: str = "F4"
const RustCsgTuiKeyF5: str = "F5"
const RustCsgTuiKeyF6: str = "F6"
const RustCsgTuiKeyF7: str = "F7"
const RustCsgTuiKeyF8: str = "F8"
const RustCsgTuiKeyF9: str = "F9"
const RustCsgTuiKeyF10: str = "F10"
const RustCsgTuiKeyF11: str = "F11"
const RustCsgTuiKeyF12: str = "F12"
const RustCsgTuiKeyNull: str = ""

# ── Helper: create a KeyEvent ─────────────────────────────────────────────────

fn RustCsgTuiKeyEventNew(key: str, ctrl: bool, alt: bool, shift: bool): RustCsgTuiKeyEvent =
    var ev: RustCsgTuiKeyEvent
    ev.key = key
    ev.ctrl = ctrl
    ev.alt = alt
    ev.shift = shift
    return ev

# ── Helper: single byte to 1-char str ────────────────────────────────────────

# Printable-ASCII lookup table for int32-to-str conversion
const PrintableAsciiTable: str = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

# ── ANSI escape sequence parser ───────────────────────────────────────────────

# Parse a raw key code (from TerminalReadKeyCode) into a KeyEvent.
#
# Handles:
#   - Printable ASCII (32-126)
#   - Control characters (1-26 = Ctrl+A..Ctrl+Z, 27 = Escape, 127 = Backspace)
#
# Returns a KeyEvent. For unknown sequences, returns an event with key="" and
# alt=false/ctrl=false/shift=false.
fn RustCsgTuiParseKeyEvent(code: int32): RustCsgTuiKeyEvent =
    if code == 0 || code == -1:
        return RustCsgTuiKeyEventNew(RustCsgTuiKeyNull, false, false, false)

    # Escape — could be the start of an escape sequence
    if code == 27:
        return RustCsgTuiKeyEventNew(RustCsgTuiKeyEscape, false, false, false)

    # Enter (newline, carriage return)
    if code == 10 || code == 13:
        return RustCsgTuiKeyEventNew(RustCsgTuiKeyEnter, false, false, false)

    # Tab
    if code == 9:
        return RustCsgTuiKeyEventNew(RustCsgTuiKeyTab, false, false, false)

    # Backspace (DEL)
    if code == 127:
        return RustCsgTuiKeyEventNew(RustCsgTuiKeyBackspace, false, false, false)

    # Ctrl+A through Ctrl+Z (codes 1-26)
    if code >= 1 && code <= 26:
        # Map to the letter
        let letter: str = strings.SliceBytes("@ABCDEFGHIJKLMNOPQRSTUVWXYZ", code, 1)
        return RustCsgTuiKeyEventNew(letter, true, false, false)

    # Printable ASCII (32-126)
    if code >= 32 && code <= 126:
        let ch: str = strings.SliceBytes(PrintableAsciiTable, code - 32, 1)
        return RustCsgTuiKeyEventNew(ch, false, false, false)

    return RustCsgTuiKeyEventNew(RustCsgTuiKeyNull, false, false, false)


# ── Multi-byte ANSI escape sequence parsers ─────────────────────────────────

# Parse a CSI (Control Sequence Introducer) sequence: ESC [ <params> <final>
# The `params` argument is everything after the leading ESC [ bytes.
#
# Handles:
#   - Single-letter CSI: A/B/C/D (arrows), H (Home), F (End)
#   - Tilde-terminated CSI: N~ for Insert/Delete/Home/End/PageUp/PageDown/F1-F12
fn RustCsgTuiParseCsiSequence(params: str): RustCsgTuiKeyEvent =
    let n: int32 = strings.Len(params)
    if n == 0:
        return RustCsgTuiKeyEventNew(RustCsgTuiKeyNull, false, false, false)

    let last: int32 = Int32(params[n - 1])

    # --- Letter-terminated CSI (arrows, Home, End) ---
    if last != 126:  # not '~'
        if last == 65:  # 'A'
            return RustCsgTuiKeyEventNew(RustCsgTuiKeyUp, false, false, false)
        if last == 66:  # 'B'
            return RustCsgTuiKeyEventNew(RustCsgTuiKeyDown, false, false, false)
        if last == 67:  # 'C'
            return RustCsgTuiKeyEventNew(RustCsgTuiKeyRight, false, false, false)
        if last == 68:  # 'D'
            return RustCsgTuiKeyEventNew(RustCsgTuiKeyLeft, false, false, false)
        if last == 72:  # 'H'
            return RustCsgTuiKeyEventNew(RustCsgTuiKeyHome, false, false, false)
        if last == 70:  # 'F'
            return RustCsgTuiKeyEventNew(RustCsgTuiKeyEnd, false, false, false)
        if last == 90:  # 'Z'
            return RustCsgTuiKeyEventNew(RustCsgTuiKeyBackTab, false, false, true)
        return RustCsgTuiKeyEventNew(RustCsgTuiKeyNull, false, false, false)

    # --- Tilde-terminated CSI: ESC [ <param>;... ~ ---
    # Extract the parameter string (everything before the trailing ~)
    let paramStr: str = strings.SliceBytes(params, 0, n - 1)

    # Find the first semicolon (modifier separator); use the number before it
    let semiIdx: int32 = -1
    var i: int32
    for i in i..<strings.Len(paramStr):
        if Int32(paramStr[i]) == 59:  # ';'
            semiIdx = i
            break

    var numStr: str = paramStr
    if semiIdx > 0:
        numStr = strings.SliceBytes(paramStr, 0, semiIdx)

    let param: int32 = strutil.ParseInt(numStr)

    if param == 1 || param == 7:
        return RustCsgTuiKeyEventNew(RustCsgTuiKeyHome, false, false, false)
    if param == 2:
        return RustCsgTuiKeyEventNew(RustCsgTuiKeyInsert, false, false, false)
    if param == 3:
        return RustCsgTuiKeyEventNew(RustCsgTuiKeyDelete, false, false, false)
    if param == 4 || param == 8:
        return RustCsgTuiKeyEventNew(RustCsgTuiKeyEnd, false, false, false)
    if param == 5:
        return RustCsgTuiKeyEventNew(RustCsgTuiKeyPageUp, false, false, false)
    if param == 6:
        return RustCsgTuiKeyEventNew(RustCsgTuiKeyPageDown, false, false, false)

    # F1-F12: CSI param 11-24
    if param >= 11 && param <= 24:
        let fkey: str = strings.ConcatStr("F", strings.IntToStr(param - 10))
        return RustCsgTuiKeyEventNew(fkey, false, false, false)

    return RustCsgTuiKeyEventNew(RustCsgTuiKeyNull, false, false, false)


# Parse an SS3 sequence: ESC O <char>
# Used by F1-F4 in some terminals.
# The `params` argument is everything after the leading ESC O bytes.
fn RustCsgTuiParseSs3Sequence(params: str): RustCsgTuiKeyEvent =
    let n: int32 = strings.Len(params)
    if n != 1:
        return RustCsgTuiKeyEventNew(RustCsgTuiKeyNull, false, false, false)
    let c: int32 = Int32(params[0])
    if c == 80:  # 'P' -> F1
        return RustCsgTuiKeyEventNew(RustCsgTuiKeyF1, false, false, false)
    if c == 81:  # 'Q' -> F2
        return RustCsgTuiKeyEventNew(RustCsgTuiKeyF2, false, false, false)
    if c == 82:  # 'R' -> F3
        return RustCsgTuiKeyEventNew(RustCsgTuiKeyF3, false, false, false)
    if c == 83:  # 'S' -> F4
        return RustCsgTuiKeyEventNew(RustCsgTuiKeyF4, false, false, false)
    return RustCsgTuiKeyEventNew(RustCsgTuiKeyNull, false, false, false)


# Parse a full key sequence string into a KeyEvent.
#
# Accepts both single-byte sequences (from TerminalReadKeyCode) and
# multi-byte sequences (from TerminalReadKeySequence).
#
# Multi-byte sequences start with ESC (0x1b) and are parsed as:
#   - CSI: ESC [ ...  (arrows, Home, End, PageUp, PageDown, Delete, Insert, F-keys)
#   - SS3: ESC O ...  (F1-F4)
#   - ESC <printable>  (Alt+letter)
fn RustCsgTuiParseKeySequence(seq: str): RustCsgTuiKeyEvent =
    let n: int32 = strings.Len(seq)
    if n == 0:
        return RustCsgTuiKeyEventNew(RustCsgTuiKeyNull, false, false, false)

    # Single byte -- delegate to the existing single-byte parser
    if n == 1:
        return RustCsgTuiParseKeyEvent(Int32(seq[0]))

    # Multi-byte sequence must start with ESC (0x1b)
    if Int32(seq[0]) != 27:
        return RustCsgTuiKeyEventNew(RustCsgTuiKeyNull, false, false, false)

    # ESC + single printable byte = Alt+letter
    if n == 2:
        let second: int32 = Int32(seq[1])
        if second >= 32 && second <= 126:
            let ch: str = strings.SliceBytes(PrintableAsciiTable, second - 32, 1)
            return RustCsgTuiKeyEventNew(ch, false, true, false)  # alt=true

    # Strip leading ESC byte
    let rest: str = strings.SliceBytes(seq, 1, n - 1)
    let restLen: int32 = n - 1

    # CSI: ESC [ ...
    if restLen >= 1 && Int32(rest[0]) == 91:  # '['
        return RustCsgTuiParseCsiSequence(strings.SliceBytes(rest, 1, restLen - 1))

    # SS3: ESC O ...
    if restLen >= 1 && Int32(rest[0]) == 79:  # 'O'
        return RustCsgTuiParseSs3Sequence(strings.SliceBytes(rest, 1, restLen - 1))

    return RustCsgTuiKeyEventNew(RustCsgTuiKeyNull, false, false, false)


# ── Raw mode helpers ─────────────────────────────────────────────────────────

# Enable raw mode via the C provider.
# Returns true if successful.
fn RustCsgTuiEnableRawMode(): bool =
    term.TerminalInit()
    return true

# Disable raw mode via the C provider.
# Returns true if successful.
fn RustCsgTuiDisableRawMode(): bool =
    term.TerminalRestore()
    return true

# Read one key event from stdin.
# Uses TerminalReadKeySequence for multi-byte escape sequence support.
fn RustCsgTuiReadKeyEvent(): RustCsgTuiKeyEvent =
    let seq: str = term.TerminalReadKeySequence()
    return RustCsgTuiParseKeySequence(seq)
