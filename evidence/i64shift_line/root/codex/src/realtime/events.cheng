# realtime/events — Realtime event types for the app-server protocol.
#
# These events map to the server-sent events in protocol/realtime_wire.cheng
# and the RealtimeEvent enum in the Rust codex-protocol crate.
#
# Each event has a type discriminator and a JSON payload that can be
# serialized/deserialized using the wire.cheng helpers.

import cheng/codex/protocol/wire

# ── Event type constants ──────────────────────────────────────────────────────
const RealtimeEventTypeStarted: str = "realtime_started"
const RealtimeEventTypeItem: str = "realtime_item"
const RealtimeEventTypeTranscript: str = "realtime_transcript"
const RealtimeEventTypeAudio: str = "realtime_audio"
const RealtimeEventTypeSdp: str = "realtime_sdp"
const RealtimeEventTypeError: str = "realtime_error"
const RealtimeEventTypeClosed: str = "realtime_closed"
const RealtimeEventTypeSessionUpdated: str = "session_updated"
const RealtimeEventTypeInputTranscriptDelta: str = "input_transcript_delta"
const RealtimeEventTypeInputTranscriptDone: str = "input_transcript_done"
const RealtimeEventTypeOutputTranscriptDelta: str = "output_transcript_delta"
const RealtimeEventTypeOutputTranscriptDone: str = "output_transcript_done"
const RealtimeEventTypeResponseCreated: str = "response_created"
const RealtimeEventTypeResponseDone: str = "response_done"
const RealtimeEventTypeResponseCancelled: str = "response_cancelled"
const RealtimeEventTypeConversationItemAdded: str = "conversation_item_added"
const RealtimeEventTypeConversationItemDone: str = "conversation_item_done"

# ── Event type ────────────────────────────────────────────────────────────────
type
    # Union discriminator: which variant is active
    RealtimeEventType = str

    # Individual event payloads
    RealtimeStartedEvent =
        sessionId: str
        version: str

    RealtimeItemEvent =
        itemJson: str

    RealtimeTranscriptEvent =
        role: str
        delta: str

    RealtimeTranscriptDoneEvent =
        role: str
        text: str

    RealtimeAudioEvent =
        audioJson: str

    RealtimeSdpEvent =
        sdp: str

    RealtimeErrorEvent =
        message: str

    RealtimeClosedEvent =
        reasonJson: str

    RealtimeSessionUpdatedEvent =
        realtimeSessionId: str
        instructions: str

    RealtimeResponseEvent =
        responseId: str

    RealtimeConversationItemEvent =
        itemId: str

    # Wrapper: one event with its type discriminator
    RealtimeServerEvent =
        eventType: str
        started: RealtimeStartedEvent
        item: RealtimeItemEvent
        transcript: RealtimeTranscriptEvent
        transcriptDone: RealtimeTranscriptDoneEvent
        audio: RealtimeAudioEvent
        sdp: RealtimeSdpEvent
        error: RealtimeErrorEvent
        closed: RealtimeClosedEvent
        sessionUpdated: RealtimeSessionUpdatedEvent
        responseCreated: RealtimeResponseEvent
        responseDone: RealtimeResponseEvent
        responseCancelled: RealtimeResponseEvent
        conversationItemAdded: RealtimeConversationItemEvent
        conversationItemDone: RealtimeConversationItemEvent

# ═══════════════════════════════════════════════════════════════════════════════
# Per-event JSON serialization
# ═══════════════════════════════════════════════════════════════════════════════

fn RealtimeStartedEventToJson(event: RealtimeStartedEvent): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("sessionId", event.sessionId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("version", event.version))
    out = wire.RustCsgCat(out, "}")
    return out

fn RealtimeStartedEventFromJson(text: str): RealtimeStartedEvent =
    var result: RealtimeStartedEvent
    result.sessionId = wire.RustCsgJsonFindStr(text, "sessionId")
    result.version = wire.RustCsgJsonFindStr(text, "version")
    return result

fn RealtimeItemEventToJson(event: RealtimeItemEvent): str =
    assert(event.itemJson != "", "RealtimeItemEvent requires itemJson")
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("item", event.itemJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn RealtimeItemEventFromJson(text: str): RealtimeItemEvent =
    var result: RealtimeItemEvent
    result.itemJson = wire.RustCsgJsonFindValueRaw(text, "item")
    return result

fn RealtimeTranscriptEventToJson(event: RealtimeTranscriptEvent): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("role", event.role))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("delta", event.delta))
    out = wire.RustCsgCat(out, "}")
    return out

fn RealtimeTranscriptEventFromJson(text: str): RealtimeTranscriptEvent =
    var result: RealtimeTranscriptEvent
    result.role = wire.RustCsgJsonFindStr(text, "role")
    result.delta = wire.RustCsgJsonFindStr(text, "delta")
    return result

fn RealtimeTranscriptDoneEventToJson(event: RealtimeTranscriptDoneEvent): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("role", event.role))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("text", event.text))
    out = wire.RustCsgCat(out, "}")
    return out

fn RealtimeTranscriptDoneEventFromJson(text: str): RealtimeTranscriptDoneEvent =
    var result: RealtimeTranscriptDoneEvent
    result.role = wire.RustCsgJsonFindStr(text, "role")
    result.text = wire.RustCsgJsonFindStr(text, "text")
    return result

fn RealtimeAudioEventToJson(event: RealtimeAudioEvent): str =
    assert(event.audioJson != "", "RealtimeAudioEvent requires audioJson")
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("audio", event.audioJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn RealtimeAudioEventFromJson(text: str): RealtimeAudioEvent =
    var result: RealtimeAudioEvent
    result.audioJson = wire.RustCsgJsonFindObject(text, "audio")
    return result

fn RealtimeSdpEventToJson(event: RealtimeSdpEvent): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("sdp", event.sdp))
    out = wire.RustCsgCat(out, "}")
    return out

fn RealtimeSdpEventFromJson(text: str): RealtimeSdpEvent =
    var result: RealtimeSdpEvent
    result.sdp = wire.RustCsgJsonFindStr(text, "sdp")
    return result

fn RealtimeErrorEventToJson(event: RealtimeErrorEvent): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("message", event.message))
    out = wire.RustCsgCat(out, "}")
    return out

fn RealtimeErrorEventFromJson(text: str): RealtimeErrorEvent =
    var result: RealtimeErrorEvent
    result.message = wire.RustCsgJsonFindStr(text, "message")
    return result

fn RealtimeClosedEventToJson(event: RealtimeClosedEvent): str =
    var out = "{"
    if event.reasonJson != "":
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("reason", event.reasonJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn RealtimeClosedEventFromJson(text: str): RealtimeClosedEvent =
    var result: RealtimeClosedEvent
    result.reasonJson = wire.RustCsgJsonFindOptionalValueRaw(text, "reason")
    return result

fn RealtimeSessionUpdatedEventToJson(event: RealtimeSessionUpdatedEvent): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("realtimeSessionId", event.realtimeSessionId))
    if event.instructions != "":
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("instructions", event.instructions))
    out = wire.RustCsgCat(out, "}")
    return out

fn RealtimeSessionUpdatedEventFromJson(text: str): RealtimeSessionUpdatedEvent =
    var result: RealtimeSessionUpdatedEvent
    result.realtimeSessionId = wire.RustCsgJsonFindStr(text, "realtimeSessionId")
    result.instructions = wire.RustCsgJsonFindOptionalStr(text, "instructions")
    return result

fn RealtimeResponseEventToJson(event: RealtimeResponseEvent): str =
    var out = "{"
    if event.responseId != "":
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("responseId", event.responseId))
    out = wire.RustCsgCat(out, "}")
    return out

fn RealtimeResponseEventFromJson(text: str): RealtimeResponseEvent =
    var result: RealtimeResponseEvent
    result.responseId = wire.RustCsgJsonFindOptionalStr(text, "responseId")
    return result

fn RealtimeConversationItemEventToJson(event: RealtimeConversationItemEvent): str =
    var out = "{"
    if event.itemId != "":
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("itemId", event.itemId))
    out = wire.RustCsgCat(out, "}")
    return out

fn RealtimeConversationItemEventFromJson(text: str): RealtimeConversationItemEvent =
    var result: RealtimeConversationItemEvent
    result.itemId = wire.RustCsgJsonFindOptionalStr(text, "itemId")
    return result

# ═══════════════════════════════════════════════════════════════════════════════
# Server event dispatch (type discriminator + payload)
# ═══════════════════════════════════════════════════════════════════════════════

fn RealtimeServerEventToJson(event: RealtimeServerEvent): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("type", event.eventType))
    out = wire.RustCsgCat(out, ",\"payload\":")
    if event.eventType == RealtimeEventTypeStarted:
        out = wire.RustCsgCat(out, RealtimeStartedEventToJson(event.started))
    elif event.eventType == RealtimeEventTypeItem:
        out = wire.RustCsgCat(out, RealtimeItemEventToJson(event.item))
    elif event.eventType == RealtimeEventTypeTranscript:
        out = wire.RustCsgCat(out, RealtimeTranscriptEventToJson(event.transcript))
    elif event.eventType == RealtimeEventTypeAudio:
        out = wire.RustCsgCat(out, RealtimeAudioEventToJson(event.audio))
    elif event.eventType == RealtimeEventTypeSdp:
        out = wire.RustCsgCat(out, RealtimeSdpEventToJson(event.sdp))
    elif event.eventType == RealtimeEventTypeError:
        out = wire.RustCsgCat(out, RealtimeErrorEventToJson(event.error))
    elif event.eventType == RealtimeEventTypeClosed:
        out = wire.RustCsgCat(out, RealtimeClosedEventToJson(event.closed))
    elif event.eventType == RealtimeEventTypeSessionUpdated:
        out = wire.RustCsgCat(out, RealtimeSessionUpdatedEventToJson(event.sessionUpdated))
    elif event.eventType == RealtimeEventTypeResponseCreated:
        out = wire.RustCsgCat(out, RealtimeResponseEventToJson(event.responseCreated))
    elif event.eventType == RealtimeEventTypeResponseDone:
        out = wire.RustCsgCat(out, RealtimeResponseEventToJson(event.responseDone))
    elif event.eventType == RealtimeEventTypeResponseCancelled:
        out = wire.RustCsgCat(out, RealtimeResponseEventToJson(event.responseCancelled))
    elif event.eventType == RealtimeEventTypeConversationItemAdded:
        out = wire.RustCsgCat(out, RealtimeConversationItemEventToJson(event.conversationItemAdded))
    elif event.eventType == RealtimeEventTypeConversationItemDone:
        out = wire.RustCsgCat(out, RealtimeConversationItemEventToJson(event.conversationItemDone))
    elif event.eventType == RealtimeEventTypeInputTranscriptDelta:
        out = wire.RustCsgCat(out, RealtimeTranscriptEventToJson(event.transcript))
    elif event.eventType == RealtimeEventTypeInputTranscriptDone:
        out = wire.RustCsgCat(out, RealtimeTranscriptDoneEventToJson(event.transcriptDone))
    elif event.eventType == RealtimeEventTypeOutputTranscriptDelta:
        out = wire.RustCsgCat(out, RealtimeTranscriptEventToJson(event.transcript))
    elif event.eventType == RealtimeEventTypeOutputTranscriptDone:
        out = wire.RustCsgCat(out, RealtimeTranscriptDoneEventToJson(event.transcriptDone))
    else:
        assert(false, wire.RustCsgCat("unknown realtime event type: ", event.eventType))
    out = wire.RustCsgCat(out, "}")
    return out

fn RealtimeServerEventFromJson(text: str): RealtimeServerEvent =
    var result: RealtimeServerEvent
    result.eventType = wire.RustCsgJsonFindStr(text, "type")
    let payload = wire.RustCsgJsonFindObject(text, "payload")
    if result.eventType == RealtimeEventTypeStarted:
        result.started = RealtimeStartedEventFromJson(payload)
    elif result.eventType == RealtimeEventTypeItem:
        result.item = RealtimeItemEventFromJson(payload)
    elif result.eventType == RealtimeEventTypeTranscript:
        result.transcript = RealtimeTranscriptEventFromJson(payload)
    elif result.eventType == RealtimeEventTypeAudio:
        result.audio = RealtimeAudioEventFromJson(payload)
    elif result.eventType == RealtimeEventTypeSdp:
        result.sdp = RealtimeSdpEventFromJson(payload)
    elif result.eventType == RealtimeEventTypeError:
        result.error = RealtimeErrorEventFromJson(payload)
    elif result.eventType == RealtimeEventTypeClosed:
        result.closed = RealtimeClosedEventFromJson(payload)
    elif result.eventType == RealtimeEventTypeSessionUpdated:
        result.sessionUpdated = RealtimeSessionUpdatedEventFromJson(payload)
    elif result.eventType == RealtimeEventTypeResponseCreated:
        result.responseCreated = RealtimeResponseEventFromJson(payload)
    elif result.eventType == RealtimeEventTypeResponseDone:
        result.responseDone = RealtimeResponseEventFromJson(payload)
    elif result.eventType == RealtimeEventTypeResponseCancelled:
        result.responseCancelled = RealtimeResponseEventFromJson(payload)
    elif result.eventType == RealtimeEventTypeConversationItemAdded:
        result.conversationItemAdded = RealtimeConversationItemEventFromJson(payload)
    elif result.eventType == RealtimeEventTypeConversationItemDone:
        result.conversationItemDone = RealtimeConversationItemEventFromJson(payload)
    elif result.eventType == RealtimeEventTypeInputTranscriptDelta:
        result.transcript = RealtimeTranscriptEventFromJson(payload)
    elif result.eventType == RealtimeEventTypeInputTranscriptDone:
        result.transcriptDone = RealtimeTranscriptDoneEventFromJson(payload)
    elif result.eventType == RealtimeEventTypeOutputTranscriptDelta:
        result.transcript = RealtimeTranscriptEventFromJson(payload)
    elif result.eventType == RealtimeEventTypeOutputTranscriptDone:
        result.transcriptDone = RealtimeTranscriptDoneEventFromJson(payload)
    else:
        assert(false, wire.RustCsgCat("unknown realtime event type: ", result.eventType))
    return result
