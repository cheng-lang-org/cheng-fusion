# realtime/session — Realtime session lifecycle management.
#
# Manages the realtime session state machine (connecting → connected → disconnected)
# and provides remote control enable/disable and audio stream control.
#
# The actual WebRTC peer connection, data channel, and audio streaming require
# native libraries and are NOT implemented here. This module defines the protocol
# state machine and JSON serialization.

import cheng/codex/protocol/wire

# ── Session status constants ──────────────────────────────────────────────────
const RealtimeSessionStatusConnecting: str = "connecting"
const RealtimeSessionStatusConnected: str = "connected"
const RealtimeSessionStatusDisconnected: str = "disconnected"
const RealtimeSessionStatusError: str = "error"

# ── Session config ───────────────────────────────────────────────────────────
type
    RealtimeSessionConfig =
        sessionId: str
        serverUrl: str
        outputModality: str   # "text" or "audio"
        voice: str
        instructions: str

# ── RealtimeSession ──────────────────────────────────────────────────────────
type
    RealtimeSession =
        sessionId: str
        status: str           # connecting / connected / disconnected / error
        remoteControlEnabled: bool
        audioEnabled: bool
        signalingState: str
        lastError: str

# ═══════════════════════════════════════════════════════════════════════════════
# Public API
# ═══════════════════════════════════════════════════════════════════════════════

fn RealtimeSessionCreate(sessionId: str): RealtimeSession =
    assert(sessionId != "", "sessionId is required")
    var session: RealtimeSession
    session.sessionId = sessionId
    session.status = RealtimeSessionStatusDisconnected
    session.remoteControlEnabled = false
    session.audioEnabled = false
    session.signalingState = ""
    session.lastError = ""
    return session

fn RealtimeSessionToJson(session: RealtimeSession): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("sessionId", session.sessionId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("status", session.status))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("remoteControlEnabled", session.remoteControlEnabled))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("audioEnabled", session.audioEnabled))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("signalingState", session.signalingState))
    if session.lastError != "":
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("lastError", session.lastError))
    out = wire.RustCsgCat(out, "}")
    return out

fn RealtimeSessionFromJson(text: str): RealtimeSession =
    var result: RealtimeSession
    result.sessionId = wire.RustCsgJsonFindStr(text, "sessionId")
    result.status = wire.RustCsgJsonFindStr(text, "status")
    result.remoteControlEnabled = wire.RustCsgJsonFindBool(text, "remoteControlEnabled")
    result.audioEnabled = wire.RustCsgJsonFindBool(text, "audioEnabled")
    result.signalingState = wire.RustCsgJsonFindOptionalStr(text, "signalingState")
    result.lastError = wire.RustCsgJsonFindOptionalStr(text, "lastError")
    return result

# ── State machine transitions ────────────────────────────────────────────────

fn RealtimeSessionSetConnecting(session: var RealtimeSession) =
    session.status = RealtimeSessionStatusConnecting
    session.lastError = ""

fn RealtimeSessionSetConnected(session: var RealtimeSession) =
    session.status = RealtimeSessionStatusConnected
    session.lastError = ""

fn RealtimeSessionSetDisconnected(session: var RealtimeSession) =
    session.status = RealtimeSessionStatusDisconnected
    session.signalingState = ""
    session.remoteControlEnabled = false
    session.audioEnabled = false

fn RealtimeSessionSetError(session: var RealtimeSession, error: str) =
    session.status = RealtimeSessionStatusError
    session.lastError = error

fn RealtimeSessionSetSignalingState(session: var RealtimeSession, state: str) =
    session.signalingState = state

# ── Remote control ────────────────────────────────────────────────────────────

fn RealtimeSessionEnableRemoteControl(session: var RealtimeSession): bool =
    if session.status != RealtimeSessionStatusConnected:
        return false
    session.remoteControlEnabled = true
    return true

fn RealtimeSessionDisableRemoteControl(session: var RealtimeSession): bool =
    if session.status != RealtimeSessionStatusConnected:
        return false
    session.remoteControlEnabled = false
    return true

# ── Audio stream ──────────────────────────────────────────────────────────────

fn RealtimeSessionEnableAudio(session: var RealtimeSession): bool =
    if session.status != RealtimeSessionStatusConnected:
        return false
    session.audioEnabled = true
    return true

fn RealtimeSessionDisableAudio(session: var RealtimeSession): bool =
    if session.status != RealtimeSessionStatusConnected:
        return false
    session.audioEnabled = false
    return true

# ── Remote control message types ─────────────────────────────────────────────

const RealtimeRemoteControlMouseMove: str = "mouse_move"
const RealtimeRemoteControlMouseClick: str = "mouse_click"
const RealtimeRemoteControlMouseScroll: str = "mouse_scroll"
const RealtimeRemoteControlKeyDown: str = "key_down"
const RealtimeRemoteControlKeyUp: str = "key_up"

# Remote control event — keyboard/mouse event sent over data channel.
type
    RemoteControlEvent =
        eventType: str     # mouse_move / mouse_click / mouse_scroll / key_down / key_up
        x: int32           # cursor x (for mouse events)
        y: int32           # cursor y (for mouse events)
        button: int32      # mouse button 0=left 1=middle 2=right
        key: str           # key identifier (for keyboard events)
        deltaX: int32      # scroll delta x
        deltaY: int32      # scroll delta y
        sessionId: str

fn RemoteControlEventToJson(event: RemoteControlEvent): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("type", event.eventType))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("sessionId", event.sessionId))
    if event.eventType == RealtimeRemoteControlMouseMove || event.eventType == RealtimeRemoteControlMouseClick:
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("x", event.x))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("y", event.y))
    if event.eventType == RealtimeRemoteControlMouseClick:
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("button", event.button))
    if event.eventType == RealtimeRemoteControlMouseScroll:
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("deltaX", event.deltaX))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("deltaY", event.deltaY))
    if event.eventType == RealtimeRemoteControlKeyDown || event.eventType == RealtimeRemoteControlKeyUp:
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("key", event.key))
    out = wire.RustCsgCat(out, "}")
    return out

fn RemoteControlEventFromJson(text: str): RemoteControlEvent =
    var result: RemoteControlEvent
    result.eventType = wire.RustCsgJsonFindStr(text, "type")
    result.sessionId = wire.RustCsgJsonFindOptionalStr(text, "sessionId")
    if result.eventType == RealtimeRemoteControlMouseMove:
        result.x = wire.RustCsgJsonFindInt32(text, "x")
        result.y = wire.RustCsgJsonFindInt32(text, "y")
    if result.eventType == RealtimeRemoteControlMouseClick:
        result.x = wire.RustCsgJsonFindInt32(text, "x")
        result.y = wire.RustCsgJsonFindInt32(text, "y")
        result.button = wire.RustCsgJsonFindInt32(text, "button")
    if result.eventType == RealtimeRemoteControlMouseScroll:
        result.deltaX = wire.RustCsgJsonFindInt32(text, "deltaX")
        result.deltaY = wire.RustCsgJsonFindInt32(text, "deltaY")
    if result.eventType == RealtimeRemoteControlKeyDown:
        result.key = wire.RustCsgJsonFindStr(text, "key")
    if result.eventType == RealtimeRemoteControlKeyUp:
        result.key = wire.RustCsgJsonFindStr(text, "key")
    return result

# ── Audio format constants ────────────────────────────────────────────────────
const RealtimeAudioCodecOpus: str = "opus"
const RealtimeAudioSampleRate: int32 = 24000
const RealtimeAudioChannels: int32 = 1

# Audio stream configuration.
type
    AudioStreamConfig =
        codec: str
        sampleRate: int32
        channels: int32

fn AudioStreamConfigDefault(): AudioStreamConfig =
    var config: AudioStreamConfig
    config.codec = RealtimeAudioCodecOpus
    config.sampleRate = RealtimeAudioSampleRate
    config.channels = RealtimeAudioChannels
    return config

fn AudioStreamConfigToJson(config: AudioStreamConfig): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("codec", config.codec))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("sampleRate", config.sampleRate))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("channels", config.channels))
    out = wire.RustCsgCat(out, "}")
    return out
