# realtime/signaling — WebRTC signaling protocol layer.
#
# Defines the signaling message types for SDP offer/answer exchange,
# ICE candidate negotiation, and session termination.
#
# Actual WebRTC peer connection requires a native library (libwebrtc, GStreamer, etc.)
# and is NOT implemented here. This module provides protocol-correct types and
# JSON serialization for the signaling channel.
#
# Signaling transport uses the existing HTTP client (src/std/http.cheng) for REST
# calls and SSE for event delivery.

import std/strutils as strutil
import cheng/codex/protocol/wire

# ── SignalingMessage types ────────────────────────────────────────────────────
const RealtimeSignalingTypeOffer: str = "offer"
const RealtimeSignalingTypeAnswer: str = "answer"
const RealtimeSignalingTypeIceCandidate: str = "ice-candidate"
const RealtimeSignalingTypeBye: str = "bye"

# ── IceCandidate ──────────────────────────────────────────────────────────────
type
    IceCandidate =
        candidate: str
        sdpMid: str
        sdpMLineIndex: int32

# ── SignalingMessage ─────────────────────────────────────────────────────────
type
    SignalingMessage =
        msgType: str    # offer/answer/ice-candidate/bye
        sdp: str        # SDP string (for offer/answer)
        candidateJson: str  # JSON string of IceCandidate (for ice-candidate)
        senderId: str
        sessionId: str

# ── SessionDescription type ───────────────────────────────────────────────────
type
    SessionDescription =
        sdpType: str   # "offer" or "answer"
        sdp: str

# ═══════════════════════════════════════════════════════════════════════════════
# Public API
# ═══════════════════════════════════════════════════════════════════════════════

fn IceCandidateToJson(candidate: IceCandidate): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("candidate", candidate.candidate))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("sdpMid", candidate.sdpMid))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("sdpMLineIndex", candidate.sdpMLineIndex))
    out = wire.RustCsgCat(out, "}")
    return out

fn IceCandidateFromJson(text: str): IceCandidate =
    var result: IceCandidate
    result.candidate = wire.RustCsgJsonFindStr(text, "candidate")
    result.sdpMid = wire.RustCsgJsonFindStr(text, "sdpMid")
    result.sdpMLineIndex = wire.RustCsgJsonFindInt32(text, "sdpMLineIndex")
    return result

fn SignalingMessageToJson(msg: SignalingMessage): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("type", msg.msgType))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("senderId", msg.senderId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("sessionId", msg.sessionId))
    if msg.msgType == RealtimeSignalingTypeOffer || msg.msgType == RealtimeSignalingTypeAnswer:
        assert(msg.sdp != "", "SDP required for offer/answer")
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("sdp", msg.sdp))
    elif msg.msgType == RealtimeSignalingTypeIceCandidate:
        assert(msg.candidateJson != "", "IceCandidate required for ice-candidate")
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("candidate", msg.candidateJson))
    # bye has no extra fields
    out = wire.RustCsgCat(out, "}")
    return out

fn SignalingMessageFromJson(text: str): SignalingMessage =
    var result: SignalingMessage
    result.msgType = wire.RustCsgJsonFindStr(text, "type")
    result.senderId = wire.RustCsgJsonFindStr(text, "senderId")
    result.sessionId = wire.RustCsgJsonFindStr(text, "sessionId")
    if result.msgType == RealtimeSignalingTypeOffer || result.msgType == RealtimeSignalingTypeAnswer:
        result.sdp = wire.RustCsgJsonFindStr(text, "sdp")
        assert(result.sdp != "", "SDP field is required for offer/answer")
    elif result.msgType == RealtimeSignalingTypeIceCandidate:
        let candidateRaw = wire.RustCsgJsonFindObject(text, "candidate")
        result.candidateJson = candidateRaw
        assert(result.candidateJson != "", "candidate field is required for ice-candidate")
    # bye: no extra fields needed
    return result

# ── CreateOffer / CreateAnswer ────────────────────────────────────────────────
# These are protocol-level wrappers that build a SignalingMessage with
# the SDP string. Actual SDP generation requires native WebRTC.

fn RealtimeCreateOffer(sessionId: str, senderId: str): SignalingMessage =
    var msg: SignalingMessage
    msg.msgType = RealtimeSignalingTypeOffer
    msg.sessionId = sessionId
    msg.senderId = senderId
    # Build minimal placeholder SDP.
    # In production this would come from RTCPeerConnection.createOffer().
    msg.sdp = strutil.Join([
        "v=0",
        strutil.Join(["o=- ", sessionId, " 2 IN IP4 127.0.0.1"], ""),
        "s=-",
        "t=0 0"
    ], "\n")
    return msg

fn RealtimeCreateAnswer(sessionId: str, senderId: str, offerSdp: str): SignalingMessage =
    assert(offerSdp != "", "cannot create answer from empty offer SDP")
    var msg: SignalingMessage
    msg.msgType = RealtimeSignalingTypeAnswer
    msg.sessionId = sessionId
    msg.senderId = senderId
    # Minimal answer SDP derived from offer media lines.
    # In production this would come from RTCPeerConnection.createAnswer().
    let offerLines = strutil.Split(offerSdp, '\n')
    var answerLines: str[]
    let hasMedia = strutil.Contains(offerSdp, "\nm=") || strutil.Contains(offerSdp, "m=")
    if !hasMedia:
        # Echo basic session description lines
        for i in 0..<offerLines.len:
            let line = offerLines[i]
            if line.len >= 2 && line[0] == 'm' && line[1] == '=':
                add(answerLines, line)
            elif line.len >= 2 && line[0] == 'a' && line[1] == '=':
                add(answerLines, line)
    if answerLines.len == 0:
        # If we couldn't extract media lines, use a basic answer.
        msg.sdp = strutil.Join([
            "v=0",
            strutil.Join(["o=- ", sessionId, " 2 IN IP4 127.0.0.1"], ""),
            "s=-",
            "t=0 0"
        ], "\n")
    else:
        # Build answer with the media lines from the offer.
        var parts: str[]
        add(parts, "v=0")
        add(parts, strutil.Join(["o=- ", sessionId, " 2 IN IP4 127.0.0.1"], ""))
        add(parts, "s=-")
        add(parts, "t=0 0")
        for i in 0..<answerLines.len:
            add(parts, answerLines[i])
        msg.sdp = strutil.Join(parts, "\n")
    return msg

# ── ICE candidate ─────────────────────────────────────────────────────────────
fn RealtimeCreateIceCandidate(sessionId: str, senderId: str, candidate: IceCandidate): SignalingMessage =
    var msg: SignalingMessage
    msg.msgType = RealtimeSignalingTypeIceCandidate
    msg.sessionId = sessionId
    msg.senderId = senderId
    msg.candidateJson = IceCandidateToJson(candidate)
    return msg

# ── Bye ───────────────────────────────────────────────────────────────────────
fn RealtimeCreateBye(sessionId: str, senderId: str): SignalingMessage =
    var msg: SignalingMessage
    msg.msgType = RealtimeSignalingTypeBye
    msg.sessionId = sessionId
    msg.senderId = senderId
    return msg

# ── Validate signaling message ───────────────────────────────────────────────
fn RealtimeValidateSignalingFieldsCode(msgType: str,
                                       sessionId: str,
                                       senderId: str,
                                       sdp: str,
                                       candidateJson: str): int32 =
    if msgType == "":
        return 0
    if sessionId == "":
        return 0
    if senderId == "":
        return 0
    if msgType == RealtimeSignalingTypeOffer:
        if sdp == "":
            return 0
        return 1
    if msgType == RealtimeSignalingTypeAnswer:
        if sdp == "":
            return 0
        return 1
    if msgType == RealtimeSignalingTypeIceCandidate:
        if candidateJson == "":
            return 0
        return 1
    if msgType == RealtimeSignalingTypeBye:
        return 1
    return 0

fn RealtimeValidateSignalingFields(msgType: str,
                                   sessionId: str,
                                   senderId: str,
                                   sdp: str,
                                   candidateJson: str): bool =
    return RealtimeValidateSignalingFieldsCode(msgType,
                                               sessionId,
                                               senderId,
                                               sdp,
                                               candidateJson) == 1

fn RealtimeValidateSignalingMessage(msg: var SignalingMessage): bool =
    return RealtimeValidateSignalingFields(msg.msgType,
                                           msg.sessionId,
                                           msg.senderId,
                                           msg.sdp,
                                           msg.candidateJson)
