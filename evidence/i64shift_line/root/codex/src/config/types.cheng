import cheng/codex/protocol/types
import cheng/codex/protocol/wire

fn RustCsgRolloutConfigToJson(config: types.RustCsgRolloutConfig): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("codex_home", config.codexHome))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("sqlite_home", config.sqliteHome))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("cwd", config.cwd))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("model_provider_id", config.modelProviderId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("generate_memories", config.generateMemories))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgRolloutConfigFromJson(text: str): types.RustCsgRolloutConfig =
    var result: types.RustCsgRolloutConfig
    result.codexHome = wire.RustCsgJsonFindStr(text, "codex_home")
    result.sqliteHome = wire.RustCsgJsonFindStr(text, "sqlite_home")
    result.cwd = wire.RustCsgJsonFindStr(text, "cwd")
    result.modelProviderId = wire.RustCsgJsonFindStr(text, "model_provider_id")
    result.generateMemories = wire.RustCsgJsonFindBool(text, "generate_memories")
    return result

fn RustCsgRolloutConfigValidate(config: types.RustCsgRolloutConfig, err: var str): bool =
    if config.codexHome == "":
        err = "codex_home is empty"
        return false
    if config.sqliteHome == "":
        err = "sqlite_home is empty"
        return false
    if config.cwd == "":
        err = "cwd is empty"
        return false
    if config.modelProviderId == "":
        err = "model_provider_id is empty"
        return false
    err = ""
    return true
