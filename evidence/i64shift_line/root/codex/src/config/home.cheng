import cheng/codex/protocol/wire

@abi_internal
@importc("driver_c_new_string")
fn RustCsgHomeNewCString(len: int32): cstring

@abi_internal
@importc("driver_c_new_string_copy_n")
fn RustCsgHomeNewCStringCopy(src: ptr, len: int32): cstring

@abi_internal
@importc("cheng_cstrlen")
fn RustCsgHomeCStringLen(raw: cstring): int32

@abi_internal
@importc("RustCsgGetEnvRaw")
fn RustCsgGetEnvAbi(name: cstring): cstring

@abi_internal
@importc("RustCsgPathMetadataKindRaw")
fn RustCsgPathMetadataKindAbi(path: cstring): int32

@abi_internal
@importc("RustCsgRealPathRaw")
fn RustCsgRealPathAbi(path: cstring): cstring

@abi_internal
@importc("ReadFileRaw")
fn RustCsgReadFileAbi(path: cstring): cstring

fn RustCsgHomeCString(text: str): cstring =
    if text.len <= 0 || text.data == nil:
        return RustCsgHomeNewCString(0)
    return RustCsgHomeNewCStringCopy(text.data, text.len)

fn RustCsgHomeStrFromCString(raw: cstring): str =
    var out: str
    if raw != nil:
        out.data = ptr(raw)
        out.len = RustCsgHomeCStringLen(raw)
    return out

fn RustCsgGetEnv(name: str): str =
    let raw: cstring = RustCsgGetEnvAbi(RustCsgHomeCString(name))
    return RustCsgHomeStrFromCString(raw)

fn RustCsgPathMetadataKind(path: str): int32 =
    return RustCsgPathMetadataKindAbi(RustCsgHomeCString(path))

fn RustCsgRealPath(path: str): str =
    let raw: cstring = RustCsgRealPathAbi(RustCsgHomeCString(path))
    return RustCsgHomeStrFromCString(raw)

fn RustCsgReadFile(path: str): str =
    let raw: cstring = RustCsgReadFileAbi(RustCsgHomeCString(path))
    return RustCsgHomeStrFromCString(raw)

type
    RustCsgCodexHomeResult =
        path: str
        error: str

fn RustCsgPathIsAbsolute(path: str): bool =
    return path.len > 0 && path[0] == '/'

fn RustCsgPathJoinChild(parent: str, child: str): str =
    if parent == "":
        return child
    if parent[parent.len - 1] == '/':
        return wire.RustCsgCat(parent, child)
    return wire.RustCsgCat(wire.RustCsgCat(parent, "/"), child)

fn RustCsgHomeDebugPath(path: str): str =
    return wire.RustCsgJsonQuote(path)

fn RustCsgFindCodexHomeFromEnvValue(codexHomeEnv: str, homeEnv: str): RustCsgCodexHomeResult =
    var result: RustCsgCodexHomeResult
    RustCsgFindCodexHomeFromEnvValueInto(codexHomeEnv, homeEnv, result.path, result.error)
    return result

fn RustCsgFindCodexHomeFromEnvValueInto(codexHomeEnv: str, homeEnv: str, outPath: var str, outError: var str) =
    outPath = ""
    outError = ""
    if codexHomeEnv != "":
        let metadataKind = RustCsgPathMetadataKind(codexHomeEnv)
        if metadataKind == 0:
            outError = wire.RustCsgCat(
                wire.RustCsgCat("CODEX_HOME points to ", RustCsgHomeDebugPath(codexHomeEnv)),
                ", but that path does not exist")
            return
        if metadataKind < 0:
            outError = wire.RustCsgCat("failed to read CODEX_HOME ",
                                           RustCsgHomeDebugPath(codexHomeEnv))
            return
        if metadataKind != 1:
            outError = wire.RustCsgCat(
                wire.RustCsgCat("CODEX_HOME points to ", RustCsgHomeDebugPath(codexHomeEnv)),
                ", but that path is not a directory")
            return
        let canonical = RustCsgRealPath(codexHomeEnv)
        if canonical == "":
            outError = wire.RustCsgCat("failed to canonicalize CODEX_HOME ",
                                           RustCsgHomeDebugPath(codexHomeEnv))
            return
        outPath = canonical
        return
    if homeEnv == "" || !RustCsgPathIsAbsolute(homeEnv):
        outError = "Could not find home directory"
        return
    if homeEnv[homeEnv.len - 1] == '/':
        outPath = wire.RustCsgCat(homeEnv, ".codex")
        return
    let homeWithSlash = wire.RustCsgCat(homeEnv, "/")
    outPath = wire.RustCsgCat(homeWithSlash, ".codex")

fn RustCsgFindCodexHome(): RustCsgCodexHomeResult =
    let codexHomeEnv = RustCsgGetEnv("CODEX_HOME")
    let homeEnv = RustCsgGetEnv("HOME")
    return RustCsgFindCodexHomeFromEnvValue(codexHomeEnv, homeEnv)

fn RustCsgFindCodexHomeInto(outPath: var str, outError: var str) =
    let codexHomeEnv = RustCsgGetEnv("CODEX_HOME")
    let homeEnv = RustCsgGetEnv("HOME")
    RustCsgFindCodexHomeFromEnvValueInto(codexHomeEnv, homeEnv, outPath, outError)
