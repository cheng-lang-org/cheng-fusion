import std/os
import cheng/codex/config/home
import cheng/codex/protocol/wire

@abi_internal
@importc("RustCsgPathReadable")
fn RustCsgPathReadable(path: str): int32

fn RustCsgReadConfigFile(path: str): str =
    return home.RustCsgReadFile(path)

fn RustCsgConfigTomlIsSpace(ch: char): bool =
    return ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r'

fn RustCsgConfigTomlTrim(raw: str): str =
    if raw.len == 0:
        return ""
    var start: int32
    while start < raw.len && RustCsgConfigTomlIsSpace(raw[start]):
        start = start + 1
    if start >= raw.len:
        return ""
    var stop: int32
    stop = raw.len
    while stop > start && RustCsgConfigTomlIsSpace(raw[stop - 1]):
        stop = stop - 1
    return wire.RustCsgSliceBytes(raw, start, stop - start)

fn RustCsgConfigTomlFindEquals(line: str): int32 =
    var quote: char
    for i in 0..<line.len:
        let ch = line[i]
        if quote != '\0':
            if ch == '\\':
                return -2
            if ch == quote:
                quote = '\0'
        elif ch == '"' || ch == '\'':
            quote = ch
        elif ch == '=':
            return i
    if quote != '\0':
        return -2
    return -1

fn RustCsgConfigTomlStripComment(line: str, outError: var str): str =
    outError = ""
    var quote: char
    for i in 0..<line.len:
        let ch = line[i]
        if quote != '\0':
            if ch == '\\':
                outError = "config.toml string escaping not ported"
                return ""
            if ch == quote:
                quote = '\0'
        elif ch == '"' || ch == '\'':
            quote = ch
        elif ch == '#':
            return RustCsgConfigTomlTrim(wire.RustCsgSliceBytes(line, 0, i))
    if quote != '\0':
        outError = "unterminated config.toml string"
        return ""
    return RustCsgConfigTomlTrim(line)

fn RustCsgConfigTomlStringValue(valueRaw: str, outError: var str): str =
    outError = ""
    let value = RustCsgConfigTomlTrim(valueRaw)
    if value.len < 2:
        outError = wire.RustCsgCat("config.toml string value must be quoted: ", value)
        return ""
    let quote = value[0]
    if quote != '"' && quote != '\'':
        outError = wire.RustCsgCat("config.toml string value must be quoted: ", value)
        return ""
    if value[value.len - 1] != quote:
        outError = wire.RustCsgCat("unterminated config.toml string value: ", value)
        return ""
    let inner = wire.RustCsgSliceBytes(value, 1, value.len - 2)
    for i in 0..<inner.len:
        let ch = inner[i]
        if ch == '\\' || ch == '\n' || ch == '\r' || ch == '\t':
            outError = "config.toml string escaping not ported"
            return ""
    return inner

fn RustCsgUserConfigJson(model: str,
                         modelProvider: str,
                         approvalPolicy: str,
                         approvalsReviewer: str,
                         sandboxMode: str,
                         ossProvider: str,
                         defaultPermissions: str,
                         profile: str,
                         modelReasoningEffort: str,
                         modelReasoningSummaryFormat: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("model", model))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("modelProvider", modelProvider))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("approvalPolicy", approvalPolicy))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("approvalsReviewer", approvalsReviewer))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("sandboxMode", sandboxMode))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("ossProvider", ossProvider))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("defaultPermissions", defaultPermissions))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("profile", profile))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("modelReasoningEffort", modelReasoningEffort))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("modelReasoningSummaryFormat", modelReasoningSummaryFormat))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgEmptyUserConfigJson(): str =
    return RustCsgUserConfigJson("", "", "", "", "", "", "", "", "", "")

fn RustCsgConfigTomlStartsWith(text: str, prefix: str): bool =
    if prefix.len > text.len:
        return false
    for i in 0..<prefix.len:
        if text[i] != prefix[i]:
            return false
    return true

fn RustCsgConfigTomlProfileTableName(tableName: str, outError: var str): str =
    outError = ""
    let prefix = "profiles."
    if RustCsgConfigTomlStartsWith(tableName, prefix):
        if tableName.len <= prefix.len:
            outError = "empty config.toml profile name"
            return ""
        let profileName = wire.RustCsgSliceBytes(tableName, prefix.len, tableName.len - prefix.len)
        for i in 0..<profileName.len:
            let ch = profileName[i]
            if ch == '.' || ch == '"' || ch == '\'' || ch == '[' || ch == ']':
                outError = wire.RustCsgCat("config.toml profile name not ported: ", profileName)
                return ""
        return profileName
    return ""

fn RustCsgConfigTomlRootProfileName(text: str, selectedProfile: str, outError: var str): str =
    outError = ""
    if selectedProfile != "":
        return selectedProfile
    var profile: str
    var pos: int32
    while pos < text.len:
        while pos < text.len && (text[pos] == ' ' || text[pos] == '\t' || text[pos] == '\r'):
            pos = pos + 1
        if pos >= text.len:
            break
        if text[pos] == '\n':
            pos = pos + 1
            continue
        if text[pos] == '#':
            while pos < text.len && text[pos] != '\n':
                pos = pos + 1
            continue
        if text[pos] == '[':
            return profile
        let keyStart = pos
        while pos < text.len && text[pos] != '=' &&
              text[pos] != ' ' && text[pos] != '\t' &&
              text[pos] != '\r' && text[pos] != '\n':
            pos = pos + 1
        let keyStop = pos
        while pos < text.len && (text[pos] == ' ' || text[pos] == '\t'):
            pos = pos + 1
        if pos >= text.len || text[pos] != '=':
            return profile
        pos = pos + 1
        while pos < text.len && (text[pos] == ' ' || text[pos] == '\t'):
            pos = pos + 1
        if pos >= text.len || (text[pos] != '"' && text[pos] != '\''):
            return profile
        let quote = text[pos]
        pos = pos + 1
        let valueStart = pos
        while pos < text.len && text[pos] != quote:
            if text[pos] == '\\' || text[pos] == '\n' || text[pos] == '\r' || text[pos] == '\t':
                return profile
            pos = pos + 1
        if pos >= text.len:
            return profile
        let valueStop = pos
        pos = pos + 1
        while pos < text.len && (text[pos] == ' ' || text[pos] == '\t' || text[pos] == '\r'):
            pos = pos + 1
        if pos < text.len && text[pos] == '#':
            while pos < text.len && text[pos] != '\n':
                pos = pos + 1
        if pos < text.len && text[pos] != '\n':
            return profile
        if pos < text.len && text[pos] == '\n':
            pos = pos + 1
        let key = wire.RustCsgSliceBytes(text, keyStart, keyStop - keyStart)
        if key == "profile":
            profile = wire.RustCsgSliceBytes(text, valueStart, valueStop - valueStart)
    return profile

fn RustCsgParseUserConfigTomlJsonWithProfile(text: str,
                                             selectedProfileOverride: str,
                                             outError: var str): str =
    outError = ""
    let selectedProfile = RustCsgConfigTomlRootProfileName(text, selectedProfileOverride, outError)
    if outError != "":
        return ""
    var model: str
    var modelSet: bool
    var modelProvider: str
    var modelProviderSet: bool
    var approvalPolicy: str
    var approvalPolicySet: bool
    var approvalsReviewer: str
    var approvalsReviewerSet: bool
    var sandboxMode: str
    var sandboxModeSet: bool
    var ossProvider: str
    var ossProviderSet: bool
    var defaultPermissions: str
    var defaultPermissionsSet: bool
    var profile: str
    var profileSet: bool
    var modelReasoningEffort: str
    var modelReasoningEffortSet: bool
    var modelReasoningSummaryFormat: str
    var modelReasoningSummaryFormatSet: bool
    profile = selectedProfile
    var profileFound: bool
    if selectedProfile == "":
        profileFound = true
    var currentProfile: str
    var profileModel: str
    var profileModelSet: bool
    var profileModelProvider: str
    var profileModelProviderSet: bool
    var profileApprovalPolicy: str
    var profileApprovalPolicySet: bool
    var profileApprovalsReviewer: str
    var profileApprovalsReviewerSet: bool
    var profileSandboxMode: str
    var profileSandboxModeSet: bool
    var profileOssProvider: str
    var profileOssProviderSet: bool
    var profileModelReasoningEffort: str
    var profileModelReasoningEffortSet: bool
    var profileModelReasoningSummaryFormat: str
    var profileModelReasoningSummaryFormatSet: bool
    var sectionModelSet: bool
    var sectionModelProviderSet: bool
    var sectionApprovalPolicySet: bool
    var sectionApprovalsReviewerSet: bool
    var sectionSandboxModeSet: bool
    var sectionOssProviderSet: bool
    var sectionModelReasoningEffortSet: bool
    var sectionModelReasoningSummaryFormatSet: bool
    var skipSection: bool
    var pos: int32
    while pos < text.len:
        while pos < text.len && (text[pos] == ' ' || text[pos] == '\t' || text[pos] == '\r'):
            pos = pos + 1
        if pos >= text.len:
            break
        if text[pos] == '\n':
            pos = pos + 1
            continue
        if text[pos] == '#':
            while pos < text.len && text[pos] != '\n':
                pos = pos + 1
            continue
        if text[pos] == '[':
            pos = pos + 1
            let tableStart = pos
            while pos < text.len && text[pos] != ']':
                if text[pos] == '\n' || text[pos] == '\r':
                    outError = "unterminated config.toml table"
                    return ""
                pos = pos + 1
            if pos >= text.len:
                outError = "unterminated config.toml table"
                return ""
            let tableName = wire.RustCsgSliceBytes(text, tableStart, pos - tableStart)
            pos = pos + 1
            while pos < text.len && (text[pos] == ' ' || text[pos] == '\t' || text[pos] == '\r'):
                pos = pos + 1
            if pos < text.len && text[pos] == '#':
                while pos < text.len && text[pos] != '\n':
                    pos = pos + 1
            if pos < text.len && text[pos] != '\n':
                outError = "invalid config.toml table"
                return ""
            if pos < text.len && text[pos] == '\n':
                pos = pos + 1
            currentProfile = RustCsgConfigTomlProfileTableName(tableName, outError)
            if outError != "":
                return ""
            if currentProfile == selectedProfile && selectedProfile != "":
                profileFound = true
            sectionModelSet = false
            sectionModelProviderSet = false
            sectionApprovalPolicySet = false
            sectionApprovalsReviewerSet = false
            sectionSandboxModeSet = false
            sectionOssProviderSet = false
            sectionModelReasoningEffortSet = false
            sectionModelReasoningSummaryFormatSet = false
            skipSection = currentProfile == ""
            continue
        let keyStart = pos
        while pos < text.len && text[pos] != '=' &&
              text[pos] != ' ' && text[pos] != '\t' &&
              text[pos] != '\r' && text[pos] != '\n':
            pos = pos + 1
        let keyStop = pos
        while pos < text.len && (text[pos] == ' ' || text[pos] == '\t'):
            pos = pos + 1
        if pos >= text.len || text[pos] != '=':
            outError = "invalid config.toml entry"
            return ""
        pos = pos + 1
        while pos < text.len && (text[pos] == ' ' || text[pos] == '\t'):
            pos = pos + 1
        if pos >= text.len || (text[pos] != '"' && text[pos] != '\''):
            while pos < text.len && text[pos] != '\n':
                pos = pos + 1
            if pos < text.len && text[pos] == '\n':
                pos = pos + 1
            continue
        let quote = text[pos]
        pos = pos + 1
        let valueStart = pos
        while pos < text.len && text[pos] != quote:
            if text[pos] == '\\' || text[pos] == '\n' || text[pos] == '\r' || text[pos] == '\t':
                outError = "config.toml string escaping not ported"
                return ""
            pos = pos + 1
        if pos >= text.len:
            outError = "unterminated config.toml string value"
            return ""
        let valueStop = pos
        pos = pos + 1
        while pos < text.len && (text[pos] == ' ' || text[pos] == '\t' || text[pos] == '\r'):
            pos = pos + 1
        if pos < text.len && text[pos] == '#':
            while pos < text.len && text[pos] != '\n':
                pos = pos + 1
        if pos < text.len && text[pos] != '\n':
            outError = "invalid config.toml entry"
            return ""
        if pos < text.len && text[pos] == '\n':
            pos = pos + 1
        let key = wire.RustCsgSliceBytes(text, keyStart, keyStop - keyStart)
        if key == "":
            outError = "empty config.toml key"
            return ""
        let value = wire.RustCsgSliceBytes(text, valueStart, valueStop - valueStart)
        if skipSection:
            continue
        if currentProfile != "":
            if key == "model":
                if sectionModelSet:
                    outError = wire.RustCsgCat("duplicate config.toml key: ", key)
                    return ""
                sectionModelSet = true
                if currentProfile == selectedProfile:
                    profileModelSet = true
                    profileModel = value
            elif key == "model_provider":
                if sectionModelProviderSet:
                    outError = wire.RustCsgCat("duplicate config.toml key: ", key)
                    return ""
                sectionModelProviderSet = true
                if currentProfile == selectedProfile:
                    profileModelProviderSet = true
                    profileModelProvider = value
            elif key == "approval_policy":
                if sectionApprovalPolicySet:
                    outError = wire.RustCsgCat("duplicate config.toml key: ", key)
                    return ""
                sectionApprovalPolicySet = true
                if currentProfile == selectedProfile:
                    profileApprovalPolicySet = true
                    profileApprovalPolicy = value
            elif key == "approvals_reviewer":
                if sectionApprovalsReviewerSet:
                    outError = wire.RustCsgCat("duplicate config.toml key: ", key)
                    return ""
                sectionApprovalsReviewerSet = true
                if currentProfile == selectedProfile:
                    profileApprovalsReviewerSet = true
                    profileApprovalsReviewer = value
            elif key == "sandbox_mode":
                if sectionSandboxModeSet:
                    outError = wire.RustCsgCat("duplicate config.toml key: ", key)
                    return ""
                sectionSandboxModeSet = true
                if currentProfile == selectedProfile:
                    profileSandboxModeSet = true
                    profileSandboxMode = value
            elif key == "oss_provider":
                if sectionOssProviderSet:
                    outError = wire.RustCsgCat("duplicate config.toml key: ", key)
                    return ""
                sectionOssProviderSet = true
                if currentProfile == selectedProfile:
                    profileOssProviderSet = true
                    profileOssProvider = value
            elif key == "model_reasoning_effort":
                if sectionModelReasoningEffortSet:
                    outError = wire.RustCsgCat("duplicate config.toml key: ", key)
                    return ""
                sectionModelReasoningEffortSet = true
                if currentProfile == selectedProfile:
                    profileModelReasoningEffortSet = true
                    profileModelReasoningEffort = value
            elif key == "model_reasoning_summary_format":
                if sectionModelReasoningSummaryFormatSet:
                    outError = wire.RustCsgCat("duplicate config.toml key: ", key)
                    return ""
                sectionModelReasoningSummaryFormatSet = true
                if currentProfile == selectedProfile:
                    profileModelReasoningSummaryFormatSet = true
                    profileModelReasoningSummaryFormat = value
            else:
                continue
        elif key == "model":
            if modelSet:
                outError = wire.RustCsgCat("duplicate config.toml key: ", key)
                return ""
            modelSet = true
            model = value
        elif key == "model_provider":
            if modelProviderSet:
                outError = wire.RustCsgCat("duplicate config.toml key: ", key)
                return ""
            modelProviderSet = true
            modelProvider = value
        elif key == "approval_policy":
            if approvalPolicySet:
                outError = wire.RustCsgCat("duplicate config.toml key: ", key)
                return ""
            approvalPolicySet = true
            approvalPolicy = value
        elif key == "approvals_reviewer":
            if approvalsReviewerSet:
                outError = wire.RustCsgCat("duplicate config.toml key: ", key)
                return ""
            approvalsReviewerSet = true
            approvalsReviewer = value
        elif key == "sandbox_mode":
            if sandboxModeSet:
                outError = wire.RustCsgCat("duplicate config.toml key: ", key)
                return ""
            sandboxModeSet = true
            sandboxMode = value
        elif key == "oss_provider":
            if ossProviderSet:
                outError = wire.RustCsgCat("duplicate config.toml key: ", key)
                return ""
            ossProviderSet = true
            ossProvider = value
        elif key == "default_permissions":
            if defaultPermissionsSet:
                outError = wire.RustCsgCat("duplicate config.toml key: ", key)
                return ""
            defaultPermissionsSet = true
            defaultPermissions = value
        elif key == "profile":
            if profileSet:
                outError = wire.RustCsgCat("duplicate config.toml key: ", key)
                return ""
            profileSet = true
            if selectedProfileOverride == "":
                profile = value
        else:
            continue
    if selectedProfile != "" && !profileFound:
        outError = wire.RustCsgCat3("config profile `", selectedProfile, "` not found")
        return ""
    if profileModelSet:
        model = profileModel
    if profileModelProviderSet:
        modelProvider = profileModelProvider
    if profileApprovalPolicySet:
        approvalPolicy = profileApprovalPolicy
    if profileApprovalsReviewerSet:
        approvalsReviewer = profileApprovalsReviewer
    if profileSandboxModeSet:
        sandboxMode = profileSandboxMode
    if profileOssProviderSet:
        ossProvider = profileOssProvider
    if profileModelReasoningEffortSet:
        modelReasoningEffort = profileModelReasoningEffort
    if profileModelReasoningSummaryFormatSet:
        modelReasoningSummaryFormat = profileModelReasoningSummaryFormat
    return RustCsgUserConfigJson(model, modelProvider, approvalPolicy, approvalsReviewer, sandboxMode, ossProvider, defaultPermissions, profile, modelReasoningEffort, modelReasoningSummaryFormat)

fn RustCsgParseUserConfigTomlJson(text: str, outError: var str): str =
    return RustCsgParseUserConfigTomlJsonWithProfile(text, "", outError)

fn RustCsgLoadUserConfigJsonFromCodexHome(codexHomePath: str,
                                          ignoreUserConfig: bool,
                                          outError: var str): str =
    return RustCsgLoadUserConfigJsonFromCodexHomeWithProfile(codexHomePath,
                                                             ignoreUserConfig,
                                                             "",
                                                             outError)

fn RustCsgLoadUserConfigJsonFromCodexHomeWithProfile(codexHomePath: str,
                                                     ignoreUserConfig: bool,
                                                     selectedProfile: str,
                                                     outError: var str): str =
    outError = ""
    if ignoreUserConfig:
        return RustCsgEmptyUserConfigJson()
    if codexHomePath == "":
        outError = "codex home is empty"
        return ""
    let configPath = wire.RustCsgCat(codexHomePath, "/config.toml")
    let metadataKind = home.RustCsgPathMetadataKind(configPath)
    if metadataKind == 0:
        return RustCsgEmptyUserConfigJson()
    if metadataKind < 0:
        outError = wire.RustCsgCat("failed to read config.toml metadata: ", configPath)
        return ""
    if metadataKind != 2:
        outError = wire.RustCsgCat("config.toml path is not a file: ", configPath)
        return ""
    if RustCsgPathReadable(configPath) == 0:
        outError = wire.RustCsgCat("failed to read config.toml: ", configPath)
        return ""
    return RustCsgParseUserConfigTomlJsonWithProfile(RustCsgReadConfigFile(configPath),
                                                     selectedProfile,
                                                     outError)
