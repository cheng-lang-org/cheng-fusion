# Model provider dispatch — ported from codex-rs/model-provider/src/provider.rs
#
# Creates runtime model providers with resolved base URL and API key.
# API key resolution order: env var -> config -> auth.json -> hard-fail.

import std/system
import cheng/codex/auth/login

@abi_internal
@importc("RustCsgGetEnvRaw")
fn modelProviderGetEnvRaw(name: cstring): cstring

@abi_internal
@importc("strlen")
fn modelProviderCStringLen(raw: cstring): int64

# ── Provider detection constants ────────────────────────────────────────

# Provider type strings used for routing
const PROVIDER_OPENAI: str = "OpenAI"
const PROVIDER_ANTHROPIC: str = "Anthropic"
const PROVIDER_GLM: str = "GLM"
const PROVIDER_LMSTUDIO: str = "gpt-oss"
const PROVIDER_OLLAMA: str = "ollama"

# ── Default base URLs ───────────────────────────────────────────────────

const DEFAULT_OPENAI_URL: str = "https://api.openai.com/v1"
const DEFAULT_ANTHROPIC_URL: str = "https://api.anthropic.com"
const DEFAULT_GLM_URL: str = "https://api.z.ai/api/coding/paas/v4"
const DEFAULT_LMSTUDIO_URL: str = "http://localhost:1234/v1"
const DEFAULT_OLLAMA_URL: str = "http://localhost:11434/v1"

# ── ModelProviderRuntime type ───────────────────────────────────────────

type
    ModelProviderRuntime =
        name: str
        baseUrl: str
        apiKey: str
        accountId: str
        requiresOpenaiAuth: bool

fn NewModelProviderRuntime(): ModelProviderRuntime =
    var result: ModelProviderRuntime
    return result

# ── API key resolution ──────────────────────────────────────────────────

# Resolve API key from environment variables.
# Returns "" if no env var is set.
fn modelProviderGetEnv(name: cstring): str =
    let raw: cstring = modelProviderGetEnvRaw(name)
    if raw == nil:
        return ""
    let count = modelProviderCStringLen(raw)
    if count <= 0:
        return ""
    return system.StrFromBytesCopy(ptr(raw), int32(count))

fn ResolveApiKeyFromEnv(name: str): str =
    if name == "OpenAI":
        let key: str = modelProviderGetEnv("OPENAI_API_KEY")
        if key != "":
            return key
        let codexKey: str = modelProviderGetEnv("CODEX_API_KEY")
        if codexKey != "":
            return codexKey
        return ""
    if name == "Anthropic":
        return modelProviderGetEnv("ANTHROPIC_API_KEY")
    if name == "GLM":
        return modelProviderGetEnv("ZAI_API_KEY")
    return ""

# Resolve API key from auth.json (CodexAuth).
fn ResolveApiKeyFromAuth(auth: login.CodexAuth): str =
    return login.CodexAuthGetToken(auth)

# Determine if a provider name is Anthropic.
fn IsAnthropicProvider(name: str): bool =
    return name == "Anthropic"

# Determine if a provider name is an OSS/local provider (no API key needed).
fn IsLocalProvider(name: str): bool =
    if name == "gpt-oss":
        return true
    if name == "ollama":
        return true
    return false

# ── Default base URL resolution ─────────────────────────────────────────

# Get the default base URL for a named provider.
fn DefaultBaseUrlForProvider(name: str): str =
    if name == "OpenAI":
        return "https://api.openai.com/v1"
    if name == "Anthropic":
        return "https://api.anthropic.com"
    if name == "GLM":
        return "https://api.z.ai/api/coding/paas/v4"
    if name == "gpt-oss":
        return "http://localhost:1234/v1"
    if name == "ollama":
        return "http://localhost:11434/v1"
    return ""

# ── Provider creation ───────────────────────────────────────────────────

# Create a ModelProviderRuntime from provider name, optional base URL,
# and optional auth manager.
#
# resolution:
#   env var OPENAI_API_KEY/ANTHROPIC_API_KEY/CODEX_API_KEY
#   -> codexHome auth.json (via authManager)
#   -> hard-fail if the provider requires auth but no key found
#
# Returns the populated ModelProviderRuntime on success.
# On error, runtime.name will be "".
fn CreateModelProvider(name: str,
                        baseUrl: str,
                        codexHome: str,
                        outProvider: var ModelProviderRuntime): bool =
    var p: ModelProviderRuntime = NewModelProviderRuntime()
    p.name = name

    # Determine base URL
    let effectiveBaseUrl: str = baseUrl
    if effectiveBaseUrl == "":
        let defaultUrl: str = DefaultBaseUrlForProvider(name)
        if defaultUrl == "":
            # Unknown provider — caller must provide a base URL
            return false
        p.baseUrl = defaultUrl
    else:
        p.baseUrl = effectiveBaseUrl

    # Set flags
    if name == "OpenAI" || name == "GLM":
        p.requiresOpenaiAuth = true

    # Resolve API key
    if IsLocalProvider(name):
        # Local providers don't need API keys
        outProvider = p
        return true

    # Step 1: Try env vars
    p.apiKey = ResolveApiKeyFromEnv(name)
    if p.apiKey != "":
        outProvider = p
        return true

    # Step 2: Try auth.json
    if codexHome != "":
        let authDotJson: login.AuthDotJson = login.LoadAuth(codexHome)
        if login.AuthAvailable(authDotJson):
            let codexAuth: login.CodexAuth = login.AuthDotJsonToCodexAuth(authDotJson)
            p.apiKey = ResolveApiKeyFromAuth(codexAuth)
            p.accountId = codexAuth.accountId
            if p.apiKey != "":
                outProvider = p
                return true

    # Step 3: If this provider requires auth, hard-fail
    if p.requiresOpenaiAuth:
        # No API key found — hard-fail
        return false

    outProvider = p
    return true

# ── Convenience: create with explicit API key (for testing) ─────────────

fn CreateModelProviderWithKey(name: str, baseUrl: str, apiKey: str): ModelProviderRuntime =
    var p: ModelProviderRuntime = NewModelProviderRuntime()
    p.name = name
    p.apiKey = apiKey
    if baseUrl != "":
        p.baseUrl = baseUrl
    else:
        p.baseUrl = DefaultBaseUrlForProvider(name)
    if name == "OpenAI" || name == "GLM":
        p.requiresOpenaiAuth = true
    return p
